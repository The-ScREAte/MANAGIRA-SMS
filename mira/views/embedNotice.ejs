<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Mira</title>
  <style>
    :root { color-scheme: light dark; }
    * { box-sizing: border-box; }
    html, body { height: 100%; margin: 0; }
    body { display: flex; align-items: center; justify-content: center; padding: 24px; background: #fff; color: #111827; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif; text-align: center; }
    .box { max-width: 300px; }
    img { width: 48px; height: 48px; margin-bottom: 14px; }
    h1 { margin: 0 0 6px; font-size: 1.05rem; font-weight: 650; }
    p { margin: 0 0 18px; color: #4b5563; font-size: 0.92rem; line-height: 1.5; }
    button { height: 40px; padding: 0 18px; border: 0; border-radius: 10px; background: #01535b; color: #fff; font: 600 0.92rem/1 inherit; cursor: pointer; }
    @media (prefers-color-scheme: dark) { body { background: #111827; color: #f9fafb; } p { color: #d1d5db; } }
  </style>
</head>
<body>
  <div class="box">
    <img src="/images/miralogo.png" alt="" />
    <% if (kind === 'signed-out') { %>
    <h1>Your session has ended</h1>
    <p>Sign in to Managira again to keep working with Mira.</p>
    <% } else { %>
    <h1>Mira isn't answering right now</h1>
    <p>Try again in a moment.</p>
    <button type="button" onclick="location.reload()">Try again</button>
    <% } %>
  </div>
  <script>
    // Managira's page takes the whole window to its login page (public/js/miraPanel.js).
    try { window.parent.postMessage({ type: <%- JSON.stringify(kind === 'signed-out' ? 'mira:signed-out' : 'mira:unavailable') %> }, '*'); } catch (_) {}
  </script>
</body>
</html>
