<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="robots" content="noindex" />
  <title><%= typeof title !== 'undefined' ? title : 'Sign in - Mira' %></title>
  <link rel="icon" type="image/png" href="/images/miralogo.png" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/css/mira.css" />
  <script>
    (function () {
      try {
        var saved = localStorage.getItem("mira:theme");
        if (saved === "light" || saved === "dark") document.documentElement.setAttribute("data-theme", saved);
      } catch (e) {}
    })();
  </script>
</head>
<body class="mira-auth-page">
  <%# Shown only when Mira can't reach Managira to check a sign-in. Signing in itself happens on Managira's own page. %>
  <main class="mira-auth-shell">
    <div class="mira-auth-card">
      <%- include('partials/logo', { size: 'hero', animate: true }) %>
      <h1 class="mira-auth-title">Sign in to Mira</h1>
      <p class="mira-auth-subtitle">Mira couldn't reach Managira to check your sign-in. Please try again in a moment.</p>
      <a class="mira-btn mira-btn-primary mira-auth-btn" href="/login">
        <span class="mira-btn-label">Try again</span>
      </a>
      <a class="mira-btn mira-auth-btn mira-auth-sso" href="<%= signInUrl %>">Go to Managira sign-in</a>
    </div>
  </main>
  <script src="/js/mira-logo.js" defer></script>
</body>
</html>
