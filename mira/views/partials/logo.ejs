<%
  // size: 'sidebar' | 'hero'
  const logoSize = typeof size !== 'undefined' ? size : 'hero';
  const animated = typeof animate !== 'undefined' ? animate : false;
%>
<div class="mira-logo <%= logoSize === 'sidebar' ? 'mira-logo-sidebar' : '' %> <%= animated ? 'mira-logo-entrance' : '' %>" data-mira-logo <%= animated ? 'data-mira-logo-idle-after-entrance' : '' %>>
  <img src="/images/miralogo.png" alt="Mira" />
</div>
