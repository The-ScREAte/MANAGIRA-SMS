<div class="mira-shell">
  <%- include('partials/sidebar', { tenant, mainAppUrl }) %>

  <main class="mira-main">
    <div class="mira-mobile-topbar">
      <button class="mira-icon-btn" id="miraMobileMenuBtn" type="button" aria-label="Open menu">
        <svg width="20" height="20" viewBox="0 0 16 16" fill="none"><path d="M2 4h12M2 8h12M2 12h12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
      </button>
      <span style="font-weight:700;">Mira</span>
    </div>

    <!-- Empty state -->
    <section class="mira-empty-state" id="miraEmptyState">
      <%- include('partials/logo', { size: 'hero', animate: true }) %>
      <h1 class="mira-empty-heading">What can I help you with?</h1>

      <div class="mira-class-selector-wrap">
        <button class="mira-project-selector" id="miraClassSelector" type="button" aria-haspopup="true" aria-expanded="false">
          <svg width="14" height="14" viewBox="0 0 16 16" fill="none"><path d="M8 2L1.5 5 8 8l6.5-3L8 2z" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round"/><path d="M3.5 7v3.5c0 1 2 2 4.5 2s4.5-1 4.5-2V7" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round"/></svg>
          <span id="miraClassSelectorLabel">Select a class</span>
          <svg width="12" height="12" viewBox="0 0 16 16" fill="none"><path d="M4 6l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
        <div class="mira-class-dropdown" id="miraClassDropdown" role="menu" hidden>
          <div class="mira-class-dropdown-search">
            <input type="search" id="miraClassSearch" placeholder="Search classes" />
          </div>
          <div class="mira-class-dropdown-list" id="miraClassDropdownList">
            <div class="mira-class-dropdown-empty">Loading classes&hellip;</div>
          </div>
        </div>
      </div>

      <form class="mira-composer" id="miraComposerForm">
        <div class="mira-attached-file" id="miraAttachedFileChip" hidden>
          <svg width="13" height="13" viewBox="0 0 16 16" fill="none"><path d="M11 5.5l-5 5a2 2 0 102.8 2.8l5-5a3.5 3.5 0 10-5-5l-5 5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/></svg>
          <span id="miraAttachedFileName"></span>
          <button type="button" id="miraAttachedFileRemove" aria-label="Remove attachment">
            <svg width="12" height="12" viewBox="0 0 16 16" fill="none"><path d="M4 4l8 8M12 4l-8 8" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
          </button>
        </div>
        <div class="mira-input-box">
          <button type="button" class="mira-icon-btn" id="miraAttachBtn" aria-label="Attach a file" title="Attach a file (text, PDF, or Word document)">
            <svg width="18" height="18" viewBox="0 0 16 16" fill="none"><path d="M11 5.5l-5 5a2 2 0 102.8 2.8l5-5a3.5 3.5 0 10-5-5l-5 5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/></svg>
          </button>
          <textarea id="miraInput" rows="1" placeholder="Ask Mira anything"></textarea>
          <button type="button" class="mira-icon-btn" id="miraMicBtn" aria-label="Voice input" title="Voice input">
            <svg width="18" height="18" viewBox="0 0 16 16" fill="none"><rect x="6" y="2" width="4" height="8" rx="2" stroke="currentColor" stroke-width="1.4"/><path d="M4 8a4 4 0 008 0M8 12v2" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/></svg>
          </button>
          <button type="submit" class="mira-icon-btn mira-send-btn" id="miraSendBtn" aria-label="Send" disabled>
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M2 8h11M8 3l5 5-5 5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </button>
        </div>

        <div class="mira-quick-actions">
          <button type="button" class="mira-chip" data-intent="find">
            <svg width="14" height="14" viewBox="0 0 16 16" fill="none"><circle cx="7" cy="7" r="5" stroke="currentColor" stroke-width="1.5"/><path d="M11 11l3.5 3.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
            Find
          </button>
          <button type="button" class="mira-chip" data-intent="draft">
            <svg width="14" height="14" viewBox="0 0 16 16" fill="none"><path d="M11 2.5l2.5 2.5-8 8-3 .5.5-3 8-8z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/></svg>
            Draft
          </button>
          <button type="button" class="mira-chip" data-intent="plan">
            <svg width="14" height="14" viewBox="0 0 16 16" fill="none"><rect x="2" y="3" width="12" height="11" rx="1.5" stroke="currentColor" stroke-width="1.4"/><path d="M2 6.5h12M5.5 1.5v2.5M10.5 1.5v2.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/></svg>
            Plan
          </button>
          <button type="button" class="mira-chip" data-intent="report">
            <svg width="14" height="14" viewBox="0 0 16 16" fill="none"><path d="M4 1.5h6l3 3V13a1 1 0 01-1 1H4a1 1 0 01-1-1V2.5a1 1 0 011-1z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/><path d="M5.5 8h5M5.5 10.5h5" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/></svg>
            Report
          </button>
        </div>
      </form>
    </section>

    <!-- Active chat -->
    <section class="mira-chat-view" id="miraChatView">
      <div class="mira-chat-scroll" id="miraChatScroll">
        <div class="mira-chat-thread" id="miraChatThread"></div>
      </div>
      <div class="mira-composer-docked">
        <form class="mira-composer" id="miraComposerFormDocked">
          <div class="mira-attached-file" id="miraAttachedFileChipDocked" hidden>
            <svg width="13" height="13" viewBox="0 0 16 16" fill="none"><path d="M11 5.5l-5 5a2 2 0 102.8 2.8l5-5a3.5 3.5 0 10-5-5l-5 5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/></svg>
            <span id="miraAttachedFileNameDocked"></span>
            <button type="button" id="miraAttachedFileRemoveDocked" aria-label="Remove attachment">
              <svg width="12" height="12" viewBox="0 0 16 16" fill="none"><path d="M4 4l8 8M12 4l-8 8" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
            </button>
          </div>
          <div class="mira-input-box">
            <button type="button" class="mira-icon-btn" id="miraAttachBtnDocked" aria-label="Attach a file" title="Attach a file (text, PDF, or Word document)">
              <svg width="18" height="18" viewBox="0 0 16 16" fill="none"><path d="M11 5.5l-5 5a2 2 0 102.8 2.8l5-5a3.5 3.5 0 10-5-5l-5 5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/></svg>
            </button>
            <textarea id="miraInputDocked" rows="1" placeholder="Ask Mira anything"></textarea>
            <button type="button" class="mira-icon-btn" id="miraMicBtnDocked" aria-label="Voice input" title="Voice input">
              <svg width="18" height="18" viewBox="0 0 16 16" fill="none"><rect x="6" y="2" width="4" height="8" rx="2" stroke="currentColor" stroke-width="1.4"/><path d="M4 8a4 4 0 008 0M8 12v2" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/></svg>
            </button>
            <button type="submit" class="mira-icon-btn mira-send-btn" id="miraSendBtnDocked" aria-label="Send" disabled>
              <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M2 8h11M8 3l5 5-5 5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </button>
          </div>
        </form>
        <p class="mira-ai-disclaimer" id="miraAiDisclaimer" hidden>Mira is AI and can make mistakes. Please double-check critical details.</p>
      </div>

      <input type="file" id="miraFileInput" hidden />
    </section>
  </main>
</div>

<script>
  window.MIRA_TENANT = <%- JSON.stringify(tenant) %>;
</script>
<script src="/js/mira-logo.js" defer></script>
<script src="/js/mira-app.js" defer></script>
<script src="/js/mira-chat.js" defer></script>
