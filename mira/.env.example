# Copy to .env and fill in. See ../README-MIRA.md for the full deployment guide.

# --- Database ---
# Defaults to the main app's DB_CONNECTION_STRING if unset. Point this at a
# dedicated Postgres instance later with no code change.
# MIRA_DB_CONNECTION_STRING=postgres://user:pass@host:5432/mira_db?sslmode=require
DB_CONNECTION_STRING=postgres://user:pass@host:5432/managira_db?sslmode=require
# MIRA_DB_SSL=true
# MIRA_DB_POOL_MAX=10

# --- Session bridge (SSO) ---
# Must match the main app's SESSION_SECRET exactly - this is how Mira
# verifies the signed session cookie without ever touching user_sessions
# directly.
SESSION_SECRET=

# --- Internal API (Mira <-> main app) ---
# Generate a long random value, e.g. `openssl rand -hex 32`. Must match the
# MIRA_SERVICE_TOKEN set on the MAIN app.
MIRA_SERVICE_TOKEN=
# Base URL of the main Managira app's internal API, from Mira's network
# perspective (internal service URL in production, http://localhost:4000 locally).
MAIN_APP_INTERNAL_BASE_URL=http://localhost:4000

# --- Redis (shared with the main app's cache, own key prefix) ---
# REDIS_URL=redis://user:pass@host:6379
# MIRA_REDIS_PREFIX=mira:cache

# --- LLM providers ---
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# Force mock mode even if a key is present (useful for local dev without
# spending real tokens). Auto-enabled if neither key above is set.
# MIRA_MOCK_LLM=true

# --- Budget caps (optional; per-tenant overrides live in mira_tenant_limits) ---
# MIRA_DEFAULT_DAILY_CAP_USD=5
# MIRA_DEFAULT_MONTHLY_CAP_USD=100

# --- Server ---
MIRA_PORT=4100
