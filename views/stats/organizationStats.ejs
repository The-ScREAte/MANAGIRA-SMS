<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
  <style>
      :root {
        --font-family: "Inter", sans-serif;
      }


    body {
        font-family: var(--font-family);
      }
      
</style>
  <style>
    /* General Styling */

    @tailwind base;
    @tailwind components;
    @tailwind utilities;
    
    @layer base {
      /* ... keep existing code */
    }
    
    @layer base {
      * {
        @apply border-border;
      }
    
      body {
        @apply bg-background text-foreground;
      }
    }
    
    /* Organization Stats Dashboard Styles */
    .organization-stats-title {
      font-size: 1.6rem;
      font-weight: 600;
      color: #2c3e50;
      margin: 1.5rem 0;
      padding: 0 1rem;
      text-align: center;
    }
    
    /* Stats boxes layout */
    .stats-container {
      display: flex;
      justify-content: center;
      flex-wrap: wrap;
      gap: 15px;
      margin: 1.25rem auto;
      max-width: 1200px;
      padding: 0 1rem;
    }
    
    /* Individual stat box styling */
    .stat-box {
      background-color: white;
      border-radius: 8px;
      box-shadow: 0 3px 6px rgba(0, 0, 0, 0.08);
      padding: 1rem 0.75rem;
      flex: 1;
      min-width: 130px;
      max-width: 200px;
      transition: all 0.2s ease;
      border: 1px solid rgba(0, 0, 0, 0.05);
    }
    
    .stat-box:hover {
      transform: translateY(-2px);
      box-shadow: 0 5px 12px rgba(0, 0, 0, 0.1);
    }
    
    .stat-box h2 {
      font-size: 0.9rem;
      color: #666;
      margin: 0 0 0.5rem 0;
      font-weight: 500;
    }
    
    .stat-box p {
      font-size: 1.5rem;
      margin: 0;
      color: #2c3e50;
      font-weight: 600;
    }
    
    /* Charts layout */
    .side-by-side-charts {
      display: flex;
      justify-content: center;
      flex-wrap: wrap;
      gap: 20px;
      margin: 1.5rem auto;
      max-width: 1400px;
      padding: 0 1rem;
    }
    
    /* Chart container styling */
    .chart-container {
      background: white;
      border-radius: 8px;
      box-shadow: 0 3px 6px rgba(0, 0, 0, 0.08);
      padding: 1.25rem;
      flex: 1;
      min-width: 300px;
      width: calc(50% - 20px);
      max-width: 600px;
      display: flex;
      flex-direction: column;
      align-items: center;
      border: 1px solid rgba(0, 0, 0, 0.05);
      transition: all 0.2s ease;
    }
    
    .chart-container:hover {
      box-shadow: 0 5px 15px rgba(0, 0, 0, 0.08);
    }
    
    .chart-container h2, .chart-container h3 {
      align-self: flex-start;
      width: 100%;
      font-size: 1.1rem;
      color: #2c3e50;
      margin: 0 0 1rem 0;
      padding-bottom: 0.75rem;
      border-bottom: 1px solid #f0f0f0;
    }
    
    .chart-container canvas {
      width: 100% !important;
      max-height: 300px;
    }
    
    /* Media queries for responsive design */
    @media screen and (max-width: 768px) {
      .side-by-side-charts {
        gap: 15px;
      }
      
      .chart-container {
        min-width: 250px;
        padding: 1rem;
      }
      
      .stat-box {
        min-width: 110px;
        padding: 0.75rem;
      }
    }
    
    @media screen and (max-width: 480px) {
      .stats-container {
        gap: 10px;
      }
      
      .stat-box {
        min-width: 100px;
        max-width: 45%;
        padding: 0.75rem 0.5rem;
      }
      
      .stat-box h2 {
        font-size: 0.8rem;
      }
      
      .stat-box p {
        font-size: 1.3rem;
      }
      
      .chart-container {
        min-width: 100%;
        padding: 0.75rem;
      }
      
      .chart-container h2, .chart-container h3 {
        font-size: 0.95rem;
      }
      
      .organization-stats-title {
        font-size: 1.3rem;
      }
    }
        
  </style>
  
</head>
<body>
<br>
  <!-- 🔘 Control Buttons -->
  <div class="center-link">
    <button class="compare-btn" id="toggleTermFormBtn">Select Term</button>
    <% if (allowedFeatures.includes("Class Base Analytics & Insights")) { %> 
    <button class="compare-btn" id="toggleClassFormBtn">Compare Classes</button>
    <% } %>
  </div>
  <hr>

  <form id="termSelectionForm" action="/stats/organization" method="GET" style="display: none;">
    <label>School Year:</label>
    <select name="selectedSchoolYearId" id="schoolYearSelect" required>
      <% schoolYears.forEach(year => { %>
        <option value="<%= year.school_year_id %>" 
          data-terms='<%= JSON.stringify(year.terms) %>'
          <%= selectedSchoolYear.school_year_id === year.school_year_id ? 'selected' : '' %>>
          <%= year.year_label %>
        </option>
      <% }) %>
    </select>

    <label>Term:</label>
    <select name="selectedTermId" id="termSelect" required></select>

    <button class="compare-btn" type="submit">Show Stats</button>
  </form>

  <!-- 📊 Organization Stats -->
  <% if (currentTerm) { %>
    <h1>📊 Organization Stats - <%= selectedSchoolYear.year_label %> - <%= currentTerm.term_name %></h1>
    <div class="stats-container">
      <div class="stat-box"><h2>Total Students</h2><p><%= organizationData.total_students %></p></div>
      <div class="stat-box"><h2>Total Employees</h2><p><%= organizationData.total_employees %></p></div>
      <div class="stat-box"><h2>Total Classes</h2><p><%= organizationData.total_classes %></p></div>
      <div class="stat-box"><h2>Total Subjects</h2><p><%= organizationData.total_subjects %></p></div>
    </div>

    <!-- 📈 Charts -->
    <div class="side-by-side-charts">
      <div class="chart-container">
        <h2>📊 Attendance Overview</h2>
        <canvas id="attendanceChart"></canvas>
      </div>
      <div class="chart-container">
        <h2>📊 Assessment Performance</h2>
        <canvas id="assessmentChart"></canvas>
      </div>
    </div>

    <div class="side-by-side-charts">
      <div class="chart-container">
        <h2>📈 Top Performing Classes</h2>
        <canvas id="topPerformingClassesChart"></canvas>
      </div>
      <div class="chart-container">
        <h2>📈 Organization Growth</h2>
        <canvas id="organizationGrowthChart"></canvas>
      </div>
    </div>
    
    <div class="side-by-side-charts">
    
      <div class="chart-container">
        <h2>👫 Gender Distribution</h2>
        <canvas id="genderDistributionChart"></canvas>
      </div>

      <div class="chart-container">
        <h2>🏫 Students Per Class</h2>
        <canvas id="studentCountChart"></canvas>
      </div>
    
    </div>
    
  <% } %>

<!-- 🆚 Compare Classes -->
 
<!-- 🆚 Class Comparison Form -->
<form id="classComparisonForm" style="display: none;">
  <h2>📊 Compare Classes</h2>

  <div class="form-group">
    <label for="compareSchoolYearSelect">School Year</label>
    <select id="compareSchoolYearSelect" name="schoolYear" required>
      <option value="">Select a school year</option>
      <% schoolYears.forEach(year => { %>
        <option value="<%= year.school_year_id %>" data-terms='<%= JSON.stringify(year.terms) %>'>
          <%= year.year_label %>
        </option>
      <% }) %>
    </select>
  </div>

  <div class="form-group">
    <label for="compareTermSelect">Term</label>
    <select id="compareTermSelect" name="termId" required>
      <option value="">Select a term</option>
    </select>
  </div>

  <div class="form-group" id="classSelection">
    <!-- Dynamically loaded class checkboxes will appear here -->
  </div>

  <button class="compare-btn" type="submit">Compare</button>
</form>

<!-- 📈 Class Comparison Results -->
<div id="classComparisonResults" style="display: none; margin-top: 30px;">
  <h2>📈 Class Performance Comparison</h2>

  <div class="comparison-table">
    <table>
      <thead>
        <tr>
          <th>Class</th>
          <th>Enrolled</th>
          <th>Avg Score</th>
          <th>Pass</th>
          <th>Fail</th>
        </tr>
      </thead>
      <tbody id="classComparisonTableBody">
        <!-- Filled dynamically via JS -->
      </tbody>
    </table>
  </div>

  <br>

  <div class="chart-container">
    <h3>📊 Visual Comparison</h3>
    <canvas id="classComparisonChart"></canvas>
  </div>
</div>


<script>
  document.addEventListener("DOMContentLoaded", () => {
    // 🔄 Toggle Forms Visibility
    document.getElementById("toggleTermFormBtn")?.addEventListener("click", () => {
      const form = document.getElementById("termSelectionForm");
      form.style.display = form.style.display === "none" ? "block" : "none";
    });
  
    document.getElementById("toggleClassFormBtn")?.addEventListener("click", () => {
      const form = document.getElementById("classComparisonForm");
      form.style.display = form.style.display === "none" ? "block" : "none";
    });
  
    // 🏫 Utility: Load Terms into Select Dropdown
    function loadTerms(selectElement, targetTermSelect) {
      const terms = JSON.parse(selectElement.selectedOptions[0]?.dataset.terms || "[]");
      targetTermSelect.innerHTML = '<option value="">Select a term</option>';
      terms.forEach(term => {
        const exists = Array.from(targetTermSelect.options).some(opt => opt.value === String(term.term_id));
        if (!exists) {
          const option = document.createElement("option");
          option.value = term.term_id;
          option.textContent = term.term_name;
          targetTermSelect.appendChild(option);
        }
      });
    }
  
    // Term & Class Loading
    const schoolYearSelect = document.getElementById("schoolYearSelect");
    const termSelect = document.getElementById("termSelect");
    if (schoolYearSelect?.value) loadTerms(schoolYearSelect, termSelect);
    schoolYearSelect?.addEventListener("change", () => loadTerms(schoolYearSelect, termSelect));
  
    const compareSchoolYearSelect = document.getElementById("compareSchoolYearSelect");
    const compareTermSelect = document.getElementById("compareTermSelect");
    compareSchoolYearSelect?.addEventListener("change", () => loadTerms(compareSchoolYearSelect, compareTermSelect));
    compareTermSelect?.addEventListener("change", function () {
      const termId = this.value;
      const classSelection = document.getElementById("classSelection");
      classSelection.innerHTML = "";
      if (!termId) return;
      fetch(`/stats/classes/${termId}`)
        .then(res => res.json())
        .then(classes => {
          if (!classes.length) return classSelection.innerHTML = "<p>No classes available for this term.</p>";
          classes.forEach(cls => {
            const label = document.createElement("label");
            const checkbox = document.createElement("input");
            checkbox.type = "checkbox";
            checkbox.name = "selectedClasses";
            checkbox.value = cls.class_id;
            label.append(checkbox, ` ${cls.class_name}`);
            classSelection.appendChild(label);
          });
        })
        .catch(err => console.error("❌ Failed to load classes:", err));
    });
  
    // 🆚 Compare Classes
    document.getElementById("classComparisonForm")?.addEventListener("submit", (e) => {
      e.preventDefault();
      const selectedClasses = Array.from(document.querySelectorAll("input[name='selectedClasses']:checked"))
        .map(cb => parseInt(cb.value));
      if (!selectedClasses.length) return alert("Please select at least one class.");
  
      fetch("/stats/class-comparison", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ selectedClasses })
      })
        .then(res => res.json())
        .then(data => {
          if (!data.length) return alert("No comparison data available.");
          document.getElementById("classComparisonForm").style.display = "none";
          document.getElementById("classComparisonResults").style.display = "block";
          const tbody = document.getElementById("classComparisonTableBody");
          tbody.innerHTML = data.map(cls => `
            <tr>
              <td>${cls.class_name}</td>
              <td>${cls.enrolled_students}</td>
              <td>${Number(cls.average_score).toFixed(2)}%</td>
              <td>${cls.pass_count}</td>
              <td>${cls.fail_count}</td>
            </tr>
          `).join("");
          const existingChart = Chart.getChart("classComparisonChart");
          if (existingChart) existingChart.destroy();
          new Chart(document.getElementById("classComparisonChart"), {
            type: "bar",
            data: {
              labels: data.map(c => c.class_name),
              datasets: [
                { label: "Enrolled", data: data.map(c => c.enrolled_students), backgroundColor: "#007bff" },
                { label: "Avg Score", data: data.map(c => c.average_score), backgroundColor: "#28a745" },
                { label: "Pass", data: data.map(c => c.pass_count), backgroundColor: "#17a2b8" },
                { label: "Fail", data: data.map(c => c.fail_count), backgroundColor: "#dc3545" }
              ]
            },
            options: { responsive: true, scales: { y: { beginAtZero: true } } }
          });
        })
        .catch(err => console.error("❌ Failed to compare classes:", err));
    });
  
    // 📊 Render All Charts
    <% if (attendanceByClass?.length) { %>
    new Chart(document.getElementById("attendanceChart"), {
      type: "bar",
      data: {
        labels: <%- JSON.stringify(attendanceByClass.map(c => c.class_name)) %>,
        datasets: [
          { label: "Present Days", data: <%- JSON.stringify(attendanceByClass.map(c => c.present_days)) %>, backgroundColor: "#4CAF50" },
          { label: "Absent Days", data: <%- JSON.stringify(attendanceByClass.map(c => c.absent_days)) %>, backgroundColor: "#F44336" }
        ]
      },
      options: { responsive: true, scales: { y: { beginAtZero: true } } }
    });
    <% } %>
  
    <% if (assessmentByClass?.length) { %>
    new Chart(document.getElementById("assessmentChart"), {
      type: "bar",
      data: {
        labels: <%- JSON.stringify(assessmentByClass.map(c => c.class_name)) %>,
        datasets: [
          { label: "Avg Score", data: <%- JSON.stringify(assessmentByClass.map(c => c.average_score)) %>, backgroundColor: "#E91E63" },
          { label: "Pass Count", data: <%- JSON.stringify(assessmentByClass.map(c => c.pass_count)) %>, backgroundColor: "#28a745" },
          { label: "Fail Count", data: <%- JSON.stringify(assessmentByClass.map(c => c.fail_count)) %>, backgroundColor: "#dc3545" }
        ]
      },
      options: { responsive: true, scales: { y: { beginAtZero: true } } }
    });
    <% } %>
  
    <% if (topPerformingClasses?.length) { %>
    new Chart(document.getElementById("topPerformingClassesChart"), {
      type: "bar",
      data: {
        labels: <%- JSON.stringify(topPerformingClasses.map(c => c.class_name)) %>,
        datasets: [{ label: "Avg Score", data: <%- JSON.stringify(topPerformingClasses.map(c => c.average_score)) %>, backgroundColor: "#3e95cd" }]
      },
      options: { responsive: true, scales: { y: { beginAtZero: true } } }
    });
    <% } %>
  
    <% if (organizationGrowth?.length) { %>
    new Chart(document.getElementById("organizationGrowthChart"), {
      type: "line",
      data: {
        labels: <%- JSON.stringify(organizationGrowth.map(y => y.year_label)) %>,
        datasets: [
          { label: "Students", data: <%- JSON.stringify(organizationGrowth.map(y => y.total_students)) %>, borderColor: "#4CAF50", fill: false },
          { label: "Employees", data: <%- JSON.stringify(organizationGrowth.map(y => y.total_employees)) %>, borderColor: "#2196F3", fill: false },
          { label: "Classes", data: <%- JSON.stringify(organizationGrowth.map(y => y.total_classes)) %>, borderColor: "#FFC107", fill: false }
        ]
      },
      options: { responsive: true, scales: { y: { beginAtZero: true } } }
    });
    <% } %>
  
    <% if (enrollmentOverTerms?.length) { %>
    new Chart(document.getElementById("enrollmentOverTermsChart"), {
      type: "line",
      data: {
        labels: <%- JSON.stringify(enrollmentOverTerms.map(t => t.term_name)) %>,
        datasets: [{ label: "Enrolled Students", data: <%- JSON.stringify(enrollmentOverTerms.map(t => t.total_students)) %>, borderColor: "#FF9800", fill: false }]
      },
      options: { responsive: true, scales: { y: { beginAtZero: true } } }
    });
    <% } %>
  
    <% if (genderDistribution?.length) { %>
    new Chart(document.getElementById("genderDistributionChart"), {
      type: "pie",
      data: {
        labels: <%- JSON.stringify(genderDistribution.map(g => g.gender)) %>,
        datasets: [{ label: "Gender", data: <%- JSON.stringify(genderDistribution.map(g => g.count)) %>, backgroundColor: ["#42A5F5", "#EF5350", "#FFCA28"] }]
      },
      options: { responsive: true }
    });
    <% } %>
  
    <% if (employeeRoles?.length) { %>
    new Chart(document.getElementById("employeeRolesChart"), {
      type: "pie",
      data: {
        labels: <%- JSON.stringify(employeeRoles.map(r => r.role)) %>,
        datasets: [{ label: "Employees", data: <%- JSON.stringify(employeeRoles.map(r => r.count)) %>, backgroundColor: ["#66BB6A", "#FFA726", "#29B6F6", "#AB47BC", "#FF7043"] }]
      },
      options: { responsive: true }
    });
    <% } %>
  
    <% if (classStrengthProfile?.length) { %>
    new Chart(document.getElementById("classStrengthChart"), {
      type: "radar",
      data: {
        labels: <%- JSON.stringify(classStrengthProfile.map(s => s.subject_name)) %>,
        datasets: [{
          label: "Avg Score",
          data: <%- JSON.stringify(classStrengthProfile.map(s => s.avg_score)) %>,
          backgroundColor: "rgba(54, 162, 235, 0.2)",
          borderColor: "rgba(54, 162, 235, 1)",
          borderWidth: 2
        }]
      },
      options: { responsive: true, scales: { r: { beginAtZero: true } } }
    });
    <% } %>
  
    <% if (studentCountPerClass?.length) { %>
    new Chart(document.getElementById("studentCountChart"), {
      type: "bar",
      data: {
        labels: <%- JSON.stringify(studentCountPerClass.map(c => c.class_name)) %>,
        datasets: [{ label: "Students", data: <%- JSON.stringify(studentCountPerClass.map(c => c.student_count)) %>, backgroundColor: "#42A5F5" }]
      },
      options: { responsive: true, scales: { y: { beginAtZero: true } } }
    });
    <% } %>
  });
  </script>

  <script>
    document.addEventListener("DOMContentLoaded", () => {
      function createChart(id, config) {
        const canvas = document.getElementById(id);
        if (canvas) {
          const existing = Chart.getChart(id);
          if (existing) existing.destroy();
          new Chart(canvas, config);
        }
      }
  
      <% if (studentCountPerClass?.length) { %>
        createChart("studentCountChart", {
          type: "bar",
          data: {
            labels: <%- JSON.stringify(studentCountPerClass.map(c => c.class_name)) %>,
            datasets: [{
              label: "Students",
              data: <%- JSON.stringify(studentCountPerClass.map(c => c.student_count)) %>,
              backgroundColor: "#42A5F5"
            }]
          },
          options: { responsive: true, scales: { y: { beginAtZero: true } } }
        });
      <% } %>
  
      <% if (classStrengthProfile?.length) { %>
        createChart("classStrengthChart", {
          type: "radar",
          data: {
            labels: <%- JSON.stringify(classStrengthProfile.map(s => s.subject_name)) %>,
            datasets: [{
              label: "Avg Score",
              data: <%- JSON.stringify(classStrengthProfile.map(s => s.avg_score)) %>,
              backgroundColor: "rgba(54, 162, 235, 0.2)",
              borderColor: "rgba(54, 162, 235, 1)",
              borderWidth: 2
            }]
          },
          options: { responsive: true, scales: { r: { beginAtZero: true } } }
        });
      <% } %>
    });
  </script>
  
  