<%
  const features = typeof allowedFeatures !== 'undefined' && Array.isArray(allowedFeatures) ? allowedFeatures : [];
  // The hub's school page reuses this view (views/hub/organizationDetails.ejs) with its own addresses.
  const statsBase = typeof statsBasePath !== 'undefined' && statsBasePath ? statsBasePath : '/stats/organization';
  const statsExport = typeof statsExportPath !== 'undefined' && statsExportPath ? statsExportPath : '/stats/organization/export';
  const statsParams = typeof statsExtraParams !== 'undefined' && statsExtraParams ? statsExtraParams : {};
  const allowPdf = typeof statsAllowPdf === 'undefined' ? true : !!statsAllowPdf;
  const allowCsv = typeof statsAllowCsv === 'undefined' ? true : !!statsAllowCsv;
  const statsPdf = typeof statsPdfPath !== 'undefined' && statsPdfPath ? statsPdfPath : '/stats/organization/pdf';
  const allowPrint = typeof statsAllowPrint !== 'undefined' && !!statsAllowPrint;
  const heading = typeof statsHeading !== 'undefined' && statsHeading ? statsHeading : 'Organization statistics';
  const canCompareClasses = features.includes("Class Base Analytics & Insights") && !isPdf && (typeof statsAllowCompare === 'undefined' || !!statsAllowCompare);
  const fmtPct = (value) => (value === null || value === undefined ? '—' : `${value}%`);
  const fmtNum = (value) => (value === null || value === undefined ? '—' : Number(value).toLocaleString());
  const barWidth = (value) => Math.max(0, Math.min(100, Number(value) || 0));
  const embedQuery = isEmbedded ? '&embed=workspace' : '';
  // Rows shown before "Show all" in the lists.
  const LIST_LIMIT = 5;
  const PROGRESS_LIMIT = 6;
  const extra = (index, limit) => (index >= limit ? ' class="os-extra"' : '');
  const icons = {
    users: '<path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"/>',
    chart: '<path d="M3 3v18h18"/><path d="m19 9-5 5-4-4-3 3"/>',
    check: '<path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><path d="m9 11 3 3L22 4"/>',
    calendar: '<rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/>',
    edit: '<path d="M12 20h9"/><path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4Z"/>',
    support: '<path d="M12 9v4M12 17h.01"/><path d="M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0Z"/>',
    layers: '<path d="m12 2 10 5-10 5L2 7Z"/><path d="m2 17 10 5 10-5M2 12l10 5 10-5"/>',
    staff: '<rect x="2" y="7" width="20" height="14" rx="2"/><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/>',
    download: '<path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><path d="m7 10 5 5 5-5M12 15V3"/>',
    sheet: '<path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8Z"/><path d="M14 2v6h6M8 13h8M8 17h8"/>',
    compare: '<path d="M18 20V10M12 20V4M6 20v-6"/>',
    info: '<circle cx="12" cy="12" r="10"/><path d="M12 16v-4M12 8h.01"/>',
    print: '<path d="M6 9V2h12v7"/><path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"/><rect x="6" y="14" width="12" height="8"/>',
  };
  const icon = (name) => `<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${icons[name]}</svg>`;
%>
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
<style>
  .os-page {
    --os-ink: #0f172a;
    --os-ink-2: #475569;
    --os-muted: #64748b;
    --os-grid: #e7e5df;
    --os-surface: #ffffff;
    --os-plane: #f6f7fb;
    --os-border: #e2e8f0;
    --os-good: #047857;
    --os-bad: #b42318;
    --os-accent: var(--org-primary-color, #2a78d6);
    --os-accent-soft: color-mix(in srgb, var(--os-accent) 10%, white);
    --os-accent-deep: color-mix(in srgb, var(--os-accent) 82%, black);
    box-sizing: border-box;
    width: 100%;
    padding: 24px 28px 40px;
    background: var(--os-plane);
    color: var(--os-ink);
  }
  .os-page *, .os-page *::before, .os-page *::after { box-sizing: border-box; }
  .os-page.is-embedded { padding: 16px; }
  .os-page svg { flex: none; }

  /* Header band */
  .os-hero {
    position: relative;
    overflow: hidden;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 16px 24px;
    margin-bottom: 20px;
    padding: 0;
    border-radius: 0;
    background: none;
    color: var(--os-ink);
  }
  .os-hero::after { display: none;
    content: "";
    position: absolute;
    top: -60%;
    right: -8%;
    width: 360px;
    height: 360px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(255, 255, 255, 0.14) 0%, transparent 70%);
    pointer-events: none;
  }
  .os-hero > * { position: relative; z-index: 1; }
  .os-title { margin: 0; padding: 0; font-size: 20px; font-weight: 700; line-height: 1.25; text-align: left; color: var(--os-ink); }
  .os-subtitle { margin: 4px 0 0; padding: 0; font-size: 14px; text-align: left; color: var(--os-ink-2, #64748b); }
  .os-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; }
  .os-actions select {
    width: auto;
    min-width: 220px;
    height: 38px;
    margin: 0;
    padding: 0 10px;
    border: 1px solid var(--os-border, #e2e8f0);
    border-radius: 9px;
    background: #fff;
    color: var(--os-ink);
    font: inherit;
    font-size: 14px;
    font-weight: 600;
  }
  .os-btn {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    width: auto;
    height: 38px;
    margin: 0;
    padding: 0 14px;
    border: 1px solid var(--os-border, #e2e8f0);
    border-radius: 9px;
    background: #fff;
    color: var(--os-ink);
    font: inherit;
    font-size: 13.5px;
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
    cursor: pointer;
  }
  .os-btn:hover { background: #f8fafc; border-color: #cbd5e1; color: var(--os-ink); }
  .os-btn[aria-busy="true"] { opacity: 0.75; cursor: progress; }
  .os-action-message { width: 100%; margin: 0; font-size: 13px; color: var(--os-ink-2, #64748b); }

  /* Headline tiles */
  .os-kpis { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 14px; margin-bottom: 28px; }
  .os-kpi {
    display: flex;
    flex-direction: column;
    padding: 16px 18px;
    border: 1px solid var(--os-border);
    border-radius: 14px;
    background: var(--os-surface);
    box-shadow: 0 1px 2px rgba(15, 23, 42, 0.04);
  }
  .os-kpi-top { display: flex; align-items: center; gap: 10px; }
  .os-kpi-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 34px;
    border-radius: 10px;
    background: color-mix(in srgb, var(--chip) 13%, white);
    color: var(--chip);
  }
  .os-kpi-label { font-size: 13px; font-weight: 600; color: var(--os-ink-2); }
  .os-kpi-value { margin-top: 12px; font-size: 28px; font-weight: 700; line-height: 1.1; color: var(--os-ink); font-variant-numeric: tabular-nums; }
  .os-kpi-note { margin-top: 6px; font-size: 12.5px; color: var(--os-muted); }
  .os-kpi-tag {
    align-self: flex-start;
    margin-top: 8px;
    padding: 2px 8px;
    border-radius: 999px;
    background: var(--os-accent-soft);
    color: var(--os-accent-deep);
    font-size: 11.5px;
    font-weight: 600;
  }
  .os-meter { height: 6px; margin-top: 10px; border-radius: 999px; background: color-mix(in srgb, currentColor 12%, transparent); overflow: hidden; }
  .os-meter > span { display: block; height: 100%; border-radius: inherit; background: var(--chip, var(--os-accent)); }
  .os-delta-up { color: var(--os-good); font-weight: 700; }
  .os-delta-down { color: var(--os-bad); font-weight: 700; }

  /* Sections and cards */
  .os-sections { display: flex; flex-direction: column; gap: 28px; }
  .os-section-head { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 6px 12px; margin-bottom: 12px; }
  .os-section-title { margin: 0; font-size: 17px; font-weight: 700; color: var(--os-ink); }
  .os-section-meta { font-size: 13px; color: var(--os-muted); }
  .os-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(380px, 1fr)); gap: 16px; align-items: stretch; }
  .os-card {
    display: flex;
    flex-direction: column;
    min-width: 0;
    padding: 18px 20px;
    border: 1px solid var(--os-border);
    border-radius: 14px;
    background: var(--os-surface);
    box-shadow: 0 1px 2px rgba(15, 23, 42, 0.04);
  }
  .os-card h3 { display: flex; align-items: center; gap: 8px; margin: 0; font-size: 15px; font-weight: 700; color: var(--os-ink); }
  .os-card h3::before { content: ""; flex: none; width: 4px; height: 16px; border-radius: 2px; background: var(--series, var(--os-accent)); }
  .os-card-note { margin: 4px 0 14px; font-size: 12.5px; color: var(--os-muted); }
  .os-chart { position: relative; width: 100%; }

  /* Cards still waiting for data sit after the others, compact. */
  .os-card.is-empty { align-self: start; padding: 14px 18px; background: #fbfbfd; box-shadow: none; }

  /* Long lists show the first few rows; the rest open on request so cards
     in a row stay the same length. */
  .os-page.has-toggles .os-collapsible:not(.is-expanded) .os-extra { display: none; }
  .os-card-foot { display: flex; flex-wrap: wrap; align-items: flex-start; gap: 4px 16px; margin-top: auto; padding-top: 12px; }
  .os-card-foot:empty { display: none; }
  .os-more-btn {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    width: auto;
    margin: 0;
    padding: 0;
    border: 0;
    background: none;
    color: var(--os-accent);
    font: inherit;
    font-size: 13px;
    font-weight: 600;
    cursor: pointer;
  }
  .os-more-btn:hover { text-decoration: underline; }
  .os-more-btn svg { transition: transform 0.15s ease; }
  .os-more-btn[aria-expanded="true"] svg { transform: rotate(180deg); }
  .os-card.is-empty .os-card-note { margin-bottom: 8px; }
  .os-empty {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 10px 12px;
    border-radius: 9px;
    background: #f1f3f7;
    color: var(--os-muted);
    font-size: 13px;
  }
  .os-waiting h3::before { background: #cbd5e1; }
  .os-chip-list { display: flex; flex-wrap: wrap; gap: 6px; margin: 0; padding: 0; list-style: none; }
  .os-chip-list li { padding: 4px 10px; border: 1px solid var(--os-border); border-radius: 999px; background: #fff; color: var(--os-ink-2); font-size: 12.5px; }
  .os-empty--ok { background: color-mix(in srgb, var(--os-good) 8%, white); color: var(--os-good); font-weight: 600; }

  .os-notice {
    display: flex;
    gap: 10px;
    align-items: flex-start;
    margin-bottom: 14px;
    padding: 12px 14px;
    border: 1px solid color-mix(in srgb, var(--os-accent) 25%, white);
    border-radius: 12px;
    background: var(--os-accent-soft);
    color: var(--os-ink);
    font-size: 13.5px;
    line-height: 1.5;
  }
  .os-notice svg { margin-top: 2px; color: var(--os-accent); }
  .os-notice a { color: var(--os-accent-deep); font-weight: 700; }

  .os-table-toggle { flex-basis: 100%; font-size: 13px; }
  .os-table-toggle summary { cursor: pointer; color: var(--os-accent); font-weight: 600; }
  .os-table { width: 100%; margin-top: 8px; border-collapse: collapse; font-size: 13px; }
  .os-table th { padding: 7px 8px; border-bottom: 1px solid var(--os-border); background: #f8fafc; color: var(--os-ink-2); font-weight: 700; text-align: left; }
  .os-table td { padding: 7px 8px; border-bottom: 1px solid var(--os-grid); text-align: left; }
  .os-table td.num, .os-table th.num { text-align: right; font-variant-numeric: tabular-nums; }
  .os-table td.nowrap { white-space: nowrap; }
  .os-rank {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background: #f1f3f7;
    font-size: 12px;
    font-weight: 700;
  }
  .os-rank.is-top { background: var(--os-accent-soft); color: var(--os-accent-deep); }

  /* Score entry progress */
  .os-progress-list { display: flex; flex-direction: column; gap: 12px; margin: 0; padding: 0; list-style: none; }
  .os-progress-row { display: grid; grid-template-columns: minmax(80px, 140px) 1fr auto; align-items: center; gap: 12px; font-size: 13px; }
  .os-progress-name { font-weight: 600; color: var(--os-ink); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .os-progress-bar { height: 8px; border-radius: 999px; background: #eef0f4; overflow: hidden; }
  .os-progress-bar > span { display: block; height: 100%; border-radius: inherit; background: var(--series, var(--os-accent)); }
  .os-progress-value { color: var(--os-ink-2); font-variant-numeric: tabular-nums; white-space: nowrap; }
  .os-progress-value strong { color: var(--os-ink); }
  .os-done { color: var(--os-good); font-weight: 700; }

  /* Class comparison */
  .os-compare { display: none; margin-bottom: 28px; }
  .os-compare.is-open { display: block; }
  .os-class-options { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 12px; }
  .os-class-option {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 7px 12px;
    border: 1px solid var(--os-border);
    border-radius: 999px;
    font-size: 13.5px;
    cursor: pointer;
  }
  .os-class-option input { width: 16px; height: 16px; margin: 0; accent-color: var(--os-accent); }
  .os-primary-btn {
    display: inline-flex;
    width: auto;
    margin: 0;
    padding: 9px 16px;
    border: 0;
    border-radius: 9px;
    background: var(--os-accent);
    color: #fff;
    font: inherit;
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;
  }
  .os-primary-btn[disabled] { opacity: 0.6; cursor: progress; }
  .os-compare-message { margin: 0 0 10px; color: var(--os-bad); font-size: 13.5px; }

  /* PDF */
  .os-page.is-pdf { width: 1000px; padding: 0; background: #fff; }
  .os-page.is-pdf .os-kpi, .os-page.is-pdf .os-card { box-shadow: none; break-inside: avoid; page-break-inside: avoid; }
  .os-page.is-pdf .os-section-head { break-after: avoid; page-break-after: avoid; }
  .os-page.is-pdf .os-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .os-page.is-pdf .os-kpis { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  .os-page.is-pdf .os-table-toggle, .os-page.is-pdf .os-notice a, .os-page.is-pdf .os-more-btn { display: none; }

  @media (max-width: 1024px) {
    .os-kpis { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 720px) {
    .os-page { padding: 16px; }
    .os-hero { padding: 18px; }
    .os-grid { grid-template-columns: 1fr; }
    .os-actions, .os-actions select { width: 100%; }
    .os-btn { flex: 1 1 auto; justify-content: center; }
    .os-kpi-value { font-size: 23px; }
    .os-progress-row { grid-template-columns: 80px 1fr auto; }
    /* Wide tables scroll inside their card instead of pushing the page. */
    .os-table { display: block; max-width: 100%; overflow-x: auto; -webkit-overflow-scrolling: touch; }
    .os-table td, .os-table th { white-space: nowrap; }
  }
</style>

<div class="os-page<%= isEmbedded ? ' is-embedded' : '' %><%= isPdf ? ' is-pdf' : '' %>" data-no-global-sort>
  <header class="os-hero">
    <div>
      <h1 class="os-title"><%= isPdf && organizationName ? `${organizationName} · ` : '' %><%= heading %></h1>
      <p class="os-subtitle">
        <% if (currentTerm) { %><%= currentTerm.term_name %> · <%= currentTerm.year_label %><%= currentTerm.current ? ' · Current term' : '' %><% } else { %>No term has saved data yet<% } %>
        <% if (isPdf) { %> · Generated <%= new Date().toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' }) %><% } %>
      </p>
    </div>
    <% if (!isPdf && schoolYears.length) { %>
    <form class="os-actions" method="GET" action="<%= statsBase %>" id="osTermForm">
      <% if (isEmbedded) { %><input type="hidden" name="embed" value="workspace" /><% } %>
      <% Object.keys(statsParams).forEach((k) => { %><input type="hidden" name="<%= k %>" value="<%= statsParams[k] %>" /><% }) %>
      <select name="selectedTermId" id="osTermSelect" aria-label="Term">
        <% schoolYears.forEach((year) => { %>
        <optgroup label="<%= year.year_label %>">
          <% year.terms.forEach((term) => { %>
          <option value="<%= term.term_id %>" <%= currentTerm && currentTerm.term_id === term.term_id ? 'selected' : '' %>><%= term.term_name %><%= term.current ? ' (current)' : '' %></option>
          <% }); %>
        </optgroup>
        <% }); %>
      </select>
      <% if (stats) { %>
      <% if (allowPdf) { %><button type="button" class="os-btn" id="osPdfBtn" data-url="<%= statsPdf %>?selectedTermId=<%= currentTerm.term_id %>"><%- icon('download') %><span>Download PDF</span></button><% } %>
      <% if (allowPrint) { %><button type="button" class="os-btn" onclick="window.print()"><%- icon('print') %><span>Print</span></button><% } %>
      <% if (allowCsv) { %><a class="os-btn" href="<%= statsExport %>?selectedTermId=<%= currentTerm.term_id %>" download><%- icon('sheet') %><span>Excel (CSV)</span></a><% } %>
      <% } %>
      <% if (canCompareClasses && stats) { %>
      <button type="button" class="os-btn" id="osCompareToggle" aria-expanded="false" aria-controls="osCompare"><%- icon('compare') %><span>Compare classes</span></button>
      <% } %>
      <p class="os-action-message" id="osActionMessage" role="status" hidden></p>
    </form>
    <% } %>
  </header>

  <% if (!stats) { %>
    <div class="os-card"><div class="os-empty"><%- icon('info') %>Statistics appear here once students are enrolled or scores and attendance are saved for a term.</div></div>
  <% } else {
       const k = stats.kpis;
       const a = stats.academic;
       const academicTag = a && a.isFallback ? a.term.label : null;
  %>

  <% if (canCompareClasses) { %>
  <section class="os-compare os-card" id="osCompare" aria-labelledby="osCompareTitle">
    <h3 id="osCompareTitle">Compare classes · <%= currentTerm.term_name %></h3>
    <p class="os-card-note">Pick two or more classes to compare their average score, pass rate and attendance this term.</p>
    <div class="os-class-options" id="osClassOptions"><span class="os-card-note">Loading classes…</span></div>
    <p class="os-compare-message" id="osCompareMessage" hidden></p>
    <button type="button" class="os-primary-btn" id="osCompareBtn">Compare</button>
    <div id="osCompareResult" hidden>
      <div class="os-chart" style="height: 300px; margin-top: 16px;"><canvas id="osCompareChart" aria-label="Class comparison chart" role="img"></canvas></div>
      <table class="os-table" id="osCompareTable">
        <thead><tr><th>Class</th><th class="num">Enrolled</th><th class="num">Average score</th><th class="num">Pass rate</th><th class="num">Attendance</th></tr></thead>
        <tbody></tbody>
      </table>
      <p class="os-card-note">— means no scores or attendance have been saved for that class this term.</p>
    </div>
  </section>
  <% } %>

  <div class="os-kpis">
    <div class="os-kpi" style="--chip:#2a78d6">
      <div class="os-kpi-top"><span class="os-kpi-icon"><%- icon('users') %></span><span class="os-kpi-label">Enrolled students</span></div>
      <div class="os-kpi-value"><%= fmtNum(k.enrolled) %></div>
      <div class="os-kpi-note">
        <% if (k.enrolledChange === null) { %>First term with data
        <% } else if (k.enrolledChange === 0) { %>No change from <%= k.previousTermLabel %>
        <% } else { %><span class="<%= k.enrolledChange > 0 ? 'os-delta-up' : 'os-delta-down' %>"><%= k.enrolledChange > 0 ? '▲' : '▼' %> <%= Math.abs(k.enrolledChange) %></span> vs <%= k.previousTermLabel %><% } %>
      </div>
    </div>
    <div class="os-kpi" style="--chip:#eb6834">
      <div class="os-kpi-top"><span class="os-kpi-icon"><%- icon('chart') %></span><span class="os-kpi-label">Average score</span></div>
      <div class="os-kpi-value"><%= fmtPct(a && a.averageScore) %></div>
      <% if (a) { %><div class="os-meter"><span style="width: <%= barWidth(a.averageScore) %>%"></span></div><% } %>
      <div class="os-kpi-note"><%= a ? `${fmtNum(a.studentsWithScores)} students with scores` : 'No scores saved yet' %></div>
      <% if (academicTag) { %><span class="os-kpi-tag">Latest results · <%= academicTag %></span><% } %>
    </div>
    <div class="os-kpi" style="--chip:#1baf7a">
      <div class="os-kpi-top"><span class="os-kpi-icon"><%- icon('check') %></span><span class="os-kpi-label">Pass rate</span></div>
      <div class="os-kpi-value"><%= fmtPct(a && a.passRate) %></div>
      <% if (a) { %><div class="os-meter"><span style="width: <%= barWidth(a.passRate) %>%"></span></div><% } %>
      <div class="os-kpi-note">Subject results at <%= passMark %>% or above</div>
      <% if (academicTag) { %><span class="os-kpi-tag">Latest results · <%= academicTag %></span><% } %>
    </div>
    <div class="os-kpi" style="--chip:#4a3aa7">
      <div class="os-kpi-top"><span class="os-kpi-icon"><%- icon('calendar') %></span><span class="os-kpi-label">Attendance rate</span></div>
      <div class="os-kpi-value"><%= fmtPct(k.attendanceRate) %></div>
      <% if (k.attendanceRate !== null) { %><div class="os-meter"><span style="width: <%= barWidth(k.attendanceRate) %>%"></span></div><% } %>
      <div class="os-kpi-note"><%= k.attendanceRate === null ? 'No attendance marked this term yet' : `${k.lowAttendance} student${k.lowAttendance === 1 ? '' : 's'} below ${lowAttendanceRate}%` %></div>
    </div>
    <div class="os-kpi" style="--chip:#eda100">
      <div class="os-kpi-top"><span class="os-kpi-icon"><%- icon('edit') %></span><span class="os-kpi-label">Score entry</span></div>
      <div class="os-kpi-value"><%= fmtPct(k.scoreEntryRate) %></div>
      <% if (k.scoreEntryRate !== null) { %><div class="os-meter"><span style="width: <%= barWidth(k.scoreEntryRate) %>%"></span></div><% } %>
      <div class="os-kpi-note"><%= k.scoresExpected ? `${fmtNum(k.scoresEntered)} of ${fmtNum(k.scoresExpected)} scores entered this term` : 'No assessments set up this term yet' %></div>
    </div>
    <div class="os-kpi" style="--chip:#e34948">
      <div class="os-kpi-top"><span class="os-kpi-icon"><%- icon('support') %></span><span class="os-kpi-label">Students needing support</span></div>
      <div class="os-kpi-value"><%= a ? fmtNum(a.needsSupportCount) : '—' %></div>
      <div class="os-kpi-note">Averaging below <%= passMark %>%</div>
      <% if (academicTag) { %><span class="os-kpi-tag">Latest results · <%= academicTag %></span><% } %>
    </div>
    <div class="os-kpi" style="--chip:#008300">
      <div class="os-kpi-top"><span class="os-kpi-icon"><%- icon('layers') %></span><span class="os-kpi-label">Active classes</span></div>
      <div class="os-kpi-value"><%= fmtNum(k.activeClasses) %></div>
      <div class="os-kpi-note">of <%= fmtNum(k.totalClasses) %> classes have students enrolled</div>
    </div>
    <div class="os-kpi" style="--chip:#e87ba4">
      <div class="os-kpi-top"><span class="os-kpi-icon"><%- icon('staff') %></span><span class="os-kpi-label">Staff</span></div>
      <div class="os-kpi-value"><%= fmtNum(k.staff) %></div>
      <div class="os-kpi-note"><%= fmtNum(k.teachers) %> teacher<%= k.teachers === 1 ? '' : 's' %></div>
    </div>
  </div>

  <div class="os-sections" id="osSections">
    <section class="os-section" data-section="academic">
      <div class="os-section-head">
        <h2 class="os-section-title">Academic performance</h2>
        <% if (a) { %><span class="os-section-meta"><%= a.term.label %></span><% } %>
      </div>
      <% if (academicTag) { %>
      <div class="os-notice"><%- icon('info') %><div>No scores have been saved for <strong><%= currentTerm.term_name %> (<%= currentTerm.year_label %>)</strong> yet, so this section shows the latest results, from <strong><%= academicTag %></strong>. It switches to this term as soon as scores are saved. <a href="<%= statsBase %>?selectedTermId=<%= a.term.term_id %><%= embedQuery %><% Object.keys(statsParams).forEach((k) => { %>&<%= k %>=<%= encodeURIComponent(statsParams[k]) %><% }) %>">Open <%= academicTag %></a></div></div>
      <% } %>
      <div class="os-grid">
        <div class="os-card" style="--series: var(--os-accent)">
          <h3>Average score by class</h3>
          <p class="os-card-note">Each student's subject percentage, averaged per class.</p>
          <div data-chart="classAverage"></div>
        </div>
        <div class="os-card" style="--series:#1baf7a">
          <h3>Pass rate by class</h3>
          <p class="os-card-note">Share of subject results at <%= passMark %>% or above.</p>
          <div data-chart="classPass"></div>
        </div>
        <div class="os-card" style="--series:#2a78d6">
          <h3>Subject performance</h3>
          <p class="os-card-note">Average score per subject across all classes.</p>
          <div data-chart="subjects"></div>
        </div>
        <div class="os-card" style="--series:#1c5cab">
          <h3>Score distribution</h3>
          <p class="os-card-note">Students grouped by their overall average.</p>
          <div data-chart="distribution"></div>
        </div>
        <div class="os-card" style="--series:#eda100">
          <h3>Top students</h3>
          <p class="os-card-note">Highest overall averages.</p>
          <% if (a && a.topStudents.length) { %>
          <table class="os-table os-collapsible" data-limit="<%= LIST_LIMIT %>" data-noun="students">
            <thead><tr><th>#</th><th>Student</th><th>Class</th><th class="num">Average</th></tr></thead>
            <tbody>
              <% a.topStudents.forEach((s, i) => { %>
              <tr<%- extra(i, LIST_LIMIT) %>><td><span class="os-rank<%= i < 3 ? ' is-top' : '' %>"><%= i + 1 %></span></td><td><%= s.name %></td><td class="nowrap"><%= s.class_name %></td><td class="num"><%= fmtPct(s.average_score) %></td></tr>
              <% }); %>
            </tbody>
          </table>
          <% } else { %><div class="os-empty"><%- icon('info') %>No scores saved yet.</div><% } %>
        </div>
        <div class="os-card" style="--series:#e34948">
          <h3>Students needing support</h3>
          <p class="os-card-note">Lowest overall averages below <%= passMark %>% (up to 10).</p>
          <% if (a && a.needsSupport.length) { %>
          <table class="os-table os-collapsible" data-limit="<%= LIST_LIMIT %>" data-noun="students">
            <thead><tr><th>Student</th><th>Class</th><th class="num">Subjects</th><th class="num">Average</th></tr></thead>
            <tbody>
              <% a.needsSupport.forEach((s, i) => { %>
              <tr<%- extra(i, LIST_LIMIT) %>><td><%= s.name %></td><td class="nowrap"><%= s.class_name %></td><td class="num"><%= s.subjects %></td><td class="num"><%= fmtPct(s.average_score) %></td></tr>
              <% }); %>
            </tbody>
          </table>
          <% } else if (a) { %><div class="os-empty os-empty--ok"><%- icon('check') %>Every student is averaging <%= passMark %>% or above.</div>
          <% } else { %><div class="os-empty"><%- icon('info') %>No scores saved yet.</div><% } %>
        </div>
      </div>
    </section>

    <section class="os-section" data-section="term">
      <div class="os-section-head">
        <h2 class="os-section-title">This term</h2>
        <span class="os-section-meta"><%= currentTerm.term_name %> (<%= currentTerm.year_label %>)</span>
      </div>
      <div class="os-grid">
        <div class="os-card" style="--series:#eda100">
          <h3>Score entry progress</h3>
          <p class="os-card-note">Scores entered for each class out of all assessments set this term.</p>
          <% if (stats.scoreEntry.length) { %>
          <ul class="os-progress-list os-collapsible" data-limit="<%= PROGRESS_LIMIT %>" data-noun="classes">
            <% stats.scoreEntry.forEach((row, i) => { %>
            <li class="os-progress-row<%= i >= PROGRESS_LIMIT ? ' os-extra' : '' %>">
              <span class="os-progress-name" title="<%= row.class_name %>"><%= row.class_name %></span>
              <span class="os-progress-bar" role="img" aria-label="<%= row.class_name %>: <%= fmtPct(row.rate) %> entered"><span style="width: <%= barWidth(row.rate) %>%"></span></span>
              <span class="os-progress-value"><% if (row.rate === 100) { %><span class="os-done">✓ Complete</span><% } else { %><strong><%= fmtPct(row.rate) %></strong> · <%= fmtNum(row.entered) %> of <%= fmtNum(row.expected) %><% } %></span>
            </li>
            <% }); %>
          </ul>
          <% } else { %><div class="os-empty"><%- icon('info') %>No assessments have been set up for this term yet.</div><% } %>
        </div>
        <div class="os-card" style="--series:#4a3aa7">
          <h3>Attendance rate by class</h3>
          <p class="os-card-note">Present marks as a share of all marks this term.</p>
          <div data-chart="classAttendance"></div>
        </div>
        <div class="os-card" style="--series:#2a78d6">
          <h3>Students per class</h3>
          <p class="os-card-note">Students enrolled in each class this term.</p>
          <div data-chart="classEnrolled"></div>
        </div>
      </div>
    </section>

    <section class="os-section" data-section="enrollment">
      <div class="os-section-head">
        <h2 class="os-section-title">Enrollment &amp; staff</h2>
      </div>
      <div class="os-grid">
        <div class="os-card" style="--series: var(--os-accent)">
          <h3>Enrollment over terms</h3>
          <p class="os-card-note">Enrolled students in each term that has saved data.</p>
          <div data-chart="enrollmentTrend"></div>
        </div>
        <div class="os-card" style="--series:#eb6834">
          <h3>Gender</h3>
          <p class="os-card-note">Students enrolled this term.</p>
          <div data-chart="gender"></div>
        </div>
        <div class="os-card" style="--series:#e87ba4">
          <h3>Staff by role</h3>
          <p class="os-card-note">Active staff accounts.</p>
          <div data-chart="staff"></div>
        </div>
      </div>
    </section>
  </div>
  <% } %>
</div>

<script>
  (function () {
    const termSelect = document.getElementById("osTermSelect");
    if (termSelect) {
      termSelect.addEventListener("change", () => document.getElementById("osTermForm").submit());
    }

    const actionMessage = document.getElementById("osActionMessage");
    const showActionMessage = (text) => {
      if (!actionMessage) return;
      actionMessage.textContent = text;
      actionMessage.hidden = !text;
    };

    // The PDF is generated on the server (a few seconds), so show progress.
    const pdfButton = document.getElementById("osPdfBtn");
    if (pdfButton) {
      pdfButton.addEventListener("click", async () => {
        if (pdfButton.getAttribute("aria-busy") === "true") return;
        const label = pdfButton.querySelector("span");
        pdfButton.setAttribute("aria-busy", "true");
        label.textContent = "Preparing PDF…";
        showActionMessage("");
        try {
          const response = await fetch(pdfButton.dataset.url, { credentials: "same-origin" });
          if (!response.ok) {
            const body = await response.json().catch(() => ({}));
            throw new Error(body.error || "The PDF could not be generated. Please try again.");
          }
          const disposition = response.headers.get("Content-Disposition") || "";
          const match = disposition.match(/filename="([^"]+)"/);
          const url = URL.createObjectURL(await response.blob());
          const link = document.createElement("a");
          link.href = url;
          link.download = match ? match[1] : "Organization_Stats.pdf";
          document.body.appendChild(link);
          link.click();
          link.remove();
          setTimeout(() => URL.revokeObjectURL(url), 10000);
        } catch (error) {
          showActionMessage(error.message);
        } finally {
          pdfButton.removeAttribute("aria-busy");
          label.textContent = "Download PDF";
        }
      });
    }

    const stats = <%- JSON.stringify(stats || null).replace(/</g, '\\u003c') %>;
    if (!stats) { window.__orgStatsReady = true; return; }
    if (typeof Chart === "undefined") return;

    const page = document.querySelector(".os-page");
    const css = getComputedStyle(page);
    const accent = css.getPropertyValue("--os-accent").trim() || "#2a78d6";
    const ink2 = css.getPropertyValue("--os-ink-2").trim();
    const muted = css.getPropertyValue("--os-muted").trim();
    const grid = css.getPropertyValue("--os-grid").trim();
    // Categorical slots (validated order) for multi-series charts.
    const SLOTS = ["#2a78d6", "#eb6834", "#1baf7a", "#eda100", "#e87ba4", "#008300", "#4a3aa7", "#e34948"];
    // Ordinal blue ramp for the score bands (low -> high).
    const ORDINAL = ["#86b6ef", "#5598e7", "#2a78d6", "#1c5cab", "#104281"];

    Chart.defaults.animation = false;
    Chart.defaults.font.family = getComputedStyle(document.body).fontFamily;
    Chart.defaults.color = ink2;
    Chart.defaults.plugins.legend.labels.boxWidth = 12;
    Chart.defaults.plugins.legend.labels.boxHeight = 12;

    const axis = (extra = {}) => ({
      grid: { color: grid, drawTicks: false },
      border: { color: grid },
      ticks: { color: muted, padding: 6 },
      ...extra,
    });

    const escapeHtml = (value) => String(value).replace(/[&<>"']/g, (ch) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[ch]));
    const infoIcon = '<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M12 16v-4M12 8h.01"/></svg>';

    // Each chart takes its colour from its card's --series token.
    const seriesColor = (host) => {
      const value = getComputedStyle(host.closest(".os-card")).getPropertyValue("--series").trim();
      return value && !value.startsWith("var(") ? value : accent;
    };

    // Charts are drawn after the cards are ordered, so moving a card never
    // resizes a drawn chart.
    const isPdf = page.classList.contains("is-pdf");
    const chevron = '<svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>';
    const moreButton = (total, noun) => `<button type="button" class="os-more-btn" aria-expanded="false" data-total="${total}" data-noun="${noun}"><span>Show all ${total} ${noun}</span>${chevron}</button>`;
    const setMoreLabel = (button, expanded) => {
      button.setAttribute("aria-expanded", expanded ? "true" : "false");
      button.querySelector("span").textContent = expanded ? "Show fewer" : `Show all ${button.dataset.total} ${button.dataset.noun}`;
    };

    // Bar charts list at most this many bars until "Show all" is clicked,
    // so every chart card has the same height.
    const BAR_LIMIT = 6;
    const pendingCharts = [];
    const mount = (key, { hasData, emptyText, height, config, table, items, noun }) => {
      const host = document.querySelector(`[data-chart="${key}"]`);
      if (!host) return;
      if (!hasData) {
        host.innerHTML = `<div class="os-empty">${infoIcon}${escapeHtml(emptyText)}</div>`;
        return;
      }
      const card = host.closest(".os-card");
      const color = seriesColor(host);
      const limited = !isPdf && items && items.length > BAR_LIMIT;
      const tableHtml = `<details class="os-table-toggle"><summary>View as table</summary><table class="os-table"><thead><tr>${table.head.map((h, i) => `<th class="${i ? "num" : ""}">${escapeHtml(h)}</th>`).join("")}</tr></thead><tbody>${table.rows.map((r) => `<tr>${r.map((c, i) => `<td class="${i ? "num" : ""}">${escapeHtml(c)}</td>`).join("")}</tr>`).join("")}</tbody></table></details>`;
      const shown = items ? (limited ? BAR_LIMIT : items.length) : null;
      host.innerHTML = `<div class="os-chart" style="height:${items ? barHeight(shown) : height}px"><canvas role="img" aria-label="${escapeHtml(card.querySelector("h3").textContent)}"></canvas></div>`;
      const foot = document.createElement("div");
      foot.className = "os-card-foot";
      foot.innerHTML = `${limited ? moreButton(items.length, noun) : ""}${tableHtml}`;
      card.appendChild(foot);
      const entry = { canvas: host.querySelector("canvas"), config: items ? config(color, shown) : (typeof config === "function" ? config(color) : config) };
      pendingCharts.push(entry);
      if (limited) {
        const button = foot.querySelector(".os-more-btn");
        button.addEventListener("click", () => {
          const expanded = button.getAttribute("aria-expanded") !== "true";
          const count = expanded ? items.length : BAR_LIMIT;
          const next = config(color, count);
          entry.chart.data.labels = next.data.labels;
          entry.chart.data.datasets[0].data = next.data.datasets[0].data;
          host.querySelector(".os-chart").style.height = `${barHeight(count)}px`;
          entry.chart.resize();
          entry.chart.update();
          setMoreLabel(button, expanded);
        });
      }
    };

    const pct = (v) => (v === null || v === undefined ? "—" : `${v}%`);
    // Splits a long axis label onto two lines instead of tilting it.
    const wrapLabel = (label) => {
      if (label.length <= 10) return label;
      const words = label.split(" ");
      const half = Math.ceil(words.length / 2);
      return [words.slice(0, half).join(" "), words.slice(half).join(" ")];
    };
    const barHeight = (count) => Math.max(230, count * 30 + 50);

    // One horizontal bar series in one colour.
    const hbar = (labels, values, { suffix = "", max, integer = false } = {}) => (color) => ({
      type: "bar",
      data: { labels, datasets: [{ data: values, backgroundColor: color, borderRadius: 4, maxBarThickness: 18, borderSkipped: false }] },
      options: {
        indexAxis: "y",
        maintainAspectRatio: false,
        plugins: { legend: { display: false }, tooltip: { callbacks: { label: (ctx) => ` ${ctx.parsed.x}${suffix}` } } },
        scales: { x: axis({ beginAtZero: true, ...(max ? { suggestedMax: max } : {}), ticks: { color: muted, ...(integer ? { precision: 0 } : { callback: (v) => `${v}${suffix}` }) } }), y: axis({ grid: { display: false } }) },
      },
    });

    const academic = stats.academic || { classes: [], subjects: [], distribution: [] };
    const noScores = "No scores saved yet.";

    mount("classAverage", {
      hasData: academic.classes.length > 0,
      emptyText: noScores,
      items: academic.classes,
      noun: "classes",
      config: (color, n) => hbar(academic.classes.slice(0, n).map((c) => c.class_name), academic.classes.slice(0, n).map((c) => c.average_score), { suffix: "%", max: 100 })(color),
      table: { head: ["Class", "Average score", "Pass rate", "Subject results"], rows: academic.classes.map((c) => [c.class_name, pct(c.average_score), pct(c.pass_rate), c.results]) },
    });

    mount("classPass", {
      hasData: academic.classes.length > 0,
      emptyText: noScores,
      items: academic.classes,
      noun: "classes",
      config: (color, n) => hbar(academic.classes.slice(0, n).map((c) => c.class_name), academic.classes.slice(0, n).map((c) => c.pass_rate), { suffix: "%", max: 100 })(color),
      table: { head: ["Class", "Pass rate", "Average score"], rows: academic.classes.map((c) => [c.class_name, pct(c.pass_rate), pct(c.average_score)]) },
    });

    mount("subjects", {
      hasData: academic.subjects.length > 0,
      emptyText: noScores,
      items: academic.subjects,
      noun: "subjects",
      config: (color, n) => hbar(academic.subjects.slice(0, n).map((s) => s.subject_name), academic.subjects.slice(0, n).map((s) => s.average_score), { suffix: "%", max: 100 })(color),
      table: { head: ["Subject", "Average score", "Pass rate", "Results"], rows: academic.subjects.map((s) => [s.subject_name, pct(s.average_score), pct(s.pass_rate), s.results]) },
    });

    const distributionTotal = academic.distribution.reduce((sum, band) => sum + band.students, 0);
    mount("distribution", {
      hasData: distributionTotal > 0,
      emptyText: noScores,
      height: 230,
      config: {
        type: "bar",
        data: { labels: academic.distribution.map((b) => b.label), datasets: [{ data: academic.distribution.map((b) => b.students), backgroundColor: ORDINAL, borderRadius: 4, maxBarThickness: 44 }] },
        options: {
          maintainAspectRatio: false,
          plugins: { legend: { display: false }, tooltip: { callbacks: { label: (ctx) => ` ${ctx.parsed.y} student${ctx.parsed.y === 1 ? "" : "s"}` } } },
          scales: {
            x: axis({ grid: { display: false }, ticks: { color: muted, maxRotation: 0, autoSkip: false, callback: (value, index) => wrapLabel(academic.distribution[index].label) } }),
            y: axis({ beginAtZero: true, ticks: { color: muted, precision: 0 } }),
          },
        },
      },
      table: { head: ["Overall average", "Students"], rows: academic.distribution.map((b) => [b.label, b.students]) },
    });

    const classesWithAttendance = stats.classes.filter((c) => c.attendance_rate !== null);
    mount("classAttendance", {
      hasData: classesWithAttendance.length > 0,
      emptyText: "No attendance marked this term yet.",
      items: classesWithAttendance,
      noun: "classes",
      config: (color, n) => hbar(classesWithAttendance.slice(0, n).map((c) => c.class_name), classesWithAttendance.slice(0, n).map((c) => c.attendance_rate), { suffix: "%", max: 100 })(color),
      table: { head: ["Class", "Attendance rate"], rows: classesWithAttendance.map((c) => [c.class_name, pct(c.attendance_rate)]) },
    });

    const classesEnrolled = stats.classes.filter((c) => c.enrolled > 0);
    mount("classEnrolled", {
      hasData: classesEnrolled.length > 0,
      emptyText: "No students enrolled this term yet.",
      items: classesEnrolled,
      noun: "classes",
      config: (color, n) => hbar(classesEnrolled.slice(0, n).map((c) => c.class_name), classesEnrolled.slice(0, n).map((c) => c.enrolled), { integer: true })(color),
      table: { head: ["Class", "Students"], rows: classesEnrolled.map((c) => [c.class_name, c.enrolled]) },
    });

    mount("enrollmentTrend", {
      hasData: stats.enrollmentTrend.length > 0,
      emptyText: "No enrollment saved yet.",
      height: 230,
      config: (color) => ({
        type: "line",
        data: { labels: stats.enrollmentTrend.map((t) => [t.term_name, t.year_label]), datasets: [{ data: stats.enrollmentTrend.map((t) => t.enrolled), borderColor: color, backgroundColor: color, borderWidth: 2, pointRadius: 4, pointHoverRadius: 6, tension: 0 }] },
        options: {
          maintainAspectRatio: false,
          interaction: { mode: "index", intersect: false },
          plugins: { legend: { display: false }, tooltip: { callbacks: { title: (items) => stats.enrollmentTrend[items[0].dataIndex].label, label: (ctx) => ` ${ctx.parsed.y} students` } } },
          scales: { x: axis({ grid: { display: false } }), y: axis({ beginAtZero: true, ticks: { color: muted, precision: 0 } }) },
        },
      }),
      table: { head: ["Term", "Enrolled students"], rows: stats.enrollmentTrend.map((t) => [t.label, t.enrolled]) },
    });

    // Colour follows the gender, not its rank, so terms stay comparable.
    const GENDER_SLOT = { male: SLOTS[0], female: SLOTS[1] };
    const genderColor = (g, i) => GENDER_SLOT[String(g).toLowerCase()] || SLOTS[2 + i] || SLOTS[SLOTS.length - 1];
    const genderTotal = stats.gender.reduce((sum, g) => sum + g.count, 0);
    const genderShare = (count) => `${Math.round((count / genderTotal) * 100)}%`;
    mount("gender", {
      hasData: genderTotal > 0,
      emptyText: "No students enrolled this term yet.",
      height: 230,
      config: {
        type: "doughnut",
        data: { labels: stats.gender.map((g) => g.gender), datasets: [{ data: stats.gender.map((g) => g.count), backgroundColor: stats.gender.map((g, i) => genderColor(g.gender, i)), borderColor: "#ffffff", borderWidth: 2 }] },
        options: {
          maintainAspectRatio: false,
          cutout: "62%",
          plugins: {
            legend: {
              position: "right",
              labels: {
                generateLabels: (chart) => chart.data.labels.map((label, i) => ({
                  text: `${label}  ${stats.gender[i].count} (${genderShare(stats.gender[i].count)})`,
                  fillStyle: chart.data.datasets[0].backgroundColor[i],
                  strokeStyle: chart.data.datasets[0].backgroundColor[i],
                  fontColor: ink2,
                  lineWidth: 0,
                  index: i,
                })),
              },
            },
            tooltip: { callbacks: { label: (ctx) => ` ${ctx.label}: ${ctx.parsed} (${genderShare(ctx.parsed)})` } },
          },
        },
      },
      table: { head: ["Gender", "Students", "Share"], rows: stats.gender.map((g) => [g.gender, g.count, genderShare(g.count)]) },
    });

    mount("staff", {
      hasData: stats.staff.length > 0,
      emptyText: "No active staff accounts.",
      items: stats.staff,
      noun: "roles",
      config: (color, n) => hbar(stats.staff.slice(0, n).map((s) => s.role), stats.staff.slice(0, n).map((s) => s.count), { integer: true })(color),
      table: { head: ["Role", "Staff"], rows: stats.staff.map((s) => [s.role, s.count]) },
    });

    // Cards with data first; cards still waiting for data move after them.
    // A section with nothing to show moves below the sections that have data.
    // Two or more waiting cards collapse into one "Waiting for data" card.
    document.querySelectorAll("#osSections .os-grid").forEach((gridEl) => {
      const cards = Array.from(gridEl.children);
      cards.forEach((card) => card.classList.toggle("is-empty", !!card.querySelector(".os-empty:not(.os-empty--ok)")));
      const waiting = cards.filter((card) => card.classList.contains("is-empty"));
      if (waiting.length < 2) {
        waiting.forEach((card) => gridEl.appendChild(card));
        return;
      }
      const reasons = Array.from(new Set(waiting.map((card) => card.querySelector(".os-empty").textContent.trim())));
      const summary = document.createElement("div");
      summary.className = "os-card is-empty os-waiting";
      summary.innerHTML = `<h3>Waiting for data</h3><p class="os-card-note">${reasons.map(escapeHtml).join(" ")} These appear here automatically once it is saved.</p><ul class="os-chip-list">${waiting.map((card) => `<li>${escapeHtml(card.querySelector("h3").textContent.trim())}</li>`).join("")}</ul>`;
      waiting.forEach((card) => card.remove());
      gridEl.appendChild(summary);
    });
    const sectionsEl = document.getElementById("osSections");
    Array.from(sectionsEl.children)
      .filter((section) => !section.querySelector(".os-card:not(.is-empty)"))
      .forEach((section) => sectionsEl.appendChild(section));

    pendingCharts.forEach((entry) => { entry.chart = new Chart(entry.canvas, entry.config); });

    // Server-rendered lists (top students, support list, score entry).
    if (!isPdf) {
      page.classList.add("has-toggles");
      document.querySelectorAll(".os-collapsible").forEach((list) => {
        const total = list.querySelectorAll(".os-extra").length + Number(list.dataset.limit);
        if (!list.querySelector(".os-extra")) return;
        const card = list.closest(".os-card");
        let foot = card.querySelector(".os-card-foot");
        if (!foot) {
          foot = document.createElement("div");
          foot.className = "os-card-foot";
          card.appendChild(foot);
        }
        foot.insertAdjacentHTML("afterbegin", moreButton(total, list.dataset.noun));
        const button = foot.querySelector(".os-more-btn");
        button.addEventListener("click", () => {
          const expanded = !list.classList.contains("is-expanded");
          list.classList.toggle("is-expanded", expanded);
          setMoreLabel(button, expanded);
        });
      });
    }
    window.__orgStatsReady = true;

    // Class comparison (same term as the page).
    const compare = document.getElementById("osCompare");
    const toggle = document.getElementById("osCompareToggle");
    if (compare && toggle) {
      const termId = <%- JSON.stringify(currentTerm ? currentTerm.term_id : null) %>;
      const options = document.getElementById("osClassOptions");
      const message = document.getElementById("osCompareMessage");
      const button = document.getElementById("osCompareBtn");
      const result = document.getElementById("osCompareResult");
      let loaded = false;
      let chart = null;

      const showMessage = (text) => { message.textContent = text; message.hidden = !text; };

      toggle.addEventListener("click", async () => {
        const open = !compare.classList.contains("is-open");
        compare.classList.toggle("is-open", open);
        toggle.setAttribute("aria-expanded", open ? "true" : "false");
        if (!open || loaded) return;
        loaded = true;
        try {
          const response = await fetch(`/stats/classes/${encodeURIComponent(termId)}`, { credentials: "same-origin" });
          const classes = await response.json();
          if (!Array.isArray(classes) || !classes.length) {
            options.innerHTML = '<span class="os-card-note">No classes have students enrolled this term.</span>';
            button.disabled = true;
            return;
          }
          options.innerHTML = classes.map((c) => `<label class="os-class-option"><input type="checkbox" value="${c.class_id}" />${escapeHtml(c.class_name)}</label>`).join("");
        } catch (_) {
          loaded = false;
          options.innerHTML = '<span class="os-card-note">Classes could not be loaded. Please try again.</span>';
        }
      });

      button.addEventListener("click", async () => {
        const selectedClasses = Array.from(options.querySelectorAll("input:checked")).map((input) => Number(input.value));
        if (selectedClasses.length < 2) { showMessage("Select at least two classes to compare."); return; }
        showMessage("");
        button.disabled = true;
        try {
          const response = await fetch("/stats/class-comparison", {
            method: "POST",
            credentials: "same-origin",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ termId, selectedClasses }),
          });
          const rows = await response.json();
          if (!response.ok) throw new Error(rows.error || "Comparison failed.");
          result.hidden = false;
          result.querySelector("tbody").innerHTML = rows.map((r) => `<tr><td>${escapeHtml(r.class_name)}</td><td class="num">${r.enrolled}</td><td class="num">${pct(r.average_score)}</td><td class="num">${pct(r.pass_rate)}</td><td class="num">${pct(r.attendance_rate)}</td></tr>`).join("");
          const metrics = [["Average score", "average_score"], ["Pass rate", "pass_rate"], ["Attendance", "attendance_rate"]];
          if (chart) chart.destroy();
          chart = new Chart(document.getElementById("osCompareChart"), {
            type: "bar",
            data: {
              labels: rows.map((r) => r.class_name),
              datasets: metrics.map(([label, key], i) => ({ label, data: rows.map((r) => r[key]), backgroundColor: SLOTS[i], borderRadius: 4, maxBarThickness: 22 })),
            },
            options: {
              maintainAspectRatio: false,
              plugins: { legend: { position: "top", align: "start" }, tooltip: { callbacks: { label: (ctx) => ` ${ctx.dataset.label}: ${pct(ctx.parsed.y)}` } } },
              scales: { x: axis({ grid: { display: false } }), y: axis({ beginAtZero: true, suggestedMax: 100, ticks: { color: muted, callback: (v) => `${v}%` } }) },
            },
          });
        } catch (error) {
          showMessage(error.message || "Comparison failed.");
        } finally {
          button.disabled = false;
        }
      });
    }
  })();
</script>
