<%# One guide for visitors (admins keep the editor in legal&Compliance/userDocumentationArticle).
    locals: article, body (prepared HTML), toc, minutes, nav, searchIndexJson, docsIcon, lp. %>
<%- include('partials/head') %>
<main id="main" class="docs">
  <div class="docs-bar">
    <button type="button" data-docs-open aria-expanded="false" aria-controls="docs-side"><%- docsIcon('doc', 16) %> Browse docs</button>
    <span><%= article.topic %></span>
  </div>
  <%- include('partials/side', { currentSlug: article.slug, currentTopic: article.topic }) %>

  <article class="docs-main" aria-labelledby="docs-title">
    <nav class="docs-crumbs" aria-label="Breadcrumb">
      <a href="/legal/user-documentation">Docs</a><span aria-hidden="true">/</span><span><%= article.topic %></span>
    </nav>
    <h1 class="docs-title" id="docs-title"><%= article.title %></h1>
    <% if (article.seoDescription) { %><p class="docs-lead"><%= article.seoDescription %></p><% } %>
    <div class="docs-meta">
      <% if (article.updatedAt) { %><span><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>Updated <time datetime="<%= new Date(article.updatedAt).toISOString().slice(0, 10) %>"><%= new Date(article.updatedAt).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' }) %></time></span><% } %>
      <span><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg><%= minutes %> min read</span>
    </div>

    <div class="docs-content">
      <%- body %>
    </div>

    <div class="docs-helpful" data-docs-helpful data-article="<%= article.id %>">
      <p>Was this guide helpful?</p>
      <div class="docs-helpful__btns">
        <button type="button" data-vote="yes">Yes</button>
        <button type="button" data-vote="no">No</button>
      </div>
    </div>

  </article>

  <% if (toc.length > 1) { %>
    <nav class="docs-toc" data-docs-toc aria-label="On this page">
      <h2>On this page</h2>
      <ul>
        <% toc.forEach(function (item) { %><li><a href="#<%= item.id %>"><%= item.title %></a></li><% }) %>
      </ul>
      <a class="docs-toc__top" href="#main">Back to top &uarr;</a>
    </nav>
  <% } %>
</main>
<script type="application/json" id="docs-index"><%- searchIndexJson %></script>
<%- include('../home/partials/footer') %>
</body>
</html>
