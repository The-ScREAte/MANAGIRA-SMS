<!doctype html>
<%# The role report on its own, to print or as a PDF (controllers/dataMigrationController.js roleReportFile). %>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="noindex" />
  <title>Role report</title>
  <style>
    body { margin: 0; padding: 28px; background: #fff; color: #101828; font: 12px/1.45 -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Arial, sans-serif; }
    h1 { margin: 0 0 4px; font-size: 20px; }
    p { margin: 0 0 14px; color: #475467; }
    table { width: 100%; border-collapse: collapse; }
    th { padding: 6px 7px; border-bottom: 1.5px solid #101828; font-size: 10.5px; letter-spacing: .03em; text-align: left; text-transform: uppercase; }
    td { padding: 6px 7px; border-bottom: 1px solid #e4e7ec; vertical-align: top; }
    tr.flag td:first-child { box-shadow: inset 3px 0 0 #f59e0b; }
    .sign { display: flex; gap: 40px; margin-top: 34px; }
    .sign div { flex: 1; padding-top: 6px; border-top: 1px solid #101828; color: #475467; }
    @page { size: A4 landscape; margin: 12mm; }
  </style>
</head>
<body>
  <h1>Role report</h1>
  <p><%= school %> · moving to Managira · <%= new Date().toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' }) %><%= job.signed_name ? ' · signed by ' + job.signed_name : '' %></p>
  <table>
    <thead><tr><th>Name</th><th>Status</th><th>Old role</th><th>Managira role</th><th>Schools</th><th>Classes</th><th>Can do</th><th>Flags</th><th>Approved</th></tr></thead>
    <tbody>
      <% rows.forEach((r) => { %>
        <tr class="<%= r.Flags ? 'flag' : '' %>"><td><strong><%= r.Name %></strong><br /><%= r.Email %></td><td><%= r.Status %></td><td><%= r['Old role'] %></td><td><%= r['Managira role'] %></td><td><%= r.Schools %></td><td><%= r.Classes %></td><td><%= r['Can do'] %></td><td><%= r.Flags %></td><td><%= r.Approved %></td></tr>
      <% }) %>
    </tbody>
  </table>
  <div class="sign"><div>School admin's name</div><div>Signature</div><div>Date</div></div>
</body>
</html>
