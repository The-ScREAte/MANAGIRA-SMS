<%# Records from the school's old system that aren't on one student (controllers/dataMigrationController.js oldRecords):
    lists kept for the school, a summary of what's on students' records, and documents with no current student. Managers only. %>
<%
  const _kb = (b) => Number(b) >= 1048576 ? (Number(b) / 1048576).toFixed(1) + ' MB' : Math.max(1, Math.round(Number(b) / 1024)) + ' KB';
%>
<link rel="stylesheet" href="<%= assetUrl('/css/migration.css') %>" />
<div class="mg">
  <header class="mg-head">
    <div>
      <h1>Records from your old system</h1>
      <p>Everything your school brought from its old system that isn't one of Managira's own records stays here, read-only. Restricted items open only for your managers.</p>
    </div>
  </header>

  <div class="mg-tiles" style="margin-top:16px">
    <div><strong><%= schoolLists.length %></strong><span>lists kept for the school</span></div>
    <div><strong><%= studentLists.length %></strong><span>kinds of list on students' records</span></div>
    <div><strong><%= Number(docCounts.onStudents).toLocaleString('en-US') %></strong><span>documents on students' records</span></div>
    <div><strong><%= looseDocs.length %></strong><span>documents not on a current student</span></div>
  </div>

  <section class="mg-card" style="margin-top:16px">
    <h2>Kept for the school</h2>
    <% if (!schoolLists.length) { %><p class="mg-empty">Nothing yet: lists appear here once your migration goes live.</p><% } else { %>
    <div class="mg-scroll"><table class="mg-table"><thead><tr><th>List</th><th class="num">Rows</th><th></th></tr></thead><tbody>
      <% schoolLists.forEach((a) => { %><tr><td><strong><%= a.module %></strong><% if (a.sensitive) { %> <span class="mg-pill mg-pill--sensitive">Restricted</span><% } %></td><td class="num"><%= Number(a.n).toLocaleString('en-US') %></td>
        <td class="num"><a class="mg-btn mg-btn--sm" href="/common/migration/archive/<%= a.archive_id %>" target="_blank" rel="noopener" data-no-spa>Open</a> <a class="mg-btn mg-btn--sm" href="/common/migration/archive/<%= a.archive_id %>?format=csv" data-no-spa>CSV</a></td></tr><% }) %>
    </tbody></table></div>
    <% } %>
  </section>

  <% if (looseDocs.length) { %>
  <section class="mg-card" style="margin-top:16px">
    <h2>Documents not on a current student</h2>
    <p class="mg-hint">Graduates' and former students' documents, and files that weren't about one student.</p>
    <div class="mg-scroll"><table class="mg-table"><thead><tr><th>Student number</th><th>Document</th><th>File</th><th></th></tr></thead><tbody>
      <% looseDocs.forEach((d) => { %><tr><td><%= d.student_source_id || '—' %></td><td><strong><%= d.kind || d.file_name %></strong><% if (d.restricted) { %> <span class="mg-pill mg-pill--sensitive">Restricted</span><% } %></td>
        <td class="mg-samples"><%= d.file_name %> · <%= _kb(d.size_bytes) %></td><td class="num"><a class="mg-btn mg-btn--sm" href="/common/migration/documents/<%= d.document_id %>" target="_blank" rel="noopener" data-no-spa>Open</a></td></tr><% }) %>
    </tbody></table></div>
  </section>
  <% } %>

  <% if (studentLists.length) { %>
  <section class="mg-card" style="margin-top:16px">
    <h2>On students' records</h2>
    <p class="mg-hint">Open a student to see theirs, under "From your old system".</p>
    <div class="mg-scroll"><table class="mg-table"><thead><tr><th>List</th><th class="num">Students</th><th class="num">Rows</th></tr></thead><tbody>
      <% studentLists.forEach((a) => { %><tr><td><%= a.module %><% if (a.sensitive) { %> <span class="mg-pill mg-pill--sensitive">Restricted</span><% } %></td><td class="num"><%= Number(a.students).toLocaleString('en-US') %></td><td class="num"><%= Number(a.n).toLocaleString('en-US') %></td></tr><% }) %>
    </tbody></table></div>
  </section>
  <% } %>
</div>
