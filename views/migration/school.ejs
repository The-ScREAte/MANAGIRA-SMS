<%# Data migration, the school's side (controllers/dataMigrationController.js), inside Management. %>
<%
  const _stepLabels = { upload: 'Upload', map: 'Match columns', check: 'Check & import', roles: 'Staff roles', notes: 'Columns to explain', review: 'Review & sign', live: 'Go live' };
  const _when = (d) => d ? new Date(d).toLocaleString('en-US', { month: 'short', day: 'numeric', hour: 'numeric', minute: '2-digit' }) : '';
  const _report = (job.totals && job.totals.report) || null;
  const _status = { sandbox: 'Sandbox', review: 'Signed, ready to go live', live: 'Live', closed: 'Closed' }[job.status] || job.status;
  const _byEntity = {};
  columns.forEach((c) => { (_byEntity[c.entity] = _byEntity[c.entity] || []).push(c); });
  const _needNotes = columns.filter((c) => !c.action && (c.confidence === 'none' || (c.confirmed && !c.target)));
  const _approvalsLeft = columns.filter((c) => c.action === 'exclude' && !c.exclude_approved_at);
  const _issueLabel = { missing: 'Missing', duplicate: 'Duplicate', date: 'Bad date', orphan: 'No match', no_parent: 'No parent', unplaced: "Can't place", code: 'Unknown code', email: 'Email in use', no_email: 'No email', gpa: 'Not a GPA' };
  const _g = (v) => (v === null || v === undefined || !Number.isFinite(Number(v)) ? '—' : Number(v).toFixed(2));
  const _actionWords = { map: 'Mapped', custom: 'Custom field', extra: 'Extra field', archive: 'Archived', exclude: 'Left out', alert: 'Alert on the student' };
  // Nothing uploaded yet: every step after Upload says so, and nothing looks done.
  const _blank = !locals.anyFiles && job.status === 'sandbox';
%>
<link rel="stylesheet" href="<%= assetUrl('/css/migration.css') %>" />
<div class="mg">
  <%- include('../partials/flash') %>
  <header class="mg-head">
    <div>
      <h1>Data migration <span class="mg-pill mg-pill--<%= job.status %>"><%= _status %></span></h1>
      <p>Move your data from PowerSchool. Nothing reaches your live account until you sign off and go live.</p>
    </div>
  </header>

  <% if (job.rolled_back_at && job.status === 'sandbox') { %>
    <p class="mg-notice">Managira rolled back your go-live on <%= _when(job.rolled_back_at) %>: everything it loaded was removed and the sandbox is open again. Check, sign and go live again when you're ready.</p>
  <% } %>
  <nav class="mg-steps" aria-label="Steps">
    <% steps.forEach((s, i) => { %>
      <a class="mg-step<%= s === step ? ' is-on' : '' %><%= _blank && s !== 'upload' ? ' is-idle' : '' %>" href="/common/migration?step=<%= s %>&embed=workspace"<%- s === step ? ' aria-current="step"' : '' %>><span><%= i + 1 %></span><%= _stepLabels[s] %></a>
    <% }) %>
  </nav>
  <%- include('partials/task', { task: locals.task }) %>

  <% if (_blank && step !== 'upload') { const _reading = locals.task && task.open; %>
  <section class="mg-card mg-blank">
    <h2><%= _stepLabels[step] %></h2>
    <p><%= _reading ? "Your files are being read. This step fills in as soon as that's done." : 'Nothing here yet. Everything starts with your export files.' %></p>
    <% if (!_reading) { %><p class="mg-next"><a class="mg-btn mg-btn--primary" href="/common/migration?step=upload&embed=workspace">Go to step 1: Upload</a></p><% } %>
  </section>
  <% } %>

  <% if (step === 'upload') { %>
  <section class="mg-card">
    <h2>Upload your export files</h2>
    <p class="mg-hint">Export each list from PowerSchool: students, parents and contacts, staff, sections (with their grade level), class enrollments (CC), stored grades, and attendance (a row per day, or totals per term). Upload them as they are: CSV, tab-separated text, Excel (.xlsx) or a .zip of them. Documents come too: PDFs, photos, scans and Word files, in the .zip beside your lists (a folder per student, named by their student number, matches each to its student; a student's photo becomes their picture) or on their own (with the student number in the file name). Each sheet of a workbook and each file in a .zip is read as a list of its own; a list can have up to 200,000 rows, and a longer one (a year of daily attendance, say) can be sent in parts together in one .zip. Uploading a list again replaces it, and the import can always run again.</p>
    <%- include('partials/upload', { label: 'Drop your export files here', action: '/common/migration/upload', withEntity: true }) %>
  </section>
  <%- include('partials/uploads', { uploads: locals.uploads || [], task: locals.task }) %>
  <% if (files.length) { const _core = files.filter((f) => f.entity !== 'other'); const _keptFiles = files.filter((f) => f.entity === 'other'); const _short = (n) => String(n).split('›').pop().trim(); %>
  <section class="mg-card" style="margin-top:14px">
    <h2>What Managira has from them</h2>
    <div class="mg-tiles">
      <div><strong><%= _core.length %></strong><span>lists go into Managira</span></div>
      <div><strong><%= _keptFiles.length %></strong><span>other lists kept read-only</span></div>
      <div><strong><%= docs ? Number(docs.total).toLocaleString('en-US') : 0 %></strong><span>documents<%= docs && docs.total ? ' (' + Number(docs.matched).toLocaleString('en-US') + ' matched to a student)' : '' %></span></div>
    </div>
    <details class="mg-more" open><summary>Lists that go into Managira (<%= _core.length %>)</summary>
      <div class="mg-scroll"><table class="mg-table"><thead><tr><th>List</th><th>Goes into</th><th class="num">Rows</th><th>Uploaded</th></tr></thead><tbody>
        <% _core.forEach((f) => { %><tr><td><strong><%= _short(f.file_name) %></strong></td><td><%= entities[f.entity].label %></td><td class="num"><%= Number(f.row_count).toLocaleString('en-US') %></td><td class="mg-samples"><%= _when(f.uploaded_at) %></td></tr><% }) %>
      </tbody></table></div>
    </details>
    <% if (_keptFiles.length) { %>
    <details class="mg-more"><summary>Other lists, kept read-only (<%= _keptFiles.length %>)</summary>
      <div class="mg-scroll"><table class="mg-table"><thead><tr><th>List</th><th class="num">Rows</th></tr></thead><tbody>
        <% _keptFiles.forEach((f) => { %><tr><td><%= _short(f.file_name) %></td><td class="num"><%= Number(f.row_count).toLocaleString('en-US') %></td></tr><% }) %>
      </tbody></table></div>
      <p class="mg-hint">Import to see where each goes: on each student's record, as details, or for the school. Restricted ones open only for your managers.</p>
    </details>
    <% } %>
    <p class="mg-next"><a class="mg-btn mg-btn--primary" href="/common/migration?step=map&embed=workspace">Next: match columns</a></p>
  </section>
  <% } %>
  <% } %>

  <% if (step === 'map' && !_blank) { %>
  <% if (fieldChoices.length) { const _typeWords = { text: 'Text', long_text: 'Long text', number: 'Number', date: 'Date', yes_no: 'Yes / No' }; %>
  <section class="mg-card" id="fields" style="margin-bottom:14px">
    <h2>Student fields</h2>
    <p class="mg-hint">Columns about each student that Managira has no built-in place for. <strong>Ticked</strong>: one of your school's own student fields, made when you go live and filled with each student's value, in the part of the student form you choose; tick <strong>Admission form</strong> to have families answer it when they apply too. You can change any of it later in Admission Settings › Student fields. <strong>Not ticked</strong>: kept as a read-only detail (codes like a locker combination stay that way). IEP, 504 and the other indicators live in Programs &amp; Indicators, staff only.</p>
    <form method="POST" action="/common/migration/custom-fields">
      <div class="mg-scroll"><table class="mg-table mg-fields no-global-sort"><thead><tr><th class="mg-tickcol">Field</th><th>Their column</th><th>Sample values</th><th>In Managira</th><th>Lives in</th></tr></thead><tbody>
        <% fieldChoices.forEach((c) => { const own = c.action === 'map'; const on = own || c.action === 'custom'; const _home = suggestHome(c.label || c.source_column); const _sec = c.field_section || _home.section; const _app = c.field_on_application === null || c.field_on_application === undefined ? _home.onApplication : c.field_on_application; %>
        <tr class="<%= on ? 'is-on' : '' %>">
          <td class="mg-tickcol"><label class="mg-box"><input type="checkbox" name="columns" value="<%= c.column_id %>"<%= on ? ' checked' : '' %><%= own ? ' disabled' : '' %> aria-label="Make <%= c.source_column %> a custom field" /><span aria-hidden="true"></span></label></td>
          <td><strong><%= c.source_column %></strong><small class="mg-samples" style="display:block"><%= entities[c.entity].label %></small></td>
          <td class="mg-samples"><%= (c.samples || []).slice(0, 3).join(' · ') %></td>
          <td><% if (own) { %><span class="mg-pill mg-pill--live">Already in Managira</span> <%= targetLabel(c.entity, c.target) %><% } else if (c.action === 'custom' && (locals.indicatorLabels || []).includes(c.label)) { %>Programs &amp; Indicators: <strong><%= c.label %></strong> <small class="mg-samples">staff only</small><% } else if (c.action === 'custom') { %>New custom field <strong><%= c.label %></strong> <small class="mg-samples"><%= _typeWords[fieldTypeOf(c.samples || [])] %></small><% } else { %>Read-only detail<% } %><% if (c.sensitive) { %> <span class="mg-pill mg-pill--sensitive"><%= sensitiveLabels[c.sensitive] || 'Restricted' %></span><% } %></td>
          <td class="mg-home"><% if (!own) { %>
            <select name="section_<%= c.column_id %>" aria-label="Where <%= c.source_column %> lives"<%= _sec === 'programs' ? ' data-programs' : '' %>><% Object.entries(fieldHomes).forEach(([key, name]) => { %><option value="<%= key %>"<%= key === _sec ? ' selected' : '' %>><%= name %></option><% }) %></select>
            <% if (_sec !== 'programs') { %><label class="mg-app-tick"><input type="checkbox" name="app_<%= c.column_id %>" value="1"<%= _app ? ' checked' : '' %> /> Admission form</label><% } %>
          <% } else { %><span class="mg-samples">Already on the form</span><% } %></td>
        </tr>
        <% }) %>
      </tbody></table></div>
      <div class="mg-actions" style="margin-top:12px"><button class="mg-btn mg-btn--primary">Save</button><small class="mg-hint">Ticking or unticking a field imports again in the background; where it lives is kept as you chose.</small></div>
    </form>
  </section>
  <% } %>
  <section class="mg-card">
    <h2>Match columns</h2>
    <p class="mg-hint">Each column was matched to a Managira field. <b class="mg-ok">Confident</b> matches are ready. Confirm or correct the <b class="mg-warn">unsure</b> ones. Columns we can't match go to step 4.</p>
    <% if (!columns.length) { %><p class="mg-empty">Upload your files first.</p><% } %>
    <% Object.entries(_byEntity).forEach(([entity, list]) => { const fields = entities[entity].fields; %>
      <h3><%= entities[entity].label %></h3>
      <table class="mg-table mg-map"><thead><tr><th>Their column</th><th>Sample values</th><th>Match</th><th>Goes to</th></tr></thead><tbody>
      <% list.forEach((c) => { const state = c.sensitive === 'custody' ? 'alert' : c.action === 'map' && c.target ? (c.confirmed && c.confidence !== 'confident' ? 'confirmed' : 'confident') : c.confidence === 'unsure' && !c.confirmed ? 'unsure' : 'none'; %>
        <tr class="mg-row--<%= state %>">
          <td><strong><%= c.source_column %></strong><% if (c.sensitive) { %><span class="mg-pill mg-pill--sensitive"><%= sensitiveLabels[c.sensitive] %></span><% } %></td>
          <td class="mg-samples"><%= (c.samples || []).slice(0, 3).join(' · ') || '—' %></td>
          <td><%= { confident: 'Confident', confirmed: 'Confirmed', unsure: 'Unsure', none: "Can't map", alert: 'Alert' }[state] %></td>
          <td>
            <% if (c.sensitive === 'custody') { %>An alert on the student record
            <% } else if (c.action && c.action !== 'map') { %><%= _actionWords[c.action] %><%= c.label ? ': ' + c.label : '' %>
            <% } else { %>
            <form class="mg-inline" method="POST" action="/common/migration/columns/<%= c.column_id %>/confirm">
              <select name="target" aria-label="Where <%= c.source_column %> goes">
                <option value="none"<%= !c.target ? ' selected' : '' %>>Can't map</option>
                <% Object.entries(fields).forEach(([key, f]) => { %><option value="<%= key %>"<%= c.target === key ? ' selected' : '' %>><%= f[0].replace(' *', '') %></option><% }) %>
                <% if (entity === 'students') custom.forEach((f) => { %><option value="custom:<%= f.field_id %>"<%= c.target === 'custom:' + f.field_id ? ' selected' : '' %>><%= f.label %> (your field)</option><% }) %>
              </select>
              <button class="mg-btn mg-btn--sm<%= state === 'unsure' ? ' mg-btn--primary' : '' %>" type="submit"><%= state === 'unsure' ? 'Confirm' : 'Save' %></button>
            </form>
            <% } %>
          </td>
        </tr>
      <% }) %>
      </tbody></table>
    <% }) %>
    <% if (columns.length) { %><p class="mg-next"><a class="mg-btn" href="/common/migration?step=check&embed=workspace">Next: check & import</a></p><% } %>
  </section>
  <% } %>

  <% if (step === 'check' && !_blank) { %>
  <section class="mg-card">
    <h2>Check & import into the sandbox</h2>
    <p class="mg-hint">Imports everything that's matched now, and checks it. Run it again any time: records update, never duplicate.</p>
    <form method="POST" action="/common/migration/import" data-starts-task><button class="mg-btn mg-btn--primary" type="submit"<%= files.length && !(task && task.open) ? '' : ' disabled' %>>Import into the sandbox</button></form>
    <% if (_report) { %>
      <h3>Records</h3>
      <table class="mg-table"><thead><tr><th>Area</th><th class="num">In your files</th><th class="num">In the sandbox</th><th class="num">With something to check</th></tr></thead><tbody>
      <% Object.entries(_report.entities).filter(([, v]) => v.source || v.staged).forEach(([entity, v]) => { const s = sandbox.counts[entity] || {}; %>
        <tr><td><%= entities[entity].label %></td><td class="num"><%= v.source %></td><td class="num"><%= s.count || 0 %></td><td class="num"><%= s.withIssues || 0 %></td></tr>
      <% }) %>
      </tbody></table>
      <% if ((_report.lists || []).length || (docs && docs.total)) { const _kept = _report.lists || []; %>
      <h3>Your lists and documents</h3>
      <p class="mg-hint"><strong><%= files.filter((f) => f.entity !== 'other').length %></strong> lists go into Managira (above). <strong><%= _kept.length %></strong> other <%= _kept.length === 1 ? 'list is' : 'lists are' %> kept read-only, nothing left behind: on each student's record where the list has a student number, or for the school<% if (docs && docs.total) { %>, and <strong><%= Number(docs.total).toLocaleString('en-US') %></strong> documents (<%= Number(docs.matched).toLocaleString('en-US') %> matched to <%= docs.students %> students)<% } %>. Restricted ones open only for your school's managers.</p>
      <% const _into = _kept.filter((l) => l.feature && listFeatures[l.feature]); %>
      <% if (_into.length) { %>
      <h3>Loaded into Managira's own features</h3>
      <p class="mg-hint">These <%= _into.length %> lists also go into the parts of Managira that do the same job, when you go live. They're kept read-only as well, so nothing is lost.</p>
      <div class="mg-scroll"><table class="mg-table no-global-sort"><thead><tr><th>List</th><th class="num">Rows</th><th>Goes into</th></tr></thead><tbody>
        <% _into.forEach((l) => { %><tr><td><strong><%= l.label %></strong></td><td class="num"><%= Number(l.rows).toLocaleString('en-US') %></td><td><%= listFeatures[l.feature].into %></td></tr><% }) %>
      </tbody></table></div>
      <% if (_into.some((l) => l.feature === 'meal_balances')) { const _meals = ((job.options || {}).mealBalances) || 'keep'; %>
      <form class="mg-choice" method="POST" action="/common/migration/options">
        <input type="hidden" name="key" value="mealBalances" />
        <strong>Meal balances</strong>
        <label><input type="radio" name="value" value="keep"<%= _meals === 'keep' ? ' checked' : '' %> /> Stay in your meal app <small>(keep using it for the lunch line; connect it to Managira below)</small></label>
        <label><input type="radio" name="value" value="paygira"<%= _meals === 'paygira' ? ' checked' : '' %> /> Move into PayGira <small>(amounts owed become bills, money in credit becomes each student's PayGira credit)</small></label>
        <button class="mg-btn mg-btn--sm" type="submit">Save</button>
      </form>
      <% } %>
      <% } %>
      <% if (_kept.length) { %>
      <details class="mg-more"><summary>Every list kept read-only (<%= _kept.length %>)</summary>
        <div class="mg-scroll"><table class="mg-table"><thead><tr><th>List</th><th class="num">Rows</th><th>Kept</th><th>Also goes into</th><th>Who sees it</th></tr></thead><tbody>
          <% _kept.forEach((l) => { %><tr><td><strong><%= l.label %></strong></td><td class="num"><%= Number(l.rows).toLocaleString('en-US') %></td>
            <td><%= l.details ? 'As details on each student' : l.perStudent ? 'On each student (' + Number(l.students).toLocaleString('en-US') + ' rows matched)' : 'For the school' %></td>
            <td><%= l.feature && listFeatures[l.feature] ? listFeatures[l.feature].label : '—' %></td>
            <td><% if (l.restricted) { %><span class="mg-pill mg-pill--sensitive">Restricted</span><% } else { %>Staff who open students<% } %></td></tr><% }) %>
        </tbody></table></div>
      </details>
      <% } %>
      <% if (docs && docs.total) { %>
      <details class="mg-more"><summary>Documents (<%= Number(docs.total).toLocaleString('en-US') %>, <%= (Number(docs.bytes) / 1048576).toFixed(1) %> MB)</summary>
        <div class="mg-scroll"><table class="mg-table"><thead><tr><th>Student</th><th>Document</th><th>File</th><th></th></tr></thead><tbody>
          <% docs.list.forEach((d) => { %><tr><td><%= d.student_source_id ? (d.student_name || '') + ' · ' + d.student_source_id : '—' %></td><td><strong><%= d.kind %></strong><% if (d.restricted) { %> <span class="mg-pill mg-pill--sensitive">Restricted</span><% } %></td>
            <td class="mg-samples"><%= d.file_name %> · <%= Math.max(1, Math.round(Number(d.size_bytes) / 1024)) %> KB</td><td><a class="mg-btn mg-btn--sm" href="/common/migration/documents/<%= d.document_id %>" target="_blank" rel="noopener" data-no-spa>Open</a></td></tr><% }) %>
        </tbody></table></div>
        <% if (docs.total > docs.list.length) { %><p class="mg-hint">The first <%= docs.list.length %> of <%= Number(docs.total).toLocaleString('en-US') %>.</p><% } %>
        <% if (docs.total - docs.matched > 0) { %><p class="mg-hint"><%= docs.total - docs.matched %> <%= docs.total - docs.matched === 1 ? "document isn't" : "documents aren't" %> matched to a student yet: they're kept for the school. Import again after uploading the students list, or name each student's folder by their student number.</p><% } %>
      </details>
      <% } %>
      <% } %>
      <%- include('partials/apps', { apps }) %>
      <% if (_report.tidied) { %><p class="mg-hint"><strong><%= _report.tidied %></strong> <%= _report.tidied === 1 ? 'value was' : 'values were' %> tidied as they came in: names typed in capitals, phone numbers to (555) 123-4567, emails in lower case, M and F to Male and Female.</p><% } %>
      <h3>Check report</h3>
      <% if (!_report.examples.length) { %><p class="mg-good">No problems found.</p><% } else { %>
      <p class="mg-hint"><b class="mg-bad">Red</b> must be fixed in your export before going live; upload it again and import. <b class="mg-warn">Amber</b> is worth a look.</p>
      <table class="mg-table"><thead><tr><th>Area</th><th>Problem</th><th>Line</th><th>ID</th><th>Detail</th></tr></thead><tbody>
        <% _report.examples.forEach((e) => { %><tr class="<%= e.blocking ? 'mg-row--bad' : 'mg-row--unsure' %>"><td><%= entities[e.entity].label %></td><td><%= _issueLabel[e.key.split(':')[1]] || e.key %> (<%= _report.issues[e.key] %>)</td><td><%= e.line %></td><td><%= e.sourceId %></td><td><%= e.text %></td></tr><% }) %>
      </tbody></table>
      <% } %>
      <% if (sandbox.sample.length) { %>
      <details class="mg-more"><summary>See what's in the sandbox</summary>
        <% Object.keys(sandbox.counts).forEach((entity) => { const rows = sandbox.sample.filter((r) => r.entity === entity); if (!rows.length) return; const keys = [...new Set(rows.flatMap((r) => Object.keys(r.data).filter((k) => typeof r.data[k] !== 'object')))].slice(0, 7); %>
          <h3><%= entities[entity].label %> <small>first <%= rows.length %> of <%= sandbox.counts[entity].count %></small></h3>
          <div class="mg-scroll"><table class="mg-table"><thead><tr><% keys.forEach((k) => { %><th><%= targetLabel(entity, k) %></th><% }) %></tr></thead><tbody>
            <% rows.forEach((r) => { %><tr><% keys.forEach((k) => { %><td><%= r.data[k] || '' %></td><% }) %></tr><% }) %>
          </tbody></table></div>
        <% }) %>
      </details>
      <% } %>
    <% } %>
  </section>
  <% } %>

  <% if (step === 'roles' && !_blank) { const _R = roleReport; %>
  <section class="mg-card">
    <h2>Staff roles</h2>
    <p class="mg-hint">Each role or access group in your staff file, matched to a Managira role. A match never gives more access than the old role did: when unsure, it's the more limited one, and you can always choose a more limited role. Admin-level access needs your approval, person by person.</p>
    <% if (locals.ownRolesOn !== false) { %><p class="mg-hint">Need a role Managira doesn't have, like Food Service? Make it in Users › Add user › Role › <strong>Add a role</strong>, and it's offered here.</p><% } %>
    <% if (!_R.roles.length && !_R.people.length) { %><p class="mg-empty">Upload your staff file and run the import (step 3) to see your roles here.</p><% } %>
    <% if (_R.roles.length) { %>
    <div class="mg-scroll"><table class="mg-table mg-map"><thead><tr><th>Old role</th><th class="num">Staff</th><th>Match</th><th>Managira role</th><th>Access</th></tr></thead><tbody>
      <% _R.roles.forEach((r) => { %>
        <tr class="mg-row--<%= r.state === 'waiting' ? 'none' : r.state === 'unsure' ? 'unsure' : 'confident' %>">
          <td><strong><%= r.old_role %></strong><% if (r.level) { %><small class="mg-samples" style="display:block"><%= roleLevels[r.level].label %></small><% } %></td>
          <td class="num"><%= r.staff_count %></td>
          <td><%= r.state === 'waiting' ? "Can't map" : r.state === 'unsure' ? 'Unsure' : r.resolved_by ? 'Matched by Managira' : r.confirmed ? 'Confirmed' : 'Confident' %></td>
          <td>
            <% if (r.state === 'waiting') { %><%= r.notes ? 'With the Managira team' : 'Explain it below' %>
              <% if (ownRoles.length) { %>
              <form class="mg-inline" method="POST" action="/common/migration/roles/<%= r.role_id %>/confirm" style="margin-top:6px">
                <select name="target" aria-label="One of your school's roles for <%= r.old_role %>">
                  <option value="">Or use one of your roles…</option>
                  <% ownRoles.forEach((o) => { %><option value="school:<%= o.role_id %>"><%= o.name %> (<%= o.base_type %>)</option><% }) %>
                </select>
                <button class="mg-btn mg-btn--sm" type="submit">Use</button>
              </form>
              <% } %>
            <% } else { %>
              <form class="mg-inline" method="POST" action="/common/migration/roles/<%= r.role_id %>/confirm">
                <select name="target" aria-label="Managira role for <%= r.old_role %>">
                  <% if (r.target === 'custom' && !r.school_role_id) { %><option value="custom" selected><%= r.label %> (custom)</option><% } %>
                  <% Object.entries(roleChoices).forEach(([key, c]) => { %><option value="<%= key %>"<%= r.target === key ? ' selected' : '' %>><%= c.label %></option><% }) %>
                  <% const _ownHere = ownRoles.some((o) => r.target === 'custom' && Number(r.school_role_id) === o.role_id); %>
                  <% if (ownRoles.length || (r.target === 'custom' && r.school_role_id && !_ownHere)) { %><optgroup label="Your school's roles">
                    <% if (r.target === 'custom' && r.school_role_id && !_ownHere) { %><option value="custom" selected><%= r.label %></option><% } %>
                    <% ownRoles.forEach((o) => { %><option value="school:<%= o.role_id %>"<%= r.target === 'custom' && Number(r.school_role_id) === o.role_id ? ' selected' : '' %>><%= o.name %> (<%= o.base_type %>)</option><% }) %>
                  </optgroup><% } %>
                </select>
                <button class="mg-btn mg-btn--sm<%= r.state === 'unsure' ? ' mg-btn--primary' : '' %>" type="submit"><%= r.state === 'unsure' ? 'Confirm' : 'Save' %></button>
              </form>
              <small class="mg-samples"><%= r.choice ? r.choice.about : '' %></small>
            <% } %>
          </td>
          <td><% if (r.state === 'waiting') { %>—<% } else if (r.up.length) { %><span class="mg-warn">More than before: <%= r.up.join(', ') %></span><% } else { %><span class="mg-ok">Not more than before</span><% } %><% if (r.adminLevel) { %> <span class="mg-pill mg-pill--sensitive">Admin-level</span><% } %></td>
        </tr>
      <% }) %>
    </tbody></table></div>
    <% } %>
    <% _R.roles.filter((r) => r.state === 'waiting').forEach((r) => { const n = r.notes || {}; %>
      <article class="mg-col">
        <header><strong><%= r.old_role %></strong> <small><%= r.staff_count %> <%= r.staff_count === 1 ? 'person' : 'people' %></small><span class="mg-pill"><%= r.notes ? 'With Managira' : 'Needs your notes' %></span></header>
        <form class="mg-notes" method="POST" action="/common/migration/roles/<%= r.role_id %>/notes">
          <label>What does it let people do? *<input name="what" required maxlength="1000" value="<%= n.what || '' %>" /></label>
          <label>Who has it?<input name="who" maxlength="1000" value="<%= n.who || '' %>" /></label>
          <button class="mg-btn mg-btn--primary mg-btn--sm" type="submit"><%= r.notes ? 'Update notes' : 'Send notes' %></button>
        </form>
      </article>
    <% }) %>

    <% if (_R.people.length) { %>
      <h3>Role report</h3>
      <p class="mg-hint">Everyone in your staff file: old role, Managira role, schools, classes and what they can do. Approve each person flagged in amber, then approve the role report in Review & sign.</p>
      <div class="mg-actions" style="margin-bottom:8px">
        <a class="mg-btn mg-btn--sm" href="/common/migration/roles/report?format=csv" data-no-spa>Download CSV</a>
        <a class="mg-btn mg-btn--sm" href="/common/migration/roles/report?format=pdf" data-no-spa>Download PDF</a>
      </div>
      <div class="mg-scroll"><table class="mg-table"><thead><tr><th>Name</th><th>Old role</th><th>Managira role</th><th>Schools</th><th>Classes</th><th>Can do</th><th></th></tr></thead><tbody>
        <% _R.people.forEach((p) => { %>
          <tr class="<%= p.noRole ? 'mg-row--bad' : p.needsApproval && !p.approved ? 'mg-row--unsure' : '' %>">
            <td><strong><%= p.name %></strong><small class="mg-samples" style="display:block"><%= p.email || 'No email' %><%= p.active ? '' : ' · inactive' %></small></td>
            <td><%= p.oldRole || '—' %></td>
            <td><%= !p.active ? 'History only (inactive)' : p.existing ? 'Already in Managira' : p.noAccount ? 'No account: ' + p.noAccount : p.newRole || 'No role' %><% if (p.adminLevel) { %> <span class="mg-pill mg-pill--sensitive">Admin-level</span><% } %></td>
            <td><%= p.schools.join(', ') || '—' %></td>
            <td><%= p.classes.map((c) => c.name + ' (' + c.as.toLowerCase() + (c.now ? '' : ', past') + ')').join('; ') || '—' %></td>
            <td><%= p.can %><% if (p.up.length) { %><br><span class="mg-warn">More than before: <%= p.up.join(', ') %></span><% } %></td>
            <td class="num">
              <% if (p.needsApproval) { %>
                <form method="POST" action="/common/migration/roles/approve"><input type="hidden" name="sourceId" value="<%= p.sourceId %>" /><input type="hidden" name="on" value="<%= p.approved ? '0' : '1' %>" />
                  <button class="mg-btn mg-btn--sm<%= p.approved ? '' : ' mg-btn--primary' %>" type="submit"><%= p.approved ? 'Approved ✓' : 'Approve' %></button></form>
              <% } %>
            </td>
          </tr>
        <% }) %>
      </tbody></table></div>
    <% } %>
  </section>
  <% } %>

  <% if (step === 'notes' && !_blank) { %>
  <section class="mg-card">
    <h2>Columns to explain</h2>
    <p class="mg-hint">These columns have no place in Managira yet. Tell us about each one. The Managira team then makes it a field of its own, keeps it on the record, or archives it. Nothing is left out without your approval.</p>
    <% if (!_needNotes.length && !_approvalsLeft.length) { %><p class="mg-good">Nothing to explain.</p><% } %>
    <% _needNotes.forEach((c) => { const n = c.notes || {}; %>
      <article class="mg-col" id="col-<%= c.column_id %>">
        <header><strong><%= c.source_column %></strong> <small><%= entities[c.entity].label %></small><% if (c.sensitive) { %><span class="mg-pill mg-pill--sensitive"><%= sensitiveLabels[c.sensitive] %></span><% } %><span class="mg-pill"><%= c.notes ? 'With Managira' : 'Needs your notes' %></span></header>
        <p class="mg-samples">Sample values: <%= (c.samples || []).join(' · ') || '(empty)' %></p>
        <form class="mg-notes" method="POST" action="/common/migration/columns/<%= c.column_id %>/notes">
          <label>What is it? *<input name="what" required maxlength="1000" value="<%= n.what || '' %>" /></label>
          <label>Who uses it?<input name="who" maxlength="1000" value="<%= n.who || '' %>" /></label>
          <label>How often?<input name="often" maxlength="1000" value="<%= n.often || '' %>" /></label>
          <label>Is it required?<select name="required"><option value="">Choose…</option><% ['Yes', 'No', 'Sometimes'].forEach((o) => { %><option<%= n.required === o ? ' selected' : '' %>><%= o %></option><% }) %></select></label>
          <label class="mg-wide">Rules at your school<textarea name="rules" maxlength="1000" rows="2"><%= n.rules || '' %></textarea></label>
          <button class="mg-btn mg-btn--primary mg-btn--sm" type="submit"><%= c.notes ? 'Update notes' : 'Send notes' %></button>
        </form>
      </article>
    <% }) %>
    <% _approvalsLeft.forEach((c) => { %>
      <article class="mg-col mg-col--approve">
        <header><strong><%= c.source_column %></strong> <small><%= entities[c.entity].label %></small><% if (c.sensitive) { %><span class="mg-pill mg-pill--sensitive"><%= sensitiveLabels[c.sensitive] %></span><% } %></header>
        <p><%= c.sensitive === 'ssn' ? 'Social Security numbers are left out unless you have a legal need to keep them.' : 'The Managira team suggests leaving this column out.' %> Sample: <%= (c.samples || []).slice(0, 2).map((v) => c.sensitive === 'ssn' ? '•••-••-' + String(v).slice(-4) : v).join(' · ') %></p>
        <div class="mg-actions">
          <form method="POST" action="/common/migration/columns/<%= c.column_id %>/exclude"><button class="mg-btn mg-btn--primary mg-btn--sm" type="submit">Approve leaving it out</button></form>
          <% if (c.sensitive === 'ssn') { %><form method="POST" action="/common/migration/columns/<%= c.column_id %>/legal-need"><button class="mg-btn mg-btn--sm" type="submit">We have a legal need to keep it</button></form><% } %>
        </div>
      </article>
    <% }) %>
    <% const _resolved = columns.filter((c) => c.action && c.action !== 'map' || (c.action === 'map' && c.resolved_by && c.target && c.target.startsWith('custom:'))); %>
    <% if (_resolved.length) { %>
      <h3>Already decided</h3>
      <table class="mg-table"><tbody><% _resolved.forEach((c) => { %><tr><td><strong><%= c.source_column %></strong></td><td><%= c.action === 'map' ? 'Custom field: ' + (c.label || '') : _actionWords[c.action] + (c.label ? ': ' + c.label : '') %><%= c.action === 'exclude' ? (c.exclude_approved_at ? ' (you approved)' : ' (waiting for your approval)') : '' %></td></tr><% }) %></tbody></table>
    <% } %>
  </section>
  <% } %>

  <% if (step === 'review' && !_blank) { %>
  <section class="mg-card">
    <h2>Review & sign</h2>
    <% if (matches) { const _fmtDay = (d) => d ? new Date(d + 'T12:00:00Z').toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric', timeZone: 'UTC' }) : 'no date of birth'; const _canAnswer = ['sandbox', 'live'].includes(job.status); %>
    <div id="matches" class="mg-matches">
      <h3>Already in Managira</h3>
      <p class="mg-hint">Nothing already in Managira is replaced. <strong><%= matches.matched.length %></strong> of your students <%= matches.matched.length === 1 ? 'is' : 'are' %> already here (by student number, or by name and date of birth): they keep everything they have, and only empty fields are filled in. <strong><%= matches.fresh %></strong> <%= matches.fresh === 1 ? 'is' : 'are' %> new.<% if (matches.guardians || matches.staff) { %> <%= matches.guardians %> <%= matches.guardians === 1 ? 'parent' : 'parents' %> and <%= matches.staff %> staff <%= matches.staff === 1 ? 'member' : 'members' %> already have a Managira record with the same email: they're kept too, and staff keep their access.<% } %></p>
      <% if (matches.questions.length) { %>
        <div class="<%= matches.waiting ? 'mg-blockers' : 'mg-good' %>"><%= matches.waiting ? 'Say whether each of these is the same student. Until you do, you can’t sign.' : 'Every question is answered.' %></div>
        <div class="mg-scroll"><table class="mg-table mg-questions no-global-sort"><thead><tr><th>In your files</th><th>Could be</th><th>Your answer</th></tr></thead><tbody>
          <% matches.questions.forEach((q) => { %>
          <tr class="<%= q.answer ? '' : 'mg-row--unsure' %>">
            <td><strong><%= q.name %></strong><small class="mg-samples" style="display:block"><%= q.sourceId %> · <%= _fmtDay(q.dob) %></small></td>
            <td>
              <% if (q.kind === 'file') { %>
                <%= q.otherName %> <small class="mg-samples"><%= q.other %></small><small class="mg-samples" style="display:block">Same name and date of birth, twice in your files</small>
              <% } else { q.candidates.forEach((c) => { %>
                <div class="mg-candidate"><span><%= c.name %> <small class="mg-samples"><%= _fmtDay(c.dob) %><%= c.className ? ' · ' + c.className : '' %><%= c.number ? ' · No. ' + c.number : '' %></small></span>
                  <% if (_canAnswer && !q.answer) { %><form method="POST" action="/common/migration/matches"><input type="hidden" name="key" value="<%= q.key %>" /><input type="hidden" name="choice" value="same" /><input type="hidden" name="id" value="<%= c.id %>" /><button class="mg-btn mg-btn--sm">Same student</button></form><% } %>
                </div>
              <% }) } %>
            </td>
            <td>
              <% if (q.answer) { %>
                <strong><%= q.answer.different ? (q.kind === 'file' ? 'Different students' : 'A new student') : q.kind === 'file' ? 'The same student: loaded once' : 'The same student: kept, empty fields filled in' %></strong>
                <small class="mg-samples" style="display:block"><%= q.answer.by %></small>
                <% if (_canAnswer) { %><form method="POST" action="/common/migration/matches"><input type="hidden" name="key" value="<%= q.key %>" /><input type="hidden" name="choice" value="undo" /><button class="mg-btn mg-btn--sm mg-btn--quiet">Change</button></form><% } %>
              <% } else if (_canAnswer) { %>
                <div class="mg-actions">
                  <% if (q.kind === 'file') { %><form method="POST" action="/common/migration/matches"><input type="hidden" name="key" value="<%= q.key %>" /><input type="hidden" name="choice" value="same" /><button class="mg-btn mg-btn--sm">Same student</button></form><% } %>
                  <form method="POST" action="/common/migration/matches"><input type="hidden" name="key" value="<%= q.key %>" /><input type="hidden" name="choice" value="different" /><button class="mg-btn mg-btn--sm"><%= q.kind === 'file' ? 'Different students' : 'A different student' %></button></form>
                </div>
              <% } %>
            </td>
          </tr>
          <% }) %>
        </tbody></table></div>
      <% } %>
      <% const _changes = matches.matched.filter((x) => x.fills.length || x.kept.length); %>
      <% if (_changes.length) { %>
      <details class="mg-more">
        <summary>What changes for students already here (<%= _changes.length %>)</summary>
        <div class="mg-scroll"><table class="mg-table"><thead><tr><th>Student</th><th>Found by</th><th>Filled in (was empty)</th><th>Kept as Managira has it</th></tr></thead><tbody>
          <% _changes.slice(0, 200).forEach((x) => { %><tr><td><strong><%= x.name %></strong> <small class="mg-samples"><%= x.sourceId %></small></td><td><%= x.how === 'link' ? 'an earlier move' : x.how %></td><td><%= x.fills.join(', ') || '—' %></td>
            <td><% if (!x.kept.length) { %>—<% } else { x.kept.forEach((k) => { %><div><%= k.label %>: <strong><%= k.live %></strong> <small class="mg-samples">(your file: <%= k.file %>)</small></div><% }) } %></td></tr><% }) %>
        </tbody></table></div>
        <% if (_changes.length > 200) { %><p class="mg-hint">And <%= _changes.length - 200 %> more.</p><% } %>
        <p class="mg-hint">To change a value kept as Managira has it, edit it on the student's page after you go live.</p>
      </details>
      <% } %>
    </div>
    <% } %>
    <h3>Your files beside the sandbox</h3>
    <table class="mg-table"><thead><tr><th>Area</th><th class="num">In your files</th><th class="num">In the sandbox</th></tr></thead><tbody>
      <% if (_report) Object.entries(_report.entities).filter(([, v]) => v.source).forEach(([entity, v]) => { %><tr><td><%= entities[entity].label %><% if (entity === 'guardians') { const _gl = files.filter((f) => f.entity === 'guardians').length; const _gs = (sandbox.counts.guardians || {}).count || 0; %> <small class="mg-hint"><%= _gl > 1 && _gs < v.source ? '(' + _gl + ' lists of the same parents, merged into one record each)' : _gs > v.source ? '(with the parents named in the students file)' : '' %></small><% } %></td><td class="num"><%= Number(v.source).toLocaleString('en-US') %></td><td class="num"><%= Number((sandbox.counts[entity] || {}).count || 0).toLocaleString('en-US') %></td></tr><% }) %>
      <% if (sandbox.counts.grades) { %>
        <tr><td>Credits earned (total)</td><td class="num"><%= (job.totals.source || {}).credits %></td><td class="num"><%= sandbox.counts.grades.credits %></td></tr>
      <% } %>
    </tbody></table>
    <% if (gpaCheck && gpaCheck.checked) { %>
      <h3>GPA check</h3>
      <p class="mg-hint"><strong><%= gpaCheck.matching %></strong> of <%= gpaCheck.checked %> students' GPA from PowerSchool matches the one worked out from their final grades. Their PowerSchool GPA is kept on their transcript either way. A difference usually means grades left out of the export, or a weighting the export doesn't carry.</p>
      <% if (gpaCheck.differ.length) { %>
      <div class="mg-scroll"><table class="mg-table"><thead><tr><th>Student</th><th class="num">PowerSchool weighted</th><th class="num">From grades, weighted</th><th class="num">PowerSchool unweighted</th><th class="num">From grades, unweighted</th><th class="num">Courses</th></tr></thead><tbody>
        <% gpaCheck.differ.slice(0, 100).forEach((g) => { %><tr class="mg-row--unsure"><td><strong><%= g.name %></strong> <small class="mg-samples"><%= g.sourceId %></small></td>
          <td class="num"><%= _g(g.source.weighted !== undefined ? g.source.weighted : g.source.gpa) %></td><td class="num<%= g.differs.includes('weighted') || g.differs.includes('GPA') ? ' mg-bad' : '' %>"><%= _g(g.managira.weighted) %></td>
          <td class="num"><%= _g(g.source.unweighted) %></td><td class="num<%= g.differs.includes('unweighted') ? ' mg-bad' : '' %>"><%= _g(g.managira.unweighted) %></td><td class="num"><%= g.courses %></td></tr><% }) %>
      </tbody></table></div>
      <% if (gpaCheck.differ.length > 100) { %><p class="mg-hint">And <%= gpaCheck.differ.length - 100 %> more.</p><% } %>
      <% } %>
    <% } %>
    <h3>Approve each area</h3>
    <div class="mg-approvals">
      <% needed.forEach((s) => { const on = (job.approvals || {})[s]; %>
        <form method="POST" action="/common/migration/approve"><input type="hidden" name="section" value="<%= s %>" /><input type="hidden" name="on" value="<%= on ? '0' : '1' %>" />
          <button class="mg-approval<%= on ? ' is-on' : '' %>" type="submit" aria-pressed="<%= Boolean(on) %>"><span class="mg-tick" aria-hidden="true"></span><strong><%= sectionLabels[s] %></strong><small><%= on ? 'Approved by ' + on.by : 'Not approved yet' %></small></button>
        </form>
      <% }) %>
    </div>
    <h3>Migration summary</h3>
    <div class="mg-summary" id="mgSummary">
      <% [['mapped', 'Mapped to Managira fields'], ['custom', 'Made into custom fields'], ['extra', 'Kept as extra fields'], ['alerts', 'Alerts on the student'], ['archived', 'Archived (read-only)'], ['excluded', 'Left out']].forEach(([key, label]) => { %>
        <div><h4><%= label %> <small><%= summary[key].length %></small></h4><% if (summary[key].length) { %><ul><% summary[key].forEach((line) => { %><li><%= line %></li><% }) %></ul><% } else { %><p class="mg-hint">None.</p><% } %></div>
      <% }) %>
    </div>
    <p><button class="mg-btn mg-btn--sm" type="button" onclick="window.print()">Print the summary</button></p>
    <% if (job.signed_at) { %>
      <p class="mg-good">Signed by <strong><%= job.signed_name %></strong> on <%= _when(job.signed_at) %>.</p>
      <p class="mg-next"><a class="mg-btn mg-btn--primary" href="/common/migration?step=live&embed=workspace">Next: go live</a></p>
    <% } else if (blockers.length) { %>
      <%- include('partials/ready', { heading: 'Before you can sign' }) %>
    <% } else { %>
      <form class="mg-sign" method="POST" action="/common/migration/sign">
        <label>Type your full name to sign<input name="name" required minlength="3" maxlength="120" autocomplete="name" /></label>
        <label class="mg-check"><input type="checkbox" required /> I've checked this summary and approve moving this data to our live account.</label>
        <button class="mg-btn mg-btn--primary" type="submit">Sign</button>
      </form>
    <% } %>
  </section>
  <% } %>

  <% if (step === 'live' && !_blank) { %>
  <section class="mg-card">
    <% if (job.status === 'live') {
         const loaded = (job.totals && job.totals.loaded) || {};
         const src = (job.totals && job.totals.source) || {};
         const rep = (_report && _report.entities) || {};
         const att = loaded.attendance || {};
         const srcAtt = src.attendance || {};
         const _rows = [
           ['Students', (rep.students || {}).source, loaded.students],
           ['Students enrolled in the current term', (rep.students || {}).source, loaded.enrolled],
           ['Staff with an account', (rep.staff || {}).source, loaded.staff],
           ['Sections placed in a class', (rep.classes || {}).source, (rep.classes || {}).source === undefined ? undefined : (rep.classes || {}).source - (loaded.sectionsUnplaced || 0)],
           ['Final grades (courses)', (rep.grades || {}).source, loaded.courses],
           ['Credits earned', src.credits, loaded.credits],
           ...(gpaCheck && gpaCheck.checked ? [['Students whose GPA matches PowerSchool', gpaCheck.checked, gpaCheck.matching]] : []),
           ['Days present', srcAtt.present, att.present],
           ['Days absent', srcAtt.absent, att.absent],
         ].filter((r) => r[1] !== undefined && r[1] !== null && (r[1] !== 0 || r[2]));
    %>
      <h2>You're live</h2>
      <p class="mg-hint">Loaded on <%= _when(job.live_at) %><%= job.catch_up_at ? ', caught up on ' + _when(job.catch_up_at) : '' %>: students, parents, staff accounts, sections and their teachers, final grades and attendance totals. <strong><%= loaded.subjects || 0 %></strong> subjects and <strong><%= loaded.classes || 0 %></strong> classes were made, <strong><%= loaded.teacherLinks || 0 %></strong> teacher links and <strong><%= loaded.mainTeachers || 0 %></strong> teachers in charge of a class.</p>
      <% if (loaded.matched || loaded.guardiansMatched || loaded.staffMatched || loaded.keptValues) { %>
      <p class="mg-good"><% const _n = (v, one, many) => (v || 0) + ' ' + ((v || 0) === 1 ? one : many); const _keptAll = (loaded.matched || 0) + (loaded.guardiansMatched || 0) + (loaded.staffMatched || 0); %>Nothing already in Managira was replaced: <%= _n(loaded.matched, 'student', 'students') %>, <%= _n(loaded.guardiansMatched, 'parent', 'parents') %> and <%= _n(loaded.staffMatched, 'member of staff', 'staff') %> <%= _keptAll === 1 ? 'was' : 'were' %> already here and kept<%= loaded.filled ? ', with ' + loaded.filled + ' empty ' + (loaded.filled === 1 ? 'field' : 'fields') + ' filled in' : '' %>.<%= loaded.keptValues ? ' ' + loaded.keptValues + (loaded.keptValues === 1 ? ' value differs' : ' values differ') + ' from your files and stayed as Managira had ' + (loaded.keptValues === 1 ? 'it' : 'them') + '.' : '' %></p>
      <% if ((loaded.kept || []).length) { %>
      <details class="mg-more"><summary>Values kept as Managira had them</summary>
        <div class="mg-scroll"><table class="mg-table"><thead><tr><th>Who</th><th>Kept</th></tr></thead><tbody>
          <% loaded.kept.forEach((k) => { %><tr><td><strong><%= k.who %></strong></td><td><% k.fields.forEach((f) => { %><div><%= f.label %>: <strong><%= f.live %></strong> <small class="mg-samples">(your file: <%= f.file %>)</small></div><% }) %></td></tr><% }) %>
        </tbody></table></div>
      </details>
      <% } %>
      <% } %>
      <% if (loaded.studentsWaiting) { %><p class="mg-notice"><%= loaded.studentsWaiting %> <%= loaded.studentsWaiting === 1 ? 'student wasn’t' : 'students weren’t' %> loaded: <%= loaded.studentsWaiting === 1 ? 'they' : 'they' %> may already be in Managira. Answer under Review & sign, Already in Managira.</p><% } %>
      <p><a class="mg-btn" href="/common/migration/old-records?embed=workspace" data-no-spa>Records from your old system</a> <small class="mg-hint">lists kept for the school, and documents not on a current student</small></p>
      <% const _t = loaded.transport || {}; const _p = loaded.paygira || {}; const _usd = (n) => '$' + Number(n || 0).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
         const _feat = [
           loaded.graduates ? ['Graduates & Alumni', `${loaded.graduates} graduates as former students, with ${Number(loaded.graduateCourses || 0).toLocaleString('en-US')} transcript courses`] : null,
           loaded.photos ? ['Student photos', `${loaded.photos} students' pictures from your files`] : null,
           (_t.routes || _t.buses || _t.riders) ? ['Transportation', `${_t.buses || 0} buses, ${_t.drivers || 0} drivers, ${_t.routes || 0} routes, ${_t.stops || 0} stops, ${_t.schedules || 0} weekly runs, ${_t.riders || 0} riders${_t.ridersKept ? ` (${_t.ridersKept} already on a bus kept theirs)` : ''}${_t.alternates ? `; ${_t.alternates} alternate-address arrangements on the students' records` : ''}`] : null,
           (_p.bills || _p.payments) ? ['PayGira', `${_p.bills || 0} bills with ${_p.charges || 0} charges on students' ledgers (${_usd(_p.owed)} still owed), ${_p.payments || 0} payments${_p.mealDebts ? `; ${_p.mealDebts} meal accounts in debt billed` : ''}${_p.mealCredits ? `; ${_p.mealCredits} meal accounts in credit (${_usd(_p.credit)}) as students' PayGira credit` : ''}`] : null,
           (loaded.alerts || loaded.medicalAlerts) ? ['Alerts', `${loaded.medicalAlerts || 0} medical (care plans, severe allergies) and ${loaded.alerts || 0} custody alerts at the top of each student's page, for every teacher and substitute who opens it`] : null,
           loaded.parentDetails ? ["Parents' details", `${loaded.parentDetails} parents' phone, email or address filled in from your parent list`] : null,
           loaded.gradGroups ? ['Graduation years', `${loaded.gradGroups} graduation year ${loaded.gradGroups === 1 ? 'group' : 'groups'} made`] : null,
         ].filter(Boolean); %>
      <% if (_feat.length) { %>
      <h3>Also in Managira's own features</h3>
      <ul class="mg-feat"><% _feat.forEach(([what, text]) => { %><li><strong><%= what %></strong><span><%= text %></span></li><% }) %></ul>
      <% if (_t.routes && !locals.transportOn) { %><p class="mg-notice">Your buses and routes are in Managira. Turn Transportation on in Settings › Integrations to use them.</p><% } %>
      <% } %>
      <%- include('partials/apps', { apps }) %>
      <h3>Your files beside Managira</h3>
      <table class="mg-table mg-compare"><thead><tr><th>What</th><th class="num">In your files</th><th class="num">In Managira</th></tr></thead><tbody>
        <% _rows.forEach(([label, a, b]) => { %><tr><td><%= label %></td><td class="num"><%= a %></td><td class="num<%= Number(a) !== Number(b) ? ' is-off' : '' %>"><%= b === null || b === undefined ? '—' : b %></td></tr><% }) %>
      </tbody></table>
      <% if (_rows.some(([, a, b]) => Number(a) !== Number(b))) { %><p class="mg-hint">Amber figures differ from your files: duplicates, rows the check report flagged, staff without an email (left out), or GPAs that don't match their grades (see Review; each student's PowerSchool GPA is kept on their transcript).</p><% } %>
      <% if (loaded.sectionsUnplaced) { %><p class="mg-notice"><%= loaded.sectionsUnplaced %> <%= loaded.sectionsUnplaced === 1 ? 'section' : 'sections' %> couldn't be placed in a class (no grade level and no class enrollments). Add them to the classes on the Classes & subjects page.</p><% } %>

      <% if (staff.length) { const _waiting = staff.filter((p) => p.waiting); %>
        <h3>Staff accounts</h3>
        <p class="mg-hint">New accounts are on hold: they can't sign in until you invite them. The invitation is a link to set a password, valid for 3 days. Check each person's role and classes on the Users page first; nobody was made a manager.</p>
        <form method="POST" action="/common/migration/invite">
          <div class="mg-scroll"><table class="mg-table"><thead><tr><th></th><th>Name</th><th>Email</th><th>Role</th><th>Classes</th><th>Status</th></tr></thead><tbody>
            <% staff.forEach((p) => { %>
              <tr>
                <td><% if (p.waiting) { %><input type="checkbox" name="userIds" value="<%= p.user_id %>" aria-label="Invite <%= p.first_name %> <%= p.last_name %>" /><% } %></td>
                <td><strong><%= p.first_name %> <%= p.last_name %></strong></td><td><%= p.email %></td><td><%= p.role %></td><td><%= p.classes || '—' %></td>
                <td><%= p.waiting ? 'Waiting for an invitation' : p.invited_at ? (p.has_password ? 'Signed up' : 'Invited ' + _when(p.invited_at)) : 'Already had an account' %></td>
              </tr>
            <% }) %>
          </tbody></table></div>
          <% if (_waiting.length) { %>
            <div class="mg-actions">
              <button class="mg-btn" type="submit">Invite the ones ticked</button>
              <button class="mg-btn mg-btn--primary" type="submit" name="all" value="1">Invite all <%= _waiting.length %> waiting</button>
            </div>
          <% } %>
        </form>
      <% } %>
      <% if ((loaded.staffSkipped || []).length) { %>
        <h3>Staff without an account</h3>
        <ul class="mg-list"><% loaded.staffSkipped.forEach((p) => { %><li><strong><%= p.name %></strong><%= p.email ? ' (' + p.email + ')' : '' %>: <%= ({ 'No email': 'no email in the staff file', 'No role': 'no role', "Waiting for the school admin's approval": 'new in the catch-up with access that goes up or is admin-level, which needs your approval: add them on the Users page' })[p.why] || 'that email is already used by another Managira account' %></li><% }) %></ul>
        <p class="mg-hint">Add them on the Users page, or fix the export and load the catch-up.</p>
      <% } %>

      <h3>Catch-up</h3>
      <% if (job.catch_up_at) { %><p class="mg-hint">The catch-up import was used on <%= _when(job.catch_up_at) %>.</p><% } else { %>
        <p class="mg-hint">One last import for changes made in PowerSchool since (final grades, attendance). Upload the new files, then load them. Records are updated, never duplicated.</p>
        <%- include('partials/upload', { label: 'Drop the new export files here', action: '/common/migration/upload', withEntity: false }) %>
        <form method="POST" action="/common/migration/catch-up" data-starts-task onsubmit="return confirm('Load the latest files into your live account? This can be done once.')"><button class="mg-btn mg-btn--primary" type="submit">Load the catch-up</button></form>
      <% } %>
      <p class="mg-hint">On <%= job.purge_after ? new Date(job.purge_after).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' }) : '' %> the uploaded files, the snapshot and the sandbox are deleted. Your live records stay. Until then, Managira can roll the go-live back if something is wrong.</p>
    <% } else if (job.signed_at) { %>
      <h2>Go live</h2>
      <ol class="mg-list">
        <li>Upload your latest export files first (step 1), so nothing entered in PowerSchool since is missed.</li>
        <li>Go live imports those files again, keeps a snapshot, and loads your live account: students (enrolled in the current term), parents, staff accounts (on hold until you invite them), sections as subjects of their classes with their teachers, final grades with credits and GPA on each student's transcript, and attendance totals per term. Daily attendance and archived columns stay read-only on each student.</li>
        <li>Your account opens for new data again. For 30 days Managira can roll the go-live back.</li>
      </ol>
      <form method="POST" action="/common/migration/go-live" data-starts-task onsubmit="return confirm('Go live now? Your data moves into your live account. It runs in the background and takes a few minutes for a large school.')"><button class="mg-btn mg-btn--primary" type="submit">Go live</button></form>
    <% } else { %>
      <h2>Go live</h2>
      <p class="mg-hint">Going live moves everything in your sandbox into your live account in one step. It's ready when every box below is ticked.</p>
      <%- include('partials/ready', { heading: 'Ready to go live' }) %>
    <% } %>
  </section>
  <% } %>

  <details class="mg-more mg-log"><summary>Activity</summary>
    <ul><% events.forEach((e) => { %><li><span><%= _when(e.at) %></span> <%= e.actor %>: <%= e.action.replace(/_/g, ' ') %></li><% }) %></ul>
  </details>
</div>
<script src="<%= assetUrl('/js/migrationTask.js') %>" defer></script>
