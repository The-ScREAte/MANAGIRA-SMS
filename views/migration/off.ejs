<%# Data migration while the school's sandbox is switched off (it's given by Managira, but off):
    one card to turn it on. The same switch is in the header menu (utils/dataMigration.js sandboxSwitch). %>
<link rel="stylesheet" href="<%= assetUrl('/css/migration.css') %>" />
<div class="mg mg-request">
  <%- include('../partials/flash') %>
  <header class="mg-head">
    <div>
      <h1>Data migration <span class="mg-pill mg-pill--off">Sandbox off</span></h1>
      <p>Your sandbox is ready. Turn it on to upload your exports and carry on with your move.</p>
    </div>
  </header>
  <section class="mg-card mg-off">
    <h2>Turn the sandbox on</h2>
    <p class="mg-hint">While it's on, nothing new can be saved in Managira, so nothing is entered twice. Everyone can still sign in and look. You can turn it off at any time from the menu; what you uploaded is kept.</p>
    <form method="POST" action="/common/migration/sandbox" target="_top" data-no-spa>
      <input type="hidden" name="on" value="1">
      <button type="submit" class="mg-btn mg-btn--primary">Turn sandbox on</button>
    </form>
  </section>
</div>
