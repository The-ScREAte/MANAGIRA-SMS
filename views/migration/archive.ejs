<%# A read-only archive from the old system (controllers/dataMigrationController.js archivePage). %>
<!doctype html>
<html lang="en"><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
<title><%= archive.module %><%= student ? ' · ' + student.first_name + ' ' + student.last_name : '' %></title>
<style>
  body { margin: 0; padding: 28px; font: 14px/1.45 system-ui, -apple-system, "Segoe UI", sans-serif; color: #101828; background: #fff; }
  h1 { margin: 0; font-size: 20px; } p { margin: 4px 0 16px; color: #667085; }
  .bar { display: flex; gap: 8px; margin-bottom: 16px; } .bar a, .bar button { padding: 8px 14px; border: 1px solid #d0d5dd; border-radius: 9px; background: #fff; color: inherit; font: inherit; font-weight: 600; text-decoration: none; cursor: pointer; }
  .wrap { overflow-x: auto; } table { width: 100%; border-collapse: collapse; font-size: 13px; }
  th { padding: 7px 9px; border-bottom: 1px solid #e4e7ec; color: #667085; font-size: 11.5px; text-align: left; text-transform: uppercase; } td { padding: 7px 9px; border-bottom: 1px solid #f2f4f7; }
  @media print { .bar { display: none; } body { padding: 0; } }
</style></head>
<body>
  <h1><%= archive.module %></h1>
  <p><%= student ? student.first_name + ' ' + student.last_name + ' · ' : '' %>From the old system, read-only<%= archive.sensitive ? ' · Restricted' : '' %> · <%= rows.length %> <%= rows.length === 1 ? 'row' : 'rows' %></p>
  <div class="bar"><a href="?format=csv">Download (CSV)</a><button type="button" onclick="window.print()">Print</button></div>
  <div class="wrap"><table><thead><tr><% columns.forEach((c) => { %><th><%= c %></th><% }) %></tr></thead><tbody>
    <% rows.forEach((row) => { %><tr><% columns.forEach((c) => { %><td><%= row[c] == null ? '' : row[c] %></td><% }) %></tr><% }) %>
  </tbody></table></div>
</body></html>
