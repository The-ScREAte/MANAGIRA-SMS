          }
        .actions {
            text-align: center;
            margin-bottom: 20px;
        }

        .student-report-background {
            position: relative;
            width: 100%;
            overflow: visible;
        }   

        .student-report-background::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background-image: url('<%= session.logo %>');
            background-repeat: no-repeat;
            background-position: center;
            background-size: 300px 300px;
            opacity: 0.09;
            z-index: 0;
            pointer-events: none;
        }

        /* Watermark img for print (hidden on screen) */
        .print-watermark-img {
            display: none;
        }

        .student-report {
            position: relative;
            z-index: 1;
            border: 2px solid #e0e0e0;
            padding: 10px 20px 20px 20px;
            margin-bottom: 40px;
            background-color: #fff;
            max-width: 800px;
            margin: 5px auto 40px auto;
            box-sizing: border-box;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            page-break-after: always;
            break-after: page;
            border-radius: 8px;
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
            transition: all 0.3s ease;
            overflow: visible;
        }

        .student-report:last-of-type {
            page-break-after: auto;
            break-after: auto;
        }

        .paygira-print-block {
            display: block;
            margin-top: 18px;
            page-break-inside: avoid;
            border: 1px solid color-mix(in srgb, var(--primary) 24%, #dbe5f0);
            border-radius: 8px;
            background: color-mix(in srgb, var(--primary) 8%, #ffffff);
            padding: 8px;
        }

        .paygira-print-block h5 {
            margin: 0 0 6px;
            color: var(--primary);
            font-size: 12px;
            font-weight: 700;
        }

        .paygira-print-block table {
            width: 100%;
            border-collapse: collapse;
            font-size: 11px;
            background: #fff;
        }

        .paygira-print-block th,
        .paygira-print-block td {
            border: 1px solid #d9e1ea;
            padding: 5px 4px;
            font-size: 10px;
            vertical-align: top;
        }

        .paygira-print-block th {
            background: color-mix(in srgb, var(--primary) 12%, #ffffff);
            color: var(--primary);
            border-color: color-mix(in srgb, var(--primary) 28%, #d9e1ea);
            font-weight: 700;
        }

        .paygira-print-block .paygira-total-row-emphasis td {
            font-weight: 800;
            font-size: 11px;
            background: color-mix(in srgb, var(--primary) 16%, #ffffff);
            border-top: 2px solid color-mix(in srgb, var(--primary) 65%, #334155);
            border-color: color-mix(in srgb, var(--primary) 30%, #d9e1ea);
            color: var(--primary);
        }

        .paygira-print-block .paygira-total-row-emphasis td:first-child {
            letter-spacing: 0.03em;
        }

        .paygira-print-block input {
            width: 100%;
            border: 1px solid #cbd5e1;
            border-radius: 4px;
            padding: 3px 5px;
            font-size: 10px;
            box-sizing: border-box;
            background: #fff;
        }

        .paygira-block-head {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 8px;
            margin-bottom: 6px;
        }

        .paygira-edit-btn {
            border: 1px solid #cbd5e1;
            background: #fff;
            color: #334155;
            border-radius: 999px;
            width: 22px;
            height: 22px;
            font-size: 12px;
            font-weight: 700;
            padding: 0;
            cursor: pointer;
            display: inline-flex;
            align-items: center;
            justify-content: center;
        }

        .paygira-edit-btn:hover {
            border-color: var(--primary);
            color: var(--primary);
        }

        .paygira-edit-modal-overlay {
            position: fixed;
            inset: 0;
            background: rgba(15, 23, 42, 0.5);
            display: none;
            align-items: center;
            justify-content: center;
            z-index: 9999;
        }

        .paygira-edit-modal {
            width: min(680px, 94vw);
            max-height: 90vh;
            overflow: auto;
            background: #fff;
            border-radius: 12px;
            border: 1px solid #dbe3ee;
            box-shadow: 0 20px 48px rgba(15, 23, 42, 0.25);
            padding: 14px;
        }

        .paygira-edit-grid {
            display: grid;
            grid-template-columns: 1.1fr 0.9fr 0.9fr auto;
            gap: 8px;
            margin-bottom: 8px;
        }

        .paygira-edit-grid input,
        .paygira-edit-grid select {
            width: 100%;
            border: 1px solid #d0dae6;
            border-radius: 7px;
            padding: 7px 8px;
            font-size: 13px;
        }

        .paygira-selector-box {
            border: 1px solid #e2e8f0;
            border-radius: 8px;
            padding: 8px;
            background: #f8fafc;
            margin-top: 6px;
        }

        .paygira-selector-title {
            font-size: 0.8rem;
            font-weight: 700;
            color: #475569;
            margin-bottom: 6px;
        }

        .paygira-selector-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(170px, 1fr));
            gap: 5px 10px;
            max-height: 160px;
            overflow: auto;
        }

        .student-report:hover {
            box-shadow: 0 4px 16px rgba(0, 0, 0, 0.12);
            transform: translateY(-2px);
        }

        .header {
            display: grid;
            grid-template-columns: auto 1fr auto;
            align-items: center;
            gap: 14px;
            margin-bottom: 13px;
            padding-bottom: 10px;
            border-bottom: 3px solid var(--primary);
            width: 100%;
        }

        .header img.logo,
        .header img.student-image {
            width: 58px;
            height: 62px;
            object-fit: cover;
            border-radius: 10px;
            box-shadow: 0 2px 6px rgba(0, 0, 0, 0.1);
        }

        .header .logo { justify-self: start; }
        .header .student-image { justify-self: end; }

        .header .school-info {
            min-width: 0;
        }

        .header h1,
        .header h2,
        .header h3 {
            margin: 0;
            text-align: center;
            white-space: normal;
            overflow-wrap: anywhere;
            word-break: break-word;
        }

        .header h1 {
            color: var(--primary);
            font-weight: 700;
        }

        th,
        td {
            border: 1px solid #ddd;
            padding: 8px 5px;
            text-align: left;
            font-size: 11px;
        }

        th {
            background-color: var(--org-primary-light);
            color: var(--primary);
            font-weight: 600;
        }

        .info table,
        .subjects table,
        .attendance-info table {
            border-collapse: collapse;
            width: 100%;
            table-layout: fixed;
            margin-bottom: 15px;
            border-radius: 6px;
            overflow: hidden;
        }

        .attendance-info {
            width: 100%;
            overflow-x: visible;
        }

        .attendance-info .promotion-table {
            width: 100%;
            table-layout: auto;
            min-width: 0;
        }

        .info {
            width: 100%;
        }

        .info table td:nth-child(1),
        .info table td:nth-child(3) {
            width: 20%;
            font-weight: 600;
        }

        .info table td:nth-child(2),
        .info table td:nth-child(4) {
            width: 30%;
        }

        .info table tr:nth-child(even),
        .subjects table tbody tr:nth-child(even) {
            background-color: #f9f9f9;
        }

        .info table tr:hover,
        .subjects table tbody tr:hover {
            background-color: var(--org-primary-light);
        }

/* Ensure remarks and signature are aligned in a single row */
.remarks-signature-wrapper {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 40px;
    width: 100%;
    margin-top: 20px;
    padding-top: 20px;
    border-top: 2px solid #e8e8e8;
}

/* Ensure remarks section remains flexible and aligned */
.remarks {
    flex-grow: 1;
    display: flex;
    flex-direction: column;
    gap: 14px;
}

/* Section headers */
.remarks-header {
    font-size: 15px;
    font-weight: 700;
    color: var(--primary);
    margin-bottom: 8px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    display: flex;
    align-items: center;
    gap: 8px;
}

.remarks-header::before {
    content: '';
    width: 4px;
    height: 18px;
    background: var(--primary);
    border-radius: 2px;
}

/* Improve alignment for each remark line */
.remark-line {
    display: flex;
    align-items: flex-start;
    position: relative;
    width: 100%;
    padding: 0;
    margin-bottom: 12px;
    background-color: transparent;
    border-radius: 0;
    border: none;
}

.remark-line:last-child {
    margin-bottom: 0;
}

/* Label styling for perfect alignment */
.remark-line label {
    font-size: 14px;
    color: #555;
    white-space: normal;
    min-width: 170px;
    width: 170px;
    flex: 0 0 170px;
    font-weight: 600;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: start;
    column-gap: 10px;
    text-transform: capitalize;
    line-height: 1.35;
    overflow-wrap: anywhere;
    word-break: break-word;
}

/* Remark arrow styling */
.remark-arrow {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 18px;
    height: 18px;
    background-color: transparent;
    color: var(--primary);
    border-radius: 50%;
    cursor: pointer;
    font-size: 10px;
    transition: all 0.2s ease;
    border: 1.5px solid var(--primary);
    margin-top: 1px;
    margin-left: 4px;
    flex-shrink: 0;
}

.remark-arrow:hover {
    background-color: var(--primary);
    color: white;
}

/* Restore the dotted lines directly inside textarea */
.remark-line textarea {
    position: relative;
    top: 4px;
    flex-grow: 1;
    border: none;
    font-size: 14px;
    padding: 0;
    margin: 0;
    background: transparent;
    outline: none;
    width: 100%;
    height: 22px;
    min-height: 22px;
    padding-top: 0;
    max-height: 66px;
    line-height: 22px;
    text-align: left;
    font-family: var(--font-family);
    overflow-y: hidden;
    overflow-x: hidden;
    resize: none;
    border-radius: 0;
    border-bottom: 1px dotted #999;
    transition: border 0.2s ease;
    color: #1a1a1a;
    font-weight: 500;
    margin-top: 0;
    white-space: pre-wrap;
    word-wrap: break-word;
}

.remark-line textarea:focus {
    border-bottom-color: var(--primary);
    border-bottom-style: solid;
    border-bottom-width: 1.5px;
    color: #000;
    font-weight: 600;
}

/* Ensure dropdown is properly positioned */
.remark-dropdown {
    position: absolute;
    left: 0;
    right: 0;
    top: calc(100% + 6px);
    width: auto;
    min-width: 220px;
    max-width: 100%;
    background-color: #fff;
    border: 2px solid var(--primary);
    border-radius: 8px;
    box-shadow: 0px 12px 32px rgba(0, 0, 0, 0.25);
    z-index: 99999;
    display: none;
    max-height: 280px;
    overflow-y: auto;
    overflow-x: hidden;
}

/* Custom scrollbar for dropdown */
.remark-dropdown::-webkit-scrollbar {
    width: 8px;
}

.remark-dropdown::-webkit-scrollbar-track {
    background: #f1f1f1;
    border-radius: 4px;
}

.remark-dropdown::-webkit-scrollbar-thumb {
    background: var(--primary);
    border-radius: 4px;
}

.remark-dropdown::-webkit-scrollbar-thumb:hover {
    background: var(--primary-hover-fill, var(--primary-hover));
}

/* Ensure dropdown options are well spaced */
.remark-dropdown-option {
    padding: 11px 16px;
    cursor: pointer;
    font-size: 13px;
    transition: all 0.15s ease;
    border-bottom: 1px solid #f5f5f5;
    color: #333;
    line-height: 1.5;
    word-wrap: break-word;
    overflow-wrap: break-word;
    white-space: normal;
}

.remark-dropdown-option:last-child {
    border-bottom: none;
}

.remark-dropdown-option:hover {
    background-color: var(--org-primary-light);
    color: var(--primary);
    font-weight: 500;
}



/* Proper positioning of the signature section */
.signature-info {
    position: relative;
    top: 0;
    width: 180px;
    min-width: 180px;
    align-self: flex-end;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
    padding: 0;
    background-color: transparent;
    border-radius: 0;
    border: none;
}

.signature-info img {
    max-width: 140px;
    height: auto;
    display: block;
    margin-bottom: 8px;
    border-radius: 0;
    filter: grayscale(0%);
}

.signature-info h3 {
    margin: 0;
    color: #333;
    font-size: 11px;
    font-weight: 600;
    border-top: 1.5px solid #333;
    padding-top: 4px;
    width: 100%;
    text-transform: uppercase;
    letter-spacing: 0.5px;
}

.signature-title {
    font-size: 13px;
    font-weight: 700;
    color: var(--primary);
    margin-bottom: 12px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
}


        .promotion-table select {
            width: auto;
            padding: 0;
            border: none;
            background: transparent;
            -webkit-appearance: none;
            appearance: none;
            font-size: 13px;
            cursor: pointer;
            color: var(--org-primary-color);
            font-weight: 600;
        }

        .promotion-select-wrapper {
            display: inline-flex;
