        --primary-hover: var(--org-primary-hover, #0056b3);
        --primary-hover-fill: color-mix(in srgb, var(--primary) 88%, white);
        --org-primary-light: color-mix(in srgb, var(--org-primary-color, #007bff) 15%, white);
      }
                            <a href="/print/reportSettings?classId=<%= classId %>&termId=<%= termId %>" class="btn btn-primary" data-no-spa>Settings & Signature</a>
