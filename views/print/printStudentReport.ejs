                padding: 0;
            }

            .remark-arrow,
            .remark-dropdown {
                display: none !important;
            }

            /* Signature section */
            .signature-info {
                width: 150px;
                min-width: 150px;
                padding: 0;
                background: transparent;
                border: none;
            }

            .signature-title {
                font-size: 12px;
                margin-bottom: 8px;
            }

            .signature-info img {
                max-width: 110px;
                margin-bottom: 6px;
            }

            .signature-info h3 {
                font-size: 10px;
                padding-top: 5px;
                border-top: 1.5px solid #333;
            }

            /* Promotion row — plain text in print */
            .promotion-table select {
                font-size: 11px;
                pointer-events: none;
                color: #333;
            }
            .promotion-chevron {
                display: none;
            }

            .attendance-manual-input {
                border: none !important;
                box-shadow: none !important;
                padding: 0;
                margin-right: 2px;
                width: 44px;
                min-width: 44px;
                background: transparent !important;
                outline: none !important;
                appearance: textfield;
                -webkit-appearance: none;
            }

            /* Grade interpretation */
            .grade-interpretation {
                border: 2px solid var(--primary);
                font-size: 10px;
                width: 100%;
                max-width: 100%;
                margin: 12px 0 0 0;
                padding: 8px;
                line-height: 1.5;
                page-break-inside: avoid;
                background-color: var(--org-primary-light);
                border-radius: 6px;
                position: static;
                top: 0;
            }

            .grade-interpretation h6 {
                font-size: 12px;
                margin: 2px 0 6px 0;
                color: var(--primary);
            }

            .grade-interpretation-item {
                font-size: 10px;
                margin: 0 5px;
            }

            .report-card-footer {
                margin-top: 10px;
                padding-top: 6px;
            }

            /* Prevent orphan page breaks */
            .subjects table {
                page-break-inside: auto;
            }

            .subjects table tr {
                page-break-inside: avoid;
                page-break-after: auto;
            }

            .subjects thead {
                display: table-header-group;
            }

            .subjects tbody tr {
                page-break-inside: avoid;
            }
        }
