
    <style>
      :root {
        --font-family: "<%= (session && session.fontStyle ? String(session.fontStyle).trim() : 'Inter') %>", sans-serif;
        --primary: var(--org-primary-color, #007bff);
        --primary-hover: var(--org-primary-hover, #0056b3);
        --primary-hover-fill: color-mix(in srgb, var(--primary) 88%, white);
        --org-primary-light: color-mix(in srgb, var(--org-primary-color, #007bff) 15%, white);
      }


        body {
            font-family: var(--font-family);
            background-color: #f5f7fa;
            padding-top: 80px;
          }
        .actions {
            text-align: center;
            margin-bottom: 20px;
        }

        .student-report-background {
            position: relative;
            width: 100%;
            overflow: visible;
        }   

        .student-report-background::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background-image: url('<%= session.logo %>');
            background-repeat: no-repeat;
            background-position: center;
            background-size: 300px 300px;
            opacity: 0.09;
            z-index: 0;
            pointer-events: none;
        }

        /* Watermark img for print (hidden on screen) */
        .print-watermark-img {
            display: none;
        }

        .student-report {
            position: relative;
            z-index: 1;
            border: 2px solid #e0e0e0;
            padding: 10px 20px 20px 20px;
            margin-bottom: 40px;
            background-color: #fff;
            max-width: 800px;
            margin: 5px auto 40px auto;
            box-sizing: border-box;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            page-break-after: always;
            border-radius: 8px;
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
            transition: all 0.3s ease;
            overflow: visible;
        }

        .student-report:hover {
            box-shadow: 0 4px 16px rgba(0, 0, 0, 0.12);
            transform: translateY(-2px);
        }

        .header {
            display: grid;
            grid-template-columns: auto 1fr auto;
            align-items: center;
            gap: 14px;
            margin-bottom: 13px;
            padding-bottom: 10px;
            border-bottom: 3px solid var(--primary);
            width: 100%;
        }

        .header img.logo,
        .header img.student-image {
            width: 58px;
            height: 62px;
            object-fit: cover;
            border-radius: 10px;
            box-shadow: 0 2px 6px rgba(0, 0, 0, 0.1);
        }

        .header .logo { justify-self: start; }
        .header .student-image { justify-self: end; }

        .header h1,
        .header h2,
        .header h3 {
            margin: 0;
            text-align: center;
            white-space: nowrap;
        }

        .header h1 {
            color: var(--primary);
            font-weight: 700;
        }

        th,
        td {
            border: 1px solid #ddd;
            padding: 8px 5px;
            text-align: left;
            font-size: 11px;
        }

        th {
            background-color: var(--org-primary-light);
            color: var(--primary);
            font-weight: 600;
        }

        .info table,
        .subjects table,
        .attendance-info table {
            border-collapse: collapse;
            width: 100%;
            margin-bottom: 15px;
            border-radius: 6px;
            overflow: hidden;
        }

        .info table tr:nth-child(even),
        .subjects table tbody tr:nth-child(even) {
            background-color: #f9f9f9;
        }

        .info table tr:hover,
        .subjects table tbody tr:hover {
            background-color: var(--org-primary-light);
        }

/* Ensure remarks and signature are aligned in a single row */
.remarks-signature-wrapper {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 40px;
    width: 100%;
    margin-top: 20px;
    padding-top: 20px;
    border-top: 2px solid #e8e8e8;
}

/* Ensure remarks section remains flexible and aligned */
.remarks {
    flex-grow: 1;
    display: flex;
    flex-direction: column;
    gap: 14px;
}

/* Section headers */
.remarks-header {
    font-size: 15px;
    font-weight: 700;
    color: var(--primary);
    margin-bottom: 8px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    display: flex;
    align-items: center;
    gap: 8px;
}

.remarks-header::before {
    content: '';
    width: 4px;
    height: 18px;
    background: var(--primary);
    border-radius: 2px;
}

/* Improve alignment for each remark line */
.remark-line {
    display: flex;
    align-items: baseline;
    position: relative;
    width: 100%;
    padding: 0;
    margin-bottom: 12px;
    background-color: transparent;
    border-radius: 0;
    border: none;
}

.remark-line:last-child {
    margin-bottom: 0;
}

/* Label styling for perfect alignment */
.remark-line label {
    font-size: 14px;
    color: #555;
    white-space: nowrap;
    min-width: 140px;
    font-weight: 600;
    display: flex;
    align-items: center;
    gap: 6px;
    text-transform: capitalize;
    line-height: 22px;
}

/* Remark arrow styling */
.remark-arrow {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 18px;
    height: 18px;
    background-color: transparent;
    color: var(--primary);
    border-radius: 50%;
    cursor: pointer;
    font-size: 10px;
    transition: all 0.2s ease;
    border: 1.5px solid var(--primary);
}

.remark-arrow:hover {
    background-color: var(--primary);
    color: white;
}

/* Restore the dotted lines directly inside textarea */
.remark-line textarea {
    position: relative;
    flex-grow: 1;
    border: none;
    font-size: 14px;
    padding: 0;
    margin: 0;
    background: transparent;
    outline: none;
    width: 100%;
    height: 22px;
    max-height: 66px;
    line-height: 22px;
    text-align: left;
    font-family: var(--font-family);
    overflow-y: hidden;
    overflow-x: hidden;
    resize: none;
    border-radius: 0;
    border-bottom: 1px dotted #999;
    transition: border 0.2s ease;
    color: #1a1a1a;
    font-weight: 500;
    white-space: pre-wrap;
    word-wrap: break-word;
}

.remark-line textarea:focus {
    border-bottom-color: var(--primary);
    border-bottom-style: solid;
    border-bottom-width: 1.5px;
    color: #000;
    font-weight: 600;
}

/* Ensure dropdown is properly positioned */
.remark-dropdown {
    position: fixed;
    left: auto;
    width: auto;
    min-width: 300px;
    max-width: 500px;
    background-color: #fff;
    border: 2px solid var(--primary);
    border-radius: 8px;
    box-shadow: 0px 12px 32px rgba(0, 0, 0, 0.25);
    z-index: 99999;
    display: none;
    max-height: 280px;
    overflow-y: auto;
    overflow-x: hidden;
}

/* Custom scrollbar for dropdown */
.remark-dropdown::-webkit-scrollbar {
    width: 8px;
}

.remark-dropdown::-webkit-scrollbar-track {
    background: #f1f1f1;
    border-radius: 4px;
}

.remark-dropdown::-webkit-scrollbar-thumb {
    background: var(--primary);
    border-radius: 4px;
}

.remark-dropdown::-webkit-scrollbar-thumb:hover {
    background: var(--primary-hover-fill, var(--primary-hover));
}

/* Ensure dropdown options are well spaced */
.remark-dropdown-option {
    padding: 11px 16px;
    cursor: pointer;
    font-size: 13px;
    transition: all 0.15s ease;
    border-bottom: 1px solid #f5f5f5;
    color: #333;
    line-height: 1.5;
    word-wrap: break-word;
    overflow-wrap: break-word;
    white-space: normal;
}

.remark-dropdown-option:last-child {
    border-bottom: none;
}

.remark-dropdown-option:hover {
    background-color: var(--org-primary-light);
    color: var(--primary);
    font-weight: 500;
}



/* Proper positioning of the signature section */
.signature-info {
    position: relative;
    top: 0;
    width: 180px;
    min-width: 180px;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
    padding: 0;
    background-color: transparent;
    border-radius: 0;
    border: none;
}

.signature-info img {
    max-width: 140px;
    height: auto;
    display: block;
    margin-bottom: 8px;
    border-radius: 0;
    filter: grayscale(0%);
}

.signature-info h3 {
    margin: 0;
    color: #333;
    font-size: 11px;
    font-weight: 600;
    border-top: 1.5px solid #333;
    padding-top: 4px;
    width: 100%;
    text-transform: uppercase;
    letter-spacing: 0.5px;
}

.signature-title {
    font-size: 13px;
    font-weight: 700;
    color: var(--primary);
    margin-bottom: 12px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
}


        .promotion-table select {
            width: auto;
            padding: 0;
            border: none;
            background: transparent;
            -webkit-appearance: none;
            appearance: none;
            font-size: 13px;
            cursor: pointer;
            color: var(--org-primary-color);
            font-weight: 600;
        }

        .promotion-select-wrapper {
            display: inline-flex;
            align-items: center;
            gap: 3px;
            cursor: pointer;
        }

        .promotion-chevron {
            font-size: 10px;
            color: var(--org-primary-color);
            pointer-events: none;
            line-height: 1;
        }

        .promotion-table td {
            padding: 4px 5px;
        }

        .grade-interpretation {
            border: 2px solid var(--primary);
            font-size: 11px;
            max-width: 600px;
            margin: 5px auto;
            line-height: 1.5;
            position: relative;
            top: 15px;
            border-radius: 6px;
            padding: 8px;
            background-color: var(--org-primary-light);
        }

        .grade-interpretation h6 {
            margin: 1px;
            font-size: 14px;
            text-align: center;
            color: var(--primary);
            font-weight: 600;
        }

        .grade-interpretation-content {
            display: flex;
            flex-wrap: wrap;
            align-items: center;
            justify-content: center;
        }

        .grade-interpretation-item {
            display: inline-block;
        }

        .report-card-footer {
            margin-top: 22px;
            padding-top: 10px;
            border-top: 1px solid #d1d5db;
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 12px;
            font-size: 11px;
            color: #475569;
        }

        .report-card-footer-left {
            font-weight: 600;
            text-align: left;
            word-break: break-word;
        }

        .report-card-footer-right {
            text-align: right;
            white-space: nowrap;
        }

        @media print {
            @page {
                size: A4 portrait;
                margin: 8mm 8mm 8mm 8mm;
            }

            * {
                -webkit-print-color-adjust: exact;
                print-color-adjust: exact;
            }

            body {
                margin: 0;
                padding: 0 !important;
                background: white;
            }

            body * {
                visibility: hidden;
            }

            /* Show only the report during print */
            .student-report,
            .student-report *,
            .student-report-background,
            .student-report-background * {
                visibility: visible;
            }

            .student-report {
                width: calc(100% - 12mm);
                max-width: 100%;
                margin: 0 auto 0 auto !important;
                padding: 10px 14px 12px 14px !important;
                page-break-after: always;
                break-after: page;
                page-break-inside: avoid;
                break-inside: avoid;
                box-sizing: border-box;
                display: block;
                border: 1px solid #e5e5e5 !important;
                box-shadow: none !important;
                border-radius: 8px !important;
                background: white;
                position: relative;
                min-height: auto;
            }

            .student-report.last-report {
                page-break-after: avoid !important;
                break-after: avoid !important;
            }

            /* Hide watermark img in screen but show in print */
            .print-watermark-img {
                display: block !important;
                position: absolute;
                top: 50%;
                left: 50%;
                transform: translate(-50%, -50%);
                width: 300px;
                height: 300px;
                object-fit: contain;
                opacity: 0.09;
                z-index: 0;
                pointer-events: none;
            }

            .student-report-background {
                page-break-inside: avoid;
                width: 100% !important;
                max-width: 100% !important;
                overflow: visible;
                box-sizing: border-box !important;
            }

            /* Hide non-printable elements */
            .actions, 
            .actions-no-print,
            .print-options-container,
            .student-checkbox,
            hr {
                display: none !important;
                visibility: hidden !important;
            }

            /* Header optimization */
            .header {
                display: grid;
                grid-template-columns: auto 1fr auto;
                align-items: center;
                gap: 14px;
                margin-bottom: 10px;
                padding-bottom: 8px;
                border-bottom: 2px solid var(--primary);
                width: 100%;
            }

            .header img.logo,
            .header img.student-image {
                width: 54px;
                height: 58px;
                object-fit: cover;
                border-radius: 10px;
                flex-shrink: 0;
            }

            .header .logo { justify-self: start; }
            .header .student-image { justify-self: end; }

            .header .school-info {
                text-align: center;
            }

            .header h1 {
                font-size: 18px;
                margin: 2px 0;
                color: var(--primary);
            }

            .header h3 {
                font-size: 12px;
                margin: 1px 0;
            }

            /* Tables full width */
            .info,
            .subjects,
            .attendance-info {
                width: 100% !important;
                max-width: 100% !important;
                box-sizing: border-box !important;
                display: block !important;
                margin-bottom: 10px !important;
            }

            .info table,
            .subjects table,
            .attendance-info table {
                width: 100% !important;
                max-width: 100% !important;
                min-width: 100% !important;
                margin-bottom: 10px;
                font-size: 11px;
                border-collapse: collapse;
                table-layout: auto;
                box-sizing: border-box !important;
                display: table !important;
            }

            .info table tbody,
            .subjects table tbody {
                width: 100% !important;
                display: table-row-group !important;
            }

            .info table tr {
                width: 100% !important;
                display: table-row !important;
            }

            .info table td {
                word-break: break-word;
                box-sizing: border-box !important;
                padding: 5px 6px !important;
                display: table-cell !important;
            }

            .info table td:nth-child(1),
            .info table td:nth-child(3) {
                width: 20% !important;
                font-weight: 600;
                color: #333;
            }

            .info table td:nth-child(2),
            .info table td:nth-child(4) {
                width: 30% !important;
            }

            th, td {
                padding: 5px 4px;
                font-size: 11px;
                border: 1px solid #ddd;
                text-align: left;
            }

            th {
                background-color: var(--org-primary-light);
                color: var(--primary);
                font-weight: 600;
            }

            /* Remarks section optimization */
            .remarks-signature-wrapper {
                display: flex !important;
                flex-direction: row !important;
                align-items: flex-end !important;
                margin-top: 15px;
                padding-top: 12px;
                border-top: 1px solid #e8e8e8;
                gap: 25px;
                width: 100%;
            }

            .remarks-header {
                font-size: 13px;
                margin-bottom: 8px;
            }

            .remarks-header::before {
                width: 3px;
                height: 16px;
            }

            .remark-line {
                margin-bottom: 8px;
                padding-bottom: 0;
                border-bottom: none;
            }

            .remark-line label {
                font-size: 11px;
                min-width: 110px;
                line-height: 18px;
            }

            .remark-line textarea {
                font-size: 12px;
                line-height: 18px;
                height: auto;
                min-height: 18px;
                border-bottom: 1px solid #999;
                padding: 0;
            }

            .remark-arrow,
            .remark-dropdown {
                display: none !important;
            }

            /* Signature section */
            .signature-info {
                width: 150px;
                min-width: 150px;
                padding: 0;
                background: transparent;
                border: none;
            }

            .signature-title {
                font-size: 12px;
                margin-bottom: 8px;
            }

            .signature-info img {
                max-width: 110px;
                margin-bottom: 6px;
            }

            .signature-info h3 {
                font-size: 10px;
                padding-top: 5px;
                border-top: 1.5px solid #333;
            }

            /* Promotion row — plain text in print */
            .promotion-table select {
                font-size: 11px;
                pointer-events: none;
                color: #333;
            }
            .promotion-chevron {
                display: none;
            }

            /* Grade interpretation */
            .grade-interpretation {
                border: 2px solid var(--primary);
                font-size: 10px;
                width: 100%;
                max-width: 100%;
                margin: 12px 0 0 0;
                padding: 8px;
                line-height: 1.5;
                page-break-inside: avoid;
                background-color: var(--org-primary-light);
                border-radius: 6px;
                position: static;
                top: 0;
            }

            .grade-interpretation h6 {
                font-size: 12px;
                margin: 2px 0 6px 0;
                color: var(--primary);
            }

            .grade-interpretation-item {
                font-size: 10px;
                margin: 0 5px;
            }

            .report-card-footer {
                margin-top: 10px;
                padding-top: 6px;
            }

            /* Prevent orphan page breaks */
            .subjects table {
                page-break-inside: auto;
            }

            .subjects table tr {
                page-break-inside: avoid;
                page-break-after: auto;
            }

            .subjects thead {
                display: table-header-group;
            }

            .subjects tbody tr {
                page-break-inside: avoid;
            }
        }
        @media screen and (max-width: 768px) {
    .header {
        flex-direction: column;
        text-align: center;
    }

    .student-report {
        width: 100%;
        padding: 12px;
        margin: 5px auto 30px auto;
        box-sizing: border-box;
    }

    .header img.logo,
    .header img.student-image {
        width: 48px;
        height: 52px;
    }

    .header h1 {
        font-size: 15px;
    }

    .header h2 {
        font-size: 13px;
    }

    .header h3 {
        font-size: 11px;
    }

    .info table, 
    .subjects table,
    .promotion-table {
        overflow-x: auto;
        display: block;
        -webkit-overflow-scrolling: touch;
    }

    th, td {
        font-size: 11px;
        padding: 5px 4px;
    }

    .remarks-signature-wrapper {
        flex-direction: column;
        gap: 16px;
    }

    .signature-info {
        width: 100%;
        min-width: unset;
        align-items: center;
    }

    .remark-line label {
        min-width: 100px;
        font-size: 12px;
    }

    .remark-line textarea {
        font-size: 12px;
    }

    .grade-interpretation {
        max-width: 100%;
        font-size: 10px;
    }
}

@media (max-width: 480px) {
    .student-report {
        padding: 8px;
        border-radius: 6px;
        margin: 5px auto 20px auto;
    }

    .header {
        gap: 8px;
        padding-bottom: 8px;
        margin-bottom: 8px;
    }

    .header img.logo,
    .header img.student-image {
        width: 40px;
        height: 44px;
    }

    .header h1 {
        font-size: 13px;
    }

    .header h2 {
        font-size: 11px;
    }

    th, td {
        font-size: 10px;
        padding: 4px 3px;
    }

    .remarks-header {
        font-size: 12px;
    }

    .remark-line label {
        min-width: 80px;
        font-size: 11px;
    }

    .remark-line textarea {
        font-size: 11px;
    }

    .signature-info img {
        max-width: 100px;
    }

    .signature-info h3 {
        font-size: 9px;
    }

    .grade-interpretation {
        font-size: 9px;
    }
}

