      <hr>
       
      
      

    <% if (students.length === 0) { %>
        <p>No students found for this class.</p>
    <% } else { %>
        <% students.forEach((student, studentIndex) => { %>
            <% const reportStudentDisplayName = student.display_name || (typeof formatDisplayName === 'function' ? formatDisplayName(student) : [student.first_name, student.last_name].filter(Boolean).join(' ').trim()); %>
            <div class="student-report-grid">
            <div class="student-report <%= studentIndex === students.length - 1 ? 'last-report' : '' %>" id="report-<%= student.student_id %>" data-student-id="<%= student.student_id %>" data-student-name="<%= reportStudentDisplayName %>">
                <input type="checkbox" class="student-checkbox" onchange="updateSelectedCount()" data-student-id="<%= student.student_id %>">
            <div class="student-report-background">
                    <% if (session.logo) { %>
                        <img src="<%= session.logo %>" alt="" class="print-watermark-img">
                    <% } %>
                    <div class="header">
                        <% if (session.logo) { %>
                            <img src="<%= session.logo %>" alt="Organization Logo" class="logo" />
                        <% } else { %>
                            <img src="/images/default_logo.png" alt="Default Logo" class="logo" />
                        <% } %>

                        <div class="school-info">
                            <h1><%= orgName %></h1>
                            <h3><%= orgAddress %><% if (orgCountry || orgProvince) { %>, <%= [orgProvince, orgCountry].filter(Boolean).join(', ') %><% } %></h3>
                            <h3><%= email %> | <%= orgPhone %></h3>
                        </div>

                        <% if (student.image_url && student.image_url !== 'profilePlaceholder.png') { %>
                            <img src="<%= student.image_url %>?v=<%= new Date().getTime() %>" alt="Student Image" class="student-image">
                        <% } else { %>
                            <img src="/images/profilePlaceholder.png" alt="Placeholder Image" class="student-image">
                        <% } %>
                    </div>

                    <div class="info">
                        <table>
                            <tr>
                                <td>Student Name:</td>
                                <td><%= reportStudentDisplayName %></td>
                                <td>Term:</td>
                                <td><%= term ? term.term_name : 'No term available' %></td>
                            </tr>
                            <tr>
                                <td>Student ID:</td>
                                <td><%= student.display_student_id || student.student_id %></td>
                                <td>School Year:</td>
                                <td><%= schoolYearLabel %></td>
                            </tr>
                            <tr>
                                <td>Class:</td>
                                <td><%= student.class_name %></td>
                                <td>Position in Class:</td>
                                <td><%= student.positionInClass %></td>
                            </tr>
                        </table>
                    </div>

                    <div class="subjects">
                        <table>
                            <thead>
                                <tr>
                                    <th>Subject</th>
                                    <% if (displaySettings.columns.classScore) { %><th>Class Score</th><% } %>
                                    <% if (displaySettings.columns.examsScore) { %><th>Exams Score</th><% } %>
                                    <% if (displaySettings.columns.otherScore) { %><th>Other Score</th><% } %>
                                    <% if (displaySettings.columns.totalScore) { %><th>Total Score</th><% } %>
                                    <% if (displaySettings.columns.scaledScore) { %><th>Scaled Score</th><% } %>
                                    <% if (displaySettings.columns.totalPercentage) { %><th>Total Percentage</th><% } %>
                                    <% if (displaySettings.columns.grade) { %><th>Grade</th><% } %>
                                    <% if (displaySettings.columns.position) { %><th>Position</th><% } %>
                                    <% if (displaySettings.columns.remarksCol) { %><th>Remarks</th><% } %>
                                </tr>
                            </thead>
                            <tbody>
                                <% (student.subjects || []).forEach(subject => { %>
                                    <tr>
                                        <td><%= subject.subject_name %></td>
                                        <% if (displaySettings.columns.classScore) { %><td><%= subject.classAssessmentScore || '-' %></td><% } %>
                                        <% if (displaySettings.columns.examsScore) { %><td><%= subject.examsAssessmentScore || '-' %></td><% } %>
                                        <% if (displaySettings.columns.otherScore) { %><td><%= subject.otherAssessmentScore || '-' %></td><% } %>
                                        <% if (displaySettings.columns.totalScore) { %><td><%= subject.totalScore || '-' %></td><% } %>
                                        <% if (displaySettings.columns.scaledScore) { %><td><%= subject.scaledScore || '-' %></td><% } %>
                                        <% if (displaySettings.columns.totalPercentage) { %><td><%= subject.totalPercentage || '-' %></td><% } %>
                                        <% if (displaySettings.columns.grade) { %><td><%= subject.grade || '-' %></td><% } %>
                                        <% if (displaySettings.columns.position) { %><td><%= subject.position || '-' %></td><% } %>
                                        <% if (displaySettings.columns.remarksCol) { %><td><%= subject.remarks || '-' %></td><% } %>
                                    </tr>
                                <% }); %>
                            </tbody>
                        </table>
                    </div>

                    <% const showGradeTotalRow = displaySettings.sections.gradePresentation && displaySettings.sections.gradePresentation.showNumberTotalOnReport; %>
                    <% const showPromotionRow = activatePromotion && displaySettings.sections.promotion; %>

                                        <% if (displaySettings.sections.attendance) { %>
                    <div class="attendance-info">
                        <table class="promotion-table">
                            <tr>
                                                                <td>Overall % | Score:</td>
                                                                <td>
                                                                    <%= student.overallPercentage %> %
                                                                    <span style="font-weight:600;color:#475569;">
                                                                        |
                                                                        <%= Number.isFinite(Number(student.totalScoreSum)) ? Number(student.totalScoreSum).toFixed(2) : '0.00' %>
                                                                        <% if (Number.isFinite(Number(student.totalMaxScoreSum))) { %>
                                                                            /<%= Number(student.totalMaxScoreSum).toFixed(2) %>
                                                                        <% } %>
                                                                    </span>
                                                                </td>
                                <td>Attendance:</td>
                                                                <td>
                                                                    <% if (displaySettings.sections.turnOffAutoAttendance) { %>
                                                                        <% const manualAttendanceOutOf = Number.isFinite(Number(displaySettings.sections.manualAttendanceOutOf)) && Number(displaySettings.sections.manualAttendanceOutOf) > 0 ? Number(displaySettings.sections.manualAttendanceOutOf) : null; %>
                                                                        <input
                                                                            type="number"
                                                                            min="0"
                                                                            class="attendance-manual-input"
                                                                            id="manualAttendance-<%= student.student_id %>"
                                                                            value="<%= student.manualAttendancePresentDays !== null && student.manualAttendancePresentDays !== undefined ? student.manualAttendancePresentDays : '' %>"
                                                                        />
                                                                        <% if (manualAttendanceOutOf !== null) { %>
                                                                          /<%= manualAttendanceOutOf %>
                                                                        <% } %>
                                                                    <% } else { %>
                                                                        <%= student.attendance.presentDays %>/<%= student.attendance.totalDays %>
                                                                    <% } %>
                                                                </td>
                                <td>Vacation Date:</td>
                                <td><%= termEndDate %></td>
                                <td>School Reopens:</td>
                                <td>
                                  <% 
                                    const parsedReopenDate = new Date(schoolReopenDate);
                                                                        const formattedReopenDate = !isNaN(parsedReopenDate) ? (typeof formatDisplayDate === 'function' ? formatDisplayDate(parsedReopenDate) : parsedReopenDate.toLocaleDateString()) : schoolReopenDate;
                                  %>
                                  <%= formattedReopenDate %>
                                </td>
                                                            </tr>
                            <% if (showGradeTotalRow && showPromotionRow) { %>
                                <tr>
                                    <td>Total Grade Score:</td>
                                    <td><%= Number.isFinite(Number(student.totalGradeNumericScore)) ? Number(student.totalGradeNumericScore) : '-' %></td>
                                    <td>
                                        <span class="promotion-select-wrapper">
                                            <select name="promotionStatus-<%= student.student_id %>" id="promotionStatus-<%= student.student_id %>" onchange="updateClass('<%= student.student_id %>')">
                                                <option value="Promoted" <%= student.promotionStatus === 'Promoted' ? 'selected' : '' %>>Promoted To:</option>
                                                <option value="Repeated" <%= student.promotionStatus === 'Repeated' ? 'selected' : '' %>>Repeated In:</option>
                                            </select>
                                            <span class="promotion-chevron">&#9662;</span>
                                        </span>
                                    </td>
                                    <td id="promotionClass-<%= student.student_id %>" data-class-id="<%= student.promotionClassId || '' %>"><%= student.promotionClass %></td>
                                    <td colspan="4"></td>
                                </tr>
                            <% } else { %>
                                <% if (showGradeTotalRow) { %>
                                    <tr>
                                        <td>Total Grade Score:</td>
                                        <td><%= Number.isFinite(Number(student.totalGradeNumericScore)) ? Number(student.totalGradeNumericScore) : '-' %></td>
                                        <td colspan="6"></td>
                                    </tr>
                                <% } %>
                                <% if (showPromotionRow) { %>
                                    <tr>
                                        <td>
                                            <span class="promotion-select-wrapper">
                                                <select name="promotionStatus-<%= student.student_id %>" id="promotionStatus-<%= student.student_id %>" onchange="updateClass('<%= student.student_id %>')">
                                                    <option value="Promoted" <%= student.promotionStatus === 'Promoted' ? 'selected' : '' %>>Promoted To:</option>
                                                    <option value="Repeated" <%= student.promotionStatus === 'Repeated' ? 'selected' : '' %>>Repeated In:</option>
                                                </select>
                                                <span class="promotion-chevron">&#9662;</span>
                                            </span>
                                        </td>
                                        <td id="promotionClass-<%= student.student_id %>" data-class-id="<%= student.promotionClassId || '' %>"><%= student.promotionClass %></td>
                                    </tr>
                                <% } %>
                            <% } %>
                        </table>
                    </div>
                    <% } %>

                    <% if (!displaySettings.sections.attendance && showGradeTotalRow) { %>
                    <div class="attendance-info">
                        <table class="promotion-table">
                            <tr>
                                <td>Total Grade Score:</td>
                                <td><%= Number.isFinite(Number(student.totalGradeNumericScore)) ? Number(student.totalGradeNumericScore) : '-' %></td>
                                <td colspan="6"></td>
                            </tr>
                        </table>
                    </div>
                    <% } %>

                                        <% const enabledCustomRemarkTypes = (customRemarkTypes || []).filter((entry) => {
                                                 const typeKey = String(entry.type_key || '');
                                                 return typeKey && ((displaySettings.sections.customRemarksVisibility || {})[typeKey] !== false);
                                             }); %>
                                        <% if (displaySettings.sections.conductRemarks || displaySettings.sections.attitudeRemarks || displaySettings.sections.interestRemarks || displaySettings.sections.teacherRemarks || enabledCustomRemarkTypes.length) { %>
                    <div class="remarks-signature-wrapper">
                        <!-- Remarks Section -->
                        <div class="remarks">
                            <h4 class="remarks-header">Academic Remarks</h4>
                            <div class="remarks-container">
                                                                <% const remarkRows = [
                                                                    ...(displaySettings.sections.conductRemarks  ? [{
                                                                        rowKey: 'conductRemarks',
                                                                        label: 'Conduct',
                                                                        value: student.conductRemarks || '',
                                                                        options: remarks.conduct || [],
                                                                        customTypeKey: null,
                                                                    }]  : []),
                                                                    ...(displaySettings.sections.attitudeRemarks ? [{
                                                                        rowKey: 'attitudeRemarks',
                                                                        label: 'Attitude',
                                                                        value: student.attitudeRemarks || '',
                                                                        options: remarks.attitude || [],
                                                                        customTypeKey: null,
                                                                    }] : []),
                                                                    ...(displaySettings.sections.interestRemarks ? [{
                                                                        rowKey: 'interestRemarks',
                                                                        label: 'Interest',
                                                                        value: student.interestRemarks || '',
                                                                        options: remarks.interest || [],
                                                                        customTypeKey: null,
                                                                    }] : []),
                                                                    ...(displaySettings.sections.teacherRemarks  ? [{
                                                                        rowKey: 'teacherRemarks',
                                                                        label: 'Teacher',
                                                                        value: student.teacherRemarks || '',
                                                                        options: remarks.teacher || [],
                                                                        customTypeKey: null,
                                                                    }]  : []),
                                                                    ...enabledCustomRemarkTypes.map((entry) => {
                                                                        const typeKey = String(entry.type_key || '');
                                                                        const safeKey = typeKey.replace(/[^a-z0-9]+/gi, '_');
                                                                        const customValues = (student.customRemarks && typeof student.customRemarks === 'object') ? student.customRemarks : {};
                                                                        return {
                                                                            rowKey: `customRemark_${safeKey}`,
                                                                            label: entry.label || 'Custom',
                                                                            value: customValues[typeKey] || '',
                                                                            options: ((remarks.custom || {})[typeKey] || []),
                                                                            customTypeKey: typeKey,
                                                                        };
                                                                    }),
                                                                ]; %>

                                                                <% remarkRows.forEach((remarkRow) => { %>
                                    <div class="remark-line">
                                                                                <label for="<%= remarkRow.rowKey %>-<%= student.student_id %>">
                                                                                        <%= remarkRow.label %>

                                                                                        <span class="remark-arrow" id="arrow-<%= remarkRow.rowKey %>-<%= student.student_id %>" 
                                                                                                onclick="toggleDropdown('<%= remarkRow.rowKey %>', <%= student.student_id %>)">
                                              ▼
                                          </span>
                                        </label>
                                        
                                                                                <textarea id="<%= remarkRow.rowKey %>-<%= student.student_id %>" 
                                                                                                    name="<%= remarkRow.rowKey %>-<%= student.student_id %>"
                                                                                                    data-custom-remark-type="<%= remarkRow.customTypeKey || '' %>"
                                                  maxlength="150"
                                                                                                    onfocus="this.select();"><%= remarkRow.value || '' %></textarea>
                                                                         
                                        
                                                                                <div class="remark-dropdown" id="dropdown-<%= remarkRow.rowKey %>-<%= student.student_id %>">
                                                                                        <% (remarkRow.options || []).forEach(function (remark) { %>
                                                <div class="remark-dropdown-option" 
                                                                                                         onclick="selectRemark('<%= remarkRow.rowKey %>', <%= student.student_id %>, '<%= remark.remark %>')">
                                                    <%= remark.remark %>
                                                </div>
                                            <% }); %>
                                        </div>
                                    </div>
                                <% }); %>
                                
                            </div>
                        </div>
                    
                        <!-- Signature Section -->
                        <div class="signature-info">
                            <div class="signature-title"><%= signatureTitle || "Authorized Signature" %></div>
                            <% if (signatureImageUrl) { %>
                                <img src="<%= signatureImageUrl %>" alt="Signature Image">
                            <% } else { %>
                                <p style="font-size: 11px; color: #999; margin: 20px 0;">No signature</p>
                            <% } %>
                            <h3><%= signatureName || "Authorized" %></h3>
                        </div>
                    </div>
                    <% } %>
                    
                    <% if (displaySettings.sections.gradeKey && scoreRemarks && scoreRemarks.length > 0) { %>
                    <div class="grade-interpretation">
                        <h6>Interpretation of Grades:</h6>
                        <div class="grade-interpretation-content">
                            <% const sortedScoreRemarks = [...scoreRemarks].sort(function (a, b) {
                                const aTo = Number(a.toPercentage || a.to_percentage || 0);
                                const bTo = Number(b.toPercentage || b.to_percentage || 0);
                                if (bTo !== aTo) return bTo - aTo;
                                return Number(b.fromPercentage || b.from_percentage || 0) - Number(a.fromPercentage || a.from_percentage || 0);
                            }); %>
                            <% sortedScoreRemarks.forEach(function (remark) { %>
                                <span class="grade-interpretation-item"><%= remark.gradeLabel || '-' %> (<%= remark.fromPercentage %> to <%= remark.toPercentage %>) = <%= remark.remark || '-' %></span>
                            <% }); %>
                        </div>
                    </div>
                    <% } %>

                    <% if (displaySettings.sections.paygiraBills && displaySettings.sections.paygiraBills.enabled) { %>
                        <div class="paygira-print-block">
                            <div class="paygira-block-head">
                                <h5 style="margin:0;color:var(--primary);font-size:12px;">Billing</h5>
                                <% if (displaySettings.sections.paygiraBills.mode === 'manual') { %>
                                    <button type="button" class="paygira-edit-btn" data-student-id="<%= student.student_id %>" aria-label="Edit billing" title="Edit billing">✎</button>
                                <% } %>
                            </div>
                            <% const manualMode = displaySettings.sections.paygiraBills.mode === 'manual'; %>
                            <% const paygiraManualFields = manualMode && Array.isArray(student.paygiraManualResolvedFields) ? student.paygiraManualResolvedFields : []; %>
                            <% const paygiraManualTotals = manualMode && Array.isArray(student.paygiraManualTotalsRows) ? student.paygiraManualTotalsRows : []; %>
                            <% const useTotalsColumns = manualMode && paygiraManualTotals.length > 0; %>
                            <table>
                                <thead>
                                    <% if (useTotalsColumns) { %>
                                        <tr>
                                            <th>Item</th>
                                            <% paygiraManualTotals.forEach((totalCol) => { %>
                                                <th style="color:var(--primary);"><%= totalCol.label %></th>
                                            <% }); %>
                                        </tr>
                                    <% } else { %>
                                        <tr><th>Item</th><th>Value</th></tr>
                                    <% } %>
                                </thead>
                                <tbody>
                                    <% if (!manualMode) { %>
                                        <% if (displaySettings.sections.paygiraBills.auto && displaySettings.sections.paygiraBills.auto.scope === 'future') { %>
                                            <% const futureCfg = displaySettings.sections.paygiraBills.auto.future || {}; %>
                                            <% if (futureCfg.action === 'custom' && futureCfg.billName) { %>
                                                <tr>
                                                    <td>Future Bill</td>
                                                    <td><%= futureCfg.billName %></td>
                                                </tr>
                                            <% } else { %>
                                                <tr>
                                                    <td>Future Bill</td>
                                                    <td>
                                                        <a href="<%= futureCfg.createLink || '/account/settings/finance' %>" target="_blank" rel="noopener noreferrer" style="color:var(--primary);font-weight:600;text-decoration:underline;">Create Bill</a>
                                                    </td>
                                                </tr>
                                            <% } %>
                                        <% } else { %>
                                            <% (student.paygiraAutoRows || []).forEach((row) => { %>
                                                <tr>
                                                    <td><%= row.label %></td>
                                                    <td><%= row.value %></td>
                                                </tr>
                                            <% }); %>
                                            <% if (!student.paygiraAutoRows || student.paygiraAutoRows.length === 0) { %>
                                                <tr><td colspan="2" style="color:#64748b;">No Paygira metrics selected.</td></tr>
                                            <% } %>
                                        <% } %>
                                    <% } else if (useTotalsColumns) { %>
                                        <% paygiraManualFields.forEach((field) => { %>
                                            <% const displayValue = (field.value === undefined || field.value === null || field.value === '') ? '-' : String(field.value); %>
                                            <tr>
                                                <td><%= field.label %></td>
                                                <% paygiraManualTotals.forEach((totalCol) => { %>
                                                    <% const selected = Array.isArray(totalCol.fieldKeys) ? totalCol.fieldKeys : []; %>
                                                    <% const explicitTotalMatch = field.totalKey && field.totalKey === totalCol.key; %>
                                                    <% const belongsToTotal = explicitTotalMatch || selected.includes(field.key); %>
                                                    <td><%= belongsToTotal ? displayValue : '' %></td>
                                                <% }); %>
                                            </tr>
                                        <% }); %>
                                        <tr class="paygira-total-row-emphasis">
                                            <td>TOTAL</td>
                                            <% paygiraManualTotals.forEach((totalCol) => { %>
                                                <td><%= totalCol.value %></td>
                                            <% }); %>
                                        </tr>
                                        <% if (paygiraManualFields.length === 0) { %>
                                            <tr><td colspan="<%= paygiraManualTotals.length + 1 %>" style="color:#64748b;">No manual fields configured.</td></tr>
                                        <% } %>
                                    <% } else { %>
                                        <% paygiraManualFields.forEach((field) => { %>
                                            <% const displayValue = (field.value === undefined || field.value === null || field.value === '') ? '-' : field.value; %>
                                            <tr>
                                                <td><%= field.label %></td>
                                                <td><%= displayValue %></td>
                                            </tr>
                                        <% }); %>
                                        <% if (paygiraManualFields.length === 0) { %>
                                            <tr><td colspan="2" style="color:#64748b;">No manual fields configured.</td></tr>
                                        <% } %>
                                    <% } %>
                                </tbody>
                            </table>
                        </div>
                    <% } %>

                    <div class="report-card-footer">
                        <div class="report-card-footer-left">
                            <% if (hasSchoolWebsite && schoolWebsiteHost) { %>
                                School Website: <%= schoolWebsiteHost %>
                            <% } %>
                        </div>
                        <div class="report-card-footer-right">
                            <%= orgName %> @<%= reportYear %> all rights reserved
                        </div>
                    </div>
                </div>
            </div>
            </div>
        <% }); %>
    <% } %>

    <div id="paygiraEditModal" class="paygira-edit-modal-overlay" role="dialog" aria-modal="true" aria-labelledby="paygiraEditModalTitle">
        <div class="paygira-edit-modal">
            <div style="display:flex;justify-content:space-between;align-items:center;gap:8px;margin-bottom:10px;">
                <h3 id="paygiraEditModalTitle" style="margin:0;color:var(--primary);font-size:1rem;">Edit Billing</h3>
                <button type="button" id="paygiraEditCloseBtn" class="btn btn-danger" style="padding:6px 10px;font-size:0.78rem;">Close</button>
            </div>

            <div id="paygiraEditRowsWrap"></div>

            <div style="display:flex;gap:8px;align-items:center;flex-wrap:wrap;margin:8px 0 10px;">
                <button type="button" id="paygiraEditAddRowBtn" class="btn" style="padding:6px 10px;font-size:0.78rem;">+ Add Row</button>
            </div>

            <div class="paygira-selector-box">
                <div class="paygira-selector-title">Students</div>
                <label style="display:flex;align-items:center;gap:6px;font-size:0.86rem;margin-bottom:6px;">
                    <input type="checkbox" id="paygiraApplyOnlyCurrentStudent" style="accent-color:var(--primary);" checked>
                    Apply only to this student
                </label>
                <label style="display:flex;align-items:center;gap:6px;font-size:0.86rem;margin-bottom:6px;">
                    <input type="checkbox" id="paygiraApplyAllStudents" style="accent-color:var(--primary);">
                    All students
                </label>
                <div id="paygiraStudentSelector" class="paygira-selector-grid"></div>
            </div>

            <div class="paygira-selector-box">
                <div class="paygira-selector-title">Classes</div>
                <label style="display:flex;align-items:center;gap:6px;font-size:0.86rem;margin-bottom:6px;">
                    <input type="checkbox" id="paygiraApplyAllClasses" style="accent-color:var(--primary);">
                    All classes
                </label>
                <div id="paygiraClassSelector" class="paygira-selector-grid"></div>
            </div>

            <div style="display:flex;gap:8px;align-items:center;">
                <button type="button" id="paygiraEditSaveBtn" class="btn" style="padding:7px 14px;font-size:0.82rem;">Save Changes</button>
                <span id="paygiraEditStatus" style="font-size:0.82rem;color:var(--muted);"></span>
            </div>
        </div>
    </div>

    <script>
        let isPrintSelectionInProgress = false;
        let reportVisibilityMode = 'default'; // default | search | selected | print
        let hasUserAppliedSearchFilter = false;
        let isSearchUserActivated = false;
        let lastSearchUserIntentAt = 0;
        let searchAutofillGuardInterval = null;
        let visibilityGuardInterval = null;
        const isBillingManualMode = <%- JSON.stringify(displaySettings.sections.paygiraBills && displaySettings.sections.paygiraBills.enabled && displaySettings.sections.paygiraBills.mode === 'manual') %>;
        const billingRowsByStudent = <%- JSON.stringify(paygiraManualResolvedByStudent || {}) %>;
        const billingTotalsColumns = <%- JSON.stringify(
            ((displaySettings?.sections?.paygiraBills?.manual?.totals || [])
                .filter((total) => total && total.showOnReport !== false)
                .map((total) => ({
                    key: String(total.key || '').trim(),
                    label: String(total.label || '').trim(),
                    fieldKeys: Array.isArray(total.fieldKeys) ? total.fieldKeys : [],
                })))
        ) %>;
        const billingStudentOptions = <%- JSON.stringify(reportStudentOptions || []) %>;
        const billingClassOptions = <%- JSON.stringify(reportClassOptions || []) %>;
        const currentBillingClassId = <%- JSON.stringify(Number(classId)) %>;
        let activeBillingEditStudentId = null;
        let billingDraftDirty = false;

        function getBillingEditElements() {
            return {
                modal: document.getElementById('paygiraEditModal'),
                rowsWrap: document.getElementById('paygiraEditRowsWrap'),
                status: document.getElementById('paygiraEditStatus'),
                applyOnlyCurrentStudent: document.getElementById('paygiraApplyOnlyCurrentStudent'),
                applyAllStudents: document.getElementById('paygiraApplyAllStudents'),
                applyAllClasses: document.getElementById('paygiraApplyAllClasses'),
                studentSelector: document.getElementById('paygiraStudentSelector'),
                classSelector: document.getElementById('paygiraClassSelector'),
                saveBtn: document.getElementById('paygiraEditSaveBtn'),
                closeBtn: document.getElementById('paygiraEditCloseBtn'),
                addRowBtn: document.getElementById('paygiraEditAddRowBtn'),
            };
        }

        function renderBillingStudentSelector(els) {
            if (!els.studentSelector) return;
            els.studentSelector.innerHTML = billingStudentOptions.map((student) => {
                const sid = Number(student.student_id);
                const checked = String(sid) === String(activeBillingEditStudentId);
                return `<label style="display:flex;align-items:center;gap:6px;font-size:0.84rem;">
                    <input type="checkbox" class="paygira-student-check" value="${sid}" style="accent-color:var(--primary);" ${checked ? 'checked' : ''}>
                    <span>${String(student.name || '').replace(/</g, '&lt;').replace(/>/g, '&gt;')}</span>
                </label>`;
            }).join('');
        }

        function renderBillingClassSelector(els) {
            if (!els.classSelector) return;
            els.classSelector.innerHTML = billingClassOptions.map((cls) => {
                const cid = Number(cls.class_id);
                const checked = cid === Number(currentBillingClassId);
                return `<label style="display:flex;align-items:center;gap:6px;font-size:0.84rem;">
                    <input type="checkbox" class="paygira-class-check" value="${cid}" style="accent-color:var(--primary);" ${checked ? 'checked' : ''}>
                    <span>${String(cls.class_name || '').replace(/</g, '&lt;').replace(/>/g, '&gt;')}${cid === Number(currentBillingClassId) ? ' (current)' : ''}</span>
                </label>`;
            }).join('');
        }

        function syncBillingSelectorState(els) {
            if (!els) return;
            const applyOnlyCurrentStudent = els.applyOnlyCurrentStudent?.checked === true;
            const applyAllStudents = !applyOnlyCurrentStudent && (els.applyAllStudents?.checked === true);
            const studentChecks = Array.from(els.studentSelector?.querySelectorAll('.paygira-student-check') || []);
            const classChecks = Array.from(els.classSelector?.querySelectorAll('.paygira-class-check') || []);

            if (applyOnlyCurrentStudent) {
                studentChecks.forEach((cb) => {
                    cb.checked = String(cb.value) === String(activeBillingEditStudentId);
                    cb.disabled = true;
                });
                if (els.applyAllStudents) {
                    els.applyAllStudents.checked = false;
                }
            } else if (applyAllStudents) {
                studentChecks.forEach((cb) => {
                    cb.checked = true;
                    cb.disabled = true;
                });
            } else {
                studentChecks.forEach((cb) => {
                    cb.disabled = false;
                });
                const selectedCount = studentChecks.filter((cb) => cb.checked).length;
                if (selectedCount === 0) {
                    const currentStudentCb = studentChecks.find((cb) => String(cb.value) === String(activeBillingEditStudentId));
                    if (currentStudentCb) currentStudentCb.checked = true;
                }
            }

            if (!applyAllStudents && els.applyAllClasses) {
                els.applyAllClasses.checked = false;
            }

            const classEnabled = applyAllStudents;
            classChecks.forEach((cb) => {
                if (!classEnabled) {
                    cb.checked = Number(cb.value) === Number(currentBillingClassId);
                }
                cb.disabled = !classEnabled;
            });

            if (classEnabled) {
                const allChecked = classChecks.length > 0 && classChecks.every((cb) => cb.checked);
                if (els.applyAllClasses) {
                    els.applyAllClasses.checked = allChecked;
                    els.applyAllClasses.disabled = false;
                }
            } else if (els.applyAllClasses) {
                els.applyAllClasses.disabled = true;
            }
        }

        function inferBillingTotalKeyForRow(rowData = {}) {
            const rowTotalKey = String(rowData.totalKey || '').trim();
            if (rowTotalKey) return rowTotalKey;
            const rowKey = String(rowData.key || '').trim();
            if (!rowKey) return '';
            const matched = billingTotalsColumns.find((col) => Array.isArray(col.fieldKeys) && col.fieldKeys.includes(rowKey));
            return matched ? String(matched.key || '').trim() : '';
        }

        function buildBillingTotalOptionsHtml(selectedTotalKey = '') {
            const esc = (input) => String(input || '')
                .replace(/&/g, '&amp;')
                .replace(/</g, '&lt;')
                .replace(/>/g, '&gt;')
                .replace(/"/g, '&quot;')
                .replace(/'/g, '&#39;');
            const normalizedSelected = String(selectedTotalKey || '').trim();
            const baseOption = '<option value="">No column</option>';
            const totalOptions = billingTotalsColumns.map((col) => {
                const key = String(col.key || '').trim();
                const label = String(col.label || '').trim() || key;
                return `<option value="${esc(key)}" ${normalizedSelected === key ? 'selected' : ''}>${esc(label)}</option>`;
            }).join('');
            return baseOption + totalOptions;
        }

        function createBillingEditRow(label = '', value = '', rowData = {}) {
            const esc = (input) => String(input || '')
                .replace(/&/g, '&amp;')
                .replace(/</g, '&lt;')
                .replace(/>/g, '&gt;')
                .replace(/"/g, '&quot;')
                .replace(/'/g, '&#39;');
            const selectedTotalKey = inferBillingTotalKeyForRow(rowData);
            const row = document.createElement('div');
            row.className = 'paygira-edit-grid';
            row.innerHTML = `
                <input type="text" class="paygira-edit-label" placeholder="Item name" value="${esc(label)}">
                <input type="text" class="paygira-edit-value" placeholder="Value" value="${esc(value)}">
                <select class="paygira-edit-total" title="Total column">
                    ${buildBillingTotalOptionsHtml(selectedTotalKey)}
                </select>
                <button type="button" class="btn btn-danger paygira-edit-remove" style="padding:6px 8px;font-size:0.74rem;">Remove</button>
            `;
            row.querySelector('.paygira-edit-label')?.addEventListener('input', () => { billingDraftDirty = true; });
            row.querySelector('.paygira-edit-value')?.addEventListener('input', () => { billingDraftDirty = true; });
            row.querySelector('.paygira-edit-total')?.addEventListener('change', () => { billingDraftDirty = true; });
            row.querySelector('.paygira-edit-remove')?.addEventListener('click', () => {
                billingDraftDirty = true;
                row.remove();
            });
            return row;
        }

        function openBillingEditModal(studentId) {
            if (!isBillingManualMode) return;
            const els = getBillingEditElements();
            if (!els.modal || !els.rowsWrap) return;
            activeBillingEditStudentId = String(studentId);
            const rows = Array.isArray(billingRowsByStudent[activeBillingEditStudentId]) ? billingRowsByStudent[activeBillingEditStudentId] : [];
            els.rowsWrap.innerHTML = '';
            if (rows.length === 0) {
                els.rowsWrap.appendChild(createBillingEditRow('', '', {}));
            } else {
                rows.forEach((entry) => {
                    els.rowsWrap.appendChild(createBillingEditRow(entry.label || '', entry.value || '', entry));
                });
            }
            if (els.status) els.status.textContent = '';
            if (els.applyOnlyCurrentStudent) els.applyOnlyCurrentStudent.checked = true;
            if (els.applyAllStudents) els.applyAllStudents.checked = false;
            if (els.applyAllClasses) els.applyAllClasses.checked = false;
            renderBillingStudentSelector(els);
            renderBillingClassSelector(els);
            syncBillingSelectorState(els);
            billingDraftDirty = false;
            els.modal.style.display = 'flex';
        }

        function closeBillingEditModal() {
            const els = getBillingEditElements();
            if (!els.modal) return;
            els.modal.style.display = 'none';
        }

        async function saveBillingOverrides(options = {}) {
            const { reloadOnSuccess = true } = options;
            const els = getBillingEditElements();
            if (!els.rowsWrap || !els.saveBtn || !activeBillingEditStudentId) return false;
            const rows = Array.from(els.rowsWrap.querySelectorAll('.paygira-edit-grid')).map((row, index) => {
                const label = row.querySelector('.paygira-edit-label')?.value?.trim() || '';
                const value = row.querySelector('.paygira-edit-value')?.value?.trim() || '';
                const totalKey = row.querySelector('.paygira-edit-total')?.value?.trim() || '';
                if (!label) return null;
                const key = label.toLowerCase().replace(/[^a-z0-9]+/g, '_').replace(/^_+|_+$/g, '') || `field_${index + 1}`;
                return { key, label, value, totalKey };
            }).filter(Boolean);

            if (!rows.length) {
                if (els.status) els.status.textContent = 'Add at least one row before saving.';
                return false;
            }

            const applyOnlyCurrentStudent = els.applyOnlyCurrentStudent?.checked === true;
            const applyToAllStudents = !applyOnlyCurrentStudent && (els.applyAllStudents?.checked === true);
            const applyToAllClasses = applyToAllStudents && (els.applyAllClasses?.checked === true);
            const selectedStudentIds = applyOnlyCurrentStudent
                ? [parseInt(activeBillingEditStudentId, 10)].filter((id) => Number.isFinite(id))
                : Array.from(els.studentSelector?.querySelectorAll('.paygira-student-check:checked') || []).map((cb) => parseInt(cb.value, 10)).filter((id) => Number.isFinite(id));
            const selectedClassIds = Array.from(els.classSelector?.querySelectorAll('.paygira-class-check:checked') || []).map((cb) => parseInt(cb.value, 10)).filter((id) => Number.isFinite(id));

            if (!applyToAllStudents && selectedStudentIds.length === 0) {
                if (els.status) els.status.textContent = 'Select at least one student.';
                return false;
            }

            els.saveBtn.disabled = true;
            if (els.status) els.status.textContent = 'Saving...';

            try {
                const response = await fetch(`/print/savePaygiraReportOverrides?classId=<%= classId %>&termId=<%= termId %>`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        studentId: parseInt(activeBillingEditStudentId, 10),
                        fields: rows,
                        applyToAllStudents: applyToAllStudents,
                        applyToAllClasses: applyToAllClasses,
                        selectedStudentIds: selectedStudentIds,
                        selectedClassIds: selectedClassIds,
                    }),
                });
                const result = await response.json();
                if (!response.ok || !result.success) {
                    throw new Error(result.error || 'Failed to save');
                }
                billingDraftDirty = false;
                if (els.status) els.status.textContent = 'Saved. Refreshing...';
                if (reloadOnSuccess) {
                    window.location.reload();
                }
                return true;
            } catch (error) {
                if (els.status) els.status.textContent = error.message || 'Failed to save changes.';
                return false;
            } finally {
                els.saveBtn.disabled = false;
            }
        }

        function updateReportVisibilityModeFromSearch() {
            const searchInput = document.getElementById('studentSearch');
            const hasSearch = !!(searchInput && searchInput.value.trim());
            reportVisibilityMode = hasSearch ? 'search' : 'default';
        }

        // Student selection and filtering functions
        function toggleSelectAll() {
            const selectAllCheckbox = document.getElementById('selectAllStudents');
            const studentCheckboxes = document.querySelectorAll('.student-checkbox');
            
            studentCheckboxes.forEach(checkbox => {
                if (!checkbox.closest('.student-report').style.display || checkbox.closest('.student-report').style.display !== 'none') {
                    checkbox.checked = selectAllCheckbox.checked;
                    updateReportSelection(checkbox);
                }
            });
            
            updateSelectedCount();
        }

        function updateSelectedCount() {
            const checkboxes = document.querySelectorAll('.student-checkbox');
            let selectedCount = 0;
            
            checkboxes.forEach(checkbox => {
                if (checkbox.checked) {
                    selectedCount++;
                    checkbox.closest('.student-report').classList.add('selected');
                } else {
                    checkbox.closest('.student-report').classList.remove('selected');
                }
            });
            
            const selectedCountEl = document.getElementById('selectedCount');
            if (selectedCountEl) {
                selectedCountEl.textContent = selectedCount;
            }
        }

        function updateReportSelection(checkbox) {
            const report = checkbox.closest('.student-report');
            if (checkbox.checked) {
                report.classList.add('selected');
            } else {
                report.classList.remove('selected');
            }
        }

        function filterStudents(source = 'user-input') {
            const searchTerm = document.getElementById('studentSearch').value.toLowerCase();
            const studentReports = document.querySelectorAll('.student-report');
            let visibleCount = 0;

            if (searchTerm.trim()) {
                hasUserAppliedSearchFilter = (source === 'user-input' || source === 'keyboard-search') || hasUserAppliedSearchFilter;
            } else {
                hasUserAppliedSearchFilter = false;
            }

            reportVisibilityMode = searchTerm ? 'search' : 'default';
            
            studentReports.forEach(report => {
                const studentName = report.getAttribute('data-student-name').toLowerCase();
                const studentId = report.getAttribute('data-student-id');
                
                if (studentName.includes(searchTerm) || studentId.includes(searchTerm)) {
                    report.style.display = '';
                    visibleCount++;
                } else {
                    report.style.display = 'none';
                }
            });
            
            const totalCountEl = document.getElementById('totalCount');
            if (totalCountEl) {
                totalCountEl.textContent = visibleCount;
            }

        }

        function filterBySelection(type, clickedButton) {
            const studentReports = document.querySelectorAll('.student-report');
            const buttons = document.querySelectorAll('.filter-btn:not(:last-child)');
            let visibleCount = 0;

            reportVisibilityMode = type === 'selected' ? 'selected' : 'default';
            
            // Update button states
            buttons.forEach(btn => btn.classList.remove('active'));
            if (clickedButton) {
                clickedButton.classList.add('active');
            }
            
            studentReports.forEach(report => {
                const checkbox = report.querySelector('.student-checkbox');
                
                if (type === 'all') {
                    report.style.display = '';
                    visibleCount++;
                } else if (type === 'selected' && checkbox.checked) {
                    report.style.display = '';
                    visibleCount++;
                } else if (type === 'selected') {
                    report.style.display = 'none';
                }
            });
        }

        function printSelected() {
            const selectedReports = document.querySelectorAll('.student-checkbox:checked');
            
            if (selectedReports.length === 0) {
                alert('Please select at least one student to print.');
                return;
            }

            const selectedStudentIds = Array.from(selectedReports)
                .map((cb) => parseInt(cb.getAttribute('data-student-id'), 10))
                .filter((id) => Number.isFinite(id) && id > 0);
            const printBatchId = `rprint_${Date.now()}_${Math.random().toString(36).slice(2, 8)}`;

            try {
                fetch('/print/logDeliveryEvent', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    credentials: 'same-origin',
                    keepalive: true,
                    body: JSON.stringify({
                        eventDomain: 'report',
                        eventName: 'report_printed',
                        classId: <%= classId %>,
                        termId: <%= termId %>,
                        studentIds: selectedStudentIds,
                        batchId: printBatchId,
                        status: 'printed',
                        notes: 'Report printed from printStudentReport page.',
                    }),
                }).catch(() => {});
            } catch (_) {
                // Logging should not block printing.
            }
            
            isPrintSelectionInProgress = true;
            reportVisibilityMode = 'print';

            // Hide unchecked reports temporarily
            const allReports = document.querySelectorAll('.student-report');
            allReports.forEach(report => report.classList.remove('temp-last-report'));
            allReports.forEach(report => {
                const checkbox = report.querySelector('.student-checkbox');
                if (!checkbox.checked) {
                    report.setAttribute('data-hidden-for-print', 'true');
                    report.style.display = 'none';
                }
            });

            const visibleSelectedReports = Array.from(allReports).filter((report) => {
                const checkbox = report.querySelector('.student-checkbox');
                return checkbox && checkbox.checked;
            });
            const lastVisibleSelected = visibleSelectedReports[visibleSelectedReports.length - 1];
            if (lastVisibleSelected) {
                lastVisibleSelected.classList.add('temp-last-report');
            }
            
            // Print
            window.print();
            
            // Restore all reports
            allReports.forEach(report => {
                if (report.getAttribute('data-hidden-for-print')) {
                    report.style.display = '';
                    report.removeAttribute('data-hidden-for-print');
                }
                report.classList.remove('temp-last-report');
            });

            isPrintSelectionInProgress = false;
            updateReportVisibilityModeFromSearch();
        }

        function restoreReportsIfUnexpectedlyHidden(source = 'unknown') {
            if (isPrintSelectionInProgress) return;
            if (reportVisibilityMode !== 'default') return;

            const searchInput = document.getElementById('studentSearch');
            const hasSearchFilter = !!(searchInput && searchInput.value.trim());
            if (hasSearchFilter && hasUserAppliedSearchFilter) return;

            // If a non-user value was auto-filled into the search box, clear it to avoid false hidden state.
            if (hasSearchFilter && !hasUserAppliedSearchFilter && searchInput) {
                searchInput.value = '';
                reportVisibilityMode = 'default';
            }

            const allReports = Array.from(document.querySelectorAll('.student-report'));
            if (allReports.length === 0) return;

            // In default mode, every report should be visible. Recover from any accidental hide.
            let recoveredCount = 0;
            allReports.forEach(report => {
                const isInlineHidden = report.style.display === 'none';
                const isComputedHidden = window.getComputedStyle(report).display === 'none';
                if (isInlineHidden || isComputedHidden || report.hidden) {
                    report.style.display = '';
                    report.hidden = false;
                    recoveredCount += 1;
                }
            });

        }

        function initReportVisibilityGuard() {
            const container = document.body;
            if (!container || !('MutationObserver' in window)) return;

            const observer = new MutationObserver((mutations) => {
                if (isPrintSelectionInProgress) return;
                if (reportVisibilityMode !== 'default') return;

                let changed = false;
                for (const mutation of mutations) {
                    if (mutation.type !== 'attributes') continue;
                    const el = mutation.target;
                    if (!el.classList || !el.classList.contains('student-report')) continue;
                    if (el.style.display === 'none' || el.hidden || window.getComputedStyle(el).display === 'none') {
                        el.style.display = '';
                        el.hidden = false;
                        changed = true;
                    }
                }

                if (changed) {
                    restoreReportsIfUnexpectedlyHidden('mutation-observer');
                }
            });

            observer.observe(container, {
                subtree: true,
                attributes: true,
                attributeFilter: ['style', 'class', 'hidden']
            });
        }

        // Close dropdowns when clicking outside
        document.addEventListener('click', function(e) {
            if (!e.target.closest('.remark-line') && !e.target.closest('.remark-dropdown')) {
                document.querySelectorAll('.remark-dropdown').forEach(dropdown => {
                    dropdown.style.display = 'none';
                });
            }

            // Defensive guard: plain clicks should never make every report disappear.
            restoreReportsIfUnexpectedlyHidden('document-click');
        });

        // Extra guard for browsers/extensions that mutate DOM on pointer interactions.
        document.addEventListener('pointerup', function () {
            restoreReportsIfUnexpectedlyHidden('pointerup');
        });
        window.addEventListener('focus', function () {
            restoreReportsIfUnexpectedlyHidden('window-focus');
        });
        document.addEventListener('visibilitychange', function () {
            if (document.visibilityState === 'visible') {
                restoreReportsIfUnexpectedlyHidden('visibilitychange-visible');
            }
        });

        // Reposition dropdowns on scroll
        window.addEventListener('scroll', function() {
            document.querySelectorAll('.remark-dropdown').forEach(dropdown => {
                if (dropdown.style.display === 'block') {
                    dropdown.style.display = 'none';
                }
            });
        });

        document.addEventListener('input', function (e) {
            if (e.target.tagName === 'TEXTAREA') {
                // Reset height to calculate scrollHeight properly
                e.target.style.height = '22px';
                e.target.style.whiteSpace = 'pre-wrap';
                e.target.style.overflowY = 'hidden';
                
                // If content needs more space, expand (max 66px = 3 lines)
                if (e.target.scrollHeight > 22) {
                    const newHeight = Math.min(e.target.scrollHeight, 66);
                    e.target.style.height = newHeight + 'px';
                    e.target.style.overflowY = e.target.scrollHeight > 66 ? 'auto' : 'hidden';
                }
            }
        });
        
        document.addEventListener('DOMContentLoaded', function () {
            document.querySelectorAll('textarea').forEach(function (textarea) {
                // Set initial height to one line
                textarea.style.height = '22px';
                textarea.style.whiteSpace = 'pre-wrap';
