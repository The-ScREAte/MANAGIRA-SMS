}


        // Save changes
        document.getElementById('saveChangesLink').addEventListener('click', async (e) => {
            e.preventDefault(); // prevent link navigation
        
            const studentReports = Array.from(document.querySelectorAll('.student-report')).map((report) => {
              const studentId = report.getAttribute('data-student-id');
              if (!studentId || isNaN(studentId)) {
                console.error('Invalid or missing student ID:', report);
                return null;
              }
        
              // ✅ Get promotion status
              const promotionStatusElement = document.getElementById(`promotionStatus-${studentId}`);
              const promotionStatus = promotionStatusElement ? promotionStatusElement.value.trim() : null;
        
              // ✅ Get class name element (which also holds the class ID if you add data-class-id there)
              const promotionClassCell = document.getElementById(`promotionClass-${studentId}`);
              const promotionClassId = promotionClassCell ? promotionClassCell.getAttribute('data-class-id') : null;
        
              return {
                studentId: parseInt(studentId, 10),
                conductRemarks: document.getElementById(`conductRemarks-${studentId}`).value.trim(),
                attitudeRemarks: document.getElementById(`attitudeRemarks-${studentId}`).value.trim(),
                interestRemarks: document.getElementById(`interestRemarks-${studentId}`).value.trim(),
                teacherRemarks: document.getElementById(`teacherRemarks-${studentId}`).value.trim(),
                promotionStatus,   // ✅ added
                promotionClassId,  // ✅ added (may be null)
              };
            }).filter(Boolean);
        
            if (studentReports.length === 0) {
              alert('No valid reports to save.');
              return;
            }
        
            try {
              const response = await fetch(`/print/saveReportChanges?classId=<%= classId %>&termId=<%= termId %>`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ studentReports }),
              });
        
              if (response.ok) {
                alert('Changes saved successfully.');
              } else {
                alert('Failed to save changes.');
              }
            } catch (error) {
              console.error('Error saving changes:', error);
            }
          });
    // ===== EMAIL MODAL =====
    function openEmailModal() {
        // Unsaved changes warning
        const hasUnsavedChanges = checkForUnsavedChanges();
        if (hasUnsavedChanges) {
            const proceed = confirm('⚠️ WARNING: You may have unsaved changes to the report cards.\n\nPlease ensure all score changes and remarks have been saved before sending emails.\n\nClick OK to continue with email, or Cancel to go back and save.');
            if (!proceed) return;
        }

        const selected = document.querySelectorAll('.student-checkbox:checked');
        if (selected.length === 0) {
            alert('Please select at least one student to email.');
            return;
        }

        // Collect student IDs
        const studentIds = Array.from(selected).map(cb => cb.getAttribute('data-student-id'));

        // Show modal
        document.getElementById('emailModal').style.display = 'flex';
        document.getElementById('emailRecipientCount').textContent = `${selected.length} student${selected.length === 1 ? '' : 's'} selected`;
        document.getElementById('emailStudentList').innerHTML = '<p style="color:#666;">Loading guardian emails...</p>';
        document.getElementById('emailPasswordSection').style.display = 'none';
        document.getElementById('emailSendBtn').style.display = 'none';

        // Fetch guardian emails
        fetch(`/print/getGuardianEmails?classId=<%= classId %>&termId=<%= termId %>&studentIds=${studentIds.join(',')}`)
            .then(r => r.json())
            .then(data => {
                if (!data.success) {
                    document.getElementById('emailStudentList').innerHTML = '<p style="color:red;">Failed to load emails.</p>';
                    return;
                }
                renderEmailList(data.students);
                document.getElementById('emailPasswordSection').style.display = 'block';
                document.getElementById('emailSendBtn').style.display = 'inline-flex';
                
                // Restore from localStorage
                restoreEmailsFromStorage();
            })
            .catch(() => {
                document.getElementById('emailStudentList').innerHTML = '<p style="color:red;">Error fetching emails.</p>';
            });
    }

    // Responsive actions bar toggle (hamburger)
    function toggleActionsMenu() {
        const bar = document.getElementById('actionsBar');
        const btn = document.getElementById('actionsMenuToggle');
        const isCollapsed = bar.classList.toggle('collapsed');
        btn.setAttribute('aria-expanded', (!isCollapsed).toString());
        btn.textContent = isCollapsed ? '☰ Menu' : '✕ Close';
    }

    // Ensure correct initial state on load/resizes for mobile
    function syncActionsMenuState() {
        const bar = document.getElementById('actionsBar');
        const btn = document.getElementById('actionsMenuToggle');
        if (window.innerWidth <= 768) {
            if (!bar.classList.contains('collapsed')) toggleActionsMenu();
        } else {
            if (bar.classList.contains('collapsed')) toggleActionsMenu();
        }
        // keep label consistent after toggle above
        const isCollapsed = bar.classList.contains('collapsed');
        btn.textContent = isCollapsed ? '☰ Menu' : '✕ Close';
        btn.setAttribute('aria-expanded', (!isCollapsed).toString());
    }

    window.addEventListener('resize', () => {
        syncActionsMenuState();
    });

    document.addEventListener('DOMContentLoaded', () => {
        syncActionsMenuState();
        const studentSearchInput = document.getElementById('studentSearch');
        if (studentSearchInput) {
            const forceClearSearchField = () => {
                if (isSearchUserActivated) return;
                studentSearchInput.value = '';
                studentSearchInput.defaultValue = '';
                studentSearchInput.setAttribute('value', '');
                hasUserAppliedSearchFilter = false;
                reportVisibilityMode = 'default';
            };

            const clearNonUserSearchValue = (source) => {
                if (isSearchUserActivated) return;
                if (!studentSearchInput.value.trim()) return;

                studentSearchInput.value = '';
                hasUserAppliedSearchFilter = false;
                reportVisibilityMode = 'default';
                restoreReportsIfUnexpectedlyHidden(`${source}-clear`);
            };

            const markSearchIntent = () => {
                isSearchUserActivated = true;
                lastSearchUserIntentAt = Date.now();
                studentSearchInput.readOnly = false;
            };

            // Reset accidental browser autofill so report visibility remains stable until user searches intentionally.
            forceClearSearchField();
            clearNonUserSearchValue('init');

            // Some browsers repopulate after layout/paint and BFCache restore.
            window.requestAnimationFrame(forceClearSearchField);
            window.setTimeout(forceClearSearchField, 0);
            window.setTimeout(forceClearSearchField, 250);
            window.setTimeout(forceClearSearchField, 1000);

            window.addEventListener('pageshow', function () {
                forceClearSearchField();
            });

            studentSearchInput.addEventListener('pointerdown', markSearchIntent);
            studentSearchInput.addEventListener('keydown', markSearchIntent);
            studentSearchInput.addEventListener('paste', markSearchIntent);

            studentSearchInput.addEventListener('keyup', function () {
                filterStudents('keyboard-search');
            });

            studentSearchInput.addEventListener('input', function () {
                const recentlyIntended = Date.now() - lastSearchUserIntentAt < 2000;
                if (isSearchUserActivated || recentlyIntended) {
                    filterStudents('user-input');
                    return;
                }

                clearNonUserSearchValue('search-input');
            });

            studentSearchInput.addEventListener('blur', function () {
                if (!studentSearchInput.value.trim()) {
                    isSearchUserActivated = false;
                }
            });

            // Keep guarding against delayed autofill until user explicitly activates the search box.
            if (searchAutofillGuardInterval) {
                window.clearInterval(searchAutofillGuardInterval);
            }
            searchAutofillGuardInterval = window.setInterval(() => {
                forceClearSearchField();
                clearNonUserSearchValue('autofill-guard');
                if (isSearchUserActivated) {
                    window.clearInterval(searchAutofillGuardInterval);
                    searchAutofillGuardInterval = null;
                }
            }, 400);
        }

        updateReportVisibilityModeFromSearch();
        initReportVisibilityGuard();

        if (!visibilityGuardInterval) {
            visibilityGuardInterval = window.setInterval(() => {
                restoreReportsIfUnexpectedlyHidden('interval-guard');
            }, 1200);
        }
    });

    // Check for unsaved changes (this is a simple heuristic - can be improved)
    function checkForUnsavedChanges() {
        // Check if any input fields have been modified but not saved
        // You can customize this based on your save mechanism
        const inputs = document.querySelectorAll('input[type="number"], textarea, select');
        let hasModified = false;
        
        inputs.forEach(input => {
            if (input.dataset && input.dataset.originalValue !== undefined) {
                if (input.value !== input.dataset.originalValue) {
                    hasModified = true;
                }
            }
        });
        
        return hasModified;
    }

    // Save email inputs to localStorage
    function saveEmailsToStorage() {
        const emailData = {};
        document.querySelectorAll('.email-student-row').forEach(row => {
            const studentId = row.getAttribute('data-student-id');
            const inputs = row.querySelectorAll('.email-input');
            const emails = Array.from(inputs).map(inp => inp.value.trim()).filter(e => e);
            if (emails.length > 0) {
                emailData[studentId] = emails;
            }
        });
        
        const storageKey = `emailData_class<%= classId %>_term<%= termId %>`;
        localStorage.setItem(storageKey, JSON.stringify(emailData));
    }

    // Restore email inputs from localStorage
    function restoreEmailsFromStorage() {
        const storageKey = `emailData_class<%= classId %>_term<%= termId %>`;
        const saved = localStorage.getItem(storageKey);
        
        if (!saved) return;
        
        try {
            const emailData = JSON.parse(saved);
            
            document.querySelectorAll('.email-student-row').forEach(row => {
                const studentId = row.getAttribute('data-student-id');
                if (emailData[studentId]) {
                    const inputs = row.querySelectorAll('.email-input');
                    emailData[studentId].forEach((email, index) => {
                        if (inputs[index]) {
                            inputs[index].value = email;
                        }
                    });
                }
            });
        } catch (e) {
            console.error('Failed to restore emails from storage:', e);
        }
    }

    // Clear email storage after successful send
    function clearEmailStorage() {
        const storageKey = `emailData_class<%= classId %>_term<%= termId %>`;
        localStorage.removeItem(storageKey);
    }

    function renderEmailList(students) {
        const container = document.getElementById('emailStudentList');
        if (!students || students.length === 0) {
            container.innerHTML = '<p style="color:#999;">No students selected yet.</p>';
            return;
        }

        document.getElementById('emailRecipientCount').textContent = `${students.length} student${students.length === 1 ? '' : 's'} selected (guardian emails pre-filled)`;

        let html = '';
        students.forEach(s => {
            const uniqueEmails = [];
            (s.emails || []).forEach(e => {
                const email = (e.email || '').trim();
                if (email && !uniqueEmails.some(x => x.email.toLowerCase() === email.toLowerCase())) {
                    uniqueEmails.push({ email, relationship: e.relationship || 'Guardian' });
                }
            });

            if (uniqueEmails.length === 0) {
                uniqueEmails.push({ email: '', relationship: 'Manual' });
            }

            html += `<div class="email-student-row" data-student-id="${s.student_id}">
                <div class="email-student-header">
                    <div>
                        <div class="email-student-name">${s.first_name} ${s.last_name}</div>
                        <div class="email-student-meta">${s.class_name || ''}</div>
                    </div>
                    <button type="button" class="email-add-btn" onclick="addEmailField(${s.student_id})">Add Email</button>
                </div>
                <div class="email-fields" id="emailFields-${s.student_id}">`;

            uniqueEmails.forEach((e, i) => {
                const badge = i === 0 ? 'Primary' : e.relationship || 'Guardian';
                const valueAttr = e.email ? `value="${e.email}"` : 'placeholder="Enter email address"';
                html += `<div class="email-field-row">
                        <input type="email" ${valueAttr} class="email-input" data-student-id="${s.student_id}">
                        <span class="email-pill">${badge}</span>
                        <button type="button" class="email-remove-btn" onclick="this.parentElement.remove()">✕</button>
                    </div>`;
            });

            html += `</div></div>`;
        });

        container.innerHTML = html;
        
        // Add event listeners to save on change
        container.querySelectorAll('.email-input').forEach(input => {
            input.addEventListener('input', () => {
                saveEmailsToStorage();
            });
        });
    }

    function addEmailField(studentId) {
        const container = document.getElementById(`emailFields-${studentId}`);
        const row = document.createElement('div');
        row.className = 'email-field-row';
        row.innerHTML = `
            <input type="email" placeholder="Enter email address" class="email-input" data-student-id="${studentId}">
            <span class="email-pill">Manual</span>
            <button type="button" class="email-remove-btn" onclick="this.parentElement.remove(); saveEmailsToStorage();">✕</button>
        `;
        container.appendChild(row);
        
        // Add event listener to new input
        row.querySelector('.email-input').addEventListener('input', () => {
            saveEmailsToStorage();
        });
    }

    function closeEmailModal() {
        document.getElementById('emailModal').style.display = 'none';
        document.getElementById('emailPassword').value = '';
        document.getElementById('emailStatus').textContent = '';
    }

    function isValidEmail(email) {
        return /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email);
    }

    async function sendReportEmails() {
        const password = document.getElementById('emailPassword').value;
        if (!password) {
            alert('Please enter your password to confirm.');
            return;
        }

        const statusEl = document.getElementById('emailStatus');
        const sendBtn = document.getElementById('emailSendBtn');
        statusEl.textContent = '';

        const emailData = [];
        const missingEmails = [];
        const invalidEmails = [];

        document.querySelectorAll('.email-student-row').forEach(row => {
            const studentId = row.getAttribute('data-student-id');
            const studentName = (row.querySelector('.email-student-name')?.textContent || '').trim();
            const inputs = row.querySelectorAll('.email-input');
            const emails = [];

            inputs.forEach(input => {
                const val = input.value.trim();
                if (val) {
                    emails.push(val);
                    if (!isValidEmail(val)) {
                        invalidEmails.push({ studentName, email: val });
                    }
                }
            });

            if (emails.length === 0) {
                missingEmails.push(studentName || `ID ${studentId}`);
            } else {
                emailData.push({ studentId: parseInt(studentId, 10), emails });
            }
        });

        if (invalidEmails.length > 0) {
            const list = invalidEmails.map(e => `${e.studentName || 'Student'}: ${e.email}`).join('; ');
            statusEl.textContent = `⚠️ Fix invalid emails before sending: ${list}`;
            statusEl.style.color = '#d97706';
            return;
        }

        if (missingEmails.length > 0) {
            const msg = `The following students have no emails: ${missingEmails.join(', ')}. Continue anyway?`;
            const proceed = window.confirm(msg);
            if (!proceed) {
                statusEl.textContent = 'Send cancelled. Please add emails or deselect those students.';
                statusEl.style.color = '#d97706';
                return;
            }
        }

        if (emailData.length === 0) {
            alert('No valid email addresses provided.');
            return;
        }

        sendBtn.disabled = true;
        sendBtn.textContent = 'Sending...';
        statusEl.textContent = 'Sending reports, please wait...';
        statusEl.style.color = '#666';

        try {
            const response = await fetch('/print/emailReports', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    classId: <%= classId %>,
                    termId: <%= termId %>,
                    password,
                    emailData
                })
            });

            const result = await response.json();
            if (result.success) {
                statusEl.textContent = `✅ ${result.message}`;
                statusEl.style.color = '#27ae60';
                clearEmailStorage(); // Clear localStorage on success
                setTimeout(() => closeEmailModal(), 3000);
            } else {
                statusEl.textContent = `❌ ${result.message}`;
                statusEl.style.color = '#dc3545';
            }
        } catch (err) {
            statusEl.textContent = '❌ Network error. Please try again.';
            statusEl.style.color = '#dc3545';
        } finally {
            sendBtn.disabled = false;
            sendBtn.textContent = 'Send Reports';
        }
    }
    </script>

        <script>
            document.addEventListener('DOMContentLoaded', () => {
                const reports = document.querySelectorAll('.student-report');
                if (reports.length) {
                    reports.forEach(r => r.classList.remove('last-report'));
                    reports[reports.length - 1].classList.add('last-report');
                }
            });
        </script>

    <!-- Email Modal -->
    <div id="emailModal" class="email-modal-overlay">
        <div class="email-modal-card">
            <div class="email-modal-header">
                <div>
                    <p id="emailRecipientCount" class="email-modal-subtitle">Preparing recipients...</p>
                    <h3 class="email-modal-title">Send Reports by Email</h3>
                </div>
                <button class="email-close-btn" onclick="closeEmailModal()">✕</button>
            </div>
            <div class="email-modal-body">
                <div class="email-hint"><strong>Guardian emails auto-selected.</strong> Review, add, or override before sending.</div>
                <div id="emailStudentList" class="email-student-list"></div>
                
                <div id="emailPasswordSection" class="email-password" style="display:none;">
                    <label>🔒 Confirm Password</label>
                    <input type="password" id="emailPassword" placeholder="Enter your password">
                </div>

                <div class="email-footer">
                    <div style="display: flex; gap: 12px; align-items: center;">
                        <a href="/print/emailHistoryPage?classId=<%= classId %>&termId=<%= termId %>" style="padding: 10px 18px; background: #6c757d; color: #fff; text-decoration: none; border-radius: 8px; font-weight: 600; font-size: 14px; display: inline-flex; align-items: center; gap: 6px; transition: background 0.2s;">
                            📜 History
                        </a>
                        <span id="emailStatus" style="font-size:13px;"></span>
                    </div>
                    <button id="emailSendBtn" class="email-send-btn" onclick="sendReportEmails()">Send Reports</button>
                </div>
            </div>
        </div>
    </div>

