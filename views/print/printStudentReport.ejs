    // Toggle dropdowns properly
function toggleDropdown(remarkType, studentId) {
    // Close any open dropdowns
    document.querySelectorAll('.remark-dropdown').forEach(dropdown => {
        if (dropdown.id !== `dropdown-${remarkType}-${studentId}`) {
            dropdown.style.display = 'none';
        }
    });

    // Open or close the clicked dropdown
    const dropdown = document.getElementById(`dropdown-${remarkType}-${studentId}`);
    if (!dropdown) return;
    const remarkLine = dropdown.closest('.remark-line');
    
    if (dropdown && remarkLine) {
        if (dropdown.style.display === 'block') {
            dropdown.style.display = 'none';
        } else {
            // Position dropdown inside the report row (aligned with textarea area)
            const inputField = remarkLine.querySelector('textarea');
            if (inputField) {
                dropdown.style.left = `${Math.max(0, inputField.offsetLeft)}px`;
                dropdown.style.right = '0';
            } else {
                dropdown.style.left = '0';
                dropdown.style.right = '0';
            }

            dropdown.style.top = 'calc(100% + 6px)';
            dropdown.style.bottom = 'auto';
            dropdown.style.display = 'block';

            // If there is not enough room below inside the card, place above.
            const reportCard = remarkLine.closest('.student-report') || document.body;
            const reportRect = reportCard.getBoundingClientRect();
            const lineRect = remarkLine.getBoundingClientRect();
            const dropdownRect = dropdown.getBoundingClientRect();
            const spaceBelowInReport = reportRect.bottom - lineRect.bottom;
            const spaceAboveInReport = lineRect.top - reportRect.top;

            if (spaceBelowInReport < dropdownRect.height + 8 && spaceAboveInReport > spaceBelowInReport) {
                dropdown.style.top = 'auto';
                dropdown.style.bottom = 'calc(100% + 6px)';
            }
        }
    }
}
        
