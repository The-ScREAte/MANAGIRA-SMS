        .report-card-footer {
            margin-top: 22px;
            padding-top: 10px;
            border-top: 1px solid #d1d5db;
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            flex-wrap: nowrap;
            gap: 12px;
            font-size: 11px;
            color: #475569;
        }

        .report-card-footer-left {
            flex: 1 1 0;
            min-width: 0;
            font-weight: 600;
            text-align: left;
            word-break: break-word;
            overflow-wrap: anywhere;
        }

        .report-card-footer-right {
            flex: 1 1 0;
            min-width: 0;
            text-align: right;
            white-space: normal;
            word-break: break-word;
            overflow-wrap: anywhere;
        }

        @media print {
            @page {
                size: A4 portrait;
                margin: 8mm 8mm 8mm 8mm;
            }

            * {
                -webkit-print-color-adjust: exact;
                print-color-adjust: exact;
            }

            body {
                margin: 0;
                padding: 0 !important;
                background: white;
            }

            body * {
                visibility: hidden;
            }

            /* Show only the report during print */
            .student-report,
            .student-report *,
            .student-report-background,
            .student-report-background * {
                visibility: visible;
            }

            .student-report {
                width: calc(100% - 12mm);
                max-width: 100%;
                margin: 0 auto 0 auto !important;
                padding: 10px 14px 12px 14px !important;
                page-break-after: always;
                break-after: page;
                page-break-inside: avoid;
                break-inside: avoid;
                box-sizing: border-box;
                display: block;
                border: 1px solid #e5e5e5 !important;
                box-shadow: none !important;
                border-radius: 8px !important;
                background: white;
                position: relative;
                min-height: auto;
            }

            .student-report:last-of-type {
                page-break-after: auto !important;
                break-after: auto !important;
            }

            .paygira-print-block {
                display: block !important;
                background: transparent !important;
                border: none !important;
                padding: 0 !important;
            }

            .student-report.last-report,
            .student-report.temp-last-report,
            .student-report-grid:last-of-type .student-report {
                page-break-after: avoid !important;
                break-after: avoid !important;
            }

            /* Hide watermark img in screen but show in print */
            .print-watermark-img {
                display: block !important;
                position: absolute;
                top: 50%;
                left: 50%;
                transform: translate(-50%, -50%);
                width: 300px;
                height: 300px;
                object-fit: contain;
                opacity: 0.09;
                z-index: 0;
                pointer-events: none;
            }

            .student-report-background {
                page-break-inside: avoid;
                width: 100% !important;
                max-width: 100% !important;
                overflow: visible;
                box-sizing: border-box !important;
            }

            /* Hide non-printable elements */
            .actions, 
            .actions-no-print,
            .print-options-container,
            .student-checkbox,
