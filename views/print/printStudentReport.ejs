        .grade-interpretation h6 {
            margin: 1px;
            font-size: 14px;
            text-align: center;
            color: var(--primary);
            font-weight: 600;
        }

        .grade-interpretation-content {
            display: flex;
            flex-wrap: wrap;
            align-items: center;
            justify-content: center;
        }

        .grade-interpretation-item {
            display: inline-block;
