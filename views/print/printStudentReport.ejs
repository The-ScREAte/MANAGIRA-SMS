                    </div>

                 
                    <div class="remarks-signature-wrapper">
                        <!-- Remarks Section -->
                        <div class="remarks">
                            <h4 class="remarks-header">Academic Remarks</h4>
                            <div class="remarks-container">
                                <% const remarkTypes = ['conductRemarks', 'attitudeRemarks', 'interestRemarks', 'teacherRemarks']; %>
                    
                                <% remarkTypes.forEach((remarkType) => { %>
                                    <div class="remark-line">
                                        <label for="<%= remarkType %>-<%= student.student_id %>">
                                            <%= remarkType.replace(/([a-z])([A-Z])/g, '$1 $2').replace(' Remarks', '') %>

                                            <span class="remark-arrow" id="arrow-<%= remarkType %>-<%= student.student_id %>" 
                                                onclick="toggleDropdown('<%= remarkType %>', <%= student.student_id %>)">
                                              ▼
                                          </span>
                                        </label>
                                        
                                        <textarea id="<%= remarkType %>-<%= student.student_id %>" 
                                                  name="<%= remarkType %>-<%= student.student_id %>"
                                                  maxlength="150"
                                                  onfocus="this.select();"><%= student[remarkType] ? student[remarkType] : '' %></textarea>
                                                                         
                                        
                                        <div class="remark-dropdown" id="dropdown-<%= remarkType %>-<%= student.student_id %>">
                                            <% (remarks[remarkType.replace('Remarks', '').toLowerCase()] || []).forEach(function (remark) { %>
                                                <div class="remark-dropdown-option" 
                                                     onclick="selectRemark('<%= remarkType %>', <%= student.student_id %>, '<%= remark.remark %>')">
                                                    <%= remark.remark %>
                                                </div>
                                            <% }); %>
                                        </div>
                                    </div>
