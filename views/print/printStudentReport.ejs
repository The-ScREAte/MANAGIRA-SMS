                                <td>Attendance:</td>
                                <td><%= student.attendance.presentDays %>/<%= student.attendance.totalDays %></td>
                                <td>Vacation Date:</td>
                                <td><%= termEndDate %></td>
                                <td>School Reopens:</td>
