                                  <% 
                                    const parsedReopenDate = new Date(schoolReopenDate);
                                    const formattedReopenDate = !isNaN(parsedReopenDate) ? parsedReopenDate.toLocaleDateString() : "-";
                                  %>
                                  <%= formattedReopenDate %>
