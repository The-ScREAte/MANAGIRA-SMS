        let reportPostStatusPoller = null;

        function stopReportPostStatusPolling() {
            if (reportPostStatusPoller) {
                clearInterval(reportPostStatusPoller);
                reportPostStatusPoller = null;
            }
        }

        function startReportPostStatusPolling(classId, termId, postBtnLabel, originalBtnText) {
            stopReportPostStatusPolling();
            let pollCount = 0;
            const maxPollCount = 120; // 10 minutes at 5s interval

            const applyLabel = (value) => {
                if (postBtnLabel) postBtnLabel.textContent = value;
            };

            const pollOnce = async () => {
                pollCount += 1;
                if (pollCount > maxPollCount) {
                    stopReportPostStatusPolling();
                    applyLabel(originalBtnText);
                    return;
                }

                try {
                    const res = await fetch(`/print/postReportCardsStatus?classId=${encodeURIComponent(classId)}&termId=${encodeURIComponent(termId)}`);
                    const payload = await res.json().catch(() => ({}));
                    if (!res.ok || !payload.success) return;

                    const status = String(payload.status || '').toLowerCase();

                    if (status === 'queued') {
                        applyLabel('Queued');
                        return;
                    }

                    if (status === 'running') {
                        applyLabel('Posting...');
                        return;
                    }

                    if (status === 'completed' || status === 'completed_with_errors') {
                        stopReportPostStatusPolling();
                        applyLabel(originalBtnText);
                        const readyCount = Number(payload.postedCount || 0);
                        const failedCount = Number(payload.failedCount || 0);
                        alert(`Background posting completed. Ready: ${readyCount}${failedCount > 0 ? `, Failed: ${failedCount}` : ''}.`);
                        return;
                    }

                    if (status === 'failed') {
                        stopReportPostStatusPolling();
                        applyLabel(originalBtnText);
                        alert(payload.error || 'Background posting failed. Please try again.');
                        return;
                    }

                    if (status === 'not_found') {
                        stopReportPostStatusPolling();
                        applyLabel(originalBtnText);
                    }
                } catch (_) {
                    // Keep polling on transient network errors.
                }
            };

            pollOnce();
            reportPostStatusPoller = setInterval(pollOnce, 5000);
        }

        async function postReportCards() {
            const postBtn = document.getElementById('postReportCardsLink');
            if (!postBtn) return;
            const postBtnLabel = postBtn.querySelector('.post-btn-label');
            const originalBtnText = postBtnLabel ? postBtnLabel.textContent : 'Post Report';

            const setPostingState = (isPosting) => {
                postBtn.classList.toggle('is-posting', isPosting);
                postBtn.style.pointerEvents = isPosting ? 'none' : '';
                postBtn.style.opacity = isPosting ? '0.85' : '';
                postBtn.setAttribute('aria-busy', isPosting ? 'true' : 'false');
                if (postBtnLabel) {
                    postBtnLabel.textContent = isPosting ? 'Queueing...' : originalBtnText;
                }
            };

            const setQueuedState = () => {
                postBtn.classList.remove('is-posting');
                postBtn.style.pointerEvents = '';
                postBtn.style.opacity = '';
                postBtn.setAttribute('aria-busy', 'false');
                if (postBtnLabel) {
                    postBtnLabel.textContent = 'Queued';
                }
                setTimeout(() => {
                    if (postBtnLabel) {
                        postBtnLabel.textContent = originalBtnText;
                    }
                }, 3000);
            };

            if (checkForUnsavedChanges()) {
                const proceed = confirm('You have unsaved report changes. Click OK to continue posting as-is, or Cancel to save changes first.');
                if (!proceed) return;
            }

            const selected = Array.from(document.querySelectorAll('.student-checkbox:checked'))
                .map((cb) => parseInt(cb.getAttribute('data-student-id'), 10))
                .filter((id) => Number.isFinite(id) && id > 0);

            let studentIds = selected;
            if (!studentIds.length) {
                const postAll = confirm('No students selected. Post report cards for all students in this class and term?');
                if (!postAll) return;
                studentIds = Array.from(document.querySelectorAll('.student-report'))
                    .map((report) => parseInt(report.getAttribute('data-student-id'), 10))
                    .filter((id) => Number.isFinite(id) && id > 0);
            }

            if (!studentIds.length) {
                alert('No students available for posting.');
                return;
            }

            setPostingState(true);

            try {
                const response = await fetch('/print/postReportCards', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        classId: <%= classId %>,
                        termId: <%= termId %>,
                        studentIds,
                    }),
                });

                const payload = await response.json().catch(() => ({}));
                if (!response.ok || !payload.success) {
                    alert(payload.message || 'Failed to post report cards.');
                    return;
                }

                if (response.status === 202 || payload.background) {
                    setQueuedState();
                    alert(payload.message || 'Posting has started in the background. You can continue working; parents and teachers will be notified when done.');
                    startReportPostStatusPolling(<%= classId %>, <%= termId %>, postBtnLabel, originalBtnText);
                    return;
                }

                alert(payload.message || 'Report cards posted successfully. Parents can now view PDF report cards in the portal.');
            } catch (error) {
                alert('Failed to post report cards. Please try again.');
            } finally {
                if (postBtn.classList.contains('is-posting')) {
                    setPostingState(false);
                }
            }
        }
