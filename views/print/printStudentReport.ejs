                            </div>
                        </div>
                    
                        <!-- Signature Section -->
                        <div class="signature-info">
                            <div class="signature-title">Principal's Signature</div>
                            <% if (signatureImageUrl) { %>
                                <img src="<%= signatureImageUrl %>" alt="Signature Image">
                            <% } else { %>
                                <p style="font-size: 11px; color: #999; margin: 20px 0;">No signature</p>
                            <% } %>
                            <h3>Authorized</h3>
                        </div>
                    </div>
                    
                    
                    
                    <div class="grade-interpretation">
                        <h6>Interpretation of Grades:</h6>
                        <div class="grade-interpretation-content">
                            <% scoreRemarks.forEach(function (remark) { %>
                                <span class="grade-interpretation-item">  <%= - remark.fromPercentage %> to <%= remark.toPercentage %> = <%= remark.remark %></span>
                            <% }); %>
                        </div>
                    </div> 
                </div>
            </div>
        <% }); %>
    <% } %>

    <script>
        // Student selection and filtering functions
        function toggleSelectAll() {
            const selectAllCheckbox = document.getElementById('selectAllStudents');
            const studentCheckboxes = document.querySelectorAll('.student-checkbox');
            
            studentCheckboxes.forEach(checkbox => {
                if (!checkbox.closest('.student-report').style.display || checkbox.closest('.student-report').style.display !== 'none') {
                    checkbox.checked = selectAllCheckbox.checked;
                    updateReportSelection(checkbox);
                }
            });
            
            updateSelectedCount();
        }

        function updateSelectedCount() {
            const checkboxes = document.querySelectorAll('.student-checkbox');
            let selectedCount = 0;
            
            checkboxes.forEach(checkbox => {
                if (checkbox.checked) {
                    selectedCount++;
                    checkbox.closest('.student-report').classList.add('selected');
                } else {
                    checkbox.closest('.student-report').classList.remove('selected');
                }
            });
            
            document.getElementById('selectedCount').textContent = selectedCount;
        }

        function updateReportSelection(checkbox) {
            const report = checkbox.closest('.student-report');
            if (checkbox.checked) {
                report.classList.add('selected');
            } else {
                report.classList.remove('selected');
            }
        }

        function filterStudents() {
            const searchTerm = document.getElementById('studentSearch').value.toLowerCase();
            const studentReports = document.querySelectorAll('.student-report');
            let visibleCount = 0;
            
            studentReports.forEach(report => {
                const studentName = report.getAttribute('data-student-name').toLowerCase();
                const studentId = report.getAttribute('data-student-id');
                
                if (studentName.includes(searchTerm) || studentId.includes(searchTerm)) {
                    report.style.display = '';
                    visibleCount++;
                } else {
                    report.style.display = 'none';
                }
            });
            
            document.getElementById('totalCount').textContent = visibleCount;
        }

        function filterBySelection(type, clickedButton) {
            const studentReports = document.querySelectorAll('.student-report');
            const buttons = document.querySelectorAll('.filter-btn:not(:last-child)');
            let visibleCount = 0;
            
            // Update button states
            buttons.forEach(btn => btn.classList.remove('active'));
            if (clickedButton) {
                clickedButton.classList.add('active');
            }
            
            studentReports.forEach(report => {
                const checkbox = report.querySelector('.student-checkbox');
                
                if (type === 'all') {
                    report.style.display = '';
                    visibleCount++;
                } else if (type === 'selected' && checkbox.checked) {
                    report.style.display = '';
                    visibleCount++;
                } else if (type === 'selected') {
                    report.style.display = 'none';
                }
            });
        }

        function printSelected() {
            const selectedReports = document.querySelectorAll('.student-checkbox:checked');
            
            if (selectedReports.length === 0) {
                alert('Please select at least one student to print.');
                return;
            }
            
            // Hide unchecked reports temporarily
            const allReports = document.querySelectorAll('.student-report');
            allReports.forEach(report => {
                const checkbox = report.querySelector('.student-checkbox');
                if (!checkbox.checked) {
                    report.setAttribute('data-hidden-for-print', 'true');
                    report.style.display = 'none';
                }
            });
            
            // Print
            window.print();
            
            // Restore all reports
            allReports.forEach(report => {
                if (report.getAttribute('data-hidden-for-print')) {
                    report.style.display = '';
                    report.removeAttribute('data-hidden-for-print');
                }
            });
        }

        // Close dropdowns when clicking outside
        document.addEventListener('click', function(e) {
            if (!e.target.closest('.remark-line') && !e.target.closest('.remark-dropdown')) {
                document.querySelectorAll('.remark-dropdown').forEach(dropdown => {
                    dropdown.style.display = 'none';
                });
            }
        });

        // Reposition dropdowns on scroll
        window.addEventListener('scroll', function() {
            document.querySelectorAll('.remark-dropdown').forEach(dropdown => {
                if (dropdown.style.display === 'block') {
                    dropdown.style.display = 'none';
                }
            });
        });

        document.addEventListener('input', function (e) {
            if (e.target.tagName === 'TEXTAREA') {
                // Reset height to calculate scrollHeight properly
                e.target.style.height = '22px';
                e.target.style.whiteSpace = 'pre-wrap';
                e.target.style.overflowY = 'hidden';
                
                // If content needs more space, expand (max 66px = 3 lines)
                if (e.target.scrollHeight > 22) {
                    const newHeight = Math.min(e.target.scrollHeight, 66);
                    e.target.style.height = newHeight + 'px';
                    e.target.style.overflowY = e.target.scrollHeight > 66 ? 'auto' : 'hidden';
                }
            }
        });
        
        document.addEventListener('DOMContentLoaded', function () {
            document.querySelectorAll('textarea').forEach(function (textarea) {
                // Set initial height to one line
                textarea.style.height = '22px';
                textarea.style.whiteSpace = 'pre-wrap';
                textarea.style.overflowY = 'hidden';
                
                // If content needs more space on load, expand
                if (textarea.scrollHeight > 22) {
                    const newHeight = Math.min(textarea.scrollHeight, 66);
                    textarea.style.height = newHeight + 'px';
                    textarea.style.overflowY = textarea.scrollHeight > 66 ? 'auto' : 'hidden';
                }
            });
        });

    // Toggle dropdowns properly
function toggleDropdown(remarkType, studentId) {
    // Close any open dropdowns
    document.querySelectorAll('.remark-dropdown').forEach(dropdown => {
        if (dropdown.id !== `dropdown-${remarkType}-${studentId}`) {
            dropdown.style.display = 'none';
        }
    });

    // Open or close the clicked dropdown
    const dropdown = document.getElementById(`dropdown-${remarkType}-${studentId}`);
    const remarkLine = dropdown.closest('.remark-line');
    
    if (dropdown && remarkLine) {
        if (dropdown.style.display === 'block') {
            dropdown.style.display = 'none';
        } else {
            // Position dropdown relative to remark line using fixed positioning
            const rect = remarkLine.getBoundingClientRect();
            const dropdownHeight = 280; // max-height of dropdown
            const windowHeight = window.innerHeight;
            const spaceBelow = windowHeight - rect.bottom;
            const spaceAbove = rect.top;
            
            // Set horizontal position (aligned with remark line, starting after label)
            dropdown.style.left = (rect.left + 140) + 'px';
            dropdown.style.width = (rect.width - 140) + 'px';
            
            // Determine if dropdown should appear above or below
            if (spaceBelow >= dropdownHeight || spaceBelow >= spaceAbove) {
                // Show below
                dropdown.style.top = (rect.bottom + 5) + 'px';
                dropdown.style.bottom = 'auto';
            } else {
                // Show above
                dropdown.style.bottom = (windowHeight - rect.top + 5) + 'px';
                dropdown.style.top = 'auto';
            }
            
            dropdown.style.display = 'block';
        }
    }
}
        
       // Select remark from dropdown
function selectRemark(remarkType, studentId, remark) {
    const textarea = document.getElementById(`${remarkType}-${studentId}`);
    textarea.value = remark.trim();
    
    // Reset height and set white-space
    textarea.style.height = '22px';
    textarea.style.whiteSpace = 'pre-wrap';
    textarea.style.overflowY = 'hidden';
    
    // If content needs more space, expand (max 66px = 3 lines)
    if (textarea.scrollHeight > 22) {
        const newHeight = Math.min(textarea.scrollHeight, 66);
        textarea.style.height = newHeight + 'px';
        textarea.style.overflowY = textarea.scrollHeight > 66 ? 'auto' : 'hidden';
    }
    
    // Close dropdown after selection
    toggleDropdown(remarkType, studentId);
}
        
function updateClass(studentId) {
    const statusSelect = document.getElementById('promotionStatus-' + studentId);
    const selectedStatus = statusSelect.value;
    const classCell = document.getElementById('promotionClass-' + studentId);

    const promotedClassName = '<%= promotedClass %>';
    const repeatedClassName = '<%= repeatedClass %>';
    const promotedClassId = '<%= promotedClassId %>';  // ⚠️ Make sure you pass this in EJS
    const repeatedClassId = '<%= repeatedClassId %>';  // ⚠️ Make sure you pass this in EJS

    if (selectedStatus === 'Promoted') {
        classCell.innerHTML = promotedClassName;
        classCell.setAttribute('data-class-id', promotedClassId);  // ✅ Update data-class-id
    } else if (selectedStatus === 'Repeated') {
        classCell.innerHTML = repeatedClassName;
        classCell.setAttribute('data-class-id', repeatedClassId);  // ✅ Update data-class-id
    }
}


        // Save changes
        document.getElementById('saveChangesLink').addEventListener('click', async (e) => {
            e.preventDefault(); // prevent link navigation
        
            const studentReports = Array.from(document.querySelectorAll('.student-report')).map((report) => {
              const studentId = report.getAttribute('data-student-id');
              if (!studentId || isNaN(studentId)) {
                console.error('Invalid or missing student ID:', report);
                return null;
              }
        
              // ✅ Get promotion status
              const promotionStatusElement = document.getElementById(`promotionStatus-${studentId}`);
              const promotionStatus = promotionStatusElement ? promotionStatusElement.value.trim() : null;
        
              // ✅ Get class name element (which also holds the class ID if you add data-class-id there)
              const promotionClassCell = document.getElementById(`promotionClass-${studentId}`);
              const promotionClassId = promotionClassCell ? promotionClassCell.getAttribute('data-class-id') : null;
        
              return {
                studentId: parseInt(studentId, 10),
                conductRemarks: document.getElementById(`conductRemarks-${studentId}`).value.trim(),
                attitudeRemarks: document.getElementById(`attitudeRemarks-${studentId}`).value.trim(),
                interestRemarks: document.getElementById(`interestRemarks-${studentId}`).value.trim(),
                teacherRemarks: document.getElementById(`teacherRemarks-${studentId}`).value.trim(),
                promotionStatus,   // ✅ added
                promotionClassId,  // ✅ added (may be null)
              };
            }).filter(Boolean);
        
            if (studentReports.length === 0) {
              alert('No valid reports to save.');
              return;
            }
        
            try {
              const response = await fetch(`/print/saveReportChanges?classId=<%= classId %>&termId=<%= termId %>`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ studentReports }),
              });
        
              if (response.ok) {
                alert('Changes saved successfully.');
              } else {
                alert('Failed to save changes.');
              }
            } catch (error) {
              console.error('Error saving changes:', error);
            }
          });
    // ===== EMAIL MODAL =====
    function openEmailModal() {
        const selected = document.querySelectorAll('.student-checkbox:checked');
        if (selected.length === 0) {
            alert('Please select at least one student to email.');
            return;
        }

        // Collect student IDs
        const studentIds = Array.from(selected).map(cb => cb.getAttribute('data-student-id'));

        // Show modal
        document.getElementById('emailModal').style.display = 'flex';
        document.getElementById('emailStudentList').innerHTML = '<p style="color:#999;">Loading guardian emails...</p>';
        document.getElementById('emailPasswordSection').style.display = 'none';
        document.getElementById('emailSendBtn').style.display = 'none';

        // Fetch guardian emails
        fetch(`/print/getGuardianEmails?classId=<%= classId %>&termId=<%= termId %>&studentIds=${studentIds.join(',')}`)
            .then(r => r.json())
            .then(data => {
                if (!data.success) {
                    document.getElementById('emailStudentList').innerHTML = '<p style="color:red;">Failed to load emails.</p>';
                    return;
                }
                renderEmailList(data.students);
                document.getElementById('emailPasswordSection').style.display = 'block';
                document.getElementById('emailSendBtn').style.display = 'inline-block';
            })
            .catch(() => {
                document.getElementById('emailStudentList').innerHTML = '<p style="color:red;">Error fetching emails.</p>';
            });
    }

    function renderEmailList(students) {
        const container = document.getElementById('emailStudentList');
        if (!students || students.length === 0) {
            container.innerHTML = '<p style="color:#999;">No students found.</p>';
            return;
        }

        let html = '';
        students.forEach(s => {
            html += `<div class="email-student-row" data-student-id="${s.student_id}">
                <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:6px;">
                    <strong style="font-size:14px;">${s.first_name} ${s.last_name}</strong>
                    <button type="button" onclick="addEmailField(${s.student_id})" style="background:var(--primary);color:#fff;border:none;border-radius:4px;padding:4px 10px;cursor:pointer;font-size:12px;">+ Add Email</button>
                </div>
                <div class="email-fields" id="emailFields-${s.student_id}">`;

            if (s.emails && s.emails.length > 0) {
                s.emails.forEach((e, i) => {
                    html += `<div class="email-field-row" style="display:flex;gap:6px;align-items:center;margin-bottom:6px;">
                        <input type="email" value="${e.email}" class="email-input" style="flex:1;padding:8px 12px;border:1px solid #ddd;border-radius:6px;font-size:13px;" data-student-id="${s.student_id}">
                        <span style="font-size:11px;color:#888;min-width:60px;">${e.relationship || 'Guardian'}</span>
                        <button type="button" onclick="this.parentElement.remove()" style="background:#dc3545;color:#fff;border:none;border-radius:4px;padding:4px 8px;cursor:pointer;font-size:11px;">✕</button>
                    </div>`;
                });
            } else {
                html += `<div class="email-field-row" style="display:flex;gap:6px;align-items:center;margin-bottom:6px;">
                    <input type="email" placeholder="Enter email address" class="email-input" style="flex:1;padding:8px 12px;border:1px solid #ddd;border-radius:6px;font-size:13px;" data-student-id="${s.student_id}">
                    <span style="font-size:11px;color:#888;min-width:60px;">Manual</span>
                    <button type="button" onclick="this.parentElement.remove()" style="background:#dc3545;color:#fff;border:none;border-radius:4px;padding:4px 8px;cursor:pointer;font-size:11px;">✕</button>
                </div>`;
            }
            html += `</div></div>`;
        });

        container.innerHTML = html;
    }

    function addEmailField(studentId) {
        const container = document.getElementById(`emailFields-${studentId}`);
        const row = document.createElement('div');
        row.className = 'email-field-row';
        row.style.cssText = 'display:flex;gap:6px;align-items:center;margin-bottom:6px;';
        row.innerHTML = `
            <input type="email" placeholder="Enter email address" class="email-input" style="flex:1;padding:8px 12px;border:1px solid #ddd;border-radius:6px;font-size:13px;" data-student-id="${studentId}">
            <span style="font-size:11px;color:#888;min-width:60px;">Manual</span>
            <button type="button" onclick="this.parentElement.remove()" style="background:#dc3545;color:#fff;border:none;border-radius:4px;padding:4px 8px;cursor:pointer;font-size:11px;">✕</button>
        `;
        container.appendChild(row);
    }

    function closeEmailModal() {
        document.getElementById('emailModal').style.display = 'none';
        document.getElementById('emailPassword').value = '';
        document.getElementById('emailStatus').textContent = '';
    }

    async function sendReportEmails() {
        const password = document.getElementById('emailPassword').value;
        if (!password) {
            alert('Please enter your password to confirm.');
            return;
        }

        const statusEl = document.getElementById('emailStatus');
        const sendBtn = document.getElementById('emailSendBtn');

        // Collect all email data
        const emailData = [];
        document.querySelectorAll('.email-student-row').forEach(row => {
            const studentId = row.getAttribute('data-student-id');
            const inputs = row.querySelectorAll('.email-input');
            const emails = [];
            inputs.forEach(input => {
                const val = input.value.trim();
                if (val) emails.push(val);
            });
            if (emails.length > 0) {
                emailData.push({ studentId: parseInt(studentId), emails });
            }
        });

        if (emailData.length === 0) {
            alert('No valid email addresses provided.');
            return;
        }

        sendBtn.disabled = true;
        sendBtn.textContent = 'Sending...';
        statusEl.textContent = 'Sending reports, please wait...';
        statusEl.style.color = '#666';

        try {
            const response = await fetch('/print/emailReports', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    classId: <%= classId %>,
                    termId: <%= termId %>,
                    password,
                    emailData
                })
            });

            const result = await response.json();
            if (result.success) {
                statusEl.textContent = `✅ ${result.message}`;
                statusEl.style.color = '#27ae60';
                setTimeout(() => closeEmailModal(), 3000);
            } else {
                statusEl.textContent = `❌ ${result.message}`;
                statusEl.style.color = '#dc3545';
            }
        } catch (err) {
            statusEl.textContent = '❌ Network error. Please try again.';
            statusEl.style.color = '#dc3545';
        } finally {
            sendBtn.disabled = false;
            sendBtn.textContent = 'Send Reports';
        }
    }
    </script>

    <!-- Email Modal -->
    <div id="emailModal" style="display:none;position:fixed;top:0;left:0;width:100%;height:100%;background:rgba(0,0,0,0.5);z-index:99999;justify-content:center;align-items:center;">
        <div style="background:#fff;border-radius:12px;max-width:600px;width:90%;max-height:85vh;overflow-y:auto;box-shadow:0 20px 60px rgba(0,0,0,0.3);">
            <div style="padding:20px 24px;border-bottom:2px solid var(--primary);display:flex;justify-content:space-between;align-items:center;">
                <h3 style="margin:0;color:var(--primary);font-size:18px;">📧 Send Reports by Email</h3>
                <button onclick="closeEmailModal()" style="background:none;border:none;font-size:24px;cursor:pointer;color:#999;">✕</button>
            </div>
            <div style="padding:24px;">
                <div id="emailStudentList" style="margin-bottom:20px;"></div>
                
                <div id="emailPasswordSection" style="display:none;border-top:1px solid #eee;padding-top:16px;">
                    <label style="font-weight:600;font-size:14px;color:#333;display:block;margin-bottom:8px;">🔒 Confirm Password</label>
                    <input type="password" id="emailPassword" placeholder="Enter your password" style="width:100%;padding:10px 14px;border:1px solid #ddd;border-radius:6px;font-size:14px;box-sizing:border-box;">
                </div>

                <div style="margin-top:16px;display:flex;justify-content:space-between;align-items:center;">
                    <span id="emailStatus" style="font-size:13px;"></span>
                    <button id="emailSendBtn" onclick="sendReportEmails()" style="display:none;background:var(--primary);color:#fff;border:none;border-radius:6px;padding:10px 24px;font-size:14px;font-weight:600;cursor:pointer;">Send Reports</button>
                </div>
            </div>
        </div>
    </div>
</body>

