                                        <td><%= subject.examsAssessmentScore || '-' %></td>
                                        <td><%= subject.otherAssessmentScore || '-' %></td>
                                        <td><%= subject.totalScore || '-' %></td>
                                        <td><%= subject.totalPercentage || '-' %></td>
                                        <td><%= subject.grade || '-' %></td>
                                        <td><%= subject.position || '-' %></td>
                                        <td><%= subject.remarks || '-' %></td>
                                    </tr>
                                <% }); %>
