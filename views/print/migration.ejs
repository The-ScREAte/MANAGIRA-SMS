<!DOCTYPE html>
<html lang="en">
  <head>
    <link rel="stylesheet" href="/css/globalScale.css">
    <meta charset="UTF-8" />
    <meta name="viewport" content="<%= locals.viewportContent || 'width=device-width, initial-scale=1.0, maximum-scale=1.0' %>" />
    <title><%= title %></title>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <style>
      :root {
        --font-family: "<%= (session && session.fontStyle ? String(session.fontStyle).trim() : 'Inter') %>", sans-serif;
        --border: #e5e7eb;
        --bg: #f9fafb;
      }

      body {
        font-family: var(--font-family);
        background-color: var(--bg);
        color: #333;
        margin: 0;
        padding: 0;
      }

      .migration-wrapper {
        max-width: none;
        width: 100%;
        margin: 0;
        padding: 24px 20px 60px;
        box-sizing: border-box;
      }

      .page-banner {
        background: var(--org-primary-color, #01535b);
        color: white;
        padding: 28px 20px;
        text-align: center;
        margin-bottom: 32px;
        width: 100%;
      }

      .page-banner h1 {
        margin: 0 0 6px 0;
        font-size: 24px;
        font-weight: 700;
      }

      .page-banner p {
        margin: 0;
        opacity: 0.9;
        font-size: 14px;
      }

      /* Notice */
      .migration-notice {
        background: #eff6ff;
        border-left: 4px solid #3b82f6;
        border-radius: 0 8px 8px 0;
        padding: 16px 20px;
        margin-bottom: 24px;
      }

      .migration-notice h2 {
        font-size: 15px;
        margin: 0 0 6px;
        font-weight: 700;
        color: #1e40af;
      }

      .migration-notice p {
        margin: 0;
        font-size: 14px;
        line-height: 1.6;
        color: #1e40af;
      }

      /* Upload Card */
      .upload-card {
        background: white;
        border: 1px solid var(--border);
        border-radius: 12px;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.06);
        padding: 28px;
        margin-bottom: 24px;
      }

      .upload-card h3 {
        font-size: 18px;
        font-weight: 700;
        color: #111827;
        margin: 0 0 16px;
        text-align: center;
      }

      .upload-card form {
        display: flex;
        flex-direction: column;
        gap: 14px;
        max-width: 100%;
        margin: 0;
        padding: 0;
        box-shadow: none;
        background: none;
        border-radius: 0;
      }

      .upload-card input[type="file"] {
        width: 100%;
        padding: 12px 14px;
        border: 2px dashed var(--border);
        border-radius: 8px;
        font-size: 14px;
        font-family: var(--font-family);
        background: #fafafa;
        cursor: pointer;
        box-sizing: border-box;
      }

      .upload-card input[type="file"]:hover {
        border-color: var(--org-primary-color, #01535b);
      }

      .upload-card button[type="submit"] {
        background: var(--org-primary-color, #01535b);
        color: white;
        padding: 12px 24px;
        border: none;
        border-radius: 8px;
        cursor: pointer;
        font-size: 15px;
        font-weight: 600;
        transition: all 0.2s ease;
        width: 100%;
      }

      .upload-card button[type="submit"]:hover {
        background: var(--org-primary-hover-fill, var(--org-primary-hover, #014a51));
      }

      /* Files List */
      .files-card {
        background: white;
        border: 1px solid var(--border);
        border-radius: 12px;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.06);
        padding: 28px;
        margin-bottom: 24px;
      }

      .files-card h3 {
        font-size: 18px;
        font-weight: 700;
        color: #111827;
        margin: 0 0 16px;
        text-align: center;
      }

      .files-card ul {
        list-style: none;
        padding: 0;
        margin: 0;
      }

      .files-card li {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 14px 16px;
        border: 1px solid var(--border);
        border-radius: 8px;
        margin-bottom: 10px;
        background: #fafafa;
        transition: border-color 0.2s;
        flex-wrap: wrap;
        gap: 8px;
      }

      .files-card li:hover {
        border-color: var(--org-primary-color, #01535b);
      }

      .file-name {
        font-weight: 600;
        color: #111827;
        font-size: 14px;
        flex: 1;
        min-width: 100px;
      }

      .file-actions {
        display: flex;
        gap: 10px;
        align-items: center;
        flex-wrap: wrap;
      }

      .file-actions a {
        font-size: 13px;
        font-weight: 600;
        text-decoration: none;
        padding: 6px 14px;
        border-radius: 6px;
        transition: all 0.2s;
        cursor: pointer;
      }

      .file-actions .view-file {
        background: #eff6ff;
        color: #2563eb;
        border: 1px solid #bfdbfe;
      }

      .file-actions .view-file:hover {
        background: #2563eb;
        color: white;
      }

      .file-actions a[download] {
        background: #f0fdf4;
        color: #16a34a;
        border: 1px solid #bbf7d0;
      }

      .file-actions a[download]:hover {
        background: #16a34a;
        color: white;
      }

      .file-actions .delete-file {
        background: #fef2f2;
        color: #dc2626;
        border: 1px solid #fecaca;
      }

      .file-actions .delete-file:hover {
        background: #dc2626;
        color: white;
      }

      .empty-state {
        text-align: center;
        color: #6b7280;
        padding: 32px 20px;
        font-size: 14px;
      }

      /* File Preview */
      .preview-card {
        background: white;
        border: 1px solid var(--border);
        border-radius: 12px;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.06);
        padding: 28px;
        margin-bottom: 24px;
        display: none;
      }

      .preview-card h3 {
        font-size: 18px;
        font-weight: 700;
        color: #111827;
        margin: 0 0 16px;
        text-align: center;
      }

      .preview-card input[type="text"] {
        width: 100%;
        padding: 10px 16px;
        border: 1px solid var(--border);
        border-radius: 8px;
        font-size: 14px;
        font-family: var(--font-family);
        margin-bottom: 16px;
        box-sizing: border-box;
      }

      .preview-card iframe {
        border: 1px solid var(--border);
        border-radius: 8px;
        width: 100%;
        height: 500px;
      }

      .preview-card pre {
        display: none;
        border: 1px solid var(--border);
        border-radius: 8px;
        width: 100%;
        max-height: 600px;
        overflow: auto;
        padding: 16px;
        background: #fafafa;
        text-align: left;
        white-space: pre-wrap;
        font-family: var(--font-family);
        font-size: 13px;
        line-height: 1.6;
        box-sizing: border-box;
      }

      .highlight {
        background-color: #fef08a;
        padding: 1px 2px;
        border-radius: 2px;
      }

      @media (max-width: 768px) {
        .migration-wrapper {
          padding: 0 16px 40px;
        }

        .page-banner h1 {
          font-size: 20px;
        }

        .upload-card,
        .files-card,
        .preview-card {
          padding: 20px;
        }

        .files-card li {
          flex-direction: column;
          align-items: flex-start;
        }

        .file-actions {
          width: 100%;
          justify-content: flex-start;
        }

        .preview-card iframe {
          height: 300px;
        }

        .preview-card pre {
          max-height: 300px;
        }
      }
    </style>
  </head>
  <body>
    <link rel="stylesheet" href="<%= assetUrl('/css/reportPages.css') %>" />

    <div class="gp-page">
      <header class="gp-head">
        <div>
          <h1 class="gp-title">Data Migration</h1>
          <p class="gp-sub">Keep files from your previous system in one secure place. Upload CSV or PDF files, then view, search or download them any time. Only authorized staff can see them.</p>
        </div>
      </header>

      <%- include('../partials/flash') %>

      <section class="gp-card">
        <div class="gp-card__head"><h2 class="gp-card__title">Upload a file</h2><span class="gp-card__note">CSV or PDF</span></div>
        <form class="mg-upload" action="/print/upload" method="POST" enctype="multipart/form-data">
          <label class="mg-file">
            <i class="fa-solid fa-file-arrow-up" aria-hidden="true"></i>
            <span data-mg-file-label>Choose a CSV or PDF file</span>
            <input type="file" name="file" id="file" accept=".csv,.pdf" required />
          </label>
          <button type="submit" class="gp-btn gp-btn--primary"><i class="fa-solid fa-upload" aria-hidden="true"></i> Upload</button>
        </form>
      </section>

      <section class="gp-card">
        <div class="gp-card__head">
          <h2 class="gp-card__title">Uploaded files</h2>
          <% if (Array.isArray(uploadedFiles) && uploadedFiles.length) { %><span class="gp-pill"><%= uploadedFiles.length %></span><% } %>
        </div>
        <% if (Array.isArray(uploadedFiles) && uploadedFiles.length > 0) { %>
          <ul class="mg-files">
            <% uploadedFiles.forEach(file => { const isPdf = /\.pdf$/i.test(file.file_name || ''); %>
              <li>
                <i class="fa-solid <%= isPdf ? 'fa-file-pdf' : 'fa-file-csv' %> mg-files__icon" aria-hidden="true"></i>
                <span class="mg-files__name"><%= file.file_name %></span>
                <span class="mg-files__actions">
                  <a href="#" class="gp-btn gp-btn--ghost view-file" data-file="<%= file.s3_url %>">View</a>
                  <a href="<%= file.s3_url %>" class="gp-btn gp-btn--ghost" download>Download</a>
                  <a href="#" class="gp-btn gp-btn--link mg-delete delete-file" data-file="<%= file.file_name %>">Delete</a>
                </span>
              </li>
            <% }) %>
          </ul>
        <% } else { %>
          <div class="gp-empty" style="padding: 28px 16px;">
            <i class="fa-regular fa-folder-open" aria-hidden="true"></i>
            <h2>No files yet</h2>
            <p>Upload your first file above.</p>
          </div>
        <% } %>
      </section>

      <section class="gp-card preview-card" id="filePreviewContainer">
        <div class="gp-card__head"><h2 class="gp-card__title">File preview</h2></div>
        <input type="text" id="searchFileContent" placeholder="Search inside this file" />
        <iframe id="filePreview" title="File preview"></iframe>
        <pre id="csvPreview"></pre>
      </section>
    </div>

    <script>
      // Show the chosen file's name in the upload box.
      (function () {
        const input = document.getElementById('file');
        const label = document.querySelector('[data-mg-file-label]');
        if (input && label) input.addEventListener('change', () => {
          label.textContent = input.files && input.files[0] ? input.files[0].name : 'Choose a CSV or PDF file';
        });
      })();
    </script>

    <script>
      function escapeHtml(str) {
        return String(str)
          .replace(/&/g, "&amp;")
          .replace(/</g, "&lt;")
          .replace(/>/g, "&gt;")
          .replace(/"/g, "&quot;")
          .replace(/'/g, "&#039;");
      }
      $(document).ready(function () {
        // Handle file preview
        $(".view-file").click(async function (e) {
          e.preventDefault();
          var fileUrl = $(this).data("file");

          if (!fileUrl) {
            alert("Error: File URL missing.");
            return;
          }

          let fileExtension = fileUrl.split("?")[0].split(".").pop().toLowerCase();
          $("#filePreviewContainer").show();
          $("#searchFileContent").val("");

          if (fileExtension === "pdf") {
            $("#filePreview").attr("src", fileUrl).show();
            $("#csvPreview").hide();
          } else if (fileExtension === "csv") {
            $("#filePreview").hide();
            $("#csvPreview").show().text("Loading...");

            try {
              let response = await fetch(fileUrl);
              let csvText = await response.text();
              $("#csvPreview").text(csvText);
            } catch (error) {
              console.error("Error loading CSV file:", error);
              $("#csvPreview").text("Error loading CSV file.");
            }
          } else {
            alert("Unsupported file type.");
          }
        });

        // Search inside the previewed file content
        $("#searchFileContent").on("input", function () {
          let searchValue = $(this).val().toLowerCase();
          let content = $("#csvPreview").text();

          if (!searchValue) {
            $("#csvPreview").html(content);
            return;
          }

          let highlightedText = content.replace(
            new RegExp(escapeHtml(searchValue), "gi"),
            (match) => `<span class="highlight">${match}</span>`
          );

          $("#csvPreview").html(highlightedText);
        });

        // Delete Confirmation
        $(".delete-file").click(function (e) {
          e.preventDefault();
          if (confirm("Are you sure you want to delete this file?")) {
            window.location.href = "/print/delete/" + $(this).data("file");
          }
        });
      });
    </script>
  </body>
</html>