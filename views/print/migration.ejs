<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= title %></title>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <style>
      :root {
        --font-family: "<%= (session && session.fontStyle ? String(session.fontStyle).trim() : 'Inter') %>", sans-serif;
        --border: #e5e7eb;
        --bg: #f9fafb;
      }

      body {
        font-family: var(--font-family);
        background-color: var(--bg);
        color: #333;
        margin: 0;
        padding: 0;
      }

      .migration-wrapper {
        max-width: 900px;
        margin: 0 auto;
        padding: 0 20px 60px;
      }

      .page-banner {
        background: var(--org-primary-color, #01535b);
        color: white;
        padding: 28px 20px;
        text-align: center;
        margin-bottom: 32px;
        width: 100%;
      }

      .page-banner h1 {
        margin: 0 0 6px 0;
        font-size: 24px;
        font-weight: 700;
      }

      .page-banner p {
        margin: 0;
        opacity: 0.9;
        font-size: 14px;
      }

      /* Notice */
      .migration-notice {
        background: #eff6ff;
        border-left: 4px solid #3b82f6;
        border-radius: 0 8px 8px 0;
        padding: 16px 20px;
        margin-bottom: 24px;
      }

      .migration-notice h2 {
        font-size: 15px;
        margin: 0 0 6px;
        font-weight: 700;
        color: #1e40af;
      }

      .migration-notice p {
        margin: 0;
        font-size: 14px;
        line-height: 1.6;
        color: #1e40af;
      }

      /* Upload Card */
      .upload-card {
        background: white;
        border: 1px solid var(--border);
        border-radius: 12px;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.06);
        padding: 28px;
        margin-bottom: 24px;
      }

      .upload-card h3 {
        font-size: 18px;
        font-weight: 700;
        color: #111827;
        margin: 0 0 16px;
        text-align: center;
      }

      .upload-card form {
        display: flex;
        flex-direction: column;
        gap: 14px;
        max-width: 100%;
        margin: 0;
        padding: 0;
        box-shadow: none;
        background: none;
        border-radius: 0;
      }

      .upload-card input[type="file"] {
        width: 100%;
        padding: 12px 14px;
        border: 2px dashed var(--border);
        border-radius: 8px;
        font-size: 14px;
        font-family: var(--font-family);
        background: #fafafa;
        cursor: pointer;
        box-sizing: border-box;
      }

      .upload-card input[type="file"]:hover {
        border-color: var(--org-primary-color, #01535b);
      }

      .upload-card button[type="submit"] {
        background: var(--org-primary-color, #01535b);
        color: white;
        padding: 12px 24px;
        border: none;
        border-radius: 8px;
        cursor: pointer;
        font-size: 15px;
        font-weight: 600;
        transition: all 0.2s ease;
        width: 100%;
      }

      .upload-card button[type="submit"]:hover {
        background: var(--org-primary-hover, #014a51);
      }

      /* Files List */
      .files-card {
        background: white;
        border: 1px solid var(--border);
        border-radius: 12px;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.06);
        padding: 28px;
        margin-bottom: 24px;
      }

      .files-card h3 {
        font-size: 18px;
        font-weight: 700;
        color: #111827;
        margin: 0 0 16px;
        text-align: center;
      }

      .files-card ul {
        list-style: none;
        padding: 0;
        margin: 0;
      }

      .files-card li {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 14px 16px;
        border: 1px solid var(--border);
        border-radius: 8px;
        margin-bottom: 10px;
        background: #fafafa;
        transition: border-color 0.2s;
        flex-wrap: wrap;
        gap: 8px;
      }

      .files-card li:hover {
        border-color: var(--org-primary-color, #01535b);
      }

      .file-name {
        font-weight: 600;
        color: #111827;
        font-size: 14px;
        flex: 1;
        min-width: 100px;
      }

      .file-actions {
        display: flex;
        gap: 10px;
        align-items: center;
        flex-wrap: wrap;
      }

      .file-actions a {
        font-size: 13px;
        font-weight: 600;
        text-decoration: none;
        padding: 6px 14px;
        border-radius: 6px;
        transition: all 0.2s;
        cursor: pointer;
      }

      .file-actions .view-file {
        background: #eff6ff;
        color: #2563eb;
        border: 1px solid #bfdbfe;
      }

      .file-actions .view-file:hover {
        background: #2563eb;
        color: white;
      }

      .file-actions a[download] {
        background: #f0fdf4;
        color: #16a34a;
        border: 1px solid #bbf7d0;
      }

      .file-actions a[download]:hover {
        background: #16a34a;
        color: white;
      }

      .file-actions .delete-file {
        background: #fef2f2;
        color: #dc2626;
        border: 1px solid #fecaca;
      }

      .file-actions .delete-file:hover {
        background: #dc2626;
        color: white;
      }

      .empty-state {
        text-align: center;
        color: #6b7280;
        padding: 32px 20px;
        font-size: 14px;
      }

      /* File Preview */
      .preview-card {
        background: white;
        border: 1px solid var(--border);
        border-radius: 12px;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.06);
        padding: 28px;
        margin-bottom: 24px;
        display: none;
      }

      .preview-card h3 {
        font-size: 18px;
        font-weight: 700;
        color: #111827;
        margin: 0 0 16px;
        text-align: center;
      }

      .preview-card input[type="text"] {
        width: 100%;
        padding: 10px 16px;
        border: 1px solid var(--border);
        border-radius: 8px;
        font-size: 14px;
        font-family: var(--font-family);
        margin-bottom: 16px;
        box-sizing: border-box;
      }

      .preview-card iframe {
        border: 1px solid var(--border);
        border-radius: 8px;
        width: 100%;
        height: 500px;
      }

      .preview-card pre {
        display: none;
        border: 1px solid var(--border);
        border-radius: 8px;
        width: 100%;
        max-height: 600px;
        overflow: auto;
        padding: 16px;
        background: #fafafa;
        text-align: left;
        white-space: pre-wrap;
        font-family: var(--font-family);
        font-size: 13px;
        line-height: 1.6;
        box-sizing: border-box;
      }

      .highlight {
        background-color: #fef08a;
        padding: 1px 2px;
        border-radius: 2px;
      }

      @media (max-width: 768px) {
        .migration-wrapper {
          padding: 0 16px 40px;
        }

        .page-banner h1 {
          font-size: 20px;
        }

        .upload-card,
        .files-card,
        .preview-card {
          padding: 20px;
        }

        .files-card li {
          flex-direction: column;
          align-items: flex-start;
        }

        .file-actions {
          width: 100%;
          justify-content: flex-start;
        }

        .preview-card iframe {
          height: 300px;
        }

        .preview-card pre {
          max-height: 300px;
        }
      }
    </style>
  </head>
  <body>
    <%- include('../partials/flash') %>

    <div class="page-banner">
      <h1>📁 Data Migration</h1>
      <p>Upload, store, and manage files from your previous platform</p>
    </div>

    <div class="migration-wrapper">
      <!-- Notice Section -->
      <div class="migration-notice">
        <h2>ℹ️ About This Page</h2>
        <p>
          This section stores and manages all data files migrated from a different platform. 
          Files are securely stored and accessible only to authorized users. 
          Upload CSV or PDF files, then view, search, or download them anytime.
        </p>
      </div>

      <!-- Upload Section -->
      <div class="upload-card">
        <h3>Upload File</h3>
        <form
          action="/print/upload"
          method="POST"
          enctype="multipart/form-data"
        >
          <input
            type="file"
            name="file"
            id="file"
            accept=".csv,.pdf"
            required
          />
          <button type="submit">Upload File</button>
        </form>
      </div>

      <!-- Uploaded Files -->
      <div class="files-card">
        <h3>Uploaded Files</h3>
        <% if (Array.isArray(uploadedFiles) && uploadedFiles.length > 0) { %>
        <ul>
          <% uploadedFiles.forEach(file => { %>
          <li>
            <span class="file-name"><%= file.file_name %></span>
            <div class="file-actions">
              <a href="#" class="view-file" data-file="<%= file.s3_url %>">View</a>
              <a href="<%= file.s3_url %>" download>Download</a>
              <a href="#" class="delete-file" data-file="<%= file.file_name %>">Delete</a>
            </div>
          </li>
          <% }) %>
        </ul>
        <% } else { %>
        <div class="empty-state">
          <p>No files uploaded yet. Use the upload section above to add your first file.</p>
        </div>
        <% } %>
      </div>

      <!-- File Preview -->
      <div class="preview-card" id="filePreviewContainer">
        <h3>File Preview</h3>
        <input
          type="text"
          id="searchFileContent"
          placeholder="🔍 Search inside file..."
        />
        <iframe id="filePreview"></iframe>
        <pre id="csvPreview"></pre>
      </div>
    </div>

    <script>
      function escapeHtml(str) {
        return String(str)
          .replace(/&/g, "&amp;")
          .replace(/</g, "&lt;")
          .replace(/>/g, "&gt;")
          .replace(/"/g, "&quot;")
          .replace(/'/g, "&#039;");
      }
      $(document).ready(function () {
        // Handle file preview
        $(".view-file").click(async function (e) {
          e.preventDefault();
          var fileUrl = $(this).data("file");

          if (!fileUrl) {
            alert("Error: File URL missing.");
            return;
          }

          let fileExtension = fileUrl.split(".").pop().toLowerCase();
          $("#filePreviewContainer").show();
          $("#searchFileContent").val("");

          if (fileExtension === "pdf") {
            $("#filePreview").attr("src", fileUrl).show();
            $("#csvPreview").hide();
          } else if (fileExtension === "csv") {
            $("#filePreview").hide();
            $("#csvPreview").show().text("Loading...");

            try {
              let response = await fetch(fileUrl);
              let csvText = await response.text();
              $("#csvPreview").text(csvText);
            } catch (error) {
              console.error("Error loading CSV file:", error);
              $("#csvPreview").text("Error loading CSV file.");
            }
          } else {
            alert("Unsupported file type.");
          }
        });

        // Search inside the previewed file content
        $("#searchFileContent").on("input", function () {
          let searchValue = $(this).val().toLowerCase();
          let content = $("#csvPreview").text();

          if (!searchValue) {
            $("#csvPreview").html(content);
            return;
          }

          let highlightedText = content.replace(
            new RegExp(escapeHtml(searchValue), "gi"),
            (match) => `<span class="highlight">${match}</span>`
          );

          $("#csvPreview").html(highlightedText);
        });

        // Delete Confirmation
        $(".delete-file").click(function (e) {
          e.preventDefault();
          if (confirm("Are you sure you want to delete this file?")) {
            window.location.href = "/print/delete/" + $(this).data("file");
          }
        });
      });
    </script>
  </body>
</html>