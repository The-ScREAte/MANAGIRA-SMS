<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="<%= locals.viewportContent || 'width=device-width, initial-scale=1.0' %>" />
    <title><%= title %></title>
    <style>
      :root {
        --font-family: "<%= (session && session.fontStyle ? String(session.fontStyle).trim() : 'Inter') %>", sans-serif;
        --primary: var(--org-primary-color, #0f5a66);
        --primary-hover: var(--org-primary-hover, #0d4f59);
        --primary-hover-fill: color-mix(in srgb, var(--primary) 88%, white);
        --muted: #475569;
        --bg: #f6f8fb;
        --card: #ffffff;
        --border: #e2e8f0;
      }

      body {
          font-family: var(--font-family);
        }
        
  </style>
    <style>
      body {
        background-color: var(--bg);
        margin: 0;
      }

      /* One full-width surface: the page already sits inside the app's own
         panel, so no extra card border, shadow or margin here. */
      .container {
        position: relative;
        box-sizing: border-box;
        width: 100%;
        max-width: none;
        margin: 0;
        padding: 24px 28px;
        background-color: var(--card);
      }

      .header {
        display: flex;
        align-items: center;
        gap: 16px;
        justify-content: center;
        margin-bottom: 30px;
        text-align: left;
      }

      .header img {
        width: 80px;
        height: 80px;
        object-fit: contain;
        border: 1px solid var(--border);
        border-radius: 10px;
        padding: 6px;
      }

      .header-text { display: flex; flex-direction: column; justify-content: center; gap: 4px; }

      .header-text h1,
      .header-text h2,
      .header-text h3 {
        margin: 0;
        text-align: left;
      }

      .header-text h1 { color: var(--primary); }
      .header-text h2 { color: #0f172a; font-weight: 700; }
      .header-text h3 { color: var(--muted); font-weight: 600; }

      .note {
        margin-bottom: 20px;
        text-align: center;
        color: var(--muted);
        font-size: 16px;
      }

      .form-section {
        margin-bottom: 40px;
      }

      /* ---------- Selection form ---------- */
      .form-message {
        margin: 0 0 16px;
        padding: 10px 14px;
        border-radius: 8px;
        border: 1px solid #fecaca;
        background: #fef2f2;
        color: #991b1b;
        font-size: 14px;
        text-align: center;
      }

      .merit-panel {
        margin-bottom: 20px;
        border: 1px solid var(--border);
        border-radius: 12px;
        background: #ffffff;
        overflow: hidden;
      }

      .merit-panel-header {
        display: flex;
        flex-wrap: nowrap;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        padding: 14px 16px;
        border-bottom: 1px solid var(--border);
        background: #ffffff;
      }

      .merit-panel-title {
        margin: 0;
        color: #0f172a;
        font-size: 15px;
      }

      .merit-panel-hint {
        margin: 4px 0 0;
        color: var(--muted);
        font-size: 13px;
      }

      .merit-toolbar {
        display: flex;
        flex: 0 0 auto;
        flex-wrap: nowrap;
        align-items: center;
        gap: 4px;
      }

      .merit-panel-header > div:first-child {
        flex: 1 1 260px;
      }

      /* Buttons here set their own box: the site stylesheet makes every
         <button> a full-width block. */
      .merit-link-btn {
        display: inline-flex;
        width: auto;
        margin: 0;
        padding: 6px 10px;
        border: 0;
        border-radius: 6px;
        background: none;
        color: var(--primary);
        font: inherit;
        font-size: 13px;
        font-weight: 600;
        cursor: pointer;
      }

      .merit-link-btn:hover,
      .merit-link-btn:focus-visible {
        background: color-mix(in srgb, var(--primary) 10%, white);
      }

      .subject-card {
        border-bottom: 1px solid var(--border);
      }

      .subject-card:last-child {
        border-bottom: 0;
      }

      .subject-card-header {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 0 16px;
      }

      .subject-checkbox,
      .assessment-checkbox,
      .column-option input {
        flex: 0 0 auto;
        width: 17px;
        height: 17px;
        margin: 0;
        accent-color: var(--primary);
        cursor: pointer;
      }

      .subject-toggle {
        flex: 1;
        width: auto;
        margin: 0;
        display: flex;
        align-items: center;
        gap: 12px;
        min-height: 50px;
        padding: 0;
        border: 0;
        background: none;
        color: #0f172a;
        font: inherit;
        text-align: left;
        cursor: pointer;
      }

      .subject-toggle:hover,
      .subject-toggle:focus,
      .subject-toggle:active {
        background: none;
        color: #0f172a;
      }

      .subject-toggle:focus-visible {
        outline: 2px solid var(--primary);
        outline-offset: 2px;
        border-radius: 6px;
      }

      .subject-toggle:disabled {
        cursor: default;
      }

      .subject-name {
        flex: 1;
        font-size: 15px;
        font-weight: 700;
      }

      .subject-count {
        padding: 3px 10px;
        border-radius: 999px;
        background: #f1f5f9;
        color: var(--muted);
        font-size: 12.5px;
        white-space: nowrap;
      }

      .subject-card.has-selection .subject-count {
        background: color-mix(in srgb, var(--primary) 12%, white);
        color: var(--primary);
        font-weight: 600;
      }

      .subject-chevron {
        color: var(--muted);
        transition: transform 0.2s ease;
      }

      .subject-toggle[aria-expanded="true"] .subject-chevron {
        transform: rotate(180deg);
      }

      .subject-card.is-empty .subject-name {
        color: #94a3b8;
      }

      .subject-card.is-empty .subject-chevron {
        visibility: hidden;
      }

      .subject-card-body {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
        gap: 8px;
        padding: 4px 16px 16px 45px;
      }

      .subject-card-body[hidden] {
        display: none;
      }

      .assessment-option,
      .column-option {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 9px 12px;
        border: 1px solid var(--border);
        border-radius: 8px;
        background: #ffffff;
        font-size: 14px;
        cursor: pointer;
        transition: border-color 0.15s ease, background-color 0.15s ease;
      }

      .assessment-option:hover,
      .column-option:hover {
        border-color: color-mix(in srgb, var(--primary) 40%, white);
      }

      .assessment-option:has(input:checked),
      .column-option:has(input:checked) {
        border-color: var(--primary);
        background: color-mix(in srgb, var(--primary) 6%, white);
      }

      .assessment-title {
        flex: 1;
        color: #0f172a;
      }

      .assessment-weight {
        color: var(--muted);
        font-size: 12px;
      }

      .column-options {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        padding: 16px;
      }

      .column-option {
        border-radius: 999px;
        padding: 9px 16px;
      }

      table {
        width: 100%;
        border-collapse: collapse;
        table-layout: fixed;
        margin-top: 20px;
      }

      .merit-sheet {
        position: relative;
        overflow-x: auto;
      }

      .merit-sheet table {
        position: relative;
        z-index: 1;
        background: transparent;
      }

      .merit-sheet-watermark-logo {
        position: absolute;
        left: 50%;
        top: 96px;
        transform: translateX(-50%);
        width: min(46vw, 560px);
        max-height: calc(100% - 110px);
        opacity: 0.11;
        z-index: 0;
        pointer-events: none;
        object-fit: contain;
      }

      .print-watermark-page {
        display: none;
      }

      .merit-sheet .col-sn { width: 56px; }
      .merit-sheet .col-student-id { width: 74px; }
      .merit-sheet .col-student-name { width: 150px; }
      .merit-sheet .col-assessment { width: 60px; }
      .merit-sheet .col-grade { width: 48px; }
      .merit-sheet .col-total { width: 76px; }
      .merit-sheet .col-average { width: 70px; }
      .merit-sheet .col-percentage { width: 80px; }
      .merit-sheet .col-gender { width: 64px; }
      .merit-sheet .col-subject-total { width: 66px; }
      .merit-sheet .col-overall-grade { width: 60px; }
      .merit-sheet .col-remark { width: 150px; }
      .merit-sheet .subject-total-cell { font-weight: 700; }
      .merit-sheet td.remark-cell { white-space: normal; text-align: left; }
      .merit-sheet .col-position { width: 68px; }

        table, th, td {
            border: 1.5px solid var(--primary);
        }

      th {
        background: linear-gradient(135deg, var(--primary), var(--primary-hover));
        color: #ffffff;
        padding: 6px;
        vertical-align: middle;
      }

      td {
        padding: 5px 4px;
        text-align: center;
      }

      .merit-sheet td.student-name-cell,
      .merit-sheet th.student-name-cell {
        white-space: normal;
        word-break: break-word;
      }

      .rotated-header {
        position: static;
        height: 84px;
        min-width: 54px;
        padding: 6px 4px;
        vertical-align: middle;
        text-align: center;
        overflow: hidden;
        color: #ffffff;
      }

      .rotated-header .header-label {
        position: static;
        left: auto;
        bottom: auto;
        display: block;
        width: 100%;
        line-height: 1.2;
        white-space: normal;
        word-break: break-word;
        text-align: center;
        margin: 0 auto;
        transform: none;
        transform-origin: center;
      }

      .student-id-header,
      .grade-header,
      .total-header,
      .average-header,
      .percentage-header,
      .gender-header,
      .overall-grade-header,
      .position-header {
        padding: 0;
      }

      .student-id-header .header-label,
      .grade-header .header-label,
      .total-header .header-label,
      .average-header .header-label,
      .percentage-header .header-label,
      .gender-header .header-label,
      .overall-grade-header .header-label,
      .position-header .header-label {
        display: inline-block;
        width: auto;
        white-space: nowrap;
        line-height: 1;
        transform: rotate(-62deg);
        transform-origin: center;
      }

        .btn {
            display: block;
            width: fit-content;
            margin: 20px auto;
            padding: 10px 20px;
          background-color: var(--primary);
            color: white;
            border: none;
            border-radius: 5px;
            cursor: pointer;
            font-family: inherit;
            font-size: 14px;
            font-weight: 600;
            line-height: 1.2;
            text-decoration: none;
        }

        .btn:hover {
          background-color: var(--primary-hover-fill, var(--primary-hover));
        }

      .btn-secondary {
        border: 1px solid var(--primary);
        background: #ffffff;
        color: var(--primary);
        text-decoration: none;
      }

      .btn-secondary:hover {
        background: color-mix(in srgb, var(--primary) 8%, white);
      }

      .merit-sheet-actions {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 12px;
      }

      .merit-sheet-actions .btn {
        margin: 20px 0;
      }

      .merit-sheet-actions .btn[disabled] {
        opacity: 0.7;
        cursor: progress;
      }

      .no-data {
        text-align: center;
        font-size: 16px;
        color: #888;
      }

      .form-section,
      .print-section {
        position: relative;
        z-index: 1;
        /* The card is a flex container; without this the section grows to
           the table's full width and spills outside the card. The table
           scrolls sideways inside the card instead. */
        min-width: 0;
        max-width: 100%;
      }

      .print-section .header,
      .print-section .merit-sheet {
        position: relative;
        z-index: 1;
      }

      /* Header names run vertically (reading upwards), wrapped onto several
         short lines and centred, so every name stays inside its own column
         however long it is. */
      .merit-sheet table thead th.slanted-header {
        height: 150px;
        padding: 6px 2px;
        vertical-align: middle;
        text-align: center;
        overflow: hidden;
        writing-mode: horizontal-tb;
        transform: none;
      }

      .merit-sheet table thead th.slanted-header .header-label {
        position: static;
        display: inline-block;
        width: auto;
        max-height: 112px;
        margin: 0 auto;
        writing-mode: vertical-rl;
        transform: rotate(180deg);
        white-space: normal;
        word-break: normal;
        overflow-wrap: anywhere;
        text-align: center;
        line-height: 1.15;
      }

      /* Alternate column shading so columns are easy to follow. */
      .merit-sheet.merit-sheet table tbody tr td:nth-child(odd) {
        background: transparent;
      }

      .merit-sheet.merit-sheet table tbody tr td:nth-child(even) {
        background: color-mix(in srgb, var(--primary) 9%, transparent);
      }

      .merit-sheet.merit-sheet table thead tr th:nth-child(even) {
        background: color-mix(in srgb, var(--primary) 12%, #f3f4f6);
      }

      /* Subject and assessment each start a new line. */
      .merit-sheet table thead th.slanted-header .label-line {
        display: block;
      }

      @media print {
        body * {
          visibility: hidden;
        }

        .print-section,
        .print-section * {
          visibility: visible;
        }

        html,
        body {
          background: #ffffff !important;
          margin: 0;
          padding: 0;
        }

        .print-section {
          position: static;
          width: auto;
          padding: 0;
          box-sizing: border-box;
        }

        .print-section,
        .print-section * {
          position: relative;
          z-index: 1;
        }

        #print-wm {
          visibility: visible !important;
          position: fixed !important;
          inset: 0 !important;
          display: flex !important;
          align-items: center !important;
          justify-content: center !important;
          z-index: 0 !important;
          pointer-events: none !important;
        }

        #print-wm img {
          visibility: visible !important;
          opacity: 0.08 !important;
        }

        .btn { display: none !important; visibility: hidden !important; }

        body { -webkit-print-color-adjust: exact; print-color-adjust: exact; }
        * { -webkit-print-color-adjust: exact; print-color-adjust: exact; }
        th { -webkit-print-color-adjust: exact; print-color-adjust: exact; }
        td { -webkit-print-color-adjust: exact; print-color-adjust: exact; }
        .container {
          width: 100%;
          margin: 0;
          box-shadow: none;
          border: 0;
          border-radius: 0;
          padding: 8px;
          background: #ffffff;
        }

        .header {
          margin-bottom: 10px;
          gap: 10px;
        }

        .header img {
          width: 56px;
          height: 56px;
          padding: 3px;
        }

        .header-text h1 {
          font-size: 17px;
          line-height: 1.2;
        }

        .header-text h2 {
          font-size: 13px;
          line-height: 1.2;
        }

        .header-text h3 {
          font-size: 12px;
          line-height: 1.2;
        }

        .print-section .header .header-text h2:last-child {
          font-size: 14px;
          margin-top: 2px;
        }

        .merit-sheet {
          overflow: visible;
        }

        .merit-sheet table { border: 1.5px solid var(--primary); }
        .merit-sheet-watermark-logo { display: none; }
        @page { size: A4 landscape; margin: 12mm 10mm; }

        table {
          page-break-inside: auto; /* Prevents breaking table rows between pages */
        }

        thead {
          display: table-row-group;
        }

        tbody {
          display: table-row-group;
        }

        tr {
          page-break-inside: avoid; /* Keeps rows intact */
          page-break-after: auto;
        }

        th, td {
          border: 1px solid var(--primary) !important;
          font-size: 10px !important;
          font-weight: normal !important;
          padding: 2px 3px !important;
          vertical-align: middle !important;
          line-height: 1 !important;
          white-space: nowrap !important;
          overflow: hidden !important;
          text-overflow: ellipsis !important;
          height: 22px !important;
          max-height: 22px !important;
        }

        th {
          background: linear-gradient(135deg, var(--primary), var(--primary-hover)) !important;
          color: #ffffff !important;
          font-weight: normal !important;
        }

        .rotated-header {
          writing-mode: horizontal-tb !important;
          height: 70px !important;
          min-width: 64px;
          padding: 6px 5px;
          overflow: visible;
          transform: none !important;
        }

        .rotated-header .header-label {
          writing-mode: horizontal-tb !important;
          transform: none !important;
          white-space: normal;
          line-height: 1.2;
          width: 100%;
          display: block;
        }

        .student-id-header .header-label,
        .grade-header .header-label,
        .total-header .header-label,
        .average-header .header-label,
        .percentage-header .header-label,
        .gender-header .header-label,
        .overall-grade-header .header-label,
        .position-header .header-label {
          writing-mode: horizontal-tb !important;
          transform: rotate(-62deg) !important;
          white-space: nowrap !important;
          width: auto;
          display: inline-block;
          line-height: 1;
        }

        .merit-sheet .col-sn { width: 44px; }
        .merit-sheet .col-student-id { width: 72px; }
        .merit-sheet .col-student-name { width: 180px; }
        .merit-sheet .col-assessment { width: 48px; }
        .merit-sheet .col-grade { width: 48px; }
        .merit-sheet .col-total { width: 72px; }
        .merit-sheet .col-average { width: 72px; }
        .merit-sheet .col-percentage { width: 76px; }
        .merit-sheet .col-gender { width: 56px; }
        .merit-sheet .col-subject-total { width: 54px; }
        .merit-sheet .col-overall-grade { width: 56px; }
        .merit-sheet .col-remark { width: 140px; }

        /* One even header band (a gradient per cell would show seams). */
        .merit-sheet table thead th {
          background: var(--primary) !important;
        }

        .merit-sheet table thead th.slanted-header {
          height: 118px !important;
          max-height: none !important;
          padding: 4px 1px !important;
          vertical-align: middle !important;
          text-align: center !important;
          overflow: hidden !important;
        }

        .merit-sheet table thead th.slanted-header .header-label {
          position: static !important;
          display: inline-block !important;
          width: auto !important;
          max-height: 96px !important;
          margin: 0 auto !important;
          writing-mode: vertical-rl !important;
          transform: rotate(180deg) !important;
          white-space: normal !important;
          overflow-wrap: anywhere !important;
          text-align: center !important;
          line-height: 1.1 !important;
        }

        .merit-sheet.merit-sheet table thead tr th:nth-child(even) {
          background: color-mix(in srgb, var(--primary) 80%, black) !important;
        }

        .merit-sheet table thead th.slanted-header .label-line {
          display: block !important;
        }

        .merit-sheet.merit-sheet table tbody tr td:nth-child(even) {
          background: color-mix(in srgb, var(--primary) 10%, transparent) !important;
        }
        .merit-sheet .col-position { width: 68px; }

        .merit-sheet td.student-name-cell,
        .merit-sheet th.student-name-cell {
          text-align: left;
          padding-left: 6px;
        }

        .merit-sheet th.student-name-cell .header-label {
          white-space: normal;
          word-break: break-word;
        }

        .merit-sheet td.student-name-cell {
          white-space: nowrap;
          overflow: hidden;
          text-overflow: ellipsis;
          text-align: left;
          padding-left: 6px;
        }
        }

        @media (max-width: 768px) {
       
        
            .container {
                width: 100%;
                padding: 10px;
                margin: 5px auto;
                border-radius: 6px;
                box-shadow: none;
                overflow-x: auto; /* Enables horizontal scrolling */
            }
        
            .header img {
                text-align: center;
                margin-bottom: 30px;
            }
        
            h1, h2, h3 {
                text-align: center;
                margin-bottom: 10px;
            }
              .header-text h1, .header-text h2, .header-text h3 { text-align: left; }
        
            .form-section {
                margin-bottom: 20px;
            }
        
            .subject-card-header {
                padding: 0 12px;
            }

            .subject-card-body {
                grid-template-columns: 1fr;
                padding: 4px 12px 14px;
            }

            .merit-panel-header {
                flex-wrap: wrap;
            }
        
            /* Enables table scrolling without breaking layout */
            .merit-sheet {
                overflow-x: auto;
                max-width: 100%;
            }
        
            table {
                width: max-content; /* Allows scrolling instead of shrinking */
                border-collapse: collapse;
                white-space: nowrap;
            }
        
            th, td {
                padding: 8px;
                border: 1px solid #000;
            }
        
            .rotated-header {
                writing-mode: vertical-rl;
                transform: rotate(180deg);
                text-align: center;
                white-space: nowrap;
            }
        
            /* Ensure buttons stay visible and accessible */
            .btn {
                width: 100%;
                max-width: 300px;
                margin: 10px auto;
                font-size: 1rem;
                text-align: center;
                display: block;
            }
        }
        
    </style>
  </head>

  <body>
    <% const effectiveLogo = logoUrl || (session && session.logo) || null; %>
    <div class="container">
      <!-- Form Section -->
      <% if (!meritSheet || meritSheet.length === 0) { %>
      <div class="form-section">
        <div class="header">
          <% if (effectiveLogo) { %>
          <img src="<%= effectiveLogo %>" alt="School Logo" />
          <% } %>
          <div class="header-text">
            <h1><%= orgName %></h1>
            <h2>School Year: <%= schoolYear %></h2>
            <h3> <%= termName %> | <%= className %></h3>
          </div>
        </div>
        <%
          const priorSelection = (typeof previousSelection !== 'undefined' && previousSelection) ? previousSelection : { assessmentIds: [], columns: {} };
          const preselectedAssessmentIds = new Set((priorSelection.assessmentIds || []).map(Number));
          const hasPriorColumns = priorSelection.columns && Object.keys(priorSelection.columns).length > 0;
          const columnChecked = (key, fallback) => (hasPriorColumns ? priorSelection.columns[key] === true : fallback) ? 'checked' : '';
        %>
        <p class="note">
          Choose the subjects and assessments to include and the columns to show, then generate the merit sheet.
        </p>

        <div id="formMessage" class="form-message" role="alert" hidden></div>

        <form
          id="meritSheetForm"
          onsubmit="return validateMeritSheetForm()"
          action="/print/generateMeritSheet"
          method="POST"
        >
          <input type="hidden" name="classId" value="<%= classId %>" />
          <input type="hidden" name="termId" value="<%= termId %>" />

          <section class="merit-panel" aria-labelledby="meritSubjectsTitle">
            <div class="merit-panel-header">
              <div>
                <h4 id="meritSubjectsTitle" class="merit-panel-title">Subjects &amp; assessments</h4>
                <p class="merit-panel-hint" id="meritSelectionSummary">No assessments selected</p>
              </div>
              <div class="merit-toolbar">
                <button type="button" class="merit-link-btn" data-merit-action="select-all">Select all</button>
                <button type="button" class="merit-link-btn" data-merit-action="clear-all">Clear</button>
              </div>
            </div>

            <div class="subject-list">
              <% subjects.forEach(subject => { %>
              <% const hasAssessments = subject.assessments.length > 0; %>
              <div class="subject-card<%= hasAssessments ? '' : ' is-empty' %>" data-subject-id="<%= subject.subject_id %>">
                <div class="subject-card-header">
                  <input
                    type="checkbox"
                    class="subject-checkbox"
                    name="selectedSubjects[]"
                    value="<%= subject.subject_id %>"
                    aria-label="Select all assessments in <%= subject.subject_name %>"
                    <%= hasAssessments ? '' : 'disabled' %>
                  />
                  <button
                    type="button"
                    class="subject-toggle"
                    aria-expanded="false"
                    aria-controls="subject-body-<%= subject.subject_id %>"
                    <%= hasAssessments ? '' : 'disabled' %>
                  >
                    <span class="subject-name"><%= subject.subject_name %></span>
                    <span class="subject-count" data-total="<%= subject.assessments.length %>">
                      <%= hasAssessments ? `0 of ${subject.assessments.length} selected` : 'No assessments' %>
                    </span>
                    <svg class="subject-chevron" viewBox="0 0 20 20" width="18" height="18" aria-hidden="true"><path fill="currentColor" d="M5.3 7.3a1 1 0 0 1 1.4 0L10 10.6l3.3-3.3a1 1 0 1 1 1.4 1.4l-4 4a1 1 0 0 1-1.4 0l-4-4a1 1 0 0 1 0-1.4z"/></svg>
                  </button>
                </div>
                <% if (hasAssessments) { %>
                <div class="subject-card-body" id="subject-body-<%= subject.subject_id %>" hidden>
                  <% subject.assessments.forEach(assessment => { %>
                  <label class="assessment-option">
                    <input
                      type="checkbox"
                      class="assessment-checkbox"
                      name="selectedAssessments[]"
                      value="<%= assessment.assessment_id %>"
                      <%= preselectedAssessmentIds.has(Number(assessment.assessment_id)) ? 'checked' : '' %>
                    />
                    <span class="assessment-title"><%= assessment.title %></span>
                    <span class="assessment-weight"><%= assessment.weight %>%</span>
                  </label>
                  <% }); %>
                </div>
                <% } %>
              </div>
              <% }); %>
            </div>
          </section>

          <section class="merit-panel" aria-labelledby="meritColumnsTitle">
            <div class="merit-panel-header">
              <div>
                <h4 id="meritColumnsTitle" class="merit-panel-title">Columns to show</h4>
                <p class="merit-panel-hint">S/N, student name and assessment scores are always shown. Overall grade and remark follow the grading scale in Report Settings.</p>
              </div>
            </div>
            <!-- Always sent so "all optional columns off" is kept as chosen. -->
            <input type="hidden" name="columns[]" value="name" />
            <div class="column-options">
              <% [
                ['studentId', 'Student ID', true],
                ['gender', 'Gender', false],
                ['grade', 'Grade per assessment', true],
                ['subjectTotal', 'Subject total', false],
                ['total', 'Total Score', true],
                ['average', 'Average', true],
                ['percentage', 'Percentage', false],
                ['overallGrade', 'Overall grade', false],
                ['position', 'Position', true],
                ['remark', 'Remark', false],
              ].forEach(([key, label, defaultOn]) => { %>
              <label class="column-option"><input type="checkbox" name="columns[]" value="<%= key %>" <%= columnChecked(key, defaultOn) %> /><span><%= label %></span></label>
              <% }); %>
            </div>
          </section>

          <button type="submit" class="btn merit-generate-btn">Generate Merit Sheet</button>
        </form>
      </div>
      <% } %>

      <!-- Merit Sheet Section -->
      <% if (meritSheet && meritSheet.length > 0) { %>
      <div class="print-section">
        <div class="header">
          <% if (effectiveLogo) { %>
          <img src="<%= effectiveLogo %>" alt="School Logo" />
          <% } %>
          <div class="header-text">
            <h1><%= orgName %></h1>
            <h2>School Year: <%= schoolYear %></h2>
            <h3> <%= termName %> | <%= className %></h3>
            <h2>Class Order of Merit Sheet</h2>
          </div>
        </div>

        <div class="merit-sheet">
          <% if (effectiveLogo) { %>
          <img src="<%= effectiveLogo %>" alt="School Watermark" class="merit-sheet-watermark-logo" />
          <% } %>
          <%
            const cols = (typeof meritColumns !== 'undefined' && meritColumns)
              ? meritColumns
              : { studentId: true, grade: true, total: true, average: true, position: true };
            let assessmentGroup = 0;
          %>
          <table>
            <colgroup>
              <col class="col-sn" />
              <% if (cols.studentId) { %><col class="col-student-id" /><% } %>
              <col class="col-student-name" />
              <% if (cols.gender) { %><col class="col-gender" /><% } %>
              <% subjects.forEach(subject => { %>
                <% subject.assessments.forEach(() => { %>
                  <col class="col-assessment" />
                  <% if (cols.grade) { %><col class="col-grade" /><% } %>
                <% }); %>
                <% if (cols.subjectTotal && subject.assessments.length) { %><col class="col-subject-total" /><% } %>
              <% }); %>
              <% if (cols.total) { %><col class="col-total" /><% } %>
              <% if (cols.average) { %><col class="col-average" /><% } %>
              <% if (cols.percentage) { %><col class="col-percentage" /><% } %>
              <% if (cols.overallGrade) { %><col class="col-overall-grade" /><% } %>
              <% if (cols.position) { %><col class="col-position" /><% } %>
              <% if (cols.remark) { %><col class="col-remark" /><% } %>
            </colgroup>
            <thead>
              <tr>
                <th class="rotated-header" data-merit-col="lead"><span class="header-label">S/N</span></th>
                <% if (cols.studentId) { %><th class="rotated-header slanted-header student-id-header" data-merit-col="lead"><span class="header-label">Student ID</span></th><% } %>
                <th class="rotated-header student-name-cell" data-merit-col="lead"><span class="header-label">Student Name</span></th>
                <% if (cols.gender) { %><th class="rotated-header slanted-header gender-header" data-merit-col="lead"><span class="header-label">Gender</span></th><% } %>
                <% subjects.forEach(subject => { %>
                  <% subject.assessments.forEach(assessment => { %>
                    <% assessmentGroup += 1; %>
                <th class="rotated-header slanted-header" data-merit-col="assessment" data-merit-group="<%= assessmentGroup %>">
                  <span class="header-label"><span class="label-line"><%= subject.subject_name %></span><span class="label-line"><%= assessment.title %></span></span>
                </th>
                    <% if (cols.grade) { %><th class="rotated-header slanted-header grade-header" data-merit-col="assessment" data-merit-group="<%= assessmentGroup %>"><span class="header-label">Grade</span></th><% } %>
                  <% }); %>
                  <% if (cols.subjectTotal && subject.assessments.length) { %>
                <th class="rotated-header slanted-header subject-total-header" data-merit-col="assessment" data-merit-group="<%= assessmentGroup %>"><span class="header-label"><span class="label-line"><%= subject.subject_name %></span><span class="label-line">Total</span></span></th>
                  <% } %>
                <% }); %>
                <% if (cols.total) { %><th class="rotated-header slanted-header total-header" data-merit-col="summary"><span class="header-label">Total Score</span></th><% } %>
                <% if (cols.average) { %><th class="rotated-header slanted-header average-header" data-merit-col="summary"><span class="header-label">Average</span></th><% } %>
                <% if (cols.percentage) { %><th class="rotated-header slanted-header percentage-header" data-merit-col="summary"><span class="header-label">Percentage</span></th><% } %>
                <% if (cols.overallGrade) { %><th class="rotated-header slanted-header overall-grade-header" data-merit-col="summary"><span class="header-label">Overall Grade</span></th><% } %>
                <% if (cols.position) { %><th class="rotated-header slanted-header position-header" data-merit-col="summary"><span class="header-label">Position</span></th><% } %>
                <% if (cols.remark) { %><th class="rotated-header remark-header" data-merit-col="summary"><span class="header-label">Remark</span></th><% } %>
              </tr>
            </thead>
            <tbody>
              <% meritSheet.forEach((student, index) => { %>
              <tr>
                <td><%= index + 1 %></td>
                <% if (cols.studentId) { %><td><%= student.studentId %></td><% } %>
                <td class="student-name-cell"><%= student.name %></td>
                <% if (cols.gender) { %><td><%= student.gender %></td><% } %>
                <% student.scores.forEach(subject => { %>
                  <% subject.assessments.forEach(assessment => { %>
                <td>
                  <%= (assessment.score !== '-' && assessment.score !== null) ?
                  parseFloat(assessment.score).toFixed(2) : '-' %>
                </td>
                    <% if (cols.grade) { %><td><%= assessment.grade || '-' %></td><% } %>
                  <% }); %>
                  <% if (cols.subjectTotal && subject.assessments.length) { %><td class="subject-total-cell"><%= Number(subject.totalScore || 0).toFixed(2) %></td><% } %>
                <% }); %>
                <% if (cols.total) { %><td><%= student.totalScore %></td><% } %>
                <% if (cols.average) { %><td><%= student.averageScore %></td><% } %>
                <% if (cols.percentage) { %><td><%= student.percentage %></td><% } %>
                <% if (cols.overallGrade) { %><td><%= student.overallGrade %></td><% } %>
                <% if (cols.position) { %><td><%= student.position %></td><% } %>
                <% if (cols.remark) { %><td class="remark-cell"><%= student.remark %></td><% } %>
              </tr>
              <% }); %>
            </tbody>
          </table>
        </div>

        <% const hasSelection = typeof meritSheetSelection !== 'undefined' && meritSheetSelection; %>
        <div
          class="merit-sheet-actions"
          id="meritSheetActions"
          <% if (hasSelection) { %>data-selection="<%= JSON.stringify(meritSheetSelection) %>"<% } %>
        >
          <% if (typeof changeSelectionUrl !== 'undefined' && changeSelectionUrl) { %>
          <a class="btn btn-secondary" href="<%= changeSelectionUrl %>">Change selection</a>
          <% } %>
          <button class="btn" type="button" id="printMeritSheetBtn">Print Report</button>
          <% if (hasSelection) { %>
          <button class="btn" type="button" id="downloadMeritSheetBtn">Download PDF</button>
          <% } %>
        </div>
      </div>
      <% } %>
    </div>

    <script>
      window.addEventListener("beforeprint", function () {
        const logo = "<%= effectiveLogo || '' %>";
        if (!logo) return;

        let wm = document.getElementById("print-wm");
        if (!wm) {
          wm = document.createElement("div");
          wm.id = "print-wm";
          wm.setAttribute("aria-hidden", "true");
          wm.style.cssText = [
            "position: fixed",
            "inset: 0",
            "display: flex",
            "align-items: center",
            "justify-content: center",
            "z-index: 0",
            "pointer-events: none",
            "visibility: visible",
          ].join(";");
          wm.innerHTML =
            '<img src="' +
            logo +
            '" alt="" style="width:min(44vw,540px);opacity:0.08;object-fit:contain;" />';
          document.body.appendChild(wm);
        }
      });

      // Print and Download both use the server-generated PDF, so a wide sheet
      // is split into readable pages the same way in both.
      (function () {
        const actions = document.getElementById("meritSheetActions");
        const printBtn = document.getElementById("printMeritSheetBtn");
        const downloadBtn = document.getElementById("downloadMeritSheetBtn");
        const selection = actions ? actions.getAttribute("data-selection") : null;

        const fetchMeritSheetPdf = async () => {
          const response = await fetch("/print/downloadMeritSheet", {
            method: "POST",
            headers: { "Content-Type": "application/json", "Accept": "application/pdf, application/json" },
            credentials: "same-origin",
            body: selection,
          });
          const contentType = String(response.headers.get("content-type") || "").toLowerCase();
          if (!response.ok || !contentType.includes("application/pdf")) {
            const payload = await response.json().catch(() => ({}));
            throw new Error(payload.message || "The merit sheet PDF could not be prepared.");
          }
          const disposition = String(response.headers.get("content-disposition") || "");
          const fileNameMatch = disposition.match(/filename="([^"]+)"/i);
          return { blob: await response.blob(), fileName: fileNameMatch ? fileNameMatch[1] : "merit_sheet.pdf" };
        };

        const withBusyButton = async (button, busyLabel, task) => {
          if (button.disabled) return;
          const label = button.textContent;
          button.disabled = true;
          button.textContent = busyLabel;
          try {
            await task();
          } catch (error) {
            alert(error.message || "Something went wrong. Please try again.");
          } finally {
            button.disabled = false;
            button.textContent = label;
          }
        };

        if (downloadBtn) {
          downloadBtn.addEventListener("click", () =>
            withBusyButton(downloadBtn, "Preparing PDF...", async () => {
              const { blob, fileName } = await fetchMeritSheetPdf();
              const link = document.createElement("a");
              link.href = URL.createObjectURL(blob);
              link.download = fileName;
              document.body.appendChild(link);
              link.click();
              link.remove();
              setTimeout(() => URL.revokeObjectURL(link.href), 1000);
            })
          );
        }

        if (printBtn) {
          printBtn.addEventListener("click", () => {
            if (!selection) {
              window.print();
              return;
            }
            withBusyButton(printBtn, "Preparing print...", async () => {
              const { blob } = await fetchMeritSheetPdf();
              const url = URL.createObjectURL(blob);
              const frame = document.createElement("iframe");
              frame.setAttribute("aria-hidden", "true");
              frame.style.cssText = "position:fixed;right:0;bottom:0;width:0;height:0;border:0;visibility:hidden;";
              document.body.appendChild(frame);
              await new Promise((resolve) => {
                frame.onload = resolve;
                frame.src = url;
              });
              try {
                frame.contentWindow.focus();
                frame.contentWindow.print();
              } catch (_) {
                // Browsers that cannot print a PDF from the page open it instead.
                window.open(url, "_blank");
              }
              setTimeout(() => {
                frame.remove();
                URL.revokeObjectURL(url);
              }, 60000);
            });
          });
        }
      })();

      window.addEventListener("afterprint", function () {
        const wm = document.getElementById("print-wm");
        if (wm) wm.remove();
      });

      (function () {
        const form = document.getElementById("meritSheetForm");
        if (!form) return;

        const cards = Array.from(form.querySelectorAll(".subject-card"));
        const summary = document.getElementById("meritSelectionSummary");

        const assessmentBoxes = (card) => Array.from(card.querySelectorAll(".assessment-checkbox"));

        const setExpanded = (card, expanded) => {
          const toggle = card.querySelector(".subject-toggle");
          const body = card.querySelector(".subject-card-body");
          if (!body || toggle.disabled) return;
          body.hidden = !expanded;
          toggle.setAttribute("aria-expanded", expanded ? "true" : "false");
        };

        // Keeps the subject tick (partly ticked when only some are chosen),
        // its count and the overall summary in step with the assessments.
        const refresh = () => {
          let selectedTotal = 0;
          let subjectsWithSelection = 0;
          cards.forEach((card) => {
            const boxes = assessmentBoxes(card);
            const subjectBox = card.querySelector(".subject-checkbox");
            const count = card.querySelector(".subject-count");
            const selected = boxes.filter((box) => box.checked).length;
            selectedTotal += selected;
            if (selected) subjectsWithSelection += 1;
            if (subjectBox && boxes.length) {
              subjectBox.checked = selected > 0;
              subjectBox.indeterminate = selected > 0 && selected < boxes.length;
            }
            if (count && boxes.length) {
              count.textContent = `${selected} of ${boxes.length} selected`;
            }
            card.classList.toggle("has-selection", selected > 0);
          });
          if (summary) {
            summary.textContent = selectedTotal
              ? `${selectedTotal} assessment${selectedTotal === 1 ? "" : "s"} selected across ${subjectsWithSelection} subject${subjectsWithSelection === 1 ? "" : "s"}`
              : "No assessments selected";
          }
        };

        cards.forEach((card) => {
          const subjectBox = card.querySelector(".subject-checkbox");
          const toggle = card.querySelector(".subject-toggle");

          if (subjectBox) {
            subjectBox.addEventListener("change", () => {
              assessmentBoxes(card).forEach((box) => {
                box.checked = subjectBox.checked;
              });
              refresh();
            });
          }
          assessmentBoxes(card).forEach((box) => box.addEventListener("change", refresh));
          if (toggle) {
            toggle.addEventListener("click", () => {
              setExpanded(card, toggle.getAttribute("aria-expanded") !== "true");
            });
          }
        });

        form.querySelectorAll("[data-merit-action]").forEach((button) => {
          button.addEventListener("click", () => {
            const checked = button.getAttribute("data-merit-action") === "select-all";
            cards.forEach((card) => assessmentBoxes(card).forEach((box) => { box.checked = checked; }));
            refresh();
          });
        });

        refresh();
      })();

      function showFormMessage(message) {
        const msgBox = document.getElementById("formMessage");
        if (!msgBox) return;
        msgBox.textContent = message;
        msgBox.hidden = false;
        msgBox.scrollIntoView({ behavior: "smooth", block: "center" });
      }

      function validateMeritSheetForm() {
        const anyAssessment = document.querySelector('#meritSheetForm .assessment-checkbox:checked');
        if (!anyAssessment) {
          showFormMessage("Select at least one assessment before generating the merit sheet.");
          return false;
        }
        const msgBox = document.getElementById("formMessage");
        if (msgBox) msgBox.hidden = true;
        return true;
      }
    </script>
  </body>
</html>
