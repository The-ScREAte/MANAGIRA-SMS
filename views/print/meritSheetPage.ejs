<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= title %></title>
    <style>
      :root {
        --font-family: "<%= (session && session.fontStyle ? String(session.fontStyle).trim() : 'Inter') %>", sans-serif;
        --primary: var(--org-primary-color, #0f5a66);
        --primary-hover: var(--org-primary-hover, #0d4f59);
        --primary-hover-fill: color-mix(in srgb, var(--primary) 88%, white);
        --muted: #475569;
        --bg: #f6f8fb;
        --card: #ffffff;
        --border: #e2e8f0;
      }

      body {
          font-family: var(--font-family);
        }
        
  </style>
    <style>
      body {
        background-color: var(--bg);
        margin: 0;
      }

      .container {
        position: relative;
        width: 90%;
        margin: 30px auto;
        padding: 20px;
        background-color: var(--card);
        box-shadow: 0 6px 20px rgba(0, 0, 0, 0.08);
        border-radius: 12px;
        border: 1px solid var(--border);
      }

      .header {
        display: flex;
        align-items: center;
        gap: 16px;
        justify-content: center;
        margin-bottom: 30px;
        text-align: left;
      }

      .header img {
        width: 80px;
        height: 80px;
        object-fit: contain;
        border: 1px solid var(--border);
        border-radius: 10px;
        padding: 6px;
      }

      .header-text { display: flex; flex-direction: column; justify-content: center; gap: 4px; }

      .header-text h1,
      .header-text h2,
      .header-text h3 {
        margin: 0;
        text-align: left;
      }

      .header-text h1 { color: var(--primary); }
      .header-text h2 { color: #0f172a; font-weight: 700; }
      .header-text h3 { color: var(--muted); font-weight: 600; }

      .note {
        margin-bottom: 20px;
        text-align: center;
        color: var(--muted);
        font-size: 16px;
      }

      .form-section {
        margin-bottom: 40px;
      }

      .subject-container {
        margin-bottom: 20px;
        padding: 10px;
        border: 1px solid #ddd;
        border-radius: 5px;
        background-color: #f9f9f9;
      }

      .subject-header {
        display: flex;
        align-items: center;
        font-weight: bold;
      }

      .subject-header input {
        margin-right: 10px;
      }

      .assessment-container {
        margin-left: 20px;
        margin-top: 10px;
        display: none; /* Hidden by default */
      }

      .assessment-item {
        display: flex;
        align-items: center;
        gap: 10px;
        margin-bottom: 5px;
      }

      table {
        width: 100%;
        border-collapse: collapse;
        table-layout: fixed;
        margin-top: 20px;
      }

      .merit-sheet {
        overflow-x: auto;
      }

      .merit-sheet .col-sn { width: 56px; }
      .merit-sheet .col-student-id { width: 74px; }
      .merit-sheet .col-student-name { width: 150px; }
      .merit-sheet .col-assessment { width: 106px; }
      .merit-sheet .col-grade { width: 48px; }
      .merit-sheet .col-total { width: 76px; }
      .merit-sheet .col-average { width: 70px; }
      .merit-sheet .col-position { width: 68px; }

        table, th, td {
            border: 1.5px solid var(--primary);
        }

      th {
        background: linear-gradient(135deg, var(--primary), var(--primary-hover));
        color: #ffffff;
        padding: 6px;
        vertical-align: middle;
      }

      td {
        padding: 5px 4px;
        text-align: center;
      }

      .merit-sheet td:nth-child(3),
      .merit-sheet th:nth-child(3) {
        white-space: normal;
        word-break: break-word;
      }

      .rotated-header {
        position: static;
        height: 84px;
        min-width: 54px;
        padding: 6px 4px;
        vertical-align: middle;
        text-align: center;
        overflow: hidden;
        color: #ffffff;
      }

      .rotated-header .header-label {
        position: static;
        left: auto;
        bottom: auto;
        display: block;
        width: 100%;
        line-height: 1.2;
        white-space: normal;
        word-break: break-word;
        text-align: center;
        margin: 0 auto;
        transform: none;
        transform-origin: center;
      }

      .student-id-header,
      .grade-header,
      .total-header,
      .average-header,
      .position-header {
        padding: 0;
      }

      .student-id-header .header-label,
      .grade-header .header-label,
      .total-header .header-label,
      .average-header .header-label,
      .position-header .header-label {
        display: inline-block;
        width: auto;
        white-space: nowrap;
        line-height: 1;
        transform: rotate(-62deg);
        transform-origin: center;
      }

        .btn {
            display: block;
            width: fit-content;
            margin: 20px auto;
            padding: 10px 20px;
          background-color: var(--primary);
            color: white;
            border: none;
            border-radius: 5px;
            cursor: pointer;
        }

        .btn:hover {
          background-color: var(--primary-hover-fill, var(--primary-hover));
        }

      .no-data {
        text-align: center;
        font-size: 16px;
        color: #888;
      }

      .screen-watermark-logo {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        width: min(56vw, 700px);
        max-height: 82%;
        opacity: 0.06;
        z-index: 0;
        pointer-events: none;
        object-fit: contain;
      }

      .form-section,
      .print-section {
        position: relative;
        z-index: 1;
      }

      .print-section {
        position: relative;
      }

      .print-watermark-logo {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        width: min(55vw, 620px);
        max-height: 78%;
        opacity: 0.08;
        z-index: 0;
        pointer-events: none;
        object-fit: contain;
      }

      .print-section .header,
      .print-section .merit-sheet {
        position: relative;
        z-index: 1;
      }

      @media print {
        body * {
          visibility: hidden;
        }

        .print-section,
        .print-section * {
          visibility: visible;
        }

        .print-section {
          position: static;
          width: auto;
          padding: 0;
          box-sizing: border-box;
        }

        .btn { display: none !important; visibility: hidden !important; }

        body { -webkit-print-color-adjust: exact; print-color-adjust: exact; }
        th { -webkit-print-color-adjust: exact; print-color-adjust: exact; }
        td { -webkit-print-color-adjust: exact; print-color-adjust: exact; }
        .container { box-shadow: none; border: 1px solid #cbd5e1; padding: 24px; }
        .screen-watermark-logo { display: none; }
        .merit-sheet table { border: 1.5px solid var(--primary); }
        .print-watermark-logo { opacity: 0.1; }
        @page { size: A4 landscape; margin: 12mm 10mm; }

        table {
          page-break-inside: auto; /* Prevents breaking table rows between pages */
        }

        tr {
          page-break-inside: avoid; /* Keeps rows intact */
          page-break-after: auto;
        }

            th, td {
                border: 1px solid #000; /* Keeps borders consistent in print */
            }
        }

        @media (max-width: 768px) {
       
        
            .container {
                width: 100%;
                padding: 10px;
                margin: 5px auto;
                border-radius: 6px;
                box-shadow: none;
                overflow-x: auto; /* Enables horizontal scrolling */
            }
        
            .header img {
                text-align: center;
                margin-bottom: 30px;
            }
        
            h1, h2, h3 {
                text-align: center;
                margin-bottom: 10px;
            }
              .header-text h1, .header-text h2, .header-text h3 { text-align: left; }
        
            .form-section {
                margin-bottom: 20px;
            }
        
            .subject-container {
                padding: 8px;
            }
        
            .subject-header {
                font-size: 1rem;
            }
        
            .assessment-container {
                margin-left: 10px;
                font-size: 0.9rem;
            }
        
            /* Enables table scrolling without breaking layout */
            .merit-sheet {
                overflow-x: auto;
                max-width: 100%;
            }
        
            table {
                width: max-content; /* Allows scrolling instead of shrinking */
                border-collapse: collapse;
                white-space: nowrap;
            }
        
            th, td {
                padding: 8px;
                border: 1px solid #000;
            }
        
            .rotated-header {
                writing-mode: vertical-rl;
                transform: rotate(180deg);
                text-align: center;
                white-space: nowrap;
            }
        
            /* Ensure buttons stay visible and accessible */
            .btn {
                width: 100%;
                max-width: 300px;
                margin: 10px auto;
                font-size: 1rem;
                text-align: center;
                display: block;
            }
        }
        
    </style>
  </head>

  <body>
    <div class="container">
      <% if (session.logo) { %>
      <img src="<%= session.logo %>" alt="School Watermark" class="screen-watermark-logo" />
      <% } %>
      <!-- Form Section -->
      <% if (!meritSheet || meritSheet.length === 0) { %>
      <div class="form-section">
        <div class="header">
          <% if (session.logo) { %>
          <img src="<%= session.logo %>" alt="School Logo" />
          <% } %>
          <div class="header-text">
            <h1><%= orgName %></h1>
            <h2>School Year: <%= schoolYear %></h2>
            <h3> <%= termName %> | <%= className %></h3>
          </div>
        </div>
        <div class="note">
          <p>
            Please select all the subjects and assessments you need for the
            merit sheet, then click "Generate Merit Sheet."
          </p>
        </div>
        <div
          id="formMessage"
          style="
            display: none;
            padding: 10px;
            margin-bottom: 15px;
            border-radius: 5px;
            background-color: #f8d7da;
            color: #721c24;
            border: 1px solid #f5c6cb;
            text-align: center;
          "
        >
          <!-- Message will be inserted here -->
        </div>

        <form
          id="meritSheetForm"
          onsubmit="return validateMeritSheetForm()"
          action="/print/generateMeritSheet"
          method="POST"
        >
          <input type="hidden" name="classId" value="<%= classId %>" />
          <input type="hidden" name="termId" value="<%= termId %>" />

          <% subjects.forEach(subject => { %>
          <div class="subject-container">
            <div class="subject-header">
              <input
                type="checkbox"
                name="selectedSubjects[]"
                value="<%= subject.subject_id %>"
                onclick="toggleAssessments('<%= subject.subject_id %>', this)"
              />
              <label><%= subject.subject_name %></label>
            </div>
            <div
              id="assessment-container-<%= subject.subject_id %>"
              class="assessment-container"
            >
              <% if (subject.assessments.length > 0) { %> <%
              subject.assessments.forEach(assessment => { %>
              <div class="assessment-item">
                <input
                  type="checkbox"
                  name="selectedAssessments[]"
                  value="<%= assessment.assessment_id %>"
                />
                <label
                  ><%= assessment.title %> (<%= assessment.weight %>%)</label
                >
              </div>
              <% }); %> <% } else { %>
              <p>No assessments available.</p>
              <% } %>
            </div>
          </div>
          <% }); %>
          <button type="submit" class="btn">Generate Merit Sheet</button>
        </form>
      </div>
      <% } %>

      <!-- Merit Sheet Section -->
      <% if (meritSheet && meritSheet.length > 0) { %>
      <div class="print-section">
        <% if (session.logo) { %>
        <img src="<%= session.logo %>" alt="School Watermark" class="print-watermark-logo" />
        <% } %>
        <div class="header">
          <% if (session.logo) { %>
          <img src="<%= session.logo %>" alt="School Logo" />
          <% } %>
          <div class="header-text">
            <h1><%= orgName %></h1>
            <h2>School Year: <%= schoolYear %></h2>
            <h3> <%= termName %> | <%= className %></h3>
            <h2>Class Order of Merit Sheet</h2>
          </div>
        </div>

        <div class="merit-sheet">
          <table>
            <colgroup>
              <col class="col-sn" />
              <col class="col-student-id" />
              <col class="col-student-name" />
              <% subjects.forEach(subject => { %>
                <% subject.assessments.forEach(() => { %>
                  <col class="col-assessment" />
                  <col class="col-grade" />
                <% }); %>
              <% }); %>
              <col class="col-total" />
              <col class="col-average" />
              <col class="col-position" />
            </colgroup>
            <thead>
              <tr>
                <th class="rotated-header"><span class="header-label">S/N</span></th>
                <th class="rotated-header student-id-header"><span class="header-label">Student ID</span></th>
                <th class="rotated-header"><span class="header-label">Student Name</span></th>
                <% subjects.forEach(subject => { %> <%
                subject.assessments.forEach(assessment => { %>
                <th class="rotated-header">
                  <span class="header-label"><%= subject.subject_name %> - <%= assessment.title %></span>
                </th>
                <th class="rotated-header grade-header"><span class="header-label">Grade</span></th>
                <% }); %> <% }); %>
                <th class="rotated-header total-header"><span class="header-label">Total Score</span></th>
                <th class="rotated-header average-header"><span class="header-label">Average</span></th>
                <th class="rotated-header position-header"><span class="header-label">Position</span></th>
              </tr>
            </thead>
            <tbody>
              <% meritSheet.forEach((student, index) => { %>
              <tr>
                <td><%= index + 1 %></td>
                <td><%= student.studentId %></td>
                <td><%= student.name %></td>
                <% student.scores.forEach(subject => { %> <%
                subject.assessments.forEach(assessment => { %>
                <td>
                  <%= (assessment.score !== '-' && assessment.score !== null) ?
                  parseFloat(assessment.score).toFixed(2) : '-' %>
                </td>
                <td><%= assessment.grade || '-' %></td>
                <% }); %> <% }); %>
                <td><%= student.totalScore %></td>
                <td><%= student.averageScore %></td>
                <td><%= student.position %></td>
              </tr>
              <% }); %>
            </tbody>
          </table>
        </div>

        <button class="btn" onclick="window.print()">Print Report</button>
      </div>
      <% } %>
    </div>

    <script>
      function toggleAssessments(subjectId, checkbox) {
        const assessmentContainer = document.getElementById(
          `assessment-container-${subjectId}`
        );
        assessmentContainer.style.display = checkbox.checked ? "block" : "none";
      }
      function showFormMessage(message) {
        const msgBox = document.getElementById("formMessage");
        msgBox.innerText = message;
        msgBox.style.display = "block";

        // Auto-hide after 30 seconds
        setTimeout(() => {
          msgBox.style.display = "none";
          msgBox.innerText = "";
        }, 20000);
      }

      function validateMeritSheetForm() {
        const subjectCheckboxes = document.querySelectorAll(
          'input[name="selectedSubjects[]"]'
        );
        const assessmentCheckboxes = document.querySelectorAll(
          'input[name="selectedAssessments[]"]'
        );

        const isSubjectSelected = Array.from(subjectCheckboxes).some(
          (cb) => cb.checked
        );
        const isAssessmentSelected = Array.from(assessmentCheckboxes).some(
          (cb) => cb.checked
        );

        if (!isSubjectSelected || !isAssessmentSelected) {
          showFormMessage(
            "Please select at least one subject and one assessment before generating the merit sheet."
          );
          return false;
        }

        return true;
      }
    </script>
  </body>
</html>
