<!DOCTYPE html>
<html lang="en">
<head>
  <link rel="stylesheet" href="/css/globalScale.css">
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Report and Transcript Delivery History | Managira</title>
    <link rel="icon" href="/favicon.ico" type="image/x-icon" sizes="any" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <% const backQuery = (classId ? `?classId=${classId}${termId ? `&termId=${termId}` : ''}` : (termId ? `?termId=${termId}` : '')); %>
    <style>
        :root {
            --bg: #f2f5f8;
            --panel: #ffffff;
            --line: #d8e1ea;
            --text: #132233;
            --muted: #5b6d82;
            --brand-900: #0e4650;
            --brand-700: #1f6f7d;
            --brand-100: #e5f3f4;
            --good: #0f7a4a;
            --good-bg: #dcfce7;
            --warn: #996500;
            --warn-bg: #fff5cc;
            --bad: #a11434;
            --bad-bg: #ffe0e7;
            --info: #0b5ea8;
            --info-bg: #ddeefe;
            --shadow: 0 12px 24px rgba(16, 35, 56, 0.08);
            --radius: 14px;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        html, body {
            overflow-x: hidden;
        }

        /* This page is rendered inside the shared app layout's <main>
           (loaded in an iframe from the Reports hub) — neutralize its
           width/overflow rules from /css/style.css so this page's own
           scroll containers (the table) are the only ones that clip. */
        main {
            overflow-x: visible !important;
            max-width: 100% !important;
            width: 100% !important;
            box-sizing: border-box !important;
            min-width: 0 !important;
        }
        #app-scale-root {
            overflow-x: visible !important;
            min-width: 0 !important;
        }

        body {
            font-family: 'Manrope', 'Segoe UI', sans-serif;
            color: var(--text);
            background: transparent;
            min-height: 100%;
        }

        .page-wrap {
            max-width: 1280px;
            width: 100%;
            box-sizing: border-box;
            margin: 0 auto;
            padding: 16px;
            display: grid;
            grid-template-columns: minmax(0, 1fr);
            gap: 16px;
        }

        /* Grid/flex items default to min-width:auto, which stops them from
           ever shrinking below their content's intrinsic width — that's
           what was forcing the whole page to stretch to the table's width
           instead of letting .table-wrap's own overflow-x:auto scroll. */
        .page-wrap > * {
            min-width: 0;
        }

        .stats-grid {
            display: grid;
            grid-template-columns: repeat(5, minmax(0, 1fr));
            gap: 12px;
        }

        .stat-card {
            background: var(--panel);
            border-radius: var(--radius);
            border: 1px solid var(--line);
            box-shadow: var(--shadow);
            padding: 14px;
        }

        .stat-label {
            font-size: 11px;
            letter-spacing: 0.04em;
            text-transform: uppercase;
            color: var(--muted);
            font-weight: 700;
            margin-bottom: 8px;
        }

        .stat-value {
            font-size: 28px;
            line-height: 1;
            font-weight: 800;
            color: var(--brand-900);
        }

        .panel {
            background: var(--panel);
            border: 1px solid var(--line);
            border-radius: var(--radius);
            box-shadow: var(--shadow);
        }

        .filters-panel {
            padding: 14px;
            display: grid;
            gap: 0;
        }

        .filters-toggle {
            display: flex;
            align-items: center;
            justify-content: space-between;
            width: 100%;
            background: none;
            border: none;
            padding: 2px 0 10px;
            font: inherit;
            font-size: 13px;
            font-weight: 700;
            color: var(--text);
            cursor: pointer;
        }

        .filters-toggle svg {
            width: 16px;
            height: 16px;
            transition: transform 0.18s ease;
        }

        .filters-toggle[aria-expanded="true"] svg {
            transform: rotate(180deg);
        }

        .filters-body {
            display: grid;
            gap: 12px;
            padding-bottom: 12px;
        }

        .filters-grid {
            display: grid;
            grid-template-columns: repeat(6, minmax(0, 1fr));
            gap: 10px;
        }

        .filters-grid .full {
            grid-column: span 2;
        }

        .input,
        .select {
            width: 100%;
            border-radius: 10px;
            border: 1px solid var(--line);
            background: #f8fafc;
            color: var(--text);
            min-height: 40px;
            padding: 8px 10px;
            font: inherit;
            font-size: 13px;
        }

        .input:focus,
        .select:focus {
            outline: none;
            border-color: var(--brand-700);
            box-shadow: 0 0 0 3px rgba(31, 111, 125, 0.15);
        }

        .actions-row {
            display: flex;
            justify-content: flex-start;
            gap: 8px;
        }

        .btn {
            width: auto;
            border-radius: 8px;
            border: 1px solid var(--line);
            background: #f8fafc;
            color: var(--text);
            padding: 7px 12px;
            font: inherit;
            font-size: 12.5px;
            cursor: pointer;
            font-weight: 700;
            border: 1px solid transparent;
        }

        .btn-primary {
            background: linear-gradient(130deg, #1f6f7d, #0e4650);
            color: #fff;
        }

        .btn-secondary {
            background: #eef3f8;
            color: #213247;
            border-color: var(--line);
        }

        .meta-row {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 10px;
            color: var(--muted);
            font-size: 13px;
            font-weight: 600;
        }

        .table-wrap {
            overflow-x: auto;
            -webkit-overflow-scrolling: touch;
            border-radius: var(--radius);
            scrollbar-width: thin;
            max-width: 100%;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            min-width: 1020px;
            background: #fff;
        }

        thead th {
            position: sticky;
            top: 0;
            z-index: 2;
            background: #f6fbfc;
            color: #274257;
            font-size: 12px;
            text-transform: uppercase;
            letter-spacing: 0.04em;
            font-weight: 800;
            padding: 12px 10px;
            border-bottom: 1px solid var(--line);
            text-align: left;
            white-space: nowrap;
        }

        tbody td {
            border-bottom: 1px solid #edf2f7;
            padding: 12px 10px;
            vertical-align: top;
            font-size: 13px;
        }

        tbody tr:hover {
            background: #fbfeff;
        }

        .badge {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            min-height: 24px;
            padding: 4px 10px;
            border-radius: 999px;
            font-weight: 700;
            font-size: 11px;
            text-transform: uppercase;
            white-space: nowrap;
        }

        .badge-sent {
            background: var(--good-bg);
            color: var(--good);
        }

        .badge-pending {
            background: var(--warn-bg);
            color: var(--warn);
        }

        .badge-sending {
            background: var(--info-bg);
            color: var(--info);
        }

        .badge-failed {
            background: var(--bad-bg);
            color: var(--bad);
        }

        .badge-default {
            background: #e8edf3;
            color: #425466;
        }

        .pill {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            border: 1px solid #d8e3ed;
            background: #f7fbff;
            border-radius: 999px;
            padding: 3px 10px;
            font-size: 12px;
            color: #30455f;
            font-weight: 600;
        }

        .muted {
            color: var(--muted);
        }

        .mono {
            font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", monospace;
            font-size: 12px;
            color: #2e3f54;
        }

        .recipients {
            max-width: 240px;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .row-actions {
            display: inline-flex;
            gap: 6px;
            align-items: center;
        }

        .tiny-btn {
            border: 1px solid var(--line);
            background: #fff;
            color: #1d3348;
            border-radius: 8px;
            padding: 6px 8px;
            font-size: 12px;
            font-weight: 700;
            cursor: pointer;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 4px;
        }

        .tiny-btn.retry {
            background: #fff7d6;
            border-color: #f0df94;
            color: #664400;
        }

        .error-msg {
            margin-top: 6px;
            color: var(--bad);
            font-size: 12px;
            line-height: 1.4;
        }

        .loading,
        .empty-state {
            padding: 24px;
            text-align: center;
            color: var(--muted);
            font-weight: 600;
        }

        .mobile-cards {
            display: none;
            grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
            gap: 10px;
            padding: 4px;
            width: 100%;
            box-sizing: border-box;
        }

        .mobile-card {
            border: 1px solid var(--line);
            border-radius: 12px;
            padding: 12px;
            background: #fff;
            display: grid;
            gap: 8px;
            min-width: 0;
        }

        .card-head {
            display: flex;
            align-items: flex-start;
            justify-content: space-between;
            gap: 8px;
        }

        .card-name {
            font-weight: 700;
            font-size: 14px;
            color: var(--text);
        }

        .card-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 6px 10px;
        }

        .batch-chip {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            margin-top: 6px;
            border: 1px solid #cfe0ef;
            background: #eef6ff;
            color: #174a7c;
            border-radius: 999px;
            padding: 2px 9px;
            font-size: 11px;
            font-weight: 700;
        }

        .delivery-modal-overlay {
            position: fixed;
            inset: 0;
            background: rgba(9, 19, 35, 0.56);
            display: none;
            align-items: flex-start;
            justify-content: center;
            z-index: 9999;
            padding: 18px 12px;
        }

        .delivery-modal-card {
            width: min(1020px, 100%);
            max-height: min(78vh, 820px);
            overflow: hidden;
            border-radius: 14px;
            border: 1px solid var(--line);
            background: #fff;
            box-shadow: 0 28px 50px rgba(4, 17, 33, 0.28);
            display: grid;
            grid-template-rows: auto 1fr;
        }

        .delivery-modal-head {
            padding: 12px 14px;
            border-bottom: 1px solid #e5edf5;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 8px;
        }

        .delivery-modal-title {
            font-size: 15px;
            font-weight: 800;
            color: #173650;
        }

        .delivery-modal-close {
            border: 1px solid #d8e3ed;
            background: #f8fbff;
            color: #24455f;
            border-radius: 8px;
            padding: 6px 10px;
            font-weight: 700;
            cursor: pointer;
        }

        .delivery-modal-body {
            overflow: auto;
            padding: 10px;
        }

        .detail-table {
            width: 100%;
            border-collapse: collapse;
            min-width: 760px;
        }

        .detail-table th,
        .detail-table td {
            border-bottom: 1px solid #edf2f7;
            padding: 8px;
            font-size: 12px;
            text-align: left;
            vertical-align: top;
        }

        .detail-table th {
            background: #f7fbfe;
            color: #23455f;
            position: sticky;
            top: 0;
            z-index: 1;
        }

        .mobile-row {
            font-size: 12px;
            color: #334a61;
            display: flex;
            flex-direction: column;
            gap: 1px;
            min-width: 0;
            overflow-wrap: break-word;
        }

        .mobile-row.full {
            grid-column: 1 / -1;
        }

        .mobile-row strong {
            color: #8494a6;
            font-size: 10px;
            text-transform: uppercase;
            letter-spacing: 0.03em;
            font-weight: 700;
        }

        @media (max-width: 1120px) {
            .stats-grid {
                grid-template-columns: repeat(3, minmax(0, 1fr));
            }

            .filters-grid {
                grid-template-columns: repeat(3, minmax(0, 1fr));
            }

            .filters-grid .full {
                grid-column: span 3;
            }
        }

        @media (max-width: 720px) {
            .stats-grid {
                grid-template-columns: repeat(2, minmax(0, 1fr));
            }

            .filters-grid {
                grid-template-columns: 1fr;
            }

            .filters-grid .full {
                grid-column: span 1;
            }

            .table-wrap {
                display: none;
            }

            .mobile-cards {
                display: grid;
                grid-template-columns: 1fr;
            }
        }
    </style>
</head>
<body>
    <div class="page-wrap">

        <section class="stats-grid">
            <article class="stat-card">
                <div class="stat-label">Total Jobs</div>
                <div class="stat-value" id="totalCount">0</div>
            </article>
            <article class="stat-card">
                <div class="stat-label">Sent</div>
                <div class="stat-value" id="sentCount">0</div>
            </article>
            <article class="stat-card">
                <div class="stat-label">Pending</div>
                <div class="stat-value" id="pendingCount">0</div>
            </article>
            <article class="stat-card">
                <div class="stat-label">Failed</div>
                <div class="stat-value" id="failedCount">0</div>
            </article>
            <article class="stat-card">
                <div class="stat-label">Report PDF Ready</div>
                <div class="stat-value" id="pdfReadyCount">0</div>
            </article>
        </section>

        <section class="panel filters-panel">
            <button type="button" class="filters-toggle" id="filtersToggle" aria-expanded="false">
                <span>Filters</span>
                <svg id="filtersToggleIcon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg>
            </button>
            <div class="filters-body" id="filtersBody" hidden>
                <div class="filters-grid">
                    <select id="classFilter" class="select">
                        <option value="">All Classes</option>
                    </select>
                    <select id="termFilter" class="select">
                        <option value="">All Terms</option>
                    </select>
                    <select id="studentFilter" class="select">
                        <option value="">All Students</option>
                    </select>
                    <select id="statusFilter" class="select">
                        <option value="">All Statuses</option>
                        <option value="saved">Saved</option>
                        <option value="posted">Posted</option>
                        <option value="printed">Printed</option>
                        <option value="pending">Pending</option>
                        <option value="sending">Sending</option>
                        <option value="sent">Sent</option>
                        <option value="failed">Failed</option>
                    </select>
                    <select id="domainFilter" class="select">
                        <option value="">Report + Transcript</option>
                        <option value="report">Report only</option>
                        <option value="transcript">Transcript only</option>
                    </select>
                    <input id="dateFromFilter" type="date" class="input" />
                    <input id="dateToFilter" type="date" class="input" />
                    <input id="batchFilter" type="text" class="input full" placeholder="Batch ID (exact)" />
                    <input id="searchFilter" type="text" class="input full" placeholder="Search student, recipient email, class, term, batch" />
                </div>
                <div class="actions-row">
                    <button class="btn btn-primary" id="refreshBtn">Refresh</button>
                    <button class="btn btn-secondary" id="clearBtn">Clear Filters</button>
                </div>
            </div>
            <div class="meta-row">
                <div id="resultMeta">No records loaded yet.</div>
                <div id="lastLoadedMeta">Last loaded: --</div>
            </div>
        </section>

        <section class="panel" id="historyPanel">
            <div id="loading" class="loading" style="display:none;">Loading email history...</div>

            <div class="table-wrap" id="tableWrap">
                <table>
                    <thead>
                        <tr>
                            <th>Student</th>
                            <th>Activity</th>
                            <th>Class / Term</th>
                            <th>Created</th>
                            <th>Sent</th>
                            <th>Posted</th>
                            <th>Status</th>
                            <th>Recipients</th>
                            <th>By</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody id="historyRows">
                        <tr>
                            <td colspan="10" class="empty-state">No delivery history found.</td>
                        </tr>
                    </tbody>
                </table>
            </div>

            <div class="mobile-cards" id="mobileCards">
                <div class="empty-state">No delivery history found.</div>
            </div>
        </section>

        <div class="delivery-modal-overlay" id="batchDetailsModal" role="dialog" aria-modal="true" aria-hidden="true">
            <div class="delivery-modal-card">
                <div class="delivery-modal-head">
                    <div class="delivery-modal-title" id="batchDetailsTitle">Batch Details</div>
                    <button class="delivery-modal-close" id="batchDetailsCloseBtn" type="button">Close</button>
                </div>
                <div class="delivery-modal-body" id="batchDetailsBody">
                    <div class="loading">Loading batch details...</div>
                </div>
            </div>
        </div>
    </div>

    <script>
        const organizationId = '<%= organizationId %>';
        const defaultClassId = '<%= classId || "" %>';
        const defaultTermId = '<%= termId || "" %>';
        const state = {
            allEmails: [],
            displayRows: [],
            selectedStudentId: '',
        };

        function escapeHtml(value) {
            return String(value == null ? '' : value)
                .replace(/&/g, '&amp;')
                .replace(/</g, '&lt;')
                .replace(/>/g, '&gt;')
                .replace(/"/g, '&quot;')
                .replace(/'/g, '&#39;');
        }

        function fmtDate(value) {
            if (!value) return '-';
            try {
                return new Date(value).toLocaleString();
            } catch (_) {
                return '-';
            }
        }

        function statusClass(status) {
            const normalized = String(status || '').trim().toLowerCase();
            if (normalized === 'sent') return 'badge-sent';
            if (normalized === 'pending') return 'badge-pending';
            if (normalized === 'sending') return 'badge-sending';
            if (normalized === 'failed') return 'badge-failed';
            return 'badge-default';
        }

        function statusLabel(status) {
            const normalized = String(status || '').trim();
            return normalized ? normalized : 'unknown';
        }

        function getFilters() {
            return {
                class_id: document.getElementById('classFilter').value.trim(),
                term_id: document.getElementById('termFilter').value.trim(),
                student_id: document.getElementById('studentFilter').value.trim(),
                status: document.getElementById('statusFilter').value.trim(),
                delivery_domain: document.getElementById('domainFilter').value.trim(),
                date_from: document.getElementById('dateFromFilter').value.trim(),
                date_to: document.getElementById('dateToFilter').value.trim(),
                batch_id: document.getElementById('batchFilter').value.trim(),
                q: document.getElementById('searchFilter').value.trim(),
            };
        }

        function activityLabel(row) {
            const map = {
                report_email: 'Report Email',
                report_posted: 'Report Posted',
                report_saved: 'Report Saved',
                report_printed: 'Report Printed',
                transcript_saved: 'Transcript Saved',
                transcript_email_sent: 'Transcript Sent',
                transcript_email_failed: 'Transcript Failed',
                transcript_printed: 'Transcript Printed'
            };
            const key = String(row.activity_type || '').trim();
            return map[key] || key || 'Recorded Event';
        }

        function statusPriority(status) {
            const normalized = String(status || '').toLowerCase();
            if (normalized === 'failed') return 4;
            if (normalized === 'sending') return 3;
            if (normalized === 'pending') return 2;
            if (normalized === 'printed') return 2;
            if (normalized === 'saved') return 1;
            if (normalized === 'posted') return 1;
            if (normalized === 'sent') return 1;
            return 0;
        }

        function buildDisplayRows(rows) {
            const grouped = new Map();
            const singles = [];

            (rows || []).forEach((row) => {
                const batchId = String(row.batch_id || '').trim();
                const activity = String(row.activity_type || '').trim();
                const domain = String(row.delivery_domain || '').trim();

                // Collapse only real batch events to avoid flooding the page.
                if (batchId && activity) {
                    const key = `${domain}|${activity}|${batchId}`;
                    const createdAt = new Date(row.created_at || 0).getTime();
                    if (!grouped.has(key)) {
                        grouped.set(key, {
                            ...row,
                            isBatchGroup: true,
                            batchCount: 1,
                            batchKey: key,
                            batchRows: [row],
                            batchLatestTs: createdAt,
                            batchRecipientSet: new Set(Array.isArray(row.recipient_emails) ? row.recipient_emails : []),
                            batchStatus: String(row.status || ''),
                        });
                    } else {
                        const existing = grouped.get(key);
                        existing.batchCount += 1;
                        existing.batchRows.push(row);
                        existing.batchLatestTs = Math.max(existing.batchLatestTs, createdAt);
                        if (createdAt >= existing.batchLatestTs) {
                            existing.created_at = row.created_at;
                            existing.updated_at = row.updated_at;
                            existing.report_posted_at = row.report_posted_at;
                            existing.sent_at = row.sent_at;
                        }
                        (Array.isArray(row.recipient_emails) ? row.recipient_emails : []).forEach((email) => {
                            if (email) existing.batchRecipientSet.add(email);
                        });
                        if (statusPriority(row.status) > statusPriority(existing.batchStatus)) {
                            existing.batchStatus = String(row.status || existing.batchStatus);
                        }
                    }
                } else {
                    singles.push({ ...row, isBatchGroup: false });
                }
            });

            const groupedRows = Array.from(grouped.values()).map((row) => {
                const recipients = Array.from(row.batchRecipientSet || []);
                return {
                    ...row,
                    status: row.batchStatus || row.status,
                    recipient_emails: recipients,
                    recipient_count: recipients.length,
                    group_token: JSON.stringify({
                        batch_id: row.batch_id,
                        activity_type: row.activity_type,
                        delivery_domain: row.delivery_domain,
                    }),
                };
            });

            const merged = [...groupedRows, ...singles];
            merged.sort((a, b) => new Date(b.created_at || 0).getTime() - new Date(a.created_at || 0).getTime());
            return merged;
        }

        function closeBatchDetailsModal() {
            const modal = document.getElementById('batchDetailsModal');
            modal.style.display = 'none';
            modal.setAttribute('aria-hidden', 'true');
        }

        async function openBatchDetailsModal(groupToken) {
            let token = null;
            try {
                token = JSON.parse(groupToken);
            } catch (_) {
                return;
            }
            if (!token || !token.batch_id) return;

            const modal = document.getElementById('batchDetailsModal');
            const titleEl = document.getElementById('batchDetailsTitle');
            const bodyEl = document.getElementById('batchDetailsBody');
            titleEl.textContent = `${activityLabel({ activity_type: token.activity_type })} batch details`;
            bodyEl.innerHTML = '<div class="loading">Loading batch details...</div>';
            modal.style.display = 'flex';
            modal.setAttribute('aria-hidden', 'false');

            try {
                const params = new URLSearchParams();
                params.set('batch_id', token.batch_id);
                if (token.delivery_domain) params.set('delivery_domain', token.delivery_domain);
                const classId = document.getElementById('classFilter').value.trim();
                const termId = document.getElementById('termFilter').value.trim();
                if (classId) params.set('class_id', classId);
                if (termId) params.set('term_id', termId);

                const res = await fetch(`/print/emailHistory?${params.toString()}`);
                const payload = await res.json().catch(() => ({}));
                if (!res.ok || !payload.success) {
                    bodyEl.innerHTML = '<div class="empty-state">Failed to load batch details.</div>';
                    return;
                }

                const rows = (Array.isArray(payload.data) ? payload.data : []).filter((row) => {
                    return String(row.batch_id || '') === String(token.batch_id)
                        && String(row.activity_type || '') === String(token.activity_type || row.activity_type);
                }).sort((a, b) => new Date(b.created_at || 0).getTime() - new Date(a.created_at || 0).getTime());

                if (!rows.length) {
                    bodyEl.innerHTML = '<div class="empty-state">No entries found for this batch.</div>';
                    return;
                }

                bodyEl.innerHTML = `
                    <table class="detail-table">
                        <thead>
                            <tr>
                                <th>Student</th>
                                <th>Status</th>
                                <th>Recipients</th>
                                <th>Created</th>
                                <th>Actor</th>
                                <th>Notes</th>
                            </tr>
                        </thead>
                        <tbody>
                            ${rows.map((row) => {
                                const recipients = Array.isArray(row.recipient_emails) && row.recipient_emails.length
                                    ? row.recipient_emails.join(', ')
                                    : '-';
                                return `
                                    <tr>
                                        <td>${escapeHtml(row.student_name || '-')}<div class="muted">ID: ${escapeHtml(row.student_id || '-')}</div></td>
                                        <td><span class="badge ${statusClass(row.status)}">${escapeHtml(statusLabel(row.status))}</span></td>
                                        <td>${escapeHtml(recipients)}</td>
                                        <td>${escapeHtml(fmtDate(row.created_at))}</td>
                                        <td>${escapeHtml(row.queued_by_name || '-')}</td>
                                        <td>${escapeHtml(row.error_message || row.notes || '-')}</td>
                                    </tr>
                                `;
                            }).join('')}
                        </tbody>
                    </table>
                `;
            } catch (_) {
                bodyEl.innerHTML = '<div class="empty-state">Failed to load batch details.</div>';
            }
        }

        function buildUrlWithFilters() {
            const filters = getFilters();
            const params = new URLSearchParams();
            Object.entries(filters).forEach(([key, value]) => {
                if (value) params.append(key, value);
            });
            return params.toString() ? `/print/emailHistory?${params.toString()}` : '/print/emailHistory';
        }

        function populateStudentFilter(emails) {
            const studentFilter = document.getElementById('studentFilter');
            const previousValue = state.selectedStudentId || studentFilter.value || '';
            const map = new Map();

            (emails || []).forEach((row) => {
                const sid = String(row.student_id || '').trim();
                if (!sid) return;
                if (!map.has(sid)) {
                    map.set(sid, String(row.student_name || `Student ${sid}`).trim());
                }
            });

            const options = Array.from(map.entries())
                .sort((a, b) => a[1].localeCompare(b[1]))
                .map(([sid, name]) => `<option value="${escapeHtml(sid)}">${escapeHtml(name)} (ID: ${escapeHtml(sid)})</option>`)
                .join('');

            studentFilter.innerHTML = '<option value="">All Students</option>' + options;
            if (previousValue && map.has(previousValue)) {
                studentFilter.value = previousValue;
            } else {
                studentFilter.value = '';
            }
            state.selectedStudentId = studentFilter.value;
        }

        function updateStats(emails) {
            const total = emails.length;
            const sent = emails.filter((e) => String(e.status || '').toLowerCase() === 'sent').length;
            const pending = emails.filter((e) => ['pending', 'sending'].includes(String(e.status || '').toLowerCase())).length;
            const failed = emails.filter((e) => String(e.status || '').toLowerCase() === 'failed').length;
            const pdfReady = emails.filter((e) => Boolean(e.report_pdf_url) || Boolean(e.pdf_generated)).length;

            document.getElementById('totalCount').textContent = String(total);
            document.getElementById('sentCount').textContent = String(sent);
            document.getElementById('pendingCount').textContent = String(pending);
            document.getElementById('failedCount').textContent = String(failed);
            document.getElementById('pdfReadyCount').textContent = String(pdfReady);

            document.getElementById('resultMeta').textContent = `${total} record${total === 1 ? '' : 's'} loaded`;
            document.getElementById('lastLoadedMeta').textContent = `Last loaded: ${new Date().toLocaleTimeString()}`;
        }


        // Send Report (SMS/WhatsApp/Email) rows can always be resent, not
        // just retried-on-failure — a guardian saying "I never got it" is a
        // valid reason to resend something that reported as "sent".
        function buildResendButton(row) {
            if (String(row.activity_type || '') !== 'report_notify_sent') return '';
            const channel = String(row.delivery_domain || '').toLowerCase();
            if (!['sms', 'whatsapp', 'email'].includes(channel)) return '';
            const recipientsList = Array.isArray(row.recipient_emails) ? row.recipient_emails : [];
            const recipient = recipientsList[0];
            if (!recipient || !row.student_id || !row.class_id || !row.term_id) return '';
            const payload = encodeURIComponent(JSON.stringify({
                classId: row.class_id, termId: row.term_id, studentId: row.student_id, channel, recipient,
            }));
            return `<button class="tiny-btn" onclick="resendGuardianMessage('${payload}')">Resend</button>`;
        }

        async function resendGuardianMessage(encodedPayload) {
            const payload = JSON.parse(decodeURIComponent(encodedPayload));
            const password = prompt(`Enter your password to resend this ${payload.channel.toUpperCase()} message to ${payload.recipient}:`);
            if (!password) return;
            try {
                const res = await fetch('/account/messaging/resend', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
                    body: JSON.stringify({ ...payload, password }),
                });
                const data = await res.json().catch(() => ({}));
                alert(data.message || (data.success ? 'Resent.' : 'Resend failed.'));
                if (data.success) loadHistory();
            } catch (err) {
                alert('Network error — resend failed.');
            }
        }

        function renderTableRows(emails) {
            const tbody = document.getElementById('historyRows');
            if (!emails.length) {
                tbody.innerHTML = '<tr><td colspan="10" class="empty-state">No delivery history found for the selected filters.</td></tr>';
                return;
            }

            tbody.innerHTML = emails.map((row) => {
                const cls = row.class_name || `Class #${row.class_id || '-'}`;
                const term = [row.term_name, row.year_label].filter(Boolean).join(' - ') || `Term #${row.term_id || '-'}`;
                const status = statusLabel(row.status);
                const statusBadge = `<span class="badge ${statusClass(status)}">${escapeHtml(status)}</span>`;
                const recipientsList = Array.isArray(row.recipient_emails) ? row.recipient_emails : [];
                const recipients = recipientsList.length ? recipientsList.join(', ') : '-';
                const reportPosted = fmtDate(row.report_posted_at);
                const reportPdfButton = row.report_pdf_url
                    ? `<a class="tiny-btn" href="${escapeHtml(row.report_pdf_url)}" target="_blank" rel="noopener">Open PDF</a>`
                    : '<span class="pill">PDF pending</span>';

                const retryButton = String(row.status || '').toLowerCase() === 'failed' && String(row.source_type || '') === 'email_history' && Number.isFinite(Number(row.id))
                    ? `<button class="tiny-btn retry" onclick="retryEmail(${Number(row.id)})">Retry</button>`
                    : '';
                const resendButton = buildResendButton(row);

                const isBatchGroup = row.isBatchGroup === true;
                const encodedGroupToken = encodeURIComponent(String(row.group_token || ''));
                const batchDetailBtn = isBatchGroup
                    ? `<button class="tiny-btn" onclick="openBatchDetailsModal(decodeURIComponent('${encodedGroupToken}'))">View ${Number(row.batchCount || 0)} results</button>`
                    : '';

                const errorHtml = row.error_message ? `<div class="error-msg">${escapeHtml(row.error_message)}</div>` : '';

                return `
                    <tr>
                        <td>
                            <div><strong>${escapeHtml(row.student_name || '-')}</strong></div>
                            <div class="muted">ID: ${escapeHtml(row.student_id || '-')}</div>
                            ${isBatchGroup ? `<div class="batch-chip">Batch of ${Number(row.batchCount || 0)}</div>` : ''}
                        </td>
                        <td>
                            <div class="pill">${escapeHtml(activityLabel(row))}</div>
                            <div class="muted">${escapeHtml(String(row.delivery_domain || '-').toUpperCase())}</div>
                        </td>
                        <td>
                            <div>${escapeHtml(cls)}</div>
                            <div class="muted">${escapeHtml(term)}</div>
                        </td>
                        <td>${escapeHtml(fmtDate(row.created_at))}</td>
                        <td>${escapeHtml(fmtDate(row.sent_at))}</td>
                        <td>
                            <div>${escapeHtml(reportPosted)}</div>
                            ${String(row.source_type || '') === 'email_history' ? `<div class="muted">${row.pdf_generated ? 'Generated' : 'Not generated'}</div>` : ''}
                        </td>
                        <td>${statusBadge}</td>
                        <td>
                            ${recipientsList.length ? `<div class="pill">${recipientsList.length} recipient${recipientsList.length === 1 ? '' : 's'}</div><div class="recipients muted" title="${escapeHtml(recipients)}">${escapeHtml(recipients)}</div>` : '<span class="muted">-</span>'}
                            ${errorHtml}
                        </td>
                        <td>${escapeHtml(row.queued_by_name || '-')}</td>
                        <td>
                            <div class="row-actions">
                                ${reportPdfButton}
                                ${batchDetailBtn}
                                ${retryButton}
                                ${resendButton}
                            </div>
                        </td>
                    </tr>
                `;
            }).join('');
        }

        function renderMobileCards(emails) {
            const cards = document.getElementById('mobileCards');
            if (!emails.length) {
                cards.innerHTML = '<div class="empty-state">No delivery history found for the selected filters.</div>';
                return;
            }

            cards.innerHTML = emails.map((row) => {
                const cls = row.class_name || `Class #${row.class_id || '-'}`;
                const term = [row.term_name, row.year_label].filter(Boolean).join(' - ') || `Term #${row.term_id || '-'}`;
                const recipientsList = Array.isArray(row.recipient_emails) ? row.recipient_emails : [];
                const recipients = recipientsList.length ? recipientsList.join(', ') : '-';
                const retryButton = String(row.status || '').toLowerCase() === 'failed' && String(row.source_type || '') === 'email_history' && Number.isFinite(Number(row.id))
                    ? `<button class="tiny-btn retry" onclick="retryEmail(${Number(row.id)})">Retry</button>`
                    : '';
                const reportButton = row.report_pdf_url
                    ? `<a class="tiny-btn" href="${escapeHtml(row.report_pdf_url)}" target="_blank" rel="noopener">Open PDF</a>`
                    : '<span class="pill">PDF pending</span>';
                const isBatchGroup = row.isBatchGroup === true;
                const encodedGroupToken = encodeURIComponent(String(row.group_token || ''));
                const detailButton = isBatchGroup
                    ? `<button class="tiny-btn" onclick="openBatchDetailsModal(decodeURIComponent('${encodedGroupToken}'))">View ${Number(row.batchCount || 0)} results</button>`
                    : '';
                const resendButtonMobile = buildResendButton(row);

                return `
                    <article class="mobile-card">
                        <div class="card-head">
                            <div>
                                <div class="card-name">${escapeHtml(row.student_name || '-')}</div>
                                <div class="muted">ID: ${escapeHtml(row.student_id || '-')}</div>
                            </div>
                            <span class="badge ${statusClass(row.status)}">${escapeHtml(statusLabel(row.status))}</span>
                        </div>
                        <div class="card-head">
                            <div class="pill">${escapeHtml(activityLabel(row))}</div>
                            <div class="muted">${escapeHtml(String(row.delivery_domain || '-').toUpperCase())}</div>
                        </div>
                        ${isBatchGroup ? `<div class="batch-chip">Batch of ${Number(row.batchCount || 0)}</div>` : ''}
                        <div class="card-grid">
                            <div class="mobile-row"><strong>Class</strong>${escapeHtml(cls)}</div>
                            <div class="mobile-row"><strong>Term</strong>${escapeHtml(term)}</div>
                            <div class="mobile-row"><strong>Created</strong>${escapeHtml(fmtDate(row.created_at))}</div>
                            <div class="mobile-row"><strong>Sent</strong>${escapeHtml(fmtDate(row.sent_at))}</div>
                            <div class="mobile-row"><strong>Posted</strong>${escapeHtml(fmtDate(row.report_posted_at))}</div>
                            <div class="mobile-row"><strong>By</strong>${escapeHtml(row.queued_by_name || '-')}</div>
                        </div>
                        <div class="mobile-row full"><strong>Recipients</strong>${recipientsList.length ? escapeHtml(recipients) : '-'}</div>
                        ${row.error_message ? `<div class="error-msg">${escapeHtml(row.error_message)}</div>` : ''}
                        <div class="row-actions">${reportButton}${detailButton}${retryButton}${resendButtonMobile}</div>
                    </article>
                `;
            }).join('');
        }

        async function loadHistory() {
            document.getElementById('loading').style.display = 'block';
            document.getElementById('tableWrap').style.display = 'none';
            document.getElementById('mobileCards').style.display = 'none';

            try {
                const response = await fetch(buildUrlWithFilters());
                const result = await response.json();

                if (!response.ok || !result.success) {
                    alert(result.message || 'Failed to load delivery history');
                    return;
                }

                state.allEmails = Array.isArray(result.data) ? result.data : [];
                state.displayRows = buildDisplayRows(state.allEmails);
                populateStudentFilter(state.allEmails);
                updateStats(state.allEmails);
                renderTableRows(state.displayRows);
                renderMobileCards(state.displayRows);
                const groupedCount = state.displayRows.filter((row) => row.isBatchGroup === true).length;
                document.getElementById('resultMeta').textContent = `${state.allEmails.length} record${state.allEmails.length === 1 ? '' : 's'} loaded • ${state.displayRows.length} row${state.displayRows.length === 1 ? '' : 's'} shown${groupedCount ? ` (${groupedCount} batch group${groupedCount === 1 ? '' : 's'})` : ''}`;
            } catch (error) {
                console.error('Error loading history:', error);
                alert('Error loading delivery history');
            } finally {
                document.getElementById('loading').style.display = 'none';
                document.getElementById('tableWrap').style.display = '';
                document.getElementById('mobileCards').style.display = '';
            }
        }

        async function retryEmail(emailId) {
            if (!confirm('Retry sending this email now?')) return;

            try {
                const response = await fetch('/print/retryEmail', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ emailIds: [emailId] })
                });

                const result = await response.json();
                if (!response.ok || !result.success) {
                    alert(result.message || 'Failed to retry email');
                    return;
                }

                alert(result.message || 'Retry queued');
                await loadHistory();
            } catch (error) {
                console.error('Error retrying email:', error);
                alert('Error retrying email');
            }
        }

        async function loadFilters() {
            try {
                const classesResponse = await fetch(`/common/classes/${organizationId}/active`);
                const classesResult = await classesResponse.json();

                if (classesResult.success && Array.isArray(classesResult.classes)) {
                    const classFilter = document.getElementById('classFilter');
                    classFilter.innerHTML = '<option value="">All Classes</option>' +
                        classesResult.classes.map((c) => `<option value="${escapeHtml(c.class_id)}">${escapeHtml(c.class_name)}</option>`).join('');
                    if (defaultClassId) classFilter.value = defaultClassId;
                }

                const termsResponse = await fetch(`/common/terms/${organizationId}`);
                const termsResult = await termsResponse.json();

                if (termsResult.success && Array.isArray(termsResult.terms)) {
                    const termFilter = document.getElementById('termFilter');
                    termFilter.innerHTML = '<option value="">All Terms</option>' +
                        termsResult.terms.map((t) => `<option value="${escapeHtml(t.term_id)}">${escapeHtml(t.term_name)}</option>`).join('');
                    if (defaultTermId) termFilter.value = defaultTermId;
                }
            } catch (error) {
                console.error('Error loading filters:', error);
            }
        }

        function clearFilters() {
            document.getElementById('statusFilter').value = '';
            document.getElementById('domainFilter').value = '';
            document.getElementById('dateFromFilter').value = '';
            document.getElementById('dateToFilter').value = '';
            document.getElementById('batchFilter').value = '';
            document.getElementById('searchFilter').value = '';

            document.getElementById('classFilter').value = defaultClassId || '';
            document.getElementById('termFilter').value = defaultTermId || '';
            document.getElementById('studentFilter').value = '';
            state.selectedStudentId = '';

            loadHistory();
        }

        document.getElementById('refreshBtn').addEventListener('click', loadHistory);
        document.getElementById('clearBtn').addEventListener('click', clearFilters);
        document.getElementById('filtersToggle').addEventListener('click', () => {
            const toggle = document.getElementById('filtersToggle');
            const body = document.getElementById('filtersBody');
            const expanded = toggle.getAttribute('aria-expanded') === 'true';
            toggle.setAttribute('aria-expanded', String(!expanded));
            body.hidden = expanded;
        });
        document.getElementById('batchDetailsCloseBtn').addEventListener('click', closeBatchDetailsModal);
        document.getElementById('batchDetailsModal').addEventListener('click', (event) => {
            if (event.target && event.target.id === 'batchDetailsModal') {
                closeBatchDetailsModal();
            }
        });
        document.addEventListener('keydown', (event) => {
            if (event.key === 'Escape') {
                closeBatchDetailsModal();
            }
        });

        ['classFilter', 'termFilter', 'statusFilter', 'domainFilter', 'dateFromFilter', 'dateToFilter'].forEach((id) => {
            document.getElementById(id).addEventListener('change', loadHistory);
        });

        document.getElementById('studentFilter').addEventListener('change', function () {
            state.selectedStudentId = this.value;
            loadHistory();
        });

        let filterInputDebounce = null;
        ['batchFilter', 'searchFilter'].forEach((id) => {
            document.getElementById(id).addEventListener('input', () => {
                if (filterInputDebounce) clearTimeout(filterInputDebounce);
                filterInputDebounce = setTimeout(loadHistory, 350);
            });
        });

        (async () => {
            await loadFilters();
            await loadHistory();
        })();
    </script>
</body>
</html>
