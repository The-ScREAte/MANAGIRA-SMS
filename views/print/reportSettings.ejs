<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Report Settings</title>
  <style>
    :root {
      --font-family: "<%= (session && session.fontStyle ? String(session.fontStyle).trim() : 'Inter') %>", sans-serif;
      --bg: #f6f8fb;
      --card: #ffffff;
      --border: #e5e7eb;
      --muted: #6b7280;
      --text: #0f172a;
      --primary: var(--org-primary-color, #0f5a66);
      --primary-hover: var(--org-primary-hover, #0d4f59);
        --primary-hover-fill: color-mix(in srgb, var(--primary) 88%, white);
    }

    * { box-sizing: border-box; }

    body {
      margin: 0;
      font-family: var(--font-family);
      background: var(--bg);
      color: var(--text);
    }

    main {
      width: min(98vw, 1520px);
      max-width: 1520px;
      margin: 24px auto 48px;
      padding: 0 12px;
      box-sizing: border-box;
    }

    .hero { background: linear-gradient(135deg, var(--primary), #0b4c56); color: #fff; border-radius: 16px; padding: 20px 22px; box-shadow: 0 18px 34px rgba(0,0,0,0.14); margin-bottom: 16px; }
    .hero h1 { margin: 0 0 6px; font-size: 1.6rem; letter-spacing: 0.2px; }
    .hero p { margin: 0; opacity: 0.92; }

    .grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 14px; margin-bottom: 16px; }
    .card { background: var(--card); border: 1px solid var(--border); border-radius: 14px; box-shadow: 0 10px 24px rgba(15,45,50,0.12); padding: 16px 18px; }
    .card h2 { margin: 0 0 10px; font-size: 1.05rem; display: flex; align-items: center; gap: 8px; }
    .section-title { display: flex; align-items: center; gap: 10px; font-weight: 700; margin: 0 0 12px; }

    .form-group { margin-bottom: 10px; }
    .form-group label { font-weight: 600; font-size: 0.95rem; color: var(--primary); display: block; margin-bottom: 6px; }
    .form-group input:not([type="checkbox"]):not([type="radio"]),
    .form-group select,
    .form-group textarea { width: 100%; padding: 10px; border: 1px solid #cfd8dc; border-radius: 8px; background: #fff; font-size: 0.98rem; box-sizing: border-box; }
    .form-group input:focus,
    .form-group select:focus,
    .form-group textarea:focus { outline: none; border-color: var(--primary); }

    .form-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 10px 14px; align-items: start; }
    .form-row-2 { display: grid; grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); gap: 10px; align-items: start; }

    .btn { background: var(--primary); color: #fff; border: none; border-radius: 10px; padding: 10px 16px; font-weight: 700; cursor: pointer; box-shadow: 0 6px 14px rgba(15,90,102,0.16); transition: all 0.2s ease; }
    .btn:hover { background: var(--primary-hover-fill, var(--primary-hover)); transform: translateY(-1px); }
    .btn-danger { background: #e74c3c; box-shadow: 0 6px 14px rgba(231,76,60,0.2); }
    .btn-danger:hover { background: #c0392b; }

    .tag { display: inline-flex; align-items: center; gap: 6px; padding: 6px 10px; border-radius: 999px; background: rgba(15,90,102,0.08); font-weight: 600; font-size: 0.92rem; }
    .notice { background: #e7f3fe; border: 1px solid #bee5eb; border-radius: 10px; padding: 12px 14px; color: #0c5460; margin: 10px 0 14px; }
    .empty-panel { background: #fff; border: 1px solid var(--border); border-radius: 16px; box-shadow: 0 10px 24px rgba(15,45,50,0.12); padding: 28px 24px; text-align: center; }
    .empty-panel h2 { margin: 0 0 10px; color: var(--primary); }
    .empty-panel p { margin: 0 auto 18px; max-width: 640px; color: var(--muted); line-height: 1.6; }
    .empty-inline { padding: 14px 16px; border: 1px dashed var(--border); border-radius: 10px; background: #f8fafc; color: var(--muted); }

    .class-layout { display: grid; grid-template-columns: minmax(240px, 300px) minmax(0, 1fr); gap: 14px; align-items: start; }
    .class-list { background: #fff; border: 1px solid var(--border); border-radius: 12px; padding: 12px; box-shadow: 0 6px 18px rgba(15,45,50,0.1); display: flex; flex-wrap: wrap; gap: 8px; }
    .class-button { min-width: 120px; text-align: left; border: 1px solid var(--border); background: #fff; color: var(--text); padding: 9px 11px; border-radius: 10px; cursor: pointer; font-weight: 700; display: flex; justify-content: space-between; align-items: center; gap: 6px; }
    .class-button.active { border-color: var(--primary); background: rgba(15,90,102,0.08); color: var(--text); }
    .class-panel {
      background: #fff;
      border: 1px solid var(--border);
      border-radius: 12px;
      padding: 18px 20px;
      box-shadow: 0 6px 18px rgba(15,45,50,0.1);
      min-width: 0;
      max-width: 100%;
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
    }

    .table-wrapper { overflow-x: auto; overflow-y: visible; margin-top: 14px; -webkit-overflow-scrolling: touch; }
    table { width: 100%; border-collapse: collapse; min-width: 720px; }
    th, td { padding: 10px 8px; border: 1px solid #e0e0e0; text-align: left; }
    th { background: #f4f7fa; color: var(--primary); }

    .sig-canvas-wrapper { border: 1px dashed var(--border); border-radius: 10px; background: linear-gradient(180deg, #ffffff 0%, #f8fafc 100%); padding: 10px; box-shadow: inset 0 1px 0 rgba(255,255,255,0.85); }
    .sig-canvas { width: 100%; height: 200px; border-radius: 8px; background: #fafafa; touch-action: none; cursor: crosshair; display: block; }
    .sig-canvas-actions { display: flex; gap: 10px; margin-top: 10px; flex-wrap: wrap; }
    .sig-status { margin-top: 8px; font-size: 0.9rem; color: var(--muted); }
    .sig-helper-text { margin-top: 10px; font-size: 0.88rem; color: var(--muted); line-height: 1.45; }

    .remark-row { display: flex; justify-content: space-between; align-items: flex-start; gap: 12px; padding: 8px 12px; border: 1px solid #e0e0e0; border-radius: 8px; margin-bottom: 6px; background: #fff; position: relative; }
    .remarks-list { position: relative; overflow: visible; }
    .remark-text { flex: 1; overflow-wrap: break-word; word-wrap: break-word; word-break: break-word; hyphens: auto; max-width: calc(100% - 40px); line-height: 1.5; }
    .kebab { width: 28px; height: 28px; display: inline-flex; align-items: center; justify-content: center; border: none; border-radius: 6px; cursor: pointer; background: transparent; font-weight: 700; font-size: 18px; color: #6b7280; flex-shrink: 0; margin-top: 2px; }
    .kebab-menu { position: relative; flex-shrink: 0; z-index: 40; }
    .kebab-menu.open { z-index: 2500; }
    .kebab-menu ul { list-style: none; padding: 6px 0; margin: 6px 0 0 0; position: absolute; right: 0; top: 100%; background: #fff; border: 1px solid #e5e7eb; border-radius: 8px; min-width: 120px; box-shadow: 0 10px 20px rgba(0,0,0,0.08); display: none; z-index: 2600; }
    .remarks-list .kebab-menu ul { top: auto; bottom: 100%; margin: 0 0 6px 0; }
    .kebab-menu ul li { padding: 8px 12px; }
    .kebab-menu ul li a { color: #e11d48; text-decoration: none; font-weight: 600; display: block; }
    .kebab-menu ul li:hover { background: #f8fafc; }
    .kebab-menu.open ul { display: block; }

    /* Loading spinner */
    .loading-overlay { position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,0.5); z-index: 9999; display: none; align-items: center; justify-content: center; }
    .loading-overlay.active { display: flex; }
    .spinner { width: 50px; height: 50px; border: 4px solid rgba(255,255,255,0.3); border-top-color: #fff; border-radius: 50%; animation: spin 0.8s linear infinite; }
    @keyframes spin { to { transform: rotate(360deg); } }
    @keyframes dsFadeIn { from { opacity:0; transform:translateY(-4px); } to { opacity:1; transform:translateY(0); } }

    .ds-col-grid { display:grid; grid-template-columns:1fr 1fr; gap:20px; align-items:start; }
    @media (max-width: 760px) { .ds-col-grid { grid-template-columns:1fr; } }
    /* Advanced DS compact styles */
    .ds-adv-section-label { margin:0 0 8px;font-size:0.72rem;font-weight:700;text-transform:uppercase;letter-spacing:0.06em;color:var(--muted); }
    .ds-adv-group { margin-bottom:3px; }
    .ds-adv-masterrow { display:flex;align-items:center;justify-content:space-between;padding:6px 9px;background:#fff;border:1px solid var(--border);border-radius:7px;cursor:pointer; }
    .ds-adv-lbl { display:flex;align-items:center;gap:7px;cursor:pointer;flex:1;font-size:0.85rem;font-weight:600; }
    .ds-adv-sub { padding:5px 7px 3px 11px;border:1px solid var(--border);border-top:none;border-radius:0 0 7px 7px;background:#fdfdfd;margin-bottom:2px; }
    .ds-adv-sub-lbl { display:flex;align-items:center;gap:6px;padding:3px 5px;border-radius:5px;cursor:pointer;font-size:0.82rem;color:#475569; }
    .ds-adv-sub-lbl:hover { background:#f1f5f9; }
    .ds-adv-flat-lbl { display:flex;align-items:center;gap:6px;padding:5px 8px;background:#fff;border:1px solid var(--border);border-radius:6px;cursor:pointer;font-size:0.82rem;font-weight:500; }
    .ds-adv-flat-lbl:hover { background:#f1f5f9; }
    .ds-adv-grid { display:grid;grid-template-columns:1fr 1fr;gap:16px; }
    @media (max-width:640px) { .ds-adv-grid { grid-template-columns:1fr; } }

    .paygira-adv-box {
      margin-top: 8px;
      border: 1px solid var(--border);
      border-radius: 8px;
      background: #f8fafc;
      padding: 10px;
      display: none;
    }

    .paygira-adv-row {
      display: flex;
      align-items: center;
      gap: 8px;
      flex-wrap: wrap;
      margin-bottom: 8px;
    }

    .paygira-field-card {
      border: 1px solid #dbe3ee;
      border-radius: 8px;
      padding: 8px;
      background: #fff;
      margin-bottom: 8px;
    }

    .paygira-field-toggle {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 8px;
      margin-top: 6px;
      padding: 6px 8px;
      border: 1px solid #e2e8f0;
      border-radius: 6px;
      background: #f8fafc;
      color: #334155;
      font-size: 12px;
      font-weight: 600;
      cursor: pointer;
      user-select: none;
    }

    .paygira-field-toggle:focus-visible {
      outline: 2px solid color-mix(in srgb, var(--primary) 40%, white);
      outline-offset: 1px;
    }

    .paygira-field-toggle-arrow {
      font-size: 10px;
      color: var(--muted);
      transition: transform 0.2s ease;
    }

    .paygira-field-card.is-open .paygira-field-toggle-arrow {
      transform: rotate(180deg);
    }

    .paygira-preview-box.is-open .paygira-field-toggle-arrow {
      transform: rotate(180deg);
    }

    .paygira-field-row {
      display: grid;
      grid-template-columns: 1.2fr 1fr auto;
      gap: 6px;
      margin-bottom: 6px;
      align-items: center;
    }

    .paygira-totals-wrap {
      margin-top: 10px;
      border-top: 1px dashed #dbe3ee;
      padding-top: 8px;
    }

    .paygira-total-card {
      border: 1px solid #dbe3ee;
      border-radius: 8px;
      padding: 8px;
      background: #fff;
      margin-bottom: 8px;
    }

    .paygira-total-toggle {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 8px;
      margin-top: 6px;
      padding: 6px 8px;
      border: 1px solid #e2e8f0;
      border-radius: 6px;
      background: #f8fafc;
      color: #334155;
      font-size: 12px;
      font-weight: 600;
      cursor: pointer;
      user-select: none;
    }

    .paygira-total-toggle:focus-visible {
      outline: 2px solid color-mix(in srgb, var(--primary) 40%, white);
      outline-offset: 1px;
    }

    .paygira-total-card.is-open .paygira-field-toggle-arrow {
      transform: rotate(180deg);
    }

    .paygira-total-row {
      display: grid;
      grid-template-columns: 1fr auto auto;
      gap: 6px;
      align-items: center;
      margin-bottom: 6px;
    }

    .paygira-total-fields {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
      gap: 4px 8px;
      border-top: 1px dashed #e2e8f0;
      padding-top: 6px;
    }

    .paygira-total-field {
      display: inline-flex;
      align-items: center;
      gap: 5px;
      font-size: 11px;
      color: #334155;
      margin: 0;
      cursor: pointer;
    }

    .paygira-total-field.is-disabled {
      opacity: 0.45;
      cursor: not-allowed;
    }

    .paygira-total-preview {
      color: #0f172a;
      font-weight: 700;
    }

    .paygira-total-preview-note {
      color: #64748b;
      font-size: 10px;
    }

    .input-required-error {
      border-color: #dc2626 !important;
      box-shadow: 0 0 0 2px rgba(220, 38, 38, 0.12);
      background: #fff7f7 !important;
    }

    .paygira-field-apply {
      border-top: 1px dashed #e2e8f0;
      padding-top: 6px;
      margin-top: 4px;
    }

    .paygira-preview-box {
      margin-top: 10px;
      border: 1px solid #dbe3ee;
      border-radius: 8px;
      background: #ffffff;
      padding: 8px;
    }

    .paygira-preview-title {
      font-size: 11px;
      color: var(--muted);
      font-weight: 700;
      margin-bottom: 6px;
      text-transform: uppercase;
      letter-spacing: 0.04em;
    }

    .paygira-preview-table {
      width: 100%;
      border-collapse: collapse;
      font-size: 11px;
    }

    .paygira-preview-table th,
    .paygira-preview-table td {
      border: 1px solid #e2e8f0;
      padding: 5px 6px;
      text-align: left;
      vertical-align: top;
    }

    .paygira-preview-table th {
      background: #f8fafc;
      color: #334155;
      font-weight: 700;
    }

    .paygira-field-apply-title {
      font-size: 11px;
      color: var(--muted);
      margin-bottom: 4px;
      font-weight: 600;
    }

    .paygira-apply-classes-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
      gap: 4px 8px;
    }

    .paygira-apply-class {
      display: inline-flex;
      align-items: center;
      gap: 5px;
      font-size: 11px;
      color: #334155;
      margin: 0;
      cursor: pointer;
    }

    .paygira-field-row input,
    .paygira-total-row input,
    .paygira-field-row select,
    .paygira-adv-row input[type="date"] {
      border: 1px solid var(--border);
      border-radius: 6px;
      padding: 5px 7px;
      background: #fff;
      font-size: 12px;
    }

    /* Keep Advanced panel fully contained on narrow screens */
    #advancedDsAccordion,
    #advancedDsPanel {
      max-width: 100%;
    }

    #advancedDsPanel {
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
    }

    #advancedDsToggleBtn {
      padding: 8px 12px !important;
      font-size: 0.8rem !important;
      background: #f8fafc !important;
    }

    #advancedDsPanel {
      padding: 10px 12px !important;
      background: #fff !important;
    }

    #advancedDsPanel .ds-adv-grid {
      gap: 10px !important;
    }

    #advancedDsPanel .ds-adv-section-label {
      margin-bottom: 5px !important;
      font-size: 0.68rem !important;
      letter-spacing: 0.05em !important;
    }

    #advancedDsPanel .ds-adv-flat-lbl,
    #advancedDsPanel .ds-adv-sub-lbl,
    #advancedDsPanel .ds-adv-lbl {
      font-size: 0.78rem !important;
      padding: 4px 6px !important;
      border-radius: 6px !important;
      border: 1px solid #e5e7eb !important;
      background: #fff !important;
    }

    #advancedDsPanel * {
      min-width: 0;
      max-width: 100%;
      box-sizing: border-box;
    }

    .rs-score-header-grid {
      display: grid;
      grid-template-columns: auto 1fr auto;
      align-items: center;
      gap: 10px;
      margin-bottom: 10px;
    }

    .rs-score-header-row {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 10px;
      margin-bottom: 10px;
    }

    .rs-action-links {
      display: flex;
      align-items: center;
      gap: 8px;
      flex-wrap: wrap;
      justify-content: flex-end;
      min-width: 0;
    }

    .rs-action-link {
      color: var(--primary);
      font-weight: 600;
      font-size: 0.8rem;
      text-decoration: none;
      line-height: 1.2;
      padding: 4px 7px;
      border-radius: 8px;
      border: 1px solid transparent;
      transition: all 0.16s ease;
    }

    .rs-action-link:hover {
      background: rgba(15,90,102,0.08);
      border-color: rgba(15,90,102,0.2);
    }

    .rs-grade-format-panel {
      margin-top: 10px;
      padding-top: 10px;
      border-top: 1px dashed var(--border);
    }

    .rs-grade-format-row {
      display: flex;
      align-items: center;
      gap: 8px;
      flex-wrap: wrap;
      min-width: 0;
    }

    .rs-grade-config-trigger {
      display: none;
      align-items: center;
      gap: 8px;
    }

    .rs-grade-strategy-option {
      display: flex;
      align-items: flex-start;
      gap: 6px;
      color: #334155;
      font-size: 0.76rem;
      margin: 0;
      border: 1px solid #e2e8f0;
      border-radius: 8px;
      background: #fff;
      padding: 7px 8px;
      line-height: 1.3;
    }

    .rs-grade-strategy-details {
      display: none;
      padding-left: 22px;
      margin-top: -2px;
    }

    .rs-grade-strategy-detail-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(170px, 1fr));
      gap: 8px;
    }

    .rs-grade-base-stack {
      display: flex;
      flex-direction: column;
      gap: 8px;
      max-width: 100%;
    }

    @media (min-width: 980px) {
      #gradeBasePlusDetailsWrap .rs-grade-base-stack {
        display: grid;
        grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
        gap: 10px;
        align-items: start;
      }

      #gradeBasePlusDetailsWrap #gradeBaseSubjectCountWrap,
      #gradeBasePlusDetailsWrap #gradeCoreSubjectConfigWrap {
        grid-column: 1 / -1;
      }

      #gradeBasePlusDetailsWrap #gradeOtherSubjectCountWrap,
      #gradeBasePlusDetailsWrap #gradeBaseRandomSelectionTypeWrap {
        width: 100%;
        max-width: none !important;
      }
    }

    .rs-grade-core-glass,
    .rs-grade-core-glass-pane {
      border: 1px solid rgba(14, 116, 144, 0.28);
      background: linear-gradient(140deg, rgba(236, 253, 255, 0.86), rgba(224, 242, 254, 0.72));
      box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.55);
      backdrop-filter: blur(4px);
      border-radius: 10px;
      padding: 8px 10px;
    }

    .rs-grade-core-subject-grid {
      border-color: rgba(14, 116, 144, 0.24);
      background: rgba(239, 246, 255, 0.88);
    }

    .rs-grade-core-subject-grid .rs-grade-subject-item {
      border-color: rgba(14, 116, 144, 0.22);
      background: rgba(224, 242, 254, 0.92);
      color: #0f4b5a;
    }

    .rs-grade-random-glass,
    .rs-grade-random-glass-pane {
      border: 1px solid rgba(21, 128, 61, 0.26);
      background: linear-gradient(140deg, rgba(240, 253, 244, 0.86), rgba(220, 252, 231, 0.72));
      box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.54);
      backdrop-filter: blur(4px);
      border-radius: 10px;
      padding: 8px 10px;
    }

    .rs-grade-random-select {
      border: 1px solid rgba(21, 128, 61, 0.3);
      background: rgba(220, 252, 231, 0.92);
      color: #166534;
    }

    .rs-grade-random-subject-grid {
      border-color: rgba(21, 128, 61, 0.24);
      background: rgba(240, 253, 244, 0.9);
    }

    .rs-grade-random-subject-grid .rs-grade-subject-item {
      border-color: rgba(21, 128, 61, 0.22);
      background: rgba(220, 252, 231, 0.92);
      color: #166534;
    }

    .rs-grade-config-modal {
      position: fixed;
      inset: 0;
      background: rgba(8, 15, 30, 0.48);
      display: none;
      align-items: center;
      justify-content: center;
      z-index: 10030;
      padding: 16px;
    }

    .rs-grade-config-card {
      width: min(680px, 96vw);
      max-height: 90vh;
      overflow-y: auto;
      background: #fff;
      border: 1px solid #d8e3ef;
      border-radius: 14px;
      box-shadow: 0 28px 74px rgba(0,0,0,0.28);
      padding: 14px;
    }

    .rs-grade-config-head {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 10px;
      margin-bottom: 10px;
    }

    .rs-grade-config-title {
      margin: 0;
      font-size: 0.92rem;
      color: #1f2937;
      font-weight: 800;
      letter-spacing: 0.01em;
    }

    .rs-grade-config-close {
      border: 1px solid #d7e1ec;
      width: 28px;
      height: 28px;
      border-radius: 8px;
      background: #f8fafc;
      color: #475569;
      cursor: pointer;
      font-size: 0.9rem;
      line-height: 1;
    }

    .rs-grade-config-note {
      margin: 0 0 10px;
      font-size: 0.76rem;
      color: #64748b;
      line-height: 1.35;
    }

    #showGradeNumericTotalWrap {
      display: flex;
      flex-direction: column;
      gap: 8px;
      padding: 8px 10px;
      border-radius: 10px;
      border: 1px solid #d7e3ef;
      background: #f8fafc;
      transition: background-color 0.16s ease, border-color 0.16s ease, color 0.16s ease;
    }

    #showGradeNumericTotalWrap.is-checked {
      border-color: rgba(37, 99, 235, 0.36);
