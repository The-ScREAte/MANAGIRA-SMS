          </label>
        </div>
        <div id="ds-adv-paygira-box" class="paygira-adv-box" style="display:${paygiraEnabled ? 'block' : 'none'};">
          <div class="paygira-adv-row">
            <label class="ds-adv-sub-lbl" style="padding:0;">
              <input type="radio" name="ds-paygira-mode" value="auto" ${paygiraMode === 'auto' ? 'checked' : ''}>
