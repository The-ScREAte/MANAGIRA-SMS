    function dsEsc(str) {
      return String(str).replace(/&/g,'&amp;').replace(/"/g,'&quot;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
    }
    const _dsXIcon = '<svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink:0"><circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/></svg>';

    function buildMasterGroupHtml(cat, label, items, masterOn, itemsState) {
      if (items.length === 0) {
        return `<div class="ds-adv-group"><div class="ds-adv-masterrow" style="border-radius:7px;cursor:default;">
          <label class="ds-adv-lbl" onclick="event.stopPropagation()">
            <input type="checkbox" class="ds-adv-master" data-cat="${cat}" style="accent-color:var(--primary);cursor:pointer;" ${masterOn ? 'checked' : ''}>
            <span>${dsEsc(label)}</span>
          </label>
        </div></div>`;
      }
      const subOpen = !masterOn;
      const banner = !masterOn
        ? `<div class="ds-master-off-banner" style="display:flex;align-items:center;gap:5px;margin-bottom:5px;padding:4px 8px;font-size:11px;color:#b91c1c;font-weight:600;background:#fef2f2;border:1px solid #fecaca;border-radius:6px;">${_dsXIcon} Column disabled — all excluded</div>`
        : '';
      const itemsHtml = items.map(a => {
        const checked = masterOn && itemsState[a.title] !== false;
        return `<label class="ds-adv-sub-lbl" style="${!masterOn ? 'opacity:0.42;pointer-events:none;' : ''}">
          <input type="checkbox" class="ds-adv-item" data-cat="${cat}" data-id="${dsEsc(a.title)}" style="accent-color:var(--primary);" ${checked ? 'checked' : ''} ${!masterOn ? 'disabled' : ''}>
          ${dsEsc(a.title)}
        </label>`;
      }).join('');
      return `<div class="ds-adv-group" data-cat="${cat}">
        <div class="ds-adv-masterrow" onclick="dsAdvToggleSub(this.closest('.ds-adv-group'))" style="border-radius:${subOpen ? '7px 7px 0 0' : '7px'};">
          <label class="ds-adv-lbl" onclick="event.stopPropagation()">
            <input type="checkbox" class="ds-adv-master" data-cat="${cat}" style="accent-color:var(--primary);cursor:pointer;" ${masterOn ? 'checked' : ''}>
            <span>${dsEsc(label)}</span>
          </label>
          <span class="ds-arrow" style="font-size:10px;color:var(--muted);transition:transform 0.2s;${subOpen ? 'transform:rotate(180deg)' : ''}">▼</span>
        </div>
        <div class="ds-adv-sub" style="display:${subOpen ? 'block' : 'none'};">
          ${banner}${itemsHtml}
        </div>
      </div>`;
    }

    function renderAdvancedDs(classId) {
      const panel = document.getElementById('advancedDsPanel');
      if (!panel) return;
      const ds = allDisplaySettingsMap[String(classId)];
      if (!ds) { panel.innerHTML = '<p style="color:var(--muted);font-size:0.85rem;margin:0;">No assessments found for this class.</p>'; return; }
      const catMap = allAssessmentsByCategoryMap[String(classId)] || {};
      const classItems = catMap['Class Assessment'] || [];
      const examsItems = [...(catMap['Exams Assessment'] || []), ...(catMap['Exam Assessment'] || [])];
      const otherItems = [...(catMap['Other'] || []), ...(catMap['Other Assessment'] || [])];

      const flatCols = [['totalScore','Total Score'],['scaledScore','Scaled Score'],['totalPercentage','Total %'],['grade','Grade'],['position','Position'],['remarksCol','Remarks Col']];
      const flatColsHtml = flatCols.map(([key,lbl]) => `
        <label class="ds-adv-flat-lbl">
          <input type="checkbox" class="ds-adv-col" data-key="${key}" style="accent-color:var(--primary);" ${ds.columns[key] ? 'checked' : ''}>
          ${lbl}
        </label>`).join('');

      const secRows = [['teacherRemarks','💬','Teacher Remarks'],['conductRemarks','📋','Conduct Remarks'],['attitudeRemarks','🌟','Attitude Remarks'],['interestRemarks','🎯','Interest Remarks'],['gradeKey','🔑','Grade Key'],['attendance','📅','Attendance'],['promotion','🎓','Promotion']];
      const secHtml = secRows.map(([key,icon,lbl]) => `
        <label class="ds-adv-flat-lbl">
          <input type="checkbox" class="ds-adv-sec" data-key="${key}" style="accent-color:var(--primary);" ${ds.sections[key] ? 'checked' : ''}>
          <span style="font-size:13px;line-height:1;">${icon}</span> ${lbl}
        </label>`).join('');

      // Activate Promotion — stored in status_settings, synced to the hidden form checkbox
      const statusData = (typeof statusSettingsMap !== 'undefined') ? statusSettingsMap[String(classId)] : null;
      const activationOn = statusData ? !!statusData.activate_promotion : false;
      const activatePromotionRow = `<label class="ds-adv-flat-lbl" style="border-color:#e2e8f0;background:#f0fdf4;">
          <input type="checkbox" id="ds-adv-activatePromotion" style="accent-color:#16a34a;" ${activationOn ? 'checked' : ''}>
          <span style="font-size:13px;line-height:1;">🚦</span> Activate Promotion
        </label>`;

      panel.dataset.classId = String(classId);
      panel.innerHTML = `
        <div class="ds-adv-grid">
          <div>
            <p class="ds-adv-section-label">Score Columns</p>
            ${buildMasterGroupHtml('classScore','Class Score',classItems,ds.columns.classScore,ds.columns.classScore_items)}
            ${buildMasterGroupHtml('examsScore','Exams Score',examsItems,ds.columns.examsScore,ds.columns.examsScore_items)}
            ${buildMasterGroupHtml('otherScore','Other Score',otherItems,ds.columns.otherScore,ds.columns.otherScore_items)}
            <div style="display:grid;grid-template-columns:1fr 1fr;gap:3px;margin-top:6px;">${flatColsHtml}</div>
          </div>
          <div>
            <p class="ds-adv-section-label">Report Sections</p>
            <div style="display:flex;flex-direction:column;gap:3px;">${activatePromotionRow}${secHtml}</div>
          </div>
        </div>
        <div style="margin-top:12px;display:flex;align-items:center;gap:10px;">
          <button type="button" id="advDsSaveBtn" class="btn" style="padding:7px 18px;font-size:0.85rem;">Save Advanced</button>
          <span id="advDsSaveMsg" style="font-size:12px;color:#16a34a;font-weight:600;display:none;animation:dsFadeIn 0.3s ease;">✓ Saved</span>
        </div>`;

      // Wire master toggles
      panel.querySelectorAll('.ds-adv-master').forEach(masterCb => {
        masterCb.addEventListener('change', function() {
          const group = this.closest('.ds-adv-group');
          if (!group) return;
          this.checked ? dsAdvMasterOn(group) : dsAdvMasterOff(group, true);
        });
      });

      // Sync "Activate Promotion" in Advanced to the hidden form checkbox
      const advActProm = document.getElementById('ds-adv-activatePromotion');
      const hiddenActProm = document.getElementById('activatePromotion');
      if (advActProm && hiddenActProm) {
        advActProm.addEventListener('change', function() { hiddenActProm.checked = this.checked; });
      }

      // Wire save button
      document.getElementById('advDsSaveBtn')?.addEventListener('click', async () => {
        const ok = await saveAdvancedDisplaySettings(classIdField.value);
        if (ok) {
          // Sync in-memory statusSettingsMap so renderAdvancedDs reads correct state on next switch
          const advAP = document.getElementById('ds-adv-activatePromotion');
          if (advAP && statusSettingsMap[String(classIdField.value)]) {
            statusSettingsMap[String(classIdField.value)].activate_promotion = advAP.checked;
          }
          const msg = document.getElementById('advDsSaveMsg');
          msg.style.display = 'inline';
          setTimeout(() => msg.style.display = 'none', 2500);
        } else {
          alert('Failed to save display settings.');
        }
      });
    }

    function dsAdvToggleSub(group) {
      const sub = group.querySelector('.ds-adv-sub');
      const row = group.querySelector('.ds-adv-masterrow');
      const arrow = row?.querySelector('.ds-arrow');
      if (!sub) return;
      const isOpen = sub.style.display !== 'none';
      sub.style.display = isOpen ? 'none' : 'block';
      if (arrow) arrow.style.transform = isOpen ? '' : 'rotate(180deg)';
      if (row) row.style.borderRadius = isOpen ? '7px' : '7px 7px 0 0';
    }
    window.dsAdvToggleSub = dsAdvToggleSub;

    function dsAdvMasterOff(group, saveState) {
      const sub = group.querySelector('.ds-adv-sub');
      if (!sub) return;
      if (saveState) {
        const snap = {};
        sub.querySelectorAll('.ds-adv-item').forEach(cb => { snap[cb.dataset.id] = cb.checked; });
        sub.dataset.savedState = JSON.stringify(snap);
      }
      // Force open
      if (sub.style.display === 'none') {
        const row = group.querySelector('.ds-adv-masterrow');
        sub.style.display = 'block';
        if (row) { row.style.borderRadius = '7px 7px 0 0'; const a = row.querySelector('.ds-arrow'); if (a) a.style.transform = 'rotate(180deg)'; }
      }
      // Disable items
      sub.querySelectorAll('.ds-adv-item').forEach(cb => {
        cb.checked = false; cb.disabled = true;
        const lbl = cb.closest('label'); if (lbl) { lbl.style.opacity = '0.42'; lbl.style.pointerEvents = 'none'; }
      });
      // Banner
      let banner = sub.querySelector('.ds-master-off-banner');
      if (!banner) {
        banner = document.createElement('div'); banner.className = 'ds-master-off-banner';
        banner.style.cssText = 'display:flex;align-items:center;gap:5px;margin-bottom:5px;padding:4px 8px;font-size:11px;color:#b91c1c;font-weight:600;background:#fef2f2;border:1px solid #fecaca;border-radius:6px;';
        banner.innerHTML = _dsXIcon + ' Column disabled — all excluded';
        sub.insertBefore(banner, sub.firstChild);
      } else { banner.style.display = 'flex'; }
    }

    function dsAdvMasterOn(group) {
      const sub = group.querySelector('.ds-adv-sub');
      if (!sub) return;
      let snap = {}; try { snap = JSON.parse(sub.dataset.savedState || '{}'); } catch(e) {}
      sub.querySelectorAll('.ds-adv-item').forEach(cb => {
        cb.checked = snap.hasOwnProperty(cb.dataset.id) ? snap[cb.dataset.id] : true;
        cb.disabled = false;
        const lbl = cb.closest('label'); if (lbl) { lbl.style.opacity = ''; lbl.style.pointerEvents = ''; }
      });
      const banner = sub.querySelector('.ds-master-off-banner'); if (banner) banner.style.display = 'none';
    }

    async function saveAdvancedDisplaySettings(classId) {
      const panel = document.getElementById('advancedDsPanel');
      if (!panel) return false;
      // Guard: only save if panel is showing data for the requested class
      if (panel.dataset.classId && panel.dataset.classId !== String(classId)) {
        console.warn('[DS] saveAdvancedDisplaySettings: panel classId mismatch, skipping');
        return false;
      }
      const columns = {};
      panel.querySelectorAll('.ds-adv-master').forEach(cb => { columns[cb.dataset.cat] = cb.checked; });
      ['classScore','examsScore','otherScore'].forEach(cat => {
        const items = {};
        panel.querySelectorAll(`.ds-adv-item[data-cat="${cat}"]`).forEach(cb => { items[cb.dataset.id] = cb.checked; });
        columns[cat + '_items'] = items;
      });
      panel.querySelectorAll('.ds-adv-col').forEach(cb => { columns[cb.dataset.key] = cb.checked; });
      const sections = {};
      panel.querySelectorAll('.ds-adv-sec').forEach(cb => { sections[cb.dataset.key] = cb.checked; });
      const advActProm = document.getElementById('ds-adv-activatePromotion');
      const activatePromValue = advActProm ? advActProm.checked : null;
      try {
        const apParam = activatePromValue !== null ? `&activatePromotion=${activatePromValue}` : '';
        const resp = await fetch(`/print/saveDisplaySettings?classId=${encodeURIComponent(classId)}&termId=<%= termId %>${apParam}`, {
          method: 'POST', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ columns, sections }),
        });
        const result = await resp.json();
        if (result.success) { allDisplaySettingsMap[String(classId)] = { columns, sections }; return true; }
        return false;
      } catch(e) { console.error(e); return false; }
    }

    // Intercept status settings form to also save advanced DS settings first
    document.getElementById('statusSettingsForm')?.addEventListener('submit', async function(e) {
      e.preventDefault();
      await saveAdvancedDisplaySettings(classIdField.value);
      this.submit();
    });

    // ── Collapsible cards ──
    (function initCardCollapse() {
      const isLarge = window.innerWidth >= 960;
      document.querySelectorAll('.card').forEach((card, index) => {
        // First card = "Class-specific Status Settings" — keep open on large screens
        const isStatusCard = index === 0;
        const header = card.querySelector(':scope > h2, :scope > .section-title');
        if (!header) return;

        card.classList.add('collapsible-card');

        // Arrow indicator
        const arrow = document.createElement('span');
        arrow.className = 'card-collapse-arrow';
        arrow.textContent = '▼';

        // Wrap header in clickable div
        const hdr = document.createElement('div');
        hdr.className = 'card-collapse-hdr';
        header.parentNode.insertBefore(hdr, header);
        hdr.appendChild(header);
        hdr.appendChild(arrow);

        // Wrap remaining card content in a collapsible body div
        const body = document.createElement('div');
        body.className = 'card-collapse-body';
        while (hdr.nextSibling) {
          body.appendChild(hdr.nextSibling);
        }
        card.appendChild(body);

        // Toggle on click
        hdr.addEventListener('click', () => card.classList.toggle('collapsed'));

        // Initial state: large screen keeps status card open, all others collapsed everywhere
        if (!isLarge || !isStatusCard) {
          card.classList.add('collapsed');
        }
      });
    })();

  </script>
  <% } %>
</body>
</html>
