      gradeFormContainer.style.display = isVisible ? 'none' : 'block';
      toggleGradeFormLink.textContent = isVisible ? 'Grade & Remark Rule' : 'Hide Form';

      if (!isVisible) {
        setCurrentClassAsDefaultChecked(gradeClassCheckboxes, selectAllGradeClasses);
      } else {
        gradeForm.reset();
        resetGradeEditMode();
        renderRuleFormClassCheckboxes(gradeClassCheckboxes, 'grade-class', selectAllGradeClasses, new Set());
      }
    });

    cancelGradeMappingBtn?.addEventListener('click', () => {
      gradeForm.reset();
      resetGradeEditMode();
      gradeFormContainer.style.display = 'none';
      if (toggleGradeFormLink) toggleGradeFormLink.textContent = 'Grade & Remark Rule';
      renderRuleFormClassCheckboxes(gradeClassCheckboxes, 'grade-class', selectAllGradeClasses, new Set());
    });

    gradeForm?.addEventListener('submit', async (e) => {
      e.preventDefault();
      let selectedClasses = Array.from(gradeClassCheckboxes.querySelectorAll('.score-class-checkbox:checked')).map(cb => cb.value);
      const termId = '<%= termId %>';
      const editingRowId = editingGradeRowIdInput.value ? Number(editingGradeRowIdInput.value) : null;
      if(!selectedClasses.length){
        alert('Please select at least one class.');
        return;
      }

      const validatedRows = getValidatedGradeRuleRows({ requireSingle: Boolean(editingRowId) });
      if (!validatedRows.ok) {
        alert(validatedRows.message || 'Please complete all rule rows before saving.');
        return;
      }

      if (ruleSaveRequestInFlight) {
        return;
      }

      let didShowLoading = false;
      ruleSaveRequestInFlight = true;
      showLoading();
      didShowLoading = true;
      if (saveGradeMappingBtn) {
        saveGradeMappingBtn.disabled = true;
        saveGradeMappingBtn.textContent = editingRowId ? 'Updating...' : 'Saving...';
      }

      try {
        const rowsToProcess = validatedRows.rows || [];
        const savePlans = [];
        let lockedSkippedCount = 0;

        for (let index = 0; index < rowsToProcess.length; index += 1) {
          const row = rowsToProcess[index];

          if (editingRowId) {
            savePlans.push({
              index: index + 1,
              rowId: editingRowId,
              row,
              selectedClasses,
              action: undefined,
              bypassOverrideClassIds: undefined,
            });
            continue;
          }

          const savePlan = await prepareRuleSaveRequest('grade', selectedClasses, row.fromPct, row.toPct, null);
          lockedSkippedCount += Number(savePlan?.lockedSkippedCount || 0);

          if (savePlan?.cancelled) {
            if (savePlan.cancelReason === 'locked') {
              continue;
            }
            return;
          }

          const selectedClassesForRow = Array.isArray(savePlan?.selectedClasses)
            ? savePlan.selectedClasses
            : selectedClasses;
          if (!selectedClassesForRow.length) {
            continue;
          }

          savePlans.push({
            index: index + 1,
            rowId: null,
            row,
            selectedClasses: selectedClassesForRow,
            action: savePlan?.action,
            bypassOverrideClassIds: savePlan?.bypassOverrideClassIds,
          });
        }

        if (!savePlans.length) {
          alert('Selected classes are locked for all provided ranges. Unlock first to continue.');
          return;
        }

        let appliedRuleCount = 0;
        let bypassedTotal = 0;

        let result;
        if (editingRowId) {
          const plan = savePlans[0];
          const response = await fetch('/print/saveScoreRemarksAjax', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              entryType: 'grade',
              action: plan.action,
              rowId: plan.rowId || undefined,
              grade_label: plan.row.gradeLabel,
              remark: plan.row.remark,
              from_percentage: plan.row.fromPct,
              to_percentage: plan.row.toPct,
              termId,
              selectedClasses: plan.selectedClasses,
            })
          });
          result = await response.json();

          if(!result.success){
            if (Array.isArray(result.lockedClassIds) && result.lockedClassIds.length) {
              const lockFrom = result?.lockedRange?.from;
              const lockTo = result?.lockedRange?.to;
              const effectiveFrom = Number.isFinite(Number(lockFrom)) ? Number(lockFrom) : plan.row.fromPct;
              const effectiveTo = Number.isFinite(Number(lockTo)) ? Number(lockTo) : plan.row.toPct;
              applyRuleLockState('grade', result.lockedClassIds, effectiveFrom, effectiveTo, true);
              loadClassSettings(classIdField.value);
            }
            throw new Error(result.message || 'Failed to save grade & score rule.');
          }

          const sourceClassId = Number.parseInt(String(editingGradeSourceClassIdInput?.value || ''), 10);
          const additionalSelectedClasses = (Array.isArray(plan.selectedClasses) ? plan.selectedClasses : [])
            .map((classValue) => String(classValue))
            .filter((classValue) => {
              const parsedClassId = Number.parseInt(classValue, 10);
              return Number.isInteger(parsedClassId) && parsedClassId > 0 && parsedClassId !== sourceClassId;
            });

          if (additionalSelectedClasses.length) {
            const additionalResponse = await fetch('/print/saveScoreRemarksAjax', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({
                entryType: 'grade',
                action: 'bulkUpsertBatch',
                termId,
                selectedClasses: additionalSelectedClasses,
                ruleBatch: [{
                  from_percentage: plan.row.fromPct,
                  to_percentage: plan.row.toPct,
                  grade_label: plan.row.gradeLabel,
                  remark: plan.row.remark,
                  selectedClasses: additionalSelectedClasses,
                  bypassOverrideClassIds: [],
                }],
              })
            });
            const additionalResult = await additionalResponse.json();
            if (!additionalResult.success) {
              throw new Error(additionalResult.message || 'Rule was updated, but failed to apply to extra selected classes.');
            }

            if (additionalResult.classRowsMap && typeof additionalResult.classRowsMap === 'object') {
              result.classRowsMap = Object.assign({}, result.classRowsMap || {}, additionalResult.classRowsMap);
            }

            if (Array.isArray(additionalResult.savedRemarks) && additionalResult.savedRemarks.length) {
              result.savedRemarks = [...(Array.isArray(result.savedRemarks) ? result.savedRemarks : []), ...additionalResult.savedRemarks];
            }
          }

          appliedRuleCount = 1;
        } else {
          const mergedSelectedClasses = [...new Set(
            savePlans.flatMap((plan) => (Array.isArray(plan.selectedClasses) ? plan.selectedClasses : []))
          )];
          const ruleBatch = savePlans.map((plan) => ({
            from_percentage: plan.row.fromPct,
            to_percentage: plan.row.toPct,
            grade_label: plan.row.gradeLabel,
            remark: plan.row.remark,
            selectedClasses: plan.selectedClasses,
            bypassOverrideClassIds: Array.isArray(plan.bypassOverrideClassIds) ? plan.bypassOverrideClassIds : [],
          }));

          const response = await fetch('/print/saveScoreRemarksAjax', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              entryType: 'grade',
              action: 'bulkUpsertBatch',
              termId,
              selectedClasses: mergedSelectedClasses,
              ruleBatch,
            })
          });
          result = await response.json();

          if(!result.success){
            if (Array.isArray(result.lockedClassIds) && result.lockedClassIds.length) {
              const firstRule = ruleBatch[0] || {};
              const lockFrom = result?.lockedRange?.from;
              const lockTo = result?.lockedRange?.to;
              const effectiveFrom = Number.isFinite(Number(lockFrom)) ? Number(lockFrom) : Number(firstRule.from_percentage);
              const effectiveTo = Number.isFinite(Number(lockTo)) ? Number(lockTo) : Number(firstRule.to_percentage);
              if (Number.isFinite(effectiveFrom) && Number.isFinite(effectiveTo)) {
                applyRuleLockState('grade', result.lockedClassIds, effectiveFrom, effectiveTo, true);
              }
              loadClassSettings(classIdField.value);
            }
            throw new Error(result.message || 'Failed to save grade & score rules.');
          }
          appliedRuleCount = savePlans.length;
        }

        applyClassRowsMap(result.classRowsMap);
        if (Array.isArray(result.savedRemarks)) {
          result.savedRemarks.forEach((rem) => {
            if(!scoreRemarksMap[String(rem.class_id)]) scoreRemarksMap[String(rem.class_id)] = [];
            const existingIdx = scoreRemarksMap[String(rem.class_id)].findIndex((r) => r.id === rem.id);
            if(existingIdx >= 0){
              scoreRemarksMap[String(rem.class_id)][existingIdx] = rem;
            } else {
              scoreRemarksMap[String(rem.class_id)].push(rem);
            }
          });
        }

        bypassedTotal = Array.isArray(result?.skippedOverrideClassIds)
          ? result.skippedOverrideClassIds.length
          : 0;

        loadClassSettings(classIdField.value);
        gradeForm.reset();
        gradeFormContainer.style.display = 'none';
        if (toggleGradeFormLink) toggleGradeFormLink.textContent = 'Grade & Remark Rule';
        resetGradeEditMode();

        if (editingRowId) {
          showToast('Grade & score rule updated successfully!');
        } else {
          const saveNotes = [];
          if (bypassedTotal) saveNotes.push(`${bypassedTotal} class updates bypassed`);
          if (lockedSkippedCount) saveNotes.push(`${lockedSkippedCount} locked class updates skipped`);
          const noteText = saveNotes.length ? ` (${saveNotes.join(', ')})` : '';
          showToast(`Saved ${appliedRuleCount} rule(s) successfully${noteText}.`);
        }
      } catch(error){
        console.error('Error saving grade + score rule:', error);
        alert(error?.message || 'An error occurred while saving grade & score rule.');
      } finally {
        if (didShowLoading) {
          hideLoading();
        }
        ruleSaveRequestInFlight = false;
        if (saveGradeMappingBtn) {
          saveGradeMappingBtn.disabled = false;
          saveGradeMappingBtn.textContent = editingGradeRowIdInput?.value ? 'Update Grade & Remark' : 'Save Rules';
        }
      }
    });

    // Run initial class load last so earlier listener setup remains intact even if
    // a class-specific rendering issue happens for some users.
    if (classButtons.length) {
      try {
        loadClassSettings(classIdField.value || classButtons[0].dataset.classId);
      } catch (err) {
        console.error('Report settings initialization failed:', err);
      }
    }

    // Canvas signature
    const signatureFormContainer = document.getElementById('signatureFormContainer');
    const toggleSigFormLink = document.getElementById('toggleSignatureForm');

    function createSignaturePad(canvasId) {
      let canvas = null;
      let ctx = null;
      let initialized = false;
      let drawing = false;
      let pointerId = null;
      let currentStroke = [];
      let strokes = [];
      let hasInk = false;
      let resizeRaf = null;

      const baseStroke = 2.4;
      const minStroke = 1.1;
      const maxStroke = 3.8;

      function getCanvas() {
        if (!canvas) {
          canvas = document.getElementById(canvasId);
        }
        return canvas;
      }

      function getContext() {
        if (!ctx && getCanvas()) {
          ctx = canvas.getContext('2d');
        }
        return ctx;
      }

      function setCanvasSize() {
        const targetCanvas = getCanvas();
        const targetCtx = getContext();
        if (!targetCanvas || !targetCtx) return;

        const rect = targetCanvas.getBoundingClientRect();
        const ratio = Math.max(window.devicePixelRatio || 1, 1);
        targetCanvas.width = Math.max(1, Math.round(rect.width * ratio));
        targetCanvas.height = Math.max(1, Math.round(rect.height * ratio));
        targetCtx.setTransform(ratio, 0, 0, ratio, 0, 0);
        targetCtx.clearRect(0, 0, rect.width, rect.height);
        targetCtx.strokeStyle = '#0f172a';
        targetCtx.lineCap = 'round';
        targetCtx.lineJoin = 'round';
      }

      function distance(pointA, pointB) {
        const dx = pointB.x - pointA.x;
        const dy = pointB.y - pointA.y;
        return Math.hypot(dx, dy);
      }

      function midpoint(pointA, pointB) {
        return {
          x: (pointA.x + pointB.x) / 2,
          y: (pointA.y + pointB.y) / 2,
        };
      }

      function computeLineWidth(previousPoint, currentPoint) {
        if (!previousPoint) {
          return baseStroke;
        }

        const speed = distance(previousPoint, currentPoint) / Math.max(currentPoint.time - previousPoint.time, 1);
        const pressure = currentPoint.pressure && currentPoint.pressure > 0 ? currentPoint.pressure : 0.5;
        const velocityFactor = Math.max(0.45, 1.55 - speed * 2.2);
        const width = baseStroke * velocityFactor * (0.75 + pressure * 0.35);
        return Math.max(minStroke, Math.min(maxStroke, width));
      }

      function drawDot(point) {
        const targetCtx = getContext();
        if (!targetCtx) return;

        const radius = Math.max(minStroke, computeLineWidth(null, point)) / 2;
        targetCtx.beginPath();
        targetCtx.fillStyle = '#0f172a';
        targetCtx.arc(point.x, point.y, radius, 0, Math.PI * 2);
        targetCtx.fill();
      }

      function drawStroke(stroke) {
        const targetCtx = getContext();
        if (!targetCtx || !stroke.length) return;

        if (stroke.length === 1) {
          drawDot(stroke[0]);
          return;
        }

        for (let index = 1; index < stroke.length; index += 1) {
          const previousPoint = stroke[index - 1];
          const currentPoint = stroke[index];
          const previousMidpoint = index === 1 ? previousPoint : midpoint(stroke[index - 2], previousPoint);
          const currentMidpoint = midpoint(previousPoint, currentPoint);

          targetCtx.beginPath();
          targetCtx.lineWidth = computeLineWidth(previousPoint, currentPoint);
          targetCtx.moveTo(previousMidpoint.x, previousMidpoint.y);
          targetCtx.quadraticCurveTo(previousPoint.x, previousPoint.y, currentMidpoint.x, currentMidpoint.y);
          targetCtx.stroke();
        }
      }

      function redraw() {
        const targetCanvas = getCanvas();
        const targetCtx = getContext();
        if (!targetCanvas || !targetCtx) return;

        setCanvasSize();
        strokes.forEach(drawStroke);
      }

      function getRelativePoint(event) {
        const targetCanvas = getCanvas();
        if (!targetCanvas) return null;

        const rect = targetCanvas.getBoundingClientRect();
        return {
          x: event.clientX - rect.left,
          y: event.clientY - rect.top,
          time: performance.now(),
          pressure: typeof event.pressure === 'number' ? event.pressure : 0.5,
        };
      }

      function beginStroke(event) {
        const targetCanvas = getCanvas();
        if (!targetCanvas) return;

        event.preventDefault();
        const point = getRelativePoint(event);
        if (!point) return;

        drawing = true;
        pointerId = event.pointerId;
        currentStroke = [point];
        hasInk = true;
        targetCanvas.setPointerCapture?.(event.pointerId);
        drawDot(point);
      }

      function extendStroke(event) {
        if (!drawing || event.pointerId !== pointerId) return;

        event.preventDefault();
        const point = getRelativePoint(event);
        if (!point) return;

        const previousPoint = currentStroke[currentStroke.length - 1];
        if (previousPoint && distance(previousPoint, point) < 0.35) {
          return;
        }

        currentStroke.push(point);
        drawStroke(currentStroke.slice(-3));
      }

      function endStroke(event) {
        if (!drawing || event.pointerId !== pointerId) return;

        event.preventDefault();
        const targetCanvas = getCanvas();
        drawing = false;
        pointerId = null;

        if (currentStroke.length) {
          strokes.push([...currentStroke]);
        }
        currentStroke = [];

        targetCanvas?.releasePointerCapture?.(event.pointerId);
      }

      function clear() {
        strokes = [];
        currentStroke = [];
        hasInk = false;
        const targetCanvas = getCanvas();
        const targetCtx = getContext();
        if (!targetCanvas || !targetCtx) return;
        const rect = targetCanvas.getBoundingClientRect();
        targetCtx.clearRect(0, 0, rect.width, rect.height);
      }

      function exportTrimmedBlob() {
        const targetCanvas = getCanvas();
        if (!targetCanvas || !hasInk) {
          return Promise.resolve(null);
        }

        const sourceCtx = targetCanvas.getContext('2d');
        const imageData = sourceCtx.getImageData(0, 0, targetCanvas.width, targetCanvas.height);
        const { data, width, height } = imageData;

        let top = height;
        let left = width;
        let right = 0;
        let bottom = 0;

        for (let y = 0; y < height; y += 1) {
          for (let x = 0; x < width; x += 1) {
            const alpha = data[(y * width + x) * 4 + 3];
            if (alpha > 0) {
              if (x < left) left = x;
              if (x > right) right = x;
              if (y < top) top = y;
              if (y > bottom) bottom = y;
            }
          }
        }

        if (right <= left || bottom <= top) {
          return Promise.resolve(null);
        }

        const padding = Math.ceil((window.devicePixelRatio || 1) * 12);
        const cropLeft = Math.max(0, left - padding);
        const cropTop = Math.max(0, top - padding);
        const cropRight = Math.min(width, right + padding);
        const cropBottom = Math.min(height, bottom + padding);
        const cropWidth = cropRight - cropLeft;
        const cropHeight = cropBottom - cropTop;

        const exportCanvas = document.createElement('canvas');
        exportCanvas.width = cropWidth;
        exportCanvas.height = cropHeight;
        exportCanvas
          .getContext('2d')
          .putImageData(sourceCtx.getImageData(cropLeft, cropTop, cropWidth, cropHeight), 0, 0);

        return new Promise((resolve) => {
          exportCanvas.toBlob((blob) => resolve(blob), 'image/png');
        });
      }

      function init() {
        if (initialized) return;
        const targetCanvas = getCanvas();
        if (!targetCanvas) return;

        setCanvasSize();
        targetCanvas.addEventListener('pointerdown', beginStroke);
        targetCanvas.addEventListener('pointermove', extendStroke);
        targetCanvas.addEventListener('pointerup', endStroke);
        targetCanvas.addEventListener('pointerleave', endStroke);
        targetCanvas.addEventListener('pointercancel', endStroke);

        window.addEventListener('resize', () => {
          if (resizeRaf) {
            cancelAnimationFrame(resizeRaf);
          }
          resizeRaf = requestAnimationFrame(redraw);
        });

        initialized = true;
      }

      return {
        init,
        clear,
        hasInk: () => hasInk,
        exportTrimmedBlob,
      };
    }

    const reportSignaturePad = createSignaturePad('signatureCanvas');
    
    // Populate signature class checkboxes with only unassigned classes
    function populateSignatureCheckboxes(excludeClasses = []) {
      const signatureClassCheckboxes = document.getElementById('signatureClassCheckboxes');
      const enrolledClassesForSig = <%- JSON.stringify(enrolledClasses) %>;
      const assignedClassIds = <%- JSON.stringify(Object.values(signatureGroups || {}).flatMap(sig => sig.classes.map(c => c.class_id))) %>;
      
      const availableClasses = enrolledClassesForSig.filter(cls => 
        !assignedClassIds.includes(cls.class_id) && !excludeClasses.includes(cls.class_id)
      );
      
      if(availableClasses.length === 0){
        signatureClassCheckboxes.innerHTML = '<p style="color:var(--muted);font-size:0.9rem;">All classes already have signatures. Select classes below to replace their signatures.</p>';
      } else {
        signatureClassCheckboxes.innerHTML = sortClassesByArrangement(availableClasses).map(cls => `
          <div style="display:flex;align-items:center;gap:8px;">
            <input type="checkbox" class="draw-signature-class" value="${cls.class_id}" id="sig-class-${cls.class_id}" />
            <label for="sig-class-${cls.class_id}" style="cursor:pointer;margin:0;">${cls.class_name}</label>
          </div>
        `).join('');
      }
      
      // Show already assigned classes
      if(assignedClassIds.length > 0){
        const assignedClasses = enrolledClassesForSig.filter(cls => assignedClassIds.includes(cls.class_id));
        if(assignedClasses.length > 0 && availableClasses.length > 0){
          signatureClassCheckboxes.innerHTML += '<div style="margin-top:12px;padding-top:12px;border-top:1px solid var(--border);"><p style="color:var(--muted);font-size:0.85rem;margin-bottom:8px;">Already assigned (will replace):</p>' + 
            sortClassesByArrangement(assignedClasses).map(cls => `
              <div style="display:flex;align-items:center;gap:8px;">
                <input type="checkbox" class="draw-signature-class" value="${cls.class_id}" id="sig-class-assigned-${cls.class_id}" />
                <label for="sig-class-assigned-${cls.class_id}" style="cursor:pointer;margin:0;color:var(--muted);">${cls.class_name}</label>
              </div>
            `).join('') + '</div>';
        } else if(availableClasses.length === 0){
          signatureClassCheckboxes.innerHTML += sortClassesByArrangement(assignedClasses).map(cls => `
            <div style="display:flex;align-items:center;gap:8px;">
              <input type="checkbox" class="draw-signature-class" value="${cls.class_id}" id="sig-class-${cls.class_id}" />
              <label for="sig-class-${cls.class_id}" style="cursor:pointer;margin:0;">${cls.class_name}</label>
            </div>
          `).join('');
        }
      }
      return true;
    }
    
    // Toggle signature form
    toggleSigFormLink?.addEventListener('click', () => {
      const isVisible = signatureFormContainer.style.display !== 'none';
      if(isVisible){
        signatureFormContainer.style.display = 'none';
        toggleSigFormLink.textContent = '+ Show Form';
      } else {
        populateSignatureCheckboxes();
        signatureFormContainer.style.display = 'block';
        toggleSigFormLink.textContent = '− Hide Form';
        reportSignaturePad.init();
      }
    });
    
    // Add classes to existing signature
    document.querySelectorAll('.add-classes-link').forEach(link => {
      link.addEventListener('click', async () => {
        const signaturePath = link.dataset.signaturePath;
        const enrolledClassesForSig = <%- JSON.stringify(enrolledClasses) %>;
        const assignedClassIds = <%- JSON.stringify(Object.values(signatureGroups || {}).flatMap(sig => sig.classes.map(c => c.class_id))) %>;
        const availableClasses = enrolledClassesForSig.filter(cls => !assignedClassIds.includes(cls.class_id));
        
        if(availableClasses.length === 0){
          alert('All classes already have signatures assigned.');
          return;
        }
        
        const classOptions = sortClassesByArrangement(availableClasses)
          .map(cls => `<label style="display:block;padding:6px;"><input type="checkbox" value="${cls.class_id}" style="margin-right:8px;">${cls.class_name}</label>`)
          .join('');
        
        const modal = document.createElement('div');
        modal.style.cssText = 'position:fixed;inset:0;background:rgba(0,0,0,0.5);display:flex;align-items:center;justify-content:center;z-index:10000;';
        modal.innerHTML = `
          <div style="background:#fff;border-radius:12px;padding:20px;max-width:400px;width:90%;box-shadow:0 20px 50px rgba(0,0,0,0.3);">
            <h3 style="margin:0 0 16px;color:var(--primary);">Add Classes to Signature</h3>
            <div id="classCheckboxList" style="max-height:300px;overflow-y:auto;margin-bottom:16px;">${classOptions}</div>
            <div style="display:flex;gap:10px;justify-content:flex-end;">
              <button class="btn btn-danger" id="modalCancel">Cancel</button>
              <button class="btn" id="modalSave">Add Selected Classes</button>
            </div>
          </div>
        `;
        document.body.appendChild(modal);
        
        modal.querySelector('#modalCancel').addEventListener('click', () => modal.remove());
        modal.querySelector('#modalSave').addEventListener('click', async () => {
          const selectedClasses = Array.from(modal.querySelectorAll('#classCheckboxList input:checked')).map(cb => cb.value);
          if(!selectedClasses.length){
            alert('Please select at least one class.');
            return;
          }
          
          try {
            const response = await fetch('/print/addClassesToSignature', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({
                signaturePath,
                termId: '<%= termId %>',
                selectedClasses
              })
            });
            
            const result = await response.json();
            if(result.success){
              modal.remove();
              window.location.reload();
            } else {
              alert(result.message || 'Failed to add classes.');
            }
          } catch(error){
            console.error('Error adding classes:', error);
            alert('An error occurred.');
          }
        });
      });
    });
    
    function clearCanvas(){ reportSignaturePad.clear(); }
    window.clearCanvas = clearCanvas;

    async function saveDigitalSignature(){
      const statusEl = document.getElementById('sigStatus');
      statusEl.textContent = 'Saving signature...';
      reportSignaturePad.init();
      const classChecks = Array.from(document.querySelectorAll('.draw-signature-class:checked')).map(c => c.value);
      const signerTitle = document.getElementById('signatureTitleInput')?.value.trim() || '';
      const signerName = document.getElementById('signatureNameInput')?.value.trim() || '';
      if(!classChecks.length){ statusEl.textContent = 'Select at least one class to apply.'; return; }
      if(!reportSignaturePad.hasInk()){ statusEl.textContent = 'Draw the signature first.'; return; }
      const blob = await reportSignaturePad.exportTrimmedBlob();
        if(!blob){ statusEl.textContent = 'Could not capture signature.'; return; }
        const fd = new FormData();
        fd.append('signatureImage', blob, 'signature.png');
        fd.append('termId', '<%= termId %>');
        fd.append('classId', '<%= classId %>');
        fd.append('signatureTitle', signerTitle);
        fd.append('signatureName', signerName);
        classChecks.forEach(c => fd.append('selectedSignatureClasses', c));
        try {
          const res = await fetch('/print/uploadSignatureImage', { method:'POST', body: fd });
          if(!res.ok) throw new Error('Upload failed');
          statusEl.textContent = 'Saved. Refreshing...';
          window.location.reload();
        } catch(err){ statusEl.textContent = err.message; }
    }
    window.saveDigitalSignature = saveDigitalSignature;

    <% if (hasTranscriptFeature) { %>
    // Transcript Signature Management
    const transcriptSigFormContainer = document.getElementById('transcriptSignatureFormContainer');
    const toggleTranscriptSigFormLink = document.getElementById('toggleTranscriptSignatureForm');
    const transcriptSignaturePad = createSignaturePad('transcriptSignatureCanvas');

    function populateTranscriptSignatureCheckboxes() {
      const transcriptSigCheckboxes = document.getElementById('transcriptSignatureClassCheckboxes');
      const enrolledClassesForTranscript = <%- JSON.stringify(enrolledClasses) %>;
      const assignedTranscriptClassIds = <%- JSON.stringify(Object.values(transcriptSignatureGroups || {}).flatMap(sig => sig.classes.map(c => c.class_id))) %>;
      
      const availableClasses = enrolledClassesForTranscript.filter(cls => 
        !assignedTranscriptClassIds.includes(cls.class_id)
      );
      
      if(availableClasses.length === 0){
        transcriptSigCheckboxes.innerHTML = '<p style=\"color:var(--muted);font-size:0.9rem;\">All classes have transcript signatures. Select to replace.</p>';
      } else {
        transcriptSigCheckboxes.innerHTML = sortClassesByArrangement(availableClasses).map(cls => `
          <div style=\"display:flex;align-items:center;gap:8px;\">
            <input type=\"checkbox\" class=\"transcript-signature-class\" value=\"${cls.class_id}\" id=\"trans-sig-class-${cls.class_id}\" />
            <label for=\"trans-sig-class-${cls.class_id}\" style=\"cursor:pointer;margin:0;\">${cls.class_name}</label>
          </div>
        `).join('');
      }
      
      if(assignedTranscriptClassIds.length > 0){
        const assignedClasses = enrolledClassesForTranscript.filter(cls => assignedTranscriptClassIds.includes(cls.class_id));
        if(assignedClasses.length > 0 && availableClasses.length > 0){
          transcriptSigCheckboxes.innerHTML += '<div style=\"margin-top:12px;padding-top:12px;border-top:1px solid var(--border);\"><p style=\"color:var(--muted);font-size:0.85rem;margin-bottom:8px;\">Already assigned (will replace):</p>' + 
            sortClassesByArrangement(assignedClasses).map(cls => `
              <div style=\"display:flex;align-items:center;gap:8px;\">
                <input type=\"checkbox\" class=\"transcript-signature-class\" value=\"${cls.class_id}\" id=\"trans-sig-assigned-${cls.class_id}\" />
                <label for=\"trans-sig-assigned-${cls.class_id}\" style=\"cursor:pointer;margin:0;color:var(--muted);\">${cls.class_name}</label>
              </div>
            `).join('') + '</div>';
        } else if(availableClasses.length === 0){
          transcriptSigCheckboxes.innerHTML += sortClassesByArrangement(assignedClasses).map(cls => `
            <div style=\"display:flex;align-items:center;gap:8px;\">
