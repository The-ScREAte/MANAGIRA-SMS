            <span>Select fields for this total</span>
            <span class="paygira-field-toggle-arrow">▼</span>
          </div>
          <div class="paygira-total-fields" style="display:none;">${fieldOptionsHtml}</div>
        </div>`;
      }).join('');
      const paygiraHtml = `
        <div class="ds-adv-flat-lbl" style="display:flex;align-items:center;justify-content:space-between;gap:8px;flex-wrap:wrap;">
          <label style="display:flex;align-items:center;gap:6px;cursor:pointer;margin:0;flex:1;min-width:220px;">
