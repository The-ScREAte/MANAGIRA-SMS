            </label>
            <label class="ds-adv-sub-lbl" style="padding:0;">
              <input type="radio" name="ds-paygira-mode" value="manual" ${paygiraMode === 'manual' ? 'checked' : ''}>
              Manual fill
            </label>
          </div>

          <div id="ds-paygira-auto-box" style="display:${paygiraMode === 'auto' ? 'block' : 'none'};">
            <div class="paygira-adv-row">
              <span style="font-size:0.8rem;color:var(--muted);">Show:</span>
              <label class="ds-adv-sub-lbl" style="padding:0;">
                <input type="radio" name="ds-paygira-scope" value="past" ${paygiraScope === 'past' ? 'checked' : ''}>
                Past Bills
              </label>
              <label class="ds-adv-sub-lbl" style="padding:0;">
                <input type="radio" name="ds-paygira-scope" value="future" ${paygiraScope === 'future' ? 'checked' : ''}>
                Future Bills
              </label>
            </div>
            <div id="ds-paygira-past-box" style="display:${paygiraScope === 'past' ? 'block' : 'none'};">
              <div class="paygira-adv-row">
                <span style="font-size:0.8rem;color:var(--muted);">Date range:</span>
                <input type="date" id="ds-paygira-date-from" value="${dsEsc(paygiraAuto.dateFrom || '')}">
                <input type="date" id="ds-paygira-date-to" value="${dsEsc(paygiraAuto.dateTo || '')}">
              </div>
              <div style="display:grid;grid-template-columns:1fr 1fr;gap:6px;">
                ${paygiraAutoMetricsHtml}
              </div>
            </div>
            <div id="ds-paygira-future-box" style="display:${paygiraScope === 'future' ? 'block' : 'none'};">
              <div class="paygira-adv-row">
                <label class="ds-adv-sub-lbl" style="padding:0;">
                  <input type="radio" name="ds-paygira-future-action" value="create" ${paygiraFutureAction === 'create' ? 'checked' : ''}>
                  Create Bill Link
                </label>
                <label class="ds-adv-sub-lbl" style="padding:0;">
                  <input type="radio" name="ds-paygira-future-action" value="custom" ${paygiraFutureAction === 'custom' ? 'checked' : ''}>
                  Enter Bill Name
                </label>
              </div>
              <div class="paygira-adv-row" id="ds-paygira-future-name-wrap" style="display:${paygiraFutureAction === 'custom' ? 'flex' : 'none'};">
                <span style="font-size:0.8rem;color:var(--muted);">Bill name:</span>
                <input type="text" id="ds-paygira-future-bill-name" value="${paygiraFutureBillName}" placeholder="e.g. Next Term Tuition" style="min-width:220px;">
              </div>
            </div>
          </div>

          <div id="ds-paygira-manual-box" style="display:${paygiraMode === 'manual' ? 'block' : 'none'};">
            <div id="ds-paygira-manual-fields-wrap">${paygiraManualFieldsHtml}</div>
            <button type="button" id="ds-paygira-add-field" class="btn" style="padding:5px 10px;font-size:0.78rem;">+ Add Field</button>
            <div class="paygira-totals-wrap">
              <div style="display:flex;align-items:center;justify-content:space-between;gap:8px;flex-wrap:wrap;margin-bottom:6px;">
                <span class="paygira-preview-title" style="margin:0;">Totals</span>
                <button type="button" id="ds-paygira-add-total" class="btn" style="padding:5px 10px;font-size:0.78rem;">+ Add Total</button>
              </div>
              <div id="ds-paygira-manual-totals-wrap">${paygiraManualTotalsHtml}</div>
            </div>
            <div class="paygira-preview-box" id="ds-paygira-preview-box">
              <div class="paygira-field-toggle paygira-preview-toggle" id="ds-paygira-preview-toggle" role="button" tabindex="0" aria-expanded="false">
                <span class="paygira-preview-title" style="margin:0;">Preview on Report</span>
                <span class="paygira-field-toggle-arrow">▼</span>
              </div>
              <div id="ds-paygira-manual-preview-wrap" style="display:none;margin-top:8px;">
                <div id="ds-paygira-manual-preview"></div>
              </div>
            </div>
          </div>
        </div>`;

      // Activate Promotion — stored in status_settings, synced to the hidden form checkbox
      const statusData = (typeof statusSettingsMap !== 'undefined') ? statusSettingsMap[String(classId)] : null;
      const activationOn = statusData ? !!statusData.activate_promotion : false;
      const activatePromotionRow = `<label class="ds-adv-flat-lbl" style="border-color:#e2e8f0;background:#f0fdf4;">
          <input type="checkbox" id="ds-adv-activatePromotion" style="accent-color:#16a34a;" ${activationOn ? 'checked' : ''}>
          <span style="font-size:13px;line-height:1;">🚦</span> Activate Promotion
        </label>`;

      panel.dataset.classId = String(classId);
      panel.innerHTML = `
        <div class="ds-adv-grid">
          <div>
            <p class="ds-adv-section-label">Score Columns</p>
            ${buildMasterGroupHtml('classScore','Class Score',classItems,ds.columns.classScore,ds.columns.classScore_items)}
            ${buildMasterGroupHtml('examsScore','Exams Score',examsItems,ds.columns.examsScore,ds.columns.examsScore_items)}
            ${buildMasterGroupHtml('otherScore','Other Score',otherItems,ds.columns.otherScore,ds.columns.otherScore_items)}
            <div style="display:grid;grid-template-columns:1fr 1fr;gap:3px;margin-top:6px;">${flatColsHtml}</div>
            <div id="ds-adv-sections-left-wrap" style="display:none;margin-top:10px;padding-top:10px;border-top:1px solid #e2e8f0;">
              <p class="ds-adv-section-label" style="margin-bottom:6px;">Report Sections</p>
              <div id="ds-adv-sections-left-list" style="display:flex;flex-direction:column;gap:3px;"></div>
            </div>
          </div>
          <div>
            <p class="ds-adv-section-label">Report Sections</p>
            <div style="display:flex;flex-direction:column;gap:3px;">${activatePromotionRow}${attendanceManualRow}${paygiraHtml}<div id="ds-adv-sections-right-wrap"><div id="ds-adv-sections-right-list">${secHtml}${customRows}</div></div></div>
          </div>
        </div>
        <div style="margin-top:12px;display:flex;align-items:center;gap:10px;">
          <button type="button" id="advDsSaveBtn" class="btn" style="padding:7px 18px;font-size:0.85rem;">Save Advanced</button>
          <span id="advDsSaveMsg" style="font-size:12px;color:#16a34a;font-weight:600;display:none;animation:dsFadeIn 0.3s ease;">✓ Saved</span>
        </div>`;

      // Wire master toggles
      panel.querySelectorAll('.ds-adv-master').forEach(masterCb => {
        masterCb.addEventListener('change', function() {
          const group = this.closest('.ds-adv-group');
          if (!group) return;
          this.checked ? dsAdvMasterOn(group) : dsAdvMasterOff(group, true);
        });
      });

      // Sync "Activate Promotion" in Advanced to the hidden form checkbox
      const advActProm = document.getElementById('ds-adv-activatePromotion');
      const hiddenActProm = document.getElementById('activatePromotion');
      if (advActProm && hiddenActProm) {
        advActProm.addEventListener('change', function() { hiddenActProm.checked = this.checked; });
      }

      const turnOffAutoAttendanceCb = document.getElementById('ds-adv-turnOffAutoAttendance');
      const manualAttendanceOutOfInput = document.getElementById('ds-adv-manualAttendanceOutOf');
      if (turnOffAutoAttendanceCb && manualAttendanceOutOfInput) {
        const syncManualAttendanceOutOfState = () => {
          manualAttendanceOutOfInput.disabled = !turnOffAutoAttendanceCb.checked;
        };
        syncManualAttendanceOutOfState();
        turnOffAutoAttendanceCb.addEventListener('change', syncManualAttendanceOutOfState);
      }

      const paygiraEnabledCb = document.getElementById('ds-adv-paygira-enabled');
      const paygiraBox = document.getElementById('ds-adv-paygira-box');
      const paygiraAutoBox = document.getElementById('ds-paygira-auto-box');
      const paygiraPastBox = document.getElementById('ds-paygira-past-box');
      const paygiraFutureBox = document.getElementById('ds-paygira-future-box');
      const paygiraManualBox = document.getElementById('ds-paygira-manual-box');
      const paygiraModeRadios = panel.querySelectorAll('input[name="ds-paygira-mode"]');
      const paygiraScopeRadios = panel.querySelectorAll('input[name="ds-paygira-scope"]');
      const paygiraFutureActionRadios = panel.querySelectorAll('input[name="ds-paygira-future-action"]');
      const paygiraFutureNameWrap = document.getElementById('ds-paygira-future-name-wrap');
      const sectionsLeftWrap = document.getElementById('ds-adv-sections-left-wrap');
      const sectionsLeftList = document.getElementById('ds-adv-sections-left-list');
      const sectionsRightWrap = document.getElementById('ds-adv-sections-right-wrap');
      const sectionsRightList = document.getElementById('ds-adv-sections-right-list');
      const paygiraFieldsWrap = document.getElementById('ds-paygira-manual-fields-wrap');
      const paygiraAddFieldBtn = document.getElementById('ds-paygira-add-field');
      const paygiraTotalsWrap = document.getElementById('ds-paygira-manual-totals-wrap');
      const paygiraAddTotalBtn = document.getElementById('ds-paygira-add-total');
      const paygiraPreviewBox = document.getElementById('ds-paygira-preview-box');
      const paygiraPreviewToggle = document.getElementById('ds-paygira-preview-toggle');
      const paygiraPreviewWrap = document.getElementById('ds-paygira-manual-preview-wrap');
      const paygiraManualPreview = document.getElementById('ds-paygira-manual-preview');

      const setPaygiraPreviewExpanded = (expanded) => {
        if (paygiraPreviewBox) paygiraPreviewBox.classList.toggle('is-open', expanded);
        if (paygiraPreviewWrap) paygiraPreviewWrap.style.display = expanded ? 'block' : 'none';
        if (paygiraPreviewToggle) paygiraPreviewToggle.setAttribute('aria-expanded', expanded ? 'true' : 'false');
      };

      const togglePaygiraPreview = () => {
        const isOpen = !!(paygiraPreviewBox && paygiraPreviewBox.classList.contains('is-open'));
        setPaygiraPreviewExpanded(!isOpen);
      };

      paygiraPreviewToggle?.addEventListener('click', togglePaygiraPreview);
      paygiraPreviewToggle?.addEventListener('keydown', (event) => {
        if (event.key === 'Enter' || event.key === ' ') {
          event.preventDefault();
          togglePaygiraPreview();
        }
      });

      // Start collapsed; user opens when needed.
      setPaygiraPreviewExpanded(false);

      const getManualFieldRows = () => {
        return Array.from(panel.querySelectorAll('.ds-paygira-manual-field')).map((row, index) => {
          const label = row.querySelector('.ds-paygira-manual-label')?.value?.trim() || '';
          const defaultValueRaw = row.querySelector('.ds-paygira-manual-default')?.value?.trim() || '';
          if (!label) return null;
          const key = label.toLowerCase().replace(/[^a-z0-9]+/g, '_').replace(/^_+|_+$/g, '') || `field_${index + 1}`;
          return {
            key,
            label,
            value: defaultValueRaw,
          };
        }).filter(Boolean);
      };

      const readTotalSelectedKeys = (totalRow) => {
        return Array.from(totalRow.querySelectorAll('.ds-paygira-total-field:checked'))
          .map((cb) => String(cb.value || '').trim())
          .filter(Boolean);
      };

      const getSelectedKeysFromOtherTotals = (currentRow) => {
        const used = new Set();
        panel.querySelectorAll('.ds-paygira-manual-total').forEach((row) => {
          if (row === currentRow) return;
          readTotalSelectedKeys(row).forEach((key) => used.add(key));
        });
        return used;
      };

      function syncAllPaygiraManualTotalFieldOptions() {
        panel.querySelectorAll('.ds-paygira-manual-total').forEach((totalRow) => {
          syncPaygiraManualTotalFieldOptions(totalRow);
        });
      }

      function enforceUniquePaygiraTotalFieldSelections() {
        const seen = new Set();
        panel.querySelectorAll('.ds-paygira-manual-total').forEach((totalRow) => {
          totalRow.querySelectorAll('.ds-paygira-total-field').forEach((cb) => {
            const key = String(cb.value || '').trim();
            if (!key || !cb.checked) return;
            if (seen.has(key)) {
              cb.checked = false;
            } else {
              seen.add(key);
            }
          });
        });
      }

      function handlePaygiraTotalFieldChange(totalRow, changedCheckbox) {
        if (!changedCheckbox) return;
        const key = String(changedCheckbox.value || '').trim();
        if (!key) return;

        if (changedCheckbox.checked) {
          panel.querySelectorAll('.ds-paygira-manual-total').forEach((row) => {
            if (row === totalRow) return;
            row.querySelectorAll('.ds-paygira-total-field').forEach((cb) => {
              if (String(cb.value || '').trim() === key) cb.checked = false;
            });
          });
        }

        syncAllPaygiraManualTotalFieldOptions();
        renderPaygiraManualPreview();
      }

      function syncPaygiraManualTotalFieldOptions(totalRow) {
        if (!totalRow) return;
        const fieldsWrap = totalRow.querySelector('.paygira-total-fields');
        if (!fieldsWrap) return;

        const selectedSet = new Set(readTotalSelectedKeys(totalRow));
        const selectedElsewhere = getSelectedKeysFromOtherTotals(totalRow);
        const rows = getManualFieldRows();
        if (!rows.length) {
          fieldsWrap.innerHTML = '<div style="font-size:11px;color:var(--muted);">Add manual fields first to build totals.</div>';
          return;
        }

        fieldsWrap.innerHTML = rows.map((entry) => `
          <label class="paygira-total-field ${(selectedElsewhere.has(entry.key) && !selectedSet.has(entry.key)) ? 'is-disabled' : ''}">
            <input type="checkbox" class="ds-paygira-total-field" value="${dsEsc(entry.key)}" style="accent-color:var(--primary);" ${selectedSet.has(entry.key) ? 'checked' : ''} ${(selectedElsewhere.has(entry.key) && !selectedSet.has(entry.key)) ? 'disabled' : ''}>
            ${dsEsc(entry.label)}
          </label>
        `).join('');

        fieldsWrap.querySelectorAll('.ds-paygira-total-field').forEach((cb) => {
          cb.addEventListener('change', () => handlePaygiraTotalFieldChange(totalRow, cb));
        });
      }

      function renderPaygiraManualPreview() {
        if (!paygiraManualPreview) return;
        const rows = getManualFieldRows();
        const valueByKey = Object.fromEntries(
          rows.map((entry) => {
            const n = Number.parseFloat(String(entry.value || '').replace(/,/g, ''));
            return [entry.key, Number.isFinite(n) ? n : null];
          })
        );
        const labelByKey = Object.fromEntries(rows.map((entry) => [entry.key, entry.label]));

        const totals = Array.from(panel.querySelectorAll('.ds-paygira-manual-total')).map((totalRow, index) => {
          const label = totalRow.querySelector('.ds-paygira-total-label')?.value?.trim() || '';
          if (!label) return null;
          const showOnReport = !!totalRow.querySelector('.ds-paygira-total-show')?.checked;
          const fieldKeys = readTotalSelectedKeys(totalRow);
          const parts = fieldKeys
            .map((fieldKey) => {
              const v = valueByKey[fieldKey];
              return {
                key: fieldKey,
                label: labelByKey[fieldKey] || fieldKey,
                value: v,
              };
            });
          const numericParts = parts.filter((part) => Number.isFinite(part.value));
          const sum = numericParts.reduce((acc, part) => acc + Number(part.value || 0), 0);
          return {
            key: label.toLowerCase().replace(/[^a-z0-9]+/g, '_').replace(/^_+|_+$/g, '') || `total_${index + 1}`,
            label,
            showOnReport,
            fieldKeys,
            sum,
            breakdown: parts,
          };
        }).filter(Boolean);

        const noRowsHtml = !rows.length
          ? '<div style="font-size:11px;color:var(--muted);margin-bottom:8px;">No manual fields configured yet.</div>'
          : '';

        const fieldsTableHtml = rows.length
          ? `
          <table class="paygira-preview-table" style="margin-bottom:8px;">
            <thead>
              <tr>
                <th>Item</th>
                <th>Value (all students)</th>
              </tr>
            </thead>
            <tbody>
              ${rows.map((entry) => `
                <tr>
                  <td>${dsEsc(entry.label)}</td>
                  <td>${dsEsc(String(entry.value === '' ? '-' : entry.value))}</td>
                </tr>
              `).join('')}
            </tbody>
          </table>
          `
          : '';

        const totalsRowsHtml = totals.map((total) => {
          const display = Number.isInteger(total.sum) ? String(total.sum) : total.sum.toFixed(2);
          const breakdown = total.breakdown.length
            ? total.breakdown.map((part) => `${part.label}: ${Number.isFinite(part.value) ? part.value : '-'}`).join(' + ')
            : 'No fields selected';
          return `
            <tr>
              <td>
                <div class="paygira-total-preview">${dsEsc(total.label)}${total.showOnReport ? '' : ' (hidden on report)'}</div>
                <div class="paygira-total-preview-note">${dsEsc(breakdown)}</div>
              </td>
              <td>${dsEsc(display)}</td>
            </tr>
          `;
        }).join('');

        const totalsTableHtml = totals.length
          ? `
            <table class="paygira-preview-table">
              <thead>
                <tr>
                  <th>Total</th>
                  <th>Value</th>
                </tr>
              </thead>
              <tbody>${totalsRowsHtml}</tbody>
            </table>
          `
          : '<div style="font-size:11px;color:var(--muted);">No totals configured yet.</div>';

        paygiraManualPreview.innerHTML = `${noRowsHtml}${fieldsTableHtml}${totalsTableHtml}`;
      }

      function wirePaygiraManualFieldRow(row) {
        if (!row) return;
        const applyWrap = row.querySelector('.paygira-field-apply');
        const toggle = row.querySelector('.paygira-field-toggle');

        const setExpanded = (expanded) => {
          row.classList.toggle('is-open', expanded);
          if (applyWrap) applyWrap.style.display = expanded ? 'block' : 'none';
          if (toggle) toggle.setAttribute('aria-expanded', expanded ? 'true' : 'false');
        };

        const toggleExpanded = () => {
          const isOpen = row.classList.contains('is-open');
          setExpanded(!isOpen);
        };

        toggle?.addEventListener('click', toggleExpanded);
        toggle?.addEventListener('keydown', (event) => {
          if (event.key === 'Enter' || event.key === ' ') {
            event.preventDefault();
            toggleExpanded();
          }
        });

        // Start collapsed; user can expand when needed.
        setExpanded(false);

        const allClassesToggle = row.querySelector('.ds-paygira-apply-all');
        const classCheckboxes = Array.from(row.querySelectorAll('.ds-paygira-apply-class')).filter((cb) => !cb.disabled);
        const syncAllClassesToggle = () => {
          if (!allClassesToggle) return;
          allClassesToggle.checked = classCheckboxes.length > 0 && classCheckboxes.every((cb) => cb.checked);
        };
        allClassesToggle?.addEventListener('change', () => {
          classCheckboxes.forEach((cb) => {
            cb.checked = allClassesToggle.checked;
          });
        });
        classCheckboxes.forEach((cb) => {
          cb.addEventListener('change', syncAllClassesToggle);
        });
        syncAllClassesToggle();

        row.querySelector('.ds-paygira-remove-field')?.addEventListener('click', () => {
          const fieldName = row.querySelector('.ds-paygira-manual-label')?.value?.trim() || 'this field';
          if (!confirmDestructiveAction(`Remove ${fieldName}?`)) {
            return;
          }
          row.remove();
          syncAllPaygiraManualTotalFieldOptions();
          renderPaygiraManualPreview();
        });
        row.querySelector('.ds-paygira-manual-label')?.addEventListener('input', () => {
          row.querySelector('.ds-paygira-manual-label')?.classList.remove('input-required-error');
          syncAllPaygiraManualTotalFieldOptions();
          renderPaygiraManualPreview();
        });
        row.querySelector('.ds-paygira-manual-default')?.addEventListener('input', renderPaygiraManualPreview);
        renderPaygiraManualPreview();
      }

      function wirePaygiraManualTotalRow(totalRow) {
        if (!totalRow) return;
        const fieldsWrap = totalRow.querySelector('.paygira-total-fields');
        const toggle = totalRow.querySelector('.paygira-total-toggle');

        const setExpanded = (expanded) => {
          totalRow.classList.toggle('is-open', expanded);
          if (fieldsWrap) fieldsWrap.style.display = expanded ? 'grid' : 'none';
          if (toggle) toggle.setAttribute('aria-expanded', expanded ? 'true' : 'false');
        };

        const toggleExpanded = () => {
          const isOpen = totalRow.classList.contains('is-open');
          setExpanded(!isOpen);
        };

        toggle?.addEventListener('click', toggleExpanded);
        toggle?.addEventListener('keydown', (event) => {
          if (event.key === 'Enter' || event.key === ' ') {
            event.preventDefault();
            toggleExpanded();
          }
        });

        // Start collapsed; user can expand when needed.
        setExpanded(false);

        totalRow.querySelector('.ds-paygira-remove-total')?.addEventListener('click', () => {
          const totalName = totalRow.querySelector('.ds-paygira-total-label')?.value?.trim() || 'this total';
          if (!confirmDestructiveAction(`Remove ${totalName}?`)) {
            return;
          }
          totalRow.remove();
          syncAllPaygiraManualTotalFieldOptions();
          renderPaygiraManualPreview();
        });
        totalRow.querySelector('.ds-paygira-total-label')?.addEventListener('input', () => {
          totalRow.querySelector('.ds-paygira-total-label')?.classList.remove('input-required-error');
          renderPaygiraManualPreview();
        });
        totalRow.querySelector('.ds-paygira-total-show')?.addEventListener('change', renderPaygiraManualPreview);
        totalRow.querySelectorAll('.ds-paygira-total-field').forEach((cb) => {
          cb.addEventListener('change', () => handlePaygiraTotalFieldChange(totalRow, cb));
        });
        syncPaygiraManualTotalFieldOptions(totalRow);
        renderPaygiraManualPreview();
      }

      function renderPaygiraMode() {
        const selectedMode = Array.from(paygiraModeRadios).find((r) => r.checked)?.value || 'auto';
        if (paygiraAutoBox) paygiraAutoBox.style.display = selectedMode === 'auto' ? 'block' : 'none';
        if (paygiraManualBox) paygiraManualBox.style.display = selectedMode === 'manual' ? 'block' : 'none';
      }

      function renderPaygiraScope() {
        const selectedScope = Array.from(paygiraScopeRadios).find((r) => r.checked)?.value || 'past';
        if (paygiraPastBox) paygiraPastBox.style.display = selectedScope === 'past' ? 'block' : 'none';
        if (paygiraFutureBox) paygiraFutureBox.style.display = selectedScope === 'future' ? 'block' : 'none';
      }

      function renderPaygiraFutureAction() {
        const selectedAction = Array.from(paygiraFutureActionRadios).find((r) => r.checked)?.value || 'create';
        if (paygiraFutureNameWrap) paygiraFutureNameWrap.style.display = selectedAction === 'custom' ? 'flex' : 'none';
      }

      function addPaygiraManualFieldRow(label = '', defaultValue = '', applyToClasses = []) {
        if (!paygiraFieldsWrap) return;
        const rowId = `new-${Date.now()}-${Math.floor(Math.random() * 10000)}`;
        const currentClassIdValue = parseInt(classIdField.value, 10);
        const selectedApplyClasses = Array.isArray(applyToClasses) && applyToClasses.length
          ? applyToClasses
          : [currentClassIdValue];
        const row = document.createElement('div');
        row.className = 'paygira-field-card ds-paygira-manual-field';
        row.innerHTML = `
          <div class="paygira-field-row">
            <input type="text" class="ds-paygira-manual-label" placeholder="Column name" value="${dsEsc(label)}">
            <input type="text" class="ds-paygira-manual-default" placeholder="Value for all students (text or number)" value="${dsEsc(defaultValue)}">
            <button type="button" class="btn btn-danger ds-paygira-remove-field" style="padding:4px 8px;font-size:0.75rem;">Remove</button>
          </div>
          <div class="paygira-field-toggle" role="button" tabindex="0" aria-expanded="false">
            <span>Apply to other classes</span>
            <span class="paygira-field-toggle-arrow">▼</span>
          </div>
          <div class="paygira-field-apply" style="display:none;">
            <div class="paygira-field-apply-title">Apply to other classes</div>
            <div class="paygira-apply-classes-grid">${buildPaygiraApplyClassesHtml(rowId, selectedApplyClasses, classIdField.value)}</div>
          </div>
        `;
        wirePaygiraManualFieldRow(row);
        paygiraFieldsWrap.appendChild(row);
        syncAllPaygiraManualTotalFieldOptions();
      }

      function addPaygiraManualTotalRow(label = '', showOnReport = true, fieldKeys = []) {
        if (!paygiraTotalsWrap) return;
        const totalRow = document.createElement('div');
        totalRow.className = 'paygira-total-card ds-paygira-manual-total';
        totalRow.innerHTML = `
          <div class="paygira-total-row">
            <input type="text" class="ds-paygira-total-label" placeholder="Total name" value="${dsEsc(label)}">
            <label style="display:inline-flex;align-items:center;gap:5px;font-size:11px;color:#334155;white-space:nowrap;">
              <input type="checkbox" class="ds-paygira-total-show" style="accent-color:var(--primary);" ${showOnReport ? 'checked' : ''}>
              Show on report
            </label>
            <button type="button" class="btn btn-danger ds-paygira-remove-total" style="padding:4px 8px;font-size:0.75rem;">Remove</button>
          </div>
          <div class="paygira-total-toggle" role="button" tabindex="0" aria-expanded="false">
            <span>Select fields for this total</span>
            <span class="paygira-field-toggle-arrow">▼</span>
          </div>
          <div class="paygira-total-fields" style="display:none;"></div>
        `;
        paygiraTotalsWrap.appendChild(totalRow);
        wirePaygiraManualTotalRow(totalRow);
        const selected = new Set((Array.isArray(fieldKeys) ? fieldKeys : []).map((key) => String(key || '').trim()).filter(Boolean));
        totalRow.querySelectorAll('.ds-paygira-total-field').forEach((cb) => {
          cb.checked = selected.has(String(cb.value || '').trim());
        });
        enforceUniquePaygiraTotalFieldSelections();
        syncAllPaygiraManualTotalFieldOptions();
        renderPaygiraManualPreview();
      }

      function moveAllChildNodes(fromNode, toNode) {
        if (!fromNode || !toNode) return;
        while (fromNode.firstChild) {
          toNode.appendChild(fromNode.firstChild);
        }
      }

      function syncReportSectionsPlacement() {
        const billingEnabled = paygiraEnabledCb?.checked === true;
        if (billingEnabled) {
          moveAllChildNodes(sectionsRightList, sectionsLeftList);
          if (sectionsLeftWrap) sectionsLeftWrap.style.display = 'block';
          if (sectionsRightWrap) sectionsRightWrap.style.display = 'none';
        } else {
          moveAllChildNodes(sectionsLeftList, sectionsRightList);
          if (sectionsLeftWrap) sectionsLeftWrap.style.display = 'none';
          if (sectionsRightWrap) sectionsRightWrap.style.display = 'block';
        }
      }

      if (paygiraEnabledCb && paygiraBox) {
        const syncPaygiraEnabledState = () => {
          paygiraBox.style.display = paygiraEnabledCb.checked ? 'block' : 'none';
          syncReportSectionsPlacement();
        };
        syncPaygiraEnabledState();
        paygiraEnabledCb.addEventListener('change', syncPaygiraEnabledState);
      } else {
        syncReportSectionsPlacement();
      }
      paygiraModeRadios.forEach((radio) => radio.addEventListener('change', renderPaygiraMode));
      paygiraScopeRadios.forEach((radio) => radio.addEventListener('change', renderPaygiraScope));
      paygiraFutureActionRadios.forEach((radio) => radio.addEventListener('change', renderPaygiraFutureAction));
      renderPaygiraMode();
      renderPaygiraScope();
      renderPaygiraFutureAction();
      paygiraFieldsWrap?.querySelectorAll('.ds-paygira-manual-field').forEach((row) => {
        wirePaygiraManualFieldRow(row);
      });
      paygiraTotalsWrap?.querySelectorAll('.ds-paygira-manual-total').forEach((totalRow) => {
        wirePaygiraManualTotalRow(totalRow);
      });
      enforceUniquePaygiraTotalFieldSelections();
      syncAllPaygiraManualTotalFieldOptions();
      paygiraAddFieldBtn?.addEventListener('click', () => addPaygiraManualFieldRow('', ''));
      paygiraAddTotalBtn?.addEventListener('click', () => addPaygiraManualTotalRow('', true, []));
      renderPaygiraManualPreview();

      // Wire save button
      document.getElementById('advDsSaveBtn')?.addEventListener('click', async () => {
        const panelEl = document.getElementById('advancedDsPanel');
        const ok = await saveAdvancedDisplaySettings(classIdField.value);
        if (ok) {
          // Sync in-memory statusSettingsMap so renderAdvancedDs reads correct state on next switch
          const advAP = document.getElementById('ds-adv-activatePromotion');
          if (advAP && statusSettingsMap[String(classIdField.value)]) {
            statusSettingsMap[String(classIdField.value)].activate_promotion = advAP.checked;
          }
          const msg = document.getElementById('advDsSaveMsg');
          msg.style.display = 'inline';
          setTimeout(() => msg.style.display = 'none', 2500);
        } else {
          if (panelEl?.dataset?.saveValidationError !== '1') {
            alert('Failed to save display settings.');
          }
        }
      });
    }

    function dsAdvToggleSub(group) {
      const sub = group.querySelector('.ds-adv-sub');
      const row = group.querySelector('.ds-adv-masterrow');
      const arrow = row?.querySelector('.ds-arrow');
      if (!sub) return;
      const isOpen = sub.style.display !== 'none';
      sub.style.display = isOpen ? 'none' : 'block';
      if (arrow) arrow.style.transform = isOpen ? '' : 'rotate(180deg)';
      if (row) row.style.borderRadius = isOpen ? '7px' : '7px 7px 0 0';
    }
    window.dsAdvToggleSub = dsAdvToggleSub;

    function dsAdvMasterOff(group, saveState) {
      const sub = group.querySelector('.ds-adv-sub');
      if (!sub) return;
      if (saveState) {
        const snap = {};
        sub.querySelectorAll('.ds-adv-item').forEach(cb => { snap[cb.dataset.id] = cb.checked; });
        sub.dataset.savedState = JSON.stringify(snap);
      }
      // Force open
      if (sub.style.display === 'none') {
        const row = group.querySelector('.ds-adv-masterrow');
        sub.style.display = 'block';
        if (row) { row.style.borderRadius = '7px 7px 0 0'; const a = row.querySelector('.ds-arrow'); if (a) a.style.transform = 'rotate(180deg)'; }
      }
      // Disable items
      sub.querySelectorAll('.ds-adv-item').forEach(cb => {
        cb.checked = false; cb.disabled = true;
        const lbl = cb.closest('label'); if (lbl) { lbl.style.opacity = '0.42'; lbl.style.pointerEvents = 'none'; }
      });
      // Banner
      let banner = sub.querySelector('.ds-master-off-banner');
      if (!banner) {
        banner = document.createElement('div'); banner.className = 'ds-master-off-banner';
        banner.style.cssText = 'display:flex;align-items:center;gap:5px;margin-bottom:5px;padding:4px 8px;font-size:11px;color:#b91c1c;font-weight:600;background:#fef2f2;border:1px solid #fecaca;border-radius:6px;';
        banner.innerHTML = _dsXIcon + ' Column disabled — all excluded';
        sub.insertBefore(banner, sub.firstChild);
      } else { banner.style.display = 'flex'; }
    }

    function dsAdvMasterOn(group) {
      const sub = group.querySelector('.ds-adv-sub');
      if (!sub) return;
      let snap = {}; try { snap = JSON.parse(sub.dataset.savedState || '{}'); } catch(e) {}
      sub.querySelectorAll('.ds-adv-item').forEach(cb => {
        cb.checked = snap.hasOwnProperty(cb.dataset.id) ? snap[cb.dataset.id] : true;
        cb.disabled = false;
        const lbl = cb.closest('label'); if (lbl) { lbl.style.opacity = ''; lbl.style.pointerEvents = ''; }
      });
      const banner = sub.querySelector('.ds-master-off-banner'); if (banner) banner.style.display = 'none';
    }

    async function saveAdvancedDisplaySettings(classId, options = {}) {
      const panel = document.getElementById('advancedDsPanel');
      if (!panel) return false;
      const skipManualPaygiraValidation = options.skipManualPaygiraValidation === true;
      const gradePresentationOverride = options.gradePresentationOverride && typeof options.gradePresentationOverride === 'object'
        ? normalizeGradePresentationState(options.gradePresentationOverride)
        : null;
      panel.dataset.saveValidationError = '0';
      // Guard: only save if panel is showing data for the requested class
      if (panel.dataset.classId && panel.dataset.classId !== String(classId)) {
        console.warn('[DS] saveAdvancedDisplaySettings: panel classId mismatch, skipping', {
          panelClassId: panel.dataset.classId,
          requestedClassId: String(classId),
          termId: '<%= termId %>',
        });
        return false;
      }
      const columns = {};
      panel.querySelectorAll('.ds-adv-master').forEach(cb => { columns[cb.dataset.cat] = cb.checked; });
      ['classScore','examsScore','otherScore'].forEach(cat => {
        const items = {};
        panel.querySelectorAll(`.ds-adv-item[data-cat="${cat}"]`).forEach(cb => { items[cb.dataset.id] = cb.checked; });
        columns[cat + '_items'] = items;
      });
      panel.querySelectorAll('.ds-adv-col').forEach(cb => { columns[cb.dataset.key] = cb.checked; });
      const sections = {};
      panel.querySelectorAll('.ds-adv-sec').forEach(cb => { sections[cb.dataset.key] = cb.checked; });
      const customRemarksVisibility = {};
      panel.querySelectorAll('.ds-adv-sec-custom').forEach((cb) => {
        const typeKey = String(cb.dataset.typeKey || '').trim();
        if (!typeKey) return;
        customRemarksVisibility[typeKey] = cb.checked;
      });
      sections.customRemarksVisibility = customRemarksVisibility;
      sections.gradePresentation = gradePresentationOverride || getGradePresentationPayloadFromControls();
      logGradeNumericTotal('saveAdvanced:payload', {
        classId,
        termId: '<%= termId %>',
        gradePresentation: sections.gradePresentation,
        usedOverride: gradePresentationOverride !== null,
      });
      const turnOffAutoAttendanceCb = document.getElementById('ds-adv-turnOffAutoAttendance');
      sections.turnOffAutoAttendance = turnOffAutoAttendanceCb ? turnOffAutoAttendanceCb.checked : false;
      const manualAttendanceOutOfInput = document.getElementById('ds-adv-manualAttendanceOutOf');
      const manualAttendanceOutOfRaw = manualAttendanceOutOfInput ? manualAttendanceOutOfInput.value.trim() : '';
      const manualAttendanceOutOfParsed = parseInt(manualAttendanceOutOfRaw, 10);
      sections.manualAttendanceOutOf = manualAttendanceOutOfRaw !== '' && Number.isFinite(manualAttendanceOutOfParsed) && manualAttendanceOutOfParsed > 0
        ? manualAttendanceOutOfParsed
        : null;

      const paygiraEnabledCb = document.getElementById('ds-adv-paygira-enabled');
      const paygiraMode = panel.querySelector('input[name="ds-paygira-mode"]:checked')?.value === 'manual' ? 'manual' : 'auto';
      const paygiraScope = panel.querySelector('input[name="ds-paygira-scope"]:checked')?.value === 'future' ? 'future' : 'past';
      const paygiraFutureAction = panel.querySelector('input[name="ds-paygira-future-action"]:checked')?.value === 'custom' ? 'custom' : 'create';
      const paygiraFutureBillName = document.getElementById('ds-paygira-future-bill-name')?.value?.trim() || '';
      const paygiraAutoMetrics = {};
      panel.querySelectorAll('.ds-paygira-auto-metric').forEach((cb) => {
        paygiraAutoMetrics[cb.dataset.key] = cb.checked;
      });
      const paygiraDateFrom = document.getElementById('ds-paygira-date-from')?.value || '';
      const paygiraDateTo = document.getElementById('ds-paygira-date-to')?.value || '';

      // Validate manual Paygira required names before collecting payload.
      panel.querySelectorAll('.input-required-error').forEach((el) => el.classList.remove('input-required-error'));
      if (!skipManualPaygiraValidation && paygiraEnabledCb?.checked === true && paygiraMode === 'manual') {
        const invalidInputs = [];

        panel.querySelectorAll('.ds-paygira-manual-field').forEach((row) => {
          const labelInput = row.querySelector('.ds-paygira-manual-label');
          const labelValue = labelInput?.value?.trim() || '';
          if (!labelInput || labelValue) return;
          labelInput.classList.add('input-required-error');
          invalidInputs.push(labelInput);
        });

        panel.querySelectorAll('.ds-paygira-manual-total').forEach((row) => {
          const labelInput = row.querySelector('.ds-paygira-total-label');
          const labelValue = labelInput?.value?.trim() || '';
          if (!labelInput || labelValue) return;
          labelInput.classList.add('input-required-error');
          invalidInputs.push(labelInput);
        });

        if (invalidInputs.length > 0) {
          panel.dataset.saveValidationError = '1';
          alert('Add this: fill in all required names before saving (field name and total name).');
          const firstInvalid = invalidInputs[0];
          firstInvalid?.scrollIntoView({ behavior: 'smooth', block: 'center' });
          firstInvalid?.focus();
          return false;
        }
      }

      const paygiraManualFields = [];
      panel.querySelectorAll('.ds-paygira-manual-field').forEach((row, index) => {
        const label = row.querySelector('.ds-paygira-manual-label')?.value?.trim() || '';
        const defaultInputValue = row.querySelector('.ds-paygira-manual-default')?.value?.trim() || '';
        const defaultValue = defaultInputValue;
        if (!label) return;
        const key = label.toLowerCase().replace(/[^a-z0-9]+/g, '_').replace(/^_+|_+$/g, '') || `field_${index + 1}`;
        const applyToClasses = Array.from(row.querySelectorAll('.ds-paygira-apply-class:checked'))
          .map((cb) => parseInt(cb.value, 10))
          .filter((id) => Number.isFinite(id) && id > 0);
        const currentClassNum = parseInt(classId, 10);
        if (Number.isFinite(currentClassNum) && !applyToClasses.includes(currentClassNum)) {
          applyToClasses.unshift(currentClassNum);
        }
        paygiraManualFields.push({ key, label, defaultValue, applyToClasses });
      });
      const paygiraManualFieldKeySet = new Set(paygiraManualFields.map((field) => field.key));
      const paygiraManualTotals = [];
      panel.querySelectorAll('.ds-paygira-manual-total').forEach((row, index) => {
        const label = row.querySelector('.ds-paygira-total-label')?.value?.trim() || '';
        if (!label) return;
        const key = label.toLowerCase().replace(/[^a-z0-9]+/g, '_').replace(/^_+|_+$/g, '') || `total_${index + 1}`;
        const showOnReport = !!row.querySelector('.ds-paygira-total-show')?.checked;
        const fieldKeys = Array.from(row.querySelectorAll('.ds-paygira-total-field:checked'))
          .map((cb) => String(cb.value || '').trim())
          .filter((value) => value && paygiraManualFieldKeySet.has(value));
        paygiraManualTotals.push({ key, label, showOnReport, fieldKeys });
      });

      sections.paygiraBills = {
        enabled: paygiraEnabledCb ? paygiraEnabledCb.checked : false,
        mode: paygiraMode,
        auto: {
          scope: paygiraScope,
          dateFrom: paygiraDateFrom,
          dateTo: paygiraDateTo,
          future: {
            action: paygiraFutureAction,
            billName: paygiraFutureBillName,
          },
          metrics: {
            totalPaid: paygiraAutoMetrics.totalPaid !== false,
            defaultArrears: paygiraAutoMetrics.defaultArrears !== false,
            latePayments: paygiraAutoMetrics.latePayments !== false,
            totalBilled: paygiraAutoMetrics.totalBilled === true,
            totalOutstanding: paygiraAutoMetrics.totalOutstanding === true,
            lastPaymentDate: paygiraAutoMetrics.lastPaymentDate === true,
          },
        },
        manual: {
          fields: paygiraManualFields,
          totals: paygiraManualTotals,
        },
      };
      const advActProm = document.getElementById('ds-adv-activatePromotion');
      const activatePromValue = advActProm ? advActProm.checked : null;
      try {
        const apParam = activatePromValue !== null ? `&activatePromotion=${activatePromValue}` : '';
        const resp = await fetch(`/print/saveDisplaySettings?classId=${encodeURIComponent(classId)}&termId=<%= termId %>${apParam}`, {
          method: 'POST', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ columns, sections }),
        });
        const result = await resp.json();
        logGradeNumericTotal('saveAdvanced:response', {
          classId,
          ok: resp.ok,
          status: resp.status,
          result,
        });
        if (result.success) { allDisplaySettingsMap[String(classId)] = { columns, sections }; return true; }
        return false;
      } catch(e) {
        console.error('[DS] saveAdvancedDisplaySettings failed', {
          classId,
          termId: '<%= termId %>',
          error: e,
        });
        return false;
      }
    }

    function hasAdvancedDisplaySettingsChanges(classId) {
      const payload = allDisplaySettingsMap[String(classId)] || { columns: {}, sections: {} };
      const cols = payload.columns || {};
      const secs = payload.sections || {};

      const rowData = collectAdvancedPaygiraManualRows();
      const paygiraManualFields = rowData.fields;
      const paygiraManualTotals = computePaygiraManualTotalsFromRows(rowData.rows);
      const gradePresentation = getGradePresentationPayloadFromControls();

      const columns = {
        classScore: !!document.getElementById('ds-adv-classScore')?.checked,
        classScore_items: getItemsState('classScore_items'),
        examsScore: !!document.getElementById('ds-adv-examsScore')?.checked,
        examsScore_items: getItemsState('examsScore_items'),
        otherScore: !!document.getElementById('ds-adv-otherScore')?.checked,
        otherScore_items: getItemsState('otherScore_items'),
        totalScore: !!document.getElementById('ds-adv-totalScore')?.checked,
        scaledScore: !!document.getElementById('ds-adv-scaledScore')?.checked,
        totalPercentage: !!document.getElementById('ds-adv-totalPercentage')?.checked,
        grade: !!document.getElementById('ds-adv-grade')?.checked,
        position: !!document.getElementById('ds-adv-position')?.checked,
        remarksCol: !!document.getElementById('ds-adv-remarksCol')?.checked,
      };

      const turnOffAutoAttendanceOn = !!document.getElementById('ds-adv-turnOffAutoAttendance')?.checked;
      const manualAttendanceOutOfInput = document.getElementById('ds-adv-manualAttendanceOutOf');
      const manualAttendanceOutOfRaw = manualAttendanceOutOfInput ? manualAttendanceOutOfInput.value : '';
      const manualAttendanceOutOfNum = Number.parseInt(String(manualAttendanceOutOfRaw || '').trim(), 10);
      const manualAttendanceOutOf = turnOffAutoAttendanceOn && Number.isFinite(manualAttendanceOutOfNum) && manualAttendanceOutOfNum > 0
        ? manualAttendanceOutOfNum
        : null;

      const sections = {
        teacherRemarks: !!document.getElementById('ds-adv-teacherRemarks')?.checked,
        conductRemarks: !!document.getElementById('ds-adv-conductRemarks')?.checked,
        attitudeRemarks: !!document.getElementById('ds-adv-attitudeRemarks')?.checked,
        interestRemarks: !!document.getElementById('ds-adv-interestRemarks')?.checked,
        customRemarksVisibility: (() => {
          const visibility = {};
          document.querySelectorAll('.ds-adv-sec-custom').forEach((cb) => {
            const typeKey = String(cb.dataset.typeKey || '').trim();
            if (!typeKey) return;
            visibility[typeKey] = cb.checked;
          });
          return visibility;
        })(),
        gradeKey: !!document.getElementById('ds-adv-gradeKey')?.checked,
        gradePresentation,
        attendance: !!document.getElementById('ds-adv-attendance')?.checked,
        turnOffAutoAttendance: turnOffAutoAttendanceOn,
        manualAttendanceOutOf,
        promotion: !!document.getElementById('ds-adv-promotion')?.checked,
        paygiraBills: {
          enabled: !!document.getElementById('ds-adv-paygiraBills')?.checked,
          mode: document.querySelector('input[name="paygiraBillMode"]:checked')?.value === 'manual' ? 'manual' : 'auto',
          auto: {
            scope: document.querySelector('input[name="paygiraBillAutoScope"]:checked')?.value === 'future' ? 'future' : 'past',
            dateFrom: (document.getElementById('paygiraBillDateFrom')?.value || '').trim(),
            dateTo: (document.getElementById('paygiraBillDateTo')?.value || '').trim(),
            future: {
              action: document.querySelector('input[name="paygiraFutureBillAction"]:checked')?.value === 'custom' ? 'custom' : 'create',
              billName: (document.getElementById('paygiraFutureBillName')?.value || '').trim(),
            },
            metrics: {
              totalPaid: !!document.getElementById('paygiraMetricTotalPaid')?.checked,
              defaultArrears: !!document.getElementById('paygiraMetricDefaultArrears')?.checked,
              latePayments: !!document.getElementById('paygiraMetricLatePayments')?.checked,
              totalBilled: !!document.getElementById('paygiraMetricTotalBilled')?.checked,
              totalOutstanding: !!document.getElementById('paygiraMetricTotalOutstanding')?.checked,
              lastPaymentDate: !!document.getElementById('paygiraMetricLastPaymentDate')?.checked,
            },
          },
          manual: {
            fields: paygiraManualFields,
            totals: paygiraManualTotals,
          },
        },
      };

      const oldState = JSON.stringify({
        columns: cols,
        sections: {
          teacherRemarks: secs.teacherRemarks !== false,
          conductRemarks: secs.conductRemarks !== false,
          attitudeRemarks: secs.attitudeRemarks !== false,
          interestRemarks: secs.interestRemarks !== false,
          customRemarksVisibility: (() => {
            const visibility = {};
            const source = (secs && typeof secs.customRemarksVisibility === 'object') ? secs.customRemarksVisibility : {};
            customRemarkTypesState.forEach((customType) => {
              const typeKey = String(customType.type_key || '').trim();
              if (!typeKey) return;
              visibility[typeKey] = source[typeKey] !== false;
            });
            return visibility;
          })(),
          gradeKey: secs.gradeKey !== false,
          gradePresentation: normalizeGradePresentationState(secs.gradePresentation || {}),
          attendance: secs.attendance !== false,
          turnOffAutoAttendance: secs.turnOffAutoAttendance === true,
          manualAttendanceOutOf: Number.isFinite(Number(secs.manualAttendanceOutOf)) && Number(secs.manualAttendanceOutOf) > 0
            ? Number(secs.manualAttendanceOutOf)
            : null,
          promotion: secs.promotion !== false,
          paygiraBills: normalizePaygiraBillsState(secs.paygiraBills || {}),
        },
      });
      const newState = JSON.stringify({ columns, sections });
      return oldState !== newState;
    }

    let allowExplicitStatusSubmit = false;
    statusSettingsSaveBtn?.addEventListener('click', () => {
      allowExplicitStatusSubmit = true;
      window.setTimeout(() => {
        allowExplicitStatusSubmit = false;
      }, 0);
    });

    // Intercept status settings form: fast-submit dirty rows; optional advanced-only save when no row changes.
    statusSettingsForm?.addEventListener('submit', async function(e) {
      const submitter = e.submitter;
      const isSaveSubmit = submitter === statusSettingsSaveBtn || allowExplicitStatusSubmit;
      if (!isSaveSubmit) {
        e.preventDefault();
        return;
      }
      allowExplicitStatusSubmit = false;

      e.preventDefault();
      const submitBtn = this.querySelector('button[type="submit"]');
      const originalSubmitText = submitBtn ? submitBtn.textContent : '';

      const beginSubmitUi = () => {
        if (submitBtn) {
          submitBtn.disabled = true;
          submitBtn.textContent = 'Saving...';
        }
        showLoading();
      };

      const endSubmitUi = () => {
        hideLoading();
        if (submitBtn) {
          submitBtn.disabled = false;
          submitBtn.textContent = originalSubmitText;
        }
      };

      const allRows = Array.from(this.querySelectorAll('.status-row-item'));
      if (!allRows.length) {
        alert('No status rows available to save.');
        return;
      }

      const dirtyRows = getDirtyStatusRows();
      if (!dirtyRows.length) {
        const proceedWithoutRowChanges = window.confirm('No row changes detected. Save advanced settings only?');
        if (!proceedWithoutRowChanges) {
          return;
        }
        beginSubmitUi();
        const shouldSaveAdvancedOnly = hasAdvancedDisplaySettingsChanges(classIdField.value);
        const advancedOnlySaved = shouldSaveAdvancedOnly ? await saveAdvancedDisplaySettings(classIdField.value) : true;
        endSubmitUi();
        if (advancedOnlySaved) {
          showToast(shouldSaveAdvancedOnly
            ? 'No row changes detected. Advanced settings saved.'
            : 'No row changes detected. No advanced setting changes to save.');
        }
        return;
      }

      const rowCountLabel = dirtyRows.length === 1 ? 'row' : 'rows';
      const confirmed = window.confirm(`Save ${dirtyRows.length} edited ${rowCountLabel}? Unedited rows will remain unchanged.`);
      if (!confirmed) {
        return;
      }

      beginSubmitUi();
      showToast(`Saving ${dirtyRows.length} edited ${rowCountLabel}...`);

      try {
        const dirtyStates = dirtyRows.map((row) => getStatusRowState(row));
        const formData = new FormData(this);
        const response = await fetch(this.action, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'Accept': 'application/json',
          },
          body: JSON.stringify({
            classId: classIdField?.value || formData.get('classId') || '',
            termId: formData.get('termId') || '',
            activatePromotion: activatePromotion?.checked ? 'on' : '',
            termEndDate: formData.get('termEndDate') || '',
            statusRowClassId: dirtyStates.map((row) => row.classId),
            statusRowPromotedClass: dirtyStates.map((row) => row.promotedClass),
            statusRowRepeatedClass: dirtyStates.map((row) => row.repeatedClass),
            statusRowCutOffPoint: dirtyStates.map((row) => row.cutOffPoint),
            statusRowSchoolReopenDate: dirtyStates.map((row) => row.schoolReopenDate),
            responseMode: 'json',
          }),
        });

        const result = await response.json();
        if (!response.ok || !result.success) {
          throw new Error(result.message || 'Failed to save status settings.');
        }

        applySavedStatusRows(result.savedRows);
        loadClassSettings(classIdField.value);
        showToast(result.message || `Saved ${dirtyRows.length} edited ${rowCountLabel}.`);
      } catch (error) {
        console.error('Error saving status settings:', error);
        alert(error?.message || 'Failed to save status settings.');
      } finally {
        endSubmitUi();
      }
    });

    // ── Collapsible cards ──
    (function initCardCollapse() {
      const isLarge = window.innerWidth >= 960;
      document.querySelectorAll('.card').forEach((card, index) => {
        if (card.classList.contains('collapsible-card')) return;
        // First card = "Class-specific Status Settings" — keep open on large screens
        const isStatusCard = index === 0;
        const header = card.querySelector(':scope > h2, :scope > .section-title');
        if (!header) return;

        card.classList.add('collapsible-card');

        // Arrow indicator
        const arrow = document.createElement('span');
        arrow.className = 'card-collapse-arrow';
        arrow.textContent = '▼';

        // Wrap header in clickable div
        const hdr = document.createElement('div');
        hdr.className = 'card-collapse-hdr';
        header.parentNode.insertBefore(hdr, header);
        hdr.appendChild(header);
        hdr.appendChild(arrow);

        // Wrap remaining card content in a collapsible body div
        const body = document.createElement('div');
        body.className = 'card-collapse-body';
        while (hdr.nextSibling) {
          body.appendChild(hdr.nextSibling);
        }
        card.appendChild(body);

        // Toggle on click
        hdr.addEventListener('click', () => card.classList.toggle('collapsed'));

        // Initial state: large screen keeps status card open, all others collapsed everywhere
        if (!isLarge || !isStatusCard) {
          card.classList.add('collapsed');
        }
      });
    })();

  </script>
  <% } %>
</body>
</html>
