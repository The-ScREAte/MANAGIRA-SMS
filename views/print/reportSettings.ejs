        max-height: calc(100vh - 10px);
        padding: 8px;
      }

      .status-date-banner-head {
        margin-bottom: 5px;
      }

      .status-date-banner-title {
        font-size: 0.68rem;
      }

      .status-date-banner-btn {
        padding: 6px 8px;
        font-size: 0.66rem;
      }

      .status-date-banner-actions {
        gap: 5px;
      }

      .status-date-banner-select-help {
        font-size: 0.64rem;
      }

      .status-date-banner-class-option {
        padding: 5px 6px;
      }

      #advancedDsPanel {
        padding: 12px !important;
      }

      #advancedDsPanel .ds-adv-flat-lbl,
      #advancedDsPanel .ds-adv-sub-lbl,
      #advancedDsPanel .ds-adv-lbl {
        font-size: 0.8rem;
      }

      #advancedDsPanel .paygira-adv-row,
      #advancedDsPanel #ds-paygira-future-name-wrap {
        flex-direction: column;
        align-items: stretch;
      }

      #advancedDsPanel .paygira-field-row {
        grid-template-columns: 1fr;
      }

      #advancedDsPanel .paygira-total-row {
        grid-template-columns: 1fr;
      }

      #advancedDsPanel .paygira-apply-classes-grid {
        grid-template-columns: 1fr;
      }

      #advancedDsPanel .paygira-preview-box {
        overflow-x: auto;
      }

      .rs-bulk-modal {
        width: min(96vw, 540px);
      }

      .rs-bulk-input-grid {
        grid-template-columns: 1fr;
      }

      .rs-bulk-footer {
        flex-wrap: wrap;
      }

      .rs-bulk-footer .btn {
        flex: 1 1 calc(50% - 6px);
        justify-content: center;
      }

      #advancedDsPanel input[type="text"],
      #advancedDsPanel input[type="number"],
      #advancedDsPanel input[type="date"],
      #advancedDsPanel select,
      #advancedDsPanel textarea {
        width: 100%;
        min-width: 0 !important;
      }

      #advancedDsPanel label[style*="min-width:220px"] {
        min-width: 0 !important;
        width: 100% !important;
      }

      #advancedDsPanel #ds-paygira-future-bill-name {
        min-width: 0 !important;
        width: 100%;
      }

      #advancedDsPanel div[style*="grid-template-columns:1fr 1fr"] {
        grid-template-columns: 1fr !important;
      }

      .rs-score-header-grid {
        grid-template-columns: 1fr;
        align-items: flex-start;
      }

      .status-settings-actions {
        flex-wrap: wrap;
      }

      .status-settings-actions .status-btn {
        width: 100% !important;
        min-width: 0;
      }

      .status-overview-toolbar {
        flex-direction: column;
        align-items: stretch;
      }

      .rs-score-header-row {
        flex-direction: column;
        align-items: flex-start;
      }

      .rs-action-links {
        width: 100%;
        justify-content: flex-start;
      }

      .rs-action-link {
        font-size: 0.77rem;
        padding: 4px 6px;
      }

      .rs-bulk-modal,
      .rs-bulk-picker-modal {
        width: 98vw;
        padding: 12px;
      }

      .rs-bulk-modal {
        font-size: 0.8rem;
      }

      .rs-bulk-title {
        font-size: 0.84rem;
      }

      .rs-bulk-rules-label,
      .rs-bulk-input-label,
      .rs-bulk-select-all {
        font-size: 0.68rem;
      }

      .rs-bulk-input,
      .rs-bulk-class-name {
        font-size: 0.74rem;
      }

      .rs-bulk-modal .btn {
        font-size: 0.68rem;
        padding: 5px 8px;
      }

      .rs-bulk-modal .rs-class-select-row {
        padding: 5px 6px;
      }

      .rs-grade-config-card {
        width: 98vw;
        padding: 12px;
      }

      .rs-grade-config-card .rs-grade-config-title {
        font-size: 0.84rem;
      }

      .rs-grade-config-card .rs-grade-config-note,
      .rs-grade-config-card .rs-grade-toggle-head,
      .rs-grade-config-card .rs-grade-toggle-option,
      .rs-grade-config-card .rs-grade-subject-item,
      .rs-grade-config-card #gradeNumericAssignClassesWrap label,
      .rs-grade-config-card .rs-class-select-row span {
        font-size: 0.68rem !important;
      }

      .rs-grade-config-card .rs-grade-toggle-option {
        padding: 3px 7px;
      }

      .rs-grade-config-card .btn,
      .rs-grade-config-card .rs-grade-config-close {
        font-size: 0.72rem;
      }

      .rs-grade-config-card .btn {
        padding: 7px 10px;
      }

      .rs-grade-config-card #gradeNumericAssignClassesWrap {
        gap: 6px !important;
        padding: 8px !important;
      }

      .rs-grade-config-card #gradeNumericClassCheckboxes {
        grid-template-columns: repeat(2, minmax(0, 1fr)) !important;
        gap: 6px !important;
      }

      .rs-grade-config-card .rs-class-select-row {
        gap: 6px;
        padding: 5px 6px;
      }

      .rs-grade-config-card .grade-numeric-class-checkbox,
      .rs-grade-config-card #gradeNumericSelectAllClasses {
        width: 13px;
        height: 13px;
      }

      .rs-grade-config-card #gradeCoreSubjectList {
        grid-template-columns: repeat(2, minmax(0, 1fr)) !important;
        gap: 6px;
      }

      .rs-grade-config-card #gradeCoreSubjectHint {
        font-size: 0.66rem !important;
      }

      .rs-grade-config-card #gradeBaseSubjectCountWrap,
      .rs-grade-config-card #gradeOtherSubjectCountWrap,
      .rs-grade-config-card #gradeBaseRandomSelectionTypeWrap {
        flex-direction: row !important;
        align-items: center;
        justify-content: space-between;
        gap: 6px !important;
        font-size: 0.68rem !important;
      }

      .rs-grade-config-card #gradeBaseSubjectCountWrap input,
      .rs-grade-config-card #gradeOtherSubjectCountWrap input,
      .rs-grade-config-card #gradeBaseRandomSelectionTypeWrap select {
        width: min(130px, 48vw);
        min-width: 92px;
        margin-left: auto;
        font-size: 0.74rem !important;
        padding: 4px 6px !important;
      }

      .rs-bulk-input-grid,
      .rs-bulk-class-grid {
        grid-template-columns: 1fr;
      }

      .rs-bulk-class-grid {
        padding: 8px;
        gap: 6px;
        max-height: 260px;
      }

      .rs-bulk-footer .btn {
        width: 100%;
      }
    }

    /* ── Collapsible cards ── */
    .card-collapse-hdr {
      display: flex;
      align-items: center;
      justify-content: space-between;
      cursor: pointer;
      user-select: none;
      gap: 8px;
      width: 100%;
    }
    .card-collapse-hdr > h2,
    .card-collapse-hdr > .section-title {
      margin-bottom: 0;
      flex: 1;
    }
    .card-collapse-hdr:hover { opacity: 0.8; }
    .card-collapse-arrow {
      font-size: 10px;
      color: var(--muted);
      transition: transform 0.22s;
      flex-shrink: 0;
    }
    .collapsible-card.collapsed .card-collapse-arrow {
      transform: rotate(-90deg);
    }
    .collapsible-card:not(.collapsed) .card-collapse-hdr {
      margin-bottom: 12px;
      padding-bottom: 10px;
      border-bottom: 1px solid var(--border);
    }
    .collapsible-card.collapsed .card-collapse-body {
      display: none;
    }

    .gr-toolbar {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 10px;
      margin-bottom: 10px;
      align-items: center;
    }

    .gr-toolbar-item {
      min-width: 0;
      display: flex;
      align-items: center;
    }

    .gr-toolbar .rs-action-links {
      width: 100%;
      justify-content: flex-start;
    }

    .gr-toolbar .rs-action-link {
      font-size: 0.86rem;
      padding: 0;
    }

    .gr-inline-actions {
      display: flex;
      justify-content: flex-end;
      margin-top: 8px;
    }

    .gr-inline-actions .btn {
      width: min(260px, 100%);
      min-width: 180px;
      min-height: 44px;
      height: 44px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
    }

    .gr-remark-head {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 10px;
      margin-bottom: 8px;
    }

    .gr-remark-title {
      margin: 0;
      font-size: 0.8rem;
      font-weight: 700;
      color: #64748b;
      letter-spacing: 0.02em;
      text-transform: uppercase;
    }

    .gr-remark-add-link {
      font-size: 0.82rem;
    }

    .remark-item {
      border: 1px solid rgba(203, 213, 225, 0.72);
      border-radius: 10px;
      background: linear-gradient(145deg, rgba(255, 255, 255, 0.8), rgba(248, 250, 252, 0.66));
      backdrop-filter: blur(8px);
      -webkit-backdrop-filter: blur(8px);
      box-shadow: inset 0 1px 0 rgba(255,255,255,0.72);
      padding: 7px;
      margin-bottom: 8px;
    }

    .remark-item-head {
      display: flex;
      align-items: center;
      justify-content: flex-end;
      min-height: 18px;
      margin-bottom: 4px;
    }

    .remark-item-remove {
      display: none;
      color: #b91c1c;
      font-size: 0.76rem;
      font-weight: 700;
      text-decoration: none;
      line-height: 1.2;
    }

    .remark-item.is-removable .remark-item-remove {
      display: inline-flex;
      align-items: center;
    }

    .remark-item .form-group {
      margin-bottom: 0;
    }

    .remark-item label {
      font-size: 0.8rem;
      margin-bottom: 4px;
    }

    .gr-accordion-trigger {
      width: 100%;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 10px;
      background: #f8fafc;
      border: 1px solid var(--border);
      border-radius: 10px;
      padding: 10px 12px;
      color: var(--primary);
      font-weight: 700;
      font-size: 0.86rem;
      cursor: pointer;
    }

    .gr-accordion-trigger:hover {
      background: #f1f5f9;
    }

    .gr-accordion-panel {
      display: none;
      margin-top: 8px;
      padding: 10px 12px;
      border: 1px solid var(--border);
      border-radius: 10px;
      background: #fff;
      animation: dsFadeIn 0.16s ease;
    }

    .gr-accordion-trigger .gr-arrow {
      font-size: 10px;
      color: var(--muted);
      transition: transform 0.2s ease;
      flex-shrink: 0;
    }

    .gr-accordion-trigger[aria-expanded="true"] .gr-arrow {
      transform: rotate(180deg);
    }

    .gr-modal-overlay {
      position: fixed;
      inset: 0;
      background: rgba(8, 15, 30, 0.48);
      display: none;
      align-items: center;
      justify-content: center;
      z-index: 10060;
      padding: 16px;
    }

    .gr-modal-overlay.is-open {
      display: flex;
    }

    .gr-modal-card {
      width: min(560px, 96vw);
      max-height: 90vh;
      overflow-y: auto;
      background: #fff;
      border: 1px solid #d8e3ef;
      border-radius: 14px;
      box-shadow: 0 28px 74px rgba(0,0,0,0.28);
      padding: 12px;
    }

    .gr-modal-head {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 10px;
      margin-bottom: 10px;
    }

    .gr-modal-title {
      margin: 0;
      font-size: 0.92rem;
      color: #1f2937;
      font-weight: 800;
      letter-spacing: 0.01em;
    }

    .gr-modal-close {
      border: 1px solid #d7e1ec;
      width: 28px;
      height: 28px;
      border-radius: 8px;
      background: #f8fafc;
      color: #475569;
      cursor: pointer;
      font-size: 0.9rem;
      line-height: 1;
    }

    .gr-modal-note {
      margin: 0 0 10px;
      font-size: 0.76rem;
      color: #64748b;
      line-height: 1.35;
    }

    .gr-type-list {
      margin-top: 10px;
      border-top: 1px dashed var(--border);
      padding-top: 10px;
      display: grid;
      gap: 6px;
    }

    .gr-type-list-title {
      margin: 0 0 2px;
      font-size: 0.76rem;
      font-weight: 700;
      letter-spacing: 0.02em;
      text-transform: uppercase;
      color: #64748b;
    }

    .gr-type-row {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: center;
      gap: 8px;
      border: 1px solid #e2e8f0;
      background: #fff;
      border-radius: 8px;
      padding: 7px 9px;
      font-size: 0.82rem;
      color: #334155;
    }

    .gr-type-row-label {
      display: block;
      font-weight: 600;
      color: #1f2937;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: normal;
      line-height: 1.3;
      min-width: 0;
    }

    .gr-type-delete-btn {
      border: 1px solid rgba(220, 38, 38, 0.25);
      background: #fff;
      color: #b91c1c;
      border-radius: 8px;
      padding: 4px 8px;
      font-size: 0.74rem;
      font-weight: 700;
      cursor: pointer;
      flex-shrink: 0;
      white-space: nowrap;
    }

    .gr-type-delete-btn:hover {
      background: #fef2f2;
    }

    .gr-type-empty {
      font-size: 0.78rem;
      color: var(--muted);
      border: 1px dashed var(--border);
      border-radius: 8px;
      padding: 8px;
      background: #f8fafc;
    }

    .global-remark-textarea {
      min-height: 58px;
      height: 58px;
      padding: 6px 8px;
      font-size: 0.87rem;
      line-height: 1.32;
      margin-bottom: 8px;
      resize: vertical;
    }

    @media (max-width: 640px) {
      .gr-toolbar {
        grid-template-columns: 1fr;
      }

      .gr-inline-actions .btn {
        width: 100%;
      }

      .gr-inline-actions {
        justify-content: stretch;
      }

      .gr-remark-head {
        flex-direction: column;
        align-items: flex-start;
      }

      .gr-modal-card {
        width: 98vw;
      }
    }
  </style>
</head>
<body>
  <div class="loading-overlay" id="loadingOverlay">
    <div class="spinner"></div>
  </div>
  <%- include('../partials/flash') %>
  <main>
    <div class="hero">
      <h1>Report Settings</h1>
      <p>Manage global report remarks, signatures, and class-specific promotion rules in one place.</p>
    </div>

    <% const currentClass = (enrolledClasses && enrolledClasses.find(c => String(c.class_id) === String(classId))) || (enrolledClasses && enrolledClasses[0]); %>
    <% const classOrderIndexMap = {}; (enrolledClasses || []).forEach((cls, idx) => { classOrderIndexMap[String(cls.class_id)] = idx; }); %>
    <% const hasTranscriptFeature = Array.isArray(allowedFeatures) && (allowedFeatures.includes('Official School Transcript') || allowedFeatures.includes('Official Transcript')); %>
    <% const hasSavedRemarks = Array.isArray(remarks) && remarks.length > 0; %>

    <% if (setupRequired) { %>
      <div class="empty-panel">
        <h2>Classes Setup Required</h2>
        <p><%= setupMessage || 'Complete class setup to continue.' %></p>
        <a href="/common/management" class="btn" data-no-spa>Open School Setup</a>
      </div>
    <% } else { %>

    <div class="card" style="margin-bottom:14px;">
      <div class="section-title">Class-specific Status Settings</div>
      <div class="class-layout">
        <div class="class-list" id="classList">
          <% enrolledClasses.forEach((cls, idx) => { const hasSetting = groupedStatusSettings.some(s => s.classes && s.classes.includes(cls.class_id)); %>
            <button type="button" class="class-button" data-class-id="<%= cls.class_id %>" <%= idx===0 ? 'aria-current="true"' : '' %>>
              <span><%= cls.class_name %></span>
              <span style="font-size:12px;color:<%= hasSetting ? 'var(--text)' : '#94a3b8' %>;"><%= hasSetting ? 'Has settings' : 'No settings' %></span>
            </button>
          <% }); %>
        </div>

        <div class="class-panel">
          <div id="settingsFormContainer">
            <form id="statusSettingsForm" action="/print/savePromotionSettings" method="POST">
              <input type="hidden" name="classId" id="statusClassId" value="<%= currentClass ? currentClass.class_id : '' %>" />
              <input type="hidden" name="termId" value="<%= termId %>" />
              <input type="hidden" name="selectedStatusClasses" id="selectedStatusClasses" value="<%= currentClass ? currentClass.class_id : '' %>" />

              <div id="noSettingsMsg" style="display:none;padding:16px;background:#f0f4f8;border-radius:8px;margin-bottom:12px;color:#64748b;font-weight:600;">No settings saved for this class yet. Add settings for this class below.</div>
              <div class="form-group status-rows-group">
                <div class="status-rows-heading">
                  <div class="status-rows-title">Class Status Rows</div>
                  <div class="status-rows-help">Edit each row, then save once.</div>
                </div>
                <div id="statusRowsEditor" class="status-row-editor">
                  <div class="status-row-head">
                    <span>Class</span>
                    <span>Promoted To</span>
                    <span>Repeated To</span>
                    <span>Cut Off</span>
                    <span>Reopen Date</span>
                  </div>
                  <% 
                    const formatDateInputValue = (value) => {
                      if (!value) return '';
                      if (value instanceof Date) {
                        return Number.isNaN(value.getTime()) ? '' : value.toISOString().slice(0, 10);
                      }
                      const rawValue = String(value).trim();
                      if (!rawValue) return '';
                      if (/^\d{4}-\d{2}-\d{2}$/.test(rawValue)) return rawValue;
                      const parsedValue = new Date(rawValue);
                      return Number.isNaN(parsedValue.getTime()) ? '' : parsedValue.toISOString().slice(0, 10);
                    };
                    enrolledClasses.forEach(classItem=>{
                    const rowSetting = groupedStatusSettings.find(setting => Array.isArray(setting.classes) && setting.classes.includes(classItem.class_id));
                    const rowPromoted = rowSetting && rowSetting.promoted_class ? Number(rowSetting.promoted_class) : null;
                    const rowRepeated = rowSetting && rowSetting.repeated_class ? Number(rowSetting.repeated_class) : null;
                    const rowCutOff = rowSetting && rowSetting.cut_off_point !== null && rowSetting.cut_off_point !== undefined ? rowSetting.cut_off_point : '';
                    const rowReopenDate = rowSetting ? formatDateInputValue(rowSetting.school_reopen_date) : '';
                  %>
                    <div class="status-row-item<%= String(currentClass ? currentClass.class_id : '') === String(classItem.class_id) ? ' is-active' : '' %>" data-class-id="<%= classItem.class_id %>">
                      <input type="hidden" name="statusRowClassId[]" value="<%= classItem.class_id %>" />
                      <div class="status-row-class"><%= classItem.class_name %></div>

                      <select class="status-row-field" name="statusRowPromotedClass[]">
                        <option value="">Select class</option>
                        <% enrolledClasses.forEach(optionClass=>{ %>
                          <option value="<%= optionClass.class_id %>" <%= rowPromoted === Number(optionClass.class_id) ? 'selected' : '' %>><%= optionClass.class_name %></option>
                        <% }); %>
                      </select>

                      <select class="status-row-field" name="statusRowRepeatedClass[]">
                        <option value="">Select class</option>
                        <% enrolledClasses.forEach(optionClass=>{ %>
                          <option value="<%= optionClass.class_id %>" <%= rowRepeated === Number(optionClass.class_id) ? 'selected' : '' %>><%= optionClass.class_name %></option>
                        <% }); %>
                      </select>

                      <input class="status-row-field" type="number" name="statusRowCutOffPoint[]" value="<%= rowCutOff %>" />
                      <div class="status-row-date-cell">
                        <input class="status-row-field" type="date" name="statusRowSchoolReopenDate[]" value="<%= rowReopenDate %>" />
                      </div>
                    </div>
                  <% }); %>
                </div>
                <div id="statusDatePopup" class="status-date-popup" aria-hidden="true">
                  <div class="status-date-banner-head">
                    <div class="status-date-banner-title">Reuse this reopen date?</div>
                    <button type="button" class="status-date-banner-close" data-status-date-close aria-label="Close reopen date options">&times;</button>
                  </div>
                  <div class="status-date-banner-actions">
                    <button type="button" class="status-date-banner-btn" data-status-date-action="all">Apply to all classes</button>
                    <button type="button" class="status-date-banner-btn" data-status-date-action="empty">Apply to classes with no date</button>
                    <button type="button" class="status-date-banner-btn" data-status-date-action="select">Select classes</button>
                  </div>
                  <div class="status-date-banner-select-panel" data-status-date-select-panel>
                    <p class="status-date-banner-select-help">Pick the classes that should receive this same reopen date.</p>
                    <div class="status-date-banner-class-list" data-status-date-class-list></div>
                    <div class="status-date-banner-footer">
                      <button type="button" class="status-date-banner-btn" data-status-date-action="cancel-select">Cancel</button>
                      <button type="button" class="status-date-banner-btn" data-status-date-action="apply-selected">Apply selected</button>
                    </div>
                  </div>
                </div>
              </div>

              <!-- Activate Promotion is managed in the Advanced section -->
              <div style="display:none;"><input type="checkbox" id="activatePromotion" name="activatePromotion" /></div>

              <div class="status-settings-actions">
                <button type="submit" id="statusSettingsSaveBtn" class="btn status-btn status-btn-primary">Save Status Settings</button>
                <button type="button" class="btn btn-danger status-btn status-btn-danger" id="cancelEditBtn" style="display:none;">Cancel</button>
              </div>
            </form>
          </div>

          <div id="settingsOverviewContainer" style="display:none;">
            <div class="status-overview-card">
              <div class="status-overview-toolbar">
                <div>
                  <div class="status-overview-title">Current Settings</div>
                  <div class="status-overview-note">Review this class summary or open row editor.</div>
                </div>
                <div class="status-overview-actions rs-action-links">
                  <a href="javascript:void(0)" id="bulkStatusSettingsBtn" class="rs-action-link">Edit Status Rows</a>
                </div>
              </div>
              <div id="currentSettingsDisplay" class="status-overview-grid"></div>
            </div>
          </div>

          <!-- ── Advanced Display Settings Accordion ── -->
          <div id="advancedDsAccordion" style="margin-top:14px;border:1px solid var(--border);border-radius:10px;overflow:hidden;">
            <button type="button" id="advancedDsToggleBtn" onclick="toggleAdvancedDsPanel()" style="width:100%;display:flex;align-items:center;justify-content:space-between;padding:10px 14px;background:#f8fafc;border:none;cursor:pointer;font-weight:600;font-size:0.85rem;color:var(--muted);letter-spacing:0.01em;">
              <span style="display:flex;align-items:center;gap:7px;">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><path d="M19.07 4.93A10 10 0 1 1 4.93 19.07"/><path d="M12 2v4M12 18v4M4.93 4.93l2.83 2.83M16.24 16.24l2.83 2.83"/></svg>
                Advanced
              </span>
              <span id="advancedDsArrow" style="font-size:10px;transition:transform 0.2s;">▼</span>
            </button>
            <div id="advancedDsPanel" style="display:none;padding:14px 16px;background:#fff;border-top:1px solid var(--border);">
              <!-- Populated by renderAdvancedDs(classId) -->
            </div>
          </div>
          <!-- ── /Advanced Display Settings Accordion ── -->

          <div style="margin-top:20px;padding-top:20px;border-top:2px solid var(--border);">
            <div class="section-title" style="margin:0 0 10px 0;">Grade & Score Settings for <span id="selectedClassName"></span></div>

            <div style="display:grid;grid-template-columns:1fr;gap:12px;">
              <div style="border:1px solid var(--border);border-radius:10px;padding:12px;background:#fff;">
                <div class="rs-score-header-row">
                  <div style="font-weight:700;color:var(--primary);">Grade & Score Mapping</div>
                  <div class="rs-action-links">
                    <a href="javascript:void(0)" id="openGradeBulkPicker" class="rs-action-link">+ Add Grade & Remark Rules</a>
                  </div>
                </div>

                <div id="gradeFormContainer" style="display:none;background:#f8fafc;border:1px solid var(--border);border-radius:10px;padding:16px;margin-bottom:12px;">
                  <form id="gradeForm">
                    <input type="hidden" id="editingGradeRowId" value="" />
                    <input type="hidden" id="editingGradeSourceClassId" value="" />
                    <div style="display:flex;align-items:center;justify-content:space-between;gap:8px;margin-bottom:10px;">
                      <div style="font-size:0.84rem;font-weight:700;color:var(--primary);">Rule Rows</div>
                      <button type="button" id="addGradeRuleRowBtn" class="rs-icon-btn" title="Add another rule">+</button>
                    </div>
                    <div id="gradeRuleRows" style="display:flex;flex-direction:column;gap:10px;margin-bottom:12px;"></div>
                    <template id="gradeRuleRowTemplate">
                      <div class="grade-rule-row" data-role="grade-rule-row" style="border:1px solid var(--border);border-radius:8px;padding:10px;background:#fff;">
                        <div style="display:flex;align-items:center;justify-content:space-between;gap:8px;margin-bottom:8px;">
                          <div style="font-size:0.78rem;font-weight:700;color:var(--muted);" data-role="grade-rule-title">Rule</div>
                          <button type="button" class="rs-icon-btn" data-role="remove-grade-rule-row" data-tone="danger" title="Remove rule">&times;</button>
                        </div>
                        <div style="display:grid;grid-template-columns:1fr 1.6fr 0.9fr 0.9fr;gap:12px;align-items:start;">
                          <div class="form-group" style="margin-bottom:0;">
                            <label>Grade Label</label>
                            <input type="text" data-field="grade" placeholder="e.g., A" maxlength="20" />
                          </div>
                          <div class="form-group" style="margin-bottom:0;">
                            <label>Score Remark</label>
                            <input type="text" data-field="remark" placeholder="e.g., Excellent" />
                          </div>
                          <div class="form-group" style="margin-bottom:0;">
                            <label>From %</label>
                            <input type="number" data-field="from" placeholder="70" />
                          </div>
                          <div class="form-group" style="margin-bottom:0;">
                            <label>To %</label>
                            <input type="number" data-field="to" placeholder="100" />
                          </div>
                        </div>
                      </div>
                    </template>
                    <div class="form-group">
                      <label>Apply To Classes:</label>
                      <label style="display:inline-flex;align-items:center;gap:6px;color:var(--muted);font-size:0.78rem;margin:0 0 8px 0;">
                        <input type="checkbox" id="selectAllGradeClasses" style="accent-color:var(--primary);" />
                        Select all classes
                      </label>
                      <div id="gradeClassCheckboxes" style="display:grid;grid-template-columns:repeat(auto-fill,minmax(180px,1fr));gap:8px;"></div>
                    </div>
                    <div style="display:flex;gap:10px;align-items:center;">
                      <button type="submit" class="btn" id="saveGradeMappingBtn">Save Rules</button>
                      <button type="button" class="btn btn-secondary" id="cancelGradeMappingBtn">Cancel</button>
                    </div>
                  </form>
                </div>

                <div class="remarks-list" id="classGradeMappings"></div>

                <div class="rs-grade-format-panel">
                  <div class="rs-grade-format-row">
                    <label style="display:flex;align-items:center;gap:6px;color:var(--muted);font-size:0.76rem;margin:0;">
                      Format
                      <select id="gradeDisplayModeSelect" style="padding:3px 6px;border:1px solid var(--border);border-radius:6px;background:#fff;max-width:100%;min-width:0;font-size:0.86rem;line-height:1.15;">
                        <option value="letters">Letters</option>
                        <option value="numbers">Numbers</option>
                        <option value="both">Letters + Numbers</option>
                      </select>
                    </label>
                    <div id="gradeNumericConfigTriggerWrap" class="rs-grade-config-trigger" style="display:none;">
                      <a href="javascript:void(0)" id="openGradeNumericConfigBtn" class="rs-action-link">Configure Numbers</a>
                    </div>
                  </div>

                  <div id="gradeNumericConfigModal" class="rs-grade-config-modal" style="display:none;">
                    <div class="rs-grade-config-card">
                      <div class="rs-grade-config-head">
                        <h4 class="rs-grade-config-title">Number Format Configuration</h4>
                        <button type="button" id="closeGradeNumericConfigIcon" class="rs-grade-config-close" aria-label="Close">x</button>
                      </div>

                      <p class="rs-grade-config-note">Configure how numeric grade totals should be shown and calculated for this class.</p>

                      <div id="showGradeNumericTotalWrap" style="display:none;">
                        <div class="rs-grade-toggle-head">Show number total on report</div>
                        <div class="rs-grade-toggle-choices" role="radiogroup" aria-label="Show number total on report">
                          <label class="rs-grade-toggle-option" for="showGradeNumericTotalOnReport">
                            <input type="radio" id="showGradeNumericTotalOnReport" name="showGradeNumericTotalVisibility" value="yes">
                            Yes
                          </label>
                          <label class="rs-grade-toggle-option" for="hideGradeNumericTotalOnReport">
                            <input type="radio" id="hideGradeNumericTotalOnReport" name="showGradeNumericTotalVisibility" value="no">
                            No
                          </label>
                        </div>
                      </div>

                      <div id="gradeNumericTotalConfigWrap" style="display:none;flex:1 1 100%;margin:8px 0 0 0;padding:10px;border:1px dashed var(--border);border-radius:8px;background:#f8fafc;">
                        <div style="font-size:0.75rem;color:var(--muted);font-weight:600;margin-bottom:8px;">Number Total Setup</div>
                        <div id="gradeNumericStrategyControls" style="display:grid;grid-template-columns:1fr;gap:8px;">
                          <label class="rs-grade-strategy-option">
                            <input type="radio" name="gradeNumericTotalStrategyOption" class="grade-numeric-strategy-radio" value="base_plus_best" style="accent-color:var(--primary);margin-top:2px;">
                            <span>Calculate using Core + Additional Subjects.</span>
                          </label>
                          <div id="gradeBasePlusDetailsWrap" class="rs-grade-strategy-details">
                            <div class="rs-grade-base-stack">
                              <label id="gradeBaseSubjectCountWrap" class="rs-grade-core-glass" style="display:none;flex-direction:column;gap:4px;color:var(--muted);font-size:0.76rem;margin:0;">
                                Core Subjects Count
                                <input type="number" id="gradeBaseSubjectCountInput" min="0" step="1" placeholder="5" style="padding:5px 6px;border:1px solid var(--border);border-radius:6px;background:#fff;font-size:0.86rem;line-height:1.15;" />
                              </label>
                              <div id="gradeCoreSubjectConfigWrap" class="rs-grade-core-glass-pane" style="display:none;margin-top:0;">
                                <div id="gradeCoreSubjectList" class="rs-grade-subject-grid rs-grade-core-subject-grid"></div>
                                <div id="gradeCoreSubjectHint" style="margin-top:6px;font-size:0.72rem;color:var(--muted);"></div>
                              </div>

                              <label id="gradeOtherSubjectCountWrap" class="rs-grade-random-glass" style="display:none;flex-direction:column;gap:4px;color:var(--muted);font-size:0.76rem;margin:0;">
                                Additional Subjects Count
                                <input type="number" id="gradeOtherSubjectCountInput" min="0" step="1" placeholder="2" style="padding:5px 6px;border:1px solid var(--border);border-radius:6px;background:#fff;font-size:0.86rem;line-height:1.15;" />
                              </label>

                              <label id="gradeBaseRandomSelectionTypeWrap" class="rs-grade-random-glass" style="display:none;flex-direction:column;gap:4px;color:var(--muted);font-size:0.76rem;margin:0;max-width:240px;">
                                Additional Subject Selection
                                <select id="gradeBaseRandomSelectionTypeSelect" class="rs-grade-random-select" style="padding:5px 6px;border-radius:6px;font-size:0.86rem;line-height:1.15;">
                                  <option value="any">Random</option>
                                  <option value="best">Top</option>
                                </select>
                              </label>
                            </div>
                          </div>
                          <label class="rs-grade-strategy-option">
                            <input type="radio" name="gradeNumericTotalStrategyOption" class="grade-numeric-strategy-radio" value="all_subjects" style="accent-color:var(--primary);margin-top:2px;">
                            <span>Calculate using All Subjects.</span>
                          </label>
                          <input type="hidden" id="gradeNumericTotalStrategySelect" value="all_subjects" />
                        </div>

                        <div id="gradeNumericTotalConfigHint" style="margin-top:8px;font-size:0.72rem;color:var(--muted);"></div>

                        <div id="gradeNumericAssignClassesWrap" style="display:none;flex-direction:column;gap:8px;margin-top:10px;padding:10px;border:1px solid #d7e3ef;border-radius:10px;background:#f8fafc;">
                          <button type="button" id="toggleGradeNumericAssignClassesBtn" class="rs-grade-collapsible-trigger" aria-expanded="false">
                            <span>Assigned Classes</span>
                            <span class="rs-grade-collapsible-arrow" aria-hidden="true">▾</span>
                          </button>
                          <div id="gradeNumericAssignClassesPanel" class="rs-grade-collapsible-panel">
                            <label style="display:inline-flex;align-items:center;gap:6px;color:var(--muted);font-size:0.76rem;margin:0;">
                              <input type="checkbox" id="gradeNumericSelectAllClasses" style="accent-color:var(--primary);">
                              Select all classes
                            </label>
                            <div id="gradeNumericClassCheckboxes" style="display:grid;grid-template-columns:repeat(auto-fill,minmax(180px,1fr));gap:8px;margin-top:8px;"></div>
                          </div>
                        </div>
                      </div>

                      <div class="rs-grade-config-footer">
                        <button type="button" class="btn" id="closeGradeNumericConfigBtn">Done</button>
                      </div>
                    </div>
                  </div>
                </div>
              </div>

            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="grid">
      <div class="card">
        <h2>Global Remarks</h2>
        <div class="notice">These remarks are global and can be reused for any class or term.</div>
        <div class="gr-toolbar">
          <div class="gr-toolbar-item">
            <div class="rs-action-links">
              <a href="javascript:void(0)" id="openCustomRemarkTypeModalBtn" class="rs-action-link">Custom Remarks</a>
            </div>
          </div>
          <div class="gr-toolbar-item">
          <button type="button" class="gr-accordion-trigger" id="toggleClassroomRemarkTypesBtn" aria-expanded="false">
            <span>Class Remark Types</span>
            <span class="gr-arrow">▼</span>
          </button>
          </div>
        </div>
        <div id="classroomRemarkTypesWrap" class="gr-accordion-panel">
        <form id="classroomRemarkTypeForm" action="/print/saveClassroomRemarkTypes?classId=<%= classId %>&termId=<%= termId %>" method="POST" style="margin-bottom:0;">
          <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:8px;">
            <% const classroomTypes = Array.isArray(classroomRemarkTypes) && classroomRemarkTypes.length ? classroomRemarkTypes : ['teacher']; %>
            <label style="display:flex;align-items:center;gap:7px;font-size:0.83rem;color:var(--text);"><input type="checkbox" name="classroomRemarkTypes[]" value="teacher" <%= classroomTypes.includes('teacher') ? 'checked' : '' %> /> Teacher's Remarks</label>
            <label style="display:flex;align-items:center;gap:7px;font-size:0.83rem;color:var(--text);"><input type="checkbox" name="classroomRemarkTypes[]" value="conduct" <%= classroomTypes.includes('conduct') ? 'checked' : '' %> /> Conduct Remarks</label>
            <label style="display:flex;align-items:center;gap:7px;font-size:0.83rem;color:var(--text);"><input type="checkbox" name="classroomRemarkTypes[]" value="interest" <%= classroomTypes.includes('interest') ? 'checked' : '' %> /> Interest Remarks</label>
            <label style="display:flex;align-items:center;gap:7px;font-size:0.83rem;color:var(--text);"><input type="checkbox" name="classroomRemarkTypes[]" value="attitude" <%= classroomTypes.includes('attitude') ? 'checked' : '' %> /> Attitude Remarks</label>
            <% (customRemarkTypes || []).forEach(function(customType){ %>
              <label style="display:flex;align-items:center;gap:7px;font-size:0.83rem;color:var(--text);"><input type="checkbox" name="classroomRemarkTypes[]" value="<%= customType.type_key %>" <%= classroomTypes.includes(customType.type_key) ? 'checked' : '' %> /> <%= customType.label %></label>
            <% }); %>
          </div>
          <div style="margin-top:8px;display:flex;justify-content:flex-end;">
            <button type="submit" class="btn btn-secondary" id="saveClassroomRemarkTypesBtn">Save Classroom Popup Types</button>
          </div>
        </form>
        </div>
        <form id="globalRemarksForm" action="/print/saveRemarks?classId=<%= classId %>&termId=<%= termId %>" method="POST">
          <div class="gr-remark-head">
            <div class="gr-remark-title">Remark Entries</div>
            <div class="rs-action-links">
              <a href="javascript:void(0)" id="add-remark-btn" class="rs-action-link gr-remark-add-link">+ Add remark</a>
            </div>
          </div>
          <div id="remarks-container">
            <div class="form-group remark-item">
              <div class="remark-item-head">
                <a href="javascript:void(0)" class="remark-item-remove" aria-label="Remove remark entry">Remove</a>
              </div>
              <textarea class="global-remark-textarea" name="remarks[]" required maxlength="150" placeholder="Enter remark (max 150 characters)"></textarea>
              <div class="form-group">
                <label>Select Remark Type:</label>
                <select name="remarkType[]" required>
                  <option value="teacher">Teacher's Remark</option>
                  <option value="conduct">Conduct Remark</option>
                  <option value="interest">Interest Remark</option>
                  <option value="attitude">Attitude Remark</option>
                  <% (customRemarkTypes || []).forEach(function(customType){ %>
                    <option value="<%= customType.type_key %>"><%= customType.label %></option>
                  <% }); %>
                </select>
              </div>
            </div>
          </div>
          <div class="gr-inline-actions">
            <button type="submit" class="btn" id="saveRemarksBtn">Save Remarks</button>
          </div>
        </form>
        <div class="table-wrapper">
          <button type="button" class="gr-accordion-trigger" id="toggleSavedRemarksBtn" aria-expanded="false" style="margin-top:14px;">
            <span>Saved Remarks</span>
            <span class="gr-arrow">▼</span>
          </button>
          <div class="gr-accordion-panel" id="savedRemarksWrap">
          <div class="remarks-list" id="savedRemarksList">
            <% if (!hasSavedRemarks) { %>
              <div class="empty-inline">No remarks saved yet.</div>
            <% } else { %>
              <% const builtinRemarkTypes = [
                { type_key: 'teacher', label: "Teacher's Remarks" },
                { type_key: 'conduct', label: 'Conduct Remarks' },
                { type_key: 'interest', label: 'Interest Remarks' },
                { type_key: 'attitude', label: 'Attitude Remarks' },
              ];
              const allRemarkTypeRows = [...builtinRemarkTypes, ...((customRemarkTypes || []).map(function(customType){ return { type_key: customType.type_key, label: customType.label }; }))];
              %>
              <% allRemarkTypeRows.forEach(function(typeRow){ const type = typeRow.type_key; const label = typeRow.label; if(remarks.some(r=>r.remark_type===type)){ %>
                <h3 style="margin:10px 0 6px;color:var(--primary);"><%= label %></h3>
                <% remarks.filter(r=>r.remark_type===type).forEach(function(remark){ %>
                  <div class="remark-row">
                    <span class="remark-text"><%= remark.remark %></span>
                    <div class="kebab-menu" data-remark-id="<%= remark.id %>">
                      <button type="button" class="kebab" aria-label="More actions" aria-expanded="false">⋮</button>
                      <ul>
                        <li><a href="/print/deleteRemark/<%= remark.id %>?classId=<%= classId %>&termId=<%= termId %>" data-no-spa data-confirm-message="Delete this remark? This action cannot be undone.">Delete</a></li>
                      </ul>
                    </div>
                  </div>
                <% }); %>
              <% } }); %>
            <% } %>
          </div>
          </div>
        </div>

        <div id="customRemarkTypeModal" class="gr-modal-overlay" aria-hidden="true">
          <div class="gr-modal-card" role="dialog" aria-modal="true" aria-labelledby="customRemarkTypeModalTitle">
            <div class="gr-modal-head">
              <h3 id="customRemarkTypeModalTitle" class="gr-modal-title">Create Custom Remark Type</h3>
              <button type="button" class="gr-modal-close" id="closeCustomRemarkTypeModalBtn" aria-label="Close">x</button>
            </div>
            <p class="gr-modal-note">Create a custom type for this organization. It saves with AJAX and appears immediately in remark selectors.</p>
            <div style="display:flex;gap:8px;flex-wrap:wrap;align-items:center;">
              <input type="text" id="customRemarkTypeInput" maxlength="60" placeholder="e.g. Creativity Remarks" style="flex:1;min-width:220px;padding:8px 10px;border:1px solid var(--border);border-radius:8px;font-size:0.83rem;" />
              <button type="button" class="btn" id="createCustomRemarkTypeBtn">Save Custom Type</button>
              <button type="button" class="btn btn-secondary" id="cancelCustomRemarkTypeBtn">Cancel</button>
            </div>
            <div id="customRemarkTypeMsg" style="min-height:16px;margin-top:6px;font-size:0.76rem;color:var(--muted);"></div>
            <div id="customRemarkTypeList" class="gr-type-list">
              <div class="gr-type-list-title">Saved Custom Types</div>
              <% if (!(customRemarkTypes || []).length) { %>
                <div class="gr-type-empty">No custom types yet.</div>
              <% } else { %>
                <% (customRemarkTypes || []).forEach(function(customType){ %>
                  <div class="gr-type-row" data-type-key="<%= customType.type_key %>">
                    <span class="gr-type-row-label"><%= customType.label %></span>
                    <button type="button" class="gr-type-delete-btn" data-type-key="<%= customType.type_key %>">Delete</button>
                  </div>
                <% }); %>
              <% } %>
            </div>
          </div>
        </div>
      </div>



      <div class="card">
        <h2>Signature Management</h2>
        <div class="notice">Create and manage digital signatures for your reports. Each class can have only one signature.</div>
        
        <% if (signatureGroups && Object.keys(signatureGroups).length) { %>
          <div class="section-title" style="margin-top:0;margin-bottom:12px;">Current Signatures</div>
          <div style="display:grid;gap:12px;margin-bottom:20px;">
            <% Object.keys(signatureGroups).forEach(signaturePath => { const sig = signatureGroups[signaturePath]; %>
              <div style="border:1px solid var(--border);border-radius:10px;padding:14px;background:#fff;">
                <div style="display:flex;gap:14px;align-items:flex-start;">
                  <% if (sig.signature_image_url) { %>
                    <div style="flex-shrink:0;border:1px solid #e0e0e0;border-radius:6px;padding:8px;background:#fafafa;">
                      <img src="<%= sig.signature_image_url %>" alt="Signature" style="max-width:150px;max-height:80px;display:block;" />
                    </div>
                  <% } else { %>
                    <div style="flex-shrink:0;min-width:150px;color:#e11d48;font-size:0.9rem;">Signature unavailable</div>
                  <% } %>
                  
                  <div style="flex:1;min-width:0;">
                    <div style="margin-bottom:8px;">
                      <div style="font-weight:700;color:#0f172a;"><%= sig.signature_title || 'Authorized Signature' %></div>
                      <div style="font-size:0.95rem;color:var(--muted);"><%= sig.signature_name || 'Authorized Signer' %></div>
                    </div>
                    <div style="font-weight:600;color:var(--primary);margin-bottom:8px;font-size:0.95rem;">Applied to <%= sig.classes.length %> class<%= sig.classes.length !== 1 ? 'es' : '' %>:</div>
                    <div style="display:flex;flex-wrap:wrap;gap:6px;margin-bottom:10px;">
                      <% sig.classes.slice().sort((a,b)=> (classOrderIndexMap[String(a.class_id)] ?? 2147483647) - (classOrderIndexMap[String(b.class_id)] ?? 2147483647)).forEach(classInfo=>{ %>
                        <span class="tag" style="background:rgba(15,90,102,0.1);color:var(--primary);padding:4px 10px;border-radius:6px;font-size:0.85rem;display:inline-flex;align-items:center;gap:6px;">
                          <%= classInfo.class_name %>
                          <a href="javascript:void(0)" 
                             style="color:#e11d48;text-decoration:none;font-weight:700;line-height:1;"
                             onclick="deleteSignatureForClass(<%= classInfo.class_id %>, '<%= classInfo.class_name %>', '<%= termId %>')">×</a>
                        </span>
                      <% }); %>
                    </div>
                    <div style="display:flex;gap:12px;align-items:center;">
                      <a href="javascript:void(0)" 
                         class="add-classes-link" 
                         data-signature-path="<%= signaturePath %>"
                         style="color:var(--primary);font-weight:600;text-decoration:none;font-size:0.9rem;">+ Add More Classes</a>
                      <a href="javascript:void(0)" 
                         style="color:#e11d48;font-weight:600;text-decoration:none;font-size:0.9rem;"
                         onclick="deleteEntireSignature('<%= encodeURIComponent(signaturePath) %>', '<%= termId %>')">Delete Signature</a>
                    </div>
                  </div>
                </div>
              </div>
            <% }); %>
          </div>
        <% } else { %>
          <div class="empty-inline" style="margin-bottom:20px;">No report signatures created yet.</div>
        <% } %>
        
        <div style="border-top:2px solid var(--border);padding-top:16px;margin-top:8px;">
          <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:12px;">
            <h3 style="margin:0;font-size:1.05rem;color:var(--primary);">Create New Report Signature</h3>
            <a href="javascript:void(0)" id="toggleSignatureForm" style="color:var(--primary);font-weight:600;text-decoration:none;font-size:0.9rem;">+ Show Form</a>
          </div>
          
          <div id="signatureFormContainer" style="display:none;">
            <div class="sig-canvas-wrapper"><canvas id="signatureCanvas" class="sig-canvas"></canvas></div>
            <div class="sig-helper-text">Draw slowly for the cleanest signature. The pad smooths your stroke automatically and saves a tightly trimmed PNG.</div>
            <div class="sig-canvas-actions">
              <button type="button" class="btn btn-danger" onclick="clearCanvas()">Clear</button>
              <button type="button" class="btn" onclick="saveDigitalSignature()">Save Signature</button>
            </div>
            <div id="sigStatus" class="sig-status"></div>
            <div class="form-row-2" style="margin:12px 0 4px;">
              <div class="form-group" style="margin-bottom:0;">
                <label>Signer Title</label>
                <input type="text" id="signatureTitleInput" placeholder="e.g., Principal" value="<%= signatureTitle || '' %>" />
              </div>
              <div class="form-group" style="margin-bottom:0;">
                <label>Signer Name</label>
                <input type="text" id="signatureNameInput" placeholder="e.g., Jane Doe" value="<%= signatureName || '' %>" />
              </div>
            </div>
            <div class="form-group" style="margin-top:12px;margin-bottom:0;">
              <label>Apply Signature To:</label>
              <div id="signatureClassCheckboxes" style="display:grid;grid-template-columns:repeat(auto-fill,minmax(180px,1fr));gap:8px;"></div>
            </div>
          </div>
        </div>

        <% if (hasTranscriptFeature) { %>
        <!-- Transcript Signatures Section -->
        <div style="border-top:3px solid var(--primary);padding-top:20px;margin-top:24px;">
          <h3 style="margin:0 0 8px;font-size:1.1rem;color:var(--primary);">📜 Transcript Signatures</h3>
          <div class="notice" style="margin-bottom:16px;">Manage signatures for student transcripts. These signatures appear on all transcript documents.</div>
          
          <% if (transcriptSignatureGroups && Object.keys(transcriptSignatureGroups).length) { %>
            <div class="section-title" style="margin-top:0;margin-bottom:12px;">Current Transcript Signatures</div>
            <div style="display:grid;gap:12px;margin-bottom:20px;">
              <% Object.keys(transcriptSignatureGroups).forEach(signaturePath => { const sig = transcriptSignatureGroups[signaturePath]; %>
                <div style="border:1px solid var(--border);border-radius:10px;padding:14px;background:#fff;">
                  <div style="display:flex;gap:14px;align-items:flex-start;">
                    <% if (sig.signature_image_url) { %>
                      <div style="flex-shrink:0;border:1px solid #e0e0e0;border-radius:6px;padding:8px;background:#fafafa;">
                        <img src="<%= sig.signature_image_url %>" alt="Signature" style="max-width:150px;max-height:80px;display:block;" />
                      </div>
                    <% } else { %>
                      <div style="flex-shrink:0;min-width:150px;color:#e11d48;font-size:0.9rem;">Signature unavailable</div>
                    <% } %>
                    
                    <div style="flex:1;min-width:0;">
                      <div style="margin-bottom:8px;">
                        <div style="font-weight:700;color:#0f172a;"><%= sig.signature_title || 'Authorized Transcript Signature' %></div>
                        <div style="font-size:0.95rem;color:var(--muted);"><%= sig.signature_name || 'Authorized Signer' %></div>
                      </div>
                      <div style="font-weight:600;color:var(--primary);margin-bottom:8px;font-size:0.95rem;">Applied to <%= sig.classes.length %> class<%= sig.classes.length !== 1 ? 'es' : '' %>:</div>
                      <div style="display:flex;flex-wrap:wrap;gap:6px;margin-bottom:10px;">
                        <% sig.classes.slice().sort((a,b)=> (classOrderIndexMap[String(a.class_id)] ?? 2147483647) - (classOrderIndexMap[String(b.class_id)] ?? 2147483647)).forEach(classInfo=>{ %>
                          <span class="tag" style="background:rgba(15,90,102,0.1);color:var(--primary);padding:4px 10px;border-radius:6px;font-size:0.85rem;display:inline-flex;align-items:center;gap:6px;">
                            <%= classInfo.class_name %>
                            <a href="javascript:void(0)" 
                               style="color:#e11d48;text-decoration:none;font-weight:700;line-height:1;"
                               onclick="deleteTranscriptSignatureForClass(<%= classInfo.class_id %>, '<%= classInfo.class_name %>')">×</a>
                          </span>
                        <% }); %>
                      </div>
                      <div style="display:flex;gap:12px;align-items:center;">
                        <a href="javascript:void(0)" 
                           class="add-transcript-classes-link" 
                           data-signature-path="<%= signaturePath %>"
                           style="color:var(--primary);font-weight:600;text-decoration:none;font-size:0.9rem;">+ Add More Classes</a>
                        <a href="javascript:void(0)" 
                           style="color:#e11d48;font-weight:600;text-decoration:none;font-size:0.9rem;"
                           onclick="deleteEntireTranscriptSignature('<%= encodeURIComponent(signaturePath) %>')">Delete Signature</a>
                      </div>
                    </div>
                  </div>
                </div>
              <% }); %>
            </div>
          <% } else { %>
            <div class="empty-inline" style="margin-bottom:20px;">No transcript signatures created yet.</div>
          <% } %>

          <div style="border-top:2px solid var(--border);padding-top:16px;margin-top:8px;">
            <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:12px;">
              <h3 style="margin:0;font-size:1.05rem;color:var(--primary);">Create New Transcript Signature</h3>
              <a href="javascript:void(0)" id="toggleTranscriptSignatureForm" style="color:var(--primary);font-weight:600;text-decoration:none;font-size:0.9rem;">+ Show Form</a>
            </div>
            
            <div id="transcriptSignatureFormContainer" style="display:none;">
              <div class="sig-canvas-wrapper"><canvas id="transcriptSignatureCanvas" class="sig-canvas"></canvas></div>
              <div class="sig-helper-text">Draw slowly for the cleanest signature. The pad smooths your stroke automatically and saves a tightly trimmed PNG.</div>
              <div class="sig-canvas-actions">
                <button type="button" class="btn btn-danger" onclick="clearTranscriptCanvas()">Clear</button>
                <button type="button" class="btn" onclick="saveTranscriptSignature()">Save Transcript Signature</button>
              </div>
              <div id="transcriptSigStatus" class="sig-status"></div>
              <div class="form-row-2" style="margin:12px 0 4px;">
                <div class="form-group" style="margin-bottom:0;">
                  <label>Signer Title</label>
                  <input type="text" id="transcriptSignatureTitleInput" placeholder="e.g., Registrar" />
                </div>
                <div class="form-group" style="margin-bottom:0;">
                  <label>Signer Name</label>
                  <input type="text" id="transcriptSignatureNameInput" placeholder="e.g., John Doe" />
                </div>
              </div>
              <div class="form-group" style="margin-top:12px;margin-bottom:0;">
                <label>Apply Transcript Signature To:</label>
                <div id="transcriptSignatureClassCheckboxes" style="display:grid;grid-template-columns:repeat(auto-fill,minmax(180px,1fr));gap:8px;"></div>
              </div>
            </div>
          </div>
        </div>
        <% } %>
      </div>
    </div>

    <% } %>

  </main>

  <% if (!setupRequired) { %>
  <script>
    const initialCustomRemarkTypes = <%- JSON.stringify(customRemarkTypes || []) %>;
    const customRemarkTypesState = Array.isArray(initialCustomRemarkTypes)
      ? initialCustomRemarkTypes.slice()
      : [];

    function buildRemarkTypeOptionsHtml() {
      const escHtml = (value) => String(value || '')
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#39;');

      const baseOptions = [
        { value: 'teacher', label: "Teacher's Remark" },
        { value: 'conduct', label: 'Conduct Remark' },
        { value: 'interest', label: 'Interest Remark' },
        { value: 'attitude', label: 'Attitude Remark' },
      ];
      const customOptions = customRemarkTypesState.map((item) => ({
        value: String(item.type_key || '').trim(),
        label: String(item.label || '').trim() || 'Custom Remark',
      })).filter((item) => item.value && item.label);

      return [...baseOptions, ...customOptions]
        .map((item) => `<option value="${escHtml(item.value)}">${escHtml(item.label)}</option>`)
        .join('');
    }

    function refreshCustomRemarkTypeTags() {
      const listEl = document.getElementById('customRemarkTypeList');
      if (!listEl) return;
      const escHtml = (value) => String(value || '')
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#39;');

      if (!customRemarkTypesState.length) {
        listEl.innerHTML = [
          '<div class="gr-type-list-title">Saved Custom Types</div>',
          '<div class="gr-type-empty">No custom types yet.</div>'
        ].join('');
        return;
      }
      listEl.innerHTML = [
        '<div class="gr-type-list-title">Saved Custom Types</div>',
        ...customRemarkTypesState.map((item) => `
          <div class="gr-type-row" data-type-key="${item.type_key}">
            <span class="gr-type-row-label">${escHtml(item.label || item.type_key)}</span>
            <button type="button" class="gr-type-delete-btn" data-type-key="${escHtml(item.type_key)}">Delete</button>
          </div>
        `)
      ].join('');
    }

    function refreshRemarkTypeSelectOptions() {
      const optionsHtml = buildRemarkTypeOptionsHtml();
      document.querySelectorAll('select[name="remarkType[]"]').forEach((selectEl) => {
        const currentValue = selectEl.value;
        selectEl.innerHTML = optionsHtml;
        if (currentValue && Array.from(selectEl.options).some((optionEl) => optionEl.value === currentValue)) {
          selectEl.value = currentValue;
        }
      });
    }

    function escapeHtmlText(value) {
      return String(value || '')
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#39;');
    }

    function refreshClassroomRemarkTypeOptions() {
      const container = document.querySelector('#classroomRemarkTypeForm > div');
      if (!container) return;

      const checkedValues = new Set(
        Array.from(container.querySelectorAll('input[name="classroomRemarkTypes[]"]:checked'))
          .map((inputEl) => String(inputEl.value || '').trim().toLowerCase())
      );

      const builtins = [
        { value: 'teacher', label: "Teacher's Remarks" },
        { value: 'conduct', label: 'Conduct Remarks' },
        { value: 'interest', label: 'Interest Remarks' },
        { value: 'attitude', label: 'Attitude Remarks' },
      ];

      const customs = customRemarkTypesState.map((item) => ({
        value: String(item.type_key || '').trim().toLowerCase(),
        label: String(item.label || '').trim(),
      })).filter((item) => item.value && item.label);

      container.innerHTML = [...builtins, ...customs].map((item) => {
        const checked = checkedValues.has(item.value) ? ' checked' : '';
        return '<label style="display:flex;align-items:center;gap:7px;font-size:0.83rem;color:var(--text);">'
          + '<input type="checkbox" name="classroomRemarkTypes[]" value="' + escapeHtmlText(item.value) + '"' + checked + ' /> '
          + escapeHtmlText(item.label)
          + '</label>';
      }).join('');
    }

    const openCustomRemarkTypeModalBtn = document.getElementById('openCustomRemarkTypeModalBtn');
    const closeCustomRemarkTypeModalBtn = document.getElementById('closeCustomRemarkTypeModalBtn');
    const customRemarkModal = document.getElementById('customRemarkTypeModal');
    const customRemarkCancelBtn = document.getElementById('cancelCustomRemarkTypeBtn');
    const toggleClassroomRemarkTypesBtn = document.getElementById('toggleClassroomRemarkTypesBtn');
    const classroomRemarkTypesWrap = document.getElementById('classroomRemarkTypesWrap');
    const toggleSavedRemarksBtn = document.getElementById('toggleSavedRemarksBtn');
    const savedRemarksWrap = document.getElementById('savedRemarksWrap');

    function setAccordionOpen(triggerEl, panelEl, isOpen) {
      if (!triggerEl || !panelEl) return;
      triggerEl.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
      panelEl.style.display = isOpen ? 'block' : 'none';
    }

    function setCustomRemarkTypeModalOpen(isOpen) {
      if (!customRemarkModal) return;
      customRemarkModal.classList.toggle('is-open', isOpen === true);
      customRemarkModal.setAttribute('aria-hidden', isOpen ? 'false' : 'true');
      if (isOpen) {
        const msgEl = document.getElementById('customRemarkTypeMsg');
        if (msgEl) {
          msgEl.textContent = '';
          msgEl.style.color = 'var(--muted)';
        }
        document.getElementById('customRemarkTypeInput')?.focus();
      }
    }

    openCustomRemarkTypeModalBtn?.addEventListener('click', () => {
      setCustomRemarkTypeModalOpen(true);
    });

    closeCustomRemarkTypeModalBtn?.addEventListener('click', () => {
      setCustomRemarkTypeModalOpen(false);
    });

    customRemarkCancelBtn?.addEventListener('click', () => {
      const inputEl = document.getElementById('customRemarkTypeInput');
      const msgEl = document.getElementById('customRemarkTypeMsg');
      if (inputEl) inputEl.value = '';
      if (msgEl) msgEl.textContent = '';
      setCustomRemarkTypeModalOpen(false);
    });

    customRemarkModal?.addEventListener('click', (event) => {
      if (event.target === customRemarkModal) {
        setCustomRemarkTypeModalOpen(false);
      }
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && customRemarkModal?.classList.contains('is-open')) {
        setCustomRemarkTypeModalOpen(false);
      }
    });

    toggleClassroomRemarkTypesBtn?.addEventListener('click', () => {
      const nextOpen = toggleClassroomRemarkTypesBtn.getAttribute('aria-expanded') !== 'true';
      setAccordionOpen(toggleClassroomRemarkTypesBtn, classroomRemarkTypesWrap, nextOpen);
    });

    toggleSavedRemarksBtn?.addEventListener('click', () => {
      const nextOpen = toggleSavedRemarksBtn.getAttribute('aria-expanded') !== 'true';
      setAccordionOpen(toggleSavedRemarksBtn, savedRemarksWrap, nextOpen);
    });

    setAccordionOpen(toggleClassroomRemarkTypesBtn, classroomRemarkTypesWrap, false);
    setAccordionOpen(toggleSavedRemarksBtn, savedRemarksWrap, false);

    document.getElementById('createCustomRemarkTypeBtn')?.addEventListener('click', async () => {
      const inputEl = document.getElementById('customRemarkTypeInput');
      const msgEl = document.getElementById('customRemarkTypeMsg');
      const createBtn = document.getElementById('createCustomRemarkTypeBtn');
      const label = String(inputEl?.value || '').trim();

      if (!label) {
        if (msgEl) {
          msgEl.style.color = '#dc2626';
          msgEl.textContent = 'Enter a custom remark type name.';
        }
        return;
      }

      if (createBtn) {
        createBtn.disabled = true;
        createBtn.textContent = 'Saving...';
      }
      if (msgEl) {
        msgEl.style.color = 'var(--muted)';
        msgEl.textContent = 'Creating custom remark type...';
      }

      try {
        const response = await fetch('/print/createCustomRemarkTypeAjax', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ label }),
        });
        const result = await response.json();
        if (!response.ok || !result || !result.success) {
          throw new Error((result && result.message) || 'Failed to create custom remark type.');
        }

        customRemarkTypesState.length = 0;
        (result.customRemarkTypes || []).forEach((item) => {
          customRemarkTypesState.push({
            type_key: String(item.type_key || '').trim(),
            label: String(item.label || '').trim(),
          });
        });

        refreshCustomRemarkTypeTags();
        refreshRemarkTypeSelectOptions();
        refreshClassroomRemarkTypeOptions();

        const activeClassId = String(document.getElementById('statusClassId')?.value || '').trim();
        if (activeClassId && allDisplaySettingsMap[activeClassId] && allDisplaySettingsMap[activeClassId].sections) {
          const sectionMap = allDisplaySettingsMap[activeClassId].sections;
          if (!sectionMap.customRemarksVisibility || typeof sectionMap.customRemarksVisibility !== 'object') {
            sectionMap.customRemarksVisibility = {};
          }
          sectionMap.customRemarksVisibility[result.created.type_key] = true;
          if (typeof renderAdvancedDs === 'function') {
            renderAdvancedDs(activeClassId);
          }
        }

        if (inputEl) inputEl.value = '';
        if (msgEl) {
          msgEl.style.color = '#16a34a';
          msgEl.textContent = 'Custom remark type created. Add remarks under this type below.';
        }
        setCustomRemarkTypeModalOpen(false);
        if (typeof showToast === 'function') {
          showToast('Custom remark type created successfully.');
        }
      } catch (error) {
        if (msgEl) {
          msgEl.style.color = '#dc2626';
          msgEl.textContent = error && error.message ? error.message : 'Failed to create custom remark type.';
        }
      } finally {
        if (createBtn) {
          createBtn.disabled = false;
          createBtn.textContent = 'Save Custom Type';
        }
      }
    });

    function syncRemarkItemRemoveState() {
      const items = Array.from(document.querySelectorAll('#remarks-container .remark-item'));
      items.forEach((itemEl, index) => {
        itemEl.classList.toggle('is-removable', index > 0);
      });
    }

    function buildRemarkItemHtml() {
      return `
        <div class="remark-item-head">
          <a href="javascript:void(0)" class="remark-item-remove" aria-label="Remove remark entry">Remove</a>
        </div>
        <textarea class="global-remark-textarea" name="remarks[]" required maxlength="150" placeholder="Enter remark (max 150 characters)"></textarea>
        <div class="form-group">
          <label>Select Remark Type:</label>
          <select name="remarkType[]" required>
            ${buildRemarkTypeOptionsHtml()}
          </select>
        </div>`;
    }

    document.getElementById('add-remark-btn')?.addEventListener('click', () => {
      const container = document.getElementById('remarks-container');
      const div = document.createElement('div');
      div.className = 'form-group remark-item is-removable';
      div.innerHTML = buildRemarkItemHtml();
      container.appendChild(div);
      syncRemarkItemRemoveState();
      div.querySelector('textarea[name="remarks[]"]')?.focus();
    });

    document.getElementById('remarks-container')?.addEventListener('click', (event) => {
      const removeLink = event.target.closest('.remark-item-remove');
      if (!removeLink) return;
      event.preventDefault();
      const itemEl = removeLink.closest('.remark-item');
      if (!itemEl) return;
      itemEl.remove();
      syncRemarkItemRemoveState();
    });

    syncRemarkItemRemoveState();

    document.getElementById('customRemarkTypeList')?.addEventListener('click', async (event) => {
      const deleteBtn = event.target.closest('.gr-type-delete-btn');
      if (!deleteBtn) return;

      const typeKey = String(deleteBtn.getAttribute('data-type-key') || '').trim();
      if (!typeKey) return;

      const rowEl = deleteBtn.closest('.gr-type-row');
      const typeLabel = rowEl?.querySelector('.gr-type-row-label')?.textContent?.trim() || 'this custom type';
      const msgEl = document.getElementById('customRemarkTypeMsg');

      if (!window.confirm(`Delete "${typeLabel}" custom type?`)) {
        return;
      }

      const originalBtnText = deleteBtn.textContent;
      deleteBtn.disabled = true;
      deleteBtn.textContent = 'Deleting...';

      if (msgEl) {
        msgEl.style.color = 'var(--muted)';
        msgEl.textContent = 'Deleting custom remark type...';
      }

      try {
        const response = await fetch('/print/deleteCustomRemarkTypeAjax', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ typeKey }),
        });
        const result = await response.json();
        if (!response.ok || !result || !result.success) {
          throw new Error((result && result.message) || 'Failed to delete custom remark type.');
        }

        customRemarkTypesState.length = 0;
        (result.customRemarkTypes || []).forEach((item) => {
          customRemarkTypesState.push({
            type_key: String(item.type_key || '').trim(),
            label: String(item.label || '').trim(),
          });
        });

        refreshCustomRemarkTypeTags();
        refreshRemarkTypeSelectOptions();
        refreshClassroomRemarkTypeOptions();

        const activeClassId = String(document.getElementById('statusClassId')?.value || '').trim();
        if (activeClassId && allDisplaySettingsMap[activeClassId] && allDisplaySettingsMap[activeClassId].sections) {
          const sectionMap = allDisplaySettingsMap[activeClassId].sections;
          if (sectionMap.customRemarksVisibility && typeof sectionMap.customRemarksVisibility === 'object') {
            delete sectionMap.customRemarksVisibility[typeKey];
          }
          if (typeof renderAdvancedDs === 'function') {
            renderAdvancedDs(activeClassId);
          }
        }

        if (msgEl) {
          msgEl.style.color = '#16a34a';
          msgEl.textContent = 'Custom remark type deleted.';
        }
      } catch (error) {
        if (msgEl) {
          msgEl.style.color = '#dc2626';
          msgEl.textContent = error && error.message ? error.message : 'Failed to delete custom remark type.';
        }
        deleteBtn.disabled = false;
        deleteBtn.textContent = originalBtnText;
      }
    });

    const statusSettingsMap = {};
    <% groupedStatusSettings.forEach(function(setting){ %>
      <% setting.classes.forEach(function(cid){ %>
        statusSettingsMap['<%= cid %>'] = <%- JSON.stringify(setting) %>;
      <% }); %>
    <% }); %>

    const scoreRemarksMap = {};
    <% const allScoreRemarks = JSON.parse(JSON.stringify(scoreRemarks)); %>
    <% allScoreRemarks.forEach(function(remark){ %>
      if(!scoreRemarksMap['<%= remark.class_id %>']) scoreRemarksMap['<%= remark.class_id %>'] = [];
      scoreRemarksMap['<%= remark.class_id %>'].push(<%- JSON.stringify(remark) %>);
    <% }); %>

    // ---- Display Settings data (must be defined before loadClassSettings is called) ----
    const allDisplaySettingsMap = <%- JSON.stringify(allDisplaySettingsMap) %>;
    const allSubjectsByClassMap = <%- JSON.stringify(allSubjectsByClassMap || {}) %>;
    const allAssessmentsByCategoryMap = <%- JSON.stringify(allAssessmentsByCategoryMap) %>;
    const defaultsSuppressedMap = <%- JSON.stringify(defaultsSuppressedMap || {}) %>;
    const initialRuleLocksMap = <%- JSON.stringify(ruleLocksMap || { grade: {}, remark: {} }) %>;
    const ruleLocksMap = {
      grade: initialRuleLocksMap && typeof initialRuleLocksMap.grade === 'object'
        ? { ...initialRuleLocksMap.grade }
        : {},
      remark: initialRuleLocksMap && typeof initialRuleLocksMap.remark === 'object'
        ? { ...initialRuleLocksMap.remark }
        : {},
    };

    const classButtons = document.querySelectorAll('.class-button');
    const enrolledClassesData = <%- JSON.stringify(enrolledClasses) %>;
    const activatePromotion = document.getElementById('activatePromotion');
    const classIdField = document.getElementById('statusClassId');
    const selectedStatusClasses = document.getElementById('selectedStatusClasses');
    const statusSettingsForm = document.getElementById('statusSettingsForm');
    const statusSettingsSaveBtn = document.getElementById('statusSettingsSaveBtn');
    const statusRowsEditor = document.getElementById('statusRowsEditor');
    const statusDatePopup = document.getElementById('statusDatePopup');
    const bulkStatusSettingsBtn = document.getElementById('bulkStatusSettingsBtn');
    const STATUS_ROW_FIELDS_SELECTOR = [
      'input[name="statusRowClassId[]"]',
      'select[name="statusRowPromotedClass[]"]',
      'select[name="statusRowRepeatedClass[]"]',
      'input[name="statusRowCutOffPoint[]"]',
      'input[name="statusRowSchoolReopenDate[]"]',
    ].join(', ');

    const formContainer = document.getElementById('settingsFormContainer');
    const overviewContainer = document.getElementById('settingsOverviewContainer');
    const cancelBtn = document.getElementById('cancelEditBtn');
    const currentSettingsDisplay = document.getElementById('currentSettingsDisplay');
    const gradeDisplayModeSelect = document.getElementById('gradeDisplayModeSelect');
    const gradeNumericConfigTriggerWrap = document.getElementById('gradeNumericConfigTriggerWrap');
    const openGradeNumericConfigBtn = document.getElementById('openGradeNumericConfigBtn');
    const gradeNumericConfigModal = document.getElementById('gradeNumericConfigModal');
    const closeGradeNumericConfigBtn = document.getElementById('closeGradeNumericConfigBtn');
    const closeGradeNumericConfigIcon = document.getElementById('closeGradeNumericConfigIcon');
    const showGradeNumericTotalWrap = document.getElementById('showGradeNumericTotalWrap');
    const showGradeNumericTotalOnReport = document.getElementById('showGradeNumericTotalOnReport');
    const hideGradeNumericTotalOnReport = document.getElementById('hideGradeNumericTotalOnReport');
    const gradeNumericTotalConfigWrap = document.getElementById('gradeNumericTotalConfigWrap');
    const gradeNumericStrategyControls = document.getElementById('gradeNumericStrategyControls');
    const gradeNumericAssignClassesWrap = document.getElementById('gradeNumericAssignClassesWrap');
    const toggleGradeNumericAssignClassesBtn = document.getElementById('toggleGradeNumericAssignClassesBtn');
    const gradeNumericAssignClassesPanel = document.getElementById('gradeNumericAssignClassesPanel');
    const gradeNumericSelectAllClasses = document.getElementById('gradeNumericSelectAllClasses');
    const gradeNumericClassCheckboxes = document.getElementById('gradeNumericClassCheckboxes');
    const gradeNumericTotalStrategySelect = document.getElementById('gradeNumericTotalStrategySelect');
    const gradeNumericStrategyRadios = Array.from(document.querySelectorAll('.grade-numeric-strategy-radio'));
    const gradeBaseSubjectCountWrap = document.getElementById('gradeBaseSubjectCountWrap');
    const gradeBaseSubjectCountInput = document.getElementById('gradeBaseSubjectCountInput');
    const gradeOtherSubjectCountWrap = document.getElementById('gradeOtherSubjectCountWrap');
    const gradeOtherSubjectCountInput = document.getElementById('gradeOtherSubjectCountInput');
    const gradeBasePlusDetailsWrap = document.getElementById('gradeBasePlusDetailsWrap');
    const gradeCoreSubjectConfigWrap = document.getElementById('gradeCoreSubjectConfigWrap');
    const gradeCoreSubjectList = document.getElementById('gradeCoreSubjectList');
    const gradeCoreSubjectHint = document.getElementById('gradeCoreSubjectHint');
    const gradeBaseRandomSelectionTypeWrap = document.getElementById('gradeBaseRandomSelectionTypeWrap');
    const gradeBaseRandomSelectionTypeSelect = document.getElementById('gradeBaseRandomSelectionTypeSelect');
    const gradeRandomSubjectConfigWrap = document.getElementById('gradeRandomSubjectConfigWrap');
    const gradeRandomSubjectCountWrap = document.getElementById('gradeRandomSubjectCountWrap');
    const gradeRandomSubjectHeading = document.getElementById('gradeRandomSubjectHeading');
    const gradeRandomSelectionTypeWrap = document.getElementById('gradeRandomSelectionTypeWrap');
    const gradeRandomSelectionTypeSelect = document.getElementById('gradeRandomSelectionTypeSelect');
    const gradeRandomSelectionTypeLabel = document.getElementById('gradeRandomSelectionTypeLabel');
    const gradeRandomSubjectSelectionWrap = document.getElementById('gradeRandomSubjectSelectionWrap');
    const gradeRandomSubjectCountInput = document.getElementById('gradeRandomSubjectCountInput');
    const gradeRandomSubjectList = document.getElementById('gradeRandomSubjectList');
    const gradeRandomSubjectHint = document.getElementById('gradeRandomSubjectHint');
    const gradeNumericTotalConfigHint = document.getElementById('gradeNumericTotalConfigHint');

    function confirmDestructiveAction(message) {
      return window.confirm(message || 'Are you sure you want to continue?');
    }

    function logGradeNumericTotal(eventName, payload = {}) {
      return;
    }

    function normalizeStatusRowValue(value) {
      return String(value ?? '').trim();
    }

    function normalizeStatusInputDate(value) {
      const rawValue = normalizeStatusRowValue(value);
      if (!rawValue) return '';
      if (/^\d{4}-\d{2}-\d{2}$/.test(rawValue)) return rawValue;
      const parsedValue = new Date(rawValue);
      return Number.isNaN(parsedValue.getTime()) ? '' : parsedValue.toISOString().slice(0, 10);
    }

    function getStatusRowState(row) {
      return {
        classId: normalizeStatusRowValue(row.querySelector('input[name="statusRowClassId[]"]')?.value),
        promotedClass: normalizeStatusRowValue(row.querySelector('select[name="statusRowPromotedClass[]"]')?.value),
        repeatedClass: normalizeStatusRowValue(row.querySelector('select[name="statusRowRepeatedClass[]"]')?.value),
        cutOffPoint: normalizeStatusRowValue(row.querySelector('input[name="statusRowCutOffPoint[]"]')?.value),
        schoolReopenDate: normalizeStatusInputDate(row.querySelector('input[name="statusRowSchoolReopenDate[]"]')?.value),
      };
    }

    function applySavedStatusRows(savedRows) {
      if (!Array.isArray(savedRows) || !savedRows.length) return;
      savedRows.forEach((savedRow) => {
        const classId = String(savedRow.class_id ?? '').trim();
        if (!classId) return;

        statusSettingsMap[classId] = {
          ...savedRow,
          class_id: Number(savedRow.class_id),
          promoted_class: savedRow.promoted_class === null || savedRow.promoted_class === undefined ? null : Number(savedRow.promoted_class),
          repeated_class: savedRow.repeated_class === null || savedRow.repeated_class === undefined ? null : Number(savedRow.repeated_class),
          cut_off_point: savedRow.cut_off_point === null || savedRow.cut_off_point === undefined ? null : Number(savedRow.cut_off_point),
          school_reopen_date: savedRow.school_reopen_date || null,
          classes: [Number(savedRow.class_id)],
        };

        const row = statusRowsEditor?.querySelector(`.status-row-item[data-class-id="${classId}"]`);
        if (!row) return;
        const promotedField = row.querySelector('select[name="statusRowPromotedClass[]"]');
        const repeatedField = row.querySelector('select[name="statusRowRepeatedClass[]"]');
        const cutOffField = row.querySelector('input[name="statusRowCutOffPoint[]"]');
        const reopenField = row.querySelector('input[name="statusRowSchoolReopenDate[]"]');
        if (promotedField) promotedField.value = savedRow.promoted_class ? String(savedRow.promoted_class) : '';
        if (repeatedField) repeatedField.value = savedRow.repeated_class ? String(savedRow.repeated_class) : '';
        if (cutOffField) cutOffField.value = savedRow.cut_off_point ?? '';
        if (reopenField) reopenField.value = normalizeStatusInputDate(savedRow.school_reopen_date);
      });

      captureStatusRowsInitialState();
      statusRowsEditor?.querySelectorAll('.status-row-item').forEach((row) => syncStatusRowDirtyState(row));
    }

    let suppressStatusDateBulkPrompt = false;
    let statusDatePopupTimer = null;
    let statusDatePopupSourceRow = null;
    let statusDatePopupValue = '';
    let statusDatePopupAnchorInput = null;

    function closeStatusDatePopup() {
      if (statusDatePopupTimer) {
        window.clearTimeout(statusDatePopupTimer);
        statusDatePopupTimer = null;
      }
      if (!statusDatePopup) return;
      statusDatePopup.classList.remove('is-open');
      statusDatePopup.setAttribute('aria-hidden', 'true');
      const selectPanel = statusDatePopup.querySelector('[data-status-date-select-panel]');
      if (selectPanel) selectPanel.classList.remove('is-open');
      statusDatePopupSourceRow = null;
      statusDatePopupValue = '';
      statusDatePopupAnchorInput = null;
    }

    function buildStatusDatePopupClassOptions(sourceRow) {
      if (!statusRowsEditor || !sourceRow) return '';
      return Array.from(statusRowsEditor.querySelectorAll('.status-row-item'))
        .filter((row) => row !== sourceRow)
        .map((row) => {
          const classId = String(row.dataset.classId || '').trim();
          const className = row.querySelector('.status-row-class')?.textContent?.trim() || 'Class';
          const existingDate = normalizeStatusInputDate(row.querySelector('input[name="statusRowSchoolReopenDate[]"]')?.value);
          const stateLabel = existingDate ? 'Has date' : 'No date';
          return `
            <div class="status-date-banner-class-option">
              <label>
                <input type="checkbox" value="${classId}" ${existingDate ? '' : 'checked'}>
                <span>${className}</span>
              </label>
              <span class="status-date-banner-class-state">${stateLabel}</span>
            </div>
          `;
        })
        .join('');
    }

    function positionStatusDatePopup(anchorInput) {
      if (!statusDatePopup || !anchorInput) return;
      if (window.innerWidth <= 680) {
        statusDatePopup.style.left = '50%';
        statusDatePopup.style.top = 'max(12px, env(safe-area-inset-top, 0px))';
        statusDatePopup.style.transform = 'translateX(-50%)';
        return;
      }

      statusDatePopup.style.transform = 'none';
      const rect = anchorInput.getBoundingClientRect();
      const popupRect = statusDatePopup.getBoundingClientRect();
      const viewportPadding = 10;
      let left = rect.right - popupRect.width;
      left = Math.min(left, window.innerWidth - popupRect.width - viewportPadding);
      left = Math.max(left, viewportPadding);

      let top = rect.bottom + 8;
      if (top + popupRect.height > window.innerHeight - viewportPadding) {
        const upwardTop = rect.top - popupRect.height - 8;
        top = upwardTop > viewportPadding ? upwardTop : Math.max(viewportPadding, window.innerHeight - popupRect.height - viewportPadding);
      }

      statusDatePopup.style.left = `${Math.round(left)}px`;
      statusDatePopup.style.top = `${Math.round(top)}px`;
    }

    function openStatusDatePopup(row, reopenDateValue, anchorInput) {
      if (!row || !reopenDateValue || !statusDatePopup) return;
      closeStatusDatePopup();
      statusDatePopupSourceRow = row;
      statusDatePopupValue = reopenDateValue;
      statusDatePopupAnchorInput = anchorInput || row.querySelector('input[name="statusRowSchoolReopenDate[]"]');

      statusDatePopupTimer = window.setTimeout(() => {
        const classList = statusDatePopup.querySelector('[data-status-date-class-list]');
        const selectPanel = statusDatePopup.querySelector('[data-status-date-select-panel]');
        if (!classList || !selectPanel) return;

        classList.innerHTML = buildStatusDatePopupClassOptions(row);
        selectPanel.classList.remove('is-open');
        statusDatePopup.classList.add('is-open');
        statusDatePopup.setAttribute('aria-hidden', 'false');
        positionStatusDatePopup(statusDatePopupAnchorInput);
        statusDatePopupTimer = null;
      }, 140);
    }

    function applyStatusReopenDateToRows(sourceRow, reopenDateValue, options = {}) {
      if (!statusRowsEditor || !sourceRow || !reopenDateValue) return 0;
      const mode = options.mode || 'all';
      const selectedClassIds = Array.isArray(options.selectedClassIds)
        ? new Set(options.selectedClassIds.map((value) => String(value).trim()).filter(Boolean))
        : null;
      let appliedCount = 0;

      suppressStatusDateBulkPrompt = true;
      statusRowsEditor.querySelectorAll('.status-row-item').forEach((row) => {
        if (row === sourceRow) {
          syncStatusRowDirtyState(row);
          return;
        }
        const classId = String(row.dataset.classId || '').trim();
        const reopenField = row.querySelector('input[name="statusRowSchoolReopenDate[]"]');
        if (!classId || !reopenField) return;

        const currentValue = normalizeStatusInputDate(reopenField.value);
        const shouldApply = mode === 'all'
          ? true
          : mode === 'empty'
            ? !currentValue
            : !!selectedClassIds?.has(classId);

        if (!shouldApply) return;
        reopenField.value = reopenDateValue;
        syncStatusRowDirtyState(row);
        appliedCount += 1;
      });
      suppressStatusDateBulkPrompt = false;
      syncStatusRowDirtyState(sourceRow);
      return appliedCount;
    }

    function captureStatusRowsInitialState() {
      if (!statusRowsEditor) return;
      statusRowsEditor.querySelectorAll('.status-row-item').forEach((row) => {
        row.dataset.initialState = JSON.stringify(getStatusRowState(row));
      });
    }

    function isStatusRowDirty(row) {
      try {
        const initialState = row.dataset.initialState ? JSON.parse(row.dataset.initialState) : null;
        if (!initialState) return false;
        const currentState = getStatusRowState(row);
        return (
          currentState.promotedClass !== initialState.promotedClass
          || currentState.repeatedClass !== initialState.repeatedClass
          || currentState.cutOffPoint !== initialState.cutOffPoint
          || currentState.schoolReopenDate !== initialState.schoolReopenDate
        );
      } catch (error) {
        return false;
      }
    }

    function syncStatusRowDirtyState(row) {
      row.classList.toggle('is-dirty', isStatusRowDirty(row));
    }

    function getDirtyStatusRows() {
      if (!statusRowsEditor) return [];
      return Array.from(statusRowsEditor.querySelectorAll('.status-row-item')).filter((row) => isStatusRowDirty(row));
    }

    function parseNonNegativeInteger(value, fallback = 0) {
      const parsed = parseInt(String(value ?? '').trim(), 10);
      if (!Number.isFinite(parsed) || parsed < 0) {
        return fallback;
      }
      return parsed;
    }

    function normalizeRuleEntryType(entryType) {
      return entryType === 'grade' ? 'grade' : 'remark';
    }

    function buildRuleRangeKey(fromValue, toValue) {
      const fromPct = Number(fromValue);
      const toPct = Number(toValue);
      if (!Number.isFinite(fromPct) || !Number.isFinite(toPct)) {
        return null;
      }
      return `${fromPct}__${toPct}`;
    }

    function isRuleLocked(entryType, classId, fromValue, toValue) {
      const safeEntryType = normalizeRuleEntryType(entryType);
      const classKey = String(classId);
      const rangeKey = buildRuleRangeKey(fromValue, toValue);
      if (!rangeKey) return false;
      const classLockRanges = ruleLocksMap[safeEntryType] && ruleLocksMap[safeEntryType][classKey];
      return !!(classLockRanges && classLockRanges[rangeKey] === true);
    }

    function applyRuleLockState(entryType, classIds, fromValue, toValue, locked) {
      const safeEntryType = normalizeRuleEntryType(entryType);
      const rangeKey = buildRuleRangeKey(fromValue, toValue);
      if (!rangeKey) return;

      if (!ruleLocksMap[safeEntryType]) {
        ruleLocksMap[safeEntryType] = {};
      }

      const normalizedClassIds = Array.isArray(classIds) ? classIds : [];
      normalizedClassIds.forEach((classId) => {
        const classKey = String(classId);
        if (!classKey) return;
        if (!ruleLocksMap[safeEntryType][classKey] || typeof ruleLocksMap[safeEntryType][classKey] !== 'object') {
          ruleLocksMap[safeEntryType][classKey] = {};
        }
        ruleLocksMap[safeEntryType][classKey][rangeKey] = locked === true;
      });
    }

    function getLockIconSvg(unlocked = false) {
      if (unlocked === true) {
        return '<svg class="rs-lock-icon-svg" viewBox="0 0 24 24" aria-hidden="true"><rect x="5" y="11" width="14" height="10" rx="2"></rect><path d="M8 11V8a4 4 0 0 1 7.2-2.4"></path></svg>';
      }
      return '<svg class="rs-lock-icon-svg" viewBox="0 0 24 24" aria-hidden="true"><rect x="5" y="11" width="14" height="10" rx="2"></rect><path d="M8 11V8a4 4 0 0 1 8 0v3"></path></svg>';
    }

    function getRuleLockBadgeHtml() {
      return `<span class="rs-lock-chip" title="Locked" aria-label="Locked">${getLockIconSvg(false)}</span>`;
    }

    function normalizePositiveIntegerArray(values) {
      if (!Array.isArray(values)) return [];
      return [...new Set(
        values
          .map((entry) => parseInt(entry, 10))
          .filter((entry) => Number.isFinite(entry) && entry > 0)
      )];
    }

    function normalizeRandomSelectionMode(value, fallback = 'any') {
      const parsed = String(value || '').trim().toLowerCase();
      return (parsed === 'best' || parsed === 'any') ? parsed : fallback;
    }

    function getGradeNumericTotalVisibilitySelection() {
      const selected = document.querySelector('input[name="showGradeNumericTotalVisibility"]:checked');
      return selected?.value === 'yes';
    }

    function syncShowGradeNumericTotalVisualState() {
      if (!showGradeNumericTotalWrap || !showGradeNumericTotalOnReport) return;
      const isChecked = getGradeNumericTotalVisibilitySelection();
      showGradeNumericTotalWrap.classList.toggle('is-checked', isChecked);
    }

    function normalizeGradePresentationState(rawGradePresentation) {
      const safe = rawGradePresentation && typeof rawGradePresentation === 'object' ? rawGradePresentation : {};
      const mode = (safe.mode === 'numbers' || safe.mode === 'both') ? safe.mode : 'letters';
      const showOnReport = safe.showNumberTotalOnReport === true;
      const rawTotalScoreStrategy = String(safe.totalScoreStrategy || '').trim();
      const mappedLegacySampled = rawTotalScoreStrategy === 'random_selected_subjects';
      const totalScoreStrategy = (
        rawTotalScoreStrategy === 'base_plus_best'
        || rawTotalScoreStrategy === 'base_plus_random'
      )
        ? rawTotalScoreStrategy
        : (mappedLegacySampled ? 'base_plus_best' : 'all_subjects');
      const isBasePlus = totalScoreStrategy === 'base_plus_best' || totalScoreStrategy === 'base_plus_random';
      const defaultBaseCount = totalScoreStrategy === 'all_subjects'
        ? 0
        : (mappedLegacySampled ? 0 : 5);
      const defaultOtherCount = totalScoreStrategy === 'all_subjects'
        ? 0
        : (mappedLegacySampled
          ? parseNonNegativeInteger(safe.randomSubjectCount ?? safe.otherSubjectCount, 2)
          : 2);
      const gradeBaseSubjectCount = parseNonNegativeInteger(safe.gradeBaseSubjectCount, defaultBaseCount);
      const otherSubjectCount = parseNonNegativeInteger(safe.otherSubjectCount, defaultOtherCount);
      const randomSubjectCount = 0;
      const coreSubjectIds = normalizePositiveIntegerArray(safe.coreSubjectIds);
      const randomSubjectIds = [];
      const randomSelectionMode = normalizeRandomSelectionMode(
        safe.randomSelectionMode,
        'any'
      );
      const usesCorePool = isBasePlus;
      const selectedClassIds = normalizePositiveIntegerArray(safe.applyToClasses);
      const currentClassId = parseInt(String(classIdField?.value || '').trim(), 10);
      if (Number.isFinite(currentClassId) && currentClassId > 0 && !selectedClassIds.includes(currentClassId)) {
        selectedClassIds.unshift(currentClassId);
      }

      return {
        mode,
        showNumberTotalOnReport: showOnReport,
        showOnReport,
        totalScoreStrategy,
        gradeBaseSubjectCount: isBasePlus ? gradeBaseSubjectCount : 0,
        otherSubjectCount: isBasePlus ? otherSubjectCount : 0,
        randomSubjectCount,
        coreSubjectIds: usesCorePool ? coreSubjectIds : [],
        randomSubjectIds,
        randomSelectionMode: isBasePlus ? randomSelectionMode : 'any',
        applyToClasses: selectedClassIds,
      };
    }

    function syncGradeNumericSelectAllClassesState() {
      if (!gradeNumericSelectAllClasses || !gradeNumericClassCheckboxes) return;
      const boxes = Array.from(gradeNumericClassCheckboxes.querySelectorAll('.grade-numeric-class-checkbox')).filter((cb) => !cb.disabled);
      if (!boxes.length) {
        gradeNumericSelectAllClasses.checked = false;
        gradeNumericSelectAllClasses.indeterminate = false;
        return;
      }
      const checkedCount = boxes.filter((cb) => cb.checked).length;
      gradeNumericSelectAllClasses.checked = checkedCount === boxes.length;
      gradeNumericSelectAllClasses.indeterminate = checkedCount > 0 && checkedCount < boxes.length;
    }

    function getSelectedGradeNumericClassIdsFromControls() {
      if (!gradeNumericClassCheckboxes) {
        const currentClassId = parseInt(String(classIdField?.value || '').trim(), 10);
        return Number.isFinite(currentClassId) && currentClassId > 0 ? [currentClassId] : [];
      }

      const selectedIds = normalizePositiveIntegerArray(
        Array.from(gradeNumericClassCheckboxes.querySelectorAll('.grade-numeric-class-checkbox:checked')).map((cb) => cb.value)
      );
      const currentClassId = parseInt(String(classIdField?.value || '').trim(), 10);
      if (Number.isFinite(currentClassId) && currentClassId > 0 && !selectedIds.includes(currentClassId)) {
        selectedIds.unshift(currentClassId);
      }
      return selectedIds;
    }

    function renderGradeNumericClassOptions(state) {
      if (!gradeNumericClassCheckboxes) return;
      const gradeState = normalizeGradePresentationState(state);
      const selectedSet = new Set(normalizePositiveIntegerArray(gradeState.applyToClasses));
      const currentClassId = parseInt(String(classIdField?.value || '').trim(), 10);
      const classRows = Array.isArray(enrolledClassesData) ? enrolledClassesData : [];

      gradeNumericClassCheckboxes.innerHTML = classRows.map((cls) => {
        const classIdValue = parseInt(cls?.class_id, 10);
        if (!Number.isFinite(classIdValue) || classIdValue <= 0) return '';
        const className = escapeHtmlText(String(cls?.class_name || `Class ${classIdValue}`));
        const isCurrent = Number.isFinite(currentClassId) && currentClassId === classIdValue;
        const isChecked = isCurrent || selectedSet.has(classIdValue);
        return `
          <label class="rs-class-select-row" style="display:flex;align-items:center;gap:8px;min-width:0;">
            <input type="checkbox" class="grade-numeric-class-checkbox" value="${classIdValue}" style="accent-color:var(--primary);" ${isChecked ? 'checked' : ''} ${isCurrent ? 'disabled' : ''}>
            <span style="white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">${className}${isCurrent ? ' (current)' : ''}</span>
          </label>
        `;
      }).join('');

      syncGradeNumericSelectAllClassesState();
    }

    function getAvailableClassSubjects(classId) {
      const classKey = String(classId ?? classIdField?.value ?? '').trim();
      const rawSubjects = allSubjectsByClassMap && typeof allSubjectsByClassMap === 'object'
        ? allSubjectsByClassMap[classKey]
        : [];
      if (!Array.isArray(rawSubjects)) return [];
      return rawSubjects
        .map((subject) => {
          const subjectId = parseInt(subject?.subject_id, 10);
          if (!Number.isFinite(subjectId) || subjectId <= 0) return null;
          const subjectName = String(subject?.subject_name || '').trim() || `Subject ${subjectId}`;
          return { subject_id: subjectId, subject_name: subjectName };
        })
        .filter(Boolean);
    }

    function getSelectedRandomSubjectIdsFromControls() {
      if (!gradeRandomSubjectList) return [];
      return normalizePositiveIntegerArray(
        Array.from(gradeRandomSubjectList.querySelectorAll('.grade-random-subject-checkbox:checked'))
          .map((checkbox) => checkbox.value)
      );
    }

    function getSelectedCoreSubjectIdsFromControls() {
      if (!gradeCoreSubjectList) return [];
      const maxCore = parseNonNegativeInteger(gradeBaseSubjectCountInput?.value, 0);
      if (maxCore <= 0) return [];
      return normalizePositiveIntegerArray(
        Array.from(gradeCoreSubjectList.querySelectorAll('.grade-core-subject-checkbox:checked'))
          .map((checkbox) => checkbox.value)
      ).slice(0, maxCore);
    }

    function enforceCoreSelectionLimit(changedCheckbox = null) {
      if (!gradeCoreSubjectList) return;
      const maxCore = parseNonNegativeInteger(gradeBaseSubjectCountInput?.value, 0);
      const checked = Array.from(gradeCoreSubjectList.querySelectorAll('.grade-core-subject-checkbox:checked'));
      if (checked.length <= maxCore) return;

      if (changedCheckbox && changedCheckbox.checked) {
        changedCheckbox.checked = false;
      } else {
        checked.slice(maxCore).forEach((checkbox) => {
          checkbox.checked = false;
        });
      }
    }

    function updateRandomTypeSelectOptions(selectElement, targetCount) {
      if (!selectElement) return;
      const safeCount = Math.max(0, parseNonNegativeInteger(targetCount, 0));
      const anyOption = selectElement.querySelector('option[value="any"]');
      const bestOption = selectElement.querySelector('option[value="best"]');
      if (anyOption) {
        anyOption.textContent = safeCount > 0 ? `Random ${safeCount}` : 'Random';
      }
      if (bestOption) {
        bestOption.textContent = safeCount > 0 ? `Top ${safeCount}` : 'Top';
      }
    }

    function renderGradeCoreSubjectOptions(state, options = {}) {
      if (!gradeCoreSubjectList) return;
      const gradeState = normalizeGradePresentationState(state);
      const showSubjectList = options.showSubjectList !== false;
      const classSubjects = getAvailableClassSubjects(classIdField?.value);
      const selectedIds = new Set(gradeState.coreSubjectIds);
      const coreLimit = Math.max(0, parseNonNegativeInteger(gradeState.gradeBaseSubjectCount, 0));
      let selectedCountForLimit = 0;

      if (gradeBaseSubjectCountInput) {
        gradeBaseSubjectCountInput.max = String(classSubjects.length || 0);
      }

      if (gradeCoreSubjectList) {
        gradeCoreSubjectList.style.display = showSubjectList ? 'grid' : 'none';
      }

      if (!classSubjects.length) {
        gradeCoreSubjectList.innerHTML = '<div style="font-size:0.74rem;color:var(--muted);">No subjects found for this class.</div>';
        if (gradeCoreSubjectHint) {
          gradeCoreSubjectHint.textContent = 'Add subjects to this class before configuring core subjects.';
        }
        return;
      }

      gradeCoreSubjectList.innerHTML = classSubjects.map((subject) => {
        const shouldCheck = selectedIds.has(subject.subject_id) && selectedCountForLimit < coreLimit;
        if (shouldCheck) selectedCountForLimit += 1;
        return `
          <label class="rs-grade-subject-item">
            <input type="checkbox" class="grade-core-subject-checkbox" value="${subject.subject_id}" style="accent-color:var(--primary);" ${shouldCheck ? 'checked' : ''}>
            <span>${escapeHtmlText(subject.subject_name)}</span>
          </label>
        `;
      }).join('');

      enforceCoreSelectionLimit();

      if (gradeCoreSubjectHint) {
        if (!showSubjectList) {
          gradeCoreSubjectHint.textContent = 'Enter a Core Subjects Count to choose core subjects.';
          return;
        }
        const selectedCount = getSelectedCoreSubjectIdsFromControls().length;
        if (!selectedCount) {
          gradeCoreSubjectHint.textContent = `Select up to ${coreLimit} core subjects. If none are selected, highest-scoring subjects are used automatically.`;
        } else {
          gradeCoreSubjectHint.textContent = `${selectedCount} of ${coreLimit} selected as core subjects.`;
        }
      }
    }

    function renderGradeRandomSubjectOptions(state, options = {}) {
      if (!gradeRandomSubjectList) return;
      const gradeState = normalizeGradePresentationState(state);
      const showSubjectList = options.showSubjectList !== false;
      const classSubjects = getAvailableClassSubjects(classIdField?.value);
      const selectedIds = new Set(gradeState.randomSubjectIds);

      if (gradeRandomSubjectCountInput) {
        gradeRandomSubjectCountInput.max = String(classSubjects.length || 0);
      }

      if (gradeRandomSubjectList) {
        gradeRandomSubjectList.style.display = showSubjectList ? 'grid' : 'none';
      }

      const emptySelectionText = 'Select subjects for the sampling pool. If none are selected, all subjects are included.';

      if (!classSubjects.length) {
        gradeRandomSubjectList.innerHTML = '<div style="font-size:0.74rem;color:var(--muted);">No subjects found for this class.</div>';
        if (gradeRandomSubjectHint) {
          gradeRandomSubjectHint.textContent = 'Add subjects to this class before using sampled-subject calculation.';
        }
        return;
      }

      gradeRandomSubjectList.innerHTML = classSubjects.map((subject) => `
        <label class="rs-grade-subject-item">
          <input type="checkbox" class="grade-random-subject-checkbox" value="${subject.subject_id}" style="accent-color:var(--primary);" ${selectedIds.has(subject.subject_id) ? 'checked' : ''}>
          <span>${escapeHtmlText(subject.subject_name)}</span>
        </label>
      `).join('');

      if (gradeRandomSubjectHint) {
        if (!showSubjectList) {
          gradeRandomSubjectHint.textContent = 'Enter a sample count to choose subjects for the sampling pool.';
          return;
        }

        const selectedCount = selectedIds.size;
        if (!selectedCount) {
          gradeRandomSubjectHint.textContent = emptySelectionText;
        } else {
          gradeRandomSubjectHint.textContent = `${selectedCount} subject${selectedCount === 1 ? '' : 's'} selected for sampling pool.`;
        }
      }
    }

    function syncGradeNumericConfigUI(state) {
      const gradeState = normalizeGradePresentationState(state);
      const isNumbersMode = gradeState.mode === 'numbers';
      const canOpenConfig = gradeState.mode === 'numbers' || gradeState.mode === 'both' || gradeState.mode === 'letters';
      const shouldShowConfig = canOpenConfig;
      const isBasePlus = shouldShowConfig
        && isNumbersMode
        && (gradeState.totalScoreStrategy === 'base_plus_best' || gradeState.totalScoreStrategy === 'base_plus_random');
      const configuredCoreCount = parseNonNegativeInteger(gradeState.gradeBaseSubjectCount, 0);
      const configuredOtherCount = parseNonNegativeInteger(gradeState.otherSubjectCount, 0);
      const showCoreSubjectList = isBasePlus && configuredCoreCount > 0;
      const needsRandomSubjectPanel = false;

      if (gradeNumericConfigTriggerWrap) {
        gradeNumericConfigTriggerWrap.style.display = canOpenConfig ? 'inline-flex' : 'none';
      }
      if (openGradeNumericConfigBtn) {
        openGradeNumericConfigBtn.textContent = isNumbersMode ? 'Configure Numbers' : 'Assigned Classes';
      }
      if (showGradeNumericTotalWrap) {
        showGradeNumericTotalWrap.style.display = isNumbersMode ? 'flex' : 'none';
      }
      if (showGradeNumericTotalOnReport) {
        showGradeNumericTotalOnReport.disabled = !isNumbersMode;
      }
      if (hideGradeNumericTotalOnReport) {
        hideGradeNumericTotalOnReport.disabled = !isNumbersMode;
      }
      if (gradeNumericAssignClassesWrap) {
        gradeNumericAssignClassesWrap.style.display = shouldShowConfig ? 'flex' : 'none';
      }
      if (gradeNumericStrategyControls) {
        gradeNumericStrategyControls.style.display = isNumbersMode ? 'grid' : 'none';
      }
      if (gradeNumericSelectAllClasses) {
        gradeNumericSelectAllClasses.disabled = !canOpenConfig;
      }
      syncShowGradeNumericTotalVisualState();
      if (gradeNumericTotalConfigWrap) {
        gradeNumericTotalConfigWrap.style.display = shouldShowConfig ? 'block' : 'none';
      }
      if (gradeBasePlusDetailsWrap) {
        gradeBasePlusDetailsWrap.style.display = isBasePlus ? 'block' : 'none';
      }
      if (gradeBaseSubjectCountWrap) {
        gradeBaseSubjectCountWrap.style.display = isBasePlus ? 'flex' : 'none';
      }
      if (gradeOtherSubjectCountWrap) {
        gradeOtherSubjectCountWrap.style.display = isBasePlus ? 'flex' : 'none';
      }
      if (gradeCoreSubjectConfigWrap) {
        gradeCoreSubjectConfigWrap.style.display = isBasePlus ? 'block' : 'none';
      }
      if (gradeBaseRandomSelectionTypeWrap) {
        gradeBaseRandomSelectionTypeWrap.style.display = (isBasePlus && configuredOtherCount > 0) ? 'flex' : 'none';
      }
      if (gradeRandomSubjectConfigWrap) {
        gradeRandomSubjectConfigWrap.style.display = needsRandomSubjectPanel ? 'block' : 'none';
      }
      if (gradeRandomSubjectCountWrap) {
        gradeRandomSubjectCountWrap.style.display = 'none';
      }
      if (gradeRandomSelectionTypeWrap) {
        gradeRandomSelectionTypeWrap.style.display = needsRandomSubjectPanel ? 'flex' : 'none';
      }
      if (gradeRandomSelectionTypeLabel) {
        gradeRandomSelectionTypeLabel.textContent = 'Sampling Method';
      }
      updateRandomTypeSelectOptions(gradeBaseRandomSelectionTypeSelect, configuredOtherCount);
      updateRandomTypeSelectOptions(gradeRandomSelectionTypeSelect, 0);
      if (gradeRandomSubjectHeading) {
        gradeRandomSubjectHeading.textContent = 'Sample from these subjects';
      }
      if (gradeRandomSubjectSelectionWrap) {
        gradeRandomSubjectSelectionWrap.style.display = 'none';
      }
      renderGradeCoreSubjectOptions(gradeState, {
        showSubjectList: showCoreSubjectList,
      });

      if (gradeNumericTotalConfigHint) {
        if (!shouldShowConfig) {
          gradeNumericTotalConfigHint.textContent = '';
        } else if (!isNumbersMode) {
          gradeNumericTotalConfigHint.textContent = 'Number Total Setup is only available when Format is set to Numbers. You can still manage Assigned Classes here.';
        } else {
          let formulaHint = 'Total Grade Score = sum of numeric grades for all scored subjects.';
          const randomMode = normalizeRandomSelectionMode(gradeState.randomSelectionMode, 'any');
          const basePickText = randomMode === 'best'
            ? `top ${configuredOtherCount}`
            : `random ${configuredOtherCount}`;
          if (gradeState.totalScoreStrategy === 'base_plus_best') {
            formulaHint = `Total Grade Score = core subjects (${gradeState.gradeBaseSubjectCount}) + ${basePickText} additional subjects.`;
          } else if (gradeState.totalScoreStrategy === 'base_plus_random') {
            formulaHint = `Legacy strategy = core subjects (${gradeState.gradeBaseSubjectCount}) + random additional subjects (${gradeState.otherSubjectCount}).`;
          }
          const visibilityHint = gradeState.showOnReport
            ? ''
            : ' Select "Yes" under "Show number total on report" to display this total in the final report.';
          gradeNumericTotalConfigHint.textContent = `${formulaHint}${visibilityHint}`;
        }
      }

      if (!canOpenConfig && gradeNumericConfigModal) {
        gradeNumericConfigModal.style.display = 'none';
      }
    }

    function applyGradePresentationStateToControls(rawState) {
      const state = normalizeGradePresentationState(rawState);
      if (gradeDisplayModeSelect) {
        gradeDisplayModeSelect.value = state.mode;
      }
      if (showGradeNumericTotalOnReport) {
        showGradeNumericTotalOnReport.checked = state.showOnReport;
      }
      if (hideGradeNumericTotalOnReport) {
        hideGradeNumericTotalOnReport.checked = !state.showOnReport;
      }
      syncShowGradeNumericTotalVisualState();
      if (gradeNumericTotalStrategySelect) {
        const supportedStrategies = ['base_plus_best', 'all_subjects', 'base_plus_random'];
        const normalizedStrategy = supportedStrategies.includes(state.totalScoreStrategy)
          ? state.totalScoreStrategy
          : (state.totalScoreStrategy === 'random_selected_subjects' ? 'base_plus_best' : 'all_subjects');
        gradeNumericTotalStrategySelect.value = normalizedStrategy;
        if (normalizedStrategy === 'base_plus_random') {
          gradeNumericTotalStrategySelect.value = 'base_plus_best';
        }
      }
      if (gradeNumericStrategyRadios.length) {
        const activeStrategy = gradeNumericTotalStrategySelect?.value || 'all_subjects';
        gradeNumericStrategyRadios.forEach((radio) => {
          radio.checked = radio.value === activeStrategy;
        });
      }
      if (gradeBaseSubjectCountInput) {
        gradeBaseSubjectCountInput.value = String(state.gradeBaseSubjectCount);
      }
      if (gradeOtherSubjectCountInput) {
        gradeOtherSubjectCountInput.value = String(state.otherSubjectCount);
      }
      if (gradeRandomSubjectCountInput) {
        gradeRandomSubjectCountInput.value = String(state.randomSubjectCount);
      }
      if (gradeBaseRandomSelectionTypeSelect) {
        gradeBaseRandomSelectionTypeSelect.value = normalizeRandomSelectionMode(
          state.randomSelectionMode,
          'any'
        );
      }
      if (gradeRandomSelectionTypeSelect) {
        gradeRandomSelectionTypeSelect.value = normalizeRandomSelectionMode(
          state.randomSelectionMode,
          'any'
        );
      }
      renderGradeNumericClassOptions(state);
      syncGradeNumericConfigUI(state);
    }

    function getGradePresentationPayloadFromControls() {
      const selectedMode = gradeDisplayModeSelect && (gradeDisplayModeSelect.value === 'numbers' || gradeDisplayModeSelect.value === 'both')
        ? gradeDisplayModeSelect.value
        : 'letters';
      const selectedVisibilityValue = document.querySelector('input[name="showGradeNumericTotalVisibility"]:checked')?.value || null;
      const fallbackFromInputs = (showGradeNumericTotalOnReport?.checked === true) && !(hideGradeNumericTotalOnReport?.checked === true);
      const showNumberTotalOnReport = selectedVisibilityValue
        ? selectedVisibilityValue === 'yes'
        : fallbackFromInputs;
      const selectedStrategyRadio = gradeNumericStrategyRadios.find((radio) => radio.checked);
      if (gradeNumericTotalStrategySelect && selectedStrategyRadio) {
        gradeNumericTotalStrategySelect.value = selectedStrategyRadio.value;
      }
      const totalScoreStrategy = (
        gradeNumericTotalStrategySelect?.value === 'base_plus_best'
        || gradeNumericTotalStrategySelect?.value === 'base_plus_random'
      )
        ? gradeNumericTotalStrategySelect.value
        : 'all_subjects';
      const isBasePlus = totalScoreStrategy === 'base_plus_best' || totalScoreStrategy === 'base_plus_random';
      const defaultBaseCount = totalScoreStrategy === 'all_subjects' ? 0 : 5;
      const defaultOtherCount = totalScoreStrategy === 'all_subjects' ? 0 : 2;
      const gradeBaseSubjectCount = parseNonNegativeInteger(gradeBaseSubjectCountInput?.value, defaultBaseCount);
      const otherSubjectCount = parseNonNegativeInteger(gradeOtherSubjectCountInput?.value, defaultOtherCount);
      const randomSubjectCount = 0;
      const coreSubjectIds = isBasePlus
        ? getSelectedCoreSubjectIdsFromControls()
        : [];
      const randomSubjectIds = [];
      const applyToClasses = getSelectedGradeNumericClassIdsFromControls();
      const randomSelectionMode = normalizeRandomSelectionMode(
        gradeBaseRandomSelectionTypeSelect?.value,
        'any'
      );

      const payload = {
        mode: selectedMode,
        showNumberTotalOnReport,
        totalScoreStrategy,
        gradeBaseSubjectCount: isBasePlus ? gradeBaseSubjectCount : 0,
        otherSubjectCount: isBasePlus ? otherSubjectCount : 0,
        randomSubjectCount,
        coreSubjectIds: isBasePlus ? coreSubjectIds : [],
        randomSubjectIds,
        randomSelectionMode: isBasePlus ? randomSelectionMode : 'any',
        applyToClasses,
      };

      logGradeNumericTotal('payload:fromControls', {
        classId: classIdField?.value,
        radioSelection: selectedVisibilityValue,
        yesChecked: showGradeNumericTotalOnReport?.checked === true,
        noChecked: hideGradeNumericTotalOnReport?.checked === true,
        payload,
      });

      return payload;
    }

    function openGradeNumericConfigModal() {
      const gradeState = getCurrentGradePresentationState();
      applyGradePresentationStateToControls(gradeState);
      setGradeNumericAssignClassesOpen(false);
      if (gradeNumericConfigModal) {
        gradeNumericConfigModal.style.display = 'flex';
      }
    }

    function closeGradeNumericConfigModal() {
      if (gradeNumericConfigModal) {
        gradeNumericConfigModal.style.display = 'none';
      }
    }

    function focusStatusRow(classId) {
      if (!statusRowsEditor) return;
      const classIdText = String(classId || '').trim();
      statusRowsEditor.querySelectorAll('.status-row-item').forEach((row) => {
        row.classList.toggle('is-active', row.dataset.classId === classIdText);
      });
    }

    // Confirm hard deletes for score/remark entries before navigating.
    document.addEventListener('click', (event) => {
      const deleteLink = event.target.closest('a[href*="/print/deleteScoreRemark/"], a[href*="/print/deleteRemark/"]');
      if (!deleteLink) return;
      const confirmMessage = String(deleteLink.getAttribute('data-confirm-message') || 'Delete this item? This action cannot be undone.');
      if (!confirmDestructiveAction(confirmMessage)) {
        event.preventDefault();
        event.stopPropagation();
      }
    });

    function loadClassSettings(classId){
      closeGradeNumericConfigModal();
      classIdField.value = classId;
      if (selectedStatusClasses) {
        selectedStatusClasses.value = String(classId || '');
      }

      const classDisplaySettings = allDisplaySettingsMap[String(classId)] || {};
      const gradePresentation = (classDisplaySettings.sections && classDisplaySettings.sections.gradePresentation) || {};
      const gradeState = normalizeGradePresentationState(gradePresentation);
      applyGradePresentationStateToControls(gradeState);

      focusStatusRow(classId);
      classButtons.forEach(btn => btn.classList.toggle('active', btn.dataset.classId === String(classId)));
      
      // Update selected class name for grade/score rules
      const selectedClass = enrolledClassesData.find(c => c.class_id == classId);
      const selectedClassNameEl = document.getElementById('selectedClassName');
      if (selectedClassNameEl) {
        selectedClassNameEl.textContent = selectedClass ? selectedClass.class_name : '';
      }
      
      // Load merged grade + score remark rules for this class.
      const classRows = scoreRemarksMap[String(classId)] || [];
      const gradeListEl = document.getElementById('classGradeMappings');
      if (!gradeListEl) {
        return;
      }

      const sortedRows = [...classRows].sort((a, b) => {
        const aTo = Number(a.to_percentage || 0);
        const bTo = Number(b.to_percentage || 0);
        if (bTo !== aTo) return bTo - aTo;
        return Number(b.from_percentage || 0) - Number(a.from_percentage || 0);
      });
      const mergedRuleRows = sortedRows.filter((r) => {
        const gradeText = String(r.grade_label || '').trim();
        const remarkText = String(r.remark || '').trim();
        return gradeText !== '' || (remarkText !== '' && remarkText !== 'No Remark');
      });
      const escAttr = (value) => String(value ?? '')
        .replace(/&/g, '&amp;')
        .replace(/"/g, '&quot;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;');
      if (mergedRuleRows.length === 0) {
        gradeListEl.innerHTML = '<p style="color:var(--muted);font-size:0.9rem;margin-top:10px;">No grade/remark rule saved for this class.</p>';
      } else {
        gradeListEl.innerHTML =
          '<div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(260px,1fr));gap:10px;">'
          + mergedRuleRows.map(row => `
          <div style="display:flex;justify-content:space-between;align-items:center;gap:8px;padding:10px 12px;border:1px solid #e0e0e0;border-radius:8px;background:#fff;">
            <div style="flex:1;min-width:0;">
              <div style="font-weight:700;color:var(--primary);margin-bottom:2px;">Grade: ${escAttr(String(row.grade_label || '').trim() || '-')}</div>
              <div style="font-size:0.84rem;color:#334155;margin-bottom:2px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">Remark: ${escAttr((String(row.remark || '').trim() && String(row.remark || '').trim() !== 'No Remark') ? row.remark : '-')}</div>
              <div style="font-size:0.85rem;color:var(--muted);white-space:nowrap;">${row.from_percentage}% - ${row.to_percentage}%</div>
            </div>
            ${(isRuleLocked('grade', classId, row.from_percentage, row.to_percentage)
              || isRuleLocked('remark', classId, row.from_percentage, row.to_percentage))
              ? getRuleLockBadgeHtml()
              : `
                <div class="kebab-menu" data-score-id="${row.id}" style="flex-shrink:0;">
                  <button type="button" class="kebab" aria-label="More actions" aria-expanded="false">⋮</button>
                  <ul>
                    <li>
                      <a href="javascript:void(0)"
                         class="edit-grade-rule"
                         data-id="${row.id}"
                         data-class-id="${classId}"
                         data-grade="${escAttr(row.grade_label)}"
                        data-remark="${escAttr(row.remark)}"
                         data-from="${row.from_percentage}"
                         data-to="${row.to_percentage}">Edit</a>
                    </li>
                    <li><a href="/print/deleteScoreRemark/${row.id}?classId=${classId}&termId=<%= termId %>" data-no-spa>Delete</a></li>
                  </ul>
                </div>
              `}
          </div>
        `).join('')
          + '</div>';
      }

      // Re-bind kebab menus for dynamically added rows
      [gradeListEl].forEach((container) => {
        container.querySelectorAll('.kebab-menu').forEach(menu => {
          const trigger = menu.querySelector('.kebab');
          trigger?.addEventListener('click', (e) => {
            e.stopPropagation();
            document.querySelectorAll('.kebab-menu').forEach(m => m.classList.remove('open'));
            menu.classList.toggle('open');
          });
        });

        container.querySelectorAll('.edit-grade-rule').forEach((link) => {
          link.addEventListener('click', (e) => {
            e.preventDefault();
            e.stopPropagation();
            const rowId = link.dataset.id;
            const classIdToEdit = link.dataset.classId;
            const grade = link.dataset.grade || '';
            const remark = link.dataset.remark || '';
            const fromPct = link.dataset.from || '';
            const toPct = link.dataset.to || '';

            editingGradeRowIdInput.value = rowId || '';
            if (editingGradeSourceClassIdInput) {
              editingGradeSourceClassIdInput.value = classIdToEdit || '';
            }
            renderGradeRuleRows([
              {
                gradeLabel: grade,
                remark,
                from: fromPct,
                to: toPct,
              },
            ], { allowMultiple: false });

            gradeClassCheckboxes.querySelectorAll('.score-class-checkbox').forEach(cb => {
              cb.checked = cb.value === String(classIdToEdit);
              cb.disabled = false;
            });
            syncSelectAllCheckboxState(selectAllGradeClasses, gradeClassCheckboxes);

            gradeFormContainer.style.display = 'block';
            if (toggleGradeFormLink) toggleGradeFormLink.textContent = 'Hide Form';
            saveGradeMappingBtn.textContent = 'Update Grade & Remark';
          });
        });
      });
      
      const data = statusSettingsMap[String(classId)];
      const noSettingsMsg = document.getElementById('noSettingsMsg');
      
      if(data){
        // Has settings - show overview, hide form
        noSettingsMsg.style.display = 'none';
        formContainer.style.display = 'none';
        overviewContainer.style.display = 'block';
        cancelBtn.style.display = 'none';

        activatePromotion.checked = !!data.activate_promotion;
        
        // Display current settings
        const promotedClassObj = enrolledClassesData.find(c => c.class_id === data.promoted_class);
        const repeatedClassObj = enrolledClassesData.find(c => c.class_id === data.repeated_class);
        
        currentSettingsDisplay.innerHTML = `
          <div class="status-overview-item">
            <div class="status-overview-item-label">Promoted Class</div>
            <div class="status-overview-item-value">${promotedClassObj ? promotedClassObj.class_name : '-'}</div>
          </div>
          <div class="status-overview-item">
            <div class="status-overview-item-label">Repeated Class</div>
            <div class="status-overview-item-value">${repeatedClassObj ? repeatedClassObj.class_name : '-'}</div>
          </div>
          <div class="status-overview-item">
            <div class="status-overview-item-label">Cut Off Point</div>
            <div class="status-overview-item-value">${data.cut_off_point || '-'}</div>
          </div>
          <div class="status-overview-item">
            <div class="status-overview-item-label">School Reopen Date</div>
            <div class="status-overview-item-value">${data.school_reopen_date ? (window.formatDisplayDate ? window.formatDisplayDate(data.school_reopen_date) : new Date(data.school_reopen_date).toLocaleDateString()) : '-'}</div>
          </div>
        `;
      } else {
        // No settings - show form, hide overview
        noSettingsMsg.style.display = 'block';
        formContainer.style.display = 'block';
        overviewContainer.style.display = 'none';
        cancelBtn.style.display = 'none';

        activatePromotion.checked = false;
      }

      // Reset the Advanced panel before re-rendering for the new class
      // (clears any stale DOM from the previously selected class)
      const _advPanel = document.getElementById('advancedDsPanel');
      if (_advPanel) {
        _advPanel.innerHTML = '';
        _advPanel.dataset.classId = '';
      }

      // Render the Advanced display settings panel for the selected class
      renderAdvancedDs(classId);
    }

    function openStatusRowsEditor() {
      formContainer.style.display = 'block';
      overviewContainer.style.display = 'none';
      cancelBtn.style.display = 'inline-flex';
      focusStatusRow(classIdField.value);
    }

    bulkStatusSettingsBtn?.addEventListener('click', (event) => {
      event.preventDefault();
      openStatusRowsEditor();
    });

    cancelBtn?.addEventListener('click', () => {
      const currentClassId = classIdField.value;
      loadClassSettings(currentClassId);
    });

    classButtons.forEach(btn => { btn.addEventListener('click', () => loadClassSettings(btn.dataset.classId)); });
    focusStatusRow(classIdField.value);
    captureStatusRowsInitialState();

    document.addEventListener('click', (event) => {
      if (event.target.closest('#statusDatePopup')) return;
      if (event.target.matches('input[name="statusRowSchoolReopenDate[]"]')) return;
      closeStatusDatePopup();
    });

    window.addEventListener('resize', () => {
      if (statusDatePopup?.classList.contains('is-open')) {
        positionStatusDatePopup(statusDatePopupAnchorInput);
      }
    });

    window.addEventListener('scroll', () => {
      if (statusDatePopup?.classList.contains('is-open')) {
        positionStatusDatePopup(statusDatePopupAnchorInput);
      }
    }, true);

    statusRowsEditor?.addEventListener('change', (event) => {
      const row = event.target.closest('.status-row-item');
      if (!row) return;
      if (!suppressStatusDateBulkPrompt && event.target.matches('input[name="statusRowSchoolReopenDate[]"]')) {
        const reopenDateValue = normalizeStatusInputDate(event.target.value);
        if (reopenDateValue) {
          openStatusDatePopup(row, reopenDateValue, event.target);
        } else {
          closeStatusDatePopup();
        }
      }
      syncStatusRowDirtyState(row);
    });

    statusDatePopup?.addEventListener('click', (event) => {
      const actionButton = event.target.closest('[data-status-date-action], [data-status-date-close]');
      if (!actionButton) return;

      // Popup actions only refill fields; they must never trigger form submit.
      event.preventDefault();
      event.stopPropagation();

      if (actionButton.hasAttribute('data-status-date-close')) {
        closeStatusDatePopup();
        return;
      }

      const row = statusDatePopupSourceRow;
      const reopenDateValue = statusDatePopupValue || normalizeStatusInputDate(row?.querySelector('input[name="statusRowSchoolReopenDate[]"]')?.value);
      const action = actionButton.getAttribute('data-status-date-action');
      const selectPanel = statusDatePopup.querySelector('[data-status-date-select-panel]');

      if (!row || !reopenDateValue) {
        closeStatusDatePopup();
        return;
      }

      if (action === 'select') {
        selectPanel?.classList.add('is-open');
        return;
      }

      if (action === 'cancel-select') {
        selectPanel?.classList.remove('is-open');
        return;
      }

      let appliedCount = 0;
      if (action === 'all') {
        appliedCount = applyStatusReopenDateToRows(row, reopenDateValue, { mode: 'all' });
      } else if (action === 'empty') {
        appliedCount = applyStatusReopenDateToRows(row, reopenDateValue, { mode: 'empty' });
      } else if (action === 'apply-selected') {
        const selectedClassIds = Array.from(statusDatePopup.querySelectorAll('[data-status-date-class-list] input[type="checkbox"]:checked'))
          .map((checkbox) => checkbox.value);
        if (!selectedClassIds.length) {
          alert('Select at least one class to apply this reopen date.');
          return;
        }
        appliedCount = applyStatusReopenDateToRows(row, reopenDateValue, { mode: 'selected', selectedClassIds });
      }

      closeStatusDatePopup();
      if (appliedCount > 0 && typeof showToast === 'function') {
        showToast(`Applied reopen date to ${appliedCount} class${appliedCount === 1 ? '' : 'es'}.`);
      }
    });

    statusRowsEditor?.addEventListener('input', (event) => {
      const row = event.target.closest('.status-row-item');
      if (!row) return;
      syncStatusRowDirtyState(row);
    });

    async function persistGradePresentationSelection(options = {}) {
      const forceShowNumberTotalOnReport = typeof options.forceShowNumberTotalOnReport === 'boolean'
        ? options.forceShowNumberTotalOnReport
        : null;
      const classId = classIdField.value;
      const classDs = allDisplaySettingsMap[String(classId)] || { columns: {}, sections: {} };
      const payload = getGradePresentationPayloadFromControls();
      if (forceShowNumberTotalOnReport !== null) {
        payload.showNumberTotalOnReport = forceShowNumberTotalOnReport;
      }
      const normalizedState = normalizeGradePresentationState(payload);
      logGradeNumericTotal('persist:start', {
        classId,
        mode: normalizedState.mode,
        showOnReport: normalizedState.showOnReport,
        totalScoreStrategy: normalizedState.totalScoreStrategy,
        forcedShowOnReport: forceShowNumberTotalOnReport,
      });
      applyGradePresentationStateToControls(normalizedState);
      classDs.sections = classDs.sections || {};
      classDs.sections.gradePresentation = normalizedState;
      allDisplaySettingsMap[String(classId)] = classDs;
      const savedOk = await saveAdvancedDisplaySettings(classId, {
        skipManualPaygiraValidation: true,
        gradePresentationOverride: normalizedState,
      });
      logGradeNumericTotal('persist:result', {
        classId,
        savedOk,
        showOnReport: normalizedState.showOnReport,
      });
      if (!savedOk) {
        console.warn('[GradeNumericTotal] Persist failed. UI changed locally but server save did not complete.', {
          classId,
          normalizedState,
        });
      }
      return savedOk;
    }

    function getCurrentGradePresentationState() {
      const classId = classIdField.value;
      const classDs = allDisplaySettingsMap[String(classId)] || {};
      const gradePresentation = (classDs.sections && classDs.sections.gradePresentation) || {};
      return normalizeGradePresentationState(gradePresentation);
    }

    function setGradeNumericAssignClassesOpen(isOpen) {
      const open = isOpen === true;
      if (toggleGradeNumericAssignClassesBtn) {
        toggleGradeNumericAssignClassesBtn.setAttribute('aria-expanded', open ? 'true' : 'false');
      }
      if (gradeNumericAssignClassesPanel) {
        gradeNumericAssignClassesPanel.style.display = open ? 'block' : 'none';
      }
    }

    async function handleShowGradeNumericTotalSelection(nextShow, options = {}) {
      const requireConfirm = options.requireConfirm === true;
      const previousState = getCurrentGradePresentationState();
      const previousShow = previousState.showOnReport === true;
      const normalizedNextShow = nextShow === true;

      logGradeNumericTotal('toggle:attempt', {
        classId: classIdField?.value,
        previousShow,
        nextShow: normalizedNextShow,
        requireConfirm,
      });

      if (normalizedNextShow === previousShow) {
        if (showGradeNumericTotalOnReport) {
          showGradeNumericTotalOnReport.checked = normalizedNextShow;
        }
        if (hideGradeNumericTotalOnReport) {
          hideGradeNumericTotalOnReport.checked = !normalizedNextShow;
        }
        syncShowGradeNumericTotalVisualState();
        return;
      }

      if (normalizedNextShow && requireConfirm) {
        const ok = confirmDestructiveAction('Enable number total on report? This will display Total Grade Score on each student report for this class.');
        logGradeNumericTotal('toggle:confirm', {
          classId: classIdField?.value,
          confirmed: ok,
        });
        if (!ok) {
          applyGradePresentationStateToControls(previousState);
          return;
        }
      }

      if (showGradeNumericTotalOnReport) {
        showGradeNumericTotalOnReport.checked = normalizedNextShow;
      }
      if (hideGradeNumericTotalOnReport) {
        hideGradeNumericTotalOnReport.checked = !normalizedNextShow;
      }

      syncShowGradeNumericTotalVisualState();
      syncGradeNumericConfigUI(getGradePresentationPayloadFromControls());
      const savedOk = await persistGradePresentationSelection({
        forceShowNumberTotalOnReport: normalizedNextShow,
      });

      if (normalizedNextShow && gradeNumericTotalConfigWrap) {
        gradeNumericTotalConfigWrap.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      }

      logGradeNumericTotal('toggle:applied', {
        classId: classIdField?.value,
        showOnReport: normalizedNextShow,
        savedOk,
      });

      if (normalizedNextShow) {
        if (savedOk) {
          window.alert('Saved successfully: Number total will be shown on report.');
        } else {
          window.alert('Save failed: Number total could not be enabled. Check console logs.');
        }
      }
    }

    openGradeNumericConfigBtn?.addEventListener('click', () => {
      openGradeNumericConfigModal();
    });

    closeGradeNumericConfigBtn?.addEventListener('click', () => {
      closeGradeNumericConfigModal();
    });

    closeGradeNumericConfigIcon?.addEventListener('click', () => {
      closeGradeNumericConfigModal();
    });

    gradeNumericConfigModal?.addEventListener('click', (event) => {
      if (event.target === gradeNumericConfigModal) {
        closeGradeNumericConfigModal();
      }
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && gradeNumericConfigModal && gradeNumericConfigModal.style.display === 'flex') {
        closeGradeNumericConfigModal();
      }
    });

    gradeDisplayModeSelect?.addEventListener('change', async () => {
      const prev = getCurrentGradePresentationState();
      const nextMode = (gradeDisplayModeSelect.value === 'numbers' || gradeDisplayModeSelect.value === 'both')
        ? gradeDisplayModeSelect.value
        : 'letters';
      if (nextMode === prev.mode) return;

      const ok = confirmDestructiveAction('Change Format? This will update how grades display on report for this class.');
      if (!ok) {
        applyGradePresentationStateToControls(prev);
        return;
      }

      await persistGradePresentationSelection();
      if (nextMode === 'numbers' || nextMode === 'both') {
        openGradeNumericConfigModal();
      } else {
        closeGradeNumericConfigModal();
      }
    });

    showGradeNumericTotalOnReport?.addEventListener('change', async () => {
      if (!showGradeNumericTotalOnReport.checked) return;
      await handleShowGradeNumericTotalSelection(true, { requireConfirm: true });
    });

    hideGradeNumericTotalOnReport?.addEventListener('change', async () => {
      if (!hideGradeNumericTotalOnReport.checked) return;
      await handleShowGradeNumericTotalSelection(false);
    });

    gradeNumericSelectAllClasses?.addEventListener('change', async () => {
      if (!gradeNumericClassCheckboxes) return;
