    // Unified grade + score remark rule form.
    const openGradeBulkPickerLink = document.getElementById('openGradeBulkPicker');
    const toggleGradeFormLink = document.getElementById('toggleGradeForm');
    const gradeFormContainer = document.getElementById('gradeFormContainer');
    const gradeForm = document.getElementById('gradeForm');
    const gradeClassCheckboxes = document.getElementById('gradeClassCheckboxes');
    const selectAllGradeClasses = document.getElementById('selectAllGradeClasses');
    const editingGradeRowIdInput = document.getElementById('editingGradeRowId');
    const editingGradeSourceClassIdInput = document.getElementById('editingGradeSourceClassId');
    const saveGradeMappingBtn = document.getElementById('saveGradeMappingBtn');
    const cancelGradeMappingBtn = document.getElementById('cancelGradeMappingBtn');
    const gradeRuleRowsEl = document.getElementById('gradeRuleRows');
    const gradeRuleRowTemplate = document.getElementById('gradeRuleRowTemplate');
    const addGradeRuleRowBtn = document.getElementById('addGradeRuleRowBtn');

    const enrolledClassesForScore = <%- JSON.stringify(enrolledClasses) %>;
    const sortedEnrolledClassesForScore = [...enrolledClassesForScore];
    const classOrderIndexById = new Map(
      sortedEnrolledClassesForScore.map((cls, idx) => [Number(cls.class_id), idx])
    );
    const sortClassesByArrangement = (classes) => [...(Array.isArray(classes) ? classes : [])]
      .sort((a, b) => {
        const aIndex = classOrderIndexById.get(Number(a.class_id));
        const bIndex = classOrderIndexById.get(Number(b.class_id));
        if (Number.isFinite(aIndex) && Number.isFinite(bIndex)) {
          return aIndex - bIndex;
        }
        if (Number.isFinite(aIndex)) return -1;
        if (Number.isFinite(bIndex)) return 1;
        return Number(a.class_id || 0) - Number(b.class_id || 0);
      });
    const classNameByIdMap = new Map(
      sortedEnrolledClassesForScore.map((cls) => [String(cls.class_id), String(cls.class_name || '').trim()])
    );
    let ruleSaveRequestInFlight = false;
    let gradeRuleRowCounter = 0;

    function createGradeRuleRowElement(rowState = {}, options = {}) {
      if (!gradeRuleRowTemplate) return null;
      const index = Number(options?.index || 0);
      const canRemove = options?.canRemove === true;

      const fragment = gradeRuleRowTemplate.content.cloneNode(true);
      const rowEl = fragment.querySelector('[data-role="grade-rule-row"]');
      if (!rowEl) return null;

      const rowId = String(rowState?.id || `grade-rule-${++gradeRuleRowCounter}`);
      rowEl.setAttribute('data-row-id', rowId);

      const titleEl = rowEl.querySelector('[data-role="grade-rule-title"]');
      if (titleEl) {
        titleEl.textContent = `Rule ${index + 1}`;
      }

      const gradeInput = rowEl.querySelector('[data-field="grade"]');
      const remarkInput = rowEl.querySelector('[data-field="remark"]');
      const fromInput = rowEl.querySelector('[data-field="from"]');
      const toInput = rowEl.querySelector('[data-field="to"]');
      const removeBtn = rowEl.querySelector('[data-role="remove-grade-rule-row"]');

      if (gradeInput) gradeInput.value = String(rowState?.gradeLabel || rowState?.grade || '');
      if (remarkInput) remarkInput.value = String(rowState?.remark || '');
      if (fromInput) fromInput.value = String(rowState?.from ?? '');
      if (toInput) toInput.value = String(rowState?.to ?? '');

      if (removeBtn) {
        removeBtn.style.visibility = canRemove ? 'visible' : 'hidden';
      }

      return rowEl;
    }

    function getGradeRuleRowElements() {
      if (!gradeRuleRowsEl) return [];
      return Array.from(gradeRuleRowsEl.querySelectorAll('[data-role="grade-rule-row"]'));
    }

    function getGradeRuleRowsState() {
      return getGradeRuleRowElements().map((rowEl) => {
        const id = String(rowEl.getAttribute('data-row-id') || '').trim();
        const gradeLabel = String(rowEl.querySelector('[data-field="grade"]')?.value || '').trim();
        const remark = String(rowEl.querySelector('[data-field="remark"]')?.value || '').trim();
        const from = String(rowEl.querySelector('[data-field="from"]')?.value || '').trim();
        const to = String(rowEl.querySelector('[data-field="to"]')?.value || '').trim();
        return {
          id,
          gradeLabel,
          remark,
          from,
          to,
        };
      });
    }

    function renderGradeRuleRows(rowsState = [], options = {}) {
      if (!gradeRuleRowsEl) return;
      const allowMultiple = options?.allowMultiple !== false;
      const safeRows = Array.isArray(rowsState) && rowsState.length
        ? rowsState
        : [{ gradeLabel: '', remark: '', from: '', to: '' }];

      gradeRuleRowsEl.innerHTML = '';
      safeRows.forEach((rowState, index) => {
        const rowEl = createGradeRuleRowElement(rowState, {
          index,
          canRemove: allowMultiple && safeRows.length > 1,
        });
        if (rowEl) {
          gradeRuleRowsEl.appendChild(rowEl);
        }
      });

      if (addGradeRuleRowBtn) {
        addGradeRuleRowBtn.disabled = !allowMultiple;
        addGradeRuleRowBtn.style.visibility = allowMultiple ? 'visible' : 'hidden';
      }
    }

    function getValidatedGradeRuleRows(options = {}) {
      const requireSingle = options?.requireSingle === true;
      const rowsState = getGradeRuleRowsState();
      if (!rowsState.length) {
        return { ok: false, rows: [], message: 'Add at least one rule row.' };
      }

      const seenRanges = [];
      const validatedRows = [];

      for (let index = 0; index < rowsState.length; index += 1) {
        const row = rowsState[index];
        const fromPct = Number(row.from);
        const toPct = Number(row.to);

        if (!row.gradeLabel) {
          return { ok: false, rows: [], message: `Rule ${index + 1}: grade label is required.` };
        }

        if (!row.remark) {
          return { ok: false, rows: [], message: `Rule ${index + 1}: score remark is required.` };
        }

        if (!Number.isFinite(fromPct) || !Number.isFinite(toPct) || fromPct > toPct) {
          return { ok: false, rows: [], message: `Rule ${index + 1}: provide a valid percentage range.` };
        }

        const rangeKey = buildRuleRangeKey(fromPct, toPct);
        if (rangeKey && seenRanges.some((range) => range.key === rangeKey)) {
          return { ok: false, rows: [], message: `Rule ${index + 1}: duplicate range ${fromPct}% - ${toPct}% detected.` };
        }

        if (seenRanges.some((range) => rangesOverlap(range.fromPct, range.toPct, fromPct, toPct))) {
          return { ok: false, rows: [], message: `Rule ${index + 1}: range ${fromPct}% - ${toPct}% overlaps another row.` };
        }

        seenRanges.push({ key: rangeKey, fromPct, toPct });

        validatedRows.push({
          id: row.id,
          gradeLabel: row.gradeLabel,
          remark: row.remark,
          fromPct,
          toPct,
        });
      }

      if (requireSingle && validatedRows.length !== 1) {
        return {
          ok: false,
          rows: [],
          message: 'Edit mode supports one rule row only. Remove extra rows or cancel edit.',
        };
      }

      return { ok: true, rows: validatedRows };
    }

    function rangesOverlap(fromA, toA, fromB, toB) {
      const aFrom = Number(fromA);
      const aTo = Number(toA);
      const bFrom = Number(fromB);
      const bTo = Number(toB);
      if (!Number.isFinite(aFrom) || !Number.isFinite(aTo) || !Number.isFinite(bFrom) || !Number.isFinite(bTo)) {
        return false;
      }
      return aFrom <= bTo && aTo >= bFrom;
    }

    function getScoreRowsForClass(classId) {
      const classKey = String(classId || '').trim();
      const classRows = classKey ? scoreRemarksMap[classKey] : null;
      return Array.isArray(classRows) ? classRows : [];
    }

    function isClassLockedForProposedRange(entryType, classId, fromValue, toValue) {
      const safeEntryType = normalizeRuleEntryType(entryType);
      const classKey = String(classId || '').trim();
      const fromPct = Number(fromValue);
      const toPct = Number(toValue);
      if (!classKey || !Number.isFinite(fromPct) || !Number.isFinite(toPct) || fromPct > toPct) {
        return false;
      }

      const classLocks = ruleLocksMap[safeEntryType] && ruleLocksMap[safeEntryType][classKey];
      if (!classLocks || typeof classLocks !== 'object') {
        return false;
      }

      return Object.entries(classLocks).some(([rangeKey, locked]) => {
        if (locked !== true) return false;
        const [lockFromRaw, lockToRaw] = String(rangeKey || '').split('__');
        const lockFrom = Number(lockFromRaw);
        const lockTo = Number(lockToRaw);
        if (!Number.isFinite(lockFrom) || !Number.isFinite(lockTo)) {
          return false;
        }
        return rangesOverlap(lockFrom, lockTo, fromPct, toPct);
      });
    }

    function buildLocalOverrideTargets(selectedClassIds, fromPct, toPct) {
      const uniqueClassIds = Array.isArray(selectedClassIds)
        ? [...new Set(selectedClassIds.map((classId) => String(classId || '').trim()).filter(Boolean))]
        : [];

      return uniqueClassIds
        .map((classId) => {
          const conflictingRows = getScoreRowsForClass(classId).filter((row) => (
            rangesOverlap(row?.from_percentage, row?.to_percentage, fromPct, toPct)
          ));

          if (!conflictingRows.length) {
            return null;
          }

          return {
            class_id: Number(classId),
            class_name: classNameByIdMap.get(classId) || `Class ${classId}`,
          };
        })
        .filter(Boolean);
    }

    const buildClassCheckboxMarkup = (prefix) => sortedEnrolledClassesForScore
      .map((cls) => {
        const classId = Number(cls.class_id);
        return `
          <div class="rs-class-select-row">
            <span style="display:flex;align-items:center;gap:8px;min-width:0;">
              <input type="checkbox" class="score-class-checkbox" value="${classId}" id="${prefix}-${classId}" />
              <label for="${prefix}-${classId}" style="cursor:pointer;margin:0;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">${escapeHtmlText(cls.class_name)}</label>
            </span>
          </div>
        `;
      }).join('');

    function renderRuleFormClassCheckboxes(containerEl, prefix, selectAllEl, preservedSelectionSet = null) {
      if (!containerEl) return;
      const currentSelection = preservedSelectionSet instanceof Set
        ? preservedSelectionSet
        : new Set(Array.from(containerEl.querySelectorAll('.score-class-checkbox:checked')).map((cb) => cb.value));

      containerEl.innerHTML = buildClassCheckboxMarkup(prefix);
      containerEl.querySelectorAll('.score-class-checkbox').forEach((cb) => {
        cb.checked = currentSelection.has(cb.value);
      });
      syncSelectAllCheckboxState(selectAllEl, containerEl);
    }

    renderRuleFormClassCheckboxes(gradeClassCheckboxes, 'grade-class', selectAllGradeClasses);
    renderGradeRuleRows();

    addGradeRuleRowBtn?.addEventListener('click', () => {
      if (editingGradeRowIdInput && editingGradeRowIdInput.value) {
        return;
      }
      const currentRows = getGradeRuleRowsState();
      currentRows.push({ gradeLabel: '', remark: '', from: '', to: '' });
      renderGradeRuleRows(currentRows, { allowMultiple: true });
    });

    gradeRuleRowsEl?.addEventListener('click', (event) => {
      const removeBtn = event.target.closest('[data-role="remove-grade-rule-row"]');
      if (!removeBtn) return;
      const rowEl = removeBtn.closest('[data-role="grade-rule-row"]');
      if (!rowEl) return;

      const rowId = String(rowEl.getAttribute('data-row-id') || '').trim();
      const currentRows = getGradeRuleRowsState();
      if (currentRows.length <= 1) {
        return;
      }

      const nextRows = currentRows.filter((row) => row.id !== rowId);
      renderGradeRuleRows(nextRows, {
        allowMultiple: !(editingGradeRowIdInput && editingGradeRowIdInput.value),
      });
    });

    function syncSelectAllCheckboxState(selectAllEl, containerEl) {
      if (!selectAllEl || !containerEl) return;
      const checkboxes = Array.from(containerEl.querySelectorAll('.score-class-checkbox'));
      const enabledCheckboxes = checkboxes.filter((cb) => !cb.disabled);

      if (!enabledCheckboxes.length) {
        selectAllEl.checked = false;
        selectAllEl.indeterminate = false;
        selectAllEl.disabled = true;
        return;
      }

      const checkedCount = enabledCheckboxes.filter((cb) => cb.checked).length;
      selectAllEl.disabled = false;
      selectAllEl.checked = checkedCount === enabledCheckboxes.length;
      selectAllEl.indeterminate = checkedCount > 0 && checkedCount < enabledCheckboxes.length;
    }

    function bindSelectAllClassCheckbox(selectAllEl, containerEl) {
      if (!selectAllEl || !containerEl) return;

      selectAllEl.addEventListener('change', () => {
        const shouldCheck = selectAllEl.checked === true;
        containerEl.querySelectorAll('.score-class-checkbox').forEach((cb) => {
          if (cb.disabled) return;
          cb.checked = shouldCheck;
        });
        syncSelectAllCheckboxState(selectAllEl, containerEl);
      });

      containerEl.addEventListener('change', (event) => {
        const checkbox = event.target;
        if (!checkbox || !checkbox.classList || !checkbox.classList.contains('score-class-checkbox')) {
          return;
        }
        syncSelectAllCheckboxState(selectAllEl, containerEl);
      });

      syncSelectAllCheckboxState(selectAllEl, containerEl);
    }

    bindSelectAllClassCheckbox(selectAllGradeClasses, gradeClassCheckboxes);

    function setCurrentClassAsDefaultChecked(containerEl, selectAllEl) {
      if (!containerEl) return;
      const currentClassId = classIdField.value;
      containerEl.querySelectorAll('.score-class-checkbox').forEach((cb) => {
        cb.disabled = false;
        cb.checked = cb.value === currentClassId;
      });
      syncSelectAllCheckboxState(selectAllEl, containerEl);
    }

    function showToast(message) {
      const successDiv = document.createElement('div');
      successDiv.style.cssText = 'position:fixed;top:20px;right:20px;background:#10b981;color:#fff;padding:12px 18px;border-radius:8px;box-shadow:0 10px 25px rgba(0,0,0,0.2);z-index:9999;';
      successDiv.textContent = message;
      document.body.appendChild(successDiv);
      setTimeout(() => successDiv.remove(), 3000);
    }

    function applyClassRowsMap(classRowsMap) {
      if (!classRowsMap || typeof classRowsMap !== 'object') return;
      Object.keys(classRowsMap).forEach((cid) => {
        const rows = Array.isArray(classRowsMap[cid]) ? classRowsMap[cid] : [];
        scoreRemarksMap[String(cid)] = rows;
        defaultsSuppressedMap[String(cid)] = rows.length === 0;
      });
    }

    function escapeHtmlText(value) {
      return String(value ?? '')
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#39;');
    }

    function promptOverrideDecision(entryType, overrideClasses, options = {}) {
      return new Promise((resolve) => {
        const classes = Array.isArray(overrideClasses) ? overrideClasses : [];
        const allowBypass = options?.allowBypass !== false;
        if (!classes.length) {
          resolve('continue');
          return;
        }

        const modal = document.createElement('div');
        modal.style.cssText = 'position:fixed;inset:0;background:rgba(0,0,0,0.45);display:flex;align-items:center;justify-content:center;z-index:10012;padding:16px;';
        const entryLabel = entryType === 'grade' ? 'grade mapping' : 'score remark';
        const classItems = classes
          .map((cls) => `<div>${escapeHtmlText(cls.class_name || `Class ${cls.class_id}`)}</div>`)
          .join('');

        modal.innerHTML = `
          <div class="rs-override-modal">
            <div style="display:flex;justify-content:space-between;align-items:center;gap:8px;margin-bottom:8px;">
              <div style="font-size:0.95rem;font-weight:700;color:#b45309;">Override Warning</div>
              <button type="button" data-action="close" class="btn btn-secondary">Cancel</button>
            </div>
            <div style="font-size:0.82rem;color:var(--muted);line-height:1.45;">
              You are overriding an existing or overlapping ${entryLabel} for these classes.
            </div>
            <div class="rs-override-list">${classItems}</div>
            <div class="rs-bulk-footer" style="margin-top:0;">
              ${allowBypass ? '<button type="button" data-action="bypass" class="btn btn-secondary">Bypass Existing</button>' : ''}
              <button type="button" data-action="continue" class="btn">Override</button>
            </div>
          </div>
        `;

        const close = (decision = null) => {
          modal.remove();
          resolve(decision);
        };

        modal.addEventListener('click', (event) => {
          if (event.target === modal) {
            close(null);
          }
        });

        modal.querySelector('[data-action="close"]')?.addEventListener('click', () => close(null));
        modal.querySelector('[data-action="bypass"]')?.addEventListener('click', () => close('bypass'));
        modal.querySelector('[data-action="continue"]')?.addEventListener('click', () => close('continue'));

        document.body.appendChild(modal);
      });
    }

    async function prepareRuleSaveRequest(entryType, selectedClasses, fromPct, toPct, editingRowId) {
      const normalizedSelectedClasses = Array.isArray(selectedClasses)
        ? selectedClasses.map((classId) => String(classId || '').trim()).filter(Boolean)
        : [];

      if (editingRowId) {
        return {
          cancelled: false,
          cancelReason: null,
          selectedClasses: normalizedSelectedClasses,
          action: undefined,
          bypassOverrideClassIds: undefined,
          lockedSkippedCount: 0,
        };
      }

      const selectedUnlockedClasses = normalizedSelectedClasses.filter((classId) => (
        !isClassLockedForProposedRange(entryType, classId, fromPct, toPct)
      ));

      const lockedSkippedCount = normalizedSelectedClasses.length - selectedUnlockedClasses.length;
      if (!selectedUnlockedClasses.length) {
        return {
          cancelled: true,
          cancelReason: 'locked',
          selectedClasses: [],
          action: undefined,
          bypassOverrideClassIds: undefined,
          lockedSkippedCount,
        };
      }

      const overrideTargets = buildLocalOverrideTargets(selectedUnlockedClasses, fromPct, toPct);

      let bypassOverrideClassIds = [];
      if (overrideTargets.length) {
        const decision = await promptOverrideDecision(entryType, overrideTargets, { allowBypass: false });
        if (!decision) {
          return {
            cancelled: true,
            cancelReason: 'cancelled',
            selectedClasses: selectedUnlockedClasses,
            action: undefined,
            bypassOverrideClassIds: undefined,
            lockedSkippedCount,
          };
        }
        if (decision === 'bypass') {
          bypassOverrideClassIds = overrideTargets.map((cls) => String(cls.class_id));
        }
      }

      return {
        cancelled: false,
        cancelReason: null,
        selectedClasses: selectedUnlockedClasses,
        action: 'bulkUpsert',
        bypassOverrideClassIds,
        lockedSkippedCount,
      };
    }

    openGradeBulkPickerLink?.addEventListener('click', (event) => {
      event.preventDefault();
      event.stopPropagation();
      if (!gradeFormContainer) return;
      const isVisible = gradeFormContainer.style.display !== 'none';
      gradeFormContainer.style.display = isVisible ? 'none' : 'block';
      if (!isVisible) {
        gradeForm.reset();
        resetGradeEditMode();
        setCurrentClassAsDefaultChecked(gradeClassCheckboxes, selectAllGradeClasses);
      } else {
        gradeForm.reset();
        resetGradeEditMode();
        renderRuleFormClassCheckboxes(gradeClassCheckboxes, 'grade-class', selectAllGradeClasses, new Set());
