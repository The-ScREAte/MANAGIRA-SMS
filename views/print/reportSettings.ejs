        ? `<div class="ds-master-off-banner" style="display:flex;align-items:center;gap:5px;margin-bottom:5px;padding:4px 8px;font-size:11px;color:#b91c1c;font-weight:600;background:#fef2f2;border:1px solid #fecaca;border-radius:6px;">${_dsXIcon} Column disabled — all excluded</div>`
        : '';
      const itemsHtml = items.map(a => {
