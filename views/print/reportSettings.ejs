    function closeAllKebabMenus() {
      document.querySelectorAll('.kebab-menu.open').forEach((menu) => {
        menu.classList.remove('open');
        const trigger = menu.querySelector('.kebab');
        if (trigger) {
          trigger.setAttribute('aria-expanded', 'false');
        }
      });
    }

    document.addEventListener('click', (event) => {
      const trigger = event.target.closest('.kebab-menu .kebab');
      if (trigger) {
        event.preventDefault();
        event.stopPropagation();
        const menu = trigger.closest('.kebab-menu');
        const wasOpen = menu?.classList.contains('open');
        closeAllKebabMenus();
        if (menu && !wasOpen) {
          menu.classList.add('open');
          trigger.setAttribute('aria-expanded', 'true');
        }
        return;
      }

      if (!event.target.closest('.kebab-menu')) {
        closeAllKebabMenus();
      }
    });

    // Loading overlay helpers
    let loadingOverlayActiveCount = 0;
    function showLoading() {
      const overlay = document.getElementById('loadingOverlay');
      if (!overlay) return;
      loadingOverlayActiveCount += 1;
      overlay.classList.add('active');
    }
    function hideLoading() {
      const overlay = document.getElementById('loadingOverlay');
      if (!overlay) return;
      loadingOverlayActiveCount = Math.max(0, loadingOverlayActiveCount - 1);
      if (loadingOverlayActiveCount === 0) {
        overlay.classList.remove('active');
      }
    }

