    function toggleAdvancedDsPanel() {
      const panel = document.getElementById('advancedDsPanel');
      const arrow = document.getElementById('advancedDsArrow');
      if (!panel) return;
      const isOpen = panel.style.display !== 'none';
      panel.style.display = isOpen ? 'none' : 'block';
      if (arrow) arrow.style.transform = isOpen ? '' : 'rotate(180deg)';
    }
    window.toggleAdvancedDsPanel = toggleAdvancedDsPanel;

    function dsEsc(str) {
      return String(str).replace(/&/g,'&amp;').replace(/"/g,'&quot;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
    }

    function buildPaygiraApplyClassesHtml(rowId, selectedClassIds, currentClassId) {
      const selected = new Set((Array.isArray(selectedClassIds) ? selectedClassIds : [])
        .map((id) => parseInt(id, 10))
        .filter((id) => Number.isFinite(id) && id > 0));
      if (Number.isFinite(parseInt(currentClassId, 10))) {
        selected.add(parseInt(currentClassId, 10));
      }

      const nonCurrentClasses = enrolledClassesForScore.filter((cls) => String(cls.class_id) !== String(currentClassId));
      const allClassesChecked = nonCurrentClasses.length > 0
        && nonCurrentClasses.every((cls) => selected.has(Number(cls.class_id)));

      const selectAllHtml = `<label class="paygira-apply-class" for="paygira-apply-all-${rowId}" style="font-weight:700;color:#0f172a;">
            <input type="checkbox" class="ds-paygira-apply-all" id="paygira-apply-all-${rowId}" style="accent-color:var(--primary);" ${allClassesChecked ? 'checked' : ''}>
            <span>All classes</span>
          </label>`;

      return selectAllHtml + enrolledClassesForScore
        .slice()
        .sort((a, b) => {
          const aIndex = classOrderIndexById.get(Number(a.class_id));
          const bIndex = classOrderIndexById.get(Number(b.class_id));
          if (Number.isFinite(aIndex) && Number.isFinite(bIndex)) {
            return aIndex - bIndex;
          }
          if (Number.isFinite(aIndex)) return -1;
          if (Number.isFinite(bIndex)) return 1;
          return Number(a.class_id || 0) - Number(b.class_id || 0);
        })
        .map((cls) => {
          const classIdNum = Number(cls.class_id);
          const checked = selected.has(classIdNum);
          const isCurrent = String(classIdNum) === String(currentClassId);
          const inputId = `paygira-apply-${rowId}-${classIdNum}`;
          return `<label class="paygira-apply-class" for="${inputId}">
            <input type="checkbox" class="ds-paygira-apply-class" id="${inputId}" value="${classIdNum}" style="accent-color:var(--primary);" ${checked ? 'checked' : ''} ${isCurrent ? 'disabled' : ''}>
            <span>${dsEsc(cls.class_name)}${isCurrent ? ' (current)' : ''}</span>
          </label>`;
        })
        .join('');
    }

    const _dsXIcon = '<svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink:0"><circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/></svg>';

    function buildMasterGroupHtml(cat, label, items, masterOn, itemsState) {
      if (items.length === 0) {
        return `<div class="ds-adv-group"><div class="ds-adv-masterrow" style="border-radius:7px;cursor:default;">
