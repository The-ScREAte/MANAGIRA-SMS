          </label>
        </div>`;

      const paygiraBills = ds.sections.paygiraBills || {};
      const paygiraEnabled = paygiraBills.enabled === true;
      const paygiraMode = paygiraBills.mode === 'manual' ? 'manual' : 'auto';
      const paygiraAuto = paygiraBills.auto || {};
      const paygiraMetrics = paygiraAuto.metrics || {};
      const paygiraScope = paygiraAuto.scope === 'future' ? 'future' : 'past';
      const paygiraFuture = paygiraAuto.future || {};
      const paygiraFutureAction = paygiraFuture.action === 'custom' ? 'custom' : 'create';
      const paygiraFutureBillName = dsEsc(paygiraFuture.billName || '');
      const paygiraManual = paygiraBills.manual || {};
      const paygiraManualFields = Array.isArray(paygiraManual.fields) ? paygiraManual.fields : [];
      const paygiraManualTotals = Array.isArray(paygiraManual.totals) ? paygiraManual.totals : [];
      const paygiraAutoMetrics = [
