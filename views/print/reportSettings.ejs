  <% if (!setupRequired) { %>
  <script>
    document.getElementById('add-remark-btn')?.addEventListener('click', () => {
      const container = document.getElementById('remarks-container');
      const div = document.createElement('div');
      div.className = 'form-group remark-item';
      div.innerHTML = `
        <textarea name="remarks[]" required maxlength="150" placeholder="Enter remark (max 150 characters)"></textarea>
        <div class="form-group">
          <label>Select Remark Type:</label>
          <select name="remarkType[]" required>
            <option value="teacher">Teacher's Remark</option>
            <option value="conduct">Conduct Remark</option>
            <option value="interest">Interest Remark</option>
            <option value="attitude">Attitude Remark</option>
          </select>
        </div>`;
      container.appendChild(div);
    });

    const statusSettingsMap = {};
    <% groupedStatusSettings.forEach(function(setting){ %>
      <% setting.classes.forEach(function(cid){ %>
        statusSettingsMap['<%= cid %>'] = <%- JSON.stringify(setting) %>;
      <% }); %>
    <% }); %>

    const scoreRemarksMap = {};
    <% const allScoreRemarks = JSON.parse(JSON.stringify(scoreRemarks)); %>
    <% allScoreRemarks.forEach(function(remark){ %>
      if(!scoreRemarksMap['<%= remark.class_id %>']) scoreRemarksMap['<%= remark.class_id %>'] = [];
      scoreRemarksMap['<%= remark.class_id %>'].push(<%- JSON.stringify(remark) %>);
    <% }); %>

    // ---- Display Settings data (must be defined before loadClassSettings is called) ----
    const allDisplaySettingsMap = <%- JSON.stringify(allDisplaySettingsMap) %>;
    const allAssessmentsByCategoryMap = <%- JSON.stringify(allAssessmentsByCategoryMap) %>;

    const classButtons = document.querySelectorAll('.class-button');
    const promotedSelect = document.getElementById('promotedClassSelect');
    const repeatedSelect = document.getElementById('repeatedClassSelect');
    const cutOffInput = document.getElementById('cutOffPoint');
    const activatePromotion = document.getElementById('activatePromotion');
    const reopenDate = document.getElementById('schoolReopenDate');
    const classIdField = document.getElementById('statusClassId');
    const selectedStatusClasses = document.getElementById('selectedStatusClasses');

    const formContainer = document.getElementById('settingsFormContainer');
    const overviewContainer = document.getElementById('settingsOverviewContainer');
    const modifyBtn = document.getElementById('modifySettingsBtn');
    const cancelBtn = document.getElementById('cancelEditBtn');
    const currentSettingsDisplay = document.getElementById('currentSettingsDisplay');

    function loadClassSettings(classId){
      classIdField.value = classId;
      selectedStatusClasses.value = classId;
      classButtons.forEach(btn => btn.classList.toggle('active', btn.dataset.classId === String(classId)));
      
      // Update selected class name for score remarks
      const enrolledClasses = <%- JSON.stringify(enrolledClasses) %>;
      const selectedClass = enrolledClasses.find(c => c.class_id == classId);
      document.getElementById('selectedClassName').textContent = selectedClass ? selectedClass.class_name : '';
      
      // Load score remarks for this class
      const classScoreRemarks = scoreRemarksMap[String(classId)] || [];
      const remarksListEl = document.getElementById('classScoreRemarks');
      if(classScoreRemarks.length === 0){
        remarksListEl.innerHTML = '<p style="color:var(--muted);font-size:0.9rem;margin-top:10px;">No score remarks saved for this class yet.</p>';
      } else {
        remarksListEl.innerHTML = '<div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:10px;">' + classScoreRemarks.map(remark => `
          <div style="display:flex;justify-content:space-between;align-items:center;gap:8px;padding:10px 12px;border:1px solid #e0e0e0;border-radius:8px;background:#fff;">
            <div style="flex:1;min-width:0;">
              <div style="font-weight:600;color:var(--primary);margin-bottom:2px;">${remark.remark}</div>
              <div style="font-size:0.85rem;color:var(--muted);white-space:nowrap;">${remark.from_percentage}% - ${remark.to_percentage}%</div>
            </div>
            <div class="kebab-menu" data-score-id="${remark.id}" style="flex-shrink:0;">
              <div class="kebab" aria-label="More actions">⋮</div>
              <ul>
                <li><a href="/print/deleteScoreRemark/${remark.id}?classId=${classId}&termId=<%= termId %>" data-no-spa>Delete</a></li>
              </ul>
            </div>
          </div>
        `).join('') + '</div>';
        
        // Re-bind kebab menus for dynamically added remarks
        remarksListEl.querySelectorAll('.kebab-menu').forEach(menu => {
          const trigger = menu.querySelector('.kebab');
          trigger?.addEventListener('click', (e) => {
            e.stopPropagation();
            document.querySelectorAll('.kebab-menu').forEach(m => m.classList.remove('open'));
            menu.classList.toggle('open');
          });
        });
      }
      
      const data = statusSettingsMap[String(classId)];
      const noSettingsMsg = document.getElementById('noSettingsMsg');
      
      if(data){
        // Has settings - show overview, hide form
        noSettingsMsg.style.display = 'none';
        formContainer.style.display = 'none';
        overviewContainer.style.display = 'block';
        cancelBtn.style.display = 'none';
        
        // Populate form fields (hidden but ready for edit)
        promotedSelect.value = data.promoted_class || '';
        repeatedSelect.value = data.repeated_class || '';
        cutOffInput.value = data.cut_off_point || '';
        activatePromotion.checked = !!data.activate_promotion;
        reopenDate.value = data.school_reopen_date ? new Date(data.school_reopen_date).toISOString().split('T')[0] : '';
        
        // Display current settings
        const enrolledClasses = <%- JSON.stringify(enrolledClasses) %>;
        const promotedClassObj = enrolledClasses.find(c => c.class_id === data.promoted_class);
        const repeatedClassObj = enrolledClasses.find(c => c.class_id === data.repeated_class);
        
        currentSettingsDisplay.innerHTML = `
          <div style="padding:10px;background:#f8fafc;border-radius:8px;">
            <div style="font-size:0.85rem;color:var(--muted);margin-bottom:4px;">Promoted Class</div>
            <div style="font-weight:600;color:var(--primary);">${promotedClassObj ? promotedClassObj.class_name : '-'}</div>
          </div>
          <div style="padding:10px;background:#f8fafc;border-radius:8px;">
            <div style="font-size:0.85rem;color:var(--muted);margin-bottom:4px;">Repeated Class</div>
            <div style="font-weight:600;color:var(--primary);">${repeatedClassObj ? repeatedClassObj.class_name : '-'}</div>
          </div>
          <div style="padding:10px;background:#f8fafc;border-radius:8px;">
            <div style="font-size:0.85rem;color:var(--muted);margin-bottom:4px;">Cut Off Point</div>
            <div style="font-weight:600;color:var(--primary);">${data.cut_off_point || '-'}</div>
          </div>
          <div style="padding:10px;background:#f8fafc;border-radius:8px;">
            <div style="font-size:0.85rem;color:var(--muted);margin-bottom:4px;">School Reopen Date</div>
            <div style="font-weight:600;color:var(--primary);">${data.school_reopen_date ? new Date(data.school_reopen_date).toLocaleDateString() : '-'}</div>
          </div>
        `;
      } else {
        // No settings - show form, hide overview
        noSettingsMsg.style.display = 'block';
        formContainer.style.display = 'block';
        overviewContainer.style.display = 'none';
        cancelBtn.style.display = 'none';
        
        promotedSelect.value = '';
        repeatedSelect.value = '';
        cutOffInput.value = '';
        activatePromotion.checked = false;
        reopenDate.value = '';
      }

      // Reset the Advanced panel before re-rendering for the new class
      // (clears any stale DOM from the previously selected class)
      const _advPanel = document.getElementById('advancedDsPanel');
      if (_advPanel) {
        _advPanel.innerHTML = '';
        _advPanel.dataset.classId = '';
      }

      // Render the Advanced display settings panel for the selected class
      renderAdvancedDs(classId);
    }

    modifyBtn?.addEventListener('click', () => {
      formContainer.style.display = 'block';
      overviewContainer.style.display = 'none';
      cancelBtn.style.display = 'inline-flex';
    });

    cancelBtn?.addEventListener('click', () => {
      const currentClassId = classIdField.value;
      loadClassSettings(currentClassId);
    });

    classButtons.forEach(btn => { btn.addEventListener('click', () => loadClassSettings(btn.dataset.classId)); });
    if(classButtons.length){ loadClassSettings(classIdField.value || classButtons[0].dataset.classId); }

    // Score Remark Form Toggle and AJAX
    const toggleFormLink = document.getElementById('toggleScoreRemarkForm');
    const scoreFormContainer = document.getElementById('scoreRemarkFormContainer');
    const scoreRemarkForm = document.getElementById('scoreRemarkForm');
    const scoreClassCheckboxes = document.getElementById('scoreClassCheckboxes');
    
    // Populate class checkboxes
    const enrolledClassesForScore = <%- JSON.stringify(enrolledClasses) %>;
    scoreClassCheckboxes.innerHTML = enrolledClassesForScore.sort((a,b) => a.class_id - b.class_id).map(cls => `
      <div style="display:flex;align-items:center;gap:8px;">
        <input type="checkbox" class="score-class-checkbox" value="${cls.class_id}" id="score-ajax-${cls.class_id}" />
        <label for="score-ajax-${cls.class_id}" style="cursor:pointer;margin:0;">${cls.class_name}</label>
      </div>
    `).join('');
    
    toggleFormLink?.addEventListener('click', () => {
      const isVisible = scoreFormContainer.style.display !== 'none';
      scoreFormContainer.style.display = isVisible ? 'none' : 'block';
      toggleFormLink.textContent = isVisible ? '+ Add Remarks' : '− Hide Form';
      
      // Check the current class by default and reset form
      if(!isVisible){
        const currentClassId = classIdField.value;
        document.querySelectorAll('.score-class-checkbox').forEach(cb => {
          cb.checked = cb.value === currentClassId;
        });
      } else {
        scoreRemarkForm.reset();
      }
    });
    
    scoreRemarkForm?.addEventListener('submit', async (e) => {
      e.preventDefault();
      
      const remark = document.getElementById('scoreRemarkText').value.trim();
      const fromPct = document.getElementById('scoreFromPct').value;
      const toPct = document.getElementById('scoreToPct').value;
      const selectedClasses = Array.from(document.querySelectorAll('.score-class-checkbox:checked')).map(cb => cb.value);
      const termId = '<%= termId %>';
      
      if(!selectedClasses.length){
        alert('Please select at least one class.');
        return;
      }
      
      if(!remark){
        alert('Please enter a remark.');
        return;
      }
      
      try {
        const response = await fetch('/print/saveScoreRemarksAjax', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            remark,
            from_percentage: fromPct,
            to_percentage: toPct,
            termId,
            selectedClasses
          })
        });
        
        const result = await response.json();
        
        if(result.success){
          // Update the scoreRemarksMap with new data
          result.savedRemarks.forEach(rem => {
            if(!scoreRemarksMap[String(rem.class_id)]) scoreRemarksMap[String(rem.class_id)] = [];
            // Check if remark already exists, update or add
            const existingIdx = scoreRemarksMap[String(rem.class_id)].findIndex(r => r.id === rem.id);
            if(existingIdx >= 0){
              scoreRemarksMap[String(rem.class_id)][existingIdx] = rem;
            } else {
              scoreRemarksMap[String(rem.class_id)].push(rem);
            }
          });
          
          // Reload current class remarks
          loadClassSettings(classIdField.value);
          
          // Reset form and hide
          scoreRemarkForm.reset();
          scoreFormContainer.style.display = 'none';
          toggleFormLink.textContent = '+ Add Remarks';
          
          // Show success message
          const successDiv = document.createElement('div');
          successDiv.style.cssText = 'position:fixed;top:20px;right:20px;background:#10b981;color:#fff;padding:12px 18px;border-radius:8px;box-shadow:0 10px 25px rgba(0,0,0,0.2);z-index:9999;';
          successDiv.textContent = 'Score remark saved successfully!';
          document.body.appendChild(successDiv);
          setTimeout(() => successDiv.remove(), 3000);
        } else {
          alert(result.message || 'Failed to save score remark.');
        }
      } catch(error){
        console.error('Error saving score remark:', error);
        alert('An error occurred while saving.');
      }
    });

    // Canvas signature
    const signatureFormContainer = document.getElementById('signatureFormContainer');
    const toggleSigFormLink = document.getElementById('toggleSignatureForm');

    function createSignaturePad(canvasId) {
      let canvas = null;
      let ctx = null;
      let initialized = false;
      let drawing = false;
      let pointerId = null;
      let currentStroke = [];
      let strokes = [];
      let hasInk = false;
      let resizeRaf = null;

      const baseStroke = 2.4;
      const minStroke = 1.1;
      const maxStroke = 3.8;

      function getCanvas() {
        if (!canvas) {
          canvas = document.getElementById(canvasId);
        }
        return canvas;
      }

      function getContext() {
        if (!ctx && getCanvas()) {
          ctx = canvas.getContext('2d');
        }
        return ctx;
      }

      function setCanvasSize() {
        const targetCanvas = getCanvas();
        const targetCtx = getContext();
        if (!targetCanvas || !targetCtx) return;

        const rect = targetCanvas.getBoundingClientRect();
        const ratio = Math.max(window.devicePixelRatio || 1, 1);
        targetCanvas.width = Math.max(1, Math.round(rect.width * ratio));
        targetCanvas.height = Math.max(1, Math.round(rect.height * ratio));
        targetCtx.setTransform(ratio, 0, 0, ratio, 0, 0);
        targetCtx.clearRect(0, 0, rect.width, rect.height);
        targetCtx.strokeStyle = '#0f172a';
        targetCtx.lineCap = 'round';
        targetCtx.lineJoin = 'round';
      }

      function distance(pointA, pointB) {
        const dx = pointB.x - pointA.x;
        const dy = pointB.y - pointA.y;
        return Math.hypot(dx, dy);
      }

      function midpoint(pointA, pointB) {
        return {
          x: (pointA.x + pointB.x) / 2,
          y: (pointA.y + pointB.y) / 2,
        };
      }

      function computeLineWidth(previousPoint, currentPoint) {
        if (!previousPoint) {
          return baseStroke;
        }

        const speed = distance(previousPoint, currentPoint) / Math.max(currentPoint.time - previousPoint.time, 1);
        const pressure = currentPoint.pressure && currentPoint.pressure > 0 ? currentPoint.pressure : 0.5;
        const velocityFactor = Math.max(0.45, 1.55 - speed * 2.2);
        const width = baseStroke * velocityFactor * (0.75 + pressure * 0.35);
        return Math.max(minStroke, Math.min(maxStroke, width));
      }

      function drawDot(point) {
        const targetCtx = getContext();
        if (!targetCtx) return;

        const radius = Math.max(minStroke, computeLineWidth(null, point)) / 2;
        targetCtx.beginPath();
        targetCtx.fillStyle = '#0f172a';
        targetCtx.arc(point.x, point.y, radius, 0, Math.PI * 2);
        targetCtx.fill();
      }

      function drawStroke(stroke) {
        const targetCtx = getContext();
        if (!targetCtx || !stroke.length) return;

        if (stroke.length === 1) {
          drawDot(stroke[0]);
          return;
        }

        for (let index = 1; index < stroke.length; index += 1) {
          const previousPoint = stroke[index - 1];
          const currentPoint = stroke[index];
          const previousMidpoint = index === 1 ? previousPoint : midpoint(stroke[index - 2], previousPoint);
          const currentMidpoint = midpoint(previousPoint, currentPoint);

          targetCtx.beginPath();
          targetCtx.lineWidth = computeLineWidth(previousPoint, currentPoint);
          targetCtx.moveTo(previousMidpoint.x, previousMidpoint.y);
          targetCtx.quadraticCurveTo(previousPoint.x, previousPoint.y, currentMidpoint.x, currentMidpoint.y);
          targetCtx.stroke();
        }
      }

      function redraw() {
        const targetCanvas = getCanvas();
        const targetCtx = getContext();
        if (!targetCanvas || !targetCtx) return;

        setCanvasSize();
        strokes.forEach(drawStroke);
      }

      function getRelativePoint(event) {
        const targetCanvas = getCanvas();
        if (!targetCanvas) return null;

        const rect = targetCanvas.getBoundingClientRect();
        return {
          x: event.clientX - rect.left,
          y: event.clientY - rect.top,
          time: performance.now(),
          pressure: typeof event.pressure === 'number' ? event.pressure : 0.5,
        };
      }

      function beginStroke(event) {
        const targetCanvas = getCanvas();
        if (!targetCanvas) return;

        event.preventDefault();
        const point = getRelativePoint(event);
        if (!point) return;

        drawing = true;
        pointerId = event.pointerId;
        currentStroke = [point];
        hasInk = true;
        targetCanvas.setPointerCapture?.(event.pointerId);
        drawDot(point);
      }

      function extendStroke(event) {
        if (!drawing || event.pointerId !== pointerId) return;

        event.preventDefault();
        const point = getRelativePoint(event);
        if (!point) return;

        const previousPoint = currentStroke[currentStroke.length - 1];
        if (previousPoint && distance(previousPoint, point) < 0.35) {
          return;
        }

        currentStroke.push(point);
        drawStroke(currentStroke.slice(-3));
      }

      function endStroke(event) {
        if (!drawing || event.pointerId !== pointerId) return;

        event.preventDefault();
        const targetCanvas = getCanvas();
        drawing = false;
        pointerId = null;

        if (currentStroke.length) {
          strokes.push([...currentStroke]);
        }
        currentStroke = [];

        targetCanvas?.releasePointerCapture?.(event.pointerId);
      }

      function clear() {
        strokes = [];
        currentStroke = [];
        hasInk = false;
        const targetCanvas = getCanvas();
        const targetCtx = getContext();
        if (!targetCanvas || !targetCtx) return;
        const rect = targetCanvas.getBoundingClientRect();
        targetCtx.clearRect(0, 0, rect.width, rect.height);
      }

      function exportTrimmedBlob() {
        const targetCanvas = getCanvas();
        if (!targetCanvas || !hasInk) {
          return Promise.resolve(null);
        }

        const sourceCtx = targetCanvas.getContext('2d');
        const imageData = sourceCtx.getImageData(0, 0, targetCanvas.width, targetCanvas.height);
        const { data, width, height } = imageData;

        let top = height;
        let left = width;
        let right = 0;
        let bottom = 0;

        for (let y = 0; y < height; y += 1) {
          for (let x = 0; x < width; x += 1) {
            const alpha = data[(y * width + x) * 4 + 3];
            if (alpha > 0) {
              if (x < left) left = x;
              if (x > right) right = x;
              if (y < top) top = y;
              if (y > bottom) bottom = y;
            }
          }
        }

        if (right <= left || bottom <= top) {
          return Promise.resolve(null);
        }

        const padding = Math.ceil((window.devicePixelRatio || 1) * 12);
        const cropLeft = Math.max(0, left - padding);
        const cropTop = Math.max(0, top - padding);
        const cropRight = Math.min(width, right + padding);
        const cropBottom = Math.min(height, bottom + padding);
        const cropWidth = cropRight - cropLeft;
        const cropHeight = cropBottom - cropTop;

        const exportCanvas = document.createElement('canvas');
        exportCanvas.width = cropWidth;
        exportCanvas.height = cropHeight;
        exportCanvas
          .getContext('2d')
          .putImageData(sourceCtx.getImageData(cropLeft, cropTop, cropWidth, cropHeight), 0, 0);

        return new Promise((resolve) => {
          exportCanvas.toBlob((blob) => resolve(blob), 'image/png');
        });
      }

      function init() {
        if (initialized) return;
        const targetCanvas = getCanvas();
        if (!targetCanvas) return;

        setCanvasSize();
        targetCanvas.addEventListener('pointerdown', beginStroke);
        targetCanvas.addEventListener('pointermove', extendStroke);
        targetCanvas.addEventListener('pointerup', endStroke);
        targetCanvas.addEventListener('pointerleave', endStroke);
        targetCanvas.addEventListener('pointercancel', endStroke);

        window.addEventListener('resize', () => {
          if (resizeRaf) {
            cancelAnimationFrame(resizeRaf);
          }
          resizeRaf = requestAnimationFrame(redraw);
        });

        initialized = true;
      }

      return {
        init,
        clear,
        hasInk: () => hasInk,
        exportTrimmedBlob,
      };
    }

