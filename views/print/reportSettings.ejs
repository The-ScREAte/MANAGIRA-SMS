<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Report Settings</title>

    <style>
      :root {
        --font-family: "Inter", sans-serif;
      }

      body {
        font-family: var(--font-family);
        margin: 0;
        background-color: #f4f7fa;
        color: #222;
      }
      .container {
        display: flex;
        flex-wrap: wrap;
        gap: 32px;
        padding: 32px 16px 16px 16px;
        max-width: 1400px;
        margin: 0 auto;
      }
      h2, h3 {
        color: #01535b;
        text-align: left;
        margin-top: 0;
        margin-bottom: 18px;
        font-weight: 700;
      }
      .form-group {
        margin-bottom: 18px;
      }
      .form-group label {
        display: inline-block;
        font-weight: 600;
        margin-bottom: 6px;
        color: #01535b;
      }
      .form-group input:not([type="checkbox"]):not([type="radio"]),
      .form-group textarea,
      .form-group select {
        width: 100%;
        padding: 10px;
        margin-top: 5px;
        border: 1px solid #cfd8dc;
        border-radius: 4px;
        background: #fff;
        font-size: 1rem;
        box-sizing: border-box;
        transition: border 0.2s;
      }
      .form-group input:focus,
      .form-group textarea:focus,
      .form-group select:focus {
        border: 1.5px solid #01535b;
        outline: none;
      }
      .table-responsive {
        overflow-x: auto;
        -webkit-overflow-scrolling: touch;
      }
      .table-responsive table {
        min-width: 900px;
        background: #fff;
        border-radius: 8px;
        box-shadow: 0 2px 8px rgba(1,83,91,0.06);
      }
      .btn {
        padding: 10px 22px;
        background-color: #01535b;
        color: #fff;
        border: none;
        cursor: pointer;
        border-radius: 5px;
        font-size: 1rem;
        font-weight: 600;
        transition: background 0.2s;
      }
      .btn:hover {
        background-color: #01363d;
      }
      .btn-danger {
        background: #e74c3c;
        color: #fff;
        margin-left: 10px;
      }
      .btn-danger:hover {
        background: #c0392b;
      }
      .notice {
        background-color: #e7f3fe;
        color: #0c5460;
        border: 1px solid #bee5eb;
        border-radius: 5px;
        padding: 15px 20px;
        margin-bottom: 24px;
      }
      .notice h2 {
        font-size: 18px;
        margin: 0 0 10px;
        font-weight: bold;
      }
      .remarks-list div {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 10px 12px;
        background-color: #f9f9f9;
        border: 1px solid #e0e0e0;
        border-radius: 4px;
        margin-bottom: 8px;
      }
      .remarks-list h2 {
        color: #01535b;
        font-size: 1.1rem;
        margin-top: 18px;
      }
      .remarks-list a {
        color: #e74c3c;
        text-decoration: none;
        font-weight: 600;
      }
      .remarks-list a:hover {
        text-decoration: underline;
      }
      .form-section {
        flex: 1 1 420px;
        background: #fff;
        border-radius: 8px;
        box-shadow: 0 2px 8px rgba(1,83,91,0.06);
        padding: 24px 28px 18px 28px;
        margin-bottom: 24px;
      }
      .signature-section {
        margin-top: 40px;
      }
      img {
        max-width: 100%;
        height: auto;
        border-radius: 4px;
        box-shadow: 0 1px 4px rgba(1,83,91,0.08);
      }
      .form-checkbox-group {
        display: flex;
        align-items: center;
        margin-bottom: 7px;
        flex-wrap: wrap;
      }
      .form-checkbox-group label {
        flex: none;
        margin-right: 10px;
        font-weight: 500;
      }
      .form-checkbox-group input[type="checkbox"],
      .form-checkbox-group input[type="radio"] {
        flex: none;
        margin: 0 6px 0 0;
      }
      table {
        width: 100%;
        border-collapse: collapse;
        background: #fff;
        border-radius: 8px;
        overflow: hidden;
      }
      th, td {
        padding: 12px 10px;
        text-align: left;
        border: 1px solid #e0e0e0;
      }
      th {
        background: #f4f7fa;
        font-weight: 700;
        color: #01535b;
      }
      .table-wrapper {
        overflow-x: auto;
        margin-bottom: 30px;
      }
      .signature-group-section {
        margin-top: 32px;
      }
      .signature-group {
        background: #f9f9f9;
        border: 1px solid #e0e0e0;
        border-radius: 6px;
        padding: 16px 18px;
        margin-bottom: 18px;
        display: flex;
        align-items: flex-start;
        gap: 24px;
      }
      .signature-group img {
        max-width: 90px;
        margin-right: 18px;
      }
      .signature-group ul {
        margin: 0;
        padding-left: 18px;
      }
      .signature-group li {
        margin-bottom: 4px;
      }
      @media (max-width: 900px) {
        .container {
          flex-direction: column;
          padding: 10px;
        }
        .form-section {
          width: 100%;
          padding: 18px 8px 12px 8px;
        }
        .signature-group {
          flex-direction: column;
          gap: 10px;
        }
        .table-responsive table {
          min-width: 600px;
        }
      }
      @media (max-width: 600px) {
        .container {
          padding: 4px;
        }
        .form-section {
          padding: 8px 2px 8px 2px;
        }
        th, td {
          padding: 7px 4px;
        }
      }
    </style>
  </head>

  <body>
    <%- include('../partials/flash') %>

    <div class="link-to-next-back">
      <a
        href="/print/printStudentReport?classId=<%= classId %>&termId=<%= termId %>"
        class="btn btn-primary"
        >Back</a
      >
    </div>
    <hr />

    <% 
    const currentClass = enrolledClasses.find(function(c) { return c.class_id == classId; }); 
  %>
  <h2>
    Report Settings for <%= currentClass ? currentClass.class_name : "Unknown Class" %>
  </h2>
  

    <div class="container">
      <form action="/print/savePromotionSettings" method="POST">
        <input type="hidden" name="classId" value="<%= classId %>" />
        <input type="hidden" name="termId" value="<%= termId %>" />

        <h2>Status Settings</h2>

        <div class="notice">
          <h2>Notice:</h2>
          <p>
            These are class specifics and will be applied only to the selected
            class at the end of the form for this term. You can also set for different class
            on this page.
          </p>
        </div>

        <div class="form-group">
          <label for="promotedClass">Promoted Class:</label>
          <select name="promotedClass">
            <% [...enrolledClasses].sort((a, b) => a.class_id -
            b.class_id).forEach(classItem => { %>
            <option value="<%= classItem.class_id %>">
              <%= classItem.class_name %>
            </option>
            <% }) %>
          </select>
        </div>

        <div class="form-group">
          <label for="repeatedClass">Repeated Class:</label>
          <select name="repeatedClass">
            <% [...enrolledClasses].sort((a, b) => a.class_id -
            b.class_id).forEach(classItem => { %>
            <option value="<%= classItem.class_id %>">
              <%= classItem.class_name %>
            </option>
            <% }) %>
          </select>
        </div>

        <div class="form-group">
          <label for="cutOffPoint">Cut Off Point:</label>
          <input type="number" name="cutOffPoint" id="cutOffPoint" value="" />
        </div>

        <div class="form-group form-checkbox-group">
          <label for="activatePromotion">Activate Promotion</label>
          <input
            type="checkbox"
            id="activatePromotion"
            name="activatePromotion"
          />
        </div>

        <div class="form-group">
          <label for="schoolReopenDate">School Reopen Date:</label>
          <input
            type="date"
            name="schoolReopenDate"
            id="schoolReopenDate"
            value=""
          />
        </div>

        <div class="form-group">
          <label for="applyToClasses">Apply Status Settings To:</label>
          <% [...enrolledClasses].sort((a, b) => a.class_id -
          b.class_id).forEach(classItem => { %>
          <div class="form-checkbox-group">
            <label for="class-<%= classItem.class_id %>"
              ><%= classItem.class_name %></label
            >
            <input
              type="radio"
              name="selectedStatusClasses"
              class="selectedStatusClasses"
              value="<%= classItem.class_id %>"
            />
          </div>
          <% }) %>
        </div>

        <button type="submit" class="btn">Save Status Settings</button>

        <h3>Saved Status Settings Overview</h3>
        <div class="notice">
          <p>
            This section shows all status details saved for all classes under the selected term. 
            It’s designed to save you time by avoiding the need to toggle between pages. 
            You can also create settings for other classes on this page and assign them 
            directly using the Status Settings section.    
          </p>
        </div>
        <div class="table-responsive">
          <table
            border="1"
            cellspacing="0"
            cellpadding="10"
            style="width: 100%; min-width: 800px"
          >
            <thead>
              <tr>
                <th>Promoted Class</th>
                <th>Repeated Class</th>
                <th>Promotion</th>
                <th>Cutoff Point</th>
                <th>Reopen Date</th>
                <th>Classes Assigned</th>
                <th>Actions</th>
              </tr>
            </thead>
            <tbody id="status-settings-table-body">
              <% groupedStatusSettings.forEach(function(setting) { %>
                <%
                  const promotedClassObj = enrolledClasses.find(function(c) { return c.class_id === setting.promoted_class; });
                  const repeatedClassObj = enrolledClasses.find(function(c) { return c.class_id === setting.repeated_class; });
                  const promotedClassName = promotedClassObj ? promotedClassObj.class_name : '-';
                  const repeatedClassName = repeatedClassObj ? repeatedClassObj.class_name : '-';
                %>
                <tr>
                  <td><%= promotedClassName %></td>
                  <td><%= repeatedClassName %></td>
                  <td><%= setting.activate_promotion ? 'Yes' : 'No' %></td>
                  <td><%= setting.cut_off_point %></td>
                  <td>
                    <%= setting.school_reopen_date ? new Date(setting.school_reopen_date).toISOString().split('T')[0] : '-' %>
                  </td>
                  <td>
                    <ul>
                      <% [...setting.classes].sort(function(a, b) { return a - b; }).forEach(function(classId) { %>
                        <li>
                          <%
                            const classObj = enrolledClasses.find(function(c) { return c.class_id === classId; });
                          %>
                          <%= classObj ? classObj.class_name : '-' %>
                        </li>
                      <% }); %>
                    </ul>
                  </td>
                  <td>
                    <a
                      class="btn"
                      href="/print/modifyStatusSettings?classId=<%= setting.classes[0] %>&termId=<%= termId %>"
                    >
                      Modify
                    </a>
                  </td>
                </tr>
              <% }); %>
            </tbody>
          
          </table>
        </div>
      </form>

      <form
        action="/print/saveRemarks?classId=<%= classId %>&termId=<%= termId %>"
        method="POST"
      >
        <h2>Add Remarks</h2>
        <div class="notice">
          <h2>Notice:</h2>
          <p>
            These remarks will be applied globally So it could be used for all
            Terms and classes. A good example could be (Teacher Remarks : Needs
            more attention, Conduct Remarks : Professional. etc.)
          </p>
        </div>
        <div id="remarks-container">
          <div class="form-group remark-item">
            <textarea name="remarks[]" required></textarea>
            <div class="form-group">
              <label for="remarkType">Select Remark Type:</label>
              <select name="remarkType[]" required>
                <option value="teacher">Teacher's Remark</option>
                <option value="conduct">Conduct Remark</option>
                <option value="interest">Interest Remark</option>
                <option value="attitude">Attitude Remark</option>
              </select>
            </div>
          </div>
        </div>
        <button type="button" class="btn" id="add-remark-btn">+</button>
        <button type="submit" class="btn">Save Remarks</button>
        <hr />

        <!-- Display saved remarks grouped by type -->
        <div class="remarks-list">
          <% if (remarks.some(function(r) { return r.remark_type === 'teacher'; })) { %>
            <h2>Teacher's Remarks</h2>
            <% remarks.filter(function(r) { return r.remark_type === 'teacher'; }).forEach(function(remark) { %>
              <div>
                <span><%= remark.remark %></span>
                <a
                  href="/print/deleteRemark/<%= remark.id %>?classId=<%= classId %>&termId=<%= termId %>"
                  class="btn btn-danger"
                >Delete</a>
              </div>
            <% }); %>
          <% } %>
        
          <% if (remarks.some(function(r) { return r.remark_type === 'conduct'; })) { %>
            <h2>Conduct Remarks</h2>
            <% remarks.filter(function(r) { return r.remark_type === 'conduct'; }).forEach(function(remark) { %>
              <div>
                <span><%= remark.remark %></span>
                <a
                  href="/print/deleteRemark/<%= remark.id %>?classId=<%= classId %>&termId=<%= termId %>"
                  class="btn btn-danger"
                >Delete</a>
              </div>
            <% }); %>
          <% } %>
        
          <% if (remarks.some(function(r) { return r.remark_type === 'interest'; })) { %>
            <h2>Interest Remarks</h2>
            <% remarks.filter(function(r) { return r.remark_type === 'interest'; }).forEach(function(remark) { %>
              <div>
                <span><%= remark.remark %></span>
                <a
                  href="/print/deleteRemark/<%= remark.id %>?classId=<%= classId %>&termId=<%= termId %>"
                  class="btn btn-danger"
                >Delete</a>
              </div>
            <% }); %>
          <% } %>
        
          <% if (remarks.some(function(r) { return r.remark_type === 'attitude'; })) { %>
            <h2>Attitude Remarks</h2>
            <% remarks.filter(function(r) { return r.remark_type === 'attitude'; }).forEach(function(remark) { %>
              <div>
                <span><%= remark.remark %></span>
                <a
                  href="/print/deleteRemark/<%= remark.id %>?classId=<%= classId %>&termId=<%= termId %>"
                  class="btn btn-danger"
                >Delete</a>
              </div>
            <% }); %>
          <% } %>
        </div>
        </form>
        
      <form action="/print/saveScoreRemarks" method="POST">
        <div class="form-section">
          <!-- Include termId and classId as hidden inputs -->
          <input type="hidden" name="termId" value="<%= termId %>" />
          <input type="hidden" name="classId" value="<%= classId %>" />

          <h2>Score Remarks</h2>
          <div class="notice">
            <h2>Notice:</h2>
            <p>
              These remarks will be applied globally So it could be used for all
              Terms and classes. Example could be (excelent : 80- 100, Good :
              65-79)
            </p>
          </div>
          <div class="form-group">
            <label for="remark">Remark:</label>
            <input type="text" name="remark" id="remark" required />
          </div>
          <div class="form-group">
            <label for="from_percentage">From Percentage:</label>
            <input
              type="number"
              name="from_percentage"
              id="from_percentage"
              required
              min="0"
              max="100"
            />
          </div>
          <div class="form-group">
            <label for="to_percentage">To Percentage:</label>
            <input
              type="number"
              name="to_percentage"
              id="to_percentage"
              required
              min="0"
              max="100"
            />
          </div>
          <button type="submit" class="btn">Save Score Remark</button>
          <br />
          <hr />

          <!-- Display saved score remarks -->
          <div class="remarks-list">
            <% scoreRemarks.forEach((remark) => { %>
            <div>
              <span
                ><%= remark.remark %> (From: <%= remark.from_percentage %>% To:
                <%= remark.to_percentage %>%)</span
              >
              <a
                href="/print/deleteScoreRemark/<%= remark.id %>?classId=<%= classId %>&termId=<%= termId %>"
                class="btn btn-danger"
                >Delete</a
              >
            </div>
            <% }); %>
          </div>
        </div>
      </form>

      <!-- Signature Image Section -->
      <form
        action="/print/uploadSignatureImage"
        method="POST"
        enctype="multipart/form-data"
      >
        <div class="form-section signature-section">
          <input type="hidden" name="termId" value="<%= termId %>" />
          <input type="hidden" name="classId" value="<%= classId %>" />

          <h2>Signature Image</h2>
          <div class="notice">
            <h2>Notice:</h2>
            <p>
              This is class-specific and will be applied only to the selected
              classes below.
            </p>
          </div>

          <% if (signatureImageUrl) { %>
          <div>
            <img
              src="<%= signatureImageUrl %>"
              alt="Current Signature"
              style="max-width: 100px; display: block; margin-bottom: 10px"
            />
            <a
              href="#"
              class="btn btn-danger"
              id="delete-image-btn"
              data-class-id="<%= classId %>"
              data-term-id="<%= termId %>"
              data-url="/print/deleteSignatureImage"
            >
              Delete Signature Image
            </a>
          </div>
          <% } else { %>
          <p>No signature uploaded.</p>
          <% } %>

          <div class="form-group">
            <input
              type="file"
              name="signatureImage"
              accept="image/*"
              required
            />
          </div>

          <div class="form-group">
            <label for="applyToClasses">Apply Signature Image To:</label>
            <% [...availableClasses].sort((a, b) => a.class_id -
            b.class_id).forEach(classItem => { %>
            <div class="form-checkbox-group">
              <label for="class-<%= classItem.class_id %>"
                ><%= classItem.class_name %></label
              >
              <input
                type="checkbox"
                name="selectedSignatureClasses"
                class="selectedSignatureClasses"
                value="<%= classItem.class_id %>"
              />
            </div>
            <% }) %>
          </div>

          <button type="submit" class="btn">Upload Signature Image</button>
          <hr />

          <!-- Display grouped signature images with assigned classes -->
          <div class="form-section signature-group-section">
            <h2>Classes with Signature Applied:</h2>
            <% Object.keys(signatureGroups).forEach(signaturePath => { %>
            <div class="signature-group">
              <img
                src="<%= signatureGroups[signaturePath].signature_image_url %>"
                alt="Signature Image"
                style="max-width: 100px; display: block; margin-bottom: 10px"
              />
              <p>Assigned to Classes:</p>
              <ul>
                <% signatureGroups[signaturePath].classes .sort((a, b) =>
                a.class_id - b.class_id) .forEach(classInfo => { %>
                <li>
                  <a
                    href="/print/reportSettings?classId=<%= classInfo.class_id %>&termId=<%= termId %>"
                  >
                    <%= classInfo.class_name %>
                  </a>
                </li>
                <% }) %>
              </ul>
            </div>
            <% }) %>
          </div>
        </div>
      </form>

      <script>
        document
          .getElementById("delete-image-btn")
          ?.addEventListener("click", function (event) {
            event.preventDefault();

            // First confirmation for general deletion
            const confirmation = confirm(
              "This will remove the signature image from the current class. Are you sure?"
            );
            if (!confirmation) {
              return; // Prevent deletion if user cancels
            }

            // Show custom confirmation to delete for all classes or just one
            const deleteForAll = confirm(
              'Do you want to delete this signature for all classes it is assigned to?\n\nClick "OK" for "Yes, delete for all classes"\nClick "Cancel" for "No, delete only for this class"'
            );

            const deleteUrl = `${this.dataset.url}?classId=${encodeURIComponent(this.dataset.classId)}&termId=${encodeURIComponent(this.dataset.termId)}&deleteAll=${deleteForAll}`;
            window.location.href = deleteUrl;
          });

        document
          .getElementById("add-remark-btn")
          .addEventListener("click", function () {
            const container = document.getElementById("remarks-container");
            const newInput = document.createElement("div");
            newInput.className = "form-group remark-item";
            newInput.innerHTML = `
            <textarea name="remarks[]" required></textarea>
            <div class="form-group">
                <label for="remarkType">Select Remark Type:</label>
                <select name="remarkType[]" required>
                    <option value="teacher">Teacher's Remark</option>
                    <option value="conduct">Conduct Remark</option>
                    <option value="interest">Interest Remark</option>
                    <option value="attitude">Attitude Remark</option>
                </select>
            </div>`;
            container.appendChild(newInput);
          });


                </script>
    </div>
  </body>
</html>
