<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= title %></title>
    <style>
      :root {
        --font-family: "<%= (session && session.fontStyle ? String(session.fontStyle).trim() : 'Inter') %>", sans-serif;
        --primary: var(--org-primary-color, #01535b);
        --primary-hover: var(--org-primary-hover, #013a40);
      }

      * { box-sizing: border-box; margin: 0; padding: 0; }

      body {
        font-family: var(--font-family);
        background: #f0f2f5;
        color: #1e293b;
        padding: 20px;
      }

      /* Top controls bar */
      .transcript-controls {
        max-width: 900px;
        margin: 0 auto 20px;
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
        justify-content: center;
      }

      .ctrl-btn {
        padding: 10px 24px;
        font-size: 14px;
        font-weight: 600;
        border-radius: 8px;
        border: none;
        cursor: pointer;
        transition: all 0.2s;
        display: inline-flex;
        align-items: center;
        gap: 6px;
      }

      .ctrl-btn-print {
        background: var(--primary);
        color: white;
      }

      .ctrl-btn-print:hover {
        background: var(--primary-hover);
        transform: translateY(-1px);
      }

      .ctrl-btn-back {
        background: white;
        color: #334155;
        border: 1px solid #e2e8f0;
      }

      .ctrl-btn-back:hover { background: #f1f5f9; }

      /* ===== TRANSCRIPT DOCUMENT ===== */
      .transcript {
        max-width: 900px;
        margin: 0 auto;
        background: #fff;
        padding: 0;
        border-radius: 0;
        border: none;
        box-shadow: 0 8px 40px rgba(0,0,0,0.12);
        position: relative;
        overflow: hidden;
      }

      /* Decorative top border */
      .transcript-border-top {
        height: 6px;
        background: linear-gradient(90deg, var(--primary), var(--primary-hover), var(--primary));
      }

      /* Watermark */
      .transcript::before {
        content: "";
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        width: 450px;
        height: 450px;
        background-image: url("<%= session.logo %>");
        background-repeat: no-repeat;
        background-position: center;
        background-size: contain;
        opacity: 0.04;
        z-index: 0;
        pointer-events: none;
      }

      .transcript-content {
        position: relative;
        z-index: 1;
        padding: 40px 48px;
      }

      /* Header */
      .t-header {
        text-align: center;
        padding-bottom: 24px;
        margin-bottom: 28px;
        border-bottom: 3px double var(--primary);
      }

      .t-header img {
        width: 72px;
        height: 72px;
        object-fit: contain;
        margin-bottom: 12px;
      }

      .t-header h1 {
        font-size: 24px;
        font-weight: 800;
        color: var(--primary);
        letter-spacing: 1px;
        text-transform: uppercase;
        margin-bottom: 4px;
      }

      .t-header .t-subtitle {
        font-size: 16px;
        font-weight: 700;
        color: #475569;
        letter-spacing: 3px;
        text-transform: uppercase;
        margin: 8px 0;
      }

      .t-header .t-contact {
        font-size: 12px;
        color: #64748b;
        margin-top: 6px;
        line-height: 1.6;
      }

      /* Student Info */
      .t-student-info {
        margin-bottom: 28px;
        padding: 20px;
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        border-radius: 8px;
        border-left: 4px solid var(--primary);
      }

      .t-student-info h2 {
        font-size: 14px;
        font-weight: 700;
        color: var(--primary);
        text-transform: uppercase;
        letter-spacing: 1px;
        margin-bottom: 14px;
        padding-bottom: 8px;
        border-bottom: 1px solid #e2e8f0;
      }

      .t-student-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 8px 24px;
      }

      .t-student-grid p {
        font-size: 13px;
        color: #334155;
        margin: 0;
        line-height: 1.6;
      }

      .t-student-grid strong {
        color: #0f172a;
        font-weight: 700;
      }

      /* Academic Info */
      .t-academic h2 {
        font-size: 14px;
        font-weight: 700;
        color: var(--primary);
        text-transform: uppercase;
        letter-spacing: 1px;
        margin-bottom: 20px;
        padding-bottom: 8px;
        border-bottom: 2px solid var(--primary);
      }

      .t-year-section {
        margin-bottom: 28px;
      }

      .t-year-section h3 {
        font-size: 15px;
        font-weight: 700;
        color: #0f172a;
        padding: 10px 16px;
        background: linear-gradient(135deg, #f8fafc, #f1f5f9);
        border-left: 4px solid var(--primary);
        border-radius: 0 6px 6px 0;
        margin-bottom: 16px;
      }

      .t-term-section {
        margin-bottom: 20px;
      }

      .t-term-section h4 {
        font-size: 13px;
        font-weight: 700;
        color: #475569;
        padding: 6px 0 6px 14px;
        border-left: 3px solid var(--primary);
        margin-bottom: 10px;
        text-transform: uppercase;
        letter-spacing: 0.5px;
      }

      /* Table */
      .t-table {
        width: 100%;
        border-collapse: collapse;
        margin-bottom: 16px;
        font-size: 13px;
      }

      .t-table th {
        background: var(--primary);
        color: white;
        padding: 10px 14px;
        text-align: left;
        font-size: 11px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.5px;
      }

      .t-table th:first-child { border-radius: 6px 0 0 0; }
      .t-table th:last-child { border-radius: 0 6px 0 0; }

      .t-table td {
        padding: 9px 14px;
        border-bottom: 1px solid #f1f5f9;
        color: #334155;
      }

      .t-table tr:nth-child(even) td {
        background: #fafbfc;
      }

      .t-table tr:last-child td {
        border-bottom: 2px solid var(--primary);
      }

      /* Signature Section */
      .t-signature-area {
        margin-top: 40px;
        display: flex;
        justify-content: flex-end;
      }

      .t-signature-block {
        text-align: center;
        min-width: 220px;
      }

      .t-signature-img {
        max-width: 160px;
        height: auto;
        display: block;
        margin: 0 auto 6px;
      }

      .t-signature-line {
        width: 200px;
        border-bottom: 2px solid #1e293b;
        margin: 0 auto 6px;
      }

      .t-signature-label {
        font-size: 12px;
        color: #64748b;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.5px;
      }

      /* Footer */
      .t-footer {
        text-align: center;
        margin-top: 36px;
        padding-top: 16px;
        border-top: 2px solid #e2e8f0;
      }

      .t-footer p {
        font-size: 11px;
        color: #94a3b8;
        margin: 2px 0;
      }

      /* Decorative bottom border */
      .transcript-border-bottom {
        height: 6px;
        background: linear-gradient(90deg, var(--primary), var(--primary-hover), var(--primary));
      }

      /* ===== SIGNATURE TOOLS (hidden on print) ===== */
      .sig-tools {
        max-width: 900px;
        margin: 24px auto 0;
        background: white;
        border: 1px solid #e2e8f0;
        border-radius: 12px;
        padding: 24px;
        box-shadow: 0 2px 12px rgba(0,0,0,0.06);
      }

      .sig-tools h3 {
        font-size: 16px;
        font-weight: 700;
        color: #1e293b;
        margin: 0 0 16px;
      }

      .sig-tabs {
        display: flex;
        gap: 0;
        margin-bottom: 20px;
        border: 1px solid #e2e8f0;
        border-radius: 8px;
        overflow: hidden;
      }

      .sig-tab {
        flex: 1;
        padding: 10px;
        text-align: center;
        font-size: 13px;
        font-weight: 600;
        cursor: pointer;
        background: #f8fafc;
        color: #64748b;
        border: none;
        transition: all 0.2s;
      }

      .sig-tab.active {
        background: var(--primary);
        color: white;
      }

      .sig-tab:hover:not(.active) {
        background: #e2e8f0;
      }

      .sig-panel {
        display: none;
      }

      .sig-panel.active {
        display: block;
      }

      /* Upload panel */
      .sig-upload-form {
        display: flex;
        align-items: center;
        gap: 12px;
        flex-wrap: wrap;
      }

      .sig-upload-form input[type="file"] {
        font-size: 13px;
      }

      .sig-upload-btn {
        padding: 8px 20px;
        font-size: 13px;
        font-weight: 600;
        border-radius: 6px;
        background: var(--primary);
        color: white;
        border: none;
        cursor: pointer;
        transition: all 0.2s;
      }

      .sig-upload-btn:hover {
        background: var(--primary-hover);
      }

      /* Draw panel */
      .sig-canvas-wrapper {
        border: 2px solid #e2e8f0;
        border-radius: 8px;
        overflow: hidden;
        margin-bottom: 12px;
        background: white;
      }

      .sig-canvas {
        display: block;
        width: 100%;
        height: 150px;
        cursor: crosshair;
        touch-action: none;
      }

      .sig-canvas-actions {
        display: flex;
        gap: 8px;
      }

      .sig-clear-btn {
        padding: 8px 20px;
        font-size: 13px;
        font-weight: 600;
        border-radius: 6px;
        background: #f1f5f9;
        color: #475569;
        border: 1px solid #e2e8f0;
        cursor: pointer;
        transition: all 0.2s;
      }

      .sig-clear-btn:hover { background: #e2e8f0; }

      .sig-save-btn {
        padding: 8px 20px;
        font-size: 13px;
        font-weight: 600;
        border-radius: 6px;
        background: var(--primary);
        color: white;
        border: none;
        cursor: pointer;
        transition: all 0.2s;
      }

      .sig-save-btn:hover { background: var(--primary-hover); }

      .sig-status {
        font-size: 13px;
        color: #10b981;
        font-weight: 600;
        margin-top: 8px;
        display: none;
      }

      /* ===== PRINT STYLES ===== */
      @media print {
        @page {
          size: A4 portrait;
          margin: 10mm;
        }

        body {
          background: white;
          padding: 0;
          margin: 0;
        }

        .transcript-controls,
        .sig-tools {
          display: none !important;
        }

        .transcript {
          box-shadow: none;
          margin: 0;
          max-width: 100%;
        }

        .transcript-content {
          padding: 20px 24px;
        }

        .transcript::before {
          opacity: 0.06 !important;
        }

        .t-table th {
          background: #e2e8f0 !important;
          color: #0f172a !important;
          -webkit-print-color-adjust: exact;
          print-color-adjust: exact;
        }

        .t-year-section {
          page-break-inside: avoid;
        }

        .t-term-section {
          page-break-inside: avoid;
        }

        .t-footer {
          page-break-after: avoid;
        }

        .transcript-border-top,
        .transcript-border-bottom {
          -webkit-print-color-adjust: exact;
          print-color-adjust: exact;
        }
      }
    </style>
  </head>
  <body>
    <!-- Controls -->
    <div class="transcript-controls">
      <button class="ctrl-btn ctrl-btn-print" onclick="window.print()">🖨️ Print Transcript</button>
      <button class="ctrl-btn ctrl-btn-back" onclick="history.back()">← Back</button>
    </div>

    <!-- Transcript Document -->
    <div class="transcript">
      <div class="transcript-border-top"></div>
      <div class="transcript-content">

        <!-- Header -->
        <div class="t-header">
          <% if (session.logo) { %>
            <img src="<%= session.logo %>" alt="School Logo" />
          <% } %>
          <h1><%= organization.organization_name %></h1>
          <div class="t-subtitle">Official Academic Transcript</div>
          <div class="t-contact">
            <%= organization.organization_address %><br>
            Email: <%= organization.email %> &nbsp;|&nbsp; Phone: <%= organization.organization_phone %>
          </div>
        </div>

        <!-- Student Information -->
        <div class="t-student-info">
          <h2>Student Information</h2>
          <div class="t-student-grid">
            <p><strong>Full Name:</strong> <%= student.first_name %> <%= student.last_name %></p>
            <p><strong>Date of Birth:</strong> <%= new Date(student.date_of_birth).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' }) %></p>
            <p><strong>Gender:</strong> <%= student.gender %></p>
            <p><strong>Hometown:</strong> <%= student.hometown %></p>
            <p><strong>Current Class:</strong> <%= student.class_name %></p>
            <p><strong>Graduation Group:</strong> <%= student.graduation_year_group %></p>
          </div>
        </div>

        <!-- Academic Records -->
        <div class="t-academic">
          <h2>Academic Records</h2>

          <% const groupedScores = {}; %>
          <% scores.forEach(score => { %>
            <% if (!groupedScores[score.year_label]) groupedScores[score.year_label] = {}; %>
            <% if (!groupedScores[score.year_label][score.term_name]) groupedScores[score.year_label][score.term_name] = []; %>
            <% groupedScores[score.year_label][score.term_name].push(score); %>
          <% }); %>

          <% Object.keys(groupedScores).forEach(year => { %>
            <div class="t-year-section">
              <h3>Academic Year: <%= year %></h3>
              <% Object.keys(groupedScores[year]).forEach(term => { %>
                <div class="t-term-section">
                  <h4><%= term %></h4>
                  <table class="t-table">
                    <thead>
                      <tr>
                        <th>Subject</th>
                        <th>Percentage (%)</th>
                        <th>Grade</th>
                      </tr>
                    </thead>
                    <tbody>
                      <% groupedScores[year][term].forEach(score => { %>
                        <tr>
                          <td><%= score.subject_name %></td>
                          <td><%= score.total_percentage %></td>
                          <td><%= score.grade %></td>
                        </tr>
                      <% }); %>
                    </tbody>
                  </table>
                </div>
              <% }); %>
            </div>
          <% }); %>
        </div>

        <!-- Signature -->
        <div class="t-signature-area">
          <div class="t-signature-block">
            <% if (signatureImageUrl) { %>
              <img src="<%= signatureImageUrl %>" alt="Signature" class="t-signature-img" />
            <% } else { %>
              <div class="t-signature-line"></div>
            <% } %>
            <div class="t-signature-label">Headmaster's Signature</div>
          </div>
        </div>

        <!-- Footer -->
        <div class="t-footer">
          <p>Official Transcript — Generated on <%= new Date().toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' }) %></p>
          <p>This document is the property of <%= organization.organization_name %>.</p>
        </div>

      </div>
      <div class="transcript-border-bottom"></div>
    </div>

    <!-- Signature Tools -->
    <div class="sig-tools">
      <h3>✍️ Manage Signature</h3>
      
      <div class="sig-tabs">
        <button class="sig-tab active" onclick="switchSigTab('upload')">📁 Upload Image</button>
        <button class="sig-tab" onclick="switchSigTab('draw')">✏️ Draw Signature</button>
      </div>

      <!-- Upload Panel -->
      <div id="sigUploadPanel" class="sig-panel active">
        <form action="/transcript/uploadSignatureImage" method="POST" enctype="multipart/form-data" class="sig-upload-form">
          <input type="hidden" name="studentId" value="<%= student.student_id %>" />
          <input type="file" name="signatureImage" accept="image/*" required />
          <button type="submit" class="sig-upload-btn">
            <%= signatureImageUrl ? '🔄 Update Signature' : '📤 Upload Signature' %>
          </button>
        </form>
      </div>

      <!-- Draw Panel -->
      <div id="sigDrawPanel" class="sig-panel">
        <p style="font-size: 13px; color: #64748b; margin-bottom: 10px;">Draw your signature below using your mouse or touchscreen:</p>
        <div class="sig-canvas-wrapper">
          <canvas id="signatureCanvas" class="sig-canvas"></canvas>
        </div>
        <div class="sig-canvas-actions">
          <button class="sig-clear-btn" onclick="clearCanvas()">🗑 Clear</button>
          <button class="sig-save-btn" onclick="saveDigitalSignature()">💾 Save Signature</button>
        </div>
        <div id="sigStatus" class="sig-status"></div>
      </div>
    </div>

    <script>
      // ===== Tab Switching =====
      function switchSigTab(tab) {
        document.querySelectorAll('.sig-tab').forEach(t => t.classList.remove('active'));
        document.querySelectorAll('.sig-panel').forEach(p => p.classList.remove('active'));

        if (tab === 'upload') {
          document.querySelectorAll('.sig-tab')[0].classList.add('active');
          document.getElementById('sigUploadPanel').classList.add('active');
        } else {
          document.querySelectorAll('.sig-tab')[1].classList.add('active');
          document.getElementById('sigDrawPanel').classList.add('active');
          initCanvas();
        }
      }

      // ===== Canvas Signature Pad =====
      let canvas, ctx, isDrawing = false, lastX = 0, lastY = 0, canvasInitialized = false;

      function initCanvas() {
        if (canvasInitialized) return;
        canvas = document.getElementById('signatureCanvas');
        ctx = canvas.getContext('2d');
        
        // Set actual canvas size (not CSS size)
        const rect = canvas.getBoundingClientRect();
        canvas.width = rect.width * 2;
        canvas.height = rect.height * 2;
        ctx.scale(2, 2);
        
        ctx.strokeStyle = '#1e293b';
        ctx.lineWidth = 2.5;
        ctx.lineCap = 'round';
        ctx.lineJoin = 'round';

        // Mouse events
        canvas.addEventListener('mousedown', (e) => {
          isDrawing = true;
          const pos = getPos(e);
          lastX = pos.x;
          lastY = pos.y;
        });
        canvas.addEventListener('mousemove', (e) => {
          if (!isDrawing) return;
          const pos = getPos(e);
          drawLine(lastX, lastY, pos.x, pos.y);
          lastX = pos.x;
          lastY = pos.y;
        });
        canvas.addEventListener('mouseup', () => isDrawing = false);
        canvas.addEventListener('mouseout', () => isDrawing = false);

        // Touch events
        canvas.addEventListener('touchstart', (e) => {
          e.preventDefault();
          isDrawing = true;
          const pos = getTouchPos(e);
          lastX = pos.x;
          lastY = pos.y;
        }, { passive: false });
        canvas.addEventListener('touchmove', (e) => {
          e.preventDefault();
          if (!isDrawing) return;
          const pos = getTouchPos(e);
          drawLine(lastX, lastY, pos.x, pos.y);
          lastX = pos.x;
          lastY = pos.y;
        }, { passive: false });
        canvas.addEventListener('touchend', () => isDrawing = false);

        canvasInitialized = true;
      }

      function getPos(e) {
        const rect = canvas.getBoundingClientRect();
        return { x: e.clientX - rect.left, y: e.clientY - rect.top };
      }

      function getTouchPos(e) {
        const rect = canvas.getBoundingClientRect();
        const touch = e.touches[0];
        return { x: touch.clientX - rect.left, y: touch.clientY - rect.top };
      }

      function drawLine(x1, y1, x2, y2) {
        ctx.beginPath();
        ctx.moveTo(x1, y1);
        ctx.lineTo(x2, y2);
        ctx.stroke();
      }

      function clearCanvas() {
        if (!canvas) return;
        ctx.clearRect(0, 0, canvas.width, canvas.height);
      }

      function isCanvasBlank() {
        const data = ctx.getImageData(0, 0, canvas.width, canvas.height).data;
        for (let i = 3; i < data.length; i += 4) {
          if (data[i] !== 0) return false;
        }
        return true;
      }

      async function saveDigitalSignature() {
        if (!canvas || isCanvasBlank()) {
          alert('Please draw your signature first.');
          return;
        }

        const statusEl = document.getElementById('sigStatus');
        statusEl.style.display = 'block';
        statusEl.style.color = '#64748b';
        statusEl.textContent = 'Saving signature...';

        try {
          const dataURL = canvas.toDataURL('image/png');
          const response = await fetch('/transcript/saveDigitalSignature', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ signatureData: dataURL })
          });

          const result = await response.json();
          if (result.success) {
            statusEl.style.color = '#10b981';
            statusEl.textContent = '✅ Signature saved successfully!';
            setTimeout(() => window.location.reload(), 1200);
          } else {
            statusEl.style.color = '#ef4444';
            statusEl.textContent = '❌ ' + (result.error || 'Failed to save signature.');
          }
        } catch (err) {
          statusEl.style.color = '#ef4444';
          statusEl.textContent = '❌ Error saving signature. Please try again.';
        }
      }
    </script>
  </body>
</html>
