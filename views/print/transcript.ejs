<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="<%= locals.viewportContent || 'width=device-width, initial-scale=1.0' %>" />
    <title><%= title %></title>
    <style>
      :root {
        --font-family: "<%= (session && session.fontStyle ? String(session.fontStyle).trim() : 'Inter') %>", sans-serif;
        --primary: var(--org-primary-color, #01535b);
        --primary-hover: var(--org-primary-hover, #013a40);
        --primary-hover-fill: color-mix(in srgb, var(--primary) 88%, white);
      }

      /* The app's shared styles give every table cell a grey border, a grey heading background and
         8px of padding, and take bullets off lists. The designs (everything but Standard, which was
         drawn with them) and the About page start from a clean slate instead; each design's own rules
         come after these and set what it wants. */
      .td table, .tx-about table { width: 100%; border-collapse: collapse; font-size: inherit; }
      .td th, .td td { border: 0; background: none; padding: 0; text-align: left; font-size: inherit; vertical-align: middle; }
      .td ul, .td ol, .tx-about ul { list-style: disc; }
      .td li, .tx-about li { margin: 0; text-align: left; }
      .tx-about table { width: auto; }

      .ctrl-btn {
        width: auto;
        margin: 0;
        padding: 8px 14px;
        font: inherit;
        font-size: 13px;
        font-weight: 600;
        line-height: 1.2;
        border-radius: 8px;
        border: 1px solid transparent;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 7px;
        white-space: nowrap;
        text-decoration: none;
      }

      .ctrl-btn svg { flex: 0 0 auto; }

      .ctrl-btn-print {
        background: var(--primary);
        color: #fff;
      }

      .ctrl-btn-back {
        background: #fff;
        color: #334155;
        border-color: #e2e8f0;
      }

      .ctrl-btn-email {
        background: color-mix(in srgb, var(--primary) 10%, white);
        color: var(--primary);
        border-color: color-mix(in srgb, var(--primary) 22%, white);
      }

      /* Top controls bar */
      .ctrl-design { display: inline-flex; align-items: center; gap: 8px; padding: 0 4px 0 12px; height: 38px; border: 1px solid #cbd5e1; border-radius: 10px; background: #fff; font-size: 13px; font-weight: 600; color: #334155; }
      .ctrl-design select { height: 30px; border: 0; background: transparent; font: inherit; font-weight: 700; color: var(--primary); cursor: pointer; }
      .transcript-controls {
        max-width: 900px;
        margin: 0 auto 24px;
        padding: 12px 14px;
        display: flex;
        gap: 8px;
        flex-wrap: wrap;
        justify-content: flex-end;
        align-items: center;
        background: #fff;
        border-radius: 10px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.08);
      }

      /* Header */
      .t-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 24px;
        padding-bottom: 18px;
        margin-bottom: 22px;
        border-bottom: 2px solid var(--primary);
      }

      .t-brand {
        display: flex;
        align-items: center;
        gap: 16px;
        min-width: 0;
      }

      .t-header .t-logo {
        width: 72px;
        height: 72px;
        flex-shrink: 0;
        display: flex;
        align-items: center;
        justify-content: center;
      }

      .t-header .t-logo img {
        width: 100%;
        height: 100%;
        object-fit: contain;
      }

      .t-header .t-heading {
        text-align: left;
      }

      .t-header h1 {
        margin: 0;
        font-size: 22px;
        font-weight: 800;
        line-height: 1.2;
        color: var(--primary);
        letter-spacing: 0.5px;
        text-transform: uppercase;
      }

      .t-header .t-subtitle {
        margin: 6px 0 0;
        font-size: 12px;
        font-weight: 700;
        color: #475569;
        letter-spacing: 2.5px;
        text-transform: uppercase;
      }

      .t-header .t-contact {
        flex-shrink: 0;
        max-width: 260px;
        text-align: right;
        font-size: 11.5px;
        color: #475569;
        line-height: 1.6;
      }

      @media (max-width: 640px) {
        .t-header { flex-direction: column; align-items: flex-start; }
        .t-header .t-contact { text-align: left; max-width: none; }
      }

      /* ===== TRANSCRIPT DOCUMENT ===== */
      .transcript {
        max-width: 900px;
        margin: 0 auto;
        background: #fff;
        padding: 0;
        border-radius: 0;
        border: none;
        box-shadow: 0 8px 40px rgba(0,0,0,0.12);
        position: relative;
        overflow: hidden;
      }

      /* Decorative top border */
      .transcript-border-top {
        height: 6px;
        background: linear-gradient(90deg, var(--primary), var(--primary-hover), var(--primary));
        -webkit-print-color-adjust: exact;
        print-color-adjust: exact;
      }

      /* Watermark - Logo (using actual img element for PDF reliability) */
      .transcript-watermark-logo {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        width: 400px;
        height: 400px;
        object-fit: contain;
        opacity: 0.10;
        z-index: 0;
        pointer-events: none;
        -webkit-print-color-adjust: exact;
        print-color-adjust: exact;
      }

      /* Watermark - UNOFFICIAL TEXT (Multiple Small) */
      <% if (!official) { %>
      .transcript::after {
        content: "";
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background-image: repeating-linear-gradient(
          -45deg,
          transparent,
          transparent 120px,
          rgba(225, 29, 72, 0.06) 120px,
          rgba(225, 29, 72, 0.06) 121px
        );
        z-index: 1;
        pointer-events: none;
      }
      
      .transcript-watermark {
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        z-index: 10;
        pointer-events: none;
        overflow: hidden;
      }
      
      .watermark-text {
        position: absolute;
        font-size: 18px;
        font-weight: 700;
        color: rgba(225, 29, 72, 0.08);
        transform: rotate(-45deg);
        white-space: nowrap;
        letter-spacing: 2px;
        text-transform: uppercase;
      }
      <% } %>

      .transcript-content {
        position: relative;
        z-index: 2;
        padding: 28px 36px;
      }

      /* Student Info */
      .t-student-info {
        margin-bottom: 20px;
        padding: 14px 16px;
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        border-radius: 6px;
        border-left: 3px solid var(--primary);
      }

      .t-student-info h2 {
        font-size: 12px;
        font-weight: 700;
        color: var(--primary);
        text-transform: uppercase;
        letter-spacing: 1px;
        margin-bottom: 10px;
        padding-bottom: 6px;
        border-bottom: 1px solid #e2e8f0;
      }

      .t-student-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 6px 20px;
      }

      .t-student-grid p {
        font-size: 11px;
        color: #334155;
        margin: 0;
        line-height: 1.5;
      }

      .t-student-grid strong {
        color: #0f172a;
        font-weight: 700;
      }

      /* Academic Info */
      .t-academic h2 {
        font-size: 12px;
        font-weight: 700;
        color: var(--primary);
        text-transform: uppercase;
        letter-spacing: 1px;
        margin-bottom: 14px;
        padding-bottom: 6px;
        border-bottom: 2px solid var(--primary);
      }

      .t-year-section {
        margin-bottom: 20px;
      }

      .t-year-section h3 {
        font-size: 13px;
        font-weight: 700;
        color: #0f172a;
        padding: 8px 12px;
        background: linear-gradient(135deg, #f8fafc, #f1f5f9);
        border-left: 4px solid var(--primary);
        border-radius: 0 6px 6px 0;
        margin-bottom: 10px;
      }

      .t-term-section {
        margin-bottom: 20px;
      }

      .t-term-section h4 {
        font-size: 13px;
        font-weight: 700;
        color: #475569;
        padding: 6px 0 6px 14px;
        border-left: 3px solid var(--primary);
        margin-bottom: 10px;
        text-transform: uppercase;
        letter-spacing: 0.5px;
      }

      /* Table */
      .t-table {
        width: 100%;
        border-collapse: collapse;
        margin-bottom: 16px;
        font-size: 13px;
      }

      .t-table th {
        background: var(--primary);
        color: white;
        padding: 10px 14px;
        text-align: left;
        font-size: 11px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.5px;
      }

      .t-table th:first-child { border-radius: 6px 0 0 0; }
      .t-table th:last-child { border-radius: 0 6px 0 0; }

      .t-table td {
        padding: 9px 14px;
        border-bottom: 1px solid #f1f5f9;
        color: #334155;
      }

      .t-table tr:nth-child(even) td {
        background: #fafbfc;
      }

      .t-table tr:last-child td {
        border-bottom: 2px solid var(--primary);
      }

      /* Signature Section */
      .t-signature-area {
        margin-top: 40px;
        display: flex;
        justify-content: flex-end;
      }

      .t-signature-block {
        text-align: center;
        min-width: 220px;
      }

      .t-signature-img {
        max-width: 170px;
        max-height: 70px;
        object-fit: contain;
        display: block;
        margin: 0 auto -4px;
      }

      .transcript-note {
        max-width: 900px;
        margin: -12px auto 16px;
        font-size: 13px;
        color: #92400e;
      }

      .transcript-note a { color: inherit; font-weight: 600; }

      .t-signature-line {
        width: 200px;
        border-bottom: 2px solid #1e293b;
        margin: 0 auto 6px;
      }

      .t-signature-label {
        font-size: 12px;
        color: #64748b;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.5px;
      }

      .t-signature-name {
        font-size: 13px;
        color: #0f172a;
        font-weight: 700;
        min-height: 16px;
      }

      /* Footer */
      .t-footer {
        text-align: center;
        margin-top: 36px;
        padding-top: 16px;
        border-top: 2px solid #e2e8f0;
      }

      .t-footer p {
        font-size: 11px;
        color: #94a3b8;
        margin: 2px 0;
      }

      /* Decorative bottom border */
      .transcript-border-bottom {
        height: 6px;
        background: linear-gradient(90deg, var(--primary), var(--primary-hover), var(--primary));
      }

      /* ===== SIGNATURE TOOLS (hidden on print) ===== */
      .sig-tools {
        max-width: 900px;
        margin: 24px auto 0;
        background: white;
        border: 1px solid #e2e8f0;
        border-radius: 12px;
        padding: 24px;
        box-shadow: 0 2px 12px rgba(0,0,0,0.06);
      }

      .sig-tools h3 {
        font-size: 16px;
        font-weight: 700;
        color: #1e293b;
        margin: 0 0 16px;
      }

      .sig-tabs {
        display: flex;
        gap: 0;
        margin-bottom: 20px;
        border: 1px solid #e2e8f0;
        border-radius: 8px;
        overflow: hidden;
      }

      .sig-tab {
        flex: 1;
        padding: 8px;
        text-align: center;
        font-size: 12px;
        font-weight: 600;
        cursor: pointer;
        background: #f8fafc;
        color: #64748b;
        border: none;
        transition: all 0.2s;
      }

      .sig-tab.active {
        background: var(--primary);
        color: white;
      }

      

      .sig-panel {
        display: none;
      }

      .sig-panel.active {
        display: block;
      }

      /* Upload panel */
      .sig-upload-form {
        display: flex;
        align-items: center;
        gap: 12px;
        flex-wrap: wrap;
      }

      .sig-upload-form input[type="file"] {
        font-size: 13px;
      }

      .sig-upload-btn {
        padding: 7px 16px;
        font-size: 12px;
        font-weight: 600;
        border-radius: 6px;
        background: var(--primary);
        color: white;
        border: none;
        cursor: pointer;
        transition: all 0.2s;
      }

      

      /* Draw panel */
      .sig-canvas-wrapper {
        border: 2px solid #e2e8f0;
        border-radius: 8px;
        overflow: hidden;
        margin-bottom: 12px;
        background: white;
      }

      .sig-canvas {
        display: block;
        width: 100%;
        height: 150px;
        cursor: crosshair;
        touch-action: none;
      }

      .sig-canvas-actions {
        display: flex;
        gap: 8px;
      }

      .sig-clear-btn {
        padding: 7px 16px;
        font-size: 12px;
        font-weight: 600;
        border-radius: 6px;
        background: #f1f5f9;
        color: #475569;
        border: 1px solid #e2e8f0;
        cursor: pointer;
        transition: all 0.2s;
      }

      

      .sig-save-btn {
        padding: 7px 16px;
        font-size: 12px;
        font-weight: 600;
        border-radius: 6px;
        background: var(--primary);
        color: white;
        border: none;
        cursor: pointer;
        transition: all 0.2s;
      }

      

      .sig-status {
        font-size: 13px;
        color: #10b981;
        font-weight: 600;
        margin-top: 8px;
        display: none;
      }


      /* ===== The page around the document (screen only) =====
         A top bar, the document on a soft canvas, and a sidebar with the student, the summary, the design
         and how official copies are sent. Explicit button styles: the app's own rules for buttons and
         links must not reach these. */
      .tx-app { --tx-ink: #0f172a; --tx-soft: #64748b; --tx-line: #e5e7eb; --tx-canvas: #f3f4f6; --tx-card: #fff; min-height: 100vh; background: var(--tx-canvas); color: var(--tx-ink); font-family: var(--font-family, "Inter", system-ui, sans-serif); }
      .tx-app *, .tx-app *::before, .tx-app *::after { box-sizing: border-box; }
      .tx-bar { position: sticky; top: 0; z-index: 50; display: flex; align-items: center; justify-content: space-between; gap: 16px; padding: 10px 24px; background: rgba(255, 255, 255, 0.92); backdrop-filter: saturate(160%) blur(10px); -webkit-backdrop-filter: saturate(160%) blur(10px); border-bottom: 1px solid var(--tx-line); }
      .tx-bar__lead { display: flex; align-items: center; gap: 12px; min-width: 0; }
      .tx-bar__actions { display: flex; align-items: center; gap: 8px; flex: none; }
      .tx-iconbtn { flex: none; display: inline-flex; align-items: center; justify-content: center; width: 34px; height: 34px; margin: 0; padding: 0; border: 1px solid var(--tx-line); border-radius: 9px; background: #fff; color: var(--tx-ink); cursor: pointer; box-shadow: none; }
      .tx-iconbtn:hover { background: #f8fafc; border-color: #d1d5db; }
      .tx-crumbs { display: flex; align-items: center; gap: 8px; min-width: 0; font-size: 14px; white-space: nowrap; }
      .tx-crumbs a { color: var(--tx-soft); text-decoration: none; font-weight: 500; }
      .tx-crumbs a:hover { color: var(--tx-ink); text-decoration: underline; }
      .tx-crumbs__sep { color: #cbd5e1; }
      .tx-crumbs__here { font-weight: 700; color: var(--tx-ink); overflow: hidden; text-overflow: ellipsis; }
      .tx-pill { flex: none; display: inline-flex; align-items: center; height: 24px; padding: 0 10px; border-radius: 999px; background: #fef3c7; color: #92400e; font-size: 12px; font-weight: 600; white-space: nowrap; }
      .tx-pill--info { background: color-mix(in srgb, var(--primary) 12%, #fff); color: var(--primary); }
      .tx-btn { display: inline-flex; align-items: center; gap: 8px; width: auto; height: 36px; margin: 0; padding: 0 14px; border: 1px solid transparent; border-radius: 9px; font: inherit; font-size: 13.5px; font-weight: 600; line-height: 1; letter-spacing: normal; text-transform: none; white-space: nowrap; cursor: pointer; box-shadow: none; transition: background 0.15s, border-color 0.15s, box-shadow 0.15s; }
      .tx-btn svg { flex: none; }
      .tx-btn--primary { background: var(--primary); color: #fff; box-shadow: 0 1px 2px rgba(15, 23, 42, 0.12); }
      .tx-btn--primary:hover { background: var(--primary-hover); }
      .tx-btn--secondary { background: #fff; color: var(--tx-ink); border-color: var(--tx-line); box-shadow: 0 1px 2px rgba(15, 23, 42, 0.05); }
      .tx-btn--secondary:hover { background: #f8fafc; border-color: #d1d5db; }
      .tx-btn--ghost { background: transparent; color: var(--tx-soft); }
      .tx-btn--ghost:hover { background: #eef0f3; color: var(--tx-ink); }
      .tx-btn:focus-visible, .tx-iconbtn:focus-visible, .tx-design:focus-visible { outline: 2px solid var(--primary); outline-offset: 2px; }

      .tx-layout { display: grid; grid-template-columns: minmax(0, 1fr) 320px; gap: 24px; align-items: start; max-width: 1280px; margin: 0 auto; padding: 28px 24px 56px; }
      .tx-canvas { min-width: 0; }
      .tx-doc { display: flex; justify-content: center; }
      .tx-doc > .transcript { width: 100%; margin-bottom: 0 !important; border-radius: 4px; box-shadow: 0 1px 2px rgba(15, 23, 42, 0.06), 0 12px 32px rgba(15, 23, 42, 0.08) !important; }
      .tx-callout { display: flex; align-items: flex-start; gap: 10px; max-width: 8.5in; margin: 0 auto 16px; padding: 11px 14px; border-radius: 10px; font-size: 13.5px; line-height: 1.45; }
      .tx-callout svg { flex: none; margin-top: 1px; }
      .tx-callout a { color: inherit; font-weight: 700; }
      .tx-callout--info { background: color-mix(in srgb, var(--primary) 8%, #fff); color: var(--primary); border: 1px solid color-mix(in srgb, var(--primary) 20%, #fff); }
      .tx-callout--warn { background: #fffbeb; color: #92400e; border: 1px solid #fde68a; }

      .tx-side { position: sticky; top: 76px; display: flex; flex-direction: column; gap: 14px; }
      .tx-card { padding: 16px; border: 1px solid var(--tx-line); border-radius: 12px; background: var(--tx-card); box-shadow: 0 1px 2px rgba(15, 23, 42, 0.04); }
      .tx-card--plain { background: transparent; box-shadow: none; }
      .tx-card__title { margin: 0 0 12px; font-size: 12px; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; color: var(--tx-soft); }
      .tx-card__note { margin: 12px 0 0; font-size: 12.5px; line-height: 1.5; color: var(--tx-soft); }
      .tx-card__note a { color: var(--primary); font-weight: 600; text-decoration: none; }
      .tx-card__note a:hover { text-decoration: underline; }
      .tx-card--student { display: flex; align-items: center; gap: 12px; }
      .tx-avatar { flex: none; display: flex; align-items: center; justify-content: center; width: 44px; height: 44px; border-radius: 50%; background: color-mix(in srgb, var(--primary) 14%, #fff); color: var(--primary); font-size: 15px; font-weight: 800; letter-spacing: 0.02em; }
      .tx-student { min-width: 0; }
      .tx-student__name { font-size: 15.5px; font-weight: 700; line-height: 1.25; }
      .tx-student__meta { margin-top: 2px; font-size: 12.5px; color: var(--tx-soft); line-height: 1.4; }
      .tx-stats { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }
      .tx-stat { padding: 10px 12px; border: 1px solid var(--tx-line); border-radius: 10px; background: #fafafa; }
      .tx-stat span { display: block; font-size: 11.5px; font-weight: 600; color: var(--tx-soft); }
      .tx-stat b { display: block; margin-top: 2px; font-size: 21px; font-weight: 800; letter-spacing: -0.01em; font-variant-numeric: tabular-nums; color: var(--tx-ink); }
      .tx-stat small { display: block; font-size: 11px; color: var(--tx-soft); }
      .tx-stat--accent { background: color-mix(in srgb, var(--primary) 7%, #fff); border-color: color-mix(in srgb, var(--primary) 22%, #fff); }
      .tx-stat--accent b { color: var(--primary); }
      .tx-designs { display: flex; flex-direction: column; gap: 6px; }
      .tx-design { position: relative; display: flex; align-items: center; gap: 12px; padding: 8px; border: 1px solid var(--tx-line); border-radius: 10px; background: #fff; color: var(--tx-ink); text-decoration: none; transition: border-color 0.15s, background 0.15s; }
      .tx-design:hover { border-color: #cbd5e1; background: #fafafa; }
      .tx-design.is-on { border-color: var(--primary); background: color-mix(in srgb, var(--primary) 5%, #fff); box-shadow: 0 0 0 1px var(--primary); }
      .tx-design__thumb { flex: none; width: 52px; height: 52px; overflow: hidden; border-radius: 6px; }
      .tx-design__thumb .rs-td-thumb { width: 120px; height: 118px; transform: scale(0.44); transform-origin: 0 0; }
      .tx-design__text { display: flex; flex-direction: column; gap: 2px; min-width: 0; padding-right: 18px; }
      .tx-design__name { display: flex; align-items: center; gap: 6px; flex-wrap: wrap; font-size: 13.5px; font-weight: 700; }
      .tx-design__desc { font-size: 11.5px; line-height: 1.35; color: var(--tx-soft); display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
      .tx-design__check { position: absolute; top: 8px; right: 8px; display: flex; color: var(--primary); }
      .tx-badge { display: inline-flex; align-items: center; height: 18px; padding: 0 7px; border-radius: 999px; background: #eef2f7; color: #475569; font-size: 10.5px; font-style: normal; font-weight: 700; }
      .tx-points { margin: 0; padding: 0; list-style: none; display: flex; flex-direction: column; gap: 10px; }
      .tx-points li { display: flex; gap: 10px; font-size: 12.5px; line-height: 1.45; color: var(--tx-soft); }
      .tx-points svg { flex: none; margin-top: 1px; color: var(--tx-ink); }
      .tx-points b { color: var(--tx-ink); }

      @media screen and (max-width: 1180px) {
        .tx-layout { grid-template-columns: minmax(0, 1fr); }
        .tx-side { position: static; display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); align-items: start; max-width: 8.5in; margin: 0 auto; width: 100%; }
      }
      @media screen and (max-width: 720px) {
        .tx-bar { padding: 8px 12px; gap: 8px; }
        .tx-crumbs a, .tx-crumbs__sep, .tx-pill { display: none; }
        .tx-btn { padding: 0 10px; }
        .tx-btn span { display: none; }
        .tx-btn--primary span { display: inline; }
        .tx-layout { padding: 14px 10px 40px; gap: 14px; }
        .tx-side { grid-template-columns: 1fr; }
      }

      /* ===== PRINT STYLES ===== */
      @media print {
        @page {
          size: A4 portrait;
          margin: 10mm;
        }

        body {
          background: #fff !important;
          padding: 0;
          margin: 0;
        }

        /* Hide controls and tools when printing: the page around the document never prints, nor
           reaches the emailed PDF (which is drawn from this page in print mode). */
        .tx-bar, .tx-side, .tx-callout { display: none !important; }
        .tx-app, .tx-layout, .tx-canvas, .tx-doc { display: block !important; min-height: 0 !important; max-width: none !important; margin: 0 !important; padding: 0 !important; background: #fff !important; }
        .tx-doc > .transcript { border-radius: 0 !important; box-shadow: none !important; }
        .transcript-controls { display: none !important; }
        .transcript-note { display: none !important; }
        #emailModal { display: none !important; }
        
        /* Hide page headers, footers, chatbot, navigation, etc */
        header { display: none !important; }
        footer { display: none !important; }
        nav { display: none !important; }
        .navbar { display: none !important; }
        .sidebar { display: none !important; }
        .chatbot { display: none !important; }
        #chatbot { display: none !important; }
        .chat-widget { display: none !important; }
        .floating-button { display: none !important; }
        [class*="chatbot"] { display: none !important; }
        [id*="chatbot"] { display: none !important; }
        [class*="chat-"] { display: none !important; }
        .no-print { display: none !important; }

        /* Ensure transcript shows with proper styling */
        .transcript {
          box-shadow: none !important;
          border: none;
          margin: 0 auto;
          page-break-inside: avoid;
        }

        /* Force watermarks to show in print - uses color not background so always visible */
        .transcript::before {
          content: "" !important;
          display: block !important;
          opacity: 0.12 !important;
          -webkit-print-color-adjust: exact !important;
          print-color-adjust: exact !important;
        }
        
        .transcript::after {
          content: "" !important;
          display: block !important;
        }
        
        .transcript-watermark {
          display: block !important;
        }
        
        .watermark-text {
          display: block !important;
          color: rgba(225, 29, 72, 0.12) !important;
          opacity: 1 !important;
          print-color-adjust: exact;
          -webkit-print-color-adjust: exact;
        }
        
        /* Show disclaimer page in print */
        .pdf-disclaimer-page {
          display: block !important;
          page-break-before: always !important;
        }

        .transcript-content {
          padding: 20px 24px;
        }

        .t-table th {
          background: #e2e8f0 !important;
          color: #0f172a !important;
          -webkit-print-color-adjust: exact;
          print-color-adjust: exact;
        }

        .t-year-section {
          page-break-inside: avoid;
        }

        .t-term-section {
          page-break-inside: avoid;
        }

        .t-footer {
          page-break-after: avoid;
        }

        .transcript-border-top,
        .transcript-border-bottom {
          -webkit-print-color-adjust: exact;
          print-color-adjust: exact;
        }
      }
    </style>
<% if (!locals.isPrintRender) { %><script src="<%= assetUrl('/js/appAlert.js') %>"></script><% } %>
  </head>
  <body>

    <%
      // Everything a transcript design needs, worked out once (views/print/transcriptDesigns/*).
      const _designKey = ['standard', 'classic', 'modern', 'compact', 'registrar'].includes(locals.design) ? locals.design : 'standard';
      const _fmtDate = (value) => {
        if (!value) return '';
        // A date on its own ("2024-08-19") is that day wherever the reader is, not midnight UTC.
        const day = typeof value === 'string' && /^\d{4}-\d{2}-\d{2}$/.test(value) ? value.split('-').map(Number) : null;
        const d = day ? new Date(day[0], day[1] - 1, day[2]) : new Date(value);
        return Number.isNaN(d.getTime()) ? '' : (typeof formatDisplayDate === 'function' ? formatDisplayDate(d) : d.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' }));
      };
      const _gpa = (v) => (v === null || v === undefined || !Number.isFinite(Number(v)) ? null : Number(v).toFixed(2));
      const _cr = _gpa; // credits print the same way: 1.00, 0.50
      // GPA (utils/gpa.js transcriptGpa): each term's own totals and the cumulative totals up to it.
      const _gs = (typeof gpaSummary !== 'undefined' && gpaSummary) ? gpaSummary : null;
      const _usesCredits = Boolean(_gs && _gs.usesCredits);
      const _pair = (g) => (g && g.unweighted !== null && g.unweighted !== undefined ? { unweighted: _gpa(g.unweighted), weighted: _gpa(g.weighted) } : null);
      const _creditsOf = (g) => (_usesCredits && g ? { attempted: _cr(g.attempted), earned: _cr(g.earned) } : null);
      // Everything a registrar prints for some courses: credits attempted and earned (the number of
      // courses where there are no course credits), GPA credits, quality points and the GPA.
      const _sum = (g) => (g ? { attempted: _cr(g.attempted), earned: _cr(g.earned), gpaCredits: _cr(g.gpaCredits), points: Number(g.gpaCredits) > 0 ? _cr(g.qualityPoints) : null, gpa: _gpa(g.unweighted), weighted: _gpa(g.weighted) } : null);
      const t = (() => {
        const logo = publicImageUrl(((typeof session !== 'undefined' && session) ? session.logo : '') || organization.logo || '', { public: true });
        const years = [];
        (scores || []).forEach((score) => {
          const key = `${score.year_label}__${score.term_name}__${score.start_date || ''}__${score.end_date || ''}`;
          let year = years.find((y) => y.label === score.year_label);
          if (!year) { year = { label: score.year_label, terms: [] }; years.push(year); }
          let term = year.terms.find((x) => x.key === key);
          if (!term) {
            const g = _gs && _gs.terms ? _gs.terms[key] : null;
            term = {
              key, name: score.term_name, dates: [_fmtDate(score.start_date), _fmtDate(score.end_date)].filter(Boolean).join(' – '), rows: [],
              gpa: _pair(g), // this term's courses only
              cumulative: _pair(g && g.cumulative), // every course up to and including this term
              credits: _creditsOf(g),
              cumulativeCredits: _creditsOf(g && g.cumulative),
              sum: _sum(g),
              cumulativeSum: _sum(g && g.cumulative),
            };
            year.terms.push(term);
          }
          term.rows.push({
            subject: score.subject_name, percent: score.total_percentage, grade: score.grade,
            credits: _usesCredits ? _cr(score.credits) : null,
            attempted: _cr(score.attempted), earned: _cr(score.earned),
            points: score.qualityPoints === null || score.qualityPoints === undefined ? '' : _cr(score.qualityPoints),
          });
        });
        const earlier = [];
        ((typeof history !== 'undefined' && Array.isArray(history)) ? history : []).forEach((row) => {
          const key = `${row.school_year || ''}__${row.term || ''}`;
          let section = earlier.find((x) => x.key === key);
          if (!section) { section = { key, year: row.school_year || 'Earlier records', term: row.term || 'Final grades', school: row.school_name || '', rows: [] }; earlier.push(section); }
          section.rows.push({ subject: row.course_name, percent: row.percent === null || row.percent === undefined || row.percent === '' ? '' : Number(row.percent), grade: row.grade || '', credits: row.credits_earned === null || row.credits_earned === undefined || row.credits_earned === '' ? '' : Number(row.credits_earned), attempted: row.credits_attempted === null || row.credits_attempted === undefined || row.credits_attempted === '' ? '' : _cr(row.credits_attempted), earned: row.credits_earned === null || row.credits_earned === undefined || row.credits_earned === '' ? '' : _cr(row.credits_earned), points: row.gpa_points === null || row.gpa_points === undefined || row.gpa_points === '' ? '' : _cr(row.gpa_points) });
        });
        const overall = _gs ? _pair(_gs.all) : null;
        // Credits earned: the old system's (as exported) and Managira's (where courses carry credits).
        const _oldCredits = (typeof historyTotals !== 'undefined' && historyTotals && historyTotals.credits !== null && historyTotals.credits !== undefined) ? Number(historyTotals.credits) : null;
        const _ownCredits = _usesCredits && _gs.all ? Number(_gs.all.earned) : null;
        const creditsEarned = _oldCredits === null && _ownCredits === null ? null : _cr((_oldCredits || 0) + (_ownCredits || 0));
        // The key printed under the record: the grade scale, the weighting and how GPA is worked out.
        const _bonus = (n) => '+' + Number(n).toFixed(1);
        const _letter = /^[A-F]\s*[+\-–−]?$/i;
        const key = _gs ? {
          scale: 'A+ and A 4.0 · A− 3.7 · B+ 3.3 · B 3.0 · B− 2.7 · C+ 2.3 · C 2.0 · C− 1.7 · D+ 1.3 · D 1.0 · D− 0.7 · F 0.0',
          weighted: overall && overall.weighted && _gs.settings ? `Weighted GPA adds ${_bonus(_gs.settings.honors)} for Honors and ${_bonus(_gs.settings.ap)} for AP / IB to a passing grade.` : '',
          method: (_usesCredits ? 'GPA = quality points (grade points × credits) ÷ credits.' : 'Each course counts equally.')
            + ' Term GPA counts that term; cumulative GPA counts every term to date.'
            + ((scores || []).some((r) => r.grade && !_letter.test(String(r.grade).trim())) ? ' Grades that aren\'t letters don\'t count toward GPA.' : ''),
        } : null;
        const previous = (typeof sourceGpa !== 'undefined' && sourceGpa) ? sourceGpa : null;
        const name = typeof formatDisplayName === 'function' ? formatDisplayName(student) : [student.first_name, student.last_name].filter(Boolean).join(' ').trim();
        const fields = [
          ['Student', name],
          ['Student ID', student.custom_student_id || ''],
          ['Date of birth', _fmtDate(student.date_of_birth)],
          ['Gender', student.gender],
          ['Current class', student.class_name],
          ['Graduation group', student.graduation_year_group],
          ['Hometown', student.hometown],
        ].filter(([, v]) => v && String(v).trim());
        return {
          design: _designKey,
          schoolName: organization.organization_name || '',
          logo,
          address: [organization.organization_address, organization.organization_province, organization.organization_country].filter(Boolean).join(', '),
          phone: organization.organization_phone || '',
          email: organization.email || '',
          studentName: name,
          studentId: student.custom_student_id || '',
          fields,
          years,
          earlier,
          creditsEarned,
          usesCredits: _usesCredits,
          overallCredits: _creditsOf(_gs && _gs.all),
          totals: _gs ? _sum(_gs.all) : null,
          // The previous records' credits, as exported (never part of this school's GPA).
          previousCredits: (typeof history !== 'undefined' && Array.isArray(history) && history.length) ? {
            attempted: _cr(history.reduce((n, r) => n + Number(r.credits_attempted || 0), 0)),
            earned: _cr(history.reduce((n, r) => n + Number(r.credits_earned || 0), 0)),
          } : null,
          termCount: years.reduce((n, y) => n + y.terms.length, 0) + earlier.length,
          overall,
          previous,
          key: overall ? key : null,
          signature: { image: signatureImageUrl ? publicImageUrl(signatureImageUrl) : '', name: signatureName || '', title: signatureTitle || 'Authorized signature' },
          issued: _fmtDate(new Date()),
          official: Boolean(official),
        };
      })();
    %>
    <%
      // The page around the document, on screen only: a top bar (back, where you are, the actions), the
      // document on a canvas, and a sidebar (the student, the summary, the design, official copies).
      // None of it prints or reaches the emailed PDF (see the print styles).
      const _designs = Array.isArray(locals.transcriptDesigns) ? transcriptDesigns : [];
      const _isPreview = Boolean(locals.preview);
      const _savedName = ((_designs.find((d) => d.key === locals.savedDesign) || {}).name) || 'Standard';
      const _initials = String(t.studentName || '?').split(/\s+/).filter(Boolean).slice(0, 2).map((w) => w.charAt(0).toUpperCase()).join('') || '?';
      const _fieldOf = (label) => ((t.fields.find(([l]) => l === label) || [])[1]) || '';
      const _svg = (paths) => `<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${paths}</svg>`;
      const _icons = {
        back: '<path d="M15 18l-6-6 6-6"/>',
        mail: '<rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 7l9 6 9-6"/>',
        bell: '<path d="M18 8a6 6 0 10-12 0c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.7 21a2 2 0 01-3.4 0"/>',
        print: '<path d="M6 9V3h12v6"/><rect x="3" y="9" width="18" height="8" rx="2"/><path d="M6 14h12v7H6z"/>',
        check: '<path d="M20 6L9 17l-5-5"/>',
        info: '<circle cx="12" cy="12" r="9"/><path d="M12 11v5"/><path d="M12 8h.01"/>',
        alert: '<path d="M10.3 3.9L1.8 18a2 2 0 001.7 3h17a2 2 0 001.7-3L13.7 3.9a2 2 0 00-3.4 0z"/><path d="M12 9v4"/><path d="M12 17h.01"/>',
        shield: '<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>',
      };
    %>
    <%- include('../partials/transcriptDesignThumbs') %>
    <div class="tx-app">
      <div class="tx-bar" role="toolbar" aria-label="Transcript">
        <div class="tx-bar__lead">
          <button type="button" class="tx-iconbtn" aria-label="Back" title="Back" data-onclick="print-transcript.1" data-mga0="<%= _isPreview ? '/common/reports?panel=report-settings' : '/common/reports?panel=transcripts' %>"><%- _svg(_icons.back) %></button>
          <nav class="tx-crumbs" aria-label="Breadcrumb">
            <a href="<%= _isPreview ? '/common/reports?panel=report-settings' : '/common/reports?panel=transcripts' %>" data-no-spa><%= _isPreview ? 'Report Settings' : 'Transcripts' %></a>
            <span class="tx-crumbs__sep" aria-hidden="true">/</span>
            <span class="tx-crumbs__here" aria-current="page"><%= _isPreview ? 'Design preview' : t.studentName %></span>
          </nav>
          <span class="tx-pill<%= _isPreview ? ' tx-pill--info' : '' %>" title="<%= _isPreview ? 'A sample student: no real record is shown' : 'Printed copies are unofficial. Email sends the official copy.' %>"><%= _isPreview ? 'Sample student' : 'Unofficial copy' %></span>
        </div>
        <div class="tx-bar__actions">
          <% if (!_isPreview) { %>
            <% if (canBroadcastToGuardians) { %>
              <button type="button" class="tx-btn tx-btn--ghost notify-guardians-btn" data-context="transcript" data-context-id="<%= student.student_id %>" title="Notify guardians"><%- _svg(_icons.bell) %><span>Notify guardians</span></button>
            <% } %>
            <button type="button" class="tx-btn tx-btn--secondary" data-onclick="print-transcript.2" title="Email the official copy"><%- _svg(_icons.mail) %><span>Email official copy</span></button>
          <% } %>
          <button type="button" class="tx-btn tx-btn--primary" data-onclick="print-transcript.3" title="Print"><%- _svg(_icons.print) %><span>Print</span></button>
        </div>
      </div>

      <div class="tx-layout">
        <div class="tx-canvas">
          <% if (_isPreview) { %>
            <div class="tx-callout tx-callout--info"><%- _svg(_icons.info) %><span>A sample transcript for previewing designs. No real student is shown.</span></div>
          <% } else if (!signatureImageUrl) { %>
            <div class="tx-callout tx-callout--warn"><%- _svg(_icons.alert) %><span>No signature is set for this class yet. <a href="/common/reports?panel=report-settings" data-no-spa>Add one in Report Settings</a>.</span></div>
          <% } %>
          <%# data-ap-skip: the page around it follows the person's light or dark look; the transcript stays paper-white. %>
          <div class="tx-doc" data-ap-skip>
    <%- include('transcriptDesigns/' + _designKey, { t }) %>
          </div>
        </div>

        <aside class="tx-side" aria-label="Transcript details">
          <section class="tx-card tx-card--student">
            <div class="tx-avatar" aria-hidden="true"><%= _initials %></div>
            <div class="tx-student">
              <div class="tx-student__name"><%= t.studentName %></div>
              <div class="tx-student__meta"><%= [t.studentId ? 'ID ' + t.studentId : '', _fieldOf('Current class'), _fieldOf('Graduation group')].filter(Boolean).join(' · ') %></div>
            </div>
          </section>

          <section class="tx-card">
            <h2 class="tx-card__title">Academic summary</h2>
            <div class="tx-stats">
              <% if (t.overall) { %>
                <div class="tx-stat tx-stat--accent"><span>Cumulative GPA</span><b><%= t.overall.unweighted %></b><small>4.0 scale</small></div>
                <% if (t.overall.weighted) { %><div class="tx-stat"><span>Weighted GPA</span><b><%= t.overall.weighted %></b><small>Honors &amp; AP</small></div><% } %>
              <% } %>
              <div class="tx-stat"><span>Terms completed</span><b><%= t.termCount %></b></div>
              <% if (t.creditsEarned) { %><div class="tx-stat"><span>Credits earned</span><b><%= t.creditsEarned %></b></div><% } %>
            </div>
            <% if (!t.overall) { %><p class="tx-card__note">No GPA yet: GPA is worked out from letter grades in finished terms.</p><% } %>
          </section>

          <% if (_designs.length > 1) { %>
            <section class="tx-card">
              <h2 class="tx-card__title">Design</h2>
              <div class="tx-designs" role="list">
                <% _designs.forEach((d) => { const _on = d.key === _designKey; %>
                  <a role="listitem" class="tx-design<%= _on ? ' is-on' : '' %>" href="?design=<%= d.key %>" data-no-spa<% if (_on) { %> aria-current="true"<% } %>>
                    <span class="tx-design__thumb" aria-hidden="true"><span class="rs-td-thumb rs-td-thumb--<%= d.key %>"><i></i><i></i><i></i><i></i><i></i><i></i></span></span>
                    <span class="tx-design__text">
                      <span class="tx-design__name"><%= d.name %><% if (d.key === locals.savedDesign) { %><em class="tx-badge">School default</em><% } %></span>
                      <span class="tx-design__desc"><%= d.description %></span>
                    </span>
                    <% if (_on) { %><span class="tx-design__check"><%- _svg(_icons.check) %></span><% } %>
                  </a>
                <% }) %>
              </div>
              <p class="tx-card__note">The emailed official copy always uses the school default (<b><%= _savedName %></b>), set in <a href="/common/reports?panel=report-settings" data-no-spa>Report Settings</a>.</p>
            </section>
          <% } %>

          <% if (!_isPreview) { %>
            <section class="tx-card tx-card--plain">
              <h2 class="tx-card__title">Official copies</h2>
              <ul class="tx-points">
                <li><%- _svg(_icons.shield) %><span><b>Email official copy</b> sends a password-protected PDF from reports@managira.com.</span></li>
                <li><%- _svg(_icons.print) %><span><b>Print</b> gives an unofficial copy, marked as such.</span></li>
              </ul>
            </section>
          <% } %>
        </aside>
      </div>
    </div>

    <link rel="stylesheet" href="<%= assetUrl('/css/reportPanels.css') %>" />
    <script src="<%= assetUrl('/js/embedPopupLift.js') %>" defer></script>
    <script src="<%= assetUrl('/js/reportPanelLift.js') %>" defer></script>
    <!-- Email: recipient -->
    <div id="emailStepModal" class="rp-overlay" data-popup-lift data-rp-watch style="display:none;">
      <div class="rp-panel" role="dialog" aria-modal="true" aria-labelledby="emailStepTitle">
        <div class="rp-head">
          <h3 class="rp-title" id="emailStepTitle">Email transcript</h3>
          <button type="button" class="rp-x" data-onclick="print-transcript.4" aria-label="Close">&times;</button>
        </div>
        <div class="rp-body">
          <div>
            <label class="rp-label" for="emailTarget">Email</label>
            <input type="email" id="emailTarget" class="rp-input" placeholder="guardian@example.com" value="<%= student.guardian_email || '' %>" />
          </div>
          <div id="emailStepStatus" style="font-size:12.5px;color:#e11d48;min-height:18px;"></div>
        </div>
        <div class="rp-foot">
          <button type="button" class="rp-btn rp-btn--primary" data-onclick="print-transcript.5">Continue</button>
          <button type="button" class="rp-btn" data-onclick="print-transcript.4">Cancel</button>
        </div>
      </div>
    </div>

    <!-- Email: password -->
    <div id="passwordConfirmModal" class="rp-overlay" data-popup-lift data-rp-watch style="display:none;">
      <div class="rp-panel" role="dialog" aria-modal="true" aria-labelledby="passwordStepTitle">
        <div class="rp-head">
          <h3 class="rp-title" id="passwordStepTitle">Confirm password</h3>
          <button type="button" class="rp-x" data-onclick="print-transcript.6" aria-label="Back">&times;</button>
        </div>
        <div class="rp-body">
          <div>
            <label class="rp-label" for="emailPassword">Password</label>
            <input type="password" id="emailPassword" class="rp-input" placeholder="Your password" autocomplete="current-password" />
          </div>
          <div id="passwordStatus" class="rp-status" style="min-height:18px;"></div>
        </div>
        <div class="rp-foot">
          <button type="button" class="rp-btn rp-btn--primary" data-onclick="print-transcript.7">Send</button>
          <button type="button" class="rp-btn" data-onclick="print-transcript.6">Back</button>
        </div>
      </div>
    </div>

    <script nonce="<%= locals.cspNonce || '' %>">
      let emailRecipient = '';

      function trackTranscriptPrintAndPrint() {
        try {
          fetch('/print/logDeliveryEvent', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            credentials: 'same-origin',
            keepalive: true,
            body: JSON.stringify({
              eventDomain: 'transcript',
              eventName: 'transcript_printed',
              classId: <%= student.class_id || 'null' %>,
              studentId: <%= student.student_id %>,
              status: 'printed',
              notes: 'Transcript printed from transcript page.',
            })
          }).catch(() => {});
        } catch (_) {
          // Do not block printing if event logging fails.
        }

        window.print();
      }
      
      function openEmailModal(){
        document.getElementById('emailStepStatus').textContent = '';
        document.getElementById('emailTarget').value = '<%= student.guardian_email || "" %>';
        document.getElementById('emailStepModal').style.display = 'flex';
      }
      
      function closeEmailStepModal(){ 
        document.getElementById('emailStepModal').style.display = 'none'; 
      }
      
      function proceedToPasswordStep(){
        const emailInput = document.getElementById('emailTarget').value.trim();
        const statusEl = document.getElementById('emailStepStatus');
        
        if(!emailInput || !emailInput.includes('@')){
          statusEl.textContent = 'Please enter a valid email address.';
          return;
        }
        
        emailRecipient = emailInput;
        document.getElementById('emailStepModal').style.display = 'none';
        document.getElementById('emailPassword').value = '';
        document.getElementById('passwordStatus').textContent = '';
        document.getElementById('passwordConfirmModal').style.display = 'flex';
      }
      
      function backToEmailStep(){
        document.getElementById('passwordConfirmModal').style.display = 'none';
        document.getElementById('emailStepModal').style.display = 'flex';
      }
      
      async function sendTranscriptEmail(){
        const statusEl = document.getElementById('passwordStatus');
        const password = document.getElementById('emailPassword').value;
        
        if(!password){
          statusEl.style.color = '#e11d48';
          statusEl.textContent = 'Please enter your password.';
          return;
        }
        
        statusEl.style.color = '#0ea5e9';
        statusEl.textContent = 'Sending email...';
        
        try {
          const res = await fetch('/transcript/emailTranscript', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            credentials: 'same-origin',
            body: JSON.stringify({ 
              studentId: '<%= student.student_id %>', 
              targetEmail: emailRecipient, 
              password 
            })
          });
          const data = await res.json();
          if(!data.success){ throw new Error(data.message || 'Failed to send email'); }
          
          statusEl.style.color = '#10b981';
          statusEl.textContent = '✓ Email sent successfully!';
          setTimeout(() => {
            document.getElementById('passwordConfirmModal').style.display = 'none';
          }, 1200);
        } catch(err){
          statusEl.style.color = '#e11d48';
          statusEl.textContent = err.message;
        }
      }

      // ===== Tab Switching =====
      function switchSigTab(tab) {
        document.querySelectorAll('.sig-tab').forEach(t => t.classList.remove('active'));
        document.querySelectorAll('.sig-panel').forEach(p => p.classList.remove('active'));

        if (tab === 'upload') {
          document.querySelectorAll('.sig-tab')[0].classList.add('active');
          document.getElementById('sigUploadPanel').classList.add('active');
        } else {
          document.querySelectorAll('.sig-tab')[1].classList.add('active');
          document.getElementById('sigDrawPanel').classList.add('active');
          initCanvas();
        }
      }

      // ===== Canvas Signature Pad =====
      let canvas, ctx, isDrawing = false, lastX = 0, lastY = 0, canvasInitialized = false;

      function initCanvas() {
        if (canvasInitialized) return;
        canvas = document.getElementById('signatureCanvas');
        ctx = canvas.getContext('2d');
        
        // Set actual canvas size (not CSS size)
        const rect = canvas.getBoundingClientRect();
        canvas.width = rect.width * 2;
        canvas.height = rect.height * 2;
        ctx.scale(2, 2);
        
        ctx.strokeStyle = '#1e293b';
        ctx.lineWidth = 2.5;
        ctx.lineCap = 'round';
        ctx.lineJoin = 'round';

        // Mouse events
        canvas.addEventListener('mousedown', (e) => {
          isDrawing = true;
          const pos = getPos(e);
          lastX = pos.x;
          lastY = pos.y;
        });
        canvas.addEventListener('mousemove', (e) => {
          if (!isDrawing) return;
          const pos = getPos(e);
          drawLine(lastX, lastY, pos.x, pos.y);
          lastX = pos.x;
          lastY = pos.y;
        });
        canvas.addEventListener('mouseup', () => isDrawing = false);
        canvas.addEventListener('mouseout', () => isDrawing = false);

        // Touch events
        canvas.addEventListener('touchstart', (e) => {
          e.preventDefault();
          isDrawing = true;
          const pos = getTouchPos(e);
          lastX = pos.x;
          lastY = pos.y;
        }, { passive: false });
        canvas.addEventListener('touchmove', (e) => {
          e.preventDefault();
          if (!isDrawing) return;
          const pos = getTouchPos(e);
          drawLine(lastX, lastY, pos.x, pos.y);
          lastX = pos.x;
          lastY = pos.y;
        }, { passive: false });
        canvas.addEventListener('touchend', () => isDrawing = false);

        canvasInitialized = true;
      }

      function getPos(e) {
        const rect = canvas.getBoundingClientRect();
        return { x: e.clientX - rect.left, y: e.clientY - rect.top };
      }

      function getTouchPos(e) {
        const rect = canvas.getBoundingClientRect();
        const touch = e.touches[0];
        return { x: touch.clientX - rect.left, y: touch.clientY - rect.top };
      }

      function drawLine(x1, y1, x2, y2) {
        ctx.beginPath();
        ctx.moveTo(x1, y1);
        ctx.lineTo(x2, y2);
        ctx.stroke();
      }

      function clearCanvas() {
        if (!canvas) return;
        ctx.clearRect(0, 0, canvas.width, canvas.height);
      }

      function isCanvasBlank() {
        const data = ctx.getImageData(0, 0, canvas.width, canvas.height).data;
        for (let i = 3; i < data.length; i += 4) {
          if (data[i] !== 0) return false;
        }
        return true;
      }

      async function saveDigitalSignature() {
        if (!canvas || isCanvasBlank()) {
          alert('Please draw your signature first.');
          return;
        }

        const statusEl = document.getElementById('sigStatus');
        statusEl.style.display = 'block';
        statusEl.style.color = '#64748b';
        statusEl.textContent = 'Saving signature...';

        try {
          const dataURL = canvas.toDataURL('image/png');
          const response = await fetch('/transcript/saveDigitalSignature', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ signatureData: dataURL })
          });

          const result = await response.json();
          if (result.success) {
            statusEl.style.color = '#10b981';
            statusEl.textContent = '✅ Signature saved successfully!';
            setTimeout(() => window.location.reload(), 1200);
          } else {
            statusEl.style.color = '#ef4444';
            statusEl.textContent = '❌ ' + (result.error || 'Failed to save signature.');
          }
        } catch (err) {
          statusEl.style.color = '#ef4444';
          statusEl.textContent = '❌ Error saving signature. Please try again.';
        }
      }
    </script>

    <!-- About this transcript: the page printed after the record (print and PDF only, hidden on screen).
         The registrar's key (grade scale, how GPA is worked out, credits) and the notices on official
         copies, authenticity and privacy. -->
    <style>
      .tx-about { position: relative; padding: 0.3in 0.35in; color: #1f2937; font-family: <%- _designKey === 'classic' ? 'Georgia, "Times New Roman", Times, serif' : '"Inter", "Helvetica Neue", Arial, sans-serif' %>; font-size: 10.5px; line-height: 1.5; }
      .tx-about__mark { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; pointer-events: none; }
      .tx-about__mark span { transform: rotate(-30deg); font-size: 90px; font-weight: 800; letter-spacing: 0.14em; color: rgba(17, 24, 39, 0.045); }
      .tx-about__body { position: relative; }
      .tx-about h2 { margin: 0; font-size: 15px; letter-spacing: 0.16em; text-transform: uppercase; }
      .tx-about__lead { margin: 3px 0 14px; padding-bottom: 10px; border-bottom: 1.5px solid #1f2937; color: #6b7280; font-size: 10.5px; }
      .tx-about h3 { margin: 14px 0 5px; font-size: 11px; letter-spacing: 0.1em; text-transform: uppercase; color: #111827; }
      .tx-about p { margin: 0 0 6px; }
      .tx-about ul { margin: 0 0 6px; padding-left: 16px; }
      .tx-about li { margin: 0 0 3px; }
      .tx-about table { border-collapse: collapse; margin: 2px 0 8px; }
      .tx-about th, .tx-about td { padding: 3px 9px; border: 0.5px solid #d1d5db; text-align: center; font-size: 10.5px; line-height: 1.3; font-variant-numeric: tabular-nums; }
      .tx-about th { background: #f3f4f6; font-weight: 700; }
      .tx-about__cols { display: grid; grid-template-columns: 1fr 1fr; gap: 0 24px; }
      .tx-about__foot { margin-top: 16px; padding-top: 8px; border-top: 0.5px solid #d1d5db; color: #6b7280; font-size: 9.5px; text-align: center; }
      .tx-about, .tx-about * { -webkit-print-color-adjust: exact; print-color-adjust: exact; }
    </style>
    <div class="pdf-disclaimer-page tx-about" style="page-break-before: always; display: none;">
      <%# The other designs' watermark already repeats on every printed page. %>
      <% if (!official && _designKey === 'standard') { %><div class="tx-about__mark" aria-hidden="true"><span>UNOFFICIAL</span></div><% } %>
      <div class="tx-about__body">
        <h2>About this transcript</h2>
        <p class="tx-about__lead"><%= t.schoolName %> · <%= t.studentName %> · <%= t.official ? 'Official copy issued ' : 'Unofficial copy printed ' %><%= t.issued %></p>

        <% if (t.key) { %>
          <h3>Grading key</h3>
          <table aria-label="Grade points">
            <tr><th>Grade</th><td>A+ / A</td><td>A−</td><td>B+</td><td>B</td><td>B−</td><td>C+</td><td>C</td><td>C−</td><td>D+</td><td>D</td><td>D−</td><td>F</td></tr>
            <tr><th>Points</th><td>4.0</td><td>3.7</td><td>3.3</td><td>3.0</td><td>2.7</td><td>2.3</td><td>2.0</td><td>1.7</td><td>1.3</td><td>1.0</td><td>0.7</td><td>0.0</td></tr>
          </table>
          <ul>
            <li><b>Term GPA</b> counts only the courses of that term. <b>Cumulative GPA</b> counts every course to date: all the grade points over all the <%= t.usesCredits ? 'credits' : 'courses' %>, not an average of the term GPAs.</li>
            <% if (t.usesCredits) { %>
              <li>Each course counts by its credits: quality points are grade points × credits, and GPA is quality points ÷ credits. <b>Credits attempted</b> are the credits of every graded course; <b>credits earned</b> are those passed (D− or better).</li>
            <% } else { %>
              <li>Each course counts equally.</li>
            <% } %>
            <% if (t.key.weighted) { %><li><%= t.key.weighted %> The unweighted GPA is on the 4.0 scale alone.</li><% } %>
            <li>An F counts toward GPA with no points. Pass, withdrawn and incomplete grades, and grades that aren't letters, don't count toward GPA.</li>
            <li>GPAs are worked out exactly and rounded to two decimal places.</li>
            <% if (t.previous || t.earlier.length) { %><li>Grades and GPA from previous records are shown as they were received and are not included in this school's GPA.</li><% } %>
          </ul>
        <% } %>

        <div class="tx-about__cols">
          <div>
            <h3>Official copies</h3>
            <p>A transcript is official only when the school sends it by email. A copy printed or downloaded by anyone else is marked UNOFFICIAL. To check a transcript, contact the school directly using its published details.</p>
            <h3>Use</h3>
            <p>This transcript is for legitimate purposes: admission, transfer, scholarships, employment and licensing. It may not be altered, presented as another person's, copied for others without authorization, or falsified. Doing so may lead to legal action.</p>
          </div>
          <div>
            <h3>Privacy</h3>
            <p>This record contains personally identifiable student information protected by the Family Educational Rights and Privacy Act (FERPA). It may not be released to another party without the written consent of the student, or of the parent of a student under 18. Store it securely and dispose of it securely when it is no longer needed.</p>
            <h3>Rights</h3>
            <p>This document is the property of <%= t.schoolName %>, which reserves all rights to it and to the information it contains.</p>
          </div>
        </div>

        <p class="tx-about__foot">Generated by Managira for <%= t.schoolName %> on <%= t.issued %>. For questions or verification, contact the school directly.</p>
      </div>
    </div>

    <script src="<%= assetUrl('/js/guardianBroadcast.js') %>"></script>
    <script nonce="<%= locals.cspNonce || '' %>">
      document.addEventListener('click', function (e) {
        var btn = e.target.closest('.notify-guardians-btn');
        if (!btn) return;
        e.preventDefault();
        openGuardianBroadcast({
          context: btn.dataset.context || 'transcript',
          contextId: btn.dataset.contextId || '',
        });
      });
    </script>
  </body>
</html>
<script src="<%= locals.assetUrl ? assetUrl('/js/mgActions.js') : '/js/mgActions.js' %>"></script>
