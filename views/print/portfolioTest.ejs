<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title><%= doc.title %> · <%= doc.studentName %></title>
<style>
  :root { --ink: #111827; --muted: #5b6170; --line: #e4e4e7; --ok: #15803d; --bad: #b91c1c; --accent: #0f5f63; }
  * { box-sizing: border-box; }
  body { margin: 0; background: #f4f5f7; color: var(--ink); font: 14px/1.5 -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif; }
  .bar { position: sticky; top: 0; z-index: 2; display: flex; align-items: center; gap: 10px; padding: 10px 16px; background: #fff; border-bottom: 1px solid var(--line); }
  .bar a, .bar button { display: inline-flex; align-items: center; height: 34px; padding: 0 14px; border: 1px solid var(--line); border-radius: 9px; background: #fff; color: var(--ink); font: inherit; font-size: 13.5px; font-weight: 600; text-decoration: none; cursor: pointer; }
  .bar .primary { border-color: var(--accent); background: var(--accent); color: #fff; }
  .bar .spacer { flex: 1; }
  .page { max-width: 820px; margin: 24px auto 48px; padding: 36px 40px; background: #fff; border: 1px solid var(--line); border-radius: 12px; }
  .school { color: var(--muted); font-size: 12px; font-weight: 700; letter-spacing: .06em; text-transform: uppercase; }
  h1 { margin: 6px 0 2px; font-size: 24px; letter-spacing: -.01em; }
  .sub { margin: 0; color: var(--muted); }
  .meta { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 12px; margin: 22px 0; padding: 14px 16px; border: 1px solid var(--line); border-radius: 10px; }
  .meta span { display: block; color: var(--muted); font-size: 11.5px; font-weight: 600; text-transform: uppercase; letter-spacing: .04em; }
  .meta strong { display: block; margin-top: 2px; font-size: 15px; }
  .grade { font-size: 20px !important; color: var(--accent); }
  ol { margin: 0; padding: 0; list-style: none; counter-reset: q; }
  li.q { padding: 16px 0; border-top: 1px solid var(--line); break-inside: avoid; }
  li.q:first-child { border-top: 0; }
  .qhead { display: flex; justify-content: space-between; gap: 12px; }
  .qhead .qtext::before { counter-increment: q; content: counter(q) ". "; font-weight: 700; }
  .qtext { flex: 1; }
  .marks { flex: none; color: var(--muted); font-size: 12.5px; font-weight: 700; white-space: nowrap; }
  .marks.full { color: var(--ok); }
  .marks.none { color: var(--bad); }
  .qimg { display: block; max-width: 100%; max-height: 260px; margin: 10px 0 0; border-radius: 8px; border: 1px solid var(--line); }
  .ans { display: grid; grid-template-columns: 130px minmax(0, 1fr); gap: 4px 10px; margin-top: 10px; font-size: 13.5px; }
  .ans dt { color: var(--muted); font-size: 12.5px; font-weight: 600; }
  .ans dd { margin: 0; white-space: pre-wrap; overflow-wrap: anywhere; }
  .right { color: var(--ok); font-weight: 600; }
  .note { margin: 18px 0 0; padding: 12px 14px; border-radius: 10px; background: #f6f7f9; color: var(--muted); font-size: 13px; }
  .foot { margin-top: 26px; padding-top: 12px; border-top: 1px solid var(--line); color: var(--muted); font-size: 11.5px; }
  @media (max-width: 640px) { .page { margin: 0; padding: 22px 18px; border: 0; border-radius: 0; } .meta { grid-template-columns: repeat(2, minmax(0, 1fr)); } .ans { grid-template-columns: minmax(0, 1fr); } }
  .is-pdf body, body.is-pdf { background: #fff; }
  body.is-pdf .page { margin: 0 auto; border: 0; }
  @media print { body { background: #fff; } .bar { display: none; } .page { margin: 0; padding: 0; border: 0; max-width: none; } }
</style>
</head>
<body class="<%= locals.isPrintRender ? 'is-pdf' : '' %>">
<% if (!locals.isPrintRender) { %>
<div class="bar">
  <a href="<%= back %>">‹ Portfolio</a>
  <span class="spacer"></span>
  <a class="primary" href="<%= download %>">Download PDF</a>
</div>
<% } %>
<main class="page">
  <div class="school"><%= doc.schoolName %></div>
  <h1><%= doc.title %></h1>
  <p class="sub"><%= [doc.subject, doc.termName].filter(Boolean).join(' · ') %></p>
  <div class="meta">
    <div><span>Student</span><strong><%= doc.studentName %></strong></div>
    <div><span>Class</span><strong><%= doc.className || '—' %></strong></div>
    <div><span>Finished</span><strong><%= doc.submittedAt ? new Date(doc.submittedAt).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) : '—' %></strong></div>
    <div><span>Grade</span><strong class="grade"><%= doc.choice || (doc.score !== null ? Number(doc.score.toFixed(2)) + ' / ' + doc.maxScore : '—') %><%= doc.percent !== null && !doc.choice ? ' (' + doc.percent + '%)' : '' %></strong></div>
  </div>
  <% if (doc.questions.length) { %>
  <ol>
    <% doc.questions.forEach((q) => {
      const _awarded = q.awarded === null ? null : Number(q.awarded);
      const _cls = _awarded === null ? '' : (_awarded >= q.marks ? 'full' : (_awarded === 0 ? 'none' : ''));
      const _given = q.type === 'image_label' ? (q.given || []).map((v, i) => (i + 1) + '. ' + v).join('\n') : (q.given || []).join(', ');
    %>
    <li class="q">
      <div class="qhead"><div class="qtext"><%- q.html %></div><span class="marks <%= _cls %>"><%= _awarded === null ? '' : Number(_awarded.toFixed(2)) + ' / ' %><%= q.marks %> mark<%= q.marks === 1 ? '' : 's' %></span></div>
      <% if (q.media && q.media.image && q.media.image.url) { %><img class="qimg" src="<%= q.media.image.url %>" alt="<%= q.media.image.alt || '' %>" /><% } %>
      <dl class="ans">
        <dt>Answer given</dt><dd><%= _given || 'No answer' %></dd>
        <% if (q.correct && q.correct.length) { %><dt>Correct answer</dt><dd class="right"><%= q.type === 'image_label' ? q.correct.map((v, i) => (i + 1) + '. ' + v).join('\n') : q.correct.join(', ') %></dd><% } %>
      </dl>
    </li>
    <% }) %>
  </ol>
  <% } else { %>
  <p class="note">The teacher shared the grade for this test. The questions and answers aren’t shared.</p>
  <% } %>
  <div class="foot">From <%= doc.studentName %>’s portfolio · <%= doc.schoolName %> · made <%= new Date().toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) %></div>
</main>
</body>
</html>
