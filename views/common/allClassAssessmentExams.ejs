<body>
  <div class="page-wrap">
    <%# In Management the page has no frame of its own, so it names itself; inside a class workspace the class already says where you are. %>
    <% const _inHub = isEmbedded && !Number(selectedClassId || 0); %>
    <div class="top-bar<%= (isEmbedded && !_inHub) ? ' top-bar--end' : '' %>">
      <% if (_inHub) { %>
        <div class="qh">
          <h1 class="qh__title">Assessment questions</h1>
        </div>
      <% } else if (!isEmbedded) { %><h1>Assessment Question Sets</h1><% } %>
      <% const _simpleFilters = isEmbedded && Number(selectedClassId || 0) > 0; %>
      <div class="top-bar-actions cw-toolbar">
        <button type="button" class="btn btn-outline" id="all-class-set-questions">New questions</button>
        <details class="ws-filters" id="workspace-filters-card">
          <summary class="ws-filters__btn cw-filter-btn" title="Filters" aria-label="Filters">
            <%- navIcon('filter', { className: 'cw-filter-ico' }) %>
            <span class="cw-filter-text">Filters</span>
            <span id="workspace-filters-hint" hidden>Expand</span>
            <%- navIcon('chevronDown', { size: 16, className: 'ws-filters__chev cw-filter-chev' }) %>
