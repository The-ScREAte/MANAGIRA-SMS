      overflow-y: auto;
      padding: 14px 16px;
      display: flex;
      flex-direction: column;
      gap: 12px;
    }

    .qm-draft-banner {
      display: flex;
      align-items: center;
      justify-content: flex-start;
      background: #fffbeb;
      border: 1px solid #fcd34d;
      border-radius: 9px;
      padding: 8px 11px;
      font-size: 0.76rem;
      color: #92400e;
      gap: 8px;
    }

    .qm-section {
      background: linear-gradient(165deg, #ffffff 0%, #f6fbff 100%);
      border: 1px solid #d3dfea;
      border-radius: 12px;
      padding: 12px;
      box-shadow: 0 6px 16px rgba(15, 35, 55, 0.06);
    }

    .qm-section-label {
      font-size: 0.62rem;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: #1a3442;
      margin: 0 0 8px;
    }

    .qm-grid-2 {
      display: grid;
      grid-template-columns: 1fr 1fr 1fr;
      gap: 8px;
    }

    .question-modal .qm-grid-2 {
      grid-template-columns: repeat(3, minmax(0, 1fr)) !important;
    }

    @media (min-width: 1024px) {
      .qm-grid-2 {
        grid-template-columns: repeat(3, minmax(0, 1fr));
      }
    }

    .qm-full { grid-column: 1 / -1; }
    .qm-span-2 { grid-column: span 2; }
    .question-modal .qm-grid-2 { gap: 12px 14px; }
    .qm-time-pair { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 8px; }
    .qm-time-pair.is-single { grid-template-columns: 1fr; }
    @media (max-width: 760px) { .question-modal .qm-grid-2 { grid-template-columns: repeat(2, minmax(0, 1fr)) !important; } }
    @media (max-width: 480px) { .question-modal .qm-grid-2 { grid-template-columns: 1fr !important; } .qm-span-2 { grid-column: auto; } }

    .qm-field {
      display: flex;
      flex-direction: column;
      gap: 4px;
    }

    .qm-field.is-hidden {
      display: none;
    }

    .qm-field label {
      font-size: 0.68rem;
      font-weight: 800;
      color: #0f2230;
      letter-spacing: 0.025em;
      text-transform: uppercase;
    }

    .qm-field input,
    .qm-field select,
    .qm-field textarea {
      border: 1.5px solid #8ea3b6;
      border-radius: 9px;
      padding: 7px 9px;
      font-size: 0.78rem;
      font-family: inherit;
      color: #050b11;
      background: linear-gradient(180deg, #ffffff 0%, #f8fbff 100%);
      transition: border-color 0.15s, box-shadow 0.15s;
      width: 100%;
    }

    .qm-field input::placeholder,
    .qm-field textarea::placeholder {
      color: #5f7383;
      opacity: 1;
    }

    .qm-field input:focus,
    .qm-field select:focus,
    .qm-field textarea:focus {
      outline: none;
      border-color: #0f5a66;
      box-shadow: 0 0 0 3px rgba(15, 90, 102, 0.14);
    }

    .qm-rules-box {
      background: linear-gradient(135deg, #f0fafb 0%, #e6f4f6 100%);
      border: 1px solid #a5d8dd;
      border-left: 4px solid #0f5a66;
      border-radius: 9px;
      padding: 9px 11px;
      font-size: 0.72rem;
      color: #0f4a54;
      line-height: 1.45;
      display: none;
    }

    .qm-question-count {
      font-size: 0.7rem;
      font-weight: 700;
      background: #f1f5f9;
      color: #475569;
      padding: 2px 8px;
      border-radius: 999px;
      white-space: nowrap;
    }
    .qm-question-count.is-marks-off { background: #fffbeb; color: #b45309; }

    .qm-question-header-actions {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      flex-wrap: nowrap;
      white-space: nowrap;
    }

    .qm-questions-layout-toggle {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 0;
      border: 0;
      background: transparent;
    }

    .qm-preview-trigger {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      border: 1px solid #cbd5e1;
      background: #fff;
      color: #1f2f3f;
      border-radius: 999px;
      min-height: 24px;
      min-width: 56px;
      padding: 0 9px;
      font-size: 0.62rem;
      font-weight: 800;
      letter-spacing: 0.04em;
      text-transform: uppercase;
      cursor: pointer;
      white-space: nowrap;
    }

    

    #question-items {
      display: grid;
      grid-template-columns: 1fr;
      gap: 9px;
    }

    #question-items.is-side-by-side {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .question-modal.is-edit-mode #question-items {
      grid-template-columns: 1fr;
    }

    .question-modal.is-edit-mode #question-items.is-side-by-side {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .qm-question-card {
      background: linear-gradient(180deg, #ffffff 0%, #f8fbff 100%);
      border: 1.5px solid #8ea3b6;
      border-radius: 10px;
      overflow: hidden;
