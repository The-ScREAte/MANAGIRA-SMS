    }

    .qm-question-card .qm-header-marks-field .question-marks {
      width: 7ch;
      min-width: 7ch;
      text-align: center;
    }

    .qm-question-badge {
      width: 24px;
      height: 24px;
      border-radius: 7px;
      background: linear-gradient(135deg, #0f5a66, #1a8fa0);
      color: #fff;
      font-size: 0.62rem;
      font-weight: 900;
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
      letter-spacing: -0.01em;
    }

    .qm-collapse-toggle {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-height: 22px;
      min-width: 0;
      padding: 0 7px;
      border-radius: 999px;
      border: 1px solid #cfdbe6;
      background: #f8fbff;
      color: #334155;
      font-size: 0.58rem;
      font-weight: 800;
      letter-spacing: 0.02em;
      text-transform: uppercase;
      cursor: pointer;
      white-space: nowrap;
      box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.45);
      width: auto !important;
      max-width: max-content;
      flex: 0 0 auto !important;
      align-self: center;
    }

    .qm-collapse-toggle[aria-expanded="true"] {
      border-color: #0f5a66;
      color: #0f5a66;
      background: #f0fafb;
    }

    .qm-remove-btn {
      width: 30px;
      height: 30px;
      border-radius: 8px;
      border: 1px solid #fecaca;
      background: #fff;
      color: #ef4444;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
      margin-bottom: 0;
      transition: all 0.15s;
    }

    

    .qm-question-card-body {
      padding: 8px 10px;
      display: flex;
      flex-direction: column;
      gap: 6px;
    }

    .qm-question-card.is-collapsed .qm-options-field,
    .qm-question-card.is-collapsed .qm-answer-field {
      display: none;
    }

    .qm-question-card .qm-field input,
    .qm-question-card .qm-field select,
    .qm-question-card .qm-field textarea {
      padding: 6px 8px;
      font-size: 0.76rem;
    }

    .qm-question-card .qm-field label {
      font-size: 0.65rem;
      font-weight: 700;
      letter-spacing: 0.02em;
      color: #0d1b28;
    }

    .qm-question-text-head {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 8px;
      flex-wrap: nowrap;
    }

    .qm-question-text-head > label {
      margin: 0;
    }

    .qm-question-text-editor-wrap {
      border: 1.5px solid #e2e8f0;
      border-radius: 8px;
      background: #fff;
      overflow: hidden;
    }

    .qm-question-text-toolbar {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 0;
      flex-wrap: nowrap;
      margin-left: auto;
      white-space: nowrap;
    }

    .qm-text-tool-btn {
      width: 24px;
      height: 24px;
      border: 1px solid #cbd5e1;
      border-radius: 6px;
      background: #fff;
      color: #334155;
      font-size: 0.72rem;
      font-weight: 700;
      cursor: pointer;
      line-height: 1;
      padding: 0;
    }

    .qm-text-tool-btn[data-format-cmd="italic"] {
      font-style: italic;
      font-family: "Georgia", "Times New Roman", serif;
      font-weight: 700;
    }

    

    .qm-text-color-wrap {
      width: 24px;
      height: 24px;
      border: 1.5px solid #8ea3b6;
      border-radius: 6px;
      overflow: hidden;
      cursor: pointer;
      background: #fff;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
      box-shadow: inset 0 0 0 1px rgba(15, 23, 42, 0.08);
      transition: border-color 0.15s, box-shadow 0.15s, transform 0.15s;
    }

    .qm-text-color-wrap:hover {
      box-shadow: 0 0 0 2px rgba(15, 90, 102, 0.12);}

    .qm-text-color {
      width: 100%;
      height: 100%;
