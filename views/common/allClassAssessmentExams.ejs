      display: inline-flex;
      align-items: center;
      gap: 5px;
      border: 1.5px dashed #94a3b8;
      background: transparent;
      color: #334155;
      border-radius: 7px;
      padding: 6px 10px;
      font-size: 0.72rem;
      font-weight: 700;
      cursor: pointer;
      transition: all 0.15s;
      letter-spacing: 0.01em;
    }

    #add-question-item {
      min-height: 28px;
      min-width: fit-content;
      width: auto;
      flex: 0 0 auto;
      padding: 5px 9px;
      font-size: 0.68rem;
      border-style: solid;
      border-color: #cbd5e1;
      background: #f8fafc;
      color: #334155;
      gap: 4px;
      justify-content: center;
    }

    #add-question-item svg {
      width: 13px;
      height: 13px;
      flex-shrink: 0;
    }

    .qm-btn-ghost:hover {
      border-color: #0f5a66;
      color: #0f5a66;
      background: #f0fafb;
    }

    .qm-btn-ghost:disabled {
      opacity: 0.45;
      cursor: not-allowed;
    }

    .qm-btn-clear {
      display: inline-flex;
      align-items: center;
      gap: 4px;
      border: 1.5px solid #e2e8f0;
      background: #f8fafc;
      color: #64748b;
      border-radius: 7px;
      padding: 6px 10px;
      font-size: 0.72rem;
      font-weight: 700;
      cursor: pointer;
      transition: all 0.15s;
    }

    .qm-btn-clear:hover {
      border-color: #fca5a5;
      color: #dc2626;
      background: #fff;
    }

    .qm-btn-save {
      display: inline-flex;
      align-items: center;
      gap: 5px;
      background: linear-gradient(135deg, #0f5a66 0%, #1a8fa0 100%);
      color: #fff;
      border: none;
      border-radius: 7px;
      padding: 7px 12px;
      font-size: 0.74rem;
      font-weight: 800;
      cursor: pointer;
      transition: opacity 0.15s, transform 0.1s;
      box-shadow: 0 2px 8px rgba(15,90,102,0.26);
      letter-spacing: 0.01em;
      white-space: nowrap;
      flex-wrap: nowrap;
    }

    .qm-btn-save:hover { opacity: 0.9; transform: translateY(-1px); }
    .qm-btn-save:active { transform: translateY(0); }
    .qm-btn-save:disabled {
      opacity: 0.45;
      cursor: not-allowed;
      transform: none;
    }

    .qm-btn-save .qm-spinner {
      width: 13px;
      height: 13px;
      border: 2px solid rgba(255, 255, 255, 0.35);
      border-top-color: #fff;
      border-radius: 50%;
      animation: qmSpin 0.7s linear infinite;
      flex-shrink: 0;
    }

    #question-modal-status {
      display: block;
      min-height: 18px;
      margin: 6px 14px 0;
      padding-bottom: calc(10px + env(safe-area-inset-bottom, 0px));
      font-size: 0.69rem;
      font-weight: 600;
      color: #64748b;
    }

    .qm-preview-overlay {
      position: fixed;
      inset: 0;
      background: rgba(10, 20, 30, 0.48);
      display: none;
      align-items: center;
      justify-content: center;
      z-index: 10100;
      padding: 16px;
    }

    .qm-preview-overlay.show {
      display: flex;
    }

    .qm-preview-panel {
      width: min(980px, 96vw);
      max-height: calc(100dvh - 32px);
      background: #fff;
      border: 1px solid #dbe4ee;
      border-radius: 14px;
      overflow: hidden;
      display: flex;
      flex-direction: column;
      box-shadow: 0 16px 44px rgba(15, 23, 42, 0.24);
    }

    .qm-preview-topbar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 12px 16px;
      border-bottom: 1px solid #e2e8f0;
      background: #f8fafc;
    }

    .qm-preview-actions {
      display: inline-flex;
      align-items: center;
      gap: 8px;
    }

    .qm-preview-print {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-height: 32px;
      padding: 0 12px;
      border-radius: 8px;
      border: 1px solid #cbd5e1;
      background: #fff;
      color: #334155;
      font-size: 0.78rem;
      font-weight: 800;
      letter-spacing: 0.03em;
      text-transform: uppercase;
      cursor: pointer;
    }

    .qm-preview-print:hover {
      border-color: #0f5a66;
      color: #0f5a66;
      background: #f0fafb;
    }

    .qm-preview-title {
      margin: 0;
      font-size: 0.95rem;
      color: #0f2d32;
      font-weight: 800;
    }

    .qm-preview-close {
      width: 32px;
      height: 32px;
      border-radius: 8px;
      border: 1px solid #d5dde7;
      background: #fff;
      color: #475569;
      cursor: pointer;
      font-size: 1.15rem;
      line-height: 1;
    }

    .qm-preview-body {
      overflow-y: auto;
      padding: 14px 16px 18px;
      display: grid;
      gap: 12px;
      background: #f8fafc;
    }

    .qm-preview-doc-header {
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      gap: 14px;
      border-bottom: 2px solid #0f5a66;
      padding-bottom: 10px;
      margin-bottom: 2px;
    }

    .qm-preview-doc-left {
      display: flex;
      align-items: flex-start;
      gap: 10px;
    }

    .qm-preview-doc-logo {
      width: 46px;
      height: 46px;
      object-fit: contain;
      border-radius: 6px;
      background: #fff;
      border: 1px solid #d8e3ed;
      padding: 3px;
    }

    .qm-preview-doc-school {
      margin: 0;
      font-size: 0.98rem;
      font-weight: 800;
      color: #0f2d32;
      line-height: 1.25;
    }

    .qm-preview-doc-title {
      margin: 2px 0 0;
      font-size: 0.8rem;
      font-weight: 700;
      color: #334155;
      line-height: 1.35;
    }

    .qm-preview-doc-subline {
      margin: 2px 0 0;
      font-size: 0.73rem;
      color: #475569;
      line-height: 1.4;
    }

    .qm-preview-doc-meta {
      text-align: right;
      font-size: 0.72rem;
      color: #64748b;
      line-height: 1.45;
      white-space: nowrap;
    }

    .qm-preview-context {
      background: #fff;
      border: 1px solid #e2e8f0;
      border-radius: 10px;
      padding: 10px 12px;
      font-size: 0.82rem;
      color: #334155;
      line-height: 1.45;
    }

    .qm-preview-card {
      background: #fff;
      border: 1px solid #e2e8f0;
      border-radius: 12px;
      padding: 12px;
      display: grid;
      gap: 8px;
    }

    .qm-preview-qmeta {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 10px;
      font-size: 0.78rem;
      color: #475569;
      font-weight: 700;
    }

    .qm-preview-qtext {
      font-size: 0.9rem;
      color: #0f172a;
      line-height: 1.45;
    }

    .qm-preview-options {
      list-style: none;
      margin: 0;
      padding: 0;
      display: grid;
      gap: 6px;
      font-size: 0.84rem;
      color: #334155;
    }

    .qm-preview-answer {
      font-size: 0.78rem;
      color: #64748b;
    }

    .qm-preview-cards {
      display: grid;
      grid-template-columns: 1fr;
      gap: 10px;
    }

    .qm-preview-cards.is-side-by-side {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .qm-preview-options.is-side-by-side {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: 10px;
      row-gap: 6px;
    }

    .question-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 8px;
    }

    .question-grid .full {
      grid-column: 1 / -1;
    }

    .question-list-item {
      border: 1px solid var(--border);
      border-radius: 10px;
      padding: 8px;
      margin-top: 8px;
    }

    @media (min-width: 1200px) {
      body { font-size: 16.8px; }
      .top-bar h1 { font-size: 1.34rem; }
      .btn {
        font-size: 0.9rem;
        padding: 8px 14px;
        min-height: 38px;
      }
      .helper-text { font-size: 0.9rem; }
      .section-title { font-size: 0.98rem; }
      .collapsible-hint { font-size: 0.8rem; }
      .field-group label { font-size: 0.8rem; }
      .field-group input,
      .field-group select {
        font-size: 0.88rem;
        min-height: 38px;
      }
      .text-link-control {
        font-size: 0.84rem;
        min-height: 38px;
      }
      .exam-title strong { font-size: 0.94rem; }
      .exam-title span { font-size: 0.82rem; }
      .exam-pill { font-size: 0.78rem; }
      .exam-updated { font-size: 0.8rem; }
      .set-actions-trigger {
        min-width: 38px;
        height: 32px;
        font-size: 16px;
      }
      .set-action-link { font-size: 0.86rem; }
      .question-meta { font-size: 0.78rem; }
      .question-text { font-size: 0.88rem; }
      .status-text { font-size: 0.82rem; }
      .empty-state { font-size: 0.86rem; }
    }

    @media (min-width: 1500px) {
      body { font-size: 17.4px; }
      .top-bar h1 { font-size: 1.42rem; }
      .btn { font-size: 0.96rem; }
      .section-title { font-size: 1.04rem; }
      .exam-title strong { font-size: 1rem; }
      .exam-title span,
      .exam-updated { font-size: 0.86rem; }
      .exam-pill { font-size: 0.82rem; }
      .question-meta { font-size: 0.82rem; }
      .question-text { font-size: 0.94rem; }
    }

    @media (max-width: 860px) {
      .page-wrap { padding: 12px 10px 18px; }
      .top-bar h1 { font-size: 0.92rem; }
      .btn { font-size: 0.64rem; padding: 4px 7px; }
      .helper-text { font-size: 0.7rem; }
      .section-title { font-size: 0.76rem; }
      .field-group label { font-size: 0.6rem; }
      .field-group input,
      .field-group select {
        font-size: 0.68rem;
        min-height: 28px;
      }
      .text-link-control {
        min-height: 28px;
        font-size: 0.66rem;
      }
      .exam-title strong { font-size: 0.72rem; }
      .exam-title span,
      .exam-updated { font-size: 0.62rem; }
      .exam-pill { font-size: 0.6rem; }
      .question-meta { font-size: 0.58rem; }
      .question-text { font-size: 0.68rem; }
      .set-action-link { font-size: 0.66rem; }
      .grid-two { grid-template-columns: 1fr; }
      .reuse-modal {
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 10px;
      }
      .reuse-modal-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 10px;
      }
      .filters-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
      .collapsible-summary {
        align-items: flex-start;
      }
      .workspace-filters-summary {
        align-items: center !important;
      }
      .collapsible-hint {
        margin-top: 2px;
      }
      .workspace-filters-summary .collapsible-hint {
        margin-top: 0;
      }
      .current-pill {
        font-size: 0.62rem;
      }
      .exam-summary {
        gap: 5px;
        align-items: flex-start;
        padding-right: 44px;
      }
      .exam-pill {
        min-width: 0;
      }
      .exam-summary-actions {
        width: 100%;
        justify-content: flex-start;
        flex-wrap: wrap;
      }
      .set-actions-menu {
        right: 8px;
        top: 8px;
      }
    }

    @media (max-width: 620px) {
      .reuse-modal {
        grid-template-columns: 1fr;
      }
      .reuse-modal-grid {
        grid-template-columns: 1fr;
      }
    }

    @media (max-width: 640px) {
      .question-modal {
        max-width: 100%;
      }
      .top-bar-actions .btn {
        min-height: 26px;
        padding: 4px 6px;
      }
      .qm-topbar-right {
        width: 100%;
        justify-content: flex-end;
      }
      .qm-upload-btn {
        padding: 7px 10px;
        font-size: 0.76rem;
      }
      .qm-question-header-actions {
        gap: 5px;
      }
      .qm-questions-layout-toggle {
        gap: 4px;
      }
      .qm-question-count {
        font-size: 0.64rem;
        padding: 2px 7px;
      }
      .qm-preview-trigger {
        min-width: 48px;
        min-height: 22px;
        padding: 0 7px;
        font-size: 0.56rem;
      }
      .qm-grid-2 { grid-template-columns: 1fr; }
      #question-items { grid-template-columns: 1fr; }
      .question-options-list.is-side-by-side {
        grid-template-columns: 1fr;
      }
      .qm-options-layout-btn {
        min-width: 32px;
        justify-content: center;
        padding: 0 7px;
      }
      .qm-question-card .qm-header-type-field .question-type {
        width: 15.5ch;
        min-width: 15.5ch;
      }
      .qm-question-card .qm-header-marks-field .question-marks {
        width: 6ch;
        min-width: 6ch;
      }
      .qm-preview-cards.is-side-by-side {
        grid-template-columns: 1fr;
      }
      .qm-preview-options.is-side-by-side {
        grid-template-columns: 1fr;
      }
      .qm-preview-doc-header {
        gap: 9px;
      }
      .qm-preview-doc-logo {
        width: 40px;
        height: 40px;
      }
      .qm-preview-doc-school {
        font-size: 0.88rem;
      }
      .qm-preview-doc-title {
        font-size: 0.73rem;
      }
      .qm-preview-doc-meta {
        font-size: 0.66rem;
      }
      .qm-footer {
        align-items: flex-start;
        flex-wrap: wrap;
      }
      .qm-footer-right {
        justify-content: flex-start;
        margin-left: 0;
      }
      .set-actions-trigger {
        min-width: 28px;
        height: 22px;
        font-size: 12px;
      }
      .filters-grid { grid-template-columns: 1fr; }
      .filter-actions .btn {
        flex: 0 0 auto;
        min-width: 78px;
      }
      #workspace-filters-card .filter-actions {
        justify-content: flex-start !important;
      }
      #workspace-filters-card .filter-actions .btn {
        min-width: 72px !important;
        font-size: 0.56rem !important;
        padding: 2px 6px !important;
      }

      .students-modal {
        max-width: 100%;
        padding: 10px;
      }

      .students-modal-overlay {
        align-items: flex-start;
        padding-top: calc(var(--header-height, 56px) + 14px);
      }

      .students-table {
        font-size: 0.68rem;
      }

      .students-table th,
      .students-table td {
        padding: 6px;
      }

      .students-modal-title {
        font-size: 0.88rem;
      }
    }

    @media (max-width: 420px) {
      .qm-grid-2 { grid-template-columns: 1fr; }
    }

    /* Final global scaling pass: larger desktop text, smaller mobile text */
    @media (min-width: 992px) {
      html { font-size: 112.5%; }
      body {
        font-size: 0.96rem !important;
        line-height: 1.45;
      }
    }

    @media (max-width: 768px) {
      html { font-size: 90.625%; }
      body {
        font-size: 0.86rem !important;
        line-height: 1.32;
      }
    }

    @media (max-width: 480px) {
      html { font-size: 84.375%; }
      body {
        font-size: 0.82rem !important;
        line-height: 1.3;
      }
    }
  </style>
</head>
<body>
  <div class="page-wrap">
    <div class="top-bar">
      <h1>Assessment Question Sets</h1>
      <div class="top-bar-actions">
        <button type="button" class="btn btn-outline" id="all-class-set-questions">Set Questions</button>
        <% if (canUseGoogleClassroom) { %>
          <button type="button" class="btn btn-google" id="all-class-sync-google">Sync Google</button>
        <% } %>
      </div>
    </div>

    <%- include('../partials/flash') %>

    <details class="form-card collapsible-card" id="workspace-filters-card">
      <summary class="collapsible-summary workspace-filters-summary">
        <div class="workspace-filters-main">
          <h2 class="section-title workspace-filters-title">Filters</h2>
          <div class="filter-summary-line workspace-filter-summary-line">
            <span class="current-pill">Current Term: <%= selectedTermName || ('Term ' + termId) %></span>
          </div>
        </div>
        <span class="collapsible-hint" id="workspace-filters-hint">Expand</span>
      </summary>
      <div class="collapsible-content">
        <div class="filter-panel">
          <div class="filters-grid">
            <div class="field-group">
              <label for="workspace-school-year">School Year</label>
              <select id="workspace-school-year"></select>
            </div>
            <div class="field-group">
              <label for="workspace-term">Term</label>
              <select id="workspace-term"></select>
            </div>
            <div class="field-group">
              <label for="filter-class">Class</label>
              <select id="filter-class">
                <option value="">All Classes</option>
              </select>
            </div>
            <div class="field-group">
              <label for="filter-subject">Subject</label>
              <select id="filter-subject">
                <option value="">All Subjects</option>
              </select>
            </div>
            <div class="field-group">
              <label for="filter-assessment">Assessment</label>
              <select id="filter-assessment">
                <option value="">All Assessments</option>
              </select>
            </div>
            <div class="field-group">
              <label for="filter-review-status">Review Status</label>
              <select id="filter-review-status">
                <option value="">All Statuses</option>
                <option value="pending">Pending</option>
                <option value="approved">Approved</option>
                <option value="rejected">Rejected</option>
              </select>
            </div>
            <div class="field-group">
              <label for="filter-points-min">Min Points</label>
              <input id="filter-points-min" type="number" min="0" step="1" placeholder="Any" />
            </div>
            <div class="field-group">
              <label for="filter-points-max">Max Points</label>
              <input id="filter-points-max" type="number" min="0" step="1" placeholder="Any" />
            </div>
            <div class="field-group">
              <label for="filter-percent-min">Min %</label>
              <input id="filter-percent-min" type="number" min="0" max="100" step="1" placeholder="Any" />
            </div>
            <div class="field-group">
              <label for="filter-percent-max">Max %</label>
              <input id="filter-percent-max" type="number" min="0" max="100" step="1" placeholder="Any" />
            </div>
            <div class="field-group">
              <label for="filter-search">Search</label>
              <input id="filter-search" type="text" placeholder="Title, class, subject, assessment" />
            </div>
            <div class="field-group">
              <label for="filter-sort">Sort By</label>
              <select id="filter-sort">
                <option value="normal">Normal</option>
                <option value="updated-desc">Updated: Newest First</option>
                <option value="updated-asc">Updated: Oldest First</option>
                <option value="points-desc">Points: High to Low</option>
                <option value="points-asc">Points: Low to High</option>
                <option value="percent-desc">Percentage: High to Low</option>
                <option value="percent-asc">Percentage: Low to High</option>
                <option value="questions-desc">Questions: High to Low</option>
                <option value="questions-asc">Questions: Low to High</option>
                <option value="subject-az">Subject: A to Z</option>
                <option value="assessment-az">Assessment: A to Z</option>
                <option value="class-az">Class: A to Z</option>
                <option value="class-za">Class: Z to A</option>
              </select>
            </div>
          </div>
          <div class="filter-actions">
            <button type="button" class="btn btn-primary" id="apply-set-filters">Apply</button>
            <button type="button" class="btn btn-secondary" id="clear-set-filters">Clear</button>
          </div>
        </div>
      </div>
    </details>

    <h2 class="section-title" style="margin-bottom:6px;">Created Question Sets</h2>

    <% const reviewRole = String((session && (session.userRole || (session.user && session.user.account_type))) || '').trim().toLowerCase(); %>
    <% const canReviewQuestionSets = reviewRole === 'manager' || reviewRole === 'supervisor'; %>
    <% if (!questionSets || !questionSets.length) { %>
      <div class="empty-state">No question sets are available for this term.</div>
    <% } else { %>
      <% const classSetMap = new Map(); %>
      <% questionSets.forEach(function(setItem) { %>
        <% const classKey = Number(setItem.class_id || 0); %>
        <% if (!classSetMap.has(classKey)) { %>
          <% classSetMap.set(classKey, {
            classId: classKey,
            className: setItem.class_name || ('Class ' + classKey),
            sets: []
          }); %>
        <% } %>
        <% classSetMap.get(classKey).sets.push(setItem); %>
      <% }); %>
      <% const classGroups = Array.from(classSetMap.values()).sort(function(a, b) {
        return String(a.className || '').localeCompare(String(b.className || ''));
      }); %>
      <div id="question-set-groups">
        <% classGroups.forEach(function(classGroup) { %>
          <section class="class-group js-class-group" data-class-id="<%= classGroup.classId %>" data-class-name="<%= String(classGroup.className || '').toLowerCase() %>">
            <div class="class-group-head">
              <h3 class="class-group-title"><%= classGroup.className %></h3>
              <span class="class-group-meta"><%= classGroup.sets.length %> set<%= classGroup.sets.length === 1 ? '' : 's' %></span>
            </div>
            <div class="class-group-divider"></div>
            <% const subjectSetMap = new Map(); %>
            <% classGroup.sets.forEach(function(setItem) { %>
              <% const subjectKey = Number(setItem.subject_id || 0); %>
              <% if (!subjectSetMap.has(subjectKey)) { %>
                <% subjectSetMap.set(subjectKey, {
                  subjectId: subjectKey,
                  subjectName: setItem.subject_name || ('Subject ' + subjectKey),
                  sets: []
                }); %>
              <% } %>
              <% subjectSetMap.get(subjectKey).sets.push(setItem); %>
            <% }); %>
            <% const subjectGroups = Array.from(subjectSetMap.values()).sort(function(a, b) {
              return String(a.subjectName || '').localeCompare(String(b.subjectName || ''));
            }); %>
            <div class="subject-group-list">
              <% subjectGroups.forEach(function(subjectGroup) { %>
                <section class="subject-group js-subject-group" data-subject-id="<%= subjectGroup.subjectId %>" data-subject-name="<%= String(subjectGroup.subjectName || '').toLowerCase() %>">
                  <% const assessmentSetMap = new Map(); %>
                  <% subjectGroup.sets.forEach(function(setItem) { %>
                    <% const assessmentKey = Number(setItem.assessment_id || 0); %>
                    <% if (!assessmentSetMap.has(assessmentKey)) { %>
                      <% assessmentSetMap.set(assessmentKey, {
                        assessmentId: assessmentKey,
                        assessmentTitle: setItem.assessment_title || ('Assessment ' + assessmentKey),
                        sets: []
                      }); %>
                    <% } %>
                    <% assessmentSetMap.get(assessmentKey).sets.push(setItem); %>
                  <% }); %>
                  <% const assessmentGroups = Array.from(assessmentSetMap.values()).sort(function(a, b) {
                    return String(a.assessmentTitle || '').localeCompare(String(b.assessmentTitle || ''));
                  }); %>
                  <div class="subject-group-head">
                    <h4 class="subject-group-title"><%= subjectGroup.subjectName %></h4>
                    <span class="subject-group-meta"><%= subjectGroup.sets.length %> set<%= subjectGroup.sets.length === 1 ? '' : 's' %></span>
                    <% if (assessmentGroups.length === 1) { %>
                      <span class="subject-group-assessment-inline"><%= assessmentGroups[0].assessmentTitle %></span>
                    <% } %>
                  </div>
                  <div class="assessment-group-list">
                    <% assessmentGroups.forEach(function(assessmentGroup) { %>
                      <section class="assessment-group js-assessment-group" data-assessment-id="<%= assessmentGroup.assessmentId %>" data-assessment-name="<%= String(assessmentGroup.assessmentTitle || '').toLowerCase() %>">
                        <% if (assessmentGroups.length > 1) { %>
                          <h5 class="assessment-group-head"><%= assessmentGroup.assessmentTitle %></h5>
                        <% } %>
                        <div class="exam-grid">
                          <% assessmentGroup.sets.forEach(function(setItem) { %>
                <% const reviewStatusKey = String(setItem.review_status || 'pending').toLowerCase(); %>
                <article class="exam-card js-question-set-details"
                  data-class-id="<%= Number(setItem.class_id || 0) %>"
                  data-class-name="<%= String(setItem.class_name || '').toLowerCase() %>"
                  data-subject-id="<%= Number(setItem.subject_id || 0) %>"
                  data-subject-name="<%= String(setItem.subject_name || '').toLowerCase() %>"
                  data-assessment-id="<%= Number(setItem.assessment_id || 0) %>"
                  data-assessment-title="<%= String(setItem.assessment_title || '').toLowerCase() %>"
                  data-review-status="<%= reviewStatusKey %>"
                  data-total-points="<%= Number(setItem.total_points || 0) %>"
                  data-question-count="<%= Number(setItem.question_count || 0) %>"
                  data-updated-at="<%= setItem.updated_at ? new Date(setItem.updated_at).getTime() : 0 %>"
                  data-set-title="<%= String(setItem.set_title || '').toLowerCase() %>">
            <div class="exam-summary">
              <div class="exam-title" title="<%= setItem.set_title %>">
                <strong><%= setItem.set_title || 'Question Set' %></strong>
                <span><%= setItem.class_name %> • <%= setItem.subject_name %> • <%= setItem.assessment_title %></span>
              </div>
              <span class="exam-pill"><%= setItem.question_count %> question<%= Number(setItem.question_count) === 1 ? '' : 's' %></span>
              <span class="exam-pill"><%= setItem.total_points %> pts</span>
              <span class="exam-pill"><%= setItem.open_book ? 'Open Book' : 'Secure' %></span>
              <% if (setItem.time_limit_minutes && Number(setItem.time_limit_minutes) > 0) { %>
                <span class="exam-pill"><%= Number(setItem.time_limit_minutes) %> min</span>
              <% } %>
              <div class="exam-summary-actions">
                <span class="exam-pill review-<%= reviewStatusKey %>">Review: <%= (setItem.review_status || 'pending').toUpperCase() %></span>
                <span class="exam-updated">Updated: <%= setItem.updated_at ? new Date(setItem.updated_at).toLocaleString() : '-' %></span>
                <div class="set-actions-menu">
                  <a href="#" class="set-actions-trigger" aria-haspopup="true" aria-expanded="false" title="More actions">...</a>
                  <div class="set-actions-dropdown" role="menu">
                    <% if (canReviewQuestionSets && (setItem.review_status || '').toLowerCase() === 'pending') { %>
                      <a
                        href="#"
                        class="set-action-link review-set-btn"
                        data-question-set-id="<%= setItem.question_set_id %>"
                        data-review-action="approve"
                      >Approve</a>
                      <a
                        href="#"
                        class="set-action-link review-set-btn"
                        data-question-set-id="<%= setItem.question_set_id %>"
                        data-review-action="reject"
                      >Reject</a>
                    <% } %>
                    <a
                      href="#"
                      class="set-action-link preview-set-btn"
                      data-question-set-id="<%= setItem.question_set_id %>"
                      data-assessment-id="<%= setItem.assessment_id %>"
                      data-class-id="<%= setItem.class_id %>"
                      data-class-name="<%= String(setItem.class_name || '').replace(/"/g, '&quot;') %>"
                      data-subject-id="<%= setItem.subject_id %>"
                      data-subject-name="<%= String(setItem.subject_name || '').replace(/"/g, '&quot;') %>"
                      data-term-id="<%= termId %>"
                      data-school-year-id="<%= selectedSchoolYearId %>"
                      data-set-title="<%= String(setItem.set_title || '').replace(/"/g, '&quot;') %>"
                      data-assessment-title="<%= String(setItem.assessment_title || '').replace(/"/g, '&quot;') %>"
                    >Preview</a>
                    <a
                      href="#"
                      class="set-action-link students-set-btn"
                      data-question-set-id="<%= setItem.question_set_id %>"
                      data-set-title="<%= String(setItem.set_title || '').replace(/"/g, '&quot;') %>"
                    >Students</a>
                    <a
                      href="#"
                      class="set-action-link edit-set-btn"
                      data-question-set-id="<%= setItem.question_set_id %>"
                      data-assessment-id="<%= setItem.assessment_id %>"
                      data-class-id="<%= setItem.class_id %>"
                      data-subject-id="<%= setItem.subject_id %>"
                      data-term-id="<%= termId %>"
                      data-school-year-id="<%= selectedSchoolYearId %>"
                    >Edit</a>
                    <a
                      href="#"
                      class="set-action-link reuse-set-btn"
                      data-question-set-id="<%= setItem.question_set_id %>"
                      data-set-title="<%= String(setItem.set_title || '').replace(/"/g, '&quot;') %>"
                      data-assessment-title="<%= String(setItem.assessment_title || '').replace(/"/g, '&quot;') %>"
                    >Reuse</a>
                    <a
                      href="#"
                      class="set-action-link delete-set-btn"
                      data-question-set-id="<%= setItem.question_set_id %>"
                      data-set-title="<%= String(setItem.set_title || '').replace(/"/g, '&quot;') %>"
                    >Delete</a>
                  </div>
                </div>
              </div>
            </div>
                </article>
                          <% }); %>
                        </div>
                      </section>
                    <% }); %>
                  </div>
                </section>
              <% }); %>
            </div>
          </section>
        <% }); %>
      </div>
      <div class="empty-state" id="question-set-filter-empty" hidden>No question sets match the current filters.</div>
    <% } %>
  </div>

