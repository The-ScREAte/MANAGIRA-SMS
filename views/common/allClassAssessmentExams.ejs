    /* One look for every pop-up drawer on this page: Review, Reuse, Edit, Preview and Mark. Same header, colours and buttons. */
    body .students-modal-overlay, body .reuse-modal-overlay, body .qm-preview-overlay, body .grade-modal-overlay { align-items: stretch; justify-content: flex-end; padding: 0; background: rgba(10, 20, 30, 0.55); }
    body .students-modal-overlay.show { display: flex; }
    body .students-modal { width: min(760px, 100vw); max-width: 100%; height: 100%; max-height: 100%; padding: 0; gap: 0; border: 0; border-radius: 0; background: #fff; box-shadow: -8px 0 40px rgba(0,0,0,0.18); animation: slideInRight 0.28s cubic-bezier(0.22, 1, 0.36, 1); display: flex; flex-direction: column; overflow: hidden; }
    .dr-head { display: flex; align-items: center; justify-content: space-between; gap: 12px; flex: none; padding: 12px 18px; background: #fff; border-bottom: 1px solid #e2e8f0; }
    .dr-head__text { min-width: 0; }
    .dr-head__title { margin: 0; color: #0f172a; font-size: 16px; font-weight: 600; line-height: 1.3; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .dr-head__sub { margin: 2px 0 0; color: #64748b; font-size: 12.5px; line-height: 1.3; }
    .dr-head__actions { display: flex; align-items: center; gap: 8px; flex: none; }
    .dr-icon-btn { display: inline-flex; align-items: center; justify-content: center; width: 34px; height: 34px; margin: 0; padding: 0; border: 1.5px solid #8ea3b6; border-radius: 9px; background: transparent; color: #334155; cursor: pointer; }
    .dr-icon-btn:hover { background: rgba(100, 116, 139, .14); }
    .dr-menu { position: relative; }
    .dr-menu__pop { position: absolute; top: calc(100% + 6px); right: 0; z-index: 20; min-width: 150px; padding: 6px; border: 1px solid #e2e8f0; border-radius: 10px; background: #fff; box-shadow: 0 12px 28px rgba(15, 23, 42, .16); }
    .dr-menu__pop[hidden] { display: none; }
    .dr-menu__item { display: block; width: 100%; margin: 0; padding: 8px 10px; border: 0; border-radius: 7px; background: none; color: #0f172a; font: inherit; font-size: 13.5px; font-weight: 500; text-align: left; cursor: pointer; }
    .dr-menu__item:hover { background: #f1f5f9; }
    .dr-menu__item:disabled { color: #94a3b8; cursor: default; background: none; }
    .dr-menu__item.is-danger { color: #b42318; }
    .dr-body { flex: 1 1 auto; min-height: 0; overflow: auto; padding: 14px 18px 18px; display: flex; flex-direction: column; gap: 12px; }
    .dr-muted { margin: 0; color: #64748b; font-size: 12.5px; }
    .dr-quiet-row { display: flex; flex-wrap: wrap; gap: 8px; }
    .dr-quiet { height: 32px; margin: 0; padding: 0 12px; border: 1px solid #cbd5e1; border-radius: 8px; background: #fff; color: #334155; font: inherit; font-size: 13.5px; font-weight: 600; cursor: pointer; }
    .dr-quiet:hover { background: #f8fafc; border-color: #94a3b8; }
    .dr-quiet:disabled { opacity: .55; cursor: default; }
    .students-toolbar { justify-content: space-between !important; }
    .students-toolbar .students-status { margin: 0; color: #64748b; font-size: 12.5px; }
    .students-table-wrap { border: 1px solid #e2e8f0; border-radius: 10px; overflow: auto; }
    .students-table th { background: #f8fafc; color: #475569; font-size: 12px; font-weight: 600; letter-spacing: .04em; text-transform: uppercase; }
    .students-table td { font-size: 14px; }
    .students-col-act { width: 44px; }
    .student-row-menu { position: relative; display: inline-block; }
    .student-row-menu .dr-menu__pop { right: 0; }
    .student-row-menu .dr-icon-btn { width: 30px; height: 30px; border-width: 1px; border-color: #cbd5e1; }
    .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0,0,0,0); white-space: nowrap; border: 0; }

    body .reuse-modal { padding: 0; background: #fff; }
    body .reuse-modal .reuse-modal-x { position: static; }
    .reuse-modal .dr-head__sub:empty { display: none; }
    .dr-quiet { width: auto; }
    /* Edit / Create / Preview / Mark drawers: the same bar as Review and Reuse. */
    body .qm-topbar { padding: 12px 18px; background: #fff; border-bottom: 1px solid #e2e8f0; }
    body .qm-topbar-icon { display: none; }
    body .qm-topbar-title { font-size: 16px; font-weight: 600; color: #0f172a; letter-spacing: 0; }
    body .qm-close-btn { width: 34px; height: 34px; border: 1.5px solid #8ea3b6; border-radius: 9px; background: transparent; color: #334155; }
    body .qm-close-btn:hover { background: rgba(100, 116, 139, .14); }
    body .question-modal { background: #f8fafc; }

    body .qm-preview-topbar, body .grade-modal-header { padding: 12px 18px; background: #fff; border-bottom: 1px solid #e2e8f0; }
    body .qm-preview-title, body .grade-modal-title { margin: 0; font-size: 16px; font-weight: 600; color: #0f172a; }
    body .grade-modal-subtitle { color: #64748b; font-size: 12.5px; }
    body .qm-preview-close, body .grade-modal-x { display: inline-flex; align-items: center; justify-content: center; width: 34px; height: 34px; padding: 0; border: 1.5px solid #8ea3b6; border-radius: 9px; background: transparent; color: #334155; font-size: 1.1rem; line-height: 1; cursor: pointer; }
    body .qm-preview-close:hover, body .grade-modal-x:hover { background: rgba(100, 116, 139, .14); }
    body .qm-preview-print { height: 34px; padding: 0 12px; border: 1px solid #cbd5e1; border-radius: 8px; background: #fff; color: #334155; font-size: 13.5px; font-weight: 600; }
    body .qm-preview-actions { flex: none; display: flex; align-items: center; gap: 8px; }
    body .qm-preview-topbar { gap: 12px; }
  </style>
  <style>
