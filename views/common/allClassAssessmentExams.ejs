          var originalLabel = reuseConfirmButton.textContent;
          reuseConfirmButton.textContent = 'Reusing...';
          setReuseStatus('Reusing question set...', false);

          try {
            var response = await fetch('/common/assessment/questions/reuse', {
              method: 'POST',
              headers: {
                'Content-Type': 'application/json',
                Accept: 'application/json',
              },
              body: JSON.stringify({
                sourceQuestionSetId: activeSourceQuestionSetId,
                targetTermId: targetTermId,
                targetClassId: targetClassId,
                targetSubjectId: targetSubjectId,
                targetAssessmentTitle: assessmentTitle,
                shuffleMode: shuffleMode,
                shuffleOptions: shouldShuffleOptions ? 'true' : 'false',
              }),
            });

            var result = await response.json();
            if (!response.ok || !result.success) {
              throw new Error(result.error || 'Failed to reuse question set.');
            }

            setReuseStatus(result.message || 'Question set reused successfully.', false);
            window.location.href = '/common/allClassAssessmentExams?organizationId=' + encodeURIComponent(String(organizationId)) + '&termId=' + encodeURIComponent(String(targetTermId));
          } catch (error) {
            setReuseStatus(error.message || 'Failed to reuse question set.', true);
          } finally {
            reuseConfirmButton.disabled = false;
            reuseConfirmButton.textContent = originalLabel;
          }
        });
      }

      var syncGoogleButton = document.getElementById('all-class-sync-google');
      if (syncGoogleButton) {
        syncGoogleButton.addEventListener('click', async function () {
          syncGoogleButton.disabled = true;
          var originalLabel = syncGoogleButton.textContent;
          syncGoogleButton.textContent = 'Syncing...';

          try {
            var response = await fetch('/account/google-classroom/resync', {
              method: 'POST',
              headers: { Accept: 'application/json' },
            });

            if (!response.ok) {
              throw new Error('Could not queue Google Classroom sync.');
            }

            alert('Google Classroom sync queued.');
          } catch (_) {
            alert('Could not queue Google Classroom sync.');
          } finally {
            syncGoogleButton.disabled = false;
            syncGoogleButton.textContent = originalLabel;
          }
        });
      }
    })();
  </script>
</body>
</html>
