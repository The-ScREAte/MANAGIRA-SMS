      var qmAnswerPasswordOverlay = document.getElementById('qm-answer-password-overlay');
      var qmAnswerPasswordInput = document.getElementById('qm-answer-password-input');
      var qmAnswerPasswordError = document.getElementById('qm-answer-password-error');
      var qmAnswerPasswordSubmit = document.getElementById('qm-answer-password-submit');
      var qmAnswerPasswordCancel = document.getElementById('qm-answer-password-cancel');
      var qmAnswerPasswordClose = document.getElementById('qm-answer-password-close');

      function setPreviewAnswersVisible(visible) {
        if (qmPreviewBody) {
          qmPreviewBody.classList.toggle('show-answers', Boolean(visible));
        }
        if (qmPreviewToggleAnswersButton) {
          qmPreviewToggleAnswersButton.classList.toggle('is-on', Boolean(visible));
          qmPreviewToggleAnswersButton.setAttribute('aria-checked', visible ? 'true' : 'false');
        }
      }

      function openAnswerPasswordModal() {
        if (!qmAnswerPasswordOverlay) return;
        if (qmAnswerPasswordInput) qmAnswerPasswordInput.value = '';
        if (qmAnswerPasswordError) qmAnswerPasswordError.textContent = '';
        qmAnswerPasswordOverlay.classList.add('show');
        qmAnswerPasswordOverlay.setAttribute('aria-hidden', 'false');
        if (qmAnswerPasswordInput) qmAnswerPasswordInput.focus();
      }

      function closeAnswerPasswordModal() {
        if (!qmAnswerPasswordOverlay) return;
        qmAnswerPasswordOverlay.classList.remove('show');
        qmAnswerPasswordOverlay.setAttribute('aria-hidden', 'true');
      }

      async function submitAnswerPassword() {
        var password = qmAnswerPasswordInput ? qmAnswerPasswordInput.value : '';
        if (!password) {
          if (qmAnswerPasswordError) qmAnswerPasswordError.textContent = 'Enter your password.';
          return;
        }

        var originalLabel = qmAnswerPasswordSubmit ? qmAnswerPasswordSubmit.textContent : '';
        if (qmAnswerPasswordSubmit) {
          qmAnswerPasswordSubmit.disabled = true;
          qmAnswerPasswordSubmit.textContent = 'Checking...';
        }

        try {
          var response = await fetch('/common/assessment/verify-answer-password', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
            body: JSON.stringify({ password: password }),
          });
          var result = await response.json();
          if (!response.ok || !result.success) {
            throw new Error(result.error || 'Incorrect password.');
          }

          setPreviewAnswersVisible(true);
          closeAnswerPasswordModal();
        } catch (error) {
          if (qmAnswerPasswordError) qmAnswerPasswordError.textContent = error.message || 'Incorrect password.';
        } finally {
          if (qmAnswerPasswordSubmit) {
            qmAnswerPasswordSubmit.disabled = false;
            qmAnswerPasswordSubmit.textContent = originalLabel;
          }
        }
      }

      if (qmPreviewToggleAnswersButton) {
        qmPreviewToggleAnswersButton.addEventListener('click', function () {
          var isCurrentlyOn = qmPreviewBody && qmPreviewBody.classList.contains('show-answers');
          if (isCurrentlyOn) {
            setPreviewAnswersVisible(false);
          } else {
            openAnswerPasswordModal();
          }
        });
      }

      if (qmAnswerPasswordSubmit) {
        qmAnswerPasswordSubmit.addEventListener('click', submitAnswerPassword);
      }
      if (qmAnswerPasswordInput) {
        qmAnswerPasswordInput.addEventListener('keydown', function (event) {
          if (event.key === 'Enter') {
            event.preventDefault();
            submitAnswerPassword();
          }
        });
      }
      if (qmAnswerPasswordCancel) {
        qmAnswerPasswordCancel.addEventListener('click', closeAnswerPasswordModal);
      }
      if (qmAnswerPasswordClose) {
        qmAnswerPasswordClose.addEventListener('click', closeAnswerPasswordModal);
      }

      function openQuestionPreview() {
        if (!qmPreviewOverlay) return;
        setPreviewEditVisible(false);
        setPreviewAnswersVisible(false);
        if (qmPreviewTitle) {
          qmPreviewTitle.textContent = 'Question Preview';
        }
        renderQuestionPreviewPayload(buildPreviewPayloadFromQuestionModal());
        qmPreviewOverlay.classList.add('show');
        qmPreviewOverlay.setAttribute('aria-hidden', 'false');
      }

      function closeQuestionPreview() {
        if (!qmPreviewOverlay) return;
        qmPreviewOverlay.classList.remove('show');
        qmPreviewOverlay.setAttribute('aria-hidden', 'true');
      }

      function updateQuestionHeaderActionLabels(count) {
        var total = Number(count || 0);
        var isCompactViewport = window.matchMedia('(max-width: 640px)').matches;

        var counter = document.getElementById('qm-question-count');
        if (counter) {
          counter.textContent = isCompactViewport
            ? (String(total) + ' Q')
            : (String(total) + ' question' + (total === 1 ? '' : 's'));
        }

        if (qmPreviewOpenButton) {
          qmPreviewOpenButton.textContent = isCompactViewport ? 'View' : 'Preview';
        }
      }

      function updateQuestionCount() {
        var count = document.querySelectorAll('#question-items .qm-question-card').length;
        updateQuestionHeaderActionLabels(count);
        // The gradebook gets the marks a student earns as they are, so show how the marks add up against the test.
        var counter = document.getElementById('qm-question-count');
        if (counter && count) {
          var totalMarks = Array.prototype.reduce.call(document.querySelectorAll('#question-items .question-marks'), function (sum, el) { return sum + (Number(el.value) || 0); }, 0);
          var outOf = typeof selectedAssessmentRule !== 'undefined' && selectedAssessmentRule ? Number(selectedAssessmentRule.maxScore) || 0 : 0;
          counter.textContent += ' · ' + totalMarks + (outOf ? ' / ' + outOf : '') + ' marks';
          var marksOff = Boolean(outOf) && Math.abs(totalMarks - outOf) >= 0.005;
          counter.classList.toggle('is-marks-off', marksOff);
          counter.title = marksOff
            ? 'Questions add up to ' + totalMarks + ', but the test is out of ' + outOf + '. Marks count as they are, they are not scaled.'
            : '';
        }
      }
      document.addEventListener('input', function (event) {
        if (event.target && event.target.classList && event.target.classList.contains('question-marks')) updateQuestionCount();
      });

      function applyQuestionCardsLayoutMode(layoutMode) {
        if (!questionItems) return;
        var normalizedMode = String(layoutMode || 'stacked').toLowerCase() === 'side_by_side'
          ? 'side_by_side'
          : 'stacked';

        if (qmQuestionsLayoutModeInput) {
          qmQuestionsLayoutModeInput.value = normalizedMode;
        }

        questionItems.classList.toggle('is-side-by-side', normalizedMode === 'side_by_side');
        questionItems.setAttribute('data-layout-mode', normalizedMode);

        updateOptionsLayoutToggleUI(qmQuestionsLayoutToggle, normalizedMode);
      }

      function renumberQuestionCards() {
        document.querySelectorAll('#question-items .qm-question-card').forEach(function (card, index) {
          var qNumber = card.querySelector('.qm-q-number');
          if (qNumber) qNumber.textContent = String(index + 1);
        });
      }

      function saveDraft() {
        var questions = [];
        document.querySelectorAll('#question-items .qm-question-card').forEach(function (card) {
          var optionValues = Array.prototype.slice.call(card.querySelectorAll('.question-option-input'))
            .map(function (input) { return String(input.value || '').trim(); })
            .filter(Boolean);
          var answerValues = readAnswerValues(card);
          questions.push({
            type: card.querySelector('.question-type') ? card.querySelector('.question-type').value : '',
            marks: card.querySelector('.question-marks') ? card.querySelector('.question-marks').value : 1,
            text: card.querySelector('.question-text') ? card.querySelector('.question-text').value : '',
            options: optionValues,
            answers: answerValues,
            optionLayout: card.querySelector('.qm-options-layout-select')
              ? card.querySelector('.qm-options-layout-select').value
              : 'stacked',
            media: window.QuestionBuilderFlow ? window.QuestionBuilderFlow.mediaOf(card) : null,
            help: window.QuestionHelp ? window.QuestionHelp.helpOf(card) : null,
            rubric: window.QuestionRubric ? window.QuestionRubric.rubricOf(card) : null,
          });
        });

        var draft = {
          schoolYearId: questionSchoolYearSelect ? questionSchoolYearSelect.value : '',
          termId: questionTermSelect ? questionTermSelect.value : '',
          classId: questionClassSelect ? questionClassSelect.value : '',
          subjectId: questionSubjectSelect ? questionSubjectSelect.value : '',
          assessmentId: questionAssessmentSelect ? questionAssessmentSelect.value : '',
          openBook: questionOpenBookSelect ? questionOpenBookSelect.value : 'false',
          timeMode: questionTimeModeSelect ? questionTimeModeSelect.value : 'timed',
          timeLimitMinutes: questionTimeLimitInput ? questionTimeLimitInput.value : '',
          maxAttempts: questionMaxAttemptsInput ? questionMaxAttemptsInput.value : '1',
          setTitle: questionSetTitleInput ? questionSetTitleInput.value : '',
          description: questionSetDescriptionInput ? questionSetDescriptionInput.value : '',
          questionCardLayout: questionItems
            ? String(questionItems.getAttribute('data-layout-mode') || 'stacked')
            : 'stacked',
          questions: questions,
          savedAt: Date.now(),
        };

        try { localStorage.setItem(DRAFT_KEY, JSON.stringify(draft)); } catch (_) {}
      }

      function loadDraft() {
        try {
          var raw = localStorage.getItem(DRAFT_KEY);
          return raw ? JSON.parse(raw) : null;
        } catch (_) {
          return null;
        }
      }

      function clearDraft() {
        try { localStorage.removeItem(DRAFT_KEY); } catch (_) {}
        if (qmDraftBanner) qmDraftBanner.style.display = 'none';
      }

      function restoreDraft(draft) {
        if (!draft) return;

        if (questionSchoolYearSelect && draft.schoolYearId) questionSchoolYearSelect.value = draft.schoolYearId;
        if (questionTermSelect && draft.termId) questionTermSelect.value = draft.termId;
        if (questionClassSelect && draft.classId) questionClassSelect.value = draft.classId;
        if (questionSubjectSelect && draft.subjectId) questionSubjectSelect.value = draft.subjectId;
        if (questionAssessmentSelect && draft.assessmentId) questionAssessmentSelect.value = draft.assessmentId;
        if (questionOpenBookSelect && draft.openBook !== undefined && draft.openBook !== null) {
          questionOpenBookSelect.value = String(draft.openBook) === 'true' ? 'true' : 'false';
        }
        if (questionTimeModeSelect && draft.timeMode) {
          questionTimeModeSelect.value = String(draft.timeMode).toLowerCase() === 'unlimited' ? 'unlimited' : 'timed';
        }
        if (questionTimeLimitInput && draft.timeLimitMinutes !== undefined && draft.timeLimitMinutes !== null) {
          questionTimeLimitInput.value = String(draft.timeLimitMinutes || '').trim();
        }
        if (questionMaxAttemptsInput && draft.maxAttempts !== undefined && draft.maxAttempts !== null) {
          var draftAttempts = Number.parseInt(String(draft.maxAttempts || '').trim(), 10);
          questionMaxAttemptsInput.value = String(Number.isInteger(draftAttempts) && draftAttempts > 0 ? draftAttempts : 1);
        }
        syncQuestionTimeLimitUi();
        if (questionSetTitleInput && draft.setTitle) questionSetTitleInput.value = draft.setTitle;
        if (questionSetDescriptionInput && draft.description) questionSetDescriptionInput.value = draft.description;

        applyQuestionCardsLayoutMode(draft.questionCardLayout || 'stacked');

        if (questionItems && Array.isArray(draft.questions) && draft.questions.length) {
          questionItems.innerHTML = '';
          draft.questions.forEach(function (q) {
            var restoredOptions = [];
            if (Array.isArray(q.options)) {
              restoredOptions = q.options;
            } else if (typeof q.options === 'string' && q.options.trim()) {
              restoredOptions = q.options.split(',').map(function (s) { return s.trim(); }).filter(Boolean);
            }
            var card = buildQuestionItem({
              questionType: q.type,
              marks: q.marks,
              questionText: q.text,
              options: restoredOptions,
              optionLayout: q.optionLayout || 'stacked',
              answerKeys: Array.isArray(q.answers)
                ? q.answers
                : (q.answer ? [q.answer] : []),
              media: q.media || null,
              help: q.help || null,
            });
            questionItems.appendChild(card);
          });
        }

        if (qmDraftBanner) qmDraftBanner.style.display = 'flex';
        renumberQuestionCards();
        updateQuestionCount();
      }

      function renderQuestionModalSchoolYears() {
        if (!questionSchoolYearSelect) return;
        questionSchoolYearSelect.innerHTML = '';

        schoolYears.forEach(function (year) {
          var opt = document.createElement('option');
          opt.value = String(year.schoolYearId);
          opt.textContent = year.yearLabel;
          questionSchoolYearSelect.appendChild(opt);
        });

        if (!schoolYears.length) return;
        var currentSchoolYearId = Number(selectedSchoolYearId || 0);
        var workspaceSchoolYearId = Number(schoolYearSelect ? schoolYearSelect.value : 0);
        var fallbackSchoolYearId = currentSchoolYearId > 0 ? currentSchoolYearId : workspaceSchoolYearId;
        var exists = schoolYears.some(function (year) {
          return Number(year.schoolYearId) === Number(fallbackSchoolYearId);
        });
        questionSchoolYearSelect.value = String(exists ? fallbackSchoolYearId : Number(schoolYears[0].schoolYearId));
      }

      function renderQuestionModalTerms() {
        if (!questionTermSelect || !questionSchoolYearSelect) return;
        questionTermSelect.innerHTML = '';

        var schoolYearId = Number(questionSchoolYearSelect.value || 0);
        var schoolYear = schoolYears.find(function (year) {
          return Number(year.schoolYearId) === schoolYearId;
        });
        var terms = schoolYear && Array.isArray(schoolYear.terms) ? schoolYear.terms : [];

        terms.forEach(function (term) {
          var opt = document.createElement('option');
          opt.value = String(term.termId);
          opt.textContent = term.termName;
          questionTermSelect.appendChild(opt);
        });

        if (!terms.length) return;
        var preferredTermId = Number(termSelect ? termSelect.value : selectedTermId);
        var hasPreferredTerm = terms.some(function (term) {
          return Number(term.termId) === Number(preferredTermId);
        });
        questionTermSelect.value = String(hasPreferredTerm ? preferredTermId : Number(terms[0].termId));
      }

      function renderQuestionModalClasses() {
        if (!questionClassSelect || !questionTermSelect) return;
        questionClassSelect.innerHTML = '';

        var selectedQuestionTermId = Number(questionTermSelect.value || 0);
        var classMap = new Map();
        termClassSubjects.forEach(function (row) {
          if (Number(row.term_id || 0) !== selectedQuestionTermId) return;
          var classId = Number(row.class_id || 0);
          if (classId <= 0 || classMap.has(classId)) return;
          classMap.set(classId, {
            class_id: classId,
            class_name: row.class_name || ('Class ' + classId),
          });
        });

        Array.from(classMap.values())
          .sort(function (left, right) {
            var lt = termHasTests(selectedQuestionTermId, left.class_id) ? 0 : 1;
            var rt = termHasTests(selectedQuestionTermId, right.class_id) ? 0 : 1;
            return lt - rt || String(left.class_name).localeCompare(String(right.class_name));
          })
          .forEach(function (row) {
            var opt = document.createElement('option');
            opt.value = String(row.class_id);
            opt.textContent = row.class_name + (termHasTests(selectedQuestionTermId, row.class_id) ? '' : ' — no tests yet');
            questionClassSelect.appendChild(opt);
          });

        if (questionClassSelect.options.length) {
          var hasSelectedClass = Array.from(questionClassSelect.options).some(function (opt) {
            return Number(opt.value || 0) === selectedClassId;
          });
          if (hasSelectedClass) {
            questionClassSelect.value = String(selectedClassId);
          } else {
            questionClassSelect.selectedIndex = 0; // first class with tests
          }
        }
      }

      // Classes and subjects that have at least one test this term come first,
      // and are picked by default so the editor never opens on an empty choice.
      function termHasTests(termId, classId, subjectId) {
        return (assessmentsForTermData || []).some(function (a) {
          return Number(a.term_id || 0) === Number(termId)
            && Number(a.class_id || 0) === Number(classId)
            && (subjectId == null || Number(a.subject_id || 0) === Number(subjectId));
        });
      }

      function renderQuestionModalSubjects() {
        if (!questionSubjectSelect || !questionTermSelect || !questionClassSelect) return;
        questionSubjectSelect.innerHTML = '';

        var selectedQuestionTermId = Number(questionTermSelect.value || 0);
        var selectedQuestionClassId = Number(questionClassSelect.value || 0);
        var subjectMap = new Map();

        termClassSubjects.forEach(function (row) {
          if (Number(row.term_id || 0) !== selectedQuestionTermId) return;
          if (Number(row.class_id || 0) !== selectedQuestionClassId) return;
          var subjectId = Number(row.subject_id || 0);
          if (subjectId <= 0 || subjectMap.has(subjectId)) return;
          subjectMap.set(subjectId, {
            subject_id: subjectId,
            subject_name: row.subject_name || ('Subject ' + subjectId),
          });
        });

        var previousSubjectId = Number(questionSubjectSelect.getAttribute('data-last') || 0);
        Array.from(subjectMap.values())
          .sort(function (left, right) {
            var lt = termHasTests(selectedQuestionTermId, selectedQuestionClassId, left.subject_id) ? 0 : 1;
            var rt = termHasTests(selectedQuestionTermId, selectedQuestionClassId, right.subject_id) ? 0 : 1;
            return lt - rt || String(left.subject_name).localeCompare(String(right.subject_name));
          })
          .forEach(function (row) {
            var opt = document.createElement('option');
            opt.value = String(row.subject_id);
            opt.textContent = row.subject_name + (termHasTests(selectedQuestionTermId, selectedQuestionClassId, row.subject_id) ? '' : ' — no tests yet');
            questionSubjectSelect.appendChild(opt);
          });
        if (previousSubjectId && subjectMap.has(previousSubjectId)) questionSubjectSelect.value = String(previousSubjectId);
        questionSubjectSelect.setAttribute('data-last', questionSubjectSelect.value || '');
      }

      async function renderQuestionModalAssessments() {
        if (!questionAssessmentSelect || !questionTermSelect || !questionSchoolYearSelect) return;
        // Only the latest load fills the list (two quick changes used to add every test twice).
        var renderSeq = (renderQuestionModalAssessments.seq = (renderQuestionModalAssessments.seq || 0) + 1);
        var previousAssessmentId = Number(questionAssessmentSelect.value || 0);
        questionAssessmentSelect.innerHTML = '';

        var selectedQuestionTermId = Number(questionTermSelect.value || 0);
        var selectedQuestionSchoolYearId = Number(questionSchoolYearSelect.value || 0);
        var selectedQuestionClassId = Number(questionClassSelect && questionClassSelect.value ? questionClassSelect.value : 0);
        var selectedQuestionSubjectId = Number(questionSubjectSelect && questionSubjectSelect.value ? questionSubjectSelect.value : 0);

        if (!selectedQuestionTermId || !selectedQuestionSchoolYearId) {
          return;
        }

        if (selectedQuestionClassId <= 0) {
          setQuestionStatus('Select a class to load assessments.', true);
          return;
        }

        var requestUrl = '/common/assessment/options?schoolYearId=' + encodeURIComponent(String(selectedQuestionSchoolYearId)) +
          '&termId=' + encodeURIComponent(String(selectedQuestionTermId)) +
          '&classId=' + encodeURIComponent(String(selectedQuestionClassId));

        if (selectedQuestionSubjectId > 0) {
          requestUrl += '&subjectId=' + encodeURIComponent(String(selectedQuestionSubjectId));
        }

        var response;
        var payload;
        try {
          response = await fetch(requestUrl, { headers: { Accept: 'application/json' } });
          payload = await response.json();
        } catch (_error) {
          setQuestionStatus('Failed to load assessments for selected scope.', true);
          return;
        }

        if (!response.ok || !payload.success) {
          setQuestionStatus((payload && payload.error) || 'Failed to load assessments for selected scope.', true);
          return;
        }

        if (renderSeq !== renderQuestionModalAssessments.seq) return;
        questionAssessmentSelect.innerHTML = '';
        var assessments = Array.isArray(payload.assessments) ? payload.assessments : [];
        var filtered = assessments.filter(function (assessment) {
          var assessmentSchoolYearId = Number(assessment.school_year_id || 0);
          var assessmentTermId = Number(assessment.term_id || 0);
          var assessmentClassId = Number(assessment.class_id || 0);
          var assessmentSubjectId = Number(assessment.subject_id || 0);

          if (assessmentSchoolYearId !== selectedQuestionSchoolYearId) return false;
          if (assessmentTermId !== selectedQuestionTermId) return false;
          if (assessmentClassId !== selectedQuestionClassId) return false;
          if (selectedQuestionSubjectId > 0 && assessmentSubjectId !== selectedQuestionSubjectId) return false;
          return true;
        });

        var seenAssessmentIds = new Set();
        filtered.forEach(function (assessment) {
          var assessmentId = Number(assessment.assessment_id || 0);
          if (!assessmentId || seenAssessmentIds.has(assessmentId)) {
            return;
          }
          seenAssessmentIds.add(assessmentId);

          assessmentRuleMap.set(assessmentId, {
            assessmentId: assessmentId,
            termId: Number(assessment.term_id),
            schoolYearId: Number(assessment.school_year_id),
            classId: Number(assessment.class_id),
            subjectId: Number(assessment.subject_id),
            title: assessment.title,
            weight: Number(assessment.weight || 0),
            maxScore: Number(assessment.max_score || 0),
            category: assessment.category || 'Assessment',
            scaleBase: Number(assessment.scale_base || 100),
            openBook: Boolean(assessment.open_book),
            timeLimitMinutes: assessment.time_limit_minutes !== null && assessment.time_limit_minutes !== undefined
              ? Number(assessment.time_limit_minutes)
              : null,
            maxAttempts: Number(assessment.max_attempts || 1),
            canEditScores: Boolean(assessment.can_edit_scores),
            accessReason: assessment.access_reason || '',
          });

          var opt = document.createElement('option');
          opt.value = String(assessmentId);
          opt.textContent = String(assessment.title || 'Test');
          questionAssessmentSelect.appendChild(opt);
        });

        if (questionAssessmentSelect.options.length) {
          var hasPreviousAssessment = Array.prototype.slice.call(questionAssessmentSelect.options).some(function (opt) {
            return Number(opt.value || 0) === previousAssessmentId;
          });
          if (hasPreviousAssessment) {
            questionAssessmentSelect.value = String(previousAssessmentId);
          }
        }

        if (!questionAssessmentSelect.options.length) {
          setQuestionStatus('No tests for this class and subject yet. Create one in Assessments first, or pick another subject.', true);
        } else {
          setQuestionStatus('Pick the test these questions are for.', false);
        }
      }

      function resolveSelectedAssessmentRule() {
        var assessmentId = Number(questionAssessmentSelect ? questionAssessmentSelect.value : 0);
        return assessmentRuleMap.get(assessmentId) || null;
      }

      function applyAssessmentMarksLimit(maxScore) {
        var numericMax = Number(maxScore || 0);
        var normalizedMax = Number.isFinite(numericMax) && numericMax > 0 ? numericMax : null;
        document.querySelectorAll('#question-items .qm-question-card .question-marks').forEach(function (input) {
          if (normalizedMax) {
            input.setAttribute('max', String(normalizedMax));
          } else {
            input.removeAttribute('max');
          }
        });
      }

      function renderAssessmentRulesSummary(options) {
        var forceHydrateModeInputs = Boolean(options && options.forceHydrateModeInputs);
        selectedAssessmentRule = resolveSelectedAssessmentRule();
        if (!questionAssessmentRules) return;

        if (!selectedAssessmentRule) {
          questionAssessmentRules.style.display = 'none';
          questionAssessmentRules.textContent = 'Assessment rules unavailable for this selection.';
          if (questionOpenBookSelect) questionOpenBookSelect.value = 'false';
          if (questionTimeModeSelect) questionTimeModeSelect.value = 'timed';
          if (questionTimeLimitInput) questionTimeLimitInput.value = '';
          if (questionMaxAttemptsInput) questionMaxAttemptsInput.value = '1';
          hasManualAssessmentModeEdits = false;
          syncQuestionTimeLimitUi();
          return;
        }

        questionAssessmentRules.style.display = 'block';

        if (forceHydrateModeInputs || !hasManualAssessmentModeEdits) {
          resetAssessmentModeInputsFromRule(selectedAssessmentRule);
          hasManualAssessmentModeEdits = false;
        }

        var summary = getCurrentAssessmentModeSummaryText(selectedAssessmentRule);

        var statusLabel = selectedAssessmentRule.canEditScores
          ? 'Editable'
          : 'Locked for editing (' + (selectedAssessmentRule.accessReason || 'Not editable') + ')';

        questionAssessmentRules.textContent = window.QuestionBuilderFlow
          ? selectedAssessmentRule.title + ' · up to ' + selectedAssessmentRule.maxScore + ' marks · ' + 'weight ' + selectedAssessmentRule.weight +
            (selectedAssessmentRule.canEditScores ? '' : ' · ' + statusLabel)
          : 'Rules: ' + selectedAssessmentRule.title +
          ' | Category: ' + selectedAssessmentRule.category +
          ' | Weight: ' + selectedAssessmentRule.weight +
          ' | Max score: ' + selectedAssessmentRule.maxScore +
          ' | Scale: ' + selectedAssessmentRule.scaleBase +
          ' | Mode: ' + summary.modeLabel +
          ' | Time: ' + summary.timeLabel +
          ' | Attempts: ' + summary.attemptsLabel +
          ' | Status: ' + statusLabel;

        applyAssessmentMarksLimit(selectedAssessmentRule.maxScore);
      }

      function setQuestionEditorEnabled(isEnabled) {
        if (addQuestionItemButton) {
          addQuestionItemButton.disabled = !isEnabled;
        }
        if (saveQuestionSetButton) {
          saveQuestionSetButton.disabled = !isEnabled;
        }
      }

      function openQuestionModal() {
        if (!questionModalOverlay) return;
        questionModalOverlay.classList.add('show');
        questionModalOverlay.setAttribute('aria-hidden', 'false');
      }

      function setQuestionModalMode(mode) {
        questionModalMode = mode === 'edit' ? 'edit' : 'create';
        if (questionModalOverlay) {
          var modalRoot = questionModalOverlay.querySelector('.question-modal');
          if (modalRoot) {
            modalRoot.classList.add('is-edit-mode');
          }
        }
        var modalTitle = document.getElementById('question-modal-title');
        if (modalTitle) {
          modalTitle.textContent = questionModalMode === 'edit' ? 'Edit Questions' : 'Create Questions';
        }
        if (saveQuestionSetButton) {
          renderSaveButtonIdle();
        }
      }

      function hasTypedQuestionContent(wrapper) {
        if (!wrapper) return false;

        var hiddenQuestionText = wrapper.querySelector('.question-text');
        if (hiddenQuestionText && String(hiddenQuestionText.value || '').trim()) {
          return true;
        }

        var optionInputs = Array.prototype.slice.call(wrapper.querySelectorAll('.question-option-input'));
        if (optionInputs.some(function (input) { return String(input.value || '').trim(); })) {
          return true;
        }

        if (readAnswerValues(wrapper).length) {
          return true;
        }

        return false;
      }

      function closeQuestionModal() {
        if (!questionModalOverlay) return;
        questionModalOverlay.classList.remove('show');
        questionModalOverlay.setAttribute('aria-hidden', 'true');
        if (window.QuestionBuilderFlow) window.QuestionBuilderFlow.closed();
      }

      function appendOptionInput(optionList, optionValue) {
        if (!optionList) return;
        var row = document.createElement('div');
        row.className = 'question-option-row';

        var input = document.createElement('input');
        input.type = 'text';
        input.className = 'question-option-input';
        input.placeholder = 'Option text';
        input.value = optionValue || '';

        var removeBtn = document.createElement('button');
        removeBtn.type = 'button';
        removeBtn.className = 'question-option-remove';
        removeBtn.title = 'Remove option';
        removeBtn.textContent = '−';

        removeBtn.addEventListener('click', function () {
          row.remove();
          if (!optionList.querySelector('.question-option-row')) {
            appendOptionInput(optionList, '');
          }
          saveDraft();
        });

        row.appendChild(input);
        row.appendChild(removeBtn);
        optionList.appendChild(row);
        return row;
      }

      function applyOptionsLayoutMode(optionList, layoutMode) {
        if (!optionList) return;
        var mode = String(layoutMode || 'stacked').toLowerCase();
        var normalizedMode = mode === 'side_by_side' ? 'side_by_side' : 'stacked';

        optionList.classList.toggle('is-side-by-side', normalizedMode === 'side_by_side');
        optionList.setAttribute('data-layout-mode', normalizedMode);
      }

      function updateOptionsLayoutToggleUI(toggleWrap, layoutMode) {
        if (!toggleWrap) return;
        var normalizedMode = String(layoutMode || 'stacked').toLowerCase() === 'side_by_side'
          ? 'side_by_side'
          : 'stacked';

        Array.prototype.slice.call(toggleWrap.querySelectorAll('.qm-options-layout-btn')).forEach(function (btn) {
          var btnMode = btn.getAttribute('data-layout') === 'side_by_side' ? 'side_by_side' : 'stacked';
          var isActive = btnMode === normalizedMode;
          btn.classList.toggle('is-active', isActive);
          btn.setAttribute('aria-pressed', isActive ? 'true' : 'false');
        });
      }

      function parseAnswerValues(raw) {
        if (Array.isArray(raw)) {
          return raw.map(function (item) { return String(item || '').trim(); }).filter(Boolean);
        }
        var normalized = String(raw || '').trim();
        if (!normalized) return [];

        if ((normalized.startsWith('[') && normalized.endsWith(']')) || (normalized.startsWith('{') && normalized.endsWith('}'))) {
          try {
            var parsed = JSON.parse(normalized);
            if (Array.isArray(parsed)) {
              return parsed.map(function (item) { return String(item || '').trim(); }).filter(Boolean);
            }
          } catch (_) {
          }
        }

        if (normalized.indexOf('||') !== -1) {
          return normalized.split('||').map(function (part) { return String(part || '').trim(); }).filter(Boolean);
        }

        return [normalized];
      }

      function serializeAnswerValues(values) {
        var cleaned = Array.isArray(values)
          ? values.map(function (item) { return String(item || '').trim(); }).filter(Boolean)
          : [];
        if (!cleaned.length) return '';
        if (cleaned.length === 1) return cleaned[0];
        return JSON.stringify(cleaned);
      }

      function readAnswerValues(rootElement) {
        if (!rootElement) return [];
        var values = [];

        Array.prototype.slice.call(rootElement.querySelectorAll('.question-answer-input')).forEach(function (input) {
          if (!input) return;

          if (input.type === 'checkbox') {
            if (input.checked) {
              var checkedValue = String(input.value || '').trim();
              if (checkedValue) values.push(checkedValue);
            }
            return;
          }

          if (input.tagName === 'SELECT' && input.multiple) {
            Array.prototype.slice.call(input.selectedOptions || []).forEach(function (option) {
              var selectedValue = String(option.value || '').trim();
              if (selectedValue) values.push(selectedValue);
            });
            return;
          }

          var value = String(input.value || '').trim();
          if (value) values.push(value);
        });

        return values;
      }

      function appendAnswerInput(answerList, answerValue) {
        if (!answerList) return;
        var row = document.createElement('div');
        row.className = 'question-answer-row';

        var input = document.createElement('input');
        input.type = 'text';
        input.className = 'question-answer-input';
        input.placeholder = 'Correct answer';
        input.value = answerValue || '';

        var removeBtn = document.createElement('button');
        removeBtn.type = 'button';
        removeBtn.className = 'question-option-remove';
        removeBtn.title = 'Remove answer';
        removeBtn.textContent = '−';

        removeBtn.addEventListener('click', function () {
          row.remove();
          if (!answerList.querySelector('.question-answer-row')) {
            appendAnswerInput(answerList, '');
          }
          saveDraft();
        });

        row.appendChild(input);
        row.appendChild(removeBtn);
        answerList.appendChild(row);
        return row;
      }

      function appendAnswerCheckboxRows(answerList, optionValues, selectedValues) {
        if (!answerList) return;
        answerList.innerHTML = '';

        var normalizedOptions = Array.isArray(optionValues)
          ? optionValues.map(function (value) { return String(value || '').trim(); }).filter(Boolean)
          : [];
        var selectedSet = new Set(
          Array.isArray(selectedValues)
            ? selectedValues.map(function (value) { return String(value || '').trim(); }).filter(Boolean)
            : []
        );

        if (!normalizedOptions.length) {
          var emptyHint = document.createElement('div');
          emptyHint.className = 'question-answer-empty';
          emptyHint.textContent = 'Add options to choose the correct answers.';
          answerList.appendChild(emptyHint);
          return;
        }

        normalizedOptions.forEach(function (value, index) {
          var row = document.createElement('label');
          row.className = 'question-answer-check-row';

          var checkbox = document.createElement('input');
          checkbox.type = 'checkbox';
          checkbox.className = 'question-answer-input question-answer-checkbox';
          checkbox.value = value;
          checkbox.checked = selectedSet.has(value);
          checkbox.setAttribute('aria-label', 'Correct answer option ' + String(index + 1));

          var text = document.createElement('span');
          text.className = 'question-answer-check-label';
          text.textContent = value;

          row.appendChild(checkbox);
          row.appendChild(text);
          answerList.appendChild(row);
        });
      }

      function appendAnswerSelectInput(answerList, answerValue, optionValues, placeholderText, allowMultiSelect, selectedValues) {
        if (!answerList) return;
        var row = document.createElement('div');
        row.className = 'question-answer-row';

        var select = document.createElement('select');
        select.className = 'question-answer-input question-answer-select';

        var normalizedOptions = Array.isArray(optionValues)
          ? optionValues.map(function (value) { return String(value || '').trim(); }).filter(Boolean)
          : [];

        var normalizedSelectedValues = Array.isArray(selectedValues)
          ? selectedValues.map(function (value) { return String(value || '').trim(); }).filter(Boolean)
          : [];

        if (allowMultiSelect) {
          select.multiple = true;
          select.size = Math.min(Math.max(normalizedOptions.length || 2, 2), 6);
          select.title = placeholderText || 'Select one or more correct options';
        }

        if (!allowMultiSelect) {
          var placeholderOption = document.createElement('option');
          placeholderOption.value = '';
          placeholderOption.textContent = placeholderText || 'Select correct option';
          select.appendChild(placeholderOption);
        }

        normalizedOptions.forEach(function (value) {
          var option = document.createElement('option');
          option.value = value;
          option.textContent = value;
          if (allowMultiSelect && normalizedSelectedValues.includes(value)) {
            option.selected = true;
          }
          select.appendChild(option);
        });

        var normalizedAnswer = String(answerValue || '').trim();
        if (allowMultiSelect) {
          normalizedSelectedValues.forEach(function (value) {
            if (!value || normalizedOptions.includes(value)) return;
            var missingSelectedOption = document.createElement('option');
            missingSelectedOption.value = value;
            missingSelectedOption.textContent = value;
            missingSelectedOption.selected = true;
            select.appendChild(missingSelectedOption);
          });
        } else if (normalizedAnswer && !normalizedOptions.includes(normalizedAnswer)) {
          var missingOption = document.createElement('option');
          missingOption.value = normalizedAnswer;
          missingOption.textContent = normalizedAnswer;
          select.appendChild(missingOption);
        }
        if (!allowMultiSelect) {
          select.value = normalizedAnswer;
        }

        var removeBtn = document.createElement('button');
        removeBtn.type = 'button';
        removeBtn.className = 'question-option-remove';
        removeBtn.title = 'Remove answer';
        removeBtn.textContent = '−';

        removeBtn.addEventListener('click', function () {
          row.remove();
          if (!answerList.querySelector('.question-answer-row')) {
            appendAnswerSelectInput(answerList, '', optionValues, placeholderText, allowMultiSelect, selectedValues);
          }
          saveDraft();
        });

        row.appendChild(select);
        row.appendChild(removeBtn);
        answerList.appendChild(row);
        return row;
      }

      function setOptionRows(optionList, values, isReadOnly) {
        if (!optionList) return;
        optionList.innerHTML = '';
        var normalizedValues = Array.isArray(values) ? values : [];

        if (!normalizedValues.length) {
          normalizedValues = [''];
        }

        normalizedValues.forEach(function (value) {
          var row = appendOptionInput(optionList, value);
          if (!row) return;
          var input = row.querySelector('.question-option-input');
          var removeBtn = row.querySelector('.question-option-remove');
          if (input) input.readOnly = Boolean(isReadOnly);
          if (removeBtn) removeBtn.style.display = isReadOnly ? 'none' : 'inline-flex';
        });
      }

      function setAnswerRows(answerList, values, allowMultiple, placeholderText, config) {
        if (!answerList) return;
        answerList.innerHTML = '';

        var mode = config && (config.mode === 'option_select' || config.mode === 'option_checkboxes')
          ? config.mode
          : 'text';
        var optionValues = config && Array.isArray(config.optionValues) ? config.optionValues : [];
        var selectPlaceholder = config && config.selectPlaceholder
          ? String(config.selectPlaceholder)
          : (placeholderText || 'Select correct option');

        var normalizedValues = Array.isArray(values)
          ? values.map(function (value) { return String(value || '').trim(); }).filter(Boolean)
          : [];

        if (mode === 'option_checkboxes') {
          appendAnswerCheckboxRows(answerList, optionValues, normalizedValues);
          return;
        }

        if (!normalizedValues.length) {
          normalizedValues = [''];
        }

        if (!allowMultiple) {
          normalizedValues = [normalizedValues[0] || ''];
        }

        if (mode === 'option_select' && allowMultiple) {
          var multiSelectRow = appendAnswerSelectInput(
            answerList,
            '',
            optionValues,
            selectPlaceholder,
            true,
            normalizedValues
          );
          if (multiSelectRow) {
            var multiRemoveBtn = multiSelectRow.querySelector('.question-option-remove');
            if (multiRemoveBtn) multiRemoveBtn.style.display = 'none';
          }
          return;
        }

        normalizedValues.forEach(function (value) {
          var row = mode === 'option_select'
            ? appendAnswerSelectInput(answerList, value, optionValues, selectPlaceholder, false)
            : appendAnswerInput(answerList, value);
          if (!row) return;
          var input = row.querySelector('.question-answer-input');
          var removeBtn = row.querySelector('.question-option-remove');
          if (input && mode !== 'option_select' && placeholderText) input.placeholder = placeholderText;
          if (removeBtn) removeBtn.style.display = allowMultiple ? 'inline-flex' : 'none';
        });
      }

      function getOptionsBasedAnswerChoices(wrapper, type) {
        if (!wrapper) return [];

        if (type === 'true_false') {
          return ['True', 'False'];
        }

        return Array.prototype.slice.call(wrapper.querySelectorAll('.question-option-input'))
          .map(function (input) { return String(input.value || '').trim(); })
          .filter(Boolean);
      }

      function syncOptionBasedAnswerRows(wrapper) {
        if (!wrapper) return;

        var typeSelect = wrapper.querySelector('.question-type');
        var answerList = wrapper.querySelector('.question-answer-list');
        if (!typeSelect || !answerList) return;

        var type = String(typeSelect.value || 'short_text');
        if (type !== 'multiple_choice' && type !== 'single_choice' && type !== 'true_false') return;

        var optionValues = getOptionsBasedAnswerChoices(wrapper, type);
        var selectedAnswers = readAnswerValues(answerList)
          .filter(function (value) {
            return optionValues.includes(value);
          });

        setAnswerRows(
          answerList,
          selectedAnswers,
          type === 'multiple_choice',
          type === 'true_false' ? 'Select True or False' : 'Select correct option',
          {
            mode: type === 'multiple_choice' ? 'option_checkboxes' : 'option_select',
            optionValues: optionValues,
            selectPlaceholder: type === 'true_false' ? 'Select True or False' : 'Select correct option',
          }
        );
      }

      function applyQuestionTypeBehavior(wrapper) {
        if (!wrapper) return;

        var typeSelect = wrapper.querySelector('.question-type');
        var optionsField = wrapper.querySelector('.qm-options-field');
        var optionsList = wrapper.querySelector('.question-options-list');
        var addOptionButton = wrapper.querySelector('.qm-option-add-btn');
        var answerLabel = wrapper.querySelector('.question-answer-label');
        var answerList = wrapper.querySelector('.question-answer-list');
        var addAnswerButton = wrapper.querySelector('.qm-answer-add-btn');
        if (!typeSelect) return;

        var type = String(typeSelect.value || 'short_text');
        var currentOptions = Array.prototype.slice.call(wrapper.querySelectorAll('.question-option-input'))
          .map(function (input) { return String(input.value || '').trim(); })
          .filter(Boolean);
        var currentAnswers = readAnswerValues(wrapper);

        if (type === 'multiple_choice') {
          if (optionsField) optionsField.classList.remove('is-hidden');
          if (addOptionButton) addOptionButton.style.display = 'inline-flex';
          if (answerLabel) answerLabel.textContent = 'Answer Key';
          if (addAnswerButton) addAnswerButton.style.display = 'none';

          setOptionRows(optionsList, currentOptions, false);
          setAnswerRows(answerList, currentAnswers, true, 'Select correct option', {
            mode: 'option_checkboxes',
            optionValues: getOptionsBasedAnswerChoices(wrapper, type),
            selectPlaceholder: 'Select correct option',
          });
          return;
        }

        if (type === 'single_choice') {
          if (optionsField) optionsField.classList.remove('is-hidden');
          if (addOptionButton) addOptionButton.style.display = 'inline-flex';
          if (answerLabel) answerLabel.textContent = 'Correct Answer';
          if (addAnswerButton) addAnswerButton.style.display = 'none';

          setOptionRows(optionsList, currentOptions, false);
          setAnswerRows(answerList, currentAnswers, false, 'Select correct option', {
            mode: 'option_select',
            optionValues: getOptionsBasedAnswerChoices(wrapper, type),
            selectPlaceholder: 'Select correct option',
          });
          return;
        }

        if (type === 'true_false') {
          if (optionsField) optionsField.classList.remove('is-hidden');
          if (addOptionButton) addOptionButton.style.display = 'none';
          if (answerLabel) answerLabel.textContent = 'Correct Answer';
          if (addAnswerButton) addAnswerButton.style.display = 'none';

          setOptionRows(optionsList, ['True', 'False'], true);
          setAnswerRows(answerList, currentAnswers, false, 'Select True or False', {
            mode: 'option_select',
            optionValues: ['True', 'False'],
            selectPlaceholder: 'Select True or False',
          });
          return;
        }

        if (optionsField) optionsField.classList.add('is-hidden');
        if (addOptionButton) addOptionButton.style.display = 'none';
        if (answerLabel) {
          answerLabel.textContent = type === 'essay' ? 'Marking Guide (Optional)' : 'Correct Answer (Optional)';
        }
        if (addAnswerButton) addAnswerButton.style.display = 'none';
        setAnswerRows(
          answerList,
          currentAnswers,
          false,
          type === 'essay' ? 'Key points to look for (optional)' : 'Expected short answer (optional)'
        );
      }

      function setQuestionEditorContent(editor, value) {
        if (!editor) return;
        var raw = String(value || '');
        var hasHtmlTag = /<\/?[a-z][\s\S]*>/i.test(raw);
        if (hasHtmlTag) {
          editor.innerHTML = raw;
        } else {
          editor.textContent = raw;
        }
      }

      function syncQuestionEditorValue(editor, hiddenInput) {
        if (!editor || !hiddenInput) return;
        var html = String(editor.innerHTML || '').trim();
        if (html === '<br>' || html === '<div><br></div>') {
          html = '';
        }
        hiddenInput.value = html;
      }

      function applyEditorCommand(editor, command, value) {
        if (!editor) return;
        editor.focus();
        try {
          document.execCommand(command, false, value);
        } catch (_) {
        }
      }

      function updateTextColorSwatch(colorInput) {
        if (!colorInput) return;
        var swatchWrap = colorInput.closest('.qm-text-color-wrap');
        if (!swatchWrap) return;

        var color = String(colorInput.value || '#0f172a').trim() || '#0f172a';
        swatchWrap.style.background = color;
        swatchWrap.style.borderColor = '#94a3b8';
      }

      // "Used before": while typing a question, show matching questions this school
      // already wrote for the subject. Picking one fills in the whole question.
      (function () {
        if (!questionItems) return;
        var box = null, timer = null, seq = 0;
        var TYPE_LABEL = { single_choice: 'Choose one', multiple_choice: 'Choose several', true_false: 'True / False', short_text: 'Short answer', essay: 'Essay' };
        var plain = function (el) { return String(el.innerText || el.textContent || '').replace(/\s+/g, ' ').trim(); };
        var esc = function (v) { return String(v == null ? '' : v).replace(/[&<>"']/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]; }); };
        function close() { if (box) { box.remove(); box = null; } }
        questionItems.addEventListener('input', function (event) {
          var editor = event.target && event.target.closest ? event.target.closest('.question-text-editor') : null;
          if (!editor) return;
          var card = editor.closest('.qm-question-card');
          var text = plain(editor);
          clearTimeout(timer);
          var subjectId = questionSubjectSelect ? questionSubjectSelect.value : '';
          if (text.length < 4 || !subjectId) { close(); return; }
          timer = setTimeout(function () {
            var mine = ++seq;
            fetch('/common/assessment/questions/bank?subjectId=' + encodeURIComponent(subjectId) + '&q=' + encodeURIComponent(text), { headers: { Accept: 'application/json' } })
              .then(function (r) { return r.json(); })
              .then(function (data) {
                if (mine !== seq) return;
                var inSet = new Set(Array.from(questionItems.querySelectorAll('.question-text-editor')).map(function (el) { return plain(el).toLowerCase(); }));
                var list = (data && data.questions || []).filter(function (q) { return !inSet.has(String(q.plainText).toLowerCase()); }).slice(0, 6);
                close();
                if (!list.length) return;
                box = document.createElement('div');
                box.className = 'qm-bank';
                box.innerHTML = '<div class="qm-bank__head">Used before <span>Click to use</span></div>' + list.map(function (q, i) {
                  return '<button type="button" class="qm-bank__item" data-i="' + i + '"><span class="qm-bank__text">' + esc(q.plainText) + '</span><span class="qm-bank__meta">' +
                    esc(TYPE_LABEL[q.questionType] || 'Question') + (q.className ? ' · ' + esc(q.className) : '') + ' · ' + esc(q.marks) + ' mark' + (Number(q.marks) === 1 ? '' : 's') +
                    (q.answerKey ? ' · answer set' : '') + '</span></button>';
                }).join('');
                var anchorEl = editor.closest('.qm-question-text-editor-wrap') || editor;
                anchorEl.insertAdjacentElement('afterend', box);
                box.addEventListener('mousedown', function (e) { e.preventDefault(); });
                box.addEventListener('click', function (e) {
                  var btn = e.target.closest('.qm-bank__item');
                  if (!btn) return;
                  var q = list[Number(btn.getAttribute('data-i'))];
                  var fresh = buildQuestionItem({
                    questionType: q.questionType, questionText: q.questionText, options: q.options,
                    optionLayout: q.optionLayout, answerKey: q.answerKey, marks: q.marks,
                  });
                  card.replaceWith(fresh);
                  close();
                  if (typeof renumberQuestionCards === 'function') renumberQuestionCards();
                  if (typeof updateQuestionCount === 'function') updateQuestionCount();
                });
              })
              .catch(function () { close(); });
          }, 300);
        });
        questionItems.addEventListener('focusout', function () { setTimeout(close, 200); });
        document.addEventListener('keydown', function (e) { if (e.key === 'Escape') close(); });
      })();

