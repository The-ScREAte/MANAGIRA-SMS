      font-size: 0.86rem;
      font-weight: 800;
      cursor: pointer;
      line-height: 1;
      padding: 0;
    }

    

    .qm-answer-add-btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 22px;
      height: 22px;
      border-radius: 999px;
      border: 1px solid #94a3b8;
      background: #fff;
      color: #334155;
      font-size: 0.86rem;
      font-weight: 800;
      cursor: pointer;
      line-height: 1;
      padding: 0;
    }

    

    .qm-footer {
      display: flex;
      align-items: center;
      justify-content: flex-start;
      padding: 9px 14px;
      background: #fff;
      border-top: 1px solid #e2e8f0;
