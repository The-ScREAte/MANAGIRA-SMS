      align-items: center;
      justify-content: space-between;
      padding: calc(13px + env(safe-area-inset-top, 0px)) 18px 12px;
      background: #fff;
      border-bottom: 1px solid #e2e8f0;
      flex-shrink: 0;
      gap: 12px;
    }

    .qm-topbar-left {
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .qm-topbar-right {
      display: flex;
      align-items: center;
      gap: 8px;
      flex-shrink: 0;
    }

    .qm-upload-btn {
      display: inline-flex;
      align-items: center;
      gap: 5px;
      border: 1.5px solid #0f5a66;
      background: #f0fafb;
      color: #0f5a66;
      border-radius: 8px;
      padding: 6px 11px;
      font-size: 0.74rem;
      font-weight: 700;
      cursor: pointer;
      transition: all 0.15s;
      white-space: nowrap;
