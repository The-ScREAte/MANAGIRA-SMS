<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Assessment Question Sets</title>
  <style>
    :root {
      --font-family: "<%= (session && session.fontStyle ? String(session.fontStyle).trim() : 'Inter') %>", sans-serif;
      --primary: var(--org-primary-color, #0f5a66);
      --primary-hover: var(--org-primary-hover, #0d4f59);
      --primary-soft: color-mix(in srgb, var(--primary) 12%, #ffffff);
      --border: #cedae3;
      --text: #0b1720;
      --muted: #415464;
      --surface: #eff4f9;
    }

    *, *::before, *::after { box-sizing: border-box; }
    body {
      margin: 0;
      font-family: var(--font-family);
      background:
        radial-gradient(1200px 520px at 8% -12%, #e0edf8 0%, rgba(224, 237, 248, 0) 62%),
        radial-gradient(1000px 440px at 94% -18%, #e8f6f8 0%, rgba(232, 246, 248, 0) 58%),
        linear-gradient(180deg, #f6f9fc 0%, #edf3f8 100%);
      color: var(--text);
      font-size: 14px;
      line-height: 1.35;
    }

    .page-wrap { max-width: 1280px; margin: 0 auto; padding: 14px 12px 20px; }
    .top-bar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 8px;
      margin-bottom: 12px;
    }
    .top-bar h1 { margin: 0; font-size: 1.08rem; color: #0f2d32; line-height: 1.2; }
    .top-bar-actions { display: inline-flex; flex-wrap: wrap; gap: 10px; }
    .top-bar-actions {
      display: flex;
      flex-wrap: nowrap;
      align-items: center;
      gap: 8px;
      overflow-x: auto;
      padding-bottom: 2px;
    }
    .top-bar-actions .btn {
      flex: 0 0 auto;
      width: auto;
      min-height: 30px;
      justify-content: center;
      text-align: center;
      padding: 5px 8px;
    }

    .btn {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      border-radius: 8px;
      border: none;
      text-decoration: none;
      font-size: 0.72rem;
      font-weight: 600;
      cursor: pointer;
      padding: 6px 10px;
      white-space: nowrap;
    }
    .btn-outline {
      background: #fff;
      color: var(--primary);
      border: 2px solid var(--primary);
    }
    .btn-outline:hover { background: #fff; }

    .btn-google {
      background: #fff;
      color: #0b3a44;
      border: 2px solid #d3dde4;
    }
    .btn-google:hover { background: #fff; color: #0b3a44; }

    .helper-text {
      margin: 0 0 10px;
      color: var(--muted);
      font-size: 0.74rem;
    }

    .grid-two {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 12px;
    }

    .form-card {
      background: linear-gradient(180deg, #ffffff 0%, #f9fcff 100%);
      border: 1px solid var(--border);
      border-radius: 10px;
      box-shadow: 0 8px 22px rgba(15, 45, 50, 0.08);
      padding: 10px;
      margin-bottom: 10px;
    }

    .collapsible-card {
      padding: 0;
      overflow: hidden;
    }

    .collapsible-summary {
      list-style: none;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 8px;
      padding: 12px 12px 10px;
      user-select: none;
      background: linear-gradient(180deg, #f8fbfd 0%, #f4f8fb 100%);
      transition: background 0.2s ease;
    }

    .workspace-filters-summary {
      align-items: center;
      flex-wrap: nowrap;
      overflow-x: auto;
    }

    .workspace-filters-main {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      flex-wrap: nowrap;
      min-width: 0;
    }

    .workspace-filters-title {
      margin: 0 !important;
      white-space: nowrap;
    }

    .workspace-filter-summary-line {
      margin: 0;
      flex-wrap: nowrap;
    }

    .workspace-filter-summary-line .current-pill {
      white-space: nowrap;
    }

    #workspace-filters-hint {
      margin-left: auto;
      flex: 0 0 auto;
    }

    .collapsible-summary:hover {
      background: linear-gradient(180deg, #f3f8fc 0%, #eef5fa 100%);
    }

    .collapsible-card[open] .collapsible-summary {
      background: linear-gradient(180deg, #f1f7fb 0%, #ecf4f9 100%);
    }

    .collapsible-summary::-webkit-details-marker {
      display: none;
    }

    .collapsible-content {
      padding: 0 12px 12px;
      border-top: 1px solid #e2e8f0;
    }

    .filter-summary-line {
      margin: 2px 0 0;
      display: flex;
      align-items: center;
      gap: 8px;
      flex-wrap: wrap;
    }

    .current-pill {
      display: inline-flex;
      align-items: center;
      border: 1px solid #c9d7e1;
      border-radius: 999px;
      padding: 2px 8px;
      background: #f7fafc;
      color: #244753;
      font-size: 0.66rem;
      font-weight: 700;
      line-height: 1.2;
      letter-spacing: 0.01em;
    }

    .filter-panel {
      margin-top: 10px;
      display: grid;
      gap: 8px;
    }

    .filters-grid {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 8px;
      align-items: end;
    }

    .filter-actions {
      display: inline-flex;
      align-items: center;
      justify-content: flex-start;
      gap: 8px;
      flex-wrap: nowrap;
      width: auto;
      margin-top: 2px;
      margin-left: 0;
    }

    #workspace-filters-card .filter-actions {
      justify-self: start;
      align-self: start;
      width: auto !important;
      margin-left: 0 !important;
    }

    .filter-actions .btn {
      min-height: 25px;
      min-width: 78px;
      font-size: 0.6rem;
      line-height: 1;
      padding: 3px 8px;
    }

    #workspace-filters-card .filter-actions .btn {
      min-height: 24px !important;
      min-width: 72px !important;
      padding: 2px 7px !important;
      font-size: 0.58rem !important;
      line-height: 1 !important;
    }

    .text-link-control {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-height: 30px;
      padding: 7px 10px;
      border-radius: 8px;
      border: 1px solid #cbd5e1;
      background: #fff;
      color: #0f5a66;
      font-size: 0.7rem;
      font-weight: 700;
      text-decoration: none;
      white-space: nowrap;
    }

    .text-link-control:hover,
    .text-link-control:focus-visible {
      border-color: #0f5a66;
      text-decoration: none;
      outline: none;
    }

    .collapsible-hint {
      font-size: 0.66rem;
      font-weight: 700;
      color: #0f5a66;
      border: 1px solid #c8d8e2;
      background: #ffffff;
      border-radius: 999px;
      padding: 2px 8px;
      white-space: nowrap;
    }

    .section-title {
      margin: 0 0 8px;
      font-size: 0.8rem;
      color: var(--primary);
    }

    .field-group {
      display: grid;
      gap: 4px;
    }

    .field-group label {
      font-size: 0.64rem;
      font-weight: 700;
      color: #3b5563;
    }

    .field-group input,
    .field-group select {
      width: 100%;
      border: 1px solid #cddae3;
      background: #fff;
      border-radius: 8px;
      min-height: 30px;
      padding: 5px 8px;
      font: inherit;
      font-size: 0.72rem;
      color: #102f39;
    }

    .field-group input:focus,
    .field-group select:focus {
      outline: none;
      border-color: var(--primary);
      box-shadow: 0 0 0 2px rgba(15, 90, 102, 0.14);
    }

    .row-actions {
      margin-top: 8px;
      display: inline-flex;
      gap: 8px;
      flex-wrap: wrap;
    }

    .btn-primary {
      background: var(--primary);
      color: #fff;
    }
    .btn-primary:hover { background: var(--primary); }

    .btn-secondary {
      background: #fff;
      color: #334155;
      border: 1px solid #cbd5e1;
    }
    .btn-secondary:hover { background: #fff; color: #334155; }

    .status-text {
      margin: 8px 0 0;
      color: var(--muted);
      font-size: 0.68rem;
      min-height: 18px;
    }

    .exam-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
      gap: 10px;
      overflow: visible;
      align-items: start;
    }

    .class-group {
      margin-bottom: 16px;
    }

    .class-group-head {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 10px;
      margin-bottom: 7px;
      flex-wrap: wrap;
    }

    .class-group-title {
      margin: 0;
      font-size: 0.84rem;
      color: #0f2d32;
      letter-spacing: 0.01em;
    }

    .class-group-meta {
      font-size: 0.66rem;
      color: #5f7381;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.05em;
    }

    .class-group-divider {
      border-bottom: 1px dashed #c8d6df;
      margin-bottom: 10px;
    }

    .subject-group {
      margin-bottom: 14px;
    }

    .subject-group-head {
      display: flex;
      align-items: center;
      justify-content: flex-start;
      gap: 8px;
      margin-bottom: 6px;
      padding-left: 2px;
      flex-wrap: wrap;
    }

    .subject-group-title {
      margin: 0;
      font-size: 0.76rem;
      font-weight: 800;
      color: #13414a;
      text-transform: uppercase;
      letter-spacing: 0.05em;
    }

    .subject-group-meta {
      font-size: 0.62rem;
      color: #5f7381;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.05em;
    }

    .subject-group-assessment-inline {
      font-size: 0.66rem;
      font-weight: 700;
      color: #1f4f59;
      border-left: 2px solid #c8d6df;
      padding-left: 8px;
      line-height: 1.3;
      text-transform: none;
      letter-spacing: 0.01em;
    }

    .assessment-group {
      margin-bottom: 10px;
    }

    .assessment-group-head {
      margin: 0 0 8px;
      font-size: 0.72rem;
      font-weight: 700;
      color: #1f4f59;
      border-left: 3px solid #b8ced8;
      padding-left: 8px;
      line-height: 1.3;
    }

    .exam-card {
      background: linear-gradient(180deg, #ffffff 0%, #f9fbfe 100%);
      border: 1px solid var(--border);
      border-radius: 10px;
      box-shadow: 0 8px 22px rgba(15, 45, 50, 0.08);
      overflow: visible;
      min-height: 100%;
    }

    .exam-summary {
      list-style: none;
      position: relative;
      display: flex;
      align-items: center;
      flex-wrap: wrap;
      gap: 6px;
      align-items: center;
      padding: 11px 12px;
      padding-right: 48px;
      margin: 0;
      cursor: pointer;
    }
    .exam-summary::-webkit-details-marker { display: none; }
    .exam-summary:hover { background: #f8fbfc; }

    .exam-title {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      min-width: 0;
    }
    .exam-title strong {
      font-size: 0.76rem;
      color: var(--primary);
      line-height: 1.2;
      white-space: nowrap;
    }
    .exam-title span {
      font-size: 0.66rem;
      color: var(--muted);
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .exam-pill {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: auto;
      min-width: 0;
      padding: 1px 7px;
      border-radius: 999px;
      background: var(--primary-soft);
      color: var(--primary);
      border: 1px solid color-mix(in srgb, var(--primary) 28%, #ffffff);
      font-size: 0.62rem;
      font-weight: 700;
      white-space: nowrap;
    }

    .exam-pill.review-pending {
      background: #fff7ed;
      border-color: #fed7aa;
      color: #9a3412;
    }

    .exam-pill.review-approved {
      background: #ecfdf5;
      border-color: #bbf7d0;
      color: #166534;
    }

    .exam-pill.review-rejected {
      background: #fef2f2;
      border-color: #fecaca;
      color: #991b1b;
    }

    .exam-updated {
      font-size: 0.64rem;
      color: var(--muted);
      white-space: nowrap;
    }

    .exam-questions {
      border-top: 1px solid #e8eef3;
      padding: 10px 12px 11px;
      display: grid;
      gap: 8px;
    }

    .exam-summary-actions {
      display: inline-flex;
      gap: 6px;
      align-items: center;
      flex-wrap: wrap;
    }

    .set-actions-menu {
      position: absolute;
      right: 10px;
      top: 8px;
      margin-left: 0;
      z-index: 200;
    }

    .set-actions-trigger {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-width: 30px;
      height: 24px;
      border-radius: 8px;
      border: 1px solid color-mix(in srgb, var(--primary) 26%, #ffffff);
      color: var(--primary);
      text-decoration: none;
      font-size: 13px;
      font-weight: 700;
      line-height: 1;
      background: var(--primary-soft);
      cursor: pointer;
      padding: 0 6px;
    }

    .set-actions-trigger:hover,
    .set-actions-trigger:focus-visible {
      border-color: var(--primary);
      color: var(--primary);
      outline: none;
    }

    .set-actions-dropdown {
      position: absolute;
      right: 0;
      top: auto;
      bottom: calc(100% + 8px);
      min-width: 150px;
      border: 1px solid #dbe5ec;
      border-radius: 10px;
      background: #fff;
      box-shadow: 0 12px 24px rgba(15, 45, 50, 0.14);
      padding: 6px;
      display: none;
      z-index: 9999;
    }

    .set-actions-menu.open .set-actions-dropdown {
      display: grid;
      gap: 4px;
    }

    .set-action-link {
      display: block;
      color: #0f172a;
      text-decoration: none;
      font-size: 0.7rem;
      font-weight: 600;
      padding: 6px 8px;
      border-radius: 8px;
      border: 1px solid transparent;
    }

    .set-action-link:hover,
    .set-action-link:focus-visible {
      border-color: color-mix(in srgb, var(--primary) 24%, #ffffff);
      background: var(--primary-soft);
      outline: none;
      text-decoration: none;
    }

    .set-action-link.is-disabled {
      pointer-events: none;
      opacity: 0.55;
    }

    .question-row {
      border: 1px solid #e6edf2;
      border-radius: 8px;
      padding: 7px 8px;
      background: #fbfdfe;
    }

    .question-meta {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      margin-bottom: 4px;
      font-size: 0.62rem;
      color: #4f6773;
    }

    .question-text {
      margin: 0;
      font-size: 0.72rem;
      line-height: 1.45;
      color: #122f3a;
    }

    .empty-state {
      text-align: center;
      background: #fff;
      border: 1px dashed #c7d5de;
      border-radius: 10px;
      padding: 20px 12px;
      color: #5d7480;
      font-size: 0.72rem;
    }

    .set-preview-question {
      background: #fff;
      border: 1px solid #e3ebf1;
      border-radius: 12px;
      padding: 12px 13px;
    }

    .set-preview-question-head {
      display: inline-flex;
      flex-wrap: wrap;
      gap: 8px;
      align-items: center;
      margin-bottom: 7px;
      color: #52697a;
      font-size: 0.7rem;
      font-weight: 700;
    }

    .set-preview-question-text {
      margin: 0;
      color: #07131d;
      font-size: 0.82rem;
      line-height: 1.5;
      white-space: pre-wrap;
    }

    .reuse-modal-overlay {
      position: fixed;
      inset: 0;
      background: rgba(15, 23, 42, 0.45);
      display: none;
      align-items: center;
      justify-content: center;
      z-index: 900;
      padding: 12px;
    }

    .reuse-modal-overlay.show {
      display: flex;
    }

    .reuse-modal {
      width: 100%;
      max-width: 760px;
      background: #fff;
      border-radius: 12px;
      border: 1px solid var(--border);
      padding: 14px;
      max-height: 90vh;
      overflow: auto;
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 12px;
    }

    .reuse-modal-title {
      margin: 0;
      color: #102f39;
      font-size: 1rem;
      grid-column: 1 / -1;
    }

    .reuse-source {
      margin: 0;
      color: #475569;
      font-size: 0.7rem;
      grid-column: 1 / -1;
      padding: 10px 12px;
      border-radius: 10px;
      background: linear-gradient(180deg, #f8fbfd 0%, #f2f7fb 100%);
      border: 1px solid #dbe6ee;
    }

    .reuse-modal-grid {
      grid-column: 1 / -1;
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 12px;
    }

    .reuse-modal-grid .field-group {
      min-width: 0;
    }

    .reuse-modal-grid .field-group.full-span {
      grid-column: 1 / -1;
    }

    .reuse-checkbox-row {
      grid-column: 1 / -1;
      margin-top: -2px;
      padding: 10px 12px;
      border-radius: 10px;
      border: 1px solid #dbe6ee;
      background: #fbfdff;
    }

    .reuse-checkbox-label {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      font-size: 0.72rem;
      font-weight: 600;
      color: #294754;
      cursor: pointer;
    }

    .reuse-checkbox-label input[type="checkbox"] {
      width: auto;
      min-height: auto;
      margin: 0;
    }

    .reuse-modal .row-actions {
      grid-column: 1 / -1;
      margin-top: 0;
      justify-content: flex-start;
      align-items: center;
      flex-wrap: nowrap;
    }

    .reuse-modal .row-actions .btn {
      min-height: 30px;
      padding: 6px 10px;
      font-size: 0.72rem;
      justify-content: center;
    }

    .reuse-modal .status-text {
      grid-column: 1 / -1;
      margin-top: -2px;
    }

    .students-modal-overlay {
      position: fixed;
      inset: 0;
      background: rgba(15, 23, 42, 0.45);
      display: none;
      align-items: center;
      justify-content: center;
      z-index: 10040;
      padding: 12px;
    }

    .students-modal-overlay.show {
      display: flex;
    }

    .students-modal {
      width: 100%;
      max-width: 900px;
      background: #fff;
      border-radius: 12px;
      border: 1px solid var(--border);
      padding: 14px;
      max-height: 90vh;
      overflow: auto;
      display: grid;
      gap: 10px;
      position: relative;
    }

    .students-modal-header {
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      gap: 10px;
      padding-right: 28px;
    }

    .students-modal-title {
      margin: 0;
      color: #102f39;
      font-size: 0.96rem;
    }

    .students-modal-subtitle {
      margin: 2px 0 0;
      color: #607080;
      font-size: 0.72rem;
    }

    .students-modal-close {
      border: 1px solid #cbd5e1;
      background: #fff;
      color: #334155;
      border-radius: 8px;
      width: 24px;
      min-width: 24px;
      height: 24px;
      padding: 0;
      font-size: 1rem;
      line-height: 1;
      font-weight: 700;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      position: absolute;
      top: 10px;
      right: 10px;
    }

    .students-modal-close:hover,
    .students-modal-close:focus-visible,
    .students-modal-close:active {
      background: #fff;
      color: #334155;
      border-color: #cbd5e1;
      outline: none;
      box-shadow: none;
    }

    .students-summary {
      display: flex;
      flex-wrap: wrap;
      gap: 6px;
      align-items: center;
    }

    .students-toolbar {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: flex-start !important;
      gap: 10px;
    }

    .students-modal .btn {
      min-height: 24px;
      padding: 4px 8px;
      font-size: 0.66rem;
      font-weight: 700;
      line-height: 1;
      border-radius: 7px;
      justify-content: center;
      text-align: center;
    }

    #students-unlock-all-btn {
      min-height: 22px !important;
      height: 22px;
      padding: 2px 7px !important;
      font-size: 0.62rem !important;
      font-weight: 700;
      line-height: 1;
      border-radius: 6px;
      border-width: 1px !important;
      flex: 0 0 auto;
      transition: none;
      width: auto !important;
      display: inline-flex;
      align-items: center;
      justify-content: center;
    }

    #students-unlock-all-btn:hover,
    #students-unlock-all-btn:focus-visible,
    #students-unlock-all-btn:active {
      background: #fff !important;
      color: var(--primary) !important;
      border-color: var(--primary) !important;
      transform: none !important;
      box-shadow: none !important;
      outline: none !important;
    }

    .students-table-wrap {
      border: 1px solid #dbe5ec;
      border-radius: 10px;
      overflow: auto;
      background: #fff;
    }

    .students-table {
      width: 100%;
      border-collapse: collapse;
      font-size: 0.72rem;
    }

    .students-table th,
    .students-table td {
      padding: 8px;
      border-bottom: 1px solid #ecf1f5;
      text-align: left;
      vertical-align: middle;
    }

    .students-table th {
      background: #f8fbfc;
      color: #3b5563;
