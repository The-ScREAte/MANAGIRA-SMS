        reuseSubjectSelect.innerHTML = '';

        var termId = Number(reuseTermSelect.value || 0);
        var classId = Number(reuseClassSelect.value || 0);
        var termSubjects = getTermClassSubjects(termId, classId);

        termSubjects.forEach(function (row) {
          var opt = document.createElement('option');
          opt.value = String(row.subject_id);
          opt.textContent = row.subject_name;
          reuseSubjectSelect.appendChild(opt);
        });
