                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="8" y1="6" x2="21" y2="6"/><line x1="8" y1="12" x2="21" y2="12"/><line x1="8" y1="18" x2="21" y2="18"/><line x1="3" y1="6" x2="3.01" y2="6"/><line x1="3" y1="12" x2="3.01" y2="12"/><line x1="3" y1="18" x2="3.01" y2="18"/></svg>
                    <%= setItem.question_count %> Q
                  </span>
                  <% if (Number(setItem.missing_answers || 0) > 0) { %>
                    <span class="exam-pill exam-pill--warn" title="Choice and true/false questions need a correct answer to be marked automatically. Open the set to add them.">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 9v4"/><path d="M12 17h.01"/><path d="M10.3 3.9 1.8 18a2 2 0 0 0 1.7 3h17a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0z"/></svg>
                      <%= setItem.missing_answers %> need<%= Number(setItem.missing_answers) === 1 ? 's' : '' %> an answer
                    </span>
                  <% } %>
                  <span class="exam-pill">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="5"/><circle cx="12" cy="12" r="1"/></svg>
                    <%= setItem.total_points %> pts
                  </span>
                  <span class="exam-pill">
                    <% if (setItem.open_book) { %>
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="10" rx="2"/><path d="M7 11V7a5 5 0 0 1 9.9-1"/></svg> Open Book
                    <% } else { %>
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="10" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg> Closed Book
                    <% } %>
                  </span>
                </div>
                <div class="exam-meta-line">
                  <span class="exam-pill">
                    <% if (setItem.time_limit_minutes && Number(setItem.time_limit_minutes) > 0) { %>
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3.5 2"/></svg>
                      <%= Number(setItem.time_limit_minutes) %> min
                    <% } else { %>
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18.5 12c0 1.66-1.34 3-3 3-1.5 0-2.7-1.5-3.5-3-.8-1.5-2-3-3.5-3-1.66 0-3 1.34-3 3s1.34 3 3 3c1.5 0 2.7-1.5 3.5-3 .8-1.5 2-3 3.5-3 1.66 0 3 1.34 3 3z"/></svg>
                      Unlimited
                    <% } %>
                  </span>
                  <% const attemptsAllowed = Math.max(Number(setItem.max_attempts || 1), 1); %>
                  <span class="exam-pill">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 2l4 4-4 4"/><path d="M3 11V9a4 4 0 0 1 4-4h14"/><path d="M7 22l-4-4 4-4"/><path d="M21 13v2a4 4 0 0 1-4 4H3"/></svg>
                    <%= attemptsAllowed >= 1000 ? 'Unlimited attempts' : attemptsAllowed + (attemptsAllowed === 1 ? ' attempt' : ' attempts') %>
                  </span>
                  <span class="exam-pill status-chip review-<%= reviewStatusKey %>"><%
                    if (reviewStatusKey === 'approved') { %><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M8 12.5l2.5 2.5L16 9"/></svg> Approved<%
                    } else if (reviewStatusKey === 'rejected') { %><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M9 9l6 6M15 9l-6 6"/></svg> Rejected<%
                    } else { %><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg> Pending<%
                    } %></span>
                </div>
              </div>
              <div class="exam-summary-actions">
                <% const postedCount = Number(setItem.posted_count || 0); %>
                <% const pendingPostCount = Number(setItem.pending_post_count || 0); %>
                <% if (Number(setItem.to_mark || 0) > 0) { %><span class="to-mark-chip" title="Written answers waiting for review"><%= Number(setItem.to_mark) %><%= (typeof toMarkOnly !== 'undefined' && toMarkOnly) ? (Number(setItem.to_mark) === 1 ? ' answer to review' : ' answers to review') : ' to review' %></span><% if (typeof toMarkOnly !== 'undefined' && toMarkOnly) { %><button type="button" class="post-grades-btn js-review-set" data-question-set-id="<%= setItem.question_set_id %>">Review</button><% } %><% } %>
                <% const completedCount = Number(setItem.completed_count || 0); %>
                <% if (completedCount > 0) { %>
                  <% const isPostedOn = postedCount > 0; %>
