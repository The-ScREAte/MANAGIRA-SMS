      // Fix an answer: mark one question again for everyone who handed in.
      (function () {
        var openBtn = document.getElementById('students-remark-btn');
        var panel = document.getElementById('students-remark-panel');
        if (!openBtn || !panel) return;
        var pick = document.getElementById('students-remark-question');
        var keyBox = document.getElementById('students-remark-key');
        var go = document.getElementById('students-remark-go');
        var status = document.getElementById('students-remark-status');
        var questions = [];
        function syncKey() {
          var chosen = questions.find(function (q) { return String(q.questionId) === pick.value; });
          keyBox.value = chosen ? (chosen.answerKey || '') : '';
        }
        pick.addEventListener('change', syncKey);
        openBtn.addEventListener('click', async function () {
          if (!panel.hidden) { panel.hidden = true; return; }
          var scope = (latestStudentsPayload && latestStudentsPayload.scope) || {};
          status.textContent = 'Loading…';
          panel.hidden = false;
          try {
            var url = '/common/assessment/questions?questionSetId=' + encodeURIComponent(activeStudentsQuestionSetId)
              + '&classId=' + encodeURIComponent(scope.classId) + '&subjectId=' + encodeURIComponent(scope.subjectId)
              + '&termId=' + encodeURIComponent(scope.termId) + '&assessmentId=' + encodeURIComponent(scope.assessmentId);
            var response = await fetch(url, { headers: { Accept: 'application/json' } });
            var data = await response.json();
            var set = (data.sets || []).find(function (item) { return Number(item.questionSetId) === Number(activeStudentsQuestionSetId); });
            questions = ((set && set.questions) || []).filter(function (q) { return ['essay', 'matching'].indexOf(q.questionType) === -1; });
            pick.innerHTML = questions.map(function (q, i) {
              var text = String(q.questionText || '').replace(/\s+/g, ' ').slice(0, 60);
              return '<option value="' + q.questionId + '">' + (i + 1) + '. ' + text.replace(/[<>&"]/g, '') + '</option>';
            }).join('');
            syncKey();
            status.textContent = questions.length ? '' : 'No question can be marked again here.';
          } catch (error) {
            status.textContent = 'Questions could not be loaded.';
          }
        });
        go.addEventListener('click', async function () {
          if (!pick.value) return;
          if (!await window.appConfirm('Mark this question again for everyone who handed in? Changed grades go back to waiting until you post them.')) return;
          go.disabled = true;
          status.textContent = 'Marking…';
          try {
            var response = await fetch('/common/assessment/questions/remark', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
              body: JSON.stringify({ questionSetId: activeStudentsQuestionSetId, questionId: Number(pick.value), answerKey: keyBox.value }),
            });
            var result = await response.json();
            if (!response.ok || !result.success) throw new Error(result.error || 'That could not be marked again.');
            status.textContent = result.message || 'Done.';
            await loadStudentsForQuestionSet(activeStudentsQuestionSetId);
          } catch (error) {
            status.textContent = error.message || 'That could not be marked again.';
          } finally {
            go.disabled = false;
          }
        });
      })();

