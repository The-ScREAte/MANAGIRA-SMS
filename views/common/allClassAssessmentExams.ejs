          '    </svg>',
          '  </button>',
          '  </div>',
          '<div class="qm-question-card-body">',
          '  <div class="qm-field">',
          '    <div class="qm-question-text-head">',
          '      <label>Question Text</label>',
          '      <div class="qm-question-text-toolbar">',
          '        <button type="button" class="qm-text-tool-btn" data-format-cmd="bold" title="Bold">B</button>',
          '        <button type="button" class="qm-text-tool-btn" data-format-cmd="italic" title="Italic">I</button>',
          '        <label class="qm-text-color-wrap" title="Text Color">',
          '          <input type="color" class="qm-text-color" value="#0f172a" />',
          '        </label>',
          '      </div>',
          '    </div>',
          '    <div class="qm-question-text-editor-wrap">',
          '      <div class="question-text-editor" contenteditable="true" data-placeholder="Type the question here..."></div>',
          '    </div>',
          '    <textarea class="question-text" rows="2"></textarea>',
          '  </div>',
          '  <div class="qm-field qm-options-field">',
          '    <div class="qm-options-head">',
          '      <label>Options</label>',
          '      <div class="qm-options-layout-toggle" role="group" aria-label="Options layout">',
          '        <button type="button" class="qm-options-layout-btn is-active" data-layout="stacked" aria-pressed="true" title="Stacked">',
          '          <span class="qm-layout-icon" aria-hidden="true"><span></span><span></span><span></span></span>',
          '          <span class="qm-layout-label">Stacked</span>',
          '        </button>',
          '        <button type="button" class="qm-options-layout-btn" data-layout="side_by_side" aria-pressed="false" title="Side by side">',
          '          <span class="qm-layout-icon" aria-hidden="true"><span></span><span></span><span></span><span></span></span>',
          '          <span class="qm-layout-label">Side by side</span>',
          '        </button>',
          '      </div>',
          '      <input type="hidden" class="qm-options-layout-select" value="stacked" />',
          '    </div>',
          '    <div class="question-options-list"></div>',
          '    <button type="button" class="qm-option-add-btn" title="Add option">+</button>',
          '  </div>',
          '  <div class="qm-field qm-answer-field">',
          '    <label class="question-answer-label">Answer Key</label>',
          '    <div class="question-answer-list"></div>',
          '    <button type="button" class="qm-answer-add-btn" title="Add correct answer">+</button>',
          '  </div>',
          '</div>'
        ].join('');

        var typeSelect = wrapper.querySelector('.question-type');
        var marksInput = wrapper.querySelector('.question-marks');
        var textInput = wrapper.querySelector('.question-text');
        var textEditor = wrapper.querySelector('.question-text-editor');
        var optionsList = wrapper.querySelector('.question-options-list');
        var optionsLayoutSelect = wrapper.querySelector('.qm-options-layout-select');
        var optionsLayoutToggle = wrapper.querySelector('.qm-options-layout-toggle');
        var addOptionButton = wrapper.querySelector('.qm-option-add-btn');
        var answerList = wrapper.querySelector('.question-answer-list');
        var addAnswerButton = wrapper.querySelector('.qm-answer-add-btn');
        var collapseToggleButton = wrapper.querySelector('.qm-collapse-toggle');
        var formatButtons = wrapper.querySelectorAll('.qm-text-tool-btn');
        var textColorPicker = wrapper.querySelector('.qm-text-color');

        var initialOptions = Array.isArray(question && question.options) ? question.options : [];
        if (!initialOptions.length) {
          appendOptionInput(optionsList, '');
        } else {
          initialOptions.forEach(function (optionValue) {
            appendOptionInput(optionsList, optionValue);
          });
        }

        if (addOptionButton) {
          addOptionButton.addEventListener('click', function () {
            appendOptionInput(optionsList, '');
            saveDraft();
          });
        }

        if (optionsLayoutToggle) {
          optionsLayoutToggle.addEventListener('click', function (event) {
            var targetButton = event.target && event.target.closest
              ? event.target.closest('.qm-options-layout-btn')
              : null;
            if (!targetButton) return;

            var selectedMode = targetButton.getAttribute('data-layout') === 'side_by_side'
              ? 'side_by_side'
              : 'stacked';

            if (optionsLayoutSelect) optionsLayoutSelect.value = selectedMode;
            applyOptionsLayoutMode(optionsList, selectedMode);
            updateOptionsLayoutToggleUI(optionsLayoutToggle, selectedMode);
            saveDraft();
          });
        }

        if (optionsList) {
          optionsList.addEventListener('input', function (event) {
            var target = event.target;
            if (!target || !target.classList || !target.classList.contains('question-option-input')) return;
            syncOptionBasedAnswerRows(wrapper);
          });
          optionsList.addEventListener('click', function (event) {
            var target = event.target && event.target.closest
              ? event.target.closest('.question-option-remove')
              : null;
            if (!target) return;
            setTimeout(function () {
              syncOptionBasedAnswerRows(wrapper);
            }, 0);
          });
        }

        var initialAnswers = Array.isArray(question && question.answerKeys)
          ? question.answerKeys
          : parseAnswerValues(question ? question.answerKey : '');
        if (!initialAnswers.length) {
          appendAnswerInput(answerList, '');
        } else {
          initialAnswers.forEach(function (answerValue) {
            appendAnswerInput(answerList, answerValue);
          });
        }

        if (addAnswerButton) {
          addAnswerButton.addEventListener('click', function () {
            var currentType = typeSelect ? String(typeSelect.value || 'short_text') : 'short_text';
            if (currentType === 'multiple_choice' || currentType === 'single_choice' || currentType === 'true_false') {
              appendAnswerSelectInput(
                answerList,
                '',
                getOptionsBasedAnswerChoices(wrapper, currentType),
                currentType === 'true_false' ? 'Select True or False' : 'Select correct option'
              );
            } else {
              appendAnswerInput(answerList, '');
            }
            saveDraft();
          });
        }

        if (question) {
          typeSelect.value = question.questionType || 'short_text';
          marksInput.value = Number(question.marks || 1);
          setQuestionEditorContent(textEditor, question.questionText || '');
          syncQuestionEditorValue(textEditor, textInput);

          if (optionsLayoutSelect) {
            var initialLayout = String(question.optionsLayout || question.optionLayout || 'stacked');
            optionsLayoutSelect.value = initialLayout === 'side_by_side' ? 'side_by_side' : 'stacked';
          }
        }

        if (!question) {
          setQuestionEditorContent(textEditor, '');
          syncQuestionEditorValue(textEditor, textInput);
        }

        applyOptionsLayoutMode(optionsList, optionsLayoutSelect ? optionsLayoutSelect.value : 'stacked');
        updateOptionsLayoutToggleUI(optionsLayoutToggle, optionsLayoutSelect ? optionsLayoutSelect.value : 'stacked');

        formatButtons.forEach(function (button) {
          button.addEventListener('click', function () {
            var command = button.getAttribute('data-format-cmd');
            if (!command) return;
            applyEditorCommand(textEditor, command);
            syncQuestionEditorValue(textEditor, textInput);
            saveDraft();
          });
        });

        if (textColorPicker) {
          updateTextColorSwatch(textColorPicker);
          textColorPicker.addEventListener('input', function () {
            applyEditorCommand(textEditor, 'foreColor', textColorPicker.value);
            updateTextColorSwatch(textColorPicker);
            syncQuestionEditorValue(textEditor, textInput);
            saveDraft();
          });
        }

        if (textEditor) {
          textEditor.addEventListener('input', function () {
            syncQuestionEditorValue(textEditor, textInput);
          });
          textEditor.addEventListener('blur', function () {
            syncQuestionEditorValue(textEditor, textInput);
            saveDraft();
          });
        }

        typeSelect.addEventListener('change', function () {
          applyQuestionTypeBehavior(wrapper);
          saveDraft();
        });

        if (collapseToggleButton) {
          collapseToggleButton.addEventListener('click', function () {
            var isCollapsed = wrapper.classList.toggle('is-collapsed');
            collapseToggleButton.setAttribute('aria-expanded', isCollapsed ? 'false' : 'true');
            collapseToggleButton.textContent = isCollapsed ? 'Details' : 'Hide';
          });
        }

        var shouldStartCollapsed = questionModalMode === 'edit';
        if (shouldStartCollapsed) {
          wrapper.classList.add('is-collapsed');
          if (collapseToggleButton) {
            collapseToggleButton.setAttribute('aria-expanded', 'false');
            collapseToggleButton.textContent = 'Details';
          }
        } else if (collapseToggleButton) {
          collapseToggleButton.setAttribute('aria-expanded', 'true');
          collapseToggleButton.textContent = 'Hide';
        }

        applyQuestionTypeBehavior(wrapper);

        wrapper.querySelector('.question-remove').addEventListener('click', function () {
          if (hasTypedQuestionContent(wrapper)) {
            var confirmed = window.confirm('This question has typed content. Remove it?');
            if (!confirmed) return;
          }
          wrapper.remove();
          renumberQuestionCards();
          updateQuestionCount();
          saveDraft();
        });

        setTimeout(function () {
          renumberQuestionCards();
          updateQuestionCount();
        }, 0);

        return wrapper;
      }

      function collectQuestionItems() {
        var items = Array.prototype.slice.call(document.querySelectorAll('#question-items .qm-question-card'));
        return items.map(function (item, index) {
          var questionType = item.querySelector('.question-type') ? item.querySelector('.question-type').value : 'short_text';
          var options = Array.prototype.slice.call(item.querySelectorAll('.question-option-input'))
            .map(function (input) { return String(input.value || '').trim(); })
            .filter(Boolean);
          var answers = readAnswerValues(item);

          if (questionType === 'true_false') {
            options = ['True', 'False'];
            answers = answers.slice(0, 1);
          } else if (questionType === 'single_choice') {
            answers = answers.slice(0, 1);
          } else if (questionType !== 'multiple_choice') {
            options = [];
            answers = answers.slice(0, 1);
          }

          return {
            questionType: questionType,
            questionText: String(item.querySelector('.question-text') ? item.querySelector('.question-text').value : '').trim(),
            options: options,
            optionLayout: item.querySelector('.qm-options-layout-select')
              ? String(item.querySelector('.qm-options-layout-select').value || 'stacked')
              : 'stacked',
            answerKey: serializeAnswerValues(answers),
            marks: Number(item.querySelector('.question-marks') ? item.querySelector('.question-marks').value : 1),
            positionIndex: index,
          };
        }).filter(function (item) { return item.questionText; });
      }

      async function loadQuestionSets(questionSetId) {
        var selectedRule = resolveSelectedAssessmentRule();
        if (!selectedRule) {
          return { sets: [], assessment: null };
        }
        var requestUrl = '/common/assessment/questions?classId=' + encodeURIComponent(String(selectedRule.classId)) +
          '&subjectId=' + encodeURIComponent(String(selectedRule.subjectId)) +
          '&termId=' + encodeURIComponent(String(selectedRule.termId)) +
          '&assessmentId=' + encodeURIComponent(String(selectedRule.assessmentId));

        var normalizedQuestionSetId = Number(questionSetId || 0);
        if (normalizedQuestionSetId > 0) {
          requestUrl += '&questionSetId=' + encodeURIComponent(String(normalizedQuestionSetId));
        }

        var response = await fetch(requestUrl, { headers: { Accept: 'application/json' } });
        var payload = await response.json();
        if (!response.ok || !payload.success) {
          throw new Error(payload.error || 'Failed to load question sets.');
        }
        return {
          sets: Array.isArray(payload.sets) ? payload.sets : [],
          assessment: payload.assessment || null,
        };
      }

      async function openQuestionSetPreview(payload) {
        if (!payload || !payload.questionSetId) return;

        activeSetPreviewPayload = payload;

        setPreviewEditVisible(true);
        if (qmPreviewTitle) {
          qmPreviewTitle.textContent = 'Question Preview';
        }
        if (qmPreviewBody) {
          qmPreviewBody.innerHTML = '<div class="set-preview-question"><p class="set-preview-question-text">Loading preview...</p></div>';
        }
        if (qmPreviewOverlay) {
          qmPreviewOverlay.classList.add('show');
          qmPreviewOverlay.setAttribute('aria-hidden', 'false');
        }

        try {
          var requestUrl = '/common/assessment/questions?classId=' + encodeURIComponent(String(payload.classId))
            + '&subjectId=' + encodeURIComponent(String(payload.subjectId))
            + '&termId=' + encodeURIComponent(String(payload.termId))
            + '&assessmentId=' + encodeURIComponent(String(payload.assessmentId))
            + '&questionSetId=' + encodeURIComponent(String(payload.questionSetId));

          var response = await fetch(requestUrl, { headers: { Accept: 'application/json' } });
          var result = await response.json();
          if (!response.ok || !result.success) {
            throw new Error(result.error || 'Failed to load preview.');
          }

          var sets = Array.isArray(result.sets) ? result.sets : [];
          var matchedSet = sets.find(function (row) {
            return Number(row.questionSetId || row.question_set_id || 0) === Number(payload.questionSetId);
          });

          if (!matchedSet) {
            throw new Error('Preview is unavailable for this question set right now.');
          }

          renderQuestionPreviewPayload(buildPreviewPayloadFromQuestionSet(matchedSet, payload));
        } catch (error) {
          if (qmPreviewBody) {
            qmPreviewBody.innerHTML = '<div class="set-preview-question"><p class="set-preview-question-text">Preview unavailable.</p></div>';
          }
          setQuestionStatus(error.message || 'Failed to load preview.', true);
        }
      }

      async function handleSetPreviewEdit(event) {
        if (event) {
          event.preventDefault();
          event.stopPropagation();
        }

        if (!activeSetPreviewPayload) {
          setQuestionStatus('Preview data is unavailable for editing.', true);
          return;
        }

        try {
          await openEditQuestionSet({
            questionSetId: Number(activeSetPreviewPayload.questionSetId || 0),
            assessmentId: Number(activeSetPreviewPayload.assessmentId || 0),
            classId: Number(activeSetPreviewPayload.classId || 0),
            subjectId: Number(activeSetPreviewPayload.subjectId || 0),
            termId: Number(activeSetPreviewPayload.termId || 0),
            schoolYearId: Number(activeSetPreviewPayload.schoolYearId || 0),
          });
          closeQuestionPreview();
        } catch (error) {
          setQuestionStatus(error.message || 'Failed to open question set editor.', true);
        }
      }

      async function hydrateQuestionModalFromServer() {
        if (!questionItems) return;
        var loaded = { sets: [], assessment: null };
        var sets = [];
        if (questionModalMode === 'edit') {
          setQuestionStatus('Loading question sets...', false);
          loaded = await loadQuestionSets(currentQuestionSetId);
          sets = loaded.sets || [];
        }
        if (loaded.assessment && Number(loaded.assessment.assessmentId || 0) > 0) {
          assessmentRuleMap.set(Number(loaded.assessment.assessmentId), loaded.assessment);
        }

        questionItems.innerHTML = '';
        renderAssessmentRulesSummary();

        if (!selectedAssessmentRule) {
          setQuestionEditorEnabled(false);
          setQuestionStatus('No assessments found for the selected school year and term.', true);
          updateQuestionCount();
          return;
        }

        if (questionModalMode !== 'edit') {
          currentQuestionSetId = null;
          setQuestionEditorEnabled(true);
          if (questionSetTitleInput) questionSetTitleInput.value = '';
          if (questionSetDescriptionInput) questionSetDescriptionInput.value = '';
          questionItems.appendChild(buildQuestionItem());
          setQuestionStatus('Create a new question set for this assessment.', false);
          renumberQuestionCards();
          updateQuestionCount();
          return;
        }

        if (!sets.length) {
          currentQuestionSetId = null;
          setQuestionEditorEnabled(questionModalMode !== 'edit');
          if (questionSetTitleInput) questionSetTitleInput.value = '';
          if (questionSetDescriptionInput) questionSetDescriptionInput.value = '';
          if (questionModalMode !== 'edit') {
            questionItems.appendChild(buildQuestionItem());
            setQuestionStatus('No question set found for this assessment. Create one now.', false);
          } else {
            setQuestionStatus('No question set found to edit for this assessment.', true);
          }
          renumberQuestionCards();
          updateQuestionCount();
          return;
        }

        var selectedSet = sets.find(function (setRow) {
          return Number(setRow.questionSetId || 0) === Number(currentQuestionSetId || 0);
        }) || sets[0];

        currentQuestionSetId = selectedSet.questionSetId || currentQuestionSetId || null;
        if (questionSetTitleInput) questionSetTitleInput.value = selectedSet.setTitle || '';
        if (questionSetDescriptionInput) questionSetDescriptionInput.value = selectedSet.setDescription || '';
        applyQuestionCardsLayoutMode(selectedSet.questionCardLayout || 'stacked');

        (selectedSet.questions || []).forEach(function (question) {
          questionItems.appendChild(buildQuestionItem(question));
        });

        if (!selectedSet.questions || !selectedSet.questions.length) {
          questionItems.appendChild(buildQuestionItem());
        }

        renumberQuestionCards();
        updateQuestionCount();

        if (questionModalMode === 'edit') {
          setQuestionEditorEnabled(true);
          setQuestionStatus('Editing existing question set. Save changes to send for review.', false);
        } else {
          setQuestionEditorEnabled(false);
          setQuestionStatus('Questions already exist for this assessment (status: ' + String(selectedSet.reviewStatus || 'pending').toLowerCase() + '). Use Edit to improve it.', true);
        }
      }

      async function openEditQuestionSet(payload) {
        if (!payload || !Number(payload.questionSetId)) return;

        setQuestionModalMode('edit');
        currentQuestionSetId = Number(payload.questionSetId);
        openQuestionModal();

        renderQuestionModalSchoolYears();
        if (questionSchoolYearSelect && Number(payload.schoolYearId) > 0) {
          questionSchoolYearSelect.value = String(Number(payload.schoolYearId));
        }

        renderQuestionModalTerms();
        if (questionTermSelect && Number(payload.termId) > 0) {
          questionTermSelect.value = String(Number(payload.termId));
        }

        renderQuestionModalClasses();
        if (questionClassSelect && Number(payload.classId) > 0) {
          questionClassSelect.value = String(Number(payload.classId));
        }

        renderQuestionModalSubjects();
        if (questionSubjectSelect && Number(payload.subjectId) > 0) {
          questionSubjectSelect.value = String(Number(payload.subjectId));
        }

        await renderQuestionModalAssessments();
        if (questionAssessmentSelect && Number(payload.assessmentId) > 0) {
          questionAssessmentSelect.value = String(Number(payload.assessmentId));
        }

        renderAssessmentRulesSummary();
        await hydrateQuestionModalFromServer();
      }

      function toNumberOrNull(value) {
        if (value === null || value === undefined) return null;
        var raw = String(value).trim();
        if (!raw) return null;
        var parsed = Number(raw);
        return Number.isFinite(parsed) ? parsed : null;
      }

      function normalizeTextValue(value) {
        return String(value || '').trim().toLowerCase();
      }

      function resolveAssessmentMaxScore(assessmentId) {
        var normalizedId = Number(assessmentId || 0);
        if (!normalizedId) return null;
        var match = (assessmentsForTermData || []).find(function (row) {
          return Number(row.assessment_id || row.assessmentId || 0) === normalizedId;
        });
        if (!match) return null;

        var rawMax =
          match.max_score !== undefined && match.max_score !== null
            ? match.max_score
            : (match.maxScore !== undefined && match.maxScore !== null ? match.maxScore : null);
        var maxScore = Number(rawMax);
        return Number.isFinite(maxScore) && maxScore > 0 ? maxScore : null;
      }

      function buildSetFilterOptions() {
        if (!questionSetDetails.length) return;
        if (!classFilterSelect || !subjectFilterSelect || !assessmentFilterSelect) return;

        var classMap = new Map();
        var subjectMap = new Map();
        var assessmentMap = new Map();

        questionSetDetails.forEach(function (detailsItem) {
          var classId = String(detailsItem.getAttribute('data-class-id') || '').trim();
          var className = String(detailsItem.getAttribute('data-class-name') || '').trim();
          var subjectId = String(detailsItem.getAttribute('data-subject-id') || '').trim();
          var subjectName = String(detailsItem.getAttribute('data-subject-name') || '').trim();
          var assessmentId = String(detailsItem.getAttribute('data-assessment-id') || '').trim();
          var assessmentTitle = String(detailsItem.getAttribute('data-assessment-title') || '').trim();

          if (classId) classMap.set(classId, className);
          if (subjectId) subjectMap.set(subjectId, subjectName);
          if (assessmentId) assessmentMap.set(assessmentId, assessmentTitle);

          var points = Number(detailsItem.getAttribute('data-total-points') || 0);
          var maxScore = resolveAssessmentMaxScore(assessmentId);
          if (Number.isFinite(points) && maxScore && maxScore > 0) {
            detailsItem.setAttribute('data-percentage', String((points / maxScore) * 100));
          } else {
            detailsItem.setAttribute('data-percentage', '');
          }
        });

        function refillSelect(selectEl, mapData, defaultLabel) {
          var selectedValue = String(selectEl.value || '');
          selectEl.innerHTML = '';

          var defaultOption = document.createElement('option');
          defaultOption.value = '';
          defaultOption.textContent = defaultLabel;
          selectEl.appendChild(defaultOption);

          Array.from(mapData.entries())
            .sort(function (a, b) {
              return String(a[1] || '').localeCompare(String(b[1] || ''));
            })
            .forEach(function (entry) {
              var opt = document.createElement('option');
              opt.value = String(entry[0]);
              opt.textContent = String(entry[1] || '').replace(/(^\w|\s\w)/g, function (m) { return m.toUpperCase(); });
              selectEl.appendChild(opt);
            });

          if (selectedValue && Array.from(mapData.keys()).includes(selectedValue)) {
            selectEl.value = selectedValue;
          }
        }

        refillSelect(classFilterSelect, classMap, 'All Classes');
        refillSelect(subjectFilterSelect, subjectMap, 'All Subjects');
        refillSelect(assessmentFilterSelect, assessmentMap, 'All Assessments');

        if (sortFilterSelect && !String(sortFilterSelect.value || '').trim()) {
          sortFilterSelect.value = 'normal';
        }
      }

      function sortQuestionSetCards(cards, sortBy) {
        var list = cards.slice();

        function compareNumber(a, b, key, direction) {
          var av = Number(a.getAttribute(key) || 0);
          var bv = Number(b.getAttribute(key) || 0);
          return direction === 'asc' ? av - bv : bv - av;
        }

        function compareText(a, b, key) {
          return String(a.getAttribute(key) || '').localeCompare(String(b.getAttribute(key) || ''));
        }

        list.sort(function (a, b) {
          switch (sortBy) {
            case 'normal':
              return 0;
            case 'class-az':
            case 'class-za':
            case 'subject-az':
            case 'assessment-az':
              return 0;
            case 'updated-asc':
              return compareNumber(a, b, 'data-updated-at', 'asc');
            case 'points-desc':
              return compareNumber(a, b, 'data-total-points', 'desc');
            case 'points-asc':
              return compareNumber(a, b, 'data-total-points', 'asc');
            case 'percent-desc':
              return compareNumber(a, b, 'data-percentage', 'desc');
            case 'percent-asc':
              return compareNumber(a, b, 'data-percentage', 'asc');
            case 'questions-desc':
              return compareNumber(a, b, 'data-question-count', 'desc');
            case 'questions-asc':
              return compareNumber(a, b, 'data-question-count', 'asc');
            case 'subject-az':
              return compareText(a, b, 'data-subject-name');
            case 'assessment-az':
              return compareText(a, b, 'data-assessment-title');
            default:
              return compareNumber(a, b, 'data-updated-at', 'desc');
          }
        });

        return list;
      }

      function applyQuestionSetFilters() {
        if (!questionSetDetails.length) return;

        var classIdFilter = String(classFilterSelect ? classFilterSelect.value : '').trim();
        var subjectIdFilter = String(subjectFilterSelect ? subjectFilterSelect.value : '').trim();
        var assessmentIdFilter = String(assessmentFilterSelect ? assessmentFilterSelect.value : '').trim();
        var reviewStatusFilter = normalizeTextValue(reviewStatusFilterSelect ? reviewStatusFilterSelect.value : '');
        var searchText = normalizeTextValue(searchFilterInput ? searchFilterInput.value : '');
        var sortBy = String(sortFilterSelect ? sortFilterSelect.value : 'normal').trim() || 'normal';

        var minPoints = toNumberOrNull(pointsMinInput ? pointsMinInput.value : null);
        var maxPoints = toNumberOrNull(pointsMaxInput ? pointsMaxInput.value : null);
        var minPercent = toNumberOrNull(percentMinInput ? percentMinInput.value : null);
        var maxPercent = toNumberOrNull(percentMaxInput ? percentMaxInput.value : null);

        var visibleCount = 0;

        classGroups.forEach(function (groupSection) {
          var subjectSections = Array.prototype.slice.call(groupSection.querySelectorAll('.js-subject-group'));

          subjectSections.forEach(function (subjectSection) {
            var assessmentSections = Array.prototype.slice.call(subjectSection.querySelectorAll('.js-assessment-group'));

            assessmentSections.forEach(function (assessmentSection) {
              var cards = Array.prototype.slice.call(assessmentSection.querySelectorAll('.js-question-set-details'));

              cards.forEach(function (card) {
                var cardClassId = String(card.getAttribute('data-class-id') || '').trim();
                var cardSubjectId = String(card.getAttribute('data-subject-id') || '').trim();
                var cardAssessmentId = String(card.getAttribute('data-assessment-id') || '').trim();
                var cardReviewStatus = normalizeTextValue(card.getAttribute('data-review-status') || '');
                var cardPoints = Number(card.getAttribute('data-total-points') || 0);
                var cardPercentRaw = card.getAttribute('data-percentage');
                var cardPercent = cardPercentRaw === '' ? null : Number(cardPercentRaw);
                var searchBlob = [
                  card.getAttribute('data-set-title'),
                  card.getAttribute('data-class-name'),
                  card.getAttribute('data-subject-name'),
                  card.getAttribute('data-assessment-title')
                ].map(normalizeTextValue).join(' ');

                var matches = true;

                if (classIdFilter && cardClassId !== classIdFilter) matches = false;
                if (subjectIdFilter && cardSubjectId !== subjectIdFilter) matches = false;
                if (assessmentIdFilter && cardAssessmentId !== assessmentIdFilter) matches = false;
                if (reviewStatusFilter && cardReviewStatus !== reviewStatusFilter) matches = false;
                if (Number.isFinite(minPoints) && cardPoints < minPoints) matches = false;
                if (Number.isFinite(maxPoints) && cardPoints > maxPoints) matches = false;
                if (Number.isFinite(minPercent) && (!Number.isFinite(cardPercent) || cardPercent < minPercent)) matches = false;
                if (Number.isFinite(maxPercent) && (!Number.isFinite(cardPercent) || cardPercent > maxPercent)) matches = false;
                if (searchText && searchBlob.indexOf(searchText) === -1) matches = false;

                card.hidden = !matches;
                if (matches) visibleCount += 1;
              });

              var sortedCards = sortQuestionSetCards(cards, sortBy);
              var grid = assessmentSection.querySelector('.exam-grid');
              if (grid) {
                sortedCards.forEach(function (card) {
                  grid.appendChild(card);
                });
              }

              var hasVisibleCard = cards.some(function (card) { return !card.hidden; });
              assessmentSection.hidden = !hasVisibleCard;
            });

            if (sortBy === 'assessment-az') {
              var assessmentContainer = subjectSection.querySelector('.assessment-group-list');
              if (assessmentContainer) {
                assessmentSections
                  .slice()
                  .sort(function (a, b) {
                    var aName = String(a.getAttribute('data-assessment-name') || '');
                    var bName = String(b.getAttribute('data-assessment-name') || '');
                    return aName.localeCompare(bName);
                  })
                  .forEach(function (section) {
                    assessmentContainer.appendChild(section);
                  });
              }
            }

            var hasVisibleAssessment = assessmentSections.some(function (section) { return !section.hidden; });
            subjectSection.hidden = !hasVisibleAssessment;
          });

          if (sortBy === 'subject-az') {
            var subjectContainer = groupSection.querySelector('.subject-group-list');
            if (subjectContainer) {
              subjectSections
                .slice()
                .sort(function (a, b) {
                  var aName = String(a.getAttribute('data-subject-name') || '');
                  var bName = String(b.getAttribute('data-subject-name') || '');
                  return aName.localeCompare(bName);
                })
                .forEach(function (section) {
                  subjectContainer.appendChild(section);
                });
            }
          }

          var hasVisibleSubject = subjectSections.some(function (section) { return !section.hidden; });
          groupSection.hidden = !hasVisibleSubject;
        });

        if (classGroupsRoot && (sortBy === 'class-az' || sortBy === 'class-za')) {
          var orderedGroups = classGroups.slice().sort(function (a, b) {
            var aName = String(a.getAttribute('data-class-name') || '');
            var bName = String(b.getAttribute('data-class-name') || '');
            return sortBy === 'class-az' ? aName.localeCompare(bName) : bName.localeCompare(aName);
          });
          orderedGroups.forEach(function (group) {
            classGroupsRoot.appendChild(group);
          });
        }

        if (questionSetFilterEmpty) {
          questionSetFilterEmpty.hidden = visibleCount > 0;
        }

        if (setFilterStatus) {
          if (visibleCount <= 0) {
            setFilterStatus.textContent = 'No question sets match the current filters.';
          } else {
            if (sortBy === 'normal') {
              setFilterStatus.textContent = 'Normal view active. Showing ' + visibleCount + ' question set' + (visibleCount === 1 ? '' : 's') + '.';
            } else {
              setFilterStatus.textContent = 'Showing ' + visibleCount + ' question set' + (visibleCount === 1 ? '' : 's') + '.';
            }
          }
        }
      }

      function resetQuestionSetFilters() {
        if (classFilterSelect) classFilterSelect.value = '';
        if (subjectFilterSelect) subjectFilterSelect.value = '';
        if (assessmentFilterSelect) assessmentFilterSelect.value = '';
        if (reviewStatusFilterSelect) reviewStatusFilterSelect.value = '';
        if (pointsMinInput) pointsMinInput.value = '';
        if (pointsMaxInput) pointsMaxInput.value = '';
        if (percentMinInput) percentMinInput.value = '';
        if (percentMaxInput) percentMaxInput.value = '';
        if (searchFilterInput) searchFilterInput.value = '';
        if (sortFilterSelect) sortFilterSelect.value = 'normal';
      }

      function applyNormalQuestionSetView() {
        resetQuestionSetFilters();
        applyQuestionSetFilters();
      }

      function buildTermRedirectUrl(chosenTermId) {
        var redirectUrl = '/common/allClassAssessmentExams?organizationId=' + encodeURIComponent(String(organizationId)) + '&termId=' + encodeURIComponent(String(chosenTermId));
        if (selectedClassId > 0) {
          redirectUrl += '&classId=' + encodeURIComponent(String(selectedClassId));
        }
        if (isEmbedded) {
          redirectUrl += '&embed=workspace';
        }
        return redirectUrl;
      }

      function updateWorkspaceFiltersHint() {
        if (!workspaceFiltersCard || !workspaceFiltersHint) return;
        workspaceFiltersHint.textContent = workspaceFiltersCard.open ? 'Collapse' : 'Expand';
      }

      function renderSchoolYears() {
        if (!schoolYearSelect) return;
        schoolYearSelect.innerHTML = '';

        schoolYears.forEach(function (year) {
          var opt = document.createElement('option');
          opt.value = String(year.schoolYearId);
          opt.textContent = year.yearLabel;
          schoolYearSelect.appendChild(opt);
        });

        if (!schoolYears.length) return;

        var exists = schoolYears.some(function (year) {
          return Number(year.schoolYearId) === Number(selectedSchoolYearId);
        });
        var fallbackId = Number(schoolYears[0].schoolYearId || 0);
        schoolYearSelect.value = String(exists ? selectedSchoolYearId : fallbackId);
      }

      function renderTerms() {
        if (!termSelect || !schoolYearSelect) return;
        termSelect.innerHTML = '';

        var schoolYearId = Number(schoolYearSelect.value || 0);
        var schoolYear = schoolYears.find(function (year) {
          return Number(year.schoolYearId) === schoolYearId;
        });
        var terms = schoolYear && Array.isArray(schoolYear.terms) ? schoolYear.terms : [];

        terms.forEach(function (term) {
          var opt = document.createElement('option');
          opt.value = String(term.termId);
          opt.textContent = term.termName;
          termSelect.appendChild(opt);
        });

        if (!terms.length) return;

        var hasSelectedTerm = terms.some(function (term) {
          return Number(term.termId) === Number(selectedTermId);
        });
        termSelect.value = String(hasSelectedTerm ? selectedTermId : Number(terms[0].termId));
      }

      function renderReuseSchoolYears() {
        if (!reuseSchoolYearSelect) return;
        reuseSchoolYearSelect.innerHTML = '';

        schoolYears.forEach(function (year) {
          var opt = document.createElement('option');
          opt.value = String(year.schoolYearId);
          opt.textContent = year.yearLabel;
          reuseSchoolYearSelect.appendChild(opt);
        });

        if (!schoolYears.length) return;
        var exists = schoolYears.some(function (year) {
          return Number(year.schoolYearId) === Number(selectedSchoolYearId);
        });
        reuseSchoolYearSelect.value = String(exists ? selectedSchoolYearId : Number(schoolYears[0].schoolYearId));
      }

      function renderReuseTerms() {
        if (!reuseTermSelect || !reuseSchoolYearSelect) return;
        reuseTermSelect.innerHTML = '';

        var schoolYearId = Number(reuseSchoolYearSelect.value || 0);
        var schoolYear = schoolYears.find(function (year) {
          return Number(year.schoolYearId) === schoolYearId;
        });
        var terms = schoolYear && Array.isArray(schoolYear.terms) ? schoolYear.terms : [];

        terms.forEach(function (term) {
          var opt = document.createElement('option');
          opt.value = String(term.termId);
          opt.textContent = term.termName;
          reuseTermSelect.appendChild(opt);
        });

        if (!terms.length) return;
        var hasCurrent = terms.some(function (term) { return Number(term.termId) === Number(selectedTermId); });
        reuseTermSelect.value = String(hasCurrent ? selectedTermId : Number(terms[0].termId));
      }

      function getTermClasses(termId) {
        var classMap = new Map();
        termClassSubjects.forEach(function (row) {
          if (Number(row.term_id) !== Number(termId)) return;
          var key = Number(row.class_id);
          if (!classMap.has(key)) {
            classMap.set(key, { class_id: key, class_name: row.class_name || ('Class ' + key) });
          }
        });
        return Array.from(classMap.values()).sort(function (a, b) {
          return String(a.class_name).localeCompare(String(b.class_name));
        });
      }

      function getTermClassSubjects(termId, classId) {
        return termClassSubjects
          .filter(function (row) {
            return Number(row.term_id) === Number(termId) && Number(row.class_id) === Number(classId) && Number(row.subject_id || 0) > 0;
          })
          .map(function (row) {
            return { subject_id: Number(row.subject_id), subject_name: row.subject_name || ('Subject ' + row.subject_id) };
          })
          .sort(function (a, b) {
            return String(a.subject_name).localeCompare(String(b.subject_name));
          });
      }

      function renderReuseClasses() {
        if (!reuseClassSelect || !reuseTermSelect) return;
        reuseClassSelect.innerHTML = '';
        var termId = Number(reuseTermSelect.value || 0);
        var termClasses = getTermClasses(termId);

        termClasses.forEach(function (row) {
          var opt = document.createElement('option');
          opt.value = String(row.class_id);
