  <script>
    (function () {
      var schoolYears = <%- JSON.stringify(schoolYears || []) %>;
      var termClassSubjects = <%- JSON.stringify(termClassSubjects || []) %>;
      var assessmentsForOrg = <%- JSON.stringify(assessmentsForOrg || []) %>;
      var assessmentsForTermData = <%- JSON.stringify(assessmentsForTerm || []) %>;
      var selectedSchoolYearId = Number("<%= selectedSchoolYearId || 0 %>");
      var selectedTermId = Number("<%= termId %>");
      var organizationId = Number("<%= organizationId %>");
      var DRAFT_KEY = 'questionModalDraft_org' + organizationId;
      var previewSchoolName = <%- JSON.stringify((session && (session.organizationName || session.organization_name || session.schoolName || session.orgName)) || 'School') %>;
      var previewSchoolLogo = <%- JSON.stringify((session && session.logo) || '') %>;

      var schoolYearSelect = document.getElementById('workspace-school-year');
      var termSelect = document.getElementById('workspace-term');
      var openTermWorkspaceButton = document.getElementById('open-term-workspace');
      var questionSetDetails = Array.prototype.slice.call(document.querySelectorAll('.js-question-set-details'));

      var allClassSetQuestionsButton = document.getElementById('all-class-set-questions');
      var questionModalOverlay = document.getElementById('question-modal-overlay');
      var questionModalClose = document.getElementById('question-modal-close');
      var questionSchoolYearSelect = document.getElementById('question-school-year');
      var questionTermSelect = document.getElementById('question-term');
      var questionClassSelect = document.getElementById('question-class');
      var questionSubjectSelect = document.getElementById('question-subject');
      var questionAssessmentSelect = document.getElementById('question-assessment');
      var questionOpenBookSelect = document.getElementById('question-open-book');
      var questionTimeLimitInput = document.getElementById('question-time-limit');
      var questionSetTitleInput = document.getElementById('question-set-title');
      var questionSetDescriptionInput = document.getElementById('question-set-description');
      var questionAssessmentRules = document.getElementById('question-assessment-rules');
      var questionItems = document.getElementById('question-items');
      var addQuestionItemButton = document.getElementById('add-question-item');
      var saveQuestionSetButton = document.getElementById('save-question-set');
      var questionModalStatus = document.getElementById('question-modal-status');
      var qmClearDraftButton = document.getElementById('qm-clear-draft');
      var qmDraftBanner = document.getElementById('qm-draft-banner');
      var qmUploadPdfBtn = document.getElementById('qm-upload-pdf-btn');
      var qmPdfFileInput = document.getElementById('qm-pdf-file-input');
      var qmPreviewOpenButton = document.getElementById('qm-preview-open');
      var qmPreviewOverlay = document.getElementById('qm-preview-overlay');
      var qmPreviewCloseButton = document.getElementById('qm-preview-close');
      var qmPreviewPrintButton = document.getElementById('qm-preview-print');
      var qmPreviewBody = document.getElementById('qm-preview-body');

      var reuseModalOverlay = document.getElementById('reuse-modal-overlay');
      var reuseSourceSummary = document.getElementById('reuse-source-summary');
      var reuseSchoolYearSelect = document.getElementById('reuse-school-year');
      var reuseTermSelect = document.getElementById('reuse-term');
      var reuseClassSelect = document.getElementById('reuse-class');
      var reuseSubjectSelect = document.getElementById('reuse-subject');
      var reuseAssessmentTitleInput = document.getElementById('reuse-assessment-title');
      var reuseShuffleModeSelect = document.getElementById('reuse-shuffle-mode');
      var reuseShuffleOptionsInput = document.getElementById('reuse-shuffle-options');
      var reuseConfirmButton = document.getElementById('reuse-confirm-btn');
      var reuseCancelButton = document.getElementById('reuse-cancel-btn');
      var reuseStatus = document.getElementById('reuse-status');

      var studentsModalOverlay = document.getElementById('students-modal-overlay');
      var studentsModalClose = document.getElementById('students-modal-close');
      var studentsModalTitle = document.getElementById('students-modal-title');
      var studentsModalSubtitle = document.getElementById('students-modal-subtitle');
      var studentsSummary = document.getElementById('students-summary');
      var studentsStatus = document.getElementById('students-status');
      var studentsUnlockAllButton = document.getElementById('students-unlock-all-btn');
      var studentsTableBody = document.getElementById('students-table-body');

      var activeSourceQuestionSetId = 0;
      var currentQuestionSetId = null;
      var questionModalMode = 'create';
      var selectedAssessmentRule = null;
      var activeStudentsQuestionSetId = 0;
      var latestStudentsPayload = null;
      var assessmentRuleMap = new Map(
        assessmentsForOrg.map(function (assessment) {
          return [Number(assessment.assessment_id), {
            assessmentId: Number(assessment.assessment_id),
            termId: Number(assessment.term_id),
            schoolYearId: Number(assessment.school_year_id),
            classId: Number(assessment.class_id),
            subjectId: Number(assessment.subject_id),
            title: assessment.title,
            weight: Number(assessment.weight || 0),
            maxScore: Number(assessment.max_score || 0),
            category: assessment.category || 'Assessment',
            scaleBase: Number(assessment.scale_base || 100),
            openBook: Boolean(assessment.open_book),
            timeLimitMinutes: assessment.time_limit_minutes !== null && assessment.time_limit_minutes !== undefined
              ? Number(assessment.time_limit_minutes)
              : null,
            canEditScores: Boolean(assessment.can_edit_scores),
            accessReason: assessment.access_reason || '',
          }];
        })
      );

      function setQuestionStatus(message, isError) {
        if (!questionModalStatus) return;
        questionModalStatus.textContent = message || '';
        questionModalStatus.style.color = isError ? '#b91c1c' : '#64748b';
      }

      function setReuseStatus(message, isError) {
        if (!reuseStatus) return;
        reuseStatus.textContent = message || '';
        reuseStatus.style.color = isError ? '#b91c1c' : '#607080';
      }

      function setStudentsStatus(message, isError) {
        if (!studentsStatus) return;
        studentsStatus.textContent = String(message || '');
        studentsStatus.style.color = isError ? '#b91c1c' : '#607080';
      }

      function closeStudentsModal() {
        if (!studentsModalOverlay) return;
        studentsModalOverlay.classList.remove('show');
        studentsModalOverlay.setAttribute('aria-hidden', 'true');
      }

      function openStudentsModal() {
        if (!studentsModalOverlay) return;
        studentsModalOverlay.classList.add('show');
        studentsModalOverlay.setAttribute('aria-hidden', 'false');
      }

      function formatStudentName(student) {
        if (!student) return 'Student';
        var lastName = String(student.lastName || '').trim();
        var firstName = String(student.firstName || '').trim();
        var fullName = [lastName, firstName].filter(Boolean).join(', ');
        if (!fullName) {
          fullName = 'Student #' + String(student.studentId || '');
        }
        return fullName;
      }

      function mapAttemptStatusLabel(status) {
        var normalized = String(status || '').toLowerCase();
        if (normalized === 'submitted') return 'Completed';
        if (normalized === 'in_progress') return 'In progress';
        if (normalized === 'not_started') return 'Not started';
        return normalized ? (normalized.charAt(0).toUpperCase() + normalized.slice(1)) : 'Not started';
      }

      function formatAttemptTime(value) {
        if (!value) return '-';
        var date = new Date(value);
        if (Number.isNaN(date.getTime())) return '-';
        return date.toLocaleString();
      }

      function renderStudentsSummary(payload) {
        if (!studentsSummary) return;
        var summary = payload && payload.summary ? payload.summary : {};
        var totalStudents = Number(summary.totalStudents || 0);
        var completedCount = Number(summary.completedCount || 0);
        var unlockedCount = Number(summary.unlockedCount || 0);
        studentsSummary.innerHTML = [
          '<span class="exam-pill">Total: ' + totalStudents + '</span>',
          '<span class="exam-pill">Completed / Locked: ' + completedCount + '</span>',
          '<span class="exam-pill">Open: ' + unlockedCount + '</span>'
        ].join('');
      }

      function renderStudentsRows(payload) {
        if (!studentsTableBody) return;

        var rows = Array.isArray(payload && payload.students) ? payload.students : [];
        if (!rows.length) {
          studentsTableBody.innerHTML = '<tr><td colspan="7" class="student-subtle">No eligible students found for this class and term.</td></tr>';
          return;
        }

        var markup = rows.map(function (student) {
          var statusLabel = mapAttemptStatusLabel(student.attemptStatus);
          var startedLabel = formatAttemptTime(student.startedAt);
          var finishedLabel = formatAttemptTime(student.submittedAt);
          var scoreLabel = (student.score !== null && student.score !== undefined)
            ? (String(student.score) + (student.maxScore !== null && student.maxScore !== undefined ? (' / ' + String(student.maxScore)) : ''))
            : '-';
          var isLocked = Boolean(student.isLocked);
          var lockLabel = isLocked ? 'Locked' : 'Open';
          var actionLabel = isLocked ? 'Unlock' : 'Lock';
          var actionType = isLocked ? 'unlock' : 'lock';
          var actionDisabled = false;
          var actionDisabledAttr = actionDisabled ? ' disabled="disabled" aria-disabled="true"' : '';
          var actionDisabledClass = actionDisabled ? ' is-disabled' : '';
          return [
            '<tr>',
            '  <td>',
            '    <div class="student-name">' + escapeHtml(formatStudentName(student)) + '</div>',
            '    <div class="student-subtle">ID: ' + escapeHtml(String(student.studentId || '-')) + '</div>',
            '  </td>',
            '  <td>' + escapeHtml(statusLabel) + '</td>',
            '  <td class="time-cell">' + escapeHtml(startedLabel) + '</td>',
            '  <td class="time-cell">' + escapeHtml(finishedLabel) + '</td>',
            '  <td>' + escapeHtml(scoreLabel) + '</td>',
            '  <td>' + escapeHtml(lockLabel) + '</td>',
            '  <td>',
            '    <button type="button" class="btn btn-secondary student-lock-toggle-btn' + actionDisabledClass + '" data-student-id="' + escapeHtml(String(student.studentId || '')) + '" data-action="' + escapeHtml(actionType) + '"' + actionDisabledAttr + '>' + escapeHtml(actionLabel) + '</button>',
            '  </td>',
            '</tr>'
          ].join('');
        }).join('');

        studentsTableBody.innerHTML = markup;

        studentsTableBody.querySelectorAll('.student-lock-toggle-btn').forEach(function (button) {
          button.addEventListener('click', async function () {
            if (button.classList.contains('is-disabled')) return;
            var targetStudentId = Number(button.getAttribute('data-student-id') || 0);
            var action = String(button.getAttribute('data-action') || '');
            if (!targetStudentId || !activeStudentsQuestionSetId) return;

            var originalLabel = button.textContent;

            if (action === 'lock') {
              var lockApproved = window.confirm('Lock this student\'s current attempt now? They will stop seeing the assessment until it is unlocked again.');
              if (!lockApproved) return;

              button.disabled = true;
              button.textContent = 'Locking...';
              setStudentsStatus('Locking student...', false);

              try {
                var lockResponse = await fetch('/common/assessment/questions/students/unlock', {
                  method: 'POST',
                  headers: {
                    'Content-Type': 'application/json',
                    Accept: 'application/json',
                  },
                  body: JSON.stringify({
                    questionSetId: activeStudentsQuestionSetId,
                    studentId: targetStudentId,
                    unlockAll: false,
                    action: 'lock',
                  }),
                });

                var lockResult = await lockResponse.json();
                if (!lockResponse.ok || !lockResult.success) {
                  throw new Error(lockResult.error || 'Failed to lock student.');
                }

                setStudentsStatus(lockResult.message || 'Student locked.', false);
                await loadStudentsForQuestionSet(activeStudentsQuestionSetId);
              } catch (error) {
                setStudentsStatus(error.message || 'Failed to lock student.', true);
                button.disabled = false;
                button.textContent = originalLabel;
              }
              return;
            }

            if (action !== 'unlock') return;

            var approved = window.confirm('Unlock this student so they can retake the assessment?');
            if (!approved) return;

            var reshuffleQuestions = window.confirm('Should the questions be reshuffled for this retake? Click OK to reshuffle, or Cancel to keep the same order.');

            button.disabled = true;
            button.textContent = 'Unlocking...';
            setStudentsStatus('Unlocking student...', false);

            try {
              var response = await fetch('/common/assessment/questions/students/unlock', {
                method: 'POST',
                headers: {
                  'Content-Type': 'application/json',
                  Accept: 'application/json',
                },
                body: JSON.stringify({
                  questionSetId: activeStudentsQuestionSetId,
                  studentId: targetStudentId,
                  unlockAll: false,
                  action: 'unlock',
                  reshuffleQuestions: reshuffleQuestions,
                }),
              });

              var result = await response.json();
              if (!response.ok || !result.success) {
                throw new Error(result.error || 'Failed to unlock student.');
              }

              setStudentsStatus(result.message || 'Student unlocked.', false);
              await loadStudentsForQuestionSet(activeStudentsQuestionSetId);
            } catch (error) {
              setStudentsStatus(error.message || 'Failed to unlock student.', true);
              button.disabled = false;
              button.textContent = originalLabel;
            }
          });
        });
      }

      async function loadStudentsForQuestionSet(questionSetId) {
        if (!Number.isInteger(Number(questionSetId)) || Number(questionSetId) <= 0) {
          return;
        }

        activeStudentsQuestionSetId = Number(questionSetId);
        latestStudentsPayload = null;
        if (studentsTableBody) {
          studentsTableBody.innerHTML = '<tr><td colspan="7" class="student-subtle">Loading students...</td></tr>';
        }
        setStudentsStatus('Loading students...', false);

        var requestUrl = '/common/assessment/questions/students?questionSetId=' + encodeURIComponent(String(activeStudentsQuestionSetId));
        var response = await fetch(requestUrl, {
          method: 'GET',
          headers: { Accept: 'application/json' },
        });
        var payload = await response.json();
        if (!response.ok || !payload.success) {
          throw new Error(payload.error || 'Failed to load students.');
        }

        latestStudentsPayload = payload;
        var scope = payload.scope || {};
        if (studentsModalTitle) {
          studentsModalTitle.textContent = 'Students: ' + String(scope.setTitle || 'Question Set');
        }
        if (studentsModalSubtitle) {
          studentsModalSubtitle.textContent = [
            String(scope.className || 'Class'),
            String(scope.subjectName || 'Subject'),
            String(scope.assessmentTitle || 'Assessment')
          ].join(' • ');
        }

        renderStudentsSummary(payload);
        renderStudentsRows(payload);

        var completedCount = Number((payload.summary && payload.summary.completedCount) || 0);
        if (studentsUnlockAllButton) {
          studentsUnlockAllButton.disabled = completedCount <= 0;
          studentsUnlockAllButton.classList.toggle('is-disabled', completedCount <= 0);
        }

        setStudentsStatus('Loaded ' + String((payload.summary && payload.summary.totalStudents) || 0) + ' student(s).', false);
      }

      function renderUploadButtonIdle() {
        if (!qmUploadPdfBtn) return;
        qmUploadPdfBtn.classList.remove('loading');
        qmUploadPdfBtn.innerHTML = [
          '<svg width="15" height="15" viewBox="0 0 16 16" fill="none">',
          '<path d="M8 10V3M5 6l3-3 3 3M3 11v1a1 1 0 001 1h8a1 1 0 001-1v-1" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/>',
          '</svg>',
          'Import Exam File'
        ].join('');
      }

      function setUploadButtonLoading(labelText) {
        if (!qmUploadPdfBtn) return;
        qmUploadPdfBtn.classList.add('loading');
        qmUploadPdfBtn.innerHTML = '<span class="qm-spinner"></span>' + String(labelText || 'Processing...');
      }

      function normalizeExtractedQuestionType(rawType) {
        var t = String(rawType || '').trim().toLowerCase().replace(/[\s_-]+/g, '_');
        if (!t) return 'short_text';
        if (['multiple_choice', 'mcq', 'multiple choice'].includes(t)) return 'multiple_choice';
        if (['single_choice', 'one_choice', 'single choice', 'one choice'].includes(t)) return 'single_choice';
        if (['true_false', 'true/false', 'true false'].includes(t)) return 'true_false';
        if (['short_text', 'short_answer', 'short answer', 'short_ans'].includes(t)) return 'short_text';
        if (['fill_blank', 'fill_in_the_blank', 'fill blank'].includes(t)) return 'short_text';
        if (['matching'].includes(t)) return 'short_text';
        if (['essay'].includes(t)) return 'essay';
        return 'short_text';
      }

      function populateQuestionsFromExtracted(extractedQuestions, sourceLabel) {
        if (!questionItems) return;

        var normalizedQuestions = Array.isArray(extractedQuestions)
          ? extractedQuestions.map(function (item, index) {
              var type = normalizeExtractedQuestionType(item.questionType);
              var questionText = String(item.questionText || item.question || '').trim();

              // Skip section headers that slipped through
              if (/^[A-G]\s+(MULTIPLE|TRUE|FILL|MATCHING|SHORT|ESSAY)/i.test(questionText)) return null;
              if (/^GENERAL INSTRUCTIONS/i.test(questionText)) return null;
              if (/End of Paper/i.test(questionText)) return null;
              if (questionText.length < 4) return null;

              var options = Array.isArray(item.options)
                ? item.options.map(function (opt) { return String(opt || '').trim(); }).filter(Boolean)
                : [];

              var extractedAnswers = [];
              if (Array.isArray(item.answerKeys)) {
                extractedAnswers = item.answerKeys
                  .map(function (ans) { return String(ans || '').trim(); })
                  .filter(Boolean);
              } else if (item.answerKey !== undefined && item.answerKey !== null) {
                extractedAnswers = parseAnswerValues(item.answerKey);
              } else if (item.answer !== undefined && item.answer !== null) {
                extractedAnswers = parseAnswerValues(item.answer);
              }

              if (type === 'true_false' && !options.length) {
                options = ['True', 'False'];
              }

              var marks = Number(item.marks || item.mark || item.points || 1);
              var questionNumber = Number(item.questionNumber);
              return {
                questionNumber: Number.isInteger(questionNumber) && questionNumber > 0 ? questionNumber : (index + 1),
                questionType: ['multiple_choice', 'single_choice', 'true_false', 'short_text', 'essay'].includes(type)
                  ? type
                  : 'short_text',
                questionText: questionText,
                options: options,
                answerKeys: extractedAnswers,
                marks: Number.isFinite(marks) && marks > 0 ? marks : 1,
              };
            }).filter(function (item) {
              return item && item.questionText;
            })
          : [];

        normalizedQuestions.sort(function (a, b) {
          return a.questionNumber - b.questionNumber;
        });

        if (!normalizedQuestions.length) {
          setQuestionStatus('No questions were detected in the uploaded PDF.', true);
          return;
        }

        questionItems.innerHTML = '';
        normalizedQuestions.forEach(function (question) {
          questionItems.appendChild(buildQuestionItem(question));
        });

        renumberQuestionCards();
        updateQuestionCount();
        saveDraft();

        var sourceText = sourceLabel ? ' from ' + sourceLabel : '';
        setQuestionStatus(
          normalizedQuestions.length + ' question' + (normalizedQuestions.length === 1 ? '' : 's') +
          ' extracted' + sourceText + '. Review and save.',
          false
        );
      }

      function escapeHtml(value) {
        return String(value || '')
          .replace(/&/g, '&amp;')
          .replace(/</g, '&lt;')
          .replace(/>/g, '&gt;')
          .replace(/"/g, '&quot;')
          .replace(/'/g, '&#39;');
      }

      function toDisplayQuestionType(type) {
        var normalized = String(type || '').toLowerCase();
        if (normalized === 'multiple_choice') return 'Multiple Choice';
        if (normalized === 'single_choice') return 'One Choice';
        if (normalized === 'true_false') return 'True / False';
        if (normalized === 'essay') return 'Essay';
        return 'Short Text';
      }

      function getSelectedOptionLabel(selectElement) {
        if (!selectElement || !selectElement.options || selectElement.selectedIndex < 0) return '';
        return String(selectElement.options[selectElement.selectedIndex].textContent || '').trim();
      }

      function buildPreviewPayload() {
        var questions = collectQuestionItems();
        var contextBits = [];

        var setTitle = questionSetTitleInput ? String(questionSetTitleInput.value || '').trim() : '';
        var assessmentLabel = getSelectedOptionLabel(questionAssessmentSelect);
        var classLabel = getSelectedOptionLabel(questionClassSelect);
        var subjectLabel = getSelectedOptionLabel(questionSubjectSelect);
        var termLabel = getSelectedOptionLabel(questionTermSelect);
        var schoolYearLabel = getSelectedOptionLabel(questionSchoolYearSelect);

        if (setTitle) {
          contextBits.push('<strong>Title:</strong> ' + escapeHtml(setTitle));
        }
        if (assessmentLabel) {
          contextBits.push('<strong>Assessment:</strong> ' + escapeHtml(assessmentLabel));
        }

        var cardsMarkup = '';
        if (!questions.length) {
          cardsMarkup = '<div class="qm-preview-card"><div class="qm-preview-answer">No questions to preview yet. Add and fill at least one question.</div></div>';
        } else {
          cardsMarkup = questions.map(function (question, index) {
            var questionHtml = String(question.questionText || '').trim();
            var hasHtml = /<\/?[a-z][\s\S]*>/i.test(questionHtml);
            var safeQuestionHtml = hasHtml ? questionHtml : escapeHtml(questionHtml).replace(/\n/g, '<br/>');

            var optionsMarkup = '';
            var optionMarker = question.questionType === 'multiple_choice' ? '☐' : '◯';
            if (Array.isArray(question.options) && question.options.length) {
              optionsMarkup = '<ul class="qm-preview-options">' + question.options.map(function (opt) {
                return '<li>' + optionMarker + ' ' + escapeHtml(opt) + '</li>';
              }).join('') + '</ul>';
            }

            var answerValues = parseAnswerValues(question.answerKey);
            var answersMarkup = answerValues.length
              ? '<div class="qm-preview-answer"><strong>Answer:</strong> ' + answerValues.map(escapeHtml).join(', ') + '</div>'
              : '';

            return (
              '<div class="qm-preview-card">' +
                '<div class="qm-preview-qmeta">' +
                  '<span>Q' + String(index + 1) + ' • ' + toDisplayQuestionType(question.questionType) + '</span>' +
                  '<span>' + String(question.marks || 1) + ' mark' + (Number(question.marks || 1) === 1 ? '' : 's') + '</span>' +
                '</div>' +
                '<div class="qm-preview-qtext">' + safeQuestionHtml + '</div>' +
                optionsMarkup +
                answersMarkup +
              '</div>'
            );
          }).join('');
        }

        return {
          questions: questions,
          contextBits: contextBits,
          cardsMarkup: cardsMarkup,
          meta: {
            title: setTitle,
            assessment: assessmentLabel,
            className: classLabel,
            subject: subjectLabel,
            term: termLabel,
            schoolYear: schoolYearLabel,
          },
        };
      }

      function renderQuestionPreview() {
        if (!qmPreviewBody) return;
        var payload = buildPreviewPayload();
        var chunks = [];
        if (payload.contextBits.length) {
          chunks.push('<div class="qm-preview-context">' + payload.contextBits.join(' • ') + '</div>');
        }
        chunks.push(payload.cardsMarkup);
        qmPreviewBody.innerHTML = chunks.join('');
      }

      function printQuestionPreview() {
        var payload = buildPreviewPayload();
        var now = new Date();
        var printedAt = now.toLocaleString();

        var metaLine = [
          payload.meta.assessment ? ('Assessment: ' + payload.meta.assessment) : '',
          payload.meta.className ? ('Class: ' + payload.meta.className) : '',
          payload.meta.subject ? ('Subject: ' + payload.meta.subject) : '',
          payload.meta.term ? ('Term: ' + payload.meta.term) : '',
          payload.meta.schoolYear ? ('Year: ' + payload.meta.schoolYear) : '',
        ].filter(Boolean).join(' • ');

        var watermarkHtml = previewSchoolLogo
          ? '<img src="' + escapeHtml(previewSchoolLogo) + '" alt="" class="print-watermark-logo" />'
          : '';

        var printHtml = [
          '<!DOCTYPE html>',
          '<html><head><meta charset="UTF-8" /><title>Question Preview Print</title>',
          '<style>',
          'body{font-family:Arial,Helvetica,sans-serif;color:#0f172a;margin:0;background:#fff;}',
          '.print-shell{position:relative;max-width:980px;margin:0 auto;padding:22px 24px 28px;}',
          '.print-watermark-logo{position:fixed;left:50%;top:52%;transform:translate(-50%,-50%);width:360px;max-width:70vw;opacity:0.06;z-index:0;pointer-events:none;}',
          '.print-shell > *{position:relative;z-index:1;}',
          '.print-header{display:flex;align-items:flex-start;justify-content:space-between;gap:14px;border-bottom:2px solid #0f5a66;padding-bottom:10px;margin-bottom:12px;}',
          '.print-header-left{display:flex;align-items:flex-start;gap:10px;}',
          '.print-header-logo{width:56px;height:56px;object-fit:contain;border-radius:6px;}',
          '.print-school{font-size:1.05rem;font-weight:800;color:#0f2d32;margin:0;}',
          '.print-title{font-size:0.88rem;font-weight:700;color:#334155;margin:3px 0 0;}',
          '.print-meta{font-size:0.74rem;color:#64748b;text-align:right;line-height:1.45;}',
          '.print-context{font-size:0.8rem;color:#334155;background:#f8fafc;border:1px solid #e2e8f0;border-radius:8px;padding:8px 10px;margin-bottom:10px;}',
          '.print-card{border:1px solid #dbe4ee;border-radius:10px;padding:10px 11px;margin-bottom:9px;break-inside:avoid;page-break-inside:avoid;}',
          '.print-qmeta{display:flex;align-items:center;justify-content:space-between;gap:10px;font-size:0.76rem;font-weight:700;color:#475569;margin-bottom:6px;}',
          '.print-qtext{font-size:0.88rem;line-height:1.42;color:#0f172a;margin-bottom:7px;}',
          '.print-options{margin:0;padding:0;list-style:none;display:grid;gap:4px;font-size:0.82rem;color:#334155;}',
          '.print-answer{margin-top:6px;font-size:0.76rem;color:#475569;}',
          '@media print{body{margin:0;-webkit-print-color-adjust:exact;print-color-adjust:exact;} .print-shell{padding:12mm;} .print-watermark-logo{display:block;}}',
          '</style></head><body>',
          watermarkHtml,
          '<div class="print-shell">',
          '<div class="print-header">',
          '<div class="print-header-left">',
          (previewSchoolLogo ? ('<img src="' + escapeHtml(previewSchoolLogo) + '" alt="School Logo" class="print-header-logo" />') : ''),
          '<div><p class="print-school">' + escapeHtml(previewSchoolName || 'School') + '</p><p class="print-title">Assessment Question Preview</p></div>',
          '</div>',
          '<div class="print-meta"><div>Printed: ' + escapeHtml(printedAt) + '</div>' +
          (payload.questions.length ? ('<div>Total Questions: ' + String(payload.questions.length) + '</div>') : '') +
          '</div>',
          '</div>',
          (metaLine ? ('<div class="print-context">' + escapeHtml(metaLine) + '</div>') : ''),
          payload.cardsMarkup
            .replace(/qm-preview-card/g, 'print-card')
            .replace(/qm-preview-qmeta/g, 'print-qmeta')
            .replace(/qm-preview-qtext/g, 'print-qtext')
            .replace(/qm-preview-options/g, 'print-options')
            .replace(/qm-preview-answer/g, 'print-answer'),
          '</div></body></html>'
        ].join('');

        var printWindow = null;
        try {
          // Keep popup features minimal for better compatibility with browser popup policies.
          printWindow = window.open('', '_blank');
        } catch (_) {
          printWindow = null;
        }

        if (printWindow && printWindow.document) {
          printWindow.document.open();
          printWindow.document.write(printHtml);
          printWindow.document.close();
          printWindow.focus();
          setTimeout(function () {
            try {
              printWindow.print();
            } catch (_) {
            }
          }, 250);
          return;
        }

        // Fallback for blocked popups: print from a hidden same-page iframe.
        var fallbackFrame = document.getElementById('qm-print-fallback-frame');
        if (!fallbackFrame) {
          fallbackFrame = document.createElement('iframe');
          fallbackFrame.id = 'qm-print-fallback-frame';
          fallbackFrame.setAttribute('aria-hidden', 'true');
          fallbackFrame.style.position = 'fixed';
          fallbackFrame.style.right = '0';
          fallbackFrame.style.bottom = '0';
          fallbackFrame.style.width = '0';
          fallbackFrame.style.height = '0';
          fallbackFrame.style.border = '0';
          fallbackFrame.style.opacity = '0';
          fallbackFrame.style.pointerEvents = 'none';
          document.body.appendChild(fallbackFrame);
        }

        try {
          var frameDoc = fallbackFrame.contentWindow && fallbackFrame.contentWindow.document
            ? fallbackFrame.contentWindow.document
            : null;
          if (!frameDoc) {
            throw new Error('Print frame unavailable');
          }
          frameDoc.open();
          frameDoc.write(printHtml);
          frameDoc.close();
          setTimeout(function () {
            try {
              fallbackFrame.contentWindow.focus();
              fallbackFrame.contentWindow.print();
            } catch (_) {
            }
          }, 250);
          setQuestionStatus('', false);
        } catch (_) {
          setQuestionStatus('Printing failed on this browser. Try allowing pop-ups and print again.', true);
        }
      }

      function openQuestionPreview() {
        if (!qmPreviewOverlay) return;
        renderQuestionPreview();
        qmPreviewOverlay.classList.add('show');
        qmPreviewOverlay.setAttribute('aria-hidden', 'false');
      }

      function closeQuestionPreview() {
        if (!qmPreviewOverlay) return;
        qmPreviewOverlay.classList.remove('show');
        qmPreviewOverlay.setAttribute('aria-hidden', 'true');
      }

      function updateQuestionCount() {
        var count = document.querySelectorAll('#question-items .qm-question-card').length;
        var counter = document.getElementById('qm-question-count');
        if (counter) {
          counter.textContent = count + ' question' + (count === 1 ? '' : 's');
        }
      }

      function renumberQuestionCards() {
        document.querySelectorAll('#question-items .qm-question-card').forEach(function (card, index) {
          var qNumber = card.querySelector('.qm-q-number');
          if (qNumber) qNumber.textContent = String(index + 1);
        });
      }

      function saveDraft() {
        var questions = [];
        document.querySelectorAll('#question-items .qm-question-card').forEach(function (card) {
          var optionValues = Array.prototype.slice.call(card.querySelectorAll('.question-option-input'))
            .map(function (input) { return String(input.value || '').trim(); })
            .filter(Boolean);
          var answerValues = Array.prototype.slice.call(card.querySelectorAll('.question-answer-input'))
            .map(function (input) { return String(input.value || '').trim(); })
            .filter(Boolean);
          questions.push({
            type: card.querySelector('.question-type') ? card.querySelector('.question-type').value : '',
            marks: card.querySelector('.question-marks') ? card.querySelector('.question-marks').value : 1,
            text: card.querySelector('.question-text') ? card.querySelector('.question-text').value : '',
            options: optionValues,
            answers: answerValues,
          });
        });

        var draft = {
          schoolYearId: questionSchoolYearSelect ? questionSchoolYearSelect.value : '',
          termId: questionTermSelect ? questionTermSelect.value : '',
          classId: questionClassSelect ? questionClassSelect.value : '',
          subjectId: questionSubjectSelect ? questionSubjectSelect.value : '',
          assessmentId: questionAssessmentSelect ? questionAssessmentSelect.value : '',
          setTitle: questionSetTitleInput ? questionSetTitleInput.value : '',
          description: questionSetDescriptionInput ? questionSetDescriptionInput.value : '',
          questions: questions,
          savedAt: Date.now(),
        };

        try { localStorage.setItem(DRAFT_KEY, JSON.stringify(draft)); } catch (_) {}
      }

      function loadDraft() {
        try {
          var raw = localStorage.getItem(DRAFT_KEY);
          return raw ? JSON.parse(raw) : null;
        } catch (_) {
          return null;
        }
      }

      function clearDraft() {
        try { localStorage.removeItem(DRAFT_KEY); } catch (_) {}
        if (qmDraftBanner) qmDraftBanner.style.display = 'none';
      }

      function restoreDraft(draft) {
        if (!draft) return;

        if (questionSchoolYearSelect && draft.schoolYearId) questionSchoolYearSelect.value = draft.schoolYearId;
        if (questionTermSelect && draft.termId) questionTermSelect.value = draft.termId;
        if (questionClassSelect && draft.classId) questionClassSelect.value = draft.classId;
        if (questionSubjectSelect && draft.subjectId) questionSubjectSelect.value = draft.subjectId;
        if (questionAssessmentSelect && draft.assessmentId) questionAssessmentSelect.value = draft.assessmentId;
        if (questionSetTitleInput && draft.setTitle) questionSetTitleInput.value = draft.setTitle;
        if (questionSetDescriptionInput && draft.description) questionSetDescriptionInput.value = draft.description;

        if (questionItems && Array.isArray(draft.questions) && draft.questions.length) {
          questionItems.innerHTML = '';
          draft.questions.forEach(function (q) {
            var restoredOptions = [];
            if (Array.isArray(q.options)) {
              restoredOptions = q.options;
            } else if (typeof q.options === 'string' && q.options.trim()) {
              restoredOptions = q.options.split(',').map(function (s) { return s.trim(); }).filter(Boolean);
            }
            var card = buildQuestionItem({
              questionType: q.type,
              marks: q.marks,
              questionText: q.text,
              options: restoredOptions,
              answerKeys: Array.isArray(q.answers)
                ? q.answers
                : (q.answer ? [q.answer] : []),
            });
            questionItems.appendChild(card);
          });
        }

        if (qmDraftBanner) qmDraftBanner.style.display = 'flex';
        renumberQuestionCards();
        updateQuestionCount();
      }

      function renderQuestionModalSchoolYears() {
        if (!questionSchoolYearSelect) return;
        questionSchoolYearSelect.innerHTML = '';

        schoolYears.forEach(function (year) {
          var opt = document.createElement('option');
          opt.value = String(year.schoolYearId);
          opt.textContent = year.yearLabel;
          questionSchoolYearSelect.appendChild(opt);
        });

        if (!schoolYears.length) return;
        var fallbackSchoolYearId = Number(schoolYearSelect ? schoolYearSelect.value : selectedSchoolYearId);
        var exists = schoolYears.some(function (year) {
          return Number(year.schoolYearId) === Number(fallbackSchoolYearId);
        });
        questionSchoolYearSelect.value = String(exists ? fallbackSchoolYearId : Number(schoolYears[0].schoolYearId));
      }

      function renderQuestionModalTerms() {
        if (!questionTermSelect || !questionSchoolYearSelect) return;
        questionTermSelect.innerHTML = '';

        var schoolYearId = Number(questionSchoolYearSelect.value || 0);
        var schoolYear = schoolYears.find(function (year) {
          return Number(year.schoolYearId) === schoolYearId;
        });
        var terms = schoolYear && Array.isArray(schoolYear.terms) ? schoolYear.terms : [];

        terms.forEach(function (term) {
          var opt = document.createElement('option');
          opt.value = String(term.termId);
          opt.textContent = term.termName;
          questionTermSelect.appendChild(opt);
        });

        if (!terms.length) return;
        var preferredTermId = Number(termSelect ? termSelect.value : selectedTermId);
        var hasPreferredTerm = terms.some(function (term) {
          return Number(term.termId) === Number(preferredTermId);
        });
        questionTermSelect.value = String(hasPreferredTerm ? preferredTermId : Number(terms[0].termId));
      }

      function renderQuestionModalClasses() {
        if (!questionClassSelect || !questionTermSelect) return;
        questionClassSelect.innerHTML = '';

        var selectedQuestionTermId = Number(questionTermSelect.value || 0);
        var classMap = new Map();
        termClassSubjects.forEach(function (row) {
          if (Number(row.term_id || 0) !== selectedQuestionTermId) return;
          var classId = Number(row.class_id || 0);
          if (classId <= 0 || classMap.has(classId)) return;
          classMap.set(classId, {
            class_id: classId,
            class_name: row.class_name || ('Class ' + classId),
          });
        });

        Array.from(classMap.values())
          .sort(function (left, right) {
            return String(left.class_name).localeCompare(String(right.class_name));
          })
          .forEach(function (row) {
            var opt = document.createElement('option');
            opt.value = String(row.class_id);
            opt.textContent = row.class_name;
            questionClassSelect.appendChild(opt);
          });
      }

      function renderQuestionModalSubjects() {
        if (!questionSubjectSelect || !questionTermSelect || !questionClassSelect) return;
        questionSubjectSelect.innerHTML = '';

        var selectedQuestionTermId = Number(questionTermSelect.value || 0);
        var selectedQuestionClassId = Number(questionClassSelect.value || 0);
        var subjectMap = new Map();

        termClassSubjects.forEach(function (row) {
          if (Number(row.term_id || 0) !== selectedQuestionTermId) return;
          if (Number(row.class_id || 0) !== selectedQuestionClassId) return;
          var subjectId = Number(row.subject_id || 0);
          if (subjectId <= 0 || subjectMap.has(subjectId)) return;
          subjectMap.set(subjectId, {
            subject_id: subjectId,
            subject_name: row.subject_name || ('Subject ' + subjectId),
          });
        });

        Array.from(subjectMap.values())
          .sort(function (left, right) {
            return String(left.subject_name).localeCompare(String(right.subject_name));
          })
          .forEach(function (row) {
            var opt = document.createElement('option');
            opt.value = String(row.subject_id);
            opt.textContent = row.subject_name;
            questionSubjectSelect.appendChild(opt);
          });
      }

      async function renderQuestionModalAssessments() {
        if (!questionAssessmentSelect || !questionTermSelect || !questionSchoolYearSelect) return;
        questionAssessmentSelect.innerHTML = '';

        var selectedQuestionTermId = Number(questionTermSelect.value || 0);
        var selectedQuestionSchoolYearId = Number(questionSchoolYearSelect.value || 0);
        var selectedQuestionClassId = Number(questionClassSelect && questionClassSelect.value ? questionClassSelect.value : 0);
        var selectedQuestionSubjectId = Number(questionSubjectSelect && questionSubjectSelect.value ? questionSubjectSelect.value : 0);

        if (!selectedQuestionTermId || !selectedQuestionSchoolYearId) {
          return;
        }

        var requestUrl = '/common/assessment/options?schoolYearId=' + encodeURIComponent(String(selectedQuestionSchoolYearId)) +
          '&termId=' + encodeURIComponent(String(selectedQuestionTermId));

        if (selectedQuestionClassId > 0) {
          requestUrl += '&classId=' + encodeURIComponent(String(selectedQuestionClassId));
        }

        if (selectedQuestionSubjectId > 0) {
          requestUrl += '&subjectId=' + encodeURIComponent(String(selectedQuestionSubjectId));
        }

        var response;
        var payload;
        try {
          response = await fetch(requestUrl, { headers: { Accept: 'application/json' } });
          payload = await response.json();
        } catch (_error) {
          setQuestionStatus('Failed to load assessments for selected scope.', true);
          return;
        }

        if (!response.ok || !payload.success) {
          setQuestionStatus((payload && payload.error) || 'Failed to load assessments for selected scope.', true);
          return;
        }

        var filtered = Array.isArray(payload.assessments) ? payload.assessments : [];

        var seenAssessmentIds = new Set();
        filtered.forEach(function (assessment) {
          var assessmentId = Number(assessment.assessment_id || 0);
          if (!assessmentId || seenAssessmentIds.has(assessmentId)) {
            return;
          }
          seenAssessmentIds.add(assessmentId);

          assessmentRuleMap.set(assessmentId, {
            assessmentId: assessmentId,
            termId: Number(assessment.term_id),
            schoolYearId: Number(assessment.school_year_id),
            classId: Number(assessment.class_id),
            subjectId: Number(assessment.subject_id),
            title: assessment.title,
            weight: Number(assessment.weight || 0),
            maxScore: Number(assessment.max_score || 0),
            category: assessment.category || 'Assessment',
            scaleBase: Number(assessment.scale_base || 100),
            openBook: Boolean(assessment.open_book),
            timeLimitMinutes: assessment.time_limit_minutes !== null && assessment.time_limit_minutes !== undefined
              ? Number(assessment.time_limit_minutes)
              : null,
            canEditScores: Boolean(assessment.can_edit_scores),
            accessReason: assessment.access_reason || '',
          });

          var opt = document.createElement('option');
          opt.value = String(assessmentId);
          opt.textContent = String(assessment.title || 'Assessment') + ' - ' + String(assessment.class_name || 'Class') + ' - ' + String(assessment.subject_name || 'Subject');
          questionAssessmentSelect.appendChild(opt);
        });

        if (!questionAssessmentSelect.options.length) {
          setQuestionStatus('No assessments found for the selected school year and term.', true);
        } else {
          setQuestionStatus('Select an assessment to continue.', false);
        }
      }

      function resolveSelectedAssessmentRule() {
        var assessmentId = Number(questionAssessmentSelect ? questionAssessmentSelect.value : 0);
        return assessmentRuleMap.get(assessmentId) || null;
      }

      function applyAssessmentMarksLimit(maxScore) {
        var numericMax = Number(maxScore || 0);
        var normalizedMax = Number.isFinite(numericMax) && numericMax > 0 ? numericMax : null;
        document.querySelectorAll('#question-items .qm-question-card .question-marks').forEach(function (input) {
          if (normalizedMax) {
            input.setAttribute('max', String(normalizedMax));
          } else {
            input.removeAttribute('max');
          }
        });
      }

      function renderAssessmentRulesSummary() {
        selectedAssessmentRule = resolveSelectedAssessmentRule();
        if (!questionAssessmentRules) return;

        if (!selectedAssessmentRule) {
          questionAssessmentRules.style.display = 'none';
          questionAssessmentRules.textContent = 'Assessment rules unavailable for this selection.';
          if (questionOpenBookSelect) questionOpenBookSelect.value = 'false';
          if (questionTimeLimitInput) questionTimeLimitInput.value = '';
          return;
        }

        questionAssessmentRules.style.display = 'block';

        if (questionOpenBookSelect) {
          questionOpenBookSelect.value = selectedAssessmentRule.openBook ? 'true' : 'false';
        }
        if (questionTimeLimitInput) {
          questionTimeLimitInput.value = selectedAssessmentRule.timeLimitMinutes && Number(selectedAssessmentRule.timeLimitMinutes) > 0
            ? String(Number(selectedAssessmentRule.timeLimitMinutes))
            : '';
        }

        var statusLabel = selectedAssessmentRule.canEditScores
          ? 'Editable'
          : 'Locked for editing (' + (selectedAssessmentRule.accessReason || 'Not editable') + ')';

        questionAssessmentRules.textContent = 'Rules: ' + selectedAssessmentRule.title +
          ' | Category: ' + selectedAssessmentRule.category +
          ' | Weight: ' + selectedAssessmentRule.weight + '%' +
          ' | Max score: ' + selectedAssessmentRule.maxScore +
          ' | Scale: ' + selectedAssessmentRule.scaleBase +
          ' | Mode: ' + (selectedAssessmentRule.openBook ? 'Open Book' : 'Secure') +
          ' | Time: ' + (selectedAssessmentRule.timeLimitMinutes && Number(selectedAssessmentRule.timeLimitMinutes) > 0 ? (String(selectedAssessmentRule.timeLimitMinutes) + ' min') : 'Untimed') +
          ' | Status: ' + statusLabel;

        applyAssessmentMarksLimit(selectedAssessmentRule.maxScore);
      }

      function setQuestionEditorEnabled(isEnabled) {
        if (addQuestionItemButton) {
          addQuestionItemButton.disabled = !isEnabled;
        }
        if (saveQuestionSetButton) {
          saveQuestionSetButton.disabled = !isEnabled;
        }
      }

      function openQuestionModal() {
        if (!questionModalOverlay) return;
        questionModalOverlay.classList.add('show');
        questionModalOverlay.setAttribute('aria-hidden', 'false');
      }

      function setQuestionModalMode(mode) {
        questionModalMode = mode === 'edit' ? 'edit' : 'create';
        var modalTitle = document.getElementById('question-modal-title');
        if (modalTitle) {
          modalTitle.textContent = questionModalMode === 'edit' ? 'Review and Edit Questions' : 'Create Questions';
        }
        if (saveQuestionSetButton) {
          saveQuestionSetButton.textContent = questionModalMode === 'edit' ? 'Save Changes for Review' : 'Save Question Set';
        }
      }

      function closeQuestionModal() {
        if (!questionModalOverlay) return;
        questionModalOverlay.classList.remove('show');
        questionModalOverlay.setAttribute('aria-hidden', 'true');
      }

      function appendOptionInput(optionList, optionValue) {
        if (!optionList) return;
        var row = document.createElement('div');
        row.className = 'question-option-row';

        var input = document.createElement('input');
        input.type = 'text';
        input.className = 'question-option-input';
        input.placeholder = 'Option text';
        input.value = optionValue || '';

        var removeBtn = document.createElement('button');
        removeBtn.type = 'button';
        removeBtn.className = 'question-option-remove';
        removeBtn.title = 'Remove option';
        removeBtn.textContent = '−';

        removeBtn.addEventListener('click', function () {
          row.remove();
          if (!optionList.querySelector('.question-option-row')) {
            appendOptionInput(optionList, '');
          }
          saveDraft();
        });

        row.appendChild(input);
        row.appendChild(removeBtn);
        optionList.appendChild(row);
        return row;
      }

      function parseAnswerValues(raw) {
        if (Array.isArray(raw)) {
          return raw.map(function (item) { return String(item || '').trim(); }).filter(Boolean);
        }
        var normalized = String(raw || '').trim();
        if (!normalized) return [];

        if ((normalized.startsWith('[') && normalized.endsWith(']')) || (normalized.startsWith('{') && normalized.endsWith('}'))) {
          try {
            var parsed = JSON.parse(normalized);
            if (Array.isArray(parsed)) {
              return parsed.map(function (item) { return String(item || '').trim(); }).filter(Boolean);
            }
          } catch (_) {
          }
        }

        if (normalized.indexOf('||') !== -1) {
          return normalized.split('||').map(function (part) { return String(part || '').trim(); }).filter(Boolean);
        }

        return [normalized];
      }

      function serializeAnswerValues(values) {
        var cleaned = Array.isArray(values)
          ? values.map(function (item) { return String(item || '').trim(); }).filter(Boolean)
          : [];
        if (!cleaned.length) return '';
        if (cleaned.length === 1) return cleaned[0];
        return JSON.stringify(cleaned);
      }

      function appendAnswerInput(answerList, answerValue) {
        if (!answerList) return;
        var row = document.createElement('div');
        row.className = 'question-answer-row';

        var input = document.createElement('input');
        input.type = 'text';
        input.className = 'question-answer-input';
        input.placeholder = 'Correct answer';
        input.value = answerValue || '';

        var removeBtn = document.createElement('button');
        removeBtn.type = 'button';
        removeBtn.className = 'question-option-remove';
        removeBtn.title = 'Remove answer';
        removeBtn.textContent = '−';

        removeBtn.addEventListener('click', function () {
          row.remove();
          if (!answerList.querySelector('.question-answer-row')) {
            appendAnswerInput(answerList, '');
          }
          saveDraft();
        });

        row.appendChild(input);
        row.appendChild(removeBtn);
        answerList.appendChild(row);
        return row;
      }

      function setOptionRows(optionList, values, isReadOnly) {
        if (!optionList) return;
        optionList.innerHTML = '';
        var normalizedValues = Array.isArray(values) ? values : [];

        if (!normalizedValues.length) {
          normalizedValues = [''];
        }

        normalizedValues.forEach(function (value) {
          var row = appendOptionInput(optionList, value);
          if (!row) return;
          var input = row.querySelector('.question-option-input');
          var removeBtn = row.querySelector('.question-option-remove');
          if (input) input.readOnly = Boolean(isReadOnly);
          if (removeBtn) removeBtn.style.display = isReadOnly ? 'none' : 'inline-flex';
        });
      }

      function setAnswerRows(answerList, values, allowMultiple, placeholderText) {
        if (!answerList) return;
        answerList.innerHTML = '';

        var normalizedValues = Array.isArray(values)
          ? values.map(function (value) { return String(value || '').trim(); }).filter(Boolean)
          : [];

        if (!normalizedValues.length) {
          normalizedValues = [''];
        }

        if (!allowMultiple) {
          normalizedValues = [normalizedValues[0] || ''];
        }

        normalizedValues.forEach(function (value) {
          var row = appendAnswerInput(answerList, value);
          if (!row) return;
          var input = row.querySelector('.question-answer-input');
          var removeBtn = row.querySelector('.question-option-remove');
          if (input && placeholderText) input.placeholder = placeholderText;
          if (removeBtn) removeBtn.style.display = allowMultiple ? 'inline-flex' : 'none';
        });
      }

      function applyQuestionTypeBehavior(wrapper) {
        if (!wrapper) return;

        var typeSelect = wrapper.querySelector('.question-type');
        var optionsField = wrapper.querySelector('.qm-options-field');
        var optionsList = wrapper.querySelector('.question-options-list');
        var addOptionButton = wrapper.querySelector('.qm-option-add-btn');
        var answerLabel = wrapper.querySelector('.question-answer-label');
        var answerList = wrapper.querySelector('.question-answer-list');
        var addAnswerButton = wrapper.querySelector('.qm-answer-add-btn');
        if (!typeSelect) return;

        var type = String(typeSelect.value || 'short_text');
        var currentOptions = Array.prototype.slice.call(wrapper.querySelectorAll('.question-option-input'))
          .map(function (input) { return String(input.value || '').trim(); })
          .filter(Boolean);
        var currentAnswers = Array.prototype.slice.call(wrapper.querySelectorAll('.question-answer-input'))
          .map(function (input) { return String(input.value || '').trim(); })
          .filter(Boolean);

        if (type === 'multiple_choice') {
          if (optionsField) optionsField.classList.remove('is-hidden');
          if (addOptionButton) addOptionButton.style.display = 'inline-flex';
          if (answerLabel) answerLabel.textContent = 'Answer Key';
          if (addAnswerButton) addAnswerButton.style.display = 'inline-flex';

          setOptionRows(optionsList, currentOptions, false);
          setAnswerRows(answerList, currentAnswers, true, 'Correct answer');
          return;
        }

        if (type === 'single_choice') {
          if (optionsField) optionsField.classList.remove('is-hidden');
          if (addOptionButton) addOptionButton.style.display = 'inline-flex';
          if (answerLabel) answerLabel.textContent = 'Correct Answer';
          if (addAnswerButton) addAnswerButton.style.display = 'none';

          setOptionRows(optionsList, currentOptions, false);
          setAnswerRows(answerList, currentAnswers, false, 'Only one correct answer');
          return;
        }

        if (type === 'true_false') {
          if (optionsField) optionsField.classList.remove('is-hidden');
          if (addOptionButton) addOptionButton.style.display = 'none';
          if (answerLabel) answerLabel.textContent = 'Correct Answer';
          if (addAnswerButton) addAnswerButton.style.display = 'none';

          setOptionRows(optionsList, ['True', 'False'], true);
          setAnswerRows(answerList, currentAnswers, false, 'True or False');
          return;
        }

        if (optionsField) optionsField.classList.add('is-hidden');
        if (addOptionButton) addOptionButton.style.display = 'none';
        if (answerLabel) {
          answerLabel.textContent = type === 'essay' ? 'Marking Guide' : 'Correct Answer';
        }
        if (addAnswerButton) addAnswerButton.style.display = 'none';
        setAnswerRows(answerList, currentAnswers, false, type === 'essay' ? 'Key points / rubric' : 'Expected short answer');
      }

      function setQuestionEditorContent(editor, value) {
        if (!editor) return;
        var raw = String(value || '');
        var hasHtmlTag = /<\/?[a-z][\s\S]*>/i.test(raw);
        if (hasHtmlTag) {
          editor.innerHTML = raw;
        } else {
          editor.textContent = raw;
        }
      }

      function syncQuestionEditorValue(editor, hiddenInput) {
        if (!editor || !hiddenInput) return;
        var html = String(editor.innerHTML || '').trim();
        if (html === '<br>' || html === '<div><br></div>') {
          html = '';
        }
        hiddenInput.value = html;
      }

      function applyEditorCommand(editor, command, value) {
        if (!editor) return;
        editor.focus();
        try {
          document.execCommand(command, false, value);
        } catch (_) {
        }
      }

      function buildQuestionItem(question) {
        var wrapper = document.createElement('div');
        wrapper.className = 'qm-question-card';
        wrapper.innerHTML = [
          '<div class="qm-question-card-header">',
          '  <div class="qm-question-badge">Q<span class="qm-q-number"></span></div>',
          '  <div class="qm-question-header-fields">',
          '    <div class="qm-field" style="flex:1;">',
          '      <label>Type</label>',
          '      <select class="question-type">',
          '      <option value="multiple_choice">Multiple Choice</option>',
          '      <option value="single_choice">One Choice</option>',
          '      <option value="true_false">True / False</option>',
          '      <option value="short_text">Short Text</option>',
          '      <option value="essay">Essay</option>',
          '      </select>',
          '    </div>',
          '    <div class="qm-field" style="width:110px;">',
          '      <label>Marks</label>',
          '      <input class="question-marks" type="number" min="1" step="0.5" value="1" />',
          '    </div>',
          '  </div>',
          '  <button type="button" class="qm-remove-btn question-remove" title="Remove question">',
          '    <svg width="16" height="16" viewBox="0 0 16 16" fill="none">',
          '      <path d="M2 4h12M5 4V2h6v2M6 7v5M10 7v5M3 4l1 9h8l1-9" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>',
          '    </svg>',
          '  </button>',
          '  </div>',
          '<div class="qm-question-card-body">',
          '  <div class="qm-field">',
          '    <div class="qm-question-text-head">',
          '      <label>Question Text</label>',
          '      <div class="qm-question-text-toolbar">',
          '        <button type="button" class="qm-text-tool-btn" data-format-cmd="bold" title="Bold">B</button>',
          '        <button type="button" class="qm-text-tool-btn" data-format-cmd="italic" title="Italic">I</button>',
          '        <label class="qm-text-color-wrap" title="Text Color">',
          '          <input type="color" class="qm-text-color" value="#0f172a" />',
          '        </label>',
          '      </div>',
          '    </div>',
          '    <div class="qm-question-text-editor-wrap">',
          '      <div class="question-text-editor" contenteditable="true" data-placeholder="Type the question here..."></div>',
          '    </div>',
          '    <textarea class="question-text" rows="2"></textarea>',
          '  </div>',
          '  <div class="qm-field qm-options-field">',
          '    <label>Options</label>',
          '    <div class="question-options-list"></div>',
          '    <button type="button" class="qm-option-add-btn" title="Add option">+</button>',
          '  </div>',
          '  <div class="qm-field">',
          '    <label class="question-answer-label">Answer Key</label>',
          '    <div class="question-answer-list"></div>',
          '    <button type="button" class="qm-answer-add-btn" title="Add correct answer">+</button>',
          '  </div>',
          '</div>'
        ].join('');

        var typeSelect = wrapper.querySelector('.question-type');
        var marksInput = wrapper.querySelector('.question-marks');
        var textInput = wrapper.querySelector('.question-text');
        var textEditor = wrapper.querySelector('.question-text-editor');
        var optionsList = wrapper.querySelector('.question-options-list');
        var addOptionButton = wrapper.querySelector('.qm-option-add-btn');
        var answerList = wrapper.querySelector('.question-answer-list');
        var addAnswerButton = wrapper.querySelector('.qm-answer-add-btn');
        var formatButtons = wrapper.querySelectorAll('.qm-text-tool-btn');
        var textColorPicker = wrapper.querySelector('.qm-text-color');

        var initialOptions = Array.isArray(question && question.options) ? question.options : [];
        if (!initialOptions.length) {
          appendOptionInput(optionsList, '');
        } else {
          initialOptions.forEach(function (optionValue) {
            appendOptionInput(optionsList, optionValue);
          });
        }

        if (addOptionButton) {
          addOptionButton.addEventListener('click', function () {
            appendOptionInput(optionsList, '');
            saveDraft();
          });
        }

        var initialAnswers = Array.isArray(question && question.answerKeys)
          ? question.answerKeys
          : parseAnswerValues(question ? question.answerKey : '');
        if (!initialAnswers.length) {
          appendAnswerInput(answerList, '');
        } else {
          initialAnswers.forEach(function (answerValue) {
            appendAnswerInput(answerList, answerValue);
          });
        }

        if (addAnswerButton) {
          addAnswerButton.addEventListener('click', function () {
            appendAnswerInput(answerList, '');
            saveDraft();
          });
        }

        if (question) {
          typeSelect.value = question.questionType || 'short_text';
          marksInput.value = Number(question.marks || 1);
          setQuestionEditorContent(textEditor, question.questionText || '');
          syncQuestionEditorValue(textEditor, textInput);
        }

        if (!question) {
          setQuestionEditorContent(textEditor, '');
          syncQuestionEditorValue(textEditor, textInput);
        }

        formatButtons.forEach(function (button) {
          button.addEventListener('click', function () {
            var command = button.getAttribute('data-format-cmd');
            if (!command) return;
            applyEditorCommand(textEditor, command);
            syncQuestionEditorValue(textEditor, textInput);
            saveDraft();
          });
        });

        if (textColorPicker) {
          textColorPicker.addEventListener('input', function () {
            applyEditorCommand(textEditor, 'foreColor', textColorPicker.value);
            syncQuestionEditorValue(textEditor, textInput);
            saveDraft();
          });
        }

        if (textEditor) {
          textEditor.addEventListener('input', function () {
            syncQuestionEditorValue(textEditor, textInput);
          });
          textEditor.addEventListener('blur', function () {
            syncQuestionEditorValue(textEditor, textInput);
            saveDraft();
          });
        }

        typeSelect.addEventListener('change', function () {
          applyQuestionTypeBehavior(wrapper);
          saveDraft();
        });

        applyQuestionTypeBehavior(wrapper);

        wrapper.querySelector('.question-remove').addEventListener('click', function () {
          wrapper.remove();
          renumberQuestionCards();
          updateQuestionCount();
          saveDraft();
        });

        setTimeout(function () {
          renumberQuestionCards();
          updateQuestionCount();
        }, 0);

        return wrapper;
      }

      function collectQuestionItems() {
        var items = Array.prototype.slice.call(document.querySelectorAll('#question-items .qm-question-card'));
        return items.map(function (item, index) {
          var questionType = item.querySelector('.question-type') ? item.querySelector('.question-type').value : 'short_text';
          var options = Array.prototype.slice.call(item.querySelectorAll('.question-option-input'))
            .map(function (input) { return String(input.value || '').trim(); })
            .filter(Boolean);
          var answers = Array.prototype.slice.call(item.querySelectorAll('.question-answer-input'))
            .map(function (input) { return String(input.value || '').trim(); })
            .filter(Boolean);

          if (questionType === 'true_false') {
            options = ['True', 'False'];
            answers = answers.slice(0, 1);
          } else if (questionType === 'single_choice') {
            answers = answers.slice(0, 1);
          } else if (questionType !== 'multiple_choice') {
            options = [];
            answers = answers.slice(0, 1);
          }

          return {
            questionType: questionType,
            questionText: String(item.querySelector('.question-text') ? item.querySelector('.question-text').value : '').trim(),
            options: options,
            answerKey: serializeAnswerValues(answers),
            marks: Number(item.querySelector('.question-marks') ? item.querySelector('.question-marks').value : 1),
            positionIndex: index,
          };
        }).filter(function (item) { return item.questionText; });
      }

      async function loadQuestionSets() {
        var selectedRule = resolveSelectedAssessmentRule();
        if (!selectedRule) {
          return { sets: [], assessment: null };
        }
        var requestUrl = '/common/assessment/questions?classId=' + encodeURIComponent(String(selectedRule.classId)) +
          '&subjectId=' + encodeURIComponent(String(selectedRule.subjectId)) +
          '&termId=' + encodeURIComponent(String(selectedRule.termId)) +
          '&assessmentId=' + encodeURIComponent(String(selectedRule.assessmentId));

        var response = await fetch(requestUrl, { headers: { Accept: 'application/json' } });
        var payload = await response.json();
        if (!response.ok || !payload.success) {
          throw new Error(payload.error || 'Failed to load question sets.');
        }
        return {
          sets: Array.isArray(payload.sets) ? payload.sets : [],
          assessment: payload.assessment || null,
        };
      }

      async function hydrateQuestionModalFromServer() {
        if (!questionItems) return;
        var loaded = { sets: [], assessment: null };
        var sets = [];
        if (questionModalMode === 'edit') {
          setQuestionStatus('Loading question sets...', false);
          loaded = await loadQuestionSets();
          sets = loaded.sets || [];
        }
        if (loaded.assessment && Number(loaded.assessment.assessmentId || 0) > 0) {
          assessmentRuleMap.set(Number(loaded.assessment.assessmentId), loaded.assessment);
        }

        questionItems.innerHTML = '';
        renderAssessmentRulesSummary();

        if (!selectedAssessmentRule) {
          setQuestionEditorEnabled(false);
          setQuestionStatus('No assessments found for the selected school year and term.', true);
          updateQuestionCount();
          return;
        }

        if (questionModalMode !== 'edit') {
          currentQuestionSetId = null;
          setQuestionEditorEnabled(true);
          if (questionSetTitleInput) questionSetTitleInput.value = '';
          if (questionSetDescriptionInput) questionSetDescriptionInput.value = '';
          questionItems.appendChild(buildQuestionItem());
          setQuestionStatus('Create a new question set for this assessment.', false);
          renumberQuestionCards();
          updateQuestionCount();
          return;
        }

        if (!sets.length) {
          currentQuestionSetId = null;
          setQuestionEditorEnabled(questionModalMode !== 'edit');
          if (questionSetTitleInput) questionSetTitleInput.value = '';
          if (questionSetDescriptionInput) questionSetDescriptionInput.value = '';
          if (questionModalMode !== 'edit') {
            questionItems.appendChild(buildQuestionItem());
            setQuestionStatus('No question set found for this assessment. Create one now.', false);
          } else {
            setQuestionStatus('No question set found to edit for this assessment.', true);
          }
          renumberQuestionCards();
          updateQuestionCount();
          return;
        }

        var selectedSet = sets[0];
        currentQuestionSetId = selectedSet.questionSetId || null;
        if (questionSetTitleInput) questionSetTitleInput.value = selectedSet.setTitle || '';
        if (questionSetDescriptionInput) questionSetDescriptionInput.value = selectedSet.setDescription || '';

        (selectedSet.questions || []).forEach(function (question) {
          questionItems.appendChild(buildQuestionItem(question));
        });

        if (!selectedSet.questions || !selectedSet.questions.length) {
          questionItems.appendChild(buildQuestionItem());
        }

        renumberQuestionCards();
        updateQuestionCount();

        if (questionModalMode === 'edit') {
          setQuestionEditorEnabled(true);
          setQuestionStatus('Editing existing question set. Save changes to send for review.', false);
        } else {
          setQuestionEditorEnabled(false);
          setQuestionStatus('Questions already exist for this assessment (status: ' + String(selectedSet.reviewStatus || 'pending').toLowerCase() + '). Use Edit to improve it.', true);
        }
      }

      async function openEditQuestionSet(payload) {
        if (!payload || !Number(payload.questionSetId)) return;

        setQuestionModalMode('edit');
        currentQuestionSetId = Number(payload.questionSetId);
        openQuestionModal();

        renderQuestionModalSchoolYears();
        if (questionSchoolYearSelect && Number(payload.schoolYearId) > 0) {
          questionSchoolYearSelect.value = String(Number(payload.schoolYearId));
        }

        renderQuestionModalTerms();
        if (questionTermSelect && Number(payload.termId) > 0) {
          questionTermSelect.value = String(Number(payload.termId));
        }

        renderQuestionModalClasses();
        if (questionClassSelect && Number(payload.classId) > 0) {
          questionClassSelect.value = String(Number(payload.classId));
        }

        renderQuestionModalSubjects();
        if (questionSubjectSelect && Number(payload.subjectId) > 0) {
          questionSubjectSelect.value = String(Number(payload.subjectId));
        }

        await renderQuestionModalAssessments();
        if (questionAssessmentSelect && Number(payload.assessmentId) > 0) {
          questionAssessmentSelect.value = String(Number(payload.assessmentId));
        }

        renderAssessmentRulesSummary();
        await hydrateQuestionModalFromServer();
      }

      function renderSchoolYears() {
        if (!schoolYearSelect) return;
        schoolYearSelect.innerHTML = '';

        schoolYears.forEach(function (year) {
          var opt = document.createElement('option');
          opt.value = String(year.schoolYearId);
          opt.textContent = year.yearLabel;
          schoolYearSelect.appendChild(opt);
        });

        if (!schoolYears.length) return;

        var exists = schoolYears.some(function (year) {
          return Number(year.schoolYearId) === Number(selectedSchoolYearId);
        });
        var fallbackId = Number(schoolYears[0].schoolYearId || 0);
        schoolYearSelect.value = String(exists ? selectedSchoolYearId : fallbackId);
      }

      function renderTerms() {
        if (!termSelect || !schoolYearSelect) return;
        termSelect.innerHTML = '';

        var schoolYearId = Number(schoolYearSelect.value || 0);
        var schoolYear = schoolYears.find(function (year) {
          return Number(year.schoolYearId) === schoolYearId;
        });
        var terms = schoolYear && Array.isArray(schoolYear.terms) ? schoolYear.terms : [];

        terms.forEach(function (term) {
          var opt = document.createElement('option');
          opt.value = String(term.termId);
          opt.textContent = term.termName;
          termSelect.appendChild(opt);
        });

        if (!terms.length) return;

        var hasSelectedTerm = terms.some(function (term) {
          return Number(term.termId) === Number(selectedTermId);
        });
        termSelect.value = String(hasSelectedTerm ? selectedTermId : Number(terms[0].termId));
      }

      function renderReuseSchoolYears() {
        if (!reuseSchoolYearSelect) return;
        reuseSchoolYearSelect.innerHTML = '';

        schoolYears.forEach(function (year) {
          var opt = document.createElement('option');
          opt.value = String(year.schoolYearId);
          opt.textContent = year.yearLabel;
          reuseSchoolYearSelect.appendChild(opt);
        });

        if (!schoolYears.length) return;
        var exists = schoolYears.some(function (year) {
          return Number(year.schoolYearId) === Number(selectedSchoolYearId);
        });
        reuseSchoolYearSelect.value = String(exists ? selectedSchoolYearId : Number(schoolYears[0].schoolYearId));
      }

      function renderReuseTerms() {
        if (!reuseTermSelect || !reuseSchoolYearSelect) return;
        reuseTermSelect.innerHTML = '';

        var schoolYearId = Number(reuseSchoolYearSelect.value || 0);
        var schoolYear = schoolYears.find(function (year) {
          return Number(year.schoolYearId) === schoolYearId;
        });
        var terms = schoolYear && Array.isArray(schoolYear.terms) ? schoolYear.terms : [];

        terms.forEach(function (term) {
          var opt = document.createElement('option');
          opt.value = String(term.termId);
          opt.textContent = term.termName;
          reuseTermSelect.appendChild(opt);
        });

        if (!terms.length) return;
        var hasCurrent = terms.some(function (term) { return Number(term.termId) === Number(selectedTermId); });
        reuseTermSelect.value = String(hasCurrent ? selectedTermId : Number(terms[0].termId));
      }

      function getTermClasses(termId) {
        var classMap = new Map();
        termClassSubjects.forEach(function (row) {
          if (Number(row.term_id) !== Number(termId)) return;
          var key = Number(row.class_id);
          if (!classMap.has(key)) {
            classMap.set(key, { class_id: key, class_name: row.class_name || ('Class ' + key) });
          }
        });
        return Array.from(classMap.values()).sort(function (a, b) {
          return String(a.class_name).localeCompare(String(b.class_name));
        });
      }

      function getTermClassSubjects(termId, classId) {
        return termClassSubjects
          .filter(function (row) {
            return Number(row.term_id) === Number(termId) && Number(row.class_id) === Number(classId) && Number(row.subject_id || 0) > 0;
          })
          .map(function (row) {
            return { subject_id: Number(row.subject_id), subject_name: row.subject_name || ('Subject ' + row.subject_id) };
          })
          .sort(function (a, b) {
            return String(a.subject_name).localeCompare(String(b.subject_name));
          });
      }

      function renderReuseClasses() {
        if (!reuseClassSelect || !reuseTermSelect) return;
        reuseClassSelect.innerHTML = '';
        var termId = Number(reuseTermSelect.value || 0);
        var termClasses = getTermClasses(termId);

        termClasses.forEach(function (row) {
          var opt = document.createElement('option');
          opt.value = String(row.class_id);
          opt.textContent = row.class_name;
          reuseClassSelect.appendChild(opt);
        });
      }

      function renderReuseSubjects() {
