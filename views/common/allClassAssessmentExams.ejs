            currentQuestionSetId = result.questionSetId || currentQuestionSetId;
            setQuestionStatus(questionModalMode === 'edit' ? 'Question set updated and submitted for review successfully.' : 'Question set submitted for review successfully.', false);
            clearDraft();
            window.location.reload();
          } catch (error) {
            setQuestionStatus(error.message || 'Failed to save question set.', true);
            renderSaveButtonIdle();
          }
        });
