      if (reuseConfirmButton) {
        reuseConfirmButton.addEventListener('click', async function () {
          var targetTermId = Number(reuseTermSelect ? reuseTermSelect.value : 0);
          var targetClassId = Number(reuseClassSelect ? reuseClassSelect.value : 0);
          var targetSubjectId = Number(reuseSubjectSelect ? reuseSubjectSelect.value : 0);
          var assessmentTitle = String(reuseAssessmentTitleInput ? reuseAssessmentTitleInput.value : '').trim();
          var shuffleMode = String(reuseShuffleModeSelect ? reuseShuffleModeSelect.value : 'none');
          var shouldShuffleOptions = Boolean(reuseShuffleOptionsInput && reuseShuffleOptionsInput.checked);

          if (!activeSourceQuestionSetId) {
            setReuseStatus('Select a source question set first.', true);
            return;
          }
          if (!targetTermId || !targetClassId || !targetSubjectId) {
            setReuseStatus('Select school year, term, class, and subject.', true);
            return;
          }
          if (!assessmentTitle) {
            setReuseStatus('Enter an assessment title for the reused set.', true);
            return;
          }

          reuseConfirmButton.disabled = true;
          var originalLabel = reuseConfirmButton.textContent;
          reuseConfirmButton.textContent = 'Reusing...';
          setReuseStatus('Reusing question set...', false);

          try {
            var response = await fetch('/common/assessment/questions/reuse', {
              method: 'POST',
              headers: {
                'Content-Type': 'application/json',
                Accept: 'application/json',
              },
              body: JSON.stringify({
                sourceQuestionSetId: activeSourceQuestionSetId,
                targetTermId: targetTermId,
                targetClassId: targetClassId,
                targetSubjectId: targetSubjectId,
                targetAssessmentTitle: assessmentTitle,
                shuffleMode: shuffleMode,
                shuffleOptions: shouldShuffleOptions ? 'true' : 'false',
              }),
            });

            var result = await response.json();
            if (!response.ok || !result.success) {
              throw new Error(result.error || 'Failed to reuse question set.');
            }

            setReuseStatus(result.message || 'Question set reused successfully.', false);
            var nextUrl = '/common/allClassAssessmentExams?organizationId=' + encodeURIComponent(String(organizationId)) + '&termId=' + encodeURIComponent(String(targetTermId));
            if (Number(targetClassId) > 0) {
              nextUrl += '&classId=' + encodeURIComponent(String(targetClassId));
            } else if (selectedClassId > 0) {
              nextUrl += '&classId=' + encodeURIComponent(String(selectedClassId));
            }
            if (isEmbedded) {
              nextUrl += '&embed=workspace';
            }
            window.location.href = nextUrl;
          } catch (error) {
            setReuseStatus(error.message || 'Failed to reuse question set.', true);
          } finally {
            reuseConfirmButton.disabled = false;
            reuseConfirmButton.textContent = originalLabel;
          }
        });
      }

      var syncGoogleButton = document.getElementById('all-class-sync-google');
      if (syncGoogleButton) {
        syncGoogleButton.addEventListener('click', async function () {
          syncGoogleButton.disabled = true;
          var originalLabel = syncGoogleButton.textContent;
          syncGoogleButton.textContent = 'Syncing...';

          try {
            var response = await fetch('/account/google-classroom/resync', {
              method: 'POST',
              headers: { Accept: 'application/json' },
            });

            if (!response.ok) {
              throw new Error('Could not queue Google Classroom sync.');
            }

            alert('Google Classroom sync queued.');
          } catch (_) {
            alert('Could not queue Google Classroom sync.');
          } finally {
            syncGoogleButton.disabled = false;
            syncGoogleButton.textContent = originalLabel;
          }
        });
      }
    })();
  </script>
</body>
</html>
