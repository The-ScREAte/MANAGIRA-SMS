    }

    .qm-btn-clear {
      display: inline-flex;
      align-items: center;
      gap: 4px;
      border: 1.5px solid #e2e8f0;
      background: #f8fafc;
      color: #64748b;
      border-radius: 7px;
      padding: 6px 10px;
      font-size: 0.72rem;
      font-weight: 700;
      cursor: pointer;
      transition: all 0.15s;
    }

    

    .qm-btn-save {
      display: inline-flex;
      align-items: center;
      gap: 5px;
      background: linear-gradient(135deg, #0f5a66 0%, #1a8fa0 100%);
      color: #fff;
      border: none;
      border-radius: 7px;
      padding: 7px 12px;
      font-size: 0.74rem;
      font-weight: 800;
      cursor: pointer;
      transition: opacity 0.15s, transform 0.1s;
