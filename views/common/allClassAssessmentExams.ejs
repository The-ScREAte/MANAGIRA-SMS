    .qm-options-layout-btn .qm-layout-icon span {
      display: block;
      border-radius: 999px;
      background: currentColor;
      opacity: 0.82;
    }

    .qm-options-layout-btn[data-layout="stacked"] .qm-layout-icon {
      grid-template-rows: repeat(3, 1fr);
      grid-template-columns: 1fr;
    }

    .qm-options-layout-btn[data-layout="side_by_side"] .qm-layout-icon {
      grid-template-columns: repeat(2, 1fr);
      grid-template-rows: repeat(2, 1fr);
    }

    .qm-options-layout-btn.is-active {
