      outline: none;
      overflow-wrap: break-word;
      white-space: pre-wrap;
      overflow-y: auto;
    }

    .question-text-editor:empty:before {
      content: attr(data-placeholder);
      color: #94a3b8;
      pointer-events: none;
    }

    .question-text {
      display: none;
    }

    .question-options-list {
      display: grid;
      grid-template-columns: 1fr;
      gap: 6px;
    }

    .question-options-list.is-side-by-side {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: 8px;
      row-gap: 6px;
    }

    .qm-options-head {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 8px;
    }

    .qm-options-layout-toggle {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 0;
      border: 0;
      border-radius: 0;
      background: transparent;
      box-shadow: none;
    }

    .qm-options-layout-btn {
      border: 1px solid #cbd5e1;
      border-radius: 8px;
      background: transparent;
      color: #64748b;
      min-height: 22px;
      min-width: 28px;
      padding: 0 6px;
      font-size: 0.58rem;
      font-weight: 700;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 0;
      cursor: pointer;
      transition: border-color 0.18s ease, color 0.18s ease, box-shadow 0.18s ease;
    }

    .qm-options-layout-btn .qm-layout-icon {
      width: 14px;
      height: 12px;
      display: grid;
      gap: 2px;
      flex-shrink: 0;
