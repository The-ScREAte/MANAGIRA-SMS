      if (qmUploadPdfBtn && qmPdfFileInput) {
        renderUploadButtonIdle();

        qmUploadPdfBtn.addEventListener('click', function () {
          qmPdfFileInput.value = '';
          qmPdfFileInput.click();
        });

        qmPdfFileInput.addEventListener('change', async function () {
          var file = qmPdfFileInput.files && qmPdfFileInput.files[0];
          if (!file) return;

          var lowerName = String(file.name || '').toLowerCase();
          var allowedExtensions = ['.pdf', '.doc', '.docx', '.xls', '.xlsx', '.png', '.jpg', '.jpeg', '.webp', '.gif'];
          var isAllowedByExtension = allowedExtensions.some(function (ext) { return lowerName.endsWith(ext); });
          var isAllowedImageMime = String(file.type || '').toLowerCase().indexOf('image/') === 0;
          var isAllowedDocMime = ['application/pdf', 'application/msword', 'application/vnd.openxmlformats-officedocument.wordprocessingml.document', 'application/vnd.ms-excel', 'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet'].includes(String(file.type || '').toLowerCase());

          if (!isAllowedByExtension && !isAllowedImageMime && !isAllowedDocMime) {
            setQuestionStatus('Please upload a PDF, Word, Excel, or image file.', true);
            return;
          }

          var formData = new FormData();
          formData.append('examFile', file);

          qmUploadPdfBtn.disabled = true;
          setUploadButtonLoading('Reading file...');

          try {
            var response = await fetch('/common/assessment/questions/extract-file', {
              method: 'POST',
              headers: { Accept: 'application/json' },
              body: formData,
            });

            setUploadButtonLoading('Extracting questions...');
            var payload = await response.json();
            if (!response.ok || !payload.success) {
              throw new Error(payload.error || 'PDF extraction failed.');
            }

            populateQuestionsFromExtracted(payload.questions || [], file.name || 'PDF');
          } catch (error) {
            setQuestionStatus('PDF extraction failed: ' + (error.message || 'Unknown error.'), true);
          } finally {
            qmUploadPdfBtn.disabled = false;
            renderUploadButtonIdle();
          }
        });
      }

      if (addQuestionItemButton) {
        addQuestionItemButton.addEventListener('click', function () {
          if (!questionItems) return;
          questionItems.appendChild(buildQuestionItem());
          applyAssessmentMarksLimit(selectedAssessmentRule ? selectedAssessmentRule.maxScore : null);
          renumberQuestionCards();
          updateQuestionCount();
          saveDraft();
        });
      }

      if (qmQuestionsLayoutToggle) {
        qmQuestionsLayoutToggle.addEventListener('click', function (event) {
          var targetButton = event.target && event.target.closest
            ? event.target.closest('.qm-options-layout-btn')
            : null;
          if (!targetButton) return;

          var selectedMode = targetButton.getAttribute('data-layout') === 'side_by_side'
            ? 'side_by_side'
            : 'stacked';
          applyQuestionCardsLayoutMode(selectedMode);
          saveDraft();
        });
      }

      if (questionTimeModeSelect) {
        questionTimeModeSelect.addEventListener('change', function () {
          hasManualAssessmentModeEdits = true;
          syncQuestionTimeLimitUi();
          renderAssessmentRulesSummary();
          saveDraft();
        });
      }

      if (questionOpenBookSelect) {
        questionOpenBookSelect.addEventListener('change', function () {
          hasManualAssessmentModeEdits = true;
          renderAssessmentRulesSummary();
          saveDraft();
        });
      }

      if (questionTimeLimitInput) {
        questionTimeLimitInput.addEventListener('input', function () {
          hasManualAssessmentModeEdits = true;
          renderAssessmentRulesSummary();
        });
        questionTimeLimitInput.addEventListener('change', function () {
          hasManualAssessmentModeEdits = true;
          renderAssessmentRulesSummary();
          saveDraft();
        });
      }

      if (questionMaxAttemptsInput) {
        questionMaxAttemptsInput.addEventListener('input', function () {
          hasManualAssessmentModeEdits = true;
          renderAssessmentRulesSummary();
        });
        questionMaxAttemptsInput.addEventListener('change', function () {
          hasManualAssessmentModeEdits = true;
          var parsed = Number.parseInt(String(questionMaxAttemptsInput.value || '').trim(), 10);
          questionMaxAttemptsInput.value = String(Number.isInteger(parsed) && parsed > 0 ? parsed : 1);
          renderAssessmentRulesSummary();
          saveDraft();
        });
      }

      syncQuestionTimeLimitUi();

      if (qmClearDraftButton) {
        qmClearDraftButton.addEventListener('click', function () {
          clearDraft();
          if (questionItems) questionItems.innerHTML = '';
          applyQuestionCardsLayoutMode('stacked');
          if (questionTimeModeSelect) questionTimeModeSelect.value = 'timed';
          syncQuestionTimeLimitUi();
          if (questionMaxAttemptsInput) questionMaxAttemptsInput.value = '1';
          if (questionSetTitleInput) questionSetTitleInput.value = '';
          if (questionSetDescriptionInput) questionSetDescriptionInput.value = '';
          if (window.ParentResources) window.ParentResources.load(null);
          if (questionItems) questionItems.appendChild(buildQuestionItem());
          renumberQuestionCards();
          updateQuestionCount();
        });
      }

      if (saveQuestionSetButton) {
        saveQuestionSetButton.addEventListener('click', async function () {
          var questions = collectQuestionItems();
          if (!questions.length) {
            setQuestionStatus('Add at least one question before saving.', true);
            return;
          }

          var selectedRule = resolveSelectedAssessmentRule();
          selectedAssessmentRule = selectedRule;
          if (!selectedRule) {
            setQuestionStatus('Select an assessment to apply question rules.', true);
            return;
          }

          // Marks that don't add up to the test's "out of" are asked about when saving (public/js/questionMarks.js).
          var hasInvalidMarks = questions.some(function (item) {
            return !(Number(item.marks || 0) > 0);
          });
          if (hasInvalidMarks) {
            setQuestionStatus('Each question needs marks above 0.', true);
            return;
          }

          var payload = {
            questionSetId: questionModalMode === 'edit' ? currentQuestionSetId : null,
            classId: Number(selectedRule.classId),
            subjectId: Number(selectedRule.subjectId),
            termId: Number(selectedRule.termId),
            assessmentId: Number(selectedRule.assessmentId),
            questionCardLayout: questionItems
              ? String(questionItems.getAttribute('data-layout-mode') || 'stacked')
              : 'stacked',
            openBook: questionOpenBookSelect ? String(questionOpenBookSelect.value) === 'true' : false,
            timeLimitMinutes: (questionTimeModeSelect && questionTimeModeSelect.value === 'unlimited')
              ? ''
              : (questionTimeLimitInput ? String(questionTimeLimitInput.value || '').trim() : ''),
            maxAttempts: questionMaxAttemptsInput
              ? String(Math.max(Number.parseInt(String(questionMaxAttemptsInput.value || '').trim(), 10) || 1, 1))
              : '1',
            setTitle: String(questionSetTitleInput ? questionSetTitleInput.value : '').trim(),
            setDescription: String(questionSetDescriptionInput ? questionSetDescriptionInput.value : '').trim(),
            questions: questions,
            parentShare: window.QuestionBuilderFlow ? window.QuestionBuilderFlow.parentShare() : undefined,
            shuffleQuestions: window.QuestionBuilderFlow ? window.QuestionBuilderFlow.shuffle() : undefined,
          };

          setQuestionStatus('Saving question set...', false);
          setSaveButtonLoading('Saving...');
          try {
            var saved = window.QuestionMarks
              ? await window.QuestionMarks.post('/common/assessment/questions/upsert', payload)
              : await fetch('/common/assessment/questions/upsert', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
                body: JSON.stringify(payload),
              }).then(function (r) { return r.json().then(function (j) { return { response: r, result: j }; }); });
            if (saved.cancelled) {
              setQuestionStatus('', false);
              renderSaveButtonIdle();
              return;
            }
            var response = saved.response;
            var result = saved.result;
            if (!response.ok || !result.success) {
              throw new Error(result.error || 'Failed to save question set.');
            }

            currentQuestionSetId = result.questionSetId || currentQuestionSetId;
            if (window.ParentResources) await window.ParentResources.afterSave(currentQuestionSetId);
            setQuestionStatus(result.message || 'Questions saved.', false);
            clearDraft();
            if (window.QuestionBuilderFlow && window.QuestionBuilderFlow.afterSave(result)) return;
            window.location.reload();
          } catch (error) {
            setQuestionStatus(error.message || 'Failed to save question set.', true);
            renderSaveButtonIdle();
          }
        });
      }

      if (questionModalOverlay) {
        questionModalOverlay.addEventListener('input', saveDraft);
        questionModalOverlay.addEventListener('change', saveDraft);
      }

      document.querySelectorAll('.review-set-btn').forEach(function (button) {
        button.addEventListener('click', async function (event) {
          event.preventDefault();
          event.stopPropagation();
          closeAllSetActionMenus();

          if (button.classList.contains('is-disabled')) {
            return;
          }

          var questionSetId = Number(button.getAttribute('data-question-set-id') || 0);
          var action = String(button.getAttribute('data-review-action') || '').toLowerCase();
          if (!questionSetId || (action !== 'approve' && action !== 'reject')) {
            return;
          }

          var note = '';
          if (action === 'reject') {
            note = window.prompt('Optional rejection note:') || '';
          }

          button.classList.add('is-disabled');
          button.setAttribute('aria-disabled', 'true');
          var originalLabel = button.textContent;
          button.textContent = action === 'approve' ? 'Approving...' : 'Rejecting...';

          try {
            var response = await fetch('/common/assessment/questions/review', {
              method: 'POST',
              headers: {
                'Content-Type': 'application/json',
                Accept: 'application/json',
              },
              body: JSON.stringify({
                questionSetId: questionSetId,
                action: action,
                reviewNote: note,
              }),
            });

            var result = await response.json();
            if (!response.ok || !result.success) {
              throw new Error(result.error || 'Failed to update review status.');
            }

            window.location.reload();
          } catch (error) {
            setQuestionStatus(error.message || 'Failed to update review status.', true);
            button.classList.remove('is-disabled');
            button.removeAttribute('aria-disabled');
            button.textContent = originalLabel;
          }
        });
      });

      document.querySelectorAll('.reuse-set-btn').forEach(function (button) {
        button.addEventListener('click', function (event) {
          event.preventDefault();
          event.stopPropagation();
          closeAllSetActionMenus();
          openReuseModal(
            button.getAttribute('data-question-set-id'),
            button.getAttribute('data-set-title'),
            button.getAttribute('data-assessment-title')
          );
        });
      });

      document.querySelectorAll('.delete-set-btn').forEach(function (button) {
        button.addEventListener('click', async function (event) {
          event.preventDefault();
          event.stopPropagation();
          closeAllSetActionMenus();

          var questionSetId = Number(button.getAttribute('data-question-set-id') || 0);
          var setTitle = String(button.getAttribute('data-set-title') || 'this question set').trim();
          if (!questionSetId) return;

          var confirmed = await window.appConfirm('Delete "' + setTitle + '"? This will permanently remove all questions in the set.');
          if (!confirmed) return;

          button.classList.add('is-disabled');
          button.setAttribute('aria-disabled', 'true');
          var originalLabel = button.textContent;
          button.textContent = 'Deleting...';

          try {
            var response = await fetch('/common/assessment/questions/delete', {
              method: 'POST',
              headers: {
                'Content-Type': 'application/json',
                Accept: 'application/json',
              },
              body: JSON.stringify({ questionSetId: questionSetId }),
            });

            var result = await response.json();
            if (!response.ok || !result.success) {
              throw new Error(result.error || 'Failed to delete question set.');
            }

            window.location.reload();
          } catch (error) {
            setQuestionStatus(error.message || 'Failed to delete question set.', true);
            button.classList.remove('is-disabled');
            button.removeAttribute('aria-disabled');
            button.textContent = originalLabel;
          }
        });
      });

      if (reuseCancelButton) {
        reuseCancelButton.addEventListener('click', closeReuseModal);
      }

      if (reuseModalOverlay) {
        reuseModalOverlay.addEventListener('click', function (event) {
          // Closes only with the X (or Cancel), never by clicking outside.
          if (event.target.closest && event.target.closest('#reuse-modal-x')) closeReuseModal();
        });
      }

      if (reuseSchoolYearSelect) {
        reuseSchoolYearSelect.addEventListener('change', function () {
          renderReuseTerms();
          renderReuseClasses();
          renderReuseSubjects();
        });
      }

      if (reuseTermSelect) {
        reuseTermSelect.addEventListener('change', function () {
          renderReuseClasses();
          renderReuseSubjects();
        });
      }

      if (reuseClassSelect) {
        reuseClassSelect.addEventListener('change', function () {
          renderReuseSubjects();
        });
      }

      if (reuseConfirmButton) {
        reuseConfirmButton.addEventListener('click', async function () {
          var targetTermId = Number(reuseTermSelect ? reuseTermSelect.value : 0);
          var targetClassId = Number(reuseClassSelect ? reuseClassSelect.value : 0);
          var targetSubjectId = Number(reuseSubjectSelect ? reuseSubjectSelect.value : 0);
          var assessmentTitle = String(reuseAssessmentTitleInput ? reuseAssessmentTitleInput.value : '').trim();
          var shuffleMode = String(reuseShuffleModeSelect ? reuseShuffleModeSelect.value : 'none');
          var shouldShuffleOptions = Boolean(reuseShuffleOptionsInput && reuseShuffleOptionsInput.checked);

          if (!activeSourceQuestionSetId) {
            setReuseStatus('Select a source question set first.', true);
            return;
          }
          if (!targetTermId || !targetClassId || !targetSubjectId) {
            setReuseStatus('Select school year, term, class, and subject.', true);
            return;
          }
          if (!assessmentTitle) {
            setReuseStatus('Enter an assessment title for the reused set.', true);
            return;
          }

          reuseConfirmButton.disabled = true;
          var originalLabel = reuseConfirmButton.textContent;
          reuseConfirmButton.textContent = 'Reusing...';
          setReuseStatus('Reusing question set...', false);

          try {
            var reusePayload = {
              sourceQuestionSetId: activeSourceQuestionSetId,
              targetTermId: targetTermId,
              targetClassId: targetClassId,
              targetSubjectId: targetSubjectId,
              targetAssessmentTitle: assessmentTitle,
              shuffleMode: shuffleMode,
              shuffleOptions: shouldShuffleOptions ? 'true' : 'false',
            };
            var reused = window.QuestionMarks
              ? await window.QuestionMarks.post('/common/assessment/questions/reuse', reusePayload)
              : await fetch('/common/assessment/questions/reuse', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
                body: JSON.stringify(reusePayload),
              }).then(function (r) { return r.json().then(function (j) { return { response: r, result: j }; }); });
            if (reused.cancelled) {
              setReuseStatus('', false);
              return;
            }
            var response = reused.response;
            var result = reused.result;
            if (!response.ok || !result.success) {
              throw new Error(result.error || 'Failed to reuse question set.');
            }

            setReuseStatus(result.message || 'Question set reused successfully.', false);
            var nextUrl = '/common/allClassAssessmentExams?organizationId=' + encodeURIComponent(String(organizationId)) + '&termId=' + encodeURIComponent(String(targetTermId));
            if (Number(targetClassId) > 0) {
              nextUrl += '&classId=' + encodeURIComponent(String(targetClassId));
            } else if (selectedClassId > 0) {
              nextUrl += '&classId=' + encodeURIComponent(String(selectedClassId));
            }
            if (isEmbedded) {
              nextUrl += '&embed=workspace';
            }
            window.location.href = nextUrl;
          } catch (error) {
            setReuseStatus(error.message || 'Failed to reuse question set.', true);
          } finally {
            reuseConfirmButton.disabled = false;
            reuseConfirmButton.textContent = originalLabel;
          }
        });
      }

      var syncGoogleButton = document.getElementById('all-class-sync-google');
      if (syncGoogleButton) {
        syncGoogleButton.addEventListener('click', async function () {
          syncGoogleButton.disabled = true;
          var originalLabel = syncGoogleButton.textContent;
          syncGoogleButton.textContent = 'Syncing...';

          try {
            var response = await fetch('/account/google-classroom/resync', {
              method: 'POST',
              headers: { Accept: 'application/json' },
            });

            var answer = await response.json().catch(function () { return {}; });
            if (!response.ok || !answer.success) {
              throw new Error(answer.message || answer.error || 'Google Classroom could not start syncing.');
            }

            alert(answer.message || 'Google Classroom is syncing in the background.');
          } catch (err) {
            alert((err && err.message) || 'Google Classroom could not start syncing.');
          } finally {
            syncGoogleButton.disabled = false;
            syncGoogleButton.textContent = originalLabel;
          }
        });
      }

      // The assessments flow (public/js/questionBuilderFlow.js) works through these.
      window.QuestionBuilderHooks = {
        buildQuestionItem: buildQuestionItem,
        renumberQuestionCards: renumberQuestionCards,
        updateQuestionCount: updateQuestionCount,
        saveDraft: saveDraft,
        setQuestionStatus: setQuestionStatus,
        openEditQuestionSet: openEditQuestionSet,
        renderQuestionModalAssessments: renderQuestionModalAssessments,
        questionItems: questionItems,
        assessmentSelect: questionAssessmentSelect,
        classSelect: questionClassSelect,
        subjectSelect: questionSubjectSelect,
        termSelect: questionTermSelect,
        schoolYearSelect: questionSchoolYearSelect,
        mode: function () { return questionModalMode; },
        refreshRules: function () {
          hasManualAssessmentModeEdits = false;
          renderAssessmentRulesSummary({ forceHydrateModeInputs: true });
        },
        // A new set for one assessment, its class, subject and term already chosen.
        openNew: async function (target) {
          setQuestionModalMode('create');
          openQuestionModal();
          applyQuestionCardsLayoutMode('stacked');
          renderQuestionModalSchoolYears();
          if (target.schoolYearId && questionSchoolYearSelect) questionSchoolYearSelect.value = String(target.schoolYearId);
          renderQuestionModalTerms();
          if (target.termId && questionTermSelect) questionTermSelect.value = String(target.termId);
          renderQuestionModalClasses();
          if (target.classId && questionClassSelect) questionClassSelect.value = String(target.classId);
          renderQuestionModalSubjects();
          if (target.subjectId && questionSubjectSelect) questionSubjectSelect.value = String(target.subjectId);
          await renderQuestionModalAssessments();
          if (target.assessmentId && questionAssessmentSelect) questionAssessmentSelect.value = String(target.assessmentId);
          currentQuestionSetId = null;
          hasManualAssessmentModeEdits = false;
          renderAssessmentRulesSummary({ forceHydrateModeInputs: true });
          await hydrateQuestionModalFromServer();
          renumberQuestionCards();
          updateQuestionCount();
        },
      };
      window.QuestionBuilderFlowConfig = <%- JSON.stringify({ open: locals.flowOpen || null, embedded: Boolean(isEmbedded), organizationId: Number(organizationId), termId: Number(termId), canCreateAssessments: Boolean(locals.canCreateAssessments), extras: Boolean(locals.questionExtras), shuffle: Boolean(locals.shuffleAvailable) }).replace(/</g, '\\u003c') %>;
    })();
  </script>
<%# Resources & recommendations and help on each question: setResources.js takes the place of the older parent-only box. %>
<link rel="stylesheet" href="<%= assetUrl('/css/learningResources.css') %>" /><script src="<%= assetUrl('/js/setResources.js') %>" defer></script><script src="<%= assetUrl('/js/questionHelp.js') %>" defer></script><link rel="stylesheet" href="<%= assetUrl('/css/questionRubric.css') %>" /><script nonce="<%= locals.cspNonce || '' %>">window.QuestionRubricConfig = { on: <%= locals.rubricAvailable ? 'true' : 'false' %> };</script><script src="<%= assetUrl('/js/questionRubric.js') %>" defer></script>
<link rel="stylesheet" href="<%= assetUrl('/css/parentResources.css') %>" /><script src="<%= assetUrl('/js/parentResources.js') %>" defer></script>
<link rel="stylesheet" href="<%= assetUrl('/css/assessmentFlow.css') %>" /><link rel="stylesheet" href="<%= assetUrl('/css/questionBuilderFlow.css') %>" /><link rel="stylesheet" href="<%= assetUrl('/css/classroomPhone.css') %>" /><link rel="stylesheet" href="<%= assetUrl('/css/classroomPages.css') %>" /><script src="<%= assetUrl('/js/assessmentFlow.js') %>" defer></script><script src="<%= assetUrl('/js/questionMarks.js') %>" defer></script><script src="<%= assetUrl('/js/questionBuilderFlow.js') %>" defer></script>
</body>
</html>

