                    data-pending-count="<%= pendingPostCount %>"
                    data-share="<%= setItem.parent_share || '' %>">
                    <span class="score-status-dot"></span>
                    <span class="card-score-toggle-status"><%
                      if (!isPostedOn) { %>Not posted<%
                      } else if (pendingPostCount > 0) { %>Posted (<%= pendingPostCount %> new)<%
                      } else { %>Posted<% }
                    %></span>
                    <button type="button" class="card-post-score-toggle post-grades-btn<%= isPostedOn && pendingPostCount <= 0 ? ' is-on' : '' %>" title="<%= isPostedOn && pendingPostCount <= 0 ? 'Hide these grades from families again' : 'Families will see: ' + (setItem.parent_share === 'full' ? 'Grade and answers' : (setItem.parent_share === 'grade' ? 'Grade' : 'Nothing about the test itself')) %>"><%= isPostedOn && pendingPostCount <= 0 ? 'Take back' : 'Post grades' %></button>
                  </span>
                <% } %>
                <% const updatedInfo = formatRelativeUpdated(setItem.updated_at); %>
                <span class="exam-updated" title="<%= updatedInfo.full %>"><%= updatedInfo.relative %></span>
                <div class="set-actions-menu">
                  <a href="#" class="set-actions-trigger" aria-haspopup="true" aria-expanded="false" title="More actions"><svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor"><circle cx="12" cy="5" r="1.8"/><circle cx="12" cy="12" r="1.8"/><circle cx="12" cy="19" r="1.8"/></svg></a>
                  <div class="set-actions-dropdown" role="menu">
                    <% if (canReviewQuestionSets && (setItem.review_status || '').toLowerCase() === 'pending') { %>
                      <a
                        href="#"
                        class="set-action-link review-set-btn"
                        data-question-set-id="<%= setItem.question_set_id %>"
                        data-review-action="approve"
                      >Approve</a>
                      <a
                        href="#"
                        class="set-action-link review-set-btn"
                        data-question-set-id="<%= setItem.question_set_id %>"
                        data-review-action="reject"
                      >Reject</a>
                    <% } %>
                    <a
                      href="#"
                      class="set-action-link preview-set-btn"
                      data-question-set-id="<%= setItem.question_set_id %>"
                      data-assessment-id="<%= setItem.assessment_id %>"
                      data-class-id="<%= setItem.class_id %>"
                      data-class-name="<%= String(setItem.class_name || '').replace(/"/g, '&quot;') %>"
                      data-subject-id="<%= setItem.subject_id %>"
                      data-subject-name="<%= String(setItem.subject_name || '').replace(/"/g, '&quot;') %>"
                      data-term-id="<%= termId %>"
                      data-school-year-id="<%= selectedSchoolYearId %>"
                      data-set-title="<%= String(setItem.set_title || '').replace(/"/g, '&quot;') %>"
                      data-assessment-title="<%= String(setItem.assessment_title || '').replace(/"/g, '&quot;') %>"
                    >Preview</a>
                    <a
                      href="#"
                      class="set-action-link students-set-btn"
                      data-question-set-id="<%= setItem.question_set_id %>"
                      data-set-title="<%= String(setItem.set_title || '').replace(/"/g, '&quot;') %>"
                    >Review</a>
                    <a
                      href="#"
                      class="set-action-link edit-set-btn"
                      data-question-set-id="<%= setItem.question_set_id %>"
                      data-assessment-id="<%= setItem.assessment_id %>"
                      data-class-id="<%= setItem.class_id %>"
                      data-subject-id="<%= setItem.subject_id %>"
                      data-term-id="<%= termId %>"
                      data-school-year-id="<%= selectedSchoolYearId %>"
                    >Edit</a>
                    <% if (locals.rubricAvailable) { %>
                    <a
                      href="#"
                      class="set-action-link edit-set-btn"
                      data-open-rubric="1"
                      data-question-set-id="<%= setItem.question_set_id %>"
                      data-assessment-id="<%= setItem.assessment_id %>"
                      data-class-id="<%= setItem.class_id %>"
                      data-subject-id="<%= setItem.subject_id %>"
                      data-term-id="<%= termId %>"
                      data-school-year-id="<%= selectedSchoolYearId %>"
                    >Rubric</a>
                    <% } %>
                    <a
                      href="#"
                      class="set-action-link reuse-set-btn"
                      data-question-set-id="<%= setItem.question_set_id %>"
                      data-set-title="<%= String(setItem.set_title || '').replace(/"/g, '&quot;') %>"
                      data-assessment-title="<%= String(setItem.assessment_title || '').replace(/"/g, '&quot;') %>"
                    >Reuse</a>
                    <a
                      href="#"
                      class="set-action-link delete-set-btn"
                      data-question-set-id="<%= setItem.question_set_id %>"
                      data-set-title="<%= String(setItem.set_title || '').replace(/"/g, '&quot;') %>"
                    >Delete</a>
                  </div>
                </div>
              </div>
            </div>
                </article>
                          <% }); %>
                        </div>
                      </section>
                    <% }); %>
                  </div>
                </section>
              <% }); %>
            </div>
          </section>
        <% }); %>
      </div>
      <div class="empty-state" id="question-set-filter-empty" hidden>No question sets match the current filters.</div>
