        });

        qmPdfFileInput.addEventListener('change', async function () {
          var file = qmPdfFileInput.files && qmPdfFileInput.files[0];
          if (!file) return;

          var lowerName = String(file.name || '').toLowerCase();
          var allowedExtensions = ['.pdf', '.doc', '.docx', '.xls', '.xlsx', '.png', '.jpg', '.jpeg', '.webp', '.gif'];
          var isAllowedByExtension = allowedExtensions.some(function (ext) { return lowerName.endsWith(ext); });
          var isAllowedImageMime = String(file.type || '').toLowerCase().indexOf('image/') === 0;
          var isAllowedDocMime = ['application/pdf', 'application/msword', 'application/vnd.openxmlformats-officedocument.wordprocessingml.document', 'application/vnd.ms-excel', 'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet'].includes(String(file.type || '').toLowerCase());

          if (!isAllowedByExtension && !isAllowedImageMime && !isAllowedDocMime) {
            setQuestionStatus('Please upload a PDF, Word, Excel, or image file.', true);
            return;
          }

          var formData = new FormData();
          formData.append('examFile', file);

          qmUploadPdfBtn.disabled = true;
          setUploadButtonLoading('Reading file...');

          try {
            var response = await fetch('/common/assessment/questions/extract-file', {
              method: 'POST',
              headers: { Accept: 'application/json' },
              body: formData,
            });

            setUploadButtonLoading('Extracting questions...');
            var payload = await response.json();
            if (!response.ok || !payload.success) {
              throw new Error(payload.error || 'PDF extraction failed.');
            }

            populateQuestionsFromExtracted(payload.questions || [], file.name || 'PDF');
          } catch (error) {
            setQuestionStatus('PDF extraction failed: ' + (error.message || 'Unknown error.'), true);
          } finally {
            qmUploadPdfBtn.disabled = false;
            renderUploadButtonIdle();
          }
        });
