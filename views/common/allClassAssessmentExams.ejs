      if (saveQuestionSetButton) {
        saveQuestionSetButton.addEventListener('click', async function () {
          var questions = collectQuestionItems();
          if (!questions.length) {
            setQuestionStatus('Add at least one question before saving.', true);
            return;
          }

          renderAssessmentRulesSummary();
          var selectedRule = selectedAssessmentRule;
          if (!selectedRule) {
            setQuestionStatus('Select an assessment to apply question rules.', true);
            return;
          }

          var totalMarks = questions.reduce(function (sum, item) { return sum + Number(item.marks || 0); }, 0);
          if (Number(totalMarks) > Number(selectedRule.maxScore || 0)) {
            setQuestionStatus('Total question marks (' + totalMarks + ') cannot exceed assessment max score (' + selectedRule.maxScore + ').', true);
            return;
          }

          var hasInvalidMarks = questions.some(function (item) {
            return Number(item.marks || 0) <= 0 || Number(item.marks || 0) > Number(selectedRule.maxScore || 0);
          });
          if (hasInvalidMarks) {
            setQuestionStatus('Each question mark must be between 1 and ' + selectedRule.maxScore + '.', true);
            return;
          }

          var payload = {
            questionSetId: questionModalMode === 'edit' ? currentQuestionSetId : null,
            classId: Number(selectedRule.classId),
            subjectId: Number(selectedRule.subjectId),
            termId: Number(selectedRule.termId),
            assessmentId: Number(selectedRule.assessmentId),
            questionCardLayout: questionItems
              ? String(questionItems.getAttribute('data-layout-mode') || 'stacked')
              : 'stacked',
            openBook: questionOpenBookSelect ? String(questionOpenBookSelect.value) === 'true' : false,
            timeLimitMinutes: questionTimeLimitInput ? String(questionTimeLimitInput.value || '').trim() : '',
            setTitle: String(questionSetTitleInput ? questionSetTitleInput.value : '').trim() || 'Question Set',
            setDescription: String(questionSetDescriptionInput ? questionSetDescriptionInput.value : '').trim(),
            questions: questions,
          };

          setQuestionStatus('Saving question set...', false);
          setSaveButtonLoading('Saving...');
          try {
            var response = await fetch('/common/assessment/questions/upsert', {
              method: 'POST',
              headers: {
                'Content-Type': 'application/json',
                Accept: 'application/json',
              },
