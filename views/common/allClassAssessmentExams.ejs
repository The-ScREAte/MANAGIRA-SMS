          </svg>
          Add Question
        </button>
        <div class="qm-footer-right">
          <button type="button" class="qm-btn-clear" id="qm-clear-draft">
            <svg width="13" height="13" viewBox="0 0 16 16" fill="none">
              <path d="M2 4h12M5 4V2h6v2M3 4l1 9h8l1-9" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            Clear Draft
          </button>
          <button type="button" class="qm-btn-save" id="save-question-set">
            <svg width="14" height="14" viewBox="0 0 16 16" fill="none">
              <path d="M13 2H4L2 4v9a1 1 0 001 1h10a1 1 0 001-1V3a1 1 0 00-1-1zM5 2v4h6V2M5 9h6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            Save Questions
          </button>
        </div>
      </div>
      <div id="question-modal-status" aria-live="polite"></div>
