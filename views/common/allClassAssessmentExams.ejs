          var targetTermId = Number(reuseTermSelect ? reuseTermSelect.value : 0);
          var targetClassId = Number(reuseClassSelect ? reuseClassSelect.value : 0);
          var targetSubjectId = Number(reuseSubjectSelect ? reuseSubjectSelect.value : 0);
          var assessmentTitle = String(reuseAssessmentTitleInput ? reuseAssessmentTitleInput.value : '').trim();
          var shuffleMode = String(reuseShuffleModeSelect ? reuseShuffleModeSelect.value : 'none');
          var shouldShuffleOptions = Boolean(reuseShuffleOptionsInput && reuseShuffleOptionsInput.checked);

          if (!activeSourceQuestionSetId) {
