<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Assessment Question Sets</title>
  <style>
    :root {
      --font-family: "<%= (session && session.fontStyle ? String(session.fontStyle).trim() : 'Inter') %>", sans-serif;
      --primary: var(--org-primary-color, #0f5a66);
      --primary-hover: var(--org-primary-hover, #0d4f59);
      --primary-soft: color-mix(in srgb, var(--primary) 12%, #ffffff);
      --border: #d9e3ea;
      --text: #132d35;
      --muted: #607080;
      --surface: #f4f6f9;
    }

    *, *::before, *::after { box-sizing: border-box; }
    body { margin: 0; font-family: var(--font-family); background: var(--surface); color: var(--text); font-size: 14px; line-height: 1.35; }

    .page-wrap { max-width: 1280px; margin: 0 auto; padding: 14px 12px 20px; }
    .top-bar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 8px;
      margin-bottom: 12px;
    }
    .top-bar h1 { margin: 0; font-size: 1.08rem; color: #0f2d32; line-height: 1.2; }
    .top-bar-actions { display: inline-flex; flex-wrap: wrap; gap: 10px; }
    .top-bar-actions {
      display: flex;
      flex-wrap: nowrap;
      align-items: center;
      gap: 8px;
      overflow-x: auto;
      padding-bottom: 2px;
    }
    .top-bar-actions .btn {
      flex: 0 0 auto;
      width: auto;
      min-height: 30px;
      justify-content: center;
      text-align: center;
      padding: 5px 8px;
    }

    .btn {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      border-radius: 8px;
      border: none;
      text-decoration: none;
      font-size: 0.72rem;
      font-weight: 600;
      cursor: pointer;
      padding: 6px 10px;
      white-space: nowrap;
    }
    .btn-outline {
      background: #fff;
      color: var(--primary);
      border: 2px solid var(--primary);
    }
    .btn-outline:hover { background: #fff; }

    .btn-google {
      background: #fff;
      color: #0b3a44;
      border: 2px solid #d3dde4;
    }
    .btn-google:hover { background: #fff; color: #0b3a44; }

    .helper-text {
      margin: 0 0 10px;
      color: var(--muted);
      font-size: 0.74rem;
    }

    .grid-two {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 12px;
    }

    .form-card {
      background: #fff;
      border: 1px solid var(--border);
      border-radius: 10px;
      box-shadow: 0 4px 14px rgba(15, 45, 50, 0.07);
      padding: 10px;
      margin-bottom: 10px;
    }

    .collapsible-card {
      padding: 0;
      overflow: hidden;
    }

    .collapsible-summary {
      list-style: none;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 8px;
      padding: 10px;
      user-select: none;
    }

    .collapsible-summary::-webkit-details-marker {
      display: none;
    }

    .collapsible-content {
      padding: 0 10px 10px;
      border-top: 1px solid #e2e8f0;
    }

    .workspace-inline {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr) auto;
      gap: 8px;
      align-items: end;
      margin-top: 8px;
    }

    .text-link-control {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-height: 30px;
      padding: 7px 10px;
      border-radius: 8px;
      border: 1px solid #cbd5e1;
      background: #fff;
      color: #0f5a66;
      font-size: 0.7rem;
      font-weight: 700;
      text-decoration: none;
      white-space: nowrap;
    }

    .text-link-control:hover,
    .text-link-control:focus-visible {
      border-color: #0f5a66;
      text-decoration: none;
      outline: none;
    }

    .collapsible-hint {
      font-size: 0.66rem;
      font-weight: 700;
      color: #0f5a66;
      white-space: nowrap;
    }

    .section-title {
      margin: 0 0 8px;
      font-size: 0.8rem;
      color: var(--primary);
    }

    .field-group {
      display: grid;
      gap: 4px;
    }

    .field-group label {
      font-size: 0.64rem;
      font-weight: 700;
      color: #3b5563;
    }

    .field-group input,
    .field-group select {
      width: 100%;
      border: 1px solid #cddae3;
      background: #fff;
      border-radius: 8px;
      min-height: 30px;
      padding: 5px 8px;
      font: inherit;
      font-size: 0.72rem;
      color: #102f39;
    }

    .field-group input:focus,
    .field-group select:focus {
      outline: none;
      border-color: var(--primary);
      box-shadow: 0 0 0 2px rgba(15, 90, 102, 0.14);
    }

    .row-actions {
      margin-top: 8px;
      display: inline-flex;
      gap: 8px;
      flex-wrap: wrap;
    }

    .btn-primary {
      background: var(--primary);
      color: #fff;
    }
    .btn-primary:hover { background: var(--primary); }

    .btn-secondary {
      background: #fff;
      color: #334155;
      border: 1px solid #cbd5e1;
    }
    .btn-secondary:hover { background: #fff; color: #334155; }

    .status-text {
      margin: 8px 0 0;
      color: var(--muted);
      font-size: 0.68rem;
      min-height: 18px;
    }

    .stack { display: grid; gap: 8px; overflow: visible; }

    .exam-card {
      background: #fff;
      border: 1px solid var(--border);
      border-radius: 10px;
      box-shadow: 0 4px 14px rgba(15, 45, 50, 0.07);
      overflow: visible;
    }

    .exam-summary {
      list-style: none;
      position: relative;
      display: flex;
      align-items: center;
      flex-wrap: wrap;
      gap: 6px;
      align-items: center;
      padding: 11px 12px;
      padding-right: 48px;
      margin: 0;
      cursor: pointer;
    }
    .exam-summary::-webkit-details-marker { display: none; }
    .exam-summary:hover { background: #f8fbfc; }

    .exam-title {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      min-width: 0;
    }
    .exam-title strong {
      font-size: 0.76rem;
      color: var(--primary);
      line-height: 1.2;
      white-space: nowrap;
    }
    .exam-title span {
      font-size: 0.66rem;
      color: var(--muted);
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .exam-pill {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: auto;
      min-width: 0;
      padding: 1px 7px;
      border-radius: 999px;
      background: var(--primary-soft);
      color: var(--primary);
      border: 1px solid color-mix(in srgb, var(--primary) 28%, #ffffff);
      font-size: 0.62rem;
      font-weight: 700;
      white-space: nowrap;
    }

    .exam-pill.review-pending {
      background: #fff7ed;
      border-color: #fed7aa;
      color: #9a3412;
    }

    .exam-pill.review-approved {
      background: #ecfdf5;
      border-color: #bbf7d0;
      color: #166534;
    }

    .exam-pill.review-rejected {
      background: #fef2f2;
      border-color: #fecaca;
      color: #991b1b;
    }

    .exam-updated {
      font-size: 0.64rem;
      color: var(--muted);
      white-space: nowrap;
    }

    .exam-questions {
      border-top: 1px solid #e8eef3;
      padding: 10px 12px 11px;
      display: grid;
      gap: 8px;
    }

    .exam-summary-actions {
      display: inline-flex;
      gap: 6px;
      align-items: center;
      flex-wrap: wrap;
    }

    .set-actions-menu {
      position: absolute;
      right: 10px;
      top: 8px;
      margin-left: 0;
      z-index: 200;
    }

    .set-actions-trigger {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-width: 30px;
      height: 24px;
      border-radius: 8px;
      border: 1px solid color-mix(in srgb, var(--primary) 26%, #ffffff);
      color: var(--primary);
      text-decoration: none;
      font-size: 13px;
      font-weight: 700;
      line-height: 1;
      background: var(--primary-soft);
      cursor: pointer;
      padding: 0 6px;
    }

    .set-actions-trigger:hover,
    .set-actions-trigger:focus-visible {
      border-color: var(--primary);
      color: var(--primary);
      outline: none;
    }

    .set-actions-dropdown {
      position: absolute;
      right: 0;
      top: auto;
      bottom: calc(100% + 8px);
      min-width: 150px;
      border: 1px solid #dbe5ec;
      border-radius: 10px;
      background: #fff;
      box-shadow: 0 12px 24px rgba(15, 45, 50, 0.14);
      padding: 6px;
      display: none;
      z-index: 9999;
    }

    .set-actions-menu.open .set-actions-dropdown {
      display: grid;
      gap: 4px;
    }

    .set-action-link {
      display: block;
      color: #0f172a;
      text-decoration: none;
      font-size: 0.7rem;
      font-weight: 600;
      padding: 6px 8px;
      border-radius: 8px;
      border: 1px solid transparent;
    }

    .set-action-link:hover,
    .set-action-link:focus-visible {
      border-color: color-mix(in srgb, var(--primary) 24%, #ffffff);
      background: var(--primary-soft);
      outline: none;
      text-decoration: none;
    }

    .set-action-link.is-disabled {
      pointer-events: none;
      opacity: 0.55;
    }

    .question-row {
      border: 1px solid #e6edf2;
      border-radius: 8px;
      padding: 7px 8px;
      background: #fbfdfe;
    }

    .question-meta {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      margin-bottom: 4px;
      font-size: 0.62rem;
      color: #4f6773;
    }

    .question-text {
      margin: 0;
      font-size: 0.72rem;
      line-height: 1.45;
      color: #122f3a;
    }

    .empty-state {
      text-align: center;
      background: #fff;
      border: 1px dashed #c7d5de;
      border-radius: 10px;
      padding: 20px 12px;
      color: #5d7480;
      font-size: 0.72rem;
    }

    .reuse-modal-overlay {
      position: fixed;
      inset: 0;
      background: rgba(15, 23, 42, 0.45);
      display: none;
      align-items: center;
      justify-content: center;
      z-index: 900;
      padding: 12px;
    }

    .reuse-modal-overlay.show {
      display: flex;
    }

    .reuse-modal {
      width: 100%;
      max-width: 760px;
      background: #fff;
      border-radius: 12px;
      border: 1px solid var(--border);
      padding: 14px;
      max-height: 90vh;
      overflow: auto;
    }

    .reuse-modal-title {
      margin: 0 0 10px;
      color: #102f39;
      font-size: 1rem;
    }

    .reuse-source {
      margin: 0 0 8px;
      color: #475569;
      font-size: 0.7rem;
    }

    .students-modal-overlay {
      position: fixed;
      inset: 0;
      background: rgba(15, 23, 42, 0.45);
      display: none;
      align-items: center;
      justify-content: center;
      z-index: 10040;
      padding: 12px;
    }

    .students-modal-overlay.show {
      display: flex;
    }

    .students-modal {
      width: 100%;
      max-width: 900px;
      background: #fff;
      border-radius: 12px;
      border: 1px solid var(--border);
      padding: 14px;
      max-height: 90vh;
      overflow: auto;
      display: grid;
      gap: 10px;
    }

    .students-modal-header {
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      gap: 10px;
    }

    .students-modal-title {
      margin: 0;
      color: #102f39;
      font-size: 0.96rem;
    }

    .students-modal-subtitle {
      margin: 2px 0 0;
      color: #607080;
      font-size: 0.72rem;
    }

    .students-modal-close {
      border: 1px solid #cbd5e1;
      background: #fff;
      color: #334155;
      border-radius: 8px;
      padding: 5px 8px;
      font-size: 0.72rem;
      font-weight: 700;
      cursor: pointer;
    }

    .students-summary {
      display: flex;
      flex-wrap: wrap;
      gap: 6px;
      align-items: center;
    }

    .students-toolbar {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
      gap: 8px;
    }

    .students-table-wrap {
      border: 1px solid #dbe5ec;
      border-radius: 10px;
      overflow: auto;
      background: #fff;
    }

    .students-table {
      width: 100%;
      border-collapse: collapse;
      font-size: 0.72rem;
    }

    .students-table th,
    .students-table td {
      padding: 8px;
      border-bottom: 1px solid #ecf1f5;
      text-align: left;
      vertical-align: middle;
    }

    .students-table th {
      background: #f8fbfc;
      color: #3b5563;
      font-weight: 700;
      font-size: 0.68rem;
      letter-spacing: 0.02em;
      text-transform: uppercase;
    }

    .students-table tr:last-child td {
      border-bottom: none;
    }

    .time-cell {
      white-space: nowrap;
    }

    .student-name {
      font-weight: 700;
      color: #0f2d32;
    }

    .student-subtle {
      color: #607080;
      font-size: 0.66rem;
    }

    .students-modal .btn.is-disabled,
    .students-modal .btn:disabled {
      opacity: 0.55;
      cursor: not-allowed;
      pointer-events: none;
    }

    .students-status {
      margin: 0;
      color: #607080;
      font-size: 0.68rem;
      min-height: 16px;
    }

    .question-modal-overlay {
      position: fixed;
      inset: 0;
      background: rgba(10, 20, 30, 0.55);
      backdrop-filter: blur(3px);
      display: none;
      z-index: 10000;
      animation: fadeIn 0.2s ease;
    }

    .question-modal-overlay.show {
      display: flex;
    }

    .question-modal {
      position: fixed;
      top: 0;
      right: 0;
      width: 100%;
      max-width: 1120px;
      height: 100dvh;
      background: #f8fafc;
      display: flex;
      flex-direction: column;
      box-shadow: -8px 0 40px rgba(0,0,0,0.18);
      animation: slideInRight 0.28s cubic-bezier(0.22, 1, 0.36, 1);
      overflow: hidden;
    }

    @keyframes slideInRight {
      from { transform: translateX(100%); opacity: 0; }
      to   { transform: translateX(0);    opacity: 1; }
    }

    @keyframes fadeIn {
      from { opacity: 0; }
      to   { opacity: 1; }
    }

    .qm-topbar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: calc(16px + env(safe-area-inset-top, 0px)) 24px 16px;
      background: #fff;
      border-bottom: 1px solid #e2e8f0;
      flex-shrink: 0;
      gap: 12px;
    }

    .qm-topbar-left {
      display: flex;
      align-items: center;
      gap: 12px;
    }

    .qm-topbar-right {
      display: flex;
      align-items: center;
      gap: 10px;
      flex-shrink: 0;
    }

    .qm-upload-btn {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      border: 1.5px solid #0f5a66;
      background: #f0fafb;
      color: #0f5a66;
      border-radius: 8px;
      padding: 8px 14px;
      font-size: 0.82rem;
      font-weight: 700;
      cursor: pointer;
      transition: all 0.15s;
      white-space: nowrap;
    }

    .qm-upload-btn:hover {
      background: #0f5a66;
      color: #fff;
    }

    .qm-upload-btn:disabled {
      opacity: 0.5;
      cursor: not-allowed;
    }

    .qm-upload-btn .qm-spinner {
      width: 14px;
      height: 14px;
      border: 2px solid rgba(15, 90, 102, 0.3);
      border-top-color: #0f5a66;
      border-radius: 50%;
      animation: qmSpin 0.7s linear infinite;
      flex-shrink: 0;
    }

    .qm-upload-btn:hover .qm-spinner,
    .qm-upload-btn.loading .qm-spinner {
      border-color: rgba(255, 255, 255, 0.35);
      border-top-color: #fff;
    }

    @keyframes qmSpin {
      to { transform: rotate(360deg); }
    }

    .qm-topbar-icon {
      width: 40px;
      height: 40px;
      background: linear-gradient(135deg, #0f5a66 0%, #1a8fa0 100%);
      border-radius: 10px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 18px;
      flex-shrink: 0;
    }

    .qm-topbar-title {
      margin: 0;
      font-size: 1.05rem;
      font-weight: 700;
      color: #0f2d32;
    }

    .qm-topbar-sub {
      margin: 0;
      font-size: 0.78rem;
      color: #64748b;
    }

    .qm-close-btn {
      width: 36px;
      height: 36px;
      border-radius: 8px;
      border: 1px solid #e2e8f0;
      background: #fff;
      color: #64748b;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: all 0.15s;
      flex-shrink: 0;
    }

    .qm-close-btn:hover {
      background: #fef2f2;
      border-color: #fca5a5;
      color: #dc2626;
    }

    .qm-body {
      flex: 1;
      overflow-y: auto;
      padding: 20px 24px;
      display: flex;
      flex-direction: column;
      gap: 16px;
    }

    .qm-draft-banner {
      display: flex;
      align-items: center;
      justify-content: flex-start;
      background: #fffbeb;
      border: 1px solid #fcd34d;
      border-radius: 10px;
      padding: 10px 14px;
      font-size: 0.84rem;
      color: #92400e;
      gap: 10px;
    }

    .qm-section {
      background: #fff;
      border: 1px solid #e2e8f0;
      border-radius: 14px;
      padding: 18px;
    }

    .qm-section-label {
      font-size: 0.68rem;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: #64748b;
      margin: 0 0 12px;
    }

    .qm-grid-2 {
      display: grid;
      grid-template-columns: 1fr 1fr 1fr;
      gap: 10px;
    }

    .qm-full { grid-column: 1 / -1; }

    .qm-field {
      display: flex;
      flex-direction: column;
      gap: 5px;
    }

    .qm-field.is-hidden {
      display: none;
    }

    .qm-field label {
      font-size: 0.76rem;
      font-weight: 800;
      color: #1e3a42;
      letter-spacing: 0.025em;
      text-transform: uppercase;
    }

    .qm-field input,
    .qm-field select,
    .qm-field textarea {
      border: 1.5px solid #e2e8f0;
      border-radius: 9px;
      padding: 9px 11px;
      font-size: 0.875rem;
      font-family: inherit;
      color: #0f172a;
      background: #fff;
      transition: border-color 0.15s, box-shadow 0.15s;
      width: 100%;
    }

    .qm-field input:focus,
    .qm-field select:focus,
    .qm-field textarea:focus {
      outline: none;
      border-color: #0f5a66;
      box-shadow: 0 0 0 3px rgba(15, 90, 102, 0.1);
    }

    .qm-rules-box {
      background: linear-gradient(135deg, #f0fafb 0%, #e6f4f6 100%);
      border: 1px solid #a5d8dd;
      border-left: 4px solid #0f5a66;
      border-radius: 10px;
      padding: 12px 16px;
      font-size: 0.8rem;
      color: #0f4a54;
      line-height: 1.6;
      display: none;
    }

    .qm-question-count {
      font-size: 0.78rem;
      font-weight: 700;
      background: #f1f5f9;
      color: #475569;
      padding: 3px 10px;
      border-radius: 999px;
    }

    .qm-question-header-actions {
      display: inline-flex;
      align-items: center;
      gap: 8px;
    }

    .qm-preview-trigger {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      border: 1px solid #cbd5e1;
      background: #fff;
      color: #334155;
      border-radius: 999px;
      min-height: 28px;
      padding: 0 12px;
      font-size: 0.74rem;
      font-weight: 800;
      letter-spacing: 0.04em;
      text-transform: uppercase;
      cursor: pointer;
    }

    .qm-preview-trigger:hover {
      border-color: #0f5a66;
      color: #0f5a66;
      background: #f0fafb;
    }

    #question-items {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 10px;
    }

    .qm-question-card {
      background: #fff;
      border: 1.5px solid #e2e8f0;
      border-radius: 12px;
      overflow: hidden;
      margin-bottom: 0;
      transition: border-color 0.15s, box-shadow 0.15s;
    }

    .qm-question-card:focus-within {
      border-color: #0f5a66;
      box-shadow: 0 0 0 3px rgba(15, 90, 102, 0.08);
    }

    .qm-question-card-header {
      display: flex;
      align-items: center;
      gap: 8px;
      padding: 9px 12px;
      background: #f8fafc;
      border-bottom: 1px solid #e2e8f0;
    }

    .qm-question-header-fields {
      display: flex;
      gap: 10px;
      flex: 1;
      align-items: flex-end;
    }

    .qm-question-badge {
      width: 28px;
      height: 28px;
      border-radius: 7px;
      background: linear-gradient(135deg, #0f5a66, #1a8fa0);
      color: #fff;
      font-size: 0.68rem;
      font-weight: 900;
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
      letter-spacing: -0.01em;
    }

    .qm-remove-btn {
      width: 34px;
      height: 34px;
      border-radius: 8px;
      border: 1px solid #fecaca;
      background: #fff;
      color: #ef4444;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
      margin-bottom: 2px;
      transition: all 0.15s;
    }

    .qm-remove-btn:hover {
      background: #fef2f2;
      border-color: #ef4444;
    }

    .qm-question-card-body {
      padding: 10px 12px;
      display: flex;
      flex-direction: column;
      gap: 8px;
    }

    .qm-question-card .qm-field input,
    .qm-question-card .qm-field select,
    .qm-question-card .qm-field textarea {
      padding: 7px 10px;
      font-size: 0.82rem;
    }

    .qm-question-card .qm-field label {
      font-size: 0.72rem;
      font-weight: 700;
      letter-spacing: 0.02em;
      color: #334155;
    }

    .qm-question-text-head {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 8px;
    }

    .qm-question-text-head > label {
      margin: 0;
    }

    .qm-question-text-editor-wrap {
      border: 1.5px solid #e2e8f0;
      border-radius: 9px;
      background: #fff;
      overflow: hidden;
    }

    .qm-question-text-toolbar {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 0;
      flex-wrap: nowrap;
    }

    .qm-text-tool-btn {
      width: 26px;
      height: 26px;
      border: 1px solid #cbd5e1;
      border-radius: 6px;
      background: #fff;
      color: #334155;
      font-size: 0.78rem;
      font-weight: 700;
      cursor: pointer;
      line-height: 1;
      padding: 0;
    }

    .qm-text-tool-btn[data-format-cmd="italic"] {
      font-style: italic;
      font-family: "Georgia", "Times New Roman", serif;
      font-weight: 700;
    }

    .qm-text-tool-btn:hover {
      border-color: #0f5a66;
      color: #0f5a66;
      background: #f0fafb;
    }

    .qm-text-color-wrap {
      width: 26px;
      height: 26px;
      border: 1px solid #cbd5e1;
      border-radius: 6px;
      overflow: hidden;
      cursor: pointer;
      background: #fff;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
    }

    .qm-text-color {
      width: 100%;
      height: 100%;
      border: none;
      padding: 0;
      cursor: pointer;
      background: transparent;
      appearance: none;
      -webkit-appearance: none;
    }

    .qm-text-color::-webkit-color-swatch-wrapper {
      padding: 0;
    }

    .qm-text-color::-webkit-color-swatch {
      border: none;
      border-radius: 0;
    }

    .qm-text-color::-moz-color-swatch {
      border: none;
      border-radius: 0;
    }

    .question-text-editor {
      min-height: 54px;
      max-height: 120px;
      padding: 8px 10px;
      font-size: 0.82rem;
      color: #0f172a;
      line-height: 1.35;
      outline: none;
      overflow-wrap: break-word;
      white-space: pre-wrap;
      overflow-y: auto;
    }

    .question-text-editor:empty:before {
      content: attr(data-placeholder);
      color: #94a3b8;
      pointer-events: none;
    }

    .question-text {
      display: none;
    }

    .question-options-list {
      display: flex;
      flex-direction: column;
      gap: 6px;
    }

    .question-option-row {
      display: flex;
      gap: 6px;
      align-items: center;
    }

    .question-answer-list {
      display: flex;
      flex-direction: column;
      gap: 6px;
    }

    .question-answer-row {
      display: flex;
      gap: 6px;
      align-items: center;
    }

    .question-option-remove {
      width: 24px;
      height: 24px;
      border-radius: 6px;
      border: 1px solid #e2e8f0;
      background: #fff;
      color: #64748b;
      font-size: 0.8rem;
      font-weight: 700;
      cursor: pointer;
      line-height: 1;
      flex-shrink: 0;
    }

    .question-option-remove:hover {
      border-color: #fca5a5;
      color: #dc2626;
      background: #fff5f5;
    }

    .question-option-input[readonly] {
      background: #f1f5f9;
      color: #334155;
      cursor: not-allowed;
    }

    .qm-option-add-btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 24px;
      height: 24px;
      border-radius: 999px;
      border: 1px solid #94a3b8;
      background: #fff;
      color: #334155;
      font-size: 0.95rem;
      font-weight: 800;
      cursor: pointer;
      line-height: 1;
      padding: 0;
    }

    .qm-option-add-btn:hover {
      border-color: #0f5a66;
      color: #0f5a66;
      background: #f0fafb;
    }

    .qm-answer-add-btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 24px;
      height: 24px;
      border-radius: 999px;
      border: 1px solid #94a3b8;
      background: #fff;
      color: #334155;
      font-size: 0.95rem;
      font-weight: 800;
      cursor: pointer;
      line-height: 1;
      padding: 0;
    }

    .qm-answer-add-btn:hover {
      border-color: #0f5a66;
      color: #0f5a66;
      background: #f0fafb;
    }

    .qm-footer {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 12px 20px;
      background: #fff;
      border-top: 1px solid #e2e8f0;
      flex-shrink: 0;
      gap: 10px;
    }

    .qm-footer-right {
      display: flex;
      gap: 8px;
      align-items: center;
    }

    .qm-btn-ghost,
    .qm-btn-clear,
    .qm-btn-save {
      min-height: 36px;
      min-width: 138px;
      justify-content: center;
    }

    .qm-btn-ghost {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      border: 1.5px dashed #94a3b8;
      background: transparent;
      color: #334155;
      border-radius: 8px;
      padding: 8px 14px;
      font-size: 0.82rem;
      font-weight: 700;
      cursor: pointer;
      transition: all 0.15s;
      letter-spacing: 0.01em;
    }

    .qm-btn-ghost:hover {
      border-color: #0f5a66;
      color: #0f5a66;
      background: #f0fafb;
    }

    .qm-btn-ghost:disabled {
      opacity: 0.45;
      cursor: not-allowed;
    }

    .qm-btn-clear {
      display: inline-flex;
      align-items: center;
      gap: 5px;
      border: 1.5px solid #e2e8f0;
      background: #f8fafc;
      color: #64748b;
      border-radius: 8px;
      padding: 8px 14px;
      font-size: 0.82rem;
      font-weight: 700;
      cursor: pointer;
      transition: all 0.15s;
    }

    .qm-btn-clear:hover {
      border-color: #fca5a5;
      color: #dc2626;
      background: #fff;
    }

    .qm-btn-save {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      background: linear-gradient(135deg, #0f5a66 0%, #1a8fa0 100%);
      color: #fff;
      border: none;
      border-radius: 8px;
      padding: 9px 20px;
      font-size: 0.85rem;
      font-weight: 800;
      cursor: pointer;
      transition: opacity 0.15s, transform 0.1s;
      box-shadow: 0 2px 10px rgba(15,90,102,0.3);
      letter-spacing: 0.01em;
    }

    .qm-btn-save:hover { opacity: 0.9; transform: translateY(-1px); }
    .qm-btn-save:active { transform: translateY(0); }
    .qm-btn-save:disabled {
      opacity: 0.45;
      cursor: not-allowed;
      transform: none;
    }

    #question-modal-status {
      margin: 0;
      padding: 6px 20px 10px;
      font-size: 0.76rem;
      font-weight: 600;
      color: #64748b;
      background: #fff;
      text-align: center;
      flex-shrink: 0;
    }

    .qm-preview-overlay {
      position: fixed;
      inset: 0;
      background: rgba(10, 20, 30, 0.48);
      display: none;
      align-items: center;
      justify-content: center;
      z-index: 10100;
      padding: 16px;
    }

    .qm-preview-overlay.show {
      display: flex;
    }

    .qm-preview-panel {
      width: min(980px, 96vw);
      max-height: calc(100dvh - 32px);
      background: #fff;
      border: 1px solid #dbe4ee;
      border-radius: 14px;
      overflow: hidden;
      display: flex;
      flex-direction: column;
      box-shadow: 0 16px 44px rgba(15, 23, 42, 0.24);
    }

    .qm-preview-topbar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 12px 16px;
      border-bottom: 1px solid #e2e8f0;
      background: #f8fafc;
    }

    .qm-preview-actions {
      display: inline-flex;
      align-items: center;
      gap: 8px;
    }

    .qm-preview-print {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-height: 32px;
      padding: 0 12px;
      border-radius: 8px;
      border: 1px solid #cbd5e1;
      background: #fff;
      color: #334155;
      font-size: 0.78rem;
      font-weight: 800;
      letter-spacing: 0.03em;
      text-transform: uppercase;
      cursor: pointer;
    }

    .qm-preview-print:hover {
      border-color: #0f5a66;
      color: #0f5a66;
      background: #f0fafb;
    }

    .qm-preview-title {
      margin: 0;
      font-size: 0.95rem;
      color: #0f2d32;
      font-weight: 800;
    }

    .qm-preview-close {
      width: 32px;
      height: 32px;
      border-radius: 8px;
      border: 1px solid #d5dde7;
      background: #fff;
      color: #475569;
      cursor: pointer;
      font-size: 1.15rem;
      line-height: 1;
    }

    .qm-preview-body {
      overflow-y: auto;
      padding: 14px 16px 18px;
      display: grid;
      gap: 12px;
      background: #f8fafc;
    }

    .qm-preview-context {
      background: #fff;
      border: 1px solid #e2e8f0;
      border-radius: 10px;
      padding: 10px 12px;
      font-size: 0.82rem;
      color: #334155;
      line-height: 1.45;
    }

    .qm-preview-card {
      background: #fff;
      border: 1px solid #e2e8f0;
      border-radius: 12px;
      padding: 12px;
      display: grid;
      gap: 8px;
    }

    .qm-preview-qmeta {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 10px;
      font-size: 0.78rem;
      color: #475569;
      font-weight: 700;
    }

    .qm-preview-qtext {
      font-size: 0.9rem;
      color: #0f172a;
      line-height: 1.45;
    }

    .qm-preview-options {
      list-style: none;
      margin: 0;
      padding: 0;
      display: grid;
      gap: 6px;
      font-size: 0.84rem;
      color: #334155;
    }

    .qm-preview-answer {
      font-size: 0.78rem;
      color: #64748b;
    }

    .question-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 8px;
    }

    .question-grid .full {
      grid-column: 1 / -1;
    }

    .question-list-item {
      border: 1px solid var(--border);
      border-radius: 10px;
      padding: 8px;
      margin-top: 8px;
    }

    @media (min-width: 1200px) {
      body { font-size: 16.8px; }
      .top-bar h1 { font-size: 1.34rem; }
      .btn {
        font-size: 0.9rem;
        padding: 8px 14px;
        min-height: 38px;
      }
      .helper-text { font-size: 0.9rem; }
      .section-title { font-size: 0.98rem; }
      .collapsible-hint { font-size: 0.8rem; }
      .field-group label { font-size: 0.8rem; }
      .field-group input,
      .field-group select {
        font-size: 0.88rem;
        min-height: 38px;
      }
      .text-link-control {
        font-size: 0.84rem;
        min-height: 38px;
      }
      .exam-title strong { font-size: 0.94rem; }
      .exam-title span { font-size: 0.82rem; }
      .exam-pill { font-size: 0.78rem; }
      .exam-updated { font-size: 0.8rem; }
      .set-actions-trigger {
        min-width: 38px;
        height: 32px;
        font-size: 16px;
      }
      .set-action-link { font-size: 0.86rem; }
      .question-meta { font-size: 0.78rem; }
      .question-text { font-size: 0.88rem; }
      .status-text { font-size: 0.82rem; }
      .empty-state { font-size: 0.86rem; }
    }

    @media (min-width: 1500px) {
      body { font-size: 17.4px; }
      .top-bar h1 { font-size: 1.42rem; }
      .btn { font-size: 0.96rem; }
      .section-title { font-size: 1.04rem; }
      .exam-title strong { font-size: 1rem; }
      .exam-title span,
      .exam-updated { font-size: 0.86rem; }
      .exam-pill { font-size: 0.82rem; }
      .question-meta { font-size: 0.82rem; }
      .question-text { font-size: 0.94rem; }
    }

    @media (max-width: 860px) {
      .page-wrap { padding: 12px 10px 18px; }
      .top-bar h1 { font-size: 0.92rem; }
      .btn { font-size: 0.64rem; padding: 4px 7px; }
      .helper-text { font-size: 0.7rem; }
      .section-title { font-size: 0.76rem; }
      .field-group label { font-size: 0.6rem; }
      .field-group input,
      .field-group select {
        font-size: 0.68rem;
        min-height: 28px;
      }
      .text-link-control {
        min-height: 28px;
        font-size: 0.66rem;
      }
      .exam-title strong { font-size: 0.72rem; }
      .exam-title span,
      .exam-updated { font-size: 0.62rem; }
      .exam-pill { font-size: 0.6rem; }
      .question-meta { font-size: 0.58rem; }
      .question-text { font-size: 0.68rem; }
      .set-action-link { font-size: 0.66rem; }
      .grid-two { grid-template-columns: 1fr; }
      .workspace-inline { grid-template-columns: 1fr; }
      .collapsible-summary {
        align-items: flex-start;
      }
      .collapsible-hint {
        margin-top: 2px;
      }
      .exam-summary {
        gap: 5px;
        align-items: flex-start;
        padding-right: 44px;
      }
      .exam-pill {
        min-width: 0;
      }
      .exam-summary-actions {
        width: 100%;
        justify-content: flex-start;
        flex-wrap: wrap;
      }
      .set-actions-menu {
        right: 8px;
        top: 8px;
      }
    }

    @media (max-width: 640px) {
      .question-modal {
        max-width: 100%;
      }
      .top-bar-actions .btn {
        min-height: 26px;
        padding: 4px 6px;
      }
      .qm-topbar-right {
        width: 100%;
        justify-content: flex-end;
      }
      .qm-upload-btn {
        padding: 7px 10px;
        font-size: 0.76rem;
      }
      .qm-grid-2 { grid-template-columns: 1fr; }
      #question-items { grid-template-columns: 1fr; }
      .qm-footer { flex-direction: column; align-items: stretch; }
      .qm-footer-right { justify-content: flex-end; }
      .set-actions-trigger {
        min-width: 28px;
        height: 22px;
        font-size: 12px;
      }

      .students-modal {
        max-width: 100%;
        padding: 10px;
      }

      .students-modal-overlay {
        align-items: flex-start;
        padding-top: calc(var(--header-height, 56px) + 14px);
      }

      .students-table {
        font-size: 0.68rem;
      }

      .students-table th,
      .students-table td {
        padding: 6px;
      }

      .students-modal-title {
        font-size: 0.88rem;
      }
    }

    @media (max-width: 420px) {
      .qm-grid-2 { grid-template-columns: 1fr; }
    }

    /* Final global scaling pass: larger desktop text, smaller mobile text */
    @media (min-width: 992px) {
      html { font-size: 112.5%; }
      body {
        font-size: 0.96rem !important;
        line-height: 1.45;
      }
    }

    @media (max-width: 768px) {
      html { font-size: 90.625%; }
      body {
        font-size: 0.86rem !important;
        line-height: 1.32;
      }
    }

    @media (max-width: 480px) {
      html { font-size: 84.375%; }
      body {
        font-size: 0.82rem !important;
        line-height: 1.3;
      }
    }
  </style>
</head>
<body>
  <div class="page-wrap">
    <div class="top-bar">
      <h1>Assessment Question Sets</h1>
      <div class="top-bar-actions">
        <button type="button" class="btn btn-outline" id="all-class-set-questions">Set Questions</button>
        <% if (canUseGoogleClassroom && canManageGoogleIntegration) { %>
          <button type="button" class="btn btn-google" id="all-class-sync-google">Sync Google</button>
        <% } %>
      </div>
    </div>

    <%- include('../partials/flash') %>

    <details class="form-card collapsible-card">
      <summary class="collapsible-summary">
        <div>
          <h2 class="section-title" style="margin-bottom:4px;">Term Filter</h2>
          <p class="helper-text" style="margin:0;">Current: <strong><%= selectedTermName || ('Term ' + termId) %></strong>. Choose a school year and term to update this workspace.</p>
        </div>
        <span class="collapsible-hint">Open</span>
      </summary>
      <div class="collapsible-content">
        <div class="workspace-inline">
          <div class="field-group">
            <label for="workspace-school-year">School Year</label>
            <select id="workspace-school-year"></select>
          </div>
          <div class="field-group">
            <label for="workspace-term">Term</label>
            <select id="workspace-term"></select>
          </div>
          <div class="row-actions">
            <a href="#" class="text-link-control" id="open-term-workspace">Apply Selection</a>
          </div>
        </div>
      </div>
    </details>

    <h2 class="section-title" style="margin-bottom:6px;">Created Question Sets</h2>
    <p class="helper-text" style="margin-top:0;">Sets are collapsed by default. Open a row to review details.</p>

    <% if (!questionSets || !questionSets.length) { %>
      <div class="empty-state">No question sets are available for this term.</div>
    <% } else { %>
      <div class="stack">
        <% questionSets.forEach(function(setItem) { %>
          <% const reviewStatusKey = String(setItem.review_status || 'pending').toLowerCase(); %>
          <details class="exam-card js-question-set-details">
            <summary class="exam-summary">
              <div class="exam-title" title="<%= setItem.set_title %>">
                <strong>Question Set</strong>
                <span><%= setItem.class_name %> • <%= setItem.subject_name %> • <%= setItem.assessment_title %></span>
              </div>
              <span class="exam-pill"><%= setItem.question_count %> question<%= Number(setItem.question_count) === 1 ? '' : 's' %></span>
              <span class="exam-pill"><%= setItem.total_points %> pts</span>
              <span class="exam-pill"><%= setItem.open_book ? 'Open Book' : 'Secure' %></span>
              <% if (setItem.time_limit_minutes && Number(setItem.time_limit_minutes) > 0) { %>
                <span class="exam-pill"><%= Number(setItem.time_limit_minutes) %> min</span>
              <% } %>
              <div class="exam-summary-actions">
                <span class="exam-pill review-<%= reviewStatusKey %>">Review: <%= (setItem.review_status || 'pending').toUpperCase() %></span>
                <span class="exam-updated">Updated: <%= setItem.updated_at ? new Date(setItem.updated_at).toLocaleString() : '-' %></span>
                <div class="set-actions-menu">
                  <a href="#" class="set-actions-trigger" aria-haspopup="true" aria-expanded="false" title="More actions">...</a>
                  <div class="set-actions-dropdown" role="menu">
                    <% if ((setItem.review_status || '').toLowerCase() === 'pending') { %>
                      <a
                        href="#"
                        class="set-action-link review-set-btn"
                        data-question-set-id="<%= setItem.question_set_id %>"
                        data-review-action="approve"
                      >Approve</a>
                      <a
                        href="#"
                        class="set-action-link review-set-btn"
                        data-question-set-id="<%= setItem.question_set_id %>"
                        data-review-action="reject"
                      >Reject</a>
                    <% } %>
                    <a
                      href="#"
                      class="set-action-link students-set-btn"
                      data-question-set-id="<%= setItem.question_set_id %>"
                      data-set-title="<%= String(setItem.set_title || '').replace(/"/g, '&quot;') %>"
                    >Students</a>
                    <a
                      href="#"
                      class="set-action-link edit-set-btn"
                      data-question-set-id="<%= setItem.question_set_id %>"
                      data-assessment-id="<%= setItem.assessment_id %>"
                      data-class-id="<%= setItem.class_id %>"
                      data-subject-id="<%= setItem.subject_id %>"
                      data-term-id="<%= termId %>"
                      data-school-year-id="<%= selectedSchoolYearId %>"
                    >Edit</a>
                    <a
                      href="#"
                      class="set-action-link reuse-set-btn"
                      data-question-set-id="<%= setItem.question_set_id %>"
                      data-set-title="<%= String(setItem.set_title || '').replace(/"/g, '&quot;') %>"
                      data-assessment-title="<%= String(setItem.assessment_title || '').replace(/"/g, '&quot;') %>"
                    >Reuse</a>
                    <a
                      href="#"
                      class="set-action-link delete-set-btn"
                      data-question-set-id="<%= setItem.question_set_id %>"
                      data-set-title="<%= String(setItem.set_title || '').replace(/"/g, '&quot;') %>"
                    >Delete</a>
                  </div>
                </div>
              </div>
            </summary>
            <div class="exam-questions">
              <% if (setItem.set_description) { %>
                <p class="helper-text" style="margin:0;"><strong>Description:</strong> <%= setItem.set_description %></p>
              <% } %>
              <p class="helper-text" style="margin:0;">
                <strong>Review Status:</strong> <%= (setItem.review_status || 'pending').toUpperCase() %>
                <% if (setItem.reviewed_by_name) { %>
                  • <strong>Reviewed By:</strong> <%= setItem.reviewed_by_name %>
                <% } %>
                <% if (setItem.reviewed_at) { %>
                  • <strong>Reviewed At:</strong> <%= new Date(setItem.reviewed_at).toLocaleString() %>
                <% } %>
              </p>
              <% if (setItem.review_note) { %>
                <p class="helper-text" style="margin:0;"><strong>Review Note:</strong> <%= setItem.review_note %></p>
              <% } %>
              <% if (!setItem.questions || !setItem.questions.length) { %>
                <div class="question-row">
                  <p class="question-text">No questions found in this set.</p>
                </div>
              <% } %>
              <% (setItem.questions || []).forEach(function(question) { %>
                <div class="question-row">
                  <div class="question-meta">
                    <span>#<%= question.positionIndex || 0 %></span>
                    <span><%= question.questionType %></span>
                    <span><%= question.marks %> mark<%= Number(question.marks) === 1 ? '' : 's' %></span>
                  </div>
                  <p class="question-text"><%= question.questionText %></p>
                </div>
              <% }); %>
            </div>
          </details>
        <% }); %>
      </div>
    <% } %>
  </div>

