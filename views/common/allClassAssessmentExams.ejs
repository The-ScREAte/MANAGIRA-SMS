<!DOCTYPE html>
<html lang="en">
<head>
  <link rel="stylesheet" href="/css/globalScale.css">
  <meta charset="UTF-8">
  <meta name="viewport" content="<%= locals.viewportContent || 'width=device-width, initial-scale=1.0' %>">
  <title>Assessment Question Sets</title>
  <style>
  /* The questions page: a quiet header, one small Filters button after New questions. */
  .top-bar { position: relative; z-index: 200; }
  .top-bar.top-bar--end { justify-content: flex-end; }
  .ws-filters { position: relative; display: inline-block; }
  .ws-filters__btn { display: inline-flex; align-items: center; gap: 7px; height: 38px; padding: 0 14px; border: 1px solid color-mix(in srgb, currentColor 22%, transparent); border-radius: 9px; background: transparent; color: inherit; font-size: .86rem; font-weight: 600; cursor: pointer; list-style: none; white-space: nowrap; }
  .ws-filters__btn::-webkit-details-marker { display: none; }
  .ws-filters[open] > .ws-filters__btn { border-color: var(--org-primary-color, #01535b); color: var(--org-primary-color, #01535b); }
  .ws-filters[open] .ws-filters__chev { transform: rotate(180deg); }
  .ws-filters__pop { position: absolute; top: calc(100% + 8px); right: 0; z-index: 30; width: min(560px, 92vw); max-height: 70vh; overflow-y: auto; padding: 16px; border: 1px solid #e2e8f0; border-radius: 14px; background: #fff; box-shadow: 0 12px 32px rgba(15, 23, 42, .14); text-align: left; }
  .ws-filters__pop .filters-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; }
  .ws-filters--simple [data-simple-hide], .ws-filters--simple [data-class-hide] { display: none; }
  .ws-filters__pop .filter-actions { margin-top: 14px; }
  .top-bar-actions { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; overflow: visible !important; }
  .top-bar-actions #all-class-set-questions { height: 38px; padding: 0 16px; border: 1px solid var(--org-primary-color, #01535b); border-radius: 9px; background: var(--org-primary-color, #01535b); color: #fff; font-size: .86rem; font-weight: 600; }
  .top-bar-actions #all-class-set-questions:hover { filter: brightness(.94); }
  .qm-review-setting--foot { margin: 26px 0 0; opacity: .8; font-size: .8rem; }
  .subject-group-head { margin-bottom: 6px; }

  /* One way to post: a plain button. Posted: a quiet "Take back". */
  .post-grades-btn { flex: none; width: auto; margin: 0; padding: 5px 12px; border: 1px solid var(--primary, #01535b); border-radius: 8px; background: var(--primary, #01535b); color: #fff; font: inherit; font-size: 0.8rem; font-weight: 600; cursor: pointer; white-space: nowrap; }
  .post-grades-btn:hover { filter: brightness(0.94); }
  .post-grades-btn.is-on { background: transparent; color: #64748b; border-color: #cbd5e1; font-weight: 500; }
  .post-grades-btn:disabled { opacity: .6; cursor: default; }
  .to-mark-chip { flex: none; padding: 2px 9px; border-radius: 999px; background: color-mix(in srgb, #d97706 14%, transparent); color: #b45309; font-size: 0.74rem; font-weight: 700; white-space: nowrap; }
  .to-mark-note { margin: 0 0 10px; color: #64748b; font-size: 0.84rem; }
  .students-share-line { color: #64748b; font-size: 0.8rem; white-space: nowrap; }
  .students-remark { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; margin: 0 0 12px; }
  .students-remark select, .students-remark input { margin: 0; width: auto; min-width: 12rem; height: 34px; padding: 0 10px; font-size: 0.85rem; }
  .students-remark[hidden] { display: none; }
  .qbf-check { display: inline-flex; align-items: center; gap: 8px; font-weight: 500; cursor: pointer; }
  .qbf-shuffle-field { display: flex; flex-direction: column; align-items: flex-start; justify-content: flex-end; }
  .qbf-shuffle-field .qbf-check, .qbf-shuffle-field label { margin: 0 !important; }
  .qbf-shuffle-field .qbf-check { height: 34px; display: inline-flex; align-items: center; gap: 8px; justify-content: flex-start; text-transform: none; letter-spacing: 0; font-size: .86rem; white-space: nowrap; }
  .qbf-check input { width: 16px; height: 16px; margin: 0; }
  .qm-review-setting { display: inline-flex; align-items: center; gap: 8px; margin: 0 0 10px; font-size: 0.85rem; color: #475569; cursor: pointer; }
  .qm-review-setting input { width: 16px; height: 16px; margin: 0; }

    :root {
      --font-family: "<%= (session && session.fontStyle ? String(session.fontStyle).trim() : 'Inter') %>", sans-serif;
      --primary: var(--org-primary-color, #0f5a66);
      --primary-hover: var(--org-primary-hover, #0d4f59);
      --primary-soft: color-mix(in srgb, var(--primary) 12%, #ffffff);
      --border: #cedae3;
      --text: #0b1720;
      --muted: #415464;
      --surface: #eff4f9;
    }

    *, *::before, *::after { box-sizing: border-box; }
    body {
      margin: 0;
      font-family: var(--font-family);
      background:
        radial-gradient(1200px 520px at 8% -12%, #e0edf8 0%, rgba(224, 237, 248, 0) 62%),
        radial-gradient(1000px 440px at 94% -18%, #e8f6f8 0%, rgba(232, 246, 248, 0) 58%),
        linear-gradient(180deg, #f6f9fc 0%, #edf3f8 100%);
      color: var(--text);
      font-size: 14px;
      line-height: 1.35;
    }

    .page-wrap { max-width: none; width: 100%; margin: 0; padding: 14px 24px 20px; box-sizing: border-box; }
    .top-bar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 8px;
      margin-bottom: 12px;
    }
    .top-bar h1 { margin: 0; font-size: 1.08rem; color: #0f2d32; line-height: 1.2; }
    .top-bar-actions { display: inline-flex; flex-wrap: wrap; gap: 10px; }
    .top-bar-actions {
      display: flex;
      flex-wrap: nowrap;
      align-items: center;
      gap: 8px;
      overflow-x: auto;
      padding-bottom: 2px;
    }
    .top-bar-actions .btn {
      flex: 0 0 auto;
      width: auto;
      min-height: 30px;
      justify-content: center;
      text-align: center;
      padding: 5px 8px;
    }

    .btn {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      border-radius: 8px;
      border: none;
      text-decoration: none;
      font-size: 0.72rem;
      font-weight: 600;
      cursor: pointer;
      padding: 6px 10px;
      white-space: nowrap;
    }
    .btn-outline {
      background: #fff;
      color: var(--primary);
      border: 2px solid var(--primary);
    }
    

    .btn-google {
      background: #fff;
      color: #0b3a44;
      border: 2px solid #d3dde4;
    }
    

    .helper-text {
      margin: 0 0 10px;
      color: var(--muted);
      font-size: 0.74rem;
    }

    .grid-two {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 12px;
    }

    .form-card {
      background: linear-gradient(180deg, #ffffff 0%, #f9fcff 100%);
      border: 1px solid var(--border);
      border-radius: 10px;
      box-shadow: 0 8px 22px rgba(15, 45, 50, 0.08);
      padding: 10px;
      margin-bottom: 10px;
    }

    .collapsible-card {
      padding: 0;
      overflow: hidden;
    }

    .collapsible-summary {
      list-style: none;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 8px;
      padding: 12px 12px 10px;
      user-select: none;
      background: linear-gradient(180deg, #f8fbfd 0%, #f4f8fb 100%);
      transition: background 0.2s ease;
    }

    .workspace-filters-summary {
      align-items: center;
      flex-wrap: nowrap;
      overflow-x: auto;
    }

    .workspace-filters-main {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      flex-wrap: nowrap;
      min-width: 0;
    }

    .workspace-filters-title {
      margin: 0 !important;
      white-space: nowrap;
    }

    .workspace-filter-summary-line {
      margin: 0;
      flex-wrap: nowrap;
    }

    .workspace-filter-summary-line .current-pill {
      white-space: nowrap;
    }

    #workspace-filters-hint {
      margin-left: auto;
      flex: 0 0 auto;
    }

    

    .collapsible-card[open] .collapsible-summary {
      background: linear-gradient(180deg, #f1f7fb 0%, #ecf4f9 100%);
    }

    .collapsible-summary::-webkit-details-marker {
      display: none;
    }

    .collapsible-content {
      padding: 0 12px 12px;
      border-top: 1px solid #e2e8f0;
    }

    .filter-summary-line {
      margin: 2px 0 0;
      display: flex;
      align-items: center;
      gap: 8px;
      flex-wrap: wrap;
    }

    .current-pill {
      display: inline-flex;
      align-items: center;
      border: 1px solid #c9d7e1;
      border-radius: 999px;
      padding: 2px 8px;
      background: #f7fafc;
      color: #244753;
      font-size: 0.66rem;
      font-weight: 700;
      line-height: 1.2;
      letter-spacing: 0.01em;
    }

    .filter-panel {
      margin-top: 10px;
      display: grid;
      gap: 8px;
    }

    .filters-grid {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 8px;
      align-items: end;
    }

    .filter-actions {
      display: inline-flex;
      align-items: center;
      justify-content: flex-start;
      gap: 8px;
      flex-wrap: nowrap;
      width: auto;
      margin-top: 2px;
      margin-left: 0;
    }

    #workspace-filters-card .filter-actions {
      justify-self: start;
      align-self: start;
      width: auto !important;
      margin-left: 0 !important;
    }

    .filter-actions .btn {
      min-height: 25px;
      min-width: 78px;
      font-size: 0.6rem;
      line-height: 1;
      padding: 3px 8px;
    }

    #workspace-filters-card .filter-actions .btn {
      min-height: 24px !important;
      min-width: 72px !important;
      padding: 2px 7px !important;
      font-size: 0.58rem !important;
      line-height: 1 !important;
    }

    .text-link-control {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-height: 30px;
      padding: 7px 10px;
      border-radius: 8px;
      border: 1px solid #cbd5e1;
      background: #fff;
      color: #0f5a66;
      font-size: 0.7rem;
      font-weight: 700;
      text-decoration: none;
      white-space: nowrap;
    }

    .text-link-control:focus-visible {
      border-color: #0f5a66;
      text-decoration: none;
      outline: none;
    }

    .collapsible-hint {
      font-size: 0.66rem;
      font-weight: 700;
      color: #0f5a66;
      border: 1px solid #c8d8e2;
      background: #ffffff;
      border-radius: 999px;
      padding: 2px 8px;
      white-space: nowrap;
    }

    .section-title {
      margin: 0 0 8px;
      font-size: 0.8rem;
      color: var(--primary);
    }

    .field-group {
      display: grid;
      gap: 4px;
    }

    .field-group label {
      font-size: 0.64rem;
      font-weight: 700;
      color: #3b5563;
    }

    .field-group input,
    .field-group select {
      width: 100%;
      border: 1px solid #cddae3;
      background: #fff;
      border-radius: 8px;
      min-height: 30px;
      padding: 5px 8px;
      font: inherit;
      font-size: 0.72rem;
      color: #102f39;
    }

    .field-group input:focus,
    .field-group select:focus {
      outline: none;
      border-color: var(--primary);
      box-shadow: 0 0 0 2px rgba(15, 90, 102, 0.14);
    }

    .row-actions {
      margin-top: 8px;
      display: inline-flex;
      gap: 8px;
      flex-wrap: wrap;
    }

    .btn-primary {
      background: var(--primary);
      color: #fff;
    }
    

    .btn-secondary {
      background: #fff;
      color: #334155;
      border: 1px solid #cbd5e1;
    }
    

    .status-text {
      margin: 8px 0 0;
      color: var(--muted);
      font-size: 0.68rem;
      min-height: 18px;
    }

    .exam-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
      gap: 10px;
      overflow: visible;
      align-items: start;
    }

    .class-group {
      margin-bottom: 16px;
    }

    .class-group-head {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 10px;
      margin-bottom: 7px;
      flex-wrap: wrap;
    }

    .class-group-title {
      margin: 0;
      font-size: 0.84rem;
      color: #0f2d32;
      letter-spacing: 0.01em;
    }

    .class-group-meta {
      font-size: 0.66rem;
      color: #5f7381;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.05em;
    }

    .class-group-divider {
      border-bottom: 1px dashed #c8d6df;
      margin-bottom: 10px;
    }

    .subject-group {
      margin-bottom: 14px;
    }

    .subject-group-head {
      display: flex;
      align-items: center;
      justify-content: flex-start;
      gap: 8px;
      margin-bottom: 8px;
      padding-left: 2px;
      flex-wrap: wrap;
    }

    .subject-group-title {
      margin: 0;
      font-size: 0.7rem;
      font-weight: 700;
      color: #64748b;
      text-transform: uppercase;
      letter-spacing: 0.06em;
    }

    .subject-group-meta {
      display: inline-flex;
      align-items: center;
      font-size: 0.62rem;
      color: #94a3b8;
      font-weight: 600;
      text-transform: none;
      letter-spacing: 0.01em;
      background: #f1f5f9;
      border-radius: 999px;
      padding: 2px 8px;
    }

    .subject-group-assessment-inline {
      font-size: 0.62rem;
      font-weight: 600;
      color: #94a3b8;
      border-left: 1px solid #e2e8f0;
      padding-left: 8px;
      line-height: 1.3;
      text-transform: none;
      letter-spacing: 0.01em;
    }

    .assessment-group-list {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 8px;
      align-items: start;
    }

    @media (max-width: 640px) {
      .assessment-group-list {
        grid-template-columns: 1fr;
      }
    }

    .assessment-group {
      display: contents;
    }

    .assessment-group .exam-grid {
      display: contents;
    }

    /* Sets under one subject render together; the assessment name is already
       shown in each card's breadcrumb, so this sub-header is hidden. */
    .assessment-group-head {
      display: none;
    }

    .exam-card {
      background: #ffffff;
      border: 1px solid #e6eaef;
      border-left: 3px solid var(--primary);
      border-radius: 14px;
      box-shadow: 0 1px 2px rgba(15, 23, 42, 0.04);
      overflow: visible;
      min-height: 100%;
      width: 100%;
      transition: box-shadow 0.15s ease, border-color 0.15s ease;
    }

    .exam-card:hover {
      box-shadow: 0 4px 12px rgba(15, 23, 42, 0.07);}

    .exam-summary {
      list-style: none;
      position: relative;
      display: flex;
      flex-direction: column;
      gap: 8px;
      padding: 10px 12px;
      padding-right: 40px;
      margin: 0;
      cursor: pointer;
    }
    .exam-summary::-webkit-details-marker { display: none; }

    .exam-title {
      display: flex;
      flex-direction: row;
      align-items: baseline;
      flex-wrap: wrap;
      gap: 6px;
      min-width: 0;
    }
    .exam-title strong {
      font-size: 0.86rem;
      font-weight: 700;
      color: #0f172a;
      line-height: 1.25;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
      transition: color 0.15s ease;
    }
    
    .exam-title span {
      font-size: 0.68rem;
      color: #94a3b8;
      font-weight: 500;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .exam-pill {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 4px;
      width: auto;
      min-width: 0;
      padding: 3px 8px;
      border-radius: 6px;
      background: #f1f5f9;
      color: #475569;
      border: 1px solid transparent;
      font-size: 0.68rem;
      font-weight: 600;
      white-space: nowrap;
      line-height: 1.4;
    }

    .exam-pill svg {
      flex-shrink: 0;
      width: 11px;
      height: 11px;
      color: color-mix(in srgb, var(--primary) 55%, #94a3b8);
    }

    .exam-pill.status-chip {
      gap: 5px;
      padding: 3px 9px 3px 7px;
      font-weight: 700;
    }

    .exam-pill.status-chip svg {
      width: 12px;
      height: 12px;
    }

    .exam-pill.review-pending {
      background: #fffbeb;
      color: #92400e;
    }
    .exam-pill.review-pending svg { color: #b45309; }

    .exam-pill.review-approved {
      background: #ecfdf5;
      color: #166534;
    }
    .exam-pill.review-approved svg { color: #16a34a; }

    .exam-pill.review-rejected {
      background: #fef2f2;
      color: #991b1b;
    }
    .exam-pill.review-rejected svg { color: #dc2626; }

    .exam-updated {
      font-size: 0.62rem;
      color: #94a3b8;
      font-weight: 500;
      white-space: nowrap;
      cursor: default;
    }

    .exam-questions {
      border-top: 1px solid #eef1f5;
      padding: 10px 12px 11px;
      display: grid;
      gap: 8px;
    }

    .exam-summary-actions {
      display: flex;
      gap: 8px;
      align-items: center;
      flex-wrap: wrap;
      justify-content: space-between;
    }

    .exam-meta-row {
      display: flex;
      flex-direction: column;
      gap: 6px;
      width: 100%;
    }

    .exam-meta-line {
      display: flex;
      gap: 6px;
      align-items: center;
      flex-wrap: wrap;
    }

    .score-status-wrap {
      display: inline-flex;
      align-items: center;
      gap: 5px;
      padding: 0;
      border-radius: 0;
      border: none;
      background: transparent;
    }

    .score-status-dot {
      width: 7px;
      height: 7px;
      border-radius: 50%;
      background: #94a3b8;
      flex-shrink: 0;
    }

    .score-status-wrap.is-posted .score-status-dot {
      background: var(--primary);
    }

    .score-status-wrap .qm-answer-toggle-label {
      display: none;
    }

    .card-score-toggle-status {
      font-size: 0.64rem;
      font-weight: 600;
      color: #64748b;
      white-space: nowrap;
    }

    .score-status-wrap.is-posted .card-score-toggle-status {
      color: var(--primary);
    }

    .score-status-wrap .qm-answer-toggle {
      width: 26px;
      height: 15px;
    }

    .score-status-wrap .qm-answer-toggle.is-on {
      background: var(--primary);
      border-color: var(--primary);
    }

    .score-status-wrap .qm-answer-toggle-knob {
      top: 1px;
      left: 1px;
      width: 11px;
      height: 11px;
    }

    .score-status-wrap .qm-answer-toggle.is-on .qm-answer-toggle-knob {
      transform: translateX(11px);
    }

    .set-actions-menu {
      position: absolute;
      right: 10px;
      top: 10px;
      margin-left: 0;
      z-index: 200;
      opacity: 1;
      transition: opacity 0.12s ease;
    }

    .exam-card:hover .set-actions-menu,
    .set-actions-menu.open,
    .set-actions-trigger:focus-visible {
      opacity: 1;
    }

    .set-actions-trigger {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 24px;
      height: 24px;
      border-radius: 6px;
      border: 1px solid transparent;
      color: #94a3b8;
      text-decoration: none;
      line-height: 1;
      background: transparent;
      cursor: pointer;
      padding: 0;
    }

    .set-actions-trigger:focus-visible {
      background: #f1f5f9;
      color: #475569;
      outline: none;
    }

    .set-actions-dropdown {
      position: absolute;
      right: 0;
      top: auto;
      bottom: calc(100% + 8px);
      min-width: 150px;
      border: 1px solid #dbe5ec;
      border-radius: 10px;
      background: #fff;
      box-shadow: 0 12px 24px rgba(15, 45, 50, 0.14);
      padding: 6px;
      display: none;
      z-index: 9999;
    }

    .set-actions-menu.open { z-index: 300; }
    .set-actions-menu.drop-down .set-actions-dropdown { bottom: auto; top: calc(100% + 8px); }
    .set-actions-menu.open .set-actions-dropdown {
      display: grid;
      gap: 4px;
    }

    .set-action-link {
      display: block;
      color: #0f172a;
      text-decoration: none;
      font-size: 0.7rem;
      font-weight: 600;
      padding: 6px 8px;
      border-radius: 8px;
      border: 1px solid transparent;
    }

    .set-action-link:focus-visible {
      border-color: color-mix(in srgb, var(--primary) 24%, #ffffff);
      background: var(--primary-soft);
      outline: none;
      text-decoration: none;
    }

    .set-action-link.is-disabled {
      pointer-events: none;
      opacity: 0.55;
    }

    .question-row {
      border: 1px solid #e6edf2;
      border-radius: 8px;
      padding: 7px 8px;
      background: #fbfdfe;
    }

    .question-meta {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      margin-bottom: 4px;
      font-size: 0.62rem;
      color: #4f6773;
    }

    .exam-pill.exam-pill--warn { background: #fef3c7 !important; color: #92400e !important; border-color: #fcd34d !important; }
    .qm-bank { margin: 6px 0 4px; border: 1px solid #e2e8f0; border-radius: 10px; background: #fff; box-shadow: 0 10px 24px rgba(15, 23, 42, .1); overflow: hidden; }
