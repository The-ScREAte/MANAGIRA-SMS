      box-shadow: 0 0 0 3px rgba(15, 90, 102, 0.08);
    }

    .qm-question-card-header {
      display: flex;
      align-items: center;
      gap: 7px;
      padding: 8px 10px;
      background: #f8fafc;
      border-bottom: 1px solid #e2e8f0;
      flex-wrap: nowrap;
      overflow-x: auto;
    }

    .qm-question-header-fields {
      display: flex;
      gap: 7px;
      flex: 1;
      align-items: center;
      flex-wrap: nowrap;
      min-width: 0;
    }

    .qm-question-header-fields .qm-field {
      display: inline-flex;
      flex-direction: row;
      align-items: center;
      width: auto;
      min-width: 0;
      gap: 6px;
    }

    .qm-question-header-fields .qm-field > label {
