                </button>
              </div>
              <input type="hidden" id="qm-questions-layout-mode" value="stacked" />
              <span class="qm-question-count" id="qm-question-count">0 questions</span>
              <button type="button" class="qm-preview-trigger" id="qm-preview-open">Preview</button>
            </div>
