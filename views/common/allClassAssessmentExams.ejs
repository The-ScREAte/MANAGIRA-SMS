      padding: 0;
      cursor: pointer;
      background: transparent;
      appearance: none;
      -webkit-appearance: none;
    }

    .qm-text-color::-webkit-color-swatch-wrapper {
      padding: 0;
    }

    .qm-text-color::-webkit-color-swatch {
      border: none;
      border-radius: 0;
    }

    .qm-text-color::-moz-color-swatch {
