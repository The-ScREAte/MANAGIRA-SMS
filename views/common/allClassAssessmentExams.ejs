      function updateCardScoreToggleUI(wrap, postedCount, pendingCount) {
        var toggle = wrap.querySelector('.card-post-score-toggle');
        var statusEl = wrap.querySelector('.card-score-toggle-status');
        var isOn = postedCount > 0;
        var allPosted = isOn && pendingCount <= 0;
        wrap.setAttribute('data-posted-count', String(postedCount));
        wrap.setAttribute('data-pending-count', String(pendingCount));
        wrap.classList.toggle('is-posted', isOn);
        if (toggle) {
          toggle.classList.toggle('is-on', allPosted);
          toggle.textContent = allPosted ? 'Take back' : 'Post grades';
        }
        if (statusEl) {
          statusEl.textContent = !isOn ? 'Not posted' : (pendingCount > 0 ? 'Posted (' + pendingCount + ' new)' : 'Posted');
        }
      }

      document.querySelectorAll('.card-post-score-toggle').forEach(function (toggle) {
        toggle.addEventListener('click', async function (event) {
          event.preventDefault();
          event.stopPropagation();

          var wrap = toggle.closest('.card-score-toggle-wrap');
          if (!wrap) return;

          var questionSetId = Number(wrap.getAttribute('data-question-set-id') || 0);
          if (!questionSetId) return;

          var isCurrentlyOn = toggle.classList.contains('is-on');
          var postedCount = Number(wrap.getAttribute('data-posted-count') || 0);
          var pendingCount = Number(wrap.getAttribute('data-pending-count') || 0);

          if (isCurrentlyOn) {
            if (postedCount <= 0) return;
            var confirmedUnpost = await window.appConfirm('Take back ' + postedCount + ' grade(s)? Families will stop seeing them until you post again.');
            if (!confirmedUnpost) return;
          } else {
            if (pendingCount <= 0) return;
            var confirmedPost = await window.appConfirm('Post ' + pendingCount + ' grade(s)? ' + shareLine(wrap.getAttribute('data-share') || ''));
            if (!confirmedPost) return;
          }

          toggle.disabled = true;
          try {
            var endpoint = isCurrentlyOn
              ? '/common/assessment/questions/students/unpost-scores'
              : '/common/assessment/questions/students/post-scores';
            var response = await fetch(endpoint, {
              method: 'POST',
              headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
              body: JSON.stringify({ questionSetId: questionSetId }),
            });
            var result = await response.json();
            if (!response.ok || !result.success) {
              throw new Error(result.error || 'Failed to update score posting.');
            }

            var statusResponse = await fetch('/common/assessment/questions/students?questionSetId=' + encodeURIComponent(String(questionSetId)), {
              headers: { Accept: 'application/json' },
            });
            var statusPayload = await statusResponse.json();
            var summary = (statusPayload && statusPayload.summary) || {};
            var completedCount = Number(summary.completedCount || 0);
            var pendingPostCount = Number(summary.pendingPostCount || 0);
            var postedCountFresh = Math.max(completedCount - pendingPostCount, 0);

            updateCardScoreToggleUI(wrap, postedCountFresh, pendingPostCount);

            if (activeStudentsQuestionSetId === questionSetId) {
              await loadStudentsForQuestionSet(questionSetId);
            }
          } catch (error) {
            window.alert(error.message || 'Failed to update score posting.');
          } finally {
            toggle.disabled = false;
          }
        });
      });

