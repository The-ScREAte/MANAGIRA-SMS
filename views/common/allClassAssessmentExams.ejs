            </div>
          </div>
        </div>

        <div class="qm-rules-box" id="question-assessment-rules"></div>

        <div class="qm-section">
          <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:12px;">
            <p class="qm-section-label" style="margin:0;">Questions</p>
            <div class="qm-question-header-actions">
              <div class="qm-questions-layout-toggle" id="qm-questions-layout-toggle" role="group" aria-label="Questions layout">
                <button type="button" class="qm-options-layout-btn is-active" data-layout="stacked" aria-pressed="true" title="Stacked questions">
                  <span class="qm-layout-icon" aria-hidden="true"><span></span><span></span><span></span></span>
                </button>
                <button type="button" class="qm-options-layout-btn" data-layout="side_by_side" aria-pressed="false" title="Side-by-side questions">
