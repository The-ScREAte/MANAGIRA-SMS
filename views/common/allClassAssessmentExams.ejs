            maxAttempts: Number(assessment.max_attempts || 1),
            canEditScores: Boolean(assessment.can_edit_scores),
            accessReason: assessment.access_reason || '',
          }];
        })
      );

      function setQuestionStatus(message, isError) {
        if (!questionModalStatus) return;
        questionModalStatus.textContent = message || '';
        questionModalStatus.style.color = isError ? '#b91c1c' : '#0f5a66';
        // A problem with a setting (no assessment chosen, class, subject, time, attempts): open Settings.
        if (isError && window.QuestionBuilderFlow && /assessment|class|subject|term|time limit|attempt/i.test(String(message || ''))) window.QuestionBuilderFlow.settingsNeeded();
      }

      function syncQuestionTimeLimitUi() {
        if (!questionTimeModeSelect || !questionTimeLimitInput) return;
        var mode = String(questionTimeModeSelect.value || 'timed').toLowerCase() === 'unlimited'
          ? 'unlimited'
          : 'timed';
        var isTimed = mode === 'timed';
        questionTimeLimitInput.disabled = !isTimed;
        questionTimeLimitInput.style.display = isTimed ? '' : 'none';
        if (questionTimeModeSelect.parentNode) questionTimeModeSelect.parentNode.classList.toggle('is-single', !isTimed);
        questionTimeLimitInput.placeholder = isTimed ? 'e.g. 45' : 'No limit';
        if (!isTimed) {
          questionTimeLimitInput.value = '';
        }
      }

      function resetAssessmentModeInputsFromRule(rule) {
        if (!rule) return;
        if (questionOpenBookSelect) {
          questionOpenBookSelect.value = rule.openBook ? 'true' : 'false';
        }
        if (questionTimeModeSelect) {
          questionTimeModeSelect.value = rule.timeLimitMinutes && Number(rule.timeLimitMinutes) > 0
            ? 'timed'
            : 'unlimited';
        }
        if (questionTimeLimitInput) {
          questionTimeLimitInput.value = rule.timeLimitMinutes && Number(rule.timeLimitMinutes) > 0
            ? String(Number(rule.timeLimitMinutes))
            : '';
        }
        if (questionMaxAttemptsInput) {
          questionMaxAttemptsInput.value = String(Math.max(Number(rule.maxAttempts || 1), 1));
        }
        syncQuestionTimeLimitUi();
      }

      function getCurrentAssessmentModeSummaryText(rule) {
        var modeLabel = 'Secure';
        var timeLabel = 'Untimed';
        var attemptsLabel = '1';

        if (questionOpenBookSelect) {
          modeLabel = String(questionOpenBookSelect.value) === 'true' ? 'Open Book' : 'Secure';
        } else if (rule) {
          modeLabel = rule.openBook ? 'Open Book' : 'Secure';
        }

        if (questionTimeModeSelect && String(questionTimeModeSelect.value || 'timed').toLowerCase() === 'unlimited') {
          timeLabel = 'Untimed';
        } else if (questionTimeLimitInput) {
          var enteredLimit = Number.parseInt(String(questionTimeLimitInput.value || '').trim(), 10);
          timeLabel = Number.isInteger(enteredLimit) && enteredLimit > 0 ? String(enteredLimit) + ' min' : 'Untimed';
        } else if (rule && Number(rule.timeLimitMinutes) > 0) {
          timeLabel = String(Number(rule.timeLimitMinutes)) + ' min';
        }

        if (questionMaxAttemptsInput) {
          var enteredAttempts = Number.parseInt(String(questionMaxAttemptsInput.value || '').trim(), 10);
          attemptsLabel = String(Number.isInteger(enteredAttempts) && enteredAttempts > 0 ? enteredAttempts : 1);
        } else if (rule) {
          attemptsLabel = String(Math.max(Number(rule.maxAttempts || 1), 1));
        }

        return {
          modeLabel: modeLabel,
          timeLabel: timeLabel,
          attemptsLabel: attemptsLabel,
        };
      }

      function getSaveButtonLabel() {
        return questionModalMode === 'edit' ? 'Save Changes' : 'Save Questions';
      }

      function renderSaveButtonIdle() {
        if (!saveQuestionSetButton) return;
        saveQuestionSetButton.disabled = false;
        saveQuestionSetButton.classList.remove('loading');
        saveQuestionSetButton.innerHTML = [
          '<svg width="14" height="14" viewBox="0 0 16 16" fill="none">',
          '  <path d="M13 2H4L2 4v9a1 1 0 001 1h10a1 1 0 001-1V3a1 1 0 00-1-1zM5 2v4h6V2M5 9h6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>',
          '</svg>',
          getSaveButtonLabel(),
        ].join('');
      }

      function setSaveButtonLoading(labelText) {
        if (!saveQuestionSetButton) return;
        saveQuestionSetButton.disabled = true;
        saveQuestionSetButton.classList.add('loading');
        saveQuestionSetButton.innerHTML = '<span class="qm-spinner" aria-hidden="true"></span>' + String(labelText || 'Saving...');
      }

      function setReuseStatus(message, isError) {
        if (!reuseStatus) return;
        reuseStatus.textContent = message || '';
        reuseStatus.style.color = isError ? '#b91c1c' : '#607080';
      }

      function setStudentsStatus(message, isError) {
        if (!studentsStatus) return;
        studentsStatus.textContent = String(message || '');
        studentsStatus.style.color = isError ? '#b91c1c' : '#607080';
      }

      function escapeHtml(value) {
        return String(value || '')
          .replace(/&/g, '&amp;')
          .replace(/</g, '&lt;')
          .replace(/>/g, '&gt;')
          .replace(/"/g, '&quot;')
          .replace(/'/g, '&#39;');
      }

      function setPreviewEditVisible(isVisible) {
        if (!qmPreviewEditButton) return;
        qmPreviewEditButton.style.display = isVisible ? 'inline-flex' : 'none';
      }

      function closeStudentMenus() {
        document.querySelectorAll('#students-modal-overlay .dr-menu__pop').forEach(function (pop) { pop.hidden = true; });
        document.querySelectorAll('#students-modal-overlay [aria-haspopup="true"]').forEach(function (b) { b.setAttribute('aria-expanded', 'false'); });
      }

      function closeStudentsModal() {
        if (!studentsModalOverlay) return;
        closeStudentMenus();
        studentsModalOverlay.classList.remove('show');
        studentsModalOverlay.setAttribute('aria-hidden', 'true');
      }

      function openStudentsModal() {
        if (!studentsModalOverlay) return;
        studentsModalOverlay.classList.add('show');
        studentsModalOverlay.setAttribute('aria-hidden', 'false');
      }

      function formatStudentName(student) {
        if (!student) return 'Student';
        var lastName = String(student.lastName || '').trim();
        var firstName = String(student.firstName || '').trim();
        var fullName = [lastName, firstName].filter(Boolean).join(', ');
        if (!fullName) {
          fullName = 'Student #' + String(student.studentId || '');
        }
        return fullName;
      }

      function mapAttemptStatusLabel(status) {
        var normalized = String(status || '').toLowerCase();
        if (normalized === 'submitted') return 'Completed';
        if (normalized === 'in_progress') return 'In progress';
        if (normalized === 'not_started') return 'Not started';
        return normalized ? (normalized.charAt(0).toUpperCase() + normalized.slice(1)) : 'Not started';
      }

      function formatAttemptTime(value) {
        if (!value) return '-';
        var date = new Date(value);
        if (Number.isNaN(date.getTime())) return '-';
        return date.toLocaleString();
      }

      function renderStudentsSummary(payload) {
        if (!studentsSummary) return;
        var summary = payload && payload.summary ? payload.summary : {};
        var totalStudents = Number(summary.totalStudents || 0);
        var completedCount = Number(summary.completedCount || 0);
        var unlockedCount = Number(summary.unlockedCount || 0);
        studentsSummary.textContent = totalStudents + ' student' + (totalStudents === 1 ? '' : 's') + ' · ' + completedCount + ' finished or locked · ' + unlockedCount + ' open';
      }

      function renderStudentsRows(payload) {
        if (!studentsTableBody) return;

        var rows = Array.isArray(payload && payload.students) ? payload.students : [];
        if (!rows.length) {
          studentsTableBody.innerHTML = '<tr><td colspan="4" class="student-subtle">No eligible students found for this class and term.</td></tr>';
          return;
        }

        var markup = rows.map(function (student) {
          var statusLabel = mapAttemptStatusLabel(student.attemptStatus);
          if (student.isLocked) statusLabel += ' · Locked';
          var scoreLabel = (student.score !== null && student.score !== undefined)
            ? (String(student.score) + (student.maxScore !== null && student.maxScore !== undefined ? (' / ' + String(student.maxScore)) : ''))
            : '-';
          var isLocked = Boolean(student.isLocked);
          var actionLabel = isLocked ? 'Unlock' : 'Lock';
          var actionType = isLocked ? 'unlock' : 'lock';
          var items = [];
          if (student.attemptId) items.push('<button type="button" class="dr-menu__item student-grade-btn" role="menuitem" data-attempt-id="' + escapeHtml(String(student.attemptId)) + '">Review answers</button>');
          items.push('<button type="button" class="dr-menu__item student-lock-toggle-btn" role="menuitem" data-student-id="' + escapeHtml(String(student.studentId || '')) + '" data-action="' + actionType + '">' + actionLabel + '</button>');
          return [
            '<tr>',
            '  <td>',
            '    <div class="student-name">' + escapeHtml(formatStudentName(student)) + '</div>',
            '    <div class="student-subtle">ID: ' + escapeHtml(String(student.studentId || '-')) + '</div>',
            '  </td>',
            '  <td>' + escapeHtml(statusLabel) + '</td>',
            '  <td>' + escapeHtml(scoreLabel) + '</td>',
            '  <td class="students-col-act"><div class="student-row-menu dr-menu"><button type="button" class="dr-icon-btn student-row-menu-btn" aria-haspopup="true" aria-expanded="false" aria-label="Actions for ' + escapeHtml(formatStudentName(student)) + '" title="Actions"><svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><circle cx="12" cy="5" r="1.8"/><circle cx="12" cy="12" r="1.8"/><circle cx="12" cy="19" r="1.8"/></svg></button><div class="dr-menu__pop" role="menu" hidden>' + items.join('') + '</div></div></td>',
            '</tr>'
          ].join('');
        }).join('');

        studentsTableBody.innerHTML = markup;

        studentsTableBody.querySelectorAll('.student-row-menu-btn').forEach(function (menuBtn) {
          menuBtn.addEventListener('click', function (event) {
            event.stopPropagation();
            var pop = menuBtn.parentNode.querySelector('.dr-menu__pop');
            var willOpen = pop.hidden;
            closeStudentMenus();
            pop.hidden = !willOpen;
            menuBtn.setAttribute('aria-expanded', willOpen ? 'true' : 'false');
          });
        });

        studentsTableBody.querySelectorAll('.student-grade-btn').forEach(function (button) {
          button.addEventListener('click', function () {
            closeStudentMenus();
            var attemptId = Number(button.getAttribute('data-attempt-id') || 0);
            if (attemptId) openGradeDrawer(attemptId);
          });
        });

        studentsTableBody.querySelectorAll('.student-lock-toggle-btn').forEach(function (button) {
          button.addEventListener('click', async function () {
            if (button.classList.contains('is-disabled')) return;
            closeStudentMenus();
            var targetStudentId = Number(button.getAttribute('data-student-id') || 0);
            var action = String(button.getAttribute('data-action') || '');
            if (!targetStudentId || !activeStudentsQuestionSetId) return;

            var originalLabel = button.textContent;

            if (action === 'lock') {
              var lockApproved = await window.appConfirm('Lock this student\'s current attempt now? They will stop seeing the assessment until it is unlocked again.');
              if (!lockApproved) return;

              button.disabled = true;
              button.textContent = 'Locking...';
              setStudentsStatus('Locking student...', false);

              try {
                var lockResponse = await fetch('/common/assessment/questions/students/unlock', {
                  method: 'POST',
                  headers: {
                    'Content-Type': 'application/json',
                    Accept: 'application/json',
                  },
                  body: JSON.stringify({
                    questionSetId: activeStudentsQuestionSetId,
                    studentId: targetStudentId,
                    unlockAll: false,
                    action: 'lock',
                  }),
                });

                var lockResult = await lockResponse.json();
                if (!lockResponse.ok || !lockResult.success) {
                  throw new Error(lockResult.error || 'Failed to lock student.');
                }

                setStudentsStatus(lockResult.message || 'Student locked.', false);
                await loadStudentsForQuestionSet(activeStudentsQuestionSetId);
              } catch (error) {
                setStudentsStatus(error.message || 'Failed to lock student.', true);
                button.disabled = false;
                button.textContent = originalLabel;
              }
              return;
            }

            if (action !== 'unlock') return;

            var approved = await window.appConfirm('Let this student take the test again? Their answers and their mark for this test are deleted, including a grade already posted.');
            if (!approved) return;

            var reshuffleQuestions = await window.appConfirm('Shuffle the order of the questions for the new try?', { ok: 'Shuffle', cancel: 'Keep order' });

            button.disabled = true;
            button.textContent = 'Unlocking...';
            setStudentsStatus('Unlocking student...', false);

            try {
              var response = await fetch('/common/assessment/questions/students/unlock', {
                method: 'POST',
                headers: {
                  'Content-Type': 'application/json',
                  Accept: 'application/json',
                },
                body: JSON.stringify({
                  questionSetId: activeStudentsQuestionSetId,
                  studentId: targetStudentId,
                  unlockAll: false,
                  action: 'unlock',
                  reshuffleQuestions: reshuffleQuestions,
                }),
              });

              var result = await response.json();
              if (!response.ok || !result.success) {
                throw new Error(result.error || 'Failed to unlock student.');
              }

              setStudentsStatus(result.message || 'Student unlocked.', false);
              await loadStudentsForQuestionSet(activeStudentsQuestionSetId);
            } catch (error) {
              setStudentsStatus(error.message || 'Failed to unlock student.', true);
              button.disabled = false;
              button.textContent = originalLabel;
            }
          });
        });
      }

      // ---- Grade by question: one written question across everyone who handed in (the same screen).
      var gm = { mode: 'student', questions: [], q: 0, answers: [], at: 0 };
      var gmBase = '/common/assessment/mark';
      function gmEl(id) { return document.getElementById(id); }
      function gmJson(url, options) {
        return fetch(url, Object.assign({ headers: { Accept: 'application/json', 'Content-Type': 'application/json' }, credentials: 'same-origin' }, options || {}))
          .then(function (response) { return response.json().then(function (body) { if (!response.ok || body.success === false) throw new Error(body.error || 'Something went wrong.'); return body; }); });
      }
      function gmStatus(text, bad) { var el = gmEl('gmStatus'); if (!el) return; el.textContent = text || ''; el.style.color = bad ? '#b42318' : ''; }
      function gmSetMode(mode) {
        gm.mode = mode;
        Array.prototype.forEach.call(document.querySelectorAll('#gradeModeSwitch .gm-seg'), function (b) { b.classList.toggle('is-on', b.getAttribute('data-gm-mode') === mode); });
        var byQuestion = mode === 'question';
        gmEl('gradeByQuestion').hidden = !byQuestion;
        gmEl('gmFooter').hidden = !byQuestion;
        gmEl('gradeStudentFooter').style.display = byQuestion ? 'none' : 'flex';
        gradeModalTotal.style.display = byQuestion ? 'none' : '';
        if (byQuestion) {
          if (gradeModalQuestions) gradeModalQuestions.style.display = 'none';
          if (gradeModalLoading) gradeModalLoading.style.display = 'none';
        }
      }
      function gmOpen() {
        var scope = (latestStudentsPayload && latestStudentsPayload.scope) || {};
        if (gradeModalTitle) gradeModalTitle.textContent = 'Review · ' + (scope.assessmentTitle || 'Assessment');
        if (gradeModalSubtitle) gradeModalSubtitle.textContent = [scope.className, scope.subjectName].filter(Boolean).join(' • ');
        gmSetMode('question');
        gmEl('gmQuestion').textContent = 'Loading…'; gmEl('gmAnswer').textContent = ''; gmEl('gmWho').textContent = ''; gmEl('gmTabs').innerHTML = '';
        gmJson(gmBase + '/questions?questionSetId=' + encodeURIComponent(activeStudentsQuestionSetId)).then(function (data) {
          gm.questions = data.questions || [];
          var first = gm.questions.findIndex(function (q) { return q.toMark > 0; });
          gm.q = first >= 0 ? first : 0;
          gmTabs(); gmLoad();
        }).catch(function (error) { gmEl('gmQuestion').textContent = error.message; });
      }
      function gmTabs() {
        var box = gmEl('gmTabs'); box.innerHTML = '';
        gm.questions.forEach(function (q, i) {
          var b = document.createElement('button');
          b.type = 'button'; b.className = 'gm-tab' + (i === gm.q ? ' is-on' : '');
          b.textContent = 'Question ' + (i + 1) + (q.toMark ? ' · ' + q.toMark + ' to review' : ' · done');
          b.addEventListener('click', function () { gm.q = i; gmTabs(); gmLoad(); });
          box.appendChild(b);
        });
      }
      // A question with a rubric is marked per criterion; the single mark box then shows the total.
      function gmCriteria() { var q = gm.questions[gm.q]; return q && q.rubric && Array.isArray(q.rubric.criteria) ? q.rubric.criteria : null; }
      function gmRubricTotal() {
        var sum = 0;
        Array.prototype.forEach.call(document.querySelectorAll('#gmRubric .gm-crit input'), function (input) { var n = Number(input.value); if (Number.isFinite(n)) sum += n; });
        return Math.round(sum * 100) / 100;
      }
      function gmShowRubric(answer) {
        var box = gmEl('gmRubric'); var criteria = gmCriteria();
        var marksInput = gmEl('gmMarks');
        if (!criteria) { box.hidden = true; box.innerHTML = ''; marksInput.readOnly = false; return; }
        box.hidden = false;
        box.innerHTML = criteria.map(function (c, i) {
          var given = answer && Array.isArray(answer.rubricMarks) ? answer.rubricMarks[i] : '';
          return '<label class="gm-crit"><span>' + escapeHtml(c.name) + ' <small>out of ' + escapeHtml(String(c.marks)) + '</small></span>' +
            '<input type="number" min="0" max="' + escapeHtml(String(c.marks)) + '" step="0.5" data-i="' + i + '" value="' + (given === undefined || given === null ? '' : escapeHtml(String(given))) + '"></label>';
        }).join('');
        marksInput.readOnly = true;
        marksInput.value = answer && answer.marked ? answer.marks : '';
        Array.prototype.forEach.call(box.querySelectorAll('input'), function (input) {
          input.addEventListener('input', function () { marksInput.value = gmRubricTotal(); });
          input.addEventListener('keydown', function (event) { if (event.key === 'Enter') { event.preventDefault(); gmSave(); } });
        });
      }
      function gmLeft() { return gm.answers.filter(function (a) { return !a.marked; }).length; }
      function gmLoad() {
        var q = gm.questions[gm.q];
        if (!q) { gmEl('gmQuestion').textContent = 'This test has no written questions to review.'; gmEl('gmIndex').textContent = '–'; gmEl('gmOutOf').textContent = ''; gmEl('gmAnswer').textContent = ''; gmEl('gmWho').textContent = ''; gmEl('gmPos').textContent = ''; return; }
        gmEl('gmIndex').textContent = String(gm.q + 1);
        gmEl('gmQuestion').textContent = q.text;
        gmEl('gmOutOf').textContent = 'out of ' + q.marks;
        gmJson(gmBase + '/answers?questionSetId=' + encodeURIComponent(activeStudentsQuestionSetId) + '&questionId=' + encodeURIComponent(q.questionId)).then(function (data) {
          gm.answers = data.answers || []; gm.at = 0; gmRender();
        }).catch(function (error) { gmStatus(error.message, true); });
      }
      function gmRender() {
        var a = gm.answers[gm.at];
        if (!a) { gmEl('gmWho').textContent = ''; gmEl('gmAnswer').textContent = 'Nobody has answered this question.'; gmEl('gmMarks').value = ''; gmEl('gmPos').textContent = ''; return; }
        gmEl('gmWho').textContent = a.student;
        gmEl('gmAnswer').textContent = a.text;
        gmEl('gmMarks').value = a.marked ? a.marks : '';
        gmEl('gmMarks').max = a.outOf;
        gmEl('gmMarks').placeholder = 'out of ' + a.outOf;
        gmShowRubric(a);
        gmEl('gmPos').textContent = (gm.at + 1) + ' of ' + gm.answers.length + ' · ' + gmLeft() + ' to review';
        gmEl('gmPrev').disabled = gm.at === 0;
        gmEl('gmNext').disabled = gm.at >= gm.answers.length - 1;
        gmStatus('');
      }
      function gmStep(by) { var n = gm.at + by; if (n >= 0 && n < gm.answers.length) { gm.at = n; gmRender(); } }
      function gmSave() {
        var a = gm.answers[gm.at]; var q = gm.questions[gm.q];
        if (!a || !q) return;
        var criteria = gmCriteria();
        var body = { questionSetId: activeStudentsQuestionSetId, questionId: q.questionId, attemptId: a.attemptId };
        if (criteria) {
          var inputs = Array.prototype.slice.call(document.querySelectorAll('#gmRubric .gm-crit input'));
          if (inputs.some(function (input) { return input.value === ''; })) { gmStatus('Give a mark for each criterion.', true); return; }
          body.rubricMarks = inputs.map(function (input) { return Number(input.value); });
        } else {
          var value = gmEl('gmMarks').value;
          if (value === '') { gmStatus('Type a mark.', true); return; }
          body.marks = Number(value);
        }
        gmEl('gmSave').disabled = true; gmStatus('Saving…');
        gmJson(gmBase + '/save', { method: 'POST', body: JSON.stringify(body) })
          .then(function (data) {
            var was = a.marked; a.marked = true; a.marks = data.marks; if (data.rubricMarks) a.rubricMarks = data.rubricMarks;
            if (!was) q.toMark = Math.max(0, q.toMark - 1);
            gmTabs();
            var next = -1;
            for (var i = 1; i <= gm.answers.length; i++) { var j = (gm.at + i) % gm.answers.length; if (!gm.answers[j].marked) { next = j; break; } }
            if (next >= 0) gm.at = next; else if (gm.at < gm.answers.length - 1) gm.at += 1;
            gmRender();
            if (gm.questions.every(function (item) { return !item.toMark; })) gmStatus('All reviewed — post grades with ✓ in the gradebook.', false);
            loadStudentsForQuestionSet(activeStudentsQuestionSetId).catch(function () {});
          })
          .catch(function (error) { gmStatus(error.message, true); })
          .then(function () { gmEl('gmSave').disabled = false; });
      }
      Array.prototype.forEach.call(document.querySelectorAll('#gradeModeSwitch .gm-seg'), function (button) {
        button.addEventListener('click', function () {
          var mode = button.getAttribute('data-gm-mode');
          if (mode === gm.mode) return;
          if (mode === 'question') { gmOpen(); return; }
          // Back to one student: with no student open, return to the list to pick one.
          if (!activeGradeAttemptId) { closeGradeDrawer(); return; }
          gmSetMode('student');
          openGradeDrawer(activeGradeAttemptId);
        });
      });
      gmEl('gmPrev').addEventListener('click', function () { gmStep(-1); });
      gmEl('gmNext').addEventListener('click', function () { gmStep(1); });
      gmEl('gmSave').addEventListener('click', gmSave);
      gmEl('gmClose').addEventListener('click', function () { closeGradeDrawer(); });
      gmEl('gmMarks').addEventListener('keydown', function (event) { if (event.key === 'Enter') { event.preventDefault(); gmSave(); } });
      // To review: Review opens the marking screen (By question) for that test straight away.
      Array.prototype.forEach.call(document.querySelectorAll('.js-review-set'), function (button) {
        button.addEventListener('click', async function (event) {
          event.preventDefault();
          event.stopPropagation();
          button.disabled = true;
          try {
            await loadStudentsForQuestionSet(Number(button.getAttribute('data-question-set-id')));
            activeGradeAttemptId = 0;
            gradeModalOverlay.classList.add('is-open');
            gradeModalOverlay.setAttribute('aria-hidden', 'false');
            document.body.style.overflow = 'hidden';
            gmOpen();
          } catch (error) {
            window.alert(error.message || 'This test could not be opened.');
          } finally {
            button.disabled = false;
          }
        });
      });
      var studentsBqBtn = document.getElementById('students-bq-btn');
      if (studentsBqBtn) {
        studentsBqBtn.addEventListener('click', function () {
          if (!activeStudentsQuestionSetId) return;
          activeGradeAttemptId = 0;
          gradeModalOverlay.classList.add('is-open');
          gradeModalOverlay.setAttribute('aria-hidden', 'false');
          document.body.style.overflow = 'hidden';
          gmOpen();
        });
      }

      function openGradeDrawer(attemptId) {
        gmSetMode('student');
        activeGradeAttemptId = attemptId;
        activeGradeQuestions = [];
        if (gradeModalTitle) gradeModalTitle.textContent = 'Grade';
        if (gradeModalSubtitle) gradeModalSubtitle.textContent = '';
        if (gradeModalTotal) gradeModalTotal.textContent = '';
        if (gradeModalQuestions) {
          gradeModalQuestions.style.display = 'none';
          gradeModalQuestions.innerHTML = '';
        }
        if (gradeModalLoading) {
          gradeModalLoading.style.display = 'block';
          gradeModalLoading.textContent = 'Loading…';
        }
        if (gradeModalSave) gradeModalSave.disabled = true;

        gradeModalOverlay.classList.add('is-open');
        gradeModalOverlay.setAttribute('aria-hidden', 'false');
        document.body.style.overflow = 'hidden';

        fetch('/common/assessment/attempt/grade?attemptId=' + encodeURIComponent(String(attemptId)), {
          method: 'GET',
          headers: { Accept: 'application/json' },
        })
          .then(function (response) { return response.json().then(function (data) { return { ok: response.ok, data: data }; }); })
          .then(function (result) {
            if (!result.ok || !result.data.success) {
              throw new Error((result.data && result.data.error) || 'Failed to load attempt.');
            }
            renderGradeDrawer(result.data);
          })
          .catch(function (error) {
            if (gradeModalLoading) {
              gradeModalLoading.textContent = error.message || 'Failed to load attempt.';
            }
          });
      }

      function closeGradeDrawer() {
        gmSetMode('student');
        gradeModalOverlay.classList.remove('is-open');
        gradeModalOverlay.setAttribute('aria-hidden', 'true');
        document.body.style.overflow = '';
        activeGradeAttemptId = 0;
        activeGradeQuestions = [];
      }

      function updateGradeDrawerTotal() {
        var total = 0;
        var maxTotal = 0;
        activeGradeQuestions.forEach(function (question) {
          var input = document.getElementById('grade-marks-' + question.questionId);
          var value = input ? Number(input.value) : 0;
          if (!Number.isFinite(value)) value = 0;
          total += value;
          maxTotal += Number(question.marks) || 0;
        });
        if (gradeModalTotal) {
          gradeModalTotal.textContent = 'Total: ' + total + ' / ' + maxTotal;
        }
      }

      function renderGradeDrawer(payload) {
        activeGradeQuestions = Array.isArray(payload.questions) ? payload.questions : [];

        var studentName = ((payload.student && (payload.student.lastName + ', ' + payload.student.firstName)) || '').trim();
        var assessmentTitle = (payload.assessment && payload.assessment.title) || 'Assessment';
        var subjectName = (payload.assessment && payload.assessment.subjectName) || '';
        var className = (payload.assessment && payload.assessment.className) || '';

        if (gradeModalTitle) gradeModalTitle.textContent = studentName + ' — ' + assessmentTitle;
        if (gradeModalSubtitle) gradeModalSubtitle.textContent = [className, subjectName].filter(Boolean).join(' • ');

        if (!payload.canEdit && gradeModalLoading) {
          gradeModalLoading.style.display = 'block';
          gradeModalLoading.textContent = 'Not editable: ' + (payload.editReason || 'locked') + '.';
          if (gradeModalQuestions) gradeModalQuestions.style.display = 'none';
          if (gradeModalSave) gradeModalSave.disabled = true;
          updateGradeDrawerTotal();
          return;
        }

        if (gradeModalLoading) gradeModalLoading.style.display = 'none';
        if (gradeModalSave) gradeModalSave.disabled = false;

        function normalizeForCompare(value) {
          return String(value == null ? '' : value).replace(/\s+/g, ' ').trim().toLowerCase();
        }

        // The question's picture, with its numbered spots.
        function gradePicture(question) {
          var media = question.media;
          if (!media || !media.image || !media.image.url) return '';
          var spots = (media.labels || []).map(function (label, i) {
            return '<span class="qbf-spot" style="left:' + (Number(label.x) * 100) + '%;top:' + (Number(label.y) * 100) + '%">' + (i + 1) + '</span>';
          }).join('');
          return '<div class="qbf-preview-pic"><div class="qbf-media__canvas" style="max-width:min(100%,360px)"><img src="' + escapeHtml(media.image.url) + '" alt="" />' + spots + '</div></div>';
        }

        function renderGradeQuestionBody(question) {
          var type = String(question.questionType || '').toLowerCase();
          if (type === 'image_label') {
            var labels = (question.media && question.media.labels) || [];
            var given = question.responseJson && Array.isArray(question.responseJson.values)
              ? question.responseJson.values
              : (question.responseText ? [question.responseText] : []);
            var labelRows = labels.map(function (label, i) {
              var answer = String(given[i] == null ? '' : given[i]).trim();
              var accepted = String(label.answer || '').split('/').map(normalizeForCompare).filter(Boolean);
              var right = Boolean(answer) && accepted.indexOf(normalizeForCompare(answer)) !== -1;
              return '<div class="grade-option' + (right ? ' is-correct-answer' : '') + (answer ? ' is-student-answer' : '') + '">' +
                '<span><strong>' + (i + 1) + '.</strong> ' + (answer ? escapeHtml(answer) : '<span class="student-subtle">No answer</span>') + '</span>' +
                (right ? '<span class="grade-option-tag correct">Right</span>' : '<span class="grade-option-tag student">Expected: ' + escapeHtml(String(label.answer || '')) + '</span>') +
                '</div>';
            }).join('');
            return gradePicture(question) + '<div class="grade-options">' + (labelRows || '<div class="grade-response-box">No spots on this picture.</div>') + '</div>';
          }
          var picture = gradePicture(question);
          if (picture) {
            var rest = renderGradeQuestionBody(Object.assign({}, question, { media: null }));
            return picture + rest;
          }
          var options = Array.isArray(question.options) ? question.options : [];
          var studentAnswerSet = Array.isArray(question.responseJson)
            ? question.responseJson.map(normalizeForCompare)
            : (question.responseText ? String(question.responseText).split(',').map(normalizeForCompare) : []);
          var correctAnswerSet = String(question.answerKey || '').split(',').map(normalizeForCompare).filter(Boolean);

          if (type === 'single_choice' || type === 'true_false' || type === 'multiple_choice') {
            if (!options.length) {
              return '<div class="grade-response-box">No options were configured for this question.</div>';
            }
            var optionRows = options.map(function (option) {
              var normalizedOption = normalizeForCompare(option);
              var isCorrect = correctAnswerSet.indexOf(normalizedOption) !== -1;
              var isStudent = studentAnswerSet.indexOf(normalizedOption) !== -1;
              var classes = 'grade-option' + (isCorrect ? ' is-correct-answer' : '') + (isStudent ? ' is-student-answer' : '');
              var tags = '';
              if (isStudent) tags += '<span class="grade-option-tag student">Student</span>';
              if (isCorrect) tags += '<span class="grade-option-tag correct">Correct</span>';
              return '<div class="' + classes + '"><span>' + escapeHtml(String(option)) + '</span>' + tags + '</div>';
            }).join('');
            return '<div class="grade-options">' + optionRows + '</div>';
          }

          var responseText = question.responseText || (question.responseJson ? JSON.stringify(question.responseJson) : '');
          var responseBox = '<div class="grade-response-box">' + (responseText ? escapeHtml(responseText) : '<span class="student-subtle">No response submitted.</span>') + '</div>';
          if (type === 'essay') {
            var criteria = question.rubric && Array.isArray(question.rubric.criteria) ? question.rubric.criteria : null;
            if (!criteria) return responseBox;
            var crit = criteria.map(function (c, i) {
              var given = Array.isArray(question.rubricMarks) ? question.rubricMarks[i] : '';
              return '<label class="gm-crit"><span>' + escapeHtml(c.name) + ' <small>out of ' + escapeHtml(String(c.marks)) + '</small></span>' +
                '<input type="number" class="grade-crit" data-q="' + question.questionId + '" data-i="' + i + '" min="0" max="' + escapeHtml(String(c.marks)) + '" step="0.5" value="' + (given === undefined || given === null ? '' : escapeHtml(String(given))) + '"></label>';
            }).join('');
            return responseBox + '<div class="gm-rubric">' + crit + '</div>';
          }
          var answerKeyBox = question.answerKey
            ? '<div class="grade-answer-key">Expected answer: ' + escapeHtml(String(question.answerKey)) + '</div>'
            : '';
          return responseBox + answerKeyBox;
        }

        var markup = activeGradeQuestions.map(function (question, index) {
          var awarded = (question.awardedMarks !== null && question.awardedMarks !== undefined)
            ? question.awardedMarks
            : 0;
          return [
            '<div class="grade-question-card">',
            '  <div class="grade-question-head">',
            '    <div class="grade-question-title-wrap">',
            '      <span class="grade-q-index">' + (index + 1) + '</span>',
            '      <h3>' + escapeHtml(question.questionText || '') + '</h3>',
            '    </div>',
            '    <span class="grade-mark">' + escapeHtml(String(question.marks)) + ' marks</span>',
            '  </div>',
            renderGradeQuestionBody(question),
            '  <div class="grade-question-marks-row">',
            '    <label for="grade-marks-' + question.questionId + '">Award marks:</label>',
            '    <input type="number" class="grade-question-marks-input" id="grade-marks-' + question.questionId + '" min="0" max="' + escapeHtml(String(question.marks)) + '" step="0.5" value="' + escapeHtml(String(awarded)) + '" />',
            '    <span class="student-subtle">/ ' + escapeHtml(String(question.marks)) + '</span>',
            '  </div>',
            '</div>'
          ].join('');
        }).join('');

        if (gradeModalQuestions) {
          gradeModalQuestions.innerHTML = markup || '<p class="student-subtle">No questions found for this attempt.</p>';
          gradeModalQuestions.style.display = 'block';
        }

        activeGradeQuestions.forEach(function (question) {
          var input = document.getElementById('grade-marks-' + question.questionId);
          if (input) {
            input.addEventListener('input', updateGradeDrawerTotal);
          }
          // A rubric question: its mark box shows the total of its criteria.
          var criteriaInputs = gradeModalQuestions.querySelectorAll('.grade-crit[data-q="' + question.questionId + '"]');
          if (criteriaInputs.length && input) {
            input.readOnly = true;
            var sum = function () {
              var total = 0;
              Array.prototype.forEach.call(criteriaInputs, function (c) { var n = Number(c.value); if (Number.isFinite(n)) total += n; });
              input.value = Math.round(total * 100) / 100;
              updateGradeDrawerTotal();
            };
            Array.prototype.forEach.call(criteriaInputs, function (c) { c.addEventListener('input', sum); });
          }
        });

        updateGradeDrawerTotal();
      }

      if (gradeModalCancel) {
        gradeModalCancel.addEventListener('click', closeGradeDrawer);
        var gradeModalX = document.getElementById('gradeModalX');
        if (gradeModalX) gradeModalX.addEventListener('click', closeGradeDrawer);
      }

      if (gradeModalSave) {
        gradeModalSave.addEventListener('click', async function () {
          if (!activeGradeAttemptId) return;

          var marks = {};
          var rubricMarks = {};
          activeGradeQuestions.forEach(function (question) {
            var input = document.getElementById('grade-marks-' + question.questionId);
            var value = input ? Number(input.value) : 0;
            if (!Number.isFinite(value)) value = 0;
            marks[question.questionId] = value;
            var criteriaInputs = gradeModalQuestions.querySelectorAll('.grade-crit[data-q="' + question.questionId + '"]');
            if (criteriaInputs.length) {
              rubricMarks[question.questionId] = Array.prototype.map.call(criteriaInputs, function (c) { var n = Number(c.value); return Number.isFinite(n) ? n : 0; });
            }
          });

          var originalLabel = gradeModalSave.textContent;
          gradeModalSave.disabled = true;
          gradeModalSave.textContent = 'Saving...';

          try {
            var response = await fetch('/common/assessment/attempt/grade', {
              method: 'POST',
              headers: {
                'Content-Type': 'application/json',
                Accept: 'application/json',
              },
              body: JSON.stringify({ attemptId: activeGradeAttemptId, marks: marks, rubricMarks: rubricMarks }),
            });
            var result = await response.json();
            if (!response.ok || !result.success) {
              throw new Error(result.error || 'Failed to save grade.');
            }

            closeGradeDrawer();
            if (activeStudentsQuestionSetId) {
              await loadStudentsForQuestionSet(activeStudentsQuestionSetId);
            }
          } catch (error) {
            window.alert(error.message || 'Failed to save grade.');
            gradeModalSave.disabled = false;
            gradeModalSave.textContent = originalLabel;
          }
        });
      }

      async function loadStudentsForQuestionSet(questionSetId) {
        if (!Number.isInteger(Number(questionSetId)) || Number(questionSetId) <= 0) {
          return;
        }

        activeStudentsQuestionSetId = Number(questionSetId);
        latestStudentsPayload = null;
        if (studentsTableBody) {
          studentsTableBody.innerHTML = '<tr><td colspan="4" class="student-subtle">Loading students...</td></tr>';
        }
        setStudentsStatus('Loading students...', false);

        var requestUrl = '/common/assessment/questions/students?questionSetId=' + encodeURIComponent(String(activeStudentsQuestionSetId));
        var response = await fetch(requestUrl, {
          method: 'GET',
          headers: { Accept: 'application/json' },
        });
        var payload = await response.json();
        if (!response.ok || !payload.success) {
          throw new Error(payload.error || 'Failed to load students.');
        }

        latestStudentsPayload = payload;
        var scope = payload.scope || {};
        if (studentsModalTitle) {
          studentsModalTitle.textContent = 'Review · ' + String(scope.assessmentTitle || scope.setTitle || 'Question Set');
        }
        if (studentsModalSubtitle) {
          studentsModalSubtitle.textContent = [
            String(scope.className || 'Class'),
            String(scope.subjectName || 'Subject'),
            String(scope.assessmentTitle || 'Assessment')
          ].join(' • ');
        }

        renderStudentsSummary(payload);
        renderStudentsRows(payload);
        syncPostScoresToggleState();

        var completedCount = Number((payload.summary && payload.summary.completedCount) || 0);
        if (studentsUnlockAllButton) {
          studentsUnlockAllButton.disabled = completedCount <= 0;
          studentsUnlockAllButton.classList.toggle('is-disabled', completedCount <= 0);
        }

        setStudentsStatus('', false);
      }

      function computePostScoresState() {
        var students = (latestStudentsPayload && latestStudentsPayload.students) || [];
        var completed = students.filter(function (s) { return s.attemptStatus === 'submitted'; });
        var postedCount = completed.filter(function (s) { return s.isPosted; }).length;
        return { postedCount: postedCount, pendingCount: completed.length - postedCount };
      }

      function syncPostScoresToggleState() {
        if (!studentsPostScoresToggle) return;
        var state = computePostScoresState();
        var allPosted = state.postedCount > 0 && state.pendingCount <= 0;
        studentsPostScoresToggle.classList.toggle('is-on', allPosted);
        studentsPostScoresToggle.textContent = allPosted ? 'Take back' : 'Post grades';
        var shareEl = document.getElementById('students-share-line');
        if (shareEl) shareEl.textContent = allPosted ? '' : shareLine(latestStudentsPayload && latestStudentsPayload.summary ? latestStudentsPayload.summary.parentShare : '');
      }

      function renderUploadButtonIdle() {
        if (!qmUploadPdfBtn) return;
        qmUploadPdfBtn.classList.remove('loading');
        qmUploadPdfBtn.innerHTML = [
          '<svg width="15" height="15" viewBox="0 0 16 16" fill="none">',
          '<path d="M8 10V3M5 6l3-3 3 3M3 11v1a1 1 0 001 1h8a1 1 0 001-1v-1" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/>',
          '</svg>',
          '<span class="qm-upload-text">Import Exam File</span>'
        ].join('');
      }

      function setUploadButtonLoading(labelText) {
        if (!qmUploadPdfBtn) return;
        qmUploadPdfBtn.classList.add('loading');
        qmUploadPdfBtn.innerHTML = '<span class="qm-spinner"></span><span class="qm-upload-text">' + String(labelText || 'Processing...') + '</span>';
      }

      function normalizeExtractedQuestionType(rawType) {
        var t = String(rawType || '').trim().toLowerCase().replace(/[\s_-]+/g, '_');
        if (!t) return 'short_text';
        if (['multiple_choice', 'mcq', 'multiple choice'].includes(t)) return 'multiple_choice';
        if (['single_choice', 'one_choice', 'single choice', 'one choice'].includes(t)) return 'single_choice';
        if (['true_false', 'true/false', 'true false'].includes(t)) return 'true_false';
        if (['short_text', 'short_answer', 'short answer', 'short_ans'].includes(t)) return 'short_text';
        if (['fill_blank', 'fill_in_the_blank', 'fill blank'].includes(t)) return 'short_text';
        if (['matching'].includes(t)) return 'short_text';
        if (['essay'].includes(t)) return 'essay';
        return 'short_text';
      }

      function populateQuestionsFromExtracted(extractedQuestions, sourceLabel) {
        if (!questionItems) return;

        var normalizedQuestions = Array.isArray(extractedQuestions)
          ? extractedQuestions.map(function (item, index) {
              var type = normalizeExtractedQuestionType(item.questionType);
              var questionText = String(item.questionText || item.question || '').trim();

              // Skip section headers that slipped through
              if (/^[A-G]\s+(MULTIPLE|TRUE|FILL|MATCHING|SHORT|ESSAY)/i.test(questionText)) return null;
              if (/^GENERAL INSTRUCTIONS/i.test(questionText)) return null;
              if (/End of Paper/i.test(questionText)) return null;
              if (questionText.length < 4) return null;

              var options = Array.isArray(item.options)
                ? item.options.map(function (opt) { return String(opt || '').trim(); }).filter(Boolean)
                : [];

              var extractedAnswers = [];
              if (Array.isArray(item.answerKeys)) {
                extractedAnswers = item.answerKeys
                  .map(function (ans) { return String(ans || '').trim(); })
                  .filter(Boolean);
              } else if (item.answerKey !== undefined && item.answerKey !== null) {
                extractedAnswers = parseAnswerValues(item.answerKey);
              } else if (item.answer !== undefined && item.answer !== null) {
                extractedAnswers = parseAnswerValues(item.answer);
              }

              if (type === 'true_false' && !options.length) {
                options = ['True', 'False'];
              }

              var marks = Number(item.marks || item.mark || item.points || 1);
              var questionNumber = Number(item.questionNumber);
              return {
                questionNumber: Number.isInteger(questionNumber) && questionNumber > 0 ? questionNumber : (index + 1),
                questionType: ['multiple_choice', 'single_choice', 'true_false', 'short_text', 'essay'].includes(type)
                  ? type
                  : 'short_text',
                questionText: questionText,
                options: options,
                answerKeys: extractedAnswers,
                marks: Number.isFinite(marks) && marks > 0 ? marks : 1,
              };
            }).filter(function (item) {
              return item && item.questionText;
            })
          : [];

        normalizedQuestions.sort(function (a, b) {
          return a.questionNumber - b.questionNumber;
        });

        if (!normalizedQuestions.length) {
          setQuestionStatus('No questions were detected in the uploaded PDF.', true);
          return;
        }

        questionItems.innerHTML = '';
        normalizedQuestions.forEach(function (question) {
          questionItems.appendChild(buildQuestionItem(question));
        });

        renumberQuestionCards();
        updateQuestionCount();
        saveDraft();

        var sourceText = sourceLabel ? ' from ' + sourceLabel : '';
        setQuestionStatus(
          normalizedQuestions.length + ' question' + (normalizedQuestions.length === 1 ? '' : 's') +
          ' extracted' + sourceText + '. Review and save.',
          false
        );
      }

      function escapeHtml(value) {
        return String(value || '')
          .replace(/&/g, '&amp;')
          .replace(/</g, '&lt;')
          .replace(/>/g, '&gt;')
          .replace(/"/g, '&quot;')
          .replace(/'/g, '&#39;');
      }

      function toDisplayQuestionType(type) {
        var normalized = String(type || '').toLowerCase();
        if (normalized === 'multiple_choice') return 'Choose several';
        if (normalized === 'single_choice') return 'Choose one';
        if (normalized === 'true_false') return 'True / False';
        if (normalized === 'essay') return 'Essay';
        if (normalized === 'image_label') return 'Label the picture';
        return 'Short answer';
      }

      function getSelectedOptionLabel(selectElement) {
        if (!selectElement || !selectElement.options || selectElement.selectedIndex < 0) return '';
        return String(selectElement.options[selectElement.selectedIndex].textContent || '').trim();
      }

      function normalizePreviewQuestion(question, index) {
        var questionType = String(question.questionType || question.question_type || 'short_text').toLowerCase();
        var questionHtml = String(question.questionText || question.question_text || '').trim();
        var options = Array.isArray(question.options)
          ? question.options
          : (Array.isArray(question.options_json) ? question.options_json : []);
        var optionLayoutRaw = String(question.optionLayout || question.optionsLayout || question.options_layout || '').trim().toLowerCase();
        var optionLayout = optionLayoutRaw === 'side_by_side' ? 'side_by_side' : 'stacked';
        var answerKey = question.answerKey !== undefined && question.answerKey !== null
          ? question.answerKey
          : question.answer_key;
        var marks = Number(question.marks || 0);
        var questionIndex = Number(question.positionIndex || question.position_index || 0);

        return {
          questionType: questionType,
          questionText: questionHtml,
          options: options,
          optionLayout: optionLayout,
          answerKey: answerKey,
          marks: Number.isFinite(marks) && marks > 0 ? marks : 1,
          positionIndex: index + 1,
        };
      }

      function buildPreviewCardsMarkup(questions, emptyStateMessage) {
        if (!Array.isArray(questions) || !questions.length) {
          return '<div class="qm-preview-card"><div class="qm-preview-answer">' + escapeHtml(emptyStateMessage || 'No questions to preview.') + '</div></div>';
        }

        return questions.map(function (rawQuestion, index) {
          var question = normalizePreviewQuestion(rawQuestion, index);
          var hasHtml = /<\/?[a-z][\s\S]*>/i.test(question.questionText);
          var safeQuestionHtml = hasHtml ? question.questionText : escapeHtml(question.questionText).replace(/\n/g, '<br/>');

          var optionsMarkup = '';
          var optionMarker = question.questionType === 'multiple_choice' ? '☐' : '◯';
          if (Array.isArray(question.options) && question.options.length) {
            var optionsClassName = question.optionLayout === 'side_by_side'
              ? 'qm-preview-options is-side-by-side'
              : 'qm-preview-options';
            optionsMarkup = '<ul class="' + optionsClassName + '">' + question.options.map(function (opt) {
              return '<li>' + optionMarker + ' ' + escapeHtml(opt) + '</li>';
            }).join('') + '</ul>';
          }

          var answerValues = parseAnswerValues(question.answerKey);
          var answersMarkup = answerValues.length
            ? '<div class="qm-preview-answer"><strong>Answer:</strong> ' + answerValues.map(escapeHtml).join(', ') + '</div>'
            : '';

          return (
            '<div class="qm-preview-card">' +
              '<div class="qm-preview-qmeta">' +
                '<span>Q' + String(question.positionIndex) + ' • ' + toDisplayQuestionType(question.questionType) + '</span>' +
                '<span>' + String(question.marks) + ' mark' + (Number(question.marks) === 1 ? '' : 's') + '</span>' +
              '</div>' +
              '<div class="qm-preview-qtext">' + safeQuestionHtml + '</div>' +
              (window.QuestionBuilderFlow ? window.QuestionBuilderFlow.previewMedia(rawQuestion.media) : '') +
              optionsMarkup +
              answersMarkup +
            '</div>'
          );
        }).join('');
      }

      function buildPreviewPayloadFromQuestionModal() {
        var questions = collectQuestionItems();
        var setTitle = questionSetTitleInput ? String(questionSetTitleInput.value || '').trim() : '';
        var assessmentLabel = getSelectedOptionLabel(questionAssessmentSelect);
        var classLabel = getSelectedOptionLabel(questionClassSelect);
        var subjectLabel = getSelectedOptionLabel(questionSubjectSelect);
        var termLabel = getSelectedOptionLabel(questionTermSelect);
        var schoolYearLabel = getSelectedOptionLabel(questionSchoolYearSelect);
        var isOpenBook = questionOpenBookSelect ? String(questionOpenBookSelect.value) === 'true' : false;
        var isTimed = questionTimeModeSelect
          ? String(questionTimeModeSelect.value || 'timed').toLowerCase() !== 'unlimited'
          : true;
        var timeLimitValue = questionTimeLimitInput ? Number.parseInt(String(questionTimeLimitInput.value || '').trim(), 10) : NaN;
        var maxAttemptsValue = questionMaxAttemptsInput ? Number.parseInt(String(questionMaxAttemptsInput.value || '').trim(), 10) : 1;
        maxAttemptsValue = Number.isInteger(maxAttemptsValue) && maxAttemptsValue > 0 ? maxAttemptsValue : 1;

        var contextBits = [];
        contextBits.push(isOpenBook ? 'Open book' : 'Closed book');
        contextBits.push((isTimed && Number.isInteger(timeLimitValue) && timeLimitValue > 0 ? (String(timeLimitValue) + ' min') : 'No time limit'));
        contextBits.push(maxAttemptsValue + (maxAttemptsValue === 1 ? ' attempt' : ' attempts'));

        var questionCardLayout = questionItems
          ? String(questionItems.getAttribute('data-layout-mode') || 'stacked').toLowerCase()
          : 'stacked';
        questionCardLayout = questionCardLayout === 'side_by_side' ? 'side_by_side' : 'stacked';

        return {
          questions: questions,
          contextBits: contextBits,
          cardsMarkup: buildPreviewCardsMarkup(questions, 'No questions to preview yet. Add and fill at least one question.'),
          questionCardLayout: questionCardLayout,
          meta: {
            title: setTitle,
            assessment: assessmentLabel,
            className: classLabel,
            subject: subjectLabel,
            term: termLabel,
            schoolYear: schoolYearLabel,
          },
        };
      }

      function buildPreviewPayloadFromQuestionSet(setData, fallbackScope) {
        var scope = fallbackScope || {};
        var setTitle = String(setData.setTitle || setData.set_title || scope.setTitle || 'Question Set').trim();
        var assessmentLabel = String(setData.assessmentTitle || setData.assessment_title || scope.assessmentTitle || '').trim();
        var classLabel = String(setData.className || setData.class_name || scope.className || '').trim();
        var subjectLabel = String(setData.subjectName || setData.subject_name || scope.subjectName || '').trim();
        var openBookRaw = (setData.openBook !== undefined && setData.openBook !== null)
          ? setData.openBook
          : setData.open_book;
        var isOpenBook = String(openBookRaw).toLowerCase() === 'true' || Number(openBookRaw) === 1;
        var timeLimitRaw = (setData.timeLimitMinutes !== undefined && setData.timeLimitMinutes !== null)
          ? setData.timeLimitMinutes
          : setData.time_limit_minutes;
        var timeLimitValue = Number.parseInt(String(timeLimitRaw === undefined || timeLimitRaw === null ? '' : timeLimitRaw), 10);
        var maxAttemptsRaw = (setData.maxAttempts !== undefined && setData.maxAttempts !== null)
          ? setData.maxAttempts
          : setData.max_attempts;
        var maxAttemptsValue = Number.parseInt(String(maxAttemptsRaw === undefined || maxAttemptsRaw === null ? '' : maxAttemptsRaw), 10);
        maxAttemptsValue = Number.isInteger(maxAttemptsValue) && maxAttemptsValue > 0 ? maxAttemptsValue : 1;
        var questionCardLayout = String(setData.questionCardLayout || setData.question_card_layout || 'stacked').trim().toLowerCase();
        questionCardLayout = questionCardLayout === 'side_by_side' ? 'side_by_side' : 'stacked';

        var contextBits = [];
        contextBits.push(isOpenBook ? 'Open book' : 'Closed book');
        contextBits.push((Number.isInteger(timeLimitValue) && timeLimitValue > 0 ? (String(timeLimitValue) + ' min') : 'No time limit'));
        contextBits.push(maxAttemptsValue + (maxAttemptsValue === 1 ? ' attempt' : ' attempts'));

        var questions = Array.isArray(setData.questions) ? setData.questions : [];
        return {
          questions: questions,
          contextBits: contextBits,
          cardsMarkup: buildPreviewCardsMarkup(questions, 'No questions found in this set.'),
          questionCardLayout: questionCardLayout,
          meta: {
            title: setTitle,
            assessment: assessmentLabel,
            className: classLabel,
            subject: subjectLabel,
            term: '',
            schoolYear: '',
          },
        };
      }

      function buildAssessmentMetaLine(meta) {
        var safeMeta = meta || {};
        var assessmentLabel = String(safeMeta.assessment || '').trim();
        var classLabel = String(safeMeta.className || '').trim();
        var subjectLabel = String(safeMeta.subject || '').trim();
        var termLabel = String(safeMeta.term || '').trim();
        var yearLabel = String(safeMeta.schoolYear || '').trim();

        var assessmentLower = assessmentLabel.toLowerCase();
        var classLower = classLabel.toLowerCase();
        var subjectLower = subjectLabel.toLowerCase();

        var metaBits = [];
        if (assessmentLabel) metaBits.push(assessmentLabel);
        if (classLabel && (!assessmentLower || assessmentLower.indexOf(classLower) === -1)) {
          metaBits.push(classLabel);
        }
        if (subjectLabel && (!assessmentLower || assessmentLower.indexOf(subjectLower) === -1)) {
          metaBits.push(subjectLabel);
        }
        if (termLabel) metaBits.push('Term: ' + termLabel);
        if (yearLabel) metaBits.push('Year: ' + yearLabel);

        return metaBits.join(' • ');
      }

      function renderQuestionPreviewPayload(payload) {
        if (!qmPreviewBody || !payload) return;
        var chunks = [];

        var now = new Date();
        var metaLine = buildAssessmentMetaLine(payload.meta);
        var previewTitleLine = String((payload.meta && payload.meta.title) || '').trim() || 'Question Set';

        chunks.push(
          '<div class="qm-preview-doc-header">' +
            '<div class="qm-preview-doc-left">' +
              (previewSchoolLogo ? ('<img src="' + escapeHtml(previewSchoolLogo) + '" alt="School Logo" class="qm-preview-doc-logo" />') : '') +
              '<div>' +
                '<p class="qm-preview-doc-school">' + escapeHtml(previewSchoolName || 'School') + '</p>' +
                '<p class="qm-preview-doc-title">' + escapeHtml(previewTitleLine) + '</p>' +
                (metaLine ? ('<p class="qm-preview-doc-subline">' + escapeHtml(metaLine) + '</p>') : '') +
              '</div>' +
            '</div>' +
            '<div class="qm-preview-doc-meta">' +
              '<div>Previewed: ' + escapeHtml(now.toLocaleString()) + '</div>' +
              (payload.questions.length ? ('<div>Total Questions: ' + String(payload.questions.length) + '</div>') : '') +
            '</div>' +
          '</div>'
        );
        if (Array.isArray(payload.contextBits) && payload.contextBits.length) {
          chunks.push(
            '<div class="qm-preview-context">' +
              payload.contextBits.map(function (bit) {
                return '<span>' + escapeHtml(String(bit || '')) + '</span>';
              }).join('') +
            '</div>'
          );
        }
        var cardsLayoutClass = String(payload.questionCardLayout || 'stacked').toLowerCase() === 'side_by_side'
          ? 'qm-preview-cards is-side-by-side'
          : 'qm-preview-cards';
        chunks.push(
          '<div class="' + cardsLayoutClass + '">' +
            payload.cardsMarkup
              .replace(/qm-preview-card/g, 'set-preview-question')
              .replace(/qm-preview-qmeta/g, 'set-preview-question-head')
              .replace(/qm-preview-qtext/g, 'set-preview-question-text') +
          '</div>'
        );
        qmPreviewBody.innerHTML = chunks.join('');
        activeQuestionPreviewPayload = payload;
      }

