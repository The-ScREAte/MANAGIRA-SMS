      function openQuestionPreview() {
        if (!qmPreviewOverlay) return;
        renderQuestionPreview();
        qmPreviewOverlay.classList.add('show');
        qmPreviewOverlay.setAttribute('aria-hidden','false');
      }

      function closeQuestionPreview() {
        if (!qmPreviewOverlay) return;
        qmPreviewOverlay.classList.remove('show');
        qmPreviewOverlay.setAttribute('aria-hidden','true');
      }

      function populateQuestionsFromExtracted(extractedQuestions, sourceLabel) {
        if (!questionItems) return;
        const normalizedQuestions = Array.isArray(extractedQuestions)
          ? extractedQuestions.map((item, index) => {
            const type = normalizeExtractedQuestionType(item.questionType);
            var questionText = String(item.questionText || item.question || '').trim();

            // Skip section headers that slipped through
            if (/^[A-G]\s+(MULTIPLE|TRUE|FILL|MATCHING|SHORT|ESSAY)/i.test(questionText)) return null;
            if (/^GENERAL INSTRUCTIONS/i.test(questionText)) return null;
            if (/End of Paper/i.test(questionText)) return null;
            if (questionText.length < 4) return null;

            let options = Array.isArray(item.options)
              ? item.options.map((opt) => String(opt || "").trim()).filter(Boolean)
              : [];
            if (type === "true_false" && !options.length) options = ["True", "False"];
            let extractedAnswers = [];
            if (Array.isArray(item.answerKeys)) {
              extractedAnswers = item.answerKeys.map((ans) => String(ans || "").trim()).filter(Boolean);
            } else if (item.answerKey !== undefined && item.answerKey !== null) {
              extractedAnswers = parseAnswerValues(item.answerKey);
            } else if (item.answer !== undefined && item.answer !== null) {
              extractedAnswers = parseAnswerValues(item.answer);
            }

            const marks = Number(item.marks || item.mark || item.points || 1);
            const questionNumber = Number(item.questionNumber);
            return {
              questionNumber: Number.isInteger(questionNumber) && questionNumber > 0 ? questionNumber : (index + 1),
              questionType: ["multiple_choice", "single_choice", "true_false", "short_text", "essay"].includes(type) ? type : "short_text",
              questionText: questionText,
              options,
              answerKeys: extractedAnswers,
              marks: Number.isFinite(marks) && marks > 0 ? marks : 1,
            };
          }).filter((item) => item && item.questionText)
          : [];

        normalizedQuestions.sort((a, b) => a.questionNumber - b.questionNumber);
        if (!normalizedQuestions.length) {
          updateQuestionModalStatus("No questions were detected in this file.", true);
          return;
        }

        questionItems.innerHTML = "";
        normalizedQuestions.forEach((question) => questionItems.appendChild(buildQuestionItem(question)));
        renumberQuestionCards();
        updateQuestionCount();
        saveDraft();

        const sourceText = sourceLabel ? (" from " + sourceLabel) : "";
        updateQuestionModalStatus(normalizedQuestions.length + " question" + (normalizedQuestions.length === 1 ? "" : "s") + " extracted" + sourceText + ". Review and save.", false);
      }

      async function loadQuestionSets(options) {
        const config = options || {};
        const includeAllAssessments = Boolean(config.includeAllAssessments);
        const assessmentId = questionAssessmentSelect ? questionAssessmentSelect.value : "";
        const requestUrl = includeAllAssessments
          ? `/common/assessment/questions?classId=<%= classId %>&subjectId=<%= subjectId %>&termId=<%= currentTerm.term_id %>`
          : `/common/assessment/questions?classId=<%= classId %>&subjectId=<%= subjectId %>&termId=<%= currentTerm.term_id %>&assessmentId=${encodeURIComponent(assessmentId || "")}`;
        const response = await fetch(requestUrl, { headers: { "Accept": "application/json" } });
        const payload = await response.json();
        if (!response.ok || !payload.success) {
          throw new Error(payload.error || "Failed to load question sets.");
        }
        return {
          sets: Array.isArray(payload.sets) ? payload.sets : [],
          assessment: payload.assessment || null,
        };
      }

      async function hydrateQuestionModalFromServer() {
        if (!questionItems) return;
        updateQuestionModalStatus("Loading question sets...", false);
        let loaded = await loadQuestionSets();
        let sets = loaded.sets || [];

        // Sync helper: if current assessment has no set in view/edit mode,
        // find any existing set for this class/subject/term and switch to it.
        if (!sets.length && (questionModalMode === "view" || questionModalMode === "edit")) {
          const fallbackLoaded = await loadQuestionSets({ includeAllAssessments: true });
          const fallbackSets = Array.isArray(fallbackLoaded.sets) ? fallbackLoaded.sets : [];
          if (fallbackSets.length) {
            const firstSet = fallbackSets[0];
            if (questionAssessmentSelect && firstSet && Number(firstSet.assessmentId || 0) > 0) {
              questionAssessmentSelect.value = String(firstSet.assessmentId);
            }
            loaded = await loadQuestionSets();
            sets = loaded.sets || [];
          }
        }

        if (loaded.assessment && Number(loaded.assessment.assessmentId || 0) > 0) {
          assessmentRuleMap.set(Number(loaded.assessment.assessmentId), loaded.assessment);
        }
        questionItems.innerHTML = "";
        renderAssessmentRulesSummary();
        updateHeaderQuestionButtons(sets.length > 0);

        if (!sets.length) {
          currentQuestionSetId = null;
          activeLoadedQuestionSet = null;
          if (questionModalMode === "create" || questionModalMode === "edit") {
            questionItems.appendChild(buildQuestionItem());
            updateQuestionModalStatus("No question set found for this assessment. Create one now.", false);
          } else {
            updateQuestionModalStatus("No questions have been set for this assessment yet.", false);
          }
          applyQuestionModalMode();
          renumberQuestionCards();
          updateQuestionCount();
          return;
        }

        const selectedSet = sets[0];
        activeLoadedQuestionSet = selectedSet;
        currentQuestionSetId = selectedSet.questionSetId || null;
        if (questionSetTitleInput) questionSetTitleInput.value = selectedSet.setTitle || "";
        if (questionSetDescriptionInput) questionSetDescriptionInput.value = selectedSet.setDescription || "";
        (selectedSet.questions || []).forEach((question) => questionItems.appendChild(buildQuestionItem(question)));

        if (!selectedSet.questions || !selectedSet.questions.length) {
          questionItems.appendChild(buildQuestionItem());
        }

        if (questionModalMode === "create") {
          updateQuestionModalStatus(`Questions already exist for this assessment (status: ${String(selectedSet.reviewStatus || "pending").toLowerCase()}). Use Edit Questions to update.`, true);
        } else {
          updateQuestionModalStatus(`Loaded ${selectedSet.questions ? selectedSet.questions.length : 0} questions.`, false);
        }
        applyQuestionModalMode();
        renumberQuestionCards();
        updateQuestionCount();
      }

      if (setQuestionsButton) {
        setQuestionsButton.addEventListener("click", async () => {
          const existingDraft = loadDraft();
          openQuestionModal("create");
          currentQuestionSetId = null;
          activeLoadedQuestionSet = null;
          if (questionSetTitleInput) questionSetTitleInput.value = "";
          if (questionSetDescriptionInput) questionSetDescriptionInput.value = "";
          if (questionItems) {
            questionItems.innerHTML = "";
            questionItems.appendChild(buildQuestionItem());
          }
          updateQuestionModalStatus("Create a question set for this assessment.", false);
          renderAssessmentRulesSummary();
          applyQuestionModalMode();
          renumberQuestionCards();
          updateQuestionCount();

          try {
            await hydrateQuestionModalFromServer();
            // Only restore local draft when no server-backed set exists for selected assessment.
            if (existingDraft && !currentQuestionSetId) {
              restoreDraft(existingDraft);
              updateQuestionModalStatus("Draft restored from last session.", false);
            }
          } catch (error) {
            updateQuestionModalStatus(error.message || "Failed to load question sets.", true);
            if (existingDraft) {
              restoreDraft(existingDraft);
              updateQuestionModalStatus("Draft restored from last session.", false);
            }
          }
        });
      }

      if (viewQuestionsButton) {
        viewQuestionsButton.addEventListener("click", async () => {
          openQuestionModal("edit", "View Questions");
          applyQuestionModalMode();
          try {
            await hydrateQuestionModalFromServer();
          } catch (error) {
            updateQuestionModalStatus(error.message || "Failed to load question sets.", true);
          }
        });
      }

      if (editQuestionsButton) {
        editQuestionsButton.addEventListener("click", async () => {
          openQuestionModal("edit");
          applyQuestionModalMode();
          try {
            await hydrateQuestionModalFromServer();
          } catch (error) {
            updateQuestionModalStatus(error.message || "Failed to load question sets.", true);
          }
        });
      }

      if (questionModalClose) {
        questionModalClose.addEventListener("click", closeQuestionModal);
      }

      if (questionModalOverlay) {
        questionModalOverlay.addEventListener("click", (event) => {
          if (event.target === questionModalOverlay) {
            closeQuestionModal();
          }
        });
      }

      // Wire preview buttons
      if (qmPreviewOpenButton)  qmPreviewOpenButton.addEventListener('click', openQuestionPreview);
      if (qmPreviewCloseButton) qmPreviewCloseButton.addEventListener('click', closeQuestionPreview);
      if (qmPreviewPrintButton) qmPreviewPrintButton.addEventListener('click', printQuestionPreview);
      if (qmPreviewOverlay) {
        qmPreviewOverlay.addEventListener('click', function(e) {
          if (e.target === qmPreviewOverlay) closeQuestionPreview();
        });
      }

      if (questionAssessmentSelect) {
        questionAssessmentSelect.addEventListener("change", async () => {
          renderAssessmentRulesSummary();
          try {
            await hydrateQuestionModalFromServer();
          } catch (error) {
            updateQuestionModalStatus(error.message || "Failed to load question sets.", true);
          }
        });
      }

      if (addQuestionItemButton) {
        addQuestionItemButton.addEventListener("click", () => {
          if (!questionItems) return;
          questionItems.appendChild(buildQuestionItem());
          applyAssessmentMarksLimit(selectedAssessmentRule ? selectedAssessmentRule.maxScore : null);
          renumberQuestionCards();
          updateQuestionCount();
          saveDraft();
        });
      }

      if (qmClearDraftButton) {
        qmClearDraftButton.addEventListener("click", () => {
          clearDraft();
          if (questionItems) questionItems.innerHTML = "";
          if (questionSetTitleInput) questionSetTitleInput.value = "";
          if (questionSetDescriptionInput) questionSetDescriptionInput.value = "";
          if (questionItems) questionItems.appendChild(buildQuestionItem());
          renumberQuestionCards();
          updateQuestionCount();
        });
      }

      if (qmUploadPdfBtn && qmPdfFileInput) {
        renderUploadButtonIdle();

        qmUploadPdfBtn.addEventListener("click", () => {
          qmPdfFileInput.value = "";
          qmPdfFileInput.click();
        });

        qmPdfFileInput.addEventListener("change", async () => {
          const file = qmPdfFileInput.files && qmPdfFileInput.files[0] ? qmPdfFileInput.files[0] : null;
          if (!file) return;
          const formData = new FormData();
          formData.append("examFile", file);

          qmUploadPdfBtn.disabled = true;
          setUploadButtonLoading("Extracting questions...");
          updateQuestionModalStatus("Extracting questions from file...", false);
          try {
            const response = await fetch("/common/assessment/questions/extract-file", {
              method: "POST",
              body: formData,
            });
            const payload = await response.json();
            if (!response.ok || !payload.success) {
              throw new Error(payload.error || "Failed to extract questions from file.");
            }
            populateQuestionsFromExtracted(payload.questions || [], file.name || "file");
            applyQuestionModalMode();
          } catch (error) {
            updateQuestionModalStatus(error.message || "Failed to extract questions from file.", true);
          } finally {
            qmUploadPdfBtn.disabled = false;
            renderUploadButtonIdle();
          }
        });
      }

      if (saveQuestionSetButton) {
        saveQuestionSetButton.addEventListener("click", async () => {
          const questions = collectQuestionItems();
          if (!questions.length) {
            updateQuestionModalStatus("Add at least one question before saving.", true);
            return;
          }

          renderAssessmentRulesSummary();
          const selectedRule = selectedAssessmentRule;
          if (!selectedRule) {
            updateQuestionModalStatus("Select an assessment to apply question rules.", true);
            return;
          }

          const totalMarks = questions.reduce((sum, item) => sum + Number(item.marks || 0), 0);
          if (Number(totalMarks) > Number(selectedRule.maxScore || 0)) {
            updateQuestionModalStatus(`Total question marks (${totalMarks}) cannot exceed assessment max score (${selectedRule.maxScore}).`, true);
            return;
          }

          const hasInvalidMarks = questions.some((item) => Number(item.marks || 0) <= 0 || Number(item.marks || 0) > Number(selectedRule.maxScore || 0));
          if (hasInvalidMarks) {
            updateQuestionModalStatus(`Each question mark must be between 1 and ${selectedRule.maxScore}.`, true);
            return;
          }

          const payload = {
            questionSetId: questionModalMode === "edit" ? currentQuestionSetId : null,
            classId: Number("<%= classId %>"),
            subjectId: Number("<%= subjectId %>"),
            termId: Number("<%= currentTerm.term_id %>"),
            assessmentId: Number(questionAssessmentSelect ? questionAssessmentSelect.value : 0),
            openBook: questionOpenBookSelect ? String(questionOpenBookSelect.value) === "true" : false,
            timeLimitMinutes: questionTimeLimitInput ? String(questionTimeLimitInput.value || "").trim() : "",
            setTitle: String(questionSetTitleInput ? questionSetTitleInput.value : "").trim() || "Question Set",
            setDescription: String(questionSetDescriptionInput ? questionSetDescriptionInput.value : "").trim(),
            questions,
          };

          updateQuestionModalStatus("Saving question set...", false);
          try {
            const response = await fetch("/common/assessment/questions/upsert", {
              method: "POST",
              headers: {
                "Content-Type": "application/json",
                "Accept": "application/json",
              },
              body: JSON.stringify(payload),
            });
            const result = await response.json();
            if (!response.ok || !result.success) {
              throw new Error(result.error || "Failed to save question set.");
            }
            currentQuestionSetId = result.questionSetId || currentQuestionSetId;
            updateHeaderQuestionButtons(true);
            updateQuestionModalStatus("Question set submitted for review.", false);
            clearDraft();
            window.location.reload();
          } catch (error) {
            updateQuestionModalStatus(error.message || "Failed to save question set.", true);
          }
        });
      }

      if (questionModalOverlay) {
        questionModalOverlay.addEventListener("input", saveDraft);
        questionModalOverlay.addEventListener("change", saveDraft);
      }

      (async function syncInitialQuestionSetState() {
        try {
          const loaded = await loadQuestionSets({ includeAllAssessments: true });
          const hasAnySet = Array.isArray(loaded.sets) && loaded.sets.length > 0;
          updateHeaderQuestionButtons(hasAnySet);
        } catch (_) {
        }
      })();

      // Handle saving scores functionality
      // Support both header button (embedded) and legacy form button
      const saveButton = document.getElementById("header-save-scores-button") ||
                         document.getElementById("save-all-scores-button");
      if (!saveButton) return;

      saveButton.addEventListener("click", async function () {
          const formElement = document.getElementById("save-scores-form");
          const formData = new FormData(formElement);
          const spinner = document.getElementById("loading-spinner");
          const scoreInputs = formElement
            ? Array.prototype.slice.call(formElement.querySelectorAll('input[name^="scores["]'))
            : [];

          // Show loading spinner
          spinner.style.display = "block";

          // Clear any previous invalid markers before validating this save attempt.
          scoreInputs.forEach((input) => {
            input.classList.remove("score-input-invalid");
            input.removeAttribute("title");
          });

          // Transform FormData into a format suitable for sending as JSON
          const scoresData = {};
          let hasInvalidScore = false;
          let invalidCount = 0;

          formData.forEach((value, key) => {
            const matches = key.match(/^scores\[(\d+)\]\[(\d+)\]$/);
            if (matches) {
              const studentId = matches[1];
              const assessmentId = matches[2];
              const inputElement = document.querySelector(
                `input[name="${key}"]`
              );
              const maxScore = parseFloat(inputElement.getAttribute("max"));
              const score = parseFloat(value);

              if (!scoresData[studentId]) {
                scoresData[studentId] = {};
              }

              // Validate score: should be between 0 and the per-input max.
              if (!isNaN(score) && (score < 0 || score > maxScore)) {
                hasInvalidScore = true;
                invalidCount += 1;
                if (inputElement) {
                  inputElement.classList.add("score-input-invalid");
                  inputElement.setAttribute(
                    "title",
                    `Allowed range is 0 to ${maxScore}`
                  );
                }
              }

              scoresData[studentId][assessmentId] = value;
            }
          });

          if (hasInvalidScore) {
            alert(
              `${invalidCount} score field${invalidCount === 1 ? "" : "s"} highlighted in red. Allowed range is 0 to max score + 10 for each assessment. Please correct before saving.`
            );
            const firstInvalidInput = formElement.querySelector("input.score-input-invalid");
            if (firstInvalidInput && typeof firstInvalidInput.focus === "function") {
              firstInvalidInput.focus();
              firstInvalidInput.scrollIntoView({ behavior: "smooth", block: "center", inline: "nearest" });
            }
            // Hide loading spinner
            spinner.style.display = "none";
            return;
          }

          const subjectId = "<%= subjectId %>";
          const classId = "<%= classId %>";
          const termId = "<%= currentTerm.term_id %>";

          try {
            // Send scores data as JSON to the server
            const response = await fetch(
              `/common/saveAllScores?subjectId=${subjectId}&classId=${classId}&termId=${termId}`,
              {
                method: "POST",
                headers: {
                  "Content-Type": "application/json",
                },
                body: JSON.stringify({ scores: scoresData }),
              }
            );

            const responseData = await response.json();

            if (response.ok) {
              alert(responseData.message);
              window.location.reload();
            } else {
              alert(responseData.error);
            }
          } catch (error) {
            alert("An unexpected error occurred while saving scores.");
          } finally {
            // Hide loading spinner
            spinner.style.display = "none";
          }
        });
      })();
    </script>
  </body>
</html>
