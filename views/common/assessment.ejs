<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Assessment</title>
    <style>
      :root {
        --font-family: "<%= (session && session.fontStyle ? String(session.fontStyle).trim() : 'Inter') %>", sans-serif;
        --primary: var(--org-primary-color, #01535b);
        --primary-hover: var(--org-primary-hover, #014a51);
        --border: #e5e7eb;
        --bg: #f8fafc;
        --text: #0f172a;
      }


/* General Styling */
main {
  text-align: left;
  margin: 0 auto;
  width: 100%;
  max-width: 1200px;
  padding: 16px 16px 40px;
  flex: 1 0 auto;
}

body {
  font-family: var(--font-family);
  background: var(--bg);
  min-height: 100vh;
  display: flex;
  flex-direction: column;
}

.assessment-header {
  margin: 10px 0 16px;
  padding: 14px;
  border: 1px solid var(--border);
  border-radius: 12px;
  background: #fff;
  box-shadow: 0 4px 14px rgba(15, 23, 42, 0.04);
}

.meta-toggle {
  width: 100%;
  border: none;
  background: transparent;
  display: flex;
  align-items: center;
  justify-content: space-between;
  cursor: pointer;
  padding: 0;
  text-align: left;
}

.meta-toggle:hover,
.meta-toggle:focus,
.meta-toggle:focus-visible,
.meta-toggle:active {
  background: transparent !important;
  box-shadow: none;
  color: inherit;
}

.meta-toggle-title {
  margin: 0;
  color: var(--text);
  font-size: 1.05rem;
  font-weight: 700;
}

.meta-toggle-icon {
  color: #64748b;
  font-size: 22px;
  line-height: 1;
  transition: transform 0.2s ease;
}

.assessment-header.open .meta-toggle-icon {
  transform: rotate(90deg);
}

.meta-content {
  margin-top: 10px;
  border-top: 1px solid var(--border);
  padding-top: 10px;
}

.meta-row {
  margin: 0 0 6px;
  color: #475569;
  font-size: 0.95rem;
}

.meta-row:last-child {
  margin-bottom: 0;
}

.meta-label {
  color: var(--text);
  font-weight: 600;
}

/* Flash Messages
.flash-success {
  color: green;
  font-weight: bold;
}

.flash-error {
  color: red;
  font-weight: bold;
} */

/* Buttons */
.center-link {
  display: flex;
  justify-content: flex-start;
  margin-bottom: 12px;
}

.top-nav-link {
  justify-content: center;
  padding-top: 10px;
}

.center-link button {
  margin: 0;
  padding: 8px 12px;
  border: none;
  background-color: var(--primary);
  color: white;
  cursor: pointer;
  border-radius: 8px;
  font-size: 0.88rem;
  font-weight: 600;
  transition: background-color 0.3s ease;
}

.center-link button:hover {
  background-color: var(--primary-hover);
}

/* Table Container */
.table-container {
  overflow-x: auto;
  margin: 12px auto;
  border: 1px solid var(--border);
  border-radius: 12px;
  background: #fff;
  box-shadow: 0 4px 14px rgba(15, 23, 42, 0.04);
}

/* Table Styling */
table {
  width: 100%;
  min-width: 900px;
  border-collapse: collapse;
  background-color: #ffffff;
  margin: 0 auto;
  box-shadow: none;
}

th,
td {
  padding: 15px; /* Added padding for better spacing */
  border: 1px solid #ddd;
  text-align: center; /* Center align text */
  font-size: 14px;
}

th {
  background-color: var(--primary);
  color: white;
  font-weight: bold;
}

td {
  background-color: #f9f9f9;
}

tr:nth-child(even) td {
  background-color: #f1f1f1;
}

/* Sticky # and Student Name columns */
table th:first-child,
table td:first-child {
  position: sticky;
  left: 0;
  background: #ffffff;
  z-index: 1;
  min-width: 20px;
  text-align: center;
  box-shadow: 2px 0 5px rgba(0, 0, 0, 0.05);
}

table th:nth-child(2),
table td:nth-child(2) {
  position: sticky;
  left: 30px;
  background: #ffffff;
  z-index: 2;
  text-align: left;
  font-weight: 600;
  color: #000;
  box-shadow: 2px 0 5px rgba(0, 0, 0, 0.05);
}

/* Form Styling */
#save-scores-form {
  width: 100%;
  max-width: 1700px;
  margin: 0 auto 16px;
  padding: 16px;
  background-color: #ffffff;
  border: 1px solid var(--border);
  border-radius: 12px;
  box-shadow: 0 4px 14px rgba(15, 23, 42, 0.04);
}

input[type="number"] {
  width: 100%;
  max-width: 100px;
  padding: 8px;
  border: 1px solid #ccc;
  border-radius: 4px;
  text-align: center;
  font-size: 14px;
}

input[type="number"]:focus {
  border-color: var(--primary);
  outline: none;
}

/* Spinner Styling */
.spinner {
  display: none;
  position: fixed;
  z-index: 999;
  top: 50%;
  left: 50%;
  width: 50px;
  height: 50px;
  margin: -25px 0 0 -25px;
  border: 5px solid #f3f3f3;
  border-radius: 50%;
  border-top: 5px solid var(--primary);
  animation: spin 1s linear infinite;
}

.assigned-employees {
  margin: 6px 0 0;
  display: block;
  color: #475569;
  font-size: 0.88rem;
}

.assigned-employees .main {
  color: var(--primary);
  font-weight: 700;
}

.teacher-separator {
  color: #94a3b8;
  margin: 0 6px;
}

@keyframes spin {
  0% {
    transform: rotate(0deg);
  }
  100% {
    transform: rotate(360deg);
  }
}

/* Responsive Design */
@media screen and (max-width: 768px) {
  /* Make student names slightly larger */
  #students-table-body td:nth-child(2) {
    font-size: 0.73rem;
    font-weight: 600;
  }

  th,
  td {
    padding: 10px;
    font-size: 12px;
  }

  input[type="number"] {
    max-width: 80px;
    font-size: 12px;
    padding: 6px;
  }

  #save-scores-form {
    padding: 12px;
  }

  .center-link button {
    width: auto;
    font-size: 0.82rem;
    padding: 7px 10px;
  }

  main {
    padding: 12px 10px 28px;
  }

  .top-nav-link {
    padding-top: 6px;
  }

  .meta-toggle-title {
    font-size: 0.95rem;
  }
}

@media screen and (max-width: 480px) {
  /* Student Name column: wrap text and reduce spacing */
  table td:nth-child(2),
  table th:nth-child(2) {
    font-size: 0.75rem;
    max-width: 80px;
    min-width: 70px;
    padding: 6px 8px;
    white-space: normal;
    word-break: break-word;
    line-height: 1.2;
  }

  #students-table-body td:nth-child(2) {
    font-weight: 500;
  }

  th,
  td {
    font-size: 11px;
    padding: 6px;
  }

  input[type="number"] {
    max-width: 65px;
    font-size: 11px;
    padding: 5px;
  }

  .center-link {
    flex-direction: row;
    gap: 10px;
  }

  .center-link button {
    width: auto;
  }
}

@media screen and (max-width: 768px) {
  body {
    padding-bottom: 0 !important;
  }
} 
    </style>
  </head>
  <body>
    <main>
      <div class="center-link top-nav-link">
         <div class="link-to-next-back">
                    <a href="/common/classDashboard?classId=<%= classId %>" class="back-link">Class Dashboard</a>
            </div>
      </div>
      <%- include('../partials/flash') %>

      <div class="assessment-header" id="assessment-meta-card">
        <button class="meta-toggle" type="button" id="assessment-meta-toggle" aria-expanded="false" aria-controls="assessment-meta-content">
          <span class="meta-toggle-title">Class / Subject / Teachers</span>
          <span class="meta-toggle-icon" aria-hidden="true">›</span>
        </button>
        <div class="meta-content" id="assessment-meta-content" hidden>
          <p class="meta-row"><span class="meta-label">Class:</span> <%= className %></p>
          <p class="meta-row"><span class="meta-label">Subject:</span> <%= subjectName %></p>
          <div class="meta-row"><span class="meta-label">Teachers:</span></div>
          <div class="assigned-employees">
            <% employees.forEach(function(employee, index) { %>
            <span>
              <% if (employee.main) { %>
              <span class="main">•</span>
              <% } %><%= employee.first_name %> <%= employee.last_name %>
            </span>
            <% if (index < employees.length - 1) { %>
              <span class="teacher-separator">/</span>
            <% } %>
            <% }); %>
          </div>
        </div>
      </div>

      <!-- Scores Section -->
      <form id="save-scores-form">
        <div class="table-container">
          <table>
            <thead>
              <tr>
                <th>#</th>
                <!-- Added column for numbering -->
                <th>Student Name</th>
                <% assessments.forEach(function(assessment) { %>
                <th>
                  <%= assessment.title %> (<%= assessment.weight %>%)<br />
                  <%= assessment.category %><br />
                  <small style="display:block; margin-top:4px; color:#e2e8f0;">Status: <%= assessment.can_edit_scores ? 'Editable' : assessment.access_reason %></small>
                  <hr />
                  Score Out Of: <%= assessment.max_score %>
                </th>
                <% }); %>
                <th>Total Subject Score</th>
                <th>Total Percentage</th>
                <th>Grade</th>
                <th>Position</th>
              </tr>
            </thead>

            <tbody id="students-table-body">
              <% // Sorting students by name in alphabetical order
              students.sort((a, b) => { if (a.last_name.toLowerCase() <
              b.last_name.toLowerCase()) return -1; if
              (a.last_name.toLowerCase() > b.last_name.toLowerCase()) return 1;
              if (a.first_name.toLowerCase() < b.first_name.toLowerCase())
              return -1; if (a.first_name.toLowerCase() >
              b.first_name.toLowerCase()) return 1; return 0; }); function
              getOrdinalSuffix(i) { const j = i % 10, k = i % 100; if (j == 1 &&
              k != 11) { return "st"; } if (j == 2 && k != 12) { return "nd"; }
              if (j == 3 && k != 13) { return "rd"; } return "th"; } %> <%
              students.forEach(function(student, index) { %>
              <tr>
                <td><%= index + 1 %></td>
                <!-- Numbering each row -->
                <td><%= student.first_name %> <%= student.last_name %></td>
                <% assessments.forEach(function(assessment) { %>
                <td>
                  <input
                    type="number"
                    name="scores[<%= student.student_id %>][<%= assessment.assessment_id %>]"
                    min="0"
                    max="<%= assessment.max_score + 10 %>"
                    step="0.1"
                    value="<%= student.scores ? student.scores[assessment.assessment_id] : '' %>"
                    <%= assessment.can_edit_scores ? '' : 'disabled' %>
                  />
                </td>
                <% }); %>

                <td>
                  <%= student.total_subject_score !== undefined &&
                  student.total_subject_score !== null ?
                  parseFloat(student.total_subject_score).toFixed(2) : '-' %>
                </td>
                <td>
                  <%= student.total_percentage !== undefined &&
                  student.total_percentage !== null ?
                  parseFloat(student.total_percentage).toFixed(2) : '-' %> %
                </td>
                <td><%= student.grade ? student.grade : '-' %></td>
                <td>
                  <%= student.position !== undefined && student.position !==
                  null ? student.position + getOrdinalSuffix(student.position) :
                  '-' %>
                </td>
              </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
        <div class="center-link">
          <button type="button" id="save-all-scores-button" <%= hasEditableAssessments ? '' : 'disabled' %>>
            Save All Scores
          </button>
        </div>
        <% if (!hasEditableAssessments) { %>
          <p style="margin: 0 0 10px 0; color: #b91c1c; font-weight: 600; text-align:center;">
            Score editing is disabled. Assessment is locked, inactive, or outside its edit window.
          </p>
        <% } %>
      </form>

      <!-- Loading Spinner -->
      <div class="spinner" id="loading-spinner"></div>
    </main>

    <script>
      (function () {
      const metaCard = document.getElementById("assessment-meta-card");
      const metaToggle = document.getElementById("assessment-meta-toggle");
      const metaContent = document.getElementById("assessment-meta-content");

      function setMetaOpen(isOpen) {
        if (!metaCard || !metaToggle || !metaContent) return;
        metaCard.classList.toggle("open", isOpen);
        metaToggle.setAttribute("aria-expanded", isOpen ? "true" : "false");
        metaContent.hidden = !isOpen;
      }

      if (metaToggle) {
        setMetaOpen(false);
        metaToggle.addEventListener("click", () => {
          const isOpen = metaToggle.getAttribute("aria-expanded") === "true";
          setMetaOpen(!isOpen);
        });
      }

      // Handle saving scores functionality
      const saveButton = document.getElementById("save-all-scores-button");
      if (!saveButton) return;

      saveButton.addEventListener("click", async function () {
          const formElement = document.getElementById("save-scores-form");
          const formData = new FormData(formElement);
          const spinner = document.getElementById("loading-spinner");

          // Show loading spinner
          spinner.style.display = "block";

          // Transform FormData into a format suitable for sending as JSON
          const scoresData = {};
          let hasInvalidScore = false;

          formData.forEach((value, key) => {
            const matches = key.match(/^scores\[(\d+)\]\[(\d+)\]$/);
            if (matches) {
              const studentId = matches[1];
              const assessmentId = matches[2];
              const inputElement = document.querySelector(
                `input[name="${key}"]`
              );
              const maxScore = parseFloat(inputElement.getAttribute("max"));
              const score = parseFloat(value);

              if (!scoresData[studentId]) {
                scoresData[studentId] = {};
              }

              // Validate score: should be between 0 and (maxScore + 10)
              if (!isNaN(score) && (score < 0 || score > maxScore + 10)) {
                hasInvalidScore = true;
              }

              scoresData[studentId][assessmentId] = value;
            }
          });

          if (hasInvalidScore) {
            alert(
              "Some scores exceed the allowed maximum limit (max score + 10). Please correct them before saving."
            );
            // Hide loading spinner
            spinner.style.display = "none";
            return;
          }

          const subjectId = "<%= subjectId %>";
          const classId = "<%= classId %>";

          try {
            // Send scores data as JSON to the server
            const response = await fetch(
              `/common/saveAllScores?subjectId=${subjectId}&classId=${classId}`,
              {
                method: "POST",
                headers: {
                  "Content-Type": "application/json",
                },
                body: JSON.stringify({ scores: scoresData }),
              }
            );

            const responseData = await response.json();

            if (response.ok) {
              alert(responseData.message);
              window.location.reload();
            } else {
              alert(responseData.error);
            }
          } catch (error) {
            alert("An unexpected error occurred while saving scores.");
          } finally {
            // Hide loading spinner
            spinner.style.display = "none";
          }
        });
      })();
    </script>
  </body>
</html>
