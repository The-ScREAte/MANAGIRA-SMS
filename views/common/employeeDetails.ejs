<style>
      :root {
        --font-family: "Inter", sans-serif;
      }


  body {
    font-family: var(--font-family);
    background-color: #f8f9fa;

    color: #333;
  }

  main {
    max-width: 900px;
    margin: 30px auto;
    padding: 0 20px;
  }

  h1 {
    font-size: 24px;
    margin-bottom: 20px;
    color: #01535b;
  }

  .btn {
    display: inline-block;
    padding: 8px 16px;
    margin: 5px;
    border: none;
    border-radius: 4px;
    cursor: pointer;
    text-decoration: none;
    font-size: 14px;
  }

  .btn-secondary {
    background-color: #01535b;
    color: #fff;
  }

  .employee-info-container {
    display: flex;
    align-items: center;
    gap: 20px;
    margin-bottom: 20px;
    justify-content: center;
  }

  .employee-image-container img {
    width: 120px;
    height: 120px;
    border-radius: 50%;
    border: 2px solid #6c757d;
    object-fit: cover;
  }

  .employee-details {
    flex: 1;
    font-size: 14px;
    color: #333;
    text-align: left;
  }

  .employee-details h2 {
    font-size: 18px;
    margin: 0 0 5px;
    color: #01535b;
  }

  .table-container {
    margin: 20px 0;
  }

  table {
    width: 100%;
    border-collapse: collapse;
  }

  th, td {
    padding: 8px;
    border: 1px solid #ddd;
    text-align: left;
  }

  th {
    background-color: #e9ecef;
    font-weight: bold;
  }

  td ul {
    margin: 0;
    padding-left: 15px;
  }

  .link-to-next-back {
    margin: 10px 0;
  }

  .modify-button {
    text-align: center;
    margin-top: 20px;
  }
</style>

</head>
<body>
  <% if (req.session && req.session.userRole !== 'Teacher' && req.session.userRole !== 'Supervisor') { %>
    <div class="link-to-next-back">
      <a href="/common/manageEmployees" class="btn btn-secondary">← Back to Manage Employees</a>
    </div>
  <% } %>

  <%- include('../partials/flash') %>

  <main>
    <h1>Employee Information</h1>

    <% if (loggedInUserId && loggedInUserId === employee.user_id) { %>
      <div class="link-to-next-back">
        <a href="/account/update" class="btn btn-secondary">Account Profile Settings</a>
      </div>
    <% } %>

    <div class="employee-info-container">
      <div class="employee-image-container">
        <% if (employee.image_url && employee.image_url !== 'profilePlaceholder.png') { %>
          <img src="<%= employee.image_url %>" alt="Employee Image" />
        <% } else { %>
          <img src="/images/profilePlaceholder.png" alt="Placeholder Image" />
        <% } %>
      </div>

      <div class="employee-details">
        <h2><%= employee.first_name %> <%= employee.last_name %></h2>
        <p><strong>Email:</strong> <%= employee.email %></p>
        <p><strong>Role:</strong> <%= employee.account_type %></p>
      
        <% if (isManager) { %>
          <p>
            <strong>Organization Name:</strong> <%= employee.organization_name %>
            <a href="/account/personalization" class="btn btn-secondary" style="padding: 2px 8px; font-size: 12px; margin-left: 10px;">Edit</a>
          </p>
          <p><strong>Nickname:</strong> <%= employee.nickname %></p>
          <p>
            <strong>Plan Name:</strong> <%= employee.plan_name %>
            <a href="/account/update-plan" class="btn btn-secondary" style="padding: 2px 8px; font-size: 12px; margin-left: 10px;">Edit</a>
          </p>
          <% if (employee.motto) { %>
            <p><strong>Motto:</strong> <%= employee.motto %></p>
          <% } %>
        <% } %>
      </div>
      

    <% if (employee.classes && employee.classes.length > 0) { %>
      <div class="table-container">
        <table>
          <thead>
            <tr>
              <th>Class</th>
              <th>Subjects Assigned</th>
            </tr>
          </thead>
          <tbody>
            <% employee.classes.forEach(cls => { %>
              <tr>
                <td><%= cls.class_name %></td>
                <td>
                  <ul>
                    <% cls.subjects.forEach(sub => { %>
                      <li><%= sub.subject_name %></li>
                    <% }) %>
                  </ul>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } %>

    <% if (!isManager && req.session && req.session.userRole !== 'Teacher' && req.session.userRole !== 'Supervisor') { %>
      <div class="link-to-next-back">
        <a href="/common/modifyEmployee?userId=<%= employee.user_id %>" class="btn btn-secondary">Modify</a>
      </div>
    <% } %>
  </main>
</body>
</html>
