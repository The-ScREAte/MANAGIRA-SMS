<style>
      :root {
        --font-family: "<%= (session && session.fontStyle ? String(session.fontStyle).trim() : 'Inter') %>", sans-serif;
      }


  body {
    font-family: var(--font-family);
    background-color: #f8f9fa;

    color: #333;
  }

  main {
    max-width: 900px;
    margin: 30px auto;
    padding: 0 20px;
  }

  h1 {
    font-size: 24px;
    margin-bottom: 20px;
    color: var(--org-primary-color);
  }

  .btn {
    display: inline-block;
    padding: 8px 16px;
    margin: 5px;
    border: none;
    border-radius: 4px;
    cursor: pointer;
    text-decoration: none;
    font-size: 14px;
  }

  .btn-secondary {
    background-color: var(--org-primary-color);
    color: #fff;
  }

  

  .employee-info-container {
    display: flex;
    align-items: center;
    gap: 20px;
    margin-bottom: 20px;
    justify-content: center;
  }

  .employee-image-container img {
    width: 120px;
    height: 120px;
    border-radius: 50%;
    border: 2px solid #6c757d;
    object-fit: cover;
  }

  .employee-details {
    flex: 1;
    min-width: 0;
    font-size: 14px;
    color: #333;
    text-align: left;
    overflow-wrap: anywhere;
  }

  /* Phones: the photo above the details, so a long email never pushes the page sideways. */
  @media (max-width: 560px) {
    .employee-info-container { flex-direction: column; gap: 12px; }
    .employee-details { width: 100%; }
  }

  .employee-details h2 {
    font-size: 18px;
    margin: 0 0 5px;
    color: var(--org-primary-color);
  }

  .table-container {
    margin: 20px 0;
  }

  table {
    width: 100%;
    border-collapse: collapse;
  }

  th, td {
    padding: 8px;
    border: 1px solid #ddd;
    text-align: left;
  }

  th {
    background-color: #e9ecef;
    font-weight: bold;
  }

  td ul {
    margin: 0;
    padding-left: 15px;
  }

  .link-to-next-back {
    margin: 10px 0;
  }

  /* In a drawer or a hub panel the frame already names the page: no heading, everything left-aligned. */
  .emp-embedded h1 { display: none; }
  main.emp-embedded { max-width: 680px !important; margin: 0 !important; padding: 22px 26px !important; box-sizing: border-box; text-align: left; }
  .emp-embedded .employee-info-container { gap: 16px; }
  .emp-embedded td ul { margin: 0; padding: 0; list-style: none; }
  .emp-embedded .link-to-next-back, .emp-embedded td, .emp-embedded th { text-align: left !important; }
  .emp-embedded .employee-info-container { justify-content: flex-start; }
  .emp-embedded .employee-image-container img { width: 84px; height: 84px; border: 1px solid #e2e8f0; }
  .emp-embedded .employee-details p { margin: 3px 0; color: #475569; }
  .emp-embedded .employee-details strong { color: #0f172a; font-weight: 600; }
  .emp-embedded .table-container { margin: 18px 0; border: 1px solid #e2e8f0; border-radius: 10px; overflow: hidden; }
  .emp-embedded table th, .emp-embedded table td { border: 0; border-bottom: 1px solid #eef0f3; padding: 10px 12px; font-size: 13.5px; }
  .emp-embedded table tr:last-child td { border-bottom: 0; }
  .emp-embedded table th { background: #f8fafc; color: #475569; font-size: 11.5px; text-transform: uppercase; letter-spacing: .03em; }
  .emp-embedded .link-to-next-back { margin: 0; }
  .emp-embedded .btn { margin: 0; padding: 9px 18px; border-radius: 9px; font-weight: 600; }
  .modify-button {
    text-align: center;
    margin-top: 20px;
  }
</style>

</head>
<body>

  <%- include('../partials/flash') %>

  <main class="<%= locals.isEmbedded ? 'emp-embedded' : '' %>">
    <h1>Employee Information</h1>

    <% if (loggedInUserId && loggedInUserId === employee.user_id) { %>
      <div class="link-to-next-back">
        <a href="/account/update" class="btn btn-secondary" target="_top">Account Profile Settings</a>
      </div>
    <% } %>

    <div class="employee-info-container">
      <div class="employee-image-container">
        <% if (employee.image_url && employee.image_url !== 'profilePlaceholder.png') { %>
          <img src="<%= publicImageUrl(employee.image_url) %>" alt="Employee Image" />
        <% } else { %>
          <img src="/images/profilePlaceholder.png" alt="Placeholder Image" />
        <% } %>
      </div>

      <div class="employee-details">
        <h2><%= (typeof formatDisplayName === 'function' ? formatDisplayName(employee) : [employee.first_name, employee.last_name].filter(Boolean).join(' ').trim()) %></h2>
        <p><strong>Email:</strong> <%= employee.email %></p>
        <p><strong>Role:</strong> <%= employee.account_type %></p>
        <% if (employee.date_of_birth) { %>
          <p><strong>Date of Birth:</strong> <%= (typeof formatDisplayDate === 'function' ? formatDisplayDate(employee.date_of_birth) : new Date(employee.date_of_birth).toLocaleDateString()) %></p>
        <% } %>
      
        <% if (isManager) { %>
          <p>
            <strong>Organization Name:</strong> <%= employee.organization_name %>
            <a href="/account/personalization" target="_top" class="btn btn-secondary" style="padding: 2px 8px; font-size: 12px; margin-left: 10px;">Edit</a>
          </p>
          <p><strong>Nickname:</strong> <%= employee.nickname %></p>
          <p>
            <strong>Plan Name:</strong> <%= employee.plan_name %>
            <a href="/account/update-plan" target="_top" class="btn btn-secondary" style="padding: 2px 8px; font-size: 12px; margin-left: 10px;">Edit</a>
          </p>
          <% if (employee.motto) { %>
            <p><strong>Motto:</strong> <%= employee.motto %></p>
          <% } %>
        <% } %>
      </div>
    </div>

    <% if (employee.classes && employee.classes.length > 0) { %>
      <div class="table-container">
        <table>
          <thead>
            <tr>
              <th>Class</th>
              <th>Subjects Assigned</th>
            </tr>
          </thead>
          <tbody>
            <% employee.classes.forEach(cls => { %>
              <tr>
                <td><%= cls.class_name %></td>
                <td>
                  <ul>
                    <% cls.subjects.forEach(sub => { %>
                      <li><%= sub.subject_name %></li>
                    <% }) %>
                  </ul>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } %>

    <% if (!isManager && req.session && req.session.userRole !== 'Teacher' && req.session.userRole !== 'Supervisor') { %>
      <div class="link-to-next-back">
        <a href="/common/modifyEmployee?userId=<%= employee.user_id %><%= locals.isEmbedded ? '&embed=workspace' : '' %>" class="btn btn-secondary">Modify</a>
      </div>
    <% } %>
  </main>
</body>
</html>
