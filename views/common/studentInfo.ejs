<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Student Info</title>
    <style>
      :root {
        --font-family: "<%= (session && session.fontStyle ? String(session.fontStyle).trim() : 'Inter') %>", sans-serif;
      }

      body {
        font-family: var(--font-family);
        background-color: #f8f9fa;
        margin: 0;
      }

      .container {
        width: 90%;
        max-width: 1200px;
        margin: 20px auto;
        background: #ffffff;
        border-radius: 8px;
        box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
        padding: 20px;
      }

      .btn {
        padding: 8px 16px;
        border: none;
        border-radius: 5px;
        cursor: pointer;
        text-decoration: none;
        font-size: 14px;
      }

      .btn-secondary {
        background-color: var(--org-primary-color);
        color: white;
      }

      .btn-secondary:hover {
        background-color: var(--org-primary-hover-fill, var(--org-primary-hover));
      }

      .btn-primary {
        background-color: var(--org-primary-color);
        color: white;
      }

      .btn-primary:hover {
        background-color: var(--org-primary-hover-fill, var(--org-primary-hover));
      }

      .student-info-container {
        display: grid;
        grid-template-columns: 1fr 2fr;
        gap: 20px;
        margin-bottom: 30px;
      }

      .student-image-container {
        text-align: center;
      }

      .student-image {
        width: 150px;
        height: 150px;
        border-radius: 50%;
        border: 2px solid #6c757d;
        object-fit: cover;
      }

      .student-details {
        display: flex;
        flex-direction: column;
        gap: 10px;
        font-size: 14px;
        color: #495057;
      }

      .student-details h2 {
        font-size: 20px;
        margin: 0;
        color: var(--org-primary-color);
      }

      .table-container {
        overflow-x: auto;
        margin-top: 20px;
      }

      table {
        width: 100%;
        border-collapse: collapse;
        margin-bottom: 20px;
      }

      table thead {
        background-color: var(--org-primary-color);
        color: rgb(255, 255, 255);
      }

      th,
      td {
        padding: 10px;
        text-align: left;
        border: 1px solid #dee2e6;
      }

      th {
        font-weight: bold;
      }

      /* Center buttons below the table */
      .actions-container {
        display: flex;
        justify-content: center;
        margin-top: 20px; /* Space between table and buttons */
        gap: 15px; /* Space between the buttons */
      }

      .actions-container .btn {
        font-size: 14px;
        padding: 8px 16px;
        width: auto;
        height: 50px;
        position: relative;
        top: 230px;
      }
    </style>
  </head>
  <body>
    <%- include('../partials/flash') %>
    <br />
    <!-- Back Button -->
    <div class="link-to-next-back">
      <a href="/common/archivedStudents" class="btn btn-secondary"
        >Back to Archived Students</a
      >
    </div>
    <hr />

    <div class="container">
      <!-- Student Info Section -->
      <div class="student-info-container">
        <!-- Student Image -->
        <div class="student-image-container">
          <% if (student.image_url && student.image_url !==
          'profilePlaceholder.png') { %>
          <img
            src="<%= student.image_url %>?v=<%= new Date().getTime() %>"
            alt="Student Image"
            class="student-image"
          />
          <% } else { %>
          <img
            src="/images/profilePlaceholder.png"
            alt="Placeholder Image"
            class="student-image"
          />
          <% } %>
        </div>

        <!-- Student Details -->
        <div class="student-details">
          <h2><%= (typeof formatDisplayName === 'function' ? formatDisplayName(student) : (student.first_name + ' ' + student.last_name)) %></h2>
          <p><strong>Gender:</strong> <%= student.gender %></p>
          <p><strong>Class:</strong> <%= student.class_name %></p>
          <p><strong>Graduation Group:</strong> <%= gradYearGroupName %></p>
          <p>
            <strong>Date of Birth:</strong> <%= (typeof formatDisplayDate === 'function' ? formatDisplayDate(student.date_of_birth) : new Date(student.date_of_birth).toLocaleDateString()) %>
          </p>
          <p><strong>Height:</strong> <%= student.height %> cm</p>
          <p><strong>Hometown:</strong> <%= student.hometown %></p>
          <% if (student.email) { %>
          <p><strong>Email:</strong> <%= student.email %></p>
          <% } %>
        </div>
      </div>

      <!-- Guardian Details -->
      <div class="table-container">
        <h2>Guardians</h2>

        <table>
          <thead>
            <tr>
              <th>Guardian Name</th>
              <th>Address</th>
              <th>Phone</th>
              <th>Email</th>
              <th>Hometown</th>
            </tr>
          </thead>
          <tbody>
            <% guardians.forEach(guardian => { %>
            <tr>
              <td><%= (typeof formatDisplayName === 'function' ? formatDisplayName(guardian) : [guardian.first_name, guardian.last_name].filter(Boolean).join(' ').trim()) %></td>
              <td><%= guardian.address %></td>
              <td><%= guardian.phone %></td>
              <td><%= guardian.email %></td>
              <td><%= guardian.hometown %></td>
            </tr>
            <% }) %>
          </tbody>
        </table>
      </div>

      <!-- Action Buttons -->
      <div class="actions-container">
        <a
          href="/common/editStudent?studentId=<%= student.student_id %>"
          class="btn btn-primary"
          >Modify Student Info</a
        >
        <a
          href="/transcript/transcript/<%= student.student_id %>"
          class="btn btn-primary"
          data-no-spa
          >Transcript</a>
      </div>
    </div>
  </body>
</html>
