<%
  const themeColor = (typeof session !== 'undefined' && session && session.themeColor) ? session.themeColor : 'teal';
  const themeColors = {
    teal: { primary: '#01535b', hover: '#014a51' },
    blue: { primary: '#2563eb', hover: '#1d4ed8' },
    green: { primary: '#2d5f4f', hover: '#245043' },
    purple: { primary: '#7c3aed', hover: '#6d28d9' },
    indigo: { primary: '#4f46e5', hover: '#4338ca' },
    rose: { primary: '#8b2635', hover: '#7a212e' },
    amber: { primary: '#d97706', hover: '#b45309' },
    slate: { primary: '#334155', hover: '#1e293b' }
  };
  const currentTheme = themeColors[themeColor] || themeColors.teal;
%>
<style>
:root {
  --border: #e5e7eb;
  --muted: #6b7280;
  --bg: #f9fafb;
  --primary: <%= currentTheme.primary %>;
  --primary-hover: <%= currentTheme.hover %>;
  --text: #111827;
  --font-family: "<%= (session && session.fontStyle ? String(session.fontStyle).trim() : 'Inter') %>", sans-serif;
}

body {
  background: var(--bg);
  font-family: var(--font-family);
  min-height: 100vh;
  display: flex;
  flex-direction: column;
}

main {
  flex: 1 0 auto;
  width: 100%;
}

.dashboard-shell {
  max-width: 1200px;
  margin: 0 auto;
  padding: 20px 16px 40px;
  width: 100%;
  flex: 1 0 auto;
}

.dashboard-grid {
  display: grid;
  grid-template-columns: 260px 1fr;
  gap: 24px;
  align-items: start;
}

.card {
  background: #fff;
  border: 1px solid var(--border);
  border-radius: 12px;
  box-shadow: 0 8px 24px rgba(15, 23, 42, 0.04);
}

.card-header {
  padding: 16px;
  border-bottom: 1px solid var(--border);
}

.card-body {
  padding: 16px;
}

.dashboard-main {
  background: transparent;
  border: none;
  box-shadow: none;
}

.dashboard-header {
  padding: 8px 4px 12px;
}

.dashboard-content {
  padding: 0;
}

.page-title {
  margin: 0;
  font-size: 28px;
  font-weight: 700;
  color: var(--text);
}

.card-title {
  margin: 0;
  font-size: 18px;
  font-weight: 700;
  color: var(--text);
}

.card-subtext {
  margin: 4px 0 0;
  color: var(--muted);
  font-size: 13px;
}

.eyebrow {
  margin: 0;
  text-transform: uppercase;
  letter-spacing: 0.06em;
  color: var(--muted);
  font-size: 11px;
  font-weight: 600;
}

.nav-card {
  padding: 14px 12px 16px;
  position: sticky;
  top: 80px;
  border-radius: 14px;
  border: 1px solid var(--border);
  box-shadow: 0 10px 26px rgba(15, 23, 42, 0.08);
}


.nav-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 4px 8px;
  margin: 4px 4px 10px;
  border-bottom: 1px solid var(--border);
}

.nav-header h3 {
  margin: 4px 0 0;
  font-size: 18px;
  color: var(--primary);
  font-weight: 700;
}

.nav-close {
  display: none;
  background: transparent;
  border: none;
  font-size: 22px;
  cursor: pointer;
  padding: 0;
  color: #6b7280;
  line-height: 1;
}

.side-nav {
  padding: 4px 2px;
  text-align: left;
}

.nav-list {
  list-style: none;
  padding: 0;
  margin: 0;
  display: grid;
  gap: 4px;
  justify-items: start;
}

.nav-section-label {
  margin: 8px 2px 0;
  color: var(--muted);
  font-size: 12px;
  font-weight: 600;
}

.nav-link {
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 10px 12px;
  border-radius: 10px;
  color: var(--text);
  text-decoration: none;
  border: 1px solid transparent;
  background: transparent;
  cursor: pointer;
  font: inherit;
  font-weight: 600;
  font-size: 14px;
  text-align: left;
  transition: all 0.2s ease;
}

.files-link-inline {
  display: inline-flex;
  align-items: center;
  gap: 8px;
}

.files-badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 20px;
  height: 20px;
  padding: 0 7px;
  border-radius: 999px;
  font-size: 11px;
  font-weight: 700;
  color: #fff;
  background: var(--org-primary-color);
}

.nav-link:hover {
  background: #f3f4f6;
  border-color: #e5e7eb;
}

.nav-link.active {
  background: var(--primary);
  border-color: var(--primary);
  color: #fff;
}

.nav-toggle {
  display: none;
  align-items: center;
  gap: 8px;
  padding: 10px 12px;
  border-radius: 10px;
  border: 1px solid var(--border);
  background: #fff;
  cursor: pointer;
  font: inherit;
  margin-bottom: 12px;
}

.hamburger-icon {
  position: relative;
  width: 16px;
  height: 2px;
  background: #111827;
  display: inline-block;
}

.hamburger-icon::before,
.hamburger-icon::after {
  content: "";
  position: absolute;
  left: 0;
  width: 16px;
  height: 2px;
  background: #111827;
}

.hamburger-icon::before { top: -5px; }
.hamburger-icon::after { top: 5px; }

.nav-overlay {
  position: fixed;
  inset: 0;
  background: rgba(17, 24, 39, 0.35);
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.2s ease;
  z-index: 998;
}

.nav-overlay.show {
  opacity: 1;
  pointer-events: auto;
}

.meta-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
  gap: 12px;
}

.meta-tile {
  padding: 12px;
  border: 1px solid var(--border);
  border-radius: 10px;
  background: #f9fafb;
}

.meta-label { color: var(--muted); font-size: 12px; margin: 0 0 4px; }
.meta-value { margin: 0; font-weight: 600; color: var(--text); }

.section-card {
  border: 1px solid var(--border);
  border-radius: 12px;
  padding: 14px;
  margin-top: 16px;
  background: #fff;
  box-shadow: 0 2px 8px rgba(15, 23, 42, 0.03);
}

.dashboard-content > .section-card:first-child {
  margin-top: 0;
}

.section-title {
  margin: 0 0 6px;
  font-weight: 600;
  color: var(--text);
}

.section-toggle {
  width: 100%;
  border: none;
  background: transparent;
  padding: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  cursor: pointer;
  text-align: left;
}

.section-toggle:hover,
.section-toggle:active,
.section-toggle:focus,
.section-toggle:focus-visible {
  background: transparent !important;
  color: inherit;
  box-shadow: none;
}

.section-toggle .section-title {
  margin: 0;
}

.section-toggle-icon {
  color: var(--muted);
  font-size: 24px;
  line-height: 1;
  transition: transform 0.2s ease, color 0.2s ease;
}

.teacher-section.open .section-toggle-icon,
.class-info-section.open .section-toggle-icon {
  transform: rotate(90deg);
  color: var(--text);
}

.section-collapse {
  padding-top: 10px;
}

.class-info-toggle {
  display: none;
}

.class-info-section .section-collapse {
  padding-top: 0;
}

.section-subtext {
  margin: 0 0 10px;
  color: var(--muted);
  font-size: 13px;
}

.teacher-list {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
  gap: 10px;
}

.teacher-card {
  border: 1px solid var(--border);
  border-radius: 10px;
  padding: 10px 12px;
  display: flex;
  align-items: center;
  gap: 10px;
  background: #fff;
}

.teacher-dot {
  width: 10px;
  height: 10px;
  border-radius: 50%;
  background: var(--primary);
}

.teacher-name {
  font-weight: 600;
  color: var(--text);
}

.student-list {
  list-style: none;
  padding: 0;
  margin: 0;
  display: flex;
  flex-direction: column;
  gap: 0;
}

.student-list li {
  border-bottom: 1px solid var(--border);
}

.student-list li:last-child {
  border-bottom: none;
}

.student-row {
  display: flex;
  align-items: center;
  gap: 6px;
  padding: 6px 2px;
}

.student-index {
  color: var(--muted);
  font-size: 12px;
  font-weight: 600;
  min-width: 24px;
}

.student-link {
  color: var(--primary);
  text-decoration: none;
  font-weight: 600;
}

.student-link:hover { color: var(--primary-hover); }

.students-section {
  padding: 10px 12px;
}

.students-section .section-title {
  margin: 0 0 2px;
}

.students-section .student-list {
  margin: 0;
}

.students-section .student-list li {
  margin: 0;
  padding: 0;
}

.students-section .student-row {
  gap: 4px;
  padding: 4px 0;
}

.students-section .student-index {
  min-width: 18px;
}

@media (max-width: 960px) {
  .dashboard-grid { grid-template-columns: 1fr; }
  .nav-toggle {
    display: inline-flex;
    position: sticky;
    top: 8px;
    z-index: 900;
  }
  .nav-card {
    position: fixed;
    top: 72px;
    left: 0;
    width: 300px;
    max-width: 85vw;
    height: auto;
    max-height: calc(100vh - 120px);
    padding: 26px 20px 20px;
    border-radius: 0 14px 14px 0;
    overflow-y: auto;
    transform: translateX(-110%);
    transition: transform 0.25s ease;
    z-index: 999;
    box-shadow: 0 10px 26px rgba(15, 23, 42, 0.08);
  }
  .nav-header {
    position: relative;
    padding: 0 0 12px;
    margin: 0 0 14px;
    border-bottom: 1px solid var(--border);
  }
  .nav-close {
    display: inline-flex;
    position: absolute;
    top: -2px;
    right: 0;
    width: 28px;
    height: 28px;
    padding: 0;
    line-height: 1;
  }
  .side-nav { padding: 0; }
  .nav-list { gap: 4px; }
  .class-info-toggle { display: flex; }
  .class-info-section .section-collapse { padding-top: 10px; }
  .nav-card.open { transform: translateX(0); }
  .nav-close { display: inline-flex; }
  .dashboard-shell { padding-top: 12px; }
}

@media (max-width: 768px) {
  body {
    padding-bottom: 0 !important;
  }
}
</style>

<body>
  <% const hasFilesFeature = Array.isArray(allowedFeatures) && (allowedFeatures.includes('Create Files') || allowedFeatures.includes('Files & Sheets')); %>
  <% const hasAttendanceFeature = Array.isArray(allowedFeatures) && (allowedFeatures.includes('Attendance Tracking') || allowedFeatures.includes('Attendance tracking feature')); %>
  <% const hasAssessmentFeature = Array.isArray(allowedFeatures) && (allowedFeatures.includes('Assessment Tracking') || allowedFeatures.includes('Assessment tracking feature')); %>
  <div class="dashboard-shell">
    <button class="nav-toggle" type="button">
      <span class="hamburger-icon" aria-hidden="true"></span>
      <span>Class Tools</span>
    </button>

    <div class="dashboard-grid">
      <aside class="card nav-card" id="class-tools-panel">
        <div class="nav-header">
          <div>
            <h3>Class Tools</h3>
          </div>
          <button class="nav-close" type="button" aria-label="Close navigation">×</button>
        </div>
        <div class="side-nav">
          <ul class="nav-list">
            <% if (hasAttendanceFeature && (userRole !== "Teacher" || isMainTeacher)) { %>
              <li><a class="nav-link" href="/common/attendanceCollection?classId=<%= classId %>&termId=<%= currentTerm.term_id %>">Attendance</a></li>
            <% } %>

            <% if (hasAssessmentFeature) { %>
              <li class="nav-section-label">Subjects</li>
              <% if (subjects.length > 0) { %>
                <% subjects.forEach(function(subject) { %>
                  <li>
                    <a class="nav-link" href="/common/assessment?classId=<%= classId %>&subjectId=<%= subject.subject_id %>">
                      <%= subject.subject_name %>
                    </a>
                  </li>
                <% }); %>
              <% } else { %>
                <li class="card-subtext" style="padding: 4px 2px;">No subjects added yet.</li>
              <% } %>
            <% } %>

            <% if (hasFilesFeature) { %>
              <li class="nav-section-label">Tools</li>
              <li>
                <a class="nav-link" href="/documents?classId=<%= classId %>&create=1" title="Files" data-no-spa>
                  <span class="files-link-inline">📁 Files
                    <% if (userRole === 'Teacher' && (assignedFilesCount || 0) > 0) { %>
                      <span class="files-badge" title="Assigned files"><%= assignedFilesCount %></span>
                    <% } %>
                  </span>
                </a>
              </li>
            <% } %>
          </ul>
        </div>
      </aside>

      <div class="nav-overlay" id="class-tools-overlay"></div>

      <main class="dashboard-main">
        <div class="dashboard-header">
          <h1 class="page-title" id="className"><%= className %></h1>
          <% if (graduationYearGroup) { %>
            <p class="card-subtext"><%= graduationYearGroup %></p>
          <% } %>
        </div>

        <div class="dashboard-content">
          <div class="section-card class-info-section" id="class-info-section">
            <button class="section-toggle class-info-toggle" type="button" id="class-info-toggle" aria-expanded="false" aria-controls="class-info-content">
              <span class="section-title">School Year: <%= schoolYear.year_label %> · Term: <%= currentTerm.term_name %></span>
              <span class="section-toggle-icon" aria-hidden="true">›</span>
            </button>
            <div class="section-collapse" id="class-info-content">
              <div class="meta-grid">
                <div class="meta-tile">
                  <p class="meta-label">School Year</p>
                  <p class="meta-value"><%= schoolYear.year_label %></p>
                </div>
                <div class="meta-tile">
                  <p class="meta-label">Term</p>
                  <p class="meta-value"><%= currentTerm.term_name %></p>
                </div>
                <div class="meta-tile">
                  <p class="meta-label">Start Date</p>
                  <p class="meta-value"><%= new Date(currentTerm.start_date).toISOString().split('T')[0] %></p>
                </div>
                <div class="meta-tile">
                  <p class="meta-label">End Date</p>
                  <p class="meta-value"><%= new Date(currentTerm.end_date).toISOString().split('T')[0] %></p>
                </div>
              </div>
            </div>
          </div>

          <div class="section-card teacher-section" id="teachers-section">
            <button class="section-toggle" type="button" id="teachers-toggle" aria-expanded="false" aria-controls="teachers-content">
              <span class="section-title">Teachers</span>
              <span class="section-toggle-icon" aria-hidden="true">›</span>
            </button>
            <div class="section-collapse" id="teachers-content" hidden>
              <p class="section-subtext">Main teacher can mark attendance.</p>
              <div class="teacher-list">
                <% employees.forEach(function(employee) { %>
                  <div class="teacher-card">
                    <% if (employee.main) { %>
                      <span class="teacher-dot" title="Main teacher"></span>
                    <% } else { %>
                      <span style="width:10px; height:10px;"></span>
                    <% } %>
                    <span class="teacher-name"><%= employee.name %></span>
                    <% if (req.session && req.session.userRole !== 'Teacher' && req.session.userRole !== 'Supervisor') { %>
                      <input type="radio" name="main_employee" value="<%= employee.user_id %>" <% if (employee.main) { %> checked <% } %> onchange="setMainEmployee('<%= classId %>', '<%= employee.user_id %>')" style="margin-left:auto;">
                    <% } %>
                  </div>
                <% }); %>
              </div>
            </div>
          </div>

          <div class="section-card students-section">
            <div class="section-title">Students</div>
            <ul class="student-list">
              <% if (students.length > 0) { %>
                <% students.forEach(function(student, index) { %>
                  <li>
                    <div class="student-row">
                      <span class="student-index"><%= index + 1 %>.</span>
                      <a class="student-link" href="/common/studentDetails?studentId=<%= student.student_id %>&termId=<%= currentTerm.term_id %>&classId=<%= classId %>">
                        <%= student.first_name %> <%= student.last_name %>
                      </a>
                    </div>
                  </li>
                <% }); %>
              <% } else { %>
                <li class="card-subtext">No students enrolled for this term yet.</li>
              <% } %>
            </ul>
          </div>
        </div>
      </main>
    </div>
  </div>

  <script>
    (function () {
      window.setMainEmployee = function (classId, userId) {
        const confirmationMessage = "Are you sure you want to set this teacher as the main teacher for this class? The main teacher will have full access and is the only teacher who can mark attendance.";
        if (!confirm(confirmationMessage)) return;

        fetch('/common/setMainEmployee', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ class_id: classId, main_employee: userId })
        })
          .then(response => response.json())
          .then(data => {
            if (data.success) {
              alert('Main class teacher set successfully');
            } else {
              alert('Failed to set main class teacher');
            }
          })
          .catch(error => {
            console.error('Error:', error);
            alert('Error setting main employee');
          });
      };

      function initClassDashboard() {
        const navToggle = document.querySelector('.nav-toggle');
        const navPanel = document.getElementById('class-tools-panel');
        const navOverlay = document.getElementById('class-tools-overlay');
        const navClose = document.querySelector('.nav-close');
        const navLinks = document.querySelectorAll('.nav-link');
        const classInfoSection = document.getElementById('class-info-section');
        const classInfoToggle = document.getElementById('class-info-toggle');
        const classInfoContent = document.getElementById('class-info-content');
        const teachersSection = document.getElementById('teachers-section');
        const teachersToggle = document.getElementById('teachers-toggle');
        const teachersContent = document.getElementById('teachers-content');

        function openNav() {
          if (navPanel) navPanel.classList.add('open');
          if (navOverlay) navOverlay.classList.add('show');
        }

        function closeNav() {
          if (navPanel) navPanel.classList.remove('open');
          if (navOverlay) navOverlay.classList.remove('show');
        }

        function setTeachersOpen(isOpen) {
          if (!teachersSection || !teachersToggle || !teachersContent) return;
          teachersSection.classList.toggle('open', isOpen);
          teachersToggle.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
          teachersContent.hidden = !isOpen;
        }

        function isSmallScreen() {
          return window.matchMedia('(max-width: 960px)').matches;
        }

        function setClassInfoOpen(isOpen) {
          if (!classInfoSection || !classInfoToggle || !classInfoContent) return;
          classInfoSection.classList.toggle('open', isOpen);
          classInfoToggle.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
          classInfoContent.hidden = !isOpen;
        }

        function syncClassInfoForViewport() {
          if (!classInfoSection || !classInfoToggle || !classInfoContent) return;
          if (isSmallScreen()) {
            setClassInfoOpen(false);
          } else {
            setClassInfoOpen(true);
          }
        }

        if (navToggle && !navToggle.dataset.boundNavToggle) {
          navToggle.dataset.boundNavToggle = '1';
          navToggle.addEventListener('click', openNav);
        }
        if (navOverlay && !navOverlay.dataset.boundNavOverlay) {
          navOverlay.dataset.boundNavOverlay = '1';
          navOverlay.addEventListener('click', closeNav);
        }
        if (navClose && !navClose.dataset.boundNavClose) {
          navClose.dataset.boundNavClose = '1';
          navClose.addEventListener('click', closeNav);
        }
        if (navLinks && navLinks.length) {
          navLinks.forEach(link => {
            if (!link.dataset.boundNavLinkClose) {
              link.dataset.boundNavLinkClose = '1';
              link.addEventListener('click', closeNav);
            }
          });
        }

        if (classInfoToggle) {
          syncClassInfoForViewport();
          if (!classInfoToggle.dataset.boundClassInfoToggle) {
            classInfoToggle.dataset.boundClassInfoToggle = '1';
            classInfoToggle.addEventListener('click', () => {
              if (!isSmallScreen()) return;
              const isOpen = classInfoToggle.getAttribute('aria-expanded') === 'true';
              setClassInfoOpen(!isOpen);
            });
          }

          if (window.__classDashboardResizeHandler) {
            window.removeEventListener('resize', window.__classDashboardResizeHandler);
          }
          window.__classDashboardResizeHandler = syncClassInfoForViewport;
          window.addEventListener('resize', window.__classDashboardResizeHandler);
        }

        if (teachersToggle) {
          setTeachersOpen(false);
          if (!teachersToggle.dataset.boundTeachersToggle) {
            teachersToggle.dataset.boundTeachersToggle = '1';
            teachersToggle.addEventListener('click', () => {
              const isOpen = teachersToggle.getAttribute('aria-expanded') === 'true';
              setTeachersOpen(!isOpen);
            });
          }
        }
      }

      initClassDashboard();
    })();
  </script>
</body>