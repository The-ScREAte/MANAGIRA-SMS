        if (window.L) return Promise.resolve(window.L);
        if (window.__classDashboardLeafletPromise) return window.__classDashboardLeafletPromise;
        window.__classDashboardLeafletPromise = new Promise(function(resolve, reject) {
          var script = document.createElement('script');
          script.src = 'https://unpkg.com/leaflet@1.9.4/dist/leaflet.js';
          script.onload = function() { resolve(window.L); };
          script.onerror = reject;
          document.body.appendChild(script);
        });
        return window.__classDashboardLeafletPromise;
      }

      function buildTransportMapPoints(snapshot) {
        var points = [];
        var school = snapshot && snapshot.school ? snapshot.school : studentTransportState.school;
        var schoolLat = school ? normalizeCoord(school.latitude, 'lat') : null;
        var schoolLng = school ? normalizeCoord(school.longitude, 'lng') : null;
        if (schoolLat !== null && schoolLng !== null) {
          points.push({ type: 'school', lat: schoolLat, lng: schoolLng, label: school.address || 'School' });
        }
        var stopLat = snapshot && snapshot.stop ? normalizeCoord(snapshot.stop.latitude, 'lat') : null;
        var stopLng = snapshot && snapshot.stop ? normalizeCoord(snapshot.stop.longitude, 'lng') : null;
        if (stopLat !== null && stopLng !== null) {
          points.push({ type: 'stop', lat: stopLat, lng: stopLng, label: snapshot.stop.stopName || 'Stop' });
        }
        var liveLat = snapshot && snapshot.live ? normalizeCoord(snapshot.live.latitude, 'lat') : null;
        var liveLng = snapshot && snapshot.live ? normalizeCoord(snapshot.live.longitude, 'lng') : null;
        if (liveLat !== null && liveLng !== null) {
          points.push({ type: 'live', lat: liveLat, lng: liveLng, label: 'Live bus position' });
        }
        var homeLat = snapshot ? normalizeCoord(snapshot.homeLatitude, 'lat') : null;
        var homeLng = snapshot ? normalizeCoord(snapshot.homeLongitude, 'lng') : null;
        if (homeLat !== null && homeLng !== null) {
          points.push({ type: 'home', lat: homeLat, lng: homeLng, label: snapshot.homeAddress || 'Home' });
        }
        return points;
      }

      function buildTransportRouteLatLngs(snapshot) {
        var latlngs = [];
        var school = snapshot && snapshot.school ? snapshot.school : studentTransportState.school;
        var schoolLat = school ? normalizeCoord(school.latitude, 'lat') : null;
        var schoolLng = school ? normalizeCoord(school.longitude, 'lng') : null;
        if (schoolLat !== null && schoolLng !== null) {
          latlngs.push([schoolLat, schoolLng]);
        }
        var routeStops = snapshot && snapshot.route && Array.isArray(snapshot.route.stops)
          ? snapshot.route.stops.filter(function(stop) {
              return normalizeCoord(stop && stop.latitude, 'lat') !== null && normalizeCoord(stop && stop.longitude, 'lng') !== null;
            }).map(function(stop) {
              return [normalizeCoord(stop.latitude, 'lat'), normalizeCoord(stop.longitude, 'lng')];
            })
          : [];
        routeStops.forEach(function(latlng) { latlngs.push(latlng); });
        if (schoolLat !== null && schoolLng !== null && routeStops.length) {
          latlngs.push([schoolLat, schoolLng]);
        }
        return latlngs;
      }

      function renderTransportMap(targetId, snapshot, reuseClassMap) {
        return ensureLeafletAssets().then(function(L) {
          var el = document.getElementById(targetId);
          if (!el) return;
          var mapKey = reuseClassMap ? 'classMap' : 'modalMap';
          var layersKey = reuseClassMap ? 'classLayers' : 'modalLayers';
          if (!studentTransportState[mapKey]) {
            studentTransportState[mapKey] = L.map(el, { scrollWheelZoom: false, zoomControl: true }).setView([40.767304, -111.939857], 12);
            window.ManagiraMaps.addTiles(studentTransportState[mapKey]);
            studentTransportState[layersKey] = L.layerGroup().addTo(studentTransportState[mapKey]);
          }
          var map = studentTransportState[mapKey];
          var layerGroup = studentTransportState[layersKey];
          layerGroup.clearLayers();
          var points = buildTransportMapPoints(snapshot);
          var routeStops = snapshot && snapshot.route && Array.isArray(snapshot.route.stops)
            ? snapshot.route.stops.filter(function(stop) {
                return Number.isFinite(Number(stop && stop.latitude)) && Number.isFinite(Number(stop && stop.longitude));
              })
            : [];
          if (!points.length) {
            map.setView([40.767304, -111.939857], 11);
            return;
          }
          points.forEach(function(point) {
            var isSchool = /school/i.test(String(point.type || point.label || ''));
            var marker = L.marker([point.lat, point.lng], isSchool && window.ManagiraMaps ? { icon: window.ManagiraMaps.schoolIcon(), zIndexOffset: 300 } : {}).addTo(layerGroup);
            marker.bindPopup(point.label || point.type);
          });
          routeStops.forEach(function(stop) {
            var routeStopLat = normalizeCoord(stop.latitude, 'lat');
            var routeStopLng = normalizeCoord(stop.longitude, 'lng');
            if (routeStopLat === null || routeStopLng === null) return;
            L.circleMarker([routeStopLat, routeStopLng], {
              radius: 5,
              color: '#2563eb',
              fillColor: '#93c5fd',
              fillOpacity: 0.9,
              weight: 2,
            }).bindPopup(stop.stopName || 'Route stop').addTo(layerGroup);
          });
          var routeLatLngs = buildTransportRouteLatLngs(snapshot);
          var schoolPoint = points.find(function(point) { return point.type === 'school'; });
          var stopPoint = points.find(function(point) { return point.type === 'stop'; });
          var livePoint = points.find(function(point) { return point.type === 'live'; });
          if (stopPoint && livePoint) {
            // Bus -> the student's stop, along the roads.
            fetchRoadGeometry([[livePoint.lat, livePoint.lng], [stopPoint.lat, stopPoint.lng]]).then(function(legPoints) {
              if (legPoints.length >= 2) {
                L.polyline(legPoints, { color: '#d97706', weight: 4, opacity: 0.85, dashArray: '6,8' }).addTo(layerGroup);
              }
            });
          }
          var assignedStopLat = snapshot && snapshot.stop ? normalizeCoord(snapshot.stop.latitude, 'lat') : null;
          var assignedStopLng = snapshot && snapshot.stop ? normalizeCoord(snapshot.stop.longitude, 'lng') : null;
          if (assignedStopLat !== null && assignedStopLng !== null) {
            L.circleMarker([assignedStopLat, assignedStopLng], {
              radius: 8,
              color: '#b91c1c',
              fillColor: '#ef4444',
              fillOpacity: 0.95,
              weight: 2,
            }).bindPopup((snapshot.stop.stopName || 'Assigned stop') + ' (Assigned)').addTo(layerGroup);
          }
          return fetchRoadGeometry(routeLatLngs).then(function(roadLatLngs) {
            if (roadLatLngs.length >= 2) {
              L.polyline(roadLatLngs, {
                color: '#0f5a66',
                weight: reuseClassMap ? 3 : 4,
                opacity: 0.85,
              }).addTo(layerGroup);
            }
            var boundsSource = roadLatLngs.length ? roadLatLngs.slice() : (routeLatLngs.length ? routeLatLngs.slice() : points.map(function(point) { return [point.lat, point.lng]; }));
            setTimeout(function() {
              map.invalidateSize();
              if (boundsSource.length) {
                var bounds = L.latLngBounds(boundsSource);
                map.fitBounds(bounds.pad(0.2));
              }
            }, reuseClassMap ? 0 : 80);
          });
        }).catch(function() {
          var el = document.getElementById(targetId);
          if (el) el.innerHTML = '<div style="padding:18px;color:#64748b;font-size:12px;">Map could not load right now.</div>';
        });
      }

      function closeStudentTransportModal() {
        var modal = document.getElementById('studentTransportModal');
        if (!modal) return;
        modal.classList.remove('active');
      }

      function handleStudentTransportModalOverlayClick(event) {
        if (event && event.target && event.target.id === 'studentTransportModal') {
          closeStudentTransportModal();
        }
      }

      async function openStudentTransportModal(studentId, studentName, event) {
        if (event) {
          event.preventDefault();
          event.stopPropagation();
        }
        // The live bus tracker (public/js/busTracker.js).
        if (window.BusTracker) {
          var knownRow = (window.__classTransportRows || {})[studentId];
          return window.BusTracker.open(studentId, { name: studentName, snapshot: knownRow || null });
        }
        var modal = document.getElementById('studentTransportModal');
        var titleEl = document.getElementById('studentTransportModalTitle');
        var statusEl = document.getElementById('studentTransportModalStatus');
        var summaryEl = document.getElementById('studentTransportModalSummary');
        var gridEl = document.getElementById('studentTransportModalGrid');
        if (!modal || !titleEl || !statusEl || !summaryEl || !gridEl) return;

        titleEl.textContent = 'Transportation: ' + String(studentName || 'Student');
        statusEl.textContent = 'Loading transportation details...';
        summaryEl.innerHTML = '';
        gridEl.innerHTML = '';
        modal.classList.add('active');

        try {
          var params = new URLSearchParams({ classId: String(studentTransportState.classId), studentId: String(studentId) });
          var response = await fetch('/common/classDashboardStudentTransport?' + params.toString(), { credentials: 'same-origin' });
          var result = await response.json();
          if (!response.ok || !result || !result.success) {
            throw new Error((result && result.error) || 'Unable to load transportation details.');
          }
          var snapshot = result.snapshot || null;
          if (!snapshot) {
            statusEl.textContent = 'No transportation assignment found.';
            return;
          }
          statusEl.textContent = 'Current transportation assignment';
          // Names and addresses are typed by people: they go in as text, never as markup.
          var transportText = function(value) { return String(value == null ? '' : value).replace(/[&<>"']/g, function(c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]; }); };
          summaryEl.innerHTML = '<span class="transport-summary-chip">🚌 ' + transportText([snapshot.bus && snapshot.bus.busNumber, snapshot.route && snapshot.route.routeName, snapshot.stop && snapshot.stop.stopName].filter(Boolean).join(' | ')) + '</span>';
          var details = [
            ['Driver', snapshot.driverName || '-'],
            ['Route', snapshot.route && snapshot.route.routeName ? snapshot.route.routeName : '-'],
            ['Stop', snapshot.stop && snapshot.stop.stopName ? snapshot.stop.stopName : '-'],
            ['Pick-up', formatTransportClock(snapshot.pickupTime) || '-'],
            ['Drop-off', formatTransportClock(snapshot.dropoffTime) || '-'],
            ['Live', snapshot.live && snapshot.live.recordedAt ? new Date(snapshot.live.recordedAt).toLocaleString() : 'No live update yet'],
            ['School', snapshot.school && snapshot.school.address ? snapshot.school.address : '-'],
            ['Home', snapshot.homeAddress || '-']
          ];
          gridEl.innerHTML = details.map(function(entry) {
            return '<div class="transport-detail-card"><span class="k">' + transportText(entry[0]) + '</span><span class="v">' + transportText(entry[1]) + '</span></div>';
          }).join('');
          setTimeout(function() {
            renderTransportMap('studentTransportModalMap', snapshot, false);
          }, 60);
        } catch (error) {
          statusEl.textContent = error && error.message ? error.message : 'Unable to load transportation details.';
        }
      }

      // "07:37:00" -> "7:37 AM"
      function formatTransportClock(value) {
        var m = /^(\d{1,2}):(\d{2})/.exec(String(value || ''));
        if (!m) return value || '';
        var h = Number(m[1]);
        return ((h % 12) || 12) + ':' + m[2] + (h < 12 ? ' AM' : ' PM');
      }

      function setStudentTeacherRemarkStatus(message, tone) {
        var statusEl = document.getElementById('studentTeacherRemarkStatus');
        if (!statusEl) return;
        statusEl.classList.remove('error', 'success');
        if (tone === 'error') statusEl.classList.add('error');
        if (tone === 'success') statusEl.classList.add('success');
        statusEl.textContent = message || '';
      }

      function normalizeTeacherRemarkText(value) {
        return String(value == null ? '' : value).trim();
      }

      function emptyRemarkValues() {
        var values = {};
        Object.keys(remarkTypeLabels).forEach(function(typeKey) {
          values[typeKey] = '';
        });
        if (!Object.prototype.hasOwnProperty.call(values, 'teacher')) {
          values.teacher = '';
        }
        return values;
      }

      function normalizeRemarkValues(value) {
        var base = emptyRemarkValues();
        if (!value || typeof value !== 'object') {
          if (typeof value === 'string') {
            base.teacher = normalizeTeacherRemarkText(value);
          }
          return base;
        }
        Object.keys(base).forEach(function(typeKey) {
          base[typeKey] = normalizeTeacherRemarkText(value[typeKey]);
        });
        Object.keys(value).forEach(function(typeKey) {
          var normalizedTypeKey = normalizeRemarkTypeKey(typeKey);
          base[normalizedTypeKey] = normalizeTeacherRemarkText(value[typeKey]);
        });
        return base;
      }

      function getEnabledRemarkTypes() {
        var selectedTypes = Array.isArray(studentTeacherRemarkState.selectedRemarkTypes)
          ? studentTeacherRemarkState.selectedRemarkTypes
          : ['teacher'];
        var normalized = selectedTypes
          .map(normalizeRemarkTypeKey)
          .filter(function(typeKey, index, list) {
            return list.indexOf(typeKey) === index;
          });
        return normalized.length ? normalized : ['teacher'];
      }

      function hasAnyEnabledRemark(remarkValues) {
        var values = normalizeRemarkValues(remarkValues);
        return getEnabledRemarkTypes().some(function(typeKey) {
          return normalizeTeacherRemarkText(values[typeKey]).length > 0;
        });
      }

      function areRemarkValuesEqual(left, right) {
        var leftValues = normalizeRemarkValues(left);
        var rightValues = normalizeRemarkValues(right);
        return Object.keys(remarkTypeLabels).every(function(typeKey) {
          return leftValues[typeKey] === rightValues[typeKey];
        });
      }

      function getCachedStudentTeacherRemark(studentId) {
        var key = String(studentId || '').trim();
        if (!key) return emptyRemarkValues();
        return normalizeRemarkValues(studentTeacherRemarkState.studentRemarkCache[key]);
      }

      function setCachedStudentTeacherRemark(studentId, remarkValues) {
        var key = String(studentId || '').trim();
        if (!key) return;
        studentTeacherRemarkState.studentRemarkCache[key] = normalizeRemarkValues(remarkValues);
      }

      function setTeacherRemarkOptionsCache(options) {
        studentTeacherRemarkState.optionsCache = Array.isArray(options) ? options : [];
        studentTeacherRemarkState.optionsLoadedAt = Date.now();
      }

      function setCustomRemarkTypes(nextTypes) {
        studentTeacherRemarkState.customRemarkTypes = Array.isArray(nextTypes) ? nextTypes : [];
        rebuildRemarkTypeLabels();
      }

      function normalizeRemarkTypeKey(value) {
        var normalized = String(value || '').trim().toLowerCase();
        if (remarkTypeLabels[normalized]) return normalized;
        if (normalized.indexOf('custom:') === 0) return normalized;
        return 'teacher';
      }

      function setSelectedRemarkTypes(nextTypes) {
        var incoming = Array.isArray(nextTypes) ? nextTypes : [];
        var normalized = incoming
          .map(normalizeRemarkTypeKey)
          .filter(function(value, index, list) {
            return list.indexOf(value) === index;
          });
        studentTeacherRemarkState.selectedRemarkTypes = normalized.length ? normalized : ['teacher'];
      }

      function getEnabledRemarkTypesText() {
        return getEnabledRemarkTypes()
          .map(function(typeKey) { return remarkTypeLabels[typeKey] || remarkTypeLabels.teacher; })
          .join(', ');
      }

      function getCurrentRemarkValuesFromInputs() {
        // Starts from what the student already has, so remarks the pop-up doesn't ask for (other
        // types, or ones collected with the Custom editor) are saved back unchanged, never emptied.
        var values = Number.isInteger(studentTeacherRemarkState.studentId)
          ? getCachedStudentTeacherRemark(studentTeacherRemarkState.studentId)
          : emptyRemarkValues();
        Array.prototype.forEach.call(document.querySelectorAll('.student-remark-input[data-remark-type]'), function(textArea) {
          var typeKey = normalizeRemarkTypeKey(textArea.getAttribute('data-remark-type'));
          values[typeKey] = normalizeTeacherRemarkText(textArea.value || '');
        });
        return values;
      }

      function renderStudentRemarkEditors(remarkValues) {
        var container = document.getElementById('studentRemarkEditorsContainer');
        if (!container) return;

        var normalizedValues = normalizeRemarkValues(remarkValues);
        var selectedTypes = getEnabledRemarkTypes();
        var options = Array.isArray(studentTeacherRemarkState.optionsCache)
          ? studentTeacherRemarkState.optionsCache
          : [];
        var optionsByType = {};
        Object.keys(remarkTypeLabels).forEach(function(typeKey) {
          optionsByType[typeKey] = [];
        });

        options.forEach(function(optionRow) {
          var typeKey = normalizeRemarkTypeKey(optionRow && optionRow.remark_type);
          var remarkText = normalizeTeacherRemarkText(optionRow && optionRow.remark);
          if (!remarkText) return;
          if (!Array.isArray(optionsByType[typeKey])) {
            optionsByType[typeKey] = [];
          }
          optionsByType[typeKey].push(remarkText);
        });

        container.innerHTML = selectedTypes.map(function(typeKey) {
          var typeLabel = remarkTypeLabels[typeKey] || remarkTypeLabels.teacher;
          var selectedText = normalizedValues[typeKey] || '';
          var optionsMarkup = (optionsByType[typeKey] || []).map(function(remarkText) {
            var escapedValue = esc(remarkText);
            return '<option value="' + escapedValue + '"' + (remarkText === selectedText ? ' selected' : '') + '>' + escapedValue + '</option>';
          }).join('');

          return ''
            + '<div class="student-remark-editor">'
            +   '<div class="student-remark-editor-head">'
            +     '<div class="student-remark-label">' + esc(typeLabel) + '</div>'
            +     '<select class="student-remark-select student-remark-select-picker" data-remark-type="' + esc(typeKey) + '" aria-label="Choose saved ' + esc(typeLabel.toLowerCase()) + '">'
            +       '<option value="">Select</option>'
            +       optionsMarkup
            +     '</select>'
            +   '</div>'
            +   '<textarea class="student-remark-input" data-remark-type="' + esc(typeKey) + '" maxlength="500" placeholder="Type ' + esc(typeLabel.toLowerCase()) + '...">' + esc(selectedText) + '</textarea>'
            + '</div>';
        }).join('');

        Array.prototype.forEach.call(container.querySelectorAll('.student-remark-select[data-remark-type]'), function(selectEl) {
          selectEl.onchange = function() {
            var typeKey = normalizeRemarkTypeKey(selectEl.getAttribute('data-remark-type'));
            var textEl = container.querySelector('.student-remark-input[data-remark-type="' + typeKey + '"]');
            if (!textEl) return;
            var selectedValue = normalizeTeacherRemarkText(selectEl.value || '');
            if (selectedValue) {
              textEl.value = selectedValue;
              selectEl.value = '';
            }
            studentTeacherRemarkState.inputDirty = true;
          };
        });

        Array.prototype.forEach.call(container.querySelectorAll('.student-remark-input[data-remark-type]'), function(textEl) {
          textEl.oninput = function() {
            studentTeacherRemarkState.inputDirty = true;
          };
        });
      }

      function applyInitialStudentTeacherRemarkIndicators() {
        var list = document.getElementById('classDashboardStudentsList');
        if (!list) return;
        Array.prototype.forEach.call(list.querySelectorAll('li[data-student-id]'), function(item) {
          var studentId = Number.parseInt(item.getAttribute('data-student-id'), 10);
          if (!Number.isInteger(studentId)) return;
          var hasRemark = hasAnyEnabledRemark(getCachedStudentTeacherRemark(studentId));
          markStudentTeacherRemarkState(studentId, hasRemark);
        });
      }
      // Called from the page's DOMContentLoaded handler, which is outside this
      // function's scope.
      window.applyInitialStudentTeacherRemarkIndicators = applyInitialStudentTeacherRemarkIndicators;

      function shouldRefreshTeacherRemarkOptions() {
        var ageMs = Date.now() - Number(studentTeacherRemarkState.optionsLoadedAt || 0);
        return !Array.isArray(studentTeacherRemarkState.optionsCache)
          || studentTeacherRemarkState.optionsCache.length === 0
          || ageMs > Number(studentTeacherRemarkState.optionsMaxAgeMs || 120000);
      }

      function markStudentTeacherRemarkState(studentId, hasRemark) {
        var listItem = document.querySelector('#classDashboardStudentsList li[data-student-id="' + String(studentId) + '"]');
        if (!listItem) return;
        var rowBtn = listItem.querySelector('.student-row');
        var remarkBtn = listItem.querySelector('.student-remark-btn');
        if (rowBtn) rowBtn.classList.toggle('has-remark', !!hasRemark);
        if (remarkBtn) remarkBtn.classList.toggle('has-remark', !!hasRemark);
      }

      function closeStudentTeacherRemarkModal() {
        var modal = document.getElementById('studentTeacherRemarkModal');
        if (!modal) return;
        modal.classList.remove('active');
        studentTeacherRemarkState.studentId = null;
        studentTeacherRemarkState.studentName = '';
        studentTeacherRemarkState.inputDirty = false;
        setStudentTeacherRemarkStatus('');
      }

      function handleStudentTeacherRemarkOverlayClick(event) {
        if (event && event.target && event.target.id === 'studentTeacherRemarkModal') {
          closeStudentTeacherRemarkModal();
        }
      }

      async function openStudentTeacherRemarkModal(trigger, event) {
        if (event) {
          event.preventDefault();
          event.stopPropagation();
        }
        var studentId = Number.parseInt(trigger && trigger.getAttribute('data-student-id'), 10);
        var studentName = String((trigger && trigger.getAttribute('data-student-name')) || '').trim();
        if (!Number.isInteger(studentId) || !studentName) {
          return;
        }

        var modal = document.getElementById('studentTeacherRemarkModal');
        var titleEl = document.getElementById('studentTeacherRemarkModalTitle');
        var saveBtn = document.getElementById('studentTeacherRemarkSaveBtn');
        if (!modal || !titleEl || !saveBtn) {
          return;
        }

        studentTeacherRemarkState.studentId = studentId;
        studentTeacherRemarkState.studentName = studentName;
        studentTeacherRemarkState.isLoading = true;
        studentTeacherRemarkState.inputDirty = false;
        var loadToken = Date.now();
        studentTeacherRemarkState.activeLoadToken = loadToken;

        titleEl.textContent = 'Remark: ' + studentName;
        var cachedRemarkValues = getCachedStudentTeacherRemark(studentId);
        renderStudentRemarkEditors(cachedRemarkValues);
        saveBtn.disabled = true;
        if (shouldRefreshTeacherRemarkOptions()) {
          setStudentTeacherRemarkStatus('Syncing latest remarks... Enabled types: ' + getEnabledRemarkTypesText());
        } else {
          setStudentTeacherRemarkStatus('Loaded from cache. Checking for updates... Enabled types: ' + getEnabledRemarkTypesText());
        }
        modal.classList.add('active');

        try {
          var params = new URLSearchParams({
            classId: String(studentTeacherRemarkState.classId),
            termId: String(studentTeacherRemarkState.termId),
            studentId: String(studentId),
          });
          var response = await fetch('/common/studentTeacherRemarkOptions?' + params.toString(), {
            method: 'GET',
            credentials: 'same-origin',
          });
          var result = await response.json();
          if (!response.ok || !result || !result.success) {
            throw new Error((result && result.message) || 'Failed to load remark options.');
          }

          if (studentTeacherRemarkState.activeLoadToken !== loadToken) {
            return;
          }

          setCustomRemarkTypes(Array.isArray(result.customRemarkTypes) ? result.customRemarkTypes : []);
          setSelectedRemarkTypes(result.selectedRemarkTypes);
          setTeacherRemarkOptionsCache(Array.isArray(result.options) ? result.options : []);
          var currentRemarkValues = normalizeRemarkValues(result.remarkValues || { teacher: result.teacherRemark || '' });
          setCachedStudentTeacherRemark(studentId, currentRemarkValues);
          if (!studentTeacherRemarkState.inputDirty) {
            renderStudentRemarkEditors(currentRemarkValues);
          }

          markStudentTeacherRemarkState(studentId, hasAnyEnabledRemark(currentRemarkValues));
          setStudentTeacherRemarkStatus('Enabled types: ' + getEnabledRemarkTypesText());
        } catch (error) {
          if (studentTeacherRemarkState.activeLoadToken === loadToken) {
            setStudentTeacherRemarkStatus(error && error.message ? error.message : 'Failed to load remark options.', 'error');
          }
        } finally {
          if (studentTeacherRemarkState.activeLoadToken === loadToken) {
            studentTeacherRemarkState.isLoading = false;
            saveBtn.disabled = false;
            var firstInput = document.querySelector('.student-remark-input[data-remark-type]');
            if (firstInput) firstInput.focus();
          }
        }
      }

      async function saveStudentTeacherRemark() {
        if (studentTeacherRemarkState.isSaving || !Number.isInteger(studentTeacherRemarkState.studentId)) {
          return;
        }

        var saveBtn = document.getElementById('studentTeacherRemarkSaveBtn');
        if (!saveBtn) {
          return;
        }

        var currentRemarkValues = getCurrentRemarkValuesFromInputs();

        var payload = {
          classId: studentTeacherRemarkState.classId,
          termId: studentTeacherRemarkState.termId,
          studentId: studentTeacherRemarkState.studentId,
          teacherRemark: normalizeTeacherRemarkText(currentRemarkValues.teacher || ''),
          remarkValues: currentRemarkValues,
        };

        var previousRemarkValues = getCachedStudentTeacherRemark(payload.studentId);
        if (areRemarkValuesEqual(currentRemarkValues, previousRemarkValues)) {
          setStudentTeacherRemarkStatus('No changes to save.', 'success');
          setTimeout(function() {
            closeStudentTeacherRemarkModal();
          }, 120);
          return;
        }

        setCachedStudentTeacherRemark(payload.studentId, currentRemarkValues);
        markStudentTeacherRemarkState(payload.studentId, hasAnyEnabledRemark(currentRemarkValues));

        studentTeacherRemarkState.isSaving = true;
        saveBtn.disabled = true;
        saveBtn.textContent = 'Saving...';
        setStudentTeacherRemarkStatus('Saving...');

        try {
          var response = await fetch('/common/saveStudentTeacherRemark', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            credentials: 'same-origin',
            body: JSON.stringify(payload),
          });
          var result = await response.json();
          if (!response.ok || !result || !result.success) {
            throw new Error((result && result.message) || 'Failed to save remark.');
          }

          setCachedStudentTeacherRemark(payload.studentId, currentRemarkValues);
          markStudentTeacherRemarkState(payload.studentId, hasAnyEnabledRemark(currentRemarkValues));
          setStudentTeacherRemarkStatus('Saved.', 'success');
          studentTeacherRemarkState.inputDirty = false;
          setTimeout(function() {
            closeStudentTeacherRemarkModal();
          }, 140);
        } catch (error) {
          setCachedStudentTeacherRemark(payload.studentId, previousRemarkValues);
          markStudentTeacherRemarkState(payload.studentId, hasAnyEnabledRemark(previousRemarkValues));
          setStudentTeacherRemarkStatus(error && error.message ? error.message : 'Failed to save remark.', 'error');
        } finally {
          studentTeacherRemarkState.isSaving = false;
          saveBtn.disabled = false;
          saveBtn.textContent = 'Save Remark';
        }
