      window.setMainEmployee = function (classId, userId) {
        const confirmationMessage = "Are you sure you want to set this teacher as the main teacher for this class? The main teacher will have full access and is the only teacher who can mark attendance.";
        if (!confirm(confirmationMessage)) return;

        fetch('/common/setMainEmployee', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ class_id: classId, main_employee: userId })
        })
          .then(response => response.json())
          .then(data => {
            if (data.success) {
              alert('Main class teacher set successfully');
            } else {
              alert('Failed to set main class teacher');
            }
          })
          .catch(error => {
            console.error('Error:', error);
            alert('Error setting main employee');
          });
      };

      function initClassDashboard() {
        const navToggle = document.querySelector('.nav-toggle');
        const navPanel = document.getElementById('class-tools-panel');
        const navOverlay = document.getElementById('class-tools-overlay');
        const navClose = document.querySelector('.nav-close');
        const navLinks = document.querySelectorAll('.nav-link');
        const navSublinks = document.querySelectorAll('.nav-sublink');
        const classInfoSection = document.getElementById('class-info-section');
        const classInfoToggle = document.getElementById('class-info-toggle');
        const classInfoContent = document.getElementById('class-info-content');
        const teachersSection = document.getElementById('teachers-section');
        const teachersToggle = document.getElementById('teachers-toggle');
        const teachersContent = document.getElementById('teachers-content');

        function openNav() {
          if (navPanel) navPanel.classList.add('open');
          if (navOverlay) navOverlay.classList.add('show');
        }

        function closeNav() {
          if (navPanel) navPanel.classList.remove('open');
          if (navOverlay) navOverlay.classList.remove('show');
        }

        function setTeachersOpen(isOpen) {
          if (!teachersSection || !teachersToggle || !teachersContent) return;
          teachersSection.classList.toggle('open', isOpen);
          teachersToggle.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
          teachersContent.hidden = !isOpen;
        }

        function isSmallScreen() {
          return window.matchMedia('(max-width: 960px)').matches;
        }

        function setClassInfoOpen(isOpen) {
          if (!classInfoSection || !classInfoToggle || !classInfoContent) return;
          classInfoSection.classList.toggle('open', isOpen);
          classInfoToggle.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
          classInfoContent.hidden = !isOpen;
        }

        function syncClassInfoForViewport() {
          if (!classInfoSection || !classInfoToggle || !classInfoContent) return;
          if (isSmallScreen()) {
            setClassInfoOpen(false);
          } else {
            setClassInfoOpen(true);
          }
        }

        if (navToggle && !navToggle.dataset.boundNavToggle) {
          navToggle.dataset.boundNavToggle = '1';
          navToggle.addEventListener('click', openNav);
        }
        if (navOverlay && !navOverlay.dataset.boundNavOverlay) {
          navOverlay.dataset.boundNavOverlay = '1';
          navOverlay.addEventListener('click', closeNav);
        }
        if (navClose && !navClose.dataset.boundNavClose) {
          navClose.dataset.boundNavClose = '1';
          navClose.addEventListener('click', closeNav);
        }
        if (navLinks && navLinks.length) {
          navLinks.forEach(link => {
            if (link.classList.contains('nav-section-toggle') || link.id === 'subjects-section-toggle') {
              return;
            }

            if (!link.dataset.boundNavLinkClose) {
              link.dataset.boundNavLinkClose = '1';
              link.addEventListener('click', () => {
                if (!isSmallScreen()) return;
                closeNav();
              });
            }
          });
        }

        if (navSublinks && navSublinks.length) {
          navSublinks.forEach(link => {
            if (!link.dataset.boundNavSublinkClose) {
              link.dataset.boundNavSublinkClose = '1';
              link.addEventListener('click', () => {
                if (!isSmallScreen()) return;
                closeNav();
              });
            }
          });
        }

        if (classInfoToggle) {
          syncClassInfoForViewport();
          if (!classInfoToggle.dataset.boundClassInfoToggle) {
            classInfoToggle.dataset.boundClassInfoToggle = '1';
            classInfoToggle.addEventListener('click', () => {
              if (!isSmallScreen()) return;
              const isOpen = classInfoToggle.getAttribute('aria-expanded') === 'true';
              setClassInfoOpen(!isOpen);
            });
          }

          if (window.__classDashboardResizeHandler) {
            window.removeEventListener('resize', window.__classDashboardResizeHandler);
          }
          window.__classDashboardResizeHandler = syncClassInfoForViewport;
          window.addEventListener('resize', window.__classDashboardResizeHandler);
        }

        if (teachersToggle) {
          setTeachersOpen(false);
          if (!teachersToggle.dataset.boundTeachersToggle) {
            teachersToggle.dataset.boundTeachersToggle = '1';
            teachersToggle.addEventListener('click', () => {
              const isOpen = teachersToggle.getAttribute('aria-expanded') === 'true';
              setTeachersOpen(!isOpen);
            });
          }
        }
      }

      initClassDashboard();
      openWorkspaceRoute(workspaceContext.initialRoute || { panel: 'overview', itemId: '' }, { replaceHistory: true });
      if (!window.__classWorkspacePopstateBound) {
        window.__classWorkspacePopstateBound = true;
        window.addEventListener('popstate', handleWorkspacePopState);
      }
    })();

