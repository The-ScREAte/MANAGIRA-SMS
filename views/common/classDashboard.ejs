}

.workspace-panel[hidden] {
  display: none !important;
}

.workspace-panel-head {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 12px;
  margin-bottom: 10px;
}

.workspace-panel-head .card-title {
  margin-bottom: 2px;
  font-size: 15px;
}
.workspace-panel-head .card-subtext {
  margin: 0;
  font-size: 12px;
}

.schedule-mobile-toggle {
  display: none;
}

.workspace-empty-state {
  display: grid;
  place-items: center;
  min-height: 420px;
  padding: 32px;
}

.workspace-empty-state[hidden] {
  display: none !important;
}

.workspace-empty-card {
  max-width: 420px;
  text-align: center;
}

.workspace-empty-card h2 {
  margin: 0 0 10px;
  color: var(--text);
  font-size: 24px;
}

.workspace-empty-card p {
  margin: 0;
  color: var(--muted);
  line-height: 1.7;
}

.workspace-overview-grid {
  display: grid;
  gap: 16px;
}

.workspace-quick-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 12px;
}

.workspace-quick-button {
  width: 100%;
  border: 1px solid var(--border);
  border-radius: 14px;
  background: linear-gradient(180deg, #ffffff 0%, #f8fbff 100%);
  padding: 16px;
  text-align: left;
  cursor: pointer;
  transition: transform 0.18s ease, border-color 0.18s ease, box-shadow 0.18s ease;
}

.workspace-quick-button:hover {
  transform: translateY(-1px);
  border-color: rgba(1, 83, 91, 0.28);
  box-shadow: 0 12px 24px rgba(15, 23, 42, 0.08);
}

.workspace-quick-label {
  display: block;
  color: var(--muted);
  font-size: 12px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.05em;
}

.workspace-quick-value {
  display: block;
  margin-top: 8px;
  color: var(--text);
  font-size: 17px;
  font-weight: 700;
}

.workspace-split-grid {
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
  gap: 16px;
}

.workspace-resource-grid {
  display: grid;
  gap: 12px;
}

.workspace-resource-button {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14px;
  padding: 14px 16px;
  border-radius: 14px;
  border: 1px solid var(--border);
  background: #fff;
  color: var(--text);
  cursor: pointer;
  text-align: left;
  transition: all 0.18s ease;
}

.workspace-resource-button:hover {
  border-color: rgba(1, 83, 91, 0.24);
  background: #f8fbff;
  box-shadow: 0 12px 24px rgba(15, 23, 42, 0.06);
}

.workspace-resource-text strong {
  display: block;
  font-size: 14px;
  font-weight: 700;
}

.workspace-resource-text span {
  display: block;
  margin-top: 4px;
  color: var(--muted);
  font-size: 12px;
}

.workspace-resource-arrow {
  color: var(--muted);
  font-size: 18px;
}

.workspace-list-stack {
  display: grid;
  gap: 12px;
}

.birthday-board {
  display: grid;
  gap: 14px;
}

.birthday-hero {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  padding: 18px 20px;
  border-radius: 18px;
  background:
    radial-gradient(circle at top right, rgba(255,255,255,0.75), transparent 32%),
    linear-gradient(135deg, color-mix(in srgb, var(--primary) 88%, white), color-mix(in srgb, var(--primary) 72%, #f59e0b));
  color: #fff;
  overflow: hidden;
}

.birthday-hero-fireworks {
  position: absolute;
  inset: 0;
  pointer-events: none;
}

.birthday-hero-fireworks span {
  position: absolute;
  width: 82px;
  height: 82px;
  border-radius: 50%;
  opacity: 0;
  background:
    radial-gradient(circle, rgba(255,255,255,0.9) 0 8%, transparent 9% 100%),
    conic-gradient(from 0deg, rgba(255,255,255,0) 0 8%, rgba(255,255,255,0.7) 8% 12%, rgba(255,255,255,0) 12% 20%, rgba(255,255,255,0.7) 20% 24%, rgba(255,255,255,0) 24% 32%, rgba(255,255,255,0.7) 32% 36%, rgba(255,255,255,0) 36% 44%, rgba(255,255,255,0.7) 44% 48%, rgba(255,255,255,0) 48% 56%, rgba(255,255,255,0.7) 56% 60%, rgba(255,255,255,0) 60% 68%, rgba(255,255,255,0.7) 68% 72%, rgba(255,255,255,0) 72% 80%, rgba(255,255,255,0.7) 80% 84%, rgba(255,255,255,0) 84% 100%);
  animation: birthdayBurst 4.6s ease-in-out infinite;
}

.birthday-hero-fireworks span:nth-child(1) { top: -8px; right: 20px; animation-delay: 0s; }
.birthday-hero-fireworks span:nth-child(2) { top: 28px; left: 52%; animation-delay: 1.3s; transform: scale(0.86); }
.birthday-hero-fireworks span:nth-child(3) { bottom: -10px; left: 28px; animation-delay: 2.5s; transform: scale(0.72); }

@keyframes birthdayBurst {
  0%, 100% { opacity: 0; transform: scale(0.5) translateY(8px); }
  18% { opacity: 0.85; transform: scale(1) translateY(0); }
  34% { opacity: 0.25; transform: scale(1.2) translateY(-8px); }
  52% { opacity: 0; transform: scale(1.36) translateY(-18px); }
}

.birthday-hero-copy {
  display: grid;
  gap: 6px;
}

.birthday-hero-copy .eyebrow {
  font-size: 0.78rem;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  opacity: 0.9;
}

.birthday-hero-copy h3 {
  margin: 0;
  font-size: 1.15rem;
  line-height: 1.2;
  color: inherit;
}

.birthday-hero-copy p {
  margin: 0;
  color: rgba(255,255,255,0.92);
  line-height: 1.5;
}

.birthday-count-pill {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 60px;
  min-height: 60px;
  padding: 10px 14px;
  border-radius: 18px;
  background: rgba(255,255,255,0.16);
  border: 1px solid rgba(255,255,255,0.22);
  backdrop-filter: blur(12px);
  font-size: 1.4rem;
  font-weight: 800;
}

.birthday-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
  gap: 14px;
}

.birthday-card {
  border: 1px solid rgba(148, 163, 184, 0.18);
  border-radius: 18px;
  background: linear-gradient(180deg, #ffffff, #f8fafc);
  padding: 16px;
  text-align: left;
  display: grid;
  gap: 10px;
  cursor: pointer;
  transition: transform 0.18s ease, box-shadow 0.18s ease, border-color 0.18s ease;
}

.birthday-card:hover {
  transform: translateY(-2px);
  box-shadow: 0 16px 32px rgba(15, 23, 42, 0.1);
  border-color: color-mix(in srgb, var(--primary) 26%, white);
}

.birthday-card-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 10px;
}

.birthday-timing-pill {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: fit-content;
  padding: 5px 10px;
  border-radius: 999px;
  background: color-mix(in srgb, var(--primary) 12%, white);
  color: var(--primary);
  font-size: 0.76rem;
  font-weight: 700;
}

.birthday-card h3 {
  margin: 0;
  font-size: 1rem;
  line-height: 1.25;
  color: #0f172a;
}

.birthday-card-meta {
  display: grid;
  gap: 6px;
  margin: 0;
}

.birthday-card-meta p {
  margin: 0;
  color: #475569;
  font-size: 0.88rem;
  line-height: 1.45;
}

.birthday-card-meta strong {
  color: #0f172a;
}

.birthday-empty {
  border: 1px dashed rgba(148, 163, 184, 0.4);
  border-radius: 18px;
  background: linear-gradient(180deg, #ffffff, #f8fafc);
  padding: 28px 22px;
  text-align: center;
  color: #64748b;
}

.birthday-empty h3 {
  margin: 0 0 8px;
  color: #0f172a;
}

.birthday-group-wish {
  margin: 0;
  padding: 14px 16px;
  border-radius: 16px;
  background: rgba(255,255,255,0.16);
  border: 1px solid rgba(255,255,255,0.24);
  color: rgba(255,255,255,0.95);
  line-height: 1.55;
}

.workspace-frame-panel {
  padding: 0;
}

.workspace-frame-shell {
  min-height: inherit;
  background: #f8fafc;
}

.workspace-frame-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 16px;
  padding: 16px 20px;
  border-bottom: 1px solid var(--border);
  background: linear-gradient(180deg, #ffffff 0%, #f8fbff 100%);
}

.workspace-frame-title {
  margin: 0;
  color: var(--text);
  font-size: 16px;
  font-weight: 700;
}

.workspace-frame-subtext {
  margin: 4px 0 0;
  color: var(--muted);
  font-size: 12px;
}

.workspace-frame {
  width: 100%;
  height: calc(100vh - 200px);
  min-height: 300px;
  border: none;
  display: block;
  background: #ffffff;
}

#panel-frame-paygira {
  padding: 0;
}

#panel-frame-paygira .workspace-frame-shell {
  min-height: calc(100vh - 238px);
  background: #080d1a;
}

#panel-frame-paygira .workspace-frame {
  display: block;
  min-height: calc(100vh - 238px);
  background: #080d1a;
}

#panel-frame-attendance {
  padding: 0;
}

#panel-frame-attendance .workspace-frame-shell {
  min-height: calc(100vh - 238px);
  background: #f8fafc;
}

#panel-frame-attendance .workspace-frame {
  display: block;
  min-height: calc(100vh - 238px);
  background: #f8fafc;
}

@keyframes workspaceFadeIn {
  from { opacity: 0; transform: translateY(4px); }
  to { opacity: 1; transform: translateY(0); }
}

@media (max-width: 1180px) {
  .workspace-quick-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .workspace-meta-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}

@media (max-width: 960px) {
  .workspace-grid {
    grid-template-columns: 1fr;
  }

  .workspace-sidebar {
    position: fixed;
    top: 72px;
    left: 0;
    width: 300px;
    max-width: 86vw;
    height: calc(100vh - 88px);
    z-index: 999;
  }

  .workspace-stage {
    min-height: auto;
  }
}

@media (max-width: 768px) {
  .workspace-header-row,
  .workspace-panel-head,
  .workspace-split-grid {
    grid-template-columns: 1fr;
    flex-direction: column;
  }

  .workspace-quick-grid,
  .workspace-meta-grid {
    grid-template-columns: 1fr 1fr;
  }
}

@media (max-width: 560px) {
  .workspace-shell {
    width: 100%;
    margin: 0;
    padding: 12px 12px 24px;
  }

  .workspace-header-card,
  .workspace-panel {
    padding: 16px;
  }

  .workspace-quick-grid,
  .workspace-meta-grid,
  .workspace-split-grid {
    grid-template-columns: 1fr;
  }

  .workspace-frame-header {
    padding: 14px 16px;
  }

  .workspace-frame {
    min-height: calc(100vh - 300px);
  }

  #panel-frame-paygira .workspace-frame-shell,
  #panel-frame-paygira .workspace-frame {
    min-height: calc(100vh - 188px);
  }
