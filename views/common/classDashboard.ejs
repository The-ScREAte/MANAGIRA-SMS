<%
  const themeColor = (typeof session !== 'undefined' && session && session.themeColor) ? session.themeColor : 'teal';
  const themeColors = {
    teal: { primary: '#01535b', hover: '#014a51' },
    blue: { primary: '#2563eb', hover: '#1d4ed8' },
    green: { primary: '#2e7d32', hover: '#1b5e20' },
    purple: { primary: '#7c3aed', hover: '#6d28d9' },
    indigo: { primary: '#4f46e5', hover: '#4338ca' },
    rose: { primary: '#8b2635', hover: '#7a212e' },
    amber: { primary: '#d97706', hover: '#b45309' },
    slate: { primary: '#334155', hover: '#1e293b' }
  };
  const currentTheme = themeColors[themeColor] || themeColors.teal;
  const workspaceStudents = (students || []).map((student) => ({
    id: student.student_id,
    name: (typeof formatDisplayName === 'function'
      ? formatDisplayName(student)
      : `${student.first_name} ${student.last_name}`),
    firstName: student.first_name,
    lastName: student.last_name,
  }));
  const workspaceSubjects = (subjects || []).map((subject) => ({
    id: subject.subject_id,
    name: subject.subject_name,
  }));
%>
<style>
:root {
  --border: #e5e7eb;
  --muted: #6b7280;
  --bg: #f9fafb;
  --primary: <%= currentTheme.primary %>;
  --primary-hover: <%= currentTheme.hover %>;
        --primary-hover-fill: color-mix(in srgb, var(--primary) 88%, white);
  --text: #111827;
  --font-family: "<%= (session && session.fontStyle ? String(session.fontStyle).trim() : 'Inter') %>", sans-serif;
}

body {
  background: var(--bg);
  font-family: var(--font-family);
  min-height: 100vh;
  display: flex;
  flex-direction: column;
}

html, body {
  width: 100%;
  max-width: 100%;
  overflow-x: hidden;
}

html body main,
main {
  flex: 1 0 auto;
  width: 100% !important;
  max-width: none !important;
  margin: 0 !important;
  padding: 0 !important;
  zoom: 1 !important;
  box-sizing: border-box;
}

/* Neutralize any centered parent containers from the shared layout for this page */
.container,
.container-md,
.container-lg,
.container-xl,
.page-wrapper,
.layout-shell,
.app-body,
.content,
#app-scale-root {
  max-width: none !important;
  width: 100% !important;
  margin: 0 !important;
}

.dashboard-shell {
  max-width: 1200px;
  margin: 0 auto;
  padding: 20px 16px 40px;
  width: 100%;
  flex: 1 0 auto;
}

.dashboard-grid {
  display: grid;
  grid-template-columns: 260px 1fr;
  gap: 24px;
  align-items: start;
}

.card {
  background: #fff;
  border: 1px solid var(--border);
  border-radius: 12px;
  box-shadow: 0 8px 24px rgba(15, 23, 42, 0.04);
}

.card-header {
  padding: 16px;
  border-bottom: 1px solid var(--border);
}

.card-body {
  padding: 16px;
}

.dashboard-main {
  background: transparent;
  border: none;
  box-shadow: none;
}

.dashboard-header {
  padding: 8px 4px 12px;
}

.dashboard-content {
  padding: 0;
}

.page-title {
  margin: 0;
  font-size: 28px;
  font-weight: 700;
  color: var(--text);
}

.card-title {
  margin: 0;
  font-size: 18px;
  font-weight: 700;
  color: var(--text);
}

.card-subtext {
  margin: 4px 0 0;
  color: var(--muted);
  font-size: 13px;
}

.eyebrow {
  margin: 0;
  text-transform: uppercase;
  letter-spacing: 0.06em;
  color: var(--muted);
  font-size: 11px;
  font-weight: 600;
}

.nav-card {
  padding: 14px 12px 16px;
  position: sticky;
  top: 80px;
  border-radius: 14px;
  border: 1px solid var(--border);
  box-shadow: 0 10px 26px rgba(15, 23, 42, 0.08);
}


.nav-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 4px 8px;
  margin: 4px 4px 10px;
  border-bottom: 1px solid var(--border);
}

.nav-header h3 {
  margin: 4px 0 0;
  font-size: 18px;
  color: var(--primary);
  font-weight: 700;
}

.nav-close {
  display: none;
  background: transparent;
  border: none;
  font-size: 22px;
  cursor: pointer;
  padding: 0;
  color: #6b7280;
  line-height: 1;
}

.side-nav {
  padding: 6px 8px 10px;
  text-align: left;
}

.nav-list {
  list-style: none;
  padding: 0;
  margin: 0;
  display: grid;
  gap: 2px;
  justify-items: stretch;
}

.nav-section-label {
  margin: 8px 6px 2px;
  color: var(--muted);
  font-size: 10px;
  font-weight: 700;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  text-align: left;
}

.nav-link {
  position: relative;
  width: 100%;
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 5px 10px 5px 12px;
  border-radius: 8px;
  color: #475569;
  text-decoration: none;
  border: 1px solid transparent;
  background: transparent;
  cursor: pointer;
  font: inherit;
  font-weight: 500;
  font-size: 13px;
  text-align: left;
  transition: background 0.15s ease, color 0.15s ease;
}
.nav-link .nav-icon {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 18px;
  height: 18px;
  color: #94a3b8;
  flex-shrink: 0;
}
.nav-link .nav-icon svg {
  width: 16px;
  height: 16px;
  display: block;
}
.nav-link .nav-link-label { flex: 1; }

.files-link-inline {
  display: inline-flex;
  align-items: center;
  gap: 8px;
}

.files-badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 20px;
  height: 20px;
  padding: 0 7px;
  border-radius: 999px;
  font-size: 11px;
  font-weight: 700;
  color: #fff;
  background: var(--org-primary-color);
}

.nav-link:hover {
  background: rgba(1, 83, 91, 0.06);
  color: var(--primary);
}
.nav-link:hover .nav-icon { color: var(--primary); }

.nav-link.active {
  background: rgba(1, 83, 91, 0.10);
  border-color: transparent;
  color: var(--primary);
  font-weight: 600;
}
.nav-link.active::before {
  content: "";
  position: absolute;
  left: 0;
  top: 6px;
  bottom: 6px;
  width: 3px;
  border-radius: 0 3px 3px 0;
  background: var(--primary);
}
.nav-link.active .nav-icon { color: var(--primary); }

.nav-toggle {
  display: none;
  align-items: center;
  gap: 8px;
  padding: 10px 12px;
  border-radius: 10px;
  border: 1px solid var(--border);
  background: #fff;
  cursor: pointer;
  font: inherit;
  margin-bottom: 12px;
}

.hamburger-icon {
  position: relative;
  width: 16px;
  height: 2px;
  background: #111827;
  display: inline-block;
}

.hamburger-icon::before,
.hamburger-icon::after {
  content: "";
  position: absolute;
  left: 0;
  width: 16px;
  height: 2px;
  background: #111827;
}

.hamburger-icon::before { top: -5px; }
.hamburger-icon::after { top: 5px; }

.nav-overlay {
  position: fixed;
  inset: 0;
  background: rgba(17, 24, 39, 0.35);
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.2s ease;
  z-index: 998;
}

.nav-overlay.show {
  opacity: 1;
  pointer-events: auto;
}

.meta-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
  gap: 12px;
}

.meta-tile {
  padding: 12px;
  border: 1px solid var(--border);
  border-radius: 10px;
  background: #f9fafb;
}

.meta-label { color: var(--muted); font-size: 12px; margin: 0 0 4px; }
.meta-value { margin: 0; font-weight: 600; color: var(--text); }

.section-card {
  border: 1px solid var(--border);
  border-radius: 12px;
  padding: 10px 12px;
  margin-top: 10px;
  background: #fff;
  box-shadow: 0 2px 8px rgba(15, 23, 42, 0.03);
}

.dashboard-content > .section-card:first-child {
  margin-top: 0;
}

.section-title {
  margin: 0 0 6px;
  font-weight: 600;
  color: var(--text);
}

.section-toggle {
  width: 100%;
  border: none;
  background: transparent;
  padding: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  cursor: pointer;
  text-align: left;
}

.section-toggle:hover,
.section-toggle:active,
.section-toggle:focus,
.section-toggle:focus-visible {
  background: transparent !important;
  color: inherit;
  box-shadow: none;
}

.section-toggle .section-title {
  margin: 0;
}

.section-toggle-icon {
  color: var(--muted);
  font-size: 24px;
  line-height: 1;
  transition: transform 0.2s ease, color 0.2s ease;
}

.teacher-section.open .section-toggle-icon,
.class-info-section.open .section-toggle-icon {
  transform: rotate(90deg);
  color: var(--text);
}

.section-collapse {
  padding-top: 10px;
}

.class-info-toggle {
  display: none;
}

.class-info-section .section-collapse {
  padding-top: 0;
}

.section-subtext {
  margin: 0 0 10px;
  color: var(--muted);
  font-size: 13px;
}

.teacher-list {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
  gap: 10px;
}

.teacher-card {
  border: 1px solid var(--border);
  border-radius: 10px;
  padding: 10px 12px;
  display: flex;
  align-items: center;
  gap: 10px;
  background: #fff;
}

.teacher-dot {
  width: 10px;
  height: 10px;
  border-radius: 50%;
  background: var(--primary);
}

.teacher-name {
  font-weight: 600;
  color: var(--text);
}

.student-list {
  list-style: none;
  padding: 0;
  margin: 0;
  display: flex;
  flex-direction: column;
  gap: 0;
}

.student-list li {
  border-bottom: 1px solid var(--border);
}

.student-list li:last-child {
  border-bottom: none;
}

.student-row {
  display: flex;
  align-items: center;
  gap: 6px;
  padding: 6px 2px;
}

.student-index {
  color: var(--muted);
  font-size: 12px;
  font-weight: 600;
  min-width: 24px;
}

.student-link {
  color: var(--primary);
  text-decoration: none;
  font-weight: 600;
}

.student-link:hover { color: var(--primary-hover); }

.students-section {
  padding: 10px 12px;
}

.students-section .section-title {
  margin: 0 0 2px;
}

.students-section .student-list {
  margin: 0;
}

.students-section .student-list li {
  margin: 0;
  padding: 0;
}

.students-section .student-row {
  gap: 4px;
  padding: 4px 0;
}

.students-section .student-index {
  min-width: 18px;
}

@media (max-width: 960px) {
  .dashboard-grid { grid-template-columns: 1fr; }
  .nav-toggle {
    display: inline-flex;
    position: sticky;
    top: 8px;
    z-index: 900;
  }
  .nav-card {
    position: fixed;
    top: 72px;
    left: 0;
    width: 300px;
    max-width: 85vw;
    height: auto;
    max-height: calc(100vh - 120px);
    padding: 26px 20px 20px;
    border-radius: 0 14px 14px 0;
    overflow-y: auto;
    transform: translateX(-110%);
    transition: transform 0.25s ease;
    z-index: 999;
    box-shadow: 0 10px 26px rgba(15, 23, 42, 0.08);
  }
  .nav-header {
    position: relative;
    padding: 0 0 12px;
    margin: 0 0 14px;
    border-bottom: 1px solid var(--border);
  }
  .nav-close {
    display: inline-flex;
    position: absolute;
    top: -2px;
    right: 0;
    width: 28px;
    height: 28px;
    padding: 0;
    line-height: 1;
  }
  .side-nav { padding: 0; }
  .nav-list { gap: 4px; }
  .class-info-toggle { display: flex; }
  .class-info-section .section-collapse { padding-top: 10px; }
  .nav-card.open { transform: translateX(0); }
  .nav-close { display: inline-flex; }
  .dashboard-shell { padding-top: 12px; }
}

@media (max-width: 768px) {
  body {
    padding-bottom: 0 !important;
  }
}

/* Report panel - list cards */
.rp-card {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 7px 10px;
  border: 1px solid var(--border);
  border-radius: 8px;
  margin-bottom: 6px;
  cursor: pointer;
  text-decoration: none;
  color: inherit;
  background: #fff;
  transition: border-color 0.2s, box-shadow 0.2s;
  gap: 10px;
}
.rp-card:hover {
  border-color: var(--primary);
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.06);
}
.rp-left { flex: 1; min-width: 0; }
.rp-subject {
  font-weight: 600;
  font-size: 12.5px;
  color: var(--text);
  margin: 0 0 2px;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.rp-meta {
  font-size: 11px;
  color: var(--muted);
  display: flex;
  gap: 5px;
  flex-wrap: wrap;
  align-items: center;
}
.rp-meta span { display: inline-flex; align-items: center; gap: 3px; }
.rp-meta .rp-dot { width: 3px; height: 3px; border-radius: 50%; background: #cbd5e1; flex-shrink: 0; }
.rp-right { display: flex; align-items: center; gap: 8px; flex-shrink: 0; }
.rp-replies {
  font-size: 11px;
  color: var(--muted);
  white-space: nowrap;
  display: inline-flex;
  align-items: center;
  gap: 4px;
}
.rp-empty {
  text-align: center;
  padding: 18px 12px;
  color: var(--muted);
  font-size: 12.5px;
}
.rp-panel-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 14px;
  padding-bottom: 10px;
  border-bottom: 1px solid var(--border);
}
.rp-panel-title {
  font-size: 16px;
  font-weight: 700;
  color: var(--text);
  margin: 0;
  display: flex;
  align-items: center;
  gap: 8px;
}
.rp-panel-close {
  background: none;
  border: 1px solid var(--border);
  border-radius: 8px;
  width: 32px;
  height: 32px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 18px;
  cursor: pointer;
  color: var(--muted);
  transition: all 0.15s;
}
.rp-panel-close:hover {
  background: #f3f4f6;
  color: var(--text);
  border-color: #d1d5db;
}

/* Report detail modal */
.report-modal-overlay {
  display: none;
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 13000;
  justify-content: center;
  align-items: flex-start;
  padding: calc(env(safe-area-inset-top, 0px) + 96px) 14px 18px;
  overflow-y: auto;
  backdrop-filter: blur(2px);
}
.report-modal-overlay.active { display: flex; }
.report-modal-box {
  background: #fff;
  border-radius: 14px;
  width: 100%;
  max-width: 760px;
  padding: 0;
  box-shadow: 0 20px 60px rgba(0, 0, 0, 0.2), 0 0 0 1px rgba(0, 0, 0, 0.05);
  position: relative;
  max-height: calc(100dvh - (env(safe-area-inset-top, 0px) + 114px));
  overflow-y: auto;
  animation: modalSlideIn 0.2s ease-out;
}
@keyframes modalSlideIn {
  from { opacity: 0; transform: translateY(-12px); }
  to { opacity: 1; transform: translateY(0); }
}
.report-modal-close {
  position: sticky;
  top: 0;
  float: right;
  margin: 14px 14px 0 0;
  background: #f3f4f6;
  border: 1px solid var(--border);
  border-radius: 8px;
  width: 32px;
  height: 32px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 18px;
  cursor: pointer;
  color: var(--muted);
  line-height: 1;
  z-index: 2;
  transition: all 0.15s;
}
.report-modal-close:hover {
  background: #e5e7eb;
  color: var(--text);
}

/* Report detail content */
.rd-modal-body { padding: 14px 14px 16px; }
.rd-title {
  font-size: 1.16rem;
  font-weight: 700;
  color: var(--text);
  margin: 0 0 8px;
  line-height: 1.26;
  letter-spacing: -0.01em;
}

.rd-keyline {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8px;
  flex-wrap: wrap;
  margin-bottom: 8px;
}

.rd-keyline-student {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  font-size: 0.88rem;
  color: #334155;
}

.rd-meta-inline {
  font-size: 0.84rem;
  color: #64748b;
  display: flex;
  align-items: center;
  gap: 6px;
  flex-wrap: wrap;
  margin-bottom: 8px;
}

.rd-cc-hover {
  position: relative;
  display: inline-flex;
  align-items: center;
  cursor: default;
}

.rd-cc-tooltip {
  position: absolute;
  top: calc(100% + 6px);
  left: 0;
  min-width: 220px;
  max-width: min(320px, 80vw);
  padding: 8px;
  border: 1px solid #dbe3ec;
  border-radius: 10px;
  background: #fff;
  box-shadow: 0 10px 24px rgba(15, 23, 42, 0.12);
  display: none;
  z-index: 20;
}

.rd-cc-hover:hover .rd-cc-tooltip,
.rd-cc-hover:focus-within .rd-cc-tooltip {
  display: block;
}

.rd-cc-tooltip-title {
  font-size: 0.72rem;
  color: #64748b;
  text-transform: uppercase;
  letter-spacing: 0.06em;
  margin-bottom: 6px;
  font-weight: 700;
}

.rd-cc-tooltip-list {
  display: grid;
  gap: 6px;
}

.rd-cc-tooltip-item {
  background: #f8fafc;
  border: 1px solid #e2e8f0;
  color: #334155;
  padding: 6px 8px;
  border-radius: 9px;
  font-size: 0.79rem;
}

.rd-cc-tooltip-item .role {
  color: #64748b;
}

.rd-cc-tooltip-state {
  font-size: 0.8rem;
  color: #64748b;
}

.rd-meta-sep {
  width: 4px;
  height: 4px;
  border-radius: 50%;
  background: #cbd5e1;
}

.rd-keyline-student .rd-meta-label {
  color: #64748b;
  font-weight: 700;
  font-size: 0.75rem;
  text-transform: uppercase;
  letter-spacing: 0.06em;
}

.rd-keyline-date {
  font-size: 0.74rem;
  color: #94a3b8;
}

.rd-badge-row {
  display: flex;
  align-items: center;
  gap: 8px;
  margin-bottom: 8px;
  flex-wrap: wrap;
}


.rd-info-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(170px, 1fr));
  gap: 8px;
  margin-top: 8px;
  padding-top: 8px;
  background: transparent;
  border-top: 1px solid #edf2f7;
}

.rd-info-label {
  font-size: 11px;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.04em;
  color: var(--muted);
  margin: 0 0 2px;
}
.rd-info-value {
  font-size: 13px;
  font-weight: 600;
  color: var(--text);
  margin: 0;
}
.rd-badge {
  display: inline-block;
  padding: 4px 10px;
  border-radius: 999px;
  font-size: 0.69rem;
  font-weight: 700;
  text-transform: capitalize;
  letter-spacing: 0.07em;
}
.rd-priority-urgent { background: #fef2f2; color: #dc2626; }
.rd-priority-high { background: #fff7ed; color: #c2410c; }
.rd-priority-normal { background: #eff6ff; color: #2563eb; }
.rd-priority-low { background: #f9fafb; color: #6b7280; }

.rd-message-box {
  border: 1px solid #e2e8f0;
  border-radius: 12px;
  background: #fff;
  margin-bottom: 10px;
  overflow: hidden;
}

.rd-message-title {
  font-size: 0.76rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.06em;
  color: #64748b;
  padding: 8px 10px;
  border-bottom: 1px solid #edf2f7;
  background: #f8fafc;
}

.rd-message {
  padding: 12px 12px;
  border-radius: 10px;
  margin-bottom: 0;
  font-size: 0.88rem;
  line-height: 1.58;
  color: #334155;
  white-space: pre-wrap;
  word-wrap: break-word;
}

.rd-section { margin-bottom: 10px; }
.rd-section-title {
  font-size: 0.76rem;
  font-weight: 700;
  color: #64748b;
  margin: 0 0 8px;
  text-transform: uppercase;
  letter-spacing: 0.06em;
  display: flex;
  align-items: center;
  gap: 6px;
}
.rd-section-title::after {
  content: '';
  flex: 1;
  height: 1px;
  background: var(--border);
}
.rd-recipients {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
  gap: 6px;
}
.rd-tag {
  background: #f8fafc;
  border: 1px solid #e2e8f0;
  color: #334155;
  padding: 6px 8px;
  border-radius: 9px;
  font-size: 0.79rem;
  font-weight: 500;
}

.rd-thread-scroll {
  max-height: 44vh;
  overflow-y: auto;
  overflow-x: visible;
  position: relative;
  padding-right: 2px;
}

.rd-thread-scroll.rd-severity-urgent .rd-reply {
  background: #fef2f2;
  border-color: #fecaca;
}

.rd-thread-scroll.rd-severity-high .rd-reply {
  background: #fff7ed;
  border-color: #fed7aa;
}

.rd-thread-scroll.rd-severity-medium .rd-reply,
.rd-thread-scroll.rd-severity-normal .rd-reply {
  background: #eff6ff;
  border-color: #bfdbfe;
}

.rd-thread-scroll.rd-severity-low .rd-reply {
  background: #f8fafc;
  border-color: #e2e8f0;
}

/* Conversation thread */
.rd-reply {
  padding: 10px 44px 10px 11px;
  border-radius: 9px;
  margin-bottom: 8px;
  border: 1px solid #edf2f7;
  border-left: 3px solid #cbd5e1;
  background: #fcfdff;
  max-width: 88%;
  position: relative;
}
.rd-reply.is-mine {
  margin-left: auto;
  border-left-color: #93c5fd;
  background: #eff6ff;
}
.rd-reply.is-theirs {
  margin-right: auto;
}
.rd-reply:last-child { margin-bottom: 0; }
.rd-reply.is-guardian {
  border-left-color: #86efac;
}
.rd-reply.is-staff {
  border-left-color: #93c5fd;
}
.rd-reply-header {
  display: flex;
  align-items: center;
  margin-bottom: 4px;
}
.rd-reply-sender {
  font-weight: 600;
  font-size: 13px;
  display: flex;
  align-items: center;
  gap: 6px;
}
.rd-reply-sender .sender-dot {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  flex-shrink: 0;
}
.rd-reply-sender .sender-dot.guardian { background: #10b981; }
.rd-reply-sender .sender-dot.staff { background: #3b82f6; }
.rd-reply-sender .sender-name { color: var(--text); }
.rd-reply-sender .sender-label {
  font-size: 11px;
  font-weight: 500;
  color: var(--muted);
}
.rd-reply-date {
  display: block;
  font-size: 11px;
  color: #94a3b8;
  white-space: nowrap;
  margin-top: 6px;
  text-align: left;
}
.rd-reply-msg {
  font-size: 13px;
  color: #475569;
  line-height: 1.6;
  margin: 0;
  white-space: pre-wrap;
  word-wrap: break-word;
}
.rd-msg-menu-wrap {
  position: absolute;
  top: 10px;
  right: 10px;
  z-index: 70;
}

.rd-msg-menu-btn {
  border: 1px solid #e2e8f0;
  background: #fff;
  color: #64748b;
  width: 24px;
  height: 24px;
  border-radius: 8px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  font-size: 0.95rem;
  line-height: 1;
}

.rd-msg-menu-btn:hover {
  color: #1f2937;
  background: #f8fafc;
}

.rd-msg-menu-dropdown {
  display: none;
  position: absolute;
  top: 28px;
  right: 0;
  min-width: 130px;
  background: #fff;
  border: 1px solid #e2e8f0;
  border-radius: 10px;
  overflow: visible;
  box-shadow: 0 10px 28px rgba(15, 23, 42, 0.14);
  padding: 8px 10px;
  z-index: 80;
}

.rd-msg-menu-wrap.open .rd-msg-menu-dropdown {
  display: block;
}

.rd-msg-menu-text {
  color: #dc2626;
  font-size: 0.8rem;
  font-weight: 600;
  cursor: pointer;
  text-decoration: none;
}

.rd-msg-menu-text:hover {
  text-decoration: underline;
}
.rd-no-replies {
  text-align: center;
  padding: 20px 12px;
  color: #94a3b8;
  font-size: 13px;
  border: 1px dashed var(--border);
  border-radius: 10px;
}

/* Reply form */
.rd-reply-form {
  margin-top: 10px;
  padding-top: 10px;
  border-top: 1px solid var(--border);
}
.rd-reply-form label {
  display: block;
  font-size: 13px;
  font-weight: 600;
  color: var(--text);
  margin-bottom: 6px;
}
.rd-reply-form textarea {
  width: 100%;
  min-height: 38px;
  max-height: 220px;
  padding: 10px 12px;
  border: 1px solid #d1d5db;
  border-radius: 999px;
  font-size: 16px;
  font-family: inherit;
  resize: none;
  overflow: hidden;
  line-height: 1.35;
  box-sizing: border-box;
  transition: border-color 0.15s, box-shadow 0.15s;
  color: var(--text);
}
.rd-reply-form textarea:focus {
  outline: none;
  border-color: var(--primary);
  box-shadow: 0 0 0 3px rgba(1, 83, 91, 0.1);
}
.rd-reply-form textarea::placeholder { color: #9ca3af; }
.rd-reply-form .rd-form-actions {
  display: flex;
  align-items: center;
  justify-content: flex-start;
  margin-top: 8px;
}

.rd-reply-composer {
  display: flex;
  align-items: flex-end;
  gap: 8px;
}

.rd-reply-composer textarea {
  flex: 1;
}

.rd-reply-send-btn {
  background: var(--primary);
  color: #fff;
  width: 38px;
  height: 38px;
  min-width: 38px;
  padding: 0;
  border: none;
  border-radius: 999px;
  font-weight: 600;
  font-size: 14px;
  cursor: pointer;
  transition: background 0.15s, transform 0.1s;
  display: inline-flex;
  align-items: center;
  justify-content: center;
}

.rd-reply-send-btn svg {
  width: 16px;
  height: 16px;
  transform: translateX(1px);
}

.rd-reply-send-btn:hover {
  background: var(--primary-hover-fill, var(--primary-hover));
  transform: translateY(-1px);
}
.rd-reply-send-btn:active { transform: translateY(0); }
.rd-reply-send-btn:disabled {
  opacity: 0.5;
  cursor: not-allowed;
  transform: none;
}

.schedule-modal-overlay {
  position: fixed;
  inset: 0;
  display: none;
  align-items: center;
  justify-content: center;
  padding: 24px;
  background: rgba(15, 23, 42, 0.52);
  z-index: 1100;
  backdrop-filter: blur(6px);
}

.schedule-modal-overlay.active { display: flex; }

.schedule-modal-box {
  width: min(1100px, 100%);
  max-height: calc(100vh - 48px);
  overflow: auto;
  border-radius: 22px;
  background: linear-gradient(180deg, #ffffff 0%, #f8fbff 100%);
  border: 1px solid rgba(148, 163, 184, 0.24);
  box-shadow: 0 30px 80px rgba(15, 23, 42, 0.18);
  position: relative;
}

.schedule-modal-close {
  position: absolute;
  top: 16px;
  right: 16px;
  width: 40px;
  height: 40px;
  border-radius: 999px;
  border: 1px solid var(--border);
  background: #fff;
  color: #475569;
  font-size: 24px;
  line-height: 1;
  cursor: pointer;
}

.schedule-modal-body {
  padding: 36px 28px 28px;
}

.schedule-header {
  display: flex;
  justify-content: space-between;
  gap: 16px;
  align-items: flex-start;
  margin-bottom: 20px;
  padding-right: 72px;
}

.schedule-title {
  margin: 0;
  font-size: 1.65rem;
  color: var(--text);
}

.schedule-subtext {
  margin: 8px 0 0;
  color: var(--muted);
  line-height: 1.6;
}

.schedule-toolbar {
  display: flex;
  gap: 10px;
  flex-wrap: nowrap;
  justify-content: flex-end;
  align-items: center;
}

.schedule-toolbar .nav-link {
  white-space: nowrap;
}

.schedule-action-button {
  position: relative;
  justify-content: center;
}

.schedule-action-button[disabled] {
  opacity: 0.7;
  cursor: wait;
}

.schedule-action-button.is-loading {
  padding-left: 36px;
}

.schedule-action-button.is-loading::before {
  content: '';
  position: absolute;
  left: 14px;
  top: 50%;
  width: 12px;
  height: 12px;
  margin-top: -6px;
  border-radius: 999px;
  border: 2px solid currentColor;
  border-right-color: transparent;
  animation: schedule-spin 0.8s linear infinite;
}

.schedule-readonly-banner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8px;
  padding: 6px 10px;
  border: 1px solid #dbeafe;
  background: #f8fbff;
  border-radius: 8px;
  color: #334155;
  font-size: 12px;
  font-weight: 600;
}

.schedule-notice {
  display: none;
  margin-bottom: 18px;
  padding: 14px 16px;
  border-radius: 14px;
  font-size: 14px;
  font-weight: 600;
}

.schedule-notice.is-visible { display: block; }
.schedule-notice.is-success { background: #ecfdf5; color: #166534; border: 1px solid #bbf7d0; }
.schedule-notice.is-error { background: #fef2f2; color: #b91c1c; border: 1px solid #fecaca; }
.schedule-notice.is-info { background: #eff6ff; color: #1d4ed8; border: 1px solid #bfdbfe; }

.schedule-shell {
  display: grid;
  gap: 10px;
  position: relative;
}

.schedule-shell.with-watermark::after {
  content: '';
  position: absolute;
  inset: 0;
  background-image: var(--schedule-watermark-image);
  background-repeat: no-repeat;
  background-position: center;
  background-size: min(380px, 72%);
  opacity: 0.08;
  pointer-events: none;
  z-index: 2;
}

.schedule-shell > * {
  position: relative;
  z-index: 1;
}

.schedule-summary-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 8px;
}

.schedule-summary-details {
  margin-bottom: 8px;
}

.schedule-summary-toggle {
  display: none;
}

.schedule-summary-toggle::-webkit-details-marker {
  display: none;
}

.schedule-summary-toggle::marker {
  content: "";
}

.schedule-summary-toggle-button {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  border: 1px solid var(--border);
  border-radius: 14px;
  background: #fff;
  padding: 12px 14px;
  color: var(--text);
  font: inherit;
  font-weight: 700;
  cursor: pointer;
}

.schedule-summary-toggle-label {
  font-size: 14px;
}

.schedule-summary-toggle-icon {
  color: var(--muted);
  font-size: 20px;
  line-height: 1;
  transition: transform 0.2s ease;
}

.schedule-summary-details[open] .schedule-summary-toggle-icon {
  transform: rotate(90deg);
}

.schedule-summary-content {
  margin-top: 12px;
}

.schedule-summary-card {
  border: 1px solid var(--border);
  border-radius: 10px;
  background: #fff;
  padding: 8px 10px;
}

.schedule-summary-card span {
  display: block;
  font-size: 10px;
  color: var(--muted);
  text-transform: uppercase;
  letter-spacing: 0.04em;
  font-weight: 700;
}

.schedule-summary-card strong {
  display: block;
  margin-top: 2px;
  color: var(--text);
  font-size: 13px;
  font-weight: 700;
}

.schedule-empty,
.schedule-prompt {
  border: 1px dashed rgba(148, 163, 184, 0.5);
  border-radius: 18px;
  padding: 24px;
  background: #fff;
}

.schedule-empty h4,
.schedule-prompt h4 {
  margin: 0 0 10px;
  font-size: 1.1rem;
  color: var(--text);
}

.schedule-empty p,
.schedule-prompt p {
  margin: 0;
  color: var(--muted);
  line-height: 1.7;
}

.schedule-prompt-actions,
.schedule-editor-actions {
  display: flex;
  gap: 10px;
  flex-wrap: wrap;
  margin-top: 16px;
}

.schedule-table-wrap {
  --schedule-day-column-width: 92px;
  --schedule-slot-column-width: 96px;
  --schedule-cell-min-height: 44px;
  overflow: auto;
  border: 1px solid var(--border);
  border-radius: 14px;
  background: #fff;
}

.schedule-table {
  width: 100%;
  border-collapse: collapse;
  min-width: calc(var(--schedule-day-column-width) + (var(--schedule-slot-column-width) * 5));
  table-layout: fixed;
}

.schedule-table th,
.schedule-table td {
  padding: 0;
  border: 1px solid #d7dee8;
  text-align: center;
  vertical-align: middle;
}

.schedule-table th {
  background: #f8fafc;
  color: #475569;
  font-size: 10.5px;
  text-transform: uppercase;
  letter-spacing: 0.04em;
}

.schedule-table tr:last-child td { border-bottom: none; }

.schedule-table .schedule-day-cell {
  width: var(--schedule-day-column-width);
  min-width: var(--schedule-day-column-width);
  padding: 8px 6px;
  background: #f8fafc;
  font-weight: 700;
  color: #0f172a;
  font-size: 12px;
  position: sticky;
  left: 0;
  z-index: 2;
}

.schedule-slot-header {
  min-width: var(--schedule-slot-column-width);
  background: linear-gradient(180deg, #fff 0%, #f8fbff 100%);
}

.schedule-slot-header-inner {
  padding: 6px 6px 7px;
  display: grid;
  gap: 3px;
}

.schedule-slot-period-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 6px;
}

.schedule-slot-period {
  font-size: 10px;
  color: #64748b;
  font-weight: 800;
  letter-spacing: 0.06em;
}

.schedule-slot-time-grid {
  display: grid;
  gap: 2px;
}

.schedule-slot-time-display {
  font-size: 10px;
  color: #0f172a;
  font-weight: 700;
  line-height: 1.2;
}

.schedule-slot-remove {
  padding: 0;
  border-radius: 999px;
  border: 1px solid #fecaca;
  background: #fff5f5;
  color: #b91c1c;
  font-size: 13px;
  font-weight: 700;
  cursor: pointer;
  line-height: 1;
  width: 20px;
  height: 20px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 auto;
}

.schedule-day-label-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 6px;
}

.schedule-day-label-text {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: 12px;
}

.schedule-day-restore-row {
  display: flex;
  align-items: center;
  gap: 6px;
  flex-wrap: wrap;
  margin-top: 4px;
}

.schedule-day-restore-label {
  font-size: 11px;
  color: var(--muted);
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.04em;
}

.schedule-day-chip {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 4px 10px;
  border-radius: 999px;
  border: 1px solid #cbd5e1;
  background: #fff;
  color: #0f172a;
  font: inherit;
  font-size: 11.5px;
  font-weight: 600;
  cursor: pointer;
  line-height: 1.2;
}

.schedule-cell-input,
.schedule-cell-select {
  width: 100%;
  padding: 6px 8px;
  border-radius: 8px;
  border: 1px solid #cbd5e1;
  font: inherit;
  font-size: 12px;
  background: #fff;
  color: #0f172a;
  box-sizing: border-box;
}

.schedule-cell-input:focus,
.schedule-cell-select:focus {
  outline: none;
  border-color: rgba(1, 83, 91, 0.55);
  box-shadow: 0 0 0 4px rgba(1, 83, 91, 0.08);
}

.schedule-slot-time-input {
  text-align: center;
  font-weight: 700;
  padding: 5px 4px;
  font-size: 12px;
  border-radius: 8px;
}

.schedule-cell-select {
  min-width: var(--schedule-slot-column-width);
  min-height: var(--schedule-cell-min-height);
  border: none;
  border-radius: 0;
  text-align: center;
  background: transparent;
  appearance: none;
  cursor: pointer;
  padding-right: 34px;
}

.schedule-cell-select-wrap {
  position: relative;
  min-width: var(--schedule-slot-column-width);
  min-height: var(--schedule-cell-min-height);
}

.schedule-cell-arrow {
  position: absolute;
  top: 50%;
  right: 12px;
  transform: translateY(-50%);
  color: #64748b;
  font-size: 14px;
  pointer-events: none;
}

.schedule-readonly-cell {
  min-width: var(--schedule-slot-column-width);
  min-height: var(--schedule-cell-min-height);
  padding: 5px 6px;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  font-weight: 600;
  color: #0f172a;
  font-size: 11.5px;
  line-height: 1.2;
}

.schedule-readonly-cell.is-assigned-teacher-subject {
  background: color-mix(in srgb, var(--primary) 10%, white);
  color: var(--primary);
  box-shadow: inset 0 0 0 2px color-mix(in srgb, var(--primary) 22%, white);
  font-weight: 800;
}

.schedule-readonly-cell.is-custom-entry {
  background: transparent;
  color: #c77700;
  box-shadow: none;
  font-weight: 700;
}

.schedule-readonly-cell.is-empty {
  color: #94a3b8;
}

.schedule-readonly-value {
  color: #0f172a;
  font-weight: 600;
}

.schedule-readonly-subject {
  display: inline-block;
  padding: 8px 12px;
  border-radius: 999px;
  background: #f1f5f9;
  color: #334155;
  font-weight: 600;
}

.schedule-row-actions {
  display: flex;
  justify-content: flex-end;
}

.schedule-inline-note {
  margin-top: 14px;
  color: var(--muted);
  font-size: 13px;
}

@keyframes schedule-spin {
  to { transform: rotate(360deg); }
}

@media (max-width: 640px) {
  .report-modal-overlay { padding: calc(env(safe-area-inset-top, 0px) + 90px) 10px 12px; }
  .rd-modal-body { padding: 16px; }
  .rd-info-grid { grid-template-columns: 1fr; }
  .rd-recipients { grid-template-columns: 1fr; }
  .rd-thread-scroll { max-height: none; }
  .rd-keyline { align-items: flex-start; }
  .rd-keyline-date { width: 100%; }
  .rd-meta-inline { align-items: flex-start; gap: 4px; }
  .rd-meta-sep { display: none; }
  .rd-reply-header { flex-direction: column; align-items: flex-start; gap: 2px; }
  .rp-card { flex-direction: column; align-items: flex-start; }
  .rp-right { width: 100%; justify-content: space-between; }
  .schedule-table-wrap {
    --schedule-day-column-width: 90px;
    --schedule-slot-column-width: 96px;
    --schedule-cell-min-height: 52px;
  }
  .schedule-modal-overlay {
    align-items: flex-start;
    padding: 112px 12px 12px;
  }
  .schedule-modal-box { width: 100%; max-height: calc(100vh - 124px); border-radius: 18px; }
  .schedule-modal-body { padding: 24px 18px 18px; }
  .schedule-header {
    flex-direction: column;
    padding-right: 0;
    padding-top: 28px;
  }
  .schedule-summary-toggle {
    display: block;
  }
  .schedule-summary-details:not([open]) .schedule-summary-content {
    display: none;
  }
  .schedule-table th {
    font-size: 10px;
    letter-spacing: 0.04em;
  }
  .schedule-table .schedule-day-cell {
    padding: 10px 6px;
  }
  .schedule-slot-period {
    font-size: 10px;
  }
  .schedule-slot-time-display,
  .schedule-day-label-text,
  .schedule-readonly-cell {
    font-size: 11px;
  }
  .schedule-toolbar { width: 100%; flex-wrap: wrap; justify-content: flex-start; }
  .schedule-toolbar .nav-link { flex: 1 1 120px; }
  .schedule-readonly-banner { flex-direction: column; align-items: flex-start; }
  .schedule-summary-grid { grid-template-columns: 1fr 1fr; }
}

@media (max-width: 480px) {
  .schedule-summary-grid { grid-template-columns: 1fr 1fr; }
  .schedule-day-restore-row { align-items: center; }
  .schedule-day-chip { width: auto; justify-content: center; }
}

.workspace-shell {
  width: 100%;
  max-width: none !important;
  margin: 0;
  padding: 8px 12px 20px;
  box-sizing: border-box;
}

.workspace-grid {
  display: grid;
  grid-template-columns: 240px minmax(0, 1fr);
  gap: 12px;
  align-items: start;
  width: 100%;
}

.workspace-main > *,
.workspace-stage,
.workspace-panels,
.workspace-panel,
.workspace-header-card,
.workspace-tabbar-shell {
  width: 100%;
  max-width: none;
}

.workspace-sidebar {
  position: sticky;
  top: 12px;
  max-height: calc(100vh - 24px);
  overflow: auto;
  border-radius: 14px;
  padding-bottom: 12px;
  scrollbar-width: none;
}
.workspace-sidebar::-webkit-scrollbar { width: 0; height: 0; }

.workspace-main {
  min-width: 0;
  width: 100%;
  max-width: none;
  display: grid;
  gap: 8px;
  justify-self: stretch;
}

.workspace-main > .card,
.workspace-main > .report-modal-overlay {
  width: 100%;
}

.dashboard-main.workspace-main {
  width: 100%;
  max-width: none;
}

.workspace-header-card {
  padding: 10px 14px;
  border-radius: 10px;
  background: #fff;
  border: 1px solid var(--border);
  box-shadow: 0 4px 14px rgba(15, 23, 42, 0.04);
  position: sticky;
  top: 8px;
  z-index: 6;
}

/* Match heights of sidebar header ("Class Tools") with workspace header so both sit on the same baseline */
.workspace-sidebar .nav-header {
  position: sticky;
  top: 0;
  background: #fff;
  z-index: 2;
  padding: 8px 12px 6px;
  border-bottom: 1px solid var(--border);
  border-radius: 14px 14px 0 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8px;
}
.workspace-sidebar .nav-header h3 {
  margin: 0;
  font-size: 13px;
  font-weight: 700;
  color: var(--text);
  letter-spacing: 0.02em;
}
.workspace-sidebar .nav-header .card-subtext { display: none; }
.workspace-sidebar .side-nav { padding: 4px 8px 8px; display: grid; gap: 1px; }

/* Plain text-style link for "Class Room" (not a button) */
.nav-text-link {
  display: block;
  padding: 6px 4px;
  margin-bottom: 6px;
  color: var(--text);
  font-size: 13px;
  font-weight: 600;
  text-decoration: none;
  letter-spacing: 0.01em;
  cursor: pointer;
}
.nav-text-link:hover { color: var(--primary); }
.nav-text-link.is-active { color: var(--primary); }

/* Collapsible section toggle in sidebar (Subjects) */
.nav-section-collapsible { padding: 0 !important; }
.nav-section-toggle {
  width: 100%;
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 5px 10px;
  background: transparent;
  border: 1px solid transparent;
  border-radius: 8px;
  cursor: pointer;
  color: var(--text);
  font-size: 13px;
  font-weight: 500;
  text-align: left;
}
.nav-section-toggle .nav-link-label { flex: 1; }
.nav-section-toggle:hover {
  background: rgba(1, 83, 91, 0.06);
  color: var(--primary);
}
.nav-section-toggle:hover .nav-icon { color: var(--primary); }
.nav-section-icon { transition: transform 0.18s ease; font-size: 14px; color: var(--muted); }
.nav-section-toggle[aria-expanded="true"] .nav-section-icon { transform: rotate(90deg); color: var(--primary); }
.nav-count-pill {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 22px;
  padding: 1px 8px;
  border-radius: 999px;
  background: rgba(1, 83, 91, 0.10);
  color: var(--primary);
  font-size: 10px;
  font-weight: 700;
}

.nav-section-children { padding: 0 !important; }
.nav-section-children[hidden] { display: none !important; }
.nav-sublist {
  list-style: none;
  padding: 2px 0 6px 28px;
  margin: 0;
  display: grid;
  gap: 1px;
  border-left: 1px solid var(--border);
  margin-left: 18px;
}
.nav-sublink {
  width: 100%;
  text-align: left;
  background: transparent;
  border: none;
  padding: 6px 10px;
  border-radius: 6px;
  color: var(--text);
  font-size: 12.5px;
  font-weight: 500;
  cursor: pointer;
}
.nav-sublink:hover { background: rgba(1, 83, 91, 0.06); color: var(--primary); }
.nav-sub-empty { padding: 6px 10px; color: var(--muted); font-size: 11px; }

/* Overview counts row (Students, Subjects, Teachers, Reports) */
.overview-counts-row {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 8px;
}
.overview-count-chip {
  position: relative;
  border: 1px solid var(--border);
  border-radius: 10px;
  padding: 8px 10px;
  background: #fff;
  display: flex;
  align-items: center;
  gap: 10px;
  overflow: hidden;
  transition: transform 0.18s ease, box-shadow 0.18s ease, border-color 0.18s ease;
}
.overview-count-chip:hover {
  transform: translateY(-1px);
  border-color: rgba(1, 83, 91, 0.24);
  box-shadow: 0 6px 14px rgba(15, 23, 42, 0.05);
}
.overview-count-chip .count-icon {
  width: 26px;
  height: 26px;
  border-radius: 7px;
  background: rgba(1, 83, 91, 0.10);
  color: var(--primary);
  display: inline-flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.overview-count-chip .count-icon svg { width: 14px; height: 14px; }
.overview-count-chip .count-text {
  display: flex;
  flex-direction: column;
  gap: 2px;
  min-width: 0;
}
.overview-count-chip .count-label {
  font-size: 9px;
  font-weight: 700;
  color: var(--muted);
  text-transform: uppercase;
  letter-spacing: 0.06em;
}
.overview-count-chip .count-num {
  font-size: 16px;
  font-weight: 700;
  color: var(--text);
  line-height: 1;
  letter-spacing: -0.01em;
}

/* Teachers chip row (open by default, compact) */
.teacher-section { padding: 10px 12px; }
.teachers-head { display: flex; align-items: baseline; gap: 8px; margin-bottom: 6px; flex-wrap: wrap; }
.teachers-head .section-title { font-size: 13px; font-weight: 700; color: var(--text); margin: 0; }
.teachers-head .section-subtext { font-size: 11px; color: var(--muted); }
.teachers-chip-row { display: flex; flex-wrap: wrap; gap: 6px; }
.teacher-chip {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 4px 10px 4px 4px;
  border: 1px solid var(--border);
  border-radius: 999px;
  background: #fff;
}
.teacher-chip.is-main {
  border-color: rgba(1, 83, 91, 0.28);
  background: rgba(1, 83, 91, 0.04);
}
.teacher-avatar {
  width: 22px;
  height: 22px;
  border-radius: 50%;
  background: linear-gradient(135deg, var(--primary), rgba(1,83,91,0.7));
  color: #fff;
  font-size: 10px;
  font-weight: 700;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.teacher-info { display: flex; flex-direction: column; line-height: 1.1; }
.teacher-info .teacher-name { font-size: 12px; font-weight: 600; color: var(--text); }
.teacher-info .teacher-role {
  font-size: 9px;
  font-weight: 700;
  color: var(--muted);
  text-transform: uppercase;
  letter-spacing: 0.06em;
}
.teacher-chip.is-main .teacher-info .teacher-role { color: var(--primary); }
.teacher-radio { margin-left: 2px; cursor: pointer; transform: scale(0.85); }

/* Collapsible Teachers section */
.teachers-mobile-toggle {
  display: flex;
  width: 100%;
  align-items: center;
  justify-content: space-between;
  gap: 8px;
  padding: 6px 4px;
  background: transparent;
  border: none;
  cursor: pointer;
  font: inherit;
  color: var(--text);
}
.teachers-mobile-toggle .section-title { font-size: 13px; font-weight: 700; margin: 0; }
.teachers-mobile-toggle .teachers-mobile-meta {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  color: var(--muted);
  font-size: 11px;
}
.teachers-mobile-toggle .teachers-mobile-chevron {
  transition: transform 0.18s ease;
  color: var(--muted);
}
.teachers-mobile-toggle[aria-expanded="true"] .teachers-mobile-chevron { transform: rotate(90deg); color: var(--primary); }
.teachers-head { display: none; }
.teachers-chip-row { margin-top: 6px; }
.teacher-section[data-collapsed="true"] .teachers-chip-row { display: none; }
@media (max-width: 768px) {
  .teacher-section { padding: 8px 10px; }
}

/* Two-column overview split for Students + Subjects */
.overview-split {
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
  gap: 8px;
}
@media (max-width: 980px) { .overview-split { grid-template-columns: 1fr; } }

.section-header-row {
  display: flex;
  align-items: center;
  gap: 8px;
  margin-bottom: 4px;
}
.section-sort-spacer { margin-left: auto; }
.section-count-pill {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 22px;
  padding: 1px 8px;
  border-radius: 999px;
  background: rgba(1, 83, 91, 0.10);
  color: var(--primary);
  font-size: 10px;
  font-weight: 700;
}
.section-sort-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 16px;
  height: 16px;
  padding: 0;
  border: none;
  border-radius: 0;
  background: transparent;
  color: var(--primary);
  cursor: pointer;
  opacity: 0.78;
}
.section-sort-btn:hover,
.section-sort-btn:focus,
.section-sort-btn:active,
.section-sort-btn:focus-visible {
  background: transparent !important;
  box-shadow: none !important;
  outline: none;
  color: var(--primary);
}
.section-sort-btn svg {
  width: 10px;
  height: 10px;
}

/* Students interactive rows */
.students-overview-section { padding: 8px 12px; }
.students-overview-section .section-title { font-size: 13px; font-weight: 700; color: var(--text); margin: 0; }
.students-numbered-list { list-style: none; counter-reset: none; padding: 0; margin: 0; display: grid; gap: 0; }
.students-numbered-list li {
  display: flex;
  align-items: center;
  gap: 4px;
  border-bottom: 1px solid var(--border);
  background: transparent !important;
}
.students-numbered-list li:last-child { border-bottom: none; }
.students-numbered-list li::before { content: none !important; }

.student-row {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 5px 6px;
  background: transparent;
  border: none;
  text-align: left;
  cursor: pointer;
  border-radius: 6px;
  line-height: 1.2;
  transition: background 0.15s ease, color 0.15s ease;
}
.student-row:hover { background: rgba(1, 83, 91, 0.04); }
.student-row:hover .student-name { color: var(--primary); }
.student-row:hover .student-arrow { color: var(--primary); transform: translateX(2px); }
.student-row.has-remark .student-name {
  color: var(--primary);
  font-weight: 600;
}
.student-index {
  flex: 0 0 20px;
  color: var(--muted);
  font-size: 11px;
  font-weight: 600;
  text-align: right;
}
.student-name {
  flex: 1;
  color: var(--text);
  font-size: 12.5px;
  font-weight: 500;
  transition: color 0.15s ease;
}
.student-arrow {
  color: #cbd5e1;
  font-size: 13px;
  line-height: 1;
  transition: color 0.15s ease, transform 0.15s ease;
}
.student-remark-btn {
  width: 26px;
  height: 26px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border: 1px solid transparent;
  border-radius: 7px;
  background: transparent;
  color: #94a3b8;
  cursor: pointer;
  flex-shrink: 0;
  transition: color 0.15s ease, background 0.15s ease, border-color 0.15s ease;
}
.student-remark-btn:hover,
.student-remark-btn:focus-visible {
  color: var(--primary);
  background: rgba(1, 83, 91, 0.08);
  border-color: rgba(1, 83, 91, 0.18);
  outline: none;
}
.student-remark-btn.has-remark {
  color: var(--primary);
}

/* Student remark modal */
.student-remark-modal-overlay {
  display: none;
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.42);
  z-index: 1200;
  align-items: flex-start;
  justify-content: center;
  padding: calc(env(safe-area-inset-top, 0px) + 86px) 12px 14px;
  overflow-y: auto;
  overscroll-behavior: contain;
}
.student-remark-modal-overlay.active { display: flex; }
.student-remark-modal-box {
  width: 100%;
  max-width: 560px;
  max-height: calc(100vh - (env(safe-area-inset-top, 0px) + 108px));
  background: #fff;
  border: 1px solid var(--border);
  border-radius: 12px;
  box-shadow: 0 18px 42px rgba(2, 8, 23, 0.2);
  overflow: hidden;
  display: flex;
  flex-direction: column;
}
.student-remark-modal-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
  padding: 10px 12px;
  border-bottom: 1px solid var(--border);
}
.student-remark-modal-title {
  margin: 0;
  font-size: 12.5px;
  font-weight: 700;
  color: var(--text);
}
.student-remark-modal-close {
  width: 26px;
  height: 26px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border: 1px solid var(--border);
  border-radius: 7px;
  background: #f8fafc;
  color: var(--muted);
  font-size: 16px;
  line-height: 1;
  cursor: pointer;
}
.student-remark-modal-body {
  display: grid;
  gap: 8px;
  padding: 10px 12px;
  overflow-y: auto;
  -webkit-overflow-scrolling: touch;
}
.student-remark-label {
  font-size: 10.5px;
  font-weight: 700;
  color: var(--muted);
}
.student-remark-input,
.student-remark-select {
  width: 100%;
  border: 1px solid var(--border);
  border-radius: 7px;
  padding: 6px 8px;
  font-size: 11.5px;
  color: var(--text);
  background: #fff;
}
.student-remark-input {
  min-height: 58px;
  line-height: 1.35;
  resize: vertical;
}
.student-remark-status {
  min-height: 14px;
  font-size: 11px;
  color: var(--muted);
}
.student-remark-status.error { color: #dc2626; }
.student-remark-status.success { color: #047857; }
.student-remark-modal-actions {
  display: flex;
  justify-content: flex-end;
  gap: 8px;
  padding: 0 12px 10px;
  flex-shrink: 0;
}

#studentRemarkEditorsContainer {
  display: grid;
  gap: 8px;
}

.student-remark-editor {
  border: 1px solid #d8e0e7;
  border-radius: 9px;
  padding: 7px;
  background: #f8fafc;
}

.student-remark-editor .student-remark-label {
  margin: 0;
}

.student-remark-editor-head {
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(170px, 1.2fr);
  gap: 8px;
  align-items: center;
  margin-bottom: 6px;
}

.student-remark-editor .student-remark-select {
  margin-bottom: 0;
  text-overflow: ellipsis;
}

@media (max-width: 768px) {
  .student-remark-modal-overlay {
    padding: calc(env(safe-area-inset-top, 0px) + 92px) 8px 10px;
  }

  .student-remark-modal-box {
    width: 100%;
    max-width: 100%;
    border-radius: 12px;
    max-height: calc(100vh - (env(safe-area-inset-top, 0px) + 112px));
  }

  .student-remark-modal-head {
    padding: 8px 10px;
  }

  .student-remark-modal-title {
    font-size: 13px;
    line-height: 1.3;
  }

  .student-remark-modal-body {
    padding: 8px 10px;
    gap: 7px;
  }

  .student-remark-editor {
    padding: 6px;
  }

  .student-remark-editor-head {
    grid-template-columns: minmax(0, 1fr) minmax(132px, 38vw);
    gap: 6px;
  }

  .student-remark-label {
    font-size: 10.5px;
  }

  .student-remark-input,
  .student-remark-select {
    font-size: 16px;
    line-height: 1.3;
    padding: 7px 8px;
  }

  .student-remark-select-picker {
    min-width: 132px;
    width: 100%;
    padding-left: 8px;
    padding-right: 24px;
    font-size: 16px;
    font-weight: 600;
    color: #475569;
    background-position: right 8px center;
  }

  .student-remark-select-picker option {
    color: var(--text);
  }

  .student-remark-input {
    min-height: 60px;
  }

  .student-remark-modal-actions {
    padding: 0 10px 10px;
  }
}

@media (max-width: 420px) {
  .student-remark-editor-head {
    grid-template-columns: minmax(0, 1fr) minmax(120px, 36vw);
  }

  .student-remark-select-picker {
    min-width: 120px;
  }
}

/* Subjects cards (overview) */
.subjects-overview-section { padding: 8px 12px; }
.subjects-overview-section .section-title { font-size: 13px; font-weight: 700; color: var(--text); margin: 0; }
.subjects-card-grid { display: grid; gap: 5px; }
.subject-card {
  width: 100%;
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 6px 10px;
  border: 1px solid var(--border);
  border-radius: 8px;
  background: #fff;
  cursor: pointer;
  text-align: left;
  transition: border-color 0.15s ease, box-shadow 0.15s ease, transform 0.15s ease;
}
.subject-card:hover {
  border-color: rgba(1, 83, 91, 0.28);
  box-shadow: 0 4px 10px rgba(15, 23, 42, 0.04);
  transform: translateY(-1px);
}
.subject-icon {
  width: 22px;
  height: 22px;
  border-radius: 6px;
  background: rgba(1, 83, 91, 0.10);
  color: var(--primary);
  display: inline-flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.subject-icon svg { width: 12px; height: 12px; }
.subject-text { display: flex; flex-direction: column; gap: 0; min-width: 0; flex: 1; line-height: 1.2; }
.subject-text strong { font-size: 12.5px; font-weight: 600; color: var(--text); }
.subject-text span { font-size: 10.5px; color: var(--muted); }
.subject-arrow { color: #cbd5e1; font-size: 14px; transition: color 0.15s ease, transform 0.15s ease; }
.subject-card:hover .subject-arrow { color: var(--primary); transform: translateX(2px); }

.workspace-header-row {
  display: flex;
  justify-content: space-between;
  gap: 20px;
  align-items: flex-start;
}

.workspace-header-line {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14px;
  min-height: 0;
  flex-wrap: nowrap;
}

.workspace-header-copy {
  display: flex;
  flex-direction: column;
  gap: 2px;
  min-width: 0;
}

.workspace-header-copy .eyebrow {
  font-size: 9px;
  font-weight: 700;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: var(--muted);
  line-height: 1;
}

.workspace-title-row {
  display: flex;
  align-items: center;
  gap: 8px;
}

.workspace-header-copy .page-title {
  margin: 0;
  font-size: 20px;
  font-weight: 700;
  color: var(--text);
  line-height: 1.1;
}

.workspace-cohort {
  font-size: 11px;
  font-weight: 500;
  color: var(--muted);
}

.workspace-divider {
  width: 1px;
  align-self: stretch;
  background: var(--border);
  margin: 4px 0;
}

.workspace-session-badge {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 6px 10px;
  border-radius: 999px;
  border: 1px solid rgba(1, 83, 91, 0.18);
  background: rgba(1, 83, 91, 0.08);
  color: var(--primary);
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 0.04em;
  text-transform: uppercase;
  white-space: nowrap;
}
.workspace-session-badge::before {
  content: "";
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: #22c55e;
  box-shadow: 0 0 0 3px rgba(34, 197, 94, 0.18);
}

.workspace-meta-inline {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 8px;
  flex-wrap: wrap;
  margin-left: auto;
}

.workspace-meta-pair {
  display: inline-flex;
  align-items: center;
  gap: 5px;
  padding: 5px 8px;
  border-radius: 999px;
  background: #f8fafc;
  border: 1px solid #e5e7eb;
  white-space: nowrap;
}

.workspace-meta-pair .meta-label {
  font-size: 9px;
  font-weight: 700;
  letter-spacing: 0.06em;
  text-transform: uppercase;
  color: var(--muted);
  margin: 0;
}

.workspace-meta-pair .meta-value {
  font-size: 12px;
  font-weight: 700;
  color: var(--text);
  margin: 0;
}

.workspace-meta-toggle {
  display: none;
}

.workspace-tabbar-shell {
  padding: 0;
  overflow: visible;
  position: sticky;
  top: 56px;
  z-index: 5;
  background: #fff;
  border-radius: 10px 10px 0 0;
}

.workspace-tabbar {
  display: flex;
  align-items: flex-end;
  gap: 2px;
  overflow-x: auto;
  padding: 0 8px;
  min-height: 32px;
  border-bottom: 1px solid var(--border);
  background: linear-gradient(180deg, #fcfdfd 0%, #f7faf9 100%);
  scrollbar-width: none;
}
.workspace-tabbar::-webkit-scrollbar { height: 0; }

.workspace-tab {
  display: inline-flex;
  align-items: center;
  gap: 2px;
  min-height: 26px;
  margin-bottom: -1px;
  padding: 0 2px 0 0;
  border: 1px solid transparent;
  border-bottom-color: transparent;
  border-radius: 7px 7px 0 0;
  background: transparent;
  color: #64748b;
  cursor: pointer;
  transition: background 0.15s ease, color 0.15s ease;
  white-space: nowrap;
  font: inherit;
}

.workspace-tab:hover {
  background: rgba(255, 255, 255, 0.7);
  color: var(--text);
}

.workspace-tab.is-active {
  background: #ffffff;
  color: var(--primary);
  border-color: var(--border);
  box-shadow: 0 -1px 0 rgba(255,255,255,0.9);
}

.workspace-tab-label {
  font-size: 11.5px;
  font-weight: 600;
}

.workspace-tab-activate {
  border: none;
  background: transparent;
  color: inherit;
  padding: 0 8px;
  min-height: 24px;
  font: inherit;
  cursor: pointer;
  display: inline-flex;
  align-items: center;
}

.workspace-tab-close {
  width: 16px;
  height: 16px;
  border-radius: 999px;
  border: none;
  background: transparent;
  color: #94a3b8;
  cursor: pointer;
  font-size: 12px;
  line-height: 1;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  margin-right: 4px;
  transition: background 0.15s ease, color 0.15s ease;
}
.workspace-tab-close:hover {
  background: rgba(15, 23, 42, 0.08);
  color: var(--text);
}

.workspace-tab:not(.is-active) .workspace-tab-close {
  background: transparent;
  color: #94a3b8;
}

.workspace-tab.is-active .workspace-tab-close {
  background: transparent;
  color: var(--primary);
}

.workspace-tab-add {
  flex: 0 0 auto;
  width: 20px;
  height: 20px;
  margin: 0 0 4px 4px;
  border-radius: 6px;
  border: 1px dashed #cbd5e1;
  background: transparent;
  color: var(--muted);
  font-size: 13px;
  line-height: 1;
  cursor: pointer;
  transition: all 0.15s ease;
}

.workspace-tab-add:hover {
