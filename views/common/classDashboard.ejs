      // "Assess other school year": the ⋮ menu turns Year and Term into pickers.
      // A picked term is kept for this person only, for 20 minutes; then the
      // class goes back to the school's current term.
      (function initClassroomTermView() {
        var card = document.querySelector('.workspace-header-card');
        var menuBtn = document.getElementById('termViewMenuBtn');
        var menu = document.getElementById('termViewMenu');
        var yearSelect = document.getElementById('termViewYear');
        var termSelect = document.getElementById('termViewTerm');
        var optionsEl = document.getElementById('termViewOptions');
        if (!card || !menuBtn || !menu || !yearSelect || !termSelect || !optionsEl) return;
        var years = [];
        try { years = JSON.parse(optionsEl.textContent) || []; } catch (e) { years = []; }
        var viewing = card.classList.contains('is-term-viewing');
        var toggle = menu.querySelector('[data-term-view-toggle]');
        var escapeText = function (value) {
          return String(value).replace(/[&<>"']/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]; });
        };

        function setMenu(open) {
          menu.hidden = !open;
          menuBtn.setAttribute('aria-expanded', String(open));
        }
        function setPicking(on) {
          card.classList.toggle('is-term-picking', on);
          if (toggle) toggle.setAttribute('aria-checked', String(on));
          if (on) {
            card.setAttribute('data-meta-collapsed', 'false');
            var metaToggle = card.querySelector('.workspace-meta-toggle');
            if (metaToggle) metaToggle.setAttribute('aria-expanded', 'true');
          }
        }
        // Reload the class (same open tab) so everything follows the term.
        function reloadClass() {
          var url = new URL(window.location.href);
          url.searchParams.delete('termId');
          window.location.replace(url.pathname + url.search + url.hash);
        }
        function post(body, keepPage) {
          yearSelect.disabled = true;
          termSelect.disabled = true;
          return fetch('/common/classroomTermView', {
            method: 'POST',
            credentials: 'same-origin',
            headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
            body: JSON.stringify(body)
          }).then(function (r) { return r.json(); }).then(function (data) {
            if (!data || !data.success) throw new Error((data && data.message) || 'Could not switch the term.');
            if (!keepPage) { reloadClass(); return data; }
            yearSelect.disabled = false;
            termSelect.disabled = false;
            return data;
          }).catch(function (err) {
            yearSelect.disabled = false;
            termSelect.disabled = false;
            alert(err.message || 'Could not switch the term. Please try again.');
          });
        }
        function fillTerms(yearId) {
          var year = years.find(function (y) { return String(y.id) === String(yearId); });
          var terms = year ? year.terms : [];
          termSelect.innerHTML = terms.map(function (t) {
            var note = t.current ? ' (current)' : t.scores ? ' · ' + t.scores + ' scores' : t.students ? ' · ' + t.students + ' students' : ' · no students';
            return '<option value="' + Number(t.id) + '">' + escapeText(t.name + note) + '</option>';
          }).join('');
          // The current term, else the first term with scores, else with students, else the first.
          var pick = terms.find(function (t) { return t.current; }) ||
            terms.find(function (t) { return t.scores > 0; }) ||
            terms.find(function (t) { return t.students > 0; }) || terms[0];
          if (pick) termSelect.value = String(pick.id);
          return pick;
        }

        menuBtn.onclick = function (e) { e.stopPropagation(); setMenu(menu.hidden); };
        if (toggle) {
          toggle.onclick = function () {
            setMenu(false);
            if (viewing) { post({ reset: true }); return; }
            var on = !card.classList.contains('is-term-picking');
            setPicking(on);
            if (on) yearSelect.focus();
          };
        }
        card.querySelectorAll('[data-term-view-reset]').forEach(function (btn) {
          btn.onclick = function () { setMenu(false); post({ reset: true }); };
        });
        yearSelect.onchange = function () {
          var pick = fillTerms(yearSelect.value);
          if (pick) post({ termId: pick.id });
        };
        termSelect.onchange = function () { post({ termId: Number(termSelect.value) }); };

        if (!window.__termViewDocListeners) {
          window.__termViewDocListeners = true;
          var closeMenu = function (focusButton) {
            var m = document.getElementById('termViewMenu');
            var b = document.getElementById('termViewMenuBtn');
            if (!m || m.hidden) return;
            m.hidden = true;
            if (b) { b.setAttribute('aria-expanded', 'false'); if (focusButton) b.focus(); }
          };
          document.addEventListener('click', function (e) {
            if (!e.target.closest || !e.target.closest('.term-view-menu')) closeMenu(false);
          });
          document.addEventListener('keydown', function (e) { if (e.key === 'Escape') closeMenu(true); });
        }

        // Countdown back to the current term; in the last 2 minutes it can be
        // kept 20 more minutes so nothing being typed is lost.
        if (window.__termViewTimer) { clearInterval(window.__termViewTimer); window.__termViewTimer = null; }
        var countdown = card.querySelector('[data-term-view-countdown]');
        if (!viewing || !countdown) return;
        var endsAt = Date.now() + Number(countdown.getAttribute('data-remaining-ms') || 0);
        var banner = document.getElementById('termViewBanner');
        var keepBtn = null;
        var tick = function () {
          if (!countdown.isConnected) { clearInterval(window.__termViewTimer); window.__termViewTimer = null; return; }
          var left = Math.max(0, endsAt - Date.now());
          var mins = Math.floor(left / 60000);
          var secs = Math.floor((left % 60000) / 1000);
          countdown.textContent = mins + ':' + (secs < 10 ? '0' : '') + secs;
          if (left <= 120000 && left > 0 && !keepBtn && banner) {
            keepBtn = document.createElement('button');
            keepBtn.type = 'button';
            keepBtn.className = 'term-view-banner__btn';
            keepBtn.textContent = 'Keep 20 more minutes';
            keepBtn.onclick = function () {
              post({ termId: Number(termSelect.value) }, true).then(function (data) {
                if (!data || !data.remainingMs) return;
                endsAt = Date.now() + Number(data.remainingMs);
                keepBtn.remove();
                keepBtn = null;
                tick();
              });
            };
            banner.insertBefore(keepBtn, banner.querySelector('[data-term-view-reset]'));
          }
          if (left <= 0) {
            clearInterval(window.__termViewTimer);
            window.__termViewTimer = null;
            countdown.textContent = '0:00';
            post({ reset: true });
          }
        };
        tick();
        window.__termViewTimer = setInterval(tick, 1000);
      })();

      var classRouteLiveMarkers = {};
      function startClassRouteLivePolling(routeId, layerGroup, L) {
        if (!Number.isInteger(routeId) || routeId <= 0) return;
        classLiveRoutes.push(function (payload) {
            var live = payload && payload.success ? (payload.data[routeId] || null) : null;
            var marker = classRouteLiveMarkers[routeId];
            // Trip over, or no signal for 2 minutes (driver offline): the bus leaves the map.
            if (!live || live.latitude === null || live.latitude === undefined || window.ManagiraMaps.isOffline(live.recorded_at)) {
              if (marker) { layerGroup.removeLayer(marker); delete classRouteLiveMarkers[routeId]; }
              return;
            }
            var stale = live.recorded_at && (Date.now() - new Date(live.recorded_at).getTime()) > 2 * 60 * 1000;
            var icon = window.ManagiraMaps.busIcon({ heading: live.heading_deg, label: live.bus_number || 'Bus', photo: live.driver_photo_url, stale: stale || live.estimated });
            var popupText = window.ManagiraMaps.driverCard(live);
            if (!marker) {
              marker = L.marker([live.latitude, live.longitude], { icon: icon, title: 'Bus ' + (live.bus_number || ''), zIndexOffset: 1000 }).bindPopup(popupText);
              marker.addTo(layerGroup);
              classRouteLiveMarkers[routeId] = marker;
            } else {
              // Glide to the new position.
              var from = marker.getLatLng(), to = [Number(live.latitude), Number(live.longitude)], t0 = performance.now();
              cancelAnimationFrame(marker._glide);
              var step = function (now) {
                var k = Math.min(1, (now - t0) / 1200), e = k * (2 - k);
                marker.setLatLng([from.lat + (to[0] - from.lat) * e, from.lng + (to[1] - from.lng) * e]);
                if (k < 1) marker._glide = requestAnimationFrame(step);
              };
              marker._glide = requestAnimationFrame(step);
              marker.setIcon(icon);
              marker.setPopupContent(popupText);
            }
        });
        startClassLiveTimer(layerGroup);
      }
      // One request for every route on the class map, and only while it can be seen.
      var classLiveRoutes = [];
      var classLiveTimer = 0;
      function startClassLiveTimer() {
        if (classLiveTimer) return;
        var tick = function () {
          var map = document.getElementById('classDashboardTransportMap');
          if (document.hidden || !map || !map.offsetWidth) return;
          fetch('/transportation/live/routes', {
            headers: { 'Accept': 'application/json', 'X-Requested-With': 'XMLHttpRequest' }
          }).then(function (r) { return r.json(); }).then(function (payload) {
            classLiveRoutes.forEach(function (update) { update(payload); });
          }).catch(function () {});
        };
        classLiveTimer = window.setInterval(tick, 3000);
        setTimeout(tick, 200);
      }

      <% if (transportActive && classTransportationMapRows.length) { %>
      // The map tools load only when the Transportation tab is opened, not with every class page.
      (function whenClassMapShown(draw) {
        var mapBox = document.getElementById('classDashboardTransportMap');
        if (!mapBox || !window.IntersectionObserver) { draw(); return; }
        var seen = new IntersectionObserver(function (entries) {
          if (!entries[0].isIntersecting) return;
          seen.disconnect();
          draw();
        });
        seen.observe(mapBox);
      })(function () {
      renderTransportMap('classDashboardTransportMap', {
        school: <%- JSON.stringify(classTransportationSchoolDestination || { address: null, latitude: null, longitude: null }) %>,
        stop: null,
        live: null,
        homeAddress: null,
        homeLatitude: null,
        homeLongitude: null,
      }, true).then(function() {
        ensureLeafletAssets().then(function(L) {
          var map = studentTransportState.classMap;
          var layerGroup = studentTransportState.classLayers;
          if (!map || !layerGroup) return;
          var rows = <%- JSON.stringify(classTransportationMapRows || []) %>;
          var school = <%- JSON.stringify(classTransportationSchoolDestination || { address: null, latitude: null, longitude: null }) %>;
          var routeColors = {};
          try {
            JSON.parse(document.getElementById('classDashboardTransportMap').getAttribute('data-routes') || '[]')
              .forEach(function(r) { routeColors[r.id] = r.color; });
          } catch (_) { /* default colour */ }
          var schoolLat = school ? normalizeCoord(school.latitude, 'lat') : null;
          var schoolLng = school ? normalizeCoord(school.longitude, 'lng') : null;
          var rowsByRoute = {};
          rows.forEach(function(row) {
            var routeId = Number(row.routeId || 0);
            if (!Number.isInteger(routeId) || routeId <= 0) return;
            if (!rowsByRoute[routeId]) rowsByRoute[routeId] = [];
            rowsByRoute[routeId].push(row);
          });
          var boundsSource = [];
          var classRouteShapes = {};
          // Route chips on the map: show one route (others fade) or all of them.
          document.querySelectorAll('[data-tp-route]').forEach(function (chip) {
            chip.addEventListener('click', function () {
              var id = chip.getAttribute('data-tp-route');
              document.querySelectorAll('[data-tp-route]').forEach(function (c) { c.classList.toggle('is-on', c === chip); });
              Object.keys(classRouteShapes).forEach(function (key) {
                classRouteShapes[key].group.eachLayer(function (line) { line.setStyle({ opacity: !id || key === id ? 1 : 0.15 }); });
              });
              var shape = id && classRouteShapes[id];
              if (shape) map.fitBounds(shape.bounds.pad(0.12));
              else if (boundsSource.length) map.fitBounds(L.latLngBounds(boundsSource).pad(0.15));
            });
          });
          var routePromises = Object.keys(rowsByRoute).map(function(routeIdKey) {
            var routeRows = rowsByRoute[routeIdKey] || [];
            var firstRow = routeRows[0] || null;
            var routeStops = firstRow && Array.isArray(firstRow.routeStops)
              ? firstRow.routeStops.filter(function(stop) {
                  return normalizeCoord(stop && stop.latitude, 'lat') !== null && normalizeCoord(stop && stop.longitude, 'lng') !== null;
                }).map(function(stop) {
                  return [normalizeCoord(stop.latitude, 'lat'), normalizeCoord(stop.longitude, 'lng')];
                })
              : [];
            var routeLatLngs = [];
            if (schoolLat !== null && schoolLng !== null) routeLatLngs.push([schoolLat, schoolLng]);
            routeStops.forEach(function(latlng) { routeLatLngs.push(latlng); });
            if (schoolLat !== null && schoolLng !== null && routeStops.length) routeLatLngs.push([schoolLat, schoolLng]);

            routeRows.forEach(function(row) {
              var stopLat = normalizeCoord(row.stopLatitude, 'lat');
              var stopLng = normalizeCoord(row.stopLongitude, 'lng');
              if (stopLat === null || stopLng === null) return;
              boundsSource.push([stopLat, stopLng]);
              var stopColor = routeColors[Number(routeIdKey)] || '#2563eb';
              L.marker([stopLat, stopLng], { icon: window.ManagiraMaps.stopPin(stopColor), zIndexOffset: 200 })
                .bindPopup((row.studentName || 'Student') + '<br/>' + (row.stopName || 'Stop') + '<br/>Driver: ' + (row.driverName || '-'))
                .addTo(layerGroup);
            });

            return fetchRoadGeometry(routeLatLngs).catch(function () { return []; }).then(function(roadLatLngs) {
              (roadLatLngs.length ? roadLatLngs : routeLatLngs).forEach(function(latlng) { boundsSource.push(latlng); });
              var drawn = roadLatLngs.length >= 2 ? roadLatLngs : routeLatLngs;
              if (drawn.length >= 2) {
                var routeGroup = L.layerGroup().addTo(layerGroup);
                window.ManagiraMaps.drawRoute(routeGroup, drawn, { color: routeColors[Number(routeIdKey)] || '#0f5a66', weight: 5 });
                classRouteShapes[routeIdKey] = { group: routeGroup, bounds: L.latLngBounds(drawn) };
              }
              startClassRouteLivePolling(Number(routeIdKey), layerGroup, L);
              fit();
            });
          });
          if (schoolLat !== null && schoolLng !== null) boundsSource.push([schoolLat, schoolLng]);
          // Fit to everything drawn so far; the map may be drawn while its panel is hidden.
          var userMoved = false;
          map.on('dragstart zoomstart', function () { if (!fitting) userMoved = true; });
          var fitting = false;
          function fit() {
            var el = document.getElementById('classDashboardTransportMap');
            if (!el || !el.offsetWidth || !boundsSource.length || userMoved) return;
            fitting = true;
            map.invalidateSize();
            if (!map.getSize().x) { fitting = false; return; }
            var bounds = L.latLngBounds(boundsSource).pad(0.12);
            // A fit tried while the tab was hidden leaves no zoom level; start again from the middle.
            if (!isFinite(map.getZoom())) map.setView(bounds.getCenter(), 12, { animate: false });
            map.fitBounds(bounds);
            setTimeout(function () { fitting = false; }, 400);
          }
          fit();
          var mapEl = document.getElementById('classDashboardTransportMap');
          if (mapEl && window.ResizeObserver) {
            var lastWidth = mapEl.offsetWidth;
            new ResizeObserver(function() {
              if (mapEl.offsetWidth && mapEl.offsetWidth !== lastWidth) { lastWidth = mapEl.offsetWidth; map.invalidateSize(); fit(); }
            }).observe(mapEl);
          }
          Promise.all(routePromises).then(fit);
        });
      });
      });
