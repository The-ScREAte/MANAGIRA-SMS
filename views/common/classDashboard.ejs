<%
  const themeColor = (typeof session !== 'undefined' && session && session.themeColor) ? session.themeColor : 'teal';
  const themeColors = {
    teal: { primary: '#01535b', hover: '#014a51' },
    blue: { primary: '#2563eb', hover: '#1d4ed8' },
    green: { primary: '#2d5f4f', hover: '#245043' },
    purple: { primary: '#7c3aed', hover: '#6d28d9' },
    indigo: { primary: '#4f46e5', hover: '#4338ca' },
    rose: { primary: '#8b2635', hover: '#7a212e' },
    amber: { primary: '#d97706', hover: '#b45309' },
    slate: { primary: '#334155', hover: '#1e293b' }
  };
  const currentTheme = themeColors[themeColor] || themeColors.teal;
  const workspaceStudents = (students || []).map((student) => ({
    id: student.student_id,
    name: `${student.first_name} ${student.last_name}`,
    firstName: student.first_name,
    lastName: student.last_name,
  }));
  const workspaceSubjects = (subjects || []).map((subject) => ({
    id: subject.subject_id,
    name: subject.subject_name,
  }));
%>
<style>
:root {
  --border: #e5e7eb;
  --muted: #6b7280;
  --bg: #f9fafb;
  --primary: <%= currentTheme.primary %>;
  --primary-hover: <%= currentTheme.hover %>;
        --primary-hover-fill: color-mix(in srgb, var(--primary) 88%, white);
  --text: #111827;
  --font-family: "<%= (session && session.fontStyle ? String(session.fontStyle).trim() : 'Inter') %>", sans-serif;
}

body {
  background: var(--bg);
  font-family: var(--font-family);
  min-height: 100vh;
  display: flex;
  flex-direction: column;
}

html, body {
  width: 100%;
  max-width: 100%;
  overflow-x: hidden;
}

html body main,
main {
  flex: 1 0 auto;
  width: 100% !important;
  max-width: none !important;
  margin: 0 !important;
  padding: 0 !important;
  zoom: 1 !important;
  box-sizing: border-box;
}

/* Neutralize any centered parent containers from the shared layout for this page */
.container,
.container-md,
.container-lg,
.container-xl,
.page-wrapper,
.layout-shell,
.app-body,
.content,
#app-scale-root {
  max-width: none !important;
  width: 100% !important;
  margin: 0 !important;
}

.dashboard-shell {
  max-width: 1200px;
  margin: 0 auto;
  padding: 20px 16px 40px;
  width: 100%;
  flex: 1 0 auto;
}

.dashboard-grid {
  display: grid;
  grid-template-columns: 260px 1fr;
  gap: 24px;
  align-items: start;
}

.card {
  background: #fff;
  border: 1px solid var(--border);
  border-radius: 12px;
  box-shadow: 0 8px 24px rgba(15, 23, 42, 0.04);
}

.card-header {
  padding: 16px;
  border-bottom: 1px solid var(--border);
}

.card-body {
  padding: 16px;
}

.dashboard-main {
  background: transparent;
  border: none;
  box-shadow: none;
}

.dashboard-header {
  padding: 8px 4px 12px;
}

.dashboard-content {
  padding: 0;
}

.page-title {
  margin: 0;
  font-size: 28px;
  font-weight: 700;
  color: var(--text);
}

.card-title {
  margin: 0;
  font-size: 18px;
  font-weight: 700;
  color: var(--text);
}

.card-subtext {
  margin: 4px 0 0;
  color: var(--muted);
  font-size: 13px;
}

.eyebrow {
  margin: 0;
  text-transform: uppercase;
  letter-spacing: 0.06em;
  color: var(--muted);
  font-size: 11px;
  font-weight: 600;
}

.nav-card {
  padding: 14px 12px 16px;
  position: sticky;
  top: 80px;
  border-radius: 14px;
  border: 1px solid var(--border);
  box-shadow: 0 10px 26px rgba(15, 23, 42, 0.08);
}


.nav-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 4px 8px;
  margin: 4px 4px 10px;
  border-bottom: 1px solid var(--border);
}

.nav-header h3 {
  margin: 4px 0 0;
  font-size: 18px;
  color: var(--primary);
  font-weight: 700;
}

.nav-close {
  display: none;
  background: transparent;
  border: none;
  font-size: 22px;
  cursor: pointer;
  padding: 0;
  color: #6b7280;
  line-height: 1;
}

.side-nav {
  padding: 6px 8px 10px;
  text-align: left;
}

.nav-list {
  list-style: none;
  padding: 0;
  margin: 0;
  display: grid;
  gap: 2px;
  justify-items: stretch;
}

.nav-section-label {
  margin: 8px 6px 2px;
  color: var(--muted);
  font-size: 10px;
  font-weight: 700;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  text-align: left;
}

.nav-link {
  position: relative;
  width: 100%;
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 5px 10px 5px 12px;
  border-radius: 8px;
  color: #475569;
  text-decoration: none;
  border: 1px solid transparent;
  background: transparent;
  cursor: pointer;
  font: inherit;
  font-weight: 500;
  font-size: 13px;
  text-align: left;
  transition: background 0.15s ease, color 0.15s ease;
}
.nav-link .nav-icon {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 18px;
  height: 18px;
  color: #94a3b8;
  flex-shrink: 0;
}
.nav-link .nav-icon svg {
  width: 16px;
  height: 16px;
  display: block;
}
.nav-link .nav-link-label { flex: 1; }

.files-link-inline {
  display: inline-flex;
  align-items: center;
  gap: 8px;
}

.files-badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 20px;
  height: 20px;
  padding: 0 7px;
  border-radius: 999px;
  font-size: 11px;
  font-weight: 700;
  color: #fff;
  background: var(--org-primary-color);
}

.nav-link:hover {
  background: rgba(1, 83, 91, 0.06);
  color: var(--primary);
}
.nav-link:hover .nav-icon { color: var(--primary); }

.nav-link.active {
  background: rgba(1, 83, 91, 0.10);
  border-color: transparent;
  color: var(--primary);
  font-weight: 600;
}
.nav-link.active::before {
  content: "";
  position: absolute;
  left: 0;
  top: 6px;
  bottom: 6px;
  width: 3px;
  border-radius: 0 3px 3px 0;
  background: var(--primary);
}
.nav-link.active .nav-icon { color: var(--primary); }

.nav-toggle {
  display: none;
  align-items: center;
  gap: 8px;
  padding: 10px 12px;
  border-radius: 10px;
  border: 1px solid var(--border);
  background: #fff;
  cursor: pointer;
  font: inherit;
  margin-bottom: 12px;
}

.hamburger-icon {
  position: relative;
  width: 16px;
  height: 2px;
  background: #111827;
  display: inline-block;
}

.hamburger-icon::before,
.hamburger-icon::after {
  content: "";
  position: absolute;
  left: 0;
  width: 16px;
  height: 2px;
  background: #111827;
}

.hamburger-icon::before { top: -5px; }
.hamburger-icon::after { top: 5px; }

.nav-overlay {
  position: fixed;
  inset: 0;
  background: rgba(17, 24, 39, 0.35);
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.2s ease;
  z-index: 998;
}

.nav-overlay.show {
  opacity: 1;
  pointer-events: auto;
}

.meta-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
  gap: 12px;
}

.meta-tile {
  padding: 12px;
  border: 1px solid var(--border);
  border-radius: 10px;
  background: #f9fafb;
}

.meta-label { color: var(--muted); font-size: 12px; margin: 0 0 4px; }
.meta-value { margin: 0; font-weight: 600; color: var(--text); }

.section-card {
  border: 1px solid var(--border);
  border-radius: 12px;
  padding: 10px 12px;
  margin-top: 10px;
  background: #fff;
  box-shadow: 0 2px 8px rgba(15, 23, 42, 0.03);
}

.dashboard-content > .section-card:first-child {
  margin-top: 0;
}

.section-title {
  margin: 0 0 6px;
  font-weight: 600;
  color: var(--text);
}

.section-toggle {
  width: 100%;
  border: none;
  background: transparent;
  padding: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  cursor: pointer;
  text-align: left;
}

.section-toggle:hover,
.section-toggle:active,
.section-toggle:focus,
.section-toggle:focus-visible {
  background: transparent !important;
  color: inherit;
  box-shadow: none;
}

.section-toggle .section-title {
  margin: 0;
}

.section-toggle-icon {
  color: var(--muted);
  font-size: 24px;
  line-height: 1;
  transition: transform 0.2s ease, color 0.2s ease;
}

.teacher-section.open .section-toggle-icon,
.class-info-section.open .section-toggle-icon {
  transform: rotate(90deg);
  color: var(--text);
}

.section-collapse {
  padding-top: 10px;
}

.class-info-toggle {
  display: none;
}

.class-info-section .section-collapse {
  padding-top: 0;
}

.section-subtext {
  margin: 0 0 10px;
  color: var(--muted);
  font-size: 13px;
}

.teacher-list {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
  gap: 10px;
}

.teacher-card {
  border: 1px solid var(--border);
  border-radius: 10px;
  padding: 10px 12px;
  display: flex;
  align-items: center;
  gap: 10px;
  background: #fff;
}

.teacher-dot {
  width: 10px;
  height: 10px;
  border-radius: 50%;
  background: var(--primary);
}

.teacher-name {
  font-weight: 600;
  color: var(--text);
}

.student-list {
  list-style: none;
  padding: 0;
  margin: 0;
  display: flex;
  flex-direction: column;
  gap: 0;
}

.student-list li {
  border-bottom: 1px solid var(--border);
}

.student-list li:last-child {
  border-bottom: none;
}

.student-row {
  display: flex;
  align-items: center;
  gap: 6px;
  padding: 6px 2px;
}

.student-index {
  color: var(--muted);
  font-size: 12px;
  font-weight: 600;
  min-width: 24px;
}

.student-link {
  color: var(--primary);
  text-decoration: none;
  font-weight: 600;
}

.student-link:hover { color: var(--primary-hover); }

.students-section {
  padding: 10px 12px;
}

.students-section .section-title {
  margin: 0 0 2px;
}

.students-section .student-list {
  margin: 0;
}

.students-section .student-list li {
  margin: 0;
  padding: 0;
}

.students-section .student-row {
  gap: 4px;
  padding: 4px 0;
}

.students-section .student-index {
  min-width: 18px;
}

@media (max-width: 960px) {
  .dashboard-grid { grid-template-columns: 1fr; }
  .nav-toggle {
    display: inline-flex;
    position: sticky;
    top: 8px;
    z-index: 900;
  }
  .nav-card {
    position: fixed;
    top: 72px;
    left: 0;
    width: 300px;
    max-width: 85vw;
    height: auto;
    max-height: calc(100vh - 120px);
    padding: 26px 20px 20px;
    border-radius: 0 14px 14px 0;
    overflow-y: auto;
    transform: translateX(-110%);
    transition: transform 0.25s ease;
    z-index: 999;
    box-shadow: 0 10px 26px rgba(15, 23, 42, 0.08);
  }
  .nav-header {
    position: relative;
    padding: 0 0 12px;
    margin: 0 0 14px;
    border-bottom: 1px solid var(--border);
  }
  .nav-close {
    display: inline-flex;
    position: absolute;
    top: -2px;
    right: 0;
    width: 28px;
    height: 28px;
    padding: 0;
    line-height: 1;
  }
  .side-nav { padding: 0; }
  .nav-list { gap: 4px; }
  .class-info-toggle { display: flex; }
  .class-info-section .section-collapse { padding-top: 10px; }
  .nav-card.open { transform: translateX(0); }
  .nav-close { display: inline-flex; }
  .dashboard-shell { padding-top: 12px; }
}

@media (max-width: 768px) {
  body {
    padding-bottom: 0 !important;
  }
}

/* Report panel - list cards */
.rp-card {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 7px 10px;
  border: 1px solid var(--border);
  border-radius: 8px;
  margin-bottom: 6px;
  cursor: pointer;
  text-decoration: none;
  color: inherit;
  background: #fff;
  transition: border-color 0.2s, box-shadow 0.2s;
  gap: 10px;
}
.rp-card:hover {
  border-color: var(--primary);
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.06);
}
.rp-left { flex: 1; min-width: 0; }
.rp-subject {
  font-weight: 600;
  font-size: 12.5px;
  color: var(--text);
  margin: 0 0 2px;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.rp-meta {
  font-size: 11px;
  color: var(--muted);
  display: flex;
  gap: 5px;
  flex-wrap: wrap;
  align-items: center;
}
.rp-meta span { display: inline-flex; align-items: center; gap: 3px; }
.rp-meta .rp-dot { width: 3px; height: 3px; border-radius: 50%; background: #cbd5e1; flex-shrink: 0; }
.rp-right { display: flex; align-items: center; gap: 8px; flex-shrink: 0; }
.rp-status {
  padding: 2px 8px;
  border-radius: 20px;
  font-size: 10px;
  font-weight: 600;
  text-transform: capitalize;
  white-space: nowrap;
  letter-spacing: 0.02em;
}
.rp-status-open { background: #fef3c7; color: #b45309; }
.rp-status-in_progress { background: #dbeafe; color: #1d4ed8; }
.rp-status-resolved { background: #d1fae5; color: #047857; }
.rp-status-closed { background: #f3f4f6; color: #6b7280; }
.rp-status-pending { background: #fef3c7; color: #b45309; }
.rp-replies {
  font-size: 11px;
  color: var(--muted);
  white-space: nowrap;
  display: inline-flex;
  align-items: center;
  gap: 4px;
}
.rp-empty {
  text-align: center;
  padding: 18px 12px;
  color: var(--muted);
  font-size: 12.5px;
}
.rp-panel-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 14px;
  padding-bottom: 10px;
  border-bottom: 1px solid var(--border);
}
.rp-panel-title {
  font-size: 16px;
  font-weight: 700;
  color: var(--text);
  margin: 0;
  display: flex;
  align-items: center;
  gap: 8px;
}
.rp-panel-close {
  background: none;
  border: 1px solid var(--border);
  border-radius: 8px;
  width: 32px;
  height: 32px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 18px;
  cursor: pointer;
  color: var(--muted);
  transition: all 0.15s;
}
.rp-panel-close:hover {
  background: #f3f4f6;
  color: var(--text);
  border-color: #d1d5db;
}

/* Report detail modal */
.report-modal-overlay {
  display: none;
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 1100;
  justify-content: center;
  align-items: flex-start;
  padding: 108px 16px 32px;
  overflow-y: auto;
  backdrop-filter: blur(2px);
}
.report-modal-overlay.active { display: flex; }
.report-modal-box {
  background: #fff;
  border-radius: 14px;
  width: 100%;
  max-width: 640px;
  padding: 0;
  box-shadow: 0 20px 60px rgba(0, 0, 0, 0.2), 0 0 0 1px rgba(0, 0, 0, 0.05);
  position: relative;
  max-height: calc(100vh - 152px);
  overflow-y: auto;
  animation: modalSlideIn 0.2s ease-out;
}
@keyframes modalSlideIn {
  from { opacity: 0; transform: translateY(-12px); }
  to { opacity: 1; transform: translateY(0); }
}
.report-modal-close {
  position: sticky;
  top: 0;
  float: right;
  margin: 14px 14px 0 0;
  background: #f3f4f6;
  border: 1px solid var(--border);
  border-radius: 8px;
  width: 32px;
  height: 32px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 18px;
  cursor: pointer;
  color: var(--muted);
  line-height: 1;
  z-index: 2;
  transition: all 0.15s;
}
.report-modal-close:hover {
  background: #e5e7eb;
  color: var(--text);
}

/* Report detail content */
.rd-modal-body { padding: 20px 24px 24px; }
.rd-title {
  font-size: 18px;
  font-weight: 700;
  color: var(--text);
  margin: 0 0 14px;
  line-height: 1.35;
}
.rd-info-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
  gap: 10px;
  margin-bottom: 16px;
  padding: 14px;
  background: #f9fafb;
  border: 1px solid var(--border);
  border-radius: 10px;
}
.rd-info-label {
  font-size: 11px;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.04em;
  color: var(--muted);
  margin: 0 0 2px;
}
.rd-info-value {
  font-size: 13px;
  font-weight: 600;
  color: var(--text);
  margin: 0;
}
.rd-badge {
  display: inline-block;
  padding: 3px 10px;
  border-radius: 20px;
  font-size: 11px;
  font-weight: 600;
  text-transform: capitalize;
  letter-spacing: 0.02em;
}
.rd-priority-urgent { background: #fef2f2; color: #dc2626; }
.rd-priority-high { background: #fff7ed; color: #c2410c; }
.rd-priority-normal { background: #eff6ff; color: #2563eb; }
.rd-priority-low { background: #f9fafb; color: #6b7280; }

.rd-message {
  background: #f8fafc;
  border: 1px solid #e2e8f0;
  padding: 14px 16px;
  border-radius: 10px;
  margin-bottom: 16px;
  font-size: 14px;
  line-height: 1.65;
  color: #334155;
  white-space: pre-wrap;
  word-wrap: break-word;
}

.rd-section {
  margin-bottom: 16px;
}
.rd-section-title {
  font-size: 13px;
  font-weight: 700;
  color: var(--text);
  margin: 0 0 10px;
  text-transform: uppercase;
  letter-spacing: 0.04em;
  display: flex;
  align-items: center;
  gap: 6px;
}
.rd-section-title::after {
  content: '';
  flex: 1;
  height: 1px;
  background: var(--border);
}
.rd-recipients {
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
}
.rd-tag {
  background: #f0f9ff;
  border: 1px solid #bae6fd;
  color: #0369a1;
  padding: 4px 10px;
  border-radius: 20px;
  font-size: 12px;
  font-weight: 500;
}

/* Conversation thread */
.rd-reply {
  padding: 12px 14px;
  border-radius: 10px;
  margin-bottom: 8px;
  border: 1px solid var(--border);
  background: #fff;
}
.rd-reply:last-child { margin-bottom: 0; }
.rd-reply.is-guardian {
  background: #f0fdf4;
  border-color: #bbf7d0;
}
.rd-reply.is-staff {
  background: #eff6ff;
  border-color: #bfdbfe;
}
.rd-reply-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 6px;
}
.rd-reply-sender {
  font-weight: 600;
  font-size: 13px;
  display: flex;
  align-items: center;
  gap: 6px;
}
.rd-reply-sender .sender-dot {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  flex-shrink: 0;
}
.rd-reply-sender .sender-dot.guardian { background: #10b981; }
.rd-reply-sender .sender-dot.staff { background: #3b82f6; }
.rd-reply-sender .sender-name { color: var(--text); }
.rd-reply-sender .sender-label {
  font-size: 11px;
  font-weight: 500;
  color: var(--muted);
}
.rd-reply-date {
  font-size: 11px;
  color: #94a3b8;
  white-space: nowrap;
}
.rd-reply-msg {
  font-size: 13px;
  color: #475569;
  line-height: 1.6;
  margin: 0;
  white-space: pre-wrap;
  word-wrap: break-word;
}
.rd-no-replies {
  text-align: center;
  padding: 20px 12px;
  color: #94a3b8;
  font-size: 13px;
  border: 1px dashed var(--border);
  border-radius: 10px;
}

/* Reply form */
.rd-reply-form {
  margin-top: 16px;
  padding-top: 16px;
  border-top: 2px solid var(--border);
}
.rd-reply-form label {
  display: block;
  font-size: 13px;
  font-weight: 600;
  color: var(--text);
  margin-bottom: 6px;
}
.rd-reply-form textarea {
  width: 100%;
  min-height: 80px;
  padding: 10px 12px;
  border: 1px solid #d1d5db;
  border-radius: 10px;
  font-size: 14px;
  font-family: inherit;
  resize: vertical;
  box-sizing: border-box;
  transition: border-color 0.15s, box-shadow 0.15s;
  color: var(--text);
}
.rd-reply-form textarea:focus {
  outline: none;
  border-color: var(--primary);
  box-shadow: 0 0 0 3px rgba(1, 83, 91, 0.1);
}
.rd-reply-form textarea::placeholder { color: #9ca3af; }
.rd-reply-form .rd-form-actions {
  display: flex;
  justify-content: flex-end;
  margin-top: 10px;
}
.rd-reply-form button {
  background: var(--primary);
  color: #fff;
  padding: 9px 22px;
  border: none;
  border-radius: 10px;
  font-weight: 600;
  font-size: 14px;
  cursor: pointer;
  transition: background 0.15s, transform 0.1s;
  display: inline-flex;
  align-items: center;
  gap: 6px;
}
.rd-reply-form button:hover {
  background: var(--primary-hover-fill, var(--primary-hover));
  transform: translateY(-1px);
}
.rd-reply-form button:active { transform: translateY(0); }
.rd-reply-form button:disabled {
  opacity: 0.5;
  cursor: not-allowed;
  transform: none;
}

.schedule-modal-overlay {
  position: fixed;
  inset: 0;
  display: none;
  align-items: center;
  justify-content: center;
  padding: 24px;
  background: rgba(15, 23, 42, 0.52);
  z-index: 1100;
  backdrop-filter: blur(6px);
}

.schedule-modal-overlay.active { display: flex; }

.schedule-modal-box {
  width: min(1100px, 100%);
  max-height: calc(100vh - 48px);
  overflow: auto;
  border-radius: 22px;
  background: linear-gradient(180deg, #ffffff 0%, #f8fbff 100%);
  border: 1px solid rgba(148, 163, 184, 0.24);
  box-shadow: 0 30px 80px rgba(15, 23, 42, 0.18);
  position: relative;
}

.schedule-modal-close {
  position: absolute;
  top: 16px;
  right: 16px;
  width: 40px;
  height: 40px;
  border-radius: 999px;
  border: 1px solid var(--border);
  background: #fff;
  color: #475569;
  font-size: 24px;
  line-height: 1;
  cursor: pointer;
}

.schedule-modal-body {
  padding: 36px 28px 28px;
}

.schedule-header {
  display: flex;
  justify-content: space-between;
  gap: 16px;
  align-items: flex-start;
  margin-bottom: 20px;
  padding-right: 72px;
}

.schedule-title {
  margin: 0;
  font-size: 1.65rem;
  color: var(--text);
}

.schedule-subtext {
  margin: 8px 0 0;
  color: var(--muted);
  line-height: 1.6;
}

.schedule-toolbar {
  display: flex;
  gap: 10px;
  flex-wrap: nowrap;
  justify-content: flex-end;
  align-items: center;
}

.schedule-toolbar .nav-link {
  white-space: nowrap;
}

.schedule-action-button {
  position: relative;
  justify-content: center;
}

.schedule-action-button[disabled] {
  opacity: 0.7;
  cursor: wait;
}

.schedule-action-button.is-loading {
  padding-left: 36px;
}

.schedule-action-button.is-loading::before {
  content: '';
  position: absolute;
  left: 14px;
  top: 50%;
  width: 12px;
  height: 12px;
  margin-top: -6px;
  border-radius: 999px;
  border: 2px solid currentColor;
  border-right-color: transparent;
  animation: schedule-spin 0.8s linear infinite;
}

.schedule-readonly-banner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8px;
  padding: 6px 10px;
  border: 1px solid #dbeafe;
  background: #f8fbff;
  border-radius: 8px;
  color: #334155;
  font-size: 12px;
  font-weight: 600;
}

.schedule-notice {
  display: none;
  margin-bottom: 18px;
  padding: 14px 16px;
  border-radius: 14px;
  font-size: 14px;
  font-weight: 600;
}

.schedule-notice.is-visible { display: block; }
.schedule-notice.is-success { background: #ecfdf5; color: #166534; border: 1px solid #bbf7d0; }
.schedule-notice.is-error { background: #fef2f2; color: #b91c1c; border: 1px solid #fecaca; }
.schedule-notice.is-info { background: #eff6ff; color: #1d4ed8; border: 1px solid #bfdbfe; }

.schedule-shell {
  display: grid;
  gap: 10px;
  position: relative;
}

.schedule-shell.with-watermark::after {
  content: '';
  position: absolute;
  inset: 0;
  background-image: var(--schedule-watermark-image);
  background-repeat: no-repeat;
  background-position: center;
  background-size: min(380px, 72%);
  opacity: 0.08;
  pointer-events: none;
  z-index: 2;
}

.schedule-shell > * {
  position: relative;
  z-index: 1;
}

.schedule-summary-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 8px;
}

.schedule-summary-details {
  margin-bottom: 8px;
}

.schedule-summary-toggle {
  display: none;
}

.schedule-summary-toggle::-webkit-details-marker {
  display: none;
}

.schedule-summary-toggle::marker {
  content: "";
}

.schedule-summary-toggle-button {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  border: 1px solid var(--border);
  border-radius: 14px;
  background: #fff;
  padding: 12px 14px;
  color: var(--text);
  font: inherit;
  font-weight: 700;
  cursor: pointer;
}

.schedule-summary-toggle-label {
  font-size: 14px;
}

.schedule-summary-toggle-icon {
  color: var(--muted);
  font-size: 20px;
  line-height: 1;
  transition: transform 0.2s ease;
}

.schedule-summary-details[open] .schedule-summary-toggle-icon {
  transform: rotate(90deg);
}

.schedule-summary-content {
  margin-top: 12px;
}

.schedule-summary-card {
  border: 1px solid var(--border);
  border-radius: 10px;
  background: #fff;
  padding: 8px 10px;
}

.schedule-summary-card span {
  display: block;
  font-size: 10px;
  color: var(--muted);
  text-transform: uppercase;
  letter-spacing: 0.04em;
  font-weight: 700;
}

.schedule-summary-card strong {
  display: block;
  margin-top: 2px;
  color: var(--text);
  font-size: 13px;
  font-weight: 700;
}

.schedule-empty,
.schedule-prompt {
  border: 1px dashed rgba(148, 163, 184, 0.5);
  border-radius: 18px;
  padding: 24px;
  background: #fff;
}

.schedule-empty h4,
.schedule-prompt h4 {
  margin: 0 0 10px;
  font-size: 1.1rem;
  color: var(--text);
}

.schedule-empty p,
.schedule-prompt p {
  margin: 0;
  color: var(--muted);
  line-height: 1.7;
}

.schedule-prompt-actions,
.schedule-editor-actions {
  display: flex;
  gap: 10px;
  flex-wrap: wrap;
  margin-top: 16px;
}

.schedule-table-wrap {
  --schedule-day-column-width: 92px;
  --schedule-slot-column-width: 96px;
  --schedule-cell-min-height: 44px;
  overflow: auto;
  border: 1px solid var(--border);
  border-radius: 14px;
  background: #fff;
}

.schedule-table {
  width: 100%;
  border-collapse: collapse;
  min-width: calc(var(--schedule-day-column-width) + (var(--schedule-slot-column-width) * 5));
  table-layout: fixed;
}

.schedule-table th,
.schedule-table td {
  padding: 0;
  border: 1px solid #d7dee8;
  text-align: center;
  vertical-align: middle;
}

.schedule-table th {
  background: #f8fafc;
  color: #475569;
  font-size: 10.5px;
  text-transform: uppercase;
  letter-spacing: 0.04em;
}

.schedule-table tr:last-child td { border-bottom: none; }

.schedule-table .schedule-day-cell {
  width: var(--schedule-day-column-width);
  min-width: var(--schedule-day-column-width);
  padding: 8px 6px;
  background: #f8fafc;
  font-weight: 700;
  color: #0f172a;
  font-size: 12px;
  position: sticky;
  left: 0;
  z-index: 2;
}

.schedule-slot-header {
  min-width: var(--schedule-slot-column-width);
  background: linear-gradient(180deg, #fff 0%, #f8fbff 100%);
}

.schedule-slot-header-inner {
  padding: 6px 6px 7px;
  display: grid;
  gap: 3px;
}

.schedule-slot-period-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 6px;
}

.schedule-slot-period {
  font-size: 10px;
  color: #64748b;
  font-weight: 800;
  letter-spacing: 0.06em;
}

.schedule-slot-time-grid {
  display: grid;
  gap: 2px;
}

.schedule-slot-time-display {
  font-size: 10px;
  color: #0f172a;
  font-weight: 700;
  line-height: 1.2;
}

.schedule-slot-remove {
  padding: 0;
  border-radius: 999px;
  border: 1px solid #fecaca;
  background: #fff5f5;
  color: #b91c1c;
  font-size: 13px;
  font-weight: 700;
  cursor: pointer;
  line-height: 1;
  width: 20px;
  height: 20px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 auto;
}

.schedule-day-label-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 6px;
}

.schedule-day-label-text {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: 12px;
}

.schedule-day-restore-row {
  display: flex;
  align-items: center;
  gap: 6px;
  flex-wrap: wrap;
  margin-top: 4px;
}

.schedule-day-restore-label {
  font-size: 11px;
  color: var(--muted);
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.04em;
}

.schedule-day-chip {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 4px 10px;
  border-radius: 999px;
  border: 1px solid #cbd5e1;
  background: #fff;
  color: #0f172a;
  font: inherit;
  font-size: 11.5px;
  font-weight: 600;
  cursor: pointer;
  line-height: 1.2;
}

.schedule-cell-input,
.schedule-cell-select {
  width: 100%;
  padding: 6px 8px;
  border-radius: 8px;
  border: 1px solid #cbd5e1;
  font: inherit;
  font-size: 12px;
  background: #fff;
  color: #0f172a;
  box-sizing: border-box;
}

.schedule-cell-input:focus,
.schedule-cell-select:focus {
  outline: none;
  border-color: rgba(1, 83, 91, 0.55);
  box-shadow: 0 0 0 4px rgba(1, 83, 91, 0.08);
}

.schedule-slot-time-input {
  text-align: center;
  font-weight: 700;
  padding: 5px 4px;
  font-size: 12px;
  border-radius: 8px;
}

.schedule-cell-select {
  min-width: var(--schedule-slot-column-width);
  min-height: var(--schedule-cell-min-height);
  border: none;
  border-radius: 0;
  text-align: center;
  background: transparent;
  appearance: none;
  cursor: pointer;
  padding-right: 34px;
}

.schedule-cell-select-wrap {
  position: relative;
  min-width: var(--schedule-slot-column-width);
  min-height: var(--schedule-cell-min-height);
}

.schedule-cell-arrow {
  position: absolute;
  top: 50%;
  right: 12px;
  transform: translateY(-50%);
  color: #64748b;
  font-size: 14px;
  pointer-events: none;
}

.schedule-readonly-cell {
  min-width: var(--schedule-slot-column-width);
  min-height: var(--schedule-cell-min-height);
  padding: 5px 6px;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  font-weight: 600;
  color: #0f172a;
  font-size: 11.5px;
  line-height: 1.2;
}

.schedule-readonly-cell.is-assigned-teacher-subject {
  background: color-mix(in srgb, var(--primary) 10%, white);
  color: var(--primary);
  box-shadow: inset 0 0 0 2px color-mix(in srgb, var(--primary) 22%, white);
  font-weight: 800;
}

.schedule-readonly-cell.is-custom-entry {
  background: transparent;
  color: #c77700;
  box-shadow: none;
  font-weight: 700;
}

.schedule-readonly-cell.is-empty {
  color: #94a3b8;
}

.schedule-readonly-value {
  color: #0f172a;
  font-weight: 600;
}

.schedule-readonly-subject {
  display: inline-block;
  padding: 8px 12px;
  border-radius: 999px;
  background: #f1f5f9;
  color: #334155;
  font-weight: 600;
}

.schedule-row-actions {
  display: flex;
  justify-content: flex-end;
}

.schedule-inline-note {
  margin-top: 14px;
  color: var(--muted);
  font-size: 13px;
}

@keyframes schedule-spin {
  to { transform: rotate(360deg); }
}

@media (max-width: 640px) {
  .report-modal-overlay { padding: 112px 12px 20px; }
  .rd-modal-body { padding: 16px; }
  .rd-info-grid { grid-template-columns: 1fr 1fr; }
  .rd-reply-header { flex-direction: column; align-items: flex-start; gap: 2px; }
  .rp-card { flex-direction: column; align-items: flex-start; }
  .rp-right { width: 100%; justify-content: space-between; }
  .schedule-table-wrap {
    --schedule-day-column-width: 90px;
    --schedule-slot-column-width: 96px;
    --schedule-cell-min-height: 52px;
  }
  .schedule-modal-overlay {
    align-items: flex-start;
    padding: 112px 12px 12px;
  }
  .schedule-modal-box { width: 100%; max-height: calc(100vh - 124px); border-radius: 18px; }
  .schedule-modal-body { padding: 24px 18px 18px; }
  .schedule-header {
    flex-direction: column;
    padding-right: 0;
    padding-top: 28px;
  }
  .schedule-summary-toggle {
    display: block;
  }
  .schedule-summary-details:not([open]) .schedule-summary-content {
    display: none;
  }
  .schedule-table th {
    font-size: 10px;
    letter-spacing: 0.04em;
  }
  .schedule-table .schedule-day-cell {
    padding: 10px 6px;
  }
  .schedule-slot-period {
    font-size: 10px;
  }
  .schedule-slot-time-display,
  .schedule-day-label-text,
  .schedule-readonly-cell {
    font-size: 11px;
  }
  .schedule-toolbar { width: 100%; flex-wrap: wrap; justify-content: flex-start; }
  .schedule-toolbar .nav-link { flex: 1 1 120px; }
  .schedule-readonly-banner { flex-direction: column; align-items: flex-start; }
  .schedule-summary-grid { grid-template-columns: 1fr 1fr; }
}

@media (max-width: 480px) {
  .schedule-summary-grid { grid-template-columns: 1fr 1fr; }
  .schedule-day-restore-row { align-items: center; }
  .schedule-day-chip { width: auto; justify-content: center; }
}

.workspace-shell {
  width: 100%;
  max-width: none !important;
  margin: 0;
  padding: 8px 12px 20px;
  box-sizing: border-box;
}

.workspace-grid {
  display: grid;
  grid-template-columns: 240px minmax(0, 1fr);
  gap: 12px;
  align-items: start;
  width: 100%;
}

.workspace-main > *,
.workspace-stage,
.workspace-panels,
.workspace-panel,
.workspace-header-card,
.workspace-tabbar-shell {
  width: 100%;
  max-width: none;
}

.workspace-sidebar {
  position: sticky;
  top: 12px;
  max-height: calc(100vh - 24px);
  overflow: auto;
  border-radius: 14px;
  padding-bottom: 12px;
  scrollbar-width: none;
}
.workspace-sidebar::-webkit-scrollbar { width: 0; height: 0; }

.workspace-main {
  min-width: 0;
  width: 100%;
  max-width: none;
  display: grid;
  gap: 8px;
  justify-self: stretch;
}

.workspace-main > .card,
.workspace-main > .report-modal-overlay {
  width: 100%;
}

.dashboard-main.workspace-main {
  width: 100%;
  max-width: none;
}

.workspace-header-card {
  padding: 10px 14px;
  border-radius: 10px;
  background: #fff;
  border: 1px solid var(--border);
  box-shadow: 0 4px 14px rgba(15, 23, 42, 0.04);
  position: sticky;
  top: 8px;
  z-index: 6;
}

/* Match heights of sidebar header ("Class Tools") with workspace header so both sit on the same baseline */
.workspace-sidebar .nav-header {
  position: sticky;
  top: 0;
  background: #fff;
  z-index: 2;
  padding: 8px 12px 6px;
  border-bottom: 1px solid var(--border);
  border-radius: 14px 14px 0 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8px;
}
.workspace-sidebar .nav-header h3 {
  margin: 0;
  font-size: 13px;
  font-weight: 700;
  color: var(--text);
  letter-spacing: 0.02em;
}
.workspace-sidebar .nav-header .card-subtext { display: none; }
.workspace-sidebar .side-nav { padding: 4px 8px 8px; display: grid; gap: 1px; }

/* Plain text-style link for "Class Room" (not a button) */
.nav-text-link {
  display: block;
  padding: 6px 4px;
  margin-bottom: 6px;
  color: var(--text);
  font-size: 13px;
  font-weight: 600;
  text-decoration: none;
  letter-spacing: 0.01em;
  cursor: pointer;
}
.nav-text-link:hover { color: var(--primary); }
.nav-text-link.is-active { color: var(--primary); }

/* Collapsible section toggle in sidebar (Subjects) */
.nav-section-collapsible { padding: 0 !important; }
.nav-section-toggle {
  width: 100%;
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 5px 10px;
  background: transparent;
  border: 1px solid transparent;
  border-radius: 8px;
  cursor: pointer;
  color: var(--text);
  font-size: 13px;
  font-weight: 500;
  text-align: left;
}
.nav-section-toggle .nav-link-label { flex: 1; }
.nav-section-toggle:hover {
  background: rgba(1, 83, 91, 0.06);
  color: var(--primary);
}
.nav-section-toggle:hover .nav-icon { color: var(--primary); }
.nav-section-icon { transition: transform 0.18s ease; font-size: 14px; color: var(--muted); }
.nav-section-toggle[aria-expanded="true"] .nav-section-icon { transform: rotate(90deg); color: var(--primary); }
.nav-count-pill {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 22px;
  padding: 1px 8px;
  border-radius: 999px;
  background: rgba(1, 83, 91, 0.10);
  color: var(--primary);
  font-size: 10px;
  font-weight: 700;
}

.nav-section-children { padding: 0 !important; }
.nav-section-children[hidden] { display: none !important; }
.nav-sublist {
  list-style: none;
  padding: 2px 0 6px 28px;
  margin: 0;
  display: grid;
  gap: 1px;
  border-left: 1px solid var(--border);
  margin-left: 18px;
}
.nav-sublink {
  width: 100%;
  text-align: left;
  background: transparent;
  border: none;
  padding: 6px 10px;
  border-radius: 6px;
  color: var(--text);
  font-size: 12.5px;
  font-weight: 500;
  cursor: pointer;
}
.nav-sublink:hover { background: rgba(1, 83, 91, 0.06); color: var(--primary); }
.nav-sub-empty { padding: 6px 10px; color: var(--muted); font-size: 11px; }

/* Overview counts row (Students, Subjects, Teachers, Reports) */
.overview-counts-row {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 8px;
}
.overview-count-chip {
  position: relative;
  border: 1px solid var(--border);
  border-radius: 10px;
  padding: 8px 10px;
  background: #fff;
  display: flex;
  align-items: center;
  gap: 10px;
  overflow: hidden;
  transition: transform 0.18s ease, box-shadow 0.18s ease, border-color 0.18s ease;
}
.overview-count-chip:hover {
  transform: translateY(-1px);
  border-color: rgba(1, 83, 91, 0.24);
  box-shadow: 0 6px 14px rgba(15, 23, 42, 0.05);
}
.overview-count-chip .count-icon {
  width: 26px;
  height: 26px;
  border-radius: 7px;
  background: rgba(1, 83, 91, 0.10);
  color: var(--primary);
  display: inline-flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.overview-count-chip .count-icon svg { width: 14px; height: 14px; }
.overview-count-chip .count-text {
  display: flex;
  flex-direction: column;
  gap: 2px;
  min-width: 0;
}
.overview-count-chip .count-label {
  font-size: 9px;
  font-weight: 700;
  color: var(--muted);
  text-transform: uppercase;
  letter-spacing: 0.06em;
}
.overview-count-chip .count-num {
  font-size: 16px;
  font-weight: 700;
  color: var(--text);
  line-height: 1;
  letter-spacing: -0.01em;
}

/* Teachers chip row (open by default, compact) */
.teacher-section { padding: 10px 12px; }
.teachers-head { display: flex; align-items: baseline; gap: 8px; margin-bottom: 6px; flex-wrap: wrap; }
.teachers-head .section-title { font-size: 13px; font-weight: 700; color: var(--text); margin: 0; }
.teachers-head .section-subtext { font-size: 11px; color: var(--muted); }
.teachers-chip-row { display: flex; flex-wrap: wrap; gap: 6px; }
.teacher-chip {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 4px 10px 4px 4px;
  border: 1px solid var(--border);
  border-radius: 999px;
  background: #fff;
}
.teacher-chip.is-main {
  border-color: rgba(1, 83, 91, 0.28);
  background: rgba(1, 83, 91, 0.04);
}
.teacher-avatar {
  width: 22px;
  height: 22px;
  border-radius: 50%;
  background: linear-gradient(135deg, var(--primary), rgba(1,83,91,0.7));
  color: #fff;
  font-size: 10px;
  font-weight: 700;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.teacher-info { display: flex; flex-direction: column; line-height: 1.1; }
.teacher-info .teacher-name { font-size: 12px; font-weight: 600; color: var(--text); }
.teacher-info .teacher-role {
  font-size: 9px;
  font-weight: 700;
  color: var(--muted);
  text-transform: uppercase;
  letter-spacing: 0.06em;
}
.teacher-chip.is-main .teacher-info .teacher-role { color: var(--primary); }
.teacher-radio { margin-left: 2px; cursor: pointer; transform: scale(0.85); }

/* Collapsible Teachers section */
.teachers-mobile-toggle {
  display: flex;
  width: 100%;
  align-items: center;
  justify-content: space-between;
  gap: 8px;
  padding: 6px 4px;
  background: transparent;
  border: none;
  cursor: pointer;
  font: inherit;
  color: var(--text);
}
.teachers-mobile-toggle .section-title { font-size: 13px; font-weight: 700; margin: 0; }
.teachers-mobile-toggle .teachers-mobile-meta {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  color: var(--muted);
  font-size: 11px;
}
.teachers-mobile-toggle .teachers-mobile-chevron {
  transition: transform 0.18s ease;
  color: var(--muted);
}
.teachers-mobile-toggle[aria-expanded="true"] .teachers-mobile-chevron { transform: rotate(90deg); color: var(--primary); }
.teachers-head { display: none; }
.teachers-chip-row { margin-top: 6px; }
.teacher-section[data-collapsed="true"] .teachers-chip-row { display: none; }
@media (max-width: 768px) {
  .teacher-section { padding: 8px 10px; }
}

/* Two-column overview split for Students + Subjects */
.overview-split {
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
  gap: 8px;
}
@media (max-width: 980px) { .overview-split { grid-template-columns: 1fr; } }

.section-header-row {
  display: flex;
  align-items: center;
  gap: 8px;
  margin-bottom: 4px;
}
.section-count-pill {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 22px;
  padding: 1px 8px;
  border-radius: 999px;
  background: rgba(1, 83, 91, 0.10);
  color: var(--primary);
  font-size: 10px;
  font-weight: 700;
}

/* Students interactive rows */
.students-overview-section { padding: 8px 12px; }
.students-overview-section .section-title { font-size: 13px; font-weight: 700; color: var(--text); margin: 0; }
.students-numbered-list { list-style: none; counter-reset: none; padding: 0; margin: 0; display: grid; gap: 0; }
.students-numbered-list li {
  display: block;
  border-bottom: 1px solid var(--border);
  background: transparent !important;
}
.students-numbered-list li:last-child { border-bottom: none; }
.students-numbered-list li::before { content: none !important; }

.student-row {
  width: 100%;
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 5px 6px;
  background: transparent;
  border: none;
  text-align: left;
  cursor: pointer;
  border-radius: 6px;
  line-height: 1.2;
  transition: background 0.15s ease, color 0.15s ease;
}
.student-row:hover { background: rgba(1, 83, 91, 0.04); }
.student-row:hover .student-name { color: var(--primary); }
.student-row:hover .student-arrow { color: var(--primary); transform: translateX(2px); }
.student-index {
  flex: 0 0 20px;
  color: var(--muted);
  font-size: 11px;
  font-weight: 600;
  text-align: right;
}
.student-name {
  flex: 1;
  color: var(--text);
  font-size: 12.5px;
  font-weight: 500;
  transition: color 0.15s ease;
}
.student-arrow {
  color: #cbd5e1;
  font-size: 13px;
  line-height: 1;
  transition: color 0.15s ease, transform 0.15s ease;
}

/* Subjects cards (overview) */
.subjects-overview-section { padding: 8px 12px; }
.subjects-overview-section .section-title { font-size: 13px; font-weight: 700; color: var(--text); margin: 0; }
.subjects-card-grid { display: grid; gap: 5px; }
.subject-card {
  width: 100%;
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 6px 10px;
  border: 1px solid var(--border);
  border-radius: 8px;
  background: #fff;
  cursor: pointer;
  text-align: left;
  transition: border-color 0.15s ease, box-shadow 0.15s ease, transform 0.15s ease;
}
.subject-card:hover {
  border-color: rgba(1, 83, 91, 0.28);
  box-shadow: 0 4px 10px rgba(15, 23, 42, 0.04);
  transform: translateY(-1px);
}
.subject-icon {
  width: 22px;
  height: 22px;
  border-radius: 6px;
  background: rgba(1, 83, 91, 0.10);
  color: var(--primary);
  display: inline-flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.subject-icon svg { width: 12px; height: 12px; }
.subject-text { display: flex; flex-direction: column; gap: 0; min-width: 0; flex: 1; line-height: 1.2; }
.subject-text strong { font-size: 12.5px; font-weight: 600; color: var(--text); }
.subject-text span { font-size: 10.5px; color: var(--muted); }
.subject-arrow { color: #cbd5e1; font-size: 14px; transition: color 0.15s ease, transform 0.15s ease; }
.subject-card:hover .subject-arrow { color: var(--primary); transform: translateX(2px); }

.workspace-header-row {
  display: flex;
  justify-content: space-between;
  gap: 20px;
  align-items: flex-start;
}

.workspace-header-line {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14px;
  min-height: 0;
  flex-wrap: nowrap;
}

.workspace-header-copy {
  display: flex;
  flex-direction: column;
  gap: 2px;
  min-width: 0;
}

.workspace-header-copy .eyebrow {
  font-size: 9px;
  font-weight: 700;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: var(--muted);
  line-height: 1;
}

.workspace-title-row {
  display: flex;
  align-items: center;
  gap: 8px;
}

.workspace-header-copy .page-title {
  margin: 0;
  font-size: 20px;
  font-weight: 700;
  color: var(--text);
  line-height: 1.1;
}

.workspace-cohort {
  font-size: 11px;
  font-weight: 500;
  color: var(--muted);
}

.workspace-divider {
  width: 1px;
  align-self: stretch;
  background: var(--border);
  margin: 4px 0;
}

.workspace-session-badge {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 6px 10px;
  border-radius: 999px;
  border: 1px solid rgba(1, 83, 91, 0.18);
  background: rgba(1, 83, 91, 0.08);
  color: var(--primary);
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 0.04em;
  text-transform: uppercase;
  white-space: nowrap;
}
.workspace-session-badge::before {
  content: "";
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: #22c55e;
  box-shadow: 0 0 0 3px rgba(34, 197, 94, 0.18);
}

.workspace-meta-inline {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 8px;
  flex-wrap: wrap;
  margin-left: auto;
}

.workspace-meta-pair {
  display: inline-flex;
  align-items: center;
  gap: 5px;
  padding: 5px 8px;
  border-radius: 999px;
  background: #f8fafc;
  border: 1px solid #e5e7eb;
  white-space: nowrap;
}

.workspace-meta-pair .meta-label {
  font-size: 9px;
  font-weight: 700;
  letter-spacing: 0.06em;
  text-transform: uppercase;
  color: var(--muted);
  margin: 0;
}

.workspace-meta-pair .meta-value {
  font-size: 12px;
  font-weight: 700;
  color: var(--text);
  margin: 0;
}

.workspace-meta-toggle {
  display: none;
}

.workspace-tabbar-shell {
  padding: 0;
  overflow: visible;
  position: sticky;
  top: 56px;
  z-index: 5;
  background: #fff;
  border-radius: 10px 10px 0 0;
}

.workspace-tabbar {
  display: flex;
  align-items: flex-end;
  gap: 2px;
  overflow-x: auto;
  padding: 0 8px;
  min-height: 32px;
  border-bottom: 1px solid var(--border);
  background: linear-gradient(180deg, #fcfdfd 0%, #f7faf9 100%);
  scrollbar-width: none;
}
.workspace-tabbar::-webkit-scrollbar { height: 0; }

.workspace-tab {
  display: inline-flex;
  align-items: center;
  gap: 2px;
  min-height: 26px;
  margin-bottom: -1px;
  padding: 0 2px 0 0;
  border: 1px solid transparent;
  border-bottom-color: transparent;
  border-radius: 7px 7px 0 0;
  background: transparent;
  color: #64748b;
  cursor: pointer;
  transition: background 0.15s ease, color 0.15s ease;
  white-space: nowrap;
  font: inherit;
}

.workspace-tab:hover {
  background: rgba(255, 255, 255, 0.7);
  color: var(--text);
}

.workspace-tab.is-active {
  background: #ffffff;
  color: var(--primary);
  border-color: var(--border);
  box-shadow: 0 -1px 0 rgba(255,255,255,0.9);
}

.workspace-tab-label {
  font-size: 11.5px;
  font-weight: 600;
}

.workspace-tab-activate {
  border: none;
  background: transparent;
  color: inherit;
  padding: 0 8px;
  min-height: 24px;
  font: inherit;
  cursor: pointer;
  display: inline-flex;
  align-items: center;
}

.workspace-tab-close {
  width: 16px;
  height: 16px;
  border-radius: 999px;
  border: none;
  background: transparent;
  color: #94a3b8;
  cursor: pointer;
  font-size: 12px;
  line-height: 1;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  margin-right: 4px;
  transition: background 0.15s ease, color 0.15s ease;
}
.workspace-tab-close:hover {
  background: rgba(15, 23, 42, 0.08);
  color: var(--text);
}

.workspace-tab:not(.is-active) .workspace-tab-close {
  background: transparent;
  color: #94a3b8;
}

.workspace-tab.is-active .workspace-tab-close {
  background: transparent;
  color: var(--primary);
}

.workspace-tab-add {
  flex: 0 0 auto;
  width: 20px;
  height: 20px;
  margin: 0 0 4px 4px;
  border-radius: 6px;
  border: 1px dashed #cbd5e1;
  background: transparent;
  color: var(--muted);
  font-size: 13px;
  line-height: 1;
  cursor: pointer;
  transition: all 0.15s ease;
}

.workspace-tab-add:hover {
  border-color: var(--primary);
  color: var(--primary);
  background: rgba(1, 83, 91, 0.06);
}

.workspace-stage {
  padding: 0;
  min-height: calc(100vh - 238px);
  overflow: hidden;
}

.workspace-panels {
  position: relative;
  min-height: inherit;
  width: 100%;
}

.workspace-panel {
  display: none;
  padding: 12px 14px;
  min-height: inherit;
  animation: workspaceFadeIn 0.2s ease;
}

.workspace-panel.is-active {
  display: block;
}

.workspace-panel[hidden] {
  display: none !important;
}

.workspace-panel-head {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 12px;
  margin-bottom: 10px;
}

.workspace-panel-head .card-title {
  margin-bottom: 2px;
  font-size: 15px;
}
.workspace-panel-head .card-subtext {
  margin: 0;
  font-size: 12px;
}

.schedule-mobile-toggle {
  display: none;
}

.workspace-empty-state {
  display: grid;
  place-items: center;
  min-height: 420px;
  padding: 32px;
}

.workspace-empty-state[hidden] {
  display: none !important;
}

.workspace-empty-card {
  max-width: 420px;
  text-align: center;
}

.workspace-empty-card h2 {
  margin: 0 0 10px;
  color: var(--text);
  font-size: 24px;
}

.workspace-empty-card p {
  margin: 0;
  color: var(--muted);
  line-height: 1.7;
}

.workspace-overview-grid {
  display: grid;
  gap: 16px;
}

.workspace-quick-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 12px;
}

.workspace-quick-button {
  width: 100%;
  border: 1px solid var(--border);
  border-radius: 14px;
  background: linear-gradient(180deg, #ffffff 0%, #f8fbff 100%);
  padding: 16px;
  text-align: left;
  cursor: pointer;
  transition: transform 0.18s ease, border-color 0.18s ease, box-shadow 0.18s ease;
}

.workspace-quick-button:hover {
  transform: translateY(-1px);
  border-color: rgba(1, 83, 91, 0.28);
  box-shadow: 0 12px 24px rgba(15, 23, 42, 0.08);
}

.workspace-quick-label {
  display: block;
  color: var(--muted);
  font-size: 12px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.05em;
}

.workspace-quick-value {
  display: block;
  margin-top: 8px;
  color: var(--text);
  font-size: 17px;
  font-weight: 700;
}

.workspace-split-grid {
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
  gap: 16px;
}

.workspace-resource-grid {
  display: grid;
  gap: 12px;
}

.workspace-resource-button {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14px;
  padding: 14px 16px;
  border-radius: 14px;
  border: 1px solid var(--border);
  background: #fff;
  color: var(--text);
  cursor: pointer;
  text-align: left;
  transition: all 0.18s ease;
}

.workspace-resource-button:hover {
  border-color: rgba(1, 83, 91, 0.24);
  background: #f8fbff;
  box-shadow: 0 12px 24px rgba(15, 23, 42, 0.06);
}

.workspace-resource-text strong {
  display: block;
  font-size: 14px;
  font-weight: 700;
}

.workspace-resource-text span {
  display: block;
  margin-top: 4px;
  color: var(--muted);
  font-size: 12px;
}

.workspace-resource-arrow {
  color: var(--muted);
  font-size: 18px;
}

.workspace-list-stack {
  display: grid;
  gap: 12px;
}

.workspace-frame-panel {
  padding: 0;
}

.workspace-frame-shell {
  min-height: inherit;
  background: #f8fafc;
}

.workspace-frame-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 16px;
  padding: 16px 20px;
  border-bottom: 1px solid var(--border);
  background: linear-gradient(180deg, #ffffff 0%, #f8fbff 100%);
}

.workspace-frame-title {
  margin: 0;
  color: var(--text);
  font-size: 16px;
  font-weight: 700;
}

.workspace-frame-subtext {
  margin: 4px 0 0;
  color: var(--muted);
  font-size: 12px;
}

.workspace-frame {
  width: 100%;
  height: calc(100vh - 200px);
  min-height: 300px;
  border: none;
  display: block;
  background: #ffffff;
}

#panel-frame-paygira {
  padding: 0;
}

#panel-frame-paygira .workspace-frame-shell {
  min-height: calc(100vh - 238px);
  background: #080d1a;
}

#panel-frame-paygira .workspace-frame {
  display: block;
  min-height: calc(100vh - 238px);
  background: #080d1a;
}

#panel-frame-attendance {
  padding: 0;
}

#panel-frame-attendance .workspace-frame-shell {
  min-height: calc(100vh - 238px);
  background: #f8fafc;
}

#panel-frame-attendance .workspace-frame {
  display: block;
  min-height: calc(100vh - 238px);
  background: #f8fafc;
}

@keyframes workspaceFadeIn {
  from { opacity: 0; transform: translateY(4px); }
  to { opacity: 1; transform: translateY(0); }
}

@media (max-width: 1180px) {
  .workspace-quick-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .workspace-meta-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}

@media (max-width: 960px) {
  .workspace-grid {
    grid-template-columns: 1fr;
  }

  .workspace-sidebar {
    position: fixed;
    top: 72px;
    left: 0;
    width: 300px;
    max-width: 86vw;
    height: calc(100vh - 88px);
    z-index: 999;
  }

  .workspace-stage {
    min-height: auto;
  }
}

@media (max-width: 768px) {
  .workspace-header-row,
  .workspace-panel-head,
  .workspace-split-grid {
    grid-template-columns: 1fr;
    flex-direction: column;
  }

  .workspace-quick-grid,
  .workspace-meta-grid {
    grid-template-columns: 1fr 1fr;
  }
}

@media (max-width: 560px) {
  .workspace-shell {
    width: 100%;
    margin: 0;
    padding: 12px 12px 24px;
  }

  .workspace-header-card,
  .workspace-panel {
    padding: 16px;
  }

  .workspace-quick-grid,
  .workspace-meta-grid,
  .workspace-split-grid {
    grid-template-columns: 1fr;
  }

  .workspace-frame-header {
    padding: 14px 16px;
  }

  .workspace-frame {
    min-height: calc(100vh - 300px);
  }

  #panel-frame-paygira .workspace-frame-shell,
  #panel-frame-paygira .workspace-frame {
    min-height: calc(100vh - 188px);
  }
}

/* ===== Mobile compact density (class workspace) ===== */
/* Class header info toggle (icon button) */
.workspace-title-row {
  display: flex;
  align-items: center;
  gap: 8px;
  flex-wrap: wrap;
}
.workspace-meta-toggle {
  margin-left: auto;
  display: none;
  align-items: center;
  justify-content: center;
  width: 26px;
  height: 26px;
  padding: 0;
  border: 1px solid var(--border);
  border-radius: 999px;
  background: #fff;
  color: var(--muted);
  cursor: pointer;
  transition: color 0.15s ease, border-color 0.15s ease, background 0.15s ease;
}
.workspace-meta-toggle:hover {
  color: var(--primary);
  border-color: rgba(1, 83, 91, 0.28);
  background: rgba(1, 83, 91, 0.04);
}
.workspace-meta-toggle[aria-expanded="true"] {
  color: var(--primary);
  border-color: rgba(1, 83, 91, 0.28);
  background: rgba(1, 83, 91, 0.06);
}
.workspace-meta-toggle .workspace-meta-toggle-icon {
  width: 14px;
  height: 14px;
  display: block;
}
/* Desktop: meta inline is visible regardless of toggle state. The icon
   only serves as an affordance and toggles visibility on smaller screens. */

@media (max-width: 768px) {
  .workspace-shell {
    padding: 4px 8px 12px;
  }

  .workspace-main { gap: 6px; }

  /* Tighter, sticky nav toggle */
  .nav-toggle {
    padding: 4px 10px;
    min-height: 30px;
    border-radius: 8px;
    font-size: 12.5px;
    gap: 6px;
    margin: 8px 0 4px;
    position: sticky;
    top: 2px;
    z-index: 901;
    background: #fff;
  }
  .hamburger-icon { width: 13px; height: 1.5px; }
  .hamburger-icon::before, .hamburger-icon::after { width: 13px; height: 1.5px; }

  /* Keep the header below the mobile nav toggle while using the compact layout. */
  .workspace-header-card {
    top: 38px;
    padding: 8px 10px;
  }
  .workspace-header-line {
    flex-direction: row;
    align-items: center;
    justify-content: flex-start;
    gap: 0;
  }

  .workspace-header-copy {
    width: 100%;
  }

  .workspace-header-copy .eyebrow,
  .workspace-cohort {
    display: none !important;
  }

  .workspace-title-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    gap: 8px;
  }

  .workspace-header-copy .page-title {
    font-size: 16px;
    line-height: 1.1;
  }

  .workspace-meta-toggle {
    display: inline-flex;
    width: 24px;
    height: 24px;
    align-items: center;
    justify-content: center;
    flex: 0 0 auto;
  }

  .workspace-meta-toggle .workspace-meta-toggle-icon {
    width: 13px;
    height: 13px;
  }

  .workspace-meta-inline {
    display: none;
    justify-content: flex-start;
    width: 100%;
    gap: 6px;
    padding-top: 6px;
  }

  .workspace-header-card[data-meta-collapsed="false"] .workspace-meta-inline {
    display: flex;
  }

  .workspace-meta-pair {
    padding: 5px 8px;
  }
  /* Tab bar stacks beneath compact header */
  .workspace-tabbar-shell { top: 78px; border-radius: 8px 8px 0 0; }
  .workspace-tabbar { min-height: 28px; padding: 0 6px; }
  .workspace-tab { min-height: 22px; }
  .workspace-tab-activate { min-height: 22px; padding: 0 8px; }
  .workspace-tab-label { font-size: 11px; }
  .workspace-tab-add { width: 18px; height: 18px; margin: 0 0 3px 4px; font-size: 12px; }

  /* Overview: compact icon + number chips (icon and number side-by-side) */
  .workspace-overview-grid { display: grid; gap: 6px; }
  .overview-counts-row {
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 5px;
  }
  #panel-overview .overview-count-chip {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    gap: 6px;
    padding: 6px 8px;
    border-radius: 8px;
  }
  #panel-overview .overview-count-chip .count-icon {
    width: 18px;
    height: 18px;
    border-radius: 5px;
  }
  #panel-overview .overview-count-chip .count-icon svg { width: 11px; height: 11px; }
  #panel-overview .overview-count-chip .count-text {
    flex-direction: row;
    align-items: center;
    gap: 0;
  }
  #panel-overview .overview-count-chip .count-label { display: none; }
  #panel-overview .overview-count-chip .count-num { font-size: 14px; font-weight: 700; line-height: 1; }

  /* Teachers visible but collapsed; tighter accordion row */
  #panel-overview .subjects-overview-section { display: none !important; }
  #panel-overview .overview-split { grid-template-columns: 1fr; gap: 0; }
  #panel-overview .section-card { margin-top: 6px; }
  #panel-overview .overview-counts-row + .section-card { margin-top: 6px; }
  #panel-overview .teacher-section + .overview-split,
  #panel-overview .teacher-section { margin-bottom: 0; }
  #panel-overview .students-overview-section { margin-top: 6px; }
  .teacher-section { padding: 4px 10px; }

  /* Hide the cohort badge and any count pills next to the class title on mobile */
  .workspace-header-card .workspace-cohort,
  .workspace-header-card .section-count-pill,
  .workspace-header-card .class-count-pill,
  .workspace-header-card .class-number-badge { display: none !important; }

  /* Hide the count pill next to the Students header on mobile */
  .students-overview-section .section-count-pill { display: none !important; }
  .teachers-mobile-toggle { padding: 6px 2px; min-height: 32px; }
  .teachers-mobile-toggle .section-title { font-size: 12.5px; }
  .teachers-mobile-toggle .teachers-mobile-meta { font-size: 11px; gap: 6px; }

  /* Students compact rows */
  .students-overview-section { padding: 4px 10px 6px; }
  .students-overview-section .section-header-row { margin-bottom: 2px; }
  .students-overview-section .section-title { font-size: 12.5px; }
  .student-row { padding: 6px 4px; gap: 8px; }
  .student-name { font-size: 12.5px; }
  .student-index { font-size: 10.5px; }
  .student-arrow { font-size: 12px; }

  /* Compact density for child workspace pages */
  .workspace-stage { min-height: calc(100vh - 180px); }
  .workspace-panel { padding: 0; }
  .workspace-panel-head { padding: 6px 10px; gap: 6px; }
  .workspace-panel-head h2,
  .workspace-frame-header h2 { font-size: 14px; }
  .workspace-frame-header { padding: 6px 10px; }
  .workspace-frame-subtext,
  .card-subtext { font-size: 11px; }
  .schedule-mobile-toggle {
    display: flex;
    width: 100%;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    padding: 6px 0;
    background: transparent;
    border: none;
    cursor: pointer;
    font: inherit;
    color: var(--text);
  }
  .schedule-mobile-toggle .section-title { font-size: 12.5px; font-weight: 700; margin: 0; }
  .schedule-mobile-toggle .schedule-mobile-meta {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--muted);
    font-size: 11px;
  }
  .schedule-mobile-toggle .schedule-mobile-chevron {
    transition: transform 0.18s ease;
    color: var(--muted);
  }
  #panel-schedule[data-mobile-collapsed="false"] .schedule-mobile-toggle .schedule-mobile-chevron {
    transform: rotate(90deg);
    color: var(--primary);
  }
  #panel-schedule .schedule-panel-heading { display: none; }
  #panel-schedule[data-mobile-collapsed="true"] .schedule-toolbar,
  #panel-schedule[data-mobile-collapsed="true"] .schedule-panel-body {
    display: none;
  }
  .schedule-toolbar { gap: 6px; padding: 6px 8px; }
  .schedule-toolbar .nav-link,
  .toolbar-btn,
  .btn { padding: 4px 10px; font-size: 12px; min-height: 30px; }
  .rp-card { padding: 7px 10px; margin-bottom: 5px; border-radius: 8px; }
  .rp-subject { font-size: 12.5px; }
  .rp-meta { font-size: 11px; }
}

@media (max-width: 420px) {
  .overview-counts-row { gap: 4px; }
  #panel-overview .overview-count-chip { padding: 4px 2px; }
  #panel-overview .overview-count-chip .count-num { font-size: 11.5px; }
}
</style>

<body>
  <% const hasFilesFeature = Array.isArray(allowedFeatures) && (allowedFeatures.includes('Create Files') || allowedFeatures.includes('Files & Sheets') || allowedFeatures.includes('Docs/Sheets')); %>
  <% const hasAttendanceFeature = Array.isArray(allowedFeatures) && (allowedFeatures.includes('Attendance Tracking') || allowedFeatures.includes('Attendance tracking feature')); %>
  <% const hasAssessmentFeature = Array.isArray(allowedFeatures) && (allowedFeatures.includes('Assessment Tracking') || allowedFeatures.includes('Assessment tracking feature')); %>
  <div class="workspace-shell">
    <button class="nav-toggle" type="button">
      <span class="hamburger-icon" aria-hidden="true"></span>
      <span>Class Tools</span>
    </button>

    <div class="workspace-grid">
      <aside class="card nav-card workspace-sidebar" id="class-tools-panel">
        <div class="nav-header">
          <div>
            <h3>Class Tools</h3>
            <p class="card-subtext">Open sections as active workspace tabs.</p>
          </div>
          <button class="nav-close" type="button" aria-label="Close navigation">×</button>
        </div>
        <div class="side-nav">
          <ul class="nav-list">
            <li>
              <button class="nav-link" type="button" data-nav-key="overview" onclick="openWorkspaceTabByKey('overview')">
                <span class="nav-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9.5L12 3l9 6.5"/><path d="M5 9v11h14V9"/><path d="M10 20v-6h4v6"/></svg></span>
                <span class="nav-link-label">Class Room</span>
              </button>
            </li>

            <li class="nav-section-label">Communication</li>
            <li>
              <button class="nav-link" type="button" id="reports-nav-link" data-nav-key="reports" onclick="toggleReportsPanel(event)">
                <span class="nav-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z"/><path d="M14 3v5h5"/><path d="M9 13h6"/><path d="M9 17h4"/></svg></span>
                <span class="nav-link-label">Reports</span>
                <% if ((classReportsCount || 0) > 0) { %>
                  <span class="files-badge" title="Reports"><%= classReportsCount %></span>
                <% } %>
              </button>
            </li>

            <li class="nav-section-label">Tools</li>
            <li>
              <button class="nav-link" type="button" id="class-schedule-nav-link" data-nav-key="schedule" onclick="toggleClassScheduleModal(event)">
                <span class="nav-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="17" rx="2"/><path d="M3 10h18"/><path d="M8 2v4"/><path d="M16 2v4"/></svg></span>
                <span class="nav-link-label">Class Schedule</span>
              </button>
            </li>
            <li>
              <button class="nav-link" type="button" data-nav-key="paygira" onclick="openWorkspaceTabByKey('paygira')">
                <span class="nav-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 10h18"/><path d="M5 6h14a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2z"/></svg></span>
                <span class="nav-link-label">My PayGira</span>
              </button>
            </li>

            <% if (hasAttendanceFeature && (userRole !== "Teacher" || isMainTeacher)) { %>
              <li>
                <button class="nav-link" type="button" data-nav-key="attendance" onclick="openWorkspaceTabByKey('attendance')">
                  <span class="nav-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="4" width="16" height="17" rx="2"/><path d="M9 2v4"/><path d="M15 2v4"/><path d="M9 14l2 2 4-4"/></svg></span>
                  <span class="nav-link-label">Attendance</span>
                </button>
              </li>
            <% } %>

            <% if (hasAssessmentFeature) { %>
              <li class="nav-section-collapsible">
                <button class="nav-link nav-section-toggle" type="button" id="subjects-section-toggle" aria-expanded="false" aria-controls="subjects-section-list" onclick="toggleSubjectsNavSection(event)">
                  <span class="nav-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5V5a2 2 0 0 1 2-2h13v17H6.5A2.5 2.5 0 0 0 4 22.5"/><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H19"/></svg></span>
                  <span class="nav-link-label">Subjects</span>
                  <span class="nav-count-pill"><%= subjects.length %></span>
                  <span class="nav-section-icon" aria-hidden="true">›</span>
                </button>
              </li>
              <li class="nav-section-children" id="subjects-section-list" hidden>
                <ul class="nav-sublist">
                  <% if (subjects.length > 0) { %>
                    <% subjects.forEach(function(subject) { %>
                      <li><button class="nav-sublink" type="button" onclick="openSubjectWorkspaceTab(<%= subject.subject_id %>)"><%= subject.subject_name %></button></li>
                    <% }); %>
                  <% } else { %>
                    <li class="nav-sub-empty">No subjects assigned.</li>
                  <% } %>
                </ul>
              </li>
            <% } %>

            <% if (hasFilesFeature) { %>
              <li>
                <button class="nav-link" type="button" data-nav-key="docs" title="Docs/Sheets" onclick="openWorkspaceTabByKey('docs')">
                  <span class="nav-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 7a2 2 0 0 1 2-2h4l2 2h8a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/></svg></span>
                  <span class="nav-link-label">Docs &amp; Sheets</span>
                  <% if (userRole === 'Teacher' && (assignedFilesCount || 0) > 0) { %>
                    <span class="files-badge" title="Assigned docs/sheets"><%= assignedFilesCount %></span>
                  <% } %>
                </button>
              </li>
            <% } %>

          </ul>
        </div>
      </aside>

      <div class="nav-overlay" id="class-tools-overlay"></div>

      <main class="dashboard-main workspace-main">
        <section class="card workspace-header-card" data-meta-collapsed="true">
          <div class="workspace-header-line">
            <div class="workspace-header-copy">
              <span class="eyebrow">Class Workspace</span>
              <span class="workspace-title-row">
                <span class="page-title" id="className"><%= className %></span>
                <% if (graduationYearGroup) { %>
                  <span class="workspace-cohort"><%= graduationYearGroup %></span>
                <% } %>
                <button type="button" class="workspace-meta-toggle" aria-expanded="false" aria-controls="workspace-meta-inline" aria-label="Show class details" title="Show class details" onclick="toggleWorkspaceMeta(this)">
                  <svg class="workspace-meta-toggle-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg>
                </button>
              </span>
            </div>
            <div class="workspace-meta-inline" id="workspace-meta-inline">
              <span class="workspace-meta-pair"><span class="meta-label">Year</span><span class="meta-value"><%= schoolYear.year_label %></span></span>
              <span class="workspace-meta-pair"><span class="meta-label">Term</span><span class="meta-value"><%= currentTerm.term_name %></span></span>
              <span class="workspace-meta-pair"><span class="meta-label">Start</span><span class="meta-value"><%= new Date(currentTerm.start_date).toISOString().split('T')[0] %></span></span>
              <span class="workspace-meta-pair"><span class="meta-label">End</span><span class="meta-value"><%= new Date(currentTerm.end_date).toISOString().split('T')[0] %></span></span>
            </div>
          </div>
        </section>

        <section class="card workspace-tabbar-shell">
          <div class="workspace-tabbar" id="workspaceTabBar" role="tablist" aria-label="Open class workspace tabs"></div>
        </section>

        <section class="card workspace-stage">
          <div class="workspace-empty-state" id="workspaceEmptyState" hidden>
            <div class="workspace-empty-card">
              <h2>No open workspace tabs</h2>
              <p>Choose a class tool from the left sidebar to open a new work session. Tabs are created only when you open something.</p>
            </div>
          </div>

          <div class="workspace-panels" id="workspacePanels">
            <section class="workspace-panel" id="panel-overview" data-panel-key="overview">
              <div class="workspace-overview-grid">
                <div class="overview-counts-row">
                  <div class="overview-count-chip">
                    <span class="count-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg></span>
                    <div class="count-text">
                      <span class="count-label">Students</span>
                      <span class="count-num"><%= students.length %></span>
                    </div>
                  </div>
                  <div class="overview-count-chip">
                    <span class="count-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5V5a2 2 0 0 1 2-2h13v17H6.5A2.5 2.5 0 0 0 4 22.5"/><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H19"/></svg></span>
                    <div class="count-text">
                      <span class="count-label">Subjects</span>
                      <span class="count-num"><%= subjects.length %></span>
                    </div>
                  </div>
                  <div class="overview-count-chip">
                    <span class="count-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 10v6"/><path d="M2 10l10-5 10 5-10 5z"/><path d="M6 12v5a6 6 0 0 0 12 0v-5"/></svg></span>
                    <div class="count-text">
                      <span class="count-label">Teachers</span>
                      <span class="count-num"><%= employees.length %></span>
                    </div>
                  </div>
                  <div class="overview-count-chip">
                    <span class="count-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z"/><path d="M14 3v5h5"/><path d="M9 13h6"/><path d="M9 17h4"/></svg></span>
                    <div class="count-text">
                      <span class="count-label">Reports</span>
                      <span class="count-num"><%= classReportsCount || 0 %></span>
                    </div>
                  </div>
                </div>

                <div class="section-card teacher-section" id="teachers-section" data-collapsed="true">
                  <button type="button" class="teachers-mobile-toggle" aria-expanded="false" aria-controls="teachers-chip-row" onclick="toggleTeachersMobile(this)">
                    <span class="section-title">Teachers</span>
                    <span class="teachers-mobile-meta">
                      <span><%= employees.length %></span>
                      <span class="teachers-mobile-chevron" aria-hidden="true">›</span>
                    </span>
                  </button>
                  <div class="teachers-head">
                    <h2 class="section-title">Teachers</h2>
                    <span class="section-subtext">Main teacher can mark attendance and maintain the class workspace.</span>
                  </div>
                  <div class="teachers-chip-row" id="teachers-chip-row">
                    <% employees.forEach(function(employee) { %>
                      <% var initials = (employee.name || '?').trim().split(/\s+/).slice(0,2).map(function(p){return p[0];}).join('').toUpperCase(); %>
                      <div class="teacher-chip <% if (employee.main) { %>is-main<% } %>">
                        <span class="teacher-avatar"><%= initials %></span>
                        <span class="teacher-info">
                          <span class="teacher-name"><%= employee.name %></span>
                          <% if (employee.main) { %><span class="teacher-role">Main Teacher</span><% } else { %><span class="teacher-role">Teacher</span><% } %>
                        </span>
                        <% if (req.session && req.session.userRole !== 'Teacher' && req.session.userRole !== 'Supervisor') { %>
                          <input class="teacher-radio" type="radio" name="main_employee" value="<%= employee.user_id %>" <% if (employee.main) { %> checked <% } %> onchange="setMainEmployee('<%= classId %>', '<%= employee.user_id %>')" title="Set as main teacher">
                        <% } %>
                      </div>
                    <% }); %>
                  </div>
                </div>

                <div class="overview-split">
                  <div class="section-card students-overview-section">
                    <div class="section-header-row">
                      <h2 class="section-title">Students</h2>
                      <span class="section-count-pill"><%= students.length %></span>
                    </div>
                    <ul class="students-numbered-list">
                      <% if (students.length > 0) { %>
                        <% students.forEach(function(student, i) { %>
                          <li>
                            <button class="student-row" type="button" onclick="openStudentWorkspaceTab(<%= student.student_id %>)">
                              <span class="student-index"><%= i + 1 %></span>
                              <span class="student-name"><%= student.first_name %> <%= student.last_name %></span>
                              <span class="student-arrow" aria-hidden="true">›</span>
                            </button>
                          </li>
                        <% }); %>
                      <% } else { %>
                        <li class="card-subtext">No students in this class yet.</li>
                      <% } %>
                    </ul>
                  </div>

                  <% if (hasAssessmentFeature) { %>
                  <div class="section-card subjects-overview-section">
                    <div class="section-header-row">
                      <h2 class="section-title">Subjects</h2>
                      <span class="section-count-pill"><%= subjects.length %></span>
                    </div>
                    <div class="subjects-card-grid">
                      <% if (subjects.length > 0) { %>
                        <% subjects.forEach(function(subject) { %>
                          <button class="subject-card" type="button" onclick="openSubjectWorkspaceTab(<%= subject.subject_id %>)">
                            <span class="subject-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5V5a2 2 0 0 1 2-2h13v17H6.5A2.5 2.5 0 0 0 4 22.5"/><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H19"/></svg></span>
                            <span class="subject-text">
                              <strong><%= subject.subject_name %></strong>
                              <span>Open assessment workspace</span>
                            </span>
                            <span class="subject-arrow" aria-hidden="true">›</span>
                          </button>
                        <% }); %>
                      <% } else { %>
                        <p class="card-subtext">No subjects assigned yet.</p>
                      <% } %>
                    </div>
                  </div>
                  <% } %>
                </div>
              </div>
            </section>

            <section class="workspace-panel" id="panel-reports" data-panel-key="reports">
              <div class="workspace-panel-head">
                <div>
                  <h2 class="card-title">Parent Reports</h2>
                  <p class="card-subtext">Open a report thread without leaving the class workspace.</p>
                </div>
                <button class="nav-link" type="button" onclick="loadClassReports()">Refresh</button>
              </div>
              <div id="reports-list-content">
                <p style="color:#6b7280;font-size:13px;">Open the reports tab to load active report threads.</p>
              </div>
            </section>

            <section class="workspace-panel" id="panel-schedule" data-panel-key="schedule" data-mobile-collapsed="true">
              <div class="workspace-panel-head">
                <button type="button" class="schedule-mobile-toggle" aria-expanded="false" aria-controls="schedule-panel-body" onclick="toggleScheduleMobile(this)">
                  <span class="section-title">Class Schedule</span>
                  <span class="schedule-mobile-meta">
                    <span>Open</span>
                    <span class="schedule-mobile-chevron" aria-hidden="true">›</span>
                  </span>
                </button>
                <div class="schedule-panel-heading">
                  <h2 class="card-title">Class Schedule</h2>
                </div>
                <div class="schedule-toolbar" id="classScheduleToolbar"></div>
              </div>
              <div class="schedule-panel-body" id="schedule-panel-body">
                <div id="classScheduleNotice" class="schedule-notice" role="status" aria-live="polite"></div>
                <div id="classScheduleContent" class="schedule-shell">
                  <p style="color:#6b7280;font-size:13px;">Open the schedule tab to load the timetable.</p>
                </div>
              </div>
            </section>

            <section class="workspace-panel" id="panel-students" data-panel-key="students">
              <div class="workspace-panel-head">
                <div>
                  <h2 class="card-title">Students</h2>
                  <p class="card-subtext">Select a student to open a dedicated work session.</p>
                </div>
              </div>
              <div class="workspace-resource-grid">
                <% if (students.length > 0) { %>
                  <% students.forEach(function(student) { %>
                    <button class="workspace-resource-button" type="button" onclick="openStudentWorkspaceTab(<%= student.student_id %>)">
                      <span class="workspace-resource-text">
                        <strong><%= student.first_name %> <%= student.last_name %></strong>
                        <span>Open student record</span>
                      </span>
                      <span class="workspace-resource-arrow">›</span>
                    </button>
                  <% }); %>
                <% } else { %>
                  <p class="card-subtext">No students in this class yet.</p>
                <% } %>
              </div>
            </section>

            <section class="workspace-panel" id="panel-subjects" data-panel-key="subjects">
              <div class="workspace-panel-head">
                <div>
                  <h2 class="card-title">Subjects</h2>
                  <p class="card-subtext">Open a subject workspace to review assessments and records.</p>
                </div>
              </div>
              <div class="workspace-resource-grid">
                <% if (hasAssessmentFeature && subjects.length > 0) { %>
                  <% subjects.forEach(function(subject) { %>
                    <button class="workspace-resource-button" type="button" onclick="openSubjectWorkspaceTab(<%= subject.subject_id %>)">
                      <span class="workspace-resource-text">
                        <strong><%= subject.subject_name %></strong>
                        <span>Open subject workspace</span>
                      </span>
                      <span class="workspace-resource-arrow">›</span>
                    </button>
                  <% }); %>
                <% } else { %>
                  <p class="card-subtext">No subjects assigned yet.</p>
                <% } %>
              </div>
            </section>

            <div id="workspaceDynamicPanels"></div>
          </div>
        </section>

        <div class="report-modal-overlay" id="reportDetailModal">
          <div class="report-modal-box">
            <button class="report-modal-close" onclick="closeReportModal()">×</button>
            <div id="reportDetailContent">
              <p style="color:#6b7280;">Loading...</p>
            </div>
          </div>
        </div>
      </main>
    </div>
  </div>

  <script>
    var classScheduleContext;
    var classScheduleState;
    var workspaceContext;
    var workspaceState;

    (function () {
      classScheduleContext = {
        classId: Number('<%= classId %>'),
        termId: Number('<%= currentTerm.term_id %>'),
        schoolYearId: Number('<%= schoolYear.id %>'),
        schoolYearLabel: <%- JSON.stringify(schoolYear.year_label) %>,
        termName: <%- JSON.stringify(currentTerm.term_name) %>,
        className: <%- JSON.stringify(className) %>,
        schoolName: <%- JSON.stringify((session && session.organizationName) || '') %>,
        logoUrl: <%- JSON.stringify((session && session.logo) || '') %>,
        orgPrimaryColor: '',
        orgPrimaryHover: '',
        canEdit: <%= canEditClassSchedule ? 'true' : 'false' %>,
        weekdays: <%- JSON.stringify(classScheduleWeekdays || []) %>,
      };
      var classScheduleRootStyles = window.getComputedStyle(document.documentElement);
      classScheduleContext.orgPrimaryColor = classScheduleRootStyles.getPropertyValue('--org-primary-color').trim() || <%- JSON.stringify(currentTheme.primary) %>;
      classScheduleContext.orgPrimaryHover = classScheduleRootStyles.getPropertyValue('--org-primary-hover').trim() || <%- JSON.stringify(currentTheme.hover) %>;
      classScheduleState = {
        payload: <%- JSON.stringify(initialClassScheduleData || null) %>,
        draftRows: [],
        isLoadedOnce: <%= initialClassScheduleData ? 'true' : 'false' %>,
        isCreating: false,
        isEditing: false,
        pendingAction: '',
      };

      workspaceContext = {
        classId: Number('<%= classId %>'),
        termId: Number('<%= currentTerm.term_id %>'),
        className: <%- JSON.stringify(className) %>,
        basePath: <%- JSON.stringify(typeof classWorkspaceBasePath !== 'undefined' ? classWorkspaceBasePath : (`/common/classDashboard/${classId}`)) %>,
        initialRoute: <%- JSON.stringify(typeof initialWorkspaceRoute !== 'undefined' ? initialWorkspaceRoute : { panel: 'overview', itemId: '' }) %>,
        attendanceUrl: <%- JSON.stringify(`/common/attendanceCollection?classId=${classId}&termId=${currentTerm.term_id}&embed=workspace`) %>,
        docsUrl: <%- JSON.stringify(`/documents?classId=${classId}`) %>,
        paygiraUrl: <%- JSON.stringify(`/account/settings/my-paygira?embed=workspace&classId=${classId}`) %>,
        students: <%- JSON.stringify(workspaceStudents) %>,
        subjects: <%- JSON.stringify(workspaceSubjects) %>,
        canOpenAttendance: <%= hasAttendanceFeature && (userRole !== "Teacher" || isMainTeacher) ? 'true' : 'false' %>,
        canOpenSubjects: <%= hasAssessmentFeature ? 'true' : 'false' %>,
        canOpenDocs: <%= hasFilesFeature ? 'true' : 'false' %>,
      };

      workspaceState = {
        tabs: [],
        activeTabId: '',
      };

      function getWorkspacePanelsRoot() {
        return document.getElementById('workspacePanels');
      }

      function getWorkspaceDynamicPanelsRoot() {
        return document.getElementById('workspaceDynamicPanels');
      }

      function getWorkspaceTabBar() {
        return document.getElementById('workspaceTabBar');
      }

      function getWorkspaceEmptyState() {
        return document.getElementById('workspaceEmptyState');
      }

      function getWorkspaceTabById(tabId) {
        return workspaceState.tabs.find(function(tab) {
          return tab.id === tabId;
        }) || null;
      }

      function getWorkspaceTabIndex(tabId) {
        return workspaceState.tabs.findIndex(function(tab) {
          return tab.id === tabId;
        });
      }

      function getWorkspaceSidebarKey(tab) {
        if (!tab) return '';
        if (tab.sidebarKey) return tab.sidebarKey;
        if (tab.id.indexOf('student:') === 0) return 'students';
        if (tab.id.indexOf('subject:') === 0) return 'subjects';
        return tab.id;
      }

      function syncWorkspaceSidebarState(activeTab) {
        var activeSidebarKey = getWorkspaceSidebarKey(activeTab);
        Array.prototype.forEach.call(document.querySelectorAll('[data-nav-key]'), function(node) {
          node.classList.toggle('active', node.getAttribute('data-nav-key') === activeSidebarKey);
        });
      }

      function updateWorkspaceChrome() {
        var emptyState = getWorkspaceEmptyState();
        var panelsRoot = getWorkspacePanelsRoot();
        if (!emptyState || !panelsRoot) return;
        var hasTabs = workspaceState.tabs.length > 0;
        emptyState.hidden = hasTabs;
        panelsRoot.hidden = !hasTabs;
        if (!hasTabs) {
          Array.prototype.forEach.call(document.querySelectorAll('.workspace-panel'), function(panel) {
            panel.hidden = true;
            panel.classList.remove('is-active');
          });
        }
      }

      function renderWorkspaceTabBar() {
        var tabBar = getWorkspaceTabBar();
        if (!tabBar) return;
        var tabsMarkup = workspaceState.tabs.map(function(tab) {
          var isActive = tab.id === workspaceState.activeTabId;
          return '' +
            '<div class="workspace-tab' + (isActive ? ' is-active' : '') + '" role="presentation">' +
              '<button type="button" class="workspace-tab-activate" data-tab-id="' + esc(tab.id) + '" onclick="activateWorkspaceTab(this.getAttribute(\'data-tab-id\'))" role="tab" aria-selected="' + (isActive ? 'true' : 'false') + '">' +
                '<span class="workspace-tab-label">' + esc(tab.title) + '</span>' +
              '</button>' +
              '<button type="button" class="workspace-tab-close" data-tab-id="' + esc(tab.id) + '" aria-label="Close ' + esc(tab.title) + '" onclick="closeWorkspaceTab(this.getAttribute(\'data-tab-id\'))">×</button>' +
            '</div>';
        }).join('');
        tabBar.innerHTML = tabsMarkup + '<button type="button" class="workspace-tab-add" aria-label="Open another workspace tab" title="Open another workspace tab" onclick="openWorkspaceQuickAdd()">+</button>';
      }

      function showWorkspacePanel(panelId) {
        Array.prototype.forEach.call(document.querySelectorAll('.workspace-panel'), function(panel) {
          var isActive = panel.id === panelId;
          panel.hidden = !isActive;
          panel.classList.toggle('is-active', isActive);
        });
      }

      function ensureWorkspaceFramePanel(tab) {
        var root = getWorkspaceDynamicPanelsRoot();
        if (!root || document.getElementById(tab.panelId)) return;
        var panel = document.createElement('section');
        panel.className = 'workspace-panel workspace-frame-panel';
        panel.id = tab.panelId;
        panel.setAttribute('data-panel-key', tab.id);
        if (tab.noFrameHeader) {
          panel.innerHTML =
            '<div class="workspace-frame-shell">' +
              '<iframe class="workspace-frame" src="' + esc(tab.iframeSrc) + '" loading="lazy" title="' + esc(tab.title) + '"></iframe>' +
            '</div>';
        } else {
          panel.innerHTML =
            '<div class="workspace-frame-shell">' +
              '<div class="workspace-frame-header">' +
                '<div>' +
                  '<h2 class="workspace-frame-title">' + esc(tab.title) + '</h2>' +
                  '<p class="workspace-frame-subtext">' + esc(tab.panelDescription || 'Focused work session') + '</p>' +
                '</div>' +
              '</div>' +
              '<iframe class="workspace-frame" src="' + esc(tab.iframeSrc) + '" loading="lazy" title="' + esc(tab.title) + '"></iframe>' +
            '</div>';
        }
        root.appendChild(panel);
      }

      function removeWorkspaceDynamicPanel(tab) {
        if (!tab || tab.type !== 'iframe') return;
        var panel = document.getElementById(tab.panelId);
        if (panel && panel.parentNode) {
          panel.parentNode.removeChild(panel);
        }
      }

      function syncWorkspaceFramePanel(tab) {
        if (!tab || tab.type !== 'iframe') return;
        var panel = document.getElementById(tab.panelId);
        if (!panel) return;
        var hasFrameHeader = Boolean(panel.querySelector('.workspace-frame-header'));
        if (hasFrameHeader === Boolean(tab.noFrameHeader)) {
          removeWorkspaceDynamicPanel(tab);
          ensureWorkspaceFramePanel(tab);
          panel = document.getElementById(tab.panelId);
          if (!panel) return;
        }
        var iframe = panel.querySelector('.workspace-frame');
        if (iframe && iframe.getAttribute('src') !== tab.iframeSrc) {
          iframe.setAttribute('src', tab.iframeSrc);
        }
        var titleNode = panel.querySelector('.workspace-frame-title');
        if (titleNode) titleNode.textContent = tab.title;
        var subtextNode = panel.querySelector('.workspace-frame-subtext');
        if (subtextNode) subtextNode.textContent = tab.panelDescription || 'Focused work session';
      }

      function syncWorkspaceHistory(tab, options) {
        if (!tab || (options && options.skipHistory)) return;
        var targetPath = tab.routePath || workspaceContext.basePath;
        var state = {
          workspaceTabId: tab.id,
          path: targetPath,
        };
        if (options && options.replaceHistory) {
          window.history.replaceState(state, '', targetPath);
          return;
        }
        window.history.pushState(state, '', targetPath);
      }

      function activateWorkspaceTab(tabId, options) {
        var tab = getWorkspaceTabById(tabId);
        if (!tab) return;
        workspaceState.activeTabId = tab.id;
        renderWorkspaceTabBar();
        showWorkspacePanel(tab.panelId);
        updateWorkspaceChrome();
        syncWorkspaceSidebarState(tab);
        if (typeof tab.onActivate === 'function') {
          tab.onActivate(options || {});
        }
        syncWorkspaceHistory(tab, options || {});
      }

      function openWorkspaceTab(tab, options) {
        if (!tab) return null;
        var existing = getWorkspaceTabById(tab.id);
        if (existing) {
          if (tab.type === 'iframe') {
            existing.iframeSrc = tab.iframeSrc;
            existing.panelDescription = tab.panelDescription;
            existing.title = tab.title;
            existing.noFrameHeader = tab.noFrameHeader;
            syncWorkspaceFramePanel(existing);
          }
          activateWorkspaceTab(existing.id, options || {});
          return existing;
        }
        if (tab.type === 'iframe') {
          ensureWorkspaceFramePanel(tab);
        }
        workspaceState.tabs.push(tab);
        updateWorkspaceChrome();
        activateWorkspaceTab(tab.id, options || {});
        return tab;
      }

      function closeWorkspaceTab(tabId) {
        var tabIndex = getWorkspaceTabIndex(tabId);
        if (tabIndex === -1) return;
        var closingTab = workspaceState.tabs[tabIndex];
        removeWorkspaceDynamicPanel(closingTab);
        workspaceState.tabs.splice(tabIndex, 1);
        if (!workspaceState.tabs.length) {
          workspaceState.activeTabId = '';
          renderWorkspaceTabBar();
          updateWorkspaceChrome();
          syncWorkspaceSidebarState(null);
          window.history.replaceState({ workspaceTabId: '', path: workspaceContext.basePath }, '', workspaceContext.basePath);
          return;
        }
        var nextTab = workspaceState.tabs[tabIndex] || workspaceState.tabs[tabIndex - 1] || workspaceState.tabs[0];
        activateWorkspaceTab(nextTab.id, { replaceHistory: true });
      }

      function getWorkspaceOverviewTab() {
        return {
          id: 'overview',
          title: 'Overview',
          panelId: 'panel-overview',
          routePath: workspaceContext.basePath,
          sidebarKey: 'overview',
        };
      }

      function getWorkspaceReportsTab() {
        return {
          id: 'reports',
          title: 'Reports',
          panelId: 'panel-reports',
          routePath: workspaceContext.basePath + '/reports',
          sidebarKey: 'reports',
          onActivate: function() {
            loadClassReports();
          },
        };
      }

      function getWorkspaceScheduleTab() {
        return {
          id: 'schedule',
          title: 'Class Schedule',
          panelId: 'panel-schedule',
          routePath: workspaceContext.basePath + '/schedule',
          sidebarKey: 'schedule',
          onActivate: function() {
            classScheduleState.isEditing = false;
            classScheduleState.pendingAction = '';
            if (classScheduleState.payload) {
              syncDraftRowsFromPayload(classScheduleState.payload);
              renderClassSchedule();
              refreshClassScheduleInBackground();
              return;
            }
            loadClassSchedule();
          },
        };
      }

      function getWorkspaceStudentsTab() {
        return {
          id: 'students',
          title: 'Students',
          panelId: 'panel-students',
          routePath: workspaceContext.basePath + '/students',
          sidebarKey: 'students',
        };
      }

      function getWorkspaceSubjectsTab() {
        return {
          id: 'subjects',
          title: 'Subjects',
          panelId: 'panel-subjects',
          routePath: workspaceContext.basePath + '/subjects',
          sidebarKey: 'subjects',
        };
      }

      function getWorkspaceAttendanceTab() {
        if (!workspaceContext.canOpenAttendance) return getWorkspaceOverviewTab();
        return {
          id: 'attendance',
          title: 'Attendance',
          panelId: 'panel-frame-attendance',
          routePath: workspaceContext.basePath + '/attendance',
          sidebarKey: 'attendance',
          type: 'iframe',
          noFrameHeader: true,
          iframeSrc: workspaceContext.attendanceUrl,
          panelDescription: 'Attendance workspace for the current class and term.',
        };
      }

      function getWorkspaceDocsTab() {
        if (!workspaceContext.canOpenDocs) return getWorkspaceOverviewTab();
        return {
          id: 'docs',
          title: 'Docs/Sheets',
          panelId: 'panel-frame-docs',
          routePath: workspaceContext.basePath + '/docs',
          sidebarKey: 'docs',
          type: 'iframe',
          noFrameHeader: true,
          iframeSrc: workspaceContext.docsUrl,
          panelDescription: 'Class documents and sheets workspace.',
        };
      }

      function getWorkspacePaygiraTab() {
        return {
          id: 'paygira',
          title: 'My PayGira',
          panelId: 'panel-frame-paygira',
          routePath: workspaceContext.basePath + '/paygira',
          sidebarKey: 'paygira',
          type: 'iframe',
          noFrameHeader: true,
          iframeSrc: workspaceContext.paygiraUrl,
          panelDescription: 'PayGira workspace for this class collector.',
        };
      }

      function buildStudentWorkspaceTab(studentId) {
        var match = workspaceContext.students.find(function(student) {
          return String(student.id) === String(studentId);
        });
        if (!match) return null;
        return {
          id: 'student:' + match.id,
          title: match.name,
          panelId: 'panel-frame-student-' + match.id,
          routePath: workspaceContext.basePath + '/student/' + match.id,
          sidebarKey: 'students',
          type: 'iframe',
          iframeSrc: '/common/studentDetails?studentId=' + encodeURIComponent(match.id) + '&termId=' + encodeURIComponent(workspaceContext.termId) + '&classId=' + encodeURIComponent(workspaceContext.classId),
          panelDescription: 'Student workspace for ' + match.name + '.',
        };
      }

      function buildSubjectWorkspaceTab(subjectId) {
        var match = workspaceContext.subjects.find(function(subject) {
          return String(subject.id) === String(subjectId);
        });
        if (!match) return null;
        return {
          id: 'subject:' + match.id,
          title: match.name,
          panelId: 'panel-frame-subject-' + match.id,
          routePath: workspaceContext.basePath + '/subject/' + match.id,
          sidebarKey: 'subjects',
          type: 'iframe',
          noFrameHeader: true,
          iframeSrc: '/common/assessment?classId=' + encodeURIComponent(workspaceContext.classId) + '&subjectId=' + encodeURIComponent(match.id) + '&embed=workspace',
          panelDescription: 'Subject workspace for ' + match.name + '.',
        };
      }

      function openWorkspaceTabByKey(tabKey, options) {
        if (tabKey === 'overview') return openWorkspaceTab(getWorkspaceOverviewTab(), options || {});
        if (tabKey === 'reports') return openWorkspaceTab(getWorkspaceReportsTab(), options || {});
        if (tabKey === 'schedule') return openWorkspaceTab(getWorkspaceScheduleTab(), options || {});
        if (tabKey === 'students') return openWorkspaceTab(getWorkspaceStudentsTab(), options || {});
        if (tabKey === 'subjects') return openWorkspaceTab(getWorkspaceSubjectsTab(), options || {});
        if (tabKey === 'attendance') return openWorkspaceTab(getWorkspaceAttendanceTab(), options || {});
        if (tabKey === 'docs') return openWorkspaceTab(getWorkspaceDocsTab(), options || {});
        if (tabKey === 'paygira') return openWorkspaceTab(getWorkspacePaygiraTab(), options || {});
        return openWorkspaceTab(getWorkspaceOverviewTab(), options || {});
      }

      function openWorkspaceQuickAdd() {
        if (!getWorkspaceTabById('overview')) {
          openWorkspaceTabByKey('overview');
          return;
        }
        if (workspaceContext.canOpenAttendance && !getWorkspaceTabById('attendance')) {
          openWorkspaceTabByKey('attendance');
          return;
        }
        if (workspaceContext.canOpenSubjects && !getWorkspaceTabById('subjects')) {
          openWorkspaceTabByKey('subjects');
          return;
        }
        if (!getWorkspaceTabById('students')) {
          openWorkspaceTabByKey('students');
          return;
        }
        if (workspaceContext.canOpenDocs && !getWorkspaceTabById('docs')) {
          openWorkspaceTabByKey('docs');
          return;
        }
        if (!getWorkspaceTabById('paygira')) {
          openWorkspaceTabByKey('paygira');
          return;
        }
        activateWorkspaceTab('overview');
      }

      function openStudentWorkspaceTab(studentId, options) {
        var tab = buildStudentWorkspaceTab(studentId);
        if (!tab) return openWorkspaceTabByKey('students', options || {});
        return openWorkspaceTab(tab, options || {});
      }

      function openSubjectWorkspaceTab(subjectId, options) {
        var tab = buildSubjectWorkspaceTab(subjectId);
        if (!tab) return openWorkspaceTabByKey('subjects', options || {});
        return openWorkspaceTab(tab, options || {});
      }

      function parseWorkspaceRoute(pathname, search) {
        var normalizedPath = String(pathname || '').replace(/\/+$/, '');
        var basePath = String(workspaceContext.basePath || '').replace(/\/+$/, '');
        if (!normalizedPath || normalizedPath === basePath) {
          return { panel: 'overview', itemId: '' };
        }
        if (normalizedPath.indexOf(basePath + '/') !== 0) {
          return null;
        }

        var trailingPath = normalizedPath.slice(basePath.length + 1);
        var segments = trailingPath.split('/').filter(Boolean);
        if (!segments.length) {
          return { panel: 'overview', itemId: '' };
        }
        if (segments[0] === 'student' && segments[1]) {
          return { panel: 'student', itemId: segments[1] };
        }
        if (segments[0] === 'subject' && segments[1]) {
          return { panel: 'subject', itemId: segments[1] };
        }
        if (segments[0] === 'reports') {
          var params = new URLSearchParams(search || '');
          var reportId = params.get('reportId') || '';
          return reportId ? { panel: 'report-detail', itemId: reportId } : { panel: 'reports', itemId: '' };
        }
        return { panel: segments[0], itemId: segments[1] || '' };
      }

      function openWorkspaceRoute(route, options) {
        var safeRoute = route || { panel: 'overview', itemId: '' };
        var safeOptions = options || {};
        if (safeRoute.panel === 'attendance') return openWorkspaceTabByKey('attendance', safeOptions);
        if (safeRoute.panel === 'reports') return openWorkspaceTabByKey('reports', safeOptions);
        if (safeRoute.panel === 'report-detail') {
          openWorkspaceTabByKey('reports', safeOptions);
          if (safeRoute.itemId) openReportDetail(Number(safeRoute.itemId));
          return;
        }
        if (safeRoute.panel === 'schedule') return openWorkspaceTabByKey('schedule', safeOptions);
        if (safeRoute.panel === 'students') return openWorkspaceTabByKey('students', safeOptions);
        if (safeRoute.panel === 'subjects') return openWorkspaceTabByKey('subjects', safeOptions);
        if (safeRoute.panel === 'paygira') return openWorkspaceTabByKey('paygira', safeOptions);
        if (safeRoute.panel === 'student' && safeRoute.itemId) return openStudentWorkspaceTab(safeRoute.itemId, safeOptions);
        if (safeRoute.panel === 'subject' && safeRoute.itemId) return openSubjectWorkspaceTab(safeRoute.itemId, safeOptions);
        if (safeRoute.panel === 'docs') return openWorkspaceTabByKey('docs', safeOptions);
        return openWorkspaceTabByKey('overview', safeOptions);
      }

      function handleWorkspacePopState() {
        var route = parseWorkspaceRoute(window.location.pathname, window.location.search);
        if (!route) return;
        openWorkspaceRoute(route, { skipHistory: true });
      }

      window.openWorkspaceTabByKey = openWorkspaceTabByKey;
      window.openStudentWorkspaceTab = openStudentWorkspaceTab;
      window.openSubjectWorkspaceTab = openSubjectWorkspaceTab;
      window.openWorkspaceQuickAdd = openWorkspaceQuickAdd;
      window.activateWorkspaceTab = activateWorkspaceTab;
      window.closeWorkspaceTab = closeWorkspaceTab;

      window.toggleTeachersMobile = function (btn) {
        var section = btn.closest('.teacher-section');
        if (!section) return;
        var collapsed = section.getAttribute('data-collapsed') === 'true';
        section.setAttribute('data-collapsed', collapsed ? 'false' : 'true');
        btn.setAttribute('aria-expanded', collapsed ? 'true' : 'false');
      };

      window.toggleScheduleMobile = function (btn) {
        var section = btn.closest('#panel-schedule');
        if (!section) return;
        var collapsed = section.getAttribute('data-mobile-collapsed') === 'true';
        section.setAttribute('data-mobile-collapsed', collapsed ? 'false' : 'true');
        btn.setAttribute('aria-expanded', collapsed ? 'true' : 'false');
      };

      window.toggleWorkspaceMeta = function (btn) {
        var card = btn.closest('.workspace-header-card');
        if (!card) return;
        var collapsed = card.getAttribute('data-meta-collapsed') === 'true';
        card.setAttribute('data-meta-collapsed', collapsed ? 'false' : 'true');
        btn.setAttribute('aria-expanded', collapsed ? 'true' : 'false');
      };

      window.setMainEmployee = function (classId, userId) {
        const confirmationMessage = "Are you sure you want to set this teacher as the main teacher for this class? The main teacher will have full access and is the only teacher who can mark attendance.";
        if (!confirm(confirmationMessage)) return;

        fetch('/common/setMainEmployee', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ class_id: classId, main_employee: userId })
        })
          .then(response => response.json())
          .then(data => {
            if (data.success) {
              alert('Main class teacher set successfully');
            } else {
              alert('Failed to set main class teacher');
            }
          })
          .catch(error => {
            console.error('Error:', error);
            alert('Error setting main employee');
          });
      };

      function initClassDashboard() {
        const navToggle = document.querySelector('.nav-toggle');
        const navPanel = document.getElementById('class-tools-panel');
        const navOverlay = document.getElementById('class-tools-overlay');
        const navClose = document.querySelector('.nav-close');
        const navLinks = document.querySelectorAll('.nav-link');
        const classInfoSection = document.getElementById('class-info-section');
        const classInfoToggle = document.getElementById('class-info-toggle');
        const classInfoContent = document.getElementById('class-info-content');
        const teachersSection = document.getElementById('teachers-section');
        const teachersToggle = document.getElementById('teachers-toggle');
        const teachersContent = document.getElementById('teachers-content');

        function openNav() {
          if (navPanel) navPanel.classList.add('open');
          if (navOverlay) navOverlay.classList.add('show');
        }

        function closeNav() {
          if (navPanel) navPanel.classList.remove('open');
          if (navOverlay) navOverlay.classList.remove('show');
        }

        function setTeachersOpen(isOpen) {
          if (!teachersSection || !teachersToggle || !teachersContent) return;
          teachersSection.classList.toggle('open', isOpen);
          teachersToggle.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
          teachersContent.hidden = !isOpen;
        }

        function isSmallScreen() {
          return window.matchMedia('(max-width: 960px)').matches;
        }

        function setClassInfoOpen(isOpen) {
          if (!classInfoSection || !classInfoToggle || !classInfoContent) return;
          classInfoSection.classList.toggle('open', isOpen);
          classInfoToggle.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
          classInfoContent.hidden = !isOpen;
        }

        function syncClassInfoForViewport() {
          if (!classInfoSection || !classInfoToggle || !classInfoContent) return;
          if (isSmallScreen()) {
            setClassInfoOpen(false);
          } else {
            setClassInfoOpen(true);
          }
        }

        if (navToggle && !navToggle.dataset.boundNavToggle) {
          navToggle.dataset.boundNavToggle = '1';
          navToggle.addEventListener('click', openNav);
        }
        if (navOverlay && !navOverlay.dataset.boundNavOverlay) {
          navOverlay.dataset.boundNavOverlay = '1';
          navOverlay.addEventListener('click', closeNav);
        }
        if (navClose && !navClose.dataset.boundNavClose) {
          navClose.dataset.boundNavClose = '1';
          navClose.addEventListener('click', closeNav);
        }
        if (navLinks && navLinks.length) {
          navLinks.forEach(link => {
            if (!link.dataset.boundNavLinkClose) {
              link.dataset.boundNavLinkClose = '1';
              link.addEventListener('click', closeNav);
            }
          });
        }

        if (classInfoToggle) {
          syncClassInfoForViewport();
          if (!classInfoToggle.dataset.boundClassInfoToggle) {
            classInfoToggle.dataset.boundClassInfoToggle = '1';
            classInfoToggle.addEventListener('click', () => {
              if (!isSmallScreen()) return;
              const isOpen = classInfoToggle.getAttribute('aria-expanded') === 'true';
              setClassInfoOpen(!isOpen);
            });
          }

          if (window.__classDashboardResizeHandler) {
            window.removeEventListener('resize', window.__classDashboardResizeHandler);
          }
          window.__classDashboardResizeHandler = syncClassInfoForViewport;
          window.addEventListener('resize', window.__classDashboardResizeHandler);
        }

        if (teachersToggle) {
          setTeachersOpen(false);
          if (!teachersToggle.dataset.boundTeachersToggle) {
            teachersToggle.dataset.boundTeachersToggle = '1';
            teachersToggle.addEventListener('click', () => {
              const isOpen = teachersToggle.getAttribute('aria-expanded') === 'true';
              setTeachersOpen(!isOpen);
            });
          }
        }
      }

      initClassDashboard();
      openWorkspaceRoute(workspaceContext.initialRoute || { panel: 'overview', itemId: '' }, { replaceHistory: true });
      if (!window.__classWorkspacePopstateBound) {
        window.__classWorkspacePopstateBound = true;
        window.addEventListener('popstate', handleWorkspacePopState);
      }
    })();

    // --- Sidebar Subjects collapsible ---
    function toggleSubjectsNavSection(e) {
      if (e) e.preventDefault();
      var btn = document.getElementById('subjects-section-toggle');
      var list = document.getElementById('subjects-section-list');
      if (!btn || !list) return;
      var isOpen = btn.getAttribute('aria-expanded') === 'true';
      btn.setAttribute('aria-expanded', isOpen ? 'false' : 'true');
      if (isOpen) { list.setAttribute('hidden', ''); } else { list.removeAttribute('hidden'); }
    }

    // --- Reports Panel ---
    function toggleReportsPanel(e) {
      if (e) e.preventDefault();
      openWorkspaceTabByKey('reports');
    }
    function closeReportsListModal() {
      closeWorkspaceTab('reports');
    }

    function loadClassReports() {
      var container = document.getElementById('reports-list-content');
      container.innerHTML = '<p style="color:#6b7280;font-size:13px;">Loading reports...</p>';
      fetch('/common/classReports?classId=<%= classId %>')
        .then(function(r) { return r.json(); })
        .then(function(d) {
          if (!d.success || !d.reports || !d.reports.length) {
