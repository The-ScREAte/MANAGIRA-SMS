            panel.classList.remove('open');
            const overlay = document.getElementById('class-tools-overlay');
            if (overlay) overlay.classList.remove('show');
            const toggle = document.querySelector('.nav-toggle');
            if (toggle) {
              toggle.setAttribute('aria-expanded', 'false');
              toggle.setAttribute('aria-label', 'Open Class Tools');
            }
          }, true);
        }

        if (!window.__classDashboardMenuEscapeBound) {
          window.__classDashboardMenuEscapeBound = true;
          document.addEventListener('keydown', function (event) {
            if (event.key !== 'Escape') return;
            const panel = document.getElementById('class-tools-panel');
            if (!panel || !panel.classList.contains('open')) return;
            panel.classList.remove('open');
            const overlay = document.getElementById('class-tools-overlay');
            if (overlay) overlay.classList.remove('show');
            const toggle = document.querySelector('.nav-toggle');
            if (toggle) {
              toggle.setAttribute('aria-expanded', 'false');
              toggle.setAttribute('aria-label', 'Open Class Tools');
              toggle.focus();
            }
          });
        }

        function setTeachersOpen(isOpen) {
          if (!teachersSection || !teachersToggle || !teachersContent) return;
          teachersSection.classList.toggle('open', isOpen);
          teachersToggle.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
          teachersContent.hidden = !isOpen;
        }

        function isSmallScreen() {
          return window.matchMedia('(max-width: 960px)').matches;
        }

        function setClassInfoOpen(isOpen) {
          if (!classInfoSection || !classInfoToggle || !classInfoContent) return;
          classInfoSection.classList.toggle('open', isOpen);
          classInfoToggle.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
          classInfoContent.hidden = !isOpen;
        }

        function syncClassInfoForViewport() {
          if (!classInfoSection || !classInfoToggle || !classInfoContent) return;
          if (isSmallScreen()) {
            setClassInfoOpen(false);
          } else {
            setClassInfoOpen(true);
          }
        }

        if (navToggle && !navToggle.dataset.boundNavToggle) {
          navToggle.dataset.boundNavToggle = '1';
          navToggle.addEventListener('click', function () {
            if (navPanel && navPanel.classList.contains('open')) closeNav();
            else openNav();
          });
        }
        if (navOverlay && !navOverlay.dataset.boundNavOverlay) {
          navOverlay.dataset.boundNavOverlay = '1';
          navOverlay.addEventListener('click', closeNav);
        }
        if (navClose && !navClose.dataset.boundNavClose) {
          navClose.dataset.boundNavClose = '1';
          navClose.addEventListener('click', closeNav);
        }
        if (navLinks && navLinks.length) {
          navLinks.forEach(link => {
            if (link.classList.contains('nav-section-toggle') || link.id === 'subjects-section-toggle') {
              return;
            }

            if (!link.dataset.boundNavLinkClose) {
              link.dataset.boundNavLinkClose = '1';
              link.addEventListener('click', () => {
                if (!isSmallScreen()) return;
                closeNav();
              });
            }
          });
        }

        if (navSublinks && navSublinks.length) {
          navSublinks.forEach(link => {
            if (!link.dataset.boundNavSublinkClose) {
              link.dataset.boundNavSublinkClose = '1';
              link.addEventListener('click', () => {
                if (!isSmallScreen()) return;
                closeNav();
              });
            }
          });
        }

        if (classInfoToggle) {
          syncClassInfoForViewport();
          if (!classInfoToggle.dataset.boundClassInfoToggle) {
            classInfoToggle.dataset.boundClassInfoToggle = '1';
            classInfoToggle.addEventListener('click', () => {
              if (!isSmallScreen()) return;
              const isOpen = classInfoToggle.getAttribute('aria-expanded') === 'true';
              setClassInfoOpen(!isOpen);
            });
          }

          if (window.__classDashboardResizeHandler) {
            window.removeEventListener('resize', window.__classDashboardResizeHandler);
          }
          window.__classDashboardResizeHandler = syncClassInfoForViewport;
          window.addEventListener('resize', window.__classDashboardResizeHandler);
        }

        if (teachersToggle) {
          setTeachersOpen(false);
          if (!teachersToggle.dataset.boundTeachersToggle) {
            teachersToggle.dataset.boundTeachersToggle = '1';
            teachersToggle.addEventListener('click', () => {
              const isOpen = teachersToggle.getAttribute('aria-expanded') === 'true';
              setTeachersOpen(!isOpen);
            });
          }
        }
      }

      initClassDashboard();

      // The tab pane and the menu card beside it both reach the bottom of the window, so they're
      // always the same height (pages are zoomed on wide screens, so the measured space is turned
      // back into page pixels). Measured again whenever anything above them changes size (the
      // class banner opening, the tab bar wrapping, the header), not only when the window does.
      function fitWorkspaceStage() {
        var stage = document.querySelector('.workspace-stage');
        if (!stage) return;
        var zoom = parseFloat(getComputedStyle(document.documentElement).zoom) || 1;
        var gap = 16;
        var top = stage.getBoundingClientRect().top + window.scrollY;
        var fill = Math.max(360, Math.floor((window.innerHeight - top - gap) / zoom)) + 'px';
        if (stage.style.getPropertyValue('--stage-fill') !== fill) stage.style.setProperty('--stage-fill', fill);
        var side = document.querySelector('.workspace-sidebar');
        var grid = document.querySelector('.workspace-grid');
        if (!side || !grid) return;
        if (window.matchMedia('(min-width: 961px)').matches) {
          // The menu sticks just under the header. Sticky offsets count from where the scrolling
          // box's content starts, and that box may already leave room for the header (the body
          // does, with its top padding): measure, so the menu never sits a header-height too low.
          var scroller = side.parentElement;
          while (scroller && scroller !== document.documentElement && !/(auto|scroll|overlay)/.test(getComputedStyle(scroller).overflowY)) scroller = scroller.parentElement;
          var contentTop = 0;
          if (scroller && scroller !== document.documentElement && scroller !== document.scrollingElement) {
            contentTop = scroller.getBoundingClientRect().top + (parseFloat(getComputedStyle(scroller).paddingTop) || 0) * zoom;
          }
          var headerEl = document.getElementById('top-header');
          var headerBottom = headerEl ? Math.max(0, headerEl.getBoundingClientRect().bottom) : 0;
          var stickTop = Math.max(0, Math.round((headerBottom + 8 - contentTop) / zoom)) + 'px';
          if (side.style.top !== stickTop) side.style.top = stickTop;
          // From the grid's top (the menu is sticky, so its own position moves when the page scrolls).
          var sideTop = grid.getBoundingClientRect().top + window.scrollY;
          var sideFill = Math.max(240, Math.floor((window.innerHeight - sideTop - gap) / zoom)) + 'px';
          if (side.style.getPropertyValue('--side-fill') !== sideFill) side.style.setProperty('--side-fill', sideFill);
        } else {
          if (side.style.getPropertyValue('--side-fill')) side.style.removeProperty('--side-fill'); // a drawer below 961px
          if (side.style.top) side.style.top = '';
        }
      }
      fitWorkspaceStage();
      if (!window.__workspaceStageFitBound) {
        window.__workspaceStageFitBound = true;
        var fitQueued = false;
        var queueFit = function () {
          if (fitQueued) return;
          fitQueued = true;
          requestAnimationFrame(function () { fitQueued = false; fitWorkspaceStage(); });
        };
        window.addEventListener('resize', queueFit);
        window.addEventListener('load', queueFit);
        if (document.fonts && document.fonts.ready) document.fonts.ready.then(queueFit);
        if (window.ResizeObserver) {
          // Settling: a size set here changes nothing the second time, so this never loops.
          var fitObserver = new ResizeObserver(queueFit);
          ['#top-header', '.workspace-main', '.workspace-grid'].forEach(function (sel) {
            var el = document.querySelector(sel);
            if (el) fitObserver.observe(el);
          });
          window.__workspaceFitObserver = fitObserver;
        }
      }
      // A plain visit opens the top item of the person's own menu order.
      var initialRoute = workspaceContext.initialRoute || { panel: 'overview', itemId: '' };
      var arrangedTop = initialRoute.isDefault && window.ManagiraMenuArrange ? ManagiraMenuArrange.topItem(document.getElementById('ctNavList')) : null;
      if (arrangedTop) initialRoute = { panel: arrangedTop.key === 'grading' ? 'subjects' : arrangedTop.key, itemId: '' };
      openWorkspaceRoute(initialRoute, { replaceHistory: true });
      if (!window.__classWorkspacePopstateBound) {
        window.__classWorkspacePopstateBound = true;
        window.addEventListener('popstate', handleWorkspacePopState);
      }
    })();

    // --- Sidebar Subjects collapsible ---
    function toggleSubjectsNavSection(e) {
      if (e) e.preventDefault();
      var btn = document.getElementById('subjects-section-toggle');
      var list = document.getElementById('subjects-section-list');
      if (!btn || !list) return;
      var isOpen = btn.getAttribute('aria-expanded') === 'true';
      btn.setAttribute('aria-expanded', isOpen ? 'false' : 'true');
      if (isOpen) { list.setAttribute('hidden', ''); } else { list.removeAttribute('hidden'); }
    }

    // --- Reports Panel ---
    function toggleReportsPanel(e) {
      if (e) e.preventDefault();
      openWorkspaceTabByKey('reports');
    }
    function closeReportsListModal() {
      closeWorkspaceTab('reports');
    }

    function loadClassReports() {
      var container = document.getElementById('reports-list-content');
      container.innerHTML = '<p style="color:#6b7280;font-size:13px;">Loading reports...</p>';
      fetch('/common/classReports?classId=<%= classId %>')
        .then(function(r) { return r.json(); })
        .then(function(d) {
          if (!d.success || !d.reports || !d.reports.length) {
            container.innerHTML = '<div class="rp-empty">No reports yet.</div>';
            return;
          }
          var html = '';
          d.reports.forEach(function(r) {
            var replyLabel = (r.reply_count == 1) ? '1 reply' : (r.reply_count || 0) + ' replies';
            html += '<div class="rp-card" data-onclick="common-classDashboard.reportDetail" data-mga0="' + r.report_id + '">' +
              '<div class="rp-left">' +
                '<div class="rp-subject">' + esc(r.subject) + '</div>' +
                '<div class="rp-meta">' +
                  '<span>' + esc(r.student_name) + '</span>' +
                  '<span class="rp-dot"></span>' +
                  '<span>' + esc(r.guardian_name) + '</span>' +
                  '<span class="rp-dot"></span>' +
                  '<span>' + formatDashboardDate(r.created_at) + '</span>' +
                '</div>' +
              '</div>' +
              '<div class="rp-right">' +
                '<span class="rp-replies">💬 ' + replyLabel + '</span>' +
              '</div>' +
            '</div>';
          });
          container.innerHTML = html;
        })
        .catch(function() {
          container.innerHTML = '<div class="rp-empty" style="color:#e74c3c;">Failed to load reports.</div>';
        });
    }

    function esc(s) {
      if (!s) return '';
      var d = document.createElement('div');
      d.textContent = s;
      return d.innerHTML;
    }

    function formatDashboardDate(dateValue) {
      if (!dateValue) return '';
      var parsedDate = new Date(dateValue);
      if (Number.isNaN(parsedDate.getTime())) return '';
      if (typeof formatDisplayDate === 'function') return formatDisplayDate(parsedDate);
      return parsedDate.toLocaleDateString();
    }

    function formatScheduleTime(timeValue) {
      if (!timeValue) return '';
      var parts = String(timeValue).split(':');
      if (parts.length < 2) return String(timeValue);
      var hour = Number(parts[0]);
      var minute = parts[1];
      if (!Number.isFinite(hour)) return String(timeValue);
      var suffix = hour >= 12 ? 'PM' : 'AM';
      var displayHour = hour % 12;
      if (displayHour === 0) displayHour = 12;
      return String(displayHour) + ':' + minute + ' ' + suffix;
    }

    var currentStaffUserId = Number('<%= Number((req.session && (req.session.userId || (req.session.user && req.session.user.user_id))) || 0) %>');
</script>
<script src="<%= assetUrl('/js/classDashboard.part1.js') %>"></script>
<script src="<%= assetUrl('/js/assessmentFlow.js') %>" defer></script>
</body>
<script src="<%= locals.assetUrl ? assetUrl('/js/mgActions.js') : '/js/mgActions.js' %>"></script>
