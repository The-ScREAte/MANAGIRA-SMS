<%
  const themeColor = (typeof session !== 'undefined' && session && session.themeColor) ? session.themeColor : 'teal';
  const themeColors = {
    teal: { primary: '#01535b', hover: '#014a51' },
    blue: { primary: '#2563eb', hover: '#1d4ed8' },
    green: { primary: '#2d5f4f', hover: '#245043' },
    purple: { primary: '#7c3aed', hover: '#6d28d9' },
    indigo: { primary: '#4f46e5', hover: '#4338ca' },
    rose: { primary: '#8b2635', hover: '#7a212e' },
    amber: { primary: '#d97706', hover: '#b45309' },
    slate: { primary: '#334155', hover: '#1e293b' }
  };
  const currentTheme = themeColors[themeColor] || themeColors.teal;
%>
<style>
:root {
  --border: #e5e7eb;
  --muted: #6b7280;
  --bg: #f9fafb;
  --primary: <%= currentTheme.primary %>;
  --primary-hover: <%= currentTheme.hover %>;
  --text: #111827;
  --font-family: "<%= (session && session.fontStyle ? String(session.fontStyle).trim() : 'Inter') %>", sans-serif;
}

body {
  background: var(--bg);
  font-family: var(--font-family);
  min-height: 100vh;
  display: flex;
  flex-direction: column;
}

main {
  flex: 1 0 auto;
  width: 100%;
}

.dashboard-shell {
  max-width: 1200px;
  margin: 0 auto;
  padding: 20px 16px 40px;
  width: 100%;
  flex: 1 0 auto;
}

.dashboard-grid {
  display: grid;
  grid-template-columns: 260px 1fr;
  gap: 24px;
  align-items: start;
}

.card {
  background: #fff;
  border: 1px solid var(--border);
  border-radius: 12px;
  box-shadow: 0 8px 24px rgba(15, 23, 42, 0.04);
}

.card-header {
  padding: 16px;
  border-bottom: 1px solid var(--border);
}

.card-body {
  padding: 16px;
}

.dashboard-main {
  background: transparent;
  border: none;
  box-shadow: none;
}

.dashboard-header {
  padding: 8px 4px 12px;
}

.dashboard-content {
  padding: 0;
}

.page-title {
  margin: 0;
  font-size: 28px;
  font-weight: 700;
  color: var(--text);
}

.card-title {
  margin: 0;
  font-size: 18px;
  font-weight: 700;
  color: var(--text);
}

.card-subtext {
  margin: 4px 0 0;
  color: var(--muted);
  font-size: 13px;
}

.eyebrow {
  margin: 0;
  text-transform: uppercase;
  letter-spacing: 0.06em;
  color: var(--muted);
  font-size: 11px;
  font-weight: 600;
}

.nav-card {
  padding: 14px 12px 16px;
  position: sticky;
  top: 80px;
  border-radius: 14px;
  border: 1px solid var(--border);
  box-shadow: 0 10px 26px rgba(15, 23, 42, 0.08);
}


.nav-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 4px 8px;
  margin: 4px 4px 10px;
  border-bottom: 1px solid var(--border);
}

.nav-header h3 {
  margin: 4px 0 0;
  font-size: 18px;
  color: var(--primary);
  font-weight: 700;
}

.nav-close {
  display: none;
  background: transparent;
  border: none;
  font-size: 22px;
  cursor: pointer;
  padding: 0;
  color: #6b7280;
  line-height: 1;
}

.side-nav {
  padding: 4px 2px;
  text-align: left;
}

.nav-list {
  list-style: none;
  padding: 0;
  margin: 0;
  display: grid;
  gap: 4px;
  justify-items: start;
}

.nav-section-label {
  margin: 8px 2px 0;
  color: var(--muted);
  font-size: 12px;
  font-weight: 600;
}

.nav-link {
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 10px 12px;
  border-radius: 10px;
  color: var(--text);
  text-decoration: none;
  border: 1px solid transparent;
  background: transparent;
  cursor: pointer;
  font: inherit;
  font-weight: 600;
  font-size: 14px;
  text-align: left;
  transition: all 0.2s ease;
}

.files-link-inline {
  display: inline-flex;
  align-items: center;
  gap: 8px;
}

.files-badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 20px;
  height: 20px;
  padding: 0 7px;
  border-radius: 999px;
  font-size: 11px;
  font-weight: 700;
  color: #fff;
  background: var(--org-primary-color);
}

.nav-link:hover {
  background: #f3f4f6;
  border-color: #e5e7eb;
}

.nav-link.active {
  background: var(--primary);
  border-color: var(--primary);
  color: #fff;
}

.nav-toggle {
  display: none;
  align-items: center;
  gap: 8px;
  padding: 10px 12px;
  border-radius: 10px;
  border: 1px solid var(--border);
  background: #fff;
  cursor: pointer;
  font: inherit;
  margin-bottom: 12px;
}

.hamburger-icon {
  position: relative;
  width: 16px;
  height: 2px;
  background: #111827;
  display: inline-block;
}

.hamburger-icon::before,
.hamburger-icon::after {
  content: "";
  position: absolute;
  left: 0;
  width: 16px;
  height: 2px;
  background: #111827;
}

.hamburger-icon::before { top: -5px; }
.hamburger-icon::after { top: 5px; }

.nav-overlay {
  position: fixed;
  inset: 0;
  background: rgba(17, 24, 39, 0.35);
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.2s ease;
  z-index: 998;
}

.nav-overlay.show {
  opacity: 1;
  pointer-events: auto;
}

.meta-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
  gap: 12px;
}

.meta-tile {
  padding: 12px;
  border: 1px solid var(--border);
  border-radius: 10px;
  background: #f9fafb;
}

.meta-label { color: var(--muted); font-size: 12px; margin: 0 0 4px; }
.meta-value { margin: 0; font-weight: 600; color: var(--text); }

.section-card {
  border: 1px solid var(--border);
  border-radius: 12px;
  padding: 14px;
  margin-top: 16px;
  background: #fff;
  box-shadow: 0 2px 8px rgba(15, 23, 42, 0.03);
}

.dashboard-content > .section-card:first-child {
  margin-top: 0;
}

.section-title {
  margin: 0 0 6px;
  font-weight: 600;
  color: var(--text);
}

.section-toggle {
  width: 100%;
  border: none;
  background: transparent;
  padding: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  cursor: pointer;
  text-align: left;
}

.section-toggle:hover,
.section-toggle:active,
.section-toggle:focus,
.section-toggle:focus-visible {
  background: transparent !important;
  color: inherit;
  box-shadow: none;
}

.section-toggle .section-title {
  margin: 0;
}

.section-toggle-icon {
  color: var(--muted);
  font-size: 24px;
  line-height: 1;
  transition: transform 0.2s ease, color 0.2s ease;
}

.teacher-section.open .section-toggle-icon,
.class-info-section.open .section-toggle-icon {
  transform: rotate(90deg);
  color: var(--text);
}

.section-collapse {
  padding-top: 10px;
}

.class-info-toggle {
  display: none;
}

.class-info-section .section-collapse {
  padding-top: 0;
}

.section-subtext {
  margin: 0 0 10px;
  color: var(--muted);
  font-size: 13px;
}

.teacher-list {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
  gap: 10px;
}

.teacher-card {
  border: 1px solid var(--border);
  border-radius: 10px;
  padding: 10px 12px;
  display: flex;
  align-items: center;
  gap: 10px;
  background: #fff;
}

.teacher-dot {
  width: 10px;
  height: 10px;
  border-radius: 50%;
  background: var(--primary);
}

.teacher-name {
  font-weight: 600;
  color: var(--text);
}

.student-list {
  list-style: none;
  padding: 0;
  margin: 0;
  display: flex;
  flex-direction: column;
  gap: 0;
}

.student-list li {
  border-bottom: 1px solid var(--border);
}

.student-list li:last-child {
  border-bottom: none;
}

.student-row {
  display: flex;
  align-items: center;
  gap: 6px;
  padding: 6px 2px;
}

.student-index {
  color: var(--muted);
  font-size: 12px;
  font-weight: 600;
  min-width: 24px;
}

.student-link {
  color: var(--primary);
  text-decoration: none;
  font-weight: 600;
}

.student-link:hover { color: var(--primary-hover); }

.students-section {
  padding: 10px 12px;
}

.students-section .section-title {
  margin: 0 0 2px;
}

.students-section .student-list {
  margin: 0;
}

.students-section .student-list li {
  margin: 0;
  padding: 0;
}

.students-section .student-row {
  gap: 4px;
  padding: 4px 0;
}

.students-section .student-index {
  min-width: 18px;
}

@media (max-width: 960px) {
  .dashboard-grid { grid-template-columns: 1fr; }
  .nav-toggle {
    display: inline-flex;
    position: sticky;
    top: 8px;
    z-index: 900;
  }
  .nav-card {
    position: fixed;
    top: 72px;
    left: 0;
    width: 300px;
    max-width: 85vw;
    height: auto;
    max-height: calc(100vh - 120px);
    padding: 26px 20px 20px;
    border-radius: 0 14px 14px 0;
    overflow-y: auto;
    transform: translateX(-110%);
    transition: transform 0.25s ease;
    z-index: 999;
    box-shadow: 0 10px 26px rgba(15, 23, 42, 0.08);
  }
  .nav-header {
    position: relative;
    padding: 0 0 12px;
    margin: 0 0 14px;
    border-bottom: 1px solid var(--border);
  }
  .nav-close {
    display: inline-flex;
    position: absolute;
    top: -2px;
    right: 0;
    width: 28px;
    height: 28px;
    padding: 0;
    line-height: 1;
  }
  .side-nav { padding: 0; }
  .nav-list { gap: 4px; }
  .class-info-toggle { display: flex; }
  .class-info-section .section-collapse { padding-top: 10px; }
  .nav-card.open { transform: translateX(0); }
  .nav-close { display: inline-flex; }
  .dashboard-shell { padding-top: 12px; }
}

@media (max-width: 768px) {
  body {
    padding-bottom: 0 !important;
  }
}

/* Report panel - list cards */
.rp-card {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12px 14px;
  border: 1px solid var(--border);
  border-radius: 10px;
  margin-bottom: 8px;
  cursor: pointer;
  text-decoration: none;
  color: inherit;
  background: #fff;
  transition: border-color 0.2s, box-shadow 0.2s;
  gap: 12px;
}
.rp-card:hover {
  border-color: var(--primary);
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.06);
}
.rp-left { flex: 1; min-width: 0; }
.rp-subject {
  font-weight: 600;
  font-size: 14px;
  color: var(--text);
  margin: 0 0 4px;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.rp-meta {
  font-size: 12px;
  color: var(--muted);
  display: flex;
  gap: 6px;
  flex-wrap: wrap;
  align-items: center;
}
.rp-meta span { display: inline-flex; align-items: center; gap: 3px; }
.rp-meta .rp-dot { width: 3px; height: 3px; border-radius: 50%; background: #cbd5e1; flex-shrink: 0; }
.rp-right { display: flex; align-items: center; gap: 10px; flex-shrink: 0; }
.rp-status {
  padding: 3px 10px;
  border-radius: 20px;
  font-size: 11px;
  font-weight: 600;
  text-transform: capitalize;
  white-space: nowrap;
  letter-spacing: 0.02em;
}
.rp-status-open { background: #fef3c7; color: #b45309; }
.rp-status-in_progress { background: #dbeafe; color: #1d4ed8; }
.rp-status-resolved { background: #d1fae5; color: #047857; }
.rp-status-closed { background: #f3f4f6; color: #6b7280; }
.rp-status-pending { background: #fef3c7; color: #b45309; }
.rp-replies {
  font-size: 12px;
  color: var(--muted);
  white-space: nowrap;
  display: inline-flex;
  align-items: center;
  gap: 4px;
}
.rp-empty {
  text-align: center;
  padding: 32px 16px;
  color: var(--muted);
  font-size: 14px;
}
.rp-panel-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 14px;
  padding-bottom: 10px;
  border-bottom: 1px solid var(--border);
}
.rp-panel-title {
  font-size: 16px;
  font-weight: 700;
  color: var(--text);
  margin: 0;
  display: flex;
  align-items: center;
  gap: 8px;
}
.rp-panel-close {
  background: none;
  border: 1px solid var(--border);
  border-radius: 8px;
  width: 32px;
  height: 32px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 18px;
  cursor: pointer;
  color: var(--muted);
  transition: all 0.15s;
}
.rp-panel-close:hover {
  background: #f3f4f6;
  color: var(--text);
  border-color: #d1d5db;
}

/* Report detail modal */
.report-modal-overlay {
  display: none;
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 1100;
  justify-content: center;
  align-items: flex-start;
  padding: 80px 16px 40px;
  overflow-y: auto;
  backdrop-filter: blur(2px);
}
.report-modal-overlay.active { display: flex; }
.report-modal-box {
  background: #fff;
  border-radius: 14px;
  width: 100%;
  max-width: 640px;
  padding: 0;
  box-shadow: 0 20px 60px rgba(0, 0, 0, 0.2), 0 0 0 1px rgba(0, 0, 0, 0.05);
  position: relative;
  max-height: calc(100vh - 120px);
  overflow-y: auto;
  animation: modalSlideIn 0.2s ease-out;
}
@keyframes modalSlideIn {
  from { opacity: 0; transform: translateY(-12px); }
  to { opacity: 1; transform: translateY(0); }
}
.report-modal-close {
  position: sticky;
  top: 0;
  float: right;
  margin: 14px 14px 0 0;
  background: #f3f4f6;
  border: 1px solid var(--border);
  border-radius: 8px;
  width: 32px;
  height: 32px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 18px;
  cursor: pointer;
  color: var(--muted);
  line-height: 1;
  z-index: 2;
  transition: all 0.15s;
}
.report-modal-close:hover {
  background: #e5e7eb;
  color: var(--text);
}

/* Report detail content */
.rd-modal-body { padding: 20px 24px 24px; }
.rd-title {
  font-size: 18px;
  font-weight: 700;
  color: var(--text);
  margin: 0 0 14px;
  line-height: 1.35;
}
.rd-info-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
  gap: 10px;
  margin-bottom: 16px;
  padding: 14px;
  background: #f9fafb;
  border: 1px solid var(--border);
  border-radius: 10px;
}
.rd-info-item {}
.rd-info-label {
  font-size: 11px;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.04em;
  color: var(--muted);
  margin: 0 0 2px;
}
.rd-info-value {
  font-size: 13px;
  font-weight: 600;
  color: var(--text);
  margin: 0;
}
.rd-badge {
  display: inline-block;
  padding: 3px 10px;
  border-radius: 20px;
  font-size: 11px;
  font-weight: 600;
  text-transform: capitalize;
  letter-spacing: 0.02em;
}
.rd-priority-urgent { background: #fef2f2; color: #dc2626; }
.rd-priority-high { background: #fff7ed; color: #c2410c; }
.rd-priority-normal { background: #eff6ff; color: #2563eb; }
.rd-priority-low { background: #f9fafb; color: #6b7280; }

.rd-message {
  background: #f8fafc;
  border: 1px solid #e2e8f0;
  padding: 14px 16px;
  border-radius: 10px;
  margin-bottom: 16px;
  font-size: 14px;
  line-height: 1.65;
  color: #334155;
  white-space: pre-wrap;
  word-wrap: break-word;
}

.rd-section {
  margin-bottom: 16px;
}
.rd-section-title {
  font-size: 13px;
  font-weight: 700;
  color: var(--text);
  margin: 0 0 10px;
  text-transform: uppercase;
  letter-spacing: 0.04em;
  display: flex;
  align-items: center;
  gap: 6px;
}
.rd-section-title::after {
  content: '';
  flex: 1;
  height: 1px;
  background: var(--border);
}
.rd-recipients {
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
}
.rd-tag {
  background: #f0f9ff;
  border: 1px solid #bae6fd;
  color: #0369a1;
  padding: 4px 10px;
  border-radius: 20px;
  font-size: 12px;
  font-weight: 500;
}

/* Conversation thread */
.rd-reply {
  padding: 12px 14px;
  border-radius: 10px;
  margin-bottom: 8px;
  border: 1px solid var(--border);
  background: #fff;
}
.rd-reply:last-child { margin-bottom: 0; }
.rd-reply.is-guardian {
  background: #f0fdf4;
  border-color: #bbf7d0;
}
.rd-reply.is-staff {
  background: #eff6ff;
  border-color: #bfdbfe;
}
.rd-reply-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 6px;
}
.rd-reply-sender {
  font-weight: 600;
  font-size: 13px;
  display: flex;
  align-items: center;
  gap: 6px;
}
.rd-reply-sender .sender-dot {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  flex-shrink: 0;
}
.rd-reply-sender .sender-dot.guardian { background: #10b981; }
.rd-reply-sender .sender-dot.staff { background: #3b82f6; }
.rd-reply-sender .sender-name { color: var(--text); }
.rd-reply-sender .sender-label {
  font-size: 11px;
  font-weight: 500;
  color: var(--muted);
}
.rd-reply-date {
  font-size: 11px;
  color: #94a3b8;
  white-space: nowrap;
}
.rd-reply-msg {
  font-size: 13px;
  color: #475569;
  line-height: 1.6;
  margin: 0;
  white-space: pre-wrap;
  word-wrap: break-word;
}
.rd-no-replies {
  text-align: center;
  padding: 20px 12px;
  color: #94a3b8;
  font-size: 13px;
  border: 1px dashed var(--border);
  border-radius: 10px;
}

/* Reply form */
.rd-reply-form {
  margin-top: 16px;
  padding-top: 16px;
  border-top: 2px solid var(--border);
}
.rd-reply-form label {
  display: block;
  font-size: 13px;
  font-weight: 600;
  color: var(--text);
  margin-bottom: 6px;
}
.rd-reply-form textarea {
  width: 100%;
  min-height: 80px;
  padding: 10px 12px;
  border: 1px solid #d1d5db;
  border-radius: 10px;
  font-size: 14px;
  font-family: inherit;
  resize: vertical;
  box-sizing: border-box;
  transition: border-color 0.15s, box-shadow 0.15s;
  color: var(--text);
}
.rd-reply-form textarea:focus {
  outline: none;
  border-color: var(--primary);
  box-shadow: 0 0 0 3px rgba(1, 83, 91, 0.1);
}
.rd-reply-form textarea::placeholder { color: #9ca3af; }
.rd-reply-form .rd-form-actions {
  display: flex;
  justify-content: flex-end;
  margin-top: 10px;
}
.rd-reply-form button {
  background: var(--primary);
  color: #fff;
  padding: 9px 22px;
  border: none;
  border-radius: 10px;
  font-weight: 600;
  font-size: 14px;
  cursor: pointer;
  transition: background 0.15s, transform 0.1s;
  display: inline-flex;
  align-items: center;
  gap: 6px;
}
.rd-reply-form button:hover {
  background: var(--primary-hover);
  transform: translateY(-1px);
}
.rd-reply-form button:active { transform: translateY(0); }
.rd-reply-form button:disabled {
  opacity: 0.5;
  cursor: not-allowed;
  transform: none;
}

@media (max-width: 640px) {
  .report-modal-overlay { padding: 60px 8px 20px; }
  .rd-modal-body { padding: 16px; }
  .rd-info-grid { grid-template-columns: 1fr 1fr; }
  .rd-reply-header { flex-direction: column; align-items: flex-start; gap: 2px; }
  .rp-card { flex-direction: column; align-items: flex-start; }
  .rp-right { width: 100%; justify-content: space-between; }
}
</style>

<body>
  <% const hasFilesFeature = Array.isArray(allowedFeatures) && (allowedFeatures.includes('Create Files') || allowedFeatures.includes('Files & Sheets')); %>
  <% const hasAttendanceFeature = Array.isArray(allowedFeatures) && (allowedFeatures.includes('Attendance Tracking') || allowedFeatures.includes('Attendance tracking feature')); %>
  <% const hasAssessmentFeature = Array.isArray(allowedFeatures) && (allowedFeatures.includes('Assessment Tracking') || allowedFeatures.includes('Assessment tracking feature')); %>
  <div class="dashboard-shell">
    <button class="nav-toggle" type="button">
      <span class="hamburger-icon" aria-hidden="true"></span>
      <span>Class Tools</span>
    </button>

    <div class="dashboard-grid">
      <aside class="card nav-card" id="class-tools-panel">
        <div class="nav-header">
          <div>
            <h3>Class Tools</h3>
          </div>
          <button class="nav-close" type="button" aria-label="Close navigation">×</button>
        </div>
        <div class="side-nav">
          <ul class="nav-list">
            <% if (hasAttendanceFeature && (userRole !== "Teacher" || isMainTeacher)) { %>
              <li><a class="nav-link" href="/common/attendanceCollection?classId=<%= classId %>&termId=<%= currentTerm.term_id %>">Attendance</a></li>
            <% } %>

            <% if (hasAssessmentFeature) { %>
              <li class="nav-section-label">Subjects</li>
              <% if (subjects.length > 0) { %>
                <% subjects.forEach(function(subject) { %>
                  <li>
                    <a class="nav-link" href="/common/assessment?classId=<%= classId %>&subjectId=<%= subject.subject_id %>">
                      <%= subject.subject_name %>
                    </a>
                  </li>
                <% }); %>
              <% } else { %>
                <li class="card-subtext" style="padding: 4px 2px;">No subjects added yet.</li>
              <% } %>
            <% } %>

            <% if (hasFilesFeature) { %>
              <li class="nav-section-label">Tools</li>
              <li>
                <a class="nav-link" href="/documents?classId=<%= classId %>&create=1" title="Files" data-no-spa>
                  <span class="files-link-inline">📁 Files
                    <% if (userRole === 'Teacher' && (assignedFilesCount || 0) > 0) { %>
                      <span class="files-badge" title="Assigned files"><%= assignedFilesCount %></span>
                    <% } %>
                  </span>
                </a>
              </li>
            <% } %>
              <li class="nav-section-label">Communication</li>
              <li>
                <a class="nav-link" href="#" id="reports-nav-link" onclick="toggleReportsPanel(event)">
                  <span class="files-link-inline">📋 Reports
                    <% if ((classReportsCount || 0) > 0) { %>
                      <span class="files-badge" title="Reports"><%= classReportsCount %></span>
                    <% } %>
                  </span>
                </a>
              </li>
          </ul>
        </div>
      </aside>

      <div class="nav-overlay" id="class-tools-overlay"></div>

      <main class="dashboard-main">
        <div class="dashboard-header">
          <h1 class="page-title" id="className"><%= className %></h1>
          <% if (graduationYearGroup) { %>
            <p class="card-subtext"><%= graduationYearGroup %></p>
          <% } %>
        </div>

        <div class="dashboard-content">
          <div class="section-card class-info-section" id="class-info-section">
            <button class="section-toggle class-info-toggle" type="button" id="class-info-toggle" aria-expanded="false" aria-controls="class-info-content">
              <span class="section-title">School Year: <%= schoolYear.year_label %> · Term: <%= currentTerm.term_name %></span>
              <span class="section-toggle-icon" aria-hidden="true">›</span>
            </button>
            <div class="section-collapse" id="class-info-content">
              <div class="meta-grid">
                <div class="meta-tile">
                  <p class="meta-label">School Year</p>
                  <p class="meta-value"><%= schoolYear.year_label %></p>
                </div>
                <div class="meta-tile">
                  <p class="meta-label">Term</p>
                  <p class="meta-value"><%= currentTerm.term_name %></p>
                </div>
                <div class="meta-tile">
                  <p class="meta-label">Start Date</p>
                  <p class="meta-value"><%= new Date(currentTerm.start_date).toISOString().split('T')[0] %></p>
                </div>
                <div class="meta-tile">
                  <p class="meta-label">End Date</p>
                  <p class="meta-value"><%= new Date(currentTerm.end_date).toISOString().split('T')[0] %></p>
                </div>
              </div>
            </div>
          </div>

          <div class="section-card teacher-section" id="teachers-section">
            <button class="section-toggle" type="button" id="teachers-toggle" aria-expanded="false" aria-controls="teachers-content">
              <span class="section-title">Teachers</span>
              <span class="section-toggle-icon" aria-hidden="true">›</span>
            </button>
            <div class="section-collapse" id="teachers-content" hidden>
              <p class="section-subtext">Main teacher can mark attendance.</p>
              <div class="teacher-list">
                <% employees.forEach(function(employee) { %>
                  <div class="teacher-card">
                    <% if (employee.main) { %>
                      <span class="teacher-dot" title="Main teacher"></span>
                    <% } else { %>
                      <span style="width:10px; height:10px;"></span>
                    <% } %>
                    <span class="teacher-name"><%= employee.name %></span>
                    <% if (req.session && req.session.userRole !== 'Teacher' && req.session.userRole !== 'Supervisor') { %>
                      <input type="radio" name="main_employee" value="<%= employee.user_id %>" <% if (employee.main) { %> checked <% } %> onchange="setMainEmployee('<%= classId %>', '<%= employee.user_id %>')" style="margin-left:auto;">
                    <% } %>
                  </div>
                <% }); %>
              </div>
            </div>
          </div>

          <div class="section-card students-section">
            <div class="section-title">Students</div>
            <ul class="student-list">
              <% if (students.length > 0) { %>
                <% students.forEach(function(student, index) { %>
                  <li>
                    <div class="student-row">
                      <span class="student-index"><%= index + 1 %>.</span>
                      <a class="student-link" href="/common/studentDetails?studentId=<%= student.student_id %>&termId=<%= currentTerm.term_id %>&classId=<%= classId %>">
                        <%= student.first_name %> <%= student.last_name %>
                      </a>
                    </div>
                  </li>
                <% }); %>
              <% } else { %>
                <li class="card-subtext">No students enrolled for this term yet.</li>
              <% } %>
            </ul>
          </div>

          <!-- Reports List Overlay -->
          <div class="report-modal-overlay" id="reportsListModal">
            <div class="report-modal-box">
              <button class="report-modal-close" onclick="closeReportsListModal()">×</button>
              <div class="rd-modal-body">
                <h2 class="rd-title">📋 Parent Reports</h2>
                <div id="reports-list-content">
                  <p style="color:#6b7280;font-size:13px;">Loading reports...</p>
                </div>
              </div>
            </div>
          </div>

          <!-- Report Detail Modal -->
          <div class="report-modal-overlay" id="reportDetailModal">
            <div class="report-modal-box">
              <button class="report-modal-close" onclick="closeReportModal()">×</button>
              <div id="reportDetailContent">
                <p style="color:#6b7280;">Loading...</p>
              </div>
            </div>
          </div>
        </div>
      </main>
    </div>
  </div>

  <script>
    (function () {
      window.setMainEmployee = function (classId, userId) {
        const confirmationMessage = "Are you sure you want to set this teacher as the main teacher for this class? The main teacher will have full access and is the only teacher who can mark attendance.";
        if (!confirm(confirmationMessage)) return;

        fetch('/common/setMainEmployee', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ class_id: classId, main_employee: userId })
        })
          .then(response => response.json())
          .then(data => {
            if (data.success) {
              alert('Main class teacher set successfully');
            } else {
              alert('Failed to set main class teacher');
            }
          })
          .catch(error => {
            console.error('Error:', error);
            alert('Error setting main employee');
          });
      };

      function initClassDashboard() {
        const navToggle = document.querySelector('.nav-toggle');
        const navPanel = document.getElementById('class-tools-panel');
        const navOverlay = document.getElementById('class-tools-overlay');
        const navClose = document.querySelector('.nav-close');
        const navLinks = document.querySelectorAll('.nav-link');
        const classInfoSection = document.getElementById('class-info-section');
        const classInfoToggle = document.getElementById('class-info-toggle');
        const classInfoContent = document.getElementById('class-info-content');
        const teachersSection = document.getElementById('teachers-section');
        const teachersToggle = document.getElementById('teachers-toggle');
        const teachersContent = document.getElementById('teachers-content');

        function openNav() {
          if (navPanel) navPanel.classList.add('open');
          if (navOverlay) navOverlay.classList.add('show');
        }

        function closeNav() {
          if (navPanel) navPanel.classList.remove('open');
          if (navOverlay) navOverlay.classList.remove('show');
        }

        function setTeachersOpen(isOpen) {
          if (!teachersSection || !teachersToggle || !teachersContent) return;
          teachersSection.classList.toggle('open', isOpen);
          teachersToggle.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
          teachersContent.hidden = !isOpen;
        }

        function isSmallScreen() {
          return window.matchMedia('(max-width: 960px)').matches;
        }

        function setClassInfoOpen(isOpen) {
          if (!classInfoSection || !classInfoToggle || !classInfoContent) return;
          classInfoSection.classList.toggle('open', isOpen);
          classInfoToggle.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
          classInfoContent.hidden = !isOpen;
        }

        function syncClassInfoForViewport() {
          if (!classInfoSection || !classInfoToggle || !classInfoContent) return;
          if (isSmallScreen()) {
            setClassInfoOpen(false);
          } else {
            setClassInfoOpen(true);
          }
        }

        if (navToggle && !navToggle.dataset.boundNavToggle) {
          navToggle.dataset.boundNavToggle = '1';
          navToggle.addEventListener('click', openNav);
        }
        if (navOverlay && !navOverlay.dataset.boundNavOverlay) {
          navOverlay.dataset.boundNavOverlay = '1';
          navOverlay.addEventListener('click', closeNav);
        }
        if (navClose && !navClose.dataset.boundNavClose) {
          navClose.dataset.boundNavClose = '1';
          navClose.addEventListener('click', closeNav);
        }
        if (navLinks && navLinks.length) {
          navLinks.forEach(link => {
            if (!link.dataset.boundNavLinkClose) {
              link.dataset.boundNavLinkClose = '1';
              link.addEventListener('click', closeNav);
            }
          });
        }

        if (classInfoToggle) {
          syncClassInfoForViewport();
          if (!classInfoToggle.dataset.boundClassInfoToggle) {
            classInfoToggle.dataset.boundClassInfoToggle = '1';
            classInfoToggle.addEventListener('click', () => {
              if (!isSmallScreen()) return;
              const isOpen = classInfoToggle.getAttribute('aria-expanded') === 'true';
              setClassInfoOpen(!isOpen);
            });
          }

          if (window.__classDashboardResizeHandler) {
            window.removeEventListener('resize', window.__classDashboardResizeHandler);
          }
          window.__classDashboardResizeHandler = syncClassInfoForViewport;
          window.addEventListener('resize', window.__classDashboardResizeHandler);
        }

        if (teachersToggle) {
          setTeachersOpen(false);
          if (!teachersToggle.dataset.boundTeachersToggle) {
            teachersToggle.dataset.boundTeachersToggle = '1';
            teachersToggle.addEventListener('click', () => {
              const isOpen = teachersToggle.getAttribute('aria-expanded') === 'true';
              setTeachersOpen(!isOpen);
            });
          }
        }
      }

      initClassDashboard();
    })();

    // --- Reports Panel ---
    function toggleReportsPanel(e) {
      if (e) e.preventDefault();
      var modal = document.getElementById('reportsListModal');
      modal.classList.add('active');
      loadClassReports();
    }
    function closeReportsListModal() {
      document.getElementById('reportsListModal').classList.remove('active');
    }
    document.getElementById('reportsListModal').addEventListener('click', function(e) {
      if (e.target === this) closeReportsListModal();
    });

    function loadClassReports() {
      var container = document.getElementById('reports-list-content');
      container.innerHTML = '<p style="color:#6b7280;font-size:13px;">Loading reports...</p>';
      fetch('/common/classReports?classId=<%= classId %>')
        .then(function(r) { return r.json(); })
        .then(function(d) {
          if (!d.success || !d.reports || !d.reports.length) {
            container.innerHTML = '<div class="rp-empty">No reports for this class yet.</div>';
            return;
          }
          var html = '';
          d.reports.forEach(function(r) {
            var statusCls = 'rp-status-' + (r.status || 'open');
            var replyLabel = (r.reply_count == 1) ? '1 reply' : (r.reply_count || 0) + ' replies';
            html += '<div class="rp-card" onclick="openReportDetail(' + r.report_id + ')">' +
              '<div class="rp-left">' +
                '<div class="rp-subject">' + esc(r.subject) + '</div>' +
                '<div class="rp-meta">' +
                  '<span>' + esc(r.student_name) + '</span>' +
                  '<span class="rp-dot"></span>' +
                  '<span>' + esc(r.guardian_name) + '</span>' +
                  '<span class="rp-dot"></span>' +
                  '<span>' + new Date(r.created_at).toLocaleDateString() + '</span>' +
                '</div>' +
              '</div>' +
              '<div class="rp-right">' +
                '<span class="rp-status ' + statusCls + '">' + (r.status || 'open').replace('_',' ') + '</span>' +
                '<span class="rp-replies">💬 ' + replyLabel + '</span>' +
              '</div>' +
            '</div>';
          });
          container.innerHTML = html;
        })
        .catch(function() {
          container.innerHTML = '<div class="rp-empty" style="color:#e74c3c;">Failed to load reports.</div>';
        });
    }

    function esc(s) {
      if (!s) return '';
      var d = document.createElement('div');
      d.textContent = s;
      return d.innerHTML;
    }

    function openReportDetail(reportId) {
      var modal = document.getElementById('reportDetailModal');
      var content = document.getElementById('reportDetailContent');
      content.innerHTML = '<p style="color:#6b7280;">Loading...</p>';
      modal.classList.add('active');

      fetch('/common/classReportDetail?reportId=' + reportId)
        .then(function(r) { return r.json(); })
        .then(function(d) {
          if (!d.success) { content.innerHTML = '<p style="color:#e74c3c;">Report not found.</p>'; return; }
          var rp = d.report;
          var statusCls = 'rp-status-' + (rp.status || 'open');
          var prCls = 'rd-priority-' + (rp.priority || 'normal');

          var html = '<div class="rd-modal-body">';
          html += '<h2 class="rd-title">' + esc(rp.subject) + '</h2>';

          // Info grid
          html += '<div class="rd-info-grid">';
          html += '<div class="rd-info-item"><p class="rd-info-label">Student</p><p class="rd-info-value">' + esc(rp.student_name) + '</p></div>';
          html += '<div class="rd-info-item"><p class="rd-info-label">Guardian</p><p class="rd-info-value">' + esc(rp.guardian_name) + '</p></div>';
          html += '<div class="rd-info-item"><p class="rd-info-label">Date</p><p class="rd-info-value">' + new Date(rp.created_at).toLocaleDateString('en-US', {year:'numeric',month:'short',day:'numeric'}) + '</p></div>';
          html += '<div class="rd-info-item"><p class="rd-info-label">Status</p><p class="rd-info-value"><span class="rd-badge ' + statusCls + '">' + (rp.status || 'open').replace('_',' ') + '</span></p></div>';
          html += '<div class="rd-info-item"><p class="rd-info-label">Priority</p><p class="rd-info-value"><span class="rd-badge ' + prCls + '">' + esc(rp.priority || 'normal') + '</span></p></div>';
          html += '</div>';

          // Original message
          html += '<div class="rd-message">' + esc(rp.message) + '</div>';

          // Recipients
          if (d.recipients && d.recipients.length) {
            html += '<div class="rd-section"><div class="rd-section-title">Copied Staff</div><div class="rd-recipients">';
            d.recipients.forEach(function(rc) {
              html += '<span class="rd-tag">' + esc(rc.display_name) + ' · ' + esc(rc.display_role) + '</span>';
            });
            html += '</div></div>';
          }

          // Conversation
          var replyCount = d.replies ? d.replies.length : 0;
          html += '<div class="rd-section"><div class="rd-section-title">Conversation (' + replyCount + ')</div>';
          if (replyCount > 0) {
            d.replies.forEach(function(reply) {
              var isGuardian = reply.sender_type === 'guardian';
              var bubbleCls = isGuardian ? 'is-guardian' : 'is-staff';
              var dotCls = isGuardian ? 'guardian' : 'staff';
              var label = isGuardian ? 'Parent' : 'Staff';
              html += '<div class="rd-reply ' + bubbleCls + '">' +
                '<div class="rd-reply-header">' +
                  '<span class="rd-reply-sender">' +
                    '<span class="sender-dot ' + dotCls + '"></span>' +
                    '<span class="sender-name">' + esc(reply.display_name) + '</span>' +
                    '<span class="sender-label">' + label + '</span>' +
                  '</span>' +
                  '<span class="rd-reply-date">' + new Date(reply.created_at).toLocaleString('en-US', {month:'short',day:'numeric',hour:'numeric',minute:'2-digit'}) + '</span>' +
                '</div>' +
                '<p class="rd-reply-msg">' + esc(reply.message) + '</p>' +
              '</div>';
            });
          } else {
            html += '<div class="rd-no-replies">No replies yet. Start the conversation below.</div>';
          }
          html += '</div>';

          // Reply form
          html += '<div class="rd-reply-form">' +
            '<label for="staffReplyMsg">Your Reply</label>' +
            '<textarea id="staffReplyMsg" placeholder="Write your response to this report..."></textarea>' +
            '<div class="rd-form-actions">' +
              '<button id="staffReplyBtn" onclick="submitStaffReply(' + rp.report_id + ')">Send Reply</button>' +
            '</div>' +
          '</div>';

          html += '</div>'; // close rd-modal-body
          content.innerHTML = html;
        })
        .catch(function() {
          content.innerHTML = '<p style="color:#e74c3c;">Failed to load report.</p>';
        });
    }

    function closeReportModal() {
      document.getElementById('reportDetailModal').classList.remove('active');
    }
    document.getElementById('reportDetailModal').addEventListener('click', function(e) {
      if (e.target === this) closeReportModal();
    });

    function submitStaffReply(reportId) {
      var msg = document.getElementById('staffReplyMsg').value.trim();
      if (!msg) return;
      var btn = document.getElementById('staffReplyBtn');
      btn.disabled = true;
      btn.textContent = 'Sending...';

      fetch('/common/staffReplyToReport', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ reportId: reportId, message: msg })
      })
        .then(function(r) { return r.json(); })
        .then(function(d) {
          if (d.success) {
            openReportDetail(reportId); // refresh
            loadClassReports(); // refresh list counts
          } else {
            alert(d.error || 'Error sending reply');
            btn.disabled = false;
            btn.textContent = 'Send Reply';
          }
        })
        .catch(function() {
          alert('Error sending reply');
          btn.disabled = false;
          btn.textContent = 'Send Reply';
        });
    }
  </script>
</body>