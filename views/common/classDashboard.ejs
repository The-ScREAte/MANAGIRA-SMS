<%
  const themeColor = (typeof session !== 'undefined' && session && session.themeColor) ? session.themeColor : 'teal';
  const themeColors = themePalette;
  const currentTheme = themeColors[themeColor] || themeColors.teal;
  const workspaceStudents = (students || []).map((student) => ({
    id: student.student_id,
    name: (typeof formatDisplayName === 'function'
      ? formatDisplayName(student)
      : `${student.first_name} ${student.last_name}`),
    firstName: student.first_name,
    lastName: student.last_name,
  }));
  const workspaceSubjects = (subjects || []).map((subject) => ({
    id: subject.subject_id,
    name: subject.subject_name,
  }));
  const classTransportRows = Array.isArray(classTransportationSnapshot) ? classTransportationSnapshot : [];
  const transportActive = !!(transportationIntegration && transportationIntegration.activated);
  const classTransportationMapRows = classTransportRows.filter((row) => row && row.stopLatitude !== null && row.stopLongitude !== null);
  const classTransportByStudentId = classTransportRows.reduce((acc, row) => {
    const key = Number(row && row.studentId);
    if (!Number.isInteger(key) || acc[key]) return acc;
    acc[key] = row;
    return acc;
  }, {});
%>
<style>
      /* To review stands apart from the subjects: its own colour. */
      .nav-sublink[data-nav-key="to-review"] { color: #d97706; font-weight: 700; }
      .nav-sublink[data-nav-key="to-review"] .nav-count-pill { margin-left: 6px; background: color-mix(in srgb, #d97706 16%, transparent); color: #d97706; }
      .subject-review { flex: none; margin-left: auto; margin-right: 10px; padding: 3px 10px; border-radius: 999px; background: color-mix(in srgb, #d97706 14%, transparent); color: #b45309; font-size: .76rem; font-weight: 600; white-space: nowrap; cursor: pointer; }
      .subject-review b { font-weight: 800; }

:root {
  --border: #e5e7eb;
  --muted: #6b7280;
  --bg: #f9fafb;
  --primary: <%= currentTheme.primary %>;
  --primary-hover: <%= currentTheme.hover %>;
        --primary-hover-fill: color-mix(in srgb, var(--primary) 88%, white);
  --text: #111827;
  --font-family: "<%= (session && session.fontStyle ? String(session.fontStyle).trim() : 'Inter') %>", sans-serif;
}
</style>
<link rel="stylesheet" href="<%= assetUrl('/css/classWorkspace.css') %>" />
<link rel="stylesheet" href="<%= assetUrl('/css/assessmentFlow.css') %>" />

<body>
  <% const hasFilesFeature = Array.isArray(allowedFeatures) && (allowedFeatures.includes('Create Files') || allowedFeatures.includes('Files & Sheets') || allowedFeatures.includes('Docs/Sheets')); %>
  <% const hasAttendanceFeature = Array.isArray(allowedFeatures) && (allowedFeatures.includes('Attendance Tracking') || allowedFeatures.includes('Attendance tracking feature')); %>
  <% const _canMarkAttendance = Array.isArray(typeof userPermissions !== 'undefined' ? userPermissions : null) && userPermissions.includes('mark_attendance'); %>
  <%# Offered to someone who may mark it: saving needs Mark Attendance, and a teacher marks only the class they lead. %>
  <% /* What THIS class takes: the school's switches and the class's own (Take attendance, Take lunch). Name and icons follow it. */
  const _svc = locals.classServices || locals.schoolServices || { attendance: true, lunch: true, name: 'Attendance & lunch', icons: ['attendance', 'lunch'] };
  const _svcIcons = (_svc.icons || [_svc.attendance ? 'attendance' : null, _svc.lunch ? 'lunch' : null]).filter(Boolean);
  // Offered with the feature and the right to mark; shown only while the class takes attendance or lunch.
  const _offerBase = hasAttendanceFeature && _canMarkAttendance && (userRole !== "Teacher" || isMainTeacher || (typeof isAssistantTeacher !== 'undefined' && isAssistantTeacher));
  const _offerAttendance = _offerBase && (_svc.attendance || _svc.lunch); %>
  <% const hasAssessmentFeature = Array.isArray(allowedFeatures) && (allowedFeatures.includes('Assessment Tracking') || allowedFeatures.includes('Assessment tracking feature')); %>
  <% const _canOpenPaygiraWorkspace = typeof canOpenPaygiraWorkspace === 'boolean' ? canOpenPaygiraWorkspace : true; %>
  <%# The weekly briefing's choices for this class: in Class settings when the class has it, else in Class Tools. %>
  <% const _briefingAllowed = Boolean(locals.featureOn && featureOn('weekly_briefing') && locals.workspaceAccess && workspaceAccess().management.briefing); %>
  <% const _classSettingsShown = Boolean(locals.classSettingsPanel && locals.featureOn && featureOn('class_settings')); %>
  <div class="workspace-shell">
    <button class="nav-toggle" type="button" aria-label="Open Class Tools" aria-expanded="false" aria-controls="class-tools-panel">
      <span class="hamburger-icon" aria-hidden="true"></span>
      <span>Class Tools</span>
    </button>

    <div class="workspace-grid">
      <aside class="card nav-card workspace-sidebar" id="class-tools-panel">
        <div class="nav-header">
          <div>
            <h3>Class Tools</h3>
            <p class="card-subtext">Open sections as active workspace tabs.</p>
          </div>
          <button class="menu-arrange-btn" type="button" data-arrange-toggle="classroom" aria-label="Arrange this menu" title="Arrange this menu"></button>
          <button class="nav-close" type="button" aria-label="Close navigation">×</button>
        </div>
        <div class="side-nav">
          <ul class="nav-list" id="ctNavList" data-arrange-menu="classroom" data-arrange-owner="<%= (session && session.organizationId || '') + '-' + (session && (session.userId || (session.user && session.user.user_id)) || '') %>" data-arrange-order="<%= JSON.stringify(typeof classToolsOrder !== 'undefined' ? classToolsOrder : []) %>">
            <li>
              <button class="nav-link" type="button" data-nav-key="overview" data-onclick="common-classDashboard.1">
                <span class="nav-icon" aria-hidden="true"><%- navIcon('classroom') %></span>
                <span class="nav-link-label">Class Room</span>
              </button>
            </li>

            <li class="nav-section-label">Communication</li>
            <li>
              <button class="nav-link" type="button" id="reports-nav-link" data-nav-key="reports" data-onclick="common-classDashboard.2">
                <span class="nav-icon" aria-hidden="true"><%- navIcon('messages') %></span>
                <span class="nav-link-label">Parent Messages</span>
                <% if ((classReportsCount || 0) > 0) { %>
                  <span class="files-badge" title="Parent messages"><%= classReportsCount %></span>
                <% } %>
              </button>
            </li>

            <% if (_briefingAllowed && !_classSettingsShown) { %>
            <li>
              <button class="nav-link" type="button" data-nav-key="briefing" data-onclick="common-classDashboard.3">
                <span class="nav-icon" aria-hidden="true"><%- navIcon('briefing') %></span>
                <span class="nav-link-label">Weekly briefing</span>
              </button>
            </li>
            <% } %>

            <li class="nav-section-label">Tools</li>
            <li>
              <button class="nav-link" type="button" id="class-schedule-nav-link" data-nav-key="schedule" data-onclick="common-classDashboard.4">
                <span class="nav-icon" aria-hidden="true"><%- navIcon('schedule') %></span>
                <span class="nav-link-label">Class Schedule</span>
              </button>
            </li>
            <% if (locals.classPickup) { %>
            <li>
              <button class="nav-link" type="button" data-nav-key="pickup" data-onclick="common-classDashboard.5">
                <span class="nav-icon" aria-hidden="true"><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="7" r="3"/><path d="M3 20a6 6 0 0 1 12 0"/><path d="m16 11 2 2 4-4"/></svg></span>
                <span class="nav-link-label">Pickup list</span>
              </button>
            </li>
            <% } %>
            <% if (transportActive) { %>
            <li>
              <button class="nav-link" type="button" data-nav-key="transportation" data-onclick="common-classDashboard.6">
                <span class="nav-icon" aria-hidden="true"><%- navIcon('transportation') %></span>
                <span class="nav-link-label">Transportation</span>
                <span class="nav-count-pill"><%= classTransportRows.filter(function(row) { return row.busNumber || row.routeName || row.stopName; }).length %></span>
              </button>
            </li>
            <% } %>
            <li>
              <button class="nav-link" type="button" data-nav-key="activities" data-onclick="common-classDashboard.7">
                <span class="nav-icon" aria-hidden="true"><%- navIcon('activities') %></span>
                <span class="nav-link-label">Activities</span>
              </button>
            </li>
            <% if (locals.customFormsReady && customFormsReady()) { %>
            <li>
              <button class="nav-link" type="button" data-nav-key="forms" data-onclick="common-classDashboard.8">
                <span class="nav-icon" aria-hidden="true"><%- navIcon('forms') %></span>
                <span class="nav-link-label">Forms</span>
              </button>
            </li>
            <%# Forms the school gave a menu item of their own (Custom editor, "Its own tile"). %>
            <% (locals.classFormTiles || []).forEach((form) => { %>
            <li>
              <button class="nav-link" type="button" data-nav-key="form-<%= form.id %>" data-onclick="common-classDashboard.9" data-mga0="<%= form.id %>">
                <span class="nav-icon" aria-hidden="true"><%- formIcon(form.icon) %></span>
                <span class="nav-link-label"><%= form.name %></span>
              </button>
            </li>
            <% }) %>
            <% } %>
            <% if (_canOpenPaygiraWorkspace) { %>
            <li>
              <button class="nav-link" type="button" data-nav-key="paygira" data-onclick="common-classDashboard.10">
                <span class="nav-icon" aria-hidden="true"><%- navIcon('paygira') %></span>
                <span class="nav-link-label">My PayGira</span>
              </button>
            </li>
            <% } %>

            <% if (_offerBase) { %>
              <li data-att-item<%= _offerAttendance ? '' : ' hidden' %>>
                <button class="nav-link" type="button" data-nav-key="attendance" data-onclick="common-classDashboard.11">
                  <span class="nav-icon<%= _svcIcons.length > 1 ? ' nav-icon--pair' : '' %>" aria-hidden="true" data-att-icons><%- _svcIcons.map((n) => navIcon(n)).join('') %></span>
                  <span class="nav-link-label" data-att-label><%= _svc.name %></span>
                </button>
              </li>
            <% } %>

            <% if (hasAssessmentFeature) { %>
              <% if (canAccessAssessmentQuestions) { %>
              <li>
                <button class="nav-link" type="button" data-nav-key="assessment-questions" data-onclick="common-classDashboard.12">
                  <span class="nav-icon" aria-hidden="true"><%- navIcon('questions') %></span>
                  <span class="nav-link-label">Assessment Questions</span>
                </button>
              </li>
              <% } else if (locals.assessmentQuestionsLocked && Array.isArray(typeof userPermissions !== 'undefined' ? userPermissions : null) && userPermissions.includes('manage_assessments')) { %>
              <%# Not given Set Assessment Questions: shown greyed, opens nothing, says who to ask. %>
              <li>
                <button class="nav-link is-locked" type="button" data-nav-key="assessment-questions-locked" aria-disabled="true" title="Ask your admin for access" aria-describedby="aq-lock-hint" data-onclick="common-classDashboard.13">
                  <span class="nav-icon" aria-hidden="true"><%- navIcon('questions') %></span>
                  <span class="nav-link-label">Assessment Questions<small class="nav-lock-hint" id="aq-lock-hint">Ask your admin for access</small></span>
                </button>
              </li>
              <% } %>
              <li class="nav-section-collapsible">
                <button class="nav-link nav-section-toggle" type="button" id="subjects-section-toggle" aria-expanded="false" aria-controls="subjects-section-list" data-onclick="common-classDashboard.14">
                  <span class="nav-icon" aria-hidden="true"><%- navIcon('grading') %></span>
                  <span class="nav-link-label">Gradebook</span>
                  <span class="nav-count-pill"><%= subjects.length %></span>
                  <span class="nav-section-icon" aria-hidden="true">›</span>
                </button>
              </li>
              <li class="nav-section-children" id="subjects-section-list" hidden>
                <ul class="nav-sublist">
                  <% if (canAccessAssessmentQuestions) { %>
                    <li><button class="nav-sublink" type="button" data-nav-key="to-review" data-onclick="common-classDashboard.15">Review<% if ((locals.toReviewTotal || 0) > 0) { %> <span class="nav-count-pill"><%= locals.toReviewTotal %></span><% } %></button></li>
                  <% } %>
                  <% if (subjects.length > 0) { %>
                    <% subjects.forEach(function(subject) { %>
                      <li><button class="nav-sublink" type="button" data-onclick="common-classDashboard.16" data-mga0="<%= subject.subject_id %>"><%= subject.subject_name %></button></li>
                    <% }); %>
                  <% } else { %>
                    <li class="nav-sub-empty">No subjects assigned.</li>
                  <% } %>
                </ul>
              </li>
            <% } %>

            <% if (hasFilesFeature) { %>
              <li>
                <button class="nav-link" type="button" data-nav-key="docs" title="Docs &amp; sheets" data-onclick="common-classDashboard.17">
                  <span class="nav-icon" aria-hidden="true"><%- navIcon('docs') %></span>
                  <span class="nav-link-label">Docs &amp; sheets</span>
                  <% if (userRole === 'Teacher' && (assignedFilesCount || 0) > 0) { %>
                    <span class="files-badge" title="Assigned docs/sheets"><%= assignedFilesCount %></span>
                  <% } %>
                </button>
              </li>
            <% } %>

            <%# Class settings (feature class_settings): only for someone who may manage this class. %>
            <% if (locals.classSettingsPanel && locals.featureOn && featureOn('class_settings')) { %>
              <li>
                <button class="nav-link" type="button" data-nav-key="settings" data-onclick="common-classDashboard.18">
                  <span class="nav-icon" aria-hidden="true"><%- navIcon('classSettings') %></span>
                  <span class="nav-link-label">Class &amp; notif. settings</span>
                </button>
              </li>
            <% } %>

          </ul>
        </div>
      </aside>
      <link rel="stylesheet" href="<%= assetUrl('/css/menuArrange.css') %>" />
      <script src="<%= assetUrl('/js/menuArrange.js') %>"></script>
      <script src="/js/busTracker.js?v=<%= assetVersion %>" defer></script>
      <script nonce="<%= locals.cspNonce || '' %>">window.ManagiraMenuArrange && ManagiraMenuArrange.init(document.getElementById('ctNavList'));</script>

      <div class="nav-overlay" id="class-tools-overlay"></div>

      <main class="dashboard-main workspace-main">
        <%
          const _termYears = Array.isArray(locals.classroomTermOptions) ? classroomTermOptions : [];
          const _termView = locals.classroomTermView || null;
          const _viewYear = _termYears.find((y) => Number(y.id) === Number(schoolYear.id)) || { terms: [] };
          const _termCount = _termYears.reduce((n, y) => n + y.terms.length, 0);
          const _termNote = (t) => t.current ? ' (current)' : t.scores ? ' · ' + t.scores + ' scores' : t.students ? ' · ' + t.students + ' students' : ' · no students';
          const _noStudentsText = !_termView
            ? 'No students in this class yet.'
            : _termView.classInTerm
              ? 'No students were enrolled in this class in ' + currentTerm.term_name + ', ' + schoolYear.year_label + '.'
              : className + ' was not part of ' + currentTerm.term_name + ', ' + schoolYear.year_label + '.';
        %>
        <section class="card workspace-header-card<%= _termView ? ' is-term-picking is-term-viewing' : '' %>" data-meta-collapsed="<%= _termView ? 'false' : 'true' %>">
          <div class="workspace-header-line">
            <div class="workspace-header-copy">
              <span class="eyebrow">Class Workspace</span>
              <span class="workspace-title-row">
                <span class="page-title" id="className"><%= className %></span>
                <% if (graduationYearGroup) { %>
                  <span class="workspace-cohort"><%= graduationYearGroup %></span>
                <% } %>
                <button type="button" class="workspace-meta-toggle" aria-expanded="false" aria-controls="workspace-meta-inline" aria-label="Show class details" title="Show class details" data-onclick="common-classDashboard.19">
                  <svg class="workspace-meta-toggle-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="4" y1="6" x2="14" y2="6"/><circle cx="18" cy="6" r="2"/><line x1="4" y1="12" x2="10" y2="12"/><circle cx="14" cy="12" r="2"/><line x1="4" y1="18" x2="14" y2="18"/><circle cx="18" cy="18" r="2"/></svg>
                </button>
              </span>
            </div>
            <div class="workspace-meta-wrap">
            <% if (_termYears.length) { %>
            <div class="term-view-menu">
              <button type="button" class="term-view-dots" id="termViewMenuBtn" aria-haspopup="menu" aria-expanded="false" aria-controls="termViewMenu" aria-label="Class workspace options" title="Options">
                <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><circle cx="12" cy="5" r="2"/><circle cx="12" cy="12" r="2"/><circle cx="12" cy="19" r="2"/></svg>
              </button>
              <div class="term-view-pop" id="termViewMenu" role="menu" hidden>
                <button type="button" class="term-view-pop__item" role="menuitemcheckbox" aria-checked="<%= _termView ? 'true' : 'false' %>" data-term-view-toggle <%= _termCount > 1 || _termView ? '' : 'disabled' %>>
                  <span class="term-view-pop__check" aria-hidden="true"></span>
                  <span>Assess other school year<% if (_termCount <= 1 && !_termView) { %><small class="term-view-pop__note">This class has no other terms yet.</small><% } %></span>
                </button>
                <% if (_termView) { %>
                <button type="button" class="term-view-pop__item" role="menuitem" data-term-view-reset>Back to current term</button>
                <% } %>
              </div>
            </div>
            <% } %>
            <div class="workspace-meta-inline" id="workspace-meta-inline">
              <span class="workspace-meta-pair"><span class="meta-label">Year</span><span class="meta-value term-view-static"><%= schoolYear.year_label %></span>
                <% if (_termYears.length) { %>
                <select class="term-view-select" id="termViewYear" aria-label="School year">
                  <% _termYears.forEach((y) => { %>
                  <option value="<%= y.id %>" <%= Number(y.id) === Number(schoolYear.id) ? 'selected' : '' %>><%= y.label %><%= y.current ? ' (current)' : '' %></option>
                  <% }) %>
                </select>
                <% } %>
              </span>
              <span class="workspace-meta-pair"><span class="meta-label">Term</span><span class="meta-value term-view-static"><%= currentTerm.term_name %></span>
                <% if (_termYears.length) { %>
                <select class="term-view-select" id="termViewTerm" aria-label="Term">
                  <% _viewYear.terms.forEach((t) => { %>
                  <option value="<%= t.id %>" <%= Number(t.id) === Number(currentTerm.term_id) ? 'selected' : '' %>><%= t.name %><%= _termNote(t) %></option>
                  <% }) %>
                </select>
                <% } %>
              </span>
              <% const _termDay = (d, withYear) => new Date(d).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: withYear ? 'numeric' : undefined, timeZone: 'UTC' }); %>
              <span class="workspace-meta-pair"><span class="meta-label">Dates</span><span class="meta-value"><%= _termDay(currentTerm.start_date) %> – <%= _termDay(currentTerm.end_date, true) %></span></span>
            </div>
            </div>
          </div>
          <% if (_termYears.length) { %>
          <div class="term-view-banner" id="termViewBanner" role="status" <%= _termView ? '' : 'hidden' %>>
            <% if (_termView) { %>
            <span class="term-view-banner__text">
              Viewing <strong><%= currentTerm.term_name %>, <%= schoolYear.year_label %></strong><% if (!_termView.classInTerm) { %> — <%= className %> wasn't part of this term<% } %>.
              Only you see this · back to the current term in <strong data-term-view-countdown data-remaining-ms="<%= _termView.remainingMs %>">20:00</strong>
            </span>
            <button type="button" class="term-view-banner__btn" data-term-view-reset>Back to current</button>
            <% } %>
          </div>
          <script nonce="<%= locals.cspNonce || '' %>" type="application/json" id="termViewOptions"><%- JSON.stringify(_termYears).replace(/</g, '\\u003c') %></script>
          <% } %>
        </section>

        <section class="card workspace-tabbar-shell">
          <div class="workspace-tabbar" id="workspaceTabBar" role="group" aria-label="Open class workspace tabs"></div>
        </section>

        <section class="card workspace-stage">
          <div class="workspace-empty-state" id="workspaceEmptyState" hidden>
            <div class="workspace-empty-card">
              <h2>No open workspace tabs</h2>
              <p>Choose a class tool from the left sidebar to open a new work session. Tabs are created only when you open something.</p>
            </div>
          </div>

          <div class="workspace-panels" id="workspacePanels">
            <section class="workspace-panel" id="panel-overview" data-panel-key="overview">
              <div class="workspace-overview-grid">
                <div class="overview-counts-wrap">
                <div class="overview-counts-row">
                  <button type="button" class="overview-count-chip overview-count-toggle" id="teachersChipToggle" aria-expanded="false" aria-controls="teachers-section" data-onclick="common-classDashboard.20">
                    <span class="count-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 10v6"/><path d="M2 10l10-5 10 5-10 5z"/><path d="M6 12v5a6 6 0 0 0 12 0v-5"/></svg></span>
                    <span class="count-text">
                      <span class="count-label">Teachers</span>
                      <span class="count-num"><%= employees.length %></span>
                    </span>
                    <%# Nobody in charge of this class: said on the chip, so it's seen without opening it. %>
                    <% if (!employees.some(function (employee) { return employee.main; })) { %><span class="count-nolead" title="This class has no main teacher yet">No main teacher</span><% } %>
                    <span class="count-chevron" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg></span>
                  </button>
                  <div class="overview-count-chip">
                    <span class="count-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg></span>
                    <div class="count-text">
                      <span class="count-label">Students</span>
                      <span class="count-num"><%= students.length %></span>
                    </div>
                  </div>
                  <div class="overview-count-chip">
                    <span class="count-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5V5a2 2 0 0 1 2-2h13v17H6.5A2.5 2.5 0 0 0 4 22.5"/><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H19"/></svg></span>
                    <div class="count-text">
                      <span class="count-label">Subjects</span>
                      <span class="count-num"><%= subjects.length %></span>
                    </div>
                  </div>
                  <div class="overview-count-chip">
                    <span class="count-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z"/><path d="M14 3v5h5"/><path d="M9 13h6"/><path d="M9 17h4"/></svg></span>
                    <div class="count-text">
                      <span class="count-label">Messages</span>
                      <span class="count-num"><%= classReportsCount || 0 %></span>
                    </div>
                  </div>
                </div>

                <div class="section-card teacher-section teachers-dropdown" id="teachers-section" data-collapsed="false" hidden>
                  <div class="teachers-head">
                    <h2 class="section-title">Teachers</h2>
                    <span class="section-subtext">The main teacher <%= _svc.attendance ? 'marks attendance and ' : '' %>looks after the class<%= employees.some(function (e) { return e.assistant; }) ? ', with the assistant teachers' : '' %>.</span>
                  </div>
                  <%
                    // Chosen on the staff form, with each person's classes and permissions.
                    const _hasLead = employees.some(function (employee) { return employee.main; });
                    const _canPickLead = typeof workspaceAccess === 'function' && workspaceAccess().employees.canEdit && workspaceAccess().management.employees;
                  %>
                  <% if (!_hasLead) { %>
                    <p class="teachers-nolead">
                      <i class="fa-solid fa-triangle-exclamation" aria-hidden="true"></i>
                      This class has no main teacher yet.
                      <% if (_canPickLead) { %><a href="/common/management?panel=employees&page=%2Fcommon%2FmanageEmployees&label=Users%20%2F%20Employees" data-no-spa>Choose one in Users / Employees</a><% } else { %>A manager can put someone in charge.<% } %>
                    </p>
                  <% } %>
                  <div class="teachers-chip-row" id="teachers-chip-row">
                    <% employees.forEach(function(employee) { %>
                      <% var initials = (employee.name || '?').trim().split(/\s+/).slice(0,2).map(function(p){return p[0];}).join('').toUpperCase(); %>
                      <%# A teacher opens as a card in the drawer (public/js/headerMenu.js, ManagiraPersonCard). %>
                      <%# The staff page link only for those who can open it (Manage Employees); for everyone the chip opens the card. %>
                      <a class="teacher-chip <% if (employee.main) { %>is-main<% } %>" href="<%= (typeof workspaceAccess === 'function' && workspaceAccess().management.employees) ? '/common/employeeDetails?userId=' + employee.user_id : '#' %>" data-person="staff:<%= employee.user_id %>">
                        <span class="teacher-avatar"><%= initials %></span>
                        <span class="teacher-info">
                          <span class="teacher-name"><%= employee.name %></span>
                          <% if (employee.main) { %><span class="teacher-role">Main Teacher</span><% } else if (employee.assistant) { %><span class="teacher-role">Assistant Teacher</span><% } else { %><span class="teacher-role">Teacher</span><% } %>
                        </span>
                      </a>
                    <% }); %>
                    <% if (!employees.length) { %><span class="section-subtext">No teachers assigned yet.</span><% } %>
                  </div>
                </div>
                </div>
                <div class="overview-split">
                  <div class="section-card students-overview-section">
                    <% const sortedOverviewStudents = (students || []).slice().sort(function(a, b) {
                      const nameA = (typeof formatDisplayName === 'function' ? formatDisplayName(a) : [a.first_name, a.last_name].filter(Boolean).join(' ').trim());
                      const nameB = (typeof formatDisplayName === 'function' ? formatDisplayName(b) : [b.first_name, b.last_name].filter(Boolean).join(' ').trim());
                      return nameA.localeCompare(nameB, undefined, { sensitivity: 'base' });
                    }); %>
                    <div class="section-header-row">
                      <h2 class="section-title">Students</h2>
                      <button type="button" class="section-sort-btn" id="classDashboardStudentSort" data-sort-direction="asc" aria-label="Sort students Z to A">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 12 12" aria-hidden="true" focusable="false"><path fill="currentColor" d="M10 5H2a.5.5 0 0 1-.46-.31.47.47 0 0 1 .11-.54L5.29.5A1 1 0 0 1 6.7.5l3.65 3.65a.49.49 0 0 1 .11.54A.51.51 0 0 1 10 5z"></path><path fill="currentColor" d="M2 7a.5.5 0 0 0-.46.31.47.47 0 0 0 .11.54L5.3 11.5a1 1 0 0 0 1.41 0l3.65-3.65a.49.49 0 0 0 .11-.54A.53.53 0 0 0 10 7z"></path></svg>
                      </button>
                      <span class="section-sort-spacer"></span>
                      <span class="section-count-pill"><%= students.length %></span>
                    </div>
                    <%# Forms shown beside each student (Custom editor, feature report_remarks_forms): in the school's
                        colour once this period's entry is in, grey until then; a tap opens that student's form
                        (script below the list). The remark pencil stays while the pop-up still has remarks to ask. %>
                    <% const _beside = locals.classBeside && Array.isArray(classBeside.sections) ? classBeside : { sections: [], done: {} }; %>
                    <% const _besideDone = {}; _beside.sections.forEach(function (form) { _besideDone[form.id] = new Set(((_beside.done || {})[form.id] || []).map(Number)); }); %>
                    <% const _besideWhen = function (form) { return form.repeat === 'day' ? ' today' : form.repeat === 'week' ? ' this week' : form.repeat === 'term' ? ' this term' : form.repeat === 'year' ? ' this year' : ''; }; %>
                    <% const _besideTitle = function (form, done) { return form.name + ': ' + (form.multiple ? (done ? 'has entries' : 'no entries yet') : (done ? 'filled in' + _besideWhen(form) : 'not filled in yet')); }; %>
                    <% const _showRemarkPencil = locals.showRemarkPencil !== false; %>
                    <ul class="students-numbered-list" id="classDashboardStudentsList">
                      <% if (students.length > 0) { %>
                        <% sortedOverviewStudents.forEach(function(student, i) { %>
                          <% const studentFullName = (typeof formatDisplayName === 'function' ? formatDisplayName(student) : [student.first_name, student.last_name].filter(Boolean).join(' ').trim()); %>
                          <% const transportRow = classTransportByStudentId[Number(student.student_id)] || null; %>
                          <% const hasTransportAccess = !!(transportRow && transportRow.hasBusAccess); %>
                          <% const transportSummary = transportRow ? [transportRow.busNumber, transportRow.routeName, transportRow.stopName].filter(Boolean).join(' | ') : ''; %>
                          <% const transportSchedule = transportRow ? [transportRow.scheduleDayOfWeek, transportRow.scheduleStartTime, transportRow.scheduleEndTime].filter(Boolean).join(' ') : ''; %>
                          <li data-student-name="<%= studentFullName.toLowerCase() %>" data-student-id="<%= student.student_id %>">
                            <button class="student-row" type="button" data-onclick="common-classDashboard.21" data-mga0="<%= student.student_id %>">
                              <span class="student-index"><%= i + 1 %></span>
                              <span class="student-name"><%= studentFullName %></span>
                              <span class="student-arrow" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg></span>
                            </button>
                            <% if (transportActive && hasTransportAccess) { %>
                            <button
                              class="student-transport-btn has-bus"
                              type="button"
                              title="Has bus access"
                              aria-label="Bus details for <%= studentFullName %>"
                              data-onclick="common-classDashboard.22" data-mga0="<%= student.student_id %>" data-mga1="<%= studentFullName %>">
                              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M8 6v6M15 6v6M2 12h19.6"/><path d="M18 18h3s.5-1.7.8-2.8c.1-.4.2-.8.2-1.2 0-.4-.1-.8-.2-1.2l-1.4-5C20.1 6.8 19.1 6 18 6H4a2 2 0 0 0-2 2v10h3"/><circle cx="7" cy="18" r="2"/><path d="M9 18h5"/><circle cx="16" cy="18" r="2"/></svg>
                            </button>
                            <% } else if (transportActive) { %>
                            <button
                              class="student-transport-btn no-bus"
                              type="button"
                              title="No bus access. Request a bus"
                              aria-label="Request a bus for <%= studentFullName %>"
                              data-bus-request="<%= student.student_id %>"
                              data-bus-request-name="<%= studentFullName %>">
                              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M8 6v6M15 6v6M2 12h19.6"/><path d="M18 18h3s.5-1.7.8-2.8c.1-.4.2-.8.2-1.2 0-.4-.1-.8-.2-1.2l-1.4-5C20.1 6.8 19.1 6 18 6H4a2 2 0 0 0-2 2v10h3"/><circle cx="7" cy="18" r="2"/><path d="M9 18h5"/><circle cx="16" cy="18" r="2"/></svg>
                            </button>
                            <% } else { %>
                            <span class="student-action-slot" aria-hidden="true"></span>
                            <% } %>
                            <% _beside.sections.forEach(function (form) { const _done = _besideDone[form.id].has(Number(student.student_id)); %>
                            <button
                              class="student-form-btn<%= _done ? ' is-done' : '' %>"
                              type="button"
                              data-cf-beside="<%= form.id %>"
                              data-student-id="<%= student.student_id %>"
                              data-student-name="<%= studentFullName %>"
                              title="<%= _besideTitle(form, _done) %>"
                              aria-label="<%= form.name %> for <%= studentFullName %>, <%= _done ? 'filled in' : 'not filled in yet' %>"><%- formIcon(form.icon, 17) %></button>
                            <% }); %>
                            <% if (_showRemarkPencil) { %>
                            <button
                              class="student-remark-btn"
                              type="button"
                              title="Teacher remark"
                              aria-label="Teacher remark for <%= studentFullName %>"
                              data-student-id="<%= student.student_id %>"
                              data-student-name="<%= studentFullName %>"
                              data-onclick="common-classDashboard.23">
                              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 20h9"/><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4Z"/></svg>
                            </button>
                            <% } %>
                          </li>
                        <% }); %>
                      <% } else { %>
                        <li class="card-subtext"><%= _noStudentsText %></li>
                      <% } %>
                    </ul>
                    <% if (_beside.sections.length) { %>
                    <script nonce="<%= locals.cspNonce || '' %>">
                      // A form beside a student opens that student's form in the drawer under the header
                      // (public/js/customFormsFill.js); saving colours its icon.
                      (function () {
                        var list = document.getElementById('classDashboardStudentsList');
                        if (!list || list.__cfBeside) return;
                        list.__cfBeside = true;
                        var forms = <%- JSON.stringify(_beside.sections) %>;
                        var termId = <%- JSON.stringify(_beside.termId || null) %>;
                        var classId = <%- JSON.stringify(Number(classId)) %>;
                        function when(form) { return form.repeat === 'day' ? ' today' : form.repeat === 'week' ? ' this week' : form.repeat === 'term' ? ' this term' : form.repeat === 'year' ? ' this year' : ''; }
                        function mark(button, form, done) {
                          button.classList.toggle('is-done', done);
                          button.title = form.name + ': ' + (form.multiple ? (done ? 'has entries' : 'no entries yet') : (done ? 'filled in' + when(form) : 'not filled in yet'));
                          button.setAttribute('aria-label', form.name + ' for ' + (button.getAttribute('data-student-name') || '') + ', ' + (done ? 'filled in' : 'not filled in yet'));
                        }
                        list.addEventListener('click', function (event) {
                          var button = event.target.closest('[data-cf-beside]');
                          if (!button || !list.contains(button)) return;
                          event.preventDefault();
                          event.stopPropagation();
                          var form = forms.filter(function (f) { return f.id === Number(button.getAttribute('data-cf-beside')); })[0];
                          var studentId = Number(button.getAttribute('data-student-id'));
                          if (!form || !studentId) return;
                          if (!window.CustomFormsFill || !window.CustomFormsFill.openStudent) {
                            window.location.href = '/common/classDashboard/' + classId + '/forms?section=' + form.id + '&student=' + studentId;
                            return;
                          }
                          window.CustomFormsFill.openStudent({
                            base: '/common/forms', section: form, studentId: studentId, termId: termId || '',
                            onChange: function (_id, entries) { mark(button, form, entries.length > 0); },
                          });
                        });
                      })();
                    </script>
                    <% } %>
                  </div>

                  <% if (hasAssessmentFeature) { %>
                  <div class="section-card subjects-overview-section">
                    <% const sortedOverviewSubjects = (subjects || []).slice().sort(function(a, b) {
                      return String(a.subject_name || '').localeCompare(String(b.subject_name || ''), undefined, { sensitivity: 'base' });
                    }); %>
                    <div class="section-header-row">
                      <h2 class="section-title">Subjects</h2>
                      <button type="button" class="section-sort-btn" id="classDashboardSubjectSort" data-sort-direction="asc" aria-label="Sort subjects Z to A">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 12 12" aria-hidden="true" focusable="false"><path fill="currentColor" d="M10 5H2a.5.5 0 0 1-.46-.31.47.47 0 0 1 .11-.54L5.29.5A1 1 0 0 1 6.7.5l3.65 3.65a.49.49 0 0 1 .11.54A.51.51 0 0 1 10 5z"></path><path fill="currentColor" d="M2 7a.5.5 0 0 0-.46.31.47.47 0 0 0 .11.54L5.3 11.5a1 1 0 0 0 1.41 0l3.65-3.65a.49.49 0 0 0 .11-.54A.53.53 0 0 0 10 7z"></path></svg>
                      </button>
                      <span class="section-sort-spacer"></span>
                      <span class="section-count-pill"><%= subjects.length %></span>
                    </div>
                    <div class="subjects-card-grid" id="classDashboardSubjectsList">
                      <% if (subjects.length > 0) { %>
                        <% sortedOverviewSubjects.forEach(function(subject) { %>
                          <button class="subject-card" type="button" data-subject-id="<%= subject.subject_id %>" data-subject-name="<%= String(subject.subject_name || '').toLowerCase() %>" data-onclick="common-classDashboard.16" data-mga0="<%= subject.subject_id %>">
                            <span class="subject-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5V5a2 2 0 0 1 2-2h13v17H6.5A2.5 2.5 0 0 0 4 22.5"/><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H19"/></svg></span>
                            <span class="subject-text">
                              <strong><%= subject.subject_name %></strong>
                            </span>
                            <% const _toReview = Number((locals.toReviewBySubject || {})[subject.subject_id] || 0); %>
                            <% if (_toReview > 0) { %>
                              <span class="subject-review" role="link" tabindex="0" title="Written answers waiting for review" data-onclick="common-classDashboard.24" data-onkeydown="common-classDashboard.25">Review <b><%= _toReview %></b></span>
                            <% } %>
                            <span class="subject-arrow" aria-hidden="true">›</span>
                          </button>
                        <% }); %>
                      <% } else { %>
                        <p class="card-subtext">No subjects assigned yet.</p>
                      <% } %>
                    </div>
                  </div>
                  <% } %>
                </div>
              </div>
            </section>

            <section class="workspace-panel" id="panel-reports" data-panel-key="reports">
              <div class="workspace-panel-head">
                <div>
                  <p class="card-subtext">Conversations with parents about individual students. They also appear in Mailroom's inbox.</p>
                </div>
                <div class="pr-head-actions">
                  <% if (Array.isArray(locals.userPermissions) && locals.userPermissions.includes('mailroom')) { %>
                  <a class="pr-mailroom" href="/common/mailroom?class=<%= encodeURIComponent(className || '') %>" data-no-spa>
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 4h16v16H4z" opacity="0"/><path d="M22 6 12 13 2 6"/><rect x="2" y="4" width="20" height="16" rx="2"/></svg>
                    Message all parents
                  </a>
                  <% } %>
                  <button class="nav-link" type="button" data-onclick="common-classDashboard.26">Refresh</button>
                </div>
              </div>
              <div id="reports-list-content">
                <p style="color:#6b7280;font-size:13px;">Open the reports tab to load active report threads.</p>
              </div>
            </section>

            <section class="workspace-panel" id="panel-schedule" data-panel-key="schedule" data-mobile-collapsed="true">
              <div class="workspace-panel-head">
                <button type="button" class="schedule-mobile-toggle" aria-expanded="false" aria-controls="schedule-panel-body" data-onclick="common-classDashboard.27">
                  <span class="section-title">Class Schedule</span>
                  <span class="schedule-mobile-meta">
                    <span>Open</span>
                    <span class="schedule-mobile-chevron" aria-hidden="true">›</span>
                  </span>
                </button>
                <div class="schedule-panel-heading">
                  <h2 class="card-title">Class Schedule</h2>
                </div>
                <div class="schedule-toolbar" id="classScheduleToolbar"></div>
              </div>
              <div class="schedule-panel-body" id="schedule-panel-body">
                <div id="classScheduleNotice" class="schedule-notice" role="status" aria-live="polite"></div>
                <div id="classScheduleContent" class="schedule-shell">
                  <p style="color:#6b7280;font-size:13px;">Open the schedule tab to load the timetable.</p>
                </div>
              </div>
            </section>

            <% if (locals.classPickup) { %>
            <%
              // Pickup list: every student, how they go home (bus or family), and the
              // emergency & pickup details the school shares with teachers.
              const pkTime = (t) => { if (!t) return ''; const [h, m] = String(t).split(':').map(Number); return Number.isFinite(h) ? ((h % 12) || 12) + ':' + String(m || 0).padStart(2, '0') + (h < 12 ? ' AM' : ' PM') : ''; };
              const pkStudents = (students || []).map((st) => {
                const ride = classTransportByStudentId[st.student_id] || null;
                const family = classPickup[st.student_id] || [];
                return {
                  id: st.student_id,
                  name: [st.first_name, st.last_name].filter(Boolean).join(' ') || 'Student',
                  bus: ride && ride.routeId ? [ride.routeName, ride.stopName, pkTime(ride.dropoffTime) && ('Drop-off ' + pkTime(ride.dropoffTime))].filter(Boolean).join(' · ') : '',
                  family,
                  details: family.reduce((n, p) => n + p.sections.reduce((m, sec) => m + sec.items.length, 0), 0),
                };
              }).sort((a, b) => a.name.localeCompare(b.name));
            %>
            <section class="workspace-panel" id="panel-pickup" data-panel-key="pickup">
              <div class="workspace-panel-head">
                <div>
                  <h2 class="card-title">Pickup list</h2>
                  <p class="pk-sub">Who each student goes home with, and who to call.</p>
                </div>
              </div>
              <input type="search" class="pk-search" id="pkSearch" placeholder="Search students" autocomplete="off" aria-label="Search students" />
              <ul class="pk-list" id="pkList">
                <% pkStudents.forEach((st) => { %>
                <li class="pk-item" data-name="<%= st.name.toLowerCase() %>">
                  <details>
                    <summary>
                      <span class="pk-avatar" aria-hidden="true"><%= st.name.split(/\s+/).map((w) => w[0]).slice(0, 2).join('').toUpperCase() %></span>
                      <span class="pk-main">
                        <strong><%= st.name %></strong>
                        <span><%= st.bus ? 'Bus · ' + st.bus : (st.family.length ? 'Family pickup' : 'No family details yet') %></span>
                      </span>
                      <% if (st.bus) { %><span class="pk-tag pk-tag--bus">Bus</span><% } %>
                      <% if (st.details) { %><span class="pk-tag"><%= st.details %> detail<%= st.details === 1 ? '' : 's' %></span><% } %>
                      <svg class="pk-chev" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
                    </summary>
                    <div class="pk-body">
                      <% if (!st.family.length) { %><p class="pk-empty">No parents or guardians are linked yet.</p><% } %>
                      <% st.family.forEach((p) => { %>
                      <div class="pk-person">
                        <strong><%= p.name %></strong><% if (p.relationship) { %><span><%= p.relationship %></span><% } %>
                        <% const items = [].concat(...p.sections.map((sec) => sec.items)); %>
                        <% if (items.length) { %>
                        <dl class="pk-items"><% items.forEach((it) => { %><div><dt><%= it.label %></dt><dd><%= it.value %></dd></div><% }) %></dl>
                        <% } else { %><p class="pk-empty">Nothing added yet.</p><% } %>
                      </div>
                      <% }) %>
                    </div>
                  </details>
                </li>
                <% }) %>
              </ul>
              <p class="pk-empty" id="pkNone" hidden>No student matches.</p>
              <style>
                #panel-pickup .pk-sub { margin: 2px 0 0; font-size: 13px; color: #64748b; }
                #panel-pickup .pk-search { display: block; box-sizing: border-box; width: 100%; height: 38px; margin: 10px 0; padding: 0 12px; border: 1px solid var(--border, #e5e7eb); border-radius: 10px; background: transparent; color: inherit; font: inherit; font-size: 13px; }
                #panel-pickup .pk-list { list-style: none; margin: 0; padding: 0; display: grid; gap: 8px; }
                #panel-pickup .pk-item details { border: 1px solid var(--border, #e5e7eb); border-radius: 12px; background: var(--ap-surface, #fff); }
                #panel-pickup .pk-item summary { display: flex; align-items: center; gap: 10px; padding: 10px 12px; cursor: pointer; list-style: none; }
                #panel-pickup .pk-item summary::-webkit-details-marker { display: none; }
                #panel-pickup .pk-avatar { flex: none; display: grid; place-items: center; width: 34px; height: 34px; border-radius: 10px; background: color-mix(in srgb, var(--primary) 12%, #fff); color: var(--primary); font-size: 12px; font-weight: 800; }
                #panel-pickup .pk-main { flex: 1; min-width: 0; display: grid; }
                #panel-pickup .pk-main strong { font-size: 14px; }
                #panel-pickup .pk-main span { font-size: 12.5px; color: #64748b; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
                #panel-pickup .pk-tag { flex: none; padding: 2px 8px; border-radius: 999px; background: #f1f4f7; color: #475569; font-size: 11px; font-weight: 700; }
                #panel-pickup .pk-tag--bus { background: color-mix(in srgb, var(--primary) 12%, #fff); color: var(--primary); }
                #panel-pickup .pk-chev { flex: none; width: 16px; height: 16px; color: #94a3b8; transition: transform .2s; }
                #panel-pickup details[open] .pk-chev { transform: rotate(180deg); }
                #panel-pickup .pk-body { padding: 0 12px 12px 56px; display: grid; gap: 10px; }
                #panel-pickup .pk-person > strong { font-size: 13.5px; }
                #panel-pickup .pk-person > span { margin-left: 6px; font-size: 12px; color: #64748b; }
                #panel-pickup .pk-items { margin: 6px 0 0; display: grid; gap: 4px; }
                #panel-pickup .pk-items div { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.4fr); gap: 10px; font-size: 13px; }
                #panel-pickup .pk-items dt { color: #64748b; }
                #panel-pickup .pk-items dd { margin: 0; font-weight: 600; white-space: pre-line; overflow-wrap: anywhere; }
                #panel-pickup .pk-empty { margin: 0; font-size: 12.5px; color: #94a3b8; }
                @media (max-width: 600px) { #panel-pickup .pk-body { padding-left: 12px; } #panel-pickup .pk-tag:not(.pk-tag--bus) { display: none; } }
              </style>
              <script nonce="<%= locals.cspNonce || '' %>">
                (function () {
                  var box = document.getElementById('pkSearch');
                  if (!box) return;
                  box.addEventListener('input', function () {
                    var q = box.value.trim().toLowerCase(), shown = 0;
                    document.querySelectorAll('#pkList .pk-item').forEach(function (li) { var on = !q || li.getAttribute('data-name').indexOf(q) >= 0; li.hidden = !on; if (on) shown++; });
                    document.getElementById('pkNone').hidden = shown > 0;
                  });
                })();
              </script>
            </section>
            <% } %>

            <% if (locals.classSettingsPanel && locals.featureOn && featureOn('class_settings')) { %>
              <%- include('../partials/classSettingsPanel', { panel: classSettingsPanel }) %>
            <% } %>

            <% if (locals.customFormsReady && customFormsReady()) { %>
            <section class="workspace-panel" id="panel-forms" data-panel-key="forms">
              <link rel="stylesheet" href="<%= assetUrl('/css/customForms.css') %>" />
              <%# Classroom sections the school built in the Custom editor, filled in here for this class.
                  One with a menu item of its own opens here by itself (openWorkspaceFormTab). %>
              <div id="panel-forms-fill" data-cf-fill data-skip-tiles data-base="/common/forms" data-class-id="<%= classId %>" data-term-id="<%= currentTerm.term_id %>" data-empty="Forms your school builds in Management › Custom editor show here."></div>
              <script src="<%= assetUrl('/js/customFormRender.js') %>" defer></script>
              <script src="<%= assetUrl('/js/customFormsFill.js') %>" defer></script>
            </section>
            <% } %>

            <%# Activities belong to the class, not to the bus: its panel exists whenever the menu item does. %>
            <section class="workspace-panel" id="panel-activities" data-panel-key="activities">
              <link rel="stylesheet" href="<%= assetUrl('/css/activities.css') %>" />
              <div data-activities data-class-id="<%= classId %>"></div>
              <script src="<%= assetUrl('/js/activities.js') %>" defer></script>
            </section>
            <% if (transportActive) { %>
            <section class="workspace-panel" id="panel-transportation" data-panel-key="transportation">
              <%
                // Riders grouped by route (in pickup order); details load on demand when a rider is opened.
                const tpTime = (t) => {
                  if (!t) return '';
                  const [h, m] = String(t).split(':').map(Number);
                  if (!Number.isFinite(h)) return '';
                  return ((h % 12) || 12) + ':' + String(m || 0).padStart(2, '0') + (h < 12 ? ' AM' : ' PM');
                };
                // Same colours as every other bus map (public/js/managiraMaps.js routeColor).
                const tpColors = ['#0f766e', '#2563eb', '#ea580c', '#9333ea', '#be123c', '#0284c7', '#4d7c0f'];
                const tpRoutes = [];
                const tpNonRiders = [];
                classTransportRows.forEach((row) => {
                  if (!row.routeId) { tpNonRiders.push(row); return; }
                  let route = tpRoutes.find((r) => r.id === row.routeId);
                  if (!route) {
                    route = { id: row.routeId, name: row.routeName || 'Route', bus: row.busNumber, driver: row.driverName, live: false, riders: [] };
                    tpRoutes.push(route);
                  }
                  if (!route.driver && row.driverName) route.driver = row.driverName;
                  if (row.liveRecordedAt) route.live = true;
                  route.riders.push(row);
                });
                tpRoutes.forEach((r) => {
                  r.color = tpColors[Math.abs(Number(r.id) || 0) % tpColors.length];
                  r.riders.sort((a, b) => String(a.pickupTime || '').localeCompare(String(b.pickupTime || '')) || String(a.studentName).localeCompare(String(b.studentName)));
                });
                const tpRiderCount = tpRoutes.reduce((n, r) => n + r.riders.length, 0);
              %>
              <div class="workspace-panel-head">
                <div>
                  <h2 class="card-title">Transportation</h2>
                </div>
                <% if (classTransportRows.length) { %>
                <div class="tp-stats">
                  <span><strong><%= tpRiderCount %></strong> of <%= classTransportRows.length %> ride</span>
                  <span><strong><%= tpRoutes.length %></strong> <%= tpRoutes.length === 1 ? 'route' : 'routes' %></span>
                </div>
                <% } %>
              </div>
              <% if (tpRiderCount) { %>
              <% if (classTransportationMapRows.length) { %>
              <div class="tp-map">
                <div id="classDashboardTransportMap" class="transport-mini-map" data-routes="<%= JSON.stringify(tpRoutes.map(function(r) { return { id: r.id, color: r.color }; })) %>"></div>
                <div class="tp-map__chips" role="group" aria-label="Show a route">
                  <button type="button" class="is-on" data-tp-route="">All routes</button>
                  <% tpRoutes.forEach(function(route) { %><button type="button" data-tp-route="<%= route.id %>" style="--route:<%= route.color %>"><%= route.name %></button><% }); %>
                </div>
              </div>
              <% } %>
              <input type="search" class="tp-search" id="tpRiderSearch" placeholder="Search students" autocomplete="off" aria-label="Search students" style="display:block;box-sizing:border-box;width:100%;height:38px;margin:10px 0;padding:0 12px;border:1px solid var(--border,#e5e7eb);border-radius:10px;background:transparent;color:inherit;" />
              <link rel="stylesheet" href="<%= assetUrl('/css/busBoarding.css') %>" />
              <script src="<%= assetUrl('/js/busBoarding.js') %>" defer></script>
              <div class="tp-routes" data-class-riding="<%= classId %>">
                <% tpRoutes.forEach(function(route) { %>
                <details class="tp-route" style="--route:<%= route.color %>">
                  <summary class="tp-route__head">
                    <span class="tp-route__dot" aria-hidden="true"></span>
                    <div class="tp-route__title">
                      <strong><%= route.name %></strong>
                      <span><%= [route.bus, route.driver].filter(Boolean).join(' · ') || 'No bus assigned' %></span>
                    </div>
                    <% if (route.live) { %><span class="tp-live">Live</span><% } %>
                    <span class="tp-route__count"><%= route.riders.length %> <%= route.riders.length === 1 ? 'rider' : 'riders' %></span>
                    <svg class="tp-route__chev" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
                  </summary>
                  <div class="tp-riders" role="list">
                    <div class="tp-rider tp-rider--head tp-rider--today" aria-hidden="true"><span>Student</span><span>Stop</span><span>Pick-up</span><span>Drop-off</span><span>Today</span></div>
                    <% route.riders.forEach(function(row) { %>
                    <div class="tp-rider tp-rider--today" role="listitem" tabindex="0"
                      data-onkeydown="common-classDashboard.28"
                      data-onclick="common-classDashboard.29" data-mga0="<%= row.studentId %>" data-mga1="<%= String(row.studentName || '') %>">
                      <span class="tp-rider__name"><%= row.studentName %></span>
                      <span class="tp-rider__stop"><%= row.stopName || '—' %></span>
                      <span class="tp-rider__time"><%= tpTime(row.pickupTime) || '—' %></span>
                      <span class="tp-rider__time tp-rider__time--off"><%= tpTime(row.dropoffTime) || '—' %></span>
                      <button type="button" class="tp-coming" data-coming="<%= row.studentId %>" aria-pressed="true">Coming</button>
                    </div>
                    <% }); %>
                  </div>
                </details>
                <% }); %>
              </div>
              <% if (tpNonRiders.length) { %>
              <div class="tp-none">
                <span class="tp-none__label">Not on a bus · <%= tpNonRiders.length %></span>
                <div class="tp-none__names"><% tpNonRiders.forEach(function(row) { %><span><%= row.studentName %></span><% }); %></div>
              </div>
              <% } %>
              <% } else { %>
              <p class="card-subtext">No students in this class ride a bus yet.</p>
              <% } %>
              <% const canSeeBusReports = typeof workspaceAccess === 'function' && workspaceAccess().transport.classReports; %>
              <% if (canSeeBusReports) { %>
              <div class="tp-reports" id="classBusReports" data-class-id="<%= classId %>" hidden>
                <h3 class="tp-reports__title">Bus reports</h3>
                <ul class="tp-reports__list" id="classBusReportsList"></ul>
              </div>
              <% } %>
              <script nonce="<%= locals.cspNonce || '' %>">
                (function () {
                  var search = document.getElementById('tpRiderSearch');
                  if (!search) return;
                  search.addEventListener('input', function () {
                    var wanted = search.value.trim().toLowerCase();
                    document.querySelectorAll('.tp-route').forEach(function (route) {
                      var any = false;
                      route.querySelectorAll('.tp-rider:not(.tp-rider--head)').forEach(function (rider) {
                        var match = !wanted || rider.textContent.toLowerCase().indexOf(wanted) >= 0;
                        rider.style.display = match ? '' : 'none';
                        any = any || match;
                      });
                      route.style.display = any ? '' : 'none';
                      if (wanted) route.open = any;
                    });
                  });
                })();
              </script>
              <% if (canSeeBusReports) { %>
              <script nonce="<%= locals.cspNonce || '' %>">
                (function () {
                  var box = document.getElementById('classBusReports');
                  if (!box || !window.IntersectionObserver) return;
                  var clean = function (v) { var d = document.createElement('div'); d.textContent = v == null ? '' : v; return d.innerHTML; };
                  var when = function (v) { return new Date(v).toLocaleDateString(undefined, { month: 'short', day: 'numeric' }); };
                  var panel = document.getElementById('panel-transportation');
                  var loaded = false;
                  new IntersectionObserver(function (entries) {
                    if (loaded || !entries[0].isIntersecting) return;
                    loaded = true;
                    fetch('/transportation/reports/class/' + box.getAttribute('data-class-id'), { headers: { Accept: 'application/json' } })
                      .then(function (r) { return r.json(); })
                      .then(function (data) {
                        if (!data.success || !data.reports.length) return;
                        document.getElementById('classBusReportsList').innerHTML = data.reports.map(function (r) {
                          return '<li class="tp-report"><div class="tp-report__top"><strong>' + clean(r.studentName || r.categoryLabel) + '</strong><time>' + clean(when(r.createdAt)) + '</time></div>'
                            + (r.issue ? '<div class="tp-report__issue">' + clean(r.issue) + '</div>' : '')
                            + (r.details ? '<p class="tp-report__text">' + clean(r.details) + '</p>' : '')
                            + (r.note ? '<p class="tp-report__text tp-report__text--note">From the school: ' + clean(r.note) + '</p>' : '')
                            + '</li>';
                        }).join('');
                        box.hidden = false;
                      }).catch(function () {});
                  }).observe(panel);
                })();
              </script>
              <% } %>
            </section>
            <% } %>

            <section class="workspace-panel" id="panel-students" data-panel-key="students">
              <div class="workspace-panel-head">
                <div>
                  <h2 class="card-title">Students</h2>
                  <p class="card-subtext">Select a student to open a dedicated work session.</p>
                </div>
              </div>
              <div class="workspace-resource-grid">
                <% if (students.length > 0) { %>
                  <% students.forEach(function(student) { %>
                    <% const workspaceStudentName = (typeof formatDisplayName === 'function' ? formatDisplayName(student) : [student.first_name, student.last_name].filter(Boolean).join(' ').trim()); %>
                    <button class="workspace-resource-button" type="button" data-onclick="common-classDashboard.21" data-mga0="<%= student.student_id %>">
                      <span class="workspace-resource-text">
                        <strong><%= workspaceStudentName %></strong>
                        <span>Open student record</span>
                      </span>
                      <span class="workspace-resource-arrow">›</span>
                    </button>
                  <% }); %>
                <% } else { %>
                  <p class="card-subtext"><%= _noStudentsText %></p>
                <% } %>
              </div>
            </section>

            <section class="workspace-panel" id="panel-subjects" data-panel-key="subjects">
              <div class="workspace-panel-head">
                <div>
                  <h2 class="card-title">Subjects</h2>
                  <p class="card-subtext">Open a subject for its assessments and grades.</p>
                </div>
              </div>
              <div class="workspace-resource-grid">
                <% if (hasAssessmentFeature && subjects.length > 0) { %>
                  <% subjects.forEach(function(subject) { %>
                    <button class="workspace-resource-button" type="button" data-onclick="common-classDashboard.16" data-mga0="<%= subject.subject_id %>">
                      <span class="workspace-resource-text">
                        <strong><%= subject.subject_name %></strong>
                      </span>
                      <span class="workspace-resource-arrow">›</span>
                    </button>
                  <% }); %>
                <% } else { %>
                  <p class="card-subtext">No subjects assigned yet.</p>
                <% } %>
              </div>
            </section>

            <div id="workspaceDynamicPanels"></div>
            <div id="workspaceIframeCache" hidden></div>
          </div>
        </section>

        <div class="report-modal-overlay" id="reportDetailModal">
          <div class="report-modal-box">
            <button class="report-modal-close" data-onclick="common-classDashboard.30">×</button>
            <div id="reportDetailContent">
              <p style="color:#6b7280;">Loading...</p>
            </div>
          </div>
        </div>

        <div class="student-remark-modal-overlay" id="studentTeacherRemarkModal" data-onclick="common-classDashboard.31">
          <div class="student-remark-modal-box" role="dialog" aria-modal="true" aria-labelledby="studentTeacherRemarkModalTitle">
            <div class="student-remark-modal-head">
              <h3 class="student-remark-modal-title" id="studentTeacherRemarkModalTitle">Student Remark</h3>
              <button type="button" class="student-remark-modal-close" data-onclick="common-classDashboard.32" aria-label="Close">×</button>
            </div>
            <div class="student-remark-modal-body">
              <div id="studentRemarkEditorsContainer"></div>
            </div>
            <div class="student-remark-modal-actions">
              <button type="button" class="btn btn-secondary" data-onclick="common-classDashboard.32">Cancel</button>
              <button type="button" class="btn" id="studentTeacherRemarkSaveBtn" data-onclick="common-classDashboard.33">Save Remark</button>
            </div>
          </div>
        </div>

        <% if (transportActive) { %><script src="<%= assetUrl('/js/busRequest.js') %>" defer></script><% } %>
        <div class="transport-modal-overlay" id="studentTransportModal" data-onclick="common-classDashboard.34">
          <div class="transport-modal-box" role="dialog" aria-modal="true" aria-labelledby="studentTransportModalTitle">
            <div class="transport-modal-head">
              <h3 class="transport-modal-title" id="studentTransportModalTitle">Transportation Details</h3>
              <button type="button" class="transport-modal-close" data-onclick="common-classDashboard.35" aria-label="Close">×</button>
            </div>
            <div class="transport-modal-body">
              <div id="studentTransportModalStatus" class="card-subtext">Loading transportation details...</div>
              <div id="studentTransportModalSummary"></div>
              <div id="studentTransportModalGrid" class="transport-detail-grid"></div>
              <div id="studentTransportModalMap" class="transport-modal-map"></div>
            </div>
          </div>
        </div>
      </main>
    </div>
  </div>

  <script src="/js/managiraMaps.js?v=<%= assetVersion %>"></script>
  <script nonce="<%= locals.cspNonce || '' %>">
    var classScheduleContext;
    var classScheduleState;
    var workspaceContext;
    var workspaceState;
    var studentTeacherRemarkState;

    (function () {
      classScheduleContext = {
        classId: Number('<%= classId %>'),
        termId: Number('<%= currentTerm.term_id %>'),
        schoolYearId: Number('<%= schoolYear.id %>'),
        schoolYearLabel: <%- JSON.stringify(schoolYear.year_label) %>,
        termName: <%- JSON.stringify(currentTerm.term_name) %>,
        className: <%- JSON.stringify(className) %>,
        schoolName: <%- JSON.stringify((session && session.organizationName) || '') %>,
        logoUrl: <%- JSON.stringify((session && session.logo) || '') %>,
        orgPrimaryColor: '',
        orgPrimaryHover: '',
        canEdit: <%= canEditClassSchedule ? 'true' : 'false' %>,
        weekdays: <%- JSON.stringify(classScheduleWeekdays || []) %>,
      };
      var classScheduleRootStyles = window.getComputedStyle(document.documentElement);
      classScheduleContext.orgPrimaryColor = classScheduleRootStyles.getPropertyValue('--org-primary-color').trim() || <%- JSON.stringify(currentTheme.primary) %>;
      classScheduleContext.orgPrimaryHover = classScheduleRootStyles.getPropertyValue('--org-primary-hover').trim() || <%- JSON.stringify(currentTheme.hover) %>;
      classScheduleState = {
        payload: <%- JSON.stringify(initialClassScheduleData || null) %>,
        draftRows: [],
        isLoadedOnce: <%= initialClassScheduleData ? 'true' : 'false' %>,
        isCreating: false,
        isEditing: false,
        pendingAction: '',
      };

      workspaceContext = {
        classId: Number('<%= classId %>'),
        termId: Number('<%= currentTerm.term_id %>'),
        className: <%- JSON.stringify(className) %>,
        basePath: <%- JSON.stringify(typeof classWorkspaceBasePath !== 'undefined' ? classWorkspaceBasePath : (`/common/classDashboard/${classId}`)) %>,
        initialRoute: <%- JSON.stringify(typeof initialWorkspaceRoute !== 'undefined' ? initialWorkspaceRoute : { panel: 'overview', itemId: '' }) %>,
        attendanceUrl: <%- JSON.stringify(`/common/attendanceCollection?classId=${classId}&termId=${currentTerm.term_id}&embed=workspace`) %>,
        assessmentQuestionsUrl: <%- JSON.stringify(`/common/allClassAssessmentExams?classId=${classId}&schoolYearId=${schoolYear.id}&termId=${currentTerm.term_id}&embed=workspace`) %>,
        docsUrl: <%- JSON.stringify(`/documents?classId=${classId}&embed=workspace`) %>,
        paygiraUrl: <%- JSON.stringify(`/account/settings/my-paygira?embed=workspace&classId=${classId}`) %>,
        briefingUrl: <%- JSON.stringify(`/common/briefing/class/${classId}?embed=workspace`) %>,
        canOpenBriefing: <%= _briefingAllowed ? 'true' : 'false' %>,
        students: <%- JSON.stringify(workspaceStudents) %>,
        subjects: <%- JSON.stringify(workspaceSubjects) %>,
        canOpenAttendance: <%= _offerAttendance ? 'true' : 'false' %>,
        attendanceOffered: <%= _offerBase ? 'true' : 'false' %>,
        attServices: <%- JSON.stringify({ attendance: Boolean(_svc.attendance), lunch: Boolean(_svc.lunch), name: _svc.name, icons: _svcIcons }) %>,
        attIconSvg: <%- JSON.stringify({ attendance: navIcon('attendance'), lunch: navIcon('lunch') }) %>,
        canOpenAssessmentQuestions: <%= canAccessAssessmentQuestions ? 'true' : 'false' %>,
        canOpenSubjects: <%= hasAssessmentFeature ? 'true' : 'false' %>,
        canOpenDocs: <%= hasFilesFeature ? 'true' : 'false' %>,
        canOpenPaygira: <%- JSON.stringify(_canOpenPaygiraWorkspace) %>,
      };

      workspaceState = {
        tabs: [],
        activeTabId: '',
      };

      studentTeacherRemarkState = {
        classId: Number('<%= classId %>'),
        termId: Number('<%= currentTerm.term_id %>'),
        studentId: null,
        studentName: '',
        isLoading: false,
        isSaving: false,
        optionsCache: <%- JSON.stringify(Array.isArray(teacherRemarkOptions) ? teacherRemarkOptions : []) %>,
        selectedRemarkTypes: <%- JSON.stringify(Array.isArray(classroomRemarkTypes) ? classroomRemarkTypes : ['teacher']) %>,
        customRemarkTypes: <%- JSON.stringify(Array.isArray(classroomCustomRemarkTypes) ? classroomCustomRemarkTypes : []) %>,
        optionsLoadedAt: Date.now(),
        optionsMaxAgeMs: 2 * 60 * 1000,
        <%# Without the pencil (remarks come from the Custom editor), names aren't marked for old remarks. %>
        studentRemarkCache: <%- JSON.stringify(locals.showRemarkPencil === false ? {} : (studentTeacherRemarksMap || {})) %>,
        activeLoadToken: 0,
        inputDirty: false,
      };

      var builtinRemarkTypeLabels = {
        teacher: "Teacher's Remarks",
        conduct: 'Conduct Remarks',
        interest: 'Interest Remarks',
        attitude: 'Attitude Remarks',
      };

      var remarkTypeLabels = Object.assign({}, builtinRemarkTypeLabels);

      function buildCustomRemarkTypeLabel(typeKey) {
        var normalized = String(typeKey || '').trim().toLowerCase();
        if (!normalized || normalized.indexOf('custom:') !== 0) return "Teacher's Remarks";
        return normalized
          .replace(/^custom:/, '')
          .split(/[-_\s]+/)
          .filter(Boolean)
          .map(function(part) { return part.charAt(0).toUpperCase() + part.slice(1); })
          .join(' ') || 'Custom Remarks';
      }

      function rebuildRemarkTypeLabels() {
        remarkTypeLabels = Object.assign({}, builtinRemarkTypeLabels);
        var customTypes = Array.isArray(studentTeacherRemarkState.customRemarkTypes)
          ? studentTeacherRemarkState.customRemarkTypes
          : [];

        customTypes.forEach(function(typeRow) {
          var typeKey = String(typeRow && typeRow.type_key ? typeRow.type_key : '').trim().toLowerCase();
          if (!typeKey || typeKey.indexOf('custom:') !== 0) return;
          var label = String(typeRow && typeRow.label ? typeRow.label : '').trim() || buildCustomRemarkTypeLabel(typeKey);
          remarkTypeLabels[typeKey] = label;
        });
      }

      rebuildRemarkTypeLabels();

      function getWorkspacePanelsRoot() {
        return document.getElementById('workspacePanels');
      }

      function getWorkspaceDynamicPanelsRoot() {
        return document.getElementById('workspaceDynamicPanels');
      }

      function getWorkspaceIframeCache() {
        return document.getElementById('workspaceIframeCache');
      }

      var WS_IFRAME_CACHE_MAX = 5;

      function getWorkspaceTabBar() {
        return document.getElementById('workspaceTabBar');
      }

      function getWorkspaceEmptyState() {
        return document.getElementById('workspaceEmptyState');
      }

      function getWorkspaceTabById(tabId) {
        return workspaceState.tabs.find(function(tab) {
          return tab.id === tabId;
        }) || null;
      }

      function getWorkspaceTabIndex(tabId) {
        return workspaceState.tabs.findIndex(function(tab) {
          return tab.id === tabId;
        });
      }

      function getWorkspaceSidebarKey(tab) {
        if (!tab) return '';
        if (tab.sidebarKey) return tab.sidebarKey;
        if (tab.id.indexOf('student:') === 0) return 'students';
        if (tab.id.indexOf('subject:') === 0) return 'subjects';
        return tab.id;
      }

      function syncWorkspaceSidebarState(activeTab) {
        var activeSidebarKey = getWorkspaceSidebarKey(activeTab);
        Array.prototype.forEach.call(document.querySelectorAll('[data-nav-key]'), function(node) {
          node.classList.toggle('active', node.getAttribute('data-nav-key') === activeSidebarKey);
        });
      }

      function updateWorkspaceChrome() {
        var emptyState = getWorkspaceEmptyState();
        var panelsRoot = getWorkspacePanelsRoot();
        if (!emptyState || !panelsRoot) return;
        var hasTabs = workspaceState.tabs.length > 0;
        emptyState.hidden = hasTabs;
        panelsRoot.hidden = !hasTabs;
        if (!hasTabs) {
          Array.prototype.forEach.call(document.querySelectorAll('.workspace-panel'), function(panel) {
            panel.hidden = true;
            panel.classList.remove('is-active');
          });
        }
      }

      function renderWorkspaceTabBar() {
        var tabBar = getWorkspaceTabBar();
        if (!tabBar) return;
        var tabsMarkup = workspaceState.tabs.map(function(tab) {
          var isActive = tab.id === workspaceState.activeTabId;
          return '' +
            '<div class="workspace-tab' + (isActive ? ' is-active' : '') + '">' +
              '<button type="button" class="workspace-tab-activate" data-tab-id="' + esc(tab.id) + '" data-onclick="common-classDashboard.activateTab"' + (isActive ? ' aria-current="true"' : '') + '>' +
                '<span class="workspace-tab-label">' + esc(tab.title) + '</span>' +
              '</button>' +
              '<button type="button" class="workspace-tab-close" data-tab-id="' + esc(tab.id) + '" aria-label="Close ' + esc(tab.title) + '" data-onclick="common-classDashboard.closeTab">×</button>' +
            '</div>';
        }).join('');
        tabBar.innerHTML = tabsMarkup;
      }

      function showWorkspacePanel(panelId) {
        Array.prototype.forEach.call(document.querySelectorAll('.workspace-panel'), function(panel) {
          var isActive = panel.id === panelId;
          panel.hidden = !isActive;
          panel.classList.toggle('is-active', isActive);
        });
      }

      // The spinner shows while a page opens in the classroom and again when a link inside it opens another page.
      function bindWorkspaceFrame(panel) {
        var frame = panel && panel.querySelector('iframe.workspace-frame');
        if (!frame || frame.dataset.wsBound) return;
        frame.dataset.wsBound = '1';
        var timer = null;
        function stop() { clearTimeout(timer); panel.classList.remove('is-loading'); }
        function start() { if (panel.__wsSilent) return; panel.classList.add('is-loading'); clearTimeout(timer); timer = setTimeout(stop, 10000); }
        frame.addEventListener('load', function () {
          panel.__wsSilent = false;
          stop();
          try { frame.contentWindow.addEventListener('beforeunload', start); } catch (e) { /* another origin */ }
        });
        panel.__wsLoading = start;
      }
      function showWorkspaceFrameLoading(panel) { bindWorkspaceFrame(panel); if (panel && panel.__wsLoading) panel.__wsLoading(); }

      function ensureWorkspaceFramePanel(tab) {
        var root = getWorkspaceDynamicPanelsRoot();
        if (!root) return;

        var existing = document.getElementById(tab.panelId);
        var cache = getWorkspaceIframeCache();

        // Already in active panels — nothing to do
        if (existing && (!cache || existing.parentNode !== cache)) return;

        // Found in the cache — restore it instantly, refresh data in background
        if (existing && cache && existing.parentNode === cache) {
          var cachedIframe = existing.querySelector('.workspace-frame');
          if (cachedIframe) {
            if (cachedIframe.getAttribute('src') !== tab.iframeSrc) {
              // URL changed (different student/term/etc) — load the new URL
              showWorkspaceFrameLoading(existing);
              cachedIframe.setAttribute('src', tab.iframeSrc);
            } else {
              // Same URL — show stale content immediately, silently reload in background
