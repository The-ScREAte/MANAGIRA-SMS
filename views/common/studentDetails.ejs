              .then(function (r) { if (!r.ok) throw new Error('status'); return r.json(); }).then(function (d) {
                body.textContent = '';
                var bills = d.bills || [];
                if (!bills.length) { body.appendChild(el('p', 'sd-empty', 'No bills have been assigned to this student.')); return; }
                var owed = bills.reduce(function (n, b) { return n + (Number(b.balance) || 0); }, 0);
                var open = bills.filter(function (b) { return (Number(b.balance) || 0) > 0.004; });
                var grid = el('div', 'sd-stats');
                grid.appendChild(stat('Outstanding', money.format(owed), open.length ? open.length + (open.length === 1 ? ' open bill' : ' open bills') : 'Nothing owed', owed > 0.004));
                if (Number(d.credit) > 0) grid.appendChild(stat('Credit', money.format(Number(d.credit)), 'on account'));
                var lastPay = (d.payments || [])[0];
                grid.appendChild(stat('Last payment', lastPay ? money.format(Number(lastPay.amount) || 0) : '—', lastPay ? (lastPay.received_display || '') : 'No payments yet'));
                body.appendChild(grid);
                var shown = (open.length ? open : bills).slice(0, 5);
                body.appendChild(el('p', 'sd-sub', open.length ? 'Open bills' : 'Recent bills'));
                shown.forEach(function (b) {
                  var row = el('div', 'sd-billrow');
                  row.appendChild(el('strong', null, b.title || 'Bill'));
                  row.appendChild(el('span', null, b.due_display ? 'Due ' + b.due_display : 'No due date'));
                  row.appendChild(el('div', 'sd-amt', money.format(open.length ? Number(b.balance) || 0 : Number(b.amount) || 0)));
                  body.appendChild(row);
                });
                if (bills.length > shown.length) body.appendChild(el('p', 'sd-sub', 'and ' + (bills.length - shown.length) + ' more in Bills & payments'));
              }).catch(function () { failed(body, 'Bills'); delete once.bills; });
          }
          var loaders = { attendance: loadAttendance, bills: loadBills };
          function open(key) { if (loaders[key] && !once[key]) { once[key] = true; loaders[key](); } }
          window.addEventListener('sd:tab', function (e) { open(e.detail); });
          open(String(location.hash).replace('#', ''));
        })();
      </script>
      <% } %>
      <% if (_hasMessages) { %>
