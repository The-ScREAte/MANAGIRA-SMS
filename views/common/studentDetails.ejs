    <style>
      :root {
        --font-family: "<%= (session && session.fontStyle ? String(session.fontStyle).trim() : 'Inter') %>", sans-serif;
        --primary: var(--org-primary-color, #01535b);
        --primary-hover: var(--org-primary-hover, #014a51);
        --primary-hover-fill: color-mix(in srgb, var(--primary) 88%, white);
        --border: #e5e7eb;
        --bg: #f8fafc;
        --text: #0f172a;
        --text-muted: #64748b;
        --surface-muted: #f8fafc;
        --shadow-soft: 0 16px 30px rgba(15, 23, 42, 0.08);
      }

      body {
        font-family: var(--font-family);
      }

      body {
        background-color: var(--bg);
        margin: 0;
        text-align: center;
      }

      .sd-page {
        margin: 0 auto;
        width: min(1100px, 94%);
        max-width: 100%;
        border: 1px solid var(--border);
        border-radius: 14px;
        box-shadow: none;
        padding: 20px;
        background: #ffffff;
      }

      <% if (locals.isEmbedded) { %>
      /* Embedded inside the class-dashboard workspace iframe: the shell
         around the iframe already provides the card chrome (header, border,
         background), so this page fills it edge-to-edge instead of nesting
         a second bordered card inside it. */
      .sd-page {
        width: 100%;
        max-width: none;
        margin: 0;
        border: none;
        border-radius: 0;
        padding: 18px 22px 22px;
      }
      <% } %>

      .flash-message {
        margin: 0 0 14px;
        padding: 10px 14px;
        border-radius: 10px;
        font-size: 0.82rem;
        text-align: left;
      }
      .flash-message.error,
      .flash-message.flash-error { background: #fef2f2; color: #b91c1c; border: 1px solid #fecaca; }
      .flash-message.success { background: #f0fdf4; color: #166534; border: 1px solid #bbf7d0; }
      .flash-message.info { background: #eff6ff; color: #1d4ed8; border: 1px solid #bfdbfe; }
      .flash-close { cursor: pointer; float: right; font-weight: 700; opacity: 0.6; }
      .flash-close:hover { opacity: 1; }

      .btn {
        padding: 7px 10px;
        margin: 6px;
        cursor: pointer;
        text-decoration: none;
        font-size: 0.8rem;
        font-weight: 600;
      }

      .btn-secondary {
        background-color: var(--primary);
        color: white;
      }

      

      .btn-primary {
        background-color: var(--org-primary-color);
        color: white;
      }
      
      

      .table-container {
        overflow-x: auto;
        margin: 14px auto;
        border: 1px solid var(--border);
        border-radius: 12px;
        background: #fff;
      }

      table {
        width: 100%;
        border-collapse: collapse;
      }

      th,
      td {
        padding: 8px;
        border: 1px solid #ddd;
        text-align: left;
      }

      th {
        font-weight: bold;
        background: #f8fafc;
        font-size: 0.76rem;
        line-height: 1.25;
      }

      td {
        font-size: 0.74rem;
        line-height: 1.3;
      }

      th small,
      td small {
        font-size: 0.68rem;
      }

      .student-info-container {
        display: grid;
        grid-template-columns: minmax(148px, 172px) minmax(0, 1fr);
        align-items: stretch;
        gap: 18px;
        margin: 0;
        border: none;
        border-radius: 0;
        padding: 0;
        background: transparent;
        box-shadow: none;
      }

      .student-image-container {
        display: flex;
        align-items: center;
        justify-content: center;
        text-align: center;
        padding: 0;
        margin-bottom: 0 !important;
        border-radius: 0;
        border: none;
        background: transparent;
      }

      .student-image-container img {
        width: min(100%, 144px);
        height: min(100%, 144px);
        border-radius: 50%;
        border: 4px solid rgba(255, 255, 255, 0.95);
        box-shadow: 0 10px 28px rgba(15, 23, 42, 0.12);
        object-fit: cover;
      }

      .student-details {
        display: flex;
        flex-direction: column;
        justify-content: center;
        gap: 12px;
        min-width: 0;
        font-size: 12px;
        color: var(--text-muted);
        text-align: left;
      }

      .student-details h2 {
        font-size: clamp(1.05rem, 1.7vw, 1.35rem);
        margin: 0;
        color: var(--text);
        line-height: 1.1;
      }

      .student-heading-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 8px;
        flex-wrap: nowrap;
      }

      .student-heading-actions {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        flex-wrap: wrap;
        justify-content: flex-end;
      }

      .student-portal-request-btn {
        margin: 0;
        padding: 2px 5px !important;
        border: 1px solid rgba(1, 83, 91, 0.2);
        border-radius: 999px;
        font-size: 0.5rem !important;
        font-weight: 700;
        line-height: 1.2;
        white-space: nowrap;
        width: auto;
        min-height: 0 !important;
      }

      /* Override shared .btn sizing rules for this compact action chip */
      .btn.btn-primary.student-portal-request-btn {
        padding: 2px 5px !important;
        font-size: 0.5rem !important;
        margin: 0 !important;
      }

      .student-portal-status {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        padding: 4px 8px;
        border-radius: 999px;
        font-size: 0.62rem;
        font-weight: 700;
        letter-spacing: 0.01em;
        border: 1px solid #86efac;
        background: #f0fdf4;
        color: #166534;
      }

      .student-portal-check {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 14px;
        height: 14px;
        border-radius: 999px;
        background: #22c55e;
        color: #ffffff;
        font-size: 0.58rem;
        line-height: 1;
        font-weight: 800;
      }

      .student-id-chip {
        display: inline-flex;
        align-items: center;
        padding: 4px 8px;
        border: 1px solid rgba(1, 83, 91, 0.18);
        border-radius: 999px;
        background: color-mix(in srgb, var(--primary) 8%, white);
        color: var(--primary);
        font-size: 0.68rem;
        font-weight: 700;
        font-family: 'SFMono-Regular', Consolas, monospace;
        letter-spacing: 0.02em;
        box-shadow: 0 4px 12px rgba(1, 83, 91, 0.08);
      }

      .student-edit-link {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        padding: 5px 10px;
        border-radius: 999px;
        background: var(--primary);
        color: #ffffff;
        font-size: 0.72rem;
        font-weight: 600;
        text-decoration: none;
        white-space: nowrap;
      }

      .student-details-toggle {
        display: none;
        align-self: flex-start;
        align-items: center;
        gap: 8px;
        margin-top: -2px;
        padding: 8px 12px;
        border: 1px solid var(--border);
        border-radius: 999px;
        background: rgba(255, 255, 255, 0.94);
        color: var(--text);
        font-size: 0.8rem;
        font-weight: 600;
        cursor: pointer;
        box-shadow: 0 4px 12px rgba(15, 23, 42, 0.06);
      }

      .student-details-toggle::after {
        content: '▾';
        font-size: 0.72rem;
        transition: transform 0.2s ease;
      }

      .student-details-toggle[aria-expanded="true"]::after {
        transform: rotate(180deg);
      }

      .student-extra-details {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
      }

      .student-extra-details p {
        margin: 0;
        display: flex;
        flex-direction: column;
        gap: 3px;
        padding: 7px 12px;
        flex: 0 1 auto;
        min-width: 0;
        border: 1px solid var(--border);
        border-radius: 10px;
        background: #ffffff;
        color: var(--text);
        font-size: 0.73rem;
      }

      .student-extra-details p strong {
        font-size: 0.64rem;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        color: var(--text-muted);
      }

      h1 {
        margin: 0 0 10px;
        color: var(--text);
        text-align: left;
      }

      h3 {
        margin: 14px 0 8px;
        color: var(--text);
        font-size: 0.9rem;
      }

      .link-to-next-back {
        text-align: center;
        padding-top: 12px;
        margin-bottom: 10px;
      }
      @media screen and (max-width: 768px) {
        h1 {
          font-size: 1.5rem;
        }
      
        h2 {
          font-size: 1.2rem;
        }
      
        h3 {
          font-size: 0.88rem;
        }
      
        .btn {
          width: auto;
          font-size: 0.76rem;
          padding: 5px 8px;
          margin: 5px 3px;
        }
      
        .student-info-container {
          grid-template-columns: 1fr;
          align-items: center;
          gap: 10px;
          margin: 0;
          padding: 10px;
          justify-items: center;
          text-align: center;
        }

        .student-image-container {
          width: 100%;
          justify-content: center;
        }
      
        .student-image-container img {
          width: 120px;
          height: 120px;
        }
      
        .student-details {
          font-size: 0.7rem;
          align-items: center;
          text-align: center;
          gap: 3px;
          width: 100%;
        }

        .student-details-toggle {
          display: inline-flex;
        }

        .student-extra-details {
          display: none;
          width: 100%;
          grid-template-columns: repeat(2, minmax(0, 1fr));
          gap: 5px;
        }

        .student-info-container.open .student-extra-details {
          display: grid;
        }

        .student-extra-details p {
          min-height: 0;
          padding: 5px 6px;
          gap: 2px;
          font-size: 0.66rem;
        }
      
        .student-details h2 {
          font-size: 0.82rem;
        }

        .student-id-chip {
          padding: 3px 8px;
          font-size: 0.62rem;
        }

        .student-heading-actions {
          width: 100%;
          justify-content: center;
          gap: 3px;
        }

        .student-heading-row {
          align-items: center;
          justify-content: center;
          flex-wrap: wrap;
          gap: 5px;
        }

        .student-portal-request-btn {
          font-size: 0.54rem !important;
          padding: 2px 6px !important;
        }

        .student-details-toggle {
          padding: 5px 8px;
          font-size: 0.66rem;
        }
      
        .table-container {
          overflow-x: auto;
          width: 100%;
        }

        .table-container th,
        .table-container td {
          white-space: nowrap;
        }

        th small,
        td small {
          font-size: 0.9em;
        }

        table {
          font-size: 11px;
        }
      
        th,
        td {
          padding: 5px;
        }

        th {
          font-size: 0.66rem;
        }

        td {
          font-size: 0.64rem;
        }
      }
      
      @media screen and (max-width: 480px) {
        h1 {
          font-size: 1.2rem;
        }
      
        h2 {
          font-size: 1rem;
        }
      
        h3 {
          font-size: 0.82rem;
        }
      
        .student-details {
          font-size: 0.62rem;
          gap: 4px;
        }
      
        .student-image-container img {
          width: 100px;
          height: 100px;
        }
      
        table {
          font-size: 10px;
        }
      
        th,
        td {
          padding: 3px;
        }

        th {
          font-size: 0.6rem;
        }

        td {
          font-size: 0.58rem;
        }
      
        .btn {
          font-size: 0.7rem;
          padding: 4px 7px;
          margin: 4px 2px;
        }

        .sd-page {
          padding: 9px;
        }

        .student-image-container img {
          width: 88px;
          height: 88px;
        }

        .student-extra-details p {
          min-height: 0;
          padding: 4px 6px;
          gap: 2px;
          font-size: 0.58rem;
        }

        .student-extra-details p strong {
          font-size: 0.5rem;
        }

        .student-id-chip {
          padding: 3px 7px;
          font-size: 0.58rem;
        }

        .student-heading-actions {
          gap: 1px;
        }

        .student-heading-row {
          gap: 3px;
        }

        .student-details-toggle {
          padding: 5px 7px;
          font-size: 0.62rem;
        }

        .student-portal-request-btn {
          font-size: 0.52rem !important;
          padding: 2px 5px !important;
        }
      }

      .table-container table {
        position: relative;
        border-collapse: separate;
        border-spacing: 0;
      }

      .table-container th:first-child,
.table-container td:first-child {
        position: sticky;
        left: 0;
        background-color: #f8f9fa;
        z-index: 1;
      }

      /* Cards: profile, transportation, grades, parents. */
      .sd-page { background: transparent; border: 0; text-align: left; }
      .sd-page.has-transportation { padding-bottom: 60px; }
      .sd-card {
        padding: 16px 18px;
        border: 1px solid var(--border, #e2e8f0);
        border-radius: 12px;
        background: #ffffff;
        text-align: left;
      }
      .sd-card + .sd-card { margin-top: 14px; }
      .sd-card__title { margin: 0 0 10px; font-size: 0.95rem; font-weight: 700; color: #0f172a; text-align: left; }
      /* Files | Portfolio (feature student_documents) and the card heads. */
      .sd-card__head { display: flex; align-items: center; justify-content: space-between; gap: 10px; margin: 0 0 12px; }
      .sd-card__head .sd-card__title { margin: 0; }
      .sd-files__bar { display: flex; align-items: center; justify-content: space-between; gap: 10px; margin: 0 0 14px; }
      .sd-files__tabs { display: inline-flex; gap: 2px; padding: 3px; border-radius: 10px; background: #f1f5f9; }
      .sd-files .sd-files__tab { display: inline-flex; align-items: center; gap: 7px; width: auto; height: 32px; margin: 0; padding: 0 14px; border: 0; border-radius: 8px; background: transparent; box-shadow: none; color: #475569; font: inherit; font-size: 13.5px; font-weight: 650; cursor: pointer; }
      .sd-files .sd-files__tab[aria-selected="true"] { background: #fff; color: #0f172a; box-shadow: 0 1px 2px rgba(15, 23, 42, .12); }
      .sd-files__count { display: inline-grid; place-items: center; min-width: 20px; height: 18px; padding: 0 6px; border-radius: 999px; background: #e2e8f0; color: #334155; font-size: 11px; font-weight: 700; }
      .sd-files .sd-files__add { display: inline-flex; align-items: center; gap: 6px; width: auto; height: 34px; margin: 0; padding: 0 14px; border: 1px solid #cbd5e1; border-radius: 9px; background: #fff; box-shadow: none; color: #0f172a; font: inherit; font-size: 13px; font-weight: 650; cursor: pointer; }
      .sd-files .sd-files__add:hover { border-color: var(--org-primary-color, #0f766e); color: var(--org-primary-color, #0f766e); }
      .sd-files.is-portfolio .sd-files__add { display: none; }
      .sd-files__pane[hidden] { display: none !important; }
      .sd-files__empty { margin: 0; padding: 18px; border: 1px dashed #e2e8f0; border-radius: 10px; color: #64748b; font-size: 13.5px; text-align: center; }
      .sd-filelist { margin: 0; padding: 0; list-style: none; border: 1px solid #eef0f3; border-radius: 10px; }
      .sd-file { display: grid; grid-template-columns: 34px minmax(0, 1fr) auto auto; align-items: center; gap: 12px; padding: 10px 12px; }
      .sd-file + .sd-file { border-top: 1px solid #eef0f3; }
      .sd-file__ext { display: grid; place-items: center; width: 34px; height: 40px; border-radius: 6px; background: #e0f2fe; color: #0369a1; font-size: 9.5px; font-weight: 800; letter-spacing: .03em; }
      .sd-file__main { display: grid; gap: 1px; min-width: 0; text-align: left; }
      .sd-file__title { overflow: hidden; color: #0f172a; font-size: 14px; font-weight: 650; text-decoration: none; text-overflow: ellipsis; white-space: nowrap; }
      .sd-file__title:hover { text-decoration: underline; }
      .sd-file__meta { color: #64748b; font-size: 12.5px; }
      .sd-file__meta .is-expired { color: #b91c1c; font-weight: 600; }
      .sd-file__meta .is-soon { color: #b45309; font-weight: 600; }
      .sd-file__note { cursor: help; text-decoration: underline dotted; }
      .sd-file__who { padding: 2px 9px; border-radius: 999px; background: #f1f5f9; color: #475569; font-size: 11.5px; font-weight: 700; white-space: nowrap; }
      .sd-file__who--family { background: #ecfdf5; color: #047857; }
      .sd-file__who--managers { background: #fef3c7; color: #92400e; }
      .sd-file__acts { display: flex; gap: 14px; }
      .sd-file__acts a, .sd-files .sd-file__acts button { width: auto; height: auto; margin: 0; padding: 0; border: 0; background: none; box-shadow: none; color: var(--org-primary-color, #0f766e); font: inherit; font-size: 13px; font-weight: 650; text-decoration: none; cursor: pointer; }
      #sd-pane-portfolio .pf-stats { margin-top: 0; }
      /* Transportation: the essentials, the rest under More details. */
      .sd-bus__summary { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 10px; }
      .sd-bus__item { min-width: 0; padding: 10px 12px; border: 1px solid #eef0f3; border-radius: 10px; background: #fafbfc; text-align: left; }
      .sd-bus__item span { display: block; color: #64748b; font-size: 11.5px; font-weight: 600; }
      .sd-bus__item strong { display: block; overflow: hidden; color: #0f172a; font-size: 13.5px; font-weight: 650; text-overflow: ellipsis; white-space: nowrap; }
      .sd-bus__more { margin-top: 10px; }
      .sd-bus__more > summary { display: inline-flex; align-items: center; gap: 6px; color: var(--org-primary-color, #0f766e); font-size: 13px; font-weight: 650; cursor: pointer; list-style: none; }
      .sd-bus__more > summary::-webkit-details-marker { display: none; }
      .sd-bus__more > summary::after { content: ""; width: 6px; height: 6px; margin-top: -3px; border-right: 2px solid currentColor; border-bottom: 2px solid currentColor; transform: rotate(45deg); transition: transform .15s; }
      .sd-bus__more[open] > summary::after { margin-top: 3px; transform: rotate(-135deg); }
      .sd-bus__more dl { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px 24px; margin: 10px 0 0; padding: 12px; border-radius: 10px; background: #fafbfc; text-align: left; }
      .sd-bus__more dt { color: #64748b; font-size: 11.5px; font-weight: 600; }
      .sd-bus__more dd { margin: 1px 0 0; color: #0f172a; font-size: 13.5px; }
      .sd-card .sd-track { display: inline-flex; align-items: center; gap: 6px; width: auto; height: 32px; margin: 0; padding: 0 12px; border: 1px solid #cbd5e1; border-radius: 9px; background: #fff; box-shadow: none; color: #0f172a; font: inherit; font-size: 13px; font-weight: 650; cursor: pointer; }
      .sd-card .sd-track:hover { border-color: var(--org-primary-color, #0f766e); color: var(--org-primary-color, #0f766e); }
      @media (max-width: 760px) {
        .sd-file { grid-template-columns: 34px minmax(0, 1fr) auto; }
        .sd-file__who { display: none; }
        .sd-bus__summary { grid-template-columns: repeat(2, minmax(0, 1fr)); }
        .sd-bus__more dl { grid-template-columns: 1fr; }
      }
      .sd-old__head { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 8px 12px; margin-bottom: 4px; }
      .sd-old__head .sd-card__title { margin: 0; }
      .sd-old__find { width: min(240px, 100%); height: 34px; padding: 0 10px; border: 1px solid #d0d5dd; border-radius: 8px; font-size: 13px; }
      .sd-old__group { margin-top: 12px; }
      .sd-old__groups { columns: 2 340px; column-gap: 28px; }
      .sd-old__groups .sd-old__group { break-inside: avoid; }
      .sd-old__group--use { display: grid; grid-template-columns: repeat(auto-fill, minmax(340px, 1fr)); column-gap: 28px; }
      .sd-old__group--use h4 { grid-column: 1 / -1; }
      .sd-old__group h4 { margin: 0 0 6px; color: #667085; font-size: 11.5px; font-weight: 700; letter-spacing: .04em; text-transform: uppercase; }
      .sd-old__item { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 2px 12px; padding: 8px 10px; border-radius: 8px; color: #0f172a; text-decoration: none; }
      .sd-old__item:hover, .sd-old__item:focus-visible { background: #f2f4f7; }
      .sd-old__item span { font-size: 14px; font-weight: 600; }
      .sd-old__item small { color: #667085; font-size: 12.5px; }
      .sd-old__item--form span::before { content: ""; display: inline-block; width: 7px; height: 7px; margin-right: 8px; border-radius: 50%; background: #16a34a; vertical-align: middle; }
      .sd-old__note, .sd-old__none { margin: 12px 0 0; color: #475467; font-size: 13px; }
      .sd-card .table-container { margin: 0; border: 1px solid #eef0f3; border-radius: 10px; }
      .sd-card th, .sd-card td { border: 0; border-bottom: 1px solid #eef0f3; padding: 9px 12px; }
      .sd-card tr:last-child > td, .sd-card tbody tr:last-child > th { border-bottom: 0; }
      .sd-card th { background: #f8fafc; color: #475569; font-size: 0.7rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.03em; }
      .sd-card th small { font-weight: 500; text-transform: none; letter-spacing: 0; color: #64748b; }
      .sd-card td { color: #0f172a; font-size: 0.8rem; }
      .sd-card .table-container th:first-child, .sd-card .table-container td:first-child { background-color: #f8fafc; }
      .sd-card tbody td:first-child { font-weight: 600; }
      .sd-profile .student-image-container img { width: 96px; height: 96px; border-width: 3px; box-shadow: 0 4px 14px rgba(15, 23, 42, 0.1); }
      .sd-profile .student-info-container { grid-template-columns: 112px minmax(0, 1fr); align-items: center; }
      .sd-profile .student-heading-row { align-items: flex-start; }
      .sd-name h2 { margin: 0; color: #0f172a; font-size: 1.3rem; line-height: 1.2; }
      .sd-sub { margin: 4px 0 0; color: #64748b; font-size: 0.85rem; }
      .sd-profile .student-id-chip { box-shadow: none; font-size: 0.72rem; padding: 5px 10px; }
      .sd-profile .student-edit-link { padding: 6px 12px; font-size: 0.78rem; }
      .sd-view {
        display: inline-flex; align-items: center; padding: 5px 12px; border-radius: 8px;
        background: color-mix(in srgb, var(--primary) 10%, white); color: var(--primary);
        font-size: 0.78rem; font-weight: 600; text-decoration: none; white-space: nowrap;
      }
      button.sd-view { border: 0; cursor: pointer; font-family: inherit; }
      .sd-card > button.sd-view { margin-top: 12px; min-height: 40px; }
      .sd-empty { color: #64748b; text-align: center; }
      .sd-col-action { width: 1%; text-align: right; white-space: nowrap; }
      .sd-sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }
      @media screen and (min-width: 769px) {
        .sd-profile .student-extra-details { display: grid; grid-template-columns: repeat(auto-fill, minmax(160px, 1fr)); gap: 12px 24px; padding-top: 12px; border-top: 1px solid #eef0f3; }
        .sd-profile .student-extra-details p { padding: 0; border: 0; background: transparent; font-size: 0.85rem; color: #0f172a; }
        .sd-profile .student-extra-details p strong { font-size: 0.68rem; color: #64748b; font-weight: 600; }
      }
      
    </style>
    <%- include('../partials/flash') %>

    <div class="sd-page<%= locals.transportationSnapshot ? ' has-transportation' : '' %>">
    <div class="link-to-next-back">
      <% if (req.session && req.session.guardianId) { %>
      <a href="/guardian/dashboard" class="btn btn-secondary">Back to Dashboard</a>
      <% } %>
    </div>
      <% if (!studentEnrolledInCurrent) { %>
      <div class="flash-message flash-error">
        This student is <strong>not enrolled</strong> in the current school year
        (<%= currentSchoolYearLabel %>) and term (<%= currentTermName %>).
      </div>
      <% } %>

        <% if (locals.oldSystem && oldSystem.alerts.length) { %>
        <%# Custody and pickup restrictions from the school's old system: always shown first. %>
        <div role="alert" style="margin:0 0 12px;padding:12px 14px;border:1px solid #fecaca;border-radius:12px;background:#fef2f2;color:#991b1b;">
          <% oldSystem.alerts.forEach(function (a) { %><p style="margin:2px 0"><strong><%= a.label %>:</strong> <%= a.text %></p><% }) %>
        </div>
        <% } %>
      <section class="sd-card sd-profile">
      <div class="student-info-container">
        <!-- Student Image -->
        <div class="student-image-container">
          <% if (student.image_url && student.image_url !==
          'profilePlaceholder.png') { %>
          <% const studentImageUrl = publicImageUrl(student.image_url); %>
          <img
            src="<%= studentImageUrl %><%= studentImageUrl.includes('?') ? '&' : '?' %>v=<%= new Date().getTime() %>"
            alt="Student Image"
          />
          <% } else { %>
          <img src="/images/profilePlaceholder.png" alt="Placeholder Image" />
          <% } %>
        </div>


        <!-- Student Details -->
        <div class="student-details">
          <%
            var _studentDisplayId = '';
            if (studentIdSettings && studentIdSettings.use_custom_student_id) {
              var _studentPrefix = studentIdSettings.student_id_prefix || '';
              _studentDisplayId = student.custom_student_id ||
                (_studentPrefix
                  ? _studentPrefix + String(student.student_id).padStart(3, '0')
                  : String(student.student_id).padStart(3, '0'));
            }
          %>
          <div class="student-heading-row">
            <div class="sd-name">
              <h2><%= (typeof formatDisplayName === 'function' ? formatDisplayName(student) : (student.first_name + ' ' + student.last_name)) %></h2>
              <p class="sd-sub"><%= [enrolledClassForTerm, termNameForPage].filter(Boolean).join(' · ') %></p>
            </div>
            <%- include('../partials/studentArchiveBanner') %>
            <div class="student-heading-actions">
              <% if (_studentDisplayId) { %>
              <span class="student-id-chip">ID: <%= _studentDisplayId %></span>
              <% } %>
              <% if (req.session && !req.session.guardianId && req.session.userRole !== 'Teacher' && req.session.userRole !== 'Supervisor' && !locals.archiveStatus) { %>
              <% if (workspaceAccess().students.canEdit) { %><a class="student-edit-link" id="studentEditLink" data-no-spa href="/common/editStudent?studentId=<%= student.student_id %>&termId=<%= currentTerm %>&classId=<%= student.class_id %>">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 20h9"/><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4Z"/></svg>
                Edit student
              </a><% } %>
              <% } %>
              <% if (locals.studentPortalIntegrationActive && locals.studentPortalSetupComplete) { %>
              <span class="student-portal-status"><span class="student-portal-check" aria-hidden="true">✓</span> Portal</span>
              <% } %>
              <% if (locals.studentPortalIntegrationActive && locals.canSendStudentPortalRequest) { %>
              <button
                type="button"
                class="btn btn-primary student-portal-request-btn"
                id="student-password-reset-btn"
                data-student-id="<%= student.student_id %>"
                data-portal-action="<%= studentPortalSetupComplete ? 'reset' : 'setup' %>"
                data-student-name="<%= (typeof formatDisplayName === 'function' ? formatDisplayName(student) : (student.first_name + ' ' + student.last_name)) %>">
                <%= studentPortalSetupComplete ? 'Reset Pass' : 'Send Setup' %>
              </button>
              <% } %>
            </div>
          </div>
          <button class="student-details-toggle" type="button" id="student-details-toggle" aria-expanded="false" aria-controls="student-extra-details">More details</button>
          <div class="student-extra-details" id="student-extra-details">
          <% if (student.gender) { %><p><strong>Gender</strong> <%= student.gender %></p><% } %>
          <% if (student.date_of_birth) { %>
          <p><strong>Date of birth</strong> <%= (typeof formatDisplayDate === 'function' ? formatDisplayDate(student.date_of_birth) : new Date(student.date_of_birth).toLocaleDateString()) %></p>
          <% } %>
          <% if (gradYearGroupName && !/^no /i.test(String(gradYearGroupName))) { %><p><strong>Graduation class</strong> <%= gradYearGroupName %></p><% } %>
          <% if (student.hometown) { %><p><strong>Hometown</strong> <%= student.hometown %></p><% } %>
          <% if (student.address) { %>
          <p><strong>Address</strong> <%= student.address %></p>
          <% } %>
          <% if (student.email) { %>
          <p><strong>Email</strong> <%= student.email %></p>
          <% } %>
          <% (locals.customAnswers || []).forEach(function (f) { %>
          <p><strong><%= f.label %></strong> <span style="white-space: pre-wrap"><%= f.display %></span></p>
          <% }) %>
          <% if (locals.oldSystem) { %>
            <% oldSystem.extras.forEach(function (x) { %><p><strong><%= x.label %></strong> <span style="white-space: pre-wrap"><%= x.value %></span><% if (x.sensitive) { %> <small style="color:#b91c1c">(restricted)</small><% } %></p><% }) %>
          <% } %>
          </div>
        </div>
      </div>
      </section>
      <% if (locals.studentDocuments) { const _sd = studentDocuments;
           const _shareShort = { staff: 'Staff', managers: 'Managers only', family: 'Family' };
           const _day = (d) => d ? new Date(d + 'T12:00:00Z').toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric', timeZone: 'UTC' }) : ''; %>
      <%# Files and portfolio (feature student_documents, routes/studentDocumentsRoute.js). Adding or changing a
          file opens the right-side drawer (views/common/studentDocumentForm.ejs); saving reloads the page. %>
      <section class="sd-card sd-files" id="student-documents">
        <div class="sd-files__bar">
          <div class="sd-files__tabs" role="tablist" aria-label="Files and portfolio">
            <button type="button" role="tab" class="sd-files__tab" id="sd-tab-files" aria-controls="sd-pane-files" aria-selected="true" data-files-tab="files">
              Files <span class="sd-files__count"><%= _sd.list.length %></span>
            </button>
            <% if (_sd.portfolio) { %>
            <button type="button" role="tab" class="sd-files__tab" id="sd-tab-portfolio" aria-controls="sd-pane-portfolio" aria-selected="false" data-files-tab="portfolio">Portfolio</button>
            <% } %>
          </div>
          <button type="button" class="sd-files__add" data-file-drawer="/common/student-documents/<%= student.student_id %>/new">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>
            Add file
          </button>
        </div>

        <div class="sd-files__pane" id="sd-pane-files" role="tabpanel" aria-labelledby="sd-tab-files">
          <% if (!_sd.list.length) { %>
            <p class="sd-files__empty">No files yet.</p>
          <% } else { %>
          <ul class="sd-filelist">
            <% _sd.list.forEach(function (d) { %>
            <li class="sd-file">
              <span class="sd-file__ext" aria-hidden="true"><%= (String(d.fileName).split('.').pop() || 'FILE').toUpperCase().slice(0, 4) %></span>
              <div class="sd-file__main">
                <a class="sd-file__title" href="/common/student-documents/file/<%= d.id %>" target="_blank" rel="noopener" data-no-spa><%= d.title %></a>
                <span class="sd-file__meta"><%= d.typeLabel %><% if (d.expiresOn) { %> · <span class="<%= d.expired ? 'is-expired' : (d.expiresSoon ? 'is-soon' : '') %>"><%= d.expired ? 'Expired' : 'Expires' %> <%= _day(d.expiresOn) %></span><% } %><% if (d.note) { %> · <span class="sd-file__note" title="<%= d.note %>">Note</span><% } %></span>
              </div>
              <span class="sd-file__who sd-file__who--<%= d.sharing %>" title="<%= d.sharingLabel %>"><%= _shareShort[d.sharing] || d.sharing %></span>
              <div class="sd-file__acts">
                <a href="/common/student-documents/file/<%= d.id %>" target="_blank" rel="noopener" data-no-spa>Open</a>
                <button type="button" data-file-drawer="/common/student-documents/<%= student.student_id %>/<%= d.id %>/edit">Edit</button>
              </div>
            </li>
            <% }) %>
          </ul>
          <% } %>
        </div>

        <% if (_sd.portfolio) { %>
        <link rel="stylesheet" href="<%= assetUrl('/css/portfolio.css') %>" />
        <div class="sd-files__pane pf" id="sd-pane-portfolio" role="tabpanel" aria-labelledby="sd-tab-portfolio" hidden data-portfolio-src="/common/student-documents/<%= student.student_id %>/portfolio">
          <div data-portfolio-body><div class="pf-empty">Loading…</div></div>
        </div>
        <% } %>
        <script>
          (function () {
            var card = document.getElementById('student-documents');
            if (!card || card.dataset.bound) return;
            card.dataset.bound = '1';
            var pane = document.getElementById('sd-pane-portfolio');
            var body = pane && pane.querySelector('[data-portfolio-body]');
            var loaded = false;
            // The portfolio loads the first time it's opened (or from #student-portfolio); another term loads in place.
            function load(url) {
              body.setAttribute('aria-busy', 'true');
              fetch(url, { credentials: 'same-origin', headers: { Accept: 'text/html' } })
                .then(function (r) { return r.ok ? r.text() : Promise.reject(r.status); })
                .then(function (html) {
                  body.innerHTML = html;
                  body.querySelectorAll('a[href*="/portfolio/test/"]').forEach(function (a) { a.target = '_blank'; a.rel = 'noopener'; a.setAttribute('data-no-spa', ''); });
                })
                .catch(function () { body.innerHTML = '<div class="pf-empty">The portfolio could not load. Try again.</div>'; })
                .then(function () { body.removeAttribute('aria-busy'); });
            }
            function show(which) {
              card.querySelectorAll('[data-files-tab]').forEach(function (tab) {
                var on = tab.getAttribute('data-files-tab') === which;
                tab.setAttribute('aria-selected', on ? 'true' : 'false');
                var target = document.getElementById(tab.getAttribute('aria-controls'));
                if (target) target.hidden = !on;
              });
              card.classList.toggle('is-portfolio', which === 'portfolio');
              if (which === 'portfolio' && pane && !loaded) { loaded = true; load(pane.getAttribute('data-portfolio-src')); }
            }
            // Add file and Edit open in the right-side drawer; a save there reloads this page.
            var drawer = null;
            function openDrawer(url, editing) {
              if (!window.ManagiraDrawer) { window.location.href = url; return; }
              if (!drawer) {
                drawer = window.ManagiraDrawer.create({ id: 'studentFile', icon: '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z"/><path d="M14 3v5h5"/></svg>', title: 'Student file', subtitle: <%- JSON.stringify((typeof formatDisplayName === 'function' ? formatDisplayName(student) : (student.first_name + ' ' + student.last_name)) || '') %>, width: 600, belowHeader: true });
                window.addEventListener('message', function (event) {
                  if (event.origin !== window.location.origin || !event.data || event.data.drawerId !== 'studentFile') return;
                  if (event.data.managiraDrawerClose) window.location.reload();
                  else if (event.data.managiraDrawerCancel) drawer.close();
                });
              }
              drawer.open(url, { forceReload: true });
            }
            card.addEventListener('click', function (event) {
              var tab = event.target.closest('[data-files-tab]');
              if (tab) { show(tab.getAttribute('data-files-tab')); return; }
              var opener = event.target.closest('[data-file-drawer]');
              if (opener) { event.preventDefault(); openDrawer(opener.getAttribute('data-file-drawer')); return; }
              var term = event.target.closest('#sd-pane-portfolio a.pf-term');
              if (term) { event.preventDefault(); load(term.getAttribute('href')); }
            });
            if (pane && location.hash === '#student-portfolio') { show('portfolio'); card.scrollIntoView({ block: 'start' }); }
          })();
        </script>
      </section>
      <% } %>
      <% if (locals.oldSystem && (oldSystem.history.length || oldSystem.attendance.length || oldSystem.sourceGpa)) { %>
      <%# Final grades and attendance totals from the school's old system (data migration). %>
      <section class="sd-card">
        <h3 class="sd-card__title">Academic record before Managira</h3>
        <% const _sg = oldSystem.sourceGpa; %>
        <% if (oldSystem.history.length || _sg) { %>
        <p style="margin:0 0 8px;color:#475467;font-size:13px"><% if (oldSystem.history.length) { %>Credits earned <strong><%= Math.round(oldSystem.credits * 100) / 100 %></strong><% } %><% if (_sg) { %><%= oldSystem.history.length ? ' · ' : '' %>GPA from the old system: <% if (_sg.weighted !== null) { %>weighted <strong><%= _sg.weighted %></strong><% } %><% if (_sg.weighted !== null && _sg.unweighted !== null) { %> · <% } %><% if (_sg.unweighted !== null) { %>unweighted <strong><%= _sg.unweighted %></strong><% } %><% if (_sg.weighted === null && _sg.unweighted === null) { %><strong><%= _sg.gpa %></strong><% } %><% } %></p>
        <% } %>
        <% if (oldSystem.history.length) { %>
        <div class="table-container">
          <table>
            <thead><tr><th>Year</th><th>Term</th><th>Course</th><th>Grade</th><th>Percent</th><th>Credits</th><th>GPA points</th></tr></thead>
            <tbody>
              <% oldSystem.history.forEach(function (h) { %>
              <tr><td><%= h.school_year || '—' %></td><td><%= h.term || '—' %></td><td><%= h.course_name %><% if (h.course_number) { %> <small>(<%= h.course_number %>)</small><% } %></td><td><%= h.grade || '—' %></td>
                <td><%= h.percent === null ? '—' : Number(h.percent) %></td><td><%= h.credits_earned === null ? '—' : Number(h.credits_earned) %></td><td><%= h.gpa_points === null ? '—' : Number(h.gpa_points) %></td></tr>
              <% }) %>
            </tbody>
          </table>
        </div>
        <% } %>
        <% if (oldSystem.attendance.length) { %>
        <h4 style="margin:14px 0 6px;font-size:14px">Attendance</h4>
        <div class="table-container">
          <table>
            <thead><tr><th>Year</th><th>Term</th><th>Present</th><th>Absent</th><th>Excused</th><th>Tardy</th></tr></thead>
            <tbody>
              <% oldSystem.attendance.forEach(function (a) { %>
              <tr><td><%= a.school_year || '—' %></td><td><%= a.term || 'Whole year' %></td><td><%= Number(a.days_present) %></td><td><%= Number(a.days_absent) %></td><td><%= Number(a.days_excused) %></td><td><%= Number(a.days_tardy) %></td></tr>
              <% }) %>
            </tbody>
          </table>
        </div>
        <% } %>
      </section>
      <% } %>
      <% if (locals.oldSystem && (oldSystem.forms.length || oldSystem.archives.length || (oldSystem.documents || []).length || oldSystem.canUnlock)) { %>
      <%# Everything else the school brought from its old system: the lists it keeps using (forms), the
          lists kept read-only, by topic, and documents. %>
      <% const _items = oldSystem.forms.length + oldSystem.archives.length + (oldSystem.documents || []).length; %>
      <section class="sd-card sd-old" data-old-records>
        <div class="sd-old__head"><h3 class="sd-card__title">From the old system</h3>
          <% if (_items > 8) { %><input type="search" class="sd-old__find" placeholder="Find a record" aria-label="Find a record from the old system" data-old-filter /><% } %></div>
        <% if (oldSystem.forms.length) { %>
        <div class="sd-old__group sd-old__group--use" data-old-group>
          <h4>Still in use</h4>
          <% oldSystem.forms.forEach(function (f) { %><a class="sd-old__item sd-old__item--form" data-old-item href="/common/custom-forms/go?section=<%= f.section_id %>&student=<%= student.student_id %>" data-no-spa><span><%= f.name %></span><small><%= f.n %> <%= f.n === 1 ? 'entry' : 'entries' %> · add more</small></a><% }) %>
        </div>
        <% } %>
        <div class="sd-old__groups">
        <% (oldSystem.topicOrder || []).forEach(function (topic) { const _a = oldSystem.archives.filter(function (a) { return a.topic === topic; }); if (!_a.length) return; %>
        <div class="sd-old__group" data-old-group>
          <h4><%= topic %></h4>
          <% _a.forEach(function (a) { %><a class="sd-old__item" data-old-item href="/common/migration/archive/<%= a.archive_id %>" target="_blank" rel="noopener" data-no-spa><span><%= a.module %></span><small><%= a.n %> <%= a.n === 1 ? 'row' : 'rows' %><%= a.sensitive ? ' · restricted' : '' %></small></a><% }) %>
        </div>
        <% }) %>
        <% if ((oldSystem.documents || []).length) { %>
        <div class="sd-old__group" data-old-group>
          <h4>Documents</h4>
          <% oldSystem.documents.forEach(function (d) { %><a class="sd-old__item" data-old-item href="/common/migration/documents/<%= d.document_id %>" target="_blank" rel="noopener" data-no-spa><span><%= d.kind || d.file_name %></span><small><%= d.file_name %> · <%= Math.max(1, Math.round(Number(d.size_bytes) / 1024)) %> KB<%= d.restricted ? ' · restricted' : '' %></small></a><% }) %>
        </div>
        <% } %>
        </div>
        <% if (oldSystem.canUnlock) { %><p class="sd-old__note"><%= oldSystem.hidden %> restricted <%= oldSystem.hidden === 1 ? 'item' : 'items' %>. <a href="/common/migration/verify?next=<%= encodeURIComponent('/common/studentDetails?studentId=' + student.student_id) %>" data-no-spa>Show (asks for your authenticator code)</a></p><% } %>
        <p class="sd-old__none" data-old-none hidden>Nothing matches.</p>
      </section>
      <script>
        (function () {
          if (window.__sdOldFilter) return;
          window.__sdOldFilter = true;
          document.addEventListener('input', function (e) {
            if (!e.target.matches || !e.target.matches('[data-old-filter]')) return;
            var card = e.target.closest('[data-old-records]');
            var words = e.target.value.trim().toLowerCase();
            var any = false;
            card.querySelectorAll('[data-old-group]').forEach(function (group) {
              var shown = 0;
              group.querySelectorAll('[data-old-item]').forEach(function (item) {
                var hit = !words || (group.querySelector('h4').textContent + ' ' + item.textContent).toLowerCase().indexOf(words) !== -1;
                item.hidden = !hit;
                if (hit) shown += 1;
              });
              group.hidden = !shown;
              if (shown) any = true;
            });
            card.querySelector('[data-old-none]').hidden = any;
          });
        })();
      </script>
      <% } %>
      <% if (locals.transportationSnapshot) { const _ts = transportationSnapshot;
           // "07:37:00" reads as "7:37 AM"; distances in miles.
           const _clock = (v) => { const m = /^(\d{1,2}):(\d{2})/.exec(String(v || '')); if (!m) return v || '—'; const h = Number(m[1]); return ((h % 12) || 12) + ':' + m[2] + (h < 12 ? ' AM' : ' PM'); };
           const _miles = (km) => (km !== null && km !== undefined && Number.isFinite(Number(km))) ? (Number(km) * 0.621371).toFixed(2) + ' mi' : '—'; %>
      <section class="sd-card">
        <div class="sd-card__head">
          <h3 class="sd-card__title">Transportation</h3>
          <button
            type="button"
            class="sd-track"
            data-bus-tracker="<%= student.student_id %>"
            data-bus-tracker-name="<%= typeof formatDisplayName === 'function' ? formatDisplayName(student) : student.first_name + ' ' + student.last_name %>"
            data-transport-snapshot="<%= JSON.stringify(_ts) %>">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 21s-7-6.2-7-11a7 7 0 0 1 14 0c0 4.8-7 11-7 11z"/><circle cx="12" cy="10" r="2.5"/></svg>
            Track bus
          </button>
        </div>
        <div class="sd-bus__summary">
          <div class="sd-bus__item"><span>Bus</span><strong><%= _ts.bus && _ts.bus.busNumber ? _ts.bus.busNumber : '—' %></strong></div>
          <div class="sd-bus__item"><span>Route</span><strong><%= _ts.route && _ts.route.routeName ? _ts.route.routeName : '—' %></strong></div>
          <div class="sd-bus__item"><span>Stop</span><strong title="<%= _ts.stop && _ts.stop.stopName ? _ts.stop.stopName : '' %>"><%= _ts.stop && _ts.stop.stopName ? _ts.stop.stopName : '—' %></strong></div>
          <div class="sd-bus__item"><span>Pickup · Drop-off</span><strong><%= _clock(_ts.pickupTime) %> · <%= _clock(_ts.dropoffTime) %></strong></div>
        </div>
        <details class="sd-bus__more">
          <summary>More details</summary>
          <dl>
            <div><dt>Stop address</dt><dd><%= _ts.stop && _ts.stop.stopAddress ? _ts.stop.stopAddress : '—' %></dd></div>
            <div><dt>Distance to stop</dt><dd><%= _miles(_ts.distanceKm) %></dd></div>
            <div><dt>Live status</dt><dd><%= _ts.live && _ts.live.recordedAt ? ('Last bus update ' + new Date(_ts.live.recordedAt).toLocaleString('en-US', { month: 'short', day: 'numeric', hour: 'numeric', minute: '2-digit' })) : 'No trip running now' %></dd></div>
            <% if (_ts.homeAddress && _ts.homeAddress !== student.address) { %><div><dt>Home address</dt><dd><%= _ts.homeAddress %></dd></div><% } %>
          </dl>
        </details>
      </section>
      <% } %>
      <section class="sd-card">
      <h3 class="sd-card__title">Grades</h3>
      <div class="table-container">
        <table>
          <thead>
            <tr>
              <th>Subject</th>
              <% uniqueAssessments.forEach(assessment => { %>
              <th>
                <%= assessment.title %> (<%= assessment.weight %>%)<br />
                <small><%= [assessment.category, assessment.max_score !== null && assessment.max_score !== undefined ? 'out of ' + Number(assessment.max_score) : ''].filter(Boolean).join(' · ') %></small>
              </th>
              <% }) %>
              <th style="white-space:normal;min-width:80px;">Total<br><small>raw score</small></th>
              <th style="white-space:normal;min-width:80px;">Scaled<br><small>of scale base</small></th>
              <th style="white-space:normal;min-width:70px;">Percent</th>
              <th>Grade</th>
              <th>Position</th>
            </tr>
          </thead>
          <tbody>
            <% subjects.forEach(subject => { %>
            <tr>
              <td><%= subject.subject_name %></td>
              <% uniqueAssessments.forEach(assessmentTitle => { %> <% const
              assessment = subject.assessments.find(a => a.title ===
              assessmentTitle.title); %>
              <td>
                <%= assessment && assessment.choice_label ? assessment.choice_label : assessment ? (typeof assessment.score === 'number' ?
                assessment.score.toFixed(2) : (assessment.score !== null &&
                assessment.score !== undefined ? assessment.score : '-')) : ''
                %>
              </td>
              <% }) %>
              <td>
                <%= subject.totalScore !== null && subject.totalScore !==
                undefined ? subject.totalScore.toFixed(2) : '-' %>
              </td>
              <td>
                <% if (subject.totalPercentage !== null && subject.totalPercentage !== undefined) { %>
                  <% const _scaleBase = Number(subject.scaleBase) || 100; %><%= (subject.totalPercentage / 100 * _scaleBase).toFixed(2) %> / <%= _scaleBase %>
                <% } else { %>-<% } %>
              </td>
              <td>
                <%= subject.totalPercentage !== null && subject.totalPercentage
                !== undefined ? subject.totalPercentage.toFixed(2) : '-' %> %
              </td>
              <td><%= subject.grade ? subject.grade : '-' %></td>
              <td>
                <%= subject.position !== '-' ? subject.position +
                getOrdinalSuffix(subject.position) : '-' %>
              </td>
            </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
      </section>
      <% if (req.session && !req.session.guardianId) { %>
      <section class="sd-card">
      <h3 class="sd-card__title">Parents &amp; guardians</h3>
      <div class="table-container">
        <table>
          <thead>
            <tr>
              <th>Name</th>
              <th>Phone</th>
              <th>Email</th>
              <th>Address</th>
              <th class="sd-col-action"><span class="sd-sr">Open</span></th>
            </tr>
          </thead>
          <tbody>
            <% guardians.forEach(guardian => { %>
            <% const _gName = (typeof formatDisplayName === 'function' ? formatDisplayName(guardian) : [guardian.first_name, guardian.last_name].filter(Boolean).join(' ').trim()); %>
            <tr>
              <td><%= _gName %></td>
              <td><%= guardian.phone || '—' %></td>
              <td><%= guardian.email || '—' %></td>
              <td><%= [guardian.address, guardian.hometown].filter(Boolean).join(' · ') || '—' %></td>
              <td class="sd-col-action">
                <a href="/common/person-card/guardian/<%= guardian.guardian_id %>?source=legacy" class="sd-view" data-guardian-view data-guardian-name="<%= _gName %>" data-no-spa aria-label="View <%= _gName %>">View</a>
              </td>
            </tr>
            <% }) %>
            <% if (!guardians.length) { %>
            <tr><td colspan="5" class="sd-empty">No parent or guardian linked yet.</td></tr>
            <% } %>
          </tbody>
        </table>
      </div>
      </section>
      <% } %>
    </div>

