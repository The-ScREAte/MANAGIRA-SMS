          function when(v) { var d = new Date(v); if (isNaN(d)) return ''; var now = new Date(); var opts = d.getFullYear() === now.getFullYear() ? { month: 'short', day: 'numeric' } : { month: 'short', day: 'numeric', year: 'numeric' }; return d.toLocaleDateString('en-US', opts); }
          function stamp(v) { var d = new Date(v); return isNaN(d) ? '' : d.toLocaleString('en-US', { month: 'short', day: 'numeric', hour: 'numeric', minute: '2-digit' }); }
