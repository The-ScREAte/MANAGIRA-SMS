    <style>
      :root {
        --font-family: "<%= (session && session.fontStyle ? String(session.fontStyle).trim() : 'Inter') %>", sans-serif;
        --primary: var(--org-primary-color, #01535b);
        --primary-hover: var(--org-primary-hover, #014a51);
        --primary-hover-fill: color-mix(in srgb, var(--primary) 88%, white);
        --border: #e5e7eb;
        --bg: #f8fafc;
        --text: #0f172a;
        --text-muted: #64748b;
        --surface-muted: #f8fafc;
        --shadow-soft: 0 16px 30px rgba(15, 23, 42, 0.08);
      }

      body {
        font-family: var(--font-family);
      }

      body {
        background-color: var(--bg);
        margin: 0;
        text-align: center;
      }

      .sd-page {
        margin: 0 auto;
        width: min(1100px, 94%);
        max-width: 100%;
        border: 1px solid var(--border);
        border-radius: 14px;
        box-shadow: none;
        padding: 20px;
        background: #ffffff;
      }

      <% if (locals.isEmbedded) { %>
      /* Inside a frame the page never draws an edge of its own. */
      html, body { border: 0 !important; outline: 0 !important; box-shadow: none !important; background: transparent !important; }
      /* Embedded inside the class-dashboard workspace iframe: the shell
         around the iframe already provides the card chrome (header, border,
         background), so this page fills it edge-to-edge instead of nesting
         a second bordered card inside it. */
      .sd-page {
        width: 100%;
        max-width: none;
        margin: 0;
        border: 0 !important;
        border-radius: 0;
        padding: 0;
        min-height: 100vh;
        box-sizing: border-box;
        background: transparent;
      }
      <% } %>

      .flash-message {
        margin: 0 0 14px;
        padding: 10px 14px;
        border-radius: 10px;
        font-size: 0.82rem;
        text-align: left;
      }
      .flash-message.error,
      .flash-message.flash-error { background: #fef2f2; color: #b91c1c; border: 1px solid #fecaca; }
      .flash-message.success { background: #f0fdf4; color: #166534; border: 1px solid #bbf7d0; }
      .flash-message.info { background: #eff6ff; color: #1d4ed8; border: 1px solid #bfdbfe; }
      .flash-close { cursor: pointer; float: right; font-weight: 700; opacity: 0.6; }
      .flash-close:hover { opacity: 1; }

      .btn {
        padding: 7px 10px;
        margin: 6px;
        cursor: pointer;
        text-decoration: none;
        font-size: 0.8rem;
        font-weight: 600;
      }

      .btn-secondary {
        background-color: var(--primary);
        color: white;
      }

      

      .btn-primary {
        background-color: var(--org-primary-color);
        color: white;
      }
      
      

      .table-container {
        overflow-x: auto;
        margin: 14px auto;
        border: 1px solid var(--border);
        border-radius: 12px;
        background: #fff;
      }

      table {
        width: 100%;
        border-collapse: collapse;
      }

      th,
      td {
        padding: 8px;
        border: 1px solid #ddd;
        text-align: left;
      }

      th {
        font-weight: bold;
        background: #f8fafc;
        font-size: 0.76rem;
        line-height: 1.25;
      }

      td {
        font-size: 0.74rem;
        line-height: 1.3;
      }

      th small,
      td small {
        font-size: 0.68rem;
      }

      .student-info-container {
        display: grid;
        grid-template-columns: minmax(148px, 172px) minmax(0, 1fr);
        align-items: stretch;
        gap: 18px;
        margin: 0;
        border: none;
        border-radius: 0;
        padding: 0;
        background: transparent;
        box-shadow: none;
      }

      .student-image-container {
        display: flex;
        align-items: center;
        justify-content: center;
        text-align: center;
        padding: 0;
        margin-bottom: 0 !important;
        border-radius: 0;
        border: none;
        background: transparent;
      }

      .student-image-container img {
        width: min(100%, 144px);
        height: min(100%, 144px);
        border-radius: 50%;
        border: 4px solid rgba(255, 255, 255, 0.95);
        box-shadow: 0 10px 28px rgba(15, 23, 42, 0.12);
        object-fit: cover;
      }

      .student-details {
        display: flex;
        flex-direction: column;
        justify-content: center;
        gap: 12px;
        min-width: 0;
        font-size: 12px;
        color: var(--text-muted);
        text-align: left;
      }

      .student-details h2 {
        font-size: clamp(1.05rem, 1.7vw, 1.35rem);
        margin: 0;
        color: var(--text);
        line-height: 1.1;
      }

      .student-heading-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 8px;
        flex-wrap: nowrap;
      }

      .student-heading-actions {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        flex-wrap: wrap;
        justify-content: flex-end;
      }

      .student-portal-request-btn {
        margin: 0;
        padding: 2px 5px !important;
        border: 1px solid rgba(1, 83, 91, 0.2);
        border-radius: 999px;
        font-size: 0.5rem !important;
        font-weight: 700;
        line-height: 1.2;
        white-space: nowrap;
        width: auto;
        min-height: 0 !important;
      }

      /* Override shared .btn sizing rules for this compact action chip */
      .btn.btn-primary.student-portal-request-btn {
        padding: 2px 5px !important;
        font-size: 0.5rem !important;
        margin: 0 !important;
      }

      .student-portal-status {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        padding: 4px 8px;
        border-radius: 999px;
        font-size: 0.62rem;
        font-weight: 700;
        letter-spacing: 0.01em;
        border: 1px solid #86efac;
        background: #f0fdf4;
        color: #166534;
      }

      .student-portal-check {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 14px;
        height: 14px;
        border-radius: 999px;
        background: #22c55e;
        color: #ffffff;
        font-size: 0.58rem;
        line-height: 1;
        font-weight: 800;
      }

      .student-id-chip {
        display: inline-flex;
        align-items: center;
        padding: 4px 8px;
        border: 1px solid rgba(1, 83, 91, 0.18);
        border-radius: 999px;
        background: color-mix(in srgb, var(--primary) 8%, white);
        color: var(--primary);
        font-size: 0.68rem;
        font-weight: 700;
        font-family: 'SFMono-Regular', Consolas, monospace;
        letter-spacing: 0.02em;
        box-shadow: 0 4px 12px rgba(1, 83, 91, 0.08);
      }

      .student-edit-link {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        padding: 5px 10px;
        border-radius: 999px;
        background: var(--primary);
        color: #ffffff;
        font-size: 0.72rem;
        font-weight: 600;
        text-decoration: none;
        white-space: nowrap;
      }

      .student-details-toggle {
        display: none;
        align-self: flex-start;
        align-items: center;
        gap: 8px;
        margin-top: -2px;
        padding: 8px 12px;
        border: 1px solid var(--border);
        border-radius: 999px;
        background: rgba(255, 255, 255, 0.94);
        color: var(--text);
        font-size: 0.8rem;
        font-weight: 600;
        cursor: pointer;
        box-shadow: 0 4px 12px rgba(15, 23, 42, 0.06);
      }

      .student-details-toggle::after {
        content: '▾';
        font-size: 0.72rem;
        transition: transform 0.2s ease;
      }

      .student-details-toggle[aria-expanded="true"]::after {
        transform: rotate(180deg);
      }

      .student-extra-details {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
      }

      .student-extra-details p {
        margin: 0;
        display: flex;
        flex-direction: column;
        gap: 3px;
        padding: 7px 12px;
        flex: 0 1 auto;
        min-width: 0;
        border: 1px solid var(--border);
        border-radius: 10px;
        background: #ffffff;
        color: var(--text);
        font-size: 0.73rem;
      }

      .student-extra-details p strong {
        font-size: 0.64rem;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        color: var(--text-muted);
      }

      h1 {
        margin: 0 0 10px;
        color: var(--text);
        text-align: left;
      }

      h3 {
        margin: 14px 0 8px;
        color: var(--text);
        font-size: 0.9rem;
      }

      .link-to-next-back {
        text-align: center;
        padding-top: 12px;
        margin-bottom: 10px;
      }
      @media screen and (max-width: 768px) {
        h1 {
          font-size: 1.5rem;
        }
      
        h2 {
          font-size: 1.2rem;
        }
      
        h3 {
          font-size: 0.88rem;
        }
      
        .btn {
          width: auto;
          font-size: 0.76rem;
          padding: 5px 8px;
          margin: 5px 3px;
        }
      
        .student-info-container {
          grid-template-columns: 1fr;
          align-items: center;
          gap: 10px;
          margin: 0;
          padding: 10px;
          justify-items: center;
          text-align: center;
        }

        .student-image-container {
          width: 100%;
          justify-content: center;
        }
      
        .student-image-container img {
          width: 120px;
          height: 120px;
        }
      
        .student-details {
          font-size: 0.7rem;
          align-items: center;
          text-align: center;
          gap: 3px;
          width: 100%;
        }

        .student-details-toggle {
          display: inline-flex;
        }

        .student-extra-details {
          display: none;
          width: 100%;
          grid-template-columns: repeat(2, minmax(0, 1fr));
          gap: 5px;
        }

        .student-info-container.open .student-extra-details {
          display: grid;
        }

        .student-extra-details p {
          min-height: 0;
          padding: 5px 6px;
          gap: 2px;
          font-size: 0.66rem;
        }
      
        .student-details h2 {
          font-size: 0.82rem;
        }

        .student-id-chip {
          padding: 3px 8px;
          font-size: 0.62rem;
        }

        .student-heading-actions {
          width: 100%;
          justify-content: center;
          gap: 3px;
        }

        .student-heading-row {
          align-items: center;
          justify-content: center;
          flex-wrap: wrap;
          gap: 5px;
        }

        .student-portal-request-btn {
          font-size: 0.54rem !important;
          padding: 2px 6px !important;
        }

        .student-details-toggle {
          padding: 5px 8px;
          font-size: 0.66rem;
        }
      
        .table-container {
          overflow-x: auto;
          width: 100%;
        }

        .table-container th,
        .table-container td {
          white-space: nowrap;
        }

        th small,
        td small {
          font-size: 0.9em;
        }

        table {
          font-size: 11px;
        }
      
        th,
        td {
          padding: 5px;
        }

        th {
          font-size: 0.66rem;
        }

        td {
          font-size: 0.64rem;
        }
      }
      
      @media screen and (max-width: 480px) {
        h1 {
          font-size: 1.2rem;
        }
      
        h2 {
          font-size: 1rem;
        }
      
        h3 {
          font-size: 0.82rem;
        }
      
        .student-details {
          font-size: 0.62rem;
          gap: 4px;
        }
      
        .student-image-container img {
          width: 100px;
          height: 100px;
        }
      
        table {
          font-size: 10px;
        }
      
        th,
        td {
          padding: 3px;
        }

        th {
          font-size: 0.6rem;
        }

        td {
          font-size: 0.58rem;
        }
      
        .btn {
          font-size: 0.7rem;
          padding: 4px 7px;
          margin: 4px 2px;
        }

        .sd-page {
          padding: 9px;
        }

        .student-image-container img {
          width: 88px;
          height: 88px;
        }

        .student-extra-details p {
          min-height: 0;
          padding: 4px 6px;
          gap: 2px;
          font-size: 0.58rem;
        }

        .student-extra-details p strong {
          font-size: 0.5rem;
        }

        .student-id-chip {
          padding: 3px 7px;
          font-size: 0.58rem;
        }

        .student-heading-actions {
          gap: 1px;
        }

        .student-heading-row {
          gap: 3px;
        }

        .student-details-toggle {
          padding: 5px 7px;
          font-size: 0.62rem;
        }

        .student-portal-request-btn {
          font-size: 0.52rem !important;
          padding: 2px 5px !important;
        }
      }

      .table-container table {
        position: relative;
        border-collapse: separate;
        border-spacing: 0;
      }

      .table-container th:first-child,
.table-container td:first-child {
        position: sticky;
        left: 0;
        background-color: #f8f9fa;
        z-index: 1;
      }

      /* Cards: profile, transportation, grades, parents. */
      .sd-page { background: transparent; border: 0; text-align: left; }
      .sd-page.has-transportation { padding-bottom: 60px; }
      .sd-card {
        padding: 16px 18px;
        border: 1px solid var(--border, #e2e8f0);
        border-radius: 12px;
        background: #ffffff;
        text-align: left;
      }
      .sd-card + .sd-card { margin-top: 14px; }
      .sd-card__title { margin: 0 0 10px; font-size: 0.95rem; font-weight: 700; color: #0f172a; text-align: left; }
      /* Files | Portfolio and the card heads. */
      .sd-card__head { display: flex; align-items: center; justify-content: space-between; gap: 10px; margin: 0 0 12px; }
      .sd-card__head .sd-card__title { margin: 0; }
      .sd-files__bar { display: flex; align-items: center; justify-content: space-between; gap: 10px; margin: 0 0 14px; }
      .sd-files__tabs { display: inline-flex; gap: 2px; padding: 3px; border-radius: 10px; background: #f1f5f9; }
      .sd-files .sd-files__tab { display: inline-flex; align-items: center; gap: 7px; width: auto; height: 32px; margin: 0; padding: 0 14px; border: 0; border-radius: 8px; background: transparent; box-shadow: none; color: #475569; font: inherit; font-size: 13.5px; font-weight: 650; cursor: pointer; }
      .sd-files .sd-files__tab[aria-selected="true"] { background: #fff; color: #0f172a; box-shadow: 0 1px 2px rgba(15, 23, 42, .12); }
      .sd-files__count { display: inline-grid; place-items: center; min-width: 20px; height: 18px; padding: 0 6px; border-radius: 999px; background: #e2e8f0; color: #334155; font-size: 11px; font-weight: 700; }
      .sd-files .sd-files__add { display: inline-flex; align-items: center; gap: 6px; width: auto; height: 34px; margin: 0; padding: 0 14px; border: 1px solid #cbd5e1; border-radius: 9px; background: #fff; box-shadow: none; color: #0f172a; font: inherit; font-size: 13px; font-weight: 650; cursor: pointer; }
      .sd-files .sd-files__add:hover { border-color: var(--org-primary-color, #0f766e); color: var(--org-primary-color, #0f766e); }
      .sd-files.is-portfolio .sd-files__add { display: none; }
      .sd-files__pane[hidden] { display: none !important; }
      .sd-files__empty { margin: 0; padding: 18px; border: 1px dashed #e2e8f0; border-radius: 10px; color: #64748b; font-size: 13.5px; text-align: center; }
      .sd-filelist { margin: 0; padding: 0; list-style: none; border: 1px solid #eef0f3; border-radius: 10px; }
      .sd-file { display: grid; grid-template-columns: 34px minmax(0, 1fr) auto auto; align-items: center; gap: 12px; padding: 10px 12px; }
      .sd-file + .sd-file { border-top: 1px solid #eef0f3; }
      .sd-file__ext { display: grid; place-items: center; width: 34px; height: 40px; border-radius: 6px; background: #e0f2fe; color: #0369a1; font-size: 9.5px; font-weight: 800; letter-spacing: .03em; }
      .sd-file__main { display: grid; gap: 1px; min-width: 0; text-align: left; }
      .sd-file__title { overflow: hidden; color: #0f172a; font-size: 14px; font-weight: 650; text-decoration: none; text-overflow: ellipsis; white-space: nowrap; }
      .sd-file__title:hover { text-decoration: underline; }
      .sd-file__meta { color: #64748b; font-size: 12.5px; }
      .sd-file__meta .is-expired { color: #b91c1c; font-weight: 600; }
      .sd-file__meta .is-soon { color: #b45309; font-weight: 600; }
      .sd-file__note { cursor: help; text-decoration: underline dotted; }
      .sd-file__who { padding: 2px 9px; border-radius: 999px; background: #f1f5f9; color: #475569; font-size: 11.5px; font-weight: 700; white-space: nowrap; }
      .sd-file__who--family { background: #ecfdf5; color: #047857; }
      .sd-file__who--managers { background: #fef3c7; color: #92400e; }
      .sd-file__acts { display: flex; gap: 14px; }
      .sd-file__acts a, .sd-files .sd-file__acts button { width: auto; height: auto; margin: 0; padding: 0; border: 0; background: none; box-shadow: none; color: var(--org-primary-color, #0f766e); font: inherit; font-size: 13px; font-weight: 650; text-decoration: none; cursor: pointer; }
      #sd-pane-portfolio .pf-stats { margin-top: 0; }
      /* Transportation: the essentials, the rest under More details. */
      .sd-bus__summary { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 10px; }
      .sd-bus__item { min-width: 0; padding: 10px 12px; border: 1px solid #eef0f3; border-radius: 10px; background: #fafbfc; text-align: left; }
      .sd-bus__item span { display: block; color: #64748b; font-size: 11.5px; font-weight: 600; }
      .sd-bus__item strong { display: block; overflow: hidden; color: #0f172a; font-size: 13.5px; font-weight: 650; text-overflow: ellipsis; white-space: nowrap; }
      .sd-bus__more { margin-top: 10px; }
      .sd-bus__more > summary { display: inline-flex; align-items: center; gap: 6px; color: var(--org-primary-color, #0f766e); font-size: 13px; font-weight: 650; cursor: pointer; list-style: none; }
      .sd-bus__more > summary::-webkit-details-marker { display: none; }
      .sd-bus__more > summary::after { content: ""; width: 6px; height: 6px; margin-top: -3px; border-right: 2px solid currentColor; border-bottom: 2px solid currentColor; transform: rotate(45deg); transition: transform .15s; }
      .sd-bus__more[open] > summary::after { margin-top: 3px; transform: rotate(-135deg); }
      .sd-bus__more dl { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px 24px; margin: 10px 0 0; padding: 12px; border-radius: 10px; background: #fafbfc; text-align: left; }
      .sd-bus__more dt { color: #64748b; font-size: 11.5px; font-weight: 600; }
      .sd-bus__more dd { margin: 1px 0 0; color: #0f172a; font-size: 13.5px; }
      .sd-card a.sd-track { text-decoration: none; }
      .sd-card .sd-track { display: inline-flex; align-items: center; gap: 6px; width: auto; height: 32px; margin: 0; padding: 0 12px; border: 1px solid #cbd5e1; border-radius: 9px; background: #fff; box-shadow: none; color: #0f172a; font: inherit; font-size: 13px; font-weight: 650; cursor: pointer; }
      .sd-card .sd-track:hover { border-color: var(--org-primary-color, #0f766e); color: var(--org-primary-color, #0f766e); }
      @media (max-width: 760px) {
        .sd-file { grid-template-columns: 34px minmax(0, 1fr) auto; }
        .sd-file__who { display: none; }
        .sd-bus__summary { grid-template-columns: repeat(2, minmax(0, 1fr)); }
        .sd-bus__more dl { grid-template-columns: 1fr; }
      }
      .sd-old__head { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 8px 12px; margin-bottom: 4px; }
      .sd-old__head .sd-card__title { margin: 0; }
      .sd-old__find { width: min(240px, 100%); height: 34px; padding: 0 10px; border: 1px solid #d0d5dd; border-radius: 8px; font-size: 13px; }
      .sd-old__group { margin-top: 12px; }
      .sd-old__groups { columns: 2 340px; column-gap: 28px; }
      .sd-old__groups .sd-old__group { break-inside: avoid; }
      .sd-old__group--use { display: grid; grid-template-columns: repeat(auto-fill, minmax(340px, 1fr)); column-gap: 28px; }
      .sd-old__group--use h4 { grid-column: 1 / -1; }
      .sd-old__group h4 { margin: 0 0 6px; color: #667085; font-size: 11.5px; font-weight: 700; letter-spacing: .04em; text-transform: uppercase; }
      .sd-old__item { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 2px 12px; padding: 8px 10px; border-radius: 8px; color: #0f172a; text-decoration: none; }
      .sd-old__item:hover, .sd-old__item:focus-visible { background: #f2f4f7; }
      .sd-old__item span { font-size: 14px; font-weight: 600; }
      .sd-old__item small { color: #667085; font-size: 12.5px; }
      .sd-old__item--form span::before { content: ""; display: inline-block; width: 7px; height: 7px; margin-right: 8px; border-radius: 50%; background: #16a34a; vertical-align: middle; }
      .sd-old__note, .sd-old__none { margin: 12px 0 0; color: #475467; font-size: 13px; }
      .sd-card .table-container { margin: 0; border: 1px solid #eef0f3; border-radius: 10px; }
      .sd-card th, .sd-card td { border: 0; border-bottom: 1px solid #eef0f3; padding: 9px 12px; }
      .sd-card tr:last-child > td, .sd-card tbody tr:last-child > th { border-bottom: 0; }
      .sd-card th { background: #f8fafc; color: #475569; font-size: 0.7rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.03em; }
      .sd-card th small { font-weight: 500; text-transform: none; letter-spacing: 0; color: #64748b; }
      .sd-card td { color: #0f172a; font-size: 0.8rem; }
      .sd-card .table-container th:first-child, .sd-card .table-container td:first-child { background-color: #f8fafc; }
      .sd-card tbody td:first-child { font-weight: 600; }
      .sd-profile .student-image-container img { width: 96px; height: 96px; border-width: 3px; box-shadow: 0 4px 14px rgba(15, 23, 42, 0.1); }
      .sd-profile .student-info-container { grid-template-columns: 112px minmax(0, 1fr); align-items: center; }
      .sd-profile .student-heading-row { align-items: flex-start; }
      .sd-name h2 { margin: 0; color: #0f172a; font-size: 1.3rem; line-height: 1.2; }
      .sd-sub { margin: 4px 0 0; color: #64748b; font-size: 0.85rem; }
      .sd-profile .student-id-chip { box-shadow: none; font-size: 0.72rem; padding: 5px 10px; }
      .sd-profile .student-edit-link { padding: 6px 12px; font-size: 0.78rem; }
      .sd-view {
        display: inline-flex; align-items: center; padding: 5px 12px; border-radius: 8px;
        background: color-mix(in srgb, var(--primary) 10%, white); color: var(--primary);
        font-size: 0.78rem; font-weight: 600; text-decoration: none; white-space: nowrap;
      }
      button.sd-view { border: 0; cursor: pointer; font-family: inherit; }
      .sd-card > button.sd-view { margin-top: 12px; min-height: 40px; }
      .sd-empty { color: #64748b; text-align: center; }
      .sd-col-action { width: 1%; text-align: right; white-space: nowrap; }
      .sd-sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }
      @media screen and (min-width: 769px) {
        .sd-profile .student-extra-details { display: grid; grid-template-columns: repeat(auto-fill, minmax(160px, 1fr)); gap: 12px 24px; padding-top: 12px; border-top: 1px solid #eef0f3; }
        .sd-profile .student-extra-details p { padding: 0; border: 0; background: transparent; font-size: 0.85rem; color: #0f172a; }
        .sd-profile .student-extra-details p strong { font-size: 0.68rem; color: #64748b; font-weight: 600; }
      }
      

      /* The student's page: a clean header, one row of things to do, and tabs. */
      /* A SaaS record page: header, actions and tabs are flat bands across the full width; only the content below them sits in cards. */
      .sd-head { display: flex; align-items: center; gap: 18px; margin: 0; padding: 16px 24px; border: 0; border-bottom: 1px solid #e5e9ef; border-radius: 0; background: #fff; }
      .sd-head__photo { flex: none; }
      .sd-head__photo img { display: block; width: 64px; height: 64px; border-radius: 50%; object-fit: cover; border: 3px solid color-mix(in srgb, var(--org-primary-color, #01535b) 22%, #fff); background: #f1f5f9; }
      .sd-head__main { flex: 1; min-width: 0; }
      .sd-head__titlerow { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 12px; }
      .sd-head .sd-head__name { margin: 0; padding: 0; color: #0f172a; font-size: 1.55rem; font-weight: 800; line-height: 1.2; text-align: left; overflow-wrap: anywhere; }
      .sd-head__sub { margin: 4px 0 0; color: #64748b; font-size: .95rem; }
      .sd-head__edit { flex: none; display: flex; align-items: center; gap: 8px; }
      /* The header's buttons (Edit student, portal invite / reset) are one design. */
      .sd-head .sd-head__edit .sd-btn { display: inline-flex; align-items: center; gap: 7px; width: auto; height: 36px; margin: 0; padding: 0 14px; border: 1px solid color-mix(in srgb, var(--org-primary-color, #01535b) 35%, #dbe3e7); border-radius: 10px; background: #fff; color: var(--org-primary-color, #01535b); font: inherit; font-size: .84rem !important; font-weight: 700; line-height: 1; white-space: nowrap; text-decoration: none; cursor: pointer; box-shadow: none; }
      .sd-head .sd-head__edit .sd-btn:hover, .sd-head .sd-head__edit .sd-btn:focus-visible { background: color-mix(in srgb, var(--org-primary-color, #01535b) 8%, #fff); border-color: var(--org-primary-color, #01535b); outline: none; }
      .sd-head .sd-head__edit .sd-btn[disabled] { opacity: .6; cursor: default; }
      .sd-tabs { display: flex; gap: 2px; margin: 0; padding: 0 18px; background: #fff; border-bottom: 1px solid #e5e9ef; overflow-x: auto; scrollbar-width: none; }
      .sd-tabs::-webkit-scrollbar { display: none; }
      .sd-tabs .sd-tab { position: relative; display: inline-flex; flex: none; align-items: center; gap: 7px; width: auto; height: 42px; margin: 0; padding: 0 16px; border: 0; border-radius: 0; background: transparent; color: #64748b; font-size: .92rem; font-weight: 600; cursor: pointer; box-shadow: none; white-space: nowrap; }
      .sd-tabs .sd-tab:hover { color: #0f172a; }
      .sd-tabs .sd-tab[aria-selected="true"] { color: var(--org-primary-color, #01535b); }
      .sd-tabs .sd-tab[aria-selected="true"]::after { content: ""; position: absolute; left: 10px; right: 10px; bottom: -1px; height: 3px; border-radius: 3px 3px 0 0; background: var(--org-primary-color, #01535b); }
      .sd-tabs .sd-tab:focus-visible { outline: 2px solid var(--org-primary-color, #01535b); outline-offset: -2px; }
      .sd-stats { display: grid; grid-template-columns: repeat(auto-fit, minmax(130px, 1fr)); gap: 10px; margin: 0 0 14px; }
      .sd-stat { padding: 12px 14px; border: 1px solid #e5e9ef; border-radius: 10px; background: #fff; }
      .sd-stat span { display: block; font-size: .74rem; font-weight: 700; letter-spacing: .04em; text-transform: uppercase; color: #64748b; }
      .sd-stat strong { display: block; margin-top: 4px; font-size: 1.35rem; line-height: 1.15; color: #0f172a; }
      .sd-stat small { display: block; margin-top: 2px; font-size: .78rem; color: #64748b; }
      .sd-stat--warn strong { color: #b91c1c; }
      .sd-days { display: flex; flex-wrap: wrap; gap: 6px; margin: 4px 0 0; padding: 0; list-style: none; }
      .sd-days li { display: flex; flex-direction: column; align-items: center; gap: 2px; min-width: 52px; padding: 6px 8px; border: 1px solid #e5e9ef; border-radius: 8px; font-size: .72rem; color: #64748b; }
      .sd-days b { font-size: .78rem; color: #334155; }
      .sd-days .is-present b { color: #166534; } .sd-days .is-late b { color: #92400e; } .sd-days .is-absent b { color: #b91c1c; }
      .sd-days li.has-note { position: relative; border-color: var(--org-primary-color, #0f766e); }
      .sd-days li.has-note::after { content: ""; position: absolute; top: 4px; right: 4px; width: 6px; height: 6px; border-radius: 50%; background: var(--org-primary-color, #0f766e); }
      .sd-notes { margin: 0 0 12px; padding: 0; list-style: none; border: 1px solid #e5e9ef; border-radius: 10px; overflow: hidden; }
      .sd-note { display: grid; gap: 2px; padding: 9px 12px; border-top: 1px solid #eef1f4; font-size: .86rem; color: #334155; overflow-wrap: anywhere; }
      .sd-note:first-child { border-top: 0; }
      .sd-note b { font-size: .78rem; color: #0f172a; }
      .sd-sub { margin: 0 0 6px; font-size: .8rem; font-weight: 700; color: #475569; }
      .sd-billrow { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 4px 12px; padding: 10px 0; border-top: 1px solid #eef1f4; font-size: .88rem; }
      .sd-billrow:first-of-type { border-top: 0; }
      .sd-billrow strong { color: #0f172a; overflow-wrap: anywhere; }
      .sd-billrow span { color: #64748b; font-size: .8rem; }
      .sd-billrow .sd-amt { grid-row: 1 / span 2; grid-column: 2; align-self: center; text-align: right; font-weight: 700; color: #0f172a; font-size: .92rem; }
      .sd-loading { display: flex; justify-content: center; padding: 34px 0; }
      .sd-spin { width: 26px; height: 26px; border: 3px solid color-mix(in srgb, var(--org-primary-color, #0f766e) 18%, transparent); border-top-color: var(--org-primary-color, #0f766e); border-radius: 50%; animation: sd-spin .7s linear infinite; }
      @keyframes sd-spin { to { transform: rotate(360deg); } }
      .sd-bar { display: flex; align-items: center; justify-content: space-between; gap: 10px 14px; flex-wrap: wrap; margin: 0 0 14px; }
      .sd-bar__note { color: #64748b; font-size: .84rem; font-weight: 600; }
      .sd-bar .sd-msgs__filters { margin: 0; }
      .sd-tab__n--alert { background: #fee2e2; color: #b91c1c; }
      .sd-msgs__filters { display: flex; flex-wrap: wrap; gap: 6px; margin: 0 0 12px; }
      .sd-chip { width: auto; height: 30px; margin: 0; padding: 0 12px; border: 1px solid #dbe3e7; border-radius: 999px; background: #fff; box-shadow: none; color: #475569; font: inherit; font-size: .82rem; font-weight: 600; cursor: pointer; }
      .sd-chip.is-on { border-color: var(--org-primary-color, #0f766e); background: color-mix(in srgb, var(--org-primary-color, #0f766e) 9%, #fff); color: var(--org-primary-color, #0f766e); }
      .sd-more { width: 100%; height: 40px; margin: 0; border: 0; border-top: 1px solid #eef1f4; border-radius: 0; background: #fff; color: var(--org-primary-color, #0f766e); font: inherit; font-size: .86rem; font-weight: 700; cursor: pointer; box-shadow: none; }
      .sd-more:hover { background: #f8fafc; }
      .sd-msgs__list { display: flex; flex-direction: column; border: 1px solid #e5e9ef; border-radius: 10px; overflow: hidden; }
      .sd-msgs__list > .sd-empty { margin: 0; padding: 28px 12px; }
      .sd-msg { border-top: 1px solid #eef1f4; background: #fff; }
      .sd-msg:first-child { border-top: 0; }
      .sd-msg__row { display: grid; grid-template-columns: 34px minmax(0, 1fr) auto; gap: 12px; align-items: start; width: 100%; margin: 0; padding: 12px 14px; border: 0; border-radius: 0; background: none; box-shadow: none; text-align: left; font: inherit; color: inherit; cursor: default; }
      button.sd-msg__row { cursor: pointer; }
      button.sd-msg__row:hover { background: #f8fafc; }
      .sd-msg__ico { display: grid; place-items: center; width: 34px; height: 34px; border-radius: 50%; background: #eef2f6; color: #475569; }
      .sd-msg--thread .sd-msg__ico { background: color-mix(in srgb, var(--org-primary-color, #0f766e) 12%, #fff); color: var(--org-primary-color, #0f766e); }
      .sd-msg__main { min-width: 0; }
      .sd-msg__top { display: flex; flex-wrap: wrap; align-items: baseline; gap: 4px 10px; }
      .sd-msg__title { font-size: .9rem; font-weight: 700; color: #0f172a; overflow-wrap: anywhere; }
      .sd-msg__who { font-size: .8rem; color: #64748b; }
      .sd-msg__text { margin: 3px 0 0; font-size: .86rem; color: #334155; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; overflow-wrap: anywhere; white-space: pre-line; }
      .sd-msg.is-open .sd-msg__text { display: none; }
      .sd-msg__side { display: flex; flex-direction: column; align-items: flex-end; gap: 6px; font-size: .78rem; color: #64748b; white-space: nowrap; }
      .sd-pill { display: inline-flex; align-items: center; height: 20px; padding: 0 8px; border-radius: 999px; background: #eef2f6; color: #475569; font-size: .72rem; font-weight: 700; }
      .sd-pill--warn { background: #fee2e2; color: #b91c1c; }
      .sd-pill--ok { background: #dcfce7; color: #166534; }
      .sd-pill--wait { background: #fef3c7; color: #92400e; }
      .sd-thread { padding: 0 14px 14px 60px; display: none; }
      .sd-msg.is-open .sd-thread { display: block; }
      .sd-bubble { max-width: 560px; margin: 0 0 8px; padding: 8px 12px; border-radius: 12px; background: #f1f5f9; font-size: .86rem; color: #1e293b; overflow-wrap: anywhere; }
      .sd-bubble.is-staff { margin-left: auto; background: color-mix(in srgb, var(--org-primary-color, #0f766e) 10%, #fff); }
      .sd-bubble small { display: block; margin-top: 3px; color: #64748b; font-size: .72rem; }
      .sd-bubble p { margin: 0; white-space: pre-wrap; }
      .sd-reply { display: flex; gap: 8px; align-items: flex-end; margin-top: 10px; }
      .sd-reply textarea { flex: 1; min-height: 40px; max-height: 140px; margin: 0; padding: 9px 12px; border: 1px solid #dbe3e7; border-radius: 10px; font: inherit; font-size: .88rem; resize: vertical; }
      .sd-reply button { width: auto; height: 40px; margin: 0; padding: 0 16px; border: 0; border-radius: 10px; background: var(--org-primary-color, #0f766e); color: #fff; font: inherit; font-size: .86rem; font-weight: 700; cursor: pointer; box-shadow: none; }
      .sd-reply button:disabled { opacity: .55; cursor: default; }
      @media (max-width: 640px) {
        .sd-msg__row { grid-template-columns: 30px minmax(0, 1fr); padding: 12px; }
        .sd-msg__ico { width: 30px; height: 30px; }
        .sd-msg__side { grid-column: 2; flex-direction: row; align-items: center; justify-content: space-between; }
        .sd-thread { padding: 0 12px 12px; }
        .sd-bubble { max-width: 100%; }
        .sd-reply { flex-direction: column; align-items: stretch; }
      }
      .sd-tab__n { padding: 0 7px; border-radius: 999px; background: #eef2f6; color: #475569; font-size: .74rem; font-weight: 700; }
      .sd-panel[hidden] { display: none; }
      .sd-panel { padding: 18px 24px 24px; }
      .sd-panel > .sd-card + .sd-card { margin-top: 14px; }
      .sd-facts { display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: 16px 24px; margin: 0; }
      .sd-facts dt { color: #64748b; font-size: .7rem; font-weight: 700; letter-spacing: .06em; text-transform: uppercase; }
      .sd-facts dd { margin: 3px 0 0; color: #0f172a; font-weight: 600; overflow-wrap: break-word; word-break: normal; }
      .sd-facts__wide { grid-column: span 2; }
      @media (max-width: 720px) {
        .sd-head { flex-wrap: wrap; padding: 14px 16px; gap: 12px; }
        .sd-tabs { padding: 0 8px; }
        .sd-panel { padding: 14px 16px 20px; }
        .sd-head__photo img { width: 64px; height: 64px; }
        .sd-head__edit { width: 100%; }
        .sd-head .sd-head__name { font-size: 1.25rem; }
        .sd-facts__wide { grid-column: auto; }
      }
    </style>
    <%- include('../partials/flash') %>

    <div class="sd-page<%= locals.transportationSnapshot ? ' has-transportation' : '' %>">
    <div class="link-to-next-back">
      <% if (req.session && req.session.guardianId) { %>
      <a href="/guardian/dashboard" class="btn btn-secondary">Back to Dashboard</a>
      <% } %>
    </div>
      <% if (!studentEnrolledInCurrent) { %>
      <div class="flash-message flash-error">
        This student is <strong>not enrolled</strong> in the current school year
        (<%= currentSchoolYearLabel %>) and term (<%= currentTermName %>).
      </div>
      <% } %>

        <% if (locals.oldSystem && oldSystem.alerts.length) { %>
        <%# Custody and pickup restrictions from the school's old system: always shown first. %>
        <div role="alert" style="margin:0 0 12px;padding:12px 14px;border:1px solid #fecaca;border-radius:12px;background:#fef2f2;color:#991b1b;">
          <% oldSystem.alerts.forEach(function (a) { %><p style="margin:2px 0"><strong><%= a.label %>:</strong> <%= a.text %></p><% }) %>
        </div>
        <% } %>
      <%
        var _isStaff = !(req.session && req.session.guardianId);
        var _name = (typeof formatDisplayName === 'function' ? formatDisplayName(student) : (student.first_name + ' ' + student.last_name));
        var _studentDisplayId = '';
        if (studentIdSettings && studentIdSettings.use_custom_student_id) {
          var _studentPrefix = studentIdSettings.student_id_prefix || '';
          _studentDisplayId = student.custom_student_id || (_studentPrefix ? _studentPrefix + String(student.student_id).padStart(3, '0') : String(student.student_id).padStart(3, '0'));
        }
        var _perms = locals.userPermissions || [];
        var _cid = student.class_id || '';
        var _active = !locals.archiveStatus;
        var _canMessage = _isStaff && _perms.includes('mailroom');
        var _messageHref = '/common/mailroom?student=' + encodeURIComponent((student.first_name || '') + ' ' + (student.last_name || '')).replace(/%20/g, '+');
        var _reportHref = (_isStaff && _cid && workspaceAccess().reports.terminal) ? ('/print/printStudentReport?classId=' + _cid + '&termId=' + currentTerm + '&studentIds=' + student.student_id) : '';
        // Messages: Mailroom people, and a class's own staff (a teacher sees their classes' parents' conversations).
        var _hasMessages = _isStaff && _active && (_canMessage || ['Teacher', 'Supervisor'].includes(req.session.userRole));
        var _svc = locals.studentServices || locals.schoolServices || { attendance: true, lunch: true, name: 'Attendance & lunch' };
        var _hasAttendance = _isStaff && _perms.includes('mark_attendance') && (_svc.attendance || _svc.lunch);
        var _attendanceHref = (_active && _cid) ? ('/common/classDashboard/' + _cid + '/attendance') : '';
        var _hasBills = _isStaff && !!workspaceAccess().paygira.students;
        var _billsHref = '/account/settings/finance?section=students&openStudent=' + student.student_id;
        var _hasFiles = !!locals.studentDocuments;
        var _hasPortfolio = !!(locals.studentDocuments && studentDocuments.portfolio);
        var _hasRecords = !!(locals.oldSystem && ((oldSystem.history.length || (_svc.attendance && oldSystem.attendance.length) || oldSystem.sourceGpa) || (oldSystem.forms.length || oldSystem.archives.length || (oldSystem.documents || []).length || (oldSystem.extras || []).length)));
      %>
      <header class="sd-head">
        <div class="sd-head__photo">
          <% if (student.image_url && student.image_url !== 'profilePlaceholder.png') { %>
          <% const studentImageUrl = publicImageUrl(student.image_url); %>
          <img src="<%= studentImageUrl %><%= studentImageUrl.includes('?') ? '&' : '?' %>v=<%= new Date().getTime() %>" alt="<%= _name %>" />
          <% } else { %>
          <img src="/images/profilePlaceholder.png" alt="" />
          <% } %>
        </div>
        <div class="sd-head__main">
          <div class="sd-head__titlerow">
            <h1 class="sd-head__name"><%= _name %></h1>
            <% if (_studentDisplayId) { %><span class="student-id-chip">ID: <%= _studentDisplayId %></span><% } %>
            <% if (locals.studentPortalIntegrationActive && locals.studentPortalSetupComplete) { %><span class="student-portal-status"><span class="student-portal-check" aria-hidden="true">✓</span> Portal</span><% } %>
          </div>
          <%- include('../partials/studentArchiveBanner') %>
        </div>
        <div class="sd-head__edit">
          <% if (_isStaff && req.session.userRole !== 'Teacher' && req.session.userRole !== 'Supervisor' && !locals.archiveStatus && workspaceAccess().students.canEdit) { %>
          <a class="sd-btn" id="studentEditLink" data-no-spa href="/common/editStudent?studentId=<%= student.student_id %>&termId=<%= currentTerm %>&classId=<%= student.class_id %>">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 20h9"/><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4z"/></svg>
            Edit student
          </a>
          <% } %>
          <% if (locals.studentPortalIntegrationActive && locals.canSendStudentPortalRequest) { %>
          <button type="button" class="sd-btn" id="student-password-reset-btn" data-student-id="<%= student.student_id %>" data-portal-action="<%= studentPortalSetupComplete ? 'reset' : 'setup' %>" data-student-name="<%= _name %>" data-has-email="<%= locals.studentPortalHasEmail ? '1' : '' %>" data-edit-url="/common/editStudent?studentId=<%= student.student_id %>&termId=<%= currentTerm %>&classId=<%= student.class_id %>">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><% if (studentPortalSetupComplete) { %><rect x="4" y="11" width="16" height="9" rx="2"/><path d="M8 11V8a4 4 0 0 1 8 0v3"/><% } else { %><path d="M4 6h16v12H4z"/><path d="m4 7 8 6 8-6"/><% } %></svg>
            <span><%= studentPortalSetupComplete ? 'Reset portal password' : 'Invite to student portal' %></span>
          </button>
          <% } %>
        </div>
      </header>

      <div class="sd-tabs" role="tablist" aria-label="Student sections" id="sd-tabs">
        <button type="button" role="tab" class="sd-tab" id="sd-tab-overview" data-sd-tab="overview" aria-controls="sd-panel-overview" aria-selected="true">Overview</button>
        <button type="button" role="tab" class="sd-tab" id="sd-tab-grades" data-sd-tab="grades" aria-controls="sd-panel-grades" aria-selected="false" tabindex="-1">Grades</button>
        <% if (_hasAttendance) { %><button type="button" role="tab" class="sd-tab" id="sd-tab-attendance" data-sd-tab="attendance" aria-controls="sd-panel-attendance" aria-selected="false" tabindex="-1"><%= _svc.name %></button><% } %>
        <% if (_hasMessages) { %><button type="button" role="tab" class="sd-tab" id="sd-tab-messages" data-sd-tab="messages" aria-controls="sd-panel-messages" aria-selected="false" tabindex="-1">Messages <span class="sd-tab__n sd-tab__n--alert" id="sdMsgBadge" hidden></span></button><% } %>
        <% if (_hasBills) { %><button type="button" role="tab" class="sd-tab" id="sd-tab-bills" data-sd-tab="bills" aria-controls="sd-panel-bills" aria-selected="false" tabindex="-1">Bills</button><% } %>
        <% if (_hasFiles) { %><button type="button" role="tab" class="sd-tab" id="sd-tab-files" data-sd-tab="files" aria-controls="sd-panel-files" aria-selected="false" tabindex="-1">Files <span class="sd-tab__n"><%= studentDocuments.list.length %></span></button><% } %>
        <% if (_hasPortfolio) { %><button type="button" role="tab" class="sd-tab" id="sd-tab-portfolio" data-sd-tab="portfolio" aria-controls="sd-panel-portfolio" aria-selected="false" tabindex="-1">Portfolio</button><% } %>
        <% if (locals.transportationSnapshot) { %><button type="button" role="tab" class="sd-tab" id="sd-tab-transport" data-sd-tab="transport" aria-controls="sd-panel-transport" aria-selected="false" tabindex="-1">Transport</button><% } %>
        <% if (_hasRecords) { %><button type="button" role="tab" class="sd-tab" id="sd-tab-records" data-sd-tab="records" aria-controls="sd-panel-records" aria-selected="false" tabindex="-1">Old records</button><% } %>
      </div>

      <div class="sd-panel" id="sd-panel-overview" role="tabpanel" aria-labelledby="sd-tab-overview" data-sd-panel="overview">
        <section class="sd-card">
          <h3 class="sd-card__title">About <%= student.first_name %></h3>
          <dl class="sd-facts">
            <% if (student.gender) { %><div><dt>Gender</dt><dd><%= student.gender %></dd></div><% } %>
            <% if (student.date_of_birth) { %><div><dt>Date of birth</dt><dd><%= (typeof formatDisplayDate === 'function' ? formatDisplayDate(student.date_of_birth) : new Date(student.date_of_birth).toLocaleDateString()) %></dd></div><% } %>
            <% if (gradYearGroupName && !/^no /i.test(String(gradYearGroupName))) { %><div><dt>Graduation class</dt><dd><%= gradYearGroupName %></dd></div><% } %>
            <% if (student.hometown) { %><div><dt>Hometown</dt><dd><%= student.hometown %></dd></div><% } %>
            <% if (student.address) { %><div class="sd-facts__wide"><dt>Address</dt><dd><%= student.address %></dd></div><% } %>
            <% if (student.email) { %><div><dt>Email</dt><dd><%= student.email %></dd></div><% } %>
            <% (locals.customAnswers || []).forEach(function (f) { %><div><dt><%= f.label %></dt><dd style="white-space: pre-wrap"><%= f.display %></dd></div><% }) %>
            <% if (locals.oldSystem) { oldSystem.extras.forEach(function (x) { %><div><dt><%= x.label %></dt><dd style="white-space: pre-wrap"><%= x.value %><% if (x.sensitive) { %> <small style="color:#b91c1c">(restricted)</small><% } %></dd></div><% }); } %>
          </dl>
        </section>
      <% if (req.session && !req.session.guardianId) { %>
      <section class="sd-card">
      <h3 class="sd-card__title">Parents &amp; guardians</h3>
      <div class="table-container">
        <table>
          <thead>
            <tr>
              <th>Name</th>
              <th>Phone</th>
              <th>Email</th>
              <th>Address</th>
              <th class="sd-col-action"><span class="sd-sr">Open</span></th>
            </tr>
          </thead>
          <tbody>
            <% guardians.forEach(guardian => { %>
            <% const _gName = (typeof formatDisplayName === 'function' ? formatDisplayName(guardian) : [guardian.first_name, guardian.last_name].filter(Boolean).join(' ').trim()); %>
            <tr>
              <td><%= _gName %></td>
              <td><%= guardian.phone || '—' %></td>
              <td><%= guardian.email || '—' %></td>
              <td><%= [guardian.address, guardian.hometown].filter(Boolean).join(' · ') || '—' %></td>
              <td class="sd-col-action">
                <a href="/common/person-card/guardian/<%= guardian.guardian_id %>?source=legacy" class="sd-view" data-guardian-view data-guardian-name="<%= _gName %>" data-no-spa aria-label="View <%= _gName %>">View</a>
              </td>
            </tr>
            <% }) %>
            <% if (!guardians.length) { %>
            <tr><td colspan="5" class="sd-empty">No parent or guardian linked yet.</td></tr>
            <% } %>
          </tbody>
        </table>
      </div>
      </section>
      <% } %>
      </div>
      <div class="sd-panel" id="sd-panel-grades" role="tabpanel" aria-labelledby="sd-tab-grades" data-sd-panel="grades" hidden>
      <section class="sd-card">
      <div class="sd-bar">
        <span class="sd-bar__note">This term</span>
        <% if (_reportHref) { %><a class="sd-track" href="<%= _reportHref %>" target="_blank" rel="noopener" data-no-spa title="Report card (opens in a new tab)"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 3h8l4 4v14H7z"/><path d="M15 3v4h4M10 12h6M10 16h6"/></svg>Report card</a><% } %>
      </div>
      <div class="table-container">
        <table>
          <thead>
            <tr>
              <th>Subject</th>
              <% uniqueAssessments.forEach(assessment => { %>
              <th>
                <%= assessment.title %> <small style="opacity:.65">Weight <%= assessment.weight %></small><br />
                <small><%= [assessment.category, assessment.max_score !== null && assessment.max_score !== undefined ? 'out of ' + Number(assessment.max_score) : ''].filter(Boolean).join(' · ') %></small>
              </th>
              <% }) %>
              <th style="white-space:normal;min-width:80px;">Total<br><small>raw score</small></th>
              <th style="white-space:normal;min-width:80px;">Scaled<br><small>of scale base</small></th>
              <th style="white-space:normal;min-width:70px;">Percent</th>
              <th>Grade</th>
              <th>Position</th>
            </tr>
          </thead>
          <tbody>
            <% subjects.forEach(subject => { %>
            <tr>
              <td><%= subject.subject_name %></td>
              <% uniqueAssessments.forEach(assessmentTitle => { %> <% const
              assessment = subject.assessments.find(a => a.title ===
              assessmentTitle.title); %>
              <td>
                <%= assessment && assessment.choice_label ? assessment.choice_label : assessment ? (typeof assessment.score === 'number' ?
                assessment.score.toFixed(2) : (assessment.score !== null &&
                assessment.score !== undefined ? assessment.score : '-')) : ''
                %>
              </td>
              <% }) %>
              <td>
                <%= subject.totalScore !== null && subject.totalScore !==
                undefined ? subject.totalScore.toFixed(2) : '-' %>
              </td>
              <td>
                <% if (subject.totalPercentage !== null && subject.totalPercentage !== undefined) { %>
                  <% const _scaleBase = Number(subject.scaleBase) || 100; %><%= (subject.totalPercentage / 100 * _scaleBase).toFixed(2) %> / <%= _scaleBase %>
                <% } else { %>-<% } %>
              </td>
              <td>
                <%= subject.totalPercentage !== null && subject.totalPercentage
                !== undefined ? subject.totalPercentage.toFixed(2) : '-' %> %
              </td>
              <td><%= subject.grade ? subject.grade : '-' %></td>
              <td>
                <%= subject.position !== '-' ? subject.position +
                getOrdinalSuffix(subject.position) : '-' %>
              </td>
            </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
      </section>
      </div>
      <% if (_hasAttendance) { %>
      <div class="sd-panel" id="sd-panel-attendance" role="tabpanel" aria-labelledby="sd-tab-attendance" data-sd-panel="attendance" hidden>
      <section class="sd-card" id="sdAtt" data-student="<%= student.student_id %>" data-term="<%= currentTerm %>">
        <div class="sd-bar">
          <span class="sd-bar__note">This term</span>
          <% if (_attendanceHref) { %><a class="sd-track" href="<%= _attendanceHref %>" target="_blank" rel="noopener" data-no-spa title="Open the class <%= _svc.name.toLowerCase() %> (opens in a new tab)"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 11l3 3 8-8"/><path d="M20 12v7a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V7a2 2 0 0 1 2-2h9"/></svg>Take attendance</a><% } %>
        </div>
        <div id="sdAttBody" aria-live="polite"><div class="sd-loading" role="status" aria-label="Loading"><span class="sd-spin"></span></div></div>
      </section>
      </div>
      <% } %>
      <% if (_hasBills) { %>
      <div class="sd-panel" id="sd-panel-bills" role="tabpanel" aria-labelledby="sd-tab-bills" data-sd-panel="bills" hidden>
      <section class="sd-card" id="sdBills" data-student="<%= student.student_id %>">
        <div class="sd-bar">
          <span class="sd-bar__note">Balance across all terms</span>
          <a class="sd-track" href="<%= _billsHref %>" target="_blank" rel="noopener" data-no-spa title="Open bills and payments (opens in a new tab)"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="6" width="18" height="12" rx="2"/><circle cx="12" cy="12" r="2.5"/></svg>Bills &amp; payments</a>
        </div>
        <div id="sdBillsBody" aria-live="polite"><div class="sd-loading" role="status" aria-label="Loading"><span class="sd-spin"></span></div></div>
      </section>
      </div>
      <% } %>
      <% if (_hasMessages) { %>
      <div class="sd-panel" id="sd-panel-messages" role="tabpanel" aria-labelledby="sd-tab-messages" data-sd-panel="messages" hidden>
      <section class="sd-card sd-msgs" id="sdMsgs" data-student="<%= student.student_id %>" data-term="<%= currentTerm %>" data-can-send="<%= _canMessage ? '1' : '' %>">
        <div class="sd-bar">
          <div class="sd-msgs__filters" role="group" aria-label="Show">
            <button type="button" class="sd-chip is-on" data-msg-filter="all">All</button>
            <button type="button" class="sd-chip" data-msg-filter="thread">Conversations</button>
            <% if (_canMessage) { %><button type="button" class="sd-chip" data-msg-filter="sent">Sent by the school</button><% } %>
          </div>
          <% if (_canMessage) { %><a class="sd-track" href="<%= _messageHref %>" target="_blank" rel="noopener" data-no-spa title="Message the family (opens in a new tab)"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 20h9"/><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4z"/></svg>New message</a><% } %>
        </div>
        <div class="sd-msgs__list" id="sdMsgList" aria-live="polite"><div class="sd-loading" role="status" aria-label="Loading"><span class="sd-spin"></span></div></div>
      </section>
      </div>
      <% } %>
      <% if (locals.studentDocuments) { %>
      <div class="sd-panel" id="sd-panel-files" role="tabpanel" aria-labelledby="sd-tab-files" data-sd-panel="files" hidden>
      <% if (locals.studentDocuments) { const _sd = studentDocuments;
           const _shareShort = { staff: 'Staff', managers: 'Managers only', family: 'Family' };
           const _day = (d) => d ? new Date(d + 'T12:00:00Z').toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric', timeZone: 'UTC' }) : ''; %>
      <%# Files and portfolio (routes/studentDocumentsRoute.js). Adding or changing a
          file opens the right-side drawer (views/common/studentDocumentForm.ejs); saving reloads the page. %>
      <section class="sd-card sd-files" id="student-documents">
        <div class="sd-files__bar">
          <h3 class="sd-card__title sd-files__title">Files <span class="sd-files__count"><%= _sd.list.length %></span></h3>
          <button type="button" class="sd-files__add" data-file-drawer="/common/student-documents/<%= student.student_id %>/new">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>
            Add file
          </button>
        </div>

        <div class="sd-files__pane" id="sd-pane-files" role="tabpanel" aria-labelledby="sd-tab-files">
          <% if (!_sd.list.length) { %>
            <p class="sd-files__empty">No files yet.</p>
          <% } else { %>
          <ul class="sd-filelist">
            <% _sd.list.forEach(function (d) { %>
            <li class="sd-file">
              <span class="sd-file__ext" aria-hidden="true"><%= (String(d.fileName).split('.').pop() || 'FILE').toUpperCase().slice(0, 4) %></span>
              <div class="sd-file__main">
                <a class="sd-file__title" href="/common/student-documents/file/<%= d.id %>" target="_blank" rel="noopener" data-no-spa><%= d.title %></a>
                <span class="sd-file__meta"><%= d.typeLabel %><% if (d.expiresOn) { %> · <span class="<%= d.expired ? 'is-expired' : (d.expiresSoon ? 'is-soon' : '') %>"><%= d.expired ? 'Expired' : 'Expires' %> <%= _day(d.expiresOn) %></span><% } %><% if (d.note) { %> · <span class="sd-file__note" title="<%= d.note %>">Note</span><% } %></span>
              </div>
              <span class="sd-file__who sd-file__who--<%= d.sharing %>" title="<%= d.sharingLabel %>"><%= _shareShort[d.sharing] || d.sharing %></span>
              <div class="sd-file__acts">
                <a href="/common/student-documents/file/<%= d.id %>" target="_blank" rel="noopener" data-no-spa>Open</a>
                <button type="button" data-file-drawer="/common/student-documents/<%= student.student_id %>/<%= d.id %>/edit">Edit</button>
              </div>
            </li>
            <% }) %>
          </ul>
          <% } %>
        </div>

        <script nonce="<%= locals.cspNonce || '' %>">
          // Add file and Edit open in the right-side drawer; a save there reloads this page.
          (function () {
            var card = document.getElementById('student-documents');
            if (!card || card.dataset.bound) return;
            card.dataset.bound = '1';
            var drawer = null;
            function openDrawer(url) {
              if (!window.ManagiraDrawer) { window.location.href = url; return; }
              if (!drawer) {
                drawer = window.ManagiraDrawer.create({ id: 'studentFile', icon: '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z"/><path d="M14 3v5h5"/></svg>', title: 'Student file', subtitle: <%- JSON.stringify((typeof formatDisplayName === 'function' ? formatDisplayName(student) : (student.first_name + ' ' + student.last_name)) || '') %>, width: 560, belowHeader: true });
                window.addEventListener('message', function (event) {
                  if (event.origin !== window.location.origin || !event.data || event.data.drawerId !== 'studentFile') return;
                  if (event.data.managiraDrawerClose) window.location.reload();
                  else if (event.data.managiraDrawerCancel) drawer.close();
                });
              }
              drawer.open(url, { forceReload: true });
            }
            card.addEventListener('click', function (event) {
              var opener = event.target.closest('[data-file-drawer]');
              if (opener) { event.preventDefault(); openDrawer(opener.getAttribute('data-file-drawer')); }
            });
          })();
        </script>
        </script>
      </section>
      <% } %>
      </div>
      <% } %>
      <% if (_hasPortfolio) { const _sd = studentDocuments; %>
      <div class="sd-panel" id="sd-panel-portfolio" role="tabpanel" aria-labelledby="sd-tab-portfolio" data-sd-panel="portfolio" hidden>
        <% if (_sd.portfolio) { %>
        <link rel="stylesheet" href="<%= assetUrl('/css/portfolio.css') %>" />
        <div class="sd-card pf" id="sd-pane-portfolio" data-portfolio-src="/common/student-documents/<%= student.student_id %>/portfolio">
          <div data-portfolio-body><div class="pf-empty">Loading…</div></div>
        </div>
        <script nonce="<%= locals.cspNonce || '' %>">
          (function () {
            var pane = document.getElementById('sd-pane-portfolio');
            if (!pane || pane.dataset.bound) return;
            pane.dataset.bound = '1';
            var body = pane.querySelector('[data-portfolio-body]');
            var loaded = false;
            // The portfolio loads the first time its tab is opened; another term loads in place.
            function load(url) {
              body.setAttribute('aria-busy', 'true');
              fetch(url, { credentials: 'same-origin', headers: { Accept: 'text/html' } })
                .then(function (r) { return r.ok ? r.text() : Promise.reject(r.status); })
                .then(function (html) {
                  body.innerHTML = html;
                  body.querySelectorAll('a[href*="/portfolio/test/"]').forEach(function (a) { a.target = '_blank'; a.rel = 'noopener'; a.setAttribute('data-no-spa', ''); });
                })
                .catch(function () { body.innerHTML = '<div class="pf-empty">The portfolio could not load. Try again.</div>'; })
                .then(function () { body.removeAttribute('aria-busy'); });
            }
            window.addEventListener('sd:tab', function (event) {
              if (event.detail === 'portfolio' && !loaded) { loaded = true; load(pane.getAttribute('data-portfolio-src')); }
            });
            pane.addEventListener('click', function (event) {
              var term = event.target.closest('a.pf-term');
              if (term) { event.preventDefault(); load(term.getAttribute('href')); }
            });
          })();
        </script>
        <% } %>
      </div>
      <% } %>
      <% if (locals.transportationSnapshot) { %>
      <div class="sd-panel" id="sd-panel-transport" role="tabpanel" aria-labelledby="sd-tab-transport" data-sd-panel="transport" hidden>
      <% if (locals.transportationSnapshot) { const _ts = transportationSnapshot;
           // "07:37:00" reads as "7:37 AM"; distances in miles.
           const _clock = (v) => { const m = /^(\d{1,2}):(\d{2})/.exec(String(v || '')); if (!m) return v || '—'; const h = Number(m[1]); return ((h % 12) || 12) + ':' + m[2] + (h < 12 ? ' AM' : ' PM'); };
           const _miles = (km) => (km !== null && km !== undefined && Number.isFinite(Number(km))) ? (Number(km) * 0.621371).toFixed(2) + ' mi' : '—'; %>
      <section class="sd-card">
        <div class="sd-bar" style="justify-content:flex-end">
          <button
            type="button"
            class="sd-track"
            data-bus-tracker="<%= student.student_id %>"
            data-bus-tracker-name="<%= typeof formatDisplayName === 'function' ? formatDisplayName(student) : student.first_name + ' ' + student.last_name %>"
            data-transport-snapshot="<%= JSON.stringify(_ts) %>">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 21s-7-6.2-7-11a7 7 0 0 1 14 0c0 4.8-7 11-7 11z"/><circle cx="12" cy="10" r="2.5"/></svg>
            Track bus
          </button>
        </div>
        <div class="sd-bus__summary">
          <div class="sd-bus__item"><span>Bus</span><strong><%= _ts.bus && _ts.bus.busNumber ? _ts.bus.busNumber : '—' %></strong></div>
          <div class="sd-bus__item"><span>Route</span><strong><%= _ts.route && _ts.route.routeName ? _ts.route.routeName : '—' %></strong></div>
          <div class="sd-bus__item"><span>Stop</span><strong title="<%= _ts.stop && _ts.stop.stopName ? _ts.stop.stopName : '' %>"><%= _ts.stop && _ts.stop.stopName ? _ts.stop.stopName : '—' %></strong></div>
          <div class="sd-bus__item"><span>Pickup · Drop-off</span><strong><%= _clock(_ts.pickupTime) %> · <%= _clock(_ts.dropoffTime) %></strong></div>
        </div>
        <details class="sd-bus__more">
          <summary>More details</summary>
          <dl>
            <div><dt>Stop address</dt><dd><%= _ts.stop && _ts.stop.stopAddress ? _ts.stop.stopAddress : '—' %></dd></div>
            <div><dt>Distance to stop</dt><dd><%= _miles(_ts.distanceKm) %></dd></div>
            <div><dt>Live status</dt><dd><%= _ts.live && _ts.live.recordedAt ? ('Last bus update ' + new Date(_ts.live.recordedAt).toLocaleString('en-US', { month: 'short', day: 'numeric', hour: 'numeric', minute: '2-digit' })) : 'No trip running now' %></dd></div>
            <% if (_ts.homeAddress && _ts.homeAddress !== student.address) { %><div><dt>Home address</dt><dd><%= _ts.homeAddress %></dd></div><% } %>
          </dl>
        </details>
      </section>
      <% } %>
      </div>
      <% } %>
      <% if (_hasRecords) { %>
      <div class="sd-panel" id="sd-panel-records" role="tabpanel" aria-labelledby="sd-tab-records" data-sd-panel="records" hidden>
      <% if (locals.oldSystem && (oldSystem.history.length || (_svc.attendance !== false && oldSystem.attendance.length) || oldSystem.sourceGpa)) { %>
      <%# Final grades and attendance totals from the school's old system (data migration). %>
      <section class="sd-card">
        <h3 class="sd-card__title">Academic record before Managira</h3>
        <% const _sg = oldSystem.sourceGpa; %>
        <% if (oldSystem.history.length || _sg) { %>
        <p style="margin:0 0 8px;color:#475467;font-size:13px"><% if (oldSystem.history.length) { %>Credits earned <strong><%= Math.round(oldSystem.credits * 100) / 100 %></strong><% } %><% if (_sg) { %><%= oldSystem.history.length ? ' · ' : '' %>GPA from the old system: <% if (_sg.weighted !== null) { %>weighted <strong><%= _sg.weighted %></strong><% } %><% if (_sg.weighted !== null && _sg.unweighted !== null) { %> · <% } %><% if (_sg.unweighted !== null) { %>unweighted <strong><%= _sg.unweighted %></strong><% } %><% if (_sg.weighted === null && _sg.unweighted === null) { %><strong><%= _sg.gpa %></strong><% } %><% } %></p>
        <% } %>
        <% if (oldSystem.history.length) { %>
        <div class="table-container">
          <table>
            <thead><tr><th>Year</th><th>Term</th><th>Course</th><th>Grade</th><th>Percent</th><th>Credits</th><th>GPA points</th></tr></thead>
            <tbody>
              <% oldSystem.history.forEach(function (h) { %>
              <tr><td><%= h.school_year || '—' %></td><td><%= h.term || '—' %></td><td><%= h.course_name %><% if (h.course_number) { %> <small>(<%= h.course_number %>)</small><% } %></td><td><%= h.grade || '—' %></td>
                <td><%= h.percent === null ? '—' : Number(h.percent) %></td><td><%= h.credits_earned === null ? '—' : Number(h.credits_earned) %></td><td><%= h.gpa_points === null ? '—' : Number(h.gpa_points) %></td></tr>
              <% }) %>
            </tbody>
          </table>
        </div>
        <% } %>
        <% if (oldSystem.attendance.length && _svc.attendance !== false) { %>
        <h4 style="margin:14px 0 6px;font-size:14px">Attendance</h4>
        <div class="table-container">
          <table>
            <thead><tr><th>Year</th><th>Term</th><th>Present</th><th>Absent</th><th>Excused</th><th>Tardy</th></tr></thead>
            <tbody>
              <% oldSystem.attendance.forEach(function (a) { %>
              <tr><td><%= a.school_year || '—' %></td><td><%= a.term || 'Whole year' %></td><td><%= Number(a.days_present) %></td><td><%= Number(a.days_absent) %></td><td><%= Number(a.days_excused) %></td><td><%= Number(a.days_tardy) %></td></tr>
              <% }) %>
            </tbody>
          </table>
        </div>
        <% } %>
      </section>
      <% } %>
      <% if (locals.oldSystem && (oldSystem.forms.length || oldSystem.archives.length || (oldSystem.documents || []).length || oldSystem.canUnlock)) { %>
      <%# Everything else the school brought from its old system: the lists it keeps using (forms), the
          lists kept read-only, by topic, and documents. %>
      <% const _items = oldSystem.forms.length + oldSystem.archives.length + (oldSystem.documents || []).length; %>
      <section class="sd-card sd-old" data-old-records>
        <div class="sd-old__head"><h3 class="sd-card__title">From the old system</h3>
          <% if (_items > 8) { %><input type="search" class="sd-old__find" placeholder="Find a record" aria-label="Find a record from the old system" data-old-filter /><% } %></div>
        <% if (oldSystem.forms.length) { %>
        <div class="sd-old__group sd-old__group--use" data-old-group>
          <h4>Still in use</h4>
          <% oldSystem.forms.forEach(function (f) { %><a class="sd-old__item sd-old__item--form" data-old-item href="/common/custom-forms/go?section=<%= f.section_id %>&student=<%= student.student_id %>" data-no-spa><span><%= f.name %></span><small><%= f.n %> <%= f.n === 1 ? 'entry' : 'entries' %> · add more</small></a><% }) %>
        </div>
        <% } %>
        <div class="sd-old__groups">
        <% (oldSystem.topicOrder || []).forEach(function (topic) { const _a = oldSystem.archives.filter(function (a) { return a.topic === topic; }); if (!_a.length) return; %>
        <div class="sd-old__group" data-old-group>
          <h4><%= topic %></h4>
          <% _a.forEach(function (a) { %><a class="sd-old__item" data-old-item href="/common/migration/archive/<%= a.archive_id %>" target="_blank" rel="noopener" data-no-spa><span><%= a.module %></span><small><%= a.n %> <%= a.n === 1 ? 'row' : 'rows' %><%= a.sensitive ? ' · restricted' : '' %></small></a><% }) %>
        </div>
        <% }) %>
        <% if ((oldSystem.documents || []).length) { %>
        <div class="sd-old__group" data-old-group>
          <h4>Documents</h4>
