    <style>
      :root {
        --font-family: "<%= (session && session.fontStyle ? String(session.fontStyle).trim() : 'Inter') %>", sans-serif;
        --primary: var(--org-primary-color, #01535b);
        --primary-hover: var(--org-primary-hover, #014a51);
        --primary-hover-fill: color-mix(in srgb, var(--primary) 88%, white);
        --border: #e5e7eb;
        --bg: #f8fafc;
        --text: #0f172a;
        --text-muted: #64748b;
        --surface-muted: #f8fafc;
        --shadow-soft: 0 16px 30px rgba(15, 23, 42, 0.08);
      }

      body {
        font-family: var(--font-family);
      }

      body {
        background-color: var(--bg);
        margin: 0;
        text-align: center;
      }

      .sd-page {
        margin: 0 auto;
        width: min(1100px, 94%);
        max-width: 100%;
        border: 1px solid var(--border);
        border-radius: 14px;
        box-shadow: none;
        padding: 20px;
        background: #ffffff;
      }

      <% if (locals.isEmbedded) { %>
      /* Embedded inside the class-dashboard workspace iframe: the shell
         around the iframe already provides the card chrome (header, border,
         background), so this page fills it edge-to-edge instead of nesting
         a second bordered card inside it. */
      .sd-page {
        width: 100%;
        max-width: none;
        margin: 0;
        border: none;
        border-radius: 0;
        padding: 18px 22px 22px;
      }
      <% } %>

      .flash-message {
        margin: 0 0 14px;
        padding: 10px 14px;
        border-radius: 10px;
        font-size: 0.82rem;
        text-align: left;
      }
      .flash-message.error,
      .flash-message.flash-error { background: #fef2f2; color: #b91c1c; border: 1px solid #fecaca; }
      .flash-message.success { background: #f0fdf4; color: #166534; border: 1px solid #bbf7d0; }
      .flash-message.info { background: #eff6ff; color: #1d4ed8; border: 1px solid #bfdbfe; }
      .flash-close { cursor: pointer; float: right; font-weight: 700; opacity: 0.6; }
      .flash-close:hover { opacity: 1; }

      .btn {
        padding: 7px 10px;
        margin: 6px;
        cursor: pointer;
        text-decoration: none;
        font-size: 0.8rem;
        font-weight: 600;
      }

      .btn-secondary {
        background-color: var(--primary);
        color: white;
      }

      

      .btn-primary {
        background-color: var(--org-primary-color);
        color: white;
      }
      
      

      .table-container {
        overflow-x: auto;
        margin: 14px auto;
        border: 1px solid var(--border);
        border-radius: 12px;
        background: #fff;
      }

      table {
        width: 100%;
        border-collapse: collapse;
      }

      th,
      td {
        padding: 8px;
        border: 1px solid #ddd;
        text-align: left;
      }

      th {
        font-weight: bold;
        background: #f8fafc;
        font-size: 0.76rem;
        line-height: 1.25;
      }

      td {
        font-size: 0.74rem;
        line-height: 1.3;
      }

      th small,
      td small {
        font-size: 0.68rem;
      }

      .student-info-container {
        display: grid;
        grid-template-columns: minmax(148px, 172px) minmax(0, 1fr);
        align-items: stretch;
        gap: 18px;
        margin: 0;
        border: none;
        border-radius: 0;
        padding: 0;
        background: transparent;
        box-shadow: none;
      }

      .student-image-container {
        display: flex;
        align-items: center;
        justify-content: center;
        text-align: center;
        padding: 0;
        margin-bottom: 0 !important;
        border-radius: 0;
        border: none;
        background: transparent;
      }

      .student-image-container img {
        width: min(100%, 144px);
        height: min(100%, 144px);
        border-radius: 50%;
        border: 4px solid rgba(255, 255, 255, 0.95);
        box-shadow: 0 10px 28px rgba(15, 23, 42, 0.12);
        object-fit: cover;
      }

      .student-details {
        display: flex;
        flex-direction: column;
        justify-content: center;
        gap: 12px;
        min-width: 0;
        font-size: 12px;
        color: var(--text-muted);
        text-align: left;
      }

      .student-details h2 {
        font-size: clamp(1.05rem, 1.7vw, 1.35rem);
        margin: 0;
        color: var(--text);
        line-height: 1.1;
      }

      .student-heading-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 8px;
        flex-wrap: nowrap;
      }

      .student-heading-actions {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        flex-wrap: wrap;
        justify-content: flex-end;
      }

      .student-portal-request-btn {
        margin: 0;
        padding: 2px 5px !important;
        border: 1px solid rgba(1, 83, 91, 0.2);
        border-radius: 999px;
        font-size: 0.5rem !important;
        font-weight: 700;
        line-height: 1.2;
        white-space: nowrap;
        width: auto;
        min-height: 0 !important;
      }

      /* Override shared .btn sizing rules for this compact action chip */
      .btn.btn-primary.student-portal-request-btn {
        padding: 2px 5px !important;
        font-size: 0.5rem !important;
        margin: 0 !important;
      }

      .student-portal-status {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        padding: 4px 8px;
        border-radius: 999px;
        font-size: 0.62rem;
        font-weight: 700;
        letter-spacing: 0.01em;
        border: 1px solid #86efac;
        background: #f0fdf4;
        color: #166534;
      }

      .student-portal-check {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 14px;
        height: 14px;
        border-radius: 999px;
        background: #22c55e;
        color: #ffffff;
        font-size: 0.58rem;
        line-height: 1;
        font-weight: 800;
      }

      .student-id-chip {
        display: inline-flex;
        align-items: center;
        padding: 4px 8px;
        border: 1px solid rgba(1, 83, 91, 0.18);
        border-radius: 999px;
        background: color-mix(in srgb, var(--primary) 8%, white);
        color: var(--primary);
        font-size: 0.68rem;
        font-weight: 700;
        font-family: 'SFMono-Regular', Consolas, monospace;
        letter-spacing: 0.02em;
        box-shadow: 0 4px 12px rgba(1, 83, 91, 0.08);
      }

      .student-edit-link {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        padding: 5px 10px;
        border-radius: 999px;
        background: var(--primary);
        color: #ffffff;
        font-size: 0.72rem;
        font-weight: 600;
        text-decoration: none;
        white-space: nowrap;
      }

      .student-details-toggle {
        display: none;
        align-self: flex-start;
        align-items: center;
        gap: 8px;
        margin-top: -2px;
        padding: 8px 12px;
        border: 1px solid var(--border);
        border-radius: 999px;
        background: rgba(255, 255, 255, 0.94);
        color: var(--text);
        font-size: 0.8rem;
        font-weight: 600;
        cursor: pointer;
        box-shadow: 0 4px 12px rgba(15, 23, 42, 0.06);
      }

      .student-details-toggle::after {
        content: '▾';
        font-size: 0.72rem;
        transition: transform 0.2s ease;
      }

      .student-details-toggle[aria-expanded="true"]::after {
        transform: rotate(180deg);
      }

      .student-extra-details {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
      }

      .student-extra-details p {
        margin: 0;
        display: flex;
        flex-direction: column;
        gap: 3px;
        padding: 7px 12px;
        flex: 0 1 auto;
        min-width: 0;
        border: 1px solid var(--border);
        border-radius: 10px;
        background: #ffffff;
        color: var(--text);
        font-size: 0.73rem;
      }

      .student-extra-details p strong {
        font-size: 0.64rem;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        color: var(--text-muted);
      }

      h1 {
        margin: 0 0 10px;
        color: var(--text);
        text-align: left;
      }

      h3 {
        margin: 14px 0 8px;
        color: var(--text);
        font-size: 0.9rem;
      }

      .link-to-next-back {
        text-align: center;
        padding-top: 12px;
        margin-bottom: 10px;
      }
      @media screen and (max-width: 768px) {
        h1 {
          font-size: 1.5rem;
        }
      
        h2 {
          font-size: 1.2rem;
        }
      
        h3 {
          font-size: 0.88rem;
        }
      
        .btn {
          width: auto;
          font-size: 0.76rem;
          padding: 5px 8px;
          margin: 5px 3px;
        }
      
        .student-info-container {
          grid-template-columns: 1fr;
          align-items: center;
          gap: 10px;
          margin: 0;
          padding: 10px;
          justify-items: center;
          text-align: center;
        }

        .student-image-container {
          width: 100%;
          justify-content: center;
        }
      
        .student-image-container img {
          width: 120px;
          height: 120px;
        }
      
        .student-details {
          font-size: 0.7rem;
          align-items: center;
          text-align: center;
          gap: 3px;
          width: 100%;
        }

        .student-details-toggle {
          display: inline-flex;
        }

        .student-extra-details {
          display: none;
          width: 100%;
          grid-template-columns: repeat(2, minmax(0, 1fr));
          gap: 5px;
        }

        .student-info-container.open .student-extra-details {
          display: grid;
        }

        .student-extra-details p {
          min-height: 0;
          padding: 5px 6px;
          gap: 2px;
          font-size: 0.66rem;
        }
      
        .student-details h2 {
          font-size: 0.82rem;
        }

        .student-id-chip {
          padding: 3px 8px;
          font-size: 0.62rem;
        }

        .student-heading-actions {
          width: 100%;
          justify-content: center;
          gap: 3px;
        }

        .student-heading-row {
          align-items: center;
          justify-content: center;
          flex-wrap: wrap;
          gap: 5px;
        }

        .student-portal-request-btn {
          font-size: 0.54rem !important;
          padding: 2px 6px !important;
        }

        .student-details-toggle {
          padding: 5px 8px;
          font-size: 0.66rem;
        }
      
        .table-container {
          overflow-x: auto;
          width: 100%;
        }

        .table-container th,
        .table-container td {
          white-space: nowrap;
        }

        th small,
        td small {
          font-size: 0.9em;
        }

        table {
          font-size: 11px;
        }
      
        th,
        td {
          padding: 5px;
        }

        th {
          font-size: 0.66rem;
        }

        td {
          font-size: 0.64rem;
        }
      }
      
      @media screen and (max-width: 480px) {
        h1 {
          font-size: 1.2rem;
        }
      
        h2 {
          font-size: 1rem;
        }
      
        h3 {
          font-size: 0.82rem;
        }
      
        .student-details {
          font-size: 0.62rem;
          gap: 4px;
        }
      
        .student-image-container img {
          width: 100px;
          height: 100px;
        }
      
        table {
          font-size: 10px;
        }
      
        th,
        td {
          padding: 3px;
        }

        th {
          font-size: 0.6rem;
        }

        td {
          font-size: 0.58rem;
        }
      
        .btn {
          font-size: 0.7rem;
          padding: 4px 7px;
          margin: 4px 2px;
        }

        .sd-page {
          padding: 9px;
        }

        .student-image-container img {
          width: 88px;
          height: 88px;
        }

        .student-extra-details p {
          min-height: 0;
          padding: 4px 6px;
          gap: 2px;
          font-size: 0.58rem;
        }

        .student-extra-details p strong {
          font-size: 0.5rem;
        }

        .student-id-chip {
          padding: 3px 7px;
          font-size: 0.58rem;
        }

        .student-heading-actions {
          gap: 1px;
        }

        .student-heading-row {
          gap: 3px;
        }

        .student-details-toggle {
          padding: 5px 7px;
          font-size: 0.62rem;
        }

        .student-portal-request-btn {
          font-size: 0.52rem !important;
          padding: 2px 5px !important;
        }
      }

      .table-container table {
        position: relative;
        border-collapse: separate;
        border-spacing: 0;
      }

      .table-container th:first-child,
.table-container td:first-child {
        position: sticky;
        left: 0;
        background-color: #f8f9fa;
        z-index: 1;
      }

      /* Cards: profile, transportation, grades, parents. */
      .sd-page { background: transparent; border: 0; text-align: left; }
      .sd-page.has-transportation { padding-bottom: 60px; }
      .sd-card {
        padding: 16px 18px;
        border: 1px solid var(--border, #e2e8f0);
        border-radius: 12px;
        background: #ffffff;
        text-align: left;
      }
      .sd-card + .sd-card { margin-top: 14px; }
      .sd-card__title { margin: 0 0 10px; font-size: 0.95rem; font-weight: 700; color: #0f172a; text-align: left; }
      .sd-card .table-container { margin: 0; border: 1px solid #eef0f3; border-radius: 10px; }
      .sd-card th, .sd-card td { border: 0; border-bottom: 1px solid #eef0f3; padding: 9px 12px; }
      .sd-card tr:last-child > td, .sd-card tbody tr:last-child > th { border-bottom: 0; }
      .sd-card th { background: #f8fafc; color: #475569; font-size: 0.7rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.03em; }
      .sd-card th small { font-weight: 500; text-transform: none; letter-spacing: 0; color: #64748b; }
      .sd-card td { color: #0f172a; font-size: 0.8rem; }
      .sd-card .table-container th:first-child, .sd-card .table-container td:first-child { background-color: #f8fafc; }
      .sd-card tbody td:first-child { font-weight: 600; }
      .sd-profile .student-image-container img { width: 96px; height: 96px; border-width: 3px; box-shadow: 0 4px 14px rgba(15, 23, 42, 0.1); }
      .sd-profile .student-info-container { grid-template-columns: 112px minmax(0, 1fr); align-items: center; }
      .sd-profile .student-heading-row { align-items: flex-start; }
      .sd-name h2 { margin: 0; color: #0f172a; font-size: 1.3rem; line-height: 1.2; }
      .sd-sub { margin: 4px 0 0; color: #64748b; font-size: 0.85rem; }
      .sd-profile .student-id-chip { box-shadow: none; font-size: 0.72rem; padding: 5px 10px; }
      .sd-profile .student-edit-link { padding: 6px 12px; font-size: 0.78rem; }
      .sd-view {
        display: inline-flex; align-items: center; padding: 5px 12px; border-radius: 8px;
        background: color-mix(in srgb, var(--primary) 10%, white); color: var(--primary);
        font-size: 0.78rem; font-weight: 600; text-decoration: none; white-space: nowrap;
      }
      button.sd-view { border: 0; cursor: pointer; font-family: inherit; }
      .sd-card > button.sd-view { margin-top: 12px; min-height: 40px; }
      .sd-empty { color: #64748b; text-align: center; }
      .sd-col-action { width: 1%; text-align: right; white-space: nowrap; }
      .sd-sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }
      @media screen and (min-width: 769px) {
        .sd-profile .student-extra-details { display: grid; grid-template-columns: repeat(auto-fill, minmax(160px, 1fr)); gap: 12px 24px; padding-top: 12px; border-top: 1px solid #eef0f3; }
        .sd-profile .student-extra-details p { padding: 0; border: 0; background: transparent; font-size: 0.85rem; color: #0f172a; }
        .sd-profile .student-extra-details p strong { font-size: 0.68rem; color: #64748b; font-weight: 600; }
      }
      
    </style>
    <%- include('../partials/flash') %>

    <div class="sd-page<%= locals.transportationSnapshot ? ' has-transportation' : '' %>">
    <div class="link-to-next-back">
      <% if (req.session && req.session.guardianId) { %>
      <a href="/guardian/dashboard" class="btn btn-secondary">Back to Dashboard</a>
      <% } %>
    </div>
      <% if (!studentEnrolledInCurrent) { %>
      <div class="flash-message flash-error">
        This student is <strong>not enrolled</strong> in the current school year
        (<%= currentSchoolYearLabel %>) and term (<%= currentTermName %>).
      </div>
      <% } %>

        <% if (locals.oldSystem && oldSystem.alerts.length) { %>
        <%# Custody and pickup restrictions from the school's old system: always shown first. %>
        <div role="alert" style="margin:0 0 12px;padding:12px 14px;border:1px solid #fecaca;border-radius:12px;background:#fef2f2;color:#991b1b;">
          <% oldSystem.alerts.forEach(function (a) { %><p style="margin:2px 0"><strong><%= a.label %>:</strong> <%= a.text %></p><% }) %>
        </div>
        <% } %>
      <section class="sd-card sd-profile">
      <div class="student-info-container">
        <!-- Student Image -->
        <div class="student-image-container">
          <% if (student.image_url && student.image_url !==
          'profilePlaceholder.png') { %>
          <% const studentImageUrl = publicImageUrl(student.image_url); %>
          <img
            src="<%= studentImageUrl %><%= studentImageUrl.includes('?') ? '&' : '?' %>v=<%= new Date().getTime() %>"
            alt="Student Image"
          />
          <% } else { %>
          <img src="/images/profilePlaceholder.png" alt="Placeholder Image" />
          <% } %>
        </div>


        <!-- Student Details -->
        <div class="student-details">
          <%
            var _studentDisplayId = '';
            if (studentIdSettings && studentIdSettings.use_custom_student_id) {
              var _studentPrefix = studentIdSettings.student_id_prefix || '';
              _studentDisplayId = student.custom_student_id ||
                (_studentPrefix
                  ? _studentPrefix + String(student.student_id).padStart(3, '0')
                  : String(student.student_id).padStart(3, '0'));
            }
          %>
          <div class="student-heading-row">
            <div class="sd-name">
              <h2><%= (typeof formatDisplayName === 'function' ? formatDisplayName(student) : (student.first_name + ' ' + student.last_name)) %></h2>
              <p class="sd-sub"><%= [enrolledClassForTerm, termNameForPage].filter(Boolean).join(' · ') %></p>
            </div>
            <%- include('../partials/studentArchiveBanner') %>
            <div class="student-heading-actions">
              <% if (_studentDisplayId) { %>
              <span class="student-id-chip">ID: <%= _studentDisplayId %></span>
              <% } %>
              <% if (req.session && !req.session.guardianId && req.session.userRole !== 'Teacher' && req.session.userRole !== 'Supervisor' && !locals.archiveStatus) { %>
              <% if (workspaceAccess().students.canEdit) { %><a class="student-edit-link" id="studentEditLink" data-no-spa href="/common/editStudent?studentId=<%= student.student_id %>&termId=<%= currentTerm %>&classId=<%= student.class_id %>">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 20h9"/><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4Z"/></svg>
                Edit student
              </a><% } %>
              <% } %>
              <% if (locals.studentPortalIntegrationActive && locals.studentPortalSetupComplete) { %>
              <span class="student-portal-status"><span class="student-portal-check" aria-hidden="true">✓</span> Portal</span>
              <% } %>
              <% if (locals.studentPortalIntegrationActive && locals.canSendStudentPortalRequest) { %>
              <button
                type="button"
                class="btn btn-primary student-portal-request-btn"
                id="student-password-reset-btn"
                data-student-id="<%= student.student_id %>"
                data-portal-action="<%= studentPortalSetupComplete ? 'reset' : 'setup' %>"
                data-student-name="<%= (typeof formatDisplayName === 'function' ? formatDisplayName(student) : (student.first_name + ' ' + student.last_name)) %>">
                <%= studentPortalSetupComplete ? 'Reset Pass' : 'Send Setup' %>
              </button>
              <% } %>
            </div>
          </div>
          <button class="student-details-toggle" type="button" id="student-details-toggle" aria-expanded="false" aria-controls="student-extra-details">More details</button>
          <div class="student-extra-details" id="student-extra-details">
          <% if (student.gender) { %><p><strong>Gender</strong> <%= student.gender %></p><% } %>
          <% if (student.date_of_birth) { %>
          <p><strong>Date of birth</strong> <%= (typeof formatDisplayDate === 'function' ? formatDisplayDate(student.date_of_birth) : new Date(student.date_of_birth).toLocaleDateString()) %></p>
          <% } %>
          <% if (gradYearGroupName && !/^no /i.test(String(gradYearGroupName))) { %><p><strong>Graduation class</strong> <%= gradYearGroupName %></p><% } %>
          <% if (student.hometown) { %><p><strong>Hometown</strong> <%= student.hometown %></p><% } %>
          <% if (student.address) { %>
          <p><strong>Address</strong> <%= student.address %></p>
          <% } %>
          <% if (student.email) { %>
          <p><strong>Email</strong> <%= student.email %></p>
          <% } %>
          <% (locals.customAnswers || []).forEach(function (f) { %>
          <p><strong><%= f.label %></strong> <span style="white-space: pre-wrap"><%= f.display %></span></p>
          <% }) %>
          <% if (locals.oldSystem) { %>
            <% oldSystem.extras.forEach(function (x) { %><p><strong><%= x.label %></strong> <span style="white-space: pre-wrap"><%= x.value %></span><% if (x.sensitive) { %> <small style="color:#b91c1c">(restricted)</small><% } %></p><% }) %>
            <% oldSystem.archives.forEach(function (a) { %><p><strong><%= a.module %></strong> <a href="/common/migration/archive/<%= a.archive_id %>" target="_blank" rel="noopener" data-no-spa>Open (<%= a.n %> <%= a.n === 1 ? 'row' : 'rows' %>, read-only)</a></p><% }) %>
            <% if (oldSystem.canUnlock) { %><p><strong>Restricted</strong> <%= oldSystem.hidden %> <%= oldSystem.hidden === 1 ? 'item' : 'items' %> from the old system. <a href="/common/migration/verify?next=<%= encodeURIComponent('/common/studentDetails?studentId=' + student.student_id) %>" data-no-spa>Show (asks for your authenticator code)</a></p><% } %>
          <% } %>
          </div>
        </div>
      </div>
      </section>
      <% if (locals.oldSystem && (oldSystem.history.length || oldSystem.attendance.length || oldSystem.sourceGpa)) { %>
      <%# Final grades and attendance totals from the school's old system (data migration). %>
      <section class="sd-card">
        <h3 class="sd-card__title">Academic record before Managira</h3>
        <% const _sg = oldSystem.sourceGpa; %>
        <% if (oldSystem.history.length || _sg) { %>
        <p style="margin:0 0 8px;color:#475467;font-size:13px"><% if (oldSystem.history.length) { %>Credits earned <strong><%= Math.round(oldSystem.credits * 100) / 100 %></strong><% } %><% if (_sg) { %><%= oldSystem.history.length ? ' · ' : '' %>GPA from <%= _sg.source === 'powerschool' ? 'PowerSchool' : _sg.source %>: <% if (_sg.weighted !== null) { %>weighted <strong><%= _sg.weighted %></strong><% } %><% if (_sg.weighted !== null && _sg.unweighted !== null) { %> · <% } %><% if (_sg.unweighted !== null) { %>unweighted <strong><%= _sg.unweighted %></strong><% } %><% if (_sg.weighted === null && _sg.unweighted === null) { %><strong><%= _sg.gpa %></strong><% } %><% } %></p>
        <% } %>
        <% if (oldSystem.history.length) { %>
        <div class="table-container">
          <table>
            <thead><tr><th>Year</th><th>Term</th><th>Course</th><th>Grade</th><th>Percent</th><th>Credits</th><th>GPA points</th></tr></thead>
            <tbody>
              <% oldSystem.history.forEach(function (h) { %>
              <tr><td><%= h.school_year || '—' %></td><td><%= h.term || '—' %></td><td><%= h.course_name %><% if (h.course_number) { %> <small>(<%= h.course_number %>)</small><% } %></td><td><%= h.grade || '—' %></td>
                <td><%= h.percent === null ? '—' : Number(h.percent) %></td><td><%= h.credits_earned === null ? '—' : Number(h.credits_earned) %></td><td><%= h.gpa_points === null ? '—' : Number(h.gpa_points) %></td></tr>
              <% }) %>
            </tbody>
          </table>
        </div>
        <% } %>
        <% if (oldSystem.attendance.length) { %>
        <h4 style="margin:14px 0 6px;font-size:14px">Attendance</h4>
        <div class="table-container">
          <table>
            <thead><tr><th>Year</th><th>Term</th><th>Present</th><th>Absent</th><th>Excused</th><th>Tardy</th></tr></thead>
            <tbody>
              <% oldSystem.attendance.forEach(function (a) { %>
              <tr><td><%= a.school_year || '—' %></td><td><%= a.term || 'Whole year' %></td><td><%= Number(a.days_present) %></td><td><%= Number(a.days_absent) %></td><td><%= Number(a.days_excused) %></td><td><%= Number(a.days_tardy) %></td></tr>
              <% }) %>
            </tbody>
          </table>
        </div>
        <% } %>
      </section>
      <% } %>
      <% if (locals.transportationSnapshot) { %>
      <section class="sd-card">
      <h3 class="sd-card__title">Transportation</h3>
      <div class="table-container">
        <table>
          <tbody>
            <tr>
              <th>Bus</th>
              <td><%= transportationSnapshot.bus && transportationSnapshot.bus.busNumber ? transportationSnapshot.bus.busNumber : '-' %></td>
              <th>Route</th>
              <td><%= transportationSnapshot.route && transportationSnapshot.route.routeName ? transportationSnapshot.route.routeName : '-' %></td>
            </tr>
            <tr>
              <th>Stop</th>
              <td><%= transportationSnapshot.stop && transportationSnapshot.stop.stopName ? transportationSnapshot.stop.stopName : '-' %></td>
              <th>Stop Address</th>
              <td><%= transportationSnapshot.stop && transportationSnapshot.stop.stopAddress ? transportationSnapshot.stop.stopAddress : '-' %></td>
            </tr>
            <tr>
              <th>Pickup</th>
              <td><%= transportationSnapshot.pickupTime || '-' %></td>
              <th>Dropoff</th>
              <td><%= transportationSnapshot.dropoffTime || '-' %></td>
            </tr>
            <tr>
              <th>Distance to stop</th>
              <td><%= transportationSnapshot.distanceKm !== null && transportationSnapshot.distanceKm !== undefined ? Number(transportationSnapshot.distanceKm).toFixed(2) + ' km' : '-' %></td>
              <th>Live status</th>
              <td><%= transportationSnapshot.live && transportationSnapshot.live.recordedAt ? ('Last bus update: ' + new Date(transportationSnapshot.live.recordedAt).toLocaleString()) : 'No live trip update yet.' %></td>
            </tr>
            <% if (transportationSnapshot.homeAddress && transportationSnapshot.homeAddress !== student.address) { %>
            <tr>
              <th>Home address</th>
              <td colspan="3"><%= transportationSnapshot.homeAddress %></td>
            </tr>
            <% } %>
          </tbody>
        </table>
      </div>
      <button
        type="button"
        class="sd-view"
        data-bus-tracker="<%= student.student_id %>"
        data-bus-tracker-name="<%= typeof formatDisplayName === 'function' ? formatDisplayName(student) : student.first_name + ' ' + student.last_name %>"
        data-transport-snapshot="<%= JSON.stringify(transportationSnapshot) %>">Track bus</button>
      </section>
      <% } %>
      <section class="sd-card">
      <h3 class="sd-card__title">Grades</h3>
      <div class="table-container">
        <table>
          <thead>
            <tr>
              <th>Subject</th>
              <% uniqueAssessments.forEach(assessment => { %>
              <th>
                <%= assessment.title %> (<%= assessment.weight %>%)<br />
                <small><%= [assessment.category, assessment.max_score !== null && assessment.max_score !== undefined ? 'out of ' + Number(assessment.max_score) : ''].filter(Boolean).join(' · ') %></small>
              </th>
              <% }) %>
              <th style="white-space:normal;min-width:80px;">Total<br><small>raw score</small></th>
              <th style="white-space:normal;min-width:80px;">Scaled<br><small>of scale base</small></th>
              <th style="white-space:normal;min-width:70px;">Percent</th>
              <th>Grade</th>
              <th>Position</th>
            </tr>
          </thead>
          <tbody>
            <% subjects.forEach(subject => { %>
            <tr>
              <td><%= subject.subject_name %></td>
              <% uniqueAssessments.forEach(assessmentTitle => { %> <% const
              assessment = subject.assessments.find(a => a.title ===
              assessmentTitle.title); %>
              <td>
                <%= assessment && assessment.choice_label ? assessment.choice_label : assessment ? (typeof assessment.score === 'number' ?
                assessment.score.toFixed(2) : (assessment.score !== null &&
                assessment.score !== undefined ? assessment.score : '-')) : ''
                %>
              </td>
              <% }) %>
              <td>
                <%= subject.totalScore !== null && subject.totalScore !==
                undefined ? subject.totalScore.toFixed(2) : '-' %>
              </td>
              <td>
                <% if (subject.totalPercentage !== null && subject.totalPercentage !== undefined) { %>
                  <% const _scaleBase = Number(subject.scaleBase) || 100; %><%= (subject.totalPercentage / 100 * _scaleBase).toFixed(2) %> / <%= _scaleBase %>
                <% } else { %>-<% } %>
              </td>
              <td>
                <%= subject.totalPercentage !== null && subject.totalPercentage
                !== undefined ? subject.totalPercentage.toFixed(2) : '-' %> %
              </td>
              <td><%= subject.grade ? subject.grade : '-' %></td>
              <td>
                <%= subject.position !== '-' ? subject.position +
                getOrdinalSuffix(subject.position) : '-' %>
              </td>
            </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
      </section>
      <% if (req.session && !req.session.guardianId) { %>
      <section class="sd-card">
      <h3 class="sd-card__title">Parents &amp; guardians</h3>
      <div class="table-container">
        <table>
          <thead>
            <tr>
              <th>Name</th>
              <th>Phone</th>
              <th>Email</th>
              <th>Address</th>
              <th class="sd-col-action"><span class="sd-sr">Open</span></th>
            </tr>
          </thead>
          <tbody>
            <% guardians.forEach(guardian => { %>
            <% const _gName = (typeof formatDisplayName === 'function' ? formatDisplayName(guardian) : [guardian.first_name, guardian.last_name].filter(Boolean).join(' ').trim()); %>
            <tr>
              <td><%= _gName %></td>
              <td><%= guardian.phone || '—' %></td>
              <td><%= guardian.email || '—' %></td>
              <td><%= [guardian.address, guardian.hometown].filter(Boolean).join(' · ') || '—' %></td>
              <td class="sd-col-action">
                <a href="/common/guardianDetails?guardianId=<%= guardian.guardian_id %>" class="sd-view" data-guardian-view data-guardian-name="<%= _gName %>" data-no-spa aria-label="View <%= _gName %>">View</a>
              </td>
            </tr>
            <% }) %>
            <% if (!guardians.length) { %>
            <tr><td colspan="5" class="sd-empty">No parent or guardian linked yet.</td></tr>
            <% } %>
          </tbody>
        </table>
      </div>
      </section>
      <% } %>
    </div>

    <%- include('../partials/adminDrawer') %>
    <script>
  // Edit student opens in the right-side drawer; saving reloads this page.
  (function () {
    const link = document.getElementById('studentEditLink');
    if (!link || !window.ManagiraDrawer || link.dataset.drawerBound) return;
    link.dataset.drawerBound = '1';
    const drawer = ManagiraDrawer.create({ id: 'editStudent', icon: '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 20h9"/><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4Z"/></svg>', title: 'Edit student', subtitle: <%- JSON.stringify((typeof formatDisplayName === 'function' ? formatDisplayName(student) : (student.first_name + ' ' + student.last_name)) || '') %>, width: 820 });
    link.addEventListener('click', function (event) {
      event.preventDefault();
      drawer.open(link.getAttribute('href') + '&embed=workspace');
    });
    window.addEventListener('message', function (event) {
      if (event.origin !== window.location.origin || !event.data || event.data.drawerId !== 'editStudent') return;
      if (event.data.managiraDrawerClose) window.location.reload();
    });
  })();
  // A guardian's details open in the same right-side drawer; if anything was
  // saved there (the drawer page loaded again), this page refreshes on close.
  (function () {
    const links = document.querySelectorAll('[data-guardian-view]');
    if (!links.length || !window.ManagiraDrawer || document.body.dataset.guardianDrawerBound) return;
    document.body.dataset.guardianDrawerBound = '1';
    const drawer = ManagiraDrawer.create({ id: 'guardianDetails', icon: '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="8" r="4"/><path d="M4 21c0-4.4 3.6-8 8-8s8 3.6 8 8"/></svg>', title: 'Parent / guardian', subtitle: '', width: 820 });
    let loads = 0;
    drawer.iframe.addEventListener('load', function () { loads += 1; });
    links.forEach(function (link) {
      link.addEventListener('click', function (event) {
        event.preventDefault();
        loads = 0;
        const sub = drawer.overlay.querySelector('.mgr-drawer-header p');
        if (sub) sub.textContent = link.dataset.guardianName || '';
        drawer.open(link.getAttribute('href') + '&embed=workspace', { forceReload: true });
      });
    });
    new MutationObserver(function () {
      if (!drawer.overlay.classList.contains('is-open') && loads > 1) window.location.reload();
    }).observe(drawer.overlay, { attributes: true, attributeFilter: ['class'] });
  })();
    </script>
    <% if (locals.transportationSnapshot) { %>
    <script src="/js/managiraMaps.js?v=<%= assetVersion %>"></script>
    <script src="/js/busTracker.js?v=<%= assetVersion %>"></script>
    <% } %>
    <script>
  (function () {
    const detailsToggle = document.getElementById('student-details-toggle');
    const studentInfoContainer = document.querySelector('.student-info-container');

    function isSmallScreen() {
      return window.matchMedia('(max-width: 768px)').matches;
    }

    function setDetailsOpen(isOpen) {
      if (!studentInfoContainer || !detailsToggle) return;
      studentInfoContainer.classList.toggle('open', isOpen);
      detailsToggle.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
      detailsToggle.textContent = isOpen ? 'Hide details' : 'More details';
    }

    function syncDetailsByViewport() {
      if (!detailsToggle) return;
      if (isSmallScreen()) {
        setDetailsOpen(false);
      } else {
        setDetailsOpen(true);
      }
    }

    if (detailsToggle && !detailsToggle.dataset.boundDetailsToggle) {
      detailsToggle.dataset.boundDetailsToggle = '1';
      detailsToggle.addEventListener('click', () => {
        const isOpen = detailsToggle.getAttribute('aria-expanded') === 'true';
        setDetailsOpen(!isOpen);
      });
      syncDetailsByViewport();
      window.addEventListener('resize', syncDetailsByViewport);
    }
  })();

  function getOrdinalSuffix(i) {
    const j = i % 10,
      k = i % 100;
    if (j == 1 && k != 11) return "st";
    if (j == 2 && k != 12) return "nd";
    if (j == 3 && k != 13) return "rd";
    return "th";
  }

  (function () {
    const resetBtn = document.getElementById('student-password-reset-btn');
    if (!resetBtn) return;

    resetBtn.addEventListener('click', async function () {
      const studentId = resetBtn.dataset.studentId;
      const studentName = resetBtn.dataset.studentName || 'this student';
      const portalAction = resetBtn.dataset.portalAction === 'reset' ? 'reset' : 'setup';
      if (!studentId) return;

      const promptText = portalAction === 'reset'
        ? `Reset password for ${studentName}? We are setting a password reset, and the student will receive an email to reset it. This is one student at a time.`
        : `Send student portal request to ${studentName}?`;
      const proceed = window.confirm(promptText);
      if (!proceed) return;

      const previousText = resetBtn.textContent;
      resetBtn.disabled = true;
      resetBtn.textContent = 'Sending...';

      try {
        const response = await fetch('/common/studentRequestPasswordReset', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/x-www-form-urlencoded;charset=UTF-8',
            'X-Requested-With': 'XMLHttpRequest',
          },
          credentials: 'same-origin',
          body: new URLSearchParams({ studentId: String(studentId), portalAction: portalAction }).toString(),
        });
        const data = await response.json();
        if (data && data.success) {
          if (portalAction === 'reset') {
            window.alert(data.message || 'Password reset has been set. The student will receive an email to reset the password.');
          } else {
            window.alert(data.message || 'Student portal request email sent successfully.');
          }
          return;
        }
        window.alert((data && data.error) || 'Unable to send student portal request email.');
      } catch (error) {
        window.alert('Network error while sending student portal request email.');
      } finally {
        resetBtn.disabled = false;
        resetBtn.textContent = previousText;
      }
    });
  })();
    </script>
