    <script nonce="<%= locals.cspNonce || '' %>">
  // Edit student opens in the right-side drawer; saving reloads this page.
  (function () {
    const link = document.getElementById('studentEditLink');
    if (!link || !window.ManagiraDrawer || link.dataset.drawerBound) return;
    link.dataset.drawerBound = '1';
    const drawer = ManagiraDrawer.create({ id: 'editStudent', icon: '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 20h9"/><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4Z"/></svg>', title: 'Edit student', subtitle: <%- JSON.stringify((typeof formatDisplayName === 'function' ? formatDisplayName(student) : (student.first_name + ' ' + student.last_name)) || '') %>, width: 1000, belowHeader: true });
    link.addEventListener('click', function (event) {
      event.preventDefault();
      drawer.open(link.getAttribute('href') + '&embed=workspace');
    });
    // Opened from a person card's Edit student (?edit=1): straight to the form.
    if (new URLSearchParams(window.location.search).get('edit') === '1') setTimeout(function () { link.click(); }, 150);
    window.addEventListener('message', function (event) {
      if (event.origin !== window.location.origin || !event.data || event.data.drawerId !== 'editStudent') return;
      if (event.data.managiraDrawerClose) window.location.reload();
    });
  })();
  // A parent's card (controllers/personCardController.js) opens in the right-side drawer: what the
  // person looking may see, and buttons into Parents & guardians for those who can edit.
  (function () {
    const links = document.querySelectorAll('[data-guardian-view]');
    if (!links.length || !window.ManagiraDrawer || document.body.dataset.guardianDrawerBound) return;
    document.body.dataset.guardianDrawerBound = '1';
    const drawer = ManagiraDrawer.create({ id: 'guardianDetails', icon: '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="8" r="4"/><path d="M4 21c0-4.4 3.6-8 8-8s8 3.6 8 8"/></svg>', title: 'Parent / guardian', subtitle: '', width: 720, belowHeader: true });
    links.forEach(function (link) {
      link.addEventListener('click', function (event) {
        event.preventDefault();
        const sub = drawer.overlay.querySelector('.mgr-drawer-header p');
        if (sub) sub.textContent = link.dataset.guardianName || '';
        drawer.open(link.getAttribute('href') + '&embed=workspace', { forceReload: true });
      });
    });
  })();
