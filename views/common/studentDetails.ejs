<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Student Details</title>
    <style>
      :root {
        --font-family: "<%= (session && session.fontStyle ? String(session.fontStyle).trim() : 'Inter') %>", sans-serif;
        --primary: var(--org-primary-color, #01535b);
        --primary-hover: var(--org-primary-hover, #014a51);
        --border: #e5e7eb;
        --bg: #f8fafc;
        --text: #0f172a;
      }

      body {
        font-family: var(--font-family);
      }
    </style>
    <style>
      body {
        background-color: var(--bg);
        margin: 0;
        text-align: center;
      }

      main {
        margin: 0 auto;
        width: min(1100px, 94%);
        text-align: left;
        background: #fff;
        border: 1px solid var(--border);
        border-radius: 14px;
        box-shadow: 0 6px 18px rgba(15, 23, 42, 0.05);
        padding: 16px;
      }

      .btn {
        padding: 8px 12px;
        margin: 6px;
        border: none;
        border-radius: 8px;
        cursor: pointer;
        text-decoration: none;
        font-size: 0.88rem;
        font-weight: 600;
      }

      .btn-secondary {
        background-color: var(--primary);
        color: white;
      }

      .btn-secondary:hover {
        background-color: var(--primary-hover);
      }

      .btn-primary {
        background-color: var(--org-primary-color);
        color: white;
      }
      
      .btn-primary:hover {
        background-color: var(--org-primary-hover);
      }

      .table-container {
        overflow-x: auto;
        margin: 14px auto;
        border: 1px solid var(--border);
        border-radius: 12px;
        background: #fff;
      }

      table {
        width: 100%;
        border-collapse: collapse;
        margin-bottom: 20px;
      }

      th,
      td {
        padding: 10px;
        border: 1px solid #ddd;
        text-align: left;
      }

      th {
        font-weight: bold;
        background: #f8fafc;
      }

      .student-info-container {
        display: flex;
        align-items: center;
        justify-content: flex-start;
        gap: 8px;
        margin: 0;
        border: 1px solid var(--border);
        border-radius: 12px;
        padding: 0;
        background: #fff;
      }

      .student-image-container img {
        width: 150px;
        height: 150px;
        border-radius: 50%;
        border: 2px solid #6c757d;
        object-fit: cover;
      }

      .student-details {
        display: flex;
        flex-direction: column;
        gap: 6px;
        font-size: 14px;
        color: #495057;
        text-align: left;
      }

      .student-details h2 {
        font-size: 20px;
        margin: 0;
        color: var(--text);
      }

      .student-details-toggle {
        display: none;
        margin-top: 6px;
        padding: 6px 10px;
        border: 1px solid var(--border);
        border-radius: 8px;
        background: transparent;
        color: var(--text);
        font-size: 0.8rem;
        font-weight: 600;
        cursor: pointer;
      }

      .student-details p {
        margin: 0;
      }

      h1 {
        margin: 0 0 10px;
        color: var(--text);
        text-align: left;
      }

      h3 {
        margin: 14px 0 8px;
        color: var(--text);
      }

      .link-to-next-back {
        text-align: center;
        padding-top: 12px;
        margin-bottom: 10px;
      }
      @media screen and (max-width: 768px) {
        h1 {
          font-size: 1.5rem;
        }
      
        h2 {
          font-size: 1.2rem;
        }
      
        h3 {
          font-size: 1rem;
        }
      
        .btn {
          width: auto;
          font-size: 0.9rem;
          padding: 8px 12px;
          margin: 8px 4px;
        }
      
        .student-info-container {
          flex-direction: column;
          align-items: center;
          gap: 6px;
          margin: 0;
          padding: 0;
        }
      
        .student-image-container img {
          width: 120px;
          height: 120px;
        }
      
        .student-details {
          font-size: 0.9rem;
          align-items: flex-start;
          text-align: left;
        }

        .student-details-toggle {
          display: inline-flex;
        }

        .student-extra-details {
          display: none;
        }

        .student-info-container.open .student-extra-details {
          display: block;
        }
      
        .student-details h2 {
          font-size: 1.1rem;
        }
      
        .table-container {
          overflow-x: auto;
          width: 100%;
        }

        .schedule-grid {
          grid-template-columns: 1fr;
          padding: 12px;
        }
      
        table {
          font-size: 13px;
        }
      
        th,
        td {
          padding: 6px;
        }
      }
      
      @media screen and (max-width: 480px) {
        h1 {
          font-size: 1.2rem;
        }
      
        h2 {
          font-size: 1rem;
        }
      
        h3 {
          font-size: 0.9rem;
        }
      
        .student-details {
          font-size: 0.8rem;
        }
      
        .student-image-container img {
          width: 100px;
          height: 100px;
        }
      
        table {
          font-size: 11px;
        }
      
        th,
        td {
          padding: 4px;
        }
      
        .btn {
          font-size: 0.85rem;
          padding: 6px 10px;
        }

        main {
          padding: 12px;
        }

        .student-image-container img {
          width: 88px;
          height: 88px;
        }
      }

      .table-container table {
        position: relative;
        border-collapse: separate;
        border-spacing: 0;
      }

      .schedule-card {
        margin: 18px 0;
        border: 1px solid var(--border);
        border-radius: 14px;
        background: #fff;
        overflow: hidden;
      }

      .schedule-card-header {
        padding: 16px 18px;
        background: linear-gradient(135deg, rgba(1, 83, 91, 0.08) 0%, rgba(1, 83, 91, 0.02) 100%);
        border-bottom: 1px solid var(--border);
      }

      .schedule-card-header h3 {
        margin: 0 0 6px;
      }

      .schedule-card-header p {
        margin: 0;
        color: #64748b;
        line-height: 1.6;
      }

      .schedule-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 14px;
        padding: 16px;
      }

      .schedule-day-card {
        border: 1px solid var(--border);
        border-radius: 12px;
        background: #f8fafc;
        overflow: hidden;
      }

      .schedule-day-card h4 {
        margin: 0;
        padding: 12px 14px;
        font-size: 0.95rem;
        color: var(--text);
        background: #eef2f7;
        border-bottom: 1px solid var(--border);
      }

      .schedule-day-list {
        list-style: none;
        margin: 0;
        padding: 0;
      }

      .schedule-day-list li {
        display: flex;
        justify-content: space-between;
        gap: 12px;
        padding: 12px 14px;
        border-bottom: 1px solid #e2e8f0;
      }

      .schedule-day-list li:last-child {
        border-bottom: none;
      }

      .schedule-time {
        font-weight: 700;
        color: var(--text);
        white-space: nowrap;
      }

      .schedule-subject {
        color: #475569;
        text-align: right;
      }

      .schedule-empty {
        padding: 20px 16px;
        color: #64748b;
      }
      
      .table-container th:first-child,
      .table-container td:first-child {
        position: sticky;
        left: 0;
        background-color: #f8f9fa;
        z-index: 1;
      }
      
    </style>
  </head>
  <body>
    <%- include('../partials/flash') %>

    <div class="link-to-next-back">
      <% if (req.session && req.session.guardianId) { %>
      <a href="/guardian/dashboard" class="btn btn-secondary">Back to Dashboard</a>
      <% } %>
    </div>
    <main>
      <% if (!studentEnrolledInCurrent) { %>
      <div class="flash-message flash-error">
        This student is <strong>not enrolled</strong> in the current school year
        (<%= currentSchoolYearLabel %>) and term (<%= currentTermName %>).
      </div>
      <% } %>

      <div class="student-info-container">
        <!-- Student Image -->
        <div class="student-image-container">
          <% if (student.image_url && student.image_url !==
          'profilePlaceholder.png') { %>
          <img
            src="<%= student.image_url %>?v=<%= new Date().getTime() %>"
            alt="Student Image"
          />
          <% } else { %>
          <img src="/images/profilePlaceholder.png" alt="Placeholder Image" />
          <% } %>
        </div>

        <!-- Student Details -->
        <div class="student-details">
          <h2><%= student.first_name %> <%= student.last_name %></h2>
          <button class="student-details-toggle" type="button" id="student-details-toggle" aria-expanded="false" aria-controls="student-extra-details">More details</button>
          <div class="student-extra-details" id="student-extra-details">
          <p><strong>Gender:</strong> <%= student.gender %></p>
          <p><strong>Term:</strong> <%= termNameForPage %></p>
          <p><strong>Class for Term:</strong> <%= enrolledClassForTerm %></p>
          <p><strong>Graduation Class:</strong> <%= gradYearGroupName %></p>
          <p>
            <strong>Date of Birth:</strong> <%= new
            Date(student.date_of_birth).toLocaleDateString() %>
          </p>
          <p><strong>Hometown:</strong> <%= student.hometown %></p>
          </div>
        </div>
      </div>
      <h3>Grades</h3>
      <div class="table-container">
        <table>
          <thead>
            <tr>
              <th>Subject</th>
              <% uniqueAssessments.forEach(assessment => { %>
              <th>
                <%= assessment.title %> (<%= assessment.weight %>%)<br />
                <small><%= assessment.category %></small><br />
                Score Out Of: <%= assessment.max_score %>
              </th>
              <% }) %>
              <th>Total Subject Score</th>
              <th>Total Percentage</th>
              <th>Grade</th>
              <th>Position</th>
            </tr>
          </thead>
          <tbody>
            <% subjects.forEach(subject => { %>
            <tr>
              <td><%= subject.subject_name %></td>
              <% uniqueAssessments.forEach(assessmentTitle => { %> <% const
              assessment = subject.assessments.find(a => a.title ===
              assessmentTitle.title); %>
              <td>
                <%= assessment ? (typeof assessment.score === 'number' ?
                assessment.score.toFixed(2) : (assessment.score !== null &&
                assessment.score !== undefined ? assessment.score : '-')) : ''
                %>
              </td>
              <% }) %>
              <td>
                <%= subject.totalScore !== null && subject.totalScore !==
                undefined ? subject.totalScore.toFixed(2) : '-' %>
              </td>
              <td>
                <%= subject.totalPercentage !== null && subject.totalPercentage
                !== undefined ? subject.totalPercentage.toFixed(2) : '-' %> %
              </td>
              <td><%= subject.grade ? subject.grade : '-' %></td>
              <td>
                <%= subject.position !== '-' ? subject.position +
                getOrdinalSuffix(subject.position) : '-' %>
              </td>
            </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
      <div class="schedule-card">
        <div class="schedule-card-header">
          <h3>Class Schedule</h3>
          <p>
            <%= classSchedule ? `${classSchedule.schoolYearLabel} · ${classSchedule.termName}` : `No class schedule has been published for ${termNameForPage} yet.` %>
          </p>
        </div>
        <% if (classSchedule && classSchedule.groupedByDay.some(day => day.items.length)) { %>
        <div class="schedule-grid">
          <% classSchedule.groupedByDay.forEach(day => { %>
            <% if (day.items.length) { %>
            <section class="schedule-day-card">
              <h4><%= day.dayLabel %></h4>
              <ul class="schedule-day-list">
                <% day.items.forEach(item => { %>
                <li>
                  <span class="schedule-time"><%= item.startTime %> - <%= item.endTime %></span>
                  <span class="schedule-subject"><%= item.subjectName || 'Subject pending' %></span>
                </li>
                <% }) %>
              </ul>
            </section>
            <% } %>
          <% }) %>
        </div>
        <% } else { %>
        <div class="schedule-empty">The timetable for this term has not been added yet.</div>
        <% } %>
      </div>
      <% if (req.session && !req.session.guardianId) { %>
      <h3>Parent/Guardians of Child</h3>
      <div class="table-container">
        <table>
          <thead>
            <tr>
              <th>First Name</th>
              <th>Last Name</th>
              <th>Address</th>
              <th>Phone</th>
              <th>Email</th>
              <th>Hometown</th>
              <th>Action</th>
            </tr>
          </thead>
          <tbody>
            <% guardians.forEach(guardian => { %>
            <tr>
              <td><%= guardian.first_name %></td>
              <td><%= guardian.last_name %></td>
              <td><%= guardian.address %></td>
              <td><%= guardian.phone %></td>
              <td><%= guardian.email %></td>
              <td><%= guardian.hometown %></td>
              <td>
                <a href="/common/guardianDetails?guardianId=<%= guardian.guardian_id %>" class="btn btn-sm btn-primary" style="white-space:nowrap;">View Guardian Info</a>
              </td>
            </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
      <% } %> <% if (req.session && !req.session.guardianId && req.session.userRole !== 'Teacher' &&
      req.session.userRole !== 'Supervisor') { %>
      <hr />
      <div class="link-to-next-back">
        <a
          href="/common/editStudent?studentId=<%= student.student_id %>&termId=<%= currentTerm %>&classId=<%= student.class_id %>"
          class="btn btn-primary"
          >Modify Student Information</a
        >

        <% if (Array.isArray(allowedFeatures) &&
        allowedFeatures.includes("Official School Transcript")) { %>
        <a
          href="/transcript/transcript/<%= student.student_id %>"
          class="btn btn-primary"
          data-no-spa
          >Transcript</a>
        <% } %> <% } %>
      </div>
    </main>
  </body>
</html>
<script>
  (function () {
    const detailsToggle = document.getElementById('student-details-toggle');
    const studentInfoContainer = document.querySelector('.student-info-container');

    function isSmallScreen() {
      return window.matchMedia('(max-width: 768px)').matches;
    }

    function setDetailsOpen(isOpen) {
      if (!studentInfoContainer || !detailsToggle) return;
      studentInfoContainer.classList.toggle('open', isOpen);
      detailsToggle.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
      detailsToggle.textContent = isOpen ? 'Hide details' : 'More details';
    }

    function syncDetailsByViewport() {
      if (!detailsToggle) return;
      if (isSmallScreen()) {
        setDetailsOpen(false);
      } else {
        setDetailsOpen(true);
      }
    }

    if (detailsToggle && !detailsToggle.dataset.boundDetailsToggle) {
      detailsToggle.dataset.boundDetailsToggle = '1';
      detailsToggle.addEventListener('click', () => {
        const isOpen = detailsToggle.getAttribute('aria-expanded') === 'true';
        setDetailsOpen(!isOpen);
      });
      syncDetailsByViewport();
      window.addEventListener('resize', syncDetailsByViewport);
    }
  })();

  function getOrdinalSuffix(i) {
    const j = i % 10,
      k = i % 100;
    if (j == 1 && k != 11) return "st";
    if (j == 2 && k != 12) return "nd";
    if (j == 3 && k != 13) return "rd";
    return "th";
  }
</script>
