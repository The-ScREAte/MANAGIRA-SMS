            card.querySelector('[data-old-none]').hidden = any;
          });
        })();
      </script>
      <% } %>
      </div>
      <% } %>
      <script nonce="<%= locals.cspNonce || '' %>">
        // The student's sections are tabs: one clean page, hash-linked (#files, #portfolio, #transport).
        (function () {
          var tabs = Array.prototype.slice.call(document.querySelectorAll('[data-sd-tab]'));
          if (!tabs.length) return;
          var panels = {};
          document.querySelectorAll('[data-sd-panel]').forEach(function (p) { panels[p.getAttribute('data-sd-panel')] = p; });
          var alias = { 'student-portfolio': 'portfolio', 'student-documents': 'files' };
          function show(key, focus) {
            if (!panels[key]) key = 'overview';
            tabs.forEach(function (tab) {
              var on = tab.getAttribute('data-sd-tab') === key;
              tab.setAttribute('aria-selected', on ? 'true' : 'false');
              tab.tabIndex = on ? 0 : -1;
              if (on && focus) tab.focus();
            });
            Object.keys(panels).forEach(function (k) { panels[k].hidden = k !== key; });
            try { history.replaceState(null, '', key === 'overview' ? location.pathname + location.search : '#' + key); } catch (_) { /* not remembered */ }
            window.dispatchEvent(new CustomEvent('sd:tab', { detail: key }));
          }
          document.getElementById('sd-tabs').addEventListener('click', function (event) {
            var tab = event.target.closest('[data-sd-tab]');
            if (tab) show(tab.getAttribute('data-sd-tab'));
          });
          document.getElementById('sd-tabs').addEventListener('keydown', function (event) {
            var i = tabs.findIndex(function (t) { return t.getAttribute('aria-selected') === 'true'; });
            if (event.key === 'ArrowRight') { event.preventDefault(); show(tabs[(i + 1) % tabs.length].getAttribute('data-sd-tab'), true); }
            else if (event.key === 'ArrowLeft') { event.preventDefault(); show(tabs[(i - 1 + tabs.length) % tabs.length].getAttribute('data-sd-tab'), true); }
          });
          var wanted = String(location.hash || '').replace('#', '');
          if (wanted) show(alias[wanted] || wanted);
        })();
      </script>
      <% if (_hasAttendance || _hasBills) { %>
      <script nonce="<%= locals.cspNonce || '' %>">
        // Attendance and Bills are read when their tab is first opened, never with the page.
        (function () {
          function el(tag, cls, text) { var n = document.createElement(tag); if (cls) n.className = cls; if (text != null) n.textContent = text; return n; }
          function stat(label, value, note, warn) { var d = el('div', 'sd-stat' + (warn ? ' sd-stat--warn' : '')); d.appendChild(el('span', null, label)); d.appendChild(el('strong', null, value)); if (note) d.appendChild(el('small', null, note)); return d; }
          function failed(body, what) { body.textContent = ''; body.appendChild(el('p', 'sd-empty', what + ' could not be loaded. Try again in a moment.')); }
          var money = new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD' });
          var once = {};
          var attOffset = 0, attList = null, attMoreBtn = null;
          function dayItem(r) {
            var st = String(r.status || '').toLowerCase();
            if (st === 'present' && r.late) st = 'late';
            var li = el('li', st === 'present' ? 'is-present' : st === 'late' ? 'is-late' : st === 'absent' ? 'is-absent' : '');
            var dt = new Date(r.day + 'T12:00:00');
            li.appendChild(el('span', null, isNaN(dt) ? r.day : dt.toLocaleDateString('en-US', { month: 'short', day: 'numeric' })));
            li.appendChild(el('b', null, st ? st.charAt(0).toUpperCase() + st.slice(1) : '—'));
            if (r.note) { li.classList.add('has-note'); li.title = 'Note: ' + r.note; }
            return li;
          }
          // What the teacher wrote about a day (why they were away, left early…): newest first, under the days.
          function noteItem(r) {
            var li = el('li', 'sd-note');
            var dt = new Date(r.day + 'T12:00:00');
            var head = el('b', null, (isNaN(dt) ? r.day : dt.toLocaleDateString('en-US', { weekday: 'short', month: 'short', day: 'numeric' })) + ' · ' + (r.status === 'Present' && r.late ? 'Late' : String(r.status || '').replace(/^./, function (c) { return c.toUpperCase(); })));
            li.appendChild(head); li.appendChild(el('span', null, r.note));
            return li;
          }
          var attNotes = null;
          function addNotes(rows, atEnd) {
            var withNotes = (rows || []).filter(function (r) { return r.note; }).slice().reverse();
            if (!withNotes.length) return;
            if (!attNotes) { attNotes = el('ul', 'sd-notes'); attList.parentNode.insertBefore(attNotes, attMoreBtn || attList.nextSibling); var h = el('p', 'sd-sub', 'Notes'); attNotes.parentNode.insertBefore(h, attNotes); }
            withNotes.forEach(function (r) { if (atEnd) attNotes.appendChild(noteItem(r)); else attNotes.appendChild(noteItem(r)); });
          }
          // The totals and the last 10 days come first; "Show 10 earlier days" adds the next 10 before them.
          function loadAttendance(more) {
            var box = document.getElementById('sdAtt'); if (!box) return;
            var body = document.getElementById('sdAttBody');
            fetch('/common/student-attendance?studentId=' + box.dataset.student + '&termId=' + box.dataset.term + (more ? '&offset=' + attOffset : ''), { credentials: 'same-origin', headers: { Accept: 'application/json' } })
              .then(function (r) { return r.json(); }).then(function (d) {
                if (!d.success) throw new Error(d.error);
                if (more) {
                  (d.recent || []).forEach(function (r) { attList.insertBefore(dayItem(r), attList.firstChild); });
                  addNotes(d.recent, true);
                  attOffset += (d.recent || []).length;
                  attMoreBtn.disabled = false; attMoreBtn.textContent = 'Show 10 earlier days'; attMoreBtn.hidden = !d.moreDays;
                  return;
                }
                body.textContent = '';
                if (!d.total && !(d.lunch && d.lunch.taken)) { body.appendChild(el('p', 'sd-empty', d.attendanceOn === false ? 'No lunch has been taken for this term yet.' : 'No attendance has been taken for this term yet.')); return; }
                var grid = el('div', 'sd-stats');
                if (d.attendanceOn !== false) grid.appendChild(stat('Overall attendance', d.rate == null ? '—' : d.rate + '%', d.total ? d.present + ' of ' + d.total + ' days' : ''));
                if (d.lunch) grid.appendChild(stat('Overall lunch', d.lunch.taken ? d.lunch.days + ' of ' + d.lunch.taken : '—', d.lunch.taken ? 'days with lunch' : 'Lunch not taken yet'));
                if (d.attendanceOn !== false) { grid.appendChild(stat('Absent', String(d.absent), 'days', d.absent > 0));
                grid.appendChild(stat('Late', String(d.late), 'days')); }
                body.appendChild(grid);
                if (d.attendanceOn !== false && d.recent && d.recent.length) {
                  body.appendChild(el('p', 'sd-sub', 'Recent days'));
                  attList = el('ul', 'sd-days');
                  d.recent.forEach(function (r) { attList.appendChild(dayItem(r)); });
                  body.appendChild(attList);
                  attOffset = d.recent.length;
                  attMoreBtn = el('button', 'sd-chip', 'Show 10 earlier days');
                  attMoreBtn.type = 'button'; attMoreBtn.hidden = !d.moreDays; attMoreBtn.style.marginTop = '10px';
                  attMoreBtn.addEventListener('click', function () { attMoreBtn.disabled = true; attMoreBtn.textContent = 'Loading…'; loadAttendance(true); });
                  body.appendChild(attMoreBtn);
                  addNotes(d.recent, false);
                }
              }).catch(function () { if (more && attMoreBtn) { attMoreBtn.disabled = false; attMoreBtn.textContent = 'Show 10 earlier days'; return; } failed(body, 'Attendance'); delete once.attendance; });
          }
          function loadBills() {
            var box = document.getElementById('sdBills'); if (!box) return;
            var body = document.getElementById('sdBillsBody');
