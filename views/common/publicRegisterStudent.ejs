      <div id="stripeLoadingMsg" style="text-align:center;padding:28px;color:#666;">
        <div class="loader-circle" style="margin:0 auto 12px;"></div>
        <p style="margin:0;font-size:.9rem;">Preparing secure payment form&hellip;</p>
      </div>

      <div id="stripeElementsWrapper" style="display:none;">
        <%# ── Payout account selector ── %>
        <%
          var _prAccounts = (typeof paystackSubaccounts !== 'undefined' ? paystackSubaccounts : []);
          var _prStripe = (typeof stripeSelectable !== 'undefined' && stripeSelectable);
          var _prShowSelector = (_prAccounts.length + (_prStripe ? 1 : 0)) > 1;
        %>
        <% if (_prShowSelector) { %>
        <div id="pr-payout-selector" style="margin-bottom:16px;">
          <div style="font-size:.78rem;font-weight:600;color:#475569;margin-bottom:6px;">Pay to</div>
          <% if (_prStripe && _prAccounts.length) { %>
          <div style="font-size:.75rem;color:#64748b;margin:-2px 0 8px;">Choose where this online payment should go.</div>
          <% } %>
          <div style="display:flex;flex-wrap:wrap;gap:8px;">
            <% _prAccounts.forEach(function(acct, i) { %>
            <%
              var pIcon = acct.account_type === 'mobile_money' ? '📱' : '🏦';
              var pName = acct.account_type === 'mobile_money'
                ? (acct.business_name || acct.account_holder_name || acct.momo_provider || 'Mobile Money')
                : (acct.business_name || acct.bank_name || 'Bank Account');
              var pSub = acct.account_type === 'mobile_money'
                ? ((acct.momo_provider ? String(acct.momo_provider).toUpperCase() : 'MoMo') + (acct.momo_number ? ' · ···' + String(acct.momo_number).slice(-4) : ''))
                : ((acct.bank_name || '') + (acct.account_number ? ' · ···' + String(acct.account_number).slice(-4) : ''));
            %>
            <label id="pr-acct-lbl-<%= acct.id %>" style="display:flex;align-items:center;gap:6px;padding:7px 12px;border:1px solid <%= (!_prStripe && (i===0||acct.is_primary))?'#0d9488':'#e2e8f0' %>;border-radius:8px;cursor:pointer;font-size:.82rem;background:<%= (!_prStripe && (i===0||acct.is_primary))?'#f0fdfa':'' %>;">
              <input type="radio" name="prPayoutAccount" value="<%= acct.id %>" <%= (!_prStripe && (i===0||acct.is_primary))?'checked':'' %> onchange="prSyncPayoutCards()" style="accent-color:#0d9488;">
              <span style="display:flex;flex-direction:column;gap:2px;">
                <span><%= pIcon %> <%= pName %></span>
                <% if (pSub) { %><small style="color:#64748b;font-size:.72rem;"><%= pSub %></small><% } %>
              </span>
            </label>
            <% }); %>
            <% if (_prStripe) { %>
            <label id="pr-acct-lbl-stripe" style="display:flex;align-items:center;gap:6px;padding:7px 12px;border:1px solid #e2e8f0;border-radius:8px;cursor:pointer;font-size:.82rem;">
              <input type="radio" name="prPayoutAccount" value="stripe" onchange="prSyncPayoutCards()" style="accent-color:#635bff;">
              <span>💳 Pay with Card / Wallet (Stripe)</span>
            </label>
            <% } %>
          </div>
        </div>
        <% } %>
        <% if (!_prShowSelector && _prAccounts.length === 1) { %>
        <input type="hidden" name="prPayoutAccount" value="<%= _prAccounts[0].id %>">
        <% } else if (!_prShowSelector && _prAccounts.length > 1) { %>
        <input type="hidden" name="prPayoutAccount" value="<%= (_prAccounts.find(function(a){ return a.is_primary; }) || _prAccounts[0]).id %>">
        <% } else if (!_prShowSelector && _prStripe) { %>
        <input type="hidden" name="prPayoutAccount" value="stripe">
        <% } %>

        <div id="express-checkout-element" style="margin-bottom:12px;"></div>
        <div id="express-checkout-divider" style="display:none;text-align:center;margin:10px 0;color:#94a3b8;font-size:.82rem;">&mdash;&mdash; or pay with card &mdash;&mdash;</div>
        <div id="payment-element" style="margin-bottom:18px;"></div>
        <div id="stripeError" style="color:#dc2626;font-size:.88rem;margin-bottom:14px;display:none;padding:10px 14px;background:#fff1f2;border-radius:8px;border:1px solid #fca5a5;"></div>
        <button type="button" id="payNowBtn" onclick="payNow()">
          Pay <%= orgDetails.public_registration_currency %> <%= orgDetails.public_registration_price %>
        </button>
        <div id="feeBreakdown" style="display:none;margin:10px 0 0;border:1px solid #e2e8f0;border-radius:8px;padding:10px 12px;background:#f8fafc;font-size:.84rem;color:#334155;">
          <div style="display:flex;justify-content:space-between;gap:12px;"><span>Subtotal</span><strong id="fbSubtotal">—</strong></div>
          <div id="fbFeeRow" style="display:flex;justify-content:space-between;gap:12px;margin-top:6px;"><span>Service fee (<span id="fbPercent">0</span>%)</span><strong id="fbFee">—</strong></div>
