<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>Public Student Registration</title>
<style>
      :root {
        --font-family: "<%= (session && session.fontStyle ? String(session.fontStyle).trim() : 'Inter') %>", sans-serif;
        --pr-blue: #2563eb;
        --pr-blue-dark: #1d4ed8;
        --pr-green: #10b981;
        --pr-green-dark: #059669;
        --pr-radius: 10px;
      }

  * { box-sizing: border-box; }

  body { margin: 0; background: #f1f5f9; }

  .registration-container {
    max-width: 960px;
    margin: 24px auto;
    padding: 24px;
    background: #fff;
    border-radius: var(--pr-radius);
    box-shadow: 0 4px 24px rgba(0,0,0,.09);
    font-family: var(--font-family);
  }
  .form-header {
    text-align: center;
    margin-bottom: 22px;
  }
  .form-header h1, .form-header h2 {
    font-size: clamp(1.25rem, 4vw, 1.7rem);
    font-weight: 700;
    color: #1e293b;
    margin: 0 0 4px;
  }
  .form-group { margin-bottom: 10px; }
  .form-group label {
    font-weight: 500;
    display: block;
    margin-bottom: 3px;
    font-size: .85rem;
    color: #374151;
  }
  .form-group input,
  .form-group select {
    width: 100%;
    padding: 8px 10px;
    border-radius: 6px;
    border: 1px solid #d1d5db;
    font-size: .9rem;
    transition: border-color .2s, box-shadow .2s;
  }
  .form-group input:focus,
  .form-group select:focus {
    outline: none;
    border-color: var(--pr-blue);
    box-shadow: 0 0 0 3px rgba(37,99,235,.12);
  }
  .form-actions {
    text-align: center;
    margin-top: 24px;
  }
  .form-actions button {
    background: var(--pr-blue);
    color: #fff;
    padding: 13px 36px;
    border: none;
    border-radius: 8px;
    cursor: pointer;
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: .01em;
    transition: background .2s, transform .1s;
    width: 100%;
    max-width: 320px;
  }
  .form-actions button:hover { background: var(--pr-blue-dark); }
  .form-actions button:active { transform: scale(.98); }
  #registrationFormSection { display: none; }
  #paymentFormContainer { display: none; margin-top: 24px; }
  .back-button {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-bottom: 18px;
    background: #f1f5f9;
    color: #374151;
    padding: 8px 16px;
    border: 1px solid #e2e8f0;
    border-radius: 7px;
    cursor: pointer;
    font-size: .9rem;
    font-weight: 500;
    transition: background .2s;
  }
  .back-button:hover { background: #e2e8f0; }
  .remove-guardian {
    background: #ef4444;
    color: #fff;
    border: none;
    margin-top: 6px;
    cursor: pointer;
    border-radius: 6px;
    padding: 5px 12px;
    font-size: .85rem;
    font-weight: 500;
  }

  .loader-container {
    display: none; /* Start hidden */
    position: fixed;
    top: 0; left: 0;
    width: 100vw; height: 100vh;
    background: rgba(255, 255, 255, 0.9);
    z-index: 10000;
    flex-direction: column;
    justify-content: center;
    align-items: center;
  }
  
  .loader-circle {
    border: 6px solid #f3f3f3;
    border-top: 6px solid #2563eb;
    border-radius: 50%;
    width: 50px; height: 50px;
    animation: spin 0.8s linear infinite;
  }
  .loader-text {
    margin-top: 15px;
    font-size: 1.1rem;
    color: #2563eb;
    font-weight: bold;
  }
  @keyframes spin { 
    0% { transform: rotate(0deg); }
    100% { transform: rotate(360deg); }
  }

  /* Guardian Check Section */
  .guardian-check-section {
    text-align: center;
    padding: 18px 16px;
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: 12px;
    margin: 14px 0;
  }
  .guardian-check-section h3 {
    font-size: clamp(1rem, 3.5vw, 1.2rem);
    color: #1e293b;
    margin: 0 0 8px;
  }
  .guardian-check-section p {
    color: #64748b;
    margin: 0 0 20px;
    font-size: .95rem;
  }
  .guardian-check-buttons {
    display: flex;
    gap: 12px;
    justify-content: center;
    margin-top: 4px;
  }
  .guardian-check-buttons button {
    flex: 0 0 auto;
    width: 120px;
    padding: 10px 0;
    font-size: .95rem;
    font-weight: 600;
    border: 1px solid transparent;
    border-radius: 7px;
    cursor: pointer;
    transition: background .2s, transform .1s;
  }
  .guardian-check-buttons button:active { transform: scale(.97); }
  .btn-yes { background: var(--pr-green); color: #fff; }
  .btn-yes:hover { background: var(--pr-green-dark); }
  .btn-no { background: var(--pr-blue); color: #fff; }
  .btn-no:hover { background: var(--pr-blue-dark); }

  /* Guardian Search */
  .guardian-search-container {
    margin: 12px 0;
    padding: 12px 14px;
    background: #f9f9f9;
    border-radius: 8px;
    position: relative;
  }
  .guardian-search-input {
    width: 100%;
    padding: 8px 10px;
    font-size: .88rem;
    border: 1.5px solid #d1d5db;
    border-radius: 6px;
    margin-bottom: 0;
    transition: border-color 0.2s, box-shadow 0.2s;
  }
  .guardian-search-input:focus {
    border-color: #10b981;
    outline: none;
    box-shadow: 0 0 0 3px rgba(16, 185, 129, 0.1);
  }
  .search-wrapper {
    position: relative;
  }
  .guardian-suggestions {
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    margin-top: 3px;
    background: white;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    box-shadow: 0 4px 12px rgba(0,0,0,.1);
    max-height: 240px;
    overflow-y: auto;
    display: none;
    z-index: 1000;
  }
  .guardian-suggestions.show { display: block; }
  .guardian-suggestion-item {
    padding: 8px 10px;
    border-bottom: 1px solid #f1f5f9;
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 8px;
    transition: background 0.15s;
  }
  .guardian-suggestion-item:last-child { border-bottom: none; }
  .guardian-suggestion-item:hover { background: #f0fdf4; }
  .guardian-suggestion-item:first-child { border-radius: 8px 8px 0 0; }
  .guardian-suggestion-item:last-child { border-radius: 0 0 8px 8px; }
  .guardian-suggestion-item img {
    width: 34px;
    height: 34px;
    border-radius: 50%;
    object-fit: cover;
    border: 1.5px solid #e5e7eb;
    flex-shrink: 0;
  }
  .guardian-suggestion-info { flex: 1; min-width: 0; }
  .guardian-suggestion-name {
    font-weight: 600;
    font-size: .82rem;
    color: #1e293b;
    margin-bottom: 1px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .guardian-suggestion-details {
    font-size: .73rem;
    color: #64748b;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .selected-guardian-display {
    background: linear-gradient(135deg, #ecfdf5 0%, #d1fae5 100%);
    border: 1.5px solid #10b981;
    border-radius: 10px;
    padding: 10px 12px;
    margin: 12px 0;
    display: none;
    position: relative;
    align-items: center;
    gap: 10px;
  }
  .selected-guardian-display.show {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .selected-guardian-display img {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    object-fit: cover;
    border: 2px solid #10b981;
    flex-shrink: 0;
  }
  .selected-guardian-display .sg-info {
    flex: 1;
    min-width: 0;
  }
  .selected-guardian-display .sg-name {
    font-weight: 600;
    font-size: .82rem;
    color: #065f46;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .selected-guardian-display .sg-details {
    font-size: .74rem;
    color: #047857;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    margin-top: 1px;
  }
  .btn-change-guardian {
    background: none;
    border: 1.5px solid #10b981;
    color: #10b981;
    border-radius: 6px;
    width: 30px;
    height: 30px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    flex-shrink: 0;
    transition: background .2s, color .2s;
    title: "Change guardian";
  }
  .btn-change-guardian:hover { background: #10b981; color: #fff; }
  .btn-change-guardian svg { width: 14px; height: 14px; }
  .image-preview {
    max-width: 200px;
    max-height: 200px;
    margin-top: 10px;
    border-radius: 8px;
  }

  /* ── Two-column field grid ───────────────────────────────────── */
  .form-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0 20px;
  }
  .form-grid .form-group.full-width { grid-column: 1 / -1; }

  /* ── Section card for grouped fields ────────────────────────── */
  .form-section-card {
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    padding: 12px 14px 4px;
    margin-bottom: 12px;
  }
  .form-section-card h4 {
    margin: 0 0 8px;
    font-size: .85rem;
    font-weight: 600;
    color: #374151;
    display: flex;
    align-items: center;
    gap: 5px;
  }

  /* ── Welcome card ────────────────────────────────────────────── */
  .welcome-card {
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: 10px;
    padding: 20px;
    margin-bottom: 20px;
  }
  .welcome-card p { line-height: 1.6; color: #374151; font-size: .93rem; margin: 0 0 6px; }
  .welcome-card p:last-child { margin-bottom: 0; }
  .welcome-tagline { font-size: .93rem; color: #374151; line-height: 1.6; margin: 0 0 14px !important; }
  .welcome-steps {
    display: flex;
    gap: 8px;
    background: #fff;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    padding: 12px;
    margin-bottom: 14px;
  }
  .welcome-step {
    flex: 1;
    display: flex;
    align-items: flex-start;
    gap: 8px;
  }
  .step-num {
    min-width: 22px;
    height: 22px;
    background: var(--pr-blue);
    color: #fff;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    font-size: .75rem;
    flex-shrink: 0;
    margin-top: 1px;
  }
  .step-info { display: flex; flex-direction: column; gap: 2px; }
  .step-info strong { font-size: .82rem; color: #1e293b; }
  .step-info span { color: #64748b; font-size: .76rem; }
  .fee-line {
    display: flex;
    align-items: center;
    gap: 8px;
    margin: 0 0 10px;
    font-size: .9rem;
    color: #374151;
    flex-wrap: wrap;
  }
  .fee-note { color: #6b7280; font-size: .8rem; }
  .fee-badge {
    display: inline-block;
    background: var(--pr-blue);
    color: #fff;
    padding: 3px 12px;
    border-radius: 20px;
    font-weight: 700;
    font-size: .9rem;
  }
  .welcome-checklist {
    display: flex;
    gap: 16px;
    font-size: .8rem;
    color: #64748b;
    background: #f1f5f9;
    border-radius: 6px;
    padding: 8px 12px;
    flex-wrap: wrap;
  }

  /* ── Payment card ────────────────────────────────────────────── */
  .payment-card {
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: 12px;
    padding: 24px;
    max-width: 520px;
    margin: 0 auto;
  }
  .payment-fee-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    background: #fff;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    padding: 12px 16px;
    margin-bottom: 20px;
    font-size: 1rem;
    color: #374151;
  }
  .payment-fee-row strong { font-size: 1.1rem; color: var(--pr-blue); }
  #payNowBtn:disabled { opacity: .6; cursor: not-allowed; }

  /* ── Responsive ──────────────────────────────────────────────── */
  @media (max-width: 640px) {
    .registration-container {
      margin: 0;
      padding: 16px;
      border-radius: 0;
      box-shadow: none;
    }
    .form-grid { grid-template-columns: 1fr; gap: 0; }
    .form-section-card { padding: 14px 14px 2px; }
    .welcome-card { padding: 16px; }
    .welcome-steps { flex-direction: column; gap: 8px; }
    .welcome-checklist { gap: 8px; }
    .guardian-check-buttons {
      gap: 12px;
    }
    .guardian-check-buttons button {
      width: 120px;
      padding: 10px 0;
    }
    .payment-card { padding: 16px; }
    .form-actions button { max-width: 100%; }
    .back-button { width: 100%; justify-content: center; }
  }
  @media (min-width: 641px) and (max-width: 800px) {
    .registration-container { margin: 16px; padding: 22px; }
  }
</style>
</head>
<body>
  <%- include('../partials/flash') %>
  
  <div class="registration-container">
    <!-- Welcome Section -->
    <div id="welcomeSection">
      <div class="form-header"><h1>Welcome to <%= orgDetails.organization_name %></h1></div>
      <div class="welcome-card">
        <p class="welcome-tagline">Start your child's journey at <strong><%= orgDetails.organization_name %></strong>. The application process is quick, secure, and fully online.</p>

        <div class="welcome-steps">
          <div class="welcome-step">
            <div class="step-num">1</div>
            <div class="step-info">
              <strong>Complete the form</strong>
              <span>Student &amp; guardian details</span>
            </div>
          </div>
          <div class="welcome-step">
            <div class="step-num">2</div>
            <div class="step-info">
              <strong>Pay the application fee</strong>
              <span>Secure online payment</span>
            </div>
          </div>
          <div class="welcome-step">
            <div class="step-num">3</div>
            <div class="step-info">
              <strong>Confirmation</strong>
              <span>We&rsquo;ll be in touch shortly</span>
            </div>
          </div>
        </div>

        <div class="fee-line">
          Application fee:
          <span class="fee-badge"><%= orgDetails.public_registration_currency %> <%= orgDetails.public_registration_price %></span>
          <span class="fee-note">non-refundable</span>
        </div>

        <div class="welcome-checklist">
          <span>&#128248; Recent photo of the student</span>
          <span>&#128222; Guardian phone &amp; email</span>
          <span>&#127891; Intended class / grade</span>
        </div>
      </div>
      <div class="form-actions">
        <button onclick="startRegistration()">Start Application &rarr;</button>
      </div>
    </div>
  
    <!-- Registration Section -->
    <div id="registrationFormSection" style="display: none;">
      <div class="form-header"><h2>Student Registration</h2></div>
      
      <!-- Guardian Check Section -->
      <div id="guardianCheckSection" class="guardian-check-section">
        <h3>Guardian Information</h3>
        <p>Do you already have a child enrolled in this school?</p>
        <div class="guardian-check-buttons">
          <button class="btn-yes" onclick="guardianExists(true)">Yes</button>
          <button class="btn-no" onclick="guardianExists(false)">No</button>
        </div>
      </div>

      <!-- Guardian Search (shown if YES) -->
      <div id="guardianSearchSection" style="display: none;">
        <div class="guardian-search-container">
          <h4 style="margin-bottom: 6px; color: #10b981; font-size:.82rem;">&#128269; Find Your Profile</h4>
          <p style="color: #64748b; margin-bottom: 8px; font-size:.78rem;">Search by name, phone, or email to link your existing guardian profile.</p>
          <div class="search-wrapper">
            <input 
              type="text" 
              id="guardianSearchInput" 
              class="guardian-search-input" 
              placeholder="Search by name, phone, or email..."
              autocomplete="off"
            />
            <div id="guardianSuggestions" class="guardian-suggestions"></div>
          </div>
          
          <div id="selectedGuardianDisplay" class="selected-guardian-display">
            <img id="selectedGuardianImg" src="/images/profilePlaceholder.png" alt="Guardian">
            <div class="sg-info">
              <div class="sg-name" id="selectedGuardianName"></div>
              <div class="sg-details" id="selectedGuardianDetails"></div>
            </div>
            <button type="button" class="btn-change-guardian" onclick="clearGuardianSelection()" title="Change guardian">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/>
                <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/>
              </svg>
            </button>
          </div>
        </div>
      </div>

      <form id="registrationForm" enctype="multipart/form-data">
        <input type="hidden" name="organizationId" value="<%= organizationId %>" />

        <div class="form-section-card">
          <h4>🎓 Student Information</h4>
          <div class="form-grid">
            <div class="form-group">
              <label>First Name</label>
              <input type="text" name="firstName" required />
            </div>
            <div class="form-group">
              <label>Last Name</label>
              <input type="text" name="lastName" required />
            </div>
            <div class="form-group">
              <label>Date of Birth</label>
              <input type="date" name="dateOfBirth" required />
            </div>
            <div class="form-group">
              <label>Gender</label>
              <select name="gender" required>
                <option value="">Select Gender</option>
                <option value="Male">Male</option>
                <option value="Female">Female</option>
              </select>
            </div>
            <div class="form-group">
              <label>Hometown</label>
              <input type="text" name="hometown" />
            </div>
            <div class="form-group">
              <label>Class</label>
              <select name="classId" id="classId" required>
                <option value="">Select Class</option>
                <% classes.forEach(cls => { %>
                  <option value="<%= cls.class_id %>"><%= cls.class_name %></option>
                <% }) %>
              </select>
            </div>
            <div class="form-group full-width">
              <label>Student Photo</label>
              <input type="file" name="studentImage" accept="image/*" required />
            </div>
          </div>
        </div>
  
        <div id="guardiansContainer" style="display: none;">
          <div class="form-section-card guardian-entry">
            <h4>👤 Guardian Details</h4>
            <input type="hidden" id="existingGuardianId" name="existingGuardianId" value="" />
            <div class="form-grid">
              <div class="form-group">
                <label>Guardian First Name</label>
                <input type="text" id="guardianFirstName0" name="guardianFirstName0" />
              </div>
              <div class="form-group">
                <label>Guardian Last Name</label>
                <input type="text" id="guardianLastName0" name="guardianLastName0" />
              </div>
              <div class="form-group">
                <label>Guardian Phone</label>
                <input type="text" id="guardianPhone0" name="guardianPhone0" />
              </div>
              <div class="form-group">
                <label>Guardian Email</label>
                <input type="email" id="guardianEmail0" name="guardianEmail0" />
              </div>
              <div class="form-group full-width">
                <label>Guardian Hometown</label>
                <input type="text" id="guardianHometown0" name="guardianHometown0" />
              </div>
              <div class="form-group full-width">
                <label>Guardian Photo <span style="color:#888;font-weight:400;">(Optional)</span></label>
                <input type="file" id="guardianImage0" name="guardianImage0" accept="image/*" onchange="previewGuardianImage(this)" />
                <img id="guardianImagePreview" class="image-preview" style="display: none;" />
              </div>
            </div>
          </div>
        </div>
  
        <div style="margin-top: 10px; display: none;" id="addGuardianBtn">
          <button type="button" onclick="addGuardian()">+ Add Another Guardian</button>
        </div>
  
        <div class="form-actions">
          <button type="button" onclick="continueToPayment()">Continue to Payment</button>
        </div>
      </form>
    </div>
  
 <!-- Payment Section -->
 <div id="paymentFormContainer" style="display: none;">
  <button class="back-button" onclick="backToRegistration()">← Back</button>
  <div class="form-header"><h2>Complete Your Payment</h2></div>

  <div class="payment-card">
    <div class="payment-fee-row">
      <span>Registration fee</span>
      <strong><%= orgDetails.public_registration_currency %> <%= orgDetails.public_registration_price %></strong>
    </div>

    <div id="stripeLoadingMsg" style="text-align:center;padding:24px;color:#666;">
      <div class="loader-circle" style="margin:0 auto 10px;"></div>
      <p>Preparing secure payment form…</p>
    </div>

    <div id="stripeElementsWrapper" style="display:none;">
      <!-- Apple Pay / Google Pay -->
      <div id="express-checkout-element" style="margin-bottom:12px;"></div>
      <div id="express-checkout-divider" style="display:none;text-align:center;margin:8px 0;color:#999;font-size:.85rem;">─── or pay with card ───</div>
      <!-- Card form -->
      <div id="payment-element" style="margin-bottom:16px;"></div>
      <div id="stripeError" style="color:#dc2626;font-size:.9rem;margin-bottom:10px;display:none;"></div>
      <div class="form-actions" style="margin-top:0;">
        <button type="button" id="payNowBtn" onclick="payNow()">
          Pay <%= orgDetails.public_registration_currency %> <%= orgDetails.public_registration_price %>
        </button>
      </div>
    </div>

    <div id="stripeInitError" style="display:none;color:#dc2626;padding:16px;border:1px solid #fca5a5;border-radius:8px;background:#fff1f2;"></div>
  </div>

  <!-- Loader -->
  <div id="loader" class="loader-container">
    <div class="loader-circle"></div>
    <div class="loader-text" id="loaderText">Processing…</div>
  </div>
</div>


</div>

<script src="https://js.stripe.com/v3/"></script>
  <script>
    const STRIPE_PUBLISHABLE_KEY = '<%= stripePublishableKey || "" %>';
    const ORG_ID                 = '<%= organizationId %>';
    const REGISTRATION_AMOUNT    = '<%= orgDetails.public_registration_price %>';
    const REGISTRATION_CURRENCY  = '<%= orgDetails.public_registration_currency %>';
    const HAS_PAYOUT_ACCOUNT     = <%= hasPayoutAccount ? 'true' : 'false' %>;

    let guardianCount         = 1;
    let stripeInstance        = null;
    let stripeElements        = null;
    let paymentElementMounted = false;

    // ─── Navigation ──────────────────────────────────────────────────────────

    function startRegistration() {
      document.getElementById('welcomeSection').style.display = 'none';
      document.getElementById('registrationFormSection').style.display = 'block';
    }

    function backToRegistration() {
      document.getElementById('paymentFormContainer').style.display = 'none';
      document.getElementById('registrationFormSection').style.display = 'block';
    }

    // ─── Step 1: Submit registration, then open payment ──────────────────────

    async function continueToPayment() {
      const form = document.getElementById('registrationForm');
      if (!form.checkValidity()) { form.reportValidity(); return; }

      showLoader('Saving registration…');

      let registrationData;
      try {
        const res = await fetch('/common/publicRegister?organizationId=' + ORG_ID, {
          method: 'POST',
          body: new FormData(form),
        });
        registrationData = await res.json();
      } catch (err) {
        hideLoader();
        alert('Network error. Please check your connection and try again.');
        return;
      }

      if (!registrationData.success) {
        hideLoader();
        const msgs = registrationData.errors
          ? registrationData.errors.map(e => e.msg).join('\n')
          : (registrationData.error || 'Registration failed. Please try again.');
        alert(msgs);
        return;
      }

      hideLoader();
      document.getElementById('registrationFormSection').style.display = 'none';
      document.getElementById('paymentFormContainer').style.display = 'block';

      // Block if school hasn't set up their Stripe payout account
      if (!HAS_PAYOUT_ACCOUNT) {
        document.getElementById('stripeLoadingMsg').style.display = 'none';
        const initErr = document.getElementById('stripeInitError');
        initErr.innerHTML = '<strong>Online payment is not available yet.</strong><br>This school has not set up their payout account. Please contact the school directly to arrange payment.';
        initErr.style.display = 'block';
        return;
      }

      await initStripePaymentElement(registrationData.amount);
    }

    // ─── Step 2: Init Stripe Payment Element ─────────────────────────────────

    async function initStripePaymentElement(amount) {
      const loadingMsg = document.getElementById('stripeLoadingMsg');
      const wrapper    = document.getElementById('stripeElementsWrapper');
      const initError  = document.getElementById('stripeInitError');

      if (!STRIPE_PUBLISHABLE_KEY) {
        loadingMsg.style.display = 'none';
        initError.textContent    = 'Online payment is not configured. Please contact the school.';
        initError.style.display  = 'block';
        return;
      }

      try {
        const res = await fetch('/common/createPaymentIntent', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ amount: amount || REGISTRATION_AMOUNT, organizationId: ORG_ID }),
        });
        const data = await res.json();

        if (!data.success || !data.clientSecret) {
          throw new Error(data.error || 'Could not create payment session.');
        }

        if (data.platformFeePercent > 0) {
          console.info(`[Payment] Platform fee: ${data.platformFeePercent}% | School receives: ${REGISTRATION_CURRENCY} ${data.schoolReceives}`);
        }

        stripeInstance = Stripe(data.publishableKey || STRIPE_PUBLISHABLE_KEY);

        stripeElements = stripeInstance.elements({
          clientSecret: data.clientSecret,
          appearance: { theme: 'stripe', variables: { colorPrimary: '#2563eb', borderRadius: '8px' } },
        });

        const returnUrl = window.location.origin + '/common/paymentCallback?organizationId=' + ORG_ID;

        // Apple Pay / Google Pay
        const expressEl = stripeElements.create('expressCheckout');
        expressEl.mount('#express-checkout-element');
        expressEl.on('ready', ({ availablePaymentMethods }) => {
          if (availablePaymentMethods && Object.keys(availablePaymentMethods).length) {
            document.getElementById('express-checkout-divider').style.display = 'block';
          }
        });
        expressEl.on('confirm', () => handleStripeConfirm(returnUrl));

        // Card form
        const paymentEl = stripeElements.create('payment');
        paymentEl.mount('#payment-element');

        loadingMsg.style.display = 'none';
        wrapper.style.display    = 'block';
        paymentElementMounted    = true;

      } catch (err) {
        loadingMsg.style.display = 'none';
        initError.textContent    = err.message || 'Failed to load payment form. Please try again.';
        initError.style.display  = 'block';
      }
    }

    // ─── Step 3: Confirm payment ──────────────────────────────────────────────

    async function handleStripeConfirm(returnUrl) {
      if (!stripeInstance || !stripeElements) return;
      const errDiv = document.getElementById('stripeError');
      const payBtn = document.getElementById('payNowBtn');
      errDiv.style.display = 'none';
      if (payBtn) payBtn.disabled = true;
      showLoader('Processing payment…');

      const { error } = await stripeInstance.confirmPayment({
        elements: stripeElements,
        confirmParams: { return_url: returnUrl },
      });

      hideLoader();
      if (payBtn) payBtn.disabled = false;
      if (error) {
        errDiv.textContent   = error.message || 'Payment failed. Please try again.';
        errDiv.style.display = 'block';
      }
      // On success Stripe redirects automatically
    }

    function payNow() {
      if (!paymentElementMounted) { alert('Payment form is not ready. Please wait a moment.'); return; }
      const returnUrl = window.location.origin + '/common/paymentCallback?organizationId=' + ORG_ID;
      handleStripeConfirm(returnUrl);
    }

    // ─── Loader helpers ───────────────────────────────────────────────────────

    function showLoader(msg) {
      const t = document.getElementById('loaderText');
      if (t) t.textContent = msg || 'Processing…';
      document.getElementById('loader').style.display = 'flex';
    }
    function hideLoader() { document.getElementById('loader').style.display = 'none'; }

    // ─── Guardian check ───────────────────────────────────────────────────────

    let hasExistingGuardian = false;
    let searchTimeout = null;

    function guardianExists(exists) {
      hasExistingGuardian = exists;
      document.getElementById('guardianCheckSection').style.display = 'none';
      if (exists) {
        document.getElementById('guardianSearchSection').style.display = 'block';
        document.getElementById('guardiansContainer').style.display   = 'none';
      } else {
        document.getElementById('guardianSearchSection').style.display = 'none';
        document.getElementById('guardiansContainer').style.display   = 'block';
        document.getElementById('addGuardianBtn').style.display       = 'block';
      }
    }

    function previewGuardianImage(input) {
      const preview = document.getElementById('guardianImagePreview');
      if (input.files && input.files[0]) {
        const reader = new FileReader();
        reader.onload = (e) => { preview.src = e.target.result; preview.style.display = 'block'; };
        reader.readAsDataURL(input.files[0]);
      }
    }

    // ─── Guardian search ──────────────────────────────────────────────────────

    document.addEventListener('DOMContentLoaded', () => {
      const input = document.getElementById('guardianSearchInput');
      if (!input) return;
      input.addEventListener('input', function () {
        clearTimeout(searchTimeout);
        const q = this.value.trim();
        if (q.length < 2) { document.getElementById('guardianSuggestions').classList.remove('show'); return; }
        searchTimeout = setTimeout(() => searchGuardians(q), 300);
      });
    });

    async function searchGuardians(query) {
      const suggestionsDiv = document.getElementById('guardianSuggestions');
      try {
        const res  = await fetch(`/common/searchGuardiansPublic?q=${encodeURIComponent(query)}&organizationId=${ORG_ID}`);
        const data = await res.json();
        suggestionsDiv.innerHTML = '';
        if (data.guardians && data.guardians.length) {
          data.guardians.forEach(g => {
            const item = document.createElement('div');
            item.className = 'guardian-suggestion-item';
            const imgUrl = g.image_url && g.image_url !== 'profilePlaceholder.png'
              ? escapeHtml(g.image_url) : '/images/profilePlaceholder.png';
            item.innerHTML = `
              <img src="${imgUrl}" alt="Guardian" onerror="this.src='/images/profilePlaceholder.png'">
              <div class="guardian-suggestion-info">
                <div class="guardian-suggestion-name">${escapeHtml(g.first_name||'')} ${escapeHtml(g.last_name||'')}</div>
                <div class="guardian-suggestion-details">${escapeHtml(g.phone||'')}${g.phone&&g.email?' • ':''}${escapeHtml(g.email||'')}</div>
              </div>`;
            item.onclick = (e) => { e.stopPropagation(); selectGuardian(g); };
            suggestionsDiv.appendChild(item);
          });
        } else {
          suggestionsDiv.innerHTML = '<div style="padding:12px;text-align:center;color:#666;">No guardians found</div>';
        }
        suggestionsDiv.classList.add('show');
      } catch (_) {
        suggestionsDiv.innerHTML = '<div style="padding:12px;text-align:center;color:#ef4444;">Search error. Try again.</div>';
        suggestionsDiv.classList.add('show');
      }
    }

    function selectGuardian(guardian) {
      document.getElementById('guardianSuggestions').classList.remove('show');
      document.getElementById('guardianSearchInput').value = '';
      const img = document.getElementById('selectedGuardianImg');
      img.src = (guardian.image_url && guardian.image_url !== 'profilePlaceholder.png')
        ? guardian.image_url : '/images/profilePlaceholder.png';
      img.onerror = () => { img.src = '/images/profilePlaceholder.png'; };
      document.getElementById('selectedGuardianName').textContent    = `${guardian.first_name||''} ${guardian.last_name||''}`.trim();
      document.getElementById('selectedGuardianDetails').textContent = `${guardian.phone||''}${guardian.phone&&guardian.email?' • ':''}${guardian.email||''}`;
      document.getElementById('selectedGuardianDisplay').classList.add('show');
      document.getElementById('existingGuardianId').value = guardian.guardian_id;
    }

    function clearGuardianSelection() {
      document.getElementById('selectedGuardianDisplay').classList.remove('show');
      document.getElementById('existingGuardianId').value = '';
      document.getElementById('guardianSearchInput').value = '';
      document.getElementById('guardianSearchInput').focus();
    }

    document.addEventListener('click', (e) => {
      const section = document.getElementById('guardianSearchSection');
      if (section && !section.contains(e.target))
        document.getElementById('guardianSuggestions').classList.remove('show');
    });

    function escapeHtml(str) {
      const d = document.createElement('div');
      d.textContent = str;
      return d.innerHTML;
    }
  </script>
    
