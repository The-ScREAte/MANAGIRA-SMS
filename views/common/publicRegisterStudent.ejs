<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>Public Student Registration</title>
<style>
  :root {
    --font-family: "<%= (session && session.fontStyle ? String(session.fontStyle).trim() : 'Inter') %>", sans-serif;
    --pr-blue: #2563eb;
    --pr-blue-dark: #1d4ed8;
    --pr-green: #10b981;
    --pr-green-dark: #059669;
    --pr-radius: 12px;
  }

  * { box-sizing: border-box; }
  body { margin: 0; background: #f1f5f9; font-family: var(--font-family); }

  /* ── Outer wrapper ───────────────────────────────────────────── */
  .registration-container {
    width: min(100%, 960px);
    max-width: 960px;
    margin: 32px auto;
    padding: 0 16px;
    font-family: var(--font-family);
  }

  /* ── Main white card ─────────────────────────────────────────── */
  .reg-card {
    background: #fff;
    border-radius: var(--pr-radius);
    box-shadow: 0 2px 8px rgba(0,0,0,.08);
    border: 1px solid #e2e8f0;
    padding: clamp(20px, 3vw, 32px);
    margin-bottom: 0;
  }
  .form-header {
    text-align: center;
    margin-bottom: 24px;
    padding-bottom: 18px;
    border-bottom: 2px solid #e2e8f0;
  }
  .form-header h1, .form-header h2 {
    font-size: clamp(1.2rem, 4vw, 1.6rem);
    font-weight: 700;
    color: #1e293b;
    margin: 0 0 4px;
  }
  .form-header p { margin: 0; color: #64748b; font-size: .88rem; }
  .form-group { margin-bottom: 18px; }
  .form-group label {
    display: block;
    font-weight: 600;
    color: #475569;
    margin-bottom: 7px;
    font-size: 14px;
  }
  .form-group input,
  .form-group select {
    width: 100%;
    padding: 11px 14px;
    border-radius: 8px;
    border: 2px solid #e2e8f0;
    font-size: 16px;
    font-family: var(--font-family);
    background: #fff;
    transition: border-color .2s, box-shadow .2s;
  }
  .form-group input:focus,
  .form-group select:focus {
    outline: none;
    border-color: var(--pr-blue);
    box-shadow: 0 0 0 3px rgba(37,99,235,.1);
  }
  .form-group input[type="file"] {
    padding: 9px 14px;
    border-style: dashed;
    background: #f8fafc;
    cursor: pointer;
  }
  .btn-primary {
    display: inline-flex; align-items: center; justify-content: center; gap: 8px;
    background: var(--pr-blue); color: #fff;
    padding: 13px 28px; border: none; border-radius: 8px;
    cursor: pointer; font-size: .95rem; font-weight: 600;
    font-family: var(--font-family);
    transition: background .2s, transform .1s, box-shadow .2s;
    box-shadow: 0 2px 8px rgba(37,99,235,.2);
  }
  .btn-primary:hover { background: var(--pr-blue-dark); box-shadow: 0 4px 14px rgba(37,99,235,.3); }
  .btn-primary:active { transform: scale(.98); }
  .btn-secondary {
    display: inline-flex; align-items: center; justify-content: center; gap: 6px;
    background: #fff; color: #475569;
    padding: 13px 24px; border: 2px solid #e2e8f0; border-radius: 8px;
    cursor: pointer; font-size: .9rem; font-weight: 600;
    font-family: var(--font-family);
    transition: background .15s, border-color .15s;
    text-decoration: none;
  }
  .btn-secondary:hover { background: #f8fafc; border-color: #cbd5e1; }
  .form-actions {
    display: flex; gap: 12px;
    margin-top: 24px; padding-top: 20px;
    border-top: 2px solid #e2e8f0;
    justify-content: flex-end;
  }
  .form-actions.centered { justify-content: center; }
  #registrationFormSection { display: none; }
  #paymentFormContainer    { display: none; }
  .back-button {
    display: inline-flex; align-items: center; gap: 6px;
    margin-bottom: 18px; background: #f1f5f9; color: #374151;
    padding: 9px 18px; border: 1px solid #e2e8f0; border-radius: 8px;
    cursor: pointer; font-size: .9rem; font-weight: 500;
    font-family: var(--font-family); transition: background .2s;
  }
  .back-button:hover { background: #e2e8f0; }
  .remove-guardian {
    background: #fef2f2; color: #ef4444;
    border: 1.5px solid #fca5a5; border-radius: 6px;
    padding: 6px 14px; font-size: .82rem; font-weight: 600;
    cursor: pointer; margin-top: 8px; transition: background .15s;
    font-family: var(--font-family);
  }
  .remove-guardian:hover { background: #fee2e2; }

  .loader-container {
    display: none; /* Start hidden */
    position: fixed;
    top: 0; left: 0;
    width: 100vw; height: 100vh;
    background: rgba(255, 255, 255, 0.9);
    z-index: 10000;
    flex-direction: column;
    justify-content: center;
    align-items: center;
  }
  
  .loader-circle {
    border: 6px solid #f3f3f3;
    border-top: 6px solid #2563eb;
    border-radius: 50%;
    width: 50px; height: 50px;
    animation: spin 0.8s linear infinite;
  }
  .loader-text {
    margin-top: 15px;
    font-size: 1.1rem;
    color: #2563eb;
    font-weight: bold;
  }
  @keyframes spin { 
    0% { transform: rotate(0deg); }
    100% { transform: rotate(360deg); }
  }

  /* Guardian Check Section */
  .guardian-check-section {
    text-align: center;
    padding: 24px 20px;
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: 12px;
    margin-bottom: 18px;
  }
  .guardian-check-section h3 {
    font-size: 1.05rem; font-weight: 700; color: #1e293b; margin: 0 0 6px;
  }
  .guardian-check-section p { color: #64748b; margin: 0 0 18px; font-size: .9rem; }
  .guardian-check-buttons { display: flex; gap: 12px; justify-content: center; }
  .guardian-check-buttons button {
    flex: 0 0 auto; width: 130px; padding: 11px 0;
    font-size: .95rem; font-weight: 600;
    font-family: var(--font-family);
    border: 2px solid transparent; border-radius: 8px;
    cursor: pointer; transition: background .2s, transform .1s, box-shadow .2s;
  }
  .guardian-check-buttons button:active { transform: scale(.97); }
  .btn-yes { background: var(--pr-green); color: #fff; box-shadow: 0 2px 8px rgba(16,185,129,.2); }
  .btn-yes:hover { background: var(--pr-green-dark); }
  .btn-no  { background: var(--pr-blue);  color: #fff; box-shadow: 0 2px 8px rgba(37,99,235,.2); }
  .btn-no:hover  { background: var(--pr-blue-dark); }

  /* Guardian Search */
  .guardian-search-container {
    margin-bottom: 18px; padding: 18px 20px;
    background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 12px;
    position: relative;
  }
  .guardian-search-container h4 {
    margin: 0 0 4px; font-size: .88rem; font-weight: 700; color: var(--pr-green);
  }
  .guardian-search-container > p { margin: 0 0 12px; font-size: .8rem; color: #64748b; }
  .guardian-search-input {
    width: 100%; padding: 12px 14px; font-size: 16px;
    border: 2px solid #e2e8f0; border-radius: 8px;
    font-family: var(--font-family);
    transition: border-color .2s, box-shadow .2s;
  }
  .guardian-search-input:focus {
    border-color: var(--pr-green); outline: none;
    box-shadow: 0 0 0 3px rgba(16,185,129,.1);
  }
  .search-wrapper {
    position: relative;
  }
  .guardian-suggestions {
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    margin-top: 4px;
    background: #fff;
    border: 1px solid #e2e8f0;
    border-radius: 10px;
    box-shadow: 0 6px 18px rgba(0,0,0,.1);
    max-height: 240px;
    overflow-y: auto;
    display: none;
    z-index: 1000;
  }
  .guardian-suggestions.show { display: block; }
  .guardian-suggestion-item {
    padding: 11px 12px;
    border-bottom: 1px solid #f1f5f9;
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 10px;
    transition: background 0.15s;
  }
  .guardian-suggestion-item:last-child { border-bottom: none; }
  .guardian-suggestion-item:hover { background: #f0fdf4; }
  .guardian-suggestion-item img {
    width: 36px; height: 36px;
    border-radius: 50%; object-fit: cover;
    border: 1.5px solid #e5e7eb; flex-shrink: 0;
  }
  .guardian-suggestion-info { flex: 1; min-width: 0; }
  .guardian-suggestion-name {
    font-weight: 600; font-size: clamp(.92rem, 1.5vw, 1rem); color: #1e293b; margin-bottom: 1px;
    white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
  }
  .guardian-suggestion-details {
    font-size: .86rem; color: #64748b;
    white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
  }
  .selected-guardian-display {
    background: linear-gradient(135deg, #ecfdf5 0%, #d1fae5 100%);
    border: 2px solid #10b981; border-radius: 10px;
    padding: 12px 14px; margin: 12px 0 0;
    display: none; align-items: center; gap: 12px; flex-wrap: wrap;
  }
  .selected-guardian-display.show { display: flex; }
  .selected-guardian-display img {
    width: 46px; height: 46px; border-radius: 50%; object-fit: cover;
    border: 2px solid #10b981; flex-shrink: 0;
  }
  .selected-guardian-display .sg-info { flex: 1; min-width: 0; }
  .selected-guardian-display .sg-name {
    font-weight: 600; font-size: clamp(.95rem, 1.6vw, 1rem); color: #065f46;
    white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
  }
  .selected-guardian-display .sg-details {
    font-size: .88rem; color: #047857; margin-top: 2px;
    white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
  }
  .btn-change-guardian {
    background: none; border: 2px solid #10b981; color: #10b981;
    border-radius: 7px; width: 32px; height: 32px;
    display: flex; align-items: center; justify-content: center;
    cursor: pointer; flex-shrink: 0; transition: background .2s, color .2s;
  }
  .btn-change-guardian:hover { background: #10b981; color: #fff; }
  .btn-change-guardian svg { width: 14px; height: 14px; }
  .guardian-image-preview-wrap {
    display: flex; align-items: center; gap: 14px;
    margin-top: 10px; padding: 12px 16px;
    background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 10px;
  }
  .guardian-image-preview-wrap img {
    width: 64px; height: 64px; border-radius: 50%; object-fit: cover;
    border: 2px solid #e2e8f0;
  }

  /* ── Two-column field grid ───────────────────────────────────── */
  .form-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0 20px;
  }
  .form-grid .form-group.full-width { grid-column: 1 / -1; }

  /* ── Section card for grouped fields ────────────────────────── */
  /* ── Progress bar ────────────────────────────────────────────── */
  .progress-bar-wrap {
    display: flex; align-items: flex-start; margin-bottom: 24px;
  }
  .progress-step {
    flex: 1; display: flex; flex-direction: column; align-items: center; position: relative;
  }
  .progress-step:not(:last-child)::after {
    content: ''; position: absolute; top: 15px;
    left: calc(50% + 18px); right: calc(-50% + 18px);
    height: 2px; background: #e2e8f0; z-index: 0;
  }
  .progress-step.done:not(:last-child)::after { background: var(--pr-blue); }
  .ps-circle {
    width: 30px; height: 30px; border-radius: 50%;
    border: 2px solid #e2e8f0; background: #fff; color: #94a3b8;
    display: flex; align-items: center; justify-content: center;
    font-size: .72rem; font-weight: 700; position: relative; z-index: 1; transition: all .3s;
  }
  .progress-step.done .ps-circle { background: var(--pr-blue); border-color: var(--pr-blue); color: #fff; }
  .progress-step.active .ps-circle { background: #fff; border-color: var(--pr-blue); color: var(--pr-blue); box-shadow: 0 0 0 4px rgba(37,99,235,.12); }
  .ps-label { font-size: .68rem; color: #94a3b8; margin-top: 5px; font-weight: 500; text-align: center; }
  .progress-step.done .ps-label, .progress-step.active .ps-label { color: var(--pr-blue); font-weight: 600; }

  /* ── Accordion cards ─────────────────────────────────────────── */
  .acc-card {
    background: #fff; border: 1px solid #e2e8f0; border-radius: 12px;
    overflow: hidden; margin-bottom: 14px; box-shadow: 0 1px 4px rgba(0,0,0,.05);
  }
  .acc-header {
    display: flex; align-items: center; justify-content: space-between;
    padding: 14px 18px; cursor: pointer; user-select: none;
    background: #f8fafc; transition: background .15s; border-bottom: 1px solid transparent;
  }
  .acc-header:hover { background: #f1f5f9; }
  .acc-header.open { background: #fff; border-bottom-color: #e2e8f0; }
  .acc-header-left { display: flex; align-items: center; gap: 12px; }
  .acc-icon-wrap {
    width: 34px; height: 34px; background: var(--pr-blue); border-radius: 8px;
    display: flex; align-items: center; justify-content: center; font-size: 1rem; flex-shrink: 0;
  }
  .acc-icon-wrap.green { background: var(--pr-green); }
  .acc-title { font-size: .9rem; font-weight: 700; color: #1e293b; }
  .acc-subtitle { font-size: .74rem; color: #64748b; margin-top: 2px; }
  .acc-chevron {
    width: 18px; height: 18px; color: #94a3b8; flex-shrink: 0; transition: transform .25s ease;
  }
  .acc-header.open .acc-chevron { transform: rotate(180deg); }
  .acc-body { display: none; padding: 20px 20px 8px; }
  .acc-body.open { display: block; }

  /* ── Welcome card ────────────────────────────────────────────── */
  .welcome-card {
    background: #f8fafc; border: 1px solid #e2e8f0;
    border-radius: 10px; padding: 20px; margin-bottom: 20px;
  }
  .welcome-tagline { font-size: .93rem; color: #374151; line-height: 1.6; margin: 0 0 14px; }
  .welcome-steps {
    display: flex;
    gap: 8px;
    background: #fff;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    padding: 12px;
    margin-bottom: 14px;
  }
  .welcome-step {
    flex: 1;
    display: flex;
    align-items: flex-start;
    gap: 8px;
  }
  .step-num {
    min-width: 22px;
    height: 22px;
    background: var(--pr-blue);
    color: #fff;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    font-size: .75rem;
    flex-shrink: 0;
    margin-top: 1px;
  }
  .step-info { display: flex; flex-direction: column; gap: 2px; }
  .step-info strong { font-size: .82rem; color: #1e293b; }
  .step-info span { color: #64748b; font-size: .76rem; }
  .fee-line {
    display: flex;
    align-items: center;
    gap: 8px;
    margin: 0 0 10px;
    font-size: .9rem;
    color: #374151;
    flex-wrap: wrap;
  }
  .fee-note { color: #6b7280; font-size: .8rem; }
  .fee-badge {
    display: inline-block;
    background: var(--pr-blue);
    color: #fff;
    padding: 3px 12px;
    border-radius: 20px;
    font-weight: 700;
    font-size: .9rem;
  }
  .welcome-checklist {
    display: flex;
    gap: 16px;
    font-size: .8rem;
    color: #64748b;
    background: #f1f5f9;
    border-radius: 6px;
    padding: 8px 12px;
    flex-wrap: wrap;
  }

  @media (max-width: 820px) {
    .registration-container { margin: 20px auto; }
    .form-grid { grid-template-columns: 1fr; gap: 0; }
    .form-header h1, .form-header h2 { font-size: clamp(1.2rem, 5vw, 1.5rem); }
    .welcome-tagline,
    .fee-line,
    .selected-guardian-display .sg-details,
    .guardian-suggestion-details { font-size: .92rem; }
    .selected-guardian-display { align-items: flex-start; }
    .btn-change-guardian { margin-left: auto; }
  }

  /* ── Payment section (guardian-settings style) ────────────────────────── */
  .payment-outer {
    background: #fff; border: 1px solid #e2e8f0; border-radius: 12px;
    padding: 28px 32px; box-shadow: 0 2px 8px rgba(0,0,0,.06);
    max-width: 580px; margin: 0 auto;
  }
  .payment-section-title {
    font-size: 18px; font-weight: 700; color: #1e293b;
    margin: 0 0 16px; padding-bottom: 12px; border-bottom: 2px solid #e2e8f0;
  }
  .payment-summary-row {
    display: flex; justify-content: space-between; align-items: center;
    background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 8px;
    padding: 14px 18px; margin-bottom: 22px;
  }
  .payment-summary-row span   { font-size: .95rem; color: #475569; }
  .payment-summary-row strong { font-size: 1.15rem; font-weight: 700; color: var(--pr-blue); }
  #payNowBtn {
    width: 100%; padding: 14px;
    font-size: 1rem; font-weight: 600; font-family: var(--font-family);
    background: var(--pr-blue); color: #fff;
    border: none; border-radius: 8px; cursor: pointer;
    transition: background .2s, transform .1s;
    box-shadow: 0 2px 8px rgba(37,99,235,.2);
  }
  #payNowBtn:hover   { background: var(--pr-blue-dark); }
  #payNowBtn:active  { transform: scale(.98); }
  #payNowBtn:disabled { opacity: .6; cursor: not-allowed; }

  /* ── Responsive ──────────────────────────────────────────────── */
  @media (max-width: 640px) {
    .registration-container { margin: 0; padding: 0; }
    .reg-card { border-radius: 0; box-shadow: none; padding: 18px 16px; }
    .form-grid { grid-template-columns: 1fr; gap: 0; }
    .welcome-card { padding: 16px; }
    .welcome-steps { flex-direction: column; gap: 8px; }
    .welcome-checklist { gap: 8px; }
    .guardian-check-buttons button { width: 120px; }
    .payment-outer { padding: 18px 16px; border-radius: 0; box-shadow: none; }
    .form-actions { flex-direction: column-reverse; }
    .form-actions .btn-primary, .form-actions .btn-secondary { width: 100%; justify-content: center; }
    .back-button { width: 100%; justify-content: center; }
    .ps-label { font-size: .6rem; }
    .acc-body { padding: 14px 14px 4px; }
    .selected-guardian-display {
      display: none;
      padding: 12px;
    }
    .selected-guardian-display.show {
      display: grid;
      grid-template-columns: 46px minmax(0, 1fr) auto;
      gap: 10px;
      align-items: center;
    }
    .selected-guardian-display .sg-name,
    .selected-guardian-display .sg-details,
    .guardian-suggestion-name,
    .guardian-suggestion-details {
      white-space: normal;
      overflow: visible;
      text-overflow: clip;
      word-break: break-word;
    }
  }
  @media (min-width: 641px) and (max-width: 900px) {
    .registration-container { margin: 16px; }
  }
</style>
</head>
<body>
  <%- include('../partials/flash') %>
  
  <div class="registration-container">
    <!-- Welcome Section -->
    <div id="welcomeSection">
      <div class="reg-card">
        <div class="form-header">
          <h1>Welcome to <%= orgDetails.organization_name %></h1>
          <p>Complete your child's enrollment online &mdash; fast, secure &amp; simple.</p>
        </div>
      <div class="welcome-card">
        <p class="welcome-tagline">Start your child's journey at <strong><%= orgDetails.organization_name %></strong>. The application process is quick, secure, and fully online.</p>

        <div class="welcome-steps">
          <div class="welcome-step">
            <div class="step-num">1</div>
            <div class="step-info">
              <strong>Complete the form</strong>
              <span>Student &amp; guardian details</span>
            </div>
          </div>
          <div class="welcome-step">
            <div class="step-num">2</div>
            <div class="step-info">
              <strong>Pay the application fee</strong>
              <span>Secure online payment</span>
            </div>
          </div>
          <div class="welcome-step">
            <div class="step-num">3</div>
            <div class="step-info">
              <strong>Confirmation</strong>
              <span>We&rsquo;ll be in touch shortly</span>
            </div>
          </div>
        </div>

        <div class="fee-line">
          Application fee:
          <span class="fee-badge"><%= orgDetails.public_registration_currency %> <%= orgDetails.public_registration_price %></span>
          <span class="fee-note">non-refundable</span>
        </div>

        <div class="welcome-checklist">
          <span>&#128248; Recent photo of the student</span>
          <span>&#128222; Guardian phone &amp; email</span>
          <span>&#127891; Intended class / grade</span>
        </div>
      </div>
      <div class="form-actions centered">
          <button class="btn-primary" style="max-width:300px;width:100%;" onclick="startRegistration()">Start Application &rarr;</button>
        </div>
      </div>
    </div>
  
    <!-- Registration Section -->
    <div id="registrationFormSection" style="display: none;">
      <div class="reg-card">
        <!-- Progress bar -->
        <div class="progress-bar-wrap">
          <div class="progress-step active" id="ps1">
            <div class="ps-circle">1</div>
            <div class="ps-label">Guardian</div>
          </div>
          <div class="progress-step" id="ps2">
            <div class="ps-circle">2</div>
            <div class="ps-label">Student Info</div>
          </div>
          <div class="progress-step" id="ps3">
            <div class="ps-circle">3</div>
            <div class="ps-label">Payment</div>
          </div>
        </div>
        <div class="form-header"><h2>Student Registration</h2></div>
      
      <!-- Guardian Check Section -->
      <div id="guardianCheckSection" class="guardian-check-section">
        <h3>Guardian Information</h3>
        <p>Do you already have a child enrolled in this school?</p>
        <div class="guardian-check-buttons">
          <button class="btn-yes" onclick="guardianExists(true)">Yes</button>
          <button class="btn-no" onclick="guardianExists(false)">No</button>
        </div>
      </div>

      <!-- Guardian Search (shown if YES) -->
      <div id="guardianSearchSection" style="display: none;">
        <div class="guardian-search-container">
          <h4 style="margin-bottom: 6px; color: #10b981; font-size:.82rem;">&#128269; Find Your Profile</h4>
          <p style="color: #64748b; margin-bottom: 8px; font-size:.78rem;">Search by name, phone, or email to link your existing guardian profile.</p>
          <div class="search-wrapper">
            <input 
              type="text" 
              id="guardianSearchInput" 
              class="guardian-search-input" 
              placeholder="Search by name, phone, or email..."
              autocomplete="off"
            />
            <div id="guardianSuggestions" class="guardian-suggestions"></div>
          </div>
          
          <div id="selectedGuardianDisplay" class="selected-guardian-display">
            <img id="selectedGuardianImg" src="/images/profilePlaceholder.png" alt="Guardian">
            <div class="sg-info">
              <div class="sg-name" id="selectedGuardianName"></div>
              <div class="sg-details" id="selectedGuardianDetails"></div>
            </div>
            <button type="button" class="btn-change-guardian" onclick="clearGuardianSelection()" title="Change guardian">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/>
                <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/>
              </svg>
            </button>
          </div>
        </div>
      </div>

      <form id="registrationForm" enctype="multipart/form-data">
        <input type="hidden" name="organizationId" value="<%= organizationId %>" />

          <!-- Student Information accordion card -->
          <div class="acc-card" id="accStudent">
            <div class="acc-header" id="accStudentHeader" onclick="toggleAcc('accStudent')">
              <div class="acc-header-left">
                <div class="acc-icon-wrap">&#127891;</div>
                <div>
                  <div class="acc-title">Student Information</div>
                  <div class="acc-subtitle">Personal details &amp; photo</div>
                </div>
              </div>
              <svg class="acc-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="6 9 12 15 18 9"/>
              </svg>
            </div>
            <div class="acc-body" id="accStudentBody">
              <div class="form-grid">
            <div class="form-group">
              <label>First Name</label>
              <input type="text" name="firstName" required />
            </div>
            <div class="form-group">
              <label>Last Name</label>
              <input type="text" name="lastName" required />
            </div>
            <div class="form-group">
              <label>Date of Birth</label>
              <input type="date" name="dateOfBirth" required />
            </div>
            <div class="form-group">
              <label>Gender</label>
              <select name="gender" required>
                <option value="">Select Gender</option>
                <option value="Male">Male</option>
                <option value="Female">Female</option>
              </select>
            </div>
            <div class="form-group">
              <label>Hometown</label>
              <input type="text" name="hometown" />
            </div>
            <div class="form-group">
              <label>Class</label>
              <select name="classId" id="classId" required>
                <option value="">Select Class</option>
                <% classes.forEach(cls => { %>
                  <option value="<%= cls.class_id %>"><%= cls.class_name %></option>
                <% }) %>
              </select>
            </div>
              <div class="form-group full-width">
                  <label>Student Photo *</label>
                  <input type="file" name="studentImage" accept="image/*" required />
                </div>
              </div>
            </div>
          </div>
  
          <!-- Guardian Details accordion card (new guardian only) -->
          <div id="guardiansContainer" style="display: none;">
            <div class="acc-card" id="accGuardian">
              <div class="acc-header" id="accGuardianHeader" onclick="toggleAcc('accGuardian')">
                <div class="acc-header-left">
                  <div class="acc-icon-wrap green">&#128100;</div>
                  <div>
                    <div class="acc-title">Guardian Details</div>
                    <div class="acc-subtitle">Contact &amp; profile info</div>
                  </div>
                </div>
                <svg class="acc-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="6 9 12 15 18 9"/>
                </svg>
              </div>
              <div class="acc-body" id="accGuardianBody">
                <input type="hidden" id="existingGuardianId" name="existingGuardianId" value="" />
            <div class="form-grid">
              <div class="form-group">
                <label>Guardian First Name</label>
                <input type="text" id="guardianFirstName0" name="guardianFirstName0" />
              </div>
              <div class="form-group">
                <label>Guardian Last Name</label>
                <input type="text" id="guardianLastName0" name="guardianLastName0" />
              </div>
              <div class="form-group">
                <label>Guardian Phone</label>
                <input type="text" id="guardianPhone0" name="guardianPhone0" />
              </div>
              <div class="form-group">
                <label>Guardian Email</label>
                <input type="email" id="guardianEmail0" name="guardianEmail0" />
              </div>
              <div class="form-group full-width">
                <label>Guardian Hometown</label>
                <input type="text" id="guardianHometown0" name="guardianHometown0" />
              </div>
                <div class="form-group full-width">
                    <label>Guardian Photo <span style="color:#94a3b8;font-weight:400;">(Optional)</span></label>
                    <input type="file" id="guardianImage0" name="guardianImage0" accept="image/*" onchange="previewGuardianImage(this, 0)" />
                    <div class="guardian-image-preview-wrap" id="guardianPreviewWrap0" style="display:none;">
                      <img id="guardianImagePreview0" src="" alt="Preview" />
                      <span style="font-size:.82rem;color:#64748b;">Preview</span>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
  
          <!-- Add another guardian -->
          <div id="addGuardianBtn" style="display:none; margin-top:4px;">
            <button type="button" class="btn-secondary" onclick="addGuardian()">+ Add Another Guardian</button>
          </div>

          <div class="form-actions">
            <button type="button" class="btn-secondary" onclick="backToWelcome()">&#8592; Back</button>
            <button type="button" class="btn-primary" onclick="continueToPayment()">Continue to Payment &#8594;</button>
          </div>
        </form>
      </div>
    </div>
  
 <!-- Payment Section -->
 <div id="paymentFormContainer" style="display: none;">
  <div class="reg-card">
    <!-- Progress bar (step 3 active) -->
    <div class="progress-bar-wrap">
      <div class="progress-step done">
        <div class="ps-circle">&#10003;</div>
        <div class="ps-label">Guardian</div>
      </div>
      <div class="progress-step done">
        <div class="ps-circle">&#10003;</div>
        <div class="ps-label">Student Info</div>
      </div>
      <div class="progress-step active">
        <div class="ps-circle">3</div>
        <div class="ps-label">Payment</div>
      </div>
    </div>
    <button class="back-button" onclick="backToRegistration()">&#8592; Back</button>

    <div class="payment-outer">
      <h2 class="payment-section-title">&#128179; Complete Your Payment</h2>
      <div class="payment-summary-row">
        <span>Application fee</span>
        <strong><%= orgDetails.public_registration_currency %> <%= orgDetails.public_registration_price %></strong>
      </div>

      <div id="stripeLoadingMsg" style="text-align:center;padding:28px;color:#666;">
        <div class="loader-circle" style="margin:0 auto 12px;"></div>
        <p style="margin:0;font-size:.9rem;">Preparing secure payment form&hellip;</p>
      </div>

      <div id="stripeElementsWrapper" style="display:none;">
        <div id="express-checkout-element" style="margin-bottom:12px;"></div>
        <div id="express-checkout-divider" style="display:none;text-align:center;margin:10px 0;color:#94a3b8;font-size:.82rem;">&mdash;&mdash; or pay with card &mdash;&mdash;</div>
        <div id="payment-element" style="margin-bottom:18px;"></div>
        <div id="stripeError" style="color:#dc2626;font-size:.88rem;margin-bottom:14px;display:none;padding:10px 14px;background:#fff1f2;border-radius:8px;border:1px solid #fca5a5;"></div>
        <button type="button" id="payNowBtn" onclick="payNow()">
          Pay <%= orgDetails.public_registration_currency %> <%= orgDetails.public_registration_price %>
        </button>
      </div>

      <div id="stripeInitError" style="display:none;color:#dc2626;padding:16px;border:1px solid #fca5a5;border-radius:8px;background:#fff1f2;font-size:.9rem;line-height:1.5;"></div>
    </div>
  </div>

  <!-- Loader -->
  <div id="loader" class="loader-container">
    <div class="loader-circle"></div>
    <div class="loader-text" id="loaderText">Processing&hellip;</div>
  </div>
</div>


</div>

<script src="https://js.stripe.com/v3/"></script>
  <script>
    const STRIPE_PUBLISHABLE_KEY = '<%= stripePublishableKey || "" %>';
    const ORG_ID                 = '<%= organizationId %>';
    const REGISTRATION_AMOUNT    = '<%= orgDetails.public_registration_price %>';
    const REGISTRATION_CURRENCY  = '<%= orgDetails.public_registration_currency %>';
    const HAS_PAYOUT_ACCOUNT     = <%= hasPayoutAccount ? 'true' : 'false' %>;

    let guardianCount         = 1;
    let stripeInstance        = null;
    let stripeElements        = null;
    let paymentElementMounted = false;

    // ─── Navigation ──────────────────────────────────────────────────────────

    function startRegistration() {
      document.getElementById('welcomeSection').style.display = 'none';
      document.getElementById('registrationFormSection').style.display = 'block';
    }

    function backToWelcome() {
      document.getElementById('registrationFormSection').style.display = 'none';
      document.getElementById('welcomeSection').style.display = 'block';
    }

    function backToRegistration() {
      document.getElementById('paymentFormContainer').style.display = 'none';
      document.getElementById('registrationFormSection').style.display = 'block';
    }

    // ─── Accordion helpers ────────────────────────────────────────────────────

    function toggleAcc(cardId) {
      const header = document.getElementById(cardId + 'Header');
      const body   = document.getElementById(cardId + 'Body');
      if (!header || !body) return;
      const isOpen = header.classList.contains('open');
      header.classList.toggle('open', !isOpen);
      body.classList.toggle('open',   !isOpen);
    }
    function openAcc(cardId) {
      const h = document.getElementById(cardId + 'Header');
      const b = document.getElementById(cardId + 'Body');
      if (h) h.classList.add('open');
      if (b) b.classList.add('open');
    }

    // ─── Progress helpers ─────────────────────────────────────────────────────

    function setProgressDone(stepId) {
      const el = document.getElementById(stepId);
      if (!el) return;
      el.classList.remove('active'); el.classList.add('done');
      el.querySelector('.ps-circle').innerHTML = '&#10003;';
    }
    function setProgressActive(stepId) {
      const el = document.getElementById(stepId);
      if (el) el.classList.add('active');
    }

    // ─── Step 1: Submit registration, then open payment ──────────────────────

    async function continueToPayment() {
      const form = document.getElementById('registrationForm');
      if (!form.checkValidity()) { form.reportValidity(); return; }

      showLoader('Saving registration…');

      let registrationData;
      try {
        const res = await fetch('/common/publicRegister?organizationId=' + ORG_ID, {
          method: 'POST',
          body: new FormData(form),
        });
        registrationData = await res.json();
      } catch (err) {
        hideLoader();
        alert('Network error. Please check your connection and try again.');
        return;
      }

      if (!registrationData.success) {
        hideLoader();
        const msgs = registrationData.errors
          ? registrationData.errors.map(e => e.msg).join('\n')
          : (registrationData.error || 'Registration failed. Please try again.');
        alert(msgs);
        return;
      }

      hideLoader();
      document.getElementById('registrationFormSection').style.display = 'none';
      document.getElementById('paymentFormContainer').style.display = 'block';

      // Block if school hasn't set up their Stripe payout account
      if (!HAS_PAYOUT_ACCOUNT) {
        document.getElementById('stripeLoadingMsg').style.display = 'none';
        const initErr = document.getElementById('stripeInitError');
        initErr.innerHTML = '<strong>Online payment is not available yet.</strong><br>This school has not set up their payout account. Please contact the school directly to arrange payment.';
        initErr.style.display = 'block';
        return;
      }

      await initStripePaymentElement(registrationData.amount);
    }

    // ─── Step 2: Init Stripe Payment Element ─────────────────────────────────

    async function initStripePaymentElement(amount) {
      const loadingMsg = document.getElementById('stripeLoadingMsg');
      const wrapper    = document.getElementById('stripeElementsWrapper');
      const initError  = document.getElementById('stripeInitError');

      if (!STRIPE_PUBLISHABLE_KEY) {
        loadingMsg.style.display = 'none';
        initError.textContent    = 'Online payment is not configured. Please contact the school.';
        initError.style.display  = 'block';
        return;
      }

      try {
        const res = await fetch('/common/createPaymentIntent', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ amount: amount || REGISTRATION_AMOUNT, organizationId: ORG_ID }),
        });
        const data = await res.json();

        if (!data.success || !data.clientSecret) {
          throw new Error(data.error || 'Could not create payment session.');
        }

        if (data.platformFeePercent > 0) {
          console.info(`[Payment] Platform fee: ${data.platformFeePercent}% | School receives: ${REGISTRATION_CURRENCY} ${data.schoolReceives}`);
        }

        stripeInstance = Stripe(data.publishableKey || STRIPE_PUBLISHABLE_KEY);

        stripeElements = stripeInstance.elements({
          clientSecret: data.clientSecret,
          appearance: { theme: 'stripe', variables: { colorPrimary: '#2563eb', borderRadius: '8px' } },
        });

        const returnUrl = window.location.origin + '/common/paymentCallback?organizationId=' + ORG_ID;

        // Apple Pay / Google Pay
        const expressEl = stripeElements.create('expressCheckout', {
          paymentMethods: {
            applePay: 'auto',
            googlePay: 'auto',
          },
          layout: { maxColumns: 2, maxRows: 2, overflowMenu: 'auto' },
          buttonHeight: 44,
        });
        expressEl.mount('#express-checkout-element');
        expressEl.on('ready', ({ availablePaymentMethods }) => {
          document.getElementById('express-checkout-divider').style.display =
            availablePaymentMethods && Object.keys(availablePaymentMethods).length ? 'block' : 'none';
        });
        expressEl.on('confirm', () => handleStripeConfirm(returnUrl));

        // Card form
        const paymentEl = stripeElements.create('payment');
        paymentEl.mount('#payment-element');

        loadingMsg.style.display = 'none';
        wrapper.style.display    = 'block';
        paymentElementMounted    = true;

      } catch (err) {
        loadingMsg.style.display = 'none';
        initError.textContent    = err.message || 'Failed to load payment form. Please try again.';
        initError.style.display  = 'block';
      }
    }

    // ─── Step 3: Confirm payment ──────────────────────────────────────────────

    async function handleStripeConfirm(returnUrl) {
      if (!stripeInstance || !stripeElements) return;
      const errDiv = document.getElementById('stripeError');
      const payBtn = document.getElementById('payNowBtn');
      errDiv.style.display = 'none';
      if (payBtn) payBtn.disabled = true;
      showLoader('Processing payment…');

      const { error } = await stripeInstance.confirmPayment({
        elements: stripeElements,
        confirmParams: { return_url: returnUrl },
      });

      hideLoader();
      if (payBtn) payBtn.disabled = false;
      if (error) {
        errDiv.textContent   = error.message || 'Payment failed. Please try again.';
        errDiv.style.display = 'block';
      }
      // On success Stripe redirects automatically
    }

    function payNow() {
      if (!paymentElementMounted) { alert('Payment form is not ready. Please wait a moment.'); return; }
      const returnUrl = window.location.origin + '/common/paymentCallback?organizationId=' + ORG_ID;
      handleStripeConfirm(returnUrl);
    }

    // ─── Loader helpers ───────────────────────────────────────────────────────

    function showLoader(msg) {
      const t = document.getElementById('loaderText');
      if (t) t.textContent = msg || 'Processing…';
      document.getElementById('loader').style.display = 'flex';
    }
    function hideLoader() { document.getElementById('loader').style.display = 'none'; }

    // ─── Guardian check ───────────────────────────────────────────────────────

    let hasExistingGuardian = false;
    let searchTimeout = null;

    function guardianExists(exists) {
      hasExistingGuardian = exists;
      document.getElementById('guardianCheckSection').style.display = 'none';
      setProgressDone('ps1'); setProgressActive('ps2');
      if (exists) {
        document.getElementById('guardianSearchSection').style.display = 'block';
        document.getElementById('guardiansContainer').style.display   = 'none';
      } else {
        document.getElementById('guardianSearchSection').style.display = 'none';
        document.getElementById('guardiansContainer').style.display   = 'block';
        document.getElementById('addGuardianBtn').style.display       = 'block';
        openAcc('accGuardian');
      }
      openAcc('accStudent');
    }

    // ─── Add another guardian ─────────────────────────────────────────────────

    function addGuardian() {
      const idx = guardianCount;
      const container = document.getElementById('guardiansContainer');
      const newCard = document.createElement('div');
      newCard.className = 'acc-card';
      newCard.id = 'accGuardian' + idx;
      newCard.innerHTML = `
        <div class="acc-header open" id="accGuardian${idx}Header" onclick="toggleAcc('accGuardian${idx}')">
          <div class="acc-header-left">
            <div class="acc-icon-wrap green">&#128100;</div>
            <div>
              <div class="acc-title">Guardian ${idx + 1}</div>
              <div class="acc-subtitle">Additional guardian</div>
            </div>
          </div>
          <svg class="acc-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
        </div>
        <div class="acc-body open" id="accGuardian${idx}Body">
          <div class="form-grid">
            <div class="form-group"><label>First Name</label><input type="text" name="guardianFirstName${idx}" /></div>
            <div class="form-group"><label>Last Name</label><input type="text" name="guardianLastName${idx}" /></div>
            <div class="form-group"><label>Phone</label><input type="text" name="guardianPhone${idx}" /></div>
            <div class="form-group"><label>Email</label><input type="email" name="guardianEmail${idx}" /></div>
            <div class="form-group full-width"><label>Hometown</label><input type="text" name="guardianHometown${idx}" /></div>
            <div class="form-group full-width">
              <label>Photo <span style="color:#94a3b8;font-weight:400;">(Optional)</span></label>
              <input type="file" name="guardianImage${idx}" accept="image/*" onchange="previewGuardianImage(this, ${idx})" />
              <div class="guardian-image-preview-wrap" id="guardianPreviewWrap${idx}" style="display:none;">
                <img id="guardianImagePreview${idx}" src="" alt="Preview" />
                <span style="font-size:.82rem;color:#64748b;">Preview</span>
              </div>
            </div>
          </div>
          <button type="button" class="remove-guardian" onclick="this.closest('.acc-card').remove()">&times; Remove Guardian</button>
        </div>`;
      container.appendChild(newCard);
      guardianCount++;
    }

    function previewGuardianImage(input, idx) {
      const wrap = document.getElementById('guardianPreviewWrap' + idx);
      const img  = document.getElementById('guardianImagePreview' + idx);
      if (input.files && input.files[0] && wrap && img) {
        const reader = new FileReader();
        reader.onload = (e) => { img.src = e.target.result; wrap.style.display = 'flex'; };
        reader.readAsDataURL(input.files[0]);
      }
    }

    // ─── Guardian search ──────────────────────────────────────────────────────

    document.addEventListener('DOMContentLoaded', () => {
      const input = document.getElementById('guardianSearchInput');
      if (!input) return;
      input.addEventListener('input', function () {
        clearTimeout(searchTimeout);
        const q = this.value.trim();
        if (q.length < 2) { document.getElementById('guardianSuggestions').classList.remove('show'); return; }
        searchTimeout = setTimeout(() => searchGuardians(q), 300);
      });
    });

    async function searchGuardians(query) {
      const suggestionsDiv = document.getElementById('guardianSuggestions');
      try {
        const res  = await fetch(`/common/searchGuardiansPublic?q=${encodeURIComponent(query)}&organizationId=${ORG_ID}`);
        const data = await res.json();
        suggestionsDiv.innerHTML = '';
        if (data.guardians && data.guardians.length) {
          data.guardians.forEach(g => {
            const item = document.createElement('div');
            item.className = 'guardian-suggestion-item';
            const imgUrl = g.image_url && g.image_url !== 'profilePlaceholder.png'
              ? escapeHtml(g.image_url) : '/images/profilePlaceholder.png';
            item.innerHTML = `
              <img src="${imgUrl}" alt="Guardian" onerror="this.src='/images/profilePlaceholder.png'">
              <div class="guardian-suggestion-info">
                <div class="guardian-suggestion-name">${escapeHtml(g.first_name||'')} ${escapeHtml(g.last_name||'')}</div>
                <div class="guardian-suggestion-details">${escapeHtml(buildGuardianContactPreview(g.phone, g.email))}</div>
              </div>`;
            item.onclick = (e) => { e.stopPropagation(); selectGuardian(g); };
            suggestionsDiv.appendChild(item);
          });
        } else {
          suggestionsDiv.innerHTML = '<div style="padding:12px;text-align:center;color:#666;">No guardians found</div>';
        }
        suggestionsDiv.classList.add('show');
      } catch (_) {
        suggestionsDiv.innerHTML = '<div style="padding:12px;text-align:center;color:#ef4444;">Search error. Try again.</div>';
        suggestionsDiv.classList.add('show');
      }
    }

    function selectGuardian(guardian) {
      document.getElementById('guardianSuggestions').classList.remove('show');
      document.getElementById('guardianSearchInput').value = '';
      const img = document.getElementById('selectedGuardianImg');
      img.src = (guardian.image_url && guardian.image_url !== 'profilePlaceholder.png')
        ? guardian.image_url : '/images/profilePlaceholder.png';
      img.onerror = () => { img.src = '/images/profilePlaceholder.png'; };
      document.getElementById('selectedGuardianName').textContent    = `${guardian.first_name||''} ${guardian.last_name||''}`.trim();
      document.getElementById('selectedGuardianDetails').textContent = buildGuardianContactPreview(guardian.phone, guardian.email);
      document.getElementById('selectedGuardianDisplay').classList.add('show');
      document.getElementById('existingGuardianId').value = guardian.guardian_id;
    }

    function clearGuardianSelection() {
      document.getElementById('selectedGuardianDisplay').classList.remove('show');
      document.getElementById('existingGuardianId').value = '';
      document.getElementById('guardianSearchInput').value = '';
      document.getElementById('guardianSearchInput').focus();
    }

    document.addEventListener('click', (e) => {
      const section = document.getElementById('guardianSearchSection');
      if (section && !section.contains(e.target))
        document.getElementById('guardianSuggestions').classList.remove('show');
    });

    function escapeHtml(str) {
      const d = document.createElement('div');
      d.textContent = str;
      return d.innerHTML;
    }

    function maskPhoneNumber(phone) {
      const digits = String(phone || '').replace(/\D/g, '');
      if (!digits) return '';
      if (digits.length <= 3) return digits;
      return `${'*'.repeat(digits.length - 3)}${digits.slice(-3)}`;
    }

    function maskEmailAddress(email) {
      const value = String(email || '').trim();
      if (!value || !value.includes('@')) return '';
      const [localPart, domain] = value.split('@');
      const visibleLocal = localPart.slice(0, 3);
      return `${visibleLocal}${localPart.length > 3 ? '***' : ''}@${domain}`;
    }

    function buildGuardianContactPreview(phone, email) {
      const maskedPhone = maskPhoneNumber(phone);
      const maskedEmail = maskEmailAddress(email);
      if (maskedPhone && maskedEmail) return `${maskedPhone} • ${maskedEmail}`;
      return maskedPhone || maskedEmail || '';
    }
  </script>
    
