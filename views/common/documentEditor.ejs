<%
  const themeColor = (typeof session !== 'undefined' && session && session.themeColor) ? session.themeColor : 'teal';
  const themeColors = themePalette;
  const currentTheme = themeColors[themeColor] || themeColors.teal;
  const isDoc = document.doc_type === 'document';
  const isReadOnly = permissionLevel === 'view';
  const canEdit = permissionLevel === 'edit';
  const canInsert = canEdit && (typeof canInsertData !== 'undefined' && canInsertData);
  const _sources = (typeof dataSources !== 'undefined' && dataSources) || [];
  const _terms = (typeof terms !== 'undefined' && terms) || [];
  const _json = (v) => JSON.stringify(v).replace(/</g, '\\u003c');
  const _levelLabel = { edit: 'Can edit', comment: 'Can comment', view: 'View only' };
  const _fields = (typeof reportFields !== 'undefined' && reportFields) || [];
  const _tplOn = typeof reportTemplateOn !== 'undefined' && reportTemplateOn;
  const _tplClasses = (typeof reportTemplateClasses !== 'undefined' && reportTemplateClasses) || [];
  const _currentTerm = _terms.find((t) => t.is_current) || _terms[0] || null;
%>
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="<%= locals.viewportContent || 'width=device-width, initial-scale=1.0, maximum-scale=1.0' %>" />
  <title><%= document.title %> - Managira</title>
  <link rel="icon" href="/favicon.ico" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />
  <% if (isDoc) { %><link href="https://cdn.quilljs.com/1.3.6/quill.snow.css" rel="stylesheet" /><% } %>
  <style>
    :root {
      --primary: <%= currentTheme.primary %>;
      --primary-hover: <%= currentTheme.hover %>;
      --tint: color-mix(in srgb, var(--primary) 10%, white);
      --line: #e5e7eb;
      --line-soft: #f1f5f9;
      --muted: #64748b;
      --text: #0f172a;
      --canvas: #eef1f5;
      --surface: #fff;
      --radius: 10px;
    }
    * { box-sizing: border-box; }
    html, body { height: 100%; margin: 0; overflow: hidden; }
    body { display: flex; flex-direction: column; font-family: 'Inter', system-ui, -apple-system, 'Segoe UI', sans-serif; color: var(--text); background: var(--canvas); -webkit-font-smoothing: antialiased; }
    button, input, select { font: inherit; color: inherit; }
    [hidden] { display: none !important; }

    /* Top bar */
    .ed-top { flex: none; display: flex; align-items: center; gap: 10px; height: 60px; padding: 0 14px; background: var(--surface); border-bottom: 1px solid var(--line); z-index: 20; }
    .ed-iconbtn { display: inline-flex; align-items: center; justify-content: center; flex: none; width: 38px; height: 38px; border: 1px solid var(--line); border-radius: var(--radius); background: var(--surface); color: var(--text); text-decoration: none; cursor: pointer; }
    .ed-iconbtn:hover { border-color: var(--primary); color: var(--primary); }
    .ed-kind { display: inline-flex; align-items: center; justify-content: center; flex: none; width: 36px; height: 36px; border-radius: 9px; color: #fff; font-size: 17px; }
    .ed-kind--doc { background: #2563eb; }
    .ed-kind--sheet { background: #16a34a; }
    .ed-name { display: flex; flex-direction: column; flex: 1 1 auto; min-width: 0; }
    .ed-name input { width: 100%; max-width: 520px; margin: 0; padding: 3px 6px; border: 1px solid transparent; border-radius: 6px; background: transparent; font-size: 16px; font-weight: 700; text-overflow: ellipsis; }
    .ed-name input:hover { border-color: var(--line); }
    .ed-name input:focus { outline: none; border-color: var(--primary); background: var(--surface); }
    .ed-status { display: inline-flex; align-items: center; gap: 5px; padding: 0 7px; color: var(--muted); font-size: 12px; }
    .ed-status.is-saving i { color: #d97706; }
    .ed-status.is-error { color: #dc2626; }
    .ed-actions { display: flex; align-items: center; gap: 8px; flex: none; }
    .btn { display: inline-flex; align-items: center; justify-content: center; gap: 7px; height: 38px; padding: 0 14px; border: 1px solid var(--line); border-radius: var(--radius); background: var(--surface); color: var(--text); font-size: 13.5px; font-weight: 600; white-space: nowrap; cursor: pointer; transition: background .12s, border-color .12s, color .12s; }
    .btn:hover { border-color: var(--primary); color: var(--primary); }
    .btn--primary { background: var(--primary); border-color: var(--primary); color: #fff; }
    .btn--primary:hover { background: var(--primary-hover); border-color: var(--primary-hover); color: #fff; }
    .btn--primary:disabled { opacity: .5; cursor: default; }
    .btn--sm { height: 32px; padding: 0 10px; font-size: 12.5px; }
    .ed-badge { padding: 4px 10px; border-radius: 999px; background: #e0f2fe; color: #0369a1; font-size: 12px; font-weight: 700; white-space: nowrap; }
    .ed-menu { position: relative; }
    .ed-menu__list { position: absolute; right: 0; top: calc(100% + 6px); z-index: 40; min-width: 230px; padding: 6px; border: 1px solid var(--line); border-radius: 12px; background: var(--surface); box-shadow: 0 16px 40px rgba(15, 23, 42, .16); }
    .ed-menu__list button, .ed-menu__list label { display: flex; align-items: center; gap: 10px; width: 100%; padding: 9px 10px; border: 0; border-radius: 8px; background: none; font-size: 13.5px; text-align: left; cursor: pointer; }
    .ed-menu__list button:hover, .ed-menu__list label:hover { background: var(--line-soft); }
    .ed-menu__list i { width: 16px; color: var(--muted); text-align: center; }
    .ed-menu__sep { height: 1px; margin: 5px 4px; background: var(--line); }
    .ed-dl-note { display: flex; gap: 8px; margin: 0; padding: 9px 10px; color: var(--muted); font-size: 12.5px; line-height: 1.4; }
    .ed-dl-note i { margin-top: 2px; }

    /* Main area: only the page / cells scroll */
    .ed-main { flex: 1 1 auto; display: flex; flex-direction: column; min-height: 0; }
    .ed-foot { flex: none; display: flex; align-items: center; gap: 14px; height: 32px; padding: 0 14px; border-top: 1px solid var(--line); background: var(--surface); color: var(--muted); font-size: 12px; }
    .ed-foot strong { color: var(--text); font-weight: 600; }
    .ed-foot .ed-foot__right { margin-left: auto; }

    /* Document */
    .ed-doc { flex: 1 1 auto; display: flex; flex-direction: column; min-height: 0; }
    .ed-doc .ql-toolbar.ql-snow { flex: none; display: flex; flex-wrap: wrap; justify-content: center; gap: 2px; padding: 6px 10px; border: 0; border-bottom: 1px solid var(--line); background: var(--surface); font-family: inherit; }
    .ed-doc .ql-toolbar.ql-snow .ql-formats { margin-right: 6px; padding-right: 6px; border-right: 1px solid var(--line-soft); }
    .ed-doc .ql-toolbar.ql-snow .ql-formats:last-child { border-right: 0; }
    .ed-doc .ql-toolbar.ql-snow button:hover .ql-stroke, .ed-doc .ql-toolbar.ql-snow button.ql-active .ql-stroke { stroke: var(--primary); }
    .ed-doc .ql-toolbar.ql-snow button:hover .ql-fill, .ed-doc .ql-toolbar.ql-snow button.ql-active .ql-fill { fill: var(--primary); }
    .ed-doc .ql-toolbar.ql-snow button.ql-active, .ed-doc .ql-toolbar.ql-snow .ql-picker-label.ql-active { color: var(--primary); }
    #doc-editor.ql-container.ql-snow { flex: 1 1 auto; min-height: 0; height: auto; overflow-y: auto; border: 0; background: var(--canvas); font-family: inherit; font-size: 15px; }
    #doc-editor .ql-editor { box-sizing: border-box; width: min(816px, calc(100% - 32px)); min-height: calc(100% - 48px); height: auto; margin: 24px auto; padding: 64px 72px; overflow: visible; background: var(--surface); border-radius: 4px; box-shadow: 0 1px 3px rgba(15, 23, 42, .08), 0 8px 28px rgba(15, 23, 42, .07); line-height: 1.7; }
    #doc-editor .ql-editor.ql-blank::before { left: 72px; right: 72px; color: #94a3b8; font-style: normal; }
    #doc-editor .ql-editor h1, #doc-editor .ql-editor h2, #doc-editor .ql-editor h3 { line-height: 1.3; margin: .6em 0 .3em; }

    /* Spreadsheet */
    .ed-sheet { flex: 1 1 auto; display: flex; flex-direction: column; min-height: 0; }
    .ed-ribbon { flex: none; display: flex; align-items: center; gap: 4px; padding: 6px 10px; border-bottom: 1px solid var(--line); background: var(--surface); overflow-x: auto; scrollbar-width: thin; }
    .ed-group { display: flex; align-items: center; gap: 2px; padding-right: 6px; margin-right: 4px; border-right: 1px solid var(--line-soft); }
    .ed-group:last-child { border-right: 0; }
    .ed-tool { display: inline-flex; align-items: center; justify-content: center; gap: 6px; flex: none; height: 32px; min-width: 32px; padding: 0 9px; border: 0; border-radius: 8px; background: none; color: #334155; font-size: 13px; font-weight: 600; white-space: nowrap; cursor: pointer; }
    .ed-tool:hover { background: var(--line-soft); color: var(--primary); }
    .ed-tool i { font-size: 13px; }
    .ed-tool__sigma { font-family: Georgia, serif; font-size: 16px; font-weight: 700; line-height: 1; }
    .ed-fx { flex: none; display: flex; align-items: center; gap: 0; padding: 6px 10px; border-bottom: 1px solid var(--line); background: var(--surface); }
    .ed-fx__ref { width: 74px; height: 32px; margin: 0; padding: 0 8px; border: 1px solid var(--line); border-radius: 8px 0 0 8px; background: var(--line-soft); font-size: 13px; font-weight: 700; text-align: center; }
    .ed-fx__icon { display: inline-flex; align-items: center; justify-content: center; width: 36px; height: 32px; border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); color: var(--muted); font-family: Georgia, serif; font-style: italic; font-weight: 700; }
    .ed-fx__input { flex: 1; min-width: 0; height: 32px; margin: 0; padding: 0 10px; border: 1px solid var(--line); border-radius: 0 8px 8px 0; font-size: 13.5px; }
    .ed-fx__input:focus, .ed-fx__ref:focus { outline: none; border-color: var(--primary); }
    .sheet-wrap { flex: 1 1 auto; min-height: 0; overflow: auto; background: var(--surface); }
    .sheet-table { border-collapse: separate; border-spacing: 0; width: max-content; min-width: 100%; font-size: 13px; }
    .sheet-table th, .sheet-table td { height: 30px; min-width: 110px; padding: 0; border-right: 1px solid #e8ebef; border-bottom: 1px solid #e8ebef; }
    .sheet-table thead th { position: sticky; top: 0; z-index: 2; background: #f8fafc; color: var(--muted); font-size: 12px; font-weight: 600; text-align: center; user-select: none; }
    .sheet-table thead th.is-hot, .sheet-table td.row-header-cell.is-hot { background: var(--tint); color: var(--primary); }
    .sheet-table th.corner { left: 0; z-index: 4; min-width: 46px; width: 46px; }
    .sheet-table td.row-header-cell { position: sticky; left: 0; z-index: 1; min-width: 46px; width: 46px; background: #f8fafc; color: var(--muted); font-size: 12px; font-weight: 600; text-align: center; user-select: none; }
    .sheet-table td { position: relative; background: var(--surface); }
    .sheet-table td.selected-range { background: color-mix(in srgb, var(--primary) 9%, white); }
    .sheet-table td.active-cell { box-shadow: inset 0 0 0 2px var(--primary); }
    .sheet-table td.formula-cell .sheet-cell-input { color: #1d4ed8; }
    .sheet-table td.error-cell { background: #fef2f2; }
    .sheet-table td.error-cell .sheet-cell-input { color: #dc2626; }
    .sheet-table td.num .sheet-cell-input { text-align: right; font-variant-numeric: tabular-nums; }
    .sheet-table tbody tr:first-child td.is-header .sheet-cell-input { font-weight: 700; }
    .sheet-cell-input { display: block; width: 100%; height: 100%; margin: 0; padding: 4px 8px; border: 0; outline: none; background: transparent; font-size: 13px; }
    .sheet-cell-input:focus { background: var(--surface); }

    /* Side panels (Share, Insert data) */
    .ed-backdrop { position: fixed; inset: 0; z-index: 50; background: rgba(15, 23, 42, .25); }
    .ed-panel { position: fixed; top: 0; right: 0; bottom: 0; z-index: 60; display: flex; flex-direction: column; width: min(440px, 100vw); background: var(--surface); box-shadow: -18px 0 40px rgba(15, 23, 42, .18); transform: translateX(105%); transition: transform .22s ease; }
    .ed-panel:not(.is-open) { visibility: hidden; box-shadow: none; transition: transform .22s ease, visibility 0s .22s; }
    .ed-panel.is-open { transform: none; }
    .ed-panel__bar { flex: none; display: flex; align-items: center; gap: 10px; padding: 14px 16px; border-bottom: 1px solid var(--line); }
    .ed-panel__bar strong { flex: 1; font-size: 16px; }
    .ed-panel__body { flex: 1 1 auto; min-height: 0; overflow-y: auto; padding: 16px; }
    .ed-panel__foot { flex: none; display: flex; align-items: center; gap: 10px; padding: 12px 16px; border-top: 1px solid var(--line); }
    .ed-panel__foot .ed-note { flex: 1; min-width: 0; margin: 0; }
    .ed-sec { margin-bottom: 18px; }
    .ed-sec > h3 { display: flex; align-items: center; gap: 8px; margin: 0 0 8px; color: var(--muted); font-size: 11.5px; font-weight: 800; letter-spacing: .06em; text-transform: uppercase; }
    .ed-note { margin: 6px 0 0; color: var(--muted); font-size: 12.5px; line-height: 1.45; }
    .ed-field { width: 100%; height: 40px; margin: 0; padding: 0 12px; border: 1px solid var(--line); border-radius: var(--radius); background: var(--surface); font-size: 14px; }
    .ed-field:focus { outline: none; border-color: var(--primary); box-shadow: 0 0 0 3px color-mix(in srgb, var(--primary) 15%, transparent); }
    .ed-row { display: flex; align-items: center; gap: 8px; }
    .ed-row > .ed-field { flex: 1 1 auto; min-width: 0; }
    .ed-row > select.ed-field--level { flex: 0 0 132px; }
    .ed-people { margin: 10px 0 0; padding: 0; list-style: none; }
    .ed-person { display: flex; align-items: center; gap: 10px; padding: 8px 0; border-bottom: 1px solid var(--line-soft); }
    .ed-person:last-child { border-bottom: 0; }
    .ed-av { display: inline-flex; align-items: center; justify-content: center; flex: none; width: 32px; height: 32px; border-radius: 50%; background: var(--tint); color: var(--primary); font-size: 12px; font-weight: 800; }
    .ed-person__name { flex: 1 1 auto; min-width: 0; font-size: 14px; font-weight: 600; overflow-wrap: anywhere; }
    .ed-person__name small { display: block; color: var(--muted); font-size: 12px; font-weight: 500; }
    .ed-person select { flex: none; height: 32px; padding: 0 6px; border: 1px solid var(--line); border-radius: 8px; background: var(--surface); font-size: 12.5px; }
    .ed-x { display: inline-flex; align-items: center; justify-content: center; flex: none; width: 30px; height: 30px; border: 0; border-radius: 8px; background: none; color: var(--muted); cursor: pointer; }
    .ed-x:hover { background: #fee2e2; color: #dc2626; }
    .ed-chk { display: inline-flex; align-items: center; gap: 5px; font-size: 12px; color: var(--muted); }
    .ed-empty { margin: 8px 0 0; color: var(--muted); font-size: 13px; }

    /* Insert data */
    .ed-sources { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; }
    .ed-source { position: relative; display: flex; flex-direction: column; align-items: center; gap: 6px; padding: 12px 6px; border: 1px solid var(--line); border-radius: 12px; background: var(--surface); font-size: 12.5px; font-weight: 600; text-align: center; cursor: pointer; transition: border-color .12s, background .12s; }
    .ed-source input { position: absolute; opacity: 0; pointer-events: none; }
    .ed-source i { font-size: 18px; color: var(--muted); }
    .ed-source:hover { border-color: color-mix(in srgb, var(--primary) 45%, white); }
    .ed-source:has(input:checked) { border-color: var(--primary); background: var(--tint); color: var(--primary); }
    .ed-source:has(input:checked) i { color: var(--primary); }
    .ed-source:has(input:focus-visible) { box-shadow: 0 0 0 3px color-mix(in srgb, var(--primary) 25%, transparent); }
    .ed-preview { margin-top: 4px; border: 1px solid var(--line); border-radius: 10px; overflow: auto; max-height: 240px; }
    .ed-preview table { border-collapse: collapse; width: max-content; min-width: 100%; font-size: 12px; }
    .ed-preview th, .ed-preview td { padding: 6px 9px; border-bottom: 1px solid var(--line-soft); text-align: left; white-space: nowrap; max-width: 180px; overflow: hidden; text-overflow: ellipsis; }
    .ed-preview th { position: sticky; top: 0; background: #f8fafc; color: var(--muted); font-weight: 700; }
    .ed-preview__msg { padding: 18px; color: var(--muted); font-size: 13px; text-align: center; }
    .ed-count { padding: 1px 8px; border-radius: 999px; background: var(--tint); color: var(--primary); font-size: 11px; letter-spacing: 0; text-transform: none; }
    .ed-start { display: flex; align-items: center; gap: 8px; font-size: 13.5px; }
    .ed-start input { width: 76px; height: 34px; padding: 0 8px; border: 1px solid var(--line); border-radius: 8px; font-weight: 700; text-align: center; text-transform: uppercase; }
    .ed-opt { display: flex; align-items: center; gap: 8px; margin-top: 10px; font-size: 13.5px; cursor: pointer; }
    .ed-opt input, .cd input[type=checkbox] { width: 16px; height: 16px; margin: 0; accent-color: var(--primary); }

    /* Dropdown with checkboxes */
    .cd { position: relative; }
    .cd__btn { position: relative; display: block; width: 100%; height: 40px; padding: 0 36px 0 12px; border: 1px solid var(--line); border-radius: var(--radius); background: var(--surface); font-size: 14px; font-weight: 600; text-align: left; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; cursor: pointer; }
    .cd__btn::after { content: '\f078'; position: absolute; right: 13px; top: 50%; transform: translateY(-50%); font-family: 'Font Awesome 6 Free'; font-weight: 900; font-size: 11px; color: var(--muted); }
    .cd__btn[aria-expanded="true"] { border-color: var(--primary); box-shadow: 0 0 0 3px color-mix(in srgb, var(--primary) 15%, transparent); }
    .cd__menu { position: absolute; left: 0; right: 0; top: calc(100% + 6px); z-index: 70; display: flex; flex-direction: column; max-height: 320px; border: 1px solid var(--line); border-radius: 12px; background: var(--surface); box-shadow: 0 16px 40px rgba(15, 23, 42, .16); overflow: hidden; }
    .cd__search { flex: none; margin: 8px; height: 34px; padding: 0 10px; border: 1px solid var(--line); border-radius: 8px; font-size: 13px; }
    .cd__search:focus { outline: none; border-color: var(--primary); }
    .cd__list { flex: 1; overflow-y: auto; padding: 2px 0 6px; }
    .cd__opt { display: flex; align-items: center; gap: 10px; padding: 8px 12px; font-size: 13.5px; cursor: pointer; }
    .cd__opt:hover { background: var(--line-soft); }
    .cd__opt span { flex: 1; min-width: 0; }
    .cd__opt small { color: var(--muted); }
    .cd__opt--all { border-bottom: 1px solid var(--line); font-weight: 700; }

    /* Sheet formatting, menus, resizing, hidden rows / columns */
    .ed-tool.is-on { background: var(--tint); color: var(--primary); }
    .ed-tool__a { display: inline-flex; flex-direction: column; align-items: center; line-height: 1; font-weight: 800; }
    .ed-tool__a b { display: block; width: 14px; height: 3px; margin-top: 2px; border-radius: 2px; background: currentColor; }
    .ed-pop { position: fixed; z-index: 80; min-width: 210px; padding: 6px; border: 1px solid var(--line); border-radius: 12px; background: var(--surface); box-shadow: 0 16px 40px rgba(15, 23, 42, .18); }
    .ed-pop button { display: flex; align-items: center; gap: 10px; width: 100%; padding: 8px 10px; border: 0; border-radius: 8px; background: none; font-size: 13.5px; text-align: left; cursor: pointer; }
    .ed-pop button:hover { background: var(--line-soft); }
    .ed-pop button i { width: 16px; color: var(--muted); text-align: center; }
    .ed-pop button kbd { margin-left: auto; color: var(--muted); font-family: inherit; font-size: 11.5px; }
    .ed-pop hr { height: 1px; margin: 5px 4px; border: 0; background: var(--line); }
    .ed-swatches { display: grid; grid-template-columns: repeat(6, 26px); gap: 6px; padding: 6px; }
    .ed-swatches button { width: 26px; height: 26px; padding: 0; border: 1px solid rgba(15, 23, 42, .15); border-radius: 6px; }
    .ed-swatches button:hover { outline: 2px solid var(--primary); outline-offset: 1px; }
    .ed-swatches button.is-none { background: linear-gradient(135deg, #fff 45%, #dc2626 45%, #dc2626 55%, #fff 55%); }
    .sheet-table { table-layout: fixed; }
    .sheet-table th, .sheet-table td { min-width: 0; overflow: hidden; }
    .sheet-table thead th { position: sticky; }
    .col-grip { position: absolute; top: 0; right: -3px; z-index: 3; width: 7px; height: 100%; cursor: col-resize; }
    .col-grip:hover, .col-grip.is-drag { background: var(--primary); opacity: .5; }
    body.is-resizing, body.is-resizing * { cursor: col-resize !important; user-select: none !important; }
    .ed-unhide { position: absolute; top: 50%; left: 1px; z-index: 3; display: inline-flex; align-items: center; justify-content: center; width: 14px; height: 18px; padding: 0; border: 0; border-radius: 4px; background: var(--primary); color: #fff; font-size: 9px; transform: translateY(-50%); cursor: pointer; }
    td.row-header-cell .ed-unhide { top: 1px; left: 50%; width: 18px; height: 12px; transform: translateX(-50%); }
    .sheet-table.no-grid td:not(.row-header-cell) { border-color: transparent; }
    .sheet-table.freeze-row tbody tr:first-child td { position: sticky; top: 31px; z-index: 2; box-shadow: 0 2px 0 #cbd5e1; }
    .sheet-table.freeze-row tbody tr:first-child td.row-header-cell { z-index: 3; }
    .sheet-table.freeze-col td[data-c="0"] { position: sticky; left: 46px; z-index: 1; box-shadow: 2px 0 0 #cbd5e1; }
    .sheet-table.freeze-col.freeze-row tbody tr:first-child td[data-c="0"] { z-index: 3; }
    /* Doc page settings */
    .ed--doc.page-wide #doc-editor .ql-editor { width: min(1040px, calc(100% - 32px)); }
    .ed--doc.page-full #doc-editor .ql-editor { width: calc(100% - 32px); }
    .ed-doc .ql-snow .ql-undo, .ed-doc .ql-snow .ql-redo { color: #444; font-size: 13px; }
    .ed-doc .ql-snow .ql-undo:hover, .ed-doc .ql-snow .ql-redo:hover { color: var(--primary); }
    .ed-doc .ql-editor ul[data-checked=true] > li::before, .ed-doc .ql-editor ul[data-checked=false] > li::before { color: var(--primary); }
    .ed-doc .ql-editor ul[data-checked=true] > li { color: var(--muted); text-decoration: line-through; }
    .ed-set { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 9px 0; border-bottom: 1px solid var(--line-soft); font-size: 14px; }
    .ed-set:last-child { border-bottom: 0; }
    .ed-set small { display: block; color: var(--muted); font-size: 12px; }
    .ed-set select { flex: none; width: 150px; height: 34px; padding: 0 8px; border: 1px solid var(--line); border-radius: 8px; background: var(--surface); font-size: 13px; }
    .ed-switch { position: relative; flex: none; width: 40px; height: 22px; }
    .ed-switch input { position: absolute; opacity: 0; width: 100%; height: 100%; margin: 0; cursor: pointer; }
    .ed-switch span { position: absolute; inset: 0; border-radius: 999px; background: #cbd5e1; transition: background .15s; pointer-events: none; }
    .ed-switch span::after { content: ''; position: absolute; top: 3px; left: 3px; width: 16px; height: 16px; border-radius: 50%; background: #fff; box-shadow: 0 1px 2px rgba(0, 0, 0, .2); transition: transform .15s; }
    .ed-switch input:checked + span { background: var(--primary); }
    .ed-switch input:checked + span::after { transform: translateX(18px); }
    .ed-switch input:focus-visible + span { box-shadow: 0 0 0 3px color-mix(in srgb, var(--primary) 25%, transparent); }
    .ed-kv { display: flex; justify-content: space-between; gap: 12px; padding: 6px 0; font-size: 13.5px; }
    .ed-kv span { color: var(--muted); }
    .ed-kv strong { font-weight: 600; text-align: right; }
    .ed-keys { display: grid; grid-template-columns: auto 1fr; gap: 6px 12px; margin: 0; font-size: 13px; }
    .ed-keys kbd { padding: 1px 6px; border: 1px solid var(--line); border-bottom-width: 2px; border-radius: 5px; background: #f8fafc; font-family: inherit; font-size: 11.5px; white-space: nowrap; }
    .ed-actions-col { display: flex; flex-direction: column; gap: 8px; }
    .ed-actions-col .btn { justify-content: flex-start; width: 100%; }
    .btn--danger { color: #dc2626; border-color: #fecaca; }
    .btn--danger:hover { background: #fef2f2; color: #b91c1c; border-color: #fca5a5; }

    .ed-size { height: 32px; margin: 0 2px; padding: 0 4px; border: 1px solid var(--line); border-radius: 8px; background: var(--surface); font-size: 12.5px; }
    .ed-fgroup { margin-bottom: 14px; }
    .ed-fgroup h4 { margin: 0 0 6px; font-size: 12px; font-weight: 800; letter-spacing: .05em; text-transform: uppercase; color: var(--muted); }
    .ed-fld { display: flex; align-items: center; gap: 4px; }
    .ed-fld[hidden], .ed-fgroup[hidden] { display: none !important; }
    .ed-fld__main { display: flex; align-items: center; justify-content: space-between; gap: 10px; flex: 1; min-width: 0; padding: 7px 8px; border: 0; border-radius: 8px; background: none; font-size: 13.5px; text-align: left; cursor: pointer; }
    .ed-fld__main:hover { background: var(--tint); }
    .ed-fld__main code, .ed-note code { padding: 1px 6px; border-radius: 6px; background: #f1f5f9; color: #0f766e; font-size: 11.5px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .sheet-table td.is-field .sheet-cell-input { color: #0f766e; }

    .ed-toast { position: fixed; left: 50%; bottom: 46px; z-index: 90; padding: 10px 16px; border-radius: 10px; background: #0f172a; color: #fff; font-size: 13.5px; box-shadow: 0 10px 30px rgba(15, 23, 42, .3); transform: translate(-50%, 20px); opacity: 0; pointer-events: none; transition: transform .2s, opacity .2s; }
    .ed-toast.is-on { transform: translate(-50%, 0); opacity: 1; }

    @media (max-width: 760px) {
      .ed-top { height: 56px; gap: 8px; padding: 0 10px; }
      .btn .label { display: none; }
      .btn { width: 38px; padding: 0; }
      .ed-kind { display: none; }
      .ed-status .label { display: none; }
      #doc-editor .ql-editor { width: 100%; min-height: 100%; margin: 0; padding: 22px 18px; border-radius: 0; box-shadow: none; }
      #doc-editor .ql-editor.ql-blank::before { left: 18px; right: 18px; }
      .ed-doc .ql-toolbar.ql-snow { flex-wrap: nowrap; justify-content: flex-start; overflow-x: auto; }
      .ed-doc .ql-toolbar.ql-snow .ql-formats { flex: none; }
      .sheet-table th, .sheet-table td { min-width: 92px; }
      .ed-sources { grid-template-columns: repeat(2, 1fr); }
      .ed-panel { width: 100vw; }
      .ed-foot .ed-foot__hide { display: none; }
    }
    @media print {
      body.is-report-layout > * { display: none !important; }
      body.is-report-layout::after { content: 'Report card layouts can’t be printed from here. Print report cards from Reports → Terminal Report.'; display: block; padding: 40px; font-size: 16px; }
      html, body { height: auto; overflow: visible; background: #fff; }
      .ed-top, .ed-foot, .ql-toolbar, .ed-ribbon, .ed-fx, .ed-panel, .ed-backdrop, .ed-toast { display: none !important; }
      #doc-editor.ql-container.ql-snow { overflow: visible; background: #fff; }
      #doc-editor .ql-editor { width: auto; margin: 0; padding: 0; box-shadow: none; }
      .sheet-wrap { overflow: visible; }
    }
  </style>
</head>
<body class="ed ed--<%= isDoc ? 'doc' : 'sheet' %><%= _tplOn ? ' is-report-layout' : '' %>">
  <header class="ed-top">
    <a href="<%= (typeof returnUrl !== 'undefined' && returnUrl) ? returnUrl : '/documents' %>" class="ed-iconbtn" title="Back to files" aria-label="Back to files"><i class="fa-solid fa-arrow-left"></i></a>
    <span class="ed-kind ed-kind--<%= isDoc ? 'doc' : 'sheet' %>" aria-hidden="true"><i class="fa-solid fa-<%= isDoc ? 'file-lines' : 'table' %>"></i></span>
    <div class="ed-name">
      <input type="text" id="titleInput" value="<%= document.title %>" aria-label="File name" <%= canEdit ? '' : 'readonly' %> />
      <span class="ed-status" id="saveStatus"><i class="fa-solid fa-cloud"></i> <span class="label" id="saveText"><%= canEdit ? 'All changes saved' : (_levelLabel[permissionLevel] || 'View only') %></span></span>
    </div>
    <div class="ed-actions">
      <% if (!canEdit) { %><span class="ed-badge"><%= _levelLabel[permissionLevel] || 'View only' %></span><% } %>
      <% if (canInsert) { %>
        <button type="button" class="btn" id="openFields" title="Report card fields: {{student.name}}, {{subject.grade}}…"><i class="fa-solid fa-code"></i><span class="label">Fields</span></button>
        <button type="button" class="btn" id="openInsert" title="Insert school data"><i class="fa-solid fa-table-list"></i><span class="label">Insert data</span></button>
      <% } %>
      <div class="ed-menu">
        <button type="button" class="btn" id="dlBtn" aria-haspopup="true" aria-expanded="false" title="Import, download or print"><i class="fa-regular fa-folder-open"></i><span class="label">File</span></button>
        <div class="ed-menu__list" id="dlMenu" hidden>
          <%# Report card layouts are filled with student data, so they aren't downloadable. %>
          <div class="ed-dl" data-dl-group<%= _tplOn ? ' hidden' : '' %>>
            <% if (isDoc) { %>
              <button type="button" data-dl="word"><i class="fa-solid fa-file-word"></i> Word document (.doc)</button>
              <button type="button" data-dl="text"><i class="fa-solid fa-file-lines"></i> Plain text (.txt)</button>
            <% } else { %>
              <button type="button" data-dl="excel"><i class="fa-solid fa-file-excel"></i> Excel (.xls)</button>
              <button type="button" data-dl="csv"><i class="fa-solid fa-file-csv"></i> CSV (.csv)</button>
            <% } %>
            <button type="button" data-dl="print"><i class="fa-solid fa-print"></i> Print or save as PDF</button>
          </div>
          <p class="ed-dl-note" data-dl-locked<%= _tplOn ? '' : ' hidden' %>><i class="fa-solid fa-lock"></i> This is a report card layout, so it can’t be downloaded. Print report cards from Terminal Report.</p>
          <% if (!isDoc && canEdit) { %>
            <div class="ed-menu__sep"></div>
            <label><i class="fa-solid fa-file-arrow-up"></i> Upload Excel (.xlsx)<input type="file" id="xlsxImport" accept=".xlsx,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" hidden /></label>
            <label><i class="fa-solid fa-file-import"></i> Upload a CSV file<input type="file" id="csvImport" accept=".csv,text/csv" hidden /></label>
          <% } %>
        </div>
      </div>
      <% if (canEdit) { %>
        <button type="button" class="btn" id="openSettings" title="Settings"><i class="fa-solid fa-gear"></i><span class="label">Settings</span></button>
        <button type="button" class="btn btn--primary" id="openShare" title="Share"><i class="fa-solid fa-user-plus"></i><span class="label">Share</span></button>
      <% } %>
    </div>
  </header>

  <main class="ed-main">
    <% if (isDoc) { %>
      <div class="ed-doc"><div id="doc-editor"></div></div>
      <footer class="ed-foot">
        <span><strong id="wordCount">0</strong> words</span>
        <span class="ed-foot__hide"><strong id="charCount">0</strong> characters</span>
        <span class="ed-foot__right ed-foot__hide">Saves on its own as you type</span>
      </footer>
    <% } else { %>
      <div class="ed-sheet">
        <% if (canEdit) { %>
          <div class="ed-ribbon" role="toolbar" aria-label="Sheet tools">
            <div class="ed-group">
              <button type="button" class="ed-tool" data-act="undo" title="Undo (Ctrl+Z)" aria-label="Undo"><i class="fa-solid fa-rotate-left"></i></button>
              <button type="button" class="ed-tool" data-act="redo" title="Redo (Ctrl+Y)" aria-label="Redo"><i class="fa-solid fa-rotate-right"></i></button>
            </div>
            <div class="ed-group">
              <button type="button" class="ed-tool" data-fmt="b" title="Bold (Ctrl+B)" aria-label="Bold"><i class="fa-solid fa-bold"></i></button>
              <button type="button" class="ed-tool" data-fmt="i" title="Italic (Ctrl+I)" aria-label="Italic"><i class="fa-solid fa-italic"></i></button>
              <button type="button" class="ed-tool" data-fmt="u" title="Underline (Ctrl+U)" aria-label="Underline"><i class="fa-solid fa-underline"></i></button>
              <button type="button" class="ed-tool" data-pop="color" title="Text color" aria-label="Text color"><span class="ed-tool__a">A<b id="colorBar" style="background:#0f172a"></b></span></button>
              <button type="button" class="ed-tool" data-pop="fill" title="Highlight (fill color)" aria-label="Highlight"><i class="fa-solid fa-highlighter"></i></button>
              <select class="ed-size" id="fontSize" title="Text size" aria-label="Text size">
                <option value="">13</option><option value="10">10</option><option value="11">11</option><option value="12">12</option><option value="14">14</option><option value="16">16</option><option value="18">18</option><option value="20">20</option><option value="24">24</option><option value="28">28</option><option value="32">32</option>
              </select>
            </div>
            <div class="ed-group">
              <button type="button" class="ed-tool" data-pop="borders" title="Borders" aria-label="Borders"><i class="fa-regular fa-square"></i> <i class="fa-solid fa-caret-down"></i></button>
              <button type="button" class="ed-tool" data-act="merge" title="Merge or unmerge the selected cells"><i class="fa-solid fa-table-cells-large"></i> Merge</button>
            </div>
            <div class="ed-group">
              <button type="button" class="ed-tool" data-align="left" title="Align left" aria-label="Align left"><i class="fa-solid fa-align-left"></i></button>
              <button type="button" class="ed-tool" data-align="center" title="Align center" aria-label="Align center"><i class="fa-solid fa-align-center"></i></button>
              <button type="button" class="ed-tool" data-align="right" title="Align right" aria-label="Align right"><i class="fa-solid fa-align-right"></i></button>
              <button type="button" class="ed-tool" data-act="clear-format" title="Clear formatting" aria-label="Clear formatting"><i class="fa-solid fa-text-slash"></i></button>
            </div>
            <div class="ed-group">
              <button type="button" class="ed-tool" data-pop="insert" title="Insert rows or columns"><i class="fa-solid fa-plus"></i> Insert <i class="fa-solid fa-caret-down"></i></button>
              <button type="button" class="ed-tool" data-pop="delete" title="Delete, clear or hide"><i class="fa-regular fa-trash-can"></i> Delete <i class="fa-solid fa-caret-down"></i></button>
            </div>
            <div class="ed-group">
              <button type="button" class="ed-tool" data-fn="SUM" title="Sum of the selected cells"><span class="ed-tool__sigma">Σ</span> Sum</button>
              <button type="button" class="ed-tool" data-fn="AVERAGE" title="Average of the selection">Avg</button>
              <button type="button" class="ed-tool" data-fn="COUNT" title="Count numbers in the selection">Count</button>
              <button type="button" class="ed-tool" data-fn="MIN" title="Smallest value">Min</button>
              <button type="button" class="ed-tool" data-fn="MAX" title="Largest value">Max</button>
            </div>
            <div class="ed-group">
              <button type="button" class="ed-tool" data-act="sort-asc" title="Sort rows by this column, A to Z (row 1 stays as the header)" aria-label="Sort A to Z"><i class="fa-solid fa-arrow-down-a-z"></i></button>
              <button type="button" class="ed-tool" data-act="sort-desc" title="Sort rows by this column, Z to A (row 1 stays as the header)" aria-label="Sort Z to A"><i class="fa-solid fa-arrow-down-z-a"></i></button>
              <button type="button" class="ed-tool" data-act="freeze-row" title="Keep row 1 in view while scrolling"><i class="fa-solid fa-thumbtack"></i> Freeze</button>
            </div>
          </div>
        <% } %>
        <div class="ed-fx">
          <input type="text" id="cellRef" class="ed-fx__ref" value="A1" aria-label="Cell" title="Type a cell (like C12) and press Enter to jump there" />
          <span class="ed-fx__icon">fx</span>
          <input type="text" id="formulaBar" class="ed-fx__input" placeholder="Value or formula, e.g. =SUM(B2:B20)" aria-label="Cell value or formula" <%= canEdit ? '' : 'readonly' %> />
        </div>
        <div class="sheet-wrap" id="sheetWrap"><table class="sheet-table" id="sheetTable"></table></div>
      </div>
      <footer class="ed-foot">
        <span id="sheetSize"></span>
        <span class="ed-foot__hide">Copy and paste ranges from Excel or Google Sheets</span>
        <span class="ed-foot__right" id="sheetStats">Select cells to see Sum and Average</span>
      </footer>
    <% } %>
  </main>

  <div class="ed-backdrop" id="edBackdrop" hidden></div>

  <% if (canEdit) { %>
  <aside class="ed-panel" id="sharePanel" role="dialog" aria-modal="true" aria-label="Share">
    <div class="ed-panel__bar"><strong>Share</strong><button type="button" class="ed-x" data-close aria-label="Close"><i class="fa-solid fa-xmark"></i></button></div>
    <div class="ed-panel__body">
      <section class="ed-sec">
        <h3>People</h3>
        <div class="ed-row">
          <select class="ed-field" id="addUserSelect" aria-label="Add a person">
            <option value="">Add a person…</option>
            <% employees.forEach(emp => { %><option value="<%= emp.user_id %>" data-role="<%= emp.role %>"><%= emp.name %></option><% }); %>
          </select>
          <select class="ed-field ed-field--level" id="addUserLevel" aria-label="Access">
            <option value="view">View only</option><option value="comment">Can comment</option><option value="edit">Can edit</option>
          </select>
        </div>
        <ul class="ed-people" id="permList">
          <% permissions.forEach(p => { %>
            <li class="ed-person" data-user-id="<%= p.user_id %>">
              <span class="ed-av"><%= String(p.user_name || '?').split(/\s+/).map((w) => w.charAt(0)).join('').slice(0, 2).toUpperCase() %></span>
              <span class="ed-person__name"><%= p.user_name %></span>
              <select aria-label="Access"><option value="view"<%= p.permission_level === 'view' ? ' selected' : '' %>>View only</option><option value="comment"<%= p.permission_level === 'comment' ? ' selected' : '' %>>Can comment</option><option value="edit"<%= p.permission_level === 'edit' ? ' selected' : '' %>>Can edit</option></select>
              <button type="button" class="ed-x" data-remove aria-label="Remove"><i class="fa-solid fa-xmark"></i></button>
            </li>
          <% }); %>
        </ul>
        <p class="ed-empty" id="permEmpty"<%= permissions.length ? ' hidden' : '' %>>Only you and school managers can open this file.</p>
      </section>
      <section class="ed-sec">
        <h3>Classes</h3>
        <select class="ed-field" id="addClassSelect" aria-label="Add a class">
          <option value="">Add a class…</option>
          <% classes.forEach(cls => { %><option value="<%= cls.class_id %>"><%= cls.class_name %></option><% }); %>
        </select>
        <ul class="ed-people" id="classAssignList">
          <% classAssignments.forEach(ca => { %>
            <li class="ed-person" data-class-id="<%= ca.class_id %>">
              <span class="ed-av"><i class="fa-solid fa-chalkboard-user"></i></span>
              <span class="ed-person__name"><%= ca.class_name %>
                <small><label class="ed-chk"><input type="checkbox" class="incStudents"<%= ca.include_students ? ' checked' : '' %>> Students too</label> <label class="ed-chk"><input type="checkbox" class="incSubjects"<%= ca.include_subjects ? ' checked' : '' %>> Subject teachers</label></small>
              </span>
              <select aria-label="Access"><option value="view"<%= ca.permission_level === 'view' ? ' selected' : '' %>>View only</option><option value="comment"<%= ca.permission_level === 'comment' ? ' selected' : '' %>>Can comment</option><option value="edit"<%= ca.permission_level === 'edit' ? ' selected' : '' %>>Can edit</option></select>
              <button type="button" class="ed-x" data-remove aria-label="Remove"><i class="fa-solid fa-xmark"></i></button>
            </li>
          <% }); %>
        </ul>
      </section>
    </div>
    <div class="ed-panel__foot">
      <p class="ed-note" id="shareNote">Changes apply when you save.</p>
      <button type="button" class="btn btn--primary" id="saveShare">Save</button>
    </div>
  </aside>
  <% } %>

  <% if (canEdit) {
       const _when = (d) => d ? new Date(d).toLocaleString('en-US', { month: 'short', day: 'numeric', year: 'numeric', hour: 'numeric', minute: '2-digit' }) : '—'; %>
  <aside class="ed-panel" id="settingsPanel" role="dialog" aria-modal="true" aria-label="Settings">
    <div class="ed-panel__bar"><strong>Settings</strong><button type="button" class="ed-x" data-close aria-label="Close"><i class="fa-solid fa-xmark"></i></button></div>
    <div class="ed-panel__body">
      <section class="ed-sec">
        <h3>File</h3>
        <input type="text" class="ed-field" id="setTitle" value="<%= document.title %>" aria-label="File name" />
        <div style="margin-top:8px">
          <div class="ed-kv"><span>Type</span><strong><%= isDoc ? 'Document' : 'Spreadsheet' %></strong></div>
          <% if (document.created_by_name) { %><div class="ed-kv"><span>Created by</span><strong><%= document.created_by_name %></strong></div><% } %>
          <div class="ed-kv"><span>Created</span><strong><%= _when(document.created_at) %></strong></div>
          <div class="ed-kv"><span>Last saved</span><strong id="setSaved"><%= _when(document.updated_at) %></strong></div>
        </div>
      </section>
      <% if (isDoc) { %>
        <section class="ed-sec">
          <h3>Page</h3>
          <label class="ed-set"><span>Page width<small>How wide the writing area is.</small></span>
            <select id="setPage"><option value="normal">Normal (letter)</option><option value="wide">Wide</option><option value="full">Full width</option></select></label>
          <label class="ed-set"><span>Line spacing</span>
            <select id="setSpacing"><option value="1.15">Tight (1.15)</option><option value="1.5">Normal (1.5)</option><option value="1.7">Relaxed (1.7)</option><option value="2">Double (2)</option></select></label>
          <label class="ed-set"><span>Text size</span>
            <select id="setFontSize"><option value="14">Small</option><option value="15">Normal</option><option value="17">Large</option></select></label>
        </section>
      <% } else { %>
        <section class="ed-sec">
          <h3>Sheet</h3>
          <div class="ed-set"><span>Freeze first row<small>Row 1 stays in view while you scroll.</small></span><label class="ed-switch"><input type="checkbox" id="setFreezeRow" aria-label="Freeze first row" /><span></span></label></div>
          <div class="ed-set"><span>Freeze first column<small>Column A stays in view.</small></span><label class="ed-switch"><input type="checkbox" id="setFreezeCol" aria-label="Freeze first column" /><span></span></label></div>
          <div class="ed-set"><span>Show gridlines</span><label class="ed-switch"><input type="checkbox" id="setGrid" aria-label="Show gridlines" /><span></span></label></div>
          <label class="ed-set"><span>Column width<small>For columns you haven't resized.</small></span>
            <select id="setColWidth"><option value="90">Narrow</option><option value="120">Normal</option><option value="170">Wide</option></select></label>
          <div class="ed-set"><span>Hidden rows and columns<small id="setHiddenNote">None hidden.</small></span><button type="button" class="btn btn--sm" id="setUnhide">Show all</button></div>
        </section>
      <% } %>
      <% if (canInsert) { %>
        <section class="ed-sec" id="rtSec">
          <h3>Report card</h3>
          <div class="ed-set"><span>Use as a report card<small>Chosen classes print with this layout.</small></span><label class="ed-switch"><input type="checkbox" id="rtOn"<%= _tplOn ? ' checked' : '' %> aria-label="Use as a report card" /><span></span></label></div>
          <div id="rtMore"<%= _tplOn ? '' : ' hidden' %>>
            <p class="ed-note" style="margin:10px 0 6px;font-weight:700">Classes</p>
            <div class="cd" id="rtClasses"></div>
            <p class="ed-note" id="rtMoveNote"></p>
            <p class="ed-note" style="margin:12px 0 6px;font-weight:700">Preview with real data</p>
            <div class="ed-row">
              <select class="ed-field" id="rtPreviewClass" aria-label="Class to preview with">
                <% classes.forEach((c) => { %><option value="<%= c.class_id %>"><%= c.class_name %></option><% }) %>
              </select>
              <button type="button" class="btn" id="rtPreview"><i class="fa-regular fa-eye"></i> Preview</button>
            </div>

          </div>
          <div style="display:flex;align-items:center;gap:10px;margin-top:10px">
            <button type="button" class="btn btn--primary btn--sm" id="rtSave">Save</button>
            <span class="ed-note" id="rtNote" style="margin:0"></span>
          </div>
        </section>
      <% } %>
      <section class="ed-sec">
        <h3>Shortcuts</h3>
        <dl class="ed-keys">
          <% if (isDoc) { %>
            <dt><kbd>Ctrl</kbd> <kbd>B</kbd> / <kbd>I</kbd> / <kbd>U</kbd></dt><dd style="margin:0">Bold, italic, underline</dd>
            <dt><kbd>Ctrl</kbd> <kbd>Z</kbd></dt><dd style="margin:0">Undo (add <kbd>Shift</kbd> to redo)</dd>
            <dt><kbd>Ctrl</kbd> <kbd>K</kbd></dt><dd style="margin:0">Add a link</dd>
            <dt><kbd>Ctrl</kbd> <kbd>P</kbd></dt><dd style="margin:0">Print or save as PDF</dd>
          <% } else { %>
            <dt><kbd>Enter</kbd> / <kbd>Tab</kbd></dt><dd style="margin:0">Save the cell and move down / right</dd>
            <dt><kbd>Shift</kbd> + arrows</dt><dd style="margin:0">Select a range</dd>
            <dt><kbd>Ctrl</kbd> <kbd>C</kbd> / <kbd>V</kbd></dt><dd style="margin:0">Copy or paste a range (works with Excel)</dd>
            <dt><kbd>Delete</kbd></dt><dd style="margin:0">Clear the selected cells</dd>
            <dt><kbd>Ctrl</kbd> <kbd>B</kbd> / <kbd>I</kbd> / <kbd>U</kbd></dt><dd style="margin:0">Bold, italic, underline</dd>
            <dt><kbd>Ctrl</kbd> <kbd>Z</kbd> / <kbd>Y</kbd></dt><dd style="margin:0">Undo / redo</dd>
            <dt>Right-click</dt><dd style="margin:0">Insert, delete, hide rows and columns</dd>
          <% } %>
        </dl>
      </section>
      <% if (canInsert) { %>
        <section class="ed-sec">
          <h3>More</h3>
          <div class="ed-actions-col">
            <button type="button" class="btn" id="setCopy"><i class="fa-regular fa-copy"></i> Make a copy</button>
            <button type="button" class="btn btn--danger" id="setDelete"><i class="fa-regular fa-trash-can"></i> Delete this file</button>
          </div>
        </section>
      <% } %>
    </div>
  </aside>
  <% } %>

  <% if (canInsert) { %>
  <aside class="ed-panel" id="fieldsPanel" role="dialog" aria-modal="true" aria-label="Report card fields">
    <div class="ed-panel__bar"><strong>Report card fields</strong><button type="button" class="ed-x" data-close aria-label="Close"><i class="fa-solid fa-xmark"></i></button></div>
    <div class="ed-panel__body">
      <p class="ed-note" style="margin:0 0 12px">Click a field to add it <%= isDoc ? 'at the cursor' : 'to the selected cell' %>. It fills with each student’s data when printed.</p>
      <p class="ed-note" style="margin:0 0 6px;font-weight:700">Start from a sample</p>
      <div class="ed-row" style="margin-bottom:12px;flex-wrap:wrap">
        <button type="button" class="btn btn--sm" data-sample="scores"><i class="fa-solid fa-wand-magic-sparkles"></i> Scores</button>
        <button type="button" class="btn btn--sm" data-sample="ticks"><i class="fa-solid fa-wand-magic-sparkles"></i> Tick boxes</button>
        <% if (!isDoc) { %><button type="button" class="btn btn--sm" data-sample="nursery"><i class="fa-solid fa-wand-magic-sparkles"></i> Nursery card</button><% } %>
      </div>
      <input type="search" class="ed-field" id="fieldSearch" placeholder="Search fields" aria-label="Search fields" style="margin-bottom:10px" />
      <div id="fieldList">
        <% _fields.forEach((g) => { %>
          <section class="ed-fgroup">
            <h4><%= g.group %></h4>
            <% if (g.note) { %><p class="ed-note" style="margin:-2px 0 6px"><%= g.note %></p><% } %>
            <% g.fields.forEach(([key, label]) => { %>
              <div class="ed-fld" data-search="<%= (key + ' ' + label).toLowerCase() %>">
                <button type="button" class="ed-fld__main" data-field="<%= key %>" title="Insert"><span><%= label %></span><code>{{<%= key %>}}</code></button>
                <button type="button" class="ed-x" data-copy-field="<%= key %>" title="Copy" aria-label="Copy {{<%= key %>}}"><i class="fa-regular fa-copy"></i></button>
              </div>
            <% }) %>
          </section>
        <% }) %>
      </div>
    </div>
    <div class="ed-panel__foot"><p class="ed-note"><a href="#" id="copyAllFields">Copy all fields</a> to paste into a sheet.</p></div>
  </aside>

  <aside class="ed-panel" id="insertPanel" role="dialog" aria-modal="true" aria-label="Insert data">
    <div class="ed-panel__bar"><strong>Insert school data</strong><button type="button" class="ed-x" data-close aria-label="Close"><i class="fa-solid fa-xmark"></i></button></div>
    <div class="ed-panel__body">
      <section class="ed-sec">
        <h3>What</h3>
        <div class="ed-sources" id="insSources">
          <% const _icons = { students: 'user-graduate', guardians: 'people-roof', subjects: 'book', staff: 'id-badge', attendance: 'calendar-check', results: 'chart-column' }; %>
          <% _sources.forEach((s, i) => { %>
            <label class="ed-source"><input type="radio" name="insSource" value="<%= s.key %>"<%= i === 0 ? ' checked' : '' %> /><i class="fa-solid fa-<%= _icons[s.key] || 'table' %>"></i><%= s.label %></label>
          <% }) %>
        </div>
      </section>
      <section class="ed-sec" id="insTermSec">
        <h3>Term</h3>
        <select class="ed-field" id="insTerm" aria-label="Term">
          <% _terms.forEach((t) => { %><option value="<%= t.term_id %>"<%= t.is_current ? ' selected' : '' %>><%= t.term_name %><%= t.year_label ? ' · ' + t.year_label : '' %><%= t.is_current ? ' (current)' : '' %></option><% }) %>
        </select>
      </section>
      <section class="ed-sec" id="insClassSec">
        <h3>Classes</h3>
        <div class="cd" id="insClasses"></div>
      </section>
      <section class="ed-sec">
        <h3>Columns</h3>
        <div class="cd" id="insFields"></div>
      </section>
      <section class="ed-sec">
        <h3>Preview <span class="ed-count" id="insCount">…</span></h3>
        <div class="ed-preview" id="insPreview"><div class="ed-preview__msg">Loading…</div></div>
        <% if (!isDoc) { %>
          <div class="ed-start" style="margin-top:12px">Start at cell <input type="text" id="insStart" value="A1" aria-label="Start at cell" /> <span class="ed-note" id="insStartNote" style="margin:0"></span></div>
        <% } %>
        <label class="ed-opt"><input type="checkbox" id="insHeader" checked /> Include a header row</label>
      </section>
    </div>
    <div class="ed-panel__foot">
      <p class="ed-note" id="insNote"></p>
      <button type="button" class="btn btn--primary" id="insGo" disabled><i class="fa-solid fa-plus"></i> Insert</button>
    </div>
  </aside>
  <script type="application/json" id="insSourcesData"><%- _json(_sources) %></script>
  <script type="application/json" id="rtData"><%- _json({ on: _tplOn, mine: _tplClasses.filter((x) => x.document_id === document.id).map((x) => String(x.class_id)), others: _tplClasses.filter((x) => x.document_id !== document.id).map((x) => ({ classId: String(x.class_id), title: x.title })), termId: _currentTerm ? _currentTerm.term_id : null }) %></script>
  <script type="application/json" id="insClassesData"><%- _json(classes.map((c) => ({ value: String(c.class_id), label: c.class_name }))) %></script>
  <% } %>

  <div class="ed-toast" id="edToast" role="status" aria-live="polite"></div>

  <div class="ed-pop" id="edPop" role="menu" hidden></div>

  <% if (isDoc) { %><script src="https://cdn.quilljs.com/1.3.6/quill.min.js"></script><% } %>
  <script>
    const DOC_ID = '<%= document.id %>';
    const CAN_EDIT = <%= canEdit %>;
    const IS_DOC = <%= isDoc %>;
    const RETURN_URL = <%- _json((typeof returnUrl !== 'undefined' && returnUrl) ? returnUrl : '/documents') %>;
    let saveTimer = null;
    let dirty = false;
    let lastSavedContent = '';
    let lastKnownUpdate = '<%= document.updated_at %>';

    const $ = (id) => document.getElementById(id);
    const esc = (v) => String(v == null ? '' : v).replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
    const isMac = /Mac|iPhone|iPad/.test(navigator.platform);
    const mod = (e) => (isMac ? e.metaKey : e.ctrlKey);
    function toast(text) {
      const t = $('edToast');
      t.textContent = text;
      t.classList.add('is-on');
      clearTimeout(toast.timer);
      toast.timer = setTimeout(() => t.classList.remove('is-on'), 2600);
    }
    function setStatus(kind, text) {
      const el = $('saveStatus');
      el.className = 'ed-status' + (kind ? ' is-' + kind : '');
      el.querySelector('i').className = 'fa-solid ' + (kind === 'saving' ? 'fa-rotate fa-spin' : kind === 'error' ? 'fa-triangle-exclamation' : 'fa-cloud');
      $('saveText').textContent = text;
    }
    function download(name, mime, content) {
      const blob = new Blob([content], { type: mime });
      const a = document.createElement('a');
      a.href = URL.createObjectURL(blob);
      a.download = name;
      document.body.appendChild(a);
      a.click();
      setTimeout(() => { URL.revokeObjectURL(a.href); a.remove(); }, 500);
    }
    const fileBase = () => ($('titleInput').value.trim() || 'Untitled').replace(/[\\/:*?"<>|]+/g, ' ').trim();

    // Small popup menu (toolbar menus, colors, right-click).
    const pop = $('edPop');
    let popOwner = null;
    function openPop(html, x, y, owner) {
      pop.innerHTML = html;
      pop.hidden = false;
      popOwner = owner || null;
      const w = pop.offsetWidth, h = pop.offsetHeight;
      pop.style.left = Math.max(8, Math.min(x, innerWidth - w - 8)) + 'px';
      pop.style.top = Math.max(8, y + h > innerHeight - 8 ? y - h : y) + 'px';
    }
    function closePop() { pop.hidden = true; popOwner = null; }
    document.addEventListener('mousedown', (e) => { if (!pop.hidden && !pop.contains(e.target) && !(popOwner && popOwner.contains(e.target))) closePop(); });
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && !pop.hidden) closePop(); });
    window.addEventListener('resize', closePop);
    const menuItem = (act, icon, label, key) => '<button type="button" data-do="' + act + '"><i class="' + icon + '"></i>' + esc(label) + (key ? '<kbd>' + key + '</kbd>' : '') + '</button>';

    // ========== DOCUMENT ==========
    <% if (isDoc) { %>
    let docSettings = { page: 'normal', spacing: '1.7', size: '15' };
    const quill = new Quill('#doc-editor', {
      theme: 'snow',
      placeholder: CAN_EDIT ? 'Start writing…' : '',
      modules: {
        history: { delay: 800, maxStack: 200, userOnly: true },
        toolbar: CAN_EDIT ? {
          container: [
            ['undo', 'redo'],
            [{ header: [1, 2, 3, false] }, { font: [] }, { size: ['small', false, 'large', 'huge'] }],
            ['bold', 'italic', 'underline', 'strike'],
            [{ color: [] }, { background: [] }],
            [{ list: 'ordered' }, { list: 'bullet' }, { list: 'check' }, { indent: '-1' }, { indent: '+1' }],
            [{ align: [] }],
            [{ script: 'sub' }, { script: 'super' }],
            ['blockquote', 'code-block', 'link', 'image'],
            ['clean'],
          ],
          handlers: { undo() { quill.history.undo(); }, redo() { quill.history.redo(); } },
        } : false,
      },
    });
    if (!CAN_EDIT) quill.disable();
    document.querySelectorAll('.ql-undo').forEach((b) => { b.innerHTML = '<i class="fa-solid fa-rotate-left"></i>'; b.title = 'Undo (Ctrl+Z)'; b.setAttribute('aria-label', 'Undo'); });
    document.querySelectorAll('.ql-redo').forEach((b) => { b.innerHTML = '<i class="fa-solid fa-rotate-right"></i>'; b.title = 'Redo (Ctrl+Shift+Z)'; b.setAttribute('aria-label', 'Redo'); });
    const tips = { bold: 'Bold', italic: 'Italic', underline: 'Underline', strike: 'Strikethrough', blockquote: 'Quote', 'code-block': 'Code', link: 'Link', image: 'Image', clean: 'Clear formatting' };
    Object.keys(tips).forEach((k) => document.querySelectorAll('.ql-' + k).forEach((b) => { b.title = tips[k]; }));
    document.querySelectorAll('.ql-list[value="check"]').forEach((b) => { b.title = 'Checklist'; });
    document.querySelectorAll('.ql-background').forEach((b) => { b.title = 'Highlight'; });

    // Content is saved as { ops, settings } so page settings travel with the file.
    function loadDoc(raw) {
      if (!raw) return;
      try {
        const parsed = JSON.parse(raw);
        if (parsed && parsed.settings) docSettings = Object.assign(docSettings, parsed.settings);
        quill.setContents(parsed && parsed.ops ? parsed.ops : parsed, 'silent');
      } catch (e) { quill.clipboard.dangerouslyPasteHTML(raw, 'silent'); }
      applyDocSettings();
    }
    function applyDocSettings() {
      document.body.classList.toggle('page-wide', docSettings.page === 'wide');
      document.body.classList.toggle('page-full', docSettings.page === 'full');
      quill.root.style.lineHeight = docSettings.spacing;
      quill.root.style.fontSize = docSettings.size + 'px';
    }
    // The HTML is kept too so report cards can be printed from this Doc.
    const docContent = () => JSON.stringify({ ops: quill.getContents().ops, settings: docSettings, html: quill.root.innerHTML });
    loadDoc(<%- _json(document.content || '') %>);
    lastSavedContent = docContent();

    function updateCounts() {
      const text = quill.getText().trim();
      $('wordCount').textContent = text ? text.split(/\s+/).length.toLocaleString() : '0';
      $('charCount').textContent = text.replace(/\s/g, '').length.toLocaleString();
    }
    updateCounts();
    quill.on('text-change', (delta, old, source) => {
      updateCounts();
      if (CAN_EDIT && source === 'user') triggerAutoSave();
    });

    function docHtml() {
      return '<html><head><meta charset="utf-8"><title>' + esc(fileBase()) + '</title><style>body{font-family:Calibri,Arial,sans-serif;font-size:11pt;line-height:' + docSettings.spacing + '}</style></head><body>' + quill.root.innerHTML + '</body></html>';
    }
    <% } %>

    // ========== SPREADSHEET ==========
    <% if (!isDoc) { %>
    let sheetData = {};
    let styles = {};          // cell -> { b, i, u, color, bg, align }
    let colWidths = {};       // column index -> px
    let hiddenRows = [];
    let hiddenCols = [];
    let merges = [];          // [{ r, c, rs, cs }]
    let sheetSettings = { freezeRow: false, freezeCol: false, grid: true, colWidth: 120 };
    let colCount = 10;
    let rowCount = 30;
    let selectedCell = 'A1';
    let selectedRange = null;
    let anchorCell = 'A1';
    let isSelectingRange = false;
    const undoStack = [], redoStack = [];

    function loadSheet(raw) {
      try {
        const parsed = JSON.parse(raw || '{}');
        sheetData = parsed.cells || {};
        styles = parsed.styles || {};
        colWidths = parsed.colWidths || {};
        hiddenRows = parsed.hiddenRows || [];
        hiddenCols = parsed.hiddenCols || [];
        merges = Array.isArray(parsed.merges) ? parsed.merges : [];
        sheetSettings = Object.assign({ freezeRow: false, freezeCol: false, grid: true, colWidth: 120 }, parsed.settings || {});
        colCount = Math.max(parsed.colCount || 10, 1);
        rowCount = Math.max(parsed.rowCount || 20, 1);
      } catch (e) { /* empty sheet */ }
    }
    const sheetContent = () => JSON.stringify({ cells: sheetData, colCount, rowCount, styles, colWidths, hiddenRows, hiddenCols, merges, settings: sheetSettings });
    const mergeAt = (r, c) => merges.find((m) => r >= m.r && r < m.r + m.rs && c >= m.c && c < m.c + m.cs);
    loadSheet(<%- _json(document.content || '{}') %>);
    lastSavedContent = sheetContent();

    // Save the cell being typed in before the grid changes (its id may move).
    function flushEdit() {
      const a = document.activeElement;
      if (a && a.classList && a.classList.contains('sheet-cell-input')) a.blur();
    }
    // Undo / redo: snapshots of the whole sheet before each change.
    function snapshot() {
      undoStack.push(sheetContent());
      if (undoStack.length > 100) undoStack.shift();
      redoStack.length = 0;
    }
    function restore(from, to) {
      flushEdit();
      if (!from.length) { toast('Nothing to ' + (from === undoStack ? 'undo' : 'redo') + '.'); return; }
      to.push(sheetContent());
      loadSheet(from.pop());
      renderSheet();
      triggerAutoSave();
    }

    function colLabel(n) { let s = ''; while (n >= 0) { s = String.fromCharCode(65 + (n % 26)) + s; n = Math.floor(n / 26) - 1; } return s; }
    function colIndex(label) { let v = 0; for (let i = 0; i < label.length; i++) v = v * 26 + (label.charCodeAt(i) - 64); return v - 1; }
    function parseCellRef(ref) {
      const m = String(ref || '').toUpperCase().trim().match(/^([A-Z]+)(\d+)$/);
      if (!m) return null;
      const c = colIndex(m[1]), r = parseInt(m[2], 10) - 1;
      return r >= 0 && c >= 0 ? { r, c } : null;
    }
    function cellId(r, c) { return colLabel(c) + (r + 1); }
    function normalizeRange(a, b) {
      const s = parseCellRef(a), e = parseCellRef(b);
      if (!s || !e) return null;
      return { sr: Math.min(s.r, e.r), er: Math.max(s.r, e.r), sc: Math.min(s.c, e.c), ec: Math.max(s.c, e.c) };
    }
    const rangeRef = (r) => cellId(r.sr, r.sc) + ':' + cellId(r.er, r.ec);
    const curRange = () => selectedRange || normalizeRange(selectedCell, selectedCell);
    const isMulti = (r) => r && (r.sr !== r.er || r.sc !== r.ec);
    const widthOf = (c) => colWidths[c] || Number(sheetSettings.colWidth) || 120;
    function usedSize() {
      let rows = 0, cols = 0;
      Object.keys(sheetData).forEach((k) => {
        if (sheetData[k] === '' || sheetData[k] == null) return;
        const p = parseCellRef(k);
        if (p) { rows = Math.max(rows, p.r + 1); cols = Math.max(cols, p.c + 1); }
      });
      return { rows, cols };
    }
    function eachCell(r, fn) { for (let i = r.sr; i <= r.er; i++) for (let j = r.sc; j <= r.ec; j++) fn(cellId(i, j), i, j); }

    function computeCell(val, visited = new Set(), currentRef = null) {
      if (typeof val !== 'string' || !val.startsWith('=')) return val;
      try {
        const formula = val.substring(1).toUpperCase();
        let expr = formula.replace(/(SUM|AVERAGE|COUNT|MIN|MAX)\(([A-Z]+\d+):([A-Z]+\d+)\)/g, (_, fn, a, b) => {
          const nums = getRangeValues(a, b, visited).map(Number).filter((n) => !Number.isNaN(n));
          if (fn === 'SUM') return String(nums.reduce((x, y) => x + y, 0));
          if (fn === 'AVERAGE') return String(nums.length ? nums.reduce((x, y) => x + y, 0) / nums.length : 0);
          if (fn === 'COUNT') return String(nums.length);
          if (fn === 'MIN') return String(nums.length ? Math.min(...nums) : 0);
          if (fn === 'MAX') return String(nums.length ? Math.max(...nums) : 0);
          return '0';
        });
        expr = expr.replace(/([A-Z]+\d+)/g, (m) => {
          if (currentRef && m === currentRef) return '0';
          if (visited.has(m)) return '#REF';
          const v = sheetData[m];
          if (!v) return '0';
          const next = new Set(visited); next.add(m);
          const computed = computeCell(v, next, m);
          if (computed === '#REF') return '#REF';
          const n = Number(computed);
          return Number.isNaN(n) ? '0' : String(n);
        });
        if (expr.includes('#REF')) return '#REF';
        if (!/^[\d+\-*/().,%\s]+$/.test(expr)) return '#ERROR';
        const out = Function('"use strict"; return (' + expr + ')')();
        return typeof out === 'number' && !Number.isInteger(out) ? Math.round(out * 1e6) / 1e6 : out;
      } catch (e) { return '#ERROR'; }
    }
    function getRangeValues(a, b, visited = new Set()) {
      const r = normalizeRange(a, b);
      if (!r) return [];
      const out = [];
      eachCell(r, (id) => { const v = sheetData[id]; if (v !== undefined && v !== '') out.push(computeCell(v, new Set(visited), id)); });
      return out;
    }
    const display = (id) => computeCell(sheetData[id] || '', new Set([id]), id);
    const isNum = (v) => v !== '' && v !== null && !Number.isNaN(Number(v));

    function cellClass(id) {
      const raw = sheetData[id] || '';
      const shown = display(id);
      const cls = [];
      if (typeof raw === 'string' && raw.startsWith('=')) cls.push('formula-cell');
      if (shown === '#ERROR' || shown === '#REF') cls.push('error-cell');
      if (isNum(shown)) cls.push('num');
      if (typeof raw === 'string' && raw.includes('{{')) cls.push('is-field');
      return cls.join(' ');
    }
    function tdStyle(id) {
      const s = styles[id];
      if (!s) return '';
      const bd = s.bd || '', line = '1px solid #1f2937';
      return [s.bg ? 'background:' + s.bg : '', bd.includes('t') ? 'border-top:' + line : '', bd.includes('b') ? 'border-bottom:' + line : '', bd.includes('l') ? 'border-left:' + line : '', bd.includes('r') ? 'border-right:' + line : ''].filter(Boolean).join(';');
    }
    function inputStyle(id) {
      const s = styles[id];
      if (!s) return '';
      return [s.b ? 'font-weight:700' : '', s.i ? 'font-style:italic' : '', s.u ? 'text-decoration:underline' : '', s.color ? 'color:' + s.color : '', s.align ? 'text-align:' + s.align : '', s.fs ? 'font-size:' + s.fs + 'px' : ''].filter(Boolean).join(';');
    }

    function renderSheet() {
      const table = $('sheetTable');
      const hr = new Set(hiddenRows), hc = new Set(hiddenCols);
      const cols = [];
      for (let c = 0; c < colCount; c++) if (!hc.has(c)) cols.push(c);
      let total = 46;
      let html = '<colgroup><col style="width:46px">';
      cols.forEach((c) => { total += widthOf(c); html += '<col data-col="' + c + '" style="width:' + widthOf(c) + 'px">'; });
      html += '</colgroup><thead><tr><th class="corner"></th>';
      cols.forEach((c) => {
        const gapBefore = c > 0 && hc.has(c - 1);
        html += '<th data-col="' + c + '">' + (gapBefore ? '<button type="button" class="ed-unhide" data-unhide-col="' + c + '" title="Show hidden columns" aria-label="Show hidden columns"><i class="fa-solid fa-caret-left"></i></button>' : '') + colLabel(c) + (CAN_EDIT ? '<span class="col-grip" data-grip="' + c + '" title="Drag to resize, double-click to fit"></span>' : '') + '</th>';
      });
      html += '</tr></thead><tbody>';
      for (let r = 0; r < rowCount; r++) {
        if (hr.has(r)) continue;
        const gapBefore = r > 0 && hr.has(r - 1);
        html += '<tr><td class="row-header-cell" data-row="' + r + '">' + (gapBefore ? '<button type="button" class="ed-unhide" data-unhide-row="' + r + '" title="Show hidden rows" aria-label="Show hidden rows"><i class="fa-solid fa-caret-up"></i></button>' : '') + (r + 1) + '</td>';
        cols.forEach((c) => {
          const m = mergeAt(r, c);
          if (m && (m.r !== r || m.c !== c)) return;
          const id = cellId(r, c);
          let span = '';
          if (m) {
            let cs = 0, rs = 0;
            for (let j = m.c; j < m.c + m.cs; j++) if (!hc.has(j)) cs++;
            for (let i = m.r; i < m.r + m.rs; i++) if (!hr.has(i)) rs++;
            span = (cs > 1 ? ' colspan="' + cs + '"' : '') + (rs > 1 ? ' rowspan="' + rs + '"' : '');
          }
          html += '<td' + span + ' data-cell="' + id + '" data-c="' + c + '" class="' + cellClass(id) + '" style="' + tdStyle(id) + '"><input class="sheet-cell-input" data-cell="' + id + '" value="' + esc(display(id)) + '" style="' + inputStyle(id) + '"' + (CAN_EDIT ? '' : ' readonly') + ' spellcheck="false" autocomplete="off" /></td>';
        });
        html += '</tr>';
      }
      table.innerHTML = html + '</tbody>';
      table.style.width = total + 'px';
      table.classList.toggle('freeze-row', !!sheetSettings.freezeRow);
      table.classList.toggle('freeze-col', !!sheetSettings.freezeCol);
      table.classList.toggle('no-grid', sheetSettings.grid === false);
      const hidden = hiddenRows.length + hiddenCols.length;
      $('sheetSize').innerHTML = '<strong>' + rowCount + '</strong> rows × <strong>' + colCount + '</strong> columns' + (hidden ? ' · <a href="#" id="showHidden">' + hidden + ' hidden — show</a>' : '');
      const sh = $('showHidden');
