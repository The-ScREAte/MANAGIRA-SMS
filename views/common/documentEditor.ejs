      } else if (name === 'del-row') {
        if (rowCount - nRows < 1) { undoStack.pop(); return; }
        remap((i, j) => (i >= r.sr && i <= r.er ? null : { r: i > r.er ? i - nRows : i, c: j }));
        hiddenRows = shiftList(hiddenRows, r.er + 1, -nRows, r.sr, r.er);
        merges = shrinkMerges(merges, 'r', 'rs', r.sr, r.er);
        rowCount -= nRows;
        toast(nRows + ' row' + (nRows === 1 ? '' : 's') + ' deleted');
      } else if (name === 'del-col') {
        if (colCount - nCols < 1) { undoStack.pop(); return; }
        remap((i, j) => (j >= r.sc && j <= r.ec ? null : { r: i, c: j > r.ec ? j - nCols : j }));
        hiddenCols = shiftList(hiddenCols, r.ec + 1, -nCols, r.sc, r.ec);
        merges = shrinkMerges(merges, 'c', 'cs', r.sc, r.ec);
        shiftWidths(r.ec + 1, -nCols, r.sc, r.ec);
        colCount -= nCols;
        toast(nCols + ' column' + (nCols === 1 ? '' : 's') + ' deleted');
      } else if (name === 'hide-row') {
        for (let i = r.sr; i <= r.er; i++) if (!hiddenRows.includes(i)) hiddenRows.push(i);
        if (hiddenRows.length >= rowCount) { undoStack.pop(); hiddenRows = hiddenRows.slice(0, rowCount - 1); toast('At least one row must stay visible.'); }
        toast(nRows + ' row' + (nRows === 1 ? '' : 's') + ' hidden — click the small arrow to show');
      } else if (name === 'hide-col') {
        for (let j = r.sc; j <= r.ec; j++) if (!hiddenCols.includes(j)) hiddenCols.push(j);
        if (hiddenCols.length >= colCount) { undoStack.pop(); hiddenCols = hiddenCols.slice(0, colCount - 1); toast('At least one column must stay visible.'); }
        toast(nCols + ' column' + (nCols === 1 ? '' : 's') + ' hidden — click the small arrow to show');
      } else if (name === 'freeze-row') {
        sheetSettings.freezeRow = !sheetSettings.freezeRow;
        toast(sheetSettings.freezeRow ? 'Row 1 stays in view' : 'Row 1 unfrozen');
      } else if (name === 'sort-asc' || name === 'sort-desc') {
        const used = usedSize();
        const multiRow = r.er > r.sr;
        const top = multiRow ? r.sr : 1, bottom = multiRow ? r.er : used.rows - 1;
        if (bottom <= top) { undoStack.pop(); toast('Nothing to sort yet.'); return; }
        if (merges.some((m) => m.r + m.rs - 1 >= top && m.r <= bottom)) { undoStack.pop(); toast('Unmerge the cells in these rows before sorting.'); return; }
        const width = Math.max(used.cols, r.ec + 1);
        const rows = [];
        for (let i = top; i <= bottom; i++) { const row = []; for (let j = 0; j < width; j++) row.push([sheetData[cellId(i, j)], styles[cellId(i, j)]]); rows.push(row); }
        const key = p.c, dir = name === 'sort-asc' ? 1 : -1;
        rows.sort((a, b) => {
          const x = a[key][0] == null ? '' : computeCell(a[key][0]), y = b[key][0] == null ? '' : computeCell(b[key][0]);
          if (x === '' && y !== '') return 1;
          if (y === '' && x !== '') return -1;
          if (isNum(x) && isNum(y)) return (Number(x) - Number(y)) * dir;
          return String(x).localeCompare(String(y), undefined, { numeric: true, sensitivity: 'base' }) * dir;
        });
        rows.forEach((row, i) => row.forEach(([v, st], j) => {
          const id = cellId(top + i, j);
          if (v === undefined || v === '') delete sheetData[id]; else sheetData[id] = v;
          if (st) styles[id] = st; else delete styles[id];
        }));
        toast('Sorted by column ' + colLabel(key));
      }
      const sp = parseCellRef(selectedCell);
      if (!sp || sp.r >= rowCount || sp.c >= colCount) { selectedCell = 'A1'; anchorCell = 'A1'; }
      selectedRange = normalizeRange(anchorCell, selectedCell);
      renderSheet();
      triggerAutoSave();
    }

    const INSERT_MENU = () => menuItem('row-above', 'fa-solid fa-arrow-up', 'Row above') + menuItem('row-below', 'fa-solid fa-arrow-down', 'Row below') +
      menuItem('col-left', 'fa-solid fa-arrow-left', 'Column left') + menuItem('col-right', 'fa-solid fa-arrow-right', 'Column right') + '<hr>' +
      menuItem('rows-10', 'fa-solid fa-plus', '10 rows at the bottom') + menuItem('cols-5', 'fa-solid fa-plus', '5 columns at the end');
    const DELETE_MENU = () => menuItem('del-row', 'fa-regular fa-trash-can', 'Delete row(s)') + menuItem('del-col', 'fa-regular fa-trash-can', 'Delete column(s)') +
      menuItem('clear', 'fa-solid fa-eraser', 'Clear cells', 'Del') + '<hr>' +
      menuItem('hide-row', 'fa-regular fa-eye-slash', 'Hide row(s)') + menuItem('hide-col', 'fa-regular fa-eye-slash', 'Hide column(s)') +
      ((hiddenRows.length || hiddenCols.length) ? menuItem('unhide', 'fa-regular fa-eye', 'Show hidden rows & columns') : '');
    function contextMenu() {
      const multi = isMulti(curRange());
      const r0 = curRange();
      const merged = merges.some((m) => m.r <= r0.er && m.r + m.rs - 1 >= r0.sr && m.c <= r0.ec && m.c + m.cs - 1 >= r0.sc);
      return menuItem('copy', 'fa-regular fa-copy', 'Copy', isMac ? '⌘C' : 'Ctrl+C') + menuItem('paste', 'fa-regular fa-paste', 'Paste', isMac ? '⌘V' : 'Ctrl+V') +
        (merged ? menuItem('merge', 'fa-solid fa-table-cells', 'Unmerge cells') : multi ? menuItem('merge', 'fa-solid fa-table-cells-large', 'Merge cells') : '') + '<hr>' + INSERT_MENU().replace(/<hr>.*$/, '') + '<hr>' +
        menuItem('del-row', 'fa-regular fa-trash-can', 'Delete row(s)') + menuItem('del-col', 'fa-regular fa-trash-can', 'Delete column(s)') + menuItem('clear', 'fa-solid fa-eraser', multi ? 'Clear cells' : 'Clear cell', 'Del') + '<hr>' +
        menuItem('hide-row', 'fa-regular fa-eye-slash', 'Hide row(s)') + menuItem('hide-col', 'fa-regular fa-eye-slash', 'Hide column(s)') +
        ((hiddenRows.length || hiddenCols.length) ? menuItem('unhide', 'fa-regular fa-eye', 'Show hidden rows & columns') : '') + '<hr>' +
        menuItem('sort-asc', 'fa-solid fa-arrow-down-a-z', 'Sort A → Z') + menuItem('sort-desc', 'fa-solid fa-arrow-down-z-a', 'Sort Z → A') + menuItem('fit', 'fa-solid fa-left-right', 'Fit column width');
    }
    pop.addEventListener('click', (e) => {
      const sw = e.target.closest('[data-swatch]');
      if (sw) { const kind = sw.dataset.kind, c = sw.dataset.swatch; setStyle((s) => Object.assign(s, { [kind]: c })); if (kind === 'color' && c) $('colorBar').style.background = c; closePop(); return; }
      const b = e.target.closest('[data-do]');
      if (!b) return;
      closePop();
      if (b.dataset.do.startsWith('bd-')) { applyBorders(b.dataset.do.slice(3)); return; }
      if (b.dataset.do === 'paste') { pasteFromClipboard(); return; }
      if (b.dataset.do === 'copy') { const r = curRange(); const lines = []; for (let i = r.sr; i <= r.er; i++) { const row = []; for (let j = r.sc; j <= r.ec; j++) row.push(String(display(cellId(i, j)))); lines.push(row.join('\t')); } navigator.clipboard && navigator.clipboard.writeText(lines.join('\n')).then(() => toast('Copied'), () => toast('Use Ctrl+C to copy')); return; }
      act(b.dataset.do);
    });
    if (CAN_EDIT) {
      document.querySelectorAll('.ed-ribbon [data-pop]').forEach((b) => b.addEventListener('click', () => {
        if (!pop.hidden && popOwner === b) { closePop(); return; }
        const rect = b.getBoundingClientRect();
        const kind = b.dataset.pop;
        const html = kind === 'insert' ? INSERT_MENU() : kind === 'delete' ? DELETE_MENU() : kind === 'borders' ? BORDER_MENU() : kind === 'fill' ? swatches(FILLS, 'bg') : swatches(INKS, 'color');
        openPop(html, rect.left, rect.bottom + 6, b);
      }));
      table.addEventListener('contextmenu', (e) => {
        const td = e.target.closest('td[data-cell]'), th = e.target.closest('th[data-col]'), rh = e.target.closest('td[data-row]');
        if (!td && !th && !rh) return;
        e.preventDefault();
        if (td) { const pp = parseCellRef(td.dataset.cell), r = curRange(); if (!(pp.r >= r.sr && pp.r <= r.er && pp.c >= r.sc && pp.c <= r.ec)) focusCell(td.dataset.cell); }
        if (th) { const c = +th.dataset.col, r = curRange(); if (!(c >= r.sc && c <= r.ec && r.sr === 0 && r.er === rowCount - 1)) selectCol(c); }
        if (rh) { const rr = +rh.dataset.row, r = curRange(); if (!(rr >= r.sr && rr <= r.er && r.sc === 0 && r.ec === colCount - 1)) selectRow(rr); }
        openPop(contextMenu(), e.clientX, e.clientY);
      });
    }
    document.querySelectorAll('.ed-ribbon [data-act]').forEach((b) => b.addEventListener('click', () => act(b.dataset.act)));
    document.querySelectorAll('.ed-ribbon [data-fn]').forEach((b) => b.addEventListener('click', () => {
      const r = selectedRange;
      if (!isMulti(r)) { toast('Select the cells first, then press ' + b.textContent.trim() + '.'); return; }
      // The result goes just below a column selection, or right of a row selection.
      const target = r.sc === r.ec ? cellId(r.er + 1, r.sc) : r.sr === r.er ? cellId(r.sr, r.ec + 1) : cellId(r.er + 1, r.sc);
      const tp = parseCellRef(target);
      flushEdit();
      snapshot();
      if (tp.r >= rowCount) rowCount = tp.r + 1;
      if (tp.c >= colCount) colCount = tp.c + 1;
      sheetData[target] = '=' + b.dataset.fn + '(' + rangeRef(r) + ')';
      renderSheet();
      focusCell(target);
      triggerAutoSave();
      toast(b.textContent.trim() + ' added in ' + target);
    }));

    function pasteFromClipboard() {
      if (!navigator.clipboard || !navigator.clipboard.readText) { toast('Use Ctrl+V to paste.'); return; }
      navigator.clipboard.readText().then((text) => {
        if (!text) return;
        const rows = text.replace(/\r/g, '').replace(/\n$/, '').split('\n').map((l) => l.split('\t'));
        const p = parseCellRef(selectedCell);
        placeBlock(rows, p.r, p.c);
        toast('Pasted');
      }, () => toast('Allow clipboard access, or use Ctrl+V to paste.'));
    }

    function replaceSheet(x) {
      flushEdit();
      snapshot();
      sheetData = x.cells || {}; styles = x.styles || {}; colWidths = x.colWidths || {}; merges = x.merges || [];
      hiddenRows = []; hiddenCols = [];
      rowCount = x.rowCount || 30; colCount = x.colCount || 10;
      selectedCell = 'A1'; anchorCell = 'A1'; selectedRange = null;
      renderSheet(); select('A1'); triggerAutoSave();
    }

    // Upload an Excel workbook: keeps values, merged cells, colors, borders and widths.
    const xlsxImport = $('xlsxImport');
    if (xlsxImport) xlsxImport.addEventListener('change', async () => {
      const file = xlsxImport.files[0];
      xlsxImport.value = '';
      $('dlMenu').hidden = true;
      if (!file) return;
      const used = usedSize();
      if (used.rows && !confirm('Replace this sheet with "' + file.name + '"? You can undo this.')) return;
      toast('Reading ' + file.name + '…');
      const form = new FormData();
      form.append('file', file);
      try {
        const res = await fetch('/documents/importXlsx', { method: 'POST', body: form });
        const data = await res.json();
        if (!data.success) { toast(data.message || 'Could not read this file.'); return; }
        replaceSheet(data.sheet);
        toast('Uploaded ' + file.name);
      } catch (e) { toast('Could not upload this file.'); }
    });

    function sheetRows() {
      const used = usedSize();
      const rows = [];
      for (let i = 0; i < used.rows; i++) { const row = []; for (let j = 0; j < used.cols; j++) row.push(display(cellId(i, j))); rows.push(row); }
      return rows;
    }
    function parseCsv(text) {
      const rows = []; let row = [], cur = '', q = false;
      for (let i = 0; i < text.length; i++) {
        const ch = text[i];
        if (q) { if (ch === '"' && text[i + 1] === '"') { cur += '"'; i++; } else if (ch === '"') q = false; else cur += ch; }
        else if (ch === '"') q = true;
        else if (ch === ',') { row.push(cur); cur = ''; }
        else if (ch === '\n' || ch === '\r') { if (ch === '\r' && text[i + 1] === '\n') i++; row.push(cur); rows.push(row); row = []; cur = ''; }
        else cur += ch;
      }
      if (cur !== '' || row.length) { row.push(cur); rows.push(row); }
      return rows;
    }
    const csvImport = $('csvImport');
    if (csvImport) csvImport.addEventListener('change', () => {
      const file = csvImport.files[0];
      if (!file) return;
      file.text().then((text) => {
        const rows = parseCsv(text.replace(/^﻿/, ''));
        const used = usedSize();
        const start = used.rows ? used.rows + 1 : 0;
        if (used.rows && !confirm('Add the CSV below your data, starting at row ' + (start + 1) + '?')) return;
        placeBlock(rows, start, 0);
        toast('Imported ' + rows.length + ' rows');
      });
      csvImport.value = '';
      $('dlMenu').hidden = true;
    });

    function syncSettingsPanel() {
      if (!$('setFreezeRow')) return;
      $('setFreezeRow').checked = !!sheetSettings.freezeRow;
      $('setFreezeCol').checked = !!sheetSettings.freezeCol;
      $('setGrid').checked = sheetSettings.grid !== false;
      $('setColWidth').value = String(sheetSettings.colWidth || 120);
      const n = hiddenRows.length + hiddenCols.length;
      $('setHiddenNote').textContent = n ? hiddenRows.length + ' row' + (hiddenRows.length === 1 ? '' : 's') + ', ' + hiddenCols.length + ' column' + (hiddenCols.length === 1 ? '' : 's') + ' hidden.' : 'None hidden.';
      $('setUnhide').disabled = !n;
    }

    renderSheet();
    select('A1');
    <% } %>

    // ========== DOWNLOAD / PRINT ==========
    $('dlBtn').addEventListener('click', (e) => { e.stopPropagation(); const m = $('dlMenu'); m.hidden = !m.hidden; $('dlBtn').setAttribute('aria-expanded', String(!m.hidden)); });
    document.addEventListener('click', (e) => { if (!e.target.closest('.ed-menu')) { $('dlMenu').hidden = true; $('dlBtn').setAttribute('aria-expanded', 'false'); } });
    document.querySelectorAll('[data-dl]').forEach((b) => b.addEventListener('click', () => {
      $('dlMenu').hidden = true;
      if (document.querySelector('[data-dl-group]').hidden) return;
      const kind = b.dataset.dl;
      if (kind === 'print') { window.print(); return; }
      <% if (isDoc) { %>
      if (kind === 'word') download(fileBase() + '.doc', 'application/msword', docHtml());
      if (kind === 'text') download(fileBase() + '.txt', 'text/plain;charset=utf-8', quill.getText());
      <% } else { %>
      const rows = sheetRows();
      if (!rows.length) { toast('The sheet is empty.'); return; }
      if (kind === 'csv') download(fileBase() + '.csv', 'text/csv;charset=utf-8', '﻿' + rows.map((r) => r.map((v) => /[",\n]/.test(String(v)) ? '"' + String(v).replace(/"/g, '""') + '"' : v).join(',')).join('\r\n'));
      if (kind === 'excel') {
        const cell = (v, i, j) => { const s = styles[cellId(i, j)] || {}; const css = [s.b ? 'font-weight:bold' : '', s.i ? 'font-style:italic' : '', s.u ? 'text-decoration:underline' : '', s.color ? 'color:' + s.color : '', s.bg ? 'background:' + s.bg : '', s.align ? 'text-align:' + s.align : ''].filter(Boolean).join(';'); return '<td' + (css ? ' style="' + css + '"' : '') + '>' + esc(v) + '</td>'; };
        download(fileBase() + '.xls', 'application/vnd.ms-excel', '<html><head><meta charset="utf-8"></head><body><table border="1">' + rows.map((r, i) => '<tr>' + r.map((v, j) => cell(v, i, j)).join('') + '</tr>').join('') + '</table></body></html>');
      }
      <% } %>
    }));

    // ========== AUTO SAVE ==========
    const currentContent = () => (IS_DOC ? docContent() : sheetContent());
    function triggerAutoSave() {
      if (!CAN_EDIT) return;
      dirty = true;
      clearTimeout(saveTimer);
      setStatus('saving', 'Saving…');
      saveTimer = setTimeout(autoSave, 1200);
    }
    async function autoSave() {
      if (!CAN_EDIT) return;
      const content = currentContent();
      const title = $('titleInput').value.trim();
      try {
        const res = await fetch('/documents/save/' + DOC_ID, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ content, title }) });
        const data = await res.json();
        if (data.success) {
          lastSavedContent = content;
          dirty = content !== currentContent();
          if (!dirty) setStatus('', 'All changes saved');
          if ($('setSaved')) $('setSaved').textContent = new Date().toLocaleString('en-US', { month: 'short', day: 'numeric', year: 'numeric', hour: 'numeric', minute: '2-digit' });
        } else setStatus('error', 'Not saved — retrying');
      } catch (e) { setStatus('error', 'Offline — not saved yet'); }
      if (dirty) saveTimer = setTimeout(autoSave, 3000);
    }
    $('titleInput').addEventListener('input', () => { if ($('setTitle')) $('setTitle').value = $('titleInput').value; triggerAutoSave(); });
    window.addEventListener('beforeunload', (e) => { if (dirty) { e.preventDefault(); e.returnValue = ''; } });

    // Pick up changes others saved, when there's nothing unsaved here.
    setInterval(async () => {
      if (dirty || document.hidden) return;
      try {
        const res = await fetch('/documents/content/' + DOC_ID);
        const data = await res.json();
        if (!data.success || data.data.updated_at === lastKnownUpdate) return;
        lastKnownUpdate = data.data.updated_at;
        if (data.data.content === lastSavedContent) return;
        if (IS_DOC) {
          const sel = quill.getSelection();
          loadDoc(data.data.content);
          if (sel) quill.setSelection(sel, 'silent');
          updateCounts();
        } else if (!document.activeElement || !document.activeElement.classList.contains('sheet-cell-input')) {
          loadSheet(data.data.content);
          renderSheet();
        } else return;
        lastSavedContent = data.data.content;
        if (document.activeElement !== $('titleInput')) $('titleInput').value = data.data.title;
      } catch (e) { /* try again next time */ }
    }, 8000);

    // ========== PANELS ==========
    function openPanel(id) {
      document.querySelectorAll('.ed-panel.is-open').forEach((p) => p.classList.remove('is-open'));
      $(id).classList.add('is-open');
      $('edBackdrop').hidden = false;
    }
    function closePanels() {
      document.querySelectorAll('.ed-panel.is-open').forEach((p) => p.classList.remove('is-open'));
      $('edBackdrop').hidden = true;
    }
    $('edBackdrop').addEventListener('click', closePanels);
    document.querySelectorAll('.ed-panel [data-close]').forEach((b) => b.addEventListener('click', closePanels));
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && !$('edBackdrop').hidden && !document.querySelector('.cd__menu:not([hidden])')) closePanels(); });

    // Dropdown with checkboxes: cd(host, { items, all, placeholder, search, onChange })
    function checkDrop(host, opts) {
      host.innerHTML = '<button type="button" class="cd__btn" aria-haspopup="true" aria-expanded="false"></button><div class="cd__menu" hidden>' +
        (opts.search ? '<input type="search" class="cd__search" placeholder="Search" aria-label="Search" />' : '') +
        '<label class="cd__opt cd__opt--all"><input type="checkbox" data-all /> <span>' + esc(opts.all) + '</span></label><div class="cd__list"></div></div>';
      const btn = host.querySelector('.cd__btn'), menu = host.querySelector('.cd__menu'), list = host.querySelector('.cd__list'), all = host.querySelector('[data-all]');
      let items = [];
      const boxes = () => Array.from(list.querySelectorAll('input'));
      function label() {
        const on = boxes().filter((b) => b.checked);
        btn.textContent = !on.length ? opts.placeholder : on.length === items.length ? opts.all : on.length <= 2 ? on.map((b) => b.dataset.label).join(', ') : on.length + ' selected';
        all.checked = on.length === items.length && items.length > 0;
        all.indeterminate = on.length > 0 && on.length < items.length;
      }
      function set(next) {
        items = next;
        list.innerHTML = items.map((it) => '<label class="cd__opt"><input type="checkbox" value="' + esc(it.value) + '" data-label="' + esc(it.label) + '"' + (it.checked ? ' checked' : '') + ' /> <span>' + esc(it.label) + '</span></label>').join('');
        label();
      }
      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        const open = menu.hidden;
        document.querySelectorAll('.cd__menu').forEach((m) => { m.hidden = true; m.previousElementSibling.setAttribute('aria-expanded', 'false'); });
        menu.hidden = !open;
        btn.setAttribute('aria-expanded', String(open));
        const s = host.querySelector('.cd__search');
        if (open && s) s.focus();
      });
      menu.addEventListener('click', (e) => e.stopPropagation());
      menu.addEventListener('change', (e) => {
        if (e.target === all) boxes().forEach((b) => { if (!b.closest('.cd__opt').hidden) b.checked = all.checked; });
        label();
        opts.onChange();
      });
      const s = host.querySelector('.cd__search');
      if (s) s.addEventListener('input', () => { const q = s.value.trim().toLowerCase(); boxes().forEach((b) => { b.closest('.cd__opt').hidden = !!q && b.dataset.label.toLowerCase().indexOf(q) === -1; }); });
      document.addEventListener('click', () => { menu.hidden = true; btn.setAttribute('aria-expanded', 'false'); });
      document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && !menu.hidden) { menu.hidden = true; btn.setAttribute('aria-expanded', 'false'); btn.focus(); } });
      return { set, values: () => boxes().filter((b) => b.checked).map((b) => b.value) };
    }

    <% if (canEdit) { %>
    // ----- Share -----
    $('openShare').addEventListener('click', () => openPanel('sharePanel'));
    const levelSelect = (level) => '<select aria-label="Access"><option value="view"' + (level === 'view' ? ' selected' : '') + '>View only</option><option value="comment"' + (level === 'comment' ? ' selected' : '') + '>Can comment</option><option value="edit"' + (level === 'edit' ? ' selected' : '') + '>Can edit</option></select>';
    const removeBtn = '<button type="button" class="ed-x" data-remove aria-label="Remove"><i class="fa-solid fa-xmark"></i></button>';
    function shareChanged() { $('shareNote').textContent = 'Unsaved changes'; $('permEmpty').hidden = !!document.querySelector('#permList .ed-person'); }
    $('addUserSelect').addEventListener('change', function () {
      if (!this.value) return;
      if (document.querySelector('#permList [data-user-id="' + this.value + '"]')) { toast('Already shared with this person.'); this.value = ''; return; }
      const opt = this.selectedOptions[0];
      const name = opt.textContent.trim();
      const li = document.createElement('li');
      li.className = 'ed-person';
      li.dataset.userId = this.value;
      li.innerHTML = '<span class="ed-av">' + esc(name.split(/\s+/).map((w) => w.charAt(0)).join('').slice(0, 2).toUpperCase()) + '</span><span class="ed-person__name">' + esc(name) + '<small>' + esc(opt.dataset.role || '') + '</small></span>' + levelSelect($('addUserLevel').value) + removeBtn;
      $('permList').prepend(li);
      this.value = '';
      shareChanged();
    });
    $('addClassSelect').addEventListener('change', function () {
      if (!this.value) return;
      if (document.querySelector('#classAssignList [data-class-id="' + this.value + '"]')) { toast('This class already has access.'); this.value = ''; return; }
      const li = document.createElement('li');
      li.className = 'ed-person';
      li.dataset.classId = this.value;
      li.innerHTML = '<span class="ed-av"><i class="fa-solid fa-chalkboard-user"></i></span><span class="ed-person__name">' + esc(this.selectedOptions[0].textContent.trim()) + '<small><label class="ed-chk"><input type="checkbox" class="incStudents"> Students too</label> <label class="ed-chk"><input type="checkbox" class="incSubjects"> Subject teachers</label></small></span>' + levelSelect('view') + removeBtn;
      $('classAssignList').prepend(li);
      this.value = '';
      shareChanged();
    });
    $('sharePanel').addEventListener('click', (e) => { const x = e.target.closest('[data-remove]'); if (x) { x.closest('.ed-person').remove(); shareChanged(); } });
    $('sharePanel').addEventListener('change', (e) => { if (e.target.closest('.ed-person')) shareChanged(); });
    $('saveShare').addEventListener('click', async () => {
      const permissions = Array.from(document.querySelectorAll('#permList .ed-person')).map((li) => ({ user_id: parseInt(li.dataset.userId, 10), permission_level: li.querySelector('select').value }));
      const classAssignments = Array.from(document.querySelectorAll('#classAssignList .ed-person')).map((li) => ({
        class_id: parseInt(li.dataset.classId, 10), permission_level: li.querySelector('select').value,
        include_students: li.querySelector('.incStudents').checked, include_subjects: li.querySelector('.incSubjects').checked,
      }));
      $('saveShare').disabled = true;
      $('shareNote').textContent = 'Saving…';
