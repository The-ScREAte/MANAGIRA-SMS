    [['setPage', 'page'], ['setSpacing', 'spacing'], ['setFontSize', 'size']].forEach(([id, key]) => $(id).addEventListener('change', function () {
      docSettings[key] = this.value; applyDocSettings(); triggerAutoSave();
    }));
    <% } else { %>
    [['setFreezeRow', 'freezeRow'], ['setFreezeCol', 'freezeCol'], ['setGrid', 'grid']].forEach(([id, key]) => $(id).addEventListener('change', function () {
      sheetSettings[key] = this.checked; renderSheet(); triggerAutoSave();
    }));
    $('setColWidth').addEventListener('change', function () { sheetSettings.colWidth = Number(this.value); renderSheet(); triggerAutoSave(); });
    $('setUnhide').addEventListener('click', unhideAll);
    syncSettingsPanel();
    <% } %>
    <% if (canInsert) { %>
    $('setCopy').addEventListener('click', async function () {
      this.disabled = true;
      try {
        const created = await fetch('/documents/create', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ title: 'Copy of ' + fileBase(), doc_type: IS_DOC ? 'document' : 'spreadsheet' }) }).then((r) => r.json());
        if (!created.success) throw new Error(created.message || 'failed');
        await fetch('/documents/save/' + created.documentId, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ content: currentContent(), title: 'Copy of ' + fileBase() }) });
        toast('Copy made — opening it');
        setTimeout(() => { location.href = '/documents/edit/' + created.documentId + '?returnUrl=' + encodeURIComponent(RETURN_URL); }, 600);
      } catch (e) { toast('Could not make a copy.'); this.disabled = false; }
    });
    $('setDelete').addEventListener('click', async function () {
      if (!confirm('Delete "' + fileBase() + '"? People it was shared with lose access.')) return;
      this.disabled = true;
      this.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Deleting…';
      try {
        const res = await fetch('/documents/delete/' + DOC_ID, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: '{}' });
        if (!res.ok) throw new Error('failed');
