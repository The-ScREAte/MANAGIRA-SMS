    <% if (canInsert) { %>
    // ----- Report card fields -----
    const fieldTag = (key) => '{{' + key + '}}';
    $('openFields').addEventListener('click', () => openPanel('fieldsPanel'));
    $('fieldSearch').addEventListener('input', function () {
      const q = this.value.trim().toLowerCase();
      document.querySelectorAll('#fieldList .ed-fgroup').forEach((g) => {
        let any = false;
        g.querySelectorAll('.ed-fld').forEach((f) => { const hit = !q || f.dataset.search.indexOf(q) !== -1; f.hidden = !hit; if (hit) any = true; });
        g.hidden = !any;
      });
    });
    const copyText = (text, note) => (navigator.clipboard ? navigator.clipboard.writeText(text) : Promise.reject()).then(() => toast(note || 'Copied'), () => toast('Could not copy'));
    $('fieldList').addEventListener('click', (e) => {
      const cp = e.target.closest('[data-copy-field]');
      if (cp) { copyText(fieldTag(cp.dataset.copyField), 'Copied ' + fieldTag(cp.dataset.copyField)); return; }
      const f = e.target.closest('[data-field]');
      if (!f) return;
