    // Sample report cards to start from.
    <% if (!isDoc) { %>
    // Nursery / lower primary card: crest on both sides, "please tick" skills,
    // a subject tick grid, results, remarks, school bills and signatures.
    function nurserySheet() {
      const cells = {}, st = {}, mg = [];
      const put = (id, v, style) => { if (v !== undefined && v !== null && v !== '') cells[id] = v; if (style) st[id] = Object.assign({}, st[id], style); };
      const range = (ref, fn) => { const [a, b] = ref.split(':'); const p = parseCellRef(a), q = parseCellRef(b || a); for (let i = p.r; i <= q.r; i++) for (let j = p.c; j <= q.c; j++) fn(cellId(i, j), i, j, p, q); };
      const merge = (ref) => { const [a, b] = ref.split(':'); const p = parseCellRef(a), q = parseCellRef(b); mg.push({ r: p.r, c: p.c, rs: q.r - p.r + 1, cs: q.c - p.c + 1 }); };
      const grid = (ref, extra) => range(ref, (id) => put(id, undefined, Object.assign({ bd: 'tblr' }, extra || {})));
      const outline = (ref) => put(ref.split(':')[0], undefined, { bd: 'tblr' }); // merged box: its first cell draws the frame
      const line = (ref) => range(ref, (id) => put(id, undefined, { bd: 'b' }));
      const lab = (id, text) => put(id, text, { b: 1, fs: 12 });
      const field = (ref, value, extra) => { const a = ref.split(':')[0]; put(a, value, Object.assign({ fs: 13 }, extra || {})); if (ref.includes(':')) merge(ref); line(ref); };
      // Header
      put('A1', '{{school.logo:85}}', { align: 'center' }); merge('A1:A3');
      put('B1', '{{school.name}}', { b: 1, u: 1, fs: 19, align: 'center' }); merge('B1:G1');
      put('H1', '{{school.logo:85}}', { align: 'center' }); merge('H1:H3');
      put('B2', 'Motto : {{school.motto}}', { b: 1, fs: 12 }); merge('B2:D2');
      put('E2', '{{school.address}}', { b: 1, fs: 12, align: 'right' }); merge('E2:G2');
      put('B3', 'Email : {{school.email}}', { b: 1, fs: 12 }); merge('B3:D3');
      put('E3', 'Contacts: {{school.phone}}', { b: 1, u: 1, fs: 12, align: 'right' }); merge('E3:G3');
      // Pupil
      lab('A5', 'NAME:'); field('B5:E5', '{{student.name}}', { b: 1 });
      lab('F5', 'CLASS:'); field('G5:H5', '{{student.class}}', { b: 1 });
      lab('A6', 'TERM:'); field('B6:C6', '{{term.name}}');
      lab('D6', 'DATE:'); field('E6', '{{report.date}}', { fs: 12 });
      lab('F6', 'NEXT TERM BEGINS:'); field('G6:H6', '{{term.next_begins}}');
      // Please tick (filled by hand on the printed card)
      put('A8', 'PLEASE TICK', { b: 1, align: 'center', bg: '#f1f5f9' }); merge('A8:D8');
      put('E8', 'YES', { b: 1, align: 'center', bg: '#f1f5f9' }); merge('E8:F8');
      put('G8', 'NO', { b: 1, align: 'center', bg: '#f1f5f9' }); merge('G8:H8');
      ['I CAN RECOGNIZE LETTER A-Z', 'I CAN RECOGNIZE NUMBERS', 'I CAN TAKE PART IN CLASS ACTIVITY', 'I DO MY WORK QUIETLY', 'I CAN CONVERSE WITH OTHERS', 'I RESPECT MY SENIORS AND TEACHERS'].forEach((t, i) => {
        const r = 9 + i;
        put('A' + r, t, { fs: 12 }); merge('A' + r + ':D' + r); merge('E' + r + ':F' + r); merge('G' + r + ':H' + r);
      });
      grid('A8:H14');
      put('A16', 'I CAN READ LETTERS FROM:', { b: 1, fs: 11 }); line('B16:D16'); merge('B16:D16'); put('E16', 'TO', { b: 1, align: 'center' }); line('F16:H16'); merge('F16:H16');
      put('A17', 'I CAN READ NUMBERS FROM:', { b: 1, fs: 11 }); line('B17:D17'); merge('B17:D17'); put('E17', 'TO', { b: 1, align: 'center' }); line('F17:H17'); merge('F17:H17');
      // Subjects: one row, repeated for every subject, ticked from the subject's remark
      put('A19', 'SUBJECT', { b: 1, bg: '#f1f5f9' }); merge('A19:B19');
      ['EXCELLENT', 'VERY GOOD', 'GOOD', 'PASS', 'WEAK', 'FAIL'].forEach((h, j) => put(cellId(18, 2 + j), h, { b: 1, align: 'center', bg: '#f1f5f9', fs: 10 }));
      put('A20', '{{subject.name}}', { fs: 12 }); merge('A20:B20');
      ['Excellent', 'Very Good', 'Good', 'Pass', 'Weak', 'Fail'].forEach((h, j) => put(cellId(19, 2 + j), '{{subject.mark:' + h + '}}', { align: 'center', b: 1, fs: 15 }));
      grid('A19:H20');
      // Results
      lab('A22', 'NUMBERS ON ROLL:'); field('B22', '{{student.class_size}}', { align: 'center' });
      lab('C22', 'POSITION:'); field('D22', '{{student.position}}', { align: 'center' });
      lab('E22', 'PROMOTED TO:'); merge('E22:F22'); field('G22:H22', '{{student.promoted_to}}');
      lab('A23', 'ATTENDANCE:'); field('B23', '{{attendance.present}}', { align: 'center' });
      lab('C23', 'OUT OF:'); field('D23', '{{attendance.total}}', { align: 'center' });
      lab('A25', 'CONDUCT:'); field('B25:E25', '{{remarks.conduct}}');
      lab('A26', 'REMARKS:'); field('B26:E26', '{{remarks.teacher}}');
      // School bills (amounts are typed in; arrears come from Paygira)
      put('G24', 'SCHOOL BILLS', { b: 1, align: 'center', bg: '#f1f5f9' }); merge('G24:H24');
      [['TUITION FEE', 'GHC 450.00'], ['FIRST AID', 'GHC 5.00'], ['P.T.A DUES', 'GHC 5.00'], ['SPORTS DUES', 'GHC 5.00'], ['MAINTENANCE', 'GHC 5.00'], ['ARREARS', '{{fees.outstanding}}'], ['TOTAL', '']].forEach(([l, v], i) => {
        const r = 25 + i;
        put('G' + r, l, { fs: 11, b: l === 'TOTAL' ? 1 : 0 });
        put('H' + r, v, { fs: 11, align: 'right', b: l === 'TOTAL' ? 1 : 0 });
      });
      grid('G24:H31');
      // Signatures
      merge('A28:B30'); outline('A28:B30');
      put('A31', "CLASS TEACHER'S SIGNATURE", { b: 1, align: 'center', fs: 11 }); merge('A31:B31'); outline('A31:B31');
      put('C28', '{{signature.image:55}}', { align: 'center' }); merge('C28:E30'); outline('C28:E30');
      put('C31', "HEAD TEACHER'S SIGNATURE", { b: 1, align: 'center', fs: 11 }); merge('C31:E31'); outline('C31:E31');
      put('A33', 'CANTEEN: GHC 10.00', { b: 1, fs: 15 }); merge('A33:C33');
      lab('A34', 'CLASS TEACHER CONTACT:'); line('B34:D34'); merge('B34:D34');
      return { cells, styles: st, merges: mg, colWidths: { 0: 190, 1: 80, 2: 82, 3: 82, 4: 82, 5: 82, 6: 105, 7: 95 }, rowCount: 40, colCount: 10, settings: { grid: true } };
    }

    function sampleSheet(kind) {
      if (kind === 'nursery') return nurserySheet();
      const cells = {}, st = {}, mg = [];
      const put = (id, v, style) => { if (v !== undefined && v !== null && v !== '') cells[id] = v; if (style) st[id] = Object.assign({}, st[id], style); };
      const merge = (ref) => { const [a, b] = ref.split(':'); const p = parseCellRef(a), q = parseCellRef(b); mg.push({ r: p.r, c: p.c, rs: q.r - p.r + 1, cs: q.c - p.c + 1 }); };
      const box = (ref, extra) => { const [a, b] = ref.split(':'); const p = parseCellRef(a), q = parseCellRef(b); for (let i = p.r; i <= q.r; i++) for (let j = p.c; j <= q.c; j++) put(cellId(i, j), undefined, Object.assign({ bd: 'tblr' }, extra || {})); };
      const line = (ref) => { const [a, b] = ref.split(':'); const p = parseCellRef(a), q = parseCellRef(b || a); for (let j = p.c; j <= q.c; j++) put(cellId(p.r, j), undefined, { bd: 'b' }); };
      const label = (id, text) => put(id, text, { b: 1, fs: 11 });
      const head = { b: 1, bg: '#e2e8f0', align: 'center', fs: 11 };
      // Header: logo, school details, photo
      put('A1', '{{school.logo:90}}', { align: 'center' }); merge('A1:A4');
      put('B1', '{{school.name}}', { b: 1, fs: 22, align: 'center' }); merge('B1:F1');
      put('B2', 'Motto: {{school.motto}}', { i: 1, align: 'center' }); merge('B2:F2');
      put('B3', '{{school.address}}  ·  {{school.phone}}  ·  {{school.email}}', { align: 'center', fs: 11 }); merge('B3:F3');
      put('B4', 'TERMLY REPORT  ·  {{term.name}}  ·  {{term.year}}', { b: 1, align: 'center', bg: '#e2e8f0' }); merge('B4:F4');
      put('G1', '{{student.photo:90}}', { align: 'center' }); merge('G1:G4');
      // Student
      label('A6', 'NAME:'); put('B6', '{{student.name}}'); merge('B6:D6'); line('B6:D6');
      label('E6', 'CLASS:'); put('F6', '{{student.class}}'); merge('F6:G6'); line('F6:G6');
      label('A7', 'STUDENT ID:'); put('B7', '{{student.id}}'); merge('B7:D7'); line('B7:D7');
      label('E7', 'NO. ON ROLL:'); put('F7', '{{student.class_size}}'); merge('F7:G7'); line('F7:G7');
      label('A8', 'TERM ENDS:'); put('B8', '{{term.ends}}'); merge('B8:D8'); line('B8:D8');
      label('E8', 'NEXT TERM BEGINS:'); put('F8', '{{term.next_begins}}'); merge('F8:G8'); line('F8:G8');
      let r = 10;
      if (kind === 'ticks') {
        ['SUBJECT', 'EXCELLENT', 'VERY GOOD', 'GOOD', 'PASS', 'WEAK', 'FAIL'].forEach((h, j) => put(cellId(r - 1, j), h, head));
        ['{{subject.name}}', '{{subject.mark:Excellent}}', '{{subject.mark:Very Good}}', '{{subject.mark:Good}}', '{{subject.mark:Pass}}', '{{subject.mark:Weak}}', '{{subject.mark:Fail}}'].forEach((v, j) => put(cellId(r, j), v, j ? { align: 'center', b: 1, fs: 15 } : null));
      } else {
        ['SUBJECT', 'CLASS SCORE', 'EXAM SCORE', 'TOTAL', 'GRADE', 'POSITION', 'REMARKS'].forEach((h, j) => put(cellId(r - 1, j), h, head));
        ['{{subject.name}}', '{{subject.class_score}}', '{{subject.exam_score}}', '{{subject.total}}', '{{subject.grade}}', '{{subject.position}}', '{{subject.remark}}'].forEach((v, j) => put(cellId(r, j), v, j ? { align: 'center' } : null));
      }
      box('A10:G11');
      // Results and attendance
      label('A13', 'POSITION:'); put('B13', '{{student.position_of}}'); merge('B13:C13'); line('B13:C13');
      label('D13', 'AVERAGE:'); put('E13', '{{student.average}}'); line('E13');
      label('F13', 'ATTENDANCE:'); put('G13', '{{attendance.present}} / {{attendance.total}}'); line('G13');
      label('A14', 'PROMOTED TO:'); put('B14', '{{student.promoted_to}}'); merge('B14:C14'); line('B14:C14');
      label('D14', 'AGGREGATE:'); put('E14', '{{student.grade_total}}'); line('E14');
      // Remarks
      [['A16', 'CONDUCT:', '{{remarks.conduct}}'], ['A17', 'INTEREST:', '{{remarks.interest}}'], ['A18', 'ATTITUDE:', '{{remarks.attitude}}'], ['A19', "TEACHER'S REMARKS:", '{{remarks.teacher}}']].forEach(([id, l, v]) => {
        const row = parseCellRef(id).r + 1;
        label(id, l); put('B' + row, v); merge('B' + row + ':G' + row); line('B' + row + ':G' + row);
      });
      // Bills and signature
      put('A21', 'SCHOOL BILLS', head); merge('A21:C21');
      [['Total billed', '{{fees.total_billed}}'], ['Total paid', '{{fees.total_paid}}'], ['Arrears', '{{fees.outstanding}}']].forEach(([l, v], i) => { put('A' + (22 + i), l); put('B' + (22 + i), v, { align: 'right' }); merge('B' + (22 + i) + ':C' + (22 + i)); });
      box('A21:C24');
      put('E21', 'HEAD TEACHER', head); merge('E21:G21');
      put('E22', '{{signature.image}}', { align: 'center' }); merge('E22:G23');
      put('E24', '{{signature.name}}  ·  {{signature.title}}', { align: 'center', fs: 11 }); merge('E24:G24');
      box('E21:G24');
      return { cells, styles: st, merges: mg, colWidths: { 0: 170, 1: 105, 2: 95, 3: 95, 4: 95, 5: 95, 6: 130 }, rowCount: 30, colCount: 10 };
    }
    document.querySelectorAll('[data-sample]').forEach((b) => b.addEventListener('click', () => {
      if (usedSize().rows && !confirm('Replace this sheet with the sample report card? You can undo this.')) return;
      replaceSheet(sampleSheet(b.dataset.sample));
      closePanels();
      toast('Sample report card added — change anything you like');
    }));
    <% } else { %>
    document.querySelectorAll('[data-sample]').forEach((b) => b.addEventListener('click', () => {
      if (quill.getLength() > 1 && !confirm('Replace this page with the sample report card? Undo brings it back.')) return;
      const ticks = b.dataset.sample === 'ticks';
      const subjectLine = ticks
        ? '<li><strong>{{subject.name}}</strong> — Excellent {{subject.mark:Excellent}} · Very good {{subject.mark:Very Good}} · Good {{subject.mark:Good}} · Pass {{subject.mark:Pass}}</li>'
        : '<li><strong>{{subject.name}}</strong> — total {{subject.total}}, grade {{subject.grade}}, position {{subject.position}} — {{subject.remark}}</li>';
      quill.setContents([], 'user');
      quill.clipboard.dangerouslyPasteHTML(0,
        '<p class="ql-align-center">{{school.logo:90}}</p><h1 class="ql-align-center">{{school.name}}</h1><p class="ql-align-center"><em>{{school.motto}}</em></p>' +
        '<p class="ql-align-center">{{school.address}} · {{school.phone}}</p><h2 class="ql-align-center">TERMLY REPORT · {{term.name}} · {{term.year}}</h2>' +
        '<p><strong>Name:</strong> {{student.name}}    <strong>Class:</strong> {{student.class}}    <strong>No. on roll:</strong> {{student.class_size}}</p>' +
        '<p><strong>Term ends:</strong> {{term.ends}}    <strong>Next term begins:</strong> {{term.next_begins}}</p><h3>Subjects</h3><ol>' + subjectLine + '</ol>' +
        '<p><strong>Position:</strong> {{student.position_of}}    <strong>Average:</strong> {{student.average}}    <strong>Attendance:</strong> {{attendance.present}} / {{attendance.total}}</p>' +
        '<p><strong>Promoted to:</strong> {{student.promoted_to}}</p><p><strong>Conduct:</strong> {{remarks.conduct}}</p><p><strong>Interest:</strong> {{remarks.interest}}</p>' +
        '<p><strong>Teacher’s remarks:</strong> {{remarks.teacher}}</p><p><strong>Bills:</strong> billed {{fees.total_billed}} · paid {{fees.total_paid}} · arrears {{fees.outstanding}}</p>' +
        '<p>{{signature.image}}</p><p>{{signature.name}} · {{signature.title}}</p>', 'user');
      closePanels();
      toast('Sample report card added — change anything you like');
    }));
    <% } %>

    // ----- Use as a report card -----
    const RT = JSON.parse($('rtData').textContent);
    const otherOf = new Map(RT.others.map((o) => [o.classId, o.title]));
    const rtClasses = checkDrop($('rtClasses'), { all: 'All classes', placeholder: 'Choose classes', search: true, onChange: () => {
      const moved = rtClasses.values().filter((id) => otherOf.has(id));
      $('rtMoveNote').textContent = moved.length ? moved.length + ' of these classes use another layout now (' + Array.from(new Set(moved.map((id) => otherOf.get(id)))).join(', ') + '). Saving moves them to this one.' : '';
      $('rtNote').textContent = 'Unsaved';
    } });
    rtClasses.set(JSON.parse($('insClassesData').textContent).map((c) => ({ value: c.value, label: c.label + (otherOf.has(c.value) ? ' — uses “' + otherOf.get(c.value) + '”' : ''), checked: RT.mine.includes(c.value) })));
    $('rtOn').addEventListener('change', function () { $('rtMore').hidden = !this.checked; $('rtNote').textContent = 'Unsaved'; });
    $('rtSave').addEventListener('click', async function () {
      const on = $('rtOn').checked, classIds = on ? rtClasses.values() : [];
      if (on && !classIds.length && !confirm('No classes chosen yet. Save it as a template anyway?')) return;
      this.disabled = true;
      $('rtNote').textContent = 'Saving…';
      try {
        const res = await fetch('/documents/reportTemplate/' + DOC_ID, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ enabled: on, classIds }) });
        const data = await res.json();
        if (!data.success) throw new Error(data.message);
        classIds.forEach((id) => otherOf.delete(id));
        document.querySelector('[data-dl-group]').hidden = on;
        document.body.classList.toggle('is-report-layout', on);
        document.querySelector('[data-dl-locked]').hidden = !on;
        $('rtMoveNote').textContent = '';
        $('rtNote').textContent = on ? (classIds.length ? 'Saved — ' + classIds.length + ' class' + (classIds.length === 1 ? '' : 'es') + ' use this report card' : 'Saved as a template') : 'Saved — classes use the standard report card';
        toast('Report card settings saved');
      } catch (e) { $('rtNote').textContent = (e && e.message) || 'Could not save. Try again.'; }
      this.disabled = false;
    });
    $('rtPreview').addEventListener('click', async () => {
      if (!RT.termId) { toast('Add a term first.'); return; }
      if (dirty) { clearTimeout(saveTimer); await autoSave(); }
      window.open('/print/printStudentReport?classId=' + encodeURIComponent($('rtPreviewClass').value) + '&termId=' + RT.termId + '&template=' + DOC_ID, '_blank', 'noopener');
    });
    <% } %>

    <% if (canInsert) { %>
    // ----- Insert school data -----
    const SOURCES = JSON.parse($('insSourcesData').textContent);
    const CLASS_ITEMS = JSON.parse($('insClassesData').textContent);
    let insData = null, insSeq = 0, insTimer = null;
    const sourceKey = () => (document.querySelector('input[name="insSource"]:checked') || {}).value;
    const classesDrop = checkDrop($('insClasses'), { all: 'All classes', placeholder: 'Choose classes', search: true, onChange: () => loadPreview() });
    const fieldsDrop = checkDrop($('insFields'), { all: 'All columns', placeholder: 'Choose columns', search: false, onChange: () => loadPreview() });
    classesDrop.set(CLASS_ITEMS.map((c) => ({ ...c, checked: true })));

    function setSource() {
      const src = SOURCES.find((s) => s.key === sourceKey()) || SOURCES[0];
      fieldsDrop.set(src.fields.map((f) => ({ value: f.key, label: f.label, checked: f.def })));
      $('insClassSec').hidden = !!src.noClasses;
      $('insTermSec').hidden = src.key === 'staff';
      loadPreview();
    }
    document.querySelectorAll('input[name="insSource"]').forEach((r) => r.addEventListener('change', setSource));
    $('insTerm').addEventListener('change', () => loadPreview());
    $('insHeader').addEventListener('change', renderPreview);

    function loadPreview() {
      clearTimeout(insTimer);
      insTimer = setTimeout(async () => {
        const seq = ++insSeq;
        const classes = classesDrop.values();
        const fields = fieldsDrop.values();
        $('insGo').disabled = true;
        if (!fields.length) { insData = null; $('insCount').textContent = '0'; $('insPreview').innerHTML = '<div class="ed-preview__msg">Choose at least one column.</div>'; return; }
        const src = SOURCES.find((s) => s.key === sourceKey());
        if (!src.noClasses && !classes.length) { insData = null; $('insCount').textContent = '0'; $('insPreview').innerHTML = '<div class="ed-preview__msg">Choose at least one class.</div>'; return; }
        $('insCount').textContent = '…';
        const qs = new URLSearchParams({ source: src.key, fields: fields.join(','), termId: $('insTerm').value || '' });
        if (!src.noClasses && classes.length < CLASS_ITEMS.length) qs.set('classIds', classes.join(','));
        try {
          const res = await fetch('/documents/classData?' + qs.toString());
          const data = await res.json();
          if (seq !== insSeq) return;
          if (!data.success) throw new Error(data.message || 'failed');
          insData = data;
          renderPreview();
        } catch (e) {
          if (seq !== insSeq) return;
          insData = null;
          $('insCount').textContent = '!';
          $('insPreview').innerHTML = '<div class="ed-preview__msg">Couldn’t load this data. Try again.</div>';
        }
      }, 150);
    }

    function renderPreview() {
      if (!insData) return;
      const rows = insData.rows || [], cols = insData.columns || [];
      $('insCount').textContent = rows.length + ' row' + (rows.length === 1 ? '' : 's');
      $('insPreview').innerHTML = rows.length
        ? '<table><thead><tr>' + cols.map((c) => '<th>' + esc(c) + '</th>').join('') + '</tr></thead><tbody>' + rows.slice(0, 8).map((r) => '<tr>' + r.map((v) => '<td>' + esc(v) + '</td>').join('') + '</tr>').join('') + '</tbody></table>' + (rows.length > 8 ? '<div class="ed-preview__msg" style="padding:8px">+ ' + (rows.length - 8) + ' more</div>' : '')
        : '<div class="ed-preview__msg">Nothing found for this term and these classes.</div>';
      $('insNote').textContent = insData.term ? insData.term : '';
      $('insGo').disabled = !rows.length;
    }

    $('openInsert').addEventListener('click', () => {
      <% if (!isDoc) { %>
      // Default start: the selected cell if it's empty, else the first empty row.
      const used = usedSize();
      const empty = !sheetData[selectedCell];
      const start = empty ? selectedCell : 'A' + (used.rows + (used.rows ? 2 : 1));
      $('insStart').value = start;
      $('insStartNote').textContent = empty ? '' : 'below your data';
      <% } %>
      openPanel('insertPanel');
      if (!insData) setSource();
    });

    $('insGo').addEventListener('click', () => {
      if (!insData || !insData.rows.length) return;
      const withHeader = $('insHeader').checked;
      const block = (withHeader ? [insData.columns] : []).concat(insData.rows.map((r) => r.map((v) => (v === null || v === undefined ? '' : String(v)))));
      <% if (isDoc) { %>
      const at = (quill.getSelection(true) || { index: quill.getLength() }).index;
      let pos = at;
      const put = (text, fmt) => { quill.insertText(pos, text, Object.assign({ bold: false }, fmt), 'user'); pos += text.length; };
      if (pos > 0 && quill.getText(pos - 1, 1) !== '\n') put('\n');
      if (withHeader && insData.columns.length > 1) { put(insData.columns.join('  ·  '), { bold: true }); put('\n'); }
      insData.rows.forEach((r) => {
        const vals = r.map((v) => (v === null || v === undefined ? '' : String(v)));
        put(vals[0] || '—', { bold: vals.length > 1 });
        if (vals.length > 1) put('  ·  ' + vals.slice(1).filter((v) => v !== '').join('  ·  '));
        quill.insertText(pos, '\n', { list: insData.columns.length > 1 ? 'bullet' : 'ordered' }, 'user'); pos += 1;
      });
      quill.setSelection(pos, 0, 'silent');
      <% } else { %>
      const p = parseCellRef($('insStart').value);
      if (!p) { toast('Type a start cell like A1.'); return; }
      let filled = 0;
      block.forEach((row, i) => row.forEach((v, j) => { if (sheetData[cellId(p.r + i, p.c + j)]) filled++; }));
      if (filled && !confirm(filled + ' cell' + (filled === 1 ? ' has' : 's have') + ' something in them and will be replaced. Continue?')) return;
      placeBlock(block, p.r, p.c, withHeader);
      <% } %>
      closePanels();
      toast('Inserted ' + insData.rows.length + ' row' + (insData.rows.length === 1 ? '' : 's'));
      triggerAutoSave();
    });
    <% } %>
  </script>
</body>
</html>
