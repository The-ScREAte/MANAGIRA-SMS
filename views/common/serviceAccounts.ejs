<link rel="stylesheet" href="<%= assetUrl('/css/reportPages.css') %>" />
<link rel="stylesheet" href="<%= assetUrl('/css/adminDrawer.css') %>" />
<link rel="stylesheet" href="<%= assetUrl('/css/apiAccess.css') %>" />

<div class="gp-page aa-page" id="serviceAccountsPage">
  <header class="aa-toolbar">
    <div>
      <h1 class="gp-title">Service Accounts</h1>
      <p class="gp-sub">Each integration signs in as a service account and can only read what its permissions allow.</p>
    </div>
    <div class="aa-toolbar__actions">
      <input class="aa-search" type="search" id="saSearch" placeholder="Search" aria-label="Search service accounts">
      <button type="button" class="aa-btn aa-btn--primary" id="saNew">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>
        New
      </button>
    </div>
  </header>

  <%- include('../partials/apiUsageBanner', { usage, requestHref: '/api-access/tokens?tab=usage&request=1&embed=workspace' }) %>
  <section class="gp-card aa-table-card">
    <table class="aa-table" id="saTable">
      <thead>
        <tr><th>Name</th><th>Can read</th><th>Agreement</th><th>Active tokens</th><th>Status</th><th class="aa-col-menu"><span class="aa-sr">Actions</span></th></tr>
      </thead>
      <tbody>
        <% accounts.forEach((a) => { %>
        <tr data-id="<%= a.id %>" data-search="<%= (a.name + ' ' + a.description).toLowerCase() %>" data-account="<%= JSON.stringify(a) %>" class="<%= a.status !== 'active' ? 'is-revoked' : '' %>">
          <td><span class="aa-strong"><%= a.name %></span><% if (a.description) { %><small class="aa-sub"><%= a.description %></small><% } %></td>
          <% const _granted = permissionOptions.filter((p) => a.permissions.includes(p.key)); %>
          <td><% if (_granted.length) { %><span class="aa-chips"><% _granted.forEach((p) => { %><span class="aa-chip<%= p.featureOff ? ' aa-chip--off' : '' %>" <%= p.featureOff ? 'title="Not turned on for this school"' : '' %>><%= p.label %></span><% }) %></span><% } else { %><span class="aa-muted">Nothing yet</span><% } %></td>
          <td><% if (a.agreementAcceptedAt) { %><span class="aa-agreed">Accepted <%= new Date(a.agreementAcceptedAt).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) %></span><small class="aa-sub">by <%= a.agreementAcceptedName || 'an administrator' %></small><% } else { %><span class="aa-chip aa-chip--off">Needed</span><% } %></td>
          <td><%= a.activeTokens %></td>
          <td><span class="aa-status aa-status--<%= a.status %>"><%= { active: 'Active', on_hold: 'On hold', revoked: 'Revoked' }[a.status] || a.status %></span></td>
          <td class="aa-col-menu">
            <% if (a.status !== 'revoked') { %>
            <button type="button" class="aa-kebab" data-menu aria-label="Actions for <%= a.name %>"><svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><circle cx="12" cy="5" r="2"/><circle cx="12" cy="12" r="2"/><circle cx="12" cy="19" r="2"/></svg></button>
            <% } %>
          </td>
        </tr>
        <% }) %>
      </tbody>
    </table>
    <p class="aa-empty" id="saEmpty" <%= accounts.length ? 'hidden' : '' %>>No service accounts yet. Create one for each integration that connects to Managira.</p>
  </section>

  <div class="aa-menu" id="saMenu" role="menu" hidden>
    <button type="button" role="menuitem" data-action="edit">Edit</button>
    <button type="button" role="menuitem" data-action="hold" data-when="active">Put on hold</button>
    <button type="button" role="menuitem" data-action="resume" data-when="on_hold">Turn back on</button>
    <button type="button" role="menuitem" data-action="revoke" class="aa-danger">Revoke</button>
  </div>

  <div class="mgr-drawer-overlay aa-drawer" id="saDrawer" aria-hidden="true">
    <form class="mgr-drawer" id="saForm" style="--mgr-drawer-width:520px" autocomplete="off">
      <div class="mgr-drawer-header">
        <h2 id="saDrawerTitle">New Service Account</h2>
        <button type="button" class="mgr-drawer-close" data-close aria-label="Close"><svg width="18" height="18" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M15 5L5 15M5 5l10 10" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg></button>
      </div>
      <div class="aa-drawer-body">
        <label class="aa-field">
          <span>Name <b aria-hidden="true">*</b></span>
          <input name="name" placeholder="e.g. Accounting sync" maxlength="120" required>
        </label>
        <label class="aa-field">
          <span>Description</span>
          <input name="description" placeholder="What this integration does (optional)" maxlength="255">
        </label>
        <fieldset class="aa-fieldset">
          <legend>Data it may read</legend>
          <p class="aa-hint">Tick only what the integration needs. Its access tokens can never read more. <button type="button" class="aa-linkbtn" id="saAll">Select all</button></p>
          <div class="aa-perms" id="saPerms">
            <% permissionOptions.filter((p) => !p.write).forEach((p) => { %>
            <label class="aa-check<%= p.featureOff ? ' is-off' : '' %>"><input type="checkbox" name="permissions" value="<%= p.key %>" <%= p.featureOff ? 'disabled' : '' %>> <span><strong><%= p.label %></strong><small><%= p.featureOff ? p.label + ' is not turned on for your school.' : p.description %></small></span></label>
            <% }) %>
          </div>
        </fieldset>
        <fieldset class="aa-fieldset">
          <legend>Information it may send in</legend>
          <p class="aa-hint">Leave these off for an integration that only reads. Each change it makes is in your activity log, marked as done by this service account.</p>
          <div class="aa-perms" id="saWrites">
            <% permissionOptions.filter((p) => p.write).forEach((p) => { %>
            <label class="aa-check<%= p.featureOff ? ' is-off' : '' %>"><input type="checkbox" name="permissions" value="<%= p.key %>" <%= p.featureOff ? 'disabled' : '' %>> <span><strong><%= p.label %></strong><small><%= p.featureOff ? p.label + ' is not turned on for your school.' : p.description %></small></span></label>
            <% }) %>
          </div>
        </fieldset>
        <fieldset class="aa-fieldset">
          <legend>Data-sharing agreement</legend>
          <details class="aa-agreement-box">
            <summary>Read the agreement (version <%= agreementVersion %>)</summary>
            <%- include('../partials/apiDataAgreement', { version: agreementVersion, schoolName }) %>
            <a class="aa-linkbtn" href="/api-access/agreement" target="_blank" rel="noopener">Open full page to print</a>
          </details>
          <label class="aa-check aa-agree"><input type="checkbox" name="agreement" value="yes" required> <span><strong>I accept the agreement for <%= schoolName %></strong><small>The school has a data-sharing agreement with this integration, and I'm authorised to accept on the school's behalf.</small></span></label>
        </fieldset>
        <p class="aa-error" id="saError" role="alert" hidden></p>
      </div>
      <div class="aa-drawer-footer">
        <button type="button" class="aa-btn aa-btn--ghost" data-close>Cancel</button>
        <button type="submit" class="aa-btn aa-btn--primary" id="saSubmit" disabled title="Accept the data-sharing agreement first">Create</button>
      </div>
    </form>
  </div>
</div>

<script src="<%= assetUrl('/js/apiAccess.js') %>"></script>
<script>
  (function () {
    const page = document.getElementById('serviceAccountsPage');
    if (!page || page.dataset.bound) return;
    page.dataset.bound = '1';
    const A = window.ApiAccessUI;
    const form = document.getElementById('saForm');
    const drawer = A.drawer(document.getElementById('saDrawer'));
    const error = document.getElementById('saError');
    let editing = null;
    // Create / Save stays off until the agreement is ticked.
    const submitBtn = document.getElementById('saSubmit');
    const syncAgree = () => { submitBtn.disabled = !form.agreement.checked; };
    form.agreement.addEventListener('change', syncAgree);
    document.getElementById('saAll').addEventListener('click', () => {
      document.querySelectorAll('#saPerms input[name="permissions"]:not(:disabled)').forEach((c) => { c.checked = true; });
    });

    function open(account) {
      editing = account || null;
      form.reset();
      error.hidden = true;
      document.getElementById('saDrawerTitle').textContent = account ? 'Edit Service Account' : 'New Service Account';
      document.getElementById('saSubmit').textContent = account ? 'Save' : 'Create';
      syncAgree();
      if (account) {
        form.name.value = account.name;
        form.description.value = account.description;
        form.querySelectorAll('input[name="permissions"]').forEach((c) => { c.checked = account.permissions.includes(c.value); });
      }
      drawer.open(form.name);
    }
    document.getElementById('saNew').addEventListener('click', () => open(null));

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      const body = {
        name: form.name.value,
        description: form.description.value,
        permissionMode: 'custom',
        permissions: [...form.querySelectorAll('input[name="permissions"]:checked')].map((c) => c.value),
        agreement: form.agreement.checked,
      };
      const result = await A.post(editing ? '/api-access/service-accounts/' + editing.id : '/api-access/service-accounts', body, document.getElementById('saSubmit'));
      if (!result.ok) { error.textContent = result.message; error.hidden = false; return; }
      window.location.reload();
    });

    // Hold, turn back on and revoke each need the person's password.
    const STEPS = {
      hold: { url: 'hold', title: (n) => 'Put "' + n + '" on hold?', text: 'Its integrations lose access straight away, including any connection already open. Nothing is deleted; you can turn it back on.', ok: 'Put on hold' },
      resume: { url: 'resume', title: (n) => 'Turn "' + n + '" back on?', text: 'Its tokens work again, for the data it is allowed to read.', ok: 'Turn back on' },
      revoke: { url: 'revoke', title: (n) => 'Revoke "' + n + '"?', text: 'It and its tokens stop working for good. This cannot be undone.', ok: 'Revoke', danger: true },
    };
    A.rowMenu(document.getElementById('saTable'), document.getElementById('saMenu'), async (action, row) => {
      const account = JSON.parse(row.dataset.account);
      if (action === 'edit') return open(account);
      const step = STEPS[action];
      if (!step) return;
      const done = await A.password({
        title: step.title(account.name),
        text: step.text,
        ok: step.ok,
        danger: step.danger,
        run: async (password) => {
          const result = await A.post('/api-access/service-accounts/' + account.id + '/' + step.url, { password });
          return result.ok ? null : result.message;
        },
      });
      if (done !== null) window.location.reload();
    }, (row, menu) => {
      const status = JSON.parse(row.dataset.account).status;
      menu.querySelectorAll('[data-when]').forEach((item) => { item.hidden = item.dataset.when !== status; });
    });
    A.search(document.getElementById('saSearch'), document.getElementById('saTable'));
  })();
</script>
