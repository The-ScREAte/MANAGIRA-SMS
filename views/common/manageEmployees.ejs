<head>
  <style>
    :root {
      --font-family: "<%= (session && session.fontStyle ? String(session.fontStyle).trim() : 'Inter') %>", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
      --primary: var(--org-primary-color, #01535b);
      --primary-hover: var(--org-primary-hover, #014a51);
        --primary-hover-fill: color-mix(in srgb, var(--primary) 88%, white);
      --text-primary: #1e293b;
      --text-secondary: #64748b;
      --border: #e2e8f0;
      --bg-page: #f8fafc;
      --bg-card: #ffffff;
      --success: #059669;
      --error: #dc2626;
    }

    body.manage-employees-page {
      font-family: var(--font-family);
      background: var(--bg-page);
    }

    .employees-page {
      max-width: 1200px;
      margin: 0 auto;
      padding: 24px 16px 60px;
    }

    .back-link {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 10px 20px;
      background: #fff;
      color: var(--primary);
      border: 2px solid var(--primary);
      text-decoration: none;
      border-radius: 8px;
      font-weight: 600;
      font-size: 0.9rem;
      transition: all 0.2s;
      margin-bottom: 20px;
    }

    .back-link:hover {
      background: var(--primary);
      color: white;
      transform: translateY(-1px);
    }

    .page-header-bar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 16px;
      margin-bottom: 24px;
      background: white;
      padding: 24px;
      border-radius: 12px;
      box-shadow: 0 2px 8px rgba(0,0,0,0.04);
      border: 1px solid var(--border);
    }

    .page-title {
      font-size: 1.5rem;
      font-weight: 700;
      color: var(--text-primary);
      margin: 0;
    }

    .add-btn {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 12px 24px;
      background: var(--primary);
      color: white;
      text-decoration: none;
      border-radius: 10px;
      font-weight: 600;
      font-size: 0.9rem;
      transition: all 0.2s;
      box-shadow: 0 2px 8px rgba(1, 83, 91, 0.2);
    }

    .add-btn:hover {
      background: var(--primary-hover-fill, var(--primary-hover));
      transform: translateY(-1px);
      box-shadow: 0 4px 12px rgba(1, 83, 91, 0.25);
    }

    .employees-table {
      width: 100%;
      background: var(--bg-card);
      border-radius: 12px;
      border: 1px solid var(--border);
      box-shadow: 0 2px 8px rgba(0,0,0,0.04);
      padding: 12px;
    }

    .employees-table table {
      width: 100%;
      border-collapse: collapse;
      background: white;
      border-radius: 10px;
      overflow: hidden;
    }

    .employees-table th,
    .employees-table td {
      padding: 16px 20px;
      text-align: left;
      border-bottom: 1px solid var(--border);
    }

    .employees-table th {
      background: #f8fafc;
      font-weight: 600;
      font-size: 0.8rem;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      color: var(--text-secondary);
    }

    .employees-table td {
      font-size: 0.95rem;
      color: var(--text-primary);
    }

    .employees-table tr:hover td {
      background: #f8fafc;
    }

    .employees-table tr:last-child td {
      border-bottom: none;
    }

    .status-badge {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 4px 10px;
      border-radius: 20px;
      font-size: 0.8rem;
      font-weight: 500;
    }

    .status-pending {
      background: #fef3c7;
      color: #d97706;
    }

    .status-active {
      background: #d1fae5;
      color: #059669;
    }

    .hold-badge {
      background: #fee2e2;
      color: #dc2626;
      padding: 4px 10px;
      border-radius: 20px;
      font-size: 0.75rem;
      font-weight: 600;
      margin-left: 8px;
    }

    .collapsible-btn {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 6px 12px;
      background: #f3f4f6;
      color: var(--text-primary);
      border: 1px solid var(--border);
      border-radius: 6px;
      font-size: 0.8rem;
      font-weight: 600;
      cursor: pointer;
      transition: all 0.2s;
    }

    .collapsible-btn:hover {
      background: #e5e7eb;
    }

    .collapsible-btn .arrow {
      transition: transform 0.2s;
    }

    .collapsible-content {
      background: #f8fafc;
      border-radius: 8px;
      padding: 12px 16px;
      margin-top: 8px;
      font-size: 0.9rem;
    }

    .collapsible-content ul {
      margin: 0;
      padding-left: 20px;
    }

    .collapsible-content li {
      padding: 4px 0;
    }

    @media (min-width: 901px) {
      .collapsible-content {
        margin-top: 0;
      }
    }

    .modify-link {
      display: inline-flex;
      align-items: center;
      gap: 4px;
      padding: 8px 16px;
      background: var(--success);
      color: white;
      text-decoration: none;
      border-radius: 6px;
      font-size: 0.85rem;
      font-weight: 600;
      transition: all 0.2s;
    }

    .modify-link:hover {
      background: #047857;
      transform: translateY(-1px);
    }

    @media (max-width: 900px) {
      .collapsible-btn {
        display: inline-flex;
      }

      .employees-table table,
      .employees-table thead,
      .employees-table tbody,
      .employees-table th,
      .employees-table td,
      .employees-table tr {
        display: block;
      }

      .employees-table thead {
        display: none;
      }

      .employees-table tr {
        margin-bottom: 16px;
        border: 1px solid var(--border);
        border-radius: 12px;
        padding: 16px;
        background: white;
      }

      .employees-table td {
        padding: 8px 0;
        border: none;
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
      }

      .employees-table td::before {
        content: attr(data-label);
        font-weight: 600;
        color: var(--text-secondary);
        font-size: 0.8rem;
        text-transform: uppercase;
        min-width: 100px;
      }
    }
  </style>
</head>
<body class="manage-employees-page">
  <%- include('../partials/flash') %>
  <div class="employees-page">

  <a href="/common/management#employees" class="back-link">
    <svg style="width:16px;height:16px;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
    </svg>
    Back
  </a>
  
  <div class="page-header-bar">
    <h1 class="page-title">👥 <%= title %></h1>
    <a href="/common/createEmployee" class="add-btn">➕ Add Employee</a>
  </div>

  <div class="employees-table">
    <table>
      <thead>
        <tr>
          <th>Status</th>
          <th>Name</th>
          <th>Email</th>
          <th>Role</th>
          <th>Permissions</th>
          <th>Classes</th>
          <th>Subjects</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody>
        <% employees.forEach((employee, idx) => { %>
        <tr>
          <td data-label="Status">
            <% if (employee.reset_password_token) { %>
              <span class="status-badge status-pending">⏳ Pending Setup</span>
            <% } else { %>
              <span class="status-badge status-active">✓ Active</span>
            <% } %>
          </td>
          <td data-label="Name"><strong><%= employee.first_name %> <%= employee.last_name %></strong></td>
          <td data-label="Email"><%= employee.email %></td>
          <td data-label="Role"><%= employee.account_type %></td>
          <td data-label="Permissions">
            <button type="button" class="collapsible-btn" onclick="toggleEmployeeCollapse('permissions', '<%= idx %>')">
              View <span class="arrow" id="arrow-permissions-<%= idx %>">▸</span>
            </button>
            <div class="collapsible-content" id="collapse-permissions-<%= idx %>" style="display:none;">
              <% if (employee.account_type === 'Manager') { %>
                <span>All permissions (manager-level access)</span>
              <% } else if ((employee.permissions || []).length > 0) { %>
                <ul>
                  <% (employee.permissions || []).forEach(permissionKey => { %>
                  <li><%= (permissionLabelMap && permissionLabelMap[permissionKey]) ? permissionLabelMap[permissionKey] : permissionKey %></li>
                  <% }); %>
                </ul>
              <% } else { %>
                <span>None</span>
              <% } %>
            </div>
          </td>
          <td data-label="Classes">
            <button type="button" class="collapsible-btn" onclick="toggleEmployeeCollapse('classes', '<%= idx %>')">
              View <span class="arrow" id="arrow-classes-<%= idx %>">▸</span>
            </button>
            <div class="collapsible-content" id="collapse-classes-<%= idx %>" style="display:none;">
              <% if ((employee.classes || []).length > 0) { %>
                <ul>
                  <% (employee.classes || []).forEach(cls => { %>
                  <li><%= cls.class_name %></li>
                  <% }); %>
                </ul>
              <% } else { %>
                <span>None</span>
              <% } %>
            </div>
          </td>
          <td data-label="Subjects">
            <button type="button" class="collapsible-btn" onclick="toggleEmployeeCollapse('subjects', '<%= idx %>')">
              View <span class="arrow" id="arrow-subjects-<%= idx %>">▸</span>
            </button>
            <div class="collapsible-content" id="collapse-subjects-<%= idx %>" style="display:none;">
              <% if ((employee.classes || []).length > 0) { %>
                <% (employee.classes || []).forEach(cls => { %>
                  <div style="margin-bottom:8px;">
                    <strong><%= cls.class_name %>:</strong>
                    <% if ((cls.subjects || []).length > 0) { %>
                      <ul>
                        <% (cls.subjects || []).forEach(sub => { %>
                        <li><%= sub.subject_name %></li>
                        <% }); %>
                      </ul>
                    <% } else { %>
                      <div>None</div>
                    <% } %>
                  </div>
                <% }); %>
              <% } else { %>
                <span>None</span>
              <% } %>
            </div>
          </td>
          <td data-label="Actions">
            <a href="/common/modifyEmployee?userId=<%= employee.user_id %>" class="modify-link">✏️ Modify</a>
            <% if (employee.on_hold) { %>
            <span class="hold-badge">ON HOLD</span>
            <% } %>
          </td>
        </tr>
        <% }); %>
      </tbody>
    </table>
  </div>

  <script>
    function toggleEmployeeCollapse(type, idx) {
      const collapseDiv = document.getElementById('collapse-' + type + '-' + idx);
      const arrow = document.getElementById('arrow-' + type + '-' + idx);
      if (collapseDiv && arrow) {
        if (collapseDiv.style.display === 'none') {
          collapseDiv.style.display = 'block';
          arrow.innerHTML = '▾';
        } else {
          collapseDiv.style.display = 'none';
          arrow.innerHTML = '▸';
        }
      }
    }
  </script>
  </div>
</body>
