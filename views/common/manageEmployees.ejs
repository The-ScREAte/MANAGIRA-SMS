<head>
  <style>
    :root {
      --font-family: "<%= (session && session.fontStyle ? String(session.fontStyle).trim() : 'Inter') %>", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
      --primary: var(--org-primary-color, #01535b);
      --primary-hover: var(--org-primary-hover, #014a51);
        --primary-hover-fill: color-mix(in srgb, var(--primary) 88%, white);
      --text-primary: #1e293b;
      --text-secondary: #64748b;
      --border: #e2e8f0;
      --bg-page: #f8fafc;
      --bg-card: #ffffff;
      --success: #059669;
      --error: #dc2626;
    }

    body.manage-employees-page {
      font-family: var(--font-family);
      background: var(--bg-page);
    }

    .employees-page {
      max-width: none;
      margin: 0;
      width: 100%;
      box-sizing: border-box;
      padding: 24px 24px 60px;
    }

    .page-header-bar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 16px;
      margin-bottom: 24px;
      background: white;
      padding: 24px;
      border-radius: 12px;
      box-shadow: 0 2px 8px rgba(0,0,0,0.04);
      border: 1px solid var(--border);
    }

    .page-title {
      font-size: 1.5rem;
      font-weight: 700;
      color: var(--text-primary);
      margin: 0;
    }

    .add-btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 6px;
      min-height: 30px;
      padding: 5px 8px;
      background: #fff;
      color: var(--primary);
      border: 2px solid var(--primary);
      text-decoration: none;
      border-radius: 8px;
      font-weight: 700;
      font-size: 0.72rem;
      cursor: pointer;
      white-space: nowrap;
      flex: 0 0 auto;
      width: auto;
      transition: none;
    }

    .add-btn:hover {
      background: #fff;
      color: var(--primary);
      transform: none;
      box-shadow: none;
    }

    /* ---- Add Employee drawer (AJAX, same slide-in-from-right pattern
       used by the Assessment Question Sets "Set Questions" panel) ---- */
    .emp-modal-overlay {
      position: fixed;
      inset: 0;
      background: rgba(10, 20, 30, 0.55);
      backdrop-filter: blur(3px);
      display: none;
      z-index: 10000;
      animation: empFadeIn 0.2s ease;
    }
    .emp-modal-overlay.is-open {
      display: flex;
      align-items: stretch;
      justify-content: flex-end;
    }
    .emp-modal {
      position: relative;
      width: 100%;
      max-width: 1160px;
      height: 100%;
      min-height: 100%;
      max-height: 100%;
      background: linear-gradient(180deg, #f8fbff 0%, #eef4fa 100%);
      display: flex;
      flex-direction: column;
      box-shadow: -8px 0 40px rgba(0, 0, 0, 0.18);
      animation: empSlideInRight 0.28s cubic-bezier(0.22, 1, 0.36, 1);
      overflow: hidden;
    }
    @keyframes empSlideInRight {
      from { transform: translateX(100%); opacity: 0; }
      to   { transform: translateX(0);    opacity: 1; }
    }
    @keyframes empFadeIn {
      from { opacity: 0; }
      to   { opacity: 1; }
    }
    .emp-modal-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: calc(13px + env(safe-area-inset-top, 0px)) 18px 12px;
      background: #fff;
      border-bottom: 1px solid #e2e8f0;
      flex-shrink: 0;
      gap: 12px;
    }
    .emp-modal-header-left { display: flex; align-items: center; gap: 10px; }
    .emp-modal-header-icon {
      width: 34px;
      height: 34px;
      background: linear-gradient(135deg, var(--primary) 0%, #0a7a86 100%);
      border-radius: 10px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 15px;
      flex-shrink: 0;
    }
    .emp-modal-header h2 { margin: 0; font-size: 0.95rem; font-weight: 700; color: #0f2d32; }
    .emp-modal-header p { margin: 0; font-size: 0.72rem; color: #64748b; }
    .emp-modal-close {
      width: 32px;
      height: 32px;
      border-radius: 8px;
      border: 1px solid #e2e8f0;
      background: #fff;
      color: #64748b;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: all 0.15s;
      flex-shrink: 0;
    }
    .emp-modal-close:hover { background: #fef2f2; border-color: #fca5a5; color: #dc2626; }
    .emp-modal-body { flex: 1; position: relative; overflow: hidden; }
    .emp-modal-iframe { width: 100%; height: 100%; border: none; display: block; }
    .emp-modal-loading {
      position: absolute;
      inset: 0;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      color: #475569;
      font-size: 0.85rem;
    }
    .emp-modal-spinner {
      width: 16px;
      height: 16px;
      border: 2px solid rgba(1, 83, 91, 0.25);
      border-top-color: var(--primary);
      border-radius: 50%;
      animation: empSpin 0.7s linear infinite;
      flex-shrink: 0;
    }
    @keyframes empSpin { to { transform: rotate(360deg); } }
    @media (max-width: 500px) {
      .emp-modal-overlay { padding: 0; }
      .emp-modal { border-radius: 0; }
    }

    /* ---- Modify Employee drawer (AJAX, same slide-in-from-right pattern
       as the Add Employee drawer above) ---- */
    .mfe-modal-overlay {
      position: fixed;
      inset: 0;
      background: rgba(10, 20, 30, 0.55);
      backdrop-filter: blur(3px);
      display: none;
      z-index: 10000;
      animation: empFadeIn 0.2s ease;
    }
    .mfe-modal-overlay.is-open {
      display: flex;
      align-items: stretch;
      justify-content: flex-end;
    }
    .mfe-modal {
      position: relative;
      width: 100%;
      max-width: 1060px;
      height: 100%;
      min-height: 100%;
      max-height: 100%;
      background: linear-gradient(180deg, #f8fbff 0%, #eef4fa 100%);
      display: flex;
      flex-direction: column;
      box-shadow: -8px 0 40px rgba(0, 0, 0, 0.18);
      animation: empSlideInRight 0.28s cubic-bezier(0.22, 1, 0.36, 1);
      overflow: hidden;
    }
    .mfe-modal-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: calc(13px + env(safe-area-inset-top, 0px)) 18px 12px;
      background: #fff;
      border-bottom: 1px solid #e2e8f0;
      flex-shrink: 0;
      gap: 12px;
    }
    .mfe-modal-header-left { display: flex; align-items: center; gap: 10px; }
    .mfe-modal-header-icon {
      width: 34px;
      height: 34px;
      background: linear-gradient(135deg, var(--primary) 0%, #0a7a86 100%);
      border-radius: 10px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 15px;
      flex-shrink: 0;
    }
    .mfe-modal-header h2 { margin: 0; font-size: 0.95rem; font-weight: 700; color: #0f2d32; }
    .mfe-modal-header p { margin: 0; font-size: 0.72rem; color: #64748b; }
    .mfe-modal-close {
      width: 32px;
      height: 32px;
      border-radius: 8px;
      border: 1px solid #e2e8f0;
      background: #fff;
      color: #64748b;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: all 0.15s;
      flex-shrink: 0;
    }
    .mfe-modal-close:hover { background: #fef2f2; border-color: #fca5a5; color: #dc2626; }
    .mfe-modal-body { flex: 1; position: relative; overflow: hidden; }
    .mfe-modal-iframe { width: 100%; height: 100%; border: none; display: block; }
    .mfe-modal-loading {
      position: absolute;
      inset: 0;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      color: #475569;
      font-size: 0.85rem;
    }
    .mfe-modal-spinner {
      width: 16px;
      height: 16px;
      border: 2px solid rgba(1, 83, 91, 0.25);
      border-top-color: var(--primary);
      border-radius: 50%;
      animation: empSpin 0.7s linear infinite;
      flex-shrink: 0;
    }
    @media (max-width: 500px) {
      .mfe-modal-overlay { padding: 0; }
      .mfe-modal { border-radius: 0; }
    }

    .employees-table {
      width: 100%;
      background: var(--bg-card);
      border-radius: 12px;
      border: 1px solid var(--border);
      box-shadow: 0 2px 8px rgba(0,0,0,0.04);
      padding: 12px;
    }

    .employees-table table {
      width: 100%;
      border-collapse: collapse;
      background: white;
      border-radius: 10px;
      overflow: hidden;
    }

    .employees-table th,
    .employees-table td {
      padding: 16px 20px;
      text-align: left;
      border-bottom: 1px solid var(--border);
    }

    .employees-table th {
      background: #f8fafc;
      font-weight: 600;
      font-size: 0.8rem;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      color: var(--text-secondary);
    }

    .employees-table td {
      font-size: 0.95rem;
      color: var(--text-primary);
    }

    .employees-table tr:hover td {
      background: #f8fafc;
    }

    .employees-table tr:last-child td {
      border-bottom: none;
    }

    .status-badge {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 4px 10px;
      border-radius: 20px;
      font-size: 0.8rem;
      font-weight: 500;
    }

    .status-pending {
      background: #fef3c7;
      color: #d97706;
    }

    .status-active {
      background: #d1fae5;
      color: #059669;
    }

    .hold-badge {
      background: #fee2e2;
      color: #dc2626;
      padding: 4px 10px;
      border-radius: 20px;
      font-size: 0.75rem;
      font-weight: 600;
      margin-left: 8px;
    }

    .collapsible-btn {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 6px 12px;
      background: #f3f4f6;
      color: var(--text-primary);
      border: 1px solid var(--border);
      border-radius: 6px;
      font-size: 0.8rem;
      font-weight: 600;
      cursor: pointer;
      transition: all 0.2s;
    }

    .collapsible-btn:hover {
      background: #e5e7eb;
    }

    .collapsible-btn .arrow {
      transition: transform 0.2s;
    }

    .collapsible-content {
      background: #f8fafc;
      border-radius: 8px;
      padding: 12px 16px;
      margin-top: 8px;
      font-size: 0.9rem;
    }

    .collapsible-content ul {
      margin: 0;
      padding-left: 20px;
    }

    .collapsible-content li {
      padding: 4px 0;
    }

    @media (min-width: 901px) {
      .collapsible-content {
        margin-top: 0;
      }
    }

    .modify-link {
      display: inline-flex;
      align-items: center;
      gap: 4px;
      padding: 8px 16px;
      background: var(--success);
      color: white;
      text-decoration: none;
      border: none;
      border-radius: 6px;
      font-size: 0.85rem;
      font-weight: 600;
      font-family: inherit;
      cursor: pointer;
      transition: all 0.2s;
    }

    .modify-link:hover {
      background: #047857;
      transform: translateY(-1px);
    }

    @media (max-width: 900px) {
      .collapsible-btn {
        display: inline-flex;
      }

      .employees-table table,
      .employees-table thead,
      .employees-table tbody,
      .employees-table th,
      .employees-table td,
      .employees-table tr {
        display: block;
      }

      .employees-table thead {
        display: none;
      }

      .employees-table tr {
        margin-bottom: 16px;
        border: 1px solid var(--border);
        border-radius: 12px;
        padding: 16px;
        background: white;
      }

      .employees-table td {
        padding: 8px 0;
        border: none;
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
      }

      .employees-table td::before {
        content: attr(data-label);
        font-weight: 600;
        color: var(--text-secondary);
        font-size: 0.8rem;
        text-transform: uppercase;
        min-width: 100px;
      }
    }

    @media (max-width: 640px) {
      .employees-page {
        padding: 14px 10px 40px;
      }

      .page-header-bar {
        padding: 14px;
        gap: 10px;
      }

      .page-title {
        font-size: 1.15rem;
      }

      .modify-link {
        padding: 7px 12px;
        font-size: 0.8rem;
      }
    }
  </style>
</head>
<body class="manage-employees-page">
  <%- include('../partials/flash') %>
  <div class="employees-page">

  <div class="page-header-bar">
    <h1 class="page-title">👥 <%= title %></h1>
    <button type="button" class="add-btn" title="Add new employee" onclick="openAddEmployeeModal()">Add Employee</button>
  </div>

  <div class="employees-table">
    <table>
      <thead>
        <tr>
          <th>Status</th>
          <th>Name</th>
          <th>Email</th>
          <th>Role</th>
          <th>Permissions</th>
          <th>Classes</th>
          <th>Subjects</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody>
        <% employees.forEach((employee, idx) => { %>
        <tr>
          <td data-label="Status">
            <% if (employee.reset_password_token) { %>
              <span class="status-badge status-pending">⏳ Pending Setup</span>
            <% } else { %>
              <span class="status-badge status-active">✓ Active</span>
            <% } %>
          </td>
          <td data-label="Name"><strong><%= (typeof formatDisplayName === 'function' ? formatDisplayName(employee) : [employee.first_name, employee.last_name].filter(Boolean).join(' ').trim()) %></strong></td>
          <td data-label="Email"><%= employee.email %></td>
          <td data-label="Role"><%= employee.account_type %></td>
          <td data-label="Permissions">
            <button type="button" class="collapsible-btn" onclick="toggleEmployeeCollapse('permissions', '<%= idx %>')">
              View <span class="arrow" id="arrow-permissions-<%= idx %>">▸</span>
            </button>
            <div class="collapsible-content" id="collapse-permissions-<%= idx %>" style="display:none;">
              <% if (employee.account_type === 'Manager') { %>
                <span>All permissions (manager-level access)</span>
              <% } else if ((employee.permissions || []).length > 0) { %>
                <ul>
                  <% (employee.permissions || []).forEach(permissionKey => { %>
                  <li><%= (permissionLabelMap && permissionLabelMap[permissionKey]) ? permissionLabelMap[permissionKey] : permissionKey %></li>
                  <% }); %>
                </ul>
              <% } else { %>
                <span>None</span>
              <% } %>
            </div>
          </td>
          <td data-label="Classes">
            <button type="button" class="collapsible-btn" onclick="toggleEmployeeCollapse('classes', '<%= idx %>')">
              View <span class="arrow" id="arrow-classes-<%= idx %>">▸</span>
            </button>
            <div class="collapsible-content" id="collapse-classes-<%= idx %>" style="display:none;">
              <% if ((employee.classes || []).length > 0) { %>
                <ul>
                  <% (employee.classes || []).forEach(cls => { %>
                  <li><%= cls.class_name %></li>
                  <% }); %>
                </ul>
              <% } else { %>
                <span>None</span>
              <% } %>
            </div>
          </td>
          <td data-label="Subjects">
            <button type="button" class="collapsible-btn" onclick="toggleEmployeeCollapse('subjects', '<%= idx %>')">
              View <span class="arrow" id="arrow-subjects-<%= idx %>">▸</span>
            </button>
            <div class="collapsible-content" id="collapse-subjects-<%= idx %>" style="display:none;">
              <% if ((employee.classes || []).length > 0) { %>
                <% (employee.classes || []).forEach(cls => { %>
                  <div style="margin-bottom:8px;">
                    <strong><%= cls.class_name %>:</strong>
                    <% if ((cls.subjects || []).length > 0) { %>
                      <ul>
                        <% (cls.subjects || []).forEach(sub => { %>
                        <li><%= sub.subject_name %></li>
                        <% }); %>
                      </ul>
                    <% } else { %>
                      <div>None</div>
                    <% } %>
                  </div>
                <% }); %>
              <% } else { %>
                <span>None</span>
              <% } %>
            </div>
          </td>
          <td data-label="Actions">
            <button type="button" class="modify-link" onclick="openModifyEmployeeModal('<%= employee.user_id %>')">✏️ Modify</button>
            <% if (employee.on_hold) { %>
            <span class="hold-badge">ON HOLD</span>
            <% } %>
          </td>
        </tr>
        <% }); %>
      </tbody>
    </table>
  </div>

  <div class="emp-modal-overlay" id="empModalOverlay" aria-hidden="true">
    <div class="emp-modal">
      <div class="emp-modal-header">
        <div class="emp-modal-header-left">
          <div class="emp-modal-header-icon">👥</div>
          <div>
            <h2 id="empModalTitle">Add Employee</h2>
            <p>Create a new employee account</p>
          </div>
        </div>
        <button type="button" class="emp-modal-close" id="empModalClose" title="Close">
          <svg width="18" height="18" viewBox="0 0 20 20" fill="none">
            <path d="M15 5L5 15M5 5l10 10" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
          </svg>
        </button>
      </div>
      <div class="emp-modal-body">
        <div class="emp-modal-loading" id="empModalLoading">
          <span class="emp-modal-spinner" aria-hidden="true"></span>
          Loading…
        </div>
        <iframe class="emp-modal-iframe" id="empModalIframe" title="Add Employee" style="display:none;"></iframe>
      </div>
    </div>
  </div>

  <div class="mfe-modal-overlay" id="mfeModalOverlay" aria-hidden="true">
    <div class="mfe-modal">
      <div class="mfe-modal-header">
        <div class="mfe-modal-header-left">
          <div class="mfe-modal-header-icon">✏️</div>
          <div>
            <h2 id="mfeModalTitle">Modify Employee</h2>
            <p>Edit this employee's details</p>
          </div>
        </div>
        <button type="button" class="mfe-modal-close" id="mfeModalClose" title="Close">
          <svg width="18" height="18" viewBox="0 0 20 20" fill="none">
            <path d="M15 5L5 15M5 5l10 10" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
          </svg>
        </button>
      </div>
      <div class="mfe-modal-body">
        <div class="mfe-modal-loading" id="mfeModalLoading">
          <span class="mfe-modal-spinner" aria-hidden="true"></span>
          Loading…
        </div>
        <iframe class="mfe-modal-iframe" id="mfeModalIframe" title="Modify Employee" style="display:none;"></iframe>
      </div>
    </div>
  </div>

  <script>
    function toggleEmployeeCollapse(type, idx) {
      const collapseDiv = document.getElementById('collapse-' + type + '-' + idx);
      const arrow = document.getElementById('arrow-' + type + '-' + idx);
      if (collapseDiv && arrow) {
        if (collapseDiv.style.display === 'none') {
          collapseDiv.style.display = 'block';
          arrow.innerHTML = '▾';
        } else {
          collapseDiv.style.display = 'none';
          arrow.innerHTML = '▸';
        }
      }
    }

    /* ---- Add Employee drawer (AJAX, no page navigation) ---- */
    let empModalIframeLoaded = false;
    let empModalDirty = false;

    function openAddEmployeeModal() {
      const overlay = document.getElementById('empModalOverlay');
      const iframe = document.getElementById('empModalIframe');
      const loading = document.getElementById('empModalLoading');
      if (!overlay || !iframe) return;

      if (!empModalIframeLoaded) {
        iframe.addEventListener('load', function onLoad() {
          empModalIframeLoaded = true;
          if (loading) loading.style.display = 'none';
          iframe.style.display = 'block';
        });
        iframe.src = '/common/createEmployee?embed=workspace';
      }

      overlay.classList.add('is-open');
      overlay.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
    }

    function closeAddEmployeeModal() {
      const overlay = document.getElementById('empModalOverlay');
      if (!overlay) return;
      overlay.classList.remove('is-open');
      overlay.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';

      // createEmployee.ejs redirects back to itself after a successful
      // save instead of navigating here, so it posts a message to us
      // instead. Only refresh the list if that actually happened; a plain
      // cancel/close shouldn't reload anything.
      if (empModalDirty) {
        empModalDirty = false;
        window.location.reload();
      }
    }

    window.addEventListener('message', function (event) {
      if (event.origin !== window.location.origin) return;
      if (event.data && event.data.managiraDrawerSaved) {
        empModalDirty = true;
      }
    });

    document.getElementById('empModalClose').addEventListener('click', closeAddEmployeeModal);
    document.getElementById('empModalOverlay').addEventListener('click', function (event) {
      if (event.target === this) closeAddEmployeeModal();
    });
    document.addEventListener('keydown', function (event) {
      if (event.key !== 'Escape') return;
      const overlay = document.getElementById('empModalOverlay');
      if (overlay && overlay.classList.contains('is-open')) closeAddEmployeeModal();
    });

    /* ---- Modify Employee drawer (AJAX, no page navigation) ---- */
    function openModifyEmployeeModal(userId) {
      const overlay = document.getElementById('mfeModalOverlay');
      const iframe = document.getElementById('mfeModalIframe');
      const loading = document.getElementById('mfeModalLoading');
      if (!overlay || !iframe) return;

      // Each row edits a different employee, so unlike the Add Employee
      // drawer this one reloads its iframe fresh on every open instead of
      // caching a single load.
      iframe.style.display = 'none';
      if (loading) loading.style.display = 'flex';

      iframe.onload = function onLoad() {
        // modifyEmployee.ejs redirects itself to manageEmployees on a
        // successful save — when that happens inside our iframe, the
        // change is already saved, so close the drawer and refresh the
        // list instead of showing the list page a second time inside itself.
        let path = null;
        try { path = iframe.contentWindow.location.pathname; } catch (err) { /* cross-origin, ignore */ }
        if (path === '/common/manageEmployees') {
          window.location.reload();
          return;
        }

        if (loading) loading.style.display = 'none';
        iframe.style.display = 'block';
      };
      iframe.src = '/common/modifyEmployee?userId=' + encodeURIComponent(userId) + '&embed=workspace';

      overlay.classList.add('is-open');
      overlay.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
    }

    function closeModifyEmployeeModal() {
      const overlay = document.getElementById('mfeModalOverlay');
      if (!overlay) return;
      overlay.classList.remove('is-open');
      overlay.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
    }

    document.getElementById('mfeModalClose').addEventListener('click', closeModifyEmployeeModal);
    document.getElementById('mfeModalOverlay').addEventListener('click', function (event) {
      if (event.target === this) closeModifyEmployeeModal();
    });
    document.addEventListener('keydown', function (event) {
      if (event.key !== 'Escape') return;
      const overlay = document.getElementById('mfeModalOverlay');
      if (overlay && overlay.classList.contains('is-open')) closeModifyEmployeeModal();
    });
  </script>
  </div>
</body>
