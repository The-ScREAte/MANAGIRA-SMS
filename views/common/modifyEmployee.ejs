<style>
  body {
    min-height: 100%;
    padding-bottom: 100px;
    box-sizing: border-box;
  }

    .flash-message {
        text-align: center;
        margin-bottom: 20px;
        padding: 10px;
        border-radius: 5px;
    }
    .flash-success {
        background-color: #d4edda;
        color: #155724;
    }
    .flash-error {
        background-color: #f8d7da;
        color: #721c24;
    }
    .link-button {
      text-align: left;
        margin-bottom: 20px;
    }
    .link-button a {
        display: inline-block;
      padding: 7px 12px;
      font-size: 0.9rem;
      font-weight: 600;
        background-color: var(--org-primary-color);
        color: #fff;
        text-decoration: none;
        border-radius: 5px;
        transition: background-color 0.3s ease;
    }
    .link-button a:hover {
        background-color: var(--org-primary-hover-fill, var(--org-primary-hover));
    }
    .separator {
        border-bottom: 1px solid #ccc;
        margin: 20px 0;
    }
  
    /* Add these new styles */
    .class-container {
      margin-bottom: 10px;
    }
    .subject-container {
      margin-left: 0;
    }
    .modify-employee-card {
        max-width: 1180px;
        margin: 28px auto;
        background: #fff;
        border-radius: 14px;
        box-shadow: 0 8px 30px rgba(15, 23, 42, 0.08);
        border: 1px solid #e2e8f0;
        padding: 30px;
        display: flex;
        flex-direction: column;
        gap: 16px;
    }
    .modify-employee-card form {
        width: 100%;
    }
    .employee-edit-form {
      display: flex;
      flex-direction: column;
      gap: 18px;
    }
    .employee-fields-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 14px 18px;
      width: 100%;
    }
    .employee-section {
      width: 100%;
    }
    .modify-employee-card label {
        display: block;
        font-weight: bold;
        margin-bottom: 6px;
        width: 100%;
        text-align: left;
    }
    .modify-employee-card input[type="text"],
    .modify-employee-card input[type="email"],
    .modify-employee-card input[type="date"],
    .modify-employee-card select {
        padding: 8px;
        width: 100%;
        border: 1px solid #ccc;
        border-radius: 4px;
        margin-bottom: 18px;
        box-sizing: border-box;
    }
    .modify-employee-card .btn {
        display: inline-flex;
        margin: 0;
      width: auto;
      max-width: 100%;
      min-height: 32px;
      padding: 6px 10px;
        align-items: center;
        justify-content: center;
        border: 1px solid transparent;
        border-radius: 8px;
        font-weight: 600;
      font-size: 0.84rem;
      white-space: nowrap;
    }
    .modify-employee-card .btn.btn-primary {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
    }
    /* Flat, full-bleed toolbar fixed to the bottom of the drawer's own
       viewport — deliberately NOT styled as a rounded/bordered card like
       .modify-employee-card above it, so it reads as a persistent action
       dock rather than a second floating card sitting on the page background. */
    .employee-actions-bar {
      position: fixed;
      left: 0;
      right: 0;
      bottom: 0;
      z-index: 50;
      background: #fff;
      border-top: 1px solid #e2e8f0;
      box-shadow: 0 -8px 20px rgba(15, 23, 42, 0.06);
      padding: 6px 14px calc(6px + env(safe-area-inset-bottom, 0px));
    }

    .employee-actions-row {
      display: flex;
      justify-content: flex-start !important;
      flex-wrap: nowrap;
      gap: 8px;
      align-items: center;
      overflow-x: auto;
      max-width: 1180px;
      margin: 0 auto;
    }
    .employee-actions-row > * {
      flex: 0 0 auto !important;
    }
    /* manageClassSubjectAndGradYr.css ships a global `form { margin-top:
       10px; }` rule that leaks onto every <form> on every page, including
       these action buttons — pin margin-top to 0 here so it can't push
       Hold Employee/Delete out of line with Save Changes again. */
    .employee-action-form {
      width: auto !important;
      display: inline-flex !important;
      align-items: center;
      flex: 0 0 auto !important;
      margin-top: 0 !important;
    }
    .employee-action-form .btn {
      height: 34px;
      padding: 0 10px;
    }
    /* All three actions (Save, Hold, Delete) share one look — white with a
       border in the org's theme color, and the same fixed height — so they
       read as one aligned, consistent button group. */
    .employee-actions-row .btn {
      background-color: #fff !important;
      color: var(--org-primary-color) !important;
      border: 1.5px solid var(--org-primary-color) !important;
      box-shadow: none !important;
      height: 34px;
      margin: 0;
      font-size: 0.84rem;
    }
    .employee-actions-row .btn:hover {
      background-color: var(--org-primary-soft, rgba(1, 83, 91, 0.08)) !important;
    }
    #saveEmployeeBtn {
      width: auto;
      min-width: 0;
      flex: 0 0 auto;
      padding: 0 10px;
      height: 34px;
    }
    .employee-save-btn-text {
      white-space: nowrap;
    }
    .btn-icon-only {
      width: 34px !important;
      min-width: 34px;
      padding: 0;
    }
    .btn-icon-only svg {
      width: 16px;
      height: 16px;
    }
    .employee-save-spinner {
      width: 14px;
      height: 14px;
      border: 2px solid rgba(255, 255, 255, 0.35);
      border-top-color: #fff;
      border-radius: 50%;
      display: none;
      animation: employeeSaveSpin 0.75s linear infinite;
    }
    .btn.btn-primary.is-saving .employee-save-spinner {
      display: inline-block;
    }
    .btn.btn-primary.is-saving {
      opacity: 0.85;
      cursor: wait;
    }
    .employee-save-status {
      min-height: 20px;
      margin-top: 10px;
      color: #475569;
      font-size: 0.9rem;
      text-align: center;
    }
    .employee-save-status.success {
      color: #166534;
      font-weight: 600;
    }
    .employee-save-status.error {
      color: #b91c1c;
      font-weight: 600;
    }
    @keyframes employeeSaveSpin {
      to {
      transform: rotate(360deg);
      }
    }
    .modify-employee-card .btn-danger {
        background-color: var(--btn-danger-bg, #dc2626);
        color: var(--btn-danger-text, #fff);
        border-color: var(--btn-danger-bg, #dc2626);
    }
    .modify-employee-card .btn-danger:hover {
      background-color: #b91c1c;
      border-color: #b91c1c;
    }
    .employee-actions-row .employee-delete-action {
      display: inline-flex !important;
      align-items: center !important;
      justify-content: center !important;
      width: 34px !important;
      min-width: 34px !important;
      height: 34px !important;
      padding: 0 !important;
      opacity: 1 !important;
      visibility: visible !important;
    }
    .employee-actions-row .employee-delete-action svg {
      display: block;
      width: 16px;
      height: 16px;
      stroke: var(--org-primary-color);
    }
    .modify-employee-card .btn-warning {
        background-color: var(--btn-warning-bg, #f59e0b);
        color: var(--btn-warning-text, #fff);
        border-color: var(--btn-warning-bg, #f59e0b);
    }
    .modify-employee-card .btn-warning:hover {
      background-color: #d97706;
      border-color: #d97706;
    }
    .collapsible-btn {
        width: 100%;
        background: #eaf2f7;
        color: #0f3f49;
        border: 1px solid #c7d8e2;
        outline: none;
        padding: 10px 14px;
        font-size: 14px;
        font-weight: 600;
        text-align: left;
        display: flex;
        align-items: center;
        justify-content: space-between;
        cursor: pointer;
        border-radius: 10px;
        margin-bottom: 6px;
        transition: background-color 0.2s ease, border-color 0.2s ease;
    }
    .collapsible-btn:hover,
    .collapsible-btn:focus {
      background: #dceaf2;
      border-color: #b2c8d6;
      color: #0f3f49;
      box-shadow: none;
    }

    .employee-section-classes {
      background: #f8fbfd;
      border: 1px solid #e2e8f0;
      border-radius: 12px;
      padding: 14px;
    }
    .class-selector-panel {
      width: 100%;
    }
    .classes-master-toggle {
      margin-bottom: 10px;
      display: inline-flex;
    }
    .classes-grid-wrap {
      width: 100%;
    }
    .classes-grid {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 12px;
    }
    .class-card {
      background: #fff;
      border: 1px solid #d8e3ea;
      border-radius: 12px;
      padding: 10px;
      box-shadow: 0 2px 6px rgba(15, 23, 42, 0.04);
    }
    .class-card-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 10px;
      margin-bottom: 8px;
    }
    .class-name-row {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      margin: 0;
      font-size: 0.92rem;
      color: #1f2937;
      font-weight: 600;
      cursor: pointer;
    }
    .class-name-row input {
      margin: 0;
    }
    .subject-toggle-btn {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      border: 1px solid #d1dbe2;
      border-radius: 999px;
      background: #f8fbfd;
      color: #274a5a;
      padding: 5px 10px;
      font-size: 0.78rem;
      font-weight: 600;
      cursor: pointer;
      transition: background-color 0.2s ease;
    }
    .subject-toggle-btn:hover {
      background: #e7f0f6;
    }
    .subjects-panel {
      border-top: 1px solid #edf2f6;
      padding-top: 8px;
    }
    .subject-grid {
      display: grid;
      grid-template-columns: 1fr;
      gap: 6px;
    }
    .subject-item {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 6px 8px;
      border: 1px solid #e5edf3;
      border-radius: 8px;
      background: #fbfdff;
      font-size: 0.85rem;
      color: #334155;
      cursor: pointer;
    }
    .collapsible-btn .arrow {
        font-size: 18px;
        margin-left: 8px;
        transition: transform 0.2s;
    }

    @media (max-width: 1100px) {
      .classes-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }
    }

    @media (max-width: 960px) {
      .modify-employee-card {
        padding: 18px;
      }
      .employee-fields-grid {
        grid-template-columns: 1fr;
      }
      .employee-actions-bar {
        padding: 8px 14px calc(8px + env(safe-area-inset-bottom, 0px));
      }
    }

    @media (max-width: 768px) {
      .link-button {
        padding-top: 72px;
      }
      .classes-grid {
        grid-template-columns: 1fr;
      }
      .btn-icon-only {
        width: 32px !important;
        min-width: 32px;
      }
      .modify-employee-card .btn {
        min-height: 30px;
        padding: 5px 8px;
        font-size: 0.8rem;
      }
    }
  </style>
  
</head>
<body>
<div class="modify-employee-card">
  <form id="modifyEmployeeForm" class="employee-edit-form" action="/common/modifyEmployee/<%= user.user_id %><%= (typeof isEmbedded !== 'undefined' && isEmbedded) ? '?embed=workspace' : '' %>" method="post">
    <div class="employee-fields-grid">
      <div>
        <label for="firstName">First Name:</label>
        <input type="text" name="firstName" value="<%= user.first_name %>">
      </div>
      <div>
        <label for="lastName">Last Name:</label>
        <input type="text" name="lastName" value="<%= user.last_name %>">
      </div>
      <div>
        <label for="email">Email:</label>
        <input type="email" name="email" value="<%= user.email %>">
      </div>
      <div>
        <label for="dateOfBirth">Date of Birth:</label>
        <input type="date" name="dateOfBirth" value="<%= user.date_of_birth ? new Date(user.date_of_birth).toISOString().slice(0, 10) : '' %>">
      </div>
      <div>
        <label for="accountType">Role:</label>
        <select name="accountType">
            <option value="">-- Select Role --</option>
            <option value="Manager" <%= user.account_type === 'Manager' ? 'selected' : '' %>>Manager</option>
            <option value="Supervisor" <%= user.account_type === 'Supervisor' ? 'selected' : '' %>>Supervisor</option>
            <option value="Teacher" <%= user.account_type === 'Teacher' ? 'selected' : '' %>>Teacher</option>
            <option value="Driver" <%= user.account_type === 'Driver' ? 'selected' : '' %>>Driver</option>
        </select>
      </div>
    </div>
    <div id="permission-assignment-group" class="employee-section">
      <label>Optional Extra Permissions:</label>
      <div style="border:1px solid #e2e8f0; background:#f8fafc; border-radius:8px; padding:12px; margin-top:8px;">
        <div style="display:grid; grid-template-columns: 1fr 1fr; gap:10px 16px;">
          <% (permissionOptions || []).forEach(function(permission) { %>
            <label style="display:flex; align-items:center; gap:8px; font-size:14px;" class="permission-item" data-permission-key="<%= permission.key %>">
              <input
                type="checkbox"
                name="permissions"
                value="<%= permission.key %>"
                <%= (selectedPermissions || []).includes(permission.key) ? 'checked' : '' %>
              >
              <span><%= permission.label %></span>
            </label>
          <% }) %>
        </div>
        <%# Kept as they are: permissions held for features the plan doesn't show now. %>
        <% (typeof hiddenHeldPermissions !== 'undefined' ? hiddenHeldPermissions : []).forEach(function(key) { %>
          <input type="hidden" name="permissions" value="<%= key %>">
        <% }) %>
        <div style="margin-top:8px; color:#64748b; font-size:12px;" id="permissionsNote">Permissions are pre-selected based on role. You can add or remove any. High-risk permissions (Billing, Settings) require a Manager account.</div>
        <div style="margin-top:8px; color:#64748b; font-size:12px; display:none;" id="driverPermissionsNote">Drivers use the Driver dashboard for their routes and riders. They do not get school-management access, so no permissions are set here.</div>

        <div id="mailroomScopePanel" style="display:none; margin-top:12px; padding:12px 14px; background:#fff; border:1px solid #e2e8f0; border-radius:8px;">
          <div style="font-size:12.5px; font-weight:700; color:#1e293b; margin-bottom:8px;">Mailroom contact access</div>
          <label style="display:flex; align-items:center; gap:7px; font-size:13.5px; color:#1e293b; margin-bottom:6px;">
            <input type="radio" name="mailroomScope" value="all" <%= mailroomScope !== 'classes' ? 'checked' : '' %>>
            All contacts (every class)
          </label>
          <label style="display:flex; align-items:center; gap:7px; font-size:13.5px; color:#1e293b; margin-bottom:6px;">
            <input type="radio" name="mailroomScope" value="classes" <%= mailroomScope === 'classes' ? 'checked' : '' %>>
            Only guardians of students in selected classes
          </label>
          <div id="mailroomClassesGrid" style="display:none; grid-template-columns:1fr 1fr; gap:8px 14px; margin:8px 0 0 22px; padding-top:8px; border-top:1px dashed #e2e8f0;">
            <% classes.forEach(cls => { %>
            <label style="display:flex; align-items:center; gap:6px; font-size:12.5px; color:#475569;">
              <input type="checkbox" name="mailroomClassIds" value="<%= cls.class_id %>" <%= (enrolledMailroomClasses || []).includes(cls.class_id) ? 'checked' : '' %>>
              <%= cls.class_name %>
            </label>
            <% }); %>
          </div>
        </div>
      </div>
    </div>
    <div class="employee-section employee-section-classes">
      <label>Classes and Subjects:</label>
      <p style="color:#64748b; font-size:12px; margin: 4px 0 0; display:none;" id="driverSubjectsNote">Drivers can be assigned classes (e.g. routes they cover) but are never assigned subjects.</p>
      <div class="class-selector-panel">
        <button type="button" class="collapsible-btn classes-master-toggle" onclick="toggleClassCollapse('all-classes')">
          <span>Show/Hide Classes</span>
          <span class="arrow" id="arrow-all-classes">&#9654;</span>
        </button>
        <div class="class-checkboxes classes-grid-wrap" id="collapse-all-classes" style="display: none;">
          <div class="classes-grid">
            <% classes.forEach(cls => { %>
              <div class="class-container class-card">
                <div class="class-card-header">
                  <label class="class-name-row">
                    <input type="checkbox" name="classIds[]" value="<%= cls.class_id %>" <%= enrolledClasses.includes(cls.class_id) ? 'checked' : '' %>>
                    <span><%= cls.class_name %></span>
                  </label>
                  <button type="button" class="subject-toggle-btn" onclick="toggleClassCollapse('subjects-<%= cls.class_id %>')">
                    <span>Subjects</span>
                    <span class="arrow" id="arrow-subjects-<%= cls.class_id %>">&#9654;</span>
                  </button>
                </div>
                <div class="class-checkboxes subjects-panel" id="collapse-subjects-<%= cls.class_id %>" style="display: none;">
                  <div class="subject-container subject-grid">
                    <% if (cls.subjects && cls.subjects.length > 0) { %>
                      <% cls.subjects.forEach(sub => { %>
                        <label class="subject-item">
                          <input type="checkbox" name="subjects[]" value="<%= sub.subject_id %>" <%= enrolledSubjects.includes(sub.subject_id) ? 'checked' : '' %>>
                          <span><%= sub.subject_name %></span>
                        </label>
                      <% }); %>
                    <% } else { %>
                      <div style="color:#888; margin:10px 0; font-size:0.85rem;">No subjects have been assigned to this class.</div>
                    <% } %>
                  </div>
                </div>
              </div>
            <% }); %>
          </div>
        </div>
      </div>
    </div>
  </form>
</div>

<div class="employee-actions-bar">
  <div class="employee-actions-row">
    <button type="submit" form="modifyEmployeeForm" class="btn btn-primary" id="saveEmployeeBtn">
      <span class="employee-save-spinner" aria-hidden="true"></span>
      <span class="employee-save-btn-text">Save Changes</span>
    </button>
    <form class="employee-action-form" action="/common/toggleHoldEmployee/<%= user.user_id %>" method="post">
      <button type="submit" class="btn btn-warning"><%= user.on_hold ? 'Resume Employee' : 'Hold Employee' %></button>
    </form>
    <form class="employee-action-form" action="/common/deleteEmployee/<%= user.user_id %>" method="post" onsubmit="return confirm('Remove this user from the school?\n\nThey won\'t be able to sign in and leave the staff lists. Everything they did (attendance, scores, payments, documents) is kept.\n\nTo bring them back: Users > Status: Removed > select them > Enable.');">
      <button type="submit" class="btn btn-danger btn-icon-only employee-delete-action" aria-label="Remove user" title="Remove user (records are kept)">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <polyline points="3 6 5 6 21 6"></polyline>
          <path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"></path>
          <path d="M10 11v6"></path>
          <path d="M14 11v6"></path>
          <path d="M9 6V4h6v2"></path>
        </svg>
      </button>
    </form>
  </div>
</div>

<script id="role-default-permissions-data" type="application/json"><%- JSON.stringify(roleDefaultPermissionsMap || {}) %></script>
<script id="current-saved-permissions-data" type="application/json"><%- JSON.stringify(selectedPermissions || []) %></script>

<script>
    function toggleClassCollapse(id) {
      const collapseDiv = document.getElementById('collapse-' + id);
      const arrow = document.getElementById('arrow-' + id);
      if (collapseDiv && arrow) {
        if (collapseDiv.style.display === 'none') {
          collapseDiv.style.display = 'block';
          arrow.innerHTML = '&#9660;';
        } else {
          collapseDiv.style.display = 'none';
          arrow.innerHTML = '&#9654;';
        }
      }
    }

    document.addEventListener("DOMContentLoaded", () => {
      const pendingSpaCacheClear = sessionStorage.getItem("managira:clear-spa-cache") === "1";
      if (pendingSpaCacheClear) {
        const clearSpaCache = () => {
          if (window.spaRouter && typeof window.spaRouter.clearCache === "function") {
            window.spaRouter.clearCache();
          }
        };
        clearSpaCache();
        window.addEventListener("load", clearSpaCache, { once: true });
        sessionStorage.removeItem("managira:clear-spa-cache");
      }

      const accountTypeSelect = document.querySelector("select[name='accountType']");
      const permissionGroup = document.getElementById("permission-assignment-group");
      const roleDefaultsData = document.getElementById("role-default-permissions-data");
      const currentPermissionsData = document.getElementById("current-saved-permissions-data");

      // Role → default permission keys (injected from server)
      const ROLE_DEFAULT_PERMISSIONS_MAP = roleDefaultsData ? JSON.parse(roleDefaultsData.textContent || "{}") : {};
      const CURRENT_SAVED_PERMISSIONS = currentPermissionsData ? JSON.parse(currentPermissionsData.textContent || "[]") : [];

      // On role change: reset checkboxes to that role's defaults.
      // The user can still customise before saving.
      const applyRoleDefaults = (role) => {
        const defaults = ROLE_DEFAULT_PERMISSIONS_MAP[role] || [];
        document.querySelectorAll('input[name="permissions"]').forEach(cb => {
          cb.checked = defaults.includes(cb.value);
        });
      };

      const permissionsNote = document.getElementById("permissionsNote");
      const driverPermissionsNote = document.getElementById("driverPermissionsNote");
      const driverSubjectsNote = document.getElementById("driverSubjectsNote");

      // Drivers only ever get "Manage Students" and are never assigned
      // subjects — hide the inapplicable UI instead of merely defaulting it.
      const applyDriverModeUI = (isDriver) => {
        document.querySelectorAll('input[name="permissions"]').forEach((cb) => {
          const item = cb.closest(".permission-item");
          if (isDriver) {
            const allowed = cb.value === "manage_students";
            if (item) item.style.display = allowed ? "" : "none";
            cb.checked = allowed;
          } else if (item) {
            item.style.display = "";
          }
        });
        if (permissionsNote) permissionsNote.style.display = isDriver ? "none" : "block";
        if (driverPermissionsNote) driverPermissionsNote.style.display = isDriver ? "block" : "none";
        if (driverSubjectsNote) driverSubjectsNote.style.display = isDriver ? "block" : "none";

        document.querySelectorAll(".subject-toggle-btn").forEach((btn) => {
          btn.style.display = isDriver ? "none" : "";
        });
        if (isDriver) {
          document.querySelectorAll('input[name="subjects[]"]').forEach((cb) => {
            cb.checked = false;
          });
          document.querySelectorAll(".subjects-panel").forEach((panel) => {
            panel.style.display = "none";
          });
        }
      };

      const syncPermissionVisibility = () => {
        if (!accountTypeSelect || !permissionGroup) return;
        permissionGroup.style.display = "block";
      };

      // Mailroom's contact-scope sub-panel only matters once "Mailroom" is
      // checked, and the class picker only matters once "classes" scope is
      // chosen — keep both hidden otherwise so the form stays uncluttered.
      const mailroomScopePanel = document.getElementById("mailroomScopePanel");
      const mailroomClassesGrid = document.getElementById("mailroomClassesGrid");
      const syncMailroomScopePanel = () => {
        if (!mailroomScopePanel) return;
        const mailroomCheckbox = document.querySelector('input[name="permissions"][value="mailroom"]');
        const isMailroomChecked = Boolean(mailroomCheckbox && mailroomCheckbox.checked);
        mailroomScopePanel.style.display = isMailroomChecked ? "block" : "none";
        const classesRadio = mailroomScopePanel.querySelector('input[name="mailroomScope"][value="classes"]');
        if (mailroomClassesGrid) {
          mailroomClassesGrid.style.display = isMailroomChecked && classesRadio && classesRadio.checked ? "grid" : "none";
        }
      };
      document.addEventListener("change", (e) => {
        if (e.target.matches('input[name="permissions"][value="mailroom"], input[name="mailroomScope"]')) {
          syncMailroomScopePanel();
        }
      });

      if (accountTypeSelect) {
        accountTypeSelect.addEventListener("change", (e) => {
          syncPermissionVisibility();
          applyRoleDefaults(e.target.value);
          applyDriverModeUI(e.target.value === "Driver");
          syncMailroomScopePanel();
        });
      }
      syncPermissionVisibility();
      applyDriverModeUI(accountTypeSelect && accountTypeSelect.value === "Driver");

      if (accountTypeSelect && accountTypeSelect.value && accountTypeSelect.value !== "Driver") {
        document.querySelectorAll('input[name="permissions"]').forEach(cb => {
          cb.checked = CURRENT_SAVED_PERMISSIONS.includes(cb.value);
        });
      }
      syncMailroomScopePanel();

      const collapseAllClasses = document.getElementById('collapse-all-classes');
      const arrowAllClasses = document.getElementById('arrow-all-classes');
      if (collapseAllClasses && arrowAllClasses) {
        collapseAllClasses.style.display = 'block';
        arrowAllClasses.innerHTML = '&#9660;';
      }

      document.querySelectorAll('input[name="classIds[]"]').forEach(classCheckbox => {
        const collapseSubjects = document.getElementById('collapse-subjects-' + classCheckbox.value);
        const arrowSubjects = document.getElementById('arrow-subjects-' + classCheckbox.value);
        if (collapseSubjects && arrowSubjects) {
          collapseSubjects.style.display = 'none';
          arrowSubjects.innerHTML = '&#9654;';
          classCheckbox.addEventListener('change', function() {
            if (this.checked) {
              collapseSubjects.style.display = 'block';
              arrowSubjects.innerHTML = '&#9660;';
            } else {
              collapseSubjects.style.display = 'none';
              arrowSubjects.innerHTML = '&#9654;';
            }
          });
        }
      });

      const saveButton = document.getElementById("saveEmployeeBtn");
      const saveStatus = document.getElementById("employeeSaveStatus");

      const setEmployeeSavingState = (isSaving, statusText, statusType) => {
        if (saveButton) {
          saveButton.disabled = isSaving;
          saveButton.classList.toggle("is-saving", isSaving);
        }

        if (saveStatus) {
          saveStatus.textContent = statusText || "";
          saveStatus.classList.remove("success", "error");
          if (statusType === "success") {
            saveStatus.classList.add("success");
          }
          if (statusType === "error") {
            saveStatus.classList.add("error");
          }
        }
      };

      // Confirmation dialog + async save with spinner
      const modifyForm = document.querySelector("form[action^='/common/modifyEmployee']");
      if (modifyForm) {
        modifyForm.addEventListener("submit", async function (e) {
          e.preventDefault();

          if (saveButton && saveButton.disabled) {
            return;
          }

          const confirmed = confirm("Are you sure you want to apply these changes?");
          if (!confirmed) {
            return;
          }

          // Mark that SPA cache should be purged on the next page load,
          // ensuring header/menu access state is rebuilt from fresh server HTML.
          sessionStorage.setItem("managira:clear-spa-cache", "1");

          setEmployeeSavingState(true, "Saving employee changes. Please wait...");

          try {
            const formData = new FormData(modifyForm);
            const payload = new URLSearchParams();
            formData.forEach((value, key) => {
              payload.append(key, value);
            });

            const response = await fetch(modifyForm.action, {
              method: "POST",
              headers: {
                "Content-Type": "application/x-www-form-urlencoded;charset=UTF-8",
                Accept: "application/json",
                "X-Requested-With": "XMLHttpRequest",
              },
              body: payload.toString(),
            });

            const result = await response.json().catch(() => ({}));

            if (!response.ok || !result.success) {
              throw new Error(result.error || "Failed to save employee changes.");
            }

            window.location.href = "/common/manageEmployees";
          } catch (error) {
            setEmployeeSavingState(false, error.message || "An unexpected error occurred.", "error");
          }
        });
      }
    });
</script>