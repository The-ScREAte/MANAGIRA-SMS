<style>
  body {
    min-height: 100%;
  }

    .flash-message {
        text-align: center;
        margin-bottom: 20px;
        padding: 10px;
        border-radius: 5px;
    }
    .flash-success {
        background-color: #d4edda;
        color: #155724;
    }
    .flash-error {
        background-color: #f8d7da;
        color: #721c24;
    }
    .link-button {
        text-align: center;
        margin-bottom: 20px;
    }
    .link-button a {
        display: inline-block;
        padding: 10px 20px;
        background-color: var(--org-primary-color);
        color: #fff;
        text-decoration: none;
        border-radius: 5px;
        transition: background-color 0.3s ease;
    }
    .link-button a:hover {
        background-color: var(--org-primary-hover);
    }
    .separator {
        border-bottom: 1px solid #ccc;
        margin: 20px 0;
    }
  
    /* Add these new styles */
    .class-container {
        margin-bottom: 10px;
    }
    .subject-container {
        margin-left: 20px; /* Indent the subjects */
    }
    .modify-employee-card {
        max-width: 600px;
        margin: 40px auto;
        background: #fff;
        border-radius: 8px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.08);
        padding: 30px 32px 32px 32px;
        display: flex;
        flex-direction: column;
        align-items: center;
    }
    .modify-employee-card form {
        width: 100%;
    }
    .modify-employee-card label {
        display: block;
        font-weight: bold;
        margin-bottom: 6px;
        width: 100%;
        text-align: left;
    }
    .modify-employee-card input[type="text"],
    .modify-employee-card input[type="email"],
    .modify-employee-card select {
        padding: 8px;
        width: 100%;
        border: 1px solid #ccc;
        border-radius: 4px;
        margin-bottom: 18px;
        box-sizing: border-box;
    }
      .modify-employee-card input[readonly],
      .modify-employee-card input[disabled] {
        background: #f8fafc;
        color: #475569;
        cursor: not-allowed;
      }
    .modify-employee-card .btn {
        display: block;
        margin: 12px auto 0 auto;
        width: 100%;
        max-width: 280px;
    }
    .modify-employee-card .btn-danger {
        background-color: var(--btn-danger-bg, #dc2626);
        color: var(--btn-danger-text, #fff);
        border-color: var(--btn-danger-bg, #dc2626);
    }
    .modify-employee-card .btn-warning {
        background-color: var(--btn-warning-bg, #f59e0b);
        color: var(--btn-warning-text, #fff);
        border-color: var(--btn-warning-bg, #f59e0b);
    }
    .collapsible-btn {
        width: 100%;
        background: #01535b;
        color: #fff;
        border: none;
        outline: none;
        padding: 12px 16px;
        font-size: 16px;
        text-align: left;
        display: flex;
        align-items: center;
        justify-content: space-between;
        cursor: pointer;
        border-radius: 5px;
        margin-bottom: 6px;
        transition: none;
    }
    /* Subject collapsible hierarchy styling */
    .class-collapsible.subject-collapsible {
        width: 90%;
        margin-left: 5%;
        background: #eaf6fa;
        box-shadow: none;
    }
    .class-collapsible.subject-collapsible .collapsible-btn {
        background: #298ca7;
        color: #fff;
    }
    .collapsible-btn .arrow {
        font-size: 18px;
        margin-left: 8px;
        transition: transform 0.2s;
    }
    .helper-note {
      width: 100%;
      margin: 0 0 18px;
      padding: 12px 14px;
      background: #eff6ff;
      border: 1px solid #bfdbfe;
      border-radius: 8px;
      color: #1e3a8a;
      font-size: 13px;
      line-height: 1.5;
    }
    .assignment-list {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
      margin-bottom: 18px;
    }
    .assignment-chip {
      display: inline-flex;
      align-items: center;
      padding: 8px 10px;
      border-radius: 999px;
      background: #f1f5f9;
      color: #0f172a;
      font-size: 13px;
      border: 1px solid #cbd5e1;
    }
    .empty-state-note {
      margin: 0 0 18px;
      padding: 12px 14px;
      border: 1px dashed #cbd5e1;
      border-radius: 8px;
      color: #64748b;
      background: #f8fafc;
      font-size: 13px;
    }

    @media (max-width: 768px) {
      .link-button {
        padding-top: 72px;
      }
    }
  </style>
  
</head>
<body>
<div class="link-button">
  <a href="/common/manageEmployees">Manage Employees</a>
</div>
<div class="separator"></div>
<h1 style="text-align:center; color:#01535b; margin-bottom:24px;"><%= title %></h1>
<div class="modify-employee-card">
  <form action="/common/modifyEmployee/<%= user.user_id %>" method="post">
  <div class="helper-note">
    Only role and permissions can be changed on this page. Employee identity and assignment details are shown for reference only.
  </div>
    <div>
    <label for="employeeName">Employee Name:</label>
    <input id="employeeName" type="text" value="<%= `${user.first_name || ''} ${user.last_name || ''}`.trim() %>" readonly>
    </div>
    <div>
    <label for="employeeEmail">Email:</label>
    <input id="employeeEmail" type="email" value="<%= user.email %>" readonly>
    </div>
    <div>
        <label for="accountType">Role:</label>
        <select name="accountType">
            <option value="">-- Select Role --</option>
            <option value="Manager" <%= user.account_type === 'Manager' ? 'selected' : '' %>>Manager</option>
            <option value="Supervisor" <%= user.account_type === 'Supervisor' ? 'selected' : '' %>>Supervisor</option>
            <option value="Teacher" <%= user.account_type === 'Teacher' ? 'selected' : '' %>>Teacher</option>
        </select>
    </div>
    <div id="permission-assignment-group">
      <label>Optional Extra Permissions:</label>
      <div style="border:1px solid #e2e8f0; background:#f8fafc; border-radius:8px; padding:12px; margin-top:8px;">
        <% if ((permissionOptions || []).length > 0) { %>
          <div style="display:grid; grid-template-columns: 1fr 1fr; gap:10px 16px;">
            <% (permissionOptions || []).forEach(function(permission) { %>
              <label style="display:flex; align-items:center; gap:8px; font-size:14px;">
                <input
                  type="checkbox"
                  name="permissions"
                  value="<%= permission.key %>"
                  <%= (selectedPermissions || []).includes(permission.key) ? 'checked' : '' %>
                >
                <span><%= permission.label %></span>
              </label>
            <% }) %>
          </div>
        <% } else { %>
          <div class="empty-state-note">No data yet.</div>
        <% } %>
        <div style="margin-top:8px; color:#64748b; font-size:12px;">Permissions are pre-selected based on role. You can add or remove any. High-risk permissions (Billing, Settings) require a Manager account.</div>
      </div>
    </div>
    <div>
      <label>Assigned Classes:</label>
      <% if ((assignedClasses || []).length > 0) { %>
        <div class="assignment-list">
          <% assignedClasses.forEach(function(cls) { %>
            <span class="assignment-chip"><%= cls.class_name %></span>
          <% }) %>
        </div>
      <% } else { %>
        <div class="empty-state-note">No data yet.</div>
      <% } %>
    </div>
    <div>
      <label>Assigned Subjects:</label>
      <% if ((assignedSubjects || []).length > 0) { %>
        <div class="assignment-list">
          <% assignedSubjects.forEach(function(subject) { %>
            <span class="assignment-chip"><%= subject.subject_name %><%= subject.class_name ? ` (${subject.class_name})` : '' %></span>
          <% }) %>
        </div>
      <% } else { %>
        <div class="empty-state-note">No data yet.</div>
      <% } %>
    </div>
    <button type="submit" class="btn btn-primary">Save Changes</button>
  </form>
  <form action="/common/deleteEmployee/<%= user.user_id %>" method="post" onsubmit="return confirm('Are you sure you want to delete this employee?');">
      <button type="submit" class="btn btn-danger">Delete Employee</button>
  </form>
  <form action="/common/toggleHoldEmployee/<%= user.user_id %>" method="post">
      <button type="submit" class="btn btn-warning"><%= user.on_hold ? 'Resume' : 'Hold' %> Employee</button>
  </form>
</div>

<script>
    document.addEventListener("DOMContentLoaded", () => {
      const accountTypeSelect = document.querySelector("select[name='accountType']");
      const permissionGroup = document.getElementById("permission-assignment-group");

      // Role → default permission keys (injected from server)
      const ROLE_DEFAULT_PERMISSIONS_MAP = <%- JSON.stringify(roleDefaultPermissionsMap || {}) %>;

      // On role change: reset checkboxes to that role's defaults.
      // The user can still customise before saving.
      const applyRoleDefaults = (role) => {
        const defaults = ROLE_DEFAULT_PERMISSIONS_MAP[role] || [];
        document.querySelectorAll('input[name="permissions"]').forEach(cb => {
          cb.checked = defaults.includes(cb.value);
        });
      };

      const syncPermissionVisibility = () => {
        if (!accountTypeSelect || !permissionGroup) return;
        permissionGroup.style.display = "block";
      };

      if (accountTypeSelect) {
        accountTypeSelect.addEventListener("change", (e) => {
          syncPermissionVisibility();
          applyRoleDefaults(e.target.value);
        });
      }
      syncPermissionVisibility();

      // Confirmation dialog for form submit
      const modifyForm = document.querySelector("form[action^='/common/modifyEmployee']");
      if (modifyForm) {
        modifyForm.addEventListener("submit", function (e) {
          const confirmed = confirm("Are you sure you want to apply these changes?");
          if (!confirmed) {
            e.preventDefault(); // Stop form submission
          }
        });
      }
    });
</script>