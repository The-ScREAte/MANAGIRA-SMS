<style>
    .flash-message {
        text-align: center;
        margin-bottom: 20px;
        padding: 10px;
        border-radius: 5px;
    }
    .flash-success {
        background-color: #d4edda;
        color: #155724;
    }
    .flash-error {
        background-color: #f8d7da;
        color: #721c24;
    }
    .link-button {
        text-align: center;
        margin-bottom: 20px;
    }
    .link-button a {
        display: inline-block;
        padding: 10px 20px;
        background-color: var(--org-primary-color);
        color: #fff;
        text-decoration: none;
        border-radius: 5px;
        transition: background-color 0.3s ease;
    }
    .link-button a:hover {
        background-color: var(--org-primary-hover);
    }
    .separator {
        border-bottom: 1px solid #ccc;
        margin: 20px 0;
    }
  
    /* Add these new styles */
    .class-container {
        margin-bottom: 10px;
    }
    .subject-container {
        margin-left: 20px; /* Indent the subjects */
    }
    .modify-employee-card {
        max-width: 600px;
        margin: 40px auto;
        background: #fff;
        border-radius: 8px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.08);
        padding: 30px 32px 32px 32px;
        display: flex;
        flex-direction: column;
        align-items: center;
    }
    .modify-employee-card form {
        width: 100%;
    }
    .modify-employee-card label {
        display: block;
        font-weight: bold;
        margin-bottom: 6px;
        width: 100%;
        text-align: left;
    }
    .modify-employee-card input[type="text"],
    .modify-employee-card input[type="email"],
    .modify-employee-card select {
        padding: 8px;
        width: 100%;
        border: 1px solid #ccc;
        border-radius: 4px;
        margin-bottom: 18px;
        box-sizing: border-box;
    }
    .modify-employee-card .btn {
        display: block;
        margin: 12px auto 0 auto;
        width: 100%;
        max-width: 280px;
    }
    .modify-employee-card .btn-danger {
        background-color: var(--btn-danger-bg, #dc2626);
        color: var(--btn-danger-text, #fff);
        border-color: var(--btn-danger-bg, #dc2626);
    }
    .modify-employee-card .btn-warning {
        background-color: var(--btn-warning-bg, #f59e0b);
        color: var(--btn-warning-text, #fff);
        border-color: var(--btn-warning-bg, #f59e0b);
    }
    .collapsible-btn {
        width: 100%;
        background: #01535b;
        color: #fff;
        border: none;
        outline: none;
        padding: 12px 16px;
        font-size: 16px;
        text-align: left;
        display: flex;
        align-items: center;
        justify-content: space-between;
        cursor: pointer;
        border-radius: 5px;
        margin-bottom: 6px;
        transition: none;
    }
    /* Subject collapsible hierarchy styling */
    .class-collapsible.subject-collapsible {
        width: 90%;
        margin-left: 5%;
        background: #eaf6fa;
        box-shadow: none;
    }
    .class-collapsible.subject-collapsible .collapsible-btn {
        background: #298ca7;
        color: #fff;
    }
    .collapsible-btn .arrow {
        font-size: 18px;
        margin-left: 8px;
        transition: transform 0.2s;
    }
  </style>
  
</head>
<body>
<div class="link-button">
  <a href="/common/manageEmployees">Manage Employees</a>
</div>
<div class="separator"></div>
<h1 style="text-align:center; color:#01535b; margin-bottom:24px;"><%= title %></h1>
<div class="modify-employee-card">
  <form action="/common/modifyEmployee/<%= user.user_id %>" method="post">
    <div>
        <label for="firstName">First Name:</label>
        <input type="text" name="firstName" value="<%= user.first_name %>">
    </div>
    <div>
        <label for="lastName">Last Name:</label>
        <input type="text" name="lastName" value="<%= user.last_name %>">
    </div>
    <div>
        <label for="email">Email:</label>
        <input type="email" name="email" value="<%= user.email %>"> 
    </div>
    <div>
        <label for="accountType">Role:</label>
        <select name="accountType">
            <option value="">-- Select Role --</option>
            <option value="Manager" <%= user.account_type === 'Manager' ? 'selected' : '' %>>Manager</option>
            <option value="Supervisor" <%= user.account_type === 'Supervisor' ? 'selected' : '' %>>Supervisor</option>
            <option value="Teacher" <%= user.account_type === 'Teacher' ? 'selected' : '' %>>Teacher</option>
        </select>
    </div>
    <div id="permission-assignment-group">
      <label>Optional Extra Permissions:</label>
      <div style="border:1px solid #e2e8f0; background:#f8fafc; border-radius:8px; padding:12px; margin-top:8px;">
        <div style="display:grid; grid-template-columns: 1fr 1fr; gap:10px 16px;">
          <% (permissionOptions || []).forEach(function(permission) { %>
            <label style="display:flex; align-items:center; gap:8px; font-size:14px;">
              <input
                type="checkbox"
                name="permissions"
                value="<%= permission.key %>"
                <%= (selectedPermissions || []).includes(permission.key) ? 'checked' : '' %>
              >
              <span><%= permission.label %></span>
            </label>
          <% }) %>
        </div>
        <div style="margin-top:8px; color:#64748b; font-size:12px;">Grant only what this employee needs. For Manager, most permissions are preselected except billing and settings.</div>
      </div>
    </div>
    <div>
      <label>Classes:</label>
      <div class="class-collapsible">
        <button type="button" class="collapsible-btn" onclick="toggleClassCollapse('all-classes')">
          <span>Show/Hide Classes</span>
          <span class="arrow" id="arrow-all-classes">&#9654;</span>
        </button>
        <div class="class-checkboxes" id="collapse-all-classes" style="display: none;">
          <% classes.forEach(cls => { %>
            <div class="class-container">
              <input type="checkbox" name="classIds[]" value="<%= cls.class_id %>" <%= enrolledClasses.includes(cls.class_id) ? 'checked' : '' %> style="margin-right:8px;">
              <%= cls.class_name %>
              <div class="class-collapsible subject-collapsible" style="margin-top:8px;">
                <button type="button" class="collapsible-btn" onclick="toggleClassCollapse('subjects-<%= cls.class_id %>')">
                  <span>Show/Hide Subjects</span>
                  <span class="arrow" id="arrow-subjects-<%= cls.class_id %>">&#9654;</span>
                </button>
                <div class="class-checkboxes" id="collapse-subjects-<%= cls.class_id %>" style="display: none;">
                  <div class="subject-container">
                    <% if (cls.subjects && cls.subjects.length > 0) { %>
                      <% cls.subjects.forEach(sub => { %>
                        <div>
                          <input type="checkbox" name="subjects[]" value="<%= sub.subject_id %>" <%= enrolledSubjects.includes(sub.subject_id) ? 'checked' : '' %>> <%= sub.subject_name %>
                        </div>
                      <% }); %>
                    <% } else { %>
                      <div style="color:#888; margin:10px 0;">No subjects have been assigned to this class.</div>
                    <% } %>
                  </div>
                </div>
              </div>
            </div>
          <% }); %>
        </div>
      </div>
    </div>
    <button type="submit" class="btn btn-primary">Save Changes</button>
  </form>
  <form action="/common/deleteEmployee/<%= user.user_id %>" method="post" onsubmit="return confirm('Are you sure you want to delete this employee?');">
      <button type="submit" class="btn btn-danger">Delete Employee</button>
  </form>
  <form action="/common/toggleHoldEmployee/<%= user.user_id %>" method="post">
      <button type="submit" class="btn btn-warning"><%= user.on_hold ? 'Resume' : 'Hold' %> Employee</button>
  </form>
</div>

<script>
    // Collapsible logic for all classes and subjects
    function toggleClassCollapse(id) {
      const collapseDiv = document.getElementById('collapse-' + id);
      const arrow = document.getElementById('arrow-' + id);
      if (collapseDiv && arrow) {
        if (collapseDiv.style.display === 'none') {
          collapseDiv.style.display = 'block';
          arrow.innerHTML = '&#9660;'; // Down arrow
        } else {
          collapseDiv.style.display = 'none';
          arrow.innerHTML = '&#9654;'; // Right arrow
        }
      }
    }

    document.addEventListener("DOMContentLoaded", () => {
      const accountTypeSelect = document.querySelector("select[name='accountType']");
      const permissionGroup = document.getElementById("permission-assignment-group");
      const managerDefaultPermissions = new Set(<%- JSON.stringify(managerDefaultPermissions || []) %>);

      const getPermissionCheckboxes = () =>
        Array.from(document.querySelectorAll('input[name="permissions"]'));

      const syncPermissionVisibility = () => {
        if (!accountTypeSelect || !permissionGroup) return;
        permissionGroup.style.display = "block";
      };

      const applyManagerDefaultsIfNeeded = () => {
        if (!accountTypeSelect || accountTypeSelect.value !== "Manager") return;

        const checkboxes = getPermissionCheckboxes();
        const hasAnySelected = checkboxes.some((checkbox) => checkbox.checked);
        if (hasAnySelected) return;

        checkboxes.forEach((checkbox) => {
          checkbox.checked = managerDefaultPermissions.has(checkbox.value);
        });
      };

      if (accountTypeSelect) {
        accountTypeSelect.addEventListener("change", () => {
          syncPermissionVisibility();
          applyManagerDefaultsIfNeeded();
        });
      }
      syncPermissionVisibility();
      applyManagerDefaultsIfNeeded();

      // All collapsibles start collapsed
      const collapseAllClasses = document.getElementById('collapse-all-classes');
      const arrowAllClasses = document.getElementById('arrow-all-classes');
      if (collapseAllClasses && arrowAllClasses) {
        collapseAllClasses.style.display = 'none';
        arrowAllClasses.innerHTML = '&#9654;';
      }

      document.querySelectorAll('input[name="classIds[]"]').forEach(classCheckbox => {
        const collapseSubjects = document.getElementById('collapse-subjects-' + classCheckbox.value);
        const arrowSubjects = document.getElementById('arrow-subjects-' + classCheckbox.value);
        if (collapseSubjects && arrowSubjects) {
          collapseSubjects.style.display = 'none';
          arrowSubjects.innerHTML = '&#9654;';
          classCheckbox.addEventListener('change', function() {
            if (this.checked) {
              collapseSubjects.style.display = 'block';
              arrowSubjects.innerHTML = '&#9660;';
            } else {
              collapseSubjects.style.display = 'none';
              arrowSubjects.innerHTML = '&#9654;';
            }
          });
        }
      });

      // Confirmation dialog for form submit
      const modifyForm = document.querySelector("form[action^='/common/modifyEmployee']");
      if (modifyForm) {
        modifyForm.addEventListener("submit", function (e) {
          const confirmed = confirm("Are you sure you want to apply these changes?");
          if (!confirmed) {
            e.preventDefault(); // Stop form submission
          }
        });
      }
    });
</script>