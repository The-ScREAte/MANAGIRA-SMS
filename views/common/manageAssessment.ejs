<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Manage Assessments</title>
    <style>
      :root {
        --font-family: "<%= (session && session.fontStyle ? String(session.fontStyle).trim() : 'Inter') %>", sans-serif;
      }


        body {
            font-family: var(--font-family);
            background: #f7f9fb;
            margin: 0;
            box-sizing: border-box;
            color: #0f2d32;
        }
        .main-content {
            width: 100%;
            max-width: 1200px;
            margin: 0 auto;
            box-sizing: border-box;
            padding: 20px 24px 36px;
        }
        .page-header {
            display: flex;
            justify-content: center;
            margin-bottom: 16px;
        }
        .link-to-next-back a {
            display: inline-block;
            padding: 10px 18px;
            background: var(--org-primary-color, #0f5a66);
            color: #fff;
            border-radius: 10px;
            text-decoration: none;
            font-weight: 600;
            box-shadow: 0 6px 16px rgba(15, 90, 102, 0.18);
            transition: background-color 0.18s ease, transform 0.15s ease;
        }
        .link-to-next-back a:hover {
            background: var(--org-primary-hover, #0d4f59);
            transform: translateY(-1px);
        }
        .card {
            background: #ffffff;
            border: 1px solid #e5e7eb;
            border-radius: 14px;
            padding: 18px 18px 10px;
            box-shadow: 0 10px 24px rgba(15, 45, 50, 0.12);
            margin-top: 12px;
        }
        .table-wrapper {
            overflow-x: auto;
            width: 100%;
            background: none;
            border-radius: 12px;
            box-shadow: none;
            padding: 0;
            margin-bottom: 16px;
        }
        table {
            width: 100%;
            border-collapse: collapse;
            background: #fff;
            border-radius: 12px 12px 0 0;
            box-shadow: 0 8px 18px rgba(15, 45, 50, 0.12);
            min-width: 900px;
            border: 1px solid #e5e7eb;
        }
        th, td {
            padding: 14px 12px;
            text-align: left;
            font-size: 0.95rem;
            border: 1px solid #e5e7eb;
            background: #fff;
        }
        th {
            background: var(--org-primary-color, #0f5a66);
            color: #fff;
            font-weight: 700;
            border-bottom: 2px solid var(--org-primary-hover, #0d4f59);
            text-align: center;
            letter-spacing: 0.2px;
        }
        tr:nth-child(even) td {
            background: #f5f7f9;
        }
        tr:hover td {
            background: #eef4f7;
        }
        .action-buttons a {
            display: inline-block;
            padding: 8px 14px;
            border-radius: 10px;
            background: #f8fafc;
            color: #0f2d32;
            font-weight: 600;
            text-decoration: none;
            border: 1px solid #e2e8f0;
            transition: background 0.18s ease, transform 0.15s ease;
        }
        .action-buttons a:hover {
            background: #eef2f7;
            transform: translateY(-1px);
        }
        .collapsible-btn {
            width: 200px;
            background: var(--org-primary-color, #0f5a66);
            color: #fff;
            border: none;
            outline: none;
            padding: 8px 14px;
            font-size: 14px;
            text-align: left;
            display: flex;
            align-items: center;
            justify-content: space-between;
            cursor: pointer;
            border-radius: 10px;
            margin-bottom: 8px;
            transition: background 0.18s ease, transform 0.15s ease;
            box-shadow: 0 4px 12px rgba(15, 90, 102, 0.16);
        }
        .collapsible-btn .arrow {
            font-size: 16px;
            margin-left: 10px;
            transition: transform 0.2s;
        }
        .collapsible-content {
            background: #f8fafc;
            border-radius: 10px;
            margin-top: 6px;
            padding: 10px 14px;
            width: 100%;
            border: 1px solid #e2e8f0;
        }
        .collapsible-btn:hover,
        .collapsible-btn:focus {
            background: var(--org-primary-hover, #0d4f59);
            color: #fff;
            transform: translateY(-1px);
        }
    </style>
</head>
<body>
    <div class="main-content">
        <div class="page-header">
            <div class="link-to-next-back">
                <a href="/common/createTest?organizationId=<%= organizationId %>&termId=<%= termId %>">Create New Test</a>
            </div>
        </div>
        <div class="card">
        <h1 style="text-align: center; margin: 0 0 12px 0;">Manage Assessments</h1>
        <div class="table-wrapper">
            <table>
                <thead>
                    <tr>
                        <th>Test Name</th>
                        <th>Weight (%)</th>
                        <th>Score Out Of</th>
                        <th>Category</th>
                        <th>Assigned Classes and Subjects</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <% assessments.forEach(function(assessment, idx) { %>
                        <tr>
                            <td><%= assessment.title %></td>
                            <td><%= assessment.weight %></td>
                            <td><%= assessment.max_score %></td>
                            <td><%= assessment.category %></td>
                            <td>
                                <button type="button" class="collapsible-btn" onclick="toggleAssignedClassesCollapse('<%= idx %>')">
                                    Show/Hide Classes
                                    <span class="arrow" id="arrow-classes-<%= idx %>">&#9654;</span>
                                </button>
                                <div class="collapsible-content" id="collapse-classes-<%= idx %>" style="display:none;">
                                    <% Object.keys(assessment.assigned_classes).forEach(function(classId) { %>
                                        <div>
                                            <strong> <%= assessment.assigned_classes[classId].class_name %>:</strong>
                                            <ul>
                                                <% assessment.assigned_classes[classId].subjects.forEach(function(subject) { %>
                                                    <li><%= subject %></li>
                                                <% }); %>
                                            </ul>
                                        </div>
                                    <% }); %>
                                </div>
                            </td>
                            <td class="action-buttons">
                                <a href="/common/modifyAssessment?groupId=<%= assessment.group_id %>&termId=<%= termId %>&organizationId=<%= organizationId %>">
                                    Modify
                                </a>
                            </td>
                        </tr>
                    <% }); %>
                </tbody>
            </table>
        </div>
        </div>
    </div>
    <script>
        function toggleAssignedClassesCollapse(idx) {
            const collapseDiv = document.getElementById('collapse-classes-' + idx);
            const arrow = document.getElementById('arrow-classes-' + idx);
            if (collapseDiv && arrow) {
                if (collapseDiv.style.display === 'none') {
                    collapseDiv.style.display = 'block';
                    arrow.innerHTML = '&#9660;';
                } else {
                    collapseDiv.style.display = 'none';
                    arrow.innerHTML = '&#9654;';
                }
            }
        }
    </script>
</body>
</html>
