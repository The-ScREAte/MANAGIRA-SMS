<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Manage Assessments</title>
    <style>
      :root {
        --font-family: "<%= (session && session.fontStyle ? String(session.fontStyle).trim() : 'Inter') %>", sans-serif;
        --primary: var(--org-primary-color, #0f5a66);
        --primary-hover: var(--org-primary-hover, #0d4f59);
        --primary-hover-fill: color-mix(in srgb, var(--primary) 88%, white);
        --surface: color-mix(in srgb, var(--primary) 8%, white);
        --card-surface: white;
        --border-soft: color-mix(in srgb, var(--primary) 16%, white);
        --text-main: color-mix(in srgb, var(--primary) 72%, black);
        --text-soft: color-mix(in srgb, var(--primary) 46%, white);
        --table-head-bg: color-mix(in srgb, var(--primary) 10%, white);
        --row-even-bg: color-mix(in srgb, var(--primary) 3%, white);
        --row-hover-bg: color-mix(in srgb, var(--primary) 8%, white);
        --btn-disabled-bg: color-mix(in srgb, var(--primary) 10%, white);
        --btn-disabled-border: color-mix(in srgb, var(--primary) 20%, white);
        --btn-disabled-text: color-mix(in srgb, var(--primary) 36%, white);
        --pill-on-bg: color-mix(in srgb, var(--primary) 14%, white);
        --pill-on-text: color-mix(in srgb, var(--primary) 68%, black);
        --pill-off-bg: color-mix(in srgb, var(--primary) 8%, white);
        --pill-off-text: color-mix(in srgb, var(--primary) 44%, white);
        --lock-open-bg: #e7f7ee;
        --lock-open-border: #8cd0aa;
        --lock-open-text: #157347;
        --lock-closed-bg: #fdeaea;
        --lock-closed-border: #ef9a9a;
        --lock-closed-text: #c62828;
        --icon-btn-bg: color-mix(in srgb, var(--primary) 7%, white);
        --icon-btn-border: color-mix(in srgb, var(--primary) 18%, white);
        --icon-btn-hover: color-mix(in srgb, var(--primary) 13%, white);
        --shadow-soft: color-mix(in srgb, var(--primary) 15%, transparent);
      }
      *, *::before, *::after { box-sizing: border-box; }
      body { font-family: var(--font-family); background: var(--surface); margin: 0; color: var(--text-main); }
      .page-wrap { max-width: 1260px; margin: 0 auto; padding: 22px 20px 40px; }
      .top-bar { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 12px; margin-bottom: 24px; }
      .top-bar h1 { font-size: 1.38rem; font-weight: 700; margin: 0; color: var(--text-main); }
      .top-bar-actions { display: flex; gap: 10px; flex-wrap: wrap; }
      .btn { display: inline-flex; align-items: center; gap: 8px; padding: 9px 14px; border-radius: 10px; font-size: 0.84rem; font-weight: 700; cursor: pointer; text-decoration: none; border: none; transition: background 0.17s, transform 0.14s; white-space: nowrap; }
      .btn-primary { background: var(--primary); color: white; box-shadow: 0 3px 10px var(--shadow-soft); }
      .btn-primary:hover { background: var(--primary-hover-fill, var(--primary-hover)); transform: translateY(-1px); }
      .btn-outline { background: white; color: var(--primary); border: 2px solid var(--primary); }
      .btn-outline:hover { background: var(--table-head-bg); transform: translateY(-1px); }
      .btn-disabled {
        background: var(--btn-disabled-bg);
        color: var(--btn-disabled-text);
        border: 2px solid var(--btn-disabled-border);
        cursor: not-allowed;
        opacity: 0.9;
      }
      .card { background: var(--card-surface); border-radius: 14px; border: 1px solid var(--border-soft); box-shadow: 0 6px 22px var(--shadow-soft); overflow: hidden; }
      .table-scroll { overflow-x: auto; }
      table { width: 100%; border-collapse: collapse; min-width: 980px; font-size: 0.86rem; }
      thead th { background: var(--table-head-bg); color: var(--text-soft); font-weight: 700; padding: 12px 12px; text-align: left; letter-spacing: 0.2px; border-bottom: 1px solid var(--border-soft); white-space: nowrap; text-transform: uppercase; font-size: 0.73rem; }
      tbody tr { border-bottom: 1px solid var(--border-soft); }
      tbody tr:last-child { border-bottom: none; }
      tbody tr:nth-child(even) td { background: var(--row-even-bg); }
      tbody tr:hover td { background: var(--row-hover-bg); }
      td { padding: 11px 12px; vertical-align: middle; color: var(--text-main); }
      .table-name {
        display: block;
        font-weight: 700;
        color: var(--text-main);
        line-height: 1.35;
        white-space: normal;
        word-break: break-word;
      }
      .test-name-content {
        display: flex;
        align-items: flex-start;
        gap: 10px;
      }
      .test-name-content .table-name {
        flex: 0 1 auto;
      }
      .table-meta {
        margin-top: 0;
        display: flex;
        flex-direction: column;
        gap: 4px;
        padding-left: 12px;
        flex: 0 1 auto;
      }
      .lock-status-note {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 30px;
        height: 30px;
        padding: 0;
        border-radius: 9px;
      }
      .lock-status-note svg {
        width: 16px;
        height: 16px;
      }
      .lock-status-note.locked {
        background: var(--lock-closed-bg);
        color: var(--lock-closed-text);
        border: 1px solid var(--lock-closed-border);
      }
      .lock-status-note.open {
        background: var(--lock-open-bg);
        color: var(--lock-open-text);
        border: 1px solid var(--lock-open-border);
      }
      .editability-note {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        font-size: 0.75rem;
        font-weight: 700;
        color: var(--text-soft);
      }
      .editability-note svg {
        width: 12px;
        height: 12px;
      }
      .window-info { font-size: 0.74rem; color: var(--text-soft); line-height: 1.45; }
      .window-info span { display: block; }
      .collapse-btn { display: inline-flex; align-items: center; gap: 6px; padding: 6px 10px; background: var(--primary); color: white; border: none; border-radius: 999px; font-size: 0.76rem; font-weight: 700; cursor: pointer; transition: background 0.17s; }
      .collapse-btn:hover { background: var(--primary-hover-fill, var(--primary-hover)); }
      .collapse-btn svg { width: 12px; height: 12px; }
      .collapse-arrow { font-size: 10px; transition: transform 0.2s; }
      .collapse-body {
        margin-top: 8px;
        background: var(--table-head-bg);
        border-radius: 10px;
        border: 1px solid var(--border-soft);
        padding: 10px;
      }
      .assigned-class-list {
        display: flex;
        flex-direction: column;
        gap: 10px;
      }
      .assigned-class-card {
        background: rgba(255, 255, 255, 0.72);
        border: 1px solid var(--border-soft);
        border-radius: 10px;
        padding: 10px;
      }
      .collapse-class-name {
        font-size: 0.85rem;
        font-weight: 700;
        color: var(--text-main);
        margin-bottom: 8px;
      }
      .subject-chip-list {
        list-style: none;
        margin: 0;
        padding: 0;
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 6px;
        font-size: 0.8rem;
        color: var(--text-soft);
      }
      .subject-chip-list li {
        margin: 0;
        padding: 6px 8px;
        border-radius: 999px;
        background: white;
        border: 1px solid var(--border-soft);
        color: var(--text-main);
        line-height: 1.25;
      }
      .actions-cell { display: flex; gap: 8px; align-items: center; flex-wrap: nowrap; justify-content: flex-start; }
      .lock-action-btn {
        width: 32px;
        min-width: 32px;
        height: 32px;
        padding: 0;
        gap: 0;
        border-radius: 10px;
        justify-content: center;
      }
      .lock-action-btn svg {
        width: 15px;
        height: 15px;
        flex: 0 0 auto;
      }
      .lock-action-btn.locked {
        background: var(--lock-closed-bg);
        color: var(--lock-closed-text);
        border-color: var(--lock-closed-border);
      }
      .lock-action-btn.open {
        background: var(--lock-open-bg);
        color: var(--lock-open-text);
        border-color: var(--lock-open-border);
      }
      .lock-action-btn.locked:hover {
        background: #f9d7d7;
      }
      .lock-action-btn.open:hover {
        background: #d8f0e3;
      }
      .action-icon-btn {
        width: 32px;
        height: 32px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 10px;
        border: 1px solid var(--icon-btn-border);
        text-decoration: none;
        cursor: pointer;
        transition: transform 0.14s, background 0.16s, border-color 0.16s;
        background: var(--icon-btn-bg);
        color: var(--primary);
      }
      .action-icon-btn:hover { transform: translateY(-1px); background: var(--icon-btn-hover); }
      .action-icon-btn svg { width: 16px; height: 16px; }
      .action-icon-btn-lock { color: var(--primary); background: var(--icon-btn-bg); border-color: var(--icon-btn-border); }
      .action-icon-btn-lock:hover { background: var(--icon-btn-hover); }
      .action-icon-btn-unlock { color: var(--primary); background: var(--icon-btn-bg); border-color: var(--icon-btn-border); }
      .action-icon-btn-unlock:hover { background: var(--icon-btn-hover); }
      .action-icon-btn-modify { color: var(--primary); background: var(--icon-btn-bg); border-color: var(--icon-btn-border); }
      .action-icon-btn-modify:hover { background: var(--icon-btn-hover); }
      .sr-only {
        position: absolute;
        width: 1px;
        height: 1px;
        padding: 0;
        margin: -1px;
        overflow: hidden;
        clip: rect(0, 0, 0, 0);
        white-space: nowrap;
        border: 0;
      }
      .empty-row td { text-align: center; color: var(--text-soft); font-style: italic; padding: 32px; }

      /* ── Small screen ── */
      @media (max-width: 760px) {
        .page-wrap { padding: 14px 12px 28px; }
        .top-bar { gap: 8px; margin-bottom: 14px; flex-wrap: wrap; }
        .top-bar h1 { font-size: 1.12rem; }
        .top-bar-actions { width: 100%; }
        .btn { flex: 1 1 calc(50% - 6px); justify-content: center; padding: 8px 10px; font-size: 0.78rem; }

        .card { background: transparent; border: none; box-shadow: none; }
        .table-scroll { overflow: visible; }
        table { min-width: 0; border-collapse: separate; border-spacing: 0 10px; }
        thead { display: none; }
        tbody tr {
          display: flex;
          flex-wrap: wrap;
          background: white;
          border: 1px solid var(--border-soft);
          border-radius: 12px;
          box-shadow: 0 4px 12px var(--shadow-soft);
          padding: 2px 0;
        }
        tbody tr:nth-child(even) td,
        tbody tr:hover td { background: transparent; }
        td {
          display: flex;
          align-items: flex-start;
          justify-content: space-between;
          gap: 12px;
          width: 100%;
          border-bottom: 1px dashed var(--border-soft);
          padding: 10px 12px;
        }
        tbody tr td:nth-child(2),
        tbody tr td:nth-child(3) {
          width: 50%;
        }
        tbody tr td:nth-child(2) {
          border-right: 1px dashed var(--border-soft);
        }
        tbody tr td:nth-child(3),
        tbody tr td:nth-child(3)::before,
        tbody tr td:nth-child(3) > * {
          white-space: nowrap;
        }
        td:last-child { border-bottom: none; }
        td::before {
          content: attr(data-label);
          color: var(--text-soft);
          font-weight: 700;
          font-size: 0.72rem;
          letter-spacing: 0.2px;
          text-transform: uppercase;
          flex: 0 0 38%;
        }
        td > * { max-width: 62%; }
        td[data-label="Test Name"] {
          display: block;
        }
        td[data-label="Test Name"]::before {
          display: block;
          margin-bottom: 4px;
        }
        td[data-label="Test Name"] > * {
          max-width: none;
        }
        td[data-label="Assigned"] {
          display: flex;
          flex-wrap: wrap;
          align-items: center;
          justify-content: space-between;
          gap: 8px;
        }
        td[data-label="Assigned"]::before {
          display: inline-block;
          margin-bottom: 0;
          flex: 0 0 auto;
        }
        td[data-label="Assigned"] > * {
          max-width: none;
        }
        .test-name-content {
          display: grid;
          grid-template-columns: minmax(0, auto) minmax(0, 1fr);
          align-items: start;
          gap: 8px;
        }
        .test-name-content .table-name {
          min-width: 0;
        }
        .actions-cell,
        .collapse-body { width: 100%; }
        .table-meta,
        .window-info { width: 100%; }
        .actions-cell { justify-content: flex-start; }
        .collapse-btn { margin-left: 0; width: fit-content; max-width: 100%; }
        .collapse-body,
        .assigned-class-list,
        .assigned-class-card { width: 100%; }

        .empty-row { padding: 0; }
        .empty-row td {
          display: block;
          border: none;
          text-align: center;
          padding: 18px 14px;
        }
        .empty-row td::before { display: none; }
      }

      @media (max-width: 640px) {
        .page-wrap { padding: 14px 12px 28px; }
        .top-bar { gap: 8px; margin-bottom: 14px; flex-wrap: wrap; }
        .top-bar h1 { font-size: 1.15rem; }
        .btn { padding: 7px 10px; font-size: 0.76rem; }
        td { padding: 9px 10px; }
        .table-meta {
          flex-direction: row;
          flex-wrap: wrap;
          align-items: center;
          gap: 6px 10px;
          padding-left: 8px;
        }
        .editability-note,
        .window-info {
          width: auto;
        }
        .window-info span {
          display: inline;
        }
        .window-info { font-size: 0.7rem; }
        .collapse-btn { padding: 5px 10px; font-size: 0.76rem; }
        .subject-chip-list { grid-template-columns: repeat(2, minmax(0, 1fr)); font-size: 0.76rem; }
        .collapse-class-name { font-size: 0.78rem; }
        .action-icon-btn { width: 30px; height: 30px; }
        .lock-action-btn { width: 30px; min-width: 30px; height: 30px; padding: 0; }
        .lock-status-note { width: 28px; height: 28px; }
      }
      @media (max-width: 420px) {
        .top-bar { flex-direction: column; align-items: flex-start; }
        .top-bar h1 { font-size: 1.05rem; }
        .top-bar-actions { gap: 6px; }
        .btn { flex: 1 1 100%; font-size: 0.75rem; padding: 6px 9px; }
        td::before { flex-basis: 42%; font-size: 0.69rem; }
        td > * { max-width: 58%; }
      }
    </style>
</head>
<body>
<div class="page-wrap">

  <!-- Top Bar -->
  <div class="top-bar">
    <h1>Manage Assessments</h1>
    <div class="top-bar-actions">
      <% if (canAccessAssessmentQuestions) { %>
      <a href="/common/allClassAssessmentExams?organizationId=<%= organizationId %>&termId=<%= termId %>" class="btn btn-outline" title="Open all class assessment questions">
        <svg viewBox="0 0 24 24" fill="none" aria-hidden="true" width="15" height="15"><path d="M4 7h16M4 12h16M4 17h10" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
        Assessment Questions
      </a>
      <% } %>
      <a href="/common/createTest?organizationId=<%= organizationId %>&termId=<%= termId %>" class="btn btn-primary" title="Create new test">
        <svg viewBox="0 0 24 24" fill="none" aria-hidden="true" width="15" height="15"><path d="M12 5v14M5 12h14" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
        New Test
      </a>
    </div>
  </div>

  <%- include('../partials/flash') %>

  <!-- Table Card -->
  <div class="card">
    <div class="table-scroll">
      <table>
        <thead>
          <tr>
            <th>Test Name</th>
            <th>Weight (%)</th>
            <th>Max Score</th>
            <th>Category</th>
            <th>Assigned Classes</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          <% if (!assessments || assessments.length === 0) { %>
            <tr class="empty-row"><td colspan="6">No assessments created yet.</td></tr>
          <% } %>
          <% (assessments || []).forEach(function(assessment, idx) { %>
            <tr>
              <td data-label="Test Name">
                <div class="test-name-content">
                  <strong class="table-name"><%= assessment.title %></strong>
                  <div class="table-meta">
                    <span class="editability-note" title="Entry status">
                      <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M4 20h4l10-10-4-4L4 16v4zM13 7l4 4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                      <% if (assessment.can_edit_scores) { %>
                        Entry Status: Open
                      <% } else { %>
                        Entry Status: Close
                      <% } %>
                    </span>
                    <div class="window-info">
                      <% if (assessment.edit_window_start || assessment.edit_window_end) { %>
                        <% if (assessment.edit_window_start) { %>
                          <span>Open from: <%= new Date(assessment.edit_window_start).toLocaleDateString() %></span>
                        <% } %>
                        <% if (assessment.edit_window_end) { %>
                          <span>Open until: <%= new Date(assessment.edit_window_end).toLocaleDateString() %></span>
                        <% } %>
                      <% } else { %>
                        <span>No edit window</span>
                      <% } %>
                    </div>
                  </div>
                </div>
              </td>
              <td data-label="Weight"><%= assessment.weight %>%</td>
              <td data-label="Max Score"><%= assessment.max_score %></td>
              <td data-label="Category"><%= assessment.category %></td>

              <!-- Assigned Classes -->
              <td data-label="Assigned Classes">
                <button type="button" class="collapse-btn" onclick="toggleClasses('<%= idx %>')" title="Show assigned classes and subjects">
                  <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h10" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
                  <%= (assessment.assigned_classes || []).length %>
                  <span class="collapse-arrow" id="arrow-<%= idx %>">▶</span>
                </button>
                <div class="collapse-body" id="col-<%= idx %>" style="display:none;">
                  <div class="assigned-class-list">
                    <% Object.values(assessment.assigned_classes).forEach(function(cls) { %>
                      <div class="assigned-class-card">
                        <div class="collapse-class-name"><%= cls.class_name %></div>
                        <ul class="subject-chip-list">
                          <% cls.subjects.forEach(function(sub) { %><li><%= sub %></li><% }); %>
                        </ul>
                      </div>
                    <% }); %>
                  </div>
                </div>
              </td>

              <!-- Actions -->
              <td data-label="Actions">
                <div class="actions-cell">
                  <button
                    type="button"
                    class="action-icon-btn lock-action-btn <%= assessment.is_locked ? 'locked action-icon-btn-unlock' : 'open action-icon-btn-lock' %>"
                    title="<%= assessment.is_locked ? 'Unlock assessment' : 'Lock assessment' %>"
                    aria-label="<%= assessment.is_locked ? 'Unlock assessment' : 'Lock assessment' %>"
                    onclick="updateControl('<%= assessment.group_id %>', '<%= organizationId %>', '<%= termId %>', '<%= assessment.is_locked ? 'unlock' : 'lock' %>')">
                    <% if (assessment.is_locked) { %>
                      <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><rect x="5" y="11" width="14" height="10" rx="2" stroke="currentColor" stroke-width="2"/><path d="M8 11V8a4 4 0 118 0v3" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"/></svg>
                    <% } else { %>
                      <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><rect x="5" y="11" width="14" height="10" rx="2" stroke="currentColor" stroke-width="2"/><path d="M16 11V8a4 4 0 0 0-7.2-2.4" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"/><path d="M8.8 5.6L6.2 4" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"/></svg>
                    <% } %>
                    <span class="sr-only"><%= assessment.is_locked ? 'Locked' : 'Open' %></span>
                  </button>
                  <a href="/common/modifyAssessment?groupId=<%= assessment.group_id %>&termId=<%= termId %>&organizationId=<%= organizationId %>" class="action-icon-btn action-icon-btn-modify" title="Modify assessment" aria-label="Modify assessment">
                    <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M4 20h4l10-10-4-4L4 16v4zM13 7l4 4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                    <span class="sr-only">Modify</span>
                  </a>
                </div>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  </div>

</div>

<script>
  async function updateControl(groupId, organizationId, termId, action) {
    try {
      const res = await fetch('/common/updateAssessmentControl', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ groupId, organizationId, termId, action }),
      });
      const result = await res.json();
      if (!res.ok) { alert(result.error || 'Failed to update.'); return; }
      window.location.reload();
    } catch (e) {
      alert('Failed to update control status.');
    }
  }

  function toggleClasses(idx) {
    const body  = document.getElementById('col-' + idx);
    const arrow = document.getElementById('arrow-' + idx);
    if (!body) return;
    const open = body.style.display !== 'none';
    body.style.display = open ? 'none' : 'block';
    arrow.textContent  = open ? '▶' : '▼';
  }
</script>
</body>
</html>
