<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Manage Assessments</title>
    <style>
      :root {
        --font-family: "Inter", sans-serif;
      }


        body {
            font-family: var(--font-family);
            background: #fff;
            margin: 0;
            box-sizing: border-box;
        }
        .main-content {
            width: 100%;
            max-width: 1600px;
            margin: 0 auto;
            box-sizing: border-box;
            padding: 0 32px ;
        }
        .main-content {
            width: 100%;
            max-width: 1600px;
            margin: 0 auto;
            box-sizing: border-box;
        }
        .table-wrapper {
            overflow-x: auto;
            width: 100%;
            background: none;
            border-radius: 0;
            box-shadow: none;
            padding: 0;
            margin-bottom: 32px;
        }
        table {
            width: 100%;
            border-collapse: collapse;
            background: #fff;
            border-radius: 10px 10px 0 0;
            box-shadow: none;
            min-width: 900px;
        }
        th, td {
            padding: 14px 10px;
            text-align: left;
            font-size: 1rem;
            border: 1px solid #d3e2e5;
            background: #fff;
        }
        th {
            background: #01535b;
            color: #fff;
            font-weight: 600;
            border-bottom: 2px solid #013a40;
            text-align: center;
        }
        tr:nth-child(even) td {
            background: #f2f7fa;
        }
        tr:hover td {
            background: #e0f7fa;
        }
        .action-buttons a {
            display: inline-block;
            padding: 6px 14px;
            border-radius: 4px;
            background: #e8f5e9;
            color: #43a047;
            font-weight: bold;
            text-decoration: none;
            transition: background 0.2s, color 0.2s;
        }
        .action-buttons a:hover {
            background: #43a047;
            color: #fff;
        }
        .collapsible-btn {
            width: 180px;
            background: #01535b;
            color: #fff;
            border: none;
            outline: none;
            padding: 7px 14px;
            font-size: 15px;
            text-align: left;
            display: flex;
            align-items: center;
            justify-content: flex-start;
            cursor: pointer;
            border-radius: 5px;
            margin-bottom: 8px;
            transition: none;
        }
        .collapsible-btn .arrow {
            font-size: 18px;
            margin-left: 8px;
            transition: transform 0.2s;
        }
        .collapsible-content {
            background: #f9f9f9;
            border-radius: 6px;
            margin-top: 6px;
            padding: 8px 12px;
            width: 100%;
        }
        .collapsible-btn:hover,
        .collapsible-btn:focus {
            background: #01535b;
            color: #fff;
            box-shadow: none;
        }
    </style>
</head>
<body>
    <div class="main-content">
        <br>
        <div class="link-to-next-back">
            <a href="/common/createTest?organizationId=<%= organizationId %>&termId=<%= termId %>">Back to Create Test</a>
        </div>
        <hr>
        <h1 style="text-align: center;">Manage Assessments</h1>
        <div class="table-wrapper">
            <table>
                <thead>
                    <tr>
                        <th>Test Name</th>
                        <th>Weight (%)</th>
                        <th>Score Out Of</th>
                        <th>Category</th>
                        <th>Assigned Classes and Subjects</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <% assessments.forEach(function(assessment, idx) { %>
                        <tr>
                            <td><%= assessment.title %></td>
                            <td><%= assessment.weight %></td>
                            <td><%= assessment.max_score %></td>
                            <td><%= assessment.category %></td>
                            <td>
                                <button type="button" class="collapsible-btn" onclick="toggleAssignedClassesCollapse('<%= idx %>')">
                                    Show/Hide Classes
                                    <span class="arrow" id="arrow-classes-<%= idx %>">&#9654;</span>
                                </button>
                                <div class="collapsible-content" id="collapse-classes-<%= idx %>" style="display:none;">
                                    <% Object.keys(assessment.assigned_classes).forEach(function(classId) { %>
                                        <div>
                                            <strong> <%= assessment.assigned_classes[classId].class_name %>:</strong>
                                            <ul>
                                                <% assessment.assigned_classes[classId].subjects.forEach(function(subject) { %>
                                                    <li><%= subject %></li>
                                                <% }); %>
                                            </ul>
                                        </div>
                                    <% }); %>
                                </div>
                            </td>
                            <td class="action-buttons">
                                <a href="/common/modifyAssessment?groupId=<%= assessment.group_id %>&termId=<%= termId %>&organizationId=<%= organizationId %>">
                                    Modify
                                </a>
                            </td>
                        </tr>
                    <% }); %>
                </tbody>
            </table>
        </div>
    </div>
    <script>
        function toggleAssignedClassesCollapse(idx) {
            const collapseDiv = document.getElementById('collapse-classes-' + idx);
            const arrow = document.getElementById('arrow-classes-' + idx);
            if (collapseDiv && arrow) {
                if (collapseDiv.style.display === 'none') {
                    collapseDiv.style.display = 'block';
                    arrow.innerHTML = '&#9660;';
                } else {
                    collapseDiv.style.display = 'none';
                    arrow.innerHTML = '&#9654;';
                }
            }
        }
    </script>
</body>
</html>
