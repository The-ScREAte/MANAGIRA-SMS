<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Manage Assessments</title>
    <style>
      :root {
        --font-family: "<%= (session && session.fontStyle ? String(session.fontStyle).trim() : 'Inter') %>", sans-serif;
        --primary: var(--org-primary-color, #0f5a66);
        --primary-hover: var(--org-primary-hover, #0d4f59);
      }
      *, *::before, *::after { box-sizing: border-box; }
      body { font-family: var(--font-family); background: #f4f6f9; margin: 0; color: #1a2e35; }
      .page-wrap { max-width: 1260px; margin: 0 auto; padding: 28px 24px 48px; }
      .top-bar { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 12px; margin-bottom: 24px; }
      .top-bar h1 { font-size: 1.55rem; font-weight: 700; margin: 0; color: #0f2d32; }
      .top-bar-actions { display: flex; gap: 10px; flex-wrap: wrap; }
      .btn { display: inline-flex; align-items: center; gap: 6px; padding: 9px 18px; border-radius: 8px; font-size: 0.88rem; font-weight: 600; cursor: pointer; text-decoration: none; border: none; transition: background 0.17s, transform 0.14s; white-space: nowrap; }
      .btn-primary { background: var(--primary); color: #fff; box-shadow: 0 3px 10px rgba(15,90,102,0.22); }
      .btn-primary:hover { background: var(--primary-hover); transform: translateY(-1px); }
      .btn-outline { background: #fff; color: var(--primary); border: 2px solid var(--primary); }
      .btn-outline:hover { background: #eef4f7; transform: translateY(-1px); }
      .card { background: #fff; border-radius: 14px; border: 1px solid #e2e8ef; box-shadow: 0 6px 22px rgba(15,45,50,0.09); overflow: hidden; }
      .table-scroll { overflow-x: auto; }
      table { width: 100%; border-collapse: collapse; min-width: 860px; font-size: 0.9rem; }
      thead th { background: var(--primary); color: #fff; font-weight: 700; padding: 13px 14px; text-align: left; letter-spacing: 0.15px; border-bottom: 2px solid var(--primary-hover); white-space: nowrap; }
      tbody tr { border-bottom: 1px solid #edf0f4; }
      tbody tr:last-child { border-bottom: none; }
      tbody tr:nth-child(even) td { background: #f8fafb; }
      tbody tr:hover td { background: #eef5f7; }
      td { padding: 13px 14px; vertical-align: middle; color: #1a2e35; }
      .badge { display: inline-block; padding: 3px 10px; border-radius: 20px; font-size: 0.78rem; font-weight: 700; letter-spacing: 0.2px; }
      .badge-locked { background: #fdecea; color: #c0392b; }
      .badge-unlocked { background: #e6f9f1; color: #1a7a4a; }
      .window-info { font-size: 0.78rem; color: #607080; margin-top: 5px; line-height: 1.6; }
      .window-info span { display: block; }
      .edit-pill { display: inline-block; margin-top: 5px; padding: 2px 8px; border-radius: 12px; font-size: 0.75rem; font-weight: 600; }
      .edit-pill-yes { background: #e6f9f1; color: #1a7a4a; }
      .edit-pill-no  { background: #fdecea; color: #c0392b; }
      .collapse-btn { display: inline-flex; align-items: center; gap: 7px; padding: 6px 13px; background: var(--primary); color: #fff; border: none; border-radius: 7px; font-size: 0.82rem; font-weight: 600; cursor: pointer; transition: background 0.17s; }
      .collapse-btn:hover { background: var(--primary-hover); }
      .collapse-arrow { font-size: 11px; transition: transform 0.2s; }
      .collapse-body { margin-top: 8px; background: #f4f8fa; border-radius: 8px; border: 1px solid #dde4ec; padding: 10px 14px; }
      .collapse-body ul { margin: 2px 0 0 14px; padding: 0; font-size: 0.83rem; color: #3a5060; }
      .collapse-body li { margin-bottom: 2px; }
      .collapse-class-name { font-size: 0.85rem; font-weight: 600; color: #1a2e35; margin-bottom: 2px; }
      .actions-cell { display: flex; flex-direction: column; gap: 7px; align-items: flex-start; }
      .action-btn { display: inline-block; padding: 6px 14px; border-radius: 7px; font-size: 0.82rem; font-weight: 600; cursor: pointer; text-decoration: none; border: none; transition: background 0.17s, transform 0.14s; white-space: nowrap; }
      .action-btn-lock   { background: #fdecea; color: #c0392b; border: 1px solid #f5c6cb; }
      .action-btn-lock:hover   { background: #f8d7da; transform: translateY(-1px); }
      .action-btn-unlock { background: #e6f9f1; color: #1a7a4a; border: 1px solid #b8e8d0; }
      .action-btn-unlock:hover { background: #d0f1e2; transform: translateY(-1px); }
      .action-btn-modify { background: #eef4f7; color: #0f5a66; border: 1px solid #c9dde5; }
      .action-btn-modify:hover { background: #ddeef5; transform: translateY(-1px); }
      .empty-row td { text-align: center; color: #7a919e; font-style: italic; padding: 32px; }
    </style>
</head>
<body>
<div class="page-wrap">

  <!-- Top Bar -->
  <div class="top-bar">
    <h1>Manage Assessments</h1>
    <div class="top-bar-actions">
      <a href="/common/management" class="btn btn-outline">← Back to Management</a>
      <a href="/common/createTest?organizationId=<%= organizationId %>&termId=<%= termId %>" class="btn btn-primary">+ Create New Test</a>
    </div>
  </div>

  <%- include('../partials/flash') %>

  <!-- Table Card -->
  <div class="card">
    <div class="table-scroll">
      <table>
        <thead>
          <tr>
            <th>Test Name</th>
            <th>Weight (%)</th>
            <th>Max Score</th>
            <th>Category</th>
            <th>Status</th>
            <th>Assigned Classes</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          <% if (!assessments || assessments.length === 0) { %>
            <tr class="empty-row"><td colspan="7">No assessments found for this term.</td></tr>
          <% } %>
          <% (assessments || []).forEach(function(assessment, idx) { %>
            <tr>
              <td><strong><%= assessment.title %></strong></td>
              <td><%= assessment.weight %>%</td>
              <td><%= assessment.max_score %></td>
              <td><%= assessment.category %></td>

              <!-- Status -->
              <td>
                <span class="badge <%= assessment.is_locked ? 'badge-locked' : 'badge-unlocked' %>">
                  <%= assessment.is_locked ? '🔒 Locked' : '🔓 Unlocked' %>
                </span>
                <div class="window-info">
                  <% if (assessment.edit_window_start || assessment.edit_window_end) { %>
                    <% if (assessment.edit_window_start) { %>
                      <span>Start: <%= new Date(assessment.edit_window_start).toLocaleString() %></span>
                    <% } %>
                    <% if (assessment.edit_window_end) { %>
                      <span>End: &nbsp;&nbsp;<%= new Date(assessment.edit_window_end).toLocaleString() %></span>
                    <% } %>
                  <% } else { %>
                    <span style="color:#aab4bc;">No edit window set</span>
                  <% } %>
                </div>
                <span class="edit-pill <%= assessment.can_edit_scores ? 'edit-pill-yes' : 'edit-pill-no' %>">
                  <%= assessment.can_edit_scores ? 'Scores editable' : assessment.access_reason %>
                </span>
              </td>

              <!-- Assigned Classes -->
              <td>
                <button type="button" class="collapse-btn" onclick="toggleClasses('<%= idx %>')">
                  Classes <span class="collapse-arrow" id="arrow-<%= idx %>">▶</span>
                </button>
                <div class="collapse-body" id="col-<%= idx %>" style="display:none;">
                  <% Object.values(assessment.assigned_classes).forEach(function(cls) { %>
                    <div class="collapse-class-name"><%= cls.class_name %></div>
                    <ul>
                      <% cls.subjects.forEach(function(sub) { %><li><%= sub %></li><% }); %>
                    </ul>
                  <% }); %>
                </div>
              </td>

              <!-- Actions -->
              <td>
                <div class="actions-cell">
                  <button
                    type="button"
                    class="action-btn <%= assessment.is_locked ? 'action-btn-unlock' : 'action-btn-lock' %>"
                    onclick="updateControl('<%= assessment.group_id %>', '<%= organizationId %>', '<%= termId %>', '<%= assessment.is_locked ? 'unlock' : 'lock' %>')">
                    <%= assessment.is_locked ? '🔓 Unlock' : '🔒 Lock' %>
                  </button>
                  <a href="/common/modifyAssessment?groupId=<%= assessment.group_id %>&termId=<%= termId %>&organizationId=<%= organizationId %>" class="action-btn action-btn-modify">
                    ✏️ Modify
                  </a>
                </div>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  </div>

</div>

<script>
  async function updateControl(groupId, organizationId, termId, action) {
    try {
      const res = await fetch('/common/updateAssessmentControl', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ groupId, organizationId, termId, action }),
      });
      const result = await res.json();
      if (!res.ok) { alert(result.error || 'Failed to update.'); return; }
      window.location.reload();
    } catch (e) {
      alert('Failed to update control status.');
    }
  }

  function toggleClasses(idx) {
    const body  = document.getElementById('col-' + idx);
    const arrow = document.getElementById('arrow-' + idx);
    if (!body) return;
    const open = body.style.display !== 'none';
    body.style.display = open ? 'none' : 'block';
    arrow.textContent  = open ? '▶' : '▼';
  }
</script>
</body>
</html>
