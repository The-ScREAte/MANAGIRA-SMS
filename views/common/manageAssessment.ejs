<!DOCTYPE html>
<html lang="en">
<head>
  <link rel="stylesheet" href="/css/globalScale.css">
    <meta charset="UTF-8">
    <meta name="viewport" content="<%= locals.viewportContent || 'width=device-width, initial-scale=1.0, maximum-scale=1.0' %>">
    <title>Manage Assessments</title>
    <style>
      :root {
        --font-family: "<%= (session && session.fontStyle ? String(session.fontStyle).trim() : 'Inter') %>", sans-serif;
        --primary: var(--org-primary-color, #0f5a66);
        --primary-hover: var(--org-primary-hover, #0d4f59);
        --primary-hover-fill: color-mix(in srgb, var(--primary) 88%, white);
        --surface: #ffffff;
        --card-surface: white;
        --border-soft: #e5e7eb;
        --text-main: color-mix(in srgb, var(--primary) 72%, black);
        --text-soft: color-mix(in srgb, var(--primary) 46%, white);
        --table-head-bg: #f5f6f7;
        --row-even-bg: #fafafa;
        --row-hover-bg: #f1f2f3;
        --btn-disabled-bg: color-mix(in srgb, var(--primary) 10%, white);
        --btn-disabled-border: color-mix(in srgb, var(--primary) 20%, white);
        --btn-disabled-text: color-mix(in srgb, var(--primary) 36%, white);
        --pill-on-bg: color-mix(in srgb, var(--primary) 14%, white);
        --pill-on-text: color-mix(in srgb, var(--primary) 68%, black);
        --pill-off-bg: color-mix(in srgb, var(--primary) 8%, white);
        --pill-off-text: color-mix(in srgb, var(--primary) 44%, white);
        --lock-open-bg: #e7f7ee;
        --lock-open-border: #8cd0aa;
        --lock-open-text: #157347;
        --lock-closed-bg: #fdeaea;
        --lock-closed-border: #ef9a9a;
        --lock-closed-text: #c62828;
        --icon-btn-bg: color-mix(in srgb, var(--primary) 7%, white);
        --icon-btn-border: color-mix(in srgb, var(--primary) 18%, white);
        --icon-btn-hover: color-mix(in srgb, var(--primary) 13%, white);
        --shadow-soft: color-mix(in srgb, var(--primary) 15%, transparent);
      }
      *, *::before, *::after { box-sizing: border-box; }
      body { font-family: var(--font-family); background: #fff; margin: 0; color: var(--text-main); }
      .page-wrap { max-width: none; width: 100%; margin: 0; padding: 22px 24px 40px; box-sizing: border-box; }
      .top-bar { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 12px; margin-bottom: 24px; }
      .top-bar h1 { font-size: 1.38rem; font-weight: 700; margin: 0; color: var(--text-main); }
      .top-bar-actions { display: flex; gap: 10px; flex-wrap: wrap; }
      .btn { display: inline-flex; align-items: center; gap: 8px; padding: 9px 14px; border-radius: 10px; font-size: 0.84rem; font-weight: 700; cursor: pointer; text-decoration: none; border: none; transition: background 0.17s, transform 0.14s; white-space: nowrap; }
      .btn-primary { background: var(--primary); color: white; box-shadow: 0 3px 10px var(--shadow-soft); }
      .btn-primary:hover { background: var(--primary-hover-fill, var(--primary-hover)); transform: translateY(-1px); }
      .btn-outline { background: white; color: var(--primary); border: 2px solid var(--primary); }
      .btn-outline:hover { background: var(--table-head-bg); transform: translateY(-1px); }

      /* ---- Create Test drawer (AJAX, same slide-in-from-right pattern
         used by the Assessment Question Sets "Set Questions" panel) ---- */
      .ct-modal-overlay {
        position: fixed;
        inset: 0;
        background: rgba(10, 20, 30, 0.55);
        backdrop-filter: blur(3px);
        display: none;
        z-index: 10000;
        animation: ctFadeIn 0.2s ease;
      }
      .ct-modal-overlay.is-open {
        display: flex;
        align-items: stretch;
        justify-content: flex-end;
      }
      .ct-modal {
        position: relative;
        width: 100%;
        max-width: 1200px;
        height: 100%;
        min-height: 100%;
        max-height: 100%;
        background: linear-gradient(180deg, #f8fbff 0%, #eef4fa 100%);
        display: flex;
        flex-direction: column;
        box-shadow: -8px 0 40px rgba(0, 0, 0, 0.18);
        animation: ctSlideInRight 0.28s cubic-bezier(0.22, 1, 0.36, 1);
        overflow: hidden;
      }
      @keyframes ctSlideInRight {
        from { transform: translateX(100%); opacity: 0; }
        to   { transform: translateX(0);    opacity: 1; }
      }
      @keyframes ctFadeIn {
        from { opacity: 0; }
        to   { opacity: 1; }
      }
      .ct-modal-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: calc(13px + env(safe-area-inset-top, 0px)) 18px 12px;
        background: #fff;
        border-bottom: 1px solid #e2e8f0;
        flex-shrink: 0;
        gap: 12px;
      }
      .ct-modal-header-left { display: flex; align-items: center; gap: 10px; }
      .ct-modal-header-icon {
        width: 34px;
        height: 34px;
        background: linear-gradient(135deg, var(--primary) 0%, #1a8fa0 100%);
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 15px;
        flex-shrink: 0;
      }
      .ct-modal-header h2 { margin: 0; font-size: 0.95rem; font-weight: 700; color: #0f2d32; }
      .ct-modal-header p { margin: 0; font-size: 0.72rem; color: #64748b; }
      .ct-modal-close {
        width: 32px;
        height: 32px;
        border-radius: 8px;
        border: 1px solid #e2e8f0;
        background: #fff;
        color: #64748b;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: all 0.15s;
        flex-shrink: 0;
      }
      .ct-modal-close:hover { background: #fef2f2; border-color: #fca5a5; color: #dc2626; }
      .ct-modal-body { flex: 1; position: relative; overflow: hidden; }
      .ct-modal-iframe { width: 100%; height: 100%; border: none; display: block; }
      .ct-modal-loading {
        position: absolute;
        inset: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        color: #475569;
        font-size: 0.85rem;
      }
      .ct-modal-spinner {
        width: 16px;
        height: 16px;
        border: 2px solid rgba(15, 90, 102, 0.25);
        border-top-color: #0f5a66;
        border-radius: 50%;
        animation: ctSpin 0.7s linear infinite;
        flex-shrink: 0;
      }
      @keyframes ctSpin { to { transform: rotate(360deg); } }
      @media (max-width: 500px) {
        .ct-modal-overlay { padding: 0; }
        .ct-modal { border-radius: 0; }
      }

      /* ---- Modify Assessment drawer (AJAX, same slide-in-from-right
         pattern as the Create Test drawer above) ---- */
      .ma-modal-overlay {
        position: fixed;
        inset: 0;
        background: rgba(10, 20, 30, 0.55);
        backdrop-filter: blur(3px);
        display: none;
        z-index: 10000;
        animation: ctFadeIn 0.2s ease;
      }
      .ma-modal-overlay.is-open {
        display: flex;
        align-items: stretch;
        justify-content: flex-end;
      }
      .ma-modal {
        position: relative;
        width: 100%;
        max-width: 900px;
        height: 100%;
        min-height: 100%;
        max-height: 100%;
        background: linear-gradient(180deg, #f8fbff 0%, #eef4fa 100%);
        display: flex;
        flex-direction: column;
        box-shadow: -8px 0 40px rgba(0, 0, 0, 0.18);
        animation: ctSlideInRight 0.28s cubic-bezier(0.22, 1, 0.36, 1);
        overflow: hidden;
      }
      .ma-modal-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: calc(13px + env(safe-area-inset-top, 0px)) 18px 12px;
        background: #fff;
        border-bottom: 1px solid #e2e8f0;
        flex-shrink: 0;
        gap: 12px;
      }
      .ma-modal-header-left { display: flex; align-items: center; gap: 10px; }
      .ma-modal-header-icon {
        width: 34px;
        height: 34px;
        background: linear-gradient(135deg, var(--primary) 0%, #1a8fa0 100%);
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 15px;
        flex-shrink: 0;
      }
      .ma-modal-header h2 { margin: 0; font-size: 0.95rem; font-weight: 700; color: #0f2d32; }
      .ma-modal-header p { margin: 0; font-size: 0.72rem; color: #64748b; }
      .ma-modal-close {
        width: 32px;
        height: 32px;
        border-radius: 8px;
        border: 1px solid #e2e8f0;
        background: #fff;
        color: #64748b;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: all 0.15s;
        flex-shrink: 0;
      }
      .ma-modal-close:hover { background: #fef2f2; border-color: #fca5a5; color: #dc2626; }
      .ma-modal-body { flex: 1; position: relative; overflow: hidden; }
      .ma-modal-iframe { width: 100%; height: 100%; border: none; display: block; }
      .ma-modal-loading {
        position: absolute;
        inset: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        color: #475569;
        font-size: 0.85rem;
      }
      .ma-modal-spinner {
        width: 16px;
        height: 16px;
        border: 2px solid rgba(15, 90, 102, 0.25);
        border-top-color: #0f5a66;
        border-radius: 50%;
        animation: ctSpin 0.7s linear infinite;
        flex-shrink: 0;
      }
      @media (max-width: 500px) {
        .ma-modal-overlay { padding: 0; }
        .ma-modal { border-radius: 0; }
      }
      .btn-disabled {
        background: var(--btn-disabled-bg);
        color: var(--btn-disabled-text);
        border: 2px solid var(--btn-disabled-border);
        cursor: not-allowed;
        opacity: 0.9;
      }
      .card { background: var(--card-surface); border-radius: 14px; border: 1px solid var(--border-soft); box-shadow: 0 6px 22px var(--shadow-soft); overflow: hidden; }
      .table-scroll { overflow-x: auto; }
      table { width: 100%; border-collapse: collapse; min-width: 980px; font-size: 0.86rem; }
      thead th { background: var(--table-head-bg); color: var(--text-soft); font-weight: 700; padding: 12px 12px; text-align: left; letter-spacing: 0.2px; border-bottom: 1px solid var(--border-soft); white-space: nowrap; text-transform: uppercase; font-size: 0.73rem; }
      tbody tr { border-bottom: 1px solid var(--border-soft); }
      tbody tr:last-child { border-bottom: none; }
      tbody tr:nth-child(even) td { background: var(--row-even-bg); }
      tbody tr:hover td { background: var(--row-hover-bg); }
      td { padding: 11px 12px; vertical-align: middle; color: var(--text-main); }
      .table-name {
        display: block;
        font-weight: 700;
        color: var(--text-main);
        line-height: 1.35;
        white-space: normal;
        word-break: break-word;
      }
      .test-name-content {
        display: flex;
        align-items: flex-start;
        gap: 10px;
      }
      .test-name-content .table-name {
        flex: 0 1 auto;
      }
      .table-meta {
        margin-top: 0;
        display: flex;
        flex-direction: column;
        gap: 4px;
        padding-left: 12px;
        flex: 0 1 auto;
      }
      .lock-status-note {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 30px;
        height: 30px;
        padding: 0;
        border-radius: 9px;
      }
      .lock-status-note svg {
        width: 16px;
        height: 16px;
      }
      .lock-status-note.locked {
        background: var(--lock-closed-bg);
        color: var(--lock-closed-text);
        border: 1px solid var(--lock-closed-border);
      }
      .lock-status-note.open {
        background: var(--lock-open-bg);
        color: var(--lock-open-text);
        border: 1px solid var(--lock-open-border);
      }
      .editability-note {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        font-size: 0.75rem;
        font-weight: 700;
        color: var(--text-soft);
      }
      .editability-note svg {
        width: 12px;
        height: 12px;
      }
      .window-info { font-size: 0.74rem; color: var(--text-soft); line-height: 1.45; }
      .window-info span { display: block; }
      .collapse-btn { display: inline-flex; align-items: center; gap: 6px; padding: 6px 10px; background: var(--primary); color: white; border: none; border-radius: 999px; font-size: 0.76rem; font-weight: 700; cursor: pointer; transition: background 0.17s; }
      .collapse-btn:hover { background: var(--primary-hover-fill, var(--primary-hover)); }
      .collapse-btn svg { width: 12px; height: 12px; }
      .collapse-arrow { font-size: 10px; transition: transform 0.2s; }
      .collapse-body {
        margin-top: 8px;
        background: var(--table-head-bg);
        border-radius: 10px;
        border: 1px solid var(--border-soft);
        padding: 10px;
      }
      .assigned-class-list {
        display: flex;
        flex-direction: column;
        gap: 10px;
      }
      .assigned-class-card {
        background: rgba(255, 255, 255, 0.72);
        border: 1px solid var(--border-soft);
        border-radius: 10px;
        padding: 10px;
      }
      .collapse-class-name {
        font-size: 0.85rem;
        font-weight: 700;
        color: var(--text-main);
        margin-bottom: 8px;
      }
      .subject-chip-list {
        list-style: none;
        margin: 0;
        padding: 0;
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 6px;
        font-size: 0.8rem;
        color: var(--text-soft);
      }
      .subject-chip-list li {
        margin: 0;
        padding: 6px 8px;
        border-radius: 999px;
        background: white;
        border: 1px solid var(--border-soft);
        color: var(--text-main);
        line-height: 1.25;
      }
      .actions-cell { display: flex; gap: 8px; align-items: center; flex-wrap: nowrap; justify-content: flex-start; }
      .lock-action-btn {
        width: 32px;
        min-width: 32px;
        height: 32px;
        padding: 0;
        gap: 0;
        border-radius: 10px;
        justify-content: center;
      }
      .lock-action-btn svg {
        width: 15px;
        height: 15px;
        flex: 0 0 auto;
      }
      .lock-action-btn.locked {
        background: var(--lock-closed-bg);
        color: var(--lock-closed-text);
        border-color: var(--lock-closed-border);
      }
      .lock-action-btn.open {
        background: var(--lock-open-bg);
        color: var(--lock-open-text);
        border-color: var(--lock-open-border);
      }
      .lock-action-btn.locked:hover {
        background: #f9d7d7;
      }
      .lock-action-btn.open:hover {
        background: #d8f0e3;
      }
      .action-icon-btn {
        width: 32px;
        height: 32px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 10px;
        border: 1px solid var(--icon-btn-border);
        text-decoration: none;
        cursor: pointer;
        transition: transform 0.14s, background 0.16s, border-color 0.16s;
        background: var(--icon-btn-bg);
        color: var(--primary);
      }
      .action-icon-btn:hover { transform: translateY(-1px); background: var(--icon-btn-hover); }
      .action-icon-btn svg { width: 16px; height: 16px; }
      .action-icon-btn-lock { color: var(--primary); background: var(--icon-btn-bg); border-color: var(--icon-btn-border); }
      .action-icon-btn-lock:hover { background: var(--icon-btn-hover); }
      .action-icon-btn-unlock { color: var(--primary); background: var(--icon-btn-bg); border-color: var(--icon-btn-border); }
      .action-icon-btn-unlock:hover { background: var(--icon-btn-hover); }
      tr.is-focused-assessment > td { background: color-mix(in srgb, var(--primary, #01535b) 10%, transparent) !important; }
      tr.is-focused-assessment > td:first-child { box-shadow: inset 3px 0 0 var(--primary, #01535b); }
      tr.is-focused-assessment .lock-action-btn { outline: 2px solid var(--primary, #01535b); outline-offset: 2px; }
      .action-icon-btn-modify { color: var(--primary); background: var(--icon-btn-bg); border-color: var(--icon-btn-border); }
      .action-icon-btn-modify:hover { background: var(--icon-btn-hover); }
      .sr-only {
        position: absolute;
        width: 1px;
        height: 1px;
        padding: 0;
        margin: -1px;
        overflow: hidden;
        clip: rect(0, 0, 0, 0);
        white-space: nowrap;
        border: 0;
      }
      .empty-row td { text-align: center; color: var(--text-soft); font-style: italic; padding: 32px; }

      /* ── Small screen ── */
      @media (max-width: 760px) {
        .page-wrap { padding: 14px 12px 28px; }
        .top-bar { gap: 8px; margin-bottom: 14px; flex-wrap: wrap; align-items: center; }
        .top-bar h1 { font-size: 1.2rem; }
        .btn { flex: 0 0 auto; width: auto; justify-content: center; padding: 8px 10px; font-size: 0.78rem; }

        .card { background: transparent; border: none; box-shadow: none; }
        .table-scroll { overflow: visible; }
        table { min-width: 0; border-collapse: separate; border-spacing: 0 10px; }
        thead { display: none; }
        tbody tr {
          display: flex;
          flex-wrap: wrap;
          background: white;
          border: 1px solid var(--border-soft);
          border-radius: 12px;
          box-shadow: 0 4px 12px var(--shadow-soft);
          padding: 2px 0;
        }
        tbody tr:nth-child(even) td,
        tbody tr:hover td { background: transparent; }
        td {
          display: flex;
          align-items: flex-start;
          justify-content: space-between;
          gap: 12px;
          width: 100%;
          border-bottom: 1px dashed var(--border-soft);
          padding: 10px 12px;
        }
        tbody tr td:nth-child(2),
        tbody tr td:nth-child(3) {
          width: 50%;
        }
        tbody tr td:nth-child(2) {
          border-right: 1px dashed var(--border-soft);
        }
        tbody tr td:nth-child(3),
        tbody tr td:nth-child(3)::before,
        tbody tr td:nth-child(3) > * {
          white-space: nowrap;
        }
        td:last-child { border-bottom: none; }
        td::before {
          content: attr(data-label);
          color: var(--text-soft);
          font-weight: 700;
          font-size: 0.72rem;
          letter-spacing: 0.2px;
          text-transform: uppercase;
          flex: 0 0 38%;
        }
        td > * { max-width: 62%; }
        td[data-label="Test Name"] {
          display: block;
        }
        td[data-label="Test Name"]::before {
          display: block;
          margin-bottom: 4px;
        }
        td[data-label="Test Name"] > * {
          max-width: none;
        }
        td[data-label="Assigned"] {
          display: flex;
          flex-wrap: wrap;
          align-items: center;
          justify-content: space-between;
          gap: 8px;
        }
        td[data-label="Assigned"]::before {
          display: inline-block;
          margin-bottom: 0;
          flex: 0 0 auto;
        }
        td[data-label="Assigned"] > * {
          max-width: none;
        }
        .test-name-content {
          display: grid;
          grid-template-columns: minmax(0, auto) minmax(0, 1fr);
          align-items: start;
          gap: 8px;
        }
        .test-name-content .table-name {
          min-width: 0;
        }
        .actions-cell,
        .collapse-body { width: 100%; }
        .table-meta,
        .window-info { width: 100%; }
        .actions-cell { justify-content: flex-start; }
        .collapse-btn { margin-left: 0; width: fit-content; max-width: 100%; }
        .collapse-body,
        .assigned-class-list,
        .assigned-class-card { width: 100%; }

        .empty-row { padding: 0; }
        .empty-row td {
          display: block;
          border: none;
          text-align: center;
          padding: 18px 14px;
        }
        .empty-row td::before { display: none; }
      }

      @media (max-width: 640px) {
        .page-wrap { padding: 14px 12px 28px; }
        .top-bar { gap: 8px; margin-bottom: 14px; flex-wrap: wrap; align-items: center; }
        .top-bar h1 { font-size: 1.22rem; }
        .btn { flex: 0 0 auto; width: auto; padding: 7px 10px; font-size: 0.76rem; }
        td { padding: 9px 10px; }
        .table-meta {
          flex-direction: row;
          flex-wrap: wrap;
          align-items: center;
          gap: 6px 10px;
          padding-left: 8px;
        }
        .editability-note,
        .window-info {
          width: auto;
        }
        .window-info span {
          display: inline;
        }
        .window-info { font-size: 0.7rem; }
        .collapse-btn { padding: 5px 10px; font-size: 0.76rem; }
        .subject-chip-list { grid-template-columns: repeat(2, minmax(0, 1fr)); font-size: 0.76rem; }
        .collapse-class-name { font-size: 0.78rem; }
        .action-icon-btn { width: 30px; height: 30px; }
        .lock-action-btn { width: 30px; min-width: 30px; height: 30px; padding: 0; }
        .lock-status-note { width: 28px; height: 28px; }
      }
      @media (max-width: 420px) {
        .top-bar h1 { font-size: 1.15rem; }
        .top-bar-actions { gap: 6px; }
        .btn { flex: 0 0 auto; width: auto; font-size: 0.75rem; padding: 6px 9px; }
        td::before { flex-basis: 42%; font-size: 0.69rem; }
        td > * { max-width: 58%; }
      }
    </style>
</head>
<body>
<link rel="stylesheet" href="/css/manage.css" />
<link rel="stylesheet" href="/css/peoplePanel.css" />
<script src="/js/manage.js" defer></script>
<div class="page-wrap ws-root">

  <header class="ws-head">
    <div class="ws-head__text">
      <h1 class="ws-head__title">Assessments</h1>
      <p class="ws-head__sub">Tests and exams for this term. Select one to see its details.</p>
    </div>
    <div class="ws-head__actions">
      <button type="button" class="ws-btn ws-btn--primary" onclick="openCreateTestModal()"><i class="fa-solid fa-plus" aria-hidden="true"></i> New test</button>
    </div>
  </header>

  <%- include('../partials/flash') %>

  <%
    const _list = assessments || [];
    const _status = (a) => (!a.is_active ? 'Turned off' : a.is_locked ? 'Locked' : a.can_edit_scores ? 'Open' : 'Closed');
    const _day = (v) => (v ? new Date(v).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) : '');
    const _cats = Array.from(new Set(_list.map((a) => a.category).filter(Boolean))).sort();
    const _classNames = Array.from(new Set(_list.flatMap((a) => (a.assigned_classes || []).map((c) => c.class_name)).filter(Boolean))).sort((x, y) => x.localeCompare(y, undefined, { numeric: true }));
    const _panelData = _list.map((a) => ({
      id: String(a.group_id),
      title: a.title,
      status: _status(a),
      weight: a.weight,
      maxScore: a.max_score,
      scale: a.scale_base,
      category: a.category,
      windowStart: _day(a.edit_window_start),
      windowEnd: _day(a.edit_window_end),
      scores: a.scores_saved || 0,
      locked: Boolean(a.is_locked),
      classes: (a.assigned_classes || []).map((c) => ({ name: c.class_name, subjects: (c.subjects || []).filter(Boolean) })),
    }));
  %>
  <% if (!_list.length) { %>
    <div class="ws-card ws-empty"><strong>No assessments yet</strong>Choose New test to add one for this term.</div>
  <% } else { %>
  <div class="ux-layout">
    <aside class="ux-filters" id="uxFilters" aria-label="Filter assessments">
      <div class="ux-filters__head"><strong>Filters</strong><button type="button" class="ux-link" id="uxClear">Clear</button></div>
      <label class="ux-field"><span>Name</span><input type="search" id="uxName" placeholder="Find by name" autocomplete="off" /></label>
      <label class="ux-field"><span>Status</span>
        <select id="uxStatus"><option value="">Any status</option><option>Open</option><option>Closed</option><option>Locked</option><option>Turned off</option></select>
      </label>
      <label class="ux-field"><span>Category</span>
        <select id="uxCategory"><option value="">Any category</option><% _cats.forEach((c) => { %><option><%= c %></option><% }) %></select>
      </label>
      <label class="ux-field"><span>Class</span>
        <select id="uxClass"><option value="">Any class</option><% _classNames.forEach((c) => { %><option><%= c %></option><% }) %></select>
      </label>
      <p class="ux-shown" id="uxShown" aria-live="polite"></p>
    </aside>

    <div class="ws-table-wrap ws-cards-wrap">
      <table class="ws-table ws-cards">
        <thead>
          <tr>
            <th>Name</th>
            <th>Status</th>
            <th>Weight</th>
            <th>Out of</th>
            <th>Category</th>
            <th>Classes</th>
          </tr>
        </thead>
        <tbody id="uxBody">
          <% _list.forEach(function (a) { const st = _status(a); %>
            <tr class="ux-row" tabindex="0" data-group-id="<%= a.group_id %>"
                data-name="<%= String(a.title || '').toLowerCase() %>" data-status="<%= st %>" data-category="<%= a.category %>"
                data-classes="<%= (a.assigned_classes || []).map((c) => c.class_name).join('|') %>">
              <td class="ws-card-title"><strong><%= a.title %></strong></td>
              <td><span class="ws-pill <%= st === 'Open' ? 'ws-pill--green' : st === 'Locked' || st === 'Closed' ? 'ws-pill--amber' : '' %>"><%= st %></span></td>
              <td><%= a.weight %>%</td>
              <td><%= Number(a.max_score) %></td>
              <td><%= a.category %></td>
              <td><span class="ws-pill"><%= (a.assigned_classes || []).length %></span></td>
            </tr>
          <% }); %>
        </tbody>
      </table>
      <p class="ux-empty" id="uxEmpty" hidden>No assessments match these filters.</p>
    </div>
  </div>
  <% } %>

  <div class="ux-panel-backdrop" id="uxBackdrop" hidden></div>
  <aside class="ux-panel" id="uxPanel" role="dialog" aria-modal="true" aria-labelledby="uxPanelTitle" aria-hidden="true">
    <div class="ux-panel__bar">
      <button type="button" class="ux-link ux-back" id="uxBack" hidden><i class="fa-solid fa-arrow-left" aria-hidden="true"></i> Back</button>
      <strong id="uxPanelTitle">Assessment</strong>
      <button type="button" class="ux-close" id="uxClose" aria-label="Close"><svg width="18" height="18" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M15 5L5 15M5 5l10 10" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg></button>
    </div>
    <div class="ux-panel__body" id="uxPanelBody"></div>
    <div class="ux-panel__edit" id="uxPanelEdit" hidden>
      <div class="ux-panel__loading" id="uxEditLoading">Loading…</div>
      <iframe id="uxEditFrame" title="Edit assessment"></iframe>
    </div>
  </aside>
  <script type="application/json" id="uxAssessments"><%- JSON.stringify(_panelData).replace(/</g, '\\u003c') %></script>

</div>

<div class="ct-modal-overlay" id="ctModalOverlay" aria-hidden="true">
  <div class="ct-modal">
    <div class="ct-modal-header">
      <div class="ct-modal-header-left">
        <div class="ct-modal-header-icon">📝</div>
        <div>
          <h2 id="ctModalTitle">Create Test</h2>
          <p>Add one or more tests for this term</p>
        </div>
      </div>
      <button type="button" class="ct-modal-close" id="ctModalClose" title="Close">
        <svg width="18" height="18" viewBox="0 0 20 20" fill="none">
          <path d="M15 5L5 15M5 5l10 10" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
        </svg>
      </button>
    </div>
    <div class="ct-modal-body">
      <div class="ct-modal-loading" id="ctModalLoading">
        <span class="ct-modal-spinner" aria-hidden="true"></span>
        Loading…
      </div>
      <iframe class="ct-modal-iframe" id="ctModalIframe" title="Create Test" style="display:none;"></iframe>
    </div>
  </div>
</div>

<div class="ma-modal-overlay" id="maModalOverlay" aria-hidden="true">
  <div class="ma-modal">
    <div class="ma-modal-header">
      <div class="ma-modal-header-left">
        <div class="ma-modal-header-icon">✏️</div>
        <div>
          <h2 id="maModalTitle">Modify Assessment</h2>
          <p>Edit this test's details</p>
        </div>
      </div>
      <button type="button" class="ma-modal-close" id="maModalClose" title="Close">
        <svg width="18" height="18" viewBox="0 0 20 20" fill="none">
          <path d="M15 5L5 15M5 5l10 10" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
        </svg>
      </button>
    </div>
    <div class="ma-modal-body">
      <div class="ma-modal-loading" id="maModalLoading">
        <span class="ma-modal-spinner" aria-hidden="true"></span>
        Loading…
      </div>
      <iframe class="ma-modal-iframe" id="maModalIframe" title="Modify Assessment" style="display:none;"></iframe>
    </div>
  </div>
</div>

<script>
  /* ---- Filters and side panel ---- */
  (function () {
    var get = function (id) { return document.getElementById(id); };
    var rows = Array.prototype.slice.call(document.querySelectorAll('tr.ux-row'));
    var items = [];
    try { items = JSON.parse(get('uxAssessments').textContent) || []; } catch (e) { items = []; }
    var fields = ['uxName', 'uxStatus', 'uxCategory', 'uxClass'];
    function apply() {
      if (!get('uxName')) return;
      var name = get('uxName').value.trim().toLowerCase(), st = get('uxStatus').value, cat = get('uxCategory').value, cls = get('uxClass').value;
      var shown = 0;
      rows.forEach(function (row) {
        var d = row.dataset;
        var ok = (!name || d.name.indexOf(name) !== -1) && (!st || d.status === st) && (!cat || d.category === cat)
          && (!cls || ('|' + d.classes + '|').indexOf('|' + cls + '|') !== -1);
        row.hidden = !ok;
        if (ok) shown += 1;
      });
      get('uxShown').textContent = 'Showing ' + shown + ' of ' + rows.length;
      get('uxEmpty').hidden = shown !== 0;
    }
    if (get('uxName')) {
      fields.forEach(function (id) { var el = get(id); el.addEventListener(el.tagName === 'SELECT' ? 'change' : 'input', apply); });
      get('uxClear').addEventListener('click', function () { fields.forEach(function (id) { get(id).value = ''; }); apply(); });
      if (window.matchMedia('(max-width: 900px)').matches) document.querySelector('.ux-layout').classList.add('ux-filters-off');
      apply();
    }
    function esc(v) { return String(v == null ? '' : v).replace(/[&<>"']/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]; }); }
    function kv(label, value) { return value !== '' && value != null ? '<div class="ux-kv"><span>' + label + '</span><strong>' + esc(value) + '</strong></div>' : ''; }
    var current = null;
    function render(a) {
      var pill = a.status === 'Open' ? 'ws-pill--green' : a.status === 'Turned off' ? '' : 'ws-pill--amber';
      var html = '<div class="ux-who"><div><div class="ux-who__name">' + esc(a.title) + '</div><span class="ws-pill ' + pill + '">' + esc(a.status) + '</span></div></div>' +
        '<section class="ux-sec"><h3>Settings</h3>' + kv('Weight', a.weight + '%') + kv('Score out of', Number(a.maxScore)) + kv('Scaled to', a.scale) + kv('Category', a.category) + '</section>' +
        '<section class="ux-sec"><h3>Score entry</h3>' + kv('Status', a.status) + kv('Opens', a.windowStart) + kv('Closes', a.windowEnd) + kv('Scores saved', a.scores) + '</section>' +
        '<section class="ux-sec"><h3>Classes <span class="ux-count">' + a.classes.length + '</span></h3>' +
          a.classes.map(function (c) { return '<div class="ux-class"><strong>' + esc(c.name) + '</strong><span>' + esc(c.subjects.join(', ') || 'No subjects') + '</span></div>'; }).join('') + '</section>' +
        '<div class="ux-actions"><button type="button" class="ws-btn" id="uxLock"><i class="fa-solid ' + (a.locked ? 'fa-lock-open' : 'fa-lock') + '" aria-hidden="true"></i> ' + (a.locked ? 'Unlock' : 'Lock') + '</button>' +
        '<button type="button" class="ws-btn ws-btn--primary" id="uxEdit"><i class="fa-solid fa-pen" aria-hidden="true"></i> Edit</button></div>';
      get('uxPanelBody').innerHTML = html;
      get('uxEdit').addEventListener('click', function () { showEdit(a); });
      get('uxLock').addEventListener('click', function () {
        if (!window.confirm((a.locked ? 'Unlock' : 'Lock') + ' "' + a.title + '" for every class?')) return;
        updateControl(a.id, ctOrganizationId, ctTermId, a.locked ? 'unlock' : 'lock');
      });
    }
    function setMode(editing) {
      get('uxPanel').classList.toggle('is-editing', editing);
      get('uxPanelBody').hidden = editing;
      get('uxPanelEdit').hidden = !editing;
      get('uxBack').hidden = !editing;
      get('uxPanelTitle').textContent = editing ? 'Edit assessment' : 'Assessment';
    }
    function showEdit(a) {
      var frame = get('uxEditFrame'), loading = get('uxEditLoading');
      setMode(true);
      frame.style.visibility = 'hidden';
      loading.style.display = 'flex';
      frame.onload = function () {
        var path = null;
        try { path = frame.contentWindow.location.pathname; } catch (err) { /* ignore */ }
        if (path === '/common/manageAssessment') { window.location.reload(); return; }
        loading.style.display = 'none';
        frame.style.visibility = 'visible';
      };
      frame.src = '/common/modifyAssessment?groupId=' + encodeURIComponent(a.id) + '&organizationId=' + ctOrganizationId + '&termId=' + ctTermId + '&embed=workspace';
    }
    function open(id) {
      var a = items.find(function (x) { return x.id === String(id); });
      if (!a) return;
      current = a;
      render(a);
      setMode(false);
      get('uxBackdrop').hidden = false;
      get('uxPanel').classList.add('is-open');
      get('uxPanel').setAttribute('aria-hidden', 'false');
      rows.forEach(function (r) { r.classList.toggle('is-selected', r.dataset.groupId === String(id)); });
    }
    function close() {
      get('uxPanel').classList.remove('is-open', 'is-editing');
      get('uxPanel').setAttribute('aria-hidden', 'true');
      get('uxBackdrop').hidden = true;
      get('uxEditFrame').removeAttribute('src');
      rows.forEach(function (r) { r.classList.remove('is-selected'); });
    }
    window.openAssessmentPanel = open;
    get('uxClose').addEventListener('click', close);
    get('uxBackdrop').addEventListener('click', close);
    get('uxBack').addEventListener('click', function () { setMode(false); get('uxEditFrame').removeAttribute('src'); });
    document.addEventListener('keydown', function (e) { if (e.key === 'Escape' && get('uxPanel').classList.contains('is-open')) close(); });
    var body = get('uxBody');
    if (body) {
      body.addEventListener('click', function (e) { var row = e.target.closest('tr.ux-row'); if (row) open(row.dataset.groupId); });
      body.addEventListener('keydown', function (e) { if ((e.key === 'Enter' || e.key === ' ') && e.target.matches('tr.ux-row')) { e.preventDefault(); open(e.target.dataset.groupId); } });
    }
    // Opened from a locked assessment's pencil in the classroom: open that one.
    var focus = new URLSearchParams(window.location.search).get('focus');
    if (focus) setTimeout(function () { open(focus); }, 100);
  })();

  async function updateControl(groupId, organizationId, termId, action) {
    try {
      const res = await fetch('/common/updateAssessmentControl', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ groupId, organizationId, termId, action }),
      });
      const result = await res.json();
      if (!res.ok) { alert(result.error || 'Failed to update.'); return; }
      window.location.reload();
    } catch (e) {
      alert('Failed to update control status.');
    }
  }

  function toggleClasses(idx) {
    const body  = document.getElementById('col-' + idx);
    const arrow = document.getElementById('arrow-' + idx);
    if (!body) return;
    const open = body.style.display !== 'none';
    body.style.display = open ? 'none' : 'block';
    arrow.textContent  = open ? '▶' : '▼';
  }

  /* ---- Create Test drawer (AJAX, no page navigation) ---- */
  const ctOrganizationId = <%= Number(organizationId) %>;
  const ctTermId = <%= Number(termId) %>;
  let ctModalIframeLoaded = false;

  function openCreateTestModal() {
    const overlay = document.getElementById('ctModalOverlay');
    const iframe = document.getElementById('ctModalIframe');
    const loading = document.getElementById('ctModalLoading');
    if (!overlay || !iframe) return;

    if (!ctModalIframeLoaded) {
      iframe.addEventListener('load', function onLoad() {
        // createTest.ejs redirects itself to manageAssessment on a
        // successful save — when that happens inside our iframe, the test
        // is already saved, so close the drawer and refresh the list
        // instead of showing the list page a second time inside itself.
        let path = null;
        try { path = iframe.contentWindow.location.pathname; } catch (err) { /* cross-origin, ignore */ }
        if (path === '/common/manageAssessment') {
          window.location.reload();
          return;
        }

        ctModalIframeLoaded = true;
        if (loading) loading.style.display = 'none';
        iframe.style.display = 'block';
      });
      iframe.src = '/common/createTest?organizationId=' + ctOrganizationId + '&termId=' + ctTermId + '&embed=workspace';
    }

    overlay.classList.add('is-open');
    overlay.setAttribute('aria-hidden', 'false');
    document.body.style.overflow = 'hidden';
  }

  function closeCreateTestModal() {
    const overlay = document.getElementById('ctModalOverlay');
    if (!overlay) return;
    overlay.classList.remove('is-open');
    overlay.setAttribute('aria-hidden', 'true');
    document.body.style.overflow = '';
  }

  document.getElementById('ctModalClose').addEventListener('click', closeCreateTestModal);
  document.getElementById('ctModalOverlay').addEventListener('click', function (event) {
    if (event.target === this) closeCreateTestModal();
  });
  document.addEventListener('keydown', function (event) {
    if (event.key !== 'Escape') return;
    const overlay = document.getElementById('ctModalOverlay');
    if (overlay && overlay.classList.contains('is-open')) closeCreateTestModal();
  });

  /* ---- Modify Assessment drawer (AJAX, no page navigation) ---- */
  let maModalIframe = null;

  function openModifyAssessmentModal(groupId) {
    const overlay = document.getElementById('maModalOverlay');
    const iframe = document.getElementById('maModalIframe');
    const loading = document.getElementById('maModalLoading');
    if (!overlay || !iframe) return;

    // Each row edits a different assessment group, so unlike the other
    // drawers this one reloads its iframe fresh on every open instead of
    // caching a single load.
    iframe.style.display = 'none';
    if (loading) loading.style.display = 'flex';

    iframe.onload = function onLoad() {
      // modifyAssessment.ejs redirects itself to manageAssessment on a
      // successful save — when that happens inside our iframe, the change
      // is already saved, so close the drawer and refresh the list instead
      // of showing the list page a second time inside itself.
      let path = null;
      try { path = iframe.contentWindow.location.pathname; } catch (err) { /* cross-origin, ignore */ }
      if (path === '/common/manageAssessment') {
        window.location.reload();
        return;
      }

      if (loading) loading.style.display = 'none';
      iframe.style.display = 'block';
    };
    iframe.src = '/common/modifyAssessment?groupId=' + encodeURIComponent(groupId)
      + '&termId=' + ctTermId + '&organizationId=' + ctOrganizationId + '&embed=workspace';

    overlay.classList.add('is-open');
    overlay.setAttribute('aria-hidden', 'false');
    document.body.style.overflow = 'hidden';
  }

  function closeModifyAssessmentModal() {
    const overlay = document.getElementById('maModalOverlay');
    if (!overlay) return;
    overlay.classList.remove('is-open');
    overlay.setAttribute('aria-hidden', 'true');
    document.body.style.overflow = '';
  }

  document.getElementById('maModalClose').addEventListener('click', closeModifyAssessmentModal);
  document.getElementById('maModalOverlay').addEventListener('click', function (event) {
    if (event.target === this) closeModifyAssessmentModal();
  });
  document.addEventListener('keydown', function (event) {
    if (event.key !== 'Escape') return;
    const overlay = document.getElementById('maModalOverlay');
    if (overlay && overlay.classList.contains('is-open')) closeModifyAssessmentModal();
  });
</script>
</body>
</html>
