              <div class="feature-icon">
                <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                </svg>
              </div>
              <div class="feature-content">
                <h4>Approve/Reject</h4>
                <p>Accept or decline pending applications.</p>
              </div>
            </div>
          </div>
          <a href="/common/admissionPending" class="action-btn">
            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4"></path>
            </svg>
            View Pending Admissions
          </a>
        </div>
      </section>
      <% } %>
    </main>
  </div>
</div>

<script>
  (function initHubMenu() {
    const navLinks = document.querySelectorAll('.nav-link');
    const sections = document.querySelectorAll('.hub-section');
    const navToggle = document.getElementById('hub-nav-toggle');
    const nav = document.getElementById('hub-nav');
    const navClose = document.getElementById('hub-nav-close');
    const overlay = document.getElementById('hub-nav-overlay');
    const navCurrent = document.getElementById('hub-nav-current');

    const syncToggleLabel = activeLink => {
      if (!navCurrent || !activeLink) return;
      const label = activeLink.querySelector('span:last-child');
      navCurrent.textContent = label ? label.textContent.trim() : activeLink.textContent.trim();
    };

    const setNavOpen = isOpen => {
      nav.classList.toggle('open', isOpen);
      overlay.classList.toggle('show', isOpen && window.innerWidth > 900);
      navToggle.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
    };

    // Only initialize if elements exist
    if (!navToggle || !nav || !overlay) return;

    // Bind once per DOM instance. The SPA re-executes page scripts and
    // re-dispatches DOMContentLoaded on every navigation; without this guard
    // the toggle accumulates duplicate handlers and the menu opens then
    // immediately closes ("doesn't open").
    if (navToggle.dataset.spaMenuBound === '1') return;
    navToggle.dataset.spaMenuBound = '1';

    syncToggleLabel(document.querySelector('.nav-link.active'));

    // Section navigation
    navLinks.forEach(link => {
      link.addEventListener('click', function() {
        const sectionId = this.getAttribute('data-section');
        
        navLinks.forEach(l => l.classList.remove('active'));
        this.classList.add('active');
        syncToggleLabel(this);
        
        sections.forEach(s => s.classList.remove('active'));
        const targetSection = document.getElementById(sectionId);
        if (targetSection) targetSection.classList.add('active');

        if (window.innerWidth <= 900) setNavOpen(false);

        history.replaceState(null, null, '#' + sectionId);
      });
    });

    // Mobile navigation toggle
    navToggle.addEventListener('click', function(e) {
      e.stopPropagation();
      setNavOpen(!nav.classList.contains('open'));
    });

    navClose.addEventListener('click', function(e) {
      e.stopPropagation();
      setNavOpen(false);
    });

    overlay.addEventListener('click', function(e) {
      e.stopPropagation();
      setNavOpen(false);
    });

    document.addEventListener('click', function(e) {
      if (window.innerWidth > 900 || !nav.classList.contains('open')) return;
      if (nav.contains(e.target) || navToggle.contains(e.target)) return;
      setNavOpen(false);
    });

    window.addEventListener('resize', function() {
      if (window.innerWidth > 900) setNavOpen(false);
    });

    // Handle initial hash
    if (window.location.hash) {
      const sectionId = window.location.hash.substring(1);
      const targetLink = document.querySelector(`.nav-link[data-section="${sectionId}"]`);
      if (targetLink) targetLink.click();
    }
  })();
</script>
