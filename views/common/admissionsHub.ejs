<%
  // Theme color mapping for organization buttons
  const themeColor = (typeof session !== 'undefined' && session && session.themeColor) ? session.themeColor : 'teal';
  const themeColors = {
    teal: { primary: '#01535b', hover: '#014a51' },
    blue: { primary: '#2563eb', hover: '#1d4ed8' },
    green: { primary: '#2e7d32', hover: '#1b5e20' },
    purple: { primary: '#7c3aed', hover: '#6d28d9' },
    indigo: { primary: '#4f46e5', hover: '#4338ca' },
    rose: { primary: '#8b2635', hover: '#7a212e' },
    amber: { primary: '#d97706', hover: '#b45309' },
    slate: { primary: '#334155', hover: '#1e293b' },
    cyan: { primary: '#0891b2', hover: '#0e7490' },
    orange: { primary: '#ea580c', hover: '#c2410c' },
    charcoal: { primary: '#1f2937', hover: '#111827' },
    classic: { primary: '#01535b', hover: '#014a51' },
    bold: { primary: '#0b1020', hover: '#ffb703' },
    modern: { primary: '#2563eb', hover: '#1d4ed8' },
    minimal: { primary: '#7c3aed', hover: '#6d28d9' },
    gold: { primary: '#d4a017', hover: '#b8860b' },
    red: { primary: '#e11d48', hover: '#be123c' },
    brown: { primary: '#7c4a03', hover: '#5c3802' }
  };
  const currentTheme = themeColors[themeColor] || themeColors.teal;
  const hasPendingAdmissions = Array.isArray(allowedFeatures) && (allowedFeatures.includes('School Website') || allowedFeatures.includes('SchoolWebsite'));
%>

<style>
  :root {
    --border: #e5e7eb;
    --muted: #6b7280;
    --bg: #f9fafb;
    --primary: <%= currentTheme.primary %>;
    --primary-hover: <%= currentTheme.hover %>;
    --primary-hover-fill: color-mix(in srgb, var(--primary) 88%, white);
    --org-primary-color: <%= currentTheme.primary %>;
    --org-primary-hover: <%= currentTheme.hover %>;
    --org-primary-hover-fill: color-mix(in srgb, var(--org-primary-color) 88%, white);
  }

  body {
    background: #f9fafb;
  }

  main {
    padding: 0 !important;
    max-width: none !important;
  }

  .hub-wrapper {
    width: 100%;
    height: calc(100vh - 68px);
    overflow: hidden;
  }

  .hub-layout {
    display: grid;
    grid-template-columns: 260px 1fr;
    gap: 24px;
    max-width: none;
    margin: 12px 0 0;
    padding: 0 20px 12px;
    align-items: start;
    height: calc(100% - 12px);
    min-height: 0;
  }

  /* workspace-shell.css (loaded after this block) also targets .hub-nav and
     .hub-section.active with rules that would win on source order at equal
     specificity — scope these under .hub-layout so they win on specificity
     instead, keeping the flex chain that lets the iframe below fill the
     panel's real height and scroll internally instead of the outer page. */
  .hub-layout .hub-nav {
    border: 1px solid var(--border);
    border-radius: 14px;
    padding: 16px 12px;
    background: #fff;
    height: 100%;
    box-shadow: 0 10px 26px rgba(15, 23, 42, 0.08);
    overflow-y: auto;
  }

  .hub-nav-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin: 4px 12px 12px;
    width: 100%;
  }

  .hub-nav h3 {
    margin: 0;
    font-size: 18px;
    color: var(--primary);
    font-weight: 700;
  }

  .nav-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 2px;
  }

  .nav-list li {
    margin: 0;
  }

  .nav-link {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 10px 14px !important;
    min-height: 42px;
    border-radius: 10px;
    color: #111827;
    text-decoration: none;
    border: 1px solid transparent;
    width: 100%;
    background: transparent;
    cursor: pointer;
    font: inherit;
    text-align: left;
    font-weight: 600;
    font-size: 14px;
    transition: all 0.2s ease;
    flex-direction: row;
    justify-content: flex-start;
    box-sizing: border-box;
  }

  .nav-link:hover {
    background: #f3f4f6;
    border-color: #e5e7eb;
  }

  .nav-link.active {
    background: var(--primary);
    color: #fff;
    border-color: var(--primary);
  }

  .nav-link.active:hover {
    background: var(--primary-hover-fill, var(--primary-hover));
  }

  .nav-link svg {
    color: inherit;
  }

  .nav-link-icon {
    display: inline-flex;
    flex-shrink: 0;
  }

  .nav-link-icon svg {
    width: 18px;
    height: 18px;
  }

  .hub-main {
    padding: 0;
    background: #fff;
    border-radius: 14px;
    border: 1px solid var(--border);
    box-shadow: 0 10px 30px rgba(15, 23, 42, 0.06);
    overflow: hidden;
    height: 100%;
    min-height: 0;
    display: flex;
    flex-direction: column;
  }

  .hub-layout .hub-section {
    display: none;
    flex: 1;
    min-height: 0;
  }

  .hub-layout .hub-section.active {
    display: flex;
    flex-direction: column;
    flex: 1;
    min-height: 0;
  }

  .embed-panel-body {
    position: relative;
    flex: 1;
    display: flex;
    flex-direction: column;
    min-height: 0;
  }

  .embed-overlay-spinner {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    background: rgba(255, 255, 255, 0.82);
    color: var(--muted);
    font-size: 14px;
    z-index: 5;
  }

  .embed-overlay-spinner[hidden] {
    display: none;
  }

  .embed-iframe {
    width: 100%;
    border: 0;
    display: block;
    /* Fills the panel and scrolls its own content internally — the outer
       hub page never grows past the viewport, so there's only ever one
       scrollbar (the iframe's), not two. */
    flex: 1;
    height: 100%;
    min-height: 0;
  }

  .embed-placeholder {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    gap: 10px;
    padding: 60px 24px;
    color: var(--muted);
  }

  .embed-placeholder svg {
    width: 32px;
    height: 32px;
    color: var(--primary);
    opacity: 0.7;
  }

  .embed-placeholder p {
    margin: 0;
    font-size: 14px;
  }

  .embed-loading {
    flex: 1;
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 60px 20px;
    justify-content: center;
    color: var(--muted);
    font-size: 14px;
  }

  .embed-error {
    padding: 24px;
    color: #b3261e;
    font-size: 14px;
    line-height: 1.6;
  }

  .embed-error a {
    color: var(--primary);
    font-weight: 600;
  }

  .btn-spinner {
    display: inline-block;
    width: 16px;
    height: 16px;
    border: 2px solid rgba(1, 83, 91, 0.2);
    border-top-color: var(--primary);
    border-radius: 50%;
    animation: embed-spin 0.7s linear infinite;
  }

  @keyframes embed-spin {
    to { transform: rotate(360deg); }
  }

  /* Mobile navigation */
  .hub-nav-toggle {
    display: none;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    padding: 8px 12px !important;
    border-radius: 8px;
    border: 1px solid var(--border);
    background: #fff;
    cursor: pointer;
    font: inherit;
    font-weight: 600;
    font-size: 13px;
    color: var(--primary);
    margin: 0;
    width: 100%;
    box-shadow: 0 4px 14px rgba(15, 23, 42, 0.04);
  }

  .hub-nav-toggle-label,
  .hub-nav-toggle-text {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }

  .hub-nav-toggle-current {
    color: #64748b;
    font-weight: 500;
  }

  .hub-nav-toggle-caret {
    width: 10px;
    height: 10px;
    border-right: 2px solid currentColor;
    border-bottom: 2px solid currentColor;
    transform: rotate(45deg);
    transition: transform 0.2s ease;
    margin-top: -2px;
  }

  .hub-nav-toggle[aria-expanded="true"] .hub-nav-toggle-caret {
    transform: rotate(-135deg);
    margin-top: 4px;
  }

  .hub-nav-toggle .hub-hamburger-icon {
    position: relative;
    width: 18px;
    height: 2px;
    background: var(--primary);
    display: inline-block;
  }

  .hub-nav-toggle .hub-hamburger-icon::before,
  .hub-nav-toggle .hub-hamburger-icon::after {
    content: "";
    position: absolute;
    left: 0;
    width: 18px;
    height: 2px;
    background: var(--primary);
  }

  .hub-nav-toggle .hub-hamburger-icon::before { top: -6px; }
  .hub-nav-toggle .hub-hamburger-icon::after { top: 6px; }

  .hub-nav-close {
    display: none;
    background: transparent;
    border: none;
    font-size: 24px;
    cursor: pointer;
    padding: 4px 8px;
    color: #6b7280;
    line-height: 1;
  }

  .hub-nav-close:hover {
    color: #111827;
  }

  /* Desktop-only rail collapse: shrinks the sidebar to icon-only width and
     hands the freed grid column over to .hub-main. Hidden on mobile (see
     media query below) since the sidebar is already an overlay there.
     Kept to fast (<=160ms), cheap-to-animate properties (opacity/max-width/
     transform, one grid-template-columns transition) so it stays snappy. */
  .hub-layout {
    transition: grid-template-columns 0.16s ease;
  }

  .hub-layout.is-nav-collapsed {
    grid-template-columns: 76px 1fr;
  }

  .hub-nav-collapse-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    border-radius: 8px;
    border: 1px solid var(--border);
    background: #fff;
    color: #6b7280;
    cursor: pointer;
    padding: 0;
    flex-shrink: 0;
    transition: color 0.15s ease, border-color 0.15s ease, background-color 0.15s ease, transform 0.1s ease;
  }

  .hub-nav-collapse-toggle:hover {
    color: var(--primary);
    border-color: var(--primary);
    background: #f8fafc;
  }

  .hub-nav-collapse-toggle:active {
    transform: scale(0.9);
  }

  .hub-nav-collapse-toggle svg {
    width: 16px;
    height: 16px;
  }

  .hub-nav.is-collapsed .hub-nav-collapse-toggle {
    color: var(--primary);
    border-color: var(--primary);
  }

  .hub-nav-header h3 {
    opacity: 1;
    transition: opacity 0.1s ease;
  }

  .hub-nav.is-collapsed .hub-nav-header {
    justify-content: center;
    margin-left: 0;
    margin-right: 0;
  }

  .hub-nav.is-collapsed .hub-nav-header h3 {
    display: none;
    opacity: 0;
  }

  .hub-nav.is-collapsed .nav-link {
    justify-content: center;
    padding: 10px !important;
    gap: 0;
  }

  .nav-link > span:not(.nav-link-icon) {
    display: inline-block;
    max-width: 220px;
    opacity: 1;
    white-space: nowrap;
    overflow: hidden;
    transition: opacity 0.12s ease, max-width 0.16s ease;
  }

  .hub-nav.is-collapsed .nav-link > span:not(.nav-link-icon) {
    opacity: 0;
    max-width: 0;
  }

  .hub-nav-overlay {
    position: fixed;
    inset: 0;
    background: rgba(15, 23, 42, 0.4);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.25s ease;
    z-index: 1000;
  }

  .hub-nav-overlay.show {
    opacity: 1;
    pointer-events: auto;
  }

  @media (max-width: 900px) {
    .hub-nav-toggle {
      display: flex;
    }
    .hub-nav-close { display: none; }
    .hub-nav-collapse-toggle { display: none; }

    /* Same collapse pattern as the class dashboard: the sidebar becomes a
       hamburger-triggered overlay and the content column takes the full
       width below it, instead of squeezing both into a cramped row.
       .hub-nav is display:none on mobile (it becomes an overlay), so the
       grid only has 2 visible children here — the toggle button and
       .hub-main — which stack into two ROWS instead of sitting side-by-side
       in one row like on desktop. Without an explicit row size, the
       toggle's row sizes to its content and the leftover space in the
       fixed-height .hub-layout is never handed to .hub-main's row,
       collapsing the iframe inside it to near nothing and leaving a blank
       gap. Give the second row the rest. */
    .hub-layout {
      grid-template-columns: 1fr !important;
      grid-template-rows: auto 1fr !important;
    }
  }
</style>
<link rel="stylesheet" href="/css/workspace-shell.css" />

<div class="hub-nav-overlay" id="hub-nav-overlay"></div>

<div class="hub-wrapper">
  <div class="hub-layout" id="hub-layout">
    <!-- Mobile Toggle Button -->
    <button class="hub-nav-toggle" id="hub-nav-toggle" type="button" aria-expanded="false" aria-controls="hub-nav">
      <span class="hub-nav-toggle-label">
        <span class="hub-hamburger-icon"></span>
        <span>Menu</span>
      </span>
    </button>

    <!-- Sidebar -->
    <nav class="hub-nav" id="hub-nav">
      <div class="hub-nav-header">
        <h3>Admissions</h3>
        <button class="hub-nav-collapse-toggle" id="hub-nav-collapse-toggle" type="button" aria-label="Collapse sidebar" aria-expanded="true" title="Collapse sidebar">
          <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><rect x="3" y="4" width="18" height="16" rx="2"></rect><line x1="9" y1="4" x2="9" y2="20"></line></svg>
        </button>
        <button class="hub-nav-close" id="hub-nav-close">&times;</button>
      </div>
      <ul class="nav-list">
        <li>
          <a class="nav-link active" href="/common/allStudents" data-no-spa data-section="all-students" data-embed-url="/common/allStudents" data-embed-label="All Students">
            <span class="nav-link-icon"><svg fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"/></svg></span>
            <span>All Students</span>
          </a>
        </li>
        <li>
          <a class="nav-link" href="/common/addStudent" data-no-spa data-section="create-student" data-embed-url="/common/addStudent" data-embed-label="Add New Student">
            <span class="nav-link-icon"><svg fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><circle cx="9" cy="8" r="4"/><path d="M2 21c0-3.866 3.134-7 7-7s7 3.134 7 7"/><path d="M19 8v6M16 11h6"/></svg></span>
            <span>Create Student</span>
