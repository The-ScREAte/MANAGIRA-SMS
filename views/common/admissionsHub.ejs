    </main>
  </div>
</div>

<script>
  (function initHubMenu() {
    const navLinks = document.querySelectorAll('.nav-link');
    const sections = document.querySelectorAll('.hub-section');
    const navToggle = document.getElementById('hub-nav-toggle');
    const nav = document.getElementById('hub-nav');
    const navClose = document.getElementById('hub-nav-close');
    const overlay = document.getElementById('hub-nav-overlay');
    const navCollapseToggle = document.getElementById('hub-nav-collapse-toggle');
    const layout = document.getElementById('hub-layout');

    const setNavOpen = isOpen => {
      nav.classList.toggle('open', isOpen);
      overlay.classList.toggle('show', isOpen && window.innerWidth > 900);
      navToggle.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
    };

    // Desktop-only icon-rail collapse. Remembered across page loads so the
    // hub doesn't jump back to the wide sidebar every time an embedded
    // panel link reloads this page.
    const NAV_COLLAPSE_STORAGE_KEY = 'managira-hub-nav-collapsed';
    if (navCollapseToggle && nav && layout) {
      const setNavCollapsed = isCollapsed => {
        nav.classList.toggle('is-collapsed', isCollapsed);
        layout.classList.toggle('is-nav-collapsed', isCollapsed);
        navCollapseToggle.setAttribute('aria-expanded', isCollapsed ? 'false' : 'true');
        navCollapseToggle.setAttribute('title', isCollapsed ? 'Expand sidebar' : 'Collapse sidebar');
      };

      let storedCollapsed = false;
      try {
        storedCollapsed = localStorage.getItem(NAV_COLLAPSE_STORAGE_KEY) === '1';
      } catch (_) {}
      setNavCollapsed(storedCollapsed);

      navCollapseToggle.addEventListener('click', () => {
        const isCollapsed = !nav.classList.contains('is-collapsed');
        setNavCollapsed(isCollapsed);
        try {
          localStorage.setItem(NAV_COLLAPSE_STORAGE_KEY, isCollapsed ? '1' : '0');
        } catch (_) {}
      });
    }

    if (!navToggle || !nav || !overlay) return;

    if (navToggle.dataset.spaMenuBound === '1') return;
    navToggle.dataset.spaMenuBound = '1';

    // Tracks whichever panel is currently on-screen, so the load handler
    // below knows it's safe to update the address bar when that panel's
    // iframe navigates internally (e.g. clicking a link inside it) — a
    // background-preloaded panel's internal navigation must never touch
    // the URL, since the user isn't looking at it.
    let activeGroup = null;

    function activateSectionOnly(sectionId) {
      activeGroup = sectionId;
      const navLink = document.querySelector(`.nav-link[data-section="${sectionId}"]`);

      navLinks.forEach(l => l.classList.remove('active'));
      if (navLink) navLink.classList.add('active');

      sections.forEach(s => s.classList.remove('active'));
      const targetSection = document.getElementById(sectionId);
      if (targetSection) targetSection.classList.add('active');

      if (window.innerWidth <= 900) {
        setNavOpen(false);
      }
    }

    function setEmbedLinkActive(url) {
      document.querySelectorAll('.nav-link').forEach(l => l.classList.remove('active'));
      document.querySelectorAll(`[data-embed-url="${CSS.escape(url)}"]`).forEach(l => l.classList.add('active'));
    }

    // Each destination is its own full standalone page with its own <head>
    // styles and breakpoints. Loading it in a same-origin iframe — instead
    // of fetching the HTML and injecting it into this page — means it
    // renders exactly as it would in its own tab: its CSS/JS never collides
    // with ours, and its responsive layout reacts to its own real
    // rendering width instead of getting confused by a foreign container.
    // Adds ?embed=workspace to the target URL. The destination controllers
    // recognize this flag (same convention used across the app) and skip
    // rendering the global header/footer/chatbot for that request, since
    // this page already has its own.
    function withEmbedFlag(url) {
      const separator = url.includes('?') ? '&' : '?';
      return url + separator + 'embed=workspace';
    }

    // Inverse of withEmbedFlag — used to read back the iframe's *current*
    // location (after it has navigated internally, e.g. following a link)
    // as a clean, storable URL, stripped of the embed marker we added.
    // Guards against "about:blank" (the browser's own placeholder for an
    // iframe that hasn't finished navigating yet) so a load event racing
    // ahead of the real navigation can never get captured as a real page.
    function stripEmbedFlag(href) {
      if (!href || href === 'about:blank') return null;
      try {
        const parsed = new URL(href, window.location.href);
        parsed.searchParams.delete('embed');
        return parsed.pathname + parsed.search + parsed.hash;
      } catch (err) {
        return null;
      }
    }

    // Full-page dashboards were never designed to render squeezed inside a
    // hub panel — if an embedded page's own navigation (a redirect, a link)
    // ever lands on one of these, break all the way out to a real top-level
    // page load instead of leaving it stuck inside the iframe. Returns true
    // if it fired, so the caller can skip its own iframe-specific handling.
    function escapeIframeForFullPageDashboard(href) {
      if (!href) return false;
      if (/^\/common\/(orgDashboard|publicDashboard)(?:[/?]|$)/.test(href)) {
        window.top.location.href = href;
        return true;
      }
      return false;
    }

    // Same-origin — nudge the loaded page to sit flush left instead of
    // centered with wide side margins, now that it has the full panel
    // width to itself and no longer needs to leave room for a header.
    function leftAlignEmbeddedDoc(iframe) {
      try {
        const doc = iframe.contentDocument;
        if (doc && doc.head && !doc.getElementById('__hub-left-align')) {
          const style = doc.createElement('style');
          style.id = '__hub-left-align';
          style.textContent = 'body{margin-left:0 !important;} main{margin-left:0 !important; margin-right:0 !important;}';
          doc.head.appendChild(style);
        }
      } catch (err) {
        // Cross-origin — nothing more we can do.
      }
    }

    // Watches for the iframe navigating to a NEW document — same-origin
    // pages inside it (Save buttons, etc.) trigger real navigations we
    // don't otherwise get a callback for. pagehide fires right as that
    // starts, so we can show the spinner again immediately instead of
    // leaving a frozen-looking page until the next one arrives.
    // (Deliberately NOT beforeunload: a beforeunload listener on ANY
    // frame — including a subframe like this iframe — disqualifies the
    // whole top-level hub page from the browser's back-forward cache,
    // forcing a full reload every time a user leaves for a full-page
    // destination and clicks Back.)
    function watchForInternalNavigation(iframe, overlay) {
      try {
        const win = iframe.contentWindow;
        if (!win) return;
        win.addEventListener('pagehide', function() {
          overlay.hidden = false;
        });
      } catch (err) {
        // Cross-origin — nothing more we can do.
      }
    }

    // Keeps track of which URL is currently loaded (and cached, ready to
    // reuse) in each panel's iframe, so switching between sections you've
    // already visited is instant instead of re-fetching and re-rendering
    // every single time.
    const loadedPanelUrls = {};

    // Remembers the sidebar label for whichever URL is currently loaded in
    // each panel, so the polling backstop below can rebuild a proper hub
    // URL (with a human-readable label) without having to guess one.
    const panelLabels = {};

    // Backstop that keeps the address bar honest even when a single 'load'
    // event isn't enough to catch it — multi-step redirects inside the
    // embedded page, or a browser quirk around the timing of that event,
    // can otherwise leave the URL pointing at a stale page. This just
    // samples the truth every second: if the panel you're actually looking
    // at has navigated somewhere new (same-origin, so we can read it),
    // sync the address bar to match. Background-preloaded panels are never
    // touched since activeGroup only ever names the one on-screen.
    setInterval(function () {
      if (!activeGroup) return;
      const panel = document.querySelector('#' + activeGroup + ' .embed-panel-body');
      if (!panel) return;
      const iframe = panel.querySelector('.embed-iframe');
      if (!iframe) return;

      let currentHref;
      try {
        currentHref = stripEmbedFlag(iframe.contentWindow.location.href);
      } catch (err) {
        return; // Cross-origin — nothing more we can do.
      }
      if (!currentHref || loadedPanelUrls[activeGroup] === currentHref) return;
      if (escapeIframeForFullPageDashboard(currentHref)) return;

      loadedPanelUrls[activeGroup] = currentHref;
      const label = panelLabels[activeGroup];
      const hubUrl = '/common/admissions?panel=' + encodeURIComponent(activeGroup)
        + '&page=' + encodeURIComponent(currentHref)
        + (label ? '&label=' + encodeURIComponent(label) : '');
      history.replaceState({ embedGroup: activeGroup, embedUrl: currentHref, embedLabel: label }, '', hubUrl);
    }, 1000);

    function loadEmbed(group, url, label, pushHistory, background) {
      if (escapeIframeForFullPageDashboard(url)) return;
      if (label) panelLabels[group] = label;
      const panel = document.querySelector('#' + group + ' .embed-panel-body');
      if (!panel) {
        if (!background) window.location.href = url;
        return;
      }

      // Already loaded in this panel — just make sure it's the visible/
      // active one and skip straight past the fetch + spinner entirely.
      if (loadedPanelUrls[group] === url && panel.querySelector('.embed-iframe')) {
        if (!background) {
          setEmbedLinkActive(url);
          if (pushHistory !== false) {
            const hubUrl = '/common/admissions?panel=' + encodeURIComponent(group)
              + '&page=' + encodeURIComponent(url)
              + (label ? '&label=' + encodeURIComponent(label) : '');
            history.pushState({ embedGroup: group, embedUrl: url, embedLabel: label }, '', hubUrl);
          }
        }
        return;
      }

      // A silent background preload only ever needs to happen once per
      // panel — if something's already mid-flight (or finished) in there,
      // leave it alone instead of restarting the load.
      if (background && panel.querySelector('.embed-iframe')) return;

      // A load for this exact URL in this exact panel is already in flight
      // — most often the background preload queue got to it but hasn't
      // finished yet, and the user clicked over before it did. Its own
      // 'load' listener (already attached) will finish the job: hide the
      // spinner, reveal the iframe, and record it in loadedPanelUrls.
      // Tearing it down here to "start fresh" would throw away that
      // progress and force a whole second fetch — exactly what made
      // switching to a panel feel like it never learned to cache itself.
      // Just surface it and let it land. (Scoped to the same target URL
      // only — if the panel's existing iframe has since navigated
      // somewhere else internally, e.g. drilled into a sub-page, this nav
      // click should still reset it back to its own canonical page like
      // normal, not leave the sub-page showing.)
      const inFlightIframe = panel.querySelector('.embed-iframe');
      const inFlightMatchesTarget = inFlightIframe
        && inFlightIframe.src === new URL(withEmbedFlag(url), window.location.href).href;
      if (inFlightMatchesTarget) {
        if (!background) {
          setEmbedLinkActive(url);
          if (pushHistory !== false) {
            const hubUrl = '/common/admissions?panel=' + encodeURIComponent(group)
              + '&page=' + encodeURIComponent(url)
              + (label ? '&label=' + encodeURIComponent(label) : '');
            history.pushState({ embedGroup: group, embedUrl: url, embedLabel: label }, '', hubUrl);
          }
          if (inFlightIframe.style.display === 'none') {
            const overlay = panel.querySelector('.embed-overlay-spinner');
            if (overlay) overlay.hidden = false;
          }
        }
        return;
      }

      if (background) {
        // Clear out the static placeholder without showing a spinner —
        // nothing here is visible yet, it's just warming up for later.
        panel.innerHTML = '';
      } else {
        setEmbedLinkActive(url);
        panel.innerHTML = '<div class="embed-loading"><span class="btn-spinner" aria-hidden="true"></span>Loading ' + (label || 'page') + '…</div>';
      }

      const iframe = document.createElement('iframe');
      iframe.className = 'embed-iframe';
      iframe.title = label || 'Embedded page';
      iframe.style.display = 'none';

      const overlay = document.createElement('div');
      overlay.className = 'embed-overlay-spinner';
      overlay.hidden = true;
      overlay.innerHTML = '<span class="btn-spinner" aria-hidden="true"></span>Loading…';

      iframe.addEventListener('load', function onLoad() {
        // The very first "load" a freshly-inserted iframe fires can be for
        // the browser's own "about:blank" placeholder, racing ahead of the
        // real navigation we asked for — ignore it completely so it never
        // gets treated as the real page (it has no relation to `url`).
        if (iframe.contentWindow && iframe.contentWindow.location.href === 'about:blank') {
          return;
        }

        try {
          if (escapeIframeForFullPageDashboard(stripEmbedFlag(iframe.contentWindow.location.href))) return;
        } catch (err) {
          // Cross-origin — nothing more we can do.
        }

        const loading = panel.querySelector('.embed-loading');
        if (loading) loading.remove();
        iframe.style.display = 'block';
        overlay.hidden = true;
        leftAlignEmbeddedDoc(iframe);
        watchForInternalNavigation(iframe, overlay);

        // The iframe may have landed here via its OWN internal navigation
        // (a link clicked inside the embedded page), not just our initial
        // load — same-origin, so we can read its real current location.
        // Re-sync our URL/cache to wherever it actually ended up, so a
        // refresh of the hub page lands back on THIS page instead of
        // snapping back to whatever was first opened in this panel.
        try {
          const currentHref = stripEmbedFlag(iframe.contentWindow.location.href);
          if (currentHref && currentHref !== url) {
            url = currentHref;
            if (!background && group === activeGroup) {
              const hubUrl = '/common/admissions?panel=' + encodeURIComponent(group)
                + '&page=' + encodeURIComponent(url)
                + (label ? '&label=' + encodeURIComponent(label) : '');
              history.replaceState({ embedGroup: group, embedUrl: url, embedLabel: label }, '', hubUrl);
            }
          }
        } catch (err) {
          // Cross-origin — nothing more we can do, keep the original url.
        }

        // Only cache it as "ready to reuse" once it's actually finished
        // loading successfully — never on a page that's still in flight.
        loadedPanelUrls[group] = url;
      });

      iframe.addEventListener('error', function() {
        delete loadedPanelUrls[group];
        panel.innerHTML = '<div class="embed-error">Could not load this here. '
          + '<a href="' + url + '" data-no-spa>Open it directly instead</a>.</div>';
      });

      // Set the real destination BEFORE inserting the iframe into the
      // document — appending a src-less iframe first is what queues that
      // spurious "about:blank" load in some browsers; giving it a src up
      // front means the only navigation that ever happens is the real one.
      iframe.src = withEmbedFlag(url);
      panel.appendChild(iframe);
      panel.appendChild(overlay);

      if (pushHistory !== false) {
        // Keep the visible address on /common/admissions (with the open
        // panel encoded as query params) instead of the real destination
        // URL — otherwise a refresh reloads that destination as its own
        // bare top-level page instead of staying inside the Admissions hub.
        const hubUrl = '/common/admissions?panel=' + encodeURIComponent(group)
          + '&page=' + encodeURIComponent(url)
          + (label ? '&label=' + encodeURIComponent(label) : '');
        history.pushState({ embedGroup: group, embedUrl: url, embedLabel: label }, '', hubUrl);
      }
    }

    // All three destinations are plain links — clicking activates their
    // panel and loads the page straight into it.
    navLinks.forEach(link => {
      link.addEventListener('click', function(e) {
        e.preventDefault();
        const sectionId = this.getAttribute('data-section');
        const embedUrl = this.getAttribute('data-embed-url');
        const embedLabel = this.getAttribute('data-embed-label');
        activateSectionOnly(sectionId);
        if (embedUrl) {
          loadEmbed(sectionId, embedUrl, embedLabel);
        }
      });
    });

    // Warm the connection (and let the server start working) the moment a
    // pointer hovers or a link gets keyboard focus, so the click itself
    // feels instant. Each URL is only ever prefetched once.
    const prefetchedUrls = new Set();
    function prefetchEmbedUrl(url) {
      if (!url || prefetchedUrls.has(url)) return;
      prefetchedUrls.add(url);
      fetch(withEmbedFlag(url), { credentials: 'same-origin' }).catch(function () {
        prefetchedUrls.delete(url);
      });
    }
    document.querySelectorAll('[data-embed-url]').forEach(link => {
      const url = link.getAttribute('data-embed-url');
      if (!url) return;
      link.addEventListener('mouseenter', function () { prefetchEmbedUrl(url); }, { once: true });
      link.addEventListener('focus', function () { prefetchEmbedUrl(url); }, { once: true });
    });

    // Mobile navigation toggle
    navToggle.addEventListener('click', function(e) {
      e.stopPropagation();
      setNavOpen(!nav.classList.contains('open'));
    });

    navClose.addEventListener('click', function(e) {
      e.stopPropagation();
      setNavOpen(false);
    });

    overlay.addEventListener('click', function(e) {
      e.stopPropagation();
      setNavOpen(false);
    });

    document.addEventListener('click', function(e) {
      if (window.innerWidth > 900 || !nav.classList.contains('open')) return;
      if (nav.contains(e.target) || navToggle.contains(e.target)) return;
      setNavOpen(false);
    });

    window.addEventListener('resize', function() {
      if (window.innerWidth > 900) setNavOpen(false);
    });

    window.addEventListener('popstate', function(e) {
      const state = e.state;
      if (state && state.embedGroup && state.embedUrl) {
        activateSectionOnly(state.embedGroup);
        loadEmbed(state.embedGroup, state.embedUrl, state.embedLabel, false);
        return;
      }

      const params = new URLSearchParams(window.location.search);
      const panel = params.get('panel');
      const page = params.get('page');
      if (panel && page && document.getElementById(panel)) {
        activateSectionOnly(panel);
        loadEmbed(panel, page, params.get('label'), false);
      } else {
        const defaultLink = document.querySelector('.nav-link[data-embed-url]');
        if (defaultLink) {
          activateSectionOnly(defaultLink.getAttribute('data-section'));
          loadEmbed(
            defaultLink.getAttribute('data-section'),
            defaultLink.getAttribute('data-embed-url'),
            defaultLink.getAttribute('data-embed-label'),
            false
          );
        }
      }
    });

    // Restoring this page from the browser's back-forward cache (e.g. after
    // leaving for a full page and clicking Back) resumes every panel iframe
    // exactly as frozen — including any async UI state one of them had
    // mid-flight (a row action showing its own inline "Loading…", a fetch()
    // that was in progress when the tab froze, etc). That request doesn't
    // get a chance to resolve, so the stuck state just comes back looking
    // like it's "loading forever." Throw away every cached panel and force
    // a genuinely fresh reload of whichever one is on screen — the rest
    // will simply reload on demand the next time their nav item is clicked,
    // same as a normal cold visit.
    window.addEventListener('pageshow', function (e) {
      if (!e.persisted) return;
      const activeUrl = activeGroup ? loadedPanelUrls[activeGroup] : null;
      Object.keys(loadedPanelUrls).forEach(function (group) {
        delete loadedPanelUrls[group];
        const panel = document.querySelector('#' + group + ' .embed-panel-body');
        if (panel) panel.innerHTML = '';
      });
      if (activeGroup && activeUrl) {
        loadEmbed(activeGroup, activeUrl, panelLabels[activeGroup], false);
      }
    });

    // On a fresh load (including a refresh), restore whichever panel was
    // open — encoded in the URL's own query params — instead of always
    // falling back to the default section.
    const restoreParams = new URLSearchParams(window.location.search);
    const restorePanel = restoreParams.get('panel');
    const restorePage = restoreParams.get('page');

    let initialSection = null;
    if (restorePanel && restorePage && document.getElementById(restorePanel)) {
      activateSectionOnly(restorePanel);
      loadEmbed(restorePanel, restorePage, restoreParams.get('label'), false);
      initialSection = restorePanel;
    } else {
      const initialActive = document.querySelector('.nav-link.active[data-embed-url]');
      if (initialActive) {
        initialSection = initialActive.getAttribute('data-section');
        loadEmbed(
          initialActive.getAttribute('data-section'),
          initialActive.getAttribute('data-embed-url'),
          initialActive.getAttribute('data-embed-label'),
          false
        );
      }
    }

    // Background-preload every other panel behind the scenes, staggered so
    // we don't fire a dozen requests at once. Each one lands in its own
    // hidden section (loadEmbed only flips a section visible when its own
    // nav link is clicked), so by the time the user actually clicks over,
    // loadedPanelUrls already has it cached and it shows instantly instead
    // of waiting on a fresh iframe load.
    const backgroundQueue = [];
    const seenSections = new Set(initialSection ? [initialSection] : []);
    document.querySelectorAll('[data-embed-url]').forEach(function (link) {
      const sectionId = link.getAttribute('data-section');
      if (!sectionId || seenSections.has(sectionId)) return;
      seenSections.add(sectionId);
      backgroundQueue.push({
        sectionId: sectionId,
        url: link.getAttribute('data-embed-url'),
        label: link.getAttribute('data-embed-label'),
      });
    });

    // Two at a time keeps this from ever competing with the panel the user
    // is actually looking at, while still getting everything warmed up in
    // roughly half the time a strictly one-by-one queue would take.
    const BACKGROUND_PRELOAD_CONCURRENCY = 2;
    function preloadNextInBackground() {
      const next = backgroundQueue.shift();
      if (!next) return;
      loadEmbed(next.sectionId, next.url, next.label, false, true);
      setTimeout(preloadNextInBackground, 250);
    }

    if (backgroundQueue.length) {
      setTimeout(function () {
        for (let i = 0; i < BACKGROUND_PRELOAD_CONCURRENCY; i++) {
          preloadNextInBackground();
        }
      }, 400);
    }
  })();
</script>
