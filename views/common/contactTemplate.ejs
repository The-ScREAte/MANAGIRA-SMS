<%
  const themeColor = (typeof session !== 'undefined' && session && session.themeColor) ? session.themeColor : 'teal';
  const themeColors = Object.fromEntries(Object.entries(themePalette).map(([k, v]) => [k, v.primary]));
  const primary = themeColors[themeColor] || themeColors.teal;
%>
<style>
  #ctRoot, #ctDialog {
    --ct-primary: <%= primary %>;
    --ct-surface: var(--ap-surface, #fff);
    --ct-soft: var(--ap-surface-2, #f6f8fa);
    --ct-line: var(--ap-line, #d4d4d8);
    --ct-edge: #8ea3b6;
    --ct-text: var(--ap-text, #13202b);
    --ct-muted: var(--ap-muted, #667788);
    font-family: 'Manrope', 'Segoe UI', sans-serif;
    color: var(--ct-text);
  }
  #ctRoot { min-height: 100%; padding: 0 0 40px; box-sizing: border-box; }
  #ctRoot *, #ctDialog * { box-sizing: border-box; }
  #ctRoot :where(button), #ctDialog :where(button) { width: auto; margin: 0; font-family: inherit; line-height: 1.2; }
  #ctRoot svg, #ctDialog svg { flex: none; }
  .ct-wrap { display: grid; gap: 16px; }
  .ct-head { display: flex; align-items: center; justify-content: space-between; gap: 12px; flex-wrap: wrap; }
  .ct-head h1, .ct-head .ct-head__title { margin: 0; font-size: 12px; font-weight: 800; letter-spacing: .06em; text-transform: uppercase; color: var(--ct-muted); text-align: left; }
  .ct-head__actions { display: flex; gap: 8px; }
  .ct-btn { display: inline-flex; align-items: center; justify-content: center; gap: 6px; height: 36px; padding: 0 14px; border: 1.5px solid var(--ct-edge); border-radius: 9px; background: var(--ct-surface); color: var(--ct-text); font-size: 13px; font-weight: 700; cursor: pointer; white-space: nowrap; }
  .ct-btn:hover { background: var(--ct-soft); }
  .ct-btn svg { width: 16px; height: 16px; }
  .ct-btn--primary { background: var(--ct-primary); border-color: var(--ct-primary); color: #fff; }
  .ct-btn--primary:hover { background: var(--ct-primary); filter: brightness(.93); }
  .ct-btn:disabled { opacity: .45; cursor: default; }
  .ct-icon-btn { display: inline-grid; place-items: center; width: 30px; height: 30px; padding: 0; border: 0; border-radius: 8px; background: transparent; color: var(--ct-muted); cursor: pointer; }
  .ct-icon-btn:hover, .ct-icon-btn[aria-expanded="true"] { background: var(--ct-soft); color: var(--ct-text); }
  .ct-icon-btn svg { width: 16px; height: 16px; }
  .ct-btn:focus-visible, .ct-icon-btn:focus-visible, .ct-menu button:focus-visible { outline: 2px solid var(--ct-primary); outline-offset: 1px; }

  .ct-card { background: var(--ct-surface); border: 1.5px solid var(--ct-line); border-radius: 9px; }
  .ct-sec__head { display: flex; align-items: center; gap: 10px; min-height: 48px; padding: 0 12px 0 8px; }
  .ct-sec__title { flex: 1; min-width: 0; display: flex; align-items: baseline; gap: 8px; }
  .ct-sec__title strong { font-size: 13.5px; font-weight: 800; }
  .ct-sec__title span { font-size: 12px; color: var(--ct-muted); }
  .ct-sec__actions { display: flex; align-items: center; gap: 2px; }
  .ct-lock { display: grid; place-items: center; width: 16px; height: 16px; margin-left: 8px; color: var(--ct-muted); }
  .ct-lock svg { width: 16px; height: 16px; }
  .ct-base { display: flex; flex-wrap: wrap; gap: 6px; padding: 0 16px 16px; }
  .ct-base span { display: inline-flex; align-items: center; gap: 6px; padding: 4px 10px; border-radius: 7px; background: var(--ct-soft); font-size: 12.5px; font-weight: 600; }
  .ct-base em { font-style: normal; font-size: 10.5px; font-weight: 800; color: var(--ct-primary); text-transform: uppercase; letter-spacing: .03em; }
  .ct-sections { display: grid; gap: 20px; }
  .ct-fields { display: grid; min-height: 0; border-top: 1.5px solid var(--ct-line); }
  .ct-fields:empty::before { content: "Drop here"; display: grid; place-items: center; height: 44px; font-size: 12.5px; color: var(--ct-muted); }
  .ct-row { display: grid; grid-template-columns: 24px minmax(0, 1fr) 130px 56px 32px; align-items: center; gap: 8px; min-height: 46px; padding: 0 8px 0 4px; border-top: 1.5px solid var(--ct-line); background: var(--ct-surface); }
  .ct-row:first-child { border-top: 0; }
  .ct-row:hover { background: var(--ct-soft); }
  .ct-row.is-obsolete .ct-row__name { opacity: .55; }
  .ct-grip { display: grid; place-items: center; width: 24px; height: 30px; color: var(--ct-muted); opacity: .55; cursor: grab; touch-action: none; }
  .ct-grip svg { width: 14px; height: 14px; }
  .ct-row__name { display: flex; align-items: center; gap: 8px; min-width: 0; font-size: 13.5px; font-weight: 700; }
  .ct-row__name b { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-weight: 700; }
  .ct-row__type { display: flex; align-items: center; gap: 8px; min-width: 0; font-size: 12.5px; color: var(--ct-muted); white-space: nowrap; }
  .ct-row__type svg { width: 16px; height: 16px; }
  .ct-chip { justify-self: start; padding: 2px 8px; border-radius: 999px; background: var(--ct-soft); border: 1px solid var(--ct-line); font-size: 11px; font-weight: 700; color: var(--ct-muted); }
  .ct-chip--obsolete { background: #fdf3dc; border-color: transparent; color: #8a5a00; }
  .ct-menuwrap { position: relative; }
  .ct-menu { position: absolute; right: 0; top: calc(100% + 4px); z-index: 40; display: none; min-width: 176px; padding: 4px; border: 1.5px solid var(--ct-line); border-radius: 9px; background: var(--ct-surface); box-shadow: 0 12px 28px -10px rgba(15, 23, 42, .3); }
  .ct-menu.is-open { display: grid; }
  .ct-menu button { display: flex; align-items: center; gap: 10px; height: 34px; padding: 0 10px; border: 0; border-radius: 7px; background: none; color: var(--ct-text); font-size: 13px; font-weight: 600; text-align: left; cursor: pointer; }
  .ct-menu button svg { width: 16px; height: 16px; color: var(--ct-muted); }
  .ct-menu button:hover { background: var(--ct-soft); }
  .ct-menu .is-danger, .ct-menu .is-danger svg { color: #b42318; }
  .ct-dragging, .ct-dragging * { cursor: grabbing !important; user-select: none; }
  .ct-placeholder { opacity: .35; }
  .ct-ghost { position: fixed; z-index: 20000; margin: 0; pointer-events: none; border: 1.5px solid var(--ct-line); border-radius: 9px; box-shadow: 0 16px 40px -10px rgba(16, 32, 48, .35); opacity: .97; }
  .ct-toast { position: fixed; left: 50%; bottom: 22px; z-index: 20003; transform: translate(-50%, 10px); opacity: 0; padding: 9px 14px; border-radius: 9px; background: #13202b; color: #fff; font-size: 13px; font-weight: 600; transition: .2s; pointer-events: none; }
  .ct-toast.is-on { opacity: 1; transform: translate(-50%, 0); }

  /* Field panel: slides in from the right, under the app header; closes only with X or Esc. */
  #ctDialog { position: fixed; inset: 0; z-index: 20002; display: none; justify-content: flex-end; background: rgba(15, 23, 42, .35); }
  #ctDialog.is-open { display: flex; }
  #ctDialog [hidden] { display: none !important; }
  .ct-dlg { display: flex; flex-direction: column; width: min(1040px, 100vw); height: 100%; background: var(--ct-surface); border-left: 1.5px solid var(--ct-line); box-shadow: -20px 0 50px -24px rgba(15, 23, 42, .4); animation: ct-slide .22s ease-out; }
  @keyframes ct-slide { from { transform: translateX(40px); opacity: 0; } to { transform: none; opacity: 1; } }
  @media (prefers-reduced-motion: reduce) { .ct-dlg { animation: none; } }
  .ct-dlg > form { display: flex; flex-direction: column; flex: 1; min-height: 0; }
  .ct-dlg__head { display: flex; align-items: center; justify-content: space-between; gap: 12px; flex: none; padding: 14px 20px; border-bottom: 1.5px solid var(--ct-line); }
  .ct-dlg__head h2 { margin: 0; font-size: 13px; font-weight: 800; letter-spacing: .06em; text-transform: uppercase; text-align: left; }
  .ct-dlg__body { display: grid; align-content: start; gap: 16px; flex: 1; min-height: 0; overflow-y: auto; padding: 20px; }
  .ct-dlg label, .ct-dlg__label { display: grid; gap: 6px; margin: 0; font-size: 11px; font-weight: 800; letter-spacing: .05em; text-transform: uppercase; color: var(--ct-muted); }
  #ctDialog :is(input, select, textarea) { width: 100%; height: 38px; margin: 0; padding: 0 12px; border: 1.5px solid var(--ct-edge); border-radius: 9px; background: var(--ct-surface); color: var(--ct-text); font: inherit; font-size: 13.5px; font-weight: 500; text-transform: none; letter-spacing: 0; }
  #ctDialog textarea { height: auto; min-height: 96px; padding: 9px 12px; resize: vertical; }
  #ctDialog :is(input, select, textarea)::placeholder { color: #a6b2be; font-weight: 400; }
  #ctDialog :is(input, select, textarea):focus { outline: none; border-color: var(--ct-primary); box-shadow: 0 0 0 3px color-mix(in srgb, var(--ct-primary) 15%, transparent); }
  .ct-dlg__foot { display: flex; align-items: center; justify-content: flex-end; gap: 12px; flex: none; padding: 12px 20px; border-top: 1.5px solid var(--ct-line); background: var(--ct-surface); }
  .ct-dlg__foot > div { display: flex; gap: 8px; }
  .ct-error { flex: 1; min-height: 18px; margin: 0; font-size: 12.5px; color: #c0262d; }
  .ct-types { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 8px; }
  #ctDialog .ct-types button { display: flex; align-items: center; gap: 8px; height: 38px; padding: 0 10px; border: 1.5px solid var(--ct-edge); border-radius: 9px; background: var(--ct-surface); color: var(--ct-text); font-size: 12.5px; font-weight: 700; text-transform: none; letter-spacing: 0; cursor: pointer; text-align: left; }
  #ctDialog .ct-types button svg { width: 16px; height: 16px; color: var(--ct-muted); }
  #ctDialog .ct-types button.is-on { border-color: var(--ct-primary); background: color-mix(in srgb, var(--ct-primary) 8%, var(--ct-surface)); box-shadow: 0 0 0 1px var(--ct-primary) inset; }
  #ctDialog .ct-types button.is-on svg { color: var(--ct-primary); }
  #ctDialog .ct-types button:disabled { cursor: default; opacity: .45; }
  #ctDialog .ct-types button.is-on:disabled { opacity: 1; }
  .ct-seg { display: grid; grid-template-columns: 1fr 1fr; height: 38px; padding: 3px; border: 1.5px solid var(--ct-edge); border-radius: 9px; background: var(--ct-surface); }
  #ctDialog .ct-seg button { border: 0; border-radius: 7px; background: none; color: var(--ct-muted); font-size: 12.5px; font-weight: 700; text-transform: none; letter-spacing: 0; cursor: pointer; }
  #ctDialog .ct-seg button.is-on { background: var(--ct-primary); color: #fff; }
  @media (max-width: 640px) {
    .ct-head__actions .ct-btn { flex: 1; justify-content: center; }
    .ct-types { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .ct-row { grid-template-columns: 24px minmax(0, 1fr) 56px 32px; }
    .ct-row__type { display: none; }
  }
  /* Who else sees a section. */
  #ctRoot .ct-share { display: flex; flex-wrap: wrap; align-items: center; gap: 6px; margin: 0 16px 14px; }
  #ctRoot .ct-share__label { display: inline-flex; align-items: center; gap: 6px; margin-right: 2px; font-size: 12px; font-weight: 700; color: var(--ct-muted); }
  #ctRoot .ct-share__label svg { width: 14px; height: 14px; }
  #ctRoot .ct-share__chip { display: inline-flex; align-items: center; gap: 5px; height: 28px; padding: 0 11px; border: 1.5px solid var(--ct-line); border-radius: 999px; background: var(--ct-surface); color: var(--ct-muted); font: inherit; font-size: 12px; font-weight: 700; cursor: pointer; }
  #ctRoot .ct-share__chip svg { width: 12px; height: 12px; }
  #ctRoot .ct-share__chip.is-on { border-color: color-mix(in srgb, var(--ct-primary) 45%, var(--ct-surface)); background: color-mix(in srgb, var(--ct-primary) 10%, var(--ct-surface)); color: var(--ct-primary); }
  #ctRoot .ct-share__chip:focus-visible { outline: 2px solid var(--ct-primary); outline-offset: 1px; }
  #ctRoot .ct-share__none { font-size: 12px; color: var(--ct-muted); }
</style>

<div id="ctRoot">
  <div class="ct-wrap">
    <div class="ct-head<%= locals.inAdmissions ? ' ct-head--inline' : '' %>">
      <div>
        <% if (locals.inAdmissions) { %>
          <span></span>
        <% } else { %>
          <h1>Parents &amp; guardians</h1>
        <% } %>
      </div>
      <div class="ct-head__actions">
        <button type="button" class="ct-btn" data-add-section>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="16" rx="2"/><path d="M3 9h18"/></svg>
          Add section
        </button>
        <button type="button" class="ct-btn ct-btn--primary" data-add-field>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><path d="M12 5v14M5 12h14"/></svg>
          Add field
        </button>
      </div>
    </div>

    <section class="ct-card">
      <header class="ct-sec__head">
        <span class="ct-lock"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="11" width="14" height="10" rx="2"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/></svg></span>
        <div class="ct-sec__title"><strong>Always asked</strong></div>
      </header>
      <div class="ct-base">
        <% baseFields.forEach(function (f) { %>
          <span title="<%= f.note || (f.required ? 'Required' : 'Optional') %>"><%= f.label %><% if (f.required) { %><em>Required</em><% } %></span>
        <% }) %>
      </div>
    </section>

    <div class="ct-sections" id="ctSections"></div>

  </div>
  <div class="ct-toast" id="ctToast" role="status"></div>
</div>

<div id="ctDialog" data-popup-lift role="dialog" aria-modal="true" aria-labelledby="ctDialogTitle"><div class="ct-dlg" id="ctDlg"></div></div>

<script type="application/json" id="ctData"><%- JSON.stringify({ template, types: fieldTypes, sharing: true }).replace(/</g, '\\u003c') %></script>
<script>
(function () {
  const root = document.getElementById('ctRoot');
  if (!root || root.dataset.ready) return;
  root.dataset.ready = '1';
  const data = JSON.parse(document.getElementById('ctData').textContent);
  let sections = data.template.sections;
  let fields = data.template.fields;
  const TYPES = data.types;
  const host = document.getElementById('ctSections');
  const dialog = document.getElementById('ctDialog');
  const dlg = document.getElementById('ctDlg');
  const esc = (s) => String(s == null ? '' : s).replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
  const svg = (d, w) => `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="${w || 2}" stroke-linecap="round" stroke-linejoin="round">${d}</svg>`;
  const SHARING = Boolean(data.sharing);
  const ICON = {
    eye: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12Z"/><circle cx="12" cy="12" r="3"/></svg>',
    check: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m5 12 5 5 9-10"/></svg>',
    grip: '<svg viewBox="0 0 24 24" fill="currentColor"><circle cx="9" cy="6" r="1.6"/><circle cx="15" cy="6" r="1.6"/><circle cx="9" cy="12" r="1.6"/><circle cx="15" cy="12" r="1.6"/><circle cx="9" cy="18" r="1.6"/><circle cx="15" cy="18" r="1.6"/></svg>',
    edit: svg('<path d="M12 20h9"/><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4Z"/>'),
    archive: svg('<rect x="3" y="4" width="18" height="4" rx="1"/><path d="M5 8v11a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1V8M10 12h4"/>'),
    restore: svg('<path d="M3 12a9 9 0 1 0 3-6.7L3 8"/><path d="M3 3v5h5"/>'),
    trash: svg('<path d="M3 6h18M8 6V4h8v2M6 6l1 14h10l1-14"/>'),
    close: svg('<path d="M18 6 6 18M6 6l12 12"/>'),
    more: '<svg viewBox="0 0 24 24" fill="currentColor"><circle cx="5" cy="12" r="1.7"/><circle cx="12" cy="12" r="1.7"/><circle cx="19" cy="12" r="1.7"/></svg>',
    plus: svg('<path d="M12 5v14M5 12h14"/>'),
  };
  const TYPE_ICON = {
    text: svg('<path d="M4 7V5h16v2M9 19h6M12 5v14"/>'),
    long_text: svg('<path d="M4 6h16M4 10h16M4 14h16M4 18h10"/>'),
    number: svg('<path d="M4 9h16M4 15h16M10 3 8 21M16 3l-2 18"/>'),
    date: svg('<rect x="3" y="5" width="18" height="16" rx="2"/><path d="M16 3v4M8 3v4M3 10h18"/>'),
    choice: svg('<circle cx="5" cy="7" r="1.4"/><circle cx="5" cy="12" r="1.4"/><circle cx="5" cy="17" r="1.4"/><path d="M10 7h10M10 12h10M10 17h10"/>'),
    yes_no: svg('<rect x="2" y="7" width="20" height="10" rx="5"/><circle cx="16" cy="12" r="3"/>'),
  };

  // ---------- render ----------
  function menuHtml(label, items) {
    return `<div class="ct-menuwrap"><button type="button" class="ct-icon-btn" data-menu aria-haspopup="true" aria-expanded="false" aria-label="Actions for ${esc(label)}">${ICON.more}</button><div class="ct-menu" role="menu">${items}</div></div>`;
  }
  function rowHtml(f) {
    const obsolete = f.status !== 'active';
    const w = f.width === 'full' || (f.width !== 'half' && f.type === 'long_text') ? 'Full' : 'Half';
    return `<div class="ct-row ${obsolete ? 'is-obsolete' : ''}" data-field="${f.id}">
      <span class="ct-grip" data-grip="field" title="Drag to move" aria-hidden="true">${ICON.grip}</span>
      <div class="ct-row__name"><b>${esc(f.label)}</b>${obsolete ? '<span class="ct-chip ct-chip--obsolete">Obsolete</span>' : ''}</div>
      <div class="ct-row__type">${TYPE_ICON[f.type] || TYPE_ICON.text}<span>${esc(TYPES[f.type] || 'Short text')}</span></div>
      <span class="ct-chip">${w}</span>
      ${menuHtml(f.label, `<button type="button" role="menuitem" data-edit>${ICON.edit}Edit</button>
        ${obsolete ? `<button type="button" role="menuitem" data-status="active">${ICON.restore}Restore</button>` : `<button type="button" role="menuitem" data-status="obsolete">${ICON.archive}Obsolete</button>`}
        ${f.used ? '' : `<button type="button" role="menuitem" class="is-danger" data-delete>${ICON.trash}Delete</button>`}`)}
    </div>`;
  }

  function sectionHtml(sec) {
    const list = fields.filter((f) => (f.sectionId || 0) === sec.id);
    const custom = sec.id !== 0;
    return `<section class="ct-card ct-sec" data-section="${sec.id}">
      <header class="ct-sec__head">
        ${custom ? `<span class="ct-grip" data-grip="section" title="Drag to move" aria-hidden="true">${ICON.grip}</span>` : '<span style="width:8px"></span>'}
        <div class="ct-sec__title"><strong>${esc(sec.name)}</strong><span>${list.length}</span></div>
        <div class="ct-sec__actions">
          <button type="button" class="ct-icon-btn" data-add-field-in="${sec.id}" title="Add field" aria-label="Add field to ${esc(sec.name)}">${ICON.plus}</button>
          ${custom ? menuHtml(sec.name, `<button type="button" role="menuitem" data-rename>${ICON.edit}Rename</button><button type="button" role="menuitem" class="is-danger" data-delete-section>${ICON.trash}Delete</button>`) : ''}
        </div>
      </header>
      ${custom && SHARING ? shareHtml(sec) : ''}
      <div class="ct-fields" data-zone="${sec.id}">${list.map(rowHtml).join('')}</div>
    </section>`;
  }

  // Who else sees a section: parents can also update it in their portal.
  const AUDIENCES = [
    { key: 'parents', label: 'Parents', hint: 'See and update it in the parent portal' },
    { key: 'students', label: 'Students', hint: 'See it in the student portal' },
    { key: 'teachers', label: 'Teachers', hint: 'See it on the class pickup list' },
    { key: 'drivers', label: 'Drivers', hint: 'See it for their riders (driver permission Pickup & Emergency)' },
  ];
  function shareHtml(sec) {
    const shared = Array.isArray(sec.shared) ? sec.shared : [];
    return `<div class="ct-share" role="group" aria-label="Who sees ${esc(sec.name)}">
      <span class="ct-share__label">${ICON.eye} Shared with</span>
      ${AUDIENCES.map((a) => `<button type="button" class="ct-share__chip${shared.includes(a.key) ? ' is-on' : ''}" data-share="${a.key}" aria-pressed="${shared.includes(a.key)}" title="${esc(a.hint)}">${shared.includes(a.key) ? ICON.check : ''}${a.label}</button>`).join('')}
      ${shared.length ? '' : '<span class="ct-share__none">Only the office</span>'}
    </div>`;
  }

  // "More details" holds fields without a section; it's shown when it has any
  // (or when there are no sections yet), always last.
  function render() {
    const loose = fields.some((f) => !f.sectionId);
    const all = sections.concat(loose || !sections.length ? [{ id: 0, name: 'More details' }] : []);
    host.innerHTML = all.map(sectionHtml).join('');
  }

  let toastTimer = null;
  function toast(text) {
    const t = document.getElementById('ctToast');
    t.textContent = text;
    t.classList.add('is-on');
    clearTimeout(toastTimer);
    toastTimer = setTimeout(() => t.classList.remove('is-on'), 2200);
  }

  async function call(url, body) {
    const res = await fetch(url, { method: 'POST', credentials: 'same-origin', headers: { 'Content-Type': 'application/json', Accept: 'application/json' }, body: JSON.stringify(body || {}) });
    const out = await res.json().catch(() => ({}));
    if (!res.ok || !out.success) throw new Error(out.error || 'Something went wrong. Try again.');
    sections = out.sections;
    fields = out.fields;
    return out;
  }

  // ---------- dialogs ----------
  let dialogSubmit = null;
  function openDialog(html, onSubmit) {
    dlg.innerHTML = html;
    dialogSubmit = onSubmit;
    { const h = document.getElementById('top-header'); dialog.style.top = (h ? h.offsetHeight : 0) + 'px'; }
    dialog.classList.add('is-open');
    const first = dlg.querySelector('input, textarea');
    if (first) first.focus();
  }
  function closeDialog() { dialog.classList.remove('is-open'); dialogSubmit = null; }
  function dialogFrame(title, body, action) {
    return `<form data-dlg-form novalidate>
      <div class="ct-dlg__head"><h2 id="ctDialogTitle">${title}</h2><button type="button" class="ct-icon-btn" data-dlg-close aria-label="Close">${ICON.close}</button></div>
      <div class="ct-dlg__body">${body}</div>
      <div class="ct-dlg__foot"><p class="ct-error" data-dlg-error role="alert"></p><div><button type="button" class="ct-btn" data-dlg-close>Cancel</button><button type="submit" class="ct-btn ct-btn--primary">${action}</button></div></div>
    </form>`;
  }

  function fieldDialog(f, sectionId) {
    const locked = f && f.used > 0;
    let type = f ? f.type : 'text';
    let width = f && f.width ? f.width : (f && f.type === 'long_text' ? 'full' : 'half');
    let widthPicked = !!(f && f.width);
    const secId = f ? (f.sectionId || 0) : (sectionId || 0);
    const body = `
      <label>Field name<input name="label" maxlength="80" value="${esc(f ? f.label : '')}" placeholder="e.g. Emergency contact" autocomplete="off"></label>
      <div class="ct-dlg__label">Type
        <div class="ct-types">${Object.entries(TYPES).map(([k, v]) => `<button type="button" data-type="${k}" class="${k === type ? 'is-on' : ''}" ${locked ? 'disabled' : ''}>${TYPE_ICON[k]}${esc(v)}</button>`).join('')}</div>
      </div>
      <label data-options ${type === 'choice' ? '' : 'hidden'}><span>Choices</span><textarea name="options" placeholder="One per line">${esc(f ? f.options.join('\n') : '')}</textarea></label>
      <label>Section<select name="sectionId"><option value="0">More details</option>${sections.map((s) => `<option value="${s.id}" ${s.id === secId ? 'selected' : ''}>${esc(s.name)}</option>`).join('')}</select></label>
      <div class="ct-dlg__label">Width
        <div class="ct-seg" role="group" aria-label="Width"><button type="button" data-width="half" class="${width === 'half' ? 'is-on' : ''}">Half</button><button type="button" data-width="full" class="${width === 'full' ? 'is-on' : ''}">Full</button></div>
      </div>
      <label>Help<input name="helpText" maxlength="200" value="${esc(f ? f.helpText : '')}" placeholder="Help text (shows as ?)" autocomplete="off"></label>`;
    openDialog(dialogFrame(f ? 'Edit field' : 'New field', body, f ? 'Save' : 'Add field'), async (form) => {
      await call(f ? `/common/contact-template/fields/${f.id}` : '/common/contact-template/fields', {
        label: form.label.value, type, options: form.options.value,
        sectionId: Number(form.sectionId.value) || null, helpText: form.helpText.value, width: widthPicked ? width : '',
      });
      toast(f ? 'Field saved' : 'Field added');
    });
    dlg.querySelectorAll('[data-width]').forEach((b) => b.addEventListener('click', () => {
      width = b.dataset.width; widthPicked = true;
      dlg.querySelectorAll('[data-width]').forEach((x) => x.classList.toggle('is-on', x === b));
    }));
    dlg.querySelectorAll('[data-type]').forEach((b) => b.addEventListener('click', () => {
      type = b.dataset.type;
      dlg.querySelectorAll('[data-type]').forEach((x) => x.classList.toggle('is-on', x === b));
      dlg.querySelector('[data-options]').hidden = type !== 'choice';
    }));
  }

  function sectionDialog(sec) {
    const body = `<label>Section name<input name="name" maxlength="60" value="${esc(sec ? sec.name : '')}" placeholder="e.g. Emergency & pickup" autocomplete="off"></label>`;
    openDialog(dialogFrame(sec ? 'Rename section' : 'New section', body, sec ? 'Save' : 'Add section'), async (form) => {
      await call(sec ? `/common/contact-template/sections/${sec.id}` : '/common/contact-template/sections', { name: form.name.value });
      toast(sec ? 'Section renamed' : 'Section added');
    });
  }

  dialog.addEventListener('click', (e) => { if (e.target.closest('[data-dlg-close]')) closeDialog(); });
  document.addEventListener('keydown', (e) => { if (e.key !== 'Escape') return; if (dialog.classList.contains('is-open')) closeDialog(); else closeMenus(); });
  dialog.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!dialogSubmit) return;
    const form = e.target;
    const btn = form.querySelector('[type="submit"]');
    btn.disabled = true;
    try {
      await dialogSubmit(form);
      closeDialog();
      render();
    } catch (err) {
      form.querySelector('[data-dlg-error]').textContent = err.message;
      btn.disabled = false;
    }
  });

  // ---------- actions ----------
  root.querySelector('[data-add-field]').addEventListener('click', () => fieldDialog(null, 0));
  root.querySelector('[data-add-section]').addEventListener('click', () => sectionDialog(null));
  const closeMenus = () => host.querySelectorAll('.ct-menu.is-open').forEach((m) => { m.classList.remove('is-open'); const t = m.parentNode.querySelector('[data-menu]'); if (t) t.setAttribute('aria-expanded', 'false'); });
  document.addEventListener('click', (e) => { if (!e.target.closest('.ct-menuwrap')) closeMenus(); });
  host.addEventListener('click', async (e) => {
    const mb = e.target.closest('[data-menu]');
    if (mb) {
      const menu = mb.parentNode.querySelector('.ct-menu');
      const was = menu.classList.contains('is-open');
      closeMenus();
      if (!was) { menu.classList.add('is-open'); mb.setAttribute('aria-expanded', 'true'); const first = menu.querySelector('button'); if (first) first.focus(); }
      return;
    }
    closeMenus();
    const shareBtn = e.target.closest('[data-share]');
    if (shareBtn) {
      const sec = sections.find((x) => String(x.id) === shareBtn.closest('[data-section]').dataset.section);
      if (!sec) return;
      const key = shareBtn.dataset.share;
      const next = (sec.shared || []).includes(key) ? sec.shared.filter((k) => k !== key) : (sec.shared || []).concat(key);
      shareBtn.disabled = true;
      try {
        await call(`/common/contact-template/sections/${sec.id}/sharing`, { shared: next });
        render();
        const label = AUDIENCES.find((a) => a.key === key).label;
        toast(next.includes(key) ? `${label} can see ${sec.name} now.` : `${label} no longer see ${sec.name}.`);
      } catch (err) { toast(err.message); shareBtn.disabled = false; }
      return;
    }
    const secEl = e.target.closest('[data-section]');
    const rowEl = e.target.closest('[data-field]');
    const f = rowEl && fields.find((x) => x.id === Number(rowEl.dataset.field));
    const sec = secEl && sections.find((x) => x.id === Number(secEl.dataset.section));
    const addIn = e.target.closest('[data-add-field-in]');
    try {
      if (addIn) return fieldDialog(null, Number(addIn.dataset.addFieldIn));
      if (f && e.target.closest('[data-edit]')) return fieldDialog(f);
      if (sec && !f && e.target.closest('[data-rename]')) return sectionDialog(sec);
      const status = f && e.target.closest('[data-status]');
      if (status) {
        await call(`/common/contact-template/fields/${f.id}/status`, { status: status.dataset.status });
        toast(status.dataset.status === 'active' ? 'Field restored' : 'Field is now obsolete');
        return render();
      }
      if (f && e.target.closest('[data-delete]')) {
        if (!confirm(`Delete "${f.label}"? It hasn't been filled in for anyone yet.`)) return;
        await call(`/common/contact-template/fields/${f.id}/delete`);
        toast('Field deleted');
        return render();
      }
      if (sec && !f && e.target.closest('[data-delete-section]')) {
        const n = fields.filter((x) => x.sectionId === sec.id).length;
        if (!confirm(n ? `Delete the "${sec.name}" section? Its ${n} field${n === 1 ? '' : 's'} will move to More details.` : `Delete the "${sec.name}" section?`)) return;
        await call(`/common/contact-template/sections/${sec.id}/delete`);
        toast('Section deleted');
        return render();
      }
    } catch (err) {
      toast(err.message);
      render();
    }
  });

  // ---------- drag to arrange (mouse and touch) ----------
  // Fields move within and between sections; sections move among themselves
  // ("More details" stays last). The new layout is saved when the drag ends.
  function layout() {
    return {
      sections: [...host.querySelectorAll('[data-section]')].map((el) => Number(el.dataset.section)).filter(Boolean),
      fields: [...host.querySelectorAll('[data-zone]')].flatMap((zone) => [...zone.querySelectorAll('[data-field]')]
        .map((el) => ({ id: Number(el.dataset.field), sectionId: Number(zone.dataset.zone) || null }))),
    };
  }

  host.addEventListener('pointerdown', (e) => {
    const grip = e.target.closest('[data-grip]');
    if (!grip || e.button > 0) return;
    e.preventDefault();
    const kind = grip.dataset.grip;
    const item = grip.closest(kind === 'field' ? '[data-field]' : '[data-section]');
    const rect = item.getBoundingClientRect();
    const offsetY = e.clientY - rect.top;
    const before = JSON.stringify(layout());
    const ghost = item.cloneNode(true);
    ghost.classList.add('ct-ghost');
    Object.assign(ghost.style, { left: rect.left + 'px', top: rect.top + 'px', width: rect.width + 'px' });
    document.body.appendChild(ghost);
    item.classList.add('ct-placeholder');
    document.documentElement.classList.add('ct-dragging');

    const middle = (el) => { const r = el.getBoundingClientRect(); return r.top + r.height / 2; };
    function place(x, y) {
      ghost.style.top = (y - offsetY) + 'px';
      const under = document.elementFromPoint(x, y);
      if (!under) return;
      if (kind === 'field') {
        const sectionEl = under.closest('[data-section]');
        const zone = under.closest('[data-zone]') || (sectionEl && sectionEl.querySelector('[data-zone]'));
        if (!zone) return;
        const rows = [...zone.querySelectorAll('[data-field]')].filter((r) => r !== item);
        const next = rows.find((r) => y < middle(r)) || null;
        if (item.parentNode !== zone || item.nextSibling !== next) zone.insertBefore(item, next);
      } else {
        const target = under.closest('[data-section]');
        if (!target || target === item || !Number(target.dataset.section)) return;
        host.insertBefore(item, y < middle(target) ? target : target.nextSibling);
      }
    }
    function move(ev) {
      place(ev.clientX, ev.clientY);
      if (ev.clientY < 60) window.scrollBy(0, -14);
      else if (ev.clientY > window.innerHeight - 60) window.scrollBy(0, 14);
    }
    async function end() {
      window.removeEventListener('pointermove', move);
      window.removeEventListener('pointerup', end);
      window.removeEventListener('pointercancel', end);
      ghost.remove();
      item.classList.remove('ct-placeholder');
      document.documentElement.classList.remove('ct-dragging');
      const now = layout();
      if (JSON.stringify(now) === before) return;
      try {
        await call('/common/contact-template/order', now);
        toast('Saved');
      } catch (err) {
        toast(err.message);
      }
      render();
    }
    window.addEventListener('pointermove', move);
    window.addEventListener('pointerup', end);
    window.addEventListener('pointercancel', end);
  });

  render();
})();
</script>
