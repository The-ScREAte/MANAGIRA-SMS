<%
  // Theme color mapping for organization buttons
  const themeColor = (typeof session !== 'undefined' && session && session.themeColor) ? session.themeColor : 'teal';
  const themeColors = {
    teal: { primary: '#01535b', hover: '#014a51' },
    blue: { primary: '#2563eb', hover: '#1d4ed8' },
    green: { primary: '#2d5f4f', hover: '#245043' },
    purple: { primary: '#7c3aed', hover: '#6d28d9' },
    indigo: { primary: '#4f46e5', hover: '#4338ca' },
    rose: { primary: '#8b2635', hover: '#7a212e' },
    amber: { primary: '#d97706', hover: '#b45309' },
    slate: { primary: '#334155', hover: '#1e293b' },
    classic: { primary: '#01535b', hover: '#014a51' },
    bold: { primary: '#0b1020', hover: '#ffb703' },
    modern: { primary: '#2563eb', hover: '#1d4ed8' },
    minimal: { primary: '#7c3aed', hover: '#6d28d9' },
    gold: { primary: '#d4a017', hover: '#b8860b' },
    red: { primary: '#e11d48', hover: '#be123c' },
    brown: { primary: '#7c4a03', hover: '#5c3802' }
  };
  const currentTheme = themeColors[themeColor] || themeColors.teal;
  const hasFilesFeature = Array.isArray(allowedFeatures) && (allowedFeatures.includes('Create Files') || allowedFeatures.includes('Files & Sheets') || allowedFeatures.includes('Docs/Sheets'));
  const hasPublicWebsiteFeature = Array.isArray(allowedFeatures) && (allowedFeatures.includes('School Website') || allowedFeatures.includes('SchoolWebsite') || allowedFeatures.includes('Public Dashboard') || allowedFeatures.includes('School Public Dashboard'));
%>

<style>
  :root {
    --border: #e5e7eb;
    --muted: #6b7280;
    --text: #0f172a;
    --bg: #f8fafc;
    --primary: <%= currentTheme.primary %>;
    --primary-hover: <%= currentTheme.hover %>;
        --primary-hover-fill: color-mix(in srgb, var(--primary) 88%, white);
    --org-primary-color: <%= currentTheme.primary %>;
    --org-primary-hover: <%= currentTheme.hover %>;
        --org-primary-hover-fill: color-mix(in srgb, var(--org-primary-color) 88%, white);
  }

  body {
    background: #f8fafc;
  }

  main {
    padding: 0 !important;
    max-width: none !important;
  }

  .management-wrapper {
    width: 100%;
    min-height: calc(100vh - 68px);
  }

  .management-layout {
    display: grid;
    grid-template-columns: 232px 1fr;
    gap: 14px;
    max-width: none;
    margin: 0;
    padding: 12px 16px 24px;
    align-items: start;
  }

  .management-nav {
    border: 1px solid var(--border);
    border-radius: 14px;
    padding: 10px 8px;
    background: #fff;
    height: fit-content;
    position: sticky;
    top: 12px;
    box-shadow: 0 4px 14px rgba(15, 23, 42, 0.04);
  }

  .management-nav-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin: 4px 8px 8px;
    width: auto;
  }

  .management-nav h3 {
    margin: 0;
    font-size: 11px;
    color: var(--muted);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .nav-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 2px;
  }

  .nav-list li { margin: 0; }

  .nav-link {
    position: relative;
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 7px 10px 7px 12px;
    border-radius: 8px;
    color: #1f2937;
    text-decoration: none;
    border: none;
    width: 100%;
    background: transparent;
    cursor: pointer;
    font: inherit;
    text-align: left;
    font-weight: 500;
    font-size: 13px;
    line-height: 1.2;
    transition: background 0.15s ease, color 0.15s ease;
  }

  .nav-link .nav-link-icon {
    width: 16px;
    height: 16px;
    flex-shrink: 0;
    color: #64748b;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .nav-link .nav-link-icon svg {
    width: 16px;
    height: 16px;
    stroke: currentColor;
  }

  .nav-link:hover {
    background: #f1f5f9;
    color: var(--text);
  }
  .nav-link:hover .nav-link-icon { color: var(--primary); }

  .nav-link.active {
    background: rgba(1, 83, 91, 0.08);
    color: var(--primary);
    font-weight: 600;
  }

  .nav-link.active::before {
    content: "";
    position: absolute;
    left: 0;
    top: 6px;
    bottom: 6px;
    width: 3px;
    border-radius: 0 3px 3px 0;
    background: var(--primary);
  }

  .nav-link.active .nav-link-icon { color: var(--primary); }

  .management-main {
    padding: 0;
    background: #fff;
    border-radius: 14px;
    border: 1px solid var(--border);
    box-shadow: 0 4px 14px rgba(15, 23, 42, 0.04);
    overflow: hidden;
  }

  .section-header {
    padding: 12px 18px 12px;
    border-bottom: 1px solid var(--border);
    background: linear-gradient(180deg, #ffffff 0%, #f8fbff 100%);
    text-align: left;
  }

  .section-header * { text-align: left; }

  .section-header h1 {
    margin: 0 0 2px 0;
    font-size: 16px;
    color: var(--text);
    font-weight: 700;
  }

  .section-header p {
    margin: 0;
    color: var(--muted);
    font-size: 12px;
    line-height: 1.4;
  }

  .section-content {
    padding: 14px 18px 18px;
  }

  .management-section { display: none; }
  .management-section.active { display: block; }

  .section-card {
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 14px 16px;
    background: #fff;
    margin-bottom: 12px;
  }

  .section-card h2 {
    margin: 0 0 4px 0;
    font-size: 14px;
    color: var(--text);
    font-weight: 700;
  }

  .section-card > p {
    margin: 0 0 12px 0;
    color: var(--muted);
    font-size: 12.5px;
    line-height: 1.5;
    display: block;
    -webkit-line-clamp: unset;
    line-clamp: unset;
    overflow: visible;
  }

  .action-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 7px 14px;
    background: var(--primary);
    color: #fff;
    border: none;
    border-radius: 8px;
    font-size: 12.5px;
    font-weight: 600;
    text-decoration: none;
    cursor: pointer;
    transition: background 0.15s ease;
  }

  .action-btn:hover {
    background: var(--primary-hover-fill, var(--primary-hover));
    color: #fff;
  }

  .action-btn svg {
    width: 14px;
    height: 14px;
  }

  .features-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 8px;
    margin-bottom: 12px;
  }

  .features-grid .feature-item:nth-child(n + 3) {
    display: flex;
  }

  .feature-item {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    padding: 10px 12px;
    background: #f8fafc;
    border-radius: 10px;
    border: 1px solid var(--border);
    transition: border-color 0.15s ease, background 0.15s ease;
  }

  .feature-item:hover {
    border-color: var(--primary);
    background: #fff;
  }

  .feature-icon {
    width: 30px;
    height: 30px;
    border-radius: 8px;
    background: rgba(1, 83, 91, 0.08);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .feature-icon svg {
    width: 16px;
    height: 16px;
    color: var(--primary);
    stroke: var(--primary);
  }

  .feature-content h4 {
    margin: 0 0 2px 0;
    font-size: 12.5px;
    color: var(--text);
    font-weight: 600;
    line-height: 1.2;
  }

  .feature-content p {
    margin: 0;
    font-size: 11.5px;
    color: var(--muted);
    line-height: 1.35;
  }

  /* Mobile navigation */
  .management-nav-toggle {
    display: none;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    padding: 8px 12px;
    border-radius: 8px;
    border: 1px solid var(--border);
    background: #fff;
    cursor: pointer;
    font: inherit;
    font-weight: 600;
    font-size: 13px;
    color: var(--primary);
    margin: 0;
    width: 100%;
    box-shadow: 0 4px 14px rgba(15, 23, 42, 0.04);
  }

  .management-nav-toggle-label,
  .management-nav-toggle-text {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }

  .management-nav-toggle-current {
    color: #64748b;
    font-weight: 500;
  }

  .management-nav-toggle-caret {
    width: 10px;
    height: 10px;
    border-right: 2px solid currentColor;
    border-bottom: 2px solid currentColor;
    transform: rotate(45deg);
    transition: transform 0.2s ease;
    margin-top: -2px;
  }

  .management-nav-toggle[aria-expanded="true"] .management-nav-toggle-caret {
    transform: rotate(-135deg);
    margin-top: 4px;
  }

  .management-nav-toggle .hub-hamburger-icon {
    position: relative;
    width: 16px;
    height: 2px;
    background: var(--primary);
    display: inline-block;
  }

  .management-nav-toggle .hub-hamburger-icon::before,
  .management-nav-toggle .hub-hamburger-icon::after {
    content: "";
    position: absolute;
    left: 0;
    width: 16px;
    height: 2px;
    background: var(--primary);
  }

  .management-nav-toggle .hub-hamburger-icon::before { top: -5px; }
  .management-nav-toggle .hub-hamburger-icon::after { top: 5px; }

  .management-nav-close {
    display: none;
    background: transparent;
    border: none;
    font-size: 22px;
    cursor: pointer;
    padding: 2px 6px;
    color: #6b7280;
    line-height: 1;
  }

  .management-nav-close:hover { color: var(--text); }

  .management-nav-overlay {
    position: fixed;
    inset: 0;
    background: rgba(15, 23, 42, 0.4);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.25s ease;
    z-index: 1000;
  }

  .management-nav-overlay.show {
    opacity: 1;
    pointer-events: auto;
  }

  @media (max-width: 900px) {
    .management-layout {
      position: relative;
      grid-template-columns: 1fr;
      gap: 10px;
      padding: 10px;
    }

    .management-nav-toggle {
      display: flex;
    }

    /* Nav is pulled out of grid flow entirely – workspace-shell.css handles the hard overrides */
    @keyframes mgNavIn {
      from { opacity: 0; transform: translateY(-6px); }
      to   { opacity: 1; transform: translateY(0); }
    }

    .management-nav-header {
      position: relative;
      margin: 0;
      padding-right: 14px;
      align-items: center;
    }

    .management-nav-close {
      display: none;
    }

    .section-header { padding: 10px 14px; }
    .section-content { padding: 12px 14px 16px; }
    .section-header h1 { font-size: 14px; }
    .section-header p { font-size: 11.5px; }
  }

  @media (max-width: 600px) {
    .features-grid { grid-template-columns: 1fr; }
    .feature-item { gap: 8px; padding: 8px 10px; border-radius: 8px; }
    .feature-icon { width: 26px; height: 26px; border-radius: 7px; }
    .feature-icon svg { width: 14px; height: 14px; }
    .feature-content h4 { font-size: 12px; }
    .feature-content p { font-size: 11px; line-height: 1.3; }
    .action-btn { width: 100%; justify-content: center; }
    .section-card { padding: 12px; }
  }

  @media (max-width: 480px) {
    .management-layout { padding: 8px 8px 16px; gap: 8px; }
    .management-nav-toggle { font-size: 12px; padding: 6px 10px; }
    .section-header { padding: 8px 12px; }
    .section-header h1 { font-size: 13px; }
    .section-header p { font-size: 11px; }
    .section-content { padding: 10px 12px 14px; }
    .section-card { padding: 10px 12px; }
    .section-card h2 { font-size: 13px; }
    .section-card > p { font-size: 11.5px; }
    .action-btn { font-size: 12px; padding: 6px 12px; }
    .feature-item { gap: 7px; padding: 7px 8px; }
    .feature-content h4 { font-size: 11.5px; }
    .feature-content p { font-size: 10.5px; }
  }
</style>
<link rel="stylesheet" href="/css/workspace-shell.css" />

<div class="management-nav-overlay" id="management-nav-overlay"></div>

<div class="management-wrapper">
  <div class="management-layout">
    <!-- Mobile Toggle Button -->
    <button class="management-nav-toggle" id="management-nav-toggle" type="button" aria-expanded="false" aria-controls="management-nav">
      <span class="management-nav-toggle-label">
        <span class="hub-hamburger-icon"></span>
        <span>Menu</span>
      </span>
    </button>

    <!-- Sidebar Navigation -->
    <nav class="management-nav" id="management-nav">
      <div class="management-nav-header">
        <h3>Workspace</h3>
        <button class="management-nav-close" id="management-nav-close">&times;</button>
      </div>
      <ul class="nav-list">
        <li>
          <button class="nav-link active" data-section="school-year">
            <span class="nav-link-icon"><svg fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/></svg></span>
            <span>School Year</span>
          </button>
        </li>
        <li>
          <button class="nav-link" data-section="graduation">
            <span class="nav-link-icon"><svg fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path d="M22 10L12 4 2 10l10 6 10-6z"/><path d="M6 12v5c0 1 3 3 6 3s6-2 6-3v-5"/></svg></span>
            <span>Class, Subject & Grad Year</span>
          </button>
        </li>
        <li>
          <button class="nav-link" data-section="assessment-scores">
            <span class="nav-link-icon"><svg fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><rect x="4" y="3" width="16" height="18" rx="2"/><path d="M9 7h6M8 12h8M8 17h5"/></svg></span>
            <span>Assessments</span>
          </button>
        </li>
        <li>
          <button class="nav-link" data-section="enrollment">
            <span class="nav-link-icon"><svg fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><circle cx="9" cy="8" r="4"/><path d="M2 21c0-3.866 3.134-7 7-7s7 3.134 7 7"/><path d="M19 8v6M16 11h6"/></svg></span>
            <span>Enrollment</span>
          </button>
        </li>
        <li>
          <button class="nav-link" data-section="promotion">
            <span class="nav-link-icon"><svg fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><circle cx="12" cy="12" r="9"/><path d="M8 12l4-4 4 4M12 16V8"/></svg></span>
            <span>Promotion</span>
          </button>
        </li>
        <li>
          <button class="nav-link" data-section="employees">
            <span class="nav-link-icon"><svg fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><circle cx="9" cy="7" r="4"/><path d="M2 21c0-3.866 3.134-7 7-7s7 3.134 7 7"/><circle cx="17" cy="7" r="3"/><path d="M22 19c0-2.5-1.8-4.5-5-5"/></svg></span>
            <span>Employee</span>
          </button>
        </li>
        <li>
          <button class="nav-link" data-section="guardians">
            <span class="nav-link-icon"><svg fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><circle cx="12" cy="8" r="4"/><path d="M4 21c0-4.418 3.582-8 8-8s8 3.582 8 8"/></svg></span>
            <span>Parents/Guardian</span>
          </button>
        </li>
        <li>
          <button class="nav-link" data-section="announcements-events">
            <span class="nav-link-icon"><svg fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path d="M3 11v2a2 2 0 002 2h2l5 4V5L7 9H5a2 2 0 00-2 2z"/><path d="M16 8a5 5 0 010 8"/></svg></span>
            <span>Announcements & Events</span>
          </button>
        </li>
        <% if (hasPublicWebsiteFeature) { %>
        <li>
          <button class="nav-link" data-section="public-website">
            <span class="nav-link-icon"><svg fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3a14 14 0 010 18M12 3a14 14 0 000 18"/></svg></span>
            <span>School Website</span>
          </button>
        </li>
        <% } %>
        <% if (hasFilesFeature) { %>
        <li>
          <button class="nav-link" data-section="documents">
            <span class="nav-link-icon"><svg fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path d="M3 7a2 2 0 012-2h4l2 2h8a2 2 0 012 2v8a2 2 0 01-2 2H5a2 2 0 01-2-2V7z"/></svg></span>
            <span>Docs/Sheets</span>
          </button>
        </li>
        <% } %>
        <% if (canSeeEmailIssues) { %>
        <li>
          <button class="nav-link" data-section="email-issues">
            <span class="nav-link-icon"><svg fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg></span>
            <span>Email Issues<% if (failedEmailCount > 0) { %> <span style="display:inline-block;background:#dc2626;color:#fff;font-size:0.7rem;font-weight:700;border-radius:20px;padding:0 6px;vertical-align:middle;line-height:1.6"><%=failedEmailCount%></span><% } %></span>
          </button>
