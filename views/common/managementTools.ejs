        <% } %>
      </ul>
    </nav>

    <!-- Main Content -->
    <main class="management-main">
      <!-- School Year Section -->
      <section id="school-year" class="management-section active">
        <div class="section-header">
          <h1>School Year Management</h1>
          <p>Configure academic terms and schedules for your organization</p>
        </div>
        <div class="section-content">
          <div class="section-card">
            <h2>Manage School Years & Terms</h2>
            <p>Set up academic years, define terms/semesters, and configure academic calendars. This is fundamental for organizing your school's timeline.</p>
            <div class="features-grid">
              <div class="feature-item">
                <div class="feature-icon">
                  <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
                  </svg>
                </div>
                <div class="feature-content">
                  <h4>Create Academic Years</h4>
                  <p>Define start and end dates for each school year</p>
                </div>
              </div>
              <div class="feature-item">
                <div class="feature-icon">
                  <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
                  </svg>
                </div>
                <div class="feature-content">
                  <h4>Define Terms</h4>
                  <p>Create semesters, quarters, or custom terms</p>
                </div>
              </div>
              <div class="feature-item">
                <div class="feature-icon">
                  <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                  </svg>
                </div>
                <div class="feature-content">
                  <h4>Set Current Term</h4>
                  <p>Mark the active academic term for all operations</p>
                </div>
              </div>
            </div>
            <a href="/common/manageRecords" class="action-btn">
              <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
              </svg>
              Manage School Years
            </a>
          </div>
        </div>
      </section>

      <!-- Classes Section -->
      <section id="classes" class="management-section">
        <div class="section-header">
          <h1>Class Management</h1>
          <p>Create and organize classes for your school</p>
        </div>
        <div class="section-content">
          <div class="section-card">
            <h2>Manage Classes</h2>
            <p>Set up classes, assign teachers, and organize student groups. Essential for structuring your school's learning environment.</p>
            <div class="features-grid">
              <div class="feature-item">
                <div class="feature-icon">
                  <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
                  </svg>
                </div>
                <div class="feature-content">
                  <h4>Create Classes</h4>
                  <p>Add new classes with grade levels</p>
                </div>
              </div>
              <div class="feature-item">
                <div class="feature-icon">
                  <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path>
                  </svg>
                </div>
                <div class="feature-content">
                  <h4>Assign Teachers</h4>
                  <p>Link teachers to their classes</p>
                </div>
              </div>
              <div class="feature-item">
                <div class="feature-icon">
                  <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
                  </svg>
