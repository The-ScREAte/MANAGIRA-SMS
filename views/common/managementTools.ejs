<%
  // Theme color mapping for organization buttons
  const themeColor = (typeof session !== 'undefined' && session && session.themeColor) ? session.themeColor : 'teal';
  const themeColors = themePalette;
  const currentTheme = themeColors[themeColor] || themeColors.teal;
  const hasFilesFeature = Array.isArray(allowedFeatures) && (allowedFeatures.includes('Create Files') || allowedFeatures.includes('Files & Sheets') || allowedFeatures.includes('Docs/Sheets'));
  const hasPublicWebsiteFeature = Array.isArray(allowedFeatures) && (allowedFeatures.includes('School Website') || allowedFeatures.includes('SchoolWebsite') || allowedFeatures.includes('Public Dashboard') || allowedFeatures.includes('School Public Dashboard'));
  const hasTransportationIntegration = !!(transportationIntegration && transportationIntegration.activated);
  const hasMiraIntegration = !!(miraIntegration && miraIntegration.activated);
  const hasPaygiraFeature = Array.isArray(allowedFeatures) && allowedFeatures.some((featureName) => {
    const normalizedFeatureName = String(featureName || '').trim().toLowerCase();
    return normalizedFeatureName === 'paygira'
      || normalizedFeatureName === 'pay gira'
      || normalizedFeatureName === 'paygira & payments'
      || normalizedFeatureName === 'paygira and payments';
  });
  const assessmentUrl = currentTerm
    ? `/common/manageAssessment?organizationId=${organizationId}&termId=${currentTerm.term_id}`
    : `/common/manageAssessment?organizationId=${organizationId}`;
  const assessmentQuestionsUrl = currentTerm
    ? `/common/allClassAssessmentExams?organizationId=${organizationId}&termId=${currentTerm.term_id}`
    : `/common/allClassAssessmentExams?organizationId=${organizationId}`;
  const assessmentQuestionsLabel = currentTerm ? `Assessment Questions (${currentTerm.term_name})` : 'Assessment Questions';
%>

<style>
  :root {
    --border: #e5e7eb;
    --muted: #6b7280;
    --bg: #f9fafb;
    --primary: <%= currentTheme.primary %>;
    --primary-hover: <%= currentTheme.hover %>;
    --primary-hover-fill: color-mix(in srgb, var(--primary) 88%, white);
    --org-primary-color: <%= currentTheme.primary %>;
    --org-primary-hover: <%= currentTheme.hover %>;
    --org-primary-hover-fill: color-mix(in srgb, var(--org-primary-color) 88%, white);
  }

  body {
    background: #f9fafb;
  }

  main {
    padding: 0 !important;
    max-width: none !important;
  }

  .management-wrapper {
    width: 100%;
    height: calc(100vh - 68px);
    overflow: hidden;
  }

  .management-layout {
    display: grid;
    grid-template-columns: 260px 1fr;
    gap: 24px;
    max-width: none;
    margin: 12px 0 0;
    padding: 0 20px 12px;
    align-items: start;
    height: calc(100% - 12px);
    min-height: 0;
  }

  /* Specificity bump for the same reason as .management-layout
     .management-section above — workspace-shell.css's shared nav rule
     (height:fit-content, position:sticky, overflow:hidden) loads after this
     block and would otherwise win on source order. */
  .management-layout .management-nav {
    border: 1px solid var(--border);
    border-radius: 14px;
    padding: 16px 12px;
    background: #fff;
    height: 100%;
    box-shadow: 0 10px 26px rgba(15, 23, 42, 0.08);
    overflow-y: auto;
  }

  .management-nav-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin: 4px 12px 12px;
    width: 100%;
  }

  .management-nav h3 {
    margin: 0;
    font-size: 18px;
    color: var(--primary);
    font-weight: 700;
  }

  .nav-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 2px;
  }

  .nav-list li {
    margin: 0;
  }

  .nav-link {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 10px 14px !important;
    min-height: 42px;
    border-radius: 10px;
    color: #111827;
    text-decoration: none;
    border: 1px solid transparent;
    width: 100%;
    background: transparent;
    cursor: pointer;
    font: inherit;
    text-align: left;
    font-weight: 600;
    font-size: 14px;
    transition: all 0.2s ease;
    flex-direction: row;
    justify-content: flex-start;
    box-sizing: border-box;
  }

  .nav-link:hover {
    background: #f3f4f6;
    border-color: #e5e7eb;
  }

  .nav-link.active {
    background: var(--primary);
    color: #fff;
    border-color: var(--primary);
  }

  .nav-link.active:hover {
    background: var(--primary-hover-fill, var(--primary-hover));
  }

  .nav-link svg {
    color: inherit;
  }

  .nav-link-icon {
    display: inline-flex;
    flex-shrink: 0;
  }

  .nav-link-icon svg {
    width: 22px;
    height: 22px;
  }

  .nav-link-icon img {
    width: 22px;
    height: 22px;
    object-fit: contain;
  }

  .management-main {
    padding: 0;
    background: #fff;
    border-radius: 14px;
    border: 1px solid var(--border);
    box-shadow: 0 10px 30px rgba(15, 23, 42, 0.06);
    overflow: hidden;
    height: 100%;
    min-height: 0;
    display: flex;
    flex-direction: column;
  }

  /* workspace-shell.css (loaded after this block) also targets
     .management-section.active with display:block for the plain hub/settings
     case — scope these selectors under .management-layout so they win on
     specificity instead of load order, keeping the flex chain that lets the
     iframe below fill the panel's real height. */
  .management-layout .management-section {
    display: none;
    flex: 1;
    min-height: 0;
  }

  .management-layout .management-section.active {
    display: flex;
    flex-direction: column;
    flex: 1;
    min-height: 0;
  }

  .embed-panel-body {
    position: relative;
    flex: 1;
    display: flex;
    flex-direction: column;
    min-height: 0;
  }

  .embed-overlay-spinner {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    background: rgba(255, 255, 255, 0.82);
    color: var(--muted);
    font-size: 14px;
    z-index: 5;
  }

  .embed-overlay-spinner[hidden] {
    display: none;
  }

  .embed-iframe {
    width: 100%;
    border: 0;
    display: block;
    /* Fills the panel and scrolls its own content internally — the outer
       hub page never grows past the viewport, so there's only ever one
       scrollbar (the iframe's), not two. */
    flex: 1;
    height: 100%;
    min-height: 0;
  }

  .embed-placeholder {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    gap: 10px;
    padding: 60px 24px;
    color: var(--muted);
  }

  .embed-placeholder svg {
    width: 32px;
    height: 32px;
    color: var(--primary);
    opacity: 0.7;
  }

  .embed-placeholder p {
    margin: 0;
    font-size: 14px;
  }

  .embed-loading {
    flex: 1;
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 60px 20px;
    justify-content: center;
    color: var(--muted);
    font-size: 14px;
  }

  .embed-error {
    padding: 24px;
    color: #b3261e;
    font-size: 14px;
    line-height: 1.6;
  }

  .embed-error a {
    color: var(--primary);
    font-weight: 600;
  }

  .btn-spinner {
    display: inline-block;
    width: 16px;
    height: 16px;
    border: 2px solid rgba(1, 83, 91, 0.2);
    border-top-color: var(--primary);
    border-radius: 50%;
    animation: embed-spin 0.7s linear infinite;
  }

  @keyframes embed-spin {
    to { transform: rotate(360deg); }
  }

  /* Mobile navigation */
  .management-nav-toggle {
    display: none;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    padding: 8px 12px !important;
    border-radius: 8px;
    border: 1px solid var(--border);
    background: #fff;
    cursor: pointer;
    font: inherit;
    font-weight: 600;
    font-size: 13px;
    color: var(--primary);
    margin: 0;
    width: 100%;
    box-shadow: 0 4px 14px rgba(15, 23, 42, 0.04);
  }

  .management-nav-toggle-label {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }

  .hub-hamburger-icon {
    position: relative;
    width: 18px;
    height: 2px;
    background: var(--primary);
    display: inline-block;
    flex-shrink: 0;
  }

  .hub-hamburger-icon::before,
  .hub-hamburger-icon::after {
    content: "";
    position: absolute;
    left: 0;
    width: 18px;
    height: 2px;
    background: var(--primary);
  }

  .hub-hamburger-icon::before { top: -6px; }
  .hub-hamburger-icon::after { top: 6px; }

  .management-nav-close {
    display: none;
    background: transparent;
    border: none;
    font-size: 24px;
    cursor: pointer;
    padding: 4px 8px;
    color: #6b7280;
    line-height: 1;
  }

  .management-nav-close:hover {
    color: #111827;
  }

  /* Desktop-only rail collapse: shrinks the sidebar to icon-only width and
     hands the freed grid column over to .management-main. Hidden on mobile
     (see media query below) since the sidebar is already an overlay there.
     Kept to fast (<=160ms), cheap-to-animate properties (opacity/max-width/
     transform, one grid-template-columns transition) so it stays snappy. */
  .management-layout {
    transition: grid-template-columns 0.16s ease;
  }

  .management-layout.is-nav-collapsed {
    grid-template-columns: 76px 1fr;
  }

  .management-nav-collapse-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    border-radius: 8px;
    border: 1px solid var(--border);
    background: #fff;
    color: #6b7280;
    cursor: pointer;
    padding: 0;
    flex-shrink: 0;
    transition: color 0.15s ease, border-color 0.15s ease, background-color 0.15s ease, transform 0.1s ease;
  }

  .management-nav-collapse-toggle:hover {
    color: var(--primary);
    border-color: var(--primary);
    background: #f8fafc;
  }

  .management-nav-collapse-toggle:active {
    transform: scale(0.9);
  }

  .management-nav-collapse-toggle svg {
    width: 16px;
    height: 16px;
  }

  .management-nav.is-collapsed .management-nav-collapse-toggle {
    color: var(--primary);
    border-color: var(--primary);
  }

  .management-nav-header h3 {
    opacity: 1;
    transition: opacity 0.1s ease;
  }

  .management-nav.is-collapsed .management-nav-header {
    justify-content: center;
    margin-left: 0;
    margin-right: 0;
  }

  .management-nav.is-collapsed .management-nav-header h3 {
    display: none;
    opacity: 0;
  }

  .management-nav.is-collapsed .nav-link {
    justify-content: center;
    padding: 10px !important;
    gap: 0;
  }

  .nav-link > span:not(.nav-link-icon) {
    display: inline-block;
    max-width: 220px;
    opacity: 1;
    white-space: nowrap;
    overflow: hidden;
    transition: opacity 0.12s ease, max-width 0.16s ease;
  }

  .management-nav.is-collapsed .nav-link > span:not(.nav-link-icon) {
    opacity: 0;
    max-width: 0;
  }

  .management-nav-overlay {
    position: fixed;
    inset: 0;
    background: rgba(15, 23, 42, 0.4);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.25s ease;
    z-index: 1000;
  }

  .management-nav-overlay.show {
    opacity: 1;
    pointer-events: auto;
  }

  @media (max-width: 900px) {
    .management-nav-toggle {
      display: flex;
    }
    .management-nav-close { display: none; }
    .management-nav-collapse-toggle { display: none; }

    /* Same collapse pattern used across every hub: the sidebar becomes a
       hamburger-triggered overlay and the content column takes the full
       width below it, instead of squeezing both into a cramped row.
       .management-nav is display:none on mobile (it becomes an overlay),
       so the grid only has 2 visible children here — the toggle button and
       .management-main — which stack into two ROWS instead of sitting
       side-by-side in one row like on desktop. Without an explicit row
       size, the toggle's row sizes to its content and the leftover space
       in the fixed-height .management-layout is never handed to
       .management-main's row, collapsing the iframe inside it to near
       nothing and leaving a blank gap. Give the second row the rest. */
    .management-layout {
      grid-template-columns: 1fr !important;
      grid-template-rows: auto 1fr !important;
    }
  }

  /* Features not turned on yet: shown so schools know they exist. */
  .nav-link.nav-link--off { opacity: .6; }
  .nav-link.nav-link--off:hover { opacity: 1; }
  .nav-link--off .nav-link-icon img { filter: grayscale(1); }
  .nav-turn-on { display: inline-block; margin-left: 4px; padding: 0 6px; border: 1px solid currentColor; border-radius: 999px; font-size: 10.5px; font-weight: 700; line-height: 1.5; vertical-align: middle; }
</style>
