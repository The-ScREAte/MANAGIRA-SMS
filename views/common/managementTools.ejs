    <script>
      document.addEventListener('DOMContentLoaded', function() {
        const navLinks = document.querySelectorAll('.nav-link');
        const sections = document.querySelectorAll('.management-section');
        const navToggle = document.getElementById('management-nav-toggle');
        const nav = document.getElementById('management-nav');
        const navClose = document.getElementById('management-nav-close');
        const overlay = document.getElementById('management-nav-overlay');

        // Section navigation
        navLinks.forEach(link => {
          link.addEventListener('click', function() {
            const sectionId = this.getAttribute('data-section');
            
            navLinks.forEach(l => l.classList.remove('active'));
            this.classList.add('active');
            
            sections.forEach(s => s.classList.remove('active'));
            document.getElementById(sectionId).classList.add('active');

            if (window.innerWidth <= 900) {
              nav.classList.remove('open');
              overlay.classList.remove('show');
            }

            history.replaceState(null, null, '#' + sectionId);
          });
        });

        // Mobile navigation toggle
        navToggle.addEventListener('click', function() {
          nav.classList.add('open');
          overlay.classList.add('show');
        });

        navClose.addEventListener('click', function() {
          nav.classList.remove('open');
          overlay.classList.remove('show');
        });

        overlay.addEventListener('click', function() {
          nav.classList.remove('open');
          overlay.classList.remove('show');
        });

        // Handle initial hash
        if (window.location.hash) {
          const sectionId = window.location.hash.substring(1);
          const targetLink = document.querySelector(`.nav-link[data-section="${sectionId}"]`);
          if (targetLink) {
            targetLink.click();
          }
        }
      });
    </script>
