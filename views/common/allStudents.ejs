  function closeBulkModal() { bulkOverlay.classList.remove('open'); }

  function showBulkStep2() {
    var hasClass = chkClass.checked && selClass.value;
    var hasYear  = chkYear.checked  && selYear.value;
    var hasStudentId = !!(chkStudentId && chkStudentId.checked);
    if (!hasClass && !hasYear && !hasStudentId) {
      bulkMsg.textContent='Tick at least one field and choose a value.'; bulkMsg.className='as-modal-msg error'; return;
    }
    if (chkClass.checked && !selClass.value) {
      bulkMsg.textContent='Please select a class.'; bulkMsg.className='as-modal-msg error'; return;
    }
    if (chkYear.checked && !selYear.value) {
      bulkMsg.textContent='Please select a school year.'; bulkMsg.className='as-modal-msg error'; return;
    }
    var studentIdChangesCount = 0;
    if (hasStudentId) {
      var enteredValues = [];
      var duplicateValues = new Set();
      var seenValues = new Set();
      var idInputs = Array.from(bulkStudentIdList ? bulkStudentIdList.querySelectorAll('.as-bulk-id-input') : []);
      idInputs.forEach(function(input) {
        var cleaned = normalizeNumericStudentIdValue(input.value);
        input.value = cleaned;
        var original = normalizeNumericStudentIdValue(input.dataset.original || '');
        if (cleaned !== original) studentIdChangesCount += 1;
        if (cleaned && cleaned !== original) {
          enteredValues.push(cleaned);
        }
      });
      enteredValues.forEach(function(value) {
        if (seenValues.has(value)) duplicateValues.add(value);
        seenValues.add(value);
      });
      if (duplicateValues.size) {
        bulkMsg.textContent='Duplicate student IDs entered: ' + Array.from(duplicateValues).join(', ');
        bulkMsg.className='as-modal-msg error';
        return;
      }
      if (!hasClass && !hasYear && studentIdChangesCount === 0) {
        bulkMsg.textContent='No student ID changes detected. Edit at least one ID before continuing.';
        bulkMsg.className='as-modal-msg error';
        return;
      }

      var hasLiveErrors = idInputs.some(function(input) {
        return !!String(input.dataset.error || '').trim();
      });
      if (hasLiveErrors) {
        bulkMsg.textContent='Please fix highlighted Student ID errors before continuing.';
        bulkMsg.className='as-modal-msg error';
        return;
      }
    }
    if (hasClass && bulkKeepExistingSubjectsClassId !== selClass.value) {
      bulkKeepExistingSubjects = askSubjectCarryoverPreference('these students');
      bulkKeepExistingSubjectsClassId = selClass.value;
    }
    var n = selectedIds.size;
    bulkConfirmDetail.textContent = 'You are about to apply the following changes to '+n+' student'+(n===1?'':' s')+'. This will update the class roster immediately.';
    var summary = '';
    if (hasClass) {
      summary += '<div class="as-change-row"><span class="as-change-label">New class:</span>'+pill(selClass.options[selClass.selectedIndex].text,'to')+'</div>';
      summary += '<div class="as-change-row"><span class="as-change-label">Subjects:</span>'+pill(describeSubjectCarryoverChoice(!!bulkKeepExistingSubjects), bulkKeepExistingSubjects ? 'to' : 'from')+'</div>';
    }
    if (hasYear) {
      summary += '<div class="as-change-row"><span class="as-change-label">School year:</span>'+pill(selYear.options[selYear.selectedIndex].text,'year')+'</div>';
    }
    if (hasStudentId) {
      summary += '<div class="as-change-row"><span class="as-change-label">Student IDs:</span>'+pill(studentIdChangesCount + ' student(s) edited','to')+'</div>';
    }
    summary += '<div class="as-change-row" style="margin-top:8px;"><span class="as-change-label">Students:</span>'+
      '<span style="font-size:13px;font-weight:700;color:#374151;">'+n+' selected</span></div>';
    bulkChangeSummary.innerHTML = summary;
    bulkMsg2.textContent=''; bulkMsg2.className='as-modal-msg';
    bulkSave.disabled=false;
    bulkStep1.style.display='none'; bulkStep2.style.display='';
  }

  bulkClose.addEventListener('click', closeBulkModal);
  bulkCancel.addEventListener('click', closeBulkModal);
  bulkOverlay.addEventListener('click', function(e){ if(e.target===bulkOverlay) closeBulkModal(); });
  bulkReview.addEventListener('click', showBulkStep2);
  bulkBack.addEventListener('click', function(){ bulkStep2.style.display='none'; bulkStep1.style.display=''; });

  document.addEventListener('keydown', function(e){
    if (e.key!=='Escape') return;
    if (overlay.classList.contains('open'))     closeModal();
    if (bulkOverlay.classList.contains('open')) closeBulkModal();
  });

  bulkSave.addEventListener('click', function(){
    var hasClass = chkClass.checked && selClass.value;
    var hasYear  = chkYear.checked  && selYear.value;
    var hasStudentId = !!(chkStudentId && chkStudentId.checked);
    bulkSave.disabled=true;
    bulkMsg2.textContent='Applying changes…'; bulkMsg2.className='as-modal-msg';
    var payload = { studentIds: Array.from(selectedIds) };
    if (hasClass) payload.classId = selClass.value;
    if (hasYear)  payload.schoolYearId = selYear.value;
    if (hasClass) payload.keepExistingSubjects = !!bulkKeepExistingSubjects;
    if (hasStudentId) {
      var customStudentIds = {};
      Array.from(bulkStudentIdList ? bulkStudentIdList.querySelectorAll('.as-bulk-id-input') : []).forEach(function(input) {
        var cleaned = normalizeNumericStudentIdValue(input.value);
        var original = normalizeNumericStudentIdValue(input.dataset.original || '');
        if (cleaned !== original) {
          customStudentIds[String(input.dataset.studentId)] = cleaned;
        }
      });
      if (Object.keys(customStudentIds).length) {
        payload.customStudentIds = customStudentIds;
      }
    }
    fetch('/common/students/bulk-update', {
      method:'POST',
      headers:{'Content-Type':'application/json','X-Requested-With':'XMLHttpRequest'},
      credentials:'same-origin',
      body:JSON.stringify(payload)
    }).then(function(r){ return r.json(); }).then(function(data){
      if (data.success) {
        selectedIds.forEach(function(id){
            if (hasClass && data.className) {
              setStudentClassValue(id, selClass.value, data.className);
            }
            if (hasYear && data.yearLabel) {
              setStudentYearValue(id, selYear.value, data.yearLabel, !!data.yearIsCurrent);
            }
            if (data.updatedStudentIds && data.updatedStudentIds[String(id)]) {
              var updatedIdData = data.updatedStudentIds[String(id)];
              setStudentDisplayId(id, updatedIdData.displayStudentId, updatedIdData.editableStudentId);
            }
        });
        var bulkCarryoverNotice = joinSubjectCarryoverMessages(data);
        bulkMsg2.textContent = data.updated+' student'+(data.updated===1?'':' s')+' updated successfully!'+(bulkCarryoverNotice ? ' ' + bulkCarryoverNotice : '');
        bulkMsg2.className='as-modal-msg success';
        setTimeout(function(){ closeBulkModal(); clearAllSelections(); }, 1100);
      } else {
        bulkMsg2.textContent=data.error||'Bulk update failed.'; bulkMsg2.className='as-modal-msg error';
        bulkSave.disabled=false;
      }
    }).catch(function(){
      bulkMsg2.textContent='Network error. Please try again.'; bulkMsg2.className='as-modal-msg error';
      bulkSave.disabled=false;
    });
  });
  selClass.addEventListener('change', function(){ bulkKeepExistingSubjects = null; bulkKeepExistingSubjectsClassId = ''; });
  if (bulkStudentIdSearch) {
    bulkStudentIdSearch.addEventListener('input', applyBulkStudentIdSearchFilter);
  }

  window.addEventListener('resize', updateModalHeaderOffset);
  updateModalHeaderOffset();

  applyFilters(true);

})();
</script>
