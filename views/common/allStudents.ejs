  chkClass.addEventListener('change', function(){ selClass.disabled=!this.checked; if(this.checked) selClass.focus(); });
  chkYear.addEventListener('change',  function(){ selYear.disabled=!this.checked;  if(this.checked) selYear.focus(); });
