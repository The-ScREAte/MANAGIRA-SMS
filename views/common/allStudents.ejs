  modalSelect.addEventListener('change', function(){ _carryExistingSubjects = null; _carryExistingSubjectsClassId = ''; });

  /* ── Bulk Edit Modal (2-step) ────────────────────────── */
  var bulkOverlay  = document.getElementById('asBulkOverlay');
  var bulkClose    = document.getElementById('asBulkClose');
  var bulkCancel   = document.getElementById('asBulkCancel');
  var bulkReview   = document.getElementById('asBulkReview');
  var bulkBack     = document.getElementById('asBulkBack');
  var bulkSave     = document.getElementById('asBulkSave');
  var bulkMsg      = document.getElementById('asBulkMsg');
  var bulkMsg2     = document.getElementById('asBulkMsg2');
  var bulkPillNum  = document.getElementById('asBulkPillNum');
  var bulkPillText = document.getElementById('asBulkPillText');
  var bulkSaveCnt  = document.getElementById('asBulkSaveCount');
  var bulkStep1    = document.getElementById('asBulkStep1');
  var bulkStep2    = document.getElementById('asBulkStep2');
  var bulkConfirmDetail = document.getElementById('asBulkConfirmDetail');
