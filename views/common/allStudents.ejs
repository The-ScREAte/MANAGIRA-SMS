    var newClassName = newClassId ? modalSelect.options[modalSelect.selectedIndex].text : '—';
    var newSchoolYearId = modalYearSelect ? (modalYearSelect.value || '') : '';
    var newSchoolYearLabel = newSchoolYearId && modalYearSelect
