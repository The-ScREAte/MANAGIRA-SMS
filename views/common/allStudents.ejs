    if (hasIdChange) {
      summary.push(
        '<div class="as-change-row"><span class="as-change-label">Student ID:</span>'+pill(_oldDisplayId,'from')+'<span style="color:#94a3b8;">→</span>'+pill(buildDisplayStudentId(newStudentIdValue, _sid),'to')+'</div>'
      );
