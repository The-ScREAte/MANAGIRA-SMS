        </button>
      </div>
    </div>

    <!-- Step 2: Confirm -->
    <div id="asBulkStep2" style="display:none">
      <div class="as-modal-body">
        <div class="as-confirm-banner">
          <div class="as-confirm-icon">
            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2" style="width:22px;height:22px"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v4m0 4h.01M12 2a10 10 0 100 20A10 10 0 0012 2z"/></svg>
          </div>
          <div class="as-confirm-text">
            <div class="as-confirm-title">Confirm Bulk Changes</div>
            <div class="as-confirm-detail" id="asBulkConfirmDetail"></div>
          </div>
        </div>
        <div id="asBulkChangeSummary" style="margin-top:14px;"></div>
        <div class="as-modal-msg" id="asBulkMsg2"></div>
      </div>
      <div class="as-modal-footer">
        <button class="as-modal-cancel" id="asBulkBack">
          <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5" style="width:13px;height:13px"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/></svg>
          Go Back
        </button>
        <button class="as-modal-save" id="asBulkSave">
          <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5" style="width:14px;height:14px"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
          Confirm &amp; Apply to <span id="asBulkSaveCount">0</span> Students
        </button>
      </div>
    </div>
  </div>
</div>

<script>
(function () {
  'use strict';

  var studentIdConfig = {
    enabled: <%- JSON.stringify(Boolean(studentIdSettings && studentIdSettings.use_custom_student_id)) %>,
    prefix: <%- JSON.stringify((studentIdSettings && studentIdSettings.student_id_prefix) || '') %>,
  };

  /* ── Helpers ─────────────────────────────────────────── */
  function escHtml(str) {
    return String(str || '')
      .replace(/&/g, '&amp;').replace(/</g, '&lt;')
      .replace(/>/g, '&gt;').replace(/"/g, '&quot;');
  }
  function pill(text, type) {
    return '<span class="as-change-pill ' + type + '">' + escHtml(text) + '</span>';
  }
  function normalizeNumericStudentIdValue(value) {
    return String(value || '').replace(/\D/g, '').slice(0, 10);
  }
  function buildDisplayStudentId(studentIdValue, systemStudentId) {
    if (!studentIdConfig.enabled) {
      return '#' + String(systemStudentId || '');
    }
    var numericValue = normalizeNumericStudentIdValue(studentIdValue);
    if (numericValue) {
      return studentIdConfig.prefix + numericValue;
    }
    var systemIdText = String(systemStudentId || '').trim();
    if (!systemIdText) return studentIdConfig.prefix;
    return studentIdConfig.prefix + systemIdText.padStart(Math.max(3, systemIdText.length), '0');
  }
  function setStudentDisplayId(studentId, displayId, editableId) {
    var row = document.querySelector('#asTableBody tr[data-id="' + studentId + '"]');
    var card = document.querySelector('#asCardList .as-card[data-id="' + studentId + '"]');
    [row, card].forEach(function(node) {
      if (!node) return;
      node.dataset.searchId = String(displayId || '').toLowerCase();
      node.dataset.displayId = displayId || '';
      var badge = node.querySelector('.js-student-display-id');
      if (badge) badge.textContent = displayId || '';
      var editBtn = node.querySelector('.js-edit-class');
      if (editBtn) {
        editBtn.dataset.displayId = displayId || '';
        if (editableId !== undefined) {
          editBtn.dataset.editableId = editableId || '';
        }
      }
    });
  }
  function setStudentClassValue(studentId, classId, className) {
    var row = document.querySelector('#asTableBody tr[data-id="' + studentId + '"]');
    var card = document.querySelector('#asCardList .as-card[data-id="' + studentId + '"]');
    if (row) {
      row.dataset.classId = classId || '';
      var rowValue = row.querySelector('.js-student-class-value');
      if (rowValue) {
        rowValue.textContent = className || '—';
        rowValue.classList.toggle('as-class-blank', !className);
      }
      var rowBtn = row.querySelector('.js-edit-class');
      if (rowBtn) {
        rowBtn.dataset.classId = classId || '';
        rowBtn.dataset.className = className || '';
      }
    }
    if (card) {
      card.dataset.classId = classId || '';
      var cardValue = card.querySelector('.js-student-class-value');
      if (cardValue) {
        cardValue.textContent = className || 'No class';
      }
      var cardBtn = card.querySelector('.js-edit-class');
      if (cardBtn) {
        cardBtn.dataset.classId = classId || '';
        cardBtn.dataset.className = className || '';
      }
    }
  }
  function setStudentYearValue(studentId, schoolYearId, yearLabel, yearIsCurrent) {
    var row = document.querySelector('#asTableBody tr[data-id="' + studentId + '"]');
    var card = document.querySelector('#asCardList .as-card[data-id="' + studentId + '"]');
    if (row) {
      row.dataset.schoolYearId = schoolYearId || '';
      var rowValue = row.querySelector('.js-student-year-value');
      if (rowValue) {
        rowValue.className = 'js-student-year-value ' + (yearLabel ? 'as-syear-curr' : 'as-syear-none');
        rowValue.innerHTML = yearLabel
          ? escHtml(yearLabel) + (yearIsCurrent ? '<span class="as-syear-label">Current</span>' : '')
          : '—';
      }
      var rowBtn = row.querySelector('.js-edit-class');
      if (rowBtn) {
        rowBtn.dataset.schoolYearId = schoolYearId || '';
        rowBtn.dataset.schoolYearLabel = yearLabel || '';
        rowBtn.dataset.yearCurrent = yearIsCurrent ? 'true' : 'false';
      }
    }
    if (card) {
      card.dataset.schoolYearId = schoolYearId || '';
      var cardValue = card.querySelector('.js-student-year-value');
      if (cardValue) {
        cardValue.innerHTML = yearLabel
          ? escHtml(yearLabel) + (yearIsCurrent ? ' <span class="as-syear-label">Current</span>' : '')
          : 'No year';
      }
      var cardBtn = card.querySelector('.js-edit-class');
      if (cardBtn) {
        cardBtn.dataset.schoolYearId = schoolYearId || '';
        cardBtn.dataset.schoolYearLabel = yearLabel || '';
        cardBtn.dataset.yearCurrent = yearIsCurrent ? 'true' : 'false';
      }
    }
  }

  function updateModalHeaderOffset() {
    var selectors = ['header', '#header', '.header', '.navbar', '.top-nav', '.main-header'];
    var maxBottom = 0;
    selectors.forEach(function(selector) {
      var el = document.querySelector(selector);
      if (!el) return;
      var style = window.getComputedStyle(el);
      if (style.position !== 'fixed' && style.position !== 'sticky') return;
      var rect = el.getBoundingClientRect();
      if (!rect || rect.height <= 0) return;
      if (rect.bottom > maxBottom) maxBottom = rect.bottom;
    });

    // Keep a stable minimum offset so modal content is never pinned to the top edge.
    var offset = Math.max(64, Math.ceil(maxBottom) + 8);
    document.documentElement.style.setProperty('--as-header-offset', String(offset) + 'px');
  }

  /* ── Filters ─────────────────────────────────────────── */
  var filters = { search: '', classId: '', gender: '', status: '' };
  var searchInput  = document.getElementById('asSearch');
  var filterClass  = document.getElementById('asFilterClass');
  var filterGender = document.getElementById('asFilterGender');
  var filterStatus = document.getElementById('asFilterStatus');
  var resetBtn     = document.getElementById('asFilterReset');
  var visibleCount = document.getElementById('asVisibleCount');
  var emptyState   = document.getElementById('asEmpty');
  var pageSizeSelect = document.getElementById('asPageSizeSelect');
  var pagePrevBtn = document.getElementById('asPagePrev');
  var pageNextBtn = document.getElementById('asPageNext');
  var pageInfo = document.getElementById('asPageInfo');
  var pagination = { pageSize: 50, currentPage: 1, totalPages: 1 };

  // Mobile filter toggle
  var filterToggle = document.getElementById('asFilterToggle');
  var filtersPanel = document.getElementById('asFiltersPanel');
  if (filterToggle) {
    filterToggle.addEventListener('click', function () {
      var open = filtersPanel.classList.toggle('as-filters-open');
      filterToggle.setAttribute('aria-expanded', open ? 'true' : 'false');
    });
  }

  function getVisibleRows()  { return Array.from(document.querySelectorAll('#asTableBody tr:not(.as-row-hidden)')); }
  function getVisibleCards() { return Array.from(document.querySelectorAll('#asCardList .as-card:not(.as-row-hidden)')); }

  function renderCurrentPage(filteredRows) {
    var total = filteredRows.length;
    pagination.totalPages = Math.max(1, Math.ceil(total / pagination.pageSize));
    if (pagination.currentPage > pagination.totalPages) pagination.currentPage = pagination.totalPages;
    if (pagination.currentPage < 1) pagination.currentPage = 1;

    var start = (pagination.currentPage - 1) * pagination.pageSize;
    var end = start + pagination.pageSize;
    var pageRows = filteredRows.slice(start, end);
    var pageIds = new Set(pageRows.map(function(tr){ return String(tr.dataset.id || ''); }));

    Array.from(document.querySelectorAll('#asTableBody tr')).forEach(function(tr){
      tr.classList.toggle('as-row-hidden', !pageIds.has(String(tr.dataset.id || '')));
    });
    Array.from(document.querySelectorAll('#asCardList .as-card')).forEach(function(card){
      card.classList.toggle('as-row-hidden', !pageIds.has(String(card.dataset.id || '')));
    });

    var pageCount = pageRows.length;
    visibleCount.textContent = pageCount;
    emptyState.style.display = total === 0 ? 'block' : 'none';

    if (pageInfo) pageInfo.textContent = pagination.currentPage + '/' + pagination.totalPages;
    if (pagePrevBtn) pagePrevBtn.disabled = pagination.currentPage <= 1 || total === 0;
    if (pageNextBtn) pageNextBtn.disabled = pagination.currentPage >= pagination.totalPages || total === 0;
  }

  function applyFilters(resetPage) {
    if (resetPage === undefined) resetPage = true;
    if (resetPage) pagination.currentPage = 1;

    var s = filters.search.trim().toLowerCase(), clsId = filters.classId,
        gen = filters.gender.toLowerCase(), stat = filters.status;
    function match(el) {
      if (s && (el.dataset.name||'').indexOf(s)===-1 && (el.dataset.searchId||'').indexOf(s)===-1 && String(el.dataset.id||'').indexOf(s)===-1) return false;
      if (clsId && (el.dataset.classId||'') !== clsId) return false;
      if (gen   && (el.dataset.gender||'').toLowerCase() !== gen)  return false;
      if (stat  && (el.dataset.status||'') !== stat) return false;
      return true;
    }

    var filteredRows = Array.from(document.querySelectorAll('#asTableBody tr')).filter(function(tr){ return match(tr); });
    renderCurrentPage(filteredRows);
    syncSelectAll();
  }
  searchInput.addEventListener('input',   function(){ filters.search  = this.value; applyFilters(true); });
  filterClass.addEventListener('change',  function(){ filters.classId = this.value; applyFilters(true); });
  filterGender.addEventListener('change', function(){ filters.gender  = this.value; applyFilters(true); });
  filterStatus.addEventListener('change', function(){ filters.status  = this.value; applyFilters(true); });
  resetBtn.addEventListener('click', function(){
    searchInput.value=filterClass.value=filterGender.value=filterStatus.value='';
    filters={search:'',classId:'',gender:'',status:''}; applyFilters(true);
  });
  if (pageSizeSelect) {
    pageSizeSelect.addEventListener('change', function() {
      var parsed = parseInt(this.value, 10);
      pagination.pageSize = Number.isInteger(parsed) && parsed > 0 ? parsed : 50;
      applyFilters(true);
    });
  }
  if (pagePrevBtn) {
    pagePrevBtn.addEventListener('click', function() {
      if (pagination.currentPage <= 1) return;
      pagination.currentPage -= 1;
      applyFilters(false);
    });
  }
  if (pageNextBtn) {
    pageNextBtn.addEventListener('click', function() {
      if (pagination.currentPage >= pagination.totalPages) return;
      pagination.currentPage += 1;
      applyFilters(false);
    });
  }

  /* ── Selection ───────────────────────────────────────── */
  var selectedIds = new Set();
  var bulkBar       = document.getElementById('asBulkBar');
  var bulkCountText = document.getElementById('asBulkCountText');
  var bulkEditBtn   = document.getElementById('asBulkEditBtn');
  var bulkClearBtn  = document.getElementById('asBulkClearBtn');
  var selectAllCb   = document.getElementById('asSelectAll');
  var bulkModeBtn   = document.getElementById('asBulkModeBtn');

  function updateBulkBar() {
    var n = selectedIds.size;
    bulkCountText.textContent = n===1 ? '1 student selected' : n+' students selected';
    bulkBar.classList.toggle('active', n>0);
    syncSelectAll();
  }
  function syncSelectAll() {
    if (!selectAllCb) return;
    var cbs = getVisibleRows().map(function(tr){ return tr.querySelector('.as-row-cb'); }).filter(Boolean);
    if (!cbs.length) { selectAllCb.indeterminate=false; selectAllCb.checked=false; return; }
    var n = cbs.filter(function(cb){ return cb.checked; }).length;
    selectAllCb.checked = n===cbs.length; selectAllCb.indeterminate = n>0 && n<cbs.length;
  }
  function setRowSelected(id, checked) {
    id = String(id);
    var row  = document.querySelector('#asTableBody tr[data-id="'+id+'"]');
    var card = document.querySelector('#asCardList .as-card[data-id="'+id+'"]');
    if (row)  { row.classList.toggle('as-row-selected',checked);   var cb=row.querySelector('.as-row-cb');   if(cb)  cb.checked=checked; }
    if (card) { card.classList.toggle('as-card-selected',checked); var cb=card.querySelector('.as-card-cb'); if(cb)  cb.checked=checked; }
    if (checked) selectedIds.add(id); else selectedIds.delete(id);
  }
  function clearAllSelections() {
    selectedIds.forEach(function(id){ setRowSelected(id,false); });
    selectedIds.clear(); updateBulkBar();
  }
  document.addEventListener('change', function(e){
    var cb = e.target;
    if (cb.classList.contains('as-row-cb') || cb.classList.contains('as-card-cb')) {
      setRowSelected(cb.dataset.id, cb.checked); updateBulkBar();
    }
  });
  if (selectAllCb) {
