    _studentIdTimer = setTimeout(function() {
      var token = String(++_studentIdToken);
      modalStudentIdInput.dataset.requestToken = token;
      fetch('/common/check-student-id?id=' + encodeURIComponent(studentIdConfig.prefix + currentValue) + '&num=' + encodeURIComponent(currentValue) + '&exclude=' + encodeURIComponent(_sid))
        .then(function(response) { return response.json(); })
        .then(function(data) {
          if (modalStudentIdInput.dataset.requestToken !== token) return;
          var taken = !!(data && data.taken);
          modalStudentIdInput.classList.toggle('is-error', taken);
          modalStudentIdMsg.classList.toggle('visible', taken);
        })
        .catch(function() {
          if (modalStudentIdInput.dataset.requestToken !== token) return;
          clearStudentIdInlineState();
        });
