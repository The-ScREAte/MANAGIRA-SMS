            <label for="asBulkChkStudentId">Edit Student IDs</label>
          </div>
          <input type="text" class="as-bfield-select" id="asBulkStudentIdSearch" placeholder="Search selected students by name..." style="display:none;" autocomplete="off">
          <div class="as-modal-hint" style="margin-top:2px;">
            Numbers only. Leave blank to remove manual ID.
          </div>
          <div class="as-bulk-id-list" id="asBulkStudentIdList" style="display:none;"></div>
