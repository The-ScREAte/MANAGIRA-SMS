          '</div>' +
          '<div>' +
            '<input type="text" class="as-bulk-id-input" inputmode="numeric" maxlength="10" ' +
              'data-student-id="' + escHtml(studentRow.id) + '" data-original="' + escHtml(studentRow.editableId || '') + '" ' +
              'value="' + escHtml(studentRow.editableId || '') + '" placeholder="000">' +
            '<div class="as-bulk-id-error"></div>' +
          '</div>' +
        '</div>';
    }).join('');

    bulkStudentIdList.querySelectorAll('.as-bulk-id-input').forEach(function(input) {
      input.addEventListener('input', function() {
        input.value = normalizeNumericStudentIdValue(input.value);
        checkBulkStudentIdAgainstOrg(input);
      });
      input.addEventListener('blur', function() {
        checkBulkStudentIdAgainstOrg(input);
      });
    });

    if (bulkStudentIdSearch) {
      bulkStudentIdSearch.value = '';
    }
    applyBulkStudentIdSearchFilter();
    validateBulkStudentIdDuplicates();
  }

  function openBulkModal() {
    if (!selectedIds.size) return;
    updateModalHeaderOffset();
