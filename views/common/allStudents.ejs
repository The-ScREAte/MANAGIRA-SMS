      : '—';
    var newStudentIdValue = modalStudentIdInput ? normalizeNumericStudentIdValue(modalStudentIdInput.value) : '';
    if (modalStudentIdInput) modalStudentIdInput.value = newStudentIdValue;
    var hasClassChange = newClassId !== _oldClassId;
    var hasYearChange = newSchoolYearId !== _oldSchoolYearId;
    var hasIdChange = !!modalStudentIdInput && newStudentIdValue !== _oldEditableId;

    if (!hasClassChange && !hasYearChange && !hasIdChange) {
      modalMsg.textContent='Make at least one change before saving.'; modalMsg.className='as-modal-msg error'; return;
    }
    if (modalStudentIdInput && modalStudentIdInput.classList.contains('is-error')) {
      modalMsg.textContent='This student ID is already in use.'; modalMsg.className='as-modal-msg error'; return;
    }
    if (hasClassChange && _carryExistingSubjectsClassId !== newClassId) {
      _carryExistingSubjects = askSubjectCarryoverPreference('this student');
      _carryExistingSubjectsClassId = newClassId;
