  modalSave.addEventListener('click', function(){
    var newClassId = modalSelect.value || '';
    var newSchoolYearId = modalYearSelect ? (modalYearSelect.value || '') : '';
    var newStudentIdValue = modalStudentIdInput ? normalizeNumericStudentIdValue(modalStudentIdInput.value) : '';
    var hasClassChange = newClassId !== _oldClassId;
    var hasYearChange = !!newSchoolYearId && newSchoolYearId !== _oldSchoolYearId;
    var hasIdChange = !!modalStudentIdInput && newStudentIdValue !== _oldEditableId;

    if (!hasClassChange && !hasYearChange && !hasIdChange) {
      modalMsg2.textContent='No changes to save.'; modalMsg2.className='as-modal-msg error'; return;
    }

    modalSave.disabled=true;
    modalMsg2.textContent='Saving…'; modalMsg2.className='as-modal-msg';
    var payload = {};
    if (hasClassChange) payload.classId = newClassId;
    if (hasYearChange) payload.schoolYearId = newSchoolYearId;
    if (hasIdChange) payload.customStudentId = newStudentIdValue;
    if (hasClassChange) payload.keepExistingSubjects = !!_carryExistingSubjects;

    fetch('/common/students/'+_sid+'/update-details', {
      method:'POST',
      headers:{'Content-Type':'application/json','X-Requested-With':'XMLHttpRequest'},
      credentials:'same-origin',
      body:JSON.stringify(payload)
    }).then(function(r){ return r.json(); }).then(function(data){
      if (data.success) {
        if (hasClassChange) {
          setStudentClassValue(_sid, data.classId || newClassId, data.className || '');
        }
        if (hasYearChange) {
          setStudentYearValue(_sid, data.schoolYearId || newSchoolYearId, data.yearLabel || '', !!data.yearIsCurrent);
        }
        setStudentDisplayId(_sid, data.displayStudentId || buildDisplayStudentId(newStudentIdValue, _sid), data.editableStudentId);
        var singleCarryoverNotice = joinSubjectCarryoverMessages(data);
        modalMsg2.textContent = singleCarryoverNotice
          ? 'Student updated successfully! ' + singleCarryoverNotice
          : 'Student updated successfully!';
        modalMsg2.className='as-modal-msg success';
        setTimeout(closeModal, 900);
      } else {
        var msg = data.error || 'Failed to update.';
        if (data.suggestion) msg += ' Try "' + data.suggestion + '".';
        modalMsg2.textContent=msg; modalMsg2.className='as-modal-msg error';
        if (modalStudentIdInput && data.suggestion) {
          modalStudentIdInput.classList.add('is-error');
          modalStudentIdMsg.classList.add('visible');
        }
        modalSave.disabled=false;
      }
    }).catch(function(){
      modalMsg2.textContent='Network error.'; modalMsg2.className='as-modal-msg error';
      modalSave.disabled=false;
    });
  });
  document.addEventListener('click', function(e){ var b=e.target.closest('.js-edit-class'); if(b) openModal(b); });
  if (modalStudentIdInput) {
