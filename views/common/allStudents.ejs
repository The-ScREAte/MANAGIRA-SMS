  function setBulkStudentIdError(input, message) {
    if (!input) return;
    var row = input.closest('.as-bulk-id-row');
    var errorLabel = row ? row.querySelector('.as-bulk-id-error') : null;
    var hasMessage = !!String(message || '').trim();
    input.classList.toggle('is-error', hasMessage);
    input.dataset.error = hasMessage ? String(message) : '';
    if (errorLabel) {
      errorLabel.textContent = hasMessage ? String(message) : '';
      errorLabel.classList.toggle('visible', hasMessage);
    }
  }

  function validateBulkStudentIdDuplicates() {
    if (!bulkStudentIdList) return;
    var inputs = Array.from(bulkStudentIdList.querySelectorAll('.as-bulk-id-input'));
    var grouped = new Map();
    inputs.forEach(function(input) {
      var value = normalizeNumericStudentIdValue(input.value);
      input.value = value;
      if (!value) return;
      if (!grouped.has(value)) grouped.set(value, []);
      grouped.get(value).push(input);
    });

    inputs.forEach(function(input) {
      if ((input.dataset.error || '').startsWith('Duplicate')) {
        setBulkStudentIdError(input, '');
      }
    });

    grouped.forEach(function(inputGroup) {
      if (inputGroup.length <= 1) return;
      inputGroup.forEach(function(input) {
        setBulkStudentIdError(input, 'Duplicate in new changes');
      });
    });
  }

  function checkBulkStudentIdAgainstOrg(input) {
    if (!input) return;
    var value = normalizeNumericStudentIdValue(input.value);
    input.value = value;
    validateBulkStudentIdDuplicates();

    if (!value) {
      if (!((input.dataset.error || '').startsWith('Duplicate'))) setBulkStudentIdError(input, '');
      return;
    }
    if ((input.dataset.error || '').startsWith('Duplicate')) return;

    var original = normalizeNumericStudentIdValue(input.dataset.original || '');
    if (value === original) {
      setBulkStudentIdError(input, '');
      return;
    }

    var studentId = String(input.dataset.studentId || '');
    if (!studentId) return;
    if (bulkIdTimers.has(studentId)) {
      clearTimeout(bulkIdTimers.get(studentId));
      bulkIdTimers.delete(studentId);
    }

    var timeoutId = setTimeout(function() {
      var token = (bulkIdRequestTokens.get(studentId) || 0) + 1;
      bulkIdRequestTokens.set(studentId, token);
      fetch('/common/check-student-id?id=' + encodeURIComponent(studentIdConfig.prefix + value) + '&num=' + encodeURIComponent(value) + '&exclude=' + encodeURIComponent(studentId))
        .then(function(response) { return response.json(); })
        .then(function(data) {
          if (bulkIdRequestTokens.get(studentId) !== token) return;
          if ((input.dataset.error || '').startsWith('Duplicate')) return;
          if (data && data.taken) {
            setBulkStudentIdError(input, 'Already in this organization');
          } else {
            setBulkStudentIdError(input, '');
          }
        })
        .catch(function() {
          if (bulkIdRequestTokens.get(studentId) !== token) return;
        });
    }, 220);

    bulkIdTimers.set(studentId, timeoutId);
  }

  function applyBulkStudentIdSearchFilter() {
    if (!bulkStudentIdList || !bulkStudentIdSearch) return;
    var query = String(bulkStudentIdSearch.value || '').trim().toLowerCase();
    Array.from(bulkStudentIdList.querySelectorAll('.as-bulk-id-row')).forEach(function(row) {
      var name = String(row.dataset.studentName || '').toLowerCase();
      var show = !query || name.indexOf(query) !== -1;
      row.style.display = show ? 'grid' : 'none';
    });
  }

  function buildBulkStudentIdList() {
    if (!bulkStudentIdList) return;
    var selectedRows = Array.from(selectedIds)
      .map(function(id) {
        var row = document.querySelector('#asTableBody tr[data-id="' + id + '"]');
        if (!row) return null;
        var editBtn = row.querySelector('.js-edit-class');
        return {
          id: String(id),
          name: editBtn ? String(editBtn.dataset.studentName || '').trim() : ('Student #' + id),
          displayId: editBtn ? String(editBtn.dataset.displayId || '') : '',
          editableId: editBtn ? normalizeNumericStudentIdValue(editBtn.dataset.editableId || '') : '',
        };
      })
      .filter(Boolean)
      .sort(function(a, b) { return a.name.localeCompare(b.name); });

    bulkStudentIdList.innerHTML = selectedRows.map(function(studentRow) {
      return '' +
        '<div class="as-bulk-id-row" data-student-id="' + escHtml(studentRow.id) + '" data-student-name="' + escHtml(studentRow.name.toLowerCase()) + '">' +
          '<div class="as-bulk-id-name">' + escHtml(studentRow.name) +
