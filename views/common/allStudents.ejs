      summary.push(
        '<div class="as-change-row"><span class="as-change-label">School year:</span>'+pill(_oldSchoolYearLabel,'from')+'<span style="color:#94a3b8;">→</span>'+pill(newSchoolYearLabel,'year')+'</div>'
      );
