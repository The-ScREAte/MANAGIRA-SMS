<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Set up your school - Managira</title>
  <link rel="icon" href="/favicon.ico" type="image/x-icon" sizes="any" />
  <%
    const _colorHex = (colors.find((c) => c.key === school.color) || colors[0]).hex;
    const _labels = { color: 'Colour', logo: 'Logo', details: 'Details', year: 'School year', calendar: 'Calendar', website: 'Website' };
    const _asks = (field) => missingDetails.includes(field);
    const _initial = (school.shortName || school.name || 'S').trim().charAt(0).toUpperCase();
  %>
  <style>
    /* First-time setup (utils/firstSetup.js): only what the school hasn't set, one step at a
       time, in the school's colour, with a light preview of each choice. */
    :root {
      --brand: <%= _colorHex %>;
      --text: #111827;
      --muted: #4b5563;
      --soft: #6b7280;
      --line: #e5e7eb;
      --field: #d1d5db;
      --card: #ffffff;
      --bg: #f4f6f8;
      --error: #b42318;
      --error-bg: #fef2f2;
      --tint: color-mix(in srgb, var(--brand) 10%, #fff);
    }
    * { box-sizing: border-box; }
    html, body { margin: 0; min-height: 100%; }
    body {
      min-height: 100vh;
      min-height: 100dvh;
      background: var(--bg);
      color: var(--text);
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
      -webkit-font-smoothing: antialiased;
    }
    button, input, select { font: inherit; }
    .fs-top { display: flex; align-items: center; justify-content: space-between; gap: 12px; max-width: 1080px; margin: 0 auto; padding: 18px 20px; }
    .fs-brand { display: inline-flex; align-items: center; gap: 8px; color: #374151; font-size: 0.85rem; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; }
    .fs-brand img { width: 24px; height: 24px; }
    .fs-out { color: var(--muted); font-size: 0.9rem; text-decoration: none; }
    .fs-out:hover { color: var(--text); text-decoration: underline; }

    .fs-wrap { display: grid; grid-template-columns: minmax(0, 1fr) 360px; gap: 28px; max-width: 1080px; margin: 0 auto; padding: 4px 20px 48px; align-items: start; }
    .fs-card { padding: 30px 32px 26px; border: 1px solid var(--line); border-radius: 20px; background: var(--card); box-shadow: 0 1px 2px rgba(16, 24, 40, 0.04), 0 12px 32px rgba(16, 24, 40, 0.06); }

    .fs-progress { display: flex; gap: 6px; margin-bottom: 10px; }
    .fs-progress span { flex: 1; height: 5px; border-radius: 999px; background: #e5e7eb; transition: background 0.2s ease; }
    .fs-progress span.is-done, .fs-progress span.is-now { background: var(--brand); }
    .fs-progress span.is-now { opacity: 0.55; }
    .fs-meta { display: flex; align-items: baseline; justify-content: space-between; gap: 12px; margin-bottom: 22px; }
    .fs-count { margin: 0; color: var(--soft); font-size: 0.85rem; font-weight: 600; }
    /* Saving in the background: a quiet word, never a wait. */
    .fs-save { display: inline-flex; align-items: center; gap: 6px; color: var(--soft); font-size: 0.8rem; white-space: nowrap; }
    .fs-save:empty { display: none; }
    .fs-save::before { content: ""; width: 7px; height: 7px; border-radius: 50%; background: #22c55e; }
    .fs-save.is-busy::before { background: var(--brand); animation: fs-pulse 1s ease-in-out infinite; }
    @keyframes fs-pulse { 50% { opacity: .3; } }

    .fs-step[hidden] { display: none; }
    .fs-step h1 { margin: 0 0 6px; font-size: 1.6rem; font-weight: 700; letter-spacing: -0.02em; line-height: 1.25; }
    .fs-step h1:focus { outline: none; }
    .fs-lead { margin: 0 0 24px; color: var(--muted); font-size: 0.98rem; line-height: 1.55; }
    .fs-sr { position: absolute; left: -9999px; }

    /* Colour */
    .fs-colors { display: grid; grid-template-columns: repeat(auto-fill, minmax(78px, 1fr)); gap: 8px; margin: 0; padding: 0; border: 0; }
    .fs-color { position: relative; display: flex; flex-direction: column; align-items: center; gap: 5px; padding: 9px 4px 8px; border: 1px solid var(--line); border-radius: 12px; cursor: pointer; transition: border-color 0.15s ease, box-shadow 0.15s ease; }
    .fs-color input { position: absolute; opacity: 0; pointer-events: none; }
    .fs-color i { display: grid; place-items: center; width: 26px; height: 26px; border-radius: 50%; background: var(--c); box-shadow: inset 0 0 0 1px rgba(0, 0, 0, 0.08); }
    .fs-color i svg { width: 13px; height: 13px; color: #fff; opacity: 0; }
    .fs-color span { color: var(--muted); font-size: 0.72rem; text-align: center; line-height: 1.2; }
    .fs-color:hover { border-color: #c7cdd4; }
    .fs-color:has(input:checked) { border-color: var(--c); box-shadow: 0 0 0 2px color-mix(in srgb, var(--c) 25%, transparent); }
    .fs-color:has(input:checked) i svg { opacity: 1; }
    .fs-color:has(input:checked) span { color: var(--text); font-weight: 600; }
    .fs-color:has(input:focus-visible) { outline: 3px solid color-mix(in srgb, var(--c) 35%, transparent); outline-offset: 2px; }

    /* Logo */
    .fs-drop { position: relative; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 10px; min-height: 210px; padding: 24px; border: 2px dashed var(--field); border-radius: 16px; background: #fafbfc; color: var(--muted); text-align: center; cursor: pointer; transition: border-color 0.15s ease, background 0.15s ease; }
    .fs-drop:hover, .fs-drop.is-over { border-color: var(--brand); background: color-mix(in srgb, var(--brand) 5%, #fff); }
    .fs-drop:focus-within { outline: 3px solid color-mix(in srgb, var(--brand) 30%, transparent); outline-offset: 2px; }
    .fs-drop svg { width: 32px; height: 32px; color: var(--brand); }
    .fs-drop strong { color: var(--text); }
    .fs-drop small { color: var(--soft); }
    .fs-drop img { max-width: 160px; max-height: 120px; object-fit: contain; }
    .fs-drop input { position: absolute; width: 1px; height: 1px; opacity: 0; }

    /* Fields */
    .fs-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
    .fs-field { display: flex; flex-direction: column; gap: 6px; }
    .fs-field.wide { grid-column: 1 / -1; }
    .fs-field label { color: var(--muted); font-size: 0.875rem; font-weight: 600; }
    .fs-field label em { color: var(--soft); font-style: normal; font-weight: 400; }
    .fs-field input, .fs-field select { width: 100%; height: 46px; padding: 0 13px; border: 1px solid var(--field); border-radius: 10px; background: #fff; color: var(--text); font-size: 1rem; }
    .fs-field input:focus, .fs-field select:focus { border-color: var(--brand); outline: 3px solid color-mix(in srgb, var(--brand) 20%, transparent); }
    .fs-hint { margin: 0; color: var(--soft); font-size: 0.82rem; }

    /* School year */
    .fs-choices { display: grid; grid-template-columns: repeat(4, 1fr); gap: 8px; margin: 0; padding: 0; border: 0; }
    .fs-choice { position: relative; display: flex; flex-direction: column; gap: 2px; padding: 12px; border: 1px solid var(--line); border-radius: 12px; cursor: pointer; }
    .fs-choice input { position: absolute; opacity: 0; pointer-events: none; }
    .fs-choice strong { font-size: 0.95rem; }
    .fs-choice span { color: var(--soft); font-size: 0.8rem; }
    .fs-choice:has(input:checked) { border-color: var(--brand); box-shadow: 0 0 0 2px color-mix(in srgb, var(--brand) 20%, transparent); }
    .fs-choice:has(input:focus-visible) { outline: 3px solid color-mix(in srgb, var(--brand) 30%, transparent); outline-offset: 2px; }
    .fs-label { margin: 22px 0 10px; color: var(--muted); font-size: 0.875rem; font-weight: 600; }
    .fs-label em { color: var(--soft); font-style: normal; font-weight: 400; }
    .fs-terms { margin: 0; padding: 0; list-style: none; border: 1px solid var(--line); border-radius: 12px; overflow: hidden; }
    .fs-terms li + li { border-top: 1px solid var(--line); }
    .fs-term { position: relative; display: flex; align-items: center; gap: 12px; padding: 12px 14px; cursor: pointer; }
    .fs-term:hover { background: #fafbfc; }
    .fs-term input { flex: none; width: 18px; height: 18px; margin: 0; accent-color: var(--brand); }
    .fs-term b { flex: 1; font-size: 0.93rem; font-weight: 600; }
    .fs-term b small { display: block; color: var(--soft); font-size: 0.78rem; font-weight: 400; }
    .fs-term span { color: var(--soft); font-size: 0.86rem; white-space: nowrap; }
    .fs-term em { padding: 2px 8px; border-radius: 999px; background: var(--tint); color: var(--brand); font-size: 0.72rem; font-style: normal; font-weight: 700; visibility: hidden; }
    .fs-term:has(input:checked) { background: color-mix(in srgb, var(--brand) 5%, #fff); }
    .fs-term:has(input:checked) em { visibility: visible; }
    .fs-terms .fs-term-empty { padding: 12px 14px; color: var(--soft); font-size: 0.9rem; }

    /* Calendar */
    .fs-days { display: grid; grid-template-columns: repeat(7, 1fr); gap: 6px; }
    .fs-day { position: relative; cursor: pointer; }
    .fs-day input { position: absolute; opacity: 0; pointer-events: none; }
    .fs-day span { display: grid; place-items: center; height: 44px; border: 1px solid var(--line); border-radius: 10px; color: var(--muted); font-size: 0.9rem; font-weight: 600; }
    .fs-day input:checked + span { border-color: var(--brand); background: var(--brand); color: #fff; }
    .fs-day input:focus-visible + span { outline: 3px solid color-mix(in srgb, var(--brand) 30%, transparent); outline-offset: 2px; }
    .fs-switch { position: relative; display: flex; align-items: flex-start; gap: 12px; margin-top: 22px; cursor: pointer; }
    .fs-switch input { position: absolute; opacity: 0; pointer-events: none; }
    .fs-switch-ui { flex: none; position: relative; width: 32px; height: 18px; margin-top: 2px; border-radius: 999px; background: #d1d5db; transition: background 0.15s ease; }
    .fs-switch-ui::after { content: ""; position: absolute; top: 2px; left: 2px; width: 14px; height: 14px; border-radius: 50%; background: #fff; box-shadow: 0 1px 2px rgba(0, 0, 0, 0.2); transition: transform 0.15s ease; }
    .fs-switch input:checked + .fs-switch-ui { background: var(--brand); }
    .fs-switch input:checked + .fs-switch-ui::after { transform: translateX(14px); }
    .fs-switch input:focus-visible + .fs-switch-ui { outline: 3px solid color-mix(in srgb, var(--brand) 30%, transparent); outline-offset: 2px; }
    .fs-switch strong { display: block; font-size: 0.95rem; }
    .fs-switch small { display: block; margin-top: 2px; color: var(--soft); font-size: 0.84rem; }
    .fs-holidays { max-height: 180px; overflow: auto; margin: 10px 0 0 52px; padding: 0; list-style: none; border: 1px solid var(--line); border-radius: 10px; }
    .fs-holidays[hidden] { display: none; }
    .fs-holidays li { display: flex; justify-content: space-between; gap: 10px; padding: 7px 12px; font-size: 0.86rem; }
    .fs-holidays li + li { border-top: 1px solid var(--line); }
    .fs-holidays li span { color: var(--soft); white-space: nowrap; }
    .fs-daysoff { display: grid; gap: 8px; }
    .fs-dayoff { display: grid; grid-template-columns: 170px minmax(0, 1fr) 36px; gap: 8px; }
    .fs-dayoff input { height: 42px; padding: 0 11px; border: 1px solid var(--field); border-radius: 10px; color: var(--text); }
    .fs-dayoff input:focus { border-color: var(--brand); outline: 3px solid color-mix(in srgb, var(--brand) 20%, transparent); }
    .fs-dayoff button { border: 0; border-radius: 10px; background: transparent; color: var(--soft); font-size: 1.2rem; cursor: pointer; }
    .fs-dayoff button:hover { background: #f3f4f6; color: var(--text); }
    .fs-add { margin-top: 8px; padding: 8px 0; border: 0; background: none; color: var(--brand); font-size: 0.92rem; font-weight: 600; cursor: pointer; }
    .fs-add:hover { text-decoration: underline; }

    /* Website: each design with a small sketch of how it looks */
    .fs-designs { display: grid; grid-template-columns: repeat(auto-fill, minmax(170px, 1fr)); gap: 12px; margin: 0; padding: 0; border: 0; }
    .fs-design { position: relative; display: flex; flex-direction: column; gap: 8px; padding: 8px 8px 12px; border: 1px solid var(--line); border-radius: 14px; cursor: pointer; transition: border-color 0.15s ease, box-shadow 0.15s ease; }
    .fs-design input { position: absolute; opacity: 0; pointer-events: none; }
    .fs-design-thumb { display: block; overflow: hidden; border-radius: 9px; background: #f8fafc; border: 1px solid #eef0f3; aspect-ratio: 16 / 10; }
    .fs-design-thumb svg { display: block; width: 100%; height: 100%; }
    .fs-design strong { display: flex; align-items: center; gap: 6px; padding: 0 4px; font-size: 0.95rem; }
    .fs-design strong small { padding: 1px 7px; border-radius: 999px; background: #f3f4f6; color: var(--muted); font-size: 0.68rem; font-weight: 600; }
    .fs-design > span:last-child { padding: 0 4px; color: var(--soft); font-size: 0.8rem; line-height: 1.4; }
    .fs-design:hover { border-color: #c7cdd4; }
    .fs-design:has(input:checked) { border-color: var(--brand); box-shadow: 0 0 0 2px color-mix(in srgb, var(--brand) 20%, transparent); }
    .fs-design:has(input:focus-visible) { outline: 3px solid color-mix(in srgb, var(--brand) 30%, transparent); outline-offset: 2px; }

    /* Actions */
    .fs-error { margin: 18px 0 0; padding: 10px 12px; border-radius: 10px; background: var(--error-bg); color: var(--error); font-size: 0.9rem; }
    .fs-error[hidden] { display: none; }
    .fs-actions { display: flex; align-items: center; gap: 10px; margin-top: 26px; }
    .fs-actions[hidden] { display: none; }
    .fs-actions .fs-spacer { flex: 1; }
    .fs-btn { display: inline-flex; align-items: center; justify-content: center; height: 46px; padding: 0 22px; border: 0; border-radius: 10px; background: var(--brand); color: #fff; font-size: 1rem; font-weight: 700; text-decoration: none; cursor: pointer; transition: filter 0.15s ease; }
    .fs-btn:hover { filter: brightness(0.93); }
    .fs-btn[disabled] { opacity: 0.6; cursor: wait; }
    .fs-btn:focus-visible, .fs-link:focus-visible { outline: 3px solid color-mix(in srgb, var(--brand) 35%, transparent); outline-offset: 2px; }
    .fs-link { padding: 0 6px; border: 0; background: none; color: var(--muted); font-size: 0.95rem; font-weight: 600; cursor: pointer; }
    .fs-link:hover { color: var(--text); text-decoration: underline; }
    .fs-link[hidden], .fs-btn[hidden] { display: none; }

    /* Done */
    .fs-done { text-align: center; padding: 18px 0 6px; }
    .fs-done-mark { display: grid; place-items: center; width: 64px; height: 64px; margin: 0 auto 16px; border-radius: 50%; background: var(--tint); color: var(--brand); }
    .fs-done-mark svg { width: 30px; height: 30px; }
    .fs-summary { max-width: 380px; margin: 6px auto 24px; padding: 0; list-style: none; text-align: left; }
    .fs-summary li { display: flex; align-items: flex-start; gap: 10px; padding: 7px 0; color: var(--muted); font-size: 0.95rem; line-height: 1.4; }
    .fs-summary li svg { flex: none; width: 18px; height: 18px; margin-top: 1px; color: var(--brand); }
    .fs-summary li.is-skipped { color: var(--soft); }
    .fs-summary li.is-skipped svg { color: #c4c9d0; }

    /* Preview: one light picture of the step's choice */
    .fs-preview { position: sticky; top: 20px; }
    .fs-preview-label { margin: 0 0 10px; color: var(--soft); font-size: 0.78rem; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; }
    .fs-pv { overflow: hidden; border: 1px solid var(--line); border-radius: 16px; background: #fff; box-shadow: 0 12px 32px rgba(16, 24, 40, 0.07); }
    .fs-pv[hidden] { display: none; }
    .fs-pv-bar { display: flex; align-items: center; gap: 10px; padding: 14px 16px; background: var(--brand); color: #fff; transition: background 0.2s ease; }
    .fs-pv-logo { display: grid; place-items: center; flex: none; width: 34px; height: 34px; overflow: hidden; border-radius: 9px; background: rgba(255, 255, 255, 0.95); color: var(--brand); font-weight: 800; }
    .fs-pv-logo img { width: 100%; height: 100%; object-fit: contain; }
    .fs-pv-name { min-width: 0; overflow: hidden; font-weight: 700; text-overflow: ellipsis; white-space: nowrap; }
    .fs-pv-body { display: grid; gap: 10px; padding: 16px; }
    .fs-pv-row { height: 9px; border-radius: 999px; background: #eef0f3; }
    .fs-pv-row.short { width: 58%; }
    .fs-pv-tiles { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }
    .fs-pv-tiles div { padding: 10px; border: 1px solid var(--line); border-radius: 10px; }
    .fs-pv-tiles b { display: block; color: var(--brand); font-size: 1.05rem; }
    .fs-pv-tiles span { color: var(--soft); font-size: 0.72rem; }
    .fs-pv-btn { justify-self: start; padding: 7px 13px; border-radius: 8px; background: var(--brand); color: #fff; font-size: 0.78rem; font-weight: 700; }
    /* Details: a report card's heading */
    .fs-pv-doc { padding: 18px; }
    .fs-pv-doc-head { display: flex; align-items: center; gap: 12px; padding-bottom: 12px; border-bottom: 2px solid var(--brand); }
    .fs-pv-doc-head .fs-pv-logo { background: var(--tint); }
    .fs-pv-doc-head b { display: block; font-size: 0.98rem; }
    .fs-pv-doc-head small { display: block; color: var(--soft); font-size: 0.76rem; line-height: 1.45; }
    .fs-pv-doc-title { margin: 12px 0 10px; color: var(--brand); font-size: 0.72rem; font-weight: 800; letter-spacing: 0.08em; text-transform: uppercase; }
    /* School year: the term bar */
    .fs-pv-year { padding: 16px; }
    .fs-pv-year small { color: var(--soft); font-size: 0.72rem; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; }
    .fs-pv-year b { display: block; margin: 2px 0 10px; font-size: 1.05rem; }
    .fs-pv-track { height: 8px; border-radius: 999px; background: #eef0f3; overflow: hidden; }
    .fs-pv-track i { display: block; height: 100%; width: 0; border-radius: inherit; background: var(--brand); transition: width 0.3s ease; }
    .fs-pv-dates { display: flex; justify-content: space-between; margin-top: 6px; color: var(--soft); font-size: 0.74rem; }
    /* Calendar: one week */
    .fs-pv-week { display: grid; grid-template-columns: repeat(7, 1fr); gap: 5px; padding: 16px 16px 10px; }
    .fs-pv-week span { display: grid; place-items: center; height: 38px; border-radius: 8px; background: #f3f4f6; color: var(--soft); font-size: 0.72rem; font-weight: 700; }
    .fs-pv-week span.on { background: var(--tint); color: var(--brand); }
    .fs-pv-cal-note { margin: 0; padding: 0 16px 16px; color: var(--muted); font-size: 0.82rem; }
    /* Website: the chosen design */
    .fs-pv-site svg { display: block; width: 100%; height: auto; }
    .fs-preview-note { margin: 12px 2px 0; color: var(--soft); font-size: 0.82rem; line-height: 1.5; }

    /* Phones and tablets: the step first, its preview under it (a small one). */
    @media (max-width: 920px) {
      .fs-wrap { grid-template-columns: 1fr; }
      .fs-preview { position: static; max-width: 420px; }
      .fs-pv-body, .fs-preview-note { display: none; }
    }
    @media (max-width: 560px) {
      .fs-colors { grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 6px; }
      .fs-color { padding: 8px 2px 7px; }
      .fs-color span { font-size: 0.66rem; }
      .fs-top { padding: 14px 16px; }
      .fs-wrap { padding: 0 16px 32px; gap: 14px; }
      .fs-card { padding: 22px 18px 20px; border-radius: 16px; }
      .fs-step h1 { font-size: 1.35rem; }
      .fs-grid { grid-template-columns: 1fr; }
      .fs-choices { grid-template-columns: 1fr 1fr; }
      .fs-actions { flex-wrap: wrap; }
      .fs-days { grid-template-columns: repeat(4, 1fr); }
      .fs-dayoff { grid-template-columns: 1fr 36px; }
      .fs-dayoff input[type="text"] { grid-column: 1 / -1; grid-row: 2; }
      .fs-holidays { margin-left: 0; }
      .fs-designs { grid-template-columns: 1fr 1fr; }
      .fs-term span { display: none; }
    }
    @media (prefers-reduced-motion: reduce) { * { transition: none !important; } }
  </style>
</head>
<body>
  <header class="fs-top">
    <span class="fs-brand"><img src="/images/managira-logo-sm.png" alt="" />Managira</span>
    <a class="fs-out" href="/account/logout">Log out</a>
  </header>

  <div class="fs-wrap">
    <main class="fs-card" aria-labelledby="fsCount">
      <div class="fs-progress" aria-hidden="true">
        <% steps.forEach(() => { %><span></span><% }) %>
      </div>
      <div class="fs-meta">
        <p class="fs-count" id="fsCount" aria-live="polite"></p>
        <span class="fs-save" id="fsSaveState" aria-live="polite"></span>
      </div>

      <% if (steps.includes('color')) { %>
      <section class="fs-step" data-step="color" hidden>
        <h1>Welcome! Pick your school's colour</h1>
        <p class="fs-lead">A few quick basics so Managira feels like your school. Your colour is used for buttons, headers and your website.</p>
        <fieldset class="fs-colors">
          <legend class="fs-sr">School colour</legend>
          <% colors.forEach((c) => { %>
            <label class="fs-color" style="--c: <%= c.hex %>">
              <input type="radio" name="color" value="<%= c.key %>" data-hex="<%= c.hex %>"<%= c.key === school.color ? ' checked' : '' %> />
              <i><svg viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3.5 8.5l3 3 6-7" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg></i>
              <span><%= c.name %></span>
            </label>
          <% }) %>
        </fieldset>
      </section>
      <% } %>

      <% if (steps.includes('logo')) { %>
      <section class="fs-step" data-step="logo" hidden>
        <h1>Add your logo</h1>
        <p class="fs-lead">It shows in the header, on report cards and on your website. A square picture with a clear background looks best.</p>
        <label class="fs-drop" id="fsDrop">
          <input type="file" id="fsLogo" accept="image/png,image/jpeg,image/webp,image/gif" />
          <span id="fsDropBody">
            <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 16V4M7 9l5-5 5 5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/><path d="M4 15v3a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-3" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
            <br /><strong>Choose a picture</strong> or drop it here<br /><small>PNG, JPG, WebP or GIF, up to 5 MB</small>
          </span>
        </label>
      </section>
      <% } %>

      <% if (steps.includes('details')) { %>
      <section class="fs-step" data-step="details" hidden>
        <h1>A few details about your school</h1>
        <p class="fs-lead">Just what we don't have yet. These appear on report cards, emails to families and your website.</p>
        <form class="fs-grid" id="fsDetails" novalidate>
          <% if (_asks('shortName')) { %>
          <div class="fs-field wide">
            <label for="fsShort">School nickname <em>(optional)</em></label>
            <input id="fsShort" name="shortName" value="<%= school.shortName %>" minlength="3" maxlength="60" placeholder="e.g. Lincoln High" autocomplete="off" aria-describedby="fsShortHint" />
            <p class="fs-hint" id="fsShortHint">The short name shown for your school, 3 to 60 characters. Leave it empty to use <%= school.name %>. You can change it in Settings.</p>
          </div>
          <% } %>
          <% if (_asks('phone')) { %>
          <div class="fs-field">
            <label for="fsPhone">Phone <em>(optional)</em></label>
            <input id="fsPhone" name="phone" type="tel" value="<%= school.phone %>" maxlength="30" autocomplete="tel" />
          </div>
          <% } %>
          <% if (_asks('state')) { %>
          <div class="fs-field">
            <label for="fsState">State <em>(optional)</em></label>
            <input id="fsState" name="state" value="<%= school.state %>" maxlength="100" list="fsStates" autocomplete="address-level1" />
            <datalist id="fsStates"><% usStates.forEach((s) => { %><option value="<%= s %>"></option><% }) %></datalist>
          </div>
          <% } %>
          <% if (_asks('address')) { %>
          <div class="fs-field wide">
            <label for="fsAddress">Street address <em>(optional)</em></label>
            <input id="fsAddress" name="address" value="<%= school.address %>" maxlength="250" autocomplete="street-address" />
          </div>
          <% } %>
          <% if (_asks('country')) { %>
          <div class="fs-field">
            <label for="fsCountry">Country</label>
            <select id="fsCountry" name="country" autocomplete="country">
              <% countries.forEach((c) => { %><option value="<%= c.code %>"<%= c.code === school.country ? ' selected' : '' %>><%= c.name %></option><% }) %>
            </select>
          </div>
          <% } %>
        </form>
      </section>
      <% } %>

      <% if (steps.includes('year') && yearMode === 'create') { %>
      <section class="fs-step" data-step="year" data-mode="create" hidden>
        <h1>Set up your school year</h1>
        <p class="fs-lead">Attendance, grades and report cards are kept by term. You can rename terms or change dates later in School years &amp; terms.</p>
        <div class="fs-grid">
          <div class="fs-field wide">
            <label for="fsYearLabel">School year</label>
            <input id="fsYearLabel" value="<%= year.label %>" maxlength="9" placeholder="2026-2027" inputmode="numeric" />
          </div>
          <div class="fs-field">
            <label for="fsYearStart">First day</label>
            <input id="fsYearStart" type="date" value="<%= year.start %>" />
          </div>
          <div class="fs-field">
            <label for="fsYearEnd">Last day</label>
            <input id="fsYearEnd" type="date" value="<%= year.end %>" />
          </div>
        </div>
        <p class="fs-label">How is the year divided?</p>
        <fieldset class="fs-choices">
          <legend class="fs-sr">How the year is divided</legend>
          <% const _structureText = { semesters: ['Semesters', '2 terms'], trimesters: ['Trimesters', '3 terms'], quarters: ['Quarters', '4 terms'], year: ['Full year', '1 term'] }; %>
          <% structures.forEach((s, i) => { %>
            <label class="fs-choice">
              <input type="radio" name="structure" value="<%= s.key %>"<%= i === 0 ? ' checked' : '' %> />
              <strong><%= _structureText[s.key][0] %></strong><span><%= _structureText[s.key][1] %></span>
            </label>
          <% }) %>
        </fieldset>
        <p class="fs-label" id="fsTermsLabel">Which term are you in now?</p>
        <ul class="fs-terms" id="fsTerms" role="radiogroup" aria-labelledby="fsTermsLabel"></ul>
      </section>
      <% } %>

      <% if (steps.includes('year') && yearMode === 'current') { %>
      <section class="fs-step" data-step="year" data-mode="current" hidden>
        <h1>Which term are you in now?</h1>
        <p class="fs-lead">Your school has terms but none is set as current. Attendance, grades and the dashboard follow the current term.</p>
        <ul class="fs-terms" role="radiogroup" aria-label="Current term">
          <% termsToChoose.forEach((t, i) => { %>
            <li><label class="fs-term">
              <input type="radio" name="currentTermId" value="<%= t.term_id %>" data-name="<%= t.term_name %>" data-year="<%= t.year_label %>" data-start="<%= t.start || '' %>" data-end="<%= t.end || '' %>"<%= i === 0 ? ' checked' : '' %> />
              <b><%= t.term_name %><small><%= t.year_label %></small></b>
              <% if (t.start && t.end) { %><span data-range="<%= t.start %>|<%= t.end %>"></span><% } %>
              <em>Current</em>
            </label></li>
          <% }) %>
        </ul>
      </section>
      <% } %>

      <% if (steps.includes('calendar')) { %>
      <section class="fs-step" data-step="calendar" hidden>
        <h1>Set your school calendar</h1>
        <p class="fs-lead">Attendance is only taken on school days, and days off don't count against anyone. You can add more days off any time in Settings › School rules.</p>
        <p class="fs-label" id="fsDaysLabel">School days</p>
        <div class="fs-days" role="group" aria-labelledby="fsDaysLabel">
          <% [['1','Mon'],['2','Tue'],['3','Wed'],['4','Thu'],['5','Fri'],['6','Sat'],['0','Sun']].forEach(([value, label]) => { %>
            <label class="fs-day"><input type="checkbox" name="schoolDay" value="<%= value %>"<%= ['1','2','3','4','5'].includes(value) ? ' checked' : '' %> /><span><%= label %></span></label>
          <% }) %>
        </div>
        <label class="fs-switch">
          <input type="checkbox" id="fsHolidays" checked />
          <span class="fs-switch-ui" aria-hidden="true"></span>
          <span><strong>Public holidays are days off</strong><small id="fsHolidaysNote">Loading this year's holidays…</small></span>
        </label>
        <ul class="fs-holidays" id="fsHolidayList" hidden></ul>
        <p class="fs-label">Other days off <em>(breaks, teacher work days; optional)</em></p>
        <div id="fsDaysOff" class="fs-daysoff"></div>
        <button type="button" class="fs-add" id="fsAddDayOff">+ Add a day off</button>
      </section>
      <% } %>

      <% if (steps.includes('website')) { %>
      <section class="fs-step" data-step="website" hidden>
        <h1>Choose your website's look</h1>
        <p class="fs-lead">Your school gets a public website in your colour. Pick the look you like; every design shows the same content, and you can change it any time in Website settings.</p>
        <fieldset class="fs-designs">
          <legend class="fs-sr">Website design</legend>
          <% layouts.forEach((l) => { %>
            <label class="fs-design">
              <input type="radio" name="layout" value="<%= l.value %>" data-base="<%= l.base %>" data-key="<%= l.key %>" data-name="<%= l.name %>"<%= l.value === school.layout ? ' checked' : '' %> />
              <span class="fs-design-thumb" data-thumb="<%= l.key %>" aria-hidden="true"></span>
              <strong><%= l.name %><% if (l.style) { %><small><%= l.style %></small><% } %></strong>
              <span><%= l.description %></span>
            </label>
          <% }) %>
        </fieldset>
      </section>
      <% } %>

      <section class="fs-step" data-step="done" hidden>
        <div class="fs-done">
          <div class="fs-done-mark"><svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg></div>
          <h1>You're ready to go</h1>
          <p class="fs-lead">You've set up the basics. Next, the setup steps on your dashboard help you add classes, students and staff.</p>
          <ul class="fs-summary" id="fsSummary"></ul>
          <a class="fs-btn" id="fsGo" href="/common/orgDashboard">Go to your dashboard</a>
        </div>
      </section>

      <p class="fs-error" id="fsError" role="alert" hidden></p>
      <div class="fs-actions" id="fsActions">
        <button type="button" class="fs-link" id="fsBack" hidden>Back</button>
        <span class="fs-spacer"></span>
        <button type="button" class="fs-link" id="fsSkip" hidden>Skip for now</button>
        <button type="button" class="fs-btn" id="fsNext">Continue</button>
      </div>
    </main>

    <aside class="fs-preview" aria-label="Preview">
      <p class="fs-preview-label">Preview</p>

      <div class="fs-pv" data-pv="app" aria-hidden="true">
        <div class="fs-pv-bar">
          <span class="fs-pv-logo" data-pv-logo><% if (school.logo) { %><img src="<%= school.logo %>" alt="" /><% } else { %><%= _initial %><% } %></span>
          <span class="fs-pv-name" data-pv-name><%= school.shortName || school.name || 'Your school' %></span>
        </div>
        <div class="fs-pv-body">
          <div class="fs-pv-row"></div>
          <div class="fs-pv-row short"></div>
          <div class="fs-pv-tiles"><div><b>412</b><span>Students</span></div><div><b>96%</b><span>Attendance</span></div></div>
          <span class="fs-pv-btn">Take attendance</span>
        </div>
      </div>

      <div class="fs-pv fs-pv-doc" data-pv="doc" aria-hidden="true" hidden>
        <div class="fs-pv-doc-head">
          <span class="fs-pv-logo" data-pv-logo><% if (school.logo) { %><img src="<%= school.logo %>" alt="" /><% } else { %><%= _initial %><% } %></span>
          <span><b><%= school.name %></b><small id="fsPvAddress"></small><small id="fsPvPhone"></small></span>
        </div>
        <p class="fs-pv-doc-title">Report card</p>
        <div class="fs-pv-body" style="padding:0"><div class="fs-pv-row"></div><div class="fs-pv-row short"></div><div class="fs-pv-row"></div></div>
      </div>

      <div class="fs-pv fs-pv-year" data-pv="year" aria-hidden="true" hidden>
        <small id="fsPvYearLabel">School year</small>
        <b id="fsPvTerm">Current term</b>
        <div class="fs-pv-track"><i id="fsPvTrack"></i></div>
        <div class="fs-pv-dates"><span id="fsPvStart"></span><span id="fsPvEnd"></span></div>
      </div>

      <div class="fs-pv" data-pv="calendar" aria-hidden="true" hidden>
        <div class="fs-pv-week" id="fsPvWeek">
          <span data-d="1">Mon</span><span data-d="2">Tue</span><span data-d="3">Wed</span><span data-d="4">Thu</span><span data-d="5">Fri</span><span data-d="6">Sat</span><span data-d="0">Sun</span>
        </div>
        <p class="fs-pv-cal-note" id="fsPvCalNote">School days are coloured.</p>
      </div>

      <div class="fs-pv fs-pv-site" data-pv="website" aria-hidden="true" hidden></div>

      <p class="fs-preview-note" id="fsPreviewNote">This is how your colour and logo look to your staff. Families and visitors see them too.</p>
    </aside>
  </div>

  <script>
    window.FIRST_SETUP = <%- JSON.stringify({ steps, labels: _labels, hasTerms, yearMode, school: { name: school.name, shortName: school.shortName, phone: school.phone, address: school.address, state: school.state, logo: school.logo } }) %>;
  </script>
  <script src="<%= typeof assetUrl === 'function' ? assetUrl('/js/logoutConfirm.js') : '/js/logoutConfirm.js' %>"></script>
  <script src="<%= typeof assetUrl === 'function' ? assetUrl('/js/termPlanner.js') : '/js/termPlanner.js' %>" defer></script>
  <script src="<%= typeof assetUrl === 'function' ? assetUrl('/js/firstSetup.js') : '/js/firstSetup.js' %>" defer></script>
</body>
</html>
