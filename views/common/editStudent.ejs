<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit Student</title>
    <style>
      :root {
        --font-family: "<%= (session && session.fontStyle ? String(session.fontStyle).trim() : 'Inter') %>", sans-serif;
      }


    body {
        font-family: var(--font-family);
      }
      
</style>
    <style>
      
        main {
            max-width: 900px;
            margin: 0 auto;
            padding: 20px;
            border-radius: 10px;
            box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);
        }
        h1 {
            text-align: center;
        }
        .form-group {
            margin-bottom: 20px;
        }
        label {
            display: block;
            margin-bottom: 8px;
            font-weight: bold;
        }
        input, select, textarea {
            width: 100%;
            padding: 8px;
            margin-bottom: 10px;
            border: 1px solid #ccc;
            border-radius: 5px;
        }
        .checkbox-group label {
            display: block;
            margin-bottom: 8px;
        }
        .guardian-section {
            margin-bottom: 20px;
            padding: 15px;
            border: 1px solid #ddd;
            border-radius: 5px;
            background-color: #f9f9f9;
        }
        .form-actions {
            text-align: center;
            margin-bottom: 15px;
        }
        
        /* Use unified button system - these override defaults */
        .update-button {
            background-color: var(--btn-primary-bg, #01535b);
            color: var(--btn-primary-text, #fff);
            border-color: var(--btn-primary-bg, #01535b);
        }
        .update-button:hover {
            background-color: var(--btn-primary-bg-hover, #013a40);
        }
        .delete-button {
            display: inline-block;
            width: 100%;
            background-color: var(--btn-danger-bg, #dc3545);
            color: var(--btn-danger-text, #fff);
            text-align: center;
            text-decoration: none;
            border-color: var(--btn-danger-bg, #dc3545);
        }
        .delete-button:hover {
            background-color: var(--btn-danger-bg-hover, #b21f2d);
        }
        .checkbox-group {
            display: flex;
            flex-wrap: wrap;
            gap: 15px;
        }
        .checkbox-group label {
            display: flex;
            align-items: center;
            gap: 10px; /* Spacing between checkbox and label text */
            margin-bottom: 8px;
            font-size: 16px;
        }
        .checkbox-group input[type="checkbox"] {
            margin: 0;
            width: 20px;
            height: 20px;
        }
    </style>
    <script>
        function confirmUpdate(event) {
            // Show confirmation dialog
            const confirmMessage = "Are you sure you want to update this student? Please double-check all details before proceeding.";
            if (!confirm(confirmMessage)) {
                event.preventDefault(); // Prevent the form submission if user cancels
            }
        }

        function confirmDelete(message) {
            return confirm(message);
        }

        function addGuardian() {
            const container = document.getElementById("guardiansContainer");
            const count = container.children.length;
        
            const html = `
              <div class="guardian">
                <label>Guardian ${count + 1} First Name:</label>
                <input type="text" name="guardians[${count}][firstName]" />
                <label>Last Name:</label>
                <input type="text" name="guardians[${count}][lastName]" />
                <label>Address:</label>
                <input type="text" name="guardians[${count}][address]" />
                <label>Phone:</label>
                <input type="text" name="guardians[${count}][phone]" />
                <label>Email:</label>
                <input type="email" name="guardians[${count}][email]" />
                <label>Hometown:</label>
                <input type="text" name="guardians[${count}][hometown]" />
              </div>
            `;
            const g = document.createElement("div");
            g.innerHTML = html;
            container.appendChild(g);
          }
    </script>
</head>
<main>
    <br>
    <div class="link-to-next-back">
        <a href="/common/studentDetails?studentId=<%= student.student_id %>&termId=<%= currentTerm ? currentTerm.term_id : '' %>" 
            class="btn btn-primary">Back</a>
             </div>
    <hr>    
    
    <h1>Edit Student</h1>

    <form action="/common/editStudent/<%= student.student_id %>" method="POST" enctype="multipart/form-data" onsubmit="confirmUpdate(event)">
        <!-- Student Fields -->
        <div class="form-group">
            <label for="firstName">First Name:</label>
            <input type="text" name="firstName" id="firstName" value="<%= student.first_name %>" required>
        </div>
        <div class="form-group">
            <label for="lastName">Last Name:</label>
            <input type="text" name="lastName" id="lastName" value="<%= student.last_name %>" required>
        </div>
        <div class="form-group">
            <label for="dateOfBirth">Date of Birth:</label>
            <input type="date" name="dateOfBirth" id="dateOfBirth" value="<%= student.date_of_birth.toISOString().slice(0, 10) %>" required>
        </div>

        <div class="form-group">
            <label for="hometown">Hometown:</label>
            <input type="text" name="hometown" id="hometown" value="<%= student.hometown %>">
        </div>
        <div class="form-group">
            <label for="gender">Gender:</label>
            <select name="gender" id="gender" required>
                <option value="Male" <%= student.gender === 'Male' ? 'selected' : '' %>>Male</option>
                <option value="Female" <%= student.gender === 'Female' ? 'selected' : '' %>>Female</option>
            </select>
        </div>

        <div class="form-group">
            <label for="graduationYearGroup">Graduation Year Group:</label>
            <select name="graduationYearGroupId" id="graduationYearGroup" required>
                <% graduationYearGroups.forEach(group => { %>
                    <option value="<%= group.id %>" <%= group.id === student.graduation_year_group_id ? 'selected' : '' %>>
                        <%= group.name %>
                    </option>
                <% }); %>
            </select>
        </div>

        <!-- Subjects -->
        <div class="form-group">
            <label>Subjects:</label>
            <div class="checkbox-group">
                <% subjects.forEach(subject => { %>
                    <label>
                        <input type="checkbox" name="subjects[]" value="<%= subject.subject_id %>" 
                               <%= studentSubjects.includes(subject.subject_id) ? 'checked' : '' %>>
                        <%= subject.subject_name %>
                    </label>
                <% }); %>
            </div>
        </div>
        

        <!-- Guardians -->
        <fieldset class="guardian-section">
            <legend>Guardians</legend>
            <div id="guardiansContainer">
              <% studentGuardians.forEach((guardian, index) => { %>
                <div class="guardian">
                  <label>Guardian <%= index + 1 %> First Name:</label>
                  <input type="text" name="guardians[<%= index %>][firstName]" value="<%= guardian.first_name %>">
                  <label>Last Name:</label>
                  <input type="text" name="guardians[<%= index %>][lastName]" value="<%= guardian.last_name %>">
                  <label>Address:</label>
                  <input type="text" name="guardians[<%= index %>][address]" value="<%= guardian.address %>">
                  <label>Phone:</label>
                  <input type="text" name="guardians[<%= index %>][phone]" value="<%= guardian.phone %>">
                  <label>Email:</label>
                  <input type="text" name="guardians[<%= index %>][email]" value="<%= guardian.email %>">
                  <label>Hometown:</label>
                  <input type="text" name="guardians[<%= index %>][hometown]" value="<%= guardian.hometown %>">
                </div>
              <% }); %>
            </div>
            <button type="button" class="btn btn-secondary" onclick="addGuardian()">+ Add Guardian</button>
          </fieldset>
          

        <!-- Student Image -->
    <!-- Student Image -->
    <div class="form-group">
        <label for="studentImage">Student Image:</label>
        <input type="file" name="studentImage" id="studentImage">
        <small style="color: #888;">Uploading a new image will replace the current one.</small>
        <% var imgUrl = '/images/profilePlaceholder.png'; %>
        <% if (student.image_url && student.image_url !== 'profilePlaceholder.png') { %>
            <% if (student.image_url.indexOf('http') === 0 || student.image_url.indexOf('/') === 0) { %>
                <% imgUrl = student.image_url; %>
            <% } else { %>
                <% imgUrl = '/' + student.image_url; %>
            <% } %>
        <% } %>
        <img src="<%= imgUrl %>" alt="Student Image" width="100">
    </div>
    <% if (student.image_url && student.image_url !== 'profilePlaceholder.png') { %>
        <div class="form-actions">
            <a href="/common/deleteStudentImage/<%= student.student_id %>" 
                 onclick="return confirmDelete('Are you sure you want to delete this image?')" 
                 class="delete-button">Delete Image</a>
        </div>
    <% } %>
  

        <!-- Actions -->
        <div class="form-actions">
            <button type="submit" class="btn btn-primary update-button">Update Student</button>
        </div>
    </form>

    <div class="form-actions">
        <form action="/common/deleteStudent/<%= student.student_id %>" method="POST" onsubmit="return confirmDelete('Are you sure you want to delete this student? This action cannot be undone.')">
            <button type="submit" class="btn btn-danger delete-button">Delete Student</button>
        </form>
    </div>
</main>
</html>
