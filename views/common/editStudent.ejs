<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit Student</title>
    <style>
      :root {
        --font-family: "<%= (session && session.fontStyle ? String(session.fontStyle).trim() : 'Inter') %>", sans-serif;
        --primary: var(--org-primary-color, #01535b);
        --primary-hover: var(--org-primary-hover, #013a40);
        --primary-hover-fill: color-mix(in srgb, var(--primary) 88%, white);
        --danger: #dc2626;
        --danger-hover: #b91c1c;
        --border: #e2e8f0;
        --bg: #f8fafc;
        --text: #1e293b;
        --text-muted: #64748b;
      }

      * { box-sizing: border-box; }

      body {
        font-family: var(--font-family);
        background: var(--bg);
        margin: 0;
        padding: 0;
        color: var(--text);
      }

      .es-container {
        max-width: 860px;
        margin: 0 auto;
        padding: 24px;
      }

      .es-top-bar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 20px;
      }

      .es-top-bar h1 {
        margin: 0;
        font-size: 22px;
        font-weight: 700;
        color: var(--text);
      }

      .es-back-btn {
        padding: 7px 14px;
        font-size: 13px;
        border-radius: 6px;
        background: white;
        color: #334155;
        border: 1px solid var(--border);
        text-decoration: none;
        font-weight: 600;
        transition: all 0.2s;
      }

      .es-back-btn:hover { background: #f1f5f9; }

      .es-card {
        background: white;
        border: 1px solid var(--border);
        border-radius: 12px;
        padding: 24px;
        margin-bottom: 20px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.04);
      }

      .es-section-title {
        font-size: 16px;
        font-weight: 700;
        color: var(--text);
        margin: 0 0 16px;
        padding-bottom: 10px;
        border-bottom: 2px solid var(--border);
        display: flex;
        align-items: center;
        gap: 8px;
      }

      .es-form-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 16px;
      }

      .es-field {
        display: flex;
        flex-direction: column;
        gap: 5px;
      }

      .es-field label {
        font-size: 12px;
        font-weight: 600;
        color: var(--text-muted);
        text-transform: uppercase;
        letter-spacing: 0.3px;
      }

      .es-field input,
      .es-field select,
      .es-field textarea {
        padding: 9px 12px;
        border: 1px solid #d1d5db;
        border-radius: 6px;
        font-size: 14px;
        font-family: inherit;
        background: white;
        transition: border-color 0.2s, box-shadow 0.2s;
        width: 100%;
      }

      .es-field input:focus,
      .es-field select:focus,
      .es-field textarea:focus {
        outline: none;
        border-color: var(--primary);
        box-shadow: 0 0 0 3px rgba(1, 83, 91, 0.1);
      }

      /* Checkbox group */
      .es-checkbox-group {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
      }

      .es-checkbox-item {
        display: flex;
        align-items: center;
        gap: 6px;
        padding: 6px 12px;
        background: #f8fafc;
        border: 1px solid var(--border);
        border-radius: 6px;
        cursor: pointer;
        transition: all 0.2s;
        font-size: 13px;
      }

      .es-checkbox-item:hover {
        border-color: var(--primary);
        background: #f0fdf4;
      }

      .es-checkbox-item input[type="checkbox"] {
        width: 16px;
        height: 16px;
        margin: 0;
        accent-color: var(--primary);
      }

      /* Guardian section */
      .es-guardian-entry {
        padding: 16px;
        background: #f8fafc;
        border: 1px solid var(--border);
        border-radius: 8px;
        margin-bottom: 12px;
      }

      .es-guardian-entry .es-form-grid {
        grid-template-columns: 1fr 1fr 1fr;
      }

      .es-add-guardian-btn {
        padding: 8px 16px;
        font-size: 13px;
        font-weight: 600;
        border-radius: 6px;
        background: #f1f5f9;
        color: #334155;
        border: 1px solid var(--border);
        cursor: pointer;
        transition: all 0.2s;
        margin-top: 8px;
      }

      .es-add-guardian-btn:hover { background: #e2e8f0; }

      /* Image section */
      .es-image-section {
        display: flex;
        align-items: center;
        gap: 20px;
        padding: 16px;
        background: #f8fafc;
        border: 1px solid var(--border);
        border-radius: 8px;
      }

      .es-student-img {
        width: 80px;
        height: 80px;
        border-radius: 50%;
        object-fit: cover;
        border: 3px solid var(--border);
      }

      .es-image-info {
        flex: 1;
      }

      .es-image-info p {
        margin: 0 0 6px;
        font-size: 13px;
        color: var(--text-muted);
      }

      .es-delete-image-btn {
        display: inline-block;
        padding: 5px 12px;
        font-size: 12px;
        font-weight: 600;
        border-radius: 4px;
        background: #fef2f2;
        color: var(--danger);
        border: 1px solid #fecaca;
        text-decoration: none;
        margin-top: 6px;
        transition: all 0.2s;
      }

      .es-delete-image-btn:hover {
        background: var(--danger);
        color: white;
        border-color: var(--danger);
      }

      /* Buttons */
      .es-btn-primary {
        padding: 10px 24px;
        font-size: 14px;
        font-weight: 600;
        border-radius: 8px;
        background: var(--btn-primary-bg, #01535b);
        color: var(--btn-primary-text, white);
        border: none;
        cursor: pointer;
        transition: all 0.2s;
        width: 100%;
      }

      .es-btn-primary:hover {
        background: var(--btn-primary-bg-hover, #013a40);
        transform: translateY(-1px);
      }

      .es-btn-danger {
        padding: 10px 24px;
        font-size: 14px;
        font-weight: 600;
        border-radius: 8px;
        background: white;
        color: var(--danger);
        border: 2px solid #fecaca;
        cursor: pointer;
        transition: all 0.2s;
        width: 100%;
      }

      .es-btn-danger:hover {
        background: var(--danger);
        color: white;
        border-color: var(--danger);
        transform: translateY(-1px);
      }

      .es-action-row {
        margin-top: 16px;
        display: flex;
        align-items: center;
        gap: 8px;
      }

      .es-action-row .es-btn-primary {
        width: auto;
        flex: 1;
      }

      .es-action-menu {
        position: relative;
      }

      .es-menu-toggle {
        width: 42px;
        height: 42px;
        border-radius: 8px;
        border: 1px solid var(--border);
        background: #ffffff;
        color: #334155;
        font-size: 22px;
        line-height: 1;
        cursor: pointer;
        font-weight: 700;
      }

      .es-menu-toggle:hover {
        background: #f8fafc;
      }

      .es-action-dropdown {
        position: absolute;
        top: calc(100% + 8px);
        right: 0;
        min-width: 180px;
        padding: 10px;
        border: 1px solid var(--border);
        border-radius: 10px;
        background: #ffffff;
        box-shadow: 0 12px 28px rgba(15, 23, 42, 0.12);
        z-index: 10;
        display: none;
      }

      .es-action-dropdown.open {
        display: block;
      }

      .es-action-dropdown .es-btn-danger {
        width: 100%;
      }

      .es-danger-zone {
        background: #fef2f2;
        border: 1px solid #fecaca;
        border-radius: 12px;
        padding: 20px;
      }

      .es-danger-title {
        font-size: 15px;
        font-weight: 700;
        color: var(--danger);
        margin: 0 0 4px;
      }

      .es-danger-text {
        font-size: 13px;
        color: #991b1b;
        margin: 0 0 12px;
      }

      @media (max-width: 768px) {
        .es-container { padding: 16px; }
        .es-form-grid { grid-template-columns: 1fr; }
        .es-guardian-entry .es-form-grid { grid-template-columns: 1fr; }
        .es-top-bar { flex-direction: column; gap: 8px; text-align: center; }
        .es-image-section { flex-direction: column; text-align: center; }
        .es-action-row { width: 100%; }
      }
    </style>
    <script>
        function confirmUpdate(event) {
            if (!confirm("Are you sure you want to update this student? Please double-check all details before proceeding.")) {
                event.preventDefault();
            }
        }
        function confirmDelete(message) { return confirm(message); }

        function toggleActionMenu() {
          const menu = document.getElementById('studentActionDropdown');
          if (!menu) return;
          menu.classList.toggle('open');
        }

        function closeActionMenu() {
          const menu = document.getElementById('studentActionDropdown');
          if (!menu) return;
          menu.classList.remove('open');
        }

        function submitDeleteStudent() {
          if (!confirmDelete('Are you sure you want to delete this student? This action cannot be undone.')) {
            return;
          }
          const form = document.getElementById('deleteStudentForm');
          if (form) {
            form.submit();
          }
        }

        document.addEventListener('click', function(event) {
          const menuWrapper = event.target.closest('.es-action-menu');
          if (!menuWrapper) {
            closeActionMenu();
          }
        });

        function addGuardian() {
            const container = document.getElementById("guardiansContainer");
            const count = container.querySelectorAll('.es-guardian-entry').length;
            const div = document.createElement('div');
            div.className = 'es-guardian-entry';
            div.innerHTML = '<div class="es-form-grid">' +
              '<div class="es-field"><label>First Name</label><input type="text" name="guardians[' + count + '][firstName]"></div>' +
              '<div class="es-field"><label>Last Name</label><input type="text" name="guardians[' + count + '][lastName]"></div>' +
              '<div class="es-field"><label>Phone</label><input type="text" name="guardians[' + count + '][phone]"></div>' +
              '<div class="es-field"><label>Email</label><input type="email" name="guardians[' + count + '][email]"></div>' +
              '<div class="es-field"><label>Address</label><input type="text" name="guardians[' + count + '][address]"></div>' +
              '<div class="es-field"><label>Hometown</label><input type="text" name="guardians[' + count + '][hometown]"></div>' +
            '</div>';
            container.appendChild(div);
        }
    </script>
</head>
<body>
<div class="es-container">
  <div class="es-top-bar">
    <h1>Edit Student</h1>
    <a href="/common/studentDetails?studentId=<%= student.student_id %>&termId=<%= currentTerm ? currentTerm.term_id : '' %>" class="es-back-btn">← Back</a>
  </div>

  <form action="/common/editStudent/<%= student.student_id %>" method="POST" enctype="multipart/form-data" onsubmit="confirmUpdate(event)">
    
    <!-- Student Image -->
    <div class="es-card">
      <h3 class="es-section-title">📷 Student Photo</h3>
      <div class="es-image-section">
        <% var imgUrl = '/images/profilePlaceholder.png'; %>
        <% if (student.image_url && student.image_url !== 'profilePlaceholder.png') { %>
            <% if (student.image_url.indexOf('http') === 0 || student.image_url.indexOf('/') === 0) { %>
                <% imgUrl = student.image_url; %>
            <% } else { %>
                <% imgUrl = '/' + student.image_url; %>
            <% } %>
        <% } %>
        <img src="<%= imgUrl %>" alt="Student" class="es-student-img">
        <div class="es-image-info">
          <p style="font-weight: 600; color: #334155;">Current Photo</p>
          <p>Upload a new image to replace this one</p>
          <input type="file" name="studentImage" accept="image/*" style="font-size: 13px;">
          <% if (student.image_url && student.image_url !== 'profilePlaceholder.png') { %>
            <a href="/common/deleteStudentImage/<%= student.student_id %>" 
               onclick="return confirmDelete('Are you sure you want to delete this image?')" 
               class="es-delete-image-btn">🗑 Delete Image</a>
          <% } %>
        </div>
      </div>
    </div>

    <!-- Personal Information -->
    <div class="es-card">
      <h3 class="es-section-title">👤 Personal Information</h3>
      <div class="es-form-grid">
        <div class="es-field">
          <label>First Name *</label>
          <input type="text" name="firstName" value="<%= student.first_name %>" required>
        </div>
        <div class="es-field">
          <label>Last Name *</label>
          <input type="text" name="lastName" value="<%= student.last_name %>" required>
        </div>
        <div class="es-field">
          <label>Date of Birth *</label>
          <input type="date" name="dateOfBirth" value="<%= student.date_of_birth ? (student.date_of_birth instanceof Date ? student.date_of_birth : new Date(student.date_of_birth)).toISOString().slice(0, 10) : '' %>" required>
        </div>
        <div class="es-field">
          <label>Gender *</label>
          <select name="gender" required>
            <option value="Male" <%= student.gender === 'Male' ? 'selected' : '' %>>Male</option>
            <option value="Female" <%= student.gender === 'Female' ? 'selected' : '' %>>Female</option>
          </select>
        </div>
        <div class="es-field">
          <label>Hometown</label>
          <input type="text" name="hometown" value="<%= student.hometown %>">
        </div>
        <div class="es-field">
          <label>Graduation Year Group</label>
          <select name="graduationYearGroupId">
            <option value="">— None —</option>
            <% graduationYearGroups.forEach(group => { %>
              <option value="<%= group.id %>" <%= group.id === student.graduation_year_group_id ? 'selected' : '' %>><%= group.name %></option>
            <% }); %>
          </select>
        </div>
        <div class="es-field">
          <label>Class *</label>
          <select name="classId" required>
            <% classes.forEach(cls => { %>
              <option value="<%= cls.class_id %>" <%= cls.class_id === student.class_id ? 'selected' : '' %>><%= cls.class_name %></option>
            <% }); %>
          </select>
        </div>
      </div>
    </div>

    <!-- Subjects -->
    <div class="es-card">
      <h3 class="es-section-title">📚 Subjects</h3>
      <div class="es-checkbox-group">
        <% subjects.forEach(subject => { %>
          <label class="es-checkbox-item">
            <input type="checkbox" name="subjects[]" value="<%= subject.subject_id %>" 
                   <%= studentSubjects.includes(subject.subject_id) ? 'checked' : '' %>>
            <%= subject.subject_name %>
          </label>
        <% }); %>
      </div>
    </div>

    <!-- Guardians -->
    <div class="es-card">
      <h3 class="es-section-title">👨‍👩‍👧 Guardians</h3>
      <div id="guardiansContainer">
        <% studentGuardians.forEach((guardian, index) => { %>
          <div class="es-guardian-entry">
            <div class="es-form-grid">
              <div class="es-field">
                <label>First Name</label>
                <input type="text" name="guardians[<%= index %>][firstName]" value="<%= guardian.first_name %>">
              </div>
              <div class="es-field">
                <label>Last Name</label>
                <input type="text" name="guardians[<%= index %>][lastName]" value="<%= guardian.last_name %>">
              </div>
              <div class="es-field">
                <label>Phone</label>
                <input type="text" name="guardians[<%= index %>][phone]" value="<%= guardian.phone %>">
              </div>
              <div class="es-field">
                <label>Email</label>
                <input type="text" name="guardians[<%= index %>][email]" value="<%= guardian.email %>">
              </div>
              <div class="es-field">
                <label>Address</label>
                <input type="text" name="guardians[<%= index %>][address]" value="<%= guardian.address %>">
              </div>
              <div class="es-field">
                <label>Hometown</label>
                <input type="text" name="guardians[<%= index %>][hometown]" value="<%= guardian.hometown %>">
              </div>
            </div>
          </div>
        <% }); %>
      </div>
      <button type="button" class="es-add-guardian-btn" onclick="addGuardian()">+ Add Guardian</button>
    </div>

    <!-- Actions -->
    <div class="es-action-row">
      <button type="submit" class="es-btn-primary">✅ Update Student</button>

      <div class="es-action-menu">
        <button type="button" class="es-menu-toggle" onclick="toggleActionMenu()" aria-label="More actions">:</button>
        <div id="studentActionDropdown" class="es-action-dropdown">
          <button type="button" class="es-btn-danger" onclick="submitDeleteStudent()">🗑 Delete Student</button>
        </div>
      </div>
    </div>
  </form>

  <form id="deleteStudentForm" action="/common/deleteStudent/<%= student.student_id %>" method="POST"></form>
</div>
</body>
</html>
