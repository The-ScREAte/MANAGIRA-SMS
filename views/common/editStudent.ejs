<!DOCTYPE html>
<html lang="en">
<head>
  <link rel="stylesheet" href="/css/globalScale.css">
    <meta charset="UTF-8">
    <meta name="viewport" content="<%= locals.viewportContent || 'width=device-width, initial-scale=1.0' %>">
    <title>Edit Student</title>
    <style>
      :root {
        --font-family: "<%= (session && session.fontStyle ? String(session.fontStyle).trim() : 'Inter') %>", sans-serif;
        --primary: var(--org-primary-color, #01535b);
        --primary-hover: var(--org-primary-hover, #013a40);
        --primary-hover-fill: color-mix(in srgb, var(--primary) 88%, white);
        --danger: #dc2626;
        --danger-hover: #b91c1c;
        --border: #e2e8f0;
        --bg: #f8fafc;
        --text: #1e293b;
        --text-muted: #64748b;
      }

      * { box-sizing: border-box; }

      body {
        font-family: var(--font-family);
        background: var(--bg);
        margin: 0;
        padding: 0;
        color: var(--text);
      }

      .es-container {
        max-width: 1180px;
        margin: 0 auto;
        padding: 12px 24px 24px;
      }

      .es-overview-grid {
        display: grid;
        grid-template-columns: minmax(280px, 320px) minmax(0, 1fr);
        gap: 20px;
        align-items: start;
        margin-bottom: 20px;
      }

      .es-overview-grid > .es-card {
        margin-bottom: 0;
      }

      .es-top-bar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 20px;
      }

      .es-top-bar h1 {
        margin: 0;
        font-size: 22px;
        font-weight: 700;
        color: var(--text);
      }

      .es-back-btn {
        padding: 7px 14px;
        font-size: 13px;
        border-radius: 6px;
        background: white;
        color: #334155;
        border: 1px solid var(--border);
        text-decoration: none;
        font-weight: 600;
        transition: all 0.2s;
      }

      .es-back-btn:hover { background: #f1f5f9; }

      .es-id-widget {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        white-space: nowrap;
        margin-left: auto;
        flex-shrink: 0;
      }
      .es-id-label {
        font-size: 0.74rem;
        font-weight: 600;
        color: #64748b;
        white-space: nowrap;
      }
      .es-id-label strong { color: #0f172a; }
      .es-id-input {
        width: auto;
        min-width: 7ch;
        max-width: 10ch;
        border: none;
        border-bottom: 1.5px solid #cbd5e1;
        box-shadow: none !important;
        border-radius: 0 !important;
        background: transparent;
        color: #1e293b;
        font-size: 0.78rem;
        font-weight: 600;
        font-family: 'SFMono-Regular', Consolas, monospace;
        outline: none;
        padding: 0 !important;
        margin: 0 !important;
        transition: border-color 0.15s, color 0.15s;
        text-align: left;
      }
      .es-id-input:focus { border-bottom-color: var(--primary); }
      .es-id-input.sid-taken { color: #ef4444; border-bottom-color: #ef4444; }
      .es-id-input::placeholder { color: #94a3b8; opacity: 1; }
      .es-id-taken-msg {
        font-size: 0.68rem;
        color: #ef4444;
        font-weight: 500;
        display: none;
      }
      .es-id-taken-msg.visible { display: inline; }

      .es-card {
        background: white;
        border: 1px solid var(--border);
        border-radius: 16px;
        padding: 24px;
        margin-bottom: 20px;
        box-shadow: 0 12px 30px rgba(15, 23, 42, 0.06);
      }

      .es-card--sticky {
        position: sticky;
        top: 16px;
      }

      .es-section-title {
        font-size: 16px;
        font-weight: 700;
        color: var(--text);
        margin: 0 0 16px;
        padding-bottom: 12px;
        border-bottom: 2px solid var(--border);
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 8px;
      }

      .es-form-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 18px 16px;
      }

      .es-field {
        display: flex;
        flex-direction: column;
        gap: 5px;
      }

      .es-field label {
        font-size: 12px;
        font-weight: 600;
        color: var(--text-muted);
        text-transform: uppercase;
        letter-spacing: 0.3px;
      }

      .es-field input,
      .es-field select,
      .es-field textarea {
        padding: 9px 12px;
        border: 1px solid #d1d5db;
        border-radius: 6px;
        font-size: 14px;
        font-family: inherit;
        background: white;
        transition: border-color 0.2s, box-shadow 0.2s;
        width: 100%;
      }

      .es-field input:focus,
      .es-field select:focus,
      .es-field textarea:focus {
        outline: none;
        border-color: var(--primary);
        box-shadow: 0 0 0 3px rgba(1, 83, 91, 0.1);
      }

      /* Compact personal information block */
      .es-card--personal-compact {
        padding: 18px;
        border-radius: 14px;
      }

      .es-card--personal-compact .es-section-title {
        font-size: 14px;
        margin: 0 0 12px;
        padding-bottom: 8px;
        gap: 6px;
      }

      .es-card--personal-compact .es-id-widget {
        gap: 3px;
      }

      .es-card--personal-compact .es-id-label {
        font-size: 0.68rem;
      }

      .es-card--personal-compact .es-id-input {
        font-size: 0.72rem;
      }

      .es-card--personal-compact .es-form-grid {
        gap: 12px;
      }

      .es-card--personal-compact .es-field {
        gap: 4px;
      }

      .es-card--personal-compact .es-field label {
        font-size: 11px;
        letter-spacing: 0.2px;
      }

      .es-card--personal-compact .es-field input,
      .es-card--personal-compact .es-field select {
        padding: 7px 10px;
        font-size: 13px;
        border-radius: 5px;
      }

      /* Checkbox group */
      .es-checkbox-group {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
      }

      .es-checkbox-item {
        display: flex;
        align-items: center;
        gap: 6px;
        padding: 6px 12px;
        background: #f8fafc;
        border: 1px solid var(--border);
        border-radius: 6px;
        cursor: pointer;
        transition: all 0.2s;
        font-size: 13px;
      }

      .es-checkbox-item:hover {
        border-color: var(--primary);
        background: #f0fdf4;
      }

      .es-checkbox-item input[type="checkbox"] {
        width: 16px;
        height: 16px;
        margin: 0;
        accent-color: var(--primary);
      }

      .es-subject-note {
        margin: 0 0 12px;
        padding: 10px 12px;
        border-radius: 10px;
        font-size: 13px;
        line-height: 1.5;
        display: none;
      }

      .es-subject-note.is-info {
        background: #eff6ff;
        border: 1px solid #bfdbfe;
        color: #1d4ed8;
      }

      .es-subject-note.is-success {
        background: #ecfdf5;
        border: 1px solid #a7f3d0;
        color: #047857;
      }

      .es-subject-note.is-warning {
        background: #fff7ed;
        border: 1px solid #fdba74;
        color: #c2410c;
      }

      .es-subject-note.is-error {
        background: #fef2f2;
        border: 1px solid #fca5a5;
        color: #b91c1c;
      }

      .es-subject-empty {
        width: 100%;
        padding: 12px 14px;
        border: 1px dashed var(--border);
        border-radius: 10px;
        background: #f8fafc;
        color: #64748b;
        font-size: 13px;
      }

      /* Guardian section */
      .es-guardian-entry {
        padding: 16px;
        background: #f8fafc;
        border: 1px solid var(--border);
        border-radius: 12px;
        margin-bottom: 12px;
      }

      .es-guardian-entry .es-form-grid {
        grid-template-columns: 1fr 1fr;
      }

      .es-add-guardian-btn {
        padding: 8px 16px;
        font-size: 13px;
        font-weight: 600;
        border-radius: 6px;
        background: #f1f5f9;
        color: #334155;
        border: 1px solid var(--border);
        cursor: pointer;
        transition: all 0.2s;
        margin-top: 8px;
      }

      .es-add-guardian-btn:hover { background: #e2e8f0; }

      /* Image section */
      .es-image-section {
        display: flex;
        flex-direction: column;
        align-items: stretch;
        gap: 18px;
        padding: 18px;
        background: linear-gradient(180deg, #fbfdff 0%, #f8fafc 100%);
        border: 1px solid var(--border);
        border-radius: 14px;
      }

      .es-student-img {
        width: 112px;
        height: 112px;
        border-radius: 50%;
        object-fit: cover;
        border: 4px solid #ffffff;
        box-shadow: 0 10px 24px rgba(15, 23, 42, 0.14);
        align-self: center;
      }

      .es-image-info {
        flex: 1;
        display: grid;
        gap: 14px;
      }

      .es-image-info p {
        margin: 0 0 6px;
        font-size: 13px;
        color: var(--text-muted);
      }

      .es-profile-summary {
        display: grid;
        gap: 8px;
        text-align: center;
      }

      .es-profile-eyebrow {
        margin: 0;
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--text-muted);
      }

      .es-profile-name {
        margin: 0;
        font-size: 20px;
        font-weight: 700;
        color: var(--text);
        line-height: 1.15;
      }

      .es-profile-chip-row {
        display: flex;
        justify-content: center;
        flex-wrap: wrap;
        gap: 8px;
      }

      .es-profile-chip {
        display: inline-flex;
        align-items: center;
        padding: 6px 12px;
        border-radius: 999px;
        border: 1px solid color-mix(in srgb, var(--primary) 18%, #dbe3ea);
        background: color-mix(in srgb, var(--primary) 8%, white);
        color: var(--primary);
        font-size: 12px;
        font-weight: 700;
        letter-spacing: 0.04em;
        font-family: 'SFMono-Regular', Consolas, monospace;
      }

      .es-upload-panel {
        display: grid;
        gap: 8px;
        padding-top: 14px;
        border-top: 1px solid var(--border);
      }

      .es-upload-input {
        font-size: 13px;
        width: 100%;
      }

      .es-delete-image-btn {
        display: inline-block;
        padding: 5px 12px;
        font-size: 12px;
        font-weight: 600;
        border-radius: 4px;
        background: #fef2f2;
        color: var(--danger);
        border: 1px solid #fecaca;
        text-decoration: none;
        margin-top: 6px;
        transition: all 0.2s;
      }

      .es-delete-image-btn:hover {
        background: var(--danger);
        color: white;
        border-color: var(--danger);
      }

      /* Buttons */
      .es-btn-primary {
        padding: 10px 24px;
        font-size: 14px;
        font-weight: 600;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        border-radius: 8px;
        background: var(--btn-primary-bg, #01535b);
        color: var(--btn-primary-text, white);
        border: none;
        cursor: pointer;
        transition: all 0.2s;
        width: 100%;
      }

      .es-btn-spinner {
        width: 14px;
        height: 14px;
        border-radius: 999px;
        border: 2px solid rgba(255, 255, 255, 0.42);
        border-top-color: #ffffff;
        animation: esSpin 0.45s linear infinite;
        display: none;
        flex: 0 0 auto;
      }

      @keyframes esSpin {
        to { transform: rotate(360deg); }
      }

      .es-btn-primary.is-saving {
        opacity: 0.95;
        cursor: wait;
      }

      .es-btn-primary.is-saving .es-btn-spinner {
        display: inline-block;
      }

      .es-btn-primary:hover {
        background: var(--btn-primary-bg-hover, #013a40);
        transform: translateY(-1px);
      }

      .es-btn-danger {
        padding: 10px 24px;
        font-size: 14px;
        font-weight: 600;
        border-radius: 8px;
        background: white;
        color: var(--danger);
        border: 2px solid #fecaca;
        cursor: pointer;
        transition: all 0.2s;
        width: 100%;
      }

      .es-btn-danger:hover {
        background: var(--danger);
        color: white;
        border-color: var(--danger);
        transform: translateY(-1px);
      }

      .es-action-row {
        margin-top: 16px;
        display: flex;
        align-items: center;
        gap: 8px;
      }

      .es-action-row .es-btn-primary {
        width: auto;
        flex: 1;
      }

      .es-action-menu {
        position: relative;
      }

      .es-menu-toggle {
        width: 42px;
        height: 42px;
        border-radius: 8px;
        border: 1px solid var(--border);
        background: #ffffff;
        color: #334155;
        font-size: 22px;
        line-height: 1;
        cursor: pointer;
        font-weight: 700;
      }

      .es-menu-toggle:hover {
        background: #f8fafc;
      }

      .es-action-dropdown {
        position: absolute;
        top: calc(100% + 8px);
        right: 0;
        min-width: 180px;
        padding: 10px;
        border: 1px solid var(--border);
        border-radius: 10px;
        background: #ffffff;
        box-shadow: 0 12px 28px rgba(15, 23, 42, 0.12);
        z-index: 10;
        display: none;
      }

      .es-action-dropdown.open {
        display: block;
      }

      .es-action-dropdown .es-btn-danger {
        width: 100%;
      }

      .es-danger-zone {
        background: #fef2f2;
        border: 1px solid #fecaca;
        border-radius: 12px;
        padding: 20px;
      }

      .es-danger-title {
        font-size: 15px;
        font-weight: 700;
        color: var(--danger);
        margin: 0 0 4px;
      }

      .es-danger-text {
        font-size: 13px;
        color: #991b1b;
        margin: 0 0 12px;
      }

      @media (max-width: 768px) {
        .es-container { padding: 16px; }
        .es-overview-grid { grid-template-columns: 1fr; }
        .es-form-grid { grid-template-columns: 1fr; }
        .es-guardian-entry .es-form-grid { grid-template-columns: 1fr; }
        .es-top-bar { flex-direction: column; gap: 8px; text-align: center; }
        .es-card--sticky { position: static; }
        .es-image-section { text-align: center; }
        .es-action-row { width: 100%; }
      }

      .es-id-widget {
        display: inline-flex !important;
        align-items: center !important;
        gap: 6px !important;
        position: static !important;
        top: auto !important;
        margin-top: 0 !important;
        padding: 4px 8px !important;
        border: 1px solid color-mix(in srgb, var(--primary) 14%, #dbe3ea) !important;
        border-radius: 999px !important;
        background: linear-gradient(180deg, #ffffff 0%, #f8fafc 100%) !important;
        box-shadow: 0 1px 2px rgba(15, 23, 42, 0.06) !important;
        transform: none !important;
      }
      .es-id-label {
        display: inline-flex !important;
        align-items: center !important;
        position: static !important;
        top: auto !important;
        margin-top: 0 !important;
        line-height: 1 !important;
        color: #1e293b !important;
      }
      .es-id-input {
        width: 6.8ch !important;
        min-width: 6.8ch !important;
        max-width: 10ch !important;
        position: static !important;
        top: auto !important;
        height: 1.45rem !important;
        line-height: 1.1 !important;
        padding: 0 !important;
        margin: 0 !important;
        margin-top: 0 !important;
        border-bottom: 1.5px solid color-mix(in srgb, var(--primary) 42%, #cbd5e1) !important;
        background: transparent !important;
        transform: none !important;
      }
    </style>
    <script src="/js/dialCodes.js"></script>
    <script>
        let updateFormSubmitting = false;

        function setUpdateStudentSavingState(isSaving) {
          const button = document.getElementById('esUpdateStudentBtn');
          if (!button) return;

          button.classList.toggle('is-saving', Boolean(isSaving));
          button.disabled = Boolean(isSaving);
          button.setAttribute('aria-busy', isSaving ? 'true' : 'false');
        }

        function confirmUpdate(event) {
            if (updateFormSubmitting) {
              event.preventDefault();
              return false;
            }

            if (!confirm("Are you sure you want to update this student? Please double-check all details before proceeding.")) {
              event.preventDefault();
              return false;
            }

            if (window.combinePhoneCountryCombos) window.combinePhoneCountryCombos(event.target);
            updateFormSubmitting = true;
            setUpdateStudentSavingState(true);
            return true;
        }
        function confirmDelete(message) { return confirm(message); }

        function bindEditDobUnknownToggle() {
          const dobInput = document.getElementById('esDateOfBirth');
          const unknownToggle = document.getElementById('esDateOfBirthUnknown');
          if (!dobInput || !unknownToggle) return;

          const apply = () => {
            const isUnknown = Boolean(unknownToggle.checked);
            dobInput.required = !isUnknown;
            dobInput.disabled = isUnknown;
            if (isUnknown) {
              dobInput.value = '';
            }
          };

          apply();
          unknownToggle.addEventListener('change', apply);
        }

        function toggleActionMenu() {
          const menu = document.getElementById('studentActionDropdown');
          if (!menu) return;
          menu.classList.toggle('open');
        }

        function closeActionMenu() {
          const menu = document.getElementById('studentActionDropdown');
          if (!menu) return;
          menu.classList.remove('open');
        }

        function submitDeleteStudent() {
          if (!confirmDelete('Are you sure you want to delete this student? This action cannot be undone.')) {
            return;
          }
          const form = document.getElementById('deleteStudentForm');
          if (form) {
            form.submit();
          }
        }

        document.addEventListener('click', function(event) {
          const menuWrapper = event.target.closest('.es-action-menu');
          if (!menuWrapper) {
            closeActionMenu();
          }
        });

        // Real-time student ID conflict check
        (function() {
          const input = document.getElementById('esCustomStudentId');
          if (!input) return;
          const syncStudentIdInputWidth = (node) => {
            const basis = (node.value || node.placeholder || '').trim();
            const chars = Math.max(6, Math.min(10, basis.length || 6));
            node.style.width = (chars + 0.8) + 'ch';
          };
          const prefix = '<%= (studentIdSettings && studentIdSettings.student_id_prefix) ? studentIdSettings.student_id_prefix : "" %>';
          const originalValue = input.value.trim();
          const studentId = '<%= student.student_id %>';
          let timer;
          syncStudentIdInputWidth(input);
          input.addEventListener('input', function() {
            clearTimeout(timer);
            syncStudentIdInputWidth(input);
            const val = this.value.trim();
            if (!val) {
              input.classList.remove('sid-taken');
              return;
            }
            timer = setTimeout(async function() {
              try {
                const fullId = prefix + val;
                const r = await fetch('/common/check-student-id?id=' + encodeURIComponent(fullId) + '&num=' + encodeURIComponent(val) + '&exclude=' + studentId);
                const d = await r.json();
                input.classList.toggle('sid-taken', d.taken);
              } catch(e) {}
            }, 400);
          });
        })();

        function normalizeSubjectCarryoverName(value) {
          return String(value || '')
            .trim()
            .toLowerCase()
            .replace(/[^a-z0-9]+/g, ' ')
            .replace(/\s+/g, ' ')
            .trim();
        }

        function escapeSubjectHtml(value) {
          return String(value || '').replace(/[&<>"']/g, function(match) {
            return ({
              '&': '&amp;',
              '<': '&lt;',
              '>': '&gt;',
              '"': '&quot;',
              "'": '&#039;'
            })[match];
          });
        }

        function getSelectedSubjectNames() {
          return Array.from(document.querySelectorAll('#esSubjectsCheckboxGroup input[name="subjects[]"]:checked'))
            .map(function(node) { return node.getAttribute('data-subject-name') || ''; })
            .filter(Boolean);
        }

        function setSubjectChangeNote(message, tone) {
          const note = document.getElementById('esSubjectChangeNote');
          if (!note) return;
          if (!message) {
            note.textContent = '';
            note.className = 'es-subject-note';
            note.style.display = 'none';
            return;
          }
          note.textContent = message;
          note.className = 'es-subject-note is-' + (tone || 'info');
          note.style.display = 'block';
        }

        function renderSubjectOptions(subjects, selectedSubjectNames) {
          const group = document.getElementById('esSubjectsCheckboxGroup');
          if (!group) return { matchedNames: [], unmatchedNames: [] };

          const selectedKeys = new Set((selectedSubjectNames || []).map(normalizeSubjectCarryoverName));
          const matchedNames = [];
          const availableKeys = new Set();

          if (!Array.isArray(subjects) || !subjects.length) {
            group.innerHTML = '<div class="es-subject-empty">No subjects are available for this class yet.</div>';
            return {
              matchedNames: [],
              unmatchedNames: selectedSubjectNames || [],
            };
          }

          const markup = subjects.map(function(subject) {
            const subjectName = String(subject.subject_name || '');
            const subjectKey = normalizeSubjectCarryoverName(subjectName);
            const checked = selectedKeys.has(subjectKey);
            availableKeys.add(subjectKey);
            if (checked) matchedNames.push(subjectName);
            return '<label class="es-checkbox-item">' +
              '<input type="checkbox" name="subjects[]" value="' + escapeSubjectHtml(subject.subject_id) + '" data-subject-name="' + escapeSubjectHtml(subjectName) + '"' + (checked ? ' checked' : '') + '>' +
              escapeSubjectHtml(subjectName) +
            '</label>';
          });

          group.innerHTML = markup.join('');

          const unmatchedNames = (selectedSubjectNames || []).filter(function(subjectName) {
            return !availableKeys.has(normalizeSubjectCarryoverName(subjectName));
          });

          return {
            matchedNames: matchedNames,
            unmatchedNames: unmatchedNames,
          };
        }

        async function reloadSubjectsForClass(classId, keepExistingSubjects) {
          const group = document.getElementById('esSubjectsCheckboxGroup');
          const keepInput = document.getElementById('esKeepExistingSubjectsOnClassChange');
          if (!group || !keepInput) return;

          const selectedSubjectNames = keepExistingSubjects ? getSelectedSubjectNames() : [];
          keepInput.value = keepExistingSubjects ? 'true' : 'false';
          setSubjectChangeNote('Loading subjects for the selected class…', 'info');

          try {
            const response = await fetch('/common/getSubjectsForClass?classId=' + encodeURIComponent(classId), {
              headers: { 'X-Requested-With': 'XMLHttpRequest' },
              credentials: 'same-origin'
            });
            const payload = await response.json();
            const subjects = Array.isArray(payload) ? payload : [];
            const outcome = renderSubjectOptions(subjects, selectedSubjectNames);

            if (keepExistingSubjects) {
              if (outcome.unmatchedNames.length) {
                setSubjectChangeNote(
                  'Some previous subjects are not available in this class: ' + outcome.unmatchedNames.join(', ') + '.',
                  'warning'
                );
              } else if (outcome.matchedNames.length) {
                setSubjectChangeNote('Matched previous subjects in the new class.', 'success');
              } else {
                setSubjectChangeNote('No previous subjects matched the new class.', 'warning');
              }
            } else if (!subjects.length) {
              setSubjectChangeNote('No subjects are available for this class yet.', 'info');
            } else {
              setSubjectChangeNote('Previous subjects were not carried into the new class.', 'info');
            }
          } catch (error) {
            setSubjectChangeNote('Failed to load subjects for the selected class. You can still save, and matching subjects will be carried on the server if needed.', 'error');
          }
        }

        document.addEventListener('DOMContentLoaded', function() {
          const classSelect = document.getElementById('esClassSelect');
          const keepInput = document.getElementById('esKeepExistingSubjectsOnClassChange');
          if (!classSelect || !keepInput) return;

          let renderedClassId = classSelect.value || '';

          classSelect.addEventListener('change', async function() {
            const newClassId = this.value || '';
            if (!newClassId || newClassId === renderedClassId) {
              return;
            }

            const keepExistingSubjects = window.confirm(
              'Do you want this student enrolled in the same subjects as before? Click OK for Yes or Cancel for No.'
            );

            await reloadSubjectsForClass(newClassId, keepExistingSubjects);
            renderedClassId = newClassId;
          });
        });

        function addGuardian() {
            const container = document.getElementById("guardiansContainer");
            const count = container.querySelectorAll('.es-guardian-entry').length;
            const div = document.createElement('div');
            div.className = 'es-guardian-entry';
            div.innerHTML = '<div class="es-form-grid">' +
              '<div class="es-field"><label>First Name</label><input type="text" name="guardians[' + count + '][firstName]"></div>' +
              '<div class="es-field"><label>Last Name</label><input type="text" name="guardians[' + count + '][lastName]"></div>' +
              '<div class="es-field"><label>Phone</label><div class="phone-combo" data-default-iso2="GH" style="display:flex;gap:6px;"><select class="phone-dial-select" style="max-width:150px;flex:0 0 auto;"></select><input type="text" class="phone-local-input" name="guardians[' + count + '][phone]" placeholder="24 123 4567" style="flex:1;"></div></div>' +
              '<div class="es-field"><label>Email</label><input type="email" name="guardians[' + count + '][email]"></div>' +
              '<div class="es-field"><label>Address</label><input type="text" name="guardians[' + count + '][address]"><label style="display:flex;align-items:center;gap:6px;font-size:0.75rem;margin:6px 0 0;"><input type="checkbox" class="es-guardian-address-sync" checked> Use student address</label></div>' +
              '<div class="es-field"><label>Hometown</label><input type="text" name="guardians[' + count + '][hometown]"></div>' +
            '</div>';
            container.appendChild(div);
            if (window.initPhoneCountryCombos) window.initPhoneCountryCombos(div);
            bindGuardianAddressSyncForEntry(div);
        }

        function bindGuardianAddressSyncForEntry(entry) {
          if (!entry) return;
          const studentAddressInput = document.querySelector('input[name="studentAddress"]');
          const guardianAddressInput = entry.querySelector('input[name*="[address]"]');
          const syncToggle = entry.querySelector('.es-guardian-address-sync');
          if (!studentAddressInput || !guardianAddressInput || !syncToggle) return;

          const syncAddress = () => {
            if (syncToggle.checked) {
              guardianAddressInput.value = studentAddressInput.value || '';
            }
          };

          syncAddress();
          studentAddressInput.addEventListener('input', syncAddress);
          syncToggle.addEventListener('change', syncAddress);
        }

        document.addEventListener('DOMContentLoaded', function () {
          document.querySelectorAll('.es-guardian-entry').forEach(bindGuardianAddressSyncForEntry);
          bindEditDobUnknownToggle();
        });
    </script>
</head>
<body>
<div class="es-container">
  <%
    var _prefix = '';
    var _displayId = '';
    var _numPart = '';
    if (studentIdSettings && studentIdSettings.use_custom_student_id) {
      _prefix = studentIdSettings.student_id_prefix || '';
      _displayId = student.custom_student_id ||
        (_prefix
          ? _prefix + String(student.student_id).padStart(3, '0')
          : String(student.student_id).padStart(3, '0'));
      _numPart = (_prefix && _displayId.toUpperCase().indexOf(_prefix.toUpperCase()) === 0)
        ? _displayId.slice(_prefix.length)
        : _displayId;
    }
  %>

  <form action="/common/editStudent/<%= student.student_id %>" method="POST" enctype="multipart/form-data" onsubmit="confirmUpdate(event)">
    <input type="hidden" name="keepExistingSubjectsOnClassChange" id="esKeepExistingSubjectsOnClassChange" value="">
    <input type="hidden" name="returnClassId" value="<%= (typeof returnClassId !== 'undefined' && returnClassId) ? returnClassId : '' %>">
    <input type="hidden" name="returnTermId" value="<%= (typeof returnTermId !== 'undefined' && returnTermId) ? returnTermId : '' %>">
    <div class="es-overview-grid">
    
    <!-- Student Image -->
    <div class="es-card es-card--sticky">
      <h3 class="es-section-title">📷 Student Photo</h3>
      <div class="es-image-section">
        <% var imgUrl = '/images/profilePlaceholder.png'; %>
        <% if (student.image_url && student.image_url !== 'profilePlaceholder.png') { %>
            <% if (student.image_url.indexOf('http') === 0 || student.image_url.indexOf('/') === 0) { %>
                <% imgUrl = student.image_url; %>
            <% } else { %>
                <% imgUrl = '/' + student.image_url; %>
            <% } %>
        <% } %>
        <img src="<%= imgUrl %>" alt="Student" class="es-student-img">
        <div class="es-image-info">
          <div class="es-profile-summary">
            <p class="es-profile-eyebrow">Student profile</p>
            <p class="es-profile-name"><%= student.first_name %> <%= student.last_name %></p>
            <% if (_displayId) { %>
            <div class="es-profile-chip-row">
              <span class="es-profile-chip">ID <%= _displayId %></span>
            </div>
            <% } %>
          </div>
          <div class="es-upload-panel">
          <p style="font-weight: 600; color: #334155;">Current Photo</p>
          <p>Upload a new image to replace this one</p>
          <input type="file" name="studentImage" accept="image/*" class="es-upload-input">
          <% if (student.image_url && student.image_url !== 'profilePlaceholder.png') { %>
            <a href="/common/deleteStudentImage/<%= student.student_id %>" 
               onclick="return confirmDelete('Are you sure you want to delete this image?')" 
               class="es-delete-image-btn">🗑 Delete Image</a>
          <% } %>
          </div>
        </div>
      </div>
    </div>

    <!-- Personal Information -->
    <div class="es-card es-card--personal-compact">
      <div class="es-section-title">
        <span>👤 Personal Information</span>
        <% if (studentIdSettings && studentIdSettings.use_custom_student_id) { %>
        <div class="es-id-widget">
          <span class="es-id-label">ID:<% if (_prefix) { %> <strong><%= _prefix %></strong><% } %></span>
          <input type="text" name="customStudentId" id="esCustomStudentId" class="es-id-input"
            value="<%= _numPart %>"
            placeholder="001"
            maxlength="100"
            inputmode="numeric"
            autocomplete="off">
        </div>
        <% } %>
      </div>
      <div class="es-form-grid">
        <div class="es-field">
          <label>First Name *</label>
          <input type="text" name="firstName" value="<%= student.first_name %>" required>
        </div>
        <div class="es-field">
          <label>Last Name *</label>
          <input type="text" name="lastName" value="<%= student.last_name %>" required>
        </div>
        <div class="es-field">
          <label>Date of Birth *</label>
          <input type="date" id="esDateOfBirth" name="dateOfBirth" value="<%= student.date_of_birth ? (student.date_of_birth instanceof Date ? student.date_of_birth : new Date(student.date_of_birth)).toISOString().slice(0, 10) : '' %>" <%= student.date_of_birth_unknown ? '' : 'required' %>>
          <label style="display:flex;align-items:center;gap:6px;font-size:0.66rem;margin:4px 0 0;color:#64748b;">
            <input type="checkbox" id="esDateOfBirthUnknown" name="dateOfBirthUnknown" value="true" <%= student.date_of_birth_unknown ? 'checked' : '' %>>
            N/K (Date of birth not known)
          </label>
        </div>
        <div class="es-field">
          <label>Gender *</label>
          <select name="gender" required>
            <option value="Male" <%= student.gender === 'Male' ? 'selected' : '' %>>Male</option>
            <option value="Female" <%= student.gender === 'Female' ? 'selected' : '' %>>Female</option>
          </select>
        </div>
        <div class="es-field">
          <label>Hometown</label>
          <input type="text" name="hometown" value="<%= student.hometown %>">
        </div>
        <div class="es-field">
          <label>Student Address</label>
          <input type="text" name="studentAddress" value="<%= student.address || '' %>">
        </div>
        <div class="es-field">
          <label>Student Email</label>
          <input type="email" name="studentEmail" value="<%= student.email || '' %>">
        </div>
        <div class="es-field">
          <label>Graduation Year Group</label>
          <select name="graduationYearGroupId">
            <option value="">— None —</option>
            <% graduationYearGroups.forEach(group => { %>
              <option value="<%= group.id %>" <%= group.id === student.graduation_year_group_id ? 'selected' : '' %>><%= group.name %></option>
            <% }); %>
          </select>
        </div>
        <div class="es-field">
          <label>Class *</label>
          <select name="classId" id="esClassSelect" required>
            <% classes.forEach(cls => { %>
              <option value="<%= cls.class_id %>" <%= cls.class_id === student.class_id ? 'selected' : '' %>><%= cls.class_name %></option>
            <% }); %>
          </select>
        </div>
      </div>
    </div>
    </div>

    <!-- Subjects -->
    <div class="es-card">
      <h3 class="es-section-title">📚 Subjects</h3>
      <div class="es-subject-note" id="esSubjectChangeNote"></div>
      <div class="es-checkbox-group" id="esSubjectsCheckboxGroup">
        <% subjects.forEach(subject => { %>
          <label class="es-checkbox-item">
            <input type="checkbox" name="subjects[]" value="<%= subject.subject_id %>" data-subject-name="<%= subject.subject_name %>"
                   <%= studentSubjects.includes(subject.subject_id) ? 'checked' : '' %>>
            <%= subject.subject_name %>
          </label>
        <% }); %>
      </div>
    </div>

    <!-- Guardians -->
    <div class="es-card">
      <h3 class="es-section-title">👨‍👩‍👧 Guardians</h3>
      <div id="guardiansContainer">
        <% studentGuardians.forEach((guardian, index) => { %>
          <div class="es-guardian-entry">
            <div class="es-form-grid">
              <div class="es-field">
                <label>First Name</label>
                <input type="text" name="guardians[<%= index %>][firstName]" value="<%= guardian.first_name %>">
              </div>
              <div class="es-field">
                <label>Last Name</label>
                <input type="text" name="guardians[<%= index %>][lastName]" value="<%= guardian.last_name %>">
              </div>
              <div class="es-field">
                <label>Phone</label>
                <div class="phone-combo" data-default-iso2="GH" style="display:flex;gap:6px;">
                  <select class="phone-dial-select" style="max-width:150px;flex:0 0 auto;"></select>
                  <input type="text" class="phone-local-input" name="guardians[<%= index %>][phone]" value="<%= guardian.phone %>" placeholder="24 123 4567" style="flex:1;">
                </div>
              </div>
              <div class="es-field">
                <label>Email</label>
                <input type="email" name="guardians[<%= index %>][email]" value="<%= guardian.email %>">
              </div>
              <div class="es-field">
                <label>Address</label>
                <input type="text" name="guardians[<%= index %>][address]" value="<%= guardian.address %>">
              </div>
              <div class="es-field">
                <label>Hometown</label>
                <input type="text" name="guardians[<%= index %>][hometown]" value="<%= guardian.hometown %>">
              </div>
            </div>
          </div>
        <% }); %>
      </div>
      <button type="button" class="es-add-guardian-btn" onclick="addGuardian()">+ Add Guardian</button>
    </div>

    <!-- Actions -->
    <div class="es-action-row">
      <button type="submit" id="esUpdateStudentBtn" class="es-btn-primary">
        <span class="es-btn-spinner" aria-hidden="true"></span>
        <span class="es-btn-label">✅ Update Student</span>
      </button>

      <div class="es-action-menu">
        <button type="button" class="es-menu-toggle" onclick="toggleActionMenu()" aria-label="More actions">:</button>
        <div id="studentActionDropdown" class="es-action-dropdown">
          <button type="button" class="es-btn-danger" onclick="submitDeleteStudent()">🗑 Delete Student</button>
        </div>
      </div>
    </div>
  </form>

  <form id="deleteStudentForm" action="/common/deleteStudent/<%= student.student_id %>" method="POST"></form>
</div>
</body>
</html>
