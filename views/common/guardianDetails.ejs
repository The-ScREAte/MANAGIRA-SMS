<div class="student-management-system" style="padding: 24px; max-width: 1400px; margin: 0 auto;">
  <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px;">
    <h1 style="margin: 0; color: #0f2d32; font-size: 28px;">Guardian Details</h1>
    <a href="/common/guardians" class="secondary-button" style="padding: 10px 20px; font-size: 15px;">← Back to Guardians</a>
  </div>

  <div class="student-form-card" style="max-width: none; background: linear-gradient(to bottom, #f8fafc 0%, white 100%);">
    <div class="guardian-details-header" style="display: flex; gap: 24px; margin-bottom: 24px; align-items: start;">
      <div>
        <img src="<%= guardian.image_url && guardian.image_url !== 'profilePlaceholder.png' ? guardian.image_url : '/images/profilePlaceholder.png' %>" 
             alt="Guardian" 
             style="width: 140px; height: 140px; border-radius: 50%; object-fit: cover; border: 4px solid #6fd3c4; box-shadow: 0 4px 12px rgba(111, 211, 196, 0.3);">
      </div>
      <div style="flex: 1;">
        <h2 style="margin: 0 0 12px 0; color: #0f2d32; font-size: 24px;"><%= guardian.first_name %> <%= guardian.last_name || '' %></h2>
        <div style="color: #475569; margin-bottom: 20px; background: white; padding: 16px; border-radius: 8px; border-left: 4px solid #6fd3c4;">
          <p style="margin: 8px 0; font-size: 15px;"><strong style="color: #0f2d32;">Email:</strong> <%= guardian.email || 'Not provided' %></p>
          <p style="margin: 8px 0; font-size: 15px;"><strong style="color: #0f2d32;">Phone:</strong> <%= guardian.phone || 'Not provided' %></p>
          <p style="margin: 8px 0; font-size: 15px;"><strong style="color: #0f2d32;">Address:</strong> <%= guardian.address || 'Not provided' %></p>
          <p style="margin: 8px 0; font-size: 15px;"><strong style="color: #0f2d32;">Hometown:</strong> <%= guardian.hometown || 'Not provided' %></p>
        </div>
        <div class="guardian-details-actions" style="display: flex; gap: 12px; flex-wrap: wrap;">
          <button onclick="toggleEditMode()" class="primary-button" style="padding: 12px 24px;">✏️ Edit Information</button>
          <button onclick="requestPasswordSetup()" class="secondary-button" style="padding: 12px 24px;">🔑 Send Password Setup</button>
        </div>
      </div>
    </div>

    <!-- Edit Form (Hidden by default) -->
    <form id="editForm" action="/common/guardianEdit/<%= guardian.guardian_id %>" method="POST" enctype="multipart/form-data" 
          style="display: none; margin-top: 24px; padding-top: 24px; border-top: 2px solid #e2e8f0;">
      <h3>Edit Guardian Information</h3>
      
      <div class="form-field-group">
        <label class="form-label">First Name</label>
        <input type="text" class="form-input" name="firstName" value="<%= guardian.first_name %>" required>
      </div>

      <div class="form-field-group">
        <label class="form-label">Last Name</label>
        <input type="text" class="form-input" name="lastName" value="<%= guardian.last_name || '' %>">
      </div>

      <div class="form-field-group">
        <label class="form-label">Email</label>
        <input type="email" class="form-input" name="email" value="<%= guardian.email || '' %>">
      </div>

      <div class="form-field-group">
        <label class="form-label">Phone</label>
        <input type="text" class="form-input" name="phone" value="<%= guardian.phone || '' %>">
      </div>

      <div class="form-field-group">
        <label class="form-label">Address</label>
        <input type="text" class="form-input" name="address" value="<%= guardian.address || '' %>">
      </div>

      <div class="form-field-group">
        <label class="form-label">Hometown</label>
        <input type="text" class="form-input" name="hometown" value="<%= guardian.hometown || '' %>">
      </div>

      <div class="form-field-group">
        <label class="form-label">Update Photo (Optional)</label>
        <input type="file" class="form-input" name="guardianImage" accept="image/*">
      </div>

      <div style="display: flex; gap: 12px; margin-top: 20px;">
        <button type="submit" class="primary-button">Save Changes</button>
        <button type="button" onclick="toggleEditMode()" class="secondary-button">Cancel</button>
      </div>
    </form>
  </div>

  <!-- Linked Students -->
  <div class="student-form-card" style="max-width: none; margin-top: 24px;">
    <h3 style="color: #0f2d32; font-size: 20px; margin-bottom: 20px;">
      👨‍👩‍👧‍👦 Linked Students 
      <span style="background: linear-gradient(135deg, #6fd3c4, #4fc3af); color: white; padding: 4px 12px; border-radius: 12px; font-size: 16px; margin-left: 8px;">
        <%= students.length %>
      </span>
    </h3>

    <% if (!students.length) { %>
      <div style="text-align: center; padding: 40px; background: #f8fafc; border-radius: 8px; border: 2px dashed #cbd5e1;">
        <p style="color: #64748b; font-size: 16px; margin: 0;">No students linked to this guardian.</p>
      </div>
    <% } else { %>
        <div class="linked-students-grid" style="display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 20px; margin-top: 20px;">
        <% students.forEach(student => { %>
          <div style="border: 2px solid #e2e8f0; border-radius: 12px; padding: 20px; background: linear-gradient(to bottom, white, #f8fafc); transition: all 0.3s; box-shadow: 0 2px 8px rgba(0,0,0,0.05);">
            <div style="display: flex; gap: 14px; align-items: center;">
                <img src="<%= student.image_url && student.image_url !== 'profilePlaceholder.png' ? student.image_url : '/images/profilePlaceholder.png' %>" 
                   style="width: 60px; height: 60px; border-radius: 50%; object-fit: cover; border: 3px solid #6fd3c4;">
              <div style="flex: 1;">
                <div style="font-weight: 700; color: #0f2d32; font-size: 16px;"><%= student.first_name %> <%= student.last_name %></div>
                <div style="color: #6fd3c4; font-size: 14px; font-weight: 600; margin-top: 2px;"><%= student.class_name || 'No class' %></div>
                <div style="color: #94a3b8; font-size: 13px; margin-top: 2px;"><%= student.relationship || 'Guardian' %></div>
              </div>
            </div>
            <div style="margin-top: 12px; display: flex; gap: 8px;">
              <a href="/common/studentDetails?studentId=<%= student.student_id %><%= currentTermId ? '&termId=' + currentTermId : '' %><%= student.class_id ? '&classId=' + student.class_id : '' %>" 
                 class="secondary-button" 
                 style="flex: 1; text-align: center; padding: 6px 12px; font-size: 13px;">
                View Student
              </a>
              <button onclick="removeStudent('<%= student.student_id %>', '<%= student.first_name %> <%= student.last_name %>')" 
                      style="background: #ef4444; color: white; border: none; padding: 6px 12px; border-radius: 6px; cursor: pointer; font-size: 13px; font-weight: 600;">
                Remove
              </button>
            </div>
          </div>
        <% }) %>
      </div>
    <% } %>
  </div>

  <!-- Portal Access Info -->
  <div class="student-form-card" style="max-width: none; margin-top: 24px; background: linear-gradient(to bottom, #e6f7ec, #f0fdf4); border-left: 4px solid #10b981;">
    <h3 style="color: #047857; margin-bottom: 16px;">📱 Parent Portal Access</h3>
    <div style="background: white; padding: 16px; border-radius: 8px; margin-bottom: 12px;">
      <p style="margin: 8px 0; font-size: 15px;"><strong style="color: #0f2d32;">Login Email:</strong> <span style="color: #0891b2; font-weight: 600;"><%= guardian.email || 'Not provided' %></span></p>
      <p style="margin: 8px 0; font-size: 15px;"><strong style="color: #0f2d32;">Login Phone:</strong> <span style="color: #0891b2; font-weight: 600;"><%= guardian.phone || 'Not provided' %></span></p>
    </div>
    <p style="color: #065f46; font-size: 14px; line-height: 1.6; margin-top: 12px;">
      This guardian can use either their <strong>email</strong> or <strong>phone number</strong> to log in to the Parent Portal along with their password. 
      Click the "Send Password Setup" button above to send them an email with instructions to set up their account.
    </p>
  </div>
</div>

<style>
  @media (max-width: 768px) {
    .student-management-system {
      padding: 16px !important;
    }

    .guardian-details-header {
      flex-direction: column;
      align-items: center !important;
      text-align: center;
    }

    .guardian-details-actions {
      width: 100%;
      justify-content: center;
    }

    .guardian-details-actions .primary-button,
    .guardian-details-actions .secondary-button {
      width: 100%;
      max-width: 420px;
    }

    .linked-students-grid {
      grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)) !important;
    }
  }
</style>

<script>
  function toggleEditMode() {
    const form = document.getElementById('editForm');
    form.style.display = form.style.display === 'none' ? 'block' : 'none';
  }

  async function removeStudent(studentId, studentName) {
    if (!confirm(`Are you sure you want to remove ${studentName} from this guardian? The student will remain in the system.`)) {
      return;
    }

    try {
      const response = await fetch('/common/guardianRemoveStudent', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          guardianId: <%= guardian.guardian_id %>,
          studentId: studentId
        })
      });

      const data = await response.json();

      if (data.success) {
        alert('Student removed successfully');
        window.location.reload();
      } else {
        alert('Error: ' + (data.error || 'Failed to remove student'));
      }
    } catch (error) {
      console.error('Error:', error);
      alert('Error removing student');
    }
  }

  async function requestPasswordSetup() {
    if (!confirm('Send a password setup/reset email to this guardian? They will receive instructions to set their password and log in to the Parent Portal.')) {
      return;
    }

    try {
      const response = await fetch('/common/guardianRequestPasswordReset', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          guardianId: <%= guardian.guardian_id %>
        })
      });

      const data = await response.json();

      if (data.success) {
        alert(data.message || 'Password setup email sent successfully!');
      } else {
        alert('Error: ' + (data.error || 'Failed to send password setup email'));
      }
    } catch (error) {
      console.error('Error:', error);
      alert('Error sending password setup email');
    }
  }
</script>
