<html lang="en">
  <%
    /* Font: read directly from orgDetails (same as org name/aboutus/theme) — no session needed */
    const selectedPublicFont = (orgDetails && orgDetails.font_style ? String(orgDetails.font_style).trim() : 'Inter') || 'Inter';
    const publicSerifFonts = ['PT Serif', 'Merriweather', 'Playfair Display'];
    const publicFallbackFamily = publicSerifFonts.includes(selectedPublicFont) ? 'serif' : 'sans-serif';
    const loadableGoogleFonts = ['Inter', 'Roboto', 'Open Sans', 'Lato', 'Montserrat', 'Poppins', 'Nunito', 'Raleway', 'Work Sans', 'Source Sans Pro', 'Ubuntu', 'Noto Sans', 'PT Serif', 'Merriweather', 'Playfair Display'];
    const shouldLoadPublicGoogleFont = loadableGoogleFonts.includes(selectedPublicFont);
    const normalizedPublicFont = selectedPublicFont.replace(/\s+/g, '+');
  %>
  <head>
    <meta charset="UTF-8" />
    <title><%= title %></title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <% if (shouldLoadPublicGoogleFont) { %>
      <link href="https://fonts.googleapis.com/css2?family=<%= normalizedPublicFont %>:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
    <% } %>
    <link
      href="https://cdn.quilljs.com/1.3.6/quill.snow.css"
      rel="stylesheet"
    />

    <style>
/* =========================================================
   1. GLOBAL DESIGN TOKENS & TYPOGRAPHY (BASE)
   ========================================================= */
<%
  /* Resolve org theme color for public dashboard (works even when not logged in) */
  const pdThemeColorMap = {
    teal: { primary: '#01535b', hover: '#014a51' },
    blue: { primary: '#2563eb', hover: '#1d4ed8' },
    green: { primary: '#2d5f4f', hover: '#245043' },
    purple: { primary: '#7c3aed', hover: '#6d28d9' },
    indigo: { primary: '#4f46e5', hover: '#4338ca' },
    rose: { primary: '#8b2635', hover: '#7a212e' },
    amber: { primary: '#d97706', hover: '#b45309' },
    yellow: { primary: '#eab308', hover: '#ca8a04' },
    slate: { primary: '#334155', hover: '#1e293b' },
    classic: { primary: '#01535b', hover: '#014a51' },
    bold: { primary: '#0b1020', hover: '#ffb703' },
    modern: { primary: '#2563eb', hover: '#1d4ed8' },
    minimal: { primary: '#7c3aed', hover: '#6d28d9' },
    gold: { primary: '#d4a017', hover: '#b8860b' },
    red: { primary: '#e11d48', hover: '#be123c' },
    brown: { primary: '#7c4a03', hover: '#5c3802' }
  };
  const pdOrgThemeKey = (orgDetails && orgDetails.theme_color) ? orgDetails.theme_color : 'teal';
  const pdOrgTheme = pdThemeColorMap[pdOrgThemeKey] || pdThemeColorMap.teal;
%>
:root{
  --font-family:"<%= selectedPublicFont %>",<%= publicFallbackFamily %>;
  --org-primary-color: <%= pdOrgTheme.primary %>;
  --org-primary-hover: <%= pdOrgTheme.hover %>;

  --title-xl:36px;
  --title-lg:26px;
  --title-md:20px;

  --text-base:15px;
  --text-sm:13px;

  --radius-lg:18px;
  --radius-md:14px;
  --radius-sm:10px;
}

body{ 
  font-family:var(--font-family);
}

h1{ font-size:var(--title-xl); }
h2{ font-size:var(--title-lg); }
h3{ font-size:var(--title-md); font-weight:800; }

p{
  font-size:var(--text-base);
  line-height:1.7;
  font-weight:400;
}

.content-section p{ max-width:68ch; }

/* Global mobile text sizing */
@media (max-width:768px){
  :root{
    --title-xl:28px;
    --title-lg:22px;
    --title-md:17px;
    --text-base:14px;
    --text-sm:12px;
  }
}
@media (max-width:480px){
  :root{
    --title-xl:24px;
    --title-lg:19px;
    --title-md:16px;
    --text-base:13.5px;
    --text-sm:11.5px;
  }
  .public-dashboard-container{
    width:100%;
    padding:0 12px;
  }
}

/* =========================================================
   2. BASE COMPONENTS (THEME-AGNOSTIC)
   ========================================================= */

/* Cards */
.card,
.gallery-card,
.draggable-item,
.event-card,
.announcement-card{
  border-radius:var(--radius-md);
  border:none;
  box-shadow:0 6px 18px rgba(0,0,0,0.08);
}

/* Layout containers */
.public-dashboard-container{
  position:relative;
  width:96%;
  margin:auto;
}

.public-dashboard-header{
  margin-top:50px;
}

/* Sections */
.content-section{
  margin-bottom:72px;
}


/* =========================================================
   3. CAROUSEL / HERO (BASE) — UPDATED (PROFESSIONAL + RESPONSIVE)
   Replace your existing carousel CSS with this whole block
   ========================================================= */

.custom-carousel{
  position:relative;
  width:100%;

  /* ✅ Responsive height: not too tall on desktop, good on mobile */
  height: clamp(280px, 42vw, 520px);

  overflow:hidden;
  border-radius:14px;
  margin-bottom:20px;

  box-shadow:0 18px 30px rgba(0,0,0,0.12);
  background:#01535b; /* fallback behind images */
  cursor:pointer;
}

/* School banner (kept as original if you re-enable HTML) */
.school-banner{
  position:absolute;
  top:30px;
  left:50%;
  transform:translateX(-50%);
  width:500px;
  background-color:rgba(0,0,0,0.30);
  border-radius:10px;
  padding:10px;
  z-index:4;
  display:flex;
  flex-direction:column;
  align-items:center;
  justify-content:flex-start;
  opacity:0.9;
}
.school-banner img{
  width:100%;
  max-height:230px;
  object-fit:contain;
}
.school-banner p{
  color:#fff;
  font-size:1.5rem;
  font-weight:bolder;
  text-align:center;
  margin-top:10px;
}

/* Slide structure */
.slide-container{
  height:100%;
  width:100%;
  position:relative;
}

.slide{
  position:absolute;
  inset:0;
  opacity:0;
  transition:opacity .45s ease-in-out;
  background-color: var(--org-primary-color); /* prevent blank space */
}

.slide.active{
  opacity:1;
  z-index:1;
}

.slide-image{
  width:100%;
  height:100%;
  display:flex;
  align-items:center;
  justify-content:center;
  padding:0;
  box-sizing:border-box;
}

.slide-image img{
  width:100%;
  height:100%;

  /* ✅ looks best for photos (fills hero) */
object-fit:contain;
  object-position:center;

  display:block;
}

/* Caption (clean + readable, one line) */
.slide .caption{
  position:absolute;
  left:0;
  right:0;
  bottom:0;

  padding:14px 18px;
  color:#fff;
  font-size: clamp(0.9rem, 1.2vw, 1.1rem);
  font-weight:700;
  letter-spacing:0.2px;

  background: linear-gradient(
    to top,
    rgba(0,0,0,0.78),
    rgba(0,0,0,0.25)
  );

  text-align:center;           /* ✅ centered */
  display:flex;                /* ✅ centered even when wrapped */
  justify-content:center;
  align-items:center;

  white-space: normal;         /* ✅ allow wrapping */
  overflow-wrap: anywhere;     /* ✅ break long words safely */
  line-height: 1.35;

  /* optional: prevents caption from becoming too tall */
  max-height: 28%;
  overflow: hidden;

  z-index:2;
}

/* Controls (modern size) */
.carousel-control{
  position:absolute;
  top:50%;
  transform:translateY(-50%);
  z-index:3;

  height:46px;
  width:46px;
  border-radius:12px;

  display:flex;
  align-items:center;
  justify-content:center;

  background:rgba(0,0,0,0.35);
  color:#fff;
  cursor:pointer;

  transition:transform .12s ease, background .12s ease;
}

.carousel-control:hover{
  background:rgba(0,0,0,0.55);
  transform:translateY(-50%) scale(1.05);
}

.carousel-control.prev{ left:14px; }
.carousel-control.next{ right:14px; }

/* ✅ Mobile polish */
@media (max-width:768px){
  .custom-carousel{
    height: clamp(240px, 62vw, 360px);
    border-radius:12px;
  }

  .carousel-control{
    height:32px;
    width:32px;
    border-radius:8px;
    font-size: 20px;
  }

  .slide .caption{
    padding:10px 12px;
  }

  /* Optional: smaller school banner on mobile if you enable it */
  .school-banner{
    width:180px;
    top:18px;
  }
  .school-banner img{ max-height:120px; }
  .school-banner p{ font-size:1rem; }
}


/* =========================================================
   4. MODAL (BASE)
   ========================================================= */
.modal{
  display:none;
  position:fixed;
  z-index:1000;
  left:0;
  top:0;
  width:100%;
  height:100%;
  background-color:rgba(255, 255, 255, 0.8);
  justify-content:center;
  align-items:flex-start;
  transition:opacity .3s ease;
  padding: calc(var(--header-height, 64px) + 10px) 12px 12px;
  overflow-y:auto;
}

.modal-content{
  display:flex;
  flex-direction:column;
  align-items:center;
  gap:10px;
  width: min(88%, 480px);
  height:auto;
  max-width:480px;
  max-height: calc(100vh - var(--header-height, 64px) - 28px);
  text-align:center;
  background:#ffffff;
  padding:16px 14px;
  margin-top: 80px;
  border-radius:15px;
  position:relative;
  box-shadow:0 10px 30px rgba(0,0,0,0.3);
  overflow-y:auto;
}

.modalImageContainer{
  display:flex;
  justify-content:center;
  align-items:center;
  background-color:#ffffff;
  width:100%;
  height:auto;
  max-width:100%;
  max-height:22vh;
  border-radius:8px;
  margin-bottom:8px;
  border: 1px solid rgba(15,23,42,0.08);
}
#modalImage{
  max-width:100%;
  max-height:22vh;
  border-radius:6px;
  object-fit:contain;
}

#modalCaption{
  margin-top:8px;
  font-size:0.95rem;
  line-height:1.6;
  padding:10px 0 0 0;
  text-align:left;
  color:#000000;
  overflow-y:auto;
  width:100%;
  max-height:120px;
  box-sizing:border-box;
}

.close-button{
  position:absolute;
  top:8px;
  right:12px;
  font-size:36px;
  cursor:pointer;
  font-weight:bold;
  z-index:10;
  line-height:1;
}
.close-button:hover{
  color:red;
  scale:1.1;
}

/* Modal mobile */
@media (max-width:768px){
  .modal{
    padding: calc(var(--header-height, 56px) + 8px) 10px 10px;
  }
  .modal-content{
    width: min(92%, 380px);
    padding:14px 12px;
    margin-top: 80px;
    max-height: calc(100vh - var(--header-height, 56px) - 20px);
    border-radius:12px;
  }
  .modalImageContainer{
    max-height:20vh;
  }
  #modalImage{
    max-height:20vh;
  }
  #modalCaption{
    font-size:0.8rem;
    line-height:1.4;
    max-height:78px;
    display:-webkit-box;
    line-clamp:4;
    -webkit-line-clamp:4;
    -webkit-box-orient:vertical;
    overflow:hidden;
  }
}
@media (max-width:480px){
  .modal{
    padding: calc(var(--header-height, 56px) + 6px) 8px 8px;
  }
  .modal-content{
    width: min(94%, 340px);
    padding:12px 10px;
    margin-top: 80px;
    max-height: calc(100vh - var(--header-height, 56px) - 16px);
    border-radius:10px;
  }
  .modalImageContainer{
    max-height:16vh;
  }
  #modalImage{
    max-height:16vh;
  }
  #modalCaption{
    font-size:0.74rem;
    max-height:62px;
    line-height:1.35;
    line-clamp:3;
    -webkit-line-clamp:3;
  }
  .close-button{
    font-size:26px;
    top:6px;
    right:10px;
  }
}

/* =========================================================
   5. GALLERY (BASE)
   ========================================================= */
.image-container{
  display:grid;
  grid-template-columns:repeat(auto-fit,minmax(250px,1fr));
  gap:20px;
  padding:20px 40px;
  justify-content:center;
  justify-items:center;
  max-width:90%;
  margin:0 auto;
}

/* ===============================
   CLASSIC — GALLERY GRID (UPDATED)
   Large: 4  | Medium: 3 | Small: 2
   + 1-line caption
   + extra top padding so it doesn't touch the line/header
   =============================== */

/* Give the gallery section breathing room (fixes the “touching” at the top) */
body[data-pd-theme="classic"] .content-section.wf1-section {
  padding-top: 22px !important;
}

/* Extra spacing between the title underline and the grid */
body[data-pd-theme="classic"] .content-section.wf1-section > h2 {
  margin-bottom: 18px !important;
}

/* GRID: default = LARGE (4 columns) */
body[data-pd-theme="classic"] .wf1-gallery,
body[data-pd-theme="classic"] .wf3-gallery-grid,
body[data-pd-theme="classic"] .wf4-gallery-compact,
body[data-pd-theme="classic"] .image-container {
  display: grid !important;
  grid-template-columns: repeat(4, minmax(0, 1fr)) !important;
  gap: 16px !important;

  /* keeps it from becoming too wide on big monitors */
  max-width: 1280px !important;
  margin: 0 auto !important;
  padding: 0 16px !important;
}

/* MEDIUM screens = 3 columns */
@media (max-width: 1100px) {
  body[data-pd-theme="classic"] .wf1-gallery,
  body[data-pd-theme="classic"] .wf3-gallery-grid,
  body[data-pd-theme="classic"] .wf4-gallery-compact,
  body[data-pd-theme="classic"] .image-container {
    grid-template-columns: repeat(3, minmax(0, 1fr)) !important;
    max-width: 1100px !important;
  }
}

/* SMALL screens = 2 columns */
@media (max-width: 700px) {
  body[data-pd-theme="classic"] .wf1-gallery,
  body[data-pd-theme="classic"] .wf3-gallery-grid,
  body[data-pd-theme="classic"] .wf4-gallery-compact,
  body[data-pd-theme="classic"] .image-container {
    grid-template-columns: repeat(2, minmax(0, 1fr)) !important;
    gap: 12px !important;
    padding: 0 12px !important;
  }
}

/* Cards should fill the grid cell neatly */
body[data-pd-theme="classic"] .gallery-card {
  width: 100% !important;
  max-width: none !important;
  margin: 0 !important;
  overflow: hidden !important;
  border-radius: 14px !important;
}

/* ===== Responsive image height (smooth scaling) ===== */
body[data-pd-theme="classic"] .gallery-card-image-section {
  /* fluid: grows with screen width but stays within limits */
  height: clamp(120px, 14vw, 180px) !important;
}

@media (max-width: 1100px) {
  body[data-pd-theme="classic"] .gallery-card-image-section {
    height: clamp(115px, 18vw, 170px) !important;
  }
}

@media (max-width: 700px) {
  body[data-pd-theme="classic"] .gallery-card-image-section {
    height: clamp(105px, 26vw, 150px) !important;
  }
}


body[data-pd-theme="classic"] .gallery-card-image-section img {
  width: 100% !important;
  height: 100% !important;
  object-fit: cover !important;
  display: block !important;
}

/* Caption = ONE LINE ONLY with ellipsis */
body[data-pd-theme="classic"] .gallery-card .caption {
  background: rgba(1, 83, 91, 0.88) !important;
  color: #fff !important;
  padding: 10px 12px !important;
  font-size: 0.92rem !important;
  font-weight: 600 !important;

  white-space: nowrap !important;
  overflow: hidden !important;
  text-overflow: ellipsis !important;
}

.gallery-card:hover{ transform:scale(1.03); }

.gallery-card-image-section{
  width:100%;
  height:140px;
  overflow:hidden;
}
.gallery-card-image-section img{
  width:100%;
  height:100%;
object-fit:contain;
  border-radius:10px 10px 0 0;
  cursor:pointer;
}

.gallery-card .caption{
  color:#fff;
  font-size:1rem;
  margin-top:10px;
  background:rgba(20,30,40,0.65);
  border-top:none;
  font-weight:500;
  text-align:left;
  display:-webkit-box;
  -webkit-line-clamp:2;
  -webkit-box-orient:vertical;
  overflow:hidden;
  text-overflow:ellipsis;
}

/* =========================================================
   6. ARTICLES (UPDATED)
   - Horizontal scroll (like before)
   - 3 visible on large screens
   - 2 visible on medium + small
   - Same card size + nice snapping
   ========================================================= */

/* Apply the same horizontal scroll behavior to ALL article containers */
.text-container,
.wf1-articles,
.wf2-articles-scroll,
.wf3-articles-masonry,
.wf4-stories-grid{
  display:flex;
  gap:16px;
  overflow-x:auto;
  overflow-y:hidden;
  scroll-behavior:smooth;
  -webkit-overflow-scrolling:touch;

  padding: 12px 16px 18px;
  margin: 0 auto;
  max-width: 1280px;

  /* optional: feels premium */
  scroll-snap-type: x mandatory;
}

/* 3 cards visible on large screens */
.text-container .draggable-item,
.wf1-articles .draggable-item,
.wf2-articles-scroll .draggable-item,
.wf3-articles-masonry .draggable-item,
.wf4-stories-grid .draggable-item{
  flex: 0 0 calc((100% - 32px) / 3); /* 3 cards with 2 gaps */
  min-width: 320px;                 /* protects small laptop widths */
  max-width: 420px;                 /* prevents huge cards on big monitors */

  height: 420px;                    /* same height always */
  background:#fff;
  border-radius:14px;
  box-shadow:0 6px 18px rgba(0,0,0,0.10);
  padding:18px;

  display:flex;
  flex-direction:column;
  align-items:stretch;

  scroll-snap-align: start;
}

/* 2 cards on medium + small */
@media (max-width: 1100px){
  .text-container .draggable-item,
  .wf1-articles .draggable-item,
  .wf2-articles-scroll .draggable-item,
  .wf3-articles-masonry .draggable-item,
  .wf4-stories-grid .draggable-item{
    flex: 0 0 calc((100% - 16px) / 2); /* 2 cards with 1 gap */
    max-width: 520px;
    height: 400px;
  }
}

@media (max-width: 700px){
  .text-container,
  .wf1-articles,
  .wf2-articles-scroll,
  .wf3-articles-masonry,
  .wf4-stories-grid{
    gap:12px;
    padding: 10px 12px 16px;
  }

  .text-container .draggable-item,
  .wf1-articles .draggable-item,
  .wf2-articles-scroll .draggable-item,
  .wf3-articles-masonry .draggable-item,
  .wf4-stories-grid .draggable-item{
    flex: 0 0 calc((100% - 12px) / 2);
    min-width: 260px;
    height: 360px;
    padding:14px;
  }
}

/* Title styling */
.draggable-item h3{
  margin:0 0 10px 0;
  color:#01535b;
  font-size:1.15rem;
  font-weight:800;
  text-align:center;
  line-height:1.25;

  display:-webkit-box;
  -webkit-line-clamp:2;     /* keeps title neat */
  -webkit-box-orient:vertical;
  overflow:hidden;
}

/* Make the article body scroll INSIDE the card */
.draggable-item .ql-editor{
  flex:1;
  overflow-y:auto;
  overflow-x:hidden;

  padding: 12px;
  border-radius:10px;
  background: #fbfbfb;

  font-size:1rem;
  line-height:1.65;
  color:#333;
}

/* Nice scrollbar */
.draggable-item .ql-editor::-webkit-scrollbar{ width:8px; }
.draggable-item .ql-editor::-webkit-scrollbar-track{
  background:#e9e9e9; border-radius:10px;
}
.draggable-item .ql-editor::-webkit-scrollbar-thumb{
  background:#01535b; border-radius:10px;
}

/* =========================================================
   7. EVENTS + ANNOUNCEMENTS + ABOUT (FINAL)
   ✅ Fixed sizes
   ✅ Long text scrolls INSIDE cards
   ✅ Page scroll stays normal on small screens
   ✅ NO hover effects
   ✅ Announcements are smaller
   ✅ About aligned like the rest (no cornering)
   ========================================================= */

/* Consistent content width like Gallery */
body[data-pd-theme="classic"] .content-section{
  max-width:1280px;
  margin:0 auto 72px auto;
  padding:0 16px;
}

/* Headings aligned (no corner/indent) */
body[data-pd-theme="classic"] .content-section > h2{
  margin:0 0 18px 0 !important;
  text-align:left;
  font-size:1.8rem;
  color:#222;
  border-bottom:3px solid #01535b;
  padding-bottom:8px;
}

/* Horizontal scroller (Events + Announcements) */
.events-section,
.announcements-section,
.wf1-events,
.wf1-announcements,
.wf2-events-priority,
.wf2-announcements-list,
.wf3-events-grid,
.wf3-announcements-feed,
.wf4-announcements-grid{
  display:flex;
  gap:16px;

  overflow-x:auto;
  overflow-y:visible;                 /* ✅ don't trap vertical scrolling */
  -webkit-overflow-scrolling:touch;
  scroll-behavior:smooth;

  padding:10px 0;
  justify-content:flex-start;
  align-items:stretch;

  touch-action: pan-x pan-y;             /* ✅ allow both horizontal and vertical scrolling */
}

/* Optional snapping feel (safe) */
.events-section,
.announcements-section,
.wf1-events,
.wf1-announcements{
  scroll-snap-type:x mandatory;
}
.event-card,
.announcement-card{
  scroll-snap-align:start;
}

/* =========================
   FIXED SIZE CARDS
   ========================= */

/* Events (normal size) */
.event-card{
  flex:0 0 420px;
  height:240px;
  background:#fff;
  border-radius:14px;
  padding:18px;
  box-shadow:0 6px 15px rgba(0,0,0,0.12);

  display:flex;
  flex-direction:column;
  overflow:hidden;
  color:#222;
}

/* Announcements (smaller) */
.announcement-card{
  flex:0 0 320px;      /* ✅ smaller width */
  height:190px;        /* ✅ smaller height */
  background:#fff;
  border-radius:14px;
  padding:12px;        /* ✅ tighter padding */
  box-shadow:0 6px 15px rgba(0,0,0,0.12);

  display:flex;
  flex-direction:column;
  overflow:hidden;
  color:#222;
}

/* NO hover effects */
.event-card:hover,
.announcement-card:hover{
  transform:none !important;
}

/* Titles */
.event-card h3,
.announcement-card h3{
  font-size:1.15rem;
  color:#01535b;
  margin:0 0 10px 0;
  line-height:1.25;
  flex:0 0 auto;
}

/* Text */
