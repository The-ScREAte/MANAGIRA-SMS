/* =========================================================
   7. EVENTS + ANNOUNCEMENTS + ABOUT (FINAL)
   ✅ Fixed sizes
   ✅ Long text scrolls INSIDE cards
   ✅ Page scroll stays normal on small screens
   ✅ NO hover effects
   ✅ Announcements are smaller
   ✅ About aligned like the rest (no cornering)
   ========================================================= */

/* Consistent content width like Gallery */
body[data-pd-theme="classic"] .content-section{
  max-width:1280px;
  margin:0 auto 72px auto;
  padding:0 16px;
}

/* Headings aligned (no corner/indent) */
body[data-pd-theme="classic"] .content-section > h2{
  margin:0 0 18px 0 !important;
  text-align:left;
  font-size:1.8rem;
  color:#222;
  border-bottom:3px solid #01535b;
  padding-bottom:8px;
}

/* Horizontal scroller (Events + Announcements) */
.events-section,
.announcements-section,
.wf1-events,
.wf1-announcements,
.wf2-events-priority,
.wf2-announcements-list,
.wf3-events-grid,
.wf3-announcements-feed,
.wf4-announcements-grid{
  display:flex;
  gap:16px;

  overflow-x:auto;
  overflow-y:visible;                 /* ✅ don't trap vertical scrolling */
  -webkit-overflow-scrolling:touch;
  scroll-behavior:smooth;

  padding:10px 0;
  justify-content:flex-start;
  align-items:stretch;

  touch-action: pan-x pan-y;             /* ✅ allow both horizontal and vertical scrolling */
}

/* Optional snapping feel (safe) */
.events-section,
.announcements-section,
.wf1-events,
.wf1-announcements{
  scroll-snap-type:x mandatory;
}
.event-card,
.announcement-card{
  scroll-snap-align:start;
}

/* =========================
   FIXED SIZE CARDS
   ========================= */

/* Events (normal size) */
.event-card{
  flex:0 0 420px;
  height:240px;
  background:#fff;
  border-radius:14px;
  padding:18px;
  box-shadow:0 6px 15px rgba(0,0,0,0.12);

  display:flex;
  flex-direction:column;
  overflow:hidden;
  color:#222;
}

/* Announcements (smaller) */
.announcement-card{
  flex:0 0 320px;      /* ✅ smaller width */
  height:190px;        /* ✅ smaller height */
  background:#fff;
  border-radius:14px;
  padding:12px;        /* ✅ tighter padding */
  box-shadow:0 6px 15px rgba(0,0,0,0.12);

  display:flex;
  flex-direction:column;
  overflow:hidden;
  color:#222;
}

/* NO hover effects */
.event-card:hover,
.announcement-card:hover{
  transform:none !important;
}

/* Titles */
.event-card h3,
.announcement-card h3{
  font-size:1.15rem;
  color:#01535b;
  margin:0 0 10px 0;
  line-height:1.25;
  flex:0 0 auto;
}

/* Text */
.event-card p,
.announcement-card p{
  margin:0;
  font-size:1rem;
  color:#555;
  line-height:1.55;
}

/* ✅ Event details scroll inside card */
.event-card p:last-of-type{
  margin-top:10px;
  flex:1 1 auto;
  overflow:auto;
  padding-right:6px;
  touch-action: pan-x pan-y;
  overscroll-behavior: auto;
}

/* ✅ Announcement message scroll inside card */
.announcement-card p{
  flex:1 1 auto;
  overflow:auto;
  padding-right:6px;
  touch-action: pan-x pan-y;
  overscroll-behavior: auto;

  font-size:0.95rem;   /* ✅ slightly smaller text */
  line-height:1.5;
}

/* Inside-card scrollbar */
.event-card p:last-of-type::-webkit-scrollbar,
.announcement-card p::-webkit-scrollbar{
  width:8px;
}
.event-card p:last-of-type::-webkit-scrollbar-thumb,
.announcement-card p::-webkit-scrollbar-thumb{
  background:var(--wf-scroll-thumb);
  border-radius:10px;
}

/* Horizontal scrollbar styling */
.events-section::-webkit-scrollbar,
.announcements-section::-webkit-scrollbar,
.wf1-events::-webkit-scrollbar,
.wf1-announcements::-webkit-scrollbar{
  height:8px;
}
.events-section::-webkit-scrollbar-track,
.announcements-section::-webkit-scrollbar-track,
.wf1-events::-webkit-scrollbar-track,
.wf1-announcements::-webkit-scrollbar-track{
  background:var(--wf-scroll-track);
  border-radius:10px;
}
.events-section::-webkit-scrollbar-thumb,
.announcements-section::-webkit-scrollbar-thumb,
.wf1-events::-webkit-scrollbar-thumb,
.wf1-announcements::-webkit-scrollbar-thumb{
  background:var(--wf-scroll-thumb);
  border-radius:10px;
}

/* =========================
   ABOUT (aligned + clean)
   ========================= */
#about-us{
  max-width:1280px;
  margin:0 auto 72px auto;
  padding:0 16px;
}

#about-us p,
body[data-pd-theme="classic"] .content-section.wf1-section#about-us > p{
