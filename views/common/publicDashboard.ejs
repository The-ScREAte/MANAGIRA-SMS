    grid-column:1;
  }

  body[data-page="publicDashboard"] .event-card.wf2-event-badge .wf2-event-content p,
  body[data-page="publicDashboard"] .announcement-card.wf2-announcement-badge p{
    font-size:0.82rem !important;
    line-height:1.36 !important;
    margin-top:6px !important;
    display:block !important;
    overflow-y:auto !important;
    overflow-x:hidden !important;
    -webkit-overflow-scrolling:touch;
    overscroll-behavior:auto;
    touch-action:pan-x pan-y;
    min-height:0 !important;
    flex:1 1 auto !important;
    max-height:100% !important;
    padding-right:3px;
    scrollbar-width:thin;
  }

  body[data-page="publicDashboard"] .announcement-card.wf2-announcement-badge p{
    overflow-y:auto !important;
    overflow-x:hidden !important;
    flex:1 1 auto !important;
    max-height:100% !important;
    margin-top:4px !important;
    grid-column:2;
    min-width:0 !important;
    width:100%;
    white-space:normal !important;
    overflow-wrap:anywhere;
    word-break:break-word;
    line-break:auto;
    text-indent:0;
  }

  body[data-page="publicDashboard"] .event-card.wf2-event-badge .wf2-event-content p::-webkit-scrollbar,
  body[data-page="publicDashboard"] .announcement-card.wf2-announcement-badge p::-webkit-scrollbar{
    width:5px;
  }

  body[data-page="publicDashboard"] .event-card.wf2-event-badge .wf2-event-content p::-webkit-scrollbar-thumb,
  body[data-page="publicDashboard"] .announcement-card.wf2-announcement-badge p::-webkit-scrollbar-thumb{
    background:rgba(71, 85, 105, 0.45);
    border-radius:999px;
  }
}

/* Final WF2 caption guard: strict two-line preview on all screens */
body[data-page="publicDashboard"] .wf2-gallery-masonry .gallery-card .caption,
body[data-page="publicDashboard"] .wf2-gallery-masonry .gallery-card.wf2-gallery-item .caption{
  box-sizing:border-box !important;
  display:-webkit-box !important;
  line-clamp:2 !important;
  -webkit-line-clamp:2 !important;
  -webkit-box-orient:vertical !important;
  white-space:normal !important;
  overflow:hidden !important;
  text-overflow:ellipsis !important;
}

/* Large screens: improve readability while keeping strict 2-line clamp */
@media (min-width: 1101px){
  body[data-page="publicDashboard"] .wf2-gallery-masonry .gallery-card .caption,
  body[data-page="publicDashboard"] .wf2-gallery-masonry .gallery-card.wf2-gallery-item .caption{
    padding:10px 12px !important;
    line-height:1.34 !important;
  }
}

@media (max-width: 480px){
  body[data-page="publicDashboard"] .wf2-gallery-masonry .gallery-card .caption,
  body[data-page="publicDashboard"] .wf2-gallery-masonry .gallery-card.wf2-gallery-item .caption{
    padding:7px 9px !important;
  }
}

/* Small screens: show one WF2 card per swipe/view */
@media screen and (max-width: 900px){
  body[data-page="publicDashboard"] .wf2-right-events,
  body[data-page="publicDashboard"] .wf2-right-announcements,
  body[data-page="publicDashboard"] .wf2-articles-section{
    position: relative;
  }

  body[data-page="publicDashboard"] .wf2-events-priority,
  body[data-page="publicDashboard"] .wf2-announcements-list,
  body[data-page="publicDashboard"] .wf2-articles-scroll{
    padding-inline: 0 !important;
    gap: 10px !important;
    scroll-padding-inline: 0 !important;
  }

  body[data-page="publicDashboard"] .event-card.wf2-event-badge,
  body[data-page="publicDashboard"] .announcement-card.wf2-announcement-badge,
  body[data-page="publicDashboard"] .wf2-articles-scroll .draggable-item{
    min-width: 100% !important;
    max-width: 100% !important;
    flex: 0 0 100% !important;
    margin-inline: 0 !important;
  }

  body[data-page="publicDashboard"] .wf2-articles-scroll .draggable-item.wf2-article-card{
    min-width: 100% !important;
    max-width: 100% !important;
    flex: 0 0 100% !important;
    margin-inline: 0 !important;
  }

  body[data-page="publicDashboard"] .wf2-right-events.has-right-scroll-hint::after,
  body[data-page="publicDashboard"] .wf2-right-announcements.has-right-scroll-hint::after,
  body[data-page="publicDashboard"] .wf2-articles-section.has-right-scroll-hint::after{
    content: '';
    position: absolute;
    right: 6px;
    top: calc(50% + 12px);
    transform: translateY(-50%);
    width: 9px;
    height: 54px;
    border-radius: 999px;
    display: block;
    background: linear-gradient(180deg, rgba(1, 83, 91, 0.78) 0%, rgba(1, 83, 91, 0.2) 100%);
    box-shadow: 0 3px 12px rgba(15, 23, 42, 0.12);
    pointer-events: none;
    z-index: 4;
    animation: wf2-scroll-hint-blink 1.1s ease-in-out infinite;
  }
}

@keyframes wf2-scroll-hint-blink {
  0%,
  100% { opacity: 0.28; }
  50% { opacity: 1; }
}

/* Modal polish: org-color glass look + centered caption + larger image preview */
body[data-page="publicDashboard"] .modal{
  background:
    radial-gradient(circle at 18% 18%, color-mix(in srgb, var(--org-primary-color, #01535b) 24%, transparent) 0%, transparent 46%),
    radial-gradient(circle at 82% 78%, color-mix(in srgb, var(--org-primary-color, #01535b) 18%, transparent) 0%, transparent 50%),
    rgba(9, 16, 27, 0.54) !important;
  backdrop-filter: blur(6px);
}

body[data-page="publicDashboard"] .modal-content{
  background:
    linear-gradient(
      145deg,
      color-mix(in srgb, var(--org-primary-color, #01535b) 16%, white) 0%,
      color-mix(in srgb, var(--org-primary-color, #01535b) 8%, white) 100%
    ) !important;
  border: 1px solid color-mix(in srgb, var(--org-primary-color, #01535b) 40%, white) !important;
  box-shadow:
    0 18px 44px rgba(2, 6, 23, 0.34),
    inset 0 1px 0 rgba(255, 255, 255, 0.42) !important;
  backdrop-filter: blur(14px) saturate(130%);
  margin-inline: auto !important;
  width: min(94%, 560px) !important;
  max-height: calc(100dvh - var(--header-height, 64px) - 22px) !important;
  overflow: hidden !important;
  box-sizing: border-box;
}

body[data-page="publicDashboard"] .modalImageContainer{
  width: 100%;
  max-height: 48vh;
  background: linear-gradient(
    160deg,
    color-mix(in srgb, var(--org-primary-color, #01535b) 14%, white),
    rgba(255, 255, 255, 0.92)
  );
  border: 1px solid color-mix(in srgb, var(--org-primary-color, #01535b) 32%, white);
  border-radius: 12px;
  overflow: hidden;
  padding: 8px;
}

body[data-page="publicDashboard"] #modalImage{
  max-height: 48vh;
  width: auto;
  max-width: 100%;
  object-fit: contain;
  display: block;
}

body[data-page="publicDashboard"] #modalCaption{
  text-align: center !important;
  color: color-mix(in srgb, var(--org-primary-color, #01535b) 76%, black);
  background: color-mix(in srgb, var(--org-primary-color, #01535b) 9%, white);
  border: 1px solid color-mix(in srgb, var(--org-primary-color, #01535b) 24%, white);
  border-radius: 10px;
  padding: 12px 14px;
  width: 100%;
  margin-top: 6px;
  overflow-y: auto !important;
  overflow-x: hidden;
  max-height: min(22vh, 190px);
  display: block !important;
  line-clamp: unset !important;
  -webkit-line-clamp: unset !important;
  -webkit-box-orient: initial !important;
  -webkit-overflow-scrolling: touch;
  white-space: normal;
  overflow-wrap: anywhere;
}

@media (max-width:768px){
  body[data-page="publicDashboard"] .modal-content{
    width: min(94%, 420px) !important;
    max-height: calc(100dvh - var(--header-height, 56px) - 16px) !important;
  }

  body[data-page="publicDashboard"] .modalImageContainer,
  body[data-page="publicDashboard"] #modalImage{
    max-height: 44vh;
  }

  body[data-page="publicDashboard"] #modalCaption{
    max-height: min(21vh, 150px);
  }
}

@media (max-width:480px){
  body[data-page="publicDashboard"] .modal-content{
    width: min(95%, 360px) !important;
    max-height: calc(100dvh - var(--header-height, 56px) - 12px) !important;
  }

  body[data-page="publicDashboard"] .modalImageContainer,
  body[data-page="publicDashboard"] #modalImage{
    max-height: 40vh;
  }

  body[data-page="publicDashboard"] #modalCaption{
    max-height: min(20vh, 130px);
    font-size: 0.86rem;
    line-height: 1.4;
  }
}

@media (prefers-reduced-motion:reduce){
  .registration-cta__dot,
  .registration-cta__button{
    animation:none;
  }
}

</style>

  </head>
  <body data-page="publicDashboard" data-pd-theme="<%= ({ amber: 'gold', rose: 'red', indigo: 'bold', slate: 'bold' }[String(publicDashboardTheme || 'classic').toLowerCase()] || publicDashboardTheme || 'classic') %>" data-pd-layout="<%= publicDashboardLayout || 'wireframe1' %>">
    <%- include('../partials/header') %>
    <%- include('../partials/flash') %>
    <% if (req.query.success === '1') { %>
      <div class="alert alert-success">Registration and payment completed successfully!</div>
    <% } %>
    
    <div class="public-dashboard-container">
      <div class="public-dashboard-header"></div>
      <%
        const schoolMotto = String(orgDetails?.motto || '').trim();
      %>

      <section class="school-identity-card" aria-label="School identity">
        <span class="school-identity-kicker">Official School Website</span>
        <h1 class="school-identity-title"><%= orgDetails?.organization_name || 'School' %></h1>
        <p class="school-identity-subtitle">
          <%= schoolMotto || 'Building excellence every day.' %>
        </p>
      </section>

      <!-- 🔹 Image Modal -->
      <div id="imageModal" class="modal">
        <div class="modal-content">
          <span class="close-button">&times;</span>
          <div class="modalImageContainer">
            <img id="modalImage" src="" alt="Full Image" />
          </div>
          <div id="modalCaption"></div>
        </div>
      </div>

      <!-- Slideshow Section -->
      <% if (slideshowImages.length > 0) { %>
      <div class="custom-carousel" id="carouselExample">
        <!-- <div class="school-banner">
          <img src="<%= orgDetails.logo %>" alt="school logo" />
          <p><%= orgDetails.motto %></p>
        </div> -->
        <% slideshowImages.forEach((slide, index) => { %>
        <div class="slide <%= index === 0 ? 'active' : '' %>">
          <div class="slide-container">
            <div class="slide-image">
              <img src="<%= slide.image_url %>" alt="Slideshow Image" />
            </div>
          </div>
          <div class="caption <%= index === 0 ? 'active' : '' %>">
            <%= slide.caption %>
          </div>
        </div>
        <% }); %>
        <button
          type="button"
          class="carousel-control prev"
          id="carouselPrevBtn"
          aria-label="Previous slide"
        >
          <svg class="carousel-arrow" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path d="M15 5l-7 7 7 7" />
          </svg>
        </button>
        <button
          type="button"
          class="carousel-control next"
          id="carouselNextBtn"
          aria-label="Next slide"
        >
          <svg class="carousel-arrow" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path d="M9 5l7 7-7 7" />
          </svg>
        </button>
      </div>
      <% } %>
      <%
      const now = new Date(); 
      const startDate = orgDetails?.registration_start_date ? new Date(orgDetails.registration_start_date) : null;
      const endDate = orgDetails?.registration_end_date ? new Date(orgDetails.registration_end_date) : null;
      const isEnabled = orgDetails?.public_registration_enabled;
      const isWithinRange = startDate && endDate && startDate <= now && now <= endDate;
      const orgId = orgDetails?.organization_id;
      const registrationEndLabel = endDate
        ? endDate.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })
        : '';
      const registrationRangeLabel = startDate && endDate
        ? `${startDate.toLocaleDateString('en-US', { month: 'short', day: 'numeric' })} - ${endDate.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}`
        : '';
    %>
    
    <% if (isEnabled && isWithinRange && orgId) { %>
      <section class="registration-cta" aria-label="Open admissions">
        <div class="registration-cta__card">
          <div class="registration-cta__content">
            <span class="registration-cta__eyebrow">
              <span class="registration-cta__dot" aria-hidden="true"></span>
              Admissions Open
            </span>
            <h2 class="registration-cta__title">Now accepting new applications.</h2>
            <p class="registration-cta__summary">
              Apply online before <strong><%= registrationEndLabel %></strong>.
            </p>
          </div>

          <div class="registration-cta__meta">
            <a
              id="registerNowBtn"
              class="registration-cta__button"
              href="/common/publicRegister?organizationId=<%= orgDetails.organization_id %>"
              aria-label="Start registration for <%= orgDetails.organization_name || 'this school' %> between <%= registrationRangeLabel %>"
            >
              Apply Now
              <span class="registration-cta__button-arrow" aria-hidden="true">&rarr;</span>
            </a>
          </div>
        </div>
      </section>
    <% } else if (!orgId) { %>
      <p class="registration-cta__fallback">Missing organization ID — registration link is not available.</p>
    <% } %>
    
      <!-- Container for all draggable sections -->
      <div id="dashboard-sections"></div>

      <% const pdLayout = (publicDashboardLayout || 'wireframe1'); %>
        <% const aboutMottos = (aboutDetails && Array.isArray(aboutDetails.mottos) ? aboutDetails.mottos : [])
          .map((value) => String(value || '').trim())
          .filter(Boolean);
        %>
        <% const aboutEmails = (aboutDetails && Array.isArray(aboutDetails.emails) ? aboutDetails.emails : [])
          .map((value) => String(value || '').trim())
          .filter(Boolean);
        %>
        <% const aboutPhones = (aboutDetails && Array.isArray(aboutDetails.phones) ? aboutDetails.phones : [])
          .map((value) => String(value || '').trim())
          .filter(Boolean);
        %>
        <% if (!aboutMottos.length && orgDetails?.motto) { aboutMottos.push(orgDetails.motto); } %>
        <% const aboutMotto = aboutMottos.length ? aboutMottos[0] : ''; %>
        <% if (!aboutEmails.length && orgDetails?.email) { aboutEmails.push(orgDetails.email); } %>
        <% if (!aboutPhones.length && orgDetails?.organization_phone) { aboutPhones.push(orgDetails.organization_phone); } %>

      <% if (pdLayout === 'wireframe1') { %>
        <!-- WIREFRAME 1: Linear / Traditional School Website - Simple vertical flow -->
        
        <!-- Gallery -->
        <div class="content-section wf1-section" id="image-gallery">
          <h2>Campus Gallery 📷</h2>
          <div class="wf1-gallery">
            <% orderedItems.filter(item => item.id === 'image-gallery').forEach(item => { %>
              <% item.data.forEach(image => { %>
                <div class="gallery-card">
                  <div class="gallery-card-image-section">
                    <img src="<%= image.image_url %>" alt="Content Image" />
                  </div>
                  <div class="caption"><%= image.caption %></div>
                </div>
              <% }); %>
            <% }); %>
          </div>
        </div>

        <!-- Articles (Simple cards) -->
        <div class="content-section wf1-section" id="text-articles">
          <h2>School Highlights 📝</h2>
          <div class="wf1-articles">
            <% orderedItems.filter(item => item.id === 'text-articles').forEach(item => { %>
              <% item.data.forEach(text => { %>
                <div class="draggable-item wf1-article-card">
                  <h3><%= text.heading %></h3>
                  <div class="ql-editor"><%- text.paragraph %></div>
                </div>
              <% }); %>
            <% }); %>
          </div>
        </div>

        <!-- Events (Simple list) -->
        <div class="content-section wf1-section" id="events">
          <h2>Upcoming Events</h2>
          <div class="wf1-events">
            <% orderedItems.filter(item => item.type === 'events').forEach(item => { %>
              <% item.data.forEach((event) => { %>
                <div class="event-card wf1-event-card">
                  <h3><%= event.name %></h3>
                  <p><strong>Date:</strong> <%= new Date(event.event_date).toISOString().split('T')[0] %></p>
                  <p><%= event.details %></p>
                </div>
              <% }); %>
            <% }); %>
          </div>
        </div>

        <!-- Announcements -->
        <div class="content-section wf1-section" id="announcements">
          <h2>Notices & Announcements 📢</h2>
          <div class="wf1-announcements">
            <% orderedItems.filter(item => item.type === 'announcements').forEach(item => { %>
              <% item.data.forEach((announcement) => { %>
                <% if (announcement.visibility === "public" || announcement.visibility === "both") { %>
                  <div class="announcement-card">
                    <p><%= announcement.message %></p>
                  </div>
                <% } %>
              <% }); %>
            <% }); %>
          </div>
        </div>

        <!-- About Us -->
        <div class="content-section wf1-section" id="about-us">
          <h2>About the School</h2>
          <div class="about-school-split">
            <% if (aboutMotto) { %>
              <div class="about-motto-row">
                <span class="about-motto-label">Motto</span>
                <span class="about-motto-text"><%= aboutMotto %></span>
              </div>
            <% } %>
            <div class="about-school-main">
              <p><%= orgDetails.aboutus %></p>
            </div>
            <div class="about-school-side">
              <% if (aboutEmails.length) { %>
                <div class="about-meta-block">
                  <ul class="about-inline-list">
                    <% aboutEmails.forEach((item) => { %>
                      <li class="about-inline-item"><span class="about-inline-label">Email</span><span class="about-inline-text"><%= item %></span></li>
                    <% }); %>
                  </ul>
                </div>
              <% } %>
              <% if (aboutPhones.length) { %>
                <div class="about-meta-block">
                  <ul class="about-inline-list">
                    <% aboutPhones.forEach((item) => { %>
                      <li class="about-inline-item"><span class="about-inline-label">Phone</span><span class="about-inline-text"><%= item %></span></li>
                    <% }); %>
                  </ul>
                </div>
              <% } %>
              <% if (orgDetails && orgDetails.organization_address) { %>
                <div class="about-meta-block">
                  <ul class="about-inline-list">
                    <li class="about-inline-item"><span class="about-inline-label">Address</span><span class="about-inline-text"><%= [orgDetails.organization_address, orgDetails.organization_province, orgDetails.organization_country].filter(Boolean).join(', ') %></span></li>
                  </ul>
                </div>
              <% } %>
            </div>
          </div>
        </div>

      <% } else if (pdLayout === 'wireframe2') { %>
        <!-- WIREFRAME 2: Split Dashboard - Gallery LEFT + Events RIGHT -->
        
        <!-- Top Split: Gallery (Left) + Events/Announcements (Right) -->
        <div class="wf2-hero-split">
          <div class="wf2-left-panel" id="image-gallery">
            <h2>Campus Gallery 📷</h2>
            <div class="wf2-gallery-masonry">
              <% orderedItems.filter(item => item.id === 'image-gallery').forEach(item => { %>
                <% item.data.forEach(image => { %>
                  <div class="gallery-card wf2-gallery-item">
                    <div class="gallery-card-image-section">
                      <img src="<%= image.image_url %>" alt="Content Image" />
                    </div>
                    <div class="caption"><%= image.caption %></div>
                  </div>
                <% }); %>
              <% }); %>
            </div>
          </div>

          <div class="wf2-right-panel" id="events">
            <div class="wf2-right-block wf2-right-events">
              <h2>⚡ Upcoming Events</h2>
              <div class="wf2-events-priority">
                <% orderedItems.filter(item => item.type === 'events').forEach(item => { %>
                  <% item.data.forEach((event) => { %>
                    <div class="event-card wf2-event-badge">
                      <div class="wf2-event-content">
                        <div class="wf2-event-heading-row">
                          <h3><%= event.name %></h3>
                          <span class="wf2-event-date-badge">
                            <%= new Date(event.event_date).toLocaleDateString('en-US', { month: 'short', day: 'numeric' }) %>
                          </span>
                        </div>
                        <p><%= event.details %></p>
                      </div>
                    </div>
                  <% }); %>
                <% }); %>
              </div>
            </div>

            <div class="wf2-right-block wf2-right-announcements" id="announcements">
              <h2>📢 Notices & Announcements</h2>
              <div class="wf2-announcements-list">
                <% orderedItems.filter(item => item.type === 'announcements').forEach(item => { %>
                  <% item.data.forEach((announcement) => { %>
                    <% if (announcement.visibility === "public" || announcement.visibility === "both") { %>
                      <div class="announcement-card wf2-announcement-badge">
                        <span class="wf2-announcement-icon">🔔</span>
                        <p><%= announcement.message %></p>
                      </div>
                    <% } %>
                  <% }); %>
                <% }); %>
              </div>
            </div>
          </div>
