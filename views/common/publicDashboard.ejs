}

.wf4-timeline-card h3 {
  margin: 0 0 6px;
  font-size: 1.05rem;
}
.wf4-timeline-card p {
  margin: 0;
  font-size: 0.9rem;
  line-height: 1.55;
  color: #555;
}

/* Announcements Grid */
.wf4-announcements-section {
  max-width: 1280px;
  margin: 0 auto 56px;
  padding: 0 24px;
}
.wf4-announcements-section h2 {
  margin: 0 0 20px;
  font-size: 1.5rem;
  font-weight: 900;
}

.wf4-announcements-grid {
