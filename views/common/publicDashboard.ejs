/* =========================================================
   8. THEME LAYER
   ONLY Classic is ACTIVE.
   Other themes are COMMENTED and we’ll do later.
   ========================================================= */

/* -------- Classic (CURRENT / ORIGINAL) -------- */
body[data-pd-theme="classic"]{
  background:#ffffff;
  color:#222;
}

/* =========================================================
   MODERN (LIGHT BLUE) THEME — UPDATED (AFFECTS HERO TOO)
   Activates only when data-pd-theme="modern"
   ========================================================= */

body[data-pd-theme="modern"]{
  background: linear-gradient(180deg, #eaf6ff 0%, #f7fbff 55%, #ffffff 100%);
  color:#0f172a;
}

/* Same widths + spacing */
body[data-pd-theme="modern"] .content-section{
  max-width:1280px;
  margin:0 auto 72px auto;
  padding:0 16px;
}

/* Headings */
body[data-pd-theme="modern"] .content-section > h2{
  margin:0 0 18px 0;
  text-align:left;
  font-size:1.85rem;
  font-weight:900;
  letter-spacing:0.2px;

  color:#0b3a67;
  border-bottom:4px solid #38bdf8; /* sky */
  padding-bottom:10px;
}

/* =========================================================
   HERO (Carousel area + top header + register button)
   ========================================================= */

/* Reduce the “empty” feel at top + make it feel like a hero zone */
body[data-pd-theme="modern"] .public-dashboard-header{
  margin-top:34px; /* slightly tighter than classic */
}

/* HERO wrapper: adds a soft glow behind the carousel section */
body[data-pd-theme="modern"] #carouselExample{
  position:relative;
}

/* Carousel: light-blue glass frame */
body[data-pd-theme="modern"] .custom-carousel{
  background: radial-gradient(circle at 20% 0%, rgba(56,189,248,0.45), rgba(14,165,233,0.25), rgba(2,132,199,0.12));
  border: 1px solid rgba(56,189,248,0.45);
  box-shadow: 0 20px 50px rgba(2,132,199,0.22);
}

/* Slide background so blank space looks premium while images load */
body[data-pd-theme="modern"] .slide{
  background: linear-gradient(135deg, rgba(2,132,199,0.20), rgba(14,165,233,0.10));
}

/* Caption: modern glass ribbon */
body[data-pd-theme="modern"] .slide .caption{
  background: linear-gradient(to top, rgba(2,132,199,0.90), rgba(2,132,199,0.25));
  font-weight: 800;
  letter-spacing: 0.2px;
}

/* Carousel controls: sky buttons */
body[data-pd-theme="modern"] .carousel-control{
  background: rgba(14,165,233,0.25);
  border: 1px solid rgba(56,189,248,0.55);
  color:#fff;
}
body[data-pd-theme="modern"] .carousel-control:hover{
  background: rgba(14,165,233,0.40);
}

/* Optional: if you ever re-enable the school banner, make it match */
body[data-pd-theme="modern"] .school-banner{
  background: rgba(2,132,199,0.28);
  border: 1px solid rgba(56,189,248,0.45);
  backdrop-filter: blur(10px);
}
body[data-pd-theme="modern"] .school-banner p{
  text-shadow: 0 2px 10px rgba(0,0,0,0.25);
}

/* Register button “hero CTA” polish */
body[data-pd-theme="modern"] .blinking-btn{
  background: linear-gradient(90deg, #0ea5e9, #38bdf8);
  color:#ffffff;
  border: none;
  border-radius: 14px;
  padding: 14px 18px;
  font-weight: 900;
  box-shadow: 0 16px 30px rgba(2,132,199,0.24);
  cursor:pointer;
}
body[data-pd-theme="modern"] .blinking-btn:hover{
  transform: translateY(-1px);
  box-shadow: 0 18px 34px rgba(2,132,199,0.28);
}

/* =========================================================
   Cards (Gallery/Articles/Events/Announcements)
   ========================================================= */

body[data-pd-theme="modern"] .card,
body[data-pd-theme="modern"] .gallery-card,
body[data-pd-theme="modern"] .draggable-item,
body[data-pd-theme="modern"] .event-card,
body[data-pd-theme="modern"] .announcement-card{
  background: rgba(255,255,255,0.92);
  border: 1px solid rgba(56,189,248,0.35);
  box-shadow: 0 14px 30px rgba(2, 132, 199, 0.14);
