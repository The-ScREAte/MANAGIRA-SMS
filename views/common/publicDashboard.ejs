  }

  body[data-page="publicDashboard"] .event-card.wf2-event-badge .wf2-event-content,
  body[data-page="publicDashboard"] .announcement-card.wf2-announcement-badge .wf2-event-content{
    display:flex !important;
    flex-direction:column !important;
    min-height:0 !important;
    height:100% !important;
    overflow:hidden !important;
  }

  body[data-page="publicDashboard"] .event-card.wf2-event-badge .wf2-event-heading-row{
    gap:6px !important;
    align-items:flex-start !important;
  }

  body[data-page="publicDashboard"] .event-card.wf2-event-badge .wf2-event-content h3,
  body[data-page="publicDashboard"] .announcement-card.wf2-announcement-badge h3{
    font-size:0.92rem !important;
    line-height:1.28 !important;
    margin:0 !important;
  }

  body[data-page="publicDashboard"] .event-card.wf2-event-badge .wf2-event-date-badge{
