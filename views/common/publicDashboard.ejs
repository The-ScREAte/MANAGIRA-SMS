/* =========================================================
   LAYOUT-SPECIFIC STYLES
   Wireframe 2: Split Dashboard
   Wireframe 3: Content-First
   Wireframe 4: Narrative Flow
   ========================================================= */

/* ===== WIREFRAME 2: SPLIT DASHBOARD ===== */
.wf2-hero-split {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 22px;
  width: min(96%, 1540px);
  max-width: none;
  margin: 0 auto 56px;
  padding: 0;
}

.wf2-left-panel h2,
.wf2-right-panel h2 {
  margin: 0 0 18px;
  font-size: 1.65rem;
  font-weight: 900;
}

.wf2-left-panel {
  display: flex;
  flex-direction: column;
  min-height: 0;
}

.wf2-gallery-masonry {
  --wf2-gallery-card-height: 190px;
  --wf2-gallery-caption-height: 66px;
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12px;
  /* 3 visible rows (card + caption) then vertical scroll */
  max-height: calc((var(--wf2-gallery-card-height) + var(--wf2-gallery-caption-height) + 12px) * 3);
  overflow-y: auto;
  overflow-x: hidden;
  padding-right: 6px;
}

.wf2-gallery-masonry .gallery-card {
  width: 100%;
  max-width: none !important;
  margin: 0;
  overflow: hidden;
  border-radius: 12px;
  display: block !important;
  min-height: calc(var(--wf2-gallery-card-height) + var(--wf2-gallery-caption-height));
}

.wf2-gallery-masonry .gallery-card-image-section {
  height: var(--wf2-gallery-card-height) !important;
  min-height: var(--wf2-gallery-card-height);
}

.wf2-gallery-masonry .gallery-card-image-section img {
  width: 100%;
  height: 100%;
  object-fit: cover !important;
  display: block;
}

.wf2-gallery-masonry .gallery-card .caption {
  display: -webkit-box !important;
  height: var(--wf2-gallery-caption-height);
  min-height: var(--wf2-gallery-caption-height);
  margin-top: 0 !important;
  padding: 9px 11px !important;
  box-sizing: border-box;
  white-space: normal !important;
  line-clamp: 2 !important;
  -webkit-line-clamp: 2 !important;
  -webkit-box-orient: vertical !important;
  overflow: hidden !important;
  text-overflow: ellipsis !important;
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.94), rgba(248, 250, 252, 0.98));
}

/* Theme-specific fallback so caption remains visible in every theme */
body[data-pd-theme] .wf2-gallery-masonry .gallery-card .caption {
  margin-top: 0 !important;
}

.wf2-right-panel {
  display: flex;
  flex-direction: column;
  min-width: 0;
  min-height: 0;
  gap: 14px;
  /* Start the right column lower so events align with top gallery image row */
  padding-top: 56px;
}

.wf2-right-block {
  background: rgba(255, 255, 255, 0.94);
  border: 1px solid rgba(59, 130, 246, 0.25);
  border-radius: 14px;
  padding: 12px;
  min-width: 0;
  min-height: 0;
  display: flex;
  flex-direction: column;
}

.wf2-right-block h2 {
  margin: 0 0 10px;
  font-size: 1.2rem;
}

.wf2-right-events,
.wf2-right-announcements {
  flex: 1;
}

.wf2-events-priority {
  display: flex;
  flex-direction: row;
  gap: 18px;
  overflow-x: auto;
  overflow-y: hidden;
  max-height: none;
  padding: 6px 4px 16px;
  -webkit-overflow-scrolling: touch;
  scroll-snap-type: x mandatory;
}

.wf2-events-priority,
.wf2-announcements-list,
.wf2-articles-scroll{
  cursor: grab;
}

.wf2-events-priority.is-dragging-scroll,
.wf2-announcements-list.is-dragging-scroll,
.wf2-articles-scroll.is-dragging-scroll{
  cursor: grabbing;
}

.wf2-events-priority.is-dragging-scroll *,
.wf2-announcements-list.is-dragging-scroll *,
.wf2-articles-scroll.is-dragging-scroll *{
  user-select: none;
}

.wf2-event-badge {
  display: flex !important;
  flex-direction: column !important;
  align-items: stretch !important;
  gap: 10px;
  padding: 18px !important;
  height: 240px !important;
  min-width: calc((100% - 18px) / 2);
  max-width: calc((100% - 18px) / 2);
  flex: 0 0 calc((100% - 18px) / 2);
  scroll-snap-align: start;
}

.wf2-event-date-badge {
  flex-shrink: 0;
  background: var(--org-primary-color, #01535b);
  color: #fff;
  padding: 5px 8px;
  border-radius: 10px;
  font-weight: 800;
  font-size: 0.68rem;
  text-align: center;
  line-height: 1.1;
  white-space: nowrap;
}

.wf2-event-heading-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 10px;
}

.wf2-event-content {
  display: flex;
  flex-direction: column;
  min-height: 0;
  height: 100%;
}

.wf2-event-content h3 {
  margin: 0;
  font-size: 1rem;
  line-height: 1.3;
  flex: 1 1 auto;
  min-width: 0;
  white-space: normal;
  overflow-wrap: anywhere;
  word-break: break-word;
}

.wf2-event-heading-row .wf2-event-date-badge {
  flex: 0 0 auto;
  margin-left: auto;
}

.wf2-event-content p {
  margin: 10px 0 0;
  font-size: 0.9rem;
  line-height: 1.5;
  overflow-y: auto;
  min-height: 0;
  flex: 1;
  padding-right: 4px;
}

.wf2-articles-section {
  max-width: 1280px;
  margin: 0 auto 56px;
  padding: 0 24px;
}
.wf2-articles-section h2 {
  margin: 0 0 18px;
  font-size: 1.65rem;
  font-weight: 900;
}

.wf2-announcements-sidebar {
  max-width: 1280px;
  margin: 0 auto 56px;
  padding: 0 24px;
}
.wf2-announcements-sidebar h2 {
  margin: 0 0 16px;
}

.wf2-announcements-list {
  display: flex;
  flex-direction: row;
  gap: 18px;
  overflow-x: auto;
  overflow-y: hidden;
  max-height: none;
  padding: 6px 4px 16px;
  -webkit-overflow-scrolling: touch;
  scroll-snap-type: x mandatory;
}

.wf2-announcement-badge {
  display: grid !important;
  grid-template-columns: 22px minmax(0, 1fr);
  align-items: flex-start !important;
  gap: 12px;
  padding: 18px !important;
  height: 240px !important;
  min-width: calc((100% - 18px) / 2);
  max-width: calc((100% - 18px) / 2);
  flex: 0 0 calc((100% - 18px) / 2);
  scroll-snap-align: start;
}

.wf2-announcement-icon {
  font-size: 1.3rem;
  flex-shrink: 0;
  margin-top: 4px;
  grid-column: 1;
}

.wf2-announcement-badge p {
  grid-column: 2;
  margin: 0;
  line-height: 1.55;
  white-space: pre-line;
  overflow-wrap: anywhere;
  word-break: break-word;
  line-break: auto;
  text-indent: 0;
  max-width: 100%;
  min-width: 0;
  overflow-y: auto;
  min-height: 0;
  flex: 1;
  align-self: stretch;
  padding-right: 4px;
}

@media (max-width: 900px) {
  .wf2-hero-split {
    grid-template-columns: 1fr;
    padding: 0 16px;
    width: 100%;
  }
  .wf2-right-panel {
    padding-top: 0;
  }
  .wf2-left-panel {
    order: 1;
  }
  .wf2-right-events {
    order: 2;
  }
  .wf2-right-announcements {
    order: 3;
  }
  .wf2-gallery-masonry {
    --wf2-gallery-card-height: 135px;
    --wf2-gallery-caption-height: 58px;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    max-height: calc((var(--wf2-gallery-card-height) + var(--wf2-gallery-caption-height) + 12px) * 3);
  }
  .wf2-events-priority {
    display: flex;
    flex-direction: row;
    gap: 12px;
    overflow-x: auto;
    overflow-y: hidden;
    max-height: none;
    scroll-snap-type: x mandatory;
  }
  .wf2-announcements-list {
    display: flex;
    flex-direction: row;
    gap: 12px;
    overflow-x: auto;
    overflow-y: hidden;
    max-height: none;
    scroll-snap-type: x mandatory;
  }
  .wf2-event-badge,
  .wf2-announcement-badge {
    min-width: 100%;
    max-width: 100%;
    flex: 0 0 100%;
    height: 190px !important;
  }
}

/* ===== WIREFRAME 3: CONTENT-FIRST ===== */
.wf3-gallery-section {
  max-width: 1280px;
  margin: 0 auto 56px;
  padding: 0 24px;
}
.wf3-gallery-section h2 {
  margin: 0 0 18px;
  font-size: 1.65rem;
  font-weight: 900;
}

.wf3-content-split {
  display: grid;
  grid-template-columns: 1.35fr 1fr;
  gap: 24px;
  width: min(96%, 1540px);
  max-width: none;
  margin: 0 auto 56px;
  padding: 0;
  align-items: start;
}

.wf3-articles-main h2 {
  margin: 0 0 18px;
  font-size: 1.5rem;
  font-weight: 900;
}

.wf3-right-column {
  display: flex;
  flex-direction: column;
  gap: 16px;
  min-width: 0;
}

.wf3-right-block {
  background: rgba(255, 255, 255, 0.94);
  border: 1px solid rgba(59, 130, 246, 0.25);
  border-radius: 14px;
  padding: 12px;
  min-width: 0;
}

.wf3-right-block h2 {
  margin: 0 0 10px;
  font-size: 1.2rem;
  font-weight: 900;
}

.wf3-announcements-feed,
.wf3-events-grid {
  display: flex;
  flex-direction: row;
  gap: 14px;
  overflow-x: auto;
  overflow-y: hidden;
  padding: 6px 4px 12px;
  scroll-snap-type: x mandatory;
  -webkit-overflow-scrolling: touch;
}

.wf3-announcement-pill,
.wf3-event-card {
  min-width: calc((100% - 14px) / 2);
  max-width: calc((100% - 14px) / 2);
  flex: 0 0 calc((100% - 14px) / 2);
  height: 205px !important;
  scroll-snap-align: start;
}

.wf3-announcement-pill {
  display: flex !important;
  flex-direction: row !important;
  align-items: flex-start !important;
  gap: 10px;
  padding: 16px !important;
  border-radius: 10px !important;
}

.wf3-announcement-pill {
  overflow: hidden;
}

.wf3-announcement-marker {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: var(--org-primary-color, #01535b);
  flex-shrink: 0;
  margin-top: 6px;
}

.wf3-announcement-pill p {
  margin: 0;
  overflow-y: auto;
  min-height: 0;
  flex: 1;
  align-self: stretch;
  line-height: 1.55;
}

.wf3-events-section {
  max-width: 1280px;
  margin: 0 auto 56px;
  padding: 0 24px;
}
.wf3-events-section h2 {
  margin: 0 0 18px;
  font-size: 1.5rem;
  font-weight: 900;
}

.wf3-event-card {
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

/* Wireframe 3: show two article cards and make them taller for readability */
.wf3-articles-masonry .draggable-item {
  flex: 0 0 calc((100% - 16px) / 2) !important;
  min-width: calc((100% - 16px) / 2) !important;
  max-width: calc((100% - 16px) / 2) !important;
  height: 500px !important;
}

.wf3-event-card h3 {
  margin: 0 0 8px;
  font-size: 1rem;
  line-height: 1.3;
}

.wf3-event-card p {
  margin: 0 0 8px;
  line-height: 1.5;
}

.wf3-event-card p:last-child {
  margin: 0;
  overflow-y: auto;
  min-height: 0;
  flex: 1;
  padding-right: 4px;
}

@media (max-width: 900px) {
  .wf3-content-split {
    grid-template-columns: 1fr;
    padding: 0 16px;
    width: 100%;
  }
  .wf3-articles-main,
  .wf3-right-column,
  .wf3-right-block {
    min-width: 0;
  }
  .wf3-announcement-pill,
  .wf3-event-card {
    min-width: 100%;
    max-width: 100%;
    flex: 0 0 100%;
    height: 190px !important;
  }
  .wf3-articles-masonry .draggable-item {
    flex: 0 0 100% !important;
    min-width: 100% !important;
    max-width: 100% !important;
    height: 430px !important;
  }
}

/* ===== WIREFRAME 4: NARRATIVE FLOW ===== */
.wf4-gallery-section {
  max-width: 1280px;
  margin: 0 auto 56px;
  padding: 0 24px;
}
.wf4-gallery-section h2 {
  margin: 0 0 20px;
  font-size: 1.65rem;
  font-weight: 900;
}

/* Timeline */
.wf4-timeline-section {
  max-width: 1280px;
  margin: 0 auto 56px;
  padding: 0 24px;
}
.wf4-timeline-section h2 {
  margin: 0 0 28px;
  font-size: 1.65rem;
  font-weight: 900;
}

.wf4-timeline-container {
  --wf4-event-row-height: 198px;
  position: relative;
  padding: 0 20px 8px;
  max-height: calc((var(--wf4-event-row-height) + 20px) * 3);
  overflow-y: auto;
  overflow-x: hidden;
}

.wf4-timeline-container::before {
  content: '';
  position: absolute;
  left: 50%;
  top: 0;
  bottom: 0;
  width: 3px;
  background: var(--org-primary-color, #01535b);
  transform: translateX(-50%);
  opacity: 0.25;
}

.wf4-timeline-block {
  display: flex;
  align-items: flex-start;
  margin-bottom: 20px;
  min-height: var(--wf4-event-row-height);
  position: relative;
}

.wf4-timeline-left {
  flex-direction: row;
  padding-right: 52%;
}

.wf4-timeline-right {
  flex-direction: row-reverse;
  padding-left: 52%;
}

.wf4-timeline-marker {
  position: absolute;
  left: 50%;
  transform: translateX(-50%);
  z-index: 2;
}

.wf4-timeline-dot {
  width: 16px;
  height: 16px;
  border-radius: 50%;
  background: var(--org-primary-color, #01535b);
  border: 3px solid #fff;
  box-shadow: 0 0 0 3px var(--org-primary-color, #01535b);
}

.wf4-timeline-card {
  background: #fff;
  border-radius: 14px;
  padding: 18px 22px;
  box-shadow: 0 8px 22px rgba(0,0,0,0.10);
  flex: 1;
  border-left: 4px solid var(--org-primary-color, #01535b);
  height: var(--wf4-event-row-height);
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.wf4-timeline-date {
  font-size: 0.78rem;
  font-weight: 800;
  color: var(--org-primary-color, #01535b);
  margin-bottom: 4px;
  text-transform: uppercase;
  letter-spacing: 0.8px;
}

.wf4-timeline-card h3 {
  margin: 0 0 6px;
  font-size: 1.05rem;
}
.wf4-timeline-card p {
  margin: 8px 0 0;
  font-size: 0.9rem;
  line-height: 1.55;
  color: #555;
  overflow-y: auto;
  min-height: 0;
  flex: 1;
  padding-right: 4px;
}

/* Announcements Grid */
.wf4-announcements-section {
  max-width: 1280px;
  margin: 0 auto 56px;
  padding: 0 24px;
}
.wf4-announcements-section h2 {
  margin: 0 0 20px;
  font-size: 1.5rem;
  font-weight: 900;
}

.wf4-announcements-grid {
  display: flex;
  flex-direction: row;
  gap: 16px;
  overflow-x: auto;
  overflow-y: hidden;
  padding: 6px 4px 12px;
  scroll-snap-type: x mandatory;
  -webkit-overflow-scrolling: touch;
}

.wf4-announcement-card {
  background: #fff;
  border-radius: 14px;
  padding: 18px;
  box-shadow: 0 6px 20px rgba(0,0,0,0.08);
  border-left: 4px solid var(--org-primary-color, #01535b);
  min-width: 320px;
  max-width: 320px;
  flex: 0 0 320px;
  scroll-snap-align: start;
}

.wf4-announcement-header {
  margin-bottom: 10px;
}

.wf4-announcement-badge {
  display: inline-block;
  background: var(--org-primary-color, #01535b);
  color: #fff;
  font-size: 0.68rem;
  font-weight: 800;
  padding: 3px 10px;
  border-radius: 4px;
  letter-spacing: 1px;
}

.wf4-announcement-card p {
  margin: 0;
  font-size: 0.92rem;
  line-height: 1.65;
  color: #444;
}

/* About Expanded */
.wf4-about-section {
  max-width: 1280px;
  margin: 0 auto 56px;
  padding: 0 24px;
}
.wf4-about-section h2 {
  margin: 0 0 22px;
  font-size: 1.65rem;
  font-weight: 900;
}

.wf4-about-content {
  display: grid;
  grid-template-columns: 1.5fr 1fr;
  gap: 36px;
  background: #fff;
  border-radius: 16px;
  padding: 32px;
  box-shadow: 0 10px 30px rgba(0,0,0,0.08);
}

.wf4-about-lead {
  font-size: 1.05rem;
  line-height: 1.85;
  color: #333;
  margin: 0;
}

.wf4-about-values h3 {
  font-size: 1.1rem;
  margin: 0 0 14px;
  color: var(--org-primary-color, #01535b);
}

.wf4-about-values p {
  margin: 0;
  font-size: 0.96rem;
  line-height: 1.7;
  color: #333;
}

.wf4-about-values ul {
  list-style: none;
  padding: 0;
  margin: 0;
}

.wf4-about-values li {
  padding: 10px 0;
  border-bottom: 1px solid #f0f0f0;
  font-size: 0.92rem;
  line-height: 1.55;
}

.wf4-about-values li:last-child { border-bottom: none; }

/* Stories */
.wf4-stories-section {
  max-width: 1280px;
  margin: 0 auto 56px;
  padding: 0 24px;
}
.wf4-stories-section h2 {
  margin: 0 0 18px;
  font-size: 1.65rem;
  font-weight: 900;
}

@media (max-width: 900px) {
  .wf4-timeline-container {
    --wf4-event-row-height: 186px;
  }
  .wf4-timeline-container::before {
    left: 22px;
  }
  .wf4-timeline-left,
  .wf4-timeline-right {
    flex-direction: row;
    padding-left: 54px;
    padding-right: 0;
  }
  .wf4-timeline-marker {
    left: 22px;
  }
  .wf4-about-content {
    grid-template-columns: 1fr;
  }
}


/* =========================================================
   BOLD CLASSIC (NEW THEME)
   Activates only when data-pd-theme="bold"
   ========================================================= */

body[data-pd-theme="bold"]{
  background: #0b1020;
  color: #eef2ff;
}

/* Keep all layout widths consistent (same as classic) */
body[data-pd-theme="bold"] .content-section{
  max-width:1280px;
  margin:0 auto 72px auto;
  padding:0 16px;
}

/* Headings: bold + loud underline */
body[data-pd-theme="bold"] .content-section > h2{
  margin:0 0 18px 0;
  text-align:left;
  font-size:1.9rem;
  font-weight:900;
  letter-spacing:0.2px;

  color:#ffffff;
  border-bottom:4px solid #ffb703;
  padding-bottom:10px;
}

/* Cards: stronger contrast + bolder borders */
body[data-pd-theme="bold"] .card,
body[data-pd-theme="bold"] .gallery-card,
body[data-pd-theme="bold"] .draggable-item,
body[data-pd-theme="bold"] .event-card,
body[data-pd-theme="bold"] .announcement-card{
  background: rgba(255,255,255,0.06);
  border: 1px solid rgba(255,255,255,0.14);
  box-shadow: 0 16px 34px rgba(0,0,0,0.45);
  backdrop-filter: blur(10px);
}

/* Carousel: darker base so images pop */
body[data-pd-theme="bold"] .custom-carousel{
  background:#111827;
  box-shadow: 0 20px 45px rgba(0,0,0,0.55);
  border: 1px solid rgba(255,255,255,0.10);
}

/* Carousel caption: bold ribbon */
body[data-pd-theme="bold"] .slide .caption{
  background: linear-gradient(to top, rgba(0,0,0,0.92), rgba(0,0,0,0.25));
  font-weight: 900;
  letter-spacing: 0.2px;
}

/* Carousel controls: louder */
body[data-pd-theme="bold"] .carousel-control{
  background: rgba(255,183,3,0.22);
  border: 1px solid rgba(255,183,3,0.35);
}
body[data-pd-theme="bold"] .carousel-control:hover{
  background: rgba(255,183,3,0.35);
}

/* ✅ Gallery grid for bold (same structure as classic, but NOT scoped to classic) */
body[data-pd-theme="bold"] .wf1-gallery,
body[data-pd-theme="bold"] .wf3-gallery-grid,
body[data-pd-theme="bold"] .wf4-gallery-compact,
body[data-pd-theme="bold"] .image-container{
  display:grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap:16px;
  max-width:1280px;
  margin:0 auto;
  padding:0 16px;
}

@media (max-width:1100px){
  body[data-pd-theme="bold"] .wf1-gallery,
  body[data-pd-theme="bold"] .wf3-gallery-grid,
  body[data-pd-theme="bold"] .wf4-gallery-compact,
  body[data-pd-theme="bold"] .image-container{
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }
}

@media (max-width:700px){
  body[data-pd-theme="bold"] .wf1-gallery,
  body[data-pd-theme="bold"] .wf3-gallery-grid,
  body[data-pd-theme="bold"] .wf4-gallery-compact,
  body[data-pd-theme="bold"] .image-container{
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap:12px;
    padding:0 12px;
  }
}

/* Gallery image: cover to look “bold” (no blank bars) */
body[data-pd-theme="bold"] .gallery-card-image-section img{
  width:100%;
  height:100%;
  object-fit: cover;
  display:block;
}

/* Gallery caption: bold pill */
body[data-pd-theme="bold"] .gallery-card .caption{
  background: linear-gradient(90deg, rgba(255,183,3,0.92), rgba(255,0,110,0.78));
  color:#0b1020;
  font-weight: 900;
  padding:10px 12px;
  font-size:0.95rem;

  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* Articles: keep your horizontal scroll, but darker editor */
body[data-pd-theme="bold"] .draggable-item h3{
  color:#ffb703;
}

body[data-pd-theme="bold"] .draggable-item .ql-editor{
  background: rgba(0,0,0,0.25);
  color:#e5e7eb;
}

/* Events + announcements scrollers stay same behavior */
body[data-pd-theme="bold"] .event-card h3,
body[data-pd-theme="bold"] .announcement-card h3{
  color:#ffb703;
}

body[data-pd-theme="bold"] .event-card p,
body[data-pd-theme="bold"] .announcement-card p{
  color: rgba(255,255,255,0.85);
}

/* About text */
body[data-pd-theme="bold"] #about-us p{
  color: rgba(255,255,255,0.88);
}

/* Modal (optional: make it match dark theme) */
body[data-pd-theme="bold"] .modal{
  background-color: rgba(0,0,0,0.65);
}
body[data-pd-theme="bold"] .modal-content{
  background: #0f172a;
  color: #fff;
  border: 1px solid rgba(255,255,255,0.12);
}
body[data-pd-theme="bold"] #modalCaption{
  color:#fff;
}

