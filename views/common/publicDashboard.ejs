/* Public registration CTA */
.registration-cta{
  margin:20px 0 24px;
  position:relative;
  z-index:5;
}

@keyframes registrationCtaPulse{
  0%, 100%{
    box-shadow:0 14px 28px var(--org-primary-soft-shadow-strong);
    filter:saturate(1);
  }
  50%{
    box-shadow:0 20px 38px color-mix(in srgb, var(--org-primary-color) 40%, transparent);
    filter:saturate(1.12);
  }
}

@keyframes registrationCtaDotPulse{
  0%, 100%{
    opacity:1;
    box-shadow:0 0 0 7px color-mix(in srgb, var(--org-primary-color) 18%, transparent);
  }
  50%{
    opacity:0.68;
    box-shadow:0 0 0 13px color-mix(in srgb, var(--org-primary-color) 12%, transparent);
  }
}

.registration-cta__card{
  position:relative;
  display:grid;
  grid-template-columns:minmax(0, 1fr) auto;
  gap:16px;
  align-items:center;
  padding:18px 22px;
  border-radius:20px;
  background:
    radial-gradient(circle at top right, color-mix(in srgb, var(--org-primary-color) 16%, white) 0%, transparent 34%),
    linear-gradient(135deg, #ffffff 0%, var(--org-primary-soft) 100%);
  border:1px solid var(--org-primary-soft-border);
  box-shadow:0 14px 30px var(--org-primary-soft-shadow);
  overflow:hidden;
}

.registration-cta__card::after{
  content:"";
  position:absolute;
  inset:auto -24px -48px auto;
  width:140px;
  height:140px;
  border-radius:999px;
  background:color-mix(in srgb, var(--org-primary-color) 9%, transparent);
  pointer-events:none;
}

.registration-cta__content,
.registration-cta__meta{
  position:relative;
  z-index:1;
}

.registration-cta__eyebrow{
  display:inline-flex;
  align-items:center;
  gap:8px;
  padding:6px 11px;
  margin-bottom:10px;
  border-radius:999px;
  background:color-mix(in srgb, var(--org-primary-color) 12%, white);
  color:var(--org-primary-color);
  font-size:0.72rem;
  font-weight:800;
  letter-spacing:0.08em;
  text-transform:uppercase;
}

.registration-cta__dot{
  width:8px;
  height:8px;
  border-radius:999px;
  background:var(--org-primary-color);
  box-shadow:0 0 0 7px color-mix(in srgb, var(--org-primary-color) 18%, transparent);
  animation:registrationCtaDotPulse 2s ease-in-out infinite;
}

.registration-cta__title{
  margin:0 0 6px;
  font-size:clamp(1.15rem, 1.7vw, 1.45rem);
  line-height:1.2;
  letter-spacing:-0.02em;
  color:#0f172a;
}

.registration-cta__summary{
  margin:0;
  max-width:48ch;
  color:#475569;
  font-size:0.94rem;
  line-height:1.5;
}

.registration-cta__summary strong{
  color:#0f172a;
  font-weight:800;
}

.registration-cta__meta{
  display:flex;
  align-items:center;
  justify-content:flex-end;
  min-width:0;
}

.registration-cta__button{
  display:inline-flex;
  align-items:center;
  justify-content:center;
  gap:10px;
  min-width:200px;
  padding:14px 22px;
  border:none;
  border-radius:999px;
  background:linear-gradient(135deg, var(--org-primary-color), var(--org-primary-hover));
  color:#ffffff;
  font-size:0.94rem;
  font-weight:800;
  letter-spacing:0.01em;
  text-decoration:none;
  box-shadow:0 14px 28px var(--org-primary-soft-shadow-strong);
  transition:transform 0.2s ease, box-shadow 0.2s ease, filter 0.2s ease;
  animation:registrationCtaPulse 2s ease-in-out infinite;
}

.registration-cta__button:hover,
.registration-cta__button:focus-visible{
  animation-play-state:paused;
  transform:translateY(-2px);
  box-shadow:0 18px 34px var(--org-primary-soft-shadow-strong);
  filter:saturate(1.04);
}

.registration-cta__button-arrow{
  font-size:1.08rem;
  line-height:1;
}

.registration-cta__fallback{
  margin:18px 0;
  text-align:center;
  color:#b91c1c;
  font-weight:700;
}

@media screen and (max-width:860px){
  .registration-cta__card{
    grid-template-columns:1fr;
    padding:18px;
  }

  .registration-cta__meta{
    justify-content:flex-start;
  }

  .registration-cta__button{
    min-width:180px;
  }
}

/* Extra small screens */
@media screen and (max-width:480px){
  .registration-cta{
