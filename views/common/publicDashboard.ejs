<html lang="en">
  <%
    /* Font: read directly from orgDetails (same as org name/aboutus/theme) — no session needed */
    const selectedPublicFont = (orgDetails && orgDetails.font_style ? String(orgDetails.font_style).trim() : 'Inter') || 'Inter';
    const publicSerifFonts = ['PT Serif', 'Merriweather', 'Playfair Display'];
    const publicFallbackFamily = publicSerifFonts.includes(selectedPublicFont) ? 'serif' : 'sans-serif';
    const loadableGoogleFonts = ['Inter', 'Roboto', 'Open Sans', 'Lato', 'Montserrat', 'Poppins', 'Nunito', 'Raleway', 'Work Sans', 'Source Sans Pro', 'Ubuntu', 'Noto Sans', 'PT Serif', 'Merriweather', 'Playfair Display'];
    const shouldLoadPublicGoogleFont = loadableGoogleFonts.includes(selectedPublicFont);
    const normalizedPublicFont = selectedPublicFont.replace(/\s+/g, '+');
  %>
  <head>
    <meta charset="UTF-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <title><%= title %></title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- SEO Meta Tags -->
    <% if (typeof description !== 'undefined' && description) { %>
      <meta name="description" content="<%= description %>">
    <% } else if (orgDetails && orgDetails.aboutus) { %>
      <meta name="description" content="<%= String(orgDetails.aboutus).replace(/<[^>]*>/g, '').substring(0, 160) %>">
    <% } %>
    <% if (typeof keywords !== 'undefined' && keywords) { %>
      <meta name="keywords" content="<%= keywords %>">
    <% } %>
    <meta name="robots" content="index, follow">
    <meta name="author" content="<%= (orgDetails && (orgDetails.organization_name || orgDetails.nickname_display || orgDetails.nickname)) ? (orgDetails.organization_name || orgDetails.nickname_display || orgDetails.nickname) : 'School' %>">
    <% if (typeof canonicalUrl !== 'undefined' && canonicalUrl) { %>
      <link rel="canonical" href="<%= canonicalUrl %>">
    <% } %>

    <!-- Geo Meta Tags (for local "near me" search ranking) -->
    <% if (orgDetails && orgDetails.geo_lat != null && orgDetails.geo_lng != null) { %>
      <meta name="geo.position" content="<%= orgDetails.geo_lat %>;<%= orgDetails.geo_lng %>">
      <meta name="ICBM" content="<%= orgDetails.geo_lat %>, <%= orgDetails.geo_lng %>">
    <% } %>
    <% if (orgDetails && (orgDetails.organization_country || orgDetails.organization_province)) { %>
      <meta name="geo.region" content="<%= [orgDetails.organization_country, orgDetails.organization_province].filter(Boolean).join('-') %>">
    <% } %>
    <% if (orgDetails && orgDetails.organization_address) { %>
      <meta name="geo.placename" content="<%= orgDetails.organization_address %>">
    <% } %>

    <!-- Open Graph Meta Tags -->
    <meta property="og:type" content="website">
    <meta property="og:site_name" content="<%= (typeof siteName !== 'undefined' && siteName) ? siteName : ((orgDetails && (orgDetails.nickname_display || orgDetails.nickname || orgDetails.organization_name)) ? (orgDetails.nickname_display || orgDetails.nickname || orgDetails.organization_name) : 'School Website') %>">
    <meta property="og:title" content="<%= title %>">
    <% if (typeof description !== 'undefined' && description) { %>
      <meta property="og:description" content="<%= description %>">
    <% } %>
    <% if (typeof canonicalUrl !== 'undefined' && canonicalUrl) { %>
      <meta property="og:url" content="<%= canonicalUrl %>">
    <% } %>
    <%
      const _canonicalOrigin = (() => {
        try {
          return (typeof canonicalUrl !== 'undefined' && canonicalUrl)
            ? new URL(canonicalUrl).origin
            : 'https://www.managira.com';
        } catch (_) {
          return 'https://www.managira.com';
        }
      })();

      const _toAbsolute = (value) => {
        if (!value) return '';
        if (/^https?:\/\//i.test(value)) return value;
        return _canonicalOrigin + (String(value).startsWith('/') ? '' : '/') + value;
      };

      const _schoolLogoCandidate =
        (orgDetails && (orgDetails.logo || orgDetails.logo_path)) ||
        ((req && req.schoolDetails) ? (req.schoolDetails.logo || req.schoolDetails.logo_path) : '') ||
        (session && session.logo) ||
        '';

      // Keep Google card thumbnail consistent with Managira brand image.
      const _ogImage = _canonicalOrigin + '/images/managira.png';
      const _ogImageWidth = '512';
      const _ogImageHeight = '512';

      const _schoolIcon = _toAbsolute(String(_schoolLogoCandidate || '').trim());
    %>
    <meta property="og:image" content="<%= _ogImage %>">
    <meta property="og:image:width" content="<%= _ogImageWidth %>">
    <meta property="og:image:height" content="<%= _ogImageHeight %>">

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="<%= title %>">
    <% if (typeof description !== 'undefined' && description) { %>
      <meta name="twitter:description" content="<%= description %>">
    <% } %>
    <meta name="twitter:image" content="<%= _ogImage %>">
    <meta name="application-name" content="<%= (typeof siteName !== 'undefined' && siteName) ? siteName : ((orgDetails && (orgDetails.nickname_display || orgDetails.nickname || orgDetails.organization_name)) ? (orgDetails.nickname_display || orgDetails.nickname || orgDetails.organization_name) : 'School Website') %>">
    <meta name="apple-mobile-web-app-title" content="<%= (typeof siteName !== 'undefined' && siteName) ? siteName : ((orgDetails && (orgDetails.nickname_display || orgDetails.nickname || orgDetails.organization_name)) ? (orgDetails.nickname_display || orgDetails.nickname || orgDetails.organization_name) : 'School Website') %>">

    <!-- Structured Data (School schema) -->
    <% if (typeof structuredData !== 'undefined' && structuredData) { %>
      <script type="application/ld+json"><%- JSON.stringify(structuredData) %></script>
    <% } %>

    <!-- Favicons -->
    <% if (_schoolIcon) { %>
      <link rel="icon" href="<%= _schoolIcon %>" type="image/png" sizes="48x48" />
      <link rel="icon" href="<%= _schoolIcon %>" type="image/png" sizes="32x32" />
      <link rel="icon" href="<%= _schoolIcon %>" type="image/png" sizes="16x16" />
      <link rel="shortcut icon" href="<%= _schoolIcon %>" type="image/png" />
      <link rel="apple-touch-icon" sizes="180x180" href="<%= _schoolIcon %>" />
      <meta name="msapplication-TileColor" content="#01535b">
      <meta name="msapplication-TileImage" content="<%= _schoolIcon %>">
    <% } else { %>
      <link rel="icon" href="/favicon.ico" type="image/x-icon" sizes="any" />
      <link rel="apple-touch-icon" sizes="180x180" href="/images/favicon_io/apple-touch-icon.png" />
      <link rel="icon" type="image/png" sizes="32x32" href="/images/favicon_io/favicon-32x32.png" />
      <link rel="icon" type="image/png" sizes="16x16" href="/images/favicon_io/favicon-16x16.png" />
      <link rel="manifest" href="/images/favicon_io/site.webmanifest" />
    <% } %>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <% if (shouldLoadPublicGoogleFont) { %>
      <link href="https://fonts.googleapis.com/css2?family=<%= normalizedPublicFont %>:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
    <% } %>
    <link
      href="https://cdn.quilljs.com/1.3.6/quill.snow.css"
      rel="stylesheet"
    />

    <style>
/* =========================================================
   1. GLOBAL DESIGN TOKENS & TYPOGRAPHY (BASE)
   ========================================================= */
<%
  /* Resolve org theme color for public dashboard (works even when not logged in) */
  const pdThemeColorMap = {
    teal: { primary: '#01535b', hover: '#014a51' },
    blue: { primary: '#2563eb', hover: '#1d4ed8' },
    green: { primary: '#2d5f4f', hover: '#245043' },
    purple: { primary: '#7c3aed', hover: '#6d28d9' },
    indigo: { primary: '#4f46e5', hover: '#4338ca' },
    rose: { primary: '#8b2635', hover: '#7a212e' },
    amber: { primary: '#d97706', hover: '#b45309' },
    yellow: { primary: '#eab308', hover: '#ca8a04' },
    slate: { primary: '#334155', hover: '#1e293b' },
    classic: { primary: '#01535b', hover: '#014a51' },
    bold: { primary: '#0b1020', hover: '#ffb703' },
    modern: { primary: '#2563eb', hover: '#1d4ed8' },
    minimal: { primary: '#7c3aed', hover: '#6d28d9' },
    gold: { primary: '#d4a017', hover: '#b8860b' },
    red: { primary: '#e11d48', hover: '#be123c' },
    brown: { primary: '#7c4a03', hover: '#5c3802' }
  };
  const pdOrgThemeKey = (orgDetails && orgDetails.theme_color) ? orgDetails.theme_color : 'teal';
  const pdOrgTheme = pdThemeColorMap[pdOrgThemeKey] || pdThemeColorMap.teal;
%>
:root{
  --font-family:"<%= selectedPublicFont %>",<%= publicFallbackFamily %>;
  --org-primary-color: <%= pdOrgTheme.primary %>;
  --org-primary-hover: <%= pdOrgTheme.hover %>;
  --org-primary-soft: color-mix(in srgb, var(--org-primary-color) 10%, white);
  --org-primary-soft-strong: color-mix(in srgb, var(--org-primary-color) 16%, white);
  --org-primary-soft-border: color-mix(in srgb, var(--org-primary-color) 28%, white);
  --org-primary-soft-shadow: color-mix(in srgb, var(--org-primary-color) 18%, transparent);
  --org-primary-soft-shadow-strong: color-mix(in srgb, var(--org-primary-color) 24%, transparent);
  --org-primary-hover-fill: color-mix(in srgb, var(--org-primary-color) 88%, white);

  --title-xl:36px;
  --title-lg:26px;
  --title-md:20px;

  --text-base:15px;
  --text-sm:13px;

  --radius-lg:18px;
  --radius-md:14px;
  --radius-sm:10px;
}

html,
body{
  margin:0;
  padding:0;
  width:100%;
  overflow-x:hidden;
}

body{
  font-family:var(--font-family);
}

h1{ font-size:var(--title-xl); }
h2{ font-size:var(--title-lg); }
h3{ font-size:var(--title-md); font-weight:800; }

p{
  font-size:var(--text-base);
  line-height:1.7;
  font-weight:400;
}

.content-section p{ max-width:68ch; }

/* Global mobile text sizing */
@media (max-width:768px){
  :root{
    --title-xl:28px;
    --title-lg:22px;
    --title-md:17px;
    --text-base:14px;
    --text-sm:12px;
  }
}
@media (max-width:480px){
  :root{
    --title-xl:24px;
    --title-lg:19px;
    --title-md:16px;
    --text-base:13.5px;
    --text-sm:11.5px;
  }
  .public-dashboard-container{
    width:100%;
    padding:0 12px;
  }
}

/* =========================================================
   2. BASE COMPONENTS (THEME-AGNOSTIC)
   ========================================================= */

/* Cards */
.card,
.gallery-card,
.draggable-item,
.event-card,
.announcement-card{
  border-radius:var(--radius-md);
  border:none;
  box-shadow:0 6px 18px rgba(0,0,0,0.08);
}

/* Layout containers */
.public-dashboard-container{
  position:relative;
  width:min(1200px, 96%);
  margin:0 auto;
}

.public-dashboard-header{
  margin-top:50px;
}

body[data-page="publicDashboard"] #top-header #tools #loginbutton{
  min-height: 26px;
  padding: 3px 8px;
  font-size: 0.84rem;
  line-height: 1;
}

@media (max-width:768px){
  body[data-page="publicDashboard"] #top-header #tools #loginbutton{
    min-height: 24px;
    padding: 2px 7px;
    font-size: 0.8rem;
  }
}

/* Sections */
.content-section{
  margin-bottom:72px;
}

.school-identity-card{
  margin: 0 0 14px;
  padding: 24px 26px;
  border-radius: 18px;
  background: linear-gradient(135deg, color-mix(in srgb, var(--org-primary-color) 12%, white), #ffffff 62%);
  border: 1px solid var(--org-primary-soft-border);
  box-shadow: 0 12px 26px var(--org-primary-soft-shadow);
}

.school-identity-kicker{
  display:inline-flex;
  align-items:center;
  gap:8px;
  margin-bottom:12px;
  font-size:0.82rem;
  font-weight:700;
  letter-spacing:0.08em;
  text-transform:uppercase;
  color:var(--org-primary-color);
}

.school-identity-title{
  margin:0;
  color:#0f172a;
}

.school-identity-subtitle{
  margin:12px 0 0;
  max-width:78ch;
  color:#334155;
}

.school-identity-meta{
  display:flex;
  flex-wrap:wrap;
  gap:10px;
  margin:18px 0 0;
  padding:0;
  list-style:none;
}

.school-identity-chip{
  display:inline-flex;
  align-items:center;
  gap:6px;
  padding:8px 12px;
  border-radius:999px;
  background:#fff;
  border:1px solid var(--org-primary-soft-border);
  color:#0f172a;
  font-size:0.9rem;
  font-weight:600;
}

.school-identity-chip-label{
  color:#64748b;
  font-weight:700;
}

@media (max-width:768px){
  .school-identity-card{
    padding:20px 18px;
    border-radius:16px;
  }

  .school-identity-kicker{
    font-size:0.64rem;
    margin-bottom:0;
    padding-top:0;
    padding-bottom:0;
    line-height:1;
  }
}


/* =========================================================
   3. CAROUSEL / HERO (BASE) — UPDATED (PROFESSIONAL + RESPONSIVE)
   Replace your existing carousel CSS with this whole block
   ========================================================= */

.custom-carousel{
  position:relative;
  width:100%;

  /* ✅ Responsive height: not too tall on desktop, good on mobile */
  height: clamp(280px, 42vw, 520px);

  overflow:hidden;
  border-radius:14px;
  margin-bottom:20px;

  box-shadow:0 18px 30px rgba(0,0,0,0.12);
  background:#01535b; /* fallback behind images */
  cursor:pointer;
}

/* School banner (kept as original if you re-enable HTML) */
.school-banner{
  position:absolute;
  top:30px;
  left:50%;
  transform:translateX(-50%);
  width:500px;
  background-color:rgba(0,0,0,0.30);
  border-radius:10px;
  padding:10px;
  z-index:4;
  display:flex;
  flex-direction:column;
  align-items:center;
  justify-content:flex-start;
  opacity:0.9;
}
.school-banner img{
  width:100%;
  max-height:230px;
  object-fit:contain;
}
.school-banner p{
  color:#fff;
  font-size:1.5rem;
  font-weight:bolder;
  text-align:center;
  margin-top:10px;
}

/* Slide structure */
.slide-container{
  height:100%;
  width:100%;
  position:relative;
}

.slide{
  position:absolute;
  inset:0;
  opacity:0;
  transition:opacity .45s ease-in-out;
  background-color: var(--org-primary-color); /* prevent blank space */
}

.slide.active{
  opacity:1;
  z-index:1;
}

.slide-image{
  width:100%;
  height:100%;
  display:flex;
  align-items:center;
  justify-content:center;
  padding:0;
  box-sizing:border-box;
}

.slide-image img{
  width:100%;
  height:100%;

  /* ✅ looks best for photos (fills hero) */
object-fit:contain;
  object-position:center;

  display:block;
}

/* Caption (clean + readable, one line) */
.slide .caption{
  position:absolute;
  left:0;
  right:0;
  bottom:0;

  padding:14px 18px;
  color:#fff;
  font-size: clamp(0.9rem, 1.2vw, 1.1rem);
  font-weight:700;
  letter-spacing:0.2px;

  background: linear-gradient(
    to top,
    rgba(0,0,0,0.78),
    rgba(0,0,0,0.25)
  );

  text-align:center;           /* ✅ centered */
  display:flex;                /* ✅ centered even when wrapped */
  justify-content:center;
  align-items:center;

  white-space: normal;         /* ✅ allow wrapping */
  overflow-wrap: anywhere;     /* ✅ break long words safely */
  line-height: 1.35;

  /* optional: prevents caption from becoming too tall */
  max-height: 28%;
  overflow: hidden;

  z-index:2;
}

/* Controls (modern size) */
.carousel-control{
  position:absolute;
  top:50%;
  transform:translateY(-50%);
  z-index:3;

  height:46px;
  width:46px;
  border-radius:12px;

  display:flex;
  align-items:center;
  justify-content:center;

  background:rgba(0,0,0,0.35);
  color:#fff;
  cursor:pointer;
  border:0;
  appearance:none;

  transition:transform .12s ease, background .12s ease;
}

.carousel-control::before{
  content:none !important;
}

.carousel-control .carousel-arrow{
  width:22px;
  height:22px;
  display:block;
  stroke:#ffffff;
  stroke-width:3.2;
  fill:none;
  stroke-linecap:round;
  stroke-linejoin:round;
  pointer-events:none;
}

.carousel-control:hover{
  background:rgba(0,0,0,0.55);
  transform:translateY(-50%) scale(1.05);
}

.carousel-control.prev{ left:14px; }
.carousel-control.next{ right:14px; }

/* ✅ Mobile polish */
@media (max-width:768px){
  .custom-carousel{
    height: clamp(240px, 62vw, 360px);
    border-radius:12px;
  }

  .carousel-control{
    height:32px;
    width:32px;
    border-radius:8px;
    font-size: 20px;
  }

  .slide .caption{
    padding:10px 12px;
  }

  /* Optional: smaller school banner on mobile if you enable it */
  .school-banner{
    width:180px;
    top:18px;
  }
  .school-banner img{ max-height:120px; }
  .school-banner p{ font-size:1rem; }
}


/* =========================================================
   4. MODAL (BASE)
   ========================================================= */
.modal{
  display:none;
  position:fixed;
  z-index:1000;
  left:0;
  top:0;
  width:100%;
  height:100%;
  background-color:rgba(255, 255, 255, 0.8);
  justify-content:center;
  align-items:flex-start;
  transition:opacity .3s ease;
  padding: calc(var(--header-height, 64px) + 10px) 12px 12px;
  overflow-y:auto;
}

.modal-content{
  display:flex;
  flex-direction:column;
  align-items:center;
  gap:10px;
  width: min(88%, 480px);
  height:auto;
  max-width:480px;
  max-height: calc(100vh - var(--header-height, 64px) - 28px);
  text-align:center;
  background:#ffffff;
  padding:16px 14px;
  margin-top: 80px;
  border-radius:15px;
  position:relative;
  box-shadow:0 10px 30px rgba(0,0,0,0.3);
  overflow-y:auto;
}

.modalImageContainer{
  display:flex;
  justify-content:center;
  align-items:center;
  background-color:#ffffff;
  width:100%;
  height:auto;
  max-width:100%;
  max-height:22vh;
  border-radius:8px;
  margin-bottom:8px;
  border: 1px solid rgba(15,23,42,0.08);
}
#modalImage{
  max-width:100%;
  max-height:22vh;
  border-radius:6px;
  object-fit:contain;
}

#modalCaption{
  margin-top:8px;
  font-size:0.95rem;
  line-height:1.6;
  padding:10px 0 0 0;
  text-align:left;
  color:#000000;
  overflow-y:auto;
  width:100%;
  max-height:120px;
  box-sizing:border-box;
}

.close-button{
  position:absolute;
  top:8px;
  right:12px;
  font-size:36px;
  cursor:pointer;
  font-weight:bold;
  z-index:10;
  line-height:1;
}
.close-button:hover{
  color:red;
  scale:1.1;
}

/* Modal mobile */
@media (max-width:768px){
  .modal{
    padding: calc(var(--header-height, 56px) + 8px) 10px 10px;
  }
  .modal-content{
    width: min(92%, 380px);
    padding:14px 12px;
    margin-top: 80px;
    max-height: calc(100vh - var(--header-height, 56px) - 20px);
    border-radius:12px;
  }
  .modalImageContainer{
    max-height:20vh;
  }
  #modalImage{
    max-height:20vh;
  }
  #modalCaption{
    font-size:0.8rem;
    line-height:1.4;
    max-height:78px;
    display:-webkit-box;
    line-clamp:4;
    -webkit-line-clamp:4;
    -webkit-box-orient:vertical;
    overflow:hidden;
  }
}
@media (max-width:480px){
  .modal{
    padding: calc(var(--header-height, 56px) + 6px) 8px 8px;
  }
  .modal-content{
    width: min(94%, 340px);
    padding:12px 10px;
    margin-top: 80px;
    max-height: calc(100vh - var(--header-height, 56px) - 16px);
    border-radius:10px;
  }
  .modalImageContainer{
    max-height:16vh;
  }
  #modalImage{
    max-height:16vh;
  }
  #modalCaption{
    font-size:0.74rem;
    max-height:62px;
    line-height:1.35;
    line-clamp:3;
    -webkit-line-clamp:3;
  }
  .close-button{
    font-size:26px;
    top:6px;
    right:10px;
  }
}

/* =========================================================
   5. GALLERY (BASE)
   ========================================================= */
.image-container{
  display:grid;
  grid-template-columns:repeat(auto-fit,minmax(250px,1fr));
  gap:20px;
  padding:20px 40px;
  justify-content:center;
  justify-items:center;
  max-width:90%;
  margin:0 auto;
}

/* ===============================
   CLASSIC — GALLERY GRID (UPDATED)
   Large: 4  | Medium: 3 | Small: 2
   + 1-line caption
   + extra top padding so it doesn't touch the line/header
   =============================== */

/* Give the gallery section breathing room (fixes the “touching” at the top) */
body[data-pd-theme="classic"] .content-section.wf1-section {
  padding-top: 22px !important;
}

/* Extra spacing between the title underline and the grid */
body[data-pd-theme="classic"] .content-section.wf1-section > h2 {
  margin-bottom: 18px !important;
}

/* GRID: default = LARGE (4 columns) */
body[data-pd-theme="classic"] .wf1-gallery,
body[data-pd-theme="classic"] .wf3-gallery-grid,
body[data-pd-theme="classic"] .wf4-gallery-compact,
body[data-pd-theme="classic"] .image-container {
  display: grid !important;
  grid-template-columns: repeat(4, minmax(0, 1fr)) !important;
  gap: 16px !important;

  /* keeps it from becoming too wide on big monitors */
  max-width: 1280px !important;
  margin: 0 auto !important;
  padding: 0 16px !important;
}

/* Wireframes 1/3/4: show ~3 gallery rows, then scroll for the rest */
.wf1-gallery,
.wf3-gallery-grid,
.wf4-gallery-compact {
  max-height: 680px;
  overflow-y: auto;
  overflow-x: hidden;
  padding-right: 6px;
}

/* MEDIUM screens = 3 columns */
@media (max-width: 1100px) {
  body[data-pd-theme="classic"] .wf1-gallery,
  body[data-pd-theme="classic"] .wf3-gallery-grid,
  body[data-pd-theme="classic"] .wf4-gallery-compact,
  body[data-pd-theme="classic"] .image-container {
    grid-template-columns: repeat(3, minmax(0, 1fr)) !important;
    max-width: 1100px !important;
  }
}

/* SMALL screens = 2 columns */
@media (max-width: 700px) {
  body[data-pd-theme="classic"] .wf1-gallery,
  body[data-pd-theme="classic"] .wf3-gallery-grid,
  body[data-pd-theme="classic"] .wf4-gallery-compact,
  body[data-pd-theme="classic"] .image-container {
