  font-weight: 900;
}

.wf4-timeline-container {
  position: relative;
  padding: 0 20px;
}

.wf4-timeline-container::before {
  content: '';
  position: absolute;
  left: 50%;
  top: 0;
  bottom: 0;
  width: 3px;
  background: var(--org-primary-color, #01535b);
  transform: translateX(-50%);
  opacity: 0.25;
}

.wf4-timeline-block {
  display: flex;
  align-items: flex-start;
  margin-bottom: 28px;
  position: relative;
}

.wf4-timeline-left {
  flex-direction: row;
  padding-right: 52%;
}

.wf4-timeline-right {
  flex-direction: row-reverse;
  padding-left: 52%;
}

.wf4-timeline-marker {
  position: absolute;
  left: 50%;
  transform: translateX(-50%);
  z-index: 2;
}

.wf4-timeline-dot {
  width: 16px;
  height: 16px;
  border-radius: 50%;
  background: var(--org-primary-color, #01535b);
