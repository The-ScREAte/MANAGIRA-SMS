/* =========================================================
   BOLD CLASSIC (NEW THEME)
   Activates only when data-pd-theme="bold"
   ========================================================= */

body[data-pd-theme="bold"]{
  background: #0b1020;
  color: #eef2ff;
}

/* Keep all layout widths consistent (same as classic) */
body[data-pd-theme="bold"] .content-section{
  max-width:1280px;
  margin:0 auto 72px auto;
  padding:0 16px;
}

/* Headings: bold + loud underline */
body[data-pd-theme="bold"] .content-section > h2{
  margin:0 0 18px 0;
  text-align:left;
  font-size:1.9rem;
  font-weight:900;
  letter-spacing:0.2px;

  color:#ffffff;
  border-bottom:4px solid #ffb703;
  padding-bottom:10px;
}

/* Cards: stronger contrast + bolder borders */
body[data-pd-theme="bold"] .card,
body[data-pd-theme="bold"] .gallery-card,
body[data-pd-theme="bold"] .draggable-item,
body[data-pd-theme="bold"] .event-card,
body[data-pd-theme="bold"] .announcement-card{
  background: rgba(255,255,255,0.06);
  border: 1px solid rgba(255,255,255,0.14);
  box-shadow: 0 16px 34px rgba(0,0,0,0.45);
  backdrop-filter: blur(10px);
}

/* Carousel: darker base so images pop */
body[data-pd-theme="bold"] .custom-carousel{
  background:#111827;
  box-shadow: 0 20px 45px rgba(0,0,0,0.55);
  border: 1px solid rgba(255,255,255,0.10);
}

/* Carousel caption: bold ribbon */
body[data-pd-theme="bold"] .slide .caption{
  background: linear-gradient(to top, rgba(0,0,0,0.92), rgba(0,0,0,0.25));
  font-weight: 900;
  letter-spacing: 0.2px;
}

/* Carousel controls: louder */
body[data-pd-theme="bold"] .carousel-control{
  background: rgba(255,183,3,0.22);
  border: 1px solid rgba(255,183,3,0.35);
}
body[data-pd-theme="bold"] .carousel-control:hover{
  background: rgba(255,183,3,0.35);
}

/* ✅ Gallery grid for bold (same structure as classic, but NOT scoped to classic) */
body[data-pd-theme="bold"] .wf1-gallery,
body[data-pd-theme="bold"] .wf3-gallery-grid,
body[data-pd-theme="bold"] .wf4-gallery-compact,
body[data-pd-theme="bold"] .image-container{
  display:grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap:16px;
  max-width:1280px;
  margin:0 auto;
  padding:0 16px;
}

@media (max-width:1100px){
  body[data-pd-theme="bold"] .wf1-gallery,
  body[data-pd-theme="bold"] .wf3-gallery-grid,
  body[data-pd-theme="bold"] .wf4-gallery-compact,
  body[data-pd-theme="bold"] .image-container{
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }
}

@media (max-width:700px){
  body[data-pd-theme="bold"] .wf1-gallery,
  body[data-pd-theme="bold"] .wf3-gallery-grid,
  body[data-pd-theme="bold"] .wf4-gallery-compact,
  body[data-pd-theme="bold"] .image-container{
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap:12px;
    padding:0 12px;
  }
}

/* Gallery image: cover to look “bold” (no blank bars) */
body[data-pd-theme="bold"] .gallery-card-image-section img{
  width:100%;
  height:100%;
  object-fit: cover;
  display:block;
}

/* Gallery caption: bold pill */
body[data-pd-theme="bold"] .gallery-card .caption{
  background: linear-gradient(90deg, rgba(255,183,3,0.92), rgba(255,0,110,0.78));
  color:#0b1020;
  font-weight: 900;
  padding:10px 12px;
  font-size:0.95rem;

  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* Articles: keep your horizontal scroll, but darker editor */
body[data-pd-theme="bold"] .draggable-item h3{
  color:#ffb703;
}

body[data-pd-theme="bold"] .draggable-item .ql-editor{
  background: rgba(0,0,0,0.25);
  color:#e5e7eb;
}

/* Events + announcements scrollers stay same behavior */
body[data-pd-theme="bold"] .event-card h3,
body[data-pd-theme="bold"] .announcement-card h3{
  color:#ffb703;
}

body[data-pd-theme="bold"] .event-card p,
body[data-pd-theme="bold"] .announcement-card p{
  color: rgba(255,255,255,0.85);
}

/* About text */
body[data-pd-theme="bold"] #about-us p{
  color: rgba(255,255,255,0.88);
}

/* Modal (optional: make it match dark theme) */
body[data-pd-theme="bold"] .modal{
  background-color: rgba(0,0,0,0.65);
}
body[data-pd-theme="bold"] .modal-content{
  background: #0f172a;
  color: #fff;
  border: 1px solid rgba(255,255,255,0.12);
}
body[data-pd-theme="bold"] #modalCaption{
  color:#fff;
}

