<!DOCTYPE html>
<%
  // Light or dark: a signed-in viewer sees their own choice; everyone else
  // sees the mode the school set for its website (Website mode, default light).
  // Same rule as utils/publicSiteAppearance.js. Prints stay white.
  const pdAppearance = locals.isPrintRender
    ? 'white'
    : (locals.appearanceOwner
        ? (locals.appearance === 'dark' ? 'dark' : 'white')
        : (locals.publicSiteAppearance === 'dark' ? 'dark' : 'white'));
%>
<html lang="en" data-appearance="<%= pdAppearance %>">
  <%
    /* Font: read directly from orgDetails (same as org name/aboutus/theme) — no session needed */
    const selectedPublicFont = (orgDetails && orgDetails.font_style ? String(orgDetails.font_style).trim() : 'Inter') || 'Inter';
    const publicSerifFonts = ['PT Serif', 'Merriweather', 'Playfair Display'];
    const publicFallbackFamily = publicSerifFonts.includes(selectedPublicFont) ? 'serif' : 'sans-serif';
    const loadableGoogleFonts = ['Inter', 'Roboto', 'Open Sans', 'Lato', 'Montserrat', 'Poppins', 'Nunito', 'Raleway', 'Work Sans', 'Source Sans Pro', 'Ubuntu', 'Noto Sans', 'PT Serif', 'Merriweather', 'Playfair Display'];
    const shouldLoadPublicGoogleFont = loadableGoogleFonts.includes(selectedPublicFont);
    const normalizedPublicFont = selectedPublicFont.replace(/\s+/g, '+');
  %>
  <head>
    <meta charset="UTF-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <title><%= title %></title>
    <meta name="viewport" content="<%= locals.viewportContent || 'width=device-width, initial-scale=1.0, maximum-scale=1.0' %>" />
    <style>
      /* Scrolling stays fully functional; the visual scrollbar is hidden. */
      html, body, * { scrollbar-width: none; -ms-overflow-style: none; }
      *::-webkit-scrollbar, *::-webkit-scrollbar-thumb, *::-webkit-scrollbar-track { display: none !important; width: 0 !important; height: 0 !important; }
    </style>

    <!-- SEO Meta Tags -->
    <% if (typeof description !== 'undefined' && description) { %>
      <meta name="description" content="<%= description %>">
    <% } else if (orgDetails && orgDetails.aboutus) { %>
      <meta name="description" content="<%= String(orgDetails.aboutus).replace(/<[^>]*>/g, '').substring(0, 160) %>">
    <% } %>
    <% if (typeof keywords !== 'undefined' && keywords) { %>
      <meta name="keywords" content="<%= keywords %>">
    <% } %>
    <meta name="robots" content="index, follow">
    <meta name="author" content="<%= (orgDetails && (orgDetails.organization_name || orgDetails.nickname_display || orgDetails.nickname)) ? (orgDetails.organization_name || orgDetails.nickname_display || orgDetails.nickname) : 'School' %>">
    <% if (typeof canonicalUrl !== 'undefined' && canonicalUrl) { %>
      <link rel="canonical" href="<%= canonicalUrl %>">
    <% } %>

    <!-- Geo Meta Tags (for local "near me" search ranking) -->
    <% if (orgDetails && orgDetails.geo_lat != null && orgDetails.geo_lng != null) { %>
      <meta name="geo.position" content="<%= orgDetails.geo_lat %>;<%= orgDetails.geo_lng %>">
      <meta name="ICBM" content="<%= orgDetails.geo_lat %>, <%= orgDetails.geo_lng %>">
    <% } %>
    <% if (orgDetails && (orgDetails.organization_country || orgDetails.organization_province)) { %>
      <meta name="geo.region" content="<%= [orgDetails.organization_country, orgDetails.organization_province].filter(Boolean).join('-') %>">
    <% } %>
    <% if (orgDetails && orgDetails.organization_address) { %>
      <meta name="geo.placename" content="<%= orgDetails.organization_address %>">
    <% } %>

    <!-- Open Graph Meta Tags -->
    <meta property="og:type" content="website">
    <meta property="og:site_name" content="<%= (typeof siteName !== 'undefined' && siteName) ? siteName : ((orgDetails && (orgDetails.nickname_display || orgDetails.nickname || orgDetails.organization_name)) ? (orgDetails.nickname_display || orgDetails.nickname || orgDetails.organization_name) : 'School Website') %>">
    <meta property="og:title" content="<%= title %>">
    <% if (typeof description !== 'undefined' && description) { %>
      <meta property="og:description" content="<%= description %>">
    <% } %>
    <% if (typeof canonicalUrl !== 'undefined' && canonicalUrl) { %>
      <meta property="og:url" content="<%= canonicalUrl %>">
    <% } %>
    <%
      const _canonicalOrigin = (() => {
        try {
          return (typeof canonicalUrl !== 'undefined' && canonicalUrl)
            ? new URL(canonicalUrl).origin
            : 'https://www.managira.com';
        } catch (_) {
          return 'https://www.managira.com';
        }
      })();

      const _toAbsolute = (value) => {
        if (!value) return '';
        if (/^https?:\/\//i.test(value)) return value;
        return _canonicalOrigin + (String(value).startsWith('/') ? '' : '/') + value;
      };

      const _schoolLogoCandidate =
        (orgDetails && (orgDetails.logo || orgDetails.logo_path)) ||
        ((req && req.schoolDetails) ? (req.schoolDetails.logo || req.schoolDetails.logo_path) : '') ||
        (session && session.logo) ||
        '';

      const _schoolIcon = _toAbsolute(String(_schoolLogoCandidate || '').trim());

      // Prefer the school's own logo for the link-share preview image (WhatsApp,
      // Facebook, Twitter, etc.) so shared links carry the school's branding
      // instead of Managira's. Only fall back to the platform image for schools
      // that haven't uploaded a logo yet — and only that fallback has known,
      // fixed dimensions, so width/height are omitted for the school's own
      // logo (its real size varies per upload; wrong metadata here can make
      // some platforms render it squished or cropped).
      const _ogImage = _schoolIcon || (_canonicalOrigin + '/images/managira.png');
      const _ogImageWidth = _schoolIcon ? '' : '512';
      const _ogImageHeight = _schoolIcon ? '' : '512';
    %>
    <meta property="og:image" content="<%= _ogImage %>">
    <% if (_ogImageWidth) { %><meta property="og:image:width" content="<%= _ogImageWidth %>"><% } %>
    <% if (_ogImageHeight) { %><meta property="og:image:height" content="<%= _ogImageHeight %>"><% } %>

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="<%= title %>">
    <% if (typeof description !== 'undefined' && description) { %>
      <meta name="twitter:description" content="<%= description %>">
    <% } %>
    <meta name="twitter:image" content="<%= _ogImage %>">
    <meta name="application-name" content="<%= (typeof siteName !== 'undefined' && siteName) ? siteName : ((orgDetails && (orgDetails.nickname_display || orgDetails.nickname || orgDetails.organization_name)) ? (orgDetails.nickname_display || orgDetails.nickname || orgDetails.organization_name) : 'School Website') %>">
    <meta name="apple-mobile-web-app-title" content="<%= (typeof siteName !== 'undefined' && siteName) ? siteName : ((orgDetails && (orgDetails.nickname_display || orgDetails.nickname || orgDetails.organization_name)) ? (orgDetails.nickname_display || orgDetails.nickname || orgDetails.organization_name) : 'School Website') %>">

    <!-- Structured Data (School schema) -->
    <% if (typeof structuredData !== 'undefined' && structuredData) { %>
      <script type="application/ld+json"><%- JSON.stringify(structuredData) %></script>
    <% } %>

    <!-- Favicons -->
    <% if (_schoolIcon) { %>
      <link rel="icon" href="<%= _schoolIcon %>" type="image/png" sizes="48x48" />
      <link rel="icon" href="<%= _schoolIcon %>" type="image/png" sizes="32x32" />
      <link rel="icon" href="<%= _schoolIcon %>" type="image/png" sizes="16x16" />
      <link rel="shortcut icon" href="<%= _schoolIcon %>" type="image/png" />
      <link rel="apple-touch-icon" sizes="180x180" href="<%= _schoolIcon %>" />
      <meta name="msapplication-TileColor" content="#01535b">
      <meta name="msapplication-TileImage" content="<%= _schoolIcon %>">
    <% } else { %>
      <link rel="icon" href="/favicon.ico" type="image/x-icon" sizes="any" />
      <link rel="apple-touch-icon" sizes="180x180" href="/images/favicon_io/apple-touch-icon.png" />
      <link rel="icon" type="image/png" sizes="32x32" href="/images/favicon_io/favicon-32x32.png" />
      <link rel="icon" type="image/png" sizes="16x16" href="/images/favicon_io/favicon-16x16.png" />
      <link rel="manifest" href="/images/favicon_io/site.webmanifest" />
    <% } %>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <% if (shouldLoadPublicGoogleFont) { %>
      <link href="https://fonts.googleapis.com/css2?family=<%= normalizedPublicFont %>:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
    <% } %>
    <% if (site.articles.length) { %><link href="https://cdn.quilljs.com/1.3.6/quill.snow.css" rel="stylesheet" /><% } %>
    <% if (['classic', 'editorial', 'story'].includes(site.layout)) { %><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@600;700;900&display=swap" /><% } %>
    <link rel="stylesheet" href="<%= assetUrl('/css/school-website.css') %>" />

    <style>
<%
  /* Brand color for the school website (works even when not signed in). */
  const pdThemeColorMap = themePalette;
  const pdOrgThemeKey = (orgDetails && orgDetails.theme_color) ? orgDetails.theme_color : 'teal';
  const pdOrgTheme = pdThemeColorMap[pdOrgThemeKey] || pdThemeColorMap.teal;
%>
:root{
  --font-family:"<%= selectedPublicFont %>",<%= publicFallbackFamily %>;
  --org-primary-color: <%= pdOrgTheme.primary %>;
  --org-primary-hover: <%= pdOrgTheme.hover %>;
  --org-primary-soft: color-mix(in srgb, var(--org-primary-color) 10%, white);
  --org-primary-soft-strong: color-mix(in srgb, var(--org-primary-color) 16%, white);
  --org-primary-soft-border: color-mix(in srgb, var(--org-primary-color) 28%, white);
  --org-primary-hover-fill: color-mix(in srgb, var(--org-primary-color) 88%, white);
}
html, body { margin: 0; padding: 0; width: 100%; }
body { font-family: var(--font-family); }
body[data-page="publicDashboard"] #top-header #tools #loginbutton { min-height: 26px; padding: 3px 8px; font-size: 0.84rem; line-height: 1; }
@media (max-width: 768px) {
  body[data-page="publicDashboard"] #top-header #tools #loginbutton { min-height: 24px; padding: 2px 7px; font-size: 0.8rem; }
}
    </style>

    <link rel="stylesheet" href="<%= assetUrl('/css/appearance.css') %>">
    <% if (pdAppearance !== 'white') { %><script src="<%= assetUrl('/js/appearance.js') %>" defer></script><% } %>
  </head>
  <body data-page="publicDashboard" data-pd-theme="<%= publicDashboardTheme || 'classic' %>" data-pd-layout="<%= publicDashboardLayout || 'wireframe1' %>" data-sw-layout="<%= site.layout %>">
    <%- include('../partials/header') %>
    <%- include('../partials/flash') %>
    <% if (req.query.success === '1') { %>
      <div class="alert alert-success">Registration and payment completed successfully!</div>
    <% } %>
    
    <%
      // Text color that reads well on the school's brand color.
      const swHex = String(pdOrgTheme.primary || '#0f5a66').replace('#', '');
      const swRgb = swHex.length === 6 ? [0, 2, 4].map((i) => parseInt(swHex.slice(i, i + 2), 16) / 255) : [0.06, 0.35, 0.4];
      const swLum = swRgb.map((c) => (c <= 0.03928 ? c / 12.92 : Math.pow((c + 0.055) / 1.055, 2.4))).reduce((sum, c, i) => sum + c * [0.2126, 0.7152, 0.0722][i], 0);
      const swOnAccent = swLum > 0.45 ? '#111827' : '#ffffff';
    %>
    <div style="--sw-on-accent: <%= swOnAccent %>;">
      <%- include('../partials/website/site', { site }) %>
    </div>

  </body>
</html>
