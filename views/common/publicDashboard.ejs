    <script>
      document.addEventListener("DOMContentLoaded", function () {
        const slides = document.querySelectorAll("#carouselExample .slide");
        const captions = document.querySelectorAll("#carouselExample .caption");
        const prevBtn = document.getElementById("carouselPrevBtn");
        const nextBtn = document.getElementById("carouselNextBtn");

        let currentIndex = 0;

        function showSlide(newIndex) {
          if (newIndex < 0) newIndex = slides.length - 1;
          if (newIndex >= slides.length) newIndex = 0;
          slides.forEach((slide) => slide.classList.remove("active"));
          captions.forEach((caption) => caption.classList.remove("active"));
          slides[newIndex].classList.add("active");
          captions[newIndex].classList.add("active");
          currentIndex = newIndex;
        }

        if (!prevBtn || !nextBtn) return;
        prevBtn.addEventListener("click", () => showSlide(currentIndex - 1));
        nextBtn.addEventListener("click", () => showSlide(currentIndex + 1));

        // Automatic slide change every 5 seconds
        setInterval(() => {
          showSlide(currentIndex + 1);
        }, 5000);

        // Initialize the first slide
        if (slides.length > 0) slides[currentIndex].classList.add("active");
        if (captions.length > 0) captions[currentIndex].classList.add("active");
      });

      // WF2 horizontal rows: drag-to-scroll support for desktop/medium screens.
      document.addEventListener("DOMContentLoaded", function () {
        const scrollers = document.querySelectorAll(".wf2-events-priority, .wf2-announcements-list, .wf2-articles-scroll");
        if (!scrollers.length) return;

        const hintTimers = new WeakMap();

        const getHintHost = (scroller) => {
          return scroller.closest(".wf2-right-events, .wf2-right-announcements, .wf2-articles-section");
        };

        const hasMoreToScrollRight = (scroller) => {
          const hasHorizontalOverflow = scroller.scrollWidth - scroller.clientWidth > 8;
          const atRightEdge = scroller.scrollLeft + scroller.clientWidth >= scroller.scrollWidth - 8;
          return hasHorizontalOverflow && !atRightEdge;
        };

        const clearHintForHost = (hintHost) => {
          if (!hintHost) return;
          const activeTimer = hintTimers.get(hintHost);
          if (activeTimer) {
            clearTimeout(activeTimer);
            hintTimers.delete(hintHost);
          }
          hintHost.classList.remove("has-right-scroll-hint");
        };

        const showHintForFiveSeconds = (scroller) => {
          const hintHost = getHintHost(scroller);
          if (!hintHost) return;

          if (!hasMoreToScrollRight(scroller)) {
            clearHintForHost(hintHost);
            return;
          }

          if (hintTimers.has(hintHost)) return;

          hintHost.classList.add("has-right-scroll-hint");
          const timerId = setTimeout(() => {
            hintHost.classList.remove("has-right-scroll-hint");
            hintTimers.delete(hintHost);
          }, 5000);
          hintTimers.set(hintHost, timerId);
        };

        const refreshScrollerHints = () => {
          scrollers.forEach((scroller) => {
            const hintHost = getHintHost(scroller);
            if (!hintHost) return;
            if (!hasMoreToScrollRight(scroller)) {
              clearHintForHost(hintHost);
            }
          });
        };

        scrollers.forEach((scroller) => {
          let isDragging = false;
          let startX = 0;
          let startScrollLeft = 0;

          const endDrag = () => {
            isDragging = false;
            scroller.classList.remove("is-dragging-scroll");
          };

          scroller.addEventListener("mousedown", (event) => {
            if (event.button !== 0) return;
            if (event.target.closest("a, button, input, textarea, select")) return;

            isDragging = true;
            scroller.classList.add("is-dragging-scroll");
            startX = event.clientX;
            startScrollLeft = scroller.scrollLeft;
            showHintForFiveSeconds(scroller);
          });

          scroller.addEventListener("mousemove", (event) => {
            if (!isDragging) return;
            event.preventDefault();
            const delta = event.clientX - startX;
            scroller.scrollLeft = startScrollLeft - delta;
          });

          scroller.addEventListener("touchstart", () => showHintForFiveSeconds(scroller), {
            passive: true,
          });

          scroller.addEventListener("scroll", () => showHintForFiveSeconds(scroller), {
            passive: true,
          });

          scroller.addEventListener("mouseleave", endDrag);
          scroller.addEventListener("mouseup", endDrag);
          window.addEventListener("mouseup", endDrag);
        });

        if ("IntersectionObserver" in window) {
          const hintObserver = new IntersectionObserver((entries) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return;
              const hintHost = entry.target;
              const scroller = hintHost.querySelector(".wf2-events-priority, .wf2-announcements-list, .wf2-articles-scroll");
              if (!scroller) return;
              showHintForFiveSeconds(scroller);
            });
          }, { threshold: 0.35 });

          scrollers.forEach((scroller) => {
            const hintHost = getHintHost(scroller);
            if (hintHost) hintObserver.observe(hintHost);
          });
        }

        window.addEventListener("resize", refreshScrollerHints);
        window.addEventListener("load", refreshScrollerHints);
        requestAnimationFrame(refreshScrollerHints);
        setTimeout(refreshScrollerHints, 220);
      });

      // Function to save the order of draggable sections
      document.addEventListener("DOMContentLoaded", function () {
        const saveOrderButton = document.getElementById("save-order-btn");
        let draggedSection = null;

        // Enable dragging for all sections
        document.querySelectorAll(".draggable-section").forEach((section) => {
          section.addEventListener("dragstart", (e) => {
            draggedSection = section;
            section.classList.add("dragging");
            setTimeout(() => section.classList.add("hidden"), 0);
          });

          section.addEventListener("dragover", (e) => {
            e.preventDefault();
            const afterElement = getDragAfterElement(e.clientY);
            if (afterElement == null) {
              document.body.appendChild(draggedSection); // Append to end if last
            } else {
              afterElement.parentNode.insertBefore(
                draggedSection,
                afterElement
              );
            }
          });

          section.addEventListener("dragend", () => {
            draggedSection.classList.remove("dragging", "hidden");
          });
        });

        function getDragAfterElement(y) {
          const draggableElements = [
            ...document.querySelectorAll(".draggable-section:not(.dragging)"),
          ];
          return draggableElements.reduce(
            (closest, child) => {
              const box = child.getBoundingClientRect();
              const offset = y - box.top - box.height / 2;
              if (offset < 0 && offset > closest.offset) {
                return { offset, element: child };
              } else {
                return closest;
              }
            },
            { offset: Number.NEGATIVE_INFINITY }
          ).element;
        }

        function saveSectionOrder() {
          const sectionOrder = [
            ...document.querySelectorAll(".draggable-section"),
          ].map((section) => section.dataset.sectionId);

          fetch("/common/save-order", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ order: sectionOrder }),
          })
            .then((response) => response.json())
            .then((data) => {
              if (data.success) {
                alert("Order saved successfully!");
              } else {
                alert("❌ Failed to save section order.");
              }
            })
            .catch((error) => console.error("Error saving order:", error));
        }

        // ✅ Save Order when clicking the button
        if (saveOrderButton) {
          saveOrderButton.addEventListener("click", saveSectionOrder);
        }
      });

      /*Modal Logic*/

      document.addEventListener("DOMContentLoaded", function () {
        const modal = document.getElementById("imageModal");
        const modalImage = document.getElementById("modalImage");
        const modalCaption = document.getElementById("modalCaption");
        const closeButton = document.querySelector(".close-button");

        if (!modal || !closeButton) return;

        function openModal(imageSrc, captionText) {
          modal.style.display = "flex"; // Show modal
          modalImage.src = imageSrc;
          if (modalCaption) modalCaption.textContent = captionText || "No caption available";
        }

        function closeModal() {
          modal.style.display = "none"; // Hide modal
        }

        closeButton.addEventListener("click", closeModal);

        // Close modal when clicking outside of modal content
        modal.addEventListener("click", function (event) {
          if (event.target === modal) {
            closeModal();
          }
        });

        // ✅ Use event delegation for dynamically loaded elements
        document.addEventListener("click", function (event) {
          let target = event.target;

          // 🔹 If clicking on a slideshow image
          if (target.closest(".slide-image img")) {
            let imageSrc = target.src;
            let captionText =
              target.closest(".slide").querySelector(".caption")?.textContent ||
              "No caption";
            openModal(imageSrc, captionText);
          }

// 🔹 If clicking on ANY gallery image (works for wf1/wf2/wf3/wf4 + fallback)
const galleryImg = target.closest(".gallery-card-image-section img");
if (galleryImg) {
  const imageSrc = galleryImg.src;

  // caption is full in DOM; CSS only truncates display
  const captionText =
    galleryImg.closest(".gallery-card")?.querySelector(".caption")?.textContent?.trim()
    || "No caption";

  openModal(imageSrc, captionText);
}
        });
      });
    </script>
