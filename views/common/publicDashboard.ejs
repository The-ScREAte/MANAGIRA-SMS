   ========================================================= */

/* ===== WIREFRAME 2: SPLIT DASHBOARD ===== */
.wf2-hero-split {
  display: grid;
  grid-template-columns: 1.6fr 1fr;
  gap: 28px;
  max-width: 1280px;
  margin: 0 auto 56px;
  padding: 0 24px;
}

.wf2-left-panel h2,
.wf2-right-panel h2 {
  margin: 0 0 18px;
  font-size: 1.65rem;
  font-weight: 900;
}

.wf2-gallery-masonry {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 14px;
}

.wf2-gallery-masonry .gallery-card {
  width: 100%;
  margin: 0;
  overflow: hidden;
  border-radius: 12px;
}

.wf2-gallery-masonry .gallery-card-image-section {
  height: clamp(110px, 12vw, 160px);
}

.wf2-gallery-masonry .gallery-card-image-section img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}

.wf2-right-panel {
  display: flex;
  flex-direction: column;
}

.wf2-events-priority {
  display: flex;
  flex-direction: column;
  gap: 12px;
  flex: 1;
  overflow-y: auto;
  max-height: 520px;
  padding-right: 4px;
}

.wf2-event-badge {
  display: flex !important;
  flex-direction: row !important;
  align-items: flex-start !important;
  gap: 14px;
  padding: 14px !important;
  height: auto !important;
}

.wf2-event-date-badge {
  flex-shrink: 0;
  background: var(--org-primary-color, #01535b);
  color: #fff;
  padding: 10px 14px;
  border-radius: 10px;
  font-weight: 800;
  font-size: 0.85rem;
  text-align: center;
  min-width: 64px;
  line-height: 1.3;
}

.wf2-event-content h3 { margin: 0 0 4px; font-size: 1rem; }
.wf2-event-content p { margin: 0; font-size: 0.9rem; line-height: 1.5; }

.wf2-articles-section {
  max-width: 1280px;
  margin: 0 auto 56px;
  padding: 0 24px;
}
.wf2-articles-section h2 {
  margin: 0 0 18px;
  font-size: 1.65rem;
  font-weight: 900;
}

.wf2-announcements-sidebar {
