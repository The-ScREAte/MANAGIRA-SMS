  <body class="manage-records-page">
    <br />
    <%- include('../partials/flash') %>
    <div class="note-section" id="noteSection">
      <button class="close-note" onclick="closeNote()">&times;</button>
      <p>
        <strong>Note:</strong> Use this page to manage school years and terms.
        You can add, edit, delete, and set the current school year or term.
      </p>
    </div>

    <br />
    <!-- Add the link to the Register School Year page -->
    <div class="link-to-next-back">
      <a href="/common/registerSchoolYear" class="create-link"
        >Create School Year</a
      >
    </div>
    <hr />

    <div class="container">
      <fieldset>
        <h1>Manage School Years and Terms</h1>
        <legend>School Years</legend>

        <div id="schoolYearContainer">
          <% schoolYears.forEach(function(year) { %>
          <div
            class="school-year-wrapper <%= year.current ? 'current-year-wrapper' : '' %>"
            id="yearWrapper<%= year.id %>"
          >
            <form
              action="/common/updateSchoolYearAndTerms"
              method="post"
              class="school-year-form"
              onsubmit="return validateAndConfirmChanges(this)"
            >
              <input type="hidden" name="yearId" value="<%= year.id %>" />
              <div
                class="school-year-header"
                onclick="toggleTerms('<%= year.id %>')"
              >
                <label class="year-label" style="display: flex; align-items: center; gap: 6px;">
                  <% if (year.current) { %>
                  <span class="current-year-indicator"></span>
                  <% } %>
                  School<br>Year:
                </label>
                <input
                  type="text"
                  name="year_label"
                  value="<%= year.year_label %>"
                  required
                  onclick="event.stopPropagation()"
                />
                <label class="current-label">
                  <input 
                    type="radio" 
                    name="currentYear" 
                    value="<%= year.id %>"
                    <%= year.current ? 'checked' : '' %>
                    onclick="event.stopPropagation()"
                  > 
                  Current
                </label>
                
                <div class="year-menu-container">
                  <span class="arrow" id="arrow<%= year.id %>">&#9660;</span>
                  
                  <!-- Three-dot menu for delete school year -->
                  <div class="term-menu-container" onclick="event.stopPropagation()">
                    <button type="button" class="term-menu-button" onclick="toggleYearMenu(event, this)">
                      ⋮
                    </button>
                    <div class="term-menu-dropdown">
                      <button
                        type="button"
                        class="term-menu-item delete"
                        onclick="deleteSchoolYear('<%= year.id %>', this)"
                      >
                        Delete School Year
                      </button>
                    </div>
                  </div>
                </div>
              </div>

              <div
                class="term-section"
                id="termSection<%= year.id %>"
                style="display: '<%= year.current ? 'block' : 'none' %>'"
              >
                <% year.terms.forEach(function(term) { %>
                <fieldset style="position: relative">
                  <legend>Term / Semester</legend>

                  <input
                    type="hidden"
                    name="termIds[]"
                    value="<%= term.term_id %>"
                  />
                  <div class="term-section-header">
                    <% if (term.current) { %>
                    <span class="current-term-indicator"></span>
                    <% } %>
                    <input
                      type="text"
                      name="termNames[]"
                      value="<%= term.term_name %>"
                      placeholder="Term / Semester Name"
                      required
                    />
                    <label>
                      <input type="radio" name="currentTerm" value="<%=
                      term.term_id %>" <%= term.current ? 'checked' : '' %>>
                      Current
                    </label>
                    
                    <!-- Three-dot menu for delete option -->
                    <div class="term-menu-container">
                      <button type="button" class="term-menu-button" onclick="toggleTermMenu(event, this)">
                        ⋮
                      </button>
                      <div class="term-menu-dropdown">
                        <button
                          type="button"
                          class="term-menu-item delete"
                          onclick="deleteTerm('<%= term.term_id %>', this)"
                        >
                          Delete Term
                        </button>
                      </div>
                    </div>
                  </div>
                  <div class="date-fields">
                    <div>
                      <label>Start Date:</label>
                      <input
                        type="date"
                        name="startDates[]"
                        value="<%= new Date(term.start_date).toISOString().slice(0, 10) %>"
                        required
                      />
                    </div>
                    <div>
                      <label>End Date:</label>
                      <input
                        type="date"
                        name="endDates[]"
                        value="<%= new Date(term.end_date).toISOString().slice(0, 10) %>"
                        required
                      />
                    </div>
                  </div>
                </fieldset>
                <% }); %>
              </div>

              <a href="#" onclick="addTermToSchoolYear('<%= year.id %>')"
                >Add Term / Semester</a
              >

              <button type="submit" class="save-button">Save Changes</button>
            </form>
          </div>
          <hr />
          <% }); %>
        </div>
      </fieldset>
    </div>

    <script>
      // Toggle terms visibility
      function toggleTerms(yearId) {
        const termSection = document.getElementById(`termSection${yearId}`);
        const arrow = document.getElementById(`arrow${yearId}`);

        if (termSection.style.display === "none") {
          termSection.style.display = "block";
          arrow.innerHTML = "&#9650;"; // Change to up arrow
        } else {
          termSection.style.display = "none";
          arrow.innerHTML = "&#9660;"; // Change to down arrow
        }
      }

      // Validation to ensure the current term belongs to the selected current school year
      function validateAndConfirmChanges(form) {
        const currentYearSelected = form.querySelector(
          'input[type="radio"][name="currentYear"]:checked'
        );
        const currentTermSelected = form.querySelector(
          'input[type="radio"][name="currentTerm"]:checked'
        );

        // --- Prevent overlapping term dates ---
        const startDates = Array.from(form.querySelectorAll('input[name="startDates[]"]'));
        const endDates = Array.from(form.querySelectorAll('input[name="endDates[]"]'));
        const termNames = Array.from(form.querySelectorAll('input[name="termNames[]"]'));
        let ranges = [];
        for (let i = 0; i < startDates.length; i++) {
          const start = new Date(startDates[i].value);
          const end = new Date(endDates[i].value);
          if (start > end) {
            alert(`Start date must be before end date for term: ${termNames[i].value}`);
            return false;
          }
          ranges.push({start, end, name: termNames[i].value});
        }
        // Check for overlaps
        for (let i = 0; i < ranges.length; i++) {
          for (let j = i + 1; j < ranges.length; j++) {
            if (
              (ranges[i].start <= ranges[j].end && ranges[i].end >= ranges[j].start)
            ) {
              alert(`Date ranges for terms "${ranges[i].name}" and "${ranges[j].name}" overlap. Please correct them.`);
              return false;
            }
          }
        }
        // --- End overlap check ---

        if (currentYearSelected) {
          const currentYearId = parseInt(currentYearSelected.value, 10);
          // Try to get the year label from the input field in the same form
          let yearLabel = '';
          const yearLabelInput = form.querySelector('input[name="year_label"]');
          if (yearLabelInput) {
            yearLabel = yearLabelInput.value;
          }
          // Ensure that the selected current term belongs to the current year
          if (currentTermSelected) {
            const termSection = document.getElementById(
              `termSection${currentYearId}`
            );
            if (!termSection) {
              alert(
                `The selected current term does not belong to the selected current school year. Please correct your selection.`
              );
              return false; // Prevent form submission
            }
            const selectedTermId = parseInt(currentTermSelected.value, 10);
            const validTermIds = Array.from(
              termSection.querySelectorAll(
                'input[type="hidden"][name="termIds[]"]'
              )
            ).map((termInput) => parseInt(termInput.value, 10));
            if (!validTermIds.includes(selectedTermId)) {
              alert(
                `The selected current term does not belong to the selected current school year. Please correct your selection.`
              );
              return false; // Prevent form submission
            }
          } else {
            if (yearLabel) {
              alert(
                `School year "${yearLabel}" is set as current, but no term is selected as current. Please select a term.`
              );
            } else {
              alert(
                `A school year is set as current, but no term is selected as current. Please select a term for the current school year.`
              );
            }
            return false; // Prevent form submission
          }
        }

        return confirm(
          `You are about to save changes to the school year. Do you want to proceed?`
        );
      }

      function closeNote() {
        document.getElementById("noteSection").style.display = "none";
      }

      // Toggle three-dot menu for term actions
      function toggleTermMenu(event, button) {
        event.stopPropagation();
        const dropdown = button.nextElementSibling;
        const isCurrentlyShown = dropdown.classList.contains('show');
        
        // Close all other open menus
        document.querySelectorAll('.term-menu-dropdown.show').forEach(menu => {
          menu.classList.remove('show');
        });
        
        // Toggle current menu
        if (!isCurrentlyShown) {
          dropdown.classList.add('show');
        }
      }

      // Toggle three-dot menu for school year actions
      function toggleYearMenu(event, button) {
        event.stopPropagation();
        const dropdown = button.nextElementSibling;
        const isCurrentlyShown = dropdown.classList.contains('show');
        
        // Close all other open menus
        document.querySelectorAll('.term-menu-dropdown.show').forEach(menu => {
          menu.classList.remove('show');
        });
        
        // Toggle current menu
        if (!isCurrentlyShown) {
          dropdown.classList.add('show');
        }
      }

      // Delete school year function
      async function deleteSchoolYear(yearId, button) {
        if (!confirm('Are you sure you want to delete this school year?')) {
          return;
        }

        try {
          const response = await fetch('/common/deleteSchoolYear', {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
            body: new URLSearchParams({ yearId: yearId })
          });

          if (response.ok) {
            alert('School year deleted successfully.');
            window.location.reload();
          } else {
            const data = await response.json();
            alert(data.message || 'Failed to delete school year.');
          }
        } catch (err) {
          alert('An error occurred while deleting the school year.');
          console.error(err);
        }
      }

      // Close dropdown when clicking outside
      document.addEventListener('click', function(event) {
        if (!event.target.closest('.term-menu-container')) {
          document.querySelectorAll('.term-menu-dropdown.show').forEach(menu => {
            menu.classList.remove('show');
          });
        }
      });

      document.addEventListener("DOMContentLoaded", function () {
        let schoolYearContainer = document.getElementById(
          "schoolYearContainer"
        );

        let schoolYearWrappers = Array.from(
          schoolYearContainer.getElementsByClassName("school-year-wrapper")
        );

        // Sort school years by year label
        schoolYearWrappers.sort((a, b) => {
          let yearA = parseInt(
            a.querySelector('input[name="year_label"]').value
          );
          let yearB = parseInt(
            b.querySelector('input[name="year_label"]').value
          );
          return yearA - yearB;
        });

        // Re-append sorted elements to the container
        schoolYearContainer.innerHTML = "";
        schoolYearWrappers.forEach((wrapper) => {
          schoolYearContainer.appendChild(wrapper);
        });

        // Sort terms within each school year
        schoolYearWrappers.forEach((schoolYearWrapper) => {
          let termSections =
            schoolYearWrapper.getElementsByClassName("term-section");

          Array.from(termSections).forEach((termSection) => {
            let termFields = Array.from(
              termSection.getElementsByTagName("fieldset")
            );

            termFields.sort((a, b) => {
              let termA = a.querySelector('input[name="termNames[]"]').value;
              let termB = b.querySelector('input[name="termNames[]"]').value;
              return termA.localeCompare(termB);
            });

            termSection.innerHTML = "";
            termFields.forEach((termField) => {
              termSection.appendChild(termField);
            });
          });
        });
      });

      function addTermToSchoolYear(yearId) {
        event.preventDefault();
        const termSection = document.getElementById(`termSection${yearId}`);
        const termDiv = document.createElement("fieldset");
        termDiv.innerHTML = `
          <legend>Term / Semester</legend>
          <input type="hidden" name="termIds[]" value="" />
          <div class="term-section-header">
            <input type="text" name="termNames[]" placeholder="Term / Semester Name" required />
            <label>
              <input type="radio" name="currentTerm" value=""> Current
            </label>
          </div>
          <div class="date-fields">
            <div>
              <label>Start Date:</label>
              <input type="date" name="startDates[]" required />
            </div>
            <div>
              <label>End Date:</label>
              <input type="date" name="endDates[]" required />
            </div>
          </div>
        `;
        termSection.appendChild(termDiv);
      }

