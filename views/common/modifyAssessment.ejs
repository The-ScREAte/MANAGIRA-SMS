<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Modify Assessment</title>
    <style>
      :root {
        --font-family: "<%= (session && session.fontStyle ? String(session.fontStyle).trim() : 'Inter') %>", sans-serif;
      }


        body {
      font-family: var(--font-family);
      background: #fff;
      margin: 0;
    }
    main {
      text-align: center;
      margin: 0 auto;
      width: 90%;
      padding-bottom: 32px;
    }
    .center-link {
      display: flex;
      justify-content: center;
      align-items: center;
      margin-bottom: 20px;
    }
    .center-link button {
      padding: 10px 28px;
      border: none;
      background-color: var(--org-primary-color);
      color: white;
      cursor: pointer;
      border-radius: 6px;
      font-size: 1rem;
      font-weight: 500;
      width: auto;
      min-width: 120px;
      box-shadow: 0 2px 8px rgba(1,83,91,0.08);
      transition: background 0.2s;
      margin: 0 auto;
      display: inline-block;
    }
    .center-link button:hover {
      background-color: var(--org-primary-hover);
    }
    .main-heading {
      text-align: center;
      font-size: 1.6rem;
      margin: 18px 0 10px 0;
      color: #222;
      font-weight: 600;
    }
    .notice {
      background-color: #e7f3fe;
      color: #0c5460;
      border: 1px solid #bee5eb;
      border-radius: 7px;
      padding: 15px 18px;
      margin: 0 auto 20px auto;
      max-width: 480px;
      word-break: break-word;
      text-align: center;
      font-size: 1rem;
      box-shadow: 0 2px 8px rgba(1,83,91,0.07);
    }
    .modify-assessment-card {
      background: #fff;
      border: 1px solid #e0e0e0;
      box-shadow: 0 2px 12px rgba(1,83,91,0.12);
      border-radius: 14px;
      max-width: 440px;
      margin: 0 auto 24px auto;
      padding: 28px 24px 22px 24px;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 14px;
    }
    .form-group {
      margin-bottom: 12px;
      width: 100%;
      display: flex;
      flex-direction: column;
      align-items: flex-start;
    }
    .form-group label {
      margin-bottom: 6px;
      font-weight: 500;
      font-size: 1rem;
      color: #222;
    }
    .form-group input,
    .form-group select {
      width: 100%;
      padding: 8px 10px;
      border: 1px solid #cfd8dc;
      border-radius: 5px;
      font-size: 1rem;
      background: #f7f7f7;
      box-sizing: border-box;
      color: #222;
    }
    .form-group input:focus,
    .form-group select:focus {
      border-color: #01535b;
      box-shadow: 0 0 0 2px #01535b33;
      outline: none;
    }
    .modify-classes-heading {
      text-align: center;
      margin-bottom: 8px;
      font-size: 1.1rem;
      font-weight: 600;
      color: #222;
    }
    .select-all-container {
      display: flex;
      align-items: center;
      gap: 8px;
      margin-bottom: 12px;
      justify-content: flex-start;
      width: 100%;
    }
    .select-all-container label {
      font-weight: 500;
      color: #01535b;
      font-size: 1rem;
      margin: 0;
      padding: 0;
    }
    .class-checkbox {
      display: flex;
      align-items: center;
      gap: 8px;
      font-weight: 400;
      color: #222;
      margin-bottom: 2px;
      width: 100%;
    }
    .class-checkbox input[type="checkbox"] {
      margin: 0 0 0 2px;
      width: 18px;
      height: 18px;
    }
    .class-checkbox label {
      font-weight: 400;
      color: #222;
      font-size: 1rem;
      margin: 0;
      padding: 0;
    }
    .subject-container {
      margin-left: 18px;
      margin-top: 4px;
      padding-left: 12px;
      border-left: 2px solid #e0e0e0;
      width: 100%;
      display: none;
    }
    .subject-container.visible {
      display: block;
    }
    .subject-checkbox {
      display: flex;
      align-items: center;
      gap: 8px;
      font-weight: 400;
      color: #222;
      margin-bottom: 2px;
      width: 100%;
    }
    .subject-checkbox input[type="checkbox"] {
      margin: 0 0 0 2px;
      width: 18px;
      height: 18px;
    }
    .subject-checkbox label {
      font-weight: 400;
      color: #222;
      font-size: 1rem;
      margin: 0;
      padding: 0;
    }
    .form-actions {
      display: flex;
      justify-content: center;
      align-items: center;
      gap: 16px;
      margin: 18px 0 28px 0;
      width: 100%;
    }
    .submit-btn {
      background: #01535b;
      color: #fff;
      border: none;
      border-radius: 6px;
      padding: 10px 28px;
      font-size: 1rem;
      font-weight: 600;
      cursor: pointer;
      box-shadow: 0 2px 8px rgba(1,83,91,0.08);
      transition: background 0.2s;
      min-width: 120px;
      width: auto;
      margin-top: 0 !important;
    }
    .submit-btn:hover {
      background: #013a40;
    }
    .delete-button {
      background-color: #e53935;
      color: #fff;
      border: none;
      border-radius: 6px;
      padding: 10px 28px;
      font-size: 1rem;
      font-weight: 600;
      cursor: pointer;
      box-shadow: 0 2px 8px rgba(1,83,91,0.08);
      transition: background 0.2s;
      min-width: 120px;
      width: auto;
    }
    .delete-button:hover {
      background-color: #b71c1c;
    }
    .collapsible-btn {
      width: 70%;
      margin: 0 auto 8px auto;
      background: #01535b;
      color: #fff;
      border: none;
      outline: none;
      padding: 7px 14px;
      font-size: 15px;
      text-align: left;
      display: flex;
      align-items: center;
      justify-content: flex-start;
      cursor: pointer;
      border-radius: 5px;
      transition: none;
    }
    .collapsible-btn .arrow {
      font-size: 18px;
      margin-left: 8px;
      transition: transform 0.2s;
    }
    .collapsible-content {
      background: #f9f9f9;
      border-radius: 6px;
      margin-top: 6px;
      padding: 16px 18px 16px 18px;
      width: 100%;
    }
    .collapsible-btn:hover,
    .collapsible-btn:focus {
      background: #01535b;
      color: #fff;
      box-shadow: none;
    }
    /* ── Checkbox global styling ── */
    input[type="checkbox"] {
      appearance: none;
      -webkit-appearance: none;
      width: 18px;
      height: 18px;
      border: 2px solid #b0bec5;
      border-radius: 4px;
      background: #fff;
      cursor: pointer;
      flex-shrink: 0;
      transition: background 0.15s, border-color 0.15s;
      position: relative;
    }
    input[type="checkbox"]:checked {
      background: #01535b;
      border-color: #01535b;
    }
    input[type="checkbox"]:checked::after {
      content: '';
      position: absolute;
      left: 3px;
      top: 0px;
      width: 5px;
      height: 10px;
      border: 2px solid #fff;
      border-top: none;
      border-left: none;
      transform: rotate(45deg);
    }
    input[type="checkbox"]:focus {
      outline: none;
      box-shadow: 0 0 0 3px rgba(1,83,91,0.18);
    }
    /* ── Control checkboxes ── */
    .control-group {
      width: 100%;
      background: #f4f8fa;
      border: 1px solid #dde4ec;
      border-radius: 9px;
      padding: 14px 16px;
      display: flex;
      flex-direction: column;
      gap: 10px;
    }
    .control-group-title {
      font-size: 0.8rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      color: #607080;
      margin-bottom: 2px;
    }
    .check-row {
      display: flex;
      align-items: center;
      gap: 10px;
      cursor: pointer;
    }
    .check-row label {
      margin: 0;
      padding: 0;
      font-size: 0.95rem;
      font-weight: 500;
      color: #1a2e35;
      cursor: pointer;
    }
    /* ── Date group ── */
    .date-group {
      width: 100%;
      background: #f4f8fa;
      border: 1px solid #dde4ec;
      border-radius: 9px;
      padding: 14px 16px;
      display: flex;
      flex-direction: column;
      gap: 12px;
    }
    .date-group-title {
      font-size: 0.8rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      color: #607080;
      margin-bottom: 0;
    }
    </style>
</head>
<body>
<main>
    <br />
    <%- include('../partials/flash') %>

    <br>
    <div class="center-link">
        <button onclick="location.href='/common/manageAssessment?organizationId=<%= organizationId %>&termId=<%= termId %>'">Back to All Assessment</button>
    </div>
<hr>
    <form id="modifyAssessmentForm">
      <div class="modify-assessment-card">
        <h3 class="main-heading">Modify Assessment</h3>
        <input type="hidden" name="organizationId" value="<%= organizationId %>">
        <input type="hidden" name="termId" value="<%= termId %>">
        <input type="hidden" name="groupId" value="<%= groupId %>">
        <div class="form-group">
          <label for="testName">Test Name:</label>
          <input type="text" name="testName" value="<%= assessment.title %>" required>
        </div>
        <div class="form-group">
          <label for="testWeight">Test Weight (%):</label>
          <input type="number" name="testWeight" step="0.1" value="<%= assessment.weight %>" required>
        </div>
        <div class="form-group">
          <label for="maxScore">Score Out Of:</label>
          <input type="number" name="maxScore" value="<%= assessment.max_score %>" required>
        </div>
        <div class="form-group">
          <label for="category">Category:</label>
          <select name="category" required>
            <option value="Class Assessment" <%= assessment.category === 'Class Assessment' ? 'selected' : '' %>>Class Assessment</option>
            <option value="Exams Assessment" <%= assessment.category === 'Exams Assessment' ? 'selected' : '' %>>Exams Assessment</option>
            <option value="Other" <%= assessment.category === 'Other' ? 'selected' : '' %>>Other</option>
          </select>
        </div>
        <!-- Lock control -->
        <div class="control-group">
          <div class="control-group-title">Access Control</div>
          <div class="check-row">
            <input type="checkbox" id="isLockedCb" name="isLocked" <%= assessment.is_locked ? 'checked' : '' %> />
            <label for="isLockedCb">Lock this assessment (prevents score entry)</label>
          </div>
          <div class="check-row">
            <input type="checkbox" id="notifyTeachersCb" name="notifyTeachers" />
            <label for="notifyTeachersCb">Email affected class teachers about this change</label>
          </div>
        </div>

        <!-- Edit window dates -->
        <div class="date-group">
          <div class="date-group-title">Edit Window (optional)</div>
          <div class="form-group" style="margin-bottom:0;">
            <label for="editWindowStart">Edit Start Date:</label>
            <input
              type="datetime-local"
              id="editWindowStart"
              name="editWindowStart"
              value="<%= assessment.edit_window_start ? new Date(assessment.edit_window_start).toISOString().slice(0,16) : '' %>"
            >
          </div>
          <div class="form-group" style="margin-bottom:0;">
            <label for="editWindowEnd">Edit End Date:</label>
            <input
              type="datetime-local"
              id="editWindowEnd"
              name="editWindowEnd"
              value="<%= assessment.edit_window_end ? new Date(assessment.edit_window_end).toISOString().slice(0,16) : '' %>"
            >
          </div>
        </div>
        <h4 class="modify-classes-heading">Modify Classes and Subjects</h4>
        <button type="button" class="collapsible-btn" onclick="toggleClassesCollapse()">
          Show/Hide Classes & Subjects
          <span class="arrow" id="arrow-classes">&#9654;</span>
        </button>
        <div class="collapsible-content" id="collapse-classes" style="display:none; width:100%;">
          <div class="select-all-container">
            <input type="checkbox" id="selectAllClasses" onclick="selectAllClassesAndSubjects()">
            <label for="selectAllClasses">Select All Classes and Subjects</label>
          </div>
          <% classes.forEach(cls => { %>
            <div class="class-checkbox">
              <input type="checkbox" id="class_<%= cls.class_id %>" name="classes[]" value="<%= cls.class_id %>" <%= cls.selected ? 'checked' : '' %> onchange="toggleSubjects('<%= cls.class_id %>')">
              <label for="class_<%= cls.class_id %>"><%= cls.class_name %></label>
            </div>
            <div id="subjects_<%= cls.class_id %>" class="subject-container <%= cls.selected ? 'visible' : '' %>">
              <div class="select-all-container">
                <input type="checkbox" id="selectAllSubjects_<%= cls.class_id %>" onclick="selectAllSubjects('<%= cls.class_id %>')">
                <label for="selectAllSubjects_<%= cls.class_id %>">Select All Subjects</label>
              </div>
              <% subjects.forEach(subject => { %>
                <% if (subject.class_id === cls.class_id) { %>
                  <div class="subject-checkbox">
                    <input type="checkbox" id="subject_<%= subject.subject_id %>" name="subjects[]" value="<%= cls.class_id %>-<%= subject.subject_id %>" <%= subject.selected ? 'checked' : '' %>>
                    <label for="subject_<%= subject.subject_id %>"><%= subject.subject_name %></label>
                  </div>
                <% } %>
              <% }); %>
            </div>
          <% }); %>
        </div>
        <div class="form-actions">
          <button type="submit" class="submit-btn">Save Changes</button>
          <button type="button" class="delete-button" onclick="deleteAssessment()">Delete Assessment</button>
        </div>
      </div>
    </form>
</main>

<script>
    function toggleSubjects(classId) {
        const classCheckbox = document.getElementById(`class_${classId}`);
        const subjectContainer = document.getElementById(`subjects_${classId}`);
        if (classCheckbox.checked) {
            subjectContainer.classList.add('visible');
        } else {
            subjectContainer.classList.remove('visible');
            const subjectCheckboxes = subjectContainer.querySelectorAll('input[type="checkbox"]');
            subjectCheckboxes.forEach(cb => cb.checked = false);
        }
    }

    function selectAllClassesAndSubjects() {
        const selectAllCheckbox = document.getElementById('selectAllClasses');
        const classCheckboxes = document.querySelectorAll('input[name="classes[]"]');
        const subjectCheckboxes = document.querySelectorAll('input[name="subjects[]"]');

        classCheckboxes.forEach(cb => {
            cb.checked = selectAllCheckbox.checked;
            toggleSubjects(cb.value);
        });

        subjectCheckboxes.forEach(cb => cb.checked = selectAllCheckbox.checked);
    }

    function selectAllSubjects(classId) {
        const selectAllSubjectsCheckbox = document.getElementById(`selectAllSubjects_${classId}`);
        const subjectCheckboxes = document.querySelectorAll(`#subjects_${classId} input[type="checkbox"]`);

        subjectCheckboxes.forEach(cb => {
            cb.checked = selectAllSubjectsCheckbox.checked;
        });
    }

    document.getElementById('modifyAssessmentForm').addEventListener('submit', async function (event) {
        event.preventDefault();

        const formData = new FormData(this);
        const data = Object.fromEntries(formData.entries());

        data.classes = formData.getAll('classes[]');
        data.subjects = formData.getAll('subjects[]');
        data.isLocked = formData.get('isLocked') ? 'true' : 'false';
        data.isActive = 'true'; // always keep active; activation managed separately
        data.notifyTeachers = formData.get('notifyTeachers') ? 'true' : 'false';

        try {
            const response = await fetch('/common/modifyAssessment', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(data),
            });

            const result = await response.json();

            if (response.ok) {
                alert(result.message);
                const organizationId = '<%= organizationId %>';
                const termId = '<%= termId %>';
                window.location.href = `/common/manageAssessment?organizationId=${organizationId}&termId=${termId}`;
            } else {
                alert(result.error);
            }
        } catch (error) {
            console.error('Error submitting modified assessment:', error);
            alert('An error occurred. Please try again.');
        }
    });

    async function deleteAssessment() {
        const groupId = '<%= groupId %>';
        if (confirm('Are you sure you want to delete this assessment?')) {
            try {
                const response = await fetch('/common/deleteAssessment', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ groupId }),
                });

                const result = await response.json();

                if (response.ok) {
                    alert(result.message);
                    const organizationId = '<%= organizationId %>';
                    const termId = '<%= termId %>';
                    window.location.href = `/common/manageAssessment?organizationId=${organizationId}&termId=${termId}`;
                } else {
                    alert(result.error);
                }
            } catch (error) {
                console.error('Error deleting assessment:', error);
                alert('An error occurred. Please try again.');
            }
        }
    }

    function toggleClassesCollapse() {
        const collapseDiv = document.getElementById('collapse-classes');
        const arrow = document.getElementById('arrow-classes');
        if (collapseDiv && arrow) {
          if (collapseDiv.style.display === 'none') {
            collapseDiv.style.display = 'block';
            arrow.innerHTML = '&#9660;';
          } else {
            collapseDiv.style.display = 'none';
            arrow.innerHTML = '&#9654;';
          }
        }
      }
</script>
</body>
</html>
