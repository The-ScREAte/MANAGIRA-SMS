<!DOCTYPE html>
<html lang="en">
<head>
  <link rel="stylesheet" href="/css/globalScale.css">
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Modify Assessment</title>
    <style>
      :root {
        --font-family: "<%= (session && session.fontStyle ? String(session.fontStyle).trim() : 'Inter') %>", sans-serif;
      }


    body {
      font-family: var(--font-family);
      background: #fff;
      margin: 0;
    }
    main {
      text-align: center;
      margin: 0 auto;
      width: min(96%, 1280px);
      padding-bottom: 96px;
    }
    /* Flat, full-bleed toolbar fixed to the bottom of the drawer's own
       viewport — deliberately NOT styled as a rounded/bordered card like
       .modify-assessment-card above it, so it reads as a persistent action
       dock rather than a second floating card sitting on the page background. */
    .ma-footer-bar {
      position: fixed;
      left: 0;
      right: 0;
      bottom: 0;
      z-index: 50;
      background: #fff;
      border-top: 1px solid #e5e7eb;
      box-shadow: 0 -8px 20px rgba(15, 23, 42, 0.06);
      padding: 14px 0 calc(14px + env(safe-area-inset-bottom, 0px));
    }
    .ma-footer-bar-inner {
      width: min(96%, 1280px);
      max-width: 1180px;
      margin: 0 auto;
      padding: 0 28px;
      box-sizing: border-box;
    }
    .center-link {
      display: flex;
      justify-content: flex-start;
      align-items: center;
      margin-bottom: 20px;
    }
    .center-link button {
      padding: 7px 12px;
      border: none;
      background-color: var(--org-primary-color);
      color: white;
      cursor: pointer;
      border-radius: 6px;
      font-size: 0.9rem;
      font-weight: 600;
      width: auto;
      min-width: 0;
      box-shadow: 0 2px 8px rgba(1,83,91,0.08);
      transition: background 0.2s;
      margin: 0;
      display: inline-block;
    }
    .center-link button:hover {
      background-color: var(--org-primary-hover-fill, var(--org-primary-hover));
    }
    .main-heading {
      text-align: center;
      font-size: 1.6rem;
      margin: 18px 0 10px 0;
      color: #222;
      font-weight: 600;
    }
    .notice {
      background-color: #e7f3fe;
      color: #0c5460;
      border: 1px solid #bee5eb;
      border-radius: 7px;
      padding: 15px 18px;
      margin: 0 auto 20px auto;
      max-width: 480px;
      word-break: break-word;
      text-align: center;
      font-size: 1rem;
      box-shadow: 0 2px 8px rgba(1,83,91,0.07);
    }
    .modify-assessment-card {
      background: #fff;
      border: 1px solid #e0e0e0;
      box-shadow: 0 8px 28px rgba(15, 23, 42, 0.1);
      border-radius: 14px;
      max-width: 1180px;
      margin: 0 auto 24px auto;
      padding: 28px;
      display: flex;
      flex-direction: column;
      align-items: stretch;
      gap: 16px;
    }
    .assessment-layout-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 14px 18px;
      width: 100%;
      align-items: start;
    }
    .form-group {
      margin-bottom: 12px;
      width: 100%;
      display: flex;
      flex-direction: column;
      align-items: flex-start;
    }
    .form-group label {
      margin-bottom: 6px;
      font-weight: 500;
      font-size: 1rem;
      color: #222;
    }
    .form-group input,
    .form-group select {
      width: 100%;
      padding: 8px 10px;
      border: 1px solid #cfd8dc;
      border-radius: 5px;
      font-size: 1rem;
      background: #f7f7f7;
      box-sizing: border-box;
      color: #222;
    }
    .form-group input:focus,
    .form-group select:focus {
      border-color: #01535b;
      box-shadow: 0 0 0 2px #01535b33;
      outline: none;
    }
    .modify-classes-heading {
      text-align: center;
      margin-bottom: 8px;
      font-size: 1.1rem;
      font-weight: 600;
      color: #222;
    }
    .select-all-container {
      display: flex;
      align-items: center;
      gap: 8px;
      margin-bottom: 12px;
      justify-content: flex-start;
      width: 100%;
    }
    .select-all-container label {
      font-weight: 500;
      color: #01535b;
      font-size: 1rem;
      margin: 0;
      padding: 0;
    }
    .class-checkbox {
      display: flex;
      align-items: center;
      gap: 8px;
      font-weight: 400;
      color: #222;
      margin-bottom: 8px;
      width: 100%;
    }
    .class-checkbox input[type="checkbox"] {
      margin: 0 0 0 2px;
      width: 18px;
      height: 18px;
    }
    .class-checkbox label {
      font-weight: 600;
      color: #222;
      font-size: 1rem;
      margin: 0;
      padding: 0;
    }
    .subject-container {
      margin-left: 0;
      margin-top: 8px;
      padding-left: 0;
      border-left: none;
      width: 100%;
      display: none;
    }
    .subject-container.visible {
      display: block;
    }
    .subject-checkbox {
      display: flex;
      align-items: center;
      gap: 8px;
      font-weight: 400;
      color: #222;
      margin-bottom: 2px;
      width: 100%;
    }
    .subject-checkbox input[type="checkbox"] {
      margin: 0 0 0 2px;
      width: 18px;
      height: 18px;
    }
    .subject-checkbox label {
      font-weight: 400;
      color: #222;
      font-size: 1rem;
      margin: 0;
      padding: 0;
    }
    .form-actions {
      display: flex !important;
      flex-direction: row !important;
      justify-content: flex-start !important;
      flex-wrap: nowrap !important;
      align-items: center !important;
      gap: 10px;
      overflow-x: auto;
      width: 100%;
    }
    .form-actions > * {
      flex: 0 0 auto !important;
      margin: 0 !important;
    }
    .form-actions .submit-btn,
    .form-actions .delete-button {
      display: inline-flex !important;
      width: auto !important;
      min-width: 0 !important;
      flex: 0 0 auto !important;
      margin: 0 !important;
      white-space: nowrap;
    }
    .form-actions .delete-button {
      width: 42px !important;
      min-width: 42px !important;
    }
    .submit-btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
      background: #01535b;
      color: #fff;
      border: none;
      border-radius: 6px;
      padding: 7px 12px;
      font-size: 0.9rem;
      font-weight: 600;
      cursor: pointer;
      box-shadow: 0 2px 8px rgba(1,83,91,0.08);
      transition: background 0.2s;
      min-width: 0;
      width: auto;
      margin-top: 0 !important;
      min-height: 36px;
    }
    .submit-btn:hover {
      background: #013a40;
    }
    .submit-btn:disabled,
    .delete-button:disabled {
      opacity: 0.7;
      cursor: wait;
    }
    .submit-spinner {
      width: 16px;
      height: 16px;
      border: 2px solid rgba(255, 255, 255, 0.35);
      border-top-color: #fff;
      border-radius: 50%;
      display: none;
      animation: modifyAssessmentSpin 0.8s linear infinite;
    }
    .submit-btn.is-saving .submit-spinner {
      display: inline-block;
    }
    .submit-btn.is-saving .submit-btn-text::after {
      content: '...';
    }
    .submit-status {
      min-height: 20px;
      margin-top: -10px;
      margin-bottom: 8px;
      color: #475569;
      font-size: 0.92rem;
      text-align: center;
    }
    .submit-status.is-active {
      color: #01535b;
      font-weight: 500;
    }
    @keyframes modifyAssessmentSpin {
      to {
        transform: rotate(360deg);
      }
    }
    .delete-button {
      background-color: #e53935;
      color: #fff;
      border: none;
      border-radius: 6px;
      padding: 0;
      font-size: 1rem;
      font-weight: 600;
      cursor: pointer;
      box-shadow: 0 2px 8px rgba(1,83,91,0.08);
      transition: background 0.2s;
      width: 42px;
      min-width: 42px;
      min-height: 36px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
    }
    .delete-button svg {
      width: 16px;
      height: 16px;
    }
    .delete-button:hover {
      background-color: #b71c1c;
    }
    .collapsible-btn {
      width: auto;
      max-width: 100%;
      margin: 0 0 8px 0;
      background: #01535b;
      color: #fff;
      border: none;
      outline: none;
      padding: 7px 12px;
      font-size: 0.9rem;
      text-align: left;
      display: flex;
      align-items: center;
      justify-content: flex-start;
      cursor: pointer;
      border-radius: 5px;
      transition: none;
    }
    .collapsible-btn .arrow {
      font-size: 18px;
      margin-left: 8px;
      transition: transform 0.2s;
    }
    .collapsible-content {
      background: #f8fbfd;
      border: 1px solid #dce6ec;
      border-radius: 10px;
      margin-top: 6px;
      padding: 14px;
      width: 100%;
    }
    .classes-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 12px;
      width: 100%;
    }
    .class-subject-card {
      border: 1px solid #d8e3ea;
      border-radius: 10px;
      background: #fff;
      padding: 10px;
      box-shadow: 0 2px 8px rgba(15, 23, 42, 0.04);
      min-width: 0;
    }
    .class-subject-card .select-all-container {
      margin-bottom: 8px;
    }
    .class-subject-card .select-all-container label {
      font-size: 0.88rem;
      color: #33566a;
      font-weight: 600;
    }
    .subjects-grid {
      display: grid;
      grid-template-columns: 1fr;
      gap: 6px;
      width: 100%;
    }
    .subject-checkbox {
      background: #fbfdff;
      border: 1px solid #e5edf3;
      border-radius: 8px;
      padding: 6px 8px;
      margin: 0;
    }
    .subject-checkbox label {
      font-size: 0.92rem;
    }
    .collapsible-btn:hover,
    .collapsible-btn:focus {
      background: #01535b;
      color: #fff;
      box-shadow: none;
    }
    /* ── Checkbox global styling ── */
    input[type="checkbox"] {
      appearance: none;
      -webkit-appearance: none;
      width: 18px;
      height: 18px;
      border: 2px solid #b0bec5;
      border-radius: 4px;
      background: #fff;
      cursor: pointer;
      flex-shrink: 0;
      transition: background 0.15s, border-color 0.15s;
      position: relative;
    }
    input[type="checkbox"]:checked {
      background: #01535b;
      border-color: #01535b;
    }
    input[type="checkbox"]:checked::after {
      content: '';
      position: absolute;
      left: 3px;
      top: 0px;
      width: 5px;
      height: 10px;
      border: 2px solid #fff;
      border-top: none;
      border-left: none;
      transform: rotate(45deg);
    }
    input[type="checkbox"]:focus {
      outline: none;
      box-shadow: 0 0 0 3px rgba(1,83,91,0.18);
    }
    /* ── Control checkboxes ── */
    .control-group {
      width: 100%;
      background: #f4f8fa;
      border: 1px solid #dde4ec;
      border-radius: 9px;
      padding: 14px 16px;
      display: flex;
      flex-direction: column;
      gap: 10px;
    }
    .control-group-title {
      font-size: 0.8rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      color: #607080;
      margin-bottom: 2px;
    }
    .check-row {
      display: flex;
      align-items: center;
      gap: 10px;
      cursor: pointer;
    }
    .check-row label {
      margin: 0;
      padding: 0;
      font-size: 0.95rem;
      font-weight: 500;
      color: #1a2e35;
      cursor: pointer;
    }
    /* ── Date group ── */
    .date-group {
      width: 100%;
      background: linear-gradient(180deg, #f8fbfd 0%, #f2f7fb 100%);
      border: 1px solid #d6e2eb;
      border-radius: 10px;
      padding: 14px;
      display: flex;
      flex-direction: column;
      gap: 12px;
    }
    .date-group-title {
      font-size: 0.82rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      color: #526579;
      margin-bottom: 0;
    }
    .date-group-note {
      margin-top: -4px;
      margin-bottom: 2px;
      color: #5b7288;
      font-size: 0.84rem;
      text-align: left;
    }
    .date-group-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 10px 12px;
      width: 100%;
    }
    .date-group-grid .form-group {
      margin-bottom: 0;
      min-width: 0;
    }

    /* ── Responsive ── */
    @media (max-width: 640px) {
      main { width: 100%; padding: 0 12px 110px; }
      .ma-footer-bar-inner { width: 100%; max-width: none; padding: 0 12px; }
      .main-heading { font-size: 1.25rem; margin: 14px 0 8px; }
      .modify-assessment-card { padding: 18px 14px 16px; border-radius: 10px; gap: 10px; }
      .assessment-layout-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; }
      .assessment-layout-grid .test-name-field,
      .assessment-layout-grid .test-weight-field {
        grid-column: span 1;
      }
      .assessment-layout-grid > :not(.test-name-field):not(.test-weight-field) {
        grid-column: 1 / -1;
      }
      .center-link button { font-size: 0.85rem; padding: 6px 10px; }
      .collapsible-btn { width: auto; font-size: 0.85rem; padding: 6px 10px; }
      .collapsible-content { padding: 12px 12px; }
      .classes-grid { grid-template-columns: 1fr; gap: 10px; }
      .class-subject-card { padding: 9px; }
      .form-group label { font-size: 0.9rem; }
      .form-group input, .form-group select { font-size: 0.9rem; padding: 7px 8px; }
      .date-group-grid { grid-template-columns: 1fr; gap: 8px; }
      .date-group-note { font-size: 0.82rem; }
      .form-actions {
        gap: 8px;
        justify-content: flex-start !important;
        flex-wrap: nowrap !important;
        flex-direction: row !important;
      }
      .ma-footer-bar { padding: 10px 0 calc(10px + env(safe-area-inset-bottom, 0px)); }
      .submit-btn { font-size: 0.85rem; padding: 6px 10px; }
      .delete-button { width: 40px !important; min-width: 40px !important; }
      .check-row label { font-size: 0.88rem; }
      .modify-classes-heading { font-size: 0.98rem; }
    }
    @media (max-width: 400px) {
      main { padding: 0 8px 110px; }
      .main-heading { font-size: 1.1rem; }
      .modify-assessment-card { padding: 14px 10px; }
      .collapsible-btn { width: 100%; font-size: 0.82rem; }
    }
    @media (min-width: 1120px) {
      .classes-grid {
        grid-template-columns: repeat(3, minmax(0, 1fr));
      }
    }
    </style>
</head>
<body>
<main>
    <br />
    <%- include('../partials/flash') %>

<hr>
    <form id="modifyAssessmentForm">
      <div class="modify-assessment-card">
        <h3 class="main-heading">Modify Assessment</h3>
        <input type="hidden" name="organizationId" value="<%= organizationId %>">
        <input type="hidden" name="termId" value="<%= termId %>">
        <input type="hidden" name="groupId" value="<%= groupId %>">
        <div class="assessment-layout-grid">
          <div class="form-group test-name-field">
            <label for="testName">Test Name:</label>
            <input type="text" name="testName" value="<%= assessment.title %>" required>
          </div>
          <div class="form-group test-weight-field">
            <label for="testWeight">Test Weight (%):</label>
            <input type="number" name="testWeight" step="0.1" value="<%= assessment.weight %>" required>
          </div>
          <div class="form-group">
            <label for="maxScore">Score Out Of:</label>
            <input type="number" name="maxScore" value="<%= assessment.max_score %>" required>
          </div>
          <div class="form-group">
            <label for="scaleBase">Scale Base (scaled score out of):</label>
            <input type="number" name="scaleBase" value="<%= assessment.scale_base || 100 %>" min="1" required>
          </div>
          <div class="form-group">
            <label for="category">Category:</label>
            <select name="category" required>
              <option value="Class Assessment" <%= assessment.category === 'Class Assessment' ? 'selected' : '' %>>Class Assessment</option>
              <option value="Exams Assessment" <%= assessment.category === 'Exams Assessment' ? 'selected' : '' %>>Exams Assessment</option>
              <option value="Other" <%= assessment.category === 'Other' ? 'selected' : '' %>>Other</option>
            </select>
          </div>
          <div class="control-group">
            <div class="control-group-title">Access Control</div>
            <div class="check-row">
              <input type="checkbox" id="isLockedCb" name="isLocked" <%= assessment.is_locked ? 'checked' : '' %> />
              <label for="isLockedCb">Lock this assessment (prevents score entry)</label>
            </div>
            <div class="check-row">
              <input type="checkbox" id="notifyTeachersCb" name="notifyTeachers" />
              <label for="notifyTeachersCb">Email affected class teachers about this change</label>
            </div>
          </div>

          <div class="date-group">
            <div class="date-group-title">Edit Window (optional)</div>
            <div class="date-group-note">Leave both fields blank to allow editing anytime.</div>
            <div class="date-group-grid">
              <div class="form-group">
                <label for="editWindowStart">Edit Start Date:</label>
                <input
                  type="datetime-local"
                  id="editWindowStart"
                  name="editWindowStart"
                  value="<%= assessment.edit_window_start ? new Date(assessment.edit_window_start).toISOString().slice(0,16) : '' %>"
                >
              </div>
              <div class="form-group">
                <label for="editWindowEnd">Edit End Date:</label>
                <input
                  type="datetime-local"
                  id="editWindowEnd"
                  name="editWindowEnd"
                  value="<%= assessment.edit_window_end ? new Date(assessment.edit_window_end).toISOString().slice(0,16) : '' %>"
                >
              </div>
            </div>
          </div>
        </div>
        <h4 class="modify-classes-heading">Modify Classes and Subjects</h4>
        <button type="button" class="collapsible-btn" onclick="toggleClassesCollapse()">
          Show/Hide Classes & Subjects
          <span class="arrow" id="arrow-classes">&#9654;</span>
        </button>
        <div class="collapsible-content" id="collapse-classes" style="display:none; width:100%;">
          <div class="select-all-container">
            <input type="checkbox" id="selectAllClasses" onclick="selectAllClassesAndSubjects()">
            <label for="selectAllClasses">Select All Classes and Subjects</label>
          </div>
          <div class="classes-grid">
            <% classes.forEach(cls => { %>
              <div class="class-subject-card">
                <div class="class-checkbox">
                  <input type="checkbox" id="class_<%= cls.class_id %>" name="classes[]" value="<%= cls.class_id %>" <%= cls.selected ? 'checked' : '' %> onchange="toggleSubjects('<%= cls.class_id %>')">
                  <label for="class_<%= cls.class_id %>"><%= cls.class_name %></label>
                </div>
                <div id="subjects_<%= cls.class_id %>" class="subject-container <%= cls.selected ? 'visible' : '' %>">
                  <div class="select-all-container">
                    <input type="checkbox" id="selectAllSubjects_<%= cls.class_id %>" onclick="selectAllSubjects('<%= cls.class_id %>')">
                    <label for="selectAllSubjects_<%= cls.class_id %>">Select All Subjects</label>
                  </div>
                  <div class="subjects-grid">
                    <% subjects.forEach(subject => { %>
                      <% if (subject.class_id === cls.class_id) { %>
                        <div class="subject-checkbox">
                          <input type="checkbox" id="subject_<%= subject.subject_id %>" name="subjects[]" value="<%= cls.class_id %>-<%= subject.subject_id %>" <%= subject.selected ? 'checked' : '' %>>
                          <label for="subject_<%= subject.subject_id %>"><%= subject.subject_name %></label>
                        </div>
                      <% } %>
                    <% }); %>
                  </div>
                </div>
              </div>
            <% }); %>
          </div>
        </div>
      </div>
    </form>
</main>

<div class="ma-footer-bar">
  <div class="ma-footer-bar-inner form-actions">
    <button type="submit" class="submit-btn" id="saveAssessmentBtn" form="modifyAssessmentForm">
      <span class="submit-spinner" aria-hidden="true"></span>
      <span class="submit-btn-text">Save Changes</span>
    </button>
    <button type="button" class="delete-button" id="deleteAssessmentBtn" onclick="deleteAssessment()" aria-label="Delete assessment" title="Delete assessment">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <polyline points="3 6 5 6 21 6"></polyline>
        <path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"></path>
        <path d="M10 11v6"></path>
        <path d="M14 11v6"></path>
        <path d="M9 6V4h6v2"></path>
      </svg>
    </button>
  </div>
</div>

<script>
  function setModifyAssessmentSavingState(isSaving) {
    const saveButton = document.getElementById('saveAssessmentBtn');
    const deleteButton = document.getElementById('deleteAssessmentBtn');
    const submitStatus = document.getElementById('submitStatus');

    if (saveButton) {
      saveButton.disabled = isSaving;
      saveButton.classList.toggle('is-saving', isSaving);
    }

    if (deleteButton) {
      deleteButton.disabled = isSaving;
    }

    if (submitStatus) {
      submitStatus.textContent = isSaving ? 'Saving your changes. Please wait.' : '';
      submitStatus.classList.toggle('is-active', isSaving);
    }
  }

    function toggleSubjects(classId) {
        const classCheckbox = document.getElementById(`class_${classId}`);
        const subjectContainer = document.getElementById(`subjects_${classId}`);
        if (classCheckbox.checked) {
            subjectContainer.classList.add('visible');
        } else {
            subjectContainer.classList.remove('visible');
            const subjectCheckboxes = subjectContainer.querySelectorAll('input[type="checkbox"]');
            subjectCheckboxes.forEach(cb => cb.checked = false);
        }
    }

    function selectAllClassesAndSubjects() {
        const selectAllCheckbox = document.getElementById('selectAllClasses');
        const classCheckboxes = document.querySelectorAll('input[name="classes[]"]');
        const subjectCheckboxes = document.querySelectorAll('input[name="subjects[]"]');

        classCheckboxes.forEach(cb => {
            cb.checked = selectAllCheckbox.checked;
            toggleSubjects(cb.value);
        });

        subjectCheckboxes.forEach(cb => cb.checked = selectAllCheckbox.checked);
    }

    function selectAllSubjects(classId) {
        const selectAllSubjectsCheckbox = document.getElementById(`selectAllSubjects_${classId}`);
        const subjectCheckboxes = document.querySelectorAll(`#subjects_${classId} input[type="checkbox"]`);

        subjectCheckboxes.forEach(cb => {
            cb.checked = selectAllSubjectsCheckbox.checked;
        });
    }

    document.getElementById('modifyAssessmentForm').addEventListener('submit', async function (event) {
        event.preventDefault();
      setModifyAssessmentSavingState(true);

        const formData = new FormData(this);
        const data = Object.fromEntries(formData.entries());

        data.classes = formData.getAll('classes[]');
        data.subjects = formData.getAll('subjects[]');
        data.isLocked = formData.get('isLocked') ? 'true' : 'false';
        data.isActive = 'true'; // always keep active; activation managed separately
        data.showQuestionSetOnDashboard = formData.get('showQuestionSetOnDashboard') ? 'true' : 'false';
        data.notifyTeachers = formData.get('notifyTeachers') ? 'true' : 'false';

        try {
            const response = await fetch('/common/modifyAssessment', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(data),
            });

            const result = await response.json();

            if (response.ok) {
                alert(result.message);
                const organizationId = '<%= organizationId %>';
                const termId = '<%= termId %>';
                window.location.href = `/common/manageAssessment?organizationId=${organizationId}&termId=${termId}`;
            } else {
              setModifyAssessmentSavingState(false);
                alert(result.error);
            }
        } catch (error) {
            setModifyAssessmentSavingState(false);
            console.error('Error submitting modified assessment:', error);
            alert('An error occurred. Please try again.');
        }
    });

    async function deleteAssessment() {
        const groupId = '<%= groupId %>';
        if (confirm('Are you sure you want to delete this assessment?')) {
            try {
                const response = await fetch('/common/deleteAssessment', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ groupId }),
                });

                const result = await response.json();

                if (response.ok) {
                    alert(result.message);
                    const organizationId = '<%= organizationId %>';
                    const termId = '<%= termId %>';
                    window.location.href = `/common/manageAssessment?organizationId=${organizationId}&termId=${termId}`;
                } else {
                    alert(result.error);
                }
            } catch (error) {
                console.error('Error deleting assessment:', error);
                alert('An error occurred. Please try again.');
            }
        }
    }

    function toggleClassesCollapse() {
        const collapseDiv = document.getElementById('collapse-classes');
        const arrow = document.getElementById('arrow-classes');
        if (collapseDiv && arrow) {
          if (collapseDiv.style.display === 'none') {
            collapseDiv.style.display = 'block';
            arrow.innerHTML = '&#9660;';
          } else {
            collapseDiv.style.display = 'none';
            arrow.innerHTML = '&#9654;';
          }
        }
      }
</script>
</body>
</html>
