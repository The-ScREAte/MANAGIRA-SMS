<!-- Styling -->
<style>
      :root {
        --font-family: "<%= (session && session.fontStyle ? String(session.fontStyle).trim() : 'Inter') %>", sans-serif;
      }


    .archive-link {
        margin-bottom: 20px;
    }

    .archive-link a {
        text-decoration: none;
        color: white;
        background-color: var(--org-primary-color);
        padding: 10px 15px;
        border-radius: 5px;
        transition: background-color 0.3s ease;
    }

    .archive-link a:hover {
        background-color: var(--org-primary-hover);
    }

    .notice-container {
        background-color: #b9e8f9;
        color: #000000;
        border: 1px solid #f5c2c7;
        padding: 15px;
        border-radius: 5px;
        margin-bottom: 20px;
    }

    .notice-text {
        font-weight: bold;
        margin-bottom: 10px;
    }

    .notice-list {
        list-style-type: disc;
        padding-left: 20px;
    }

    .notice-list li {
        margin-bottom: 5px;
    }

    .group-header {
        cursor: pointer;
        display: flex;
        align-items: center;
    }

    .toggle-icon {
        margin-right: 10px;
        font-size: 18px;
        cursor: pointer;
    }

    .hidden {
        display: none;
    }

    .student-list {
        margin-top: 10px;
        padding-left: 20px;
    }
</style>
<style>
    body {
        font-family: var(--font-family);
      }
      
</style>

<div class="close-graduation-year-group-container">
    <br>
    <div class="link-to-next-back">
        <a href="/common/archivedStudents" class="btn btn-primary">
            View Closed Graduation Year Groups
        </a>
    </div>
    <hr>

    <!-- Notice Section -->
    <div class="notice-container">
        <p class="notice-text">
            This page is designed to:
        </p>
        <ul class="notice-list">
            <li>Save and secure information for graduating classes to ensure their records remain untouchable.</li>
            <li>Preserve records of students who may no longer be active but whose information needs to be kept safe.</li>
        </ul>
    </div>
    <hr>

    <h1>Close Graduation Year Group</h1>

    <% gradYearGroups.forEach((group, index) => { %>
        <form action="/common/closeGraduationYearGroupPost" method="POST" onsubmit="return confirmAction('Are you sure you want to end this graduation year group for the selected students? Thier current information will be achive and untouchable But you will not see them in your organization until they are unchaived. Do you still want to do this?');">
            <!-- Graduation Year Group Header -->
            <h2 class="group-header">
                <span class="toggle-icon" data-target="group-<%= index %>">➕</span>
                <%= group.name %>
            </h2>

            <!-- Students List (Hidden by default) -->
            <ul id="group-<%= index %>" class="student-list hidden">
                <% group.students.forEach(student => { %>
                    <li>
                        <input type="checkbox" name="students" value="<%= student.student_id %>">
                        <%= student.first_name %> <%= student.last_name %>
                    </li>
                <% }) %>
            </ul>

            <!-- Submit Button (Hidden by default) -->
            <button type="submit" name="action" value="archive" class="hidden">End Group / Selected Members</button>
        </form>
    <% }) %>
</div>

<!-- JavaScript -->
<script>
    // Confirmation dialog for form submission
    function confirmAction(message) {
        return confirm(message);
    }

    // Toggle visibility for groups
    const toggleIcons = document.querySelectorAll('.toggle-icon');
    toggleIcons.forEach(icon => {
        icon.addEventListener('click', () => {
            const targetId = icon.getAttribute('data-target');
            const targetElement = document.getElementById(targetId);
            const submitButton = targetElement.nextElementSibling;

            if (targetElement.classList.contains('hidden')) {
                targetElement.classList.remove('hidden');
                submitButton.classList.remove('hidden');
                icon.textContent = '➖';
            } else {
                targetElement.classList.add('hidden');
                submitButton.classList.add('hidden');
                icon.textContent = '➕';
            }
        });
    });
</script>
