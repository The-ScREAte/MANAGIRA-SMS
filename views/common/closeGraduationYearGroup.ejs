<%
  const _groups = Array.isArray(typeof gradYearGroups !== 'undefined' ? gradYearGroups : null) ? gradYearGroups : [];
  const _embedded = typeof isEmbedded !== 'undefined' && isEmbedded;
  const _embedQs = _embedded ? '?embed=workspace' : '';
  const _totalArchived = typeof totalArchived !== 'undefined' ? totalArchived : 0;
  const _activeInGroups = _groups.reduce((sum, g) => sum + g.activeCount, 0);
  const _initials = (s) => ((s.first_name || '').charAt(0) + (s.last_name || '').charAt(0)).toUpperCase() || '?';
%>
<link rel="stylesheet" href="<%= assetUrl('/css/reportPages.css') %>" />

<div class="gp-page">
  <header class="gp-head">
    <div>
      <h1 class="gp-title">Graduate / Archive</h1>
      <p class="gp-sub">Graduate a class when they finish. Their records are kept safe, and they are no longer counted as active students or billed.</p>
    </div>
    <a class="gp-btn gp-btn--ghost" href="/common/archivedStudents<%= _embedQs %>">
      <i class="fa-solid fa-box-archive" aria-hidden="true"></i> Archived students <span class="gp-pill"><%= _totalArchived %></span>
    </a>
  </header>

  <%- include('../partials/flash') %>

  <div class="gp-stats">
    <div class="gp-stat"><span class="gp-stat__value"><%= _groups.length %></span><span class="gp-stat__label">Graduation groups</span></div>
    <div class="gp-stat"><span class="gp-stat__value"><%= _activeInGroups %></span><span class="gp-stat__label">Active students in groups</span></div>
    <div class="gp-stat"><span class="gp-stat__value"><%= _totalArchived %></span><span class="gp-stat__label">Graduated &amp; archived</span></div>
  </div>

  <ul class="gp-facts">
    <li class="gp-fact"><i class="fa-solid fa-lock" aria-hidden="true"></i><div><strong>Records are preserved</strong><span>Grades, reports and history stay intact and read-only.</span></div></li>
  </ul>

  <% if (!_groups.length) { %>
    <div class="gp-empty">
      <i class="fa-solid fa-graduation-cap" aria-hidden="true"></i>
      <h2>No graduation groups yet</h2>
      <p>Create graduation year groups and assign students to them, then come back here to graduate a class.</p>
      <a class="gp-btn gp-btn--primary" href="/common/manageClassSubjectAndGradYr<%= _embedQs %>">Manage graduation groups</a>
    </div>
  <% } else { %>
    <form action="/common/closeGraduationYearGroupPost" method="POST" data-gp-form data-gp-noun="student">
      <input type="hidden" name="action" value="archive" />
      <input type="hidden" name="embed" value="<%= _embedded ? 'workspace' : '' %>" />

      <div class="gp-toolbar">
        <label class="gp-search">
          <i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i>
          <input type="search" placeholder="Search students by name or ID" data-gp-search aria-label="Search students" />
        </label>
        <span class="gp-toolbar__hint">Tick the students who are graduating, then choose Archive.</span>
      </div>

      <div class="gp-groups">
        <% _groups.forEach((group, gi) => { %>
          <details class="gp-group"<%= gi === 0 && group.activeCount ? ' open' : '' %>>
            <summary>
              <i class="fa-solid fa-chevron-right gp-group__chev" aria-hidden="true"></i>
              <span class="gp-group__name"><%= group.name %></span>
              <span class="gp-group__meta">
                <span class="gp-tag gp-tag--active"><%= group.activeCount %> active</span>
                <% if (group.archivedCount) { %><span class="gp-tag gp-tag--archived"><%= group.archivedCount %> archived</span><% } %>
              </span>
            </summary>
            <% if (!group.students.length) { %>
              <div class="gp-group__empty">No students are assigned to this group yet.</div>
            <% } else { %>
              <table class="gp-table">
                <thead>
                  <tr>
                    <th class="gp-col-check"><input type="checkbox" class="gp-pick-all" aria-label="Select all active students in <%= group.name %>" /></th>
                    <th>Student</th>
                    <th class="gp-col-class">Class</th>
                    <th>Status</th>
                  </tr>
                </thead>
                <tbody>
                  <% group.students.forEach((s) => { const name = [s.first_name, s.last_name].filter(Boolean).join(' '); %>
                    <tr class="<%= s.is_archived ? 'is-archived' : '' %>" data-search="<%= (name + ' ' + (s.custom_student_id || '')).toLowerCase() %>">
                      <td class="gp-col-check"><input type="checkbox" class="gp-pick" name="students" value="<%= s.student_id %>" aria-label="Select <%= name %>"<%= s.is_archived ? ' disabled' : '' %> /></td>
                      <td>
                        <span class="gp-person">
                          <span class="gp-avatar" data-initials="<%= _initials(s) %>"><% if (s.image_url) { %><img src="<%= s.image_url %>" alt="" loading="lazy" /><% } else { %><%= _initials(s) %><% } %></span>
                          <span><span class="gp-person__name"><%= name %></span><% if (s.custom_student_id) { %><span class="gp-person__id"><%= s.custom_student_id %></span><% } %></span>
                        </span>
                      </td>
                      <td class="gp-col-class"><%= s.class_name || '—' %></td>
                      <td><span class="gp-status<%= s.is_archived ? ' gp-status--archived' : '' %>"><%= s.is_archived ? 'Archived' : 'Active' %></span></td>
                    </tr>
                  <% }) %>
                </tbody>
              </table>
            <% } %>
          </details>
        <% }) %>
      </div>
      <div class="gp-no-results" data-gp-no-results>No students match your search.</div>

      <div class="gp-actionbar" data-gp-actionbar aria-live="polite">
        <strong data-gp-count>0 students selected</strong>
        <button type="button" class="gp-btn gp-btn--link" data-gp-clear>Clear</button>
        <button type="button" class="gp-btn gp-btn--primary" data-gp-open><i class="fa-solid fa-box-archive" aria-hidden="true"></i> Graduate &amp; archive</button>
      </div>

      <dialog class="gp-dialog" data-gp-dialog>
        <div class="gp-dialog__body">
          <h2 class="gp-dialog__title" data-gp-dialog-title data-template="Graduate and archive {n} student{s}?">Graduate and archive students?</h2>
          <p class="gp-dialog__text">They will move to Archived students:</p>
          <ul>
            <li>Their records are kept and can't be edited.</li>
            <li>They are no longer billed or counted as active students.</li>
            <li>You can restore them later from Archived students.</li>
          </ul>
        </div>
        <div class="gp-dialog__actions">
          <button type="button" class="gp-btn gp-btn--ghost" data-gp-cancel>Cancel</button>
          <button type="button" class="gp-btn gp-btn--primary" data-gp-confirm>Graduate &amp; archive</button>
        </div>
      </dialog>
    </form>
  <% } %>
</div>

<script src="<%= assetUrl('/js/graduationPages.js') %>"></script>
