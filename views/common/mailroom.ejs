<%
  const themeColor = (typeof session !== 'undefined' && session && session.themeColor) ? session.themeColor : 'teal';
  const themeColors = Object.fromEntries(Object.entries(themePalette).map(([k, v]) => [k, v.primary]));
  const primary = themeColors[themeColor] || themeColors.teal;
%>
<style>
  #mailroomRoot {
    --mr-primary: <%= primary %>;
    --mr-bg: #f4f7f9;
    --mr-panel: #ffffff;
    --mr-line: #e5edf2;
    --mr-text: #14232f;
    --mr-muted: #64748b;
    --mr-radius: 14px;
    --mr-shadow: 0 10px 26px rgba(16, 35, 56, 0.07);
    font-family: 'Manrope', 'Segoe UI', sans-serif;
    color: var(--mr-text);
    background: var(--mr-bg);
    min-height: 100%;
    padding: 18px;
    box-sizing: border-box;
    overflow-x: hidden;
  }
  #mailroomRoot * { box-sizing: border-box; }
  .mr-header { margin-bottom: 16px; text-align: left; }
  .mr-header--tabs { display: flex; align-items: flex-end; justify-content: space-between; gap: 12px; flex-wrap: wrap; }
  .mr-tabs { display: inline-flex; gap: 4px; padding: 4px; border: 1px solid var(--mr-line); border-radius: 12px; background: var(--mr-panel); }
  .mr-tab { all: unset; box-sizing: border-box; display: inline-flex; align-items: center; gap: 6px; height: 32px; padding: 0 14px; border-radius: 9px; font-size: 13px; font-weight: 700; color: var(--mr-muted); cursor: pointer; }
  .mr-tab:hover { color: var(--mr-text); background: var(--mr-bg); }
  .mr-tab.is-active { background: var(--mr-primary); color: #fff; }
  .mr-tab:focus-visible { outline: 2px solid var(--mr-primary); outline-offset: 2px; }
  .mr-tab-badge { min-width: 18px; height: 18px; padding: 0 5px; display: inline-grid; place-items: center; border-radius: 999px; background: #e11d48; color: #fff; font-size: 11px; font-weight: 800; }
  #mailroomRoot.is-inbox .mr-send-only { display: none !important; }
  .mr-inbox { display: grid; grid-template-columns: minmax(300px, 400px) minmax(0, 1fr); gap: 16px; align-items: start; }
  .mr-inbox[hidden] { display: none; }
  .mr-inbox-head { display: grid; gap: 10px; padding: 14px; border-bottom: 1px solid var(--mr-line); }
  .mr-inbox-filters { display: flex; gap: 6px; flex-wrap: wrap; }
  .mr-inbox-rows { max-height: calc(100vh - 260px); overflow-y: auto; }
  .mr-inbox-row { all: unset; box-sizing: border-box; display: grid; gap: 3px; width: 100%; padding: 12px 14px; border-bottom: 1px solid var(--mr-line); cursor: pointer; }
  .mr-inbox-row:hover { background: var(--mr-bg); }
  .mr-inbox-row.is-active { background: color-mix(in srgb, var(--mr-primary) 8%, #fff); box-shadow: inset 3px 0 0 var(--mr-primary); }
  .mr-inbox-row:focus-visible { outline: 2px solid var(--mr-primary); outline-offset: -2px; }
  .mr-inbox-top { display: flex; align-items: center; gap: 8px; }
  .mr-inbox-top strong { flex: 1; min-width: 0; font-size: 13.5px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .mr-inbox-time { font-size: 11.5px; color: var(--mr-muted); white-space: nowrap; }
  .mr-inbox-subject { font-size: 13px; font-weight: 600; color: var(--mr-text); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .mr-inbox-snippet { font-size: 12.5px; color: var(--mr-muted); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .mr-inbox-meta { display: flex; gap: 6px; align-items: center; flex-wrap: wrap; margin-top: 3px; font-size: 11.5px; color: var(--mr-muted); }
  .mr-dot-new { width: 8px; height: 8px; border-radius: 50%; background: #e11d48; flex: none; }
  .mr-chip { padding: 2px 8px; border-radius: 999px; font-size: 11px; font-weight: 700; }
  .mr-chip--needs { background: #fff1f2; color: #be123c; }
  .mr-chip--open { background: #eff6ff; color: #1d4ed8; }
  .mr-chip--in_progress { background: #fffbeb; color: #b45309; }
  .mr-chip--resolved { background: #ecfdf5; color: #047857; }
  .mr-thread { display: flex; flex-direction: column; min-height: 520px; max-height: calc(100vh - 170px); }
  .mr-thread-empty { margin: auto; }
  .mr-thread-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 12px; padding: 16px 18px; border-bottom: 1px solid var(--mr-line); }
  .mr-thread-head h2 { margin: 0; font-size: 16px; font-weight: 800; color: var(--mr-text); }
  .mr-thread-head p { margin: 4px 0 0; font-size: 12.5px; color: var(--mr-muted); }
  .mr-thread-actions { display: flex; gap: 6px; flex: none; align-items: center; }
  .mr-thread-actions a, .mr-thread-actions button { all: unset; box-sizing: border-box; display: inline-flex; align-items: center; height: 30px; padding: 0 11px; border: 1px solid var(--mr-line); border-radius: 8px; font-size: 12.5px; font-weight: 700; color: var(--mr-text); cursor: pointer; background: #fff; }
  .mr-thread-actions a:hover, .mr-thread-actions button:hover { background: var(--mr-bg); }
  .mr-thread-msgs { flex: 1; overflow-y: auto; padding: 16px 18px; display: grid; gap: 12px; align-content: start; background: var(--mr-bg); }
  .mr-msg { max-width: 78%; padding: 10px 13px; border-radius: 12px; background: #fff; border: 1px solid var(--mr-line); }
  .mr-msg--staff { justify-self: end; background: color-mix(in srgb, var(--mr-primary) 9%, #fff); border-color: color-mix(in srgb, var(--mr-primary) 20%, #fff); }
  .mr-msg-who { display: flex; gap: 8px; align-items: baseline; margin-bottom: 4px; font-size: 12px; }
  .mr-msg-who strong { color: var(--mr-text); }
  .mr-msg-who span { color: var(--mr-muted); }
  .mr-msg p { margin: 0; font-size: 13.5px; line-height: 1.55; white-space: pre-wrap; color: var(--mr-text); }
  #mrReplyForm.mr-reply { display: flex; align-items: flex-end; margin: 0; gap: 8px; padding: 12px 14px; border-top: 1px solid var(--mr-line); background: #fff; border-radius: 0 0 var(--mr-radius) var(--mr-radius); }
  #mrReplyForm.mr-reply textarea { flex: 1 1 auto; width: auto; height: 44px; margin: 0; box-sizing: border-box; min-height: 44px; max-height: 160px; resize: vertical; padding: 10px 12px; border: 1px solid var(--mr-line); border-radius: 10px; font: inherit; font-size: 13.5px; }
  #mrReplyForm.mr-reply textarea:focus { outline: none; border-color: var(--mr-primary); }
  #mrReplyForm.mr-reply button { flex: 0 0 auto; width: auto; margin: 0; align-self: flex-end; height: 40px; padding: 0 16px; border: 0; border-radius: 10px; background: var(--mr-primary); color: #fff; font-weight: 800; font-size: 13px; cursor: pointer; }
  #mrReplyForm.mr-reply button:disabled { opacity: .5; cursor: default; }
  @media (max-width: 980px) { .mr-inbox { grid-template-columns: minmax(0, 1fr); } .mr-thread { min-height: 420px; } }
  .mr-header h1 { margin: 0 0 4px; padding: 0; font-size: 22px; font-weight: 800; color: var(--mr-primary); text-align: left; }
  .mr-header p { margin: 0; color: var(--mr-muted); font-size: 13.5px; }

  .mr-layout { display: grid; grid-template-columns: minmax(280px, 360px) minmax(0, 1fr); gap: 16px; align-items: start; }
  @media (max-width: 980px) { .mr-layout { grid-template-columns: minmax(0, 1fr); } }

  .mr-panel { background: var(--mr-panel); border: 1px solid var(--mr-line); border-radius: var(--mr-radius); box-shadow: var(--mr-shadow); min-width: 0; }

  /* Left: contact directory */
  .mr-directory { display: flex; flex-direction: column; max-height: calc(100vh - 140px); min-height: 420px; }
  .mr-directory-open-row { display: none; }
  .mr-directory-toggle {
    display: none;
    width: auto;
    align-items: center;
    justify-content: center;
    gap: 8px;
    background: var(--mr-panel);
    border: 1px solid var(--mr-line);
    border-radius: 10px;
    box-shadow: var(--mr-shadow);
    padding: 10px 14px;
    font: inherit;
    cursor: pointer;
    text-align: left;
  }
  .mr-directory-toggle-label { display: flex; align-items: center; gap: 8px; font-size: 14px; font-weight: 800; color: var(--mr-text); }
  .mr-directory-toggle-count { font-size: 11px; font-weight: 700; color: var(--mr-primary); background: #e5f3f4; border-radius: 999px; padding: 2px 8px; }
  .mr-directory-toggle-icon { width: 16px; height: 16px; flex-shrink: 0; color: var(--mr-muted); }
  .mr-directory-head { padding: 14px 16px 10px; border-bottom: 1px solid var(--mr-line); }
  .mr-directory-head h2 { margin: 0 0 8px; font-size: 14px; font-weight: 800; }
  .mr-search { width: 100%; border: 1px solid var(--mr-line); border-radius: 9px; padding: 8px 10px; font: inherit; font-size: 13px; background: #f8fafc; }
  .mr-filter-row { display: flex; gap: 8px; margin-top: 8px; }
  .mr-class-filter { flex: 1; min-width: 0; width: auto; margin: 0; border: 1px solid var(--mr-line); border-radius: 9px; padding: 7px 9px; font: inherit; font-size: 12.5px; background: #f8fafc; color: var(--mr-text); }
  .mr-select-row { display: flex; align-items: center; justify-content: space-between; gap: 10px; margin-top: 8px; font-size: 12px; color: var(--mr-muted); }
  .mr-select-row span { white-space: nowrap; }
  .mr-select-actions { display: flex; align-items: center; gap: 10px; }
  .mr-select-row button { width: auto; margin: 0; border: none; background: none; color: var(--mr-primary); font-weight: 700; cursor: pointer; font-size: 12px; padding: 0; white-space: nowrap; }
  .mr-select-row button[hidden] { display: none; }
  .mr-contact-list { overflow-y: auto; flex: 1; padding: 6px 8px; }
  .mr-contact { display: flex; align-items: flex-start; gap: 9px; padding: 9px 8px; border-radius: 9px; cursor: pointer; }
  .mr-contact:hover { background: #f6fbfc; }
  .mr-contact input[type="checkbox"] { margin-top: 3px; width: 15px; height: 15px; accent-color: var(--mr-primary); flex: 0 0 15px; }
  .mr-contact.disabled { opacity: 0.4; cursor: not-allowed; }
  .mr-contact-body { min-width: 0; flex: 1; }
  .mr-contact-name { font-weight: 700; font-size: 13px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .mr-contact-sub { font-size: 11px; color: var(--mr-muted); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; margin-bottom: 3px; }
  .mr-pill-row { display: flex; gap: 5px; flex-wrap: wrap; }
  .mr-pill { font-size: 10.5px; font-weight: 600; padding: 2px 7px; border-radius: 999px; border: 1px solid var(--mr-line); color: #334a5f; background: #f8fafc; }
  .mr-pill.mr-pill-missing { color: #b8c2cc; border-style: dashed; }
  .mr-contact-classes { color: var(--mr-primary); font-weight: 700; }
  .mr-empty { padding: 24px; text-align: center; color: var(--mr-muted); font-size: 13px; }
  .mr-more-btn { display: block; width: calc(100% - 8px); margin: 6px 4px 8px; padding: 8px 10px; border: 1px dashed var(--mr-line); border-radius: 9px; background: #f8fafc; color: var(--mr-primary); font: inherit; font-size: 12.5px; font-weight: 700; cursor: pointer; }
  .mr-more-btn:hover { border-style: solid; background: #f1f7f8; }

  /* Right: compose + history */
  .mr-right { display: flex; flex-direction: column; gap: 16px; min-width: 0; }
  .mr-compose { position: sticky; top: 8px; z-index: 5; padding: 16px; }
  .mr-channels { display: none; gap: 16px; margin-bottom: 8px; flex-wrap: wrap; }
  .mr-channels.mr-visible { display: flex; }
  .mr-channel-check { display: flex; align-items: center; gap: 7px; cursor: pointer; font-size: 13.5px; font-weight: 600; color: var(--mr-text); }
  .mr-channel-check input { width: 15px; height: 15px; accent-color: var(--mr-primary); cursor: pointer; }
  .mr-channel-check.mr-channel-disabled { cursor: not-allowed; opacity: 0.45; }
  .mr-channel-check.mr-channel-disabled input { cursor: not-allowed; }
  .mr-channel-note { font-size: 11px; color: var(--mr-muted); font-weight: 500; }
  .mr-channel-empty { font-size: 12.5px; color: var(--mr-muted); }
  .mr-channel-hint { display: none; margin-bottom: 10px; padding: 8px 11px; border-radius: 8px; background: #fff7d6; border: 1px solid #f0df94; color: #664400; font-size: 12.5px; line-height: 1.4; }
  .mr-compose-textarea { width: 100%; min-height: 96px; resize: vertical; border: 1px solid var(--mr-line); border-radius: 9px; padding: 10px 12px; font: inherit; font-size: 13.5px; }
  .mr-subject { display: none; width: 100%; margin: 0 0 8px; border: 1px solid var(--mr-line); border-radius: 9px; padding: 8px 12px; font: inherit; font-size: 13.5px; }
  .mr-subject.mr-visible { display: block; }
  .mr-sms-counter { display: none; margin: 6px 0 0; font-size: 11.5px; color: var(--mr-muted); }
  .mr-sms-counter.mr-visible { display: block; }
  .mr-compose-meta { display: flex; align-items: center; justify-content: flex-start; margin-top: 10px; gap: 14px; flex-wrap: wrap; }
  .mr-recipient-count { font-size: 12.5px; color: var(--mr-muted); font-weight: 600; }
  .mr-send-btn { width: auto; align-self: flex-start; background: linear-gradient(130deg, var(--mr-primary), #0e4650); color: #fff; border: none; border-radius: 7px; padding: 6px 14px; font-weight: 700; font-size: 13px; cursor: pointer; order: -1; }
  .mr-send-btn:disabled { opacity: 0.5; cursor: not-allowed; }
  .mr-status { margin-top: 10px; font-size: 12.5px; display: none; padding: 9px 11px; border-radius: 8px; }

  .mr-history { padding: 14px 16px; display: flex; flex-direction: column; gap: 10px; }
  .mr-history-header { display: flex; align-items: center; justify-content: space-between; gap: 12px; flex-wrap: wrap; }
  .mr-history-title { font-size: 13px; font-weight: 800; color: var(--mr-text); text-transform: uppercase; letter-spacing: 0.03em; }
  .mr-history-filters { display: flex; gap: 6px; flex-wrap: wrap; }
  .mr-filter-chip { width: auto; margin: 0; flex: 0 0 auto; font-size: 12px; font-weight: 700; color: var(--mr-muted); background: var(--mr-bg); border: 1px solid var(--mr-line); border-radius: 999px; padding: 4px 12px; cursor: pointer; }
  .mr-filter-chip.mr-filter-active { color: #fff; background: var(--mr-primary); border-color: var(--mr-primary); }
  .mr-history-rows { display: flex; flex-direction: column; gap: 10px; }
  .mr-message-card { border: 1px solid var(--mr-line); border-radius: 11px; padding: 11px 13px; display: flex; align-items: center; justify-content: space-between; gap: 12px; flex-wrap: wrap; }
  .mr-message-main { display: flex; align-items: center; gap: 10px; min-width: 0; flex-wrap: wrap; }
  .mr-message-recipient { font-weight: 700; font-size: 13px; color: var(--mr-text); }
  .mr-message-when { font-size: 12px; color: var(--mr-muted); white-space: nowrap; }
  .mr-badge { display: inline-flex; padding: 2px 9px; border-radius: 999px; font-size: 10.5px; font-weight: 700; text-transform: uppercase; }
  .mr-badge-sent { background: #dcfce7; color: #0f7a4a; }
  .mr-badge-failed { background: #ffe0e7; color: #a11434; }
  .mr-badge-pending { background: #fef3c7; color: #92400e; }
  .mr-badge-channel { background: #e5f3f4; color: var(--mr-primary); }
  .mr-resend-btn { width: auto; margin: 0; flex: 0 0 auto; font-size: 11px; font-weight: 700; line-height: 1.4; color: var(--mr-primary); background: none; border: 1px solid var(--mr-primary); border-radius: 999px; padding: 2px 10px; cursor: pointer; }
  .mr-resend-btn:hover { background: var(--mr-primary); color: #fff; }
  .mr-message-error { flex-basis: 100%; font-size: 12px; color: #a11434; }
  .mr-message-text-wrap { flex-basis: 100%; min-width: 0; }
  .mr-message-text { display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; font-size: 13px; color: var(--mr-text); word-break: break-word; }
  .mr-message-text.mr-expanded { -webkit-line-clamp: unset; display: block; overflow: visible; white-space: pre-wrap; }
  .mr-readmore { display: inline-block; margin-top: 2px; font-size: 12px; color: var(--mr-primary); cursor: pointer; text-decoration: underline; }
  .mr-message-actor { font-size: 11px; color: var(--mr-muted); word-break: break-word; }
  .mr-message-contact { font-size: 12px; color: var(--mr-muted); }
  .mr-message-subject { flex-basis: 100%; font-size: 12px; color: var(--mr-muted); }

  /* Confirm-and-send dialog */
  .mr-modal-backdrop { position: fixed; inset: 0; z-index: 13000; display: none; align-items: center; justify-content: center; padding: 16px; background: rgba(15, 23, 42, 0.5); backdrop-filter: blur(3px); }
  .mr-modal-backdrop.mr-open { display: flex; }
  .mr-modal { width: 100%; max-width: 440px; max-height: calc(100vh - 32px); overflow-y: auto; background: #fff; border-radius: 14px; box-shadow: 0 24px 60px rgba(15, 23, 42, 0.25); padding: 18px 20px; font-family: inherit; color: var(--mr-text); }
  .mr-modal h3 { margin: 0 0 6px; font-size: 16px; font-weight: 800; }
  .mr-modal-summary { margin: 0 0 10px; font-size: 13px; color: var(--mr-muted); }
  .mr-modal-preview { margin: 0 0 12px; padding: 10px 12px; border-radius: 9px; background: #f8fafc; border: 1px solid var(--mr-line); font-size: 13px; white-space: pre-wrap; word-break: break-word; max-height: 160px; overflow-y: auto; }
  .mr-modal label { display: block; margin: 0 0 4px; font-size: 12px; font-weight: 700; color: var(--mr-muted); }
  .mr-modal input[type="password"] { width: 100%; margin: 0 0 6px; border: 1px solid var(--mr-line); border-radius: 9px; padding: 9px 11px; font: inherit; font-size: 13.5px; }
  .mr-modal-error { min-height: 18px; margin: 0 0 8px; font-size: 12.5px; color: #b91c1c; }
  .mr-modal-actions { display: flex; justify-content: flex-end; gap: 8px; }
  .mr-modal-actions button { width: auto; margin: 0; border-radius: 8px; padding: 8px 14px; font: inherit; font-size: 13px; font-weight: 700; cursor: pointer; }
  .mr-modal-cancel { border: 1px solid var(--mr-line); background: #fff; color: var(--mr-text); }
  .mr-modal-confirm { border: none; background: var(--mr-primary); color: #fff; }
  .mr-modal-confirm:disabled { opacity: 0.6; cursor: progress; }

  /* Contact card (names in the contact list open it) */
  .mr-contact-open { all: unset; display: block; max-width: 100%; font-weight: 700; font-size: 13px; color: var(--mr-text); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; cursor: pointer; border-radius: 4px; }
  #mailroomRoot .mr-contact-open:hover { background: none; color: var(--mr-text); text-decoration: underline; text-decoration-thickness: 1.5px; text-underline-offset: 3px; }
  #mailroomRoot .mr-contact-open:focus { outline: none; }
  #mailroomRoot .mr-contact-open:focus-visible { text-decoration: underline; text-decoration-thickness: 1.5px; text-underline-offset: 3px; }
  /* One fixed size for every tab, so switching tabs never resizes the card. */
  #mrCard .mr-modal { display: flex; flex-direction: column; width: min(1040px, 100%); max-width: none; height: min(86vh, 820px); max-height: none; padding: 0; overflow: hidden; border-radius: 18px; background: #f5f7f9; }
  #mrCard :where(button) { width: auto; margin: 0; font-family: inherit; line-height: 1.2; }
  .cc-head { display: flex; align-items: center; gap: 16px; padding: 20px 22px 0; background: #fff; }
  .cc-avatar { flex: none; display: grid; place-items: center; width: 64px; height: 64px; border-radius: 50%; background: var(--av, #8b5cf6); color: #fff; font-size: 22px; font-weight: 800; letter-spacing: .02em; overflow: hidden; box-shadow: 0 0 0 4px color-mix(in srgb, var(--av, #8b5cf6) 16%, #fff); }
  .cc-avatar img { width: 100%; height: 100%; object-fit: cover; }
  .cc-id { flex: 1; min-width: 0; }
  .cc-id h3 { margin: 0; font-size: 20px; font-weight: 800; letter-spacing: -.01em; text-align: left; color: var(--mr-text); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .cc-meta { display: flex; flex-wrap: wrap; align-items: center; gap: 6px; margin-top: 6px; }
  .cc-pill { display: inline-flex; align-items: center; gap: 5px; height: 24px; padding: 0 9px; border-radius: 999px; background: color-mix(in srgb, var(--mr-primary) 9%, #fff); color: var(--mr-primary); font-size: 12px; font-weight: 700; }
  .cc-pill svg { width: 13px; height: 13px; }
  .cc-pill--plain { background: #f1f4f7; color: #4a5b6c; }
  .cc-actions { flex: none; display: flex; align-items: center; gap: 8px; align-self: flex-start; }
  .cc-btn { display: inline-flex; align-items: center; gap: 6px; height: 36px; padding: 0 16px; border: 1px solid #dde4ea; border-radius: 10px; background: #fff; color: var(--mr-text); font-size: 13px; font-weight: 700; cursor: pointer; }
  .cc-btn:hover { background: #f6f8fa; }
  .cc-btn--primary { border-color: transparent; background: var(--mr-primary); color: #fff; }
  .cc-btn--primary:hover { background: var(--mr-primary); filter: brightness(.94); }
  .cc-btn:disabled { opacity: .45; cursor: default; filter: none; }
  .cc-btn--primary:disabled { background: #c9d3dc; }
  .cc-tabs { display: flex; gap: 4px; padding: 16px 22px 0; background: #fff; border-bottom: 1px solid #e4e9ee; overflow-x: auto; scrollbar-width: none; }
  .cc-tabs::-webkit-scrollbar { display: none; }
  #mrCard .cc-tab { flex: none; display: inline-flex; align-items: center; gap: 7px; height: 40px; padding: 0 12px; border: 0; border-bottom: 2.5px solid transparent; border-radius: 0; background: none; color: #667788; font-size: 13px; font-weight: 700; cursor: pointer; }
  #mrCard .cc-tab:hover { color: var(--mr-text); }
  #mrCard .cc-tab.is-on { color: var(--mr-primary); border-bottom-color: var(--mr-primary); }
  #mrCard .cc-tab:focus { outline: none; box-shadow: none; }
  #mrCard .cc-tab:focus-visible { color: var(--mr-text); background: #f3f6f8; }
  #mrCard .cc-btn:focus { outline: none; }
  #mrCard .cc-btn:focus-visible { box-shadow: 0 0 0 3px color-mix(in srgb, var(--mr-primary) 25%, transparent); }
  #mrCard a.cc-btn { text-decoration: none; }
  #mrCard .cc-btn svg { width: 15px; height: 15px; }
  .cc-tab svg { width: 15px; height: 15px; }
  .cc-tab b { min-width: 18px; height: 18px; padding: 0 5px; border-radius: 999px; background: #eef2f5; color: #4a5b6c; font-size: 11px; line-height: 18px; text-align: center; }
  .cc-body { flex: 1; min-height: 0; overflow-y: auto; padding: 16px 22px 20px; }
  .cc-panel { display: none; gap: 12px; }
  .cc-panel.is-on { display: grid; }
  .cc-row2 { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; }
  .cc-box { padding: 14px 16px 16px; border: 1px solid #e4e9ee; border-radius: 12px; background: #fff; }
  .cc-box h4 { display: flex; align-items: center; gap: 7px; margin: 0 0 10px; font-size: 13px; font-weight: 800; color: var(--mr-text); text-align: left; }
  .cc-box h4 svg { width: 15px; height: 15px; color: #8796a5; }
  .cc-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px; }
  .cc-grid--2 { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .cc-grid .is-wide { grid-column: 1 / -1; }
  .cc-field { display: grid; gap: 5px; align-content: start; margin: 0; min-width: 0; }
  .cc-field > span { font-size: 11.5px; font-weight: 700; color: #556676; }
  .cc-field > span i { font-style: normal; color: #d0453c; }
  .cc-field small { font-size: 11.5px; color: #8796a5; }
  #mrCard .cc-field :is(input, select, textarea) { width: 100%; height: 38px; margin: 0; padding: 0 11px; border: 1px solid #dfe5eb; border-radius: 9px; background: #fff; color: var(--mr-text); font: inherit; font-size: 13.5px; transition: border-color .15s, box-shadow .15s; }
  #mrCard .cc-field textarea { height: auto; min-height: 84px; padding: 9px 11px; resize: vertical; }
  #mrCard .cc-field :is(input, select, textarea):focus { outline: none; border-color: var(--mr-primary); box-shadow: 0 0 0 3px color-mix(in srgb, var(--mr-primary) 14%, transparent); }
  #mrCard .cc-field :is(input, select, textarea)::placeholder { color: #a6b2be; }
  #mrCard .is-readonly .cc-field :is(input, select, textarea) { border-color: transparent; background: #f5f7f9; color: var(--mr-text); opacity: 1; -webkit-text-fill-color: var(--mr-text); }
  .cc-with-action { display: flex; gap: 6px; }
  .cc-with-action > input { flex: 1; min-width: 0; }
  .cc-icon-link { flex: none; display: grid; place-items: center; width: 38px; height: 38px; border: 1px solid #dfe5eb; border-radius: 9px; background: #fff; color: #556676; text-decoration: none; }
  .cc-icon-link:hover { border-color: var(--mr-primary); color: var(--mr-primary); }
  .cc-icon-link[aria-disabled="true"] { pointer-events: none; opacity: .4; }
  .cc-icon-link svg { width: 16px; height: 16px; }
  .cc-obsolete > span::after { content: "Obsolete"; margin-left: 6px; padding: 1px 6px; border-radius: 999px; background: #fdf3dc; color: #8a5a00; font-size: 10px; }
  .cc-kids { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 10px; }
  .cc-kid { display: flex; align-items: center; gap: 10px; padding: 12px; border: 1px solid #e4e9ee; border-radius: 12px; background: #fff; }
  .cc-kid__av { flex: none; display: grid; place-items: center; width: 38px; height: 38px; border-radius: 50%; background: #eef2f5; color: #4a5b6c; font-size: 13px; font-weight: 800; }
  .cc-kid strong { display: block; font-size: 13.5px; }
  .cc-kid span { font-size: 12px; color: #667788; }
  .cc-empty { padding: 28px 12px; border: 1.5px dashed #dfe5eb; border-radius: 12px; text-align: center; font-size: 13px; color: #8796a5; }
  .cc-empty a { color: var(--mr-primary); font-weight: 700; }
  .cc-status { min-height: 0; margin: 0; padding: 0 22px; font-size: 12.5px; font-weight: 600; }
  .cc-status:not(:empty) { padding: 10px 22px; border-top: 1px solid #e4e9ee; background: #fff; }
  .cc-status.is-error { color: #c0262d; }
  .cc-status.is-ok { color: #15803d; }
  .cc-loading { flex: 1; display: grid; place-items: center; padding: 20px; font-size: 13px; color: var(--mr-muted); }
  @media (max-width: 700px) {
    #mrCard .mr-modal { height: 94vh; border-radius: 16px; }
    .cc-head { flex-wrap: wrap; padding: 16px 16px 0; gap: 12px; }
    .cc-avatar { width: 48px; height: 48px; font-size: 17px; }
    .cc-actions { width: 100%; order: 3; }
    .cc-actions .cc-btn { flex: 1; justify-content: center; }
    .cc-tabs { padding: 10px 12px 0; }
    .cc-body { padding: 12px 14px 16px; }
    .cc-row2, .cc-grid, .cc-grid--2 { grid-template-columns: minmax(0, 1fr); }
  }
  .mr-setup-banner {
    display: none;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    flex-wrap: wrap;
    background: #fff7d6;
    border: 1px solid #f0df94;
    color: #664400;
    border-radius: 10px;
    padding: 11px 14px;
    margin-bottom: 14px;
    font-size: 13px;
  }
  .mr-setup-banner a {
    background: #664400;
    color: #fff7d6;
    text-decoration: none;
    font-weight: 700;
    font-size: 12.5px;
    padding: 6px 12px;
    border-radius: 7px;
    white-space: nowrap;
  }
  .mr-setup-banner a:hover { opacity: 0.9; }

  /* Mobile: contacts opens as a right-side slide-in drawer over a backdrop
     — the same overlay pattern used across the app's hub pages (e.g. the
     student/guardian panels) — instead of pushing or expanding the page.
     The page underneath stays exactly as it was; the drawer just floats
     on top and slides away again on close. */
  .mr-drawer-backdrop {
    position: fixed;
    inset: 0;
    background: rgba(15, 23, 42, 0.5);
    backdrop-filter: blur(3px);
    z-index: 12000;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.2s ease;
  }
  .mr-drawer-backdrop.mr-drawer-open {
    opacity: 1;
    pointer-events: auto;
  }
  .mr-directory-close {
    display: none;
    position: absolute;
    top: 10px;
    right: 10px;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    border: none;
    background: #f1f5f9;
    color: #475569;
    border-radius: 50%;
    font-size: 16px;
    line-height: 1;
    cursor: pointer;
    z-index: 1;
  }

  @media (max-width: 780px) {
    #mailroomRoot { padding: 12px; }
    .mr-header h1 { font-size: 19px; }
    .mr-setup-banner { padding: 10px 12px; font-size: 12.5px; }

    .mr-directory-open-row { display: flex; justify-content: flex-end; margin-bottom: 12px; }
    .mr-directory-toggle { display: flex; }

    .mr-directory {
      position: fixed;
      top: 0;
      right: 0;
      bottom: 0;
      left: auto;
      width: 100%;
      max-width: 420px;
      max-height: none;
      min-height: 0;
      border-radius: 0;
      z-index: 12001;
      transform: translateX(100%);
      transition: transform 0.28s cubic-bezier(0.22, 1, 0.36, 1);
    }
    .mr-directory.mr-drawer-open { transform: translateX(0); }

    .mr-directory-head { position: relative; padding-right: 46px; }
    .mr-directory-close { display: flex; }
    .mr-contact { padding: 11px 8px; }
    .mr-contact input[type="checkbox"] { width: 18px; height: 18px; }

    .mr-compose { position: static; }
    .mr-channels { gap: 12px; }
    .mr-compose-meta { justify-content: space-between; }
    .mr-send-btn { padding: 8px 16px; font-size: 13.5px; }

    .mr-message-card { flex-direction: column; align-items: flex-start; gap: 6px; }
    .mr-message-main { gap: 8px; }
  }
</style>

<div id="mailroomRoot" data-can-see-contacts="<%= typeof canSeeContacts !== 'undefined' && canSeeContacts ? '1' : '0' %>">
  <div class="mr-header mr-header--tabs">
    <div>
      <h1>Mailroom</h1>
      <p>Message families by email, text or WhatsApp, and answer the messages parents send.</p>
    </div>
    <div class="mr-tabs" role="tablist" aria-label="Mailroom">
      <button type="button" class="mr-tab is-active" role="tab" aria-selected="true" data-mr-view="send">Send</button>
      <button type="button" class="mr-tab" role="tab" aria-selected="false" data-mr-view="inbox">Inbox <span class="mr-tab-badge" id="mrInboxBadge" hidden></span></button>
    </div>
  </div>

  <div class="mr-inbox" id="mrInbox" hidden>
    <section class="mr-panel mr-inbox-list">
      <div class="mr-inbox-head">
        <div class="mr-inbox-filters" role="group" aria-label="Show">
          <button type="button" class="mr-filter-chip mr-filter-active" data-inbox-filter="needs">Needs reply</button>
          <button type="button" class="mr-filter-chip" data-inbox-filter="open">Open</button>
          <button type="button" class="mr-filter-chip" data-inbox-filter="all">All</button>
        </div>
        <input type="text" id="mrInboxSearch" class="mr-search" placeholder="Search parent, student, class, subject..." aria-label="Search messages">
      </div>
      <div class="mr-inbox-rows" id="mrInboxRows"><div class="mr-empty">Loading messages...</div></div>
    </section>
    <section class="mr-panel mr-thread" id="mrThread">
      <div class="mr-empty mr-thread-empty">Select a conversation to read and reply.</div>
    </section>
  </div>

  <div class="mr-setup-banner mr-send-only" id="mrSetupBanner">
    <span id="mrSetupBannerText">Text and WhatsApp aren't set up for this school yet — only Email can be used to reach guardians.</span>
    <a href="/common/management?panel=integrations&page=%2Faccount%2Fsettings%3Fsection%3Dintegrations&label=Integrations">Activate in Integrations</a>
  </div>

  <div class="mr-drawer-backdrop" id="mrDrawerBackdrop"></div>

  <div class="mr-directory-open-row mr-send-only">
    <button type="button" class="mr-directory-toggle" id="mrDirectoryToggle" aria-expanded="false" aria-controls="mrDirectory">
      <span class="mr-directory-toggle-label">
        <span>Contacts</span>
        <span class="mr-directory-toggle-count" id="mrDirectoryToggleCount" style="display:none;"></span>
      </span>
      <svg class="mr-directory-toggle-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 6 15 12 9 18"></polyline></svg>
    </button>
  </div>

  <div class="mr-layout mr-send-only">
    <section class="mr-panel mr-directory" id="mrDirectory">
      <div class="mr-directory-head">
        <button type="button" class="mr-directory-close" id="mrDirectoryClose" aria-label="Close">&times;</button>
        <h2>Contacts</h2>
        <input type="text" id="mrSearch" class="mr-search" placeholder="Search name, student, phone, email..." aria-label="Search contacts">
        <div class="mr-filter-row" id="mrFilterRow" hidden>
          <select id="mrClassFilter" class="mr-class-filter" aria-label="Filter by class">
            <option value="">All classes</option>
          </select>
        </div>
        <div class="mr-select-row">
          <span id="mrContactCount">Loading contacts...</span>
          <span class="mr-select-actions">
            <button type="button" id="mrClearSelection" hidden>Clear</button>
            <button type="button" id="mrSelectAll">Select all</button>
          </span>
        </div>
      </div>
      <div class="mr-contact-list" id="mrContactList">
        <div class="mr-empty">Loading contacts...</div>
      </div>
    </section>

    <section class="mr-right">
      <div class="mr-panel mr-compose">
        <input type="text" id="mrSubject" class="mr-subject" maxlength="150" placeholder="Email subject (optional)" aria-label="Email subject">
        <textarea id="mrMessage" class="mr-compose-textarea" placeholder="Type your message..." aria-label="Message"></textarea>
        <div class="mr-sms-counter" id="mrSmsCounter"></div>
        <div class="mr-channels" id="mrChannels"></div>
        <div class="mr-channel-hint" id="mrChannelHint"></div>
        <div class="mr-compose-meta">
          <span class="mr-recipient-count" id="mrRecipientCount">0 recipients selected</span>
          <button type="button" class="mr-send-btn" id="mrSendBtn" disabled>Send</button>
        </div>
        <div class="mr-status" id="mrStatus"></div>
      </div>

      <div class="mr-panel mr-history">
        <div class="mr-history-header">
          <span class="mr-history-title">History</span>
          <div class="mr-history-filters" id="mrHistoryFilters">
            <button type="button" class="mr-filter-chip mr-filter-active" data-channel="all">All</button>
            <button type="button" class="mr-filter-chip" data-channel="sms" id="mrFilterChipSms" style="display:none;">Text</button>
            <button type="button" class="mr-filter-chip" data-channel="whatsapp" id="mrFilterChipWhatsapp" style="display:none;">WhatsApp</button>
            <button type="button" class="mr-filter-chip" data-channel="email">Email</button>
          </div>
        </div>
        <div class="mr-history-rows" id="mrHistoryRows">
          <div class="mr-empty">Loading history...</div>
        </div>
        <button type="button" class="mr-more-btn" id="mrHistoryMore" hidden>Show more</button>
      </div>
    </section>
  </div>

  <div class="mr-modal-backdrop" id="mrConfirmBackdrop" role="dialog" aria-modal="true" aria-labelledby="mrConfirmTitle">
    <div class="mr-modal">
      <h3 id="mrConfirmTitle">Send message</h3>
      <p class="mr-modal-summary" id="mrConfirmSummary"></p>
      <div class="mr-modal-preview" id="mrConfirmPreview"></div>
      <div id="mrConfirmPasswordWrap">
        <label for="mrConfirmPassword">Your password</label>
        <input type="password" id="mrConfirmPassword" autocomplete="current-password">
      </div>
      <div class="mr-modal-error" id="mrConfirmError" role="alert"></div>
      <div class="mr-modal-actions">
        <button type="button" class="mr-modal-cancel" id="mrConfirmCancel">Cancel</button>
        <button type="button" class="mr-modal-confirm" id="mrConfirmOk">Send</button>
      </div>
    </div>
  </div>

  <div class="mr-modal-backdrop" id="mrCard" role="dialog" aria-modal="true" aria-labelledby="ccName">
    <div class="mr-modal" id="mrCardBox"></div>
  </div>
</div>

<script>
(function () {
  const state = {
    contacts: [],
    channels: new Set(),
    selected: new Map(),
    orgChannels: { sms: false, whatsapp: false, email: false },
    contactLimit: 30,
    verifiedUntil: 0,
  };
  const CONTACT_PAGE = 30;
  const HISTORY_PAGE = 25;

  const CHANNEL_META = {
    sms: { label: 'Text (SMS)', field: 'phone', missing: 'no phone number' },
    whatsapp: { label: 'WhatsApp', field: 'phone', missing: 'no phone number' },
    email: { label: 'Email', field: 'email', missing: 'no email address' },
  };

  const $ = (id) => document.getElementById(id);

  function escapeHtml(v) {
    return String(v == null ? '' : v).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;').replace(/'/g, '&#39;');
  }

  // SMS and WhatsApp both need a phone; Email needs an email.
  function channelField(channel) { return CHANNEL_META[channel]?.field || 'phone'; }

  function fmtDate(v) {
    if (!v) return '-';
    try { return new Date(v).toLocaleString(); } catch (_) { return '-'; }
  }

  // ---- Contacts ----
  function filteredContacts() {
    const query = ($('mrSearch').value || '').trim().toLowerCase();
    const className = $('mrClassFilter').value;
    return state.contacts.filter((c) => {
      if (className && !(c.classNames || []).includes(className)) return false;
      if (!query) return true;
      const hay = `${c.guardianName} ${(c.studentNames || []).join(' ')} ${(c.classNames || []).join(' ')} ${c.phone} ${c.email}`.toLowerCase();
      return hay.includes(query);
    });
  }

  function renderContacts() {
    const list = $('mrContactList');
    const filtered = filteredContacts();
    $('mrContactCount').textContent = `${filtered.length} contact${filtered.length === 1 ? '' : 's'}`;

    if (!filtered.length) {
      list.innerHTML = `<div class="mr-empty">${state.contacts.length ? 'No contacts match.' : 'No guardian contacts on file yet.'}</div>`;
      updateSelectAllLabel(filtered);
      return;
    }

    // Long lists show a page at a time; "Show more" adds the next page.
    const shown = filtered.slice(0, state.contactLimit);
    const remaining = filtered.length - shown.length;

    // Recipient selection is independent of channel — which contacts can
    // actually be reached on a given channel is resolved at send time.
    list.innerHTML = shown.map((c) => {
      const checked = state.selected.has(c.id);
      const students = (c.studentNames || []).join(', ');
      const classes = (c.classNames || []).join(', ');
      return `<label class="mr-contact" data-key="${escapeHtml(c.id)}">
        <input type="checkbox" ${checked ? 'checked' : ''} aria-label="Select ${escapeHtml(c.guardianName)}">
        <div class="mr-contact-body">
          ${canSeeContacts
            ? `<button type="button" class="mr-contact-open" data-open-contact title="Open contact card">${escapeHtml(c.guardianName)}</button>`
            : `<div class="mr-contact-name">${escapeHtml(c.guardianName)}</div>`}
          <div class="mr-contact-sub" title="${escapeHtml(students)}">${classes ? `<span class="mr-contact-classes">${escapeHtml(classes)}</span> · ` : ''}${escapeHtml(students || 'No linked student on file')}</div>
          <div class="mr-pill-row">
            <span class="mr-pill ${c.phone ? '' : 'mr-pill-missing'}">${c.phone ? escapeHtml(c.phone) : 'No phone'}</span>
            <span class="mr-pill ${c.email ? '' : 'mr-pill-missing'}">${c.email ? escapeHtml(c.email) : 'No email'}</span>
          </div>
        </div>
      </label>`;
    }).join('') + (remaining > 0
      ? `<button type="button" class="mr-more-btn" data-action="more-contacts">Show ${Math.min(CONTACT_PAGE, remaining)} more (${remaining} not shown)</button>`
      : '');

    updateSelectAllLabel(filtered);
  }

  // One listener for the whole list (rows are re-rendered often).
  $('mrContactList').addEventListener('change', (e) => {
    const checkbox = e.target.closest('.mr-contact input[type="checkbox"]');
    if (!checkbox) return;
    const key = checkbox.closest('.mr-contact').getAttribute('data-key');
    const contact = state.contacts.find((c) => c.id === key);
    if (!contact) return;
    if (checkbox.checked) state.selected.set(key, contact);
    else state.selected.delete(key);
    updateRecipientCount();
  });
  $('mrContactList').addEventListener('click', (e) => {
    const opener = e.target.closest('[data-open-contact]');
    if (opener) {
      e.preventDefault();
      const contact = state.contacts.find((c) => c.id === opener.closest('.mr-contact').getAttribute('data-key'));
      if (contact) openContactCard(contact);
      return;
    }
    if (e.target.closest('[data-action="more-contacts"]')) {
      state.contactLimit += CONTACT_PAGE;
      renderContacts();
    }
  });

  // ---- Contact card ----
  // Opened from a name in the contact list (needs "See Contacts"). With "Edit
  // Contacts" every field is editable in place and Save lights up once
  // something changes. Tabs: Contact info, Children, then one per section of
  // the school's contact template (Management Tools > Contact template).
  const canSeeContacts = document.getElementById('mailroomRoot').dataset.canSeeContacts === '1';
  const TEMPLATE_URL = '/common/management?panel=contact-template&page=%2Fcommon%2Fcontact-template&label=Contact%20Template';
  const cardState = { contact: null, data: null, tab: 'info', initial: '', saving: false };
  const AVATAR_COLORS = ['#7c5cf0', '#0ea5e9', '#0f9f8f', '#f97316', '#e0457b', '#5b6ee8', '#16a34a', '#c2410c'];
  const initials = (name) => String(name || '?').split(/\s+/).filter(Boolean).slice(0, 2).map((w) => w[0].toUpperCase()).join('') || '?';
  const avatarColor = (name) => AVATAR_COLORS[[...String(name || '')].reduce((n, ch) => (n * 31 + ch.charCodeAt(0)) >>> 0, 7) % AVATAR_COLORS.length];
  const cardSvg = (d) => `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${d}</svg>`;
  const CC_ICON = {
    info: cardSvg('<rect x="3" y="5" width="18" height="14" rx="2"/><circle cx="9" cy="11" r="2.2"/><path d="M5.8 16c.6-1.5 1.8-2.3 3.2-2.3s2.6.8 3.2 2.3M15 10h3M15 14h3"/>'),
    kids: cardSvg('<circle cx="9" cy="8" r="3.2"/><path d="M3 20c0-3.3 2.7-6 6-6s6 2.7 6 6"/><circle cx="17" cy="9" r="2.4"/><path d="M21 19c0-2.4-1.6-4.3-4-4.8"/>'),
    section: cardSvg('<path d="M3 7a2 2 0 0 1 2-2h4l2 2h8a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2Z"/>'),
    user: cardSvg('<circle cx="12" cy="8" r="4"/><path d="M4 21c0-4.4 3.6-8 8-8s8 3.6 8 8"/>'),
    phone: cardSvg('<path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.4 1.8.7 2.7a2 2 0 0 1-.5 2.1L8 9.8a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.7.7a2 2 0 0 1 1.7 2Z"/>'),
    mail: cardSvg('<rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-10 6L2 7"/>'),
    pin: cardSvg('<path d="M12 21s-7-6.1-7-11a7 7 0 0 1 14 0c0 4.9-7 11-7 11Z"/><circle cx="12" cy="10" r="2.5"/>'),
  };

  function cardTabs(d) {
    const tabs = [{ id: 'info', label: 'Contact info', icon: CC_ICON.info }, { id: 'kids', label: 'Children', icon: CC_ICON.kids, count: d.students.length }];
    d.sections.forEach((s) => {
      if (d.fields.some((f) => f.sectionId === s.id)) tabs.push({ id: `s${s.id}`, label: s.name, icon: CC_ICON.section });
    });
    if (d.fields.some((f) => !f.sectionId)) tabs.push({ id: 's0', label: 'More details', icon: CC_ICON.section });
    return tabs;
  }

  function ccField(name, label, value, opts = {}) {
    const attrs = opts.attrs || '';
    return `<label class="cc-field ${opts.wide ? 'is-wide' : ''}"><span>${label}${opts.required ? ' <i>*</i>' : ''}</span><input name="${name}" value="${escapeHtml(value)}" autocomplete="off" ${attrs}></label>`;
  }

  function customField(f) {
    const name = `field-${f.id}`;
    const v = escapeHtml(f.value);
    let control;
    if (f.type === 'long_text') control = `<textarea name="${name}" maxlength="4000">${v}</textarea>`;
    else if (f.type === 'number') control = `<input name="${name}" inputmode="decimal" value="${v}" autocomplete="off">`;
    else if (f.type === 'date') control = `<input type="date" name="${name}" value="${v}">`;
    else if (f.type === 'choice') control = `<select name="${name}"><option value="">Not set</option>${f.options.map((o) => `<option ${o === f.value ? 'selected' : ''}>${escapeHtml(o)}</option>`).join('')}${f.value && !f.options.includes(f.value) ? `<option selected>${v}</option>` : ''}</select>`;
    else if (f.type === 'yes_no') control = `<select name="${name}"><option value="">Not set</option><option value="yes" ${f.value === 'yes' ? 'selected' : ''}>Yes</option><option value="no" ${f.value === 'no' ? 'selected' : ''}>No</option></select>`;
    else control = `<input name="${name}" maxlength="500" value="${v}" autocomplete="off">`;
    // Obsolete fields keep their saved answer on the card but can't be changed;
    // nothing can be changed without "Edit Contacts".
    if (f.obsolete || !cardState.data.canEdit) control = control.replace(/^<(input|textarea|select)/, '<$1 disabled');
    if (!cardState.data.canEdit && !f.value) control = `<input disabled placeholder="Not added">`;
    return `<label class="cc-field ${f.type === 'long_text' ? 'is-wide' : ''} ${f.obsolete ? 'cc-obsolete' : ''}"><span>${escapeHtml(f.label)}</span>${control}${f.helpText ? `<small>${escapeHtml(f.helpText)}</small>` : ''}</label>`;
  }

  function cardHtml() {
    const { data: d, canEdit, canEditTemplate } = cardState.data;
    const b = d.base;
    const name = `${b.firstName} ${b.lastName}`.trim();
    const tabs = cardTabs(d);
    if (!tabs.some((t) => t.id === cardState.tab)) cardState.tab = 'info';
    const ro = canEdit ? '' : 'readonly';
    const kidNames = d.students.map((k) => k.name.split(' ')[0]);
    const panel = (id, html) => `<div class="cc-panel ${cardState.tab === id ? 'is-on' : ''}" data-panel="${id}" role="tabpanel">${html}</div>`;
    const sectionPanel = (id) => {
      const list = d.fields.filter((f) => (f.sectionId || 0) === id);
      return `<div class="cc-box"><div class="cc-grid cc-grid--2">${list.map(customField).join('')}</div></div>`;
    };
    const telHref = b.phone ? `tel:${b.phone.replace(/[^\d+]/g, '')}` : '#';
    const mailHref = b.email ? `mailto:${b.email}` : '#';
    return `
      <div class="cc-head">
        <div class="cc-avatar" style="--av:${avatarColor(name)}">${b.imageUrl ? `<img src="${escapeHtml(b.imageUrl)}" alt="">` : escapeHtml(initials(name))}</div>
        <div class="cc-id">
          <h3 id="ccName">${escapeHtml(name)}</h3>
          <div class="cc-meta">
            <span class="cc-pill">${CC_ICON.user}Parent / guardian</span>
            ${kidNames.length ? `<span class="cc-pill cc-pill--plain">Parent of ${escapeHtml(kidNames.slice(0, 3).join(', '))}${kidNames.length > 3 ? ` +${kidNames.length - 3}` : ''}</span>` : ''}
          </div>
        </div>
        <div class="cc-actions">
          ${canEditTemplate ? `<a class="cc-btn" href="${TEMPLATE_URL}" data-no-spa data-card-template title="Change the fields every contact card has">${cardSvg('<path d="M12 20h9"/><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4Z"/>')}Edit template</a>` : ''}
          <button type="button" class="cc-btn" data-card-close>Close</button>
          ${canEdit ? '<button type="button" class="cc-btn cc-btn--primary" data-card-save disabled>Save</button>' : ''}
        </div>
      </div>
      <nav class="cc-tabs" role="tablist">
        ${tabs.map((t) => `<button type="button" class="cc-tab ${cardState.tab === t.id ? 'is-on' : ''}" role="tab" aria-selected="${cardState.tab === t.id}" data-tab="${t.id}">${t.icon}${escapeHtml(t.label)}${t.count != null ? `<b>${t.count}</b>` : ''}</button>`).join('')}
      </nav>
      <form class="cc-body ${canEdit ? '' : 'is-readonly'}" data-card-form novalidate>
        ${panel('info', `
          <div class="cc-box">
            <h4>${CC_ICON.user}Name</h4>
            <div class="cc-grid">
              ${ccField('firstName', 'First name', b.firstName, { required: true, attrs: `maxlength="100" ${ro}` })}
              ${ccField('lastName', 'Last name', b.lastName, { required: true, attrs: `maxlength="100" ${ro}` })}
              ${ccField('dateOfBirth', 'Date of birth', b.dateOfBirth, { attrs: canEdit || b.dateOfBirth ? `type="date" ${ro}` : 'readonly placeholder="Not added"' })}
            </div>
          </div>
          <div class="cc-row2">
            <div class="cc-box">
              <h4>${CC_ICON.phone}Phone</h4>
              <label class="cc-field"><span>Phone number</span><div class="cc-with-action"><input name="phone" type="tel" maxlength="40" value="${escapeHtml(b.phone)}" placeholder="Enter a phone number" autocomplete="off" ${ro}><a class="cc-icon-link" href="${escapeHtml(telHref)}" title="Call" aria-label="Call" ${b.phone ? '' : 'aria-disabled="true"'}>${CC_ICON.phone}</a></div></label>
            </div>
            <div class="cc-box">
              <h4>${CC_ICON.mail}Email</h4>
              <label class="cc-field"><span>Email address</span><div class="cc-with-action"><input name="email" type="email" maxlength="160" value="${escapeHtml(b.email)}" placeholder="Enter an email address" autocomplete="off" ${ro}><a class="cc-icon-link" href="${escapeHtml(mailHref)}" title="Send email" aria-label="Send email" ${b.email ? '' : 'aria-disabled="true"'}>${CC_ICON.mail}</a></div></label>
            </div>
          </div>
          <div class="cc-box">
            <h4>${CC_ICON.pin}Address</h4>
            <div class="cc-grid cc-grid--2">
              ${ccField('address', 'Street address', b.address, { wide: true, attrs: `maxlength="300" placeholder="Street, city, state, zip" ${ro}` })}
              ${ccField('hometown', 'Hometown', b.hometown, { attrs: `maxlength="120" ${ro}` })}
            </div>
          </div>
          ${!d.fields.length && canEditTemplate ? '<p class="cc-empty" style="padding:14px">Keep more details for every contact: <a href="${TEMPLATE_URL}" data-no-spa data-card-template>add fields in the contact template</a>.</p>' : ''}`)}
        ${panel('kids', d.students.length
          ? `<div class="cc-kids">${d.students.map((k) => `<div class="cc-kid"><span class="cc-kid__av">${escapeHtml(initials(k.name))}</span><div><strong>${escapeHtml(k.name)}</strong><span>${escapeHtml([k.className, k.relationship].filter(Boolean).join(' · ') || 'Student')}</span></div></div>`).join('')}</div>`
          : '<div class="cc-empty">No children are linked to this contact.</div>')}
        ${d.sections.map((s) => d.fields.some((f) => f.sectionId === s.id) ? panel(`s${s.id}`, sectionPanel(s.id)) : '').join('')}
        ${d.fields.some((f) => !f.sectionId) ? panel('s0', sectionPanel(0)) : ''}
      </form>
      <p class="cc-status" data-card-status role="status"></p>`;
  }

  function cardValues() {
    const form = $('mrCardBox').querySelector('[data-card-form]');
    if (!form) return null;
    const get = (n) => ((form.querySelector(`[name="${n}"]`) || {}).value || '').trim();
    const base = {};
    ['firstName', 'lastName', 'phone', 'email', 'address', 'hometown', 'dateOfBirth'].forEach((k) => { base[k] = get(k); });
    const fields = {};
    cardState.data.data.fields.filter((f) => !f.obsolete).forEach((f) => { fields[f.id] = get(`field-${f.id}`); });
    return { base, fields };
  }
  const isDirty = () => cardState.data && cardState.data.canEdit && JSON.stringify(cardValues()) !== cardState.initial;

  function setStatus(text, tone) {
    const el = $('mrCardBox').querySelector('[data-card-status]');
    if (!el) return;
    el.textContent = text || '';
    el.className = `cc-status ${tone ? `is-${tone}` : ''}`;
  }

  function renderCard() {
    const box = $('mrCardBox');
    if (!cardState.data) {
      const name = cardState.contact.guardianName;
      box.innerHTML = `<div class="cc-head" style="padding-bottom:20px"><div class="cc-avatar" style="--av:${avatarColor(name)}">${escapeHtml(initials(name))}</div><div class="cc-id"><h3 id="ccName">${escapeHtml(name)}</h3></div><div class="cc-actions"><button type="button" class="cc-btn" data-card-close>Close</button></div></div><div class="cc-loading">Loading contact…</div>`;
      return;
    }
    box.innerHTML = cardHtml();
    cardState.initial = JSON.stringify(cardValues());
  }

  async function openContactCard(contact) {
    cardState.contact = contact;
    cardState.data = null;
    cardState.tab = 'info';
    $('mrCard').classList.add('mr-open');
    renderCard();
    try {
      const res = await fetch('/common/contacts/card?keys=' + encodeURIComponent(contact.keys.join(',')), { credentials: 'same-origin', headers: { Accept: 'application/json' } });
      const out = await res.json().catch(() => ({}));
      if (cardState.contact !== contact) return;
      if (!res.ok || !out.success) throw new Error(out.error || 'This contact could not be loaded.');
      cardState.data = { data: out.contact, canEdit: out.canEdit, canEditTemplate: out.canEditTemplate };
      renderCard();
    } catch (err) {
      if (cardState.contact !== contact) return;
      $('mrCardBox').querySelector('.cc-loading').textContent = err.message;
    }
  }

  function closeContactCard() {
    if (isDirty() && !confirm('Discard the changes to this contact?')) return;
    cardState.contact = null;
    cardState.data = null;
    $('mrCard').classList.remove('mr-open');
  }

  async function saveContactCard() {
    if (cardState.saving || !isDirty()) return;
    const values = cardValues();
    if (!values.base.firstName || !values.base.lastName) { cardState.tab = 'info'; showTab('info'); setStatus('First and last name are required.', 'error'); return; }
    if (!values.base.phone && !values.base.email) { cardState.tab = 'info'; showTab('info'); setStatus('Add a phone number or an email address.', 'error'); return; }
    const btn = $('mrCardBox').querySelector('[data-card-save]');
    cardState.saving = true;
    btn.disabled = true;
    btn.textContent = 'Saving…';
    setStatus('');
    try {
      const res = await fetch('/common/contacts/card', {
        method: 'POST', credentials: 'same-origin',
        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
        body: JSON.stringify({ keys: cardState.contact.keys, ...values }),
      });
      const out = await res.json().catch(() => ({}));
      if (!res.ok || !out.success) throw new Error(out.error || 'The contact could not be saved.');
      cardState.data = { data: out.contact, canEdit: out.canEdit, canEditTemplate: out.canEditTemplate };
      // Keep the list (and any selection) in step with the saved details.
      const c = cardState.contact;
      c.guardianName = `${out.contact.base.firstName} ${out.contact.base.lastName}`.trim();
      c.phone = out.contact.base.phone;
      c.email = out.contact.base.email;
      if (state.selected.has(c.id)) state.selected.set(c.id, c);
      renderContacts();
      renderCard();
      setStatus('Saved', 'ok');
    } catch (err) {
      setStatus(err.message, 'error');
      btn.disabled = false;
      btn.textContent = 'Save';
    } finally {
      cardState.saving = false;
    }
  }

  function showTab(id) {
    cardState.tab = id;
    const box = $('mrCardBox');
    box.querySelectorAll('[data-tab]').forEach((t) => { const on = t.dataset.tab === id; t.classList.toggle('is-on', on); t.setAttribute('aria-selected', on); });
    box.querySelectorAll('[data-panel]').forEach((p) => p.classList.toggle('is-on', p.dataset.panel === id));
  }

  $('mrCard').addEventListener('click', (e) => {
    if (e.target === $('mrCard') || e.target.closest('[data-card-close]')) { closeContactCard(); return; }
    if (e.target.closest('[data-card-template]') && isDirty() && !confirm('Leave without saving the changes to this contact?')) { e.preventDefault(); return; }
    const tab = e.target.closest('[data-tab]');
    if (tab) { showTab(tab.dataset.tab); return; }
    if (e.target.closest('[data-card-save]')) saveContactCard();
  });
  // Save lights up as soon as anything changes.
  ['input', 'change'].forEach((type) => $('mrCard').addEventListener(type, () => {
    const btn = $('mrCardBox').querySelector('[data-card-save]');
    if (!btn || cardState.saving) return;
    btn.disabled = !isDirty();
    if (!btn.disabled) setStatus('');
  }));
  $('mrCard').addEventListener('keydown', (e) => {
    if (e.key === 'Enter' && e.target.matches('[data-card-form] input')) { e.preventDefault(); saveContactCard(); }
  });

  function updateRecipientCount() {
    const n = state.selected.size;
    $('mrRecipientCount').textContent = `${n} recipient${n === 1 ? '' : 's'} selected`;
    $('mrSendBtn').disabled = n === 0 || state.channels.size === 0;
    $('mrClearSelection').hidden = n === 0;
    updateChannelReachability();
    updateChannelsVisibility();
    updateSelectAllLabel(filteredContacts());
    updateDirectoryToggleCount();
  }

  // On mobile the contact list is collapsed behind a toggle — show how many
  // are selected right on the toggle so that's visible without opening it.
  function updateDirectoryToggleCount() {
    const badge = $('mrDirectoryToggleCount');
    const n = state.selected.size;
    badge.textContent = n > 0 ? `${n} selected` : '';
    badge.style.display = n > 0 ? 'inline-block' : 'none';
  }

  // "Select all" covers every contact matching the search and class filter,
  // not just the ones currently shown.
  function updateSelectAllLabel(filtered) {
    const allSelected = filtered.length > 0 && filtered.every((c) => state.selected.has(c.id));
    const button = $('mrSelectAll');
    button.hidden = filtered.length === 0;
    button.textContent = allSelected ? 'Deselect all' : `Select all ${filtered.length}`;
  }

  function populateClassFilter() {
    const classes = [...new Set(state.contacts.flatMap((c) => c.classNames || []))]
      .sort((a, b) => a.localeCompare(b, undefined, { numeric: true }));
    const select = $('mrClassFilter');
    select.innerHTML = '<option value="">All classes</option>' + classes.map((name) => `<option value="${escapeHtml(name)}">${escapeHtml(name)}</option>`).join('');
    $('mrFilterRow').hidden = classes.length < 2;
    // Opened from a class ("Message all parents"): start with that class's families selected.
    const wanted = new URLSearchParams(window.location.search).get('class');
    if (wanted && classes.includes(wanted) && !state.classPreset) {
      state.classPreset = true;
      select.value = wanted;
      state.contacts.filter((c) => (c.classNames || []).includes(wanted)).forEach((c) => state.selected.set(c.id, c));
      updateRecipientCount();
    }
  }

  // ---- Compose ----
  // The channel checkboxes only matter once there's a message and/or a
  // recipient to send it to — keep them out of the way until then.
  function updateChannelsVisibility() {
    const hasMessage = Boolean($('mrMessage').value.trim());
    const hasRecipients = state.selected.size > 0;
    $('mrChannels').classList.toggle('mr-visible', hasMessage || hasRecipients);
    $('mrSubject').classList.toggle('mr-visible', state.channels.has('email'));
    updateSmsCounter();
  }

  // Same segment maths as the server (utils/guardianMessaging countSmsSegments):
  // plain text fits 160 characters per message, 153 per part after that.
  function updateSmsCounter() {
    const counter = $('mrSmsCounter');
    const show = state.channels.has('sms');
    counter.classList.toggle('mr-visible', show);
    if (!show) return;
    const text = $('mrMessage').value.trim();
    const gsm = /^[\x00-\x7F]*$/.test(text);
    const single = gsm ? 160 : 70;
    const part = gsm ? 153 : 67;
    const parts = !text.length ? 0 : text.length <= single ? 1 : Math.ceil(text.length / part);
    counter.textContent = `${text.length} characters · ${parts} text message${parts === 1 ? '' : 's'} per recipient`;
  }

  // Only channels this org actually has switched on ever appear — SMS/
  // WhatsApp are hidden entirely (not just disabled) when the org has no
  // active provider for them. Email always shows (Managira sends it directly).
  function renderChannelCheckboxes() {
    const container = $('mrChannels');
    const available = Object.keys(CHANNEL_META).filter((c) => state.orgChannels[c]);

    if (!available.length) {
      container.innerHTML = '<div class="mr-channel-empty">No messaging channel is active for this school yet. Turn on SMS, WhatsApp, or Email in Settings.</div>';
      return;
    }

    container.innerHTML = available.map((channel) => {
      const meta = CHANNEL_META[channel];
      return `<label class="mr-channel-check" data-channel="${channel}">
        <input type="checkbox" value="${channel}">
        <span>${escapeHtml(meta.label)}</span>
        <span class="mr-channel-note" data-note-for="${channel}"></span>
      </label>`;
    }).join('');

    container.querySelectorAll('input[type="checkbox"]').forEach((checkbox) => {
      checkbox.addEventListener('change', () => {
        if (checkbox.checked) state.channels.add(checkbox.value);
        else state.channels.delete(checkbox.value);
        updateRecipientCount();
      });
    });

    updateChannelReachability();
  }

  // Beyond the org having a channel switched on, the currently selected
  // recipients also need the right contact info for it. Grey out channels
  // that can't reach anyone selected, and explain why.
  function updateChannelReachability() {
    const container = $('mrChannels');
    const contacts = Array.from(state.selected.values());
    let anyUsable = false;

    container.querySelectorAll('label.mr-channel-check').forEach((label) => {
      const channel = label.getAttribute('data-channel');
      const meta = CHANNEL_META[channel];
      const checkbox = label.querySelector('input[type="checkbox"]');
      const note = label.querySelector('.mr-channel-note');

      if (!contacts.length) {
        checkbox.disabled = false;
        label.classList.remove('mr-channel-disabled');
        note.textContent = '';
        anyUsable = true;
        return;
      }

      const reachable = contacts.filter((c) => c[meta.field]).length;
      if (reachable === 0) {
        checkbox.disabled = true;
        if (checkbox.checked) {
          checkbox.checked = false;
          state.channels.delete(channel);
        }
        label.classList.add('mr-channel-disabled');
        note.textContent = `(selected recipient${contacts.length === 1 ? ' has' : 's have'} ${meta.missing})`;
      } else {
        checkbox.disabled = false;
        label.classList.remove('mr-channel-disabled');
        note.textContent = reachable < contacts.length ? `(${reachable}/${contacts.length} reachable)` : '';
        anyUsable = true;
      }
    });

    const hint = $('mrChannelHint');
    if (contacts.length && Object.keys(CHANNEL_META).some((c) => state.orgChannels[c]) && !anyUsable) {
      hint.style.display = 'block';
      hint.textContent = 'None of the selected recipients have a phone number or email on file for any active channel — add contact info for them first.';
    } else {
      hint.style.display = 'none';
    }
  }

  function showStatus(message, ok) {
    const el = $('mrStatus');
    el.style.display = 'block';
    el.style.background = ok ? '#f0fdf4' : '#fef2f2';
    el.style.color = ok ? '#166534' : '#b91c1c';
    el.style.border = ok ? '1px solid #bbf7d0' : '1px solid #fecaca';
    el.textContent = message;
  }

  async function loadChannelStatus() {
    try {
      const res = await fetch('/account/messaging/status');
      const data = await res.json();
      if (data.success) {
        state.orgChannels = {
          sms: Boolean(data.sms?.ready),
          whatsapp: Boolean(data.whatsapp?.ready),
          email: Boolean(data.email?.ready),
        };
      }
    } catch (_) {
      // Leave orgChannels at its all-false default — renderChannelCheckboxes
      // will show the "no channel active" message rather than guess.
    }
    renderChannelCheckboxes();
    updateSetupBanner();
    updateHistoryFilterVisibility();
  }

  // Text/WhatsApp filter chips (and their compose checkboxes) only ever
  // appear once that channel is activated under Settings -> Integrations.
  function updateHistoryFilterVisibility() {
    $('mrFilterChipSms').style.display = state.orgChannels.sms ? '' : 'none';
    $('mrFilterChipWhatsapp').style.display = state.orgChannels.whatsapp ? '' : 'none';
    if ((historyState.filter === 'sms' && !state.orgChannels.sms) || (historyState.filter === 'whatsapp' && !state.orgChannels.whatsapp)) {
      setHistoryFilter('all');
    }
  }

  // Text and WhatsApp both depend on the school activating a provider —
  // Email always works. Point straight at Integrations.
  function updateSetupBanner() {
    const banner = $('mrSetupBanner');
    const textEl = $('mrSetupBannerText');
    const smsOn = state.orgChannels.sms;
    const waOn = state.orgChannels.whatsapp;
    if (smsOn && waOn) {
      banner.style.display = 'none';
      return;
    }
    banner.style.display = 'flex';
    if (!smsOn && !waOn) {
      textEl.textContent = "Text and WhatsApp aren't set up for this school yet — only Email can be used to reach guardians.";
    } else if (!smsOn) {
      textEl.textContent = "Text (SMS) isn't set up for this school yet — WhatsApp and Email are available.";
    } else {
      textEl.textContent = "WhatsApp isn't set up for this school yet — Text (SMS) and Email are available.";
    }
  }

  async function loadContacts() {
    try {
      const res = await fetch('/account/messaging/mailroomDirectory');
      const data = await res.json();
      if (!data.success) { $('mrContactList').innerHTML = '<div class="mr-empty">Failed to load contacts.</div>'; return; }
      state.contacts = data.contacts || [];
      populateClassFilter();
      renderContacts();
    } catch (_) {
      $('mrContactList').innerHTML = '<div class="mr-empty">Error loading contacts.</div>';
    }
  }

  // ---- History (paged, newest first) ----
  const READMORE_THRESHOLD = 140;
  const STATUS_BADGE_CLASS = { sent: 'mr-badge-sent', failed: 'mr-badge-failed', pending: 'mr-badge-pending' };
  const CHANNEL_LABEL = { sms: 'Text', whatsapp: 'WhatsApp', email: 'Email' };
  const historyState = { rows: [], filter: 'all', hasMore: false, pollTimer: null };

  function renderHistoryRow(row) {
    const contact = Array.isArray(row.recipient_emails) && row.recipient_emails.length ? row.recipient_emails[0] : '-';
    const metadata = row.metadata || {};
    const name = metadata.guardianName && metadata.guardianName !== 'Guardian' ? metadata.guardianName : '';
    const status = String(row.status || '').toLowerCase();
    const statusClass = STATUS_BADGE_CLASS[status] || 'mr-badge-failed';
    const messageText = metadata.message || '';
    const errorText = metadata.error || '';
    const isLong = messageText.length > READMORE_THRESHOLD;
    return `<div class="mr-message-card">
      <div class="mr-message-main">
        <span class="mr-badge mr-badge-channel">${escapeHtml(CHANNEL_LABEL[String(row.event_domain || '').toLowerCase()] || row.event_domain || '-')}</span>
        <span class="mr-message-recipient">${escapeHtml(name || contact)}</span>
        ${name ? `<span class="mr-message-contact">${escapeHtml(contact)}</span>` : ''}
        <span class="mr-badge ${statusClass}">${escapeHtml(row.status || '-')}</span>
        <span class="mr-message-actor">by ${escapeHtml(row.actor_name || '-')}</span>
        ${status === 'failed' ? `<button type="button" class="mr-resend-btn" data-action="resend" data-id="${row.id}">Resend</button>` : ''}
      </div>
      ${metadata.emailSubject ? `<div class="mr-message-subject">Subject: ${escapeHtml(metadata.emailSubject)}</div>` : ''}
      ${messageText ? `<div class="mr-message-text-wrap">
        <div class="mr-message-text">${escapeHtml(messageText)}</div>
        ${isLong ? `<span class="mr-readmore" data-action="toggle-message">Read more</span>` : ''}
      </div>` : ''}
      ${status === 'failed' && errorText ? `<div class="mr-message-error">${escapeHtml(errorText)}</div>` : ''}
      <span class="mr-message-when">${escapeHtml(fmtDate(row.updated_at || row.created_at))}</span>
    </div>`;
  }

  function renderHistory() {
    const wrap = $('mrHistoryRows');
    if (!historyState.rows.length) {
      wrap.innerHTML = `<div class="mr-empty">${historyState.filter === 'all' ? 'No messages sent yet.' : 'No messages on this channel yet.'}</div>`;
    } else {
      wrap.innerHTML = historyState.rows.map(renderHistoryRow).join('');
    }
    $('mrHistoryMore').hidden = !historyState.hasMore;
  }

  // reset = reload from the newest; otherwise append the next page.
  // Returns true if any loaded row is still pending.
  async function loadHistory({ reset = true } = {}) {
    const wrap = $('mrHistoryRows');
    if (reset && !wrap.querySelector('.mr-message-card')) {
      wrap.innerHTML = '<div class="mr-empty">Loading history...</div>';
    }
    const offset = reset ? 0 : historyState.rows.length;
    const limit = reset ? Math.max(HISTORY_PAGE, historyState.rows.length) : HISTORY_PAGE;
    const params = new URLSearchParams({ limit: String(Math.min(limit, 100)), offset: String(offset) });
    if (historyState.filter !== 'all') params.set('channel', historyState.filter);
    try {
      const res = await fetch(`/account/messaging/mailroomHistory?${params}`);
      const data = await res.json();
      if (!data.success || !Array.isArray(data.history)) {
        wrap.innerHTML = '<div class="mr-empty">Error loading history.</div>';
        return false;
      }
      historyState.rows = reset ? data.history : historyState.rows.concat(data.history);
      historyState.hasMore = Boolean(data.hasMore);
      renderHistory();
      return historyState.rows.some((row) => String(row.status || '').toLowerCase() === 'pending');
    } catch (_) {
      wrap.innerHTML = '<div class="mr-empty">Error loading history.</div>';
      return false;
    }
  }

  function setHistoryFilter(channel) {
    historyState.filter = channel;
    document.querySelectorAll('#mrHistoryFilters .mr-filter-chip').forEach((el) => {
      el.classList.toggle('mr-filter-active', el.dataset.channel === channel);
    });
    historyState.rows = [];
    loadHistory();
  }

  // Refreshes history every couple of seconds until nothing is pending (or
  // 3 minutes pass), so a send's pending -> sent/failed flip shows up
  // without reloading the page.
  function pollHistoryUntilSettled() {
    if (historyState.pollTimer) clearInterval(historyState.pollTimer);
    let attempts = 0;
    historyState.pollTimer = setInterval(async () => {
      attempts += 1;
      const stillPending = await loadHistory();
      if (!stillPending || attempts >= 90) {
        clearInterval(historyState.pollTimer);
        historyState.pollTimer = null;
      }
    }, 2000);
  }

  // Timers can be throttled in a background tab — catch up when it's back.
  document.addEventListener('visibilitychange', () => {
    if (document.visibilityState === 'visible' && historyState.pollTimer) loadHistory();
  });

  // ---- Confirm dialog (summary + password when needed) ----
  // The password is never stored in the browser. After a correct password
  // the server remembers it for a short while, so the field is only shown
  // when it's actually needed.
  const confirmDialog = { onConfirm: null };

  function openConfirm({ title, summary, preview, confirmLabel, onConfirm }) {
    $('mrConfirmTitle').textContent = title;
    $('mrConfirmSummary').textContent = summary;
    $('mrConfirmPreview').textContent = preview || '';
    $('mrConfirmPreview').style.display = preview ? 'block' : 'none';
    $('mrConfirmOk').textContent = confirmLabel;
    $('mrConfirmOk').disabled = false;
    $('mrConfirmError').textContent = '';
    $('mrConfirmPassword').value = '';
    $('mrConfirmPasswordWrap').style.display = Date.now() < state.verifiedUntil ? 'none' : 'block';
    confirmDialog.onConfirm = onConfirm;
    $('mrConfirmBackdrop').classList.add('mr-open');
    if ($('mrConfirmPasswordWrap').style.display !== 'none') $('mrConfirmPassword').focus();
    else $('mrConfirmOk').focus();
  }

  function closeConfirm() {
    $('mrConfirmBackdrop').classList.remove('mr-open');
    $('mrConfirmPassword').value = '';
    confirmDialog.onConfirm = null;
  }

  async function runConfirm() {
    if (!confirmDialog.onConfirm) return;
    const passwordShown = $('mrConfirmPasswordWrap').style.display !== 'none';
    const password = passwordShown ? $('mrConfirmPassword').value : '';
    if (passwordShown && !password) {
      $('mrConfirmError').textContent = 'Enter your password to confirm.';
      return;
    }
    $('mrConfirmOk').disabled = true;
    $('mrConfirmError').textContent = '';
    const outcome = await confirmDialog.onConfirm(password);
    if (outcome && outcome.needsPassword) {
      // The remembered confirmation expired or the password was wrong.
      state.verifiedUntil = 0;
      $('mrConfirmPasswordWrap').style.display = 'block';
      $('mrConfirmError').textContent = outcome.message || 'Enter your password to confirm.';
      $('mrConfirmPassword').value = '';
      $('mrConfirmPassword').focus();
      $('mrConfirmOk').disabled = false;
      return;
    }
    closeConfirm();
  }

  function rememberVerification(minutes) {
    // A minute shorter than the server's window, so the field reappears
    // before the server would ask for it.
    state.verifiedUntil = Date.now() + Math.max(0, (Number(minutes) || 15) - 1) * 60000;
  }

  $('mrConfirmOk').addEventListener('click', runConfirm);
  $('mrConfirmCancel').addEventListener('click', closeConfirm);
  $('mrConfirmBackdrop').addEventListener('click', (e) => { if (e.target === $('mrConfirmBackdrop')) closeConfirm(); });
  $('mrConfirmPassword').addEventListener('keydown', (e) => { if (e.key === 'Enter') runConfirm(); });

  // ---- Send / resend ----
  function sendMessage() {
    const message = $('mrMessage').value.trim();
    const channels = Array.from(state.channels);
    if (!message) { showStatus('Type a message first.', false); return; }
    if (!state.selected.size) { showStatus('Select at least one recipient.', false); return; }
    if (!channels.length) { showStatus('Choose at least one channel.', false); return; }

    const contacts = Array.from(state.selected.values());
    const perChannel = channels.map((channel) => {
      const field = channelField(channel);
      const recipients = contacts.filter((c) => c[field]).map((c) => ({
        keys: c.keys,
        guardianId: c.guardianId,
        source: c.source,
        guardianName: c.guardianName,
        studentName: (c.studentNames || [])[0] || '',
      }));
      return { channel, recipients };
    }).filter((entry) => entry.recipients.length);

    if (!perChannel.length) {
      showStatus('None of the selected recipients have the contact info the chosen channel(s) need.', false);
      return;
    }

    const emailSubject = $('mrSubject').value.trim();
    const summary = perChannel.map((entry) => `${CHANNEL_META[entry.channel].label}: ${entry.recipients.length}`).join(' · ');
    openConfirm({
      title: 'Send message',
      summary: `To ${contacts.length} contact${contacts.length === 1 ? '' : 's'} — ${summary}${emailSubject && state.channels.has('email') ? ` · Subject: ${emailSubject}` : ''}`,
      preview: message,
      confirmLabel: 'Send',
      onConfirm: (password) => submitSend({ perChannel, message, emailSubject, password }),
    });
  }

  async function submitSend({ perChannel, message, emailSubject, password }) {
    const sendBtn = $('mrSendBtn');
    sendBtn.disabled = true;
    const previousLabel = sendBtn.textContent;
    sendBtn.textContent = 'Sending...';
    try {
      // The server writes each recipient as "pending" and answers right away;
      // the provider round trips happen in the background. The password (if
      // any) is checked by the first request; the rest use the server's
      // remembered confirmation.
      const results = [];
      for (const [index, entry] of perChannel.entries()) {
        // eslint-disable-next-line no-await-in-loop
        const res = await fetch('/account/messaging/mailroomSend', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify({
            channel: entry.channel,
            message,
            emailSubject: entry.channel === 'email' ? emailSubject : '',
            recipients: entry.recipients,
            password: index === 0 ? password : '',
          }),
        });
        // eslint-disable-next-line no-await-in-loop
        const data = await res.json().catch(() => ({}));
        if (res.status === 401 && index === 0) return { needsPassword: true, message: data.message };
        results.push(data);
        if (data.success && data.verifiedForMinutes) rememberVerification(data.verifiedForMinutes);
      }

      const failure = results.find((r) => r.success === false);
      const total = results.reduce((sum, r) => sum + (Array.isArray(r.rows) ? r.rows.length : 0), 0);
      const skipped = results.reduce((sum, r) => sum + (Number(r.skippedOutOfScope) || 0), 0);
      if (failure && !total) {
        showStatus(failure.message || 'Unable to send.', false);
      } else {
        showStatus(`Sending to ${total} recipient${total === 1 ? '' : 's'}...${skipped ? ` ${skipped} outside your mailroom access were skipped.` : ''}${failure ? ` Some channels failed: ${failure.message}` : ''}`, !failure);
        $('mrMessage').value = '';
        $('mrSubject').value = '';
        updateChannelsVisibility();
        loadHistory();
        pollHistoryUntilSettled();
      }
      return null;
    } catch (_) {
      showStatus('Network error — nothing was confirmed as sent. Check History before trying again.', false);
      return null;
    } finally {
      sendBtn.textContent = previousLabel;
      sendBtn.disabled = state.selected.size === 0 || state.channels.size === 0;
    }
  }

  function resendMessage(id) {
    const row = historyState.rows.find((r) => String(r.id) === String(id));
    const contact = row && Array.isArray(row.recipient_emails) ? row.recipient_emails[0] : '';
    openConfirm({
      title: 'Resend message',
      summary: contact ? `Resend to ${contact}` : 'Resend this message',
      preview: row?.metadata?.message || '',
      confirmLabel: 'Resend',
      onConfirm: async (password) => {
        try {
          const res = await fetch('/account/messaging/mailroomResend', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
            body: JSON.stringify({ id, password }),
          });
          const data = await res.json().catch(() => ({}));
          if (res.status === 401) return { needsPassword: true, message: data.message };
          if (!data.success) { showStatus(data.message || 'Unable to resend.', false); return null; }
          if (password) rememberVerification(15);
          showStatus('Resending...', true);
          loadHistory();
          pollHistoryUntilSettled();
        } catch (_) {
          showStatus('Network error — resend failed.', false);
        }
        return null;
      },
    });
  }

  $('mrHistoryRows').addEventListener('click', (e) => {
    const btn = e.target.closest('[data-action]');
    if (!btn) return;
    if (btn.dataset.action === 'resend') {
      resendMessage(btn.dataset.id);
    } else if (btn.dataset.action === 'toggle-message') {
      const textEl = btn.closest('.mr-message-text-wrap').querySelector('.mr-message-text');
      const expanded = textEl.classList.toggle('mr-expanded');
      btn.textContent = expanded ? 'Show less' : 'Read more';
    }
  });
  $('mrHistoryMore').addEventListener('click', () => loadHistory({ reset: false }));
  $('mrHistoryFilters').addEventListener('click', (e) => {
    const chip = e.target.closest('.mr-filter-chip');
    if (chip) setHistoryFilter(chip.dataset.channel);
  });

  $('mrSearch').addEventListener('input', () => { state.contactLimit = CONTACT_PAGE; renderContacts(); });
  $('mrClassFilter').addEventListener('change', () => { state.contactLimit = CONTACT_PAGE; renderContacts(); });
  $('mrMessage').addEventListener('input', updateChannelsVisibility);
  $('mrSelectAll').addEventListener('click', () => {
    const filtered = filteredContacts();
    const allSelected = filtered.length > 0 && filtered.every((c) => state.selected.has(c.id));
    filtered.forEach((c) => {
      if (allSelected) state.selected.delete(c.id);
      else state.selected.set(c.id, c);
    });
    renderContacts();
    updateRecipientCount();
  });
  $('mrClearSelection').addEventListener('click', () => {
    state.selected.clear();
    renderContacts();
    updateRecipientCount();
  });
  $('mrSendBtn').addEventListener('click', sendMessage);

  // Mobile-only right-side drawer for the contact list.
  function openContactsDrawer() {
    $('mrDirectory').classList.add('mr-drawer-open');
    $('mrDrawerBackdrop').classList.add('mr-drawer-open');
    $('mrDirectoryToggle').setAttribute('aria-expanded', 'true');
    document.body.style.overflow = 'hidden';
  }
  function closeContactsDrawer() {
    $('mrDirectory').classList.remove('mr-drawer-open');
    $('mrDrawerBackdrop').classList.remove('mr-drawer-open');
    $('mrDirectoryToggle').setAttribute('aria-expanded', 'false');
    document.body.style.overflow = '';
  }
  $('mrDirectoryToggle').addEventListener('click', openContactsDrawer);
  $('mrDirectoryClose').addEventListener('click', closeContactsDrawer);
  $('mrDrawerBackdrop').addEventListener('click', closeContactsDrawer);
  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    if ($('mrCard').classList.contains('mr-open')) closeContactCard();
    else if ($('mrConfirmBackdrop').classList.contains('mr-open')) closeConfirm();
    else closeContactsDrawer();
  });

  // Passwords were kept in this tab by an earlier version; clear any left over.
  try { window.sessionStorage && sessionStorage.removeItem('mailroomVerifiedPassword'); } catch (_) {}

  loadChannelStatus();
  loadContacts();
  loadHistory();
})();
</script>
<script>
// Mailroom Inbox: the messages parents send (parent portal "Messages"), school-wide.
(function () {
  const root = document.getElementById('mailroomRoot');
  if (!root || root.__inbox) return;
  root.__inbox = true;
  const byId = (id) => document.getElementById(id);
  const esc = (v) => String(v == null ? '' : v).replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
  const STATUS = { open: 'Open', in_progress: 'In progress', resolved: 'Resolved' };
  const when = (v) => {
    const d = new Date(v);
    const today = new Date();
    return d.toDateString() === today.toDateString()
      ? d.toLocaleTimeString([], { hour: 'numeric', minute: '2-digit' })
      : d.toLocaleDateString([], { month: 'short', day: 'numeric' });
  };
  let threads = [];
  let filter = 'needs';
  let activeId = null;

  function setView(view) {
    const inbox = view === 'inbox';
    root.classList.toggle('is-inbox', inbox);
    byId('mrInbox').hidden = !inbox;
    root.querySelectorAll('[data-mr-view]').forEach((b) => {
      const on = b.dataset.mrView === view;
      b.classList.toggle('is-active', on);
      b.setAttribute('aria-selected', on ? 'true' : 'false');
    });
    const url = new URL(location.href);
    if (inbox) url.searchParams.set('view', 'inbox'); else { url.searchParams.delete('view'); url.searchParams.delete('thread'); }
    history.replaceState(history.state, '', url);
  }
  root.querySelectorAll('[data-mr-view]').forEach((b) => b.addEventListener('click', () => setView(b.dataset.mrView)));

  async function loadInbox() {
    try {
      const res = await fetch('/common/mailroom/inbox', { headers: { Accept: 'application/json' } });
      const data = await res.json();
      if (!data.success) throw new Error(data.error);
      threads = data.threads;
      const badge = byId('mrInboxBadge');
      badge.textContent = data.needsReply;
      badge.hidden = !data.needsReply;
      renderList();
    } catch (_) {
      byId('mrInboxRows').innerHTML = '<div class="mr-empty">Messages could not be loaded.</div>';
    }
  }

  function renderList() {
    const q = (byId('mrInboxSearch').value || '').trim().toLowerCase();
    const list = threads.filter((t) => {
      if (filter === 'needs' && !t.needs_reply) return false;
      if (filter === 'open' && t.status === 'resolved') return false;
      if (!q) return true;
      return `${t.guardian_name} ${t.student_name} ${t.class_name} ${t.subject}`.toLowerCase().includes(q);
    });
    byId('mrInboxRows').innerHTML = list.length ? list.map((t) => `
      <button type="button" class="mr-inbox-row${t.report_id === activeId ? ' is-active' : ''}" data-thread="${t.report_id}">
        <span class="mr-inbox-top">${t.needs_reply ? '<span class="mr-dot-new" title="Needs reply"></span>' : ''}<strong>${esc(t.guardian_name)}</strong><span class="mr-inbox-time">${esc(when(t.last_at))}</span></span>
        <span class="mr-inbox-subject">${esc(t.subject)}</span>
        <span class="mr-inbox-snippet">${t.last_sender_type === 'staff' ? 'You: ' : ''}${esc(t.last_message)}</span>
        <span class="mr-inbox-meta">${esc(t.student_name)}${t.class_name ? ' · ' + esc(t.class_name) : ''} <span class="mr-chip mr-chip--${t.needs_reply ? 'needs' : t.status}">${t.needs_reply ? 'Needs reply' : STATUS[t.status] || 'Open'}</span></span>
      </button>`).join('')
      : `<div class="mr-empty">${filter === 'needs' ? 'All caught up. No messages are waiting for a reply.' : 'No messages here.'}</div>`;
  }

  byId('mrInboxRows').addEventListener('click', (e) => {
    const row = e.target.closest('[data-thread]');
    if (row) openThread(Number(row.dataset.thread));
  });
  root.querySelectorAll('[data-inbox-filter]').forEach((b) => b.addEventListener('click', () => {
    filter = b.dataset.inboxFilter;
    root.querySelectorAll('[data-inbox-filter]').forEach((x) => x.classList.toggle('mr-filter-active', x === b));
    renderList();
  }));
  byId('mrInboxSearch').addEventListener('input', renderList);

  async function openThread(id) {
    activeId = id;
    renderList();
    const url = new URL(location.href);
    url.searchParams.set('view', 'inbox');
    url.searchParams.set('thread', id);
    history.replaceState(history.state, '', url);
    const pane = byId('mrThread');
    pane.innerHTML = '<div class="mr-empty mr-thread-empty">Loading conversation...</div>';
    try {
      const res = await fetch('/common/classReportDetail?reportId=' + id, { headers: { Accept: 'application/json' } });
      const d = await res.json();
      if (!d.success) throw new Error(d.error);
      const r = d.report;
      const t = threads.find((x) => x.report_id === id) || {};
      const opener = r.filed_by_name
        ? { staff: true, name: r.filed_by_name }
        : { staff: false, name: r.guardian_name };
      const msgs = [{ staff: opener.staff, name: opener.name, message: r.message, at: r.created_at }]
        .concat((d.replies || []).map((x) => ({ staff: x.sender_type !== 'guardian', name: x.sender_name, message: x.message, at: x.created_at })));
      pane.innerHTML = `
        <div class="mr-thread-head">
          <div>
            <h2>${esc(r.subject)}</h2>
            <p>${esc(r.student_name)}${t.class_name ? ' · ' + esc(t.class_name) : ''} · Parent: ${esc(r.guardian_name)} · <span class="mr-chip mr-chip--${esc(r.status)}">${STATUS[r.status] || 'Open'}</span></p>
          </div>
          <div class="mr-thread-actions">
            ${t.class_id ? `<a href="/common/classDashboard/${t.class_id}/reports?report=${id}" data-no-spa>Open in class</a>` : ''}
            <button type="button" data-status="${r.status === 'resolved' ? 'in_progress' : 'resolved'}">${r.status === 'resolved' ? 'Reopen' : 'Mark resolved'}</button>
          </div>
        </div>
        <div class="mr-thread-msgs" id="mrThreadMsgs">
          ${msgs.map((m) => `<div class="mr-msg${m.staff ? ' mr-msg--staff' : ''}"><div class="mr-msg-who"><strong>${esc(m.name || (m.staff ? 'Staff' : 'Parent'))}</strong><span>${m.staff ? 'Staff' : 'Parent'} · ${esc(new Date(m.at).toLocaleString([], { month: 'short', day: 'numeric', hour: 'numeric', minute: '2-digit' }))}</span></div><p>${esc(m.message)}</p></div>`).join('')}
        </div>
        <form class="mr-reply" id="mrReplyForm">
          <textarea id="mrReplyText" placeholder="Write a reply to ${esc(r.guardian_name)}..." aria-label="Reply" required></textarea>
          <button type="submit">Send reply</button>
        </form>`;
      const msgsEl = byId('mrThreadMsgs');
      msgsEl.scrollTop = msgsEl.scrollHeight;
      pane.querySelector('[data-status]').addEventListener('click', async (e) => {
        const status = e.currentTarget.dataset.status;
        const resp = await fetch('/common/parent-messages/' + id + '/status', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ status }) });
        if (resp.ok) { await loadInbox(); openThread(id); }
      });
      byId('mrReplyForm').addEventListener('submit', async (e) => {
        e.preventDefault();
        const text = byId('mrReplyText').value.trim();
        if (!text) return;
        const btn = e.currentTarget.querySelector('button');
        btn.disabled = true;
        btn.textContent = 'Sending...';
        const resp = await fetch('/common/staffReplyToReport', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ reportId: id, message: text }) });
        const out = await resp.json().catch(() => ({}));
        if (!resp.ok || out.success === false) {
          btn.disabled = false;
          btn.textContent = 'Send reply';
          alert((out && out.error) || 'Your reply could not be sent.');
          return;
        }
        await loadInbox();
        openThread(id);
      });
    } catch (_) {
      pane.innerHTML = '<div class="mr-empty mr-thread-empty">This conversation could not be loaded.</div>';
    }
  }

  const params = new URLSearchParams(location.search);
  const startThread = Number(params.get('thread'));
  if (params.get('view') === 'inbox' || startThread) setView('inbox');
  loadInbox().then(() => { if (startThread) openThread(startThread); });
})();
</script>
