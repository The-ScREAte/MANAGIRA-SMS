<link rel="stylesheet" href="/css/manage.css" />
<link rel="stylesheet" href="/css/peoplePanel.css" />
<script src="/js/manage.js" defer></script>
<%
  const _name = (g) => (typeof formatDisplayName === 'function' ? formatDisplayName(g) : [g.first_name, g.last_name].filter(Boolean).join(' ').trim());
  const _isoDay = (v) => (v ? new Date(v).toISOString().slice(0, 10) : '');
  const _fmtWhen = (v) => (v ? new Date(v).toLocaleString('en-US', { month: 'short', day: 'numeric', year: 'numeric', hour: 'numeric', minute: '2-digit' }) : 'Never');
  const _classes = Array.from(new Set(guardians.flatMap((g) => (g.children || []).map((c) => c.className)).filter(Boolean))).sort((a, b) => a.localeCompare(b, undefined, { numeric: true }));
  const _photo = (g) => (g.image_url && g.image_url !== 'profilePlaceholder.png' ? g.image_url : '');
  const _panelData = guardians.map((g) => ({
    key: g.source + ':' + g.guardian_id,
    id: g.guardian_id,
    source: g.source || 'legacy',
    name: _name(g),
    first: g.first_name || '',
    last: g.last_name || '',
    email: g.email || '',
    phone: g.phone || '',
    address: g.address || '',
    hometown: g.hometown || '',
    photo: _photo(g),
    status: g.portal_status,
    loginEmail: g.login_email || '',
    loginPhone: g.login_phone || '',
    lastLogin: _fmtWhen(g.last_login),
    children: g.children || [],
  }));
%>
<div class="student-management-system ws-root ws-guardians">
  <header class="ws-head">
    <div class="ws-head__text">
      <h1 class="ws-head__title">Parents &amp; guardians</h1>
      <p class="ws-head__sub"><%= guardians.length %> linked to students. Select someone to see their account.</p>
    </div>
    <% if (guardians.length) { %>
    <div class="ws-head__actions">
      <button type="button" class="ws-btn" id="uxFilterToggle" aria-expanded="true" aria-controls="uxFilters"><i class="fa-solid fa-filter" aria-hidden="true"></i> Filters <span class="ux-filter-count" id="uxFilterCount" hidden></span></button>
    </div>
    <% } %>
  </header>

  <% if (!guardians.length) { %>
    <div class="ws-card ws-empty"><strong>No parents or guardians yet</strong>They show here once they're added to a student.</div>
  <% } else { %>
  <div class="ux-layout">
    <aside class="ux-filters" id="uxFilters" aria-label="Filter parents and guardians">
      <div class="ux-filters__head">
        <strong>Filters</strong>
        <button type="button" class="ux-link" id="uxClear">Clear</button>
      </div>
      <label class="ux-field"><span>Name</span><input type="search" id="uxName" placeholder="Find by name" autocomplete="off" /></label>
      <label class="ux-field"><span>Email or phone</span><input type="search" id="uxContact" placeholder="Find by email or phone" autocomplete="off" /></label>
      <label class="ux-field"><span>Portal</span>
        <select id="uxStatus"><option value="">Any</option><option>Active</option><option>Setup pending</option><option>No login</option></select>
      </label>
      <label class="ux-field"><span>Child's class</span>
        <select id="uxClass"><option value="">Any class</option><% _classes.forEach((c) => { %><option><%= c %></option><% }) %></select>
      </label>
      <label class="ux-field"><span>Children</span>
        <select id="uxKids"><option value="">Any</option><option value="some">Has children linked</option><option value="none">No children linked</option></select>
      </label>
      <div class="ux-field"><span>Last sign-in</span>
        <label class="ux-sub">On or after <input type="date" id="uxAfter" /></label>
        <label class="ux-sub">On or before <input type="date" id="uxBefore" /></label>
        <label class="ux-check"><input type="checkbox" id="uxNever" /> Never signed in</label>
      </div>
      <p class="ux-shown" id="uxShown" aria-live="polite"></p>
    </aside>

    <div class="ws-table-wrap ws-cards-wrap">
      <table class="ws-table ws-cards">
        <thead>
          <tr>
            <th>Name</th>
            <th>Email</th>
            <th>Phone</th>
            <th>Children</th>
            <th>Portal</th>
            <th>Last sign-in</th>
          </tr>
        </thead>
        <tbody id="guardianTableBody">
          <% guardians.forEach((g) => { const name = _name(g); const kids = g.children || []; %>
            <tr class="ux-row" tabindex="0" data-key="<%= g.source + ':' + g.guardian_id %>"
                data-name="<%= name.toLowerCase() %>"
                data-contact="<%= [g.email, g.phone, g.login_email, g.login_phone].filter(Boolean).join(' ').toLowerCase() %>"
                data-status="<%= g.portal_status %>"
                data-classes="<%= kids.map((c) => c.className).join('|') %>"
                data-kids="<%= kids.length %>"
                data-last-login="<%= _isoDay(g.last_login) %>">
              <td class="ws-card-title">
                <span class="ws-person">
                  <img src="<%= _photo(g) || '/images/profilePlaceholder.png' %>" alt="" loading="lazy" />
                  <strong><%= name %></strong>
                </span>
              </td>
              <td class="ws-card-wide"><%= g.email || '—' %></td>
              <td><%= g.phone || '—' %></td>
              <td><span class="ws-pill"><%= kids.length || g.student_count || 0 %></span></td>
              <td>
                <% if (g.portal_status === 'Active') { %><span class="ws-pill ws-pill--green">Active</span>
                <% } else if (g.portal_status === 'Setup pending') { %><span class="ws-pill ws-pill--amber">Setup pending</span>
                <% } else { %><span class="ws-pill">No login</span><% } %>
              </td>
              <td class="ux-when"><%= _fmtWhen(g.last_login) %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
      <p class="ux-empty" id="uxEmpty" hidden>No one matches these filters.</p>
    </div>
  </div>
  <% } %>
</div>

<div class="ux-panel-backdrop" id="uxBackdrop" hidden></div>
<aside class="ux-panel" id="uxPanel" role="dialog" aria-modal="true" aria-labelledby="uxPanelTitle" aria-hidden="true">
  <div class="ux-panel__bar">
    <button type="button" class="ux-link ux-back" id="uxBack" hidden><i class="fa-solid fa-arrow-left" aria-hidden="true"></i> Back</button>
    <strong id="uxPanelTitle">Parent / guardian</strong>
    <button type="button" class="ux-close" id="uxClose" aria-label="Close"><svg width="18" height="18" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M15 5L5 15M5 5l10 10" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg></button>
  </div>
  <div class="ux-panel__body" id="uxPanelBody"></div>
  <div class="ux-panel__edit" id="uxPanelEdit" hidden>
    <div class="ux-panel__loading" id="uxEditLoading"><span class="emp-modal-spinner" aria-hidden="true"></span> Loading…</div>
    <iframe id="uxEditFrame" title="Parent details"></iframe>
  </div>
</aside>
<script type="application/json" id="uxPeople"><%- JSON.stringify(_panelData).replace(/</g, '\\u003c') %></script>

<style>
  .ws-guardians .ws-person img { width: 32px; height: 32px; border-radius: 50%; object-fit: cover; }
  .gx-kid { display: flex; justify-content: space-between; gap: 10px; padding: 7px 0; font-size: 13.5px; border-bottom: 1px solid color-mix(in srgb, currentColor 8%, transparent); }
  .gx-kid:last-child { border-bottom: 0; }
  .gx-kid span { color: var(--ws-muted, #64748b); font-size: 12.5px; text-align: right; }
  .gx-kid .gx-archived { color: #b45309; }
  .ux-actions { gap: 8px; flex-wrap: wrap; }
  .ux-note { margin: 10px 0 0; padding: 9px 11px; border-radius: 8px; font-size: 13px; background: color-mix(in srgb, #16a34a 12%, transparent); }
  .ux-note.is-error { background: color-mix(in srgb, #ef4444 12%, transparent); }
</style>
<script>
(function () {
  var get = function (id) { return document.getElementById(id); };
  var rows = Array.prototype.slice.call(document.querySelectorAll('tr.ux-row'));
  var people = [];
  try { people = JSON.parse(get('uxPeople').textContent) || []; } catch (e) { people = []; }
  var dirty = false;

  /* ---- Filters ---- */
  var fields = ['uxName', 'uxContact', 'uxStatus', 'uxClass', 'uxKids', 'uxAfter', 'uxBefore', 'uxNever'];
  function apply() {
    if (!get('uxName')) return;
    var name = get('uxName').value.trim().toLowerCase();
    var contact = get('uxContact').value.trim().toLowerCase().replace(/\s+/g, '');
    var status = get('uxStatus').value, cls = get('uxClass').value, kids = get('uxKids').value;
    var after = get('uxAfter').value, before = get('uxBefore').value, never = get('uxNever').checked;
    var shown = 0;
    rows.forEach(function (row) {
      var d = row.dataset, last = d.lastLogin || '';
      var ok = (!name || d.name.indexOf(name) !== -1)
        && (!contact || d.contact.replace(/\s+/g, '').indexOf(contact) !== -1)
        && (!status || d.status === status)
        && (!cls || ('|' + d.classes + '|').indexOf('|' + cls + '|') !== -1)
        && (!kids || (kids === 'none' ? d.kids === '0' : d.kids !== '0'))
        && (!never || !last)
        && (!after || (last && last >= after))
        && (!before || (last && last <= before));
      row.hidden = !ok;
      if (ok) shown += 1;
    });
    var active = fields.filter(function (id) { var el = get(id); return el.type === 'checkbox' ? el.checked : el.value; }).length;
    get('uxShown').textContent = 'Showing ' + shown + ' of ' + rows.length;
    get('uxEmpty').hidden = shown !== 0;
    get('uxFilterCount').hidden = !active;
    get('uxFilterCount').textContent = active;
  }
  if (get('uxName')) {
    fields.forEach(function (id) { var el = get(id); el.addEventListener(el.tagName === 'SELECT' || el.type === 'checkbox' || el.type === 'date' ? 'change' : 'input', apply); });
    get('uxClear').addEventListener('click', function () {
      fields.forEach(function (id) { var el = get(id); if (el.type === 'checkbox') el.checked = false; else el.value = ''; });
      apply();
    });
    var layout = document.querySelector('.ux-layout');
    if (window.matchMedia('(max-width: 900px)').matches) { layout.classList.add('ux-filters-off'); get('uxFilterToggle').setAttribute('aria-expanded', 'false'); }
    get('uxFilterToggle').addEventListener('click', function () {
      var off = layout.classList.toggle('ux-filters-off');
      get('uxFilterToggle').setAttribute('aria-expanded', String(!off));
    });
    apply();
  }

  /* ---- Side panel ---- */
  var current = null;
  function esc(v) { return String(v == null ? '' : v).replace(/[&<>"']/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]; }); }
  function kv(label, value) { return value ? '<div class="ux-kv"><span>' + label + '</span><strong>' + esc(value) + '</strong></div>' : ''; }
  function render(p) {
    var initials = ((p.first || '').charAt(0) + (p.last || '').charAt(0)).toUpperCase() || '?';
    var pill = p.status === 'Active' ? 'ws-pill--green' : p.status === 'Setup pending' ? 'ws-pill--amber' : '';
    var canInvite = p.source === 'profile' || p.loginEmail || p.email;
    var html = '<div class="ux-who">' +
      (p.photo ? '<img class="ux-avatar" src="' + esc(p.photo) + '" alt="" data-initials="' + esc(initials) + '" />' : '<span class="ux-avatar">' + esc(initials) + '</span>') +
      '<div><div class="ux-who__name">' + esc(p.name) + '</div><span class="ws-pill ' + pill + '">' + esc(p.status === 'Active' ? 'Portal active' : p.status) + '</span></div></div>' +
      '<section class="ux-sec"><h3>Contact</h3>' + kv('Email', p.email) + kv('Phone', p.phone) + kv('Address', p.address) + kv('Hometown', p.hometown) +
        (!p.email && !p.phone && !p.address ? '<p class="ux-muted">No contact details.</p>' : '') + '</section>' +
      '<section class="ux-sec"><h3>Children <span class="ux-count">' + p.children.length + '</span></h3>' +
        (p.children.length ? p.children.map(function (c) {
          return '<div class="gx-kid"><strong>' + esc(c.name) + '</strong><span>' + esc(c.className || 'No class') +
            (c.relationship ? ' · ' + esc(c.relationship) : '') + (c.archived ? ' · <b class="gx-archived">Graduated or left</b>' : '') + '</span></div>';
        }).join('') : '<p class="ux-muted">No children linked.</p>') + '</section>' +
      '<section class="ux-sec"><h3>Parent portal</h3>' + kv('Status', p.status) + kv('Sign-in email', p.loginEmail) + kv('Sign-in phone', p.loginPhone) + kv('Last sign-in', p.lastLogin) + '</section>' +
      '<div class="ux-actions">' +
        (canInvite ? '<button type="button" class="ws-btn" id="uxInvite"><i class="fa-solid fa-key" aria-hidden="true"></i> ' + (p.status === 'Active' ? 'Send password reset' : 'Send password setup') + '</button>' : '') +
        '<button type="button" class="ws-btn ws-btn--primary" id="uxEdit"><i class="fa-solid fa-pen" aria-hidden="true"></i> Edit details</button>' +
      '</div><div id="uxNotice"></div>';
    get('uxPanelBody').innerHTML = html;
    var photo = get('uxPanelBody').querySelector('img.ux-avatar');
    if (photo) photo.addEventListener('error', function () { var s = document.createElement('span'); s.className = 'ux-avatar'; s.textContent = photo.getAttribute('data-initials'); photo.replaceWith(s); });
    get('uxEdit').addEventListener('click', function () { showEdit(p); });
    var invite = get('uxInvite');
    if (invite) invite.addEventListener('click', function () { sendSetup(p, invite); });
  }
  function notice(text, isError) {
    get('uxNotice').innerHTML = '<p class="ux-note' + (isError ? ' is-error' : '') + '">' + esc(text) + '</p>';
  }
  function sendSetup(p, btn) {
    var to = p.loginEmail || p.email || 'this parent';
    if (!window.confirm('Send a password ' + (p.status === 'Active' ? 'reset' : 'setup') + ' email to ' + to + '?')) return;
    btn.disabled = true;
    fetch('/common/guardianRequestPasswordReset', {
      method: 'POST', credentials: 'same-origin',
      headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
      body: JSON.stringify({ guardianId: p.id, source: p.source })
    }).then(function (r) { return r.json(); }).then(function (data) {
      btn.disabled = false;
      if (data && data.success) notice(data.message || 'Email sent.');
      else notice((data && data.error) || 'Could not send the email.', true);
    }).catch(function () { btn.disabled = false; notice('Could not send the email.', true); });
  }
  function setMode(editing) {
    get('uxPanel').classList.toggle('is-editing', editing);
    get('uxPanelBody').hidden = editing;
    get('uxPanelEdit').hidden = !editing;
    get('uxBack').hidden = !editing;
    get('uxPanelTitle').textContent = editing ? 'Edit parent / guardian' : 'Parent / guardian';
  }
  function showEdit(p) {
    var frame = get('uxEditFrame'), loading = get('uxEditLoading');
    setMode(true);
    frame.style.visibility = 'hidden';
    loading.style.display = 'flex';
    frame.onload = function () {
      var path = null;
      try { path = frame.contentWindow.location.pathname; } catch (err) { /* ignore */ }
      if (path && path !== '/common/guardianDetails' && path !== 'blank') {
        frame.removeAttribute('src');
        setMode(false);
        notice('The parent details couldn\'t open. Please try again.', true);
        return;
      }
      loading.style.display = 'none';
      frame.style.visibility = 'visible';
    };
    frame.src = '/common/guardianDetails?guardianId=' + encodeURIComponent(p.id) + '&source=' + encodeURIComponent(p.source) + '&embed=workspace';
  }
  function open(key) {
    var p = people.find(function (x) { return x.key === key; });
    if (!p) return;
    current = p;
    render(p);
    setMode(false);
    get('uxBackdrop').hidden = false;
    get('uxPanel').classList.add('is-open');
    get('uxPanel').setAttribute('aria-hidden', 'false');
    rows.forEach(function (r) { r.classList.toggle('is-selected', r.dataset.key === key); });
    get('uxClose').focus();
  }
  function close() {
    get('uxPanel').classList.remove('is-open', 'is-editing');
    get('uxPanel').setAttribute('aria-hidden', 'true');
    get('uxBackdrop').hidden = true;
    get('uxEditFrame').removeAttribute('src');
    rows.forEach(function (r) { r.classList.remove('is-selected'); });
    // Changes saved in the details view show once the panel closes.
    if (dirty) { dirty = false; window.location.reload(); return; }
    var row = current && document.querySelector('tr.ux-row[data-key="' + current.key + '"]');
    if (row) row.focus();
  }
  get('uxClose').addEventListener('click', close);
  get('uxBackdrop').addEventListener('click', close);
  get('uxBack').addEventListener('click', function () { setMode(false); get('uxEditFrame').removeAttribute('src'); if (dirty) { dirty = false; window.location.reload(); } });
  document.addEventListener('keydown', function (e) { if (e.key === 'Escape' && get('uxPanel').classList.contains('is-open')) close(); });
  window.addEventListener('message', function (event) {
    if (event.origin === window.location.origin && event.data && event.data.managiraDrawerSaved) dirty = true;
  });
  var body = get('guardianTableBody');
  if (body) {
    body.addEventListener('click', function (e) {
      if (e.target.closest('button, a, input')) return;
      var row = e.target.closest('tr.ux-row');
      if (row) open(row.dataset.key);
    });
    body.addEventListener('keydown', function (e) {
      if ((e.key === 'Enter' || e.key === ' ') && e.target.matches('tr.ux-row')) { e.preventDefault(); open(e.target.dataset.key); }
    });
  }
})();
</script>
