<link rel="stylesheet" href="/css/workspace.css" />
<script src="/js/workspace.js" defer></script>
<div class="student-management-system ws-root ws-guardians">
  <header class="ws-head">
    <div class="ws-head__text">
      <h1 class="ws-head__title">Parents &amp; guardians</h1>
      <p class="ws-head__sub"><%= guardians.length %> guardian<%= guardians.length === 1 ? '' : 's' %> linked to students in this school.</p>
    </div>
    <% if (guardians.length) { %>
    <div class="ws-head__actions">
      <label class="ws-search"><i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i><input type="search" id="searchGuardian" placeholder="Search name, email or phone" aria-label="Search guardians" autocomplete="off"></label>
    </div>
    <% } %>
  </header>

  <% if (!guardians.length) { %>
    <div class="ws-card ws-empty"><strong>No guardians yet</strong>Guardians show here once they're added to a student.</div>
  <% } else { %>
    <div class="ws-table-wrap ws-cards-wrap">
      <table class="ws-table ws-cards">
        <thead>
          <tr>
            <th>Name <button type="button" class="guardian-sort-btn" id="guardianNameSortToggle" data-sort-direction="asc" aria-label="Sort guardians Z to A"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 12 12" aria-hidden="true" focusable="false"><path fill="currentColor" d="M10 5H2a.5.5 0 0 1-.46-.31.47.47 0 0 1 .11-.54L5.29.5A1 1 0 0 1 6.7.5l3.65 3.65a.49.49 0 0 1 .11.54A.51.51 0 0 1 10 5z"></path><path fill="currentColor" d="M2 7a.5.5 0 0 0-.46.31.47.47 0 0 0 .11.54L5.3 11.5a1 1 0 0 0 1.41 0l3.65-3.65a.49.49 0 0 0 .11-.54A.53.53 0 0 0 10 7z"></path></svg></button></th>
            <th>Email</th>
            <th>Phone</th>
            <th>Students</th>
            <th>Portal</th>
            <th class="ws-actions"><span class="ws-sr">Actions</span></th>
          </tr>
        </thead>
        <tbody id="guardianTableBody">
          <% guardians.forEach((guardian) => { %>
            <% const guardianDisplayName = (typeof formatDisplayName === 'function' ? formatDisplayName(guardian) : [guardian.first_name, guardian.last_name].filter(Boolean).join(' ').trim()); %>
            <tr class="guardian-row" data-name="<%= guardianDisplayName %>" data-email="<%= guardian.email || '' %>" data-phone="<%= guardian.phone || '' %>">
              <td class="ws-card-title">
                <span class="ws-person">
                  <img src="<%= guardian.image_url && guardian.image_url !== 'profilePlaceholder.png' ? guardian.image_url : '/images/profilePlaceholder.png' %>" alt="" loading="lazy" />
                  <strong><%= guardianDisplayName %></strong>
                </span>
              </td>
              <td class="ws-card-wide"><%= guardian.email || '—' %></td>
              <td><%= guardian.phone || '—' %></td>
              <td><span class="ws-pill"><%= guardian.student_count %></span></td>
              <td><% if (guardian.has_portal_access) { %><span class="ws-pill ws-pill--green">Active</span><% } else { %><span class="ws-pill">No access</span><% } %></td>
              <td class="ws-actions ws-card-actions">
                <button type="button" class="ws-btn ws-btn--sm" onclick="openGuardianDetailsModal('<%= guardian.guardian_id %>', '<%= guardian.source || 'legacy' %>')">View</button>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  <% } %>
</div>

<div class="gdm-modal-overlay" id="gdmModalOverlay" aria-hidden="true">
  <div class="gdm-modal">
    <div class="gdm-modal-header">
      <div class="gdm-modal-header-left">
        <div class="gdm-modal-header-icon">👪</div>
        <div>
          <h2 id="gdmModalTitle">Guardian Details</h2>
          <p>View and manage this guardian's information</p>
        </div>
      </div>
      <button type="button" class="gdm-modal-close" id="gdmModalClose" title="Close">
        <svg width="18" height="18" viewBox="0 0 20 20" fill="none">
          <path d="M15 5L5 15M5 5l10 10" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
        </svg>
      </button>
    </div>
    <div class="gdm-modal-body">
      <div class="gdm-modal-loading" id="gdmModalLoading">
        <span class="gdm-modal-spinner" aria-hidden="true"></span>
        Loading…
      </div>
      <iframe class="gdm-modal-iframe" id="gdmModalIframe" title="Guardian Details" style="display:none;"></iframe>
    </div>
  </div>
</div>

<style>
  .guardian-sort-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 16px;
    height: 16px;
    margin-left: 6px;
    padding: 0;
    border: none;
    background: transparent;
    color: #ffffff;
    cursor: pointer;
    opacity: 0.82;
  }
  .guardian-sort-btn:hover,
  .guardian-sort-btn:focus,
  .guardian-sort-btn:active,
  .guardian-sort-btn:focus-visible {
    background: transparent !important;
    box-shadow: none !important;
    outline: none;
    color: #ffffff;
  }
  .guardian-sort-btn svg { width: 10px; height: 10px; }
  /* Prevent global table styles (e.g., studentDetails.css) from washing out headers */
  .data-table thead th {
    background: var(--org-primary-color, #0f5a66);
    color: #ffffff;
  }

  .guardian-row:hover {
    background: #e0f7f4 !important;
    cursor: pointer;
  }

  /* ---- Guardian Details drawer (AJAX, same slide-in-from-right pattern
     used by the Assessment Question Sets "Set Questions" panel) ---- */
  .gdm-modal-overlay {
    position: fixed;
    inset: 0;
    background: rgba(10, 20, 30, 0.55);
    backdrop-filter: blur(3px);
    display: none;
    z-index: 10000;
    animation: gdmFadeIn 0.2s ease;
  }
  .gdm-modal-overlay.is-open {
    display: flex;
    align-items: stretch;
    justify-content: flex-end;
  }
  .gdm-modal {
    position: relative;
    width: 100%;
    max-width: 1140px;
    height: 100%;
    min-height: 100%;
    max-height: 100%;
    background: linear-gradient(180deg, #f8fbff 0%, #eef4fa 100%);
    display: flex;
    flex-direction: column;
    box-shadow: -8px 0 40px rgba(0, 0, 0, 0.18);
    animation: gdmSlideInRight 0.28s cubic-bezier(0.22, 1, 0.36, 1);
    overflow: hidden;
  }
  @keyframes gdmSlideInRight {
    from { transform: translateX(100%); opacity: 0; }
    to   { transform: translateX(0);    opacity: 1; }
  }
  @keyframes gdmFadeIn {
    from { opacity: 0; }
    to   { opacity: 1; }
  }
  .gdm-modal-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: calc(13px + env(safe-area-inset-top, 0px)) 18px 12px;
    background: #fff;
    border-bottom: 1px solid #e2e8f0;
    flex-shrink: 0;
    gap: 12px;
  }
  .gdm-modal-header-left { display: flex; align-items: center; gap: 10px; }
  .gdm-modal-header-icon {
    width: 34px;
    height: 34px;
    background: linear-gradient(135deg, var(--org-primary-color, #0f5a66) 0%, #1a8fa0 100%);
    border-radius: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 15px;
    flex-shrink: 0;
  }
  .gdm-modal-header h2 { margin: 0; font-size: 0.95rem; font-weight: 700; color: #0f2d32; }
  .gdm-modal-header p { margin: 0; font-size: 0.72rem; color: #64748b; }
  .gdm-modal-close {
    width: 32px;
    height: 32px;
    border-radius: 8px;
    border: 1px solid #e2e8f0;
    background: #fff;
    color: #64748b;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.15s;
    flex-shrink: 0;
  }
  .gdm-modal-close:hover { background: #fef2f2; border-color: #fca5a5; color: #dc2626; }
  .gdm-modal-body { flex: 1; position: relative; overflow: hidden; }
  .gdm-modal-iframe { width: 100%; height: 100%; border: none; display: block; }
  .gdm-modal-loading {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    color: #475569;
    font-size: 0.85rem;
  }
  .gdm-modal-spinner {
    width: 16px;
    height: 16px;
    border: 2px solid rgba(15, 90, 102, 0.25);
    border-top-color: #0f5a66;
    border-radius: 50%;
    animation: gdmSpin 0.7s linear infinite;
    flex-shrink: 0;
  }
  @keyframes gdmSpin { to { transform: rotate(360deg); } }
  @media (max-width: 500px) {
    .gdm-modal-overlay { padding: 0; }
    .gdm-modal { border-radius: 0; }
  }

  @media (max-width: 768px) {
    .student-management-system {
      padding: 16px !important;
    }

    .data-table th,
    .data-table td {
      padding: 12px 10px !important;
      font-size: 13px;
      vertical-align: middle;
    }

    /* Keep the table usable on mobile via horizontal scroll */
    .table-responsive {
      -webkit-overflow-scrolling: touch;
    }
  }
</style>

<script>
  (function() {
    const toggle = document.getElementById('guardianNameSortToggle');
    const body = document.getElementById('guardianTableBody');
    if (!toggle || !body) return;
    function sync() {
      const direction = toggle.getAttribute('data-sort-direction') === 'desc' ? 'desc' : 'asc';
      toggle.setAttribute('aria-label', direction === 'asc' ? 'Sort guardians Z to A' : 'Sort guardians A to Z');
    }
    function sortRows() {
      const direction = toggle.getAttribute('data-sort-direction') === 'desc' ? 'desc' : 'asc';
      Array.from(body.querySelectorAll('.guardian-row'))
        .sort((a, b) => direction === 'desc'
          ? String(b.dataset.name || '').localeCompare(String(a.dataset.name || ''), undefined, { sensitivity: 'base' })
          : String(a.dataset.name || '').localeCompare(String(b.dataset.name || ''), undefined, { sensitivity: 'base' }))
        .forEach(row => body.appendChild(row));
    }
    sync();
    sortRows();
    toggle.addEventListener('click', function() {
      toggle.setAttribute('data-sort-direction', toggle.getAttribute('data-sort-direction') === 'asc' ? 'desc' : 'asc');
      sync();
      sortRows();
    });
  })();

  // Search functionality
  document.getElementById('searchGuardian') && document.getElementById('searchGuardian').addEventListener('input', function(e) {
    const searchTerm = e.target.value.toLowerCase();
    const rows = document.querySelectorAll('.guardian-row');
    
    rows.forEach(row => {
      const name = row.dataset.name.toLowerCase();
      const email = row.dataset.email.toLowerCase();
      const phone = row.dataset.phone.toLowerCase();
      
      if (name.includes(searchTerm) || email.includes(searchTerm) || phone.includes(searchTerm)) {
        row.style.display = '';
      } else {
        row.style.display = 'none';
      }
    });
  });

  /* ---- Guardian Details drawer (AJAX, no page navigation) ---- */
  let gdmModalDirty = false;

  function openGuardianDetailsModal(guardianId, source) {
    const overlay = document.getElementById('gdmModalOverlay');
    const iframe = document.getElementById('gdmModalIframe');
    const loading = document.getElementById('gdmModalLoading');
    if (!overlay || !iframe) return;

    // Each row is a different guardian, so reload the iframe fresh on
    // every open instead of caching a single load.
    iframe.style.display = 'none';
    if (loading) loading.style.display = 'flex';

    iframe.onload = function onLoad() {
      if (loading) loading.style.display = 'none';
      iframe.style.display = 'block';
    };
    iframe.src = '/common/guardianDetails?guardianId=' + encodeURIComponent(guardianId)
      + '&source=' + encodeURIComponent(source || 'legacy') + '&embed=workspace';

    overlay.classList.add('is-open');
    overlay.setAttribute('aria-hidden', 'false');
    document.body.style.overflow = 'hidden';
  }

  function closeGuardianDetailsModal() {
    const overlay = document.getElementById('gdmModalOverlay');
    if (!overlay) return;
    overlay.classList.remove('is-open');
    overlay.setAttribute('aria-hidden', 'true');
    document.body.style.overflow = '';

    // guardianDetails.ejs stays on itself (reloading in place) after edits
    // instead of redirecting back here, so there's no navigation signal to
    // detect completion — it posts a message to us instead. Only refresh
    // the list if that actually happened; a plain cancel/close shouldn't
    // reload anything.
    if (gdmModalDirty) {
      gdmModalDirty = false;
      window.location.reload();
    }
  }

  window.addEventListener('message', function (event) {
    if (event.origin !== window.location.origin) return;
    if (event.data && event.data.managiraDrawerSaved) {
      gdmModalDirty = true;
    }
  });

  document.getElementById('gdmModalClose').addEventListener('click', closeGuardianDetailsModal);
  document.getElementById('gdmModalOverlay').addEventListener('click', function (event) {
    if (event.target === this) closeGuardianDetailsModal();
  });
  document.addEventListener('keydown', function (event) {
    if (event.key !== 'Escape') return;
    const overlay = document.getElementById('gdmModalOverlay');
    if (overlay && overlay.classList.contains('is-open')) closeGuardianDetailsModal();
  });
</script>
