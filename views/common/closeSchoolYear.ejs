<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
        <style>
            :root {
                --font-family: "<%= (session && session.fontStyle ? String(session.fontStyle).trim() : 'Inter') %>", sans-serif;
            }

            body {
                font-family: var(--font-family);
                background: #f4f7fb;
                margin: 0;
                color: #0f2d32;
            }

            .page-shell {
                max-width: 1100px;
                margin: 28px auto 48px;
                padding: 0 18px;
            }

            .hero {
                background: linear-gradient(135deg, var(--org-primary-color, #0f5a66), #0b4c56);
                color: #fff;
                border-radius: 16px;
                padding: 22px 24px;
                box-shadow: 0 18px 36px rgba(0,0,0,0.14);
                margin-bottom: 18px;
            }

            .hero h1 {
                margin: 0 0 6px;
                font-size: 1.6rem;
                letter-spacing: 0.2px;
            }

            .hero p {
                margin: 0;
                opacity: 0.9;
            }

            .card {
                background: #fff;
                border: 1px solid #e5e7eb;
                border-radius: 14px;
                box-shadow: 0 10px 28px rgba(15,45,50,0.12);
                padding: 18px 20px;
                margin-bottom: 16px;
            }

            .section-title {
                display: flex;
                align-items: center;
                gap: 10px;
                font-size: 1.05rem;
                font-weight: 700;
                margin: 0 0 12px;
                color: #0f2d32;
            }

            .pill {
                display: inline-flex;
                align-items: center;
                gap: 6px;
                padding: 6px 12px;
                border-radius: 999px;
                background: rgba(15,90,102,0.08);
                color: #0f2d32;
                font-weight: 600;
                font-size: 0.92rem;
            }

            .term-list {
                display: flex;
                flex-wrap: wrap;
                gap: 10px;
                list-style: none;
                padding: 0;
                margin: 10px 0 0;
            }

            .btn {
                display: inline-flex;
                align-items: center;
                justify-content: center;
                padding: 10px 18px;
                font-size: 0.95rem;
                color: #fff;
                background-color: var(--org-primary-color, #0f5a66);
                text-decoration: none;
                border-radius: 10px;
                border: 1px solid transparent;
                font-weight: 600;
                transition: all 0.2s ease;
                box-shadow: 0 6px 16px rgba(15,90,102,0.18);
            }

            .btn:hover {
                background-color: var(--org-primary-hover-fill, var(--org-primary-hover, #0d4f59));
                transform: translateY(-1px);
            }

            .accordion {
                margin-top: 6px;
            }

            .accordion-toggle {
                width: 100%;
                display: flex;
                align-items: center;
                justify-content: space-between;
                padding: 12px 14px;
                background: #f7f9fb;
                border: 1px solid #e5e7eb;
                border-radius: 12px;
                cursor: pointer;
                font-weight: 700;
                color: #0f2d32;
                transition: all 0.2s ease;
            }

            .accordion-toggle:hover {
                background: #eef3f7;
            }

            .accordion-icon {
                font-size: 1.1rem;
                transition: transform 0.2s ease;
            }

            .accordion-icon.open {
                transform: rotate(45deg);
            }

            .accordion-panel {
                display: none;
                padding: 10px 4px 4px;
            }

            .empty-state {
                margin: 12px 0 0;
                padding: 12px 14px;
                border: 1px dashed #cbd5e1;
                border-radius: 10px;
                background: #f8fafc;
                color: #475569;
            }

            @media (max-width: 768px) {
                .page-shell {
                    padding: 0 12px;
                    margin-top: 18px;
                }

                .hero {
                    padding: 18px 16px;
                    margin-bottom: 14px;
                }

                .btn {
                    width: 100%;
                }

                .accordion-toggle {
                    padding: 12px;
                }
            }

            @media (max-width: 480px) {
                .hero h1 {
                    font-size: 1.25rem;
                }

                .btn {
                    padding: 8px 14px;
                    font-size: 0.875rem;
                }

                .accordion-toggle {
                    font-size: 0.9rem;
                    padding: 10px;
                }

                .card {
                    padding: 14px 14px;
                }
            }
        </style>
</head>
<body>
        <div class="page-shell">
            <div class="hero">
                <h1><%= title %></h1>
                <p>Review terms, close school years, and jump into term details in one place.</p>
            </div>

            <% if (currentSchoolYear) { %>
            <div class="card">
                <div class="section-title">Current School Year</div>
                <div class="pill"><span>📅</span> <%= currentSchoolYear.year_label %></div>
                <ul class="term-list">
                    <% currentSchoolYear.terms.forEach(term => { %>
                        <li>
                            <a href="/common/termDetails/<%= term.term_id %>" class="btn" data-no-spa>View <%= term.term_name %></a>
                        </li>
                    <% }) %>
                </ul>
            </div>
            <% } %>

            <% if (otherSchoolYears && otherSchoolYears.length > 0) { %>
            <div class="card">
                <div class="section-title">Past & Upcoming School Years</div>
                <div class="accordion">
                    <% otherSchoolYears.forEach(schoolYear => { %>
                    <div class="accordion-item">
                        <button class="accordion-toggle" onclick="toggleCollapsible('<%= schoolYear.year_label %>')">
                            <span>📘 <%= schoolYear.year_label %></span>
                            <span id="<%= schoolYear.year_label %>-icon" class="accordion-icon">+</span>
                        </button>
                        <div id="<%= schoolYear.year_label %>" class="accordion-panel">
                            <ul class="term-list">
                                <% schoolYear.terms.forEach(term => { %>
                                    <li><a href="/common/termDetails/<%= term.term_id %>" class="btn" data-no-spa>View <%= term.term_name %></a></li>
                                <% }) %>
                            </ul>
                        </div>
                    </div>
                    <% }) %>
                </div>
            </div>
            <% } else { %>
            <div class="card empty-state">No other school years available.</div>
            <% } %>
        </div>

    <script>
                function toggleCollapsible(id) {
                    const panel = document.getElementById(id);
                    const icon = document.getElementById(`${id}-icon`);
                    const isOpen = panel && panel.style.display === "block";

                    // Close all panels
                    document.querySelectorAll('.accordion-panel').forEach(p => p.style.display = 'none');
                    document.querySelectorAll('.accordion-icon').forEach(i => i.classList.remove('open')); 
                    document.querySelectorAll('.accordion-icon').forEach(i => i.textContent = '+');

                    // Toggle requested panel
                    if (panel) {
                        panel.style.display = isOpen ? 'none' : 'block';
                    }
                    if (icon) {
                        icon.textContent = isOpen ? '+' : '−';
                        icon.classList.toggle('open', !isOpen);
                    }
                }
    </script>
</body>
</html>
