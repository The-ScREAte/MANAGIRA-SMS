<%
  const _embedQs = (typeof isEmbedded !== 'undefined' && isEmbedded) ? '?embed=workspace' : '';
  const _current = typeof currentSchoolYear !== 'undefined' ? currentSchoolYear : null;
  const _others = Array.isArray(typeof otherSchoolYears !== 'undefined' ? otherSchoolYears : null) ? otherSchoolYears : [];
%>
<link rel="stylesheet" href="<%= assetUrl('/css/reportPages.css') %>" />

<div class="gp-page">
  <header class="gp-head">
    <div>
      <h1 class="gp-title">Terminal Report</h1>
      <p class="gp-sub">Open a term to view, print and share its terminal reports.</p>
    </div>
  </header>

  <% if (_current) { %>
    <section class="gp-card">
      <div class="gp-card__head">
        <h2 class="gp-card__title">Current school year</h2>
        <span class="gp-pill"><%= _current.year_label %></span>
      </div>
      <% if (_current.terms && _current.terms.length) { %>
        <div class="gp-terms">
          <% _current.terms.forEach((term) => { %>
            <a class="gp-term" href="/common/termDetails/<%= term.term_id %><%= _embedQs %>" data-no-spa>
              <span><%= term.term_name %><small><%= _current.year_label %></small></span>
              <i class="fa-solid fa-arrow-right" aria-hidden="true"></i>
            </a>
          <% }) %>
        </div>
      <% } else { %>
        <p class="gp-card__note">No terms set up for this school year yet.</p>
      <% } %>
    </section>
  <% } %>

  <section class="gp-card">
    <div class="gp-card__head">
      <h2 class="gp-card__title">Past &amp; upcoming school years</h2>
      <% if (_others.length) { %><span class="gp-card__note"><%= _others.length %> school year<%= _others.length === 1 ? '' : 's' %></span><% } %>
    </div>
    <% if (!_others.length) { %>
      <p class="gp-card__note">No other school years yet.</p>
    <% } else { %>
      <div class="gp-groups">
        <% _others.forEach((year) => { %>
          <details class="gp-group">
            <summary>
              <i class="fa-solid fa-chevron-right gp-group__chev" aria-hidden="true"></i>
              <span class="gp-group__name"><%= year.year_label %></span>
              <span class="gp-group__meta"><span class="gp-tag"><%= (year.terms || []).length %> term<%= (year.terms || []).length === 1 ? '' : 's' %></span></span>
            </summary>
            <div class="gp-group__body">
              <% if (year.terms && year.terms.length) { %>
                <div class="gp-terms">
                  <% year.terms.forEach((term) => { %>
                    <a class="gp-term" href="/common/termDetails/<%= term.term_id %><%= _embedQs %>" data-no-spa>
                      <span><%= term.term_name %><small><%= year.year_label %></small></span>
                      <i class="fa-solid fa-arrow-right" aria-hidden="true"></i>
                    </a>
                  <% }) %>
                </div>
              <% } else { %>
                <p class="gp-card__note">No terms in this school year.</p>
              <% } %>
            </div>
          </details>
        <% }) %>
      </div>
    <% } %>
  </section>
</div>
