<%
  const _groups = Array.isArray(typeof archivedGroups !== 'undefined' ? archivedGroups : null) ? archivedGroups : [];
  const _embedded = typeof isEmbedded !== 'undefined' && isEmbedded;
  const _embedQs = _embedded ? '?embed=workspace' : '';
  const _total = typeof totalArchived !== 'undefined' ? totalArchived : _groups.reduce((sum, g) => sum + g.students.length, 0);
  const _initials = (s) => ((s.first_name || '').charAt(0) + (s.last_name || '').charAt(0)).toUpperCase() || '?';
  const _date = (d) => d ? new Date(d).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) : '—';
%>
<link rel="stylesheet" href="<%= assetUrl('/css/reportPages.css') %>" />

<div class="gp-page">
  <header class="gp-head">
    <div>
      <h1 class="gp-title">Archived Students</h1>
      <p class="gp-sub">Graduated and inactive students. Their records are preserved, and they are not counted as active students or billed.</p>
    </div>
    <a class="gp-btn gp-btn--ghost" href="/common/closeGraduationYearGroup<%= _embedQs %>">
      <i class="fa-solid fa-arrow-left" aria-hidden="true"></i> Graduate / Archive
    </a>
  </header>

  <%- include('../partials/flash') %>

  <div class="gp-stats">
    <div class="gp-stat"><span class="gp-stat__value"><%= _total %></span><span class="gp-stat__label">Archived students</span></div>
    <div class="gp-stat"><span class="gp-stat__value"><%= _groups.length %></span><span class="gp-stat__label">Graduation groups</span></div>
  </div>

  <% if (!_groups.length) { %>
    <div class="gp-empty">
      <i class="fa-solid fa-box-archive" aria-hidden="true"></i>
      <h2>No archived students</h2>
      <p>When you graduate a class from Graduate / Archive, the students appear here.</p>
      <a class="gp-btn gp-btn--primary" href="/common/closeGraduationYearGroup<%= _embedQs %>">Go to Graduate / Archive</a>
    </div>
  <% } else { %>
    <form action="/common/unarchiveStudents" method="POST" data-gp-form data-gp-noun="student">
      <input type="hidden" name="embed" value="<%= _embedded ? 'workspace' : '' %>" />

      <div class="gp-toolbar">
        <label class="gp-search">
          <i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i>
          <input type="search" placeholder="Search archived students by name or ID" data-gp-search aria-label="Search archived students" />
        </label>
        <span class="gp-toolbar__hint">Tick students to restore them to your active students.</span>
      </div>

      <div class="gp-groups">
        <% _groups.forEach((group, gi) => { %>
          <details class="gp-group"<%= gi === 0 ? ' open' : '' %>>
            <summary>
              <i class="fa-solid fa-chevron-right gp-group__chev" aria-hidden="true"></i>
              <span class="gp-group__name"><%= group.name %></span>
              <span class="gp-group__meta"><span class="gp-tag gp-tag--archived"><%= group.students.length %> archived</span></span>
            </summary>
            <table class="gp-table">
              <thead>
                <tr>
                  <th class="gp-col-check"><input type="checkbox" class="gp-pick-all" aria-label="Select all in <%= group.name %>" /></th>
                  <th>Student</th>
                  <th class="gp-col-class">Last class</th>
                  <th class="gp-col-date">Archived on</th>
                </tr>
              </thead>
              <tbody>
                <% group.students.forEach((s) => { const name = [s.first_name, s.last_name].filter(Boolean).join(' '); %>
                  <tr data-search="<%= (name + ' ' + (s.custom_student_id || '')).toLowerCase() %>">
                    <td class="gp-col-check"><input type="checkbox" class="gp-pick" name="students" value="<%= s.student_id %>" aria-label="Select <%= name %>" /></td>
                    <td>
                      <span class="gp-person">
                        <span class="gp-avatar" data-initials="<%= _initials(s) %>"><% if (s.image_url) { %><img src="<%= s.image_url %>" alt="" loading="lazy" /><% } else { %><%= _initials(s) %><% } %></span>
                        <span><span class="gp-person__name"><%= name %></span><% if (s.custom_student_id) { %><span class="gp-person__id"><%= s.custom_student_id %></span><% } %></span>
                      </span>
                    </td>
                    <td class="gp-col-class"><%= s.class_name || '—' %></td>
                    <td class="gp-col-date"><%= _date(s.archived_at) %></td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </details>
        <% }) %>
      </div>
      <div class="gp-no-results" data-gp-no-results>No archived students match your search.</div>

      <div class="gp-actionbar" data-gp-actionbar aria-live="polite">
        <strong data-gp-count>0 students selected</strong>
        <button type="button" class="gp-btn gp-btn--link" data-gp-clear>Clear</button>
        <button type="button" class="gp-btn gp-btn--primary" data-gp-open><i class="fa-solid fa-rotate-left" aria-hidden="true"></i> Restore</button>
      </div>

      <dialog class="gp-dialog" data-gp-dialog>
        <div class="gp-dialog__body">
          <h2 class="gp-dialog__title" data-gp-dialog-title data-template="Restore {n} student{s}?">Restore students?</h2>
          <p class="gp-dialog__text">They will be active again:</p>
          <ul>
            <li>They appear in your student lists and can be edited.</li>
            <li>They count as active students for billing and new fees.</li>
          </ul>
        </div>
        <div class="gp-dialog__actions">
          <button type="button" class="gp-btn gp-btn--ghost" data-gp-cancel>Cancel</button>
          <button type="button" class="gp-btn gp-btn--primary" data-gp-confirm>Restore students</button>
        </div>
      </dialog>
    </form>
  <% } %>
</div>

<script src="<%= assetUrl('/js/graduationPages.js') %>"></script>
