<%
  const _classes = Array.isArray(typeof classes !== 'undefined' ? classes : null) ? classes : [];
  const _flashError = locals.messages && Array.isArray(messages.error) ? messages.error[0] : '';
%>
<link rel="stylesheet" href="<%= assetUrl('/css/reportPages.css') %>" />

<div class="gp-page gp-page--transcripts">
  <header class="gp-head">
    <div>
      <h1 class="gp-title">Transcripts</h1>
      <p class="gp-sub">Search for a student to open their official transcript.</p>
    </div>
  </header>

  <section class="gp-card">
    <div class="tr-notice" role="note">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3l8 3v6c0 4.5-3.4 8.3-8 9-4.6-.7-8-4.5-8-9V6z"/><path d="M12 8v5M12 16h.01"/></svg>
      <div>
        <strong>Confidential records</strong>
        <ul>
          <li>Search by name or student ID, or pick a class. You confirm your password before a transcript opens, and each opening is recorded.</li>
          <li>A transcript is <b>official only when it is sent by email</b> from its page, to a parent or to a receiving school or office. Copies viewed or printed are marked Unofficial.</li>
          <li>Text messages only tell parents it is ready, with a link to their parent portal and the school's email to request it.</li>
        </ul>
      </div>
    </div>

    <% if (_flashError) { %><p class="tr-error" role="alert"><%= _flashError %></p><% } %>

    <form class="tr-filters" id="tr-form" autocomplete="off">
      <input class="tr-input" id="tr-search" type="search" placeholder="Student name or ID" aria-label="Student name or ID" maxlength="100">
      <select class="tr-input" id="tr-class" aria-label="Class">
        <option value="">Any class</option>
        <% _classes.forEach((c) => { %><option value="<%= c.class_id %>"><%= c.class_name %></option><% }) %>
      </select>
      <select class="tr-input" id="tr-status" aria-label="Status">
        <option value="">All students</option>
        <option value="Current">Current</option>
        <option value="Graduated">Graduated</option>
        <option value="Left">Transferred or withdrawn</option>
      </select>
      <button class="gp-btn gp-btn--primary tr-go" type="submit">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="M20 20l-4-4"/></svg>
        Search
      </button>
    </form>

    <p class="gp-card__note" id="tr-status-line" aria-live="polite"></p>
    <ul class="tr-list" id="tr-list" hidden></ul>
  </section>

<div class="tr-modal" id="tr-modal" hidden>
  <form class="tr-dialog" id="tr-unlock" role="dialog" aria-modal="true" aria-labelledby="tr-modal-title">
    <h2 id="tr-modal-title">Confirm it's you</h2>
    <p class="gp-card__note">Enter your password to open the transcript for <strong id="tr-modal-name"></strong>.</p>
    <input class="tr-input" id="tr-password" type="password" autocomplete="current-password" placeholder="Your password" aria-label="Your password" required>
    <p class="tr-error" id="tr-unlock-error" role="alert" hidden></p>
    <div class="tr-dialog__actions">
      <button class="gp-btn gp-btn--ghost" type="button" id="tr-cancel">Cancel</button>
      <button class="gp-btn gp-btn--primary" type="submit" id="tr-confirm">Open transcript</button>
    </div>
  </form>
</div>
</div>

<style>
  .tr-notice { display: flex; gap: 12px; align-items: flex-start; padding: 12px 14px; margin-bottom: 14px; border: 1px solid #fde68a; border-radius: 10px; background: #fffbeb; color: #78350f; }
  .tr-notice svg { flex: 0 0 auto; margin-top: 2px; }
  .tr-notice strong { display: block; font-size: 0.9rem; }
  .tr-notice ul { margin: 4px 0 0; padding-left: 16px; list-style: disc; font-size: 0.84rem; line-height: 1.5; }
  .tr-notice li + li { margin-top: 2px; }
  .tr-error { margin: 0 0 10px; color: #b91c1c; font-size: 0.85rem; }
  .tr-filters { display: flex; flex-wrap: wrap; align-items: center; gap: 10px; margin: 0 0 10px; }
  .gp-page--transcripts .tr-input, .tr-dialog .tr-input { width: auto; min-height: 38px; margin: 0; padding: 0 10px; border: 1px solid var(--gp-line, #d1d5db); border-radius: 8px; background: var(--gp-surface, #fff); color: inherit; font: inherit; }
  .gp-page--transcripts #tr-search { flex: 1 1 260px; }
  .gp-page--transcripts select.tr-input { flex: 0 0 180px; }
  .gp-page .tr-go { display: inline-flex; align-items: center; gap: 6px; width: auto; margin: 0; }
  .tr-list { list-style: none; margin: 4px 0 0; padding: 0; max-height: calc(100vh - 360px); overflow-y: auto; }
  .tr-list[hidden] { display: none; }
  .tr-row { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 10px 2px; border-bottom: 1px solid var(--gp-line, #eef0f3); }
  .tr-row:last-child { border-bottom: 0; }
  .tr-text { display: grid; gap: 2px; min-width: 0; }
  .gp-page .tr-open { display: inline-flex; align-items: center; gap: 6px; flex: 0 0 auto; width: auto; margin: 0; }
  .tr-modal { position: fixed; inset: 0; z-index: 1000; display: grid; place-items: center; padding: 16px; background: rgba(15, 23, 42, 0.45); }
  .tr-modal[hidden] { display: none; }
  .tr-dialog { width: min(400px, 100%); padding: 20px; border-radius: 12px; background: var(--ap-surface, #fff); color: var(--ap-text, #0f172a); box-shadow: 0 20px 50px rgba(15, 23, 42, 0.25); }
  .tr-dialog h2 { margin: 0 0 6px; font-size: 1.05rem; }
  .tr-dialog .tr-input { width: 100%; margin: 12px 0 8px; box-sizing: border-box; }
  .tr-dialog__actions { display: flex; justify-content: flex-end; gap: 8px; margin-top: 8px; }
  .tr-dialog .gp-btn { width: auto; margin: 0; }
  @media (max-width: 640px) { .tr-open span { display: none; } .gp-page--transcripts select.tr-input { flex: 1 1 140px; } }
</style>
<script>
  (() => {
    const form = document.getElementById('tr-form');
    if (!form || form.dataset.bound) return;
    form.dataset.bound = '1';
    const search = document.getElementById('tr-search');
    const cls = document.getElementById('tr-class');
    const status = document.getElementById('tr-status');
    const line = document.getElementById('tr-status-line');
    const list = document.getElementById('tr-list');
    const modal = document.getElementById('tr-modal');
    const unlock = document.getElementById('tr-unlock');
    const password = document.getElementById('tr-password');
    const unlockError = document.getElementById('tr-unlock-error');
    const confirmBtn = document.getElementById('tr-confirm');
    let selected = null;

    const icon = '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="5" y="11" width="14" height="10" rx="2"/><path d="M8 11V7a4 4 0 018 0v4"/></svg>';
    const row = (s) => {
      const li = document.createElement('li');
      li.className = 'tr-row';
      const text = document.createElement('span');
      text.className = 'tr-text';
      const name = document.createElement('strong');
      name.textContent = s.student_name;
      const meta = document.createElement('span');
      meta.className = 'gp-card__note';
      meta.textContent = [s.display_id, s.class_name, s.status === 'Left' ? 'Transferred or withdrawn' : s.status].filter(Boolean).join(' · ');
      text.append(name, meta);
      const open = document.createElement('button');
      open.type = 'button';
      open.className = 'gp-btn gp-btn--ghost tr-open';
      open.innerHTML = icon + '<span>Transcript</span>';
      open.setAttribute('aria-label', 'Open transcript for ' + s.student_name);
      open.addEventListener('click', () => ask(s));
      li.append(text, open);
      return li;
    };

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      const q = search.value.trim();
      if (q.length < 2 && !cls.value) {
        list.hidden = true;
        line.textContent = 'Type at least 2 letters of a name or ID, or pick a class.';
        return;
      }
      line.textContent = 'Searching…';
      try {
        const params = new URLSearchParams({ q, class: cls.value, status: status.value });
        const res = await fetch('/common/transcripts/search?' + params, { headers: { accept: 'application/json' }, credentials: 'same-origin' });
        const data = await res.json();
        if (!res.ok || !data.success) throw new Error(data.message || 'Search failed.');
        list.replaceChildren(...data.students.map(row));
        list.hidden = !data.students.length;
        line.textContent = data.students.length
          ? (data.students.length >= 25 ? 'Showing the first 25 matches. Narrow your search to see others.' : '')
          : 'No students match.';
      } catch (error) {
        list.hidden = true;
        line.textContent = error.message || 'Search failed. Try again.';
      }
    });

    const close = () => { modal.hidden = true; selected = null; password.value = ''; };
    const ask = (student) => {
      selected = student;
      document.getElementById('tr-modal-name').textContent = student.student_name;
      unlockError.hidden = true;
      password.value = '';
      modal.hidden = false;
      password.focus();
    };
    document.getElementById('tr-cancel').addEventListener('click', close);
    modal.addEventListener('click', (event) => { if (event.target === modal) close(); });
    document.addEventListener('keydown', (event) => { if (event.key === 'Escape' && !modal.hidden) close(); });

    unlock.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (!selected) return;
      confirmBtn.disabled = true;
      unlockError.hidden = true;
      try {
        const res = await fetch('/common/transcripts/unlock', {
          method: 'POST',
          credentials: 'same-origin',
          headers: { 'Content-Type': 'application/json', accept: 'application/json' },
          body: JSON.stringify({ studentId: selected.student_id, password: password.value }),
        });
        const data = await res.json().catch(() => ({}));
        if (!res.ok || !data.success) throw new Error(data.message || 'Could not check your password.');
        window.location.href = data.url;
      } catch (error) {
        unlockError.textContent = error.message;
        unlockError.hidden = false;
        password.select();
      } finally {
        confirmBtn.disabled = false;
      }
    });
  })();
</script>
