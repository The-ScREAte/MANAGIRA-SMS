<%- include('../partials/flash') %>
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Pricing - Managira</title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <style>
    :root {
      --font-family: "<%= (session && session.fontStyle ? String(session.fontStyle).trim() : 'Inter') %>", sans-serif;
      --brand: var(--org-primary-color, #01535b);
      --brand-hover: var(--org-primary-hover, #01444a);
      --border-color: #dfe5ec;
      --text-main: #1f2937;
      --text-muted: #5f6b7a;
      --surface: #ffffff;
      --page-bg: #f4f7fb;
    }

    * {
      box-sizing: border-box;
    }

    body {
      font-family: var(--font-family);
      margin: 0;
      background: var(--page-bg);
      color: var(--text-main);
    }

    .pricing-shell {
      max-width: 1140px;
      margin: 0 auto;
      padding: 24px 16px 48px;
    }

    .pricing-header {
      background: var(--surface);
      border: 1px solid var(--border-color);
      border-radius: 14px;
      padding: 24px;
      text-align: center;
      margin-bottom: 18px;
    }

    .pricing-header h1 {
      margin: 0;
      font-size: 2rem;
      line-height: 1.2;
      color: var(--text-main);
    }

    .pricing-header p {
      margin: 10px 0 0;
      font-size: 15px;
      color: var(--text-muted);
    }

    .plan-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
      gap: 16px;
    }

    .plan-card {
      background: var(--surface);
      border: 1px solid var(--border-color);
      border-radius: 14px;
      overflow: hidden;
      display: flex;
      flex-direction: column;
      min-height: 100%;
    }

    .plan-name {
      background: var(--brand);
      color: #fff;
      padding: 14px 16px;
      font-weight: 700;
      font-size: 16px;
      text-align: center;
    }

    .plan-content {
      padding: 16px;
      display: flex;
      flex-direction: column;
      gap: 14px;
      flex-grow: 1;
    }

    .plan-description {
      margin: 0;
      font-size: 14px;
      line-height: 1.5;
      color: var(--text-muted);
    }

    .feature-list {
      list-style: none;
      margin: 0;
      padding: 0;
      border-top: 1px solid var(--border-color);
      padding-top: 12px;
      display: flex;
      flex-direction: column;
      gap: 8px;
    }

    .feature-list li {
      font-size: 14px;
      color: var(--text-main);
      line-height: 1.4;
    }

    .plan-price {
      border-top: 1px solid var(--border-color);
      padding: 14px 16px;
      background: #f8fafc;
    }

    .plan-price strong {
      display: block;
      margin: 0;
      font-size: 1.15rem;
      color: var(--text-main);
    }

    .price-caption {
      margin-top: 4px;
      font-size: 13px;
      color: var(--text-muted);
    }

    .price-local {
      margin-top: 6px;
      font-size: 12px;
      color: var(--text-muted);
      font-weight: 500;
    }

    .plan-action {
      margin-top: auto;
      padding: 0 16px 16px;
    }

    .btn,
    .btn-secondary {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 100%;
      min-height: 44px;
      border-radius: 10px;
      border: 1px solid transparent;
      font-size: 15px;
      font-weight: 600;
      text-decoration: none;
      cursor: pointer;
      transition: background-color 0.2s ease, color 0.2s ease, border-color 0.2s ease;
    }

    .btn {
      background: var(--brand);
      color: #fff;
    }

    .btn:hover {
      background: var(--brand-hover);
    }

    .btn-secondary {
      background: #fff;
      border-color: var(--brand);
      color: var(--brand);
    }

    .btn-secondary:hover {
      background: #edf7f6;
    }

    .pricing-footnote {
      margin-top: 14px;
      text-align: center;
      font-size: 12px;
      color: var(--text-muted);
    }

    .trial-cta {
      margin-top: 16px;
    }

    @media (max-width: 768px) {
      .pricing-shell {
        padding: 16px 16px 36px;
      }

      .pricing-header {
        padding: 18px;
      }

      .pricing-header h1 {
        font-size: 1.7rem;
      }

      .plan-grid {
        grid-template-columns: 1fr;
      }
    }

    @media (max-width: 480px) {
      .pricing-shell {
        padding: 14px 14px 30px;
      }
    }
  </style>
</head>
<body>
  <main class="pricing-shell">
    <section class="pricing-header">
      <h1>Select a Service Plan</h1>
      <p>Choose the package that best fits your school and continue to registration.</p>
    </section>

    <section class="plan-grid">
      <% plans.forEach(function(plan) { %>
        <article class="plan-card">
          <div class="plan-name"><%= plan.plan_name %></div>
          <div class="plan-content">
            <p class="plan-description"><%= plan.description %></p>
            <ul class="feature-list">
              <% (plan.features || []).forEach(function(f) { %>
                <li><%= f.feature_name %></li>
              <% }) %>
            </ul>
          </div>
          <div class="plan-price">
            <strong><%= plan.priceUsdDisplay || ('$' + (plan.total_price ? plan.total_price.toFixed(2) : '0.00')) %></strong>
            <div class="price-caption">per month</div>
            <% if (currencyProfile && currencyProfile.userCurrency && currencyProfile.userCurrency !== 'USD') { %>
              <div class="price-local">
                ≈ <%= plan.localizedPriceDisplay %> / month
              </div>
            <% } %>
          </div>
          <div class="plan-action">
            <a href="/account/service-plan?plan=<%= plan.plan_id %>" class="btn">Register Now</a>
          </div>
        </article>
      <% }) %>
    </section>

    <% if (currencyProfile && currencyProfile.userCurrency && currencyProfile.userCurrency !== 'USD') { %>
      <p class="pricing-footnote">
        Prices are based in USD and shown in <%= currencyProfile.userCurrency %> using live exchange rates.
      </p>
    <% } %>

    <% if (freeTrialEnabled && premiumPlanId) { %>
      <div class="trial-cta">
        <a
          href="/account/service-plan?plan=<%= premiumPlanId %>&trial=1"
          class="btn-secondary"
        >
          Try Free Premium Now
        </a>
      </div>
    <% } %>
  </main>
</body>
</html>
