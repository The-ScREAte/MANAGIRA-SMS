<%- include('../partials/flash') %>
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Pricing - Managira</title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <style>
      :root {
        --font-family: "<%= (session && session.fontStyle ? String(session.fontStyle).trim() : 'Inter') %>", sans-serif;
      }

    body {
      font-family: var(--font-family);
      margin: 0;
      background-color: #f5f5f5;
    }

    form {
      max-width: 1000px;
      margin: 50px auto;
      background-color: #fff;
      border-radius: 8px;
      border: 1px solid #ddd;
      padding-bottom: 20px;
    }

    h1 {
      text-align: center;
      margin: 20px 0;
      color: #333;
    }

    p {
      padding: 10px;
    }

    .plan-table {
      display: flex;
      border-top: 1px solid #ddd;
    }

    .plan {
      flex: 1;
      cursor: pointer;
      text-align: center;
      transition: background-color 0.3s ease, border 0.3s ease,
        font-weight 0.3s ease;
      border-right: 1px solid #ddd;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      padding: 15px;
    }

    .plan:last-child {
      border-right: none;
    }

    .plan-header {
      background-color: var(--org-primary-color);
      color: white;
      padding: 15px;
      font-size: 16px;
      font-weight: bold;
    }

    .plan-body {
      padding: 20px;
      background-color: #fff;
      border-bottom: 1px solid #ddd;
      flex-grow: 1;
    }

    .plan-body p {
      margin: 0 0 15px 0;
      font-size: 14px;
      color: #333;
    }

    .plan-body ul {
      list-style: none;
      padding: 0;
      margin: 0;
      text-align: left;
      border-top: 1px solid #ddd;
      padding-top: 15px;
    }

    .plan-body ul li {
      margin-bottom: 8px;
      font-size: 14px;
      color: #333;
    }

    .plan-price {
      padding: 15px 20px;
      font-size: 14px;
      color: #333;
      border-top: 1px solid #ddd;
      background-color: #f9f9f9;
    }

    .plan-price strong {
      display: block;
      margin: 5px 0;
    }

    /* Selected plan styling */
    .plan.selected {
      border: 3px solid var(--org-primary-color) !important;
      background-color: #eaf4ff;
      font-weight: bold;
    }

    .btn {
      display: block;
      width: 100%;
      padding: 15px;
      background-color: var(--org-primary-color);
      color: white;
      border: none;
      font-size: 16px;
      cursor: pointer;
      text-align: center;
    }

    .btn:hover {
      background-color: var(--org-primary-hover);
    }

    .trial-cta {
      margin: 25px auto 0;
      padding: 20px;
      border-top: 1px solid #ddd;
      text-align: center;
      max-width: 900px;
    }

    .trial-cta p {
      margin-bottom: 15px;
      color: #333;
      font-size: 15px;
    }

    .btn-trial {
      background-color: #ffffff;
      border: 2px solid #01535b;
      color: #01535b;
      font-weight: 600;
    }

    .btn-trial:hover {
      background-color: #f0f8f7;
    }

    /* Responsive Styles */
    @media (max-width: 768px) {
      form {
        max-width: 100%;
        margin: 20px auto;
        padding: 15px;
        box-shadow: none;
      }

      h1 {
        font-size: 1.8rem;
        margin: 15px 0;
      }

      .plan-table {
        flex-direction: column;
        border-top: none;
        gap: 15px;
      }

      .plan {
        border-right: none;
        border: 1px solid #ddd;
        padding: 10px;
      }

      .plan-header {
        font-size: 1.2rem;
        padding: 10px;
      }

      .plan-body {
        padding: 10px;
      }

      .plan-body p {
        font-size: 0.95rem;
      }

      .plan-body ul {
        padding-top: 10px;
      }

      .plan-body ul li {
        font-size: 0.9rem;
      }

      .plan-price {
        font-size: 1rem;
        padding: 10px;
      }

      .btn {
        padding: 12px;
        font-size: 1rem;
      }
    }

    @media (max-width: 480px) {
      h1 {
        font-size: 1.6rem;
      }

      .plan-body p,
      .plan-body ul li,
      .plan-price strong {
        font-size: 0.85rem;
      }

      .btn {
        font-size: 0.9rem;
        padding: 10px;
      }
    }
  </style>
</head>
<body>
  <br><br><br>
  <form>
    <h1>Select a Service Plan</h1>
    <div class="plan-table">
      <% plans.forEach(function(plan) { %>
        <div class="plan">
          <div class="plan-header"><%= plan.plan_name %></div>
          <div class="plan-body">
            <p><%= plan.description %></p>
            <ul>
              <% (plan.features || []).forEach(function(f) { %>
                <li><%= f.feature_name %></li>
              <% }) %>
            </ul>
          </div>
          <div class="plan-price">
            <strong><%= plan.priceUsdDisplay || ('$' + (plan.total_price ? plan.total_price.toFixed(2) : '0.00')) %></strong> per month
            <% if (currencyProfile && currencyProfile.userCurrency && currencyProfile.userCurrency !== 'USD') { %>
              <div style="font-size:12px;color:#666;margin-top:4px;">
                ≈ <%= plan.localizedPriceDisplay %> / month
              </div>
            <% } %>
          </div>
          <a href="/account/service-plan?plan=<%= plan.plan_id %>" class="btn">Register Now</a>
        </div>
      <% }) %>
    </div>
    <% if (currencyProfile && currencyProfile.userCurrency && currencyProfile.userCurrency !== 'USD') { %>
      <p style="text-align:center;font-size:12px;color:#666;margin-top:10px;">
        Prices are based in USD and shown in <%= currencyProfile.userCurrency %> using live exchange rates.
      </p>
    <% } %>
    <% if (freeTrialEnabled && premiumPlanId) { %>
      <div class="trial-cta">
        <a
          href="/account/service-plan?plan=<%= premiumPlanId %>&trial=1"
          class="btn btn-trial"
        >
          Try Free Premium Now
        </a>
      </div>
    <% } %>
  </form>
</body>
</html>
