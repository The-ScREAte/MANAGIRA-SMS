<%
  const themeColor = (typeof session !== 'undefined' && session && session.themeColor) ? session.themeColor : 'teal';
  const themeColors = {
    teal: { primary: '#01535b', hover: '#014a51' },
    blue: { primary: '#2563eb', hover: '#1d4ed8' },
    green: { primary: '#2e7d32', hover: '#1b5e20' },
    purple: { primary: '#7c3aed', hover: '#6d28d9' },
    indigo: { primary: '#4f46e5', hover: '#4338ca' },
    rose: { primary: '#8b2635', hover: '#7a212e' },
    amber: { primary: '#d97706', hover: '#b45309' },
    slate: { primary: '#334155', hover: '#1e293b' },
    cyan: { primary: '#0891b2', hover: '#0e7490' },
    orange: { primary: '#ea580c', hover: '#c2410c' },
    charcoal: { primary: '#1f2937', hover: '#111827' },
    classic: { primary: '#01535b', hover: '#014a51' },
    bold: { primary: '#0b1020', hover: '#ffb703' },
    modern: { primary: '#2563eb', hover: '#1d4ed8' },
    minimal: { primary: '#7c3aed', hover: '#6d28d9' },
    gold: { primary: '#d4a017', hover: '#b8860b' },
    red: { primary: '#e11d48', hover: '#be123c' },
    brown: { primary: '#7c4a03', hover: '#5c3802' }
  };
  const currentTheme = themeColors[themeColor] || themeColors.teal;

  const currentFilters = (typeof filters !== 'undefined' && filters) ? filters : {};
  const options = (typeof filterOptions !== 'undefined' && filterOptions)
    ? filterOptions
    : { users: [], roles: [], actions: [], modules: [] };
  const pager = (typeof pagination !== 'undefined' && pagination)
    ? pagination
    : { page: 1, totalPages: 1, total: 0, hasPrevious: false, hasNext: false };
  const pageSizeOptions = [20, 50, 70, 100, 200];
  const currentPageSize = pageSizeOptions.includes(Number(pager.pageSize)) ? Number(pager.pageSize) : 20;
  const currentLogs = (typeof logs !== 'undefined' && Array.isArray(logs)) ? logs : [];
  const activeCount = ['startDate','endDate','user','action','module','role','search']
    .filter(k => currentFilters[k]).length;
  const queryForPage = (pageNumber, pageSizeOverride) => {
    const params = new URLSearchParams();
    Object.entries(currentFilters).forEach(([key, value]) => {
      if (value) params.set(key, value);
    });
    const sizeToUse = Number(pageSizeOverride) || currentPageSize;
    if (sizeToUse) params.set('pageSize', String(sizeToUse));
    params.set('page', String(pageNumber));
    return `/common/activityLogs?${params.toString()}`;
  };
  const formatDate = (value) => {
    const date = new Date(value);
    if (Number.isNaN(date.getTime())) return '';
    return date.toLocaleString('en-US', {
      month: 'short', day: 'numeric', year: 'numeric',
      hour: '2-digit', minute: '2-digit'
    });
  };
%>

<style>
  :root {
    --border: #e5e7eb;
    --muted: #6b7280;
    --surface: #ffffff;
    --primary: <%= currentTheme.primary %>;
    --primary-hover: <%= currentTheme.hover %>;
        --primary-hover-fill: color-mix(in srgb, var(--primary) 88%, white);
    --row-alt: #fbfcfc;
  }

  body { background: #f9fafb; }
  main { padding: 0 !important; max-width: none !important; }

  .logs-page { max-width: 1240px; margin: 12px auto 40px; width: 100%; padding: 0 20px; display: grid; gap: 12px; }

  .logs-page-head { display: flex; align-items: center; justify-content: space-between; gap: 12px; flex-wrap: wrap; }
  .logs-page-head h1 { margin: 0; font-size: 22px; color: #111827; }
  .logs-page-head p { margin: 2px 0 0; color: var(--muted); font-size: 13px; }
  .back-link {
    display: inline-flex; align-items: center; gap: 6px;
    padding: 8px 14px; border-radius: 8px;
    border: 1px solid var(--border);
    background: #fff; color: var(--primary) !important;
    font-size: 0.82rem; font-weight: 600; text-decoration: none;
  }
  .back-link:hover { background: #f3f4f6; }

  .filters-panel { background: var(--surface); border: 1px solid var(--border); border-radius: 10px; padding: 10px 12px; }
  .filters-row { display: flex; flex-wrap: nowrap; gap: 6px; align-items: end; }
  .filter-field { display: flex; flex-direction: column; gap: 2px; min-width: 0; margin: 0; flex: 1 1 0; }
  .filter-field label {
    font-size: 0.6rem; font-weight: 600; color: #4b5563;
    text-transform: uppercase; letter-spacing: 0.03em;
    line-height: 1; margin: 0; height: 10px;
    display: flex; align-items: flex-end;
    white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
  }
  .filter-field input, .filter-field select {
    width: 100%; height: 28px; line-height: 1;
    border: 1px solid var(--border); border-radius: 5px;
    padding: 0 6px; font-size: 0.74rem;
    background: #fff; color: #111827;
    box-sizing: border-box; margin: 0;
  }
  .filter-field.date { flex: 0 0 115px; }
  .filter-field.keyword { flex: 2 1 140px; }
  .filter-actions { display: flex; gap: 4px; align-items: end; padding-top: 12px; }
  .btn-sm, .btn-sm-secondary {
    display: inline-flex; align-items: center; justify-content: center;
    height: 28px; padding: 0 10px; border-radius: 5px;
    font-size: 0.74rem; font-weight: 600; border: 1px solid transparent;
    cursor: pointer; white-space: nowrap; text-decoration: none;
  }
  .btn-sm { background: var(--primary); color: #fff !important; }
  .btn-sm:hover { background: var(--primary-hover-fill, var(--primary-hover)); }
  .btn-sm-secondary { background: #fff; color: #111827 !important; border-color: var(--border); }

  .filters-toggle {
    display: none;
    align-items: center; justify-content: space-between;
    gap: 8px; padding: 8px 12px;
    border: 1px solid var(--border); border-radius: 8px;
    background: #fff; font: inherit; cursor: pointer; width: 100%;
  }
  .toggle-left { display: flex; align-items: center; gap: 8px; color: var(--primary); font-weight: 600; }
  .active-filter-count {
    display: inline-flex; align-items: center; justify-content: center;
    min-width: 20px; height: 20px; padding: 0 6px; border-radius: 999px;
    background: var(--primary); color: #fff; font-size: 0.7rem; font-weight: 700;
  }

  .logs-panel { background: var(--surface); border: 1px solid var(--border); border-radius: 10px; overflow: hidden; }
  .logs-summary {
    display: flex; justify-content: space-between; gap: 10px;
    align-items: center; padding: 6px 12px;
    border-bottom: 1px solid var(--border);
    color: #8d98a6; font-size: 0.76rem;
  }
  .logs-scroll {
    overflow: auto;
    -webkit-overflow-scrolling: touch;
    max-height: min(68vh, 640px);
    overscroll-behavior: contain;
  }
  .logs-list { list-style: none; margin: 0; padding: 0; min-width: 980px; }
  .logs-list li { margin: 0; padding: 0; }
  .logs-head, .log-item {
    display: grid;
    grid-template-columns: 154px 62px minmax(180px,1.4fr) 108px minmax(110px,1fr) minmax(180px,2fr);
    gap: 8px; padding: 4px 16px; align-items: center;
  }
  .logs-head {
    position: sticky; top: 0; z-index: 1;
    background: #f4f6f8; border-bottom: 2px solid var(--border);
    font-size: 0.65rem; font-weight: 700; color: #9aa8ba;
    text-transform: uppercase; letter-spacing: 0.08em;
    padding: 6px 16px; align-items: center;
  }
  .log-item {
    border-top: 1px solid #f0f2f5;
    font-family: 'SFMono-Regular', 'Consolas', 'Liberation Mono', monospace;
    font-size: 0.75rem; line-height: 1.45; color: #334155;
  }
  /* Very faint stripe — odd rows plain white, even rows barely tinted */
  .log-item:nth-child(odd)  { background: #ffffff; }
  .log-item:nth-child(even) { background: #f2f5f8; }
  .log-item:hover { background: #e6eef6; }
  .log-cell { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

  /* Timestamp */
  .log-stamp { color: #a7b2c0; font-variant-numeric: tabular-nums; font-size: 0.76rem; }

  /* Action — plain bold text, no badge box */
  .log-action {
    font-family: 'SFMono-Regular', 'Consolas', 'Liberation Mono', monospace;
    font-size: 0.7rem; font-weight: 700;
    text-transform: uppercase; letter-spacing: 0.07em;
    color: #64748b;
  }

  /* User column — single line */
  .log-user { font-weight: 600; color: #1e293b; }
  .log-role { color: #a4afbd; font-size: 0.7rem; }
  .log-role::before { content: ' · '; color: #dde1e7; }

  /* Module */
  .log-module { color: #64748b; }

  /* Record */
  .log-record { color: #7c8a9a; }

  /* Description */
  .log-desc { color: #a0adb8; }

  .empty-state { padding: 28px 16px; text-align: center; color: var(--muted); font-size: 0.85rem; }
  .as-pagebar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    margin: 0;
    padding: 10px 12px;
    border-top: 1px solid var(--border);
    background: #fff;
    flex-wrap: wrap;
  }
  .as-pagebar-left,
  .as-pagebar-right {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .as-pagebar-label {
    font-size: 13px;
    color: var(--muted);
    font-weight: 700;
  }
  .as-pagebar-select {
    height: 32px;
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 0 10px;
    font-size: 14px;
    font-weight: 700;
    background: #fff;
    color: #0f172a;
  }
  .as-page-btn {
    border: 1px solid var(--border);
    background: #fff;
    color: #0f172a;
    border-radius: 8px;
    height: 32px;
    min-width: 32px;
    padding: 0 10px;
    font-size: 13px;
    font-weight: 700;
    cursor: pointer;
  }
  .as-page-btn:disabled {
    opacity: 0.42;
    cursor: not-allowed;
  }
  .as-page-info {
    font-size: 14px;
    color: #0f172a;
    font-weight: 800;
    min-width: 54px;
    text-align: center;
  }

  @media (max-width: 900px) {
    .filters-toggle { display: flex; }
    .filters-row {
      display: none; flex-wrap: wrap;
      padding: 10px; margin-top: 8px;
      border: 1px solid var(--border); border-radius: 10px;
      background: #fff; gap: 8px;
    }
    .filters-row.open { display: flex; }
    .filter-field { flex: 1 1 calc(50% - 8px); }
    .filter-field.date { flex: 1 1 calc(50% - 8px); }
    .filter-field.keyword { flex: 1 1 100%; }
    .filter-actions { flex: 1 1 100%; padding-top: 0; }
    .filter-actions .btn-sm, .filter-actions .btn-sm-secondary { flex: 1 1 auto; }
  }
  @media (max-width: 520px) {
    .filter-field, .filter-field.date { flex: 1 1 100%; }
  }

  /* Clickable description button */
  .log-desc { overflow: hidden; }
  .log-desc-btn {
    background: none !important; border: none; padding: 0; margin: 0;
    font: inherit; cursor: pointer; text-align: left;
    width: 100%; display: block;
    overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
    color: #94a3b8; font-size: 0.76rem;
    text-decoration: underline dotted #d1d5db;
    text-underline-offset: 2px;
    box-shadow: none !important; outline: none;
  }
  .log-desc-btn:hover { color: #334155; text-decoration-color: #94a3b8; }
  .log-desc-btn:focus-visible { outline: 2px solid var(--primary); outline-offset: 2px; border-radius: 2px; }

  /* Description modal */
  .log-modal-backdrop {
    display: none; position: fixed; inset: 0;
    background: rgba(15,23,42,0.38); z-index: 9999;
    align-items: center; justify-content: center; padding: 20px;
    backdrop-filter: blur(2px);
  }
  .log-modal-backdrop.open { display: flex; }
  .log-modal {
    background: #fff; border-radius: 12px;
    max-width: 500px; width: 100%;
    box-shadow: 0 24px 64px rgba(15,23,42,0.2), 0 0 0 1px rgba(15,23,42,0.06);
    overflow: hidden; animation: modalIn 0.15s ease;
  }
  @keyframes modalIn {
    from { opacity: 0; transform: scale(0.97) translateY(6px); }
    to   { opacity: 1; transform: scale(1) translateY(0); }
  }
  .log-modal-head {
    display: flex; justify-content: space-between; align-items: center;
    padding: 11px 14px; border-bottom: 1px solid #f1f3f5;
    background: #f8fafc;
  }
  .log-modal-title { margin: 0; font-size: 0.75rem; font-weight: 700; color: #374151; letter-spacing: 0.02em; text-transform: uppercase; }
  .log-modal-close {
    background: none !important; border: none; cursor: pointer;
    color: #94a3b8; padding: 2px 5px; line-height: 1;
    font-size: 0.72rem; border-radius: 4px; box-shadow: none;
  }
  .log-modal-close:hover { background: #e5e7eb !important; color: #374151; }
  .log-modal-meta {
    display: flex; flex-wrap: wrap; gap: 0;
    padding: 8px 14px; border-bottom: 1px solid #f1f3f5;
    font-family: 'SFMono-Regular', 'Consolas', monospace;
    font-size: 0.65rem; color: #94a3b8; line-height: 1.6;
  }
  .log-modal-meta span { margin-right: 14px; white-space: nowrap; }
  .log-modal-meta strong { color: #1e293b; font-weight: 600; }
  .log-modal-body {
    padding: 14px;
    font-family: 'SFMono-Regular', 'Consolas', 'Liberation Mono', monospace;
    font-size: 0.72rem; line-height: 1.7; color: #334155;
    max-height: 50vh; overflow-y: auto;
    white-space: pre-wrap; word-break: break-word;
    background: #fff;
  }

  /* Mobile compact table layout */
  @media (max-width: 640px) {
    .logs-scroll { max-height: 62vh; }
    .logs-list { min-width: 940px; }
    .logs-head, .log-item {
      padding-left: 12px;
      padding-right: 12px;
    }
    .logs-head { font-size: 0.68rem; }
    .log-item { font-size: 0.78rem; }
    .log-desc-btn { font-size: 0.72rem; }
  }
</style>

<div class="logs-page">
  <div class="logs-page-head">
    <div>
      <h1>Activity Logs</h1>
      <p>Meaningful actions across your organization. Filter to audit large activity volumes quickly.</p>
    </div>
    <a href="/common/reports#activity-logs" class="back-link" data-no-spa>
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6"/></svg>
      Back to Reports
    </a>
  </div>

  <form class="filters-panel" method="get" action="/common/activityLogs">
    <button type="button" class="filters-toggle" id="filtersToggle" aria-expanded="false" aria-controls="filtersRow">
      <span class="toggle-left">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M4 5h16l-6 8v5l-4 2v-7L4 5z" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        <span>Filters</span>
        <% if (activeCount > 0) { %><span class="active-filter-count"><%= activeCount %></span><% } %>
      </span>
      <span aria-hidden="true" style="color: var(--muted); font-size: 0.75rem;">Tap to <span id="filtersToggleAction">show</span></span>
    </button>
    <div class="filters-row" id="filtersRow">
      <div class="filter-field date">
        <label for="startDate">From</label>
        <input id="startDate" type="date" name="startDate" value="<%= currentFilters.startDate || '' %>">
      </div>
      <div class="filter-field date">
        <label for="endDate">To</label>
        <input id="endDate" type="date" name="endDate" value="<%= currentFilters.endDate || '' %>">
      </div>
      <div class="filter-field select">
        <label for="user">User</label>
        <select id="user" name="user">
          <option value="">All users</option>
          <% (options.users || []).forEach((userName) => { %>
            <option value="<%= userName %>" <%= currentFilters.user === userName ? 'selected' : '' %>><%= userName %></option>
          <% }) %>
        </select>
      </div>
      <div class="filter-field select">
        <label for="action">Action</label>
        <select id="action" name="action">
          <option value="">All actions</option>
          <% (options.actions || []).forEach((actionName) => { %>
            <option value="<%= actionName %>" <%= currentFilters.action === actionName ? 'selected' : '' %>><%= actionName %></option>
          <% }) %>
        </select>
      </div>
      <div class="filter-field select">
        <label for="module">Module</label>
        <select id="module" name="module">
          <option value="">All modules</option>
          <% (options.modules || []).forEach((moduleName) => { %>
            <option value="<%= moduleName %>" <%= currentFilters.module === moduleName ? 'selected' : '' %>><%= moduleName %></option>
          <% }) %>
        </select>
      </div>
      <div class="filter-field select">
        <label for="role">Role</label>
        <select id="role" name="role">
          <option value="">All roles</option>
          <% (options.roles || []).forEach((roleName) => { %>
            <option value="<%= roleName %>" <%= currentFilters.role === roleName ? 'selected' : '' %>><%= roleName %></option>
          <% }) %>
        </select>
      </div>
      <div class="filter-field keyword">
        <label for="search">Keyword</label>
        <input id="search" type="search" name="search" placeholder="Search…" value="<%= currentFilters.search || '' %>">
      </div>
      <div class="filter-actions">
        <button class="btn-sm" type="submit">Apply</button>
        <a class="btn-sm-secondary" href="/common/activityLogs">Clear</a>
      </div>
    </div>
  </form>

  <div class="logs-panel">
    <div class="logs-summary">
      <span><strong><%= pager.total %></strong> log entries</span>
      <span>Compact list view</span>
    </div>

    <% if (currentLogs.length === 0) { %>
      <div class="empty-state">
        No matching activity logs were found for the selected filters.
      </div>
    <% } else { %>
      <div class="logs-scroll">
        <ul class="logs-list">
          <li class="logs-head" role="row">
            <span>Date</span>
            <span>Action</span>
            <span>User</span>
            <span>Module</span>
            <span>Record</span>
            <span>Description</span>
          </li>
          <% currentLogs.forEach((log) => { %>
            <li class="log-item">
              <span class="log-cell log-stamp"><%= formatDate(log.created_at) %></span>
              <span class="log-cell log-action-cell"><span class="log-action log-action--<%= (log.action_type || '').toLowerCase().replace(/[^a-z0-9]+/g, '-') %>"><%= log.action_type %></span></span>
              <span class="log-cell log-user-cell">
                <span class="log-user"><%= log.user_name %></span>
                <span class="log-role"><%= log.user_role || '—' %></span>
              </span>
              <span class="log-cell log-module"><%= log.module_name %></span>
              <span class="log-cell log-record">
                <%= log.record_label || log.record_type || '—' %>
              </span>
              <span class="log-cell log-desc"><button class="log-desc-btn"
                data-desc="<%= log.description || '' %>"
                data-action="<%= log.action_type || '' %>"
                data-user="<%= log.user_name || '' %>"
                data-module="<%= log.module_name || '' %>"
                data-stamp="<%= formatDate(log.created_at) %>"
              ><%= log.description %></button></span>
            </li>
          <% }) %>
        </ul>
      </div>

      <div class="as-pagebar" id="asPageBar" aria-label="Activity logs pagination">
        <div class="as-pagebar-left">
          <span class="as-pagebar-label">Show per page</span>
          <select class="as-pagebar-select" id="asPageSizeSelect">
            <% pageSizeOptions.forEach((size) => { %>
              <option value="<%= size %>" <%= currentPageSize === size ? 'selected' : '' %>><%= size %></option>
            <% }) %>
          </select>
        </div>
        <div class="as-pagebar-right">
          <button type="button" class="as-page-btn" id="asPagePrev" <%= pager.hasPrevious ? '' : 'disabled' %>>Prev</button>
          <span class="as-page-info" id="asPageInfo"><%= pager.page %>/<%= pager.totalPages %></span>
          <button type="button" class="as-page-btn" id="asPageNext" <%= pager.hasNext ? '' : 'disabled' %>>Next</button>
        </div>
      </div>
    <% } %>
  </div>
</div>

<div class="log-modal-backdrop" id="logModalBackdrop" role="dialog" aria-modal="true" aria-labelledby="logModalTitle">
  <div class="log-modal">
    <div class="log-modal-head">
      <p class="log-modal-title" id="logModalTitle">Full Description</p>
      <button class="log-modal-close" id="logModalClose" aria-label="Close">&#x2715;</button>
    </div>
    <div class="log-modal-meta" id="logModalMeta"></div>
    <div class="log-modal-body" id="logModalText"></div>
  </div>
</div>

<script>
  function initActivityLogsPage() {
    const pageRoot = document.querySelector('.logs-page');
    if (!pageRoot || pageRoot.dataset.activityLogsBound === 'true') return;
    pageRoot.dataset.activityLogsBound = 'true';

    // Description modal
    const backdrop = document.getElementById('logModalBackdrop');
    const modalText = document.getElementById('logModalText');
    const modalMeta = document.getElementById('logModalMeta');
    const modalClose = document.getElementById('logModalClose');
    if (!backdrop || !modalText || !modalMeta || !modalClose) return;

    function openModal(btn) {
      modalText.textContent = btn.dataset.desc || '';
      const parts = [
        btn.dataset.action ? '<span><strong>' + btn.dataset.action + '</strong></span>' : '',
        btn.dataset.user   ? '<span>' + btn.dataset.user + '</span>' : '',
        btn.dataset.module ? '<span>' + btn.dataset.module + '</span>' : '',
        btn.dataset.stamp  ? '<span>' + btn.dataset.stamp + '</span>' : ''
      ].filter(Boolean);
      modalMeta.innerHTML = parts.join('');
      modalMeta.style.display = parts.length ? '' : 'none';
      backdrop.classList.add('open');
      backdrop.removeAttribute('hidden');
      modalClose.focus();
    }
    function closeModal() { backdrop.classList.remove('open'); }
    pageRoot.addEventListener('click', function(event) {
      const btn = event.target.closest('.log-desc-btn');
      if (!btn) return;
      openModal(btn);
    });
    if (modalClose) modalClose.addEventListener('click', closeModal);
    backdrop.addEventListener('click', function(e) { if (e.target === backdrop) closeModal(); });
    document.addEventListener('keydown', function(e) { if (e.key === 'Escape') closeModal(); });

    // Filters toggle
    const toggle = document.getElementById('filtersToggle');
    const row = document.getElementById('filtersRow');
    if (toggle && row) {
      const hasActive = <%= activeCount %> > 0;
      if (hasActive && window.matchMedia('(max-width: 900px)').matches) {
        row.classList.add('open');
        toggle.setAttribute('aria-expanded', 'true');
      }
      toggle.addEventListener('click', () => {
        const open = row.classList.toggle('open');
        toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
        const actionLabel = document.getElementById('filtersToggleAction');
        if (actionLabel) actionLabel.textContent = open ? 'hide' : 'show';
      });
    }

    // Pagination controls
    const pageSizeSelect = document.getElementById('asPageSizeSelect');
    const prevBtn = document.getElementById('asPagePrev');
    const nextBtn = document.getElementById('asPageNext');
    const currentPage = <%= pager.page %>;
    const totalPages = <%= pager.totalPages %>;

    if (pageSizeSelect) {
      pageSizeSelect.addEventListener('change', function () {
        const selectedSize = Number(pageSizeSelect.value) || <%= currentPageSize %>;
        const url = new URL(window.location.href);
        url.searchParams.set('page', '1');
        url.searchParams.set('pageSize', String(selectedSize));
        window.location.href = url.pathname + '?' + url.searchParams.toString();
      });
    }

    if (prevBtn) {
      prevBtn.addEventListener('click', function () {
        if (currentPage > 1) {
          window.location.href = <%- JSON.stringify(queryForPage(Math.max(1, pager.page - 1))) %>;
        }
      });
    }

    if (nextBtn) {
      nextBtn.addEventListener('click', function () {
        if (currentPage < totalPages) {
          window.location.href = <%- JSON.stringify(queryForPage(Math.min(pager.totalPages, pager.page + 1))) %>;
        }
      });
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initActivityLogsPage, { once: true });
  } else {
    initActivityLogsPage();
  }
</script>
