<%
  // Theme color mapping for organization buttons
  const themeColor = (typeof session !== 'undefined' && session && session.themeColor) ? session.themeColor : 'teal';
  const themeColors = themePalette;
  const currentTheme = themeColors[themeColor] || themeColors.teal;
  const hasMeritFeature = Array.isArray(allowedFeatures) && (
    allowedFeatures.includes('Class Base Merit Sheet') ||
    allowedFeatures.includes('Class Base Merrit sheet')
  );
  const hasOrgStats = Array.isArray(allowedFeatures) && allowedFeatures.includes('Organization Analytics & Insights') && (typeof canViewOrgStats === 'undefined' || canViewOrgStats);
%>

<style>
  :root {
    --border: #e5e7eb;
    --muted: #6b7280;
    --bg: #f9fafb;
    --primary: <%= currentTheme.primary %>;
    --primary-hover: <%= currentTheme.hover %>;
    --primary-hover-fill: color-mix(in srgb, var(--primary) 88%, white);
    --org-primary-color: <%= currentTheme.primary %>;
    --org-primary-hover: <%= currentTheme.hover %>;
    --org-primary-hover-fill: color-mix(in srgb, var(--org-primary-color) 88%, white);
  }

  body {
    background: #f9fafb;
  }

  main {
    padding: 0 !important;
    max-width: none !important;
  }

  .hub-wrapper {
    width: 100%;
    height: calc(100vh - 68px);
    overflow: hidden;
  }

  .hub-layout {
    display: grid;
    grid-template-columns: 260px 1fr;
    gap: 24px;
    max-width: none;
    margin: 12px 0 0;
    padding: 0 20px 12px;
    align-items: start;
    height: calc(100% - 12px);
    min-height: 0;
  }

  /* workspace-shell.css (loaded after this block) also targets .hub-nav and
     .hub-section.active with rules that would win on source order at equal
     specificity — scope these under .hub-layout so they win on specificity
     instead, keeping the flex chain that lets the iframe below fill the
     panel's real height and scroll internally instead of the outer page. */
  .hub-layout .hub-nav {
    border: 1px solid var(--border);
    border-radius: 14px;
    padding: 16px 12px;
    background: #fff;
    height: 100%;
    box-shadow: 0 10px 26px rgba(15, 23, 42, 0.08);
    overflow-y: auto;
  }

  .hub-nav-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin: 4px 12px 12px;
    width: 100%;
  }

  .hub-nav h3 {
    margin: 0;
    font-size: 18px;
    color: var(--primary);
    font-weight: 700;
  }

  .nav-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: minmax(0, 1fr); /* items span the full sidebar width */
    gap: 2px;
  }

  .nav-list li {
    margin: 0;
  }

  .nav-link {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 10px 14px !important;
    min-height: 42px;
    border-radius: 10px;
    color: #111827;
    text-decoration: none;
    border: 1px solid transparent;
    width: 100%;
    background: transparent;
    cursor: pointer;
    font: inherit;
    text-align: left;
    font-weight: 600;
    font-size: 14px;
    transition: all 0.2s ease;
    flex-direction: row;
    justify-content: flex-start;
    box-sizing: border-box;
  }

  .nav-link:hover {
    background: #f3f4f6;
    border-color: #e5e7eb;
  }

  .nav-link.active {
    background: var(--primary);
    color: #fff;
    border-color: var(--primary);
  }

  .nav-link.active:hover {
    background: var(--primary-hover-fill, var(--primary-hover));
  }

  .nav-link svg {
    color: inherit;
  }

  .nav-link-icon {
    display: inline-flex;
    flex-shrink: 0;
  }

  .nav-link-icon svg {
    width: 18px;
    height: 18px;
  }

  /* Expandable group (Term Reports) */
  .nav-group-toggle {
    justify-content: space-between;
  }

  /* The caret must not take a share of the row (a shared rule gives every
     label span flex: 1), or it squeezes "Term Reports" until it's clipped. */
  .hub-nav .nav-link.nav-group-toggle > span.nav-caret {
    flex: 0 0 auto;
    max-width: none;
    overflow: visible;
  }

  .nav-caret {
    display: inline-flex;
    flex-shrink: 0;
    margin-left: auto;
    opacity: 0.65;
    transition: transform 0.18s ease;
  }

  .nav-caret svg {
    width: 12px;
    height: 12px;
    display: block;
  }

  .nav-group-toggle[aria-expanded="true"] .nav-caret {
    transform: rotate(180deg);
  }

  /* Sub-menu — forced to a single vertical column and styled just like the
     top-level items (icon + label), only indented slightly to show nesting. */
  .nav-submenu {
    list-style: none !important;
    margin: 2px 0 4px !important;
    padding: 0 !important;
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.2s ease;
    display: block !important;
    grid-template-columns: none !important;
    column-count: 1 !important;
    width: 100% !important;
  }

  .nav-submenu.open {
    max-height: 600px;
  }

  .nav-submenu li {
    display: block !important;
    width: 100% !important;
    margin: 0 !important;
  }

  .nav-sublink {
    display: flex !important;
    align-items: center;
    gap: 8px;
    width: 100% !important;
    box-sizing: border-box;
    padding: 9px 14px 9px 34px !important;
    margin: 1px 0;
    border-radius: 10px;
    color: #111827;
    text-decoration: none;
    font-size: 13.5px;
    font-weight: 500;
    line-height: 1.3;
    border: 1px solid transparent;
    transition: all 0.2s ease;
    cursor: pointer;
  }

  .nav-sublink:hover {
    background: #f3f4f6;
    border-color: #e5e7eb;
  }

  .nav-sublink.active {
    background: var(--primary);
    color: #fff;
    border-color: var(--primary);
  }

  .nav-sublink.active:hover {
    background: var(--primary-hover-fill, var(--primary-hover));
  }

  .nav-sublink .nav-link-icon svg {
    width: 15px;
    height: 15px;
  }

  .hub-main {
    padding: 0;
    background: #fff;
    border-radius: 14px;
    border: 1px solid var(--border);
    box-shadow: 0 10px 30px rgba(15, 23, 42, 0.06);
    overflow: hidden;
    height: 100%;
    min-height: 0;
    display: flex;
    flex-direction: column;
  }

  .hub-layout .hub-section {
    display: none;
    flex: 1;
    min-height: 0;
  }

  .hub-layout .hub-section.active {
    display: flex;
    flex-direction: column;
    flex: 1;
    min-height: 0;
  }

  .embed-panel-body {
    position: relative;
    flex: 1;
    display: flex;
    flex-direction: column;
    min-height: 0;
  }

  .embed-overlay-spinner {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    background: rgba(255, 255, 255, 0.82);
    color: var(--muted);
    font-size: 14px;
    z-index: 5;
  }

  .embed-overlay-spinner[hidden] {
    display: none;
  }

  .embed-iframe {
    width: 100%;
    border: 0;
    display: block;
    /* Fills the panel and scrolls its own content internally — the outer
       hub page never grows past the viewport, so there's only ever one
       scrollbar (the iframe's), not two. */
    flex: 1;
    height: 100%;
    min-height: 0;
  }

  .embed-placeholder {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    gap: 10px;
    padding: 60px 24px;
    color: var(--muted);
  }

  .embed-placeholder svg {
    width: 32px;
    height: 32px;
    color: var(--primary);
    opacity: 0.7;
  }

  .embed-placeholder p {
    margin: 0;
    font-size: 14px;
  }

  .embed-loading {
    flex: 1;
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 60px 20px;
    justify-content: center;
    color: var(--muted);
    font-size: 14px;
  }

  .embed-error {
    padding: 24px;
    color: #b3261e;
    font-size: 14px;
    line-height: 1.6;
  }

  .embed-error a {
    color: var(--primary);
    font-weight: 600;
  }

  .btn-spinner {
    display: inline-block;
    width: 16px;
    height: 16px;
    border: 2px solid rgba(1, 83, 91, 0.2);
    border-top-color: var(--primary);
    border-radius: 50%;
    animation: embed-spin 0.7s linear infinite;
  }

  @keyframes embed-spin {
    to { transform: rotate(360deg); }
  }

  /* Mobile navigation */
  .hub-nav-toggle {
    display: none;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    padding: 8px 12px !important;
    border-radius: 8px;
    border: 1px solid var(--border);
    background: #fff;
    cursor: pointer;
    font: inherit;
    font-weight: 600;
    font-size: 13px;
    color: var(--primary);
    margin: 0;
    width: 100%;
    box-shadow: 0 4px 14px rgba(15, 23, 42, 0.04);
  }

  .hub-nav-toggle-label,
  .hub-nav-toggle-text {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }

  .hub-nav-toggle-current {
    color: #64748b;
    font-weight: 500;
  }

  .hub-nav-toggle-caret {
    width: 10px;
    height: 10px;
    border-right: 2px solid currentColor;
    border-bottom: 2px solid currentColor;
    transform: rotate(45deg);
    transition: transform 0.2s ease;
    margin-top: -2px;
  }

  .hub-nav-toggle[aria-expanded="true"] .hub-nav-toggle-caret {
    transform: rotate(-135deg);
    margin-top: 4px;
  }

  .hub-nav-toggle .hub-hamburger-icon {
    position: relative;
    width: 18px;
    height: 2px;
    background: var(--primary);
    display: inline-block;
  }

  .hub-nav-toggle .hub-hamburger-icon::before,
  .hub-nav-toggle .hub-hamburger-icon::after {
    content: "";
    position: absolute;
    left: 0;
    width: 18px;
    height: 2px;
    background: var(--primary);
  }

  .hub-nav-toggle .hub-hamburger-icon::before { top: -6px; }
  .hub-nav-toggle .hub-hamburger-icon::after { top: 6px; }

  .hub-nav-close {
    display: none;
    background: transparent;
    border: none;
    font-size: 24px;
    cursor: pointer;
    padding: 4px 8px;
    color: #6b7280;
    line-height: 1;
  }

  .hub-nav-close:hover {
    color: #111827;
  }

  /* Desktop-only rail collapse: shrinks the sidebar to icon-only width and
     hands the freed grid column over to .hub-main. Hidden on mobile (see
     media query below) since the sidebar is already an overlay there.
     Kept to fast (<=160ms), cheap-to-animate properties (opacity/max-width/
     transform, one grid-template-columns transition) so it stays snappy. */
  .hub-layout {
    transition: grid-template-columns 0.16s ease;
  }

  .hub-layout.is-nav-collapsed {
    grid-template-columns: 76px 1fr;
  }

  .hub-nav-collapse-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    border-radius: 8px;
    border: 1px solid var(--border);
    background: #fff;
    color: #6b7280;
    cursor: pointer;
    padding: 0;
    flex-shrink: 0;
    transition: color 0.15s ease, border-color 0.15s ease, background-color 0.15s ease, transform 0.1s ease;
  }

  .hub-nav-collapse-toggle:hover {
    color: var(--primary);
    border-color: var(--primary);
    background: #f8fafc;
  }

  .hub-nav-collapse-toggle:active {
    transform: scale(0.9);
  }

  .hub-nav-collapse-toggle svg {
    width: 16px;
    height: 16px;
  }

  .hub-nav.is-collapsed .hub-nav-collapse-toggle {
    color: var(--primary);
    border-color: var(--primary);
  }

  .hub-nav-header h3 {
    opacity: 1;
    transition: opacity 0.1s ease;
  }

  .hub-nav.is-collapsed .hub-nav-header {
    justify-content: center;
    margin-left: 0;
    margin-right: 0;
  }

  .hub-nav.is-collapsed .hub-nav-header h3 {
    display: none;
    opacity: 0;
  }

  .hub-nav.is-collapsed .nav-link {
    justify-content: center;
    padding: 10px !important;
    gap: 0;
  }

  .nav-link > span:not(.nav-link-icon) {
    display: inline-block;
    max-width: 220px;
    opacity: 1;
    white-space: nowrap;
    overflow: hidden;
    transition: opacity 0.12s ease, max-width 0.16s ease;
  }

  .hub-nav.is-collapsed .nav-link > span:not(.nav-link-icon) {
    opacity: 0;
    max-width: 0;
  }

  .hub-nav.is-collapsed .nav-submenu {
    display: none !important;
  }

  .hub-nav-overlay {
    position: fixed;
    inset: 0;
    background: rgba(15, 23, 42, 0.4);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.25s ease;
    z-index: 1000;
  }

  .hub-nav-overlay.show {
    opacity: 1;
    pointer-events: auto;
  }

  @media (max-width: 900px) {
    .hub-nav-toggle {
      display: flex;
    }
    .hub-nav-close { display: none; }
    .hub-nav-collapse-toggle { display: none; }

    /* Same collapse pattern as the class dashboard: the sidebar becomes a
       hamburger-triggered overlay and the content column takes the full
       width below it, instead of squeezing both into a cramped row.
       .hub-nav is display:none on mobile (it becomes an overlay), so the
       grid only has 2 visible children here — the toggle button and
       .hub-main — which stack into two ROWS instead of sitting side-by-side
       in one row like on desktop. Without an explicit row size, the
       toggle's row sizes to its content and the leftover space in the
       fixed-height .hub-layout is never handed to .hub-main's row,
       collapsing the iframe inside it to near nothing and leaving a blank
       gap. Give the second row the rest. */
    .hub-layout {
      grid-template-columns: 1fr !important;
      grid-template-rows: auto 1fr !important;
    }
  }
</style>
<link rel="stylesheet" href="/css/workspace-shell.css" />

<div class="hub-nav-overlay" id="hub-nav-overlay"></div>

<div class="hub-wrapper">
  <div class="hub-layout" id="hub-layout">
    <!-- Mobile Toggle Button -->
    <button class="hub-nav-toggle" id="hub-nav-toggle" type="button" aria-expanded="false" aria-controls="hub-nav">
      <span class="hub-nav-toggle-label">
        <span class="hub-hamburger-icon"></span>
        <span>Menu</span>
      </span>
    </button>

    <!-- Sidebar -->
    <nav class="hub-nav" id="hub-nav">
      <div class="hub-nav-header">
        <h3>Reports</h3>
        <button class="hub-nav-collapse-toggle" id="hub-nav-collapse-toggle" type="button" aria-label="Collapse sidebar" aria-expanded="true" title="Collapse sidebar">
          <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><rect x="3" y="4" width="18" height="16" rx="2"></rect><line x1="9" y1="4" x2="9" y2="20"></line></svg>
        </button>
        <button class="hub-nav-close" id="hub-nav-close">&times;</button>
      </div>
      <ul class="nav-list">
        <% if (hasOrgStats) { %>
        <li>
          <a class="nav-link active" href="/stats/organization" data-no-spa data-section="org-stats" data-embed-url="/stats/organization" data-embed-label="View Statistics">
            <span class="nav-link-icon"><svg fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path d="M3 3v18h18"/><path d="M7 14l4-4 4 4 5-5"/></svg></span>
            <span>Organization Stats</span>
          </a>
        </li>
        <% } %>
        <li>
          <button class="nav-link nav-group-toggle<%= hasOrgStats ? '' : ' active' %>" data-section="term-management" aria-expanded="<%= hasOrgStats ? 'false' : 'true' %>">
            <span class="nav-link-icon"><svg fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/></svg></span>
            <span>Term Reports</span>
            <span class="nav-caret" aria-hidden="true"><svg fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M6 9l6 6 6-6"/></svg></span>
          </button>
          <ul class="nav-submenu<%= hasOrgStats ? '' : ' open' %>">
            <li>
              <a class="nav-sublink" href="/common/closeSchoolYear" data-no-spa data-group="term-management" data-embed-url="/common/closeSchoolYear" data-embed-label="<%= hasMeritFeature ? 'Terminal Report & Merit Sheet' : 'Terminal Report' %>">
                <span class="nav-link-icon"><svg fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg></span>
                <span><%= hasMeritFeature ? 'Terminal Report & Merit Sheet' : 'Terminal Report' %></span>
              </a>
            </li>
            <li>
              <a class="nav-sublink" href="<%= typeof defaultReportSettingsUrl !== 'undefined' ? defaultReportSettingsUrl : '/print/reportSettings' %>" data-no-spa data-group="term-management" data-section="report-settings" data-embed-url="<%= typeof defaultReportSettingsUrl !== 'undefined' ? defaultReportSettingsUrl : '/print/reportSettings' %>" data-embed-label="Report Settings">
                <span class="nav-link-icon"><svg fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path d="M12 15a3 3 0 100-6 3 3 0 000 6z"/><path d="M19.4 15a1.65 1.65 0 00.33 1.82l.06.06a2 2 0 11-2.83 2.83l-.06-.06a1.65 1.65 0 00-1.82-.33 1.65 1.65 0 00-1 1.51V21a2 2 0 11-4 0v-.09a1.65 1.65 0 00-1-1.51 1.65 1.65 0 00-1.82.33l-.06.06a2 2 0 11-2.83-2.83l.06-.06a1.65 1.65 0 00.33-1.82 1.65 1.65 0 00-1.51-1H3a2 2 0 110-4h.09a1.65 1.65 0 001.51-1 1.65 1.65 0 00-.33-1.82l-.06-.06a2 2 0 112.83-2.83l.06.06a1.65 1.65 0 001.82.33H9a1.65 1.65 0 001-1.51V3a2 2 0 114 0v.09a1.65 1.65 0 001 1.51 1.65 1.65 0 001.82-.33l.06-.06a2 2 0 112.83 2.83l-.06.06a1.65 1.65 0 00-.33 1.82V9a1.65 1.65 0 001.51 1H21a2 2 0 110 4h-.09a1.65 1.65 0 00-1.51 1z"/></svg></span>
                <span>Report Settings</span>
              </a>
            </li>
          </ul>
        </li>
        <li>
          <a class="nav-link" href="/common/activityLogs" data-no-spa data-section="activity-logs" data-embed-url="/common/activityLogs" data-embed-label="View Activity Logs">
            <span class="nav-link-icon"><svg fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2"/><rect x="9" y="3" width="6" height="4" rx="1"/><path d="M9 12h6M9 16h4"/></svg></span>
            <span>Activity Logs</span>
          </a>
        </li>
      </ul>
    </nav>

    <!-- Main Content -->
    <main class="hub-main">
      <% if (hasOrgStats) { %>
      <section class="hub-section active" id="org-stats">
        <div class="embed-panel-body">
          <div class="embed-placeholder">
            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
            <p>Loading Organization Stats…</p>
          </div>
        </div>
      </section>
      <% } %>

      <section class="hub-section<%= hasOrgStats ? '' : ' active' %>" id="term-management">
        <div class="embed-panel-body">
          <div class="embed-placeholder">
            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
            <p>Choose a report from the menu on the left.</p>
          </div>
        </div>
      </section>



      <section class="hub-section" id="report-settings">
        <div class="embed-panel-body">
          <div class="embed-placeholder">
            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path d="M12 15a3 3 0 100-6 3 3 0 000 6z"/></svg>
            <p>Loading Report Settings…</p>
          </div>
        </div>
      </section>

      <section class="hub-section" id="activity-logs">
        <div class="embed-panel-body">
          <div class="embed-placeholder">
            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4"/></svg>
            <p>Loading Activity Logs…</p>
          </div>
        </div>
      </section>
    </main>
  </div>
</div>

<script>
  (function initHubMenu() {
    const navLinks = document.querySelectorAll('.nav-link');
    const sections = document.querySelectorAll('.hub-section');
    const navToggle = document.getElementById('hub-nav-toggle');
    const nav = document.getElementById('hub-nav');
    const navClose = document.getElementById('hub-nav-close');
    const overlay = document.getElementById('hub-nav-overlay');
    const navCollapseToggle = document.getElementById('hub-nav-collapse-toggle');
    const layout = document.getElementById('hub-layout');

    const setNavOpen = isOpen => {
      nav.classList.toggle('open', isOpen);
      overlay.classList.toggle('show', isOpen && window.innerWidth > 900);
      navToggle.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
    };

    // Desktop-only icon-rail collapse. Remembered across page loads so the
    // hub doesn't jump back to the wide sidebar every time an embedded
    // panel link reloads this page.
    const NAV_COLLAPSE_STORAGE_KEY = 'managira-hub-nav-collapsed';
    if (navCollapseToggle && nav && layout) {
      const setNavCollapsed = isCollapsed => {
        nav.classList.toggle('is-collapsed', isCollapsed);
        layout.classList.toggle('is-nav-collapsed', isCollapsed);
        navCollapseToggle.setAttribute('aria-expanded', isCollapsed ? 'false' : 'true');
        navCollapseToggle.setAttribute('title', isCollapsed ? 'Expand sidebar' : 'Collapse sidebar');
      };

      let storedCollapsed = false;
      try {
        storedCollapsed = localStorage.getItem(NAV_COLLAPSE_STORAGE_KEY) === '1';
      } catch (_) {}
      setNavCollapsed(storedCollapsed);

      navCollapseToggle.addEventListener('click', () => {
        const isCollapsed = !nav.classList.contains('is-collapsed');
        setNavCollapsed(isCollapsed);
        try {
          localStorage.setItem(NAV_COLLAPSE_STORAGE_KEY, isCollapsed ? '1' : '0');
        } catch (_) {}
      });
    }

    if (!navToggle || !nav || !overlay) return;

    if (navToggle.dataset.spaMenuBound === '1') return;
    navToggle.dataset.spaMenuBound = '1';

    // Tracks whichever panel is currently on-screen, so the load handler
    // below knows it's safe to update the address bar when that panel's
    // iframe navigates internally (e.g. clicking a link inside it) — a
    // background-preloaded panel's internal navigation must never touch
    // the URL, since the user isn't looking at it.
    let activeGroup = null;

    // Marks the given section + its sidebar entry active, and (for the
    // expandable Term Reports group) opens/closes its submenu to match.
    function activateSectionOnly(sectionId) {
      activeGroup = sectionId;
      const navLink = document.querySelector(`.nav-link[data-section="${sectionId}"]`)
        || (function () {
          // A dropdown item's own panel: its dropdown header stands in.
          const sub = document.querySelector(`.nav-sublink[data-section="${sectionId}"]`);
          const menu = sub && sub.closest('.nav-submenu');
          return menu ? menu.parentElement.querySelector('.nav-group-toggle') : null;
        })();

      navLinks.forEach(l => l.classList.remove('active'));
      if (navLink) navLink.classList.add('active');

      sections.forEach(s => s.classList.remove('active'));
      const targetSection = document.getElementById(sectionId);
      if (targetSection) targetSection.classList.add('active');

      document.querySelectorAll('.nav-group-toggle').forEach(toggle => {
        const isThisGroup = toggle === navLink;
        toggle.setAttribute('aria-expanded', isThisGroup ? 'true' : 'false');
        const submenu = toggle.parentElement.querySelector('.nav-submenu');
        if (submenu) submenu.classList.toggle('open', isThisGroup);
      });

      if (window.innerWidth <= 900) {
        setNavOpen(false);
      }
    }

    function setEmbedLinkActive(url) {
      document.querySelectorAll('.nav-link, .nav-sublink').forEach(l => l.classList.remove('active'));
      const matches = document.querySelectorAll(`[data-embed-url="${CSS.escape(url)}"]`);
      matches.forEach(l => l.classList.add('active'));
      // A page opened from inside a panel (e.g. Archived Students from
      // Graduate / Archive) keeps its section highlighted.
      if (!matches.length && activeGroup) {
        const sectionLink = document.querySelector(`.nav-link[data-section="${activeGroup}"]`);
        if (sectionLink) sectionLink.classList.add('active');
      }
    }

    // Each destination is its own full standalone page with its own <head>
    // styles and breakpoints (not a fragment meant to be pasted into another
    // page). Loading it in a same-origin iframe — instead of fetching the
    // HTML and injecting it into this page — means it renders exactly as it
    // would in its own tab: its CSS/JS never collides with ours, and its
    // responsive layout reacts to its own real rendering width instead of
    // getting confused by being squeezed into a foreign container.
    // Adds ?embed=workspace to the target URL. The destination controllers
    // recognize this flag (same convention already used elsewhere in the
    // app) and skip rendering the global header/footer/chatbot for that
    // request, since this page already has its own.
    function withEmbedFlag(url) {
      const separator = url.includes('?') ? '&' : '?';
      return url + separator + 'embed=workspace';
    }

    // Inverse of withEmbedFlag — used to read back the iframe's *current*
    // location (after it has navigated internally, e.g. following a link)
    // as a clean, storable URL, stripped of the embed marker we added.
    // Guards against "about:blank" (the browser's own placeholder for an
    // iframe that hasn't finished navigating yet) so a load event racing
    // ahead of the real navigation can never get captured as a real page.
    // A pane whose page moved on (a link inside it, e.g. a report card) keeps its
    // src; clicking its menu item again brings it back to the section's page.
    function paneMovedAway(iframe, url) {
      try {
        const now = iframe.contentWindow && iframe.contentWindow.location.href;
        if (!now || now === 'about:blank') return false;
        const at = new URL(stripEmbedFlag(now), window.location.href);
        const home = new URL(url, window.location.href);
        return at.pathname !== home.pathname; // filters (the query) may change in place
      } catch (_) {
        return false;
      }
    }

    function stripEmbedFlag(href) {
      if (!href || href === 'about:blank') return null;
      try {
        const parsed = new URL(href, window.location.href);
        parsed.searchParams.delete('embed');
        return parsed.pathname + parsed.search + parsed.hash;
      } catch (err) {
        return null;
      }
    }

    // Full-page dashboards were never designed to render squeezed inside a
    // hub panel — if an embedded page's own navigation (a redirect, a link)
    // ever lands on one of these, break all the way out to a real top-level
    // page load instead of leaving it stuck inside the iframe. Returns true
    // if it fired, so the caller can skip its own iframe-specific handling.
    function escapeIframeForFullPageDashboard(href) {
      if (!href) return false;
      if (/^\/common\/(orgDashboard|publicDashboard)(?:[/?]|$)/.test(href)) {
        window.top.location.href = href;
        return true;
      }
      return false;
    }

    // Same-origin — nudge the loaded page to sit flush left instead of
    // centered with wide side margins, now that it has the full panel
    // width to itself and no longer needs to leave room for a header.
    function leftAlignEmbeddedDoc(iframe) {
      try {
        const doc = iframe.contentDocument;
        if (doc && doc.head && !doc.getElementById('__hub-left-align')) {
          const style = doc.createElement('style');
          style.id = '__hub-left-align';
          style.textContent = 'body{margin-left:0 !important;} main{margin-left:0 !important; margin-right:0 !important;}';
          doc.head.appendChild(style);
        }
      } catch (err) {
        // Cross-origin — nothing more we can do.
      }
    }

    // Watches for the iframe navigating to a NEW document — same-origin
    // pages inside it (Save buttons, switching classes, etc.) trigger real
    // navigations we don't otherwise get a callback for. pagehide fires
    // right as that starts, so we can show the spinner again immediately
    // instead of leaving a frozen-looking page until the next one arrives.
    // (Deliberately NOT beforeunload: a beforeunload listener on ANY frame
    // — including a subframe like this iframe — disqualifies the whole
    // top-level hub page from the browser's back-forward cache, forcing a
    // full reload every time a user leaves for a full-page destination and
    // clicks Back.)
    function watchForInternalNavigation(iframe, overlay) {
      try {
        const win = iframe.contentWindow;
        if (!win) return;
        win.addEventListener('pagehide', function() {
          overlay.hidden = false;
        });
      } catch (err) {
        // Cross-origin — nothing more we can do.
      }
    }

    // Keeps track of which URL is currently loaded (and cached, ready to
    // reuse) in each panel's iframe, so switching between sections you've
    // already visited is instant instead of re-fetching and re-rendering
    // every single time.
    const loadedPanelUrls = {};

    // Remembers the sidebar label for whichever URL is currently loaded in
    // each panel, so the polling backstop below can rebuild a proper hub
    // URL (with a human-readable label) without having to guess one.
    const panelLabels = {};

    // Backstop that keeps the address bar honest even when a single 'load'
    // event isn't enough to catch it — multi-step redirects inside the
    // embedded page, or a browser quirk around the timing of that event,
    // can otherwise leave the URL pointing at a stale page. This just
    // samples the truth every second: if the panel you're actually looking
    // at has navigated somewhere new (same-origin, so we can read it),
    // sync the address bar to match. Background-preloaded panels are never
    // touched since activeGroup only ever names the one on-screen.
    setInterval(function () {
      if (!activeGroup) return;
      const panel = document.querySelector('#' + activeGroup + ' .embed-panel-body');
      if (!panel) return;
      const iframe = panel.querySelector('.embed-iframe');
      if (!iframe) return;

      let currentHref;
      try {
        currentHref = stripEmbedFlag(iframe.contentWindow.location.href);
      } catch (err) {
        return; // Cross-origin — nothing more we can do.
      }
      if (!currentHref || loadedPanelUrls[activeGroup] === currentHref) return;
      if (escapeIframeForFullPageDashboard(currentHref)) return;

      loadedPanelUrls[activeGroup] = currentHref;
      const label = panelLabels[activeGroup];
      const hubUrl = '/common/reports?panel=' + encodeURIComponent(activeGroup)
        + '&page=' + encodeURIComponent(currentHref)
        + (label ? '&label=' + encodeURIComponent(label) : '');
      history.replaceState({ embedGroup: activeGroup, embedUrl: currentHref, embedLabel: label }, '', hubUrl);
    }, 1000);

    function loadEmbed(group, url, label, pushHistory, background) {
      if (escapeIframeForFullPageDashboard(url)) return;
      if (label) panelLabels[group] = label;
      const panel = document.querySelector('#' + group + ' .embed-panel-body');
      if (!panel) {
        if (!background) window.location.href = url;
        return;
      }

      // Already loaded in this panel — just make sure it's the visible/
      // active one and skip straight past the fetch + spinner entirely.
      if (loadedPanelUrls[group] === url && panel.querySelector('.embed-iframe') && !paneMovedAway(panel.querySelector('.embed-iframe'), url)) {
        if (!background) {
          setEmbedLinkActive(url);
          if (pushHistory !== false) {
            const hubUrl = '/common/reports?panel=' + encodeURIComponent(group)
              + '&page=' + encodeURIComponent(url)
              + (label ? '&label=' + encodeURIComponent(label) : '');
            history.pushState({ embedGroup: group, embedUrl: url, embedLabel: label }, '', hubUrl);
          }
        }
        return;
      }

      // A silent background preload only ever needs to happen once per
      // panel — if something's already mid-flight (or finished) in there,
      // leave it alone instead of restarting the load.
      if (background && panel.querySelector('.embed-iframe')) return;

      // A load for this exact URL in this exact panel is already in flight
      // — most often the background preload queue got to it but hasn't
      // finished yet, and the user clicked over before it did. Its own
      // 'load' listener (already attached) will finish the job: hide the
      // spinner, reveal the iframe, and record it in loadedPanelUrls.
      // Tearing it down here to "start fresh" would throw away that
      // progress and force a whole second fetch — exactly what made
      // switching to a panel feel like it never learned to cache itself.
      // Just surface it and let it land. (Scoped to the same target URL
      // only — if the panel's existing iframe has since navigated
      // somewhere else internally, e.g. drilled into a sub-page, this nav
      // click should still reset it back to its own canonical page like
      // normal, not leave the sub-page showing.)
      const inFlightIframe = panel.querySelector('.embed-iframe');
      const inFlightMatchesTarget = inFlightIframe
        && inFlightIframe.src === new URL(withEmbedFlag(url), window.location.href).href
        && !paneMovedAway(inFlightIframe, url);
      if (inFlightMatchesTarget) {
        if (!background) {
          setEmbedLinkActive(url);
          if (pushHistory !== false) {
            const hubUrl = '/common/reports?panel=' + encodeURIComponent(group)
              + '&page=' + encodeURIComponent(url)
              + (label ? '&label=' + encodeURIComponent(label) : '');
            history.pushState({ embedGroup: group, embedUrl: url, embedLabel: label }, '', hubUrl);
          }
          if (inFlightIframe.style.display === 'none') {
            const overlay = panel.querySelector('.embed-overlay-spinner');
            if (overlay) overlay.hidden = false;
          }
        }
        return;
      }

      if (background) {
        // Clear out the static placeholder without showing a spinner —
        // nothing here is visible yet, it's just warming up for later.
        panel.innerHTML = '';
      } else {
        setEmbedLinkActive(url);
        panel.innerHTML = '<div class="embed-loading"><span class="btn-spinner" aria-hidden="true"></span>Loading ' + (label || 'page') + '…</div>';
      }

      const iframe = document.createElement('iframe');
      iframe.className = 'embed-iframe';
      iframe.title = label || 'Embedded page';
      iframe.style.display = 'none';

      const overlay = document.createElement('div');
      overlay.className = 'embed-overlay-spinner';
      overlay.hidden = true;
      overlay.innerHTML = '<span class="btn-spinner" aria-hidden="true"></span>Loading…';

      iframe.addEventListener('load', function onLoad() {
        // The very first "load" a freshly-inserted iframe fires can be for
        // the browser's own "about:blank" placeholder, racing ahead of the
        // real navigation we asked for — ignore it completely so it never
        // gets treated as the real page (it has no relation to `url`).
        if (iframe.contentWindow && iframe.contentWindow.location.href === 'about:blank') {
          return;
        }

        try {
          const landedOn = stripEmbedFlag(iframe.contentWindow.location.href) || '';
          // A page preloading in the background that sends you to the
          // dashboard (no access, for example) is dropped quietly instead of
          // taking over the window.
          if (background && group !== activeGroup && /^\/common\/(orgDashboard|publicDashboard)(?:[/?]|$)/.test(landedOn)) {
            iframe.remove();
            overlay.remove();
            delete loadedPanelUrls[group];
            return;
          }
          if (escapeIframeForFullPageDashboard(landedOn)) return;
        } catch (err) {
          // Cross-origin — nothing more we can do.
        }

        const loading = panel.querySelector('.embed-loading');
        if (loading) loading.remove();
        iframe.style.display = 'block';
        overlay.hidden = true;
        leftAlignEmbeddedDoc(iframe);
        watchForInternalNavigation(iframe, overlay);

        // The iframe may have landed here via its OWN internal navigation
        // (a link clicked inside the embedded page), not just our initial
        // load — same-origin, so we can read its real current location.
        // Re-sync our URL/cache to wherever it actually ended up, so a
        // refresh of the hub page lands back on THIS page instead of
        // snapping back to whatever was first opened in this panel.
        try {
          const currentHref = stripEmbedFlag(iframe.contentWindow.location.href);
          if (currentHref && currentHref !== url) {
            url = currentHref;
            if (!background && group === activeGroup) {
              const hubUrl = '/common/reports?panel=' + encodeURIComponent(group)
                + '&page=' + encodeURIComponent(url)
                + (label ? '&label=' + encodeURIComponent(label) : '');
              history.replaceState({ embedGroup: group, embedUrl: url, embedLabel: label }, '', hubUrl);
            }
          }
        } catch (err) {
          // Cross-origin — nothing more we can do, keep the original url.
        }

        // Only cache it as "ready to reuse" once it's actually finished
        // loading successfully — never on a page that's still in flight.
        loadedPanelUrls[group] = url;
      });

      iframe.addEventListener('error', function() {
        delete loadedPanelUrls[group];
        panel.innerHTML = '<div class="embed-error">Could not load this here. '
          + '<a href="' + url + '" data-no-spa>Open it directly instead</a>.</div>';
      });

      // Set the real destination BEFORE inserting the iframe into the
      // document — appending a src-less iframe first is what queues that
      // spurious "about:blank" load in some browsers; giving it a src up
      // front means the only navigation that ever happens is the real one.
      iframe.src = withEmbedFlag(url);
      panel.appendChild(iframe);
      panel.appendChild(overlay);

      if (pushHistory !== false) {
        // Keep the visible address on /common/reports (with the open panel
        // encoded as query params) instead of the real destination URL —
        // otherwise a refresh reloads that destination as its own bare
        // top-level page instead of staying inside the Reports hub.
        const hubUrl = '/common/reports?panel=' + encodeURIComponent(group)
          + '&page=' + encodeURIComponent(url)
          + (label ? '&label=' + encodeURIComponent(label) : '');
        history.pushState({ embedGroup: group, embedUrl: url, embedLabel: label }, '', hubUrl);
      }
    }

    // Top-level items: the ones with a single destination (Organization
    // Stats, Activity Logs) are plain links — clicking
    // activates their panel and loads the page straight into it. Term
    // Reports has no destination of its own — clicking it only expands or
    // collapses its submenu and never touches the right panel; whatever
    // was showing there stays exactly as it was until one of the three
    // items underneath it is actually clicked.
    navLinks.forEach(link => {
      link.addEventListener('click', function(e) {
        if (this.classList.contains('nav-group-toggle')) {
          e.preventDefault();
          const submenu = this.parentElement.querySelector('.nav-submenu');
          if (!submenu) return;
          const nowOpen = !submenu.classList.contains('open');
          submenu.classList.toggle('open', nowOpen);
          this.setAttribute('aria-expanded', nowOpen ? 'true' : 'false');
          return;
        }

        e.preventDefault();
        const sectionId = this.getAttribute('data-section');
        const embedUrl = this.getAttribute('data-embed-url');
        const embedLabel = this.getAttribute('data-embed-label');
        activateSectionOnly(sectionId);
        if (embedUrl) {
          loadEmbed(sectionId, embedUrl, embedLabel);
        }
      });
    });

    document.querySelectorAll('.nav-sublink').forEach(link => {
      link.addEventListener('click', function(e) {
        e.preventDefault();
        const url = this.getAttribute('data-embed-url') || this.getAttribute('href');
        // Each item has its own panel (so it can stay loaded); older items
        // share their dropdown's panel.
        const group = this.getAttribute('data-section') || this.getAttribute('data-group');
        const label = this.getAttribute('data-embed-label') || this.textContent.trim();
        if (!url || !group) return;

        activateSectionOnly(group);
        loadEmbed(group, url, label);
      });
    });


    // Mobile navigation toggle
    navToggle.addEventListener('click', function(e) {
      e.stopPropagation();
      setNavOpen(!nav.classList.contains('open'));
    });

    navClose.addEventListener('click', function(e) {
      e.stopPropagation();
      setNavOpen(false);
    });

    overlay.addEventListener('click', function(e) {
      e.stopPropagation();
      setNavOpen(false);
    });

    document.addEventListener('click', function(e) {
      if (window.innerWidth > 900 || !nav.classList.contains('open')) return;
      if (nav.contains(e.target) || navToggle.contains(e.target)) return;
      setNavOpen(false);
    });

    window.addEventListener('resize', function() {
      if (window.innerWidth > 900) setNavOpen(false);
    });

    window.addEventListener('popstate', function(e) {
      const state = e.state;
      if (state && state.embedGroup && state.embedUrl) {
        activateSectionOnly(state.embedGroup);
        loadEmbed(state.embedGroup, state.embedUrl, state.embedLabel, false);
        return;
      }

      // Back past the first panel we opened — fall back to whatever the
      // URL's own query params say, or the default section if there are
      // none, rather than leaving the old panel showing.
      const params = new URLSearchParams(window.location.search);
      const panel = params.get('panel');
      const page = params.get('page');
      if (panel && page && document.getElementById(panel)) {
        activateSectionOnly(panel);
        loadEmbed(panel, page, params.get('label'), false);
      } else {
        const defaultLink = document.querySelector('.nav-link[data-embed-url]');
        if (defaultLink) {
          activateSectionOnly(defaultLink.getAttribute('data-section'));
          loadEmbed(
            defaultLink.getAttribute('data-section'),
            defaultLink.getAttribute('data-embed-url'),
            defaultLink.getAttribute('data-embed-label'),
            false
          );
        }
      }
    });

    // Restoring this page from the browser's back-forward cache (e.g. after
    // leaving for a full page and clicking Back) resumes every panel iframe
    // exactly as frozen — including any async UI state one of them had
    // mid-flight (a row action showing its own inline "Loading…", a fetch()
    // that was in progress when the tab froze, etc). That request doesn't
    // get a chance to resolve, so the stuck state just comes back looking
    // like it's "loading forever." Throw away every cached panel and force
    // a genuinely fresh reload of whichever one is on screen — the rest
    // will simply reload on demand the next time their nav item is clicked,
    // same as a normal cold visit.
    window.addEventListener('pageshow', function (e) {
      if (!e.persisted) return;
      const activeUrl = activeGroup ? loadedPanelUrls[activeGroup] : null;
      Object.keys(loadedPanelUrls).forEach(function (group) {
        delete loadedPanelUrls[group];
        const panel = document.querySelector('#' + group + ' .embed-panel-body');
        if (panel) panel.innerHTML = '';
      });
      if (activeGroup && activeUrl) {
        loadEmbed(activeGroup, activeUrl, panelLabels[activeGroup], false);
      }
    });

    // On a fresh load (including a refresh), restore whichever panel was
    // open — encoded in the URL's own query params — instead of always
    // falling back to the default section. This is what makes refreshing
    // land back on the Reports hub with the same panel open, rather than
    // on the destination page's own bare, standalone view.
    const restoreParams = new URLSearchParams(window.location.search);
    const restorePanel = restoreParams.get('panel');
    const restorePage = restoreParams.get('page');

    let initialSection = null;
    if (restorePanel && restorePage && document.getElementById(restorePanel)) {
      activateSectionOnly(restorePanel);
      loadEmbed(restorePanel, restorePage, restoreParams.get('label'), false);
      initialSection = restorePanel;
    } else {
      // Load whichever section is active by default on first render.
      const initialActive = document.querySelector('.nav-link.active[data-embed-url]');
      if (initialActive) {
        initialSection = initialActive.getAttribute('data-section');
        loadEmbed(
          initialActive.getAttribute('data-section'),
          initialActive.getAttribute('data-embed-url'),
          initialActive.getAttribute('data-embed-label'),
          false
        );
      }
    }

    // Panels load on intent: pointing at, focusing or touching a menu item
    // starts loading it in its own hidden panel, so the click shows it at
    // once (on a slow or data-saver connection, panels load only when
    // clicked).
    const warmedSections = new Set(typeof initialSection !== 'undefined' && initialSection ? [initialSection] : []);
    function warmPanel(link) {
      const sectionId = link.getAttribute('data-section') || link.getAttribute('data-group');
      const url = link.getAttribute('data-embed-url');
      if (!sectionId || !url || warmedSections.has(sectionId)) return;
      const conn = navigator.connection;
      if (conn && (conn.saveData || /(^|-)2g$/.test(conn.effectiveType || ''))) return;
      warmedSections.add(sectionId);
      loadEmbed(sectionId, url, link.getAttribute('data-embed-label'), false, true);
    }
    document.querySelectorAll('.nav-link[data-embed-url], .nav-sublink[data-embed-url]').forEach(function (link) {
      ['mouseenter', 'focus', 'touchstart'].forEach(function (type) {
        link.addEventListener(type, function () { warmPanel(link); }, { once: true, passive: true });
      });
    });

    // Once the page you opened has loaded, the other pages in this menu load
    // one at a time in the background while the browser is idle, and stay
    // loaded, so every later click shows its page at once. Skipped on slow or
    // data-saver connections, paused while the tab is hidden, and limited on
    // low-memory phones.
    (function preloadOtherPanelsWhenIdle() {
      const conn = navigator.connection;
      if (conn && (conn.saveData || /(^|-)2g$/.test(conn.effectiveType || ''))) return;
      const lowMemory = typeof navigator.deviceMemory === 'number' && navigator.deviceMemory < 4;
      let budget = lowMemory ? 3 : Infinity;
      const links = Array.from(document.querySelectorAll('.nav-link[data-embed-url], .nav-sublink[data-embed-url]'));
      const idle = (fn) => (window.requestIdleCallback ? window.requestIdleCallback(fn, { timeout: 2500 }) : setTimeout(fn, 400));
      const loaded = (sectionId) => new Promise((resolve) => {
        const started = Date.now();
        (function check() {
          if (loadedPanelUrls[sectionId] || Date.now() - started > 12000) return resolve();
          setTimeout(check, 200);
        })();
      });
      const whenVisible = () => new Promise((resolve) => {
        if (!document.hidden) return resolve();
        document.addEventListener('visibilitychange', function onVis() {
          if (document.hidden) return;
          document.removeEventListener('visibilitychange', onVis);
          resolve();
        });
      });
      async function run() {
        if (activeGroup) await loaded(activeGroup);
        for (const link of links) {
          if (budget <= 0) return;
          const sectionId = link.getAttribute('data-section') || link.getAttribute('data-group');
          if (!sectionId || warmedSections.has(sectionId)) continue;
          await whenVisible();
          await new Promise((resolve) => idle(resolve));
          if (warmedSections.has(sectionId)) continue;
          warmPanel(link);
          budget -= 1;
          await loaded(sectionId);
        }
      }
      setTimeout(run, 600);
    })();
  })();
</script>
<script src="<%= assetUrl('/js/panelFreshness.js') %>" defer></script>
