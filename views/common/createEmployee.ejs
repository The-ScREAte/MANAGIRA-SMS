<head>
  <style>
    :root {
      --font-family: "<%= (session && session.fontStyle ? String(session.fontStyle).trim() : 'Inter') %>", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
      --primary: var(--org-primary-color, #01535b);
      --primary-hover: var(--org-primary-hover, #014a51);
        --primary-hover-fill: color-mix(in srgb, var(--primary) 88%, white);
      --primary-light: rgba(1, 83, 91, 0.08);
      --text-primary: #1e293b;
      --text-secondary: #64748b;
      --border: #e2e8f0;
      --bg-page: #f8fafc;
      --bg-card: #ffffff;
      --error: #dc2626;
      --success: #059669;
      --info-bg: #e7f3fe;
      --info-text: #0c5460;
    }

    body {
      font-family: var(--font-family);
      background: var(--bg-page);
    }

    .create-employee-page {
      max-width: 720px;
      margin: 0 auto;
      padding: 12px 12px 66px;
    }

    /* Flat, full-bleed toolbar fixed to the bottom of the drawer's own
       viewport — deliberately NOT styled as a rounded/bordered card like
       .form-card above it, so it reads as a persistent action dock rather
       than a second floating card sitting on the page background. */
    .ce-footer-bar {
      position: fixed;
      left: 0;
      right: 0;
      bottom: 0;
      z-index: 50;
      background: var(--bg-card);
      border-top: 1px solid var(--border);
      box-shadow: 0 -8px 20px rgba(15, 23, 42, 0.06);
      padding: 10px 16px calc(10px + env(safe-area-inset-bottom, 0px));
    }

    /* Global form styles add margins and widths; this form keeps its own rhythm. */
    #createEmployeeForm .form-input,
    #createEmployeeForm .form-select {
      display: block;
      box-sizing: border-box;
      width: 100% !important;
      max-width: none !important;
      height: 36px !important;
      min-height: 36px !important;
      margin: 0 !important;
    }

    #createEmployeeForm .form-group { min-width: 0; }

    #createEmployeeForm .class-checkbox input[type="checkbox"] { flex: 0 0 auto; margin: 0 !important; }

    #createEmployeeForm .class-checkbox label {
      margin: 0 !important;
      padding: 0 !important;
      font-size: 0.82rem;
      font-weight: 500;
      line-height: 1.3;
    }

    #createEmployeeForm .subject-container .class-checkbox label { font-weight: 400; }

    /* The Save bar lives where the floating Setup steps button would sit. */
    .ss-root { display: none !important; }

    .ce-footer-bar .btn-primary {
      width: auto !important;
      min-height: 34px !important;
      height: 34px !important;
      padding: 0 16px !important;
      border-radius: 6px !important;
      font-size: 0.82rem !important;
    }

    .ce-footer-bar-inner {
      display: flex;
      justify-content: flex-start;
      max-width: 720px;
      margin: 0 auto;
    }

    .back-link {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 10px 20px;
      background: #fff;
      color: var(--primary);
      border: 2px solid var(--primary);
      text-decoration: none;
      border-radius: 8px;
      font-weight: 600;
      font-size: 0.9rem;
      transition: all 0.2s;
      margin-bottom: 24px;
    }

    .back-link:hover {
      transform: translateY(-1px);}

    .form-card {
      background: var(--bg-card);
      border-radius: 10px;
      box-shadow: none;
      border: 1px solid var(--border);
      overflow: hidden;
    }

    .form-content {
      padding: 18px 20px;
    }

    .form-group {
      margin-bottom: 12px;
    }

    .form-label {
      display: block;
      font-weight: 600;
      color: var(--text-primary);
      margin-bottom: 4px;
      font-size: 0.78rem;
    }

    /* The form's parts sit apart, each with its own quiet heading. */
    .ce-section {
      margin-top: 20px;
      padding-top: 16px;
      border-top: 1px solid var(--border);
    }

    .ce-section-title {
      margin: 0 0 8px;
      font-size: 0.84rem;
      font-weight: 700;
      color: var(--text-primary);
    }

    .form-input,
    .form-select {
      width: 100%;
      height: 36px;
      padding: 6px 10px;
      border: 1px solid var(--border);
      border-radius: 6px;
      font-size: 0.86rem;
      font-family: inherit;
      transition: all 0.2s ease;
      background: var(--bg-card);
      color: var(--text-primary);
    }

    .form-input:focus,
    .form-select:focus {
      outline: none;
      border-color: var(--primary);
      box-shadow: 0 0 0 2px var(--primary-light);
    }

    .form-row {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 12px;
    }

    @media (max-width: 500px) {
      .form-row {
        grid-template-columns: 1fr;
      }

      .permissions-grid {
        grid-template-columns: 1fr;
      }
    }

    @media (max-width: 480px) {
      .form-content {
        padding: 18px 16px;
      }

      .btn-primary {
        padding: 9px 14px;
        font-size: 0.85rem;
      }

      .ce-footer-bar {
        padding: 8px 12px calc(8px + env(safe-area-inset-bottom, 0px));
      }

      .collapsible-btn {
        padding: 10px 12px;
        font-size: 0.875rem;
      }
    }


    .section-title {
      font-size: 1rem;
      font-weight: 700;
      color: var(--text-primary);
      margin-bottom: 12px;
    }

    .collapsible-btn {
      width: 100%;
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 12px 14px;
      background: #f3f4f6;
      color: var(--text-primary);
      border: 1px solid var(--border);
      border-radius: 8px;
      font-size: 0.92rem;
      font-weight: 600;
      cursor: pointer;
      transition: all 0.2s;
    }

    

    .collapsible-btn .arrow {
      color: var(--primary);
      font-weight: 700;
    }

    .collapsible-content {
      background: #fff;
      border: 1px solid var(--border);
      border-radius: 6px;
      padding: 2px 10px;
      margin-top: 6px;
    }

    .class-checkbox {
      display: flex;
      align-items: center;
      gap: 8px;
      padding: 6px 0;
      border-bottom: 1px solid var(--border);
    }

    .class-checkbox:last-child {
      border-bottom: none;
    }

    .class-checkbox input[type="checkbox"] {
      width: 15px;
      height: 15px;
      accent-color: var(--primary);
      cursor: pointer;
    }

    .class-checkbox label {
      font-size: 0.82rem;
      cursor: pointer;
    }

    .subject-container {
      margin: 2px 0 6px 23px;
      padding: 2px 10px;
      background: #f8fafc;
      border-radius: 6px;
      border: 1px solid var(--border);
    }

    .permissions-box {
      background: #f8fafc;
      border: 1px solid var(--border);
      border-radius: 10px;
      padding: 14px;
      margin-top: 8px;
    }

    .permissions-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 10px 16px;
    }

    .permission-item {
      display: flex;
      align-items: center;
      gap: 8px;
      font-size: 0.92rem;
      color: var(--text-primary);
    }

    .permission-item input[type="checkbox"] {
      width: 16px;
      height: 16px;
      accent-color: var(--primary);
    }

    .permissions-note {
      margin-top: 8px;
      color: var(--text-secondary);
      font-size: 0.82rem;
    }

    .mailroom-scope-panel {
      margin-top: 12px;
      padding: 12px 14px;
      background: #fff;
      border: 1px solid var(--border);
      border-radius: 8px;
    }

    .mailroom-scope-title {
      font-size: 0.82rem;
      font-weight: 700;
      color: var(--text-primary);
      margin-bottom: 8px;
    }

    .mailroom-scope-option {
      display: flex;
      align-items: center;
      gap: 7px;
      font-size: 0.88rem;
      color: var(--text-primary);
      margin-bottom: 6px;
    }

    .mailroom-scope-option input[type="radio"] {
      width: 15px;
      height: 15px;
      accent-color: var(--primary);
    }

    .mailroom-classes-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 8px 14px;
      margin: 8px 0 0 22px;
      padding-top: 8px;
      border-top: 1px dashed var(--border);
    }

    .mailroom-class-item {
      display: flex;
      align-items: center;
      gap: 6px;
      font-size: 0.85rem;
      color: var(--text-secondary);
    }

    .mailroom-class-item input[type="checkbox"] {
      width: 14px;
      height: 14px;
      accent-color: var(--primary);
    }

    .btn-primary {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      min-height: 34px;
      padding: 6px 16px;
      background: var(--primary);
      color: white;
      border: none;
      border-radius: 6px;
      font-size: 0.82rem;
      font-weight: 600;
      cursor: pointer;
      transition: all 0.2s ease;
      box-shadow: 0 2px 8px rgba(1, 83, 91, 0.2);
      margin: 0;
    }

    .btn-primary:hover {
      transform: translateY(-2px);
      box-shadow: 0 6px 20px rgba(1, 83, 91, 0.3);
    }

    .btn-primary:disabled {
      opacity: 0.78;
      cursor: not-allowed;
      transform: none;
      box-shadow: none;
    }

    .btn-spinner {
      width: 16px;
      height: 16px;
      border: 2px solid rgba(255, 255, 255, 0.35);
      border-top-color: #ffffff;
      border-radius: 50%;
      animation: ce-spin 0.75s linear infinite;
      display: none;
      flex-shrink: 0;
    }

    .btn-primary.is-loading .btn-spinner {
      display: inline-block;
    }

    @keyframes ce-spin {
      to { transform: rotate(360deg); }
    }
  </style>
  <script>
    const subjectsCache = new Map();

    console.info('[CreateEmployee:Client] script_initialized', {
      timestamp: new Date().toISOString()
    });

    window.addEventListener('load', () => {
      const classCheckboxCount = document.querySelectorAll('input[name="classes"]').length;
      const permissionCheckboxCount = document.querySelectorAll('input[name="permissions"]').length;
      console.info('[CreateEmployee:Client] window_loaded', {
        classCheckboxCount,
        permissionCheckboxCount,
        readyState: document.readyState,
      });
    });

    function toggleClassCollapse(id) {
      const collapseDiv = document.getElementById('collapse-' + id);
      const arrow = document.getElementById('arrow-' + id);
      if (collapseDiv.style.display === 'none') {
        collapseDiv.style.display = 'block';
        arrow.innerHTML = '▾';
      } else {
        collapseDiv.style.display = 'none';
        arrow.innerHTML = '▸';
      }
    }

    async function fetchSubjects(classId, containerId) {
      const startedAt = performance.now();
      console.info('[CreateEmployee:Client] fetch_subjects_start', { classId, containerId });

      const renderSubjects = (subjects) => {
        const container = document.getElementById(containerId);
        container.innerHTML = "";

        if (subjects.length > 0) {
          const selectAllDiv = document.createElement("div");
          selectAllDiv.className = "class-checkbox";
          selectAllDiv.innerHTML = `
            <input type="checkbox" id="selectAllSubjects-${classId}"
              onchange="document.querySelectorAll('#${containerId} input[type=checkbox]').forEach(cb => cb.checked = this.checked)">
            <label><strong>Select All Subjects</strong></label>
          `;
          container.appendChild(selectAllDiv);

          subjects.forEach(subject => {
            const div = document.createElement("div");
            div.className = "class-checkbox";
            div.innerHTML = `
              <input type="checkbox" name="subjects" value="${subject.subject_id}" id="subject-${subject.subject_id}">
              <label for="subject-${subject.subject_id}">${subject.subject_name}</label>
            `;
            container.appendChild(div);
          });
        } else {
          container.innerHTML = "<p style='color: #64748b; font-size: 0.9rem;'>No subjects available for this class.</p>";
        }
      };

      try {
        if (subjectsCache.has(classId)) {
          renderSubjects(subjectsCache.get(classId));
          return;
        }

        const response = await fetch(`/common/getSubjectsByClass?classId=${classId}`);
        const subjects = await response.json();
        subjectsCache.set(classId, subjects);
        renderSubjects(subjects);

        console.info('[CreateEmployee:Client] fetch_subjects_success', {
          classId,
          subjectCount: subjects.length,
          elapsedMs: Math.round(performance.now() - startedAt),
        });
      } catch (error) {
        console.error("Error fetching subjects:", error);
        console.error('[CreateEmployee:Client] fetch_subjects_failed', {
          classId,
          elapsedMs: Math.round(performance.now() - startedAt),
          message: error.message,
        });
      }
    }

    function toggleSubjects(classId, containerId) {
      const container = document.getElementById(containerId);
      const checkbox = document.querySelector(`input[name="classes"][value="${classId}"]`);
      const accountTypeSelect = document.getElementById("account_type");
      const isDriver = accountTypeSelect && accountTypeSelect.value === "Driver";

      if (!checkbox.checked) {
        container.style.display = "none";
        return;
      }

      if (isDriver) {
        container.innerHTML = "<p style='color: #64748b; font-size: 0.85rem;'>Drivers are not assigned subjects.</p>";
        container.style.display = "block";
        return;
      }

      fetchSubjects(classId, containerId);
      container.style.display = "block";
    }

    document.addEventListener("DOMContentLoaded", () => {
      const accountTypeSelect = document.getElementById("account_type");
      const permissionGroup = document.getElementById("permission-assignment-group");
      const permissionsNote = document.getElementById("permissionsNote");
      const driverPermissionsNote = document.getElementById("driverPermissionsNote");
      const driverSubjectsNote = document.getElementById("driverSubjectsNote");

      // Role → default permission keys map (injected server-side)
      const ROLE_DEFAULT_PERMISSIONS_MAP = <%- JSON.stringify(roleDefaultPermissionsMap || {}) %>;

      // Mailroom's contact-scope sub-panel only matters once "Mailroom" is
      // checked, and the class picker only matters once "classes" scope is
      // chosen — keep both hidden otherwise so the form stays uncluttered.
      const mailroomScopePanel = document.getElementById("mailroomScopePanel");
      const mailroomClassesGrid = document.getElementById("mailroomClassesGrid");
      const syncMailroomScopePanel = () => {
        if (!mailroomScopePanel) return;
        const mailroomCheckbox = document.querySelector('input[name="permissions"][value="mailroom"]');
        const isMailroomChecked = Boolean(mailroomCheckbox && mailroomCheckbox.checked);
        mailroomScopePanel.style.display = isMailroomChecked ? "block" : "none";
        const classesRadio = mailroomScopePanel.querySelector('input[name="mailroomScope"][value="classes"]');
        if (mailroomClassesGrid) {
          mailroomClassesGrid.style.display = isMailroomChecked && classesRadio && classesRadio.checked ? "grid" : "none";
        }
      };
      document.addEventListener("change", (e) => {
        if (e.target.matches('input[name="permissions"][value="mailroom"], input[name="mailroomScope"]')) {
          syncMailroomScopePanel();
        }
      });

      const syncPermissionVisibility = () => {
        if (!accountTypeSelect || !permissionGroup) return;
        permissionGroup.style.display = "block";

        const selectedRole = accountTypeSelect.value;
        const isDriver = selectedRole === "Driver";
        const defaults = ROLE_DEFAULT_PERMISSIONS_MAP[selectedRole] || [];

        // Drivers get no school-management permissions, so the list hides for them.
        document.querySelectorAll('input[name="permissions"]').forEach((cb) => {
          const item = cb.closest(".permission-item");
          if (isDriver) {
            cb.checked = false;
          } else {
            if (item) item.style.display = "";
            cb.checked = defaults.includes(cb.value);
          }
        });

        document.getElementById("permissionPicker").hidden = isDriver;
        if (window.ManagiraPermissionPicker) window.ManagiraPermissionPicker.refresh();
        if (permissionsNote) permissionsNote.style.display = isDriver ? "none" : "block";
        if (driverPermissionsNote) driverPermissionsNote.style.display = isDriver ? "block" : "none";
        if (driverSubjectsNote) driverSubjectsNote.style.display = isDriver ? "block" : "none";

        // Re-render any already-open subject containers for the new role.
        document.querySelectorAll('input[name="classes"]:checked').forEach((cb) => {
          const containerId = `subjects-container-${cb.value}`;
          toggleSubjects(cb.value, containerId);
        });

        syncMailroomScopePanel();
      };

      if (accountTypeSelect) {
        accountTypeSelect.addEventListener("change", () => {
          syncPermissionVisibility();
        });
      }
      syncPermissionVisibility();

      const form = document.getElementById("createEmployeeForm");
      if (form) {
        const submitButton = document.querySelector('button[type="submit"][form="createEmployeeForm"]');
        const submitLabel = submitButton ? submitButton.querySelector('.btn-label') : null;

        const setSubmittingState = () => {
          if (!submitButton) return;
          submitButton.disabled = true;
          submitButton.classList.add('is-loading');
          submitButton.setAttribute('aria-busy', 'true');
          if (submitLabel) submitLabel.textContent = 'Creating Employee...';
        };

        form.addEventListener("submit", function(e) {
          if (form.dataset.submitting === 'true') {
            e.preventDefault();
            return;
          }

          const selectedPermissions = document.querySelectorAll('input[name="permissions"]:checked').length;
          const selectedClasses = document.querySelectorAll('input[name="classes"]:checked').length;
          const selectedSubjects = document.querySelectorAll('input[name="subjects"]:checked').length;
          console.info('[CreateEmployee:Client] submit_attempt', {
            selectedPermissions,
            selectedClasses,
            selectedSubjects,
            accountType: accountTypeSelect ? accountTypeSelect.value : null,
          });

          // The confirmation box below the form replaces a pop-up.
          if (!form.querySelector('input[name="accessAcknowledged"]:checked')) {
            e.preventDefault();
            return;
          }

          form.dataset.submitting = 'true';
          setSubmittingState();
        });
      }
    });
  </script>
</head>
<body>
  <div class="create-employee-page">
  <%- include('../partials/flash') %>

  <div class="form-card">

    <div class="form-content">
      <form id="createEmployeeForm" action="/common/createEmployee<%= (typeof isEmbedded !== 'undefined' && isEmbedded) ? '?embed=workspace' : '' %>" method="post">
        <div class="form-row">
          <div class="form-group">
            <label class="form-label" for="firstName">First Name</label>
            <input type="text" id="firstName" name="firstName" class="form-input" required placeholder="John">
          </div>
          <div class="form-group">
            <label class="form-label" for="lastName">Last Name</label>
            <input type="text" id="lastName" name="lastName" class="form-input" required placeholder="Doe">
          </div>
        </div>

        <div class="form-row">
          <div class="form-group">
            <label class="form-label" for="email">Email Address</label>
            <input type="email" id="email" name="email" class="form-input" required placeholder="john.doe@example.com">
          </div>
          <div class="form-group">
            <label class="form-label" for="dateOfBirth">Date of Birth</label>
            <input type="date" id="dateOfBirth" name="dateOfBirth" class="form-input">
          </div>
        </div>

        <div class="form-group">
          <label class="form-label" for="account_type">Role</label>
          <select id="account_type" name="account_type" class="form-select" required>
            <option value="">-- Select Role --</option>
            <option value="Manager">Manager</option>
            <option value="Supervisor">Supervisor</option>
            <option value="Teacher">Teacher</option>
            <option value="Driver">Driver</option>
          </select>
        </div>

        <div class="ce-section">
          <%- include('../partials/employeeClassesSummary', { classCheckboxName: 'classes' }) %>
          <p class="permissions-note" id="driverSubjectsNote" style="display:none;">Drivers can be assigned classes (e.g. routes they cover) but are never assigned subjects.</p>

          <div class="collapsible-content" id="collapse-all-classes" style="display: none;">
            <% if (!classes.length) { %><p class="permissions-note">This school has no classes yet.</p><% } %>
            <% classes.forEach(cls => { %>
            <div class="class-checkbox">
              <input type="checkbox" name="classes" value="<%= cls.class_id %>"
                id="class_<%= cls.class_id %>"
                onchange="toggleSubjects('<%= cls.class_id %>', 'subjects-container-<%= cls.class_id %>')">
              <label for="class_<%= cls.class_id %>"><%= cls.class_name %></label>
            </div>
            <div id="subjects-container-<%= cls.class_id %>" class="subject-container" style="display: none"></div>
            <% }); %>
          </div>
        </div>

        <div class="ce-section" id="permission-assignment-group">
          <h3 class="ce-section-title">Permissions</h3>
          <%- include('../partials/permissionPicker', { selectedPermissions: [] }) %>
          <div id="permissionsBox">
            <div class="permissions-note" id="permissionsNote">Permissions are pre-selected based on the chosen role. You can add or remove any before saving. High-risk permissions (Billing, Settings) require a Manager account.</div>
            <div class="permissions-note" id="driverPermissionsNote" style="display:none;">Drivers use the Driver dashboard for their routes and riders. They do not get school-management access, so no permissions are set here.</div>
          </div>
        </div>

        <%- include('../partials/employeeAccessAck', { mode: 'create' }) %>
      </form>
    </div>
  </div>
  </div>

  <div class="ce-footer-bar">
    <div class="ce-footer-bar-inner">
      <button type="submit" form="createEmployeeForm" class="btn-primary" data-ack-submit disabled title="Confirm the access below first">
        <span class="btn-spinner" aria-hidden="true"></span>
        <span class="btn-label">Create Employee</span>
      </button>
    </div>
  </div>

  <script>
    // Opened from the dashboard pencil (?classId=…): preselect Teacher and tick that class.
    (function () {
      const classId = new URLSearchParams(window.location.search).get('classId');
      if (!classId || !/^\d+$/.test(classId)) return;
      const box = document.getElementById('class_' + classId);
      if (!box) return;
      const role = document.getElementById('account_type');
      if (role && !role.value) { role.value = 'Teacher'; role.dispatchEvent(new Event('change', { bubbles: true })); }
      const list = document.getElementById('collapse-all-classes');
      if (list && window.ManagiraEmployeeClasses) window.ManagiraEmployeeClasses.setOpen(true);
      if (!box.checked) { box.checked = true; box.dispatchEvent(new Event('change', { bubbles: true })); }
      box.closest('.class-checkbox') && box.closest('.class-checkbox').scrollIntoView({ block: 'center' });
    })();
  </script>

  <script>
    // createEmployee.ejs is a plain POST that redirects back to itself with
    // a flash message — if we land back here (inside the drawer) with a
    // success flash showing, that redirect just happened, so let the
    // parent know a save actually went through (as opposed to a cancel).
    if (window.parent && window.parent !== window && document.querySelector('.flash-message.success')) {
      try {
        window.parent.postMessage({ managiraDrawerSaved: true }, window.location.origin);
      } catch (err) { /* ignore */ }
    }
  </script>
</body>
