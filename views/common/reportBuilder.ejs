<%
  const reportBuilderData = {
    reportTypes: reportTypes || [],
    families: families || [],
    classes: classes || [],
    terms: terms || [],
    savedReports: savedReports || [],
    initialType: initialType || "",
    initialCriteria: typeof initialCriteria !== "undefined" ? initialCriteria : {},
    userEmail: typeof userEmail !== "undefined" ? userEmail : "",
    school: typeof school !== "undefined" ? school : {},
    pageSizes: pageSizes || [25, 50, 100],
  };
  const hourLabel = (hour) => `${hour % 12 || 12}:00 ${hour < 12 ? 'AM' : 'PM'}`;
%>
<link rel="stylesheet" href="<%= assetUrl('/css/reportBuilder.css') %>">

<main class="report-builder-page<%= isEmbeddedFrame ? ' is-embedded' : '' %>">
  <div class="rb-container">
    <!-- The page fills the window: the title and steps never move; only lists and tables scroll. -->
    <div class="rb-top">
    <header class="rb-header">
      <h1>Report Builder</h1>
      <% if (!isEmbeddedFrame) { %>
        <a class="rb-btn rb-btn-light" href="/common/reports">&larr; Reports</a>
      <% } %>
    </header>

    <nav class="rb-stepper" aria-label="Report steps">
      <button class="rb-step" type="button" data-step-nav="1">Select report</button>
      <button class="rb-step" type="button" data-step-nav="2">Columns</button>
      <button class="rb-step" type="button" data-step-nav="3">Criteria</button>
      <button class="rb-step" type="button" data-step-nav="4">Run report</button>
      <button class="rb-step" type="button" data-step-nav="5">Save / export</button>
    </nav>
    </div>

    <!-- Step 1: select -->
    <section class="rb-panel" data-step-panel="1">
      <div class="rb-grid">
        <section class="rb-card">
          <div class="rb-card-head">
            <h2>My reports</h2>
            <input class="rb-input rb-filter" id="rb-saved-filter" type="search" placeholder="Filter" maxlength="100" aria-label="Filter my reports">
          </div>
          <ul class="rb-rows rb-scroll" id="rb-saved-list"></ul>
        </section>
        <section class="rb-card">
          <div class="rb-card-head"><h2>Create new report</h2></div>
          <div class="rb-scroll" id="rb-report-types">
            <% groups.forEach((group) => { %>
              <h3 class="rb-group"><%= group %></h3>
              <ul class="rb-type-list">
                <% families.filter((family) => family.group === group).forEach((family) => { %>
                  <li><a href="#" class="rb-row-link rb-type" data-family="<%= family.key %>" aria-pressed="false"><span class="rb-check" aria-hidden="true"></span><span class="rb-row-text"><span class="rb-row-name"><%= family.title %></span> <span class="rb-muted">(<%= family.description %>)</span></span></a></li>
                <% }) %>
              </ul>
            <% }) %>
            <% if (!families.length) { %><p class="rb-empty">No reports are available for your role.</p><% } %>
          </div>
        </section>
      </div>
      <div class="rb-actions">
        <span class="rb-error" data-error-for="1" role="alert"></span>
        <button class="rb-btn rb-btn-primary" type="button" data-next-step="2" disabled>Choose columns &rarr;</button>
      </div>
    </section>

    <!-- Step 2: columns -->
    <section class="rb-panel" data-step-panel="2" hidden>
      <div class="rb-title-row"><h2 class="rb-title" data-report-title></h2><div class="rb-view-switch" data-view-switch></div></div>
      <div class="rb-grid">
        <section class="rb-card">
          <div class="rb-card-head">
            <h3>Available columns</h3>
            <input class="rb-input rb-filter" id="rb-column-search" type="search" placeholder="Find" maxlength="100" aria-label="Find a column">
          </div>
          <ul class="rb-rows rb-scroll" id="rb-available-columns"></ul>
        </section>
        <section class="rb-card">
          <div class="rb-card-head">
            <h3>Report columns <span class="rb-muted" id="rb-column-count"></span></h3>
            <button class="rb-btn rb-btn-light rb-btn-sm" id="rb-reset-columns" type="button">Reset</button>
          </div>
          <ul class="rb-chosen rb-scroll" id="rb-selected-columns"></ul>
        </section>
      </div>
      <div class="rb-actions">
        <button class="rb-btn rb-btn-light" type="button" data-previous-step="1">&larr; Back</button>
        <span class="rb-error" data-error-for="2" role="alert"></span>
        <button class="rb-btn rb-btn-primary" type="button" data-next-step="3">Choose criteria &rarr;</button>
      </div>
    </section>

    <!-- Step 3: criteria -->
    <section class="rb-panel" data-step-panel="3" hidden>
      <div class="rb-title-row"><h2 class="rb-title" data-report-title></h2><div class="rb-view-switch" data-view-switch></div></div>
      <div class="rb-grid">
        <section class="rb-card">
          <div class="rb-card-head">
            <h3>Available criteria <span class="rb-tag">Optional</span></h3>
            <input class="rb-input rb-filter" id="rb-criteria-search" type="search" placeholder="Find" maxlength="100" aria-label="Find a criterion">
          </div>
          <ul class="rb-rows rb-scroll" id="rb-available-criteria"></ul>
        </section>
        <section class="rb-card">
          <div class="rb-card-head">
            <h3>Report criteria <span class="rb-muted" id="rb-criteria-count"></span></h3>
            <button class="rb-btn rb-btn-light rb-btn-sm" id="rb-clear-criteria" type="button">Clear</button>
          </div>
          <ul class="rb-chosen rb-scroll" id="rb-selected-criteria"></ul>
        </section>
      </div>
      <div class="rb-actions">
        <button class="rb-btn rb-btn-light" type="button" data-previous-step="2">&larr; Back</button>
        <span class="rb-error" data-error-for="3" role="alert"></span>
        <button class="rb-btn rb-btn-primary" type="button" data-next-step="4">Run report &rarr;</button>
      </div>
    </section>

    <!-- Step 4: results -->
    <section class="rb-panel" data-step-panel="4" hidden>
      <div class="rb-title-row">
        <h2 class="rb-title" data-report-title></h2>
        <div class="rb-view-switch" data-view-switch></div>
        <span class="rb-sr-only" id="rb-results-status" aria-live="polite"></span>
      </div>
      <div class="rb-table-area">
        <div class="rb-table-box">
          <table class="rb-table">
            <thead id="rb-table-head"></thead>
            <tbody id="rb-table-body"></tbody>
          </table>
        </div>
        <div class="rb-overlay" id="rb-loading" role="status" aria-live="polite" hidden>
          <span class="rb-spinner" aria-hidden="true"></span>
          <span>Getting your report…</span>
        </div>
        <div class="rb-overlay" id="rb-run-error" role="alert" hidden>
          <span id="rb-run-error-text"></span>
          <button class="rb-btn rb-btn-primary rb-btn-sm" type="button" id="rb-retry">Try again</button>
        </div>
      </div>
      <div class="rb-pager">
        <span id="rb-range"></span>
        <label class="rb-pager-size">Show
          <select class="rb-input" id="rb-page-size">
            <% (pageSizes || [25, 50, 100]).forEach((size) => { %><option value="<%= size %>"><%= size %></option><% }) %>
          </select>
        </label>
        <span class="rb-pager-nav">
          <button class="rb-btn rb-btn-light rb-btn-sm" type="button" id="rb-prev">&lsaquo; Prev</button>
          <span id="rb-page-label"></span>
          <button class="rb-btn rb-btn-light rb-btn-sm" type="button" id="rb-next">Next &rsaquo;</button>
        </span>
      </div>
      <div class="rb-actions">
        <button class="rb-btn rb-btn-light" type="button" data-previous-step="3">&larr; Back</button>
        <span class="rb-error" data-error-for="4" role="alert"></span>
        <button class="rb-btn rb-btn-primary" type="button" data-next-step="5">Save / export &rarr;</button>
      </div>
    </section>

    <!-- Step 5: actions only; each opens a small window -->
    <section class="rb-panel" data-step-panel="5" hidden>
      <h2 class="rb-title" data-report-title></h2>
      <div class="rb-card rb-finish">
        <div class="rb-finish-actions">
          <button class="rb-btn rb-btn-primary" type="button" data-open-modal="save" data-icon="save">Save</button>
          <button class="rb-btn rb-btn-light" type="button" data-open-modal="download" data-icon="download">Export</button>
          <button class="rb-btn rb-btn-light" type="button" data-open-modal="share" data-icon="share" hidden>Share</button>
          <button class="rb-btn rb-btn-light" type="button" data-open-modal="schedule" data-icon="clock" hidden>Schedule</button>
        </div>
        <p class="rb-status" id="rb-save-status" role="status" aria-live="polite"></p>
      </div>
      <div class="rb-actions">
        <button class="rb-btn rb-btn-light" type="button" data-previous-step="4">&larr; Back</button>
        <span></span>
        <button class="rb-btn rb-btn-light" type="button" id="rb-start-over">New report</button>
      </div>
    </section>
  </div>

  <!-- Small windows -->
  <div class="rb-modal" data-modal="save" hidden>
    <form class="rb-dialog rb-dialog-wide" id="rb-save-form" role="dialog" aria-modal="true" aria-labelledby="rb-save-title">
      <h3 id="rb-save-title">Save report</h3>
      <label class="rb-field">Report name
        <input class="rb-input" id="rb-report-name" type="text" maxlength="120" placeholder="e.g. Weekly absences">
      </label>
      <div class="rb-brand">
        <span class="rb-brand-title">Header on exported files <span class="rb-muted">(Excel and Word)</span></span>
        <div class="rb-brand-options">
          <label class="rb-checkline"><input type="checkbox" data-brand="orgName"> School name</label>
          <label class="rb-checkline"><input type="checkbox" data-brand="logo"> Logo</label>
          <label class="rb-checkline"><input type="checkbox" data-brand="address"> Address</label>
          <label class="rb-checkline"><input type="checkbox" data-brand="phone"> Phone</label>
          <label class="rb-checkline"><input type="checkbox" data-brand="date"> Date</label>
        </div>
        <div class="rb-brand-align" role="group" aria-label="Header position">
          <span class="rb-muted">Position</span>
          <button class="rb-view" type="button" data-align="left" aria-pressed="true">Left</button>
          <button class="rb-view" type="button" data-align="center" aria-pressed="false">Center</button>
        </div>
        <div class="rb-brand-preview" id="rb-brand-preview" aria-label="Header preview"></div>
      </div>
      <p class="rb-modal-status" data-modal-status></p>
      <div class="rb-dialog-actions">
        <button class="rb-btn rb-btn-light rb-push-left" type="button" id="rb-duplicate" data-icon="copy" hidden>Duplicate</button>
        <button class="rb-btn rb-btn-light" type="button" data-close-modal data-icon="close">Cancel</button>
        <button class="rb-btn rb-btn-light" type="button" id="rb-save-new" data-icon="plus" hidden>Save as new</button>
        <button class="rb-btn rb-btn-primary" type="submit" id="rb-save-submit" data-icon="check">Save</button>
      </div>
    </form>
  </div>

  <div class="rb-modal" data-modal="download" hidden>
    <div class="rb-dialog" role="dialog" aria-modal="true" aria-labelledby="rb-download-title">
      <h3 id="rb-download-title">Export</h3>
      <div class="rb-choice-grid">
        <button class="rb-choice" type="button" data-export="xlsx"><strong>Excel</strong><span>.xlsx spreadsheet</span></button>
        <button class="rb-choice" type="button" data-export="docx"><strong>Word</strong><span>.docx document</span></button>
        <button class="rb-choice" type="button" data-export="csv"><strong>CSV</strong><span>Plain data, no header</span></button>
      </div>
      <p class="rb-modal-status" data-modal-status></p>
      <div class="rb-dialog-actions">
        <button class="rb-btn rb-btn-light" type="button" data-close-modal data-icon="close">Close</button>
      </div>
    </div>
  </div>

  <div class="rb-modal" data-modal="share" hidden>
    <div class="rb-dialog" role="dialog" aria-modal="true" aria-labelledby="rb-share-title">
      <h3 id="rb-share-title">Share report</h3>
      <p class="rb-muted">They'll see it in My reports, showing only data their role allows.</p>
      <input class="rb-input" id="rb-staff-filter" type="search" placeholder="Find a person" maxlength="100" aria-label="Find a person">
      <ul class="rb-people" id="rb-staff-list"></ul>
      <p class="rb-modal-status" data-modal-status></p>
      <div class="rb-dialog-actions">
        <button class="rb-btn rb-btn-light" type="button" data-close-modal data-icon="close">Cancel</button>
        <button class="rb-btn rb-btn-primary" type="button" id="rb-save-shares" data-icon="check">Save</button>
      </div>
    </div>
  </div>

  <div class="rb-modal" data-modal="schedule" hidden>
    <div class="rb-dialog" role="dialog" aria-modal="true" aria-labelledby="rb-schedule-title">
      <h3 id="rb-schedule-title">Email schedule</h3>
      <div class="rb-form-grid">
        <label class="rb-field">How often
          <select class="rb-input" id="rb-frequency">
            <option value="">Off</option>
            <option value="weekly">Weekly</option>
            <option value="monthly">Monthly</option>
          </select>
        </label>
        <label class="rb-field" id="rb-monthday-field" hidden>Date
          <select class="rb-input" id="rb-monthday">
            <% for (let day = 1; day <= 31; day++) { %><option value="<%= day %>"><%= day %><%= day === 31 ? ' (or last day)' : '' %></option><% } %>
          </select>
        </label>
      </div>
      <fieldset class="rb-days" id="rb-weekday-field" hidden>
        <legend>Days</legend>
        <% ['Sun','Mon','Tue','Wed','Thu','Fri','Sat'].forEach((day, index) => { %>
          <label class="rb-day"><input type="checkbox" name="rb-weekday" value="<%= index %>" <%= index === 1 ? 'checked' : '' %>><span><%= day %></span></label>
        <% }) %>
      </fieldset>
      <div class="rb-form-grid" data-when-on>
        <label class="rb-field">Time
          <select class="rb-input" id="rb-send-hour">
            <optgroup label="Morning">
              <% for (let hour = 3; hour <= 11; hour++) { %><option value="<%= hour %>" <%= hour === 7 ? 'selected' : '' %>><%= hourLabel(hour) %></option><% } %>
            </optgroup>
            <optgroup label="Evening">
              <% for (let hour = 16; hour <= 22; hour++) { %><option value="<%= hour %>"><%= hourLabel(hour) %></option><% } %>
            </optgroup>
          </select>
        </label>
        <label class="rb-field">File
          <select class="rb-input" id="rb-format">
            <option value="xlsx">Excel</option>
            <option value="docx">Word</option>
            <option value="csv">CSV</option>
          </select>
        </label>
      </div>
      <label class="rb-checkline" data-when-on><input type="checkbox" id="rb-include-shared"> Also send to people it's shared with</label>
      <p class="rb-recipient" data-when-on id="rb-recipient"></p>
      <p class="rb-modal-status" data-modal-status></p>
      <div class="rb-dialog-actions">
        <button class="rb-btn rb-btn-light" type="button" data-close-modal data-icon="close">Cancel</button>
        <button class="rb-btn rb-btn-primary" type="button" id="rb-save-schedule" data-icon="check">Save</button>
      </div>
    </div>
  </div>
<script>
  window.reportBuilderData = <%- JSON.stringify(reportBuilderData).replace(/</g, '\\u003c') %>;
</script>
<script src="<%= assetUrl('/js/reportBuilder.js') %>" defer></script>
</main>
