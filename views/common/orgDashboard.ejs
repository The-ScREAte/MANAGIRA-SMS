<%- include('../partials/flash') %>
<%
  const _fmtDate = (d) => d ? (typeof formatDisplayDate === 'function' ? formatDisplayDate(d) : new Date(d).toLocaleDateString()) : '';
  const _roleKey = String((typeof userRole !== 'undefined' && userRole)
    ? userRole
    : ((typeof req !== 'undefined' && req && req.session && req.session.userRole) ? req.session.userRole : '')
  ).trim().toLowerCase();
  const _feats = Array.isArray(allowedFeatures) ? allowedFeatures : [];
  const _perms = (typeof userPermissions !== 'undefined' && Array.isArray(userPermissions)) ? userPermissions : [];
  const _perm = (k) => _perms.includes(k);
  const _feat = (...names) => names.some((n) => _feats.includes(n));
  const _hasWebsite = _feat('School Website', 'SchoolWebsite');
  const _hasDashboard = !!(schoolYear && currentTerm);
  const _sess = (typeof session !== 'undefined' && session) ? session : {};
  const _viewerKey = String([organizationId || 'org', _sess.userId || (_sess.user && _sess.user.user_id) || (_sess.orgUser && _sess.orgUser.organization_id) || 'me'].join('-')).replace(/[^a-z0-9-]/gi, '');

  // Quick actions: every page this person can open, in a sensible default order.
  // The browser re-orders them by how often this person uses them.
  const _actions = [];
  const _addAction = (key, href, icon, label, compose) => _actions.push({ key, href, icon, label, compose });
  const _wsMember = typeof workspaceMember === 'undefined' ? true : !!workspaceMember;
  if (_wsMember) _addAction('new-task', '/common/calendar?new=task', 'fa-square-check', 'New task', 'task');
  _addAction('calendar', '/common/calendar', 'fa-calendar-days', 'Calendar');
  if (_perm('manage_students')) { _addAction('add-student', '/common/addStudent', 'fa-user-plus', 'Add student'); _addAction('students', '/common/allStudents', 'fa-user-graduate', 'All students'); }
  if (_perm('manage_students') && !['teacher', 'driver', 'student_teacher'].includes(_roleKey)) _addAction('transport', '/transportation/manage', 'fa-bus', 'Transport');
  if (_perm('approve_admissions') && _feat('Student and Guardian Profile', 'Student and Guadian Profile')) _addAction('admissions', '/common/admissions', 'fa-inbox', 'Admissions');
  if (_perm('manage_employees')) { _addAction('add-staff', '/common/createEmployee', 'fa-id-badge', 'Add staff'); _addAction('management', '/common/management', 'fa-users-gear', 'Management'); }
  if (_perm('publish_events_announcements')) _addAction('events', '/common/manageEventsAnnouncements', 'fa-calendar-plus', 'Events & announcements');
  if (_perm('manage_paygira') && _feat('PayGira')) { _addAction('fees', '/account/settings/finance', 'fa-wallet', 'Fees & payments'); _addAction('arrears', '/account/settings/finance/arrears', 'fa-file-invoice-dollar', 'Arrears'); }
  if (_perm('mailroom')) _addAction('mailroom', '/common/mailroom', 'fa-paper-plane', 'Send a message');
  if (_perm('manage_reports') && _feat('Terminal Report', 'Progressive Student Report', 'Progressive Student Report ', 'Class Base Merit Sheet', 'Class Base Merrit sheet', 'Official School Transcript')) _addAction('reports', '/common/reports', 'fa-chart-column', 'Reports');
  if (_perm('manage_records')) _addAction('records', '/common/manageRecords', 'fa-calendar-days', 'School years & terms');
  if (_perm('manage_classes_subjects')) _addAction('classes', '/common/manageClassSubjectAndGradYr', 'fa-chalkboard', 'Classes & subjects');
  _addAction('settings', '/account/settings', 'fa-user-gear', 'My profile & settings');
%>

<style>
  :root {
    --font-family: "<%= (session && session.fontStyle ? String(session.fontStyle).trim() : 'Inter') %>", sans-serif;
  }
  body { font-family: var(--font-family); }

  /* ---------- Nav row: Org Dashboard / School Website + tools ---------- */
  .org-nav-wrap {
    display: flex; align-items: center; justify-content: space-between; gap: 12px; flex-wrap: wrap;
    width: calc(100% - 64px); max-width: 1640px; margin: 24px auto 18px; box-sizing: border-box;
  }
  .org-nav-wrap--center { justify-content: center; }
  .org-nav-buttons { display: flex; gap: 12px; flex-wrap: wrap; align-items: center; }
  .org-nav-button {
    display: inline-flex; align-items: center; justify-content: center; padding: 10px 18px; font-size: 0.95rem; font-weight: 600;
    border: 2px solid var(--org-primary-color, #01535b); border-radius: 8px; background-color: #ffffff;
    color: var(--org-primary-color, #01535b); cursor: pointer; transition: all 0.2s ease; width: auto; margin: 0;
    flex: 0 0 auto; min-width: 150px; text-align: center; box-shadow: 0 1px 4px rgba(0, 0, 0, 0.06);
  }
  .org-nav-button:hover { background-color: rgba(1, 83, 91, 0.08); border-color: var(--org-primary-hover-fill, var(--org-primary-hover, #014a51)); color: var(--org-primary-hover, #014a51); }
  .org-nav-button.active { background-color: var(--org-primary-color, #01535b); color: #ffffff; border-color: var(--org-primary-color, #01535b); }

  .od-tools { display: inline-flex; align-items: center; gap: 8px; }
  .od-dd { position: relative; }
  .od-tool {
    display: inline-flex !important; align-items: center; gap: 8px; height: 44px; padding: 0 14px !important; margin: 0 !important; width: auto !important;
    border: 1px solid color-mix(in srgb, var(--org-primary-color, #0f5a66) 35%, #e2e8f0) !important; border-radius: 8px !important; background: #fff !important; color: #0f172a !important;
    font-size: 0.92rem; font-weight: 600; cursor: pointer; box-shadow: 0 1px 4px rgba(0, 0, 0, 0.06); white-space: nowrap;
  }
  .od-tool i { color: var(--org-primary-color, #0f5a66); }
  .od-tool .od-tool__caret { font-size: 0.7rem; color: #94a3b8; transition: transform .15s ease; }
  .od-tool:hover, .od-dd.is-open .od-tool { border-color: var(--org-primary-color, #0f5a66) !important; }
  .od-dd.is-open .od-tool__caret { transform: rotate(180deg); }
  .od-tool--icon { width: 44px !important; justify-content: center; padding: 0 !important; }
  .od-tool--customize { background: color-mix(in srgb, var(--org-primary-color, #0f5a66) 7%, #ffffff) !important; }
  .od-tool--customize i { font-size: 0.85rem; }
  .od-dd__panel {
    position: absolute; top: calc(100% + 8px); right: 0; z-index: 40; min-width: 270px; max-width: calc(100vw - 32px);
    background: #fff; border: 1px solid #e5e7eb; border-radius: 12px; box-shadow: 0 16px 40px rgba(15, 23, 42, 0.16);
    padding: 10px; text-align: left; box-sizing: border-box;
  }
  .od-dd__panel[hidden] { display: none !important; }
  .od-dd__panel--wide { width: 290px; }
  .od-dd__title { font-size: 0.72rem; font-weight: 700; letter-spacing: .06em; text-transform: uppercase; color: #64748b; padding: 4px 8px 8px; }
  .od-qa { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: minmax(0, 1fr); gap: 2px; }
  .od-qa li { margin: 0; }
  .od-qa:not(.is-all) li.od-qa--more { display: none; }
  .od-qa__all { all: unset; display: block; margin: 4px 8px 2px; cursor: pointer; font-size: 0.84rem; font-weight: 600; color: var(--org-primary-color, #0f5a66); }
  .od-qa__all:hover { text-decoration: underline; }
  .od-qa a {
    display: flex; align-items: center; gap: 10px; padding: 9px 10px; border-radius: 8px; color: #0f172a !important;
    font-size: 0.88rem; font-weight: 600; text-decoration: none; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
  }
  .od-qa a i {
    flex: 0 0 30px; height: 30px; border-radius: 8px; display: flex; align-items: center; justify-content: center;
    background: color-mix(in srgb, var(--org-primary-color, #0f5a66) 9%, #fff); color: var(--org-primary-color, #0f5a66); font-size: 0.85rem;
  }
  .od-qa a:hover { background: #f8fafc; color: var(--org-primary-color, #0f5a66) !important; }
  .od-dd__hint { margin: 6px 8px 2px; font-size: 0.76rem; color: #94a3b8; }
  .od-check { display: flex; align-items: center; gap: 10px; padding: 8px; border-radius: 8px; font-size: 0.9rem; color: #0f172a; cursor: pointer; margin: 0; }
  .od-check:hover { background: #f8fafc; }
  .od-check.is-locked { opacity: .7; cursor: not-allowed; }
  .od-check input { width: 16px; height: 16px; margin: 0; accent-color: var(--org-primary-color, #0f5a66); cursor: pointer; }
  .od-dd__foot { border-top: 1px solid #f1f5f9; margin-top: 6px; padding: 8px 8px 2px; }
  .od-dd__reset { all: unset; cursor: pointer; font-size: 0.84rem; font-weight: 600; color: var(--org-primary-color, #0f5a66); }
  .od-dd__reset:hover { text-decoration: underline; }

  /* ---------- Dashboard ---------- */
  #orgDashboardSection { max-width: none; width: 100%; margin: 0; padding: 0 32px; box-sizing: border-box; }
  .dashboard-grid { width: 100%; max-width: 1640px; margin: 0 auto; padding: 0 !important; }
  .dashboard-grid > .od { flex: 1 1 100%; margin: 0 0 28px; }

  .od {
    --od-primary: var(--org-primary-color, #0f5a66);
    --od-primary-hover: var(--org-primary-hover, #0b4750);
    --od-soft: color-mix(in srgb, var(--od-primary) 8%, #ffffff);
    --od-soft-border: color-mix(in srgb, var(--od-primary) 22%, #e2e8f0);
    --od-text: #0f172a;
    --od-muted: #64748b;
    --od-border: color-mix(in srgb, var(--od-primary) 30%, #e2e8f0);
    --od-line: color-mix(in srgb, var(--od-primary) 12%, #eef2f6);
    color: var(--od-text);
    display: grid; gap: 20px; min-width: 0;
  }
  .od *, .od *::before, .od *::after { box-sizing: border-box; }
  .od ul { list-style: none; margin: 0; padding: 0; }
  .od li { margin: 0; text-align: left; }
  .od p { margin: 0; }
  .od h2, .od h3 { text-align: left; }
  .od button { width: auto; margin: 0; padding: 0; border: 0; background: none; color: inherit; font: inherit; font-weight: 600; cursor: pointer; box-shadow: none; }
  .od button:hover { background: none; }
  .od a { text-decoration: none; }
  .od [hidden] { display: none !important; }
  .od-row-empty { display: none !important; }

  .od-pair { display: flex; gap: 20px 24px; align-items: flex-start; }
  .od-pair > * { flex: 1 1 0; min-width: 0; }

  .od-card {
    border: 1px solid var(--od-border); border-radius: 14px; padding: 20px; min-width: 0;
    background:
      linear-gradient(180deg, color-mix(in srgb, var(--od-primary) 9%, #ffffff) 0, color-mix(in srgb, var(--od-primary) 3%, #ffffff) 74px, color-mix(in srgb, var(--od-primary) 3%, #ffffff) 100%);
    box-shadow: 0 1px 2px rgba(15, 23, 42, 0.04), 0 6px 18px color-mix(in srgb, var(--od-primary) 7%, transparent);
  }
  .od-card .od-card__head { padding-bottom: 12px; border-bottom: 1px solid color-mix(in srgb, var(--od-primary) 14%, #eef2f6); }
  .od-scope { margin-left: 4px; padding: 2px 8px; border-radius: 999px; background: #fff; border: 1px solid var(--od-line); color: var(--od-muted); font-size: 0.72rem; font-weight: 600; }
  .od-card__head { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-bottom: 14px; flex-wrap: wrap; }
  .od-card__title { display: flex; align-items: center; gap: 8px; margin: 0; font-size: 1.05rem; font-weight: 700; color: var(--od-text) !important; }
  .od-card__title i { color: var(--od-primary); font-size: 0.95rem; }
  .od-count { display: inline-flex; align-items: center; justify-content: center; min-width: 24px; height: 22px; padding: 0 7px; border-radius: 999px; background: var(--od-soft); color: var(--od-primary); font-size: 0.78rem; font-weight: 700; }
  .od-link { color: var(--od-primary) !important; font-size: 0.88rem; font-weight: 600; white-space: nowrap; }
  .od-link:hover { text-decoration: underline; }
  .od-empty { color: var(--od-muted); font-size: 0.92rem; padding: 4px 0; }
  .od-empty a { color: var(--od-primary); font-weight: 600; text-decoration: underline; }
  .od-btn { display: inline-flex; align-items: center; gap: 8px; padding: 10px 14px; border-radius: 10px; font-size: 0.9rem; font-weight: 600; line-height: 1.25; border: 1px solid var(--od-border); background: #fff; color: var(--od-text) !important; }
  .od-btn--primary { background: var(--od-primary); border-color: var(--od-primary); color: #fff !important; }
  .od-btn--primary:hover { background: var(--od-primary-hover); border-color: var(--od-primary-hover); }

  /* Enrolled classes */
  .od-cols { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0 28px; }
  .od-cols--single { grid-template-columns: minmax(0, 1fr); }
  .od-crow { display: flex; align-items: center; gap: 8px; min-height: 42px; border-bottom: 1px solid var(--od-line); position: relative; }
  .od-crow__name { flex: 1 1 auto; }
  .od-crow__edit {
    flex: 0 0 auto; width: 26px; height: 26px; border-radius: 7px; display: inline-flex; align-items: center; justify-content: center;
    color: #94a3b8 !important; font-size: 0.72rem; transition: background-color .15s ease, color .15s ease;
  }
  .od-crow__edit:hover { background: var(--od-soft); color: var(--od-primary) !important; }
  .od-col > .od-crow:last-child { border-bottom: 0; }
  .od-crow__name { font-weight: 700; font-size: 0.93rem; color: var(--od-text) !important; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; min-width: 0; }
  .od-crow__name:hover { color: var(--od-primary) !important; }
  .od-divider { border: 0; height: 2px; border-radius: 2px; background: color-mix(in srgb, var(--od-primary) 22%, #eef2f6); margin: 12px 0; }
  .od-teachers { position: relative; flex: 0 1 auto; min-width: 0; max-width: 62%; }
  .od-teachers summary, .od-noteacher { display: flex; align-items: center; gap: 6px; font-size: 0.82rem; color: var(--od-muted); padding: 4px 8px; border-radius: 8px; white-space: nowrap; }
  .od-teachers summary { cursor: pointer; list-style: none; }
  .od-teachers summary::-webkit-details-marker { display: none; }
  .od-teachers summary:hover, .od-teachers[open] summary { background: var(--od-soft); color: var(--od-primary); }
  .od-teachers__lead { min-width: 0; overflow: hidden; text-overflow: ellipsis; }
  .od-teachers__extra { flex: 0 0 auto; font-weight: 700; color: var(--od-primary); }
  .od-teachers__caret { font-size: 0.62rem; transition: transform .15s ease; }
  .od-teachers[open] .od-teachers__caret { transform: rotate(180deg); }
  .od-noteacher { color: #b45309; }
  .od-teachers ul {
    position: absolute; top: calc(100% + 4px); right: 0; z-index: 30; width: max-content; min-width: 220px; max-width: 300px;
    display: grid; gap: 7px; padding: 10px 12px; max-height: 260px; overflow-y: auto;
    background: #fff; border: 1px solid var(--od-border); border-radius: 10px; box-shadow: 0 12px 28px rgba(15, 23, 42, 0.14);
  }
  .od-teacher { display: flex; align-items: center; flex-wrap: wrap; gap: 6px; font-size: 0.84rem; color: #334155; }
  .od-teacher__name { color: #334155 !important; }
  .od-teacher__name:hover { color: var(--od-primary) !important; text-decoration: underline; }
  .od-tag { padding: 1px 7px; border-radius: 999px; font-size: 0.7rem; font-weight: 700; white-space: nowrap; }
  .od-tag--main { background: #ecfdf5; color: #047857; }
  .od-tag--pending { background: #fffbeb; color: #b45309; }
  .od-tag--hold { background: #fef2f2; color: #b91c1c; }

  /* School year */
  .od-chip { display: inline-flex; align-items: center; padding: 2px 9px; border-radius: 999px; background: #f1f5f9; color: #334155; font-size: 0.8rem; font-weight: 600; }
  .od-today { display: inline-flex; align-items: center; gap: 7px; padding: 4px 10px; border-radius: 999px; background: #f8fafc; border: 1px solid var(--od-border); font-size: 0.82rem; color: #334155; white-space: nowrap; }
  .od-today img { display: block; border-radius: 2px; }
  .od-term { display: flex; align-items: center; justify-content: space-between; gap: 12px; flex-wrap: wrap; }
  .od-eyebrow { display: block; font-size: 0.72rem; font-weight: 700; letter-spacing: .06em; text-transform: uppercase; color: var(--od-muted); }
  .od-term__name { display: block; font-size: 1.2rem; font-weight: 700; margin-top: 2px; }
  .od-pill { display: inline-flex; align-items: center; gap: 6px; padding: 4px 10px; border-radius: 999px; font-size: 0.8rem; font-weight: 700; white-space: nowrap; }
  .od-pill::before { content: ""; width: 7px; height: 7px; border-radius: 50%; background: currentColor; }
  .od-pill--live { background: #ecfdf5; color: #047857; }
  .od-pill--upcoming { background: #eff6ff; color: #1d4ed8; }
  .od-pill--ended { background: #fff7ed; color: #c2410c; }
  .term-duration { margin-top: 18px; }
  .term-duration__row { display: flex; align-items: center; gap: 12px; }
  .term-duration__bar { flex: 1; height: 10px; border-radius: 999px; background: #eef2f6; overflow: hidden; }
  .term-duration__pct { flex: 0 0 auto; min-width: 52px; text-align: center; padding: 3px 9px; border-radius: 999px; background: var(--od-soft); color: var(--od-primary); font-size: 0.85rem; font-weight: 800; }
  .term-duration__bar > span { display: block; height: 100%; border-radius: inherit; background: var(--od-primary); }
  .term-duration__meta { display: flex; justify-content: space-between; gap: 8px; margin-top: 7px; font-size: 0.8rem; color: var(--od-muted); }
  .term-duration__meta strong { color: #334155; font-weight: 600; }
  .od-next { margin-top: 16px; padding-top: 16px; border-top: 1px solid var(--od-line); display: grid; gap: 10px; justify-items: start; }
  .od-next__text { font-size: 0.88rem; color: #475569; }

  /* Numbers */
  .od-kpis { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 20px 24px; }
  .od-kpi {
    --k: var(--od-primary);
    display: flex; gap: 12px; align-items: flex-start; padding: 16px 18px; border-radius: 14px; color: var(--od-text) !important;
    background: linear-gradient(135deg, color-mix(in srgb, var(--k) 13%, #ffffff), color-mix(in srgb, var(--k) 4%, #ffffff));
    border: 1px solid color-mix(in srgb, var(--k) 30%, #e2e8f0);
    box-shadow: 0 1px 2px rgba(15, 23, 42, 0.04), 0 6px 18px color-mix(in srgb, var(--k) 10%, transparent);
    transition: border-color .15s ease, box-shadow .15s ease, transform .15s ease;
  }
  .od-kpi--admissions { --k: #2563eb; }
  .od-kpi--attendance { --k: #7c3aed; }
  .od-kpi--fees { --k: #059669; }
  .od-kpi--transport { --k: #d97706; }
  a.od-kpi:hover { border-color: var(--od-soft-border); box-shadow: 0 6px 16px rgba(15, 23, 42, 0.08); transform: translateY(-1px); }
  .od-kpi__icon { flex: 0 0 40px; height: 40px; border-radius: 12px; display: flex; align-items: center; justify-content: center; background: #fff; color: var(--k); box-shadow: 0 2px 6px color-mix(in srgb, var(--k) 18%, transparent); }
  .od-kpi__label { color: color-mix(in srgb, var(--k) 70%, #334155) !important; }
  .od-kpi__bar > span { background: var(--k) !important; }
  a.od-kpi:hover { border-color: color-mix(in srgb, var(--k) 55%, #e2e8f0) !important; }
  .od-kpi__body { display: grid; gap: 2px; min-width: 0; flex: 1; }
  .od-kpi__label { font-size: 0.8rem; color: var(--od-muted); font-weight: 600; }
  .od-kpi__value { font-size: 1.45rem; font-weight: 800; line-height: 1.2; overflow-wrap: anywhere; }
  .od-kpi__note { font-size: 0.78rem; color: var(--od-muted); }
  .od-kpi__bar { height: 5px; border-radius: 999px; background: rgba(255, 255, 255, 0.85); overflow: hidden; margin: 4px 0 2px; }
  .od-kpi__bar > span { display: block; height: 100%; background: var(--od-primary); border-radius: inherit; }

  /* Lists: events, announcements, alerts, activity */
  .od-list > li + li { border-top: 1px solid var(--od-line); }
  .od-list:not(.is-expanded) > .od-extra { display: none; }
  .od-showall { margin-top: 10px !important; color: var(--od-primary) !important; font-size: 0.86rem; }
  .od-showall:hover { text-decoration: underline; }
  .od-sublabel { margin: 0 0 6px; font-size: 0.75rem; font-weight: 700; letter-spacing: .06em; text-transform: uppercase; color: var(--od-muted); }

  .od-event > details > summary, .od-event > .od-event__row { display: flex; align-items: center; gap: 12px; padding: 10px 0; list-style: none; }
  .od-event > details > summary { cursor: pointer; }
  .od-event > details > summary::-webkit-details-marker { display: none; }
  .od-event > details > summary:hover .od-event__name { color: var(--od-primary); }
  .od-date { flex: 0 0 44px; height: 46px; border-radius: 10px; background: var(--od-soft); color: var(--od-primary); display: flex; flex-direction: column; align-items: center; justify-content: center; line-height: 1.05; }
  .od-date__m { font-size: 0.66rem; font-weight: 700; letter-spacing: .05em; text-transform: uppercase; }
  .od-date__d { font-size: 1.1rem; font-weight: 800; }
  .od-event--past .od-date { background: #f1f5f9; color: #64748b; }
  .od-event__body { min-width: 0; flex: 1; display: grid; gap: 2px; }
  .od-event__name { font-weight: 600; font-size: 0.93rem; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .od-event__meta { font-size: 0.8rem; color: var(--od-muted); }
  .od-event__caret { color: #94a3b8; font-size: 0.7rem; transition: transform .15s ease; }
  .od-event details[open] .od-event__caret { transform: rotate(180deg); }
  .od-event__details { margin: 0 0 12px 56px !important; font-size: 0.88rem; color: #334155; line-height: 1.55; white-space: pre-line; overflow-wrap: anywhere; }
  .od-past { margin-top: 12px; }
  .od-past > summary { display: flex; align-items: center; gap: 8px; cursor: pointer; list-style: none; font-size: 0.75rem; font-weight: 700; letter-spacing: .06em; text-transform: uppercase; color: var(--od-muted); }
  .od-past > summary::-webkit-details-marker { display: none; }
  .od-past > summary i { font-size: 0.65rem; transition: transform .15s ease; }
  .od-past[open] > summary i { transform: rotate(90deg); }
  .od-past > summary:hover { color: var(--od-primary); }
