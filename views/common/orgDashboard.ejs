<body>
  <%- include('../partials/flash') %>

  <br />
  <div class="org-nav-wrap">
    <div class="org-nav-buttons">
      <button id="orgDashboardBtn" class="org-nav-button active">Org Dashboard</button>

      <% if (Array.isArray(allowedFeatures) && (allowedFeatures.includes("School Website") || allowedFeatures.includes("SchoolWebsite"))) { %>
        <button
          id="publicDashboardBtn"
          class="org-nav-button"
          onclick="window.location.href='/common/publicDashboard?organizationId=<%= organizationId %>'"
        >
          School Website
        </button>
      <% } %>
    </div>
  </div>

  <div class="line-divider"></div>
  <% if (adminAnnouncements && adminAnnouncements.length > 0) { %>
  <div class="admin-flash-container">
    <% adminAnnouncements.forEach(function(announcement) { %>
    <div class="admin-flash">
      <div class="admin-flash-text">
        <strong class="announcement-title"><%= announcement.title %></strong>
        <hr />
        <div class="announcement-description">
          <%= announcement.description %>
        </div>
      </div>
      <button
        onclick="this.parentElement.style.display='none'"
        class="close-btn"
      >
        ✖
      </button>
    </div>
    <% }) %>
  </div>
  <% } %>

  <div id="flashMessageContainer">
    <% if (messages.error && messages.error.length > 0) { %>
    <div class="flash-message error">
      <span><%= messages.error[0] %></span>
      <button class="close-btn" onclick="closeFlashMessage()">✖</button>
    </div>
    <% } %>
  </div>

  <% if (!schoolYear || !currentTerm) { %>
  <div class="welcome-page-wrapper">
    <!-- Show the welcome message if no school year or term is set -->
    <div id="welcomeMessage" class="org-welcome-card">
      <h1>Welcome to Managira! 🎉</h1>
      <h3>Your trusted partner for managing it all effortlessly. 😊</h3>
      <p>
        Head over to <a class="text-link" href="/account/settings">Settings</a> to update your
        credentials, upload your organization's logo, and personalize everything to suit your
        unique needs. A great logo goes a long way and you can always click the logo or school
        name at the top to return to the home page.
      </p>
      <p>
        Get started by setting up a school year and a term/semester. It's simple
        and intuitive!
      </p>
      <a href="/common/manageRecords" class="start-link">Begin Your Journey Here</a>
    </div>
  </div>
  <% } else { %>

    <!-- Main content when school year and term are set -->
    <div id="orgDashboardSection">

      <!-- Dashboard grid layout -->
      <div class="dashboard-grid">
        <!-- Top row: classes and school year info -->
        <div class="grid-row">
          <!-- Classes Section -->
          <!-- Classes Section -->
          <div class="classes-container" style="text-align: center">
            <h2>Enrolled Classes</h2>
            <ul>
              <% if (classes && classes.length > 0) { %>
                <% classes.forEach(function(cls, clsIndex) { %>
                  <li class="class-item">
                    <div class="class-header">
                      <a href="/common/classDashboard?classId=<%= cls.class_id %>"><%= cls.class_name %></a>
                      - <b>Teachers:</b>
                      <span class="teacher-toggle" onclick="toggleTeachers(<%= clsIndex %>)" title="Click to show/hide teachers">
                        <svg class="toggle-arrow" id="arrow-<%= clsIndex %>" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                          <polyline points="9 18 15 12 9 6"></polyline>
                        </svg>
                      </span>
                    </div>
                    <div class="teachers-list" id="teachers-<%= clsIndex %>" style="display: none;">
                      <% const validEmployees = (cls.employees || []).filter(emp => emp && emp.name && String(emp.name).trim()); %>
                      <% if (validEmployees.length > 0) { %>
                        <% validEmployees.forEach(function(emp) { %>
                          <div class="teacher-entry">
                            <% if (emp.main) { %><span class="main" title="Main teacher">•</span><% } %>
                            <% if (emp.reset_password_token) { %><span class="yellow-dot" title="Has not set password">•</span><% } %>
                            <% if (emp.on_hold) { %><span class="on-hold" title="On hold">•</span><% } %>
                            <%= emp.name %>
                          </div>
                        <% }); %>
                      <% } else { %>
                        <div class="teacher-entry">No teacher</div>
                      <% } %>
                    </div>
                  </li>
                <% }); %>
              <% } else { %>
                <% if (userRole === "Teacher") { %>
                  <li>You are not assigned to any classes yet.</li>
                <% } else { %>
                  <li>
                    No classes have been set up for this current term yet.
                    <a href="/common/manageClassSubjectAndGradYr">Create</a> classes for your organization if you haven't done so already. Otherwise, click <a href="/enrollment/manageEnrollment">here</a> to enroll a class.
                  </li>
                <% } %>
              <% } %>
            </ul>
          </div>

          <!-- School Year and Term Section -->
          <div class="school-year-info">
            <h2>Current School Year: <%= schoolYear.year_label %></h2>
            <% if (currentTerm) { %>
            <div>
              <strong><%= currentTerm.term_name %>:</strong>
              Start: <%= new
              Date(currentTerm.start_date).toISOString().split('T')[0] %>, End:
              <%= new Date(currentTerm.end_date).toISOString().split('T')[0] %>
            </div>
            <div>
              <% const today = new Date(); %> <% const daysUntilStart =
              Math.ceil((new Date(currentTerm.start_date) - today) / (1000 * 60
              * 60 * 24)); %> <% const daysUntilEnd = Math.ceil((new
              Date(currentTerm.end_date) - today) / (1000 * 60 * 60 * 24)); %>
              <% if (daysUntilStart > 0) { %>
              <strong>Days until start of term:</strong>
              <span id="daysUntilStart"><%= daysUntilStart %></span>
              <% } else { %>
              <strong>Days until end of term:</strong>
              <span id="daysUntilEnd"><%= daysUntilEnd %></span>
              <% } %>
            </div>
            <% } else { %>
            <p>No current term information available.</p>
            <% } %>
          </div>
        </div>

        <!-- Bottom row: events and announcements -->
        <div class="grid-row">
          <!-- Events Section (Hidden for Teachers) -->
          <% if (userRole !== "teacher") { %>
          <div class="events-container">
            <h2>Events</h2>
            <ul>
              <% if (events && events.length > 0) { %>
                <% events.forEach(function(event, eventIndex) { %>
                  <li class="event-item" id="event-item-<%= eventIndex %>">
                    <div class="event-header" onclick="toggleEvent(<%= eventIndex %>)" style="cursor: pointer;">
                      <div class="event-title-row">
                        <strong><%= event.name %></strong> - <%= new Date(event.event_date).toISOString().split('T')[0] %>
                        <span class="event-toggle" title="Click to show/hide details">
                          <svg class="toggle-arrow" id="event-arrow-<%= eventIndex %>" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                            <polyline points="9 18 15 12 9 6"></polyline>
                          </svg>
                        </span>
                      </div>
                      <div class="event-preview" id="event-preview-<%= eventIndex %>"><%= event.details.substring(0, 60) %>...</div>
                    </div>
                  
                    <div class="event-details" id="event-details-<%= eventIndex %>" style="display: none;">
                      <%= event.details %>
                    </div>
                    <% if (eventIndex < events.length - 1) { %>
                      <hr class="event-divider">
                    <% } %>
                  </li>
                <% }); %>
              <% } else { %>
                <li>No events found</li>
              <% } %>
            </ul>
          </div>
          <% } %>

          <!-- Announcements Section (Hidden for Managers & Supervisors) -->

          <div class="announcements-container">
            <h2>Announcements</h2>
            <ul>
              <% if (announcements && announcements.length > 0) { %>
                <% announcements.forEach(function(announcement, announcementIndex) { %>
                  <li class="announcement-item" id="announcement-item-<%= announcementIndex %>">
                    <div class="announcement-header" onclick="toggleAnnouncement(<%= announcementIndex %>)" style="cursor: pointer;">
                      <div class="announcement-preview-row">
                        <span class="announcement-preview" id="announcement-preview-<%= announcementIndex %>"><%= announcement.message.substring(0, 60) %>...</span>
                        <span class="announcement-toggle" title="Click to show/hide full message">
                          <svg class="toggle-arrow" id="announcement-arrow-<%= announcementIndex %>" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                            <polyline points="9 18 15 12 9 6"></polyline>
                          </svg>
                        </span>
                      </div>
                    </div>
                    <div class="announcement-full" id="announcement-full-<%= announcementIndex %>" style="display: none;">
                      <%= announcement.message %>
                    </div>
                    <% if (announcementIndex < announcements.length - 1) { %>
                      <hr class="announcement-divider">
                    <% } %>
                  </li>
                <% }); %>
              <% } else { %>
                <li>No announcements found</li>
              <% } %>
            </ul>
          </div>
        </div>
      </div>
    </div>

    <% } %>

  <script>
    // Hide or show the welcome message or orgDashboardSection based on schoolYear and currentTerm
    document.addEventListener('DOMContentLoaded', () => {
      const schoolYear = JSON.parse('<%- JSON.stringify(schoolYear) %>');
      const currentTerm = JSON.parse('<%- JSON.stringify(currentTerm) %>');

      if (!schoolYear || !currentTerm) {
        document.getElementById('orgDashboardSection').style.display = 'none';
        document.getElementById('welcomeMessage').style.display = 'block';
      } else {
        document.getElementById('orgDashboardSection').style.display = 'block';
        document.getElementById('welcomeMessage').style.display = 'none';
      }
    });

    function closeFlashMessage() {
      const messageBox = document.querySelector(".flash-message");
      if (messageBox) {
        messageBox.style.opacity = "0";
        setTimeout(() => messageBox.remove(), 300);
      }
    }

    // Auto-hide after 5 seconds
    setTimeout(closeFlashMessage, 5000);
  </script>

  <script>
    function dismissAdminFlash() {
      const flash = document.getElementById("admin-flash");
      if (flash) {
        flash.style.display = "none";
      }
    }

    function toggleTeachers(index) {
      const teachersList = document.getElementById('teachers-' + index);
      const arrow = document.getElementById('arrow-' + index);
      const isOpen = teachersList.classList.contains('show');

      // Close all other teacher lists
      document.querySelectorAll('.teachers-list').forEach((list, idx) => {
        if (idx !== index && list.classList.contains('show')) {
          list.classList.remove('show');
          const otherArrow = document.getElementById('arrow-' + idx);
          if (otherArrow) otherArrow.classList.remove('expanded');
          setTimeout(() => {
            if (!list.classList.contains('show')) {
              list.style.display = 'none';
            }
          }, 400);
        }
      });

      if (isOpen) {
        teachersList.classList.remove('show');
        arrow.classList.remove('expanded');
        setTimeout(() => {
          if (!teachersList.classList.contains('show')) {
            teachersList.style.display = 'none';
          }
        }, 400);
      } else {
        teachersList.style.display = 'block';
        requestAnimationFrame(() => {
          teachersList.classList.add('show');
          arrow.classList.add('expanded');
        });
      }
    }

    function toggleEvent(index) {
      const eventDetails = document.getElementById('event-details-' + index);
      const eventPreview = document.getElementById('event-preview-' + index);
      const eventItem = document.getElementById('event-item-' + index);
      const arrow = document.getElementById('event-arrow-' + index);
      const isOpen = eventDetails.classList.contains('show');

      // Close all other event details
      document.querySelectorAll('.event-details').forEach((details, idx) => {
        if (idx !== index && details.classList.contains('show')) {
          details.classList.remove('show');
          const otherArrow = document.getElementById('event-arrow-' + idx);
          const otherPreview = document.getElementById('event-preview-' + idx);
          const otherItem = document.getElementById('event-item-' + idx);
          if (otherArrow) otherArrow.classList.remove('expanded');
          if (otherPreview) otherPreview.style.display = 'block';
          if (otherItem) otherItem.classList.remove('expanded');
          setTimeout(() => {
            if (!details.classList.contains('show')) {
              details.style.display = 'none';
            }
          }, 400);
        }
      });

      if (isOpen) {
        eventDetails.classList.remove('show');
        arrow.classList.remove('expanded');
        eventPreview.style.display = 'block';
        eventItem.classList.remove('expanded');
        setTimeout(() => {
          if (!eventDetails.classList.contains('show')) {
            eventDetails.style.display = 'none';
          }
        }, 400);
      } else {
        eventDetails.style.display = 'block';
        eventPreview.style.display = 'none';
        eventItem.classList.add('expanded');
        requestAnimationFrame(() => {
          eventDetails.classList.add('show');
          arrow.classList.add('expanded');
        });
      }
    }

    function toggleAnnouncement(index) {
      const announcementFull = document.getElementById('announcement-full-' + index);
      const announcementPreview = document.getElementById('announcement-preview-' + index);
      const announcementItem = document.getElementById('announcement-item-' + index);
      const arrow = document.getElementById('announcement-arrow-' + index);
      const isOpen = announcementFull.classList.contains('show');

      // Close all other announcements
      document.querySelectorAll('.announcement-full').forEach((full, idx) => {
        if (idx !== index && full.classList.contains('show')) {
          full.classList.remove('show');
          const otherArrow = document.getElementById('announcement-arrow-' + idx);
          const otherPreview = document.getElementById('announcement-preview-' + idx);
          const otherItem = document.getElementById('announcement-item-' + idx);
          if (otherArrow) otherArrow.classList.remove('expanded');
          if (otherPreview) otherPreview.style.display = 'inline';
          if (otherItem) otherItem.classList.remove('expanded');
          setTimeout(() => {
            if (!full.classList.contains('show')) {
              full.style.display = 'none';
            }
          }, 400);
        }
      });

      if (isOpen) {
        announcementFull.classList.remove('show');
        arrow.classList.remove('expanded');
        announcementPreview.style.display = 'inline';
        announcementItem.classList.remove('expanded');
        setTimeout(() => {
          if (!announcementFull.classList.contains('show')) {
            announcementFull.style.display = 'none';
          }
        }, 400);
      } else {
        announcementFull.style.display = 'block';
        announcementPreview.style.display = 'none';
        announcementItem.classList.add('expanded');
        requestAnimationFrame(() => {
          announcementFull.classList.add('show');
          arrow.classList.add('expanded');
        });
      }
    }
  </script>

  <style>
    /* Scoped styles for org dashboard nav buttons (unique classes to avoid conflicts) */
    .org-nav-wrap {
      display: flex;
      justify-content: center;
      width: 100%;
      margin-bottom: 16px;
    }

    .org-nav-buttons {
      display: flex;
      gap: 12px;
      flex-wrap: nowrap;
      justify-content: center;
      align-items: center;
    }

    .org-nav-button {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      padding: 10px 18px;
      font-size: 0.95rem;
      font-weight: 600;
      border: 2px solid var(--org-primary-color, #01535b);
      border-radius: 8px;
      background-color: #ffffff;
      color: var(--org-primary-color, #01535b);
      cursor: pointer;
      transition: all 0.2s ease;
      width: auto;
      margin: 0;
      flex: 0 0 auto;
      min-width: 150px;
      text-align: center;
      box-shadow: 0 1px 4px rgba(0, 0, 0, 0.06);
    }

    .org-nav-button:hover {
      background-color: rgba(1, 83, 91, 0.08);
      border-color: var(--org-primary-hover, #014a51);
      color: var(--org-primary-hover, #014a51);
    }

    .org-nav-button.active {
      background-color: var(--org-primary-color, #01535b);
      color: #ffffff;
      border-color: var(--org-primary-color, #01535b);
    }

    @media (max-width: 768px) {
      .org-nav-wrap {
        padding: 0 8px;
      }

      .org-nav-buttons {
        width: 100%;
        flex-wrap: nowrap;
      }

      .org-nav-button {
        flex: 1 1 50%;
        font-size: 0.88rem;
        min-width: 0;
      }
    }

      :root {
        --font-family: "<%= (session && session.fontStyle ? String(session.fontStyle).trim() : 'Inter') %>", sans-serif;
      }


    body {
      font-family: var(--font-family);
    }

    /* Dashboard Content Centering */
    #orgDashboardSection {
      max-width: 1400px;
      margin: 0 auto;
      padding: 0 20px;
    }

    .dashboard-grid {
      width: 100%;
      max-width: 100%;
      margin: 0 auto;
    }

    .grid-row {
      display: flex;
      flex-wrap: wrap;
      gap: 20px;
      margin-bottom: 20px;
    }

    .classes-container,
    .school-year-info,
    .events-container,
    .announcements-container {
      flex: 1;
      min-width: 300px;
      background: white;
      padding: 20px;
      border-radius: 8px;
      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
      border: 1px solid #e5e7eb;
    }

    .welcome-page-wrapper {
      display: flex;
      justify-content: center;
      align-items: center;
      min-height: 60vh;
      padding: 20px;
    }

    .org-welcome-card {
      max-width: 800px;
      width: 100%;
      margin: 0 auto;
      text-align: center;
    }

    @media (max-width: 768px) {
      #orgDashboardSection {
        padding: 0 10px;
      }

      .grid-row {
        flex-direction: column;
      }

      .classes-container,
      .school-year-info,
      .events-container,
      .announcements-container {
        min-width: 100%;
      }
    }
  </style>
  <style>
    .yellow-dot {
      color: rgb(204, 173, 0);
      font-size: 25px;
      margin-left: 5px;
    }

    /* Make action links stand out - use theme color */
    .classes-container li a {
      color: var(--org-primary-color);
      text-decoration: none;
      font-weight: 600;
    }

    .classes-container li a:hover {
      text-decoration: underline;
      color: var(--org-primary-hover);
    }

    /* Special styling for Create and Here links in the no-classes message */
    .classes-container li a[href="/common/manageClassSubjectAndGradYr"],
    .classes-container li a[href="/enrollment/manageEnrollment"] {
      color: var(--org-primary-color);
      font-weight: 700;
      text-decoration: underline;
    }

    .classes-container li a[href="/common/manageClassSubjectAndGradYr"]:hover,
    .classes-container li a[href="/enrollment/manageEnrollment"]:hover {
      color: var(--org-primary-hover);
      text-decoration: underline;
    }

    .close-btn {
      background: none;
      border: none;
      color: white;
      font-size: 16px;
      cursor: pointer;
      margin-left: 10px;
    }

    @keyframes fadeIn {
      from {
        opacity: 0;
        transform: translateY(10px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }
    @media (max-width: 768px) {
      /* Events and Announcements */
      .events-container,
      .announcements-container {
        padding: 10px;
        text-align: center;
      }
      .classes-container li {
        font-size: 1rem;
        padding: 0;
      }
    }

    /* 🔹 Responsive Adjustments for Small Screens (Mobile) */
    @media screen and (max-width: 768px) {
      .welcome-message {
        text-align: center;
        margin: 50px auto;
        padding: 20px;
        background-color: #f9f9f9;
        border: 1px solid #ddd;
        border-radius: 10px;
        width: 90%;
        box-shadow: 0 0 10px rgba(0, 0, 0, 0.1);
      }
    }
  </style>
</body>
