<%
  // ---- Term ----
  const _dayMs = 86400000;
  const _today = new Date();
  const _termStart = new Date(currentTerm.start_date);
  const _termEnd = new Date(currentTerm.end_date);
  const daysUntilStart = Math.ceil((_termStart - _today) / _dayMs);
  const daysUntilEnd = Math.ceil((_termEnd - _today) / _dayMs);
  const _termDays = Math.max(1, Math.round((_termEnd - _termStart) / _dayMs));
  const _termPct = daysUntilStart > 0 ? 0 : (daysUntilEnd < 0 ? 100 : Math.min(100, Math.max(0, Math.round(((_today - _termStart) / _dayMs) / _termDays * 100))));
  const _days = (n) => n + (n === 1 ? ' day' : ' days');
  const canManageTermSwitch = _perm('manage_records');
  const dashboardTodayLabel = (todayAttendanceStatus && todayAttendanceStatus.label)
    ? todayAttendanceStatus.label
    : ([0, 6].includes(new Date().getDay()) ? 'Weekend' : 'School Day');
  const dashboardCountryFlagUrl = /^[A-Z]{2}$/.test(String(dashboardCountryCode || '').trim().toUpperCase())
    ? `https://flagcdn.com/24x18/${String(dashboardCountryCode).trim().toLowerCase()}.png`
    : '';

  // ---- Classes: admin sort order, unique names, admin's dashboard breaks, two columns ----
  const orderedClasses = [...(classes || [])].sort(function(a, b) {
    const orderA = Number(a.dashboard_sort_order);
    const orderB = Number(b.dashboard_sort_order);
    if (Number.isFinite(orderA) && Number.isFinite(orderB) && orderA !== orderB) return orderA - orderB;
    if (Number.isFinite(orderA) && !Number.isFinite(orderB)) return -1;
    if (!Number.isFinite(orderA) && Number.isFinite(orderB)) return 1;
    return String(a.class_name || '').localeCompare(String(b.class_name || ''), undefined, { numeric: true, sensitivity: 'base' });
  });
  const seenClassNames = new Set();
  const uniqueSortedClasses = orderedClasses.filter(function(cls) {
    const key = String(cls.class_name || '').trim().toLowerCase();
    if (!key || seenClassNames.has(key)) return false;
    seenClassNames.add(key);
    return true;
  });
  const classSections = [];
  let currentSection = [];
  uniqueSortedClasses.forEach(function(cls) {
    currentSection.push(cls);
    if (cls.dashboard_break_after) { classSections.push(currentSection); currentSection = []; }
  });
  if (currentSection.length > 0) classSections.push(currentSection);
  const classRowGroupsFor = (section) => {
    const groups = [];
    for (let index = 0; index < section.length; index += 14) {
      const chunk = section.slice(index, index + 14);
      const splitPoint = chunk.length <= 1 ? chunk.length : Math.min(7, Math.ceil(chunk.length / 2));
      groups.push({ left: chunk.slice(0, splitPoint), right: chunk.slice(splitPoint) });
    }
    return groups;
  };

  // ---- Events: upcoming (soonest first), then past (most recent first) ----
  const _LIST_LIMIT = 4;
  const _startOfToday = new Date(_today.getFullYear(), _today.getMonth(), _today.getDate());
  const _allEvents = Array.isArray(events) ? events : [];
  const upcomingEvents = _allEvents.filter((e) => e.event_date && new Date(e.event_date) >= _startOfToday)
    .sort((a, b) => new Date(a.event_date) - new Date(b.event_date));
  const pastEvents = _allEvents.filter((e) => !e.event_date || new Date(e.event_date) < _startOfToday)
    .sort((a, b) => new Date(b.event_date || 0) - new Date(a.event_date || 0));
  const _allAnnouncements = Array.isArray(announcements) ? announcements : [];
  const _canPublish = _perm('publish_events_announcements');
  const _canEditStaff = _perm('manage_employees');

  // ---- Numbers, alerts, activity ----
  const _ins = (typeof dashboardInsights !== 'undefined' && dashboardInsights) ? dashboardInsights : null;
  const _termAlerts = [];
  if (_ins && _perm('manage_records')) {
    if (daysUntilEnd < 0 && nextTermSuggestion) {
      _termAlerts.push({ tone: 'red', icon: 'fa-calendar-xmark', text: `${currentTerm.term_name} ended ${_days(Math.abs(daysUntilEnd))} ago`, note: `Make ${nextTermSuggestion.term_name} (${nextTermSuggestion.year_label}) the current term.`, href: '/common/manageRecords', action: 'Switch term' });
    } else if (daysUntilEnd >= 0 && daysUntilEnd <= 14 && daysUntilStart <= 0) {
      _termAlerts.push({ tone: 'blue', icon: 'fa-flag-checkered', text: `${currentTerm.term_name} ends in ${_days(daysUntilEnd)}`, note: 'Make sure scores are in and report cards are ready.', href: _perm('manage_reports') ? '/common/reports' : null, action: 'Reports' });
    } else if (daysUntilStart > 0 && daysUntilStart <= 7) {
      _termAlerts.push({ tone: 'blue', icon: 'fa-calendar-check', text: `${currentTerm.term_name} starts in ${_days(daysUntilStart)}`, note: 'Check classes, teachers and enrollment are ready.', href: '/common/manageRecords', action: 'Review' });
    }
  }
  const _attention = (_ins && Array.isArray(_ins.attention)) ? _termAlerts.concat(_ins.attention) : (_termAlerts.length ? _termAlerts : null);
  const _activity = (_ins && Array.isArray(_ins.activity)) ? _ins.activity : null;
  const _kpis = (_ins && Array.isArray(_ins.kpis)) ? _ins.kpis : [];
  const _timeAgo = (d) => {
    const m = Math.max(0, Math.round((Date.now() - new Date(d).getTime()) / 60000));
    if (m < 1) return 'just now';
    if (m < 60) return m + ' min ago';
    const h = Math.round(m / 60); if (h < 24) return h + ' hr ago';
    const dd = Math.round(h / 24); if (dd < 7) return dd + (dd === 1 ? ' day ago' : ' days ago');
    return _fmtDate(d);
  };
%>
<link rel="stylesheet" href="<%= assetUrl('/css/workspace.css') %>" />
<script src="<%= assetUrl('/js/workspace.js') %>"></script>
<div id="orgDashboardSection">
  <div id="ann-dashboard-notices" class="ann-dashboard-notices ann-dashboard-notices--org" aria-label="Announcements"></div>
  <div class="dashboard-grid">
    <div class="od" data-od>

      <!-- Enrolled classes + school year -->
      <div class="od-pair">
        <section class="od-card" data-od-classes data-od-section="classes" data-od-label="Enrolled classes" aria-label="Enrolled classes">
          <div class="od-card__head">
            <h2 class="od-card__title"><i class="fa-solid fa-chalkboard-user" aria-hidden="true"></i> Enrolled Classes <span class="od-count"><%= uniqueSortedClasses.length %></span></h2>
          </div>
          <% if (uniqueSortedClasses.length) { %>
            <% classSections.forEach(function(section, sectionIndex) { %>
              <% classRowGroupsFor(section).forEach(function(group) { %>
                <div class="od-cols">
                  <% [group.left, group.right].filter((col) => col.length).forEach(function(col) { %>
                    <ul class="od-col">
                      <% col.forEach(function(cls) {
                        const teachers = (cls.employees || []).filter((emp) => emp && emp.name && String(emp.name).trim())
                          .sort((a, b) => (b.main ? 1 : 0) - (a.main ? 1 : 0));
                        const lead = teachers[0];
                        const leadFirst = lead ? (String(lead.first_name || '').trim() || String(lead.name).split(/[ ,]+/).filter(Boolean).pop() || lead.name) : '';
                      %>
                        <li class="od-crow">
                          <a class="od-crow__name" href="/common/classDashboard?classId=<%= cls.class_id %>" title="Open <%= cls.class_name %>"><%= cls.class_name %></a>
                          <% if (teachers.length) { %>
                            <details class="od-teachers">
                              <summary title="Show teachers">
                                <i class="fa-regular fa-user" aria-hidden="true"></i>
                                <span class="od-teachers__lead"><%= leadFirst %></span>
                                <% if (teachers.length > 1) { %><span class="od-teachers__extra">+<%= teachers.length - 1 %></span><% } %>
                                <i class="fa-solid fa-chevron-down od-teachers__caret" aria-hidden="true"></i>
                              </summary>
                              <ul>
                                <% teachers.forEach(function(emp) { %>
                                  <li class="od-teacher">
                                    <% if (_canEditStaff && emp.user_id) { %><a class="od-teacher__name" href="/common/employeeDetails?userId=<%= emp.user_id %>"><%= emp.name %></a><% } else { %><span><%= emp.name %></span><% } %>
                                    <% if (emp.main) { %><span class="od-tag od-tag--main">Main</span><% } %>
                                    <% if (emp.reset_password_token) { %><span class="od-tag od-tag--pending" title="Has not set a password yet">Invite pending</span><% } %>
                                    <% if (emp.on_hold) { %><span class="od-tag od-tag--hold">On hold</span><% } %>
                                  </li>
                                <% }) %>
                              </ul>
                            </details>
                          <% } else { %>
                            <span class="od-noteacher"><i class="fa-solid fa-circle-exclamation" aria-hidden="true"></i> No teacher yet</span>
                          <% } %>
                          <% if (_canEditStaff) { %>
                            <a class="od-crow__edit" href="/common/createEmployee?classId=<%= cls.class_id %>" title="<%= teachers.length ? 'Add another teacher to ' : 'Add a teacher to ' %><%= cls.class_name %>" aria-label="Add a teacher to <%= cls.class_name %>"><i class="fa-solid fa-pencil" aria-hidden="true"></i></a>
                          <% } %>
                        </li>
                      <% }) %>
                    </ul>
                  <% }) %>
                </div>
              <% }) %>
              <% if (sectionIndex < classSections.length - 1) { %><hr class="od-divider" /><% } %>
            <% }) %>
          <% } else if (_roleKey === 'teacher') { %>
            <p class="od-empty">You are not assigned to any classes yet.</p>
          <% } else { %>
            <p class="od-empty">
              No classes have been set up for this term yet. <a href="/enrollment/manageEnrollment">Enroll classes for this term</a>,
              or <a href="/common/manageClassSubjectAndGradYr">create classes for your organization</a> if you haven't done so already.
            </p>
          <% } %>
        </section>

        <section class="od-card" data-od-section="year" data-od-label="Current school year" aria-label="Current school year">
          <div class="od-card__head">
            <h2 class="od-card__title"><i class="fa-regular fa-calendar" aria-hidden="true"></i> School Year <span class="od-chip"><%= schoolYear.year_label %></span></h2>
            <span class="od-today" title="Organization country: <%= dashboardCountryName || dashboardCountryCode || '—' %>">
              <% if (dashboardCountryFlagUrl) { %><img src="<%= dashboardCountryFlagUrl %>" alt="" width="20" height="15"><% } else { %><i class="fa-solid fa-earth-africa" aria-hidden="true"></i><% } %>
              <%= dashboardTodayLabel %>
            </span>
          </div>

          <div class="od-term">
            <div>
              <span class="od-eyebrow">Current term</span>
              <strong class="od-term__name"><%= currentTerm.term_name %></strong>
            </div>
            <% if (daysUntilStart > 0) { %>
              <span class="od-pill od-pill--upcoming">Starts in&nbsp;<span id="daysUntilStart"><%= daysUntilStart %></span>&nbsp;<%= daysUntilStart === 1 ? 'day' : 'days' %></span>
            <% } else if (daysUntilEnd >= 0) { %>
              <span class="od-pill od-pill--live"><span id="daysUntilEnd"><%= daysUntilEnd %></span>&nbsp;<%= daysUntilEnd === 1 ? 'day' : 'days' %> left</span>
            <% } else { %>
              <span class="od-pill od-pill--ended">Ended <%= _days(Math.abs(daysUntilEnd)) %> ago</span>
            <% } %>
          </div>

          <div class="term-duration" title="<%= _termPct %>% of <%= currentTerm.term_name %> complete">
            <div class="term-duration__row">
              <div class="term-duration__bar" role="progressbar" aria-label="Term progress" aria-valuemin="0" aria-valuemax="100" aria-valuenow="<%= _termPct %>"><span style="width: <%= _termPct %>%"></span></div>
              <span class="term-duration__pct"><%= _termPct %>%</span>
            </div>
            <div class="term-duration__meta">
              <span><%= _fmtDate(currentTerm.start_date) %></span>
              <strong><% if (daysUntilStart > 0) { %>Not started<% } else if (daysUntilEnd < 0) { %>Term complete<% } else { %>Day <%= Math.min(_termDays, Math.max(1, Math.ceil((_today - _termStart) / _dayMs))) %> of <%= _termDays %><% } %></strong>
              <span><%= _fmtDate(currentTerm.end_date) %></span>
            </div>
          </div>

          <% if (daysUntilEnd < 0) { %>
            <div class="od-next">
              <% if (nextTermSuggestion && canManageTermSwitch) { %>
                <span class="od-next__text">This term has ended. Make the next term current in Manage Records.</span>
                <a class="od-btn od-btn--primary" href="/common/manageRecords" title="Open Manage Records and select Current on <%= nextTermSuggestion.term_name %> (<%= nextTermSuggestion.year_label %>).">
                  Switch to <%= nextTermSuggestion.term_name %> · <%= nextTermSuggestion.year_label %>
                  <i class="fa-solid fa-arrow-right" aria-hidden="true"></i>
                </a>
              <% } else { %>
                <span class="od-next__text">This term has ended. Activate the next term/semester.</span>
              <% } %>
            </div>
          <% } %>
        </section>
      </div>

      <% if (_kpis.length) { %>
      <!-- Numbers -->
      <div class="od-kpis">
        <% _kpis.forEach(function(k) { const tag = k.href ? 'a' : 'div'; %>
          <<%= tag %> class="od-kpi od-kpi--<%= k.key %>" data-od-section="kpi-<%= k.key %>" data-od-label="<%= k.label %>"<% if (k.href) { %> href="<%= k.href %>"<% } %>>
            <span class="od-kpi__icon"><i class="fa-solid <%= k.icon %>" aria-hidden="true"></i></span>
            <span class="od-kpi__body">
              <span class="od-kpi__label"><%= k.label %></span>
              <span class="od-kpi__value"><%= k.value %></span>
              <% if (k.progress !== null && k.progress !== undefined) { %><span class="od-kpi__bar"><span style="width: <%= Math.min(100, k.progress) %>%"></span></span><% } %>
              <span class="od-kpi__note"><%= k.note %></span>
            </span>
          </<%= tag %>>
        <% }) %>
      </div>
      <% } %>

      <!-- Events + announcements -->
      <div class="od-pair">
        <%
          const _eventHead = (event) => {
            const d = event.event_date ? new Date(event.event_date) : null;
            const t = event.start_time && !event.all_day ? new Date('2000-01-01T' + String(event.start_time).slice(0, 5)).toLocaleTimeString('en-US', { hour: 'numeric', minute: '2-digit' }) : '';
            return {
              month: d ? d.toLocaleDateString('en-US', { month: 'short' }) : '—',
              day: d ? d.getDate() : '',
              meta: (d ? _fmtDate(event.event_date) : 'No date') + (t ? ' · ' + t : '') + (event.location ? ' · ' + event.location : ''),
              details: String(event.details || '').trim(),
            };
          };
          // School events plus this person's own dated items (tasks due, personal events) for "Upcoming".
          const _pad2 = (n) => String(n).padStart(2, '0');
          const _myUpcoming = (((typeof viewerActivity !== 'undefined' && viewerActivity) || {}).upcoming || []).map((u) => {
            const d = new Date(u.event_date);
            return {
              name: u.name, event_date: u.event_date, start_time: u.start_time, all_day: u.all_day, location: u.location, details: '',
              _kind: u.kind,
              _goto: u.kind === 'task' ? 'task-' + u.id : null,
              _href: u.kind === 'task' ? null : '/common/calendar?date=' + d.getFullYear() + '-' + _pad2(d.getMonth() + 1) + '-' + _pad2(d.getDate()),
            };
          });
          const _upcomingAll = upcomingEvents.concat(_myUpcoming).sort((a, b) => (new Date(a.event_date) - new Date(b.event_date)) || String(a.start_time || '').localeCompare(String(b.start_time || '')));
          const _KIND = { task: 'Task', personal: 'Personal' };
        %>
        <% const _eventList = (list, isPast) => { %>
          <ul class="od-list">
            <% list.forEach(function(event, index) { const ev = _eventHead(event); %>
              <li class="od-event<%= isPast ? ' od-event--past' : '' %><%= index >= _LIST_LIMIT ? ' od-extra' : '' %>">
                <% if (ev.details) { %>
                  <details>
                    <summary>
                      <span class="od-date"><span class="od-date__m"><%= ev.month %></span><span class="od-date__d"><%= ev.day %></span></span>
                      <span class="od-event__body"><span class="od-event__name"><%= event.name %></span><span class="od-event__meta"><%= ev.meta %></span></span>
                      <i class="fa-solid fa-chevron-down od-event__caret" aria-hidden="true"></i>
                    </summary>
                    <p class="od-event__details"><%= ev.details %></p>
                  </details>
                <% } else if (event._href || event._goto) { %>
                  <<%= event._goto ? 'button type="button"' : 'a' %> class="od-event__row od-event__row--link od-event--<%= event._kind %>" <% if (event._goto) { %>data-od-goto="<%= event._goto %>"<% } else { %>href="<%= event._href %>"<% } %>>
                    <span class="od-date"><span class="od-date__m"><%= ev.month %></span><span class="od-date__d"><%= ev.day %></span></span>
                    <span class="od-event__body"><span class="od-event__name"><%= event.name %></span><span class="od-event__meta"><span class="od-kind od-kind--<%= event._kind %>"><%= _KIND[event._kind] || '' %></span><%= ev.meta %></span></span>
                    <i class="fa-solid fa-chevron-right od-event__caret" aria-hidden="true"></i>
                  </<%= event._goto ? 'button' : 'a' %>>
                <% } else { %>
                  <div class="od-event__row">
                    <span class="od-date"><span class="od-date__m"><%= ev.month %></span><span class="od-date__d"><%= ev.day %></span></span>
                    <span class="od-event__body"><span class="od-event__name"><%= event.name %></span><span class="od-event__meta"><%= ev.meta %></span></span>
                  </div>
                <% } %>
              </li>
            <% }) %>
          </ul>
          <% if (list.length > _LIST_LIMIT) { %>
            <button type="button" class="od-showall" data-od-showall data-more="Show all <%= list.length %>">Show all <%= list.length %></button>
          <% } %>
        <% } %>

        <% if (userRole !== "teacher") { %>
        <section class="od-card" data-od-section="events" data-od-label="Events" aria-label="Events">
          <div class="od-card__head">
            <h2 class="od-card__title"><i class="fa-regular fa-calendar" aria-hidden="true"></i> Events <span class="od-count"><%= _allEvents.length %></span></h2>
            <span class="od-card__links">
              <a class="od-link" href="/common/calendar">Calendar</a>
              <% if (_canPublish) { %><a class="od-link" href="/common/manageEventsAnnouncements">Manage</a><% } %>
            </span>
          </div>
          <% if (_upcomingAll.length) { %>
            <h3 class="od-sublabel">Upcoming</h3>
            <% _eventList(_upcomingAll, false) %>
          <% } else { %>
            <p class="od-empty">Nothing coming up.</p>
          <% } %>
          <% if (pastEvents.length) { %>
            <details class="od-past"<%= _upcomingAll.length ? '' : ' open' %>>
              <summary><i class="fa-solid fa-chevron-right" aria-hidden="true"></i> Past events <span class="od-count"><%= pastEvents.length %></span></summary>
              <% _eventList(pastEvents, true) %>
            </details>
          <% } %>
        </section>
        <% } %>

        <%
          const _act = (typeof viewerActivity !== 'undefined' && viewerActivity) ? viewerActivity : { tasks: [], taggedEvents: [] };
          const _me = typeof workspaceActorId !== 'undefined' ? Number(workspaceActorId) : 0;
          const _escHtml = (v) => String(v == null ? '' : v).replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
          const _mentionify = (text) => _escHtml(text).replace(/(^|\s)@([A-Z][\w'’-]*(?: [A-Z][\w'’-]*)?)/g, '$1<span class="od-mention">@$2</span>');
          const _taskState = (t) => {
            const total = (t.assignees || []).length;
            const done = (t.assignees || []).filter((a) => a.status === 'done').length;
            const isAssignee = (t.assignees || []).some((a) => Number(a.id) === _me);
            const myDone = t.my_status === 'done';
            const allDone = total > 0 && done === total;
            return { total, done, isAssignee, myDone, allDone, isCreator: Number(t.created_by) === _me, closed: isAssignee ? myDone : allDone };
          };
          const _tasks = (_act.tasks || []).slice().sort((a, b) => {
            const sa = _taskState(a), sb = _taskState(b);
            if (sa.closed !== sb.closed) return sa.closed ? 1 : -1;
            const da = a.due_date ? new Date(a.due_date).getTime() : Infinity, db = b.due_date ? new Date(b.due_date).getTime() : Infinity;
            if (da !== db) return da - db;
            return new Date(b.updated_at) - new Date(a.updated_at);
          });
          const _openForMe = _tasks.filter((t) => !_taskState(t).closed).length + (_act.taggedEvents || []).length;
          const _defaultTab = _openForMe || !_allAnnouncements.length ? 'you' : 'ann';
          const _dueLabel = (t) => {
            if (!t.due_date) return '';
            const d = new Date(t.due_date);
            const today = new Date(); today.setHours(0, 0, 0, 0);
            const diff = Math.round((new Date(d.getFullYear(), d.getMonth(), d.getDate()) - today) / 86400000);
            const day = diff === 0 ? 'Today' : diff === 1 ? 'Tomorrow' : diff === -1 ? 'Yesterday' : d.toLocaleDateString('en-US', { weekday: 'short', month: 'short', day: 'numeric' });
            const time = t.due_time ? ' · ' + new Date('2000-01-01T' + String(t.due_time).slice(0, 5)).toLocaleTimeString('en-US', { hour: 'numeric', minute: '2-digit' }) : '';
            return { text: 'Due ' + day + time, overdue: diff < 0 };
          };
        %>
        <section class="od-card od-activity-card" data-od-section="announcements" data-od-label="Activity & announcements" aria-label="Activity and announcements" data-od-feed data-od-me="<%= _me %>">
          <div class="od-card__head">
            <h2 class="od-card__title"><i class="fa-solid fa-bolt" aria-hidden="true"></i> Activity &amp; Announcements</h2>
            <% if (_wsMember) { %><button type="button" class="od-link od-newtask" data-ws-compose="task"><i class="fa-solid fa-plus" aria-hidden="true"></i> New task</button><% } %>
          </div>

          <div class="od-tabs" role="tablist">
            <button type="button" class="od-tab<%= _defaultTab === 'you' ? ' is-active' : '' %>" role="tab" data-od-tab="you" aria-selected="<%= _defaultTab === 'you' %>">For you <% if (_openForMe) { %><span class="od-count"><%= _openForMe %></span><% } %></button>
            <button type="button" class="od-tab<%= _defaultTab === 'ann' ? ' is-active' : '' %>" role="tab" data-od-tab="ann" aria-selected="<%= _defaultTab === 'ann' %>">Announcements <span class="od-count"><%= _allAnnouncements.length %></span></button>
            <% if (_canPublish) { %><a class="od-link od-tabs__manage" href="/common/calendar">Calendar</a><% } %>
          </div>

          <div class="od-tabpane" data-od-pane="you"<%= _defaultTab === 'you' ? '' : ' hidden' %>>
            <% if (!_tasks.length && !(_act.taggedEvents || []).length) { %>
              <div class="od-feed-empty">
                <i class="fa-regular fa-circle-check" aria-hidden="true"></i>
                <p>You're all caught up.</p>
                <span>Tasks assigned to you and events you're tagged in show up here.</span>
              </div>
            <% } %>

            <% if ((_act.taggedEvents || []).length) { %>
              <ul class="od-list od-tagged">
                <% _act.taggedEvents.forEach(function(ev) {
                  const d = new Date(ev.event_date);
                  const when = d.toLocaleDateString('en-US', { weekday: 'short', month: 'short', day: 'numeric' }) + (!ev.all_day && ev.start_time ? ' · ' + new Date('2000-01-01T' + String(ev.start_time).slice(0, 5)).toLocaleTimeString('en-US', { hour: 'numeric', minute: '2-digit' }) : '');
                  const key = d.getFullYear() + '-' + String(d.getMonth() + 1).padStart(2, '0') + '-' + String(d.getDate()).padStart(2, '0');
                %>
                  <li class="od-tagged__item">
                    <span class="od-date"><span class="od-date__m"><%= d.toLocaleDateString('en-US', { month: 'short' }) %></span><span class="od-date__d"><%= d.getDate() %></span></span>
                    <span class="od-event__body">
                      <span class="od-tagged__label"><i class="fa-solid fa-user-tag" aria-hidden="true"></i> <%= ev.kind === 'personal' && ev.owner_name ? ev.owner_name + ' added you' : "You're added" %></span>
                      <a class="od-event__name od-tagged__name" href="/common/calendar?date=<%= key %>"><%= ev.name %></a>
                      <span class="od-event__meta"><%= when %><%= ev.location ? ' · ' + ev.location : '' %></span>
                    </span>
                  </li>
                <% }) %>
              </ul>
            <% } %>

            <% const _taskList = (list) => { %>
              <ul class="od-list od-tasks">
                <% list.forEach(function(t, index) {
                  const st = _taskState(t);
                  const due = _dueLabel(t);
                  const others = (t.assignees || []);
                %>
                  <li class="od-task<%= st.closed ? ' is-done' : '' %><%= index >= 5 ? ' od-extra' : '' %>" id="task-<%= t.task_id %>" data-task-id="<%= t.task_id %>">
                    <div class="od-task__row">
                      <% if (st.isAssignee || st.isCreator) { %>
                        <button type="button" class="od-task__check" data-task-done aria-pressed="<%= st.closed %>" title="<%= st.closed ? 'Mark as not done' : (st.isAssignee ? 'Mark done' : 'Mark complete for everyone') %>">
                          <i class="fa-solid fa-check" aria-hidden="true"></i>
                        </button>
                      <% } %>
                      <div class="od-task__main">
                        <div class="od-task__title"><%= t.title %></div>
                        <div class="od-task__meta">
                          <% if (st.isCreator && !st.isAssignee) { %>
                            <span class="od-task__people"><% others.forEach(function(a) { %><span class="od-person<%= a.status === 'done' ? ' is-done' : '' %>" title="<%= a.name %><%= a.status === 'done' ? ' · done' : ' · open' %>"><% if (a.status === 'done') { %><i class="fa-solid fa-check" aria-hidden="true"></i><% } %><%= a.first || a.name %></span><% }) %></span>
                          <% } else { %>
                            <span>From <%= st.isCreator ? 'you' : (t.created_by_name || 'a colleague') %><%= others.length > 1 ? ' · with ' + others.filter((a) => Number(a.id) !== _me).map((a) => a.first || a.name).join(', ') : '' %></span>
                          <% } %>
                          <% if (due) { %><span class="od-task__due<%= due.overdue && !st.closed ? ' is-late' : '' %>"><i class="fa-regular fa-clock" aria-hidden="true"></i> <%= due.text %></span><% } %>
                          <% if (t.priority === 'high') { %><span class="od-task__flag">High</span><% } %>
                          <% if (st.total > 1) { %><span><%= st.done %>/<%= st.total %> done</span><% } %>
                        </div>
                        <% if (t.details && String(t.details).trim() !== String(t.title).trim()) { %>
                          <p class="od-task__details"><%- _mentionify(t.details) %></p>
                        <% } %>
                        <div class="od-task__bar">
                          <span class="od-reacts" data-reacts>
                            <% (t.reactions || []).forEach(function(r) { %>
                              <button type="button" class="od-react<%= r.mine ? ' is-mine' : '' %>" data-react="<%= r.emoji %>"><%= r.emoji %> <span><%= r.n %></span></button>
                            <% }) %>
                          </span>
                          <span class="od-react-pick">
                            <button type="button" class="od-task__act" data-react-open aria-label="Add a reaction" title="React"><i class="fa-regular fa-face-smile" aria-hidden="true"></i></button>
                            <span class="od-react-menu" hidden>
                              <% ['👍', '✅', '🙌', '❤️', '👀'].forEach(function(e) { %><button type="button" data-react="<%= e %>"><%= e %></button><% }) %>
                            </span>
                          </span>
                          <button type="button" class="od-task__act" data-thread-toggle>
                            <i class="fa-regular fa-comment" aria-hidden="true"></i> Reply<% if (t.comment_count) { %> · <span data-comment-count><%= t.comment_count %></span><% } %>
                          </button>
                        </div>
                        <div class="od-thread" data-thread hidden>
                          <ul class="od-thread__list" data-thread-list></ul>
                          <form class="od-thread__form" data-thread-form>
                            <input type="text" class="od-thread__input" name="body" placeholder="Write a reply…" maxlength="2000" autocomplete="off" aria-label="Write a reply">
                            <button type="submit" class="od-thread__send" aria-label="Send reply"><i class="fa-solid fa-paper-plane" aria-hidden="true"></i></button>
                          </form>
                        </div>
                      </div>
                    </div>
                  </li>
                <% }) %>
              </ul>
              <% if (list.length > 5) { %>
                <button type="button" class="od-showall" data-od-showall data-more="Show all <%= list.length %>">Show all <%= list.length %></button>
              <% } %>
            <% } %>
            <% const _toMe = _tasks.filter((t) => _taskState(t).isAssignee); const _byMe = _tasks.filter((t) => { const st = _taskState(t); return st.isCreator && !st.isAssignee; }); %>
            <div id="tasks"></div>
            <% if (_toMe.length) { %>
              <h3 class="od-sublabel od-feed-label"><i class="fa-solid fa-inbox" aria-hidden="true"></i> Assigned to you <span><%= _toMe.filter((t) => !_taskState(t).closed).length %> open</span></h3>
              <% _taskList(_toMe) %>
            <% } %>
            <% if (_byMe.length) { %>
              <h3 class="od-sublabel od-feed-label"><i class="fa-solid fa-paper-plane" aria-hidden="true"></i> You assigned <span><%= _byMe.filter((t) => !_taskState(t).closed).length %> open</span></h3>
              <% _taskList(_byMe) %>
            <% } %>
          </div>

          <div class="od-tabpane" data-od-pane="ann"<%= _defaultTab === 'ann' ? '' : ' hidden' %>>
            <% if (_allAnnouncements.length) { %>
              <ul class="od-list">
                <% _allAnnouncements.forEach(function(announcement, index) { %>
                  <li class="od-ann<%= index >= _LIST_LIMIT ? ' od-extra' : '' %>">
                    <p class="od-ann__text"><%= String(announcement.message || '') %></p>
                    <div class="od-ann__foot">
                      <span class="od-ann__date"><%= announcement.created_at ? 'Posted ' + _fmtDate(announcement.created_at) : '' %></span>
                      <button type="button" class="od-ann__toggle" data-od-expand aria-expanded="false" hidden>Read more</button>
                    </div>
                  </li>
                <% }) %>
              </ul>
              <% if (_allAnnouncements.length > _LIST_LIMIT) { %>
                <button type="button" class="od-showall" data-od-showall data-more="Show all <%= _allAnnouncements.length %>">Show all <%= _allAnnouncements.length %></button>
              <% } %>
            <% } else { %>
              <p class="od-empty">No announcements yet.</p>
            <% } %>
            <% if (_canPublish) { %><a class="od-link od-ann-manage" href="/common/manageEventsAnnouncements">Manage announcements</a><% } %>
          </div>
        </section>
      </div>

      <% if (_attention || _activity) { %>
      <!-- Needs attention + recent activity -->
      <div class="od-pair">
        <% if (_attention) { %>
        <section class="od-card" data-od-section="attention" data-od-label="Needs attention" aria-label="Needs attention">
          <div class="od-card__head">
            <h2 class="od-card__title"><i class="fa-solid fa-bell" aria-hidden="true"></i> Needs attention <% if (_attention.length) { %><span class="od-count"><%= _attention.length %></span><% } %></h2>
          </div>
          <% if (_attention.length) { %>
            <ul class="od-list">
              <% _attention.forEach(function(item) { %>
                <li class="od-alert od-alert--<%= item.tone %>">
                  <span class="od-alert__icon"><i class="fa-solid <%= item.icon %>" aria-hidden="true"></i></span>
                  <span class="od-alert__body">
                    <span class="od-alert__text"><%= item.text %></span>
                    <% if (item.note) { %><span class="od-alert__note"><%= item.note %></span><% } %>
                    <% if (item.links && item.links.length) { %>
                      <span class="od-alert__links">
                        <% item.links.forEach(function(l) { %><a href="<%= l.href %>"><%= l.label %></a><% }) %>
                        <% if (item.more) { %><span>+<%= item.more %> more</span><% } %>
                      </span>
                    <% } %>
                  </span>
                  <% if (item.href && String(item.href).startsWith('/common/orgDashboard#')) { %><button type="button" class="od-link od-alert__action" data-od-goto="<%= String(item.href).split('#')[1] %>"><%= item.action || 'Open' %></button><% } else if (item.href) { %><a class="od-link od-alert__action" href="<%= item.href %>"><%= item.action || 'Open' %></a><% } %>
                </li>
              <% }) %>
            </ul>
          <% } else { %>
            <p class="od-allclear"><i class="fa-solid fa-circle-check" aria-hidden="true"></i> All clear. Nothing needs your attention right now.</p>
          <% } %>
        </section>
        <% } %>

        <% if (_activity) { %>
        <section class="od-card" data-od-section="activity" data-od-label="Recent activity" aria-label="Recent activity">
          <div class="od-card__head">
            <h2 class="od-card__title"><i class="fa-solid fa-clock-rotate-left" aria-hidden="true"></i> Recent activity
              <span class="od-scope"><%= { all: 'Everyone', 'no-managers': 'Staff', mine: 'Just you' }[(_ins && _ins.activityScope) || 'mine'] %></span></h2>
            <% if (_perm('manage_reports') && _feat('Terminal Report', 'Progressive Student Report', 'Progressive Student Report ', 'Class Base Merit Sheet', 'Class Base Merrit sheet', 'Official School Transcript')) { %>
              <a class="od-link" href="/common/reports?panel=activity-logs&page=%2Fcommon%2FactivityLogs&label=View%20Activity%20Logs">View all</a>
            <% } %>
          </div>
          <% if (_activity.length) { %>
            <ul class="od-list">
              <% _activity.forEach(function(log) { const who = String(log.user_name || 'Someone'); %>
                <li class="od-activity">
                  <span class="od-activity__avatar" aria-hidden="true"><%= who.trim().charAt(0).toUpperCase() || '?' %></span>
                  <span class="od-activity__body">
                    <span class="od-activity__text"><strong><%= who %></strong> <%= log.description || [log.action_type, log.module_name].filter(Boolean).join(' · ') %></span>
                    <span class="od-activity__meta"><%= log.module_name || '' %><%= log.module_name ? ' · ' : '' %><%= _timeAgo(log.created_at) %></span>
                  </span>
                </li>
              <% }) %>
            </ul>
          <% } else { %>
            <p class="od-empty">No activity yet.</p>
          <% } %>
        </section>
        <% } %>
      </div>
      <% } %>
    </div>
  </div>
</div>

<script>
  (function () {
    const root = document.querySelector('[data-od]');
    const tools = document.querySelector('[data-od-tools]');
    if (!root || root.dataset.ready === '1') return;
    root.dataset.ready = '1';
    const viewer = tools ? tools.dataset.odViewer : 'me';
    const HIDDEN_KEY = 'od:hidden:' + viewer;
    const USE_KEY = 'od:qa-use:' + viewer;
    const read = (key, fallback) => { try { return JSON.parse(localStorage.getItem(key)) || fallback; } catch (_e) { return fallback; } };
    const write = (key, value) => { try { localStorage.setItem(key, JSON.stringify(value)); } catch (_e) {} };

    // ---- Lists: show all, read more ----
    root.addEventListener('click', function (e) {
      const more = e.target.closest('[data-od-showall]');
      if (more) {
        const list = more.previousElementSibling;
        if (!list) return;
        const open = list.classList.toggle('is-expanded');
        more.textContent = open ? 'Show less' : more.dataset.more;
        return;
      }
      const expand = e.target.closest('[data-od-expand]');
      if (expand) {
        const item = expand.closest('.od-ann');
        const open = item.classList.toggle('is-open');
        expand.textContent = open ? 'Show less' : 'Read more';
        expand.setAttribute('aria-expanded', open ? 'true' : 'false');
      }
    });
    root.querySelectorAll('.od-ann').forEach(function (item) {
      const text = item.querySelector('.od-ann__text');
      const btn = item.querySelector('[data-od-expand]');
      if (text && btn && text.scrollHeight > text.clientHeight + 2) btn.hidden = false;
    });

    // ---- Teacher lists: one open at a time ----
    const teacherLists = root.querySelectorAll('.od-teachers');
    teacherLists.forEach(function (d) {
      d.addEventListener('toggle', function () {
        if (d.open) teacherLists.forEach(function (o) { if (o !== d) o.open = false; });
      });
    });

    // ---- Dropdowns (quick actions, customize) ----
    const dropdowns = tools ? Array.from(tools.querySelectorAll('[data-od-dd]')) : [];
    const closeAll = (except) => dropdowns.forEach(function (dd) {
      if (dd === except) return;
      dd.classList.remove('is-open');
      dd.querySelector('[data-od-dd-panel]').hidden = true;
      dd.querySelector('[data-od-dd-toggle]').setAttribute('aria-expanded', 'false');
    });
    dropdowns.forEach(function (dd) {
      const btn = dd.querySelector('[data-od-dd-toggle]');
      const panel = dd.querySelector('[data-od-dd-panel]');
      btn.addEventListener('click', function (e) {
        e.stopPropagation();
        const open = panel.hidden;
        closeAll(dd);
        teacherLists.forEach(function (d) { d.open = false; });
        panel.hidden = !open;
        dd.classList.toggle('is-open', open);
        btn.setAttribute('aria-expanded', open ? 'true' : 'false');
      });
    });
    document.addEventListener('click', function (e) {
      if (!document.body.contains(root)) return;
      if (!e.target.closest('[data-od-dd]')) closeAll();
      if (!e.target.closest('.od-teachers')) teacherLists.forEach(function (d) { d.open = false; });
    });
    document.addEventListener('keydown', function (e) {
      if (e.key !== 'Escape' || !document.body.contains(root)) return;
      closeAll();
      teacherLists.forEach(function (d) { d.open = false; });
    });

    // ---- Quick actions: most used first ----
    const qa = tools && tools.querySelector('[data-od-qa]');
    if (qa) {
      const uses = read(USE_KEY, {});
      Array.from(qa.children)
        .sort(function (a, b) {
          return ((uses[b.dataset.qaKey] || 0) - (uses[a.dataset.qaKey] || 0)) || (a.dataset.qaIndex - b.dataset.qaIndex);
        })
        .forEach(function (li, i) { li.classList.toggle('od-qa--more', i >= 6); qa.appendChild(li); });
      const allBtn = tools.querySelector('[data-od-qa-all]');
      if (allBtn) allBtn.addEventListener('click', function (e) {
        e.stopPropagation();
        const all = qa.classList.toggle('is-all');
        allBtn.textContent = all ? 'Show fewer' : 'Show all ' + qa.children.length;
      });
      // Count on pointerdown/Enter: the SPA router swallows link clicks before they bubble here.
      const countUse = function (e) {
        if (e.type === 'keydown' && e.key !== 'Enter') return;
        const li = e.target.closest('[data-qa-key]');
        if (!li) return;
        const counts = read(USE_KEY, {});
        counts[li.dataset.qaKey] = (counts[li.dataset.qaKey] || 0) + 1;
        write(USE_KEY, counts);
      };
      qa.addEventListener('pointerdown', countUse);
      qa.addEventListener('keydown', countUse);
    }

    // ---- Activity & Announcements ----
    const feed = root.querySelector('[data-od-feed]');
    const canPublishFlag = <%= _perm('publish_events_announcements') ? 'true' : 'false' %>;
    const hasWebsiteFlag = <%= _hasWebsite ? 'true' : 'false' %>;
    const escText = (v) => String(v == null ? '' : v).replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
    const postJson = (url, body) => fetch(url, {
      method: 'POST', credentials: 'same-origin',
      headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
      body: JSON.stringify(body || {}),
    }).then((r) => r.json().catch(() => ({})).then((d) => { if (!r.ok || d.success === false) throw new Error(d.error || 'Something went wrong.'); return d; }));
    const say = (msg) => { if (window.Workspace) window.Workspace.toast(msg); };
    function detectClamp(scope) {
      (scope || root).querySelectorAll('.od-ann').forEach(function (item) {
        const text = item.querySelector('.od-ann__text');
        const btn = item.querySelector('[data-od-expand]');
        if (text && btn && !item.classList.contains('is-open')) btn.hidden = !(text.scrollHeight > text.clientHeight + 2);
      });
    }
    function timeAgoShort(iso) {
      const m = Math.max(0, Math.round((Date.now() - new Date(iso).getTime()) / 60000));
      if (m < 1) return 'just now';
      if (m < 60) return m + 'm';
      const h = Math.round(m / 60); if (h < 24) return h + 'h';
      return new Date(iso).toLocaleDateString(undefined, { month: 'short', day: 'numeric' });
    }
    function commentHtml(c) {
      const name = c.author_name || 'Someone';
      const init = name.split(/\s+/).filter(Boolean).slice(0, 2).map((p) => p[0]).join('').toUpperCase();
      return `<li class="od-comment"><span class="od-comment__avatar">${escText(init)}</span><span class="od-comment__body"><span class="od-comment__who">${escText(name)}<small>${escText(timeAgoShort(c.created_at))}</small></span><span class="od-comment__text">${escText(c.body)}</span></span></li>`;
    }
    async function openThread(task, focus) {
      const thread = task.querySelector('[data-thread]');
      thread.hidden = false;
      const list = thread.querySelector('[data-thread-list]');
      if (!thread.dataset.loaded) {
        list.innerHTML = '<li class="od-comment__text" style="color:#94a3b8">Loading…</li>';
        try {
          const r = await fetch(`/common/tasks/${task.dataset.taskId}/comments`, { credentials: 'same-origin', headers: { Accept: 'application/json' } });
          const d = await r.json();
          list.innerHTML = (d.comments || []).map(commentHtml).join('');
          thread.dataset.loaded = '1';
        } catch (_e) { list.innerHTML = ''; }
      }
      if (focus) thread.querySelector('input').focus();
    }
    if (feed) {
      feed.addEventListener('click', async function (e) {
        const tab = e.target.closest('[data-od-tab]');
        if (tab) {
          feed.querySelectorAll('[data-od-tab]').forEach((t) => { const on = t === tab; t.classList.toggle('is-active', on); t.setAttribute('aria-selected', on ? 'true' : 'false'); });
          feed.querySelectorAll('[data-od-pane]').forEach((p) => { p.hidden = p.dataset.odPane !== tab.dataset.odTab; });
          detectClamp(feed);
          return;
        }
        const task = e.target.closest('[data-task-id]');
        if (!task) return;
        const id = task.dataset.taskId;

        const doneBtn = e.target.closest('[data-task-done]');
        if (doneBtn) {
          const done = doneBtn.getAttribute('aria-pressed') !== 'true';
          doneBtn.setAttribute('aria-pressed', done ? 'true' : 'false');
          task.classList.toggle('is-done', done);
          try { await postJson(`/common/tasks/${id}/status`, { done }); say(done ? 'Marked done' : 'Marked not done'); }
          catch (err) { doneBtn.setAttribute('aria-pressed', done ? 'false' : 'true'); task.classList.toggle('is-done', !done); say(err.message); }
          return;
        }
        const pickBtn = e.target.closest('[data-react-open]');
        if (pickBtn) {
          const menu = pickBtn.parentElement.querySelector('.od-react-menu');
          root.querySelectorAll('.od-react-menu').forEach((m) => { if (m !== menu) m.hidden = true; });
          menu.hidden = !menu.hidden;
          return;
        }
        const reactBtn = e.target.closest('[data-react]');
        if (reactBtn) {
          task.querySelectorAll('.od-react-menu').forEach((m) => { m.hidden = true; });
          try {
            const d = await postJson(`/common/tasks/${id}/react`, { emoji: reactBtn.dataset.react });
            task.querySelector('[data-reacts]').innerHTML = (d.reactions || []).map((r) => `<button type="button" class="od-react${r.mine ? ' is-mine' : ''}" data-react="${escText(r.emoji)}">${escText(r.emoji)} <span>${r.n}</span></button>`).join('');
          } catch (err) { say(err.message); }
          return;
        }
        if (e.target.closest('[data-thread-toggle]')) {
          const thread = task.querySelector('[data-thread]');
          if (thread.hidden) openThread(task, true); else thread.hidden = true;
        }
      });
      feed.addEventListener('submit', async function (e) {
        const form = e.target.closest('[data-thread-form]');
        if (!form) return;
        e.preventDefault();
        const input = form.querySelector('input');
        const body = input.value.trim();
        if (!body) return;
        const task = form.closest('[data-task-id]');
        input.disabled = true;
        try {
          const d = await postJson(`/common/tasks/${task.dataset.taskId}/comments`, { body });
          task.querySelector('[data-thread-list]').insertAdjacentHTML('beforeend', commentHtml(d.comment));
          input.value = '';
          const btn = task.querySelector('[data-thread-toggle]');
          const count = btn.querySelector('[data-comment-count]');
          if (count) count.textContent = Number(count.textContent || 0) + 1;
          else btn.insertAdjacentHTML('beforeend', ' · <span data-comment-count>1</span>');
        } catch (err) { say(err.message); }
        input.disabled = false;
        input.focus();
      });
      document.addEventListener('click', function (e) {
        if (!document.body.contains(root)) return;
        if (!e.target.closest('.od-react-pick')) root.querySelectorAll('.od-react-menu').forEach((m) => { m.hidden = true; });
      });
    }

    // New task / compose buttons (card button and Quick actions).
    document.addEventListener('click', function (e) {
      const trigger = e.target.closest('[data-ws-compose]');
      if (!trigger || !document.body.contains(root) || !window.Workspace) return;
      e.preventDefault();
      closeAll();
      window.Workspace.open({
        type: trigger.dataset.wsCompose, canPublish: canPublishFlag, hasWebsite: hasWebsiteFlag,
        onSaved: function () { window.location.reload(); },
      });
    });

    // Deep link from a notification: /common/orgDashboard#task-123
    function goTo(target) {
      if (!feed) return;
      const tab = feed.querySelector('[data-od-tab="you"]');
      if (tab && !tab.classList.contains('is-active')) tab.click();
      if (target === 'tasks') {
        const anchor = document.getElementById('tasks');
        if (anchor) anchor.scrollIntoView({ behavior: 'smooth', block: 'start' });
        return;
      }
      const m = String(target || '').match(/^task-(\d+)$/);
      if (!m) return;
      const task = document.getElementById('task-' + m[1]);
      if (!task) return;
      const list = task.closest('.od-list');
      if (list && task.classList.contains('od-extra')) list.classList.add('is-expanded');
      setTimeout(function () {
        task.scrollIntoView({ behavior: 'smooth', block: 'center' });
        task.classList.remove('is-flash');
        void task.offsetWidth;
        task.classList.add('is-flash');
        openThread(task, false);
      }, 120);
    }
    document.addEventListener('click', function (e) {
      const go = e.target.closest('[data-od-goto]');
      if (!go || !document.body.contains(root)) return;
      e.preventDefault();
      goTo(go.dataset.odGoto);
    });
    function openTaskFromHash() {
      const hash = String(window.location.hash || '');
      if (hash === '#tasks') { goTo('tasks'); return; }
      const m = hash.match(/^#task-(\d+)$/);
      if (!m || !feed) return;
      const task = document.getElementById('task-' + m[1]);
      if (!task) return;
      const tab = feed.querySelector('[data-od-tab="you"]');
      if (tab && !tab.classList.contains('is-active')) tab.click();
      const list = task.closest('.od-list');
      if (list && task.classList.contains('od-extra')) list.classList.add('is-expanded');
      setTimeout(function () {
        task.scrollIntoView({ behavior: 'smooth', block: 'center' });
        task.classList.remove('is-flash');
        void task.offsetWidth;
        task.classList.add('is-flash');
        openThread(task, false);
      }, 150);
    }
    openTaskFromHash();
    window.addEventListener('hashchange', function () { if (document.body.contains(root)) openTaskFromHash(); });

    // ---- Customize: choose which sections show ----
    const checks = tools && tools.querySelector('[data-od-checks]');
    const sections = Array.from(root.querySelectorAll('[data-od-section]'));
    const styleEl = () => {
      let el = document.getElementById('od-hidden-style');
      if (!el) { el = document.createElement('style'); el.id = 'od-hidden-style'; document.head.appendChild(el); }
      return el;
    };
    function applyHidden(hidden) {
      styleEl().textContent = hidden.map(function (k) { return '[data-od-section="' + k.replace(/[^a-z0-9-]/gi, '') + '"]{display:none!important}'; }).join('');
      // Hide rows whose sections are all switched off, so no empty gaps remain.
      root.querySelectorAll('.od-pair, .od-kpis').forEach(function (row) {
        const kids = Array.from(row.querySelectorAll(':scope > [data-od-section]'));
        row.classList.toggle('od-row-empty', kids.length > 0 && kids.every(function (k) { return hidden.includes(k.dataset.odSection); }));
      });
    }
    const MIN_VISIBLE = 3;
    function lockMinimum() {
      const boxes = Array.from(checks.querySelectorAll('[data-od-toggle]'));
      const on = boxes.filter((b) => b.checked);
      boxes.forEach((b) => {
        const locked = b.checked && on.length <= MIN_VISIBLE;
        b.disabled = locked;
        b.closest('.od-check').classList.toggle('is-locked', locked);
        b.closest('.od-check').title = locked ? 'Keep at least ' + MIN_VISIBLE + ' sections on your dashboard' : '';
      });
    }
    if (checks) {
      let hidden = read(HIDDEN_KEY, []).filter((k) => sections.some((s) => s.dataset.odSection === k));
      // Older saved choices may hide too much: always keep at least 3 sections visible.
      while (sections.length - hidden.length < Math.min(MIN_VISIBLE, sections.length)) hidden.pop();
      const esc = (v) => String(v).replace(/[&<>"]/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]; });
      checks.innerHTML = sections.map(function (s) {
        const key = s.dataset.odSection;
        return '<label class="od-check"><input type="checkbox" data-od-toggle="' + esc(key) + '"' + (hidden.includes(key) ? '' : ' checked') + '> ' + esc(s.dataset.odLabel || key) + '</label>';
      }).join('');
      checks.addEventListener('change', function (e) {
        const boxes = Array.from(checks.querySelectorAll('[data-od-toggle]'));
        if (boxes.filter((b) => b.checked).length < Math.min(MIN_VISIBLE, boxes.length)) {
          if (e.target) e.target.checked = true;
          if (window.Workspace) window.Workspace.toast('Keep at least ' + MIN_VISIBLE + ' sections on your dashboard');
        }
        const next = boxes.filter(function (i) { return !i.checked; }).map(function (i) { return i.dataset.odToggle; });
        write(HIDDEN_KEY, next);
        applyHidden(next);
        lockMinimum();
      });
      tools.querySelector('[data-od-reset]').addEventListener('click', function () {
        checks.querySelectorAll('[data-od-toggle]').forEach(function (i) { i.checked = true; });
        write(HIDDEN_KEY, []);
        applyHidden([]);
        lockMinimum();
      });
      applyHidden(hidden);
      lockMinimum();
    }
  })();
</script>
<% } %>
