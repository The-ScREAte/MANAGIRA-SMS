<body>
  <%- include('../partials/flash') %>

  <br />
  <div class="dashboard-buttons-wrap">
    <div class="dashboard-buttons">
      <button id="orgDashboardBtn" class="active">Org Dashboard</button>

      <% if (Array.isArray(allowedFeatures) && (allowedFeatures.includes("School Website") || allowedFeatures.includes("SchoolWebsite"))) { %>
        <button id="publicDashboardBtn" onclick="window.location.href='/common/publicDashboard?organizationId=<%= organizationId %>'">
          Public Dashboard
        </button>
      <% } %>
    </div>
  </div>

  <div class="line-divider"></div>
  <% if (adminAnnouncements && adminAnnouncements.length > 0) { %>
  <div class="admin-flash-container">
    <% adminAnnouncements.forEach(function(announcement) { %>
    <div class="admin-flash">
      <div class="admin-flash-text">
        <strong class="announcement-title"><%= announcement.title %></strong>
        <hr />
        <div class="announcement-description">
          <%= announcement.description %>
        </div>
      </div>
      <button
        onclick="this.parentElement.style.display='none'"
        class="close-btn"
      >
        ✖
      </button>
    </div>
    <% }) %>
  </div>
  <% } %>

  <div id="flashMessageContainer">
    <% if (messages.error && messages.error.length > 0) { %>
    <div class="flash-message error">
      <span><%= messages.error[0] %></span>
      <button class="close-btn" onclick="closeFlashMessage()">✖</button>
    </div>
    <% } %>
  </div>

  <div class="container org-dashboard-container">
    <% if (!schoolYear || !currentTerm) { %>
    <!-- Show the welcome message if no school year or term is set -->
    <div id="welcomeMessage" class="welcome-card">
      <h1>Welcome to Managira! 🎉</h1>
      <h3>Your trusted partner for managing it all effortlessly. 😊</h3>
      <p>
        Need to update your credentials? No problem! You can
        <a class="text-link" href="/account/update">update them</a> anytime to keep things up to
        date.
      </p>
      <p>
        Personalize your organization with ease.
        <a class="text-link" href="/account/personalization">Customize</a> it to suit your
        preferences and unique needs. This is where you can upload your logo to
        make your organization look much better. Click on the logo or the school
        name on top, anytime you want to come back to the home page.
      </p>
      <p>
        Get started by setting up a school year and a term/semester. It's simple
        and intuitive!
      </p>
      <a href="/common/manageRecords" class="start-link">Begin Your Journey Here</a>
    </div>
    <% } else { %>

    <!-- Main content when school year and term are set -->
    <div id="orgDashboardSection">

      <!-- Dashboard grid layout -->
      <div class="dashboard-grid">
        <!-- Top row: classes and school year info -->
        <div class="grid-row">
          <!-- Classes Section -->
          <!-- Classes Section -->
          <div class="classes-container" style="text-align: center">
            <h2>Enrolled Classes</h2>
            <ul>
              <% if (classes && classes.length > 0) { %>
                <% classes.forEach(function(cls) { %>
                  <li>
                    <a href="/common/classDashboard?classId=<%= cls.class_id %>"><%= cls.class_name %></a>
                    - <b>Teachers:</b>
                    <% cls.employees.forEach(function(emp, index) { %>
                      <% if (emp.main) { %><span class="main">•</span><% } %>
                      <% if (emp.reset_password_token) { %><span class="yellow-dot" title="Has not set password">•</span><% } %>
                      <% if (emp.on_hold) { %><span class="on-hold">•</span><% } %>
                      <%= emp.name %><%= index < cls.employees.length - 1 ? ' | ' : '' %>
                    <% }); %>
                  </li>
                <% }); %>
              <% } else { %>
                <% if (userRole === "Teacher") { %>
                  <li>You are not assigned to any classes yet.</li>
                <% } else { %>
                  <li>
                    No classes have been set up for this current term yet.
                    <a href="/common/manageClassSubjectAndGradYr">Create</a> classes for your organization if you haven't done so already. Otherwise, click <a href="/enrollment/manageEnrollment">here</a> to enroll a class.
                  </li>
                <% } %>
              <% } %>
            </ul>
          </div>

          <!-- School Year and Term Section -->
          <div class="school-year-info">
            <h2>Current School Year: <%= schoolYear.year_label %></h2>
            <% if (currentTerm) { %>
            <div>
              <strong><%= currentTerm.term_name %>:</strong>
              Start: <%= new
              Date(currentTerm.start_date).toISOString().split('T')[0] %>, End:
              <%= new Date(currentTerm.end_date).toISOString().split('T')[0] %>
            </div>
            <div>
              <% const today = new Date(); %> <% const daysUntilStart =
              Math.ceil((new Date(currentTerm.start_date) - today) / (1000 * 60
              * 60 * 24)); %> <% const daysUntilEnd = Math.ceil((new
              Date(currentTerm.end_date) - today) / (1000 * 60 * 60 * 24)); %>
              <% if (daysUntilStart > 0) { %>
              <strong>Days until start of term:</strong>
              <span id="daysUntilStart"><%= daysUntilStart %></span>
              <% } else { %>
              <strong>Days until end of term:</strong>
              <span id="daysUntilEnd"><%= daysUntilEnd %></span>
              <% } %>
            </div>
            <% } else { %>
            <p>No current term information available.</p>
            <% } %>
          </div>
        </div>

        <!-- Bottom row: events and announcements -->
        <div class="grid-row">
          <!-- Events Section (Hidden for Teachers) -->
          <% if (userRole !== "teacher") { %>
          <div class="events-container">
            <h2>Events</h2>
            <ul>
              <hr />
              <% if (events && events.length > 0) { %> <%
              events.forEach(function(event) { %>
              <li>
                <strong><%= event.name %></strong> - <%= new
                Date(event.event_date).toISOString().split('T')[0] %> <br /><%=
                event.details %>
                <hr />
              </li>
              <% }); %> <% } else { %>
              <li>No events found</li>
              <% } %>
            </ul>
          </div>
          <% } %>

          <!-- Announcements Section (Hidden for Managers & Supervisors) -->

          <div class="announcements-container">
            <h2>Announcements</h2>
            <ul>
              <hr />
              <% if (announcements && announcements.length > 0) { %> <%
              announcements.forEach(function(announcement) { %>
              <li><%= announcement.message %></li>
              <hr />
              <% }); %> <% } else { %>
              <li>No announcements found</li>
              <% } %>
            </ul>
          </div>
        </div>
      </div>
    </div>
    <% } %>
  </div>

  <script>
    // Hide or show the welcome message or orgDashboardSection based on schoolYear and currentTerm
    document.addEventListener('DOMContentLoaded', () => {
      const schoolYear = JSON.parse('<%- JSON.stringify(schoolYear) %>');
      const currentTerm = JSON.parse('<%- JSON.stringify(currentTerm) %>');

      if (!schoolYear || !currentTerm) {
        document.getElementById('orgDashboardSection').style.display = 'none';
        document.getElementById('welcomeMessage').style.display = 'block';
      } else {
        document.getElementById('orgDashboardSection').style.display = 'block';
        document.getElementById('welcomeMessage').style.display = 'none';
      }
    });

    function closeFlashMessage() {
      const messageBox = document.querySelector(".flash-message");
      if (messageBox) {
        messageBox.style.opacity = "0";
        setTimeout(() => messageBox.remove(), 300);
      }
    }

    // Auto-hide after 5 seconds
    setTimeout(closeFlashMessage, 5000);
  </script>

  <script>
    function dismissAdminFlash() {
      const flash = document.getElementById("admin-flash");
      if (flash) {
        flash.style.display = "none";
      }
    }
  </script>

  <style>
      :root {
        --font-family: "Inter", sans-serif;
      }


    body {
      font-family: var(--font-family);
    }
  </style>
  <style>
    .yellow-dot {
      color: rgb(204, 173, 0);
      font-size: 25px;
      margin-left: 5px;
    }

    /* Make action links stand out - use theme color */
    .classes-container li a {
      color: var(--org-primary-color);
      text-decoration: none;
      font-weight: 600;
    }

    .classes-container li a:hover {
      text-decoration: underline;
      color: var(--org-primary-hover);
    }

    /* Special styling for Create and Here links in the no-classes message */
    .classes-container li a[href="/common/manageClassSubjectAndGradYr"],
    .classes-container li a[href="/enrollment/manageEnrollment"] {
      color: var(--org-primary-color);
      font-weight: 700;
      text-decoration: underline;
    }

    .classes-container li a[href="/common/manageClassSubjectAndGradYr"]:hover,
    .classes-container li a[href="/enrollment/manageEnrollment"]:hover {
      color: var(--org-primary-hover);
      text-decoration: underline;
    }

    .close-btn {
      background: none;
      border: none;
      color: white;
      font-size: 16px;
      cursor: pointer;
      margin-left: 10px;
    }

    @keyframes fadeIn {
      from {
        opacity: 0;
        transform: translateY(10px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }
    @media (max-width: 768px) {
      /* Events and Announcements */
      .events-container,
      .announcements-container {
        padding: 10px;
        text-align: center;
      }
      .classes-container li {
        font-size: 1rem;
        padding: 8px 0;
      }
    }

    /* 🔹 Responsive Adjustments for Small Screens (Mobile) */
    @media screen and (max-width: 768px) {
      .welcome-message {
        text-align: center;
        margin: 50px auto;
        padding: 20px;
        background-color: #f9f9f9;
        border: 1px solid #ddd;
        border-radius: 10px;
        width: 90%;
        box-shadow: 0 0 10px rgba(0, 0, 0, 0.1);
      }
    }
  </style>
</body>
