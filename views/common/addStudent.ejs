        <div class="modal-header">
          <h2>📤 Bulk Import Students</h2>
          <button type="button" class="modal-close-btn" onclick="closeBulkImportModal()">×</button>
        </div>

        <div 
          id="uploadArea" 
          class="upload-area" 
          onclick="document.getElementById('bulkFileInput').click()"
          ondrop="handleFileDrop(event)"
          ondragover="handleDragOver(event)"
          ondragleave="handleDragLeave(event)"
        >
          <div class="upload-icon">📁</div>
          <div class="upload-text">Click or drag file here to upload</div>
          <div class="upload-hint">Supports: Excel (.xlsx, .xls), CSV, PDF, Word (.doc, .docx), Images (.jpg, .png)</div>
        </div>

        <input 
          type="file" 
          id="bulkFileInput" 
          class="file-input" 
          accept=".xlsx,.xls,.csv,.pdf,.doc,.docx,.jpg,.jpeg,.png"
          onchange="handleFileSelect(event)"
        />

        <div class="template-download">
          <p>📋 Need a template?</p>
          <a href="javascript:void(0)" class="template-link" onclick="downloadTemplate()">Download CSV Template</a>
        </div>

        <div id="parsingProgress" class="parsing-progress">
          <div class="spinner"></div>
          <div class="progress-text" id="progressText">Processing file...</div>
        </div>
      </div>
    </div>

  </body>
  </html>

