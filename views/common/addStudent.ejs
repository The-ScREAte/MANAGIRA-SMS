    <script id="addStudentPageData" type="application/json"><%- JSON.stringify({
      organizationId,
      hasSaveSuccessMessage: Boolean(messages && messages.success && messages.success.length),
      allSchoolYears: schoolYears,
      studentIdAutoGenerateEnabled: Boolean(studentIdSettings && studentIdSettings.use_custom_student_id && studentIdSettings.student_id_auto_generate),
      studentIdNextAvailableStart: Number(nextAvailableStudentIdNumber || (((studentIdSettings && studentIdSettings.student_id_counter) || 0) + 1))
    }).replace(/</g, '\\u003c') %></script>

    <script src="/js/dialCodes.js"></script>
    <script>
      // Helper functions for guardian autocomplete
      function escapeHtml(str) {
        return String(str || "").replace(/[&<>"']/g, (m) => ({
          "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#039;"
        }[m]));
      }

      function bindGuardianAutocomplete(guardianRow) {
        const searchInput = guardianRow.querySelector(".guardian-search");
        const suggestions = guardianRow.querySelector(".guardian-suggestions");
        const hiddenId = guardianRow.querySelector('input[type="hidden"][name^="guardianProfileId_"]');
        const badge = guardianRow.querySelector(".guardian-selected-badge");

        if (!searchInput || !suggestions || !hiddenId) {
          console.error("Guardian autocomplete elements not found", guardianRow);
          return;
        }

        let debounceTimer = null;

        async function fetchMatches(q) {
          try {
            const res = await fetch(`/common/api/guardians/search?q=${encodeURIComponent(q)}`);
            if (!res.ok) {
              console.error("Guardian search failed:", res.status);
              return { guardians: [] };
            }
            return await res.json();
          } catch (err) {
            console.error("Guardian search error:", err);
            return { guardians: [] };
          }
        }

        function closeSuggestions() {
          suggestions.classList.remove("show");
          suggestions.innerHTML = "";
        }

        function markAsSelected(guardianName) {
          guardianRow.classList.add("selected");
          if (badge) {
            badge.textContent = `✓ Selected: ${guardianName}`;
          }
        }

        function clearSelection() {
          guardianRow.classList.remove("selected");
          if (badge) badge.textContent = "";
        }

        searchInput.addEventListener("input", () => {
          const q = searchInput.value.trim();
          hiddenId.value = ""; // typing means "not selected yet"
          clearSelection();

          clearTimeout(debounceTimer);
          if (q.length < 2) {
            closeSuggestions();
            return;
          }

          debounceTimer = setTimeout(async () => {
            const data = await fetchMatches(q);
            const items = (data && data.guardians) ? data.guardians : [];

            if (!items.length) {
              closeSuggestions();
              return;
            }

            suggestions.innerHTML = items.map(g => {
              const fullName = escapeHtml(g.display_name || `${g.first_name || ''} ${g.last_name || ''}`.trim());
              const meta = `${escapeHtml(g.phone || "")}${g.email ? " • " + escapeHtml(g.email) : ""}`;
              const img = g.image_url ? escapeHtml(g.image_url) : "/images/profilePlaceholder.png";
              return `
                <div class="guardian-suggestion-item"
                     data-id="${g.guardian_id}"
                   data-display="${fullName}"
                     data-first="${escapeHtml(g.first_name)}"
                     data-last="${escapeHtml(g.last_name)}"
                     data-phone="${escapeHtml(g.phone || "")}"
                     data-email="${escapeHtml(g.email || "")}">
                  <img src="${img}" onerror="this.src='/images/profilePlaceholder.png'" />
                  <div>
                    <div><strong>${fullName}</strong></div>
                    <div class="guardian-meta">${meta}</div>
                  </div>
                </div>
              `;
            }).join("");

            suggestions.classList.add("show");

            // click select
            suggestions.querySelectorAll(".guardian-suggestion-item").forEach(el => {
              el.addEventListener("click", (e) => {
                e.stopPropagation();
                
                const guardianId = el.dataset.id || "";
                const firstName = el.dataset.first || "";
                const lastName = el.dataset.last || "";
                const displayName = el.dataset.display || `${firstName} ${lastName}`.trim();
                
                hiddenId.value = guardianId;

                // Fill the fields for convenience
                const firstNameInput = guardianRow.querySelector(`input[name^="guardianFirstName_"]`);
                const lastNameInput = guardianRow.querySelector(`input[name^="guardianLastName_"]`);
                const phoneInput = guardianRow.querySelector(`input[name^="guardianPhone_"]`);
                const emailInput = guardianRow.querySelector(`input[name^="guardianEmail_"]`);

                if (firstNameInput) firstNameInput.value = firstName;
                if (lastNameInput) lastNameInput.value = lastName;
                if (phoneInput) phoneInput.value = el.dataset.phone || "";
                if (emailInput) emailInput.value = el.dataset.email || "";

                // Update search input to show selected name
                searchInput.value = displayName;
                
                // Visual feedback
                markAsSelected(displayName);

                closeSuggestions();
              });
            });
          }, 250);
        });

        // close when clicking outside
        const closeHandler = (e) => {
          if (!guardianRow.contains(e.target)) {
            closeSuggestions();
          }
        };
        document.addEventListener("click", closeHandler);
      }

      function toggleSubjectsCollapsible(index) {
        const container = document.getElementById(`subjectsContainer-${index}`);
        const btn = document.querySelector(`#subjectsCollapsible-${index} .collapsible-btn`);
        if (!container || !btn) return;

        const shouldExpand = container.style.display === "none" || container.style.display === "";
        container.style.display = shouldExpand ? "block" : "none";
        setSubjectsToggleState(btn, shouldExpand);
      }

      function setSubjectsToggleState(button, expanded) {
        if (!button) return;
        const label = button.querySelector(".collapsible-label");
        button.setAttribute("aria-expanded", expanded ? "true" : "false");
        if (label) {
          label.textContent = expanded ? "Hide Subjects" : "Show Subjects";
        }
      }
      const addStudentPageData = JSON.parse(document.getElementById('addStudentPageData').textContent || '{}');
      const organizationId = String(addStudentPageData.organizationId || '');
      const hasSaveSuccessMessage = Boolean(addStudentPageData.hasSaveSuccessMessage);
      const allSchoolYears = Array.isArray(addStudentPageData.allSchoolYears) ? addStudentPageData.allSchoolYears : [];
      const studentIdAutoGenerateEnabled = Boolean(addStudentPageData.studentIdAutoGenerateEnabled);
      const studentIdNextAvailableStart = Number(addStudentPageData.studentIdNextAvailableStart || 1);
      let studentIndex = 0;
      const LOCAL_DRAFT_KEY = `addStudentDraft_${organizationId || 'default'}`;
      const PERFORMANCE_MODE_THRESHOLD = 600;
      const DUPLICATE_PRECHECK_LIMIT = 120;
      const DEFAULT_IMPORT_BATCH_SIZE = 25;
      const PERFORMANCE_IMPORT_BATCH_SIZE = 10;
      let submitBypassCheck = false;
      let saveBusyMessageTimer = null;
      let saveDraftTimer = null;
      let isBulkRenderInProgress = false;
      const classSubjectsCache = new Map();
      const pendingBulkSubjectPrefills = [];

      function queueBulkSubjectPrefill(index, classId, preSelectedSubjects = []) {
        const parsedIndex = Number(index);
        if (!Number.isInteger(parsedIndex) || parsedIndex < 0 || !classId) return;
        pendingBulkSubjectPrefills.push({
          index: parsedIndex,
          classId: String(classId),
          preSelectedSubjects: Array.isArray(preSelectedSubjects)
            ? preSelectedSubjects.filter(Boolean)
            : []
        });
      }

      async function flushBulkSubjectPrefills() {
        if (!pendingBulkSubjectPrefills.length) return;
        const queued = pendingBulkSubjectPrefills.splice(0, pendingBulkSubjectPrefills.length);

        for (const item of queued) {
          if (!item || !Number.isInteger(Number(item.index)) || Number(item.index) < 0 || !item.classId) continue;
          await loadSubjectsForClass(item.index, item.classId, item.preSelectedSubjects || []);
        }
      }

      function setImportProgressText(message) {
        const progressText = document.getElementById('progressText');
        const overlayText = document.getElementById('importBusyText');
        if (progressText) progressText.textContent = message;
        if (overlayText) overlayText.textContent = message;
      }

      function showImportBusyOverlay(message = 'Processing file...') {
        const overlay = document.getElementById('importBusyOverlay');
        if (!overlay) return;
        setImportProgressText(message);
        overlay.classList.add('show');
      }

      function hideImportBusyOverlay() {
        const overlay = document.getElementById('importBusyOverlay');
        if (!overlay) return;
        overlay.classList.remove('show');
      }

      function showSaveBusyOverlay() {
        const overlay = document.getElementById('saveBusyOverlay');
        const text = document.getElementById('saveBusyText');
        const saveButton = document.querySelector('button.save-form-btn[form="addStudentFormMain"]');
        if (!overlay || !text) return;

        const messages = [
          'Validating and preparing records...',
          'Saving students to database...',
          'Creating class enrollments and subject links...',
          'Finalizing guardian links and notifications...'
        ];
        let cursor = 0;
        text.textContent = messages[cursor];
        overlay.classList.add('show');
        if (saveButton) saveButton.disabled = true;

        if (saveBusyMessageTimer) {
          clearInterval(saveBusyMessageTimer);
        }
        saveBusyMessageTimer = setInterval(() => {
          cursor = (cursor + 1) % messages.length;
          text.textContent = messages[cursor];
        }, 2200);
      }

      function estimateSaveWindow(studentCount) {
        const count = Math.max(1, Number(studentCount) || 1);

        // Fast-path estimate for typical no-image/low-contention saves.
        let lowSeconds = Math.round(count * 0.06);
        let highSeconds = Math.round(count * 0.2);

        // Heavier-path guardrail for larger batches.
        if (count >= 300) {
          lowSeconds = Math.max(lowSeconds, Math.round(count * 0.08));
          highSeconds = Math.max(highSeconds, Math.round(count * 0.28));
        }

        const toHuman = (seconds) => {
          if (seconds < 60) return `${seconds}s`;
          const mins = Math.floor(seconds / 60);
          const secs = seconds % 60;
          return secs ? `${mins}m ${secs}s` : `${mins}m`;
        };

        return `${toHuman(lowSeconds)} - ${toHuman(highSeconds)}`;
      }

      function setSaveBusyText(message) {
        const text = document.getElementById('saveBusyText');
        if (text && message) {
          text.textContent = message;
        }
      }

      function setSaveBusyEta(message) {
        const eta = document.getElementById('saveBusyEta');
        if (eta) {
          eta.textContent = message || '';
        }
      }

      function hideSaveBusyOverlay() {
        const overlay = document.getElementById('saveBusyOverlay');
        const saveButton = document.querySelector('button.save-form-btn[form="addStudentFormMain"]');
        if (saveBusyMessageTimer) {
          clearInterval(saveBusyMessageTimer);
          saveBusyMessageTimer = null;
        }
        if (overlay) overlay.classList.remove('show');
        if (saveButton) saveButton.disabled = false;
      }

      function getAllStudentIdInputs() {
        return Array.from(document.querySelectorAll('.student-form .sid-id-input'));
      }

      function getStudentIdNumericValue(input) {
        return String(input && input.value ? input.value : '').replace(/\D/g, '').trim();
      }

      function isStudentIdInManualMode(input) {
        if (!input) return false;
        const formBlock = input.closest('.student-form');
        const modeInput = formBlock ? formBlock.querySelector('.sid-id-mode') : null;
        if (!modeInput) return true;
        return String(modeInput.value || '').trim().toLowerCase() !== 'auto';
      }

      function getNextStudentIdPreviewValue(excludeInput = null) {
        const reservedNumbers = new Set();
        getAllStudentIdInputs().forEach((input) => {
          if (input === excludeInput) return;
          const numericText = getStudentIdNumericValue(input);
          const numericValue = numericText ? parseInt(numericText, 10) : null;
          if (Number.isInteger(numericValue) && numericValue > 0) {
            reservedNumbers.add(numericValue);
          }
        });

        let candidate = Math.max(1, Number(studentIdNextAvailableStart) || 1);
        while (reservedNumbers.has(candidate)) {
          candidate += 1;
        }
        return String(candidate).padStart(3, '0');
      }

      function applyStudentIdConflictState(input) {
        if (!input) return;
        const widget = input.closest('.sid-id-widget');
        const message = widget ? widget.querySelector('.sid-id-taken-msg') : null;
        const taken = input.dataset.pageTaken === 'true' || input.dataset.dbTaken === 'true';
        input.classList.toggle('sid-taken', taken);
        input.setAttribute('aria-invalid', taken ? 'true' : 'false');
        if (widget) widget.classList.toggle('sid-has-conflict', taken);
        if (message) message.classList.toggle('visible', taken);
      }

      function refreshStudentIdPageConflicts() {
        const counts = new Map();
        getAllStudentIdInputs().forEach((input) => {
          const numericText = getStudentIdNumericValue(input);
          if (!numericText) return;
          counts.set(numericText, (counts.get(numericText) || 0) + 1);
        });

        getAllStudentIdInputs().forEach((input) => {
          const numericText = getStudentIdNumericValue(input);
          input.dataset.pageTaken = numericText && (counts.get(numericText) || 0) > 1 ? 'true' : 'false';
          applyStudentIdConflictState(input);
        });
      }

      async function refreshStudentIdDbConflict(input) {
        if (!input) return;
        const numericText = getStudentIdNumericValue(input);
        const requestToken = String(Number(input.dataset.sidRequestToken || 0) + 1);
        input.dataset.sidRequestToken = requestToken;

        if (!numericText) {
          input.dataset.dbTaken = 'false';
          applyStudentIdConflictState(input);
          return;
        }

        try {
          const fullId = (input.dataset.prefix || '') + numericText;
          const response = await fetch('/common/check-student-id?id=' + encodeURIComponent(fullId) + '&num=' + encodeURIComponent(numericText));
          const data = await response.json();
          if (input.dataset.sidRequestToken !== requestToken) return;
          input.dataset.dbTaken = data && data.taken ? 'true' : 'false';
        } catch (error) {
          if (input.dataset.sidRequestToken !== requestToken) return;
          input.dataset.dbTaken = 'false';
        }

        applyStudentIdConflictState(input);
      }

      function refreshAllStudentIdConflictStates() {
        refreshStudentIdPageConflicts();
        getAllStudentIdInputs().forEach((input) => {
          if (!getStudentIdNumericValue(input)) {
            input.dataset.dbTaken = 'false';
            applyStudentIdConflictState(input);
            return;
          }

          if (!isStudentIdInManualMode(input)) {
            input.dataset.dbTaken = 'false';
            applyStudentIdConflictState(input);
            return;
          }

          if (getStudentIdNumericValue(input)) {
            refreshStudentIdDbConflict(input);
          } else {
            input.dataset.dbTaken = 'false';
            applyStudentIdConflictState(input);
          }
        });
      }

      function setupStudentIdInput(formBlock) {
        const sidInput = formBlock.querySelector('.sid-id-input');
        if (!sidInput) return;

        const sidModeInput = formBlock.querySelector('.sid-id-mode');
        const syncStudentIdInputWidth = (input) => {
          const basis = (input.value || input.placeholder || '').trim();
          const chars = Math.max(6, Math.min(10, basis.length || 6));
          input.style.width = (chars + 0.8) + 'ch';
        };
        const ensurePreviewValue = () => {
          if (!studentIdAutoGenerateEnabled || !sidModeInput) return;
          if (sidModeInput.value !== 'auto') return;
          if (sidInput.value.trim()) return;
          const previewValue = getNextStudentIdPreviewValue(sidInput);
          sidInput.dataset.autoPreview = previewValue;
          sidInput.value = previewValue;
        };

        let sidTimer;
        sidInput.dataset.pageTaken = 'false';
        sidInput.dataset.dbTaken = 'false';
        ensurePreviewValue();
        syncStudentIdInputWidth(sidInput);
        refreshStudentIdPageConflicts();
        if (isStudentIdInManualMode(sidInput) && getStudentIdNumericValue(sidInput)) {
          sidTimer = setTimeout(() => {
            refreshStudentIdDbConflict(sidInput);
          }, 0);
        } else {
          sidInput.dataset.dbTaken = 'false';
          applyStudentIdConflictState(sidInput);
        }

        sidInput.addEventListener('input', function() {
          clearTimeout(sidTimer);
          const digitsOnly = this.value.replace(/\D/g, '').slice(0, 10);
          if (this.value !== digitsOnly) {
            this.value = digitsOnly;
          }
          const val = this.value.trim();
          if (sidModeInput) {
            sidModeInput.value = studentIdAutoGenerateEnabled && !val ? 'auto' : 'manual';
          }
          syncStudentIdInputWidth(sidInput);
          refreshStudentIdPageConflicts();
          if (!val) {
            sidInput.dataset.dbTaken = 'false';
            applyStudentIdConflictState(sidInput);
            return;
          }
          if (!isStudentIdInManualMode(sidInput)) {
            sidInput.dataset.dbTaken = 'false';
            applyStudentIdConflictState(sidInput);
            return;
          }
          sidTimer = setTimeout(() => {
            refreshStudentIdDbConflict(sidInput);
          }, 250);
        });

        sidInput.addEventListener('blur', function() {
          if (sidModeInput && sidModeInput.value === 'auto' && !this.value.trim()) {
            ensurePreviewValue();
          }
          syncStudentIdInputWidth(sidInput);
          refreshStudentIdPageConflicts();
          if (isStudentIdInManualMode(sidInput) && getStudentIdNumericValue(sidInput)) {
            sidTimer = setTimeout(() => {
              refreshStudentIdDbConflict(sidInput);
            }, 0);
          } else {
            sidInput.dataset.dbTaken = 'false';
            applyStudentIdConflictState(sidInput);
          }
        });

        refreshStudentIdPageConflicts();
      }
    
      // ── Smart sanitization helpers (client-side) ──
      function sanitizePhoneClient(val) {
        const raw = String(val || '');
        const hasPlus = raw.trim().startsWith('+');
        const digits = raw.replace(/[\s\-\(\)\.\+]/g, '');
        return hasPlus ? `+${digits}` : digits;
      }
      function normalizeGenderClient(val) {
        const g = String(val || '').trim().toLowerCase();
        if (g === 'm' || g === 'male' || g === 'boy') return 'Male';
        if (g === 'f' || g === 'female' || g === 'girl') return 'Female';
        return val;
      }

      async function confirmAddStudent(event) {
        if (submitBypassCheck) return;

        event.preventDefault();
        const form = document.getElementById('addStudentFormMain');
        if (!form) return;

        const studentBlocks = Array.from(document.querySelectorAll('.student-form'));
        const missingSummary = [];
        studentBlocks.forEach((block, idx) => {
          const i = block.getAttribute('data-index');
          const find = (name) => block.querySelector(`[name="${name}___${i}"]`) || block.querySelector(`[name="${name}_${i}"]`);
          const firstName = find('firstName')?.value?.trim();
          const lastName = find('lastName')?.value?.trim();
          const dateOfBirth = find('dateOfBirth')?.value?.trim();
          const dateOfBirthUnknown = Boolean(find('dateOfBirthUnknown')?.checked);
          const gender = find('gender')?.value?.trim();
          const classId = find('classId')?.value?.trim();
          const missing = [];
          if (!firstName) missing.push('firstName');
          if (!lastName) missing.push('lastName');
          if (!dateOfBirth && !dateOfBirthUnknown) missing.push('dateOfBirth');
          if (!gender) missing.push('gender');
          if (!classId) missing.push('classId');
          if (missing.length) {
            missingSummary.push({ formNumber: idx + 1, dataIndex: i, missing });
          }
        });

        if (missingSummary.length) {
          console.warn('[AddStudent Submit] Missing required fields before submit', missingSummary);
        }

        if (!confirm("Are you sure you want to add all students?")) {
          return;
        }

        // Show immediate feedback right after user confirmation.
        showSaveBusyOverlay();
        const estimatedWindow = estimateSaveWindow(studentBlocks.length);
        setSaveBusyEta(`Estimated save time: ${estimatedWindow}`);
        setSaveBusyText('Running duplicate checks...');

        let allowDuplicateSave = false;
        try {
          const candidateCount = studentBlocks.length;
          if (candidateCount > DUPLICATE_PRECHECK_LIMIT) {
            setSaveBusyText('Large save detected. Skipping browser duplicate precheck for speed...');
          } else {
            const duplicates = await checkDuplicateStudentsBeforeSubmit();
            if (duplicates.length > 0) {
              const preview = duplicates.slice(0, 5).map((d, i) =>
                `${i + 1}. ${d.input.firstName} ${d.input.lastName} (${d.existing.class_name})`
              ).join('\n');
              const more = duplicates.length > 5 ? `\n...and ${duplicates.length - 5} more.` : '';
              const proceed = confirm(
                `Student with exact same information already exists in this class:\n\n${preview}${more}\n\nDo you still want to save duplicate record(s)?`
              );
              if (!proceed) {
                hideSaveBusyOverlay();
                return;
              }
              allowDuplicateSave = true;
            }
          }
        } catch (err) {
          console.error('Duplicate precheck failed:', err);
          const proceedOnError = confirm('Could not verify duplicates right now. Do you want to continue saving?');
          if (!proceedOnError) {
            hideSaveBusyOverlay();
            return;
          }
        }

        let duplicateInput = form.querySelector('input[name="allowDuplicateSave"]');
        if (!duplicateInput) {
          duplicateInput = document.createElement('input');
          duplicateInput.type = 'hidden';
          duplicateInput.name = 'allowDuplicateSave';
          form.appendChild(duplicateInput);
        }
        duplicateInput.value = allowDuplicateSave ? 'true' : 'false';

        // ── Pre-submit: combine country-code select + local number, then sanitize ──
        if (window.combinePhoneCountryCombos) window.combinePhoneCountryCombos(form);
        form.querySelectorAll('input[name*="guardianPhone"]').forEach(input => {
          input.value = sanitizePhoneClient(input.value);
        });
        form.querySelectorAll('select[name*="gender"]').forEach(select => {
          const normalized = normalizeGenderClient(select.value);
          if (normalized && select.querySelector(`option[value="${normalized}"]`)) {
            select.value = normalized;
          }
        });

        setSaveBusyText('Submitting records for save...');
        setSaveBusyEta(`Estimated save time: ${estimatedWindow}`);
        submitBypassCheck = true;
        form.submit();
      }

      window.addEventListener('pageshow', () => {
        hideSaveBusyOverlay();
      });

      function scheduleSaveDraft() {
        if (isBulkRenderInProgress) return;
        if (saveDraftTimer) clearTimeout(saveDraftTimer);
        saveDraftTimer = setTimeout(saveDraftToLocalStorage, 300);
      }

      function yieldToBrowser() {
        return new Promise((resolve) => {
          if (typeof window !== 'undefined' && typeof window.requestAnimationFrame === 'function') {
            window.requestAnimationFrame(() => resolve());
            return;
          }
          setTimeout(resolve, 0);
        });
      }

      function saveDraftToLocalStorage() {
        const container = document.getElementById('studentFormsContainer');
        if (!container) return;

        const forms = Array.from(container.querySelectorAll('.student-form')).map((form) => {
          const fields = {};
          const elements = form.querySelectorAll('input, select, textarea');

          elements.forEach((element) => {
            if (!element.name || element.type === 'file') return;

            if (element.type === 'checkbox') {
              if (!fields[element.name]) fields[element.name] = [];
              if (element.checked) fields[element.name].push(element.value);
            } else if (element.type === 'radio') {
              if (element.checked) fields[element.name] = element.value;
            } else {
              fields[element.name] = element.value;
            }
          });

          return {
            index: Number(form.getAttribute('data-index')),
            guardianMode: form.getAttribute('data-guardian-mode') || '',
            fields
          };
        });

        const payload = {
          version: 1,
          studentIndex,
          updatedAt: new Date().toISOString(),
          forms
        };
        localStorage.setItem(LOCAL_DRAFT_KEY, JSON.stringify(payload));
      }

      function getGuardianMaxIndexFromFields(fields) {
        let maxGuardianIndex = -1;
        Object.keys(fields).forEach((name) => {
          const match = name.match(/^guardian(?:ProfileId|FirstName|LastName|Address|Phone|Email|Hometown|Image)_(\d+)_(\d+)$/);
          if (match) {
            const gIdx = Number(match[2]);
            if (!isNaN(gIdx)) maxGuardianIndex = Math.max(maxGuardianIndex, gIdx);
          }
        });
        return maxGuardianIndex;
      }

      function setNamedFieldValue(container, name, value) {
        const safeName = String(name).replace(/"/g, '\\"');
        const elements = container.querySelectorAll(`[name="${safeName}"]`);
        if (!elements.length) return;

        const element = elements[0];
        if (element.type === 'checkbox') {
          const values = Array.isArray(value) ? value.map(String) : [String(value)];
          elements.forEach((el) => {
            el.checked = values.includes(String(el.value));
          });
        } else if (element.type === 'radio') {
          elements.forEach((el) => {
            el.checked = String(el.value) === String(value);
          });
        } else {
          element.value = value ?? '';
        }
      }

      async function restoreDraftFromLocalStorage() {
        const raw = localStorage.getItem(LOCAL_DRAFT_KEY);
        if (!raw) return false;

        let draft;
        try {
          draft = JSON.parse(raw);
        } catch (e) {
          return false;
        }

        if (!draft || !Array.isArray(draft.forms) || draft.forms.length === 0) {
          return false;
        }

        const container = document.getElementById('studentFormsContainer');
        container.innerHTML = '';
        studentIndex = 0;

        for (const savedForm of draft.forms) {
          addStudentForm();
          const block = container.lastElementChild;
          if (!block) continue;

          const currentIndex = Number(block.getAttribute('data-index'));
          const fields = savedForm.fields || {};

          const guardianFieldKeys = Object.keys(fields).filter((k) => k.startsWith('guardian'));
          if (guardianFieldKeys.length > 0) {
            const mode = savedForm.guardianMode || (
              Object.keys(fields).some((k) => k.startsWith('guardianProfileId_') && fields[k]) ? 'existing' : 'new'
            );
            const modeButton = mode === 'existing'
              ? block.querySelector('.guardian-check-section button[onclick*="existing"]')
              : block.querySelector('.guardian-check-section button[onclick*="new"]');
            if (modeButton) {
              setGuardianMode(modeButton, mode);
              const addBtn = block.querySelector('.guardian-add-btn');
              const maxGuardian = getGuardianMaxIndexFromFields(fields);
              for (let g = 1; g <= maxGuardian; g++) {
                if (addBtn) addGuardian(addBtn, mode);
              }
            }
          }

          // Restore non-subject fields first
          Object.entries(fields).forEach(([name, value]) => {
            if (name.startsWith(`subjects_${currentIndex}[]`)) return;
            setNamedFieldValue(block, name, value);
          });
          bindDobUnknownToggle(block);

          // Reload class subjects then restore checked subjects
          const classSelect =
            block.querySelector(`select[name="classId___${currentIndex}"]`) ||
            block.querySelector(`select[name="classId_${currentIndex}"]`) ||
            block.querySelector('select[name^="classId_"]');
          if (classSelect && classSelect.value) {
            await loadSubjectsForClass(currentIndex, classSelect.value);
            const subjectName = `subjects_${currentIndex}[]`;
            if (fields[subjectName]) {
              setNamedFieldValue(block, subjectName, fields[subjectName]);
            }
          }
        }

        refreshAllStudentIdConflictStates();

        return true;
      }

