                <input type="text" class="form-input" name="guardianFirstName_${index}_${count}" 
                  placeholder="Auto-filled from search" readonly style="background: #f5f5f5;" />
              </div>

              <div class="form-field-group">
                <label class="form-label">Last Name (Read-only)</label>
