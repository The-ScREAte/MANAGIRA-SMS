        const index = block.getAttribute("data-index");
        const container = block.querySelector(".guardians-container");
        const count = container.children.length;
        
        // If mode not provided, get it from the block's data attribute
        if (!mode) {
          mode = block.getAttribute("data-guardian-mode") || "new";
        }
        
        let html = '';
        
        if (mode === 'existing') {
          // Show only search for existing guardian
          html = `
            <div class="guardian-row">
              <div class="form-field-group">
                <label class="form-label" style="color: #01535b; font-weight: 600;">
                  🔍 Search Existing Guardian
                </label>
                <div class="search-wrapper">
                  <input type="text" class="form-input guardian-search"
                    placeholder="Type guardian name, phone, or email (min 2 letters)..." 
                    autocomplete="off" 
                    style="border: 2px solid #cbd5e0;" />
                  <div class="guardian-suggestions"></div>
                </div>
                <div class="guardian-selected-badge"></div>

                <!-- This is what actually tells backend "use existing guardian" -->
                <input type="hidden" name="guardianProfileId_${index}_${count}" value="" />
              </div>

              <hr style="margin: 16px 0; border: none; border-top: 1px solid #e0e0e0;">

