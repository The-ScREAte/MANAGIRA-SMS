      function normalizeSignaturePart(value) {
        return String(value || '').trim().toLowerCase().replace(/\s+/g, ' ');
      }

      function getIndexedFieldValue(block, idx, baseName) {
        const triple = block.querySelector(`[name="${baseName}___${idx}"]`);
        if (triple) return String(triple.value || '').trim();
        const single = block.querySelector(`[name="${baseName}_${idx}"]`);
        if (single) return String(single.value || '').trim();
        return '';
      }

      function isIndexedCheckboxChecked(block, idx, baseName) {
        const triple = block.querySelector(`[name="${baseName}___${idx}"]`);
        if (triple && triple.type === 'checkbox') return Boolean(triple.checked);
        const single = block.querySelector(`[name="${baseName}_${idx}"]`);
        if (single && single.type === 'checkbox') return Boolean(single.checked);
        return false;
      }

      function getExistingFormSignatures() {
        const signatures = new Set();
        const blocks = document.querySelectorAll('#studentFormsContainer .student-form');

        blocks.forEach((block) => {
          const idx = block.getAttribute('data-index');
          const firstName = getIndexedFieldValue(block, idx, 'firstName');
          const lastName = getIndexedFieldValue(block, idx, 'lastName');
          const dateOfBirth = getIndexedFieldValue(block, idx, 'dateOfBirth');
          const dateOfBirthUnknown = isIndexedCheckboxChecked(block, idx, 'dateOfBirthUnknown');
          const gender = getIndexedFieldValue(block, idx, 'gender');
          const hometown = getIndexedFieldValue(block, idx, 'hometown');

          const classSelect =
            block.querySelector(`[name="classId___${idx}"]`) ||
            block.querySelector(`[name="classId_${idx}"]`) ||
            block.querySelector('select[name^="classId_"]');

          const className = classSelect && classSelect.selectedOptions && classSelect.selectedOptions.length
            ? classSelect.selectedOptions[0].textContent
            : '';

          if (!firstName || !lastName || (!dateOfBirth && !dateOfBirthUnknown)) return;

          const signature = [firstName, lastName, (dateOfBirth || (dateOfBirthUnknown ? 'n/k' : '')), gender, hometown, className]
            .map(normalizeSignaturePart)
            .join('|');
          signatures.add(signature);
        });

        return signatures;
      }

      function getImportedStudentSignature(studentData) {
        return [
          studentData.firstName,
          studentData.lastName,
          studentData.dateOfBirth || (studentData.dateOfBirthUnknown ? 'n/k' : ''),
          studentData.gender,
          studentData.hometown,
          studentData.class,
        ].map(normalizeSignaturePart).join('|');
      }

      function isEmptyStudentFormBlock(block) {
        if (!block) return false;
        const idx = block.getAttribute('data-index');
        if (idx === null || idx === undefined) return false;

        const getVal = (baseName) => {
          const triple = block.querySelector(`[name="${baseName}___${idx}"]`);
          if (triple) return String(triple.value || '').trim();
          const single = block.querySelector(`[name="${baseName}_${idx}"]`);
          if (single) return String(single.value || '').trim();
          return '';
        };

        const firstName = getVal('firstName');
        const lastName = getVal('lastName');
        const dateOfBirth = getVal('dateOfBirth');
        const dateOfBirthUnknown = isIndexedCheckboxChecked(block, idx, 'dateOfBirthUnknown');
        const gender = getVal('gender');
        const classId = getVal('classId');

        const guardianContainer = block.querySelector('.guardians-container');
        const guardianCount = guardianContainer ? guardianContainer.children.length : 0;

        return !firstName && !lastName && !dateOfBirth && !gender && !classId && guardianCount === 0;
      }

      function findReusableEmptyStudentFormBlock() {
        const blocks = Array.from(document.querySelectorAll('#studentFormsContainer .student-form'));
        return blocks.find((block) => isEmptyStudentFormBlock(block)) || null;
      }

      function findReusableEmptyStudentFormBlocks() {
        const blocks = Array.from(document.querySelectorAll('#studentFormsContainer .student-form'));
        return blocks.filter((block) => isEmptyStudentFormBlock(block));
      }

      function setStudentFormCollapsed(block, collapsed) {
        if (!block) return;
        block.classList.toggle('is-collapsed', !!collapsed);
        const indicator = block.querySelector('.collapse-indicator');
        if (indicator) {
          indicator.style.display = collapsed ? 'inline-block' : 'none';
        }
      }

      function collapseAllFormsExceptLast() {
        const blocks = Array.from(document.querySelectorAll('#studentFormsContainer .student-form'));
        if (!blocks.length) return;
        blocks.forEach((block, idx) => {
          const isLast = idx === blocks.length - 1;
          setStudentFormCollapsed(block, !isLast);
        });
      }

      async function uploadAndParseFile(file) {
        // Validate file type
        const validExtensions = ['.xlsx', '.xls', '.csv', '.pdf', '.doc', '.docx', '.jpg', '.jpeg', '.png'];
        const fileExtension = file.name.substring(file.name.lastIndexOf('.')).toLowerCase();
        
        if (!validExtensions.includes(fileExtension)) {
          alert('Invalid file type. Please upload Excel, CSV, PDF, Word, or Image files.');
          return;
        }

        // Show progress
        document.getElementById('parsingProgress').classList.add('show');
        setImportProgressText('Parsing file...');
        showImportBusyOverlay('Parsing file...');

        const formData = new FormData();
        formData.append('bulkFile', file);

        try {
          const response = await fetch('/common/parse-bulk-students', {
            method: 'POST',
            body: formData
          });

          const result = await response.json();

          if (result.success) {
            setImportProgressText(`Found ${result.students.length} students! Generating forms...`);
            
            // Show warnings if any
            if (result.warnings) {
              let warningMessage = '';
              if (result.warnings.missingClasses && result.warnings.missingClasses.length > 0) {
                warningMessage += `⚠️ The following classes were not found in the database:\n${result.warnings.missingClasses.join(', ')}\n\n`;
              }
              if (result.warnings.missingSubjects && result.warnings.missingSubjects.length > 0) {
                warningMessage += `⚠️ The following subjects were not found in the database:\n${result.warnings.missingSubjects.join(', ')}\n\n`;
              }
              if (warningMessage) {
                warningMessage += 'Please add these to your system or adjust the data manually.';
                alert(warningMessage);
              }
            }
            
            // Keep existing forms and append only non-duplicate imported rows
            const existingSignatures = getExistingFormSignatures();
            const seenSignatures = new Set(existingSignatures);
            const studentsToAdd = [];
            let skippedDuplicates = 0;

            result.students.forEach((studentData) => {
              const signature = getImportedStudentSignature(studentData);
              if (seenSignatures.has(signature)) {
                skippedDuplicates++;
                return;
              }
              seenSignatures.add(signature);
              studentsToAdd.push(studentData);
            });

            if (studentsToAdd.length === 0) {
              document.getElementById('parsingProgress').classList.remove('show');
              hideImportBusyOverlay();
              alert(`No new students were added. ${skippedDuplicates} duplicate record(s) already exist in the current forms.`);
              return;
            }

            const reusableEmptyBlocks = findReusableEmptyStudentFormBlocks();

            const progressText = document.getElementById('progressText');
            const parsingProgress = document.getElementById('parsingProgress');
            const usePerformanceMode = studentsToAdd.length > PERFORMANCE_MODE_THRESHOLD;

            if (usePerformanceMode && parsingProgress) {
              parsingProgress.classList.add('show');
            } else {
              closeBulkImportModal();
            }

            // Fast batched rendering with adaptive tuning for large imports
            isBulkRenderInProgress = true;
            if (progressText) {
              setImportProgressText(
                usePerformanceMode
                  ? `Large import performance mode: generating ${studentsToAdd.length} form(s)...`
                  : `Generating ${studentsToAdd.length} form(s)...`
              );
            }

            const batchSize = usePerformanceMode ? PERFORMANCE_IMPORT_BATCH_SIZE : DEFAULT_IMPORT_BATCH_SIZE;
            try {
              for (let index = 0; index < studentsToAdd.length; index++) {
                const targetBlock = index < reusableEmptyBlocks.length ? reusableEmptyBlocks[index] : null;
                addStudentFormWithData(studentsToAdd[index], targetBlock);

                const isBatchBoundary = (index + 1) % batchSize === 0;
                const isLast = index === studentsToAdd.length - 1;

                if (isBatchBoundary || isLast) {
                  if (progressText) {
                    setImportProgressText(`Generated ${index + 1} of ${studentsToAdd.length} forms...`);
                  }
                  await yieldToBrowser();
                }
              }

              // Ensure subjects are preselected for every generated form.
              await flushBulkSubjectPrefills();
            } finally {
              isBulkRenderInProgress = false;
            }

            if (usePerformanceMode) {
              closeBulkImportModal();
            } else {
              closeBulkImportModal();
            }
            hideImportBusyOverlay();
            scheduleSaveDraft();
            const skipNote = skippedDuplicates > 0 ? ` (${skippedDuplicates} duplicate record(s) skipped)` : '';
            alert(`Successfully added ${studentsToAdd.length} student(s) to existing forms${skipNote}. Please review and submit.`);
          } else {
            alert('Error parsing file: ' + (result.error || 'Unknown error'));
            document.getElementById('parsingProgress').classList.remove('show');
            hideImportBusyOverlay();
          }
        } catch (error) {
          console.error('Upload error:', error);
          alert('Error uploading file. Please try again.');
          document.getElementById('parsingProgress').classList.remove('show');
          hideImportBusyOverlay();
        }
      }

      function addStudentFormWithData(studentData, preferredBlock = null) {
        // IMPORTANT: bulk-import must create the exact same DOM structure as manual addStudentForm().
        // Subjects + guardian logic depend on:
        // - a `.student-form` wrapper with `data-index`
        // - `__INDEX__` placeholders replaced (ids like subjectsContainer-0)
        // - existing event bindings in addStudentForm()

        const reusableBlock = (preferredBlock && isEmptyStudentFormBlock(preferredBlock))
          ? preferredBlock
          : findReusableEmptyStudentFormBlock();
        if (!reusableBlock) {
          addStudentForm();
        }

        const container = document.getElementById("studentFormsContainer");
        const block = reusableBlock || (container ? container.lastElementChild : null);
        if (!block || !block.classList || !block.classList.contains('student-form')) {
          return;
        }

        setStudentFormCollapsed(block, false);

        const currentIndex = Number(block.getAttribute('data-index'));
        const cardElement = block;

        if (!studentData) {
          return;
        }
        
        // Personal Information
        if (studentData.firstName) {
          const selector = `input[name="firstName___${currentIndex}"]`;
          const firstNameInput = cardElement.querySelector(selector);
          if (firstNameInput) {
            firstNameInput.value = studentData.firstName;
          } else {
            // Try without specific index
            const altInput = cardElement.querySelector('input[name*="firstName"]');
            if (altInput) {
              altInput.value = studentData.firstName;
            }
          }
        }
        
        if (studentData.lastName) {
          const lastNameInput = cardElement.querySelector(`input[name="lastName___${currentIndex}"]`);
          if (lastNameInput) {
            lastNameInput.value = studentData.lastName;
          } else {
            const altInput = cardElement.querySelector('input[name*="lastName"]');
            if (altInput) {
              altInput.value = studentData.lastName;
            }
          }
        }
        
        const dobInput =
          cardElement.querySelector(`input[name="dateOfBirth___${currentIndex}"]`) ||
          cardElement.querySelector('input[name*="dateOfBirth"]');
        const dobUnknownToggle =
          cardElement.querySelector(`input[name="dateOfBirthUnknown___${currentIndex}"]`) ||
          cardElement.querySelector('input[name*="dateOfBirthUnknown"]');
        const isDobUnknown = Boolean(studentData.dateOfBirthUnknown) || !String(studentData.dateOfBirth || '').trim();
        if (dobUnknownToggle) {
          dobUnknownToggle.checked = isDobUnknown;
        }
        if (dobInput) {
          dobInput.value = isDobUnknown ? '' : String(studentData.dateOfBirth || '').trim();
        }
        bindDobUnknownToggle(cardElement);
        
        if (studentData.gender) {
          const genderSelect = cardElement.querySelector(`select[name="gender___${currentIndex}"]`);
          if (genderSelect) {
            genderSelect.value = studentData.gender;
          } else {
            const altSelect = cardElement.querySelector('select[name*="gender"]');
            if (altSelect) {
              altSelect.value = studentData.gender;
            }
          }
        }
        
        const hometownInput =
          cardElement.querySelector(`input[name="hometown___${currentIndex}"]`) ||
          cardElement.querySelector('input[name*="hometown"]');
        const hometownValue = (studentData.hometown || '').trim();
        if (hometownInput) {
          // Always source hometown from hometown field only; never infer from address.
          hometownInput.value = hometownValue;
        }

        const studentAddressInput =
          cardElement.querySelector(`input[name="studentAddress___${currentIndex}"]`) ||
          cardElement.querySelector('input[name*="studentAddress"]');
        const studentAddressValue =
          (studentData.studentAddress || studentData.address || '').trim();
        if (studentAddressInput) {
          studentAddressInput.value = studentAddressValue;
        }

        if (studentData.studentEmail) {
          const studentEmailInput = cardElement.querySelector(`input[name="studentEmail___${currentIndex}"]`);
          if (studentEmailInput) {
            studentEmailInput.value = studentData.studentEmail;
          } else {
            const altInput = cardElement.querySelector('input[name*="studentEmail"]');
            if (altInput) {
              altInput.value = studentData.studentEmail;
            }
          }
        }
        
        // Class selection (find closest match)
        if (studentData.class) {
          const classSelect = cardElement.querySelector(`select[name="classId___${currentIndex}"]`) || 
                             cardElement.querySelector('select[name*="classId"]');
          if (classSelect) {
            // Try to find exact or partial match
            const options = Array.from(classSelect.options);
            const match = options.find(opt => 
              opt.textContent.toLowerCase().trim().includes(studentData.class.toLowerCase().trim()) ||
              studentData.class.toLowerCase().trim().includes(opt.textContent.toLowerCase().trim())
            );
            if (match) {
              classSelect.value = match.value;
              // Auto-load and preselect subjects (also makes the subjects container render)
              const preSubjects = studentData.subjects
                ? studentData.subjects.split(',').map(s => s.trim()).filter(Boolean)
                : [];
              queueBulkSubjectPrefill(currentIndex, classSelect.value, preSubjects);
            } else {
            }
          } else {
          }
        }
        
        // Graduation Year Group selection
        if (studentData.graduationYear) {
          const graduationSelect = cardElement.querySelector(`select[name="graduationYearGroupId___${currentIndex}"]`) ||
                                  cardElement.querySelector('select[name*="graduationYearGroupId"]');
          if (graduationSelect) {
            // Try to find exact or partial match
            const options = Array.from(graduationSelect.options);
            const match = options.find(opt => 
              opt.textContent.trim() === studentData.graduationYear.toString() ||
              opt.textContent.includes(studentData.graduationYear.toString())
            );
            if (match) {
              graduationSelect.value = match.value;
            } else {
            }
          } else {
          }
        }
        
        // Handle Guardian Information
        if (studentData.guardian) {
          const guardian = studentData.guardian;
          
          if (guardian.existing && guardian.guardianId) {
            const existingBtn = cardElement.querySelector(".guardian-check-section button[onclick*=\"'existing'\"]")
              || cardElement.querySelector('button[onclick*="setGuardianMode"][onclick*="existing"]');
            if (!existingBtn) {
              return;
            }

            // Use the actual function so state is consistent (manual editing keeps working)
            setGuardianMode(existingBtn, 'existing');

            // Fill the created guardian row
            const guardianContainer = cardElement.querySelector('.guardians-container');
            const matchData = guardian.matchedData || {};
            if (guardianContainer) {
              const hiddenId = guardianContainer.querySelector(`input[name="guardianProfileId_${currentIndex}_0"]`) || guardianContainer.querySelector('input[name^="guardianProfileId_"]');
              if (hiddenId && guardian.guardianId) hiddenId.value = guardian.guardianId;

              const firstInput = guardianContainer.querySelector(`input[name="guardianFirstName_${currentIndex}_0"]`) || guardianContainer.querySelector('input[name^="guardianFirstName_"]');
              const lastInput = guardianContainer.querySelector(`input[name="guardianLastName_${currentIndex}_0"]`) || guardianContainer.querySelector('input[name^="guardianLastName_"]');
              const phoneInput = guardianContainer.querySelector(`input[name="guardianPhone_${currentIndex}_0"]`) || guardianContainer.querySelector('input[name^="guardianPhone_"]');
              const emailInput = guardianContainer.querySelector(`input[name="guardianEmail_${currentIndex}_0"]`) || guardianContainer.querySelector('input[name^="guardianEmail_"]');

              if (firstInput) firstInput.value = matchData.first_name || guardian.firstName || '';
              if (lastInput) lastInput.value = matchData.last_name || guardian.lastName || '';
              if (phoneInput) phoneInput.value = matchData.phone || guardian.phone || '';
              if (emailInput) emailInput.value = matchData.email || guardian.email || '';

              // Kick off autocomplete suggestions so user can still adjust if needed
              const searchInput = guardianContainer.querySelector('.guardian-search');
              if (searchInput) {
                const searchTerm = guardian.email || guardian.phone || `${guardian.firstName} ${guardian.lastName}`;
                searchInput.value = searchTerm;
                searchInput.dispatchEvent(new Event('input', { bubbles: true }));
              }
            }
          } else if (guardian.firstName || guardian.lastName || guardian.email || guardian.phone) {
            // New guardian - click "No, Add New" and fill form
            const newBtn = cardElement.querySelector(".guardian-check-section button[onclick*=\"'new'\"]")
              || cardElement.querySelector('button[onclick*="setGuardianMode"][onclick*="new"]');
            if (!newBtn) {
              return;
            }

            setGuardianMode(newBtn, 'new');
            const guardianContainer = cardElement.querySelector('.guardians-container');
            if (!guardianContainer) return;

            const firstNameInput = guardianContainer.querySelector(`input[name="guardianFirstName_${currentIndex}_0"]`);
            const lastNameInput = guardianContainer.querySelector(`input[name="guardianLastName_${currentIndex}_0"]`);
            const phoneInput = guardianContainer.querySelector(`input[name="guardianPhone_${currentIndex}_0"]`);
            const emailInput = guardianContainer.querySelector(`input[name="guardianEmail_${currentIndex}_0"]`);
            const addressInput = guardianContainer.querySelector(`input[name="guardianAddress_${currentIndex}_0"]`);
            const hometownInput = guardianContainer.querySelector(`input[name="guardianHometown_${currentIndex}_0"]`);

            if (firstNameInput && guardian.firstName) firstNameInput.value = guardian.firstName;
            if (lastNameInput && guardian.lastName) lastNameInput.value = guardian.lastName;
            if (phoneInput && guardian.phone) phoneInput.value = guardian.phone;
            if (emailInput && guardian.email) emailInput.value = guardian.email;
            if (addressInput && guardian.address) addressInput.value = guardian.address;
            if (hometownInput && guardian.hometown) hometownInput.value = guardian.hometown;
          }
        }
      }

