      async function checkDuplicateStudentsBeforeSubmit() {
        const container = document.getElementById('studentFormsContainer');
        const students = Array.from(container.querySelectorAll('.student-form')).map((block) => {
          const idx = block.getAttribute('data-index');
          const getVal = (name) => {
            const el = block.querySelector(`[name="${name}"]`);
            return el ? String(el.value || '').trim() : '';
          };

          const getIndexedVal = (baseName) => {
            const triple = getVal(`${baseName}___${idx}`);
            if (triple) return triple;
            return getVal(`${baseName}_${idx}`);
          };

          return {
            firstName: getIndexedVal('firstName'),
            lastName: getIndexedVal('lastName'),
            dateOfBirth: getIndexedVal('dateOfBirth'),
            dateOfBirthUnknown: Boolean(block.querySelector(`[name="dateOfBirthUnknown___${idx}"]`)?.checked || block.querySelector(`[name="dateOfBirthUnknown_${idx}"]`)?.checked),
            gender: getIndexedVal('gender'),
            hometown: getIndexedVal('hometown'),
            classId: getIndexedVal('classId')
          };
        }).filter((s) => s.firstName && s.lastName && (s.dateOfBirth || s.dateOfBirthUnknown) && s.classId);

        if (!students.length) return [];

        const response = await fetch('/common/check-student-duplicates', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ students })
        });

        if (!response.ok) {
          throw new Error('Duplicate check failed');
        }

        const result = await response.json();
        return Array.isArray(result.duplicates) ? result.duplicates : [];
      }
    
      function renderSubjectsForClass(index, subjectsData = [], preSelectedSubjects = []) {
        const container = document.getElementById(`subjectsContainer-${index}`);
        const collapsibleBtn = document.querySelector(`#subjectsCollapsible-${index} .collapsible-btn`);
        if (!container) return;

        if (Array.isArray(subjectsData) && subjectsData.length > 0) {
          let html = `<label><input type="checkbox" id="selectAllSubjects-${index}"> Select All</label><br>`;
          subjectsData.forEach(subject => {
            html += `<label><input type="checkbox" name="subjects_${index}[]" data-subject-name="${subject.subject_name}" value="${subject.subject_id}"> ${subject.subject_name}</label><br>`;
          });
          container.innerHTML = html;
          container.style.display = "block";
          if (collapsibleBtn) setSubjectsToggleState(collapsibleBtn, true);

          document.getElementById(`selectAllSubjects-${index}`).addEventListener("change", function () {
            const checkboxes = container.querySelectorAll(`input[name="subjects_${index}[]"]`);
            checkboxes.forEach(cb => cb.checked = this.checked);
          });

          if (preSelectedSubjects.length > 0) {
            const lowerList = preSelectedSubjects.map(s => s.toLowerCase());
            const checkboxes = container.querySelectorAll(`input[name="subjects_${index}[]"]`);
            checkboxes.forEach(cb => {
              const subjName = (cb.getAttribute('data-subject-name') || '').toLowerCase();
              if (lowerList.some(name => subjName.includes(name) || name.includes(subjName))) {
                cb.checked = true;
              }
            });
          }
          updateSubjectCountBadge(index);
          return;
        }

        container.innerHTML = "<p>No subjects found for the selected class.</p>";
        container.style.display = "block";
        if (collapsibleBtn) setSubjectsToggleState(collapsibleBtn, true);
      }

      async function loadSubjectsForClass(index, classId, preSelectedSubjects = []) {
        const container = document.getElementById(`subjectsContainer-${index}`);
        const collapsibleBtn = document.querySelector(`#subjectsCollapsible-${index} .collapsible-btn`);
        if (!container) return;

        if (!classId) {
          container.innerHTML = "<p>Select class to load subjects.</p>";
          container.style.display = "none";
          if (collapsibleBtn) setSubjectsToggleState(collapsibleBtn, false);
          return;
        }

        try {
          const classCacheKey = String(classId);
          let subjectsData = classSubjectsCache.get(classCacheKey);

          if (!subjectsData) {
            const response = await fetch(`/common/getSubjectsForClass?classId=${classId}`);
            if (!response.ok) {
              throw new Error(`Failed to fetch subjects for class ${classId}`);
            }
            const payload = await response.json();
            subjectsData = Array.isArray(payload) ? payload : [];
            classSubjectsCache.set(classCacheKey, subjectsData);
          }

          renderSubjectsForClass(index, subjectsData, preSelectedSubjects);
        } catch (err) {
          console.error("Error loading subjects:", err);
          container.innerHTML = "<p>Error loading subjects.</p>";
          container.style.display = "block";
          if (collapsibleBtn) setSubjectsToggleState(collapsibleBtn, true);
        }
      }
    
      function bindSchoolYearTerms(index) {
        const yearSelect = document.querySelector(`#schoolYear-${index}`);
        const termSelect = document.querySelector(`#term-${index}`);
        if (!yearSelect || !termSelect) return;

        function populateTerms(preSelectTermId) {
          const selected = yearSelect.options[yearSelect.selectedIndex];
          const terms = JSON.parse(selected?.getAttribute("data-terms") || "[]");
          termSelect.innerHTML = '<option value="">Select a term</option>';
          terms.forEach(term => {
            const opt = document.createElement("option");
            opt.value = term.term_id;
            opt.textContent = term.term_name;
            if (preSelectTermId && String(term.term_id) === String(preSelectTermId)) opt.selected = true;
            termSelect.appendChild(opt);
          });
        }

        yearSelect.addEventListener("change", () => populateTerms(null));

        // Populate immediately if year is already pre-selected (e.g. current year default)
        if (yearSelect.value) {
          populateTerms(termSelect.dataset.defaultTerm || null);
        }
      }
    
