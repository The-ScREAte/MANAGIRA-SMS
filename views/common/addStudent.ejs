                placeholder="Type at least 2 letters..." autocomplete="off" />
              <div class="guardian-suggestions"></div>

              <!-- This is what actually tells backend "use existing guardian" -->
              <input type="hidden" name="guardianProfileId_${index}_${count}" value="" />
            </div>

            <div class="form-field-group">
