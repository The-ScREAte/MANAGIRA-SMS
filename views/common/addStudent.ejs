      function csvEscape(value) {
        const raw = String(value == null ? '' : value);
        if (/[,"\n]/.test(raw)) {
          return '"' + raw.replace(/"/g, '""') + '"';
        }
        return raw;
      }

      function downloadBlob(filename, content, type) {
        const blob = new Blob([content], { type });
        const url = window.URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = filename;
        document.body.appendChild(a);
        a.click();
        document.body.removeChild(a);
        window.URL.revokeObjectURL(url);
      }

      function downloadCsvTemplate() {
        const headers = getStudentImportTemplateHeaders();
        const sections = getStudentImportTemplateSections();
        const csvLines = [
          'IMPORTANT: REMOVE EXAMPLE ROWS BEFORE IMPORT',
          '',
          'Current Term Tab (Section)',
          headers.map(csvEscape).join(','),
          ...sections.current.map((row) => row.map(csvEscape).join(',')),
          '',
          'Future Term Tab (Section)',
          headers.map(csvEscape).join(','),
          ...sections.future.map((row) => row.map(csvEscape).join(','))
        ];
        downloadBlob('managira student import template.csv', csvLines.join('\n'), 'text/csv;charset=utf-8');
      }

      function excelXmlEscape(value) {
        return String(value == null ? '' : value)
          .replace(/&/g, '&amp;')
          .replace(/</g, '&lt;')
          .replace(/>/g, '&gt;')
          .replace(/"/g, '&quot;')
          .replace(/'/g, '&apos;');
      }

      function buildExcelRow(values, styleId) {
        const styleAttr = styleId ? ` ss:StyleID="${styleId}"` : '';
        const cells = values
          .map((value) => `<Cell${styleAttr}><Data ss:Type="String">${excelXmlEscape(value)}</Data></Cell>`)
          .join('');
        return `<Row>${cells}</Row>`;
      }

      function buildExcelWorksheet(name, headers, rows) {
        const warningRow = buildExcelRow(['REMOVE EXAMPLE ROWS BEFORE IMPORT'], 'Warn');
        const emptyRow = '<Row><Cell><Data ss:Type="String"></Data></Cell></Row>';
        const headerRow = buildExcelRow(headers, 'Header');
        const dataRows = rows.map((row) => buildExcelRow(row, '')).join('');
        return `<Worksheet ss:Name="${excelXmlEscape(name)}"><Table>${warningRow}${emptyRow}${headerRow}${dataRows}</Table></Worksheet>`;
      }

      function downloadExcelTemplate() {
        const headers = getStudentImportTemplateHeaders();
        const sections = getStudentImportTemplateSections();
        const workbook = `<?xml version="1.0"?>
<?mso-application progid="Excel.Sheet"?>
<Workbook xmlns="urn:schemas-microsoft-com:office:spreadsheet"
 xmlns:o="urn:schemas-microsoft-com:office:office"
 xmlns:x="urn:schemas-microsoft-com:office:excel"
 xmlns:ss="urn:schemas-microsoft-com:office:spreadsheet"
 xmlns:html="http://www.w3.org/TR/REC-html40">
 <Styles>
  <Style ss:ID="Header"><Font ss:Bold="1"/></Style>
  <Style ss:ID="Warn"><Font ss:Bold="1" ss:Color="#FF0000"/></Style>
 </Styles>
 ${buildExcelWorksheet('Current', headers, sections.current)}
 ${buildExcelWorksheet('Future', headers, sections.future)}
</Workbook>`;
        downloadBlob('managira student import template.xls', workbook, 'application/vnd.ms-excel;charset=utf-8');
      }

      function downloadWordTemplate() {
        const headers = getStudentImportTemplateHeaders();
        const sections = getStudentImportTemplateSections();
        const studentHeaders = headers.slice(0, 15);
        const guardianHeaders = headers.slice(15);
        const mapRowsByRange = (rows, start, end) => rows.map((row) => row.slice(start, end));

        function renderWordTable(tableHeaders, tableRows) {
          const headerCells = tableHeaders
            .map((h) => `<th style="border:1px solid #d1d5db;padding:6px;background:#f8fafc;text-align:left;font-size:10px;word-break:break-word;">${escapeHtml(h)}</th>`)
            .join('');
          const bodyRows = tableRows
            .map((row) => `<tr>${row.map((v) => `<td style="border:1px solid #e5e7eb;padding:6px;font-size:10px;word-break:break-word;">${escapeHtml(v)}</td>`).join('')}</tr>`)
            .join('');
          return `<table style="border-collapse:collapse;width:100%;table-layout:fixed;font-size:10px;margin:0 0 14px;">
    <thead><tr>${headerCells}</tr></thead>
    <tbody>${bodyRows}</tbody>
  </table>`;
        }

        const currentStudentRows = mapRowsByRange(sections.current, 0, 15);
        const currentGuardianRows = mapRowsByRange(sections.current, 15);
        const futureStudentRows = mapRowsByRange(sections.future, 0, 15);
        const futureGuardianRows = mapRowsByRange(sections.future, 15);

        const docHtml = `<!DOCTYPE html>
<html><head><meta charset="utf-8"><title>Student Import Template</title>
<style>
  @page {
    size: A4 landscape;
    margin: 0.35in;
  }
</style>
</head>
<body style="font-family:Arial,sans-serif;color:#0f172a;">
  <h2 style="margin:0 0 8px;">Managira Student Import Template</h2>
  <p style="margin:0 0 14px;">Use this template to prepare student data for import on Add Student.</p>
  <p style="margin:0 0 14px;color:#dc2626;font-weight:700;">REMOVE EXAMPLE ROWS BEFORE IMPORT.</p>
  <p style="margin:0 0 14px;"><strong>Notes:</strong> Enrollment Type can be Current Term or Future Term. Gender can be Male or Female. Subjects can be comma-separated.</p>
  <h3 style="margin:0 0 8px;">Current Tab (Section)</h3>
  <p style="margin:0 0 6px;font-weight:700;font-size:11px;">Current - Student Columns</p>
  ${renderWordTable(studentHeaders, currentStudentRows)}
  <p style="margin:0 0 6px;font-weight:700;font-size:11px;">Current - Guardian Columns</p>
  ${renderWordTable(guardianHeaders, currentGuardianRows)}
  <h3 style="margin:0 0 8px;">Future Tab (Section)</h3>
  <p style="margin:0 0 6px;font-weight:700;font-size:11px;">Future - Student Columns</p>
  ${renderWordTable(studentHeaders, futureStudentRows)}
  <p style="margin:0 0 6px;font-weight:700;font-size:11px;">Future - Guardian Columns</p>
  ${renderWordTable(guardianHeaders, futureGuardianRows)}
</body></html>`;

        downloadBlob('managira student import template.doc', docHtml, 'application/msword;charset=utf-8');
      }

      function downloadTemplate() {
        downloadCsvTemplate();
      }
    </script>

