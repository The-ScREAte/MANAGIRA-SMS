function bindDobUnknownToggle(block) {
  if (!block) return;
  const idx = block.getAttribute('data-index');
  const dobInput =
    block.querySelector(`[name="dateOfBirth___${idx}"]`) ||
    block.querySelector(`[name="dateOfBirth_${idx}"]`) ||
    block.querySelector('input[name*="dateOfBirth"]');
  const dobUnknownToggle =
    block.querySelector(`[name="dateOfBirthUnknown___${idx}"]`) ||
    block.querySelector(`[name="dateOfBirthUnknown_${idx}"]`);

  if (!dobInput || !dobUnknownToggle) return;

  const applyState = () => {
    const isUnknown = Boolean(dobUnknownToggle.checked);
    dobInput.required = !isUnknown;
    dobInput.disabled = isUnknown;
    if (isUnknown) {
      dobInput.value = '';
      dobInput.dataset.unknownDob = 'true';
    } else {
      delete dobInput.dataset.unknownDob;
    }
  };

  applyState();
  dobUnknownToggle.addEventListener('change', applyState);
}

