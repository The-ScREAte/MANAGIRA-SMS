<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= title %></title>
    <!-- Title is now defined -->
    <style>
      :root {
        --font-family: "<%= (session && session.fontStyle ? String(session.fontStyle).trim() : 'Inter') %>", sans-serif;
      }

      body {
        margin: 0;
        font-family: var(--font-family);
        background: #f6f8fb;
        color: #0f2d32;
      }

      .page-shell {
        max-width: 1100px;
        margin: 24px auto 40px;
        padding: 0 18px;
      }

      .hero {
        background: linear-gradient(135deg, var(--org-primary-color, #0f5a66), #0d4f59);
        color: #fff;
        border-radius: 16px;
        padding: 22px 24px;
        box-shadow: 0 18px 36px rgba(0,0,0,0.14);
        margin-bottom: 16px;
      }

      .hero h1 {
        margin: 0 0 6px;
        font-size: 1.6rem;
        letter-spacing: 0.2px;
      }

      .hero p {
        margin: 0;
        opacity: 0.92;
      }

      .summary-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
        gap: 12px;
        margin-bottom: 16px;
      }

      .card {
        background: #fff;
        border: 1px solid #e5e7eb;
        border-radius: 14px;
        box-shadow: 0 10px 24px rgba(15,45,50,0.12);
        padding: 16px 18px;
      }

      .card h2 {
        margin: 0 0 8px;
        font-size: 1.05rem;
        color: #0f2d32;
        display: flex;
        align-items: center;
        gap: 8px;
      }

      .stat {
        font-size: 1.1rem;
        font-weight: 600;
        margin: 4px 0;
      }

      .badge {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 6px 10px;
        border-radius: 999px;
        background: rgba(15,90,102,0.08);
        color: #0f2d32;
        font-weight: 600;
        font-size: 0.95rem;
      }

      .classes-section {
        margin-top: 18px;
      }

      .classes-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 12px;
        margin-bottom: 12px;
        flex-wrap: wrap;
      }

      .class-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
        gap: 12px;
      }

      .class-card {
        background: #fff;
        border: 1px solid #e5e7eb;
        border-radius: 12px;
        padding: 14px 16px;
        box-shadow: 0 6px 16px rgba(15,45,50,0.1);
        display: flex;
        flex-direction: column;
        gap: 10px;
      }

      .class-name {
        font-size: 1.05rem;
        font-weight: 700;
        color: #0f2d32;
      }

      .actions {
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
      }

      .btn {
        padding: 10px 14px;
        font-size: 0.95rem;
        color: #fff;
        background-color: var(--org-primary-color, #0f5a66);
        border: 1px solid transparent;
        border-radius: 10px;
        text-decoration: none;
        cursor: pointer;
        transition: all 0.2s ease;
        font-weight: 600;
        box-shadow: 0 6px 14px rgba(15,90,102,0.16);
      }

      .btn:hover {
        background-color: var(--org-primary-hover, #0d4f59);
        transform: translateY(-1px);
      }

      @media (max-width: 768px) {
        .page-shell {
          padding: 0 12px;
          margin-top: 16px;
        }

        .class-grid {
          grid-template-columns: 1fr;
        }
      }
    </style>
  </head>
  <body>
    <%- include('../partials/flash') %>
    <div class="page-shell">
      <div class="hero">
        <h1><%= title %></h1>
        <p>Term overview, key dates, and quick actions for each class.</p>
      </div>

      <div class="summary-grid">
        <div class="card">
          <h2>📅 Term</h2>
          <div class="stat"><%= term.term_name %></div>
        </div>
        <div class="card">
          <h2>🗓️ Dates</h2>
          <div class="stat">Start: <%= new Date(term.start_date).toLocaleDateString() %></div>
          <div class="stat">End: <%= new Date(term.end_date).toLocaleDateString() %></div>
        </div>
        <div class="card">
          <h2>🏫 Classes</h2>
          <div class="stat"><%= (classes && classes.length) ? classes.length : 0 %> total</div>
        </div>
      </div>

      <div class="card classes-section">
        <div class="classes-header">
          <h2 style="margin:0; display:flex; align-items:center; gap:8px;">📂 Classes</h2>
          <div class="badge">Term ID: <%= termId %></div>
        </div>

        <% if (classes && classes.length > 0) { %>
        <div class="class-grid">
          <% classes.forEach(function(cls) { %>
          <div class="class-card">
            <div class="class-name"><%= cls.class_name %></div>
            <div class="actions">
              <a
                href="/print/printStudentReport?classId=<%= cls.class_id %>&termId=<%= termId %>"
                class="btn"
                data-no-spa
              >Generate Report</a>
              <% if (Array.isArray(allowedFeatures) &&
                (allowedFeatures.includes("Class Base Merit Sheet") || allowedFeatures.includes("Class Base Merrit sheet"))) { %>
              <a
                href="/print/meritSheetPage?classId=<%= cls.class_id %>&termId=<%= termId %>"
                class="btn"
                data-no-spa
              >Merit Sheet</a>
              <% } %>
            </div>
          </div>
          <% }); %>
        </div>
        <% } else { %>
        <div class="empty-state">No classes found for this term.</div>
        <% } %>
      </div>
    </div>
  </body>
</html>
