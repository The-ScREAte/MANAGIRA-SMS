<%
  const _embedded = typeof isEmbedded !== 'undefined' && isEmbedded;
  const _embedQs = _embedded ? '?embed=workspace' : '';
  const _embedAmp = _embedded ? '&embed=workspace' : '';
  const _classes = Array.isArray(typeof classes !== 'undefined' ? classes : null) ? classes : [];
  const _fmt = (d) => d ? (typeof formatDisplayDate === 'function' ? formatDisplayDate(d) : new Date(d).toLocaleDateString()) : '—';
  const _hasMerit = Array.isArray(typeof allowedFeatures !== 'undefined' ? allowedFeatures : null)
    && (allowedFeatures.includes('Class Base Merit Sheet') || allowedFeatures.includes('Class Base Merrit sheet'));
%>
<link rel="stylesheet" href="<%= assetUrl('/css/reportPages.css') %>" />
<style>.gp-layout { display: inline-flex; align-items: center; gap: 5px; margin-left: 6px; padding: 1px 8px; border-radius: 999px; background: color-mix(in srgb, #16a34a 12%, transparent); color: #15803d; font-size: .72rem; font-weight: 700; text-decoration: none; vertical-align: middle; } .gp-layout:hover { text-decoration: underline; }</style>

<div class="gp-page">
  <header class="gp-head">
    <div>
      <h1 class="gp-title"><%= term.term_name %></h1>
      <p class="gp-sub"><%= _fmt(term.start_date) %> – <%= _fmt(term.end_date) %> · <%= _classes.length %> class<%= _classes.length === 1 ? '' : 'es' %></p>
    </div>
    <a class="gp-btn gp-btn--ghost" href="/common/closeSchoolYear<%= _embedQs %>" data-no-spa><i class="fa-solid fa-arrow-left" aria-hidden="true"></i> All terms</a>
  </header>

  <%- include('../partials/flash') %>

  <section class="gp-card">
    <div class="gp-card__head">
      <h2 class="gp-card__title">Classes</h2>
      <span class="gp-card__note">Generate report cards<%= _hasMerit ? ' and merit sheets' : '' %> for a class.</span>
    </div>
    <% if (!_classes.length) { %>
      <p class="gp-card__note">No classes are enrolled in this term yet.</p>
    <% } else { %>
      <div class="gp-classes">
        <% _classes.forEach((cls) => { %>
          <div class="gp-class">
            <span class="gp-class__name"><%= cls.class_name %>
              <% const _layout = (typeof reportLayouts !== 'undefined' && reportLayouts) ? reportLayouts[cls.class_id] : null; %>
              <% if (_layout) { %><a class="gp-layout" href="/print/printStudentReport?classId=<%= cls.class_id %>&termId=<%= termId %>&layout=default<%= _embedAmp %>" data-no-spa title="Uses its own report card layout. Click for the standard report card."><i class="fa-solid fa-table" aria-hidden="true"></i> <%= _layout %></a><% } %>
            </span>
            <span class="gp-class__actions">
              <a class="gp-btn gp-btn--primary" href="/print/printStudentReport?classId=<%= cls.class_id %>&termId=<%= termId %><%= _embedAmp %>" data-no-spa><i class="fa-solid fa-file-lines" aria-hidden="true"></i> Generate report</a>
              <% if (_hasMerit) { %>
                <a class="gp-btn gp-btn--ghost" href="/print/meritSheetPage?classId=<%= cls.class_id %>&termId=<%= termId %><%= _embedAmp %>" data-no-spa>Merit sheet</a>
              <% } %>
            </span>
          </div>
        <% }) %>
      </div>
    <% } %>
  </section>
</div>
