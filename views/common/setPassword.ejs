<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    
<style>
body {
            margin: 0;
            min-height: 100vh;
            background: linear-gradient(180deg, #f8fafc 0%, #eef4f7 100%);
        }

        .container {
            width: 100%;
            max-width: 760px;
            margin: 0 auto;
            padding: 40px 24px;
            box-sizing: border-box;
        }

        .container form {
            background: #fff;
            border-radius: 16px;
            padding: 32px 28px;
            box-shadow: 0 16px 40px rgba(15, 23, 42, 0.08);
            box-sizing: border-box;
            border: 1px solid rgba(226, 232, 240, 0.9);
            width: 100%;
            overflow: hidden;
        }

        .container h1 {
            margin: 0 0 12px;
            color: #0f2d32;
            line-height: 1.2;
        }

        .container p {
            color: #475569;
            line-height: 1.6;
        }

        .form-group {
            margin-bottom: 18px;
        }

        @media (max-width: 640px) {
            .container {
                padding: 24px 16px 32px;
            }

            .container form {
                padding: 24px 18px;
                border-radius: 14px;
            }
        }

.password-input-wrapper {
      position: relative;
    }

    .password-input-wrapper input {
      padding-right: 45px;
    }

    .password-toggle-btn {
      position: absolute;
      right: 16px;
      top: 50%;
      transform: translateY(-50%);
      background: transparent;
      border: none;
      color: #64748b;
      cursor: pointer;
      padding: 4px;
      transition: color 0.2s ease;
      font-size: 0.95rem;
      display: flex;
      align-items: center;
      justify-content: center;
      z-index: 1;
      pointer-events: auto;
      width: 24px;
      height: 24px;
      flex-shrink: 0;
    }

    .password-toggle-btn:hover {
      color: #01535b;
      transform: translateY(-50%);
    }

    .password-toggle-btn:active {
      transform: translateY(-50%);
    }

    .password-toggle-btn:focus {
      outline: none;
      transform: translateY(-50%);
    }

    .password-toggle-btn i {
      font-size: 0.9rem;
      transition: none;
    }

        .form-group label {
            display: block;
            font-weight: bold;
            margin-bottom: 7px;
        }
        .form-group input {
            width: 100%;
            padding: 12px 14px;
            border: 1px solid #ddd;
            border-radius: 8px;
            box-sizing: border-box;
        }
        .form-group input:focus {
            outline: none;
            border-color: var(--org-primary-color, #01535b);
            box-shadow: 0 0 0 3px rgba(1, 83, 91, 0.12);
        }
        .btn-primary {
            background-color: var(--org-primary-color, #01535b);
            color: #fff;
            padding: 12px 16px;
            border: none;
            border-radius: 8px;
            cursor: pointer;
            width: 100%;
            font-weight: 700;
        }
        .btn-primary:hover {
            background-color: var(--org-primary-hover, #01464d);
        }
        .password-strength {
            font-size: 0.9rem;
            margin-top: 5px;
            font-weight: bold;
            transition: color 0.5s ease, transform 0.3s ease;
        }
        .password-strength.weak {
            color: red;
        }
        .password-strength.medium {
            color: orange;
        }
        .password-strength.strong {
            color: green;
        }
        .password-note {
            font-size: 0.8rem;
            color: #666;
            margin-top: 8px;
        }
        .password-note ul {
            margin: 8px 0 0 20px;
            padding: 0;
        }
        .password-note ul li {
            font-size: 0.8rem;
            line-height: 1.4rem;
            color: #333;
        }
</style>    
<script src="/js/script.js" defer></script>
</head>
<body>
    <div class="container">
        <form action="/common/set-password" method="POST" onsubmit="return validatePasswords();">
            <h1>Set Your Password</h1>

            <%- include('../partials/flash') %>


            <p>
                Welcome, <%= user.first_name %> <%= user.last_name %>! 
                The invite will be marked as accepted once you set your password. 
                You are setting your password for the email: <strong><%= user.email %></strong> 
                as a <%= user.role %>
            </p>
            
            <input type="hidden" name="token" value="<%= token %>">
            <input type="hidden" name="type" value="<%= typeof type !== 'undefined' ? type : '' %>">

            <div class="form-group">
                <label for="password">New Password:</label>
                <div class="password-input-wrapper">
                    <input type="password" name="password" id="password" required oninput="checkPasswordStrength(this.value)">
                    <button type="button" class="password-toggle-btn" onclick="toggleMultiplePasswords(['password', 'confirmPassword'], this)" aria-label="Show passwords">
                        <i class="fa-solid fa-eye fa-fw" aria-hidden="true"></i>
                    </button>
                </div>
                <p id="password-strength" class="password-strength"></p>
                <p class="password-note">
                    Password must be at least 6 characters long and include:
                    <ul>
                        <li>At least one uppercase letter (A-Z)</li>
                        <li>At least one lowercase letter (a-z)</li>
                        <li>At least one number (0-9)</li>
                        <li>At least one special character (!@#$%^&*)</li>
                    </ul>
                </p>
            </div>

            <div class="form-group">
                <label for="confirmPassword">Confirm Password:</label>
                <div class="password-input-wrapper">
                    <input type="password" name="confirmPassword" id="confirmPassword" required>
                </div>
            </div>

            <button type="submit" class="btn btn-primary">Set Password</button>
        </form>
    </div>

    <script>
        function toggleMultiplePasswords(inputIds, button) {
            const icon = button.querySelector('i');
            const firstInput = document.getElementById(inputIds[0]);
            const isVisible = firstInput.type === 'text';
            
            inputIds.forEach(id => {
                const input = document.getElementById(id);
                if (input) input.type = isVisible ? 'password' : 'text';
            });
            
            icon.classList.remove('fa-eye', 'fa-eye-slash');
            icon.classList.add(isVisible ? 'fa-eye' : 'fa-eye-slash');
            button.setAttribute('aria-label', isVisible ? 'Show passwords' : 'Hide passwords');
        }

        function validatePasswords() {
            const password = document.getElementById('password').value;
            const confirmPassword = document.getElementById('confirmPassword').value;

            if (password !== confirmPassword) {
                alert("Passwords do not match. Please try again.");
                return false;
            }

            if (password.length < 6) {
                alert("Password must be at least 6 characters long.");
                return false;
            }

            return true;
        }
        function checkPasswordStrength(password) {
            const strengthElement = document.getElementById("password-strength");
            const regexWeak = /(?=.*[a-z])/; // At least one lowercase letter
            const regexMedium = /(?=.*[a-z])(?=.*[A-Z])/; // Lowercase and uppercase
            const regexStrong = /(?=.*[a-z])(?=.*[A-Z])(?=.*\d)(?=.*[!@#$%^&*])/; // Strong conditions

            if (regexStrong.test(password)) {
                strengthElement.textContent = "Strong password";
                strengthElement.className = "password-strength strong";
            } else if (regexMedium.test(password)) {
                strengthElement.textContent = "Medium password";
                strengthElement.className = "password-strength medium";
            } else if (regexWeak.test(password)) {
                strengthElement.textContent = "Weak password";
                strengthElement.className = "password-strength weak";
            } else {
                strengthElement.textContent = "";
                strengthElement.className = "password-strength";
            }
        }
    </script>
</body>
</html>
