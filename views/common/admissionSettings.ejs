<%
  const themeColor = (typeof session !== 'undefined' && session && session.themeColor) ? session.themeColor : 'teal';
  const themeColors = Object.fromEntries(Object.entries(themePalette).map(([k, v]) => [k, v.primary]));
  const primary = themeColors[themeColor] || themeColors.teal;
  const _embedded = typeof isEmbeddedFrame !== 'undefined' && isEmbeddedFrame;
  const _ymd = (d) => { if (!d) return ''; const x = new Date(d); return isNaN(x) ? '' : [x.getFullYear(), String(x.getMonth() + 1).padStart(2, '0'), String(x.getDate()).padStart(2, '0')].join('-'); };
  const _cur = org.public_registration_currency || 'USD';
  const _rs = registrationStatus || { open: false, message: '' };
  const _flash = (typeof messages !== 'undefined' && messages) || {};
%>
<style>
  #asRoot, #asDialog {
    --as-primary: <%= primary %>;
    --as-surface: var(--ap-surface, #fff);
    --as-soft: var(--ap-surface-2, #f6f8fa);
    --as-line: var(--ap-line, #d4d4d8);
    --as-edge: #8ea3b6;
    --as-text: var(--ap-text, #13202b);
    --as-muted: var(--ap-muted, #667788);
    font-family: 'Manrope', 'Segoe UI', sans-serif;
    color: var(--as-text);
  }
  #asRoot { min-height: 100%; padding: 24px 24px 56px; background: transparent; box-sizing: border-box; }
  #asRoot *, #asDialog * { box-sizing: border-box; }
  #asRoot :where(button), #asDialog :where(button) { width: auto; margin: 0; font-family: inherit; line-height: 1.2; }
  #asRoot :where(input, select, textarea), #asDialog :where(input, select, textarea) { width: 100%; height: 38px; margin: 0; padding: 0 12px; border: 1.5px solid var(--as-edge); border-radius: 9px; background: var(--as-surface); color: var(--as-text); font: inherit; font-size: 13.5px; font-weight: 500; }
  #asRoot textarea, #asDialog textarea { height: auto; min-height: 84px; padding: 9px 12px; resize: vertical; }
  #asRoot :where(input, select, textarea)::placeholder, #asDialog :where(input, select, textarea)::placeholder { color: #a6b2be; font-weight: 400; }
  #asRoot :where(input, select, textarea):focus, #asDialog :where(input, select, textarea):focus { outline: none; border-color: var(--as-primary); box-shadow: 0 0 0 3px color-mix(in srgb, var(--as-primary) 15%, transparent); }
  #asRoot input[type="checkbox"], #asDialog input[type="checkbox"] { width: 16px; height: 16px; padding: 0; accent-color: var(--as-primary); box-shadow: none; }
  #asRoot svg, #asDialog svg { flex: none; }
  [hidden] { display: none !important; }

  /* Header and tabs */
  .as-head { display: flex; align-items: center; gap: 12px; }
  .as-head__icon { display: grid; place-items: center; width: 40px; height: 40px; border-radius: 9px; color: var(--as-primary); background: color-mix(in srgb, var(--as-primary) 11%, var(--as-surface)); }
  .as-head__icon svg { width: 18px; height: 18px; }
  .as-head h1 { margin: 0; font-size: 22px; font-weight: 700; font-family: inherit; letter-spacing: -.01em; text-align: left; }
  .as-tabs { display: flex; gap: 4px; margin: 20px 0 24px; border-bottom: 1.5px solid var(--as-line); }
  #asRoot .as-tab { display: inline-flex; align-items: center; gap: 8px; height: 42px; padding: 0 14px; border: 0; border-bottom: 2px solid transparent; margin-bottom: -1.5px; border-radius: 0; background: none; color: var(--as-muted); font-size: 13.5px; font-weight: 700; cursor: pointer; }
  #asRoot .as-tab.is-on { color: var(--as-primary); border-bottom-color: var(--as-primary); }
  #asRoot .as-tab:focus-visible { outline: 2px solid var(--as-primary); outline-offset: -2px; }
  .as-tab svg, .as-btn svg, .as-icon-btn svg, .as-menu button svg { width: 16px; height: 16px; stroke-width: 2; }
  .as-panel[hidden] { display: none; }
  @media (max-width: 560px) {
    #asRoot .as-tabs { gap: 0; }
    #asRoot .as-tab { flex: 1 1 0; flex-direction: column; justify-content: center; gap: 4px; height: auto; min-height: 56px; padding: 8px 4px; font-size: 12px; line-height: 1.2; text-align: center; white-space: normal; }
  }

  /* Cards, buttons */
  .as-card { background: var(--as-surface); border: 1.5px solid var(--as-line); border-radius: 9px; }
  .as-card + .as-card { margin-top: 16px; }
  .as-card__head { display: flex; align-items: center; justify-content: space-between; gap: 12px; flex-wrap: wrap; padding: 16px var(--card-pad, 18px); }
  .as-card__head h2 { margin: 0; font-size: 12px; font-weight: 800; letter-spacing: .06em; text-transform: uppercase; color: var(--as-muted); text-align: left; }
  .as-card__body { padding: 0 var(--card-pad, 18px) var(--card-pad, 18px); }
  .as-btn { display: inline-flex; align-items: center; justify-content: center; gap: 6px; height: 36px; padding: 0 14px; border: 1.5px solid var(--as-edge); border-radius: 9px; background: var(--as-surface); color: var(--as-text); font-size: 13px; font-weight: 700; cursor: pointer; white-space: nowrap; text-decoration: none; }
  .as-btn:hover { background: var(--as-soft); }
  .as-btn--primary { background: var(--as-primary); border-color: var(--as-primary); color: #fff; }
  .as-btn--primary:hover { background: var(--as-primary); filter: brightness(.93); }
  .as-btn:disabled { opacity: .45; cursor: default; }
  .as-icon-btn { display: inline-grid; place-items: center; width: 30px; height: 30px; padding: 0; border: 0; border-radius: 8px; background: transparent; color: var(--as-muted); cursor: pointer; }
  .as-icon-btn:hover, .as-icon-btn[aria-expanded="true"] { background: var(--as-soft); color: var(--as-text); }
  .as-icon-btn:focus-visible, .as-btn:focus-visible, .as-menu button:focus-visible { outline: 2px solid var(--as-primary); outline-offset: 1px; }
  .as-flash { margin: 0 0 16px; padding: 10px 14px; border-radius: 9px; font-size: 13.5px; font-weight: 600; }
  .as-flash--success { background: #ecfdf3; color: #166534; }
  .as-flash--error { background: #fdecec; color: #b42318; }

  /* Online admission */
  .as-status { display: flex; align-items: center; justify-content: space-between; gap: 12px; flex-wrap: wrap; padding: 12px 14px; border-radius: 9px; font-size: 13.5px; background: var(--as-soft); }
  .as-status.is-open { background: #ecfdf3; color: #166534; }
  .as-status strong { margin-right: 6px; }
  .as-status a { color: inherit; font-weight: 700; }
  .as-switch { display: flex; align-items: center; gap: 12px; padding: 12px 14px; border: 1.5px solid var(--as-line); border-radius: 9px; cursor: pointer; margin: 0; }
  .as-switch strong { display: block; font-size: 13.5px; }
  .as-switch span { font-size: 12.5px; color: var(--as-muted); }
  .as-toggle { position: relative; flex: none; width: 26px; height: 15px; }
  #asRoot .as-toggle input { position: absolute; inset: 0; width: 100%; height: 100%; margin: 0; opacity: 0; cursor: pointer; }
  .as-toggle i { position: absolute; inset: 0; border-radius: 999px; background: #7890b2; transition: background-color .15s; pointer-events: none; }
  .as-toggle i::after { content: ""; position: absolute; top: 2px; left: 2px; width: 11px; height: 11px; border-radius: 50%; background: #fff; box-shadow: 0 1px 2px rgba(0,0,0,.2); transition: transform .15s; }
  .as-toggle input:checked + i { background: var(--as-primary); }
  .as-toggle input:checked + i::after { transform: translateX(11px); }
  .as-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 16px; margin-top: 16px; }
  .as-field { display: grid; gap: 6px; margin: 0; font-size: 11px; font-weight: 800; letter-spacing: .05em; text-transform: uppercase; color: var(--as-muted); }
  .as-field input, .as-field select, .as-field textarea { text-transform: none; letter-spacing: 0; }
  .as-btn--small { height: 28px; padding: 0 10px; font-size: 12px; }
  .as-actions { display: flex; justify-content: flex-end; gap: 8px; margin-top: 20px; }

  /* Student fields */
  #asRoot .as-always { margin: 0 0 16px; border: 1.5px solid var(--as-line); border-radius: 9px; background: var(--as-surface); }
  #asRoot .as-always summary { display: flex; align-items: center; gap: 10px; min-height: 48px; padding: 0 16px; cursor: pointer; list-style: none; }
  #asRoot .as-always summary::-webkit-details-marker { display: none; }
  #asRoot .as-always__icon { display: grid; place-items: center; width: 16px; height: 16px; color: var(--as-muted); }
  #asRoot .as-always__icon svg { width: 16px; height: 16px; }
  #asRoot .as-always summary strong { font-size: 13.5px; }
  #asRoot .as-always__count { font-size: 12.5px; color: var(--as-muted); }
  #asRoot .as-always__more { margin-left: auto; font-size: 12.5px; font-weight: 700; color: var(--as-primary); }
  #asRoot .as-always[open] .as-always__more { font-size: 0; }
  #asRoot .as-always[open] .as-always__more::before { content: "Hide"; font-size: 12.5px; }
  .as-std { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px; padding: 4px 16px 16px; }
  .as-std__col h3 { margin: 0 0 8px; font-size: 11px; font-weight: 800; letter-spacing: .06em; text-transform: uppercase; color: var(--as-muted); text-align: left; }
  .as-chips { display: flex; flex-wrap: wrap; gap: 6px; }
  .as-chips span { padding: 4px 10px; border-radius: 7px; background: var(--as-soft); font-size: 12.5px; font-weight: 600; }
  #asRoot .as-filesrow { margin: 0 0 16px; }
  .as-filter { display: inline-flex; gap: 2px; padding: 3px; border: 1.5px solid var(--as-edge); border-radius: 9px; background: var(--as-surface); }
  #asRoot .as-filter button { height: 28px; padding: 0 12px; border: 0; border-radius: 7px; background: none; color: var(--as-muted); font-size: 12.5px; font-weight: 700; cursor: pointer; }
  #asRoot .as-filter button.is-on { background: var(--as-primary); color: #fff; }
  .as-tools { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }
  .as-list { display: grid; gap: 20px; }
  .as-group__head { display: flex; align-items: center; gap: 8px; min-height: 32px; margin: 0 0 8px; }
  .as-group__head h3 { margin: 0; font-size: 11px; font-weight: 800; letter-spacing: .06em; text-transform: uppercase; color: var(--as-muted); text-align: left; }
  .as-group__head > span { font-size: 12px; color: var(--as-muted); }
  .as-group__head .as-icon-btn { margin-left: auto; width: 28px; height: 28px; }
  #asRoot .as-group__head[data-fold] { cursor: pointer; }
  #asRoot .as-group__chev { width: 7px; height: 7px; flex: none; margin: 0 2px 0 2px; border-right: 2px solid var(--as-muted); border-bottom: 2px solid var(--as-muted); transform: rotate(45deg); transition: transform .15s; }
  #asRoot .as-group.is-folded .as-group__chev { transform: rotate(-45deg); }
  #asRoot .as-group.is-folded .as-group__list { display: none; }
  #asRoot .as-group.is-folded .as-group__head { margin-bottom: 0; }
  .as-dragging #asRoot .as-group.is-folded .as-group__list { display: grid; }
  .as-group__list { border: 1.5px solid var(--as-line); border-radius: 9px; background: var(--as-surface); min-height: 0; }
  .as-group.is-empty .as-group__list { display: none; }
  .as-dragging .as-group.is-empty .as-group__list { display: grid; border-style: dashed; min-height: 40px; }
  .as-group.is-empty .as-group__empty { display: none; }
  .as-dragging .as-group.is-empty .as-group__empty { display: grid; }
  .as-group__empty { display: grid; place-items: center; min-height: 40px; font-size: 12px; color: var(--as-muted); }
  .as-row { display: grid; grid-template-columns: 24px minmax(0, 1fr) 130px 76px 56px 32px; align-items: center; gap: 8px; min-height: 46px; padding: 0 8px 0 4px; border-top: 1.5px solid var(--as-line); background: var(--as-surface); }
  .as-row:first-child { border-top: 0; border-radius: 9px 9px 0 0; }
  .as-row:last-child { border-radius: 0 0 9px 9px; }
  .as-row:only-child { border-radius: 9px; }
  .as-row:hover { background: var(--as-soft); }
  .as-row.is-obsolete .as-row__name { opacity: .55; }
  .as-grip { display: grid; place-items: center; width: 24px; height: 30px; color: var(--as-muted); opacity: .55; cursor: grab; touch-action: none; }
  .as-grip svg { width: 14px; height: 14px; }
  .as-row__name { display: flex; align-items: center; gap: 8px; min-width: 0; font-size: 13.5px; font-weight: 700; }
  .as-row__name b { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-weight: 700; }
  .as-dot { flex: none; width: 6px; height: 6px; border-radius: 50%; background: #d0453c; }
  .as-row__type { display: flex; align-items: center; gap: 8px; min-width: 0; font-size: 12.5px; color: var(--as-muted); white-space: nowrap; }
  .as-row__type svg { width: 16px; height: 16px; stroke-width: 2; }
  .as-row__type span { overflow: hidden; text-overflow: ellipsis; }
  .as-row__where { font-size: 12px; color: var(--as-muted); white-space: nowrap; }
  .as-chip { justify-self: start; padding: 2px 8px; border-radius: 999px; background: var(--as-soft); border: 1px solid var(--as-line); font-size: 11px; font-weight: 700; color: var(--as-muted); }
  .as-chip--warn { background: #fdf3dc; border-color: transparent; color: #8a5a00; }
  .as-menuwrap { position: relative; }
  .as-menu { position: absolute; right: 0; top: calc(100% + 4px); z-index: 40; display: none; min-width: 176px; padding: 4px; border: 1.5px solid var(--as-line); border-radius: 9px; background: var(--as-surface); box-shadow: 0 12px 28px -10px rgba(15, 23, 42, .3); }
  .as-menu.is-open { display: grid; }
  .as-menu button { display: flex; align-items: center; gap: 10px; height: 34px; padding: 0 10px; border: 0; border-radius: 7px; background: none; color: var(--as-text); font-size: 13px; font-weight: 600; text-align: left; cursor: pointer; }
  .as-menu button svg { color: var(--as-muted); }
  .as-menu button:hover { background: var(--as-soft); }
  .as-menu .is-danger, .as-menu .is-danger svg { color: #b42318; }
  .as-empty { display: grid; justify-items: center; gap: 10px; padding: 32px 16px; border: 1.5px dashed var(--as-line); border-radius: 9px; text-align: center; color: var(--as-muted); font-size: 13px; }
  .as-empty strong { color: var(--as-text); font-size: 14px; }
  .as-dragging, .as-dragging * { cursor: grabbing !important; user-select: none; }
  .as-placeholder { opacity: .35; }
  .as-ghost { position: fixed; z-index: 20000; margin: 0; pointer-events: none; border: 1.5px solid var(--as-line); border-radius: 9px; box-shadow: 0 16px 40px -10px rgba(16, 32, 48, .35); opacity: .97; }
  .as-toast { position: fixed; left: 50%; bottom: 22px; z-index: 20003; transform: translate(-50%, 10px); opacity: 0; padding: 9px 14px; border-radius: 9px; background: #13202b; color: #fff; font-size: 13px; font-weight: 600; transition: .2s; pointer-events: none; }
  .as-toast.is-on { opacity: 1; transform: translate(-50%, 0); }
  #asRoot [data-as-panel="family"] #ctRoot { padding: 0; }

  /* Field panel: slides in from the right, under the app header; closes only with X or Esc. */
  #asDialog { position: fixed; inset: 0; z-index: 20002; display: none; justify-content: flex-end; background: rgba(15, 23, 42, .35); }
  #asDialog.is-open { display: flex; }
  .as-dlg { display: flex; flex-direction: column; width: min(1040px, 100vw); height: 100%; background: var(--as-surface); border-left: 1.5px solid var(--as-line); box-shadow: -20px 0 50px -24px rgba(15, 23, 42, .4); animation: as-slide .22s ease-out; }
  @keyframes as-slide { from { transform: translateX(40px); opacity: 0; } to { transform: none; opacity: 1; } }
  @media (prefers-reduced-motion: reduce) { .as-dlg { animation: none; } }
  .as-dlg > form { display: flex; flex-direction: column; flex: 1; min-height: 0; }
  .as-dlg__head { display: flex; align-items: center; justify-content: space-between; gap: 12px; flex: none; padding: 14px 20px; border-bottom: 1.5px solid var(--as-line); }
  .as-dlg__head h2 { margin: 0; font-size: 13px; font-weight: 800; letter-spacing: .06em; text-transform: uppercase; text-align: left; }
  .as-dlg__body { display: grid; align-content: start; gap: 16px; flex: 1; min-height: 0; overflow-y: auto; padding: 20px; }
  .as-dlg__foot { display: flex; align-items: center; justify-content: flex-end; gap: 12px; flex: none; padding: 12px 20px; border-top: 1.5px solid var(--as-line); background: var(--as-surface); }
  .as-dlg__foot > div { display: flex; gap: 8px; }
  .as-error { flex: 1; min-height: 18px; margin: 0; font-size: 12.5px; color: #c0262d; }
  .as-types { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 8px; }
  #asDialog .as-types button { display: flex; align-items: center; gap: 8px; height: 38px; padding: 0 10px; border: 1.5px solid var(--as-edge); border-radius: 9px; background: var(--as-surface); color: var(--as-text); font-size: 12.5px; font-weight: 700; text-transform: none; letter-spacing: 0; cursor: pointer; text-align: left; }
  #asDialog .as-types button svg { width: 16px; height: 16px; color: var(--as-muted); }
  #asDialog .as-types button.is-on { border-color: var(--as-primary); background: color-mix(in srgb, var(--as-primary) 8%, var(--as-surface)); box-shadow: 0 0 0 1px var(--as-primary) inset; }
  #asDialog .as-types button.is-on svg { color: var(--as-primary); }
  #asDialog .as-types button:disabled { cursor: default; opacity: .45; }
  #asDialog .as-types button.is-on:disabled { opacity: 1; }
  .as-checks, .as-two { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; }
  .as-check { display: flex; align-items: center; gap: 10px; min-height: 38px; padding: 0 12px; border: 1.5px solid var(--as-edge); border-radius: 9px; cursor: pointer; font-size: 13px; font-weight: 700; text-transform: none; letter-spacing: 0; color: var(--as-text); }
  .as-check:has(input:checked) { border-color: var(--as-primary); background: color-mix(in srgb, var(--as-primary) 6%, var(--as-surface)); }
  .as-seg { display: grid; grid-template-columns: 1fr 1fr; height: 38px; padding: 3px; border: 1.5px solid var(--as-edge); border-radius: 9px; background: var(--as-surface); }
  #asDialog .as-seg button { border: 0; border-radius: 7px; background: none; color: var(--as-muted); font-size: 12.5px; font-weight: 700; text-transform: none; letter-spacing: 0; cursor: pointer; }
  #asDialog .as-seg button.is-on { background: var(--as-primary); color: #fff; }

  @media (max-width: 900px) { .as-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 640px) {
    #asRoot { padding: 16px 16px 40px; }
    .as-grid, .as-std { grid-template-columns: minmax(0, 1fr); }
    .as-types { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .as-row { grid-template-columns: 24px minmax(0, 1fr) 56px 32px; }
    .as-row__type, .as-row__where { display: none; }
    .as-card__head { padding: 14px 16px; }
    .as-card__body { padding: 0 16px 16px; }
  }
</style>

<div id="asRoot">
  <div class="as-head">
    <span class="as-head__icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 10 12 5 2 10l10 5 10-5Z"/><path d="M6 12v5c3 2 9 2 12 0v-5"/></svg></span>
    <h1>Admission Settings</h1>
  </div>

  <nav class="as-tabs" role="tablist">
    <% if (hasWebsite) { %>
    <button type="button" class="as-tab <%= tab === 'online' ? 'is-on' : '' %>" role="tab" data-as-tab="online">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3a14 14 0 0 1 0 18M12 3a14 14 0 0 0 0 18"/></svg>
      Online admission
    </button>
    <% } %>
    <% if (canAdmissions) { %>
    <button type="button" class="as-tab <%= tab === 'forms' ? 'is-on' : '' %>" role="tab" data-as-tab="forms">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 10 12 5 2 10l10 5 10-5Z"/><path d="M6 12v5c3 2 9 2 12 0v-5"/></svg>
      Student fields
    </button>
    <% } %>
    <% if (canFamily) { %>
    <button type="button" class="as-tab <%= tab === 'family' ? 'is-on' : '' %>" role="tab" data-as-tab="family">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="8" r="3.2"/><path d="M3 20a6 6 0 0 1 12 0"/><circle cx="17" cy="9.5" r="2.4"/><path d="M15.5 14.4A4.6 4.6 0 0 1 21 19"/></svg>
      Parents &amp; guardians
    </button>
    <% } %>
  </nav>

  <% if (_flash.success && _flash.success.length) { %><p class="as-flash as-flash--success"><%= _flash.success[0] %></p><% } %>
  <% if (_flash.error && _flash.error.length) { %><p class="as-flash as-flash--error"><%= _flash.error[0] %></p><% } %>

  <% if (hasWebsite) { %>
  <section class="as-panel" data-as-panel="online" <%= tab === 'online' ? '' : 'hidden' %>>
    <div class="as-card">
      <div class="as-card__head">
        <div>
          <h2>Online applications</h2>
        </div>
      </div>
      <div class="as-card__body">
        <div class="as-status <%= _rs.open ? 'is-open' : 'is-closed' %>">
          <span><strong><%= _rs.open ? 'Open' : 'Closed' %></strong><%= _rs.message %></span>
          <a href="/common/publicRegister?organizationId=<%= organizationId %>" target="_blank" rel="noopener">Preview the application form ↗</a>
        </div>
        <form action="/account/updatePublicRegistration" method="POST" style="margin-top:14px">
          <input type="hidden" name="returnTo" value="admissionSettings" />
          <input type="hidden" name="embed" value="<%= _embedded ? 'workspace' : '' %>" />
          <label class="as-switch">
            <span class="as-toggle"><input type="checkbox" name="enabled" <%= org.public_registration_enabled ? 'checked' : '' %> /><i></i></span>
            <span><strong>Accept applications online</strong></span>
          </label>
          <div class="as-grid">
            <label class="as-field">Opens on<input type="date" name="startDate" value="<%= _ymd(org.registration_start_date) %>" /></label>
            <label class="as-field">Closes on<input type="date" name="endDate" value="<%= _ymd(org.registration_end_date) %>" /></label>
            <label class="as-field">Currency
              <select name="currency">
                <% ['USD','GHS','NGN','KES','ZAR','UGX','TZS','RWF','XAF','XOF','EUR','GBP'].forEach((code) => { %>
                <option value="<%= code %>" <%= _cur === code ? 'selected' : '' %>><%= code %></option>
                <% }) %>
              </select>
            </label>
            <label class="as-field">Application fee<input type="number" min="0" step="0.01" name="price" value="<%= Number(org.public_registration_price) > 0 ? org.public_registration_price : '' %>" placeholder="0 (free)" /></label>
          </div>
          <p class="as-flash as-flash--error" id="asDatesNeeded" role="status" hidden style="margin:12px 0 0">Set when applications open and close.</p>
          <div class="as-actions"><button type="submit" class="as-btn as-btn--primary">Save online admission</button></div>
        </form>
        <script nonce="<%= locals.cspNonce || '' %>">
          (function () {
            var f = document.getElementById('asDatesNeeded'); if (!f) return;
            var form = f.closest('form'), on = form.elements.enabled, a = form.elements.startDate, b = form.elements.endDate;
            var sync = function () { f.hidden = !(on.checked && (!a.value || !b.value)); };
            [on, a, b].forEach(function (el) { el.addEventListener('change', sync); el.addEventListener('input', sync); });
            sync();
          })();
        </script>
      </div>
    </div>
  </section>
  <% } %>

  <% if (canAdmissions) { %>
  <section class="as-panel" data-as-panel="forms" <%= tab === 'forms' ? '' : 'hidden' %>>
    <details class="as-always">
      <summary>
        <span class="as-always__icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="11" width="14" height="10" rx="2"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/></svg></span>
        <strong>Always asked</strong>
        <span class="as-always__count"><%= standardFields.student.length %> fields</span>
        <span class="as-always__more" aria-hidden="true">Show</span>
      </summary>
      <div class="as-std">
        <div class="as-std__col">
          <h3>Add Student form</h3>
          <div class="as-chips"><% standardFields.student.forEach((f) => { %><span><%= f %></span><% }) %></div>
        </div>
        <% if (hasWebsite) { %>
        <div class="as-std__col">
          <h3>Online application</h3>
          <div class="as-chips"><% standardFields.application.forEach((f) => { %><span><%= f %></span><% }) %></div>
        </div>
        <% } %>
      </div>
    </details>

    <% if (locals.filesSettings) { %>
    <%# Student files on Add student (utils/studentDocuments.js settingsFor). %>
    <div class="as-filesrow" id="asFilesCard">
      <label class="as-switch">
        <span class="as-toggle"><input type="checkbox" id="asFilesRequired" <%= filesSettings.requiredOnAdd ? 'checked' : '' %> /><i></i></span>
        <span><strong>Require a file for each new student</strong><span id="asFilesState"><%= filesSettings.requiredOnAdd ? 'Required' : 'Optional' %></span></span>
      </label>
    </div>
    <script nonce="<%= locals.cspNonce || '' %>">
      (function () {
        var box = document.getElementById('asFilesRequired');
        if (!box || box.dataset.bound) return;
        box.dataset.bound = '1';
        var state = document.getElementById('asFilesState');
        var text = function (on) { return on ? 'Required' : 'Optional'; };
        box.addEventListener('change', function () {
          var wanted = box.checked;
          box.disabled = true;
          state.textContent = 'Saving…';
          fetch('/common/admissionSettings/files', { method: 'POST', credentials: 'same-origin', headers: { 'Content-Type': 'application/json', Accept: 'application/json' }, body: JSON.stringify({ requiredOnAdd: wanted }) })
            .then(function (r) { return r.json().then(function (j) { if (!r.ok || !j.success) throw new Error(j.error || 'Not saved'); return j; }); })
            .then(function (j) { box.checked = j.requiredOnAdd; state.textContent = text(j.requiredOnAdd) + ' · Saved'; })
            .catch(function (e) { box.checked = !wanted; state.textContent = (e.message || 'Not saved') + '. ' + text(!wanted); })
            .then(function () { box.disabled = false; });
        });
      })();
    </script>
    <% } %>

    <div class="as-card">
      <div class="as-card__head">
        <div>
          <h2>Your fields</h2>
        </div>
        <div class="as-tools">
          <% if (hasWebsite) { %>
          <div class="as-filter" role="group" aria-label="Show fields for">
            <button type="button" class="is-on" data-as-filter="all">All</button>
            <button type="button" data-as-filter="student">Add Student</button>
            <button type="button" data-as-filter="application">Online application</button>
          </div>
          <% } %>
          <button type="button" class="as-btn as-btn--primary" data-as-add>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><path d="M12 5v14M5 12h14"/></svg>
            Add field
          </button>
        </div>
      </div>
      <div class="as-card__body">
        <div class="as-list" id="asList"></div>
      </div>
    </div>
  </section>
  <% } %>

  <% if (canFamily) { %>
  <section class="as-panel" data-as-panel="family" <%= tab === 'family' ? '' : 'hidden' %>>
    <%- include('./contactTemplate', { template: familyTemplate, baseFields: familyBaseFields, fieldTypes: familyFieldTypes, inAdmissions: true }) %>
  </section>
  <% } %>
  <div class="as-toast" id="asToast" role="status"></div>
</div>

<div id="asDialog" data-popup-lift role="dialog" aria-modal="true" aria-labelledby="asDialogTitle"><div class="as-dlg" id="asDlg"></div></div>

<script nonce="<%= locals.cspNonce || '' %>" type="application/json" id="asData"><%- JSON.stringify({ fields: formFields, types: fieldTypes, sections: (typeof fieldSections !== 'undefined' ? fieldSections : { more: 'More Details' }), hasWebsite, indicators: (typeof indicatorLabels !== 'undefined' ? indicatorLabels : []) }).replace(/</g, '\\u003c') %></script>
<script nonce="<%= locals.cspNonce || '' %>">
(function () {
  const root = document.getElementById('asRoot');
  if (!root || root.dataset.ready) return;
  root.dataset.ready = '1';
  const data = JSON.parse(document.getElementById('asData').textContent);
  let fields = data.fields;
  const TYPES = data.types;
  const SECTIONS = data.sections || { more: 'More Details' };
  const secOf = (f) => (SECTIONS[f.section] ? f.section : (SECTIONS.more ? 'more' : Object.keys(SECTIONS)[0]));
  const hasWebsite = data.hasWebsite;
  const missingIndicators = () => (data.indicators || []).filter((label) => !fields.some((f) => String(f.label).toLowerCase() === label.toLowerCase()));
  let filter = 'all';
  const list = document.getElementById('asList');
  const dialog = document.getElementById('asDialog');
  const dlg = document.getElementById('asDlg');
  const esc = (s) => String(s == null ? '' : s).replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
  const svg = (d, w) => `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="${w || 2}" stroke-linecap="round" stroke-linejoin="round">${d}</svg>`;
  const ICON = {
    grip: '<svg viewBox="0 0 24 24" fill="currentColor"><circle cx="9" cy="6" r="1.6"/><circle cx="15" cy="6" r="1.6"/><circle cx="9" cy="12" r="1.6"/><circle cx="15" cy="12" r="1.6"/><circle cx="9" cy="18" r="1.6"/><circle cx="15" cy="18" r="1.6"/></svg>',
    edit: svg('<path d="M12 20h9"/><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4Z"/>'),
    archive: svg('<rect x="3" y="4" width="18" height="4" rx="1"/><path d="M5 8v11a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1V8M10 12h4"/>'),
    restore: svg('<path d="M3 12a9 9 0 1 0 3-6.7L3 8"/><path d="M3 3v5h5"/>'),
    trash: svg('<path d="M3 6h18M8 6V4h8v2M6 6l1 14h10l1-14"/>'),
    close: svg('<path d="M18 6 6 18M6 6l12 12"/>'),
    more: '<svg viewBox="0 0 24 24" fill="currentColor"><circle cx="5" cy="12" r="1.7"/><circle cx="12" cy="12" r="1.7"/><circle cx="19" cy="12" r="1.7"/></svg>',
    plus: svg('<path d="M12 5v14M5 12h14"/>'),
  };
  const TYPE_ICON = {
    text: svg('<path d="M4 7V5h16v2M9 19h6M12 5v14"/>'),
    long_text: svg('<path d="M4 6h16M4 10h16M4 14h16M4 18h10"/>'),
    number: svg('<path d="M4 9h16M4 15h16M10 3 8 21M16 3l-2 18"/>'),
    date: svg('<rect x="3" y="5" width="18" height="16" rx="2"/><path d="M16 3v4M8 3v4M3 10h18"/>'),
    choice: svg('<circle cx="5" cy="7" r="1.4"/><circle cx="5" cy="12" r="1.4"/><circle cx="5" cy="17" r="1.4"/><path d="M10 7h10M10 12h10M10 17h10"/>'),
    yes_no: svg('<rect x="2" y="7" width="20" height="10" rx="5"/><circle cx="16" cy="12" r="3"/>'),
  };

  // ---------- tabs ----------
  root.querySelectorAll('[data-as-tab]').forEach((t) => t.addEventListener('click', () => {
    const id = t.dataset.asTab;
    root.querySelectorAll('.as-tab[data-as-tab]').forEach((x) => x.classList.toggle('is-on', x.dataset.asTab === id));
    root.querySelectorAll('[data-as-panel]').forEach((p) => { p.hidden = p.dataset.asPanel !== id; });
    const url = new URL(location.href);
    url.searchParams.set('tab', id);
    history.replaceState(history.state, '', url);
  }));

  // The student fields need Admission Settings: without it, only the tabs are set up.
  if (!list) return;

  // ---------- list ----------
  const shown = (f) => filter === 'all' || (filter === 'student' ? f.onStudentForm : f.onApplication);
  function rowHtml(f) {
    const obsolete = f.status !== 'active';
    const where = !hasWebsite ? '' : (f.onStudentForm && f.onApplication ? 'Both' : f.onApplication ? 'Application' : 'Student');
    const w = f.width === 'full' || (f.width !== 'half' && f.type === 'long_text') ? 'Full' : 'Half';
    return `<div class="as-row ${obsolete ? 'is-obsolete' : ''}" data-field="${f.id}">
      <span class="as-grip" data-grip title="Drag to move" aria-hidden="true">${ICON.grip}</span>
      <div class="as-row__name"><b>${esc(f.label)}</b>${f.required ? '<i class="as-dot" title="Required"></i>' : ''}${obsolete ? '<span class="as-chip as-chip--warn">Obsolete</span>' : ''}</div>
      <div class="as-row__type">${TYPE_ICON[f.type] || TYPE_ICON.text}<span>${esc(TYPES[f.type] || 'Short text')}</span></div>
      <span class="as-row__where">${where}</span>
      <span class="as-chip">${w}</span>
      <div class="as-menuwrap">
        <button type="button" class="as-icon-btn" data-menu aria-haspopup="true" aria-expanded="false" aria-label="Actions for ${esc(f.label)}">${ICON.more}</button>
        <div class="as-menu" role="menu">
          <button type="button" role="menuitem" data-edit>${ICON.edit}Edit</button>
          ${obsolete
            ? `<button type="button" role="menuitem" data-status="active">${ICON.restore}Restore</button>`
            : `<button type="button" role="menuitem" data-status="obsolete">${ICON.archive}Obsolete</button>`}
          ${f.used ? '' : `<button type="button" role="menuitem" class="is-danger" data-delete>${ICON.trash}Delete</button>`}
        </div>
      </div>
    </div>`;
  }
  const folded = new Set();
  let foldedSet = false;
  function render() {
    const visible = fields.filter(shown);
    // With many fields only the first section starts open; a section opens with a click (and while dragging).
    if (!foldedSet && fields.length) {
      foldedSet = true;
      if (fields.length > 12) { let first = true; Object.keys(SECTIONS).forEach((k) => { if (fields.some((f) => secOf(f) === k)) { if (!first) folded.add(k); first = false; } }); }
    }
    if (!fields.length) {
      list.innerHTML = '<div class="as-empty"><strong>No fields yet</strong>'
        + (missingIndicators().length ? '<button type="button" class="as-btn" data-add-indicators style="margin-top:12px">Standard indicators</button>' : '') + '</div>';
      return;
    }
    list.innerHTML = Object.entries(SECTIONS).map(([key, name]) => {
      const rows = visible.filter((f) => secOf(f) === key);
      return `<div class="as-group${rows.length ? '' : ' is-empty'}${rows.length && folded.has(key) ? ' is-folded' : ''}" data-section="${key}">
        <div class="as-group__head"${rows.length ? ' data-fold role="button" tabindex="0" aria-expanded="' + (folded.has(key) ? 'false' : 'true') + '"' : ''}>${rows.length ? '<i class="as-group__chev" aria-hidden="true"></i>' : ''}<h3>${esc(name)}</h3><span>${rows.length || ''}</span>${key === 'programs' && missingIndicators().length ? `<button type="button" class="as-btn as-btn--small" data-add-indicators title="${esc(missingIndicators().join(', '))}">Indicators</button>` : ''}<button type="button" class="as-icon-btn" data-add-in="${key}" title="Add field" aria-label="Add field to ${esc(name)}">${ICON.plus}</button></div>
        <div class="as-group__list" data-group-list="${key}">${rows.map(rowHtml).join('') || '<div class="as-group__empty">Drop here</div>'}</div>
      </div>`;
    }).join('');
  }

  function foldClick(e) {
    const head = e.target.closest && e.target.closest('.as-group__head[data-fold]');
    if (!head || e.target.closest('button')) return;
    if (e.type === 'keydown' && e.key !== 'Enter' && e.key !== ' ') return;
    if (e.type === 'keydown') e.preventDefault();
    const key = head.closest('.as-group').dataset.section;
    if (folded.has(key)) folded.delete(key); else folded.add(key);
    render();
  }
  list.addEventListener('click', foldClick);
  list.addEventListener('keydown', foldClick);

  let toastTimer = null;
  function toast(text) {
    const t = document.getElementById('asToast');
    t.textContent = text;
    t.classList.add('is-on');
    clearTimeout(toastTimer);
    toastTimer = setTimeout(() => t.classList.remove('is-on'), 2200);
  }
  async function call(url, body) {
    const res = await fetch(url, { method: 'POST', credentials: 'same-origin', headers: { 'Content-Type': 'application/json', Accept: 'application/json' }, body: JSON.stringify(body || {}) });
    const out = await res.json().catch(() => ({}));
    if (!res.ok || !out.success) throw new Error(out.error || 'Something went wrong. Try again.');
    fields = out.fields;
    return out;
  }

  root.querySelectorAll('[data-as-filter]').forEach((b) => b.addEventListener('click', () => {
    filter = b.dataset.asFilter;
    root.querySelectorAll('[data-as-filter]').forEach((x) => x.classList.toggle('is-on', x === b));
    render();
  }));

  // ---------- field dialog ----------
  let submitFn = null;
  function closeDialog() { dialog.classList.remove('is-open'); submitFn = null; }
  function placeDialog() { const h = document.getElementById('top-header'); dialog.style.top = (h ? h.offsetHeight : 0) + 'px'; }
  function fieldDialog(f, presetSection) {
    const locked = f && f.used > 0;
    let type = f ? f.type : 'text';
    let width = f && f.width ? f.width : (f && f.type === 'long_text' ? 'full' : 'half');
    let widthPicked = !!(f && f.width);
    const onStudent = f ? f.onStudentForm : filter !== 'application';
    const onApp = f ? f.onApplication : (hasWebsite && filter !== 'student');
    dlg.innerHTML = `<form novalidate>
      <div class="as-dlg__head"><h2 id="asDialogTitle">${f ? 'Edit field' : 'New field'}</h2><button type="button" class="as-icon-btn" data-close aria-label="Close">${ICON.close}</button></div>
      <div class="as-dlg__body">
        <label class="as-field">Field name<input name="label" maxlength="80" value="${esc(f ? f.label : '')}" placeholder="e.g. Previous school" autocomplete="off"></label>
        <div class="as-field">Type
          <div class="as-types">${Object.entries(TYPES).map(([k, v]) => `<button type="button" data-type="${k}" class="${k === type ? 'is-on' : ''}" ${locked ? 'disabled' : ''}>${TYPE_ICON[k]}${esc(v)}</button>`).join('')}</div>
        </div>
        <label class="as-field" data-options ${type === 'choice' ? '' : 'hidden'}><span>Choices</span><textarea name="options" rows="4" placeholder="One per line">${esc(f ? f.options.join('\n') : '')}</textarea></label>
        <label class="as-field">Show under
          <select name="section">${Object.entries(SECTIONS).map(([k, v]) => `<option value="${k}" ${k === (f ? secOf(f) : (presetSection || 'more')) ? 'selected' : ''}>${esc(v)}</option>`).join('')}</select>
        </label>
        <div class="as-field">Ask on
          <div class="as-checks">
            <label class="as-check"><input type="checkbox" name="onStudentForm" ${onStudent ? 'checked' : ''}><span>Add Student</span></label>
            ${hasWebsite ? `<label class="as-check"><input type="checkbox" name="onApplication" ${onApp ? 'checked' : ''}><span>Online application</span></label>` : ''}
          </div>
        </div>
        <div class="as-two">
          <div class="as-field">Width
            <div class="as-seg" role="group" aria-label="Width"><button type="button" data-width="half" class="${width === 'half' ? 'is-on' : ''}">Half</button><button type="button" data-width="full" class="${width === 'full' ? 'is-on' : ''}">Full</button></div>
          </div>
          <div class="as-field">Required
            <label class="as-check"><input type="checkbox" name="required" ${f && f.required ? 'checked' : ''}><span>Yes</span></label>
          </div>
        </div>
        <label class="as-field">Help<input name="helpText" maxlength="200" value="${esc(f ? f.helpText : '')}" placeholder="Help text (shows as ?)" autocomplete="off"></label>
      </div>
      <div class="as-dlg__foot"><p class="as-error" data-error role="alert"></p><div><button type="button" class="as-btn" data-close>Cancel</button><button type="submit" class="as-btn as-btn--primary">${f ? 'Save' : 'Add field'}</button></div></div>
    </form>`;
    placeDialog();
    dialog.classList.add('is-open');
    dlg.querySelector('[name="label"]').focus();
    dlg.querySelectorAll('[data-type]').forEach((b) => b.addEventListener('click', () => {
      type = b.dataset.type;
      dlg.querySelectorAll('[data-type]').forEach((x) => x.classList.toggle('is-on', x === b));
      dlg.querySelector('[data-options]').hidden = type !== 'choice';
    }));
    dlg.querySelectorAll('[data-width]').forEach((b) => b.addEventListener('click', () => {
      width = b.dataset.width; widthPicked = true;
      dlg.querySelectorAll('[data-width]').forEach((x) => x.classList.toggle('is-on', x === b));
    }));
    submitFn = async (form) => {
      const app = form.querySelector('[name="onApplication"]');
      await call(f ? `/common/admissionSettings/fields/${f.id}` : '/common/admissionSettings/fields', {
        label: form.label.value, type, options: form.options.value, helpText: form.helpText.value, width: widthPicked ? width : '',
        required: form.required.checked, onStudentForm: form.onStudentForm.checked, section: form.section.value,
        onApplication: app ? app.checked : (f ? f.onApplication : false),
      });
      toast(f ? 'Field saved' : 'Field added');
    };
  }
  dialog.addEventListener('click', (e) => { if (e.target.closest('[data-close]')) closeDialog(); });
  document.addEventListener('keydown', (e) => { if (e.key !== 'Escape') return; if (dialog.classList.contains('is-open')) closeDialog(); else if (typeof closeMenus === 'function') closeMenus(); });
  dialog.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!submitFn) return;
    const form = e.target;
    const btn = form.querySelector('[type="submit"]');
    btn.disabled = true;
    try {
      await submitFn(form);
      closeDialog();
      render();
    } catch (err) {
      form.querySelector('[data-error]').textContent = err.message;
      btn.disabled = false;
    }
  });

  root.querySelector('[data-as-add]').addEventListener('click', () => fieldDialog(null));
  const closeMenus = () => list.querySelectorAll('.as-menu.is-open').forEach((m) => { m.classList.remove('is-open'); const t = m.parentNode.querySelector('[data-menu]'); if (t) t.setAttribute('aria-expanded', 'false'); });
  document.addEventListener('click', (e) => { if (!e.target.closest('.as-menuwrap')) closeMenus(); });
  list.addEventListener('click', async (e) => {
    const mb = e.target.closest('[data-menu]');
    if (mb) {
      const menu = mb.parentNode.querySelector('.as-menu');
      const was = menu.classList.contains('is-open');
      closeMenus();
      if (!was) { menu.classList.add('is-open'); mb.setAttribute('aria-expanded', 'true'); const first = menu.querySelector('button'); if (first) first.focus(); }
      return;
    }
    closeMenus();
    const addIn = e.target.closest('[data-add-in]');
    if (addIn) return fieldDialog(null, addIn.dataset.addIn);
    if (e.target.closest('[data-add-indicators]')) {
      try {
        const before = fields.length;
        await call('/common/admissionSettings/fields/indicators');
        render();
        toast(`${fields.length - before} indicators added`);
      } catch (err) { toast(err.message); }
      return;
    }
    const row = e.target.closest('[data-field]');
    const f = row && fields.find((x) => x.id === Number(row.dataset.field));
    if (!f) return;
    try {
      if (e.target.closest('[data-edit]')) return fieldDialog(f);
      const status = e.target.closest('[data-status]');
      if (status) {
        await call(`/common/admissionSettings/fields/${f.id}/status`, { status: status.dataset.status });
        toast(status.dataset.status === 'active' ? 'Field restored' : 'Field is now obsolete');
        return render();
      }
      if (e.target.closest('[data-delete]')) {
        if (!await window.appConfirm(`Delete "${f.label}"? No one has answered it yet.`)) return;
        await call(`/common/admissionSettings/fields/${f.id}/delete`);
        toast('Field deleted');
        return render();
      }
    } catch (err) {
      toast(err.message);
      render();
    }
  });

  // ---------- drag to reorder (mouse and touch) ----------
  list.addEventListener('pointerdown', (e) => {
    const grip = e.target.closest('[data-grip]');
    if (!grip || e.button > 0) return;
    e.preventDefault();
    const item = grip.closest('[data-field]');
    const rect = item.getBoundingClientRect();
    const offsetY = e.clientY - rect.top;
    const order = () => [...list.querySelectorAll('[data-field]')].map((el) => Number(el.dataset.field));
    const sectionMap = () => { const m = {}; list.querySelectorAll('[data-group-list]').forEach((g) => g.querySelectorAll('[data-field]').forEach((el) => { m[el.dataset.field] = g.dataset.groupList; })); return m; };
    const before = order().join(',') + JSON.stringify(sectionMap());
    const ghost = item.cloneNode(true);
    ghost.classList.add('as-ghost');
    Object.assign(ghost.style, { left: rect.left + 'px', top: rect.top + 'px', width: rect.width + 'px' });
    document.body.appendChild(ghost);
    item.classList.add('as-placeholder');
    document.documentElement.classList.add('as-dragging');
    const middle = (el) => { const r = el.getBoundingClientRect(); return r.top + r.height / 2; };
    function move(ev) {
      ghost.style.top = (ev.clientY - offsetY) + 'px';
      const groups = [...list.querySelectorAll('[data-group-list]')];
      const target = groups.find((g) => { const r = g.closest('.as-group').getBoundingClientRect(); return ev.clientY >= r.top && ev.clientY <= r.bottom; })
        || (ev.clientY < groups[0].getBoundingClientRect().top ? groups[0] : groups[groups.length - 1]);
      const rows = [...target.querySelectorAll('[data-field]')].filter((r) => r !== item);
      const next = rows.find((r) => ev.clientY < middle(r)) || null;
      if (item.parentNode !== target || item.nextSibling !== next) target.insertBefore(item, next);
      groups.forEach((g) => { const e2 = g.querySelector('.as-group__empty'); if (e2) e2.hidden = g.querySelectorAll('[data-field]').length > 0; });
      if (ev.clientY < 60) window.scrollBy(0, -14);
      else if (ev.clientY > window.innerHeight - 60) window.scrollBy(0, 14);
    }
    async function end() {
      window.removeEventListener('pointermove', move);
      window.removeEventListener('pointerup', end);
      window.removeEventListener('pointercancel', end);
      ghost.remove();
      item.classList.remove('as-placeholder');
      document.documentElement.classList.remove('as-dragging');
      const now = order();
      const sections = sectionMap();
      if (now.join(',') + JSON.stringify(sections) === before) return;
      // With a filter on, keep hidden fields where they were.
      const visible = new Set(now);
      const full = fields.map((f) => f.id);
      let i = 0;
      const ids = full.map((id) => (visible.has(id) ? now[i++] : id));
      try {
        await call('/common/admissionSettings/fields/order', { ids, sections });
        toast('Order saved');
      } catch (err) {
        toast(err.message);
      }
      render();
    }
    window.addEventListener('pointermove', move);
    window.addEventListener('pointerup', end);
    window.addEventListener('pointercancel', end);
  });

  render();
})();
</script>
