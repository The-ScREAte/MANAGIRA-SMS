        function toggleEditSaveMode(date) {
            const checkboxes = document.querySelectorAll(`input[data-date='${date}']`);
            const link = document.querySelector(`.edit-save-link[data-date='${date}']`);
            const cancelLink = document.querySelector(`.cancel-link[data-date='${date}']`);
            const markAllLink = document.querySelector(`.mark-all-link[data-date='${date}']`);

            if (link.textContent === 'Save') {
                saveAttendanceForDate(date, checkboxes, link);
            } else if (link.textContent === 'Edit') {
                saveOriginalStates(date, checkboxes);
                checkboxes.forEach(checkbox => {
                    checkbox.disabled = false;
                });
                link.textContent = 'Save';
                cancelLink.style.display = 'block';
                if (markAllLink) markAllLink.style.display = 'block';
            }
        }

        function checkAllClick(ev, date) {
            const lunchBtn = ev.target.closest && ev.target.closest('.check-all-lunch');
            if (lunchBtn) { if (window.lunchAllForDate) window.lunchAllForDate(date); return; }
            const box = ev.currentTarget.querySelector('.check-all-box');
            if (ev.target !== box) box.checked = !box.checked;
            markAllPresentForDate(date, box.checked);
        }

        function markAllPresentForDate(date, on) {
            const checkboxes = document.querySelectorAll(`input[data-date='${date}']`);
            checkboxes.forEach(checkbox => {
                if (checkbox.dataset.countable === 'true' && !checkbox.disabled) {
                    checkbox.checked = on !== false;
                }
            });
            setTimeout(updateAttendanceSummary, 10);
        }

        function saveAttendanceForDate(date, checkboxes, link) {
            if (window.saveLunchForDate) window.saveLunchForDate(date);
            const attendanceData = {};
            const classId = '<%= classId %>';
            const termId = '<%= termId %>';

            checkboxes.forEach(checkbox => {
                attendanceData[checkbox.dataset.studentId] = checkbox.checked ? 'Present' : 'Absent';
            });
            const notesData = window.attNotesFor ? window.attNotesFor(date, attendanceData) : undefined;

            fetch('/common/saveSingleAttendance', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'Accept': 'application/json',
                },
                body: JSON.stringify({ attendance: attendanceData, classId, termId, date, notes: notesData, lates: window.attLatesFor ? window.attLatesFor(date, attendanceData) : undefined })
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    if (window.attToast) window.attToast('Saved'); 
                    link.textContent = 'Edit';
                    checkboxes.forEach(checkbox => {
                        checkbox.disabled = true;
                    });
                    const cancelLink = document.querySelector(`.cancel-link[data-date='${date}']`);
                    cancelLink.style.display = 'none';
                    const markAllLink = document.querySelector(`.mark-all-link[data-date='${date}']`);
                    if (markAllLink) markAllLink.style.display = 'none';

                    const lastEditedElement = document.getElementById(`last-edited-${date}`);
                    if (lastEditedElement) {
                        renderLastEdited(lastEditedElement, new Date());
                    }

                    // Update attendance summary after saving
                    setTimeout(updateAttendanceSummary, 50);
                    // Families are told after the teacher is done: ask, for today's day, when someone is absent or late.
                    if (window.attAskDone) window.attAskDone(date, data.attendanceSend);
                } else {
                    console.error('Failed to save attendance:', data.error);
                    alert(data.message || data.error || 'Failed to save attendance. Please try again.');
                }
            })
            .catch(error => {
                console.error('Error saving attendance:', error);
                alert('Failed to save attendance. Please try again.');
            });
        }

        // A quiet note instead of a blocking pop-up.
        window.attToast = function (text) {
            var t = document.createElement('div');
            t.textContent = text; t.setAttribute('role', 'status');
            t.style.cssText = 'position:fixed;left:50%;bottom:28px;transform:translateX(-50%);background:#0f766e;color:#fff;padding:10px 20px;border-radius:999px;font:700 14px/1 inherit;box-shadow:0 6px 20px rgba(0,0,0,.2);z-index:99999;';
            document.body.appendChild(t);
            setTimeout(function () { t.remove(); }, 1600);
        };
        // "Done taking attendance for today?" Families are told about a day's absences after the teacher is done
        // (30 minutes after "Yes"; 2 hours after the last save if nobody answers). "Not yet" asks once more after
        // 30 minutes with the page open, unless the day is saved again (that save asks afresh) or answered.
        (function () {
            var CLASS = '<%= classId %>', timers = {}, answered = {}, overlay = null, openFor = null;
            function todayKey() { var col = document.querySelector('th.today-col[data-date]'); if (col) return col.getAttribute('data-date'); var n = new Date(), p = function (v) { return String(v).padStart(2, '0'); }; return n.getFullYear() + '-' + p(n.getMonth() + 1) + '-' + p(n.getDate()); }
            function ensure() {
                if (overlay) return overlay;
                var st = document.createElement('style');
                st.textContent = '.att-done{position:fixed;inset:0;z-index:13000;display:flex;align-items:center;justify-content:center;padding:16px;background:rgba(15,23,42,.38);backdrop-filter:blur(3px);-webkit-backdrop-filter:blur(3px);opacity:0;transition:opacity .18s ease}'
                    + '.att-done.is-in{opacity:1}.att-done[hidden]{display:none}'
                    + '.att-done-card{width:min(100%,380px);padding:26px 24px 20px;border-radius:20px;background:#fff;color:#0f172a;text-align:center;box-shadow:0 24px 60px rgba(15,23,42,.22),0 2px 6px rgba(15,23,42,.06);transform:translateY(8px) scale(.97);transition:transform .24s cubic-bezier(.2,.8,.2,1)}'
                    + '.att-done.is-in .att-done-card{transform:none}'
                    + '.att-done-card h2{margin:0 0 6px;font-size:1.15rem;font-weight:700;line-height:1.3;color:#0f172a}'
                    + '.att-done-card p{margin:0 0 20px;color:#475569;font-size:.92rem;line-height:1.5}'
                    + '.att-done-actions{display:flex;gap:10px}'
                    + '.att-done .att-done-btn{flex:1;height:44px;margin:0;padding:0 14px;border-radius:12px;font:inherit;font-size:.95rem;font-weight:700;cursor:pointer;box-shadow:none;text-transform:none;letter-spacing:normal}'
                    + '.att-done .att-done-btn.no{border:1px solid #d1d5db;background:#fff;color:#1f2937}.att-done .att-done-btn.no:hover{background:#f9fafb}'
                    + '.att-done .att-done-btn.yes{border:0;background:#0f766e;color:#fff}.att-done .att-done-btn.yes:hover{filter:brightness(.94)}'
                    + '.att-done .att-done-btn[disabled]{opacity:.75;cursor:wait}'
                    + '.att-done .att-done-btn:focus-visible{outline:2px solid rgba(15,118,110,.4);outline-offset:3px}'
                    + 'html[data-appearance="dark"] .att-done-card{background:#111827;color:#f9fafb}html[data-appearance="dark"] .att-done-card h2{color:#f9fafb}html[data-appearance="dark"] .att-done-card p{color:#cbd5e1}'
                    + 'html[data-appearance="dark"] .att-done .att-done-btn.no{background:#111827;border-color:#374151;color:#e5e7eb}'
                    + '@media (prefers-reduced-motion:reduce){.att-done,.att-done-card{transition:none}}';
                document.head.appendChild(st);
                overlay = document.createElement('div');
                overlay.className = 'att-done'; overlay.hidden = true;
                overlay.setAttribute('role', 'alertdialog'); overlay.setAttribute('aria-modal', 'true');
                overlay.setAttribute('aria-labelledby', 'attDoneTitle'); overlay.setAttribute('aria-describedby', 'attDoneText');
                overlay.innerHTML = '<div class="att-done-card"><h2 id="attDoneTitle">Done taking attendance for today?</h2>'
                    + '<p id="attDoneText">Families are told about absences 30 minutes after you finish.</p>'
                    + '<div class="att-done-actions"><button type="button" class="att-done-btn no" data-no>Not yet</button><button type="button" class="att-done-btn yes" data-yes>Yes, I’m done</button></div></div>';
                overlay.addEventListener('click', function (e) {
                    if (e.target.closest('[data-no]')) notYet();
                    else if (e.target.closest('[data-yes]')) yes();
                });
                overlay.addEventListener('keydown', function (e) {
                    if (e.key === 'Escape') { e.preventDefault(); notYet(); return; }
                    if (e.key === 'Tab') { var b = overlay.querySelectorAll('button'); if (e.shiftKey && document.activeElement === b[0]) { e.preventDefault(); b[b.length - 1].focus(); } else if (!e.shiftKey && document.activeElement === b[b.length - 1]) { e.preventDefault(); b[0].focus(); } }
                });
                document.body.appendChild(overlay);
                return overlay;
            }
            function close() { if (!overlay || overlay.hidden) return; overlay.classList.remove('is-in'); var o = overlay; setTimeout(function () { o.hidden = true; }, 180); }
            function show(date, again) {
                var o = ensure(); openFor = { date: date, again: again };
                o.querySelector('[data-yes]').disabled = false;
                o.hidden = false; requestAnimationFrame(function () { o.classList.add('is-in'); });
                o.querySelector('[data-yes]').focus();
            }
            function notYet() {
                if (!openFor) return; var cur = openFor; openFor = null; close();
                if (cur.again) return; // asked twice: the 2-hour wait takes over
                clearTimeout(timers[cur.date]);
                timers[cur.date] = setTimeout(function () { if (!answered[cur.date]) show(cur.date, true); }, window.attReaskMs || 30 * 60 * 1000);
            }
            function yes() {
                if (!openFor) return; var cur = openFor, btn = overlay.querySelector('[data-yes]'); btn.disabled = true;
                fetch('/common/confirmAttendanceDone', { method: 'POST', headers: { 'Content-Type': 'application/json', Accept: 'application/json' }, body: JSON.stringify({ classId: CLASS, date: cur.date }) })
                    .then(function (r) { return r.json(); }).then(function (d) {
                        if (!d.success) throw new Error(d.message || 'Not saved');
                        answered[cur.date] = true; clearTimeout(timers[cur.date]); openFor = null; close();
                        if (window.attToast) window.attToast('Thank you. Noted.');
                    }).catch(function () { btn.disabled = false; if (window.attToast) window.attToast('Not saved. Try again.'); });
            }
            // Called after a day is saved, with the server's answer (ask: true when someone is absent or late and families would be told).
            window.attAskDone = function (date, info) {
                clearTimeout(timers[date]); delete answered[date];
                if (!info || !info.ask || date !== todayKey()) return;
                show(date, false);
            };
        })();
        // A day nobody has marked yet is open: the first tap on a box starts editing it, so Save is there at once.
        (function () {
            var sheet = document.querySelector('.attendance-sheet'); if (!sheet) return;
            function begin(e) {
                var box = e.target.closest && e.target.closest('input[type="checkbox"][data-date]');
                if (!box || box.disabled) return;
                var link = document.querySelector('.edit-save-link[data-date="' + box.dataset.date + '"]');
                if (link && link.textContent.trim() === 'Edit') toggleEditSaveMode(box.dataset.date);
            }
            sheet.addEventListener('pointerdown', begin, true);
            sheet.addEventListener('keydown', function (e) { if (e.key === ' ') begin(e); }, true);
        })();

        function saveOriginalStates(date, checkboxes) {
            originalStates[date] = {};
            checkboxes.forEach(checkbox => {
                originalStates[date][checkbox.dataset.studentId] = checkbox.checked;
            });
        }

        function restoreOriginalStates(date, checkboxes) {
            checkboxes.forEach(checkbox => {
                checkbox.checked = originalStates[date][checkbox.dataset.studentId];
                checkbox.disabled = true;
            });
        }

        function cancelEditMode(date) {
            const checkboxes = document.querySelectorAll(`input[data-date='${date}']`);
            restoreOriginalStates(date, checkboxes);
            const link = document.querySelector(`.edit-save-link[data-date='${date}']`);
            link.textContent = 'Edit';
            const cancelLink = document.querySelector(`.cancel-link[data-date='${date}']`);
            cancelLink.style.display = 'none';
            const markAllLink = document.querySelector(`.mark-all-link[data-date='${date}']`);
            if (markAllLink) markAllLink.style.display = 'none';
        }


            var originalRows = window.__attendanceOriginalRows || [];
            window.__attendanceOriginalRows = originalRows;
            
            document.addEventListener('DOMContentLoaded', () => {
                const tbody = document.querySelector('.attendance-sheet tbody');
                originalRows.length = 0;
                originalRows.push(...tbody.querySelectorAll('tr'));
                initAttendanceRange();
                applyDateColumns();
            });

            // Shows only the chosen days, keeping the rows in their order.
            function applyDateColumns() {
                const selected = document.getElementById('dateFilter').value;
                const visibleDates = datesForRange(selected);
                const singleDay = selected.indexOf('date:') === 0;
                document.querySelectorAll('.attendance-sheet [data-date]').forEach(function (el) {
                    const cell = el.tagName === 'TH' ? el : el.closest('td');
                    if (cell && (el.tagName === 'TH' || el.tagName === 'INPUT')) cell.style.display = visibleDates.has(el.dataset.date) ? '' : 'none';
                });
                document.querySelectorAll('.attendance-sheet .overall-attendance').forEach(function (el) { el.style.display = singleDay ? 'none' : ''; });
                showMissedNote();
                setTimeout(updateAttendanceSummary, 50);
                updateFilterState();
            }

            function syncAttendanceSortToggle() {
                const sortInput = document.getElementById('nameSort');
                const toggles = [document.getElementById('nameSortToggle'), document.getElementById('attendanceHeaderSortToggle')].filter(Boolean);
                if (!sortInput || !toggles.length) return;
                const direction = sortInput.value === 'desc' ? 'desc' : 'asc';
                toggles.forEach(function(toggle) {
                    toggle.setAttribute('data-sort-direction', direction);
                    toggle.setAttribute('aria-label', direction === 'asc' ? 'Sort names Z to A' : 'Sort names A to Z');
                });
            }
            
            function applyFilters() {
                const sort = document.getElementById('nameSort').value;
                const gender = document.getElementById('genderFilter').value.toLowerCase();
                const selectedDate = document.getElementById('dateFilter').value;
                const visibleDates = datesForRange(selectedDate);
                const singleDay = selectedDate.indexOf('date:') === 0;
                
                const tbody = document.querySelector('.attendance-sheet tbody');
                tbody.innerHTML = '';
            
                // Sort by gender THEN name
                const filtered = [...originalRows]
                    .filter(row => {
                        const rowGender = row.dataset.gender.toLowerCase();
                        return gender === 'all' || rowGender === gender;
                    })
                    .sort((a, b) => {
                        const genderA = a.dataset.gender;
                        const genderB = b.dataset.gender;
