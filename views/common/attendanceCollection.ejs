    <script nonce="<%= locals.cspNonce || '' %>">
    // Days that aren't school days (the weekend, holidays, days off the school added) sit in one slim strip between the
    // school days, named on its side ("WEEKEND", "THANKSGIVING"). Click it and the days open as any other day, in slim
    // columns; "Collapse" folds them again. A day filtered to on its own is shown open.
    (function () {
        var sheet = document.querySelector('.attendance-sheet');
        if (!sheet || /^date:/.test(window.ATT_RENDERED_RANGE || '')) return;
        var off = window.ATT_OFF || {};
        var today = (document.getElementById('filterControlsContent') || { dataset: {} }).dataset.today;
        var heads = Array.prototype.slice.call(sheet.querySelectorAll('thead th[data-date]'));
        var groups = [], run = null;
        heads.forEach(function (th) {
            if (off[th.dataset.date]) { if (!run) { run = []; groups.push(run); } run.push(th.dataset.date); } else run = null;
        });
        function labelOf(dates) {
            var names = [];
            dates.forEach(function (d) { var l = off[d] && off[d].l; if (l && names.indexOf(l) < 0) names.push(l); });
            var named = names.filter(function (n) { return n !== 'Weekend'; });
            if (!named.length) return 'Weekend';
            var word = named[0].split(/\s+/)[0];
            return word.length > 12 ? word.slice(0, 11) + '…' : word;
        }
        var countable = {};
        function cellsOf(date) {
            var th = sheet.querySelector('thead th[data-date="' + date + '"]');
            var tds = Array.prototype.slice.call(sheet.querySelectorAll('tbody input[data-date="' + date + '"]')).map(function (i) { return i.closest('td'); });
            return [th].concat(tds).filter(Boolean);
        }
        function paint(group, folded) {
            group.dates.forEach(function (date, i) {
                cellsOf(date).forEach(function (cell) {
                    cell.classList.toggle('wk-first', i === 0);
                    cell.classList.toggle('wk-last', i === group.dates.length - 1);
                    cell.classList.toggle('wk-hide', folded && i > 0);
                    cell.classList.toggle('wk-strip', folded && i === 0);
                    cell.classList.toggle('wk-slim', !folded && countable[date] !== false);
                    cell.classList.toggle('wk-slimmer', !folded && countable[date] === false);
                    cell.dataset.wk = group.id;
                    if (cell.tagName === 'TH') {
                        cell.classList.toggle('wk-today', folded && i === 0 && group.dates.indexOf(today) >= 0);
                        cell.dataset.wkLabel = group.label;
                        cell.title = folded ? group.title : '';
                        var tag = cell.querySelector('.wk-tag');
                        if (!folded && off[date] && off[date].k !== 'weekend') { if (!tag) { tag = document.createElement('span'); tag.className = 'wk-tag'; cell.appendChild(tag); } tag.textContent = off[date].l; tag.title = off[date].l; }
                        else if (tag) tag.remove();
                    }
                });
            });
            var first = sheet.querySelector('thead th[data-date="' + group.dates[0] + '"]');
            var fold = first && first.querySelector('.wk-fold');
            if (folded && fold) fold.remove();
            if (!folded && first && !fold) {
                var b = document.createElement('button');
                b.type = 'button'; b.className = 'wk-fold'; b.title = 'Collapse these days'; b.setAttribute('aria-label', 'Collapse these days off'); b.innerHTML = '<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 6-6 6 6 6"/></svg>';
                b.addEventListener('click', function (e) { e.stopPropagation(); paint(group, true); });
                first.insertBefore(b, first.firstChild);
            }
            group.folded = folded;
        }
        groups.forEach(function (dates) { dates.forEach(function (d) { var box = sheet.querySelector('tbody input[data-date="' + d + '"]'); countable[d] = box ? box.dataset.countable !== 'false' : true; }); });
        groups.forEach(function (dates, n) {
            var names = []; dates.forEach(function (d) { var l = off[d] && off[d].l; if (l && names.indexOf(l) < 0) names.push(l); });
            var g = { id: 'wk' + n, dates: dates, folded: true, label: labelOf(dates), title: names.join(' · ') + (dates.length > 1 ? ' (' + dates.length + ' days)' : '') };
            paint(g, true);
            dates.forEach(function (d) { cellsOf(d).forEach(function (c) { c.__wk = g; }); });
        });
        sheet.addEventListener('click', function (e) {
            var cell = e.target.closest && e.target.closest('.wk-strip');
            if (cell && cell.__wk) paint(cell.__wk, false);
        });
        sheet.addEventListener('keydown', function (e) { if ((e.key === 'Enter' || e.key === ' ') && e.target.classList && e.target.classList.contains('wk-strip') && e.target.__wk) { e.preventDefault(); paint(e.target.__wk, false); } });
        sheet.querySelectorAll('th.wk-strip').forEach(function (th) { th.tabIndex = 0; th.setAttribute('role', 'button'); th.setAttribute('aria-label', th.title + ', closed. Open these days'); });
    })();
    </script>
