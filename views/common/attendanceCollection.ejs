<style>
      :root {
        --font-family: "<%= (session && session.fontStyle ? String(session.fontStyle).trim() : 'Inter') %>", sans-serif;
                --primary: var(--org-primary-color, #01535b);
                --primary-hover: var(--org-primary-hover, #014a51);
        --primary-hover-fill: color-mix(in srgb, var(--primary) 88%, white);
                --border: #e5e7eb;
                --bg: #f8fafc;
      }


    body {
        font-family: var(--font-family);
                background: var(--bg);
                min-height: 100vh;
                display: flex;
                flex-direction: column;
      }

        main {
            flex: 1 0 auto;
            width: 100%;
        }
 
        .attendance-page {
            max-width: <%= isEmbedded ? 'none' : '1200px' %>;
            margin: 0 auto;
            padding: <%= isEmbedded ? '0 0 18px' : '16px 16px 40px' %>;
            width: 100%;
            box-sizing: border-box;
        }

        .attendance-summary-line {
            margin: 4px 0 0;
            color: #475569;
            font-size: <%= isEmbedded ? '0.8rem' : '0.9rem' %>;
            line-height: 1.45;
        }

        .attendance-meta {
            margin-top: <%= isEmbedded ? '4px' : '6px' %>;
            color: #475569;
            font-size: <%= isEmbedded ? '0.82rem' : '0.95rem' %>;
        }

        .attendance-meta-inline {
            display: flex;
            flex-wrap: wrap;
            justify-content: flex-start;
            gap: 5px 8px;
            margin-top: 5px;
        }

        .attendance-meta-inline.compact {
            gap: 4px 8px;
            margin-top: 4px;
            color: #475569;
            font-size: 0.78rem;
            font-weight: 500;
        }

        .attendance-meta-inline.compact .attendance-meta-text {
            white-space: nowrap;
        }

        .attendance-meta-pill {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 4px 9px;
            border-radius: 999px;
            background: #f8fafc;
            border: 1px solid #e2e8f0;
            color: #334155;
            font-size: <%= isEmbedded ? '0.75rem' : '0.82rem' %>;
            font-weight: 600;
        }

        .attendance-calendar-meta {
            display: flex;
            flex-wrap: wrap;
            justify-content: flex-start;
            gap: 5px 8px;
            margin-top: 6px;
        }

        .attendance-calendar-note {
            margin-top: 6px;
            color: #334155;
            font-size: <%= isEmbedded ? '0.74rem' : '0.88rem' %>;
        }

        .attendance-calendar-note.compact {
            margin-top: 4px;
            font-size: 0.76rem;
            color: #475569;
        }

        .calendar-rules-toggle {
            display: none;
        }

        .sort-toggle-btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 16px;
            height: 16px;
            padding: 0;
            border: none;
            background: transparent;
            color: var(--primary);
            cursor: pointer;
            opacity: 0.78;
        }

        .sort-toggle-btn:focus, .sort-toggle-btn:active, .sort-toggle-btn:focus-visible {
            background: transparent !important;
            box-shadow: none !important;
            outline: none;
            color: var(--primary);
        }

        .sort-toggle-btn svg {
            width: 10px;
            height: 10px;
        }

        .cal-pill-popover {
            display: none;
            position: absolute;
            top: calc(100% + 6px);
            left: 0;
            min-width: 160px;
            max-width: 240px;
            background: #fff;
            border: 1px solid var(--border);
            border-radius: 10px;
            box-shadow: 0 8px 24px rgba(15,23,42,0.13);
            padding: 10px 13px;
            z-index: 200;
        }

        .cal-pill-popover.open {
            display: block;
        }

        .cal-popover-label {
            margin: 0 0 3px;
            font-size: 0.68rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            color: #94a3b8;
        }

        .cal-popover-value {
            margin: 0;
            font-size: 0.82rem;
            color: #0f172a;
            font-weight: 500;
            line-height: 1.4;
        }

        .attendance-summary-toggle {
            display: none;
            margin: 12px auto 0;
            background: #e5f5f7;
            color: var(--primary);
            border: 1px solid #b7e1e8;
            border-radius: 8px;
            padding: 6px 10px;
            font-size: 0.82rem;
            font-weight: 600;
            cursor: pointer;
        }

        .attendance-summary-wrapper {
            display: block;
        }
      
</style>
<style>
    /* === Date Header & Action Links === */
    .attendance-sheet thead th {
        font-size: 0.68rem;
        padding: 4px 6px;
        line-height: 1.15;
    }
    .date-header {
        display: flex;
        flex-direction: column;
        align-items: center;
        font-size: 0.65rem;
        line-height: 1.2;
        gap: 1px;
    }
    .day-name {
        font-size: 0.62rem;
        font-weight: 700;
        color: var(--primary);
        text-transform: uppercase;
        letter-spacing: 0.02em;
        margin-bottom: 1px;
    }
    .day-name .day-full { display: inline; }
    .day-name .day-short { display: none; }
    .edit-save-link,
    .cancel-link,
    .mark-all-link {
        font-size: 0.62rem;
        cursor: pointer;
        text-decoration: underline;
        margin-top: 2px;
        color: var(--primary);
    }
    .cancel-link {
        color: red;
    }
    .mark-all-link {
        color: #0f5a66;
    }
    .last-edited {
        font-size: 0.56rem;
        color: gray;
        line-height: 1.1;
        margin-top: 2px;
        display: inline-flex;
        align-items: center;
        white-space: nowrap;
        max-width: none;
        min-height: 0;
        position: relative;
    }

    .last-edited.has-tooltip {
        cursor: pointer;
    }

    .last-edited-icon {
        display: inline-block;
        width: 10px;
        height: 10px;
        vertical-align: -1px;
        margin-right: 3px;
        color: #94a3b8;
    }

    .last-edited-text {
        display: inline;
    }

    .last-edited-hover-date {
        display: none;
        position: absolute;
        left: auto;
        right: 0;
        bottom: calc(100% + 5px);
        transform: none;
        background: #0f172a;
        color: #fff;
        padding: 4px 6px;
        border-radius: 6px;
        font-size: 0.58rem;
        line-height: 1.2;
        white-space: normal;
        max-width: 130px;
        text-align: left;
        z-index: 30;
        box-shadow: 0 6px 18px rgba(15, 23, 42, 0.22);
        pointer-events: none;
    }

    .last-edited.has-tooltip:hover .last-edited-hover-date,
    .last-edited.has-tooltip.is-open .last-edited-hover-date {
        display: inline-block;
    }

    /* === Today Column Highlight === */
    .today-col {
        background-color: #e8f7f8 !important;
        border-left: 2px solid var(--primary) !important;
        border-right: 2px solid var(--primary) !important;
    }
    .attendance-sheet thead .today-col {
        background-color: #d0eff2 !important;
    }
    
    /* === Overall Attendance Style === */
    .overall-attendance {
        font-weight: bold;
    }
    
    /* === Center Back Link === */
    .center-link {
        display: flex;
        justify-content: center;
        margin-bottom: 20px;
    }

    .link-to-next-back {
        padding-top: 10px;
    }
    
    /* === Attendance Table === */
    .attendance-sheet-container {
        padding: <%= isEmbedded ? '0' : '16px 0' %>;
        margin: <%= isEmbedded ? '6px 0 0' : '30px auto' %>;
        background: <%= isEmbedded ? 'transparent' : '#fff' %>;
        border: <%= isEmbedded ? 'none' : '1px solid var(--border)' %>;
        border-radius: <%= isEmbedded ? '0' : '12px' %>;
        box-shadow: <%= isEmbedded ? 'none' : '0 4px 14px rgba(15, 23, 42, 0.04)' %>;
        max-width: 100%;
        overflow-x: auto;
        box-sizing: border-box;
        width: 100%;
    }
    .attendance-sheet {
        border-collapse: collapse;
        width: 100%;
        min-width: max-content;
        background: #fff;
        margin: 0;
    }
    .attendance-sheet th,
    .attendance-sheet td {
        border: 1px solid #ddd;
        padding: 10px 14px !important;
        text-align: center;
        vertical-align: middle;
        background: #fff;
        white-space: nowrap;
        color: #333;
    }
    .attendance-sheet th.date-col-excluded {
        background: #fff;
    }
    .attendance-sheet td.inactive-day-cell {
        position: relative;
        background: #f8fafc;
        overflow: hidden;
    }
    .inactive-watermark {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%) rotate(-34deg);
        font-size: 0.46rem;
        font-weight: 700;
        color: rgba(148, 163, 184, 0.62);
        letter-spacing: 0.08em;
        text-transform: uppercase;
        pointer-events: none;
        white-space: normal;
        text-align: center;
        width: 90%;
        line-height: 1.05;
        overflow-wrap: anywhere;
        word-break: break-word;
    }

    .inactive-watermark.paired-watermark {
        top: 50%;
        width: 92%;
        transform: translate(-50%, -50%) rotate(-10deg);
        font-size: 0.52rem;
        opacity: 0.95;
        z-index: 4;
        letter-spacing: 0.03em;
        line-height: 1.1;
    }

    .term-end-watermark {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%) rotate(-34deg);
        font-size: 0.45rem;
        font-weight: 700;
        color: rgba(148, 163, 184, 0.62);
        letter-spacing: 0.08em;
        text-transform: uppercase;
        pointer-events: none;
        white-space: normal;
        text-align: center;
        width: 90%;
        line-height: 1.1;
    }

    .term-end-watermark.paired-watermark {
        top: 50%;
        width: 92%;
        transform: translate(-50%, -50%) rotate(-10deg);
        font-size: 0.52rem;
        z-index: 4;
        letter-spacing: 0.03em;
        line-height: 1.1;
    }

    .attendance-sheet th.term-end-col {
        background: #fff;
    }

    .attendance-sheet td.term-end-cell {
        position: relative;
    }

    .attendance-sheet td.inactive-day-cell,
    .attendance-sheet td.term-end-cell {
        overflow: visible;
    }
    .attendance-sheet input.attendance-inactive {
        opacity: 0.45;
        pointer-events: none;
    }

    #attendance-summary {
        margin: 30px auto;
        padding: 20px;
        border: 1px solid #ddd;
        border-radius: 12px;
        background-color: #f9f9f9;
        max-width: 900px;
        width: 100%;
        font-size: 1rem;
        box-shadow: 0 2px 8px rgba(0,0,0,0.05);
    }
    
    /* Sticky Student Name — kept above the paired watermarks so any
       placeholder/marker text (e.g. EXCLUDED, OFFICIAL TERM END DATE)
       sits BELOW the student-name row, not on top of it. */
    .attendance-sheet .student-name {
        position: sticky;
        left: 0;
        background-color: #f1f1f1;
        z-index: 6;
        min-width: 160px;
        max-width: 200px;
        text-align: left;
        padding-left: 8px;
        font-weight: 600;
        color: #000;
    }
    .attendance-sheet td.student-name {
        white-space: normal !important;
        overflow-wrap: anywhere;
        word-break: break-word;
        line-height: 1.25;
    }
    .attendance-sheet th.student-name {
        white-space: normal;
        overflow-wrap: anywhere;
    }
    .attendance-sheet thead .student-name { z-index: 7; }
    .inactive-watermark.paired-watermark,
    .term-end-watermark.paired-watermark { z-index: 3 !important; }

    .attendance-sheet th.overall-attendance,
    .attendance-sheet td.overall-attendance {
        min-width: 130px;
        text-align: center;
    }
    
    /* Sticky Header */
    .attendance-sheet thead th {
        position: sticky;
        top: 0;
        background-color: #f1f5f9;
        color: var(--primary);
        z-index: 1;
        font-weight: bold;
    }
    
    
    
    /* Checkbox Styling */
    .attendance-sheet input[type="checkbox"] {
        transform: scale(1.3);
    }
    
    /* === Responsive Layouts === */
    @media screen and (max-width: 768px) {
        /* === PAGE HEADER IMPROVEMENTS === */
        h1 {
            font-size: 1.3rem;
            text-align: center;
            margin: 10px 0;
            padding: 0 10px;
        }

        .link-to-next-back {
            text-align: center;
            margin: 10px 0;
        }

        .back-link {
            display: inline-block;
            padding: 6px 12px;
            background: var(--primary);
            color: white;
            text-decoration: none;
            border-radius: 6px;
            font-size: 0.82rem;
        }

        /* === TABLE CONTAINER IMPROVEMENTS === */
        .attendance-sheet-container {
            padding: 10px 0;
            margin: 10px auto;
            overflow-x: auto;
            -webkit-overflow-scrolling: touch; /* Smooth scrolling on iOS */
        }

        /* === TABLE IMPROVEMENTS === */
        .attendance-sheet {
                        font-size: 0.68rem;
            min-width: 600px; /* Ensure minimum width for horizontal scroll */
        }

        .attendance-sheet th,
        .attendance-sheet td {
                                        font-size: 0.64rem;
                    padding: 5px 3px !important;
                    min-width: 36px;
        }

        /* === STICKY COLUMN IMPROVEMENTS === */
        .attendance-sheet .student-name {
          min-width: 100px;
          max-width: 120px;
                                        font-size: 0.68rem;
          padding: 6px 4px !important;
          background-color: #f8f8f8;
                    border-right: 2px solid var(--primary);
        }

        /* === DATE HEADER IMPROVEMENTS === */
        .date-header {
            padding: 5px 2px;
            line-height: 1.2;
        }
        .day-name { font-size: 0.66rem; }
        .day-name .day-full { display: none; }
        .day-name .day-short { display: inline; }
      
                .edit-save-link,
                .cancel-link,
                .mark-all-link {
                    font-size: 0.62rem;
          padding: 2px 4px;
          margin-top: 2px;
        }
      
        .last-edited {
                    font-size: 0.56rem;
          margin-top: 2px;
        }

        /* === CHECKBOX IMPROVEMENTS === */
        .attendance-sheet input[type="checkbox"] {
            transform: scale(1.28);
            margin: 4px;
            min-width: 16px;
            min-height: 16px;
            cursor: pointer;
        }

        /* Larger tap target cell on mobile */
        .attendance-sheet td:not(.student-name):not(.overall-attendance) {
            min-width: 52px;
            padding: 10px 8px !important;
        }

        /* === OVERALL ATTENDANCE COLUMN === */
        .overall-attendance {
            min-width: 84px;
            max-width: 100px;
            font-size: 0.64rem;
            background-color: #e5f5f7;
            font-weight: bold;
            text-align: center !important;
            white-space: normal !important;
            overflow-wrap: anywhere;
            word-break: break-word;
            line-height: 1.2;
        }

        /* === SUMMARY TABLE IMPROVEMENTS === */
        #attendance-summary {
                    font-size: 0.76rem;
          padding: 15px 10px;
          margin: 20px 10px;
          border-radius: 8px;
        }

        #attendance-summary th {
            font-size: 0.84rem;
            padding: 8px;
        }

        #attendance-summary td {
            padding: 8px 6px;
            text-align: center;
        }

        /* === HORIZONTAL SCROLL INDICATOR === */
        .attendance-sheet-container::after {
            content: "← Scroll left to see older dates";
            display: block;
            text-align: center;
            font-size: 0.66rem;
            color: #666;
            margin-top: 5px;
            font-style: italic;
        }
      }
      
      @media screen and (max-width: 480px) {
        /* === EXTRA SMALL SCREEN OPTIMIZATIONS === */
        h1 {
            font-size: 1.1rem;
            margin: 8px 0;
            padding: 0 5px;
        }

        /* === ULTRA COMPACT TABLE === */
        .attendance-sheet {
            font-size: 0.62rem;
            min-width: 500px;
        }
      
        .attendance-sheet .student-name {
          min-width: 90px;
          max-width: 110px;
                                        font-size: 0.62rem;
          padding: 4px 3px !important;
        }
      
        .attendance-sheet th,
        .attendance-sheet td {
                                        font-size: 0.58rem;
                    padding: 3px 2px !important;
                    min-width: 32px;
        }

        /* === COMPACT DATE HEADERS === */
        .date-header {
            padding: 3px 1px;
        }
        .day-name { font-size: 0.58rem; }
        .day-name .day-full { display: none; }
        .day-name .day-short { display: inline; }
      
                .edit-save-link,
                .cancel-link,
                .mark-all-link {
                    font-size: 0.56rem;
          padding: 1px 2px;
        }
      
        .last-edited {
                    font-size: 0.52rem;
        }

        /* === COMPACT CHECKBOXES === */
        .attendance-sheet input[type="checkbox"] {
            transform: scale(1.2);
            margin: 4px;
            min-width: 15px;
            min-height: 15px;
            cursor: pointer;
        }

        .overall-attendance {
            min-width: 80px;
            max-width: 94px;
            font-size: 0.6rem;
            text-align: center !important;
            white-space: normal !important;
            overflow-wrap: anywhere;
            word-break: break-word;
            line-height: 1.2;
        }

        /* === COMPACT SUMMARY === */
        #attendance-summary {
                    font-size: 0.7rem;
          padding: 10px 5px;
          margin: 15px 0;
        }

        #attendance-summary th {
            font-size: 0.8rem;
            padding: 6px;
        }

        #attendance-summary td {
            padding: 6px 4px;
            font-size: 0.7rem;
        }

        /* === ENHANCED SCROLL INDICATOR === */
        .attendance-sheet-container::after {
            content: "← Scroll left to see older dates";
            font-size: 0.65rem;
            padding: 5px;
            background: #f0f0f0;
            border-radius: 4px;
            margin: 10px 5px 5px 5px;
        }
      }    

            @media screen and (min-width: 481px) and (max-width: 768px) {
                body {
                    padding-bottom: 0 !important;
                }

                .attendance-page {
                    padding: 12px 10px 28px;
                }

                .attendance-meta {
                    font-size: 0.85rem;
                }

                .attendance-summary-toggle {
                    display: inline-flex;
                    align-items: center;
                    gap: 6px;
                }

                .attendance-summary-wrapper {
                    max-height: 420px;
                    overflow: hidden;
                    transition: max-height 0.25s ease;
                }

                .attendance-summary-wrapper.collapsed-mobile {
                    max-height: 0;
                }

                .inactive-watermark.paired-watermark,
                .term-end-watermark.paired-watermark {
                    font-size: 0.5rem;
                }
            }

            /* === Toolbar: title, calendar chips, filters === */
            .attendance-toolbar {
                margin-bottom: <%= isEmbedded ? '10px' : '18px' %>;
            }

            .attendance-header {
                margin: <%= isEmbedded ? '0' : '8px 0 0' %>;
                padding: <%= isEmbedded ? '12px 14px' : '16px 18px' %>;
                border: 1px solid var(--border);
                border-radius: 12px;
                background: #fff;
                box-shadow: 0 4px 14px rgba(15, 23, 42, 0.04);
                text-align: left;
                width: 100%;
                box-sizing: border-box;
            }

            .attendance-header-top {
                display: flex;
                flex-wrap: wrap;
                align-items: center;
                gap: 10px 16px;
            }

            .attendance-header-copy {
                min-width: 0;
                flex: 0 1 auto;
            }

            .attendance-header .attendance-header-title {
                margin: 0;
                padding: 0;
                color: #0f172a;
                font-size: <%= isEmbedded ? '1.1rem' : '1.3rem' %>;
                font-weight: 700;
                line-height: 1.25;
                text-align: left;
            }

            .attendance-header-pills-center {
                display: flex;
                flex: 1 1 auto;
                flex-wrap: wrap;
                align-items: center;
                justify-content: flex-start;
                gap: 6px;
                min-width: 0;
            }

            .attendance-header-actions {
                display: flex;
                align-items: center;
                gap: 8px;
                margin-left: auto;
            }

            .cal-pill-wrap {
                position: relative;
            }

            .attendance-header .cal-pill {
                display: inline-flex;
                align-items: center;
                gap: 6px;
                width: auto;
                height: 28px;
                margin: 0;
                padding: 0 11px;
                border: 1px solid #e2e8f0;
                border-radius: 999px;
                background: #f8fafc;
                color: #334155;
                font-size: 0.76rem;
                font-weight: 600;
                line-height: 1;
                white-space: nowrap;
                cursor: pointer;
                transition: background-color 0.15s ease, border-color 0.15s ease;
            }

            .attendance-header .cal-pill[aria-expanded="true"] {
                border-color: #cbd5e1;
                background: #f1f5f9;
            }

            .attendance-header .cal-pill img {
                border-radius: 2px;
            }

            .attendance-header .cal-pill svg {
                color: #64748b;
            }

            .attendance-header .cal-pill.cal-pill-muted {
                color: #64748b;
            }

            .attendance-header .filter-toggle-btn {
                display: inline-flex;
                align-items: center;
                gap: 7px;
                width: auto;
                height: 34px;
                margin: 0;
                padding: 0 12px;
                border: 1px solid #cbd5e1;
                border-radius: 9px;
                background: #fff;
                color: #0f172a;
                font-size: 0.84rem;
                font-weight: 600;
                white-space: nowrap;
                box-shadow: none;
                cursor: pointer;
                transition: background-color 0.15s ease, border-color 0.15s ease, color 0.15s ease;
            }

            

            .attendance-header .filter-toggle-btn[aria-expanded="true"] {
                border-color: var(--primary);
                background: color-mix(in srgb, var(--primary) 8%, white);
                color: var(--primary);
            }

            .filter-toggle-btn .filter-chevron {
                transition: transform 0.2s ease;
            }

            .filter-toggle-btn[aria-expanded="true"] .filter-chevron {
                transform: rotate(180deg);
            }

            .filter-count {
                display: inline-flex;
                align-items: center;
                justify-content: center;
                min-width: 18px;
                height: 18px;
                padding: 0 5px;
                border-radius: 999px;
                background: var(--primary);
                color: #fff;
                font-size: 0.7rem;
                font-weight: 700;
            }

            .filter-range { font-weight: 500; opacity: 0.75; }
            .filter-range:empty { display: none; }
            .filter-range::before { content: "· "; }
            /* Reminder of school days with no attendance; each day jumps to its column. */
            .att-missed-note { display: flex; align-items: center; gap: 12px; margin: 12px 0 0; padding: 9px 10px 9px 12px; border-radius: 10px; border: 1px solid color-mix(in srgb, #f59e0b 32%, transparent); border-left: 3px solid #f59e0b; background: color-mix(in srgb, #f59e0b 7%, transparent); font-size: 0.84rem; line-height: 1.4; }
            .att-missed-note[hidden] { display: none !important; }
            .att-missed-icon { flex: 0 0 auto; width: 18px; height: 18px; color: #d97706; }
            .att-missed-body { flex: 1 1 auto; min-width: 0; display: flex; flex-wrap: wrap; align-items: center; gap: 6px 10px; }
            .att-missed-body strong { font-weight: 600; }
            .att-missed-days { display: flex; flex-wrap: wrap; gap: 6px; }
            .att-missed-note .att-missed-day { display: inline-flex; align-items: center; width: auto !important; height: 24px; margin: 0; padding: 0 9px; border-radius: 999px; border: 1px solid color-mix(in srgb, #f59e0b 45%, transparent); background: transparent; color: inherit; font-size: 0.76rem; font-weight: 600; white-space: nowrap; cursor: pointer; }
            .att-missed-note .att-missed-day:hover, .att-missed-note .att-missed-day:focus-visible { background: color-mix(in srgb, #f59e0b 15%, transparent); outline: none; }
            .att-missed-note .att-missed-close { flex: 0 0 auto; display: inline-flex; align-items: center; justify-content: center; width: 26px !important; height: 26px; margin: 0; padding: 0; border: 0; border-radius: 6px; background: transparent; color: inherit; opacity: 0.55; font-size: 18px; line-height: 1; cursor: pointer; }
            .att-missed-note .att-missed-close:hover { opacity: 1; background: color-mix(in srgb, #f59e0b 12%, transparent); }
            .att-col-flash { animation: attColFlash 1.8s ease-out; }
            @keyframes attColFlash { 0%, 55% { background-color: color-mix(in srgb, #f59e0b 22%, transparent); } 100% { background-color: transparent; } }
            .filter-count[hidden] {
                display: none;
            }

            /* Filters: a pop-up under the Filters button (nothing on the page moves). */
            .attendance-header-actions { position: relative; }
            .filter-controls-content {
                position: absolute;
                top: calc(100% + 8px);
                right: 0;
                z-index: 60;
                width: min(300px, calc(100vw - 32px));
                background: #fff;
                border: 1px solid var(--border, #e2e8f0);
                border-radius: 12px;
                box-shadow: 0 18px 40px rgba(15, 23, 42, 0.18), 0 2px 6px rgba(15, 23, 42, 0.06);
                animation: attFilterPop 0.14s ease-out;
            }

            .filter-controls-content.collapsed {
                display: none;
            }

            @keyframes attFilterPop { from { opacity: 0; transform: translateY(-4px) scale(0.98); } to { opacity: 1; transform: none; } }

            .filter-controls {
                padding: 14px;
            }

            .filter-inner-container {
                display: grid;
                gap: 12px;
            }

            .filter-field {
                display: flex;
                flex-direction: column;
                gap: 5px;
                margin: 0;
                color: #64748b;
                font-size: 0.7rem;
                font-weight: 700;
                letter-spacing: 0.04em;
                text-transform: uppercase;
            }

            .filter-field select,
            .filter-field .filter-sort-btn {
                height: 36px;
                margin: 0;
                border: 1px solid #cbd5e1;
                border-radius: 8px;
                background-color: #fff;
                color: #0f172a;
                font-size: 0.86rem;
                font-weight: 500;
                letter-spacing: normal;
                text-transform: none;
            }

            .filter-field select {
                width: 100%;
                min-width: 0;
                padding: 0 10px;
            }

            .filter-field .filter-sort-btn {
                display: inline-flex;
                align-items: center;
                gap: 6px;
                width: auto;
                min-width: 96px;
                padding: 0 12px;
                font-weight: 600;
                cursor: pointer;
            }

            .filter-field select:focus,
            .filter-field .filter-sort-btn:focus-visible {
                border-color: var(--primary);
                outline: 2px solid color-mix(in srgb, var(--primary) 22%, transparent);
                outline-offset: 0;
            }

            .filter-sort-btn[data-sort-direction="asc"] .sort-label-desc,
            .filter-sort-btn[data-sort-direction="desc"] .sort-label-asc {
                display: none;
            }

            .filter-actions {
                display: flex;
                align-items: center;
                justify-content: flex-end;
                margin: 0 -14px -14px;
                padding: 4px 6px;
                border-top: 1px solid var(--border, #eef2f6);
            }

            .filter-reset-btn {
                width: auto;
                height: 36px;
                margin: 0;
                padding: 0 12px;
                border: 0;
                border-radius: 8px;
                background: transparent;
                color: var(--primary);
                font-size: 0.84rem;
                font-weight: 600;
                cursor: pointer;
            }

            

            .filter-reset-btn[disabled] {
                color: #94a3b8;
                background: transparent;
                cursor: default;
            }

            @media screen and (max-width: 640px) {
                .attendance-header-top {
                    gap: 8px 10px;
                }

                .attendance-header-pills-center {
                    order: 3;
                    flex-basis: 100%;
                }

                .attendance-header .cal-pill {
                    height: 26px;
                    padding: 0 9px;
                    font-size: 0.72rem;
                }

            }

            /* Cards on the page: the body carries the person's appearance color. */
            body { background: var(--ap-page, var(--bg)); }
            .attendance-page { background: transparent; }
            .attendance-page-embedded { padding: 14px 16px 24px; }
            .attendance-header { box-shadow: none; }
            .attendance-sheet-container,
            .attendance-page-embedded .attendance-sheet-container {
                margin: 0;
                padding: 0;
                background: #fff;
                border: 1px solid var(--border);
                border-radius: 12px;
                box-shadow: none;
            }
            .attendance-sheet th,
            .attendance-sheet td { border: 0; border-bottom: 1px solid #eef0f3; }
            .attendance-sheet thead th { background: #f8fafc; color: #475569; }
            .attendance-sheet tbody tr:last-child > * { border-bottom: 0; }
            .attendance-sheet .student-name { border-right: 1px solid #eef0f3; color: #0f172a; }
            /* One color down the name column (no striping). */
            .attendance-sheet tbody tr td.student-name,
            .attendance-sheet tbody tr:nth-child(odd) td.student-name,
            .attendance-sheet tbody tr:nth-child(even) td.student-name { background-color: #ffffff !important; }
            .attendance-sheet thead th.student-name { background-color: #f8fafc !important; }
            .att-calendar-note {
                display: flex; flex-wrap: wrap; align-items: center; gap: 4px 10px;
                margin-top: 10px; padding: 8px 12px; border: 1px solid #fde68a; border-radius: 8px;
                background: #fffbeb; color: #92400e; font-size: 0.82rem;
            }
            .att-calendar-note a { color: #b45309; font-weight: 600; }
            .att-summary {
                margin-top: 14px; padding: 14px 16px; border: 1px solid var(--border); border-radius: 12px;
                background: #fff; text-align: left;
            }
            .att-summary__title { margin: 0 0 10px; font-size: 0.95rem; font-weight: 700; color: #0f172a; }
            .att-summary #attendance-summary {
                margin: 0; padding: 0; max-width: none; border: 0; border-radius: 0; background: transparent; box-shadow: none;
                font-size: 0.85rem; border-collapse: collapse;
            }
            .att-summary #attendance-summary th,
            .att-summary #attendance-summary td { padding: 8px 10px; border: 0; border-bottom: 1px solid #eef0f3; text-align: left; color: #0f172a; background: transparent; }
            .att-summary #attendance-summary thead th { color: #475569; font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.03em; background: #f8fafc; }
            .att-summary #attendance-summary tbody tr:last-child td { border-bottom: 0; font-weight: 700; }
</style>
</head>
<body>
        <div class="attendance-page <%= isEmbedded ? 'attendance-page-embedded' : '' %>">
            <div class="attendance-toolbar">
            <div class="attendance-header">
                <div class="attendance-header-top">
                    <div class="attendance-header-copy">
                        <h1 class="attendance-header-title"><%= isEmbedded ? 'Attendance' : `Attendance for ${className}` %></h1>
                        <% if (!isEmbedded) { %>
                        <div class="attendance-meta">School Year: <%= schoolYear.year_label %> &middot; Term: <%= termName %></div>
                        <% } %>
                    </div>
                    <div class="attendance-header-pills-center">
                    <% if (attendanceCalendarSummary && attendanceCalendarSummary.enabled) { %>
                        <% const _countryCode = String(attendanceCalendarSummary.countryCode || '').trim().toUpperCase(); %>
                        <% const _countryFlagHtml = /^[A-Z]{2}$/.test(_countryCode) ? `<img src="https://flagcdn.com/24x18/${_countryCode.toLowerCase()}.png" alt="" width="18" height="13">` : '🌍'; %>
                        <div class="cal-pill-wrap">
                            <button type="button" class="cal-pill" data-pill="country" aria-expanded="false" aria-controls="popover-country">
                                <%- _countryFlagHtml %> <%= _countryCode %>
                            </button>
                            <div class="cal-pill-popover" id="popover-country">
                                <p class="cal-popover-label">Country</p>
                                <p class="cal-popover-value"><%- _countryFlagHtml %> <%= _countryCode %></p>
                            </div>
                        </div>
                        <div class="cal-pill-wrap">
                            <button type="button" class="cal-pill" data-pill="weekends" aria-expanded="false" aria-controls="popover-weekends">
                                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/></svg>
                                Weekends
                            </button>
                            <div class="cal-pill-popover" id="popover-weekends">
                                <p class="cal-popover-label">Weekend Days</p>
                                <p class="cal-popover-value"><%= (attendanceCalendarSummary.weekendLabels || []).length ? attendanceCalendarSummary.weekendLabels.join(', ') : 'None' %></p>
                            </div>
                        </div>
                        <div class="cal-pill-wrap">
                            <button type="button" class="cal-pill" data-pill="holidays" aria-expanded="false" aria-controls="popover-holidays">
                                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 22V4a1 1 0 0 1 1-1h11l-2 4 2 4H5"/></svg>
                                Public Holidays
                            </button>
                            <div class="cal-pill-popover" id="popover-holidays">
                                <p class="cal-popover-label">Public Holidays</p>
                                <p class="cal-popover-value"><%= attendanceCalendarSummary.includePublicHolidays ? 'Excluded from attendance' : 'Included in attendance' %></p>
                            </div>
                        </div>
                        <% if (attendanceCalendarSummary.excludedDisplayDateCount > 0) { %>
                        <div class="cal-pill-wrap">
                            <button type="button" class="cal-pill cal-pill-muted" data-pill="excluded" aria-expanded="false" aria-controls="popover-excluded">
                                <%= attendanceCalendarSummary.excludedDisplayDateCount %> inactive <%= attendanceCalendarSummary.excludedDisplayDateCount === 1 ? 'date' : 'dates' %>
                            </button>
                            <div class="cal-pill-popover" id="popover-excluded">
                                <p class="cal-popover-label">Inactive Dates</p>
                                <p class="cal-popover-value"><%= attendanceCalendarSummary.excludedDisplayDateCount %> <%= attendanceCalendarSummary.excludedDisplayDateCount === 1 ? 'date is' : 'dates are' %> shown as inactive &mdash; weekends, public holidays, or manually excluded.</p>
                            </div>
                        </div>
                        <% } %>
                    <% } %>
                    </div>
                    <div class="attendance-header-actions">
                        <button type="button" class="filter-toggle-btn" onclick="toggleFilters()" aria-expanded="false" aria-controls="filterControlsContent">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polygon points="3 4 21 4 14 12 14 19 10 21 10 12 3 4"></polygon></svg>
                            <span>Filters</span>
                            <span class="filter-range" id="attRangeLabel"></span>
                            <span class="filter-count" id="filterCount" hidden></span>
                            <svg class="filter-chevron" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
                        </button>
                        <div class="filter-controls-content collapsed" id="filterControlsContent" role="dialog" aria-label="Filters"
                             data-range-key="attendance-range:<%= (typeof session !== 'undefined' && session && session.organizationId) || '' %>:<%= (typeof session !== 'undefined' && session && (session.userId || (session.user && session.user.user_id))) || '' %>"
                             data-today="<%= (typeof attendanceTodayKey !== 'undefined' && attendanceTodayKey) || '' %>">
                            <div class="filter-controls">
                                <div class="filter-inner-container">
                                    <div class="filter-field">
                                        <span id="nameSortLabel">Name order</span>
                                        <button type="button" class="filter-sort-btn" id="nameSortToggle" data-sort-direction="asc" aria-labelledby="nameSortLabel nameSortToggle" aria-label="Sort names Z to A">
                                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m3 16 4 4 4-4M7 20V4M11 4h10M11 8h7M11 12h4"/></svg>
                                            <span class="sort-label-asc">A → Z</span><span class="sort-label-desc">Z → A</span>
                                        </button>
                                        <input type="hidden" id="nameSort" value="asc">
                                    </div>

                                    <label class="filter-field">
                                        Gender
                                        <select id="genderFilter">
                                            <option value="all">All students</option>
                                            <option value="Female">Female</option>
                                            <option value="Male">Male</option>
                                        </select>
                                    </label>

                                    <% const todayKey = (typeof attendanceTodayKey !== 'undefined' && attendanceTodayKey) || (function () { const n = new Date(); return `${n.getFullYear()}-${String(n.getMonth() + 1).padStart(2, '0')}-${String(n.getDate()).padStart(2, '0')}`; })(); %>

                                    <label class="filter-field">
                                        Show
                                        <select id="dateFilter">
                                            <optgroup label="Range (remembered)">
                                                <option value="d1">Last school day</option>
                                                <option value="d2">Last 2 school days</option>
                                                <option value="d3">Last 3 school days</option>
                                                <option value="w1">Last week</option>
                                                <option value="w2">Last 2 weeks</option>
                                                <option value="m1">Last month</option>
                                                <option value="all">Whole term</option>
                                            </optgroup>
                                            <optgroup label="One day">
                                                <% displayDates.slice().reverse().forEach(date => { %>
                                                    <% const isToday = date === todayKey; %>
                                                    <% const dateObj = new Date(`${date}T00:00:00Z`); %>
                                                    <% const formattedDate = dateObj.toLocaleDateString('en-US', { weekday: 'short', month: 'short', day: 'numeric', year: 'numeric', timeZone: 'UTC' }); %>
                                                    <option value="date:<%= date %>"><%= isToday ? `Today (${formattedDate})` : formattedDate %></option>
                                                <% }) %>
                                            </optgroup>
                                        </select>
                                    </label>

                                    <div class="filter-actions">
                                        <button type="button" class="filter-reset-btn" id="filterResetBtn" onclick="resetFilters()" disabled>Reset</button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <% if (!(attendanceCalendarSummary && attendanceCalendarSummary.enabled)) { %>
                    <div class="att-calendar-note" role="note">
                        <span>No attendance calendar is set for this term, so every date is shown, weekends included.</span>
                        <a href="/account/settings?section=customize&calendarTermId=<%= termId %>">Set up the calendar</a>
                    </div>
                <% } %>
                <div class="att-missed-note" id="attMissedNote" role="status" hidden>
                    <svg class="att-missed-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M16 3v4M8 3v4M3 10h18M12 13.5v2.5M12 18.6v.01"/></svg>
                    <div class="att-missed-body">
                        <strong id="attMissedTitle"></strong>
                        <span class="att-missed-days" id="attMissedDays"></span>
                    </div>
                    <button type="button" class="att-missed-close" id="attMissedClose" aria-label="Hide this reminder" title="Hide">&times;</button>
                </div>
            </div>
            </div>

    

    <% if (students.length === 0) { %>
        <p class="att-summary" style="text-align: center; color: #64748b;">No students in this class yet.</p>
    <% } else { %>
        <% if ((locals.attendanceForms || []).length) { %>
        <style>
          .attendance-sheet .att-form-col { min-width: 132px; padding: 4px 8px; text-align: left; white-space: nowrap; }
          .attendance-sheet th.att-form-col small { display: block; font-size: .68em; font-weight: 500; opacity: .7; }
          .attendance-sheet .att-form-sel { width: 100%; min-width: 116px; height: 32px; margin: 0; padding: 0 8px; border: 1px solid #cbd5e1; border-radius: 8px; background: #fff; color: inherit; font: inherit; font-size: .86em; }
          .attendance-sheet .att-form-sel.is-saved { border-color: #16a34a; }
          .attendance-sheet .att-form-sel.is-bad, .attendance-sheet .att-taps.is-bad button[aria-pressed="true"] { border-color: #dc2626; }
          /* Tap answers: the chosen one is lit, the others stay quiet. */
          .attendance-sheet .att-taps { display: inline-flex; gap: 4px; }
          .attendance-sheet .att-taps button { display: inline-flex; align-items: center; justify-content: center; min-width: 40px; height: 34px; margin: 0; padding: 0 9px; border: 1px solid #d0d5dd; border-radius: 9px; background: #fff; box-shadow: none; color: #475467; font: inherit; font-size: .84em; font-weight: 600; cursor: pointer; transition: background .12s ease, color .12s ease, opacity .12s ease, border-color .12s ease; }
          .attendance-sheet .att-taps--icons button { width: 40px; padding: 0; }
          .attendance-sheet .att-taps button:hover { border-color: var(--org-primary-color, #01535b); }
          .attendance-sheet .att-taps button[aria-pressed="true"] { border-color: var(--org-primary-color, #01535b); background: var(--org-primary-color, #01535b); color: #fff; }
          .attendance-sheet .att-taps--icons:has(button[aria-pressed="true"]) button:not([aria-pressed="true"]) { opacity: .4; }
          .attendance-sheet .att-taps svg { display: block; }
          .attendance-sheet th .att-key { display: flex; flex-direction: column; gap: 2px; margin-top: 6px; font-size: .72em; font-weight: 600; letter-spacing: 0; text-transform: none; opacity: .85; }
          .attendance-sheet th .att-key > span { display: inline-flex; align-items: center; gap: 4px; white-space: nowrap; }
          .attendance-sheet th .att-key b { font-variant-numeric: tabular-nums; }
          .attendance-sheet .att-sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
          @media print { .attendance-sheet .att-form-col { display: none; } }
        </style>
        <script>
          // Today's answers to the forms collected with attendance: saved as each one is chosen,
          // one student at a time (Custom editor, "Add it to the attendance page").
          (function () {
            var day = <%- JSON.stringify(attendanceTodayKey) %>;
            var queue = {};
            // The row's answers to one form: dropdowns by their value, taps by the one that is lit.
            function valuesOf(row, form) {
              var values = {};
              Array.prototype.forEach.call(row.querySelectorAll('[data-att-form="' + form + '"]'), function (box) {
                var v = box.tagName === 'SELECT' ? box.value : box.getAttribute('data-value') || '';
                var type = box.getAttribute('data-att-type');
                values[box.getAttribute('data-att-field')] = v === '' ? null : type === 'rating' ? Number(v) : type === 'yesno' ? v === 'yes' : v;
              });
              return values;
            }
            function save(box) {
              var form = box.getAttribute('data-att-form');
              var student = box.getAttribute('data-att-student');
              var values = valuesOf(box.closest('tr'), form);
              var key = form + ':' + student;
              var send = function () {
                return fetch('/common/forms/' + form + '/student/' + student + '?day=' + encodeURIComponent(day), {
                  method: 'POST', credentials: 'same-origin', headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
                  body: JSON.stringify({ values: values, quick: true, day: day }),
                }).then(function (res) { return res.json().catch(function () { return {}; }).then(function (json) { if (!res.ok || !json.success) throw new Error(json.error || 'It could not be saved.'); }); })
                  .then(function () { box.classList.remove('is-bad'); box.classList.add('is-saved'); box.title = 'Saved'; })
                  .catch(function (error) { box.classList.remove('is-saved'); box.classList.add('is-bad'); box.title = error.message; });
              };
              queue[key] = (queue[key] || Promise.resolve()).then(send);
            }
            // The key in the column heading: how many have each answer today.
            function recount() {
              Array.prototype.forEach.call(document.querySelectorAll('.att-key'), function (key) {
                var parts = key.getAttribute('data-att-key').split(':');
                var counts = {};
                Array.prototype.forEach.call(document.querySelectorAll('.att-taps[data-att-form="' + parts[0] + '"][data-att-field="' + parts[1] + '"]'), function (box) {
                  var v = box.getAttribute('data-value');
                  if (v) counts[v] = (counts[v] || 0) + 1;
                });
                Array.prototype.forEach.call(key.querySelectorAll('[data-k]'), function (item) { item.querySelector('b').textContent = counts[item.getAttribute('data-k')] || 0; });
              });
            }
            // This script sits above the table: count once the rows are there.
            if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', recount); else setTimeout(recount, 0);
            document.addEventListener('change', function (event) {
              var sel = event.target.closest ? event.target.closest('.att-form-sel') : null;
              if (sel) save(sel);
            });
            // A tap lights that answer (and dims the others); tapping the lit one clears it.
            document.addEventListener('click', function (event) {
              var tap = event.target.closest ? event.target.closest('.att-taps button') : null;
              if (!tap) return;
              var box = tap.closest('.att-taps');
              var v = box.getAttribute('data-value') === tap.getAttribute('data-v') ? '' : tap.getAttribute('data-v');
              box.setAttribute('data-value', v);
              Array.prototype.forEach.call(box.querySelectorAll('button'), function (b) { b.setAttribute('aria-pressed', String(b.getAttribute('data-v') === v)); });
              recount();
              save(box);
            });
          })();
        </script>
        <% } %>
        <div class="attendance-sheet-container">
            <table class="attendance-sheet">
                <thead>
                    <tr>
                        <th class="student-name">Student Name <button type="button" class="sort-toggle-btn" id="attendanceHeaderSortToggle" data-sort-direction="asc" aria-label="Sort names Z to A"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 12 12" aria-hidden="true" focusable="false"><path fill="currentColor" d="M10 5H2a.5.5 0 0 1-.46-.31.47.47 0 0 1 .11-.54L5.29.5A1 1 0 0 1 6.7.5l3.65 3.65a.49.49 0 0 1 .11.54A.51.51 0 0 1 10 5z"></path><path fill="currentColor" d="M2 7a.5.5 0 0 0-.46.31.47.47 0 0 0 .11.54L5.3 11.5a1 1 0 0 0 1.41 0l3.65-3.65a.49.49 0 0 0 .11-.54A.53.53 0 0 0 10 7z"></path></svg></button></th>
                        <%# Custom editor sections collected every day with attendance (a lunch count): today's answer, beside the name. %>
                        <% (locals.attendanceForms || []).forEach((form) => form.fields.forEach((field) => { %>
                        <th class="att-form-col" title="<%= form.name %>"><%= field.label %><small>Today</small><% if (field.type === 'yesno' || field.display === 'icons' || field.display === 'buttons') { const _keyChoices = field.type === 'yesno' ? [['yes', 'Yes', field.display === 'icons' ? 'check' : ''], ['no', 'No', field.display === 'icons' ? 'close' : '']] : (field.options || []).map((o) => [o, o, field.display === 'icons' ? ((field.icons || {})[o] || '') : '']); %><span class="att-key" data-att-key="<%= form.id %>:<%= field.id %>"><% _keyChoices.forEach((choice) => { %><span data-k="<%= choice[0] %>"><% if (choice[2]) { %><%- formIcon(choice[2], 14) %><% } %><%= choice[1] %> <b>0</b></span><% }) %></span><% } %></th>
                        <% })) %>
                        <% displayDates.forEach(date => { %>
                            <% const isToday = date === todayKey; %>
                            <% const dateMeta = (dateMetaMap && dateMetaMap[date]) ? dateMetaMap[date] : { countable: true }; %>
                            <th data-date="<%= date %>" class="<%= isToday ? 'today-col' : '' %> <%= !dateMeta.countable ? 'date-col-excluded' : '' %> <%= dateMeta.isOfficialTermEnd ? 'term-end-col' : '' %>">
                                <div class="date-header">
                                    <% const _parts = String(date).split('-'); %>
                                    <% const _d = new Date(Number(_parts[0]), Number(_parts[1]) - 1, Number(_parts[2])); %>
                                    <% const _formattedDate = `${Number(_parts[1])}/${Number(_parts[2])}/${_parts[0]}`; %>
                                    <% const _days = ['Sunday','Monday','Tuesday','Wednesday','Thursday','Friday','Saturday']; %>
                                    <% const _dayShorts = ['Sun','Mon','Tue','Wed','Thu','Fri','Sat']; %>
                                    <% if (!isToday) { %>
                                    <span class="day-name">
                                        <span class="day-full"><%= _days[_d.getDay()] %></span>
                                        <span class="day-short"><%= _dayShorts[_d.getDay()] %></span>
                                    </span>
                                    <% } %>
                                    <% if (isToday) { %><span class="day-name">Today</span><% } %>
                                    <%= _formattedDate %>
                                    <% if (students.length > 0 && dateMeta.countable) { %>
                                        <div class="edit-save-link" data-date="<%= date %>" onclick="toggleEditSaveMode('<%= date %>')">Edit</div>
                                        <div class="cancel-link" data-date="<%= date %>" style="display: none;" onclick="cancelEditMode('<%= date %>')">Cancel</div>
                                        <div class="mark-all-link" data-date="<%= date %>" style="display: none;" onclick="markAllPresentForDate('<%= date %>')">Mark All Present</div>
                                    <% } %>
                                    <div class="last-edited <%= (lastEditedMap && lastEditedMap[date]) ? 'has-tooltip' : '' %>" id="last-edited-<%= date %>">
                                        <% if (lastEditedMap && lastEditedMap[date]) { %>
                                            <span class="last-edited-icon" aria-hidden="true">
                                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="10" height="10"><circle cx="12" cy="12" r="9"></circle><path d="M12 7v5l3 2"></path></svg>
                                            </span><span class="last-edited-text">Last edited</span>
                                            <span class="last-edited-hover-date" role="tooltip"><%= new Date(lastEditedMap[date]).toLocaleString('en-US', { month: 'numeric', day: 'numeric', year: 'numeric', hour: 'numeric', minute: '2-digit' }) %></span>
                                        <% } %>
                                    </div>
                                </div>
                            </th>
                        <% }); %>
                        <th class="overall-attendance">Overall Attendance</th>
                    </tr>
                </thead>
                <tbody>
                    <% students.forEach((student, rowIndex) => { %>
                        <% const attendanceStudentName = (typeof formatDisplayName === 'function' ? formatDisplayName(student) : [student.first_name, student.last_name].filter(Boolean).join(' ').trim()); %>
                        <tr 
                        data-name="<%= String(attendanceStudentName || '').toLowerCase() %>" 
                        data-gender="<%= student.gender ? student.gender.toLowerCase() : '' %>">
                                <td class="student-name" data-student-id="<%= student.student_id %>">
                                <%= attendanceStudentName %>
                            </td>
                            <% (locals.attendanceForms || []).forEach((form) => { const _answers = (form.values || {})[student.student_id] || {}; form.fields.forEach((field) => { const _v = _answers[field.id]; const _now = field.type === 'yesno' ? (_v === true ? 'yes' : _v === false ? 'no' : '') : (_v == null ? '' : String(_v)); const _choices = field.type === 'yesno' ? [['yes', 'Yes', field.display === 'icons' ? 'check' : ''], ['no', 'No', field.display === 'icons' ? 'close' : '']] : field.type === 'rating' ? [1, 2, 3, 4, 5].map((n) => [String(n), String(n), '']) : (field.options || []).map((o) => [o, o, field.display === 'icons' ? ((field.icons || {})[o] || '') : '']); const _taps = field.type === 'yesno' || field.display === 'icons' || field.display === 'buttons'; %>
                            <td class="att-form-col"><% if (_taps) { %><span class="att-taps<%= field.display === 'icons' ? ' att-taps--icons' : '' %>" role="group" aria-label="<%= field.label %> for <%= attendanceStudentName %>" data-att-form="<%= form.id %>" data-att-field="<%= field.id %>" data-att-type="<%= field.type %>" data-att-student="<%= student.student_id %>" data-value="<%= _now %>"><% _choices.forEach((choice) => { %><button type="button" data-v="<%= choice[0] %>" aria-pressed="<%= _now === choice[0] ? 'true' : 'false' %>" title="<%= choice[1] %>"><% if (choice[2]) { %><%- formIcon(choice[2], 20) %><span class="att-sr"><%= choice[1] %></span><% } else { %><%= choice[1] %><% } %></button><% }) %></span><% } else { %><select class="att-form-sel" data-att-form="<%= form.id %>" data-att-field="<%= field.id %>" data-att-type="<%= field.type %>" data-att-student="<%= student.student_id %>" aria-label="<%= field.label %> for <%= attendanceStudentName %>"><option value="">—</option><% _choices.forEach((choice) => { %><option value="<%= choice[0] %>"<%= _now === choice[0] ? ' selected' : '' %>><%= choice[1] %></option><% }) %></select><% } %></td>
                            <% }) }) %>
                            <% let presentCount = 0; %>
                            <% let totalCount = 0; %>
                            <%# One cell per student per school day: thousands on a page, so each is written
                                on one line with no indentation (this block was three quarters of the page's size). %>
                            <%_ displayDates.forEach(date => { _%>
                                <%_ const isTodayCell = date === todayKey; _%>
                                <%_ const dateMeta = (dateMetaMap && dateMetaMap[date]) ? dateMetaMap[date] : { countable: true, markerLabel: null }; _%>
                                <%_ const showPairedWatermark = (rowIndex % 2) === 0; _%>
                                <%_ const mark = attendanceMap[student.student_id] && attendanceMap[student.student_id][date]; _%>
<td class="<%= isTodayCell ? 'today-col' : '' %> <%= !dateMeta.countable ? 'inactive-day-cell' : '' %> <%= dateMeta.isOfficialTermEnd ? 'term-end-cell' : '' %>"><input type="checkbox" data-date="<%= date %>" data-student-id="<%= student.student_id %>" data-countable="<%= dateMeta.countable ? 'true' : 'false' %>" class="<%= !dateMeta.countable ? 'attendance-inactive' : '' %>" <%= mark === 'Present' ? 'checked' : '' %> <%= (!dateMeta.countable || mark) ? 'disabled' : '' %>>
                                <%_ if (!dateMeta.countable && showPairedWatermark) { _%>
<span class="inactive-watermark paired-watermark"><%= (dateMeta.markerLabel || 'Excluded').toUpperCase() %></span>
                                <%_ } _%>
                                <%_ if (dateMeta.isOfficialTermEnd && showPairedWatermark) { _%>
<span class="term-end-watermark paired-watermark">OFFICIAL TERM END DATE</span>
                                <%_ } _%>
                                <%_ if (dateMeta.countable) { totalCount++; } _%>
                                <%_ if (dateMeta.countable && mark === 'Present') { presentCount++; } _%>
</td>
                            <%_ }); _%>
                            <td class="overall-attendance"><%= presentCount %>/<%= totalCount %></td>
                        </tr>
                    <% }); %>
                </tbody>
            </table>

        </div>

    <% } %>

    <section class="att-summary">
    <h2 class="att-summary__title">Summary</h2>
    <button type="button" id="attendanceSummaryToggle" class="attendance-summary-toggle" onclick="toggleAttendanceSummary()">Show summary</button>
    <div id="attendanceSummaryWrapper" class="attendance-summary-wrapper collapsed-mobile">
      <table id="attendance-summary" style="width: 100%;">
          <thead>
              <tr><th>Students</th><th>Total</th><th>Days present</th><th>Days absent</th></tr>
          </thead>
          <tbody>
              <tr><td>Male</td><td><span id="maleTotal">0</span></td><td><span id="malePresent">0</span></td><td><span id="maleAbsent">0</span></td></tr>
              <tr><td>Female</td><td><span id="femaleTotal">0</span></td><td><span id="femalePresent">0</span></td><td><span id="femaleAbsent">0</span></td></tr>
              <tr><td>Class</td><td><span id="classTotal">0</span></td><td><span id="classPresent">0</span></td><td><span id="classAbsent">0</span></td></tr>
          </tbody>
      </table>
    </div>
    </section>
    

    </div>

    <script>
        var originalStates = window.__attendanceOriginalStates || {};
        window.__attendanceOriginalStates = originalStates;

        // Toggle Filter Controls
        function toggleFilters(force) {
            const content = document.getElementById('filterControlsContent');
            const button = document.querySelector('.filter-toggle-btn');
            if (!content || !button) return;
            const open = typeof force === 'boolean' ? force : content.classList.contains('collapsed');
            content.classList.toggle('collapsed', !open);
            button.setAttribute('aria-expanded', open ? 'true' : 'false');
        }
        // The Filters pop-up closes on a click elsewhere or Esc.
        if (!window.__attFilterPopBound) {
            window.__attFilterPopBound = true;
            document.addEventListener('click', function (e) {
                const content = document.getElementById('filterControlsContent');
                if (!content || content.classList.contains('collapsed')) return;
                if (content.contains(e.target) || e.target.closest('.filter-toggle-btn')) return;
                toggleFilters(false);
            });
            document.addEventListener('keydown', function (e) {
                const content = document.getElementById('filterControlsContent');
                if (e.key !== 'Escape' || !content || content.classList.contains('collapsed')) return;
                toggleFilters(false);
                const button = document.querySelector('.filter-toggle-btn');
                if (button) button.focus();
            });
        }

        // Filters apply as soon as they change; the button shows how many are on.
        function updateFilterState() {
            const active = [
                document.getElementById('nameSort').value === 'desc',
                document.getElementById('genderFilter').value !== 'all',
                document.getElementById('dateFilter').value.indexOf('date:') === 0,
            ].filter(Boolean).length;
            const count = document.getElementById('filterCount');
            if (count) {
                count.textContent = String(active);
                count.hidden = active === 0;
            }
            const reset = document.getElementById('filterResetBtn');
            if (reset) reset.disabled = active === 0 && !readSavedRange();
            const label = document.getElementById('attRangeLabel');
            if (label) label.textContent = rangeLabel(document.getElementById('dateFilter').value);
        }

        // ---- Which days show: a remembered range, or one day ----
        // Ranges count school days (1-3 days) or calendar days (weeks, month)
        // back from today. The person's pick is remembered on this device
        // until they change it; until then it's the last 3 school days, or
        // the last week when a school day in the past week wasn't marked.
        var ATT_RANGES = { d1: 'Last school day', d2: 'Last 2 school days', d3: 'Last 3 school days', w1: 'Last week', w2: 'Last 2 weeks', m1: 'Last month', all: 'Whole term' };
        function rangeStore() { var el = document.getElementById('filterControlsContent'); return el ? el.dataset.rangeKey : ''; }
        function readSavedRange() { try { var v = localStorage.getItem(rangeStore()); return ATT_RANGES[v] ? v : null; } catch (e) { return null; } }
        function saveRange(v) { try { if (v) localStorage.setItem(rangeStore(), v); else localStorage.removeItem(rangeStore()); } catch (e) {} }
        function keyToDate(key) { var p = String(key).split('-').map(Number); return new Date(p[0], p[1] - 1, p[2]); }
        function shortDay(key) { return keyToDate(key).toLocaleDateString('en-US', { weekday: 'short', month: 'short', day: 'numeric' }); }
        function rangeLabel(v) { return ATT_RANGES[v] || (v.indexOf('date:') === 0 ? shortDay(v.slice(5)) : ''); }
        function sheetDates() {
            return Array.from(document.querySelectorAll('.attendance-sheet thead th[data-date]')).map(function (th) {
                return { date: th.dataset.date, countable: !th.classList.contains('date-col-excluded') };
            });
        }
        function datesForRange(v) {
            var all = sheetDates();
            if (v === 'all') return new Set(all.map(function (d) { return d.date; }));
            if (v.indexOf('date:') === 0) return new Set([v.slice(5)]);
            var schoolDays = { d1: 1, d2: 2, d3: 3 }[v];
            if (schoolDays) return new Set(all.filter(function (d) { return d.countable; }).slice(-schoolDays).map(function (d) { return d.date; }));
            var span = { w1: 7, w2: 14, m1: 30 }[v] || 7;
            // Counted back from the newest day on the sheet, so a week is always 7 days.
            var from = keyToDate(all.length ? all[all.length - 1].date : document.getElementById('filterControlsContent').dataset.today);
            from.setDate(from.getDate() - (span - 1));
            return new Set(all.filter(function (d) { return keyToDate(d.date) >= from; }).map(function (d) { return d.date; }));
        }
        // School days in the past week (not today) with no attendance taken.
        function missedDays() {
            var all = sheetDates();
            var newest = all.length ? all[all.length - 1].date : document.getElementById('filterControlsContent').dataset.today;
            var today = document.getElementById('filterControlsContent').dataset.today;
            var from = keyToDate(newest); from.setDate(from.getDate() - 6);
            return all.filter(function (d) {
                if (!d.countable || d.date === today || d.date === newest || keyToDate(d.date) < from) return false;
                return !Array.from(document.querySelectorAll('.attendance-sheet tbody input[data-date="' + d.date + '"]')).some(function (cb) { return cb.disabled; });
            }).map(function (d) { return d.date; });
        }
        function defaultRange() { return missedDays().length ? 'w1' : 'd3'; }
        function missedHiddenKey() { return 'att-missed-hidden:' + rangeStore(); }
        function showMissedNote() {
            var note = document.getElementById('attMissedNote');
            if (!note) return;
            var missed = missedDays();
            var dismissed = false;
            try { dismissed = sessionStorage.getItem(missedHiddenKey()) === missed.join(','); } catch (e) {}
            note.hidden = !missed.length || dismissed;
            if (note.hidden) return;
            document.getElementById('attMissedTitle').textContent = missed.length === 1 ? "1 school day isn't marked yet" : missed.length + " school days aren't marked yet";
            var days = document.getElementById('attMissedDays');
            days.textContent = '';
            missed.forEach(function (d) {
                var b = document.createElement('button');
                b.type = 'button';
                b.className = 'att-missed-day';
                b.dataset.date = d;
                b.textContent = shortDay(d);
                b.title = 'Go to ' + shortDay(d);
                days.appendChild(b);
            });
        }
        // Bring a day's column into view (showing the last week if it's hidden) and highlight it.
        function goToDay(date) {
            var select = document.getElementById('dateFilter');
            if (select && !datesForRange(select.value).has(date)) { select.value = 'w1'; saveRange('w1'); applyDateColumns(); }
            var th = document.querySelector('.attendance-sheet thead th[data-date="' + date + '"]');
            if (!th) return;
            th.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });
            var cells = [th].concat(Array.from(document.querySelectorAll('.attendance-sheet tbody input[data-date="' + date + '"]')).map(function (cb) { return cb.closest('td'); }).filter(Boolean));
            cells.forEach(function (c) { c.classList.remove('att-col-flash'); void c.offsetWidth; c.classList.add('att-col-flash'); });
            setTimeout(function () { cells.forEach(function (c) { c.classList.remove('att-col-flash'); }); }, 1900);
        }
        // The server lists days up to "today" in the user's time zone (mgr_tz
        // cookie). If it didn't know the zone yet, store it and reload once.
        function ensureLocalToday() {
            var el = document.getElementById('filterControlsContent');
            if (!el || !el.dataset.today) return false;
            var n = new Date();
            var local = n.getFullYear() + '-' + String(n.getMonth() + 1).padStart(2, '0') + '-' + String(n.getDate()).padStart(2, '0');
            if (el.dataset.today === local) return false;
            try {
                var tz = Intl.DateTimeFormat().resolvedOptions().timeZone;
                if (!tz || sessionStorage.getItem('att-tz-reload') === local) return false;
                document.cookie = 'mgr_tz=' + encodeURIComponent(tz) + '; path=/; max-age=31536000; SameSite=Lax';
                sessionStorage.setItem('att-tz-reload', local);
                location.reload();
                return true;
            } catch (e) { return false; }
        }
        function initAttendanceRange() {
            if (ensureLocalToday()) return;
            var select = document.getElementById('dateFilter');
            if (!select) return;
            select.value = readSavedRange() || defaultRange();
            var note = document.getElementById('attMissedNote');
            if (note && !note.dataset.bound) {
                note.dataset.bound = '1';
                note.addEventListener('click', function (e) {
                    var day = e.target.closest('.att-missed-day');
                    if (day) return goToDay(day.dataset.date);
                    if (e.target.closest('.att-missed-close')) {
                        try { sessionStorage.setItem(missedHiddenKey(), missedDays().join(',')); } catch (err) {}
                        note.hidden = true;
                    }
                });
            }
        }

        function resetFilters() {
            document.getElementById('nameSort').value = 'asc';
            document.getElementById('genderFilter').value = 'all';
            saveRange(null);
            document.getElementById('dateFilter').value = defaultRange();
            if (typeof syncAttendanceSortToggle === 'function') syncAttendanceSortToggle();
            applyFilters();
        }

        function toggleCalendarRules() {
            // legacy — no-op, pills replaced this
        }

        // Calendar info pill popovers
        (function () {
            const pillWraps = document.querySelectorAll('.cal-pill-wrap');
            pillWraps.forEach(function (wrap) {
                const btn = wrap.querySelector('.cal-pill');
                const popover = wrap.querySelector('.cal-pill-popover');
                if (!btn || !popover) return;
                btn.addEventListener('click', function (e) {
                    e.stopPropagation();
                    const isOpen = popover.classList.contains('open');
                    // close all others
                    document.querySelectorAll('.cal-pill-popover.open').forEach(function (p) {
                        p.classList.remove('open');
                    });
                    document.querySelectorAll('.cal-pill[aria-expanded="true"]').forEach(function (b) {
                        b.setAttribute('aria-expanded', 'false');
                    });
                    if (!isOpen) {
                        popover.classList.add('open');
                        btn.setAttribute('aria-expanded', 'true');
                    }
                });
            });
            document.addEventListener('click', function () {
                document.querySelectorAll('.cal-pill-popover.open').forEach(function (p) {
                    p.classList.remove('open');
                });
                document.querySelectorAll('.cal-pill[aria-expanded="true"]').forEach(function (b) {
                    b.setAttribute('aria-expanded', 'false');
                });
            });
        })();

        function toggleAttendanceSummary() {
            const content = document.getElementById('attendanceSummaryWrapper');
            if (!content) return;
            content.classList.toggle('collapsed-mobile');
        }

        // Auto-populate attendance summary
        function updateAttendanceSummary() {
            const rows = document.querySelectorAll('.attendance-sheet tbody tr');
            let maleCount = 0, femaleCount = 0;
            let malePresent = 0, femalePresent = 0;
            let maleAbsent = 0, femaleAbsent = 0;

            rows.forEach(row => {
                if (row.style.display === 'none') return; // Skip hidden rows
                
                const rowGender = row.dataset.gender.toLowerCase();
                
                if (rowGender === 'male') maleCount++;
                if (rowGender === 'female') femaleCount++;

                const checkboxes = row.querySelectorAll('input[type="checkbox"]');
                checkboxes.forEach(checkbox => {
                    if (checkbox.dataset.countable !== 'true') return;
                    const cell = checkbox.closest('td');
                    if (cell.style.display === 'none') return; // Skip hidden cells
                    
                    if (checkbox.checked) {
                        if (rowGender === 'male') malePresent++;
                        if (rowGender === 'female') femalePresent++;
                    } else if (checkbox.disabled) { // Only count as absent if attendance was recorded
                        if (rowGender === 'male') maleAbsent++;
                        if (rowGender === 'female') femaleAbsent++;
                    }
                });
            });

            // Update the summary table
            const summaryContainer = document.getElementById('attendance-summary');
            if (summaryContainer) {
                summaryContainer.innerHTML = `
                    <thead>
                        <tr><th>Students</th><th>Total</th><th>Days present</th><th>Days absent</th></tr>
                    </thead>
                    <tbody>
                        <tr><td>Male</td><td>${maleCount}</td><td>${malePresent}</td><td>${maleAbsent}</td></tr>
                        <tr><td>Female</td><td>${femaleCount}</td><td>${femalePresent}</td><td>${femaleAbsent}</td></tr>
                        <tr><td>Class</td><td>${maleCount + femaleCount}</td><td>${malePresent + femalePresent}</td><td>${maleAbsent + femaleAbsent}</td></tr>
                    </tbody>
                `;
            }
        }

        // Scroll attendance table so the most recent (rightmost) date is visible first
        function scrollAttendanceToEnd() {
            const container = document.querySelector('.attendance-sheet-container');
            if (container) {
                container.scrollLeft = container.scrollWidth;
            }
        }

        function formatLastEditedTime(value) {
            return new Date(value).toLocaleString('en-US', {
                month: 'numeric',
                day: 'numeric',
                year: 'numeric',
                hour: 'numeric',
                minute: '2-digit'
            });
        }

        function renderLastEdited(element, value) {
            if (!element || !value) return;
            var hoverTime = formatLastEditedTime(value);
            element.classList.add('has-tooltip');
            element.innerHTML = ''
                + '<span class="last-edited-icon" aria-hidden="true">'
                + '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="10" height="10"><circle cx="12" cy="12" r="9"></circle><path d="M12 7v5l3 2"></path></svg>'
                + '</span>'
                + '<span class="last-edited-text">Last edited</span>'
                + '<span class="last-edited-hover-date" role="tooltip">' + hoverTime + '</span>';
        }

        document.addEventListener('DOMContentLoaded', () => {
            const classId = '<%= classId %>';
            const termId = '<%= termId %>';
            const calendarRulesContent = document.getElementById('calendarRulesContent');
            const attendanceSummaryWrapper = document.getElementById('attendanceSummaryWrapper');
            const nameSortToggle = document.getElementById('nameSortToggle');
            const attendanceHeaderSortToggle = document.getElementById('attendanceHeaderSortToggle');
            const nameSortInput = document.getElementById('nameSort');

            document.addEventListener('click', function (event) {
                const trigger = event.target.closest('.last-edited.has-tooltip');
                if (!trigger) {
                    document.querySelectorAll('.last-edited.has-tooltip.is-open').forEach(function (node) {
                        node.classList.remove('is-open');
                    });
                    return;
                }

                const alreadyOpen = trigger.classList.contains('is-open');
                document.querySelectorAll('.last-edited.has-tooltip.is-open').forEach(function (node) {
                    node.classList.remove('is-open');
                });
                if (!alreadyOpen) {
                    trigger.classList.add('is-open');
                }
            });

            syncAttendanceSortToggle();
            if (nameSortToggle && nameSortInput) {
                nameSortToggle.addEventListener('click', function() {
                    nameSortInput.value = nameSortInput.value === 'asc' ? 'desc' : 'asc';
                    syncAttendanceSortToggle();
                    applyFilters();
                });
            }
            ['genderFilter', 'dateFilter'].forEach(function (id) {
                const field = document.getElementById(id);
                if (field) field.addEventListener('change', function () {
                    if (id === 'dateFilter') {
                        if (ATT_RANGES[field.value]) saveRange(field.value);
                        return applyDateColumns();
                    }
                    applyFilters();
                });
            });
            if (attendanceHeaderSortToggle && nameSortInput) {
                attendanceHeaderSortToggle.addEventListener('click', function() {
                    nameSortInput.value = nameSortInput.value === 'asc' ? 'desc' : 'asc';
                    syncAttendanceSortToggle();
                    applyFilters();
                });
            }

            if (attendanceSummaryWrapper && window.matchMedia('(min-width: 769px)').matches) {
                attendanceSummaryWrapper.classList.remove('collapsed-mobile');
            }

            // Scroll to the right immediately so current date shows first
            scrollAttendanceToEnd();

            fetch(`/common/getAttendanceForClass?classId=${classId}&termId=${termId}`)
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        const attendanceMap = {};
                        const lastEditedMap = {};

                        data.attendance.forEach(record => {
                            if (!attendanceMap[record.student_id]) {
                                attendanceMap[record.student_id] = {};
                            }
                            attendanceMap[record.student_id][record.date] = record.status;

                            if (record.updated_at) {
                                lastEditedMap[record.date] = record.updated_at;
                            }
                        });

                        const students = document.querySelectorAll('.attendance-sheet tbody tr');
                        students.forEach(student => {
                            const studentId = student.querySelector('td').dataset.studentId;
                            const dates = student.querySelectorAll('td input[type="checkbox"]');
                            dates.forEach(dateCheckbox => {
                                const date = dateCheckbox.dataset.date;
                                if (attendanceMap[studentId] && attendanceMap[studentId][date]) {
                                    dateCheckbox.checked = attendanceMap[studentId][date] === 'Present';
                                    dateCheckbox.disabled = true;
                                }
                            });
                        });

                        Object.keys(lastEditedMap).forEach(date => {
                            const lastEditedElement = document.getElementById(`last-edited-${date}`);
                            if (lastEditedElement) {
                                renderLastEdited(lastEditedElement, lastEditedMap[date]);
                            }
                        });

                        // Auto-populate attendance summary on page load
                        setTimeout(updateAttendanceSummary, 100);
                        // Scroll again after attendance data renders
                        setTimeout(scrollAttendanceToEnd, 150);
                    } else {
                        console.error('Failed to fetch attendance:', data.error);
                    }
                })
                .catch(error => {
                    console.error('Error fetching attendance:', error);
                });
        });

        function toggleEditSaveMode(date) {
            const checkboxes = document.querySelectorAll(`input[data-date='${date}']`);
            const link = document.querySelector(`.edit-save-link[data-date='${date}']`);
            const cancelLink = document.querySelector(`.cancel-link[data-date='${date}']`);
            const markAllLink = document.querySelector(`.mark-all-link[data-date='${date}']`);

            if (link.textContent === 'Save') {
                saveAttendanceForDate(date, checkboxes, link);
            } else if (link.textContent === 'Edit') {
                saveOriginalStates(date, checkboxes);
                checkboxes.forEach(checkbox => {
                    checkbox.disabled = false;
                });
                link.textContent = 'Save';
                cancelLink.style.display = 'block';
                if (markAllLink) markAllLink.style.display = 'block';
            }
        }

        function markAllPresentForDate(date) {
            const checkboxes = document.querySelectorAll(`input[data-date='${date}']`);
            checkboxes.forEach(checkbox => {
                if (checkbox.dataset.countable === 'true' && !checkbox.disabled) {
                    checkbox.checked = true;
                }
            });
            setTimeout(updateAttendanceSummary, 10);
        }

        function saveAttendanceForDate(date, checkboxes, link) {
            const attendanceData = {};
            const classId = '<%= classId %>';
            const termId = '<%= termId %>';

            checkboxes.forEach(checkbox => {
                attendanceData[checkbox.dataset.studentId] = checkbox.checked ? 'Present' : 'Absent';
            });

            fetch('/common/saveSingleAttendance', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                },
                body: JSON.stringify({ attendance: attendanceData, classId, termId, date })
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    alert(`Attendance for ${date} saved successfully!`);
                    link.textContent = 'Edit';
                    checkboxes.forEach(checkbox => {
                        checkbox.disabled = true;
                    });
                    const cancelLink = document.querySelector(`.cancel-link[data-date='${date}']`);
                    cancelLink.style.display = 'none';
                    const markAllLink = document.querySelector(`.mark-all-link[data-date='${date}']`);
                    if (markAllLink) markAllLink.style.display = 'none';

                    const lastEditedElement = document.getElementById(`last-edited-${date}`);
                    if (lastEditedElement) {
                        renderLastEdited(lastEditedElement, new Date());
                    }

                    // Update attendance summary after saving
                    setTimeout(updateAttendanceSummary, 50);
                } else {
                    console.error('Failed to save attendance:', data.error);
                    alert(data.message || 'Failed to save attendance. Please try again.');
                }
            })
            .catch(error => {
                console.error('Error saving attendance:', error);
                alert('Failed to save attendance. Please try again.');
            });
        }

        function saveOriginalStates(date, checkboxes) {
            originalStates[date] = {};
            checkboxes.forEach(checkbox => {
                originalStates[date][checkbox.dataset.studentId] = checkbox.checked;
            });
        }

        function restoreOriginalStates(date, checkboxes) {
            checkboxes.forEach(checkbox => {
                checkbox.checked = originalStates[date][checkbox.dataset.studentId];
                checkbox.disabled = true;
            });
        }

        function cancelEditMode(date) {
            const checkboxes = document.querySelectorAll(`input[data-date='${date}']`);
            restoreOriginalStates(date, checkboxes);
            const link = document.querySelector(`.edit-save-link[data-date='${date}']`);
            link.textContent = 'Edit';
            const cancelLink = document.querySelector(`.cancel-link[data-date='${date}']`);
            cancelLink.style.display = 'none';
            const markAllLink = document.querySelector(`.mark-all-link[data-date='${date}']`);
            if (markAllLink) markAllLink.style.display = 'none';
        }


            var originalRows = window.__attendanceOriginalRows || [];
            window.__attendanceOriginalRows = originalRows;
            
            document.addEventListener('DOMContentLoaded', () => {
                const tbody = document.querySelector('.attendance-sheet tbody');
                originalRows.length = 0;
                originalRows.push(...tbody.querySelectorAll('tr'));
                initAttendanceRange();
                applyDateColumns();
            });

            // Shows only the chosen days, keeping the rows in their order.
            function applyDateColumns() {
                const selected = document.getElementById('dateFilter').value;
                const visibleDates = datesForRange(selected);
                const singleDay = selected.indexOf('date:') === 0;
                document.querySelectorAll('.attendance-sheet [data-date]').forEach(function (el) {
                    const cell = el.tagName === 'TH' ? el : el.closest('td');
                    if (cell && (el.tagName === 'TH' || el.tagName === 'INPUT')) cell.style.display = visibleDates.has(el.dataset.date) ? '' : 'none';
                });
                document.querySelectorAll('.attendance-sheet .overall-attendance').forEach(function (el) { el.style.display = singleDay ? 'none' : ''; });
                showMissedNote();
                setTimeout(updateAttendanceSummary, 50);
                updateFilterState();
            }

            function syncAttendanceSortToggle() {
                const sortInput = document.getElementById('nameSort');
                const toggles = [document.getElementById('nameSortToggle'), document.getElementById('attendanceHeaderSortToggle')].filter(Boolean);
                if (!sortInput || !toggles.length) return;
                const direction = sortInput.value === 'desc' ? 'desc' : 'asc';
                toggles.forEach(function(toggle) {
                    toggle.setAttribute('data-sort-direction', direction);
                    toggle.setAttribute('aria-label', direction === 'asc' ? 'Sort names Z to A' : 'Sort names A to Z');
                });
            }
            
            function applyFilters() {
                const sort = document.getElementById('nameSort').value;
                const gender = document.getElementById('genderFilter').value.toLowerCase();
                const selectedDate = document.getElementById('dateFilter').value;
                const visibleDates = datesForRange(selectedDate);
                const singleDay = selectedDate.indexOf('date:') === 0;
                
                const tbody = document.querySelector('.attendance-sheet tbody');
                tbody.innerHTML = '';
            
                // Sort by gender THEN name
                const filtered = [...originalRows]
                    .filter(row => {
                        const rowGender = row.dataset.gender.toLowerCase();
                        return gender === 'all' || rowGender === gender;
                    })
                    .sort((a, b) => {
                        const genderA = a.dataset.gender;
                        const genderB = b.dataset.gender;
                        if (genderA !== genderB) return genderA.localeCompare(genderB);
            
                        const nameA = a.dataset.name;
                        const nameB = b.dataset.name;
                        return sort === 'asc' ? nameA.localeCompare(nameB) : nameB.localeCompare(nameA);
                    });
            
                filtered.forEach(row => {
                    const checkboxes = row.querySelectorAll('input[type="checkbox"]');
                    checkboxes.forEach(checkbox => {
                        const cell = checkbox.closest('td');
                        cell.style.display = visibleDates.has(checkbox.dataset.date) ? '' : 'none';
                    });
            
                    // Show/hide overall attendance
                    const overallCell = row.querySelector('.overall-attendance');
                    if (overallCell) {
                        overallCell.style.display = singleDay ? 'none' : '';
                    }
            
                    tbody.appendChild(row);
                });
            
                // Update <thead> columns (show only selected date if filtering)
                const dateHeaders = Array.from(document.querySelectorAll('.attendance-sheet thead th[data-date]'));
                dateHeaders.forEach(th => {
                    const headerDate = th.dataset.date;
                    th.style.display = visibleDates.has(headerDate) ? '' : 'none';
                });
            
                const overallTh = document.querySelector('.attendance-sheet thead .overall-attendance');
                if (overallTh) {
                    overallTh.style.display = singleDay ? 'none' : '';
                }
                showMissedNote();
            
                // Auto-update attendance summary
                setTimeout(updateAttendanceSummary, 50);
                updateFilterState();
            }

            
            </script>
            