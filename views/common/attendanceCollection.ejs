                <% if (locals.notesOn) { %>
    <script nonce="<%= locals.cspNonce || '' %>">
    // A reason for an absence: a small note button beside an absent student's day (once the notes column exists). On a
    // day being edited it goes with the day's Save; on a saved day it saves by itself, so a reason can be added later.
    (function () {
        var sheet = document.querySelector('.attendance-sheet');
        if (!sheet) return;
        var CLASS_ID = '<%= classId %>', TERM_ID = '<%= termId %>';
        var byStudent = <%- JSON.stringify(locals.notesMap || {}) %>;
        var LATE_ON = <%- JSON.stringify(Boolean(locals.lateOn)) %>;
        var lateByStudent = <%- JSON.stringify(locals.latesMap || {}) %>;
        var savedLate = {}, currentLate = {};
        Object.keys(lateByStudent).forEach(function (id) { Object.keys(lateByStudent[id]).forEach(function (d) { (savedLate[d] = savedLate[d] || {})[id] = true; }); });
        Object.keys(savedLate).forEach(function (d) { currentLate[d] = Object.assign({}, savedLate[d]); });
        var saved = {}, current = {}, committing = {};
        Object.keys(byStudent).forEach(function (id) { Object.keys(byStudent[id]).forEach(function (d) { (saved[d] = saved[d] || {})[id] = byStudent[id][d]; }); });
        Object.keys(saved).forEach(function (d) { current[d] = Object.assign({}, saved[d]); });
        var ICON = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 4h14a1 1 0 0 1 1 1v10a1 1 0 0 1-1 1h-8l-5 4v-4H5a1 1 0 0 1-1-1V5a1 1 0 0 1 1-1z"/><path d="M8 9h8M8 12h5"/></svg>';
        var REASONS = ['Sick', 'Family matter', 'Medical appointment', 'Left early', 'Came late', 'Travel'];
        function editing(date) { var ed = sheet.querySelector('.edit-save-link[data-date="' + date + '"]'); return !!ed && ed.textContent.trim() === 'Save'; }
        // A day is open (nobody marked it yet) when its boxes aren't locked and it isn't being edited.
        function locked(date) { var b = sheet.querySelector('tbody input[data-date="' + date + '"][data-countable="true"]'); return !!b && b.disabled && !editing(date); }
        function noteOf(date, id) { return (current[date] || {})[id] || ''; }
        function lateOf(date, id) { return Boolean((currentLate[date] || {})[id]); }

        // One button per countable day cell, beside the box (and the lunch plate, where there is one).
        var buttons = [];
        sheet.querySelectorAll('tbody input[type="checkbox"][data-date][data-countable="true"]').forEach(function (box) {
            var btn = document.createElement('button');
            btn.type = 'button'; btn.className = 'att-note-btn'; btn.innerHTML = ICON;
            btn.dataset.date = box.dataset.date; btn.dataset.student = box.dataset.studentId;
            btn.setAttribute('aria-label', 'Note for this day');
            var pair = box.parentNode;
            if (!pair.classList.contains('att-pair')) { var wrap = document.createElement('span'); wrap.className = 'att-pair'; pair.insertBefore(wrap, box); wrap.appendChild(box); pair = wrap; }
            pair.appendChild(btn);
            buttons.push({ btn: btn, box: box });
        });
        function refresh() {
            buttons.forEach(function (x) {
                var text = noteOf(x.btn.dataset.date, x.btn.dataset.student);
                var late = LATE_ON && x.box.checked && lateOf(x.btn.dataset.date, x.btn.dataset.student);
                x.btn.classList.toggle('has-note', Boolean(text) || Boolean(late));
                x.btn.classList.toggle('is-late', Boolean(late));
                x.btn.title = (late ? 'Late' : '') + (late && text ? ' · ' : '') + (text ? 'Note: ' + text : '') || 'Add a note for this day';
            });
        }

        // The pop-up.
        var pop = null, popFor = null;
        function closePop() { if (pop) { pop.remove(); pop = null; popFor = null; } }
        function open(btn) {
            closePop();
            var date = btn.dataset.date, id = btn.dataset.student;
            var dayBox = sheet.querySelector('tbody input[data-date="' + date + '"][data-student-id="' + id + '"]');
            var row = btn.closest('tr'), nameCell = row && row.querySelector('td.student-name');
            var name = nameCell ? nameCell.textContent.replace(/\s+/g, ' ').trim() : 'Student';
            var when = new Date(date + 'T12:00:00');
            pop = document.createElement('div'); pop.className = 'att-note-pop'; pop.setAttribute('role', 'dialog'); pop.setAttribute('aria-label', 'Note for this day');
            var h = document.createElement('h4'); h.textContent = 'Note';
            var sub = document.createElement('small'); sub.textContent = name + ' · ' + (isNaN(when) ? date : when.toLocaleDateString('en-US', { weekday: 'short', month: 'short', day: 'numeric' }));
            var lateRow = null, lateBox = null;
            if (LATE_ON) {
                lateRow = document.createElement('label'); lateRow.className = 'att-late';
                lateBox = document.createElement('input'); lateBox.type = 'checkbox'; lateBox.checked = lateOf(date, id);
                var lateText = document.createElement('span'); lateText.textContent = 'Arrived late';
                lateRow.appendChild(lateBox); lateRow.appendChild(lateText);
                // Only a student who came can be late.
                var present = dayBox && dayBox.checked;
                if (!present) { lateBox.checked = false; lateBox.disabled = true; lateRow.title = 'Mark the student present first'; lateRow.classList.add('is-off'); }
            }
            var chips = document.createElement('div'); chips.className = 'att-chips';
            var ta = document.createElement('textarea'); ta.maxLength = 300; ta.placeholder = 'Add a note (optional)'; ta.value = noteOf(date, id); ta.setAttribute('aria-label', 'Note');
            REASONS.forEach(function (r) { var c = document.createElement('button'); c.type = 'button'; c.textContent = r; c.addEventListener('click', function () { ta.value = r; if (lateBox && !lateBox.disabled && r === 'Came late') lateBox.checked = true; if (lateBox && !lateBox.disabled && r !== 'Came late' && lateBox.checked && r === 'Left early') { /* left early after arriving late: both can be true */ } ta.focus(); }); chips.appendChild(c); });
            var actions = document.createElement('div'); actions.className = 'att-actions';
            var clear = document.createElement('button'); clear.type = 'button'; clear.className = 'att-clear'; clear.textContent = 'Clear';
            var count = document.createElement('span'); count.className = 'att-count';
            var save = document.createElement('button'); save.type = 'button'; save.className = 'att-save'; save.textContent = 'Save note';
            function tally() { count.textContent = ta.value.length + '/300'; }
            ta.addEventListener('input', tally); tally();
            actions.appendChild(clear); actions.appendChild(count); actions.appendChild(save);
            pop.appendChild(h); pop.appendChild(sub); if (lateRow) pop.appendChild(lateRow); pop.appendChild(chips); pop.appendChild(ta); pop.appendChild(actions);
            // The pop-up sits on the page, outside the sheet: it brings the sheet's colour with it.
            var sheetStyle = getComputedStyle(sheet);
            pop.style.setProperty('--att-accent', sheetStyle.getPropertyValue('--att-accent') || '#01535b');
            document.body.appendChild(pop); popFor = btn;
            var r = btn.getBoundingClientRect(), w = pop.offsetWidth, hgt = pop.offsetHeight;
            var left = Math.max(8, Math.min(r.left + r.width / 2 - w / 2, window.innerWidth - w - 8));
            var top = r.bottom + 8; if (top + hgt > window.innerHeight - 8) top = Math.max(8, r.top - hgt - 8);
            pop.style.left = left + 'px'; pop.style.top = top + 'px';
            // The page can be zoomed (wide screens) or wider than the phone: settle the pop-up by where it really landed.
            var box = pop.getBoundingClientRect(), z = pop.offsetWidth ? box.width / pop.offsetWidth : 1, vw = document.documentElement.clientWidth, vh = window.innerHeight;
            if (box.right > vw - 8) pop.style.left = (parseFloat(pop.style.left) - (box.right - (vw - 8)) / z) + 'px';
            box = pop.getBoundingClientRect();
            if (box.left < 8) pop.style.left = (parseFloat(pop.style.left) + (8 - box.left) / z) + 'px';
            if (box.bottom > vh - 8) pop.style.top = Math.max(8 / z, parseFloat(pop.style.top) - (box.bottom - (vh - 8)) / z) + 'px';
            ta.focus();
            function commit(text) {
                var late = Boolean(lateBox && lateBox.checked);
                (current[date] = current[date] || {})[id] = text;
                if (!text) delete current[date][id];
                (currentLate[date] = currentLate[date] || {})[id] = late;
                if (!late) delete currentLate[date][id];
                if (editing(date)) { refresh(); closePop(); if (window.attToast) window.attToast(text || late ? 'Added. It saves with the day.' : 'Note cleared'); return; }
                // A day nobody has marked yet: writing a note starts editing it (the note goes with the day's Save).
                if (!locked(date)) {
                    refresh(); closePop();
                    if ((text || late) && window.toggleEditSaveMode) window.toggleEditSaveMode(date);
                    if (window.attToast) window.attToast(text || late ? 'Added. Mark the day and save it.' : 'Note cleared');
                    return;
                }
                // A saved day: this one note saves now, with the student's mark as it is.
                save.disabled = true; save.textContent = 'Saving…';
                var attendance = {}; attendance[id] = dayBox && dayBox.checked ? 'Present' : 'Absent';
                var notes = {}; notes[id] = text; var lates = {}; if (late && attendance[id] === 'Present') lates[id] = true;
                fetch('/common/saveSingleAttendance', { method: 'POST', headers: { 'Content-Type': 'application/json', Accept: 'application/json' }, body: JSON.stringify({ attendance: attendance, classId: CLASS_ID, termId: TERM_ID, date: date, notes: notes, lates: LATE_ON ? lates : undefined }) })
                    .then(function (r) { return r.json(); }).then(function (d) {
                        if (!d.success) throw new Error(d.message || 'Not saved');
                        (saved[date] = saved[date] || {})[id] = text; if (!text) delete saved[date][id];
                        (savedLate[date] = savedLate[date] || {})[id] = late; if (!late) delete savedLate[date][id];
                        refresh(); closePop(); if (window.attToast) window.attToast(text || late ? 'Saved' : 'Note cleared');
                    }).catch(function () {
