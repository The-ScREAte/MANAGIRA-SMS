                        currentLate[date][id] = Boolean((savedLate[date] || {})[id]); if (!currentLate[date][id]) delete currentLate[date][id];
                        save.disabled = false; save.textContent = 'Save note'; if (window.attToast) window.attToast('The note was not saved. Try again.');
