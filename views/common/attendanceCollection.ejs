        .attendance-sheet td input[type="checkbox"][data-date]:focus-visible, .attendance-sheet .check-all-box:focus-visible, .attendance-sheet .att-plate-btn:focus-visible { outline: 2px solid var(--att-accent); outline-offset: 2px; }
        .attendance-sheet td input[type="checkbox"][data-date]:disabled { cursor: default; }
        .attendance-sheet td input[type="checkbox"][data-date]:disabled:checked { opacity: .82; }
