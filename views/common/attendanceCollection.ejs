        // Auto-populate attendance summary
        function updateAttendanceSummary() {
            const rows = document.querySelectorAll('.attendance-sheet tbody tr');
            let maleCount = 0, femaleCount = 0;
            let malePresent = 0, femalePresent = 0;
            let maleAbsent = 0, femaleAbsent = 0;
            // Lunch, when the school takes it: plates chosen on the days shown.
            const LUNCH = <%= locals.lunchOn ? 'true' : 'false' %>;
            let maleLunch = 0, femaleLunch = 0;

            rows.forEach(row => {
                if (row.style.display === 'none') return; // Skip hidden rows
                
                const rowGender = row.dataset.gender.toLowerCase();
                
                if (rowGender === 'male') maleCount++;
                if (rowGender === 'female') femaleCount++;

                const checkboxes = row.querySelectorAll('input[type="checkbox"]');
                checkboxes.forEach(checkbox => {
                    if (checkbox.dataset.countable !== 'true') return;
                    const cell = checkbox.closest('td');
                    if (cell.style.display === 'none') return; // Skip hidden cells
                    
                    if (checkbox.checked) {
                        if (rowGender === 'male') malePresent++;
                        if (rowGender === 'female') femalePresent++;
                    } else if (checkbox.disabled) { // Only count as absent if attendance was recorded
                        if (rowGender === 'male') maleAbsent++;
                        if (rowGender === 'female') femaleAbsent++;
                    }
                });
                if (LUNCH) {
                    row.querySelectorAll('.lunch-pick[data-v="yes"]').forEach(pick => {
                        const cell = pick.closest('td');
                        if (cell && cell.style.display === 'none') return;
                        if (rowGender === 'male') maleLunch++;
                        if (rowGender === 'female') femaleLunch++;
                    });
                }
            });

            // Update the summary table
            const summaryContainer = document.getElementById('attendance-summary');
            if (summaryContainer) {
                const lunchTh = LUNCH ? '<th>Had lunch</th>' : '';
                const lunchTd = (n) => (LUNCH ? `<td>${n}</td>` : '');
                summaryContainer.innerHTML = `
                    <thead>
                        <tr><th>Students</th><th>Total</th><th>Days present</th><th>Days absent</th>${lunchTh}</tr>
                    </thead>
                    <tbody>
                        <tr><td>Male</td><td>${maleCount}</td><td>${malePresent}</td><td>${maleAbsent}</td>${lunchTd(maleLunch)}</tr>
                        <tr><td>Female</td><td>${femaleCount}</td><td>${femalePresent}</td><td>${femaleAbsent}</td>${lunchTd(femaleLunch)}</tr>
                        <tr><td>Class</td><td>${maleCount + femaleCount}</td><td>${malePresent + femalePresent}</td><td>${maleAbsent + femaleAbsent}</td>${lunchTd(maleLunch + femaleLunch)}</tr>
                    </tbody>
                `;
            }
        }

        // Today is the far-right column: scroll the sheet to its end so today is in view.
