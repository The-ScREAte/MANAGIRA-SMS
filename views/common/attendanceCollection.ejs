<style>
      :root {
        --font-family: "<%= (session && session.fontStyle ? String(session.fontStyle).trim() : 'Inter') %>", sans-serif;
                --primary: var(--org-primary-color, #01535b);
                --primary-hover: var(--org-primary-hover, #014a51);
        --primary-hover-fill: color-mix(in srgb, var(--primary) 88%, white);
                --border: #e5e7eb;
                --bg: #f8fafc;
      }


    body {
        font-family: var(--font-family);
                background: var(--bg);
                min-height: 100vh;
                display: flex;
                flex-direction: column;
      }

        main {
            flex: 1 0 auto;
            width: 100%;
        }
 
        .attendance-page {
            max-width: <%= isEmbedded ? 'none' : '1200px' %>;
            margin: 0 auto;
            padding: <%= isEmbedded ? '0 0 18px' : '16px 16px 40px' %>;
            width: 100%;
            box-sizing: border-box;
        }

        .attendance-summary-line {
            margin: 4px 0 0;
            color: #475569;
            font-size: <%= isEmbedded ? '0.8rem' : '0.9rem' %>;
            line-height: 1.45;
        }

        .attendance-meta {
            margin-top: <%= isEmbedded ? '4px' : '6px' %>;
            color: #475569;
            font-size: <%= isEmbedded ? '0.82rem' : '0.95rem' %>;
        }

        .attendance-meta-inline {
            display: flex;
            flex-wrap: wrap;
            justify-content: flex-start;
            gap: 5px 8px;
            margin-top: 5px;
        }

        .attendance-meta-inline.compact {
            gap: 4px 8px;
            margin-top: 4px;
            color: #475569;
            font-size: 0.78rem;
            font-weight: 500;
        }

        .attendance-meta-inline.compact .attendance-meta-text {
            white-space: nowrap;
        }

        .attendance-meta-pill {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 4px 9px;
            border-radius: 999px;
            background: #f8fafc;
            border: 1px solid #e2e8f0;
            color: #334155;
            font-size: <%= isEmbedded ? '0.75rem' : '0.82rem' %>;
            font-weight: 600;
        }

        .attendance-calendar-meta {
            display: flex;
            flex-wrap: wrap;
            justify-content: flex-start;
            gap: 5px 8px;
            margin-top: 6px;
        }

        .attendance-calendar-note {
            margin-top: 6px;
            color: #334155;
            font-size: <%= isEmbedded ? '0.74rem' : '0.88rem' %>;
        }

        .attendance-calendar-note.compact {
            margin-top: 4px;
            font-size: 0.76rem;
            color: #475569;
        }

        .calendar-rules-toggle {
            display: none;
        }

        .sort-toggle-btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 16px;
            height: 16px;
            padding: 0;
            border: none;
            background: transparent;
            color: var(--primary);
            cursor: pointer;
            opacity: 0.78;
        }

        .sort-toggle-btn:hover,
        .sort-toggle-btn:focus,
        .sort-toggle-btn:active,
        .sort-toggle-btn:focus-visible {
            background: transparent !important;
            box-shadow: none !important;
            outline: none;
            color: var(--primary);
        }

        .sort-toggle-btn svg {
            width: 10px;
            height: 10px;
        }

        .cal-pill-popover {
            display: none;
            position: absolute;
            top: calc(100% + 6px);
            left: 0;
            min-width: 160px;
            max-width: 240px;
            background: #fff;
            border: 1px solid var(--border);
            border-radius: 10px;
            box-shadow: 0 8px 24px rgba(15,23,42,0.13);
            padding: 10px 13px;
            z-index: 200;
        }

        .cal-pill-popover.open {
            display: block;
        }

        .cal-popover-label {
            margin: 0 0 3px;
            font-size: 0.68rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            color: #94a3b8;
        }

        .cal-popover-value {
            margin: 0;
            font-size: 0.82rem;
            color: #0f172a;
            font-weight: 500;
            line-height: 1.4;
        }

        .attendance-summary-toggle {
            display: none;
            margin: 12px auto 0;
            background: #e5f5f7;
            color: var(--primary);
            border: 1px solid #b7e1e8;
            border-radius: 8px;
            padding: 6px 10px;
            font-size: 0.82rem;
            font-weight: 600;
            cursor: pointer;
        }

        .attendance-summary-wrapper {
            display: block;
        }
      
</style>
<style>
    /* === Date Header & Action Links === */
    .attendance-sheet thead th {
        font-size: 0.68rem;
        padding: 4px 6px;
        line-height: 1.15;
    }
    .date-header {
        display: flex;
        flex-direction: column;
        align-items: center;
        font-size: 0.65rem;
        line-height: 1.2;
        gap: 1px;
    }
    .day-name {
        font-size: 0.62rem;
        font-weight: 700;
        color: var(--primary);
        text-transform: uppercase;
        letter-spacing: 0.02em;
        margin-bottom: 1px;
    }
    .day-name .day-full { display: inline; }
    .day-name .day-short { display: none; }
    .edit-save-link,
    .cancel-link,
    .mark-all-link {
        font-size: 0.62rem;
        cursor: pointer;
        text-decoration: underline;
        margin-top: 2px;
        color: var(--primary);
    }
    .cancel-link {
        color: red;
    }
    .mark-all-link {
        color: #0f5a66;
    }
    .last-edited {
        font-size: 0.56rem;
        color: gray;
        line-height: 1.1;
        margin-top: 2px;
        display: inline-flex;
        align-items: center;
        white-space: nowrap;
        max-width: none;
        min-height: 0;
        position: relative;
    }

    .last-edited.has-tooltip {
        cursor: pointer;
    }

    .last-edited-icon {
        display: inline-block;
        width: 10px;
        height: 10px;
        vertical-align: -1px;
        margin-right: 3px;
        color: #94a3b8;
    }

    .last-edited-text {
        display: inline;
    }

    .last-edited-hover-date {
        display: none;
        position: absolute;
        left: auto;
        right: 0;
        bottom: calc(100% + 5px);
        transform: none;
        background: #0f172a;
        color: #fff;
        padding: 4px 6px;
        border-radius: 6px;
        font-size: 0.58rem;
        line-height: 1.2;
        white-space: normal;
        max-width: 130px;
        text-align: left;
        z-index: 30;
        box-shadow: 0 6px 18px rgba(15, 23, 42, 0.22);
        pointer-events: none;
    }

    .last-edited.has-tooltip:hover .last-edited-hover-date,
    .last-edited.has-tooltip.is-open .last-edited-hover-date {
        display: inline-block;
    }

    /* === Today Column Highlight === */
    .today-col {
        background-color: #e8f7f8 !important;
        border-left: 2px solid var(--primary) !important;
        border-right: 2px solid var(--primary) !important;
    }
    .attendance-sheet thead .today-col {
        background-color: #d0eff2 !important;
    }
    
    /* === Overall Attendance Style === */
    .overall-attendance {
        font-weight: bold;
    }
    
    /* === Center Back Link === */
    .center-link {
        display: flex;
        justify-content: center;
        margin-bottom: 20px;
    }

    .link-to-next-back {
        padding-top: 10px;
    }
    
    /* === Attendance Table === */
    .attendance-sheet-container {
        padding: <%= isEmbedded ? '0' : '16px 0' %>;
        margin: <%= isEmbedded ? '6px 0 0' : '30px auto' %>;
        background: <%= isEmbedded ? 'transparent' : '#fff' %>;
        border: <%= isEmbedded ? 'none' : '1px solid var(--border)' %>;
        border-radius: <%= isEmbedded ? '0' : '12px' %>;
        box-shadow: <%= isEmbedded ? 'none' : '0 4px 14px rgba(15, 23, 42, 0.04)' %>;
        max-width: 100%;
        overflow-x: auto;
        box-sizing: border-box;
        width: 100%;
    }
    .attendance-sheet {
        border-collapse: collapse;
        width: 100%;
        min-width: max-content;
        background: #fff;
        margin: 0;
    }
    .attendance-sheet th,
    .attendance-sheet td {
        border: 1px solid #ddd;
        padding: 10px 14px !important;
        text-align: center;
        vertical-align: middle;
        background: #fff;
        white-space: nowrap;
        color: #333;
    }
    .attendance-sheet th.date-col-excluded {
        background: #fff;
    }
    .attendance-sheet td.inactive-day-cell {
        position: relative;
        background: #f8fafc;
        overflow: hidden;
    }
    .inactive-watermark {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%) rotate(-34deg);
        font-size: 0.46rem;
        font-weight: 700;
        color: rgba(148, 163, 184, 0.62);
        letter-spacing: 0.08em;
        text-transform: uppercase;
        pointer-events: none;
        white-space: normal;
        text-align: center;
        width: 90%;
        line-height: 1.05;
        overflow-wrap: anywhere;
        word-break: break-word;
    }

    .inactive-watermark.paired-watermark {
        top: 50%;
        width: 92%;
        transform: translate(-50%, -50%) rotate(-10deg);
        font-size: 0.52rem;
        opacity: 0.95;
        z-index: 4;
        letter-spacing: 0.03em;
        line-height: 1.1;
    }

    .term-end-watermark {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%) rotate(-34deg);
        font-size: 0.45rem;
        font-weight: 700;
        color: rgba(148, 163, 184, 0.62);
        letter-spacing: 0.08em;
        text-transform: uppercase;
        pointer-events: none;
        white-space: normal;
        text-align: center;
        width: 90%;
        line-height: 1.1;
    }

    .term-end-watermark.paired-watermark {
        top: 50%;
        width: 92%;
        transform: translate(-50%, -50%) rotate(-10deg);
        font-size: 0.52rem;
        z-index: 4;
        letter-spacing: 0.03em;
        line-height: 1.1;
    }

    .attendance-sheet th.term-end-col {
        background: #fff;
    }

    .attendance-sheet td.term-end-cell {
        position: relative;
    }

    .attendance-sheet td.inactive-day-cell,
    .attendance-sheet td.term-end-cell {
        overflow: visible;
    }
    .attendance-sheet input.attendance-inactive {
        opacity: 0.45;
        pointer-events: none;
    }

    #attendance-summary {
        margin: 30px auto;
        padding: 20px;
        border: 1px solid #ddd;
        border-radius: 12px;
        background-color: #f9f9f9;
        max-width: 900px;
        width: 100%;
        font-size: 1rem;
        box-shadow: 0 2px 8px rgba(0,0,0,0.05);
    }
    
    /* Sticky Student Name — kept above the paired watermarks so any
       placeholder/marker text (e.g. EXCLUDED, OFFICIAL TERM END DATE)
       sits BELOW the student-name row, not on top of it. */
    .attendance-sheet .student-name {
        position: sticky;
        left: 0;
        background-color: #f1f1f1;
        z-index: 6;
        min-width: 160px;
        max-width: 200px;
        text-align: left;
        padding-left: 8px;
        font-weight: 600;
        color: #000;
    }
    .attendance-sheet td.student-name {
        white-space: normal !important;
        overflow-wrap: anywhere;
        word-break: break-word;
        line-height: 1.25;
    }
    .attendance-sheet th.student-name {
        white-space: normal;
        overflow-wrap: anywhere;
    }
    .attendance-sheet thead .student-name { z-index: 7; }
    .inactive-watermark.paired-watermark,
    .term-end-watermark.paired-watermark { z-index: 3 !important; }

    .attendance-sheet th.overall-attendance,
    .attendance-sheet td.overall-attendance {
        min-width: 130px;
        text-align: center;
    }
    
    /* Sticky Header */
    .attendance-sheet thead th {
        position: sticky;
        top: 0;
        background-color: #f1f5f9;
        color: var(--primary);
        z-index: 1;
        font-weight: bold;
    }
    
    /* Hover */
    .attendance-sheet tbody tr:hover {
        background-color: #f9f9f9;
    }
    
    /* Checkbox Styling */
    .attendance-sheet input[type="checkbox"] {
        transform: scale(1.3);
    }
    
    /* === Responsive Layouts === */
    @media screen and (max-width: 768px) {
        /* === PAGE HEADER IMPROVEMENTS === */
        h1 {
            font-size: 1.3rem;
            text-align: center;
            margin: 10px 0;
            padding: 0 10px;
        }

        .link-to-next-back {
            text-align: center;
            margin: 10px 0;
        }

        .back-link {
            display: inline-block;
            padding: 6px 12px;
            background: var(--primary);
            color: white;
            text-decoration: none;
            border-radius: 6px;
            font-size: 0.82rem;
        }

        /* === TABLE CONTAINER IMPROVEMENTS === */
        .attendance-sheet-container {
            padding: 10px 0;
            margin: 10px auto;
            overflow-x: auto;
            -webkit-overflow-scrolling: touch; /* Smooth scrolling on iOS */
        }

        /* === TABLE IMPROVEMENTS === */
        .attendance-sheet {
                        font-size: 0.68rem;
            min-width: 600px; /* Ensure minimum width for horizontal scroll */
        }

        .attendance-sheet th,
        .attendance-sheet td {
                                        font-size: 0.64rem;
                    padding: 5px 3px !important;
                    min-width: 36px;
        }

        /* === STICKY COLUMN IMPROVEMENTS === */
        .attendance-sheet .student-name {
          min-width: 100px;
          max-width: 120px;
                                        font-size: 0.68rem;
          padding: 6px 4px !important;
          background-color: #f8f8f8;
                    border-right: 2px solid var(--primary);
        }

        /* === DATE HEADER IMPROVEMENTS === */
        .date-header {
            padding: 5px 2px;
            line-height: 1.2;
        }
        .day-name { font-size: 0.66rem; }
        .day-name .day-full { display: none; }
        .day-name .day-short { display: inline; }
      
                .edit-save-link,
                .cancel-link,
                .mark-all-link {
                    font-size: 0.62rem;
          padding: 2px 4px;
          margin-top: 2px;
        }
      
        .last-edited {
                    font-size: 0.56rem;
          margin-top: 2px;
        }

        /* === CHECKBOX IMPROVEMENTS === */
        .attendance-sheet input[type="checkbox"] {
            transform: scale(1.28);
            margin: 4px;
            min-width: 16px;
            min-height: 16px;
            cursor: pointer;
        }

        /* Larger tap target cell on mobile */
        .attendance-sheet td:not(.student-name):not(.overall-attendance) {
            min-width: 52px;
            padding: 10px 8px !important;
        }

        /* === OVERALL ATTENDANCE COLUMN === */
        .overall-attendance {
            min-width: 84px;
            max-width: 100px;
            font-size: 0.64rem;
            background-color: #e5f5f7;
            font-weight: bold;
            text-align: center !important;
            white-space: normal !important;
            overflow-wrap: anywhere;
            word-break: break-word;
            line-height: 1.2;
        }

        /* === SUMMARY TABLE IMPROVEMENTS === */
        #attendance-summary {
                    font-size: 0.76rem;
          padding: 15px 10px;
          margin: 20px 10px;
          border-radius: 8px;
        }

        #attendance-summary th {
            font-size: 0.84rem;
            padding: 8px;
        }

        #attendance-summary td {
            padding: 8px 6px;
            text-align: center;
        }

        /* === HORIZONTAL SCROLL INDICATOR === */
        .attendance-sheet-container::after {
            content: "← Scroll left to see older dates";
            display: block;
            text-align: center;
            font-size: 0.66rem;
            color: #666;
            margin-top: 5px;
            font-style: italic;
        }
      }
      
      @media screen and (max-width: 480px) {
        /* === EXTRA SMALL SCREEN OPTIMIZATIONS === */
        h1 {
            font-size: 1.1rem;
            margin: 8px 0;
            padding: 0 5px;
        }

        /* === ULTRA COMPACT TABLE === */
        .attendance-sheet {
            font-size: 0.62rem;
            min-width: 500px;
        }
      
        .attendance-sheet .student-name {
          min-width: 90px;
          max-width: 110px;
                                        font-size: 0.62rem;
          padding: 4px 3px !important;
        }
      
        .attendance-sheet th,
        .attendance-sheet td {
                                        font-size: 0.58rem;
                    padding: 3px 2px !important;
                    min-width: 32px;
        }

        /* === COMPACT DATE HEADERS === */
        .date-header {
            padding: 3px 1px;
        }
        .day-name { font-size: 0.58rem; }
        .day-name .day-full { display: none; }
        .day-name .day-short { display: inline; }
      
                .edit-save-link,
                .cancel-link,
                .mark-all-link {
                    font-size: 0.56rem;
          padding: 1px 2px;
        }
      
        .last-edited {
                    font-size: 0.52rem;
        }

        /* === COMPACT CHECKBOXES === */
        .attendance-sheet input[type="checkbox"] {
            transform: scale(1.2);
            margin: 4px;
            min-width: 15px;
            min-height: 15px;
            cursor: pointer;
        }

        .overall-attendance {
            min-width: 80px;
            max-width: 94px;
            font-size: 0.6rem;
            text-align: center !important;
            white-space: normal !important;
            overflow-wrap: anywhere;
            word-break: break-word;
            line-height: 1.2;
        }

        /* === COMPACT SUMMARY === */
        #attendance-summary {
                    font-size: 0.7rem;
          padding: 10px 5px;
          margin: 15px 0;
        }

        #attendance-summary th {
            font-size: 0.8rem;
            padding: 6px;
        }

        #attendance-summary td {
            padding: 6px 4px;
            font-size: 0.7rem;
        }

        /* === ENHANCED SCROLL INDICATOR === */
        .attendance-sheet-container::after {
            content: "← Scroll left to see older dates";
            font-size: 0.65rem;
            padding: 5px;
            background: #f0f0f0;
            border-radius: 4px;
            margin: 10px 5px 5px 5px;
        }
      }    

            @media screen and (min-width: 481px) and (max-width: 768px) {
                body {
                    padding-bottom: 0 !important;
                }

                .attendance-page {
                    padding: 12px 10px 28px;
                }

                .attendance-meta {
                    font-size: 0.85rem;
                }

                .attendance-summary-toggle {
                    display: inline-flex;
                    align-items: center;
                    gap: 6px;
                }

                .attendance-summary-wrapper {
                    max-height: 420px;
                    overflow: hidden;
                    transition: max-height 0.25s ease;
                }

                .attendance-summary-wrapper.collapsed-mobile {
                    max-height: 0;
                }

                .inactive-watermark.paired-watermark,
                .term-end-watermark.paired-watermark {
                    font-size: 0.5rem;
                }
            }

            /* === Toolbar: title, calendar chips, filters === */
            .attendance-toolbar {
                margin-bottom: <%= isEmbedded ? '10px' : '18px' %>;
            }

            .attendance-header {
                margin: <%= isEmbedded ? '0' : '8px 0 0' %>;
                padding: <%= isEmbedded ? '12px 14px' : '16px 18px' %>;
                border: 1px solid var(--border);
                border-radius: 12px;
                background: #fff;
                box-shadow: 0 4px 14px rgba(15, 23, 42, 0.04);
                text-align: left;
                width: 100%;
                box-sizing: border-box;
            }

            .attendance-header-top {
                display: flex;
                flex-wrap: wrap;
                align-items: center;
                gap: 10px 16px;
            }

            .attendance-header-copy {
                min-width: 0;
                flex: 0 1 auto;
            }

            .attendance-header .attendance-header-title {
                margin: 0;
                padding: 0;
                color: #0f172a;
                font-size: <%= isEmbedded ? '1.1rem' : '1.3rem' %>;
                font-weight: 700;
                line-height: 1.25;
                text-align: left;
            }

            .attendance-header-pills-center {
                display: flex;
                flex: 1 1 auto;
                flex-wrap: wrap;
                align-items: center;
                justify-content: flex-start;
                gap: 6px;
                min-width: 0;
            }

            .attendance-header-actions {
                display: flex;
                align-items: center;
                gap: 8px;
                margin-left: auto;
            }

            .cal-pill-wrap {
                position: relative;
            }

            .attendance-header .cal-pill {
                display: inline-flex;
                align-items: center;
                gap: 6px;
                width: auto;
                height: 28px;
                margin: 0;
                padding: 0 11px;
                border: 1px solid #e2e8f0;
                border-radius: 999px;
                background: #f8fafc;
                color: #334155;
                font-size: 0.76rem;
                font-weight: 600;
                line-height: 1;
                white-space: nowrap;
                cursor: pointer;
                transition: background-color 0.15s ease, border-color 0.15s ease;
            }

            .attendance-header .cal-pill:hover,
            .attendance-header .cal-pill[aria-expanded="true"] {
                border-color: #cbd5e1;
                background: #f1f5f9;
            }

            .attendance-header .cal-pill img {
                border-radius: 2px;
            }

            .attendance-header .cal-pill svg {
                color: #64748b;
            }

            .attendance-header .cal-pill.cal-pill-muted {
                color: #64748b;
            }

            .attendance-header .filter-toggle-btn {
                display: inline-flex;
                align-items: center;
                gap: 7px;
                width: auto;
                height: 34px;
                margin: 0;
                padding: 0 12px;
                border: 1px solid #cbd5e1;
                border-radius: 9px;
                background: #fff;
                color: #0f172a;
                font-size: 0.84rem;
                font-weight: 600;
                white-space: nowrap;
                box-shadow: none;
                cursor: pointer;
                transition: background-color 0.15s ease, border-color 0.15s ease, color 0.15s ease;
            }

            .attendance-header .filter-toggle-btn:hover {
                border-color: var(--primary);
                color: var(--primary);
            }

            .attendance-header .filter-toggle-btn[aria-expanded="true"] {
                border-color: var(--primary);
                background: color-mix(in srgb, var(--primary) 8%, white);
                color: var(--primary);
            }

            .filter-toggle-btn .filter-chevron {
                transition: transform 0.2s ease;
            }

            .filter-toggle-btn[aria-expanded="true"] .filter-chevron {
                transform: rotate(180deg);
            }

            .filter-count {
                display: inline-flex;
                align-items: center;
                justify-content: center;
                min-width: 18px;
                height: 18px;
                padding: 0 5px;
                border-radius: 999px;
                background: var(--primary);
                color: #fff;
                font-size: 0.7rem;
                font-weight: 700;
            }

            .filter-count[hidden] {
                display: none;
            }

            /* Filter panel (inside the header card) */
            .filter-controls-content {
                max-height: 320px;
                overflow: hidden;
                transition: max-height 0.25s ease;
            }

            .filter-controls-content.collapsed {
                max-height: 0;
            }

            .filter-controls {
                margin-top: 12px;
                padding-top: 12px;
                border-top: 1px solid #eef2f6;
            }

            .filter-inner-container {
                display: flex;
                flex-wrap: wrap;
                align-items: flex-end;
                gap: 10px 12px;
            }

            .filter-field {
                display: flex;
                flex-direction: column;
                gap: 5px;
                margin: 0;
                color: #64748b;
                font-size: 0.7rem;
                font-weight: 700;
                letter-spacing: 0.04em;
                text-transform: uppercase;
            }

            .filter-field select,
            .filter-field .filter-sort-btn {
                height: 36px;
                margin: 0;
                border: 1px solid #cbd5e1;
                border-radius: 8px;
                background-color: #fff;
                color: #0f172a;
                font-size: 0.86rem;
                font-weight: 500;
                letter-spacing: normal;
                text-transform: none;
            }

            .filter-field select {
                width: auto;
                min-width: 170px;
                padding: 0 10px;
            }

            .filter-field .filter-sort-btn {
                display: inline-flex;
                align-items: center;
                gap: 6px;
                width: auto;
                min-width: 96px;
                padding: 0 12px;
                font-weight: 600;
                cursor: pointer;
            }

            .filter-field select:focus,
            .filter-field .filter-sort-btn:focus-visible {
                border-color: var(--primary);
                outline: 2px solid color-mix(in srgb, var(--primary) 22%, transparent);
                outline-offset: 0;
            }

            .filter-sort-btn[data-sort-direction="asc"] .sort-label-desc,
            .filter-sort-btn[data-sort-direction="desc"] .sort-label-asc {
                display: none;
            }

            .filter-actions {
                display: flex;
                align-items: center;
                gap: 8px;
                margin-left: auto;
            }

            .filter-reset-btn {
                width: auto;
                height: 36px;
                margin: 0;
                padding: 0 12px;
                border: 0;
                border-radius: 8px;
                background: transparent;
                color: var(--primary);
                font-size: 0.84rem;
                font-weight: 600;
                cursor: pointer;
            }

            .filter-reset-btn:hover {
                background: color-mix(in srgb, var(--primary) 8%, white);
            }

            .filter-reset-btn[disabled] {
                color: #94a3b8;
                background: transparent;
                cursor: default;
            }

            @media screen and (max-width: 640px) {
                .attendance-header-top {
                    gap: 8px 10px;
                }

                .attendance-header-pills-center {
                    order: 3;
                    flex-basis: 100%;
                }

                .attendance-header .cal-pill {
                    height: 26px;
                    padding: 0 9px;
                    font-size: 0.72rem;
                }

                .filter-inner-container {
                    display: grid;
                    grid-template-columns: repeat(2, minmax(0, 1fr));
                }

                .filter-field select,
                .filter-field .filter-sort-btn {
                    width: 100%;
                    min-width: 0;
                }

                .filter-actions {
                    justify-content: flex-end;
                    margin-left: 0;
                }
            }
</style>
</head>
<body>
        <div class="attendance-page <%= isEmbedded ? 'attendance-page-embedded' : '' %>">
            <div class="attendance-toolbar">
            <div class="attendance-header">
                <div class="attendance-header-top">
                    <div class="attendance-header-copy">
                        <h1 class="attendance-header-title"><%= isEmbedded ? 'Attendance' : `Attendance for ${className}` %></h1>
                        <% if (!isEmbedded) { %>
                        <div class="attendance-meta">School Year: <%= schoolYear.year_label %> &middot; Term: <%= termName %></div>
                        <% } %>
                    </div>
                    <div class="attendance-header-pills-center">
                    <% if (attendanceCalendarSummary && attendanceCalendarSummary.enabled) { %>
                        <% const _countryCode = String(attendanceCalendarSummary.countryCode || '').trim().toUpperCase(); %>
                        <% const _countryFlagHtml = /^[A-Z]{2}$/.test(_countryCode) ? `<img src="https://flagcdn.com/24x18/${_countryCode.toLowerCase()}.png" alt="" width="18" height="13">` : '🌍'; %>
                        <div class="cal-pill-wrap">
                            <button type="button" class="cal-pill" data-pill="country" aria-expanded="false" aria-controls="popover-country">
                                <%- _countryFlagHtml %> <%= _countryCode %>
                            </button>
                            <div class="cal-pill-popover" id="popover-country">
                                <p class="cal-popover-label">Country</p>
                                <p class="cal-popover-value"><%- _countryFlagHtml %> <%= _countryCode %></p>
                            </div>
                        </div>
                        <div class="cal-pill-wrap">
                            <button type="button" class="cal-pill" data-pill="weekends" aria-expanded="false" aria-controls="popover-weekends">
                                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/></svg>
                                Weekends
                            </button>
                            <div class="cal-pill-popover" id="popover-weekends">
                                <p class="cal-popover-label">Weekend Days</p>
                                <p class="cal-popover-value"><%= (attendanceCalendarSummary.weekendLabels || []).length ? attendanceCalendarSummary.weekendLabels.join(', ') : 'None' %></p>
                            </div>
                        </div>
                        <div class="cal-pill-wrap">
                            <button type="button" class="cal-pill" data-pill="holidays" aria-expanded="false" aria-controls="popover-holidays">
                                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 22V4a1 1 0 0 1 1-1h11l-2 4 2 4H5"/></svg>
                                Public Holidays
                            </button>
                            <div class="cal-pill-popover" id="popover-holidays">
                                <p class="cal-popover-label">Public Holidays</p>
                                <p class="cal-popover-value"><%= attendanceCalendarSummary.includePublicHolidays ? 'Excluded from attendance' : 'Included in attendance' %></p>
                            </div>
                        </div>
                        <% if (attendanceCalendarSummary.excludedDisplayDateCount > 0) { %>
                        <div class="cal-pill-wrap">
                            <button type="button" class="cal-pill cal-pill-muted" data-pill="excluded" aria-expanded="false" aria-controls="popover-excluded">
                                <%= attendanceCalendarSummary.excludedDisplayDateCount %> inactive <%= attendanceCalendarSummary.excludedDisplayDateCount === 1 ? 'date' : 'dates' %>
                            </button>
                            <div class="cal-pill-popover" id="popover-excluded">
                                <p class="cal-popover-label">Inactive Dates</p>
                                <p class="cal-popover-value"><%= attendanceCalendarSummary.excludedDisplayDateCount %> <%= attendanceCalendarSummary.excludedDisplayDateCount === 1 ? 'date is' : 'dates are' %> shown as inactive &mdash; weekends, public holidays, or manually excluded.</p>
                            </div>
                        </div>
                        <% } %>
                    <% } %>
                    </div>
                    <div class="attendance-header-actions">
                        <button type="button" class="filter-toggle-btn" onclick="toggleFilters()" aria-expanded="false" aria-controls="filterControlsContent">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polygon points="3 4 21 4 14 12 14 19 10 21 10 12 3 4"></polygon></svg>
                            <span>Filters</span>
                            <span class="filter-count" id="filterCount" hidden></span>
                            <svg class="filter-chevron" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
                        </button>
                    </div>
                </div>
                <% if (!(attendanceCalendarSummary && attendanceCalendarSummary.enabled)) { %>
                    <div class="attendance-meta" style="margin-top:10px; background:#fff8e1; border:1px solid #f59e0b; border-radius:8px; padding:8px 14px; color:#92400e; display:inline-block;">
                        ⚠️ No attendance calendar is configured for this term — all dates including weekends are shown.
                        <a href="/account/settings?section=customize&calendarTermId=<%= termId %>" style="color:#b45309; font-weight:600; margin-left:6px;">Configure Calendar for this term →</a>
                    </div>
                <% } %>
                <div class="filter-controls-content collapsed" id="filterControlsContent">
                    <div class="filter-controls">
                        <div class="filter-inner-container">
                            <div class="filter-field">
                                <span id="nameSortLabel">Name order</span>
                                <button type="button" class="filter-sort-btn" id="nameSortToggle" data-sort-direction="asc" aria-labelledby="nameSortLabel nameSortToggle" aria-label="Sort names Z to A">
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m3 16 4 4 4-4M7 20V4M11 4h10M11 8h7M11 12h4"/></svg>
                                    <span class="sort-label-asc">A → Z</span><span class="sort-label-desc">Z → A</span>
                                </button>
                                <input type="hidden" id="nameSort" value="asc">
                            </div>

                            <label class="filter-field">
                                Gender
                                <select id="genderFilter">
                                    <option value="all">All students</option>
                                    <option value="Female">Female</option>
                                    <option value="Male">Male</option>
                                </select>
                            </label>

                            <% const _now = new Date(); %>
                            <% const todayKey = `${_now.getFullYear()}-${String(_now.getMonth() + 1).padStart(2, '0')}-${String(_now.getDate()).padStart(2, '0')}`; %>

                            <label class="filter-field">
                                Date
                                <select id="dateFilter">
                                    <option value="all">All dates</option>
                                    <% displayDates.slice().reverse().forEach(date => { %>
                                        <% const isToday = date === todayKey; %>
                                        <% const dateObj = new Date(`${date}T00:00:00Z`); %>
                                        <% const formattedDate = dateObj.toLocaleDateString('en-US', { weekday: 'short', month: 'short', day: 'numeric', year: 'numeric', timeZone: 'UTC' }); %>
                                        <option value="<%= date %>"><%= isToday ? `Today (${formattedDate})` : formattedDate %></option>
                                    <% }) %>
                                </select>
                            </label>

                            <div class="filter-actions">
                                <button type="button" class="filter-reset-btn" id="filterResetBtn" onclick="resetFilters()" disabled>Reset</button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            </div>

    

    <% if (students.length === 0) { %>
        <p style="text-align: center; font-size: 1.2em; color: red;">No students found for this class yet.</p>
    <% } else { %>
        <div class="attendance-sheet-container">
            <table class="attendance-sheet">
                <thead>
                    <tr>
                        <th class="student-name">Student Name <button type="button" class="sort-toggle-btn" id="attendanceHeaderSortToggle" data-sort-direction="asc" aria-label="Sort names Z to A"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 12 12" aria-hidden="true" focusable="false"><path fill="currentColor" d="M10 5H2a.5.5 0 0 1-.46-.31.47.47 0 0 1 .11-.54L5.29.5A1 1 0 0 1 6.7.5l3.65 3.65a.49.49 0 0 1 .11.54A.51.51 0 0 1 10 5z"></path><path fill="currentColor" d="M2 7a.5.5 0 0 0-.46.31.47.47 0 0 0 .11.54L5.3 11.5a1 1 0 0 0 1.41 0l3.65-3.65a.49.49 0 0 0 .11-.54A.53.53 0 0 0 10 7z"></path></svg></button></th>
                        <% displayDates.forEach(date => { %>
                            <% const isToday = date === todayKey; %>
                            <% const dateMeta = (dateMetaMap && dateMetaMap[date]) ? dateMetaMap[date] : { countable: true }; %>
                            <th data-date="<%= date %>" class="<%= isToday ? 'today-col' : '' %> <%= !dateMeta.countable ? 'date-col-excluded' : '' %> <%= dateMeta.isOfficialTermEnd ? 'term-end-col' : '' %>">
                                <div class="date-header">
                                    <% const _parts = String(date).split('-'); %>
                                    <% const _d = new Date(Number(_parts[0]), Number(_parts[1]) - 1, Number(_parts[2])); %>
                                    <% const _formattedDate = `${Number(_parts[1])}/${Number(_parts[2])}/${_parts[0]}`; %>
                                    <% const _days = ['Sunday','Monday','Tuesday','Wednesday','Thursday','Friday','Saturday']; %>
                                    <% const _dayShorts = ['Sun','Mon','Tue','Wed','Thu','Fri','Sat']; %>
                                    <% if (!isToday) { %>
                                    <span class="day-name">
                                        <span class="day-full"><%= _days[_d.getDay()] %></span>
                                        <span class="day-short"><%= _dayShorts[_d.getDay()] %></span>
                                    </span>
                                    <% } %>
                                    <%= isToday ? "Today" : _formattedDate %>
                                    <% if (students.length > 0 && dateMeta.countable) { %>
                                        <div class="edit-save-link" data-date="<%= date %>" onclick="toggleEditSaveMode('<%= date %>')">Edit</div>
                                        <div class="cancel-link" data-date="<%= date %>" style="display: none;" onclick="cancelEditMode('<%= date %>')">Cancel</div>
                                        <div class="mark-all-link" data-date="<%= date %>" style="display: none;" onclick="markAllPresentForDate('<%= date %>')">Mark All Present</div>
                                    <% } %>
                                    <div class="last-edited <%= (lastEditedMap && lastEditedMap[date]) ? 'has-tooltip' : '' %>" id="last-edited-<%= date %>">
                                        <% if (lastEditedMap && lastEditedMap[date]) { %>
                                            <span class="last-edited-icon" aria-hidden="true">
                                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="10" height="10"><circle cx="12" cy="12" r="9"></circle><path d="M12 7v5l3 2"></path></svg>
                                            </span><span class="last-edited-text">Last edited</span>
                                            <span class="last-edited-hover-date" role="tooltip"><%= new Date(lastEditedMap[date]).toLocaleString('en-US', { month: 'numeric', day: 'numeric', year: 'numeric', hour: 'numeric', minute: '2-digit' }) %></span>
                                        <% } %>
                                    </div>
                                </div>
                            </th>
                        <% }); %>
                        <th class="overall-attendance">Overall Attendance</th>
                    </tr>
                </thead>
                <tbody>
                    <% students.forEach((student, rowIndex) => { %>
                        <% const attendanceStudentName = (typeof formatDisplayName === 'function' ? formatDisplayName(student) : [student.first_name, student.last_name].filter(Boolean).join(' ').trim()); %>
                        <tr 
                        data-name="<%= String(attendanceStudentName || '').toLowerCase() %>" 
                        data-gender="<%= student.gender ? student.gender.toLowerCase() : '' %>">
                                <td class="student-name" data-student-id="<%= student.student_id %>">
                                <%= attendanceStudentName %>
                            </td>
                            <% let presentCount = 0; %>
                            <% let totalCount = 0; %>
                            <% displayDates.forEach(date => { %>
                                <% const isTodayCell = date === todayKey; %>
                                <% const dateMeta = (dateMetaMap && dateMetaMap[date]) ? dateMetaMap[date] : { countable: true, markerLabel: null }; %>
                                <% const showPairedWatermark = (rowIndex % 2) === 0; %>
                                <td class="<%= isTodayCell ? 'today-col' : '' %> <%= !dateMeta.countable ? 'inactive-day-cell' : '' %> <%= dateMeta.isOfficialTermEnd ? 'term-end-cell' : '' %>">
                                    <input type="checkbox" data-date="<%= date %>" data-student-id="<%= student.student_id %>" 
                                        data-countable="<%= dateMeta.countable ? 'true' : 'false' %>"
                                        class="<%= !dateMeta.countable ? 'attendance-inactive' : '' %>"
                                        <%= attendanceMap[student.student_id] && attendanceMap[student.student_id][date] === 'Present' ? 'checked' : '' %> 
                                        <%= (!dateMeta.countable || (attendanceMap[student.student_id] && attendanceMap[student.student_id][date])) ? 'disabled' : '' %> >
                                    <% if (!dateMeta.countable && showPairedWatermark) { %>
                                        <span class="inactive-watermark paired-watermark"><%= (dateMeta.markerLabel || 'Excluded').toUpperCase() %></span>
                                    <% } %>
                                    <% if (dateMeta.isOfficialTermEnd && showPairedWatermark) { %>
                                        <span class="term-end-watermark paired-watermark">OFFICIAL TERM END DATE</span>
                                    <% } %>
                                    <% if (dateMeta.countable) { totalCount++; } %>
                                    <% if (dateMeta.countable && attendanceMap[student.student_id] && attendanceMap[student.student_id][date] === 'Present') { %>
                                        <% presentCount++; %>
                                    <% } %>
                                </td>
                            <% }); %>
                            <td class="overall-attendance"><%= presentCount %>/<%= totalCount %></td>
                        </tr>
                    <% }); %>
                </tbody>
            </table>

        </div>

    <% } %>

    <br>
    <button type="button" id="attendanceSummaryToggle" class="attendance-summary-toggle" onclick="toggleAttendanceSummary()">Attendance Summary</button>
    <div id="attendanceSummaryWrapper" class="attendance-summary-wrapper collapsed-mobile">
      <table id="attendance-summary" style="width: 100%; border-collapse: collapse; margin-top: 20px;">
          <thead>
              <tr>
                  <th colspan="3" style="background: #e5f5f7; padding: 10px; color: var(--org-primary-color);">Attendance Summary</th>
              </tr>
          </thead>
          <tbody>
              <tr>
                  <td>Total Male Students: <span id="maleTotal">0</span></td>
                  <td>Present: <span id="malePresent">0</span></td>
                  <td>Absent: <span id="maleAbsent">0</span></td>
              </tr>
              <tr>
                  <td>Total Female Students: <span id="femaleTotal">0</span></td>
                  <td>Present: <span id="femalePresent">0</span></td>
                  <td>Absent: <span id="femaleAbsent">0</span></td>
              </tr>
              <tr style="font-weight: bold;">
                  <td>Class Total: <span id="classTotal">0</span></td>
                  <td>Present: <span id="classPresent">0</span></td>
                  <td>Absent: <span id="classAbsent">0</span></td>
              </tr>
          </tbody>
          
      </table>
    </div>
    

    </div>

    <script>
        var originalStates = window.__attendanceOriginalStates || {};
        window.__attendanceOriginalStates = originalStates;

        // Toggle Filter Controls
        function toggleFilters() {
            const content = document.getElementById('filterControlsContent');
            const button = document.querySelector('.filter-toggle-btn');
            const open = content.classList.contains('collapsed');
            content.classList.toggle('collapsed', !open);
            button.setAttribute('aria-expanded', open ? 'true' : 'false');
        }

        // Filters apply as soon as they change; the button shows how many are on.
        function updateFilterState() {
            const active = [
                document.getElementById('nameSort').value === 'desc',
                document.getElementById('genderFilter').value !== 'all',
                document.getElementById('dateFilter').value !== 'all',
            ].filter(Boolean).length;
            const count = document.getElementById('filterCount');
            if (count) {
                count.textContent = String(active);
                count.hidden = active === 0;
            }
            const reset = document.getElementById('filterResetBtn');
            if (reset) reset.disabled = active === 0;
        }

        function resetFilters() {
            document.getElementById('nameSort').value = 'asc';
            document.getElementById('genderFilter').value = 'all';
            document.getElementById('dateFilter').value = 'all';
            if (typeof syncAttendanceSortToggle === 'function') syncAttendanceSortToggle();
            applyFilters();
        }

        function toggleCalendarRules() {
            // legacy — no-op, pills replaced this
        }

        // Calendar info pill popovers
        (function () {
            const pillWraps = document.querySelectorAll('.cal-pill-wrap');
            pillWraps.forEach(function (wrap) {
                const btn = wrap.querySelector('.cal-pill');
                const popover = wrap.querySelector('.cal-pill-popover');
                if (!btn || !popover) return;
                btn.addEventListener('click', function (e) {
                    e.stopPropagation();
                    const isOpen = popover.classList.contains('open');
                    // close all others
                    document.querySelectorAll('.cal-pill-popover.open').forEach(function (p) {
                        p.classList.remove('open');
                    });
                    document.querySelectorAll('.cal-pill[aria-expanded="true"]').forEach(function (b) {
                        b.setAttribute('aria-expanded', 'false');
                    });
                    if (!isOpen) {
                        popover.classList.add('open');
                        btn.setAttribute('aria-expanded', 'true');
                    }
                });
            });
            document.addEventListener('click', function () {
                document.querySelectorAll('.cal-pill-popover.open').forEach(function (p) {
                    p.classList.remove('open');
                });
                document.querySelectorAll('.cal-pill[aria-expanded="true"]').forEach(function (b) {
                    b.setAttribute('aria-expanded', 'false');
                });
            });
        })();

        function toggleAttendanceSummary() {
            const content = document.getElementById('attendanceSummaryWrapper');
            if (!content) return;
            content.classList.toggle('collapsed-mobile');
        }

        // Auto-populate attendance summary
        function updateAttendanceSummary() {
            const rows = document.querySelectorAll('.attendance-sheet tbody tr');
            let maleCount = 0, femaleCount = 0;
            let malePresent = 0, femalePresent = 0;
            let maleAbsent = 0, femaleAbsent = 0;

            rows.forEach(row => {
                if (row.style.display === 'none') return; // Skip hidden rows
                
                const rowGender = row.dataset.gender.toLowerCase();
                
                if (rowGender === 'male') maleCount++;
                if (rowGender === 'female') femaleCount++;

                const checkboxes = row.querySelectorAll('input[type="checkbox"]');
                checkboxes.forEach(checkbox => {
                    if (checkbox.dataset.countable !== 'true') return;
                    const cell = checkbox.closest('td');
                    if (cell.style.display === 'none') return; // Skip hidden cells
                    
                    if (checkbox.checked) {
                        if (rowGender === 'male') malePresent++;
                        if (rowGender === 'female') femalePresent++;
                    } else if (checkbox.disabled) { // Only count as absent if attendance was recorded
                        if (rowGender === 'male') maleAbsent++;
                        if (rowGender === 'female') femaleAbsent++;
                    }
                });
            });

            // Update the summary table
            const summaryContainer = document.getElementById('attendance-summary');
            if (summaryContainer) {
                summaryContainer.innerHTML = `
                    <thead>
                        <tr>
                            <th colspan="3" style="background: #e5f5f7; padding: 10px; color: var(--org-primary-color);">Attendance Summary</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td>Total Male Students: <span>${maleCount}</span></td>
                            <td>Present: <span>${malePresent}</span></td>
                            <td>Absent: <span>${maleAbsent}</span></td>
                        </tr>
                        <tr>
                            <td>Total Female Students: <span>${femaleCount}</span></td>
                            <td>Present: <span>${femalePresent}</span></td>
                            <td>Absent: <span>${femaleAbsent}</span></td>
                        </tr>
                        <tr style="font-weight: bold;">
                            <td>Class Total: <span>${maleCount + femaleCount}</span></td>
                            <td>Present: <span>${malePresent + femalePresent}</span></td>
                            <td>Absent: <span>${maleAbsent + femaleAbsent}</span></td>
                        </tr>
                    </tbody>
                `;
            }
        }

        // Scroll attendance table so the most recent (rightmost) date is visible first
        function scrollAttendanceToEnd() {
            const container = document.querySelector('.attendance-sheet-container');
            if (container) {
                container.scrollLeft = container.scrollWidth;
            }
        }

        function formatLastEditedTime(value) {
            return new Date(value).toLocaleString('en-US', {
                month: 'numeric',
                day: 'numeric',
                year: 'numeric',
                hour: 'numeric',
                minute: '2-digit'
            });
        }

        function renderLastEdited(element, value) {
            if (!element || !value) return;
            var hoverTime = formatLastEditedTime(value);
            element.classList.add('has-tooltip');
            element.innerHTML = ''
                + '<span class="last-edited-icon" aria-hidden="true">'
                + '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="10" height="10"><circle cx="12" cy="12" r="9"></circle><path d="M12 7v5l3 2"></path></svg>'
                + '</span>'
                + '<span class="last-edited-text">Last edited</span>'
                + '<span class="last-edited-hover-date" role="tooltip">' + hoverTime + '</span>';
        }

        document.addEventListener('DOMContentLoaded', () => {
            const classId = '<%= classId %>';
            const termId = '<%= termId %>';
            const calendarRulesContent = document.getElementById('calendarRulesContent');
            const attendanceSummaryWrapper = document.getElementById('attendanceSummaryWrapper');
            const nameSortToggle = document.getElementById('nameSortToggle');
            const attendanceHeaderSortToggle = document.getElementById('attendanceHeaderSortToggle');
            const nameSortInput = document.getElementById('nameSort');

            document.addEventListener('click', function (event) {
                const trigger = event.target.closest('.last-edited.has-tooltip');
                if (!trigger) {
                    document.querySelectorAll('.last-edited.has-tooltip.is-open').forEach(function (node) {
                        node.classList.remove('is-open');
                    });
                    return;
                }

                const alreadyOpen = trigger.classList.contains('is-open');
                document.querySelectorAll('.last-edited.has-tooltip.is-open').forEach(function (node) {
                    node.classList.remove('is-open');
                });
                if (!alreadyOpen) {
                    trigger.classList.add('is-open');
                }
            });

            syncAttendanceSortToggle();
            if (nameSortToggle && nameSortInput) {
                nameSortToggle.addEventListener('click', function() {
                    nameSortInput.value = nameSortInput.value === 'asc' ? 'desc' : 'asc';
                    syncAttendanceSortToggle();
                    applyFilters();
                });
            }
            ['genderFilter', 'dateFilter'].forEach(function (id) {
                const field = document.getElementById(id);
                if (field) field.addEventListener('change', applyFilters);
            });
            if (attendanceHeaderSortToggle && nameSortInput) {
                attendanceHeaderSortToggle.addEventListener('click', function() {
                    nameSortInput.value = nameSortInput.value === 'asc' ? 'desc' : 'asc';
                    syncAttendanceSortToggle();
                    applyFilters();
                });
            }

            if (attendanceSummaryWrapper && window.matchMedia('(min-width: 769px)').matches) {
                attendanceSummaryWrapper.classList.remove('collapsed-mobile');
            }

            // Scroll to the right immediately so current date shows first
            scrollAttendanceToEnd();

            fetch(`/common/getAttendanceForClass?classId=${classId}&termId=${termId}`)
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        const attendanceMap = {};
                        const lastEditedMap = {};

                        data.attendance.forEach(record => {
                            if (!attendanceMap[record.student_id]) {
                                attendanceMap[record.student_id] = {};
                            }
                            attendanceMap[record.student_id][record.date] = record.status;

                            if (record.updated_at) {
                                lastEditedMap[record.date] = record.updated_at;
                            }
                        });

                        const students = document.querySelectorAll('.attendance-sheet tbody tr');
                        students.forEach(student => {
                            const studentId = student.querySelector('td').dataset.studentId;
                            const dates = student.querySelectorAll('td input[type="checkbox"]');
                            dates.forEach(dateCheckbox => {
                                const date = dateCheckbox.dataset.date;
                                if (attendanceMap[studentId] && attendanceMap[studentId][date]) {
                                    dateCheckbox.checked = attendanceMap[studentId][date] === 'Present';
                                    dateCheckbox.disabled = true;
                                }
                            });
                        });

                        Object.keys(lastEditedMap).forEach(date => {
                            const lastEditedElement = document.getElementById(`last-edited-${date}`);
                            if (lastEditedElement) {
                                renderLastEdited(lastEditedElement, lastEditedMap[date]);
                            }
                        });

                        // Auto-populate attendance summary on page load
                        setTimeout(updateAttendanceSummary, 100);
                        // Scroll again after attendance data renders
                        setTimeout(scrollAttendanceToEnd, 150);
                    } else {
                        console.error('Failed to fetch attendance:', data.error);
                    }
                })
                .catch(error => {
                    console.error('Error fetching attendance:', error);
                });
        });

        function toggleEditSaveMode(date) {
            const checkboxes = document.querySelectorAll(`input[data-date='${date}']`);
            const link = document.querySelector(`.edit-save-link[data-date='${date}']`);
            const cancelLink = document.querySelector(`.cancel-link[data-date='${date}']`);
            const markAllLink = document.querySelector(`.mark-all-link[data-date='${date}']`);

            if (link.textContent === 'Save') {
                saveAttendanceForDate(date, checkboxes, link);
            } else if (link.textContent === 'Edit') {
                saveOriginalStates(date, checkboxes);
                checkboxes.forEach(checkbox => {
                    checkbox.disabled = false;
                });
                link.textContent = 'Save';
                cancelLink.style.display = 'block';
                if (markAllLink) markAllLink.style.display = 'block';
            }
        }

        function markAllPresentForDate(date) {
            const checkboxes = document.querySelectorAll(`input[data-date='${date}']`);
            checkboxes.forEach(checkbox => {
                if (checkbox.dataset.countable === 'true' && !checkbox.disabled) {
                    checkbox.checked = true;
                }
            });
            setTimeout(updateAttendanceSummary, 10);
        }

        function saveAttendanceForDate(date, checkboxes, link) {
            const attendanceData = {};
            const classId = '<%= classId %>';
            const termId = '<%= termId %>';

            checkboxes.forEach(checkbox => {
                attendanceData[checkbox.dataset.studentId] = checkbox.checked ? 'Present' : 'Absent';
            });

            fetch('/common/saveSingleAttendance', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                },
                body: JSON.stringify({ attendance: attendanceData, classId, termId, date })
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    alert(`Attendance for ${date} saved successfully!`);
                    link.textContent = 'Edit';
                    checkboxes.forEach(checkbox => {
                        checkbox.disabled = true;
                    });
                    const cancelLink = document.querySelector(`.cancel-link[data-date='${date}']`);
                    cancelLink.style.display = 'none';
                    const markAllLink = document.querySelector(`.mark-all-link[data-date='${date}']`);
                    if (markAllLink) markAllLink.style.display = 'none';

                    const lastEditedElement = document.getElementById(`last-edited-${date}`);
                    if (lastEditedElement) {
                        renderLastEdited(lastEditedElement, new Date());
                    }

                    // Update attendance summary after saving
                    setTimeout(updateAttendanceSummary, 50);
                } else {
                    console.error('Failed to save attendance:', data.error);
                    alert(data.message || 'Failed to save attendance. Please try again.');
                }
            })
            .catch(error => {
                console.error('Error saving attendance:', error);
                alert('Failed to save attendance. Please try again.');
            });
        }

        function saveOriginalStates(date, checkboxes) {
            originalStates[date] = {};
            checkboxes.forEach(checkbox => {
                originalStates[date][checkbox.dataset.studentId] = checkbox.checked;
            });
        }

        function restoreOriginalStates(date, checkboxes) {
            checkboxes.forEach(checkbox => {
                checkbox.checked = originalStates[date][checkbox.dataset.studentId];
                checkbox.disabled = true;
            });
        }

        function cancelEditMode(date) {
            const checkboxes = document.querySelectorAll(`input[data-date='${date}']`);
            restoreOriginalStates(date, checkboxes);
            const link = document.querySelector(`.edit-save-link[data-date='${date}']`);
            link.textContent = 'Edit';
            const cancelLink = document.querySelector(`.cancel-link[data-date='${date}']`);
            cancelLink.style.display = 'none';
            const markAllLink = document.querySelector(`.mark-all-link[data-date='${date}']`);
            if (markAllLink) markAllLink.style.display = 'none';
        }


            var originalRows = window.__attendanceOriginalRows || [];
            window.__attendanceOriginalRows = originalRows;
            
            document.addEventListener('DOMContentLoaded', () => {
                const tbody = document.querySelector('.attendance-sheet tbody');
                originalRows.length = 0;
                originalRows.push(...tbody.querySelectorAll('tr'));
            });

            function syncAttendanceSortToggle() {
                const sortInput = document.getElementById('nameSort');
                const toggles = [document.getElementById('nameSortToggle'), document.getElementById('attendanceHeaderSortToggle')].filter(Boolean);
                if (!sortInput || !toggles.length) return;
                const direction = sortInput.value === 'desc' ? 'desc' : 'asc';
                toggles.forEach(function(toggle) {
                    toggle.setAttribute('data-sort-direction', direction);
                    toggle.setAttribute('aria-label', direction === 'asc' ? 'Sort names Z to A' : 'Sort names A to Z');
                });
            }
            
            function applyFilters() {
                const sort = document.getElementById('nameSort').value;
                const gender = document.getElementById('genderFilter').value.toLowerCase();
                const selectedDate = document.getElementById('dateFilter').value;
                
                const tbody = document.querySelector('.attendance-sheet tbody');
                tbody.innerHTML = '';
            
                // Sort by gender THEN name
                const filtered = [...originalRows]
                    .filter(row => {
                        const rowGender = row.dataset.gender.toLowerCase();
                        return gender === 'all' || rowGender === gender;
                    })
                    .sort((a, b) => {
                        const genderA = a.dataset.gender;
                        const genderB = b.dataset.gender;
                        if (genderA !== genderB) return genderA.localeCompare(genderB);
            
                        const nameA = a.dataset.name;
                        const nameB = b.dataset.name;
                        return sort === 'asc' ? nameA.localeCompare(nameB) : nameB.localeCompare(nameA);
                    });
            
                filtered.forEach(row => {
                    const checkboxes = row.querySelectorAll('input[type="checkbox"]');
                    checkboxes.forEach(checkbox => {
                        const cell = checkbox.closest('td');
                        const isMatch = selectedDate === 'all' || checkbox.dataset.date === selectedDate;
                        cell.style.display = isMatch ? '' : 'none';
                    });
            
                    // Show/hide overall attendance
                    const overallCell = row.querySelector('.overall-attendance');
                    if (overallCell) {
                        overallCell.style.display = selectedDate === 'all' ? '' : 'none';
                    }
            
                    tbody.appendChild(row);
                });
            
                // Update <thead> columns (show only selected date if filtering)
                const dateHeaders = Array.from(document.querySelectorAll('.attendance-sheet thead th[data-date]'));
                dateHeaders.forEach(th => {
                    const headerDate = th.dataset.date;
                    th.style.display = (selectedDate === 'all' || selectedDate === headerDate) ? '' : 'none';
                });
            
                const overallTh = document.querySelector('.attendance-sheet thead .overall-attendance');
                if (overallTh) {
                    overallTh.style.display = selectedDate === 'all' ? '' : 'none';
                }
            
                // Auto-update attendance summary
                setTimeout(updateAttendanceSummary, 50);
                updateFilterState();
            }

            
            </script>
            