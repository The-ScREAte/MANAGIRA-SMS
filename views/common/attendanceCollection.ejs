    <% if (locals.lunchOn) { %>
    <script nonce="<%= locals.cspNonce || '' %>">
    // Lunch, beside each student's checkbox. A day nobody has marked is open: the first tap starts editing.
    // A saved day is locked until Edit. Lunch is saved with the day's attendance, and only for a day
    // whose lunch was touched, so a day nobody took lunch for stays "not taken".
    (function () {
        var sheet = document.querySelector('.attendance-sheet');
        if (!sheet) return;
        var CLASS_ID = '<%= classId %>', TERM_ID = '<%= termId %>';
        var saved = <%- JSON.stringify(locals.lunchMap || {}) %>;
        var touched = {};
        function q(sel) { return sheet.querySelector(sel); }
        function picks(date) { return Array.prototype.slice.call(sheet.querySelectorAll('.lunch-pick[data-lunch-date="' + date + '"]')); }
        function editing(date) { var ed = q('.edit-save-link[data-date="' + date + '"]'); return !!ed && ed.textContent.trim() === 'Save'; }
        function hasSaved(date) { return Object.keys(saved).some(function (id) { return saved[id] && saved[id][date] !== undefined; }); }
        function locked(date) {
            if (editing(date)) return false;
            var boxes = sheet.querySelectorAll('tbody input[data-date="' + date + '"][data-countable="true"]');
            return Array.prototype.some.call(boxes, function (b) { return b.disabled; }) || hasSaved(date);
        }
        // Colours are set on the element itself so the app's general button styles can't change them.
        function paint(el, on) {
            var set = function (k, v) { el.style.setProperty(k, v, 'important'); };
            set('background', on ? 'var(--att-accent)' : '#fff');
            set('border-color', on ? 'var(--att-accent)' : 'var(--att-line)');
            set('color', on ? '#fff' : 'var(--att-muted)');
        }
        function setPick(btn, on) {
            btn.dataset.v = on ? 'yes' : '';
            btn.setAttribute('aria-pressed', on ? 'true' : 'false');
            btn.title = on ? 'Had lunch' : 'No lunch';
            btn.setAttribute('aria-label', btn.title);
            paint(btn, on);
        }
        function refresh(date) {
            var lock = locked(date), list = picks(date), yes = list.filter(function (b) { return b.dataset.v === 'yes'; }).length;
            list.forEach(function (b) { b.disabled = lock; });
            var all = q('.mark-all-link[data-date="' + date + '"] .check-all-lunch');
            if (all) { var full = list.length > 0 && yes === list.length; all.setAttribute('aria-pressed', full ? 'true' : 'false'); paint(all, full); }
            var t = q('.lunch-tally[data-lunch-date="' + date + '"]');
            if (t) { var b = t.querySelector('b'); if (b.textContent !== String(yes)) b.textContent = yes; t.hidden = !(yes > 0 || editing(date)); }
            if (typeof window.updateAttendanceSummary === 'function') { clearTimeout(refresh.summary); refresh.summary = setTimeout(window.updateAttendanceSummary, 30); }
        }
        function startEditing(date) { if (!editing(date) && window.toggleEditSaveMode) window.toggleEditSaveMode(date); }
        // Only the drawn days are loaded here; the rest of the term's lunch comes as totals from the server, and
        // what's drawn is counted from the page (so a day saved here moves the figures at once).
        var TOTALS = <%- JSON.stringify(locals.lunchTotals || { days: 0, byStudent: {} }) %>;
        function daysIn(map) { var days = {}; Object.keys(map).forEach(function (id) { Object.keys(map[id] || {}).forEach(function (d) { days[d] = true; }); }); return Object.keys(days).length; }
        function yesIn(map, id) { var mine = map[id] || {}, yes = 0; Object.keys(mine).forEach(function (d) { if (mine[d] === true) yes++; }); return yes; }
        var initialSaved = JSON.parse(JSON.stringify(saved));
        var baseDays = (TOTALS.days || 0) - daysIn(initialSaved);
        function overall() {
            var total = baseDays + daysIn(saved);
            sheet.querySelectorAll('.ov-lunch[data-student]').forEach(function (el) {
                var id = el.dataset.student, yes = ((TOTALS.byStudent || {})[id] || 0) - yesIn(initialSaved, id) + yesIn(saved, id);
                el.querySelector('b').textContent = yes + '/' + total;
            });
        }
        var dates = {};
        sheet.querySelectorAll('tbody input[type="checkbox"][data-date][data-countable="true"]').forEach(function (box) {
            var date = box.dataset.date, id = box.dataset.studentId;
            dates[date] = true;
            var btn = document.createElement('button');
            btn.type = 'button'; btn.className = 'lunch-pick att-plate-btn'; btn.dataset.lunchDate = date; btn.dataset.student = id;
            setPick(btn, (saved[id] || {})[date] === true);
            btn.addEventListener('click', function () {
                if (btn.disabled) return;
                startEditing(date);
                setPick(btn, btn.dataset.v !== 'yes');
                touched[date] = true;
                refresh(date);
            });
            var pair = document.createElement('span'); pair.className = 'att-pair';
            box.parentNode.insertBefore(pair, box); pair.appendChild(box); pair.appendChild(btn);
        });
        window.lunchAllForDate = function (date) {
            if (locked(date)) return;
            startEditing(date);
            var list = picks(date), on = !list.every(function (b) { return b.dataset.v === 'yes'; });
            list.forEach(function (b) { setPick(b, on); });
            touched[date] = true;
            refresh(date);
        };
        // Called by the day's Save: lunch goes with attendance (had lunch / no lunch for each student).
        window.saveLunchForDate = function (date) {
            if (!touched[date]) return;
            var lunch = {};
            picks(date).forEach(function (b) { lunch[b.dataset.student] = b.dataset.v === 'yes' ? 'yes' : 'no'; });
            fetch('/common/saveLunch', { method: 'POST', headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' }, body: JSON.stringify({ lunch: lunch, classId: CLASS_ID, termId: TERM_ID, date: date }) })
                .then(function (r) { return r.json(); })
                .then(function (d) {
                    if (!d.success) { alert(d.message || d.error || 'Lunch wasn\'t saved. Please try again.'); return; }
                    Object.keys(lunch).forEach(function (id) { saved[id] = saved[id] || {}; saved[id][date] = lunch[id] === 'yes'; });
                    touched[date] = false;
                    overall(); refresh(date);
                })
                .catch(function () { alert('Lunch wasn\'t saved. Please try again.'); });
        };
        // Cancel puts the day's lunch back as it was saved.
        var cancel = window.cancelEditMode;
        if (typeof cancel === 'function') {
            window.cancelEditMode = function (date) {
                cancel(date);
                picks(date).forEach(function (b) { setPick(b, (saved[b.dataset.student] || {})[date] === true); });
                touched[date] = false;
                refresh(date);
            };
        }
        sheet.addEventListener('att:mode', function (e) { var d = e.target.dataset && e.target.dataset.date; if (d) refresh(d); });
        Object.keys(dates).forEach(refresh);
        overall();
    })();
    </script>
