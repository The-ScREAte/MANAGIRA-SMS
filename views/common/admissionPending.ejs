  .pa-search input, .pa-tools select { height: 38px; margin: 0; padding: 0 12px; border: 1px solid #e2e8f0; border-radius: 10px; background: #fff; font: inherit; font-size: .9rem; }
  .pa-search input { width: 240px; padding-left: 32px; }
  .pa-empty { padding: 56px 20px; border: 1px dashed #e2e8f0; border-radius: 14px; text-align: center; color: #64748b; }
  .pa-empty i { font-size: 1.8rem; color: #16a34a; }
  .pa-empty h2 { margin: 10px 0 4px; color: #0f172a; font-size: 1.1rem; }
  .pa-none { margin: 0; padding: 18px; color: #64748b; text-align: center; }
  .pending-table tbody tr { cursor: pointer; }
  .pending-table tbody tr[hidden] { display: none; }
  .pending-page .view-btn, .pending-page .view-btn:hover { display: inline-flex; align-items: center; gap: 6px; width: auto; padding: 6px 12px; border: 1px solid #e2e8f0; border-radius: 8px; background: #fff; color: var(--org-primary-color, #0f5a66); font-size: .82rem; font-weight: 700; box-shadow: none; transform: none; }
  .pending-page tr:hover .view-btn { border-color: var(--org-primary-color, #0f5a66); }
  @media (max-width: 640px) { .pa-tools { width: 100%; } .pa-search { flex: 1; } .pa-search input { width: 100%; } }
</style>
<script>
(function () {
  var search = document.getElementById('paSearch'), cls = document.getElementById('paClass'), gender = document.getElementById('paGender');
  function filter() {
    var q = search ? search.value.trim().toLowerCase() : '', c = cls ? cls.value : '', g = gender ? gender.value : '', shown = 0;
    document.querySelectorAll('#pendingStudentsBody tr').forEach(function (row) {
      var hit = (!q || row.dataset.studentName.indexOf(q) !== -1) && (!c || row.dataset.className === c) && (!g || row.dataset.gender === g);
      row.hidden = !hit;
      if (hit) shown++;
    });
    var none = document.getElementById('paNone');
    if (none) none.hidden = shown > 0;
  }
  if (search) search.addEventListener('input', filter);
  if (cls) cls.addEventListener('change', filter);
  if (gender) gender.addEventListener('change', filter);
  var body = document.getElementById('pendingStudentsBody');
  if (body) body.addEventListener('click', function (e) {
    if (e.target.closest('button')) return;
    var row = e.target.closest('tr');
    var btn = row && row.querySelector('.view-btn');
    if (btn) btn.click();
  });
})();
</script>

<script src="<%= assetUrl('/js/dialCodes.js') %>"></script>
<script>
let hasChanges = false;

(function() {
  const buttons = Array.from(document.querySelectorAll('.pending-sort-btn[data-sort-key]'));
  const body = document.getElementById('pendingStudentsBody');
  const state = { key: 'studentName', direction: 'asc' };
  if (!buttons.length || !body) return;
  function sync() {
    buttons.forEach(function(button) {
      const isActive = button.getAttribute('data-sort-key') === state.key;
      const direction = isActive ? state.direction : 'asc';
      const label = button.getAttribute('data-sort-label') || 'items';
      button.setAttribute('data-sort-direction', direction);
      button.setAttribute('aria-label', direction === 'asc' ? 'Sort ' + label + ' descending' : 'Sort ' + label + ' ascending');
    });
  }
  function getValue(row) {
    switch (state.key) {
      case 'dob':
        return String(row.dataset.dob || '');
      case 'gender':
        return String(row.dataset.gender || '');
      case 'className':
        return String(row.dataset.className || '');
      case 'yearGroup':
        return String(row.dataset.yearGroup || '');
      case 'studentName':
      default:
        return String(row.dataset.studentName || '');
    }
  }
  function sortRows() {
    Array.from(body.querySelectorAll('tr[data-student-name]'))
      .sort((a, b) => {
        const valueA = getValue(a);
        const valueB = getValue(b);
        const emptyA = !valueA;
        const emptyB = !valueB;

        if (emptyA && !emptyB) return 1;
        if (!emptyA && emptyB) return -1;

        let comparison = valueA.localeCompare(valueB, undefined, { sensitivity: 'base', numeric: true });
        if (comparison === 0 && state.key !== 'studentName') {
          comparison = String(a.dataset.studentName || '').localeCompare(String(b.dataset.studentName || ''), undefined, { sensitivity: 'base', numeric: true });
        }

        return state.direction === 'desc' ? comparison * -1 : comparison;
      })
      .forEach(row => body.appendChild(row));
  }
  sync();
  sortRows();
  buttons.forEach(function(button) {
    button.addEventListener('click', function() {
      const key = button.getAttribute('data-sort-key') || 'studentName';
      if (state.key === key) {
        state.direction = state.direction === 'asc' ? 'desc' : 'asc';
      } else {
        state.key = key;
        state.direction = 'asc';
      }
      sync();
      sortRows();
    });
  });
})();

function initStudentDetailsDrawer() {
  if (document.body.dataset.pdDrawerInitDone === '1') return;
  document.body.dataset.pdDrawerInitDone = '1';

  const overlay = document.getElementById('studentDetailsOverlay');
  if (overlay) {
    overlay.addEventListener('click', function (event) {
      if (event.target === overlay) closeStudentForm();
    });
  }

  document.addEventListener('keydown', function (event) {
    if (event.key === 'Escape' && overlay && overlay.classList.contains('is-open')) {
      closeStudentForm();
    }
  });
}
initStudentDetailsDrawer();

// Escapes applicant text before it goes into the review form.
const paEsc = (v) => String(v == null ? '' : v).replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));

// Initials for an avatar ("Rachel Bennett" -> "RB").
const paInitials = (first, last) => ((String(first || '').trim()[0] || '') + (String(last || '').trim()[0] || '')).toUpperCase() || '?';
const paAge = (dob) => {
  const d = new Date(dob);
  if (Number.isNaN(d.getTime())) return '';
  const now = new Date();
  let age = now.getFullYear() - d.getUTCFullYear();
  if (now.getMonth() < d.getUTCMonth() || (now.getMonth() === d.getUTCMonth() && now.getDate() < d.getUTCDate())) age--;
  return age >= 0 ? 'Age ' + age : '';
};
const paDate = (v) => {
  const d = new Date(v);
  return Number.isNaN(d.getTime()) ? '' : d.toLocaleDateString(undefined, { month: 'short', day: 'numeric', year: 'numeric' });
};

// One parent / guardian card. Field names are what the server reads.
function guardianCardHtml(g, i) {
  const name = [g.first_name, g.last_name].filter(Boolean).join(' ').trim();
  const phone = String(g.phone || '').trim();
  const email = String(g.email || '').trim();
  return `
    <article class="rv-guardian">
      <header class="rv-guardian-head">
        <span class="rv-guardian-avatar" aria-hidden="true">${paEsc(paInitials(g.first_name, g.last_name))}</span>
        <div class="rv-guardian-name">
          <strong>${paEsc(name || 'New parent or guardian')}</strong>
          <span>Parent / guardian ${i + 1}</span>
        </div>
        <div class="rv-guardian-actions">
          ${phone ? `<a class="rv-icon-btn" href="tel:${paEsc(phone.replace(/[^\d+]/g, ''))}" title="Call ${paEsc(phone)}" aria-label="Call ${paEsc(name || 'guardian')}"><i class="fa-solid fa-phone" aria-hidden="true"></i></a>` : ''}
          ${email ? `<a class="rv-icon-btn" href="mailto:${paEsc(email)}" title="Email ${paEsc(email)}" aria-label="Email ${paEsc(name || 'guardian')}"><i class="fa-solid fa-envelope" aria-hidden="true"></i></a>` : ''}
          <button type="button" class="rv-icon-btn is-danger" data-remove-guardian title="Remove" aria-label="Remove ${paEsc(name || 'this guardian')}"><i class="fa-solid fa-xmark" aria-hidden="true"></i></button>
        </div>
      </header>
      <div class="rv-grid">
        <label class="rv-field"><span>First name</span><input type="text" name="guardianFirstName${i}" value="${paEsc(g.first_name)}" autocomplete="off"></label>
        <label class="rv-field"><span>Last name</span><input type="text" name="guardianLastName${i}" value="${paEsc(g.last_name)}" autocomplete="off"></label>
        <div class="rv-field rv-span"><span>Phone</span>
          <div class="phone-combo" data-default-iso2="GH">
            <select class="phone-dial-select" aria-label="Country code"></select>
            <input type="tel" class="phone-local-input" name="guardianPhone${i}" value="${paEsc(phone)}" aria-label="Phone number">
          </div>
        </div>
        <label class="rv-field"><span>Email</span><input type="email" name="guardianEmail${i}" value="${paEsc(email)}" autocomplete="off"></label>
        <label class="rv-field"><span>Hometown</span><input type="text" name="guardianHometown${i}" value="${paEsc(g.hometown)}" autocomplete="off"></label>
      </div>
    </article>`;
}

// The server reads guardianFirstName0, 1, 2… and stops at a gap, so after a
// card was removed the remaining ones are numbered again before sending.
function renumberGuardians(form) {
  form.querySelectorAll('.rv-guardian').forEach((card, i) => {
    card.querySelectorAll('[name^="guardian"]').forEach((input) => {
      input.name = input.name.replace(/\d+$/, String(i));
    });
  });
}

function setReviewStatus(text, tone) {
  const el = document.getElementById('rvStatus');
  if (!el) return;
  el.textContent = text || '';
  el.dataset.tone = tone || '';
}

async function loadStudentDetails(id) {
  const overlay = document.getElementById('studentDetailsOverlay');
  const container = document.getElementById('studentDetailsContainer');
  container.innerHTML = '<div class="rv-loading"><span class="rv-spinner" aria-hidden="true"></span>Loading application…</div>';
  overlay.classList.add('is-open');
  document.body.style.overflow = 'hidden';
  document.body.classList.add('pa-drawer-open');
  hasChanges = false;

  try {
    const res = await fetch(`/common/getPendingStudentDetails/${id}`);
    const data = await res.json();
    const student = data.student;
    const guardians = data.guardians || [];
    const allSubjects = data.allSubjects || [];
    const classes = data.classes || [];
    const gradGroups = data.graduationYearGroups || [];
    const schoolYears = data.schoolYears || [];
    const studentSubjects = (data.subjects || []).map(s => s.subject_id);
    const hasPhoto = student.image_url && student.image_url !== 'profilePlaceholder.png';
    const fullName = [student.first_name, student.last_name].filter(Boolean).join(' ');
    const className = (classes.find(c => c.class_id === student.class_id) || {}).class_name || '';
    const meta = [className, paAge(student.date_of_birth), student.submitted_at ? 'Applied ' + paDate(student.submitted_at) : ''].filter(Boolean);
    const isFuture = student.enrollment_type === 'future';

    container.innerHTML = `
      <main class="rv">
        <header class="rv-head">
          <div class="rv-avatar">${hasPhoto ? `<img src="${paEsc(student.image_url)}" alt="">` : `<span>${paEsc(paInitials(student.first_name, student.last_name))}</span>`}</div>
          <div class="rv-title">
            <span class="rv-eyebrow">Online application</span>
            <h1 id="studentDetailsTitle">${paEsc(fullName)}</h1>
            <p>${meta.map(paEsc).join(' · ')}</p>
          </div>
          <button type="button" class="rv-close" onclick="closeStudentForm()" aria-label="Close"><i class="fa-solid fa-xmark" aria-hidden="true"></i></button>
        </header>

        <form id="pendingReviewForm" method="POST" enctype="multipart/form-data" class="rv-body">
          <section class="rv-section">
            <h2>Student</h2>
            <div class="rv-grid">
              <label class="rv-field"><span>First name</span><input type="text" name="first_name" value="${paEsc(student.first_name)}" required></label>
              <label class="rv-field"><span>Last name</span><input type="text" name="last_name" value="${paEsc(student.last_name)}" required></label>
              <label class="rv-field"><span>Date of birth</span><input type="date" name="date_of_birth" value="${new Date(student.date_of_birth).toISOString().split('T')[0]}"></label>
              <label class="rv-field"><span>Gender</span>
                <select name="gender">
                  <option value="Male" ${student.gender === 'Male' ? 'selected' : ''}>Male</option>
                  <option value="Female" ${student.gender === 'Female' ? 'selected' : ''}>Female</option>
                </select>
              </label>
              <label class="rv-field rv-span"><span>Hometown</span><input type="text" name="hometown" value="${paEsc(student.hometown)}"></label>
              <div class="rv-field rv-span"><span>Photo</span>
                ${hasPhoto
                  ? `<div class="rv-photo"><img src="${paEsc(student.image_url)}" alt="Student photo"><button type="button" class="rv-link is-danger" onclick="deleteStudentImage(${Number(student.pending_id)})">Remove photo</button></div>`
                  : `<input type="file" name="studentImage" accept="image/*">`}
              </div>
            </div>
          </section>

          <section class="rv-section">
            <h2>Placement</h2>
            <div class="rv-grid">
              <label class="rv-field"><span>Class</span>
                <select name="class_id">
                  ${classes.map(c => `<option value="${c.class_id}" ${c.class_id === student.class_id ? 'selected' : ''}>${paEsc(c.class_name)}</option>`).join('')}
                </select>
              </label>
              <label class="rv-field"><span>Graduation year group</span>
                <select name="graduation_year_group_id">
                  <option value="" ${!student.graduation_year_group_id ? 'selected' : ''}>None</option>
                  ${gradGroups.map(g => `<option value="${g.id}" ${g.id === student.graduation_year_group_id ? 'selected' : ''}>${paEsc(g.name)}</option>`).join('')}
                </select>
              </label>
              <div class="rv-field rv-span"><span>Starts</span>
                <div class="rv-segment" role="radiogroup" aria-label="When the student starts">
                  <label><input type="radio" name="enrollmentType" value="current" ${!isFuture ? 'checked' : ''}><span>This term</span></label>
                  <label><input type="radio" name="enrollmentType" value="future" ${isFuture ? 'checked' : ''}><span>A later term</span></label>
                </div>
              </div>
            </div>
            <div class="rv-grid future-enrollment-section">
              <label class="rv-field"><span>School year</span>
                <select name="schoolYearId" id="schoolYearSelect" onchange="updateTermOptions(this)">
                  <option value="">Select school year</option>
                  ${schoolYears.map(year => `<option value="${year.school_year_id}" data-terms='${paEsc(JSON.stringify(year.terms))}' ${year.school_year_id === student.school_year_id ? 'selected' : ''}>${paEsc(year.year_label)}</option>`).join('')}
                </select>
              </label>
              <label class="rv-field"><span>Term</span>
                <select name="termId" id="termSelect">
                  <option value="">Select term</option>
                  ${(schoolYears.find(y => y.school_year_id === student.school_year_id)?.terms || []).map(term => `<option value="${term.term_id}" ${term.term_id === student.term_id ? 'selected' : ''}>${paEsc(term.term_name)}</option>`).join('')}
                </select>
              </label>
            </div>
          </section>

          <section class="rv-section">
            <div class="rv-section-head"><h2>Subjects</h2>${allSubjects.length ? '<button type="button" class="rv-link" data-all-subjects>Select all</button>' : ''}</div>
            ${allSubjects.length
              ? `<div class="rv-chips">${allSubjects.map(s => `<label class="rv-chip"><input type="checkbox" name="subjects" value="${s.subject_id}" ${studentSubjects.includes(s.subject_id) ? 'checked' : ''}><span>${paEsc(s.subject_name)}</span></label>`).join('')}</div>`
              : '<p class="rv-muted">This class has no subjects yet.</p>'}
          </section>

          ${(data.customAnswers || []).length ? `
          <section class="rv-section">
            <h2>More details</h2>
            <dl class="rv-answers">
              ${data.customAnswers.map((a) => `<div><dt>${paEsc(a.label)}</dt><dd>${paEsc(a.value)}</dd></div>`).join('')}
            </dl>
          </section>` : ''}

          <section class="rv-section">
            <div class="rv-section-head"><h2>Parents &amp; guardians</h2><span class="rv-count" id="rvGuardianCount">${guardians.length}</span></div>
            <div id="guardiansContainer" class="rv-guardians">
              ${guardians.length ? guardians.map((g, i) => guardianCardHtml(g, i)).join('') : ''}
            </div>
            <button type="button" class="rv-add" onclick="addGuardian()"><i class="fa-solid fa-plus" aria-hidden="true"></i> Add parent or guardian</button>
          </section>
        </form>

        <footer class="rv-foot">
          <button type="button" class="rv-btn is-reject" onclick="rejectStudent(${Number(student.pending_id)})">Reject</button>
          <span class="rv-status" id="rvStatus" role="status"></span>
          <button type="button" class="rv-btn" onclick="saveChanges(${Number(student.pending_id)})">Save changes</button>
          <button type="submit" class="rv-btn is-primary" form="pendingReviewForm" onclick="return confirmApprove(event, ${Number(student.pending_id)})">Approve</button>
        </footer>
      </main>
    `;

    const form = document.getElementById('pendingReviewForm');
    if (window.initPhoneCountryCombos) window.initPhoneCountryCombos(container);
    // Any edit counts, as it is typed.
    const markChanged = () => { if (!hasChanges) { hasChanges = true; setReviewStatus('Unsaved changes', 'warn'); } };
    form.addEventListener('input', markChanged);
    form.addEventListener('change', markChanged);
    form.addEventListener('click', (e) => {
      const remove = e.target.closest('[data-remove-guardian]');
      if (remove) {
        remove.closest('.rv-guardian').remove();
        document.getElementById('rvGuardianCount').textContent = form.querySelectorAll('.rv-guardian').length;
        markChanged();
        return;
      }
      if (e.target.closest('[data-all-subjects]')) {
        const boxes = [...form.querySelectorAll('input[name="subjects"]')];
        const all = boxes.every(b => b.checked);
        boxes.forEach(b => { b.checked = !all; });
        markChanged();
      }
    });
    toggleEnrollmentFields();
    form.querySelectorAll('input[name="enrollmentType"]').forEach(el => el.addEventListener('change', toggleEnrollmentFields));
  } catch (err) {
    console.error(err);
    container.innerHTML = '<div class="rv-loading is-error">Could not load this application. Close and try again.</div>';
  }
}

function toggleEnrollmentFields() {
  const selected = document.querySelector('input[name="enrollmentType"]:checked');
  document.querySelectorAll('.future-enrollment-section').forEach(section => {
    section.style.display = (!selected || selected.value === "current") ? "none" : "";
  });
}

function updateTermOptions(selectEl) {
  const terms = JSON.parse(selectEl.options[selectEl.selectedIndex].getAttribute("data-terms") || "[]");
  const termSelect = document.getElementById("termSelect");
  termSelect.innerHTML = '<option value="">Select Term</option>';
  terms.forEach(term => {
    const opt = document.createElement("option");
    opt.value = term.term_id;
    opt.textContent = term.term_name;
    termSelect.appendChild(opt);
  });
}

function confirmApprove(e, id) {
  if (hasChanges) {
    e.preventDefault();
    setReviewStatus('Save your changes before approving.', 'error');
    return false;
  }
  const confirmed = confirm("Approve this application? The student is added to the school and the parents are notified.");
  if (confirmed) {
    const form = document.getElementById('pendingReviewForm');
    renumberGuardians(form);
    if (window.combinePhoneCountryCombos) window.combinePhoneCountryCombos(form);
    form.action = `/common/admissionPending/approve/${id}`;
    return true;
  }
  e.preventDefault();
  return false;
}

// Rejected applications move to the Rejected tab (kept 60 days); this puts one back.
document.addEventListener('click', function (event) {
  const btn = event.target.closest('[data-reverse]');
  if (!btn) return;
  if (!confirm('Move ' + btn.dataset.name + "'s application back to Pending?")) return;
  btn.disabled = true;
  fetch('/common/admissionPending/reverse/' + btn.dataset.reverse, { method: 'POST' })
    .then(function (res) { if (!res.ok) throw new Error(); location.reload(); })
    .catch(function () { btn.disabled = false; alert('Could not reverse the decision. Please try again.'); });
});

function rejectStudent(id) {
  if (confirm("Reject this application? It moves to Rejected, where you can reverse the decision for 60 days.")) {
    fetch(`/common/admissionPending/reject/${id}`, { method: 'POST' })
      .then(() => location.reload())
      .catch(() => setReviewStatus('Could not reject. Please try again.', 'error'));
  }
}

function deleteStudentImage(pendingId) {
  if (!confirm("Remove this student's photo?")) return;
  fetch(`/common/deletePendingStudentImage/${pendingId}`, { method: 'POST' })
    .then(res => { if (res.ok) loadStudentDetails(pendingId); else setReviewStatus('Could not remove the photo.', 'error'); })
    .catch(() => setReviewStatus('Could not remove the photo.', 'error'));
}

function saveChanges(id) {
  const form = document.getElementById("pendingReviewForm");
  if (!form.reportValidity()) return;
  renumberGuardians(form);
  // Sends full numbers (+country code), then puts the boxes back as typed.
  const phoneInputs = [...form.querySelectorAll('.phone-local-input')];
  const typed = phoneInputs.map(i => i.value);
  if (window.combinePhoneCountryCombos) window.combinePhoneCountryCombos(form);
  const formData = new FormData(form);
  phoneInputs.forEach((i, k) => { i.value = typed[k]; });
  setReviewStatus('Saving…', '');
  fetch(`/common/savePendingStudentChanges/${id}`, { method: "POST", body: formData })
    .then(res => res.json())
    .then(data => {
      if (data.success) { hasChanges = false; setReviewStatus('Saved', 'ok'); }
      else setReviewStatus('Could not save. Please try again.', 'error');
    })
    .catch(() => setReviewStatus('Could not save. Please try again.', 'error'));
}

function closeStudentForm() {
  if (hasChanges && !confirm("Close without saving your changes?")) return;
  const overlay = document.getElementById("studentDetailsOverlay");
  const container = document.getElementById("studentDetailsContainer");
  overlay.classList.remove('is-open');
  document.body.style.overflow = '';
  document.body.classList.remove('pa-drawer-open');
  container.innerHTML = '';
  hasChanges = false;
}

function addGuardian() {
  const container = document.getElementById("guardiansContainer");
  // Names must not repeat after a removal: use the next free index.
  let index = 0;
  while (container.querySelector(`[name="guardianFirstName${index}"]`)) index++;
  const wrap = document.createElement("div");
  wrap.innerHTML = guardianCardHtml({}, index).trim();
  const card = wrap.firstElementChild;
  container.appendChild(card);
  if (window.initPhoneCountryCombos) window.initPhoneCountryCombos(card);
  document.getElementById('rvGuardianCount').textContent = container.querySelectorAll('.rv-guardian').length;
  hasChanges = true;
  setReviewStatus('Unsaved changes', 'warn');
  card.querySelector('input').focus();
}
</script>
