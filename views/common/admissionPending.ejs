  .pa-head h1 { display: flex; align-items: center; gap: 8px; margin: 0; font-size: 1.35rem; text-align: left; }
  .pa-head p { margin: 4px 0 0; color: #64748b; font-size: .9rem; }
  .pa-count { padding: 1px 9px; border-radius: 999px; background: color-mix(in srgb, var(--org-primary-color, #0f5a66) 13%, transparent); color: var(--org-primary-color, #0f5a66); font-size: .8rem; }
  .pa-tools { display: flex; flex-wrap: wrap; gap: 8px; }
  .pa-search { position: relative; margin: 0; }
