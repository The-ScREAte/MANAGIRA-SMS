  .pa-status { display: inline-flex; gap: 4px; padding: 4px; border: 1px solid #e2e8f0; border-radius: 12px; background: #f8fafc; }
  .pa-status a { display: inline-flex; align-items: center; gap: 6px; padding: 6px 14px; border-radius: 9px; color: #475569; font-size: .88rem; font-weight: 600; text-decoration: none; }
  .pa-status a span { padding: 0 7px; border-radius: 999px; background: #e2e8f0; color: #475569; font-size: .75rem; }
  .pa-status a.is-active { background: #fff; color: #0f172a; box-shadow: 0 1px 2px rgba(15, 23, 42, .08); }
