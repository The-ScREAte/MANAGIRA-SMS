<style>
  .pa-answers dl { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px 16px; margin: 0; }
  .pa-answers dt { font-size: 12px; font-weight: 600; color: #64748b; }
  .pa-answers dd { margin: 2px 0 0; font-size: 14px; color: #0f172a; white-space: pre-wrap; word-break: break-word; }
  @media (max-width: 640px) { .pa-answers dl { grid-template-columns: minmax(0, 1fr); } }

  :root {
    --font-family: "<%= (session && session.fontStyle ? String(session.fontStyle).trim() : 'Inter') %>", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    --primary: var(--org-primary-color, #01535b);
    --primary-hover: var(--org-primary-hover, #014a51);
        --primary-hover-fill: color-mix(in srgb, var(--primary) 88%, white);
    --text-primary: #1e293b;
    --text-secondary: #64748b;
    --border: #e2e8f0;
    --bg-page: #f8fafc;
    --bg-card: #ffffff;
    --success: #059669;
    --error: #dc2626;
    --info: #3b82f6;
  }

  body {
    font-family: var(--font-family);
    background: var(--bg-page);
  }

  .pending-page {
    max-width: none;
    width: 100%;
    margin: 0;
    padding: 24px 16px 60px;
    box-sizing: border-box;
  }

  /* manageClassSubjectAndGradYr.css (loaded globally in the shared <head>
     partial) sets an unscoped `button, select, input[type="text"], ...`
     rule with padding:8px and margin-top:5px. It leaks onto every button,
     select, and text/date input on this page and inside the review drawer.
     Our own selectors already win the padding fight on specificity, but
     margin-top isn't something we set elsewhere, so it still leaks through
     — reset it here instead of touching the shared file (which other pages
     rely on). */
  .pending-page button,
  .pending-page select,
  .pending-page input[type="text"],
  .pending-page input[type="date"],
  .pending-page input[type="month"],
  .pending-page input[type="datetime-local"] {
    margin-top: 0;
  }

  .page-header {
    background: linear-gradient(135deg, var(--primary, #01535b) 0%, #0a7a86 100%);
    border-radius: 16px;
    padding: 28px 32px;
    color: white;
    margin-bottom: 24px;
    box-shadow: 0 4px 20px rgba(1, 83, 91, 0.2);
  }

  .page-header h1 {
    font-size: 1.5rem;
    font-weight: 700;
    margin: 0 0 6px 0;
  }

  .page-header p {
    opacity: 0.9;
    font-size: 0.9rem;
    margin: 0;
  }

  .pending-table-card {
    background: var(--bg-card);
    border-radius: 12px;
    border: 1px solid var(--border);
    overflow: hidden;
    box-shadow: 0 2px 8px rgba(0,0,0,0.04);
  }

  .pending-table {
    width: 100%;
    border-collapse: collapse;
  }

  .pending-table th,
  .pending-table td {
    padding: 16px 20px;
    text-align: left;
    border-bottom: 1px solid var(--border);
  }

  .pending-table th {
    background: #f8fafc;
    font-weight: 600;
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--text-secondary);
  }

  .pending-sort-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 16px;
    height: 16px;
    margin-left: 6px;
    padding: 0;
    border: none;
    background: transparent;
    color: var(--info);
    cursor: pointer;
    opacity: 0.78;
  }
  .pending-sort-btn:hover,
  .pending-sort-btn:focus,
  .pending-sort-btn:active,
  .pending-sort-btn:focus-visible {
    background: transparent !important;
    box-shadow: none !important;
    outline: none;
    color: var(--info);
  }
  .pending-sort-btn svg { width: 10px; height: 10px; }

  .pending-table td {
    font-size: 0.95rem;
    color: var(--text-primary);
  }

  .pending-table tr:hover td {
    background: #f8fafc;
  }

  .pending-table tr:last-child td {
    border-bottom: none;
  }

  .view-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 10px 18px;
    background: var(--info);
    color: white;
    border: none;
    border-radius: 8px;
    font-size: 0.85rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s;
  }

  .view-btn:hover {
    background: #2563eb;
    transform: translateY(-1px);
  }

  /* Student Details drawer — same slide-in-from-right pattern used by the
     "Create School Year" panel on the Management hub's School Years page. */
  .pd-drawer-overlay {
    position: fixed;
    inset: 0;
    background: rgba(10, 20, 30, 0.55);
    backdrop-filter: blur(3px);
    display: none;
    z-index: 10000;
    animation: pdFadeIn 0.2s ease;
  }

  .pd-drawer-overlay.is-open {
    display: flex;
    align-items: stretch;
    justify-content: flex-end;
  }

  @keyframes pdFadeIn {
    from { opacity: 0; }
    to   { opacity: 1; }
  }

  @keyframes pdSlideInRight {
    from { transform: translateX(100%); opacity: 0; }
    to   { transform: translateX(0);    opacity: 1; }
  }

  #studentDetailsContainer {
    position: relative;
    width: 100%;
    max-width: 720px;
    height: 100%;
    background: var(--bg-card);
    padding: 0;
    box-shadow: -8px 0 40px rgba(0, 0, 0, 0.18);
    animation: pdSlideInRight 0.28s cubic-bezier(0.22, 1, 0.36, 1);
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }

  /* Review drawer (built in loadStudentDetails). */
  #studentDetailsContainer .rv { display: flex; flex-direction: column; height: 100%; min-height: 0; color: #0f172a; }
  .rv-loading { display: flex; align-items: center; justify-content: center; gap: 10px; height: 100%; color: #64748b; font-size: .95rem; }
  .rv-loading.is-error { color: #b91c1c; }
  .rv-spinner { width: 18px; height: 18px; border: 2px solid #cbd5e1; border-top-color: var(--primary); border-radius: 50%; animation: rvSpin .8s linear infinite; }
  @keyframes rvSpin { to { transform: rotate(360deg); } }

  .rv-head { display: flex; align-items: center; gap: 14px; padding: calc(18px + env(safe-area-inset-top, 0px)) 22px 18px; border-bottom: 1px solid #e8edf3; background: #fff; flex-shrink: 0; }
  .rv-avatar { width: 56px; height: 56px; border-radius: 16px; flex-shrink: 0; overflow: hidden; display: grid; place-items: center;
    background: color-mix(in srgb, var(--primary) 12%, #fff); color: var(--primary); font-weight: 700; font-size: 1.1rem; }
  .rv-avatar img { width: 100%; height: 100%; object-fit: cover; }
  .rv-title { min-width: 0; flex: 1; }
  .rv-eyebrow { display: block; font-size: .7rem; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; color: #64748b; }
  .rv-title h1 { margin: 2px 0 2px; font-size: 1.3rem; line-height: 1.25; color: #0f172a; overflow-wrap: anywhere; }
  .rv-title p { margin: 0; font-size: .86rem; color: #64748b; }
  .rv-close { width: 36px; height: 36px; flex-shrink: 0; border: 1px solid #e2e8f0; border-radius: 10px; background: #fff; color: #475569; cursor: pointer; display: grid; place-items: center; }
  .rv-close:hover { background: #f1f5f9; color: #0f172a; }

  .rv-body { flex: 1; min-height: 0; overflow-y: auto; padding: 18px 22px 28px; background: #f8fafc; display: flex; flex-direction: column; gap: 14px; }
  .rv-section { background: #fff; border: 1px solid #e8edf3; border-radius: 14px; padding: 16px 18px 18px; }
  .rv-section h2 { margin: 0 0 12px; font-size: .78rem; font-weight: 700; letter-spacing: .07em; text-transform: uppercase; color: #64748b; }
  .rv-section-head { display: flex; align-items: center; justify-content: space-between; gap: 10px; margin-bottom: 12px; }
  .rv-section-head h2 { margin: 0; }
  .rv-count { padding: 1px 8px; border-radius: 999px; background: #eef2f7; color: #475569; font-size: .75rem; font-weight: 700; }
  .rv-muted { margin: 0; color: #64748b; font-size: .9rem; }

  .rv-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px 14px; }
  .rv-grid + .rv-grid { margin-top: 12px; }
  .rv-span { grid-column: 1 / -1; }
  .rv-field { display: flex; flex-direction: column; gap: 6px; margin: 0; min-width: 0; }
  .rv-field > span { font-size: .8rem; font-weight: 600; color: #334155; }
  .rv input[type="text"], .rv input[type="email"], .rv input[type="tel"], .rv input[type="date"], .rv select, .rv input[type="file"] {
    width: 100%; height: 42px; margin: 0; padding: 0 12px; border: 1px solid #d7dee8; border-radius: 10px; background: #fff;
    color: #0f172a; font: inherit; font-size: .92rem; box-shadow: none; transition: border-color .15s, box-shadow .15s; }
  .rv input[type="file"] { padding: 8px 10px; height: auto; }
  .rv input:focus, .rv select:focus { outline: none; border-color: var(--primary); box-shadow: 0 0 0 3px color-mix(in srgb, var(--primary) 16%, transparent); }
  .rv .phone-combo { height: 42px; border-radius: 10px; }
  .rv .phone-combo .phone-local-input { height: 100%; border: 0; box-shadow: none; }

  .rv-photo { display: flex; align-items: center; gap: 14px; }
  .rv-photo img { width: 64px; height: 64px; object-fit: cover; border-radius: 12px; border: 1px solid #e2e8f0; }
  .rv-link { padding: 0; border: 0; background: none; color: var(--primary); font: inherit; font-size: .85rem; font-weight: 600; cursor: pointer; }
  .rv-link.is-danger { color: #b91c1c; }

  .rv-segment { display: inline-flex; padding: 4px; gap: 4px; border: 1px solid #e2e8f0; border-radius: 12px; background: #f8fafc; width: fit-content; }
  .rv-segment label { margin: 0; cursor: pointer; }
  .rv-segment input { position: absolute; opacity: 0; pointer-events: none; }
  .rv-segment span { display: block; padding: 7px 14px; border-radius: 9px; font-size: .86rem; font-weight: 600; color: #475569; }
  .rv-segment input:checked + span { background: #fff; color: #0f172a; box-shadow: 0 1px 2px rgba(15, 23, 42, .1); }
  .rv-segment input:focus-visible + span { outline: 2px solid var(--primary); outline-offset: 1px; }

  .rv-chips { display: flex; flex-wrap: wrap; gap: 8px; }
  .rv-chip { margin: 0; cursor: pointer; }
  .rv-chip input { position: absolute; opacity: 0; pointer-events: none; }
  .rv-chip span { display: inline-flex; align-items: center; gap: 6px; padding: 7px 13px; border: 1px solid #d7dee8; border-radius: 999px; background: #fff; font-size: .86rem; font-weight: 600; color: #334155; transition: all .15s; }
  .rv-chip input:checked + span { border-color: var(--primary); background: color-mix(in srgb, var(--primary) 10%, #fff); color: var(--primary); }
  .rv-chip input:checked + span::before { content: "✓"; font-size: .8rem; }
  .rv-chip input:focus-visible + span { outline: 2px solid var(--primary); outline-offset: 2px; }

  .rv-answers { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px 16px; margin: 0; }
  .rv-answers dt { font-size: .78rem; font-weight: 600; color: #64748b; }
  .rv-answers dd { margin: 3px 0 0; font-size: .92rem; white-space: pre-wrap; word-break: break-word; }

  .rv-guardians { display: flex; flex-direction: column; gap: 12px; }
  .rv-guardian { border: 1px solid #e8edf3; border-radius: 12px; padding: 14px; background: #fcfdfe; }
  .rv-guardian-head { display: flex; align-items: center; gap: 12px; margin-bottom: 14px; }
  .rv-guardian-avatar { width: 40px; height: 40px; border-radius: 50%; flex-shrink: 0; display: grid; place-items: center; font-weight: 700; font-size: .85rem;
    background: color-mix(in srgb, var(--primary) 12%, #fff); color: var(--primary); }
  .rv-guardian-name { flex: 1; min-width: 0; display: flex; flex-direction: column; }
  .rv-guardian-name strong { font-size: .98rem; overflow-wrap: anywhere; }
  .rv-guardian-name span { font-size: .78rem; color: #64748b; }
  .rv-guardian-actions { display: flex; gap: 6px; }
  .rv-icon-btn { width: 34px; height: 34px; display: grid; place-items: center; border: 1px solid #e2e8f0; border-radius: 10px; background: #fff; color: #475569; cursor: pointer; text-decoration: none; font-size: .85rem; }
  .rv-icon-btn:hover { border-color: var(--primary); color: var(--primary); }
  .rv-icon-btn.is-danger:hover { border-color: #fca5a5; background: #fef2f2; color: #b91c1c; }
  .rv-add { display: flex; align-items: center; justify-content: center; gap: 8px; width: 100%; margin-top: 12px; padding: 11px; border: 1.5px dashed #cbd5e1; border-radius: 12px; background: #fff; color: #334155; font: inherit; font-size: .9rem; font-weight: 600; cursor: pointer; }
  .rv-add:hover { border-color: var(--primary); color: var(--primary); background: color-mix(in srgb, var(--primary) 5%, #fff); }

  .rv-foot { display: flex; align-items: center; gap: 10px; flex-shrink: 0; padding: 14px 22px calc(14px + env(safe-area-inset-bottom, 0px)); border-top: 1px solid #e8edf3; background: #fff; }
  .rv-status { flex: 1; min-width: 0; text-align: right; font-size: .84rem; color: #64748b; }
  .rv-status[data-tone="warn"] { color: #b45309; }
  .rv-status[data-tone="ok"] { color: #15803d; }
  .rv-status[data-tone="error"] { color: #b91c1c; }
  #studentDetailsContainer .rv-btn { height: 40px; padding: 0 16px; border: 1px solid #d7dee8; border-radius: 10px; background: #fff; color: #0f172a; font: inherit; font-size: .9rem; font-weight: 600; cursor: pointer; white-space: nowrap; }
  #studentDetailsContainer .rv-btn:hover { background: #f8fafc; border-color: #94a3b8; }
  #studentDetailsContainer .rv-btn.is-reject { border-color: transparent; background: transparent; color: #b91c1c; padding: 0 10px; }
  #studentDetailsContainer .rv-btn.is-reject:hover { background: #fef2f2; }
  /* buttons.css styles every submit button with !important; Approve is the main action here. */
  #studentDetailsContainer .rv-btn.is-primary { background: var(--primary) !important; border-color: var(--primary) !important; color: #fff !important; }
  #studentDetailsContainer .rv-btn.is-primary:hover { filter: brightness(1.06); }

  /* Nothing floats over the drawer (the Setup steps button, the chat button). */
  body.pa-drawer-open .ss-root, body.pa-drawer-open #chatbot-toggle, body.pa-drawer-open .chatbot-toggle { display: none !important; }
  #studentDetailsContainer .rv-btn { width: auto; margin: 0; }
  /* The site-wide heading and select rules (centred, large, full width) don't apply here. */
  #studentDetailsContainer .rv-title h1 { text-align: left; font-size: 1.3rem; letter-spacing: -0.01em; }
  #studentDetailsContainer .rv-section h2 { width: auto; margin: 0 0 12px; text-align: left; font-family: inherit; font-size: .74rem; line-height: 1.2; letter-spacing: .08em; }
  #studentDetailsContainer .rv-section-head h2 { margin: 0; }
  #studentDetailsContainer .rv-link { width: auto; min-width: 0; margin: 0 0 0 auto; padding: 0; height: auto; background: none; box-shadow: none; }
  .pa-tools .pa-search input { width: 240px; }
  .pa-tools select { width: auto; min-width: 150px; height: 38px; }
  .pa-filters .pa-tools { align-items: center; }

  @media (max-width: 560px) {
    .rv-grid, .rv-answers { grid-template-columns: minmax(0, 1fr); }
    .rv-head, .rv-body, .rv-foot { padding-left: 16px; padding-right: 16px; }
    .rv-foot { flex-wrap: wrap; gap: 8px; }
    .rv-status { order: -1; flex-basis: 100%; text-align: left; }
    .rv-status:empty { display: none; }
    #studentDetailsContainer .rv-btn { width: auto; flex: 0 0 auto; margin: 0; }
    #studentDetailsContainer .rv-btn.is-primary { flex: 1 1 auto; }
  }

  @media (max-width: 768px) {
    #studentDetailsContainer {
      max-width: 100%;
    }

    .pending-table, .pending-table thead, .pending-table tbody,
    .pending-table th, .pending-table td, .pending-table tr {
      display: block;
    }

    .pending-table thead {
      display: none;
    }

    .pending-table tr {
      margin-bottom: 16px;
      border: 1px solid var(--border);
      border-radius: 12px;
      padding: 16px;
      background: white;
    }

    .pending-table td {
      padding: 8px 0;
      border: none;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .pending-table td::before {
      content: attr(data-label);
      font-weight: 600;
      color: var(--text-secondary);
      font-size: 0.8rem;
    }
  }
</style>

<%- include('../partials/flash') %>

<div class="pending-page">
  <div id="studentDetailsOverlay" class="pd-drawer-overlay" role="dialog" aria-modal="true" aria-labelledby="studentDetailsTitle">
    <div id="studentDetailsContainer"></div>
  </div>

  <% const _classNames = Array.from(new Set(pendingStudents.map((x) => x.class_name).filter(Boolean))).sort(); %>
  <% const _view = typeof applicationView !== 'undefined' ? applicationView : 'pending'; %>
  <% const _counts = typeof applicationCounts !== 'undefined' ? applicationCounts : { pending: pendingStudents.length, rejected: 0 }; %>
  <% const _keepDays = typeof rejectedKeepDays !== 'undefined' ? rejectedKeepDays : 60; %>
  <% const _embedQs = (typeof isEmbedded !== 'undefined' && isEmbedded) ? '&embed=workspace' : ''; %>
  <% const _all = (_counts.pending || 0) + (_counts.rejected || 0); %>
  <header class="pa-head">
    <div>
      <h1>Online applications <span class="pa-count"><%= pendingStudents.length %></span></h1>
      <% if (_view === 'rejected') { %>
      <p>Rejected applications are kept for <%= _keepDays %> days, then deleted for good. Reverse a decision to move one back to Pending.</p>
      <% } else if (_view === 'all') { %>
      <p>Every application, waiting and rejected.</p>
      <% } else { %>
      <p>Applications waiting for review. Click one to approve or reject it.</p>
      <% } %>
    </div>
  </header>

  <div class="pa-filters">
    <nav class="pa-status" aria-label="Show applications">
      <a href="?view=pending<%= _embedQs %>" class="<%= _view === 'pending' ? 'is-active' : '' %>"<%- _view === 'pending' ? ' aria-current="page"' : '' %>>Pending <span><%= _counts.pending %></span></a>
      <a href="?view=rejected<%= _embedQs %>" class="<%= _view === 'rejected' ? 'is-active' : '' %>"<%- _view === 'rejected' ? ' aria-current="page"' : '' %>>Rejected <span><%= _counts.rejected %></span></a>
      <a href="?view=all<%= _embedQs %>" class="<%= _view === 'all' ? 'is-active' : '' %>"<%- _view === 'all' ? ' aria-current="page"' : '' %>>All <span><%= _all %></span></a>
    </nav>
    <% if (pendingStudents.length) { %>
    <div class="pa-tools">
      <label class="pa-search"><i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i><input type="search" id="paSearch" placeholder="Search by name" aria-label="Search by name" /></label>
      <select id="paGender" aria-label="Gender"><option value="">All genders</option><option value="male">Male</option><option value="female">Female</option></select>
      <% if (_classNames.length > 1) { %>
        <select id="paClass" aria-label="Class"><option value="">All classes</option><% _classNames.forEach((c) => { %><option value="<%= c.toLowerCase() %>"><%= c %></option><% }) %></select>
      <% } %>
    </div>
    <% } %>
  </div>

  <% if (!pendingStudents.length && _view === 'rejected') { %>
    <div class="pa-empty"><i class="fa-regular fa-folder-open" aria-hidden="true"></i><h2>No rejected applications</h2><p>Applications you reject stay here for <%= _keepDays %> days.</p></div>
  <% } else if (!pendingStudents.length && _view === 'all') { %>
    <div class="pa-empty"><i class="fa-regular fa-folder-open" aria-hidden="true"></i><h2>No applications yet</h2><p>Applications sent from your school website appear here.</p></div>
  <% } else if (!pendingStudents.length) { %>
    <div class="pa-empty"><i class="fa-regular fa-circle-check" aria-hidden="true"></i><h2>All caught up</h2><p>New applications appear here for review.</p></div>
  <% } else { %>
  <div class="pending-table-card">
    <table class="pending-table">
      <thead>
        <tr>
          <th>Student Name <button type="button" class="pending-sort-btn" id="pendingStudentSortToggle" data-sort-key="studentName" data-sort-label="students" data-sort-direction="asc" aria-label="Sort students descending"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 12 12" aria-hidden="true" focusable="false"><path fill="currentColor" d="M10 5H2a.5.5 0 0 1-.46-.31.47.47 0 0 1 .11-.54L5.29.5A1 1 0 0 1 6.7.5l3.65 3.65a.49.49 0 0 1 .11.54A.51.51 0 0 1 10 5z"></path><path fill="currentColor" d="M2 7a.5.5 0 0 0-.46.31.47.47 0 0 1 .11.54L5.3 11.5a1 1 0 0 0 1.41 0l3.65-3.65a.49.49 0 0 1 .11-.54A.53.53 0 0 0 10 7z"></path></svg></button></th>
          <th>Date of Birth <button type="button" class="pending-sort-btn" data-sort-key="dob" data-sort-label="birth dates" data-sort-direction="asc" aria-label="Sort birth dates descending"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 12 12" aria-hidden="true" focusable="false"><path fill="currentColor" d="M10 5H2a.5.5 0 0 1-.46-.31.47.47 0 0 1 .11-.54L5.29.5A1 1 0 0 1 6.7.5l3.65 3.65a.49.49 0 0 1 .11.54A.51.51 0 0 1 10 5z"></path><path fill="currentColor" d="M2 7a.5.5 0 0 0-.46.31.47.47 0 0 1 .11.54L5.3 11.5a1 1 0 0 0 1.41 0l3.65-3.65a.49.49 0 0 1 .11-.54A.53.53 0 0 0 10 7z"></path></svg></button></th>
          <th>Gender <button type="button" class="pending-sort-btn" data-sort-key="gender" data-sort-label="genders" data-sort-direction="asc" aria-label="Sort genders descending"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 12 12" aria-hidden="true" focusable="false"><path fill="currentColor" d="M10 5H2a.5.5 0 0 1-.46-.31.47.47 0 0 1 .11-.54L5.29.5A1 1 0 0 1 6.7.5l3.65 3.65a.49.49 0 0 1 .11.54A.51.51 0 0 1 10 5z"></path><path fill="currentColor" d="M2 7a.5.5 0 0 0-.46.31.47.47 0 0 1 .11.54L5.3 11.5a1 1 0 0 0 1.41 0l3.65-3.65a.49.49 0 0 1 .11-.54A.53.53 0 0 0 10 7z"></path></svg></button></th>
          <th>Class <button type="button" class="pending-sort-btn" data-sort-key="className" data-sort-label="classes" data-sort-direction="asc" aria-label="Sort classes descending"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 12 12" aria-hidden="true" focusable="false"><path fill="currentColor" d="M10 5H2a.5.5 0 0 1-.46-.31.47.47 0 0 1 .11-.54L5.29.5A1 1 0 0 1 6.7.5l3.65 3.65a.49.49 0 0 1 .11.54A.51.51 0 0 1 10 5z"></path><path fill="currentColor" d="M2 7a.5.5 0 0 0-.46.31.47.47 0 0 1 .11.54L5.3 11.5a1 1 0 0 0 1.41 0l3.65-3.65a.49.49 0 0 1 .11-.54A.53.53 0 0 0 10 7z"></path></svg></button></th>
          <th>Year Group <button type="button" class="pending-sort-btn" data-sort-key="yearGroup" data-sort-label="year groups" data-sort-direction="asc" aria-label="Sort year groups descending"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 12 12" aria-hidden="true" focusable="false"><path fill="currentColor" d="M10 5H2a.5.5 0 0 1-.46-.31.47.47 0 0 1 .11-.54L5.29.5A1 1 0 0 1 6.7.5l3.65 3.65a.49.49 0 0 1 .11.54A.51.51 0 0 1 10 5z"></path><path fill="currentColor" d="M2 7a.5.5 0 0 0-.46.31.47.47 0 0 1 .11.54L5.3 11.5a1 1 0 0 0 1.41 0l3.65-3.65a.49.49 0 0 1 .11-.54A.53.53 0 0 0 10 7z"></path></svg></button></th>
          <th><%= _view === 'pending' ? 'Action' : 'Status' %></th>
        </tr>
      </thead>
      <tbody id="pendingStudentsBody">
        <% pendingStudents.forEach(student => { %>
        <% const pendingStudentDisplayName = (typeof formatDisplayName === 'function' ? formatDisplayName(student) : [student.first_name, student.last_name].filter(Boolean).join(' ').trim()); %>
        <tr
          data-student-name="<%= pendingStudentDisplayName.toLowerCase() %>"
          data-dob="<%= student.date_of_birth.toISOString().split('T')[0] %>"
          data-gender="<%= String(student.gender || '').toLowerCase() %>"
          data-class-name="<%= String(student.class_name || '').toLowerCase() %>"
          data-year-group="<%= String(student.graduation_group || 'N/A').toLowerCase() %>">
          <td data-label="Name"><strong><%= pendingStudentDisplayName %></strong></td>
          <td data-label="DOB"><%= (typeof formatDisplayDate === 'function' ? formatDisplayDate(student.date_of_birth) : student.date_of_birth.toISOString().split('T')[0]) %></td>
          <td data-label="Gender"><%= student.gender %></td>
          <td data-label="Class"><%= student.class_name %></td>
          <td data-label="Year Group"><%= student.graduation_group || "—" %></td>
          <% if (student.status === 'rejected') { %>
          <td data-label="Decision">
            <div class="pa-decision">
              <span class="pa-rejected">Rejected <%= student.rejected_at ? (typeof formatDisplayDate === 'function' ? formatDisplayDate(student.rejected_at) : new Date(student.rejected_at).toISOString().split('T')[0]) : '' %><%= student.rejected_by_name ? ' by ' + student.rejected_by_name : '' %></span>
              <small>Deleted in <%= student.days_left %> <%= student.days_left === 1 ? 'day' : 'days' %></small>
            </div>
            <button type="button" class="view-btn pa-reverse" data-reverse="<%= student.pending_id %>" data-name="<%= pendingStudentDisplayName %>">Reverse decision</button>
          </td>
          <% } else { %>
          <td data-label="Action">
            <button type="button" class="view-btn" onclick="loadStudentDetails(<%= student.pending_id %>)">Review <i class="fa-solid fa-chevron-right" aria-hidden="true"></i></button>
          </td>
          <% } %>
        </tr>
        <% }) %>
      </tbody>
    </table>
    <p class="pa-none" id="paNone" hidden>No applications match.</p>
  </div>
  <% } %>
</div>
<style>
