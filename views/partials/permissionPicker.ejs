<%#
  Permissions, one per line, as switches. A main permission's follow-ups stay
  collapsed until it is on and opened with its arrow.
  Expects: permissionOptions, selectedPermissions, classes; optional mailroomScope
  and enrolledMailroomClasses.
%>
<%
  const _options = permissionOptions || [];
  const _selected = (typeof selectedPermissions !== 'undefined' && selectedPermissions) || [];
  const _scope = typeof mailroomScope !== 'undefined' ? mailroomScope : 'all';
  const _canHighRisk = typeof canAssignHighRisk === 'undefined' ? true : canAssignHighRisk;
  const _mailroomClasses = (typeof enrolledMailroomClasses !== 'undefined' && enrolledMailroomClasses) || [];
  const _childrenOf = (key) => _options.filter((o) => o.parent === key);
  const _groups = [...new Set(_options.filter((o) => !o.parent).map((o) => o.group))];
  const _renderNode = (option) => {
    const children = _childrenOf(option.key);
%>
  <div class="perm-node" data-permission-node="<%= option.key %>">
    <label class="perm-row permission-item" data-permission-key="<%= option.key %>">
      <span class="perm-text">
        <span class="perm-title"><%= option.label %></span>
        <% if (option.description) { %><span class="perm-desc"><%= option.description %></span><% } %>
      </span>
      <% if (option.highRisk) { %>
        <span class="perm-risk"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3 2 21h20L12 3Zm0 7v5m0 3v.01" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>High Risk</span>
      <% } %>
      <% if (children.length || option.key === 'mailroom') { %>
        <span class="perm-count" data-perm-count></span>
        <button type="button" class="perm-caret" data-perm-caret aria-label="Show <%= option.label %> options" aria-expanded="false"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m9 6 6 6-6 6" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
      <% } %>
      <% const _locked = option.highRisk && !_canHighRisk; %>
      <% if (_locked && _selected.includes(option.key)) { %><input type="hidden" name="permissions" value="<%= option.key %>"><% } %>
      <input type="checkbox" class="perm-switch" role="switch" <%= _locked ? 'disabled' : 'name=permissions' %> value="<%= option.key %>" <%= _selected.includes(option.key) ? 'checked' : '' %> <%= _locked ? 'title=Only managers can change this' : '' %>>
    </label>
    <% if (option.key === 'mailroom') { %>
      <div class="perm-children" id="mailroomScopePanel">
        <span class="perm-children-title">Who they can message</span>
        <label class="perm-choice"><input type="radio" name="mailroomScope" value="all" <%= _scope !== 'classes' ? 'checked' : '' %>><span>All contacts (every class)</span></label>
        <label class="perm-choice"><input type="radio" name="mailroomScope" value="classes" <%= _scope === 'classes' ? 'checked' : '' %>><span>Only guardians of students in selected classes</span></label>
        <div class="perm-class-list" id="mailroomClassesGrid">
          <% (classes || []).forEach((cls) => { %>
            <label class="perm-choice"><input type="checkbox" name="mailroomClassIds" value="<%= cls.class_id %>" <%= _mailroomClasses.includes(cls.class_id) ? 'checked' : '' %>><span><%= cls.class_name %></span></label>
          <% }) %>
        </div>
      </div>
    <% } else if (children.length) { %>
      <div class="perm-children">
        <% if (option.childrenRequired) { %>
          <span class="perm-required"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9" fill="none" stroke="currentColor" stroke-width="2"/><path d="M12 7v6m0 4v.01" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg><%= option.childrenRequired %></span>
        <% } %>
        <% children.forEach(_renderNode) %>
      </div>
    <% } %>
  </div>
<% }; %>
<div class="perm-picker" id="permissionPicker">
  <% _groups.forEach((group) => { %>
    <section class="perm-group">
      <h4 class="perm-group-title"><%= group %></h4>
      <% _options.filter((o) => !o.parent && o.group === group).forEach(_renderNode) %>
    </section>
  <% }) %>
</div>
<style>
  .perm-picker[hidden] { display: none; }
  .perm-picker { display: grid; gap: 14px; margin-top: 6px; }
  .perm-group { min-width: 0; }
  .perm-group-title { margin: 0; padding-bottom: 4px; font-size: 0.66rem; font-weight: 700; letter-spacing: .06em; text-transform: uppercase; opacity: .62; border-bottom: 1px solid color-mix(in srgb, currentColor 18%, transparent); }
  .perm-node { min-width: 0; }
  .perm-group > .perm-node + .perm-node { border-top: 1px solid color-mix(in srgb, currentColor 10%, transparent); }
  .perm-picker .perm-row { display: flex !important; flex-direction: row; align-items: center; gap: 8px; width: 100%; min-height: 34px; margin: 0; padding: 5px 0; cursor: pointer; font-weight: 400; }
  .perm-text { display: grid; gap: 1px; flex: 1 1 auto; min-width: 0; }
  .perm-title { font-size: 0.82rem; font-weight: 600; line-height: 1.25; }
  .perm-desc { font-size: 0.72rem; font-weight: 400; line-height: 1.3; opacity: .68; }
  .perm-risk { display: inline-flex; flex: 0 0 auto; align-items: center; gap: 3px; padding: 1px 5px; border: 1px solid #d97706; border-radius: 4px; background: color-mix(in srgb, #f59e0b 12%, transparent); color: #d97706; font-size: 0.64rem; font-weight: 600; white-space: nowrap; }
  .perm-risk svg, .perm-required svg { width: 11px; height: 11px; flex: 0 0 auto; }
  .perm-count { display: none; flex: 0 0 auto; font-size: 0.68rem; opacity: .62; white-space: nowrap; }
  .perm-picker .perm-caret { display: none; flex: 0 0 auto; align-items: center; justify-content: center; width: 22px !important; min-width: 22px; height: 22px !important; margin: 0 !important; padding: 0 !important; border: 0 !important; border-radius: 5px; background: transparent !important; box-shadow: none !important; color: inherit !important; opacity: .7; cursor: pointer; }
  .perm-picker .perm-caret:hover { background: color-mix(in srgb, currentColor 10%, transparent) !important; opacity: 1; }
  .perm-picker .perm-caret svg { width: 14px; height: 14px; transition: transform .12s ease; }
  .perm-node:has(> .perm-row input.perm-switch:checked) > .perm-row > .perm-caret { display: inline-flex; }
  .perm-node:has(> .perm-row input.perm-switch:checked) > .perm-row > .perm-count { display: inline; }
  .perm-node.is-open > .perm-row > .perm-caret svg { transform: rotate(90deg); }
  .perm-picker input.perm-switch { flex: 0 0 auto; appearance: none; -webkit-appearance: none; position: relative; width: 28px !important; min-width: 28px; height: 16px !important; margin: 0 !important; padding: 0 !important; border: 0 !important; border-radius: 999px; background: #94a3b8; box-shadow: none !important; cursor: pointer; transition: background .12s ease; }
  .perm-picker input.perm-switch::after { content: ""; position: absolute; top: 2px; left: 2px; width: 12px; height: 12px; border-radius: 50%; background: #fff; box-shadow: 0 1px 2px rgba(15, 23, 42, .3); transition: transform .12s ease; }
  .perm-picker input.perm-switch:checked { background: var(--org-primary-color, var(--primary, #01535b)); }
  .perm-picker input.perm-switch:checked::after { transform: translateX(12px); }
  .perm-picker input.perm-switch:disabled { opacity: .5; cursor: not-allowed; }
  .perm-picker input.perm-switch:focus-visible { outline: 2px solid var(--org-primary-color, #01535b); outline-offset: 2px; }
  .perm-children { display: none; gap: 0; margin: 0 0 6px 4px; padding: 0 0 0 10px; border-left: 2px solid color-mix(in srgb, var(--org-primary-color, #01535b) 35%, transparent); }
  .perm-node.is-open:has(> .perm-row input.perm-switch:checked) > .perm-children { display: grid; }
  .perm-node:not(.is-open) > .perm-children, .perm-node:not(:has(> .perm-row input.perm-switch:checked)) > .perm-children { display: none !important; }
  .perm-children .perm-title { font-weight: 500; }
  .perm-children > .perm-node + .perm-node { border-top: 1px solid color-mix(in srgb, currentColor 8%, transparent); }
  .perm-children-title { font-size: 0.74rem; font-weight: 600; padding-top: 3px; }
  .perm-required { display: none; align-items: center; gap: 4px; padding: 2px 0; color: #dc2626; font-size: 0.72rem; }
  .perm-children:not(:has(> .perm-node > .perm-row input.perm-switch:checked)) > .perm-required { display: flex; }
  .perm-picker .perm-choice { display: flex !important; flex-direction: row; align-items: center; gap: 6px; margin: 0; padding: 3px 0; font-size: 0.78rem; font-weight: 400; cursor: pointer; }
  .perm-picker .perm-choice input { width: 14px !important; height: 14px; margin: 0 !important; flex: 0 0 auto; accent-color: var(--org-primary-color, #01535b); }
  .perm-class-list { display: none; gap: 0; padding-left: 20px; }
  @media (max-width: 480px) {
    .perm-picker .perm-row { flex-wrap: wrap; }
    .perm-text { flex-basis: calc(100% - 70px); }
    .perm-risk { order: 3; }
  }
</style>
<script>
  (function () {
    var picker = document.getElementById('permissionPicker');
    var form = picker && picker.closest('form');
    if (!form || form.dataset.permissionPickerBound) return;
    form.dataset.permissionPickerBound = '1';

    var rowSwitch = function (node) { return node.querySelector(':scope > .perm-row input.perm-switch'); };
    var setOpen = function (node, open) {
      node.classList.toggle('is-open', open);
      var caret = node.querySelector(':scope > .perm-row > .perm-caret');
      if (caret) caret.setAttribute('aria-expanded', open ? 'true' : 'false');
    };
    var refresh = function () {
      picker.querySelectorAll('[data-perm-count]').forEach(function (count) {
        var children = count.closest('.perm-node').querySelectorAll(':scope > .perm-children > .perm-node');
        var on = Array.prototype.filter.call(children, function (node) { return rowSwitch(node).checked; }).length;
        count.textContent = children.length ? on + ' of ' + children.length : '';
      });
    };
    // Role presets change switches from code, so the forms ask for a recount.
    window.ManagiraPermissionPicker = { refresh: refresh };

    picker.addEventListener('click', function (event) {
      var caret = event.target.closest('[data-perm-caret]');
      if (!caret) return;
      event.preventDefault();
      var node = caret.closest('.perm-node');
      setOpen(node, !node.classList.contains('is-open'));
    });
    picker.addEventListener('change', function (event) {
      if (!event.target.matches('input.perm-switch')) return;
      var node = event.target.closest('.perm-node');
      // Turning a main permission on opens its choices; turning it off folds them.
      if (node.querySelector(':scope > .perm-children')) setOpen(node, event.target.checked);
      refresh();
    });

    // A main permission that needs a follow-up can't be saved without one.
    form.addEventListener('submit', function (event) {
      var missing = Array.prototype.find.call(picker.querySelectorAll('.perm-required'), function (note) {
        var children = note.parentElement;
        var node = children.parentElement;
        if (!rowSwitch(node).checked) return false;
        for (var up = node.parentElement.closest('.perm-node'); up; up = up.parentElement.closest('.perm-node')) {
          if (!rowSwitch(up).checked) return false;
        }
        return !Array.prototype.some.call(children.querySelectorAll(':scope > .perm-node'), function (child) { return rowSwitch(child).checked; });
      });
      if (!missing) return;
      event.preventDefault();
      event.stopImmediatePropagation();
      for (var node = missing.closest('.perm-node'); node; node = node.parentElement.closest('.perm-node')) setOpen(node, true);
      missing.scrollIntoView({ block: 'center', behavior: 'smooth' });
    }, true);
    refresh();
  })();
</script>
