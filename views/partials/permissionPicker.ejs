<%#
  Permissions as switches: simple by default, detailed on request. No descriptions: a name and a switch, a divider after each.
  Nothing shows until a role is chosen. Then only that role's basics (utils/permissionBasics.js), already
  on, in a few bundles; everything else is behind "Advanced permissions". High-risk permissions
  show only for Manager. What someone already holds outside the role's basics shows in Advanced,
  marked "Extra". A main permission's follow-ups stay collapsed until it is on and opened with its arrow.
  The same switches (name="permissions") are submitted as before: only the screen is new.
  Expects: permissionOptions, selectedPermissions, classes, permissionUi (utils/permissionBasics.js pageData);
  optional mailroomScope and enrolledMailroomClasses.
%>
<%
  const _options = permissionOptions || [];
  const _selected = (typeof selectedPermissions !== 'undefined' && selectedPermissions) || [];
  const _scope = typeof mailroomScope !== 'undefined' ? mailroomScope : 'all';
  const _canHighRisk = typeof canAssignHighRisk === 'undefined' ? true : canAssignHighRisk;
  const _mailroomClasses = (typeof enrolledMailroomClasses !== 'undefined' && enrolledMailroomClasses) || [];
  const _ui = (typeof permissionUi !== 'undefined' && permissionUi) || { bundles: [], json: '{}', logic: '' };
  const _childrenOf = (key) => _options.filter((o) => o.parent === key);
  const _groups = [...new Set(_options.filter((o) => !o.parent).map((o) => o.group))];
  const _renderNode = (option) => {
    const children = _childrenOf(option.key);
%>
  <div class="perm-node" data-permission-node="<%= option.key %>" data-perm-order="<%= _options.indexOf(option) %>"<% if (option.forDrivers) { %> data-perm-driver<% } %><% if (option.forLeadDrivers) { %> data-perm-lead<% } %>>
    <label class="perm-row permission-item" data-permission-key="<%= option.key %>"<% if (option.description) { %> title="<%= option.description %>"<% } %><% if (option.presets) { %> data-perm-presets="<%= option.presets.join(' ') %>"<% } %>>
      <span class="perm-text">
        <span class="perm-title"><%= option.label %></span>
      </span>
      <span class="perm-extra-tag">Extra</span>
      <% if (option.highRisk) { %>
        <span class="perm-risk"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3 2 21h20L12 3Zm0 7v5m0 3v.01" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>High Risk</span>
      <% } %>
      <% if (children.length || option.key === 'mailroom') { %>
        <span class="perm-count" data-perm-count></span>
        <button type="button" class="perm-caret" data-perm-caret aria-label="Show <%= option.label %> options" aria-expanded="false"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m9 6 6 6-6 6" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
      <% } %>
      <% const _locked = option.highRisk && !_canHighRisk; %>
      <% if (_locked && _selected.includes(option.key)) { %><input type="hidden" name="permissions" value="<%= option.key %>"><% } %>
      <input type="checkbox" class="perm-switch" role="switch" <%= _locked ? 'disabled' : 'name=permissions' %> value="<%= option.key %>" <%= _selected.includes(option.key) ? 'checked' : '' %> <%= _locked ? 'title=Only managers can change this' : '' %>>
    </label>
    <% if (option.key === 'mailroom') { %>
      <div class="perm-children" id="mailroomScopePanel">
        <span class="perm-children-title">Who they can message</span>
        <label class="perm-choice"><input type="radio" name="mailroomScope" value="all" <%= _scope !== 'classes' ? 'checked' : '' %>><span>All contacts (every class)</span></label>
        <label class="perm-choice"><input type="radio" name="mailroomScope" value="classes" <%= _scope === 'classes' ? 'checked' : '' %>><span>Only guardians of students in selected classes</span></label>
        <div class="perm-class-list" id="mailroomClassesGrid">
          <% (classes || []).forEach((cls) => { %>
            <label class="perm-choice"><input type="checkbox" name="mailroomClassIds" value="<%= cls.class_id %>" <%= _mailroomClasses.includes(cls.class_id) ? 'checked' : '' %>><span><%= cls.class_name %></span></label>
          <% }) %>
        </div>
      </div>
    <% } else if (children.length) { %>
      <div class="perm-children">
        <% if (option.childrenRequired) { %>
          <span class="perm-required"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9" fill="none" stroke="currentColor" stroke-width="2"/><path d="M12 7v6m0 4v.01" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg><%= option.childrenRequired %></span>
        <% } %>
        <% children.forEach(_renderNode) %>
      </div>
    <% } %>
  </div>
<% }; %>
<div class="perm-picker" id="permissionPicker" data-can-high-risk="<%= _canHighRisk ? '1' : '' %>">
  <p class="perm-choose" id="permChoose">Choose a role to see its permissions.</p>
  <div class="perm-body" id="permBody" hidden>
    <div class="perm-basics" id="permBasics">
      <% _ui.bundles.forEach((bundle) => { %>
        <section class="perm-bundle" data-perm-bundle="<%= bundle.id %>" hidden>
          <h4 class="perm-bundle-title"><%= bundle.label %></h4>
          <div class="perm-bundle-nodes"></div>
        </section>
      <% }) %>
    </div>
    <button type="button" class="perm-adv-btn" id="permAdvBtn" aria-expanded="false" aria-controls="permAdvanced">
      <span>Advanced permissions<span class="perm-adv-count" id="permAdvCount"></span></span>
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m6 9 6 6 6-6" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
    </button>
    <div class="perm-advanced" id="permAdvanced" hidden>
      <% _groups.forEach((group) => { %>
        <section class="perm-group" data-perm-group="<%= group %>">
          <h4 class="perm-group-title"><%= group %></h4>
          <% _options.filter((o) => !o.parent && o.group === group).forEach(_renderNode) %>
        </section>
      <% }) %>
      <section class="perm-hr" id="permHighRisk" hidden>
        <button type="button" class="perm-hr-toggle" id="permHrBtn" aria-expanded="false" aria-controls="permHrBody">
          <span>High risk - Managers only</span>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m6 9 6 6 6-6" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
        <div id="permHrBody" hidden>
          <div class="perm-hr-nodes"></div>
        </div>
      </section>
      <section class="perm-allbox" id="permAllBox" hidden>
        <button type="button" class="perm-btn" id="permAllOpen">Allow all permissions</button>
      </section>
    </div>
  </div>
  <script type="application/json" id="permData"><%- _ui.json %></script>
</div>
<style>
  .perm-picker[hidden] { display: none; }
  .perm-picker { display: grid; gap: 14px; margin-top: 6px; }
  .perm-body { display: grid; gap: 14px; }
  .perm-body[hidden], .perm-choose[hidden] { display: none; }
  .perm-group { min-width: 0; }
  .perm-group-title { margin: 0; padding-bottom: 6px; font-size: 0.7rem; font-weight: 700; letter-spacing: .06em; text-transform: uppercase; opacity: .62; border-bottom: 1px solid color-mix(in srgb, currentColor 18%, transparent); }
  .perm-node { min-width: 0; border-bottom: 1px solid color-mix(in srgb, currentColor 13%, transparent); }
  .perm-children .perm-node:last-child { border-bottom: 0; }
  .perm-node[hidden], .perm-group[hidden] { display: none; }
  .perm-picker .perm-row { display: flex !important; flex-direction: row; align-items: center; gap: 8px; width: 100%; min-height: 46px; margin: 0; padding: 8px 0; cursor: pointer; font-weight: 400; }
  .perm-text { display: grid; gap: 1px; flex: 1 1 auto; min-width: 0; }
  .perm-title { font-size: 0.92rem; font-weight: 500; line-height: 1.3; }
  .perm-risk { display: inline-flex; flex: 0 0 auto; align-items: center; gap: 3px; padding: 1px 5px; border: 1px solid #d97706; border-radius: 4px; background: color-mix(in srgb, #f59e0b 12%, transparent); color: #d97706; font-size: 0.64rem; font-weight: 600; white-space: nowrap; }
  .perm-risk svg, .perm-required svg { width: 11px; height: 11px; flex: 0 0 auto; }
  .perm-count { display: none; flex: 0 0 auto; font-size: 0.68rem; opacity: .62; white-space: nowrap; }
  .perm-picker .perm-caret { display: none; flex: 0 0 auto; align-items: center; justify-content: center; width: 22px !important; min-width: 22px; height: 22px !important; margin: 0 !important; padding: 0 !important; border: 0 !important; border-radius: 5px; background: transparent !important; box-shadow: none !important; color: inherit !important; opacity: .7; cursor: pointer; }
  .perm-picker .perm-caret:hover { background: color-mix(in srgb, currentColor 10%, transparent) !important; opacity: 1; }
  .perm-picker .perm-caret svg { width: 14px; height: 14px; transition: transform .12s ease; }
  .perm-node:has(> .perm-row input.perm-switch:checked) > .perm-row > .perm-caret { display: inline-flex; }
  .perm-node:has(> .perm-row input.perm-switch:checked) > .perm-row > .perm-count { display: inline; }
  .perm-node.is-open > .perm-row > .perm-caret svg { transform: rotate(90deg); }
  .perm-picker input.perm-switch { flex: 0 0 auto; appearance: none; -webkit-appearance: none; position: relative; width: 26px !important; min-width: 26px; height: 15px !important; margin: 0 !important; padding: 0 !important; border: 0 !important; border-radius: 999px; background: #94a3b8; box-shadow: none !important; cursor: pointer; transition: background .12s ease; }
  .perm-picker input.perm-switch::after { content: ""; position: absolute; top: 2px; left: 2px; width: 11px; height: 11px; border-radius: 50%; background: #fff; box-shadow: 0 1px 2px rgba(15, 23, 42, .3); transition: transform .12s ease; }
  .perm-picker input.perm-switch:checked { background: var(--org-primary-color, var(--primary, #01535b)); }
  .perm-picker input.perm-switch:checked::after { transform: translateX(11px); }
  .perm-picker input.perm-switch:disabled { opacity: .5; cursor: not-allowed; }
  .perm-picker input.perm-switch:focus-visible { outline: 2px solid var(--org-primary-color, #01535b); outline-offset: 2px; }
  .perm-children { display: none; gap: 0; margin: 0 0 6px 4px; padding: 0 0 0 10px; border-left: 2px solid color-mix(in srgb, var(--org-primary-color, #01535b) 35%, transparent); }
  .perm-node.is-open:has(> .perm-row input.perm-switch:checked) > .perm-children { display: grid; }
  .perm-node:not(.is-open) > .perm-children, .perm-node:not(:has(> .perm-row input.perm-switch:checked)) > .perm-children { display: none !important; }
  .perm-children .perm-title { font-weight: 500; }
  .perm-children-title { font-size: 0.74rem; font-weight: 600; padding-top: 3px; }
  .perm-required { display: none; align-items: center; gap: 4px; padding: 2px 0; color: #dc2626; font-size: 0.72rem; }
  .perm-children:not(:has(> .perm-node > .perm-row input.perm-switch:checked)) > .perm-required { display: flex; }
  .perm-picker .perm-choice { display: flex !important; flex-direction: row; align-items: center; gap: 6px; margin: 0; padding: 3px 0; font-size: 0.78rem; font-weight: 400; cursor: pointer; }
  .perm-picker .perm-choice input { width: 14px !important; height: 14px; margin: 0 !important; flex: 0 0 auto; accent-color: var(--org-primary-color, #01535b); }
  .perm-class-list { display: none; gap: 0; padding-left: 20px; }

  .perm-choose { margin: 0; padding: 18px 14px; border: 1px dashed color-mix(in srgb, currentColor 25%, transparent); border-radius: 10px; font-size: 0.86rem; opacity: .75; text-align: center; }
  .perm-basics { display: grid; gap: 22px; }
  .perm-bundle[hidden], .perm-basics[hidden], .perm-switch-list[hidden], .perm-hr[hidden], .perm-allbox[hidden], .perm-switch-box[hidden], .perm-advanced[hidden] { display: none; }
  .perm-bundle-title { margin: 0 0 2px; padding-bottom: 6px; font-size: 0.7rem; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; opacity: .6; border-bottom: 1px solid color-mix(in srgb, currentColor 22%, transparent); }
  .perm-adv-btn, .perm-hr-toggle { display: flex; align-items: center; justify-content: space-between; gap: 10px; width: 100%; margin: 0; padding: 10px 12px; border: 1px solid color-mix(in srgb, currentColor 22%, transparent); border-radius: 10px; background: transparent; color: inherit; font: inherit; font-size: 0.86rem; font-weight: 600; cursor: pointer; text-align: left; }
  .perm-adv-btn:hover, .perm-hr-toggle:hover { background: color-mix(in srgb, currentColor 6%, transparent); }
  .perm-adv-btn:focus-visible, .perm-hr-toggle:focus-visible, .perm-btn:focus-visible { outline: 2px solid var(--org-primary-color, #01535b); outline-offset: 2px; }
  .perm-adv-btn svg, .perm-hr-toggle svg { width: 16px; height: 16px; flex: 0 0 auto; transition: transform .12s ease; }
  .perm-adv-btn[aria-expanded="true"] svg, .perm-hr-toggle[aria-expanded="true"] svg { transform: rotate(180deg); }
  .perm-adv-count { margin-left: 6px; padding: 1px 7px; border-radius: 999px; background: color-mix(in srgb, #d97706 16%, transparent); color: #b45309; font-size: 0.7rem; font-weight: 700; }
  .perm-adv-count:empty { display: none; }
  .perm-advanced { display: grid; gap: 14px; }
  .perm-hr { display: grid; gap: 8px; padding: 10px; border: 1px solid color-mix(in srgb, #d97706 45%, transparent); border-radius: 10px; background: color-mix(in srgb, #f59e0b 6%, transparent); }
  .perm-hr > div[hidden] { display: none; }
  .perm-hr-warn { margin: 0 0 6px; font-size: 0.76rem; line-height: 1.4; color: #b45309; }
  .perm-extra-tag { display: none; flex: 0 0 auto; padding: 1px 6px; border-radius: 4px; background: color-mix(in srgb, var(--org-primary-color, #01535b) 14%, transparent); color: var(--org-primary-color, #01535b); font-size: 0.64rem; font-weight: 700; text-transform: uppercase; letter-spacing: .04em; }
  .perm-node.is-extra > .perm-row > .perm-extra-tag { display: inline-block; }
  .perm-switch-actions { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 10px; align-items: center; }
  .perm-picker .perm-btn { margin: 0; padding: 8px 14px; border: 1px solid color-mix(in srgb, currentColor 25%, transparent); border-radius: 8px; background: transparent; color: inherit; font: inherit; font-size: 0.8rem; font-weight: 600; cursor: pointer; width: auto; }
  .perm-picker .perm-btn--main { border-color: transparent; background: var(--org-primary-color, #01535b); color: #fff; }
  .perm-picker .perm-btn[disabled] { opacity: .5; cursor: not-allowed; }
  @media (max-width: 480px) {
    .perm-picker .perm-row { flex-wrap: nowrap; gap: 6px; }
    .perm-text { flex: 1 1 0; }
    .perm-count { font-size: 0.64rem; }
    .perm-adv-btn, .perm-hr-toggle { font-size: 0.82rem; }
  }
</style><script>
<%- _ui.logic %>
</script>
<script>
  (function () {
    var picker = document.getElementById('permissionPicker');
    var form = picker && picker.closest('form');
    if (!form || form.dataset.permissionPickerBound) return;
    form.dataset.permissionPickerBound = '1';
    var L = window.ManagiraPermissionLogic;
    var data = {};
    try { data = JSON.parse(document.getElementById('permData').textContent || '{}'); } catch (e) { data = {}; }
    var maps = data.roleBasics || {};
    var highRisk = new Set(data.highRisk || []);
    var canHighRisk = picker.getAttribute('data-can-high-risk') === '1';
    var $ = function (id) { return picker.querySelector('#' + id); };
    var chooseEl = $('permChoose'), bodyEl = $('permBody'), basicsEl = $('permBasics');
    var advBtn = $('permAdvBtn'), advEl = $('permAdvanced'), advCount = $('permAdvCount');
    var hrEl = $('permHighRisk'), hrBtn = $('permHrBtn'), hrBody = $('permHrBody');
    var allBox = $('permAllBox');
    var select = form.querySelector('select[name="accountType"], select[name="account_type"]');

    var rowSwitch = function (node) { return node.querySelector(':scope > .perm-row input.perm-switch'); };
    var keyOf = function (node) { return node.getAttribute('data-permission-node'); };
    var allSwitches = function () { return Array.prototype.slice.call(picker.querySelectorAll('input.perm-switch')); };
    var held = function () { return allSwitches().filter(function (box) { return box.checked; }).map(function (box) { return box.value; }); };
    var labelOf = function (key) { return (data.label && data.label[key]) || key; };
    var setOpen = function (node, open) {
      node.classList.toggle('is-open', open);
      var caret = node.querySelector(':scope > .perm-row > .perm-caret');
      if (caret) caret.setAttribute('aria-expanded', open ? 'true' : 'false');
    };

    // The top-level permissions, with the group each one belongs to and its place in the list.
    var tops = Array.prototype.slice.call(picker.querySelectorAll('.perm-advanced > .perm-group > .perm-node')).map(function (node) {
      return { node: node, key: keyOf(node), home: node.parentElement, order: Number(node.getAttribute('data-perm-order')) || 0 };
    });
    var put = function (container, item) {
      var before = Array.prototype.find.call(container.children, function (el) {
        return el !== item.node && el.classList.contains('perm-node') && Number(el.getAttribute('data-perm-order')) > item.order;
      });
      container.insertBefore(item.node, before || null);
    };

    // The role in the Role select: a built-in one, or one of the school's own (its own permissions are its basics).
    var roleInfo = function () {
      if (!select || !select.value) return null;
      var option = select.options[select.selectedIndex];
      var roleId = option && option.dataset ? option.dataset.roleId : '';
      var basics;
      if (roleId) { try { basics = JSON.parse(option.dataset.permissions || '[]'); } catch (e) { basics = []; } }
      else basics = maps[select.value] || [];
      var name = roleId ? option.dataset.roleName : select.value;
      return { id: roleId ? 'r' + roleId : select.value, type: select.value, name: name, basics: basics, isManager: select.value === 'Manager', isDriver: select.value === 'Driver' };
    };
    var committed = roleInfo();   // the role the switches are laid out for
        var bulk = false;

    var advOpen = function (open, remember) {
      advEl.hidden = !open;
      advBtn.setAttribute('aria-expanded', open ? 'true' : 'false');
      if (remember) { try { sessionStorage.setItem('managira:permissions-advanced', open ? '1' : ''); } catch (e) {} }
    };

    // Everything the role shows, in its place: basics in their bundles, the rest in Advanced.
    var layout = function () {
      var role = committed;
      chooseEl.hidden = Boolean(role);
      bodyEl.hidden = !role;
      if (!role) return;
      var now = held();
      var heldSet = new Set(now);
      var basics = new Set(role.basics);
      var isLead = role.isDriver && heldSet.has('driver_lead');

      tops.forEach(function (item) {
        var node = item.node, key = item.key;
        var group = item.home.getAttribute('data-perm-group');
        var show = role.isDriver
          ? group === 'Driver' || node.hasAttribute('data-perm-driver') || (isLead && node.hasAttribute('data-perm-lead'))
          : group !== 'Driver';
        node.hidden = !show;
        if (!show) return;
        if (basics.has(key)) {
          var bundle = basicsEl.querySelector('[data-perm-bundle="' + ((data.bundleOf && data.bundleOf[key]) || 'school') + '"] .perm-bundle-nodes');
          put(bundle || item.home, item);
        } else if (highRisk.has(key)) {
          // Only a Manager's list shows high-risk permissions; someone who already holds one keeps seeing it.
          if (role.isManager) put(hrBody.querySelector('.perm-hr-nodes'), item);
          else { put(item.home, item); node.hidden = !heldSet.has(key); }
        } else put(item.home, item);
      });
      // A high-risk follow-up inside a main permission: the same rule.
      picker.querySelectorAll('.perm-children .perm-node').forEach(function (child) {
        var key = keyOf(child);
        child.hidden = highRisk.has(key) && !role.isManager && !heldSet.has(key);
      });
      basicsEl.querySelectorAll('[data-perm-bundle]').forEach(function (section) {
        section.hidden = !section.querySelector('.perm-bundle-nodes > .perm-node:not([hidden])');
      });
      basicsEl.hidden = !basicsEl.querySelector('[data-perm-bundle]:not([hidden])');
      picker.querySelectorAll('.perm-advanced > .perm-group').forEach(function (section) {
        section.hidden = !section.querySelector(':scope > .perm-node:not([hidden])');
      });
      hrEl.hidden = !(role.isManager && hrBody.querySelector('.perm-hr-nodes > .perm-node:not([hidden])'));
      allBox.hidden = !(role.isManager && canHighRisk);
      update();
    };

    // The live parts: Extra marks, the Advanced count and the "Can / Cannot" line.
    var update = function () {
      var role = committed;
      if (!role) return;
      var now = held();
      var heldSet = new Set(now);
      var basics = new Set(role.basics);
      picker.querySelectorAll('.perm-node').forEach(function (node) {
        var key = keyOf(node);
        node.classList.toggle('is-extra', heldSet.has(key) && !basics.has(key));
      });
      var extra = L.extraKeys(now, role.basics, data.parentOf || {});
      advCount.textContent = extra.length ? ' · ' + extra.length + ' extra' : '';
      picker.querySelectorAll('[data-perm-count]').forEach(function (count) {
        var children = count.closest('.perm-node').querySelectorAll(':scope > .perm-children > .perm-node');
        var on = Array.prototype.filter.call(children, function (node) { return rowSwitch(node).checked; }).length;
        count.textContent = children.length ? on + ' of ' + children.length : '';
      });
    };

    // Ticks exactly these (a change event for each, so the mailroom panel and school-role line follow).
    var setHeld = function (keys) {
      var want = new Set(keys);
      bulk = true;
      allSwitches().forEach(function (box) {
        if (box.disabled) return;
        var on = want.has(box.value);
        if (box.checked !== on) { box.checked = on; box.dispatchEvent(new Event('change', { bubbles: true })); }
      });
      bulk = false;
    };

    var sameRole = function (a, b) { return a && b && a.id === b.id; };

    // The Role select changed: lay out the new role (asking first when switching from another).
    var roleChanged = function () {
      var role = roleInfo();
      if (!role) { committed = null; layout(); return; }
      if (sameRole(committed, role)) { layout(); return; }
      var result = L.switchRole({ held: held(), oldBasics: committed ? committed.basics : null, newBasics: role.basics, data: data, toDriver: role.isDriver });
      // Switches at once: the new role's basics, and whatever was added beyond the old role's stay.
      setHeld(result.next); committed = role; layout();
      if (role.isDriver) advOpen(true, false);
    };

    advBtn.addEventListener('click', function () { advOpen(advEl.hidden, true); });
    hrBtn.addEventListener('click', function () {
      var open = hrBody.hidden;
      hrBody.hidden = !open;
      hrBtn.setAttribute('aria-expanded', open ? 'true' : 'false');
    });

    // "Allow all permissions" (Managers, inside Advanced): one click turns everything on.
    $('permAllOpen').addEventListener('click', function () {
      if (!committed || !committed.isManager) return;
      bulk = true;
      allSwitches().forEach(function (box) {
        if (box.disabled || box.closest('.perm-node[hidden]') || box.checked) return;
        box.checked = true;
        box.dispatchEvent(new Event('change', { bubbles: true }));
      });
      bulk = false;
      layout();
    });

    // Lead Driver turns on what a lead usually needs; each one can still be turned off.
    picker.addEventListener('change', function (event) {
      if (bulk || !event.target.matches('input.perm-switch')) return;
      var node = event.target.closest('.perm-node');
      // Turning a main permission on opens its choices; turning it off folds them.
      if (node.querySelector(':scope > .perm-children')) setOpen(node, event.target.checked);
      var row = event.target.closest('[data-perm-presets]');
      if (row && event.target.checked) {
        row.getAttribute('data-perm-presets').split(' ').forEach(function (key) {
          var box = picker.querySelector('input.perm-switch[value="' + key + '"]');
          if (box && !box.checked) { box.checked = true; box.dispatchEvent(new Event('change', { bubbles: true })); }
        });
      }
      if (event.target.value === 'driver_lead') layout(); else update();
    });
    picker.addEventListener('click', function (event) {
      var caret = event.target.closest('[data-perm-caret]');
      if (!caret) return;
      event.preventDefault();
      var node = caret.closest('.perm-node');
      setOpen(node, !node.classList.contains('is-open'));
    });


    // The forms call these: the role changed, or the switches were set from code.
    window.ManagiraPermissionPicker = {
      roleChanged: roleChanged,
      refresh: function () {
        // A school role saved with new permissions: its basics are the saved ones.
        var now = roleInfo();
        committed = now && committed && now.id === committed.id ? now : (committed || now);
        layout();
      },
      forRole: function () { layout(); },
    };

    // A main permission that needs a follow-up can't be saved without one.
    form.addEventListener('submit', function (event) {
      var missing = Array.prototype.find.call(picker.querySelectorAll('.perm-required'), function (note) {
        var children = note.parentElement;
        var node = children.parentElement;
        if (!rowSwitch(node).checked) return false;
        for (var up = node.parentElement.closest('.perm-node'); up; up = up.parentElement.closest('.perm-node')) {
          if (!rowSwitch(up).checked) return false;
        }
        return !Array.prototype.some.call(children.querySelectorAll(':scope > .perm-node'), function (child) { return rowSwitch(child).checked; });
      });
      if (!missing) return;
      event.preventDefault();
      event.stopImmediatePropagation();
      if (missing.closest('#permAdvanced')) advOpen(true, false);
      if (missing.closest('#permHrBody')) { hrBody.hidden = false; hrBtn.setAttribute('aria-expanded', 'true'); }
      for (var node = missing.closest('.perm-node'); node; node = node.parentElement.closest('.perm-node')) setOpen(node, true);
      missing.scrollIntoView({ block: 'center', behavior: 'smooth' });
    }, true);

    var remembered = false;
    try { remembered = sessionStorage.getItem('managira:permissions-advanced') === '1'; } catch (e) {}
    advOpen(remembered || Boolean(committed && committed.isDriver && !committed.basics.length), false);
    layout();
  })();
</script>
