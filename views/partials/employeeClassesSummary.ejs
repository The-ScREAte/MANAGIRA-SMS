<%#
  The collapsed heading for an employee's classes, shared by the Add and Edit forms,
  with a reminder when a teacher or supervisor has none. Expects the class list in
  #collapse-all-classes and its checkboxes named classCheckboxName. Each class row carries
  its "Main teacher" choice (partials/employeeMainTeacher); this file styles and runs it.
%>
<input type="hidden" name="mainClassesShown" value="1">
<% if (typeof classAssistants !== 'undefined' && classAssistants !== null) { %><input type="hidden" name="assistantClassesShown" value="1"><% } %>
<button type="button" class="emp-class-toggle" id="empClassToggle" aria-expanded="false" aria-controls="collapse-all-classes">
  <span class="emp-class-title">Classes &amp; Subjects</span>
  <span class="emp-class-count" id="empClassCount">None selected</span>
  <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m9 6 6 6-6 6" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
</button>
<input type="search" id="empClassSearch" class="emp-class-search" placeholder="Search classes" aria-label="Search classes" autocomplete="off" hidden>
<p class="emp-class-warn" id="empClassWarn" hidden>Choose at least one class.</p>
<style>
  .emp-class-toggle { display: flex !important; align-items: center; gap: 8px; width: 100%; min-height: 38px; margin: 0; padding: 7px 10px; border: 1px solid #e2e8f0; border-radius: 6px; background: #fff; color: #1e293b; font: inherit; cursor: pointer; text-align: left; }
  .emp-class-toggle:hover { background: #f8fafc; }
  .emp-class-title { flex: 1 1 auto; font-size: 0.84rem; font-weight: 600; }
  .emp-class-count { font-size: 0.74rem; color: #64748b; white-space: nowrap; }
  .emp-class-toggle svg { flex: 0 0 auto; width: 14px; height: 14px; color: #64748b; transition: transform .12s ease; }
  .emp-class-toggle[aria-expanded="true"] svg { transform: rotate(90deg); }
  .emp-class-warn { margin: 6px 2px 0; color: #92400e; font-size: 0.78rem; }
  .emp-class-warn[hidden], .emp-class-search[hidden] { display: none; }
  .emp-class-search { display: block; width: 100%; margin: 8px 0 0; padding: 8px 12px; border: 1px solid #e2e8f0; border-radius: 8px; background: #fff; color: #1e293b; font: inherit; font-size: 0.86rem; }
  /* Class | Main teacher | Assistant teacher: the same columns on every row. */
  .emp-main { display: flex; flex: 0 0 auto; align-items: center; gap: 12px; margin-left: auto; }
  .emp-cell { display: flex; align-items: center; gap: 8px; flex: 0 0 9.5rem; width: 9.5rem; min-width: 0; min-height: 26px; color: #475569; font-size: 0.82rem; }
  .emp-cell:nth-child(2) { flex-basis: 11rem; width: 11rem; }
  .emp-cell::before { content: attr(data-label); display: none; font-weight: 600; color: #1e293b; }
  .emp-pick { position: relative; display: inline-flex; align-items: center; gap: 8px; line-height: 16px; margin: 0 !important; padding: 0 !important; min-width: 0; font-weight: inherit; cursor: pointer; }
  .emp-cell input[type="checkbox"] { align-self: center; vertical-align: middle; flex: 0 0 auto; width: 16px; height: 16px; min-height: 0; margin: 0 !important; accent-color: var(--org-primary-color, #01535b); cursor: pointer; }
  .emp-none { color: #94a3b8; }
  /* Chosen for this person: the box becomes their name, in green (the people already there stay plain). */
  .emp-me { display: none; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; color: #16a34a; font-weight: 700; }
  .emp-pick input:checked { position: absolute; width: 1px; height: 1px; opacity: 0; pointer-events: none; }
  .emp-pick input:checked ~ .emp-none { display: none; }
  .emp-pick input:checked ~ .emp-me { display: inline; }
  .emp-pick:has(input:focus-visible) { outline: 2px solid var(--org-primary-color, #01535b); outline-offset: 2px; border-radius: 4px; }
  .emp-who { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .emp-cols { display: flex; align-items: center; gap: 12px; padding: 8px 0 6px; border-bottom: 1px solid #e2e8f0; color: #64748b; font-size: 0.7rem; font-weight: 700; letter-spacing: .06em; text-transform: uppercase; }
  .emp-cols > span:first-child { flex: 1 1 auto; }
  .emp-cols .emp-cell { color: inherit; font-size: inherit; min-height: 0; }
  .emp-cols .emp-cell::before { display: none; }
  .emp-cols .emp-cols__space { flex: 0 0 5.5rem; }
  .emp-main[hidden], .emp-cols[hidden], #collapse-all-classes [hidden] { display: none !important; }
  @media (max-width: 720px) {
    .emp-cols { display: none; }
    .class-checkbox { flex-wrap: wrap; }
    .emp-main { flex: 1 1 100%; flex-wrap: wrap; width: 100%; margin-left: 0; padding: 0 0 0 23px; gap: 4px 16px; }
    .emp-cell { flex: 1 1 9rem; width: auto; }
    .emp-cell::before { display: inline; }
  }
</style>
<script nonce="<%= locals.cspNonce || '' %>">
  (function () {
    var name = <%- JSON.stringify(classCheckboxName) %>;
    var toggle = document.getElementById('empClassToggle');
    var count = document.getElementById('empClassCount');
    var warn = document.getElementById('empClassWarn');
    var form = toggle.closest('form');
    var search = document.getElementById('empClassSearch');
    var boxes = function () { return form.querySelectorAll('input[type="checkbox"][name="' + name + '"]'); };
    var role = form.querySelector('select[name="account_type"], select[name="accountType"]');
    var refresh = function () {
      var picked = Array.prototype.filter.call(boxes(), function (box) { return box.checked; }).length;
      count.textContent = picked ? picked + (picked === 1 ? ' class' : ' classes') + ' selected' : 'None selected';
      // Managers already see every class, and drivers don't need one.
      warn.hidden = picked > 0 || !role || !['Teacher', 'Supervisor'].includes(role.value);
    };
    var setOpen = function (open) {
      var panel = document.getElementById('collapse-all-classes');
      panel.style.display = open ? '' : 'none';
      if (search) search.hidden = !open;
      toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
    };
    if (search) search.addEventListener('input', function () {
      var q = search.value.trim().toLowerCase();
      Array.prototype.forEach.call(document.querySelectorAll('#collapse-all-classes .class-checkbox, #collapse-all-classes .class-container'), function (row) {
        var name = (row.querySelector('label, .class-name-row') || row).textContent.toLowerCase();
        var show = !q || name.indexOf(q) !== -1;
        row.hidden = !show;
        var next = row.nextElementSibling;
        if (next && next.classList.contains('subject-container')) next.hidden = !show;
      });
    });
    toggle.addEventListener('click', function () { setOpen(toggle.getAttribute('aria-expanded') !== 'true'); });
    // Main teacher and Assistant: only for a class that is ticked, never for a driver, and
    // one or the other. Leaving a class gives up both.
    var syncMain = function (changed) {
      var driver = !!role && role.value === 'Driver';
      Array.prototype.forEach.call(boxes(), function (box) {
        var wrap = form.querySelector('[data-emp-main="' + box.value + '"]');
        if (!wrap) return;
        var pick = wrap.querySelector('input[name="mainClasses"]');
        var help = wrap.querySelector('input[name="assistantClasses"]');
        wrap.hidden = driver;
        // Leaving a class gives up both; choosing either on a class that isn't ticked ticks the class.
        if (changed === box && !box.checked) [pick, help].forEach(function (input) { if (input) input.checked = false; });
        if ((changed === pick && pick.checked) || (changed === help && help.checked)) {
          if (!box.checked) { box.checked = true; box.dispatchEvent(new Event('change', { bubbles: true })); }
        }
        if (help && changed === help && help.checked && pick) pick.checked = false;
        if (help && changed === pick && pick.checked) help.checked = false;
        [pick, help].forEach(function (input) {
          if (!input) return;
          input.disabled = input.hasAttribute('data-locked') || driver;
          if (input.disabled) input.checked = false;
        });
      });
    };
    // The green name is this person's: whatever is typed in the name fields.
    var paintName = function () {
      var first = form.querySelector('input[name="firstName"]');
      var last = form.querySelector('input[name="lastName"]');
      var name = ((first && first.value || '') + ' ' + (last && last.value || '')).replace(/\s+/g, ' ').trim() || 'This person';
      Array.prototype.forEach.call(form.querySelectorAll('.emp-me'), function (el) { el.textContent = name; });
    };
    form.addEventListener('input', function (event) {
      if (event.target.name === 'firstName' || event.target.name === 'lastName') paintName();
    });
    document.addEventListener('DOMContentLoaded', paintName);
    form.addEventListener('change', function (event) {
      if (event.target === role || event.target.name === name) refresh();
      if (event.target === role || event.target.name === name || event.target.name === 'mainClasses' || event.target.name === 'assistantClasses') syncMain(event.target);
    });
    document.addEventListener('DOMContentLoaded', function () { syncMain(null); });
    window.ManagiraEmployeeClasses = { refresh: refresh, setOpen: setOpen };
    document.addEventListener('DOMContentLoaded', refresh);
  })();
</script>
