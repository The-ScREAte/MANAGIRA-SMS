<%#
  Shown to school managers when their integrations are close to (or past)
  today's API allowance. Needs: usage (utils/apiAllowance.usageSummary),
  requestHref (where "Request more" goes).
%>
<% if (typeof usage !== 'undefined' && usage && usage.nearLimit) {
  const _pct = Math.min(100, Math.round(usage.share * 100));
  const _hours = Math.max(1, Math.round(usage.resetsInSeconds / 3600));
%>
<div class="api-usage-banner<%= usage.limitHitToday || usage.minuteLimitHit ? ' is-hit' : '' %>" role="status">
  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3l9.5 17h-19z"/><path d="M12 10v4M12 17h.01"/></svg>
  <div class="api-usage-banner__text">
    <% if (usage.limitHitToday) { %>
      <strong>Your integrations used up today's API allowance</strong>
      <span><%= usage.usedToday.toLocaleString('en-US') %> of <%= usage.allowance.perDay.toLocaleString('en-US') %> calls. They're paused until it resets in about <%= _hours %> hour<%= _hours === 1 ? '' : 's' %> (midnight UTC).</span>
    <% } else if (usage.minuteLimitHit) { %>
      <strong>Some API calls were paused today</strong>
      <span>Your integrations sent more than <%= usage.allowance.perMinute.toLocaleString('en-US') %> calls in a minute. <%= usage.usedToday.toLocaleString('en-US') %> of <%= usage.allowance.perDay.toLocaleString('en-US') %> calls used today (<%= _pct %>%).</span>
    <% } else { %>
      <strong>Your integrations are close to today's API allowance</strong>
      <span><%= usage.usedToday.toLocaleString('en-US') %> of <%= usage.allowance.perDay.toLocaleString('en-US') %> calls used (<%= _pct %>%). Calls pause when it runs out; it resets in about <%= _hours %> hour<%= _hours === 1 ? '' : 's' %>.</span>
    <% } %>
  </div>
  <a class="api-usage-banner__btn" href="<%= requestHref %>" data-request-more data-no-spa>Request more</a>
</div>
<style>
  .api-usage-banner { display: flex; align-items: center; gap: 12px; margin: 0 0 16px; padding: 12px 14px; border: 1px solid #fcd34d; border-radius: 12px; background: #fffbeb; color: #78350f; }
  .api-usage-banner.is-hit { border-color: #fca5a5; background: #fef2f2; color: #7f1d1d; }
  .api-usage-banner svg { flex: 0 0 auto; }
  .api-usage-banner__text { display: grid; gap: 2px; flex: 1; min-width: 0; font-size: 0.86rem; line-height: 1.45; }
  .api-usage-banner__btn { flex: 0 0 auto; padding: 8px 14px; border-radius: 8px; background: var(--org-primary-color, #01535b); color: #fff; font-size: 0.85rem; font-weight: 600; text-decoration: none; white-space: nowrap; }
  @media (max-width: 640px) { .api-usage-banner { flex-wrap: wrap; } }
</style>
<% } %>
