<% const wxAbout = (typeof websiteExtras !== 'undefined' && websiteExtras && websiteExtras.about) || null; %>
<% if (wxAbout) { %>
<figure style="margin:0 0 16px;">
  <img src="<%= wxAbout.imageUrl %>" alt="<%= wxAbout.imageCaption || (orgDetails && orgDetails.organization_name) || 'Our school' %>" loading="lazy" style="display:block;width:100%;max-height:360px;object-fit:cover;border-radius:14px;">
  <% if (wxAbout.imageCaption) { %><figcaption style="margin-top:6px;font-size:0.88rem;opacity:0.75;"><%= wxAbout.imageCaption %></figcaption><% } %>
</figure>
<% } %>
