<header>
  <%
    const _ahAccountType = (session && session.accountType) ? String(session.accountType).trim().toLowerCase() : '';
    const _ahUserRole    = (session && session.userRole)    ? String(session.userRole).trim().toLowerCase()    : '';
    const _ahIsAdminLike = _ahAccountType === 'admin' || _ahAccountType === 'mini admin' || _ahAccountType === 'internal worker'
      || _ahUserRole === 'admin' || _ahUserRole === 'mini admin' || _ahUserRole === 'internal worker';
    const _ahIsInternal  = _ahAccountType === 'internal worker' || _ahUserRole === 'internal worker';
    const _ahIsFullAdmin = _ahAccountType === 'admin' || _ahUserRole === 'admin';
    const _ahCanViewOrgChart = !!(session && session.canViewOrgChart);
  %>
  <% if (session.firstName && _ahIsAdminLike) { %>
    <div class="admin-header-pro">
      <div class="admin-header-left">
        <img src="/images/managira.png" alt="Logo" class="admin-header-logo" />
        <span class="admin-header-title">Managira Admin</span>
      </div>
      <nav class="admin-header-nav">
        <ul class="admin-header-nav-list">
          <li class="admin-header-welcome" aria-hidden="true">
            <span class="admin-header-welcome__hi">Welcome,</span>
            <span class="admin-header-welcome__name"><%= session.firstName %><% if (session.lastName) { %> <%= session.lastName %><% } %></span>
          </li>
          <% if (!_ahIsInternal) { %>
          <li class="notification-icon">
            <a href="/admin/helpMessages">
              <img src="/images/msgicon.png" alt="Messages" class="notification-image">
            </a>
            <% if (unresolvedCount > 0) { %>
              <span class="notification-badge"><%= unresolvedCount %></span>
            <% } %>
          </li>
          <% } %>
          <li class="admin-profile-container" id="admin-profile-container">
            <button type="button" class="admin-profile-btn" id="admin-profile-btn" aria-haspopup="true" aria-expanded="false" aria-label="Profile menu">
              <span class="admin-profile-avatar">
                <% if (session.profileImageUrl) { %>
                  <img src="<%= session.profileImageUrl %>" alt="Profile picture" />
                <% } else { %>
                  <%= (session.firstName || '?').charAt(0).toUpperCase() %>
                <% } %>
              </span>
            </button>
            <div class="admin-profile-dropdown" id="admin-profile-dropdown" role="menu">
              <div class="admin-profile-dropdown__header">
                <div class="admin-profile-dropdown__name"><%= session.firstName %><% if (session.lastName) { %> <%= session.lastName %><% } %></div>
                <div class="admin-profile-dropdown__role"><%= session.accountType %></div>
              </div>
              <a href="/admin/profile" class="admin-profile-dropdown__item" role="menuitem" data-no-spa>⚙️ Profile Settings</a>
              <a href="/account/logout" class="admin-profile-dropdown__item admin-profile-dropdown__item--danger" data-no-spa role="menuitem">↩ Logout</a>
            </div>
          </li>
          <li class="admin-hamburger-container">
            <div class="admin-hamburger" id="admin-hamburger">
              <span class="bar"></span>
              <span class="bar"></span>
              <span class="bar"></span>
            </div>
          </li>
        </ul>
        <div class="admin-hamburger-overlay" id="admin-hamburger-overlay">
          <ul class="admin-hamburger-menu" id="admin-hamburger-menu">
            <% if (_ahIsInternal) { %>
              <li><a href="/admin" class="admin-header-link" data-no-spa>Dashboard</a></li>
              <% if (_ahCanViewOrgChart) { %>
                <li><a href="/admin/org-chart" class="admin-header-link" data-no-spa>Team Org Chart</a></li>
              <% } %>
              <li><a href="/legal/app-demo" class="admin-header-link" target="_blank" rel="noopener" data-no-spa>App Demo</a></li>
              <li><a href="/admin/profile" class="admin-header-link" data-no-spa>Profile Settings</a></li>
              <li><a href="/account/logout" class="admin-header-link" data-no-spa>Logout</a></li>
            <% } else { %>
            <li><a href="/admin" class="admin-header-link">Dashboard</a></li>
            <% if (_ahIsFullAdmin) { %>
              <li><a href="/admin/superDashboard" class="admin-header-link">Super Admin</a></li>
              <li><a href="/admin/scheduled-holds" class="admin-header-link">Subscription Cancellation</a></li>
              <li><a href="/admin/create-promo" class="admin-header-link">DISCOUNTS</a></li>
              <li><a href="/admin/servicePricing" class="admin-header-link">Service Pricing</a></li>
              <li><a href="/admin/data-export" class="admin-header-link">Data Export</a></li>
              <li><a href="/admin/employment" class="admin-header-link">Employment</a></li>
              <li><a href="/admin/donations" class="admin-header-link">Donations</a></li>
              <li><a href="/admin/announcements" class="admin-header-link">Announcements</a></li>
              <li><a href="/admin/email-suppressions" class="admin-header-link">Email Suppressions</a></li>
              <li><a href="/admin/org-chart" class="admin-header-link">Team Org Chart</a></li>
            <% } %>
            <li><a href="https://forms.gle/uc9qatwCgWf1jMnv6" class="admin-header-link" target="_blank" rel="noopener" data-no-spa>Weekly Internal Report</a></li>
            <li><a href="https://calendly.com/managirasms/managira-team-review-meeting" class="admin-header-link" target="_blank" rel="noopener" data-no-spa>Calendar</a></li>
            <li><a href="/legal/app-demo" class="admin-header-link" target="_blank" rel="noopener" data-no-spa>App Demo</a></li>
            <li><a href="/legal/help" class="admin-header-link" target="_blank" rel="noopener">Help Center</a></li>
            <li><a href="/legal/user-documentation" class="admin-header-link" target="_blank" rel="noopener">Documentation</a></li>
            <li><a href="/admin/profile" class="admin-header-link">Profile Settings</a></li>
            <li><a href="/account/logout" class="admin-header-link" data-no-spa>Logout</a></li>
            <% } %>
          </ul>
        </div>
      </nav>
    </div>
  <% } %>
</header>

<style>
    .admin-header-pro {
      background: #fff;
      color: #1e293b;
      padding: 0.7rem 2.5vw;
      display: flex;
      align-items: center;
      justify-content: space-between;
      box-shadow: 0 10px 26px rgba(15, 23, 42, 0.08);
      border: 1px solid #e5e7eb;
      border-radius: 14px;
      max-width: 1200px;
      margin: 12px auto;
      flex-wrap: wrap;
      z-index: 1000;
    }
    .admin-header-left {
      display: flex;
      align-items: center;
      gap: 1.1rem;
    }
    .admin-header-logo {
      height: 44px;
      width: 44px;
      border-radius: 8px;
      background: #fff;
      box-shadow: 0 2px 8px rgba(30,41,59,0.08);
      object-fit: contain;
      padding: 2px;
    }
    .admin-header-title {
      font-size: 2rem;
      font-weight: 700;
      letter-spacing: 1px;
      color: #2563eb;
      text-shadow: 0 2px 8px rgba(30,41,59,0.08);
    }
    .admin-header-nav {
      flex: 1;
      display: flex;
      justify-content: flex-end;
    }
    .admin-header-nav-list {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      margin: 0;
      padding: 0.3rem 0.7rem;
      list-style: none;
      background: #f7fafd;
      border-radius: 32px;
      box-shadow: 0 2px 8px rgba(30,41,59,0.04);
      flex-wrap: wrap;
    }
    .notification-icon {
      position: relative;
      cursor: pointer;
      margin-right: 0.5rem;
    }
    .notification-image {
      width: 30px;
      height: 30px;
      vertical-align: middle;
    }
    .notification-badge {
      position: absolute;
      top: -5px;
      right: -5px;
      background-color: #ef4444;
      color: white;
      font-size: 0.8rem;
      font-weight: bold;
      border-radius: 50%;
      padding: 4px 7px;
      line-height: 1;
      box-shadow: 0 1px 4px rgba(30,41,59,0.10);
      border: 2px solid #fff;
    }
    .admin-hamburger-container {
      position: relative;
      margin-left: 10px;
    }
    .admin-hamburger {
      width: 38px;
      height: 38px;
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      cursor: pointer;
      background: #f7fafd;
      border-radius: 8px;
      box-shadow: 0 2px 8px rgba(30,41,59,0.04);
      border: 1.5px solid #e0e7ef;
      transition: background 0.18s;
    }
    .admin-hamburger .bar {
      width: 24px;
      height: 3px;
      background: #2563eb;
      margin: 3px 0;
      border-radius: 2px;
      transition: all 0.2s;
    }
    .admin-hamburger-overlay {
      display: none;
      position: fixed;
      top: 0;
      left: 0;
      width: 100vw;
      height: 100vh;
      background: rgba(15, 23, 42, 0.4);
      z-index: 3000;
      justify-content: flex-end;
      align-items: stretch;
      pointer-events: auto;
    }
    .admin-hamburger-overlay.show {
      display: flex;
    }
    .admin-hamburger-menu {
      background: #fff;
      border-radius: 0;
      box-shadow: 0 8px 32px rgba(30,41,59,0.18);
      width: 280px;
      max-width: 85vw;
      height: 100vh;
      padding: 74px 14px 16px;
      z-index: 3100;
      flex-direction: column;
      list-style: none;
      margin: 0;
      display: flex;
      align-items: stretch;
      justify-content: flex-start;
      gap: 2px;
      position: relative;
      pointer-events: auto;
      border-left: 1px solid #e5e7eb;
      overflow-y: auto;
    }
    body {
      overflow: auto !important;
    }
    .admin-hamburger-menu li {
      width: 100%;
      text-align: left;
      padding: 0;
      margin: 0;
      display: block;
      flex: 0 0 auto;
    }
    .admin-hamburger-menu .admin-header-link {
      width: 100%;
      display: flex;
      align-items: center;
      padding: 9px 12px;
      color: #1f2937;
      text-decoration: none;
      font-size: 0.95rem;
      line-height: 1.25;
      font-weight: 600;
      border-radius: 8px;
      background: transparent;
      border: 1px solid transparent;
      box-shadow: none;
      margin: 0;
      transition: background 0.18s, color 0.18s, border-color 0.18s;
    }
    .admin-hamburger-menu .admin-header-link:hover {
      background: #f3f4f6;
      border-color: #e5e7eb;
      color: #111827;
    }
    .admin-hamburger-menu li:last-child {
      margin-top: 8px;
      padding-top: 8px;
      border-top: 1px solid #e5e7eb;
    }
    .admin-header-link {
      text-decoration: none;
      color: #2563eb;
      padding: 9px 18px;
      font-size: 1.08rem;
      font-weight: 600;
      border-radius: 999px;
      background: transparent;
      transition: background 0.18s, color 0.18s, box-shadow 0.18s;
      border: 1.5px solid #e0e7ef;
      box-shadow: none;
      margin: 0 2px;
      display: inline-block;
    }
    .admin-header-link:hover {
      background: #2563eb;
      color: #fff;
      border: 1.5px solid #2563eb;
      box-shadow: 0 2px 8px rgba(37,99,235,0.10);
    }
    @media (max-width: 1024px) {
      .admin-header-pro {
        flex-direction: column;
        align-items: flex-start;
        padding: 12px 10px;
        border-radius: 12px;
        margin: 10px 10px 0;
      }
      .admin-header-title {
        font-size: 1.3rem;
        margin-bottom: 8px;
      }
      .admin-header-nav-list {
        gap: 0.3rem;
        flex-wrap: wrap;
        justify-content: flex-start;
      }
      .admin-header-link {
        font-size: 0.98rem;
        padding: 7px 10px;
      }
    }
    @media (max-width: 768px) {
      .admin-header-pro {
        padding: 8px 10px;
        flex-direction: row;
        align-items: center;
        justify-content: space-between;
        gap: 8px;
        flex-wrap: nowrap;
        border-radius: 10px;
        margin: 8px 8px 0;
      }
      .admin-header-left {
        gap: 0.65rem;
        min-width: 0;
        flex: 1 1 auto;
      }
      .admin-header-logo {
        width: 34px;
        height: 34px;
      }
      .admin-header-title {
        font-size: 0.95rem;
        margin-bottom: 0;
        text-align: left;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
      }
      .admin-header-nav {
        flex: 0 0 auto;
      }
      .admin-header-nav-list {
        flex-direction: row;
        align-items: center;
        gap: 6px;
        width: auto;
        padding: 0.2rem 0.2rem;
        background: none;
        border-radius: 0;
        box-shadow: none;
        flex-wrap: nowrap;
      }
      .admin-hamburger-container {
        margin-left: 0;
      }
      .admin-hamburger-menu {
        width: 280px;
        max-width: 88vw;
        padding-top: 72px;
      }
      .admin-hamburger-menu .admin-header-link {
        font-size: 0.94rem;
        padding: 10px 12px;
      }
      .notification-icon {
        margin-bottom: 0;
        margin-right: 0;
      }
      .admin-header-welcome {
        /* On small screens we briefly show, then auto-hide via JS */
        display: flex;
        flex-direction: row;
        align-items: center;
        gap: 4px;
        max-width: 60vw;
        transition: opacity 400ms ease, transform 400ms ease, max-width 400ms ease, margin 400ms ease;
      }
      .admin-header-welcome__hi { font-size: 0.65rem; }
      .admin-header-welcome__name { font-size: 0.85rem; max-width: 50vw; }
      .admin-header-welcome.is-hidden {
        opacity: 0;
        transform: translateX(-6px);
        max-width: 0;
        margin: 0;
        padding: 0;
        overflow: hidden;
        pointer-events: none;
      }
    }

    /* Welcome label */
    .admin-header-welcome {
      display: flex;
      flex-direction: column;
      align-items: flex-end;
      line-height: 1.1;
      margin-right: 4px;
      max-width: 220px;
    }
    .admin-header-welcome__hi {
      font-size: 0.7rem;
      color: #64748b;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      font-weight: 600;
    }
    .admin-header-welcome__name {
      font-size: 0.95rem;
      font-weight: 700;
      color: #0f172a;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
      max-width: 220px;
    }

    /* Profile button + dropdown */
    .admin-profile-container {
      position: relative;
      display: flex;
      align-items: center;
    }
    .admin-profile-btn {
      background: none;
      border: 0;
      padding: 0;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      justify-content: center;
    }
    .admin-profile-avatar {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 36px;
      height: 36px;
      border-radius: 50%;
      background: linear-gradient(135deg, #01535b, #047a85);
      color: #fff;
      font-weight: 700;
      font-size: 0.95rem;
      box-shadow: 0 2px 6px rgba(1, 83, 91, 0.25);
      transition: transform 150ms ease, box-shadow 150ms ease;
      overflow: hidden;
    }
    .admin-profile-avatar img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }
    .admin-profile-btn:hover .admin-profile-avatar,
    .admin-profile-btn:focus-visible .admin-profile-avatar {
      transform: scale(1.05);
      box-shadow: 0 4px 12px rgba(1, 83, 91, 0.35);
    }
    .admin-profile-dropdown {
      display: none;
      position: absolute;
      top: calc(100% + 8px);
      right: 0;
      min-width: 220px;
      background: #fff;
      border: 1px solid #e5e7eb;
      border-radius: 10px;
      box-shadow: 0 18px 40px rgba(15, 23, 42, 0.18);
      overflow: hidden;
      z-index: 1100;
    }
    .admin-profile-container.open .admin-profile-dropdown { display: block; }
    .admin-profile-dropdown__header {
      padding: 12px 14px;
      background: #f8fafc;
      border-bottom: 1px solid #e5e7eb;
    }
    .admin-profile-dropdown__name {
      font-weight: 700;
      font-size: 0.95rem;
      color: #0f172a;
    }
    .admin-profile-dropdown__role {
      font-size: 0.78rem;
      color: #64748b;
      margin-top: 2px;
    }
    .admin-profile-dropdown__item {
      display: block;
      padding: 10px 14px;
      font-size: 0.9rem;
      color: #1e293b;
      text-decoration: none;
      border-top: 1px solid #f1f5f9;
    }
    .admin-profile-dropdown__item:first-of-type { border-top: 0; }
    .admin-profile-dropdown__item:hover { background: #f1f5f9; }
    .admin-profile-dropdown__item--danger { color: #dc2626; }
    .admin-profile-dropdown__item--danger:hover { background: #fef2f2; }
</style>

<script>
  (function () {
    function initAdminHamburger() {
      const hamburger = document.getElementById("admin-hamburger");
      const overlay = document.getElementById("admin-hamburger-overlay");
      const menu = document.getElementById("admin-hamburger-menu");

      if (!hamburger || !overlay || !menu) return;

      if (hamburger.dataset.menuBound === "1") return;
      hamburger.dataset.menuBound = "1";

      const closeMenu = function () {
        overlay.classList.remove("show");
        hamburger.classList.remove("active");
      };

      hamburger.addEventListener("click", function (e) {
        e.preventDefault();
        e.stopPropagation();
        const shouldOpen = !overlay.classList.contains("show");
        overlay.classList.toggle("show", shouldOpen);
        hamburger.classList.toggle("active", shouldOpen);
      });

      overlay.addEventListener("click", function (e) {
        if (e.target === overlay) {
          closeMenu();
        }
      });

      Array.from(menu.querySelectorAll("a")).forEach(function (link) {
        if (link.dataset.menuLinkBound === "1") return;
        link.dataset.menuLinkBound = "1";
        link.addEventListener("click", function () {
          closeMenu();
        });
      });
    }

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", initAdminHamburger);
    } else {
      initAdminHamburger();
    }

    window.addEventListener("spa:pageLoaded", initAdminHamburger);
  })();

  // Profile dropdown toggle
  (function () {
    function initAdminProfile() {
      var container = document.getElementById("admin-profile-container");
      var btn = document.getElementById("admin-profile-btn");
      if (!container || !btn) return;
      if (btn.dataset.profileBound === "1") return;
      btn.dataset.profileBound = "1";

      function close() {
        container.classList.remove("open");
        btn.setAttribute("aria-expanded", "false");
      }
      function open() {
        container.classList.add("open");
        btn.setAttribute("aria-expanded", "true");
      }

      btn.addEventListener("click", function (e) {
        e.stopPropagation();
        if (container.classList.contains("open")) close(); else open();
      });

      document.addEventListener("click", function (e) {
        if (!container.contains(e.target)) close();
      });

      document.addEventListener("keydown", function (e) {
        if (e.key === "Escape") close();
      });
    }

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", initAdminProfile);
    } else {
      initAdminProfile();
    }

    window.addEventListener("spa:pageLoaded", initAdminProfile);
  })();

  // Auto-hide welcome label on small screens after 10 seconds
  (function () {
    var hideTimer = null;
    function initWelcomeAutoHide() {
      var welcome = document.querySelector(".admin-header-welcome");
      if (!welcome) return;
      if (hideTimer) { clearTimeout(hideTimer); hideTimer = null; }
      welcome.classList.remove("is-hidden");
      // Only auto-hide on small screens
      if (window.matchMedia && window.matchMedia("(max-width: 700px)").matches) {
        hideTimer = setTimeout(function () {
          welcome.classList.add("is-hidden");
        }, 10000);
      }
    }

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", initWelcomeAutoHide);
    } else {
      initWelcomeAutoHide();
    }

    window.addEventListener("spa:pageLoaded", initWelcomeAutoHide);
  })();
</script>
