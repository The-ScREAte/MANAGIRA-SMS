<header>
  <% if (session.firstName && (session.accountType === 'Admin' || session.accountType === 'Mini Admin')) { %>
    <div class="admin-header-pro">
      <div class="admin-header-left">
        <img src="/images/managira.png" alt="Logo" class="admin-header-logo" />
        <span class="admin-header-title">Managira Admin</span>
      </div>
      <nav class="admin-header-nav">
        <ul class="admin-header-nav-list">
          <li class="notification-icon">
            <a href="/admin/helpMessages">
              <img src="/images/msgicon.png" alt="Messages" class="notification-image">
            </a>
            <% if (unresolvedCount > 0) { %>
              <span class="notification-badge"><%= unresolvedCount %></span>
            <% } %>
          </li>
          <li class="admin-hamburger-container">
            <div class="admin-hamburger" id="admin-hamburger">
              <span class="bar"></span>
              <span class="bar"></span>
              <span class="bar"></span>
            </div>
          </li>
        </ul>
        <div class="admin-hamburger-overlay" id="admin-hamburger-overlay">
          <ul class="admin-hamburger-menu" id="admin-hamburger-menu">
            <li><a href="/admin" class="admin-header-link">Dashboard</a></li>
            <% if (session.accountType === 'Admin') { %>
              <li><a href="/admin/superDashboard" class="admin-header-link">Super Admin</a></li>
              <li><a href="/admin/scheduled-holds" class="admin-header-link">Subscription Cancellation</a></li>
              <li><a href="/admin/create-promo" class="admin-header-link">DISCOUNTS</a></li>
              <li><a href="/admin/servicePricing" class="admin-header-link">Service Pricing</a></li>
              <li><a href="/admin/data-export" class="admin-header-link">Data Export</a></li>
              <li><a href="/admin/employment" class="admin-header-link">Post Employment</a></li>
              <li><a href="/admin/donations" class="admin-header-link">Donations</a></li>
              <li><a href="/admin/announcements" class="admin-header-link">Announcements</a></li>
            <% } %>
            <li><a href="/account/logout" class="admin-header-link" data-no-spa>Logout</a></li>
          </ul>
        </div>
      </nav>
    </div>
  <% } %>
</header>

<style>
    .admin-header-pro {
      background: #fff;
      color: #1e293b;
      padding: 0.7rem 2.5vw;
      display: flex;
      align-items: center;
      justify-content: space-between;
      box-shadow: 0 2px 12px rgba(30,41,59,0.07);
      border-bottom: 2px solid #2563eb;
      flex-wrap: wrap;
      z-index: 1000;
    }
    .admin-header-left {
      display: flex;
      align-items: center;
      gap: 1.1rem;
    }
    .admin-header-logo {
      height: 44px;
      width: 44px;
      border-radius: 8px;
      background: #fff;
      box-shadow: 0 2px 8px rgba(30,41,59,0.08);
      object-fit: contain;
      padding: 2px;
    }
    .admin-header-title {
      font-size: 2rem;
      font-weight: 700;
      letter-spacing: 1px;
      color: #2563eb;
      text-shadow: 0 2px 8px rgba(30,41,59,0.08);
    }
    .admin-header-nav {
      flex: 1;
      display: flex;
      justify-content: flex-end;
    }
    .admin-header-nav-list {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      margin: 0;
      padding: 0.3rem 0.7rem;
      list-style: none;
      background: #f7fafd;
      border-radius: 32px;
      box-shadow: 0 2px 8px rgba(30,41,59,0.04);
      flex-wrap: wrap;
    }
    .notification-icon {
      position: relative;
      cursor: pointer;
      margin-right: 0.5rem;
    }
    .notification-image {
      width: 30px;
      height: 30px;
      vertical-align: middle;
    }
    .notification-badge {
      position: absolute;
      top: -5px;
      right: -5px;
      background-color: #ef4444;
      color: white;
      font-size: 0.8rem;
      font-weight: bold;
      border-radius: 50%;
      padding: 4px 7px;
      line-height: 1;
      box-shadow: 0 1px 4px rgba(30,41,59,0.10);
      border: 2px solid #fff;
    }
    .admin-hamburger-container {
      position: relative;
      margin-left: 10px;
    }
    .admin-hamburger {
      width: 38px;
      height: 38px;
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      cursor: pointer;
      background: #f7fafd;
      border-radius: 8px;
      box-shadow: 0 2px 8px rgba(30,41,59,0.04);
      border: 1.5px solid #e0e7ef;
      transition: background 0.18s;
    }
    .admin-hamburger .bar {
      width: 24px;
      height: 3px;
      background: #2563eb;
      margin: 3px 0;
      border-radius: 2px;
      transition: all 0.2s;
    }
    .admin-hamburger-overlay {
      display: none;
      position: fixed;
      top: 0;
      left: 0;
      width: 100vw;
      height: 100vh;
      background: rgba(30,41,59,0.12);
      z-index: 3000;
      justify-content: center;
      align-items: center;
      pointer-events: auto;
    }
    .admin-hamburger-overlay.show {
      display: flex;
    }
    .admin-hamburger-menu {
      background: #fff;
      border-radius: 18px;
      box-shadow: 0 8px 32px rgba(30,41,59,0.18);
      min-width: 260px;
      padding: 24px 0;
      z-index: 3100;
      flex-direction: column;
      list-style: none;
      margin: 0;
      display: flex;
      align-items: center;
      position: relative;
      pointer-events: auto;
    }
    body {
      overflow: auto !important;
    }
    .admin-hamburger-menu li {
      width: 100%;
      text-align: center;
      padding: 0;
    }
    .admin-hamburger-menu a {
      width: 100%;
      display: block;
      padding: 16px 32px;
      color: #2563eb;
      text-decoration: none;
      font-size: 1.12rem;
      font-weight: 600;
      border-radius: 0;
      background: transparent;
      border: none;
      transition: background 0.18s, color 0.18s;
    }
    .admin-hamburger-menu a:hover {
      background: #2563eb;
      color: #fff;
    }
    .admin-header-link {
      text-decoration: none;
      color: #2563eb;
      padding: 9px 18px;
      font-size: 1.08rem;
      font-weight: 600;
      border-radius: 999px;
      background: transparent;
      transition: background 0.18s, color 0.18s, box-shadow 0.18s;
      border: 1.5px solid #e0e7ef;
      box-shadow: none;
      margin: 0 2px;
      display: inline-block;
    }
    .admin-header-link:hover {
      background: #2563eb;
      color: #fff;
      border: 1.5px solid #2563eb;
      box-shadow: 0 2px 8px rgba(37,99,235,0.10);
    }
    @media (max-width: 1024px) {
      .admin-header-pro {
        flex-direction: column;
        align-items: flex-start;
        padding: 12px 10px;
      }
      .admin-header-title {
        font-size: 1.3rem;
        margin-bottom: 8px;
      }
      .admin-header-nav-list {
        gap: 0.3rem;
        flex-wrap: wrap;
        justify-content: flex-start;
      }
      .admin-header-link {
        font-size: 0.98rem;
        padding: 7px 10px;
      }
    }
    @media (max-width: 768px) {
      .admin-header-pro {
        padding: 7px 3px;
        flex-direction: column;
        align-items: stretch;
      }
      .admin-header-title {
        font-size: 1rem;
        margin-bottom: 8px;
        text-align: center;
      }
      .admin-header-nav-list {
        flex-direction: row;
        align-items: center;
        gap: 6px;
        width: 100%;
        padding: 0.2rem 0.2rem;
        background: none;
        border-radius: 0;
        box-shadow: none;
      }
      .admin-hamburger-menu {
        min-width: 180px;
        top: 38px;
        right: 0;
      }
      .admin-header-link {
        width: 100%;
        text-align: left;
        font-size: 0.98rem;
        padding: 12px 0;
        background: transparent;
      }
      .notification-icon {
        margin-bottom: 0;
      }
    }
</style>

<script>
  document.addEventListener("DOMContentLoaded", function() {
    const hamburger = document.getElementById("admin-hamburger");
    const overlay = document.getElementById("admin-hamburger-overlay");
    const menu = document.getElementById("admin-hamburger-menu");
    hamburger.addEventListener("click", function(e) {
      e.stopPropagation();
      overlay.classList.toggle("show");
      hamburger.classList.toggle("active");
    });
    overlay.addEventListener("click", function(e) {
      if (e.target === overlay) {
        overlay.classList.remove("show");
        hamburger.classList.remove("active");
      }
    });
    Array.from(menu.querySelectorAll("a")).forEach(function(link) {
      link.addEventListener("click", function() {
        overlay.classList.remove("show");
        hamburger.classList.remove("active");
      });
    });
  });
</script>
</style>
    