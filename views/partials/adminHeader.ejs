<header>
  <%
    const _ahAccountType = (session && session.accountType) ? String(session.accountType).trim().toLowerCase() : '';
    const _ahUserRole    = (session && session.userRole)    ? String(session.userRole).trim().toLowerCase()    : '';
    const _ahIsAdminLike = _ahAccountType === 'admin' || _ahAccountType === 'mini admin' || _ahAccountType === 'internal worker'
      || _ahUserRole === 'admin' || _ahUserRole === 'mini admin' || _ahUserRole === 'internal worker';
    const _ahIsInternal  = _ahAccountType === 'internal worker' || _ahUserRole === 'internal worker';
    const _ahIsFullAdmin = _ahAccountType === 'admin' || _ahUserRole === 'admin';
    const _ahCanViewOrgChart = !!(session && session.canViewOrgChart);
  %>
  <% if (session.firstName && _ahIsAdminLike) { %>
    <div class="admin-header-pro">
      <div class="admin-header-left">
        <img src="/images/managira.png" alt="Logo" class="admin-header-logo" />
        <span class="admin-header-title">Managira Admin</span>
      </div>
      <nav class="admin-header-nav">
        <ul class="admin-header-nav-list">
          <li class="admin-header-welcome" aria-hidden="true">
            <span class="admin-header-welcome__hi">Welcome,</span>
            <span class="admin-header-welcome__name"><%= session.firstName %><% if (session.lastName) { %> <%= session.lastName %><% } %></span>
          </li>
          <% if (!_ahIsInternal) { %>
          <li class="notification-icon">
            <a href="/admin/helpMessages">
              <img src="/images/msgicon.png" alt="Messages" class="notification-image">
            </a>
            <% if (unresolvedCount > 0) { %>
              <span class="notification-badge"><%= unresolvedCount %></span>
            <% } %>
          </li>
          <% } %>
          <li class="admin-profile-container" id="admin-profile-container">
            <button type="button" class="admin-profile-btn" id="admin-profile-btn" aria-haspopup="true" aria-expanded="false" aria-label="Profile menu">
              <span class="admin-profile-avatar">
                <% if (session.profileImageUrl) { %>
                  <img src="<%= session.profileImageUrl %>" alt="Profile picture" />
                <% } else { %>
                  <%= (session.firstName || '?').charAt(0).toUpperCase() %>
                <% } %>
              </span>
            </button>
            <div class="admin-profile-dropdown" id="admin-profile-dropdown" role="menu">
              <div class="admin-profile-dropdown__header">
                <div class="admin-profile-dropdown__name"><%= session.firstName %><% if (session.lastName) { %> <%= session.lastName %><% } %></div>
                <div class="admin-profile-dropdown__role"><%= session.accountType %></div>
              </div>
              <a href="/admin/profile" class="admin-profile-dropdown__item" role="menuitem" data-no-spa>⚙️ Profile Settings</a>
              <a href="/account/logout" class="admin-profile-dropdown__item admin-profile-dropdown__item--danger" data-no-spa role="menuitem">↩ Logout</a>
            </div>
          </li>
          <li class="admin-hamburger-container">
            <div class="admin-hamburger" id="admin-hamburger" role="button" tabindex="0" aria-label="Open menu" aria-controls="admin-hamburger-menu" aria-expanded="false">
              <span class="bar"></span>
              <span class="bar"></span>
              <span class="bar"></span>
            </div>
          </li>
        </ul>
        <%
          const _ahPath = (typeof currentPath !== 'undefined' && currentPath) ? String(currentPath) : '';
          const _ahActive = (href) => href === '/admin' ? _ahPath === '/admin' || _ahPath === '/admin/' : _ahPath === href || _ahPath.startsWith(href + '/');
          const _ahGroups = [];
          if (_ahIsInternal) {
            _ahGroups.push({ label: 'Workspace', items: [
              { href: '/admin', icon: 'fa-gauge', text: 'Dashboard' },
              ...(_ahCanViewOrgChart ? [{ href: '/admin/org-chart', icon: 'fa-sitemap', text: 'Team Org Chart' }] : []),
            ] });
            _ahGroups.push({ label: 'Resources', items: [
              { href: '/legal/app-demo', icon: 'fa-desktop', text: 'App Demo', external: true },
            ] });
          } else {
            _ahGroups.push({ label: 'Overview', items: [
              { href: '/admin', icon: 'fa-gauge', text: 'Dashboard' },
              ...(_ahIsFullAdmin ? [{ href: '/admin/superDashboard', icon: 'fa-user-shield', text: 'Super Admin' }] : []),
            ] });
            if (_ahIsFullAdmin) {
              _ahGroups.push({ label: 'Schools & billing', items: [
                { href: '/admin/scheduled-holds', icon: 'fa-calendar-xmark', text: 'Subscription Cancellation' },
                { href: '/admin/create-promo', icon: 'fa-tags', text: 'Discounts' },
                { href: '/admin/servicePricing', icon: 'fa-money-bill-wave', text: 'Service Pricing' },
                { href: '/admin/data-export', icon: 'fa-file-export', text: 'Data Export' },
              ] });
              _ahGroups.push({ label: 'Communication', items: [
                { href: '/admin/announcements', icon: 'fa-bullhorn', text: 'Announcements & Ads' },
                { href: '/admin/email-suppressions', icon: 'fa-envelope', text: 'Email Suppressions' },
              ] });
              _ahGroups.push({ label: 'Team', items: [
                { href: '/admin/org-chart', icon: 'fa-sitemap', text: 'Team Org Chart' },
                { href: '/admin/employment', icon: 'fa-briefcase', text: 'Employment' },
                { href: '/admin/donations', icon: 'fa-hand-holding-heart', text: 'Donations' },
              ] });
            }
            _ahGroups.push({ label: 'Resources', items: [
              { href: 'https://forms.gle/uc9qatwCgWf1jMnv6', icon: 'fa-clipboard-list', text: 'Weekly Internal Report', external: true },
              { href: 'https://calendly.com/managirasms/managira-team-review-meeting', icon: 'fa-calendar-days', text: 'Calendar', external: true },
              { href: '/legal/app-demo', icon: 'fa-desktop', text: 'App Demo', external: true },
              { href: '/legal/help', icon: 'fa-circle-question', text: 'Help Center', external: true },
              { href: '/legal/user-documentation', icon: 'fa-book', text: 'Documentation', external: true },
            ] });
          }
        %>
        <div class="admin-hamburger-overlay" id="admin-hamburger-overlay">
          <nav class="admin-menu" id="admin-hamburger-menu" aria-label="Admin menu">
            <div class="admin-menu__head">
              <span class="admin-menu__avatar" aria-hidden="true">
                <% if (session.profileImageUrl) { %>
                  <img src="<%= session.profileImageUrl %>" alt="" />
                <% } else { %>
                  <%= (session.firstName || '?').charAt(0).toUpperCase() %>
                <% } %>
              </span>
              <span class="admin-menu__who">
                <span class="admin-menu__name"><%= session.firstName %><% if (session.lastName) { %> <%= session.lastName %><% } %></span>
                <span class="admin-menu__role"><%= session.accountType %></span>
              </span>
              <button type="button" class="admin-menu__close" data-admin-menu-close aria-label="Close menu">&times;</button>
            </div>
            <div class="admin-menu__body">
              <% _ahGroups.forEach((group) => { %>
                <div class="admin-menu__group">
                  <div class="admin-menu__label"><%= group.label %></div>
                  <% group.items.forEach((item) => { const active = !item.external && _ahActive(item.href); %>
                    <a href="<%= item.href %>" class="admin-menu__link<%= active ? ' is-active' : '' %>"<%- item.external ? ' target="_blank" rel="noopener"' : '' %><%- (item.external || _ahIsInternal) ? ' data-no-spa' : '' %><%- active ? ' aria-current="page"' : '' %>>
                      <i class="fa-solid <%= item.icon %>" aria-hidden="true"></i>
                      <span><%= item.text %></span>
                      <% if (item.external) { %><i class="fa-solid fa-arrow-up-right-from-square admin-menu__ext" aria-hidden="true"></i><% } %>
                    </a>
                  <% }) %>
                </div>
              <% }) %>
            </div>
            <div class="admin-menu__foot">
              <a href="/admin/profile" class="admin-menu__link<%= _ahActive('/admin/profile') ? ' is-active' : '' %>"<%- _ahIsInternal ? ' data-no-spa' : '' %>><i class="fa-solid fa-gear" aria-hidden="true"></i><span>Profile Settings</span></a>
              <a href="/account/logout" class="admin-menu__link admin-menu__link--danger" data-no-spa><i class="fa-solid fa-right-from-bracket" aria-hidden="true"></i><span>Logout</span></a>
            </div>
          </nav>
        </div>
      </nav>
    </div>
  <% } %>
</header>

<style>
    .admin-header-pro {
      background: #fff;
      color: #1e293b;
      padding: 0.7rem 2.5vw;
      display: flex;
      align-items: center;
      justify-content: space-between;
      box-shadow: 0 10px 26px rgba(15, 23, 42, 0.08);
      border: 1px solid #e5e7eb;
      border-radius: 14px;
      max-width: 1200px;
      margin: 12px auto;
      flex-wrap: wrap;
      z-index: 1000;
    }
    .admin-header-left {
      display: flex;
      align-items: center;
      gap: 1.1rem;
    }
    .admin-header-logo {
      height: 44px;
      width: 44px;
      border-radius: 8px;
      background: #fff;
      box-shadow: 0 2px 8px rgba(30,41,59,0.08);
      object-fit: contain;
      padding: 2px;
    }
    .admin-header-title {
      font-size: 2rem;
      font-weight: 700;
      letter-spacing: 1px;
      color: #2563eb;
      text-shadow: 0 2px 8px rgba(30,41,59,0.08);
    }
    .admin-header-nav {
      flex: 1;
      display: flex;
      justify-content: flex-end;
    }
    .admin-header-nav-list {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      margin: 0;
      padding: 0.3rem 0.7rem;
      list-style: none;
      background: #f7fafd;
      border-radius: 32px;
      box-shadow: 0 2px 8px rgba(30,41,59,0.04);
      flex-wrap: wrap;
    }
    .notification-icon {
      position: relative;
      cursor: pointer;
      margin-right: 0.5rem;
    }
    .notification-image {
      width: 30px;
      height: 30px;
      vertical-align: middle;
    }
    .notification-badge {
      position: absolute;
      top: -5px;
      right: -5px;
      background-color: #ef4444;
      color: white;
      font-size: 0.8rem;
      font-weight: bold;
      border-radius: 50%;
      padding: 4px 7px;
      line-height: 1;
      box-shadow: 0 1px 4px rgba(30,41,59,0.10);
      border: 2px solid #fff;
    }
    .admin-hamburger-container {
      position: relative;
      margin-left: 10px;
    }
    .admin-hamburger {
      width: 38px;
      height: 38px;
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      cursor: pointer;
      background: #f7fafd;
      border-radius: 8px;
      box-shadow: 0 2px 8px rgba(30,41,59,0.04);
      border: 1.5px solid #e0e7ef;
      transition: background 0.18s;
    }
    .admin-hamburger .bar {
      width: 24px;
      height: 3px;
      background: #2563eb;
      margin: 3px 0;
      border-radius: 2px;
      transition: all 0.2s;
    }
    .admin-hamburger-overlay {
      display: none;
      position: fixed;
      inset: 0;
      background: rgba(15, 23, 42, 0.42);
      backdrop-filter: blur(2px);
      z-index: 3000;
      justify-content: flex-end;
      align-items: stretch;
    }
    .admin-hamburger-overlay.show {
      display: flex;
      animation: adminMenuFade 0.18s ease;
    }
    .admin-menu {
      text-align: left;
      width: 300px;
      max-width: 88vw;
      height: 100%;
      display: flex;
      flex-direction: column;
      background: #fff;
      border-left: 1px solid #e5e7eb;
      box-shadow: -12px 0 40px rgba(15, 23, 42, 0.18);
      animation: adminMenuIn 0.24s cubic-bezier(0.22, 1, 0.36, 1);
    }
    .admin-menu__head {
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 18px 16px 16px 18px;
      border-bottom: 1px solid #eef2f7;
    }
    .admin-menu__avatar {
      width: 40px;
      height: 40px;
      flex-shrink: 0;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      border-radius: 50%;
      overflow: hidden;
      background: #01535b;
      color: #fff;
      font-weight: 700;
    }
    .admin-menu__avatar img { width: 100%; height: 100%; object-fit: cover; }
    .admin-menu__who { display: flex; flex-direction: column; min-width: 0; flex: 1; }
    .admin-menu__name { font-weight: 700; color: #0f172a; font-size: 0.95rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .admin-menu__role { color: #64748b; font-size: 0.78rem; }
    .admin-menu__close {
      width: 34px !important;
      height: 34px;
      margin: 0 !important;
      padding: 0 !important;
      flex-shrink: 0;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      border: 1px solid #e5e7eb !important;
      border-radius: 50%;
      background: #fff !important;
      color: #334155 !important;
      font-size: 1.25rem;
      line-height: 1;
      cursor: pointer;
    }
    .admin-menu__close:hover { background: #f1f5f9 !important; }
    .admin-menu__body {
      flex: 1;
      overflow-y: auto;
      padding: 8px 10px 12px;
    }
    .admin-menu__group { padding: 8px 0 4px; }
    .admin-menu__group + .admin-menu__group { border-top: 1px solid #f1f5f9; }
    .admin-menu__label {
      padding: 4px 10px 6px;
      font-size: 0.68rem;
      font-weight: 700;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: #94a3b8;
    }
    .admin-menu__link {
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 9px 10px;
      border-radius: 10px;
      color: #1e293b;
      font-size: 0.9rem;
      font-weight: 600;
      line-height: 1.25;
      text-decoration: none;
      transition: background 0.15s ease, color 0.15s ease;
    }
    .admin-menu__link > i:first-child { width: 18px; text-align: center; color: #64748b; font-size: 0.9rem; }
    .admin-menu__link:hover { background: #f1f5f9; color: #0f172a; }
    .admin-menu__link:focus-visible { outline: 2px solid #2563eb; outline-offset: 1px; }
    .admin-menu__link.is-active { background: #eff6ff; color: #1d4ed8; }
    .admin-menu__link.is-active > i:first-child { color: #2563eb; }
    .admin-menu__ext { margin-left: auto; font-size: 0.68rem; color: #cbd5e1; }
    .admin-menu__foot {
      padding: 10px;
      border-top: 1px solid #eef2f7;
      display: grid;
      gap: 2px;
    }
    .admin-menu__link--danger { color: #b91c1c; }
    .admin-menu__link--danger > i:first-child { color: #dc2626; }
    .admin-menu__link--danger:hover { background: #fef2f2; color: #991b1b; }
    @keyframes adminMenuFade { from { opacity: 0; } to { opacity: 1; } }
    @keyframes adminMenuIn { from { transform: translateX(100%); } to { transform: translateX(0); } }
    @media (prefers-reduced-motion: reduce) {
      .admin-hamburger-overlay.show, .admin-menu { animation: none; }
    }
    body {
      overflow: auto !important;
    }
    .admin-header-link {
      text-decoration: none;
      color: #2563eb;
      padding: 9px 18px;
      font-size: 1.08rem;
      font-weight: 600;
      border-radius: 999px;
      background: transparent;
      transition: background 0.18s, color 0.18s, box-shadow 0.18s;
      border: 1.5px solid #e0e7ef;
      box-shadow: none;
      margin: 0 2px;
      display: inline-block;
    }
    .admin-header-link:hover {
      background: #2563eb;
      color: #fff;
      border: 1.5px solid #2563eb;
      box-shadow: 0 2px 8px rgba(37,99,235,0.10);
    }
    @media (max-width: 1024px) {
      .admin-header-pro {
        flex-direction: column;
        align-items: flex-start;
        padding: 12px 10px;
        border-radius: 12px;
        margin: 10px 10px 0;
      }
      .admin-header-title {
        font-size: 1.3rem;
        margin-bottom: 8px;
      }
      .admin-header-nav-list {
        gap: 0.3rem;
        flex-wrap: wrap;
        justify-content: flex-start;
      }
      .admin-header-link {
        font-size: 0.98rem;
        padding: 7px 10px;
      }
    }
    @media (max-width: 768px) {
      .admin-header-pro {
        padding: 8px 10px;
        flex-direction: row;
        align-items: center;
        justify-content: space-between;
        gap: 8px;
        flex-wrap: nowrap;
        border-radius: 10px;
        margin: 8px 8px 0;
      }
      .admin-header-left {
        gap: 0.65rem;
        min-width: 0;
        flex: 1 1 auto;
      }
      .admin-header-logo {
        width: 34px;
        height: 34px;
      }
      .admin-header-title {
        font-size: 0.95rem;
        margin-bottom: 0;
        text-align: left;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
      }
      .admin-header-nav {
        flex: 0 0 auto;
      }
      .admin-header-nav-list {
        flex-direction: row;
        align-items: center;
        gap: 6px;
        width: auto;
        padding: 0.2rem 0.2rem;
        background: none;
        border-radius: 0;
        box-shadow: none;
        flex-wrap: nowrap;
      }
      .admin-hamburger-container {
        margin-left: 0;
      }
      .notification-icon {
        margin-bottom: 0;
        margin-right: 0;
      }
      .admin-header-welcome {
        /* On small screens we briefly show, then auto-hide via JS */
        display: flex;
        flex-direction: row;
        align-items: center;
        gap: 4px;
        max-width: 60vw;
        transition: opacity 400ms ease, transform 400ms ease, max-width 400ms ease, margin 400ms ease;
      }
      .admin-header-welcome__hi { font-size: 0.65rem; }
      .admin-header-welcome__name { font-size: 0.85rem; max-width: 50vw; }
      .admin-header-welcome.is-hidden {
        opacity: 0;
        transform: translateX(-6px);
        max-width: 0;
        margin: 0;
        padding: 0;
        overflow: hidden;
        pointer-events: none;
      }
    }

    /* Welcome label */
    .admin-header-welcome {
      display: flex;
      flex-direction: column;
      align-items: flex-end;
      line-height: 1.1;
      margin-right: 4px;
      max-width: 220px;
    }
    .admin-header-welcome__hi {
      font-size: 0.7rem;
      color: #64748b;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      font-weight: 600;
    }
    .admin-header-welcome__name {
      font-size: 0.95rem;
      font-weight: 700;
      color: #0f172a;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
      max-width: 220px;
    }

    /* Profile button + dropdown */
    .admin-profile-container {
      position: relative;
      display: flex;
      align-items: center;
    }
    .admin-profile-btn {
      background: none;
      border: 0;
      padding: 0;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      justify-content: center;
    }
    .admin-profile-avatar {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 36px;
      height: 36px;
      border-radius: 50%;
      background: linear-gradient(135deg, #01535b, #047a85);
      color: #fff;
      font-weight: 700;
      font-size: 0.95rem;
      box-shadow: 0 2px 6px rgba(1, 83, 91, 0.25);
      transition: transform 150ms ease, box-shadow 150ms ease;
      overflow: hidden;
    }
    .admin-profile-avatar img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }
    .admin-profile-btn:hover .admin-profile-avatar,
    .admin-profile-btn:focus-visible .admin-profile-avatar {
      transform: scale(1.05);
      box-shadow: 0 4px 12px rgba(1, 83, 91, 0.35);
    }
    .admin-profile-dropdown {
      display: none;
      position: absolute;
      top: calc(100% + 8px);
      right: 0;
      min-width: 220px;
      background: #fff;
      border: 1px solid #e5e7eb;
      border-radius: 10px;
      box-shadow: 0 18px 40px rgba(15, 23, 42, 0.18);
      overflow: hidden;
      z-index: 1100;
    }
    .admin-profile-container.open .admin-profile-dropdown { display: block; }
    .admin-profile-dropdown__header {
      padding: 12px 14px;
      background: #f8fafc;
      border-bottom: 1px solid #e5e7eb;
    }
    .admin-profile-dropdown__name {
      font-weight: 700;
      font-size: 0.95rem;
      color: #0f172a;
    }
    .admin-profile-dropdown__role {
      font-size: 0.78rem;
      color: #64748b;
      margin-top: 2px;
    }
    .admin-profile-dropdown__item {
      display: block;
      padding: 10px 14px;
      font-size: 0.9rem;
      color: #1e293b;
      text-decoration: none;
      border-top: 1px solid #f1f5f9;
    }
    .admin-profile-dropdown__item:first-of-type { border-top: 0; }
    .admin-profile-dropdown__item:hover { background: #f1f5f9; }
    .admin-profile-dropdown__item--danger { color: #dc2626; }
    .admin-profile-dropdown__item--danger:hover { background: #fef2f2; }
</style>

<script>
  (function () {
    function initAdminHamburger() {
      const hamburger = document.getElementById("admin-hamburger");
      const overlay = document.getElementById("admin-hamburger-overlay");
      const menu = document.getElementById("admin-hamburger-menu");

      if (!hamburger || !overlay || !menu) return;

      if (hamburger.dataset.menuBound === "1") return;
      hamburger.dataset.menuBound = "1";

      const closeMenu = function () {
        if (!overlay.classList.contains("show")) return;
        overlay.classList.remove("show");
        hamburger.classList.remove("active");
        hamburger.setAttribute("aria-expanded", "false");
        hamburger.focus();
      };
      const openMenu = function () {
        overlay.classList.add("show");
        hamburger.classList.add("active");
        hamburger.setAttribute("aria-expanded", "true");
        const current = menu.querySelector(".is-active") || menu.querySelector("a");
        if (current) current.focus({ preventScroll: true });
      };
      const toggleMenu = function (e) {
        e.preventDefault();
        e.stopPropagation();
        if (overlay.classList.contains("show")) closeMenu(); else openMenu();
      };

      hamburger.addEventListener("click", toggleMenu);
      hamburger.addEventListener("keydown", function (e) {
        if (e.key === "Enter" || e.key === " ") toggleMenu(e);
      });
      menu.querySelectorAll("[data-admin-menu-close]").forEach(function (btn) {
        btn.addEventListener("click", closeMenu);
      });
      document.addEventListener("keydown", function (e) {
        if (e.key === "Escape") closeMenu();
      });

      overlay.addEventListener("click", function (e) {
        if (e.target === overlay) {
          closeMenu();
        }
      });

      Array.from(menu.querySelectorAll("a")).forEach(function (link) {
        if (link.dataset.menuLinkBound === "1") return;
        link.dataset.menuLinkBound = "1";
        link.addEventListener("click", function () {
          closeMenu();
        });
      });
    }

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", initAdminHamburger);
    } else {
      initAdminHamburger();
    }

    // Keep the current-page highlight right after in-app (SPA) navigation.
    function markActiveLink() {
      const menu = document.getElementById("admin-hamburger-menu");
      if (!menu) return;
      const path = window.location.pathname.replace(/\/$/, "") || "/";
      menu.querySelectorAll("a.admin-menu__link").forEach(function (link) {
        const href = (link.getAttribute("href") || "").replace(/\/$/, "");
        if (!href.startsWith("/") || link.target === "_blank") return;
        const active = href === "/admin" ? path === "/admin" : path === href || path.startsWith(href + "/");
        link.classList.toggle("is-active", active);
        if (active) link.setAttribute("aria-current", "page");
        else link.removeAttribute("aria-current");
      });
    }

    window.addEventListener("spa:pageLoaded", function () {
      initAdminHamburger();
      markActiveLink();
    });
  })();

  // Profile dropdown toggle
  (function () {
    function initAdminProfile() {
      var container = document.getElementById("admin-profile-container");
      var btn = document.getElementById("admin-profile-btn");
      if (!container || !btn) return;
      if (btn.dataset.profileBound === "1") return;
      btn.dataset.profileBound = "1";

      function close() {
        container.classList.remove("open");
        btn.setAttribute("aria-expanded", "false");
      }
      function open() {
        container.classList.add("open");
        btn.setAttribute("aria-expanded", "true");
      }

      btn.addEventListener("click", function (e) {
        e.stopPropagation();
        if (container.classList.contains("open")) close(); else open();
      });

      document.addEventListener("click", function (e) {
        if (!container.contains(e.target)) close();
      });

      document.addEventListener("keydown", function (e) {
        if (e.key === "Escape") close();
      });
    }

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", initAdminProfile);
    } else {
      initAdminProfile();
    }

    window.addEventListener("spa:pageLoaded", initAdminProfile);
  })();

  // Auto-hide welcome label on small screens after 10 seconds
  (function () {
    var hideTimer = null;
    function initWelcomeAutoHide() {
      var welcome = document.querySelector(".admin-header-welcome");
      if (!welcome) return;
      if (hideTimer) { clearTimeout(hideTimer); hideTimer = null; }
      welcome.classList.remove("is-hidden");
      // Only auto-hide on small screens
      if (window.matchMedia && window.matchMedia("(max-width: 700px)").matches) {
        hideTimer = setTimeout(function () {
          welcome.classList.add("is-hidden");
        }, 10000);
      }
    }

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", initWelcomeAutoHide);
    } else {
      initWelcomeAutoHide();
    }

    window.addEventListener("spa:pageLoaded", initWelcomeAutoHide);
  })();
</script>
