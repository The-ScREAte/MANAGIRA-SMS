<%# The one Save button under a Notifications section: it saves the alerts and the emails above it
    together, and stays off until something changes (public/js/alertRules.js). The section around it
    carries data-ns-scope. %>
<div class="ns-savebar" data-ns-savebar>
  <button type="button" class="ns-save" disabled>Save notifications</button>
  <span class="ns-status" role="status"></span>
</div>
