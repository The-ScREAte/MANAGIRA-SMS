<%#
  A school's own staff roles on Add user and Edit user (utils/schoolRoles.js, public/js/schoolRoles.js).
  part 'options': inside the Role select — each school role is an option whose value is the built-in
  role it's based on (so everything that reads the select still sees Manager / Supervisor / Teacher /
  Driver), then "+ Add a role…".
  part 'panel': after the select — the chosen school role (hidden schoolRoleId), the new-role box and
  the line that saves ticked permissions to the role.
%>
<% const _sr = locals.schoolRoles; if (_sr && _sr.on) { const _current = Number(locals.schoolRoleId) || 0; %>
<% if (part === 'options') { %>
  <% if (_sr.roles.length) { %><optgroup label="Your school's roles" data-school-roles-group><% _sr.roles.forEach((r) => { %>
    <option value="<%= r.base %>" data-role-id="<%= r.id %>" data-role-name="<%= r.name %>" data-permissions="<%= JSON.stringify(r.permissions) %>"<%= r.id === _current ? ' selected' : '' %>><%= r.name %></option>
  <% }) %></optgroup><% } %>
  <option value="" data-add-role>＋ Add a role…</option>
<% } else { %>
  <input type="hidden" name="schoolRoleId" value="<%= _current || '' %>" data-school-role-input>
  <div class="sr-box" data-school-role-box hidden>
    <div class="sr-row">
      <label class="sr-field"><span>Role name</span><input type="text" maxlength="60" placeholder="e.g. Food Service" data-sr-name autocomplete="off"></label>
      <label class="sr-field"><span>Based on</span>
        <select data-sr-base>
          <option value="Teacher">Teacher</option>
          <option value="Supervisor">Supervisor</option>
          <% if (_sr.canAddManager) { %><option value="Manager">Manager</option><% } %>
          <% if (_sr.canAddDriver) { %><option value="Driver">Driver</option><% } %>
        </select>
      </label>
    </div>
    <p class="sr-hint">It starts with the permissions of the role it's based on. Change them below, then save them to the role.</p>
    <p class="sr-error" data-sr-error role="alert" hidden></p>
    <div class="sr-actions">
      <button type="button" class="sr-btn sr-btn--main" data-sr-save>Add role</button>
      <button type="button" class="sr-btn" data-sr-cancel>Cancel</button>
    </div>
  </div>
  <p class="sr-line" data-school-role-line hidden>
    <span data-sr-about></span>
    <button type="button" class="sr-link" data-sr-update hidden>Save the ticked permissions to this role</button>
    <button type="button" class="sr-link sr-link--quiet" data-sr-remove>Remove role</button>
    <span class="sr-done" data-sr-done hidden></span>
  </p>
  <style>
    .sr-box { margin: 10px 0 4px; padding: 14px; border: 1px solid #dbe3ec; border-radius: 10px; background: #f8fafc; }
    .sr-row { display: flex; gap: 12px; flex-wrap: wrap; }
    .sr-field { display: flex; flex-direction: column; gap: 4px; flex: 1 1 180px; font-size: 13px; color: #334155; font-weight: 600; }
    .sr-field input, .sr-field select { font: inherit; font-weight: 400; padding: 8px 10px; border: 1px solid #cbd5e1; border-radius: 8px; background: #fff; min-height: 38px; }
    .sr-hint { margin: 8px 0 0; font-size: 12px; color: #64748b; }
    .sr-error { margin: 8px 0 0; font-size: 13px; color: #b91c1c; }
    .sr-actions { display: flex; gap: 8px; margin-top: 10px; }
    .sr-box .sr-btn { all: unset; box-sizing: border-box; cursor: pointer; padding: 8px 14px; border-radius: 8px; font-size: 13px; font-weight: 600; border: 1px solid #cbd5e1; color: #334155; background: #fff; }
    .sr-box .sr-btn--main { background: var(--primary-color, #0f766e); border-color: transparent; color: #fff; }
    .sr-box .sr-btn[disabled] { opacity: .6; cursor: default; }
    .sr-line { margin: 6px 0 0; font-size: 12.5px; color: #64748b; display: flex; flex-wrap: wrap; gap: 4px 12px; align-items: baseline; }
    .sr-line .sr-link { all: unset; cursor: pointer; color: var(--primary-color, #0f766e); font-weight: 600; }
    .sr-line .sr-link--quiet { color: #64748b; font-weight: 500; }
    .sr-line .sr-link:hover { text-decoration: underline; }
    .sr-done { color: #15803d; }
    .sr-box[hidden], .sr-line[hidden], .sr-line [hidden], .sr-error[hidden] { display: none !important; }
  </style>
  <script src="/js/schoolRoles.js" defer></script>
  <script>window.ManagiraSchoolRoles && window.ManagiraSchoolRoles.scan();</script>
<% } %>
<% } %>
