<link rel="stylesheet" href="<%= assetUrl('/css/header.css') %>" />
<style>:root { --org-primary-color: <%= headerCurrentTheme.primary %>; --org-primary-hover: <%= headerCurrentTheme.hover %>; }</style>

<%
  const normalizeLogoSrc = (logo) => {
    if (!logo) return "";
    if (/^https?:\/\//i.test(logo)) return logo;
    if (/^s3:\/\//i.test(logo) || /^images\/(?:logos|hub-logos|website|donations)\//i.test(logo) || /^\d{13}-[^/]+\.[a-z0-9]+$/i.test(logo)) return logo;
    if (logo.startsWith("/")) return logo;
    return `/${logo}`;
  };
%>
