  z-index: 11050;
  overflow: hidden;
  animation: notif-panel-in 0.18s ease;
}
.notif-panel.notif-panel--open { display: flex; flex-direction: column; }
@keyframes notif-panel-in {
  from { opacity: 0; transform: translateY(-8px); }
  to   { opacity: 1; transform: translateY(0);    }
}

/* Panel header */
.notif-panel-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12px 16px 10px;
  border-bottom: 1px solid color-mix(in srgb, var(--org-primary-color, #01535b) 14%, #f0f0f0);
  background: color-mix(in srgb, var(--org-primary-color, #01535b) 6%, #ffffff);
  flex-shrink: 0;
}
.notif-panel-title {
  font-size: 0.92rem;
  font-weight: 700;
  color: var(--org-primary-color, #01535b);
}
.notif-header-actions { display: flex; align-items: center; gap: 2px; }
.notif-mark-all-btn,
.notif-clear-all-btn {
  background: none;
  border: none;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 28px;
  height: 28px;
  border-radius: 6px;
  padding: 0;
  transition: background 0.15s, color 0.15s;
}
.notif-mark-all-btn { color: var(--org-primary-color, #01535b); }
.notif-mark-all-btn:hover { background: color-mix(in srgb, var(--org-primary-color, #01535b) 12%, #ffffff); }
.notif-clear-all-btn { color: color-mix(in srgb, var(--org-primary-color, #01535b) 78%, #64748b); }
.notif-clear-all-btn:hover { background: color-mix(in srgb, var(--org-primary-color, #01535b) 12%, #ffffff); color: var(--org-primary-color, #01535b); }

/* List */
.notif-list {
  overflow-y: auto;
  overflow-x: hidden;
  max-height: 380px;
  padding: 4px 0;
}
.notif-loading,
.notif-empty {
  padding: 28px 16px;
  text-align: center;
  font-size: 0.85rem;
  color: #9ca3af;
}

/* Individual item */
.notif-item {
  display: flex;
  align-items: flex-start;
  gap: 10px;
  padding: 10px 14px;
  cursor: pointer;
  border-bottom: 1px solid #f9f9f9;
  transition: background 0.14s ease;
  text-decoration: none;
  color: inherit;
}
.notif-item:last-child { border-bottom: none; }
.notif-item:hover { background: color-mix(in srgb, var(--org-primary-color, #01535b) 5%, #f8fafc); }
.notif-item--unread { background: color-mix(in srgb, var(--org-primary-color, #01535b) 9%, #ffffff); }
