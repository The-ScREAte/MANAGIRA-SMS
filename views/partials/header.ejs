    </div>
    <ul class="nav-menu header-nav-menu public-header-nav-menu" id="header-nav-menu">
      <% publicMarketingNav.forEach((menu, menuIndex) => { %>
        <li class="nav-item public-mobile-group <%= menu.label === 'Products' ? 'public-mobile-group--products' : '' %>">
          <button type="button" class="submenu-toggle public-mobile-toggle" data-target="public-mobile-submenu-<%= menuIndex %>">
