<% const isMarketingHome = !!(!isLoggedIn && !isPublicDashboard && !isSchoolSubdomainContext && headerCurrentPath === '/'); %>
<% const showPublicOrgIdentity = !!(!isLoggedIn && (isPublicDashboard || isSchoolSubdomainContext)); %>
