  border-radius: 8px;
  color: var(--org-primary-color, #01535b);
  display: inline-flex;
  align-items: center;
  justify-content: center;
  transition: background 0.18s ease;
  line-height: 1;
}
.notif-bell-btn:hover { background: rgba(0,0,0,0.07); }
.notif-bell-btn:focus-visible { outline: 2px solid var(--org-primary-color,#01535b); }

/* Badge */
.notif-badge {
  position: absolute;
  top: 1px;
  right: 1px;
  background: #dc2626;
  color: #fff;
  font-size: 0.6rem;
  font-weight: 700;
