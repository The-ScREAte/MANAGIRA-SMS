            <% } else { %>
              <% menu.sections.forEach((section) => { %>
                <% if (section.image) { %>
                  <div class="public-mobile-section-visual"><img src="<%= section.image %>" alt="<%= section.imageAlt || section.title %>" /></div>
                <% } %>
                <span class="public-mobile-section-title"><%= section.title %></span>
                <% section.links.forEach((link) => { %>
                  <a href="<%= link.href %>" class="public-mobile-link management-link">
                    <%= link.label %>
                    <span><%= link.description %></span>
                  </a>
                <% }); %>
              <% }); %>
            <% } %>
          </div>
        </li>
      <% }); %>
      <li class="nav-item public-mobile-action"><a href="/legal/request-demo" class="management-link">Talk to an Expert</a></li>
    </ul>
    <% } else { %>
    <a id="loginbutton" title="Click to log in" href="/account/login"
      >Sign In | Sign Up</a>
    <% } %>
    <% } %>
  </div>
