      margin-left: 8px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      z-index: 11030;
    }

    .sticky-nav {
      position: fixed !important;
      /* Always anchor to visual-viewport bottom — no offset on `bottom` itself.
         This prevents the hard snap when browser chrome hides/shows.
         The safe-area is handled via padding-bottom instead, which transitions. */
      bottom: 0 !important;
      top: auto !important;
      left: 0;
      width: 100%;
      /* push content up for home-indicator; transitions when inset changes */
      padding: 8px 8px 0 8px;
      padding-bottom: env(safe-area-inset-bottom, 0px);
      background: transparent;
      border-top: none;
      box-shadow: none;
      backdrop-filter: none;
      z-index: 10010;
      /* own compositor layer → follows viewport resize without repaint flash */
      transform: translateZ(0);
      -webkit-transform: translateZ(0);
      will-change: transform;
      /* smooth out safe-area-inset changes */
      transition: padding-bottom 0.12s ease;
    }

    .sticky-nav ul {
      display: flex;
      flex-direction: row;
      flex-wrap: nowrap;
      justify-content: flex-start;
      align-items: center;
      gap: 1px;
      padding: 6px 8px;
      overflow-x: auto;
      scrollbar-width: none;
      max-width: 100%;
      background: rgba(255, 255, 255, 0.68);
      border: 1px solid rgba(255, 255, 255, 0.5);
      border-radius: 999px;
      box-shadow: 0 10px 24px rgba(15, 23, 42, 0.14);
      backdrop-filter: blur(14px) saturate(140%);
      -webkit-backdrop-filter: blur(14px) saturate(140%);
    }

    .sticky-nav ul::-webkit-scrollbar {
      display: none;
    }

    .sticky-nav ul li {
      flex: 0 0 auto;
      text-align: center;
    }

    header#top-header .sticky-nav ul li a {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      padding: 7px;
      font-size: 11.5px;
      min-width: 40px;
      min-height: 40px;
      border-radius: 50%;
      background: var(--org-primary-color, #01535b);
      color: #fff;
      border: 1px solid var(--org-primary-color, #01535b);
    }

    header#top-header .sticky-nav ul li a .nav-text {
      display: none;
    }

    header#top-header .sticky-nav ul li a .nav-icon {
      width: 18px;
      height: 18px;
      margin: 0;
    }

    header#top-header .sticky-nav ul li a[href="#events"] {
      min-width: 38px;
      min-height: 38px;
      padding: 6px;
    }

    header#top-header .sticky-nav ul li a[href="#events"] .nav-icon {
