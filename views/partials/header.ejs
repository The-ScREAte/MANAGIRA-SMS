<script>
  const CURRENT_TERM_ID =
    "<%= currentTerm?.term_id || session.currentTermId || '' %>";
</script>

<script>
  // ...removed log for clean background operation...
    "🧠 Current Term ID:",
    "<%= currentTerm ? currentTerm.term_id : 'Not set' %>"
  
</script>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const hamburger = document.getElementById("hamburger");
    const navMenu = document.getElementById("nav-menu");
    const submenuToggles = document.querySelectorAll(".submenu-toggle");
    const searchInput = document.getElementById("search-input");
    const searchResults = document.getElementById("search-results");
    const searchForm = document.getElementById("search-form");

    // 🔧 Dynamic Organization Nickname Sizing for Mobile
    function adjustOrgNameSize() {
      const orgNickname = document.querySelector('.org-names .org-nickname');
      if (!orgNickname) return;
      
      const isMobile = window.innerWidth <= 768;
      if (!isMobile) return; // Only adjust on mobile
      
      const text = orgNickname.textContent || orgNickname.innerText;
      const textLength = text.length;
      
      // Reset to default
      orgNickname.style.fontSize = '';
      
      // Adjust font size based on text length
      if (textLength > 15) {
        orgNickname.style.fontSize = '0.75em';
      } else if (textLength > 12) {
        orgNickname.style.fontSize = '0.8em';
      } else if (textLength > 8) {
        orgNickname.style.fontSize = '0.85em';
      } else {
        orgNickname.style.fontSize = '0.9em';
      }
    }

    // Apply sizing on load and resize
    adjustOrgNameSize();
    window.addEventListener('resize', adjustOrgNameSize);

    // Hamburger menu toggle with stopPropagation to prevent conflicts
    // Only add listeners if elements exist (prevents errors on hub pages)
    if (hamburger && navMenu) {
      hamburger.addEventListener("click", (e) => {
        e.stopPropagation();
        hamburger.classList.toggle("active");
        navMenu.classList.toggle("show");
      });

      // Prevent clicks inside nav menu from bubbling to document
      navMenu.addEventListener("click", (e) => {
        e.stopPropagation();
      });

      submenuToggles.forEach((toggle) => {
        toggle.addEventListener("click", (e) => {
          e.preventDefault();
          const target = document.getElementById(toggle.dataset.target);
          const arrow = toggle.querySelector(".arrow");

          submenuToggles.forEach((otherToggle) => {
            const otherArrow = otherToggle.querySelector(".arrow");
            const otherTarget = document.getElementById(
              otherToggle.dataset.target
            );
            if (otherTarget !== target) {
              otherTarget.classList.remove("show");
              otherArrow.classList.remove("open");
            }
          });

          arrow.classList.toggle("open");
          target.classList.toggle("show");
        });
      });

      document.addEventListener("click", (e) => {
        if (!e.target.closest("#hamburger") && !e.target.closest("#nav-menu")) {
          hamburger.classList.remove("active");
          navMenu.classList.remove("show");
        }
      });
    }

    function escapeHtml(str) {
      return String(str)
        .replace(/&/g, "&amp;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;")
        .replace(/"/g, "&quot;")
        .replace(/'/g, "&#039;");
    }
    // 🔍 Global Search
    if (searchForm) {
      searchForm.addEventListener("submit", (event) => {
        event.preventDefault();
      });
    }

    if (searchInput) {
      searchInput.setAttribute("readonly", "readonly");
      const unlockSearchInput = () => {
        searchInput.removeAttribute("readonly");
      };
      searchInput.addEventListener("focus", () => {
        setTimeout(unlockSearchInput, 0);
      });
      searchInput.addEventListener("mousedown", unlockSearchInput);
      searchInput.addEventListener("touchstart", unlockSearchInput, { passive: true });

      searchInput.addEventListener("input", async (event) => {
        const query = event.target.value.trim();

        if (query.length > 0) {
          try {
            const response = await fetch(
              `/enrollment/searchUsers?query=${query}`
            );
            const results = await response.json();

            if (results.users.length > 0) {
              searchResults.innerHTML = results.users
                .map((user) => {
                  const image =
                    user.image_url &&
                    user.image_url !== "profilePlaceholder.png"
                      ? user.image_url
                      : "/images/profilePlaceholder.png";

                  if (user.type === "student") {
                    return `<div class="search-result-item">
                      <a href="/common/studentDetails?studentId=${
                        user.student_id
                      }&classId=${user.class_id}&termId=${CURRENT_TERM_ID}">
                                <img src="${image}" alt="User Image">
                                ${escapeHtml(user.first_name)} ${escapeHtml(
                      user.last_name
                    )} (Student - ${escapeHtml(user.class_name)})
                              </a>
                            </div>`;
                  } else if (user.type === "employee") {
                    return `<div class="search-result-item">
                              <a href="/common/employeeDetails?userId=${
                                user.user_id
                              }">
                                <img src="${image}" alt="User Image">
                                ${escapeHtml(user.first_name)} ${escapeHtml(
                      user.last_name
                    )} (${escapeHtml(user.account_type)})
                              </a>
                            </div>`;
                  }
                })
                .join("");
              searchResults.style.display = "block";
            } else {
              searchResults.innerHTML =
                '<div class="search-result-item">No results found.</div>';
              searchResults.style.display = "block";
            }
          } catch (error) {
            console.error("Error fetching search results:", error);
          }
        } else {
          searchResults.innerHTML = "";
          searchResults.style.display = "none";
        }
      });

      document.addEventListener("click", (e) => {
        if (!e.target.closest(".search-bar-container")) {
          searchResults.style.display = "none";
        }
      });
    }
  });
</script>








