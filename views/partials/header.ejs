/* Per-item dismiss button */
.notif-dismiss-btn {
  flex-shrink: 0;
  width: 22px;
  height: 22px;
  border-radius: 50%;
  border: none;
  background: transparent;
  color: #d1d5db;
  font-size: 14px;
  line-height: 1;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0;
  transition: opacity 0.15s, background 0.15s, color 0.15s;
  margin-left: auto;
  padding: 0;
}
.notif-item:hover .notif-dismiss-btn { opacity: 1; }
.notif-dismiss-btn:hover { background: color-mix(in srgb, var(--org-primary-color, #01535b) 12%, #ffffff); color: var(--org-primary-color, #01535b); }

/* Type icon dot */
.notif-icon {
  width: 34px;
  height: 34px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-top: 1px;
}
.notif-icon svg { width: 16px; height: 16px; }

/* Unread dot */
.notif-unread-dot {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: var(--org-primary-color, #01535b);
  flex-shrink: 0;
  margin-top: 6px;
  margin-left: auto;
}
.notif-item--read .notif-unread-dot { display: none; }

.notif-content { flex: 1; min-width: 0; overflow: hidden; }
.notif-title {
  display: block;
  font-size: 0.82rem;
