  const headerThemeColor = (typeof session !== 'undefined' && session && session.themeColor)
    ? session.themeColor
    : ((typeof orgDetails !== 'undefined' && orgDetails && orgDetails.theme_color)
      ? orgDetails.theme_color
      : 'teal');
  const headerThemeColors = themePalette;
  const headerCurrentTheme = headerThemeColors[headerThemeColor] || headerThemeColors.teal;
