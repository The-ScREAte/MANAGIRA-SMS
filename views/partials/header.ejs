  <div class="header-mobile-row">
    <div class="header-mobile-left">
      <span class="siteName">
        <% if (isLoggedIn && typeof orgHeaderLogo !== 'undefined' && orgHeaderLogo) { %>
          <a href="<%= dashboardHref %>" title="Go to dashboard">
            <img src="<%= publicImageUrl(normalizeLogoSrc(orgHeaderLogo), { public: true, width: 256 }) %>" alt="Organization Logo" class="logo" />
          </a>
        <% } else if (showPublicOrgIdentity && publicOrgData && (publicOrgData.logo || publicOrgData.logo_path)) { %>
          <!-- Show org logo on public dashboard even when logged out; clicking goes home -->
          <a href="<%= headerHomeHref %>" title="Return to home page">
            <img src="<%= publicImageUrl(normalizeLogoSrc(publicOrgData.logo || publicOrgData.logo_path), { public: true, width: 256 }) %>" alt="<%= publicOrgFullName || 'Organization' %> Logo" class="logo" />
          </a>
        <% } else if (!isLoggedIn) { %>
          <!-- Only show Managira logo when not logged in -->
          <a
            href="<%= headerHomeHref %>"
            title="Return to home page"
          >
            <img src="/images/managira-logo-sm.png" alt="Managira Logo" class="logo" />
          </a>
        <% } else if (session.logo) { %>
          <!-- Show Organization logo when logged in -->
          <a href="<%= dashboardHref %>" title="Go to dashboard">
            <img src="<%= publicImageUrl(normalizeLogoSrc(session.logo), { public: true, width: 256 }) %>" alt="<%= session.accountType === 'Hub' ? 'Hub' : 'Organization' %> Logo" class="logo" />
          </a>
        <% } else if (session.accountType === 'Hub') { %>
          <!-- Hub without logo - show nothing or hub name only -->
        <% } %>
        <!-- Move org name/nickname outside <a> for better flex and visibility -->
        <% if (isLoggedIn || showPublicOrgIdentity) { %>
          <div class="org-names">
            <a href="<%= showPublicOrgIdentity ? headerHomeHref : dashboardHref %>" title="<%= showPublicOrgIdentity ? 'Return to home page' : 'Go to dashboard' %>">
              <h3 class="org-full-name">
                <% if (typeof orgHeaderName !== 'undefined' && orgHeaderName) { %>
                  <%= orgHeaderName %>
                <% } else if (showPublicOrgIdentity && publicOrgFullName) { %>
                  <%= publicOrgFullName %>
                <% } else if (session.organizationName) { %>
                  <%= session.organizationName %>
                <% } %>
              </h3>
              <h3 class="org-nickname">
                <% if (typeof orgHeaderNicknameDisplay !== 'undefined' && orgHeaderNicknameDisplay) { %>
                  <%= orgHeaderNicknameDisplay %>
                <% } else if (typeof orgHeaderNickname !== 'undefined' && orgHeaderNickname) { %>
                  <%= orgHeaderNickname %>
                <% } else if (showPublicOrgIdentity) { %>
                  <%= publicOrgNicknameDisplay || publicOrgNickname || publicOrgFullName %>
                <% } else if (session.orgNickNameDisplay) { %>
                  <%= session.orgNickNameDisplay %>
                <% } else if (session.orgNickName) { %>
                  <%= session.orgNickName %>
                <% } %>
              </h3>
            </a>
          </div>
        <% } %>
      </span>
    </div>
    <% if (showMarketingMegaNav) { %>
      <nav class="public-header-main" aria-label="Public site navigation">
        <ul class="public-nav-list">
          <% publicMarketingNav.forEach((menu, menuIndex) => { %>
            <li class="public-nav-item" data-public-nav-item>
              <button
                type="button"
                class="public-nav-trigger"
                aria-expanded="false"
                aria-controls="public-nav-panel-<%= menuIndex %>"
                <% if (menu.landingHref) { %>data-nav-href="<%= menu.landingHref %>"<% } %>
              ><%= menu.label %></button>
              <div
                class="public-nav-panel <%= menu.sections && menu.sections.some((section) => section.image) ? 'public-nav-panel--with-section-images' : '' %>"
                id="public-nav-panel-<%= menuIndex %>"
                role="group"
                aria-label="<%= menu.label %> menu"
              >
                <div class="public-nav-panel-inner <%= menu.heroImage ? 'public-nav-spotlight' : '' %>">
                  <div class="public-nav-overview">
                    <span class="public-nav-eyebrow"><%= menu.eyebrow %></span>
                    <h3><%= menu.title %></h3>
                    <p><%= menu.description %></p>
                    <% if (menu.ctaLabel) { %>
                      <a href="<%= menu.ctaHref %>"><%= menu.ctaLabel %></a>
                    <% } %>
                  </div>
                  <% if (menu.heroImage) { %>
                    <div class="public-nav-visual <%= menu.heroImage === '/images/miratext.png' ? 'public-nav-visual--mira' : '' %>">
                      <img src="<%= publicImageUrl(menu.heroImage, { public: true }) %>" alt="<%= menu.heroImageAlt || menu.title %>" loading="lazy" decoding="async" onerror="this.onerror=null;this.src='/images/image.png';" />
                    </div>
                    <div class="public-nav-capabilities">
                      <span class="public-nav-capabilities-title"><%= menu.capabilitiesTitle || 'Capabilities' %></span>
                      <% (menu.capabilities || []).forEach((item) => { %>
                        <span class="public-nav-capability-item"><%= item %></span>
                      <% }); %>
                    </div>
                  <% } else { %>
                    <div class="public-nav-columns <%= menu.sections && menu.sections.some((section) => section.image) ? 'public-nav-columns--with-images' : '' %>" style="--public-nav-columns:<%= menu.columns || Math.max(menu.sections.length, 1) %>">
                      <% menu.sections.forEach((section) => { %>
                        <div class="public-nav-section">
                          <% if (section.image) { %>
                            <div class="public-nav-section-visual" style="--section-accent:<%= section.imageBorderColor || '#cbd5e1' %>;"><img src="<%= publicImageUrl(section.image, { public: true }) %>" alt="<%= section.imageAlt || section.title %>" loading="lazy" decoding="async" /></div>
                          <% } %>
                          <span class="public-nav-section-title"><%= section.title %></span>
                          <% section.links.forEach((link) => { %>
                            <a class="public-nav-link" href="<%= link.href %>">
                              <strong><%= link.label %></strong>
                              <span><%= link.description %></span>
                            </a>
                          <% }); %>
                        </div>
                      <% }); %>
                    </div>
                  <% } %>
                </div>
              </div>
            </li>
          <% }); %>
        </ul>
      </nav>
    <% } %>
