      <a id="loginbutton" title="Click to log in" href="/account/login">Login / Sign Up</a>
      <div class="hamburger-container">
        <div class="hamburger header-hamburger" id="header-hamburger" aria-label="Open menu" role="button" tabindex="0">
          <span class="bar"></span>
          <span class="bar"></span>
          <span class="bar"></span>
        </div>
