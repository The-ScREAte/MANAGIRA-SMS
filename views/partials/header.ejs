  min-width: 16px;
  height: 16px;
  border-radius: 99px;
  padding: 0 3px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  pointer-events: none;
  border: 1.5px solid #ededed;
  transition: opacity 0.2s ease, transform 0.2s ease;
}
.notif-badge--hidden { opacity: 0; transform: scale(0); }

/* Panel */
.notif-panel {
  display: none;
  position: absolute;
  top: calc(100% + 8px);
  right: 0;
