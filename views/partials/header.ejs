</style>

<header id="top-header">
  <%
    const normalizeLogoSrc = (logo) => {
      if (!logo) return "";
      if (/^https?:\/\//i.test(logo)) return logo;
      if (logo.startsWith("/")) return logo;
      return `/${logo}`;
    };
  %>
  <% const isPublicDashboard = url && url.includes('/publicDashboard'); %>
  <% const isLoggedIn = !!(session && session.firstName); %>
  <% const showPublicOrgIdentity = !!(isPublicDashboard && !isLoggedIn); %>
  <% const headerHomeHref = (typeof BASE_URL !== 'undefined' && BASE_URL) ? BASE_URL : '/'; %>
  <% const publicOrgFullName = (typeof orgDetails !== 'undefined' && orgDetails && orgDetails.organization_name) ? orgDetails.organization_name : ''; %>
  <% const publicOrgNickname = (typeof orgDetails !== 'undefined' && orgDetails && (orgDetails.nickname || orgDetails.org_nickname || orgDetails.organization_nickname)) ? (orgDetails.nickname || orgDetails.org_nickname || orgDetails.organization_nickname) : ''; %>
  <% const publicOrgNicknameDisplay = (typeof orgDetails !== 'undefined' && orgDetails && orgDetails.nickname_display && String(orgDetails.nickname_display).trim()) ? orgDetails.nickname_display : publicOrgNickname; %>
  <% const dashboardHref = req.session && req.session.accountType === 'Hub' ? '/hub/dashboard' : (req.session && req.session.userRole === 'Guardian' ? '/guardian/dashboard' : '/common/orgDashboard'); %>
  <div class="header-mobile-row">
    <div class="header-mobile-left">
      <span class="siteName">
        <% if (isLoggedIn && typeof orgHeaderLogo !== 'undefined' && orgHeaderLogo) { %>
          <a href="<%= dashboardHref %>" title="Go to dashboard">
            <img src="<%= normalizeLogoSrc(orgHeaderLogo) %>" alt="Organization Logo" class="logo" />
          </a>
        <% } else if (showPublicOrgIdentity && typeof orgDetails !== 'undefined' && orgDetails && orgDetails.logo) { %>
          <!-- Show org logo on public dashboard even when logged out; clicking goes home -->
          <a href="<%= headerHomeHref %>" title="Return to home page">
            <img src="<%= normalizeLogoSrc(orgDetails.logo) %>" alt="<%= publicOrgFullName || 'Organization' %> Logo" class="logo" />
          </a>
        <% } else if (!isLoggedIn) { %>
          <!-- Only show Managira logo when not logged in -->
          <a
            href="<%= headerHomeHref %>"
            title="Return to home page"
          >
            <img src="/images/managira.png" alt="Managira Logo" class="logo" />
          </a>
        <% } else if (session.logo) { %>
          <!-- Show Organization logo when logged in -->
          <a href="<%= dashboardHref %>" title="Go to dashboard">
            <img src="<%= normalizeLogoSrc(session.logo) %>" alt="<%= session.accountType === 'Hub' ? 'Hub' : 'Organization' %> Logo" class="logo" />
          </a>
        <% } else if (session.accountType === 'Hub') { %>
          <!-- Hub without logo - show nothing or hub name only -->
        <% } %>
        <!-- Move org name/nickname outside <a> for better flex and visibility -->
        <% if (isLoggedIn || showPublicOrgIdentity) { %>
          <div class="org-names">
            <a href="<%= showPublicOrgIdentity ? headerHomeHref : dashboardHref %>" title="<%= showPublicOrgIdentity ? 'Return to home page' : 'Go to dashboard' %>">
              <h3 class="org-full-name">
                <% if (typeof orgHeaderName !== 'undefined' && orgHeaderName) { %>
                  <%= orgHeaderName %>
                <% } else if (showPublicOrgIdentity && publicOrgFullName) { %>
                  <%= publicOrgFullName %>
                <% } else if (session.organizationName) { %>
                  <%= session.organizationName %>
                <% } %>
              </h3>
              <h3 class="org-nickname">
                <% if (typeof orgHeaderNicknameDisplay !== 'undefined' && orgHeaderNicknameDisplay) { %>
                  <%= orgHeaderNicknameDisplay %>
                <% } else if (typeof orgHeaderNickname !== 'undefined' && orgHeaderNickname) { %>
                  <%= orgHeaderNickname %>
                <% } else if (showPublicOrgIdentity) { %>
                  <%= publicOrgNicknameDisplay || publicOrgNickname || publicOrgFullName %>
                <% } else if (session.orgNickNameDisplay) { %>
                  <%= session.orgNickNameDisplay %>
                <% } else if (session.orgNickName) { %>
                  <%= session.orgNickName %>
                <% } %>
              </h3>
            </a>
          </div>
        <% } %>
      </span>
    </div>
    <div id="tools">
      <% if (session.firstName) { %>
      <% if ((req.session.userRole && req.session.userRole !== 'Guardian') || req.session.accountType === 'Hub') { %>
