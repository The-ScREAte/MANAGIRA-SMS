<%
  const headerThemeColor = (typeof session !== 'undefined' && session && session.themeColor)
    ? session.themeColor
    : ((typeof orgDetails !== 'undefined' && orgDetails && orgDetails.theme_color)
      ? orgDetails.theme_color
      : 'teal');
  const headerThemeColors = {
    teal: { primary: '#01535b', hover: '#014a51' },
    blue: { primary: '#2563eb', hover: '#1d4ed8' },
    green: { primary: '#2e7d32', hover: '#1b5e20' },
    purple: { primary: '#7c3aed', hover: '#6d28d9' },
    indigo: { primary: '#4f46e5', hover: '#4338ca' },
    rose: { primary: '#8b2635', hover: '#7a212e' },
    amber: { primary: '#d97706', hover: '#b45309' },
    yellow: { primary: '#eab308', hover: '#ca8a04' },
    slate: { primary: '#334155', hover: '#1e293b' },
    cyan: { primary: '#0891b2', hover: '#0e7490' },
    orange: { primary: '#ea580c', hover: '#c2410c' },
    charcoal: { primary: '#1f2937', hover: '#111827' },
    classic: { primary: '#01535b', hover: '#014a51' },
    bold: { primary: '#0b1020', hover: '#ffb703' },
    modern: { primary: '#2563eb', hover: '#1d4ed8' },
    minimal: { primary: '#7c3aed', hover: '#6d28d9' },
    gold: { primary: '#d4a017', hover: '#b8860b' },
    red: { primary: '#e11d48', hover: '#be123c' },
    brown: { primary: '#7c4a03', hover: '#5c3802' }
  };
  const headerCurrentTheme = headerThemeColors[headerThemeColor] || headerThemeColors.teal;
%>
<style>
  :root {
    --header-height: 64px;
    --header-pad-y: 6px;
    --header-pad-x: 16px;
    --logo-size: 58px;
    --text-color: #333;
    --org-primary-color: <%= headerCurrentTheme.primary %>;
    --org-primary-hover: <%= headerCurrentTheme.hover %>;
        --org-primary-hover-fill: color-mix(in srgb, var(--org-primary-color) 88%, white);
  }

  html {
    scroll-behavior: smooth;
  }

  body {
    padding-top: calc(var(--header-height) + 16px) !important;
  }

  body.homepage-overlay-header {
    padding-top: 0 !important;
  }

  body[data-page="publicDashboard"] {
    padding-top: calc(var(--header-height) + 20px) !important;
  }

  body.homepage-overlay-header .hero {
    padding-top: calc(var(--header-height) + 42px);
    margin-top: 0;
  }

  header#top-header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    height: auto;
    min-height: var(--header-height);
    box-sizing: border-box;
    background: #ededed;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
    width: 100%;
    padding: var(--header-pad-y) var(--header-pad-x);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    z-index: 9999;
    transition: background-color 260ms ease, box-shadow 260ms ease, border-color 260ms ease, backdrop-filter 260ms ease;
  }

  body.homepage-overlay-header header#top-header.homepage-overlay-enabled:not(.is-solid) {
    background: transparent !important;
    box-shadow: none;
    backdrop-filter: none !important;
    -webkit-backdrop-filter: none !important;
    border-bottom: 1px solid transparent;
  }

  body.homepage-overlay-header header#top-header.homepage-overlay-enabled:not(.is-solid) .public-nav-trigger,
  body.homepage-overlay-header header#top-header.homepage-overlay-enabled:not(.is-solid) #loginbutton,
  body.homepage-overlay-header header#top-header.homepage-overlay-enabled:not(.is-solid) .public-expert-button,
  body.homepage-overlay-header header#top-header.homepage-overlay-enabled:not(.is-solid) .siteName a,
  body.homepage-overlay-header header#top-header.homepage-overlay-enabled:not(.is-solid) .siteName,
  body.homepage-overlay-header header#top-header.homepage-overlay-enabled:not(.is-solid) .org-names a,
  body.homepage-overlay-header header#top-header.homepage-overlay-enabled:not(.is-solid) .org-full-name,
  body.homepage-overlay-header header#top-header.homepage-overlay-enabled:not(.is-solid) .org-nickname,
  body.homepage-overlay-header header#top-header.homepage-overlay-enabled:not(.is-solid) .hamburger {
    color: #f8fafc !important;
  }

  body.homepage-overlay-header header#top-header.homepage-overlay-enabled:not(.is-solid) #loginbutton,
  body.homepage-overlay-header header#top-header.homepage-overlay-enabled:not(.is-solid) .public-expert-button {
    border-color: rgba(255, 255, 255, 0.78);
    background: rgba(255, 255, 255, 0.06);
    box-shadow: none;
  }

  body.homepage-overlay-header header#top-header.homepage-overlay-enabled:not(.is-solid) .public-nav-trigger:hover,
  body.homepage-overlay-header header#top-header.homepage-overlay-enabled:not(.is-solid) .public-nav-trigger:focus-visible {
    background: rgba(255, 255, 255, 0.14);
    color: #ffffff;
  }

  body.homepage-overlay-header header#top-header.homepage-overlay-enabled:not(.is-solid) .public-expert-button:hover,
  body.homepage-overlay-header header#top-header.homepage-overlay-enabled:not(.is-solid) .public-expert-button:focus-visible,
  body.homepage-overlay-header header#top-header.homepage-overlay-enabled:not(.is-solid) #loginbutton:hover {
    background: rgba(255, 255, 255, 0.14);
    color: #ffffff !important;
    border-color: rgba(255, 255, 255, 0.92);
  }

  body.homepage-overlay-header header#top-header.homepage-overlay-enabled:not(.is-solid) .siteName .logo {
    filter: drop-shadow(0 10px 18px rgba(0, 0, 0, 0.28));
  }

  body.homepage-overlay-header header#top-header.homepage-overlay-enabled.is-solid {
    background: rgba(248, 250, 252, 0.68) !important;
    box-shadow: 0 8px 22px rgba(15, 23, 42, 0.06);
    backdrop-filter: saturate(1.04) blur(9px);
    -webkit-backdrop-filter: saturate(1.04) blur(9px);
  }

  .header-mobile-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    gap: 12px;
    min-height: var(--header-height);
    flex-wrap: nowrap;
  }

  .header-mobile-left {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .siteName {
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 0;
    font-size: 1.1rem;
    font-weight: 600;
    color: var(--text-color);
    min-width: 120px;
    flex-shrink: 0;
  }

  .siteName .logo {
    height: var(--logo-size);
    width: auto;
    max-height: var(--logo-size);
    max-width: 140px;
    object-fit: contain;
  }

  .org-names {
    margin: 0;
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .org-names a {
    color: var(--org-primary-color, #01535b);
    text-decoration: none;
  }

  .org-names h3 {
    margin: 0;
    line-height: 1.2;
  }

  .org-names .org-full-name {
    font-size: 1.05rem;
    font-weight: 600;
    max-width: 360px;
    color: var(--org-primary-color, #01535b);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .org-names .org-nickname {
    display: none;
    font-size: 1.05rem;
    font-weight: 600;
    color: var(--org-primary-color, #01535b);
    white-space: nowrap;
  }

  #tools {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-left: auto;
    position: relative;
    flex: 0 0 auto;
    width: auto;
    justify-content: flex-end;
    height: 100%;
    flex-shrink: 0;
    flex-wrap: nowrap;
  }

  #tools li a {
    text-decoration: none;
    color: var(--org-primary-color, #01535b);
    padding-left: 15px;
  }

  #tools a.header-welcome {
    display: block;
    font-size: 0.95rem;
    text-decoration: none;
    color: var(--org-primary-color, #01535b);
  }

  #tools #loginbutton {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 5px 8px;
    min-height: 32px;
    border: 1px solid #111827;
    border-radius: 6px;
    text-decoration: none;
    color: #111827 !important;
    background: #ffffff;
    font-size: 0.95rem;
    font-weight: 500;
    line-height: 1.1;
    transition: background-color 0.2s ease, color 0.2s ease, border-color 0.2s ease;
  }

  #tools #loginbutton:hover {
    background: #f3f4f6;
    color: #111827 !important;
    border-color: #111827;
    box-shadow: none;
  }

  .public-header-main {
    display: none;
    align-items: stretch;
    justify-content: center;
    flex: 1 1 auto;
    min-width: 0;
    position: static;
  }

  .public-nav-list {
    list-style: none;
    display: flex;
    align-items: center;
    gap: 8px;
    margin: 0;
    padding: 0;
    position: static;
  }

  .public-nav-item {
    position: static;
  }

  .public-nav-trigger {
    appearance: none;
    border: 0;
    background: transparent;
    color: #0f172a;
    font-size: 0.96rem;
    font-weight: 700;
    line-height: 1;
    padding: 12px 16px;
    border-radius: 999px;
    cursor: pointer;
    transition: background-color 0.2s ease, color 0.2s ease;
  }

  .public-nav-item.is-open .public-nav-trigger,
  .public-nav-trigger:hover,
  .public-nav-trigger:focus-visible {
    background: #67d8ea;
    color: #083b75;
    outline: none;
  }

  .public-nav-panel {
    position: absolute;
    top: calc(100% - 10px);
    left: 50%;
    transform: translateX(-50%);
    width: min(1100px, calc(100vw - 16px));
    max-width: calc(100vw - 24px);
    background: rgba(255, 255, 255, 0.98);
    border: 1px solid rgba(15, 23, 42, 0.08);
    border-radius: 22px;
    box-shadow: 0 24px 60px rgba(15, 23, 42, 0.18);
    padding: 0;
    display: none;
    overflow-x: hidden;
    overflow-y: auto;
    max-height: calc(100vh - var(--header-height) - 20px);
    z-index: 11030;
  }

  .public-nav-panel.public-nav-panel--with-section-images {
    width: min(1320px, calc(100vw - 16px));
    max-width: calc(100vw - 24px);
  }

  .public-nav-item.is-open .public-nav-panel {
    display: block;
  }

  .public-nav-panel-inner {
    display: grid;
    grid-template-columns: minmax(240px, 0.9fr) minmax(0, 1.7fr);
    min-height: 300px;
  }

  .public-nav-overview {
    background: #f5f7fb;
    padding: 24px 24px 26px;
    border-right: 1px solid rgba(15, 23, 42, 0.08);
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .public-nav-eyebrow {
    font-size: 0.74rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #2563eb;
  }

  .public-nav-overview h3 {
    margin: 0;
    font-size: 1.78rem;
    line-height: 1.05;
    color: #0f172a;
  }

  .public-nav-overview p {
    margin: 0;
    font-size: 0.94rem;
    line-height: 1.65;
    color: #334155;
  }

  .public-nav-overview a {
    margin-top: auto;
    font-size: 1rem;
    font-weight: 700;
    color: #2563eb;
    text-decoration: none;
  }

  .public-nav-panel-inner.public-nav-spotlight {
    grid-template-columns: minmax(240px, 0.92fr) minmax(360px, 1.5fr) minmax(220px, 0.85fr);
    min-height: 340px;
  }

  .public-nav-panel-inner.public-nav-spotlight .public-nav-overview {
    background: #eef2f7;
    border-right: 1px solid rgba(15, 23, 42, 0.08);
  }

  .public-nav-visual {
    padding: 20px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-right: 1px solid rgba(15, 23, 42, 0.08);
    background: #ffffff;
    overflow: hidden;
  }

  .public-nav-visual img {
    display: block;
    width: 100%;
    max-width: none;
    height: 286px;
    max-height: none;
    object-fit: cover;
    object-position: center;
  }

  .public-nav-visual--mira img {
    width: 100%;
    max-width: 420px;
    height: auto;
    object-fit: contain;
  }

  .public-nav-capabilities {
    padding: 26px 26px 24px;
    display: flex;
    flex-direction: column;
    gap: 14px;
    background: #ffffff;
  }

  .public-nav-capabilities-title {
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #475569;
    margin: 0 0 6px;
  }

  .public-nav-capability-item {
    font-size: 1.02rem;
    line-height: 1.22;
    font-weight: 800;
    color: #1f2937;
  }

  .public-nav-columns {
    display: grid;
    grid-template-columns: repeat(var(--public-nav-columns, 3), minmax(0, 1fr));
    gap: 20px;
    padding: 24px 26px;
    align-content: start;
  }

  .public-nav-columns.public-nav-columns--with-images {
    gap: 16px;
    padding: 22px 20px;
  }

  .public-nav-section {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .public-nav-section-visual {
    border-radius: 0;
    overflow: hidden;
    border: 0;
    background: transparent;
    box-shadow: none;
    margin-bottom: 6px;
  }

  .public-nav-section-visual img {
    display: block;
    width: 100%;
    height: auto;
    object-fit: contain;
    object-position: center;
    background: #ffffff;
  }

  .public-nav-section-title {
    font-size: 0.76rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #475569;
  }

  .public-nav-link {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: 0;
    color: #0f172a;
    text-decoration: none;
  }

  .public-nav-link strong {
    font-size: 0.95rem;
    line-height: 1.35;
  }

  .public-nav-link span {
    font-size: 0.79rem;
    line-height: 1.5;
    color: #64748b;
  }

  .public-nav-link:hover strong,
  .public-nav-link:focus-visible strong {
    color: #2563eb;
    outline: none;
  }

  .public-header-actions {
    display: inline-flex;
    align-items: center;
    gap: 10px;
  }

  .public-expert-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 40px;
    padding: 0 18px;
    border-radius: 12px;
    border: 1.5px solid #2563eb;
    background: #ffffff;
    color: #2563eb;
    font-size: 0.95rem;
    font-weight: 800;
    text-decoration: none;
    transition: background-color 0.2s ease, color 0.2s ease, border-color 0.2s ease;
  }

  .public-expert-button:hover,
  .public-expert-button:focus-visible {
    background: #eff6ff;
    color: #1d4ed8;
    border-color: #1d4ed8;
    outline: none;
  }

  .public-header-nav-menu {
    width: min(680px, calc(100vw - 4px));
    right: -1px;
    left: auto;
    padding: 8px;
    max-height: calc(100vh - var(--header-height) - 18px);
    overflow-y: auto;
    overflow-x: hidden;
    -webkit-overflow-scrolling: touch;
  }

  .public-mobile-group {
    border-bottom: 1px solid rgba(15, 23, 42, 0.08);
    padding-bottom: 4px;
    margin-bottom: 4px;
  }

  .public-mobile-group:last-of-type {
    border-bottom: 0;
    margin-bottom: 0;
    padding-bottom: 0;
  }

  .public-mobile-toggle {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    border: 0;
    background: transparent;
    color: #0f172a;
    font-size: 0.9rem;
    font-weight: 800;
    padding: 10px 10px 8px;
    cursor: pointer;
    text-align: left;
  }

  .public-mobile-toggle .arrow {
    transition: transform 0.2s ease;
    color: #475569;
  }

  .public-mobile-toggle .arrow.open {
    transform: rotate(180deg);
  }

  .public-mobile-submenu {
    display: none;
    padding: 0 10px 8px;
  }

  .public-mobile-submenu.show {
    display: block;
  }

  .public-mobile-overview {
    padding: 2px 0 8px;
  }

  .public-mobile-overview strong {
    display: block;
    font-size: 0.95rem;
    color: #0f172a;
    margin-bottom: 4px;
  }

  .public-mobile-overview p {
    display: none;
    font-size: 0.8rem;
    line-height: 1.5;
    color: #64748b;
    margin: 0 0 8px;
  }

  .public-mobile-overview a {
    display: inline-flex;
    color: #2563eb;
    font-size: 0.82rem;
    font-weight: 700;
    text-decoration: none;
  }


  .public-mobile-section-title {
    display: block;
    font-size: 0.74rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #64748b;
    margin: 18px 0 6px;
    padding-top: 12px;
    border-top: 1px solid rgba(15, 23, 42, 0.08);
  }

  .public-mobile-submenu > .public-mobile-section-title:first-of-type {
    margin-top: 0;
    padding-top: 0;
    border-top: 0;
  }

  .public-mobile-submenu a.public-mobile-link {
    display: block;
    padding: 5px 0;
    text-decoration: none;
    color: #0f172a;
    font-size: 0.9rem;
    font-weight: 600;
    line-height: 1.35;
  }

  .public-mobile-submenu a.public-mobile-link span {
    display: none;
    color: #64748b;
    font-size: 0.74rem;
    font-weight: 500;
    margin-top: 2px;
  }



  .public-mobile-section-visual {
    display: none;
    margin: 4px 0 8px;
  }

  .public-mobile-group--products .public-mobile-section-visual {
    display: block;
  }


  .public-mobile-section-visual img {
    display: block;
    width: 100%;
    height: auto;
    object-fit: contain;
    object-position: center;
  }

  .public-mobile-action {
    margin-top: 4px;
  }

  .public-mobile-visual {
    margin: 2px 0 12px;
    border: 1px solid rgba(15, 23, 42, 0.08);
    border-radius: 10px;
    overflow: hidden;
    background: #ffffff;
  }

  .public-mobile-visual img {
    display: block;
    width: 100%;
    height: 190px;
    object-fit: cover;
    object-position: center;
    background: #ffffff;
  }

  .public-mobile-visual--mira img {
    width: 55%;
    max-width: 160px;
    height: auto;
    margin: 8px auto;
    object-fit: contain;
  }

  .public-mobile-capabilities {
    margin: 4px 0 10px;
    padding: 4px 0 0;
  }

  .public-mobile-capabilities .public-mobile-section-title {
    margin-top: 0;
    padding-top: 0;
    border-top: 0;
  }


  .public-mobile-capability-item {
    display: block;
    color: #1f2937;
    font-size: 0.9rem;
    line-height: 1.25;
    font-weight: 800;
    margin: 0 0 8px;
  }

  .public-mobile-action a {
    width: 100%;
    justify-content: center;
  }

  .hamburger-container {
    display: inline-block;
  }

  .search-bar-container {
    position: relative;
    z-index: 11020;
    flex: 0 0 auto;
    width: 220px;
    max-width: 260px;
    margin-left: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    align-self: stretch;
    height: 100%;
  }

  .mobile-welcome {
    display: none;
    padding: 8px 10px 6px;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.01em;
    color: color-mix(in srgb, var(--org-primary-color) 82%, #334155);
  }

  .mobile-welcome .welcome-label {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    line-height: 1.25;
  }

  .search-bar {
    position: relative;
    width: 100%;
    margin: 0;
    display: flex;
    align-items: center;
    justify-content: flex-start;
    height: 100%;
  }

  .search-input-shell {
    position: relative;
    width: 100%;
    display: flex;
    align-items: center;
  }

  .search-autofill-trap {
    position: absolute;
    left: -10000px;
    top: auto;
    width: 1px;
    height: 1px;
    opacity: 0;
    pointer-events: none;
  }

  .search-toggle-btn,
  .search-close-btn {
    border: 0;
    background: transparent;
    color: #667085;
    padding: 0;
    margin: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
  }

  .search-toggle-btn {
    position: absolute;
    left: 10px;
    top: 50%;
    transform: translateY(-50%);
    width: 18px;
    height: 18px;
    z-index: 1;
  }

  .search-toggle-btn .search-icon {
    font-size: 16px;
    line-height: 1;
    pointer-events: none;
  }

  .search-toggle-btn .search-icon-svg {
    width: 16px;
    height: 16px;
    display: block;
    stroke: currentColor;
    fill: none;
    stroke-width: 2;
    pointer-events: none;
  }

  .search-close-btn {
    position: absolute;
    right: 10px;
    top: 50%;
    transform: translateY(-50%);
    width: 18px;
    height: 18px;
    font-size: 18px;
    line-height: 1;
    opacity: 0;
    pointer-events: none;
  }

  #search-input {
    width: 100%;
    padding: 6px 10px 6px 38px;
    height: 34px;
    line-height: 1.2;
    border: 1px solid #ccc;
    border-radius: 6px;
    outline: none;
    font-size: 0.82rem;
    transition: border-color 0.2s ease;
    display: block;
    box-sizing: border-box;
    margin: 0 auto;
  }

  #search-input:focus {
    border-color: #026972;
  }

  .search-result-item {
    padding: 12px 16px;
    cursor: pointer;
    font-size: 1rem;
    display: flex;
    align-items: center;
