      right: 10px !important;
      left: 10px !important;
      transform: none !important;
      align-items: stretch;
      width: auto;
      max-width: none;
    }

    .flash-message {
      margin: 0 0 8px 0;
      max-width: calc(100vw - 20px);
      width: calc(100% - 20px);
      font-size: 13px;
      padding: 10px 14px;
    }

    .flash-close {
      font-size: 16px;
      padding: 2px 6px;
    }
  }

  @media (max-width: 480px) {
    :root {
      --logo-size: 40px;
