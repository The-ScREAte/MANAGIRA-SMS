<%#
  Who leads a class, on the Add and Edit staff forms, beside the class: two aligned cells,
  "Main teacher" and (when the school uses assistants) "Assistant teacher".
    Nobody yet: "None" with a box. Ticking it puts this person there: the box turns into their
    name, in green, so it reads differently from the people already there (plain). Ticking it
    on a class that isn't ticked ticks the class too.
    Main teacher: someone else's name can't be replaced from here: take them off on their own
    page first.
    Assistant teacher: the assistants' names, and a box to add this person.
  Expects: cls, classMainTeachers ({ classId: { userId, name } }), classAssistants
  ({ classId: [{ userId, name }] }, optional; null: no assistants) and personId (the member of
  staff being edited, or null on the Add form). The green name is filled in by
  partials/employeeClassesSummary from the name fields.
%>
<%
  const _lead = (typeof classMainTeachers !== 'undefined' && classMainTeachers && classMainTeachers[cls.class_id]) || null;
  const _mine = !!(_lead && personId && Number(_lead.userId) === Number(personId));
  const _taken = !!(_lead && !_mine);
  const _assistantsOn = typeof classAssistants !== 'undefined' && classAssistants !== null;
  const _assistants = (_assistantsOn && classAssistants[cls.class_id]) || [];
  const _assisting = !!(personId && _assistants.some((a) => Number(a.userId) === Number(personId)));
  const _others = _assistants.filter((a) => !personId || Number(a.userId) !== Number(personId)).map((a) => a.name);
%>
<span class="emp-main" data-emp-main="<%= cls.class_id %>">
  <span class="emp-cell" data-label="Main teacher">
    <% if (_taken) { %>
      <input type="checkbox" name="mainClasses" value="<%= cls.class_id %>" data-locked disabled hidden>
      <span class="emp-who" title="<%= _lead.name %>"><%= _lead.name %></span>
    <% } else { %>
      <label class="emp-pick">
        <input type="checkbox" name="mainClasses" value="<%= cls.class_id %>" aria-label="Main teacher"<%= _mine ? ' checked' : '' %>>
        <span class="emp-none">None</span><span class="emp-me"></span>
      </label>
    <% } %>
  </span>
  <% if (_assistantsOn) { %>
  <span class="emp-cell" data-label="Assistant teacher">
    <label class="emp-pick">
      <input type="checkbox" name="assistantClasses" value="<%= cls.class_id %>" aria-label="Assistant teacher"<%= _assisting ? ' checked' : '' %>>
      <% if (!_others.length) { %><span class="emp-none">None</span><% } %><span class="emp-me"></span>
    </label>
    <% if (_others.length) { %><span class="emp-who" title="<%= _others.join(', ') %>"><%= _others.join(', ') %></span><% } %>
  </span>
  <% } %>
</span>
