<head>
  <meta charset="UTF-8" />
  <meta http-equiv="X-UA-Compatible" content="IE=edge" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%- title %><% if (!title.includes('Managira')) { %> | Managira<% } %></title>
  
  <!-- SEO Meta Tags -->
  <% if (typeof description !== 'undefined' && description) { %>
    <meta name="description" content="<%- description %>">
  <% } %>
  <% if (typeof keywords !== 'undefined' && keywords) { %>
    <meta name="keywords" content="<%- keywords %>">
  <% } %>
  <meta name="robots" content="index, follow">
  <meta name="author" content="Managira">
  
  <!-- Open Graph Meta Tags -->
  <meta property="og:type" content="website">
  <meta property="og:title" content="<%- title %>">
  <% if (typeof description !== 'undefined' && description) { %>
    <meta property="og:description" content="<%- description %>">
  <% } %>
  <% if (typeof canonicalUrl !== 'undefined' && canonicalUrl) { %>
    <meta property="og:url" content="<%- canonicalUrl %>">
    <link rel="canonical" href="<%- canonicalUrl %>">
  <% } %>
  <meta property="og:image" content="https://www.managira.com/images/managira.png">
  <meta property="og:site_name" content="Managira">
  
  <!-- Twitter Meta Tags -->
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="<%- title %>">
  <% if (typeof description !== 'undefined' && description) { %>
    <meta name="twitter:description" content="<%- description %>">
  <% } %>
  <meta name="twitter:image" content="https://www.managira.com/images/managira.png">

  <!-- Favicon Links -->
  <link rel="icon" href="/images/favicon_io/favicon.ico" type="image/x-icon" />
  <link
    rel="icon"
    type="image/png"
    sizes="32x32"
    href="/images/favicon_io/favicon-32x32.png"
  />
  <link
    rel="icon"
    type="image/png"
    sizes="16x16"
    href="/images/favicon_io/favicon-16x16.png"
  />
  <link rel="shortcut icon" href="/images/favicon_io/favicon.ico" />
  <link
    rel="stylesheet"
    href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css"
  />

  <!-- Tailwind (for utility-first page styling) -->
  <script src="https://cdn.tailwindcss.com"></script>

  <!-- Stylesheets -->
  <link rel="stylesheet" href="/css/style.css" />
  <link rel="stylesheet" href="/css/buttons.css" />
  <link rel="stylesheet" href="/css/index.css" />
  <link rel="stylesheet" href="/css/orgDashboard.css" />
  <link rel="stylesheet" href="/css/classDashboard.css" />
  <link rel="stylesheet" href="/css/attendanceCollection.css" />
  <link rel="stylesheet" href="/css/addStudent.css" />
  <link rel="stylesheet" href="/css/assessment.css" />
  <link rel="stylesheet" href="/css/deleteStudent.css" />
  <link rel="stylesheet" href="/css/editStudent.css" />
  <link rel="stylesheet" href="/css/manageClassSubjectAndGradYr.css" />
  <link rel="stylesheet" href="/css/manageRecords.css" />
  <link rel="stylesheet" href="/css/registerSchoolYear.css" />
  <link rel="stylesheet" href="/css/studentDetails.css" />
  <link rel="stylesheet" href="/css/manageStudents.css" />
  <link rel="stylesheet" href="/css/chatbot.css" />
  <link rel="stylesheet" href="/css/guardian.css" />

  <!-- Loading indicator styles (fallback for non-SPA pages) -->
  <style>
    .page-loading-overlay {
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background: rgba(255, 255, 255, 0.7);
      display: none;
      justify-content: center;
      align-items: center;
      z-index: 9998;
      backdrop-filter: blur(2px);
    }

    .page-loading-overlay.active {
      display: flex;
    }

    .spinner {
      width: 40px;
      height: 40px;
      border: 4px solid #e2e8f0;
      border-top-color: #01535b;
      border-radius: 50%;
      animation: spin 0.8s linear infinite;
    }

    @keyframes spin {
      to { transform: rotate(360deg); }
    }
  </style>

  <!-- Include Quill CSS and JavaScript (rich text editor) -->
  <link href="https://cdn.quilljs.com/1.3.7/quill.snow.css" rel="stylesheet" />
  <script src="https://cdn.quilljs.com/1.3.7/quill.min.js"></script>

  <!-- Preconnect to Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<%
  const rawFontStyle = (session && session.fontStyle ? String(session.fontStyle).trim() : '') || 'Inter';
  const selectedFont = rawFontStyle;
  const serifFonts = ['PT Serif', 'Merriweather', 'Playfair Display'];
  const googleFonts = ['Inter', 'Roboto', 'Open Sans', 'Lato', 'Montserrat', 'Poppins', 'Nunito', 'Raleway', 'Work Sans', 'Source Sans Pro', 'Ubuntu', 'Noto Sans', 'PT Serif', 'Merriweather', 'Playfair Display'];
  const fallbackFamily = serifFonts.includes(selectedFont) ? 'serif' : 'sans-serif';
  const normalizedFont = selectedFont.replace(/\s+/g, '+');
  const shouldLoadGoogleFont = googleFonts.includes(selectedFont);
%>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
  <% if (shouldLoadGoogleFont && selectedFont !== 'Inter') { %>
  <link href="https://fonts.googleapis.com/css2?family=<%= normalizedFont %>:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
  <% } %>
  <%
    // Theme color mapping for organization buttons
    const themeColor = (typeof session !== 'undefined' && session && session.themeColor) ? session.themeColor : 'teal';
    const themeColors = {
      teal: { primary: '#01535b', hover: '#014a51' },
      blue: { primary: '#2563eb', hover: '#1d4ed8' },
      green: { primary: '#2d5f4f', hover: '#245043' },
      purple: { primary: '#7c3aed', hover: '#6d28d9' },
      indigo: { primary: '#4f46e5', hover: '#4338ca' },
      rose: { primary: '#8b2635', hover: '#7a212e' },
      amber: { primary: '#d97706', hover: '#b45309' },
      slate: { primary: '#334155', hover: '#1e293b' }
    };
    const currentTheme = themeColors[themeColor] || themeColors.teal;
  %>
  <style>
    :root {
      --font-family: "<%= selectedFont %>", <%= fallbackFamily %>;
      /* Organization Theme Colors */
      --org-primary-color: <%= currentTheme.primary %>;
      --org-primary-hover: <%= currentTheme.hover %>;
    }
  </style>

  <!-- JavaScript Files -->
  <script>
    // Turbo navigation event handlers
    document.addEventListener('turbo:before-fetch-request', (event) => {
      // Show loading indicator when navigation starts
      const overlay = document.querySelector('.page-loading-overlay');
      if (overlay) overlay.classList.add('active');
    });

    document.addEventListener('turbo:before-render', (event) => {
      // Hide loading indicator before new content renders
      const overlay = document.querySelector('.page-loading-overlay');
      if (overlay) overlay.classList.remove('active');
    });

    document.addEventListener('turbo:load', () => {
      // Re-initialize any JavaScript that needs to run on each page load
      // This ensures scripts work after Turbo navigation
      if (typeof initializePage === 'function') {
        initializePage();
      }
    });

    document.addEventListener('turbo:frame-missing', (event) => {
      // Handle missing frames gracefully
      event.preventDefault();
      event.detail.visit(event.detail.response.url);
    });
  </script>
  
  <!-- SPA Router User Type Detection -->
  <script>
    // Detect user type for SPA router optimization
    window.spaUserType = <%- 
      session && session.firstName ? (
        session.accountType === 'Admin' || session.accountType === 'Mini Admin' ? '"admin"' :
        session.accountType === 'Hub' ? '"hub"' :
        session.userRole === 'Guardian' ? '"guardian"' :
        '"organization"'
      ) : '"public"'
    %>;
  </script>
  
  <script src="/js/turbo-init.js"></script>
  <script src="/js/spa-router.js" defer></script>
  <script src="/js/spa-user-info.js" defer></script>
  <script src="/js/script.js" defer></script>
  <script src="/js/index.js" defer></script>
  <script src="/js/classDashboard.js" defer></script>
  <script src="/js/manageRecords.js" defer></script>
  <script src="/js/createEmployee.js" defer></script>
  <script src="/js/management.js" defer></script>
  <script src="/js/chatbot.js" defer></script>
</head>
