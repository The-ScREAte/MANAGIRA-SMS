<head>
  <meta charset="UTF-8" />
  <meta http-equiv="X-UA-Compatible" content="IE=edge" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%- title %><% if (!title.includes('Managira')) { %> | Managira<% } %></title>
  
  <!-- SEO Meta Tags -->
  <% if (typeof description !== 'undefined' && description) { %>
    <meta name="description" content="<%- description %>">
  <% } %>
  <% if (typeof keywords !== 'undefined' && keywords) { %>
    <meta name="keywords" content="<%- keywords %>">
  <% } %>
  <meta name="robots" content="index, follow">
  <meta name="author" content="Managira">
  
  <!-- Open Graph Meta Tags -->
  <meta property="og:type" content="website">
  <meta property="og:title" content="<%- title %>">
  <% if (typeof description !== 'undefined' && description) { %>
    <meta property="og:description" content="<%- description %>">
  <% } %>
  <% if (typeof canonicalUrl !== 'undefined' && canonicalUrl) { %>
    <meta property="og:url" content="<%- canonicalUrl %>">
    <link rel="canonical" href="<%- canonicalUrl %>">
  <% } %>
  <%
    const _host = (req && req.hostname) ? String(req.hostname).toLowerCase() : '';
    const _isManagiraRootHost = _host === 'managira.com' || _host === 'www.managira.com' || _host === 'localhost' || _host === '127.0.0.1';
    const _schoolLogoPath = req && req.schoolDetails ? req.schoolDetails.logo_path : null;

    let _shareImage = 'https://www.managira.com/images/image.png';
    let _shareImageWidth = '804';
    let _shareImageHeight = '461';
    let _shareImageType = 'image/png';

    if (!_isManagiraRootHost && _schoolLogoPath) {
      const rawLogo = String(_schoolLogoPath).trim();
      if (/^https?:\/\//i.test(rawLogo)) {
        _shareImage = rawLogo;
      } else if (process && process.env && process.env.S3_BUCKET_NAME && process.env.AWS_REGION) {
        _shareImage = `https://${process.env.S3_BUCKET_NAME}.s3.${process.env.AWS_REGION}.amazonaws.com/${rawLogo}`;
      }
      _shareImageWidth = '512';
      _shareImageHeight = '512';
      _shareImageType = 'image/jpeg';
    }
  %>
  <meta property="og:image" content="<%- _shareImage %>">
  <meta property="og:image:width" content="<%- _shareImageWidth %>">
  <meta property="og:image:height" content="<%- _shareImageHeight %>">
  <meta property="og:image:type" content="<%- _shareImageType %>">
  <meta property="og:site_name" content="Managira">
  
  <!-- Twitter Meta Tags -->
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="<%- title %>">
  <% if (typeof description !== 'undefined' && description) { %>
    <meta name="twitter:description" content="<%- description %>">
  <% } %>
  <meta name="twitter:image" content="<%- _shareImage %>">

  <% if (typeof structuredData !== 'undefined' && structuredData) { %>
    <script type="application/ld+json"><%- JSON.stringify(structuredData) %></script>
  <% } %>

  <!-- Favicon Links -->
  <%
    const _sessionLogo = session && session.logo ? String(session.logo).trim() : '';
    const _schoolLogo = req && req.schoolDetails && (req.schoolDetails.logo || req.schoolDetails.logo_path)
      ? String(req.schoolDetails.logo || req.schoolDetails.logo_path).trim()
      : '';

    let _faviconImage = _sessionLogo || _schoolLogo || '';
    if (_faviconImage && !/^https?:\/\//i.test(_faviconImage)) {
      if (process && process.env && process.env.S3_BUCKET_NAME && process.env.AWS_REGION) {
        _faviconImage = `https://${process.env.S3_BUCKET_NAME}.s3.${process.env.AWS_REGION}.amazonaws.com/${_faviconImage}`;
      } else {
        _faviconImage = `/${_faviconImage.replace(/^\/+/, '')}`;
      }
    }
  %>
  <% if (_faviconImage) { %>
    <link rel="icon" href="<%- _faviconImage %>" type="image/png" sizes="any" />
    <link rel="shortcut icon" href="<%- _faviconImage %>" type="image/png" />
    <link rel="apple-touch-icon" href="<%- _faviconImage %>" />
  <% } else { %>
    <link rel="icon" href="/favicon.ico" type="image/x-icon" sizes="any" />
    <link rel="apple-touch-icon" sizes="180x180" href="/images/favicon_io/apple-touch-icon.png" />
    <link
      rel="icon"
      type="image/png"
      sizes="32x32"
      href="/images/favicon_io/favicon-32x32.png"
    />
    <link
      rel="icon"
      type="image/png"
      sizes="16x16"
      href="/images/favicon_io/favicon-16x16.png"
    />
    <link rel="shortcut icon" href="/favicon.ico" />
  <% } %>
  <!-- PWA manifest — always present regardless of school logo -->
  <link rel="manifest" href="/images/favicon_io/site.webmanifest" />
  <link
    rel="stylesheet"
    href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css"
  />

  <!-- Tailwind (for utility-first page styling) -->
  <script src="https://cdn.tailwindcss.com"></script>

  <!-- Stylesheets -->
  <link rel="stylesheet" href="/css/style.css" />
  <link rel="stylesheet" href="/css/buttons.css" />
  <link rel="stylesheet" href="/css/index.css" />
  <link rel="stylesheet" href="/css/orgDashboard.css" />
  <link rel="stylesheet" href="/css/classDashboard.css" />
  <link rel="stylesheet" href="/css/attendanceCollection.css" />
  <link rel="stylesheet" href="/css/addStudent.css" />
  <link rel="stylesheet" href="/css/assessment.css" />
  <link rel="stylesheet" href="/css/deleteStudent.css" />
  <link rel="stylesheet" href="/css/editStudent.css" />
  <link rel="stylesheet" href="/css/manageClassSubjectAndGradYr.css" />
  <link rel="stylesheet" href="/css/manageRecords.css" />
  <link rel="stylesheet" href="/css/registerSchoolYear.css" />
  <link rel="stylesheet" href="/css/studentDetails.css" />
  <link rel="stylesheet" href="/css/manageStudents.css" />
  <% if (!(typeof hideGlobalChatbot !== 'undefined' && hideGlobalChatbot)) { %>
  <link rel="stylesheet" href="/css/chatbot.css" />
  <% } %>
  <link rel="stylesheet" href="/css/guardian.css" />

  <!-- Loading indicator styles (SPA navigation progress + center spinner) -->
  <style>
    /* Top progress bar used by spa-router.js (#spa-progress) */
    #spa-progress {
      position: fixed;
      top: 0;
      left: 0;
      height: 3px;
      width: 0%;
      background: linear-gradient(90deg, #01535b, #2dd4bf);
      box-shadow: 0 0 8px rgba(1, 83, 91, 0.5);
      z-index: 10000;
      opacity: 0;
      transition: width 180ms ease-out, opacity 180ms ease;
      pointer-events: none;
    }
    #spa-progress.active { opacity: 1; }

    /* Center spinner overlay shown for slow navigations (>250ms) */
    .page-loading-overlay {
      position: fixed;
      inset: 0;
      background: rgba(255, 255, 255, 0.55);
      display: none;
      justify-content: center;
      align-items: center;
      z-index: 9998;
      backdrop-filter: blur(1px);
    }
    .page-loading-overlay.active { display: flex; }

    .spinner {
      width: 44px;
      height: 44px;
      border: 4px solid #e2e8f0;
      border-top-color: #01535b;
      border-radius: 50%;
      animation: spin 0.8s linear infinite;
    }
    @keyframes spin { to { transform: rotate(360deg); } }
  </style>

  <!-- Include Quill CSS and JavaScript (rich text editor) -->
  <link href="https://cdn.quilljs.com/1.3.7/quill.snow.css" rel="stylesheet" />
  <script src="https://cdn.quilljs.com/1.3.7/quill.min.js"></script>

  <!-- Preconnect to Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<%
  const rawFontStyle = (session && session.fontStyle ? String(session.fontStyle).trim() : '') || 'Inter';
  const selectedFont = rawFontStyle;
  const serifFonts = ['PT Serif', 'Merriweather', 'Playfair Display'];
  const googleFonts = ['Inter', 'Roboto', 'Open Sans', 'Lato', 'Montserrat', 'Poppins', 'Nunito', 'Raleway', 'Work Sans', 'Source Sans Pro', 'Ubuntu', 'Noto Sans', 'PT Serif', 'Merriweather', 'Playfair Display'];
  const fallbackFamily = serifFonts.includes(selectedFont) ? 'serif' : 'sans-serif';
  const normalizedFont = selectedFont.replace(/\s+/g, '+');
  const shouldLoadGoogleFont = googleFonts.includes(selectedFont);
%>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
  <% if (shouldLoadGoogleFont && selectedFont !== 'Inter') { %>
  <link href="https://fonts.googleapis.com/css2?family=<%= normalizedFont %>:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
  <% } %>
  <%
    // Theme color mapping for organization buttons
    const isThemeAuthenticated = !!(typeof session !== 'undefined' && session && session.firstName);
    const themeColor = (isThemeAuthenticated && session.themeColor) ? session.themeColor : 'teal';
    const themeColors = {
      teal: { primary: '#01535b', hover: '#014a51' },
      blue: { primary: '#2563eb', hover: '#1d4ed8' },
      green: { primary: '#2d5f4f', hover: '#245043' },
      purple: { primary: '#7c3aed', hover: '#6d28d9' },
      indigo: { primary: '#4f46e5', hover: '#4338ca' },
      rose: { primary: '#8b2635', hover: '#7a212e' },
      amber: { primary: '#d97706', hover: '#b45309' },
      yellow: { primary: '#eab308', hover: '#ca8a04' },
      slate: { primary: '#334155', hover: '#1e293b' }
    };
    const currentTheme = themeColors[themeColor] || themeColors.teal;
  %>
  <style>
    :root {
      --font-family: "<%= selectedFont %>", <%= fallbackFamily %>;
      /* Organization Theme Colors */
      --org-primary-color: <%= currentTheme.primary %>;
      --org-primary-hover: <%= currentTheme.hover %>;
      --org-primary-soft: color-mix(in srgb, var(--org-primary-color) 10%, white);
      --org-primary-soft-strong: color-mix(in srgb, var(--org-primary-color) 16%, white);
      --org-primary-soft-border: color-mix(in srgb, var(--org-primary-color) 28%, white);
      --org-primary-soft-shadow: color-mix(in srgb, var(--org-primary-color) 18%, transparent);
      --org-primary-soft-shadow-strong: color-mix(in srgb, var(--org-primary-color) 24%, transparent);
      --org-primary-hover-fill: color-mix(in srgb, var(--org-primary-color) 88%, white);
    }
  </style>

  <!-- JavaScript Files -->
  <script>
    // Legacy Turbo-compatible init hook. Fires on every SPA page load via
    // the `turbo:load` / `spa:pageLoaded` custom event dispatched by spa-router.js.
    document.addEventListener('turbo:load', () => {
      if (typeof window.initializePage === 'function') {
        try { window.initializePage(); } catch (_) { /* swallow */ }
      }
    });

    function optimizePageImages(root = document) {
      const scope = root && root.querySelectorAll ? root : document;
      const images = scope.querySelectorAll('img');

      images.forEach((img, index) => {
        if (!img.hasAttribute('decoding')) {
          img.setAttribute('decoding', 'async');
        }

        const isPriorityImage =
          index < 2 ||
          img.closest('.custom-carousel, .slide, .hero, .public-dashboard-header, .footer-logo, .admin-header-left, header, nav');

        if (!img.hasAttribute('loading')) {
          img.setAttribute('loading', isPriorityImage ? 'eager' : 'lazy');
        }

        if (!img.getAttribute('alt') || !img.getAttribute('alt').trim()) {
          const caption = img.closest('.gallery-card, .slide, figure, .event-card')?.querySelector('.caption, figcaption, h3');
          const fallbackAlt = caption?.textContent?.trim() || 'Image';
          img.setAttribute('alt', fallbackAlt);
        }
      });
    }

    document.addEventListener('DOMContentLoaded', () => optimizePageImages(document));
    window.addEventListener('spa:pageLoaded', () => {
      const main = document.querySelector('main') || document;
      optimizePageImages(main);
    });
  </script>
  
  <!-- SPA Router User Type Detection -->
  <script>
    // Detect user type for SPA router optimization
    window.spaUserType = <%- 
      session && session.firstName ? (
        session.accountType === 'Admin'
          || session.accountType === 'Mini Admin'
          || session.accountType === 'Internal Worker'
          || session.userRole === 'Internal Worker'
          ? '"admin"' :
        session.accountType === 'Hub' ? '"hub"' :
        session.userRole === 'Guardian' ? '"guardian"' :
        '"organization"'
      ) : '"public"'
    %>;
  </script>
  
  <script src="/js/turbo-init.js"></script>
  <script src="/js/spa-router.js" defer></script>
  <script src="/js/spa-user-info.js" defer></script>
  <script src="/js/script.js" defer></script>
  <script src="/js/index.js" defer></script>
  <script src="/js/classDashboard.js" defer></script>
  <script src="/js/manageRecords.js" defer></script>
  <script src="/js/createEmployee.js" defer></script>
  <script src="/js/management.js" defer></script>
  <% if (!(typeof hideGlobalChatbot !== 'undefined' && hideGlobalChatbot)) { %>
  <script src="/js/chatbot.js" defer></script>
  <% } %>

  <!-- PWA: register service worker (static-asset cache only; never intercepts auth or API) -->
  <script>
    if ('serviceWorker' in navigator) {
      window.addEventListener('load', function () {
        navigator.serviceWorker
          .register('/service-worker.js', { scope: '/' })
          .catch(function () { /* silent — app works fine without SW */ });
      });
    }
  </script>
</head>
