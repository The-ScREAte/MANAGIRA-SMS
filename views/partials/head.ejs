<head>
  <meta charset="UTF-8" />
  <meta http-equiv="X-UA-Compatible" content="IE=edge" />
  <meta name="viewport" content="<%= locals.viewportContent || 'width=device-width, initial-scale=1.0, maximum-scale=1.0' %>" />
  <title><%= title %><% if (!String(title).includes('Managira')) { %> | Managira<% } %></title>
  
  <!-- SEO Meta Tags -->
  <% if (typeof description !== 'undefined' && description) { %>
    <meta name="description" content="<%= description %>">
  <% } %>
  <% if (typeof keywords !== 'undefined' && keywords) { %>
    <meta name="keywords" content="<%= keywords %>">
  <% } %>
  <%
    const _noindexPaths = ['/legal/help', '/legal/employment', '/legal/app-demo', '/legal/donations', '/account/login'];
    const _reqPath = req && req.path ? req.path : '';
    const _shouldNoindex = _noindexPaths.some(p => _reqPath === p || _reqPath.startsWith(p + '/'));
  %>
  <meta name="robots" content="<%= _shouldNoindex ? 'noindex, nofollow' : 'index, follow' %>">
  <meta name="author" content="Managira">
  
  <!-- Open Graph Meta Tags -->
  <meta property="og:type" content="website">
  <meta property="og:title" content="<%= title %>">
  <% if (typeof description !== 'undefined' && description) { %>
    <meta property="og:description" content="<%= description %>">
  <% } %>
  <% if (typeof canonicalUrl !== 'undefined' && canonicalUrl) { %>
    <meta property="og:url" content="<%= canonicalUrl %>">
    <link rel="canonical" href="<%= canonicalUrl %>">
  <% } %>
  <%
    const _host = (req && req.hostname) ? String(req.hostname).toLowerCase() : '';
    const _isManagiraRootHost = _host === 'managira.com' || _host === 'www.managira.com' || _host === 'localhost' || _host === '127.0.0.1';
    const _schoolLogoPath = req && req.schoolDetails ? req.schoolDetails.logo_path : null;

    let _shareImage = 'https://managira.com/images/image.png';
    let _shareImageWidth = '804';
    let _shareImageHeight = '461';
    let _shareImageType = 'image/png';

    // Per-page override (e.g. the Mira AI Assistant page using the Mira
    // logo instead of the generic Managira share image) - takes priority
    // over both the root-host default and the school-logo case below.
    const _hasShareImageOverride = typeof shareImage !== 'undefined' && shareImage;
    if (_hasShareImageOverride) {
      _shareImage = shareImage;
      if (typeof shareImageWidth !== 'undefined' && shareImageWidth) _shareImageWidth = String(shareImageWidth);
      if (typeof shareImageHeight !== 'undefined' && shareImageHeight) _shareImageHeight = String(shareImageHeight);
      if (typeof shareImageType !== 'undefined' && shareImageType) _shareImageType = shareImageType;
    } else if (!_isManagiraRootHost && _schoolLogoPath) {
      const rawLogo = String(_schoolLogoPath).trim();
      _shareImage = publicImageUrl(rawLogo, { public: true });
      _shareImageWidth = '512';
      _shareImageHeight = '512';
      _shareImageType = 'image/jpeg';
    }
  %>
  <meta property="og:image" content="<%= _shareImage %>">
  <meta property="og:image:width" content="<%= _shareImageWidth %>">
  <meta property="og:image:height" content="<%= _shareImageHeight %>">
  <meta property="og:image:type" content="<%= _shareImageType %>">
  <meta property="og:site_name" content="Managira">
  
  <!-- Twitter Meta Tags -->
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="<%= title %>">
  <% if (typeof description !== 'undefined' && description) { %>
    <meta name="twitter:description" content="<%= description %>">
  <% } %>
  <meta name="twitter:image" content="<%= _shareImage %>">

  <% if (typeof structuredData !== 'undefined' && structuredData) { %>
    <script type="application/ld+json"><%- JSON.stringify(structuredData) %></script>
  <% } %>

  <!-- Favicon Links -->
  <%
    const _sessionLogo = session && session.logo ? String(session.logo).trim() : '';
    const _schoolLogo = req && req.schoolDetails && (req.schoolDetails.logo || req.schoolDetails.logo_path)
      ? String(req.schoolDetails.logo || req.schoolDetails.logo_path).trim()
      : '';

    let _faviconImage = _sessionLogo || _schoolLogo || '';
    if (_faviconImage) _faviconImage = publicImageUrl(_faviconImage, { public: true });
  %>
  <% if (_faviconImage) { %>
    <link rel="icon" href="<%= _faviconImage %>" type="image/png" sizes="any" />
    <link rel="shortcut icon" href="<%= _faviconImage %>" type="image/png" />
    <link rel="apple-touch-icon" href="<%= _faviconImage %>" />
  <% } else { %>
    <link rel="icon" href="/favicon.ico" type="image/x-icon" sizes="any" />
    <link rel="apple-touch-icon" sizes="180x180" href="/images/favicon_io/apple-touch-icon.png" />
    <link
      rel="icon"
      type="image/png"
      sizes="32x32"
      href="/images/favicon_io/favicon-32x32.png"
    />
    <link
      rel="icon"
      type="image/png"
      sizes="16x16"
      href="/images/favicon_io/favicon-16x16.png"
    />
    <link rel="shortcut icon" href="/favicon.ico" />
  <% } %>
  <!-- PWA manifest — always present regardless of school logo -->
  <link rel="manifest" href="/images/favicon_io/site.webmanifest" />
  <link rel="preconnect" href="https://cdnjs.cloudflare.com" crossorigin />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <!-- Icons and web fonts come from other sites: loaded without holding up the
       page, so text shows at once on slow connections (icons appear a moment later). -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" media="print" onload="this.media='all'" />
  <noscript><link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" /></noscript>

  <!-- The app's shared stylesheets as one file (utils/cssBundle.js) -->
  <link rel="stylesheet" href="<%= cssBundleUrl(!(typeof hideGlobalChatbot !== 'undefined' && hideGlobalChatbot)) %>" />

  <!-- Loading indicator styles (SPA navigation progress + center spinner) -->
  <style>
    /* Top progress bar used by spa-router.js (#spa-progress) */
    #spa-progress {
      position: fixed;
      top: 0;
      left: 0;
      height: 3px;
      width: 0%;
      background: linear-gradient(90deg, #01535b, #2dd4bf);
      box-shadow: 0 0 8px rgba(1, 83, 91, 0.5);
      z-index: 10000;
      opacity: 0;
      transition: width 180ms ease-out, opacity 180ms ease;
      pointer-events: none;
    }
    #spa-progress.active { opacity: 1; }

    .spinner {
      width: 44px;
      height: 44px;
      border: 4px solid #e2e8f0;
      border-top-color: #01535b;
      border-radius: 50%;
      animation: spin 0.8s linear infinite;
    }
    @keyframes spin { to { transform: rotate(360deg); } }
    /* Phones zoom into a field with text under 16px when it is tapped: on touch
       screens every field stays at least 16px (with maximum-scale=1 in the viewport). */
    @media (hover: none) and (pointer: coarse) {
      input:not([type="checkbox"]):not([type="radio"]):not([type="range"]):not([type="color"]):not([type="file"]):not([type="submit"]):not([type="button"]):not([type="reset"]):not([type="image"]),
      select,
      textarea { font-size: max(16px, 1em) !important; }
    }
  </style>

  <!-- Rich text styles (Quill) for formatted content. Loaded without holding up
       the page; the editor script itself loads only on the pages that edit. -->
  <link href="https://cdn.jsdelivr.net/npm/quill@1.3.7/dist/quill.snow.css" rel="stylesheet" media="print" onload="this.media='all'" />
  <noscript><link href="https://cdn.jsdelivr.net/npm/quill@1.3.7/dist/quill.snow.css" rel="stylesheet" /></noscript>

  <!-- Preconnect to Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<%
  const rawFontStyle = (session && session.fontStyle ? String(session.fontStyle).trim() : '') || 'Inter';
  const selectedFont = rawFontStyle;
  const serifFonts = ['PT Serif', 'Merriweather', 'Playfair Display'];
  const googleFonts = ['Inter', 'Roboto', 'Open Sans', 'Lato', 'Montserrat', 'Poppins', 'Nunito', 'Raleway', 'Work Sans', 'Source Sans Pro', 'Ubuntu', 'Noto Sans', 'PT Serif', 'Merriweather', 'Playfair Display'];
  const fallbackFamily = serifFonts.includes(selectedFont) ? 'serif' : 'sans-serif';
  const normalizedFont = selectedFont.replace(/\s+/g, '+');
  const shouldLoadGoogleFont = googleFonts.includes(selectedFont);
%>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet" media="print" onload="this.media='all'" />
  <% if (shouldLoadGoogleFont && selectedFont !== 'Inter') { %>
  <link href="https://fonts.googleapis.com/css2?family=<%= normalizedFont %>:wght@300;400;500;600;700&display=swap" rel="stylesheet" media="print" onload="this.media='all'" />
  <% } %>
  <%
    // Theme color mapping for organization buttons
    const isThemeAuthenticated = !!(typeof session !== 'undefined' && session && session.firstName);
    const themeColor = (isThemeAuthenticated && session.themeColor) ? session.themeColor : 'teal';
    const themeColors = themePalette;
    const currentTheme = themeColors[themeColor] || themeColors.teal;
  %>
  <style>
    :root {
      --font-family: "<%= selectedFont %>", <%= fallbackFamily %>;
      /* Organization Theme Colors */
      --org-primary-color: <%= currentTheme.primary %>;
      --org-primary-hover: <%= currentTheme.hover %>;
      --org-primary-soft: color-mix(in srgb, var(--org-primary-color) 10%, white);
      --org-primary-soft-strong: color-mix(in srgb, var(--org-primary-color) 16%, white);
      --org-primary-soft-border: color-mix(in srgb, var(--org-primary-color) 28%, white);
      --org-primary-soft-shadow: color-mix(in srgb, var(--org-primary-color) 18%, transparent);
      --org-primary-soft-shadow-strong: color-mix(in srgb, var(--org-primary-color) 24%, transparent);
      --org-primary-hover-fill: color-mix(in srgb, var(--org-primary-color) 88%, white);
    }
  </style>

  <!-- JavaScript Files -->
  <script>
    // Legacy Turbo-compatible init hook. Fires on every SPA page load via
    // the `turbo:load` / `spa:pageLoaded` custom event dispatched by spa-router.js.
    document.addEventListener('turbo:load', () => {
      if (typeof window.initializePage === 'function') {
        try { window.initializePage(); } catch (_) { /* swallow */ }
      }
    });

    function optimizePageImages(root = document) {
      const scope = root && root.querySelectorAll ? root : document;
      const images = scope.querySelectorAll('img');

      images.forEach((img, index) => {
        if (!img.hasAttribute('decoding')) {
          img.setAttribute('decoding', 'async');
        }

        const isPriorityImage =
          index < 2 ||
          img.closest('.custom-carousel, .slide, .hero, .public-dashboard-header, .footer-logo, .admin-header-left, header, nav');

        if (!img.hasAttribute('loading')) {
          img.setAttribute('loading', isPriorityImage ? 'eager' : 'lazy');
        }

        if (!img.getAttribute('alt') || !img.getAttribute('alt').trim()) {
          const caption = img.closest('.gallery-card, .slide, figure, .event-card')?.querySelector('.caption, figcaption, h3');
          const fallbackAlt = caption?.textContent?.trim() || 'Image';
          img.setAttribute('alt', fallbackAlt);
        }
      });
    }

    document.addEventListener('DOMContentLoaded', () => optimizePageImages(document));
    window.addEventListener('spa:pageLoaded', () => {
      const main = document.querySelector('main') || document;
      optimizePageImages(main);
    });
  </script>
  
  <!-- SPA Router User Type Detection -->
  <script>
    // Detect user type for SPA router optimization
    window.spaUserType = <%- 
      session && session.firstName ? (
        // Managira staff viewing a school use the school's fast navigation.
        session.superAdminOrgSwitch && session.organizationId ? '"organization"' :
        session.accountType === 'Admin'
          || session.accountType === 'Mini Admin'
          || session.accountType === 'Internal Worker'
          || session.userRole === 'Internal Worker'
          ? '"admin"' :
        session.accountType === 'Hub' ? '"hub"' :
        session.userRole === 'Guardian' ? '"guardian"' :
        session.userRole === 'Student' ? '"student"' :
        session.userRole === 'Driver' ? '"driver"' :
        '"organization"'
      ) : '"public"'
    %>;
    // Phone fields start on the school's country (public/js/dialCodes.js).
    window.MANAGIRA_SCHOOL_COUNTRY = <%- JSON.stringify(/^[A-Z]{2}$/.test(locals.schoolCountry || '') ? locals.schoolCountry : '') %>;
  </script>
  
  <script src="<%= assetUrl('/js/turbo-init.js') %>"></script>
  <script src="<%= assetUrl('/js/spa-router.js') %>" defer></script>
  <script src="<%= assetUrl('/js/spa-user-info.js') %>" defer></script>
  <script src="<%= assetUrl('/js/phoneField.js') %>" defer></script>
  <script src="<%= assetUrl('/js/globalTableSort.js') %>" defer></script>
  <script src="<%= assetUrl('/js/script.js') %>" defer></script>
  <script src="<%= assetUrl('/js/index.js') %>" defer></script>
  <script src="<%= assetUrl('/js/classDashboard.js') %>" defer></script>
  <script src="<%= assetUrl('/js/manageRecords.js') %>" defer></script>
  <script src="<%= assetUrl('/js/createEmployee.js') %>" defer></script>
  <script src="<%= assetUrl('/js/management.js') %>" defer></script>
  <% if (!(typeof hideGlobalChatbot !== 'undefined' && hideGlobalChatbot)) { %>
  <script src="<%= assetUrl('/js/chatbot.js') %>" defer></script>
  <% } %>

  <script>
    // On small screens a side menu opens under its own Menu button, so the button stays
    // visible. This keeps that position current: phones, tablets and rotation included.
    (function () {
      var TOGGLES = '.management-nav-toggle, .hub-nav-toggle, .settings-nav-header, .nav-toggle';
      var OPEN = '.management-nav.open, .hub-nav.open, .settings-nav.open, .nav-card.open';
      var waiting = false;
      function closeAllMenus() {
        var headerMenu = document.getElementById('header-nav-menu');
        var headerToggle = document.getElementById('header-hamburger');
        if (headerMenu) {
          headerMenu.classList.remove('show');
          headerMenu.style.display = 'none';
        }
        if (headerToggle) {
          headerToggle.classList.remove('active');
          headerToggle.setAttribute('aria-expanded', 'false');
          headerToggle.setAttribute('aria-label', 'Open menu');
        }
        [
          { panel: '#class-tools-panel', overlay: '#class-tools-overlay', toggle: '.nav-toggle', label: 'Open Class Tools' },
          { panel: '#hub-nav', overlay: '#hub-nav-overlay', toggle: '.hub-nav-toggle', label: 'Open menu' },
          { panel: '#management-nav', overlay: '#management-nav-overlay', toggle: '.management-nav-toggle' },
          { panel: '.settings-nav', overlay: '.settings-nav-overlay', toggle: '.settings-nav-header' }
        ].forEach(function (menu) {
          var panel = document.querySelector(menu.panel);
          if (panel) panel.classList.remove('open');
          var overlay = document.querySelector(menu.overlay);
          if (overlay) overlay.classList.remove('show');
          var toggle = document.querySelector(menu.toggle);
          if (toggle) {
            toggle.setAttribute('aria-expanded', 'false');
            if (menu.label) toggle.setAttribute('aria-label', menu.label);
          }
        });
        document.querySelectorAll('[data-od-dd].is-open').forEach(function (dropdown) {
          dropdown.classList.remove('is-open');
          var panel = dropdown.querySelector('[data-od-dd-panel]');
          var button = dropdown.querySelector('[data-od-dd-toggle]');
          if (panel) panel.hidden = true;
          if (button) button.setAttribute('aria-expanded', 'false');
        });
      }

      if (window.parent !== window) {
        document.addEventListener('click', function () {
          window.parent.postMessage({ type: 'managira:menu-outside-click' }, window.location.origin);
        }, true);
      }
      window.addEventListener('message', function (event) {
        if (event.origin !== window.location.origin || event.source === window) return;
        if (event.data && event.data.type === 'managira:menu-outside-click') closeAllMenus();
      });

      function publish() {
        waiting = false;
        var header = document.getElementById('top-header');
        var top = header ? Math.max(0, header.getBoundingClientRect().bottom) : 0;
        var toggles = document.querySelectorAll(TOGGLES);
        for (var i = 0; i < toggles.length; i++) {
          var box = toggles[i].getBoundingClientRect();
          if (box.height > 0 && box.bottom > top) { top = box.bottom + 6; break; }
        }
        document.documentElement.style.setProperty('--side-menu-top', top + 'px');
        [
          { selector: '.hub-nav-toggle', prefix: 'hub' },
          { selector: '.management-nav-toggle', prefix: 'management' },
          { selector: '.settings-nav-header', prefix: 'settings' }
        ].forEach(function (menu) {
          var toggle = document.querySelector(menu.selector);
          if (!toggle) return;
          var box = toggle.getBoundingClientRect();
          if (box.height > 0) {
            document.documentElement.style.setProperty('--' + menu.prefix + '-nav-top', box.bottom + 'px');
            document.documentElement.style.setProperty('--' + menu.prefix + '-nav-left', box.left + 'px');
            document.documentElement.style.setProperty('--' + menu.prefix + '-nav-width', box.width + 'px');
          }
        });
      }
      function soon() {
        if (waiting) return;
        waiting = true;
        requestAnimationFrame(publish);
      }
      document.addEventListener('DOMContentLoaded', publish);
      window.addEventListener('load', publish);
      window.addEventListener('resize', soon, { passive: true });
      window.addEventListener('orientationchange', soon, { passive: true });
      if (window.visualViewport) window.visualViewport.addEventListener('resize', soon, { passive: true });
      document.addEventListener('click', function (event) {
        if (event.target.closest && event.target.closest(TOGGLES)) publish();
      }, true);
      document.addEventListener('click', function (event) {
        if (!(event.target instanceof Element)) return;
        var element = event.target;
        var toggle = element.closest('#header-hamburger, .management-nav-toggle, .hub-nav-toggle, .settings-nav-header, .nav-toggle');
        var scope = toggle && (toggle.matches('#header-hamburger') ? 'header' :
          toggle.matches('.management-nav-toggle') ? 'management' :
          toggle.matches('.hub-nav-toggle') ? 'hub' :
          toggle.matches('.settings-nav-header') ? 'settings' : 'class');
        if (!scope) {
          if (element.closest('#header-nav-menu')) scope = 'header';
          else if (element.closest('#class-tools-panel')) scope = 'class';
          else if (element.closest('#hub-nav')) scope = 'hub';
          else if (element.closest('#management-nav')) scope = 'management';
          else if (element.closest('.settings-nav')) scope = 'settings';
          else if (element.closest('[data-od-dd]')) scope = 'dashboard';
        }

        if (scope !== 'header') {
          var headerMenu = document.getElementById('header-nav-menu');
          var headerToggle = document.getElementById('header-hamburger');
          if (headerMenu) {
            headerMenu.classList.remove('show');
            headerMenu.style.display = 'none';
          }
          if (headerToggle) {
            headerToggle.classList.remove('active');
            headerToggle.setAttribute('aria-expanded', 'false');
            headerToggle.setAttribute('aria-label', 'Open menu');
          }
        }

        var sideMenus = [
          { scope: 'class', panel: '#class-tools-panel', overlay: '#class-tools-overlay', toggle: '.nav-toggle' },
          { scope: 'hub', panel: '#hub-nav', overlay: '#hub-nav-overlay', toggle: '.hub-nav-toggle' },
          { scope: 'management', panel: '#management-nav', overlay: '#management-nav-overlay', toggle: '.management-nav-toggle' },
          { scope: 'settings', panel: '.settings-nav', overlay: '.settings-nav-overlay', toggle: '.settings-nav-header' }
        ];
        sideMenus.forEach(function (menu) {
          if (menu.scope === scope) return;
          var panel = document.querySelector(menu.panel);
          if (panel) panel.classList.remove('open');
          var overlay = document.querySelector(menu.overlay);
          if (overlay) overlay.classList.remove('show');
          var toggle = document.querySelector(menu.toggle);
          if (toggle) {
            toggle.setAttribute('aria-expanded', 'false');
            if (menu.scope === 'class' || menu.scope === 'hub') {
              toggle.setAttribute('aria-label', menu.scope === 'class' ? 'Open Class Tools' : 'Open menu');
            }
          }
        });

        if (scope !== 'dashboard') {
          document.querySelectorAll('[data-od-dd].is-open').forEach(function (dropdown) {
            dropdown.classList.remove('is-open');
            var panel = dropdown.querySelector('[data-od-dd-panel]');
            var button = dropdown.querySelector('[data-od-dd-toggle]');
            if (panel) panel.hidden = true;
            if (button) button.setAttribute('aria-expanded', 'false');
          });
        } else {
          var activeDropdown = element.closest('[data-od-dd]');
          document.querySelectorAll('[data-od-dd].is-open').forEach(function (dropdown) {
            if (dropdown === activeDropdown) return;
            dropdown.classList.remove('is-open');
            var panel = dropdown.querySelector('[data-od-dd-panel]');
            var button = dropdown.querySelector('[data-od-dd-toggle]');
            if (panel) panel.hidden = true;
            if (button) button.setAttribute('aria-expanded', 'false');
          });
        }
      }, true);
      // Only while a menu is open, so ordinary scrolling does no extra work.
      window.addEventListener('scroll', function () {
        if (document.querySelector(OPEN)) soon();
      }, { passive: true, capture: true });
    })();
  </script>

  <!-- PWA: register service worker (static assets, and workspace panels you come back to; never intercepts auth or API) -->
  <script>
    if ('serviceWorker' in navigator) {
      // When this person's permissions or plan change, saved page copies are dropped
      // and an open page reloads, so an old menu is never left on screen.
      (function () {
        var stamp = <%- JSON.stringify(typeof accessStamp === 'string' ? accessStamp : '') %>;
        var sw = navigator.serviceWorker;
        try {
          var saved = localStorage.getItem('managiraAccess');
          if (stamp && saved !== stamp) {
            localStorage.setItem('managiraAccess', stamp);
            if (saved && sw.controller) sw.controller.postMessage({ type: 'managira-drop-panels' });
          }
        } catch (err) { /* private browsing: the service worker's own check still applies */ }
        sw.addEventListener('message', function (event) {
          if (!event.data || event.data.type !== 'managira-access-changed' || window.top !== window) return;
          window.location.reload();
        });
      })();
      window.addEventListener('load', function () {
        navigator.serviceWorker
          .register('/service-worker.js', { scope: '/' })
          .catch(function () { /* silent — app works fine without SW */ });
      });
    }
  </script>
</head>
