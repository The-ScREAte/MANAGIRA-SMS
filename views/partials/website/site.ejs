<%#
  The school website. One content model (utils/websiteView.js) drawn in twelve
  designs: academy, classic, horizon (Modern), editorial (Magazine), story,
  spotlight, minimal, mosaic, campus, and the 3D designs that move as visitors
  scroll: glide, prism and panorama (public/css/school-website-3d.css,
  public/js/schoolSiteMotion.js).
  locals: site
%>
<%
  const L = site.layout;
  const S = site.school;
  const B = site.banner;
  const R = site.registration;
  const hasContact = site.blocks.includes('contact');
  const block = (key, number) => include('./block', { site, key, number });
  const navLabels = {
    quickFacts: 'At a glance', welcome: 'Welcome', about: 'About', programs: 'Programs', admissions: 'Admissions',
    gallery: 'Gallery', events: 'Events', announcements: 'Notices', articles: 'News', leadership: 'Leadership',
    achievements: 'Achievements', testimonials: 'Testimonials', faq: 'FAQ', contact: 'Contact',
  };
  const anchorOf = (key) => site.anchors[key] || ('sw-' + key);
  const slidesHtml = (variant) => include('./slides', { site, variant });
  const ctas = () => {
    let html = '';
    if (R.open) html += '<a class="sw-btn sw-btn--primary" href="' + R.url + '">Apply now</a>';
    if (hasContact) html += '<a class="sw-btn sw-btn--ghost" href="#contact">Contact us</a>';
    else if (site.blocks.includes('about')) html += '<a class="sw-btn sw-btn--ghost" href="#about-us">About the school</a>';
    return html;
  };
%>
<%
  // Emblem designs: the emblem's pattern (or the school's own image) for the page's CSS.
  const EM = site.emblem;
  const emStyle = !EM ? '' : (EM.kind === 'icon'
    ? '--sw-emblem-pattern: url("' + EM.patternUrl + '"); --sw-emblem-mask: url("' + EM.maskUrl + '")'
    : '--sw-emblem-image: url("' + publicImageUrl(EM.imageUrl, { public: true }) + '")');
  const emblemMark = (cls, prefix, attrs) => include('./emblemMark', { site, cls, prefix, attrs });
%>
<div class="sw-site sw-site--<%= L %><%= site.design && site.design !== L ? ' sw-site--' + site.design : '' %><%= EM ? ' sw-emblem sw-emblem--' + EM.kind + ' sw-emblem--' + EM.placement : '' %><%= site.wholePhotos ? ' sw-whole' : '' %>" data-sw-layout="<%= L %>" data-sw-design="<%= site.design || L %>"<%= site.motion ? ' data-sw-motion' : '' %><% if (emStyle) { %> style="<%= emStyle %>"<% } %>>
<% if (site.motion) { %><script>
  // 3D designs: starting positions are set before the page first shows, so nothing jumps.
  // Nothing moves for visitors who ask their device for less motion, and if the motion
  // script can't load, everything is shown in place.
  (function (s) { try { if (!(window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches)) { s.classList.add('sw-moving'); setTimeout(function () { if (!window.swMotionReady) s.classList.remove('sw-moving'); }, 6000); } } catch (e) {} })(document.currentScript.parentNode);
</script><% } %>

<% if (L === 'academy') {
  /* ACADEMY: announcement bar, own menu, full-screen photo/video opening,
     next-step tiles, photo bands for facts and the closing call. */
  const still = (i) => site.stills.length ? site.stills[i % site.stills.length] : '';
  const nextSteps = [];
  if (R.open) nextSteps.push({ href: R.url, title: 'Apply today', text: R.endLabel ? 'Applications close ' + R.endLabel + '.' : 'Start your application online.', icon: '<path d="M14 3v4a1 1 0 0 0 1 1h4"/><path d="M17 21H7a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h7l5 5v11a2 2 0 0 1-2 2z"/><path d="m9 15 2 2 4-4"/>' });
  if (hasContact) nextSteps.push({ href: '#contact', title: 'Request information', text: 'Ask us anything. We reply quickly.', icon: '<circle cx="12" cy="12" r="10"/><path d="M12 16v-4"/><path d="M12 8h.01"/>' });
  if (site.blocks.includes('events')) nextSteps.push({ href: '#events', title: 'Visit & events', text: 'See what is coming up at school.', icon: '<rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/><path d="m9 16 2 2 4-4"/>' });
  if (nextSteps.length < 3 && site.blocks.includes('admissions') && !R.open) nextSteps.push({ href: '#sw-admissions', title: 'How to join', text: 'Our admissions steps, made simple.', icon: '<path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M19 8v6M22 11h-6"/>' });
  if (nextSteps.length < 3 && site.blocks.includes('about')) nextSteps.push({ href: '#about-us', title: 'About the school', text: 'Our story, values and how to reach us.', icon: '<path d="M14 22v-4a2 2 0 1 0-4 0v4"/><path d="m18 10 3.447 1.724a1 1 0 0 1 .553.894V20a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2v-7.382a1 1 0 0 1 .553-.894L6 10"/><path d="M18 5v17"/><path d="m4 6 7.106-3.553a2 2 0 0 1 1.788 0L20 6"/><path d="M6 5v17"/><circle cx="12" cy="9" r="2"/>' });
  const navKeys = site.blocks.filter((k) => !['quickFacts', 'welcome', 'testimonials', 'achievements', 'faq', 'leadership'].includes(k)).slice(0, 6);
  let band = 0;
%>
  <% if (R.open || site.announcements.length) { %>
    <div class="sw-ac-bar"><div class="sw-wrap sw-ac-bar__in">
      <p><% if (R.open) { %><strong>Admissions are open.</strong> Apply online<% if (R.endLabel) { %> before <%= R.endLabel %><% } %>.<% } else { %><%= site.announcements[0] %><% } %></p>
      <a href="<%= R.open ? R.url : '#announcements' %>"><%= R.open ? 'Apply now' : 'All notices' %> <span aria-hidden="true">→</span></a>
    </div></div>
  <% } %>
  <nav class="sw-ac-nav" aria-label="Website sections">
    <div class="sw-wrap sw-ac-nav__in">
      <a class="sw-ac-brand" href="#top">
        <% if (S.logo) { %><img src="<%= publicImageUrl(S.logo, { public: true }) %>" alt="" aria-hidden="true"><% } else { %><span class="sw-ac-brand__initials" aria-hidden="true"><%= S.initials %></span><% } %>
        <span><%= S.name %></span>
      </a>
      <div class="sw-ac-nav__links">
        <% navKeys.forEach((key) => { %><a href="#<%= anchorOf(key) %>"><%= navLabels[key] %></a><% }) %>
      </div>
      <% if (R.open) { %><a class="sw-btn sw-btn--primary sw-ac-nav__cta" href="<%= R.url %>">Apply</a><% } else if (hasContact) { %><a class="sw-btn sw-btn--primary sw-ac-nav__cta" href="#contact">Contact us</a><% } %>
    </div>
  </nav>
  <header class="sw-ac-hero<%= site.slides.length ? '' : ' sw-ac-hero--plain' %>" id="top">
    <% if (site.slides.length) { %><%- slidesHtml('fill') %><% } %>
    <div class="sw-ac-hero__shade" aria-hidden="true"></div>
    <div class="sw-wrap sw-ac-hero__content">
      <% if (B.show) { %>
        <p class="sw-ac-kicker"><%= B.kicker %></p>
        <h1 class="sw-ac-hero__title"><%= S.name %></h1>
        <% if (B.tagline) { %><p class="sw-ac-hero__tagline"><%= B.tagline %></p><% } %>
        <div class="sw-actions">
          <% if (R.open) { %><a class="sw-btn sw-btn--primary" href="<%= R.url %>">Apply now</a><% } %>
          <% if (site.blocks.includes('about')) { %><a class="sw-btn sw-btn--light" href="#about-us">Discover our school</a><% } else if (hasContact) { %><a class="sw-btn sw-btn--light" href="#contact">Contact us</a><% } %>
        </div>
      <% } else { %><h1 class="sw-visually-hidden"><%= S.name %></h1><% } %>
    </div>
  </header>
  <% if (nextSteps.length) { %>
    <section class="sw-ac-next" aria-labelledby="sw-ac-next-title"><div class="sw-wrap">
      <h2 class="sw-ac-next__title" id="sw-ac-next-title">Take the next step</h2>
      <div class="sw-ac-next__grid">
        <% nextSteps.slice(0, 3).forEach((n) => { %>
          <a class="sw-ac-step" href="<%= n.href %>">
            <span class="sw-ac-step__icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><%- n.icon %></svg></span>
            <span class="sw-ac-step__text"><strong><%= n.title %></strong><span><%= n.text %></span></span>
            <span class="sw-ac-step__arrow" aria-hidden="true">→</span>
          </a>
        <% }) %>
      </div>
    </div></section>
  <% } %>
  <main class="sw-main sw-ac-main">
    <% site.blocks.forEach((key) => { %>
      <% if (key === 'quickFacts') { %>
        <div class="sw-ac-band sw-ac-band--photo sw-ac-band--facts"<% if (still(1)) { %> style="--sw-ac-photo: url('<%= still(1) %>')"<% } %>><div class="sw-wrap">
          <p class="sw-ac-band__title"><%= S.name %> at a glance</p>
          <%- block(key) %>
        </div></div>
      <% } else if (key === 'testimonials') { %>
        <div class="sw-ac-band sw-ac-band--quotes"><div class="sw-wrap">
          <%- block(key) %>
          <% if (site.extras.testimonials.items.length > 1) { %>
            <div class="sw-ac-quote-nav"><button type="button" data-sw-scroll="-1" aria-label="Previous">←</button><button type="button" data-sw-scroll="1" aria-label="Next">→</button></div>
          <% } %>
        </div></div>
      <% } else { %>
        <div class="sw-ac-band<%= (band++) % 2 ? ' sw-ac-band--tint' : '' %>"><div class="sw-wrap"><%- block(key) %></div></div>
      <% } %>
    <% }) %>
  </main>
  <section class="sw-ac-band sw-ac-band--photo sw-ac-cta"<% if (still(2)) { %> style="--sw-ac-photo: url('<%= still(2) %>')"<% } %> aria-labelledby="sw-ac-cta-title"><div class="sw-wrap">
    <h2 id="sw-ac-cta-title">Discover <%= S.name %></h2>
    <p><%= B.tagline || 'Come and see what makes our school special.' %></p>
    <div class="sw-actions sw-actions--center">
      <% if (R.open) { %><a class="sw-btn sw-btn--outline-light" href="<%= R.url %>">Apply now</a><% } %>
      <% if (hasContact) { %><a class="sw-btn sw-btn--outline-light" href="#contact">Contact us</a><% } %>
      <% if (site.blocks.includes('events')) { %><a class="sw-btn sw-btn--outline-light" href="#events">Upcoming events</a><% } %>
      <% if (site.blocks.includes('gallery')) { %><a class="sw-btn sw-btn--outline-light" href="#image-gallery">See our gallery</a><% } %>
    </div>
  </div></section>

<% } else if (L === 'classic') { %>
  <!-- CLASSIC: full-width photo stage, school intro band, centered sections -->
  <header class="sw-classic-top">
    <% if (site.slides.length) { %><div class="sw-stage"><%- slidesHtml('cover') %></div><% } %>
    <% if (B.show) { %>
      <div class="sw-wrap sw-intro">
        <%- emblemMark('sw-emblem-mark--intro', 'intro') %>
        <% if (S.logo) { %><img class="sw-intro__logo" src="<%= publicImageUrl(S.logo, { public: true }) %>" alt="" aria-hidden="true"><% } %>
        <div class="sw-intro__text">
          <p class="sw-intro__kicker"><%= B.kicker %></p>
          <h1 class="sw-intro__title"><%= S.name %></h1>
          <% if (B.tagline) { %><p class="sw-intro__tagline"><%= B.tagline %></p><% } %>
        </div>
        <div class="sw-actions sw-intro__actions"><%- ctas() %></div>
      </div>
    <% } else { %><h1 class="sw-visually-hidden"><%= S.name %></h1><% } %>
  </header>
  <% if (R.open) { %>
    <div class="sw-band sw-band--accent"><div class="sw-wrap sw-admit">
      <p><strong>Admissions are open.</strong> Apply online<% if (R.endLabel) { %> before <%= R.endLabel %><% } %>.</p>
      <a class="sw-btn sw-btn--onaccent" href="<%= R.url %>">Start application</a>
    </div></div>
  <% } %>
  <main class="sw-main">
    <% site.blocks.forEach((key, i) => { %>
      <div class="sw-band<%= i % 2 ? ' sw-band--tint sw-emblem-band' : '' %>"><div class="sw-wrap"><%- block(key) %></div></div>
    <% }) %>
  </main>

<% } else if (L === 'horizon') { %>
  <!-- MODERN: split welcome with photos beside it, card sections -->
  <% if (site.announcements.length) { %>
    <div class="sw-ribbon"><div class="sw-wrap"><span class="sw-ribbon__tag">Notice</span><p><%= site.announcements[0] %></p><% if (site.announcements.length > 1) { %><a href="#announcements">All notices</a><% } %></div></div>
  <% } %>
  <header class="sw-wrap sw-hero sw-hero--horizon<%= B.show ? '' : ' sw-hero--photos-only' %>">
    <% if (B.show) { %>
      <div class="sw-hero__copy">
        <p class="sw-hero__kicker"><%= B.kicker %></p>
        <h1 class="sw-hero__title"><%= S.name %></h1>
        <% if (B.tagline) { %><p class="sw-hero__tagline"><%= B.tagline %></p><% } %>
        <div class="sw-actions"><%- ctas() %></div>
        <% if (site.extras.quickFacts) { %>
          <dl class="sw-hero__facts">
            <% site.extras.quickFacts.items.slice(0, 3).forEach((f) => { %><div><dt><%= f.value %></dt><dd><%= f.label %></dd></div><% }) %>
          </dl>
        <% } %>
      </div>
    <% } else { %><h1 class="sw-visually-hidden"><%= S.name %></h1><% } %>
    <% if (site.slides.length) { %><div class="sw-hero__media"><%- slidesHtml('card') %></div><% } %>
  </header>
  <main class="sw-wrap sw-main sw-main--cards">
    <% site.blocks.filter((k) => !(k === 'quickFacts' && B.show)).forEach((key) => { %><%- block(key) %><% }) %>
  </main>

<% } else if (L === 'editorial') { %>
  <!-- MAGAZINE: masthead, front page, side column -->
  <header class="sw-wrap sw-masthead">
    <div class="sw-masthead__rule">
      <span><%= new Date().toLocaleDateString('en-US', { weekday: 'long', month: 'long', day: 'numeric', year: 'numeric' }) %></span>
      <span><%= B.kicker %></span>
    </div>
    <% if (B.show) { %>
      <h1 class="sw-masthead__title"><%= S.name %></h1>
      <% if (B.tagline) { %><p class="sw-masthead__tagline"><%= B.tagline %></p><% } %>
    <% } else { %><h1 class="sw-visually-hidden"><%= S.name %></h1><% } %>
    <nav class="sw-masthead__nav" aria-label="Sections">
      <% site.blocks.filter((k) => k !== 'quickFacts').forEach((key) => { %><a href="#<%= anchorOf(key) %>"><%= navLabels[key] %></a><% }) %>
    </nav>
  </header>
  <% if (site.slides.length || R.open) { %>
    <section class="sw-wrap sw-front" aria-label="Front page">
      <% if (site.slides.length) { %><div class="sw-front__lead"><%- slidesHtml('card') %></div><% } %>
      <div class="sw-front__side">
        <% if (R.open) { %>
          <div class="sw-front__box sw-front__box--accent"><p class="sw-front__label">Admissions</p><p>Applications are open<% if (R.endLabel) { %> until <strong><%= R.endLabel %></strong><% } %>.</p><a class="sw-btn sw-btn--onaccent" href="<%= R.url %>">Apply now</a></div>
        <% } %>
        <% if (site.articles[0]) { %>
          <a class="sw-front__box" href="#text-articles"><p class="sw-front__label">Top story</p><h2><%= site.articles[0].title || 'Latest news' %></h2><p><%= site.articles[0].excerpt %></p></a>
        <% } %>
      </div>
    </section>
  <% } %>
  <div class="sw-wrap sw-paper">
    <main class="sw-paper__main">
      <% site.blocks.filter((k) => !['events', 'announcements'].includes(k)).forEach((key) => { %><%- block(key) %><% }) %>
    </main>
    <% if (site.blocks.includes('events') || site.blocks.includes('announcements')) { %>
      <aside class="sw-paper__aside">
        <% ['events', 'announcements'].filter((k) => site.blocks.includes(k)).forEach((key) => { %><%- block(key) %><% }) %>
      </aside>
    <% } %>
  </div>

<% } else if (L === 'story') { %>
  <!-- STORY: large opening photo, numbered chapters, events timeline -->
  <header class="sw-hero sw-hero--story<%= site.slides.length ? '' : ' sw-hero--plain' %>">
    <%- site.slides.length ? slidesHtml('cover') : '' %>
    <div class="sw-hero__overlay">
      <% if (B.show) { %>
        <p class="sw-hero__kicker"><%= B.kicker %></p>
        <h1 class="sw-hero__title"><%= S.name %></h1>
        <% if (B.tagline) { %><p class="sw-hero__tagline"><%= B.tagline %></p><% } %>
        <div class="sw-actions"><%- ctas() %></div>
      <% } else { %><h1 class="sw-visually-hidden"><%= S.name %></h1><% } %>
    </div>
  </header>
  <main class="sw-main sw-chapters" id="sw-chapters">
    <% let chapter = 0; site.blocks.forEach((key) => { const n = key === 'quickFacts' ? 0 : ++chapter; %>
      <div class="sw-chapter<%= key === 'quickFacts' ? ' sw-chapter--facts' : '' %>"><div class="sw-wrap"><%- block(key, n) %></div></div>
    <% }) %>
  </main>

<% } else if (L === 'spotlight') { %>
  <!-- SPOTLIGHT: brand-color welcome beside the photos, alternating rows -->
  <header class="sw-spot-hero<%= B.show ? '' : ' sw-spot-hero--photos' %><%= site.slides.length ? '' : ' sw-spot-hero--text' %>">
    <% if (B.show) { %>
      <div class="sw-spot-hero__panel">
        <%- emblemMark('sw-emblem-mark--panel', 'panel') %>
        <% if (S.logo) { %><img class="sw-spot-hero__logo" src="<%= publicImageUrl(S.logo, { public: true }) %>" alt="" aria-hidden="true"><% } %>
        <p class="sw-hero__kicker"><%= B.kicker %></p>
        <h1 class="sw-spot-hero__title"><%= S.name %></h1>
        <% if (B.tagline) { %><p class="sw-spot-hero__tagline"><%= B.tagline %></p><% } %>
        <div class="sw-actions"><%- ctas() %></div>
      </div>
    <% } else { %><h1 class="sw-visually-hidden"><%= S.name %></h1><% } %>
    <% if (site.slides.length) { %><div class="sw-spot-hero__media"><%- slidesHtml('cover') %></div><% } %>
  </header>
  <main class="sw-main">
    <% site.blocks.forEach((key, i) => { %>
      <div class="sw-band<%= key === 'quickFacts' ? ' sw-band--facts sw-emblem-band' : (i % 2 ? ' sw-band--tint sw-emblem-band' : '') %>"><div class="sw-wrap"><%- block(key) %></div></div>
    <% }) %>
  </main>

<% } else if (L === 'minimal') { %>
  <!-- MINIMAL: text-first, headings in a left column -->
  <header class="sw-wrap sw-min-head">
    <% if (B.show) { %>
      <p class="sw-hero__kicker"><%= B.kicker %></p>
      <h1 class="sw-min-head__title"><%= S.name %></h1>
      <% if (B.tagline) { %><p class="sw-min-head__tagline"><%= B.tagline %></p><% } %>
      <div class="sw-actions"><%- ctas() %></div>
    <% } else { %><h1 class="sw-visually-hidden"><%= S.name %></h1><% } %>
    <% if (site.slides.length) { %><div class="sw-min-head__photos"><%- slidesHtml('card') %></div><% } %>
  </header>
  <main class="sw-wrap sw-main sw-min-main">
    <% site.blocks.forEach((key) => { %><%- block(key) %><% }) %>
  </main>

<% } else if (L === 'mosaic') { %>
  <!-- MOSAIC: a grid of tiles -->
  <div class="sw-wrap sw-mosaic">
    <header class="sw-mosaic__top">
      <% if (site.slides.length) { %><div class="sw-tile sw-tile--photos"><%- slidesHtml('cover') %></div><% } %>
      <% if (B.show) { %>
        <div class="sw-tile sw-tile--brand">
          <p class="sw-hero__kicker"><%= B.kicker %></p>
          <h1 class="sw-mosaic__title"><%= S.name %></h1>
          <% if (B.tagline) { %><p class="sw-mosaic__tagline"><%= B.tagline %></p><% } %>
          <div class="sw-actions"><%- ctas() %></div>
        </div>
      <% } else { %><h1 class="sw-visually-hidden"><%= S.name %></h1><% } %>
      <% site.gallery.slice(0, 2).forEach((img, i) => { %>
        <a class="sw-tile sw-tile--peek" href="#image-gallery" aria-label="See the gallery"><%- include('./photo', { site, src: img.url, alt: img.caption || 'School photo', cls: 'sw-tile__photo' }) %></a>
      <% }) %>
    </header>
    <main class="sw-main sw-mosaic__grid">
      <% site.blocks.forEach((key) => { %><div class="sw-tile sw-tile--<%= key %>"><%- block(key) %></div><% }) %>
    </main>
  </div>

<% } else if (L === 'glide') {
  /* GLIDE (3D, simple): the title, then the photos on a screen that tilts into
     place in 3D as visitors scroll; sections float in softly on white. */
%>
  <%- include('./motionNav', { site, variant: 'light' }) %>
  <header class="sw-gl-hero" id="top">
    <div class="sw-wrap sw-gl-hero__copy">
      <% if (B.show) { %>
        <p class="sw-gl-kicker"><%= B.kicker %></p>
        <h1 class="sw-gl-title"><%= S.name %></h1>
        <% if (B.tagline) { %><p class="sw-gl-tagline"><%= B.tagline %></p><% } %>
        <div class="sw-actions sw-actions--center"><%- ctas() %></div>
      <% } else { %><h1 class="sw-visually-hidden"><%= S.name %></h1><% } %>
    </div>
    <div class="sw-wrap sw-gl-stage" data-mp data-mp-from="0.9" data-mp-to="0.12">
      <div class="sw-gl-screen<%= site.slides.length ? '' : ' sw-gl-screen--brand' %>">
        <% if (site.slides.length) { %><%- slidesHtml('card') %><% } else { %>
          <div class="sw-gl-brand" aria-hidden="true">
            <% if (S.logo) { %><img src="<%= publicImageUrl(S.logo, { public: true }) %>" alt=""><% } else { %><span class="sw-gl-brand__initials"><%= S.initials %></span><% } %>
            <strong><%= S.name %></strong>
            <% if (S.motto) { %><em><%= S.motto %></em><% } %>
          </div>
        <% } %>
      </div>
    </div>
  </header>
  <main class="sw-main sw-gl-main">
    <% site.blocks.forEach((key, i) => { %>
      <div class="sw-gl-band<%= key === 'quickFacts' ? ' sw-gl-band--facts' : (i % 2 ? ' sw-gl-band--tint' : '') %>" data-m><div class="sw-wrap"><%- block(key) %></div></div>
    <% }) %>
  </main>
  <% if (ctas()) { %>
    <section class="sw-gl-close" aria-labelledby="sw-gl-close-title"><div class="sw-wrap" data-m-items>
      <h2 class="sw-gl-close__title" id="sw-gl-close-title">Come and see <%= S.name %></h2>
      <p class="sw-gl-close__text"><%= B.tagline || 'We would love to welcome you and your family.' %></p>
      <div class="sw-actions sw-actions--center"><%- ctas() %></div>
    </div></section>
  <% } %>

<% } else if (L === 'prism') {
  /* PRISM (3D, very modern): glass panels over a glow in the school's color, a
     3D stack of photos that fans out as visitors scroll, and a photo wall that
     straightens as it comes into view. */
  const firstSlide = site.slides[0] ? (site.slides[0].type === 'video' ? site.slides[0].poster : site.slides[0].url) : '';
  const backPhotos = [...new Set(site.stills)].filter((u) => u !== firstSlide).slice(0, 3);
  const heroFacts = B.show && site.extras.quickFacts ? site.extras.quickFacts.items.slice(0, 3) : [];
%>
  <div class="sw-pr-glow" aria-hidden="true"><i></i><i></i><i></i><%- emblemMark('sw-or-emblem', 'orbit', ' data-sw-orbit') %></div>
  <%- include('./motionNav', { site, variant: 'glass' }) %>
  <header class="sw-pr-hero sw-emblem-band" id="top" data-mp data-mp-from="0.3" data-mp-to="-0.6">
    <div class="sw-wrap sw-pr-hero__in<%= B.show ? '' : ' sw-pr-hero__in--photos' %>">
      <% if (B.show) { %>
        <div class="sw-pr-hero__copy">
          <p class="sw-pr-kicker"><span class="sw-pr-kicker__dot" aria-hidden="true"></span><%= B.kicker %></p>
          <h1 class="sw-pr-title"><%= S.name %></h1>
          <% if (B.tagline) { %><p class="sw-pr-tagline"><%= B.tagline %></p><% } %>
          <div class="sw-actions"><%- ctas() %></div>
          <% if (heroFacts.length) { %>
            <dl class="sw-pr-hero__facts"><% heroFacts.forEach((f) => { %><div><dt class="sw-fact__value"><%= f.value %></dt><dd><%= f.label %></dd></div><% }) %></dl>
          <% } %>
        </div>
      <% } else { %><h1 class="sw-visually-hidden"><%= S.name %></h1><% } %>
      <div class="sw-pr-stage" data-m-tilt>
        <div class="sw-pr-stack" style="--n: <%= backPhotos.length %>">
          <% backPhotos.slice().reverse().forEach((src, j) => { %>
            <div class="sw-pr-card sw-pr-card--back" style="--k: <%= backPhotos.length - j %>" aria-hidden="true"><%- include('./photo', { site, src, alt: '', cls: 'sw-pr-card__photo' }) %></div>
          <% }) %>
          <div class="sw-pr-card sw-pr-card--front" style="--k: 0">
            <% if (site.slides.length) { %><%- slidesHtml('card') %><% } else { %>
              <div class="sw-pr-crest" aria-hidden="true">
                <% if (S.logo) { %><img src="<%= publicImageUrl(S.logo, { public: true }) %>" alt=""><% } else { %><span class="sw-pr-crest__initials"><%= S.initials %></span><% } %>
                <strong><%= S.name %></strong>
                <% if (S.motto) { %><em><%= S.motto %></em><% } %>
              </div>
            <% } %>
          </div>
        </div>
      </div>
    </div>
  </header>
  <main class="sw-main sw-pr-main">
    <% site.blocks.filter((k) => !(k === 'quickFacts' && heroFacts.length)).forEach((key) => { %>
      <% if (key === 'gallery') { %>
        <% const wallCount = Math.min(12, site.gallery.length); const wallCols = ({ 1: 1, 2: 2, 3: 3, 4: 4, 5: 3, 6: 3, 7: 4, 8: 4, 9: 3, 10: 5, 11: 4, 12: 4 })[wallCount] || 4; %>
        <div class="sw-pr-band sw-pr-band--wall"><div class="sw-wrap sw-pr-wall" data-mp data-mp-from="1.05" data-mp-to="0.1" style="--wall-cols: <%= wallCols %>; --wall-cols-m: <%= Math.min(wallCols, 3) %>; --wall-cols-s: <%= Math.min(wallCols, 2) %>"><%- block(key) %></div></div>
      <% } else { %>
        <div class="sw-pr-band"><div class="sw-wrap"><div class="sw-pr-panel sw-pr-panel--<%= key %>" data-m="panel"><%- block(key) %></div></div></div>
      <% } %>
    <% }) %>
  </main>
  <% if (ctas()) { %>
    <section class="sw-pr-close" aria-labelledby="sw-pr-close-title"><div class="sw-wrap"><div class="sw-pr-close__panel" data-m="panel" data-m-items>
      <h2 class="sw-pr-close__title" id="sw-pr-close-title">Your place at <%= S.name %></h2>
      <p class="sw-pr-close__text"><%= B.tagline || 'Come and see what makes our school special.' %></p>
      <div class="sw-actions sw-actions--center"><%- ctas() %></div>
    </div></div></section>
  <% } %>

<% } else if (L === 'panorama') {
  /* PANORAMA (3D, bold): a full-screen opening where the photo opens out to fill
     the screen, numbered chapters that turn into view, and a gallery that sweeps
     sideways in 3D as visitors scroll. */
  let chapter = 0;
  let tone = 0;
  const closingPhoto = site.stills.length ? site.stills[site.stills.length > 1 ? 1 : 0] : '';
  const dotKeys = site.blocks.filter((k) => k !== 'quickFacts');
%>
  <%- include('./motionNav', { site, variant: 'dark' }) %>
  <section class="sw-pa-hero<%= site.slides.length ? '' : ' sw-pa-hero--plain' %>" id="top"<%- site.slides.length ? ' data-mp="pin"' : '' %>>
    <div class="sw-pa-hero__stage">
      <% if (site.slides.length) { %><div class="sw-pa-hero__frame"><%- slidesHtml('cover') %></div><% } %>
      <div class="sw-pa-hero__shade" aria-hidden="true"></div>
      <div class="sw-wrap sw-pa-hero__copy">
        <% if (B.show) { %>
          <p class="sw-pa-kicker"><%= B.kicker %></p>
          <h1 class="sw-pa-title"><%= S.name %></h1>
          <% if (B.tagline) { %><p class="sw-pa-tagline"><%= B.tagline %></p><% } %>
          <div class="sw-actions"><%- ctas() %></div>
        <% } else { %><h1 class="sw-visually-hidden"><%= S.name %></h1><% } %>
      </div>
      <% if (site.slides.length) { %><span class="sw-pa-hint" aria-hidden="true"><i></i>Scroll</span><% } %>
    </div>
  </section>
  <% if (dotKeys.length > 1) { %>
    <nav class="sw-pa-dots" aria-label="Chapters">
      <% dotKeys.forEach((key) => { %><a href="#<%= anchorOf(key) %>" data-sw-dot="<%= key %>"><span><%= navLabels[key] %></span></a><% }) %>
    </nav>
  <% } %>
  <main class="sw-main sw-pa-main">
    <% site.blocks.forEach((key) => { %>
      <% if (key === 'gallery') { %>
        <div class="sw-pa-flow" data-sw-flow data-mp="pin"><div class="sw-pa-flow__stage"><div class="sw-wrap"><%- block(key, ++chapter) %></div></div></div>
      <% } else if (key === 'quickFacts') { %>
        <div class="sw-pa-scene sw-pa-scene--accent" data-m><div class="sw-wrap"><%- block(key) %></div></div>
      <% } else { %>
        <div class="sw-pa-scene sw-pa-scene--<%= (tone++) % 2 ? 'ink' : 'paper' %>" data-m><div class="sw-wrap"><%- block(key, ++chapter) %></div></div>
      <% } %>
    <% }) %>
  </main>
  <% if (ctas()) { %>
    <section class="sw-pa-close<%= closingPhoto ? '' : ' sw-pa-close--plain' %>" aria-labelledby="sw-pa-close-title" data-mp>
      <% if (closingPhoto) { %><div class="sw-pa-close__photo" aria-hidden="true"><%- include('./photo', { site, src: closingPhoto, alt: '', cls: 'sw-pa-close__img', fit: 'hero' }) %></div><% } %>
      <div class="sw-wrap sw-pa-close__copy" data-m-items>
        <h2 class="sw-pa-close__title" id="sw-pa-close-title">Discover <%= S.name %></h2>
        <p class="sw-pa-close__text"><%= B.tagline || 'Come and see what makes our school special.' %></p>
        <div class="sw-actions"><%- ctas() %></div>
      </div>
    </section>
  <% } %>

<% } else { %>
  <!-- CAMPUS: side navigation with the school's details -->
  <div class="sw-campus">
    <aside class="sw-campus__side" aria-label="School">
      <div class="sw-campus__brand">
        <% if (S.logo) { %><img src="<%= publicImageUrl(S.logo, { public: true }) %>" alt="" aria-hidden="true"><% } else { %><span class="sw-campus__initials" aria-hidden="true"><%= S.initials %></span><% } %>
        <p class="sw-campus__name"><%= S.name %></p>
        <% if (S.motto) { %><p class="sw-campus__motto"><%= S.motto %></p><% } %>
      </div>
      <nav class="sw-campus__nav" aria-label="Sections">
        <% site.blocks.forEach((key) => { %><a href="#<%= anchorOf(key) %>"><%= navLabels[key] %></a><% }) %>
      </nav>
      <div class="sw-campus__contact">
        <% if (S.phones[0]) { %><a href="tel:<%= String(S.phones[0]).replace(/[^+\d]/g, '') %>"><%= S.phones[0] %></a><% } %>
        <% if (S.emails[0]) { %><a href="mailto:<%= S.emails[0] %>"><%= S.emails[0] %></a><% } %>
        <% if (R.open) { %><a class="sw-btn sw-btn--primary" href="<%= R.url %>">Apply now</a><% } %>
      </div>
    </aside>
    <div class="sw-campus__main">
      <% if (B.show) { %>
        <header class="sw-campus__intro">
          <p class="sw-hero__kicker"><%= B.kicker %></p>
          <h1 class="sw-hero__title"><%= S.name %></h1>
          <% if (B.tagline) { %><p class="sw-hero__tagline"><%= B.tagline %></p><% } %>
        </header>
      <% } else { %><h1 class="sw-visually-hidden"><%= S.name %></h1><% } %>
      <% if (site.slides.length) { %><div class="sw-campus__photos"><%- slidesHtml('card') %></div><% } %>
      <main class="sw-main"><% site.blocks.forEach((key) => { %><%- block(key) %><% }) %></main>
    </div>
  </div>
<% } %>

  <%
    const socialIcon = (s) => {
      const k = (String(s.label || '') + ' ' + String(s.url || '')).toLowerCase();
      if (/facebook|fb\.com/.test(k)) return '<path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/>';
      if (/instagram/.test(k)) return '<rect x="2" y="2" width="20" height="20" rx="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><path d="M17.5 6.5h.01"/>';
      if (/youtube|youtu\.be/.test(k)) return '<path d="M2.5 17a24.12 24.12 0 0 1 0-10 2 2 0 0 1 1.4-1.4 49.56 49.56 0 0 1 16.2 0A2 2 0 0 1 21.5 7a24.12 24.12 0 0 1 0 10 2 2 0 0 1-1.4 1.4 49.55 49.55 0 0 1-16.2 0A2 2 0 0 1 2.5 17"/><path d="m10 15 5-3-5-3z"/>';
      if (/linkedin/.test(k)) return '<path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-4 0v7h-4v-7a6 6 0 0 1 6-6z"/><rect x="2" y="9" width="4" height="12"/><circle cx="4" cy="4" r="2"/>';
      if (/twitter|x\.com|\bx\b/.test(k)) return '<path d="M4 4l16 16M20 4 4 20"/>';
      if (/tiktok/.test(k)) return '<path d="M9 12a4 4 0 1 0 4 4V4a5 5 0 0 0 5 5"/>';
      if (/whatsapp|wa\.me/.test(k)) return '<path d="M3 21l1.65-3.8a9 9 0 1 1 3.4 2.9z"/><path d="M9 10a.5.5 0 0 0 1 0V9a.5.5 0 0 0-1 0v1a5 5 0 0 0 5 5h1a.5.5 0 0 0 0-1h-1a.5.5 0 0 0 0 1"/>';
      return '<circle cx="12" cy="12" r="10"/><path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"/><path d="M2 12h20"/>';
    };
    const footerLinks = site.blocks.filter((k) => k !== 'quickFacts').slice(0, 8);
  %>
  <footer class="sw-footer">
    <div class="sw-wrap sw-footer__grid">
      <div class="sw-footer__brand">
        <div class="sw-footer__id">
          <% if (S.logo) { %><img class="sw-footer__logo" src="<%= publicImageUrl(S.logo, { public: true }) %>" alt="" aria-hidden="true"><% } %>
          <div><p class="sw-footer__name"><%= S.name %></p><% if (S.motto) { %><p class="sw-footer__motto"><%= S.motto %></p><% } %></div>
        </div>
        <% if (site.social.length) { %>
          <ul class="sw-social" aria-label="Follow us">
            <% site.social.forEach((s) => { %><li><a href="<%= s.url %>" target="_blank" rel="noopener noreferrer" aria-label="<%= s.label %>" title="<%= s.label %>"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><%- socialIcon(s) %></svg></a></li><% }) %>
          </ul>
        <% } %>
      </div>
      <div class="sw-footer__col">
        <p class="sw-footer__head">Contact</p>
        <% if (S.address) { %><p><%= S.address %></p><% } %>
        <% S.phones.forEach((p) => { %><p><a href="tel:<%= String(p).replace(/[^+\d]/g, '') %>"><%= p %></a></p><% }) %>
        <% S.emails.forEach((e) => { %><p><a href="mailto:<%= e %>"><%= e %></a></p><% }) %>
      </div>
      <% if (footerLinks.length) { %>
        <div class="sw-footer__col">
          <p class="sw-footer__head">Explore</p>
          <ul class="sw-footer__links">
            <% footerLinks.forEach((key) => { %><li><a href="#<%= anchorOf(key) %>"><%= navLabels[key] %></a></li><% }) %>
          </ul>
        </div>
      <% } %>
      <div class="sw-footer__col">
        <p class="sw-footer__head">Join us</p>
        <p><%= R.open ? 'Applications are open' + (R.endLabel ? ' until ' + R.endLabel : '') + '.' : 'We would love to hear from you.' %></p>
        <div class="sw-footer__cta">
          <% if (R.open) { %><a class="sw-btn sw-btn--primary" href="<%= R.url %>">Apply now</a><% } %>
          <% if (hasContact) { %><a class="sw-btn sw-btn--outline-light" href="#contact">Contact us</a><% } %>
        </div>
      </div>
    </div>
    <div class="sw-wrap sw-footer__legal">
      <p>© <%= site.year %> <%= S.name %>. All rights reserved.</p>
      <p>Powered by <a href="https://managira.com" target="_blank" rel="noopener">Managira</a></p>
    </div>
  </footer>

  <div class="sw-lightbox" id="swLightbox" hidden role="dialog" aria-modal="true" aria-label="Photo viewer">
    <button type="button" class="sw-lightbox__close" data-sw-close aria-label="Close">×</button>
    <button type="button" class="sw-lightbox__nav sw-lightbox__nav--prev" data-sw-step="-1" aria-label="Previous photo">‹</button>
    <figure><img alt=""><video controls playsinline hidden></video><figcaption></figcaption></figure>
    <button type="button" class="sw-lightbox__nav sw-lightbox__nav--next" data-sw-step="1" aria-label="Next photo">›</button>
  </div>
</div>

<script>
  (function () {
    var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;

<% if (site.wholePhotos) { %>
    // Whole photos (views/partials/website/photo.ejs): a photo fills its frame only when
    // its shape is close to the frame's; otherwise it shows whole over a blurred copy.
    var FIT_LIMITS = { photo: 0.12, person: 0.3, hero: 0.22 };
    function fitPhoto(frame) {
      var media = frame.querySelector('.sw-photo__img, .sw-slide__img');
      if (!media) return;
      var w = media.naturalWidth || media.videoWidth, h = media.naturalHeight || media.videoHeight;
      var fw = frame.clientWidth, fh = frame.clientHeight;
      if (!w || !h || !fw || !fh) return;
      var a = w / h, b = fw / fh;
      var cut = 1 - Math.min(a, b) / Math.max(a, b);
      frame.classList.toggle('is-fill', cut <= (FIT_LIMITS[frame.getAttribute('data-sw-photo')] || 0.1));
    }
    var photoFrames = document.querySelectorAll('[data-sw-photo]');
    if (photoFrames.length) {
      var frameWatch = 'ResizeObserver' in window ? new ResizeObserver(function (list) { list.forEach(function (entry) { fitPhoto(entry.target); }); }) : null;
      photoFrames.forEach(function (frame) {
        var media = frame.querySelector('.sw-photo__img, .sw-slide__img');
        if (!media) return;
        var check = function () { fitPhoto(frame); };
        if (media.tagName === 'VIDEO') { if (media.readyState >= 1) check(); else media.addEventListener('loadedmetadata', check); }
        else if (media.complete && media.naturalWidth) check();
        else media.addEventListener('load', check);
        if (frameWatch) frameWatch.observe(frame);
      });
    }
<% } %>

    // Photo/video slider(s): photos change every 6 seconds, a video plays to its
    // end and then moves on. Arrows, dots and a pause button (kept paused once used).
    document.querySelectorAll('[data-sw-slider]').forEach(function (slider) {
      var slides = slider.querySelectorAll('.sw-slide');
      var dots = slider.querySelectorAll('.sw-slider__dot');
      var pauseBtn = slider.querySelector('[data-sw-pause]');
      var index = 0, timer = null, paused = reduce, hovering = false;
      function videoOf(i) { return slides[i] && slides[i].querySelector('video'); }
      function schedule() {
        if (timer) clearTimeout(timer); timer = null;
        var video = videoOf(index);
        if (video) {
          if (paused) { video.pause(); return; }
          video.play().catch(function () {});
          return; // moves on when it ends
        }
        if (!paused && !hovering && slides.length > 1) timer = setTimeout(function () { show(index + 1); }, 6000);
      }
      function show(n) {
        var before = videoOf(index);
        index = (n + slides.length) % slides.length;
        slides.forEach(function (s, i) { s.classList.toggle('is-active', i === index); s.setAttribute('aria-hidden', i === index ? 'false' : 'true'); });
        dots.forEach(function (d, i) { d.classList.toggle('is-active', i === index); d.setAttribute('aria-current', i === index ? 'true' : 'false'); });
        if (before && before !== videoOf(index)) before.pause();
        var now = videoOf(index);
        if (now) { if (now.preload === 'none') now.preload = 'auto'; try { now.currentTime = 0; } catch (e) {} }
        schedule();
      }
      slides.forEach(function (s, i) {
        var v = s.querySelector('video');
        if (v) v.addEventListener('ended', function () { if (i === index && slides.length > 1) show(index + 1); });
      });
      var prev = slider.querySelector('[data-sw-prev]'), next = slider.querySelector('[data-sw-next]');
      if (prev) prev.addEventListener('click', function () { show(index - 1); });
      if (next) next.addEventListener('click', function () { show(index + 1); });
      dots.forEach(function (d, i) { d.addEventListener('click', function () { show(i); }); });
      if (pauseBtn) {
        var label = function () { pauseBtn.setAttribute('aria-pressed', paused ? 'true' : 'false'); pauseBtn.setAttribute('aria-label', paused ? 'Play' : 'Pause'); pauseBtn.classList.toggle('is-paused', paused); };
        pauseBtn.addEventListener('click', function () { paused = !paused; label(); schedule(); });
        label();
      }
      slider.addEventListener('mouseenter', function () { hovering = true; if (!videoOf(index)) schedule(); });
      slider.addEventListener('mouseleave', function () { hovering = false; schedule(); });
      show(0);
    });

    // Gallery photo viewer.
    var box = document.getElementById('swLightbox');
    var items = Array.prototype.slice.call(document.querySelectorAll('[data-sw-lightbox]'));
    if (box && items.length) {
      var img = box.querySelector('img'), vid = box.querySelector('video'), cap = box.querySelector('figcaption'), current = 0, opener = null;
      function open(i) {
        current = (i + items.length) % items.length;
        var item = items[current];
        var src = item.querySelector('.sw-photo__img') || item.querySelector('img');
        var caption = item.closest('figure').querySelector('figcaption');
        vid.pause();
        if (item.dataset.swVideo) {
          img.hidden = true; vid.hidden = false;
          vid.poster = src ? src.src : ''; vid.src = item.dataset.swVideo; vid.play().catch(function () {});
        } else {
          vid.hidden = true; vid.removeAttribute('src');
          img.hidden = false; img.src = src.src; img.alt = src.alt;
        }
        cap.textContent = caption ? caption.textContent : '';
        box.hidden = false; document.body.style.overflow = 'hidden';
        box.querySelector('[data-sw-close]').focus();
      }
      function close() { vid.pause(); box.hidden = true; document.body.style.overflow = ''; if (opener) opener.focus(); }
      items.forEach(function (btn, i) { btn.addEventListener('click', function () { opener = btn; open(i); }); });
      // The 3D designs show the first photos; "See more photos" opens the rest in the viewer.
      document.querySelectorAll('[data-sw-lightbox-more]').forEach(function (btn) {
        btn.addEventListener('click', function () { opener = btn; open(Number(btn.getAttribute('data-sw-lightbox-more')) || 0); });
      });
      box.addEventListener('click', function (e) {
        if (e.target === box || e.target.closest('[data-sw-close]')) close();
        var step = e.target.closest('[data-sw-step]');
        if (step) open(current + Number(step.dataset.swStep));
      });
      document.addEventListener('keydown', function (e) {
        if (box.hidden) return;
        if (e.key === 'Escape') close();
        else if (e.key === 'ArrowRight') open(current + 1);
        else if (e.key === 'ArrowLeft') open(current - 1);
      });
    }

    // Campus: highlight the side-menu link for the section in view.
    var sideLinks = Array.prototype.slice.call(document.querySelectorAll('.sw-campus__nav a[href^="#"]'));
    if (sideLinks.length && 'IntersectionObserver' in window) {
      var byId = {};
      sideLinks.forEach(function (a) { byId[a.getAttribute('href').slice(1)] = a; });
      var spy = new IntersectionObserver(function (entries) {
        entries.forEach(function (entry) {
          if (!entry.isIntersecting) return;
          var section = entry.target.closest('[data-sw-block]');
          var anchor = section && (section.querySelector('.sw-anchor') || section);
          var link = anchor && byId[anchor.id];
          if (!link) return;
          sideLinks.forEach(function (a) { a.classList.toggle('is-active', a === link); });
        });
      }, { rootMargin: '-40% 0px -55% 0px' });
      document.querySelectorAll('.sw-campus [data-sw-block]').forEach(function (el) { spy.observe(el); });
    }

    // Menu links only for sections that are on this page.
    document.querySelectorAll('.sticky-nav a[href^="#"]').forEach(function (link) {
      var target = document.getElementById(link.getAttribute('href').slice(1));
      if (!target) (link.closest('li') || link).style.display = 'none';
    });

    // Academy: one testimonial at a time, with arrows.
    document.querySelectorAll('[data-sw-scroll]').forEach(function (btn) {
      btn.addEventListener('click', function () {
        var track = btn.closest('.sw-wrap').querySelector('.sw-quotes');
        if (track) track.scrollBy({ left: Number(btn.dataset.swScroll) * track.clientWidth, behavior: reduce ? 'auto' : 'smooth' });
      });
    });

    // Contact form.
    var form = document.getElementById('swContactForm');
    if (!form) return;
    var status = document.getElementById('swContactStatus');
    form.addEventListener('submit', async function (event) {
      event.preventDefault();
      var data = new FormData(form);
      var name = String(data.get('name') || '').trim();
      var message = String(data.get('message') || '').trim();
      var email = String(data.get('email') || '').trim();
      var phone = String(data.get('phone') || '').trim();
      status.className = 'sw-form-status';
      if (!name || !message) { status.textContent = 'Please add your name and a message.'; status.classList.add('is-error'); return; }
      if (!email && !phone) { status.textContent = 'Please add an email address or phone number so the school can reply.'; status.classList.add('is-error'); return; }
      var button = form.querySelector('.sw-contact__submit');
      button.disabled = true; button.textContent = 'Sending…';
      try {
        var response = await fetch(form.action, { method: 'POST', headers: { 'Content-Type': 'application/x-www-form-urlencoded', Accept: 'application/json' }, body: new URLSearchParams(data) });
        var result = await response.json().catch(function () { return {}; });
        status.textContent = result.message || (response.ok ? 'Thank you - your message has been sent.' : 'Your message could not be sent. Please try again.');
        status.classList.add(response.ok ? 'is-ok' : 'is-error');
        if (response.ok) form.reset();
      } catch (error) {
        status.textContent = 'Your message could not be sent. Please check your connection and try again.';
        status.classList.add('is-error');
      } finally {
        button.disabled = false; button.textContent = 'Send message';
      }
    });
  })();
</script>
