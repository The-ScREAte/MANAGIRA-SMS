<%#
  Emergency & pickup details the school shares with families (feature
  "family_sharing"; the school picks who sees each section in Admissions >
  Admission Settings > Parents & guardians). Parents see and update their own
  (/guardian/family-details); students see their parents' (/student/family-details).
  Shows nothing until something is shared.  locals: mode ("parent" | "student")
%>
<% if (locals.featureOn && featureOn('family_sharing')) { %>
<section class="fd" id="familyDetails" data-mode="<%= mode %>" hidden aria-live="polite"></section>
<style>
  .fd { margin: 14px 0; }
  .fd-card { padding: 16px 18px; border: 1px solid #e5e9ef; border-radius: 16px; background: #fff; }
  .fd-card + .fd-card { margin-top: 12px; }
  .fd-head { display: flex; align-items: center; gap: 12px; }
  .fd-icon { flex: none; display: grid; place-items: center; width: 40px; height: 40px; border-radius: 12px; color: var(--org-primary-color, var(--primary, #0f5a66)); background: color-mix(in srgb, var(--org-primary-color, var(--primary, #0f5a66)) 11%, #fff); }
  .fd-icon svg { width: 20px; height: 20px; }
  .fd-title { flex: 1; min-width: 0; }
  .fd-title h2 { margin: 0; font-size: 1rem; font-weight: 800; color: #0f172a; text-align: left; }
  .fd-title p { margin: 2px 0 0; font-size: .82rem; color: #64748b; }
  .fd-btn { flex: none; display: inline-flex; align-items: center; gap: 6px; height: 36px; padding: 0 14px; border-radius: 10px; border: 1px solid color-mix(in srgb, var(--org-primary-color, var(--primary, #0f5a66)) 40%, #fff); background: #fff; color: var(--org-primary-color, var(--primary, #0f5a66)); font: inherit; font-size: .85rem; font-weight: 700; cursor: pointer; }
  .fd-btn--primary { border-color: transparent; background: var(--org-primary-color, var(--primary, #0f5a66)); color: #fff; }
  .fd-btn[disabled] { opacity: .6; cursor: progress; }
  .fd-list { margin: 12px 0 0; display: grid; gap: 0; }
  .fd-row { display: grid; grid-template-columns: minmax(0, 2fr) minmax(0, 3fr); gap: 12px; padding: 9px 0; border-top: 1px solid #f0f2f5; font-size: .9rem; }
  .fd-row dt { color: #64748b; font-weight: 600; }
  .fd-row dd { margin: 0; color: #0f172a; font-weight: 600; white-space: pre-line; overflow-wrap: anywhere; }
  .fd-row dd.is-empty { color: #94a3b8; font-weight: 500; }
  .fd-person { margin-top: 12px; padding-top: 12px; border-top: 1px solid #f0f2f5; }
  .fd-person > strong { display: block; font-size: .92rem; color: #0f172a; }
  .fd-person > span { font-size: .8rem; color: #64748b; }
  .fd-person .fd-list { margin-top: 6px; }
  .fd-person .fd-row:first-child { border-top: 0; }
  .fd-form { margin-top: 12px; display: grid; gap: 12px; }
  .fd-field { display: grid; gap: 5px; font-size: .84rem; font-weight: 700; color: #334155; }
  .fd-field small { font-weight: 500; color: #64748b; }
  .fd-field input, .fd-field select, .fd-field textarea { width: 100%; box-sizing: border-box; padding: 9px 11px; border: 1px solid #d5dce4; border-radius: 10px; font: inherit; font-size: .9rem; font-weight: 500; color: #0f172a; background: #fff; }
  .fd-field textarea { min-height: 76px; resize: vertical; }
  .fd-yesno { display: inline-flex; gap: 4px; padding: 3px; border-radius: 10px; background: #f1f4f7; width: max-content; }
  .fd-yesno label { position: relative; margin: 0; cursor: pointer; }
  .fd-yesno input { position: absolute; opacity: 0; pointer-events: none; }
  .fd-yesno span { display: inline-block; padding: 6px 14px; border-radius: 8px; font-size: .84rem; font-weight: 700; color: #475569; }
  .fd-yesno input:checked + span { background: #fff; color: #0f172a; box-shadow: 0 1px 3px rgba(15, 23, 42, .12); }
  .fd-yesno input:focus-visible + span { outline: 2px solid var(--org-primary-color, var(--primary, #0f5a66)); }
  .fd-actions { display: flex; flex-wrap: wrap; align-items: center; justify-content: flex-end; gap: 8px; }
  .fd-status { margin: 10px 0 0; font-size: .84rem; font-weight: 600; color: #166534; }
  .fd-status.is-error { color: #b91c1c; }
  /* Portal pages style plain buttons, headings and lists widely: keep this card's own look. */
  #familyDetails button { width: auto; min-width: 0; margin: 0; box-shadow: none; }
  #familyDetails .fd-head { flex-wrap: nowrap; }
  #familyDetails .fd-title { flex: 1 1 auto; min-width: 0; }
  #familyDetails .fd-title h2, #familyDetails .fd-title p { width: auto; }
  #familyDetails dt, #familyDetails dd { padding: 0; background: none; border: 0; }
  #familyDetails .fd-row dt { color: #64748b; }
  @media (max-width: 560px) { .fd-row { grid-template-columns: minmax(0, 1fr); gap: 2px; } .fd-head { flex-wrap: wrap; } }
</style>
<script>
  (function () {
    var box = document.getElementById('familyDetails');
    if (!box || box.dataset.ready) return;
    box.dataset.ready = '1';
    var mode = box.getAttribute('data-mode');
    var url = mode === 'parent' ? '/guardian/family-details' : '/student/family-details';
    var ICON = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 21s-7-4.35-7-10.2A4.8 4.8 0 0 1 12 7a4.8 4.8 0 0 1 7 3.8C19 16.65 12 21 12 21Z"/><path d="M12 11v4M10 13h4"/></svg>';
    var esc = function (s) { return String(s == null ? '' : s).replace(/[&<>"']/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]; }); };
    var shown = function (f) { return f.type === 'yes_no' ? (f.value === 'yes' ? 'Yes' : f.value === 'no' ? 'No' : '') : (f.value || ''); };
    var sections = [];

    function rows(items) {
      return '<dl class="fd-list">' + items.map(function (i) {
        return '<div class="fd-row"><dt>' + esc(i.label) + '</dt><dd' + (i.value ? '' : ' class="is-empty"') + '>' + esc(i.value || 'Not added yet') + '</dd></div>';
      }).join('') + '</dl>';
    }

    // ---------- parents: their own details, with Update ----------
    function viewCard(sec) {
      return '<div class="fd-card" data-section="' + sec.id + '"><div class="fd-head"><span class="fd-icon">' + ICON + '</span>'
        + '<div class="fd-title"><h2>' + esc(sec.name) + '</h2><p>Shared with the school. Keep it up to date.</p></div>'
        + '<button type="button" class="fd-btn" data-fd-edit>Update</button></div>'
        + rows(sec.fields.map(function (f) { return { label: f.label, value: shown(f) }; })) + '</div>';
    }
    function input(f) {
      var name = 'f' + f.id;
      var help = f.helpText ? '<small>' + esc(f.helpText) + '</small>' : '';
      if (f.type === 'yes_no') {
        return '<div class="fd-field"><span>' + esc(f.label) + '</span>' + help + '<div class="fd-yesno" role="radiogroup" aria-label="' + esc(f.label) + '">'
          + ['yes', 'no', ''].map(function (v) { return '<label><input type="radio" name="' + name + '" value="' + v + '"' + (f.value === v ? ' checked' : '') + '><span>' + (v === 'yes' ? 'Yes' : v === 'no' ? 'No' : 'Not set') + '</span></label>'; }).join('') + '</div></div>';
      }
      if (f.type === 'choice') {
        return '<label class="fd-field">' + esc(f.label) + help + '<select name="' + name + '"><option value="">Choose…</option>'
          + (f.options || []).map(function (o) { return '<option' + (o === f.value ? ' selected' : '') + '>' + esc(o) + '</option>'; }).join('') + '</select></label>';
      }
      if (f.type === 'long_text') return '<label class="fd-field">' + esc(f.label) + help + '<textarea name="' + name + '" maxlength="4000">' + esc(f.value) + '</textarea></label>';
      var type = f.type === 'number' ? 'number' : f.type === 'date' ? 'date' : 'text';
      return '<label class="fd-field">' + esc(f.label) + help + '<input type="' + type + '" name="' + name + '" value="' + esc(f.value) + '"' + (type === 'text' ? ' maxlength="500"' : '') + '></label>';
    }
    function editCard(sec) {
      return '<div class="fd-card" data-section="' + sec.id + '"><div class="fd-head"><span class="fd-icon">' + ICON + '</span>'
        + '<div class="fd-title"><h2>' + esc(sec.name) + '</h2><p>Changes go straight to the school.</p></div></div>'
        + '<form class="fd-form" data-fd-form novalidate>' + sec.fields.map(input).join('')
        + '<div class="fd-actions"><button type="button" class="fd-btn" data-fd-cancel>Cancel</button><button type="submit" class="fd-btn fd-btn--primary">Save</button></div>'
        + '<p class="fd-status" data-fd-status role="status"></p></form></div>';
    }
    function renderParent(editing) {
      box.innerHTML = sections.map(function (sec) { return editing === sec.id ? editCard(sec) : viewCard(sec); }).join('');
      box.hidden = !sections.length;
      var first = editing && box.querySelector('[data-fd-form] input, [data-fd-form] select, [data-fd-form] textarea');
      if (first) first.focus();
    }

    // ---------- students: their parents and what the school shares ----------
    function renderStudent(family) {
      var people = family.filter(function (p) { return p.sections.length; });
      if (!people.length) { box.hidden = true; return; }
      box.innerHTML = '<div class="fd-card"><div class="fd-head"><span class="fd-icon">' + ICON + '</span>'
        + '<div class="fd-title"><h2>Going home</h2><p>Who picks you up and who to call.</p></div></div>'
        + people.map(function (p) {
          return '<div class="fd-person"><strong>' + esc(p.name) + '</strong>' + (p.relationship ? '<span>' + esc(p.relationship) + '</span>' : '')
            + rows([].concat.apply([], p.sections.map(function (s) { return s.items; }))) + '</div>';
        }).join('') + '</div>';
      box.hidden = false;
    }

    box.addEventListener('click', function (e) {
      var card = e.target.closest('[data-section]');
      if (e.target.closest('[data-fd-edit]') && card) renderParent(Number(card.getAttribute('data-section')));
      if (e.target.closest('[data-fd-cancel]')) renderParent(null);
    });
    box.addEventListener('submit', async function (e) {
      var form = e.target.closest('[data-fd-form]');
      if (!form) return;
      e.preventDefault();
      var sec = sections.find(function (s) { return String(s.id) === form.closest('[data-section]').getAttribute('data-section'); });
      var fields = {};
      sec.fields.forEach(function (f) {
        var el = form.querySelector('[name="f' + f.id + '"]:checked') || form.querySelector('[name="f' + f.id + '"]:not([type="radio"])');
        fields[f.id] = el ? el.value : '';
      });
      var button = form.querySelector('[type="submit"]');
      var status = form.querySelector('[data-fd-status]');
      button.disabled = true;
      status.className = 'fd-status';
      status.textContent = 'Saving…';
      try {
        var res = await fetch(url, { method: 'POST', credentials: 'same-origin', headers: { 'Content-Type': 'application/json', Accept: 'application/json' }, body: JSON.stringify({ fields: fields }) });
        var data = await res.json().catch(function () { return {}; });
        if (!res.ok || !data.success) throw new Error(data.error || 'Your details could not be saved.');
        sections = data.sections || [];
        renderParent(null);
        var saved = box.querySelector('[data-section="' + sec.id + '"] .fd-title p');
        if (saved) saved.textContent = 'Saved. Thank you!';
      } catch (err) {
        status.className = 'fd-status is-error';
        status.textContent = err.message;
        button.disabled = false;
      }
    });

    fetch(url, { credentials: 'same-origin', headers: { Accept: 'application/json' } })
      .then(function (res) { return res.ok ? res.json() : null; })
      .then(function (data) {
        if (!data || !data.success) return;
        if (mode === 'parent') { sections = data.sections || []; renderParent(null); }
        else renderStudent(data.family || []);
      })
      .catch(function () {});
  })();
</script>
<% } %>
