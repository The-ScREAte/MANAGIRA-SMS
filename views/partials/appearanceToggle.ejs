<%# Appearance in the header menu: three color dots (Light, Classic, Dark). Saved for the signed-in person only. %>
<% const _apLookNow = ['classic', 'dark'].includes(typeof appearance !== 'undefined' ? appearance : '') ? appearance : 'light'; %>
<div class="ap-dots-row">
  <span class="ap-dots-label">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3a9 9 0 0 0 0 18c.9 0 1.6-.7 1.6-1.6 0-.4-.2-.8-.4-1.1-.3-.3-.4-.7-.4-1.1 0-.9.7-1.6 1.6-1.6H16a5 5 0 0 0 5-5c0-4.1-4-7.6-9-7.6z"/><circle cx="7.5" cy="11" r=".9" fill="currentColor"/><circle cx="10.5" cy="7.5" r=".9" fill="currentColor"/><circle cx="15" cy="8" r=".9" fill="currentColor"/></svg>
    Appearance
  </span>
  <div class="ap-dots" role="radiogroup" aria-label="Appearance" data-ap-skip>
    <% [['light', 'Light'], ['classic', 'Classic'], ['dark', 'Dark']].forEach(function (s) { %>
      <%# Links, not buttons: the header menu lets link clicks through to the page's handler. %>
      <a href="#" class="ap-dot ap-dot--<%= s[0] %>" role="radio" aria-checked="<%= _apLookNow === s[0] %>" aria-label="<%= s[1] %>" title="<%= s[1] %>" data-ap-set="<%= s[0] %>" data-no-spa></a>
    <% }) %>
  </div>
</div>
