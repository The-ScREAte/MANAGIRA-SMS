<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="<%= locals.viewportContent || 'width=device-width, initial-scale=1.0, maximum-scale=1.0' %>">
    <meta name="robots" content="noindex, follow">
    <title><%= title || 'Error' %></title>
    <style>
        body { margin: 0; min-height: 100vh; display: grid; place-items: center; padding: 24px; box-sizing: border-box; font-family: system-ui, -apple-system, "Segoe UI", sans-serif; background: #f8fafc; color: #0f172a; text-align: center; }
        .error-details { max-width: 560px; }
        .status { margin: 0 0 8px; font-size: 64px; line-height: 1; color: #dc2626; }
        .message { margin: 0 0 24px; font-size: 20px; line-height: 1.5; color: #475569; }
        .home-link { display: inline-block; padding: 11px 22px; border-radius: 10px; background: var(--org-primary-color, #01535b); color: #fff; font-weight: 600; text-decoration: none; }
    </style>
</head>
<body>
    <main class="error-details">
        <h1 class="status"><%= status %></h1>
        <p class="message"><%= message %></p>
        <% const sessionData = (typeof session !== 'undefined' && session) || (typeof locals !== 'undefined' && locals.session) || null; %>
        <a href="<%= (sessionData && (sessionData.userId || sessionData.organizationId)) ? '/common/orgDashboard' : '/' %>" class="home-link">Return to Home</a>
    </main>
</body>
</html>
