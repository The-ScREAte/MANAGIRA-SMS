
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="<%= locals.viewportContent || 'width=device-width, initial-scale=1.0, maximum-scale=1.0' %>">
    <meta name="robots" content="noindex, follow">
    <title><%= title || 'Error' %></title>
    <link rel="stylesheet" href="/styles/error.css"> 
</head>
<body>
    <body>
        <div class="error-page-container">
            <main class="error-main">
                <div class="error-details">
                    <h1 class="status"><%= status %></h1>
                    <p class="message"><%= message %></p>
                    <% const sessionData = (typeof session !== 'undefined' && session) || (typeof locals !== 'undefined' && locals.session) || null; %>
                    <a href="<%= (sessionData && (sessionData.userId || sessionData.organizationId)) ? '/common/orgDashboard' : '/' %>" class="home-link">Return to Home</a>
                </div>
            </main>
        </div>
    </body>
</html>
<style>

.error-page-container {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    align-items: center;
    text-align: center;
}

.error-header {
    padding: 20px;
    background-color: #ffffff;
    width: 100%;
    border-bottom: 1px solid #ddd;
}


.error-main {
    flex: 1;
    display: flex;
    justify-content: center;
    align-items: center;
    flex-direction: column;
    padding: 20px;
}

.error-details {
    max-width: 600px;
}

.status {
    font-size: 72px;
    color: #dc3545;
    margin-bottom: 10px;
}

.message {
    font-size: 24px;
    color: #555;
    margin-bottom: 20px;
}

.home-link {
    display: inline-block;
    padding: 10px 20px;
    font-size: 18px;
    color: #ffffff;
    background-color: var(--org-primary-color);
    text-decoration: none;
    border-radius: 5px;
    transition: background-color 0.3s ease;
}

.home-link:hover {
    background-color: var(--org-primary-hover-fill, var(--org-primary-hover));
}

.error-footer a:hover {
    text-decoration: underline;
}
</style>