<!-- JSON-LD Structured Data -->
<%# One connected description of Managira for search engines and AI
    assistants (schema.org). Prices come from the live plans (see server.js). %>
<%
  const _site = 'https://managira.com';
  const _pricing = (typeof homePricing !== 'undefined' && homePricing) ? homePricing : null;
  const _ld = {
    '@context': 'https://schema.org',
    '@graph': [
      {
        '@type': 'Organization',
        '@id': _site + '/#organization',
        name: 'Managira',
        url: _site + '/',
        logo: { '@type': 'ImageObject', url: _site + '/images/managira.png', width: 512, height: 512 },
        description: 'Managira makes all-in-one school management software for schools, school districts and multi-school networks.',
        foundingDate: '2024',
        sameAs: ['https://www.linkedin.com/company/managira', 'https://www.youtube.com/@managira'],
        contactPoint: { '@type': 'ContactPoint', contactType: 'sales', url: _site + '/legal/request-demo' },
      },
      {
        '@type': 'WebSite',
        '@id': _site + '/#website',
        name: 'Managira',
        url: _site + '/',
        publisher: { '@id': _site + '/#organization' },
        inLanguage: 'en',
      },
      {
        '@type': 'SoftwareApplication',
        '@id': _site + '/#software',
        name: 'Managira',
        alternateName: 'Managira School Management System',
        url: _site + '/',
        applicationCategory: 'BusinessApplication',
        applicationSubCategory: 'School management software',
        operatingSystem: 'Web browser (desktop and mobile)',
        description: 'All-in-one school management software: admissions and student records, attendance, assessments and report cards, promotion, staff and permissions, fee collection (PayGira), transportation, parent and student portals, messaging by email, SMS and WhatsApp, a school website, and Mira, a built-in AI assistant.',
        publisher: { '@id': _site + '/#organization' },
        featureList: [
          'Admissions, online applications and student records',
          'Classes, subjects, terms and school years',
          'Attendance tracking',
          'Assessments, grading, report cards and transcripts',
          'Promotion between terms and graduation',
          'Staff accounts with individual permissions',
          'Fee billing and online payments with PayGira (cards and mobile money)',
          'School transportation with routes, stops and live bus tracking',
          'Parent (guardian) portal and student portal',
          'Mail Room messaging by email, SMS and WhatsApp',
          'Shared calendar synced with class timetables',
          'Public school website with online admission',
          'Multi-school hubs for districts and school networks',
          'Mira, a built-in AI assistant that works with the school\'s own data',
        ],
        ...(_pricing ? {
          offers: {
            '@type': 'AggregateOffer',
            priceCurrency: 'USD',
            lowPrice: _pricing.lowPrice,
            highPrice: _pricing.highPrice,
            offerCount: _pricing.offerCount,
            url: _site + '/account/service-plan',
            description: 'Monthly base price per school. Prices vary by country and number of students.',
          },
        } : {}),
      },
      {
        '@type': 'SoftwareApplication',
        '@id': _site + '/#paygira',
        name: 'PayGira by Managira',
        url: _site + '/',
        applicationCategory: 'FinanceApplication',
        operatingSystem: 'Web browser',
        description: 'School fee billing and collection built into Managira: bills per class or student, card and mobile money payments, receipts, arrears and payment tracking.',
        isPartOf: { '@id': _site + '/#software' },
        publisher: { '@id': _site + '/#organization' },
      },
      {
        '@type': 'SoftwareApplication',
        '@id': _site + '/legal/mira-ai-assistant#mira',
        name: 'Mira by Managira',
        url: _site + '/legal/mira-ai-assistant',
        applicationCategory: 'BusinessApplication',
        operatingSystem: 'Web browser',
        description: 'AI assistant built into Managira that carries out school administration tasks on the school\'s own data, within each staff member\'s permissions, with every change recorded in the activity log.',
        isPartOf: { '@id': _site + '/#software' },
        publisher: { '@id': _site + '/#organization' },
      },
    ],
  };
%>
<script type="application/ld+json"><%- JSON.stringify(_ld).replace(/</g, '\\u003c') %></script>
