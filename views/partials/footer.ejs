<footer class="managira-footer">
  <!-- TOP CTA + LINK COLUMNS SECTION -->
  <% if (showFooterTopSection) { %>
  <div class="footer-top-section">
    <div class="footer-inner">

      <!-- CTA Row -->
      <div class="footer-cta-row">
        <div class="footer-cta-text">
          <span class="footer-cta-eyebrow">Ready when you are</span>
          <h2 class="footer-cta-title">Experience Managira today.</h2>
        </div>
        <a href="/legal/request-demo" class="footer-cta-pill">
          <span>Get a Demo</span>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </a>
      </div>

      <div class="footer-divider" role="presentation"></div>

      <!-- Main Grid: Logo + Columns -->
      <div class="footer-main-grid">

        <!-- Brand / Logo column -->
        <div class="footer-brand-col">
          <% if (typeof hubInfo !== 'undefined' && hubInfo && hubInfo.hub_branding_enabled && hubInfo.logo_path) { %>
            <img src="<%= hubInfo.logo_path %>" alt="<%= hubInfo.hub_name %> Logo" class="footer-brand-logo" />
            <p class="footer-brand-sub">Powered by <%= hubInfo.hub_name %></p>
          <% } else { %>
            <img src="/images/managira.png" alt="Managira Logo" class="footer-brand-logo" />
            <p class="footer-brand-sub">School management built for real schools.</p>
          <% } %>

          <div class="footer-social">
            <a href="https://www.youtube.com/@managira" target="_blank" rel="noopener" aria-label="YouTube">
              <img src="/images/social/youtubeicon.png" alt="YouTube" />
            </a>
            <a href="https://www.linkedin.com/company/managira" target="_blank" rel="noopener" aria-label="LinkedIn">
              <img src="/images/social/linkedinicon.png" alt="LinkedIn" />
            </a>
          </div>
        </div>

        <!-- Link Columns -->
        <div class="footer-cols">

          <!-- PLATFORM -->
          <div class="footer-col-section">
            <button type="button" class="footer-col-heading" aria-expanded="false">
              Platform
              <svg class="footer-chev" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg>
            </button>
            <ul class="footer-col-list">
              <li><a href="/">Overview</a></li>
              <li><a href="/account/service-plan">Service Plans</a></li>
              <li><a href="/account/register">Get Started</a></li>
            </ul>
          </div>

          <!-- COMPANY -->
          <div class="footer-col-section">
            <button type="button" class="footer-col-heading" aria-expanded="false">
              Company
              <svg class="footer-chev" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg>
            </button>
            <ul class="footer-col-list">
              <li><a href="/legal/about-us">About Managira</a></li>
              <li><a href="https://www.screate.org/about" target="_blank" rel="noopener">About ScREAte</a></li>
              <li><a href="/legal/employment">Careers</a></li>
              <li><a href="/legal/donations">Give to Managira</a></li>
            </ul>
          </div>

          <!-- RESOURCES -->
          <div class="footer-col-section">
            <button type="button" class="footer-col-heading" aria-expanded="false">
              Resources
              <svg class="footer-chev" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg>
            </button>
            <ul class="footer-col-list">
              <li><a href="/legal/mira-ai-assistant">Mira</a></li>
              <li><a href="https://managira.com/legal/user-documentation/mira-ai-capabilities">Mira Capabilities</a></li>
              <li><a href="/legal/user-documentation">Documentation</a></li>
              <li><a href="/legal/faq">FAQ</a></li>
              <li><a href="/legal/help">Help Center</a></li>
              <!-- Hidden for now: School Directory page is disabled in production.
              <li><a href="/directory">School Directory</a></li>
              -->
            </ul>
          </div>

          <!-- LEGAL -->
          <div class="footer-col-section">
            <button type="button" class="footer-col-heading" aria-expanded="false">
              Legal
              <svg class="footer-chev" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg>
            </button>
            <ul class="footer-col-list">
              <li><a href="/legal/privacy-policy">Privacy Policy</a></li>
              <li><a href="/legal/terms-of-service">Terms of Service</a></li>
            </ul>
          </div>

        </div>
      </div>
    </div>
  </div>
  <% } %>

  <!-- BOTTOM BAR -->
  <div class="footer-bottom-section">
    <div class="footer-bottom-row">
      <% const _hubBrand = (typeof hubBrand !== 'undefined' && hubBrand) || null; %>
      <% if (_hubBrand) { %>
        <div class="footer-hub-section">
          <% if (_hubBrand.logo) { %><span class="footer-hub-logo-wrap"><img src="<%= _hubBrand.logo %>" alt="<%= _hubBrand.name %>" class="footer-hub-logo" onerror="this.parentNode.remove()" /></span><% } %>
          <p class="footer-hub-text">Part of <strong><%= _hubBrand.name %></strong></p>
        </div>
      <% } %>

      <div class="footer-copy">
        <% if (typeof hubInfo !== 'undefined' && hubInfo && hubInfo.hub_footer_text) { %>
          <%= hubInfo.hub_footer_text %>
        <% } else if (_hubBrand && _hubBrand.footerText) { %>
          <%= _hubBrand.footerText %>
        <% } else { %>
          &copy; <%= new Date().getFullYear() %> ScREAte / Managira. All rights reserved.
        <% } %>
      </div>

      <div class="footer-bottom-links">
        <a href="/legal/privacy-policy">Privacy</a>
        <span aria-hidden="true">·</span>
        <a href="/legal/terms-of-service">Terms</a>
      </div>
    </div>
  </div>
</footer>

<style>
  :root {
    --font-family: "<%= (typeof session !== 'undefined' && session && session.fontStyle ? String(session.fontStyle).trim() : 'Inter') %>", sans-serif;
    --dynamic-bottom-inset: 0px;
    <%
      /* ── Org-theme footer colours ─────────────────────────────────────
         When a user is logged in, derive footer colours from their org's
         theme. Fall back to the original teal palette for logged-out visitors.
      ─────────────────────────────────────────────────────────────────── */
      const _isLoggedIn = !!(typeof session !== 'undefined' && session && (session.themeColor || session.organizationId || session.firstName));
      const _tc = (_isLoggedIn && session && session.themeColor) ? String(session.themeColor) : 'teal';
      const _footerPalette = {
        teal:    { mid: '#01535b', deep: '#033f46', bottom: '#022830', gold: '#e8b84a' },
        blue:    { mid: '#1d4ed8', deep: '#1e3a8a', bottom: '#172554', gold: '#93c5fd' },
        green:   { mid: '#1b5e20', deep: '#14532d', bottom: '#0b3d1a', gold: '#86efac' },
        purple:  { mid: '#6d28d9', deep: '#4c1d95', bottom: '#2e1065', gold: '#c4b5fd' },
        indigo:  { mid: '#4338ca', deep: '#312e81', bottom: '#1e1b4b', gold: '#a5b4fc' },
        rose:    { mid: '#7a212e', deep: '#5c1822', bottom: '#3f1017', gold: '#fca5a5' },
        amber:   { mid: '#b45309', deep: '#92400e', bottom: '#6b2f08', gold: '#fde68a' },
        yellow:  { mid: '#ca8a04', deep: '#a16207', bottom: '#7a4c04', gold: '#fef08a' },
        slate:   { mid: '#334155', deep: '#1e293b', bottom: '#0f172a', gold: '#94a3b8' },
        cyan:    { mid: '#0891b2', deep: '#0e7490', bottom: '#164e63', gold: '#67e8f9' },
        orange:  { mid: '#ea580c', deep: '#c2410c', bottom: '#9a3412', gold: '#fdba74' },
        charcoal:{ mid: '#1f2937', deep: '#111827', bottom: '#030712', gold: '#9ca3af' },
        classic: { mid: '#01535b', deep: '#033f46', bottom: '#022830', gold: '#e8b84a' },
        bold:    { mid: '#0b1020', deep: '#050a14', bottom: '#020408', gold: '#ffb703' },
        modern:  { mid: '#1d4ed8', deep: '#1e3a8a', bottom: '#172554', gold: '#93c5fd' },
        minimal: { mid: '#6d28d9', deep: '#4c1d95', bottom: '#2e1065', gold: '#c4b5fd' },
        gold:    { mid: '#b8860b', deep: '#8b6309', bottom: '#5c4006', gold: '#fef08a' },
        red:     { mid: '#be123c', deep: '#9f1239', bottom: '#7c0d2e', gold: '#fca5a5' },
        brown:   { mid: '#7c4a03', deep: '#5c3802', bottom: '#3d2601', gold: '#d4a574' },
      };
      const _fp = _footerPalette[_tc] || _footerPalette.teal;
    %>
    --footer-teal-deep: <%= _fp.deep %>;
    --footer-teal: <%= _fp.mid %>;
    --footer-bottom: <%= _fp.bottom %>;
    --footer-gold: <%= _fp.gold %>;
  }

  .managira-footer {
    font-family: var(--font-family) !important;
    width: 100% !important;
    margin-top: auto !important;
    text-align: left !important;
    background: none !important;
    border: none !important;
    box-shadow: none !important;
    padding: 0 !important;
  }

  /* ===== TOP SECTION ===== */
  .footer-top-section {
    background: linear-gradient(180deg, var(--footer-teal) 0%, var(--footer-teal-deep) 100%) !important;
    color: #fff !important;
    padding: 56px 24px 36px !important;
  }

  .footer-inner {
    max-width: 1200px;
    margin: 0 auto;
  }

  /* CTA Row */
  .footer-cta-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    flex-wrap: wrap;
    margin-bottom: 36px;
  }
  .footer-cta-text { display: flex; flex-direction: column; gap: 6px; }
  .footer-cta-eyebrow {
    font-size: 11px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--footer-gold);
    font-weight: 700;
  }
  .footer-cta-title {
    font-size: 30px;
    font-weight: 600;
    color: #fff;
    margin: 0;
    letter-spacing: -0.015em;
  }

  .footer-cta-pill {
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    background: #fff;
    color: var(--footer-teal);
    text-decoration: none;
    padding: 13px 24px;
    border-radius: 999px;
    font-size: 15px;
    font-weight: 600;
    min-width: 220px;
    transition: transform 0.15s ease, box-shadow 0.15s ease;
    box-shadow: 0 1px 2px rgba(0,0,0,0.08);
  }
  .footer-cta-pill:hover {
    transform: translateY(-1px);
    box-shadow: 0 8px 20px rgba(0,0,0,0.22);
  }
  .footer-cta-pill svg { flex-shrink: 0; }

  .footer-divider {
    height: 1px;
    background: rgba(255,255,255,0.14);
    margin: 0 0 36px;
  }

  /* Main grid */
  .footer-main-grid {
    display: grid;
    grid-template-columns: 240px 1fr;
    gap: 48px;
    align-items: start;
  }

  .footer-brand-col {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .footer-brand-logo {
    height: 52px;
    width: auto;
    object-fit: contain;
  }
  .footer-brand-sub {
    font-size: 13px;
    color: rgba(255,255,255,0.7);
    margin: 0;
    line-height: 1.5;
    max-width: 220px;
  }
  .footer-social {
    display: flex;
    gap: 12px;
    align-items: center;
    margin-top: 4px;
  }
  .footer-social a { display: inline-flex; }
  .footer-social img {
    width: 30px;
    height: 30px;
    object-fit: contain;
    opacity: 0.85;
    transition: opacity 0.15s ease, transform 0.15s ease;
  }
  .footer-social a:hover img { opacity: 1; transform: translateY(-1px); }

  /* Columns */
  .footer-cols {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 32px;
  }

  .footer-col-heading {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    background: transparent;
    border: 0;
    padding: 0 0 16px 0;
    margin: 0;
    color: var(--footer-gold);
    font-size: 11.5px;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    cursor: default;
    font-family: inherit;
  }
  .footer-chev {
    display: none;
    transition: transform 0.2s ease;
    color: #fff;
  }

  .footer-col-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 11px;
  }
  .footer-col-list a {
    color: rgba(255,255,255,0.88);
    text-decoration: none;
    font-size: 14.5px;
    line-height: 1.45;
    font-weight: 400;
    transition: color 0.15s ease;
  }
  .footer-col-list a:hover {
    color: #fff;
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-color: var(--footer-gold);
  }

  /* ===== BOTTOM BAR ===== */
  .footer-bottom-section {
    background-color: var(--footer-bottom) !important;
    color: rgba(255,255,255,0.7) !important;
    padding: 18px 24px calc(18px + var(--dynamic-bottom-inset, 0px)) !important;
    border-top: 1px solid rgba(255,255,255,0.06);
  }
  .footer-bottom-row {
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
    font-size: 12.5px;
  }
  .footer-copy {
    flex: 1;
    text-align: center;
    color: rgba(255,255,255,0.65);
  }
  .footer-bottom-links {
    display: flex;
    gap: 8px;
    align-items: center;
  }
  .footer-bottom-links a {
    color: rgba(255,255,255,0.85) !important;
    text-decoration: none;
  }
  .footer-bottom-links a:hover { text-decoration: underline; text-decoration-color: var(--footer-gold); }
  .footer-bottom-links span { color: rgba(255,255,255,0.3); }

  .footer-hub-section {
    display: flex;
    align-items: center;
    gap: 10px;
    min-width: 0;
  }
  .footer-hub-logo-wrap {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 36px;
    padding: 3px 8px;
    border-radius: 8px;
    background: #fff;
    flex: none;
  }
  .footer-hub-logo {
    height: 28px;
    width: auto;
    max-width: 96px;
    object-fit: contain;
    display: block;
  }
  .footer-hub-text {
    color: rgba(255,255,255,0.75);
    font-size: 12px;
    margin: 0;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .footer-hub-text strong { color: #fff; font-weight: 600; }

  /* ===== TABLET ===== */
  @media (max-width: 1024px) {
    .footer-main-grid {
      grid-template-columns: 1fr;
      gap: 32px;
    }
    .footer-brand-col { align-items: flex-start; }
    .footer-cols { gap: 24px; }
  }

  /* ===== MOBILE ===== */
  @media (max-width: 768px) {
    .footer-top-section { padding: 36px 18px 28px !important; }

    .footer-cta-row {
      flex-direction: column;
      align-items: center;
      text-align: center;
      gap: 18px;
      margin-bottom: 24px;
    }
    .footer-cta-text { align-items: center; text-align: center; }
    .footer-cta-title { font-size: 22px; text-align: center; }
    .footer-cta-pill { width: 100%; min-width: 0; padding: 14px 20px; justify-content: center; }

    .footer-divider { margin: 0 0 24px; }

    .footer-cols {
      grid-template-columns: 1fr;
      gap: 0;
    }

    /* Accordion on mobile */
    .footer-col-section {
      border-bottom: 1px solid rgba(255,255,255,0.1);
    }
    .footer-col-section:first-child { border-top: 1px solid rgba(255,255,255,0.1); }

    .footer-col-heading {
      padding: 16px 2px;
      cursor: pointer;
    }
    .footer-chev { display: inline-block; }
    .footer-col-section.open .footer-chev { transform: rotate(180deg); }

    .footer-col-list {
      max-height: 0;
      overflow: hidden;
      transition: max-height 0.3s ease, padding 0.3s ease;
      padding: 0 2px;
    }
    .footer-col-section.open .footer-col-list {
      max-height: 500px;
      padding: 2px 2px 18px 2px;
    }

    .footer-brand-col { align-items: center; text-align: center; }
    .footer-brand-sub { max-width: none; }
    .footer-social { justify-content: center; }

    .footer-bottom-row {
      flex-direction: column;
      gap: 10px;
      text-align: center;
    }
    .footer-copy { text-align: center; }

    body[data-page="publicDashboard"] .footer-bottom-section { display: none; }
  }
</style>

<script>
  (function () {
    function initFooterAccordion() {
      var headings = document.querySelectorAll('.managira-footer .footer-col-heading');
      headings.forEach(function (btn) {
        if (btn.dataset.bound === '1') return;
        btn.dataset.bound = '1';
        btn.addEventListener('click', function () {
          if (!window.matchMedia('(max-width: 768px)').matches) return;
          var section = btn.closest('.footer-col-section');
          if (!section) return;
          var open = section.classList.toggle('open');
          btn.setAttribute('aria-expanded', open ? 'true' : 'false');
        });
      });
      window.addEventListener('resize', function () {
        if (!window.matchMedia('(max-width: 768px)').matches) {
          document.querySelectorAll('.managira-footer .footer-col-section.open').forEach(function (s) {
            s.classList.remove('open');
            var b = s.querySelector('.footer-col-heading');
            if (b) b.setAttribute('aria-expanded', 'false');
          });
        }
      });
    }
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initFooterAccordion);
    } else {
      initFooterAccordion();
    }
  })();
</script>

<!-- Logout confirmation modal — intercepts every logout link site-wide -->
<div class="logout-modal-overlay" id="logoutModalOverlay" role="presentation">
  <div class="logout-modal" role="alertdialog" aria-modal="true" aria-labelledby="logoutModalTitle" aria-describedby="logoutModalDesc">
    <h2 id="logoutModalTitle" class="logout-modal-title">Sign out of Managira?</h2>
    <p id="logoutModalDesc" class="logout-modal-desc">
      You'll need to sign in again to access your dashboard, students, and records.
      Any unsaved changes on this page will be lost.
    </p>
    <div class="logout-modal-actions">
      <button type="button" class="logout-modal-cancel" id="logoutModalCancel">Cancel</button>
      <a href="#" class="logout-modal-confirm" id="logoutModalConfirm">Sign Out</a>
    </div>
  </div>
</div>

<style>
  .logout-modal-overlay {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(15, 23, 42, 0.55);
    z-index: 10000;
    align-items: center;
    justify-content: center;
    padding: 16px;
  }
  .logout-modal-overlay.open { display: flex; }
  .logout-modal {
    background: #fff;
    border-radius: 14px;
    max-width: 380px;
    width: 100%;
    padding: 28px 26px 22px;
    box-shadow: 0 20px 50px rgba(0,0,0,0.25);
    text-align: left;
  }
  .logout-modal-title {
    margin: 0 0 10px;
    font-size: 18px;
    font-weight: 700;
    color: #111827;
  }
  .logout-modal-desc {
    margin: 0 0 22px;
    font-size: 14px;
    line-height: 1.5;
    color: #4b5563;
  }
  .logout-modal-actions {
    display: flex;
    justify-content: center;
    gap: 10px;
  }
  .logout-modal-cancel,
  .logout-modal-confirm {
    display: inline-flex;
    flex: none;
    width: auto;
    white-space: nowrap;
    align-items: center;
    justify-content: center;
    padding: 7px 14px;
    border-radius: 8px;
    font-size: 13px;
    font-weight: 600;
    cursor: pointer;
    border: 1px solid transparent;
    text-decoration: none;
  }
  .logout-modal-cancel {
    background: #f3f4f6;
    color: #1f2937;
    border-color: #e5e7eb;
  }
  .logout-modal-cancel:hover { background: #e5e7eb; }
  .logout-modal-confirm {
    background: #dc2626;
    color: #fff;
  }
  .logout-modal-confirm:hover { background: #b91c1c; }
</style>

<script>
  (function () {
    function initLogoutModal() {
      var overlay = document.getElementById('logoutModalOverlay');
      var confirmBtn = document.getElementById('logoutModalConfirm');
      var cancelBtn = document.getElementById('logoutModalCancel');
      if (!overlay || !confirmBtn || !cancelBtn) return;

      var pendingHref = '/account/logout';

      function openModal(href) {
        pendingHref = href || '/account/logout';
        confirmBtn.setAttribute('href', pendingHref);
        overlay.classList.add('open');
      }

      function closeModal() {
        overlay.classList.remove('open');
      }

      document.addEventListener('click', function (e) {
        var link = e.target.closest('a[href="/account/logout"], a[href="/hub/logout"], a.logout');
        if (!link || link.id === 'logoutModalConfirm') return;
        e.preventDefault();
        openModal(link.getAttribute('href'));
      });

      cancelBtn.addEventListener('click', closeModal);
      overlay.addEventListener('click', function (e) {
        if (e.target === overlay) closeModal();
      });
      document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape' && overlay.classList.contains('open')) closeModal();
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initLogoutModal);
    } else {
      initLogoutModal();
    }
  })();
</script>
