<footer class="managira-footer">
  <!-- Blue section -->
  <% if (showFooterTopSection) { %>
  <div class="footer-top-section">
    <div class="footer-flex-container">
      <!-- Logo -->
      <div class="footer-col logo-col">
        <% if (typeof hubInfo !== 'undefined' && hubInfo && hubInfo.hub_branding_enabled && hubInfo.logo_path) { %>
          <!-- Show Hub Logo -->
          <img
            src="<%= hubInfo.logo_path %>"
            alt="<%= hubInfo.hub_name %> Logo"
            class="footer-logo"
          />
          <p style="font-size: 12px; color: white; margin-top: 4px;">Powered by <%= hubInfo.hub_name %></p>
        <% } else { %>
          <!-- Show Managira Logo -->
          <img
            src="/images/managira.png"
            alt="Managira Logo"
            class="footer-logo"
          />
        <% } %>
      </div>

      <!-- Contact Info -->
      <div class="footer-col contacts-links">
          <div class="contact-col">
            <a href="/legal/help">Seek Help</a>
            <a href="mailto:info@managira.com">info@managira.com</a>
          </div>

          <!-- Quick Links -->
          <div class="links-col">
            <a href="/legal/employment">Employment</a>
            <a href="/legal/donations">Give to Managira</a>
            <a href="/legal/about-us">About Us</a>
          </div>
      </div>

      <!-- Social -->
      <div class="footer-col social-col">
        <a href="https://www.youtube.com/@managira" target="_blank"
          ><img src="/images/social/youtubeicon.png" alt="YouTube"
        /></a>
        <a
          href="https://www.linkedin.com/company/managira"
          target="_blank"
          ><img src="/images/social/linkedinicon.png" alt="LinkedIn"
        /></a>
      </div>
    </div>
  </div>
  <% } %>

  <!-- Black section -->
  <div class="footer-bottom-section">
    <div class="footer-bottom-row">
      <!-- Hub Logo Section for Hub Members (Left) -->
      <% 
        const hasValidHubLogo = session && session.isHubMember && 
                               session.hubLogo && 
                               !session.hubLogo.endsWith('/hub-logos') && 
                               !session.hubLogo.endsWith('/images/hub-logos') &&
                               session.accountType !== 'Hub';
      %>
      <% if (hasValidHubLogo) { %>
        <div class="footer-hub-section">
          <img src="<%= session.hubLogo %>" alt="<%= session.hubName %> Logo" class="footer-hub-logo" />
          <p class="footer-hub-text">Managed by <%= session.hubName %></p>
        </div>
      <% } %>
      
      <div class="footer-policy-links">
        <a href="/legal/privacy-policy">Privacy Policy</a> |
        <!-- <a href="#">Website Feedback</a> | -->

        <a href="/legal/terms-of-service">Terms of Service</a> |
        
        <a href="/legal/faq">FAQ  </a>

      </div>
      
      <div class="footer-copy">
        <% if (typeof hubInfo !== 'undefined' && hubInfo && hubInfo.hub_footer_text) { %>
          <%= hubInfo.hub_footer_text %>
        <% } else if (session && session.isHubMember && session.hubFooterText) { %>
          <%= session.hubFooterText %>
        <% } else { %>
          &copy; <%= new Date().getFullYear() %> ScREAte / Managira
        <% } %>
      </div>
    </div>
  </div>
</footer>
<style>
      :root {
        --font-family: "<%= (typeof session !== 'undefined' && session && session.fontStyle ? String(session.fontStyle).trim() : 'Inter') %>", sans-serif;
      }


  #foot {
    text-decoration: none;
  }
  #foot:hover {
    text-decoration: underline;
  }
  .managira-footer {
    font-family: var(--font-family) !important;
    width: 100% !important;
    margin-top: auto !important;
    /* Footer isolation: reset any page-level styling that may leak */
    text-align: left !important;
    background: none !important;
    border: none !important;
    box-shadow: none !important;
    padding: 0 !important;
  }

  /* BLUE SECTION */
  .footer-top-section {
    background-color: #026972 !important;
    color: white !important;
    padding: 15px 20px !important;
  }

  .footer-flex-container {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    flex-wrap: wrap;
    gap: 1px;
    max-width: 1200px;
    margin: 0 auto;
  }

  .footer-col {
    flex: 1 1 200px;
    min-width: 200px;
    margin-bottom: 0;
  }

  .logo-col {
    text-align: center;
  }

  .footer-logo {
    height: 60px;
    display: block;
    margin: 0 auto 10px auto;
  }

  .contacts-links {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .contact-col, .links-col {
    display: flex;
    justify-content: space-around;
    align-items: center;
    text-align: left;
  }

  .contact-col p,
  .contact-col a {
    font-size: 14px;
    color: white;
    line-height: 1.5;
    text-decoration: none;
    margin: 4px 0;
  }

  .links-col a {
    display: block;
    color: white;
    font-size: 14px;
    text-decoration: none;
    margin: 4px 0;
  }

  .links-col a:hover,
  .contact-col a:hover {
    text-decoration: underline;
  }

  .social-col {
    display: flex;
    justify-content: center;
    gap: 15px;
    align-items: center;
    margin-top: 10px;
  }

  .social-col img {
    width: 65px;
    height: 65px;
  }

  /* BLACK SECTION */
  .footer-bottom-section {
    background-color: #000 !important;
    color: white !important;
    padding: 20px 15px !important;
    margin-bottom: 0 !important;
  }

  .footer-bottom-row {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    max-width: 1200px;
    margin: 0 auto;
    font-size: 13px;
    gap: 10px;
    text-align: center;
  }
  
  .footer-policy-links {
    flex: 1;
    text-align: center;
  }

  .footer-policy-links a {
    color: white !important;
    margin: 0 4px;
    text-decoration: none;
  }

  .footer-policy-links a:hover {
    text-decoration: underline;
  }

  .footer-copy {
    flex: 1;
    text-align: right;
  }

  /* Hub Logo Section */
  .footer-hub-section {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 6px;
    flex: 1;
    text-align: left;
  }

  .footer-hub-logo {
    height: 45px;
    width: auto;
    max-width: 120px;
    object-fit: contain;
    opacity: 0.9;
  }

  .footer-hub-text {
    color: rgba(255, 255, 255, 0.7);
    font-size: 11px;
    margin: 0;
    text-align: center;
    font-weight: 500;
  }

  /* ====== MOBILE FIX ====== */
  @media (max-width: 768px) {
    .footer-flex-container {
      flex-direction: column;
      justify-content: flex-start;
      align-items: center;
      text-align: center;
      gap: 10px;
    }

    .footer-top-section {
      padding: 24px 16px;
    }

    .footer-col {
      width: 100%;
      min-width: 0;
      margin-bottom: 0;
      flex: 0 0 auto;
    }

    /* Hide footer bottom section on mobile for public dashboard only */
    body[data-page="publicDashboard"] .footer-bottom-section {
      display: none;
    }

    .footer-logo {
      height: 72px;
      margin-bottom: 2px;
    }
    
    .logo-col {
      margin-bottom: 0;
    }

    .contact-col,
    .links-col {
      flex-direction: column;
      justify-content: flex-start;
      align-items: center;
      gap: 6px;
    }

    .contact-col a,
    .links-col a {
      margin: 2px 0;
      line-height: 1.3;
    }

    .footer-bottom-row {
      flex-direction: column;
      text-align: center;
      gap: 10px;
    }

  .footer-copy {
      text-align: center;
    }

    .social-col {
      margin-top: 0;
      margin-bottom: 10px;
    }

    .social-col img {
      width: 48px;
      height: 48px;
    }
  }

  @media (min-width: 769px) and (max-width: 1024px) {
    .footer-flex-container {
      justify-content: flex-start;
      gap: 12px;
    }

    .footer-col {
      flex: 0 0 auto;
    }

    .contact-col,
    .links-col {
      justify-content: flex-start;
      gap: 8px;
    }

    .contact-col a,
    .links-col a {
      margin: 2px 0;
      line-height: 1.35;
    }
  }
</style>
