<%# One term of a student's portfolio (feature student_portfolio). Locals: terms, term, data, links { term, test, report, file },
    showReportCard (false when the child's class keeps report cards from parents: no report card stat or wording),
    files (the student's files shared with the family, null when the feature is off), labels (documented / undocumented),
    staff (the student page's Portfolio tab: every marked test, scores waiting for approval marked). %>
<%
  const _withReport = locals.showReportCard !== false;
  const _labels = Boolean(locals.labels);
  const _staff = Boolean(locals.staff);
  // The student's own view: percentages and how steady they are, not every piece of work.
  const _child = Boolean(locals.childView) && data && data.subjectSummary;
  const _files = Array.isArray(locals.files) ? locals.files : null;
  const _fileDate = (d) => d ? new Date(d + 'T12:00:00Z').toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric', timeZone: 'UTC' }) : '';
  const _fmt = (d, year) => d ? new Date(d).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: year ? 'numeric' : undefined }) : '';
  const _num = (n) => Number(n).toFixed(2).replace(/\.?0+$/, '');
%>
<% if (_files && _files.length) { %>
  <section class="pf-section pf-section--files" aria-labelledby="pf-files">
    <h2 id="pf-files">Student files <small>From the school</small></h2>
    <% if (!_files.length) { %>
      <div class="pf-empty">No files yet.</div>
    <% } else { %>
    <div class="pf-docs">
      <% _files.forEach((f) => { const _ext = (String(f.fileName).split('.').pop() || '').toUpperCase().slice(0, 4); %>
      <article class="pf-doc">
        <span class="pf-doc__icon pf-doc__icon--file"><%= _ext || 'FILE' %></span>
        <div><strong><%= f.title %></strong><small><%= f.typeLabel %><% if (f.expiresOn) { %> · <span class="<%= f.expired ? 'pf-warn' : '' %>"><%= f.expired ? 'Expired' : 'Expires' %> <%= _fileDate(f.expiresOn) %></span><% } %></small>
          <% if (f.note) { %><p><%= f.note %></p><% } %>
          <div class="pf-doc__actions"><a href="<%= links.file.replace('{id}', f.id) %>" target="_blank" rel="noopener" data-no-spa>Open</a></div></div>
      </article>
      <% }) %>
    </div>
    <% } %>
  </section>
<% } %>
<% if (!term) { %>
  <div class="pf-empty">Nothing here yet. Each term’s marked work<%= _withReport ? ' and report card' : '' %> collect<%= _withReport ? '' : 's' %> here.</div>
<% } else { %>
  <% if (terms.length > 1) { %>
  <nav class="pf-terms" aria-label="Terms">
    <% terms.forEach((t) => { %>
      <a class="pf-term" href="<%= links.term + t.id %>"<% if (t.id === term.id) { %> aria-current="true"<% } %>><strong><%= t.name %><%= t.current ? ' · Now' : '' %></strong><small><%= t.year %></small></a>
    <% }) %>
  </nav>
  <% } %>
  <% if (_child) { %>
  <div class="pf-stats<%= _withReport ? '' : ' pf-stats--3' %>">
    <div class="pf-stat"><span>Average</span><strong><%= data.summary.average === null ? '—' : data.summary.average + '%' %></strong></div>
    <div class="pf-stat"><span>Consistency</span><strong class="pf-cons pf-cons--<%= data.summary.consistency.key %>"><%= data.summary.consistency.label %></strong></div>
    <div class="pf-stat"><span>Marked work</span><strong><%= data.summary.marked %><small> / <%= data.summary.total %></small></strong></div>
    <% if (_withReport) { %><div class="pf-stat"><span>Report card</span><strong><% if (data.reportCard && links.report) { %><a href="<%= links.report %>" target="_blank" rel="noopener">Open PDF</a><% } else if (data.reportCard) { %>Posted<% } else { %><small>Not yet</small><% } %></strong></div><% } %>
  </div>

  <section class="pf-section" aria-labelledby="pf-subjects">
    <h2 id="pf-subjects">Subjects <small><%= term.name %>, <%= term.year %></small></h2>
    <% if (!data.subjectSummary.length) { %>
      <div class="pf-empty">No marked work this term yet.</div>
    <% } else { %>
    <div class="pf-subcards">
      <% data.subjectSummary.forEach((sub) => { %>
      <article class="pf-subcard">
        <div class="pf-subcard__head"><strong><%= sub.name %></strong><span class="pf-subcard__pct"><%= sub.average === null ? '—' : sub.average + '%' %></span></div>
        <div class="pf-bar" aria-hidden="true"><span style="width:<%= sub.average === null ? 0 : Math.max(2, Math.min(100, sub.average)) %>%"></span></div>
        <div class="pf-subcard__foot"><span class="pf-cons pf-cons--<%= sub.consistency.key %>"><%= sub.consistency.label %></span><small><%= sub.marked %> of <%= sub.total %> marked</small></div>
      </article>
      <% }) %>
    </div>
    <% } %>
  </section>
  <% } else { %>
  <div class="pf-stats<%= _withReport ? '' : ' pf-stats--3' %>">
    <div class="pf-stat"><span>Marked work</span><strong><%= data.summary.marked %><small> / <%= data.summary.total %></small></strong></div>
    <div class="pf-stat"><span>Average</span><strong><%= data.summary.average === null ? '—' : data.summary.average + '%' %></strong></div>
    <% if (_labels) { %>
    <div class="pf-stat"><span>Documented</span><strong><%= data.summary.documented %><small> · <%= data.summary.undocumented %> undocumented</small></strong></div>
    <% } else { %>
    <div class="pf-stat"><span>Documents</span><strong><%= data.summary.documents %></strong></div>
    <% } %>
    <% if (_withReport) { %><div class="pf-stat"><span>Report card</span><strong><% if (data.reportCard && links.report) { %><a href="<%= links.report %>" target="_blank" rel="noopener">Open PDF</a><% } else if (data.reportCard) { %>Posted<% } else { %><small>Not yet</small><% } %></strong></div><% } %>
  </div>
  <% } %>

  <section class="pf-section" aria-labelledby="pf-docs">
    <h2 id="pf-docs"><%= _labels ? 'Documented assessments' : 'Documents' %> <small><%= term.name %>, <%= term.year %></small></h2>
    <% if (!data.documents.length && !data.reportCard) { %>
      <div class="pf-empty"><%= _labels ? 'No Testing Room work this term yet.' : 'Marked tests' + (_withReport ? ' and the report card' : '') + ' show here as PDFs.' %></div>
    <% } else { %>
    <div class="pf-docs">
      <% if (data.reportCard) { %>
      <article class="pf-doc">
        <span class="pf-doc__icon pf-doc__icon--report">PDF</span>
        <div><strong>Report card</strong><small><%= term.name %> · posted <%= _fmt(data.reportCard.postedAt) %></small>
          <% if (links.report) { %><div class="pf-doc__actions"><a href="<%= links.report %>" target="_blank" rel="noopener">Open</a></div><% } %></div>
      </article>
      <% } %>
      <% data.documents.forEach((doc) => { %>
      <article class="pf-doc">
        <span class="pf-doc__icon">PDF</span>
        <div><strong><%= doc.title %></strong><small><%= [doc.subject, doc.submittedAt ? 'Finished ' + _fmt(doc.submittedAt) : ''].filter(Boolean).join(' · ') %></small>
          <% if (doc.grade) { %><span class="pf-grade"><%= doc.grade %></span><% } %><% if (doc.pending) { %> <span class="pf-tag pf-tag--wait">Waiting for approval</span><% } %>
          <div class="pf-doc__actions"><a href="<%= links.test.replace('{id}', doc.attemptId) %>"><%= doc.full ? 'Open with answers' : 'Open' %></a><a href="<%= links.test.replace('{id}', doc.attemptId) + (links.test.includes('?') ? '&' : '?') %>download=1">Download PDF</a></div></div>
      </article>
      <% }) %>
    </div>
    <% } %>
  </section>

  <% if (!_child) { %>
  <section class="pf-section" aria-labelledby="pf-work">
    <h2 id="pf-work">Assessments &amp; assignments</h2>
    <% if (_labels) { %><p class="pf-key"><span class="pf-key__item"><span class="pf-tag pf-tag--doc">Documented</span> Testing Room, with PDF</span><span class="pf-key__item"><span class="pf-tag pf-tag--undoc">Undocumented</span> entered by the teacher</span></p><% } %>
    <% if (!data.subjects.length) { %>
      <div class="pf-empty">No assessments or assignments this term yet.</div>
    <% } %>
    <% data.subjects.forEach((subject) => { const _done = subject.items.filter((i) => i.score !== null || i.choice).length; %>
    <% const _docCount = subject.items.filter((i) => i.record === 'documented').length; %>
    <% if (_staff) { %><details class="pf-subject pf-subject--fold"><summary><h3><span><%= subject.name %></span> <small><%= _done %> of <%= subject.items.length %> marked<%= _labels ? ' · ' + _docCount + ' documented' : '' %></small></h3></summary><% } else { %><div class="pf-subject">
      <h3><%= subject.name %> <small><%= _done %> of <%= subject.items.length %> marked</small></h3><% } %>
      <% subject.items.forEach((item) => { %>
      <div class="pf-row">
        <span class="pf-row__icon pf-row__icon--<%= item.kind %>"><%- navIcon(item.kind === 'test' ? 'questions' : item.kind === 'assignment' ? 'homework' : 'grading') %></span>
        <div style="min-width:0"><strong><%= item.title %></strong><small><%= [item.category, item.due ? 'Due ' + _fmt(item.due) : ''].filter(Boolean).join(' · ') %><% if (item.attemptId && !_labels) { %> · <a href="<%= links.test.replace('{id}', item.attemptId) %>">Marked test</a><% } %></small>
          <% if (_labels && item.record) { %><span class="pf-tags">
            <% if (item.record === 'documented') { %><span class="pf-tag pf-tag--doc">Documented</span><% if (item.attemptId) { %><a class="pf-tag-link" href="<%= links.test.replace('{id}', item.attemptId) %>">View test</a><a class="pf-tag-link" href="<%= links.test.replace('{id}', item.attemptId) + (links.test.includes('?') ? '&' : '?') %>download=1">PDF</a><% } %>
            <% } else { %><span class="pf-tag pf-tag--undoc" title="The mark was entered by the teacher; there's no copy of the work">Undocumented</span><% } %>
            <% if (item.pending) { %><span class="pf-tag pf-tag--wait">Waiting for approval</span><% } %>
          </span><% } %></div>
        <% if (item.choice) { %>
          <span class="pf-score"><strong><%= item.choice %></strong></span>
        <% } else if (item.score !== null) { %>
          <span class="pf-score"><strong><%= _num(item.score) %></strong><small> / <%= _num(item.maxScore) %><%= item.percent !== null ? ' · ' + item.percent + '%' : '' %></small></span>
        <% } else { %>
          <span class="pf-score pf-score--none">Not marked yet</span>
        <% } %>
      </div>
      <% }) %>
    <% if (_staff) { %></details><% } else { %></div><% } %>
    <% }) %>
  </section>
  <% } %>
<% } %>
