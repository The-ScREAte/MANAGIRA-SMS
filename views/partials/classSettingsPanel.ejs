<%# Class Tools › Class settings (feature class_settings): what this class uses (lunch, student portal),
    who each item is shared with (parents, students), the class's weekly briefing and the school's
    attendance calendar, all on one page. `panel` comes from controllers/classSettingsController.js
    classroomPanel (null when the person can't manage this class); public/js/classSettings.js saves
    each switch as it changes. The class's weekly briefing is drawn in these same rows
    (public/js/classBriefing.js saves them through routes/briefingRoute.js). %>
<% const _cs = panel; %>
<% const _briefing = Boolean(locals.featureOn && featureOn('weekly_briefing') && locals.workspaceAccess && workspaceAccess().management.briefing); /* managers only */ %>
<section class="workspace-panel" id="panel-settings" data-panel-key="settings">
  <link rel="stylesheet" href="<%= assetUrl('/css/classSettings.css') %>" />
  <div class="cset cset--wide" data-class-settings data-save-url="<%= _cs.saveUrl %>" data-class-id="<%= classId %>" data-from="classroom" data-can-lock="<%= _cs.canLock ? "1" : "" %>">
    <header class="cset-top">
      <p class="cset-status" data-cs-status role="status" aria-live="polite"></p>
    </header>
    <% if (!_cs.ready) { %>
      <p class="cset-note" role="status">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>
        <span>Class settings are still being set up for your school. Everything stays on and shared until then.</span>
      </p>
    <% } else { %>
    <div class="cset-layout">
      <div class="cset-stack">
        <% if (_cs.classSwitches.length) { %>
        <div class="cset-card">
          <ul class="cset-list cset-list--first">
            <% _cs.classSwitches.forEach((item) => { const _id = 'cset-' + item.key.replace(/\W/g, '-'); const _off = item.locked && !_cs.canLock; %>
            <li class="cset-row" data-cs-row title="<%= item.help %>">
              <label class="cset-row__label" for="<%= _id %>"><%= item.label %></label>
              <p class="cset-msg" data-cs-msg role="status" aria-live="polite"></p>
              <span class="cset-cells"><span class="cset-cell">
                <span class="cset-switch">
                  <input type="checkbox" role="switch" id="<%= _id %>" data-cs-key="<%= item.key %>" <%= item.on ? 'checked' : '' %> <%= _off ? 'disabled' : '' %> />
                  <span class="cset-switch__track" aria-hidden="true"></span>
                </span>
              </span></span>
              <%- include('classSettingsLock', { locked: item.locked, keys: [item.key], canLock: _cs.canLock, classId: classId, isAll: false }) %>
            </li>
            <% }) %>
          </ul>
        </div>
        <% } %>

        <div class="cset-card">
          <div class="cset-card__head"><h3 class="cset-card__title">Share with</h3></div>
          <ul class="cset-list">
            <li class="cset-row cset-colhead"><span class="cset-row__label"></span><span class="cset-cells"><% (_cs.share[0] ? _cs.share[0].boxes : []).forEach((box) => { %><span class="cset-cell"><%= box.label %></span><% }) %></span><span class="cset-lockslot"></span></li>
            <% _cs.share.forEach((item) => { const _off = item.locked && !_cs.canLock; %>
            <li class="cset-row" data-cs-row title="<%= item.help %>">
              <span class="cset-row__label"><%= item.label %></span>
              <p class="cset-msg" data-cs-msg role="status" aria-live="polite"></p>
              <span class="cset-cells">
                <% item.boxes.forEach((box) => { %>
                <label class="cset-cell">
                  <span class="cset-switch">
                    <input type="checkbox" role="switch" data-cs-key="<%= box.key %>" aria-label="<%= item.label %> · <%= box.label %>" <%= box.on ? 'checked' : '' %> <%= _off ? 'disabled' : '' %> />
                    <span class="cset-switch__track" aria-hidden="true"></span>
                  </span>
                </label>
                <% }) %>
              </span>
              <%- include('classSettingsLock', { locked: item.locked, keys: item.lockKeys, canLock: _cs.canLock, classId: classId, isAll: false }) %>
            </li>
            <% }) %>
          </ul>
        </div>

        <% if (_cs.notices) { %>
        <div class="cset-card">
          <div class="cset-card__head"><h3 class="cset-card__title">Attendance notices</h3></div>
          <%- include('classNoticeRows', { notices: _cs.notices, classId: classId }) %>
        </div>
        <% } %>
        <% const _wb = _cs.weeklyBriefing; %>
        <% if (_briefing && _wb) { %>
        <%# The class's weekly briefing, in the same rows as everything above; each switch saves as it changes
            (public/js/classBriefing.js). Off: the class follows the school's choices and the rows only show them. %>
        <div class="cset-card" data-brief data-brief-url="<%= _wb.url %>">
          <div class="cset-card__head"><h3 class="cset-card__title">Weekly briefing</h3></div>
          <ul class="cset-list cset-list--first">
            <li class="cset-row" data-cs-row title="Off: this class gets what the school chose. Sent every <%= _wb.sent %>.">
              <label class="cset-row__label" for="cset-brief-own">Choose for this class</label>
              <p class="cset-msg" data-cs-msg role="status" aria-live="polite"></p>
              <span class="cset-cells"><span class="cset-cell">
                <span class="cset-switch">
                  <input type="checkbox" role="switch" id="cset-brief-own" data-brief-own <%= _wb.own ? 'checked' : '' %> />
                  <span class="cset-switch__track" aria-hidden="true"></span>
                </span>
              </span></span>
              <span class="cset-lockslot"></span>
            </li>
          </ul>
          <ul class="cset-list<%= _wb.own ? '' : ' is-readonly' %>" data-brief-rows>
            <li class="cset-row cset-colhead"><span class="cset-row__label"></span><span class="cset-cells"><span class="cset-cell">Parents</span><span class="cset-cell">Students</span></span><span class="cset-lockslot"></span></li>
            <li class="cset-row" data-cs-row>
              <span class="cset-row__label">Send the weekly briefing</span>
              <p class="cset-msg" data-cs-msg role="status" aria-live="polite"></p>
              <span class="cset-cells">
                <% ['parents', 'students'].forEach((audience) => { %>
                <label class="cset-cell">
                  <span class="cset-switch">
                    <input type="checkbox" role="switch" name="<%= audience %>_on" data-brief-school="<%= _wb.school[audience].on ? '1' : '' %>" aria-label="Send the weekly briefing to <%= audience %>" <%= _wb.settings[audience].on ? 'checked' : '' %> <%= _wb.own ? '' : 'disabled' %> />
                    <span class="cset-switch__track" aria-hidden="true"></span>
                  </span>
                </label>
                <% }) %>
              </span>
              <span class="cset-lockslot"></span>
            </li>
            <% _wb.sections.forEach((section) => { %>
            <li class="cset-row" data-cs-row>
              <span class="cset-row__label"><%= section.label %></span>
              <p class="cset-msg" data-cs-msg role="status" aria-live="polite"></p>
              <span class="cset-cells">
                <% ['parents', 'students'].forEach((audience) => { %>
                <% if (section.audiences.includes(audience)) { %>
                <label class="cset-cell">
                  <span class="cset-switch">
                    <input type="checkbox" role="switch" name="<%= audience %>_<%= section.key %>" data-brief-school="<%= _wb.school[audience].sections[section.key] ? '1' : '' %>" aria-label="<%= section.label %> for <%= audience %>" <%= _wb.settings[audience].sections[section.key] ? 'checked' : '' %> <%= _wb.own ? '' : 'disabled' %> />
                    <span class="cset-switch__track" aria-hidden="true"></span>
                  </span>
                </label>
                <% } else { %>
                <span class="cset-cell cset-cell--end cset-cell--na" aria-label="Not sent to <%= audience %>">—</span>
                <% } %>
                <% }) %>
              </span>
              <span class="cset-lockslot"></span>
            </li>
            <% }) %>
          </ul>
        </div>
        <% } %>
        <%- include('classSettingsCalendar', { calendar: _cs.calendar, fromHub: false }) %>
      </div>
    </div>
    <% } %>
  </div>
  <script src="<%= assetUrl('/js/classSettings.js') %>" defer></script>
  <script src="<%= assetUrl('/js/classBriefing.js') %>" defer></script>
  <script src="<%= assetUrl('/js/classNotices.js') %>" defer></script>
</section>
