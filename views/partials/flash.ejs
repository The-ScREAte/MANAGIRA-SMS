<%
  const flashSource = {
    error: Array.isArray(messages?.error) ? messages.error : [],
    info: Array.isArray(messages?.info) ? messages.info : [],
    success: Array.isArray(messages?.success) ? messages.success : [],
  };

  const flashOrder = ['error', 'info', 'success'];
  const ignorePatterns = [
    /\bwelcome\b/i,
    /\bwelcome\s+back\b/i,
  ];

  const seenFlashKeys = new Set();
  const normalizedFlashes = [];

  flashOrder.forEach((type) => {
    flashSource[type].forEach((rawMessage) => {
      const text = String(rawMessage || '').trim();
      if (!text) return;
      if (ignorePatterns.some((pattern) => pattern.test(text))) return;

      const dedupeKey = text.toLowerCase();
      if (seenFlashKeys.has(dedupeKey)) return;
      seenFlashKeys.add(dedupeKey);

      normalizedFlashes.push({ type, text, key: dedupeKey });
    });
  });
%>

<div class="flash-wrapper">
  <% normalizedFlashes.forEach((item) => { %>
    <div class="flash-message <%= item.type %>" data-flash-key="<%= item.key %>">
      <span class="flash-content"><%= item.text %></span>
      <span class="flash-close" aria-label="Close">&times;</span>
    </div>
  <% }); %>
</div>

<script>
(function () {
  if (window.__managiraFlashInitialized) return;
  window.__managiraFlashInitialized = true;

  document.addEventListener('DOMContentLoaded', function () {
    const flashMessages = Array.from(document.querySelectorAll('.flash-message'));
    if (!flashMessages.length) return;

    const seen = new Set();
    flashMessages.forEach((msg) => {
      const key = String(msg.getAttribute('data-flash-key') || '').trim().toLowerCase() ||
        String((msg.querySelector('.flash-content')?.textContent || '')).trim().toLowerCase();
      if (!key) return;
      if (seen.has(key)) {
        msg.remove();
        return;
      }
      seen.add(key);
    });

    const activeMessages = Array.from(document.querySelectorAll('.flash-message'));

    function dismissFlash(msg) {
      msg.style.transition = 'transform 0.24s ease, opacity 0.24s ease';
      msg.style.transform = 'translateY(6px)';
      msg.style.opacity = '0';
      setTimeout(function () {
        msg.style.display = 'none';
      }, 240);
    }

    activeMessages.forEach(function (msg) {
      const isError = msg.classList.contains('error');
      const timeoutMs = isError ? 8000 : 5000;
      setTimeout(function () {
        dismissFlash(msg);
      }, timeoutMs);
    });

    activeMessages.forEach(function (msg) {
      msg.style.cursor = 'pointer';
      msg.addEventListener('click', function (event) {
        const target = event.target;
        if (target && target.tagName === 'A') return;
        dismissFlash(msg);
      });

      let startY = null;
      msg.addEventListener('touchstart', function (event) {
        if (event.touches && event.touches.length === 1) {
          startY = event.touches[0].clientY;
        }
      }, { passive: true });

      msg.addEventListener('touchmove', function (event) {
        if (startY === null || !event.touches || event.touches.length !== 1) return;
        const deltaY = event.touches[0].clientY - startY;
        if (deltaY < -35) {
          dismissFlash(msg);
          startY = null;
        }
      }, { passive: true });

      msg.addEventListener('touchend', function () {
        startY = null;
      }, { passive: true });
    });

    document.querySelectorAll('.flash-close').forEach(function (btn) {
      btn.addEventListener('click', function (e) {
        e.preventDefault();
        e.stopPropagation();
        const parent = btn.closest('.flash-message');
        if (parent) dismissFlash(parent);
      });
    });
  });
})();
</script>
  