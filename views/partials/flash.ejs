
<div class="flash-wrapper">
  <% if (messages.success && messages.success.length > 0) { %>
    <% messages.success.forEach(msg => { %>
      <div class="flash-message success">
        <span class="flash-content"><%= msg %></span>
        <span class="flash-close" aria-label="Close">&times;</span>
      </div>
    <% }); %>
  <% } %>

  <% if (messages.error && messages.error.length > 0) { %>
    <% messages.error.forEach(msg => { %>
      <div class="flash-message error">
        <span class="flash-content"><%= msg %></span>
        <span class="flash-close" aria-label="Close">&times;</span>
      </div>
    <% }); %>
  <% } %>

  <% if (messages.info && messages.info.length > 0) { %>
    <% messages.info.forEach(msg => { %>
      <div class="flash-message info">
        <span class="flash-content"><%= msg %></span>
        <span class="flash-close" aria-label="Close">&times;</span>
      </div>
    <% }); %>
  <% } %>
</div>

<script>
// Dismiss flash on X click
document.addEventListener('DOMContentLoaded', function() {
  document.querySelectorAll('.flash-close').forEach(function(btn) {
    btn.addEventListener('click', function(e) {
      var parent = btn.closest('.flash-message');
      if (parent) parent.style.display = 'none';
    });
  });

  // Swipe up to dismiss (mobile)
  document.querySelectorAll('.flash-message').forEach(function(msg) {
    let startY = null;
    msg.addEventListener('touchstart', function(e) {
      if (e.touches.length === 1) startY = e.touches[0].clientY;
    });
    msg.addEventListener('touchmove', function(e) {
      if (startY !== null) {
        let deltaY = e.touches[0].clientY - startY;
        if (deltaY < -40) { // swipe up
          msg.style.transition = 'transform 0.3s, opacity 0.3s';
          msg.style.transform = 'translateY(-100px)';
          msg.style.opacity = '0';
          setTimeout(function() { msg.style.display = 'none'; }, 300);
          startY = null;
        }
      }
    });
    msg.addEventListener('touchend', function() { startY = null; });
  });
});
</script>
  