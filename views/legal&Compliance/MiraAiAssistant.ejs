<style>
  :root {
    --font-family: "<%= (session && session.fontStyle ? String(session.fontStyle).trim() : 'Inter') %>", sans-serif;
    --primary: #01535b;
    --primary-hover: #014a51;
    --primary-light: #e8f4f5;
    --border: #e5e7eb;
    --text: #1f2937;
    --text-muted: #6b7280;
    --bg: #f9fafb;
  }

  body {
    font-family: var(--font-family);
    color: var(--text);
    margin: 0;
    background-color: var(--bg);
    line-height: 1.7;
    box-sizing: border-box;
  }

  *, *::before, *::after { box-sizing: border-box; }

  .mira-page {
    max-width: 1140px;
    margin: 0 auto;
    padding: 100px 20px 60px;
  }

  .mira-hero-section {
    position: relative;
    display: flex;
    align-items: center;
    gap: 28px;
    padding: 44px 40px;
    border-radius: 20px;
    margin-bottom: 40px;
    color: #fff;
    background: linear-gradient(135deg, var(--primary) 0%, var(--primary-hover) 100%);
    overflow: hidden;
  }
  .mira-hero-section::before, .mira-hero-section::after {
    content: ""; position: absolute; border-radius: 50%;
    background: rgba(255,255,255,0.08);
  }
  .mira-hero-section::before { width: 280px; height: 280px; top: -140px; right: -80px; }
  .mira-hero-section::after { width: 180px; height: 180px; bottom: -100px; right: 160px; }

  .mira-hero-logo { position: relative; z-index: 1; flex-shrink: 0; }
  .mira-hero-logo img {
    width: 96px; height: 96px; object-fit: contain;
    filter: drop-shadow(0 6px 16px rgba(0,0,0,0.25));
  }

  .mira-hero-copy { position: relative; z-index: 1; }
  .mira-hero-eyebrow {
    display: inline-flex; align-items: center; gap: 6px;
    font-size: 0.76rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em;
    background: rgba(255,255,255,0.16); border-radius: 999px; padding: 4px 12px; margin-bottom: 14px;
  }
  .mira-hero-copy h1 { margin: 0 0 12px; font-size: 2.1rem; font-weight: 700; letter-spacing: -0.01em; }
  .mira-hero-copy p { margin: 0 0 20px; color: rgba(255,255,255,0.88); font-size: 1.02rem; max-width: 560px; }
  .mira-hero-ctas { display: flex; gap: 12px; flex-wrap: wrap; }
  .mira-hero-ctas a {
    display: inline-block; padding: 11px 24px; border-radius: 8px;
    text-decoration: none; font-weight: 600; font-size: 0.92rem; transition: opacity 0.2s, background 0.2s;
  }
  .mira-hero-cta-primary { background: #fff; color: var(--primary); }
  .mira-hero-cta-primary:hover { opacity: 0.92; }
  .mira-hero-cta-secondary { background: rgba(255,255,255,0.14); color: #fff; border: 1px solid rgba(255,255,255,0.35); }
  .mira-hero-cta-secondary:hover { background: rgba(255,255,255,0.22); }

  .mira-section {
    background: #fff;
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 28px 28px 24px;
    margin-bottom: 20px;
  }

  .mira-section h2 {
    font-size: 1.28rem;
    font-weight: 700;
    color: var(--primary);
    margin: 0 0 16px;
  }

  .mira-feature-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 18px;
  }
  .mira-feature-card {
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 18px 20px;
  }
  .mira-feature-card .mira-feature-icon {
    width: 34px; height: 34px; border-radius: 9px;
    display: flex; align-items: center; justify-content: center;
    background: var(--primary-light); color: var(--primary);
    margin-bottom: 10px;
  }
  .mira-feature-card h3 { margin: 0 0 6px; font-size: 1rem; color: var(--text); }
  .mira-feature-card p { margin: 0; font-size: 0.9rem; color: var(--text-muted); line-height: 1.55; }

  .mira-trust-list { list-style: none; margin: 0; padding: 0; display: grid; gap: 14px; }
  .mira-trust-list li { display: flex; align-items: flex-start; gap: 12px; font-size: 0.95rem; color: var(--text); line-height: 1.6; }
  .mira-trust-icon {
    flex-shrink: 0; width: 22px; height: 22px; border-radius: 50%; margin-top: 1px;
    background: var(--primary-light); color: var(--primary);
    display: flex; align-items: center; justify-content: center; font-size: 0.72rem; font-weight: 700;
  }

  .cta-card {
    background: var(--primary);
    border-radius: 12px;
    padding: 32px 28px;
    text-align: center;
    margin-top: 24px;
    margin-bottom: 40px;
  }
  .cta-card h3 { color: #fff; font-size: 1.2rem; font-weight: 700; margin: 0 0 8px; }
  .cta-card p { color: rgba(255,255,255,0.85); font-size: 0.95rem; margin: 0 0 16px; line-height: 1.6; }
  .cta-card a {
    display: inline-block; padding: 10px 28px; background: #fff; color: var(--primary);
    border-radius: 8px; text-decoration: none; font-weight: 600; font-size: 0.92rem; transition: opacity 0.2s;
  }
  .cta-card a:hover { opacity: 0.9; }

  @media (max-width: 768px) {
    .mira-page { padding: 100px 20px 60px; }
    .mira-hero-section { flex-direction: column; align-items: flex-start; padding: 32px 24px; margin: 0 12px 32px; }
    .mira-section { padding: 20px 18px; margin: 0 12px 24px; }
    .mira-feature-grid { grid-template-columns: 1fr; }
    .cta-card { padding: 24px 20px; margin: 0 12px 40px; }
  }

  @media (max-width: 480px) {
    .mira-page { padding: 110px 16px 50px; }
    .mira-hero-section { margin: 0 8px 28px; padding: 26px 18px; }
    .mira-hero-copy h1 { font-size: 1.55rem; }
    .mira-hero-logo img { width: 72px; height: 72px; }
    .mira-section { padding: 16px 14px; border-radius: 10px; margin: 0 8px 24px; }
    .mira-section h2 { font-size: 1.05rem; }
    .cta-card { padding: 20px 16px; border-radius: 10px; margin: 0 8px 40px; }
  }

  /* Marketing hero treatment shared with the public homepage. */
  html, body { background: #000; }
  main.mira-page { max-width: none; padding: 0; margin: 0; width: 100%; }
  .mira-hero-section {
    position: relative;
    min-height: 500px;
    margin: 0;
    padding: 92px 24px 18px;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    align-items: center;
    text-align: center;
    border-radius: 0;
    background:
      radial-gradient(65% 60% at 50% 34%, rgba(20, 111, 180, 0.34), transparent 68%),
      radial-gradient(55% 48% at 88% 88%, rgba(1, 83, 91, 0.54), transparent 72%),
      #000;
    isolation: isolate;
    z-index: 2;
  }
  .mira-hero-section::before {
    width: 100%; height: 100%; top: 0; right: 0; border-radius: 0;
    background: repeating-linear-gradient(115deg, rgba(255,255,255,0.045) 0 1px, transparent 1px 15px);
    opacity: .45;
  }
  .mira-hero-section::after { width: 70%; height: 70%; right: 15%; bottom: -35%; background: rgba(46,255,251,.08); filter: blur(80px); }
  .mira-hero-logo { position: relative; z-index: 1; width: clamp(360px, 92vw, 1400px); max-width: 98vw; }
  .mira-hero-logo::before {
    content: "";
    position: absolute;
    z-index: 0;
    left: 8%;
    right: 8%;
    top: 34%;
    bottom: -34%;
    background:
      radial-gradient(ellipse at 50% 100%, rgba(46, 255, 251, .26), transparent 67%),
      radial-gradient(ellipse at 50% 42%, rgba(20, 111, 180, .24), transparent 70%);
    filter: blur(34px);
    opacity: .9;
  }
  .mira-hero-logo img {
    position: relative;
    z-index: 2;
    display: block; width: 100%; height: auto; object-fit: contain;
    filter: drop-shadow(0 12px 24px rgba(0, 190, 255, .24));
  }
  .mira-hero-feather {
    position: absolute;
    z-index: 3;
    left: 0; right: 0; bottom: 0; height: 28%;
    background: linear-gradient(to top, #000 0%, rgba(0,0,0,.7) 35%, rgba(0,0,0,.3) 68%, transparent 100%);
    pointer-events: none;
  }
  .mira-hero-copy { position: relative; z-index: 1; max-width: 820px; }
  .mira-hero-eyebrow { display: none; }
  .mira-hero-copy h1 { margin: 0; color: rgba(255,255,255,.88); font-family: Georgia, 'Times New Roman', serif; font-size: 1.45rem; line-height: 1.25; font-weight: 400; }
  .mira-hero-copy h1 strong { color: #2efffb; }
  .mira-hero-copy p:not(.mira-intro-blurb) { display: none; }
  .mira-hero-ctas { justify-content: center; margin-top: 18px; }
  @media (min-width: 901px) {
    .mira-hero-ctas { margin-top: 44px; }
  }
  .mira-hero-copy p.mira-intro-blurb {
    display: block;
    max-width: 620px;
    margin: 40px auto 0;
    color: #9aa0a8;
    font-size: 0.98rem;
    line-height: 1.65;
    text-align: center;
    font-style: italic;
  }
  .mira-hero-ctas a { padding: 11px 24px; border-radius: 7px; text-decoration: none; font-weight: 600; font-size: 0.92rem; }
  .mira-hero-cta-primary { background: #fff; color: #000; }
  .mira-hero-cta-secondary { display: none; }
  .mira-hero-cta-docs {
    background: rgba(255,255,255,.08);
    color: #fff;
    border: 1px solid rgba(46,255,251,.35);
    transition: background .2s ease, border-color .2s ease;
  }
  .mira-hero-cta-docs:hover { background: rgba(46,255,251,.12); border-color: #2efffb; }
  .mira-intro-section {
    position: relative;
    padding: 0 0 42px;
    text-align: center;
    background: #000;
    isolation: isolate;
  }
  .mira-intro-section .mira-hero-copy { position: relative; z-index: 1; margin: 0 auto; padding: 0 24px; }
  .mira-section, .cta-card { max-width: 1760px; margin-left: auto; margin-right: auto; border: 0; border-radius: 0; background: #000; }
  .mira-section { padding: 72px 24px; }
  .mira-section h2, .mira-feature-card h3 { color: #fff; }
  .mira-section h2 { font-size: 2rem; }
  .mira-feature-card { border-color: rgba(255,255,255,.08); background: #22252a; }
  .mira-feature-card p, .mira-trust-list li { color: #b0b3b8; }
  .mira-feature-card .mira-feature-icon, .mira-trust-icon { background: rgba(46,255,251,.08); color: #2efffb; }
  /* Closing call to action: part of the page (not a separate grey band), with
     a thin line above it, so it doesn't stack on the footer's own one. */
  .cta-card { max-width: none; padding: 64px 24px 72px; margin-top: 0; margin-bottom: 0; background: #000; border-top: 1px solid rgba(255,255,255,.08) !important; }
  .cta-card h3 { font-size: 1.5rem; letter-spacing: -.01em; }
  .cta-card p { max-width: 520px; margin-left: auto; margin-right: auto; color: #9aa0a8; }

  .mira-showcase-section {
    position: relative;
    background: #000;
    max-width: 1760px;
    margin: 0 auto;
    padding: 0 24px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .mira-showcase-desktop {
    width: min(1360px, 100%);
    border-radius: 14px;
    overflow: hidden;
    border: 1px solid rgba(255,255,255,.1);
    box-shadow: 0 30px 80px -20px rgba(0,0,0,.7);
  }
  .mira-showcase-desktop img { display: block; width: 100%; height: auto; }

  .mira-capabilities-section {
    background: #000;
    max-width: 1360px;
    margin: 0 auto;
    padding: 70px 24px 100px;
    text-align: center;
  }
  .mira-capabilities-bolt {
    display: inline-block;
    width: 40px;
    height: 40px;
    margin-bottom: 18px;
    color: #fff;
    filter: drop-shadow(0 0 12px rgba(255,255,255,.55));
  }
  .mira-capabilities-bolt svg { width: 100%; height: 100%; display: block; }
  @media (prefers-reduced-motion: no-preference) {
    .mira-capabilities-bolt { animation: miraBoltPulse 2.4s ease-in-out infinite; }
  }
  @keyframes miraBoltPulse {
    0%, 100% { transform: scale(1); opacity: 1; }
    50% { transform: scale(1.16); opacity: .75; }
  }
  .mira-capabilities-section h2 {
    color: #fff; font-family: Georgia, 'Times New Roman', serif; font-weight: 400;
    font-size: 2.4rem; margin: 0 0 14px;
  }
  .mira-capabilities-subtitle { color: #9aa0a8; font-size: 1.02rem; max-width: 520px; margin: 0 auto 60px; }
  .mira-capabilities-doc-link {
    display: inline-block; margin-top: 44px;
    color: #2efffb; font-size: 0.95rem; font-weight: 600; text-decoration: none;
    border-bottom: 1px solid rgba(46,255,251,.35); padding-bottom: 2px;
  }
  .mira-capabilities-doc-link:hover { border-bottom-color: #2efffb; }
  .mira-capabilities-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    text-align: left;
  }
  .mira-capability {
    padding: 28px 32px;
    border-top: 1px solid rgba(255,255,255,.1);
    border-left: 1px solid rgba(255,255,255,.1);
  }
  .mira-capability:nth-child(3n+1) { border-left: none; }
  .mira-capability:nth-child(-n+3) { border-top: none; }
  .mira-capability-icon { display: block; color: #9aa0a8; margin-bottom: 20px; }
  .mira-capability h3 { color: #fff; font-size: 1.02rem; font-weight: 600; margin: 0 0 8px; }
  .mira-capability p { color: #9aa0a8; font-size: 0.9rem; line-height: 1.6; margin: 0; }

  @media (max-width: 760px) {
    .mira-capabilities-grid { grid-template-columns: 1fr; }
    .mira-capability { border-left: none !important; padding: 24px 4px; }
    .mira-capability:nth-child(-n+3) { border-top: 1px solid rgba(255,255,255,.1); }
    .mira-capability:first-child { border-top: none !important; }
    .mira-showcase-section { padding-bottom: 60px; }
  }

  @media (max-width: 600px) {
    .mira-capabilities-section { padding-top: 56px !important; padding-bottom: 48px !important; }
    .mira-capabilities-subtitle { margin-bottom: 28px !important; font-size: .98rem !important; }
    .mira-capability { padding: 20px 2px !important; }
    .mira-capability-icon { margin-bottom: 12px !important; }
    .cta-card { padding: 48px 20px 56px !important; margin: 0 !important; border-radius: 0 !important; }
    .cta-card h3 { font-size: 1.3rem; }
    .mira-hero-section { min-height: 230px; padding: 44px 18px 8px; justify-content: flex-end; }
    .mira-hero-logo { width: 94vw; }
    .mira-hero-copy h1 { font-size: 1rem; }
    .mira-intro-section { padding: 0 0 28px; }
    .mira-section { padding: 52px 18px; }
  }

</style>

<link rel="stylesheet" href="/css/index.css" />
<link rel="stylesheet" href="/css/mira-public.css" />

<main class="mira-page">
  <div class="mira-hero-section">
    <div class="mira-hero-logo">
      <img src="/images/miratext.png" alt="Mira" />
    </div>
    <div class="mira-hero-feather"></div>
  </div>

  <section class="mira-intro-section">
    <div class="mira-hero-copy">
      <span class="mira-hero-eyebrow">&#10024; Mira AI Assistant</span>
      <h1>The educational intelligence for easy management.</h1>
      <p class="mira-intro-blurb">Mira completes tasks you can steer from anywhere in your workspace. Give it a goal, and it works across your students, classes, and records. You come back to polished work, ready for your review.</p>
      <div class="mira-hero-ctas">
        <a class="mira-hero-cta-primary" href="/legal/request-demo">Request a demo</a>
        <a class="mira-hero-cta-docs" href="https://managira.com/legal/user-documentation/mira-ai-assistant">Read the docs</a>
      </div>
    </div>
  </section>

  <section class="mira-showcase-section">
    <div class="mira-showcase-desktop">
      <img src="/images/mira%20uigigscreen.png" alt="Mira chat interface" loading="lazy" decoding="async" onerror="this.onerror=null;this.src='/images/image.png';" />
    </div>
  </section>

  <section class="mira-capabilities-section">
    <span class="mira-capabilities-bolt">
      <svg viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg">
        <path d="M13 2 4 14h6l-1 8 9-12h-6l1-8z"/>
      </svg>
    </span>
    <h2>Core capabilities</h2>
    <p class="mira-capabilities-subtitle">Everything Mira does, it does inside your own workspace - never a separate tool to learn.</p>
    <div class="mira-capabilities-grid">
      <div class="mira-capability">
        <span class="mira-capability-icon">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M9 11l3 3L22 4"/><path d="M21 12v7a2 2 0 01-2 2H5a2 2 0 01-2-2V5a2 2 0 012-2h11"/></svg>
        </span>
        <h3>Say what, not how</h3>
        <p>Ask for what you need in plain language. Mira works out which records to look up and which pages it would have taken to get there.</p>
      </div>
      <div class="mira-capability">
        <span class="mira-capability-icon">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M18 8A6 6 0 006 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 01-3.46 0"/></svg>
        </span>
        <h3>Drafts, not surprises</h3>
        <p>Messages, reports, and records are drafted for review first. Anything destructive or irreversible gets a warning before it happens.</p>
      </div>
      <div class="mira-capability">
        <span class="mira-capability-icon">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/></svg>
        </span>
        <h3>Knows your school year</h3>
        <p>Terms, classes, and current enrollment are already loaded in - Mira answers against what's actually active right now.</p>
      </div>
      <div class="mira-capability">
        <span class="mira-capability-icon">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 3"/></svg>
        </span>
        <h3>Fast, not eventually</h3>
        <p>Lookups that would take a page hunt come back in a sentence, so a question mid-conversation with a parent doesn't have to wait.</p>
      </div>
      <div class="mira-capability">
        <span class="mira-capability-icon">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2l1.7 5.3L19 9l-5.3 1.7L12 16l-1.7-5.3L5 9l5.3-1.7L12 2z"/></svg>
        </span>
        <h3>Yours alone</h3>
        <p>Every lookup and every action stays inside your own school. Mira never sees or touches another organization's data.</p>
      </div>
      <div class="mira-capability">
        <span class="mira-capability-icon">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M9 12l2 2 4-4"/><circle cx="12" cy="12" r="9"/></svg>
        </span>
        <h3>Only what's granted</h3>
        <p>Mira only ever does what a person's own real, granted permissions already allow - the same rules as the app itself, never more.</p>
      </div>
    </div>
    <a class="mira-capabilities-doc-link" href="https://managira.com/legal/user-documentation/mira-ai-capabilities">Read the full capabilities documentation &rarr;</a>
  </section>

  <section class="mira-demo-section" aria-label="Mira example">
    <div class="mira-demo-card">
      <div class="mira-demo-text">
        <h2>Stats for your school</h2>
        <p>Attendance, fees, and enrollment. A clear answer, without building a report.</p>
      </div>
      <div class="mira-demo-panel-wrap">
        <div class="mira-demo-panel">
          <span class="mira-demo-label">Example conversation</span>
          <div class="mira-demo-chatbar">
            <span>Summarize attendance and fees this term</span>
            <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M21 11.5a8.4 8.4 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.4 8.4 0 0 1-3.8-.9L3 21l1.9-5.7a8.4 8.4 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.4 8.4 0 0 1 3.8-.9H13a8.5 8.5 0 0 1 8 8v.5z"/></svg>
          </div>
          <div class="mira-demo-rows">
            <div class="mira-demo-row"><span class="mira-demo-row-name">Eng 103</span><span class="mira-demo-row-meta">Attendance 96%</span><span class="mira-demo-pill is-good">Good</span></div>
            <div class="mira-demo-row"><span class="mira-demo-row-name">Sc 200</span><span class="mira-demo-row-meta">Attendance 91%</span><span class="mira-demo-pill is-good">Good</span></div>
            <div class="mira-demo-row"><span class="mira-demo-row-name">Math 101</span><span class="mira-demo-row-meta">Fees 82% paid</span><span class="mira-demo-pill is-attention">Attention</span></div>
            <div class="mira-demo-row"><span class="mira-demo-row-name">Hist 201</span><span class="mira-demo-row-meta">Fees 95% paid</span><span class="mira-demo-pill is-good">Good</span></div>
          </div>
          <div class="mira-demo-suggestion">
            <span class="mira-demo-suggestion-icon">
              <svg viewBox="0 0 24 24" fill="currentColor"><path d="M13 2 4 14h6l-1 8 9-12h-6l1-8z"/></svg>
            </span>
            <p>Draft a board meeting summary?</p>
          </div>
        </div>
      </div>
    </div>
  </section>

