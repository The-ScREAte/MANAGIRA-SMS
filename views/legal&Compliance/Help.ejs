<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="<%= locals.viewportContent || 'width=device-width, initial-scale=1.0' %>">
  <title><%= title %></title>
  <meta name="description" content="Managira Help Center — search across documentation, FAQs, and guides, or contact support directly.">
  <meta name="robots" content="noindex, nofollow">
  <link rel="canonical" href="https://managira.com/legal/help">
  <style>
    :root {
      --font-family: "<%= (session && session.fontStyle ? String(session.fontStyle).trim() : 'Inter') %>", sans-serif;
      --primary: #01535b;
      --primary-light: #e8f4f5;
      --border: #e5e7eb;
      --text: #1f2937;
      --text-muted: #6b7280;
      --bg: #f9fafb;
    }

    * { margin: 0; padding: 0; box-sizing: border-box; }

    body {
      font-family: var(--font-family);
      background: var(--bg);
      color: var(--text);
      line-height: 1.6;
    }

    main {
      max-width: 780px;
      margin: 0 auto;
      padding: 0;
    }

    .help-hero {
      text-align: center;
      margin-bottom: 40px;
    }
    .help-hero .eyebrow {
      display: inline-block;
      font-size: 0.72rem;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      color: #b8860b;
      font-weight: 700;
      margin-bottom: 12px;
    }
    h1 {
      color: var(--primary);
      font-size: 2.2rem;
      margin: 0 0 4px;
      letter-spacing: -0.01em;
    }
    .subtitle {
      color: var(--text-muted);
      font-size: 0.95rem;
      margin: 0;
    }

    .legal-section {
      background: #fff;
      border: 1px solid var(--border);
      border-radius: 12px;
      padding: 28px 28px 24px;
      margin-bottom: 20px;
    }

    /* Smart search */
    .search-wrap {
      position: relative;
      margin: 0 0 10px;
    }
    .search-wrap .search-ico {
      position: absolute;
      left: 16px;
      top: 50%;
      transform: translateY(calc(-50% - 6px));
      width: 20px;
      height: 20px;
      pointer-events: none;
      color: #8ea0b9;
      fill: none;
      stroke: currentColor;
      stroke-width: 2.1;
      stroke-linecap: round;
      stroke-linejoin: round;
    }
    #helpSearch {
      width: 100%;
      height: 56px;
      padding: 0 46px 0 58px;
      border: 1px solid var(--border);
      border-radius: 10px;
      font-size: 0.92rem;
      line-height: 1.2;
      font-family: inherit;
      background: #fff;
      box-shadow: 0 2px 8px rgba(15, 23, 42, 0.04);
      transition: border-color 0.2s, box-shadow 0.2s;
    }
    #helpSearch:focus {
      outline: none;
      border-color: #01535b;
      box-shadow: 0 2px 12px rgba(1,83,91,0.10);
    }
    #helpSearchClear {
      position: absolute;
      right: 12px;
      top: 50%;
      transform: translateY(-50%);
      background: #f1f5f9;
      border: none;
      width: 26px;
      height: 26px;
      border-radius: 50%;
      cursor: pointer;
      color: #64748b;
      display: none;
      align-items: center;
      justify-content: center;
      font-size: 16px;
      line-height: 1;
    }
    #helpSearchClear:hover { background: #e2e8f0; color: #0f172a; }

    .search-meta {
      font-size: 0.82rem;
      color: #64748b;
      padding: 0;
      margin: 0;
      min-height: 0;
    }
    .search-meta:empty { display: none; }

    /* Results */
    .results-block { margin-bottom: 28px; }
    .results-block h2 {
      font-size: 0.82rem;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: var(--primary);
      margin: 0 0 12px;
      font-weight: 700;
    }
    .result-card {
      background: #fff;
      border: 1px solid var(--border);
      border-radius: 12px;
      padding: 16px 18px;
      margin-bottom: 10px;
      transition: border-color 0.2s, transform 0.15s, box-shadow 0.2s;
    }
    .result-card:hover {
      border-color: #01535b;
      box-shadow: 0 4px 14px rgba(1,83,91,0.08);
    }
    .result-row {
      display: flex;
      align-items: center;
      gap: 8px;
      margin-bottom: 3px;
    }
    .result-type {
      font-size: 0.68rem;
      font-weight: 700;
      letter-spacing: 0.09em;
      text-transform: uppercase;
      padding: 2px 7px;
      border-radius: 999px;
      flex-shrink: 0;
      line-height: 1.6;
    }
    .result-type--article { background: #e6f4f5; color: #01535b; }
    .result-type--doc     { background: #fef6e0; color: #92400e; }
    .result-type--faq     { background: #ede9fe; color: #4f46e5; }
    .result-card-title {
      font-weight: 600;
      font-size: 0.96rem;
      color: var(--text);
      text-decoration: none;
      line-height: 1.3;
    }
    .result-card-title:hover { color: #01535b; }
    .result-meta-line {
      font-size: 0.85rem;
      color: #64748b;
      margin: 0;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }
    .result-meta-line mark {
      background: #fef3c7;
      color: inherit;
      padding: 0 2px;
      border-radius: 2px;
    }
    .result-cta {
      color: #01535b;
      font-weight: 600;
      text-decoration: none;
      white-space: nowrap;
    }
    .result-cta:hover { text-decoration: underline; }

    .empty-state {
      text-align: center;
      padding: 28px 16px;
      background: #fff;
      border: 1px dashed #cbd5e1;
      border-radius: 12px;
      color: #64748b;
      font-size: 0.92rem;
    }
    .empty-state strong { color: #0f172a; display: block; margin-bottom: 4px; }

    /* Quick links + form */
    .help-links {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 14px;
      margin: 24px 0;
    }
    .help-link, .help-link svg, .help-link span { color: #0f172a; }
    .help-link svg { color: var(--primary); }
    .help-link {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 10px;
      padding: 20px;
      background: white;
      border: 1px solid var(--border);
      border-radius: 12px;
      text-decoration: none;
      color: var(--text);
      transition: all 0.2s;
    }
    .help-link:hover {
      border-color: #01535b;
      box-shadow: 0 4px 12px rgba(1, 83, 91, 0.08);
    }
    .help-link svg { color: #01535b; }
    .help-link span { font-weight: 600; font-size: 0.92rem; text-align: center; }

    .form-title {
      color: #01535b;
      font-size: 1.05rem;
      font-weight: 700;
      margin-bottom: 20px;
    }
    label {
      display: block;
      font-weight: 600;
      font-size: 0.85rem;
      margin-bottom: 6px;
      color: #334155;
    }
    input, textarea {
      width: 100%;
      padding: 11px 14px;
      border: 1px solid #cbd5e1;
      border-radius: 8px;
      font-size: 0.95rem;
      font-family: inherit;
      margin-bottom: 14px;
      transition: border-color 0.2s;
    }
    input:focus, textarea:focus {
      outline: none;
      border-color: #01535b;
    }
    textarea { min-height: 110px; resize: vertical; }
    button[type="submit"] {
      width: 100%;
      padding: 14px;
      background: #01535b;
      color: white;
      border: none;
      border-radius: 10px;
      font-size: 1rem;
      font-weight: 700;
      cursor: pointer;
      transition: background 0.2s;
    }
    button[type="submit"]:hover { background: #014048; }
    button[type="submit"]:disabled { background: #94a3b8; cursor: not-allowed; }

    /* Collapsible contact form */
    .contact-collapse {
      background: #fff;
      border: 1px solid var(--border);
      border-radius: 12px;
      box-shadow: 0 2px 8px rgba(15, 23, 42, 0.04);
      overflow: hidden;
      margin-bottom: 26px;
    }
    .contact-collapse[open] { box-shadow: 0 4px 18px rgba(15, 23, 42, 0.06); }
    .contact-summary {
      list-style: none;
      cursor: pointer;
      padding: 18px 22px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
      user-select: none;
    }
    .contact-summary::-webkit-details-marker { display: none; }
    .contact-summary-text { display: flex; flex-direction: column; gap: 2px; }
    .contact-summary-text strong { color: #01535b; font-size: 1.02rem; font-weight: 700; }
    .contact-summary-text small { color: #64748b; font-size: 0.82rem; }
    .contact-chev { color: #01535b; transition: transform 0.2s ease; flex-shrink: 0; }
    .contact-collapse[open] .contact-chev { transform: rotate(180deg); }
    .contact-form { padding: 4px 22px 24px; }
    .form-intro {
      background: #f1f5f9;
      border-left: 3px solid #01535b;
      border-radius: 8px;
      padding: 12px 14px;
      font-size: 0.88rem;
      color: #475569;
      margin-bottom: 18px;
      line-height: 1.55;
    }
    .form-intro strong { color: #01535b; }
    .msg-hint { font-size: 0.8rem; color: #94a3b8; margin: -8px 0 12px; min-height: 16px; }
    .msg-hint.error { color: #dc2626; }
    .confirm-row {
      display: flex !important;
      align-items: center;
      gap: 8px;
      font-size: 0.88rem;
      color: #475569 !important;
      font-weight: 500 !important;
      margin: 4px 0 14px !important;
      cursor: pointer;
    }
    .confirm-row input[type="checkbox"] { width: 16px; height: 16px; margin: 0; accent-color: #01535b; }

    @media (max-width: 768px) {
      main { padding: 100px 0 40px; }
      .help-hero { margin: 20px 12px 20px; }
      h1 { font-size: 1.8rem; }
      .legal-section { margin: 0 12px 20px; padding: 20px 18px; }
      .contact-collapse { margin: 0 12px 20px; }
      .help-links { grid-template-columns: 1fr 1fr; gap: 12px; }
    }
    @media (max-width: 480px) {
      main { padding: 110px 0 32px; }
      .help-hero { margin: 18px 8px 14px; }
      h1 { font-size: 1.35rem; }
      .subtitle { font-size: 0.88rem; }
      .legal-section { margin: 0 8px 20px; padding: 16px 14px; border-radius: 10px; }
      .contact-collapse { margin: 0 8px 18px; border-radius: 10px; }
      .help-links { grid-template-columns: 1fr 1fr; gap: 10px; }
      .help-link { padding: 10px 8px; gap: 6px; border-radius: 10px; }
      .help-link svg { width: 18px; height: 18px; }
      .help-link span { font-size: 0.8rem; }
      .result-card { padding: 11px 12px; border-radius: 10px; }
      .result-card-title { font-size: 0.9rem; }
      .result-meta-line { font-size: 0.8rem; }
      .contact-summary { padding: 16px 14px; }
      .contact-form { padding: 4px 14px 18px; }
      input, textarea { font-size: 16px; }
      #helpSearch {
        font-size: 16px;
        height: 52px;
        padding-left: 52px;
      }
      .search-wrap .search-ico {
        left: 14px;
        width: 19px;
        height: 19px;
      }
    }
  </style>
</head>
<body>
  <main>
    <div class="help-hero">
      <h1>How can we help?</h1>
      <p class="subtitle">Search anything Managira related.</p>
    </div>

    <div class="legal-section">
      <!-- SMART SEARCH -->
      <div class="search-wrap">
        <svg class="search-ico" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <circle cx="11" cy="11" r="7"></circle>
          <line x1="16.65" y1="16.65" x2="21" y2="21"></line>
        </svg>
        <input type="search" id="helpSearch" placeholder="Search anything Managira related…" autocomplete="off" />
        <button type="button" id="helpSearchClear" aria-label="Clear search">×</button>
      </div>
      <div class="search-meta" id="searchMeta"></div>

      <div id="searchResults" style="display:none;">
        <div class="results-block" id="docResultsBlock" style="display:none;">
          <h2>Documentation &amp; Guides</h2>
          <div id="docResults"></div>
        </div>
        <div class="results-block" id="faqResultsBlock" style="display:none;">
          <h2>From the FAQ</h2>
          <div id="faqResults"></div>
        </div>
        <div class="results-block" id="emptyResultsBlock" style="display:none;">
          <div class="empty-state">
            <strong>No matches found.</strong>
            We couldn't find that yet. Try different keywords, or send us your question below — we'll get back to you.
          </div>
        </div>
      </div>

      <!-- DEFAULT QUICK LINKS (hidden when searching) -->
      <div id="defaultBlock">
        <div class="help-links">
          <a href="/legal/faq" class="help-link">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10"></circle>
              <path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"></path>
              <line x1="12" y1="17" x2="12.01" y2="17"></line>
            </svg>
            <span>FAQ</span>
          </a>
          <a href="/legal/user-documentation" class="help-link">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
              <polyline points="14 2 14 8 20 8"></polyline>
            </svg>
            <span>Documentation</span>
          </a>
          <a href="https://www.youtube.com/@managira" target="_blank" rel="noopener" class="help-link">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <polygon points="5 3 19 12 5 21 5 3"></polygon>
            </svg>
            <span>Video Tutorials</span>
          </a>
          <a href="/legal/request-demo" class="help-link">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
              <line x1="16" y1="2" x2="16" y2="6"></line>
              <line x1="8" y1="2" x2="8" y2="6"></line>
              <line x1="3" y1="10" x2="21" y2="10"></line>
            </svg>
            <span>Request a Demo</span>
          </a>
        </div>
      </div>
    </div>

    <!-- CONTACT FORM (collapsed by default) -->
    <details class="contact-collapse">
      <summary class="contact-summary">
        <span class="contact-summary-text">
          <strong>Still need a hand? Send us a message</strong>
          <small>Click to expand the contact form</small>
        </span>
        <svg class="contact-chev" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg>
      </summary>

      <form action="/legal/help" method="POST" class="contact-form" id="helpContactForm" novalidate>
        <p class="form-intro">
          Before submitting a request, try the search above — it looks across our full documentation, guides, and FAQ for instant answers.
          <br><br>
          For urgent matters, you can also email us directly at <strong>info@managira.com</strong>
        </p>

        <label for="name">Full Name</label>
        <input type="text" id="name" name="name" required autocomplete="name" placeholder="Your full name" maxlength="120">

        <label for="organization">Organisation (optional)</label>
        <input type="text" id="organization" name="organization" autocomplete="organization" placeholder="Which school or organisation?" maxlength="160">

        <label for="phone">Phone Number</label>
        <input type="tel" id="phone" name="phone" required autocomplete="tel" placeholder="+234 801 234 5678" maxlength="40">

        <label for="email">Email Address</label>
        <input type="email" id="email" name="email" required autocomplete="email" placeholder="your@email.com" maxlength="160">

        <label for="message">How can we help? <small style="color:#94a3b8;font-weight:500;">(at least 3 words)</small></label>
        <textarea id="message" name="message" required placeholder="Please describe your issue or question in detail..." minlength="10"></textarea>
        <p id="msgHint" class="msg-hint" aria-live="polite"></p>

        <!-- Honeypot anti-bot field (hidden) -->
        <div style="position:absolute;left:-10000px;top:auto;width:1px;height:1px;overflow:hidden;" aria-hidden="true">
          <label>Leave this field blank<input type="text" name="company_website" tabindex="-1" autocomplete="off"></label>
        </div>
        <input type="hidden" name="form_started_at" id="form_started_at" value="">

        <label class="confirm-row">
          <input type="checkbox" id="confirmHuman" name="confirm_human" required>
          <span>I confirm this is a genuine request, not spam.</span>
        </label>

        <button type="submit" id="helpSubmitBtn">Submit Request</button>
      </form>
    </details>
  </main>

  <script>
    // Smart search across documentation + FAQ
    const KNOWLEDGE = <%- JSON.stringify(typeof helpKnowledge !== 'undefined' ? helpKnowledge : []) %>;
    const DOCS = <%- JSON.stringify(typeof documentationResources !== 'undefined' ? documentationResources : []) %>;

    // Lightweight tokenizer with synonym expansion + stemming
    const SYNONYMS = {
      'sign up': ['register', 'registration', 'signup', 'create account', 'enroll'],
      'register': ['sign up', 'signup', 'create account'],
      'login': ['sign in', 'log in', 'access account'],
      'password': ['credentials', 'reset password', 'forgot password'],
      'student': ['students', 'pupil', 'learner', 'kid', 'child'],
      'parent': ['parents', 'guardian', 'guardians', 'family'],
      'guardian': ['parent', 'family', 'guardian portal'],
      'report': ['report card', 'reports', 'merit sheet', 'transcript', 'result'],
      'grade': ['grades', 'marks', 'score', 'results', 'assessment'],
      'attendance': ['present', 'absent', 'roll call', 'register'],
      'fee': ['fees', 'payment', 'billing', 'subscription', 'invoice'],
      'class': ['classes', 'classroom', 'grade level'],
      'demo': ['demo', 'preview', 'walkthrough', 'tour'],
      'doc': ['documentation', 'guide', 'manual', 'help', 'tutorial'],
      'bulk': ['import', 'csv', 'spreadsheet', 'mass upload'],
      'hub': ['hubs', 'district', 'government', 'multi school'],
      'theme': ['color', 'branding', 'logo', 'personalization', 'personalisation'],
    };

    function expandTokens(query) {
      const base = query.toLowerCase().trim().split(/\s+/).filter(Boolean);
      const expanded = new Set(base);
      // Add full phrase
      expanded.add(query.toLowerCase().trim());
      // Synonym expansion (single tokens and phrases)
      Object.keys(SYNONYMS).forEach(key => {
        if (query.toLowerCase().includes(key)) {
          SYNONYMS[key].forEach(s => expanded.add(s));
        }
      });
      base.forEach(t => {
        if (SYNONYMS[t]) SYNONYMS[t].forEach(s => expanded.add(s));
        // crude stem: drop trailing s
        if (t.length > 3 && t.endsWith('s')) expanded.add(t.slice(0, -1));
      });
      return Array.from(expanded);
    }

    function scoreItem(haystack, tokens) {
      const text = haystack.toLowerCase();
      let score = 0;
      tokens.forEach(t => {
        if (!t) return;
        if (text.includes(t)) score += t.includes(' ') ? 6 : 3;
      });
      return score;
    }

    function shouldSearchFaq(query) {
      const normalized = String(query || '').toLowerCase().replace(/[^a-z0-9\s]+/g, ' ').trim();
      const wordCount = normalized.split(/\s+/).filter(Boolean).length;
      return wordCount >= 4;
    }

    function faqMatchesExactPhrase(item, normalizedQuery) {
      if (!normalizedQuery) return false;
      const question = String(item.question || '').toLowerCase().replace(/[^a-z0-9\s]+/g, ' ').trim();
      const answer = String(item.answer || '').toLowerCase().replace(/[^a-z0-9\s]+/g, ' ').trim();
      const keywords = Array.isArray(item.keywords)
        ? item.keywords.map(function (kw) {
            return String(kw || '').toLowerCase().replace(/[^a-z0-9\s]+/g, ' ').trim();
          })
        : [];

      if (question.includes(normalizedQuery) || answer.includes(normalizedQuery)) {
        return true;
      }

      return keywords.some(function (kw) {
        return kw.includes(normalizedQuery);
      });
    }

    function highlight(text, tokens, max = 220) {
      if (!text) return '';
      let snippet = text;
      // Find first match position to anchor snippet
      let firstIdx = -1;
      for (const t of tokens) {
        if (!t) continue;
        const idx = text.toLowerCase().indexOf(t);
        if (idx !== -1 && (firstIdx === -1 || idx < firstIdx)) firstIdx = idx;
      }
      if (firstIdx > 80) {
        const start = Math.max(0, firstIdx - 60);
        snippet = (start > 0 ? '… ' : '') + text.slice(start, start + max);
      } else {
        snippet = text.slice(0, max);
      }
      if (text.length > snippet.length + (firstIdx > 80 ? 60 : 0)) snippet += '…';

      // Highlight tokens
      tokens
        .filter(Boolean)
        .sort((a,b) => b.length - a.length)
        .forEach(t => {
          if (t.length < 2) return;
          const re = new RegExp('(' + t.replace(/[.*+?^${}()|[\]\\]/g, '\\$&') + ')', 'gi');
          snippet = snippet.replace(re, '<mark>$1</mark>');
        });
      return snippet;
    }

    function escapeHtml(s) {
      return String(s).replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
    }

    function search(q) {
      const tokens = expandTokens(q);
      const normalizedQuery = String(q || '').toLowerCase().replace(/[^a-z0-9\s]+/g, ' ').trim();

      const docHits = DOCS.map(d => {
        const hay = [d.title, d.subtitle, (d.keywords||[]).join(' ')].join(' ');
        return { item: d, score: scoreItem(hay, tokens) };
      }).filter(r => r.score > 0).sort((a,b) => b.score - a.score).slice(0, 6);

      const faqHits = shouldSearchFaq(q)
        ? KNOWLEDGE.filter(function (item) {
            return faqMatchesExactPhrase(item, normalizedQuery);
          })
          .slice(0, 8)
          .map(function (item) {
            return { item: item };
          })
        : [];

      return { docHits, faqHits, tokens };
    }

    // ── Shared doc/article card renderer ──────────────────────────────────
    function renderDocCards(hits, tokens, block, out) {
      if (!hits.length) { block.style.display = 'none'; return; }
      block.style.display = '';
      out.innerHTML = hits.map(function(h) {
        const item      = h.item || h;
        const isArticle = !!item.isArticle;
        const typeCls   = isArticle ? 'result-type--article' : 'result-type--doc';
        const typeLabel = isArticle ? 'Article' : 'Doc';
        const extAttr   = item.external ? 'target="_blank" rel="noopener"' : '';
        const cta       = isArticle ? 'Read article \u2192' : (item.external ? 'Open \u2197' : 'Open \u2192');
        const snippet   = highlight(item.subtitle || '', tokens);
        return `
          <div class="result-card">
            <div class="result-row">
              <span class="result-type ${typeCls}">${typeLabel}</span>
              <a class="result-card-title" href="${escapeHtml(item.url)}" ${extAttr}>${escapeHtml(item.title)}</a>
            </div>
            <p class="result-meta-line">${snippet ? snippet + ' \u00B7 ' : ''}<a class="result-cta" href="${escapeHtml(item.url)}" ${extAttr}>${cta}</a></p>
          </div>`;
      }).join('');
    }

    let _liveAbort = null;

    function render(q) {
      const meta       = document.getElementById('searchMeta');
      const wrap       = document.getElementById('searchResults');
      const def        = document.getElementById('defaultBlock');
      const docBlock   = document.getElementById('docResultsBlock');
      const faqBlock   = document.getElementById('faqResultsBlock');
      const emptyBlock = document.getElementById('emptyResultsBlock');
      const docOut     = document.getElementById('docResults');
      const faqOut     = document.getElementById('faqResults');
      const clearBtn   = document.getElementById('helpSearchClear');

      const trimmed = q.trim();
      if (trimmed.length === 0) {
        wrap.style.display = 'none';
        def.style.display  = '';
        meta.textContent   = '';
        clearBtn.style.display = 'none';
        if (_liveAbort) { _liveAbort.abort(); _liveAbort = null; }
        return;
      }

      clearBtn.style.display = 'flex';
      def.style.display  = 'none';
      wrap.style.display = '';

      const tokens = expandTokens(trimmed);
      const { docHits, faqHits } = search(trimmed);

      // ── FAQ (immediate, local) ─────────────────────────────────────
      if (faqHits.length) {
        faqBlock.style.display = '';
        faqOut.innerHTML = faqHits.map(function(h) {
          const faqUrl  = '/legal/faq?q=' + encodeURIComponent(h.item.question);
          const snippet = highlight(h.item.answer, tokens);
          return `
          <div class="result-card">
            <div class="result-row">
              <span class="result-type result-type--faq">FAQ</span>
              <a class="result-card-title" href="${faqUrl}">${escapeHtml(h.item.question)}</a>
            </div>
            <p class="result-meta-line">${snippet ? snippet + ' \u00B7 ' : ''}<a class="result-cta" href="${faqUrl}">Read full answer \u2192</a></p>
          </div>`;
        }).join('');
      } else {
        faqBlock.style.display = 'none';
      }

      // ── Static doc quick-links (immediate) ───────────────────────────
      renderDocCards(docHits, tokens, docBlock, docOut);

      const localTotal = docHits.length + faqHits.length;
      meta.textContent = localTotal === 0
        ? `Searching "${trimmed}"…`
        : `${localTotal} result${localTotal !== 1 ? 's' : ''} for "${trimmed}"`;
      emptyBlock.style.display = localTotal === 0 ? '' : 'none';

      // ── Live database search (async API) ──────────────────────────────
      if (_liveAbort) _liveAbort.abort();
      if (trimmed.length < 2) return;
      _liveAbort = new AbortController();
      const captureQ      = trimmed;
      const captureTokens = tokens;
      const captureFaqLen = faqHits.length;

      fetch('/legal/user-documentation/api/search?q=' + encodeURIComponent(trimmed), {
        signal: _liveAbort.signal,
        headers: { 'Accept': 'application/json' }
      })
      .then(function(r) { return r.json(); })
      .then(function(data) {
        if (!data.success || !Array.isArray(data.articles)) return;
        _liveAbort = null;

        const articleHits = data.articles.map(function(a) {
          return {
            item: {
              isArticle: true,
              title:     a.title,
              subtitle:  a.seoDescription || a.excerpt || '',
              url:       '/legal/user-documentation/' + a.slug,
              external:  false,
              breadcrumb: [a.topic, a.subtopic].filter(Boolean).join(' / '),
            }
          };
        });

        // Live articles first, then static external quick-links
        const combined = articleHits.concat(
          docHits.filter(function(d) { return d.item.external; })
        );

        renderDocCards(combined, captureTokens, docBlock, docOut);

        const total = combined.length + captureFaqLen;
        meta.textContent = total === 0
          ? `No matches for "${captureQ}".`
          : `${total} result${total !== 1 ? 's' : ''} for "${captureQ}"`;
        emptyBlock.style.display = total === 0 ? '' : 'none';
      })
      .catch(function(e) {
        if (e.name !== 'AbortError') console.warn('Documentation search error:', e);
      });
    }

    const input   = document.getElementById('helpSearch');
    const clearBtn = document.getElementById('helpSearchClear');
    let _debounce = null;
    input.addEventListener('input', function(e) {
      clearTimeout(_debounce);
      _debounce = setTimeout(function() { render(e.target.value); }, 120);
    });
    clearBtn.addEventListener('click', function() {
      input.value = '';
      input.focus();
      render('');
    });

    // ====== Help Contact Form: anti-spam (word minimum, honeypot, timing, confirm) ======
    (function () {
      const form = document.getElementById('helpContactForm');
      if (!form) return;
      const startedField = document.getElementById('form_started_at');
      if (startedField) startedField.value = String(Date.now());

      const msg = document.getElementById('message');
      const hint = document.getElementById('msgHint');
      const confirmBox = document.getElementById('confirmHuman');
      const submitBtn = document.getElementById('helpSubmitBtn');

      function wordCount(s) {
        return (s || '').trim().split(/\s+/).filter(Boolean).length;
      }
      function updateHint() {
        const wc = wordCount(msg.value);
        if (wc === 0) { hint.textContent = ''; hint.classList.remove('error'); return; }
        if (wc < 3) {
          hint.textContent = `Please use at least 3 words (currently ${wc}).`;
          hint.classList.add('error');
        } else {
          hint.textContent = `${wc} words.`;
          hint.classList.remove('error');
        }
      }
      msg.addEventListener('input', updateHint);

      form.addEventListener('submit', function (e) {
        const wc = wordCount(msg.value);
        if (wc < 3) {
          e.preventDefault();
          updateHint();
          msg.focus();
          return;
        }
        if (!confirmBox.checked) {
          e.preventDefault();
          alert('Please confirm this is a genuine request before submitting.');
          return;
        }
        const ok = confirm('Submit this request to the Managira team?');
        if (!ok) { e.preventDefault(); return; }
        submitBtn.disabled = true;
        submitBtn.textContent = 'Sending…';
      });
    })();
  </script>
</body>
</html>
