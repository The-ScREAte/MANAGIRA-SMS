<style>
      :root {
        --font-family: "<%= (session && session.fontStyle ? String(session.fontStyle).trim() : 'Inter') %>", sans-serif;
      }


  /* General Reset */
  body {
    color: #333;
    margin: 0;
    background-color: #f8f9fa;
    line-height: 1.8;
    font-family: var(--font-family);
    box-sizing: border-box;
  }

  /* Main Content */
  main {
    max-width: 960px; /* sensible width for readability */
    margin: 0 auto; /* center it horizontally */
    padding: 20px; /* spacing within the main content */
    background: transparent; /* no card-like white box */
    border-radius: 0;
    box-shadow: none;
  }

  /* Headings */
  h1 {
    text-align: center;
    color: #01535b;
    font-size: 2rem;
    font-weight: bold;
    margin-bottom: 20px;
  }

  /* Paragraph Spacing */
  p {
    margin: 15px 0;
  }

  /* Lists inside paragraphs */
  ul {
    margin: 10px 0 20px 20px;
    padding: 0;
  }

  li {
    margin-bottom: 6px;
  }

  /* Large Screens */
  @media (min-width: 1024px) {
    h1 {
      font-size: 2.4rem;
    }
  }

  /* Mobile View */
  @media (max-width: 768px) {
    h1 {
      font-size: 1.8rem;
    }
  }

  @media (max-width: 480px) {
    h1 {
      font-size: 1.6rem;
    }
  }
</style>

</head>
<body>
  <main>
