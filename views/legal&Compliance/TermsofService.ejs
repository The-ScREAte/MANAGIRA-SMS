<style>
  :root {
    --font-family: "<%= (session && session.fontStyle ? String(session.fontStyle).trim() : 'Inter') %>", sans-serif;
    --primary: #01535b;
    --primary-light: #e8f4f5;
    --border: #e5e7eb;
    --text: #1f2937;
    --text-muted: #6b7280;
    --bg: #f9fafb;
  }

  body {
    font-family: var(--font-family);
    color: var(--text);
    margin: 0;
    background-color: var(--bg);
    line-height: 1.7;
    box-sizing: border-box;
  }

  *, *::before, *::after { box-sizing: border-box; }

  main {
    max-width: 1140px;
    margin: 0 auto;
    padding: 0;
  }

  .page-header {
    text-align: center;
    margin-bottom: 40px;
  }

  .page-header h1 {
    color: var(--primary);
    font-size: 2.2rem;
    font-weight: 700;
    margin: 0 0 8px;
  }

  .page-header p {
    color: var(--text-muted);
    font-size: 0.95rem;
    margin: 0;
  }

  .legal-section {
    background: #fff;
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 28px 28px 24px;
    margin-bottom: 20px;
  }

  .legal-section h2 {
    font-size: 1.15rem;
    font-weight: 600;
    color: var(--primary);
    margin: 0 0 12px;
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .section-num {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    border-radius: 8px;
    background: var(--primary-light);
    color: var(--primary);
    font-size: 0.85rem;
    font-weight: 700;
    flex-shrink: 0;
  }

  .legal-section p {
    font-size: 0.98rem;
    color: var(--text);
    margin: 0 0 12px;
    line-height: 1.7;
  }

  .legal-section ul {
    margin: 0 0 8px;
    padding: 0;
    list-style: none;
  }

  .legal-section li {
    position: relative;
    padding-left: 24px;
    margin-bottom: 10px;
    font-size: 0.95rem;
    line-height: 1.65;
    color: var(--text);
  }

  .legal-section li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 8px;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--primary);
    opacity: 0.5;
  }

  .contact-card {
    background: var(--primary-light);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 24px 28px;
    text-align: center;
    margin-top: 20px;
    margin-bottom: 40px;
  }

  .contact-card p {
    margin: 0;
    font-size: 0.95rem;
    color: var(--text);
  }

  .contact-card a {
    color: var(--primary);
    font-weight: 600;
    text-decoration: none;
  }

  .contact-card a:hover { text-decoration: underline; }

  @media (max-width: 768px) {
    main { padding: 100px 0 40px; }
    .page-header { margin: 20px 12px 40px; }
    .page-header h1 { font-size: 1.8rem; }
    .legal-section { margin: 0 12px 20px; padding: 20px 18px; }
    .contact-card { margin: 0 12px; padding: 10px 10px 28px; }
  }

  @media (max-width: 480px) {
    main { padding: 110px 0 32px; }
    .page-header { margin: 30px 8px 40px; }
    .page-header h1 { font-size: 1.35rem; }
    .page-header p { font-size: 0.88rem; }
    .legal-section { margin: 0 8px 20px; padding: 16px 14px; border-radius: 10px; }
    .legal-section h2 { font-size: 1.02rem; }
    .legal-section p { font-size: 0.92rem; }
    .legal-section li { font-size: 0.9rem; padding-left: 20px; }
    .section-num { width: 24px; height: 24px; font-size: 0.78rem; }
    .contact-card { margin: 0 8px; padding: 16px 16px 28px; border-radius: 10px; }
    .contact-card p { font-size: 0.9rem; }
  }
</style>

</head>
