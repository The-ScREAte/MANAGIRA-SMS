<h1 class="page-title">Support Our Mission</h1>
<div class="donation-container">
  <% if (donations.length === 0) { %>
    <p class="no-donations">No donation campaigns at the moment. Please visit again soon.</p>
  <% } else { %>
    <% donations.forEach(d => { %>
      <div class="donation-card">
        <% if (d.image_url) { %>
          <img src="<%= d.image_url %>" alt="Donation image" class="donation-image" />
        <% } %>
        <h2><%= d.title %></h2>
        <p><%= d.description %></p>
        <a href="<%= d.external_link %>" target="_blank" class="btn">Donate</a>
      </div>
    <% }) %>
  <% } %>
</div>

<style>
  .page-title {
    font-size: 2rem;
    text-align: center;
    color: #2c3e50;
    margin: 40px 20px 20px;
  }

  .donation-container {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 0 16px 50px;
    max-width: 100%;
    box-sizing: border-box;
  }

  .donation-card {
    width: 100%;
    max-width: 500px;
    background: #fff;
    border-left: 4px solid #27ae60;
    padding: 20px;
    margin: 0 auto 25px auto;
    border-radius: 5px;
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.05);
    text-align: left;
  }

  .donation-image {
    width: 100%;
    max-height: 200px;
    object-fit: cover;
    border-radius: 4px;
    margin-bottom: 15px;
  }

  .donation-card h2 {
    margin: 10px 0;
    font-size: 1.25rem;
    color: #2c3e50;
  }

  .donation-card p {
    font-size: 1rem;
    color: #555;
    margin-bottom: 15px;
  }

  .btn {
    display: inline-block;
    background-color: #27ae60;
    color: #fff;
    padding: 10px 18px;
    text-decoration: none;
    font-size: 0.95rem;
    border-radius: 4px;
    transition: background-color 0.2s ease;
  }

  .btn:hover {
    background-color: #1e8449;
  }

  .no-donations {
    text-align: center;
    color: #888;
    font-size: 1.1rem;
    padding: 30px 10px;
  }

  @media (min-width: 700px) {
    .donation-container {
      flex-direction: row;
      flex-wrap: wrap;
      justify-content: center;
      gap: 20px;
    }

    .donation-card {
      margin: 10px;
    }
  }
</style>
