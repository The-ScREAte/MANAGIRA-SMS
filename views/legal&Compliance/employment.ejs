<h1 class="page-title">Employment Opportunities</h1>

<div class="job-container">
  <% if (jobs.length === 0) { %>
    <p class="no-jobs">No job openings available at this time. Please check back later.</p>
  <% } else { %>
    <% jobs.forEach(job => { %>
      <div class="job-posting">
        <i class="fas fa-briefcase"></i>
        <h2><%= job.title %></h2>
        <p><%= job.description %></p>
        <a href="<%= job.external_link %>" target="_blank" class="btn">Apply Now</a>
      </div>
    <% }) %>
  <% } %>
</div>

<style>
  .page-title {
    text-align: center;
    font-size: 2rem;
    color: #2c3e50;
    margin: 40px 20px 20px;
  }

  .job-container {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 0 16px 50px;
    max-width: 100%;
    box-sizing: border-box;
  }

  .job-posting {
    width: 100%;
    max-width: 500px;
    background: #fff;
    border-left: 4px solid #2c3e50;
    padding: 20px;
    margin: 0 auto 25px auto;
    border-radius: 5px;
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.05);
    text-align: left;
  }

  .job-posting i {
    color: #2c3e50;
    margin-right: 6px;
    font-size: 1.2rem;
  }

  .job-posting h2 {
    margin: 10px 0;
    font-size: 1.25rem;
    color: #2c3e50;
  }

  .job-posting p {
    font-size: 1rem;
    color: #555;
    margin-bottom: 15px;
  }

  .btn {
    display: inline-block;
    background-color: #2c3e50;
    color: #fff;
    padding: 10px 18px;
    text-decoration: none;
    font-size: 0.95rem;
    border-radius: 4px;
    transition: background-color 0.2s ease;
  }

  .btn:hover {
    background-color: #1b2a38;
  }

  .no-jobs {
    text-align: center;
    color: #777;
    font-size: 1.1rem;
    padding: 30px 10px;
  }

  @media (min-width: 700px) {
    .job-container {
      flex-direction: row;
      flex-wrap: wrap;
      justify-content: center;
      gap: 20px;
    }

    .job-posting {
      margin: 10px;
    }
  }
</style>
