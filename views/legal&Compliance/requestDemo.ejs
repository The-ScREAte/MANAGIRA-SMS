<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="<%= locals.viewportContent || 'width=device-width, initial-scale=1.0, maximum-scale=1.0' %>">
  <title><%= title %></title>
  <meta name="description" content="<%= typeof description !== 'undefined' ? description : 'Request a personalised live demo of Managira.' %>">
  <% if (typeof keywords !== 'undefined') { %><meta name="keywords" content="<%= keywords %>"><% } %>
  <% if (typeof canonicalUrl !== 'undefined') { %><link rel="canonical" href="<%= canonicalUrl %>"><% } %>
  <style>
    :root {
      --font-family: "<%= (session && session.fontStyle ? String(session.fontStyle).trim() : 'Inter') %>", sans-serif;
      --primary: #01535b;
      --primary-light: #e8f4f5;
      --border: #e5e7eb;
      --text: #1f2937;
      --text-muted: #6b7280;
      --bg: #f9fafb;
      --surface: #ffffff;
      --surface-soft: #f4fbfb;
      --accent: #b8860b;
      --ring: rgba(1, 83, 91, 0.14);
    }

    * { box-sizing: border-box; }
    body {
      font-family: var(--font-family);
      background:
        radial-gradient(circle at top left, rgba(1, 83, 91, 0.08), transparent 34%),
        linear-gradient(180deg, #f8fbfc 0%, #f3f6fb 100%);
      color: var(--text);
      margin: 0;
      line-height: 1.6;
    }
    main {
      max-width: 980px;
      margin: 0 auto;
      padding: 52px 20px 42px;
    }
    .demo-shell {
      display: grid;
      grid-template-columns: minmax(0, 0.84fr) minmax(0, 1.16fr);
      gap: 22px;
      align-items: start;
    }
    .demo-hero {
      position: sticky;
      top: 112px;
      text-align: left;
      padding: 28px 26px;
      border-radius: 22px;
      background: linear-gradient(160deg, #06282c 0%, #0d4b52 52%, #0f6972 100%);
      color: #ffffff;
      box-shadow: 0 24px 48px rgba(15, 23, 42, 0.12);
      overflow: hidden;
    }
    .demo-hero::after {
      content: '';
      position: absolute;
      inset: auto -40px -40px auto;
      width: 180px;
      height: 180px;
      background: radial-gradient(circle, rgba(255,255,255,0.18), transparent 68%);
      pointer-events: none;
    }
    .demo-hero .eyebrow {
      display: inline-block;
      font-size: 0.72rem;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      color: #f6cf68;
      font-weight: 700;
      margin-bottom: 14px;
    }
    .demo-hero h1 {
      color: #ffffff;
      font-size: clamp(2rem, 3vw, 2.9rem);
      line-height: 1.02;
      margin: 0 0 12px;
      letter-spacing: -0.03em;
    }
    .demo-hero p {
      color: rgba(255,255,255,0.84);
      font-size: 1rem;
      max-width: 34ch;
      margin: 0;
    }
    .demo-points {
      list-style: none;
      margin: 22px 0 0;
      padding: 0;
      display: grid;
      gap: 10px;
    }
    .demo-points li {
      display: flex;
      align-items: flex-start;
      gap: 10px;
      color: rgba(255,255,255,0.9);
      font-size: 0.92rem;
      line-height: 1.45;
    }
    .demo-points li::before {
      content: '';
      width: 8px;
      height: 8px;
      margin-top: 0.46rem;
      border-radius: 999px;
      background: #67d8ea;
      flex: 0 0 auto;
      box-shadow: 0 0 0 6px rgba(103, 216, 234, 0.14);
    }
    .demo-form-panel {
      background: rgba(255,255,255,0.9);
      backdrop-filter: blur(10px);
      -webkit-backdrop-filter: blur(10px);
      border: 1px solid rgba(148, 163, 184, 0.2);
      border-radius: 22px;
      padding: 26px;
      box-shadow: 0 26px 52px rgba(15, 23, 42, 0.1);
    }
    .demo-form-head {
      margin-bottom: 18px;
    }
    .demo-form-head h2 {
      margin: 0 0 6px;
      font-size: 1.5rem;
      line-height: 1.1;
      letter-spacing: -0.02em;
      color: #0f172a;
    }
    .demo-form-head p {
      margin: 0;
      color: #64748b;
      font-size: 0.93rem;
    }
    .demo-card {
      background: transparent;
      border: 0;
      border-radius: 0;
      padding: 0;
      margin-bottom: 0;
    }
    .form-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 16px 18px;
    }
    .form-grid .full { grid-column: 1 / -1; }
    label {
      display: block;
      font-weight: 700;
      font-size: 0.82rem;
      letter-spacing: 0.01em;
      color: #334155;
      margin-bottom: 7px;
    }
    label .req { color: #dc2626; }
    input, select, textarea {
      width: 100%;
      padding: 13px 15px;
      border: 1px solid #dbe3ee;
      border-radius: 12px;
      font-size: 0.95rem;
      font-family: inherit;
      background: #fff;
      transition: border-color 0.2s, box-shadow 0.2s, transform 0.2s;
    }
    input:focus, select:focus, textarea:focus {
      outline: none;
      border-color: #01535b;
      box-shadow: 0 0 0 4px var(--ring);
      transform: translateY(-1px);
    }
    textarea { min-height: 132px; resize: vertical; }
    .field-note {
      display: block;
      margin-top: 6px;
      color: #64748b;
      font-size: 0.78rem;
      line-height: 1.45;
    }
    .confirm-row {
      display: flex;
      align-items: flex-start;
      gap: 10px;
      font-weight: 500;
      color: #475569;
      margin-top: 16px;
      cursor: pointer;
      padding: 10px 12px;
      border-radius: 12px;
      background: #f7fafc;
      border: 1px solid #e8eef5;
    }
    .confirm-row input {
      width: 16px;
      height: 16px;
      margin: 2px 0 0;
      accent-color: #01535b;
      transform: none;
      box-shadow: none;
      padding: 0;
    }
    button[type="submit"] {
      width: 100%;
      margin-top: 20px;
      padding: 15px 18px;
      background: linear-gradient(135deg, #01535b 0%, #0f6972 100%);
      color: #fff;
      border: none;
      border-radius: 14px;
      font-size: 1rem;
      font-weight: 700;
      letter-spacing: 0.01em;
      cursor: pointer;
      box-shadow: 0 16px 30px rgba(1, 83, 91, 0.2);
      transition: background 0.2s, transform 0.15s, box-shadow 0.2s;
    }
    button[type="submit"]:hover {
      background: linear-gradient(135deg, #01464d 0%, #0b5a62 100%);
      transform: translateY(-2px);
      box-shadow: 0 18px 32px rgba(1, 83, 91, 0.24);
    }
    .demo-support {
      margin-top: 16px;
      padding-top: 16px;
      border-top: 1px solid #e8eef5;
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 12px;
      color: #64748b;
      font-size: 0.88rem;
    }
    .demo-support a {
      color: var(--primary);
      font-weight: 700;
      text-decoration: none;
    }
    @media (max-width: 900px) {
      main {
        padding: 28px 16px 38px;
      }
      .demo-shell {
        grid-template-columns: 1fr;
      }
      .demo-hero {
        position: static;
        padding: 24px 22px;
      }
      .demo-hero p {
        max-width: none;
      }
      .demo-form-panel {
        padding: 22px 20px;
      }
    }
    @media (max-width: 640px) {
      main { padding: 24px 12px 36px; }
      .demo-shell { gap: 16px; }
      .demo-hero { display: none; }
      .demo-hero h1 { font-size: 1.75rem; }
      .form-grid { grid-template-columns: 1fr; }
      .demo-form-panel { padding: 18px 16px; border-radius: 18px; }
      .demo-form-head h2 { font-size: 1.24rem; }
      .demo-support {
        flex-direction: column;
        align-items: flex-start;
      }
      input, select, textarea { font-size: 16px; }
    }
    @media (max-width: 480px) {
      main { padding: 22px 8px 30px; }
      .demo-hero { padding: 18px 16px; border-radius: 16px; }
      .demo-hero h1 { font-size: 1.32rem; }
      .demo-hero p { font-size: 0.88rem; }
      .demo-form-panel { padding: 16px 14px; border-radius: 16px; }
    }
  </style>
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "ContactPage",
    "name": "Request a Managira Demo",
    "description": "Schedule a personalised demo of the Managira school management platform.",
    "url": "<%= typeof canonicalUrl !== 'undefined' ? canonicalUrl : 'https://managira.com/legal/request-demo' %>"
  }
  </script>
</head>
<body>
  <main>
    <div class="demo-shell">
      <div class="demo-hero">
        <span class="eyebrow">See Managira in action</span>
        <h1>Request a Personalised Demo</h1>
        <p>Tell us a little about your school and our team will reach out to schedule a live walkthrough tailored to your workflows.</p>
        <ul class="demo-points">
          <li>See admissions, communication, academics, and Paygira in one connected flow.</li>
          <li>Ask about parent portals, Testing Room, reports, and multi-school management.</li>
          <li>Leave with clear next steps for rollout, pricing, and onboarding.</li>
        </ul>
      </div>

      <div>
        <%- include('../partials/flash') %>

        <div class="demo-form-panel">
          <div class="demo-form-head">
            <h2>Tell us about your school</h2>
            <p>We use this information to shape the walkthrough around the people, modules, and outcomes that matter to you.</p>
          </div>

          <div class="demo-card">
            <form action="/legal/request-demo" method="POST" id="demoRequestForm">
              <div class="form-grid">
                <div class="full">
                  <label for="name">Full Name <span class="req">*</span></label>
                  <input id="name" name="name" type="text" required autocomplete="name" placeholder="Your full name" maxlength="120">
                </div>

                <div class="full">
                  <label for="organization">School Name <span class="req">*</span></label>
                  <input id="organization" name="organization" type="text" required autocomplete="organization" placeholder="School or organisation name" maxlength="160">
                </div>

                <div>
                  <label for="email">Email Address <span class="req">*</span></label>
                  <input id="email" name="email" type="email" required autocomplete="email" placeholder="you@school.com" maxlength="160">
                </div>
                <div>
                  <label for="phone">Phone Number <span class="req">*</span></label>
                  <input id="phone" name="phone" type="tel" required autocomplete="tel" placeholder="+234 801 234 5678" maxlength="40">
                </div>

                <div class="full">
                  <label for="message">What would you like to know? <span class="req">*</span></label>
                  <textarea id="message" name="message" rows="5" required minlength="20" maxlength="1500" placeholder="Tell us what you'd like to see in the demo — features, integrations, pricing questions, or anything specific to your school."></textarea>
                  <small class="field-note">Minimum 20 characters. This helps us tailor the walkthrough to your needs.</small>
                </div>
              </div>

              <!-- Honeypot (hidden) -->
              <div style="position:absolute;left:-10000px;top:auto;width:1px;height:1px;overflow:hidden;" aria-hidden="true">
                <label>Leave this field blank<input type="text" name="company_website" tabindex="-1" autocomplete="off"></label>
              </div>
              <input type="hidden" name="form_started_at" id="form_started_at" value="">

              <label class="confirm-row">
                <input type="checkbox" id="confirmHuman" name="confirm_human" required>
                <span>I confirm this is a genuine request, not spam.</span>
              </label>

              <button type="submit" id="demoSubmitBtn">Request My Demo</button>
            </form>
          </div>

          <div class="demo-support">
            <span>Prefer to talk first? We can help you choose the right modules before the walkthrough.</span>
            <a href="/legal/help">Visit Help Center</a>
          </div>
        </div>
      </div>
    </div>
  </main>

  <script>
    (function () {
      const form = document.getElementById('demoRequestForm');
      if (!form) return;
      const startedField = document.getElementById('form_started_at');
      if (startedField) startedField.value = String(Date.now());
      const confirmBox = document.getElementById('confirmHuman');
      const submitBtn = document.getElementById('demoSubmitBtn');
      form.addEventListener('submit', function (e) {
        // Native validation first — stops empty required fields from submitting.
        if (!form.checkValidity()) {
          e.preventDefault();
          form.reportValidity();
          return;
        }
        if (!confirmBox.checked) {
          e.preventDefault();
          alert('Please confirm this is a genuine request before submitting.');
          return;
        }
        if (!confirm('Send this demo request to the Managira team?')) {
          e.preventDefault();
          return;
        }
        submitBtn.disabled = true;
        submitBtn.textContent = 'Sending…';
      });
    })();
  </script>
</body>
</html>
