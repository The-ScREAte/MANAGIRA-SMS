<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <meta name="description" content="<%= typeof description !== 'undefined' ? description : 'Request a personalised live demo of Managira.' %>">
  <% if (typeof keywords !== 'undefined') { %><meta name="keywords" content="<%= keywords %>"><% } %>
  <% if (typeof canonicalUrl !== 'undefined') { %><link rel="canonical" href="<%= canonicalUrl %>"><% } %>
  <style>
    :root {
      --font-family: "<%= (session && session.fontStyle ? String(session.fontStyle).trim() : 'Inter') %>", sans-serif;
      --primary: #01535b;
      --primary-light: #e8f4f5;
      --border: #e5e7eb;
      --text: #1f2937;
      --text-muted: #6b7280;
      --bg: #f9fafb;
    }

    * { box-sizing: border-box; }
    body {
      font-family: var(--font-family);
      background: var(--bg);
      color: var(--text);
      margin: 0;
      line-height: 1.6;
    }
    main {
      max-width: 780px;
      margin: 0 auto;
      padding: 0;
    }
    .demo-hero {
      text-align: center;
      margin-bottom: 40px;
    }
    .demo-hero .eyebrow {
      display: inline-block;
      font-size: 0.72rem;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      color: #b8860b;
      font-weight: 700;
      margin-bottom: 10px;
    }
    .demo-hero h1 {
      color: var(--primary);
      font-size: 2.2rem;
      margin: 0 0 10px;
      letter-spacing: -0.01em;
    }
    .demo-hero p {
      color: var(--text-muted);
      font-size: 0.95rem;
      margin: 0;
    }
    .demo-card {
      background: #fff;
      border: 1px solid var(--border);
      border-radius: 12px;
      padding: 28px 28px 24px;
      margin-bottom: 20px;
    }
    .form-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 14px 16px;
    }
    .form-grid .full { grid-column: 1 / -1; }
    label {
      display: block;
      font-weight: 600;
      font-size: 0.85rem;
      color: #334155;
      margin-bottom: 6px;
    }
    label .req { color: #dc2626; }
    input, select, textarea {
      width: 100%;
      padding: 11px 14px;
      border: 1px solid var(--border);
      border-radius: 8px;
      font-size: 0.95rem;
      font-family: inherit;
      background: #fff;
      transition: border-color 0.2s, box-shadow 0.2s;
    }
    input:focus, select:focus, textarea:focus {
      outline: none;
      border-color: #01535b;
      box-shadow: 0 0 0 3px rgba(1, 83, 91, 0.1);
    }
    textarea { min-height: 110px; resize: vertical; }
    button[type="submit"] {
      width: 100%;
      margin-top: 18px;
      padding: 14px;
      background: #01535b;
      color: #fff;
      border: none;
      border-radius: 10px;
      font-size: 1rem;
      font-weight: 700;
      cursor: pointer;
      transition: background 0.2s, transform 0.15s;
    }
    button[type="submit"]:hover { background: #014048; transform: translateY(-1px); }
    .helper {
      text-align: center;
      margin-top: 20px;
      font-size: 0.88rem;
      color: var(--text-muted);
    }
    .helper a { color: var(--primary); font-weight: 600; }
    @media (max-width: 640px) {
      main { padding: 100px 0 40px; }
      .demo-hero { margin: 20px 12px 40px; }
      .demo-hero h1 { font-size: 1.8rem; }
      .form-grid { grid-template-columns: 1fr; }
      .demo-card { margin: 0 12px 20px; padding: 20px 18px; }
      input, select, textarea { font-size: 16px; }
    }
    @media (max-width: 480px) {
      main { padding: 110px 0 32px; }
      .demo-hero { margin: 30px 8px 40px; }
      .demo-hero h1 { font-size: 1.35rem; }
      .demo-hero p { font-size: 0.88rem; }
      .demo-card { margin: 0 8px 20px; padding: 16px 14px; border-radius: 10px; }
    }
  </style>
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "ContactPage",
    "name": "Request a Managira Demo",
    "description": "Schedule a personalised demo of the Managira school management platform.",
    "url": "<%= typeof canonicalUrl !== 'undefined' ? canonicalUrl : 'https://www.managira.com/legal/request-demo' %>"
  }
  </script>
</head>
<body>
  <main>
    <div class="demo-hero">
      <span class="eyebrow">See Managira in action</span>
      <h1>Request a Personalised Demo</h1>
      <p>Tell us a little about your school and our team will reach out to schedule a live walkthrough.</p>
    </div>

    <%- include('../partials/flash') %>

    <div class="demo-card">
      <form action="/legal/request-demo" method="POST" id="demoRequestForm" novalidate>
        <div class="form-grid">
          <div class="full">
            <label for="name">Full Name <span class="req">*</span></label>
            <input id="name" name="name" type="text" required autocomplete="name" placeholder="Your full name" maxlength="120">
          </div>

          <div class="full">
            <label for="organization">School Name <span class="req">*</span></label>
            <input id="organization" name="organization" type="text" required autocomplete="organization" placeholder="School or organisation name" maxlength="160">
          </div>

          <div>
            <label for="email">Email Address <span class="req">*</span></label>
            <input id="email" name="email" type="email" required autocomplete="email" placeholder="you@school.com" maxlength="160">
          </div>
          <div>
            <label for="phone">Phone Number <span class="req">*</span></label>
            <input id="phone" name="phone" type="tel" required autocomplete="tel" placeholder="+234 801 234 5678" maxlength="40">
          </div>
        </div>

        <!-- Honeypot (hidden) -->
        <div style="position:absolute;left:-10000px;top:auto;width:1px;height:1px;overflow:hidden;" aria-hidden="true">
          <label>Leave this field blank<input type="text" name="company_website" tabindex="-1" autocomplete="off"></label>
        </div>
        <input type="hidden" name="form_started_at" id="form_started_at" value="">

        <label style="display:flex;align-items:center;gap:8px;font-weight:500;color:#475569;margin-top:14px;cursor:pointer;">
          <input type="checkbox" id="confirmHuman" name="confirm_human" required style="width:16px;height:16px;margin:0;accent-color:#01535b;">
          <span>I confirm this is a genuine request, not spam.</span>
        </label>

        <button type="submit" id="demoSubmitBtn">Request My Demo</button>
      </form>
    </div>
  </main>

  <script>
    (function () {
      const form = document.getElementById('demoRequestForm');
      if (!form) return;
      const startedField = document.getElementById('form_started_at');
      if (startedField) startedField.value = String(Date.now());
      const confirmBox = document.getElementById('confirmHuman');
      const submitBtn = document.getElementById('demoSubmitBtn');
      form.addEventListener('submit', function (e) {
        if (!confirmBox.checked) {
          e.preventDefault();
          alert('Please confirm this is a genuine request before submitting.');
          return;
        }
        if (!confirm('Send this demo request to the Managira team?')) {
          e.preventDefault();
          return;
        }
        submitBtn.disabled = true;
        submitBtn.textContent = 'Sending…';
      });
    })();
  </script>
</body>
</html>
