<%
  const tourSections = (typeof sections !== 'undefined' && Array.isArray(sections) ? sections : []).map((s) => ({
    id: s.id,
    name: s.name,
    description: s.description || '',
    features: s.features.map((f) => ({
      id: f.id,
      title: f.title,
      tag: f.category || '',
      summary: f.summary || '',
      screens: f.screens.map((sc) => ({
        label: sc.label || '',
        caption: sc.caption || '',
        media: sc.media.map((m) => ({ label: m.label || (m.media_type === 'html' ? 'Interactive' : ''), type: m.media_type, url: m.file_url, w: m.media_width || null, h: m.media_height || null, poster: m.poster_url || null })),
      })),
    })),
  }));
  const allFeatures = tourSections.flatMap((s) => s.features);
  const coverOf = (f) => {
    for (const sc of f.screens) {
      const m = sc.media.find((x) => x.type === 'image' || (x.type === 'html' && x.poster));
      if (m) return { media: { url: m.type === 'html' ? m.poster : m.url }, screen: sc };
    }
    return null;
  };
  const screenCount = allFeatures.reduce((n, f) => n + f.screens.length, 0);
  const heroFeature = allFeatures.find(coverOf);
  const hero = heroFeature ? coverOf(heroFeature) : null;
  const pad = (n) => String(n).padStart(2, '0');
  const tourJson = JSON.stringify(tourSections).replace(/</g, '\\u003c');
%>
<link rel="stylesheet" href="<%= assetUrl('/css/appDemo.css') %>" />

<div class="tour" data-no-spa>
  <%# No header bar: its logo led signed-in visitors into their school's dashboard. %>
  <section class="tour-hero">
    <div class="tour-hero__copy">
      <h1>See how Managira runs a school, <span>one screen at a time.</span></h1>
      <p class="tour-lead">Click through real Managira screens, step by step.</p>
      <div class="tour-hero__actions">
        <% if (allFeatures.length) { %>
          <button type="button" class="tour-btn tour-btn--primary tour-btn--lg" data-tour-start>
            Start the tour
            <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M7 4l6 6-6 6" /></svg>
          </button>
          <a class="tour-btn tour-btn--ghost tour-btn--lg" href="#tour-features">Browse features</a>
        <% } %>
      </div>
      <% if (allFeatures.length) { %>
        <dl class="tour-stats">
          <div><dt>Sections</dt><dd><%= tourSections.length %></dd></div>
          <div><dt>Features</dt><dd><%= allFeatures.length %></dd></div>
          <div><dt>Screens</dt><dd><%= screenCount %></dd></div>
        </dl>
      <% } %>
    </div>

    <% if (hero) { %>
      <a class="tour-hero__visual" href="#feature-<%= heroFeature.id %>" data-tour-card="<%= heroFeature.id %>" aria-label="Open <%= heroFeature.title %>">
        <div class="tour-frame">
          <div class="tour-frame__chrome" aria-hidden="true"><i></i><i></i><i></i><span>managira.com</span></div>
          <div class="tour-frame__screen">
            <img src="<%= hero.media.url %>" alt="<%= heroFeature.title %>" decoding="async" fetchpriority="high" />
          </div>
        </div>
        <div class="tour-hero__note">
          <span class="tour-hero__note-step">Step 1</span>
          <strong><%= hero.screen.label || heroFeature.title %></strong>
          <span><%= hero.screen.caption || heroFeature.summary %></span>
        </div>
      </a>
    <% } %>
  </section>

  <% if (allFeatures.length) { %>
    <section class="tour-library" id="tour-features">
      <div class="tour-library__head">
        <h2>Explore the platform</h2>
      </div>

      <% if (tourSections.length > 1) { %>
        <div class="tour-tabs" role="tablist" aria-label="Sections">
          <button type="button" class="tour-tab is-active" role="tab" aria-selected="true" data-tour-filter="">
            All <span><%= allFeatures.length %></span>
          </button>
          <% tourSections.forEach((s) => { %>
            <button type="button" class="tour-tab" role="tab" aria-selected="false" data-tour-filter="<%= s.id %>">
              <%= s.name %> <span><%= s.features.length %></span>
            </button>
          <% }) %>
        </div>
      <% } %>

      <% tourSections.forEach((s, si) => { %>
        <section class="tour-section" data-tour-section="<%= s.id %>" aria-labelledby="tour-section-<%= si %>">
          <div class="tour-section__head">
            <span class="tour-section__num"><%= pad(si + 1) %></span>
            <div>
              <h3 id="tour-section-<%= si %>"><%= s.name %></h3>
              <% if (s.description) { %><p><%= s.description %></p><% } %>
            </div>
            <span class="tour-section__count"><%= s.features.length %> <%= s.features.length === 1 ? 'feature' : 'features' %></span>
          </div>

          <div class="tour-grid">
            <% s.features.forEach((f, i) => { const cover = coverOf(f); %>
              <a class="tour-card" href="#feature-<%= f.id %>" data-tour-card="<%= f.id %>">
                <div class="tour-card__media">
                  <% if (cover) { %>
                    <img src="<%= cover.media.url %>" alt="" loading="<%= si === 0 && i < 6 ? 'eager' : 'lazy' %>" decoding="async" />
                  <% } else { %>
                    <div class="tour-card__doc" aria-hidden="true">
                      <svg viewBox="0 0 24 24"><path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z" /><path d="M14 3v5h5M9 13h6M9 17h6" /></svg>
                      <span>PDF document</span>
                    </div>
                  <% } %>
                  <span class="tour-card__count"><%= f.screens.length %> <%= f.screens.length === 1 ? 'screen' : 'steps' %></span>
                </div>
                <div class="tour-card__body">
                  <% if (f.tag) { %><span class="tour-card__cat"><%= f.tag %></span><% } %>
                  <h4><%= f.title %></h4>
                  <p><%= f.summary %></p>
                  <span class="tour-card__go">
                    Open tour
                    <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M7 4l6 6-6 6" /></svg>
                  </span>
                </div>
              </a>
            <% }) %>
          </div>
        </section>
      <% }) %>
    </section>
  <% } else { %>
    <section class="tour-empty">
      <h2>The tour is being refreshed</h2>
      <p>New screens are on the way.</p>
    </section>
  <% } %>

  <section class="tour-cta">
    <div>
      <h2>Ready to run your school on Managira?</h2>
      <p>Pick the plan that fits your school.</p>
    </div>
    <div class="tour-cta__actions">
      <a class="tour-btn tour-btn--light tour-btn--lg" href="/account/service-plan">View plans</a>
    </div>
  </section>

  <div class="tour-foot">
    <span>&copy; <%= new Date().getFullYear() %> Managira</span>
    <nav aria-label="Legal">
      <a href="/legal/help">Help</a>
      <a href="/legal/privacy-policy">Privacy</a>
      <a href="/legal/terms-of-service">Terms</a>
    </nav>
  </div>
</div>

<div class="tv" data-tour-viewer hidden>
  <div class="tv__panel" tabindex="-1" role="dialog" aria-modal="true" aria-labelledby="tv-title">
    <div class="tv__bar">
      <div class="tv__heading">
        <span class="tv__cat" data-tv="section"></span>
        <h2 class="tv__title" id="tv-title" data-tv="title"></h2>
        <span class="tv__pos" data-tv="position"></span>
      </div>
      <div class="tv__tools">
        <div class="tv__zoom" role="group" aria-label="Zoom">
          <button type="button" class="tv__icon" data-tv-zoom="-1" aria-label="Zoom out"><svg viewBox="0 0 20 20"><path d="M5 10h10" /></svg></button>
          <button type="button" class="tv__zoom-label" data-tv-zoom="0" title="Reset zoom" data-tv="zoom">100%</button>
          <button type="button" class="tv__icon" data-tv-zoom="1" aria-label="Zoom in"><svg viewBox="0 0 20 20"><path d="M5 10h10M10 5v10" /></svg></button>
        </div>
        <button type="button" class="tv__icon tv__icon--wide" data-tv-focus aria-label="Hide steps" title="Focus mode">
          <svg viewBox="0 0 20 20"><path d="M3 7V3h4M17 7V3h-4M3 13v4h4M17 13v4h-4" /></svg>
        </button>
        <button type="button" class="tv__icon tv__icon--close" data-tv-close aria-label="Close tour">
          <svg viewBox="0 0 20 20"><path d="M5 5l10 10M15 5L5 15" /></svg>
        </button>
      </div>
    </div>

    <div class="tv__body">
      <aside class="tv__rail">
        <p class="tv__summary" data-tv="summary"></p>
        <p class="tv__rail-label">Steps</p>
        <ol class="tv__steps" data-tv="steps"></ol>
      </aside>

      <div class="tv__stage" data-tv="stage">
        <div class="tv__frame">
          <div class="tour-frame__chrome">
            <i aria-hidden="true"></i><i aria-hidden="true"></i><i aria-hidden="true"></i>
            <span data-tv="crumb" aria-hidden="true">managira.com</span>
            <div class="tv__versions" data-tv="versions" role="group" aria-label="Version" hidden></div>
          </div>
          <div class="tv__canvas" data-tv="canvas">
            <img data-tv="image" alt="" />
            <iframe class="tv__live" data-tv="live" title="Interactive preview" hidden></iframe>
            <div class="tv__pdf" data-tv="pdf" hidden></div>
          </div>
        </div>
      </div>
    </div>

    <div class="tv__foot">
      <div class="tv__caption" data-tv="caption">
        <strong data-tv="caption-label"></strong>
        <span data-tv="caption-text"></span>
      </div>
      <div class="tv__progress" data-tv="progress" aria-hidden="true"></div>
      <div class="tv__nav">
        <button type="button" class="tour-btn tour-btn--ghost" data-tv-prev>
          <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M13 4l-6 6 6 6" /></svg>
          <span>Previous</span>
        </button>
        <span class="tv__count" data-tv="count"></span>
        <button type="button" class="tour-btn tour-btn--primary" data-tv-next>
          <span data-tv="next-label">Next step</span>
          <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M7 4l6 6-6 6" /></svg>
        </button>
      </div>
    </div>
  </div>
</div>

<%# spa-router.js clears the hash before deferred scripts run; keep it for deep links. %>
<script>window.__tourHash = location.hash;</script>
<script id="tour-data" type="application/json"><%- tourJson %></script>
<script src="<%= assetUrl('/js/appDemo.js') %>" defer></script>
