      radial-gradient(94% 62% at 82% 18%, rgba(59, 130, 246, 0.12), transparent 40%),
      conic-gradient(from 212deg at 22% 38%, transparent 0deg 30deg, rgba(56, 189, 248, 0.12) 30deg 54deg, transparent 54deg 360deg),
      conic-gradient(from 26deg at 78% 62%, transparent 0deg 24deg, rgba(45, 212, 191, 0.1) 24deg 44deg, transparent 44deg 360deg);
