  const featuredDemo = demoPages[0];
  const platformPoints = [
    {
      title: 'All in one platform',
      text: 'Admissions, academics, reporting, and records - unified in one complete system so nothing falls through the cracks.'
    },
    {
      title: 'Built for everyone',
      text: 'Designed for school administrators, teaching staff, families, and the wider community who interact with the school every day.'
