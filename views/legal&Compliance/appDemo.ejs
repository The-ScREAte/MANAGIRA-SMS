    min-height: 0;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .app-demo-modal__panel--gallery.app-demo-modal__panel--zoomed .app-demo-modal__canvas {
    min-width: calc(var(--app-demo-base-width, 100%) * var(--app-demo-gallery-zoom, 1));
    min-height: calc(var(--app-demo-gallery-height, 70vh) * var(--app-demo-gallery-zoom, 1));
  }

  .app-demo-modal__panel--gallery .app-demo-modal__canvas img {
    width: auto;
    height: auto;
    max-width: var(--app-demo-base-width, 100%);
    max-height: var(--app-demo-gallery-height, 70vh);
    object-fit: contain;
    transform: scale(var(--app-demo-gallery-zoom, 1));
    transform-origin: center center;
    transition: transform 180ms ease, max-width 180ms ease, max-height 180ms ease;
  }

  /* Inline caption shown above the viewer on small screens (overlay caption hidden) */
  .app-demo-gallery-caption-inline {
    display: none;
    margin: 0 0 10px;
    padding: 10px 14px;
    border-radius: 10px;
    background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%);
    color: #f8fafc;
    box-shadow: 0 6px 16px rgba(15, 23, 42, 0.18);
  }
  .app-demo-gallery-caption-inline strong {
    display: block;
    font-size: 12px;
    color: #ffffff;
    margin-bottom: 2px;
    letter-spacing: 0.02em;
  }
  .app-demo-gallery-caption-inline span {
    display: block;
    font-size: 11.5px;
    color: rgba(248, 250, 252, 0.88);
    line-height: 1.45;
  }

  @media (max-width: 640px) {
    .app-demo-gallery-chevron { width: 30px; height: 30px; font-size: 18px; }
    .app-demo-gallery-chevron--prev { left: 4px; }
    .app-demo-gallery-chevron--next { right: 4px; }
    /* Hide absolute overlay caption on small screens; show inline caption above viewer instead */
    .app-demo-modal__panel--gallery .app-demo-gallery-caption { display: none; }
    .app-demo-modal__panel--gallery .app-demo-gallery-caption-inline { display: block; margin: 0 12px 10px; }
    /* Tighter modal layout for phones */
    .app-demo-modal__panel { border-radius: 14px; }
    .app-demo-modal__topbar { padding: 8px 12px; }
    .app-demo-modal__header { padding: 6px 12px 8px; }
    .app-demo-modal__header h2 { font-size: 18px; line-height: 1.25; }
    .app-demo-modal__description { font-size: 12.5px; line-height: 1.45; }
    .app-demo-modal__panel--gallery .app-demo-modal__viewer { padding: 8px; }
    .app-demo-modal__toolbar { padding: 8px 10px; gap: 8px; flex-wrap: wrap; }
    .app-demo-zoom-controls, .app-demo-nav-controls { gap: 6px; }
    .app-demo-nav-btn { padding: 6px 12px; font-size: 13px; }
  }
</style>

<script>
  (function () {
    const dataNode = document.getElementById('app-demo-data');
    const pages = dataNode ? JSON.parse(dataNode.textContent) : [];
    const modal = document.querySelector('[data-demo-modal]');
    const titleNode = document.getElementById('app-demo-modal-title');
    const taglineNode = document.getElementById('app-demo-modal-tagline');
    const descriptionNode = document.getElementById('app-demo-modal-description');
    const countNode = document.getElementById('app-demo-modal-count');
    const imageNode = document.getElementById('app-demo-modal-image');
    const documentNode = document.getElementById('app-demo-modal-document');
    const pdfPagesNode = document.getElementById('app-demo-pdf-pages');
    const pdfLinkNode = document.getElementById('app-demo-modal-pdf-link');
    const zoomLabel = document.getElementById('app-demo-zoom-label');
    const panel = modal.querySelector('.app-demo-modal__panel');
    const canvas = document.getElementById('app-demo-canvas');
    const viewer = document.getElementById('app-demo-viewer');
    const openButtons = document.querySelectorAll('[data-demo-index], [data-open-demo]');
    const closeButtons = document.querySelectorAll('[data-demo-close]');
    const nextButton = document.querySelector('[data-demo-next]');
    const prevButton = document.querySelector('[data-demo-prev]');
    const expandButton = document.querySelector('[data-demo-expand]');
    const zoomButtons = document.querySelectorAll('[data-demo-zoom]');
    const ZOOM_MIN = 30;
    const ZOOM_MAX = 200;
    const ZOOM_STEP = 5;
    const GALLERY_ZOOM_DEFAULT = 100;
    const ZOOM_DEFAULT_DESKTOP = 75;
    const ZOOM_DEFAULT_SMALL = 85;
    const SMALL_SCREEN_BREAKPOINT = 780;
    function getDefaultZoom() {
      return window.innerWidth <= SMALL_SCREEN_BREAKPOINT ? ZOOM_DEFAULT_SMALL : ZOOM_DEFAULT_DESKTOP;
    }
    const ZOOM_DEFAULT = getDefaultZoom();

    const galleryOverlay = document.getElementById('app-demo-gallery-overlay');
    const galleryCaption = galleryOverlay ? galleryOverlay.querySelector('.app-demo-gallery-caption') : null;
    const galleryDots = document.getElementById('app-demo-gallery-dots');
    const galleryLabel = document.getElementById('app-demo-gallery-label');
    const galleryText = document.getElementById('app-demo-gallery-text');

    function pinCaption() {
      if (!galleryCaption || !viewer || window.innerWidth <= SMALL_SCREEN_BREAKPOINT) return;
      const rect = viewer.getBoundingClientRect();
      galleryCaption.style.bottom = (window.innerHeight - rect.bottom + 18) + 'px';
      galleryCaption.style.right  = (window.innerWidth  - rect.right  + 18) + 'px';
    }
    const galleryButtons = document.querySelectorAll('[data-demo-gallery]');

    let activeIndex = 0;
    let galleryIndex = 0;
    let currentGallery = null;
    let zoomPercent = getDefaultZoom();
    let lastTrigger = null;
    let isExpanded = false;
    let touchStartX = null;
    let pdfDocument = null;
    let pdfRenderToken = 0;

    function syncBaseWidth() {
      if (!viewer || !canvas) {
        return;
      }

      const viewerStyles = window.getComputedStyle(viewer);
      const viewerPaddingX = (parseFloat(viewerStyles.paddingLeft) || 0) + (parseFloat(viewerStyles.paddingRight) || 0);
      const viewerPaddingY = (parseFloat(viewerStyles.paddingTop) || 0) + (parseFloat(viewerStyles.paddingBottom) || 0);
      const maxBaseWidth = isExpanded ? 1920 : 1680;
      const availableWidth = Math.max(320, viewer.clientWidth - viewerPaddingX);
      const availableHeight = Math.max(260, Math.min(window.innerHeight * 0.68, viewer.clientHeight - viewerPaddingY || 0));
      const baseWidth = Math.min(maxBaseWidth, availableWidth);
      canvas.style.setProperty('--app-demo-base-width', baseWidth + 'px');
      canvas.style.setProperty('--app-demo-gallery-height', availableHeight + 'px');
    }

    function setExpanded(nextExpanded) {
      isExpanded = Boolean(nextExpanded);
      if (panel) {
        panel.classList.toggle('app-demo-modal__panel--viewer-expanded', isExpanded);
      }
      syncBaseWidth();
      if (expandButton) {
        expandButton.setAttribute('aria-label', isExpanded ? 'Collapse viewer' : 'Expand viewer');
        expandButton.setAttribute('title', isExpanded ? 'Collapse preview' : 'Expand preview');
        expandButton.textContent = isExpanded ? '−' : '+';
      }
    }

    function setZoom(nextZoomPercent) {
      zoomPercent = Math.max(ZOOM_MIN, Math.min(ZOOM_MAX, Math.round(nextZoomPercent)));
      const zoom = zoomPercent / 100;
      const galleryZoom = zoomPercent / GALLERY_ZOOM_DEFAULT;
      canvas.style.setProperty('--app-demo-zoom', String(zoom));
      canvas.style.setProperty('--app-demo-gallery-zoom', String(galleryZoom));
      zoomLabel.textContent = zoomPercent + '%';
      if (panel) {
        panel.classList.toggle('app-demo-modal__panel--zoomed', currentGallery ? zoomPercent > GALLERY_ZOOM_DEFAULT : zoomPercent > 100);
      }
      if (pdfDocument) {
        renderPdfPages();
      }
    }

    async function ensurePdfJs() {
      if (window.pdfjsLib) return window.pdfjsLib;
      await new Promise((resolve, reject) => {
        const s = document.createElement('script');
        s.src = 'https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.min.js';
        s.onload = resolve;
        s.onerror = reject;
        document.head.appendChild(s);
      });
      if (window.pdfjsLib) {
        window.pdfjsLib.GlobalWorkerOptions.workerSrc =
          'https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.worker.min.js';
      }
      return window.pdfjsLib;
    }

    async function renderPdfPages() {
      if (!pdfDocument || !pdfPagesNode) return;
      const token = ++pdfRenderToken;
      const containerWidth = Math.max(280, pdfPagesNode.clientWidth || 800);
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      const zoomFactor = zoomPercent / 100;
      pdfPagesNode.innerHTML = '';
      for (let i = 1; i <= pdfDocument.numPages; i++) {
        if (token !== pdfRenderToken) return;
        const page = await pdfDocument.getPage(i);
        const baseViewport = page.getViewport({ scale: 1 });
        const fitScale = (containerWidth / baseViewport.width) * zoomFactor;
        const viewport = page.getViewport({ scale: fitScale * dpr });
        const cv = document.createElement('canvas');
        cv.width = viewport.width;
        cv.height = viewport.height;
        cv.style.width = (viewport.width / dpr) + 'px';
        cv.style.height = (viewport.height / dpr) + 'px';
        pdfPagesNode.appendChild(cv);
        const ctx = cv.getContext('2d');
        await page.render({ canvasContext: ctx, viewport }).promise;
        if (token !== pdfRenderToken) return;
      }
    }

    async function loadPdf(url) {
      pdfDocument = null;
      pdfRenderToken++;
      pdfPagesNode.innerHTML = '<p class="app-demo-pdf-loading">Loading document…</p>';
      try {
        const pdfjsLib = await ensurePdfJs();
        if (!pdfjsLib) throw new Error('PDF.js failed to load');
        const task = pdfjsLib.getDocument(url);
        pdfDocument = await task.promise;
        await renderPdfPages();
      } catch (err) {
        pdfPagesNode.innerHTML = '<p class="app-demo-pdf-loading">Could not load the document. <a href="' + url + '" target="_blank" rel="noopener">Open it directly</a>.</p>';
      }
    }

    function renderGallerySlide() {
      if (!currentGallery) return;
      const slide = currentGallery[galleryIndex];
      if (!slide) return;
      imageNode.src = slide.src;
      imageNode.alt = slide.label || 'Demo screen ' + (galleryIndex + 1);
      if (galleryLabel) galleryLabel.textContent = slide.label || '';
      if (galleryText) galleryText.textContent = slide.caption || '';
      const inlineLabel = document.getElementById('app-demo-gallery-label-inline');
      const inlineText = document.getElementById('app-demo-gallery-text-inline');
      if (inlineLabel) inlineLabel.textContent = slide.label || '';
      if (inlineText) inlineText.textContent = slide.caption || '';
      if (galleryDots) {
        Array.from(galleryDots.children).forEach((dot, i) => {
          dot.setAttribute('aria-selected', i === galleryIndex ? 'true' : 'false');
        });
      }
      if (viewer) {
        viewer.scrollTop = 0;
        viewer.scrollLeft = 0;
      }
      pinCaption();
    }

    function buildGalleryDots(count) {
      if (!galleryDots) return;
      galleryDots.innerHTML = '';
      for (let i = 0; i < count; i++) {
        const dot = document.createElement('button');
        dot.type = 'button';
        dot.setAttribute('role', 'tab');
        dot.setAttribute('aria-label', 'Go to screen ' + (i + 1));
        dot.addEventListener('click', () => {
          galleryIndex = i;
          renderGallerySlide();
        });
        galleryDots.appendChild(dot);
      }
    }

    function moveGallery(step) {
      if (!currentGallery) return;
      galleryIndex = (galleryIndex + step + currentGallery.length) % currentGallery.length;
      renderGallerySlide();
    }

    function renderModal(index) {
      const page = pages[index];
      if (!page) {
        return;
      }

      activeIndex = index;
      titleNode.textContent = page.title;
      taglineNode.textContent = page.tagline;
      descriptionNode.textContent = page.description;
      countNode.textContent = 'Screen ' + (index + 1) + ' of ' + pages.length;

      // reset gallery state
      currentGallery = null;
      galleryIndex = 0;
      if (galleryOverlay) galleryOverlay.hidden = true;
      const dotsBar = document.getElementById('app-demo-gallery-dots-bar');
      if (dotsBar) dotsBar.hidden = true;
      if (panel) panel.classList.remove('app-demo-modal__panel--gallery');

      if (page.mediaType === 'pdf') {
        imageNode.hidden = true;
        imageNode.src = '';
        imageNode.alt = '';
        documentNode.hidden = false;
        pdfLinkNode.href = page.image;
        loadPdf(page.image);
      } else if (page.mediaType === 'gallery' && Array.isArray(page.images) && page.images.length) {
        documentNode.hidden = true;
        pdfDocument = null;
        pdfRenderToken++;
        if (pdfPagesNode) pdfPagesNode.innerHTML = '';
        pdfLinkNode.href = '#';
        imageNode.hidden = false;
        if (zoomPercent === getDefaultZoom()) {
          zoomPercent = GALLERY_ZOOM_DEFAULT;
        }
        currentGallery = page.images;
        buildGalleryDots(currentGallery.length);
        renderGallerySlide();
        if (galleryOverlay) galleryOverlay.hidden = false;
        pinCaption();
        const dotsBarShow = document.getElementById('app-demo-gallery-dots-bar');
        if (dotsBarShow) dotsBarShow.hidden = false;
        if (panel) panel.classList.add('app-demo-modal__panel--gallery');
      } else {
        documentNode.hidden = true;
        pdfDocument = null;
        pdfRenderToken++;
        if (pdfPagesNode) pdfPagesNode.innerHTML = '';
        pdfLinkNode.href = '#';
        imageNode.hidden = false;
        imageNode.src = page.image;
        imageNode.alt = page.title + ' full-page preview';
      }

      // Keep current zoom across slide changes (sticky); only refresh CSS var + label.
      setZoom(zoomPercent);
      syncBaseWidth();
      viewer.scrollTop = 0;
      viewer.scrollLeft = 0;
    }

    function openModal(index, trigger) {
      lastTrigger = trigger || document.activeElement;
      modal.hidden = false;
      modal.setAttribute('aria-hidden', 'false');
      document.body.classList.add('app-demo-modal-open');
      setExpanded(false);
      // Reset zoom to the screen-appropriate default each time the modal opens.
      zoomPercent = getDefaultZoom();
      renderModal(index);
      const closeButton = modal.querySelector('[data-demo-close]');
      if (closeButton) {
        closeButton.focus();
      }
    }

    // Suppress browser double-tap zoom and pinch gestures inside the modal.
    // The explicit +/- buttons remain the only zoom controls.
    if (modal) {
      modal.addEventListener('dblclick', function (e) { e.preventDefault(); }, { passive: false });
      modal.addEventListener('gesturestart', function (e) { e.preventDefault(); }, { passive: false });
      modal.addEventListener('gesturechange', function (e) { e.preventDefault(); }, { passive: false });
      modal.addEventListener('gestureend', function (e) { e.preventDefault(); }, { passive: false });
      // Prevent the second tap of a double-tap from firing zoom on iOS Safari.
      let lastTouchEnd = 0;
      modal.addEventListener('touchend', function (e) {
        const now = Date.now();
        if (now - lastTouchEnd <= 350) {
          e.preventDefault();
        }
        lastTouchEnd = now;
      }, { passive: false });
    }

    function closeModal() {
      modal.hidden = true;
      modal.setAttribute('aria-hidden', 'true');
      document.body.classList.remove('app-demo-modal-open');
      imageNode.src = '';
      pdfDocument = null;
      pdfRenderToken++;
      if (pdfPagesNode) pdfPagesNode.innerHTML = '';
      documentNode.hidden = true;
      imageNode.hidden = false;
      setExpanded(false);
      if (lastTrigger && typeof lastTrigger.focus === 'function') {
        lastTrigger.focus();
      }
    }

    function move(step) {
      const nextIndex = (activeIndex + step + pages.length) % pages.length;
      renderModal(nextIndex);
    }

    openButtons.forEach((button) => {
      button.addEventListener('click', function () {
        const rawIndex = button.getAttribute('data-demo-index') || button.getAttribute('data-open-demo') || '0';
        const index = Number.parseInt(rawIndex, 10) || 0;
        openModal(index, button);
      });
    });

    closeButtons.forEach((button) => {
      button.addEventListener('click', closeModal);
    });

    if (nextButton) {
      nextButton.addEventListener('click', function () {
        move(1);
      });
    }

    if (prevButton) {
      prevButton.addEventListener('click', function () {
        move(-1);
      });
    }

    if (expandButton) {
      expandButton.addEventListener('click', function () {
        setExpanded(!isExpanded);
      });
    }

    zoomButtons.forEach((button) => {
      button.addEventListener('click', function () {
        const direction = button.getAttribute('data-demo-zoom');
        setZoom(zoomPercent + (direction === 'in' ? ZOOM_STEP : -ZOOM_STEP));
      });
    });

    document.addEventListener('keydown', function (event) {
      if (modal.hidden) {
        return;
      }

      if (event.key === 'Escape') {
        event.preventDefault();
        closeModal();
      }

      if (event.key === 'ArrowRight') {
        event.preventDefault();
        if (currentGallery) moveGallery(1); else move(1);
      }

      if (event.key === 'ArrowLeft') {
        event.preventDefault();
        if (currentGallery) moveGallery(-1); else move(-1);
      }
    });

    galleryButtons.forEach((button) => {
      button.addEventListener('click', function () {
        moveGallery(button.getAttribute('data-demo-gallery') === 'next' ? 1 : -1);
      });
    });

    if (canvas) {
      canvas.addEventListener('touchstart', function (e) {
        if (!currentGallery || !e.touches || !e.touches[0]) return;
        touchStartX = e.touches[0].clientX;
      }, { passive: true });
      canvas.addEventListener('touchend', function (e) {
        if (!currentGallery || touchStartX === null) return;
        const endX = (e.changedTouches && e.changedTouches[0]) ? e.changedTouches[0].clientX : null;
        if (endX === null) { touchStartX = null; return; }
        const dx = endX - touchStartX;
        touchStartX = null;
        if (Math.abs(dx) > 40) {
          moveGallery(dx < 0 ? 1 : -1);
        }
      });
    }

    if (imageNode) {
      imageNode.addEventListener('load', function () {
        if (modal.hidden) {
          return;
        }
        syncBaseWidth();
        pinCaption();
      });
    }

    window.addEventListener('resize', function () {
      if (!modal.hidden) {
        syncBaseWidth();
        pinCaption();
      }
    });
  })();
</script>