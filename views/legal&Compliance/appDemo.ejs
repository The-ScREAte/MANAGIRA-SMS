<%
  const demoPages = [
    {
      title: 'Organization Dashboard',
      tagline: 'School overview',
      description: 'Get an immediate view of school activity, priority items, and operational updates from one central dashboard. All staff can access the platform easily from here and move directly into their assigned responsibilities.',
      image: '/Demo%20Images/Organization%20Dasboard.png',
      mediaType: 'image',
      accent: '#0f766e'
    },
    {
      title: 'School Website',
      tagline: 'Public presence',
      description: 'Preview the school\'s public-facing website in a format specially built and customized for the institution. It helps each school present its identity, information, and public presence in a professional way.',
      image: '/Demo%20Images/School%20Website.png',
      mediaType: 'image',
      accent: '#0f766e'
    },
    {
      title: 'Organization Statistics',
      tagline: 'Performance summary',
      description: 'Track school-wide performance, enrollment patterns, student progress, and key operational metrics in one consolidated view. This supports leadership reporting and adds to the weekly email report with a live overview of school progress.',
      image: '/Demo%20Images/Organization%20Statistics.png',
      mediaType: 'image',
      accent: '#2563eb'
    },
    {
      title: 'Class Dashboard',
      tagline: 'Class operations',
      description: 'Manage classroom activity from one central workspace with quick access to schedules, updates, and teaching actions. It supports day-to-day classroom coordination without unnecessary complexity.',
      image: '/Demo%20Images/Class%20Dashboard.png',
      mediaType: 'image',
      accent: '#0f766e'
    },
    {
      title: 'Class Schedule',
      tagline: 'Timetable planning',
      description: 'View lesson timing and weekly class structure in a timetable designed for clarity and quick reference. This makes it easier for staff to follow daily teaching schedules across devices.',
      image: '/Demo%20Images/Class%20Schedule.jpeg',
      mediaType: 'image',
      accent: '#b45309'
    },
    {
      title: 'Assessment',
      tagline: 'Score management',
      description: 'Record assessment scores and review subject performance from a structured grading interface designed for consistency and accuracy. It supports efficient score entry while keeping academic records organized.',
      image: '/Demo%20Images/Assessment.png',
      mediaType: 'image',
      accent: '#7c3aed'
    },
    {
      title: 'Attendance',
      tagline: 'Daily tracking',
      description: 'Capture daily attendance efficiently and identify absences or follow-up cases without slowing classroom routines. The page is designed to support fast, consistent record keeping.',
      image: '/Demo%20Images/Attendance.png',
      mediaType: 'image',
      accent: '#d97706'
    },
    {
      title: 'Student Enrollment',
      tagline: 'Admissions workflow',
      description: 'Register student information through a structured admissions workflow that supports accurate placement and complete record capture from the start.',
      image: '/Demo%20Images/Student%20enrollement.png',
      mediaType: 'image',
      accent: '#0284c7'
    },
    {
      title: 'Student Portal',
      tagline: 'Learner access',
      description: 'Keep student information readily available through a focused portal that gives access to academic records, transcript details, and parent information in one place.',
      image: '/Demo%20Images/Student%20Portal.png',
      mediaType: 'image',
      accent: '#1d4ed8'
    },
    {
      title: 'Report Card',
      tagline: 'Printable results',
      description: 'Generate polished report cards that present grades, remarks, and summary information in a modern digital format. Schools can share results through mail, email, or the parent portal instead of relying only on printed copies.',
      image: '/Demo%20Images/Report%20card.png',
      mediaType: 'image',
      accent: '#4338ca'
    },
    {
      title: 'Merit Sheet',
      tagline: 'Academic ranking',
      description: 'Review class rankings and comparative performance in a clear merit sheet format designed for academic analysis and printing.',
      image: '/Demo%20Images/Merit%20Sheet.png',
      mediaType: 'image',
      accent: '#be123c'
    },
    {
      title: 'Transcript',
      tagline: 'Academic record',
      description: 'Produce formal transcript documents that present a student\'s academic history in a clear format suitable for review, printing, and official use.',
      image: '/Demo%20Images/Transcript.pdf',
      mediaType: 'pdf',
      accent: '#334155'
    }
  ];
  const featuredDemo = demoPages[0];
  const platformPoints = [
    {
      title: 'All in one platform.',
      text: 'Admissions, academics, reporting, and records work together in one complete system.'
    },
    {
      title: 'Made for everyone',
      text: 'Built for school officials, families, and the general public who interact with the school.'
    }
  ];
%>

<section class="app-demo-page">
  <div class="app-demo-orb app-demo-orb--left"></div>
  <div class="app-demo-orb app-demo-orb--right"></div>

  <div class="app-demo-shell">
    <section class="app-demo-hero">
      <div class="app-demo-hero__copy">
        <p class="app-demo-kicker">Managira platform tour</p>
        <h1>Explore some of the major keys that can take your school to a higher level.</h1>

        <div class="app-demo-highlights" aria-label="Managira platform highlights">
          <% platformPoints.forEach((point) => { %>
            <article>
              <strong><%= point.title %></strong>
              <span><%= point.text %></span>
            </article>
          <% }) %>
        </div>

        <div class="app-demo-actions">
          <button type="button" class="app-demo-primary" data-open-demo="0">Start Tour</button>
        </div>
      </div>

      <div class="app-demo-hero__logo-panel">
        <img src="/images/managira.png" alt="Managira logo" class="app-demo-hero__logo-panel-image" />
        <div class="app-demo-hero__logo-panel-copy">
          <span>Managira</span>
          <strong>Interactive App Demo</strong>
        </div>
      </div>
    </section>

    <section class="app-demo-gallery">
      <div class="app-demo-section-heading">
        <div>
          <p class="app-demo-kicker">Explore the platform</p>
          <h2>Open any screen and move through the product flow</h2>
        </div>
      </div>

      <div id="app-demo-grid" class="app-demo-grid">
        <% demoPages.forEach((page, index) => { %>
          <button
            type="button"
            class="app-demo-card"
            data-demo-index="<%= index %>"
            data-demo-title="<%- page.title %>"
            data-demo-tagline="<%- page.tagline %>"
            data-demo-description="<%- page.description %>"
            data-demo-image="<%- page.image %>"
            data-demo-type="<%- page.mediaType %>"
            data-demo-accent="<%- page.accent %>"
            aria-label="Open <%= page.title %> preview"
          >
            <span class="app-demo-card__glow" style="--card-accent: <%= page.accent %>"></span>
            <div class="app-demo-card__media">
              <% if (page.mediaType === 'pdf') { %>
                <div class="app-demo-card__file-preview">
                  <span class="app-demo-file-badge">PDF</span>
                  <strong><%= page.title %></strong>
                  <p>Official academic record</p>
                </div>
              <% } else { %>
                <img src="<%= page.image %>" alt="<%= page.title %> preview" loading="lazy" decoding="async" />
              <% } %>
            </div>
            <div class="app-demo-card__body">
              <div class="app-demo-card__meta">
                <span><%= String(index + 1).padStart(2, '0') %></span>
                <span><%= page.tagline %></span>
              </div>
              <h3><%= page.title %></h3>
              <p><%= page.description %></p>
            </div>
          </button>
        <% }) %>
      </div>
    </section>

    <section class="app-demo-platform-info" aria-label="Why schools use Managira">
      <p class="app-demo-kicker">Why Managira</p>
      <h2>All in one management platform just for your school.</h2>
      <p>
        The above features are some of the few items you will have access to as you join Managira. It comes with many more features designed to support everyday school work across administration, academics, reporting, and communication.
      </p>
      <p>
        Managira is built to help schools manage student records, classroom activity, assessment, report generation, and official documents within one professional system. It gives school leaders, staff, families, and the wider school community a more connected way to work.
      </p>
      <a href="https://managira.com/account/service-plan" class="app-demo-primary app-demo-platform-info__cta">Start with Managira today and transform your school like the elite schools around the world.</a>
    </section>
  </div>
</section>

<div class="app-demo-modal" data-demo-modal hidden aria-hidden="true">
  <div class="app-demo-modal__scrim" data-demo-close></div>
  <div class="app-demo-modal__panel" role="dialog" aria-modal="true" aria-labelledby="app-demo-modal-title">
    <div class="app-demo-modal__topbar">
      <div>
        <p class="app-demo-modal__eyebrow">App Demo</p>
        <span id="app-demo-modal-count" class="app-demo-modal__count"></span>
      </div>
      <button type="button" class="app-demo-icon-btn" data-demo-close aria-label="Close app demo">&times;</button>
    </div>

    <div class="app-demo-modal__header">
      <div>
        <p id="app-demo-modal-tagline" class="app-demo-modal__tagline"></p>
        <h2 id="app-demo-modal-title"></h2>
        <p id="app-demo-modal-description" class="app-demo-modal__description"></p>
      </div>
    </div>

    <div class="app-demo-modal__viewer" id="app-demo-viewer">
      <div class="app-demo-modal__canvas" id="app-demo-canvas">
        <img id="app-demo-modal-image" src="" alt="" />
        <div id="app-demo-modal-document" class="app-demo-modal__document" hidden>
          <iframe id="app-demo-modal-pdf" title="Demo document preview" loading="lazy"></iframe>
          <p class="app-demo-modal__document-note">
            If the PDF preview does not load in your browser,
            <a id="app-demo-modal-pdf-link" href="#" target="_blank" rel="noopener">open the file directly</a>.
          </p>
        </div>
      </div>
    </div>

    <div class="app-demo-modal__toolbar">
      <div class="app-demo-zoom-controls" aria-label="Zoom controls">
        <button type="button" class="app-demo-icon-btn" data-demo-zoom="out" aria-label="Zoom out">-</button>
        <span id="app-demo-zoom-label">100%</span>
        <button type="button" class="app-demo-icon-btn" data-demo-zoom="in" aria-label="Zoom in">+</button>
      </div>

      <div class="app-demo-nav-controls" aria-label="Page navigation">
        <button type="button" class="app-demo-nav-btn" data-demo-prev>Previous</button>
        <button type="button" class="app-demo-nav-btn app-demo-nav-btn--solid" data-demo-next>Next</button>
      </div>
    </div>
  </div>
</div>

<script id="app-demo-data" type="application/json"><%- JSON.stringify(demoPages) %></script>

<style>
  .app-demo-page {
    position: relative;
    overflow: hidden;
    background:
      radial-gradient(circle at top left, rgba(16, 185, 129, 0.12), transparent 28%),
      radial-gradient(circle at top right, rgba(14, 165, 233, 0.12), transparent 30%),
      linear-gradient(180deg, #f7f8f4 0%, #eef2f6 52%, #ffffff 100%);
    color: #0f172a;
  }

  .app-demo-shell {
    position: relative;
    z-index: 1;
    max-width: 1240px;
    margin: 0 auto;
    padding: 72px 20px 88px;
  }

  .app-demo-orb {
    position: absolute;
    border-radius: 999px;
    filter: blur(10px);
    opacity: 0.8;
    pointer-events: none;
  }

  .app-demo-orb--left {
    width: 240px;
    height: 240px;
    left: -80px;
    top: 120px;
    background: radial-gradient(circle, rgba(15, 118, 110, 0.26), rgba(15, 118, 110, 0));
  }

  .app-demo-orb--right {
    width: 280px;
    height: 280px;
    right: -70px;
    top: 320px;
    background: radial-gradient(circle, rgba(217, 119, 6, 0.2), rgba(217, 119, 6, 0));
  }

  .app-demo-hero {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(320px, 0.9fr);
    gap: 28px;
    align-items: center;
    margin-bottom: 48px;
  }

  .app-demo-hero__copy {
    width: min(100%, 780px);
    margin: 0 auto 0 0;
  }

  .app-demo-kicker,
  .app-demo-modal__eyebrow,
  .app-demo-modal__tagline {
    margin: 0;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    font-size: 12px;
    font-weight: 700;
    color: #0f766e;
  }

  .app-demo-hero h1 {
    margin: 12px 0 16px;
    max-width: 12ch;
    font-size: clamp(2.6rem, 5vw, 4.8rem);
    line-height: 0.94;
    letter-spacing: -0.06em;
    text-align: left;
  }

  .app-demo-hero__logo-panel {
    display: grid;
    place-items: center;
    gap: 18px;
    position: relative;
    isolation: isolate;
    min-height: 100%;
    padding: 42px 28px;
    border-radius: 24px;
    background:
      radial-gradient(circle at 50% 42%, rgba(14, 165, 233, 0.12), transparent 42%),
      linear-gradient(180deg, rgba(255, 255, 255, 0.94) 0%, rgba(241, 245, 249, 0.88) 100%);
    border: 1px solid rgba(148, 163, 184, 0.2);
    box-shadow: 0 24px 80px rgba(15, 23, 42, 0.08);
    text-align: center;
    overflow: hidden;
  }

  .app-demo-hero__logo-panel::before,
  .app-demo-hero__logo-panel::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .app-demo-hero__logo-panel::before {
    background:
      radial-gradient(128% 82% at 18% 20%, rgba(34, 211, 238, 0.24), transparent 38%),
      radial-gradient(104% 72% at 84% 16%, rgba(59, 130, 246, 0.24), transparent 40%),
      radial-gradient(94% 70% at 32% 84%, rgba(14, 165, 233, 0.18), transparent 42%),
      conic-gradient(from 216deg at 24% 40%, transparent 0deg 28deg, rgba(56, 189, 248, 0.18) 28deg 54deg, transparent 54deg 360deg),
      conic-gradient(from 20deg at 76% 58%, transparent 0deg 22deg, rgba(45, 212, 191, 0.18) 22deg 46deg, transparent 46deg 360deg),
      conic-gradient(from 160deg at 58% 28%, transparent 0deg 32deg, rgba(96, 165, 250, 0.14) 32deg 50deg, transparent 50deg 360deg);
    opacity: 0.96;
    transform: scale(1.03);
    filter: blur(1.5px);
  }

  .app-demo-hero__logo-panel::after {
    background:
      radial-gradient(74% 24% at 50% 16%, rgba(255, 255, 255, 0.76), transparent 64%),
      radial-gradient(42% 58% at 22% 44%, rgba(125, 211, 252, 0.2), transparent 70%),
      radial-gradient(48% 60% at 80% 58%, rgba(59, 130, 246, 0.18), transparent 72%),
      radial-gradient(40% 48% at 58% 74%, rgba(45, 212, 191, 0.12), transparent 76%);
    mix-blend-mode: screen;
    animation: app-demo-electric-pulse 4.8s ease-in-out infinite;
  }

  .app-demo-hero__logo-panel > * {
    position: relative;
    z-index: 1;
  }

  .app-demo-hero__logo-panel-image {
    display: block;
    width: min(100%, 360px);
    height: auto;
    object-fit: contain;
  }

  .app-demo-hero__logo-panel-copy {
    display: grid;
    gap: 6px;
  }

  .app-demo-hero__logo-panel-copy span {
    margin: 0;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    font-size: 0.76rem;
    font-weight: 700;
    color: #0f766e;
  }

  .app-demo-hero__logo-panel-copy strong {
    font-size: clamp(1.35rem, 2.4vw, 1.8rem);
    letter-spacing: -0.04em;
    color: #0f172a;
  }

  .app-demo-highlights {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 14px;
    margin: 28px 0;
  }

  .app-demo-highlights article,
  .app-demo-platform-info,
  .app-demo-card,
  .app-demo-modal__panel {
    border: 1px solid rgba(148, 163, 184, 0.2);
    box-shadow: 0 24px 80px rgba(15, 23, 42, 0.08);
    backdrop-filter: blur(12px);
  }

  .app-demo-highlights article {
    padding: 18px;
    border-radius: 16px;
    background: rgba(255, 255, 255, 0.72);
  }

  .app-demo-highlights strong {
    display: block;
    margin-bottom: 5px;
    font-size: 1.15rem;
  }

  .app-demo-highlights span {
    color: #64748b;
    font-size: 0.92rem;
    line-height: 1.7;
  }

  .app-demo-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
  }

  .app-demo-primary,
  .app-demo-secondary,
  .app-demo-nav-btn,
  .app-demo-icon-btn,
  .app-demo-card {
    font: inherit;
  }

  .app-demo-primary,
  .app-demo-secondary,
  .app-demo-nav-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    padding: 0 16px;
    border-radius: 999px;
    text-decoration: none;
    transition: transform 180ms ease, background-color 180ms ease, border-color 180ms ease, box-shadow 180ms ease;
  }

  .app-demo-primary {
    border: none;
    color: #ffffff;
    background: linear-gradient(135deg, #0f766e, #0f172a);
    box-shadow: 0 14px 30px rgba(15, 118, 110, 0.28);
  }

  .app-demo-secondary,
  .app-demo-nav-btn {
    border: 1px solid rgba(15, 23, 42, 0.14);
    background: rgba(255, 255, 255, 0.72);
    color: #0f172a;
  }

  .app-demo-nav-btn--solid {
    border-color: transparent;
    background: #0f172a;
    color: #ffffff;
  }

  .app-demo-primary:hover,
  .app-demo-secondary:hover,
  .app-demo-nav-btn:hover,
  .app-demo-icon-btn:hover,
  .app-demo-card:hover {
    transform: translateY(-2px);
  }
  .app-demo-card__file-preview {
    display: grid;
    place-items: center;
    text-align: center;
    gap: 10px;
    min-height: 100%;
    padding: 26px 22px;
    background:
      radial-gradient(circle at top, rgba(15, 118, 110, 0.18), transparent 40%),
      linear-gradient(180deg, #f8fafc 0%, #e2e8f0 100%);
    border: 1px solid rgba(15, 23, 42, 0.06);
    border-radius: 14px;
  }

  .app-demo-file-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 56px;
    min-height: 32px;
    padding: 0 12px;
    border-radius: 999px;
    background: #0f172a;
    color: #ffffff;
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.08em;
  }

  .app-demo-card__file-preview strong {
    font-size: 1.15rem;
    letter-spacing: -0.03em;
    color: #0f172a;
  }

  .app-demo-card__file-preview p {
    margin: 0;
    max-width: 28ch;
    color: #475569;
    line-height: 1.6;
  }

  .app-demo-platform-info p,
  .app-demo-note,
  .app-demo-card p,
  .app-demo-modal__description,
  .app-demo-modal__count {
    color: #64748b;
  }

  .app-demo-section-heading {
    display: flex;
    justify-content: space-between;
    gap: 20px;
    align-items: end;
    margin-bottom: 22px;
  }

  .app-demo-section-heading h2 {
    margin: 10px 0 0;
    font-size: clamp(1.7rem, 3vw, 2.6rem);
    letter-spacing: -0.04em;
  }

  .app-demo-note {
    max-width: 34ch;
    margin: 0;
    line-height: 1.7;
  }

  .app-demo-platform-info {
    display: block;
    margin-top: 34px;
    padding: 28px;
    border-radius: 24px;
    background: rgba(255, 255, 255, 0.82);
  }

  .app-demo-platform-info h2 {
    margin: 10px 0 14px;
    font-size: clamp(1.8rem, 3vw, 2.7rem);
    letter-spacing: -0.04em;
  }

  .app-demo-platform-info p {
    margin: 0;
    line-height: 1.8;
  }

  .app-demo-platform-info p + p {
    margin-top: 14px;
  }

  .app-demo-platform-info__cta {
    margin-top: 20px;
    width: fit-content;
    max-width: 100%;
  }

  .app-demo-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
  }

  .app-demo-card {
    position: relative;
    overflow: hidden;
    padding: 0;
    border-radius: 22px;
    border: 1px solid rgba(148, 163, 184, 0.22);
    background: rgba(255, 255, 255, 0.82);
    cursor: pointer;
    text-align: left;
  }

  .app-demo-card__glow {
    position: absolute;
    inset: -40% auto auto -10%;
    width: 180px;
    height: 180px;
    border-radius: 999px;
    background: radial-gradient(circle, color-mix(in srgb, var(--card-accent) 28%, white 72%), transparent 68%);
    opacity: 0.8;
    pointer-events: none;
  }

  .app-demo-card__media {
    position: relative;
    padding: 10px 10px 0;
  }

  .app-demo-card__media img {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    object-position: top;
    border-radius: 14px;
    background: #e2e8f0;
    border: 1px solid rgba(15, 23, 42, 0.06);
  }

  .app-demo-card__media {
    min-height: 152px;
  }

  .app-demo-card__body {
    position: relative;
    padding: 13px 13px 15px;
  }

  .app-demo-card__meta {
    display: flex;
    justify-content: space-between;
    gap: 10px;
    margin-bottom: 8px;
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: #0f766e;
  }

  .app-demo-card h3 {
    margin: 0 0 5px;
    font-size: 1.05rem;
    letter-spacing: -0.03em;
  }

  .app-demo-card p,
  .app-demo-modal__description {
    margin: 0;
    line-height: 1.58;
    font-size: 0.88rem;
  }

  .app-demo-modal {
    position: fixed;
    inset: 0;
    z-index: 1200;
    display: grid;
    place-items: center;
    padding: 18px;
  }

  .app-demo-modal[hidden] {
    display: none;
  }

  .app-demo-modal__scrim {
    position: absolute;
    inset: 0;
    background: rgba(2, 6, 23, 0.7);
    backdrop-filter: blur(10px);
    animation: app-demo-fade-in 180ms ease;
  }

  .app-demo-modal__panel {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    width: min(1280px, 100%);
    max-height: min(96vh, 980px);
    border-radius: 22px;
    overflow: hidden;
    background: rgba(248, 250, 252, 0.97);
    animation: app-demo-rise-in 220ms ease;
  }

  .app-demo-modal__topbar,
  .app-demo-modal__header {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    padding: 12px 16px;
  }

  .app-demo-modal__topbar {
    align-items: start;
    border-bottom: 1px solid rgba(148, 163, 184, 0.18);
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.92), rgba(248, 250, 252, 0.86));
  }

  .app-demo-modal__header {
    align-items: end;
    border-bottom: 1px solid rgba(148, 163, 184, 0.18);
  }

  .app-demo-modal__header h2 {
    margin: 4px 0 6px;
    font-size: clamp(1.35rem, 2.3vw, 1.95rem);
    letter-spacing: -0.04em;
