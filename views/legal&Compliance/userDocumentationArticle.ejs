<!DOCTYPE html>
<html lang="en" data-appearance="gray">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="<%= locals.viewportContent || 'width=device-width, initial-scale=1.0, maximum-scale=1.0' %>">
  <title><%= title %></title>
  <meta name="description" content="<%= description %>">
  <style>
    html, body, * { scrollbar-width: none; -ms-overflow-style: none; }
    *::-webkit-scrollbar, *::-webkit-scrollbar-thumb, *::-webkit-scrollbar-track { display: none !important; width: 0 !important; height: 0 !important; }
  </style>
  <% if (keywords) { %><meta name="keywords" content="<%= keywords %>"><% } %>
  <link rel="canonical" href="<%= canonicalUrl %>">
  <meta name="robots" content="<%= (typeof pageNotFound !== 'undefined' && pageNotFound) ? 'noindex, follow' : 'index, follow, max-snippet:-1, max-image-preview:large' %>">
  <meta property="og:type" content="<%= (typeof selectedArticle !== 'undefined' && selectedArticle) ? 'article' : 'website' %>">
  <meta property="og:site_name" content="Managira">
  <meta property="og:title" content="<%= title %>">
  <meta property="og:description" content="<%= description %>">
  <meta property="og:url" content="<%= canonicalUrl %>">
  <meta name="twitter:card" content="summary">
  <meta name="twitter:title" content="<%= title %>">
  <meta name="twitter:description" content="<%= description %>">
  <% if (typeof selectedArticle !== 'undefined' && selectedArticle && selectedArticle.updatedAt) { %><meta property="article:modified_time" content="<%= new Date(selectedArticle.updatedAt).toISOString() %>"><% } %>
  <% if (structuredData) { %>
  <script type="application/ld+json"><%- typeof structuredData === 'string' ? structuredData : JSON.stringify(structuredData).replace(/</g, '\\u003c') %></script>
  <% } %>
  <style>
    :root {
      --font-family: "<%= (session && session.fontStyle ? String(session.fontStyle).trim() : 'Inter') %>", sans-serif;
      --primary: #01535b;
      --primary-light: #e8f4f5;
      --border: #e5e7eb;
      --text: #1f2937;
      --text-muted: #6b7280;
      --bg: #f9fafb;
    }

    * { margin: 0; padding: 0; box-sizing: border-box; }

    body {
      font-family: var(--font-family);
      background: var(--bg);
      color: var(--text);
      line-height: 1.6;
    }

    /* ── Layout ────────────────────────────────── */
    .article-page {
      max-width: 820px;
      margin: 0 auto;
      padding: 28px 20px 60px;
    }

    /* ── Breadcrumb / back link ─────────────────── */
    .article-back {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      font-size: 0.88rem;
      font-weight: 600;
      color: var(--primary);
      text-decoration: none;
      margin-bottom: 18px;
    }
    .article-back:hover { text-decoration: underline; }
    .article-back svg { flex-shrink: 0; }

    .article-breadcrumb-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
      margin-bottom: 20px;
    }

    .article-breadcrumb {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 6px;
      font-size: 0.82rem;
      color: var(--text-muted);
      margin-bottom: 0;
      min-width: 0;
    }
    .article-breadcrumb a {
      color: var(--primary);
      text-decoration: none;
      font-weight: 600;
    }
    .article-breadcrumb a:hover { text-decoration: underline; }
    .article-breadcrumb span { color: #cbd5e1; }
    .article-breadcrumb-label {
      color: var(--text-muted) !important;
      white-space: nowrap;
    }

    /* ── In-article search ─────────────────────── */
    .article-search-panel {
      flex: 0 0 auto;
      width: min(290px, 100%);
      min-width: 220px;
    }
    .article-search-toggle {
      display: none;
      align-items: center;
      justify-content: center;
      width: 36px;
      height: 36px;
      border: 1px solid var(--border);
      border-radius: 999px;
      background: #fff;
      color: #8ea0b9;
      cursor: pointer;
      transition: border-color 0.2s, box-shadow 0.2s, color 0.2s;
      flex-shrink: 0;
    }
    .article-search-toggle:hover,
    .article-search-toggle.is-open {
      color: var(--primary);
      border-color: var(--primary);
      box-shadow: 0 0 0 3px rgba(1, 83, 91, 0.08);
    }
    .article-search-wrap {
      position: relative;
      margin-bottom: 0;
    }
    .article-search-ico {
      position: absolute;
      left: 12px;
      top: 50%;
      transform: translateY(-50%);
      width: 16px;
      height: 16px;
      pointer-events: none;
      color: #8ea0b9;
      fill: none;
      stroke: currentColor;
      stroke-width: 2.1;
      stroke-linecap: round;
      stroke-linejoin: round;
    }
    .article-search-input {
      width: 100%;
      height: 40px;
      padding: 0 38px 0 38px;
      border: 1px solid var(--border);
      border-radius: 999px;
      font-size: 0.86rem;
      line-height: 1.2;
      font-family: inherit;
      background: #fff;
      transition: border-color 0.2s, box-shadow 0.2s;
    }
    .article-search-input:focus {
      outline: none;
      border-color: var(--primary);
      box-shadow: 0 0 0 3px rgba(1, 83, 91, 0.08);
    }
    .article-search-clear {
      position: absolute;
      right: 8px;
      top: 50%;
      transform: translateY(-50%);
      width: 22px;
      height: 22px;
      border: none;
      border-radius: 50%;
      background: #f1f5f9;
      color: #64748b;
      display: none;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      font-size: 14px;
      line-height: 1;
    }
    .article-search-clear:hover { background: #e2e8f0; color: #0f172a; }
    .article-search-meta {
      font-size: 0.82rem;
      color: #64748b;
      min-height: 0;
      margin-top: 8px;
    }
    .article-search-meta:empty { display: none; }
    .article-search-results {
      display: none;
      margin-top: 14px;
    }
    .article-search-results.is-visible { display: block; }
    .article-results-block { margin-bottom: 22px; }
    .article-results-block:last-child { margin-bottom: 0; }
    .article-results-block h2 {
      font-size: 0.78rem;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: var(--primary);
      margin: 0 0 10px;
      font-weight: 700;
    }
    .article-result-card {
      background: #fff;
      border: 1px solid var(--border);
      border-radius: 12px;
      padding: 14px 16px;
      margin-bottom: 10px;
      transition: border-color 0.2s, box-shadow 0.2s;
    }
    .article-result-card:hover {
      border-color: var(--primary);
      box-shadow: 0 4px 14px rgba(1, 83, 91, 0.08);
    }
    .article-result-row {
      display: flex;
      align-items: center;
      gap: 8px;
      margin-bottom: 4px;
    }
    .article-result-type {
      font-size: 0.68rem;
      font-weight: 700;
      letter-spacing: 0.09em;
      text-transform: uppercase;
      padding: 2px 7px;
      border-radius: 999px;
      line-height: 1.6;
      flex-shrink: 0;
    }
    .article-result-type--article { background: #e6f4f5; color: #01535b; }
    .article-result-type--doc { background: #fef6e0; color: #92400e; }
    .article-result-type--faq { background: #ede9fe; color: #4f46e5; }
    .article-result-title {
      font-weight: 600;
      font-size: 0.95rem;
      color: var(--text);
      text-decoration: none;
      line-height: 1.35;
    }
    .article-result-title:hover { color: var(--primary); }
    .article-result-meta {
      font-size: 0.84rem;
      color: #64748b;
      margin: 0;
      line-height: 1.55;
    }
    .article-result-meta mark {
      background: #fef3c7;
      color: inherit;
      padding: 0 2px;
      border-radius: 2px;
    }
    .article-result-cta {
      color: var(--primary);
      font-weight: 600;
      text-decoration: none;
      white-space: nowrap;
    }
    .article-result-cta:hover { text-decoration: underline; }
    .article-search-empty {
      text-align: center;
      padding: 22px 16px;
      background: #fff;
      border: 1px dashed #cbd5e1;
      border-radius: 12px;
      color: #64748b;
      font-size: 0.9rem;
    }
    .article-search-empty strong {
      display: block;
      color: #0f172a;
      margin-bottom: 4px;
    }

    /* ── Header card ────────────────────────────── */
    .article-header {
      background: #fff;
      border: 1px solid var(--border);
      border-radius: 14px;
      padding: 22px 24px 18px;
      margin-bottom: 16px;
    }

    .article-topic-badge {
      display: inline-flex;
      align-items: center;
      gap: 5px;
      font-size: 0.72rem;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      font-weight: 700;
      color: var(--primary);
      background: var(--primary-light);
      padding: 4px 10px;
      border-radius: 999px;
      margin-bottom: 14px;
    }

    .article-title {
      font-size: clamp(1.15rem, 3.1vw, 1.55rem);
      font-weight: 800;
      color: #0f172a;
      line-height: 1.2;
      letter-spacing: -0.01em;
      margin-bottom: 10px;
    }

    .article-meta-row {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 6px;
      margin-top: 12px;
    }
    .article-meta-date {
      font-size: 0.74rem;
      color: var(--text-muted);
      padding-right: 8px;
      border-right: 1px solid #e2e8f0;
      margin-right: 2px;
    }
    .article-tag {
      font-size: 0.64rem;
      font-weight: 600;
      padding: 2px 7px;
      border-radius: 999px;
      background: #f1f5f9;
      color: #475569;
      border: 1px solid #e2e8f0;
      max-width: 92px;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
      display: inline-block;
    }

    /* ── Draft banner ───────────────────────────── */
    .draft-banner {
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 12px 18px;
      background: #fef9c3;
      border: 1px solid #fde68a;
      border-radius: 10px;
      margin-bottom: 20px;
      font-size: 0.9rem;
      color: #92400e;
      font-weight: 600;
    }

    /* ── Article body ───────────────────────────── */
    .article-body {
      background: #fff;
      border: 1px solid var(--border);
      border-radius: 14px;
      padding: 24px 28px 22px;
      margin-bottom: 18px;
    }

    .article-related {
      background: #f8fbfc;
      border: 1px solid #dbe8ec;
      border-radius: 12px;
      padding: 12px;
      margin-bottom: 12px;
    }
    .article-related h2 {
      margin: 0 0 4px;
      font-size: 0.92rem;
      color: #0f172a;
    }
    .article-related p {
      margin: 0 0 8px;
      color: #64748b;
      font-size: 0.78rem;
    }
    .article-related-list {
      display: grid;
      gap: 6px;
    }
    .article-related-link {
      display: block;
      text-decoration: none;
      background: #fff;
      border: 1px solid #dbe8ec;
      border-radius: 8px;
      padding: 7px 9px;
      transition: border-color 0.2s ease, box-shadow 0.2s ease, transform 0.15s ease;
    }
    .article-related-link:hover {
      border-color: #01535b;
      box-shadow: 0 6px 16px rgba(2, 6, 23, 0.07);
      transform: translateY(-1px);
    }
    .article-related-link strong {
      display: block;
      color: #0f172a;
      font-size: 0.82rem;
      line-height: 1.28;
      margin-bottom: 1px;
    }
    .article-related-link span {
      color: #64748b;
      font-size: 0.68rem;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      font-weight: 700;
    }

    /* Rich-text content styles */
    .article-content { font-size: 1rem; line-height: 1.75; color: #374151; }
    .article-content h1,
    .article-content h2,
    .article-content h3,
    .article-content h4 {
      color: #0f172a;
      font-weight: 700;
      line-height: 1.25;
      margin: 1.6em 0 0.6em;
    }
    .article-content h1 { font-size: 1.55rem; }
    .article-content h2 { font-size: 1.3rem; border-bottom: 1px solid #f1f5f9; padding-bottom: 0.4em; }
    .article-content h3 { font-size: 1.12rem; }
    .article-content h4 { font-size: 1rem; }
    .article-content p { margin: 0 0 1.1em; }
    .article-content h1 p,
    .article-content h2 p,
    .article-content h3 p,
    .article-content h4 p {
      margin: 0;
      font: inherit;
      color: inherit;
      line-height: inherit;
    }
    .article-content h1 span,
    .article-content h2 span,
    .article-content h3 span,
    .article-content h4 span {
      font: inherit;
      color: inherit;
      line-height: inherit;
    }
    .article-content a { color: var(--primary); text-decoration: underline; }
    .article-content a:hover { color: #014048; }
    .article-content ul,
    .article-content ol { padding-left: 1.5em; margin: 0 0 1.1em; }
    .article-content li { margin-bottom: 0.35em; }
    .article-content blockquote {
      border-left: 3px solid var(--primary);
      background: var(--primary-light);
      padding: 12px 18px;
      border-radius: 0 8px 8px 0;
      margin: 1.2em 0;
      color: #374151;
      font-style: italic;
    }
    .article-content pre {
      background: #0f172a;
      color: #e2e8f0;
      padding: 16px 20px;
      border-radius: 10px;
      overflow-x: auto;
      font-size: 0.9rem;
      margin: 1.2em 0;
    }
    .article-content code {
      font-family: 'Courier New', Courier, monospace;
      font-size: 0.88em;
      background: #f1f5f9;
      padding: 2px 6px;
      border-radius: 4px;
      color: #0f172a;
    }
    .article-content pre code {
      background: transparent;
      padding: 0;
      color: inherit;
    }
    .article-content table {
      width: 100%;
      border-collapse: collapse;
      font-size: 0.93rem;
      margin: 1.2em 0;
    }
    .article-content th {
      background: #f8fafc;
      font-weight: 700;
      text-align: left;
      padding: 10px 14px;
      border: 1px solid #e2e8f0;
      color: #0f172a;
    }
    .article-content td {
      padding: 10px 14px;
      border: 1px solid #e2e8f0;
      vertical-align: top;
    }
    .article-content tr:nth-child(even) td { background: #f8fafc; }
    .article-content img {
      max-width: 100%;
      height: auto;
      border-radius: 8px;
      border: 1px solid var(--border);
      margin: 1em 0;
    }
    .article-content figure {
      margin: 1.4em 0;
      text-align: center;
    }
    .article-content figure.doc-image {
      display: inline-block;
      max-width: 100%;
    }
    .article-content figure.doc-image img {
      display: block;
      width: 100%;
      height: auto;
      margin: 0;
    }
    .article-content figcaption {
      font-size: 0.84rem;
      color: var(--text-muted);
      margin-top: 6px;
      font-style: italic;
    }
    .article-content figure.doc-video {
      position: relative;
      width: 100%;
      max-width: 100%;
      padding-bottom: 56.25%;
      height: 0;
      overflow: hidden;
      border-radius: 10px;
      margin: 1.4em 0;
    }
    .article-content figure.doc-video iframe,
    .article-content figure.doc-video video {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      border: none;
      margin: 0;
      border-radius: 10px;
    }
    .article-content iframe {
      max-width: 100%;
      border-radius: 8px;
      margin: 1em 0;
    }
    /* Attachment card */
    .article-content .doc-attachment-card {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 10px 18px;
      background: #f8fafc;
      border: 1px solid #e2e8f0;
      border-radius: 8px;
      text-decoration: none;
      color: #0f172a;
      font-weight: 600;
      font-size: 0.9rem;
      transition: border-color 0.2s, color 0.2s, background 0.2s;
    }
    .article-content .doc-attachment-card:hover { border-color: #01535b; color: #01535b; background: #f0fafa; text-decoration: none; }

    /* ── Helpful vote widget ────────────────────── */
    .article-helpful {
      background: #fff;
      border: 1px solid var(--border);
      border-radius: 14px;
      padding: 16px 18px;
      margin-bottom: 22px;
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
      gap: 10px;
    }
    .article-helpful__label {
      font-size: 0.86rem;
      font-weight: 700;
      color: #0f172a;
    }
    .article-helpful__label small {
      display: block;
      font-size: 0.72rem;
      font-weight: 400;
      color: var(--text-muted);
      margin-top: 2px;
    }
    .article-helpful__btns {
      display: flex;
      gap: 10px;
    }
    .helpful-btn {
      display: flex;
      align-items: center;
      gap: 6px;
      padding: 7px 12px;
      border: 1px solid var(--border);
      border-radius: 999px;
      background: #fff;
      cursor: pointer;
      font-size: 0.8rem;
      font-weight: 600;
      font-family: inherit;
      color: #374151;
      transition: border-color 0.2s, background 0.2s, color 0.2s;
    }
    .helpful-btn:hover { border-color: var(--primary); color: var(--primary); }
    .helpful-btn.voted-yes { border-color: var(--primary); background: var(--primary-light); color: var(--primary); }
    .helpful-btn.voted-no  { border-color: #dc2626; background: #fef2f2; color: #dc2626; }
    .helpful-btn:disabled  { opacity: 0.55; cursor: not-allowed; }
    .helpful-count {
      font-size: 0.72rem;
      font-weight: 400;
      opacity: 0.7;
    }
    .helpful-thankyou {
      display: none;
      font-size: 0.82rem;
      font-weight: 600;
      color: var(--primary);
    }

    /* ── Admin toolbar ──────────────────────────── */
    .article-admin-bar {
      display: flex;
      align-items: center;
      gap: 8px;
      padding: 10px 14px;
      background: #fff;
      border: 1px solid #e2e8f0;
      border-radius: 10px;
      margin-bottom: 22px;
    }
    .article-admin-bar__label {
      font-size: 0.7rem;
      font-weight: 800;
      color: #94a3b8;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      padding-right: 8px;
      border-right: 1px solid #e2e8f0;
      margin-right: 4px;
      white-space: nowrap;
    }
    .article-admin-bar__btns {
      display: flex;
      align-items: center;
      gap: 4px;
    }
    .admin-icon-btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 32px;
      height: 32px;
      border-radius: 8px;
      border: 1px solid #e2e8f0;
      background: #f8fafc;
      cursor: pointer;
      font-family: inherit;
      transition: background 0.15s, border-color 0.15s;
      text-decoration: none;
      flex-shrink: 0;
    }
    .admin-icon-btn svg { pointer-events: none; }
    .admin-icon-btn:hover        { background: #e8f4f5; border-color: #01535b; }
    .admin-icon-btn.warn:hover   { background: #fff7ed; border-color: #f59e0b; }
    .admin-icon-btn.danger:hover { background: #fef2f2; border-color: #dc2626; }
    .admin-bar-sep { width: 1px; height: 18px; background: #e2e8f0; margin: 0 2px; }

    /* ── Edit slide-over ────────────────────────── */
    .edit-overlay {
      position: fixed;
      inset: 0;
      background: rgba(15, 23, 42, 0.45);
      z-index: 900;
      display: none;
      align-items: flex-end;
    }
    .edit-overlay.is-open { display: flex; }

    @media (min-width: 640px) {
      .edit-overlay { align-items: center; justify-content: flex-end; }
    }

    .edit-panel {
      background: #fff;
      width: 100%;
      max-width: 560px;
      height: 100%;
      max-height: 100dvh;
      overflow-y: auto;
      border-radius: 16px 16px 0 0;
      display: flex;
      flex-direction: column;
      box-shadow: -4px 0 40px rgba(15,23,42,0.18);
    }

    @media (min-width: 640px) {
      .edit-panel { border-radius: 16px 0 0 16px; height: 100dvh; }
    }

    .edit-panel__head {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 20px 22px 16px;
      border-bottom: 1px solid #e5e7eb;
      position: sticky;
      top: 0;
      background: #fff;
      z-index: 2;
    }

    .edit-panel__head h2 { font-size: 1.05rem; font-weight: 700; color: #0f172a; margin: 0; }

    .edit-panel__close {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 32px;
      height: 32px;
      border: none;
      background: #f1f5f9;
      border-radius: 50%;
      cursor: pointer;
      font-size: 18px;
      color: #475569;
      font-family: inherit;
    }
    .edit-panel__close:hover { background: #e2e8f0; }

    .edit-panel__body {
      padding: 20px 22px;
      flex: 1;
      display: flex;
      flex-direction: column;
      gap: 15px;
    }

    .ep-form-row { display: grid; gap: 14px; }
    .ep-form-row.two-col { grid-template-columns: 1fr 1fr; }

    .ep-field { display: flex; flex-direction: column; gap: 5px; }

    .ep-field label {
      font-size: 0.8rem;
      font-weight: 700;
      color: #374151;
      text-transform: uppercase;
      letter-spacing: 0.06em;
    }

    .ep-field input,
    .ep-field select,
    .ep-field textarea {
      padding: 10px 12px;
      border: 1px solid #d1d5db;
      border-radius: 8px;
      font-size: 0.95rem;
      font-family: inherit;
      color: #0f172a;
      background: #fff;
      transition: border-color 0.2s;
      width: 100%;
      box-sizing: border-box;
    }

    .ep-field input:focus,
    .ep-field select:focus,
    .ep-field textarea:focus {
      outline: none;
      border-color: #01535b;
      box-shadow: 0 0 0 3px rgba(1,83,91,0.08);
    }

    .ep-field textarea { min-height: 70px; resize: vertical; }

    .ep-field__hint { font-size: 0.78rem; color: #94a3b8; }

    .ep-editor-wrap { border: 1px solid #d1d5db; border-radius: 8px; overflow: hidden; }

    .ep-toolbar {
      display: flex;
      flex-wrap: wrap;
      gap: 2px;
      padding: 8px 10px;
      background: #f8fafc;
      border-bottom: 1px solid #e5e7eb;
    }

    .ep-toolbar button {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 28px;
      height: 28px;
      border: none;
      background: transparent;
      border-radius: 5px;
      cursor: pointer;
      font-size: 13px;
      font-family: inherit;
      font-weight: 700;
      color: #374151;
      transition: background 0.15s;
      padding: 0;
    }

    .ep-toolbar button:hover { background: #e2e8f0; }
    .ep-toolbar .sep { width: 1px; background: #e5e7eb; margin: 3px 4px; align-self: stretch; }

    .ep-editor {
      min-height: 260px;
      max-height: 380px;
      overflow-y: auto;
      padding: 14px;
      outline: none;
      font-size: 0.95rem;
      line-height: 1.65;
      color: #1f2937;
    }

    .ep-editor:focus { box-shadow: inset 0 0 0 2px rgba(1,83,91,0.15); }
    .ep-editor h2 { font-size: 1.2rem; font-weight: 700; margin: 0.8em 0 0.3em; }
    .ep-editor h3 { font-size: 1.05rem; font-weight: 700; margin: 0.8em 0 0.3em; }
    .ep-editor ul, .ep-editor ol { padding-left: 1.4em; margin: 0.4em 0; }
    .ep-editor blockquote { border-left: 3px solid #01535b; padding-left: 12px; color: #475569; margin: 0.5em 0; font-style: italic; }
    .ep-editor a { color: #01535b; }
    .ep-editor code { font-family: monospace; background: #f1f5f9; padding: 1px 5px; border-radius: 3px; font-size: 0.9em; }
    .ep-editor figure.doc-image {
      display: inline-block;
      max-width: 100%;
      position: relative;
    }
    .ep-editor figure.doc-image img {
      display: block;
      width: 100%;
      height: auto;
      margin: 0;
    }
    .ep-editor figure.doc-video {
      position: relative;
      width: 100%;
      max-width: 100%;
      padding-bottom: 56.25%;
      height: 0;
      overflow: hidden;
    }
    .ep-editor figure.doc-video iframe,
    .ep-editor figure.doc-video video {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      border: none;
      margin: 0;
    }
    .ep-editor figure.doc-media.ep-media-resizable {
      box-sizing: border-box;
      outline: 1px dashed transparent;
    }
    .ep-editor figure.doc-media.ep-media-resizable:hover {
      outline-color: rgba(1, 83, 91, 0.22);
    }
    .ep-media-resize-handle {
      position: absolute;
      right: 4px;
      bottom: 4px;
      width: 15px;
      height: 15px;
      border-right: 2px solid #01535b;
      border-bottom: 2px solid #01535b;
      border-radius: 3px;
      background: linear-gradient(135deg, transparent 0 42%, rgba(1, 83, 91, 0.18) 42% 100%);
      cursor: nwse-resize;
      z-index: 2;
      opacity: 0.9;
    }

    .edit-panel__foot {
      padding: 16px 22px;
      border-top: 1px solid #e5e7eb;
      display: flex;
      gap: 10px;
      align-items: center;
      justify-content: flex-end;
      position: sticky;
      bottom: 0;
      background: #fff;
    }

    .ep-error { font-size: 0.85rem; color: #dc2626; flex: 1; display: none; }

    .ep-btn-cancel {
      padding: 10px 20px;
      border: 1px solid #e2e8f0;
      background: #fff;
      border-radius: 8px;
      font-size: 0.92rem;
      font-weight: 600;
      font-family: inherit;
      cursor: pointer;
      color: #374151;
    }
    .ep-btn-cancel:hover { background: #f1f5f9; }

    .ep-btn-save {
      padding: 10px 24px;
      background: #01535b;
      color: #fff;
      border: none;
      border-radius: 8px;
      font-size: 0.92rem;
      font-weight: 700;
      font-family: inherit;
      cursor: pointer;
      display: flex;
      align-items: center;
      gap: 7px;
      transition: background 0.2s;
    }
    .ep-btn-save:hover { background: #014048; }
    .ep-btn-save:disabled { background: #94a3b8; cursor: not-allowed; }

    /* ── Media pickers ────────────────────────────── */
    .ep-mpick {
      display: none;
      border-bottom: 1px solid #e2e8f0;
      background: #f8fafc;
      padding: 10px 12px;
    }
    .ep-mpick.is-open { display: block; }
    .ep-mpick__head {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 10px;
    }
    .ep-mpick__head span { font-size: 0.72rem; font-weight: 800; letter-spacing: 0.06em; text-transform: uppercase; color: #374151; }
    .ep-mpick__close { background: none; border: none; cursor: pointer; font-size: 15px; color: #94a3b8; line-height: 1; padding: 0; }
    .ep-mpick__close:hover { color: #374151; }
    .ep-mpick__tabs { display: flex; gap: 4px; margin-bottom: 8px; }
    .ep-mpick__tab {
      padding: 3px 9px; border: 1px solid #d1d5db; background: #fff;
      border-radius: 6px; font-size: 0.78rem; font-weight: 600;
      font-family: inherit; cursor: pointer; color: #374151;
      transition: background 0.12s;
    }
    .ep-mpick__tab.active { background: #01535b; color: #fff; border-color: #01535b; }
    .ep-mpick__panel { display: none; }
    .ep-mpick__panel.active { display: flex; flex-direction: column; gap: 8px; }
    .ep-mpick__drop {
      display: flex; align-items: center; gap: 7px;
      border: 1.5px dashed #d1d5db; border-radius: 8px;
      padding: 9px 11px; cursor: pointer; color: #6b7280;
      font-size: 0.8rem; transition: border-color 0.15s, background 0.15s;
      background: #fff;
    }
    .ep-mpick__drop:hover, .ep-mpick__drop.drag-over { border-color: #01535b; background: #f0fafa; color: #01535b; }
    .ep-mpick__inp {
      width: 100%; padding: 7px 9px; border: 1px solid #d1d5db;
      border-radius: 6px; font-size: 0.82rem; font-family: inherit;
      background: #fff; box-sizing: border-box;
    }
    .ep-mpick__inp:focus { outline: none; border-color: #01535b; }
    .ep-mpick__row { display: grid; grid-template-columns: 1fr 1fr; gap: 6px; }
    #epImgUploadP .ep-mpick__row .ep-mpick__inp {
      padding: 6px 8px;
      font-size: 0.78rem;
    }
    #epLinkPick .ep-mpick__head span,
    #epVidPick .ep-mpick__head span {
      font-size: 0.7rem;
    }
    #epLinkPick .ep-mpick__inp,
    #epVidPick .ep-mpick__inp {
      padding: 6px 8px;
      font-size: 0.78rem;
    }
    #epLinkPick .ep-mpick__btn,
    #epVidPick .ep-mpick__btn {
      padding: 5px 9px;
      font-size: 0.76rem;
    }
    #epLinkPick .ep-mpick__hint,
    #epVidPick .ep-mpick__hint {
      font-size: 0.72rem;
      line-height: 1.35;
    }
    .ep-mpick__foot { display: flex; align-items: center; gap: 8px; justify-content: flex-end; }
    .ep-mpick__err { font-size: 0.74rem; color: #dc2626; flex: 1; min-height: 1em; }
    .ep-mpick__btn {
      padding: 6px 10px; background: #01535b; color: #fff;
      border: none; border-radius: 6px; font-size: 0.78rem;
      font-weight: 700; font-family: inherit; cursor: pointer;
      white-space: nowrap; transition: background 0.12s;
    }
    .ep-mpick__btn:hover { background: #014048; }
    .ep-mpick__btn:disabled { background: #94a3b8; cursor: not-allowed; }
    .ep-mpick__hint { font-size: 0.76rem; color: #64748b; margin: 0; line-height: 1.45; }

    @media (max-width: 600px) { .ep-form-row.two-col { grid-template-columns: 1fr; } }

    /* ── 404 state ──────────────────────────────── */
    .article-not-found {
      text-align: center;
      padding: 60px 20px;
    }
    .article-not-found__icon {
      font-size: 3rem;
      margin-bottom: 16px;
    }
    .article-not-found h2 {
      color: #0f172a;
      font-size: 1.5rem;
      margin-bottom: 10px;
    }
    .article-not-found p {
      color: var(--text-muted);
      font-size: 0.97rem;
      margin-bottom: 24px;
    }
    .article-not-found a {
      display: inline-flex;
      align-items: center;
      gap: 7px;
      background: var(--primary);
      color: #fff;
      padding: 12px 26px;
      border-radius: 8px;
      font-size: 0.95rem;
      font-weight: 700;
      text-decoration: none;
      transition: background 0.2s;
    }
    .article-not-found a:hover { background: #014048; }

    /* ── Responsive ─────────────────────────────── */
    @media (max-width: 768px) {
      .article-page   { padding: 22px 14px 50px; }
      .article-breadcrumb-row {
        align-items: center;
        gap: 8px;
        flex-wrap: nowrap;
      }
      .article-breadcrumb {
        flex: 1 1 auto;
        flex-wrap: nowrap;
        gap: 3px;
        overflow: hidden;
        white-space: nowrap;
        font-size: 0.68rem;
        line-height: 1.2;
      }
      .article-breadcrumb-label {
        overflow: hidden;
        text-overflow: ellipsis;
      }
      .article-search-panel {
        width: auto;
        min-width: 0;
        position: relative;
      }
      .article-search-toggle { display: inline-flex; }
      .article-search-wrap {
        display: none;
        position: absolute;
        top: 50%;
        right: 0;
        transform: translateY(-50%);
        width: min(78vw, 280px);
        z-index: 30;
      }
      .article-search-panel.is-mobile-open .article-search-wrap { display: block; }
      .article-search-panel.is-mobile-open .article-search-toggle {
        color: var(--primary);
        border-color: var(--primary);
        box-shadow: 0 0 0 3px rgba(1, 83, 91, 0.08);
      }
      .article-search-panel.is-mobile-open .article-search-meta {
        display: block;
        position: absolute;
        top: calc(100% + 6px);
        right: 0;
        width: min(78vw, 280px);
        padding-top: 6px;
        z-index: 30;
      }
      .article-search-meta {
        display: none;
        margin-top: 0;
      }
      .article-header { padding: 20px 18px 16px; }
      .article-title  { font-size: 1.1rem; }
      .article-meta-date { font-size: 0.68rem; }
      .article-tag {
        font-size: 0.58rem;
        padding: 1px 6px;
        max-width: 78px;
      }
      .article-body   { padding: 18px 14px 14px; }
      .article-related { padding: 10px; border-radius: 10px; }
      .article-related h2 { font-size: 0.86rem; }
      .article-related p { font-size: 0.74rem; margin-bottom: 8px; }
      .article-related-link { border-radius: 7px; padding: 6px 8px; }
      .article-related-link strong { font-size: 0.78rem; }
      .article-related-link span { font-size: 0.65rem; }
      .article-content {
        font-size: 0.9rem;
        line-height: 1.65;
      }
      .article-content h2 {
        font-size: 1rem;
        margin: 1.3em 0 0.55em;
      }
      .article-content h3 {
        font-size: 0.9rem;
        margin: 1.15em 0 0.45em;
      }
      .article-content ul,
      .article-content ol {
        padding-left: 1.25em;
      }
      .article-content blockquote {
        padding: 10px 12px;
        border-left-width: 2px;
      }
      .article-helpful { padding: 13px 14px; }
    }
    @media (max-width: 480px) {
      .article-page   { padding: 16px 12px 36px; }
      .article-back   { font-size: 0.82rem; margin-bottom: 14px; }
      .article-breadcrumb-row { gap: 8px; }
      .article-breadcrumb { font-size: 0.62rem; }
      .article-search-toggle {
        width: 32px;
        height: 32px;
      }
      .article-search-wrap,
      .article-search-panel.is-mobile-open .article-search-meta {
        width: min(82vw, 250px);
      }
      .article-header { padding: 16px 14px 12px; border-radius: 10px; }
      .article-body   { padding: 14px 12px; border-radius: 10px; }
      .article-related { padding: 9px; border-radius: 9px; }
      .article-helpful {
        flex-direction: column;
        align-items: flex-start;
        padding: 11px 12px;
        border-radius: 10px;
        gap: 8px;
      }
      .article-title  { font-size: 1rem; }
      .article-meta-date { font-size: 0.64rem; }
      .article-tag {
        font-size: 0.54rem;
        padding: 1px 5px;
        max-width: 72px;
      }
      .article-content { font-size: 0.86rem; line-height: 1.6; }
      .article-content h2 { font-size: 0.94rem; }
      .article-content h3 { font-size: 0.84rem; }
      .article-content pre { padding: 12px 14px; font-size: 0.82rem; border-radius: 8px; }
      .article-content blockquote { padding: 10px 14px; }
      .article-content table { font-size: 0.84rem; }
      .article-content th,
      .article-content td  { padding: 8px 10px; }
      .article-helpful__label { font-size: 0.8rem; }
      .article-helpful__label small { font-size: 0.67rem; }
      .article-helpful__btns {
        width: 100%;
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 7px;
      }
      .helpful-btn {
        justify-content: center;
        padding: 7px 8px;
        font-size: 0.72rem;
      }
      .helpful-count { font-size: 0.65rem; }
      .helpful-thankyou { font-size: 0.74rem; }
    }
  </style>
  <%# The soft light look used across the app (public/js/appearance.js). %>
  <link rel="stylesheet" href="<%= assetUrl('/css/appearance.css') %>">
  <script src="<%= assetUrl('/js/appearance.js') %>" defer></script>
</head>
<body>

<% if (documentationAdmin) { %>
<%- include('../partials/adminHeader') %>
<% } else { %>
<%- include('../partials/header', { showFooterTopSection: showFooterTopSection }) %>
<% } %>

<div class="article-page">

  <% if (pageNotFound) { %>
    <!-- 404 state -->
    <div class="article-not-found">
      <div class="article-not-found__icon">📄</div>
      <h2>Article Not Found</h2>
      <p>We couldn't find the article you were looking for.<br>It may have moved or been removed.</p>
      <a href="/legal/user-documentation">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="15 18 9 12 15 6"></polyline>
        </svg>
        Back to Documentation
      </a>
    </div>

  <% } else { %>

    <% const article = selectedArticle; %>

    <!-- Draft warning (admin only) -->
    <% if (article.status === 'draft') { %>
    <div class="draft-banner">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="12" cy="12" r="10"></circle>
        <line x1="12" y1="8" x2="12" y2="12"></line>
        <line x1="12" y1="16" x2="12.01" y2="16"></line>
      </svg>
      Draft — this article is not published. Only admins can view it.
    </div>
    <% } %>

    <!-- Admin toolbar -->
    <% if (documentationAdmin) { %>
    <div class="article-admin-bar">
      <span class="article-admin-bar__label">Admin</span>
      <div class="article-admin-bar__btns">
        <!-- Edit -->
        <button type="button" class="admin-icon-btn" id="openEditPanel" title="Edit article">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#374151" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
        </button>
        <div class="admin-bar-sep"></div>
        <!-- Publish / Unpublish -->
        <button
          type="button"
          class="admin-icon-btn warn"
          data-action="toggle-status"
          data-id="<%= article.id %>"
          data-current-status="<%= article.status %>"
          title="<%= article.status === 'draft' ? 'Publish this article' : 'Unpublish (move to draft)' %>"
        >
          <% if (article.status === 'draft') { %>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#16a34a" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 11 12 14 22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/></svg>
          <% } else { %>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#64748b" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94"/><path d="M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19"/><line x1="1" y1="1" x2="23" y2="23"/></svg>
          <% } %>
        </button>
        <div class="admin-bar-sep"></div>
        <!-- Delete -->
        <button
          type="button"
          class="admin-icon-btn danger"
          data-action="delete-article"
          data-id="<%= article.id %>"
          data-title="<%= article.title.replace(/"/g, '&quot;') %>"
          title="Delete article"
        >
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#dc2626" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/><path d="M10 11v6"/><path d="M14 11v6"/><path d="M9 6V4h6v2"/></svg>
        </button>
      </div>
    </div>
    <% } %>

    <!-- Breadcrumb -->
    <div class="article-breadcrumb-row">
      <% if (article.breadcrumb && article.breadcrumb.length > 1) { %>
      <nav class="article-breadcrumb" aria-label="Breadcrumb">
        <a href="/legal/user-documentation">Docs</a>
        <% article.breadcrumb.slice(0, -1).forEach(function(crumb) { %>
          <span>/</span>
          <span><%= crumb %></span>
        <% }); %>
      </nav>
      <% } else { %>
      <div></div>
      <% } %>

      <section class="article-search-panel" aria-label="Search documentation and help">
        <button type="button" class="article-search-toggle" id="articleSearchToggle" aria-label="Open search" aria-expanded="false" aria-controls="articleHelpSearch">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
            <circle cx="11" cy="11" r="7"></circle>
            <line x1="16.65" y1="16.65" x2="21" y2="21"></line>
          </svg>
        </button>
        <div class="article-search-wrap">
          <svg class="article-search-ico" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <circle cx="11" cy="11" r="7"></circle>
            <line x1="16.65" y1="16.65" x2="21" y2="21"></line>
          </svg>
          <input type="search" id="articleHelpSearch" class="article-search-input" placeholder="Search anything Managira related…" autocomplete="off">
          <button type="button" id="articleHelpSearchClear" class="article-search-clear" aria-label="Clear search">×</button>
        </div>
        <div class="article-search-meta" id="articleSearchMeta"></div>
      </section>
    </div>

    <div class="article-search-results" id="articleSearchResults">
      <div class="article-results-block" id="articleDocResultsBlock" style="display:none;">
        <h2>Documentation &amp; Guides</h2>
        <div id="articleDocResults"></div>
      </div>
      <div class="article-results-block" id="articleFaqResultsBlock" style="display:none;">
        <h2>From the FAQ</h2>
        <div id="articleFaqResults"></div>
      </div>
      <div id="articleEmptyResultsBlock" class="article-search-empty" style="display:none;">
        <strong>No matches found.</strong>
        Try a different keyword, or use a broader phrase.
      </div>
    </div>

    <!-- Article header -->
    <div class="article-header">
      <h1 class="article-title"><%= article.title %></h1>

      <div class="article-meta-row">
        <% if (article.createdAt || article.updatedAt) { %>
        <%
          const artDate = new Date(article.updatedAt || article.createdAt);
          const artDateStr = artDate.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
        %>
        <span class="article-meta-date">Updated <%= artDateStr %></span>
        <% } %>
        <% if (article.tags && article.tags.length > 0) { %>
          <% article.tags.forEach(function(tag) { %>
            <span class="article-tag"><%= tag %></span>
          <% }); %>
        <% } %>
      </div>
    </div>

    <!-- Article content -->
    <div class="article-body">
      <div class="article-content">
        <%- article.contentHtml %>
      </div>
    </div>

    <% if (Array.isArray(relatedArticles) && relatedArticles.length > 0) { %>
    <section class="article-related" aria-label="Related documentation">
      <h2>Related Documents</h2>
      <p>Related follow-up guides:</p>
      <div class="article-related-list">
        <% relatedArticles.forEach(function(related) { %>
        <a class="article-related-link" href="/legal/user-documentation/<%= related.slug %>">
          <strong><%= related.title %></strong>
          <span><%= related.topic %></span>
        </a>
        <% }); %>
      </div>
    </section>
    <% } %>

    <!-- Was this helpful -->
    <div class="article-helpful" id="helpfulWidget" data-article-id="<%= article.id %>">
      <div class="article-helpful__label">
        Was this article helpful?
        <small>Your feedback helps us improve our documentation.</small>
      </div>
      <div class="article-helpful__btns" id="helpfulBtns">
        <button type="button" class="helpful-btn" id="btnYes" data-vote="yes">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M14 9V5a3 3 0 0 0-3-3l-4 9v11h11.28a2 2 0 0 0 2-1.7l1.38-9a2 2 0 0 0-2-2.3zM7 22H4a2 2 0 0 1-2-2v-7a2 2 0 0 1 2-2h3"></path>
          </svg>
          Yes
          <span class="helpful-count" id="yesCount">(<%= article.helpfulYes %>)</span>
        </button>
        <button type="button" class="helpful-btn" id="btnNo" data-vote="no">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M10 15v4a3 3 0 0 0 3 3l4-9V2H5.72a2 2 0 0 0-2 1.7l-1.38 9a2 2 0 0 0 2 2.3zm7-13h2.67A2.31 2.31 0 0 1 22 4v7a2.31 2.31 0 0 1-2.33 2H17"></path>
          </svg>
          No
          <span class="helpful-count" id="noCount">(<%= article.helpfulNo %>)</span>
        </button>
      </div>
      <div class="helpful-thankyou" id="helpfulThankyou">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="20 6 9 17 4 12"></polyline>
        </svg>
        Thanks for your feedback!
      </div>
    </div>

  <% } %>

</div>

