<script>
(function () {
  const KNOWLEDGE = <%- JSON.stringify(typeof helpKnowledge !== 'undefined' ? helpKnowledge : []) %>;
  const DOCS = <%- JSON.stringify(typeof documentationSearchResources !== 'undefined' ? documentationSearchResources : []) %>;

  const input = document.getElementById('articleHelpSearch');
  const clearBtn = document.getElementById('articleHelpSearchClear');
  const toggleBtn = document.getElementById('articleSearchToggle');
  const searchPanel = toggleBtn ? toggleBtn.closest('.article-search-panel') : null;
  const meta = document.getElementById('articleSearchMeta');
  const wrap = document.getElementById('articleSearchResults');
  const docBlock = document.getElementById('articleDocResultsBlock');
  const faqBlock = document.getElementById('articleFaqResultsBlock');
  const emptyBlock = document.getElementById('articleEmptyResultsBlock');
  const docOut = document.getElementById('articleDocResults');
  const faqOut = document.getElementById('articleFaqResults');

  if (!input || !clearBtn || !meta || !wrap || !docBlock || !faqBlock || !emptyBlock || !docOut || !faqOut) {
    return;
  }

  function isMobileSearchMode() {
    return Boolean(toggleBtn) && window.matchMedia('(max-width: 768px)').matches;
  }

  function setMobileSearchOpen(isOpen) {
    if (!toggleBtn || !searchPanel) {
      return;
    }

    searchPanel.classList.toggle('is-mobile-open', isOpen);
    toggleBtn.classList.toggle('is-open', isOpen);
    toggleBtn.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
  }

  const SYNONYMS = {
    'sign up': ['register', 'registration', 'signup', 'create account', 'enroll'],
    'register': ['sign up', 'signup', 'create account'],
    'login': ['sign in', 'log in', 'access account'],
    'password': ['credentials', 'reset password', 'forgot password'],
    'student': ['students', 'pupil', 'learner', 'kid', 'child'],
    'parent': ['parents', 'guardian', 'guardians', 'family'],
    'guardian': ['parent', 'family', 'guardian portal'],
    'report': ['report card', 'reports', 'merit sheet', 'transcript', 'result'],
    'grade': ['grades', 'marks', 'score', 'results', 'assessment'],
    'attendance': ['present', 'absent', 'roll call', 'register'],
    'fee': ['fees', 'payment', 'billing', 'subscription', 'invoice'],
    'class': ['classes', 'classroom', 'grade level'],
    'demo': ['demo', 'preview', 'walkthrough', 'tour'],
    'doc': ['documentation', 'guide', 'manual', 'help', 'tutorial'],
    'bulk': ['import', 'csv', 'spreadsheet', 'mass upload'],
    'hub': ['hubs', 'district', 'government', 'multi school'],
    'theme': ['color', 'branding', 'logo', 'personalization', 'personalisation'],
  };

  function expandTokens(query) {
    const normalized = String(query || '').toLowerCase().trim();
    const base = normalized.split(/\s+/).filter(Boolean);
    const expanded = new Set(base);

    if (normalized) {
      expanded.add(normalized);
    }

    Object.keys(SYNONYMS).forEach(function (key) {
      if (normalized.includes(key)) {
        SYNONYMS[key].forEach(function (value) { expanded.add(value); });
      }
    });

    base.forEach(function (token) {
      if (SYNONYMS[token]) {
        SYNONYMS[token].forEach(function (value) { expanded.add(value); });
      }
      if (token.length > 3 && token.endsWith('s')) {
        expanded.add(token.slice(0, -1));
      }
    });

    return Array.from(expanded);
  }

  function scoreItem(haystack, tokens) {
    const text = String(haystack || '').toLowerCase();
    let score = 0;
    tokens.forEach(function (token) {
      if (!token) return;
      if (text.includes(token)) {
        score += token.includes(' ') ? 6 : 3;
      }
    });
    return score;
  }

  function shouldSearchFaq(query) {
    const normalized = String(query || '').toLowerCase().replace(/[^a-z0-9\s]+/g, ' ').trim();
    const wordCount = normalized.split(/\s+/).filter(Boolean).length;
    return wordCount >= 4;
  }

  function faqMatchesExactPhrase(item, normalizedQuery) {
    if (!normalizedQuery) return false;
    const question = String(item.question || '').toLowerCase().replace(/[^a-z0-9\s]+/g, ' ').trim();
    const answer = String(item.answer || '').toLowerCase().replace(/[^a-z0-9\s]+/g, ' ').trim();
    const keywords = Array.isArray(item.keywords)
      ? item.keywords.map(function (kw) {
          return String(kw || '').toLowerCase().replace(/[^a-z0-9\s]+/g, ' ').trim();
        })
      : [];

    if (question.includes(normalizedQuery) || answer.includes(normalizedQuery)) {
      return true;
    }

    return keywords.some(function (kw) {
      return kw.includes(normalizedQuery);
    });
  }

  function escapeHtml(value) {
    return String(value).replace(/[&<>"']/g, function (char) {
      return ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[char];
    });
  }

  function highlight(text, tokens, max) {
    const source = String(text || '');
    if (!source) return '';

    const limit = max || 220;
    let snippet = source;
    let firstIndex = -1;

    tokens.forEach(function (token) {
      if (!token) return;
      const index = source.toLowerCase().indexOf(token);
      if (index !== -1 && (firstIndex === -1 || index < firstIndex)) {
        firstIndex = index;
      }
    });

    if (firstIndex > 80) {
      const start = Math.max(0, firstIndex - 60);
      snippet = (start > 0 ? '… ' : '') + source.slice(start, start + limit);
    } else {
      snippet = source.slice(0, limit);
    }

    if (source.length > snippet.length + (firstIndex > 80 ? 60 : 0)) {
      snippet += '…';
    }

    tokens
      .filter(Boolean)
      .sort(function (left, right) { return right.length - left.length; })
      .forEach(function (token) {
        if (token.length < 2) return;
        const pattern = new RegExp('(' + token.replace(/[.*+?^${}()|[\]\\]/g, '\\$&') + ')', 'gi');
        snippet = snippet.replace(pattern, '<mark>$1</mark>');
      });

    return snippet;
  }

  function search(query) {
    const tokens = expandTokens(query);
    const normalizedQuery = String(query || '').toLowerCase().replace(/[^a-z0-9\s]+/g, ' ').trim();

    const docHits = DOCS.map(function (item) {
      const haystack = [item.title, item.subtitle, Array.isArray(item.keywords) ? item.keywords.join(' ') : ''].join(' ');
      return { item: item, score: scoreItem(haystack, tokens) };
    })
      .filter(function (entry) { return entry.score > 0; })
      .sort(function (left, right) { return right.score - left.score; })
      .slice(0, 6);

    const faqHits = shouldSearchFaq(query)
      ? KNOWLEDGE.filter(function (item) {
          return faqMatchesExactPhrase(item, normalizedQuery);
        })
          .slice(0, 8)
          .map(function (item) {
            return { item: item };
          })
      : [];

    return { docHits: docHits, faqHits: faqHits, tokens: tokens };
  }

  function renderDocCards(hits, tokens) {
    if (!hits.length) {
      docBlock.style.display = 'none';
      docOut.innerHTML = '';
      return;
    }

    docBlock.style.display = '';
    docOut.innerHTML = hits.map(function (hit) {
      const item = hit.item || hit;
      const isArticle = Boolean(item.isArticle);
      const typeClass = isArticle ? 'article-result-type--article' : 'article-result-type--doc';
      const typeLabel = isArticle ? 'Article' : 'Doc';
      const extAttr = item.external ? ' target="_blank" rel="noopener"' : '';
      const cta = isArticle ? 'Read article →' : (item.external ? 'Open ↗' : 'Open →');
      const snippet = highlight(item.subtitle || item.breadcrumb || '', tokens);
      return '<div class="article-result-card">'
        + '<div class="article-result-row">'
        + '<span class="article-result-type ' + typeClass + '">' + typeLabel + '</span>'
        + '<a class="article-result-title" href="' + escapeHtml(item.url) + '"' + extAttr + '>' + escapeHtml(item.title) + '</a>'
        + '</div>'
        + '<p class="article-result-meta">' + (snippet ? snippet + ' · ' : '') + '<a class="article-result-cta" href="' + escapeHtml(item.url) + '"' + extAttr + '>' + cta + '</a></p>'
        + '</div>';
    }).join('');
  }

  let liveAbort = null;
  let debounce = null;

  function render(query) {
    const trimmed = String(query || '').trim();
    if (!trimmed) {
      wrap.classList.remove('is-visible');
      meta.textContent = '';
      clearBtn.style.display = 'none';
      docBlock.style.display = 'none';
      faqBlock.style.display = 'none';
      emptyBlock.style.display = 'none';
      docOut.innerHTML = '';
      faqOut.innerHTML = '';
      if (liveAbort) {
        liveAbort.abort();
        liveAbort = null;
      }
      if (isMobileSearchMode()) {
        setMobileSearchOpen(false);
      }
      return;
    }

    wrap.classList.add('is-visible');
    clearBtn.style.display = 'flex';
    if (isMobileSearchMode()) {
      setMobileSearchOpen(true);
    }

    const result = search(trimmed);
    const docHits = result.docHits;
    const faqHits = result.faqHits;
    const tokens = result.tokens;

    if (faqHits.length) {
      faqBlock.style.display = '';
      faqOut.innerHTML = faqHits.map(function (hit) {
        const faqUrl = '/legal/faq?q=' + encodeURIComponent(hit.item.question);
        const snippet = highlight(hit.item.answer, tokens);
        return '<div class="article-result-card">'
          + '<div class="article-result-row">'
          + '<span class="article-result-type article-result-type--faq">FAQ</span>'
          + '<a class="article-result-title" href="' + faqUrl + '">' + escapeHtml(hit.item.question) + '</a>'
          + '</div>'
          + '<p class="article-result-meta">' + (snippet ? snippet + ' · ' : '') + '<a class="article-result-cta" href="' + faqUrl + '">Read full answer →</a></p>'
          + '</div>';
      }).join('');
    } else {
      faqBlock.style.display = 'none';
      faqOut.innerHTML = '';
    }

    renderDocCards(docHits, tokens);

    const localTotal = docHits.length + faqHits.length;
    meta.textContent = localTotal === 0
      ? 'Searching "' + trimmed + '"…'
      : localTotal + ' result' + (localTotal === 1 ? '' : 's') + ' for "' + trimmed + '"';
    emptyBlock.style.display = localTotal === 0 ? '' : 'none';

    if (liveAbort) {
      liveAbort.abort();
    }
    if (trimmed.length < 2) {
      return;
    }

    liveAbort = new AbortController();
    const capturedQuery = trimmed;
    const capturedTokens = tokens;
    const capturedFaqCount = faqHits.length;

    fetch('/legal/user-documentation/api/search?q=' + encodeURIComponent(trimmed), {
      signal: liveAbort.signal,
      headers: { Accept: 'application/json' }
    })
      .then(function (response) { return response.json(); })
      .then(function (data) {
        if (!data.success || !Array.isArray(data.articles)) {
          return;
        }

        liveAbort = null;
        const articleHits = data.articles.map(function (article) {
          return {
            item: {
              isArticle: true,
              title: article.title,
              subtitle: article.seoDescription || article.excerpt || '',
              url: '/legal/user-documentation/' + article.slug,
              external: false,
              breadcrumb: [article.topic, article.subtopic].filter(Boolean).join(' / '),
            }
          };
        });

        const combined = articleHits.concat(docHits.filter(function (hit) {
          return hit.item && hit.item.external;
        }));

        renderDocCards(combined, capturedTokens);

        const total = combined.length + capturedFaqCount;
        meta.textContent = total === 0
          ? 'No matches for "' + capturedQuery + '".'
          : total + ' result' + (total === 1 ? '' : 's') + ' for "' + capturedQuery + '"';
        emptyBlock.style.display = total === 0 ? '' : 'none';
      })
      .catch(function (error) {
        if (error.name !== 'AbortError') {
          console.warn('Documentation search error:', error);
        }
      });
  }

  input.addEventListener('input', function (event) {
    clearTimeout(debounce);
    debounce = setTimeout(function () {
      render(event.target.value);
    }, 120);
  });

  if (toggleBtn && searchPanel) {
    toggleBtn.addEventListener('click', function () {
      if (!isMobileSearchMode()) {
        input.focus();
        return;
      }

      const shouldOpen = !searchPanel.classList.contains('is-mobile-open');
      setMobileSearchOpen(shouldOpen);
      if (shouldOpen) {
        setTimeout(function () { input.focus(); }, 0);
      }
    });

    document.addEventListener('click', function (event) {
      if (!isMobileSearchMode() || !searchPanel.classList.contains('is-mobile-open')) {
        return;
      }

      if (!searchPanel.contains(event.target) && !wrap.contains(event.target)) {
        if (!input.value.trim()) {
          setMobileSearchOpen(false);
        }
      }
    });

    window.addEventListener('resize', function () {
      if (!isMobileSearchMode()) {
        setMobileSearchOpen(false);
      }
    });
  }

  clearBtn.addEventListener('click', function () {
    input.value = '';
    if (isMobileSearchMode()) {
      setMobileSearchOpen(true);
    }
    input.focus();
    render('');
  });
})();

(function () {
  // ── Helpful vote widget ──────────────────────────
  const widget      = document.getElementById('helpfulWidget');
  const btnYes      = document.getElementById('btnYes');
  const btnNo       = document.getElementById('btnNo');
  const yesCount    = document.getElementById('yesCount');
  const noCount     = document.getElementById('noCount');
  const thankYou    = document.getElementById('helpfulThankyou');
  const helpfulBtns = document.getElementById('helpfulBtns');

  if (widget && btnYes && btnNo) {
    const articleId  = widget.dataset.articleId;
    const storageKey = 'managira_helpful_' + articleId;

    if (localStorage.getItem(storageKey)) {
      const prior = localStorage.getItem(storageKey);
      if (prior === 'yes') btnYes.classList.add('voted-yes');
      if (prior === 'no')  btnNo.classList.add('voted-no');
      btnYes.disabled = true;
      btnNo.disabled  = true;
    }

    async function castVote(vote) {
      btnYes.disabled = true;
      btnNo.disabled  = true;
      let saved = false;
      try {
        const res = await fetch('/legal/user-documentation/api/helpful', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ articleId: Number(articleId), vote }),
        });
        const data = await res.json();
        if (res.ok && data && data.success) {
          const helpfulYes = data.helpfulYes !== undefined ? data.helpfulYes : (data.counts && data.counts.helpfulYes);
          const helpfulNo = data.helpfulNo !== undefined ? data.helpfulNo : (data.counts && data.counts.helpfulNo);
          if (helpfulYes !== undefined && helpfulNo !== undefined) {
            yesCount.textContent = '(' + helpfulYes + ')';
            noCount.textContent  = '(' + helpfulNo + ')';
          }
          saved = true;
        }
      } catch (_) {}
      if (!saved) {
        btnYes.disabled = false;
        btnNo.disabled  = false;
        return;
      }
      if (vote === 'yes') btnYes.classList.add('voted-yes');
      else                btnNo.classList.add('voted-no');
      localStorage.setItem(storageKey, vote);
      helpfulBtns.style.display = 'none';
      thankYou.style.display    = 'flex';
    }

    btnYes.addEventListener('click', function () { castVote('yes'); });
    btnNo.addEventListener('click',  function () { castVote('no');  });
  }

  // ── Admin status toggle ──────────────────────────
  document.querySelectorAll('[data-action="toggle-status"]').forEach(function (btn) {
    btn.addEventListener('click', async function () {
      const id      = btn.dataset.id;
      const current = btn.dataset.currentStatus;
      const next    = current === 'draft' ? 'active' : 'draft';
      if (!confirm('Change status to "' + (next === 'active' ? 'Published' : 'Draft') + '"?')) return;
      btn.disabled = true;
      try {
        const res  = await fetch('/legal/user-documentation/api/articles/' + id + '/status', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ status: next }),
        });
        const data = await res.json();
        if (data.success) location.reload();
        else alert(data.message || 'Failed to update status.');
      } catch (_) { alert('Request failed.'); }
      btn.disabled = false;
    });
  });

  // ── Admin delete ─────────────────────────────────
  document.querySelectorAll('[data-action="delete-article"]').forEach(function (btn) {
    btn.addEventListener('click', async function () {
      const id    = btn.dataset.id;
      const title = btn.dataset.title;
      if (!confirm('Permanently delete "' + title + '"? This cannot be undone.')) return;
      btn.disabled = true;
      try {
        const res  = await fetch('/legal/user-documentation/api/articles/' + id + '/delete', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
        });
        const data = await res.json();
        if (data.success) window.location.href = '/legal/user-documentation';
        else alert(data.message || 'Failed to delete article.');
      } catch (_) { alert('Request failed.'); }
      btn.disabled = false;
    });
  });

  // ── Edit panel ───────────────────────────────────
  const editOverlay  = document.getElementById('editOverlay');
  if (!editOverlay) return;

  const epEditor   = document.getElementById('epEditor');
  const epError    = document.getElementById('epError');
  const saveEditBtn = document.getElementById('saveEditBtn');

  function openEdit() {
    epError.style.display = 'none';
    setupEditorMediaResize(epEditor);
    editOverlay.classList.add('is-open');
    epEditor.focus();
  }

  function closeEdit() {
    editOverlay.classList.remove('is-open');
  }

  document.getElementById('openEditPanel').addEventListener('click', openEdit);
  document.getElementById('closeEditPanel').addEventListener('click', closeEdit);
  document.getElementById('cancelEditPanel').addEventListener('click', closeEdit);

  editOverlay.addEventListener('click', function (e) {
    if (e.target === editOverlay) closeEdit();
  });

  document.addEventListener('keydown', function (e) {
    if (e.key === 'Escape') closeEdit();
  });

  // Toolbar
  document.getElementById('epToolbar').addEventListener('mousedown', function (e) {
    const btn = e.target.closest('[data-cmd]');
    if (!btn) return;
    e.preventDefault();
    document.execCommand(btn.dataset.cmd, false, btn.dataset.val || null);
    epEditor.focus();
  });

  // ── Media picker helpers ─────────────────────────────────────────────────
  let _epSavedRange = null;

  // Track cursor whenever the editor loses focus (user clicks into a picker)
  epEditor.addEventListener('blur', function () {
    const sel = window.getSelection();
    if (sel && sel.rangeCount > 0 && epEditor.contains(sel.anchorNode)) {
      _epSavedRange = sel.getRangeAt(0).cloneRange();
    }
  });

  function epMediaInsert(html) {
    epEditor.focus();
    if (_epSavedRange) {
      const sel = window.getSelection();
      sel.removeAllRanges();
      sel.addRange(_epSavedRange);
      _epSavedRange = null;
    }
    document.execCommand('insertHTML', false, html);
    setupEditorMediaResize(epEditor);
  }

  function setupEditorMediaResize(container) {
    if (!container) return;

    container.querySelectorAll('figure.doc-media').forEach(function (figure) {
      if (figure.dataset.mediaResizable === 'true') return;
      figure.dataset.mediaResizable = 'true';
      figure.classList.add('ep-media-resizable');

      if (!figure.querySelector('.ep-media-resize-handle')) {
        const handle = document.createElement('span');
        handle.className = 'ep-media-resize-handle';
        handle.setAttribute('contenteditable', 'false');
        handle.setAttribute('aria-hidden', 'true');
        handle.title = 'Drag to resize';
        figure.appendChild(handle);
      }
    });

    if (container.dataset.resizeBound === 'true') return;
    container.dataset.resizeBound = 'true';

    let resizeState = null;

    container.addEventListener('mousedown', function (event) {
      const handle = event.target.closest('.ep-media-resize-handle');
      if (!handle || !container.contains(handle)) return;

      const figure = handle.closest('figure.doc-media');
      if (!figure) return;

      event.preventDefault();
      event.stopPropagation();

      const rect = figure.getBoundingClientRect();
      resizeState = {
        figure,
        startX: event.clientX,
        startWidth: rect.width || figure.offsetWidth || 320,
        minWidth: figure.classList.contains('doc-video') ? 260 : 180,
        maxWidth: Math.max(figure.parentElement ? figure.parentElement.clientWidth : container.clientWidth, 320),
      };

      figure.classList.add('is-resizing');

      const onMove = function (moveEvent) {
        if (!resizeState) return;
        const delta = moveEvent.clientX - resizeState.startX;
        const nextWidth = Math.min(resizeState.maxWidth, Math.max(resizeState.minWidth, Math.round(resizeState.startWidth + delta)));
        resizeState.figure.style.width = `${nextWidth}px`;
      };

      const endResize = function () {
        if (!resizeState) return;
        resizeState.figure.classList.remove('is-resizing');
        resizeState = null;
        document.removeEventListener('mousemove', onMove);
        document.removeEventListener('mouseup', endResize);
      };

      document.addEventListener('mousemove', onMove);
      document.addEventListener('mouseup', endResize, { once: true });
    });
  }

  function getCleanEditorHtml() {
    const clone = epEditor.cloneNode(true);
    clone.querySelectorAll('.ep-media-resize-handle').forEach(function (handle) {
      handle.remove();
    });
    clone.querySelectorAll('figure.doc-media').forEach(function (figure) {
      figure.removeAttribute('data-media-resizable');
      figure.classList.remove('ep-media-resizable', 'is-resizing');
    });
    return clone.innerHTML;
  }

  function epEsc(s) {
    return String(s).replace(/[&<>"']/g, function(c) {
      return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c];
    });
  }

  function epTogglePicker(id) {
    ['epImgPick', 'epVidPick', 'epLinkPick'].forEach(function(pid) {
      const el = document.getElementById(pid);
      if (pid === id) { el.classList.toggle('is-open'); }
      else            { el.classList.remove('is-open'); }
    });
  }

  function epRestoreSavedRange() {
    epEditor.focus();
    if (_epSavedRange) {
      const sel = window.getSelection();
      sel.removeAllRanges();
      sel.addRange(_epSavedRange);
    }
  }

  function epSelectedText() {
    if (!_epSavedRange) return '';
    return String(_epSavedRange.toString() || '').trim();
  }

  document.getElementById('epInsertLink').addEventListener('mousedown', function (e) {
    e.preventDefault();
    const sel = window.getSelection();
    if (sel && sel.rangeCount > 0 && epEditor.contains(sel.anchorNode)) {
      _epSavedRange = sel.getRangeAt(0).cloneRange();
    }
    document.getElementById('epLinkUrl').value = '';
    document.getElementById('epLinkText').value = epSelectedText();
    document.getElementById('epLinkErr').textContent = '';
    epTogglePicker('epLinkPick');
  });

  // Close buttons
  document.querySelectorAll('.ep-mpick__close').forEach(function(btn) {
    btn.addEventListener('click', function() {
      const id = btn.dataset.close;
      if (id) document.getElementById(id).classList.remove('is-open');
    });
  });

  // Tab switching
  document.querySelectorAll('.ep-mpick__tab').forEach(function(tab) {
    tab.addEventListener('click', function() {
      const panelId = tab.dataset.for;
      const picker  = tab.closest('.ep-mpick');
      picker.querySelectorAll('.ep-mpick__tab').forEach(function(t) { t.classList.remove('active'); });
      picker.querySelectorAll('.ep-mpick__panel').forEach(function(p) { p.classList.remove('active'); });
      tab.classList.add('active');
      document.getElementById(panelId).classList.add('active');
    });
  });

  // Open image picker (save cursor on mousedown before focus shifts)
  document.getElementById('epInsertImage').addEventListener('mousedown', function(e) {
    e.preventDefault();
    const sel = window.getSelection();
    if (sel && sel.rangeCount > 0 && epEditor.contains(sel.anchorNode)) {
      _epSavedRange = sel.getRangeAt(0).cloneRange();
    }
    epTogglePicker('epImgPick');
  });

  // Open video picker
  document.getElementById('epInsertVideo').addEventListener('mousedown', function(e) {
    e.preventDefault();
    const sel = window.getSelection();
    if (sel && sel.rangeCount > 0 && epEditor.contains(sel.anchorNode)) {
      _epSavedRange = sel.getRangeAt(0).cloneRange();
    }
    epTogglePicker('epVidPick');
  });

  document.getElementById('epImgFileInp').addEventListener('change', function(e) {
    const file = e.target.files[0];
    if (file) document.getElementById('epImgDropLabel').textContent = file.name;
  });

  // Upload image to S3 and insert
  document.getElementById('epImgUploadBtn').addEventListener('click', async function() {
    const file  = document.getElementById('epImgFileInp').files[0];
    const errEl = document.getElementById('epImgUploadErr');
    errEl.textContent = '';
    if (!file) { errEl.textContent = 'Please select an image first.'; return; }

    const btn = document.getElementById('epImgUploadBtn');
    btn.disabled = true;
    btn.textContent = 'Uploading...';

    try {
      const fd = new FormData();
      fd.append('file', file);
      const alt     = document.getElementById('epImgAlt').value.trim();
      const caption = document.getElementById('epImgCaption').value.trim();
      if (alt)     fd.append('alt', alt);
      if (caption) fd.append('caption', caption);

      const res  = await fetch('/legal/user-documentation/api/media', { method: 'POST', body: fd });
      const data = await res.json();
      if (!data.success) { errEl.textContent = data.message || 'Upload failed.'; return; }

      epMediaInsert(data.html);
      document.getElementById('epImgPick').classList.remove('is-open');
      document.getElementById('epImgFileInp').value = '';
      document.getElementById('epImgAlt').value = '';
      document.getElementById('epImgCaption').value = '';
      document.getElementById('epImgDropLabel').textContent = 'Choose image';
    } catch (_) {
      errEl.textContent = 'Network error. Please try again.';
    } finally {
      btn.disabled = false;
      btn.textContent = 'Insert';
    }
  });

  // Insert image by URL
  document.getElementById('epImgUrlBtn').addEventListener('click', function() {
    const url = document.getElementById('epImgUrlInp').value.trim();
    if (!url) return;
    const alt     = document.getElementById('epImgUrlAlt').value.trim();
    const caption = document.getElementById('epImgUrlCap').value.trim();
    const figcap  = caption ? `<figcaption>${epEsc(caption)}</figcaption>` : '';
    const html = `<figure class="doc-media doc-image"><img class="doc-inline-image" src="${epEsc(url)}" alt="${epEsc(alt || 'Image')}">${figcap}</figure>`;
    epMediaInsert(html);
    document.getElementById('epImgPick').classList.remove('is-open');
    document.getElementById('epImgUrlInp').value = '';
    document.getElementById('epImgUrlAlt').value = '';
    document.getElementById('epImgUrlCap').value = '';
  });

  // Embed YouTube / Vimeo video
  document.getElementById('epVidEmbedBtn').addEventListener('click', function() {
    const raw   = document.getElementById('epVidUrl').value.trim();
    const errEl = document.getElementById('epVidErr');
    errEl.textContent = '';
    if (!raw) { errEl.textContent = 'Please enter a URL.'; return; }

    let embedSrc = null;
    const ytMatch = raw.match(/(?:youtube\.com\/(?:watch\?v=|embed\/|shorts\/)|youtu\.be\/)([A-Za-z0-9_-]{11})/);
    if (ytMatch) embedSrc = `https://www.youtube-nocookie.com/embed/${ytMatch[1]}`;
    const viMatch = !ytMatch && raw.match(/vimeo\.com\/(?:video\/)?(\d+)/);
    if (viMatch) embedSrc = `https://player.vimeo.com/video/${viMatch[1]}`;

    if (!embedSrc) { errEl.textContent = 'Could not parse a YouTube or Vimeo URL.'; return; }

    const html = `<figure class="doc-media doc-video"><iframe class="doc-youtube-embed" src="${epEsc(embedSrc)}" title="Embedded video" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen loading="lazy"></iframe></figure>`;
    epMediaInsert(html);
    document.getElementById('epVidPick').classList.remove('is-open');
    document.getElementById('epVidUrl').value = '';
  });

  document.getElementById('epLinkInsertBtn').addEventListener('click', function() {
    const url = document.getElementById('epLinkUrl').value.trim();
    const textInput = document.getElementById('epLinkText').value.trim();
    const linkErr = document.getElementById('epLinkErr');
    linkErr.textContent = '';

    if (!url) {
      linkErr.textContent = 'Please enter a link URL.';
      return;
    }

    const linkText = textInput || epSelectedText() || url;
    epRestoreSavedRange();
    const sel = window.getSelection();
    const hasSelection = sel && !sel.isCollapsed && String(sel.toString() || '').trim();

    if (hasSelection) {
      document.execCommand('createLink', false, url);
      const anchor = sel.anchorNode && sel.anchorNode.parentElement && sel.anchorNode.parentElement.closest('a');
      if (anchor) {
        anchor.textContent = linkText;
        anchor.setAttribute('href', url);
      }
    } else {
      document.execCommand('insertHTML', false, `<a href="${epEsc(url)}">${epEsc(linkText)}</a>`);
    }

    document.getElementById('epLinkPick').classList.remove('is-open');
    document.getElementById('epLinkUrl').value = '';
    document.getElementById('epLinkText').value = '';
    epEditor.focus();
  });

  // Save
  saveEditBtn.addEventListener('click', async function () {
    epError.style.display = 'none';
    const id    = document.getElementById('epArticleId').value;
    const title = document.getElementById('epTitle').value.trim();
    const topic = document.getElementById('epTopic').value.trim();
    if (!title) { showEpError('Title is required.'); return; }
    if (!topic) { showEpError('Topic is required.'); return; }

    saveEditBtn.disabled = true;
    saveEditBtn.textContent = 'Saving…';

    const payload = {
      title,
      topic,
      subtopic: document.getElementById('epSubtopic').value.trim(),
      status:   document.getElementById('epStatus').value,
      tags:     document.getElementById('epTags').value.split(',').map(function(t){ return t.trim(); }).filter(Boolean),
      seoDescription: document.getElementById('epSeo').value.trim(),
      contentHtml: getCleanEditorHtml(),
    };

    try {
      const res  = await fetch('/legal/user-documentation/api/articles/' + id, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
      });
      const data = await res.json();
      if (!data.success) { showEpError(data.message || 'Could not save.'); return; }
      closeEdit();
      window.location.href = '/legal/user-documentation/' + data.article.slug;
    } catch (_) {
      showEpError('Network error. Please try again.');
    } finally {
      saveEditBtn.disabled = false;
      saveEditBtn.innerHTML = '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg> Save Changes';
    }
  });

  function showEpError(msg) {
    epError.textContent    = msg;
    epError.style.display  = 'block';
  }
}());
</script>

</body>
