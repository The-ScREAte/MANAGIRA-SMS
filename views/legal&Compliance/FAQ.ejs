<%
  const availableFaqEntries = Array.isArray(faqEntries) ? faqEntries : [];
  const availableFaqCategories = Array.isArray(faqCategories) && faqCategories.length
    ? faqCategories
    : Array.from(new Set(availableFaqEntries.map((entry) => entry.category).filter(Boolean)));
  const faqCategorySlug = (value) => String(value || '')
    .toLowerCase()
    .replace(/&/g, ' and ')
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/^-+|-+$/g, '');
%>
<style>
  :root {
    --font-family: "<%= (session && session.fontStyle ? String(session.fontStyle).trim() : 'Inter') %>", sans-serif;
    --primary: #01535b;
    --primary-light: #e8f4f5;
    --border: #e5e7eb;
    --text: #1f2937;
    --text-muted: #6b7280;
    --bg: #f9fafb;
  }

  body {
    font-family: var(--font-family);
    color: var(--text);
    margin: 0;
    background-color: var(--bg);
    line-height: 1.6;
    box-sizing: border-box;
  }

  *, *::before, *::after { box-sizing: border-box; }

  main {
    max-width: 1140px;
    margin: 0 auto;
  }

  /* Override global chatbot FAQ styles leaking into the public FAQ page. */
  main#faq-page .faq-category,
  main#faq-page .faq-category h2,
  main#faq-page .faq-question,
  main#faq-page .faq-answer {
    text-transform: none !important;
    letter-spacing: normal !important;
  }

  .page-header {
    text-align: center;
    margin-bottom: 32px;
  }

  .page-header h1 {
    color: var(--primary);
    font-size: 2.2rem;
    font-weight: 700;
    margin: 0 0 8px;
  }

  .page-header p {
    color: var(--text-muted);
    font-size: 0.95rem;
    margin: 0;
  }

  #search-bar {
    width: 100%;
    padding: 12px 16px;
    margin-bottom: 28px;
    border: 1px solid var(--border);
    border-radius: 10px;
    font-size: 1rem; /* 16px — prevents iOS Safari auto-zoom on tap */
    font-family: var(--font-family);
    background: #fff;
    transition: border-color 0.2s, box-shadow 0.2s;
    box-sizing: border-box;
    position: sticky;
    top: 70px;
    z-index: 10;
    box-shadow: 0 2px 8px rgba(0,0,0,0.06);
  }

  #search-bar:focus {
    outline: none;
    border-color: var(--primary);
    box-shadow: 0 0 0 3px rgba(1, 83, 91, 0.08);
  }

  .faq-category {
    margin-bottom: 32px;
  }

  .faq-category h2 {
    font-size: 1.15rem;
    font-weight: 600;
    color: var(--primary);
    margin: 0 0 14px;
    padding-bottom: 10px;
    border-bottom: 2px solid var(--primary-light);
  }

  .faq-item {
    margin-bottom: 8px;
  }

  .faq-question {
    font-size: 0.98rem;
    font-weight: 500;
    color: var(--text);
    cursor: pointer;
    padding: 14px 44px 14px 18px;
    background: #fff;
    border: 1px solid var(--border);
    border-radius: 10px;
    position: relative;
    transition: border-color 0.2s, background 0.2s;
    line-height: 1.5;
  }

  .faq-question:hover {
    border-color: var(--primary);
    background: var(--primary-light);
  }

  .faq-question::after {
    content: '+';
    position: absolute;
    right: 16px;
    top: 50%;
    transform: translateY(-50%);
    font-size: 1.3rem;
    color: var(--primary);
    font-weight: 300;
    transition: transform 0.25s;
    line-height: 1;
  }

  .faq-question.open {
    border-color: var(--primary);
    background: var(--primary-light);
    border-radius: 10px 10px 0 0;
    border-bottom: none;
  }

  .faq-question.open::after {
    transform: translateY(-50%) rotate(45deg);
  }

  .faq-answer {
    display: none;
    font-size: 0.93rem;
    line-height: 1.7;
    color: var(--text-muted);
    padding: 16px 18px;
    background: #fff;
    border: 1px solid var(--primary);
    border-top: none;
    border-radius: 0 0 10px 10px;
    margin-top: 0;
  }

  .help-cta {
    background: #fff;
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 24px;
    text-align: center;
    margin-top: 20px;
  }

  .help-cta p {
    margin: 0 0 12px;
    font-size: 0.95rem;
    color: var(--text);
  }

  .help-cta a {
    display: inline-block;
    padding: 10px 24px;
    background: var(--primary);
    color: #fff;
    border-radius: 8px;
    text-decoration: none;
    font-weight: 600;
    font-size: 0.92rem;
    transition: background 0.2s;
  }

  .help-cta a:hover { background: #014048; }

  @media (max-width: 768px) {
    main { padding: 100px 20px 40px; }
    .page-header h1 { font-size: 1.8rem; padding-top: 20px; }
    #faq-container { margin: 0 12px; }
  }

  @media (max-width: 480px) {
    main { padding: 110px 16px 40px; }
    .page-header h1 { font-size: 1.5rem; padding-top: 30px; }
    #faq-container { margin: 0 8px; }
    .faq-question { font-size: 0.92rem; padding: 12px 40px 12px 14px; }
    .faq-answer { font-size: 0.88rem; padding: 14px; }
  }
</style>
</head>
<body>
  <main id="faq-page">
    <div class="page-header">
      <h1>Frequently Asked Questions</h1>
      <p>Find answers to common questions about Managira</p>
    </div>

    <input type="text" id="search-bar" placeholder="Search for a question...">

    <div id="faq-container">
      <% if (!availableFaqEntries.length) { %>
        <p style="margin:0 0 20px; color: var(--text-muted);">No FAQ entries are available right now.</p>
      <% } %>

      <% availableFaqCategories.forEach(function(category) { %>
        <% const items = availableFaqEntries.filter(function(entry) { return entry.category === category; }); %>
        <% if (items.length) { %>
          <div class="faq-category" data-category="<%= faqCategorySlug(category) %>">
            <h2><%= category %></h2>
            <% items.forEach(function(item) { %>
              <div class="faq-item">
                <div class="faq-question"><%= item.question %></div>
                <div class="faq-answer"><%= item.answer %></div>
              </div>
            <% }); %>
          </div>
        <% } %>
      <% }); %>
    </div>

  </main>

  <script>
    document.addEventListener('click', function (e) {
      if (e.target.classList.contains('faq-question')) {
        const wasOpen = e.target.classList.contains('open');
        document.querySelectorAll('.faq-question.open').forEach(function(q) {
          q.classList.remove('open');
          q.nextElementSibling.style.display = 'none';
        });
        if (!wasOpen) {
          e.target.classList.add('open');
          e.target.nextElementSibling.style.display = 'block';
        }
      }
    });

    function runFaqSearch(term) {
      term = (term || '').toLowerCase();
      const categories = document.querySelectorAll('.faq-category');
      let firstMatch = null;
      categories.forEach(function(category) {
        const items = category.querySelectorAll('.faq-item');
        let hasVisible = false;
        items.forEach(function(item) {
          const question = item.querySelector('.faq-question').textContent.toLowerCase();
          const answer = item.querySelector('.faq-answer').textContent.toLowerCase();
          const match = !term || question.includes(term) || answer.includes(term);
          item.style.display = match ? 'block' : 'none';
          if (match && !firstMatch && term) firstMatch = item;
          if (match) hasVisible = true;
        });
        category.style.display = hasVisible ? 'block' : 'none';
      });
      if (firstMatch) {
        const q = firstMatch.querySelector('.faq-question');
        if (q && !q.classList.contains('open')) {
          q.classList.add('open');
          q.nextElementSibling.style.display = 'block';
        }
        firstMatch.scrollIntoView({ behavior: 'smooth', block: 'center' });
      }
    }

    const searchBar = document.getElementById('search-bar');
    searchBar.addEventListener('input', function () { runFaqSearch(this.value); });

    // Pre-fill from ?q= when arriving from chatbot or Help Center search
    (function () {
      const params = new URLSearchParams(window.location.search);
      const q = params.get('q');
      if (q) {
        searchBar.value = q;
        // Scroll so the sticky search bar is visible first, then run the search
        searchBar.scrollIntoView({ behavior: 'instant', block: 'start' });
        setTimeout(function() { runFaqSearch(q); }, 150);
      }
    })();
  </script>

  <script type="application/ld+json">
    <%- JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": availableFaqEntries.map((entry) => ({
        "@type": "Question",
        "name": entry.question,
        "acceptedAnswer": {
          "@type": "Answer",
          "text": entry.answer
        }
      }))
    }) %>
  </script>
</body>
</html>