<style>
  :root {
    --font-family: "<%= (session && session.fontStyle ? String(session.fontStyle).trim() : 'Inter') %>", sans-serif;
    --primary: #01535b;
    --primary-light: #e8f4f5;
    --border: #e5e7eb;
    --text: #1f2937;
    --text-muted: #6b7280;
    --bg: #f9fafb;
  }

  body {
    font-family: var(--font-family);
    color: var(--text);
    margin: 0;
    background-color: var(--bg);
    line-height: 1.6;
    box-sizing: border-box;
  }

  *, *::before, *::after { box-sizing: border-box; }

  main {
    max-width: 780px;
    margin: 0 auto;
  }

  .page-header {
    text-align: center;
    margin-bottom: 32px;
  }

  .page-header h1 {
    color: var(--primary);
    font-size: 2.2rem;
    font-weight: 700;
    margin: 0 0 8px;
  }

  .page-header p {
    color: var(--text-muted);
    font-size: 0.95rem;
    margin: 0;
  }

  #search-bar {
    width: 100%;
    padding: 12px 16px;
    margin-bottom: 28px;
    border: 1px solid var(--border);
    border-radius: 10px;
    font-size: 1rem; /* 16px — prevents iOS Safari auto-zoom on tap */
    font-family: var(--font-family);
    background: #fff;
    transition: border-color 0.2s, box-shadow 0.2s;
    box-sizing: border-box;
    position: sticky;
    top: 70px;
    z-index: 10;
    box-shadow: 0 2px 8px rgba(0,0,0,0.06);
  }

  #search-bar:focus {
    outline: none;
    border-color: var(--primary);
    box-shadow: 0 0 0 3px rgba(1, 83, 91, 0.08);
  }

  .faq-category {
    margin-bottom: 32px;
  }

  .faq-category h2 {
    font-size: 1.15rem;
    font-weight: 600;
    color: var(--primary);
    margin: 0 0 14px;
    padding-bottom: 10px;
    border-bottom: 2px solid var(--primary-light);
  }

  .faq-item {
    margin-bottom: 8px;
  }

  .faq-question {
    font-size: 0.98rem;
    font-weight: 500;
    color: var(--text);
    cursor: pointer;
    padding: 14px 44px 14px 18px;
    background: #fff;
    border: 1px solid var(--border);
    border-radius: 10px;
    position: relative;
    transition: border-color 0.2s, background 0.2s;
    line-height: 1.5;
  }

  .faq-question:hover {
    border-color: var(--primary);
    background: var(--primary-light);
  }

  .faq-question::after {
    content: '+';
    position: absolute;
    right: 16px;
    top: 50%;
    transform: translateY(-50%);
    font-size: 1.3rem;
    color: var(--primary);
    font-weight: 300;
    transition: transform 0.25s;
    line-height: 1;
  }

  .faq-question.open {
    border-color: var(--primary);
    background: var(--primary-light);
    border-radius: 10px 10px 0 0;
    border-bottom: none;
  }

  .faq-question.open::after {
    transform: translateY(-50%) rotate(45deg);
  }

  .faq-answer {
    display: none;
    font-size: 0.93rem;
    line-height: 1.7;
    color: var(--text-muted);
    padding: 16px 18px;
    background: #fff;
    border: 1px solid var(--primary);
    border-top: none;
    border-radius: 0 0 10px 10px;
    margin-top: 0;
  }

  .help-cta {
    background: #fff;
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 24px;
    text-align: center;
    margin-top: 20px;
  }

  .help-cta p {
    margin: 0 0 12px;
    font-size: 0.95rem;
    color: var(--text);
  }

  .help-cta a {
    display: inline-block;
    padding: 10px 24px;
    background: var(--primary);
    color: #fff;
    border-radius: 8px;
    text-decoration: none;
    font-weight: 600;
    font-size: 0.92rem;
    transition: background 0.2s;
  }

  .help-cta a:hover { background: #014048; }

  @media (max-width: 768px) {
    main { padding: 100px 20px 40px; }
    .page-header h1 { font-size: 1.8rem; padding-top: 20px; }
    #faq-container { margin: 0 12px; }
  }

  @media (max-width: 480px) {
    main { padding: 110px 16px 40px; }
    .page-header h1 { font-size: 1.5rem; padding-top: 30px; }
    #faq-container { margin: 0 8px; }
    .faq-question { font-size: 0.92rem; padding: 12px 40px 12px 14px; }
    .faq-answer { font-size: 0.88rem; padding: 14px; }
  }
</style>
</head>
<body>
  <main>
    <div class="page-header">
      <h1>Frequently Asked Questions</h1>
      <p>Find answers to common questions about Managira</p>
    </div>

    <input type="text" id="search-bar" placeholder="Search for a question...">

    <div id="faq-container">

      <div class="faq-category" data-category="getting-started">
        <h2>Getting Started</h2>
        <div class="faq-item"><div class="faq-question">What is Managira?</div><div class="faq-answer">Managira is an all-in-one school management platform designed to help educational institutions — from individual schools to government bodies overseeing multiple institutions — manage student records, track academic performance, handle attendance, generate reports, and keep parents and guardians informed. It replaces paperwork with a secure, digital solution that works on any device.</div></div>
        <div class="faq-item"><div class="faq-question">Who can use Managira?</div><div class="faq-answer">Managira serves schools, colleges, training centres, government education departments, administrators, teachers, parents, and guardians. Whether you're running a single school or managing a network of institutions, Managira scales to fit your needs.</div></div>
        <div class="faq-item"><div class="faq-question">How do I register my school on Managira?</div><div class="faq-answer">Visit our registration page and fill out your school details. Once registered, you can set up your school profile, add your logo and branding, create classes, and invite teachers and staff — all in about 15 minutes. You'll receive a guided onboarding experience to help you get started quickly.</div></div>
        <div class="faq-item"><div class="faq-question">Is there a free trial available?</div><div class="faq-answer">Yes! Every new school gets a free trial that lasts for a full academic term. During the trial, you'll have access to all core features including student management, attendance tracking, grade recording, and report generation — so you can experience the full platform before choosing a plan.</div></div>
        <div class="faq-item"><div class="faq-question">How long does it take to set up Managira?</div><div class="faq-answer">Most schools are up and running within 15 minutes. You simply register, add your school details and branding, create your classes, and start adding students. Bulk import options are available if you're migrating from another system.</div></div>
        <div class="faq-item"><div class="faq-question">How can I contact Managira support?</div><div class="faq-answer">You can reach our support team through the "Get Help" page on the platform, or email us directly at info@managira.com. We also have a YouTube channel with step-by-step video tutorials for common tasks.</div></div>
        <div class="faq-item"><div class="faq-question">What if I have a feature request?</div><div class="faq-answer">We welcome your feedback! You can submit feature requests directly to managirainfo@gmail.com. We also send out periodic surveys to gather suggestions from our community. Many of our most popular features have come from user feedback.</div></div>
      </div>

      <div class="faq-category" data-category="educators">
        <h2>Educators & Admins</h2>
        <div class="faq-item"><div class="faq-question">How does Managira help educators?</div><div class="faq-answer">Managira gives educators a complete digital toolkit: record grades and assessments, track daily attendance, create and print report cards and merit sheets, manage class rosters, and communicate with parents — all from a single dashboard. Real-time analytics show student progress trends so teachers can identify who needs extra support.</div></div>
        <div class="faq-item"><div class="faq-question">Can teachers and administrators update student information?</div><div class="faq-answer">Yes. Authorised users can update student profiles including personal details, grades, attendance records, and behavioural notes. The platform uses role-based access control, so administrators can decide exactly which staff members have permission to view or edit specific types of data.</div></div>
        <div class="faq-item"><div class="faq-question">Can I track teacher performance or workload?</div><div class="faq-answer">Administrators can view detailed metrics for each teacher, including how many classes they manage, tests and assessments they've created, grades they've entered, and attendance they've recorded. This helps school leaders distribute workload fairly and recognise top-performing staff.</div></div>
        <div class="faq-item"><div class="faq-question">Can I generate report cards or merit sheets?</div><div class="faq-answer">Absolutely. Managira includes a powerful report generator that creates professional terminal reports and merit sheets automatically from your recorded grades and assessments. You can customise the layout, add school branding, and print or download reports in bulk.</div></div>
        <div class="faq-item"><div class="faq-question">Can I customise the portal with my school's logo and colours?</div><div class="faq-answer">Yes. Under the Personalisation settings, you can upload your school logo, set your brand colours and fonts, and customise your public-facing school website. This ensures Managira looks and feels like your own platform.</div></div>
        <div class="faq-item"><div class="faq-question">How does the enrollment system work?</div><div class="faq-answer">Schools can create public enrollment forms that parents and guardians fill out online to apply for admission. Applications are reviewed and approved by school administrators. You can also manually add students or bulk-import from spreadsheets.</div></div>
        <div class="faq-item"><div class="faq-question">Is training provided for new users?</div><div class="faq-answer">Yes. We provide onboarding documentation, in-app guides, and video tutorials on our YouTube channel. For larger institutions, we can arrange personalised training sessions to help your team get comfortable with the platform.</div></div>
        <div class="faq-item"><div class="faq-question">How are announcements delivered?</div><div class="faq-answer">Announcements are published to dashboards across the platform, ensuring that administrators, teachers, and staff see important updates as soon as they log in. Schools can also display announcements on their public-facing website for parents and the wider community.</div></div>
        <div class="faq-item"><div class="faq-question">Is there an analytics dashboard?</div><div class="faq-answer">Yes. Managira's analytics dashboard provides visual insights into student performance trends, attendance statistics, class comparisons, and operational metrics. Leaders can use this data to make informed decisions about curriculum, staffing, and resource allocation.</div></div>
        <div class="faq-item"><div class="faq-question">Can I manage school years and terms?</div><div class="faq-answer">Yes. Managira supports full academic year management — you can register school years, define terms, close terms to lock in grades, and promote students to the next year. The system maintains a complete historical record of every academic period.</div></div>
      </div>

      <div class="faq-category" data-category="hubs">
        <h2>Hub Management & Government Institutions</h2>
        <div class="faq-item"><div class="faq-question">What is a Managira Hub?</div><div class="faq-answer">A Managira Hub is a centralised management layer designed for government education departments, school districts, and educational bodies that oversee multiple schools. Hubs provide a single dashboard to monitor performance, manage staff, coordinate operations, and maintain oversight across all member institutions.</div></div>
        <div class="faq-item"><div class="faq-question">Who typically uses Hubs?</div><div class="faq-answer">Hubs are used by government education ministries, regional education offices, school district administrators, and private education groups that manage networks of schools. Any organisation responsible for overseeing multiple educational institutions can benefit from the Hub system.</div></div>
        <div class="faq-item"><div class="faq-question">How do I set up a Hub?</div><div class="faq-answer">Hubs are created by Managira administrators. Once your Hub is set up, you receive a dedicated login and dashboard. From there, you can invite schools to join your network, set organisation limits, and begin monitoring your member institutions.</div></div>
        <div class="faq-item"><div class="faq-question">Can a Hub control billing for member schools?</div><div class="faq-answer">Yes. When a school joins a Hub, billing is managed centrally by the Hub operator. Member schools no longer see individual billing options — all subscription management is handled at the Hub level, simplifying financial administration.</div></div>
        <div class="faq-item"><div class="faq-question">Can I invite existing schools to join my Hub?</div><div class="faq-answer">Yes. Hub operators can send invitations to existing Managira schools as well as new institutions. Schools receive an email invitation and can accept to join the Hub network while retaining all their existing data and settings.</div></div>
        <div class="faq-item"><div class="faq-question">What data can Hub operators see?</div><div class="faq-answer">Hub operators can view aggregated statistics across all member schools — including total students, staff counts, class numbers, and performance trends. They can also see individual school details, but day-to-day data entry remains the responsibility of each school's own administrators and teachers.</div></div>
      </div>

      <div class="faq-category" data-category="billing">
        <h2>Billing & Subscription</h2>
        <div class="faq-item"><div class="faq-question">Can I upgrade or downgrade my plan?</div><div class="faq-answer">Yes. You can change your plan at any time from the Settings or Billing section of your account. Upgrades take effect immediately, and downgrades apply at the end of your current billing cycle.</div></div>
        <div class="faq-item"><div class="faq-question">What happens if I miss a payment?</div><div class="faq-answer">If a payment is missed, you'll receive notifications with steps to resolve it. After a grace period, access to premium features will be temporarily restricted. Your data remains safe and intact — once payment is made, full access is restored immediately.</div></div>
        <div class="faq-item"><div class="faq-question">What payment methods do you accept?</div><div class="faq-answer">Managira supports secure payments through Stripe and other configured payment methods depending on the workflow. For school payments, a school can enable options such as online card or wallet checkout through Stripe and bank transfer, while some Managira billing flows may also use region-specific gateways such as Paystack. The payment methods a user sees depend on the school's configuration and the bill being paid.</div></div>
        <div class="faq-item"><div class="faq-question">Is there a discount for annual billing?</div><div class="faq-answer">Please visit our pricing page or contact our sales team at managirainfo@gmail.com for information about annual billing options and available discounts for larger institutions.</div></div>
      </div>

      <div class="faq-category" data-category="paygira-school-payments">
        <h2>PayGira & School Payments</h2>
        <div class="faq-item"><div class="faq-question">What is PayGira?</div><div class="faq-answer">PayGira is Managira's school billing and collection workspace. Schools use it to create bills, assign collectors, receive parent payments, track balances, and keep a full history of collections, invoices, receipts, and sign-offs.</div></div>
        <div class="faq-item"><div class="faq-question">What can schools use PayGira for?</div><div class="faq-answer">Schools can use PayGira for one-time and recurring school bills such as tuition, levies, transport, feeding, examination fees, club charges, and other approved charges. Managira's payment setup can also support online public registration and admission payments when the school has completed its payout and online payment configuration.</div></div>
        <div class="faq-item"><div class="faq-question">Who can use PayGira?</div><div class="faq-answer">Finance administrators and other authorised school officials set up payment settings, payout destinations, bill templates, and bills. Teachers, class teachers, supervisors, and managers who are assigned as collectors or overseers can use My PayGira to collect or monitor payments for their bills. Parents and guardians use the Guardian Portal to view and pay bills linked to their children.</div></div>
        <div class="faq-item"><div class="faq-question">How does a school set up PayGira?</div><div class="faq-answer">A school first configures its payment settings and payout destination, then creates bills, chooses who each bill applies to, enables accepted payment methods, and optionally assigns staff collectors or overseers. Once the setup is complete, parents can see eligible bills in the Guardian Portal and assigned staff can work from their own My PayGira collection view.</div></div>
        <div class="faq-item"><div class="faq-question">How do parents and guardians pay through PayGira?</div><div class="faq-answer">In the Guardian Portal, parents can open PayGira, review each child's billed, paid, outstanding, and available credit amounts, and then pay the selected bill or recurring dates. If the school has enabled Stripe and the bill accepts online payments, parents can pay online by card or supported wallets. If the school has enabled bank transfer, that option can also appear. Payment history, invoices, and receipts remain available in the portal.</div></div>
        <div class="faq-item"><div class="faq-question">How do teachers, supervisors, and managers use My PayGira?</div><div class="faq-answer">Assigned teachers, class teachers, supervisors, managers, and finance administrators can use My PayGira to record collections for the bills under their responsibility. They can record one payment at a time or use bulk collection for multiple students. When staff record a collection, the student's balance is updated immediately and the school can keep follow-up records in finance history.</div></div>
        <div class="faq-item"><div class="faq-question">How does PayGira sign-off work?</div><div class="faq-answer">A bill or recurring date can only be signed off after it is fully settled for the relevant scope. During sign-off, the staff member enters the name to record on the sign-off and confirms with a password. The sign-off is then saved in finance history with the signer, student count, and total collected, and the fully settled collection is removed from the active collection drawer.</div></div>
        <div class="faq-item"><div class="faq-question">Can PayGira handle recurring bills, part-payments, and student credit?</div><div class="faq-answer">Yes. PayGira supports one-time bills and recurring bills. Recurring collections can be managed date by date, and each selected due date is tracked separately. The system also supports partial payments, outstanding balances, late fees where applicable, and student credit balances that can be applied to reduce what still needs to be paid.</div></div>
        <div class="faq-item"><div class="faq-question">What records does PayGira keep after payment?</div><div class="faq-answer">PayGira keeps invoices, receipts, payment history, balance changes, and sign-off history. Guardians can review recent payment activity in the Guardian Portal, while school finance teams can review payment records and collection sign-off history inside the finance workspace.</div></div>
        <div class="faq-item"><div class="faq-question">How secure is PayGira and its online payment process?</div><div class="faq-answer">PayGira uses authenticated school and guardian sessions, organization-scoped data access, role-based permissions, and audited finance records. Where a school enables Stripe, online card and wallet payments are handled through Stripe's secure payment flows, and payment confirmations are finalized through verified payment-intent and webhook processing. Sensitive actions such as collection sign-off require password verification, and payment views show masked card details instead of full card numbers.</div></div>
      </div>

      <div class="faq-category" data-category="parents">
        <h2>Parents & Guardians</h2>
        <div class="faq-item"><div class="faq-question">How do parents access their child's information?</div><div class="faq-answer">Parents and guardians can access their child's school information through the dedicated Guardian Portal. Schools provide login credentials, and once logged in, parents can view grades, attendance records, report cards, and school announcements — all in real time.</div></div>
        <div class="faq-item"><div class="faq-question">How do parents or guardians register their children?</div><div class="faq-answer">Schools can enable a public enrollment form on their Managira-powered website. Parents fill out the application online, and school administrators review and approve each submission. Schools can also register students directly on behalf of parents.</div></div>
        <div class="faq-item"><div class="faq-question">Can parents submit reports or concerns?</div><div class="faq-answer">Yes. The Guardian Portal includes a reporting feature where parents can submit concerns, questions, or feedback directly to the school. Schools can review and respond to these reports through their admin dashboard.</div></div>
        <div class="faq-item"><div class="faq-question">How can parents stay updated on school activities?</div><div class="faq-answer">Managira keeps parents informed through the public school website, dashboard announcements, and the Guardian Portal. Parents can see real-time updates on events, grades, and achievements without needing to visit the school in person.</div></div>
      </div>

      <div class="faq-category" data-category="security">
        <h2>Security & Access</h2>
        <div class="faq-item"><div class="faq-question">What security measures protect student data?</div><div class="faq-answer">Managira uses enterprise-grade security including TLS/SSL encryption for all data in transit, encryption at rest for stored data, role-based access controls, and secure hosting on Amazon Web Services (AWS). We follow OWASP security best practices and conduct regular vulnerability assessments using tools like Snyk.</div></div>
        <div class="faq-item"><div class="faq-question">Is Managira compliant with data protection regulations?</div><div class="faq-answer">Yes. Managira adheres to international data protection standards including GDPR (EU), FERPA (US), and applicable national data protection laws. We take compliance seriously to ensure your institution meets its regulatory obligations.</div></div>
        <div class="faq-item"><div class="faq-question">Can I control who sees what information?</div><div class="faq-answer">Absolutely. Administrators have full control over roles and permissions. You can define exactly which staff members can access, edit, or manage specific types of data — from student records to financial information. This ensures privacy and security at every level.</div></div>
        <div class="faq-item"><div class="faq-question">How long is student data retained?</div><div class="faq-answer">Student records are retained for as long as your school's account remains active on Managira. If a school discontinues use, data can be exported and then archived or permanently deleted in accordance with your institution's policies and applicable legal requirements.</div></div>
        <div class="faq-item"><div class="faq-question">What should I do if I forget my password?</div><div class="faq-answer">Click the "Forgot Password" link on the login page. You'll receive an email with a secure link to reset your password. The reset link expires after a set period for security purposes. If you don't receive the email, check your spam folder or contact your school administrator.</div></div>
      </div>

      <div class="faq-category" data-category="roles-permissions">
        <h2>Roles & Permissions</h2>
        <div class="faq-item"><div class="faq-question">How do staff roles and permissions work for organizations?</div><div class="faq-answer">Organizations use role-based access with secure server-side checks. Managers have full organization-level access. Teachers and Supervisors can be given specific permissions based on their job. Access is enforced on protected routes in addition to UI visibility, so users cannot rely on direct URL access to bypass restrictions.</div></div>
        <div class="faq-item"><div class="faq-question">What are the default permissions for Teacher and Supervisor roles?</div><div class="faq-answer">By default, Teacher includes: Manage Assessments and Mark Attendance. Supervisor includes: Manage Students, Manage Guardians, Manage Assessments, Mark Attendance, Manage Reports, Approve Admissions, Publish Events & Announcements, Manage Classes & Subjects, Generate Transcripts, and Manage Promotions. These defaults are applied automatically when staff are created or updated.</div></div>
        <div class="faq-item"><div class="faq-question">Can we assign extra permissions to specific teachers or supervisors?</div><div class="faq-answer">Yes. During Create Employee and Modify Employee, organizations can add optional extra permissions for individual staff members. This allows selective delegation (for example, granting additional responsibilities to a specific teacher) without changing the staff member's base role.</div></div>
        <div class="faq-item"><div class="faq-question">Where are assigned permissions saved?</div><div class="faq-answer">Assigned permissions are stored in the database in a dedicated user_permissions table scoped by organization. This means permissions persist across sessions and are enforced consistently by the backend.</div></div>
        <div class="faq-item"><div class="faq-question">Can non-manager staff grant high-risk permissions?</div><div class="faq-answer">No. High-risk permissions such as employee management and organization settings are restricted. Non-manager users cannot assign Manager role and cannot grant high-risk permissions, even if they attempt to submit them manually.</div></div>
        <div class="faq-item"><div class="faq-question">How can organizations review who has which permissions?</div><div class="faq-answer">Use the Manage Employees page to review staff records. The page shows each employee's assigned permissions so administrators can quickly audit access and update permissions when responsibilities change.</div></div>
        <div class="faq-item"><div class="faq-question">Which organization actions are protected by explicit permission checks?</div><div class="faq-answer">Permission checks now protect key organization actions, including employee management, admissions approval workflows, event/announcement publishing, school-year and term management, class/subject setup, transcript generation routes, promotion workflows, and billing/settings operations. Sensitive attendance and student archive actions are also protected by authentication and explicit permissions.</div></div>
        <div class="faq-item"><div class="faq-question">Which granular permissions are available now?</div><div class="faq-answer">Available granular permissions include admissions approval, events/announcements publishing, school-year and term management, class/subject setup, transcript generation, promotion approval, and billing/settings delegation. Organizations can combine these with role defaults and optional extras per staff member.</div></div>
      </div>

      <div class="faq-category" data-category="technical">
        <h2>Technical & Platform</h2>
        <div class="faq-item"><div class="faq-question">What devices does Managira support?</div><div class="faq-answer">Managira is fully responsive and works on desktops, laptops, tablets, and mobile phones. There's no app to download — you simply access it through your web browser. It's been optimised for Chrome, Safari, Firefox, and Edge.</div></div>
        <div class="faq-item"><div class="faq-question">Can I export my data from Managira?</div><div class="faq-answer">Yes. Managira supports data export in multiple formats. You can download student records, attendance data, grade reports, and other information as CSV or PDF files. This ensures you always have full ownership and portability of your data.</div></div>
        <div class="faq-item"><div class="faq-question">Does Managira have a public-facing school website?</div><div class="faq-answer">Yes. Every school on Managira gets a customisable public dashboard that serves as a school website. You can publish announcements, display school information, showcase events, and enable online enrollment — all branded with your school's logo and colours.</div></div>
        <div class="faq-item"><div class="faq-question">What should I do if I encounter a technical issue?</div><div class="faq-answer">Visit our Get Help page to submit a support request, or email info@managira.com directly. Please include details about the issue, your browser, and any error messages you see. Our support team typically responds within 24 hours.</div></div>
        <div class="faq-item"><div class="faq-question">Can I use Managira for academic transcript generation?</div><div class="faq-answer">Yes. Managira includes a transcript generation feature that compiles a student's complete academic history across all enrolled terms and years. Transcripts can be printed or downloaded as professional PDF documents.</div></div>
        <div class="faq-item"><div class="faq-question">Does Managira support collaborative files and spreadsheets with formulas?</div><div class="faq-answer">Yes. Managira includes Files for rich-text documents and spreadsheets. You can assign files to classes and teachers, auto-save edits, select ranges of cells, use basic formulas like SUM, AVERAGE, COUNT, MIN, and MAX, and expand sheets by adding more rows and columns whenever needed.</div></div>
      </div>

      <div class="faq-category" data-category="email-notifications">
        <h2>Email Notifications</h2>
        <div class="faq-item"><div class="faq-question">What kinds of emails does Managira send?</div><div class="faq-answer">Managira sends emails across several categories: account &amp; security (password reset, invitations, password-set confirmations); billing (payment receipts, invoices, subscription cancellation, renewal-failed notices, scheduled-hold notices, student-tier-exceeded notices); onboarding (organization registration confirmation with Starter Pack, employee invites, guardian portal welcome); hub membership (invitations, joined notices, detachment requests, approvals, rejections, removals); admissions &amp; enrollment (application received, approved, rejected, public registration payment confirmation); academic (assessment access updates, files assigned to a class, report cards with PDF, official transcripts, class change, teacher reassignment); communications (staff-to-guardian reports and replies, broadcasts of events and announcements); weekly Saturday digests for parents, teachers, managers, and hubs; and operations (support tickets, demo requests, employment application updates).</div></div>
        <div class="faq-item"><div class="faq-question">Which weekly digests does Managira send?</div><div class="faq-answer">Managira sends four weekly digests every Saturday: Weekly Parent Digest to guardians (children's progress for the week), Weekly Teacher Digest to teachers (assigned classes and subjects), Weekly Leadership Report to managers and supervisors (at-risk students and school metrics), and Weekly Hub Overview to hub administrators (cross-organization summary). There is no monthly digest.</div></div>
        <div class="faq-item"><div class="faq-question">Which emails do guardians (parents) receive?</div><div class="faq-answer">Guardians receive: welcome and password setup, additional-student-added notice, admission application received, public registration payment confirmation, admission approved or rejected, attendance alerts when a child is absent multiple times in a week, the weekly Saturday parent digest, class-change notices, staff reports about their child and replies, report cards (with PDF), official transcripts when shared, and broadcasts of public-visible events and announcements.</div></div>
        <div class="faq-item"><div class="faq-question">Which emails do teachers, managers, and supervisors receive?</div><div class="faq-answer">Teachers receive: weekly teaching digest, assignment-changed notices, assessment lock/unlock and access updates, files assigned to their class, broadcasts of events and announcements, and copies of guardian reports for students they class-teach. Managers and supervisors receive: weekly leadership report, broadcasts, and copies of guardian reports and replies as fallback recipients. All staff also receive role-agnostic emails — invitation to set password, password-set confirmation, password reset, and on-hold or reactivation notices.</div></div>
        <div class="faq-item"><div class="faq-question">Which Managira emails cannot be turned off?</div><div class="faq-answer">Transactional and legal-of-record emails are always sent and cannot be silenced. These include: password reset and password-set confirmations; all invitation emails (employee, guardian, hub); organization registration confirmation; billing emails (payment receipt, invoice, subscription cancellation, renewal-failed, scheduled hold); all support ticket emails; demo request received; employment application confirmations and decisions; transcript share; public registration payment confirmation; admission approval and rejection; and all hub-membership decision emails (invite, welcome, joined, detachment approved/rejected, removed). User-toggleable emails are limited to digests, broadcasts, and routine staff/guardian notifications.</div></div>
        <div class="faq-item"><div class="faq-question">How do I choose which emails I receive?</div><div class="faq-answer">Each user controls their optional emails from their own settings page. Organization users (Manager, Supervisor, Teacher, Cashier) open Account Settings and select the Notifications tab to toggle items like the weekly digest, broadcasts, guardian-report alerts, and assignment-change notices. Parents/guardians open the Parent Portal Settings page and use the Email Notifications section to toggle the weekly parent digest, attendance alerts, class-change notices, broadcasts, report-card delivery, and staff replies. Hub administrators manage their preferences from hub admin settings. Choices save instantly, are per-user, and only affect optional emails — security, billing, and other transactional emails are always sent.</div></div>
      </div>

    </div>

    <div class="help-cta" style="margin-bottom: 16px;">
      <p>📖 Need a detailed guide on how Managira works?</p>
      <a href="/legal/user-documentation">View User Documentation</a>
    </div>

    <div class="help-cta">
      <p>Didn't find what you're looking for?</p>
      <a href="/legal/help">Contact Support</a>
    </div>
  </main>

  <script>
    document.addEventListener('click', function (e) {
      if (e.target.classList.contains('faq-question')) {
        const wasOpen = e.target.classList.contains('open');
        document.querySelectorAll('.faq-question.open').forEach(function(q) {
          q.classList.remove('open');
          q.nextElementSibling.style.display = 'none';
        });
        if (!wasOpen) {
          e.target.classList.add('open');
          e.target.nextElementSibling.style.display = 'block';
        }
      }
    });

    function runFaqSearch(term) {
      term = (term || '').toLowerCase();
      const categories = document.querySelectorAll('.faq-category');
      let firstMatch = null;
      categories.forEach(function(category) {
        const items = category.querySelectorAll('.faq-item');
        let hasVisible = false;
        items.forEach(function(item) {
          const question = item.querySelector('.faq-question').textContent.toLowerCase();
          const answer = item.querySelector('.faq-answer').textContent.toLowerCase();
          const match = !term || question.includes(term) || answer.includes(term);
          item.style.display = match ? 'block' : 'none';
          if (match && !firstMatch && term) firstMatch = item;
          if (match) hasVisible = true;
        });
        category.style.display = hasVisible ? 'block' : 'none';
      });
      if (firstMatch) {
        const q = firstMatch.querySelector('.faq-question');
        if (q && !q.classList.contains('open')) {
          q.classList.add('open');
          q.nextElementSibling.style.display = 'block';
        }
        firstMatch.scrollIntoView({ behavior: 'smooth', block: 'center' });
      }
    }

    const searchBar = document.getElementById('search-bar');
    searchBar.addEventListener('input', function () { runFaqSearch(this.value); });

    // Pre-fill from ?q= when arriving from chatbot or Help Center search
    (function () {
      const params = new URLSearchParams(window.location.search);
      const q = params.get('q');
      if (q) {
        searchBar.value = q;
        // Scroll so the sticky search bar is visible first, then run the search
        searchBar.scrollIntoView({ behavior: 'instant', block: 'start' });
        setTimeout(function() { runFaqSearch(q); }, 150);
      }
    })();
  </script>
</body>
</html>