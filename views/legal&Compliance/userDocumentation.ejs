  .doc-list {
    text-align: left;
    margin: 0 auto 28px;
    max-width: 520px;
    list-style: none;
    padding: 0;
    counter-reset: doc-counter;
  }

  .doc-list li {
    counter-increment: doc-counter;
    margin-bottom: 12px;
  }

  .doc-list li a {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 14px 18px;
    background: #f8fafa;
    border: 1px solid #e5e7eb;
    border-radius: 8px;
    color: #01535b;
    font-size: 0.97rem;
    font-weight: 600;
    text-decoration: none;
    transition: background-color 0.2s, border-color 0.2s;
  }

  .doc-list li a:hover {
    background: #eef6f6;
    border-color: #01535b;
  }

  .doc-list li a::before {
    content: counter(doc-counter);
    display: flex;
    align-items: center;
    justify-content: center;
    min-width: 28px;
    height: 28px;
    background: #01535b;
    color: #fff;
    border-radius: 50%;
    font-size: 0.82rem;
    font-weight: 700;
    flex-shrink: 0;
  }

  .doc-list li a .pdf-icon {
    flex-shrink: 0;
    color: #dc2626;
  }
</style>

