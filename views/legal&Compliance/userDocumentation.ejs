<!-- ── Admin articles section (admins only) ──────── -->
<% if (docAdmin) { %>

<div class="udoc-admin">
  <div class="udoc-admin-inner">

    <div class="udoc-admin-bar">
      <div class="udoc-admin-bar__left">
        <h2>Documentation Articles</h2>
        <p>Manage published guides and reference articles.</p>
      </div>
      <div class="udoc-admin-bar__right">
        <div class="udoc-pill"><strong><%= published %></strong>&nbsp;published</div>
        <% if (drafts > 0) { %>
        <div class="udoc-pill amber"><strong><%= drafts %></strong>&nbsp;draft<%= drafts !== 1 ? 's' : '' %></div>
        <% } %>
        <button type="button" class="udoc-new-btn" id="openCreatePanel">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
          New Article
        </button>
      </div>
    </div>

    <!-- Articles grouped by topic -->
    <% if (docTree.length === 0) { %>
      <div class="udoc-grid">
        <div class="udoc-empty">
          <strong>No articles yet.</strong>
          Click "New Article" above to publish your first documentation article.
        </div>
      </div>
    <% } else { %>
      <% docTree.forEach(function(topicEntry) { %>
        <%
          const topicArticles = [];
          (topicEntry.articles || []).forEach(function(a){ topicArticles.push(a); });
          (topicEntry.subtopics || []).forEach(function(sub){
            (sub.articles || []).forEach(function(a){ topicArticles.push(a); });
          });
        %>
        <% if (topicArticles.length > 0) { %>
        <div class="udoc-topic-head"><%= topicEntry.topic %></div>
        <div class="udoc-grid">
          <% topicArticles.forEach(function(article) { %>
          <a class="udoc-card" href="/legal/user-documentation/<%= article.slug %>">
            <div class="udoc-card__top">
              <div class="udoc-card__ico">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
              </div>
              <div class="udoc-card__acts" onclick="event.preventDefault();event.stopPropagation();">
                <button
                  type="button"
                  class="udoc-ico-btn"
                  title="<%= article.status === 'draft' ? 'Publish' : 'Unpublish' %>"
                  data-action="toggle-status"
                  data-id="<%= article.id %>"
                  data-status="<%= article.status %>"
                >
                  <% if (article.status === 'draft') { %>
                  <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#16a34a" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 11 12 14 22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/></svg>
                  <% } else { %>
                  <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#64748b" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="4.93" y1="4.93" x2="19.07" y2="19.07"/></svg>
                  <% } %>
                </button>
                <button
                  type="button"
                  class="udoc-ico-btn del"
                  title="Delete"
                  data-action="delete-article"
                  data-id="<%= article.id %>"
                  data-title="<%= article.title.replace(/"/g, '&quot;') %>"
                >
                  <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#dc2626" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/><path d="M10 11v6"/><path d="M14 11v6"/><path d="M9 6V4h6v2"/></svg>
                </button>
              </div>
            </div>

            <div class="udoc-card__title"><%= article.title %></div>

            <% if (article.excerpt) { %>
            <p class="udoc-card__exc"><%= article.excerpt %></p>
            <% } %>

            <div class="udoc-card__foot">
              <span class="udoc-card__date"><%= fmtDate(article.updatedAt) %></span>
              <% if (article.status === 'draft') { %>
              <span class="udoc-draft-badge">Draft</span>
              <% } %>
            </div>
          </a>
          <% }); %>
        </div>
        <% } %>
      <% }); %>
    <% } %>

  </div>
</div><!-- /udoc-admin -->

<!-- ── Create panel ──────────────────────────────── -->
<div class="udoc-overlay" id="docOverlay" role="dialog" aria-modal="true" aria-label="Create article">
  <div class="udoc-panel" id="docPanel">
    <div class="udoc-panel__head">
      <h2>New Article</h2>
      <button type="button" class="udoc-panel__close" id="closePanelBtn" aria-label="Close">×</button>
    </div>
    <div class="udoc-panel__body">

      <div class="udoc-form-row two-col">
        <div class="udoc-field">
          <label for="fieldTitle">Title <span style="color:#dc2626">*</span></label>
          <input type="text" id="fieldTitle" placeholder="e.g. How to enrol a student" maxlength="200">
        </div>
        <div class="udoc-field">
          <label for="fieldTopic">Topic <span style="color:#dc2626">*</span></label>
          <input type="text" id="fieldTopic" placeholder="e.g. Getting Started" list="topicSuggestions" maxlength="120">
          <datalist id="topicSuggestions">
            <% (availableTopics || []).forEach(function(t) { %>
            <option value="<%= t %>">
            <% }); %>
          </datalist>
        </div>
      </div>

      <div class="udoc-form-row two-col">
        <div class="udoc-field">
          <label for="fieldSubtopic">Subtopic</label>
          <input type="text" id="fieldSubtopic" placeholder="Optional" maxlength="120">
        </div>
        <div class="udoc-field">
          <label for="fieldStatus">Status</label>
          <select id="fieldStatus">
            <option value="active">Published</option>
            <option value="draft">Draft (hidden)</option>
          </select>
        </div>
      </div>

      <div class="udoc-field">
        <label for="fieldTags">Tags <span class="udoc-field__hint">(comma separated)</span></label>
        <input type="text" id="fieldTags" placeholder="e.g. setup, enrolment, students">
      </div>

      <div class="udoc-field">
        <label for="fieldSeo">SEO Description <span class="udoc-field__hint">(optional)</span></label>
        <textarea id="fieldSeo" rows="2" maxlength="320" placeholder="Short summary for search engines…"></textarea>
      </div>

      <div class="udoc-field">
        <label>Content</label>
        <div class="udoc-editor-wrap">
          <div class="udoc-toolbar" id="editorToolbar">
            <button type="button" data-cmd="bold"      title="Bold"><b>B</b></button>
            <button type="button" data-cmd="italic"    title="Italic"><i>I</i></button>
            <button type="button" data-cmd="underline" title="Underline"><u>U</u></button>
            <div class="udoc-tsep"></div>
            <button type="button" data-cmd="formatBlock" data-val="h2" title="Heading 2">H2</button>
            <button type="button" data-cmd="formatBlock" data-val="h3" title="Heading 3">H3</button>
            <button type="button" data-cmd="formatBlock" data-val="p"  title="Paragraph">¶</button>
            <div class="udoc-tsep"></div>
            <button type="button" data-cmd="insertUnorderedList" title="Bullets">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="9" y1="6" x2="20" y2="6"/><line x1="9" y1="12" x2="20" y2="12"/><line x1="9" y1="18" x2="20" y2="18"/><circle cx="4" cy="6" r="1" fill="currentColor"/><circle cx="4" cy="12" r="1" fill="currentColor"/><circle cx="4" cy="18" r="1" fill="currentColor"/></svg>
            </button>
            <button type="button" data-cmd="insertOrderedList" title="Numbers">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="10" y1="6" x2="21" y2="6"/><line x1="10" y1="12" x2="21" y2="12"/><line x1="10" y1="18" x2="21" y2="18"/><path d="M4 6h1v4"/><path d="M4 10h2"/><path d="M6 18H4c0-1 2-2 2-3s-1-1.5-2-1"/></svg>
            </button>
            <button type="button" data-cmd="formatBlock" data-val="blockquote" title="Quote">❝</button>
            <div class="udoc-tsep"></div>
            <button type="button" id="btnInsertLink" title="Insert link">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>
            </button>
            <button type="button" data-cmd="removeFormat" title="Clear format">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 19l7-7 3 3-7 7-3-3z"/><path d="M18 13l-1.5-7.5L2 2l3.5 14.5L13 18l5-5z"/><path d="M2 2l7.586 7.586"/></svg>
            </button>
            <div class="udoc-tsep"></div>
            <button type="button" id="udocInsertImage" title="Insert image">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
            </button>
            <button type="button" id="udocInsertVideo" title="Embed YouTube / Vimeo video">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polygon points="23 7 16 12 23 17 23 7"/><rect x="1" y="5" width="15" height="14" rx="2" ry="2"/></svg>
            </button>
          </div>

          <!-- Image picker -->
          <div class="udoc-mpick" id="udocImgPick">
            <div class="udoc-mpick__head">
              <span>Insert Image</span>
              <button type="button" class="udoc-mpick__close" data-close="udocImgPick">&times;</button>
            </div>
            <div class="udoc-mpick__tabs">
              <button type="button" class="udoc-mpick__tab active" data-for="udocImgUploadP">Upload File</button>
              <button type="button" class="udoc-mpick__tab" data-for="udocImgUrlP">Image URL</button>
            </div>
            <div class="udoc-mpick__panel active" id="udocImgUploadP">
              <label class="udoc-mpick__drop" id="udocImgDrop">
                <input type="file" id="udocImgFileInp" accept="image/*" style="display:none">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
                <span id="udocImgDropLabel">Click to select an image</span>
              </label>
              <div class="udoc-mpick__row">
                <input type="text" class="udoc-mpick__inp" id="udocImgAlt" placeholder="Alt text (recommended)">
                <input type="text" class="udoc-mpick__inp" id="udocImgCaption" placeholder="Caption (optional)">
              </div>
              <div class="udoc-mpick__foot">
                <span class="udoc-mpick__err" id="udocImgUploadErr"></span>
                <button type="button" class="udoc-mpick__btn" id="udocImgUploadBtn">Upload &amp; Insert</button>
              </div>
            </div>
            <div class="udoc-mpick__panel" id="udocImgUrlP">
              <input type="url" class="udoc-mpick__inp" id="udocImgUrlInp" placeholder="https://&#x2026; image URL">
              <div class="udoc-mpick__row">
                <input type="text" class="udoc-mpick__inp" id="udocImgUrlAlt" placeholder="Alt text">
                <input type="text" class="udoc-mpick__inp" id="udocImgUrlCap" placeholder="Caption (optional)">
              </div>
              <div class="udoc-mpick__foot">
                <span></span>
                <button type="button" class="udoc-mpick__btn" id="udocImgUrlBtn">Insert Image</button>
              </div>
            </div>
          </div>

          <!-- Video embed picker -->
          <div class="udoc-mpick" id="udocVidPick">
            <div class="udoc-mpick__head">
              <span>Embed Video</span>
              <button type="button" class="udoc-mpick__close" data-close="udocVidPick">&times;</button>
            </div>
            <div class="udoc-mpick__panel active" style="display:flex">
              <input type="url" class="udoc-mpick__inp" id="udocVidUrl" placeholder="https://www.youtube.com/watch?v=&#x2026; or youtu.be/&#x2026;">
              <p class="udoc-mpick__hint">Supports YouTube and Vimeo. Embeds as a responsive player.</p>
              <div class="udoc-mpick__foot">
                <span class="udoc-mpick__err" id="udocVidErr"></span>
                <button type="button" class="udoc-mpick__btn" id="udocVidEmbedBtn">Embed Video</button>
              </div>
            </div>
          </div>

          <div class="udoc-editor" id="docEditorArea" contenteditable="true" data-placeholder="Write your article content here…"></div>
        </div>
      </div>
    </div>

    <div class="udoc-panel__foot">
      <span class="udoc-panel__err" id="panelError"></span>
      <button type="button" class="udoc-btn-cancel" id="cancelPanelBtn">Cancel</button>
      <button type="button" class="udoc-btn-save"   id="savePanelBtn">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
        Save Article
      </button>
    </div>
  </div>
</div>

<script>
(function () {
  const overlay   = document.getElementById('docOverlay');
  const fTitle    = document.getElementById('fieldTitle');
  const fTopic    = document.getElementById('fieldTopic');
  const fSubtopic = document.getElementById('fieldSubtopic');
  const fStatus   = document.getElementById('fieldStatus');
  const fTags     = document.getElementById('fieldTags');
  const fSeo      = document.getElementById('fieldSeo');
  const editor    = document.getElementById('docEditorArea');
  const saveBtn   = document.getElementById('savePanelBtn');
  const errEl     = document.getElementById('panelError');

  function openPanel() {
    fTitle.value = fTopic.value = fSubtopic.value = fTags.value = fSeo.value = '';
    fStatus.value = 'draft';
    editor.innerHTML = '';
    errEl.style.display = 'none';
    overlay.classList.add('is-open');
    setTimeout(function(){ fTitle.focus(); }, 50);
  }

  function closePanel() { overlay.classList.remove('is-open'); }

  document.getElementById('openCreatePanel').addEventListener('click', openPanel);
  document.getElementById('closePanelBtn').addEventListener('click', closePanel);
  document.getElementById('cancelPanelBtn').addEventListener('click', closePanel);
  overlay.addEventListener('click', function(e){ if (e.target === overlay) closePanel(); });
  document.addEventListener('keydown', function(e){ if (e.key === 'Escape') closePanel(); });

  document.getElementById('editorToolbar').addEventListener('mousedown', function(e) {
    const btn = e.target.closest('[data-cmd]');
    if (!btn) return;
    e.preventDefault();
    document.execCommand(btn.dataset.cmd, false, btn.dataset.val || null);
    editor.focus();
  });

  document.getElementById('btnInsertLink').addEventListener('mousedown', function(e) {
    e.preventDefault();
    const url = prompt('Enter URL:');
    if (url) document.execCommand('createLink', false, url);
    editor.focus();
  });

  // ── Create-panel media picker helpers ─────────────────────────────
  let _udocSavedRange = null;

  editor.addEventListener('blur', function() {
    const sel = window.getSelection();
    if (sel && sel.rangeCount > 0 && editor.contains(sel.anchorNode)) {
      _udocSavedRange = sel.getRangeAt(0).cloneRange();
    }
  });

  function udocMediaInsert(html) {
    editor.focus();
    if (_udocSavedRange) {
      const sel = window.getSelection();
      sel.removeAllRanges();
      sel.addRange(_udocSavedRange);
      _udocSavedRange = null;
    }
    document.execCommand('insertHTML', false, html);
  }

  function udocEsc(s) {
    return String(s).replace(/[&<>"']/g, function(c) {
      return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c];
    });
  }

  function udocTogglePicker(id) {
    ['udocImgPick', 'udocVidPick'].forEach(function(pid) {
      const el = document.getElementById(pid);
      if (pid === id) { el.classList.toggle('is-open'); }
      else            { el.classList.remove('is-open'); }
    });
  }

  document.querySelectorAll('.udoc-mpick__close').forEach(function(btn) {
    btn.addEventListener('click', function() {
      const id = btn.dataset.close;
      if (id) document.getElementById(id).classList.remove('is-open');
    });
  });

  document.querySelectorAll('.udoc-mpick__tab').forEach(function(tab) {
    tab.addEventListener('click', function() {
      const panelId = tab.dataset.for;
      const picker  = tab.closest('.udoc-mpick');
      picker.querySelectorAll('.udoc-mpick__tab').forEach(function(t) { t.classList.remove('active'); });
      picker.querySelectorAll('.udoc-mpick__panel').forEach(function(p) { p.classList.remove('active'); });
      tab.classList.add('active');
      document.getElementById(panelId).classList.add('active');
    });
  });

  document.getElementById('udocInsertImage').addEventListener('mousedown', function(e) {
    e.preventDefault();
    const sel = window.getSelection();
    if (sel && sel.rangeCount > 0 && editor.contains(sel.anchorNode)) {
      _udocSavedRange = sel.getRangeAt(0).cloneRange();
    }
    udocTogglePicker('udocImgPick');
  });

  document.getElementById('udocInsertVideo').addEventListener('mousedown', function(e) {
    e.preventDefault();
    const sel = window.getSelection();
    if (sel && sel.rangeCount > 0 && editor.contains(sel.anchorNode)) {
      _udocSavedRange = sel.getRangeAt(0).cloneRange();
    }
    udocTogglePicker('udocVidPick');
  });

  document.getElementById('udocImgDrop').addEventListener('click', function() {
    document.getElementById('udocImgFileInp').click();
  });
  document.getElementById('udocImgFileInp').addEventListener('change', function(e) {
    const file = e.target.files[0];
    if (file) document.getElementById('udocImgDropLabel').textContent = file.name;
  });

  document.getElementById('udocImgUploadBtn').addEventListener('click', async function() {
    const file  = document.getElementById('udocImgFileInp').files[0];
    const errEl = document.getElementById('udocImgUploadErr');
    errEl.textContent = '';
    if (!file) { errEl.textContent = 'Please select an image first.'; return; }

    const btn = document.getElementById('udocImgUploadBtn');
    btn.disabled = true;
    btn.textContent = 'Uploading…';

    try {
      const fd = new FormData();
      fd.append('file', file);
      const alt     = document.getElementById('udocImgAlt').value.trim();
      const caption = document.getElementById('udocImgCaption').value.trim();
      if (alt)     fd.append('alt', alt);
      if (caption) fd.append('caption', caption);

      const res  = await fetch('/legal/user-documentation/api/media', { method: 'POST', body: fd });
      const data = await res.json();
      if (!data.success) { errEl.textContent = data.message || 'Upload failed.'; return; }

      udocMediaInsert(data.html);
      document.getElementById('udocImgPick').classList.remove('is-open');
      document.getElementById('udocImgFileInp').value = '';
      document.getElementById('udocImgAlt').value = '';
      document.getElementById('udocImgCaption').value = '';
      document.getElementById('udocImgDropLabel').textContent = 'Click to select an image';
    } catch (_) {
      errEl.textContent = 'Network error. Please try again.';
    } finally {
      btn.disabled = false;
      btn.textContent = 'Upload & Insert';
    }
  });

  document.getElementById('udocImgUrlBtn').addEventListener('click', function() {
    const url = document.getElementById('udocImgUrlInp').value.trim();
    if (!url) return;
    const alt     = document.getElementById('udocImgUrlAlt').value.trim();
    const caption = document.getElementById('udocImgUrlCap').value.trim();
    const figcap  = caption ? `<figcaption>${udocEsc(caption)}</figcaption>` : '';
    const html = `<figure class="doc-media doc-image"><img class="doc-inline-image" src="${udocEsc(url)}" alt="${udocEsc(alt || 'Image')}">${figcap}</figure>`;
    udocMediaInsert(html);
    document.getElementById('udocImgPick').classList.remove('is-open');
    document.getElementById('udocImgUrlInp').value = '';
    document.getElementById('udocImgUrlAlt').value = '';
    document.getElementById('udocImgUrlCap').value = '';
  });

  document.getElementById('udocVidEmbedBtn').addEventListener('click', function() {
    const raw   = document.getElementById('udocVidUrl').value.trim();
    const errEl = document.getElementById('udocVidErr');
    errEl.textContent = '';
    if (!raw) { errEl.textContent = 'Please enter a URL.'; return; }

    let embedSrc = null;
    const ytMatch = raw.match(/(?:youtube\.com\/(?:watch\?v=|embed\/|shorts\/)|youtu\.be\/)([A-Za-z0-9_-]{11})/);
    if (ytMatch) embedSrc = `https://www.youtube-nocookie.com/embed/${ytMatch[1]}`;
    const viMatch = !ytMatch && raw.match(/vimeo\.com\/(?:video\/)?(\d+)/);
    if (viMatch) embedSrc = `https://player.vimeo.com/video/${viMatch[1]}`;

    if (!embedSrc) { errEl.textContent = 'Could not parse a YouTube or Vimeo URL.'; return; }

    const html = `<figure class="doc-media doc-video"><iframe class="doc-youtube-embed" src="${udocEsc(embedSrc)}" title="Embedded video" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen loading="lazy"></iframe></figure>`;
    udocMediaInsert(html);
    document.getElementById('udocVidPick').classList.remove('is-open');
    document.getElementById('udocVidUrl').value = '';
  });

  saveBtn.addEventListener('click', async function() {
    errEl.style.display = 'none';
    const title = fTitle.value.trim();
    const topic = fTopic.value.trim();
    if (!title) { showErr('Title is required.'); return; }
    if (!topic) { showErr('Topic is required.'); return; }

    saveBtn.disabled = true;
    saveBtn.textContent = 'Saving…';

    const payload = {
      title, topic,
      subtopic:       fSubtopic.value.trim(),
      status:         fStatus.value,
      tags:           fTags.value.split(',').map(function(t){ return t.trim(); }).filter(Boolean),
      seoDescription: fSeo.value.trim(),
      contentHtml:    editor.innerHTML,
    };

    try {
      const res  = await fetch('/legal/user-documentation/api/articles', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
      });
      const data = await res.json();
      if (!data.success) { showErr(data.message || 'Could not save article.'); return; }
      closePanel();
      window.location.href = '/legal/user-documentation/' + data.article.slug;
    } catch(_) {
      showErr('Network error. Please try again.');
    } finally {
      saveBtn.disabled = false;
      saveBtn.innerHTML = '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg> Save Article';
    }
  });

  function showErr(msg) { errEl.textContent = msg; errEl.style.display = 'block'; }

  document.querySelectorAll('[data-action="toggle-status"]').forEach(function(btn) {
    btn.addEventListener('click', async function(e) {
      e.preventDefault(); e.stopPropagation();
      const next = btn.dataset.status === 'draft' ? 'active' : 'draft';
      if (!confirm('Change to "' + (next === 'active' ? 'Published' : 'Draft') + '"?')) return;
      btn.disabled = true;
      try {
        const res  = await fetch('/legal/user-documentation/api/articles/' + btn.dataset.id + '/status', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ status: next }),
        });
        const data = await res.json();
        if (data.success) location.reload(); else alert(data.message || 'Failed.');
      } catch(_) { alert('Request failed.'); }
      btn.disabled = false;
    });
  });

  document.querySelectorAll('[data-action="delete-article"]').forEach(function(btn) {
    btn.addEventListener('click', async function(e) {
      e.preventDefault(); e.stopPropagation();
      if (!confirm('Permanently delete "' + btn.dataset.title + '"?\nThis cannot be undone.')) return;
      btn.disabled = true;
      try {
        const res  = await fetch('/legal/user-documentation/api/articles/' + btn.dataset.id + '/delete', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
        });
        const data = await res.json();
        if (data.success) location.reload(); else alert(data.message || 'Failed.');
      } catch(_) { alert('Request failed.'); }
      btn.disabled = false;
    });
  });
}());
</script>

<% } %> <%# end docAdmin %>
