<%- include('../partials/flash') %>
<% const safeJson = (value) => JSON.stringify(value === undefined ? null : value).replace(/</g, '\\u003c'); %>

<link
  rel="stylesheet"
  href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
  integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY="
  crossorigin=""
/>

<link rel="stylesheet" href="<%= assetUrl('/css/manage.css') %>" />
<link rel="stylesheet" href="<%= assetUrl('/css/peoplePanel.css') %>" />

<style>
  :root {
    --tm-bg: #f3f7fb;
    --tm-surface: #ffffff;
    --tm-border: #d8e3ee;
    --tm-text: #0f172a;
    --tm-muted: #5f7085;
    --tm-accent: var(--org-primary-color, #0f5a66);
    --tm-accent-hover: var(--org-primary-hover, #0b4f59);
  }

  body {
    background: transparent;
  }

  .tm-app {
    width: 100%;
    max-width: none;
    margin: 0;
    padding: 20px 24px 60px;
    display: grid;
    grid-template-columns: 280px minmax(0, 1fr);
    gap: 16px;
    align-items: start;
  }

  .tm-sidebar {
    border: 1px solid var(--tm-border);
    border-radius: 16px;
    background: var(--tm-surface);
    box-shadow: 0 12px 30px rgba(15, 23, 42, 0.06);
    padding: 16px;
    position: sticky;
    top: 20px;
    height: fit-content;
  }

  .tm-brand {
    display: flex;
    gap: 0;
    align-items: center;
    justify-content: center;
    padding: 10px;
    margin-bottom: 14px;
  }

  .tm-logo {
    width: 120px;
    height: 120px;
    object-fit: contain;
    flex-shrink: 0;
  }

  .tm-nav-toggle {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 4px;
    width: 36px;
    height: 36px;
    border: 1px solid var(--tm-border);
    border-radius: 8px;
    background: #fff;
    cursor: pointer;
    padding: 0;
    align-items: center;
    flex-shrink: 0;
  }

  .tm-nav-toggle .bar {
    display: block;
    width: 18px;
    height: 2px;
    background: var(--tm-text);
    border-radius: 2px;
    transition: transform 0.15s ease, opacity 0.15s ease;
  }

  .tm-nav-toggle.active .bar:nth-child(1) { transform: translateY(6px) rotate(45deg); }
  .tm-nav-toggle.active .bar:nth-child(2) { opacity: 0; }
  .tm-nav-toggle.active .bar:nth-child(3) { transform: translateY(-6px) rotate(-45deg); }

  .tm-status {
    margin: 6px 6px 10px;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 5px 10px;
    border-radius: 999px;
    font-size: 11px;
    font-weight: 700;
    background: <%= integration && integration.activated ? '#dcfce7' : '#fef3c7' %>;
    color: <%= integration && integration.activated ? '#166534' : '#92400e' %>;
  }

  .tm-status-dot {
    width: 7px;
    height: 7px;
    border-radius: 999px;
    background: currentColor;
  }

  .tm-nav {
    display: grid;
    gap: 4px;
  }

  .tm-nav-btn {
    border: 1px solid transparent;
    border-radius: 10px;
    background: transparent;
    color: #1f2937;
    font-size: 14px;
    font-weight: 600;
    text-align: left;
    padding: 11px 12px;
    cursor: pointer;
    transition: none;
  }

  .tm-nav-btn:focus,
  .tm-nav-btn:focus-visible,
  .tm-nav-btn:active {
    outline: none;
    background: transparent;
    border-color: transparent;
  }

  .tm-nav-btn.active {
    background: #f8fbff;
    color: var(--tm-accent);
    border-color: #cfe0ee;
  }

  .tm-main {
    border: 1px solid var(--tm-border);
    border-radius: 16px;
    background: var(--tm-surface);
    box-shadow: 0 12px 30px rgba(15, 23, 42, 0.06);
    overflow: visible;
  }

  .tm-pane {
    display: none;
    padding: 20px;
  }

  .tm-pane.active {
    display: block;
  }

  .tm-head {
    margin-bottom: 12px;
  }

  .tm-head--split {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
  }

  .tm-head h2 {
    margin: 0;
    font-size: 24px;
    color: var(--tm-text);
  }

  .tm-stats {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: 10px;
    margin-bottom: 14px;
  }

  .tm-stat {
    border: 1px solid var(--tm-border);
    border-radius: 12px;
    background: #fbfdff;
    padding: 10px;
  }

  .tm-stat-k {
    margin: 0;
    font-size: 11px;
    color: var(--tm-muted);
    text-transform: uppercase;
    letter-spacing: .06em;
  }

  .tm-stat-v {
    margin: 3px 0 0;
    font-size: 21px;
    font-weight: 800;
    color: var(--tm-text);
  }

  .tm-grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: 12px;
  }

  .tm-card {
    border: 1px solid var(--tm-border);
    border-radius: 12px;
    background: #fff;
    padding: 14px;
    min-width: 0;
    overflow: visible;
  }

  .tm-toolbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    margin-bottom: 10px;
  }

  .tm-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 1px solid #c7d7e6;
    border-radius: 7px;
    padding: 5px 10px;
    background: #fff;
    color: #0f172a;
    font-size: 12px;
    font-weight: 600;
    line-height: 1.2;
    min-height: 30px;
    width: auto;
    cursor: pointer;
    text-decoration: none;
    white-space: nowrap;
  }

  .tm-btn--primary {
    background: var(--tm-accent);
    border-color: var(--tm-accent);
    color: #fff;
  }

  .tm-modal {
    position: fixed;
    inset: 0;
    z-index: 1600;
    display: none;
    align-items: center;
    justify-content: center;
    padding: 16px;
    background: rgba(2, 10, 23, 0.45);
  }

  .tm-modal.is-open {
    display: flex;
  }

  .tm-modal-card {
    width: min(920px, 96vw);
    max-height: 90vh;
    overflow: auto;
    border-radius: 14px;
    border: 1px solid #d8e3ee;
    background: #fff;
    box-shadow: 0 24px 60px rgba(2, 10, 23, 0.26);
    padding: 14px;
  }

  .tm-modal-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    margin-bottom: 8px;
  }

  .tm-modal-title {
    margin: 0;
    font-size: 19px;
    color: #0f172a;
  }

  .tm-modal-sect {
    margin-top: 8px;
    border: 1px solid #e0e8f1;
    border-radius: 10px;
    padding: 10px;
    background: #fbfdff;
  }

  .tm-modal-sect h4 {
    margin: 0 0 8px;
    font-size: 14px;
    color: #0f172a;
  }

  .tm-card h3 {
    margin: 0 0 4px;
    font-size: 18px;
    color: var(--tm-text);
  }

  .span-12 { grid-column: span 12; }
  .span-8 { grid-column: span 8; }
  .span-6 { grid-column: span 6; }
  .span-4 { grid-column: span 4; }

  .tm-form-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 8px;
  }

  .tm-badge {
    display: inline-flex;
    align-items: center;
    padding: 3px 10px;
    border-radius: 999px;
    background: #eef2ff;
    color: #3730a3;
    font-size: 11px;
    font-weight: 600;
  }

  

  .tm-checkbox-list {
    max-height: 180px;
    overflow-y: auto;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    padding: 8px 10px;
    display: grid;
    gap: 6px;
    background: #f8fafc;
  }

  .tm-checkbox-list-item {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 13px;
    font-weight: 400;
    color: #334155;
  }

  .tm-row {
    display: grid;
    gap: 5px;
  }

  .tm-row label {
    color: #334155;
    font-size: 12px;
    font-weight: 600;
  }

  .tm-row input,
  .tm-row select,
  .tm-row button {
    border: 1px solid #c7d7e6;
    border-radius: 8px;
    padding: 8px;
    font-size: 12px;
    background: #fff;
  }

  .tm-row input:focus,
  .tm-row select:focus {
    outline: none;
    border-color: #7fb1d6;
    box-shadow: 0 0 0 3px rgba(75, 144, 189, .15);
  }

  .tm-row button {
    background: var(--tm-accent);
    border-color: var(--tm-accent);
    color: #fff;
    font-weight: 600;
    padding: 6px 10px;
    min-height: 32px;
    width: auto;
    cursor: pointer;
  }

  

  .tm-list {
    margin: 10px 0 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 6px;
    max-height: none;
    overflow: visible;
  }

  .tm-list li {
    border: 1px solid #dae6f1;
    border-radius: 8px;
    background: #fbfdff;
    padding: 8px;
    font-size: 13px;
    color: #1f2937;
  }

  .tm-item-row {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 10px;
  }

  .tm-item-body {
    flex: 1;
    min-width: 0;
  }

  .tm-actions-item {
    border: 1px solid #d6e3ef;
    background: #fff;
    color: #1f2937;
    border-radius: 6px;
    padding: 6px 8px;
    font-size: 12px;
    text-align: left;
    cursor: pointer;
  }

  .tm-driver-row {
    display: grid;
    grid-template-columns: 42px minmax(0, 1fr);
    gap: 9px;
    align-items: center;
  }

  .tm-driver-avatar {
    width: 42px;
    height: 42px;
    border-radius: 999px;
    object-fit: cover;
    border: 1px solid #d7e2ec;
    background: #edf3f9;
  }

  .tm-map-toolbar {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    align-items: center;
    margin-bottom: 8px;
  }

  .tm-map-toolbar input,
  .tm-map-toolbar button {
    border: 1px solid #c7d7e6;
    border-radius: 8px;
    font-size: 12px;
    padding: 8px 10px;
    background: #fff;
  }

  .tm-map-toolbar button {
    background: #0f5a66;
    border-color: #0f5a66;
    color: #fff;
    font-weight: 600;
    padding: 5px 10px;
    min-height: 30px;
    width: auto;
    cursor: pointer;
  }

  .tm-map-note {
    font-size: 11px;
    color: var(--tm-muted);
    margin: 8px 0 0;
  }

  .tm-class-group {
    border: 1px solid #dae6f1;
    border-radius: 8px;
    background: #fbfdff;
    padding: 8px;
  }

  .tm-class-group summary {
    cursor: pointer;
    font-weight: 700;
    color: #0f172a;
    outline: none;
  }

  .tm-card-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 12px;
  }

  .tm-card-head > details {
    flex: 1;
    min-width: 0;
  }

  .tm-card-head > .tm-btn,
  .tm-card-head > div {
    flex-shrink: 0;
  }

  .tm-settings-stack {
    display: grid;
    gap: 12px;
  }

  .tm-settings-stack .tm-card details > *:not(summary) {
    margin-top: 12px;
  }

  .tm-card-summary {
    cursor: pointer;
    outline: none;
    list-style: none;
  }

  .tm-card-summary::-webkit-details-marker { display: none; }

  .tm-card-summary h3 {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin: 0;
  }

  .tm-card-summary::before {
    content: '▸';
    display: inline-block;
    margin-right: 6px;
    color: #64748b;
    transition: transform 0.15s ease;
  }

  details[open] > .tm-card-summary::before {
    transform: rotate(90deg);
  }

  .tm-class-group-list {
    margin-top: 8px;
    display: grid;
    gap: 6px;
  }

  .tm-class-toolbar {
    margin-top: 8px;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    align-items: center;
  }

  .tm-class-toolbar .tm-btn {
    min-height: 28px;
    padding: 4px 10px;
    font-size: 12px;
  }

  .tm-class-toolbar .tm-map-note {
    margin: 0;
  }

  .tm-student-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 4px;
    border: 1px solid #e2ebf3;
    border-radius: 8px;
    background: #fff;
    padding: 7px 8px;
  }

  .tm-student-main {
    display: flex;
    align-items: flex-start;
    gap: 8px;
  }

  .tm-student-check {
    margin-top: 2px;
    display: none;
  }

  .tm-class-group.is-editing .tm-student-check {
    display: inline-block;
  }

  .tm-student-access-tag {
    display: inline-flex;
    align-items: center;
    border-radius: 999px;
    padding: 2px 7px;
    font-size: 11px;
    font-weight: 600;
    margin-left: 8px;
  }

  .tm-student-access-tag--yes {
    border: 1px solid #cde9d6;
    color: #166534;
    background: #f0fdf4;
  }

  .tm-student-access-tag--no {
    border: 1px solid #eed4d4;
    color: #991b1b;
    background: #fff7f7;
  }

  .tm-class-edit-controls {
    display: none;
    gap: 8px;
    align-items: center;
    flex-wrap: wrap;
  }

  .tm-class-group.is-editing .tm-class-edit-controls {
    display: inline-flex;
  }

  .tm-stop-picker-map {
    width: 100%;
    height: 220px;
    border-radius: 10px;
    border: 1px solid #d6e3ef;
    background: #eef5fb;
  }

  .tm-map-frame {
    position: relative;
  }

  .tm-locate-btn {
    display: flex !important;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 34px;
    font-size: 17px;
    line-height: 1;
    background: #fff;
    text-decoration: none;
  }

  

  .tm-locate-btn.is-locating {
    color: var(--org-primary-color, #2563eb);
    animation: tm-locate-pulse 1s ease-in-out infinite;
  }

  @keyframes tm-locate-pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.35; }
  }

  .tm-my-location-dot {
    width: 14px;
    height: 14px;
    border-radius: 999px;
    background: #2563eb;
    border: 3px solid #fff;
    box-shadow: 0 0 0 2px rgba(37, 99, 235, 0.4), 0 2px 6px rgba(15, 23, 42, 0.3);
  }

  .tm-map-maximize {
    position: absolute;
    top: 10px;
    right: 10px;
    z-index: 500;
    width: 34px;
    height: 34px;
    border-radius: 8px;
    border: 1px solid var(--tm-border);
    background: #fff;
    color: var(--tm-text);
    font-size: 16px;
    line-height: 1;
    cursor: pointer;
    box-shadow: 0 4px 10px rgba(15, 23, 42, 0.12);
  }

  .tm-map-frame.is-fullscreen {
    position: fixed;
    top: var(--header-height, 64px);
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 900;
    background: #fff;
    padding: 10px 10px 60px;
    box-sizing: border-box;
  }

  .tm-map-frame.is-fullscreen #tm-route-map {
    height: 100% !important;
  }

  #tm-route-map {
    width: 100%;
    height: 500px;
    border-radius: 10px;
    border: 1px solid #d6e3ef;
    background: #eef5fb;
  }

  .tm-map-legend {
    margin-top: 8px;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    font-size: 11px;
    color: #334155;
  }

  .tm-map-pill {
    border: 1px solid #d2e0ec;
    background: #f8fbff;
    border-radius: 999px;
    padding: 4px 8px;
    display: inline-flex;
    align-items: center;
    gap: 5px;
  }

  .tm-map-dot {
    width: 9px;
    height: 9px;
    border-radius: 999px;
    display: inline-block;
    background: #334155;
  }

  .tm-bus-pin {
    width: 24px;
    height: 24px;
    border-radius: 999px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #fff;
    border: 2px solid #0f172a;
    box-shadow: 0 4px 10px rgba(15, 23, 42, 0.2);
    font-size: 13px;
    line-height: 1;
  }

  .tm-stop-pin {
    border-radius: 999px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #fff;
    border: 2px solid #0f172a;
    box-shadow: 0 3px 8px rgba(15, 23, 42, 0.2);
    line-height: 1;
  }

  .tm-school-pin {
    width: 28px;
    height: 28px;
    border-radius: 999px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #fff7ed;
    border: 2px solid #b45309;
    box-shadow: 0 4px 10px rgba(120, 53, 15, 0.22);
    font-size: 15px;
    line-height: 1;
  }

  .tm-kv {
    margin-top: 8px;
    font-size: 12px;
    color: #475569;
  }

  @media (max-width: 1180px) {
    .tm-app {
      grid-template-columns: 1fr;
    }

    .tm-sidebar {
      position: static;
    }

    .tm-brand {
      justify-content: space-between;
      margin-bottom: 0;
      padding: 4px;
    }

    .tm-nav-toggle {
      display: inline-flex;
    }

    .tm-nav {
      display: none;
      grid-template-columns: 1fr;
      margin-top: 10px;
    }

    .tm-nav.is-open {
      display: grid;
    }

    .tm-stats {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .span-8,
    .span-6,
    .span-4 {
      grid-column: span 12;
    }
  }

  @media (max-width: 760px) {
    .tm-app {
      padding: 10px 10px 60px;
      min-height: auto;
    }

    .tm-sidebar {
      padding: 10px 12px;
    }

    .tm-head--split {
      flex-direction: column;
      align-items: flex-start;
    }

    .tm-logo {
      width: 56px;
      height: 56px;
    }

    .tm-form-grid {
      grid-template-columns: 1fr;
    }

    .tm-stats {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    #tm-route-map {
      height: 360px;
    }
  }
  /* ---- Polish: flat, readable, flexible on every screen and theme ---- */
  .tm-sidebar, .tm-card, .tm-stat { box-shadow: none; border-radius: 12px; }
  .tm-card { padding: 16px; min-width: 0; }
  .tm-head h2 { font-size: 1.25rem; line-height: 1.3; color: var(--tm-text); }
  .tm-card h3, .tm-card-summary h3 { font-size: 1rem; color: var(--tm-text); }
  .tm-stat-k, .tm-badge, .tm-map-note, .tm-map-legend, .tm-student-access-tag { font-size: 12px; }
  .tm-stat-k, .tm-map-note { color: var(--tm-muted); }
  .tm-nav-btn { color: var(--tm-text); }
  
  .tm-nav-btn.active { background: var(--tm-bg); border-color: var(--tm-border); }
  .tm-list li, .tm-item-row, .tm-student-row { min-width: 0; overflow-wrap: anywhere; }
  .tm-card table { width: 100%; border-collapse: collapse; }
  .tm-card .table-wrap, .tm-card:has(> table) { overflow-x: auto; }
  .tm-btn, .tm-row button { min-height: 40px; }
  .tm-row input, .tm-row select, .tm-row textarea { font-size: 16px; min-height: 40px; }
  .tm-modal-card { max-height: calc(100vh - 32px); overflow-y: auto; }
  @media (max-width: 760px) {
    .tm-app { padding: 12px 12px 60px; gap: 12px; }
    .tm-card { padding: 14px; }
    .tm-toolbar, .tm-class-toolbar { flex-wrap: wrap; gap: 8px; }
    .tm-toolbar .tm-btn, .tm-class-toolbar .tm-btn { flex: 1 1 140px; justify-content: center; }
    .tm-modal-card { width: calc(100vw - 20px); max-width: none; }
  }
  body.org-themed .tm-sidebar,
  body.org-themed .tm-card,
  body.org-themed .tm-stat { background: var(--oc-surface, #fff) !important; border-color: var(--oc-line, var(--tm-border)) !important; }
  body.org-themed .tm-head h2,
  body.org-themed .tm-card h3,
  body.org-themed .tm-nav-btn,
  body.org-themed .tm-stat-v { color: #111827 !important; }
  /* Overview: quick buttons, number tiles, one big map. */
  .tm-ov-head { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 12px; }
  .tm-ov-actions { display: flex; flex-wrap: wrap; gap: 8px; }
  .tm-ov-actions .tm-btn { width: auto; margin: 0; padding: 8px 14px; border-radius: 10px; font-weight: 600; text-decoration: none; }
  .tm-ov-tiles { display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); gap: 10px; margin: 14px 0; }
  .tm-ov-tile { display: flex; flex-direction: column; align-items: flex-start; gap: 2px; width: 100%; margin: 0; padding: 12px 14px; border: 1px solid var(--tm-border, #e5e7eb); border-radius: 12px; background: var(--oc-surface, #fff); color: var(--muted, #64748b); font-size: .78rem; font-weight: 600; text-align: left; cursor: pointer; transition: border-color .15s ease, transform .15s ease; }
  .tm-ov-tile span { color: var(--text, #0f172a); font-size: 1.45rem; font-weight: 800; line-height: 1.1; }
  .tm-ov-tile small { font-size: .85rem; font-weight: 600; color: var(--muted, #64748b); }
  .tm-ov-tile:hover { border-color: var(--primary, #01535b); }
  .tm-ov-map { padding: 0 !important; overflow: hidden; }
  .tm-ov-map-bar { display: flex; flex-wrap: wrap; align-items: center; gap: 10px; padding: 10px 12px; }
  .tm-ov-map-bar select { width: auto; min-width: 200px; margin: 0; }
  .tm-ov-live { display: inline-flex; align-items: center; gap: 6px; padding: 4px 10px; border-radius: 999px; background: color-mix(in srgb, #16a34a 12%, transparent); color: #15803d; font-size: .76rem; font-weight: 700; }
  .tm-ov-live::before { content: ""; width: 8px; height: 8px; border-radius: 50%; background: #16a34a; }
  .tm-ov-live[hidden] { display: none; }
  .tm-ov-warn { padding: 4px 10px; border-radius: 999px; background: color-mix(in srgb, #f59e0b 14%, transparent); color: #b45309; font-size: .76rem; font-weight: 600; }
  .tm-ov-map #tm-route-map { height: min(68vh, 680px); border: 0; border-radius: 0; }
  .tm-count { display: inline-block; margin-left: 6px; padding: 1px 8px; border-radius: 999px; background: color-mix(in srgb, var(--primary, #01535b) 10%, transparent); color: var(--primary, #01535b); font-size: .78rem; vertical-align: middle; }
  @media (max-width: 900px) { .tm-ov-tiles { grid-template-columns: repeat(3, minmax(0, 1fr)); } .tm-ov-map #tm-route-map { height: 60vh; } }
  @media (max-width: 520px) { .tm-ov-tiles { grid-template-columns: repeat(2, minmax(0, 1fr)); } .tm-ov-actions { width: 100%; } .tm-ov-actions .tm-btn { flex: 1 1 auto; text-align: center; } }
  .tm-btn--primary, .tm-row button, .tm-map-toolbar button { background: var(--tm-accent); border-color: var(--tm-accent); color: #fff; }
  .tm-btn--primary:hover, .tm-row button:hover, .tm-map-toolbar button:hover { background: var(--tm-accent-hover); }
  .tm-btn { border-radius: 10px; font-size: 13px; }
  .tm-btn[hidden] { display: none; }
  .tm-btn--danger { background: transparent; border-color: rgba(198, 40, 40, .4); color: #d93025; }
  .tm-btn--danger:hover { background: rgba(198, 40, 40, .08); }
  .tm-list li.tm-item { display: flex; align-items: center; gap: 12px; padding: 12px 14px; }
  .tm-item-main { flex: 1; min-width: 0; }
  .tm-item-title { display: flex; align-items: center; flex-wrap: wrap; gap: 8px; font-size: 14px; }
  .tm-item-meta { margin-top: 3px; font-size: 13px; color: var(--tm-muted); overflow-wrap: anywhere; }
  .tm-chip { display: inline-flex; align-items: center; padding: 2px 8px; border: 1px solid var(--tm-border); border-radius: 999px; font-size: 11px; font-weight: 600; color: var(--tm-muted); text-transform: capitalize; }
  .tm-chip.is-on { color: #16a34a; border-color: rgba(22, 163, 74, .4); }
  .tm-chip.is-warn { color: #d97706; border-color: rgba(217, 119, 6, .4); }
  .tm-list .tm-edit { flex: none; min-height: 36px; padding: 0 16px; font-size: 13px; border: 1px solid var(--tm-border); background: transparent; color: inherit; }
  .tm-modal-sect { background: transparent; border: 0; border-top: 1px solid var(--tm-border); border-radius: 0; padding: 16px 0 4px; margin-top: 12px; }
  .tm-modal-sect:first-of-type { border-top: 0; margin-top: 0; padding-top: 4px; }
  .tm-modal-foot { display: flex; align-items: center; gap: 10px; margin-top: 16px; padding-top: 14px; border-top: 1px solid var(--tm-border); }
  .tm-modal-foot .tm-map-note { flex: 1; margin: 0; }
  .tm-days { display: flex; flex-wrap: wrap; gap: 8px; margin: 6px 0 12px; }
  .tm-days label { position: relative; cursor: pointer; }
  .tm-days input { position: absolute; opacity: 0; width: 1px; height: 1px; }
  .tm-days span { display: inline-flex; align-items: center; justify-content: center; min-width: 52px; min-height: 40px; padding: 0 12px; border: 1px solid var(--tm-border); border-radius: 999px; font-size: 13px; font-weight: 600; }
  .tm-days input:checked + span { background: var(--tm-accent); border-color: var(--tm-accent); color: #fff; }
  .tm-days input:focus-visible + span { outline: 2px solid #1a73e8; outline-offset: 2px; }
  @media (max-width: 760px) {
    .tm-modal { padding: 0; align-items: flex-end; }
    .tm-modal-card { width: 100%; max-width: none; max-height: 92vh; border-radius: 18px 18px 0 0; padding: 18px 16px calc(76px + env(safe-area-inset-bottom, 0px)); }
    .tm-ov-actions .tm-btn { flex: 1 1 calc(50% - 8px); }
    .tm-list li.tm-item { align-items: flex-start; }
  }

  /* Clean, quiet layout: a plain side list, flat cards, and one accent color. */
  .tm-app { grid-template-columns: 196px minmax(0, 1fr); gap: 28px; padding: 20px 24px 48px; }
  body .tm-app .tm-sidebar { position: sticky; top: 16px; padding: 0; border: 0 !important; border-radius: 0; background: transparent !important; box-shadow: none !important; }
  .tm-brand { display: none; }
  body .tm-app .tm-main { border: 0 !important; border-radius: 0; background: transparent !important; box-shadow: none !important; }
  .tm-main > .tm-pane { padding: 0; }
  #tm-panel { z-index: 13100; }
  #tm-panel-backdrop { z-index: 13090; }
  .tm-nav { gap: 2px; }
  .tm-nav-btn { display: flex; align-items: center; justify-content: space-between; gap: 8px; padding: 9px 10px; border: 0; border-radius: 8px; background: transparent; box-shadow: none; font-size: 14px; font-weight: 600; color: #475569; text-align: left; }
  .tm-nav-btn.active { background: color-mix(in srgb, var(--tm-accent) 10%, transparent); color: var(--tm-accent); box-shadow: none; }
  .tm-nav-badge { min-width: 20px; padding: 1px 6px; border-radius: 999px; background: var(--tm-accent); color: #fff; font-size: 11px; font-weight: 700; text-align: center; }
  .tm-nav-badge[hidden] { display: none; }
  .tm-card { border-radius: 12px; box-shadow: none; }
  .tm-ov-tiles { display: grid; grid-template-columns: repeat(auto-fit, minmax(118px, 1fr)); gap: 10px; }
  .tm-ov-tile { border-radius: 12px; box-shadow: none; }

  /* Students and Requests: laid out like the employee list. */
  .tm-pane.ws-root { padding: 0 !important; }
  .tm-pane .ws-head { margin-bottom: 16px; }
  .tm-pane table.ws-cards { width: 100%; border-collapse: collapse; background: #fff; }
  .tm-pane table.ws-cards th { padding: 10px 14px; border-bottom: 1px solid var(--ws-line, #e2e8f0); background: var(--ws-soft, #f8fafc); color: var(--ws-muted, #64748b); font-size: .72rem; font-weight: 700; letter-spacing: .05em; text-align: left; text-transform: uppercase; white-space: nowrap; }
  .tm-pane table.ws-cards td { padding: 12px 14px; border-bottom: 1px solid var(--ws-line-soft, #f1f5f9); font-size: .875rem; text-align: left; vertical-align: middle; }
  .tm-pane table.ws-cards tbody tr:last-child td { border-bottom: 0; }
  .tm-pane .ws-cards-wrap { overflow: hidden; border: 1px solid var(--ws-line, #e2e8f0); border-radius: 12px; background: #fff; }
  .tm-pill--none { background: #f1f5f9; color: #64748b; }
  .tm-col-access { width: 170px; }
  .tm-check-cell { display: none; width: 36px; }
  .is-bulk .tm-check-cell { display: table-cell; }
  .is-bulk tr.ux-row { cursor: default; }
  .tm-check-cell input { width: 16px; height: 16px; margin: 0; }
  .tm-class-tools { display: flex; flex-direction: column; gap: 8px; padding-top: 12px; border-top: 1px solid var(--ws-line, #e2e8f0); }
  .tm-class-tools[hidden], .tm-class-tools [hidden] { display: none !important; }
  .tm-class-tools p { margin: 0; color: var(--ws-muted, #64748b); font-size: 12px; }
  .tm-segment { display: inline-flex; gap: 2px; padding: 3px; border-radius: 10px; background: #f1f5f9; }
  .tm-segment button { display: inline-flex; align-items: center; gap: 6px; width: auto; margin: 0; padding: 6px 16px; border: 0; border-radius: 8px; background: transparent; box-shadow: none; color: #64748b; font-size: 13px; font-weight: 600; cursor: pointer; }
  .tm-segment button.is-on { background: #fff; color: #0f172a; box-shadow: 0 1px 2px rgba(15, 23, 42, .1); }

  .tm-settings-stack[hidden] { display: none; }
  .tm-list-search { display: block; box-sizing: border-box; width: 100%; max-width: 420px; height: 38px; margin: 0 0 12px; padding: 0 12px; border: 1px solid var(--ws-line, #e2e8f0); border-radius: 8px; background: #fff; color: #0f172a; font-size: 14px; }

  /* The panel's form */
  .tm-form__class { margin: 0 0 12px; }
  .tm-sec--first { padding-top: 0; border-top: 0; }
  .tm-fields { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
  .tm-fields[hidden] { display: none; }
  .ux-sec > .tm-switch + .tm-fields { margin-top: 14px; }
  .tm-field { display: flex; flex-direction: column; gap: 5px; margin: 0; min-width: 0; font-size: 12px; font-weight: 600; color: var(--ws-muted, #64748b); }
  .tm-field--wide { grid-column: 1 / -1; }
  .tm-field input, .tm-field select { box-sizing: border-box; width: 100%; height: 38px; margin: 0; padding: 0 10px; border: 1px solid var(--ws-line, #cbd5e1); border-radius: 8px; background: #fff; color: #0f172a; font-size: 14px; font-weight: 400; }
  .tm-check { display: flex; align-items: center; gap: 8px; margin: 0; font-size: 14px; color: #0f172a; cursor: pointer; }
  .tm-check input { width: 16px; height: 16px; margin: 0; }
  .tm-switch { display: flex; align-items: center; justify-content: space-between; margin: 0; font-size: 14px; font-weight: 700; color: #0f172a; cursor: pointer; }
  .tm-switch input { position: absolute; opacity: 0; width: 1px; height: 1px; }
  .tm-switch i { position: relative; width: 40px; height: 24px; border-radius: 999px; background: #cbd5e1; transition: background .15s ease; }
  .tm-switch i::after { content: ''; position: absolute; top: 3px; left: 3px; width: 18px; height: 18px; border-radius: 50%; background: #fff; box-shadow: 0 1px 2px rgba(15, 23, 42, .25); transition: transform .15s ease; }
  .tm-switch input:checked + i { background: var(--tm-accent); }
  .tm-switch input:checked + i::after { transform: translateX(16px); }
  .tm-switch input:focus-visible + i { outline: 2px solid var(--tm-accent); outline-offset: 2px; }
  .tm-form__note { margin: 0 0 10px; color: var(--ws-muted, #64748b); font-size: 13px; }
  .tm-form__note.is-error { color: #b91c1c; }
  .tm-form__actions { display: flex; justify-content: flex-end; gap: 8px; padding-top: 14px; border-top: 1px solid var(--ws-line, #e2e8f0); }

  @media (max-width: 1180px) {
    .tm-app { grid-template-columns: minmax(0, 1fr); gap: 12px; padding: 12px 12px 40px; }
    body .tm-app .tm-sidebar { position: static; }
    .tm-brand { display: flex; justify-content: flex-end; margin: 0 0 8px; padding: 0; }
    .tm-logo { display: none; }
  }
</style>

<div class="tm-app">
  <aside class="tm-sidebar">
    <div class="tm-brand">
      <img class="tm-logo" src="/images/icons/transportation-logo-256.png" alt="Transportation logo" />
      <button class="tm-nav-toggle" type="button" id="tm-nav-toggle" aria-label="Open menu" aria-expanded="false">
        <span class="bar"></span>
        <span class="bar"></span>
        <span class="bar"></span>
      </button>
    </div>

    <nav class="tm-nav" aria-label="Transportation sections" id="tm-nav">
      <button class="tm-nav-btn active" type="button" data-pane="overview">Overview</button>
      <% const transportAccess = workspaceAccess().transport; %>
      <% if (transportAccess.riderList) { %><button class="tm-nav-btn" type="button" data-pane="requests">Requests <span class="tm-nav-badge" id="tm-requests-badge" hidden></span></button><% } %>
      <% if (transportAccess.reports) { %><button class="tm-nav-btn" type="button" data-pane="reports">Reports <span class="tm-nav-badge" id="tm-reports-badge" hidden></span></button><% } %>
      <% if (transportAccess.buses) { %><button class="tm-nav-btn" type="button" data-pane="buses">Buses</button><% } %>
      <% if (transportAccess.drivers) { %><button class="tm-nav-btn" type="button" data-pane="drivers">Drivers</button><% } %>
      <% if (transportAccess.schedules || transportAccess.routes) { %><button class="tm-nav-btn" type="button" data-pane="schedule">Schedule</button><% } %>
      <% if (transportAccess.students) { %><button class="tm-nav-btn" type="button" data-pane="students">Students</button><% } %>
      <% if (transportAccess.settings || transportAccess.reports) { %><button class="tm-nav-btn" type="button" data-pane="settings">Settings</button><% } %>
    </nav>
  </aside>

  <main class="tm-main">
    <section class="tm-pane active" data-pane-id="overview">
      <% const weekdayNow = ['sunday','monday','tuesday','wednesday','thursday','friday','saturday'][new Date().getDay()]; %>
      <% const todaySchedules = (schedules || []).filter(function(s) { return String(s.day_of_week || '').toLowerCase() === weekdayNow && String(s.status || '').toLowerCase() === 'active'; }); %>
      <% const mappedStops = (stops || []).filter(function(s) { return s.latitude !== null && s.longitude !== null; }).length; %>
      <div class="tm-head tm-ov-head">
        <h2>Transportation</h2>
        <div class="tm-ov-actions" role="group" aria-label="Add">
          <% if (transportAccess.drivers) { %><button type="button" class="tm-btn tm-btn--primary" data-tm-click="open-add-driver-modal" data-tm-pane="drivers">Add driver</button><% } %>
          <% if (transportAccess.buses) { %><button type="button" class="tm-btn" data-tm-click="open-add-bus-modal" data-tm-pane="buses">Add bus</button><% } %>
          <% if (transportAccess.routes) { %><button type="button" class="tm-btn" data-tm-click="open-add-route-modal" data-tm-pane="buses">Add route</button>
          <button type="button" class="tm-btn" data-tm-click="open-add-stop-modal" data-tm-pane="buses">Add stop</button><% } %>
        </div>
      </div>

      <div class="tm-ov-tiles">
        <button type="button" class="tm-ov-tile" data-tm-pane="buses"><span><%= (buses || []).length %></span>Buses</button>
        <button type="button" class="tm-ov-tile" data-tm-pane="drivers"><span><%= (drivers || []).length %></span>Drivers</button>
        <button type="button" class="tm-ov-tile" data-tm-pane="buses"><span><%= (routes || []).length %></span>Routes</button>
        <button type="button" class="tm-ov-tile" data-tm-pane="buses"><span><%= (stops || []).length %></span>Stops</button>
        <button type="button" class="tm-ov-tile" data-tm-pane="students"><span><b id="tm-riders-count" style="font-weight:inherit"><%= (assignments || []).length %></b><small>/<%= (students || []).length %></small></span>Students riding</button>
        <% if (transportAccess.riderList) { %><button type="button" class="tm-ov-tile" data-tm-pane="requests"><span id="tm-requests-tile">0</span>New requests</button><% } %>
        <% if (transportAccess.reports) { %><button type="button" class="tm-ov-tile" data-tm-pane="reports"><span id="tm-reports-tile">0</span>New reports</button><% } %>
        <button type="button" class="tm-ov-tile" data-tm-pane="schedule"><span><%= todaySchedules.length %></span>Trips today</button>
      </div>

      <article class="tm-card tm-ov-map">
        <div class="tm-ov-map-bar">
          <select id="tm-route-filter" aria-label="Route">
            <option value="">All routes</option>
            <% (routes || []).forEach(function(route) { %>
              <option value="<%= route.route_id %>"><%= route.route_name %></option>
            <% }) %>
          </select>
          <span class="tm-ov-live" id="tm-ov-live" hidden></span>
          <% if (mappedStops < (stops || []).length) { %><span class="tm-ov-warn"><%= (stops || []).length - mappedStops %> stop<%= (stops || []).length - mappedStops === 1 ? '' : 's' %> not on the map</span><% } %>
        </div>
        <div class="tm-map-frame" id="tm-route-map-frame">
          <button type="button" class="tm-map-maximize" id="tm-route-map-maximize" aria-label="Full screen" title="Full screen">⛶</button>
          <div id="tm-route-map"></div>
        </div>
      </article>
    </section>

    <section class="tm-pane" data-pane-id="drivers">
      <div class="tm-head tm-head--split">
        <h2>Drivers <span class="tm-count"><%= (drivers || []).length %></span></h2>
        <button class="tm-btn tm-btn--primary" type="button" id="open-add-driver-modal">Add driver</button>
      </div>
      <p class="tm-map-note" style="margin-top:-4px;">Give each driver a bus, a route and weekly days in one form.</p>
      <%
        const driverRouteNames = Object.fromEntries((routes || []).map(function (route) { return [String(route.route_id), route.route_name]; }));
        const driverDayList = ['monday','tuesday','wednesday','thursday','friday','saturday','sunday'];
        const driverDayShort = { monday: 'Mon', tuesday: 'Tue', wednesday: 'Wed', thursday: 'Thu', friday: 'Fri', saturday: 'Sat', sunday: 'Sun' };
        const driverClock = function (time) { if (!time) return ''; const parts = String(time).split(':'); let hour = parseInt(parts[0], 10); const minute = parts[1] || '00'; const suffix = hour >= 12 ? 'PM' : 'AM'; hour = hour % 12 || 12; return hour + ':' + minute + ' ' + suffix; };
      %>
      <% if (!(drivers || []).length) { %><p class="tm-map-note">No drivers yet. Add one to give them a bus and route.</p><% } %>
      <ul class="tm-list" id="driver-list">
        <% (drivers || []).forEach(function (driver) { %>
          <%
            const driverFullName = [driver.first_name, driver.last_name].filter(Boolean).join(' ');
            const driverSchedules = (schedules || []).filter(function (schedule) { return driver.driver_id && Number(schedule.driver_id) === Number(driver.driver_id); });
            const driverDays = driverDayList.filter(function (day) { return driverSchedules.some(function (schedule) { return schedule.day_of_week === day; }); });
            const driverRouteId = driver.assigned_route_id || ((driverSchedules.find(function (schedule) { return schedule.route_id; }) || {}).route_id) || '';
            const driverRouteName = driverRouteId ? (driverRouteNames[String(driverRouteId)] || '') : '';
            const driverScheduleStart = driverSchedules[0] ? driverSchedules[0].start_time : '';
            const driverScheduleEnd = driverSchedules[0] ? driverSchedules[0].end_time : '';
            const driverPlan = driverDays.length ? driverDays.map(function (day) { return driverDayShort[day]; }).join(' ') + (driverScheduleStart ? ', ' + driverClock(driverScheduleStart) + (driverScheduleEnd ? ' to ' + driverClock(driverScheduleEnd) : '') : '') : 'No weekly days';
          %>
          <li class="tm-item">
            <img class="tm-driver-avatar" src="<%= publicImageUrl(driver.image_url || '/images/profilePlaceholder.png') %>" alt="" />
            <div class="tm-item-main">
              <div class="tm-item-title">
                <strong><%= driverFullName %></strong>
                <% if (String(driver.status || 'active') !== 'active') { %><span class="tm-chip">Inactive</span>
                <% } else if (!driver.assigned_bus_id || !driverRouteId) { %><span class="tm-chip is-warn">Needs bus and route</span>
                <% } else { %><span class="tm-chip is-on">Ready</span><% } %>
              </div>
              <div class="tm-item-meta"><%= [driver.bus_number ? 'Bus ' + driver.bus_number : 'No bus', driverRouteName || 'No route', driverPlan].join(', ') %></div>
              <div class="tm-item-meta"><%= [driver.email, driver.phone].filter(Boolean).join(', ') %></div>
            </div>
            <button class="tm-btn tm-actions-item tm-edit" type="button" data-action="edit-driver"
              data-user-id="<%= driver.user_id %>"
              data-first-name="<%= driver.first_name || '' %>"
              data-last-name="<%= driver.last_name || '' %>"
              data-phone="<%= driver.phone || '' %>"
              data-email="<%= driver.email || '' %>"
              data-license-number="<%= driver.license_number || '' %>"
              data-status="<%= driver.status || 'active' %>"
              data-assigned-bus-id="<%= driver.assigned_bus_id || '' %>"
              data-assigned-route-id="<%= driverRouteId %>"
              data-schedule-days="<%= driverDays.join(',') %>"
              data-schedule-start-time="<%= driverScheduleStart || '' %>"
              data-schedule-end-time="<%= driverScheduleEnd || '' %>">Edit</button>
          </li>
        <% }) %>
      </ul>

      <div class="tm-modal" id="add-driver-modal" aria-hidden="true">
        <div class="tm-modal-card" role="dialog" aria-modal="true" aria-labelledby="add-driver-title">
          <div class="tm-modal-head">
            <h3 class="tm-modal-title" id="add-driver-title">Add driver</h3>
            <button class="tm-btn" type="button" id="close-add-driver-modal">Close</button>
          </div>

          <form id="add-driver-form" enctype="multipart/form-data">
            <input type="hidden" name="userId" id="driver-user-id-field" />
            <section class="tm-modal-sect">
              <h4>Driver</h4>
              <div class="tm-form-grid">
                <div class="tm-row"><label for="drv-first">First name</label><input id="drv-first" name="firstName" required autocomplete="given-name" /></div>
                <div class="tm-row"><label for="drv-last">Last name</label><input id="drv-last" name="lastName" required autocomplete="family-name" /></div>
                <div class="tm-row"><label for="drv-email">Email</label><input id="drv-email" name="email" type="email" required autocomplete="email" /></div>
                <div class="tm-row"><label>Phone</label>
                  <div class="phone-combo" data-default-iso2="GH">
                    <select class="phone-dial-select" aria-label="Country code"></select>
                    <input name="phone" class="phone-local-input" type="tel" autocomplete="tel" aria-label="Phone number" />
                  </div>
                </div>
                <div class="tm-row"><label for="drv-license">License number</label><input id="drv-license" name="licenseNumber" /></div>
                <div class="tm-row"><label for="drv-status">Status</label><select id="drv-status" name="status"><option value="active">Active</option><option value="inactive">Inactive</option></select></div>
                <div class="tm-row"><label for="drv-photo">Photo (optional)</label><input id="drv-photo" name="driverImage" type="file" accept="image/*" /></div>
              </div>
              <p class="tm-map-note" id="add-driver-note">New drivers get an email invite to set a password. They can only sign in to the driver screen.</p>
            </section>

            <section class="tm-modal-sect">
              <h4>Bus, route and weekly days</h4>
              <div class="tm-form-grid">
                <div class="tm-row"><label for="driver-bus-select">Bus</label>
                  <select id="driver-bus-select" name="assignedBusId"><option value="">No bus yet</option><% (buses || []).forEach(function (bus) { %><option value="<%= bus.bus_id %>"><%= bus.bus_number %><%= bus.bus_name ? ' (' + bus.bus_name + ')' : '' %></option><% }) %></select>
                </div>
                <div class="tm-row"><label for="driver-route-select">Route</label>
                  <select id="driver-route-select" name="assignedRouteId"><option value="">No route yet</option><% (routes || []).forEach(function (route) { %><option value="<%= route.route_id %>"><%= route.route_name %></option><% }) %></select>
                </div>
              </div>
              <p class="tm-map-note" style="margin-top:12px;">Days this driver runs the route</p>
              <div class="tm-days">
                <% driverDayList.forEach(function (day) { %>
                  <label><input type="checkbox" name="scheduleDays" value="<%= day %>" /><span><%= driverDayShort[day] %></span></label>
                <% }) %>
              </div>
              <div class="tm-form-grid">
                <div class="tm-row"><label for="drv-start-time">Start time</label><input id="drv-start-time" type="time" name="scheduleStartTime" /></div>
                <div class="tm-row"><label for="drv-end-time">End time</label><input id="drv-end-time" type="time" name="scheduleEndTime" /></div>
              </div>
            </section>

            <div class="tm-modal-foot">
              <button type="button" class="tm-btn tm-btn--danger" data-modal-delete="driver" hidden>Remove driver</button>
              <span id="add-driver-feedback" class="tm-map-note" role="status"></span>
              <button class="tm-btn tm-btn--primary" type="submit" id="submit-add-driver">Save driver</button>
            </div>
          </form>
        </div>
      </div>
    </section>

    <section class="tm-pane" data-pane-id="buses">
      <div class="tm-head">
        <h2>Buses</h2>
      </div>

      <div class="tm-grid">
        <article class="tm-card span-12">
          <div class="tm-card-head">
          <details>
            <summary class="tm-card-summary"><h3>Buses <span class="tm-count"><%= (buses || []).length %></span></h3></summary>
          <ul class="tm-list" id="bus-list">
            <% (buses || []).forEach(function(bus) { %>
              <li class="tm-item">
                <div class="tm-item-main">
                  <div class="tm-item-title">
                    <strong><%= bus.bus_number %></strong><% if (bus.bus_name) { %><span><%= bus.bus_name %></span><% } %>
                    <span class="tm-chip<%= ['active','in_service','on_trip'].includes(String(bus.status || 'active')) ? ' is-on' : '' %>"><%= String(bus.status || 'active').replace(/_/g, ' ') %></span>
                  </div>
                  <div class="tm-item-meta"><%= [bus.driver_user_id ? 'Driver ' + [bus.first_name, bus.last_name].filter(Boolean).join(' ') : 'No driver', bus.license_plate, bus.capacity ? bus.capacity + ' seats' : ''].filter(Boolean).join(', ') %></div>
                  <% const vehicleDetails = [bus.vehicle_year, bus.vehicle_make, bus.vehicle_model, bus.vehicle_color].filter(Boolean).join(' '); %>
                  <% if (vehicleDetails) { %><div class="tm-item-meta"><%= vehicleDetails %></div><% } %>
                </div>
                <button class="tm-btn tm-actions-item tm-edit" type="button" data-action="edit-bus"
                  data-bus-id="<%= bus.bus_id %>"
                  data-bus-number="<%= bus.bus_number || '' %>"
                  data-bus-name="<%= bus.bus_name || '' %>"
                  data-license-plate="<%= bus.license_plate || '' %>"
                  data-capacity="<%= bus.capacity || '' %>"
                  data-driver-user-id="<%= bus.driver_user_id || '' %>"
                  data-status="<%= bus.status || 'active' %>"
                  data-vehicle-make="<%= bus.vehicle_make || '' %>"
                  data-vehicle-model="<%= bus.vehicle_model || '' %>"
                  data-vehicle-year="<%= bus.vehicle_year || '' %>"
                  data-vehicle-color="<%= bus.vehicle_color || '' %>"
                  data-vin="<%= bus.vin || '' %>"
                  data-fuel-type="<%= bus.fuel_type || '' %>"
                  data-odometer="<%= bus.odometer || '' %>">Edit</button>
              </li>
            <% }) %>
          </ul>
          </details>
          <button class="tm-btn tm-btn--primary" type="button" id="open-add-bus-modal">+ Add Bus</button>
          </div>
        </article>

        <article class="tm-card span-12">
          <div class="tm-card-head">
          <details>
            <summary class="tm-card-summary"><h3>Routes <span class="tm-count"><%= (routes || []).length %></span></h3></summary>
          <p class="tm-map-note">Expand a route to see its stops, driver, bus, and schedule in one place.</p>
          <ul class="tm-list">
            <% (routes || []).forEach(function(route) { %>
              <% const routeStops = (stops || []).filter(function(s) { return Number(s.route_id) === Number(route.route_id); }).sort(function(a,b){ return (a.stop_order||0)-(b.stop_order||0); }); %>
              <% const routeSchedules = (schedules || []).filter(function(s) { return Number(s.route_id) === Number(route.route_id); }); %>
              <% const routeBusIds = Array.from(new Set(routeSchedules.map(function(s) { return s.bus_id; }).filter(Boolean))); %>
              <% const routeBuses = (buses || []).filter(function(b) { return routeBusIds.includes(b.bus_id); }); %>
              <li>
                <details class="tm-class-group">
                  <summary>
                    <strong><%= route.route_name %></strong>
                    <span class="tm-map-note">Code: <%= route.route_code || '-' %> · <%= route.route_status || 'active' %> · <%= routeStops.length %> stop<%= routeStops.length === 1 ? '' : 's' %> · <%= routeBuses.length %> bus<%= routeBuses.length === 1 ? '' : 'es' %></span>
                  </summary>
                  <div class="tm-class-toolbar">
                    <button class="tm-btn tm-actions-item" type="button" data-action="view-route-map" data-route-id="<%= route.route_id %>">Show on map</button>
                    <button class="tm-btn tm-actions-item" type="button" data-action="edit-route"
                      data-route-id="<%= route.route_id %>"
                      data-route-name="<%= route.route_name || '' %>"
                      data-route-code="<%= route.route_code || '' %>"
                      data-route-status="<%= route.route_status || 'active' %>"
                      data-map-provider="<%= route.map_provider || 'openstreetmap' %>"
                      data-use-school-destination="<%= route.use_school_destination ? '1' : '0' %>"
                      data-destination-address="<%= route.destination_address || '' %>"
                      data-stop-ids="<%= routeStops.map(function(s) { return s.stop_id; }).join(',') %>">Edit
                    </button>
                  </div>

                  <div class="tm-class-group-list">
                    <div class="tm-student-row">
                      <div class="tm-student-main" style="align-items:flex-start;">
                        <div>
                          <strong>Destination</strong>
                          <div class="tm-map-note"><%= route.use_school_destination ? 'School Destination' : 'Custom Destination' %> — <%= route.destination_address || schoolAddress || '-' %></div>
                        </div>
                      </div>
                    </div>

                    <div class="tm-student-row">
                      <div class="tm-student-main" style="align-items:flex-start;">
                        <div style="width:100%;">
                          <strong>Stops (in order)</strong>
                          <% if (!routeStops.length) { %>
                            <div class="tm-map-note">No stops attached yet — add some from Edit Route &amp; Stops above.</div>
                          <% } else { %>
                            <ol style="margin:6px 0 0; padding-left:18px; font-size:12px; color:#334155;">
                              <% routeStops.forEach(function(stop) { %>
                                <li><%= stop.stop_name %><% if (stop.stop_address) { %> — <span class="tm-map-note"><%= stop.stop_address %></span><% } %></li>
                              <% }) %>
                            </ol>
                          <% } %>
                        </div>
                      </div>
                    </div>

                    <div class="tm-student-row">
                      <div class="tm-student-main" style="align-items:flex-start;">
                        <div style="width:100%;">
                          <strong>Bus, Driver &amp; Schedule</strong>
                          <% if (!routeBuses.length) { %>
                            <div class="tm-map-note">No driver runs this route yet. Pick it in a driver’s form under Drivers.</div>
                          <% } else { %>
                            <% routeBuses.forEach(function(bus) { %>
                              <% const busSchedules = routeSchedules.filter(function(s) { return s.bus_id === bus.bus_id; }); %>
                              <% const days = busSchedules.map(function(s) { return (s.day_of_week || '').slice(0,3); }).join(', '); %>
                              <div class="tm-map-note" style="margin-top:4px;">
                                🚌 <%= bus.bus_number %> · Driver: <%= bus.driver_user_id ? [bus.first_name, bus.last_name].filter(Boolean).join(' ') : 'Unassigned' %> · <%= days || '-' %>
                              </div>
                            <% }) %>
                          <% } %>
                        </div>
                      </div>
                    </div>
                  </div>
                </details>
              </li>
            <% }) %>
          </ul>
          </details>
          <button class="tm-btn tm-btn--primary" type="button" id="open-add-route-modal">+ Add Route</button>
          </div>
        </article>

        <article class="tm-card span-12">
          <div class="tm-card-head">
          <details>
            <summary class="tm-card-summary"><h3>Stops <span class="tm-count"><%= (stops || []).length %></span></h3></summary>
          <p class="tm-map-note">Stops are a shared pool — attach them to a route from the Route List (Edit &rarr; Stops on this Route).</p>
          <ul class="tm-list">
            <% const routeNameById = Object.fromEntries((routes || []).map(function(r) { return [Number(r.route_id), r.route_name]; })); %>
            <% (stops || []).forEach(function(stop) { %>
              <li class="tm-item">
                <div class="tm-item-main">
                  <div class="tm-item-title">
                    <strong><%= stop.stop_name %></strong>
                    <% if (!stop.latitude || !stop.longitude) { %><span class="tm-chip is-warn">Not on map</span><% } %>
                  </div>
                  <div class="tm-item-meta"><%= [stop.route_id ? (routeNameById[Number(stop.route_id)] || 'Route #' + stop.route_id) + ', stop ' + (stop.stop_order || 0) : 'Not on a route', stop.stop_address].filter(Boolean).join(', ') %></div>
                </div>
                <button class="tm-btn tm-actions-item tm-edit" type="button" data-action="edit-stop"
                  data-stop-id="<%= stop.stop_id %>"
                  data-route-id="<%= stop.route_id || '' %>"
                  data-stop-name="<%= stop.stop_name || '' %>"
                  data-stop-address="<%= stop.stop_address || '' %>"
                  data-latitude="<%= stop.latitude || '' %>"
                  data-longitude="<%= stop.longitude || '' %>"
                  data-pickup-time="<%= stop.pickup_time || '' %>"
                  data-dropoff-time="<%= stop.dropoff_time || '' %>"
                  data-stop-order="<%= stop.stop_order || 0 %>">Edit</button>
              </li>
            <% }) %>
          </ul>
          </details>
          <div style="display:flex; gap:8px; flex-wrap:wrap;">
            <button class="tm-btn tm-btn--primary" type="button" id="open-import-city-stops-modal">+ Import City Stops</button>
            <button class="tm-btn tm-btn--primary" type="button" id="open-add-stop-modal">+ Add Stop</button>
          </div>
          </div>
        </article>
      </div>

      <div class="tm-modal" id="add-route-modal" aria-hidden="true">
        <div class="tm-modal-card" role="dialog" aria-modal="true" aria-labelledby="add-route-title">
          <div class="tm-modal-head">
            <h3 class="tm-modal-title" id="add-route-title">Add Route</h3>
            <button class="tm-btn" type="button" id="close-add-route-modal">Close</button>
          </div>

          <form id="add-route-form">
            <section class="tm-modal-sect">
              <div class="tm-form-grid">
                <div class="tm-row"><label>Route Name</label><input name="routeName" required /></div>
                <div class="tm-row"><label>Route Code</label><input name="routeCode" /></div>
                <div class="tm-row"><label>Status</label><select name="routeStatus"><option value="active">active</option><option value="inactive">inactive</option></select></div>
                <div class="tm-row"><label>Map Provider</label><select name="mapProvider"><% (mapProviders || []).forEach(function(provider) { %><option value="<%= provider %>"><%= provider %></option><% }) %></select></div>
                <div class="tm-row"><label><input type="checkbox" name="useSchoolDestination" value="1" checked /> Use School Destination</label></div>
                <div class="tm-row" data-custom-destination-row><label>Destination Address</label><input name="destinationAddress" placeholder="Type an address — the map location is found automatically" /></div>
              </div>
              <div class="tm-row" style="margin-top:8px;">
                <label>Stops on this Route</label>
                <div class="tm-checkbox-list" id="add-route-stops-list">
                  <% (stops || []).forEach(function(stop) { %>
                    <label class="tm-checkbox-list-item">
                      <input type="checkbox" name="stopIds" value="<%= stop.stop_id %>" />
                      <%= stop.stop_name %><% if (stop.route_id && stop.route_id != 0) { %> <span class="tm-map-note">(currently on another route)</span><% } %>
                    </label>
                  <% }) %>
                  <% if (!(stops || []).length) { %><p class="tm-map-note">No stops yet — add stops first, then attach them here.</p><% } %>
                </div>
              </div>
            </section>

            <div class="tm-toolbar" style="margin-top:10px;">
              <span id="add-route-feedback" class="tm-map-note"></span>
              <button class="tm-btn tm-btn--primary" type="submit" id="submit-add-route">Save Route</button>
            </div>
          </form>
        </div>
      </div>

      <div class="tm-modal" id="add-stop-modal" aria-hidden="true">
        <div class="tm-modal-card" role="dialog" aria-modal="true" aria-labelledby="add-stop-title">
          <div class="tm-modal-head">
            <h3 class="tm-modal-title" id="add-stop-title">Add Stop</h3>
            <button class="tm-btn" type="button" id="close-add-stop-modal">Close</button>
          </div>

          <form id="add-stop-form">
            <section class="tm-modal-sect">
              <div class="tm-form-grid">
                <div class="tm-row"><label>Route (optional)</label><select name="routeId"><option value="">No route yet — attach later</option><% (routes || []).forEach(function(route) { %><option value="<%= route.route_id %>"><%= route.route_name %></option><% }) %></select></div>
                <div class="tm-row"><label>Stop Name</label><input name="stopName" required /></div>
                <div class="tm-row"><label>Stop Address</label><input name="stopAddress" /></div>
                <div class="tm-row"><label>Latitude</label><input name="latitude" /></div>
                <div class="tm-row"><label>Longitude</label><input name="longitude" /></div>
                <div class="tm-row"><label>Pickup Time</label><input type="time" name="pickupTime" /></div>
                <div class="tm-row"><label>Dropoff Time</label><input type="time" name="dropoffTime" /></div>
                <div class="tm-row"><label>Stop Order</label><input name="stopOrder" type="number" min="0" /></div>
              </div>
              <p class="tm-map-note">Stops don't need a route right away — you can create a pool of stops and pick which ones belong to each route when you set up the route.</p>
              <p class="tm-map-note" id="add-stop-pin-hint">Click the map to pin this stop location.</p>
              <div id="add-stop-picker-map" class="tm-stop-picker-map"></div>
            </section>

            <div class="tm-toolbar" style="margin-top:10px;">
              <span id="add-stop-feedback" class="tm-map-note"></span>
              <button class="tm-btn tm-btn--primary" type="submit" id="submit-add-stop">Save Stop</button>
            </div>
          </form>
        </div>
      </div>

      <div class="tm-modal" id="import-city-stops-modal" aria-hidden="true">
        <div class="tm-modal-card" role="dialog" aria-modal="true" aria-labelledby="import-city-stops-title">
          <div class="tm-modal-head">
            <h3 class="tm-modal-title" id="import-city-stops-title">Import Stops By City</h3>
            <button class="tm-btn" type="button" id="close-import-city-stops-modal">Close</button>
          </div>

          <form id="import-city-stops-form">
            <section class="tm-modal-sect">
              <div class="tm-form-grid">
                <div class="tm-row"><label>Route</label><select name="routeId" required><option value="">Select Route</option><% (routes || []).forEach(function(route) { %><option value="<%= route.route_id %>"><%= route.route_name %></option><% }) %></select></div>
                <div class="tm-row"><label>City</label><input name="city" required placeholder="Salt Lake City" /></div>
                <div class="tm-row"><label>Max Stops</label><input name="maxStops" type="number" min="1" max="120" value="40" /></div>
              </div>
            </section>

            <div class="tm-toolbar" style="margin-top:10px;">
              <span id="import-city-stops-feedback" class="tm-map-note">Pulls bus stop candidates from map data, then you can edit/clean them.</span>
              <button class="tm-btn tm-btn--primary" type="submit" id="submit-import-city-stops">Import Stops</button>
            </div>
          </form>
        </div>
      </div>

      <div class="tm-modal" id="add-bus-modal" aria-hidden="true">
        <div class="tm-modal-card" role="dialog" aria-modal="true" aria-labelledby="add-bus-title">
          <div class="tm-modal-head">
            <h3 class="tm-modal-title" id="add-bus-title">Add Bus</h3>
            <button class="tm-btn" type="button" id="close-add-bus-modal">Close</button>
          </div>

          <form id="add-bus-form">
            <input type="hidden" name="busId" id="bus-id-field" />
            <input type="hidden" name="driverUserId" />
            <section class="tm-modal-sect">
              <h4>Basic Information</h4>
              <div class="tm-form-grid">
                <div class="tm-row"><label>Bus Number</label><input name="busNumber" required placeholder="BUS-001" /></div>
                <div class="tm-row"><label>Bus Name</label><input name="busName" placeholder="North Route Bus" /></div>
                <div class="tm-row"><label>Vehicle Registration / License Plate</label><input name="licensePlate" placeholder="ABC-1234" /></div>
                <div class="tm-row"><label>Capacity</label><input name="capacity" type="number" min="1" /></div>
                <div class="tm-row"><label>Status</label><select name="status"><option value="active">Active</option><option value="in_service">In Service</option><option value="maintenance">Maintenance</option><option value="out_of_service">Out of Service</option></select></div>
              </div>
              <p class="tm-map-note">Driver assignments are managed from the Drivers tab.</p>
            </section>

            <section class="tm-modal-sect">
              <h4>Vehicle Details</h4>
              <div class="tm-form-grid">
                <div class="tm-row"><label>Vehicle Make</label><input name="vehicleMake" placeholder="Ford" /></div>
                <div class="tm-row"><label>Model</label><input name="vehicleModel" placeholder="Transit" /></div>
                <div class="tm-row"><label>Year</label><input name="vehicleYear" type="number" min="1950" max="2100" /></div>
                <div class="tm-row"><label>Color</label><input name="vehicleColor" placeholder="Yellow" /></div>
                <div class="tm-row"><label>VIN</label><input name="vin" /></div>
                <div class="tm-row"><label>Fuel Type</label><select name="fuelType"><option value="">Select</option><option value="diesel">Diesel</option><option value="petrol">Petrol</option><option value="electric">Electric</option><option value="hybrid">Hybrid</option><option value="cng">CNG</option></select></div>
                <div class="tm-row"><label>Odometer</label><input name="odometer" type="number" min="0" step="0.1" /></div>
              </div>
            </section>

            <div class="tm-modal-foot">
              <button type="button" class="tm-btn tm-btn--danger" data-modal-delete="bus" hidden>Delete bus</button>
              <span id="add-bus-feedback" class="tm-map-note" role="status"></span>
              <button class="tm-btn tm-btn--primary" type="submit" id="submit-add-bus">Save Bus</button>
            </div>
          </form>
        </div>
      </div>
    </section>

    <section class="tm-pane" data-pane-id="schedule">
      <div class="tm-head"><h2>Schedule</h2></div>
      <p class="tm-map-note" style="margin-top:-4px;">Weekly days come from each driver’s form. Tap a day below to change just that day.</p>

      <div class="tm-grid">
        <article class="tm-card span-12">
          <h3>Schedule List</h3>
          <p class="tm-map-note">Grouped by start time — expand a time to see every bus running then, its driver, route, and days.</p>
          <%
            const dayAbbrev = { monday: 'Mon', tuesday: 'Tue', wednesday: 'Wed', thursday: 'Thu', friday: 'Fri', saturday: 'Sat', sunday: 'Sun' };
            const dayOrder = ['monday','tuesday','wednesday','thursday','friday','saturday','sunday'];
            const formatTime = function(t) {
              if (!t) return '-';
              const parts = String(t).split(':');
              let hour = parseInt(parts[0], 10);
              const minute = parts[1] || '00';
              const suffix = hour >= 12 ? 'PM' : 'AM';
              hour = hour % 12; if (hour === 0) hour = 12;
              return hour + ':' + minute + ' ' + suffix;
            };
            const timeGroups = {};
            (schedules || []).forEach(function(schedule) {
              const timeKey = (schedule.start_time || '-') + '|' + (schedule.end_time || '-');
              if (!timeGroups[timeKey]) {
                timeGroups[timeKey] = { startTime: schedule.start_time, endTime: schedule.end_time, buses: {} };
              }
              const busKey = String(schedule.bus_id || 'none');
              if (!timeGroups[timeKey].buses[busKey]) {
                timeGroups[timeKey].buses[busKey] = {
                  busNumber: schedule.bus_number || '-',
                  driverName: schedule.driver_name || 'Unassigned',
                  routeName: schedule.route_name || '-',
                  entries: [],
                };
              }
              timeGroups[timeKey].buses[busKey].entries.push(schedule);
            });
            const sortedTimeKeys = Object.keys(timeGroups).sort(function(a, b) {
              return (timeGroups[a].startTime || '').localeCompare(timeGroups[b].startTime || '');
            });
          %>
          <% if (!sortedTimeKeys.length) { %>
            <p class="tm-map-note">No driver schedules have been configured yet.</p>
          <% } %>
          <% sortedTimeKeys.forEach(function(timeKey) { %>
            <% const group = timeGroups[timeKey]; const busKeys = Object.keys(group.buses); %>
            <details class="tm-class-group">
              <summary>🕐 <%= formatTime(group.startTime) %> – <%= formatTime(group.endTime) %> (<%= busKeys.length %> bus<%= busKeys.length === 1 ? '' : 'es' %>)</summary>
              <div class="tm-class-group-list">
                <% busKeys.forEach(function(busKey) { %>
                  <% const busGroup = group.buses[busKey]; %>
                  <div class="tm-student-row">
                    <div class="tm-student-main" style="align-items:flex-start;">
                      <div>
                        <strong><%= busGroup.busNumber %></strong>
                        <span class="tm-map-note">Driver: <%= busGroup.driverName %> · Route: <%= busGroup.routeName %></span>
                        <div style="margin-top:6px; display:flex; gap:6px; flex-wrap:wrap;">
                          <% busGroup.entries.slice().sort(function(a,b){ return dayOrder.indexOf(a.day_of_week) - dayOrder.indexOf(b.day_of_week); }).forEach(function(entry) { %>
                            <span class="tm-badge tm-actions-item" title="<%= String(entry.status || '').replaceAll('_',' ') %>" style="cursor:pointer;"
                              data-action="edit-schedule"
                              data-schedule-id="<%= entry.schedule_id %>"
                              data-bus-id="<%= entry.bus_id || '' %>"
                              data-driver-id="<%= entry.driver_id || '' %>"
                              data-route-id="<%= entry.route_id || '' %>"
                              data-day-of-week="<%= entry.day_of_week || 'monday' %>"
                              data-start-time="<%= entry.start_time || '' %>"
                              data-end-time="<%= entry.end_time || '' %>"
                              data-status="<%= entry.status || 'active' %>"
                              data-notes="<%= entry.notes || '' %>">
                              <%= dayAbbrev[entry.day_of_week] || entry.day_of_week %><% if (entry.status === 'inactive') { %> (off)<% } %>
                            </span>
                          <% }) %>
                        </div>
                      </div>
                      <button class="tm-btn" type="button" data-action="delete-schedule-group"
                        data-schedule-ids="<%= busGroup.entries.map(function(e) { return e.schedule_id; }).join(',') %>"
                        style="margin-left:auto;">Delete All</button>
                    </div>
                  </div>
                <% }) %>
              </div>
            </details>
          <% }) %>
        </article>
      </div>

      <div class="tm-modal" id="add-schedule-modal" aria-hidden="true">
        <div class="tm-modal-card" role="dialog" aria-modal="true" aria-labelledby="add-schedule-title">
          <div class="tm-modal-head">
            <h3 class="tm-modal-title" id="add-schedule-title">Edit Schedule</h3>
            <button class="tm-btn" type="button" id="close-add-schedule-modal">Close</button>
          </div>

          <form id="add-schedule-form">
            <input type="hidden" name="scheduleId" id="schedule-id-field" />
            <section class="tm-modal-sect">
              <h4>Assignment</h4>
              <div class="tm-form-grid">
                <div class="tm-row"><label>Bus</label><select name="busId" required id="schedule-bus-select"><option value="">Select Bus</option><% (buses || []).forEach(function(bus) { %><option value="<%= bus.bus_id %>"><%= bus.bus_number %></option><% }) %></select></div>
                <div class="tm-row">
                  <label>Driver</label>
                  <input type="text" id="schedule-driver-display" readonly placeholder="Auto-filled from the bus's assigned driver" />
                  <input type="hidden" name="driverId" id="schedule-driver-id" />
                </div>
                <div class="tm-row"><label>Route</label><select name="routeId" id="schedule-route-select"><option value="">Select Route</option><% (routes || []).forEach(function(route) { %><option value="<%= route.route_id %>"><%= route.route_name %></option><% }) %></select></div>
                <div class="tm-row"><label>Day</label><select name="dayOfWeek"><option value="monday">Monday</option><option value="tuesday">Tuesday</option><option value="wednesday">Wednesday</option><option value="thursday">Thursday</option><option value="friday">Friday</option><option value="saturday">Saturday</option><option value="sunday">Sunday</option></select></div>
                <div class="tm-row"><label>Start Time</label><input type="time" name="startTime" /></div>
                <div class="tm-row"><label>End Time</label><input type="time" name="endTime" /></div>
                <div class="tm-row" id="schedule-status-row" style="display:none;"><label>Status</label><select name="status"><option value="active">Active</option><option value="inactive">Inactive</option></select></div>
                <div class="tm-row"><label>Notes (optional)</label><input name="notes" /></div>
              </div>
              <p class="tm-map-note" id="schedule-route-warning" style="display:none; color:#b45309; font-weight:600;"></p>
            </section>

            <div class="tm-toolbar" style="margin-top:10px;">
              <span id="add-schedule-feedback" class="tm-map-note"></span>
              <button class="tm-btn tm-btn--primary" type="submit" id="submit-add-schedule">Save Schedule</button>
            </div>
          </form>
        </div>
      </div>
    </section>

    <section class="tm-pane" data-pane-id="settings">
      <div class="tm-head">
        <h2>Settings</h2>
      </div>

      <article class="tm-card" style="margin-bottom:12px;">
        <label class="tm-switch"><span>Parents confirm arrival</span><input type="checkbox" id="tm-parent-confirm"<%= locals.parentConfirmArrival ? ' checked' : '' %> /><i aria-hidden="true"></i></label>
        <p class="tm-map-note" style="margin:6px 0 0;">After the driver's arrival check, parents confirm in their portal that their child arrived. A "not arrived" goes straight to Reports.</p>
        <p class="tm-map-note" id="tm-parent-confirm-note" role="status" style="margin:4px 0 0;"></p>
      </article>

      <div class="tm-settings-stack"<%= transportAccess.settings ? '' : ' hidden' %>>
        <article class="tm-card">
          <details>
            <summary class="tm-card-summary"><h3>Map</h3></summary>
            <div class="tm-map-toolbar">
              <input id="tm-city-input" type="text" placeholder="Enter city (e.g. Salt Lake City)" />
              <button id="tm-center-city" type="button">Center City</button>
              <button id="tm-fit-stops" type="button">Fit Bus Stops</button>
            </div>
            <p class="tm-map-note" id="tm-map-status">Map is centered on available stop coordinates.</p>
          </details>
        </article>

        <article class="tm-card">
          <details>
            <summary class="tm-card-summary"><h3>School location</h3></summary>
            <p class="tm-map-note">This is the final destination for school-linked routes. Just type the address — the map location is found automatically.</p>
            <form method="POST" action="/transportation/manage/school-destination">
              <div class="tm-form-grid">
                <div class="tm-row">
                  <label for="schoolAddress">School Address</label>
                  <input id="schoolAddress" name="schoolAddress" required value="<%= schoolAddress || '' %>" placeholder="1746 W 400 N, Salt Lake City, UT" />
                </div>
                <div class="tm-row">
                  <label><input type="checkbox" name="applyToSchoolRoutes" value="1" checked /> Apply to all routes now</label>
                </div>
              </div>
              <button type="submit" class="tm-btn tm-btn--primary" style="margin-top:10px;">Save School Destination</button>
            </form>
          </details>
        </article>

        <article class="tm-card">
          <details>
            <summary class="tm-card-summary"><h3>Units</h3></summary>
            <p class="tm-map-note">Controls how distances and speeds are shown to drivers and on live maps.</p>
            <form method="POST" action="/transportation/manage/units">
              <div class="tm-form-grid">
                <div class="tm-row">
                  <label for="distanceUnit">Units</label>
                  <select id="distanceUnit" name="distanceUnit">
                    <option value="km" <%= (distanceUnit || 'km') === 'km' ? 'selected' : '' %>>Kilometers (km, km/h)</option>
                    <option value="mi" <%= distanceUnit === 'mi' ? 'selected' : '' %>>Miles (mi, mph)</option>
                  </select>
                </div>
              </div>
              <button type="submit" class="tm-btn tm-btn--primary" style="margin-top:10px;">Save Units</button>
            </form>
          </details>
        </article>
      </div>

      <div class="tm-modal" id="edit-route-modal" aria-hidden="true">
        <div class="tm-modal-card" role="dialog" aria-modal="true" aria-labelledby="edit-route-title">
          <div class="tm-modal-head">
            <h3 class="tm-modal-title" id="edit-route-title">Edit Route</h3>
            <button class="tm-btn" type="button" id="close-edit-route-modal">Close</button>
          </div>

          <form id="edit-route-form">
            <input type="hidden" name="routeId" id="edit-route-id" />
            <section class="tm-modal-sect">
              <div class="tm-form-grid">
                <div class="tm-row"><label>Route Name</label><input name="routeName" required /></div>
                <div class="tm-row"><label>Route Code</label><input name="routeCode" /></div>
                <div class="tm-row"><label>Status</label><select name="routeStatus"><option value="active">active</option><option value="inactive">inactive</option></select></div>
                <div class="tm-row"><label>Map Provider</label><select name="mapProvider"><% (mapProviders || []).forEach(function(provider) { %><option value="<%= provider %>"><%= provider %></option><% }) %></select></div>
                <div class="tm-row"><label><input type="checkbox" name="useSchoolDestination" value="1" checked /> Use School Destination</label></div>
                <div class="tm-row" data-custom-destination-row><label>Destination Address</label><input name="destinationAddress" placeholder="Type an address — the map location is found automatically" /></div>
              </div>
              <div class="tm-row" style="margin-top:8px;">
                <label>Stops on this Route</label>
                <div class="tm-checkbox-list" id="edit-route-stops-list">
                  <% (stops || []).forEach(function(stop) { %>
                    <label class="tm-checkbox-list-item">
                      <input type="checkbox" name="stopIds" value="<%= stop.stop_id %>" data-stop-route-id="<%= stop.route_id || '' %>" />
                      <%= stop.stop_name %>
                    </label>
                  <% }) %>
                  <% if (!(stops || []).length) { %><p class="tm-map-note">No stops yet — add stops first, then attach them here.</p><% } %>
                </div>
              </div>
            </section>

            <div class="tm-modal-foot">
              <button type="button" class="tm-btn tm-btn--danger" data-modal-delete="route" hidden>Delete route</button>
              <span id="edit-route-feedback" class="tm-map-note" role="status"></span>
              <button class="tm-btn tm-btn--primary" type="submit" id="submit-edit-route">Save Changes</button>
            </div>
          </form>
        </div>
      </div>

      <div class="tm-modal" id="edit-stop-modal" aria-hidden="true">
        <div class="tm-modal-card" role="dialog" aria-modal="true" aria-labelledby="edit-stop-title">
          <div class="tm-modal-head">
            <h3 class="tm-modal-title" id="edit-stop-title">Edit Stop</h3>
            <button class="tm-btn" type="button" id="close-edit-stop-modal">Close</button>
          </div>

          <form id="edit-stop-form">
            <input type="hidden" name="stopId" id="edit-stop-id" />
            <section class="tm-modal-sect">
              <div class="tm-form-grid">
                <div class="tm-row"><label>Route (optional)</label><select name="routeId"><option value="">No route yet — attach later</option><% (routes || []).forEach(function(route) { %><option value="<%= route.route_id %>"><%= route.route_name %></option><% }) %></select></div>
                <div class="tm-row"><label>Stop Name</label><input name="stopName" required /></div>
                <div class="tm-row"><label>Stop Address</label><input name="stopAddress" /></div>
                <div class="tm-row"><label>Latitude</label><input name="latitude" /></div>
                <div class="tm-row"><label>Longitude</label><input name="longitude" /></div>
                <div class="tm-row"><label>Pickup Time</label><input type="time" name="pickupTime" /></div>
                <div class="tm-row"><label>Dropoff Time</label><input type="time" name="dropoffTime" /></div>
                <div class="tm-row"><label>Stop Order</label><input name="stopOrder" type="number" min="0" /></div>
              </div>
              <p class="tm-map-note" id="edit-stop-pin-hint">Click the map to update this stop location.</p>
              <div id="edit-stop-picker-map" class="tm-stop-picker-map"></div>
            </section>

            <div class="tm-modal-foot">
              <button type="button" class="tm-btn tm-btn--danger" data-modal-delete="stop" hidden>Delete stop</button>
              <span id="edit-stop-feedback" class="tm-map-note" role="status"></span>
              <button class="tm-btn tm-btn--primary" type="submit" id="submit-edit-stop">Save Changes</button>
            </div>
          </form>
        </div>
      </div>
    </section>

    <section class="tm-pane ws-root" data-pane-id="requests">
      <header class="ws-head">
        <div class="ws-head__text">
          <h1 class="ws-head__title">Requests</h1>
          <p class="ws-head__sub">Bus requests from parents and teachers. Select one to answer it.</p>
        </div>
        <div class="tm-segment" role="tablist" aria-label="Requests">
          <button type="button" class="is-on" role="tab" aria-selected="true" data-request-bucket="new">New <span class="tm-nav-badge" id="tm-requests-tab-count" hidden></span></button>
          <button type="button" role="tab" aria-selected="false" data-request-bucket="old">Old</button>
        </div>
      </header>
      <input type="search" class="tm-list-search" data-search-list="tm-requests-list" placeholder="Search by student, class or route" autocomplete="off" aria-label="Search requests" />
      <div class="ws-cards-wrap" id="tm-requests-list" aria-live="polite"></div>
    </section>

    <section class="tm-pane ws-root" data-pane-id="reports">
      <header class="ws-head">
        <div class="ws-head__text">
          <h1 class="ws-head__title">Reports</h1>
          <p class="ws-head__sub">What drivers send you, and each trip's arrival check. You choose who else sees a report.</p>
        </div>
        <div class="tm-segment" role="tablist" aria-label="Reports">
          <button type="button" class="is-on" role="tab" aria-selected="true" data-report-bucket="new">New <span class="tm-nav-badge" id="tm-reports-tab-count" hidden></span></button>
          <button type="button" role="tab" aria-selected="false" data-report-bucket="old">Old</button>
          <button type="button" role="tab" aria-selected="false" data-report-bucket="arrivals">Arrivals</button>
        </div>
      </header>
      <input type="search" class="tm-list-search" data-search-list="tm-reports-list" placeholder="Search by student, driver or issue" autocomplete="off" aria-label="Search reports" />
      <div class="ws-cards-wrap" id="tm-reports-list" aria-live="polite"></div>
    </section>

    <section class="tm-pane ws-root" data-pane-id="students">
      <%
        const accessByStudent = new Set((assignments || []).map(function (a) { return Number(a.student_id); }));
        const studentRows = (students || []).map(function (student) {
          return {
            id: student.student_id,
            name: [student.first_name, student.last_name].filter(Boolean).join(' ').trim(),
            sortName: [student.last_name, student.first_name].filter(Boolean).join(' ').toLowerCase(),
            classId: student.class_id ? String(student.class_id) : '__unassigned__',
            className: String(student.class_name || '').trim() || 'No class',
            access: accessByStudent.has(Number(student.student_id)),
          };
        }).sort(function (a, b) { return a.sortName.localeCompare(b.sortName); });
        const studentClasses = Array.from(new Map(studentRows.map(function (row) { return [row.classId, row.className]; })).entries())
          .sort(function (a, b) { return a[1].localeCompare(b[1]); });
      %>
      <header class="ws-head">
        <div class="ws-head__text">
          <h1 class="ws-head__title">Students</h1>
          <p class="ws-head__sub">Select a student to manage their bus.</p>
        </div>
      </header>
      <div class="ux-layout">
        <aside class="ux-filters" aria-label="Filter students">
          <div class="ux-filters__head">
            <strong>Filters</strong>
            <button type="button" class="ux-link" id="tm-filters-clear">Clear</button>
          </div>
          <label class="ux-field"><span>Name</span><input type="search" id="tm-filter-name" placeholder="Find by name" autocomplete="off" /></label>
          <label class="ux-field"><span>Class</span>
            <select id="tm-filter-class"><option value="">All classes</option><% studentClasses.forEach(function (klass) { %><option value="<%= klass[0] %>"><%= klass[1] %></option><% }) %></select>
          </label>
          <label class="ux-field"><span>Bus access</span>
            <select id="tm-filter-access"><option value="">Everyone</option><option value="yes">Bus access</option><option value="no">No bus access</option></select>
          </label>
          <p class="ux-shown" id="tm-students-shown" aria-live="polite"></p>
          <div class="tm-class-tools" id="tm-class-tools" hidden>
            <button type="button" class="ws-btn ws-btn--sm" id="tm-class-edit"<%= transportAccess.riderList ? '' : ' hidden' %>>Edit class access</button>
            <button type="button" class="ws-btn ws-btn--sm ws-btn--primary" id="tm-class-save" hidden>Save</button>
            <button type="button" class="ws-btn ws-btn--sm" id="tm-class-cancel" hidden>Cancel</button>
            <% if (canBroadcastToGuardians) { %><button type="button" class="ws-btn ws-btn--sm notify-guardians-btn" id="tm-class-notify" data-context="transportation" data-context-id="" hidden>Notify guardians</button><% } %>
            <p id="tm-class-note" role="status"></p>
          </div>
        </aside>
        <div class="ws-cards-wrap">
          <table class="ws-cards" id="tm-students-table">
            <thead><tr><th class="tm-check-cell"></th><th>Name</th><th class="tm-col-access">Bus access</th></tr></thead>
            <tbody>
              <% studentRows.forEach(function (row) { %>
              <tr class="ux-row" tabindex="0" data-student-id="<%= row.id %>" data-name="<%= row.name.toLowerCase() %>" data-class-id="<%= row.classId %>" data-access="<%= row.access ? 'yes' : 'no' %>">
                <td class="tm-check-cell"><input type="checkbox" aria-label="Bus access for <%= row.name %>"<%= row.access ? ' checked' : '' %> /></td>
                <td data-label="Name" class="ws-card-title"><strong data-name><%= row.name %></strong></td>
                <td data-label="Bus access"><span data-access-pill class="ws-pill <%= row.access ? 'ws-pill--green' : 'tm-pill--none' %>"><%= row.access ? 'Bus access' : 'No bus access' %></span></td>
              </tr>
              <% }) %>
            </tbody>
          </table>
          <p class="ux-empty" id="tm-students-empty" hidden>No students match these filters.</p>
        </div>
      </div>
    </section>
  </main>
</div>

<div class="ux-panel-backdrop" id="tm-panel-backdrop" hidden></div>
<aside class="ux-panel" id="tm-panel" role="dialog" aria-modal="true" aria-labelledby="tm-panel-title" aria-hidden="true">
  <div class="ux-panel__bar">
    <strong id="tm-panel-title">Student</strong>
    <button type="button" class="ux-close" id="tm-panel-close" aria-label="Close"><svg width="18" height="18" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M15 5L5 15M5 5l10 10" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg></button>
  </div>
  <div class="ux-panel__body" id="tm-panel-body"></div>
</aside>
<script type="application/json" id="tm-people-data"><%- safeJson({
  unit: distanceUnit === 'mi' ? 'mi' : 'km',
  canRiderList: !!transportAccess.riderList,
  canStudentRoutes: !!transportAccess.studentRoutes,
  buses: (buses || []).map(function (b) { return { bus_id: b.bus_id, bus_number: b.bus_number }; }),
  routes: (routes || []).map(function (r) { return { route_id: r.route_id, route_name: r.route_name }; }),
  stops: (stops || []).map(function (st) { return { stop_id: st.stop_id, route_id: st.route_id, stop_name: st.stop_name }; }),
}) %></script>
<script src="<%= assetUrl('/js/transportPeople.js') %>" defer></script>

<script
  src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"
  integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo="
  crossorigin=""
></script>

<script src="/js/managiraMaps.js?v=<%= assetVersion %>"></script>
<script src="<%= assetUrl('/js/dialCodes.js') %>"></script>
<script>
  (function () {
    const navButtons = Array.from(document.querySelectorAll('.tm-nav-btn'));
    const panes = Array.from(document.querySelectorAll('.tm-pane'));

    function openPane(targetPane) {
      navButtons.forEach((btn) => btn.classList.toggle('active', btn.dataset.pane === targetPane));
      panes.forEach((pane) => pane.classList.toggle('active', pane.dataset.paneId === targetPane));
    }

    navButtons.forEach((btn) => {
      btn.addEventListener('click', () => openPane(btn.dataset.pane));
    });

    const tmNavToggle = document.getElementById('tm-nav-toggle');
    const tmNav = document.getElementById('tm-nav');
    if (tmNavToggle && tmNav) {
      tmNavToggle.addEventListener('click', () => {
        const isOpen = tmNav.classList.toggle('is-open');
        tmNavToggle.classList.toggle('active', isOpen);
        tmNavToggle.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
      });
      // Selecting a section on mobile closes the dropdown automatically.
      navButtons.forEach((btn) => {
        btn.addEventListener('click', () => {
          tmNav.classList.remove('is-open');
          tmNavToggle.classList.remove('active');
          tmNavToggle.setAttribute('aria-expanded', 'false');
        });
      });
    }

    const routes = <%- safeJson((routes || []).map((route) => ({
      routeId: Number(route.route_id),
      routeName: route.route_name || 'Route',
      useSchoolDestination: Boolean(route.use_school_destination),
      destinationAddress: route.destination_address || '',
      destinationLatitude: route.destination_latitude !== null && route.destination_latitude !== undefined ? Number(route.destination_latitude) : null,
      destinationLongitude: route.destination_longitude !== null && route.destination_longitude !== undefined ? Number(route.destination_longitude) : null,
    }))) %>;

    const stops = <%- safeJson((stops || []).map((stop) => ({
      stopId: Number(stop.stop_id),
      routeId: Number(stop.route_id),
      stopName: stop.stop_name || '',
      stopAddress: stop.stop_address || '',
      latitude: stop.latitude !== null && stop.latitude !== undefined ? Number(stop.latitude) : null,
      longitude: stop.longitude !== null && stop.longitude !== undefined ? Number(stop.longitude) : null,
      stopOrder: stop.stop_order !== null && stop.stop_order !== undefined ? Number(stop.stop_order) : 0,
    }))) %>;

    const busesForMap = <%- safeJson((buses || []).map((bus) => ({
      busId: Number(bus.bus_id),
      busNumber: bus.bus_number || '',
      busName: bus.bus_name || '',
      status: bus.status || 'active',
      driverUserId: bus.driver_user_id ? Number(bus.driver_user_id) : null,
      driverName: [bus.first_name, bus.last_name].filter(Boolean).join(' ') || null,
    }))) %>;

    // Driver assignments are managed in the Drivers pane; schedules inherit
    // the selected bus's current driver.
    const scheduleDriverByBusId = <%- safeJson((buses || []).reduce(function(map, bus) {
      if (!bus.driver_user_id) return map;
      const matchedDriver = (drivers || []).find(function(d) { return Number(d.user_id) === Number(bus.driver_user_id); });
      if (matchedDriver) {
        map[bus.bus_id] = {
          driverId: matchedDriver.driver_id,
          driverName: [matchedDriver.first_name, matchedDriver.last_name].filter(Boolean).join(' '),
        };
      }
      return map;
    }, {})) %>;

    const scheduleRouteUsage = <%- safeJson((schedules || []).map(function(s) {
      return { busId: s.bus_id, routeId: s.route_id, busNumber: s.bus_number || '' };
    })) %>;

    const schedulesForMap = <%- safeJson((schedules || []).map((schedule) => ({
      scheduleId: Number(schedule.schedule_id),
      busId: schedule.bus_id !== null && schedule.bus_id !== undefined ? Number(schedule.bus_id) : null,
      routeId: schedule.route_id !== null && schedule.route_id !== undefined ? Number(schedule.route_id) : null,
      driverName: schedule.driver_name || '',
      dayOfWeek: schedule.day_of_week || '',
      startTime: schedule.start_time || '',
      endTime: schedule.end_time || '',
      status: schedule.status || 'active',
    }))) %>;

    const mapStatus = document.getElementById('tm-map-status');
    const cityInput = document.getElementById('tm-city-input');
    const centerCityBtn = document.getElementById('tm-center-city');
    const fitStopsBtn = document.getElementById('tm-fit-stops');
    const routeFilterSelect = document.getElementById('tm-route-filter');
    const mapEl = document.getElementById('tm-route-map');
    const esc = (value) => String(value == null ? '' : value).replace(/[&<>"']/g, (character) => ({
      '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;',
    }[character]));

    if (!window.L || !mapEl || !mapStatus || !cityInput || !centerCityBtn || !fitStopsBtn) return;

    const routeNameById = Object.fromEntries(routes.map((r) => [r.routeId, r.routeName]));
    const routeMetaById = Object.fromEntries(routes.map((r) => [r.routeId, r]));
    const schoolDestination = {
      address: <%- safeJson(schoolAddress || '') %>,
      latitude: <%- safeJson(schoolLatitude !== null && schoolLatitude !== undefined ? Number(schoolLatitude) : null) %>,
      longitude: <%- safeJson(schoolLongitude !== null && schoolLongitude !== undefined ? Number(schoolLongitude) : null) %>,
    };
    const US_DEFAULT_CENTER = [39.8283, -98.5795];
    const mapDefaultCenter = (Number.isFinite(schoolDestination.latitude) && Number.isFinite(schoolDestination.longitude))
      ? [schoolDestination.latitude, schoolDestination.longitude]
      : US_DEFAULT_CENTER;
    const mapDefaultZoom = (Number.isFinite(schoolDestination.latitude) && Number.isFinite(schoolDestination.longitude)) ? 11 : 4;

    const colorForRoute = (routeId) => window.ManagiraMaps.routeColor(routeId);

    const roadGeometryCache = new Map();
    let drawRevision = 0;

    function makeRouteGeometryKey(latlngs) {
      return latlngs
        .map((entry) => `${Number(entry[0]).toFixed(5)},${Number(entry[1]).toFixed(5)}`)
        .join('|');
    }

    // Replaces the default +/- zoom buttons with a single "smart" locate
    // control: tap once to fly in on the device's actual GPS position (like
    // a normal map app's "my location" button), tap again to zoom back out
    // to wherever the map was before.
    function attachSmartMapControls(mapInstance, LeafletRef, options) {
      options = options || {};
      const overviewState = { center: mapInstance.getCenter(), zoom: mapInstance.getZoom() };
      let isZoomedIn = false;
      let myLocationMarker = null;

      const LocateControl = LeafletRef.Control.extend({
        options: { position: 'bottomleft' },
        onAdd: function () {
          const container = LeafletRef.DomUtil.create('div', 'leaflet-bar tm-locate-control');
          const button = LeafletRef.DomUtil.create('a', 'tm-locate-btn', container);
          button.href = '#';
          button.title = 'Zoom to my location';
          button.setAttribute('role', 'button');
          button.innerHTML = '<svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor"><path d="M12 2 L19 20 L12 16.5 L5 20 Z"/></svg>';
          LeafletRef.DomEvent.disableClickPropagation(container);
          LeafletRef.DomEvent.on(button, 'click', (event) => {
            LeafletRef.DomEvent.preventDefault(event);
            if (isZoomedIn) {
              mapInstance.flyTo(overviewState.center, overviewState.zoom);
              isZoomedIn = false;
              return;
            }
            overviewState.center = mapInstance.getCenter();
            overviewState.zoom = mapInstance.getZoom();

            if (!navigator.geolocation) {
              const target = typeof options.getLiveLatLng === 'function' ? options.getLiveLatLng() : null;
              mapInstance.flyTo(target || overviewState.center, 16);
              isZoomedIn = true;
              return;
            }

            button.classList.add('is-locating');
            navigator.geolocation.getCurrentPosition(
              (position) => {
                button.classList.remove('is-locating');
                const here = [position.coords.latitude, position.coords.longitude];
                if (myLocationMarker) myLocationMarker.remove();
                myLocationMarker = LeafletRef.marker(here, {
                  icon: LeafletRef.divIcon({
                    className: '',
                    html: '<div class="tm-my-location-dot"></div>',
                    iconSize: [16, 16],
                    iconAnchor: [8, 8],
                  }),
                }).addTo(mapInstance).bindPopup('You are here');
                mapInstance.flyTo(here, 16);
                isZoomedIn = true;
              },
              () => {
                button.classList.remove('is-locating');
                const target = typeof options.getLiveLatLng === 'function' ? options.getLiveLatLng() : null;
                mapInstance.flyTo(target || overviewState.center, 16);
                isZoomedIn = true;
              },
              { enableHighAccuracy: true, timeout: 8000 }
            );
          });
          return container;
        },
      });

      mapInstance.addControl(new LocateControl());
    }

    // Road-following geometry from the server (shared ManagiraMaps helper).
    // null = no road route available; nothing is drawn rather than a straight
    // line through buildings.
    async function fetchRoadGeometry(latlngs) {
      if (!Array.isArray(latlngs) || latlngs.length < 2) return null;
      const key = makeRouteGeometryKey(latlngs);
      if (roadGeometryCache.has(key)) return roadGeometryCache.get(key);
      const points = window.ManagiraMaps ? await window.ManagiraMaps.roadPoints(latlngs) : null;
      if (points) roadGeometryCache.set(key, points);
      return points;
    }

