    // A panel warming up out of sight draws nothing until it is actually shown.
    let tilesAdded = false;
    const addTilesWhenShown = () => {
      if (tilesAdded || !mapEl.offsetWidth) return;
      tilesAdded = true;
      window.ManagiraMaps.addTiles(map);
    };
    addTilesWhenShown();
