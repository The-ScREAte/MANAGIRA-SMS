<%- include('../partials/flash') %>

<link
  rel="stylesheet"
  href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
  integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY="
  crossorigin=""
/>

<style>
  :root {
    --tm-bg: #f3f7fb;
    --tm-surface: #ffffff;
    --tm-border: #d8e3ee;
    --tm-text: #0f172a;
    --tm-muted: #5f7085;
    --tm-accent: var(--org-primary-color, #0f5a66);
    --tm-accent-hover: var(--org-primary-hover, #0b4f59);
  }

  body {
    background: #f5f7fb;
  }

  .tm-app {
    width: 100%;
    max-width: none;
    margin: 0;
    padding: 20px 24px 24px;
    display: grid;
    grid-template-columns: 280px minmax(0, 1fr);
    gap: 16px;
    align-items: start;
  }

  .tm-sidebar {
    border: 1px solid var(--tm-border);
    border-radius: 16px;
    background: var(--tm-surface);
    box-shadow: 0 12px 30px rgba(15, 23, 42, 0.06);
    padding: 16px;
    position: sticky;
    top: 20px;
    height: fit-content;
  }

  .tm-brand {
    display: flex;
    gap: 0;
    align-items: center;
    justify-content: center;
    padding: 10px;
    margin-bottom: 14px;
  }

  .tm-logo {
    width: 120px;
    height: 120px;
    object-fit: contain;
    flex-shrink: 0;
  }

  .tm-nav-toggle {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 4px;
    width: 36px;
    height: 36px;
    border: 1px solid var(--tm-border);
    border-radius: 8px;
    background: #fff;
    cursor: pointer;
    padding: 0;
    align-items: center;
    flex-shrink: 0;
  }

  .tm-nav-toggle .bar {
    display: block;
    width: 18px;
    height: 2px;
    background: var(--tm-text);
    border-radius: 2px;
    transition: transform 0.15s ease, opacity 0.15s ease;
  }

  .tm-nav-toggle.active .bar:nth-child(1) { transform: translateY(6px) rotate(45deg); }
  .tm-nav-toggle.active .bar:nth-child(2) { opacity: 0; }
  .tm-nav-toggle.active .bar:nth-child(3) { transform: translateY(-6px) rotate(-45deg); }

  .tm-status {
    margin: 6px 6px 10px;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 5px 10px;
    border-radius: 999px;
    font-size: 11px;
    font-weight: 700;
    background: <%= integration && integration.activated ? '#dcfce7' : '#fef3c7' %>;
    color: <%= integration && integration.activated ? '#166534' : '#92400e' %>;
  }

  .tm-status-dot {
    width: 7px;
    height: 7px;
    border-radius: 999px;
    background: currentColor;
  }

  .tm-nav {
    display: grid;
    gap: 4px;
  }

  .tm-nav-btn {
    border: 1px solid transparent;
    border-radius: 10px;
    background: transparent;
    color: #1f2937;
    font-size: 14px;
    font-weight: 600;
    text-align: left;
    padding: 11px 12px;
    cursor: pointer;
    transition: none;
  }

  .tm-nav-btn:focus,
  .tm-nav-btn:focus-visible,
  .tm-nav-btn:active {
    outline: none;
    background: transparent;
    border-color: transparent;
  }

  .tm-nav-btn.active {
    background: #f8fbff;
    color: var(--tm-accent);
    border-color: #cfe0ee;
  }

  .tm-main {
    border: 1px solid var(--tm-border);
    border-radius: 16px;
    background: var(--tm-surface);
    box-shadow: 0 12px 30px rgba(15, 23, 42, 0.06);
    overflow: visible;
  }

  .tm-pane {
    display: none;
    padding: 20px;
  }

  .tm-pane.active {
    display: block;
  }

  .tm-head {
    margin-bottom: 12px;
  }

  .tm-head--split {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
  }

  .tm-head h2 {
    margin: 0;
    font-size: 24px;
    color: var(--tm-text);
  }

  .tm-stats {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: 10px;
    margin-bottom: 14px;
  }

  .tm-stat {
    border: 1px solid var(--tm-border);
    border-radius: 12px;
    background: #fbfdff;
    padding: 10px;
  }

  .tm-stat-k {
    margin: 0;
    font-size: 11px;
    color: var(--tm-muted);
    text-transform: uppercase;
    letter-spacing: .06em;
  }

  .tm-stat-v {
    margin: 3px 0 0;
    font-size: 21px;
    font-weight: 800;
    color: var(--tm-text);
  }

  .tm-grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: 12px;
  }

  .tm-card {
    border: 1px solid var(--tm-border);
    border-radius: 12px;
    background: #fff;
    padding: 14px;
    min-width: 0;
    overflow: visible;
  }

  .tm-toolbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    margin-bottom: 10px;
  }

  .tm-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 1px solid #c7d7e6;
    border-radius: 7px;
    padding: 5px 10px;
    background: #fff;
    color: #0f172a;
    font-size: 12px;
    font-weight: 600;
    line-height: 1.2;
    min-height: 30px;
    width: auto;
    cursor: pointer;
    text-decoration: none;
    white-space: nowrap;
  }

  .tm-btn--primary {
    background: linear-gradient(135deg, var(--tm-accent), #184a64);
    border-color: transparent;
    color: #fff;
  }

  .tm-modal {
    position: fixed;
    inset: 0;
    z-index: 1600;
    display: none;
    align-items: center;
    justify-content: center;
    padding: 16px;
    background: rgba(2, 10, 23, 0.45);
  }

  .tm-modal.is-open {
    display: flex;
  }

  .tm-modal-card {
    width: min(920px, 96vw);
    max-height: 90vh;
    overflow: auto;
    border-radius: 14px;
    border: 1px solid #d8e3ee;
    background: #fff;
    box-shadow: 0 24px 60px rgba(2, 10, 23, 0.26);
    padding: 14px;
  }

  .tm-modal-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    margin-bottom: 8px;
  }

  .tm-modal-title {
    margin: 0;
    font-size: 19px;
    color: #0f172a;
  }

  .tm-modal-sect {
    margin-top: 8px;
    border: 1px solid #e0e8f1;
    border-radius: 10px;
    padding: 10px;
    background: #fbfdff;
  }

  .tm-modal-sect h4 {
    margin: 0 0 8px;
    font-size: 14px;
    color: #0f172a;
  }

  .tm-card h3 {
    margin: 0 0 4px;
    font-size: 18px;
    color: var(--tm-text);
  }

  .span-12 { grid-column: span 12; }
  .span-8 { grid-column: span 8; }
  .span-6 { grid-column: span 6; }
  .span-4 { grid-column: span 4; }

  .tm-form-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 8px;
  }

  .tm-badge {
    display: inline-flex;
    align-items: center;
    padding: 3px 10px;
    border-radius: 999px;
    background: #eef2ff;
    color: #3730a3;
    font-size: 11px;
    font-weight: 600;
  }

  .tm-badge:hover {
    background: #e0e7ff;
  }

  .tm-checkbox-list {
    max-height: 180px;
    overflow-y: auto;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    padding: 8px 10px;
    display: grid;
    gap: 6px;
    background: #f8fafc;
  }

  .tm-checkbox-list-item {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 13px;
    font-weight: 400;
    color: #334155;
  }

  .tm-row {
    display: grid;
    gap: 5px;
  }

  .tm-row label {
    color: #334155;
    font-size: 12px;
    font-weight: 600;
  }

  .tm-row input,
  .tm-row select,
  .tm-row button {
    border: 1px solid #c7d7e6;
    border-radius: 8px;
    padding: 8px;
    font-size: 12px;
    background: #fff;
  }

  .tm-row input:focus,
  .tm-row select:focus {
    outline: none;
    border-color: #7fb1d6;
    box-shadow: 0 0 0 3px rgba(75, 144, 189, .15);
  }

  .tm-row button {
    background: linear-gradient(135deg, var(--tm-accent), #184a64);
    border-color: transparent;
    color: #fff;
    font-weight: 600;
    padding: 6px 10px;
    min-height: 32px;
    width: auto;
    cursor: pointer;
  }

  .tm-row button:hover {
    background: linear-gradient(135deg, var(--tm-accent-hover), #123e53);
  }

  .tm-list {
    margin: 10px 0 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 6px;
    max-height: none;
    overflow: visible;
  }

  .tm-list li {
    border: 1px solid #dae6f1;
    border-radius: 8px;
    background: #fbfdff;
    padding: 8px;
    font-size: 13px;
    color: #1f2937;
  }

  .tm-item-row {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 10px;
  }

  .tm-item-body {
    flex: 1;
    min-width: 0;
  }

  .tm-actions {
    position: relative;
    flex-shrink: 0;
    z-index: 30;
  }

  .tm-kebab {
    width: 28px;
    min-height: 28px;
    border-radius: 8px;
    border: 1px solid #c8d8e8;
    background: #fff;
    color: #374151;
    font-weight: 700;
    font-size: 16px;
    line-height: 1;
    cursor: pointer;
    padding: 0;
  }

  .tm-actions-menu {
    position: absolute;
    top: 32px;
    right: 0;
    min-width: 112px;
    border: 1px solid #d4e1ec;
    border-radius: 8px;
    background: #fff;
    box-shadow: 0 14px 30px rgba(15, 23, 42, 0.12);
    padding: 6px;
    display: none;
    z-index: 4000;
  }

  .tm-actions.open .tm-actions-menu {
    display: grid;
    gap: 4px;
  }

  .tm-actions-item {
    border: 1px solid #d6e3ef;
    background: #fff;
    color: #1f2937;
    border-radius: 6px;
    padding: 6px 8px;
    font-size: 12px;
    text-align: left;
    cursor: pointer;
  }

  .tm-actions-item[data-action^="delete"] {
    color: #991b1b;
    border-color: #f1d0d0;
    background: #fffafa;
  }

  .tm-driver-row {
    display: grid;
    grid-template-columns: 42px minmax(0, 1fr);
    gap: 9px;
    align-items: center;
  }

  .tm-driver-avatar {
    width: 42px;
    height: 42px;
    border-radius: 999px;
    object-fit: cover;
    border: 1px solid #d7e2ec;
    background: #edf3f9;
  }

  .tm-map-toolbar {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    align-items: center;
    margin-bottom: 8px;
  }

  .tm-map-toolbar input,
  .tm-map-toolbar button {
    border: 1px solid #c7d7e6;
    border-radius: 8px;
    font-size: 12px;
    padding: 8px 10px;
    background: #fff;
  }

  .tm-map-toolbar button {
    background: #0f5a66;
    border-color: #0f5a66;
    color: #fff;
    font-weight: 600;
    padding: 5px 10px;
    min-height: 30px;
    width: auto;
    cursor: pointer;
  }

  .tm-map-note {
    font-size: 11px;
    color: var(--tm-muted);
    margin: 8px 0 0;
  }

  .tm-class-group {
    border: 1px solid #dae6f1;
    border-radius: 8px;
    background: #fbfdff;
    padding: 8px;
  }

  .tm-class-group summary {
    cursor: pointer;
    font-weight: 700;
    color: #0f172a;
    outline: none;
  }

  .tm-card-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 12px;
  }

  .tm-card-head > details {
    flex: 1;
    min-width: 0;
  }

  .tm-card-head > .tm-btn,
  .tm-card-head > div {
    flex-shrink: 0;
  }

  .tm-settings-stack {
    display: grid;
    gap: 12px;
  }

  .tm-settings-stack .tm-card details > *:not(summary) {
    margin-top: 12px;
  }

  .tm-card-summary {
    cursor: pointer;
    outline: none;
    list-style: none;
  }

  .tm-card-summary::-webkit-details-marker { display: none; }

  .tm-card-summary h3 {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin: 0;
  }

  .tm-card-summary::before {
    content: '▸';
    display: inline-block;
    margin-right: 6px;
    color: #64748b;
    transition: transform 0.15s ease;
  }

  details[open] > .tm-card-summary::before {
    transform: rotate(90deg);
  }

  .tm-class-group-list {
    margin-top: 8px;
    display: grid;
    gap: 6px;
  }

  .tm-class-toolbar {
    margin-top: 8px;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    align-items: center;
  }

  .tm-class-toolbar .tm-btn {
    min-height: 28px;
    padding: 4px 10px;
    font-size: 12px;
  }

  .tm-class-toolbar .tm-map-note {
    margin: 0;
  }

  .tm-student-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 4px;
    border: 1px solid #e2ebf3;
    border-radius: 8px;
    background: #fff;
    padding: 7px 8px;
  }

  .tm-student-main {
    display: flex;
    align-items: flex-start;
    gap: 8px;
  }

  .tm-student-check {
    margin-top: 2px;
    display: none;
  }

  .tm-class-group.is-editing .tm-student-check {
    display: inline-block;
  }

  .tm-student-access-tag {
    display: inline-flex;
    align-items: center;
    border-radius: 999px;
    padding: 2px 7px;
    font-size: 11px;
    font-weight: 600;
    margin-left: 8px;
  }

  .tm-student-access-tag--yes {
    border: 1px solid #cde9d6;
    color: #166534;
    background: #f0fdf4;
  }

  .tm-student-access-tag--no {
    border: 1px solid #eed4d4;
    color: #991b1b;
    background: #fff7f7;
  }

  .tm-class-edit-controls {
    display: none;
    gap: 8px;
    align-items: center;
    flex-wrap: wrap;
  }

  .tm-class-group.is-editing .tm-class-edit-controls {
    display: inline-flex;
  }

  .tm-stop-picker-map {
    width: 100%;
    height: 220px;
    border-radius: 10px;
    border: 1px solid #d6e3ef;
    background: #eef5fb;
  }

  .tm-map-frame {
    position: relative;
  }

  .tm-locate-btn {
    display: flex !important;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 34px;
    font-size: 17px;
    line-height: 1;
    background: #fff;
    text-decoration: none;
  }

  .tm-locate-btn:hover {
    background: #f1f5f9;
  }

  .tm-locate-btn.is-locating {
    color: var(--org-primary-color, #2563eb);
    animation: tm-locate-pulse 1s ease-in-out infinite;
  }

  @keyframes tm-locate-pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.35; }
  }

  .tm-my-location-dot {
    width: 14px;
    height: 14px;
    border-radius: 999px;
    background: #2563eb;
    border: 3px solid #fff;
    box-shadow: 0 0 0 2px rgba(37, 99, 235, 0.4), 0 2px 6px rgba(15, 23, 42, 0.3);
  }

  .tm-map-maximize {
    position: absolute;
    top: 10px;
    right: 10px;
    z-index: 500;
    width: 34px;
    height: 34px;
    border-radius: 8px;
    border: 1px solid var(--tm-border);
    background: #fff;
    color: var(--tm-text);
    font-size: 16px;
    line-height: 1;
    cursor: pointer;
    box-shadow: 0 4px 10px rgba(15, 23, 42, 0.12);
  }

  .tm-map-frame.is-fullscreen {
    position: fixed;
    top: var(--header-height, 64px);
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 900;
    background: #fff;
    padding: 10px;
    box-sizing: border-box;
  }

  .tm-map-frame.is-fullscreen #tm-route-map {
    height: 100% !important;
  }

  #tm-route-map {
    width: 100%;
    height: 500px;
    border-radius: 10px;
    border: 1px solid #d6e3ef;
    background: #eef5fb;
  }

  .tm-map-legend {
    margin-top: 8px;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    font-size: 11px;
    color: #334155;
  }

  .tm-map-pill {
    border: 1px solid #d2e0ec;
    background: #f8fbff;
    border-radius: 999px;
    padding: 4px 8px;
    display: inline-flex;
    align-items: center;
    gap: 5px;
  }

  .tm-map-dot {
    width: 9px;
    height: 9px;
    border-radius: 999px;
    display: inline-block;
    background: #334155;
  }

  .tm-bus-pin {
    width: 24px;
    height: 24px;
    border-radius: 999px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #fff;
    border: 2px solid #0f172a;
    box-shadow: 0 4px 10px rgba(15, 23, 42, 0.2);
    font-size: 13px;
    line-height: 1;
  }

  .tm-stop-pin {
    border-radius: 999px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #fff;
    border: 2px solid #0f172a;
    box-shadow: 0 3px 8px rgba(15, 23, 42, 0.2);
    line-height: 1;
  }

  .tm-school-pin {
    width: 28px;
    height: 28px;
    border-radius: 999px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #fff7ed;
    border: 2px solid #b45309;
    box-shadow: 0 4px 10px rgba(120, 53, 15, 0.22);
    font-size: 15px;
    line-height: 1;
  }

  .tm-kv {
    margin-top: 8px;
    font-size: 12px;
    color: #475569;
  }

  @media (max-width: 1180px) {
    .tm-app {
      grid-template-columns: 1fr;
    }

    .tm-sidebar {
      position: static;
    }

    .tm-brand {
      justify-content: space-between;
      margin-bottom: 0;
      padding: 4px;
    }

    .tm-nav-toggle {
      display: inline-flex;
    }

    .tm-nav {
      display: none;
      grid-template-columns: 1fr;
      margin-top: 10px;
    }

    .tm-nav.is-open {
      display: grid;
    }

    .tm-stats {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .span-8,
    .span-6,
    .span-4 {
      grid-column: span 12;
    }
  }

  @media (max-width: 760px) {
    .tm-app {
      padding: 10px;
      min-height: auto;
    }

    .tm-sidebar {
      padding: 10px 12px;
    }

    .tm-head--split {
      flex-direction: column;
      align-items: flex-start;
    }

    .tm-logo {
      width: 56px;
      height: 56px;
    }

    .tm-form-grid {
      grid-template-columns: 1fr;
    }

    .tm-stats {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    #tm-route-map {
      height: 360px;
    }
  }
</style>

<div class="tm-app">
  <aside class="tm-sidebar">
    <div class="tm-brand">
      <img class="tm-logo" src="/images/transportation-logo.png" alt="Transportation logo" />
      <button class="tm-nav-toggle" type="button" id="tm-nav-toggle" aria-label="Open menu" aria-expanded="false">
        <span class="bar"></span>
        <span class="bar"></span>
        <span class="bar"></span>
      </button>
    </div>

    <nav class="tm-nav" aria-label="Transportation sections" id="tm-nav">
      <button class="tm-nav-btn active" type="button" data-pane="overview">Overview</button>
      <button class="tm-nav-btn" type="button" data-pane="buses">Buses</button>
      <button class="tm-nav-btn" type="button" data-pane="drivers">Drivers</button>
      <button class="tm-nav-btn" type="button" data-pane="schedule">Schedule</button>
      <button class="tm-nav-btn" type="button" data-pane="students">Students</button>
      <button class="tm-nav-btn" type="button" data-pane="settings">Settings</button>
    </nav>
  </aside>

  <main class="tm-main">
    <section class="tm-pane active" data-pane-id="overview">
      <div class="tm-head">
        <h2>Transportation Overview</h2>
      </div>

      <div class="tm-stats">
        <article class="tm-stat"><p class="tm-stat-k">Buses</p><p class="tm-stat-v"><%= (buses || []).length %></p></article>
        <article class="tm-stat"><p class="tm-stat-k">Drivers</p><p class="tm-stat-v"><%= (drivers || []).length %></p></article>
        <article class="tm-stat"><p class="tm-stat-k">Routes</p><p class="tm-stat-v"><%= (routes || []).length %></p></article>
        <article class="tm-stat"><p class="tm-stat-k">Stops</p><p class="tm-stat-v"><%= (stops || []).length %></p></article>
        <article class="tm-stat"><p class="tm-stat-k">Assignments</p><p class="tm-stat-v"><%= (assignments || []).length %></p></article>
        <article class="tm-stat"><p class="tm-stat-k">Students</p><p class="tm-stat-v"><%= (students || []).length %></p></article>
      </div>

      <div class="tm-grid">
        <article class="tm-card span-12">
          <h3>Operations Map</h3>
          <div class="tm-map-toolbar" style="margin-top:8px;">
            <select id="tm-route-filter">
              <option value="">All Routes</option>
              <% (routes || []).forEach(function(route) { %>
                <option value="<%= route.route_id %>"><%= route.route_name %></option>
              <% }) %>
            </select>
          </div>
          <div class="tm-map-legend">
            <span class="tm-map-pill">🚏 Route Stops</span>
            <span class="tm-map-pill">🚌 Bus Positions</span>
            <span class="tm-map-pill">🏫 School Hub</span>
          </div>
          <div class="tm-map-frame" id="tm-route-map-frame">
            <button type="button" class="tm-map-maximize" id="tm-route-map-maximize" aria-label="Maximize map" title="Maximize map">⛶</button>
            <div id="tm-route-map"></div>
          </div>
        </article>

        <article class="tm-card span-6">
          <details>
            <summary class="tm-card-summary"><h3>Recent Assignments</h3></summary>
            <ul class="tm-list">
              <% (assignments || []).slice(0, 12).forEach(function(assignment) { %>
                <li>
                  <strong><%= assignment.last_name %> <%= assignment.first_name %></strong>
                  | Bus: <%= assignment.bus_number || '-' %>
                  | Route: <%= assignment.route_name || '-' %>
                </li>
              <% }) %>
            </ul>
          </details>
        </article>

        <article class="tm-card span-6">
          <details>
            <summary class="tm-card-summary"><h3>Operations Snapshot</h3></summary>
            <% const weekdayNow = ['sunday','monday','tuesday','wednesday','thursday','friday','saturday'][new Date().getDay()]; %>
            <% const todaySchedules = (schedules || []).filter(function(s) { return String(s.day_of_week || '').toLowerCase() === weekdayNow && String(s.status || '').toLowerCase() === 'active'; }); %>
            <% const assignedStudentCount = (assignments || []).length; %>
            <% const activeStudentCount = (students || []).length; %>
            <% const mappedStops = (stops || []).filter(function(s) { return s.latitude !== null && s.longitude !== null; }).length; %>
            <% const avgStopsPerRoute = (routes || []).length ? ((stops || []).length / (routes || []).length) : 0; %>
            <ul class="tm-list">
              <li><strong>Map Provider:</strong> <%= integration && integration.mapProvider ? integration.mapProvider : 'openstreetmap' %></li>
              <li><strong>Today Schedules:</strong> <%= todaySchedules.length %> (<%= weekdayNow.charAt(0).toUpperCase() + weekdayNow.slice(1) %>)</li>
              <li><strong>Student Coverage:</strong> <%= assignedStudentCount %> / <%= activeStudentCount %> assigned</li>
              <li><strong>Mapped Stop Quality:</strong> <%= mappedStops %> / <%= (stops || []).length %> with coordinates</li>
              <li><strong>Avg Stops Per Route:</strong> <%= avgStopsPerRoute.toFixed(1) %></li>
            </ul>
          </details>
        </article>
      </div>
    </section>

    <section class="tm-pane" data-pane-id="drivers">
      <div class="tm-head">
        <h2>Drivers</h2>
      </div>
      <p class="tm-map-note" style="margin-top:-6px;">
        Drivers are the same employee accounts shown in
        <a href="/common/manageEmployees" target="_blank" rel="noopener">Manage Employees</a> — add one there (role:
        Driver), then come back here to set their phone, license, assigned bus, and route.
      </p>

      <div class="tm-grid">
        <article class="tm-card span-12">
          <div class="tm-card-head">
          <details>
            <summary class="tm-card-summary"><h3>🧑‍✈️ Driver List (<%= (drivers || []).length %>)</h3></summary>
          <ul class="tm-list" id="driver-list">
            <% (drivers || []).forEach(function(driver) { %>
              <% const driverFullName = [driver.first_name, driver.last_name].filter(Boolean).join(' '); %>
              <% const driverSchedules = (schedules || []).filter(function(s) { return driver.driver_id && Number(s.driver_id) === Number(driver.driver_id); }); %>
              <% const driverScheduleDays = driverSchedules.map(function(s) { return s.day_of_week; }).filter(Boolean); %>
              <% const driverScheduleStart = driverSchedules[0] ? driverSchedules[0].start_time : ''; %>
              <% const driverScheduleEnd = driverSchedules[0] ? driverSchedules[0].end_time : ''; %>
              <li>
                <div class="tm-item-row">
                  <div class="tm-item-body tm-driver-row">
                    <img class="tm-driver-avatar" src="<%= driver.image_url || '/images/profilePlaceholder.png' %>" alt="Driver image" />
                    <div>
                      <strong><%= driverFullName %></strong> | <%= driver.phone || '-' %> | <%= driver.email || '-' %> | Status: <%= String(driver.status || '').replaceAll('_', ' ') || '-' %>
                      <br/>
                      License: <%= driver.license_number || '-' %> | Bus: <%= driver.bus_number || '-' %> | Route: <%= driver.route_name || '-' %> | Schedules: <%= Number(driver.schedule_count || 0) %>
                    </div>
                  </div>
                  <div class="tm-actions" data-actions>
                    <button class="tm-kebab" type="button" aria-label="Driver actions">...</button>
                    <div class="tm-actions-menu">
                      <button class="tm-actions-item" type="button" data-action="edit-driver"
                        data-user-id="<%= driver.user_id %>"
                        data-first-name="<%= driver.first_name || '' %>"
                        data-last-name="<%= driver.last_name || '' %>"
                        data-phone="<%= driver.phone || '' %>"
                        data-email="<%= driver.email || '' %>"
                        data-license-number="<%= driver.license_number || '' %>"
                        data-status="<%= driver.status || 'active' %>"
                        data-assigned-bus-id="<%= driver.assigned_bus_id || '' %>"
                        data-assigned-route-id="<%= driver.assigned_route_id || '' %>"
                        data-schedule-days="<%= driverScheduleDays.join(',') %>"
                        data-schedule-start-time="<%= driverScheduleStart || '' %>"
                        data-schedule-end-time="<%= driverScheduleEnd || '' %>">
                        Edit
                      </button>
                      <button class="tm-actions-item" type="button" data-action="delete-driver" data-user-id="<%= driver.user_id %>" data-driver-name="<%= driverFullName %>">Remove from Transportation</button>
                    </div>
                  </div>
                </div>
              </li>
            <% }) %>
          </ul>
          </details>
          <a class="tm-btn tm-btn--primary" href="/common/createEmployee">+ Add Driver</a>
          </div>
        </article>
      </div>

      <div class="tm-modal" id="add-driver-modal" aria-hidden="true">
        <div class="tm-modal-card" role="dialog" aria-modal="true" aria-labelledby="add-driver-title">
          <div class="tm-modal-head">
            <h3 class="tm-modal-title" id="add-driver-title">Add Driver</h3>
            <button class="tm-btn" type="button" id="close-add-driver-modal">Close</button>
          </div>

          <form id="add-driver-form" enctype="multipart/form-data">
            <input type="hidden" name="userId" id="driver-user-id-field" />
            <section class="tm-modal-sect">
              <h4>Basic Information</h4>
              <div class="tm-form-grid">
                <div class="tm-row"><label>First Name</label><input name="firstName" required /></div>
                <div class="tm-row"><label>Last Name</label><input name="lastName" required /></div>
                <div class="tm-row"><label>Email</label><input name="email" type="email" required /></div>
                <div class="tm-row"><label>Phone</label><input name="phone" /></div>
                <div class="tm-row"><label>License Number</label><input name="licenseNumber" /></div>
                <div class="tm-row"><label>Status</label><select name="status"><option value="active">Active</option><option value="inactive">Inactive</option></select></div>
                <div class="tm-row"><label>Assigned Bus</label><select name="assignedBusId"><option value="">None</option><% (buses || []).forEach(function(bus) { %><option value="<%= bus.bus_id %>"><%= bus.bus_number %></option><% }) %></select></div>
                <div class="tm-row"><label>Assigned Route</label><select name="assignedRouteId"><option value="">None</option><% (routes || []).forEach(function(route) { %><option value="<%= route.route_id %>"><%= route.route_name %></option><% }) %></select></div>
                <div class="tm-row"><label>Driver Image</label><input name="driverImage" type="file" accept="image/*" /></div>
              </div>
              <p class="tm-map-note" id="add-driver-note">A new driver will receive an email invite to set their password and access the Driver Dashboard. They will not be able to sign in as a Teacher, Manager, or Supervisor.</p>
            </section>

            <section class="tm-modal-sect">
              <h4>Weekly Schedule</h4>
              <p class="tm-map-note">Pick the days this driver runs the assigned bus/route above, and the time window. Leave all days unchecked for no fixed schedule.</p>
              <div class="tm-checkbox-list" style="display:flex; gap:10px; flex-wrap:wrap;">
                <% ['monday','tuesday','wednesday','thursday','friday','saturday','sunday'].forEach(function(day) { %>
                  <label class="tm-checkbox-list-item">
                    <input type="checkbox" name="scheduleDays" value="<%= day %>" />
                    <%= day.charAt(0).toUpperCase() + day.slice(1, 3) %>
                  </label>
                <% }) %>
              </div>
              <div class="tm-form-grid" style="margin-top:8px;">
                <div class="tm-row"><label>Start Time</label><input type="time" name="scheduleStartTime" /></div>
                <div class="tm-row"><label>End Time</label><input type="time" name="scheduleEndTime" /></div>
              </div>
            </section>

            <div class="tm-toolbar" style="margin-top:10px;">
              <span id="add-driver-feedback" class="tm-map-note"></span>
              <button class="tm-btn tm-btn--primary" type="submit" id="submit-add-driver">Save Driver</button>
            </div>
          </form>
        </div>
      </div>
    </section>

    <section class="tm-pane" data-pane-id="buses">
      <div class="tm-head">
        <h2>Buses</h2>
      </div>

      <div class="tm-grid">
        <article class="tm-card span-12">
          <div class="tm-card-head">
          <details>
            <summary class="tm-card-summary"><h3>🚌 Bus List (<%= (buses || []).length %>)</h3></summary>
          <ul class="tm-list" id="bus-list">
            <% (buses || []).forEach(function(bus) { %>
              <li>
                <div class="tm-item-row">
                  <div class="tm-item-body">
                    <strong><%= bus.bus_number %></strong> (<%= bus.bus_name || '-' %>) | Plate: <%= bus.license_plate || '-' %> | Status: <%= String(bus.status || '').replaceAll('_', ' ') || '-' %> | Capacity: <%= bus.capacity || '-' %>
                    <br/>
                    Driver: <%= bus.driver_user_id ? [bus.first_name, bus.last_name].filter(Boolean).join(' ') : 'Unassigned' %>
                    <br/>
                    Make: <%= bus.vehicle_make || '-' %> | Model: <%= bus.vehicle_model || '-' %> | Year: <%= bus.vehicle_year || '-' %> | Color: <%= bus.vehicle_color || '-' %>
                    <br/>
                    VIN: <%= bus.vin || '-' %> | Fuel: <%= bus.fuel_type || '-' %> | Odometer: <%= bus.odometer || '-' %>
                  </div>
                  <div class="tm-actions" data-actions>
                    <button class="tm-kebab" type="button" aria-label="Bus actions">...</button>
                    <div class="tm-actions-menu">
                      <button class="tm-actions-item" type="button" data-action="edit-bus"
                        data-bus-id="<%= bus.bus_id %>"
                        data-bus-number="<%= bus.bus_number || '' %>"
                        data-bus-name="<%= bus.bus_name || '' %>"
                        data-license-plate="<%= bus.license_plate || '' %>"
                        data-capacity="<%= bus.capacity || '' %>"
                        data-driver-user-id="<%= bus.driver_user_id || '' %>"
                        data-status="<%= bus.status || 'active' %>"
                        data-vehicle-make="<%= bus.vehicle_make || '' %>"
                        data-vehicle-model="<%= bus.vehicle_model || '' %>"
                        data-vehicle-year="<%= bus.vehicle_year || '' %>"
                        data-vehicle-color="<%= bus.vehicle_color || '' %>"
                        data-vin="<%= bus.vin || '' %>"
                        data-fuel-type="<%= bus.fuel_type || '' %>"
                        data-odometer="<%= bus.odometer || '' %>">
                        Edit
                      </button>
                      <button class="tm-actions-item" type="button" data-action="delete-bus" data-bus-id="<%= bus.bus_id %>" data-bus-number="<%= bus.bus_number || '' %>">Delete</button>
                    </div>
                  </div>
                </div>
              </li>
            <% }) %>
          </ul>
          </details>
          <button class="tm-btn tm-btn--primary" type="button" id="open-add-bus-modal">+ Add Bus</button>
          </div>
        </article>

        <article class="tm-card span-12">
          <div class="tm-card-head">
          <details>
            <summary class="tm-card-summary"><h3>🗺️ Route List (<%= (routes || []).length %>)</h3></summary>
          <p class="tm-map-note">Expand a route to see its stops, driver, bus, and schedule in one place.</p>
          <ul class="tm-list">
            <% (routes || []).forEach(function(route) { %>
              <% const routeStops = (stops || []).filter(function(s) { return Number(s.route_id) === Number(route.route_id); }).sort(function(a,b){ return (a.stop_order||0)-(b.stop_order||0); }); %>
              <% const routeSchedules = (schedules || []).filter(function(s) { return Number(s.route_id) === Number(route.route_id); }); %>
              <% const routeBusIds = Array.from(new Set(routeSchedules.map(function(s) { return s.bus_id; }).filter(Boolean))); %>
              <% const routeBuses = (buses || []).filter(function(b) { return routeBusIds.includes(b.bus_id); }); %>
              <li>
                <details class="tm-class-group">
                  <summary>
                    <strong><%= route.route_name %></strong>
                    <span class="tm-map-note">Code: <%= route.route_code || '-' %> · <%= route.route_status || 'active' %> · <%= routeStops.length %> stop<%= routeStops.length === 1 ? '' : 's' %> · <%= routeBuses.length %> bus<%= routeBuses.length === 1 ? '' : 'es' %></span>
                  </summary>
                  <div class="tm-class-toolbar">
                    <button class="tm-btn tm-actions-item" type="button" data-action="view-route-map" data-route-id="<%= route.route_id %>">View On Map</button>
                    <button class="tm-btn tm-actions-item" type="button" data-action="edit-route"
                      data-route-id="<%= route.route_id %>"
                      data-route-name="<%= route.route_name || '' %>"
                      data-route-code="<%= route.route_code || '' %>"
                      data-route-status="<%= route.route_status || 'active' %>"
                      data-map-provider="<%= route.map_provider || 'openstreetmap' %>"
                      data-use-school-destination="<%= route.use_school_destination ? '1' : '0' %>"
                      data-destination-address="<%= route.destination_address || '' %>"
                      data-stop-ids="<%= routeStops.map(function(s) { return s.stop_id; }).join(',') %>">
                      Edit Route &amp; Stops
                    </button>
                    <button class="tm-btn tm-actions-item" type="button" data-action="delete-route" data-route-id="<%= route.route_id %>" data-route-name="<%= route.route_name || '' %>">Delete</button>
                  </div>

                  <div class="tm-class-group-list">
                    <div class="tm-student-row">
                      <div class="tm-student-main" style="align-items:flex-start;">
                        <div>
                          <strong>Destination</strong>
                          <div class="tm-map-note"><%= route.use_school_destination ? 'School Destination' : 'Custom Destination' %> — <%= route.destination_address || schoolAddress || '-' %></div>
                        </div>
                      </div>
                    </div>

                    <div class="tm-student-row">
                      <div class="tm-student-main" style="align-items:flex-start;">
                        <div style="width:100%;">
                          <strong>Stops (in order)</strong>
                          <% if (!routeStops.length) { %>
                            <div class="tm-map-note">No stops attached yet — add some from Edit Route &amp; Stops above.</div>
                          <% } else { %>
                            <ol style="margin:6px 0 0; padding-left:18px; font-size:12px; color:#334155;">
                              <% routeStops.forEach(function(stop) { %>
                                <li><%= stop.stop_name %><% if (stop.stop_address) { %> — <span class="tm-map-note"><%= stop.stop_address %></span><% } %></li>
                              <% }) %>
                            </ol>
                          <% } %>
                        </div>
                      </div>
                    </div>

                    <div class="tm-student-row">
                      <div class="tm-student-main" style="align-items:flex-start;">
                        <div style="width:100%;">
                          <strong>Bus, Driver &amp; Schedule</strong>
                          <% if (!routeBuses.length) { %>
                            <div class="tm-map-note">No bus scheduled on this route yet — add one from the Schedule tab.</div>
                          <% } else { %>
                            <% routeBuses.forEach(function(bus) { %>
                              <% const busSchedules = routeSchedules.filter(function(s) { return s.bus_id === bus.bus_id; }); %>
                              <% const days = busSchedules.map(function(s) { return (s.day_of_week || '').slice(0,3); }).join(', '); %>
                              <div class="tm-map-note" style="margin-top:4px;">
                                🚌 <%= bus.bus_number %> · Driver: <%= bus.driver_user_id ? [bus.first_name, bus.last_name].filter(Boolean).join(' ') : 'Unassigned' %> · <%= days || '-' %>
                              </div>
                            <% }) %>
                          <% } %>
                        </div>
                      </div>
                    </div>
                  </div>
                </details>
              </li>
            <% }) %>
          </ul>
          </details>
          <button class="tm-btn tm-btn--primary" type="button" id="open-add-route-modal">+ Add Route</button>
          </div>
        </article>

        <article class="tm-card span-12">
          <div class="tm-card-head">
          <details>
            <summary class="tm-card-summary"><h3>📍 Stop List (<%= (stops || []).length %>)</h3></summary>
          <p class="tm-map-note">Stops are a shared pool — attach them to a route from the Route List (Edit &rarr; Stops on this Route).</p>
          <ul class="tm-list">
            <% const routeNameById = Object.fromEntries((routes || []).map(function(r) { return [Number(r.route_id), r.route_name]; })); %>
            <% (stops || []).forEach(function(stop) { %>
              <li>
                <div class="tm-item-row">
                  <div class="tm-item-body">
                    <strong><%= stop.stop_name %></strong>
                    | <%= stop.stop_address || '-' %>
                    | Route: <%= stop.route_id ? (routeNameById[Number(stop.route_id)] || ('#' + stop.route_id)) : 'Unattached' %>
                    | Order: <%= stop.stop_order || 0 %>
                    | <%= stop.latitude || '-' %>, <%= stop.longitude || '-' %>
                  </div>
                  <div class="tm-actions" data-actions>
                    <button class="tm-kebab" type="button" aria-label="Stop actions">...</button>
                    <div class="tm-actions-menu">
                      <button class="tm-actions-item" type="button" data-action="view-stop-map" data-route-id="<%= stop.route_id || '' %>" data-latitude="<%= stop.latitude || '' %>" data-longitude="<%= stop.longitude || '' %>">View On Map</button>
                      <button class="tm-actions-item" type="button" data-action="edit-stop"
                        data-stop-id="<%= stop.stop_id %>"
                        data-route-id="<%= stop.route_id || '' %>"
                        data-stop-name="<%= stop.stop_name || '' %>"
                        data-stop-address="<%= stop.stop_address || '' %>"
                        data-latitude="<%= stop.latitude || '' %>"
                        data-longitude="<%= stop.longitude || '' %>"
                        data-pickup-time="<%= stop.pickup_time || '' %>"
                        data-dropoff-time="<%= stop.dropoff_time || '' %>"
                        data-stop-order="<%= stop.stop_order || 0 %>">
                        Edit
                      </button>
                      <button class="tm-actions-item" type="button" data-action="delete-stop" data-stop-id="<%= stop.stop_id %>" data-stop-name="<%= stop.stop_name || '' %>">Delete</button>
                    </div>
                  </div>
                </div>
              </li>
            <% }) %>
          </ul>
          </details>
          <div style="display:flex; gap:8px; flex-wrap:wrap;">
            <button class="tm-btn tm-btn--primary" type="button" id="open-import-city-stops-modal">+ Import City Stops</button>
            <button class="tm-btn tm-btn--primary" type="button" id="open-add-stop-modal">+ Add Stop</button>
          </div>
          </div>
        </article>
      </div>

      <div class="tm-modal" id="add-route-modal" aria-hidden="true">
        <div class="tm-modal-card" role="dialog" aria-modal="true" aria-labelledby="add-route-title">
          <div class="tm-modal-head">
            <h3 class="tm-modal-title" id="add-route-title">Add Route</h3>
            <button class="tm-btn" type="button" id="close-add-route-modal">Close</button>
          </div>

          <form id="add-route-form">
            <section class="tm-modal-sect">
              <div class="tm-form-grid">
                <div class="tm-row"><label>Route Name</label><input name="routeName" required /></div>
                <div class="tm-row"><label>Route Code</label><input name="routeCode" /></div>
                <div class="tm-row"><label>Status</label><select name="routeStatus"><option value="active">active</option><option value="inactive">inactive</option></select></div>
                <div class="tm-row"><label>Map Provider</label><select name="mapProvider"><% (mapProviders || []).forEach(function(provider) { %><option value="<%= provider %>"><%= provider %></option><% }) %></select></div>
                <div class="tm-row"><label><input type="checkbox" name="useSchoolDestination" value="1" checked /> Use School Destination</label></div>
                <div class="tm-row" data-custom-destination-row><label>Destination Address</label><input name="destinationAddress" placeholder="Type an address — the map location is found automatically" /></div>
              </div>
              <div class="tm-row" style="margin-top:8px;">
                <label>Stops on this Route</label>
                <div class="tm-checkbox-list" id="add-route-stops-list">
                  <% (stops || []).forEach(function(stop) { %>
                    <label class="tm-checkbox-list-item">
                      <input type="checkbox" name="stopIds" value="<%= stop.stop_id %>" />
                      <%= stop.stop_name %><% if (stop.route_id && stop.route_id != 0) { %> <span class="tm-map-note">(currently on another route)</span><% } %>
                    </label>
                  <% }) %>
                  <% if (!(stops || []).length) { %><p class="tm-map-note">No stops yet — add stops first, then attach them here.</p><% } %>
                </div>
              </div>
            </section>

            <div class="tm-toolbar" style="margin-top:10px;">
              <span id="add-route-feedback" class="tm-map-note"></span>
              <button class="tm-btn tm-btn--primary" type="submit" id="submit-add-route">Save Route</button>
            </div>
          </form>
        </div>
      </div>

      <div class="tm-modal" id="add-stop-modal" aria-hidden="true">
        <div class="tm-modal-card" role="dialog" aria-modal="true" aria-labelledby="add-stop-title">
          <div class="tm-modal-head">
            <h3 class="tm-modal-title" id="add-stop-title">Add Stop</h3>
            <button class="tm-btn" type="button" id="close-add-stop-modal">Close</button>
          </div>

          <form id="add-stop-form">
            <section class="tm-modal-sect">
              <div class="tm-form-grid">
                <div class="tm-row"><label>Route (optional)</label><select name="routeId"><option value="">No route yet — attach later</option><% (routes || []).forEach(function(route) { %><option value="<%= route.route_id %>"><%= route.route_name %></option><% }) %></select></div>
                <div class="tm-row"><label>Stop Name</label><input name="stopName" required /></div>
                <div class="tm-row"><label>Stop Address</label><input name="stopAddress" /></div>
                <div class="tm-row"><label>Latitude</label><input name="latitude" /></div>
                <div class="tm-row"><label>Longitude</label><input name="longitude" /></div>
                <div class="tm-row"><label>Pickup Time</label><input type="time" name="pickupTime" /></div>
                <div class="tm-row"><label>Dropoff Time</label><input type="time" name="dropoffTime" /></div>
                <div class="tm-row"><label>Stop Order</label><input name="stopOrder" type="number" min="0" /></div>
              </div>
              <p class="tm-map-note">Stops don't need a route right away — you can create a pool of stops and pick which ones belong to each route when you set up the route.</p>
              <p class="tm-map-note" id="add-stop-pin-hint">Click the map to pin this stop location.</p>
              <div id="add-stop-picker-map" class="tm-stop-picker-map"></div>
            </section>

            <div class="tm-toolbar" style="margin-top:10px;">
              <span id="add-stop-feedback" class="tm-map-note"></span>
              <button class="tm-btn tm-btn--primary" type="submit" id="submit-add-stop">Save Stop</button>
            </div>
          </form>
        </div>
      </div>

      <div class="tm-modal" id="import-city-stops-modal" aria-hidden="true">
        <div class="tm-modal-card" role="dialog" aria-modal="true" aria-labelledby="import-city-stops-title">
          <div class="tm-modal-head">
            <h3 class="tm-modal-title" id="import-city-stops-title">Import Stops By City</h3>
            <button class="tm-btn" type="button" id="close-import-city-stops-modal">Close</button>
          </div>

          <form id="import-city-stops-form">
            <section class="tm-modal-sect">
              <div class="tm-form-grid">
                <div class="tm-row"><label>Route</label><select name="routeId" required><option value="">Select Route</option><% (routes || []).forEach(function(route) { %><option value="<%= route.route_id %>"><%= route.route_name %></option><% }) %></select></div>
                <div class="tm-row"><label>City</label><input name="city" required placeholder="Salt Lake City" /></div>
                <div class="tm-row"><label>Max Stops</label><input name="maxStops" type="number" min="1" max="120" value="40" /></div>
              </div>
            </section>

            <div class="tm-toolbar" style="margin-top:10px;">
              <span id="import-city-stops-feedback" class="tm-map-note">Pulls bus stop candidates from map data, then you can edit/clean them.</span>
              <button class="tm-btn tm-btn--primary" type="submit" id="submit-import-city-stops">Import Stops</button>
            </div>
          </form>
        </div>
      </div>

      <div class="tm-modal" id="add-bus-modal" aria-hidden="true">
        <div class="tm-modal-card" role="dialog" aria-modal="true" aria-labelledby="add-bus-title">
          <div class="tm-modal-head">
            <h3 class="tm-modal-title" id="add-bus-title">Add Bus</h3>
            <button class="tm-btn" type="button" id="close-add-bus-modal">Close</button>
          </div>

          <form id="add-bus-form">
            <input type="hidden" name="busId" id="bus-id-field" />
            <section class="tm-modal-sect">
              <h4>Basic Information</h4>
              <div class="tm-form-grid">
                <div class="tm-row"><label>Bus Number</label><input name="busNumber" required placeholder="BUS-001" /></div>
                <div class="tm-row"><label>Bus Name</label><input name="busName" placeholder="North Route Bus" /></div>
                <div class="tm-row"><label>Vehicle Registration / License Plate</label><input name="licensePlate" placeholder="GT-1234-25" /></div>
                <div class="tm-row"><label>Capacity</label><input name="capacity" type="number" min="1" /></div>
                <div class="tm-row">
                  <label>Assigned Driver</label>
                  <select name="driverUserId">
                    <option value="">Unassigned</option>
                    <% (driverUsers || []).forEach(function(driverUser) { %>
                      <option value="<%= driverUser.user_id %>"><%= [driverUser.first_name, driverUser.last_name].filter(Boolean).join(' ') %></option>
                    <% }) %>
                  </select>
                  <% if (!(driverUsers || []).length) { %>
                    <span class="tm-map-note">No Driver-role employees yet — add one via Manage Employees.</span>
                  <% } %>
                </div>
                <div class="tm-row"><label>Status</label><select name="status"><option value="active">Active</option><option value="in_service">In Service</option><option value="maintenance">Maintenance</option><option value="out_of_service">Out of Service</option></select></div>
              </div>
            </section>

            <section class="tm-modal-sect">
              <h4>Vehicle Details</h4>
              <div class="tm-form-grid">
                <div class="tm-row"><label>Vehicle Make</label><input name="vehicleMake" placeholder="Ford" /></div>
                <div class="tm-row"><label>Model</label><input name="vehicleModel" placeholder="Transit" /></div>
                <div class="tm-row"><label>Year</label><input name="vehicleYear" type="number" min="1950" max="2100" /></div>
                <div class="tm-row"><label>Color</label><input name="vehicleColor" placeholder="Yellow" /></div>
                <div class="tm-row"><label>VIN</label><input name="vin" /></div>
                <div class="tm-row"><label>Fuel Type</label><select name="fuelType"><option value="">Select</option><option value="diesel">Diesel</option><option value="petrol">Petrol</option><option value="electric">Electric</option><option value="hybrid">Hybrid</option><option value="cng">CNG</option></select></div>
                <div class="tm-row"><label>Odometer</label><input name="odometer" type="number" min="0" step="0.1" /></div>
              </div>
            </section>

            <div class="tm-toolbar" style="margin-top:10px;">
              <span id="add-bus-feedback" class="tm-map-note"></span>
              <button class="tm-btn tm-btn--primary" type="submit" id="submit-add-bus">Save Bus</button>
            </div>
          </form>
        </div>
      </div>
    </section>

    <section class="tm-pane" data-pane-id="schedule">
      <div class="tm-head tm-head--split">
        <h2>Schedule</h2>
        <button class="tm-btn tm-btn--primary" type="button" id="open-add-schedule-modal">+ Add Schedule</button>
      </div>

      <div class="tm-grid">
        <article class="tm-card span-12">
          <h3>Schedule List</h3>
          <p class="tm-map-note">Grouped by start time — expand a time to see every bus running then, its driver, route, and days.</p>
          <%
            const dayAbbrev = { monday: 'Mon', tuesday: 'Tue', wednesday: 'Wed', thursday: 'Thu', friday: 'Fri', saturday: 'Sat', sunday: 'Sun' };
            const dayOrder = ['monday','tuesday','wednesday','thursday','friday','saturday','sunday'];
            const formatTime = function(t) {
              if (!t) return '-';
              const parts = String(t).split(':');
              let hour = parseInt(parts[0], 10);
              const minute = parts[1] || '00';
              const suffix = hour >= 12 ? 'PM' : 'AM';
              hour = hour % 12; if (hour === 0) hour = 12;
              return hour + ':' + minute + ' ' + suffix;
            };
            const timeGroups = {};
            (schedules || []).forEach(function(schedule) {
              const timeKey = (schedule.start_time || '-') + '|' + (schedule.end_time || '-');
              if (!timeGroups[timeKey]) {
                timeGroups[timeKey] = { startTime: schedule.start_time, endTime: schedule.end_time, buses: {} };
              }
              const busKey = String(schedule.bus_id || 'none');
              if (!timeGroups[timeKey].buses[busKey]) {
                timeGroups[timeKey].buses[busKey] = {
                  busNumber: schedule.bus_number || '-',
                  driverName: schedule.driver_name || 'Unassigned',
                  routeName: schedule.route_name || '-',
                  entries: [],
                };
              }
              timeGroups[timeKey].buses[busKey].entries.push(schedule);
            });
            const sortedTimeKeys = Object.keys(timeGroups).sort(function(a, b) {
              return (timeGroups[a].startTime || '').localeCompare(timeGroups[b].startTime || '');
            });
          %>
          <% if (!sortedTimeKeys.length) { %>
            <p class="tm-map-note">No schedules yet — add one to see it here.</p>
          <% } %>
          <% sortedTimeKeys.forEach(function(timeKey) { %>
            <% const group = timeGroups[timeKey]; const busKeys = Object.keys(group.buses); %>
            <details class="tm-class-group">
              <summary>🕐 <%= formatTime(group.startTime) %> – <%= formatTime(group.endTime) %> (<%= busKeys.length %> bus<%= busKeys.length === 1 ? '' : 'es' %>)</summary>
              <div class="tm-class-group-list">
                <% busKeys.forEach(function(busKey) { %>
                  <% const busGroup = group.buses[busKey]; %>
                  <div class="tm-student-row">
                    <div class="tm-student-main" style="align-items:flex-start;">
                      <div>
                        <strong><%= busGroup.busNumber %></strong>
                        <span class="tm-map-note">Driver: <%= busGroup.driverName %> · Route: <%= busGroup.routeName %></span>
                        <div style="margin-top:6px; display:flex; gap:6px; flex-wrap:wrap;">
                          <% busGroup.entries.slice().sort(function(a,b){ return dayOrder.indexOf(a.day_of_week) - dayOrder.indexOf(b.day_of_week); }).forEach(function(entry) { %>
                            <span class="tm-badge tm-actions-item" title="<%= String(entry.status || '').replaceAll('_',' ') %>" style="cursor:pointer;"
                              data-action="edit-schedule"
                              data-schedule-id="<%= entry.schedule_id %>"
                              data-bus-id="<%= entry.bus_id || '' %>"
                              data-driver-id="<%= entry.driver_id || '' %>"
                              data-route-id="<%= entry.route_id || '' %>"
                              data-day-of-week="<%= entry.day_of_week || 'monday' %>"
                              data-start-time="<%= entry.start_time || '' %>"
                              data-end-time="<%= entry.end_time || '' %>"
                              data-status="<%= entry.status || 'active' %>"
                              data-notes="<%= entry.notes || '' %>">
                              <%= dayAbbrev[entry.day_of_week] || entry.day_of_week %><% if (entry.status === 'inactive') { %> (off)<% } %>
                            </span>
                          <% }) %>
                        </div>
                      </div>
                      <button class="tm-btn" type="button" data-action="delete-schedule-group"
                        data-schedule-ids="<%= busGroup.entries.map(function(e) { return e.schedule_id; }).join(',') %>"
                        style="margin-left:auto;">Delete All</button>
                    </div>
                  </div>
                <% }) %>
              </div>
            </details>
          <% }) %>
        </article>
      </div>

      <div class="tm-modal" id="add-schedule-modal" aria-hidden="true">
        <div class="tm-modal-card" role="dialog" aria-modal="true" aria-labelledby="add-schedule-title">
          <div class="tm-modal-head">
            <h3 class="tm-modal-title" id="add-schedule-title">Add Schedule</h3>
            <button class="tm-btn" type="button" id="close-add-schedule-modal">Close</button>
          </div>

          <form id="add-schedule-form">
            <input type="hidden" name="scheduleId" id="schedule-id-field" />
            <section class="tm-modal-sect">
              <h4>Assignment</h4>
              <div class="tm-form-grid">
                <div class="tm-row"><label>Bus</label><select name="busId" required id="schedule-bus-select"><option value="">Select Bus</option><% (buses || []).forEach(function(bus) { %><option value="<%= bus.bus_id %>"><%= bus.bus_number %></option><% }) %></select></div>
                <div class="tm-row">
                  <label>Driver</label>
                  <input type="text" id="schedule-driver-display" readonly placeholder="Auto-filled from the bus's assigned driver" />
                  <input type="hidden" name="driverId" id="schedule-driver-id" />
                </div>
                <div class="tm-row"><label>Route</label><select name="routeId" id="schedule-route-select"><option value="">Select Route</option><% (routes || []).forEach(function(route) { %><option value="<%= route.route_id %>"><%= route.route_name %></option><% }) %></select></div>
                <div class="tm-row"><label>Day</label><select name="dayOfWeek"><option value="monday">Monday</option><option value="tuesday">Tuesday</option><option value="wednesday">Wednesday</option><option value="thursday">Thursday</option><option value="friday">Friday</option><option value="saturday">Saturday</option><option value="sunday">Sunday</option></select></div>
                <div class="tm-row"><label>Start Time</label><input type="time" name="startTime" /></div>
                <div class="tm-row"><label>End Time</label><input type="time" name="endTime" /></div>
                <div class="tm-row" id="schedule-status-row" style="display:none;"><label>Status</label><select name="status"><option value="active">Active</option><option value="inactive">Inactive</option></select></div>
                <div class="tm-row"><label>Notes (optional)</label><input name="notes" /></div>
              </div>
              <p class="tm-map-note" id="schedule-route-warning" style="display:none; color:#b45309; font-weight:600;"></p>
            </section>

            <div class="tm-toolbar" style="margin-top:10px;">
              <span id="add-schedule-feedback" class="tm-map-note"></span>
              <button class="tm-btn tm-btn--primary" type="submit" id="submit-add-schedule">Save Schedule</button>
            </div>
          </form>
        </div>
      </div>
    </section>

    <section class="tm-pane" data-pane-id="settings">
      <div class="tm-head">
        <h2>Settings</h2>
      </div>

      <div class="tm-settings-stack">
        <article class="tm-card">
          <details>
            <summary class="tm-card-summary"><h3>🗺️ Map Settings</h3></summary>
            <div class="tm-map-toolbar">
              <input id="tm-city-input" type="text" placeholder="Enter city (e.g. Salt Lake City)" />
              <button id="tm-center-city" type="button">Center City</button>
              <button id="tm-fit-stops" type="button">Fit Bus Stops</button>
            </div>
            <p class="tm-map-note" id="tm-map-status">Map is centered on available stop coordinates.</p>
          </details>
        </article>

        <article class="tm-card">
          <details>
            <summary class="tm-card-summary"><h3>🏫 School Destination</h3></summary>
            <p class="tm-map-note">This is the final destination for school-linked routes. Just type the address — the map location is found automatically.</p>
            <form method="POST" action="/transportation/manage/school-destination">
              <div class="tm-form-grid">
                <div class="tm-row">
                  <label for="schoolAddress">School Address</label>
                  <input id="schoolAddress" name="schoolAddress" required value="<%= schoolAddress || '' %>" placeholder="1746 W 400 N, Salt Lake City, UT" />
                </div>
                <div class="tm-row">
                  <label><input type="checkbox" name="applyToSchoolRoutes" value="1" checked /> Apply to all routes now</label>
                </div>
              </div>
              <button type="submit" class="tm-btn tm-btn--primary" style="margin-top:10px;">Save School Destination</button>
            </form>
          </details>
        </article>

        <article class="tm-card">
          <details>
            <summary class="tm-card-summary"><h3>📏 Distance &amp; Speed Units</h3></summary>
            <p class="tm-map-note">Controls how distances and speeds are shown to drivers and on live maps.</p>
            <form method="POST" action="/transportation/manage/units">
              <div class="tm-form-grid">
                <div class="tm-row">
                  <label for="distanceUnit">Units</label>
                  <select id="distanceUnit" name="distanceUnit">
                    <option value="km" <%= (distanceUnit || 'km') === 'km' ? 'selected' : '' %>>Kilometers (km, km/h)</option>
                    <option value="mi" <%= distanceUnit === 'mi' ? 'selected' : '' %>>Miles (mi, mph)</option>
                  </select>
                </div>
              </div>
              <button type="submit" class="tm-btn tm-btn--primary" style="margin-top:10px;">Save Units</button>
            </form>
          </details>
        </article>
      </div>

      <div class="tm-modal" id="edit-route-modal" aria-hidden="true">
        <div class="tm-modal-card" role="dialog" aria-modal="true" aria-labelledby="edit-route-title">
          <div class="tm-modal-head">
            <h3 class="tm-modal-title" id="edit-route-title">Edit Route</h3>
            <button class="tm-btn" type="button" id="close-edit-route-modal">Close</button>
          </div>

          <form id="edit-route-form">
            <input type="hidden" name="routeId" id="edit-route-id" />
            <section class="tm-modal-sect">
              <div class="tm-form-grid">
                <div class="tm-row"><label>Route Name</label><input name="routeName" required /></div>
                <div class="tm-row"><label>Route Code</label><input name="routeCode" /></div>
                <div class="tm-row"><label>Status</label><select name="routeStatus"><option value="active">active</option><option value="inactive">inactive</option></select></div>
                <div class="tm-row"><label>Map Provider</label><select name="mapProvider"><% (mapProviders || []).forEach(function(provider) { %><option value="<%= provider %>"><%= provider %></option><% }) %></select></div>
                <div class="tm-row"><label><input type="checkbox" name="useSchoolDestination" value="1" checked /> Use School Destination</label></div>
                <div class="tm-row" data-custom-destination-row><label>Destination Address</label><input name="destinationAddress" placeholder="Type an address — the map location is found automatically" /></div>
              </div>
              <div class="tm-row" style="margin-top:8px;">
                <label>Stops on this Route</label>
                <div class="tm-checkbox-list" id="edit-route-stops-list">
                  <% (stops || []).forEach(function(stop) { %>
                    <label class="tm-checkbox-list-item">
                      <input type="checkbox" name="stopIds" value="<%= stop.stop_id %>" data-stop-route-id="<%= stop.route_id || '' %>" />
                      <%= stop.stop_name %>
                    </label>
                  <% }) %>
                  <% if (!(stops || []).length) { %><p class="tm-map-note">No stops yet — add stops first, then attach them here.</p><% } %>
                </div>
              </div>
            </section>

            <div class="tm-toolbar" style="margin-top:10px;">
              <span id="edit-route-feedback" class="tm-map-note"></span>
              <button class="tm-btn tm-btn--primary" type="submit" id="submit-edit-route">Save Changes</button>
            </div>
          </form>
        </div>
      </div>

      <div class="tm-modal" id="edit-stop-modal" aria-hidden="true">
        <div class="tm-modal-card" role="dialog" aria-modal="true" aria-labelledby="edit-stop-title">
          <div class="tm-modal-head">
            <h3 class="tm-modal-title" id="edit-stop-title">Edit Stop</h3>
            <button class="tm-btn" type="button" id="close-edit-stop-modal">Close</button>
          </div>

          <form id="edit-stop-form">
            <input type="hidden" name="stopId" id="edit-stop-id" />
            <section class="tm-modal-sect">
              <div class="tm-form-grid">
                <div class="tm-row"><label>Route (optional)</label><select name="routeId"><option value="">No route yet — attach later</option><% (routes || []).forEach(function(route) { %><option value="<%= route.route_id %>"><%= route.route_name %></option><% }) %></select></div>
                <div class="tm-row"><label>Stop Name</label><input name="stopName" required /></div>
                <div class="tm-row"><label>Stop Address</label><input name="stopAddress" /></div>
                <div class="tm-row"><label>Latitude</label><input name="latitude" /></div>
                <div class="tm-row"><label>Longitude</label><input name="longitude" /></div>
                <div class="tm-row"><label>Pickup Time</label><input type="time" name="pickupTime" /></div>
                <div class="tm-row"><label>Dropoff Time</label><input type="time" name="dropoffTime" /></div>
                <div class="tm-row"><label>Stop Order</label><input name="stopOrder" type="number" min="0" /></div>
              </div>
              <p class="tm-map-note" id="edit-stop-pin-hint">Click the map to update this stop location.</p>
              <div id="edit-stop-picker-map" class="tm-stop-picker-map"></div>
            </section>

            <div class="tm-toolbar" style="margin-top:10px;">
              <span id="edit-stop-feedback" class="tm-map-note"></span>
              <button class="tm-btn tm-btn--primary" type="submit" id="submit-edit-stop">Save Changes</button>
            </div>
          </form>
        </div>
      </div>
    </section>

    <section class="tm-pane" data-pane-id="students">
      <div class="tm-head">
        <h2>Students</h2>
      </div>

      <div class="tm-grid">
        <article class="tm-card span-12">
          <h3>Student Transportation Status</h3>
          <p class="tm-map-note">Home pickup is supported. You can assign students with home address/coordinates and the system can map to nearest stop automatically.</p>
          <ul class="tm-list">
            <% const assignmentByStudentId = Object.fromEntries((assignments || []).map(function(a) { return [Number(a.student_id), a]; })); %>
            <% const groupedByClass = {}; %>
            <% (students || []).forEach(function(student) { %>
              <% const className = (student.class_name || 'Unassigned').trim() || 'Unassigned'; %>
              <% const classKey = student.class_id ? String(student.class_id) : '__unassigned__'; %>
              <% if (!groupedByClass[classKey]) groupedByClass[classKey] = { className: className, classId: student.class_id || null, students: [] }; %>
              <% groupedByClass[classKey].students.push(student); %>
            <% }) %>
            <% Object.keys(groupedByClass).forEach(function(classKey) { %>
              <% const classGroup = groupedByClass[classKey]; %>
              <% const sortedStudents = classGroup.students.slice().sort(function(a, b) {
                const aAssigned = assignmentByStudentId[Number(a.student_id)] ? 1 : 0;
                const bAssigned = assignmentByStudentId[Number(b.student_id)] ? 1 : 0;
                if (aAssigned !== bAssigned) return bAssigned - aAssigned;
                const aLast = String(a.last_name || '').toLowerCase();
                const bLast = String(b.last_name || '').toLowerCase();
                if (aLast !== bLast) return aLast.localeCompare(bLast);
                return String(a.first_name || '').toLowerCase().localeCompare(String(b.first_name || '').toLowerCase());
              }); %>
              <% const accessCount = sortedStudents.filter(function(s) { return !!assignmentByStudentId[Number(s.student_id)]; }).length; %>
              <li class="tm-class-group" data-class-group data-class-id="<%= classGroup.classId ? classGroup.classId : '__unassigned__' %>">
                <details>
                  <summary>Class: <%= classGroup.className %> (<%= sortedStudents.length %>) | With Bus Access: <%= accessCount %></summary>
                  <div class="tm-class-toolbar">
                    <button class="tm-btn" type="button" data-action="edit-class-access">Edit</button>
                    <span class="tm-class-edit-controls">
                      <label style="display:inline-flex;align-items:center;gap:6px;font-size:12px;color:#334155;">
                        <input type="checkbox" data-action="select-all-class" /> Select all
                      </label>
                      <button class="tm-btn tm-btn--primary" type="button" data-action="save-class-access">Save</button>
                      <button class="tm-btn" type="button" data-action="cancel-class-access">Cancel</button>
                    </span>
                    <% if (canBroadcastToGuardians && classGroup.classId) { %>
                    <button
                      class="tm-btn notify-guardians-btn"
                      type="button"
                      style="background:#f0fdf4;color:#166534;border-color:#bbf7d0;"
                      data-context="transportation"
                      data-context-id="<%= classGroup.classId %>"
                    >Notify Guardians</button>
                    <% } %>
                    <span class="tm-map-note" data-class-feedback></span>
                  </div>
                  <div class="tm-class-group-list">
                    <% sortedStudents.forEach(function(student) { %>
                      <% const assigned = assignmentByStudentId[Number(student.student_id)] || null; %>
                      <div class="tm-student-row" data-student-row>
                        <div class="tm-student-main">
                          <input
                            class="tm-student-check"
                            type="checkbox"
                            data-student-access-checkbox
                            value="<%= student.student_id %>"
                            data-initial-checked="<%= assigned ? '1' : '0' %>"
                            <%= assigned ? 'checked' : '' %>
                          />
                          <div>
                            <strong><%= student.last_name %> <%= student.first_name %></strong>
                            <span class="tm-student-access-tag <%= assigned ? 'tm-student-access-tag--yes' : 'tm-student-access-tag--no' %>"><%= assigned ? 'Bus access' : 'No bus access' %></span>
                            <br/>
                            Address: <%= student.address || '-' %>
                            | Bus: <%= assigned ? (assigned.bus_number || '-') : '-' %>
                            | Route: <%= assigned ? (assigned.route_name || '-') : '-' %>
                            | Stop: <%= assigned ? (assigned.stop_name || '-') : '-' %>
                            <br/>
                            <label style="display:inline-flex;align-items:center;gap:5px;font-size:11px;color:#334155;font-weight:400;">
                              <input
                                type="checkbox"
                                data-make-stop-checkbox
                                value="<%= student.student_id %>"
                                <%= (assigned && assigned.stop_id) ? 'checked' : '' %>
                                <%= student.address ? '' : 'disabled' %>
                              />
                              Make this student's address a stop (bus will pass through to pick them up)
                              <% if (!student.address) { %><em>(no address on file)</em><% } %>
                            </label>
                          </div>
                        </div>
                      </div>
                    <% }) %>
                  </div>
                </details>
              </li>
            <% }) %>
          </ul>
        </article>
      </div>
    </section>
  </main>
</div>

<script
  src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"
