    map.attributionControl.setPrefix(false);

    // This page can be background-preloaded (hidden, display:none) by the
    // Management hub before its tab is ever clicked. Leaflet measures the
    // container at init time, so a map built while hidden thinks it has
    // zero size and its zoom math stays wrong even after it's shown —
    // watch for the container actually getting real dimensions and fix it
    // up then, instead of only on the few explicit spots that already call
    // invalidateSize().
    if (typeof ResizeObserver !== 'undefined') {
      let lastKnownSize = 0;
      let hasFitSinceVisible = false;
      const mapResizeObserver = new ResizeObserver(function (entries) {
        const entry = entries[0];
        if (!entry) return;
        const size = entry.contentRect.width + entry.contentRect.height;
        if (size > 0 && size !== lastKnownSize) {
          addTilesWhenShown();
          const wasZero = lastKnownSize === 0;
          lastKnownSize = size;
          map.invalidateSize();
          // The very first time the container goes from zero size (hidden
          // background preload) to real size, the initial fitToStops() call
          // ran against that zero-size box and computed a useless fit (or
          // fell back to the whole-country default). Re-run it once now
          // that the map can actually measure itself, so the view lands on
          // the org's real stops/routes instead of staying stuck zoomed out.
          if (wasZero && !hasFitSinceVisible) {
            hasFitSinceVisible = true;
            void fitToStops();
          }
        }
      });
      mapResizeObserver.observe(mapEl);
      window.addEventListener('pagehide', () => mapResizeObserver.disconnect(), { once: true });
    }

