<script>
  // Overview buttons: go to the section, then open its Add form.
  document.addEventListener('click', function (e) {
    var b = e.target.closest('[data-tm-pane]');
    if (!b) return;
    var nav = document.querySelector('.tm-nav-btn[data-pane="' + b.dataset.tmPane + '"]');
    if (nav) nav.click();
    var open = b.dataset.tmClick && document.getElementById(b.dataset.tmClick);
    if (open) setTimeout(function () { open.click(); }, 60);
  });
</script>
