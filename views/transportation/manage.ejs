    function syncSelectAllCheckbox(classGroup) {
      const selectAll = classGroup.querySelector('[data-action="select-all-class"]');
      if (!selectAll) return;
      const checkboxes = Array.from(classGroup.querySelectorAll('[data-student-access-checkbox]'));
      if (!checkboxes.length) {
        selectAll.checked = false;
        return;
      }
      selectAll.checked = checkboxes.every((checkbox) => checkbox.checked);
    }

    classGroups.forEach((classGroup) => {
      const feedback = classGroup.querySelector('[data-class-feedback]');
      const editBtn = classGroup.querySelector('[data-action="edit-class-access"]');
      const selectAll = classGroup.querySelector('[data-action="select-all-class"]');
      const saveBtn = classGroup.querySelector('[data-action="save-class-access"]');
      const cancelBtn = classGroup.querySelector('[data-action="cancel-class-access"]');
      const checkboxes = Array.from(classGroup.querySelectorAll('[data-student-access-checkbox]'));

      if (editBtn) {
        editBtn.addEventListener('click', () => {
          classGroup.classList.add('is-editing');
          if (feedback) feedback.textContent = 'Edit mode enabled. Check students with bus access and save.';
          syncSelectAllCheckbox(classGroup);
        });
      }

      if (cancelBtn) {
        cancelBtn.addEventListener('click', () => {
          resetClassGroupSelection(classGroup);
          classGroup.classList.remove('is-editing');
          if (feedback) feedback.textContent = '';
          syncSelectAllCheckbox(classGroup);
        });
      }

      if (selectAll) {
        selectAll.addEventListener('change', () => {
          checkboxes.forEach((checkbox) => {
            checkbox.checked = selectAll.checked;
          });
        });
      }

      checkboxes.forEach((checkbox) => {
        checkbox.addEventListener('change', () => {
          syncSelectAllCheckbox(classGroup);
        });
      });

      if (saveBtn) {
        saveBtn.addEventListener('click', async () => {
          if (feedback) feedback.textContent = 'Saving student access...';
          saveBtn.disabled = true;

          try {
            const classId = classGroup.dataset.classId || '';
            const selectedIds = checkboxes.filter((checkbox) => checkbox.checked).map((checkbox) => checkbox.value);
            const allIds = checkboxes.map((checkbox) => checkbox.value);
            const makeStopIds = Array.from(classGroup.querySelectorAll('[data-make-stop-checkbox]:checked')).map((checkbox) => checkbox.value);

            const formData = new FormData();
            formData.append('classId', classId);
            allIds.forEach((id) => formData.append('allStudentIds', id));
            selectedIds.forEach((id) => formData.append('selectedStudentIds', id));
            makeStopIds.forEach((id) => formData.append('makeStopStudentIds', id));

            const result = await postForm('/transportation/manage/students/access', formData, {
              defaultError: 'Unable to update student bus access.',
            });

            if (feedback) feedback.textContent = (result.message || 'Student access updated.') + ' Refreshing...';
            window.setTimeout(() => window.location.reload(), makeStopIds.length ? 1600 : 300);
          } catch (error) {
            if (feedback) feedback.textContent = error.message || 'Unable to update student bus access.';
          } finally {
            saveBtn.disabled = false;
          }
        });
      }
    });

    async function drawLayers() {
      const currentRevision = ++drawRevision;
      mapLayer.clearLayers();
      busLayer.clearLayers();
      if (typeof liveBusMarkers !== 'undefined') liveBusMarkers.clear();
      const points = [];
      const grouped = {};
      const routeDrawTasks = [];
      const currentZoom = map.getZoom();
      const routeFilterId = getSelectedRouteFilterId();
      const allRoutesMode = !routeFilterId;
      const strokeScale = currentZoom >= 15 ? 1.8 : currentZoom >= 13 ? 1.5 : currentZoom >= 11 ? 1.25 : 1;
      const mainRouteInnerWeight = 3.4 * strokeScale;
      const mainRouteCasingWeight = mainRouteInnerWeight + 2.8;
      const customLegWeight = 2.6 * strokeScale;
      const stopRadius = allRoutesMode && currentZoom < 12
        ? Math.max(4, Math.min(8, Math.round(4.5 * strokeScale)))
        : Math.max(6, Math.min(11, Math.round(5.5 * strokeScale)));
      const stopFillOpacity = allRoutesMode && currentZoom < 12 ? 0.72 : 0.9;
      const schoolLat = Number.isFinite(schoolDestination.latitude) ? schoolDestination.latitude : null;
      const schoolLng = Number.isFinite(schoolDestination.longitude) ? schoolDestination.longitude : null;

      if (schoolLat !== null && schoolLng !== null) {
        const schoolMarker = L.marker([schoolLat, schoolLng], {
          icon: L.divIcon({
            className: '',
            html: '<div class="tm-school-pin" title="School Hub">🏫</div>',
            iconSize: [28, 28],
            iconAnchor: [14, 14],
            popupAnchor: [0, -10],
          }),
        });

        schoolMarker.bindPopup(
          '<strong>School Hub</strong>' +
          '<br/>Address: ' + (schoolDestination.address || '-')
        );
        schoolMarker.addTo(mapLayer);
        points.push([schoolLat, schoolLng]);
      }
      const filteredStops = routeFilterId
        ? geoStops.filter((stop) => Number(stop.routeId) === Number(routeFilterId))
        : geoStops;

      filteredStops.forEach((stop) => {
        const latlng = [stop.latitude, stop.longitude];
        points.push(latlng);

        const routeColor = colorForRoute(stop.routeId);
        const stopIconSize = Math.max(18, stopRadius * 2.4);
        const marker = L.marker(latlng, {
          icon: L.divIcon({
            className: '',
            html: '<div class="tm-stop-pin" style="width:' + stopIconSize + 'px;height:' + stopIconSize + 'px;border-color:' + routeColor + ';font-size:' + Math.round(stopIconSize * 0.55) + 'px;">🚏</div>',
            iconSize: [stopIconSize, stopIconSize],
            iconAnchor: [stopIconSize / 2, stopIconSize / 2],
            popupAnchor: [0, -stopIconSize / 2],
          }),
        });

        marker.bindTooltip(stop.stopName || 'Stop', { direction: 'top', offset: [0, -stopIconSize / 2], sticky: true });
        marker.bindPopup(
          '<strong>' + (stop.stopName || 'Stop') + '</strong>' +
          '<br/>Route: ' + (routeNameById[stop.routeId] || ('#' + String(stop.routeId || ''))) +
          '<br/>Address: ' + (stop.stopAddress || '-')
        );

        marker.addTo(mapLayer);

        if (!grouped[stop.routeId]) grouped[stop.routeId] = [];
        grouped[stop.routeId].push(stop);
      });

      Object.keys(grouped).forEach((routeId) => {
        const routeStops = grouped[routeId]
          .slice()
          .sort((a, b) => (a.stopOrder || 0) - (b.stopOrder || 0));
        const latlngs = routeStops
          .filter((entry) => Number.isFinite(entry.latitude) && Number.isFinite(entry.longitude))
          .map((entry) => [entry.latitude, entry.longitude]);

        const numericRouteId = Number(routeId);
        const routeMeta = routeMetaById[numericRouteId] || null;
        const useSchoolDestination = routeMeta ? Boolean(routeMeta.useSchoolDestination) : false;

        if (latlngs.length >= 2) {
          routeDrawTasks.push(
            (async () => {
              const routeGeometrySource = useSchoolDestination && schoolLat !== null && schoolLng !== null
                ? [[schoolLat, schoolLng], ...latlngs, [schoolLat, schoolLng]]
                : latlngs;
              const roadLatlngs = await fetchRoadGeometry(routeGeometrySource);
              if (currentRevision !== drawRevision) return;
              L.polyline(roadLatlngs, {
                color: '#ffffff',
                weight: mainRouteCasingWeight,
                opacity: 0.95,
              }).addTo(mapLayer);
              L.polyline(roadLatlngs, {
                color: colorForRoute(routeId),
                weight: mainRouteInnerWeight,
                opacity: 0.98,
              }).addTo(mapLayer);
            })()
          );
        }

        const destinationLat = routeMeta && !useSchoolDestination && Number.isFinite(routeMeta.destinationLatitude)
          ? routeMeta.destinationLatitude
          : (Number.isFinite(schoolDestination.latitude) ? schoolDestination.latitude : null);
        const destinationLng = routeMeta && !useSchoolDestination && Number.isFinite(routeMeta.destinationLongitude)
          ? routeMeta.destinationLongitude
          : (Number.isFinite(schoolDestination.longitude) ? schoolDestination.longitude : null);
        const destinationAddress = (routeMeta && !useSchoolDestination && routeMeta.destinationAddress)
          ? routeMeta.destinationAddress
          : (schoolDestination.address || 'School address');

        if (latlngs.length && destinationLat !== null && destinationLng !== null) {
          const lastStop = latlngs[latlngs.length - 1];
          const destinationPoint = [destinationLat, destinationLng];

          if (!useSchoolDestination) {
            const destinationPath = [lastStop, destinationPoint];
            routeDrawTasks.push(
              (async () => {
                const roadLeg = await fetchRoadGeometry(destinationPath);
                if (currentRevision !== drawRevision) return;

                L.polyline(roadLeg, {
                  color: '#ffffff',
                  weight: customLegWeight + 2,
                  opacity: 0.9,
                }).addTo(mapLayer);

                L.polyline(roadLeg, {
                  color: colorForRoute(routeId),
                  weight: customLegWeight,
                  opacity: 0.92,
                  dashArray: '6,6',
                }).addTo(mapLayer);

                L.circleMarker(destinationPoint, {
                  radius: 7,
                  color: '#0f172a',
                  fillColor: '#ffffff',
                  fillOpacity: 1,
                  weight: 2,
                })
                  .bindPopup(
                    '<strong>Route Destination</strong>' +
                    '<br/>Route: ' + (routeNameById[numericRouteId] || ('#' + String(numericRouteId))) +
                    '<br/>Address: ' + destinationAddress
                  )
                  .addTo(mapLayer);
              })()
            );
          }

          points.push([destinationLat, destinationLng]);
        }
      });

      const routeIdsWithStops = new Set(Object.keys(grouped).map((id) => Number(id)));
      const activeSchedules = schedulesForMap.filter((schedule) => {
        if (!schedule || !schedule.routeId || !schedule.busId) return false;
        if (String(schedule.status || '').toLowerCase() !== 'active') return false;
        if (routeFilterId && Number(schedule.routeId) !== Number(routeFilterId)) return false;
        return routeIdsWithStops.has(Number(schedule.routeId));
      });

      const renderedBusKeys = new Set();
      activeSchedules.forEach((schedule, idx) => {
        const routeStops = grouped[schedule.routeId] || grouped[String(schedule.routeId)] || [];
        if (!routeStops.length) return;

        const key = `${schedule.busId}-${schedule.routeId}`;
        if (renderedBusKeys.has(key)) return;
        renderedBusKeys.add(key);

        const anchorStop = routeStops[Math.min(routeStops.length - 1, idx % routeStops.length)];
        const lat = Number(anchorStop.latitude);
        const lng = Number(anchorStop.longitude);
        if (!Number.isFinite(lat) || !Number.isFinite(lng)) return;

        const bus = busById[schedule.busId] || null;
        if (!bus || !bus.driverUserId) return; // never show a bus with no real, current driver
        const routeName = routeNameById[schedule.routeId] || '';
        const marker = L.marker([lat, lng], {
          icon: L.divIcon({
            className: '',
            html: '<div class="tm-bus-pin" title="Bus">' + '🚌' + '</div>',
            iconSize: [24, 24],
            iconAnchor: [12, 12],
            popupAnchor: [0, -10],
          }),
        });

        marker.bindPopup(buildBusPopup(schedule, bus, routeName));
        marker.addTo(busLayer);
      });

      await Promise.allSettled(routeDrawTasks);
      if (currentRevision !== drawRevision) {
        return {
          points: [],
          busCount: 0,
        };
      }

      return {
        points,
        busCount: busLayer.getLayers().length,
      };
    }

    async function fitToStops() {
      const drawState = await drawLayers();
      const points = drawState.points.slice();
      // Fall back to whatever's actually on the map (live/scheduled bus
      // markers) when there are no stop/school coordinates to fit to, so
      // the view never gets stuck at the whole-country default zoom while
      // a real bus pin is sitting there.
      busLayer.eachLayer((layer) => {
        if (typeof layer.getLatLng === 'function') points.push(layer.getLatLng());
      });

      if (!points.length) {
        mapStatus.textContent = 'No stop or bus coordinates found for the selected route filter.';
        return;
      }

      const bounds = L.latLngBounds(points);
      const hasSpread = bounds.getNorthEast().distanceTo(bounds.getSouthWest()) > 50;
      if (hasSpread) {
        map.fitBounds(bounds.pad(0.18), { maxZoom: 16 });
      } else {
        // A single point (or several on top of each other) — fitBounds on
        // that alone can leave Leaflet at its default/minimum zoom, so
        // center directly with a sensible close-in zoom instead.
        map.setView(bounds.getCenter(), 15);
      }

      const routeFilterId = getSelectedRouteFilterId();
      const selectedRouteName = routeFilterId ? (routeNameById[routeFilterId] || `Route #${routeFilterId}`) : null;
      mapStatus.textContent = selectedRouteName
        ? `Map fitted to ${selectedRouteName}. Route loop shows School -> Stops -> School. ${drawState.busCount} bus marker(s).`
        : `Map fitted to active route loops, stops, and school hub 🏫. ${drawState.busCount} bus marker(s).`;
    }

    // Live bus movement: while a trip is active on a route, poll its real
    // GPS position and glide the marker there instead of leaving it parked
    // at a static schedule-anchor stop.
    const liveBusMarkers = new Map();
    let liveBusPollInFlight = false;

    async function pollLiveBuses() {
      if (liveBusPollInFlight) return;
      liveBusPollInFlight = true;
      try {
        const routeIds = Object.keys(routeNameById).map(Number);
        await Promise.allSettled(routeIds.map(async (routeId) => {
          let response;
          try {
            response = await fetch(`/transportation/live/route/${routeId}`, { credentials: 'same-origin' });
          } catch (_error) {
            return;
          }
          if (!response.ok) return;
          const payload = await response.json().catch(() => null);
          const live = payload && payload.data;
          const lat = live ? Number(live.latitude) : null;
          const lng = live ? Number(live.longitude) : null;
          const existing = liveBusMarkers.get(routeId);

          if (!Number.isFinite(lat) || !Number.isFinite(lng)) {
            if (existing) { existing.remove(); liveBusMarkers.delete(routeId); }
            return;
          }

          if (existing) {
            existing.setLatLng([lat, lng]);
          } else {
            const bus = busById[live.bus_id] || null;
            const marker = L.marker([lat, lng], {
              icon: L.divIcon({
                className: '',
                html: '<div class="tm-bus-pin" title="Live bus">🚌</div>',
                iconSize: [24, 24],
                iconAnchor: [12, 12],
                popupAnchor: [0, -10],
              }),
              zIndexOffset: 1000,
            }).addTo(busLayer);
            liveBusMarkers.set(routeId, marker);
            marker.bindPopup(buildBusPopup({ dayOfWeek: null }, bus, routeNameById[routeId]));
          }
        }));
      } finally {
        liveBusPollInFlight = false;
      }
    }

    const initialLiveBusPoll = pollLiveBuses();
    const liveBusPollTimer = window.setInterval(pollLiveBuses, 10000);
    window.addEventListener('pagehide', () => window.clearInterval(liveBusPollTimer), { once: true });

    async function centerByCity() {
      const city = String(cityInput.value || '').trim();
      if (!city) {
        mapStatus.textContent = 'Enter a city to center the map.';
        return;
      }

      mapStatus.textContent = 'Locating city...';
      try {
        const response = await fetch('https://nominatim.openstreetmap.org/search?format=json&limit=1&q=' + encodeURIComponent(city));
        const payload = await response.json();

        if (!Array.isArray(payload) || !payload.length) {
          mapStatus.textContent = 'City not found. Try a more specific city or area name.';
          return;
        }

        const result = payload[0];
        const lat = Number(result.lat);
        const lon = Number(result.lon);

        if (!Number.isFinite(lat) || !Number.isFinite(lon)) {
          mapStatus.textContent = 'City lookup did not return valid coordinates.';
          return;
        }

        map.setView([lat, lon], 12);
        mapStatus.textContent = 'Centered on ' + city + '.';
      } catch (_error) {
        mapStatus.textContent = 'Unable to center by city right now. Check internet access and retry.';
      }
    }

    // Wait for the first live-GPS poll (capped so a slow/offline bus
    // tracker can never delay the initial view) so a moving bus is already
    // on the map before we decide what to fit/zoom to.
    Promise.race([initialLiveBusPoll, new Promise((resolve) => setTimeout(resolve, 1500))])
      .catch(() => {})
      .then(() => void fitToStops());
    centerCityBtn.addEventListener('click', centerByCity);
    fitStopsBtn.addEventListener('click', () => {
      void fitToStops();
    });
    if (routeFilterSelect) {
      routeFilterSelect.addEventListener('change', () => {
        void fitToStops();
      });
    }

    const guessedCity = geoStops.find((stop) => stop.stopAddress && stop.stopAddress.includes(','));
    if (guessedCity) {
      const segments = guessedCity.stopAddress.split(',').map((part) => part.trim()).filter(Boolean);
      if (segments.length) {
        cityInput.value = segments[segments.length - 1];
      }
    }

    setTimeout(() => {
      map.invalidateSize();
    }, 120);

    map.on('zoomend', () => {
      void drawLayers();
    });

    navButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        setTimeout(() => {
          map.invalidateSize();
          if (btn.dataset.pane === 'overview') {
            void fitToStops();
          }
        }, 120);
      });
    });
  })();
</script>
<script src="/js/guardianBroadcast.js"></script>
<script>
  document.addEventListener('click', function (e) {
    var btn = e.target.closest('.notify-guardians-btn');
    if (!btn) return;
    e.preventDefault();
    e.stopPropagation();
    openGuardianBroadcast({
      context: btn.dataset.context || 'transportation',
      contextId: btn.dataset.contextId || '',
    });
  });
</script>
