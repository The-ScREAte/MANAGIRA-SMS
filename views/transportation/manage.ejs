    // A bus now has exactly one assigned driver — picking a bus fills the
    // driver in automatically instead of asking for it separately.
    function updateScheduleDriverDisplay() {
      const busSelect = document.getElementById('schedule-bus-select');
      const driverDisplay = document.getElementById('schedule-driver-display');
      const driverIdField = document.getElementById('schedule-driver-id');
      if (!busSelect || !driverDisplay || !driverIdField) return;
      const match = scheduleDriverByBusId[busSelect.value];
      if (match) {
        driverDisplay.value = match.driverName;
        driverIdField.value = match.driverId;
      } else {
        driverDisplay.value = busSelect.value ? 'No driver assigned to this bus yet' : '';
        driverIdField.value = '';
      }
    }

    // Multiple buses CAN share a route — this just warns so it's a deliberate
    // choice, not a surprise overlap discovered later.
    function checkScheduleRouteWarning() {
      const busSelect = document.getElementById('schedule-bus-select');
      const routeSelect = document.getElementById('schedule-route-select');
      const warningEl = document.getElementById('schedule-route-warning');
      if (!busSelect || !routeSelect || !warningEl) return;
      const busId = Number(busSelect.value);
      const routeId = Number(routeSelect.value);
      if (!busId || !routeId) {
        warningEl.style.display = 'none';
        return;
      }
      const otherBuses = scheduleRouteUsage
        .filter((entry) => Number(entry.routeId) === routeId && Number(entry.busId) !== busId)
        .map((entry) => entry.busNumber)
        .filter((value, index, arr) => value && arr.indexOf(value) === index);
      if (otherBuses.length) {
        warningEl.textContent = 'Heads up: ' + otherBuses.join(', ') + ' already run' + (otherBuses.length > 1 ? '' : 's') + ' this route. Multiple buses can share a route — just make sure that\'s intended.';
        warningEl.style.display = 'block';
      } else {
        warningEl.style.display = 'none';
      }
    }

