<%#
  managira.com: the public homepage, for a K-12 student information system. Outcome-led copy,
  full-screen stories with real people (Unsplash licence) and the real app (captured from a test
  school with sample names), in the Snyk-style dark look. Shared head, header and footer are in
  views/home/partials; menus, icons and brand marks in utils/landing.js.
%><%
  const icon = lp.icon;
  const product = lp.product;
  const brand = lp.brand;
  const RINGS = [
    { tone: 'teal', label: 'For school leaders', verb: 'Runs', title: 'The Whole<br>School', href: '#leaders' },
    { tone: 'aqua', label: 'For teachers & students', verb: 'Empowers', title: 'Every<br>Learner', href: '#classroom' },
    { tone: 'gold', label: 'For families & community', verb: 'Connects', title: 'Every<br>Family', href: '#families' },
  ];
  const TRUST = ['amazonwebservices', 'stripe', 'whatsapp', 'twilio', 'googleclassroom', 'googlecalendar', 'visa', 'mastercard', 'okta', 'owasp', 'snyk'];
  const STORIES = [
    { id: 'leaders', photo: 'school', tone: 'teal', eyebrow: 'For school leaders', title: 'See it all.', accent: 'Act sooner.', text: 'Real-time insight across every classroom, campus and office, so decisions rest on facts, not spreadsheets.', points: ['Live numbers, never last month\'s', 'Board-ready reports in one click', 'Every campus side by side'], shot: { src: '/images/site/app-reports.webp', w: 1600, h: 2011, kind: 'desk', alt: 'The Managira Reports page: organization statistics for the term, with enrollment, average score, pass rate, attendance, class and subject performance, top students, enrollment over terms and staff by role' }, link: { label: 'Explore analytics & reporting', href: product('student', 'analytics-reporting') } },
    { id: 'classroom', photo: 'teachers', tone: 'aqua', eyebrow: 'For teachers', title: 'Less admin.', accent: 'More teaching.', text: 'Routine work takes minutes, not evenings, so teachers get back to what they do best.', points: ['Every class task in one workspace', 'Quizzes that grade themselves', 'Parents updated automatically'], moments: [{ icon: 'attendance', title: 'Attendance saved', text: '7th Grade · 21 of 21 present', time: '8:02 AM' }, { icon: 'exam', title: 'Quiz graded', text: 'Science · class average 88%', time: '11:40 AM' }, { icon: 'calendar', title: 'Tasks scheduled', text: '3 tasks set for next week', time: '2:10 PM' }, { icon: 'report', title: 'Report cards ready', text: 'Shared with 21 families', time: '3:15 PM' }], link: { label: 'Explore teaching & learning', href: product('student') } },
    { id: 'families', photo: 'students', tone: 'gold', eyebrow: 'For families', title: 'Every family.', accent: 'In the loop.', text: 'Instant updates on their phone, so no family is left wondering how the day went.', points: ['Every child under one login', 'Fees paid in a few taps', 'A heads-up when the bus is near'], shot: { src: '/images/site/app-parent.webp', w: 600, h: 1298, kind: 'phone', alt: 'The Managira parent portal on a phone: a welcome for the parent, their inbox, and each child with bus tracking' }, link: { label: 'Explore family engagement', href: product('family') } },
    { id: 'students', photo: 'families', tone: 'aqua', eyebrow: 'For students', title: 'Always know', accent: 'what\'s next.', text: 'A portal students actually want to open, with classes, work and results a tap away on any device.', points: ['Today\'s schedule and what\'s due', 'Grades the moment they\'re posted', 'Tests online, no paper needed'], moments: [{ icon: 'clock', title: 'Next class', text: 'Algebra · 10:15 AM, Room 204', time: 'now' }, { icon: 'chart', title: 'New grade posted', text: 'English essay · A (94%)', time: '12m' }, { icon: 'exam', title: 'Test opens today', text: 'Biology unit test · 1:00 PM', time: '1h' }], link: { label: 'Explore the student portal', href: product('student', 'student-portal') } },
  ];
  const PILLARS = [
    { icon: 'users', title: 'Student Information System', text: 'A single, accurate record for every student, from enrollment to graduation.', href: product('student', 'student-records-attendance') },
    { icon: 'exam', title: 'Teaching & Learning', text: 'Grading, assessment and reporting that keep learning on track.', href: product('student', 'assessment-tracking') },
    { icon: 'home', title: 'Family & Student Engagement', text: 'Timely, two-way communication families and students rely on.', href: product('family', 'parent-portal') },
    { icon: 'wallet', title: 'Business Operations', text: 'Billing, staffing and school services that run quietly in the background.', href: product('operational', 'finance-management') },
    { icon: 'chart', title: 'Analytics & Reporting', text: 'Dashboards and reports that turn school data into decisions.', href: product('student', 'analytics-reporting') },
    { icon: 'network', title: 'District & Network Management', text: 'Consistent standards and shared oversight across all your schools.', href: product('operational', 'hub-management') },
  ];
  const INTEGRATIONS = [
    { title: 'Payments', items: ['stripe', 'visa', 'mastercard', 'applepay', 'googlepay'] },
    { title: 'Communications', items: ['whatsapp', 'twilio', 'Email'] },
    { title: 'Learning & calendars', items: ['googleclassroom', 'googlecalendar', 'Outlook Calendar', 'iCal feeds'] },
    { title: 'Identity & single sign-on', items: ['google', 'Microsoft Entra ID', 'okta', 'auth0', 'OneLogin', 'JumpCloud', 'ClassLink', 'Clever'] },
  ];
  const API_POINTS = [
    'Students, guardians, staff, classes and terms',
    'Attendance, grades, events and announcements',
    'Fees, balances and payments',
    'Transportation routes, stops and assignments',
    'Incremental sync: only what changed',
  ];
  const STATS = [
    { value: '99.9%', label: 'Uptime guaranteed' },
    { value: '24/7', label: 'Dedicated support' },
    { value: '15 min', label: 'To set up your school' },
    { value: '100%', label: 'Cloud-based, nothing to install' },
  ];
  const SECURITY = [
    { icon: 'key', title: 'Role-based access', text: 'Every person sees and does only what their role allows.' },
    { icon: 'lock', title: 'Secure sign-in', text: 'Single sign-on, verification codes and trusted devices.' },
    { icon: 'audit', title: 'Audit trails', text: 'Who changed what, and when, is on record.' },
    { icon: 'shield', title: 'Privacy & compliance', text: 'Encrypted, isolated school data. FERPA and GDPR compliant.' },
  ];
  const STEPS = [
    { n: '01', title: 'Set up your school', text: 'Your school year, classes and staff, ready in under 15 minutes.' },
    { n: '02', title: 'Bring in your data', text: 'Import what you have today, or start fresh in one guided flow.' },
    { n: '03', title: 'Go live', text: 'Staff, students and families are up and running from day one.' },
  ];
  const RESOURCES = [
    { icon: 'play', title: 'Product tour', text: 'See Managira in action, screen by screen.', href: '/legal/app-demo' },
    { icon: 'doc', title: 'Documentation', text: 'Setup and usage guides for every role.', href: '/legal/user-documentation' },
    { icon: 'help', title: 'FAQ', text: 'Quick answers to common questions.', href: '/legal/faq' },
    { icon: 'message', title: 'Help center', text: 'Talk to our team when you need us.', href: '/legal/help' },
  ];
%><%- include('partials/top') %>
  <%- include('../partials/homeStructuredData') %>
</head>
<body class="lp">
<%- include('partials/header') %>
  <main id="main">
    <!-- Hero: the promise, actions and the three rings, all in the first screen -->
    <section class="lp-hero lp-hero--home">
      <div class="lp-hero__glow" aria-hidden="true"></div>
      <div class="lp-wrap lp-hero__inner">
        <p class="lp-pill">The student information system for K-12 schools and districts</p>
        <h1 class="lp-hero__title">Manage smarter &mdash; <span class="lp-grad lp-nowrap">not harder</span></h1>
        <p class="lp-hero__lead">Bring your whole school community together. Fewer tools to juggle, cleaner data to act on, and more of every day given back to learning.</p>
        <div class="lp-hero__cta">
          <a class="lp-btn lp-btn--light lp-btn--lg" href="/legal/request-demo">Request a demo</a>
          <a class="lp-btn lp-btn--ghost lp-btn--lg" href="/legal/app-demo"><%- icon('play', 16) %> Take the product tour</a>
        </div>

        <div class="lp-rings" aria-label="Who Managira is for">
          <% RINGS.forEach((ring, i) => { %>
            <div class="lp-rings__cell">
              <p class="lp-rings__label lp-tone-<%= ring.tone %>"><%= ring.label %></p>
              <a class="lp-ring lp-ring--<%= ring.tone %>" href="<%= ring.href %>">
                <span class="lp-ring__outer" aria-hidden="true"></span>
                <span class="lp-ring__inner" aria-hidden="true"></span>
                <span class="lp-ring__orbit" aria-hidden="true"><i></i></span>
                <span class="lp-ring__body">
                  <span class="lp-ring__verb"><%= ring.verb %></span>
                  <span class="lp-ring__title"><%- ring.title %></span>
                  <span class="lp-ring__more">Discover <%- icon('arrow', 15) %></span>
                </span>
              </a>
            </div>
            <% if (i < RINGS.length - 1) { %>
              <div class="lp-rings__link" aria-hidden="true"><span></span><span></span><span></span><span></span><span></span></div>
            <% } %>
          <% }) %>
          <div class="lp-rings__base" aria-hidden="true"><span>One connected school</span></div>
        </div>
      </div>
    </section>

    <!-- Trust -->
    <section class="lp-trust" aria-label="Secured and integrated with">
      <p class="lp-eyebrow">Secured and integrated with</p>
      <div class="lp-marquee">
        <div class="lp-marquee__track">
          <% [0, 1].forEach((copy) => { %>
            <% TRUST.forEach((key) => { %><span class="lp-logo-item"<%- copy ? ' aria-hidden="true"' : '' %>><%- brand(key, 22) %></span><% }) %>
          <% }) %>
        </div>
      </div>
    </section>

    <!-- Stories: real people, one screen each, the real app on top -->
    <div class="lp-stories">
      <% STORIES.forEach((s, i) => { %>
        <section class="lp-story <%= s.shot ? 'lp-story--' + s.shot.kind : 'lp-story--moments' %><%= i % 2 ? ' lp-story--flip' : '' %>" id="<%= s.id %>" aria-labelledby="story-<%= s.id %>">
          <picture class="lp-story__photo" aria-hidden="true">
            <source media="(max-width: 900px)" srcset="/images/site/photo-<%= s.photo %>-960.webp">
            <img src="/images/site/photo-<%= s.photo %>-1920.webp" width="1920" height="1280" alt="" <%- i === 0 ? '' : 'loading="lazy"' %> decoding="async">
          </picture>
          <div class="lp-story__shade" aria-hidden="true"></div>
          <div class="lp-wrap lp-story__inner">
            <div class="lp-story__text" data-reveal>
              <p class="lp-eyebrow lp-tone-<%= s.tone %>"><%= s.eyebrow %></p>
              <h2 class="lp-story__title" id="story-<%= s.id %>"><%= s.title %> <span class="lp-grad"><%= s.accent %></span></h2>
              <p class="lp-story__lead"><%= s.text %></p>
              <ul class="lp-checks">
                <% s.points.forEach((point) => { %><li><%- icon('check', 16) %> <%= point %></li><% }) %>
              </ul>
              <a class="lp-more" href="<%= s.link.href %>"><%= s.link.label %> <%- icon('arrow', 16) %></a>
            </div>
            <% if (s.shot) { %>
              <figure class="lp-story__shot lp-story__shot--<%= s.shot.kind %>" style="--ar: <%= (s.shot.w / s.shot.h).toFixed(3) %>" data-reveal>
                <% if (s.shot.kind === 'desk') { %><div class="lp-story__bar" aria-hidden="true"><span></span><span></span><span></span><b>managira.com</b></div><% } %>
                <img src="<%= s.shot.src %>" width="<%= s.shot.w %>" height="<%= s.shot.h %>" alt="<%= s.shot.alt %>" loading="lazy" decoding="async">
              </figure>
            <% } else { %>
              <ul class="lp-moments lp-tone-<%= s.tone %>" data-reveal aria-label="Moments from Managira">
                <% s.moments.forEach((m) => { %>
                  <li class="lp-moment"><span class="lp-moment__icon"><%- icon(m.icon, 18) %></span><span class="lp-moment__body"><strong><%= m.title %></strong><small><%= m.text %></small></span><time><%= m.time %></time></li>
                <% }) %>
              </ul>
            <% } %>
          </div>
        </section>
      <% }) %>
    </div>

    <!-- Pillars -->
    <section class="lp-section" id="platform">
      <div class="lp-wrap">
        <div class="lp-head" data-reveal>
          <p class="lp-eyebrow">The Managira platform</p>
          <h2 class="lp-h2">One platform. <span class="lp-grad">Every part of your school.</span></h2>
          <p class="lp-lead">Retire the patchwork of disconnected apps. Every office works from the same live record.</p>
        </div>
        <div class="lp-pillars">
          <% PILLARS.forEach((item) => { %>
            <a class="lp-glass lp-pillar" href="<%= item.href %>" data-reveal>
              <span class="lp-tile__icon"><%- icon(item.icon, 20) %></span>
              <h3><%= item.title %></h3>
              <p><%= item.text %></p>
              <span class="lp-pillar__more">Learn more <%- icon('arrow', 14) %></span>
            </a>
          <% }) %>
        </div>
      </div>
    </section>

    <!-- Mira -->
    <section class="lp-section lp-section--tight">
      <div class="lp-wrap">
        <div class="lp-glass lp-mira" data-reveal>
          <div class="lp-mira__text">
            <img class="lp-mira__mark" src="/images/site/mira-mark.webp" width="72" height="66" alt="" loading="lazy" decoding="async">
            <p class="lp-eyebrow lp-tone-aqua">Mira AI assistant</p>
            <h2 class="lp-h2">Ask. <span class="lp-grad">It's done.</span></h2>
            <p class="lp-lead">Your AI assistant, built into the SIS. Ask a question or hand off a task, and Mira answers from your school's own data, acting only within each person's permissions.</p>
            <a class="lp-btn lp-btn--light" href="/legal/mira-ai-assistant">Meet Mira <%- icon('arrow', 16) %></a>
          </div>
          <div class="lp-chat" aria-hidden="true">
            <p class="lp-chat__me">Which Grade 7 students are below 90% attendance this term?</p>
            <p class="lp-chat__mira">6 students in Grade 7 are below 90%. Would you like me to draft a message to their families?</p>
            <p class="lp-chat__me">Yes, please.</p>
            <p class="lp-chat__mira">Done. 6 drafts are ready for your review.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Stats -->
    <section class="lp-stats" aria-label="Managira in numbers">
      <div class="lp-wrap lp-stats__grid">
        <% STATS.forEach((stat) => { %>
          <div data-reveal><strong class="lp-grad"><%= stat.value %></strong><span><%= stat.label %></span></div>
        <% }) %>
      </div>
    </section>

    <!-- Integrations -->
    <section class="lp-section" id="integrations">
      <div class="lp-wrap">
        <div class="lp-head" data-reveal>
          <p class="lp-eyebrow">Integrations &amp; interoperability</p>
          <h2 class="lp-h2">Works with the tools you already use.</h2>
        </div>
        <div class="lp-integrations">
          <% INTEGRATIONS.forEach((group) => { %>
            <div class="lp-glass lp-integrations__group" data-reveal>
              <h3><%= group.title %></h3>
              <ul>
                <% group.items.forEach((key) => { %><li><%- brand(key, 18) %></li><% }) %>
              </ul>
            </div>
          <% }) %>
        </div>
        <div class="lp-glass lp-api" data-reveal>
          <div class="lp-api__text">
            <p class="lp-eyebrow lp-tone-aqua"><%- icon('code', 14) %> Open API</p>
            <h3>Connect your own systems.</h3>
            <p>Give each app its own service account and keep your other systems in sync, read-only and only with the access you grant.</p>
            <ul class="lp-checks">
              <% API_POINTS.forEach((point) => { %><li><%- icon('check', 16) %> <%= point %></li><% }) %>
            </ul>
          </div>
          <pre class="lp-code" aria-label="Example request"><span class="lp-code__m">GET</span> /api/v1/students?class_id=12
<span class="lp-code__k">Authorization:</span> Bearer &bull;&bull;&bull;&bull;&bull;&bull;&bull;&bull;

<span class="lp-code__ok">200 OK</span>
{
  <span class="lp-code__k">"data"</span>: [
    { <span class="lp-code__k">"id"</span>: 1042, <span class="lp-code__k">"first_name"</span>: <span class="lp-code__s">"Emma"</span>,
      <span class="lp-code__k">"class_name"</span>: <span class="lp-code__s">"Grade 4"</span>, <span class="lp-code__k">"status"</span>: <span class="lp-code__s">"active"</span> }
  ],
  <span class="lp-code__k">"has_more"</span>: false
}</pre>
        </div>
        <p class="lp-center" data-reveal><a class="lp-more" href="/legal/request-demo">Need another integration? Talk to us <%- icon('arrow', 16) %></a></p>
      </div>
    </section>

    <!-- Security -->
    <section class="lp-section lp-section--tight" id="security">
      <div class="lp-wrap">
        <div class="lp-glass lp-safe" data-reveal>
          <div class="lp-safe__head">
            <p class="lp-eyebrow lp-tone-teal">Security &amp; privacy</p>
            <h2 class="lp-h2">Trust, <span class="lp-grad">built in.</span></h2>
            <p class="lp-lead">Student data stays private, protected and in the right hands, from sign-in to storage.</p>
          </div>
          <div class="lp-safe__grid">
            <% SECURITY.forEach((item) => { %>
              <div><span class="lp-tile__icon"><%- icon(item.icon, 20) %></span><h3><%= item.title %></h3><p><%= item.text %></p></div>
            <% }) %>
          </div>
        </div>
      </div>
    </section>

    <!-- Implementation -->
    <section class="lp-section lp-section--tight">
      <div class="lp-wrap">
        <div class="lp-head" data-reveal>
          <p class="lp-eyebrow">Implementation</p>
          <h2 class="lp-h2">Live in days, not semesters.</h2>
        </div>
        <ol class="lp-steps">
          <% STEPS.forEach((step) => { %>
            <li class="lp-glass" data-reveal><span class="lp-steps__n lp-grad"><%= step.n %></span><h3><%= step.title %></h3><p><%= step.text %></p></li>
          <% }) %>
        </ol>
      </div>
    </section>

    <!-- Resources -->
    <section class="lp-section lp-section--tight">
      <div class="lp-wrap">
        <div class="lp-head" data-reveal>
          <p class="lp-eyebrow">Resources</p>
          <h2 class="lp-h2">Get to know Managira.</h2>
        </div>
        <div class="lp-resources">
          <% RESOURCES.forEach((item) => { %>
            <a class="lp-glass lp-pillar" href="<%= item.href %>" data-reveal>
              <span class="lp-tile__icon"><%- icon(item.icon, 20) %></span>
              <h3><%= item.title %></h3>
              <p><%= item.text %></p>
              <span class="lp-pillar__more">Open <%- icon('arrow', 14) %></span>
            </a>
          <% }) %>
        </div>
      </div>
    </section>

    <!-- Closing -->
    <section class="lp-section lp-close">
      <div class="lp-close__glow" aria-hidden="true"></div>
      <div class="lp-wrap">
        <h2 class="lp-h2 lp-close__title" data-reveal>Let's build a better school day.</h2>
        <div class="lp-close__grid">
          <div class="lp-glass" data-reveal>
            <h3>Request a demo</h3>
            <p>A walkthrough tailored to your school.</p>
            <a class="lp-btn lp-btn--light" href="/legal/request-demo">Request a demo</a>
          </div>
          <div class="lp-glass" data-reveal>
            <h3>Start your free trial</h3>
            <p>30 days free on any plan.</p>
            <a class="lp-btn lp-btn--ghost" href="/account/service-plan">Get started</a>
          </div>
          <div class="lp-glass" data-reveal>
            <h3>Talk to us</h3>
            <p>Questions about pricing or setup? We're here to help.</p>
            <a class="lp-btn lp-btn--ghost" href="/legal/help">Contact us</a>
          </div>
        </div>
      </div>
    </section>
  </main>
<%- include('partials/footer') %>
</body>
</html>
