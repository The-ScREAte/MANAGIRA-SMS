<!DOCTYPE html>
<html lang="en">
<head>
  <link rel="stylesheet" href="/css/globalScale.css">
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Email Suppression Manager</title>
  <link rel="stylesheet" href="/css/admin.css" />
  <style>
    :root {
      --font-family: "<%= (session && session.fontStyle ? String(session.fontStyle).trim() : 'Inter') %>", sans-serif;
      --surface: #ffffff;
      --surface-soft: #f8fafc;
      --border: #dbe3ea;
      --text: #0f172a;
      --muted: #64748b;
      --primary: #01535b;
      --primary-strong: #01444b;
      --danger: #b91c1c;
      --danger-soft: #fef2f2;
      --radius-lg: 18px;
      --shadow: 0 14px 32px rgba(15, 23, 42, 0.08);
    }

    * { box-sizing: border-box; }

    body {
      margin: 0;
      font-family: var(--font-family);
      color: var(--text);
      background:
        radial-gradient(circle at top right, rgba(1, 83, 91, 0.1), transparent 40%),
        linear-gradient(180deg, #f8fbfc 0%, #f1f5f9 100%);
    }

    .sup-page {
      max-width: 1180px;
      margin: 0 auto;
      padding: 24px 16px 44px;
    }

    .sup-hero {
      background: linear-gradient(135deg, #0f172a 0%, #134e4a 100%);
      color: #fff;
      border-radius: 24px;
      padding: 22px 22px;
      margin-bottom: 18px;
      box-shadow: var(--shadow);
    }

    .sup-hero h1 {
      margin: 0 0 6px;
      font-size: clamp(1.25rem, 3vw, 1.85rem);
      letter-spacing: -0.02em;
    }

    .sup-hero p {
      margin: 0;
      opacity: 0.88;
      line-height: 1.45;
      font-size: 0.93rem;
    }

    .sup-grid {
      display: grid;
      grid-template-columns: 280px minmax(0, 1fr);
      gap: 14px;
      align-items: start;
    }

    .sup-card {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: var(--radius-lg);
      box-shadow: var(--shadow);
      padding: 14px;
    }

    .sup-card h2 {
      margin: 0 0 12px;
      font-size: 1rem;
      letter-spacing: -0.01em;
    }

    .sup-meta {
      color: var(--muted);
      margin: 0 0 8px;
      font-size: 0.84rem;
    }

    .sup-stat {
      display: grid;
      gap: 4px;
      padding: 10px;
      border-radius: 12px;
      border: 1px solid #dbeafe;
      background: #eff6ff;
      margin-bottom: 12px;
    }

    .sup-stat strong {
      font-size: 1.55rem;
      line-height: 1;
      color: #1d4ed8;
    }

    .sup-stat span {
      color: #1e3a8a;
      font-size: 0.78rem;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      font-weight: 700;
    }

    .sup-form {
      display: grid;
      gap: 10px;
    }

    .sup-form label {
      font-size: 0.82rem;
      font-weight: 700;
      color: var(--muted);
    }

    .sup-input {
      width: 100%;
      border: 1px solid var(--border);
      border-radius: 12px;
      padding: 11px 12px;
      font: inherit;
      color: var(--text);
      background: #fff;
    }

    .sup-input:focus {
      outline: none;
      border-color: color-mix(in srgb, var(--primary) 70%, #fff);
      box-shadow: 0 0 0 4px rgba(1, 83, 91, 0.14);
    }

    .sup-btn {
      border: 0;
      border-radius: 12px;
      padding: 10px 12px;
      font: inherit;
      font-weight: 700;
      cursor: pointer;
      transition: transform 0.15s ease, box-shadow 0.15s ease;
      text-decoration: none;
      display: inline-flex;
      justify-content: center;
      align-items: center;
    }

    .sup-btn:hover {
      transform: translateY(-1px);
      box-shadow: 0 10px 22px rgba(15, 23, 42, 0.14);
    }

    .sup-btn-primary {
      background: var(--primary);
      color: #fff;
    }

    .sup-btn-primary:hover {
      background: var(--primary-strong);
    }

    .sup-btn-ghost {
      background: #f1f5f9;
      color: #0f172a;
      border: 1px solid var(--border);
    }

    .sup-table-shell {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: var(--radius-lg);
      box-shadow: var(--shadow);
      overflow: hidden;
    }

    .sup-table-wrap {
      width: 100%;
      overflow-x: auto;
    }

    .sup-table {
      width: 100%;
      border-collapse: collapse;
      min-width: 860px;
    }

    .sup-table th {
      text-align: left;
      background: var(--surface-soft);
      color: #334155;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      font-size: 0.73rem;
      padding: 11px 12px;
      border-bottom: 1px solid var(--border);
      white-space: nowrap;
    }

    .sup-table td {
      padding: 12px;
      border-bottom: 1px solid var(--border);
      vertical-align: top;
      font-size: 0.9rem;
    }

    .sup-table tr:last-child td {
      border-bottom: 0;
    }

    .sup-email {
      font-weight: 700;
      word-break: break-word;
    }

    .sup-org {
      color: #1e3a8a;
      font-size: 0.84rem;
      margin-top: 4px;
    }

    .sup-reason {
      display: inline-block;
      padding: 4px 8px;
      border-radius: 999px;
      font-size: 0.76rem;
      font-weight: 700;
      background: #fef3c7;
      color: #92400e;
      text-transform: uppercase;
      letter-spacing: 0.04em;
    }

    .sup-error {
      font-size: 0.8rem;
      color: #7f1d1d;
      background: var(--danger-soft);
      border: 1px solid #fecaca;
      border-radius: 8px;
      padding: 6px 8px;
      max-width: 360px;
      word-break: break-word;
    }

    .sup-empty {
      padding: 30px 20px;
      text-align: center;
      color: var(--muted);
      font-size: 0.92rem;
    }

    .sup-remove-form {
      margin: 0;
      display: inline-flex;
      align-items: center;
      gap: 8px;
    }

    .sup-remove-btn {
      border: 1px solid #fecaca;
      background: #fff;
      color: var(--danger);
      border-radius: 10px;
      padding: 8px 11px;
      font-size: 0.82rem;
      font-weight: 700;
      cursor: pointer;
    }

    .sup-remove-btn:hover {
      background: #fff1f2;
    }

    @media (max-width: 980px) {
      .sup-grid {
        grid-template-columns: 1fr;
      }

      .sup-card,
      .sup-table-shell {
        border-radius: 14px;
      }
    }
  </style>
</head>
<body>
  <div class="sup-page">
    <section class="sup-hero">
      <h1>Email Suppression Manager</h1>
      <p>Review all blocked email addresses and remove suppression when an address has been corrected and should receive messages again.</p>
    </section>

    <%- include('../partials/flash') %>

    <section class="sup-grid">
      <aside class="sup-card">
        <h2>Quick Controls</h2>
        <p class="sup-meta">Use search to filter by email or reason.</p>

        <div class="sup-stat">
          <strong><%= Number(totalSuppressed || 0) %></strong>
          <span>Suppressed Emails</span>
        </div>

        <form class="sup-form" method="GET" action="/admin/email-suppressions">
          <label for="supSearch">Search</label>
          <input
            id="supSearch"
            class="sup-input"
            type="text"
            name="q"
            value="<%= searchTerm || '' %>"
            placeholder="email or reason"
          />
          <button type="submit" class="sup-btn sup-btn-primary">Apply Filter</button>
          <a href="/admin/email-suppressions" class="sup-btn sup-btn-ghost">Clear</a>
        </form>
      </aside>

      <section class="sup-table-shell">
        <% if (!Array.isArray(suppressedEmails) || suppressedEmails.length === 0) { %>
          <div class="sup-empty">No suppression entries found for this filter.</div>
        <% } else { %>
          <div class="sup-table-wrap">
            <table class="sup-table">
              <thead>
                <tr>
                  <th>Email</th>
                  <th>Reason</th>
                  <th>Count</th>
                  <th>Last Error</th>
                  <th>Last Seen</th>
                  <th>Action</th>
                </tr>
              </thead>
              <tbody>
                <% suppressedEmails.forEach((row) => { %>
                  <tr>
                    <td>
                      <div class="sup-email"><%= row.email %></div>
                      <% if (row.organization_name) { %>
                        <div class="sup-org"><%= row.organization_name %> (ID <%= row.organization_id %>)</div>
                      <% } %>
                    </td>
                    <td><span class="sup-reason"><%= row.reason || 'smtp_failure' %></span></td>
                    <td><%= Number(row.failure_count || 0) %></td>
                    <td>
                      <% if (row.last_error) { %>
                        <div class="sup-error"><%= row.last_error %></div>
                      <% } else { %>
                        <span class="sup-meta">-</span>
                      <% } %>
                    </td>
                    <td><%= row.last_seen ? new Date(row.last_seen).toLocaleString() : '-' %></td>
                    <td>
                      <form
                        class="sup-remove-form"
                        method="POST"
                        action="/admin/email-suppressions/remove"
                        onsubmit="return confirm('Remove suppression for ' + '<%= String(row.email).replace(/'/g, "\\'") %>' + '?');"
                      >
                        <input type="hidden" name="email" value="<%= row.email %>" />
                        <button type="submit" class="sup-remove-btn">Remove</button>
                      </form>
                    </td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        <% } %>
      </section>
    </section>
  </div>
</body>
</html>
