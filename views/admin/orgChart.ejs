<style>
  /* ============================================================
     Org Chart Page — premium tree visualization
     ============================================================ */
  .oc-page { max-width: 1400px; margin: 28px auto 80px; padding: 0 16px; }
  .oc-head { text-align: center; margin-bottom: 22px; }
  .oc-head h1 {
    margin: 0; font-size: 1.7rem; color: #0f172a; letter-spacing: -0.015em;
    font-weight: 800;
  }
  .oc-head h1 .oc-accent {
    background: linear-gradient(135deg, #01535b, #0891b2);
    -webkit-background-clip: text; background-clip: text; color: transparent;
  }
  .oc-head p { margin: 6px 0 0; color: #64748b; font-size: 0.95rem; }

  .oc-flash { margin: 0 auto 16px; padding: 11px 14px; border-radius: 10px; font-size: 0.9rem; max-width: 640px; }
  .oc-flash.success { background: #dcfce7; color: #166534; border: 1px solid #bbf7d0; }
  .oc-flash.error   { background: #fee2e2; color: #991b1b; border: 1px solid #fecaca; }

  /* Canvas wrapper with subtle grid */
  .oc-canvas {
    overflow-x: auto; overflow-y: visible;
    background:
      radial-gradient(circle at 50% 0, rgba(8,145,178,.06), transparent 60%),
      radial-gradient(circle, #e2e8f0 1px, transparent 1px) 0 0 / 22px 22px,
      linear-gradient(180deg, #f8fafc, #ffffff);
    border: 1px solid #e2e8f0; border-radius: 18px;
    padding: 44px 18px 36px;
    box-shadow: 0 2px 6px rgba(15,23,42,.04);
    text-align: center;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: thin;
  }

  /* ============== Tree (CSS connectors) ============== */
  .oc-tree, .oc-tree ul {
    list-style: none; margin: 0; padding: 0; position: relative;
    display: inline-flex; justify-content: center;
  }
  .oc-tree { padding-top: 6px; min-width: 100%; }
  .oc-tree ul { padding-top: 40px; }

  .oc-tree li {
    position: relative; padding: 0 16px; text-align: center;
    display: flex; flex-direction: column; align-items: center;
  }

  /* Parent-to-branch connector */
  .oc-tree li > ul::before {
    content: ''; position: absolute; top: -28px; left: 50%;
    width: 2px; height: 28px; background: #64748b;
    transform: translateX(-50%);
    z-index: 0;
  }

  /* Shared branch bar spanning all children */
  .oc-tree li > ul::after {
    content: ''; position: absolute; top: 0; left: 32px; right: 32px;
    border-top: 2px solid #64748b;
    z-index: 0;
  }

  .oc-tree li > ul.oc-branch--single::after {
    display: none;
  }

  /* Vertical connector from each node up to its row line */
  .oc-tree li > .oc-node-wrap::before {
    content: ''; position: absolute; top: -40px; left: 50%;
    width: 2px; height: 40px; background: #64748b; margin-left: -1px;
    z-index: 0;
  }
  .oc-tree > li > .oc-node-wrap::before { display: none; }

  .oc-tree li > ul.oc-branch--single > li > .oc-node-wrap::before {
    top: -28px;
    height: 28px;
  }

  /* Animated dot traveling down each connector */
  .oc-tree li > .oc-node-wrap::after {
    content: ''; position: absolute; top: -36px; left: 50%;
    width: 6px; height: 6px; margin-left: -3px; border-radius: 50%;
    background: #0891b2; opacity: 0;
    box-shadow: 0 0 0 3px rgba(8,145,178,.18);
    animation: ocPulse 2.4s ease-in-out infinite;
    z-index: 0; pointer-events: none;
  }
  .oc-tree > li > .oc-node-wrap::after { display: none; }
  @keyframes ocPulse {
    0%   { transform: translateY(0);   opacity: 0; }
    25%  { opacity: 1; }
    75%  { opacity: 1; }
    100% { transform: translateY(32px); opacity: 0; }
  }

  /* ============== Node Card ============== */
  .oc-node-wrap {
    position: relative; display: inline-flex; flex-direction: column; align-items: center;
    z-index: 2;  /* sit above sibling connector lines */
  }
  .oc-node {
    position: relative; display: inline-flex; flex-direction: column; align-items: center;
    background: #ffffff; border: 1px solid #e5e7eb; border-radius: 16px;
    padding: 16px 18px 14px; min-width: 220px; max-width: 250px;
    box-shadow: 0 2px 4px rgba(15,23,42,.04), 0 1px 0 rgba(15,23,42,.02);
    transition: box-shadow .18s ease, transform .18s ease, border-color .18s ease;
    cursor: pointer;
    z-index: 2;
    width: 100%;
    box-sizing: border-box;
  }
  .oc-node:hover {
    box-shadow: 0 16px 36px rgba(15,23,42,.12);
    transform: translateY(-3px);
    border-color: #99f6e4;
  }
  /* Role-colored top accent bar */
  .oc-node::before {
    content: ''; position: absolute; top: 0; left: 14px; right: 14px; height: 4px;
    border-radius: 0 0 4px 4px;
  }
  .oc-node[data-role="Admin"]::before          { background: linear-gradient(90deg,#047857,#10b981); }
  .oc-node[data-role="Mini Admin"]::before     { background: linear-gradient(90deg,#1d4ed8,#3b82f6); }
  .oc-node[data-role="Internal Worker"]::before{ background: linear-gradient(90deg,#b45309,#f59e0b); }

  .oc-avatar {
    width: 70px; height: 70px; border-radius: 50%;
    background: linear-gradient(135deg, #01535b, #0891b2);
    color: #fff; font-weight: 700; font-size: 1.35rem;
    display: inline-flex; align-items: center; justify-content: center;
    overflow: hidden;
    border: 4px solid #fff;
    box-shadow: 0 8px 18px rgba(1,83,91,.28), 0 0 0 1px rgba(15,23,42,.06);
    margin-top: -36px;
    position: relative; z-index: 3;  /* above any connector line */
  }
  .oc-avatar img { width: 100%; height: 100%; object-fit: cover; }

  .oc-node .oc-name {
    margin: 12px 0 2px; font-size: 1rem; font-weight: 700; color: #0f172a;
    line-height: 1.25; max-width: 220px;
    overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
  }
  .oc-node .oc-title {
    margin: 0; font-size: 0.82rem; color: #475569; font-weight: 600;
    max-width: 220px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
  }
  .oc-node .oc-email {
    margin: 6px 0 0; font-size: 0.72rem; color: #94a3b8;
    max-width: 220px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
  }

  /* Reports indicator badge */
  .oc-reports-badge {
    position: absolute; top: 8px; right: 10px;
    background: #ecfeff; color: #0e7490; border: 1px solid #a5f3fc;
    border-radius: 999px; padding: 2px 8px;
    font-size: 0.66rem; font-weight: 700; letter-spacing: 0.04em;
    display: inline-flex; align-items: center; gap: 4px;
  }
  .oc-reports-badge::before {
    content: ''; width: 6px; height: 6px; border-radius: 50%;
    background: #0891b2; box-shadow: 0 0 0 3px rgba(8,145,178,.18);
  }

  /* Bio toggle */
  .oc-bio-toggle {
    margin-top: 10px;
    background: #f8fafc; border: 1px solid #e2e8f0; color: #475569;
    font-size: 0.76rem; font-weight: 600; cursor: pointer;
    display: inline-flex; align-items: center; gap: 6px;
    padding: 4px 10px; border-radius: 999px;
    transition: all .15s ease;
  }
  .oc-bio-toggle:hover { color: #01535b; background: #ecfeff; border-color: #a5f3fc; }
  .oc-bio-toggle .oc-chev {
    display: inline-block; transition: transform .18s ease;
    font-size: 0.7rem;
  }
  .oc-node-wrap.bio-open .oc-bio-toggle .oc-chev { transform: rotate(180deg); }

  .oc-bio {
    display: none;
    margin-top: 10px;
    background: #f8fafc; border: 1px solid #e5e7eb; border-radius: 12px;
    padding: 12px 14px; max-width: 250px;
    font-size: 0.82rem; color: #334155; line-height: 1.5;
    white-space: pre-wrap; word-wrap: break-word; text-align: left;
    box-shadow: inset 0 1px 0 rgba(15,23,42,.02);
  }
  .oc-node-wrap.bio-open .oc-bio { display: block; animation: ocFade .18s ease; }
  @keyframes ocFade { from { opacity: 0; transform: translateY(-4px); } to { opacity: 1; transform: translateY(0); } }

  /* Reports collapse toggle (the +/− pill at the bottom) */
  .oc-children-toggle {
    position: absolute; bottom: -14px; left: 50%; transform: translateX(-50%);
    background: #fff; border: 1.5px solid #cbd5e1; color: #0f172a;
    width: 28px; height: 28px; border-radius: 50%; cursor: pointer;
    font-size: 0.95rem; line-height: 1; font-weight: 700;
    display: inline-flex; align-items: center; justify-content: center;
    z-index: 2; box-shadow: 0 4px 10px rgba(15,23,42,.08);
    transition: all .15s ease;
  }
  .oc-children-toggle:hover {
    border-color: #01535b; color: #01535b; transform: translateX(-50%) scale(1.08);
  }
  li.collapsed > ul { display: none; }
  li.collapsed > .oc-node-wrap .oc-children-toggle::before { content: '+'; }
  li:not(.collapsed) > .oc-node-wrap .oc-children-toggle::before { content: '−'; }

  .oc-empty { color: #64748b; padding: 24px 0; text-align: center; }
  .oc-empty-cta {
    margin-top: 8px; font-size: 0.85rem;
  }
  .oc-empty-cta a { color: #0891b2; font-weight: 600; }

  /* ============== Modal Editor ============== */
  .oc-modal-backdrop {
    position: fixed; inset: 0;
    background: rgba(15,23,42,.52);
    display: none; align-items: center; justify-content: center;
    z-index: 9999; padding: 20px;
    overflow-y: auto;
  }
  .oc-modal-backdrop.open { display: flex; animation: ocFade .15s ease; }
  .oc-modal {
    background: #fff; border-radius: 18px; width: 100%; max-width: 540px;
    box-shadow: 0 18px 40px rgba(15,23,42,.18);
    max-height: min(92vh, 860px); overflow: hidden;
    display: flex; flex-direction: column;
    box-sizing: border-box;
  }
  .oc-modal__head {
    padding: 18px 22px; border-bottom: 1px solid #e5e7eb;
    display: flex; align-items: center; justify-content: space-between;
    flex-shrink: 0;
  }
  .oc-modal__head h3 {
    margin: 0; font-size: 1.05rem; color: #0f172a; font-weight: 700;
    overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
  }
  .oc-modal__close {
    background: transparent; border: 0; font-size: 1.6rem; color: #64748b;
    cursor: pointer; line-height: 1; padding: 0 4px; flex-shrink: 0;
  }
  .oc-modal__close:hover { color: #0f172a; }
  .oc-modal__body {
    padding: 18px 22px; overflow-y: auto; flex: 1;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
    align-items: start;
  }
  .oc-field {
    margin-bottom: 0;
    background: #ffffff;
    border: 1px solid #e5e7eb;
    border-radius: 14px;
    padding: 14px;
    box-shadow: none;
  }
  .oc-field--full { grid-column: 1 / -1; }
  .oc-field--compact {
    min-width: 0;
  }
  .oc-field label {
    display: block; margin-bottom: 6px;
    font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.06em;
    color: #475569; font-weight: 700;
  }
  .oc-field input[type="text"],
  .oc-field select,
  .oc-field textarea {
    border: 1px solid #d1d5db; border-radius: 10px; padding: 11px 13px;
    font-size: 15px; font-family: inherit; color: #0f172a; width: 100%;
    background: #fff; box-sizing: border-box;
    transition: border-color .15s ease, box-shadow .15s ease;
  }
  .oc-field input[type="text"]:focus,
  .oc-field select:focus,
  .oc-field textarea:focus {
    outline: none; border-color: #0891b2;
    box-shadow: 0 0 0 3px rgba(8,145,178,.15);
  }
  .oc-field textarea { min-height: 100px; resize: vertical; line-height: 1.5; }
  .oc-field input[type="file"] {
    width: 100%; padding: 8px; border: 1px dashed #cbd5e1;
    border-radius: 10px; background: #fff; font-size: 0.85rem;
    box-sizing: border-box;
  }
  .oc-field-hint {
    display: block; margin-top: 5px; font-size: 0.75rem; color: #94a3b8;
    text-transform: none; letter-spacing: 0; font-weight: 500;
  }
  .oc-modal__foot {
    padding: 14px 22px 18px; border-top: 1px solid #e5e7eb;
    display: flex; gap: 10px; justify-content: flex-end;
    flex-shrink: 0; background: #fff;
    flex-wrap: wrap;
  }
  .oc-btn-save {
    background: #01535b; color: #fff; border: 0; padding: 11px 18px;
    border-radius: 10px; font-weight: 700; cursor: pointer; font-size: 0.92rem;
    transition: background .15s ease;
  }
  .oc-btn-save:hover { background: #047a85; }
  .oc-btn-cancel {
    background: #fff; color: #475569; border: 1px solid #cbd5e1;
    padding: 11px 18px; border-radius: 10px; font-weight: 600;
    cursor: pointer; font-size: 0.92rem;
    transition: all .15s ease;
  }
  .oc-btn-cancel:hover { border-color: #94a3b8; color: #0f172a; background: #f8fafc; }

  @media (max-width: 1024px) {
    .oc-page { padding: 0 14px; }
    .oc-canvas { padding: 40px 14px 30px; }
    .oc-tree li { padding: 0 12px; }
    .oc-tree li > ul::after { left: 24px; right: 24px; }
    .oc-node { min-width: 200px; max-width: 220px; }
    .oc-node .oc-name,
    .oc-node .oc-title,
    .oc-node .oc-email { max-width: 184px; }
  }

  @media (max-width: 820px) {
    .oc-head { margin-bottom: 18px; }
    .oc-head h1 { font-size: 1.45rem; }
    .oc-head p { font-size: 0.88rem; max-width: 560px; margin-left: auto; margin-right: auto; }
    .oc-canvas { padding: 36px 10px 26px; }
    .oc-tree ul { padding-top: 36px; }
    .oc-tree li { padding: 0 8px; }
    .oc-tree li > ul::before { top: -24px; height: 24px; }
    .oc-tree li > ul::after { left: 16px; right: 16px; }
    .oc-tree li > .oc-node-wrap::before { top: -36px; height: 36px; }
    .oc-node { min-width: 184px; max-width: 196px; padding: 14px 12px 12px; }
    .oc-avatar { width: 62px; height: 62px; margin-top: -34px; font-size: 1.15rem; }
    .oc-node .oc-name { font-size: 0.94rem; max-width: 164px; }
    .oc-node .oc-title { font-size: 0.76rem; max-width: 164px; }
    .oc-node .oc-email { font-size: 0.68rem; max-width: 164px; }
    .oc-bio { max-width: 196px; }
    .oc-modal { max-width: 92vw; }
  }

  @media (max-width: 700px) {
    .oc-page { margin-top: 16px; padding: 0 10px; }
    .oc-head h1 { font-size: 1.35rem; }
    .oc-head p  { font-size: 0.85rem; }
    .oc-canvas { padding: 32px 8px 24px; border-radius: 12px; }
    .oc-tree ul { padding-top: 34px; }
    .oc-tree li { padding: 0 7px; }
    .oc-tree li > ul::before { top: -22px; height: 22px; }
    .oc-tree li > ul::after { left: 18px; right: 18px; }
    .oc-tree li > .oc-node-wrap::before { top: -34px; height: 34px; }
    .oc-tree li > ul.oc-branch--single > li > .oc-node-wrap::before { top: -22px; height: 22px; }
    .oc-node { min-width: 170px; max-width: 200px; padding: 13px 12px 11px; }
    .oc-avatar { width: 58px; height: 58px; margin-top: -32px; font-size: 1.1rem; }
    .oc-node .oc-name { font-size: 0.92rem; max-width: 170px; }
    .oc-node .oc-title { font-size: 0.78rem; max-width: 170px; }
    .oc-node .oc-email { font-size: 0.7rem; max-width: 170px; }
    .oc-bio { max-width: 200px; font-size: 0.78rem; padding: 10px 12px; }
    .oc-reports-badge { top: 6px; right: 8px; padding: 2px 6px; font-size: 0.6rem; }
    .oc-modal { border-radius: 14px; }
    .oc-modal__head { padding: 14px 18px; }
    .oc-modal__body {
      padding: 16px 18px;
      grid-template-columns: 1fr;
      gap: 12px;
    }
    .oc-modal__foot { padding: 12px 18px 16px; }
    .oc-field--full { grid-column: auto; }
  }
  @media (max-width: 560px) {
    .oc-page { padding: 0 8px; margin-top: 12px; }
    .oc-head h1 { font-size: 1.2rem; }
    .oc-head p { font-size: 0.8rem; line-height: 1.45; }
    .oc-flash { font-size: 0.84rem; padding: 10px 12px; margin-bottom: 12px; }
    .oc-canvas {
      padding: 28px 6px 20px;
      border-radius: 10px;
    }
    .oc-tree { min-width: max-content; padding-top: 2px; }
    .oc-tree ul { padding-top: 28px; }
    .oc-tree li { padding: 0 6px; }
    .oc-tree li > ul::before { top: -18px; height: 18px; }
    .oc-tree li > ul::after { left: 12px; right: 12px; }
    .oc-tree li > .oc-node-wrap::before { top: -28px; height: 28px; }
    .oc-tree li > ul.oc-branch--single > li > .oc-node-wrap::before { top: -18px; height: 18px; }
    .oc-node { min-width: 156px; max-width: 168px; padding: 12px 10px 10px; border-radius: 14px; }
    .oc-avatar { width: 52px; height: 52px; margin-top: -28px; font-size: 1rem; }
    .oc-node .oc-name { font-size: 0.86rem; max-width: 142px; }
    .oc-node .oc-title { font-size: 0.72rem; max-width: 142px; }
    .oc-node .oc-email { font-size: 0.64rem; max-width: 142px; }
    .oc-bio-toggle { font-size: 0.72rem; padding: 4px 8px; }
    .oc-bio { max-width: 168px; font-size: 0.74rem; padding: 9px 10px; }
    .oc-reports-badge {
      top: 5px; right: 6px; padding: 2px 5px; font-size: 0.56rem; gap: 3px;
      max-width: 86px; overflow: hidden; white-space: nowrap; text-overflow: ellipsis;
    }
    .oc-children-toggle { width: 24px; height: 24px; bottom: -12px; font-size: 0.85rem; }
    .oc-modal-backdrop {
      align-items: flex-start;
      padding: 10px;
    }
    .oc-modal {
      max-width: 100%;
      width: 100%;
      max-height: none;
      min-height: 0;
      border-radius: 12px;
      margin: auto 0;
      overflow: visible;
    }
    .oc-modal__head { padding: 12px 14px; }
    .oc-modal__head h3 { font-size: 0.96rem; padding-right: 8px; }
    .oc-modal__body {
      padding: 12px 14px;
      gap: 10px;
      overflow: visible;
      flex: 0 1 auto;
    }
    .oc-field { padding: 12px; border-radius: 12px; }
    .oc-field label { font-size: 0.68rem; }
    .oc-field input[type="text"],
    .oc-field select,
    .oc-field textarea { font-size: 16px; padding: 10px 11px; }
    .oc-field textarea { min-height: 92px; }
    .oc-field-hint { font-size: 0.72rem; }
    .oc-modal__foot {
      padding: 12px 14px 14px;
      flex-direction: column-reverse;
      align-items: stretch;
      position: static;
    }
    .oc-btn-save,
    .oc-btn-cancel {
      width: 100%;
      justify-content: center;
      display: inline-flex;
      align-items: center;
    }
  }
  @media (max-width: 420px) {
    .oc-head h1 { font-size: 1.08rem; }
    .oc-canvas { padding: 24px 4px 18px; }
    .oc-node { min-width: 142px; max-width: 150px; }
    .oc-node .oc-name, .oc-node .oc-title, .oc-node .oc-email { max-width: 128px; }
    .oc-bio { max-width: 150px; }
    .oc-reports-badge { max-width: 72px; }
    .oc-modal-backdrop { padding: 8px; }
    .oc-modal__head { padding: 10px 12px; }
    .oc-modal__body { padding: 10px 12px; }
    .oc-modal__foot { padding: 10px 12px 12px; }
    .oc-field { padding: 10px; }
  }
</style>

<div class="oc-page">
  <div class="oc-head">
    <h1>Team <span class="oc-accent">Org Chart</span></h1>
    <p>Visual hierarchy of the Managira team — leaders at the top, reports cascading below.</p>
  </div>

  <% if (messages && messages.success && messages.success.length) { %>
    <div class="oc-flash success"><%= messages.success.join(' ') %></div>
  <% } %>
  <% if (messages && messages.error && messages.error.length) { %>
    <div class="oc-flash error"><%= messages.error.join(' ') %></div>
  <% } %>

  <%
    function ocInitials(m){
      const a = (m.first_name||'').trim().charAt(0);
      const b = (m.last_name||'').trim().charAt(0);
      return ((a+b) || (m.email||'?').charAt(0)).toUpperCase();
    }
    function ocFullName(m){
      return ((m.first_name||'') + ' ' + (m.last_name||'')).trim() || (m.email || 'Unnamed');
    }

    const byId = new Map();
    members.forEach(m => byId.set(m.user_id, m));

    const childrenOf = new Map();
    const roots = [];
    members.forEach(m => {
      const supId = m.supervisor_user_id;
      const hasParent = supId && byId.has(supId) && supId !== m.user_id;
      if (hasParent) {
        if (!childrenOf.has(supId)) childrenOf.set(supId, []);
        childrenOf.get(supId).push(m);
      } else {
        roots.push(m);
      }
    });

    const roleOrder = { 'Admin': 1, 'Mini Admin': 2, 'Internal Worker': 3 };
    const sortFn = (a,b) => {
      const pa = Number.isFinite(Number(a.org_chart_position)) ? Number(a.org_chart_position) : Number.MAX_SAFE_INTEGER;
      const pb = Number.isFinite(Number(b.org_chart_position)) ? Number(b.org_chart_position) : Number.MAX_SAFE_INTEGER;
      if (pa !== pb) return pa - pb;
      const ra = roleOrder[a.account_type] || 9;
      const rb = roleOrder[b.account_type] || 9;
      if (ra !== rb) return ra - rb;
      return ocFullName(a).localeCompare(ocFullName(b));
    };
    roots.sort(sortFn);
    childrenOf.forEach(arr => arr.sort(sortFn));

    // Recursive descendant count for the indicator badge
    function countDescendants(id){
      const kids = childrenOf.get(id) || [];
      let n = kids.length;
      kids.forEach(k => { n += countDescendants(k.user_id); });
      return n;
    }
  %>

  <% function renderNode(m, locals) {
       const kids = locals.childrenOf.get(m.user_id) || [];
       const bio = (m.org_role_description || '').trim();
       const totalReports = locals.countDescendants(m.user_id);
  %>
    <li>
      <div class="oc-node-wrap">
        <div class="oc-node"
             data-role="<%= m.account_type %>"
             data-id="<%= m.user_id %>"
             onclick="ocOpenEdit(<%= m.user_id %>)">
          <% if (totalReports > 0) { %>
            <span class="oc-reports-badge" title="Total reports (direct + indirect)">
              <%= totalReports %> <%= totalReports === 1 ? 'report' : 'reports' %>
            </span>
          <% } %>
          <div class="oc-avatar">
            <% if (m.profile_image_url) { %>
              <img src="<%= m.profile_image_url %>" alt="<%= ocFullName(m) %>" loading="lazy">
            <% } else { %><%= ocInitials(m) %><% } %>
          </div>
          <p class="oc-name" title="<%= ocFullName(m) %>"><%= ocFullName(m) %></p>
          <% if (m.org_role_title) { %>
            <p class="oc-title" title="<%= m.org_role_title %>"><%= m.org_role_title %></p>
          <% } %>
          <% if (m.email) { %>
            <p class="oc-email" title="<%= m.email %>"><%= m.email %></p>
          <% } %>
          <% if (bio) { %>
            <button type="button" class="oc-bio-toggle"
                    onclick="event.stopPropagation(); this.closest('.oc-node-wrap').classList.toggle('bio-open');">
              <span>About</span>
              <span class="oc-chev">▾</span>
            </button>
          <% } %>
          <% if (kids.length) { %>
            <button type="button" class="oc-children-toggle"
                    onclick="event.stopPropagation(); this.closest('li').classList.toggle('collapsed');"
                    aria-label="Toggle reports"></button>
          <% } %>
        </div>
        <% if (bio) { %>
          <div class="oc-bio"><%= bio %></div>
        <% } %>
      </div>
      <% if (kids.length) { %>
        <ul class="oc-branch <%= kids.length === 1 ? 'oc-branch--single' : '' %>">
          <% kids.forEach(function(c){ renderNode(c, locals); }); %>
        </ul>
      <% } %>
    </li>
  <% } %>

  <% if (!members.length) { %>
    <div class="oc-canvas">
      <p class="oc-empty">No admin-side users found yet.</p>
      <p class="oc-empty-cta"><a href="/admin/superSettings">Create the first team member →</a></p>
    </div>
  <% } else { %>
    <div class="oc-canvas">
      <ul class="oc-tree">
        <% roots.forEach(function(r){ renderNode(r, { childrenOf: childrenOf, countDescendants: countDescendants }); }); %>
      </ul>
    </div>
  <% } %>
</div>

<!-- ============== Edit Modal ============== -->
<div class="oc-modal-backdrop" id="ocModal" onclick="if(event.target===this) ocCloseEdit()">
  <div class="oc-modal" role="dialog" aria-modal="true" aria-labelledby="ocModalTitle">
    <div class="oc-modal__head">
      <h3 id="ocModalTitle">Edit team member</h3>
      <button type="button" class="oc-modal__close" onclick="ocCloseEdit()" aria-label="Close">×</button>
    </div>
    <form id="ocEditForm" method="POST" enctype="multipart/form-data">
      <div class="oc-modal__body">
        <div class="oc-field">
          <label for="ocFieldRoleTitle">Custom role title</label>
          <input type="text" name="roleTitle" id="ocFieldRoleTitle" maxlength="120"
                 placeholder="e.g. Head of Operations">
        </div>
        <div class="oc-field">
          <label for="ocFieldSupervisor">Reports to (supervisor)</label>
          <select name="supervisorUserId" id="ocFieldSupervisor">
            <option value="">— No supervisor (top-level) —</option>
            <% members.forEach(function(o){ %>
              <option value="<%= o.user_id %>" data-self="<%= o.user_id %>">
                <%= ocFullName(o) %>
              </option>
            <% }); %>
          </select>
        </div>
        <div class="oc-field">
          <label for="ocFieldRowPosition">Position on row</label>
          <select name="rowPosition" id="ocFieldRowPosition"></select>
        </div>
        <div class="oc-field">
          <label for="ocFieldImage">Profile picture</label>
          <input type="file" name="profileImage" id="ocFieldImage" accept="image/*">
        </div>
      </div>
      <div class="oc-modal__foot">
        <button type="button" class="oc-btn-cancel" onclick="ocCloseEdit()">Cancel</button>
        <button type="submit" class="oc-btn-save">Save changes</button>
      </div>
    </form>
  </div>
</div>

<script>
(function(){
  window.__OC_MEMBERS__ = <%- JSON.stringify(members.map(m => ({
    id: m.user_id,
    name: ((m.first_name||'') + ' ' + (m.last_name||'')).trim() || m.email || 'Unnamed',
    title: m.org_role_title || '',
    desc: m.org_role_description || '',
    supervisor: m.supervisor_user_id || '',
    rowPosition: m.org_chart_position || ''
  }))).replace(/</g, '\\u003c') %>;

  const modal = document.getElementById('ocModal');
  const form = document.getElementById('ocEditForm');
  const titleEl = document.getElementById('ocModalTitle');
  const fTitle = document.getElementById('ocFieldRoleTitle');
  const fSup = document.getElementById('ocFieldSupervisor');
  const fRowPosition = document.getElementById('ocFieldRowPosition');

  function sortMembers(members) {
    return members.slice().sort(function(a, b) {
      const pa = Number(a.rowPosition) || Number.MAX_SAFE_INTEGER;
      const pb = Number(b.rowPosition) || Number.MAX_SAFE_INTEGER;
      if (pa !== pb) return pa - pb;
      return a.name.localeCompare(b.name);
    });
  }

  function rebuildRowPositionOptions(memberId, supervisorId, selectedPosition) {
    const normalizedSupervisor = supervisorId ? Number(supervisorId) : null;
    const siblings = sortMembers(window.__OC_MEMBERS__.filter(function(item) {
      if (item.id === memberId) return false;
      return normalizedSupervisor ? Number(item.supervisor) === normalizedSupervisor : !item.supervisor;
    }));

    const labels = siblings.map(function(item, index) {
      return {
        value: index + 1,
        text: 'Position ' + (index + 1) + ' — before ' + item.name,
      };
    });
    labels.push({
      value: siblings.length + 1,
      text: siblings.length ? 'Position ' + (siblings.length + 1) + ' — at the end' : 'Position 1 — first on this row',
    });

    fRowPosition.innerHTML = '';
    labels.forEach(function(optionDef) {
      const option = document.createElement('option');
      option.value = String(optionDef.value);
      option.textContent = optionDef.text;
      if (Number(selectedPosition) === optionDef.value) option.selected = true;
      fRowPosition.appendChild(option);
    });

    if (!fRowPosition.value && labels.length) {
      const fallbackPosition = Math.min(Math.max(Number(selectedPosition) || (siblings.length + 1), 1), labels.length);
      fRowPosition.value = String(fallbackPosition);
    }
  }

  window.ocOpenEdit = function(id){
    const m = window.__OC_MEMBERS__.find(x => x.id === id);
    if (!m) return;
    titleEl.textContent = 'Edit · ' + m.name;
    form.setAttribute('action', '/admin/org-chart/' + id);
    fTitle.value = m.title;
    Array.from(fSup.options).forEach(opt => {
      opt.disabled = (opt.dataset.self && parseInt(opt.dataset.self,10) === id);
    });
    fSup.value = m.supervisor ? String(m.supervisor) : '';
    rebuildRowPositionOptions(id, fSup.value, m.rowPosition || 1);
    modal.classList.add('open');
    document.body.style.overflow = 'hidden';
  };
  fSup.addEventListener('change', function(){
    const currentAction = form.getAttribute('action') || '';
    const memberId = parseInt(currentAction.split('/').pop(), 10);
    const currentMember = window.__OC_MEMBERS__.find(function(item) { return item.id === memberId; });
    rebuildRowPositionOptions(memberId, fSup.value, currentMember ? currentMember.rowPosition : 1);
  });
  window.ocCloseEdit = function(){
    modal.classList.remove('open');
    document.body.style.overflow = '';
  };
  document.addEventListener('keydown', function(e){
    if (e.key === 'Escape' && modal.classList.contains('open')) ocCloseEdit();
  });
})();
</script>
