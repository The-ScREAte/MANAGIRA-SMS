<style>
  /* ============== Org Chart Page ============== */
  .oc-page { max-width: 1400px; margin: 24px auto 80px; padding: 0 16px; }
  .oc-head { text-align: center; margin-bottom: 18px; }
  .oc-head h1 { margin: 0; font-size: 1.55rem; color: #0f172a; letter-spacing: -0.01em; }
  .oc-head p  { margin: 4px 0 0; color: #64748b; font-size: 0.92rem; }

  .oc-flash { margin-bottom: 14px; padding: 11px 14px; border-radius: 8px; font-size: 0.9rem; }
  .oc-flash.success { background: #dcfce7; color: #166534; border: 1px solid #bbf7d0; }
  .oc-flash.error   { background: #fee2e2; color: #991b1b; border: 1px solid #fecaca; }

  /* ============== Tree (CSS connectors) ============== */
  .oc-tree-scroll {
    overflow-x: auto; overflow-y: visible;
    background:
      radial-gradient(circle, #e2e8f0 1px, transparent 1px) 0 0 / 22px 22px,
      linear-gradient(180deg, #f8fafc, #ffffff);
    border: 1px solid #e5e7eb; border-radius: 14px; padding: 32px 16px;
    text-align: center;
  }
  .oc-tree, .oc-tree ul {
    list-style: none; margin: 0; padding: 0; position: relative;
    display: inline-flex; justify-content: center;
  }
  .oc-tree { padding-top: 6px; min-width: 100%; }
  .oc-tree ul { padding-top: 28px; }

  .oc-tree li {
    position: relative; padding: 0 10px; text-align: center;
    display: flex; flex-direction: column; align-items: center;
  }

  /* Connector lines */
  .oc-tree li::before,
  .oc-tree li::after {
    content: ''; position: absolute; top: 0;
    border-top: 2px solid #cbd5e1;
    width: 50%; height: 14px;
  }
  .oc-tree li::before { left: 0; border-right: 2px solid #cbd5e1; }
  .oc-tree li::after  { right: 0; }
  .oc-tree li:only-child::before,
  .oc-tree li:only-child::after { display: none; }
  .oc-tree li:only-child { padding-top: 14px; }
  .oc-tree li:first-child::before { border: 0; }
  .oc-tree li:last-child::after  { border: 0; }
  .oc-tree li:last-child::before {
    border-right: 2px solid #cbd5e1; border-radius: 0 6px 0 0;
  }
  .oc-tree li:first-child::after { border-radius: 6px 0 0 0; }
  .oc-tree li > .oc-node-wrap::before {
    content: ''; position: absolute; top: -14px; left: 50%;
    width: 2px; height: 14px; background: #cbd5e1;
  }
  .oc-tree > li > .oc-node-wrap::before { display: none; }

  /* ============== Node Card ============== */
  .oc-node-wrap { position: relative; display: inline-flex; flex-direction: column; align-items: center; }
  .oc-node {
    position: relative; display: inline-flex; flex-direction: column; align-items: center;
    background: #ffffff; border: 1px solid #e5e7eb; border-radius: 14px;
    padding: 14px 16px 12px; min-width: 200px; max-width: 240px;
    box-shadow: 0 1px 2px rgba(15,23,42,.04);
    transition: box-shadow .15s ease, transform .15s ease, border-color .15s ease;
    cursor: pointer;
  }
  .oc-node:hover {
    box-shadow: 0 12px 28px rgba(15,23,42,.10);
    transform: translateY(-2px);
    border-color: #99f6e4;
  }
  .oc-node[data-role="Admin"]          { border-top: 4px solid #047857; }
  .oc-node[data-role="Mini Admin"]     { border-top: 4px solid #1d4ed8; }
  .oc-node[data-role="Internal Worker"]{ border-top: 4px solid #b45309; }

  .oc-avatar {
    width: 64px; height: 64px; border-radius: 50%;
    background: linear-gradient(135deg, #01535b, #047a85);
    color: #fff; font-weight: 700; font-size: 1.25rem;
    display: inline-flex; align-items: center; justify-content: center;
    overflow: hidden; box-shadow: 0 6px 16px rgba(1,83,91,.25);
    margin-top: -36px; border: 4px solid #fff;
  }
  .oc-avatar img { width: 100%; height: 100%; object-fit: cover; }

  .oc-node .oc-name {
    margin: 10px 0 2px; font-size: 0.98rem; font-weight: 700; color: #0f172a;
    line-height: 1.2; max-width: 200px;
    overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
  }
  .oc-node .oc-title {
    margin: 0; font-size: 0.82rem; color: #475569; font-weight: 600;
    max-width: 200px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
  }
  .oc-node .oc-email {
    margin: 6px 0 0; font-size: 0.72rem; color: #94a3b8;
    max-width: 200px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
  }

  /* Bio toggle */
  .oc-bio-toggle {
    margin-top: 8px;
    background: transparent; border: 0; color: #64748b;
    font-size: 0.78rem; font-weight: 600; cursor: pointer;
    display: inline-flex; align-items: center; gap: 4px;
    padding: 2px 6px; border-radius: 6px;
  }
  .oc-bio-toggle:hover { color: #01535b; background: #f0fdfa; }
  .oc-bio-toggle .oc-chev {
    display: inline-block; transition: transform .15s ease;
    font-size: 0.7rem;
  }
  .oc-node-wrap.bio-open .oc-bio-toggle .oc-chev { transform: rotate(180deg); }

  .oc-bio {
    display: none;
    margin-top: 10px;
    background: #f8fafc; border: 1px solid #e5e7eb; border-radius: 10px;
    padding: 10px 12px; max-width: 240px;
    font-size: 0.8rem; color: #475569; line-height: 1.45;
    white-space: pre-wrap; word-wrap: break-word; text-align: left;
  }
  .oc-node-wrap.bio-open .oc-bio { display: block; }

  /* Reports collapse toggle */
  .oc-children-toggle {
    position: absolute; bottom: -12px; left: 50%; transform: translateX(-50%);
    background: #fff; border: 1px solid #cbd5e1; color: #0f172a;
    width: 24px; height: 24px; border-radius: 50%; cursor: pointer;
    font-size: 0.85rem; line-height: 1; font-weight: 700;
    display: inline-flex; align-items: center; justify-content: center;
    z-index: 2;
  }
  .oc-children-toggle:hover { border-color: #01535b; color: #01535b; }
  li.collapsed > ul { display: none; }
  li.collapsed > .oc-node-wrap .oc-children-toggle::before { content: '+'; }
  li:not(.collapsed) > .oc-node-wrap .oc-children-toggle::before { content: '−'; }

  .oc-empty { color: #64748b; padding: 12px 0; text-align: center; }

  /* ============== Modal Editor ============== */
  .oc-modal-backdrop {
    position: fixed; inset: 0; background: rgba(15,23,42,.55);
    display: none; align-items: center; justify-content: center;
    z-index: 9999; padding: 20px;
  }
  .oc-modal-backdrop.open { display: flex; }
  .oc-modal {
    background: #fff; border-radius: 16px; width: 100%; max-width: 520px;
    box-shadow: 0 30px 60px rgba(15,23,42,.25);
    max-height: 92vh; overflow-y: auto;
  }
  .oc-modal__head {
    padding: 18px 22px; border-bottom: 1px solid #e5e7eb;
    display: flex; align-items: center; justify-content: space-between;
  }
  .oc-modal__head h3 { margin: 0; font-size: 1.05rem; color: #0f172a; }
  .oc-modal__close {
    background: transparent; border: 0; font-size: 1.4rem; color: #64748b; cursor: pointer; line-height: 1;
  }
  .oc-modal__body { padding: 18px 22px; }
  .oc-modal__body label {
    display: flex; flex-direction: column; gap: 5px; margin-bottom: 14px;
    font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.06em;
    color: #475569; font-weight: 700;
  }
  .oc-modal__body input[type="text"],
  .oc-modal__body select,
  .oc-modal__body textarea {
    border: 1px solid #d1d5db; border-radius: 9px; padding: 10px 12px;
    font-size: 15px; font-family: inherit; color: #0f172a; width: 100%;
    background: #fff;
  }
  .oc-modal__body textarea { min-height: 90px; resize: vertical; }
  .oc-modal__body input[type="file"] { font-size: 0.85rem; }
  .oc-modal__foot {
    padding: 14px 22px 18px; border-top: 1px solid #e5e7eb;
    display: flex; gap: 10px; justify-content: flex-end;
  }
  .oc-btn-save {
    background: #01535b; color: #fff; border: 0; padding: 10px 16px;
    border-radius: 9px; font-weight: 700; cursor: pointer; font-size: 0.9rem;
  }
  .oc-btn-save:hover { background: #047a85; }
  .oc-btn-cancel {
    background: #fff; color: #475569; border: 1px solid #cbd5e1;
    padding: 10px 16px; border-radius: 9px; font-weight: 600; cursor: pointer; font-size: 0.9rem;
  }
  .oc-btn-cancel:hover { border-color: #94a3b8; color: #0f172a; }

  @media (max-width: 700px) {
    .oc-page { margin-top: 16px; padding: 0 10px; }
    .oc-tree-scroll { padding: 24px 8px; border-radius: 10px; }
    .oc-tree ul { padding-top: 22px; }
    .oc-tree li { padding: 0 6px; }
    .oc-node { min-width: 160px; max-width: 200px; padding: 12px 12px 10px; }
    .oc-avatar { width: 54px; height: 54px; margin-top: -30px; font-size: 1.05rem; }
    .oc-node .oc-name { font-size: 0.9rem; max-width: 160px; }
    .oc-node .oc-title { font-size: 0.76rem; max-width: 160px; }
    .oc-node .oc-email { font-size: 0.68rem; max-width: 160px; }
    .oc-bio { max-width: 200px; font-size: 0.76rem; }
  }
  @media (max-width: 420px) {
    .oc-node { min-width: 140px; max-width: 170px; }
    .oc-node .oc-name, .oc-node .oc-title, .oc-node .oc-email { max-width: 140px; }
    .oc-bio { max-width: 170px; }
  }
</style>

<div class="oc-page">
  <div class="oc-head">
    <h1>Team Org Chart</h1>
    <p>Visual hierarchy of the Managira team — leaders at the top, reports cascading below.</p>
  </div>

  <% if (messages && messages.success && messages.success.length) { %>
    <div class="oc-flash success"><%= messages.success.join(' ') %></div>
  <% } %>
  <% if (messages && messages.error && messages.error.length) { %>
    <div class="oc-flash error"><%= messages.error.join(' ') %></div>
  <% } %>

  <%
    function ocInitials(m){
      const a = (m.first_name||'').trim().charAt(0);
      const b = (m.last_name||'').trim().charAt(0);
      return ((a+b) || (m.email||'?').charAt(0)).toUpperCase();
    }
    function ocFullName(m){
      return ((m.first_name||'') + ' ' + (m.last_name||'')).trim() || (m.email || 'Unnamed');
    }

    const byId = new Map();
    members.forEach(m => byId.set(m.user_id, m));

    const childrenOf = new Map();
    const roots = [];
    members.forEach(m => {
      const supId = m.supervisor_user_id;
      const hasParent = supId && byId.has(supId) && supId !== m.user_id;
      if (hasParent) {
        if (!childrenOf.has(supId)) childrenOf.set(supId, []);
        childrenOf.get(supId).push(m);
      } else {
        roots.push(m);
      }
    });

    const roleOrder = { 'Admin': 1, 'Mini Admin': 2, 'Internal Worker': 3 };
    const sortFn = (a,b) => {
      const ra = roleOrder[a.account_type] || 9;
      const rb = roleOrder[b.account_type] || 9;
      if (ra !== rb) return ra - rb;
      return ocFullName(a).localeCompare(ocFullName(b));
    };
    roots.sort(sortFn);
    childrenOf.forEach(arr => arr.sort(sortFn));
  %>

  <% function renderNode(m, locals) {
       const kids = locals.childrenOf.get(m.user_id) || [];
       const bio = (m.org_role_description || '').trim();
  %>
    <li>
      <div class="oc-node-wrap">
        <div class="oc-node"
             data-role="<%= m.account_type %>"
             data-id="<%= m.user_id %>"
             onclick="ocOpenEdit(<%= m.user_id %>)">
          <div class="oc-avatar">
            <% if (m.profile_image_url) { %>
              <img src="<%= m.profile_image_url %>" alt="<%= ocFullName(m) %>" loading="lazy">
            <% } else { %><%= ocInitials(m) %><% } %>
          </div>
          <p class="oc-name" title="<%= ocFullName(m) %>"><%= ocFullName(m) %></p>
          <% if (m.org_role_title) { %>
            <p class="oc-title" title="<%= m.org_role_title %>"><%= m.org_role_title %></p>
          <% } %>
          <% if (m.email) { %>
            <p class="oc-email" title="<%= m.email %>"><%= m.email %></p>
          <% } %>
          <% if (bio) { %>
            <button type="button" class="oc-bio-toggle"
                    onclick="event.stopPropagation(); this.closest('.oc-node-wrap').classList.toggle('bio-open');">
              <span class="oc-bio-label">About</span>
              <span class="oc-chev">▾</span>
            </button>
          <% } %>
          <% if (kids.length) { %>
            <button type="button" class="oc-children-toggle"
                    onclick="event.stopPropagation(); this.closest('li').classList.toggle('collapsed');"
                    aria-label="Toggle reports"></button>
          <% } %>
        </div>
        <% if (bio) { %>
          <div class="oc-bio"><%= bio %></div>
        <% } %>
      </div>
      <% if (kids.length) { %>
        <ul>
          <% kids.forEach(function(c){ renderNode(c, locals); }); %>
        </ul>
      <% } %>
    </li>
  <% } %>

  <% if (!members.length) { %>
    <p class="oc-empty">No admin-side users found yet.</p>
  <% } else { %>
    <div class="oc-tree-scroll">
      <ul class="oc-tree">
        <% roots.forEach(function(r){ renderNode(r, { childrenOf: childrenOf }); }); %>
      </ul>
    </div>
  <% } %>
</div>

<!-- ============== Edit Modal ============== -->
<div class="oc-modal-backdrop" id="ocModal" onclick="if(event.target===this) ocCloseEdit()">
  <div class="oc-modal" role="dialog" aria-modal="true" aria-labelledby="ocModalTitle">
    <div class="oc-modal__head">
      <h3 id="ocModalTitle">Edit team member</h3>
      <button type="button" class="oc-modal__close" onclick="ocCloseEdit()" aria-label="Close">×</button>
    </div>
    <form id="ocEditForm" method="POST" enctype="multipart/form-data">
      <div class="oc-modal__body">
        <label>Custom role title
          <input type="text" name="roleTitle" id="ocFieldRoleTitle" maxlength="120"
                 placeholder="e.g. Head of Operations">
        </label>
        <label>Bio / description
          <textarea name="roleDescription" id="ocFieldRoleDesc" maxlength="600"
                    placeholder="What this person is responsible for…"></textarea>
        </label>
        <label>Reports to (supervisor)
          <select name="supervisorUserId" id="ocFieldSupervisor">
            <option value="">— No supervisor (root) —</option>
            <% members.forEach(function(o){ %>
              <option value="<%= o.user_id %>" data-self="<%= o.user_id %>">
                <%= ocFullName(o) %>
              </option>
            <% }); %>
          </select>
        </label>
        <label>Profile picture (optional)
          <input type="file" name="profileImage" accept="image/*">
        </label>
      </div>
      <div class="oc-modal__foot">
        <button type="button" class="oc-btn-cancel" onclick="ocCloseEdit()">Cancel</button>
        <button type="submit" class="oc-btn-save">Save changes</button>
      </div>
    </form>
  </div>
</div>

<script>
(function(){
  window.__OC_MEMBERS__ = <%- JSON.stringify(members.map(m => ({
    id: m.user_id,
    name: ((m.first_name||'') + ' ' + (m.last_name||'')).trim() || m.email || 'Unnamed',
    title: m.org_role_title || '',
    desc: m.org_role_description || '',
    supervisor: m.supervisor_user_id || ''
  }))).replace(/</g, '\\u003c') %>;

  const modal = document.getElementById('ocModal');
  const form = document.getElementById('ocEditForm');
  const titleEl = document.getElementById('ocModalTitle');
  const fTitle = document.getElementById('ocFieldRoleTitle');
  const fDesc = document.getElementById('ocFieldRoleDesc');
  const fSup = document.getElementById('ocFieldSupervisor');

  window.ocOpenEdit = function(id){
    const m = window.__OC_MEMBERS__.find(x => x.id === id);
    if (!m) return;
    titleEl.textContent = 'Edit · ' + m.name;
    form.setAttribute('action', '/admin/org-chart/' + id);
    fTitle.value = m.title;
    fDesc.value = m.desc;
    Array.from(fSup.options).forEach(opt => {
      opt.disabled = (opt.dataset.self && parseInt(opt.dataset.self,10) === id);
    });
    fSup.value = m.supervisor ? String(m.supervisor) : '';
    modal.classList.add('open');
    document.body.style.overflow = 'hidden';
  };
  window.ocCloseEdit = function(){
    modal.classList.remove('open');
    document.body.style.overflow = '';
  };
  document.addEventListener('keydown', function(e){
    if (e.key === 'Escape' && modal.classList.contains('open')) ocCloseEdit();
  });
})();
</script>
