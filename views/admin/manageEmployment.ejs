<h1>Employment Management</h1>

<form method="POST" action="/admin/employment" class="job-form">
  <input type="text" name="title" placeholder="Job Title" required />
  <textarea name="description" placeholder="Job Description" required></textarea>
  <input type="url" name="external_link" placeholder="External Link (e.g. LinkedIn)" required />
  <button type="submit">Post Job</button>
</form>

<hr />

<div class="job-wrapper">
  <% if (jobs.length === 0) { %>
    <p>No job posts yet.</p>
  <% } else { %>
    <% jobs.forEach(job => { %>
      <div class="job-card">
        <i class="fas fa-briefcase job-icon"></i>
        <h3><%= job.title %></h3>
        <p><%= job.description %></p>
        <a href="<%= job.external_link %>" class="job-link" target="_blank">Job Link</a>
        <form action="/admin/employment/delete/<%= job.id %>" method="POST">
          <button type="submit" class="delete-btn" onclick="return confirm('Delete this job?')">Delete</button>
        </form>
      </div>
    <% }) %>
  <% } %>
</div>

<style>
  h1 {
    text-align: center;
    color: #2c3e50;
    margin-top: 30px;
    margin-bottom: 40px;
    font-size: 2rem;
  }

  .job-form {
    max-width: 600px;
    margin: 0 auto 50px auto;
    padding: 20px;
    background-color: #fefefe;
    border-left: 4px solid #2980b9;
    border-radius: 6px;
    box-shadow: 0 2px 8px rgba(0,0,0,0.06);
  }

  .job-form input,
  .job-form textarea {
    width: 100%;
    margin-bottom: 12px;
    padding: 10px;
    font-size: 1rem;
    border-radius: 4px;
    border: 1px solid #ccc;
  }

  .job-form button {
    background-color: #2980b9;
    color: white;
    padding: 10px 18px;
    font-size: 1rem;
    border: none;
    border-radius: 4px;
    cursor: pointer;
    width: 100%;
  }

  .job-form button:hover {
    background-color: #21618c;
  }

  .job-wrapper {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 30px;
    padding: 0 20px 60px 20px;
  }

  .job-card {
    background: #ffffff;
    border-left: 4px solid #3498db;
    width: 300px;
    padding: 20px;
    border-radius: 8px;
    box-shadow: 0 3px 10px rgba(0,0,0,0.07);
    text-align: center;
    position: relative;
  }

  .job-icon {
    font-size: 2rem;
    color: #3498db;
    margin-bottom: 10px;
  }

  .job-card h3 {
    font-size: 1.2rem;
    margin: 10px 0 8px 0;
    color: #2c3e50;
  }

  .job-card p {
    font-size: 0.95rem;
    color: #555;
    margin-bottom: 12px;
  }

  .job-link {
    display: inline-block;
    margin-bottom: 10px;
    font-size: 0.95rem;
    color: #2980b9;
    text-decoration: none;
  }

  .job-link:hover {
    text-decoration: underline;
  }

  .delete-btn {
    background-color: #e74c3c;
    color: white;
    padding: 8px 14px;
    border: none;
    border-radius: 4px;
    font-size: 0.9rem;
    cursor: pointer;
  }

  .delete-btn:hover {
    background-color: #c0392b;
  }

  @media screen and (max-width: 700px) {
    .job-card {
      width: 100%;
      max-width: 90vw;
    }
  }
</style>
