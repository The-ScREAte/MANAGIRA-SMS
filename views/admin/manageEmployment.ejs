<%
  // Ensure messages object exists for flash partial
  if (typeof messages === 'undefined') {
    var messages = { success: [], error: [], info: [] };
  }
%>
<link rel="stylesheet" href="/css/admin.css" />

<style>
  .employment-container {
    max-width: 1000px;
    margin: 0 auto;
  }

  .page-header {
    text-align: center;
    margin-bottom: 32px;
  }

  .page-header h1 {
    color: var(--admin-text-primary, #111827);
    font-size: 1.75rem;
    font-weight: 700;
    margin: 0;
  }

  .page-header-actions {
    margin-top: 14px;
    display: flex;
    justify-content: center;
  }

  .applicants-toggle-btn {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    border: 1px solid #d1d5db;
    border-radius: 999px;
    background: #ffffff;
    color: #0f172a;
    padding: 10px 16px;
    font-weight: 700;
    cursor: pointer;
    transition: all 0.2s ease;
    box-shadow: 0 2px 10px rgba(2, 6, 23, 0.08);
  }

  .applicants-toggle-btn:hover {
    border-color: #93c5fd;
    box-shadow: 0 4px 12px rgba(2, 6, 23, 0.12);
    transform: translateY(-1px);
  }

  .applicants-count {
    background: #dbeafe;
    color: #1d4ed8;
    border-radius: 999px;
    min-width: 26px;
    padding: 3px 8px;
    font-size: 0.78rem;
    text-align: center;
  }

  .applicants-panel {
    margin: 0 auto 24px;
    width: min(1000px, 100%);
    background: #ffffff;
    border: 1px solid #e5e7eb;
    border-radius: 14px;
    box-shadow: 0 10px 24px rgba(15, 23, 42, 0.08);
    overflow: hidden;
  }

  .applicants-panel[hidden] {
    display: none;
  }

  .applicants-panel-header {
    padding: 16px 18px;
    border-bottom: 1px solid #e5e7eb;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    background: linear-gradient(180deg, #f8fbff 0%, #ffffff 100%);
  }

  .applicants-panel-title {
    margin: 0;
    font-size: 1rem;
    color: #0f172a;
  }

  .applicants-panel-subtitle {
    margin: 3px 0 0;
    font-size: 0.82rem;
    color: #6b7280;
  }

  .applicants-tools {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
  }

  .applicants-search {
    border: 1px solid #d1d5db;
    border-radius: 8px;
    padding: 8px 10px;
    font-size: 0.86rem;
    min-width: 220px;
  }

  .applicants-filter-row {
    display: flex;
    flex-wrap: nowrap;
    align-items: end;
    gap: 8px;
    padding: 10px 0 12px;
    border-bottom: 1px solid #e5e7eb;
    margin-bottom: 12px;
    overflow-x: auto;
  }

  .applicants-filter-row label {
    display: flex;
    flex-direction: column;
    gap: 3px;
    font-size: 0.66rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-weight: 700;
    color: #475569;
    flex: 1 1 0;
    min-width: 110px;
  }

  .applicants-filter-row select,
  .applicants-filter-row input {
    border: 1px solid #d1d5db;
    border-radius: 6px;
    padding: 5px 8px;
    font-size: 0.78rem;
    background: #ffffff;
    color: #111827;
    height: 30px;
    box-sizing: border-box;
    width: 100%;
  }

  .applicants-filter-row .reset-filters {
    align-self: end;
    background: #f1f5f9;
    border: 1px solid #cbd5e1;
    color: #0f172a;
    border-radius: 6px;
    padding: 6px 10px;
    font-size: 0.74rem;
    font-weight: 600;
    cursor: pointer;
    height: 30px;
    white-space: nowrap;
    flex: 0 0 auto;
  }

  .applicants-filter-row .reset-filters:hover {
    background: #e2e8f0;
  }

  .applicants-filters-toggle {
    display: none;
    align-items: center;
    gap: 6px;
    background: #f8fafc;
    border: 1px solid #cbd5e1;
    border-radius: 8px;
    padding: 8px 12px;
    font-size: 0.85rem;
    font-weight: 600;
    color: #0f172a;
    cursor: pointer;
    width: 100%;
    justify-content: center;
    margin-bottom: 10px;
  }

  .applicants-filters-toggle .chev {
    transition: transform 180ms ease;
  }

  .applicants-filters-toggle[aria-expanded="true"] .chev {
    transform: rotate(180deg);
  }

  .applicants-panel-body {
    max-height: 420px;
    overflow: auto;
  }

  .applicants-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.86rem;
  }

  .applicants-table th,
  .applicants-table td {
    border-bottom: 1px solid #f1f5f9;
    padding: 10px 12px;
    text-align: left;
    vertical-align: top;
  }

  .applicants-table th {
    background: #f8fafc;
    color: #334155;
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    position: sticky;
    top: 0;
    z-index: 1;
  }

  .status-pill {
    display: inline-block;
    padding: 3px 8px;
    border-radius: 999px;
    font-size: 0.74rem;
    font-weight: 700;
    text-transform: uppercase;
  }

  .status-pill.pending {
    background: #dcfce7;
    color: #166534;
  }

  .status-pill.approved {
    background: #dbeafe;
    color: #1e3a8a;
  }

  .status-pill.rejected {
    background: #fee2e2;
    color: #991b1b;
  }

  .applicants-empty,
  .applicants-error,
  .applicants-loading {
    margin: 0;
    padding: 20px;
    color: #64748b;
    font-size: 0.9rem;
  }

  .overview-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .overview-action-btn {
    border: 1px solid #d1d5db;
    background: #ffffff;
    color: #0f172a;
    border-radius: 6px;
    font-size: 0.75rem;
    font-weight: 700;
    padding: 6px 8px;
    cursor: pointer;
    line-height: 1.1;
  }

  .overview-action-btn.approve {
    background: #ecfdf5;
    border-color: #34d399;
    color: #065f46;
  }

  .overview-action-btn.reject {
    background: #fef2f2;
    border-color: #f87171;
    color: #991b1b;
  }

  .overview-action-btn.reverse {
    background: #eff6ff;
    border-color: #60a5fa;
    color: #1d4ed8;
  }

  .overview-action-btn.delete {
    background: #fff7ed;
    border-color: #fb923c;
    color: #9a3412;
  }

  .overview-action-btn:disabled {
    opacity: 0.55;
    cursor: not-allowed;
  }

  .job-form {
    max-width: 600px;
    margin: 0 auto 40px;
    padding: 24px;
    background-color: #fff;
    border-radius: 12px;
    border: 1px solid #e5e7eb;
    box-shadow: 0 2px 12px rgba(0, 0, 0, 0.06);
  }

  .job-form input,
  .job-form textarea {
    width: 100%;
    margin-bottom: 16px;
    padding: 12px;
    font-size: 0.9rem;
    border-radius: 8px;
    border: 1px solid #d1d5db;
    font-family: inherit;
    box-sizing: border-box;
  }

  .job-form input:focus,
  .job-form textarea:focus {
    outline: none;
    border-color: var(--admin-primary, #2563eb);
    box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.1);
  }

  .job-form textarea {
    min-height: 100px;
    resize: vertical;
  }

  .job-wrapper {
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding: 0 0 40px;
  }

  .job-card {
    width: 100%;
    background: #ffffff;
    border: 1px solid #e5e7eb;
    border-radius: 12px;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);
    transition: all 0.2s ease;
    overflow: hidden;
  }

  .job-card:hover {
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.1);
    border-color: var(--admin-primary, #2563eb);
  }

  .job-summary {
    list-style: none;
    cursor: pointer;
    padding: 18px 20px;
    background: linear-gradient(180deg, #ffffff 0%, #fbfdff 100%);
  }

  .job-summary::-webkit-details-marker {
    display: none;
  }

  .job-card[open] .job-summary {
    border-bottom: 1px solid #e5e7eb;
    background: #f8fbff;
  }

  .job-body {
    padding: 18px 20px 20px;
    text-align: left;
  }

  .job-header-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    margin-bottom: 8px;
  }

  .expand-hint {
    font-size: 0.82rem;
    font-weight: 600;
    color: #4b5563;
  }

  .job-icon {
    font-size: 2.5rem;
    color: var(--admin-primary, #2563eb);
    margin-bottom: 12px;
  }

  .job-card h3 {
    font-size: 1.15rem;
    margin: 0 0 8px;
    color: var(--admin-text-primary, #111827);
    font-weight: 600;
  }

  .job-card p {
    font-size: 0.9rem;
    color: var(--admin-text-secondary, #4b5563);
    margin: 0 0 16px;
    line-height: 1.5;
  }

  .job-description {
    white-space: pre-line;
  }

  .job-link {
    display: inline-block;
    margin-bottom: 16px;
    font-size: 0.9rem;
    color: var(--admin-primary, #2563eb);
    text-decoration: none;
    font-weight: 500;
  }

  .job-link:hover {
    text-decoration: underline;
  }

  .job-card form {
    margin: 0;
  }

  .empty-state {
    grid-column: 1 / -1;
    text-align: center;
    color: var(--admin-text-secondary, #4b5563);
    padding: 40px 20px;
    background: #f9fafb;
    border-radius: 10px;
  }

  @media (max-width: 768px) {
    .job-form {
      margin: 0 10px 32px;
      padding: 20px;
    }

    .applicants-panel-header {
      flex-direction: column;
      align-items: stretch;
    }

    .applicants-search {
      min-width: 0;
      width: 100%;
    }

    .applicants-filters-toggle {
      display: inline-flex;
    }

    .applicants-filter-row {
      flex-wrap: wrap;
      overflow: visible;
    }

    .applicants-filter-row label {
      flex: 1 1 calc(50% - 8px);
      min-width: 0;
    }

    .applicants-filter-row[hidden] {
      display: none;
    }
  }

  @media (max-width: 480px) {
    .page-header h1 {
      font-size: 1.4rem;
    }

    .job-card {
      padding: 16px;
    }
  }
</style>

<div class="employment-container">
  <div class="page-header">
    <h1>Employment Management</h1>
    <% const totalApplications = (applications || []).length; %>
    <div class="page-header-actions">
      <button type="button" id="applicantsToggleBtn" class="applicants-toggle-btn" aria-expanded="false" aria-controls="applicantsPanel">
        <span aria-hidden="true">&#128101;</span>
        <span>Applicants Overview</span>
        <span class="applicants-count" id="applicantsCountBadge"><%= totalApplications %></span>
      </button>
    </div>
  </div>

  <%- include('../partials/flash') %>

  <section id="applicantsPanel" class="applicants-panel" hidden>
    <div class="applicants-panel-header">
      <div>
        <h2 class="applicants-panel-title">Applicant List</h2>
        <p class="applicants-panel-subtitle">Quick status, contact and role overview without opening each application.</p>
      </div>
      <div class="applicants-tools">
        <input type="search" id="applicantsSearch" class="applicants-search" placeholder="Search by name, email, role or status" />
        <button type="button" id="refreshApplicantsBtn" class="admin-btn admin-btn-sm">Refresh</button>
      </div>
    </div>
    <button type="button" id="applicantsFiltersToggle" class="applicants-filters-toggle" aria-expanded="false" aria-controls="applicantsFilters">
      <span>Filters</span>
      <span class="chev" aria-hidden="true">▾</span>
    </button>
    <div class="applicants-filter-row" id="applicantsFilters">
      <label>
        Status
        <select id="filterStatus">
          <option value="">All</option>
          <option value="pending">Pending</option>
          <option value="approved">Approved</option>
          <option value="rejected">Rejected</option>
        </select>
      </label>
      <label>
        Role
        <select id="filterRole">
          <option value="">All roles</option>
        </select>
      </label>
      <label>
        Country / Location
        <select id="filterCountry">
          <option value="">All countries</option>
        </select>
      </label>
      <label>
        Contact preference
        <select id="filterContact">
          <option value="">Any</option>
          <option value="email">Email</option>
          <option value="text">Text</option>
          <option value="both">Email &amp; Text</option>
        </select>
      </label>
      <label>
        Applied from
        <input type="date" id="filterFromDate" />
      </label>
      <label>
        Applied to
        <input type="date" id="filterToDate" />
      </label>
      <button type="button" class="reset-filters" id="resetFiltersBtn">Reset filters</button>
    </div>
    <div class="applicants-panel-body" id="applicantsPanelBody">
      <p class="applicants-loading">Click refresh to load latest applicants.</p>
    </div>
  </section>

  <form method="POST" action="/admin/employment" class="job-form">
    <input type="text" name="title" placeholder="Job Title" required />
    <textarea name="description" placeholder="Job Description" required></textarea>

    <label for="application_mode" style="display: block; margin-bottom: 8px; font-weight: 600; color: #1f2937;">Application Type</label>
    <select id="application_mode" name="application_mode" style="width: 100%; margin-bottom: 16px; padding: 12px; font-size: 0.9rem; border-radius: 8px; border: 1px solid #d1d5db;">
      <option value="external" selected>External Link</option>
      <option value="in_app">In-App Application Form</option>
    </select>

    <div id="externalLinkWrapper">
      <input id="external_link" type="url" name="external_link" placeholder="External Link (e.g., LinkedIn Job Posting)" required />
    </div>

    <p style="margin: -6px 0 16px; color: #6b7280; font-size: 0.85rem;">
      In-app mode uses the built-in application form with resume upload, contact info, and cover letter.
    </p>

    <button type="submit" class="admin-btn admin-btn-primary admin-btn-lg" style="width: 100%;">
      Post Job Opening
    </button>
  </form>

  <div class="job-wrapper">
    <% if (jobs.length === 0) { %>
      <div class="empty-state">
        <p>No job openings posted yet. Create one above!</p>
      </div>
    <% } else { %>
      <% jobs.forEach(job => { %>
        <details class="job-card admin-job">
          <summary class="job-summary">
            <div class="job-header-row">
              <h3><%= job.title %></h3>
              <span class="expand-hint">Click to expand</span>
            </div>
            <p style="margin: 0; font-weight: 600; color: #111827;">
              Apply via: <%= job.application_mode === 'in_app' ? 'In-App Form' : 'External Link' %>
            </p>
            <p style="margin: 8px 0 0;">
              <span style="display: inline-flex; align-items: center; padding: 4px 10px; border-radius: 999px; font-size: 0.78rem; font-weight: 700; text-transform: uppercase; background: <%= job.is_active ? '#dcfce7' : '#fee2e2' %>; color: <%= job.is_active ? '#166534' : '#991b1b' %>;"><%= job.is_active ? 'Active' : 'Inactive' %></span>
            </p>
          </summary>

          <div class="job-body">
            <p class="job-description"><%= job.description %></p>

            <form action="/admin/employment/toggle-status/<%= job.id %>" method="POST" style="margin: 0 0 14px;">
              <button type="submit" class="admin-btn admin-btn-sm" style="width: 100%; background: <%= job.is_active ? '#b91c1c' : '#0f766e' %>; color: #fff; border: 1px solid <%= job.is_active ? '#991b1b' : '#115e59' %>;">
                <%= job.is_active ? 'Set Inactive (Hide from Job Posting)' : 'Set Active (Show on Job Posting)' %>
              </button>
            </form>

            <details style="margin-bottom: 16px; border: 1px solid #e5e7eb; border-radius: 8px; padding: 10px; background: #f9fafb;">
              <summary style="cursor: pointer; font-weight: 600; color: #1f2937;">Edit Job</summary>
              <form method="POST" action="/admin/employment/update/<%= job.id %>" style="margin-top: 10px;">
                <input type="text" name="title" value="<%= job.title %>" required style="width: 100%; margin-bottom: 12px; padding: 10px; border: 1px solid #d1d5db; border-radius: 8px; box-sizing: border-box;" />

                <textarea name="description" required style="width: 100%; min-height: 110px; margin-bottom: 12px; padding: 10px; border: 1px solid #d1d5db; border-radius: 8px; box-sizing: border-box; resize: vertical;"><%= job.description %></textarea>

                <label style="display: block; margin-bottom: 6px; font-weight: 600; color: #1f2937;">Application Type</label>
                <select class="edit-mode-select" name="application_mode" style="width: 100%; margin-bottom: 12px; padding: 10px; border: 1px solid #d1d5db; border-radius: 8px; box-sizing: border-box;">
                  <option value="external" <%= job.application_mode === 'external' ? 'selected' : '' %>>External Link</option>
                  <option value="in_app" <%= job.application_mode === 'in_app' ? 'selected' : '' %>>In-App Application Form</option>
                </select>

                <div class="edit-external-link-wrap" style="margin-bottom: 12px;">
                  <input class="edit-external-link" type="url" name="external_link" value="<%= job.external_link || '' %>" placeholder="External Link (required for external mode)" style="width: 100%; padding: 10px; border: 1px solid #d1d5db; border-radius: 8px; box-sizing: border-box;" />
                </div>

                <button type="submit" class="admin-btn admin-btn-primary admin-btn-sm" style="width: 100%;">
                  Save Changes
                </button>
              </form>
            </details>

            <% if (job.application_mode === 'external' && job.external_link) { %>
              <a href="<%= job.external_link %>" class="job-link" target="_blank">View Job Posting</a>
            <% } %>

            <% const jobApplications = (applications || []).filter(app => app.employment_id === job.id); %>
            <% if (job.application_mode === 'in_app') { %>
              <details style="margin-bottom: 16px; text-align: left; border: 1px solid #e5e7eb; border-radius: 8px; padding: 10px;">
                <summary style="cursor: pointer; font-weight: 600; color: #1f2937;">
                  Applications (<%= jobApplications.length %>)
                </summary>
                <div style="margin-top: 12px;">
                  <% if (jobApplications.length === 0) { %>
                    <p style="margin: 0; color: #6b7280; font-size: 0.9rem;">No applications yet.</p>
                  <% } else { %>
                    <% jobApplications.forEach(application => { %>
                      <details style="margin-bottom: 10px; border: 1px solid #e5e7eb; border-radius: 8px; padding: 10px; background: #f9fafb;">
                        <summary style="cursor: pointer; font-weight: 600; color: #111827;">
                          <%= application.first_name %> <%= application.last_name %> - <%= new Date(application.created_at).toLocaleDateString() %>
                        </summary>
                        <div style="font-size: 0.88rem; color: #374151; line-height: 1.5; margin-top: 10px;">
                          <p style="margin: 4px 0;">
                            <strong>Status:</strong>
                            <span style="display: inline-block; margin-left: 6px; padding: 3px 8px; border-radius: 999px; background: <%= application.status === 'rejected' ? '#fee2e2' : (application.status === 'approved' ? '#dbeafe' : '#dcfce7') %>; color: <%= application.status === 'rejected' ? '#991b1b' : (application.status === 'approved' ? '#1e3a8a' : '#166534') %>; font-size: 0.78rem; font-weight: 700; text-transform: uppercase;">
                              <%= application.status || 'pending' %>
                            </span>
                          </p>
                          <p style="margin: 4px 0;"><strong>Email:</strong> <a href="mailto:<%= application.email %>"><%= application.email %></a></p>
                          <p style="margin: 4px 0;"><strong>Phone:</strong> <a href="tel:<%= application.phone %>"><%= application.phone %></a></p>
                          <p style="margin: 4px 0;"><strong>Location:</strong> <%= application.location || 'Not provided' %></p>
                          <p style="margin: 4px 0;"><strong>Worked with institution (current/past):</strong> <%= application.has_institution_experience ? 'Yes' : 'No' %></p>
                          <% if (application.has_institution_experience && application.institution_experience_name) { %>
                            <p style="margin: 4px 0;"><strong>Institution Name:</strong> <%= application.institution_experience_name %></p>
                          <% } %>
                          <% if (application.whatsapp_number) { %>
                            <p style="margin: 4px 0;"><strong>WhatsApp:</strong> <a href="https://wa.me/<%= application.whatsapp_number.replace(/[^\d]/g, '') %>" target="_blank"><%= application.whatsapp_number %></a></p>
                          <% } %>
                          <p style="margin: 4px 0;"><strong>Contact Preference:</strong>
                            <%= application.contact_via_text ? 'Text' : '' %><%= application.contact_via_text && application.contact_via_email ? ' & ' : '' %><%= application.contact_via_email ? 'Email' : '' %>
                          </p>
                          <p style="margin: 8px 0 4px;"><strong>Cover Letter Note:</strong></p>
                          <p style="margin: 0 0 8px; white-space: pre-wrap;"><%= application.cover_letter %></p>
                          <% if (application.cover_letter_url) { %>
                            <p style="margin: 0 0 8px;"><a href="<%= application.cover_letter_url %>" target="_blank" rel="noopener">Download Cover Letter</a></p>
                          <% } %>
                          <% if (application.rejection_reason) { %>
                            <p style="margin: 8px 0 4px;"><strong>Rejection Reason:</strong></p>
                            <p style="margin: 0 0 8px; white-space: pre-wrap;"><%= application.rejection_reason %></p>
                          <% } %>
                          <p style="margin: 0;"><a href="<%= application.resume_url %>" target="_blank" rel="noopener">Download Resume</a></p>

                          <div style="display: grid; gap: 8px; margin-top: 12px;">
                            <form method="POST" action="/admin/employment/applications/<%= application.id %>/approve" onsubmit="return confirm('Send approval email for this applicant?');" style="margin: 0;">
                              <button
                                type="submit"
                                class="admin-btn admin-btn-sm"
                                style="width: 100%; background: #0f766e; color: #fff; border: 1px solid #115e59;"
                                <%= application.status !== 'pending' ? 'disabled' : '' %>
                              >
                                <%= application.status === 'approved' ? 'Already Approved' : (application.status === 'rejected' ? 'Approve Disabled Until Reversed' : 'Approve and Send Email') %>
                              </button>
                            </form>

                            <form method="POST" action="/admin/employment/applications/<%= application.id %>/reject" onsubmit="return confirm('Send rejection email for this applicant?');" style="margin: 0;">
                              <textarea
                                name="rejection_reason"
                                placeholder="Optional rejection reason to include in email"
                                style="width: 100%; min-height: 70px; border: 1px solid #d1d5db; border-radius: 8px; padding: 8px; font-family: inherit; font-size: 0.85rem; margin-bottom: 8px; box-sizing: border-box;"
                              ></textarea>
                              <button
                                type="submit"
                                class="admin-btn admin-btn-sm"
                                style="width: 100%; background: #b91c1c; color: #fff; border: 1px solid #991b1b;"
                                <%= application.status !== 'pending' ? 'disabled' : '' %>
                              >
                                <%= application.status === 'rejected' ? 'Already Rejected' : (application.status === 'approved' ? 'Reject Disabled After Approval' : 'Reject and Send Email') %>
                              </button>
                            </form>

                            <% if (application.status === 'rejected') { %>
                              <form method="POST" action="/admin/employment/applications/<%= application.id %>/reverse-rejection" onsubmit="return confirm('Reverse rejection and notify applicant to disregard previous rejection email?');" style="margin: 0;">
                                <button
                                  type="submit"
                                  class="admin-btn admin-btn-sm"
                                  style="width: 100%; background: #1d4ed8; color: #fff; border: 1px solid #1e40af;"
                                >
                                  Reverse Rejection and Notify
                                </button>
                              </form>
                            <% } %>

                            <form method="POST" action="/admin/employment/applications/<%= application.id %>/delete" onsubmit="return confirm('Delete this application permanently?');" style="margin: 0;">
                              <button type="submit" class="admin-btn admin-btn-delete admin-btn-sm" style="width: 100%;">
                                Delete Application
                              </button>
                            </form>
                          </div>
                        </div>
                      </details>
                    <% }) %>
                  <% } %>
                </div>
              </details>
            <% } %>

            <form action="/admin/employment/delete/<%= job.id %>" method="POST">
              <button type="submit" class="admin-btn admin-btn-delete admin-btn-sm" onclick="return confirm('Delete this job posting?')" style="width: 100%;">
                Delete Job
              </button>
            </form>
          </div>
        </details>
      <% }) %>
    <% } %>
  </div>
</div>

<script>
  (function () {
    const modeSelect = document.getElementById('application_mode');
    const externalLinkWrapper = document.getElementById('externalLinkWrapper');
    const externalLinkInput = document.getElementById('external_link');
    const applicantsToggleBtn = document.getElementById('applicantsToggleBtn');
    const applicantsPanel = document.getElementById('applicantsPanel');
    const applicantsPanelBody = document.getElementById('applicantsPanelBody');
    const applicantsSearch = document.getElementById('applicantsSearch');
    const refreshApplicantsBtn = document.getElementById('refreshApplicantsBtn');
    const applicantsCountBadge = document.getElementById('applicantsCountBadge');
    const filterStatus = document.getElementById('filterStatus');
    const filterRole = document.getElementById('filterRole');
    const filterCountry = document.getElementById('filterCountry');
    const filterContact = document.getElementById('filterContact');
    const filterFromDate = document.getElementById('filterFromDate');
    const filterToDate = document.getElementById('filterToDate');
    const resetFiltersBtn = document.getElementById('resetFiltersBtn');

    let applicantsLoaded = false;
    let applicantsCache = [];

    if (!modeSelect || !externalLinkWrapper || !externalLinkInput) return;

    function formatDate(value) {
      if (!value) return '-';
      const parsed = new Date(value);
      if (Number.isNaN(parsed.getTime())) return '-';
      return parsed.toLocaleDateString();
    }

    function statusClass(status) {
      if (status === 'approved') return 'approved';
      if (status === 'rejected') return 'rejected';
      return 'pending';
    }

    function contactPreference(item) {
      const viaText = Boolean(item.contact_via_text);
      const viaEmail = Boolean(item.contact_via_email);
      if (viaText && viaEmail) return 'Text & Email';
      if (viaText) return 'Text';
      if (viaEmail) return 'Email';
      return '-';
    }

    function escapeHtml(value) {
      return String(value || '')
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#039;');
    }

    function renderApplicantsTable(data) {
      if (!Array.isArray(data) || data.length === 0) {
        applicantsPanelBody.innerHTML = '<p class="applicants-empty">No applicants found.</p>';
        return;
      }

      const rows = data.map((item) => {
        const fullName = `${item.first_name || ''} ${item.last_name || ''}`.trim() || 'Unknown';
        const email = item.email || '';
        const phone = item.phone || '-';
        const jobTitle = item.job_title || '-';
        const status = (item.status || 'pending').toLowerCase();

        const approveDisabled = status !== 'pending';
        const rejectDisabled = status !== 'pending';
        const approveLabel = status === 'approved'
          ? 'Approved'
          : (status === 'rejected' ? 'Approve Disabled' : 'Approve + Email');
        const rejectLabel = status === 'rejected'
          ? 'Rejected'
          : (status === 'approved' ? 'Reject Disabled' : 'Reject + Email');

        const reverseAction = status === 'rejected'
          ? `<button type="button" class="overview-action-btn reverse" data-action="reverse" data-id="${escapeHtml(item.id)}" data-status="${escapeHtml(status)}">Reverse</button>`
          : '';

        return `
          <tr>
            <td>${escapeHtml(fullName)}</td>
            <td>${escapeHtml(jobTitle)}</td>
            <td>${escapeHtml(item.location || '-')}</td>
            <td><span class="status-pill ${statusClass(status)}">${escapeHtml(status)}</span></td>
            <td><a href="mailto:${escapeHtml(email)}">${escapeHtml(email)}</a></td>
            <td><a href="tel:${escapeHtml(phone)}">${escapeHtml(phone)}</a></td>
            <td>${escapeHtml(contactPreference(item))}</td>
            <td>${escapeHtml(formatDate(item.created_at))}</td>
            <td>
              <div class="overview-actions">
                <button type="button" class="overview-action-btn approve" data-action="approve" data-id="${escapeHtml(item.id)}" data-status="${escapeHtml(status)}" ${approveDisabled ? 'disabled' : ''}>${escapeHtml(approveLabel)}</button>
                <button type="button" class="overview-action-btn reject" data-action="reject" data-id="${escapeHtml(item.id)}" data-status="${escapeHtml(status)}" ${rejectDisabled ? 'disabled' : ''}>${escapeHtml(rejectLabel)}</button>
                ${reverseAction}
                <button type="button" class="overview-action-btn delete" data-action="delete" data-id="${escapeHtml(item.id)}" data-status="${escapeHtml(status)}">Delete</button>
              </div>
            </td>
          </tr>
        `;
      }).join('');

      applicantsPanelBody.innerHTML = `
        <table class="applicants-table">
          <thead>
            <tr>
              <th>Applicant</th>
              <th>Role</th>
              <th>Location</th>
              <th>Status</th>
              <th>Email</th>
              <th>Phone</th>
              <th>Preference</th>
              <th>Applied</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody>${rows}</tbody>
        </table>
      `;
    }

    async function loadApplicants() {
      applicantsPanelBody.innerHTML = '<p class="applicants-loading">Loading applicants...</p>';
      try {
        const response = await fetch('/admin/employment/applications/overview', {
          headers: {
            'X-Requested-With': 'XMLHttpRequest'
          }
        });
        const payload = await response.json();

        if (!response.ok || !payload.success) {
          throw new Error(payload.message || 'Failed to load applicants.');
        }

        applicantsCache = Array.isArray(payload.applications) ? payload.applications : [];
        applicantsLoaded = true;
        if (applicantsCountBadge) {
          applicantsCountBadge.textContent = String(payload.total || applicantsCache.length);
        }
        populateFilterOptions(applicantsCache);
        applyFilters();
      } catch (error) {
        applicantsPanelBody.innerHTML = '<p class="applicants-error">Unable to load applicants right now. Please try again.</p>';
      }
    }

    function deriveCountry(loc) {
      if (!loc) return '';
      // Heuristic: assume the last comma-separated segment is the country/region.
      const parts = String(loc).split(',').map((s) => s.trim()).filter(Boolean);
      return parts.length ? parts[parts.length - 1] : '';
    }

    function populateFilterOptions(list) {
      if (filterRole) {
        const roles = Array.from(new Set(list.map((i) => i.job_title).filter(Boolean))).sort();
        const current = filterRole.value;
        filterRole.innerHTML = '<option value="">All roles</option>' +
          roles.map((r) => `<option value="${escapeHtml(r)}">${escapeHtml(r)}</option>`).join('');
        filterRole.value = roles.includes(current) ? current : '';
      }
      if (filterCountry) {
        const countries = Array.from(new Set(list.map((i) => deriveCountry(i.location)).filter(Boolean))).sort();
        const current = filterCountry.value;
        filterCountry.innerHTML = '<option value="">All countries</option>' +
          countries.map((c) => `<option value="${escapeHtml(c)}">${escapeHtml(c)}</option>`).join('');
        filterCountry.value = countries.includes(current) ? current : '';
      }
    }

    function applyFilters() {
      const term = (applicantsSearch && applicantsSearch.value ? applicantsSearch.value : '').trim().toLowerCase();
      const status = (filterStatus && filterStatus.value || '').toLowerCase();
      const role = filterRole && filterRole.value || '';
      const country = (filterCountry && filterCountry.value || '').toLowerCase();
      const contactPref = filterContact && filterContact.value || '';
      const fromDate = filterFromDate && filterFromDate.value ? new Date(filterFromDate.value) : null;
      const toDate = filterToDate && filterToDate.value ? new Date(filterToDate.value) : null;
      if (toDate) toDate.setHours(23, 59, 59, 999);

      const filtered = applicantsCache.filter((item) => {
        if (term) {
          const haystack = `${item.first_name || ''} ${item.last_name || ''} ${item.email || ''} ${item.job_title || ''} ${item.status || ''} ${item.location || ''}`.toLowerCase();
          if (!haystack.includes(term)) return false;
        }
        if (status && String(item.status || '').toLowerCase() !== status) return false;
        if (role && item.job_title !== role) return false;
        if (country) {
          const itemCountry = deriveCountry(item.location).toLowerCase();
          if (itemCountry !== country) return false;
        }
        if (contactPref) {
          const e = Boolean(item.contact_via_email);
          const t = Boolean(item.contact_via_text);
          if (contactPref === 'email' && !e) return false;
          if (contactPref === 'text' && !t) return false;
          if (contactPref === 'both' && !(e && t)) return false;
        }
        if (fromDate || toDate) {
          const created = item.created_at ? new Date(item.created_at) : null;
          if (!created || Number.isNaN(created.getTime())) return false;
          if (fromDate && created < fromDate) return false;
          if (toDate && created > toDate) return false;
        }
        return true;
      });

      renderApplicantsTable(filtered);
    }

    function filterApplicants() {
      applyFilters();
    }

    function submitPostAction(url, payload) {
      const form = document.createElement('form');
      form.method = 'POST';
      form.action = url;

      const fields = payload || {};
      Object.keys(fields).forEach((key) => {
        const input = document.createElement('input');
        input.type = 'hidden';
        input.name = key;
        input.value = fields[key];
        form.appendChild(input);
      });

      document.body.appendChild(form);
      form.submit();
    }

    function onApplicantsActionClick(event) {
      const button = event.target.closest('button[data-action]');
      if (!button) return;

      const action = button.getAttribute('data-action');
      const applicationId = button.getAttribute('data-id');
      const status = (button.getAttribute('data-status') || '').toLowerCase();

      if (!applicationId) return;

      if (action === 'approve') {
        if (status !== 'pending') return;
        if (!window.confirm('Send approval email for this applicant?')) return;
        submitPostAction(`/admin/employment/applications/${applicationId}/approve`);
        return;
      }

      if (action === 'reject') {
        if (status !== 'pending') return;
        const rejectionReason = window.prompt('Optional rejection reason to include in email:', '');
        if (rejectionReason === null) return;
        if (!window.confirm('Send rejection email for this applicant?')) return;
        submitPostAction(`/admin/employment/applications/${applicationId}/reject`, {
          rejection_reason: rejectionReason,
        });
        return;
      }

      if (action === 'reverse') {
        if (status !== 'rejected') return;
        if (!window.confirm('Reverse rejection and notify applicant to disregard previous rejection email?')) return;
        submitPostAction(`/admin/employment/applications/${applicationId}/reverse-rejection`);
        return;
      }

      if (action === 'delete') {
        if (!window.confirm('Delete this application permanently?')) return;
        submitPostAction(`/admin/employment/applications/${applicationId}/delete`);
      }
    }

    if (applicantsToggleBtn && applicantsPanel) {
      applicantsToggleBtn.addEventListener('click', async () => {
        const willOpen = applicantsPanel.hidden;
        applicantsPanel.hidden = !willOpen;
        applicantsToggleBtn.setAttribute('aria-expanded', String(willOpen));

        if (willOpen && !applicantsLoaded) {
          await loadApplicants();
        }
      });
    }

    if (refreshApplicantsBtn) {
      refreshApplicantsBtn.addEventListener('click', loadApplicants);
    }

    if (applicantsPanelBody) {
      applicantsPanelBody.addEventListener('click', onApplicantsActionClick);
    }

    if (applicantsSearch) {
      applicantsSearch.addEventListener('input', filterApplicants);
    }

    [filterStatus, filterRole, filterCountry, filterContact, filterFromDate, filterToDate].forEach((el) => {
      if (el) el.addEventListener('change', applyFilters);
    });

    if (resetFiltersBtn) {
      resetFiltersBtn.addEventListener('click', () => {
        if (applicantsSearch) applicantsSearch.value = '';
        if (filterStatus) filterStatus.value = '';
        if (filterRole) filterRole.value = '';
        if (filterCountry) filterCountry.value = '';
        if (filterContact) filterContact.value = '';
        if (filterFromDate) filterFromDate.value = '';
        if (filterToDate) filterToDate.value = '';
        applyFilters();
      });
    }

    const applicantsFiltersToggle = document.getElementById('applicantsFiltersToggle');
    const applicantsFiltersEl = document.getElementById('applicantsFilters');
    function syncFiltersForViewport() {
      if (!applicantsFiltersToggle || !applicantsFiltersEl) return;
      const isMobile = window.matchMedia('(max-width: 768px)').matches;
      if (isMobile) {
        if (applicantsFiltersToggle.getAttribute('aria-expanded') !== 'true') {
          applicantsFiltersEl.hidden = true;
        }
      } else {
        applicantsFiltersEl.hidden = false;
      }
    }
    if (applicantsFiltersToggle && applicantsFiltersEl) {
      applicantsFiltersToggle.addEventListener('click', () => {
        const expanded = applicantsFiltersToggle.getAttribute('aria-expanded') === 'true';
        const next = !expanded;
        applicantsFiltersToggle.setAttribute('aria-expanded', String(next));
        applicantsFiltersEl.hidden = !next;
      });
      window.addEventListener('resize', syncFiltersForViewport);
      syncFiltersForViewport();
    }

    function syncApplicationMode() {
      const isExternal = modeSelect.value === 'external';
      externalLinkWrapper.style.display = isExternal ? 'block' : 'none';
      externalLinkInput.required = isExternal;
      if (!isExternal) {
        externalLinkInput.value = '';
      }
    }

    modeSelect.addEventListener('change', syncApplicationMode);
    syncApplicationMode();

    const jobPanels = Array.from(document.querySelectorAll('.admin-job'));
    jobPanels.forEach((panel) => {
      const hint = panel.querySelector('.expand-hint');
      const setHint = () => {
        if (hint) {
          hint.textContent = panel.open ? 'Click to collapse' : 'Click to expand';
        }
      };

      setHint();
      panel.addEventListener('toggle', () => {
        if (panel.open) {
          jobPanels.forEach((otherPanel) => {
            if (otherPanel !== panel && otherPanel.open) {
              otherPanel.open = false;
            }
          });
        }
        setHint();
      });
    });

    const editForms = Array.from(document.querySelectorAll('.job-body'));
    editForms.forEach((container) => {
      const modeSelect = container.querySelector('.edit-mode-select');
      const externalWrap = container.querySelector('.edit-external-link-wrap');
      const externalInput = container.querySelector('.edit-external-link');
      if (!modeSelect || !externalWrap || !externalInput) return;

      const syncEditMode = () => {
        const isExternal = modeSelect.value === 'external';
        externalWrap.style.display = isExternal ? 'block' : 'none';
        externalInput.required = isExternal;
        if (!isExternal) {
          externalInput.value = '';
        }
      };

      modeSelect.addEventListener('change', syncEditMode);
      syncEditMode();
    });
  })();
</script>
