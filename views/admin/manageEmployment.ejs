<%
  // Ensure messages object exists for flash partial
  if (typeof messages === 'undefined') {
    var messages = { success: [], error: [], info: [] };
  }
%>
<link rel="stylesheet" href="/css/admin.css" />

<style>
  .employment-container {
    max-width: 1000px;
    margin: 0 auto;
    padding-bottom: 64px;
  }

  .page-header {
    text-align: center;
    margin-bottom: 32px;
  }

  .page-header h1 {
    color: var(--admin-text-primary, #111827);
    font-size: 1.75rem;
    font-weight: 700;
    margin: 0;
  }

  .page-header-actions {
    margin-top: 14px;
    display: flex;
    justify-content: center;
  }

  .applicants-toggle-btn {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    border: 1px solid #d1d5db;
    border-radius: 999px;
    background: #ffffff;
    color: #0f172a;
    padding: 10px 16px;
    font-weight: 700;
    cursor: pointer;
    transition: all 0.2s ease;
    box-shadow: 0 2px 10px rgba(2, 6, 23, 0.08);
  }

  .applicants-toggle-btn:hover {
    border-color: #93c5fd;
    box-shadow: 0 4px 12px rgba(2, 6, 23, 0.12);
    transform: translateY(-1px);
  }

  .applicants-count {
    background: #dbeafe;
    color: #1d4ed8;
    border-radius: 999px;
    min-width: 26px;
    padding: 3px 8px;
    font-size: 0.78rem;
    text-align: center;
  }

  .applicants-panel {
    /* Break out of the 1000px parent container so the list feels spacious */
    position: relative;
    width: 96vw;
    max-width: 1600px;
    left: 50%;
    transform: translateX(-50%);
    margin: 0 0 28px;
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 18px;
    box-shadow: 0 24px 50px -24px rgba(15, 23, 42, 0.25), 0 10px 20px -10px rgba(15, 23, 42, 0.08);
    overflow: hidden;
  }

  .applicants-panel[hidden] {
    display: none;
  }

  .applicants-panel-header {
    padding: 18px 22px;
    border-bottom: 1px solid #e2e8f0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    background: linear-gradient(180deg, #f8fafc 0%, #ffffff 100%);
  }

  .applicants-panel-title {
    margin: 0;
    font-size: 1.1rem;
    font-weight: 700;
    color: #0f172a;
    letter-spacing: -0.01em;
  }

  .applicants-panel-subtitle {
    margin: 4px 0 0;
    font-size: 0.85rem;
    color: #64748b;
  }

  .applicants-tools {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: nowrap;
    flex: 1 1 auto;
    justify-content: flex-end;
    min-width: 0;
  }

  .applicants-search {
    border: 1px solid #d1d5db;
    border-radius: 8px;
    padding: 8px 12px;
    font-size: 0.9rem;
    min-width: 0;
    flex: 1 1 320px;
    max-width: 460px;
  }

  .applicants-tool-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0;
    width: 36px;
    height: 36px;
    padding: 0;
    font-size: 1rem;
    font-weight: 600;
    line-height: 1;
    border-radius: 50%;
    border: 1px solid #cbd5e1;
    background: #ffffff;
    color: #0f172a;
    cursor: pointer;
    transition: background 140ms ease, border-color 140ms ease, transform 140ms ease, box-shadow 140ms ease;
    flex: 0 0 auto;
  }
  .applicants-tool-btn:hover { background: #f1f5f9; border-color: #94a3b8; }
  .applicants-tool-btn:active { transform: translateY(1px); }
  .applicants-tool-btn.primary {
    background: #faf5ff;
    border-color: #a855f7;
    color: #6b21a8;
  }
  .applicants-tool-btn.primary:hover { background: #f3e8ff; box-shadow: 0 0 0 3px rgba(168,85,247,.15); }
  .applicants-tool-btn[disabled] { opacity: 0.6; cursor: not-allowed; }
  .applicants-tool-btn .ico { font-size: 1rem; line-height: 1; }
  .applicants-tool-btn .label { display: none; }

  .applicants-filter-row {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    gap: 10px;
    padding: 14px 22px 16px;
    border-bottom: 1px solid #e5e7eb;
    margin-bottom: 0;
    background: #fafbfc;
  }

  .applicants-filter-row label {
    display: flex;
    flex-direction: column;
    gap: 3px;
    font-size: 0.66rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-weight: 700;
    color: #475569;
    flex: 1 1 0;
    min-width: 110px;
  }

  .applicants-filter-row select,
  .applicants-filter-row input {
    border: 1px solid #d1d5db;
    border-radius: 6px;
    padding: 5px 8px;
    font-size: 0.78rem;
    background: #ffffff;
    color: #111827;
    height: 30px;
    box-sizing: border-box;
    width: 100%;
  }

  .applicants-filter-row .reset-filters {
    align-self: end;
    background: #f1f5f9;
    border: 1px solid #cbd5e1;
    color: #0f172a;
    border-radius: 6px;
    padding: 6px 10px;
    font-size: 0.74rem;
    font-weight: 600;
    cursor: pointer;
    height: 30px;
    white-space: nowrap;
    flex: 0 0 auto;
  }

  .applicants-filter-row .reset-filters:hover {
    background: #e2e8f0;
  }

  .applicants-filters-toggle {
    display: none;
    align-items: center;
    gap: 6px;
    background: #f8fafc;
    border: 1px solid #cbd5e1;
    border-radius: 8px;
    padding: 8px 12px;
    font-size: 0.85rem;
    font-weight: 600;
    color: #0f172a;
    cursor: pointer;
    width: 100%;
    justify-content: center;
    margin-bottom: 10px;
  }

  .applicants-filters-toggle .chev {
    transition: transform 180ms ease;
  }

  .applicants-filters-toggle[aria-expanded="true"] .chev {
    transform: rotate(180deg);
  }

  .applicants-panel-body {
    max-height: min(78vh, 820px);
    overflow: auto;
  }

  .applicants-table-wrap {
    overflow-x: auto;
  }

  .applicants-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.86rem;
  }

  .applicants-table th,
  .applicants-table td {
    border-bottom: 1px solid #f1f5f9;
    padding: 12px 14px;
    text-align: left;
    vertical-align: top;
  }

  .applicants-table tbody tr:hover { background: #f8fafc; }

  .applicants-table th {
    background: #f8fafc;
    color: #475569;
    font-size: 0.74rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    position: sticky;
    top: 0;
    z-index: 1;
    border-bottom: 1px solid #e2e8f0;
  }

  .status-pill {
    display: inline-block;
    padding: 3px 8px;
    border-radius: 999px;
    font-size: 0.74rem;
    font-weight: 700;
    text-transform: uppercase;
  }

  .status-pill.pending {
    background: #dcfce7;
    color: #166534;
  }

  .status-pill.approved {
    background: #dbeafe;
    color: #1e3a8a;
  }

  .status-pill.rejected {
    background: #fee2e2;
    color: #991b1b;
  }

  .status-pill.hired {
    background: #dcfce7;
    color: #166534;
  }

  .applicants-empty,
  .applicants-error,
  .applicants-loading {
    margin: 0;
    padding: 20px;
    color: #64748b;
    font-size: 0.9rem;
  }

  .overview-actions {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 6px;
    min-width: 170px;
  }
  .overview-actions .overview-action-btn { width: 100%; text-align: center; }

  @keyframes stagePulse {
    0%, 100% { box-shadow: 0 0 0 0 rgba(6, 182, 212, 0.0); }
    50%      { box-shadow: 0 0 0 4px rgba(6, 182, 212, 0.18); }
  }
  .overview-action-btn.second,
  .overview-action-btn.final {
    animation: stagePulse 2.4s ease-in-out infinite;
  }
  .overview-action-btn.final { animation-name: stagePulseIndigo; }
  @keyframes stagePulseIndigo {
    0%, 100% { box-shadow: 0 0 0 0 rgba(99, 102, 241, 0.0); }
    50%      { box-shadow: 0 0 0 4px rgba(99, 102, 241, 0.18); }
  }

  .overview-action-btn {
    border: 1px solid #d1d5db;
    background: #ffffff;
    color: #0f172a;
    border-radius: 8px;
    font-size: 0.74rem;
    font-weight: 700;
    padding: 6px 10px;
    cursor: pointer;
    line-height: 1.1;
    transition: transform 140ms ease, box-shadow 140ms ease, background 140ms ease;
  }

  .overview-action-btn.approve {
    background: #ecfdf5;
    border-color: #34d399;
    color: #065f46;
  }

  .overview-action-btn.reject {
    background: #fef2f2;
    border-color: #f87171;
    color: #991b1b;
  }

  .overview-action-btn.reverse {
    background: #eff6ff;
    border-color: #60a5fa;
    color: #1d4ed8;
  }

  .overview-action-btn.delete {
    background: #fff7ed;
    border-color: #fb923c;
    color: #9a3412;
  }

  .overview-action-btn.second {
    background: #ecfeff;
    border-color: #06b6d4;
    color: #155e75;
  }

  .overview-action-btn.final {
    background: #eef2ff;
    border-color: #6366f1;
    color: #3730a3;
  }

  .overview-action-btn.view {
    background: #f8fafc;
    border-color: #94a3b8;
    color: #1e293b;
  }
  a.overview-action-btn.view {
    text-decoration: none;
    text-align: center;
    display: inline-block;
  }
  .overview-action-btn.analyze {
    background: #faf5ff;
    border-color: #a855f7;
    color: #6b21a8;
  }

  .docs-cell {
    display: flex;
    flex-direction: column;
    gap: 4px;
    min-width: 110px;
  }

  .fit-cell {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 6px;
    min-width: 130px;
    flex-wrap: nowrap;
  }
  .icon-btn {
    width: 28px;
    height: 28px;
    padding: 0 !important;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 0.95rem;
    line-height: 1;
  }
  .fit-chip {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 3px 8px;
    border-radius: 999px;
    font-size: 0.74rem;
    font-weight: 700;
    text-transform: uppercase;
    border: 1px solid transparent;
  }
  .fit-chip.qualified { background: #dcfce7; color: #166534; border-color: #86efac; }
  .fit-chip.review    { background: #fef3c7; color: #92400e; border-color: #fcd34d; }
  .fit-chip.not-qualified { background: #fee2e2; color: #991b1b; border-color: #fca5a5; }
  .fit-chip.unknown   { background: #f1f5f9; color: #475569; border-color: #cbd5e1; }
  .fit-meta { font-size: 0.7rem; color: #64748b; }

  .fit-modal-backdrop {
    position: fixed; inset: 0;
    background: rgba(15, 23, 42, 0.55);
    z-index: 9999;
    display: flex; align-items: center; justify-content: center;
    padding: 20px;
  }
  .fit-modal {
    background: #fff; border-radius: 12px; max-width: 640px; width: 100%;
    max-height: 80vh; overflow: auto; padding: 22px;
    box-shadow: 0 20px 50px rgba(0,0,0,.25);
  }
  .fit-modal h3 { margin: 0 0 6px; }
  .fit-modal .fit-section { margin-top: 14px; }
  .fit-modal .fit-tags { display: flex; flex-wrap: wrap; gap: 6px; }
  .fit-modal .fit-tag {
    padding: 3px 8px; border-radius: 999px; font-size: 0.78rem; font-weight: 600;
    background: #f1f5f9; color: #334155; border: 1px solid #e2e8f0;
  }
  .fit-modal .fit-tag.match { background: #ecfdf5; color: #065f46; border-color: #6ee7b7; }
  .fit-modal .fit-tag.miss  { background: #fef2f2; color: #991b1b; border-color: #fecaca; }
  .fit-modal-close {
    margin-top: 18px; padding: 8px 14px; border: 1px solid #cbd5e1;
    border-radius: 8px; background: #f8fafc; cursor: pointer; font-weight: 600;
  }

  .overview-action-btn.stage-reject {
    background: #fef2f2;
    border-color: #ef4444;
    color: #7f1d1d;
  }

  .overview-action-btn:hover:not(:disabled) {
    transform: translateY(-1px);
    box-shadow: 0 4px 10px -4px rgba(15, 23, 42, 0.18);
  }

  .overview-action-btn:disabled {
    opacity: 0.55;
    cursor: not-allowed;
  }

  .stage-chip {
    display: inline-block;
    margin-top: 4px;
    padding: 2px 8px;
    border-radius: 999px;
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    background: #f1f5f9;
    color: #334155;
    border: 1px solid #e2e8f0;
  }
  .stage-chip.first  { background: #ecfdf5; color: #065f46; border-color: #a7f3d0; }
  .stage-chip.second { background: #ecfeff; color: #155e75; border-color: #a5f3fc; }
  .stage-chip.final  { background: #eef2ff; color: #3730a3; border-color: #c7d2fe; }

  .job-form {
    max-width: 600px;
    margin: 0 auto 40px;
    padding: 24px;
    background-color: #fff;
    border-radius: 12px;
    border: 1px solid #e5e7eb;
    box-shadow: 0 2px 12px rgba(0, 0, 0, 0.06);
  }

  .job-form input,
  .job-form textarea {
    width: 100%;
    margin-bottom: 16px;
    padding: 12px;
    font-size: 0.9rem;
    border-radius: 8px;
    border: 1px solid #d1d5db;
    font-family: inherit;
    box-sizing: border-box;
  }

  .job-form input:focus,
  .job-form textarea:focus {
    outline: none;
    border-color: var(--admin-primary, #2563eb);
    box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.1);
  }

  .job-form textarea {
    min-height: 100px;
    resize: vertical;
  }

  .job-wrapper {
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding: 0 0 40px;
  }

  .job-card {
    width: 100%;
    background: #ffffff;
    border: 1px solid #e5e7eb;
    border-radius: 12px;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);
    transition: all 0.2s ease;
    overflow: hidden;
  }

  .job-card:hover {
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.1);
    border-color: var(--admin-primary, #2563eb);
  }

  .job-summary {
    list-style: none;
    cursor: pointer;
    padding: 18px 20px;
    background: linear-gradient(180deg, #ffffff 0%, #fbfdff 100%);
  }

  .job-summary::-webkit-details-marker {
    display: none;
  }

  .job-card[open] .job-summary {
    border-bottom: 1px solid #e5e7eb;
    background: #f8fbff;
  }

  .job-body {
    padding: 18px 20px 20px;
    text-align: left;
  }

  .job-header-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    margin-bottom: 8px;
  }

  .expand-hint {
    font-size: 0.82rem;
    font-weight: 600;
    color: #4b5563;
  }

  .job-icon {
    font-size: 2.5rem;
    color: var(--admin-primary, #2563eb);
    margin-bottom: 12px;
  }

  .job-card h3 {
    font-size: 1.15rem;
    margin: 0 0 8px;
    color: var(--admin-text-primary, #111827);
    font-weight: 600;
  }

  .job-card p {
    font-size: 0.9rem;
    color: var(--admin-text-secondary, #4b5563);
    margin: 0 0 16px;
    line-height: 1.5;
  }

  .job-description {
    white-space: pre-line;
  }

  .job-link {
    display: inline-block;
    margin-bottom: 16px;
    font-size: 0.9rem;
    color: var(--admin-primary, #2563eb);
    text-decoration: none;
    font-weight: 500;
  }

  .job-link:hover {
    text-decoration: underline;
  }

  .job-card form {
    margin: 0;
  }

  .empty-state {
    grid-column: 1 / -1;
    text-align: center;
    color: var(--admin-text-secondary, #4b5563);
    padding: 40px 20px;
    background: #f9fafb;
    border-radius: 10px;
  }

  @media (max-width: 768px) {
    .job-form {
      margin: 0 10px 32px;
      padding: 20px;
    }

    .applicants-panel-header {
      flex-direction: column;
      align-items: stretch;
    }

    .applicants-search {
      min-width: 0;
      width: 100%;
    }

    .applicants-filters-toggle {
      display: inline-flex;
    }

    .applicants-filter-row {
      flex-wrap: wrap;
      overflow: visible;
    }

    .applicants-filter-row label {
      flex: 1 1 calc(50% - 8px);
      min-width: 0;
    }

    .applicants-filter-row[hidden] {
      display: none;
    }
  }

  @media (max-width: 480px) {
    .page-header h1 {
      font-size: 1.4rem;
    }

    .job-card {
      padding: 16px;
    }
  }

  /* ===== Email Editor Modal (Step 2 / Step 3) ===== */
  .email-editor-overlay {
    position: fixed; inset: 0;
    background: rgba(15, 23, 42, 0.55);
    backdrop-filter: blur(3px);
    display: flex; align-items: center; justify-content: center;
    z-index: 9999;
    padding: 20px;
  }
  .email-editor-overlay[hidden] { display: none; }
  .email-editor {
    width: min(720px, 100%);
    max-height: 92vh;
    background: #ffffff;
    border-radius: 16px;
    box-shadow: 0 30px 60px -20px rgba(15, 23, 42, 0.5);
    display: flex; flex-direction: column;
    overflow: hidden;
    animation: emailEditorIn 220ms ease-out;
  }
  @keyframes emailEditorIn {
    from { opacity: 0; transform: translateY(12px) scale(0.98); }
    to   { opacity: 1; transform: translateY(0) scale(1); }
  }
  .email-editor-header {
    display: flex; align-items: flex-start; justify-content: space-between;
    gap: 12px;
    padding: 18px 22px;
    border-bottom: 1px solid #e2e8f0;
    background: linear-gradient(180deg, #f8fafc 0%, #ffffff 100%);
  }
  .email-editor-step {
    margin: 0 0 4px;
    font-size: 0.72rem; font-weight: 800; text-transform: uppercase;
    letter-spacing: 0.08em; color: #0f766e;
  }
  .email-editor-title { margin: 0; font-size: 1.15rem; color: #0f172a; font-weight: 700; }
  .email-editor-sub   { margin: 4px 0 0; font-size: 0.85rem; color: #64748b; }
  .email-editor-close {
    background: transparent; border: 0; font-size: 1.6rem; line-height: 1;
    color: #64748b; cursor: pointer; padding: 4px 8px; border-radius: 8px;
  }
  .email-editor-close:hover { background: #f1f5f9; color: #0f172a; }
  .email-editor-body { padding: 18px 22px; overflow-y: auto; }
  .email-editor-toggle-row {
    display: grid; grid-template-columns: 1fr 1fr; gap: 10px;
    margin-bottom: 14px;
  }
  .email-editor-radio {
    display: flex; gap: 10px; align-items: flex-start;
    padding: 12px; border: 1px solid #e2e8f0; border-radius: 10px;
    background: #f8fafc; cursor: pointer; font-size: 0.85rem; color: #334155;
    transition: border-color 140ms ease, background 140ms ease;
  }
  .email-editor-radio:hover { border-color: #94a3b8; background: #ffffff; }
  .email-editor-radio input { margin-top: 3px; }
  .email-editor-radio small { color: #64748b; font-size: 0.78rem; }
  .email-editor-radio code { background: #f1f5f9; padding: 1px 6px; border-radius: 4px; font-size: 0.78rem; }
  .email-editor-label {
    display: block; font-size: 0.78rem; font-weight: 700;
    color: #334155; text-transform: uppercase; letter-spacing: 0.05em;
    margin: 8px 0 6px;
  }
  .email-editor-textarea {
    width: 100%; box-sizing: border-box;
    border: 1px solid #cbd5e1; border-radius: 10px;
    padding: 12px; font-size: 0.9rem; line-height: 1.5;
    font-family: inherit; resize: vertical;
    background: #ffffff; color: #0f172a;
  }
  .email-editor-textarea:focus { outline: 0; border-color: #0f766e; box-shadow: 0 0 0 3px rgba(15, 118, 110, 0.18); }
  .email-editor-meta {
    margin-top: 12px; padding: 12px; border: 1px dashed #cbd5e1; border-radius: 10px;
    background: #f8fafc; font-size: 0.85rem; color: #334155;
  }
  .email-editor-meta p { margin: 4px 0; }
  .email-editor-meta a { color: #0f766e; }
  .email-editor-note { color: #64748b; font-size: 0.78rem; }
  .email-editor-footer {
    display: flex; justify-content: flex-end; gap: 10px;
    padding: 14px 22px;
    border-top: 1px solid #e2e8f0;
    background: #f8fafc;
  }
  .email-editor-btn {
    border: 0; border-radius: 10px; font-weight: 700; font-size: 0.9rem;
    padding: 10px 16px; cursor: pointer;
    transition: transform 120ms ease, box-shadow 120ms ease, background 120ms ease;
  }
  .email-editor-btn.ghost { background: #ffffff; border: 1px solid #cbd5e1; color: #0f172a; }
  .email-editor-btn.ghost:hover { background: #f1f5f9; }
  .email-editor-btn.primary { background: #0f766e; color: #ffffff; }
  .email-editor-btn.primary:hover { background: #115e59; transform: translateY(-1px); box-shadow: 0 8px 20px -8px rgba(15, 118, 110, 0.6); }
  .email-editor-btn:disabled { opacity: 0.55; cursor: not-allowed; transform: none; box-shadow: none; }
  @media (max-width: 560px) {
    .email-editor-toggle-row { grid-template-columns: 1fr; }
  }

  /* ===== Applicants Tabs ===== */
  .applicants-tabs {
    display: flex; gap: 0;
    flex-wrap: nowrap;
    overflow-x: auto;
    padding: 6px 12px 0;
    border-bottom: 1px solid #e2e8f0;
    background: #ffffff;
    scrollbar-width: thin;
  }
  .applicants-tabs::-webkit-scrollbar { height: 4px; }
  .applicants-tabs::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 3px; }
  .applicants-tab {
    position: relative;
    background: transparent !important;
    border: 0;
    border-bottom: 2px solid transparent;
    margin: 0;
    padding: 6px 9px 8px;
    font-size: 0.75rem; font-weight: 600;
    color: #64748b; cursor: pointer;
    display: inline-flex; align-items: center; gap: 5px;
    white-space: nowrap;
    flex: 0 0 auto;
    width: auto;
    min-width: 0;
    line-height: 1.2;
    transition: color 140ms ease, border-color 140ms ease;
  }
  .applicants-tab:hover { color: #0f172a; }
  .applicants-tab.is-active {
    color: #0f766e;
    border-bottom-color: #0f766e;
  }
  .applicants-tab .tab-count {
    display: inline-block; min-width: 16px; padding: 0 5px;
    font-size: 0.65rem; font-weight: 700; line-height: 1.5;
    border-radius: 999px;
    background: #f1f5f9; color: #475569;
  }
  .applicants-tab.is-active .tab-count {
    background: #0f766e; color: #ffffff;
  }
  .applicants-tab[data-tab="hired"].is-active          { color: #166534; border-bottom-color: #166534; }
  .applicants-tab[data-tab="hired"].is-active .tab-count { background: #166534; }
  .applicants-tab[data-tab="rejected"].is-active        { color: #b91c1c; border-bottom-color: #b91c1c; }
  .applicants-tab[data-tab="rejected"].is-active .tab-count { background: #b91c1c; }
  @media (max-width: 600px) {
    .applicants-tabs { padding: 10px 12px 0; gap: 2px; }
    .applicants-tab { padding: 8px 10px 10px; font-size: 0.8rem; }
  }
</style>

<div class="employment-container">
  <div class="page-header">
    <h1>Employment Management</h1>
    <% const newApplicants = (applications || []).filter((a) => (a.status || '').toLowerCase() === 'pending').length; %>
    <div class="page-header-actions">
      <button type="button" id="applicantsToggleBtn" class="applicants-toggle-btn" aria-expanded="false" aria-controls="applicantsPanel">
        <span aria-hidden="true">&#128101;</span>
        <span>Applicants Overview</span>
        <span class="applicants-count" id="applicantsCountBadge"><%= newApplicants %></span>
      </button>
    </div>
  </div>

  <%- include('../partials/flash') %>

  <section id="applicantsPanel" class="applicants-panel" hidden>
    <div class="applicants-panel-header">
      <div>
        <h2 class="applicants-panel-title">Applicant List</h2>
        <p class="applicants-panel-subtitle">Quick status, contact and role overview without opening each application.</p>
      </div>
      <div class="applicants-tools">
        <input type="search" id="applicantsSearch" class="applicants-search" placeholder="Search by name, email, role or status" />
        <button type="button" id="analyzeAllBtn" class="applicants-tool-btn primary" title="Auto-check fit for all applicants" aria-label="Auto-check fit for all applicants">
          <span class="ico">⚡</span><span class="label">Auto-check fit</span>
        </button>
        <button type="button" id="refreshApplicantsBtn" class="applicants-tool-btn" title="Refresh applicant list" aria-label="Refresh applicant list">
          <span class="ico">↻</span><span class="label">Refresh</span>
        </button>
      </div>
    </div>
    <button type="button" id="applicantsFiltersToggle" class="applicants-filters-toggle" aria-expanded="false" aria-controls="applicantsFilters">
      <span>Filters</span>
      <span class="chev" aria-hidden="true">▾</span>
    </button>

    <!-- Stage Tabs -->
    <div class="applicants-tabs" id="applicantsTabs" role="tablist" aria-label="Filter applicants by stage">
      <button type="button" class="applicants-tab is-active" data-tab="new"      role="tab" aria-selected="true">New <span class="tab-count" data-count-for="new">0</span></button>
      <button type="button" class="applicants-tab"           data-tab="first"    role="tab">1st Interview <span class="tab-count" data-count-for="first">0</span></button>
      <button type="button" class="applicants-tab"           data-tab="second"   role="tab">2nd Interview <span class="tab-count" data-count-for="second">0</span></button>
      <button type="button" class="applicants-tab"           data-tab="final"    role="tab">Final Interview <span class="tab-count" data-count-for="final">0</span></button>
      <button type="button" class="applicants-tab"           data-tab="hired"    role="tab">Hired <span class="tab-count" data-count-for="hired">0</span></button>
      <button type="button" class="applicants-tab"           data-tab="rejected" role="tab">Rejected <span class="tab-count" data-count-for="rejected">0</span></button>
      <button type="button" class="applicants-tab"           data-tab="all"      role="tab">All <span class="tab-count" data-count-for="all">0</span></button>
    </div>

    <div class="applicants-filter-row" id="applicantsFilters">
      <label>
        Status
        <select id="filterStatus">
          <option value="">All</option>
          <option value="pending">Pending</option>
          <option value="approved">Approved</option>
          <option value="hired">Hired</option>
          <option value="rejected">Rejected</option>
        </select>
      </label>
      <label>
        Role
        <select id="filterRole">
          <option value="">All roles</option>
        </select>
      </label>
      <label>
        Country / Location
        <select id="filterCountry">
          <option value="">All countries</option>
        </select>
      </label>
      <label>
        Contact preference
        <select id="filterContact">
          <option value="">Any</option>
          <option value="email">Email</option>
          <option value="text">Text</option>
          <option value="both">Email &amp; Text</option>
        </select>
      </label>
      <label>
        Applied from
        <input type="date" id="filterFromDate" />
      </label>
      <label>
        Applied to
        <input type="date" id="filterToDate" />
      </label>
      <button type="button" class="reset-filters" id="resetFiltersBtn">Reset filters</button>
    </div>
    <div class="applicants-panel-body" id="applicantsPanelBody">
      <p class="applicants-loading">Click refresh to load latest applicants.</p>
    </div>
  </section>

  <!-- Email Editor Modal: used for Step 2 (Send 2nd Interview) and Step 3 (Send Last Interview) -->
  <div id="emailEditorOverlay" class="email-editor-overlay" hidden role="dialog" aria-modal="true" aria-labelledby="emailEditorTitle">
    <div class="email-editor">
      <div class="email-editor-header">
        <div>
          <p class="email-editor-step" id="emailEditorStep">Step 2 of 3</p>
          <h3 class="email-editor-title" id="emailEditorTitle">Send 2nd Interview Invitation</h3>
          <p class="email-editor-sub" id="emailEditorSub">Recipient: —</p>
        </div>
        <button type="button" class="email-editor-close" id="emailEditorClose" aria-label="Close">×</button>
      </div>

      <div class="email-editor-body">
        <div class="email-editor-toggle-row">
          <label class="email-editor-radio">
            <input type="radio" name="emailEditorMode" value="template" checked>
            <span><strong>Use standard template</strong><br><small>Asks for a 6-month growth proposal to <code>managirasms@gmail.com</code> + Calendly booking.</small></span>
          </label>
          <label class="email-editor-radio">
            <input type="radio" name="emailEditorMode" value="custom">
            <span><strong>Custom message</strong><br><small>Write your own body. Calendly link &amp; CTA are still appended automatically.</small></span>
          </label>
        </div>

        <label for="emailEditorTextarea" class="email-editor-label">Email body (you can edit before sending)</label>
        <textarea id="emailEditorTextarea" rows="10" class="email-editor-textarea"></textarea>

        <div class="email-editor-meta">
          <p><strong>Subject:</strong> <span id="emailEditorSubject">—</span></p>
          <p><strong>CTA button:</strong> <a id="emailEditorCta" href="https://calendly.com/managirasms/30min" target="_blank" rel="noopener">Book on Calendly</a></p>
          <p class="email-editor-note">The body is wrapped in the Managira-branded email shell. Line breaks and basic HTML are preserved.</p>
        </div>
      </div>

      <div class="email-editor-footer">
        <button type="button" class="email-editor-btn ghost" id="emailEditorCancel">Cancel</button>
        <button type="button" class="email-editor-btn primary" id="emailEditorSend">Send email</button>
      </div>
    </div>
  </div>

  <details class="job-card admin-job">
    <summary class="job-summary">
      <div class="job-header-row">
        <h3>Post a New Job Opening</h3>
        <span class="expand-hint">Click to expand</span>
      </div>
    </summary>
    <div class="job-body">
      <form method="POST" action="/admin/employment" class="job-form">
        <input type="text" name="title" placeholder="Job Title" required />
        <textarea name="description" placeholder="Job Description" required></textarea>

        <label for="application_mode" style="display: block; margin-bottom: 8px; font-weight: 600; color: #1f2937;">Application Type</label>
        <select id="application_mode" name="application_mode" style="width: 100%; margin-bottom: 16px; padding: 12px; font-size: 0.9rem; border-radius: 8px; border: 1px solid #d1d5db;">
          <option value="external" selected>External Link</option>
          <option value="in_app">In-App Application Form</option>
        </select>

        <div id="externalLinkWrapper">
          <input id="external_link" type="url" name="external_link" placeholder="External Link (e.g., LinkedIn Job Posting)" required />
        </div>

        <p style="margin: -6px 0 16px; color: #6b7280; font-size: 0.85rem;">
          In-app mode uses the built-in application form with resume upload, contact info, and cover letter.
        </p>

        <button type="submit" class="admin-btn admin-btn-primary admin-btn-lg" style="width: 100%;">
          Post Job Opening
        </button>
      </form>
    </div>
  </details>

  <details class="job-card admin-job" style="margin-top: 16px;">
    <summary class="job-summary">
      <div class="job-header-row">
        <h3>Existing Job Postings (<%= (jobs || []).length %>)</h3>
        <span class="expand-hint">Click to expand</span>
      </div>
    </summary>
    <div class="job-body">
  <div class="job-wrapper">
    <% if (jobs.length === 0) { %>
      <div class="empty-state">
        <p>No job openings posted yet. Create one above!</p>
      </div>
    <% } else { %>
      <% jobs.forEach(job => { %>
        <details class="job-card admin-job">
          <summary class="job-summary">
            <div class="job-header-row">
              <h3><%= job.title %></h3>
              <span class="expand-hint">Click to expand</span>
            </div>
            <p style="margin: 0; font-weight: 600; color: #111827;">
              Apply via: <%= job.application_mode === 'in_app' ? 'In-App Form' : 'External Link' %>
            </p>
            <p style="margin: 8px 0 0;">
              <span style="display: inline-flex; align-items: center; padding: 4px 10px; border-radius: 999px; font-size: 0.78rem; font-weight: 700; text-transform: uppercase; background: <%= job.is_active ? '#dcfce7' : '#fee2e2' %>; color: <%= job.is_active ? '#166534' : '#991b1b' %>;"><%= job.is_active ? 'Active' : 'Inactive' %></span>
            </p>
          </summary>

          <div class="job-body">
            <p class="job-description"><%= job.description %></p>

            <form action="/admin/employment/toggle-status/<%= job.id %>" method="POST" style="margin: 0 0 14px;">
              <button type="submit" class="admin-btn admin-btn-sm" style="width: 100%; background: <%= job.is_active ? '#b91c1c' : '#0f766e' %>; color: #fff; border: 1px solid <%= job.is_active ? '#991b1b' : '#115e59' %>;">
                <%= job.is_active ? 'Set Inactive (Hide from Job Posting)' : 'Set Active (Show on Job Posting)' %>
              </button>
            </form>

            <details style="margin-bottom: 16px; border: 1px solid #e5e7eb; border-radius: 8px; padding: 10px; background: #f9fafb;">
              <summary style="cursor: pointer; font-weight: 600; color: #1f2937;">Edit Job</summary>
              <form method="POST" action="/admin/employment/update/<%= job.id %>" style="margin-top: 10px;">
                <input type="text" name="title" value="<%= job.title %>" required style="width: 100%; margin-bottom: 12px; padding: 10px; border: 1px solid #d1d5db; border-radius: 8px; box-sizing: border-box;" />

                <textarea name="description" required style="width: 100%; min-height: 110px; margin-bottom: 12px; padding: 10px; border: 1px solid #d1d5db; border-radius: 8px; box-sizing: border-box; resize: vertical;"><%= job.description %></textarea>

                <label style="display: block; margin-bottom: 6px; font-weight: 600; color: #1f2937;">Application Type</label>
                <select class="edit-mode-select" name="application_mode" style="width: 100%; margin-bottom: 12px; padding: 10px; border: 1px solid #d1d5db; border-radius: 8px; box-sizing: border-box;">
                  <option value="external" <%= job.application_mode === 'external' ? 'selected' : '' %>>External Link</option>
                  <option value="in_app" <%= job.application_mode === 'in_app' ? 'selected' : '' %>>In-App Application Form</option>
                </select>

                <div class="edit-external-link-wrap" style="margin-bottom: 12px;">
                  <input class="edit-external-link" type="url" name="external_link" value="<%= job.external_link || '' %>" placeholder="External Link (required for external mode)" style="width: 100%; padding: 10px; border: 1px solid #d1d5db; border-radius: 8px; box-sizing: border-box;" />
                </div>

                <button type="submit" class="admin-btn admin-btn-primary admin-btn-sm" style="width: 100%;">
                  Save Changes
                </button>
              </form>
            </details>

            <% if (job.application_mode === 'external' && job.external_link) { %>
              <a href="<%= job.external_link %>" class="job-link" target="_blank">View Job Posting</a>
            <% } %>

            <% const jobApplications = (applications || []).filter(app => app.employment_id === job.id); %>
            <% if (job.application_mode === 'in_app') { %>
              <details style="margin-bottom: 16px; text-align: left; border: 1px solid #e5e7eb; border-radius: 8px; padding: 10px;">
                <summary style="cursor: pointer; font-weight: 600; color: #1f2937;">
                  Applications (<%= jobApplications.length %>)
                </summary>
                <div style="margin-top: 12px;">
                  <% if (jobApplications.length === 0) { %>
                    <p style="margin: 0; color: #6b7280; font-size: 0.9rem;">No applications yet.</p>
                  <% } else { %>
                    <% jobApplications.forEach(application => { %>
                      <details style="margin-bottom: 10px; border: 1px solid #e5e7eb; border-radius: 8px; padding: 10px; background: #f9fafb;">
                        <summary style="cursor: pointer; font-weight: 600; color: #111827;">
                          <%= application.first_name %> <%= application.last_name %> - <%= new Date(application.created_at).toLocaleDateString() %>
                        </summary>
                        <div style="font-size: 0.88rem; color: #374151; line-height: 1.5; margin-top: 10px;">
                          <p style="margin: 4px 0;">
                            <strong>Status:</strong>
                            <span style="display: inline-block; margin-left: 6px; padding: 3px 8px; border-radius: 999px; background: <%= application.status === 'rejected' ? '#fee2e2' : (application.status === 'approved' ? '#dbeafe' : '#dcfce7') %>; color: <%= application.status === 'rejected' ? '#991b1b' : (application.status === 'approved' ? '#1e3a8a' : '#166534') %>; font-size: 0.78rem; font-weight: 700; text-transform: uppercase;">
                              <%= application.status || 'pending' %>
                            </span>
                          </p>
                          <p style="margin: 4px 0;"><strong>Email:</strong> <a href="mailto:<%= application.email %>"><%= application.email %></a></p>
                          <p style="margin: 4px 0;"><strong>Phone:</strong> <a href="tel:<%= application.phone %>"><%= application.phone %></a></p>
                          <p style="margin: 4px 0;"><strong>Location:</strong> <%= application.location || 'Not provided' %></p>
                          <p style="margin: 4px 0;"><strong>Worked with institution (current/past):</strong> <%= application.has_institution_experience ? 'Yes' : 'No' %></p>
                          <% if (application.has_institution_experience && application.institution_experience_name) { %>
                            <p style="margin: 4px 0;"><strong>Institution Name:</strong> <%= application.institution_experience_name %></p>
                          <% } %>
                          <% if (application.whatsapp_number) { %>
                            <p style="margin: 4px 0;"><strong>WhatsApp:</strong> <a href="https://wa.me/<%= application.whatsapp_number.replace(/[^\d]/g, '') %>" target="_blank"><%= application.whatsapp_number %></a></p>
                          <% } %>
                          <p style="margin: 4px 0;"><strong>Contact Preference:</strong>
                            <%= application.contact_via_text ? 'Text' : '' %><%= application.contact_via_text && application.contact_via_email ? ' & ' : '' %><%= application.contact_via_email ? 'Email' : '' %>
                          </p>
                          <p style="margin: 8px 0 4px;"><strong>Cover Letter Note:</strong></p>
                          <p style="margin: 0 0 8px; white-space: pre-wrap;"><%= application.cover_letter %></p>
                          <% if (application.cover_letter_url) { %>
                            <p style="margin: 0 0 8px;"><a href="<%= application.cover_letter_url %>" target="_blank" rel="noopener">Download Cover Letter</a></p>
                          <% } %>
                          <% if (application.rejection_reason) { %>
                            <p style="margin: 8px 0 4px;"><strong>Rejection Reason:</strong></p>
                            <p style="margin: 0 0 8px; white-space: pre-wrap;"><%= application.rejection_reason %></p>
                          <% } %>
                          <p style="margin: 0;"><a href="<%= application.resume_url %>" target="_blank" rel="noopener">Download Resume</a></p>

                          <div style="display: grid; gap: 8px; margin-top: 12px;">
                            <form method="POST" action="/admin/employment/applications/<%= application.id %>/approve" onsubmit="return confirm('Send approval email for this applicant?');" style="margin: 0;">
                              <button
                                type="submit"
                                class="admin-btn admin-btn-sm"
                                style="width: 100%; background: #0f766e; color: #fff; border: 1px solid #115e59;"
                                <%= application.status !== 'pending' ? 'disabled' : '' %>
                              >
                                <%= application.status === 'approved' ? 'Already Approved' : (application.status === 'rejected' ? 'Approve Disabled Until Reversed' : 'Approve and Send Email') %>
                              </button>
                            </form>

                            <form method="POST" action="/admin/employment/applications/<%= application.id %>/reject" onsubmit="return confirm('Send rejection email for this applicant?');" style="margin: 0;">
                              <textarea
                                name="rejection_reason"
                                placeholder="Optional rejection reason to include in email"
                                style="width: 100%; min-height: 70px; border: 1px solid #d1d5db; border-radius: 8px; padding: 8px; font-family: inherit; font-size: 0.85rem; margin-bottom: 8px; box-sizing: border-box;"
                              ></textarea>
                              <button
                                type="submit"
                                class="admin-btn admin-btn-sm"
                                style="width: 100%; background: #b91c1c; color: #fff; border: 1px solid #991b1b;"
                                <%= application.status !== 'pending' ? 'disabled' : '' %>
                              >
                                <%= application.status === 'rejected' ? 'Already Rejected' : (application.status === 'approved' ? 'Reject Disabled After Approval' : 'Reject and Send Email') %>
                              </button>
                            </form>

                            <% if (application.status === 'approved' && (application.interview_stage === 'first')) { %>
                              <form method="POST" action="/admin/employment/applications/<%= application.id %>/second-interview" onsubmit="return confirm('Send second interview invitation?');" style="margin: 0; display: grid; gap: 6px; padding: 8px; border: 1px dashed #0f766e; border-radius: 8px;">
                                <label style="font-size: 0.8rem; font-weight: 600; color: #0f766e;">2nd Interview Message (leave empty or check Use Template)</label>
                                <textarea name="custom_message" placeholder="Optional custom message" style="width:100%; min-height:60px; border:1px solid #d1d5db; border-radius:6px; padding:6px; font-size:0.82rem; box-sizing:border-box;"></textarea>
                                <label style="display:flex; gap:6px; align-items:center; font-size:0.8rem;"><input type="checkbox" name="use_template" value="true" checked /> Use template (proposal request to managirasms@gmail.com)</label>
                                <button type="submit" class="admin-btn admin-btn-sm" style="background:#0f766e; color:#fff; border:1px solid #115e59;">Send 2nd Interview Invite</button>
                              </form>
                              <form method="POST" action="/admin/employment/applications/<%= application.id %>/stage-reject" onsubmit="return confirm('Send rejection email after first interview?');" style="margin: 0;">
                                <input type="text" name="rejection_reason" placeholder="Optional reason" style="width:100%; border:1px solid #d1d5db; border-radius:6px; padding:6px; font-size:0.82rem; box-sizing:border-box; margin-bottom:6px;" />
                                <button type="submit" class="admin-btn admin-btn-sm" style="width:100%; background:#b91c1c; color:#fff; border:1px solid #991b1b;">Reject After 1st Interview</button>
                              </form>
                            <% } %>

                            <% if (application.status === 'approved' && application.interview_stage === 'second') { %>
                              <form method="POST" action="/admin/employment/applications/<%= application.id %>/final-interview" onsubmit="return confirm('Send final interview invitation?');" style="margin: 0; display:grid; gap:6px; padding:8px; border:1px dashed #1d4ed8; border-radius:8px;">
                                <label style="font-size:0.8rem; font-weight:600; color:#1d4ed8;">Last Interview With Team (optional message)</label>
                                <textarea name="custom_message" placeholder="Optional custom message" style="width:100%; min-height:60px; border:1px solid #d1d5db; border-radius:6px; padding:6px; font-size:0.82rem; box-sizing:border-box;"></textarea>
                                <button type="submit" class="admin-btn admin-btn-sm" style="background:#1d4ed8; color:#fff; border:1px solid #1e40af;">Send Last Interview Invite</button>
                              </form>
                              <form method="POST" action="/admin/employment/applications/<%= application.id %>/stage-reject" onsubmit="return confirm('Send rejection email after second interview?');" style="margin: 0;">
                                <input type="text" name="rejection_reason" placeholder="Optional reason" style="width:100%; border:1px solid #d1d5db; border-radius:6px; padding:6px; font-size:0.82rem; box-sizing:border-box; margin-bottom:6px;" />
                                <button type="submit" class="admin-btn admin-btn-sm" style="width:100%; background:#b91c1c; color:#fff; border:1px solid #991b1b;">Reject After 2nd Interview</button>
                              </form>
                            <% } %>

                            <% if (application.status === 'approved' && application.interview_stage === 'final') { %>
                              <p style="margin:6px 0; padding:8px; background:#ecfeff; border-left:3px solid #0891b2; font-size:0.82rem; color:#0e7490;">Final interview invitation has been sent. Awaiting completion.</p>
                              <form method="POST" action="/admin/employment/applications/<%= application.id %>/stage-reject" onsubmit="return confirm('Send rejection email after final interview?');" style="margin: 0;">
                                <input type="text" name="rejection_reason" placeholder="Optional reason" style="width:100%; border:1px solid #d1d5db; border-radius:6px; padding:6px; font-size:0.82rem; box-sizing:border-box; margin-bottom:6px;" />
                                <button type="submit" class="admin-btn admin-btn-sm" style="width:100%; background:#b91c1c; color:#fff; border:1px solid #991b1b;">Reject After Final Interview</button>
                              </form>
                            <% } %>

                            <% if (application.status === 'rejected') { %>
                              <form method="POST" action="/admin/employment/applications/<%= application.id %>/reverse-rejection" onsubmit="return confirm('Reverse rejection and notify applicant to disregard previous rejection email?');" style="margin: 0;">
                                <button
                                  type="submit"
                                  class="admin-btn admin-btn-sm"
                                  style="width: 100%; background: #1d4ed8; color: #fff; border: 1px solid #1e40af;"
                                >
                                  Reverse Rejection and Notify
                                </button>
                              </form>
                            <% } %>

                            <form method="POST" action="/admin/employment/applications/<%= application.id %>/delete" onsubmit="return confirm('Delete this application permanently?');" style="margin: 0;">
                              <button type="submit" class="admin-btn admin-btn-delete admin-btn-sm" style="width: 100%;">
                                Delete Application
                              </button>
                            </form>
                          </div>
                        </div>
                      </details>
                    <% }) %>
                  <% } %>
                </div>
              </details>
            <% } %>

            <form action="/admin/employment/delete/<%= job.id %>" method="POST">
              <button type="submit" class="admin-btn admin-btn-delete admin-btn-sm" onclick="return confirm('Delete this job posting?')" style="width: 100%;">
                Delete Job
              </button>
            </form>
          </div>
        </details>
      <% }) %>
    <% } %>
  </div>
    </div>
  </details>
</div>

<script>
  (function () {
    const modeSelect = document.getElementById('application_mode');
    const externalLinkWrapper = document.getElementById('externalLinkWrapper');
    const externalLinkInput = document.getElementById('external_link');
    const applicantsToggleBtn = document.getElementById('applicantsToggleBtn');
    const applicantsPanel = document.getElementById('applicantsPanel');
    const applicantsPanelBody = document.getElementById('applicantsPanelBody');
    const applicantsSearch = document.getElementById('applicantsSearch');
    const refreshApplicantsBtn = document.getElementById('refreshApplicantsBtn');
    const applicantsCountBadge = document.getElementById('applicantsCountBadge');
    const filterStatus = document.getElementById('filterStatus');
    const filterRole = document.getElementById('filterRole');
    const filterCountry = document.getElementById('filterCountry');
    const filterContact = document.getElementById('filterContact');
    const filterFromDate = document.getElementById('filterFromDate');
    const filterToDate = document.getElementById('filterToDate');
    const resetFiltersBtn = document.getElementById('resetFiltersBtn');

    let applicantsLoaded = false;
    let applicantsCache = [];

    if (!modeSelect || !externalLinkWrapper || !externalLinkInput) return;

    function formatDate(value) {
      if (!value) return '-';
      const parsed = new Date(value);
      if (Number.isNaN(parsed.getTime())) return '-';
      return parsed.toLocaleDateString();
    }

    function statusClass(status) {
      if (status === 'approved') return 'approved';
      if (status === 'hired') return 'hired';
      if (status === 'rejected') return 'rejected';
      return 'pending';
    }

    function contactPreference(item) {
      const viaText = Boolean(item.contact_via_text);
      const viaEmail = Boolean(item.contact_via_email);
      if (viaText && viaEmail) return 'Text & Email';
      if (viaText) return 'Text';
      if (viaEmail) return 'Email';
      return '-';
    }

    function escapeHtml(value) {
      return String(value || '')
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#039;');
    }

    function buildFitReason(score, rec, summary) {
      if (score === null || score === undefined) {
        return 'Not analyzed yet. Click ↻ to auto-check fit against the job description.';
      }
      const matched = (summary && Array.isArray(summary.matched)) ? summary.matched : [];
      const missing = (summary && Array.isArray(summary.missing)) ? summary.missing : [];
      const b = (summary && summary.breakdown) || null;
      const exp = summary && summary.experience;
      const edu = summary && summary.education;
      const mot = summary && summary.motivation;

      const header = rec === 'qualified'
        ? `Strong fit (${score}%).`
        : (rec === 'review'
            ? `Partial match (${score}%) — worth reviewing.`
            : `Low fit (${score}%).`);

      const parts = [header];
      if (b) {
        parts.push(`Skills ${b.keyword}% · Experience ${b.experience}% · Education ${b.education}% · Soft skills ${b.softSkills}% · Motivation ${b.motivation}%.`);
      }
      if (exp && exp.requiredYears) {
        parts.push(`Requires ${exp.requiredYears}+ yrs; applicant claims ${exp.applicantYears || 0}.`);
      }
      if (edu && edu.requiredLabel && (edu.applicantRank < edu.requiredRank)) {
        parts.push(`Job asks for ${edu.requiredLabel}; not detected on resume.`);
      }
      if (mot && mot.signals && !mot.signals.length) {
        parts.push('Cover letter shows little motivation/desire wording.');
      }
      if (missing.length) {
        parts.push(`Missing: ${missing.slice(0, 5).join(', ')}${missing.length > 5 ? '…' : ''}.`);
      }
      if (matched.length) {
        parts.push(`Matched: ${matched.slice(0, 4).join(', ')}${matched.length > 4 ? '…' : ''}.`);
      }
      return parts.join(' ');
    }

    function renderApplicantsTable(data) {
      if (!Array.isArray(data) || data.length === 0) {
        applicantsPanelBody.innerHTML = '<p class="applicants-empty">No applicants found.</p>';
        return;
      }

      const rows = data.map((item) => {
        const fullName = `${item.first_name || ''} ${item.last_name || ''}`.trim() || 'Unknown';
        const email = item.email || '';
        const phone = item.phone || '-';
        const jobTitle = item.job_title || '-';
        const status = (item.status || 'pending').toLowerCase();
        const stage = (item.interview_stage || 'none').toLowerCase();

        const approveDisabled = status !== 'pending';
        const rejectDisabled = status !== 'pending';
        const approveLabel = status === 'approved'
          ? 'Approved'
          : (status === 'rejected' || status === 'hired' ? 'Approve Disabled' : 'Approve + Email');
        const rejectLabel = status === 'rejected'
          ? 'Rejected'
          : (status === 'approved' || status === 'hired' ? 'Reject Disabled' : 'Reject + Email');

        const reverseAction = status === 'rejected'
          ? `<button type="button" class="overview-action-btn reverse" data-action="reverse" data-id="${escapeHtml(item.id)}" data-status="${escapeHtml(status)}">Reverse</button>`
          : '';

        // Stage-aware buttons (only for approved applicants).
        // Treat legacy approved applicants without a stage as 'first' so the
        // second-interview action is always reachable.
        let stageButtons = '';
        const effectiveStage = (status === 'approved' && (!stage || stage === 'none')) ? 'first' : stage;
        if (status === 'approved') {
          if (effectiveStage === 'first') {
            stageButtons = `
                <button type="button" class="overview-action-btn approve" data-action="hire" data-id="${escapeHtml(item.id)}">Hired</button>
              <button type="button" class="overview-action-btn second" data-action="second-interview" data-id="${escapeHtml(item.id)}">Send 2nd Interview</button>
              <button type="button" class="overview-action-btn stage-reject" data-action="stage-reject" data-id="${escapeHtml(item.id)}" data-stage="first">Reject After 1st</button>
            `;
          } else if (effectiveStage === 'second') {
            stageButtons = `
                <button type="button" class="overview-action-btn approve" data-action="hire" data-id="${escapeHtml(item.id)}">Hired</button>
              <button type="button" class="overview-action-btn final" data-action="final-interview" data-id="${escapeHtml(item.id)}">Send Last Interview</button>
              <button type="button" class="overview-action-btn stage-reject" data-action="stage-reject" data-id="${escapeHtml(item.id)}" data-stage="second">Reject After 2nd</button>
            `;
          } else if (effectiveStage === 'final') {
            stageButtons = `
              <button type="button" class="overview-action-btn approve" data-action="hire" data-id="${escapeHtml(item.id)}">Hired</button>
              <button type="button" class="overview-action-btn stage-reject" data-action="stage-reject" data-id="${escapeHtml(item.id)}" data-stage="final">Reject After Final</button>
            `;
          }
        }

        const stageLabelMap = { first: '1st Interview', second: '2nd Interview', final: 'Final Interview' };
        const stageChip = (status === 'approved' && stageLabelMap[effectiveStage])
          ? `<span class="stage-chip ${escapeHtml(effectiveStage)}">${stageLabelMap[effectiveStage]}</span>`
          : '';

        const resumeUrl = item.resume_url || '';
        const coverLetterUrl = item.cover_letter_url || '';
        const docsCell = `
          <div class="docs-cell">
            ${resumeUrl
              ? `<a class="overview-action-btn view" href="${escapeHtml(resumeUrl)}" target="_blank" rel="noopener noreferrer">View Resume</a>`
              : '<span class="fit-meta">No resume</span>'}
            ${coverLetterUrl
              ? `<a class="overview-action-btn view" href="${escapeHtml(coverLetterUrl)}" target="_blank" rel="noopener noreferrer">View Cover Letter</a>`
              : ((item.cover_letter || '').trim()
                  ? `<button type="button" class="overview-action-btn view" data-action="view-cover-text" data-id="${escapeHtml(item.id)}">View Cover Note</button>`
                  : '<span class="fit-meta">No cover letter</span>')}
          </div>
        `;

        const score = (typeof item.qualification_score === 'number') ? item.qualification_score : null;
        const summary = item.qualification_summary || null;
        const rec = (summary && summary.recommendation) || (
          score === null ? 'unknown' :
          (score >= 65 ? 'qualified' : (score >= 35 ? 'review' : 'not-qualified'))
        );
        const reasonText = buildFitReason(score, rec, summary);
        const tooltip = escapeHtml(reasonText);
        const fitCell = `
          <div class="fit-cell">
            <span class="fit-chip ${escapeHtml(rec)}" title="${tooltip}">
              ${score === null ? '—' : score + '%'}
            </span>
            <button type="button" class="overview-action-btn analyze icon-btn" data-action="analyze" data-id="${escapeHtml(item.id)}" title="${score === null ? 'Check fit' : 'Re-check fit'}" aria-label="${score === null ? 'Check fit' : 'Re-check fit'}">
              ↻
            </button>
            <button type="button" class="overview-action-btn view icon-btn" data-action="view-fit" data-id="${escapeHtml(item.id)}" title="View fit details" aria-label="View fit details" ${score === null ? 'disabled' : ''}>
              ⓘ
            </button>
          </div>
        `;

        return `
          <tr>
            <td>${escapeHtml(fullName)}</td>
            <td>${escapeHtml(jobTitle)}</td>
            <td>${escapeHtml(item.location || '-')}</td>
            <td>
              <span class="status-pill ${statusClass(status)}">${escapeHtml(status)}</span>
              ${stageChip ? '<br>' + stageChip : ''}
            </td>
            <td>${docsCell}</td>
            <td>${fitCell}</td>
            <td><a href="mailto:${escapeHtml(email)}">${escapeHtml(email)}</a></td>
            <td><a href="tel:${escapeHtml(phone)}">${escapeHtml(phone)}</a></td>
            <td>${escapeHtml(contactPreference(item))}</td>
            <td>${escapeHtml(formatDate(item.created_at))}</td>
            <td>
              <div class="overview-actions">
                <button type="button" class="overview-action-btn approve" data-action="approve" data-id="${escapeHtml(item.id)}" data-status="${escapeHtml(status)}" ${approveDisabled ? 'disabled' : ''}>${escapeHtml(approveLabel)}</button>
                <button type="button" class="overview-action-btn reject" data-action="reject" data-id="${escapeHtml(item.id)}" data-status="${escapeHtml(status)}" ${rejectDisabled ? 'disabled' : ''}>${escapeHtml(rejectLabel)}</button>
                ${stageButtons}
                ${reverseAction}
                <button type="button" class="overview-action-btn delete" data-action="delete" data-id="${escapeHtml(item.id)}" data-status="${escapeHtml(status)}">Delete</button>
              </div>
            </td>
          </tr>
        `;
      }).join('');

      applicantsPanelBody.innerHTML = `
        <div class="applicants-table-wrap">
          <table class="applicants-table">
            <thead>
              <tr>
                <th>Applicant</th>
                <th>Role</th>
                <th>Location</th>
                <th>Status</th>
                <th>Documents</th>
                <th>Fit</th>
                <th>Email</th>
                <th>Phone</th>
                <th>Preference</th>
                <th>Applied</th>
                <th>Actions</th>
              </tr>
            </thead>
            <tbody>${rows}</tbody>
          </table>
        </div>
      `;
    }

    async function loadApplicants() {
      applicantsPanelBody.innerHTML = '<p class="applicants-loading">Loading applicants...</p>';
      try {
        const response = await fetch('/admin/employment/applications/overview', {
          headers: {
            'X-Requested-With': 'XMLHttpRequest'
          }
        });
        const payload = await response.json();

        if (!response.ok || !payload.success) {
          throw new Error(payload.message || 'Failed to load applicants.');
        }

        applicantsCache = Array.isArray(payload.applications) ? payload.applications : [];
        applicantsLoaded = true;
        updateTabCounts();
        populateFilterOptions(applicantsCache);
        applyFilters();
      } catch (error) {
        applicantsPanelBody.innerHTML = '<p class="applicants-error">Unable to load applicants right now. Please try again.</p>';
      }
    }

    function deriveCountry(loc) {
      if (!loc) return '';
      // Heuristic: assume the last comma-separated segment is the country/region.
      const parts = String(loc).split(',').map((s) => s.trim()).filter(Boolean);
      return parts.length ? parts[parts.length - 1] : '';
    }

    function populateFilterOptions(list) {
      if (filterRole) {
        const roles = Array.from(new Set(list.map((i) => i.job_title).filter(Boolean))).sort();
        const current = filterRole.value;
        filterRole.innerHTML = '<option value="">All roles</option>' +
          roles.map((r) => `<option value="${escapeHtml(r)}">${escapeHtml(r)}</option>`).join('');
        filterRole.value = roles.includes(current) ? current : '';
      }
      if (filterCountry) {
        const countries = Array.from(new Set(list.map((i) => deriveCountry(i.location)).filter(Boolean))).sort();
        const current = filterCountry.value;
        filterCountry.innerHTML = '<option value="">All countries</option>' +
          countries.map((c) => `<option value="${escapeHtml(c)}">${escapeHtml(c)}</option>`).join('');
        filterCountry.value = countries.includes(current) ? current : '';
      }
    }

    function applyFilters() {
      const term = (applicantsSearch && applicantsSearch.value ? applicantsSearch.value : '').trim().toLowerCase();
      const status = (filterStatus && filterStatus.value || '').toLowerCase();
      const role = filterRole && filterRole.value || '';
      const country = (filterCountry && filterCountry.value || '').toLowerCase();
      const contactPref = filterContact && filterContact.value || '';
      const fromDate = filterFromDate && filterFromDate.value ? new Date(filterFromDate.value) : null;
      const toDate = filterToDate && filterToDate.value ? new Date(filterToDate.value) : null;
      if (toDate) toDate.setHours(23, 59, 59, 999);

      const filtered = applicantsCache.filter((item) => {
        if (!matchesTab(item, currentApplicantsTab)) return false;
        if (term) {
          const haystack = `${item.first_name || ''} ${item.last_name || ''} ${item.email || ''} ${item.job_title || ''} ${item.status || ''} ${item.location || ''}`.toLowerCase();
          if (!haystack.includes(term)) return false;
        }
        if (status && String(item.status || '').toLowerCase() !== status) return false;
        if (role && item.job_title !== role) return false;
        if (country) {
          const itemCountry = deriveCountry(item.location).toLowerCase();
          if (itemCountry !== country) return false;
        }
        if (contactPref) {
          const e = Boolean(item.contact_via_email);
          const t = Boolean(item.contact_via_text);
          if (contactPref === 'email' && !e) return false;
          if (contactPref === 'text' && !t) return false;
          if (contactPref === 'both' && !(e && t)) return false;
        }
        if (fromDate || toDate) {
          const created = item.created_at ? new Date(item.created_at) : null;
          if (!created || Number.isNaN(created.getTime())) return false;
          if (fromDate && created < fromDate) return false;
          if (toDate && created > toDate) return false;
        }
        return true;
      });

      renderApplicantsTable(filtered);
    }

    // ===== Tab helpers =====
    let currentApplicantsTab = 'new';
    function matchesTab(item, tab) {
      const status = (item.status || '').toLowerCase();
      const stage  = (item.interview_stage || 'none').toLowerCase();
      switch (tab) {
        case 'new':      return status === 'pending';
        case 'first':    return status === 'approved' && (stage === 'first' || stage === 'none');
        case 'second':   return status === 'approved' && stage === 'second';
        case 'final':    return status === 'approved' && stage === 'final';
        case 'hired':    return status === 'hired';
        case 'rejected': return status === 'rejected';
        case 'all':
        default:         return true;
      }
    }
    function updateTabCounts() {
      const buckets = { new: 0, first: 0, second: 0, final: 0, hired: 0, rejected: 0, all: applicantsCache.length };
      applicantsCache.forEach((item) => {
        ['new', 'first', 'second', 'final', 'hired', 'rejected'].forEach((t) => {
          if (matchesTab(item, t)) buckets[t]++;
        });
      });
      Object.keys(buckets).forEach((t) => {
        const el = document.querySelector(`.tab-count[data-count-for="${t}"]`);
        if (el) el.textContent = String(buckets[t]);
      });
      // The Applicants Overview button badge reflects only "new" (no interview yet)
      if (applicantsCountBadge) applicantsCountBadge.textContent = String(buckets.new);
    }

    function filterApplicants() {
      applyFilters();
    }

    function submitPostAction(url, payload) {
      // Silent AJAX: keep the panel open. Server still redirects to /admin/employment;
      // fetch follows it but we discard the HTML. Flash messages get consumed by the
      // redirected GET so they don't leak into the next real page load.
      const formData = new FormData();
      const fields = payload || {};
      Object.keys(fields).forEach((key) => formData.append(key, fields[key]));

      return fetch(url, {
        method: 'POST',
        body: formData,
        credentials: 'same-origin',
        headers: { 'X-Requested-With': 'XMLHttpRequest' },
      })
        .then(async (response) => {
          const contentType = response.headers.get('content-type') || '';
          const isJson = contentType.includes('application/json');
          const payload = isJson ? await response.json() : null;

          if (!response.ok || (payload && payload.success === false)) {
            throw new Error((payload && payload.message) || `Request failed (${response.status})`);
          }

          showApplicantsToast((payload && payload.message) || 'Action completed.', 'success');
          return loadApplicants();
        })
        .catch((err) => {
          showApplicantsToast(err.message || 'Action failed. Please try again.', 'error');
        });
    }

    function showApplicantsToast(message, kind) {
      let toast = document.getElementById('applicantsToast');
      if (!toast) {
        toast = document.createElement('div');
        toast.id = 'applicantsToast';
        toast.style.cssText = 'position:fixed;bottom:24px;right:24px;z-index:10000;padding:12px 18px;border-radius:10px;font-size:0.9rem;font-weight:600;color:#fff;box-shadow:0 12px 28px -12px rgba(15,23,42,0.4);transition:opacity 200ms ease, transform 200ms ease;opacity:0;transform:translateY(8px);';
        document.body.appendChild(toast);
      }
      toast.style.background = kind === 'error' ? '#b91c1c' : '#0f766e';
      toast.textContent = message;
      requestAnimationFrame(() => {
        toast.style.opacity = '1';
        toast.style.transform = 'translateY(0)';
      });
      clearTimeout(showApplicantsToast._t);
      showApplicantsToast._t = setTimeout(() => {
        toast.style.opacity = '0';
        toast.style.transform = 'translateY(8px)';
      }, 2600);
    }

    // ===== Email Editor Modal =====
    const emailEditorOverlay = document.getElementById('emailEditorOverlay');
    const emailEditorStepEl  = document.getElementById('emailEditorStep');
    const emailEditorTitleEl = document.getElementById('emailEditorTitle');
    const emailEditorSubEl   = document.getElementById('emailEditorSub');
    const emailEditorSubject = document.getElementById('emailEditorSubject');
    const emailEditorTextarea = document.getElementById('emailEditorTextarea');
    const emailEditorClose   = document.getElementById('emailEditorClose');
    const emailEditorCancel  = document.getElementById('emailEditorCancel');
    const emailEditorSend    = document.getElementById('emailEditorSend');

    let emailEditorContext = null;
    let emailEditorTemplateText = '';

    function emailEditorMode() {
      const checked = document.querySelector('input[name="emailEditorMode"]:checked');
      return checked ? checked.value : 'template';
    }
    function emailEditorBody() { return emailEditorTextarea ? emailEditorTextarea.value : ''; }

    function defaultSecondInterviewTemplate(name) {
      const greet = (name || 'there').split(' ')[0];
      return (
        `Dear ${greet},\n\n` +
        `Congratulations on moving forward to the second interview!\n\n` +
        `As preparation, please prepare a short written proposal describing how you would help improve and grow Managira in your local area over the next 6 months. Outline the strategy, the activities you would lead, and the measurable results you expect to achieve.\n\n` +
        `Email your proposal to managirasms@gmail.com before your second interview.\n\n` +
        `When booking, please add a note in the Calendly comment section that this is your second interview.\n\n` +
        `Thank you,\nThe Managira Team`
      );
    }
    function defaultFinalInterviewTemplate(name) {
      const greet = (name || 'there').split(' ')[0];
      return (
        `Dear ${greet},\n\n` +
        `Thank you for the strong showing in your second interview. We would like to invite you to a final interview with the wider Managira team.\n\n` +
        `Please book a slot using the Calendly link below and mention "Final Interview" in the Calendly comment section.\n\n` +
        `We look forward to meeting you again.\n\n` +
        `Warm regards,\nThe Managira Team`
      );
    }

    function syncEmailEditorMode() {
      const mode = emailEditorMode();
      if (mode === 'template') {
        emailEditorTextarea.value = emailEditorTemplateText;
        emailEditorTextarea.readOnly = true;
        emailEditorTextarea.style.background = '#f8fafc';
      } else {
        emailEditorTextarea.readOnly = false;
        emailEditorTextarea.style.background = '#ffffff';
        if (!emailEditorTextarea.value || emailEditorTextarea.value === emailEditorTemplateText) {
          // keep current text as starting point so editor sees the template
        }
      }
    }

    function openEmailEditor(ctx) {
      emailEditorContext = ctx;
      emailEditorTemplateText = ctx.template || '';
      emailEditorStepEl.textContent  = ctx.step || '';
      emailEditorTitleEl.textContent = ctx.title || 'Send Email';
      emailEditorSubEl.textContent   = `Recipient: ${ctx.recipient || '—'}`;
      emailEditorSubject.textContent = ctx.subject || '—';
      // default to template mode
      const tplRadio = document.querySelector('input[name="emailEditorMode"][value="template"]');
      if (tplRadio) tplRadio.checked = true;
      emailEditorTextarea.value = emailEditorTemplateText;
      syncEmailEditorMode();
      emailEditorOverlay.hidden = false;
      document.body.style.overflow = 'hidden';
      setTimeout(() => emailEditorTextarea.focus(), 50);
    }

    function closeEmailEditor() {
      emailEditorOverlay.hidden = true;
      document.body.style.overflow = '';
      emailEditorContext = null;
    }

    document.querySelectorAll('input[name="emailEditorMode"]').forEach((r) => {
      r.addEventListener('change', syncEmailEditorMode);
    });
    if (emailEditorClose)  emailEditorClose.addEventListener('click', closeEmailEditor);
    if (emailEditorCancel) emailEditorCancel.addEventListener('click', closeEmailEditor);
    if (emailEditorOverlay) {
      emailEditorOverlay.addEventListener('click', (e) => {
        if (e.target === emailEditorOverlay) closeEmailEditor();
      });
    }
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && emailEditorOverlay && !emailEditorOverlay.hidden) closeEmailEditor();
    });
    if (emailEditorSend) {
      emailEditorSend.addEventListener('click', () => {
        if (!emailEditorContext) return;
        const fields = emailEditorContext.extraFields ? emailEditorContext.extraFields() : {};
        emailEditorSend.disabled = true;
        emailEditorSend.textContent = 'Sending…';
        const result = submitPostAction(emailEditorContext.submitUrl, fields);
        Promise.resolve(result).finally(() => {
          emailEditorSend.disabled = false;
          emailEditorSend.textContent = 'Send email';
          closeEmailEditor();
        });
      });
    }

    function onApplicantsActionClick(event) {
      const button = event.target.closest('button[data-action]');
      if (!button) return;

      const action = button.getAttribute('data-action');
      const applicationId = button.getAttribute('data-id');
      const status = (button.getAttribute('data-status') || '').toLowerCase();

      if (!applicationId) return;

      if (action === 'approve') {
        if (status !== 'pending') return;
        if (!window.confirm('Send approval email for this applicant?')) return;
        submitPostAction(`/admin/employment/applications/${applicationId}/approve`);
        return;
      }

      if (action === 'reject') {
        if (status !== 'pending') return;
        const rejectionReason = window.prompt('Optional rejection reason to include in email:', '');
        if (rejectionReason === null) return;
        if (!window.confirm('Send rejection email for this applicant?')) return;
        submitPostAction(`/admin/employment/applications/${applicationId}/reject`, {
          rejection_reason: rejectionReason,
        });
        return;
      }

      if (action === 'reverse') {
        if (status !== 'rejected') return;
        if (!window.confirm('Reverse rejection and notify applicant to disregard previous rejection email?')) return;
        submitPostAction(`/admin/employment/applications/${applicationId}/reverse-rejection`);
        return;
      }

      if (action === 'second-interview') {
        const row = button.closest('tr');
        const applicantName = row ? (row.cells[0] && row.cells[0].textContent.trim()) : '';
        const applicantEmail = row ? (row.cells[6] && row.cells[6].textContent.trim()) : '';
        const jobTitle = row ? (row.cells[1] && row.cells[1].textContent.trim()) : '';
        if (!window.confirm(`Are you sure ${applicantName || 'this applicant'} has completed their first interview?\n\nSending the second interview email will move them to the next stage.`)) return;
        openEmailEditor({
          step: 'Step 2 of 3',
          title: 'Send 2nd Interview Invitation',
          recipient: `${applicantName} <${applicantEmail}> — ${jobTitle}`,
          subject: `Second interview invitation — ${jobTitle}`,
          template: defaultSecondInterviewTemplate(applicantName),
          submitUrl: `/admin/employment/applications/${applicationId}/second-interview`,
          extraFields: () => ({
            use_template: emailEditorMode() === 'template' ? 'true' : 'false',
            custom_message: emailEditorMode() === 'custom' ? emailEditorBody() : '',
          }),
        });
        return;
      }

      if (action === 'final-interview') {
        const row = button.closest('tr');
        const applicantName = row ? (row.cells[0] && row.cells[0].textContent.trim()) : '';
        const applicantEmail = row ? (row.cells[6] && row.cells[6].textContent.trim()) : '';
        const jobTitle = row ? (row.cells[1] && row.cells[1].textContent.trim()) : '';
        if (!window.confirm(`Are you sure ${applicantName || 'this applicant'} has completed their second interview?\n\nSending the final interview email will move them to the final stage.`)) return;
        openEmailEditor({
          step: 'Step 3 of 3',
          title: 'Send Last Interview With Team',
          recipient: `${applicantName} <${applicantEmail}> — ${jobTitle}`,
          subject: `Final interview with the Managira team — ${jobTitle}`,
          template: defaultFinalInterviewTemplate(applicantName),
          submitUrl: `/admin/employment/applications/${applicationId}/final-interview`,
          extraFields: () => ({
            custom_message: emailEditorBody(),
          }),
        });
        return;
      }

      if (action === 'hire') {
        const row = button.closest('tr');
        const applicantName = row ? (row.cells[0] && row.cells[0].textContent.trim()) : '';
        if (!window.confirm(`Mark ${applicantName || 'this applicant'} as hired?`)) return;
        submitPostAction(`/admin/employment/applications/${applicationId}/hire`);
        return;
      }

      if (action === 'stage-reject') {
        const stageLabel = button.getAttribute('data-stage') || 'this stage';
        const rejectionReason = window.prompt(
          `Optional rejection reason to include in the email (after ${stageLabel} interview):`,
          ''
        );
        if (rejectionReason === null) return;
        if (!window.confirm('Send stage rejection email to this applicant?')) return;
        submitPostAction(`/admin/employment/applications/${applicationId}/stage-reject`, {
          rejection_reason: rejectionReason,
        });
        return;
      }

      if (action === 'delete') {
        if (!window.confirm('Delete this application permanently?')) return;
        submitPostAction(`/admin/employment/applications/${applicationId}/delete`);
        return;
      }

      if (action === 'view-doc') {
        const url = button.getAttribute('data-url');
        if (!url) return;
        const win = window.open(url, 'managira_doc_viewer', 'noopener,noreferrer,width=1100,height=820,resizable=yes,scrollbars=yes');
        if (!win) window.open(url, '_blank', 'noopener,noreferrer');
        return;
      }

      if (action === 'view-cover-text') {
        showCoverLetterText(applicationId);
        return;
      }

      if (action === 'view-fit') {
        const item = (applicantsCache || []).find((a) => String(a.id) === String(applicationId));
        if (!item) return;
        const summary = item.qualification_summary || {};
        renderFitResult({
          success: true,
          score: item.qualification_score,
          recommendation: summary.recommendation,
          matched: summary.matched || [],
          missing: summary.missing || [],
          breakdown: summary.breakdown,
          experience: summary.experience,
          education: summary.education,
          softSkills: summary.softSkills,
          motivation: summary.motivation,
          cached: true,
        });
        return;
      }

      if (action === 'analyze') {
        runQualificationAnalysis(button, applicationId);
        return;
      }
    }

    function showCoverLetterText(applicationId) {
      const item = (applicantsCache || []).find((a) => String(a.id) === String(applicationId));
      const text = (item && item.cover_letter) || '';
      openFitModal(`
        <h3>Cover Letter Note</h3>
        <pre style="white-space: pre-wrap; font-family: inherit; margin: 10px 0 0; color:#1f2937;">${escapeHtml(text || 'No cover letter text on file.')}</pre>
      `);
    }

    async function runQualificationAnalysis(button, applicationId) {
      const original = button.textContent;
      button.disabled = true;
      button.textContent = 'Analyzing…';
      try {
        const res = await fetch(`/admin/employment/applications/${applicationId}/analyze?force=true`, {
          headers: { Accept: 'application/json' },
        });
        const data = await res.json();
        if (!data.success) throw new Error(data.message || 'Analysis failed.');
        renderFitResult(data);
        // Refresh table to show updated chip
        loadApplicants();
      } catch (err) {
        openFitModal(`<h3>Could not analyze</h3><p>${escapeHtml(err.message || 'Unknown error')}</p>`);
      } finally {
        button.disabled = false;
        button.textContent = original;
      }
    }

    function renderFitResult(data) {
      const matched = (data.matched || []).map((k) => `<span class="fit-tag match">${escapeHtml(k)}</span>`).join('');
      const missing = (data.missing || []).map((k) => `<span class="fit-tag miss">${escapeHtml(k)}</span>`).join('');
      const recLabel = ({
        qualified: 'Qualified',
        review: 'Worth a review',
        'not-qualified': 'Low fit',
      })[data.recommendation] || 'Review';

      const b = data.breakdown || {};
      const bar = (label, val) => `
        <div style="display:flex;align-items:center;gap:8px;margin:4px 0;">
          <span style="flex:0 0 110px;font-size:.78rem;color:#475569;">${label}</span>
          <div style="flex:1;height:8px;background:#e2e8f0;border-radius:999px;overflow:hidden;">
            <div style="height:100%;width:${Math.max(0, Math.min(100, val || 0))}%;background:${val >= 65 ? '#10b981' : (val >= 40 ? '#f59e0b' : '#ef4444')};"></div>
          </div>
          <span style="flex:0 0 36px;text-align:right;font-size:.78rem;font-weight:700;color:#0f172a;">${val || 0}%</span>
        </div>`;

      const exp = data.experience || {};
      const edu = data.education || {};
      const mot = data.motivation || {};
      const soft = (data.softSkills && data.softSkills.matched) || [];

      const insights = [];
      if (exp.requiredYears) {
        insights.push(`Job asks for <strong>${exp.requiredYears}+ years</strong>; applicant indicates <strong>${exp.applicantYears || 0}</strong>.`);
      } else if (exp.applicantYears) {
        insights.push(`Applicant indicates <strong>${exp.applicantYears} years</strong> of experience.`);
      }
      if (edu.requiredLabel) {
        const ok = edu.applicantRank >= edu.requiredRank;
        insights.push(`Education required: <strong>${escapeHtml(edu.requiredLabel)}</strong> — ${ok ? 'met' : 'not detected'}.`);
      } else if ((edu.applicantTerms || []).length) {
        insights.push(`Credentials detected: ${edu.applicantTerms.slice(0, 4).map(escapeHtml).join(', ')}.`);
      }
      if (mot.mentionsCompany) insights.push('Cover letter mentions the company by name.');
      if ((mot.signals || []).length) {
        insights.push(`Motivation signals: ${mot.signals.slice(0, 3).map((s) => escapeHtml(s)).join(', ')}.`);
      } else if (mot.coverLetterLength < 80) {
        insights.push('Cover letter is very short or missing.');
      }

      openFitModal(`
        <h3>Fit analysis</h3>
        <p style="margin:0;color:#475569;font-size:.9rem;">
          Overall: <strong>${data.score}%</strong> · <strong>${escapeHtml(recLabel)}</strong>
          ${data.cached ? '<span class="fit-meta"> (cached)</span>' : ''}
        </p>
        <p style="margin:6px 0 0;color:#64748b;font-size:.78rem;">
          Heuristic across skills, experience, education, soft skills, and cover-letter motivation. Always review manually.
        </p>

        <div class="fit-section">
          <strong>Score breakdown</strong>
          <div style="margin-top:8px;">
            ${bar('Skills/keywords', b.keyword)}
            ${bar('Experience',      b.experience)}
            ${bar('Education',       b.education)}
            ${bar('Soft skills',     b.softSkills)}
            ${bar('Motivation',      b.motivation)}
          </div>
        </div>

        ${insights.length ? `
          <div class="fit-section">
            <strong>Insights</strong>
            <ul style="margin:6px 0 0;padding-left:18px;color:#1f2937;font-size:.85rem;line-height:1.5;">
              ${insights.map((i) => `<li>${i}</li>`).join('')}
            </ul>
          </div>` : ''}

        ${soft.length ? `
          <div class="fit-section">
            <strong>Soft skills detected (${soft.length})</strong>
            <div class="fit-tags" style="margin-top:6px;">${soft.map((s) => `<span class="fit-tag match">${escapeHtml(s)}</span>`).join('')}</div>
          </div>` : ''}

        <div class="fit-section">
          <strong>Matched keywords (${(data.matched || []).length})</strong>
          <div class="fit-tags" style="margin-top:6px;">${matched || '<span class="fit-meta">None</span>'}</div>
        </div>
        <div class="fit-section">
          <strong>Missing keywords (${(data.missing || []).length})</strong>
          <div class="fit-tags" style="margin-top:6px;">${missing || '<span class="fit-meta">None</span>'}</div>
        </div>
      `);
    }

    function openFitModal(innerHtml) {
      closeFitModal();
      const backdrop = document.createElement('div');
      backdrop.className = 'fit-modal-backdrop';
      backdrop.id = 'fitModalBackdrop';
      backdrop.innerHTML = `
        <div class="fit-modal" role="dialog" aria-modal="true">
          ${innerHtml}
          <button type="button" class="fit-modal-close" data-action="fit-close">Close</button>
        </div>
      `;
      backdrop.addEventListener('click', (e) => {
        if (e.target === backdrop) closeFitModal();
      });
      backdrop.querySelector('[data-action="fit-close"]').addEventListener('click', closeFitModal);
      document.body.appendChild(backdrop);
    }

    function closeFitModal() {
      const el = document.getElementById('fitModalBackdrop');
      if (el) el.remove();
    }

    if (applicantsToggleBtn && applicantsPanel) {
      applicantsToggleBtn.addEventListener('click', async () => {
        const willOpen = applicantsPanel.hidden;
        applicantsPanel.hidden = !willOpen;
        applicantsToggleBtn.setAttribute('aria-expanded', String(willOpen));

        if (willOpen && !applicantsLoaded) {
          await loadApplicants();
        }
      });
    }

    if (refreshApplicantsBtn) {
      refreshApplicantsBtn.addEventListener('click', loadApplicants);
    }

    const analyzeAllBtn = document.getElementById('analyzeAllBtn');
    if (analyzeAllBtn) {
      analyzeAllBtn.addEventListener('click', async () => {
        const force = window.confirm(
          'Auto-check fit for all applicants now?\n\n' +
          'OK = Re-analyze EVERY applicant (slower)\n' +
          'Cancel = Only analyze ones that have not been checked yet'
        );
        const original = analyzeAllBtn.innerHTML;
        analyzeAllBtn.disabled = true;
        analyzeAllBtn.innerHTML = '<span class="ico">⏳</span><span class="label">Analyzing…</span>';
        try {
          const res = await fetch(`/admin/employment/applications/analyze-all${force ? '?force=true' : ''}`, {
            method: 'POST',
            headers: { Accept: 'application/json' },
          });
          const data = await res.json();
          if (!data.success) throw new Error(data.message || 'Bulk analysis failed.');
          openFitModal(`
            <h3>Bulk fit check complete</h3>
            <p style="margin:6px 0 0;color:#475569;">
              Processed <strong>${data.total}</strong> applicants \u2014
              analyzed <strong>${data.analyzed}</strong>,
              failed <strong>${data.failed}</strong>${data.skipped_existing ? ' (skipped already-analyzed)' : ''}.
            </p>
          `);
          loadApplicants();
        } catch (err) {
          openFitModal(`<h3>Bulk analysis failed</h3><p>${escapeHtml(err.message || 'Unknown error')}</p>`);
        } finally {
          analyzeAllBtn.disabled = false;
          analyzeAllBtn.innerHTML = original;
        }
      });
    }

    if (applicantsPanelBody) {
      applicantsPanelBody.addEventListener('click', onApplicantsActionClick);
    }

    if (applicantsSearch) {
      applicantsSearch.addEventListener('input', filterApplicants);
    }

    [filterStatus, filterRole, filterCountry, filterContact, filterFromDate, filterToDate].forEach((el) => {
      if (el) el.addEventListener('change', applyFilters);
    });

    // Tab clicks
    const applicantsTabsEl = document.getElementById('applicantsTabs');
    if (applicantsTabsEl) {
      applicantsTabsEl.addEventListener('click', (e) => {
        const btn = e.target.closest('.applicants-tab');
        if (!btn) return;
        const tab = btn.getAttribute('data-tab');
        if (!tab || tab === currentApplicantsTab) return;
        currentApplicantsTab = tab;
        applicantsTabsEl.querySelectorAll('.applicants-tab').forEach((b) => {
          const active = b === btn;
          b.classList.toggle('is-active', active);
          b.setAttribute('aria-selected', String(active));
        });
        applyFilters();
      });
    }

    if (resetFiltersBtn) {
      resetFiltersBtn.addEventListener('click', () => {
        if (applicantsSearch) applicantsSearch.value = '';
        if (filterStatus) filterStatus.value = '';
        if (filterRole) filterRole.value = '';
        if (filterCountry) filterCountry.value = '';
        if (filterContact) filterContact.value = '';
        if (filterFromDate) filterFromDate.value = '';
        if (filterToDate) filterToDate.value = '';
        applyFilters();
      });
    }

    const applicantsFiltersToggle = document.getElementById('applicantsFiltersToggle');
    const applicantsFiltersEl = document.getElementById('applicantsFilters');
    function syncFiltersForViewport() {
      if (!applicantsFiltersToggle || !applicantsFiltersEl) return;
      const isMobile = window.matchMedia('(max-width: 768px)').matches;
      if (isMobile) {
        if (applicantsFiltersToggle.getAttribute('aria-expanded') !== 'true') {
          applicantsFiltersEl.hidden = true;
        }
      } else {
        applicantsFiltersEl.hidden = false;
      }
    }
    if (applicantsFiltersToggle && applicantsFiltersEl) {
      applicantsFiltersToggle.addEventListener('click', () => {
        const expanded = applicantsFiltersToggle.getAttribute('aria-expanded') === 'true';
        const next = !expanded;
        applicantsFiltersToggle.setAttribute('aria-expanded', String(next));
        applicantsFiltersEl.hidden = !next;
      });
      window.addEventListener('resize', syncFiltersForViewport);
      syncFiltersForViewport();
    }

    function syncApplicationMode() {
      const isExternal = modeSelect.value === 'external';
      externalLinkWrapper.style.display = isExternal ? 'block' : 'none';
      externalLinkInput.required = isExternal;
      if (!isExternal) {
        externalLinkInput.value = '';
      }
    }

    modeSelect.addEventListener('change', syncApplicationMode);
    syncApplicationMode();

    const jobPanels = Array.from(document.querySelectorAll('.admin-job'));
    jobPanels.forEach((panel) => {
      const hint = panel.querySelector('.expand-hint');
      const setHint = () => {
        if (hint) {
          hint.textContent = panel.open ? 'Click to collapse' : 'Click to expand';
        }
      };

      setHint();
      panel.addEventListener('toggle', () => {
        if (panel.open) {
          jobPanels.forEach((otherPanel) => {
            if (otherPanel !== panel && otherPanel.open) {
              otherPanel.open = false;
            }
          });
        }
        setHint();
      });
    });

    const editForms = Array.from(document.querySelectorAll('.job-body'));
    editForms.forEach((container) => {
      const modeSelect = container.querySelector('.edit-mode-select');
      const externalWrap = container.querySelector('.edit-external-link-wrap');
      const externalInput = container.querySelector('.edit-external-link');
      if (!modeSelect || !externalWrap || !externalInput) return;

      const syncEditMode = () => {
        const isExternal = modeSelect.value === 'external';
        externalWrap.style.display = isExternal ? 'block' : 'none';
        externalInput.required = isExternal;
        if (!isExternal) {
          externalInput.value = '';
        }
      };

      modeSelect.addEventListener('change', syncEditMode);
      syncEditMode();
    });
  })();
</script>
