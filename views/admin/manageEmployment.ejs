<link rel="stylesheet" href="/css/admin.css" />

<style>
  .employment-container {
    max-width: 1000px;
    margin: 0 auto;
  }

  .page-header {
    text-align: center;
    margin-bottom: 32px;
  }

  .page-header h1 {
    color: var(--admin-text-primary, #111827);
    font-size: 1.75rem;
    font-weight: 700;
    margin: 0;
  }

  .job-form {
    max-width: 600px;
    margin: 0 auto 40px;
    padding: 24px;
    background-color: #fff;
    border-radius: 12px;
    border: 1px solid #e5e7eb;
    box-shadow: 0 2px 12px rgba(0, 0, 0, 0.06);
  }

  .job-form input,
  .job-form textarea {
    width: 100%;
    margin-bottom: 16px;
    padding: 12px;
    font-size: 0.9rem;
    border-radius: 8px;
    border: 1px solid #d1d5db;
    font-family: inherit;
    box-sizing: border-box;
  }

  .job-form input:focus,
  .job-form textarea:focus {
    outline: none;
    border-color: var(--admin-primary, #2563eb);
    box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.1);
  }

  .job-form textarea {
    min-height: 100px;
    resize: vertical;
  }

  .job-wrapper {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 24px;
    padding: 0 0 40px;
  }

  .job-card {
    background: #ffffff;
    border: 1px solid #e5e7eb;
    border-radius: 12px;
    padding: 20px;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);
    transition: all 0.2s ease;
    display: flex;
    flex-direction: column;
    text-align: center;
  }

  .job-card:hover {
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.1);
    border-color: var(--admin-primary, #2563eb);
  }

  .job-icon {
    font-size: 2.5rem;
    color: var(--admin-primary, #2563eb);
    margin-bottom: 12px;
  }

  .job-card h3 {
    font-size: 1.15rem;
    margin: 0 0 8px;
    color: var(--admin-text-primary, #111827);
    font-weight: 600;
  }

  .job-card p {
    font-size: 0.9rem;
    color: var(--admin-text-secondary, #4b5563);
    margin: 0 0 16px;
    line-height: 1.5;
    flex: 1;
  }

  .job-link {
    display: inline-block;
    margin-bottom: 16px;
    font-size: 0.9rem;
    color: var(--admin-primary, #2563eb);
    text-decoration: none;
    font-weight: 500;
  }

  .job-link:hover {
    text-decoration: underline;
  }

  .job-card form {
    margin: 0;
  }

  .empty-state {
    grid-column: 1 / -1;
    text-align: center;
    color: var(--admin-text-secondary, #4b5563);
    padding: 40px 20px;
    background: #f9fafb;
    border-radius: 10px;
  }

  @media (max-width: 768px) {
    .job-wrapper {
      grid-template-columns: 1fr;
    }

    .job-form {
      margin: 0 10px 32px;
      padding: 20px;
    }
  }

  @media (max-width: 480px) {
    .page-header h1 {
      font-size: 1.4rem;
    }

    .job-card {
      padding: 16px;
    }
  }
</style>

<div class="employment-container">
  <div class="page-header">
    <h1>💼 Employment Management</h1>
  </div>

  <%- include('../partials/flash') %>

  <form method="POST" action="/admin/employment" class="job-form">
    <input type="text" name="title" placeholder="Job Title" required />
    <textarea name="description" placeholder="Job Description" required></textarea>
    <input type="url" name="external_link" placeholder="External Link (e.g., LinkedIn Job Posting)" required />
    <button type="submit" class="admin-btn admin-btn-primary admin-btn-lg" style="width: 100%;">
      + Post Job Opening
    </button>
  </form>

  <div class="job-wrapper">
    <% if (jobs.length === 0) { %>
      <div class="empty-state">
        <p>No job openings posted yet. Create one above!</p>
      </div>
    <% } else { %>
      <% jobs.forEach(job => { %>
        <div class="job-card">
          <div class="job-icon">💼</div>
          <h3><%= job.title %></h3>
          <p><%= job.description %></p>
          <a href="<%= job.external_link %>" class="job-link" target="_blank">🔗 View Job Posting</a>
          <form action="/admin/employment/delete/<%= job.id %>" method="POST">
            <button type="submit" class="admin-btn admin-btn-delete admin-btn-sm" onclick="return confirm('Delete this job posting?')" style="width: 100%;">
              🗑 Delete Job
            </button>
          </form>
        </div>
      <% }) %>
    <% } %>
  </div>
</div>
