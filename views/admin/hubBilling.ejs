<%# A hub's billing in Admin (controllers/hubBillingController.js): this bill and its plan, the
    schools it counts, extra charges, past bills, the card and payment link, and who has access.
    Hold, end and Stripe actions are in the bill's ⋯ menu. %>
<%
  const _bl = billing || null;
  const _cur = (_bl && _bl.currency) || 'usd';
  const _m = (n) => b.money(n, _cur);
  const _d = (v) => (v ? b.fmtDate(v) : '—');
  const _per = bill.cycle.per;
  const _owner = [hub.first_name, hub.last_name].filter(Boolean).join(' ');
  const _ended = _bl && _bl.ended_at;
  const _holdLater = _bl && _bl.hold_starts_at;
  const _fees = b.integrationFeesOf(_bl);
  const _chargeStatus = { pending: ['Waiting for approval', 'amber'], approved: ['Approved', 'green'], declined: ['Declined', 'muted'], removed: ['Removed', 'muted'] };
  const _invStatus = { paid: ['Paid', 'green'], open: ['Not paid', 'rose'], void: ['Voided', 'muted'], uncollectible: ['Not collected', 'rose'] };
  const _bills = (invoices || []).filter((i) => Number(i.amount_due) > 0 || Number(i.amount_paid) > 0);
  const _charges = charges.filter((c) => c.status !== 'removed');
  const _num = (n) => Number(n || 0).toLocaleString('en-US');
  const _next = _bl && _bl.next_charge_at && _bl.next_charge_amount != null
    ? `Next charge ${_m(_bl.next_charge_amount)} on ${_d(_bl.next_charge_at)}`
    : (status === 'awaiting_card' ? (firstCharge ? `First bill ${_d(firstCharge)}, once the card is saved` : 'First bill once the card is saved') : '');
  // The plan in one line: what isn't already on the bill.
  const _facts = _bl ? [
    bill.cycle.label,
    `${_num(hub.max_organizations)} school${Number(hub.max_organizations) === 1 ? '' : 's'} included${Number(_bl.extra_school_price) > 0 ? `, then ${_m(_bl.extra_school_price)} each` : ''}`,
    hub.max_users ? `${_num(hub.max_users)} user licenses${Number(_bl.extra_user_price) > 0 ? `, then ${_m(_bl.extra_user_price)} each` : ''}` : null,
    _bl.trial_end_date ? `free until ${_d(b.dayAtNoon(_bl.trial_end_date))}` : null,
    b.contractLabel(hub, _bl),
  ].filter(Boolean) : [];
%>
<link rel="stylesheet" href="<%= assetUrl('/css/adminHubs.css') %>" />
<link rel="stylesheet" href="<%= assetUrl('/css/adminPricing.css') %>" />

<div class="ah">
  <% if (typeof refreshing !== 'undefined' && refreshing) { %><span hidden data-ah-refreshing></span><% } %>
  <%- include('../partials/flash') %>
  <%- include('partials/hubHeader', { hub, active: 'billing' }) %>

  <% if (stripeMode === 'test') { %>
    <div class="ah-alert ah-alert--info"><i class="fa-solid fa-flask" aria-hidden="true"></i><span>Stripe is in <strong>test mode</strong>. Cards and charges here are not real.</span></div>
  <% } %>
  <% if (_bl && _bl.last_error) { %>
    <div class="ah-alert ah-alert--error"><i class="fa-solid fa-triangle-exclamation" aria-hidden="true"></i><span><strong>Stripe:</strong> <%= _bl.last_error %></span></div>
  <% } %>
  <% if (!live && !_ended) { %>
    <div class="ah-alert ah-alert--warn"><i class="fa-solid fa-circle-info" aria-hidden="true"></i><span>No price is set, so this hub isn’t billed. <a href="/admin/hubs/<%= hub.hub_id %>/billing/plan" data-ah-drawer>Set up the plan</a></span></div>
  <% } %>
  <% if (hub.on_hold) { %>
    <div class="ah-alert ah-alert--warn"><i class="fa-solid fa-pause" aria-hidden="true"></i><span>On hold<%= _bl && _bl.hold_ends_at ? ` until ${_d(_bl.hold_ends_at)}` : '' %>: nobody in the hub can sign in and no bills are charged.</span></div>
  <% } else if (_holdLater) { %>
    <div class="ah-alert ah-alert--warn"><i class="fa-solid fa-calendar-xmark" aria-hidden="true"></i><span>Hold from <strong><%= _d(_bl.hold_starts_at) %></strong><%= _bl.hold_ends_at ? ` to ${_d(_bl.hold_ends_at)}` : '' %>. Billing pauses that day.</span></div>
  <% } %>
  <% if (pending.length) { %>
    <div class="ah-alert ah-alert--warn"><i class="fa-solid fa-hourglass-half" aria-hidden="true"></i><span><%= pending.length %> charge<%= pending.length === 1 ? ' is' : 's are' %> waiting for the hub to approve. <a href="#charges">See charges</a></span></div>
  <% } %>
  <% if (manualToAdd.length) { %>
    <div class="ah-alert ah-alert--warn"><i class="fa-solid fa-plug" aria-hidden="true"></i><span><%= manualToAdd.length %> school add-on<%= manualToAdd.length === 1 ? ' has' : 's have' %> a manual fee and no charge yet. <a href="#counted">See schools</a></span></div>
  <% } %>

  <div class="ah-layout">
    <div class="ah-layout__main">
      <section class="ah-card ap-card" aria-labelledby="billTitle">
        <div class="ap-card__head">
          <div>
            <h2 class="ah-card__title" id="billTitle">This bill <span class="ah-bill ah-bill--<%= statusInfo.tone %>"><%= statusInfo.label %></span></h2>
            <% if (_next) { %><p class="ap-card__sub"><%= _next %></p><% } %>
          </div>
          <div class="ah-row-actions">
            <a class="ah-btn ah-btn--primary ah-btn--sm" href="/admin/hubs/<%= hub.hub_id %>/billing/plan" data-ah-drawer><i class="fa-solid fa-sliders" aria-hidden="true"></i> Edit plan</a>
            <details class="ah-menu">
              <summary class="ah-btn ah-btn--sm ah-btn--icon" aria-label="Billing actions"><i class="fa-solid fa-ellipsis" aria-hidden="true"></i></summary>
              <div class="ah-menu__list">
                <% if (hub.on_hold) { %>
                  <form action="/admin/hubs/<%= hub.hub_id %>/billing/resume" method="POST" data-ah-ajax data-ah-ask="Resume <%= hub.hub_name %> now? People can sign in again and billing continues." data-ah-ask-ok="Resume">
                    <button type="submit" class="ah-menu__item"><i class="fa-solid fa-play" aria-hidden="true"></i> Resume now</button>
                  </form>
                <% } else { %>
                  <a class="ah-menu__item" href="/admin/hubs/<%= hub.hub_id %>/billing/hold" data-ah-drawer><i class="fa-solid fa-pause" aria-hidden="true"></i> <%= _holdLater ? 'Change the hold' : 'Put on hold…' %></a>
                  <% if (_holdLater) { %>
                    <form action="/admin/hubs/<%= hub.hub_id %>/billing/cancel-hold" method="POST" data-ah-ajax><button type="submit" class="ah-menu__item"><i class="fa-solid fa-xmark" aria-hidden="true"></i> Cancel the hold</button></form>
                  <% } %>
                <% } %>
                <% if (_bl && _bl.stripe_customer_id) { %>
                  <div class="ah-menu__sep"></div>
                  <form action="/admin/hubs/<%= hub.hub_id %>/billing/sync" method="POST" data-ah-ajax><button type="submit" class="ah-menu__item"><i class="fa-solid fa-rotate" aria-hidden="true"></i> Refresh from Stripe</button></form>
                  <a class="ah-menu__item" href="https://dashboard.stripe.com/<%= _bl.stripe_mode === 'test' ? 'test/' : '' %>customers/<%= _bl.stripe_customer_id %>" target="_blank" rel="noopener" data-no-spa><i class="fa-brands fa-stripe-s" aria-hidden="true"></i> Open in Stripe</a>
                <% } %>
                <% if (_ended) { %>
                  <div class="ah-menu__sep"></div>
                  <form action="/admin/hubs/<%= hub.hub_id %>/billing/restart" method="POST" data-ah-ajax data-ah-ask="Start billing <%= hub.hub_name %> again with this plan?" data-ah-ask-ok="Start billing">
                    <button type="submit" class="ah-menu__item"><i class="fa-solid fa-play" aria-hidden="true"></i> Start billing again</button>
                  </form>
                <% } else if (_bl && _bl.stripe_subscription_id) { %>
                  <div class="ah-menu__sep"></div>
                  <a class="ah-menu__item ah-menu__item--danger" href="/admin/hubs/<%= hub.hub_id %>/billing/end" data-ah-drawer><i class="fa-solid fa-ban" aria-hidden="true"></i> End billing…</a>
                <% } %>
              </div>
            </details>
          </div>
        </div>
        <div class="ap-bill-body">
          <% if (bill.lines.length) { %>
            <ul class="ah-lines">
              <% bill.lines.forEach((l) => { %>
                <li><span><%= l.label %><% if (l.quantity > 1) { %> <em>× <%= l.quantity.toLocaleString('en-US') %> at <%= _m(l.unitPrice) %></em><% } %><% if (l.note) { %><small><%= l.note %></small><% } %></span><strong><%= _m(l.amount) %></strong></li>
              <% }) %>
              <% if (bill.discount > 0) { %><li class="ah-lines__off"><span>Discount<small><%= discount %></small></span><strong>−<%= _m(bill.discount) %></strong></li><% } %>
              <li class="ah-lines__total"><span>Each bill, with today’s numbers</span><strong><%= _m(bill.total) %></strong></li>
            </ul>
          <% } else { %>
            <p class="ah-muted"><%= _bl ? 'Nothing to bill yet.' : 'No plan yet.' %></p>
          <% } %>
          <% if (_facts.length) { %><p class="ap-facts"><%= _facts.join(' · ') %></p><% } %>
        </div>
      </section>

      <section class="ah-card" id="counted" aria-labelledby="countTitle">
        <div class="ah-card__bar">
          <h2 class="ah-card__title" id="countTitle">Schools counted</h2>
          <span class="ah-muted"><%= _num(usage.students) %> students · <%= _num(usage.employees) %> staff · <%= _num(usage.users) %> users</span>
        </div>
        <% if (usage.breakdown.length) { %>
          <div class="ah-scroll">
            <table class="ah-table">
              <thead><tr><th>School</th><th class="ah-num">Students</th><th class="ah-num">Staff</th><th class="ah-num">Users</th><th class="ah-col-ints">Add-ons</th></tr></thead>
              <tbody>
                <% usage.breakdown.forEach((x) => { %>
                  <tr class="<%= x.counted ? '' : 'ah-row--muted' %>">
                    <td><strong><%= x.organization_name %></strong><% if (x.on_hold) { %><span class="ah-sub"><%= x.counted ? 'On hold, still counted' : 'On hold, not counted' %></span><% } %></td>
                    <td class="ah-num"><%= _num(x.students) %></td>
                    <td class="ah-num"><%= _num(x.counted ? x.billedEmployees : x.employees) %></td>
                    <td class="ah-num"><%= _num(x.billedUsers) %></td>
                    <td class="ah-col-ints">
                      <% if (x.integrations.length) { %>
                        <% x.integrations.forEach((key) => { const f = _fees[key]; const todo = manualToAdd.find((t) => t.key === key && Number(t.organization_id) === Number(x.organization_id)); %>
                          <span class="ah-pill<%= f && f.on ? ' ah-pill--fee' : '' %><%= todo ? ' ah-pill--todo' : '' %>"><%= b.INTEGRATION_BY_KEY[key].label.replace(' AI assistant', '').replace(' messages', '') %><%= f && f.on && b.perSeat(key, f.unit) ? ` · ${b.seatCount(key, x.seats[b.INTEGRATION_BY_KEY[key].seat] || 0)}` : '' %><% if (todo) { %> <a class="ah-link-sm" href="/admin/hubs/<%= hub.hub_id %>/billing/charges/new?integration=<%= key %>&org=<%= x.organization_id %>" data-ah-drawer>Add charge</a><% } %></span>
                        <% }) %>
                      <% } else { %><span class="ah-off">None</span><% } %>
                    </td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        <% } else { %>
          <div class="ah-empty ah-empty--sm">No schools in this hub yet.</div>
        <% } %>
      </section>

      <section class="ah-card" id="charges" aria-labelledby="chargesTitle">
        <div class="ah-card__bar">
          <h2 class="ah-card__title" id="chargesTitle">Extra charges</h2>
          <% if (live) { %><a class="ah-btn ah-btn--sm" href="/admin/hubs/<%= hub.hub_id %>/billing/charges/new" data-ah-drawer><i class="fa-solid fa-plus" aria-hidden="true"></i> Add a charge</a><% } %>
        </div>
        <% if (_charges.length) { %>
          <div class="ah-scroll">
            <table class="ah-table">
              <thead><tr><th>Charge</th><th class="ah-num">Price</th><th>How often</th><th>Status</th><th class="ah-num"></th></tr></thead>
              <tbody>
                <% _charges.forEach((c) => { const st = _chargeStatus[c.status] || ['—', 'muted']; %>
                  <tr>
                    <td><strong><%= c.name %></strong><span class="ah-sub"><%= c.requested_by === 'hub' ? 'Added by the hub' : 'Added by Managira' %><%= c.decided_at && c.requested_by !== 'hub' ? ` · ${c.status === 'approved' ? 'approved' : 'declined'} by ${c.decided_by_label}` : '' %></span><% if (unusedCharges.has(c.charge_id)) { %><span class="ah-sub ah-sub--warn">The school no longer uses this</span><% } %></td>
                    <td class="ah-num"><%= _m(c.unit_price) %><% if (Number(c.quantity) > 1) { %> × <%= c.quantity %><% } %></td>
                    <td><%= c.frequency === 'once' ? 'One time' : `Each ${_per}` %></td>
                    <td><span class="ah-bill ah-bill--<%= st[1] %>"><%= st[0] %></span></td>
                    <td class="ah-actions-cell">
                      <% if (c.status === 'pending' || c.status === 'approved') { %>
                        <form action="/admin/hubs/<%= hub.hub_id %>/billing/charges/<%= c.charge_id %>/remove" method="POST" data-ah-ajax data-ah-danger data-ah-ask-ok="Remove" data-ah-ask="Remove <%= c.name %> from <%= hub.hub_name %>’s bill? It stops from the next bill.">
                          <button type="submit" class="ah-btn ah-btn--sm ah-btn--icon" aria-label="Remove <%= c.name %>"><i class="fa-solid fa-trash" aria-hidden="true"></i></button>
                        </form>
                      <% } %>
                    </td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        <% } else { %>
          <div class="ah-empty ah-empty--sm">No extra charges.</div>
        <% } %>
      </section>

      <section class="ah-card" aria-labelledby="billsTitle">
        <div class="ah-card__bar"><h2 class="ah-card__title" id="billsTitle">Past bills</h2></div>
        <% if (_bills.length) { %>
          <div class="ah-scroll">
            <table class="ah-table">
              <thead><tr><th>Date</th><th>Period</th><th class="ah-num">Amount</th><th>Status</th><th class="ah-num"></th></tr></thead>
              <tbody>
                <% _bills.forEach((i) => { const st = _invStatus[i.status] || [i.status, 'muted']; %>
                  <tr>
                    <td><%= _d(i.issued_at) %><span class="ah-sub"><%= i.number || '' %><%= i.isTest ? ' · test' : '' %></span></td>
                    <td><span class="ah-sub" style="margin:0"><%= i.period_start ? `${_d(i.period_start)} – ${_d(i.period_end)}` : '—' %></span></td>
                    <td class="ah-num"><%= b.money(i.status === 'paid' ? i.amount_paid : i.amount_due, i.currency) %></td>
                    <td><span class="ah-bill ah-bill--<%= st[1] %>"><%= st[0] %></span></td>
                    <td class="ah-actions-cell"><a class="ah-btn ah-btn--sm" href="<%= i.hosted_invoice_url || `/admin/hubs/${hub.hub_id}/billing/invoices/${i.stripe_invoice_id}/pdf` %>" target="_blank" rel="noopener" data-no-spa><i class="fa-regular fa-file-lines" aria-hidden="true"></i> View</a></td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        <% } else { %>
          <div class="ah-empty ah-empty--sm">No bills yet.</div>
        <% } %>
      </section>
    </div>

    <aside class="ah-layout__side">
      <section class="ah-card ah-pad" aria-labelledby="payTitle">
        <h2 class="ah-section" id="payTitle">Payment</h2>
        <p class="ap-card-line"><i class="fa-solid fa-credit-card" aria-hidden="true"></i> <%= hasCard ? `${b.methodLabel(_bl)}${_bl.card_exp_month ? `, expires ${_bl.card_exp_month}/${_bl.card_exp_year}` : ''}` : 'No card yet' %></p>
        <% if (!live) { %>
          <p class="ah-muted"><%= _ended ? 'Billing has ended.' : 'Set a price to make the payment link.' %></p>
        <% } else { %>
          <div class="ah-copy">
            <input type="text" readonly value="<%= setupUrl %>" aria-label="Payment link" data-ah-copy-src />
            <button type="button" class="ah-btn ah-btn--sm" data-ah-copy><i class="fa-regular fa-copy" aria-hidden="true"></i> Copy</button>
          </div>
          <form action="/admin/hubs/<%= hub.hub_id %>/billing/send-link" method="POST" data-ah-ajax>
            <button type="submit" class="ah-btn ah-btn--primary ah-btn--block"><i class="fa-solid fa-envelope" aria-hidden="true"></i> <%= hasCard ? 'Email the link to change card' : (_bl.setup_link_sent_at ? 'Email the link again' : 'Email the link') %></button>
          </form>
          <div class="ahb-hint">To <%= hub.hub_email %><%= _bl.billing_email ? `, ${_bl.billing_email}` : '' %> and billing people.<% if (_bl.setup_link_sent_at) { %> Sent <%= _d(_bl.setup_link_sent_at) %>.<% } %>
            <form action="/admin/hubs/<%= hub.hub_id %>/billing/new-link" method="POST" data-ah-ajax data-ah-ask="Make a new link? The old link stops working." data-ah-ask-ok="Make new link" style="display:inline">
              <button type="submit" class="ap-linkbtn">New link</button>
            </form>
          </div>
        <% } %>
      </section>

      <section class="ah-card ah-pad" id="people" aria-labelledby="peopleTitle">
        <div class="ah-card__head">
          <h2 class="ah-section" id="peopleTitle">People with access</h2>
          <a class="ah-btn ah-btn--sm" href="/admin/hubs/<%= hub.hub_id %>/people/new" data-ah-drawer><i class="fa-solid fa-user-plus" aria-hidden="true"></i> Add</a>
        </div>
        <ul class="ah-people">
          <li><span class="ah-avatar ah-avatar--sm"><%= (hub.first_name || 'O').charAt(0) %></span><span><strong><%= _owner %></strong><small>Owner<%= hub.has_password ? '' : ' · password not set' %></small></span></li>
          <% people.forEach((p) => { const billingOk = p.role === 'hub_admin' || (p.permissions || []).includes('billing.view'); %>
            <li>
              <span class="ah-avatar ah-avatar--sm"><%= (p.first_name || '?').charAt(0) %></span>
              <span><strong><%= p.first_name %> <%= p.last_name %></strong><small><%= p.role === 'hub_admin' ? 'Hub admin' : (billingOk ? 'Billing' : 'Hub user') %><%= p.has_password ? '' : ' · invited' %><%= p.on_hold ? ' · on hold' : '' %></small></span>
              <% if (!p.has_password) { %>
                <form action="/admin/hubs/<%= hub.hub_id %>/people/<%= p.hub_user_id %>/invite" method="POST" data-ah-ajax><button type="submit" class="ah-btn ah-btn--sm" title="Email the invitation again">Resend</button></form>
              <% } %>
            </li>
          <% }) %>
        </ul>
        <p class="ahb-hint"><%= license.max == null ? 'No user limit.' : `${license.used} of ${license.max} user licenses used.` %></p>
      </section>

      <% if (activity.length) { %>
        <details class="ah-card ah-pad ap-history">
          <summary class="ah-section">History</summary>
          <ul class="ah-log">
            <% activity.forEach((a) => { %>
              <li><span><%= a.description %></span><small><%= _d(a.created_at) %> · <%= a.performed_by || 'Managira' %></small></li>
            <% }) %>
          </ul>
        </details>
      <% } %>
    </aside>
  </div>

  <%- include('partials/hubAdminDialogs') %>
</div>
