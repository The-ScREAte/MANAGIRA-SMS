<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Help Tickets</title>
    <link rel="stylesheet" href="/css/admin.css" />
    <style>
      :root {
        --font-family: "Inter", sans-serif;
      }

      body {
        font-family: var(--font-family);
        background-color: #f3f4f6;
        margin: 0;
        color: #333;
      }

      .content-container {
        max-width: 1200px;
        margin: 40px auto;
        padding: 24px;
        background-color: #fff;
        border-radius: 12px;
        box-shadow: 0 4px 16px rgba(0, 0, 0, 0.08);
      }

      h1 {
        text-align: center;
        color: var(--admin-text-primary, #111827);
        margin-bottom: 24px;
        font-size: 1.75rem;
        font-weight: 700;
      }

      .link-to-next-back {
        display: flex;
        justify-content: center;
        margin-bottom: 20px;
      }

      .ticket-table {
        width: 100%;
        border-collapse: collapse;
        background-color: #fff;
        border-radius: 10px;
        overflow: hidden;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);
        margin-bottom: 20px;
      }

      .ticket-table th,
      .ticket-table td {
        padding: 14px 16px;
        text-align: left;
        border-bottom: 1px solid #e5e7eb;
      }

      .ticket-table th {
        background-color: var(--admin-primary, #2563eb);
        color: #fff;
        text-transform: uppercase;
        font-size: 0.75rem;
        font-weight: 600;
        letter-spacing: 0.05em;
      }

      .ticket-summary {
        cursor: pointer;
        font-weight: 600;
        transition: background-color 0.2s;
      }

      .ticket-summary:hover {
        background-color: #f9fafb;
      }

      .ticket-summary .arrow {
        float: right;
        font-size: 14px;
        transition: transform 0.3s ease;
        color: var(--admin-primary, #2563eb);
      }

      .ticket-summary .arrow.expanded {
        transform: rotate(90deg);
      }

      .ticket-details {
        display: none;
        padding: 20px;
        border: 1px solid #e5e7eb;
        border-radius: 10px;
        background-color: #f9fafb;
        margin: 8px 16px 16px;
      }

      .status-open {
        color: var(--admin-danger, #dc2626);
        font-weight: 600;
      }

      .status-closed {
        color: var(--admin-success, #059669);
        font-weight: 600;
      }

      .details-container {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
        gap: 20px;
      }

      .info-container,
      .messages-container {
        padding: 16px;
        border-radius: 10px;
        background-color: #fff;
        border: 1px solid #e5e7eb;
      }

      .info-container div {
        margin-bottom: 8px;
        font-size: 0.9rem;
        color: var(--admin-text-secondary, #4b5563);
      }

      .info-container strong {
        color: var(--admin-text-primary, #111827);
      }

      .messages-container h3 {
        margin: 0 0 12px;
        font-size: 1rem;
        color: var(--admin-text-primary, #111827);
      }

      .chat-container {
        display: flex;
        flex-direction: column;
        gap: 10px;
        max-height: 300px;
        overflow-y: auto;
        padding: 12px;
        background-color: #f9fafb;
        border-radius: 10px;
        border: 1px solid #e5e7eb;
      }

      .chat-message {
        max-width: 80%;
        padding: 12px 16px;
        border-radius: 12px;
        font-size: 14px;
        line-height: 1.5;
      }

      .user-message {
        align-self: flex-start;
        background-color: #dbeafe;
        color: #1e40af;
      }

      .admin-message {
        align-self: flex-end;
        background-color: #d1fae5;
        color: #065f46;
      }

      .form-container {
        display: flex;
        flex-direction: column;
        gap: 12px;
        border: 1px solid #e5e7eb;
        border-radius: 10px;
        padding: 16px;
        background-color: #fff;
      }

      .form-container textarea {
        resize: vertical;
        min-height: 80px;
        padding: 12px;
        border: 1px solid #d1d5db;
        border-radius: 8px;
        font-family: inherit;
        font-size: 0.875rem;
      }

      .form-container textarea:focus {
        outline: none;
        border-color: var(--admin-primary, #2563eb);
        box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.1);
      }

      .ticket-actions {
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
      }

      @media (max-width: 768px) {
        .content-container {
          margin: 20px 10px;
          padding: 16px;
        }

        .details-container {
          grid-template-columns: 1fr;
        }

        .ticket-actions {
          flex-direction: column;
        }

        .ticket-actions .admin-btn {
          width: 100%;
        }

        .ticket-table {
          display: block;
          overflow-x: auto;
        }
      }

      @media (max-width: 480px) {
        .content-container {
          margin: 12px 8px;
          padding: 12px;
        }

        h1 {
          font-size: 1.4rem;
        }

        .ticket-table th,
        .ticket-table td {
          padding: 10px 12px;
          font-size: 0.85rem;
        }
      }
    </style>
    <script>
      function toggleDetails(ticketId) {
        const details = document.getElementById(`details-${ticketId}`);
        const arrow = document.getElementById(`arrow-${ticketId}`);
        if (details.style.display === "none" || !details.style.display) {
          details.style.display = "grid";
          arrow.classList.add("expanded");
        } else {
          details.style.display = "none";
          arrow.classList.remove("expanded");
        }
      }

      function confirmAction(event, message) {
        if (!confirm(message)) {
          event.preventDefault();
        }
      }
    </script>
</head>
<body>
  <div class="content-container">
    <div class="link-to-next-back">
      <a href="/admin/helpHistory" class="admin-btn admin-btn-secondary">📜 Ticket History</a>
    </div>

    <hr style="border: none; border-top: 1px solid #e5e7eb; margin: 20px 0;">
    <h1>Help Tickets</h1>
    
    <%- include('../partials/flash') %>

    <table class="ticket-table">
      <thead>
        <tr>
          <th>Ticket #</th>
          <th>Status</th>
          <th>Name</th>
          <th>Organization</th>
        </tr>
      </thead>
      <tbody>
        <% threads.sort((a, b) => a.thread_id - b.thread_id).forEach(thread => { %>
          <tr class="ticket-summary" onclick="toggleDetails('<%= thread.thread_id %>')">
            <td>#<%= thread.thread_id %> <span id="arrow-<%= thread.thread_id %>" class="arrow">▶</span></td>
            <td class="<%= thread.is_resolved ? 'status-closed' : 'status-open' %>">
              <%= thread.is_resolved ? '✓ Closed' : '● Open' %>
            </td>
            <td><%= thread.name %></td>
            <td><%= thread.organization || 'N/A' %></td>
          </tr>
          <tr>
            <td colspan="4" style="padding: 0; border: none;">
              <div id="details-<%= thread.thread_id %>" class="ticket-details">
                <div class="details-container">
                  <div class="info-container">
                    <div><strong>Email:</strong> <%= thread.email %></div>
                    <div><strong>Phone:</strong> <%= thread.phone || 'N/A' %></div>
                    <div><strong>Status:</strong> <%= thread.is_resolved ? 'Closed' : 'Open' %></div>
                    <div><strong>Last Updated:</strong> <%= new Date(thread.last_updated).toLocaleString() %></div>
                  </div>
                  <div class="messages-container">
                    <h3>💬 Chat</h3>
                    <div class="chat-container">
                      <% thread.messages.forEach((message, index) => { %>
                        <div class="<%= index % 2 === 0 ? 'chat-message user-message' : 'chat-message admin-message' %>">
                          <p style="margin: 0;"><%= message %></p>
                        </div>
                      <% }) %>
                    </div>
                  </div>
                  <div class="form-container">
                    <form action="/admin/respondMessage" method="POST">
                      <input type="hidden" name="threadId" value="<%= thread.thread_id %>">
                      <textarea name="response" placeholder="Write your response here..." required></textarea>
                      <div class="ticket-actions">
                        <button type="submit" class="admin-btn admin-btn-primary" onclick="confirmAction(event, 'Send this response?')">
                          ✉️ Respond
                        </button>
                        <button type="submit" formaction="/admin/resolveMessage" class="admin-btn admin-btn-success" onclick="confirmAction(event, 'Mark this ticket as closed?')">
                          ✓ Close Ticket
                        </button>
                        <button type="submit" formaction="/admin/tempDeleteMessage" class="admin-btn admin-btn-delete" onclick="confirmAction(event, 'Delete this ticket?')">
                          🗑 Delete
                        </button>
                      </div>
                    </form>
                  </div>
                </div>
              </div>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</body>
</html>
