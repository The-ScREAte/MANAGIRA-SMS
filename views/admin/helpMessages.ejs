<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Help Tickets</title>
    <link rel="stylesheet" href="/css/admin.css" />
    <%
      // Ensure messages object exists for flash partial
      if (typeof messages === 'undefined') {
        var messages = { success: [], error: [], info: [] };
      }
    %>
    <style>
      :root {
        --font-family: "<%= (session && session.fontStyle ? String(session.fontStyle).trim() : 'Inter') %>", sans-serif;
      }

      body {
        font-family: var(--font-family);
        background-color: #f3f4f6;
        margin: 0;
        color: #333;
      }

      .content-container {
        max-width: 1200px;
        margin: 40px auto;
        padding: 24px;
        background-color: #fff;
        border-radius: 12px;
        box-shadow: 0 4px 16px rgba(0, 0, 0, 0.08);
      }

      h1 {
        text-align: center;
        color: var(--admin-text-primary, #111827);
        margin-bottom: 24px;
        font-size: 1.75rem;
        font-weight: 700;
      }

      .link-to-next-back {
        display: flex;
        justify-content: center;
        margin-bottom: 20px;
      }

      .support-tabs {
        display: flex;
        gap: 10px;
        justify-content: center;
        flex-wrap: wrap;
        margin-bottom: 18px;
      }

      .support-tab {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 10px 14px;
        border-radius: 999px;
        border: 1px solid #d1d5db;
        background: rgba(255, 255, 255, 0.88);
        color: #64748b;
        text-decoration: none;
        font-size: 0.86rem;
        font-weight: 700;
        transition: all 0.18s ease;
      }

      .support-tab.active {
        background: var(--admin-primary, #2563eb);
        border-color: var(--admin-primary, #2563eb);
        color: #fff;
        box-shadow: 0 12px 22px rgba(37, 99, 235, 0.16);
      }

      .support-tab:not(.active):hover {
        color: #111827;
        border-color: #93c5fd;
      }

      .ticket-table {
        width: 100%;
        border-collapse: collapse;
        background-color: #fff;
        border-radius: 10px;
        overflow: hidden;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);
        margin-bottom: 20px;
      }

      .ticket-table th,
      .ticket-table td {
        padding: 14px 16px;
        text-align: left;
        border-bottom: 1px solid #e5e7eb;
      }

      .ticket-table th {
        background-color: var(--admin-primary, #2563eb);
        color: #fff;
        text-transform: uppercase;
        font-size: 0.75rem;
        font-weight: 600;
        letter-spacing: 0.05em;
      }

      .ticket-summary {
        cursor: pointer;
        font-weight: 600;
        transition: background-color 0.2s;
      }

      .ticket-summary:hover {
        background-color: #f9fafb;
      }

      .ticket-summary .arrow {
        float: right;
        font-size: 14px;
        transition: transform 0.3s ease;
        color: var(--admin-primary, #2563eb);
      }

      .ticket-summary .arrow.expanded {
        transform: rotate(90deg);
      }

      .ticket-details {
        display: none;
        padding: 20px;
        border: 1px solid #e5e7eb;
        border-radius: 10px;
        background-color: #f9fafb;
        margin: 8px 16px 16px;
      }

      .status-open {
        color: var(--admin-danger, #dc2626);
        font-weight: 600;
      }

      .status-closed {
        color: var(--admin-success, #059669);
        font-weight: 600;
      }

      .details-container {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
        gap: 20px;
      }

      .info-container,
      .messages-container {
        padding: 16px;
        border-radius: 10px;
        background-color: #fff;
        border: 1px solid #e5e7eb;
      }

      .info-container div {
        margin-bottom: 8px;
        font-size: 0.9rem;
        color: var(--admin-text-secondary, #4b5563);
      }

      .info-container strong {
        color: var(--admin-text-primary, #111827);
      }

      .messages-container h3 {
        margin: 0 0 12px;
        font-size: 1rem;
        color: var(--admin-text-primary, #111827);
      }

      .chat-container {
        display: flex;
        flex-direction: column;
        gap: 10px;
        max-height: 300px;
        overflow-y: auto;
        padding: 12px;
        background-color: #f9fafb;
        border-radius: 10px;
        border: 1px solid #e5e7eb;
      }

      .chat-message {
        max-width: 80%;
        padding: 12px 16px;
        border-radius: 12px;
        font-size: 14px;
        line-height: 1.5;
      }

      .user-message {
        align-self: flex-start;
        background-color: #dbeafe;
        color: #1e40af;
      }

      .admin-message {
        align-self: flex-end;
        background-color: #d1fae5;
        color: #065f46;
      }

      .form-container {
        display: flex;
        flex-direction: column;
        gap: 12px;
        border: 1px solid #e5e7eb;
        border-radius: 10px;
        padding: 16px;
        background-color: #fff;
      }

      .form-container textarea {
        resize: vertical;
        min-height: 80px;
        padding: 12px;
        border: 1px solid #d1d5db;
        border-radius: 8px;
        font-family: inherit;
        font-size: 0.875rem;
      }

      .form-container textarea:focus {
        outline: none;
        border-color: var(--admin-primary, #2563eb);
        box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.1);
      }

      .ticket-actions {
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
      }

      @media (max-width: 768px) {
        .content-container {
          margin: 20px 10px;
          padding: 16px;
        }

        .details-container {
          grid-template-columns: 1fr;
        }

        .ticket-actions {
          flex-direction: column;
        }

        .ticket-actions .admin-btn {
          width: 100%;
        }

        .ticket-table {
          display: block;
          overflow-x: auto;
        }
      }

      @media (max-width: 480px) {
        .content-container {
          margin: 12px 8px;
          padding: 12px;
        }

        h1 {
          font-size: 1.4rem;
        }

        .ticket-table th,
        .ticket-table td {
          padding: 10px 12px;
          font-size: 0.85rem;
        }
      }
    </style>
    <script>
      function toggleDetails(ticketId) {
        const details = document.getElementById(`details-${ticketId}`);
        const arrow = document.getElementById(`arrow-${ticketId}`);
        if (details.style.display === "none" || !details.style.display) {
          details.style.display = "grid";
          arrow.classList.add("expanded");
        } else {
          details.style.display = "none";
          arrow.classList.remove("expanded");
        }
      }

      function confirmAction(event, message) {
        if (!confirm(message)) {
          event.preventDefault();
        }
      }
    </script>
</head>
<body>
  <div class="content-container">
    <% 
      const _helpFeedbackAccountType = String(session && session.accountType ? session.accountType : '').trim().toLowerCase();
      const canAccessFeedbackInbox = _helpFeedbackAccountType === 'admin' || _helpFeedbackAccountType === 'mini admin';
    %>
    <div class="link-to-next-back">
      <a href="/admin/helpHistory" class="admin-btn admin-btn-secondary">📜 Ticket History</a>
    </div>

    <div class="support-tabs">
      <a href="/admin/helpMessages" class="support-tab active">Help Tickets</a>
      <% if (canAccessFeedbackInbox) { %>
      <a href="/admin/feedback" class="support-tab">Feedback</a>
      <% } %>
    </div>

    <hr style="border: none; border-top: 1px solid #e5e7eb; margin: 20px 0;">
    <h1>Help Tickets</h1>
    
    <%- include('../partials/flash') %>

    <form id="bulkForm" action="/admin/bulkDeleteMessages" method="POST" onsubmit="return confirmBulk(event)">
      <div style="display:flex;justify-content:space-between;align-items:center;gap:12px;margin-bottom:12px;flex-wrap:wrap;">
        <label style="display:flex;align-items:center;gap:8px;font-size:0.9rem;">
          <input type="checkbox" id="selectAll" onclick="toggleAll(this)"> Select all
        </label>
        <button type="submit" class="admin-btn admin-btn-delete" id="bulkDelBtn" disabled>🗑 Delete Selected</button>
      </div>
    </form>

      <table class="ticket-table">
        <thead>
          <tr>
            <th style="width:36px;"></th>
            <th>Ticket #</th>
            <th>Type</th>
            <th>Status</th>
            <th>Name</th>
            <th>Organization</th>
          </tr>
        </thead>
        <tbody>
          <% threads.sort((a, b) => a.thread_id - b.thread_id).forEach(thread => {
              const firstMsg = (thread.messages && thread.messages[0]) ? String(thread.messages[0]) : '';
              const isDemo = /^\s*\[DEMO REQUEST\]/i.test(firstMsg) || /^\s*Demo Request from/i.test(firstMsg);
              const typeLabel = isDemo ? 'Demo' : 'Help';
              const typeColor = isDemo ? '#7c2d12' : '#1e3a8a';
              const typeBg = isDemo ? '#fef3c7' : '#dbeafe';
          %>
            <tr class="ticket-summary">
              <td onclick="event.stopPropagation()">
                <input type="checkbox" name="threadIds" value="<%= thread.thread_id %>" class="row-check" form="bulkForm" onclick="updateBulkBtn()">
              </td>
              <td onclick="toggleDetails('<%= thread.thread_id %>')">#<%= thread.thread_id %> <span id="arrow-<%= thread.thread_id %>" class="arrow">▶</span></td>
              <td onclick="toggleDetails('<%= thread.thread_id %>')">
                <span style="display:inline-block;padding:3px 9px;border-radius:999px;background:<%= typeBg %>;color:<%= typeColor %>;font-size:0.72rem;font-weight:700;letter-spacing:.04em;text-transform:uppercase;">
                  <%= typeLabel %>
                </span>
              </td>
              <td onclick="toggleDetails('<%= thread.thread_id %>')" class="<%= thread.is_resolved ? 'status-closed' : 'status-open' %>">
                <%= thread.is_resolved ? '✓ Closed' : '● Open' %>
              </td>
              <td onclick="toggleDetails('<%= thread.thread_id %>')"><%= thread.name %></td>
              <td onclick="toggleDetails('<%= thread.thread_id %>')"><%= thread.organization || 'N/A' %></td>
            </tr>
            <tr>
              <td colspan="6" style="padding: 0; border: none;">
                <div id="details-<%= thread.thread_id %>" class="ticket-details">
                  <div class="details-container">
                    <div class="info-container">
                      <div><strong>Type:</strong> <%= typeLabel %> Request</div>
                      <div><strong>Email:</strong> <%= thread.email %></div>
                      <div><strong>Phone:</strong> <%= thread.phone || 'N/A' %></div>
                      <div><strong>Status:</strong> <%= thread.is_resolved ? 'Closed' : 'Open' %></div>
                      <div><strong>Last Updated:</strong> <%= new Date(thread.last_updated).toLocaleString() %></div>
                    </div>
                    <div class="messages-container">
                      <h3>💬 Chat</h3>
                      <div class="chat-container">
                        <% thread.messages.forEach((message, index) => { %>
                          <div class="<%= index % 2 === 0 ? 'chat-message user-message' : 'chat-message admin-message' %>">
                            <p style="margin: 0; white-space: pre-wrap;"><%= message %></p>
                          </div>
                        <% }) %>
                      </div>
                    </div>
                    <div class="form-container">
                      <%# Each row has its own form to keep response & close/delete independent %>
                      <form action="/admin/respondMessage" method="POST" onsubmit="return validateRespond(this)">
                        <input type="hidden" name="threadId" value="<%= thread.thread_id %>">
                        <% if (isDemo) { %>
                          <div style="display:flex;justify-content:space-between;align-items:center;gap:8px;margin-bottom:6px;flex-wrap:wrap;">
                            <span style="font-size:0.78rem;color:#64748b;">Demo request detected — you can use a quick template.</span>
                            <button type="button" class="admin-btn admin-btn-primary demo-template-btn" style="padding:4px 10px;font-size:0.78rem;" data-thread-id="<%= thread.thread_id %>" data-name="<%= thread.name || '' %>">📋 Use demo template</button>
                          </div>
                        <% } %>
                        <textarea name="response" id="response-<%= thread.thread_id %>" placeholder="Write your response here (required only for Respond)..."></textarea>
                        <div class="ticket-actions">
                          <button type="submit" class="admin-btn admin-btn-primary">✉️ Respond</button>
                          <button type="button" class="admin-btn admin-btn-success" onclick="submitNoMsg(this, '/admin/resolveMessage', '<%= thread.thread_id %>', 'Mark this ticket as closed?')">✓ Close Ticket</button>
                          <button type="button" class="admin-btn admin-btn-delete" onclick="submitNoMsg(this, '/admin/tempDeleteMessage', '<%= thread.thread_id %>', 'Delete this ticket?')">🗑 Delete</button>
                        </div>
                      </form>
                    </div>
                  </div>
                </div>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
  </div>

  <script>
    function toggleAll(cb) {
      document.querySelectorAll('.row-check').forEach(c => c.checked = cb.checked);
      updateBulkBtn();
    }
    function updateBulkBtn() {
      const any = document.querySelectorAll('.row-check:checked').length > 0;
      document.getElementById('bulkDelBtn').disabled = !any;
    }
    function confirmBulk(e) {
      const n = document.querySelectorAll('.row-check:checked').length;
      if (n === 0) { e.preventDefault(); return false; }
      if (!confirm(`Delete ${n} selected ticket${n === 1 ? '' : 's'}?`)) { e.preventDefault(); return false; }
      return true;
    }
    function validateRespond(form) {
      const t = form.querySelector('textarea[name="response"]');
      if (!t.value.trim()) {
        alert('Please write a response message before sending.');
        t.focus();
        return false;
      }
      return confirm('Send this response?');
    }
    function applyDemoTemplate(btn, threadId, name) {
      const ta = document.getElementById('response-' + threadId);
      if (!ta) return;
      const firstName = (name || '').toString().trim().split(/\s+/)[0] || 'there';
      const tpl = `Hi ${firstName},\n\nThank you for reaching out and for your interest in Managira. We are delighted to hear from you and would be pleased to introduce you to Managira, our all-in-one school management system designed to support more efficient, organized, and productive school administration.\n\nPlease use the link below to choose a time that works best for you. During the session, we will walk you through the platform, highlight the features most relevant to your needs, and answer any questions you may have.\n\nhttps://filevine.slack.com/archives/D0AR5HBHUC9/p1782314109507379\n\nIf none of the available times are convenient, please reply with a few options that suit your schedule, and we will do our best to accommodate you.\n\nWe look forward to speaking with you and showing you how Managira can support your institution.\n\nBest regards,\nThe Managira Team`;
      if (ta.value.trim() && !confirm('Replace the current draft with the demo template?')) return;
      ta.value = tpl;
      ta.focus();
    }
    document.addEventListener('click', function (e) {
      const btn = e.target.closest('.demo-template-btn');
      if (!btn) return;
      e.preventDefault();
      applyDemoTemplate(btn, btn.dataset.threadId, btn.dataset.name || '');
    });
    function submitNoMsg(btn, action, threadId, msg) {
      if (!confirm(msg)) return;
      const f = document.createElement('form');
      f.method = 'POST';
      f.action = action;
      const i = document.createElement('input');
      i.type = 'hidden'; i.name = 'threadId'; i.value = threadId;
      f.appendChild(i);
      document.body.appendChild(f);
      f.submit();
    }
  </script>
</body>
</html>
