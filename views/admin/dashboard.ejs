<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Admin Dashboard</title>
    <script>
      function toggleDetails(id) {
        const details = document.getElementById(`details-${id}`);
        details.style.display =
          details.style.display === "none" ? "block" : "none";
      }

      function openModal(imageUrl) {
        document.getElementById("modalImage").src = imageUrl;
        document.getElementById("imageModal").style.display = "block";
      }

      function closeModal() {
        document.getElementById("imageModal").style.display = "none";
      }

      function confirmAction(action, organizationName) {
        return confirm(
          `Are you sure you want to ${action} the organization "${organizationName}"?`
        );
      }
    </script>
    <style>
      :root {
        --font-family: "Inter", sans-serif;
      }

      body {
        font-family: var(--font-family);
        background-color: #f3f4f6;
        margin: 0;
        color: #333;
      }

      .content-container {
        max-width: 1100px;
        margin: 40px auto;
        padding: 20px;
        background-color: #ffffff;
        border-radius: 10px;
        box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
      }

      h1 {
        text-align: center;
        color: #333;
        margin-bottom: 20px;
      }

      .applications-container {
        margin-top: 20px;
      }

      .application-summary {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 15px;
        border: 1px solid #ddd;
        border-radius: 8px;
        margin-bottom: 15px;
        background-color: #f9f9f9;
        transition: box-shadow 0.3s ease;
      }

      .application-summary:hover {
        box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
      }

      .org-link {
        font-size: 1.2rem;
        font-weight: bold;
        color: #01535b;
        text-decoration: none;
        flex: 1;
      }

      .org-link:hover {
        text-decoration: underline;
      }

      .status-info {
        display: flex;
        align-items: center;
      }

      .status-indicator {
        width: 14px;
        height: 14px;
        border-radius: 50%;
        margin-right: 8px;
      }

      .status-indicator.active {
        background-color: green;
      }

      .status-indicator.on-hold {
        background-color: orange;
      }

      .hold-info {
        font-size: 0.9rem;
        padding: 10px;
        color: #666;
      }

      .expand-button {
        padding: 8px 12px;
        width: 100px;
        background-color: #c6d3fd;
        border: 1px solid #0d0808;
        color: #010d1a;
        font-size: 1rem;
        border-radius: 4px;
        cursor: pointer;
        transition: background-color 0.3s ease;
      }

      .expand-button:hover {
        background-color: #dce0fc;
      }

      .application-details {
        display: none;
        padding: 15px;
        background-color: #ffffff;
        border: 1px solid #ddd;
        border-radius: 8px;
        margin-top: 10px;
      }

      .application-details p {
        margin: 5px 0;
        font-size: 0.95rem;
      }

      .thumbnail {
        width: 100px;
        height: 100px;
        cursor: pointer;
        margin: 10px 0;
        border-radius: 5px;
        border: 1px solid #ddd;
        transition: transform 0.3s, box-shadow 0.3s;
      }

      .thumbnail:hover {
        transform: scale(1.2);
        box-shadow: 0 4px 8px rgba(0, 0, 0, 0.2);
      }

      button {
        padding: 6px 12px;
        background-color: #007bff;
        color: white;
        border: none;
        border-radius: 4px;
        cursor: pointer;
        font-size: 0.9rem;
      }

      button:hover {
        background-color: #0056b3;
      }

      /* Modal Styles */
      .modal {
        display: none;
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background-color: rgba(0, 0, 0, 0.8);
        z-index: 1000;
      }

      .modal-content {
        margin: auto;
        display: block;
        max-width: 90%;
        border-radius: 8px;
      }

      .close {
        position: absolute;
        top: 20px;
        right: 40px;
        font-size: 2rem;
        color: white;
        cursor: pointer;
      }

      .close:hover {
        color: #bbb;
      }
    </style>
  </head>
  <body>
    <div class="content-container">
      <h1>Organizations</h1>

      <%- include('../partials/flash') %>

      <div class="applications-container">
        <% if (applications && applications.length > 0) { %> <%
        applications.forEach(function(application) { %>
        <div class="application-summary">
          <!-- Organization name on the left -->
          <% let orgDashboardUrl = `/admin/org/${application.organization_id}`; %>
          <a href="<%= orgDashboardUrl %>" class="org-link superadmin-org-link" data-orgname="<%= application.organization_name %>" data-orgurl="<%= orgDashboardUrl %>" style="color: #01535b; font-weight: bold; font-size: 1.2rem; text-shadow: 0 1px 0 #fff; text-align:left; display:inline-block;">
            <%= application.organization_name && application.organization_name.trim() !== '' ? application.organization_name : '(No Name)' %>
          </a>

          <!-- Status and hold info -->
          <div class="status-info">
            <% if (application.on_hold) { %>
            <span class="hold-info"
              >Hold by <strong><%= application.hold_by %></strong></span
            >
            <% } %>
            <span
              class="status-indicator <%= application.on_hold ? 'on-hold' : 'active' %>"
            ></span>
          </div>

          <!-- Expand button on the right -->
          <button
            class="expand-button"
            onclick="toggleDetails('<%= application.organization_id %>')"
          >
            Details
          </button>
        </div>

        <!-- Hidden details section -->
        <div
          id="details-<%= application.organization_id %>"
          class="application-details"
        >
          <p><strong>First Name:</strong> <%= application.first_name %></p>
          <p><strong>Last Name:</strong> <%= application.last_name %></p>
          <p><strong>Email:</strong> <%= application.email %></p>
          <p>
            <strong>Address:</strong> <%= application.organization_address %>
          </p>
          <p><strong>Phone:</strong> <%= application.organization_phone %></p>

          <div>
            <p><strong>Proof of Existence 1:</strong></p>
            <% if (application.proof_of_existence_1 && application.proof_of_existence_1.toLowerCase().endsWith('.pdf')) { %>
              <embed src="<%= application.proof_of_existence_1 %>" type="application/pdf" width="100%" height="400px" />
              <br/>
              <a href="<%= application.proof_of_existence_1 %>" target="_blank">Open PDF in new tab</a>
            <% } else if (application.proof_of_existence_1) { %>
              <img
                src="<%= application.proof_of_existence_1 %>"
                alt="Proof 1"
                class="thumbnail"
                onclick="openModal('<%= application.proof_of_existence_1 %>')"
              />
            <% } %>
          </div>
          <div>
            <p><strong>Proof of Existence 2:</strong></p>
            <% if (application.proof_of_existence_2 && application.proof_of_existence_2.toLowerCase().endsWith('.pdf')) { %>
              <embed src="<%= application.proof_of_existence_2 %>" type="application/pdf" width="100%" height="400px" />
              <br/>
              <a href="<%= application.proof_of_existence_2 %>" target="_blank">Open PDF in new tab</a>
            <% } else if (application.proof_of_existence_2) { %>
              <img
                src="<%= application.proof_of_existence_2 %>"
                alt="Proof 2"
                class="thumbnail"
                onclick="openModal('<%= application.proof_of_existence_2 %>')"
              />
            <% } %>
          </div>

          <% if (application.on_hold) { %>
          <form
            action="/admin/resume"
            method="post"
            style="display: inline"
            onsubmit="return confirmAction('resume', '<%= application.organization_name %>');"
          >
            <input
              type="hidden"
              name="orgId"
              value="<%= application.organization_id %>"
            />
            <button type="submit">Resume</button>
          </form>
          <% } else { %>
          <form
            action="/admin/hold"
            method="post"
            style="display: inline"
            onsubmit="return confirmAction('put on hold', '<%= application.organization_name %>');"
          >
            <input
              type="hidden"
              name="orgId"
              value="<%= application.organization_id %>"
            />
            <button type="submit">Put on Hold</button>
          </form>
          <% } %>

          <form
            action="/admin/delete"
            method="post"
            style="display: inline"
            onsubmit="return confirmAction('delete', '<%= application.organization_name %>');"
          >
            <input
              type="hidden"
              name="orgId"
              value="<%= application.organization_id %>"
            />
            <button type="submit">Delete</button>
          </form>
        </div>
        <% }); %> <% } else { %>
        <p>No organizations found.</p>
        <% } %>
      </div>
    </div>

    <div id="imageModal" class="modal">
      <span class="close" onclick="closeModal()">&times;</span>
      <img class="modal-content" id="modalImage" />
    </div>
  </body>
    <!-- Super Admin Org Access Modal -->
    <div id="superadmin-org-modal" class="superadmin-org-modal" style="display:none;">
      <div class="superadmin-org-modal-content">
        <h2>Super Admin Org Access</h2>
        <p>You are about to enter <b id="superadmin-org-modal-orgname"></b> as a <b>Super Admin</b>.<br>
        You will see everything the organization sees, and <b>all your actions will be logged</b>.<br>
        Do you want to proceed?</p>
        <div class="superadmin-org-modal-actions">
          <button id="superadmin-org-modal-confirm" class="confirm">Yes, Proceed</button>
          <button id="superadmin-org-modal-cancel" class="cancel">Cancel</button>
        </div>
      </div>
    </div>
    <style>
      .superadmin-org-modal {
        display: none;
        position: fixed;
        z-index: 2000;
        left: 0; top: 0; width: 100vw; height: 100vh;
        background: rgba(30,41,59,0.25);
        align-items: center;
        justify-content: center;
      }
      .superadmin-org-modal[style*="display: flex"] {
        display: flex !important;
      }
      .superadmin-org-modal-content {
        background: #fff;
        border-radius: 16px;
        box-shadow: 0 4px 32px rgba(30,41,59,0.13);
        max-width: 95vw;
        width: 420px;
        padding: 2.2rem 1.5rem 1.5rem 1.5rem;
        text-align: center;
        display: flex;
        flex-direction: column;
        gap: 1.2rem;
      }
      .superadmin-org-modal-content h2 {
        color: #2563eb;
        font-size: 1.3rem;
        margin-bottom: 0.5rem;
      }
      .superadmin-org-modal-content p {
        color: #222;
        font-size: 1.08rem;
        margin-bottom: 0.7rem;
      }
      .superadmin-org-modal-actions {
        display: flex;
        gap: 1.2rem;
        justify-content: center;
        margin-top: 1.2rem;
      }
      .superadmin-org-modal-actions button {
        padding: 0.7rem 1.7rem;
        border-radius: 7px;
        border: none;
        font-size: 1rem;
        font-weight: 600;
        cursor: pointer;
        transition: background 0.18s;
      }
      .superadmin-org-modal-actions .confirm {
        background: linear-gradient(90deg, #2563eb 0%, #43cea2 100%);
        color: #fff;
      }
      .superadmin-org-modal-actions .confirm:hover {
        background: linear-gradient(90deg, #43cea2 0%, #2563eb 100%);
      }
      .superadmin-org-modal-actions .cancel {
        background: #e0e7ef;
        color: #222;
      }
      .superadmin-org-modal-actions .cancel:hover {
        background: #cbd5e1;
      }
    </style>
    <script>
      document.addEventListener('DOMContentLoaded', function() {
        const orgLinks = document.querySelectorAll('.superadmin-org-link');
        orgLinks.forEach(function(link) {
          link.addEventListener('click', function(e) {
            // Only intercept /admin/org/ links (not subdomain links)
            const orgUrl = link.getAttribute('href');
            if (!orgUrl.startsWith('/admin/org/')) return;
            e.preventDefault();
            const orgName = link.getAttribute('data-orgname') || 'this organization';
            const modal = document.getElementById('superadmin-org-modal');
            document.getElementById('superadmin-org-modal-orgname').textContent = orgName;
            document.getElementById('superadmin-org-modal-confirm').onclick = function() {
              window.location.href = orgUrl;
            };
            document.getElementById('superadmin-org-modal-cancel').onclick = function() {
              modal.style.display = 'none';
            };
            modal.style.display = 'flex';
          });
        });
        // Close modal on outside click
        document.addEventListener('click', function(e) {
          const modal = document.getElementById('superadmin-org-modal');
          if (modal && e.target === modal) {
            modal.style.display = 'none';
          }
        });
      });
    </script>
</html>
