<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Admin Dashboard</title>
  <link rel="stylesheet" href="/css/admin.css" />
  <style>
    :root {
      --font-family: "<%= (session && session.fontStyle ? String(session.fontStyle).trim() : 'Inter') %>", sans-serif;
      --primary: #01535b;
      --primary-hover: #014a51;
      --text-primary: #111827;
      --text-secondary: #6b7280;
      --border: #e5e7eb;
      --bg: #f9fafb;
      --success: #10b981;
      --warning: #f59e0b;
      --danger: #ef4444;
    }

    body {
      margin: 0;
      font-family: var(--font-family);
      background: var(--bg);
      color: var(--text-primary);
    }

    .dashboard-wrapper {
      padding: 40px 24px;
      min-height: 100vh;
    }

    .dashboard-header {
      max-width: 1400px;
      margin: 0 auto 32px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 16px;
      flex-wrap: wrap;
    }

    .dashboard-title h1 {
      margin: 0;
      font-size: 2rem;
      font-weight: 700;
      color: var(--text-primary);
    }

    .dashboard-title p {
      margin: 4px 0 0;
      color: var(--text-secondary);
      font-size: 0.95rem;
    }

    .dashboard-actions {
      display: flex;
      gap: 12px;
      align-items: center;
    }

    .btn-primary,
    .btn-secondary {
      border: 1px solid transparent;
      border-radius: 8px;
      padding: 10px 16px;
      font-size: 0.9rem;
      font-weight: 600;
      text-decoration: none;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      transition: all 0.15s;
      font-family: inherit;
    }

    .btn-primary {
      background: var(--primary);
      color: #fff;
    }

    .btn-primary:hover {
      background: var(--primary-hover);
    }

    .btn-secondary {
      background: #fff;
      color: var(--text-primary);
      border-color: var(--border);
    }

    .btn-secondary:hover {
      background: #f3f4f6;
    }

    .stats-grid {
      max-width: 1400px;
      margin: 0 auto 24px;
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
      gap: 16px;
    }

    .stat-card {
      background: #fff;
      border: 1px solid var(--border);
      border-radius: 12px;
      padding: 20px;
    }

    .stat-label {
      font-size: 0.78rem;
      color: var(--text-secondary);
      text-transform: uppercase;
      letter-spacing: 0.5px;
      margin-bottom: 8px;
      font-weight: 600;
    }

    .stat-value {
      font-size: 1.8rem;
      font-weight: 700;
      line-height: 1;
    }

    .orgs-container {
      max-width: 1400px;
      margin: 0 auto;
      background: #fff;
      border: 1px solid var(--border);
      border-radius: 12px;
      overflow: hidden;
    }

    .orgs-header {
      padding: 20px 24px;
      border-bottom: 1px solid var(--border);
      background: var(--bg);
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      flex-wrap: wrap;
    }

    .orgs-header h2 {
      margin: 0;
      font-size: 1.1rem;
      font-weight: 700;
    }

    .table-wrapper {
      overflow-x: auto;
    }

    .admin-table-clean {
      width: 100%;
      border-collapse: collapse;
      min-width: 880px;
    }

    .admin-table-clean th,
    .admin-table-clean td {
      padding: 14px 18px;
      text-align: left;
      border-bottom: 1px solid var(--border);
      vertical-align: middle;
    }

    .admin-table-clean th {
      font-size: 0.78rem;
      color: var(--text-secondary);
      text-transform: uppercase;
      letter-spacing: 0.5px;
      font-weight: 700;
      background: #fff;
    }

    .admin-table-clean tbody tr:hover {
      background: #fafbfc;
    }

    .org-link {
      color: var(--primary);
      text-decoration: none;
      font-weight: 700;
    }

    .org-link:hover {
      text-decoration: underline;
    }

    .owner-meta,
    .email-meta {
      color: var(--text-secondary);
      font-size: 0.85rem;
    }

    .badge {
      display: inline-block;
      padding: 4px 10px;
      border-radius: 999px;
      font-size: 0.75rem;
      font-weight: 700;
    }

    .badge-active {
      background: #ecfdf5;
      color: #065f46;
    }

    .badge-hold {
      background: #fef3c7;
      color: #92400e;
    }

    .table-actions {
      display: flex;
      gap: 8px;
      align-items: center;
      flex-wrap: wrap;
    }

    .btn-action {
      border: none;
      border-radius: 6px;
      padding: 6px 10px;
      font-size: 0.78rem;
      font-weight: 700;
      cursor: pointer;
      font-family: inherit;
      text-decoration: none;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      transition: all 0.15s;
    }

    .btn-view {
      background: #eff6ff;
      color: #1e40af;
    }

    .btn-view:hover {
      background: #dbeafe;
    }

    .btn-hold {
      background: #fef3c7;
      color: #92400e;
    }

    .btn-hold:hover {
      background: #fde68a;
    }

    .btn-resume {
      background: #ecfdf5;
      color: #065f46;
    }

    .btn-resume:hover {
      background: #d1fae5;
    }

    .btn-delete {
      background: #fef2f2;
      color: #991b1b;
    }

    .btn-delete:hover {
      background: #fecaca;
    }

    .details-row {
      display: none;
      background: #fcfcfd;
    }

    .details-panel {
      padding: 18px;
    }

    .details-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      gap: 10px 16px;
      margin-bottom: 14px;
      font-size: 0.88rem;
      color: var(--text-secondary);
    }

    .details-grid strong {
      color: var(--text-primary);
      margin-right: 6px;
    }

    .proofs-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
      gap: 14px;
      margin-bottom: 14px;
    }

    .proof-card {
      border: 1px solid var(--border);
      border-radius: 8px;
      padding: 10px;
      background: #fff;
    }

    .proof-card h4 {
      margin: 0 0 8px;
      font-size: 0.85rem;
      color: var(--text-primary);
    }

    .thumbnail {
      width: 100%;
      max-height: 210px;
      object-fit: cover;
      border-radius: 6px;
      border: 1px solid var(--border);
      cursor: pointer;
    }

    .proof-link {
      display: inline-block;
      font-size: 0.82rem;
      color: #1e40af;
      font-weight: 600;
      text-decoration: none;
      margin-top: 6px;
    }

    .proof-link:hover {
      text-decoration: underline;
    }

    .details-actions {
      display: flex;
      gap: 8px;
      align-items: center;
      flex-wrap: wrap;
    }

    .details-actions form {
      margin: 0;
    }

    .empty-state {
      padding: 40px 24px;
      text-align: center;
      color: var(--text-secondary);
    }

    /* === Internal Worker / Contacts widget === */
    .iw-announcement {
      max-width: 1400px;
      margin: 0 auto 24px;
      padding: 18px 22px;
      background: linear-gradient(135deg, rgba(1, 83, 91, 0.06), rgba(1, 83, 91, 0.02));
      border: 1px solid rgba(1, 83, 91, 0.18);
      border-left: 4px solid var(--primary);
      border-radius: 12px;
    }
    .iw-announcement__eyebrow {
      font-size: 0.72rem;
      font-weight: 700;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--primary);
      margin-bottom: 6px;
    }
    .iw-announcement__title {
      font-size: 1.1rem;
      font-weight: 700;
      color: var(--text-primary);
      margin-bottom: 4px;
    }
    .iw-announcement__body {
      color: var(--text-secondary);
      font-size: 0.92rem;
      line-height: 1.55;
      white-space: pre-line;
    }

    .iw-quicklinks {
      max-width: 1400px;
      margin: 0 auto 24px;
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      gap: 14px;
    }
    .iw-quicklink {
      display: flex;
      flex-direction: column;
      gap: 4px;
      padding: 16px 18px;
      background: #fff;
      border: 1px solid var(--border);
      border-radius: 12px;
      text-decoration: none;
      color: var(--text-primary);
      transition: transform 150ms ease, box-shadow 150ms ease, border-color 150ms ease;
    }
    .iw-quicklink:hover {
      transform: translateY(-2px);
      border-color: var(--primary);
      box-shadow: 0 12px 30px rgba(15, 23, 42, 0.08);
    }
    .iw-quicklink__icon { font-size: 1.4rem; }
    .iw-quicklink__label { font-weight: 700; font-size: 0.98rem; }
    .iw-quicklink__hint { font-size: 0.82rem; color: var(--text-secondary); }

    .iw-card {
      max-width: 1400px;
      margin: 0 auto 24px;
      background: #fff;
      border: 1px solid var(--border);
      border-radius: 12px;
      overflow: hidden;
    }
    .iw-card__header {
      padding: 16px 22px;
      border-bottom: 1px solid var(--border);
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      flex-wrap: wrap;
    }
    .iw-card__title { font-size: 1.05rem; font-weight: 700; margin: 0; }
    .iw-card__subtitle { font-size: 0.85rem; color: var(--text-secondary); margin: 2px 0 0; }
    .iw-card__body { padding: 18px 22px; }

    .iw-form {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      gap: 12px;
      align-items: start;
    }
    .iw-form label {
      display: flex;
      flex-direction: column;
      gap: 4px;
      font-size: 0.78rem;
      font-weight: 700;
      letter-spacing: 0.04em;
      text-transform: uppercase;
      color: var(--text-secondary);
    }
    .iw-form input,
    .iw-form select,
    .iw-form textarea {
      border: 1px solid var(--border);
      border-radius: 8px;
      padding: 9px 11px;
      font-size: 0.9rem;
      font-family: inherit;
      color: var(--text-primary);
      background: #fff;
    }
    .iw-form textarea { min-height: 84px; resize: vertical; }
    .iw-form .iw-form__full { grid-column: 1 / -1; }
    .iw-form__actions {
      grid-column: 1 / -1;
      display: flex;
      justify-content: flex-end;
      gap: 10px;
    }
    .iw-form__submit {
      background: var(--primary);
      color: #fff;
      border: 0;
      border-radius: 8px;
      padding: 10px 18px;
      font-weight: 700;
      font-size: 0.9rem;
      cursor: pointer;
    }
    .iw-form__submit:hover { background: var(--primary-hover); }

    .iw-contact-list {
      list-style: none;
      margin: 0;
      padding: 0;
      display: flex;
      flex-direction: column;
      gap: 10px;
    }
    .iw-contact {
      display: grid;
      grid-template-columns: 1fr auto;
      gap: 10px 16px;
      padding: 12px 14px;
      border: 1px solid var(--border);
      border-radius: 10px;
      background: #fafbfc;
      align-items: start;
    }
    .iw-contact--followed { background: #f0fdf4; border-color: #bbf7d0; }
    .iw-contact__name { font-weight: 700; }
    .iw-contact__meta {
      display: flex;
      flex-wrap: wrap;
      gap: 6px 14px;
      margin-top: 4px;
      font-size: 0.84rem;
      color: var(--text-secondary);
    }
    .iw-contact__notes {
      margin-top: 6px;
      font-size: 0.88rem;
      color: var(--text-primary);
      white-space: pre-wrap;
    }
    .iw-pill {
      display: inline-flex;
      align-items: center;
      padding: 2px 9px;
      border-radius: 999px;
      font-size: 0.72rem;
      font-weight: 700;
      letter-spacing: 0.04em;
      text-transform: uppercase;
    }
    .iw-pill--appt { background: #e0f2fe; color: #075985; }
    .iw-pill--noappt { background: #f1f5f9; color: #475569; }
    .iw-pill--followed { background: #dcfce7; color: #166534; }
    .iw-pill--pending { background: #fef3c7; color: #92400e; }
    .iw-contact__actions {
      display: flex;
      flex-direction: column;
      gap: 6px;
      align-items: stretch;
    }
    .iw-contact__actions form { margin: 0; }
    .iw-action-btn {
      border: 1px solid var(--border);
      background: #fff;
      color: var(--text-primary);
      border-radius: 8px;
      padding: 6px 12px;
      font-size: 0.82rem;
      font-weight: 600;
      cursor: pointer;
      white-space: nowrap;
    }
    .iw-action-btn:hover { background: #f3f4f6; }
    .iw-action-btn--primary {
      background: var(--primary);
      color: #fff;
      border-color: var(--primary);
    }
    .iw-action-btn--primary:hover { background: var(--primary-hover); }
    .iw-action-btn--danger { color: var(--danger); border-color: #fecaca; }
    .iw-action-btn--danger:hover { background: #fef2f2; }

    @media (max-width: 600px) {
      .iw-contact { grid-template-columns: 1fr; }
      .iw-contact__actions { flex-direction: row; flex-wrap: wrap; }
    }

    .modal {
      display: none;
      position: fixed;
      inset: 0;
      background: rgba(0, 0, 0, 0.8);
      z-index: 1000;
      align-items: center;
      justify-content: center;
    }

    .modal-content {
      max-width: 90vw;
      max-height: 88vh;
      border-radius: 8px;
    }

    .close {
      position: absolute;
      top: 18px;
      right: 28px;
      font-size: 2rem;
      color: #fff;
      cursor: pointer;
    }

    .superadmin-org-modal {
      display: none;
      position: fixed;
      z-index: 2000;
      left: 0;
      top: 0;
      width: 100vw;
      height: 100vh;
      background: rgba(30, 41, 59, 0.25);
      align-items: center;
      justify-content: center;
    }

    .superadmin-org-modal-content {
      background: #fff;
      border-radius: 14px;
      box-shadow: 0 4px 24px rgba(30, 41, 59, 0.12);
      max-width: 95vw;
      width: 420px;
      padding: 1.8rem 1.3rem;
      text-align: center;
    }

    .superadmin-org-modal-content h2 {
      margin: 0 0 0.6rem;
      font-size: 1.2rem;
      color: #2563eb;
    }

    .superadmin-org-modal-content p {
      margin: 0;
      font-size: 0.96rem;
      color: #1f2937;
      line-height: 1.45;
    }

    .superadmin-org-modal-actions {
      margin-top: 1rem;
      display: flex;
      justify-content: center;
      gap: 10px;
    }

    .superadmin-org-modal-actions button {
      border: none;
      border-radius: 6px;
      padding: 8px 14px;
      font-size: 0.9rem;
      font-weight: 700;
      cursor: pointer;
      font-family: inherit;
    }

    .superadmin-org-modal-actions .confirm {
      background: #2563eb;
      color: #fff;
    }

    .superadmin-org-modal-actions .cancel {
      background: #e5e7eb;
      color: #111827;
    }

    @media (max-width: 768px) {
      .dashboard-wrapper {
        padding: 24px 14px;
      }

      .dashboard-header {
        flex-direction: column;
        align-items: flex-start;
      }

      .dashboard-title h1 {
        font-size: 1.5rem;
      }

      .admin-table-clean {
        min-width: 760px;
      }
    }
  </style>
</head>
<body>
  <div class="dashboard-wrapper">
    <% const _isInternal = (typeof isInternalWorker !== 'undefined') && isInternalWorker; %>
    <% const _isFullAdmin = (typeof isFullAdmin !== 'undefined') && isFullAdmin; %>
    <% const _contacts = (typeof contacts !== 'undefined' && Array.isArray(contacts)) ? contacts : []; %>
    <% const _latestAnnouncement = (typeof latestAnnouncement !== 'undefined') ? latestAnnouncement : null; %>
    <% const _displayName = (session && (session.firstName || session.lastName)) ? `${session.firstName || ''} ${session.lastName || ''}`.trim() : ''; %>

    <div class="dashboard-header">
      <div class="dashboard-title">
        <% if (_isInternal) { %>
          <h1>👋 Welcome<%= _displayName ? ', ' + _displayName : '' %></h1>
          <p>Your hub for announcements, referrals, and quick links.</p>
        <% } else { %>
          <h1>📋 Single Organization Management</h1>
          <p>Simple overview and control of all organizations</p>
        <% } %>
      </div>
      <% if (!_isInternal) { %>
        <div class="dashboard-actions">
          <a href="/admin/hubs" class="btn-primary">🏢 Manage Hubs</a>
        </div>
      <% } %>
    </div>

    <%- include('../partials/flash') %>

    <% if (_latestAnnouncement) { %>
      <div class="iw-announcement">
        <div class="iw-announcement__eyebrow">📣 Announcement</div>
        <div class="iw-announcement__title"><%= _latestAnnouncement.title %></div>
        <div class="iw-announcement__body"><%= _latestAnnouncement.description %></div>
      </div>
    <% } else if (_isInternal) { %>
      <div class="iw-announcement">
        <div class="iw-announcement__eyebrow">📣 Announcement</div>
        <div class="iw-announcement__title">No announcements right now</div>
        <div class="iw-announcement__body">Check back later for the latest updates from the Managira team.</div>
      </div>
    <% } %>

    <% if (!_isInternal) { %>
    <div class="stats-grid">
      <div class="stat-card">
        <div class="stat-label">Total Organizations</div>
        <div class="stat-value"><%= applications ? applications.length : 0 %></div>
      </div>
      <div class="stat-card">
        <div class="stat-label">Active</div>
        <div class="stat-value"><%= applications ? applications.filter(app => !app.on_hold).length : 0 %></div>
      </div>
      <div class="stat-card">
        <div class="stat-label">On Hold</div>
        <div class="stat-value"><%= applications ? applications.filter(app => app.on_hold).length : 0 %></div>
      </div>
    </div>
    <% } %>

    <% if (_isInternal) { %>
      <div class="iw-quicklinks">
        <a class="iw-quicklink" href="https://forms.gle/uc9qatwCgWf1jMnv6" target="_blank" rel="noopener">
          <span class="iw-quicklink__icon">📝</span>
          <span class="iw-quicklink__label">Weekly Internal Report</span>
          <span class="iw-quicklink__hint">Submit your weekly update</span>
        </a>
        <a class="iw-quicklink" href="https://calendly.com/managirasms/30min" target="_blank" rel="noopener">
          <span class="iw-quicklink__icon">📅</span>
          <span class="iw-quicklink__label">Calendar</span>
          <span class="iw-quicklink__hint">Book a 30-minute meeting</span>
        </a>
        <a class="iw-quicklink" href="/legal/app-demo" target="_blank" rel="noopener">
          <span class="iw-quicklink__icon">▶️</span>
          <span class="iw-quicklink__label">App Demo (Preview)</span>
          <span class="iw-quicklink__hint">Walk through the platform</span>
        </a>
      </div>
    <% } %>

    <%- include('partials/_contactsWidget', {
      isInternal: _isInternal,
      isFullAdmin: _isFullAdmin,
      contacts: _contacts,
      sessionUserId: (session && session.userId) ? session.userId : null
    }) %>

    <% if (!_isInternal) { %>

    <div class="orgs-container">
      <div class="orgs-header">
        <h2>Organizations</h2>
      </div>

      <% if (applications && applications.length > 0) { %>
      <div class="table-wrapper">
        <table class="admin-table-clean">
          <thead>
            <tr>
              <th>Organization</th>
              <th>Owner</th>
              <th>Email</th>
              <th>Status</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody>
            <% applications.forEach(function(application) { %>
            <% const orgDashboardUrl = `/admin/org/${application.organization_id}`; %>
            <tr>
              <td>
                <a
                  href="<%= orgDashboardUrl %>"
                  class="org-link superadmin-org-link"
                  data-orgname="<%= application.organization_name %>"
                  data-orgurl="<%= orgDashboardUrl %>"
                >
                  <%= application.organization_name && application.organization_name.trim() !== '' ? application.organization_name : '(No Name)' %>
                </a>
              </td>
              <td class="owner-meta"><%= application.first_name %> <%= application.last_name %></td>
              <td class="email-meta"><%= application.email %></td>
              <td>
                <% if (application.on_hold) { %>
                  <span class="badge badge-hold">On Hold<%= application.hold_by ? ` • ${application.hold_by}` : '' %></span>
                <% } else { %>
                  <span class="badge badge-active">Active</span>
                <% } %>
              </td>
              <td>
                <div class="table-actions">
                  <button class="btn-action btn-view" onclick="toggleDetails('<%= application.organization_id %>')">Details</button>
                </div>
              </td>
            </tr>

            <tr id="details-<%= application.organization_id %>" class="details-row">
              <td colspan="5">
                <div class="details-panel">
                  <div class="details-grid">
                    <div><strong>First Name:</strong> <%= application.first_name %></div>
                    <div><strong>Last Name:</strong> <%= application.last_name %></div>
                    <div><strong>Email:</strong> <%= application.email %></div>
                    <div><strong>Phone:</strong> <%= application.organization_phone %></div>
                    <div><strong>Address:</strong> <%= application.organization_address %><% if (application.organization_country || application.organization_province) { %>, <%= [application.organization_province, application.organization_country].filter(Boolean).join(', ') %><% } %></div>
                  </div>

                  <div class="proofs-grid">
                    <div class="proof-card">
                      <h4>Proof of Existence 1</h4>
                      <% if (application.proof_of_existence_1 && application.proof_of_existence_1.toLowerCase().endsWith('.pdf')) { %>
                        <a href="<%= application.proof_of_existence_1 %>" target="_blank" class="proof-link">Open PDF in new tab</a>
                      <% } else if (application.proof_of_existence_1) { %>
                        <img
                          src="<%= application.proof_of_existence_1 %>"
                          alt="Proof 1"
                          class="thumbnail"
                          onclick="openModal('<%= application.proof_of_existence_1 %>')"
                        />
                      <% } else { %>
                        <span class="owner-meta">No document uploaded.</span>
                      <% } %>
                    </div>

                    <div class="proof-card">
                      <h4>Proof of Existence 2</h4>
                      <% if (application.proof_of_existence_2 && application.proof_of_existence_2.toLowerCase().endsWith('.pdf')) { %>
                        <a href="<%= application.proof_of_existence_2 %>" target="_blank" class="proof-link">Open PDF in new tab</a>
                      <% } else if (application.proof_of_existence_2) { %>
                        <img
                          src="<%= application.proof_of_existence_2 %>"
                          alt="Proof 2"
                          class="thumbnail"
                          onclick="openModal('<%= application.proof_of_existence_2 %>')"
                        />
                      <% } else { %>
                        <span class="owner-meta">No document uploaded.</span>
                      <% } %>
                    </div>
                  </div>

                  <div class="details-actions">
                    <% if (application.on_hold) { %>
                    <form action="/admin/resume" method="post" onsubmit="return confirmAction('resume', '<%= application.organization_name %>');">
                      <input type="hidden" name="orgId" value="<%= application.organization_id %>" />
                      <button type="submit" class="btn-action btn-resume">▶ Resume</button>
                    </form>
                    <% } else { %>
                    <form action="/admin/hold" method="post" onsubmit="return confirmAction('put on hold', '<%= application.organization_name %>');">
                      <input type="hidden" name="orgId" value="<%= application.organization_id %>" />
                      <button type="submit" class="btn-action btn-hold">⏸ Put on Hold</button>
                    </form>
                    <% } %>

                    <form action="/admin/delete" method="post" onsubmit="return confirmAction('delete', '<%= application.organization_name %>');">
                      <input type="hidden" name="orgId" value="<%= application.organization_id %>" />
                      <button type="submit" class="btn-action btn-delete">🗑 Delete</button>
                    </form>
                  </div>
                </div>
              </td>
            </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
      <% } else { %>
      <div class="empty-state">No organizations found.</div>
      <% } %>
    </div>
    <% } %>
  </div>

  <div id="imageModal" class="modal" onclick="closeModal()">
    <span class="close" onclick="closeModal()">&times;</span>
    <img class="modal-content" id="modalImage" alt="Preview" />
  </div>

  <div id="superadmin-org-modal" class="superadmin-org-modal">
    <div class="superadmin-org-modal-content">
      <h2>Super Admin Org Access</h2>
      <p>
        You are about to enter <b id="superadmin-org-modal-orgname"></b> as a <b>Super Admin</b>.<br />
        You will see everything the organization sees, and <b>all your actions will be logged</b>.<br />
        Do you want to proceed?
      </p>
      <div class="superadmin-org-modal-actions">
        <button id="superadmin-org-modal-confirm" class="confirm">Yes, Proceed</button>
        <button id="superadmin-org-modal-cancel" class="cancel">Cancel</button>
      </div>
    </div>
  </div>

  <script>
    function toggleDetails(id) {
      const details = document.getElementById(`details-${id}`);
      if (!details) return;
      details.style.display = details.style.display === 'table-row' ? 'none' : 'table-row';
    }

    function openModal(imageUrl) {
      const modal = document.getElementById('imageModal');
      const image = document.getElementById('modalImage');
      if (!modal || !image) return;
      image.src = imageUrl;
      modal.style.display = 'flex';
    }

    function closeModal() {
      const modal = document.getElementById('imageModal');
      if (!modal) return;
      modal.style.display = 'none';
    }

    function confirmAction(action, organizationName) {
      return confirm(`Are you sure you want to ${action} the organization "${organizationName}"?`);
    }

    document.addEventListener('DOMContentLoaded', function () {
      const orgLinks = document.querySelectorAll('.superadmin-org-link');
      const modal = document.getElementById('superadmin-org-modal');
      const orgNameNode = document.getElementById('superadmin-org-modal-orgname');
      const confirmBtn = document.getElementById('superadmin-org-modal-confirm');
      const cancelBtn = document.getElementById('superadmin-org-modal-cancel');

      orgLinks.forEach(function (link) {
        link.addEventListener('click', function (e) {
          const orgUrl = link.getAttribute('href');
          if (!orgUrl || !orgUrl.startsWith('/admin/org/')) return;
          e.preventDefault();
          const orgName = link.getAttribute('data-orgname') || 'this organization';
          orgNameNode.textContent = orgName;
          confirmBtn.onclick = function () {
            window.location.href = orgUrl;
          };
          cancelBtn.onclick = function () {
            modal.style.display = 'none';
          };
          modal.style.display = 'flex';
        });
      });

      document.addEventListener('click', function (e) {
        if (e.target === modal) {
          modal.style.display = 'none';
        }
      });
    });
  </script>
</body>
</html>