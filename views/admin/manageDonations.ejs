<h1>Donation Management</h1>

<form method="POST" action="/admin/donations" enctype="multipart/form-data" class="donation-form">
  <input type="text" name="title" placeholder="Title" required />
  <textarea name="description" placeholder="Description" required></textarea>
  <input type="url" name="external_link" placeholder="External Donation Link" required />
  <input type="file" name="image" accept="image/*" required />
  <button type="submit">Add Donation</button>
</form>

<hr />

<div class="donation-wrapper">
  <% if (donations.length === 0) { %>
    <p>No donations yet.</p>
  <% } else { %>
    <% donations.forEach(d => { %>
      <div class="donation-card">
        <% if (d.image_url) { %>
          <img src="<%= d.image_url %>" alt="Donation image" class="donation-image" />
        <% } %>
        <h3><%= d.title %></h3>
        <p><%= d.description %></p>
        <a href="<%= d.external_link %>" class="donation-link" target="_blank">Donation Link</a>
        <form action="/admin/donations/delete/<%= d.id %>?imageKey=<%= d.s3_key %>" method="POST">
          <button type="submit" class="delete-btn" onclick="return confirm('Delete this donation and its image?')">Delete</button>
        </form>
      </div>
    <% }) %>
  <% } %>
</div>

<style>
  h1 {
    text-align: center;
    color: #2c3e50;
    font-size: 2rem;
    margin: 40px auto 20px auto;
  }

  .donation-form {
    max-width: 600px;
    margin: 0 auto 50px auto;
    padding: 20px;
    background-color: #fefefe;
    border-left: 4px solid #16a085;
    border-radius: 6px;
    box-shadow: 0 2px 8px rgba(0,0,0,0.06);
  }

  .donation-form input,
  .donation-form textarea {
    width: 100%;
    margin-bottom: 12px;
    padding: 10px;
    font-size: 1rem;
    border-radius: 4px;
    border: 1px solid #ccc;
  }

  .donation-form button {
    background-color: #16a085;
    color: white;
    padding: 10px 18px;
    font-size: 1rem;
    border: none;
    border-radius: 4px;
    cursor: pointer;
    width: 100%;
  }

  .donation-form button:hover {
    background-color: #138d75;
  }

  .donation-wrapper {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 30px;
    padding: 0 20px 60px 20px;
  }

  .donation-card {
    background: #ffffff;
    border-left: 4px solid #27ae60;
    width: 300px;
    padding: 20px;
    border-radius: 8px;
    box-shadow: 0 3px 10px rgba(0,0,0,0.07);
    text-align: center;
  }

  .donation-card img.donation-image {
    width: 100%;
    height: 180px;
    object-fit: cover;
    border-radius: 4px;
    margin-bottom: 15px;
  }

  .donation-card h3 {
    font-size: 1.2rem;
    margin: 10px 0 8px 0;
    color: #2c3e50;
  }

  .donation-card p {
    font-size: 0.95rem;
    color: #555;
    margin-bottom: 10px;
  }

  .donation-link {
    display: inline-block;
    margin: 10px 0;
    font-size: 0.95rem;
    color: #2980b9;
    text-decoration: none;
  }

  .donation-link:hover {
    text-decoration: underline;
  }

  .delete-btn {
    background-color: #e74c3c;
    color: white;
    padding: 8px 14px;
    border: none;
    border-radius: 4px;
    font-size: 0.9rem;
    cursor: pointer;
  }

  .delete-btn:hover {
    background-color: #c0392b;
  }

  @media screen and (max-width: 700px) {
    .donation-card {
      width: 100%;
      max-width: 90vw;
    }
  }
</style>
