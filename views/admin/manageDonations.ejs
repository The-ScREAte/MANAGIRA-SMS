<link rel="stylesheet" href="/css/admin.css" />

<style>
  .donations-container {
    max-width: 1000px;
    margin: 0 auto;
  }

  .page-header {
    text-align: center;
    margin-bottom: 32px;
  }

  .page-header h1 {
    color: var(--admin-text-primary, #111827);
    font-size: 1.75rem;
    font-weight: 700;
    margin: 0;
  }

  .donation-form {
    max-width: 600px;
    margin: 0 auto 40px;
    padding: 24px;
    background-color: #fff;
    border-radius: 12px;
    border: 1px solid #e5e7eb;
    box-shadow: 0 2px 12px rgba(0, 0, 0, 0.06);
  }

  .donation-form input,
  .donation-form textarea {
    width: 100%;
    margin-bottom: 16px;
    padding: 12px;
    font-size: 0.9rem;
    border-radius: 8px;
    border: 1px solid #d1d5db;
    font-family: inherit;
    box-sizing: border-box;
  }

  .donation-form input:focus,
  .donation-form textarea:focus {
    outline: none;
    border-color: var(--admin-success, #059669);
    box-shadow: 0 0 0 3px rgba(5, 150, 105, 0.1);
  }

  .donation-form textarea {
    min-height: 100px;
    resize: vertical;
  }

  .donation-wrapper {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 24px;
    padding: 0 0 40px;
  }

  .donation-card {
    background: #ffffff;
    border: 1px solid #e5e7eb;
    border-radius: 12px;
    padding: 20px;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);
    transition: all 0.2s ease;
    display: flex;
    flex-direction: column;
  }

  .donation-card:hover {
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.1);
    border-color: var(--admin-success, #059669);
  }

  .donation-card img.donation-image {
    width: 100%;
    height: 180px;
    object-fit: cover;
    border-radius: 8px;
    margin-bottom: 16px;
  }

  .donation-card h3 {
    font-size: 1.15rem;
    margin: 0 0 8px;
    color: var(--admin-text-primary, #111827);
    font-weight: 600;
  }

  .donation-card p {
    font-size: 0.9rem;
    color: var(--admin-text-secondary, #4b5563);
    margin: 0 0 16px;
    line-height: 1.5;
    flex: 1;
  }

  .donation-link {
    display: inline-block;
    margin-bottom: 16px;
    font-size: 0.9rem;
    color: var(--admin-primary, #2563eb);
    text-decoration: none;
    font-weight: 500;
  }

  .donation-link:hover {
    text-decoration: underline;
  }

  .donation-card form {
    margin: 0;
  }

  .empty-state {
    grid-column: 1 / -1;
    text-align: center;
    color: var(--admin-text-secondary, #4b5563);
    padding: 40px 20px;
    background: #f9fafb;
    border-radius: 10px;
  }

  @media (max-width: 768px) {
    .donation-wrapper {
      grid-template-columns: 1fr;
    }

    .donation-form {
      margin: 0 10px 32px;
      padding: 20px;
    }
  }

  @media (max-width: 480px) {
    .page-header h1 {
      font-size: 1.4rem;
    }

    .donation-card {
      padding: 16px;
    }
  }
</style>

<div class="donations-container">
  <div class="page-header">
    <h1>💝 Donation Management</h1>
  </div>

  <%- include('../partials/flash') %>

  <form method="POST" action="/admin/donations" enctype="multipart/form-data" class="donation-form">
    <input type="text" name="title" placeholder="Campaign Title" required />
    <textarea name="description" placeholder="Campaign Description" required></textarea>
    <input type="url" name="external_link" placeholder="External Donation Link (e.g., GoFundMe)" required />
    <input type="file" name="image" accept="image/*" required />
    <button type="submit" class="admin-btn admin-btn-success admin-btn-lg" style="width: 100%;">
      + Add Donation Campaign
    </button>
  </form>

  <div class="donation-wrapper">
    <% if (donations.length === 0) { %>
      <div class="empty-state">
        <p>No donation campaigns yet. Create one above!</p>
      </div>
    <% } else { %>
      <% donations.forEach(d => { %>
        <div class="donation-card">
          <% if (d.image_url) { %>
            <img src="<%= d.image_url %>" alt="<%= d.title %>" class="donation-image" />
          <% } %>
          <h3><%= d.title %></h3>
          <p><%= d.description %></p>
          <a href="<%= d.external_link %>" class="donation-link" target="_blank">🔗 View Donation Link</a>
          <form action="/admin/donations/delete/<%= d.id %>?imageKey=<%= d.s3_key %>" method="POST">
            <button type="submit" class="admin-btn admin-btn-delete admin-btn-sm" onclick="return confirm('Delete this donation campaign and its image?')" style="width: 100%;">
              🗑 Delete Campaign
            </button>
          </form>
        </div>
      <% }) %>
    <% } %>
  </div>
</div>
