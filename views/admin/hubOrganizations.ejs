<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Hub Organizations - Admin</title>
  <link rel="stylesheet" href="/css/admin.css">
  <style>
    .orgs-container {
      max-width: 1400px;
      margin: 40px auto;
      padding: 24px;
      background: white;
      border-radius: 12px;
      box-shadow: 0 4px 16px rgba(0, 0, 0, 0.08);
    }

    .hub-info {
      background: linear-gradient(135deg, #01535b 0%, #6fd3c4 100%);
      color: white;
      padding: 24px;
      border-radius: 12px;
      margin-bottom: 24px;
    }

    .hub-info h1 {
      margin: 0 0 8px 0;
      font-size: 1.75rem;
    }

    .hub-info p {
      margin: 0;
      opacity: 0.9;
    }

    .orgs-table {
      width: 100%;
      border-collapse: collapse;
      margin-top: 24px;
    }

    .orgs-table th,
    .orgs-table td {
      padding: 16px;
      text-align: left;
      border-bottom: 1px solid #e5e7eb;
    }

    .orgs-table th {
      background: #f9fafb;
      font-weight: 600;
      color: #374151;
      text-transform: uppercase;
      font-size: 0.85rem;
    }

    .orgs-table tr:hover {
      background: #f9fafb;
    }

    .badge {
      display: inline-block;
      padding: 4px 12px;
      border-radius: 20px;
      font-size: 0.8rem;
      font-weight: 600;
      background: #dcfce7;
      color: #166534;
    }

    .no-orgs {
      text-align: center;
      padding: 48px;
      color: #6b7280;
    }

    .back-link {
      display: inline-block;
      margin-top: 24px;
      color: #01535b;
      text-decoration: none;
      font-weight: 600;
    }

    .back-link:hover {
      text-decoration: underline;
    }
  </style>
</head>
<body>
  <%- include('../partials/flash') %>

  <div class="orgs-container">
    <div class="hub-info">
      <h1><%= hub.hub_name %></h1>
      <p>
        <%= hub.hub_nickname %>.managira.com • 
        <%= organizations.length %> of <%= hub.max_organizations %> organizations
      </p>
    </div>

    <% if (organizations.length > 0) { %>
      <table class="orgs-table">
        <thead>
          <tr>
            <th>Organization</th>
            <th>Contact</th>
            <th>Email</th>
            <th>Students</th>
            <th>Staff</th>
            <th>Classes</th>
            <th>Joined</th>
          </tr>
        </thead>
        <tbody>
          <% organizations.forEach(org => { %>
            <tr>
              <td>
                <strong><%= org.organization_name %></strong><br>
                <small style="color: #6b7280;"><%= org.nickname %>.managira.com</small>
              </td>
              <td><%= org.first_name %> <%= org.last_name %></td>
              <td><%= org.email %></td>
              <td><span class="badge"><%= org.student_count %></span></td>
              <td><span class="badge"><%= org.teacher_count %></span></td>
              <td><span class="badge"><%= org.class_count %></span></td>
              <td><%= new Date(org.created_at).toLocaleDateString() %></td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    <% } else { %>
      <div class="no-orgs">
        <p>No organizations under this hub yet.</p>
      </div>
    <% } %>

    <div style="text-align: center;">
      <a href="/admin/hubs" class="back-link">← Back to Hubs</a>
    </div>
  </div>
</body>
</html>
