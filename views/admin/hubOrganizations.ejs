<%
  const _orgs = Array.isArray(organizations) ? organizations : [];
  const _max = Number(hub.max_organizations) || 0;
  const _sum = (key) => _orgs.reduce((s, o) => s + (Number(o[key]) || 0), 0);
  const _num = (n) => Number(n || 0).toLocaleString('en-US');
  const _date = (d) => d ? new Date(d).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) : '—';
  const _owner = [hub.first_name, hub.last_name].filter(Boolean).join(' ');
  const _return = encodeURIComponent(`/admin/hubs/${hub.hub_id}/organizations`);
%>
<link rel="stylesheet" href="<%= assetUrl('/css/adminHubs.css') %>" />

<div class="ah">
  <%- include('../partials/flash') %>

  <nav class="ah-crumbs" aria-label="Breadcrumb">
    <a href="/admin">Admin</a><i class="fa-solid fa-chevron-right" aria-hidden="true" style="font-size:.6rem"></i>
    <a href="/admin/hubs">Hubs</a><i class="fa-solid fa-chevron-right" aria-hidden="true" style="font-size:.6rem"></i>
    <span><%= hub.hub_name %></span>
  </nav>

  <header class="ah-head">
    <div>
      <h1 class="ah-head__title">
        <%= hub.hub_name %>
        <% if (hub.deleted) { %><span class="ah-status ah-status--muted">Deleted</span><% } else if (hub.on_hold) { %><span class="ah-status ah-status--hold">On hold</span><% } else { %><span class="ah-status">Active</span><% } %>
      </h1>
      <p class="ah-head__sub"><%= hub.hub_nickname %>.managira.com<% if (_owner) { %> · <%= _owner %><% } %> · <%= hub.hub_email %></p>
    </div>
    <div class="ah-head__actions">
      <a href="/admin/hubs" class="ah-btn"><i class="fa-solid fa-arrow-left" aria-hidden="true"></i> All hubs</a>
      <a href="/admin/hubs/<%= hub.hub_id %>/edit" class="ah-btn"><i class="fa-solid fa-pen" aria-hidden="true"></i> Edit hub</a>
      <% if (!hub.on_hold && !hub.deleted) { %>
        <a href="/admin/hub/<%= hub.hub_id %>" class="ah-btn ah-btn--primary" data-ah-open data-kind="hub" data-name="<%= hub.hub_name %>"><i class="fa-solid fa-arrow-right-to-bracket" aria-hidden="true"></i> Open hub</a>
      <% } %>
    </div>
  </header>

  <div class="ah-kpis">
    <div class="ah-kpi ah-kpi--teal"><span class="ah-kpi__icon"><i class="fa-solid fa-school" aria-hidden="true"></i></span><div><div class="ah-kpi__label">Schools</div><div class="ah-kpi__value"><%= _orgs.length %><span style="font-size:.95rem;color:#64748b;font-weight:600"> / <%= _max || '∞' %></span></div></div></div>
    <div class="ah-kpi ah-kpi--blue"><span class="ah-kpi__icon"><i class="fa-solid fa-user-graduate" aria-hidden="true"></i></span><div><div class="ah-kpi__label">Active students</div><div class="ah-kpi__value"><%= _num(_sum('student_count')) %></div></div></div>
    <div class="ah-kpi ah-kpi--amber"><span class="ah-kpi__icon"><i class="fa-solid fa-user-tie" aria-hidden="true"></i></span><div><div class="ah-kpi__label">Staff</div><div class="ah-kpi__value"><%= _num(_sum('teacher_count')) %></div></div></div>
    <div class="ah-kpi ah-kpi--violet"><span class="ah-kpi__icon"><i class="fa-solid fa-chalkboard" aria-hidden="true"></i></span><div><div class="ah-kpi__label">Classes</div><div class="ah-kpi__value"><%= _num(_sum('class_count')) %></div></div></div>
  </div>

  <section class="ah-card" aria-label="Schools in this hub">
    <div class="ah-card__bar">
      <h2 class="ah-card__title">Schools in this hub</h2>
      <% if (_orgs.length > 1) { %>
        <label class="ah-search"><i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i><input type="search" placeholder="Search schools…" aria-label="Search schools" data-ah-filter /></label>
      <% } %>
    </div>

    <% if (_orgs.length) { %>
      <div class="ah-scroll">
        <table class="ah-table">
          <thead>
            <tr>
              <th>School</th>
              <th>Contact</th>
              <th class="ah-num">Students</th>
              <th class="ah-num">Staff</th>
              <th class="ah-num">Classes</th>
              <th>Joined hub</th>
              <th>Status</th>
              <th class="ah-num">Actions</th>
            </tr>
          </thead>
          <tbody>
            <% _orgs.forEach((org) => {
                 const contact = [org.first_name, org.last_name].filter(Boolean).join(' ');
                 const openUrl = `/admin/org/${org.organization_id}?return=${_return}`; %>
              <tr data-ah-row="<%= [org.organization_name, org.nickname, contact, org.email].join(' ').toLowerCase() %>">
                <td>
                  <div class="ah-name">
                    <span class="ah-avatar"><%= (org.organization_name || 'S').charAt(0).toUpperCase() %></span>
                    <div style="min-width:0">
                      <a class="ah-name__link" href="<%= openUrl %>" data-ah-open data-kind="school" data-name="<%= org.organization_name %>"><%= org.organization_name || '(No name)' %></a>
                      <% if (org.nickname) { %><span class="ah-sub"><%= org.nickname %>.<%= hub.hub_nickname %>.managira.com</span><% } %>
                    </div>
                  </div>
                </td>
                <td>
                  <%= contact || '—' %>
                  <span class="ah-sub"><%= org.email %></span>
                </td>
                <td class="ah-num"><%= _num(org.student_count) %></td>
                <td class="ah-num"><%= _num(org.teacher_count) %></td>
                <td class="ah-num"><%= _num(org.class_count) %></td>
                <td><%= _date(org.joined_hub_at || org.created_at) %></td>
                <td><% if (org.on_hold) { %><span class="ah-status ah-status--hold">On hold</span><% } else { %><span class="ah-status">Active</span><% } %></td>
                <td class="ah-actions-cell">
                  <a class="ah-btn ah-btn--soft ah-btn--sm" href="<%= openUrl %>" data-ah-open data-kind="school" data-name="<%= org.organization_name %>"><i class="fa-solid fa-arrow-right-to-bracket" aria-hidden="true"></i> Open school</a>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
      <div class="ah-empty" data-ah-noresults hidden><i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i>No schools match your search.</div>
    <% } else { %>
      <div class="ah-empty">
        <i class="fa-solid fa-school" aria-hidden="true"></i>
        <h3>No schools yet</h3>
        <p>When a school accepts this hub's invitation, it shows here.</p>
      </div>
    <% } %>
  </section>

  <%- include('partials/hubAdminDialogs') %>
</div>
