<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Service Pricing Management</title>
    <style>
      :root {
        --font-family: "<%= (session && session.fontStyle ? String(session.fontStyle).trim() : 'Inter') %>", sans-serif;
      }

      body {
        font-family: var(--font-family);
        background-color: #f4f7fa;
        color: #222;
        margin: 0;
        line-height: 1.6;
      }
      
      .admin-header {
        background: linear-gradient(90deg, #01535b 60%, #0e7c86 100%);
        color: #fff;
        padding: 24px 0 16px 0;
        text-align: center;
        margin-bottom: 0;
        box-shadow: 0 2px 8px rgba(1,83,91,0.08);
      }
      
      .admin-header h1 {
        margin: 0;
        font-size: 2.2rem;
        letter-spacing: 1px;
        font-weight: 700;
      }
      
      .container {
        max-width: none;
        width: calc(100% - 48px);
        margin: 40px auto;
        padding: 0 24px;
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 24px;
        align-items: stretch;
      }
      
      .column-1,
      .column-2,
      .column-3,
      .column-4,
      .secondary-sections-grid {
        display: contents;
      }

      .gateway-strategy-card {
        border: 1px solid #b8d7dd;
        background: linear-gradient(135deg, #ffffff 0%, #f4fbfc 100%);
      }

      .gateway-strategy-note {
        margin: 10px 0 16px;
        color: #475569;
        font-size: 14px;
      }

      .collapsed-card-copy {
        margin: 8px 0 0;
        color: #64748b;
        font-size: 13px;
        line-height: 1.5;
        max-width: 34ch;
      }

      .stripe-test-card-note {
        margin-top: 16px;
        padding: 14px;
        border-radius: 12px;
        background: #f8fafc;
        border: 1px solid #dbe3ea;
        color: #475569;
        font-size: 13px;
        line-height: 1.65;
      }

      .stripe-test-card-note strong {
        color: #0f172a;
      }

      .stripe-platform-status {
        margin-top: 16px;
        padding: 14px;
        border-radius: 12px;
        font-size: 13px;
        line-height: 1.65;
      }

      .stripe-platform-status strong {
        color: #0f172a;
      }

      .stripe-platform-status.is-ready {
        background: #ecfdf3;
        border: 1px solid #a7f3d0;
        color: #166534;
      }

      .stripe-platform-status.is-warning {
        background: #fff7ed;
        border: 1px solid #fed7aa;
        color: #9a3412;
      }
      
      .form-container {
        background: #fff;
        padding: 32px 24px;
        border-radius: 12px;
        box-shadow: 0 4px 20px rgba(1,83,91,0.08);
        transition: all 0.3s ease;
        border: 1px solid #e8f4f8;
        height: fit-content;
      }
      
      .form-container:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 32px rgba(1,83,91,0.12);
      }
      
      .form-container h2 {
        color: #01535b;
        font-size: 1.4rem;
        font-weight: 600;
        margin: 0 0 20px 0;
        padding-bottom: 10px;
        border-bottom: 2px solid #e8f4f8;
      }
      
      .plan-container {
        background: #fff;
        padding: 24px;
        margin-bottom: 20px;
        border-radius: 10px;
        box-shadow: 0 2px 12px rgba(1,83,91,0.06);
        border: 1px solid #e8f4f8;
        transition: all 0.2s ease;
      }
      
      .plan-container:hover {
        box-shadow: 0 4px 20px rgba(1,83,91,0.1);
      }
      
      /* Grid layout for better organization */
      .pricing-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
        gap: 24px;
        margin-bottom: 40px;
      }
      
      .settings-section {
        grid-column: 1 / -1;
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
        gap: 20px;
      }
      
      .plans-section {
        grid-column: 1 / -1;
        background: #fff;
        padding: 32px 24px;
        border-radius: 12px;
        box-shadow: 0 4px 20px rgba(1,83,91,0.08);
        border: 1px solid #e8f4f8;
      }
      
      .plans-section h2 {
        color: #01535b;
        font-size: 1.5rem;
        font-weight: 600;
        margin: 0 0 24px 0;
        padding-bottom: 12px;
        border-bottom: 2px solid #e8f4f8;
      }
      
      .plans-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
        gap: 20px;
      }
      .manage-plans-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
        gap: 18px;
        align-items: start;
      }
      .manage-plan-card {
        background: linear-gradient(180deg, #ffffff 0%, #f8fbfc 100%);
        border: 1px solid #dbe9ec;
        border-radius: 16px;
        box-shadow: 0 8px 22px rgba(1, 83, 91, 0.06);
        overflow: hidden;
      }
      .manage-plan-card.is-collapsed .manage-plan-body {
        display: none;
      }
      .manage-plan-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        padding: 18px;
        border-bottom: 1px solid #e7f0f2;
        background: linear-gradient(135deg, #f8fcfd 0%, #eef6f7 100%);
      }
      .manage-plan-title {
        margin: 0;
        color: #01535b;
        font-size: 1.05rem;
        font-weight: 700;
      }
      .manage-plan-meta {
        margin: 4px 0 0;
        color: #64748b;
        font-size: 12px;
      }
      .manage-plan-toggle {
        width: auto;
        margin: 0;
        padding: 8px 12px;
        border-radius: 999px;
        border: 1px solid #c9dde1;
        background: #fff;
        color: #01535b;
        font-size: 12px;
        font-weight: 700;
        box-shadow: none;
      }
      .manage-plan-toggle:hover {
        background: #eaf7f8;
        transform: none;
      }
      .manage-plan-body {
        padding: 18px;
      }
      .feature-pricing-card {
        overflow: hidden;
      }
      .feature-pricing-card.is-collapsed .feature-pricing-body {
        display: none;
      }
      .feature-pricing-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        margin-bottom: 0;
        padding-bottom: 14px;
        border-bottom: 2px solid #e8f4f8;
      }
      .feature-pricing-heading {
        margin: 0;
        color: #01535b;
        font-size: 1.4rem;
        font-weight: 600;
      }
      .feature-pricing-meta {
        margin: 4px 0 0;
        color: #64748b;
        font-size: 13px;
      }
      .feature-pricing-toggle {
        width: auto;
        margin: 0;
        padding: 8px 12px;
        border-radius: 999px;
        border: 1px solid #c9dde1;
        background: #fff;
        color: #01535b;
        font-size: 12px;
        font-weight: 700;
        box-shadow: none;
      }
      .feature-pricing-toggle:hover {
        background: #eaf7f8;
        transform: none;
      }
      .feature-pricing-body {
        padding-top: 18px;
      }
      .top-section-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        margin-bottom: 0;
        padding-bottom: 14px;
        border-bottom: 2px solid #e8f4f8;
      }
      .top-section-heading {
        margin: 0;
        color: #01535b;
        font-size: 1.4rem;
        font-weight: 600;
      }
      .top-section-meta {
        margin: 4px 0 0;
        color: #64748b;
        font-size: 13px;
      }
      .top-section-toggle {
        width: auto;
        margin: 0;
        padding: 8px 12px;
        border-radius: 999px;
        border: 1px solid #c9dde1;
        background: #fff;
        color: #01535b;
        font-size: 12px;
        font-weight: 700;
        box-shadow: none;
      }
      .top-section-toggle:hover {
        background: #eaf7f8;
        transform: none;
      }
      .settings-card.is-collapsed .settings-card-body {
        display: none;
      }
      .settings-card.is-collapsed,
      .feature-pricing-card.is-collapsed,
      .manage-plans-section.is-collapsed,
      .student-tiers-section.is-collapsed {
        min-height: 148px;
        padding-top: 20px;
        padding-bottom: 18px;
        display: flex;
        flex-direction: column;
        justify-content: center;
      }
      .settings-card.is-collapsed .settings-card-header,
      .feature-pricing-card.is-collapsed .feature-pricing-header,
      .manage-plans-section.is-collapsed .top-section-header,
      .student-tiers-section.is-collapsed .top-section-header {
        min-height: 100%;
        padding-bottom: 0;
        border-bottom: none;
      }
      .settings-card-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        margin-bottom: 0;
        padding-bottom: 14px;
        border-bottom: 2px solid #e8f4f8;
      }
      .settings-card-heading {
        margin: 0;
        color: #01535b;
        font-size: 1.4rem;
        font-weight: 600;
      }
      .settings-card-heading-group {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
      }
      .settings-card-body {
        padding-top: 18px;
      }
      .manage-plans-section.is-collapsed .manage-plans-body,
      .student-tiers-section.is-collapsed .student-tiers-body {
        display: none;
      }
      .manage-plans-body,
      .student-tiers-body {
        padding-top: 18px;
      }
      /* ---- Manage Plans body ---- */
      .manage-plan-body > p {
        margin: 0 0 12px;
      }
      .manage-plan-body > p > strong {
        display: block;
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 0.05em;
        text-transform: uppercase;
        color: #64748b;
        margin-bottom: 6px;
      }
      .plan-description {
        width: 100%;
        margin: 0;
        padding: 9px 11px;
        border-radius: 9px;
        border: 1px solid #dbe9ec;
        background: #f9fbfc;
        font-size: 13.5px;
        box-sizing: border-box;
      }
      .plan-description:focus {
        outline: none;
        border-color: #01535b;
        background: #fff;
        box-shadow: 0 0 0 3px rgba(1, 83, 91, 0.1);
      }
      .feature-list {
        list-style: none;
        padding: 0;
        margin: 0 0 14px;
        display: flex;
        flex-direction: column;
        gap: 6px;
      }
      .feature-list li {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 10px;
        padding: 8px 10px;
        border: 1px solid #e7f0f2;
        border-radius: 9px;
        background: #fbfdfe;
        font-size: 13px;
        color: #1f2937;
        transition: border-color 0.15s, background 0.15s;
      }
      .feature-list li:hover {
        border-color: #c9dde1;
        background: #f4fafb;
      }
      .feature-list:empty::after {
        content: "No features attached yet.";
        display: block;
        padding: 12px;
        text-align: center;
        color: #94a3b8;
        font-size: 12.5px;
        font-style: italic;
        border: 1px dashed #dbe9ec;
        border-radius: 9px;
      }
      .manage-plan-total {
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        gap: 8px;
        margin: 0 0 14px;
        padding: 10px 12px;
        border-radius: 10px;
        background: linear-gradient(135deg, #eef9f1 0%, #e6f6ee 100%);
        border: 1px solid #c7ead4;
      }
      .manage-plan-total .total-label {
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 0.05em;
        text-transform: uppercase;
        color: #15803d;
      }
      .manage-plan-total .total-value {
        font-size: 1.05rem;
        font-weight: 800;
        color: #0f5132;
      }
      .feature-input {
        display: flex;
        align-items: center;
        gap: 8px;
        margin: 0 0 14px;
      }
      .feature-input .feature-select {
        flex: 1 1 auto;
        width: auto;
        margin: 0;
        padding: 9px 11px;
        font-size: 13px;
        border-radius: 9px;
      }
      .action-icon {
        cursor: pointer;
        user-select: none;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 30px;
        height: 30px;
        flex: 0 0 30px;
        font-size: 18px;
        line-height: 1;
        border-radius: 8px;
        background: #eaf7ff;
        color: #01535b;
        transition: background 0.15s, color 0.15s, transform 0.1s;
      }
      .action-icon:hover {
        background: #b6e0fe;
        color: #0e7c86;
      }
      .action-icon:active {
        transform: scale(0.92);
      }
      .action-icon.add-feature {
        background: #e6f6ee;
        color: #0f5132;
      }
      .action-icon.add-feature:hover {
        background: #cdebda;
      }
      .action-icon.remove-feature {
        background: #fdeceb;
        color: #b42318;
      }
      .action-icon.remove-feature:hover {
        background: #fad7d4;
      }
      .feature-list .feature-name {
        font-weight: 600;
        color: #1f2937;
      }
      .feature-list .feature-meta {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        white-space: nowrap;
      }
      .feature-list .feature-price {
        font-size: 12.5px;
        font-weight: 700;
        color: #0e7c86;
        background: #eaf7ff;
        padding: 2px 8px;
        border-radius: 999px;
      }
      .feature-list .feature-local {
        font-size: 11.5px;
        color: #94a3b8;
      }
      .plan-actions {
        display: flex;
        align-items: center;
        gap: 12px;
        margin-top: 4px;
        padding-top: 14px;
        border-top: 1px solid #eef3f4;
      }
      .plan-actions .update-btn {
        width: auto;
        margin: 0;
        padding: 9px 22px;
        background: #01535b;
        color: #fff;
        border: none;
        border-radius: 9px;
        font-size: 13.5px;
        font-weight: 700;
        cursor: pointer;
        transition: background 0.15s, transform 0.1s;
      }
      .plan-actions .update-btn:hover {
        background: #0e7c86;
        transform: translateY(-1px);
      }
      .plan-actions label,
      .plan-actions .toggle-status {
        margin: 0;
      }
      .plan-actions .plan-active-toggle {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        margin: 0;
        font-size: 13px;
        font-weight: 600;
        color: #334155;
        cursor: pointer;
      }
      .plan-actions .toggle-status {
        width: 18px;
        height: 18px;
        accent-color: #01535b;
        cursor: pointer;
      }
      .action-btn {
        padding: 10px 16px;
        border-radius: 6px;
        cursor: pointer;
        border: none;
        color: white;
        font-weight: 500;
        font-size: 1rem;
        transition: background 0.2s;
      }
      .delete-btn {
        background: #e74c3c;
      }
      .update-btn {
        background: #f39c12;
      }
      .toggle-btn {
        background: #27ae60;
      }
      .notice {
        background-color: #e7f3fe;
        color: #0c5460;
        border: 1px solid #bee5eb;
        border-radius: 7px;
        padding: 18px;
        margin-bottom: 24px;
      }
      .notice h2 {
        font-size: 1.1rem;
        margin: 0 0 10px;
        font-weight: bold;
      }
      .mode-pill {
        display: inline-block;
        padding: 4px 10px;
        border-radius: 999px;
        font-size: 12px;
        font-weight: 700;
        letter-spacing: 0.04em;
      }
      .mode-pill-live {
        background: #e7faf1;
        color: #0f5132;
        border: 1px solid #8fcab4;
      }
      .mode-pill-test {
        background: #fff7e6;
        color: #8a4b00;
        border: 1px solid #f3d19b;
      }
      .mode-status {
        margin: 0 0 12px;
        color: #334155;
        font-size: 13px;
      }
      /* Additional responsive CSS improvements */
      label {
        font-weight: 600;
        margin-bottom: 8px;
        display: block;
        color: #01535b;
        font-size: 14px;
      }
      
      input[type="text"],
      input[type="number"],
      input[type="date"],
      select {
        width: 100%;
        padding: 12px;
        margin-bottom: 16px;
        border: 1px solid #d1e3e8;
        border-radius: 8px;
        font-size: 14px;
        background: #f9fbfc;
        transition: all 0.2s ease;
        box-sizing: border-box;
      }
      
      input[type="text"]:focus,
      input[type="number"]:focus,
      input[type="date"]:focus,
      select:focus {
        outline: none;
        border-color: #01535b;
        box-shadow: 0 0 0 3px rgba(1, 83, 91, 0.1);
        background: #fff;
      }
      
      button {
        width: 100%;
        padding: 14px;
        background: #01535b;
        color: white;
        border: none;
        border-radius: 8px;
        font-size: 16px;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.2s ease;
        margin-top: 8px;
      }
      
      button:hover {
        background: #0e7c86;
        transform: translateY(-1px);
        box-shadow: 0 4px 12px rgba(1, 83, 91, 0.2);
      }
      
      button:active {
        transform: translateY(0);
      }
      
      button:disabled {
        background: #94a3b8;
        cursor: not-allowed;
        transform: none;
        box-shadow: none;
      }
      
      /* Responsive breakpoints */
      @media (max-width: 1200px) {
        .column-1 {
          grid-template-columns: repeat(2, minmax(0, 1fr));
          gap: 20px;
        }
        .secondary-sections-grid {
          grid-template-columns: repeat(2, minmax(0, 1fr));
        }
      }
      
      @media (max-width: 768px) {
        .container {
          padding: 0 16px;
          gap: 16px;
          margin: 20px auto;
        }
        
        .column-1 {
          grid-template-columns: 1fr;
          gap: 16px;
        }
        .secondary-sections-grid {
          width: calc(100% - 32px);
          padding: 0 16px;
          grid-template-columns: 1fr;
          gap: 16px;
        }
        
        .form-container {
          padding: 24px 20px;
        }
        
        .admin-header h1 {
          font-size: 1.8rem;
        }
      }
      
      @media (max-width: 480px) {
        .container {
          padding: 0 12px;
          gap: 12px;
        }
        .secondary-sections-grid {
          width: calc(100% - 24px);
          padding: 0 12px;
          gap: 12px;
        }
        
        .form-container {
          padding: 20px 16px;
        }
        
        .admin-header {
          padding: 16px 0 12px 0;
        }
        
        .admin-header h1 {
          font-size: 1.6rem;
        }
      }
      select:focus {
        border: 1.5px solid #0e7c86;
        outline: none;
      }
      button[type="submit"] {
        background: #01535b;
        color: #fff;
        border: none;
        border-radius: 6px;
        padding: 12px 0;
        font-size: 1rem;
        font-weight: 600;
        cursor: pointer;
        margin-top: 8px;
        transition: background 0.2s;
      }
      button[type="submit"]:hover {
        background: #0e7c86;
      }
      .plan-description {
        width: 100%;
        margin-top: 5px;
        padding: 8px;
        border-radius: 5px;
        border: 1px solid #d1e3e8;
        background: #f9fbfc;
        font-size: 1rem;
      }
      .student-tier-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(340px, 1fr));
        gap: 18px;
        align-items: start;
      }
      .student-tier-plan {
        border: 1px solid #dbe9ec;
        border-radius: 16px;
        background: #ffffff;
        box-shadow: 0 8px 20px rgba(1, 83, 91, 0.05);
        overflow: hidden;
      }
      .student-tier-plan.is-collapsed .student-tier-body {
        display: none;
      }
      .student-tier-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 12px;
        padding: 18px 18px 16px;
        border-bottom: 1px solid #e7f0f2;
        background: linear-gradient(135deg, #f8fcfd 0%, #eef6f7 100%);
      }
      .student-tier-title {
        margin: 0;
        color: #01535b;
        font-size: 1.05rem;
      }
      .student-tier-summary {
        margin: 4px 0 0;
        font-size: 12px;
        color: #64748b;
      }
      .student-tier-toggle {
        width: auto;
        margin: 0;
        padding: 8px 12px;
        border-radius: 999px;
        border: 1px solid #c9dde1;
        background: #fff;
        color: #01535b;
        font-size: 12px;
        font-weight: 700;
        letter-spacing: 0.02em;
        box-shadow: none;
      }
      .student-tier-toggle:hover {
        background: #eaf7f8;
        transform: none;
      }
      .student-tier-body {
        padding: 18px;
        background: #fbfdfe;
      }
      .student-tier-list {
        display: flex;
        flex-direction: column;
        gap: 12px;
        margin-bottom: 16px;
      }
      .student-tier-row {
        display: grid;
        grid-template-columns: minmax(0, 1fr) auto;
        align-items: end;
        gap: 12px;
        padding: 14px;
        background: #fff;
        border: 1px solid #dfe9ec;
        border-radius: 14px;
      }
      .student-tier-form {
        display: grid;
        grid-template-columns: minmax(160px, 1.3fr) minmax(120px, 1fr) auto;
        align-items: end;
        gap: 12px;
        width: 100%;
      }
      .student-tier-field {
        display: flex;
        flex-direction: column;
        gap: 6px;
      }
      .student-tier-field-label {
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 0.04em;
        text-transform: uppercase;
        color: #64748b;
      }
      .student-tier-range,
      .student-tier-price {
        display: flex;
        align-items: center;
        gap: 6px;
        flex-wrap: wrap;
      }
      .student-tier-mini-input {
        width: 72px;
        min-width: 0;
        padding: 6px 8px;
        margin-bottom: 0;
        border: 1px solid #d1d5db;
        border-radius: 8px;
        font-size: 12.5px;
        text-align: center;
        background: #fff;
      }
      .student-tier-range .student-tier-mini-input {
        flex: 0 0 72px;
      }
      .student-tier-price .student-tier-mini-input {
        flex: 0 0 84px;
        width: 84px;
      }
      .student-tier-text-muted {
        color: #6b7280;
        font-size: 12px;
        white-space: nowrap;
      }
      .student-tier-separator {
        color: #9ca3af;
        margin: 0 2px;
      }
      .student-tier-delete {
        width: auto;
        margin: 0;
        padding: 8px 10px;
        border: 1px solid #f3c5c0;
        background: #fff5f4;
        color: #e74c3c;
        font-size: 14px;
        border-radius: 10px;
        box-shadow: none;
      }
      .student-tier-delete:hover {
        background: #fdebea;
        color: #c0392b;
        transform: none;
      }
      .student-tier-add {
        display: grid;
        grid-template-columns: minmax(220px, 1.5fr) minmax(180px, 1fr);
        align-items: start;
        gap: 12px;
        padding: 14px;
        background: #f6fbfc;
        border: 1px dashed #b8d8dc;
        border-radius: 14px;
      }
      .student-tier-empty {
        margin: 0 0 14px;
        padding: 14px;
        border-radius: 12px;
        background: #f8fbfc;
        border: 1px dashed #d6e7ea;
        color: #64748b;
        font-size: 13px;
      }
      .student-tier-plan-form {
        display: flex;
        flex-direction: column;
        gap: 14px;
      }
      .student-tier-row-menu {
        position: relative;
      }
      .student-tier-row-menu details {
        position: relative;
      }
      .student-tier-row-menu summary {
        list-style: none;
        cursor: pointer;
        width: 34px;
        height: 34px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 10px;
        border: 1px solid #d7e4e8;
        background: #fff;
        color: #4b5563;
        font-weight: 700;
        font-size: 18px;
      }
      .student-tier-row-menu summary::-webkit-details-marker {
        display: none;
      }
      .student-tier-row-menu[open] summary,
      .student-tier-row-menu summary:hover {
        background: #f4f8fa;
      }
      .student-tier-row-menu-panel {
        position: absolute;
        right: 0;
        top: calc(100% + 6px);
        z-index: 2;
        min-width: 96px;
        padding: 8px;
        border-radius: 12px;
        border: 1px solid #dbe7eb;
        background: #fff;
        box-shadow: 0 12px 24px rgba(15, 23, 42, 0.12);
      }
      .student-tier-save-all {
        width: auto;
        align-self: flex-start;
        margin: 0;
        padding: 10px 16px;
        font-size: 13px;
        white-space: nowrap;
      }
      .student-tier-drafts {
        display: flex;
        flex-direction: column;
        gap: 12px;
      }
      .student-tier-add-row-button {
        width: auto;
        align-self: flex-start;
        margin: 0;
        padding: 8px 12px;
        font-size: 12px;
        background: #ffffff;
        color: #01535b;
        border: 1px solid #c7dadd;
      }
      .student-tier-add-row-button:hover {
        background: #eef6f7;
      }
      .student-tier-draft-actions {
        display: flex;
        align-items: center;
        justify-content: flex-end;
        grid-column: 1 / -1;
        padding-top: 4px;
      }
      .student-tier-remove-draft {
        width: auto;
        margin: 0;
        padding: 8px 12px;
        font-size: 12px;
        background: #fff5f4;
        color: #b42318;
        border: 1px solid #f3c5c0;
        border-radius: 10px;
        white-space: nowrap;
      }
      .student-tier-remove-draft:hover {
        background: #fdebea;
      }
      @media (max-width: 1100px) {
        .container,
        .manage-plans-grid,
        .student-tier-grid {
          grid-template-columns: repeat(2, minmax(0, 1fr));
        }
      }
      /* Responsive Design */
      @media (max-width: 1024px) {
        .container {
          padding: 0 12px;
          width: calc(100% - 24px);
          gap: 16px;
          grid-template-columns: repeat(2, minmax(0, 1fr));
        }
        .form-container,
        .plan-container {
          padding: 24px 18px;
        }
        .manage-plan-body,
        .student-tier-body,
        .settings-card-body,
        .feature-pricing-body,
        .manage-plans-body,
        .student-tiers-body {
          padding-top: 16px;
        }
      }
      @media (max-width: 700px) {
        .admin-header h1 {
          font-size: 1.3rem;
        }
        .container {
          padding: 0 12px;
          width: calc(100% - 24px);
          gap: 14px;
          grid-template-columns: 1fr;
        }
        .form-container,
        .plan-container {
          padding: 20px 16px;
          border-radius: 14px;
        }
        .plan-description {
          font-size: 0.95rem;
        }
        .manage-plans-grid,
        .student-tier-grid {
          grid-template-columns: 1fr;
        }
        .settings-card-header,
        .feature-pricing-header,
        .top-section-header,
        .manage-plan-header,
        .student-tier-header {
          flex-direction: column;
          align-items: flex-start;
          gap: 10px;
        }
        .top-section-toggle,
        .feature-pricing-toggle,
        .manage-plan-toggle,
        .student-tier-toggle {
          align-self: flex-end;
        }
        .student-tier-row,
        .student-tier-add,
        .student-tier-form {
          gap: 8px;
        }
        .student-tier-row {
          grid-template-columns: 1fr;
        }
        .student-tier-form,
        .student-tier-add {
          grid-template-columns: 1fr;
        }
        .student-tier-delete {
          justify-self: start;
        }
        .student-tier-draft-actions {
          justify-content: flex-start;
        }
      }
      @media (max-width: 600px) {
        .admin-header {
          padding: 16px 0 10px 0;
        }
        .admin-header h1 {
          font-size: 1.1rem;
        }
        .container {
          margin-top: 10px;
          padding: 0 10px;
          width: calc(100% - 20px);
          gap: 12px;
        }
        .secondary-sections-grid {
          width: calc(100% - 20px);
          padding: 0 10px;
          gap: 12px;
        }
        .form-container,
        .plan-container {
          padding: 18px 14px;
          border-radius: 12px;
        }
        .plan-description {
          font-size: 0.9rem;
        }
        .student-tier-header,
        .student-tier-body,
        .student-tier-row,
        .student-tier-add,
        .student-tier-form {
          padding-left: 0;
          padding-right: 0;
        }
        .settings-card-heading,
        .feature-pricing-heading,
        .top-section-heading {
          font-size: 1.15rem;
        }
        .student-tier-range,
        .student-tier-price {
          flex-wrap: wrap;
        }
        .student-tier-mini-input {
          width: 100%;
        }
        .student-tier-add-row-button,
        .student-tier-save-all,
        .student-tier-remove-draft {
          width: 100%;
          justify-content: center;
        }
      }

      /* ================================================================
         COMPACT PRO RESTYLE — small text, tight spacing, flat clean cards.
         Appended last so it wins the cascade without touching structure.
         ================================================================ */
      body { font-size: 13px; line-height: 1.5; background:#f7f9fb; color:#1f2a30; }

      .admin-header {
        background:#01535b;
        padding:14px 16px 12px;
        box-shadow:none;
        border-bottom:1px solid rgba(255,255,255,0.06);
      }
      .admin-header h1 { font-size:1.05rem; font-weight:600; letter-spacing:.2px; }
      .admin-header p, .admin-header small { font-size:12px; opacity:.85; }

      .container {
        width: calc(100% - 24px);
        margin: 16px auto;
        padding: 0 12px;
        gap: 12px;
      }

      .form-container, .card, .panel, .section-card, .gateway-strategy-card {
        padding: 14px 16px !important;
        border-radius: 8px !important;
        box-shadow: 0 1px 2px rgba(15,23,42,0.04) !important;
        border: 1px solid #e4e9ee !important;
        background: #fff !important;
      }

      h1 { font-size: 1.05rem; }
      h2 { font-size: .95rem; margin: 0 0 8px; font-weight:600; color:#0f172a; }
      h3 { font-size: .85rem; margin: 0 0 6px; font-weight:600; color:#0f172a; }
      h4, h5, h6 { font-size: .8rem; margin: 0 0 4px; font-weight:600; color:#334155; }
      p, li, label, span, td, th, div { font-size: 13px; }
      small, .muted, .note, .hint, .gateway-strategy-note,
      .collapsed-card-copy, .stripe-test-card-note, .stripe-platform-status {
        font-size: 12px !important;
        line-height: 1.45 !important;
      }

      label { color:#475569; font-weight:500; }
      input[type="text"], input[type="number"], input[type="email"],
      input[type="password"], input[type="search"], select, textarea {
        font-size: 13px !important;
        padding: 6px 9px !important;
        border-radius: 6px !important;
        border: 1px solid #d4dce3 !important;
        background:#fff !important;
        box-shadow:none !important;
        min-height: 32px;
      }
      input:focus, select:focus, textarea:focus {
        outline: none !important;
        border-color:#01535b !important;
        box-shadow: 0 0 0 2px rgba(1,83,91,0.12) !important;
      }

      button, .btn, .button, input[type="submit"], input[type="button"] {
        font-size: 12px !important;
        padding: 6px 12px !important;
        border-radius: 6px !important;
        font-weight: 500 !important;
        line-height: 1.3 !important;
        min-height: 30px !important;
        letter-spacing: .1px;
        box-shadow:none !important;
      }
      .btn-primary, button[type="submit"], .save-btn, .student-tier-save-all {
        background:#01535b !important;
        color:#fff !important;
        border:1px solid #01535b !important;
      }
      .btn-primary:hover, button[type="submit"]:hover {
        background:#013f45 !important;
        border-color:#013f45 !important;
      }
      .btn-secondary, .cancel-btn { background:#f1f5f9 !important; color:#334155 !important; border:1px solid #d4dce3 !important; }
      .btn-danger, .delete-btn { background:#fff !important; color:#b91c1c !important; border:1px solid #fecaca !important; }
      .btn-danger:hover { background:#fef2f2 !important; }

      table { font-size: 12px; }
      table th { font-size: 11px; text-transform: uppercase; letter-spacing:.4px; color:#64748b; font-weight:600; padding:8px 10px; }
      table td { padding: 8px 10px; border-top:1px solid #eef1f4; }

      .badge, .tag, .pill, .status-badge {
        font-size: 11px !important;
        padding: 2px 8px !important;
        border-radius: 999px !important;
        font-weight: 500 !important;
      }

      /* tighter vertical rhythm */
      .form-group, .field, .row, .stack { margin-bottom: 10px !important; }
      hr { margin: 12px 0; border:0; border-top:1px solid #eef1f4; }

      @media (max-width: 900px) {
        .container { grid-template-columns: 1fr; }
      }

      /* Prevent iOS auto-zoom on input focus (inputs must be >=16px on small screens) */
      @media (max-width: 768px) {
        input[type="text"], input[type="number"], input[type="email"],
        input[type="password"], input[type="search"], input[type="tel"],
        input[type="url"], input[type="date"], select, textarea {
          font-size: 16px !important;
        }
      }
    </style>

  </head>
  <body>
    <%- include('../partials/flash') %>

    <div class="admin-header">
      <h1>Service Pricing Management</h1>
    </div>
    <!-- Notice Section -->
    <!-- <div class="notice">
      <h2>📢 Notice:</h2>
      <p>
        Quick Steps to Add a New Feature with examples. please check the
        ADDFEATUREREADME.MD IN THE ROOT
      </p>
    </div> -->
    

    
    <div class="container">
        <div class="form-container settings-card is-collapsed" data-settings-card>
          <div class="settings-card-header">
            <div class="settings-card-heading-group">
              <h2 class="settings-card-heading">Free Trial Settings</h2>
              <p class="collapsed-card-copy">Control whether new schools get a trial and how long it lasts.</p>
            </div>
            <button type="button" class="top-section-toggle" data-settings-toggle aria-expanded="false">Expand</button>
          </div>
          <div class="settings-card-body">
            <form action="/admin/updateFreeTrialSettings" method="POST" id="free-trial-form">
              <label for="free_trial_enabled">Enable Free Trial:</label>
              <select name="free_trial_enabled" id="free_trial_enabled">
                <option value="true" <% if (typeof freeTrialEnabled !== 'undefined' && freeTrialEnabled === 'true') { %>selected<% } %>>Yes</option>
                <option value="false" <% if (typeof freeTrialEnabled === 'undefined' || freeTrialEnabled !== 'true') { %>selected<% } %>>No</option>
              </select>
              <label for="free_trial_days">Trial Duration:</label>
              <select name="free_trial_days" id="free_trial_days" required>
                <option value="5_minutes" <% if (typeof freeTrialDays !== 'undefined' && freeTrialDays === '5_minutes') { %>selected<% } %>>5 Minutes</option>
                <option value="1" <% if (typeof freeTrialDays !== 'undefined' && freeTrialDays === '1') { %>selected<% } %>>1 Day</option>
                <option value="7" <% if (typeof freeTrialDays === 'undefined' || freeTrialDays === '7') { %>selected<% } %>>7 Days</option>
                <option value="14" <% if (typeof freeTrialDays !== 'undefined' && freeTrialDays === '14') { %>selected<% } %>>14 Days</option>
                <option value="30" <% if (typeof freeTrialDays !== 'undefined' && freeTrialDays === '30') { %>selected<% } %>>30 Days</option>
                <option value="60" <% if (typeof freeTrialDays !== 'undefined' && freeTrialDays === '60') { %>selected<% } %>>60 Days</option>
                <option value="90" <% if (typeof freeTrialDays !== 'undefined' && freeTrialDays === '90') { %>selected<% } %>>90 Days</option>
                <option value="120" <% if (typeof freeTrialDays !== 'undefined' && freeTrialDays === '120') { %>selected<% } %>>120 Days</option>
              </select>
              <button type="submit">Save Free Trial Settings</button>
            </form>
          </div>
        </div>

        <div class="form-container settings-card is-collapsed" data-settings-card>
          <div class="settings-card-header">
            <div class="settings-card-heading-group">
              <h2 class="settings-card-heading">Billing Interval</h2>
              <p class="collapsed-card-copy">Set the default renewal cadence used across subscription billing.</p>
            </div>
            <button type="button" class="top-section-toggle" data-settings-toggle aria-expanded="false">Expand</button>
          </div>
          <div class="settings-card-body">
            <form action="/admin/updateBillingInterval" method="POST" id="billing-interval-form">
              <label for="billing_interval">Billing Interval:</label>
              <select name="billing_interval" id="billing_interval">
                <option value="5_minutes" <% if (typeof billingInterval !== 'undefined' && billingInterval === '5_minutes') { %>selected<% } %>>5 Minutes</option>
                <option value="daily" <% if (typeof billingInterval !== 'undefined' && billingInterval === 'daily') { %>selected<% } %>>Daily</option>
                <option value="weekly" <% if (typeof billingInterval !== 'undefined' && billingInterval === 'weekly') { %>selected<% } %>>Weekly</option>
                <option value="monthly" <% if (typeof billingInterval === 'undefined' || billingInterval === 'monthly') { %>selected<% } %>>Monthly</option>
                <option value="yearly" <% if (typeof billingInterval !== 'undefined' && billingInterval === 'yearly') { %>selected<% } %>>Yearly</option>
                <option value="2_years" <% if (typeof billingInterval !== 'undefined' && billingInterval === '2_years') { %>selected<% } %>>2 Years</option>
                <option value="3_years" <% if (typeof billingInterval !== 'undefined' && billingInterval === '3_years') { %>selected<% } %>>3 Years</option>
              </select>
              <button type="submit">Save Billing Interval</button>
            </form>
          </div>
        </div>

        <div class="form-container settings-card gateway-strategy-card is-collapsed" data-settings-card>
          <div class="settings-card-header">
            <div class="settings-card-heading-group">
              <h2 class="settings-card-heading">Gateway Strategy</h2>
              <p class="collapsed-card-copy">Choose Paystack only, Stripe only, or smart mode for both gateways.</p>
            </div>
            <button type="button" class="top-section-toggle" data-settings-toggle aria-expanded="false">Expand</button>
          </div>
          <div class="settings-card-body">
            <p class="mode-status">
              Active Strategy:
              <% if (paymentProvider === 'smart') { %>
                <span class="mode-pill mode-pill-live">BOTH / SMART</span>
              <% } else if (paymentProvider === 'stripe') { %>
                <span class="mode-pill mode-pill-live">STRIPE</span>
              <% } else { %>
                <span class="mode-pill mode-pill-test">PAYSTACK</span>
              <% } %>
            </p>
            <p class="gateway-strategy-note">Choose one gateway only, or use smart mode to let checkout offer both Stripe and Paystack while saving the selected gateway on each organization.</p>
            <form action="/admin/updatePaymentProviderSettings" method="POST" id="payment-provider-settings-form">
              <label for="payment_provider">Provider:</label>
              <select name="payment_provider" id="payment_provider" required>
                <option value="smart" <% if (paymentProvider === 'smart') { %>selected<% } %>>Both / Smart</option>
                <option value="paystack" <% if (paymentProvider === 'paystack') { %>selected<% } %>>Paystack only</option>
                <option value="stripe" <% if (paymentProvider === 'stripe') { %>selected<% } %>>Stripe</option>
              </select>

              <button type="submit">Save Gateway Strategy</button>
            </form>
          </div>
        </div>

        <div class="form-container settings-card is-collapsed" data-settings-card>
          <div class="settings-card-header">
            <div class="settings-card-heading-group">
              <h2 class="settings-card-heading">Platform Fee</h2>
              <p class="collapsed-card-copy">Control the percentage added to in-app card and wallet charges.</p>
            </div>
            <button type="button" class="top-section-toggle" data-settings-toggle aria-expanded="false">Expand</button>
          </div>
          <div class="settings-card-body">
            <p class="gateway-strategy-note">This fee is used for Managira Stripe card and wallet checkouts and is reflected on PayGira card receipts. Apple Pay and Google Pay ride on Stripe, so they still require a supported browser/device and Stripe domain verification.</p>
            <form action="/admin/updatePlatformFeeSettings" method="POST" id="platform-fee-settings-form">
              <label for="platform_fee_percentage">Platform Fee Percentage:</label>
              <input
                type="number"
                id="platform_fee_percentage"
                name="platform_fee_percentage"
                min="0"
                max="100"
                step="0.01"
                value="<%= Number(platformFeePercentage || 0).toFixed(2).replace(/\.00$/, '') %>"
                required
              />
              <button type="submit">Save Platform Fee</button>
            </form>
          </div>
        </div>

        <div class="form-container settings-card is-collapsed" data-settings-card>
          <div class="settings-card-header">
            <div class="settings-card-heading-group">
              <h2 class="settings-card-heading">Paystack Mode & Keys</h2>
              <p class="collapsed-card-copy">Switch Paystack between test and live billing environments.</p>
            </div>
            <button type="button" class="top-section-toggle" data-settings-toggle aria-expanded="false">Expand</button>
          </div>
          <div class="settings-card-body">
            <p class="mode-status">
              Active Mode:
              <% if (paystackMode === 'live') { %>
                <span class="mode-pill mode-pill-live">LIVE</span>
              <% } else { %>
                <span class="mode-pill mode-pill-test">TEST</span>
              <% } %>
            </p>
            <form action="/admin/updatePaystackSettings" method="POST" id="paystack-settings-form">
              <label for="paystack_mode">Mode:</label>
              <select name="paystack_mode" id="paystack_mode" required>
                <option value="test" <% if (paystackMode !== 'live') { %>selected<% } %>>Test</option>
                <option value="live" <% if (paystackMode === 'live') { %>selected<% } %>>Live</option>
              </select>

              <button type="submit">Save Paystack Settings</button>
            </form>
          </div>
        </div>

        <div class="form-container settings-card is-collapsed" data-settings-card>
          <div class="settings-card-header">
            <div class="settings-card-heading-group">
              <h2 class="settings-card-heading">Stripe Mode & Keys</h2>
              <p class="collapsed-card-copy">Switch Stripe between test and live mode and review key status.</p>
            </div>
            <button type="button" class="top-section-toggle" data-settings-toggle aria-expanded="false">Expand</button>
          </div>
          <div class="settings-card-body">
            <p class="mode-status">
              Active Mode:
              <% if (stripeMode === 'live') { %>
                <span class="mode-pill mode-pill-live">LIVE</span>
              <% } else { %>
                <span class="mode-pill mode-pill-test">TEST</span>
              <% } %>
            </p>
            <form action="/admin/updateStripeSettings" method="POST" id="stripe-settings-form">
              <label for="stripe_mode">Mode:</label>
              <select name="stripe_mode" id="stripe_mode" required>
                <option value="test" <% if (stripeMode !== 'live') { %>selected<% } %>>Test</option>
                <option value="live" <% if (stripeMode === 'live') { %>selected<% } %>>Live</option>
              </select>

              <button type="submit">Save Stripe Settings</button>
            </form>

            <div style="margin-top: 16px; color: #64748b; font-size: 13px; line-height: 1.6;">
              <div>Test publishable key: <%= stripeKeysMasked?.testPublicKey || 'Not set' %></div>
              <div>Test secret key: <%= stripeKeysMasked?.testSecretKey || 'Not set' %></div>
              <div>Live publishable key: <%= stripeKeysMasked?.livePublicKey || 'Not set' %></div>
              <div>Live secret key: <%= stripeKeysMasked?.liveSecretKey || 'Not set' %></div>
            </div>

            <div class="stripe-platform-status <%= stripePlatformStatus?.issue ? 'is-warning' : 'is-ready' %>">
              <div><strong>Connect and destination charges</strong></div>
              <% if (stripePlatformStatus?.issue) { %>
                <div><%= stripePlatformStatus.issue %></div>
                <div>
                  Add a full <%= stripeMode === 'live' ? 'sk_live_' : 'sk_test_' %> platform secret in
                  <%= stripeMode === 'live' ? 'STRIPE_CONNECT_LIVE_SECRET_KEY or STRIPE_LIVE_SECRET_KEY' : 'STRIPE_CONNECT_TEST_SECRET_KEY, STRIPE_CONNECT_SECRET_KEY, STRIPE_TEST_SECRET_KEY, or STRIPE_SECRET_KEY' %>
                  so the selected mode can create Connect and destination-charge payments.
                </div>
              <% } else { %>
                <div>Ready for <%= String((stripePlatformStatus && stripePlatformStatus.mode) || stripeMode || 'test').toUpperCase() %> mode.</div>
                <div>The selected mode has a matching platform secret and publishable key for Connect-linked Stripe payments.</div>
              <% } %>
            </div>

            <div class="stripe-test-card-note">
              <div><strong>Stripe test cards</strong></div>
              <div>Visa success: 4242 4242 4242 4242</div>
              <div>Visa authentication: 4000 0025 0000 3155</div>
              <div>Card declined: 4000 0000 0000 9995</div>
              <div>Use any future expiry date, any 3-digit CVC, and any ZIP/postal code.</div>
              <div>Apple Pay and wallet methods require a supported browser/device and Stripe domain verification before they can appear in checkout.</div>
            </div>
          </div>
        </div>

        <div class="form-container settings-card is-collapsed" data-settings-card>
          <div class="settings-card-header">
            <div class="settings-card-heading-group">
              <h2 class="settings-card-heading">🔄 Recalculate Plan Totals</h2>
              <p class="collapsed-card-copy">Refresh plan totals after feature pricing changes or bulk updates.</p>
            </div>
            <button type="button" class="top-section-toggle" data-settings-toggle aria-expanded="false">Expand</button>
          </div>
          <div class="settings-card-body">
            <p>Use this button if plan total costs seem incorrect or after making multiple feature price changes:</p>
            <button 
              class="action-btn update-btn" 
              id="recalculate-totals-btn"
              style="background: #28a745; color: white; padding: 10px 20px; font-size: 16px;"
            >
              Recalculate All Plan Totals
            </button>
          </div>
        </div>

        <div class="form-container settings-card is-collapsed" data-settings-card>
          <div class="settings-card-header">
            <div class="settings-card-heading-group">
              <h2 class="settings-card-heading">💰 Billing Period Discounts</h2>
              <p class="collapsed-card-copy">Set discounts for longer billing periods like yearly or multi-year plans.</p>
            </div>
            <button type="button" class="top-section-toggle" data-settings-toggle aria-expanded="false">Expand</button>
          </div>
          <div class="settings-card-body">
            <p style="font-size:13px;color:#6b7280;margin-bottom:12px;">
              Set discount percentages for each billing period. Users will see these options when choosing a plan.
              Monthly cannot be disabled. Discounts are capped at 50%.
            </p>
            <table style="width:100%;border-collapse:collapse;font-size:14px;">
              <thead>
                <tr style="text-align:left;border-bottom:2px solid #e5e7eb;">
                  <th style="padding:8px 6px;">Period</th>
                  <th style="padding:8px 6px;">Months</th>
                  <th style="padding:8px 6px;">Discount %</th>
                  <th style="padding:8px 6px;">Active</th>
                  <th style="padding:8px 6px;"></th>
                </tr>
              </thead>
              <tbody>
                <% (typeof billingPeriods !== 'undefined' ? billingPeriods : []).forEach(function(bp) { %>
                  <tr data-period-key="<%= bp.period_key %>" style="border-bottom:1px solid #f0f0f0;">
                    <td style="padding:8px 6px;font-weight:600;"><%= bp.label %></td>
                    <td style="padding:8px 6px;"><%= bp.months %></td>
                    <td style="padding:8px 6px;">
                      <input
                        type="number"
                        class="bp-discount"
                        data-key="<%= bp.period_key %>"
                        value="<%= bp.discount_percentage %>"
                        min="0"
                        max="50"
                        style="width:60px;padding:4px 6px;border:1px solid #d1d5db;border-radius:4px;"
                        <% if (bp.period_key === 'monthly') { %>disabled title="Monthly is always 0% discount"<% } %>
                      />
                    </td>
                    <td style="padding:8px 6px;">
                      <input
                        type="checkbox"
                        class="bp-active"
                        data-key="<%= bp.period_key %>"
                        <% if (bp.is_active) { %>checked<% } %>
                        <% if (bp.period_key === 'monthly') { %>disabled title="Monthly cannot be disabled"<% } %>
                      />
                    </td>
                    <td style="padding:8px 6px;">
                      <% if (bp.period_key !== 'monthly') { %>
                        <button
                          type="button"
                          class="bp-save-btn"
                          data-key="<%= bp.period_key %>"
                          style="background:#2563eb;color:white;border:none;padding:4px 12px;border-radius:4px;cursor:pointer;font-size:12px;"
                        >Save</button>
                      <% } %>
                    </td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
            <p class="bp-status-msg" style="margin-top:8px;font-size:13px;color:#059669;display:none;"></p>
          </div>
        </div>
        <div class="form-container feature-pricing-card is-collapsed" data-feature-pricing>
          <div class="feature-pricing-header">
            <div>
              <h2 class="feature-pricing-heading">Feature Pricing</h2>
              <p class="feature-pricing-meta">Manage feature prices and collapse this section when you do not need it.</p>
            </div>
            <button type="button" class="feature-pricing-toggle" data-feature-toggle aria-expanded="false">Expand</button>
          </div>
          <div class="feature-pricing-body">
            <form action="/admin/setFeaturePrice" method="POST">
              <label>Select Feature:</label>
              <select name="featureId" required>
                <% features.slice().sort((a, b) => a.feature_name.localeCompare(b.feature_name)).forEach(feature => { %>
                  <option value="<%= feature.id %>">
                    <%= feature.feature_name %>
                  </option>
                <% }) %>
              </select>

              <label>Price (USD base):</label>
              <input type="number" name="priceUsd" step="0.01" required />

              <button type="submit">Set Price</button>
            </form>
            <ul class="feature-list">
              <% features.slice().sort((a, b) => a.feature_name.localeCompare(b.feature_name)).forEach(feature => { %>
                <li>
                  <%= feature.feature_name %> (<%= feature.priceUsdDisplay || ('$' + feature.price_usd) %>)
                  <% if (currencyProfile && currencyProfile.userCurrency && currencyProfile.userCurrency !== 'USD') { %>
                    <span style="font-size:12px;color:#6b7280;">≈ <%= feature.localizedPriceDisplay %></span>
                  <% } %>
                  <span
                    class="action-icon remove-feature-from-list"
                    data-featureid="<%= feature.id %>"
                  >-</span>
                </li>
              <% }) %>
            </ul>
          </div>
        </div>
        <div class="form-container manage-plans-section is-collapsed" data-manage-section>
          <div class="top-section-header">
            <div>
              <h2 class="top-section-heading">Manage Plans</h2>
              <p class="top-section-meta">Open this section to work with plan descriptions, features, and active status.</p>
            </div>
            <button type="button" class="top-section-toggle" data-manage-section-toggle aria-expanded="false">Expand</button>
          </div>
          <div class="manage-plans-body">
            <div class="manage-plans-grid">
            <% plans.forEach(plan => { %>
              <section class="manage-plan-card is-collapsed" data-manage-plan>
                <div class="manage-plan-header">
                  <div>
                    <h3 class="manage-plan-title"><%= plan.plan_name %></h3>
                    <p class="manage-plan-meta"><%= plan.features.length %> <%= plan.features.length === 1 ? 'feature' : 'features' %> attached</p>
                  </div>
                  <button type="button" class="manage-plan-toggle" data-manage-toggle aria-expanded="false">Expand</button>
                </div>
                <div class="manage-plan-body">
                  <p>
                    <strong>Description:</strong>
                    <input
                      type="text"
                      class="plan-description"
                      data-planid="<%= plan.plan_id %>"
                      value="<%= plan.description %>"
                    />
                  </p>
                  <p><strong>Features:</strong></p>
                  <ul class="feature-list">
                    <% plan.features.slice().sort((a, b) => a.feature_name.localeCompare(b.feature_name)).forEach(feature => { %>
                      <li>
                        <span class="feature-name"><%= feature.feature_name %></span>
                        <span class="feature-meta">
                          <span class="feature-price"><%= feature.priceUsdDisplay || ('$' + feature.price_usd) %></span>
                          <% if (currencyProfile && currencyProfile.userCurrency && currencyProfile.userCurrency !== 'USD') { %>
                            <span class="feature-local">≈ <%= feature.localizedPriceDisplay %></span>
                          <% } %>
                          <span
                            class="action-icon remove-feature"
                            data-planid="<%= plan.plan_id %>"
                            data-featureid="<%= feature.id %>"
                          >-</span>
                        </span>
                      </li>
                    <% }) %>
                  </ul>
                  <div class="manage-plan-total">
                    <span class="total-label">Total Cost</span>
                    <span class="total-value">
                      <%= plan.totalUsdDisplay || ('$' + plan.total_cost) %>
                      <% if (currencyProfile && currencyProfile.userCurrency && currencyProfile.userCurrency !== 'USD') { %>
                        <span style="display:block;font-size:12px;font-weight:600;color:#15803d;">≈ <%= plan.localizedTotalDisplay %></span>
                      <% } %>
                    </span>
                  </div>
                  <div class="feature-input">
                    <select class="feature-select" data-planid="<%= plan.plan_id %>">
                      <% features.slice().sort((a, b) => a.feature_name.localeCompare(b.feature_name)).forEach(feature => { %>
                        <% if (!plan.features.some(f => f.id === feature.id)) { %>
                          <option value="<%= feature.id %>">
                            <%= feature.feature_name %> (<%= feature.priceUsdDisplay || ('$' + feature.price_usd) %>)
                          </option>
                        <% } %>
                      <% }); %>
                    </select>
                    <span
                      class="action-icon add-feature"
                      data-planid="<%= plan.plan_id %>"
                    >+</span>
                  </div>
                  <div class="plan-actions">
                    <button class="update-btn" data-planid="<%= plan.plan_id %>">
                      Update
                    </button>
                    <label class="plan-active-toggle">
                      <input
                        type="checkbox"
                        class="toggle-status"
                        data-planid="<%= plan.plan_id %>"
                        <% if (plan.is_active) { %>checked<% } %>
                      /> Active
                    </label>
                  </div>
                </div>
              </section>
            <% }) %>
            </div>
          </div>
        </div>
        <div class="form-container student-tiers-section is-collapsed" data-student-tiers-section>
          <div class="top-section-header">
            <div>
              <h2 class="top-section-heading">🎓 Student Count Pricing Tiers</h2>
              <p class="top-section-meta">Open this section to manage student-based pricing for each plan.</p>
            </div>
            <button type="button" class="top-section-toggle" data-student-tiers-toggle aria-expanded="false">Expand</button>
          </div>
          <div class="student-tiers-body">
            <p style="font-size:13px;color:#6b7280;margin-bottom:20px;">
              Set a student range and percentage adjustment for each plan. Use negative values for discounts and positive values for markups based on the plan's normal monthly price.
            </p>

            <% const stByPlan = typeof studentTiersByPlan !== 'undefined' ? studentTiersByPlan : {}; %>
            <div class="student-tier-grid">
              <% plans.forEach(plan => { %>
                <% const tiers = stByPlan[plan.plan_id] || []; %>
                <section class="student-tier-plan is-collapsed" data-tier-plan>
                  <div class="student-tier-header">
                    <div>
                      <h3 class="student-tier-title"><%= plan.plan_name %></h3>
                      <p class="student-tier-summary"><%= tiers.length %> <%= tiers.length === 1 ? 'tier' : 'tiers' %> configured</p>
                    </div>
                    <button type="button" class="student-tier-toggle" data-tier-toggle aria-expanded="false">Expand</button>
                  </div>

                  <div class="student-tier-body">
                    <form action="/admin/saveStudentTiers" method="POST" class="student-tier-plan-form">
                      <input type="hidden" name="plan_id" value="<%= plan.plan_id %>" />
                      <% if (tiers.length > 0) { %>
                        <div class="student-tier-list">
                          <% tiers.forEach(tier => { %>
                            <div class="student-tier-row">
                              <div class="student-tier-form">
                                <input type="hidden" name="tier_id" value="<%= tier.id %>" />
                                <div class="student-tier-field">
                                  <span class="student-tier-field-label">Student Range</span>
                                  <div class="student-tier-range">
                                    <input type="number" name="min_students" value="<%= tier.min_students %>" min="0" class="student-tier-mini-input" required />
                                    <span class="student-tier-separator">–</span>
                                    <input type="number" name="max_students" value="<%= tier.max_students != null ? tier.max_students : '' %>" min="0" placeholder="∞" class="student-tier-mini-input" />
                                    <span class="student-tier-text-muted">students</span>
                                  </div>
                                </div>
                                <div class="student-tier-field">
                                  <span class="student-tier-field-label">Adjustment %</span>
                                  <div class="student-tier-price">
                                    <input type="number" name="adjustment_percentage" value="<%= tier.adjustment_percentage != null ? tier.adjustment_percentage : 0 %>" step="0.01" class="student-tier-mini-input" required />
                                    <span class="student-tier-text-muted">%</span>
                                  </div>
                                  <span class="student-tier-text-muted"><%= tier.priceUsdDisplay %>/mo preview<% if (currencyProfile && currencyProfile.userCurrency !== 'USD') { %> • ≈ <%= tier.localizedPriceDisplay %><% } %></span>
                                </div>
                              </div>
                              <div class="student-tier-row-menu">
                                <details>
                                  <summary title="More actions">:</summary>
                                  <div class="student-tier-row-menu-panel">
                                    <button type="button" class="student-tier-delete" title="Delete" data-delete-tier-id="<%= tier.id %>">Remove</button>
                                  </div>
                                </details>
                              </div>
                            </div>
                          <% }); %>
                        </div>
                      <% } else { %>
                        <p class="student-tier-empty">No student tiers yet. Add a size range and percentage adjustment for this plan.</p>
                      <% } %>

                      <div class="student-tier-drafts" data-student-tier-drafts>
                        <div class="student-tier-add" data-student-tier-draft-row>
                          <div class="student-tier-field">
                            <span class="student-tier-field-label">New Range</span>
                            <div class="student-tier-range">
                              <input type="number" name="new_min_students" placeholder="Min" min="0" class="student-tier-mini-input" />
                              <span class="student-tier-separator">–</span>
                              <input type="number" name="new_max_students" placeholder="∞" min="0" class="student-tier-mini-input" />
                              <span class="student-tier-text-muted">students</span>
                            </div>
                          </div>
                          <div class="student-tier-field">
                            <span class="student-tier-field-label">Adjustment %</span>
                            <div class="student-tier-price">
                              <input type="number" name="new_adjustment_percentage" step="0.01" placeholder="-10 or 20" class="student-tier-mini-input" />
                              <span class="student-tier-text-muted">%</span>
                            </div>
                            <span class="student-tier-text-muted">Example: -10 means 10% less, 20 means 20% more.</span>
                          </div>
                              <div class="student-tier-draft-actions">
                                <button type="button" class="student-tier-remove-draft" data-remove-tier-row>Remove</button>
                              </div>
                        </div>
                      </div>

                      <button type="button" class="student-tier-add-row-button" data-add-tier-row>+ Add another range</button>

                      <button type="submit" class="student-tier-save-all">Save All</button>
                    </form>
                  </div>
                </section>
              <% }) %>
            </div>
          </div>
        </div>
    </div>

    <script>
      document.addEventListener("DOMContentLoaded", function () {
        function confirmAction(message, callback) {
          if (confirm(message)) {
            callback();
          }
        }

        const tierMenus = document.querySelectorAll('.student-tier-row-menu details');
        tierMenus.forEach((menu) => {
          menu.addEventListener('toggle', function () {
            if (!this.open) return;
            tierMenus.forEach((otherMenu) => {
              if (otherMenu !== this) {
                otherMenu.open = false;
              }
            });
          });
        });

        document.addEventListener('click', function (event) {
          if (event.target.closest('.student-tier-row-menu')) {
            return;
          }
          tierMenus.forEach((menu) => {
            menu.open = false;
          });
        });

        document.querySelectorAll('[data-delete-tier-id]').forEach((button) => {
          button.addEventListener('click', function () {
            const tierId = this.getAttribute('data-delete-tier-id');
            if (!tierId) return;
            if (!confirm('Delete this tier?')) return;

            const deleteForm = document.createElement('form');
            deleteForm.method = 'POST';
            deleteForm.action = '/admin/deleteStudentTier';

            const tierInput = document.createElement('input');
            tierInput.type = 'hidden';
            tierInput.name = 'tier_id';
            tierInput.value = tierId;
            deleteForm.appendChild(tierInput);

            document.body.appendChild(deleteForm);
            deleteForm.submit();
          });
        });

        document.querySelectorAll('[data-add-tier-row]').forEach((button) => {
          button.addEventListener('click', function () {
            const form = this.closest('.student-tier-plan-form');
            const draftsContainer = form ? form.querySelector('[data-student-tier-drafts]') : null;
            const firstDraft = draftsContainer ? draftsContainer.querySelector('[data-student-tier-draft-row]') : null;
            if (!draftsContainer || !firstDraft) return;

            const clone = firstDraft.cloneNode(true);
            clone.querySelectorAll('input').forEach((input) => {
              input.value = '';
            });
            draftsContainer.appendChild(clone);
          });
        });

        document.addEventListener('click', function (event) {
          const removeDraftButton = event.target.closest('[data-remove-tier-row]');
          if (!removeDraftButton) {
            return;
          }

          const draftRow = removeDraftButton.closest('[data-student-tier-draft-row]');
          const draftsContainer = draftRow ? draftRow.parentElement : null;
          if (!draftRow || !draftsContainer) {
            return;
          }

          const allDraftRows = draftsContainer.querySelectorAll('[data-student-tier-draft-row]');
          if (allDraftRows.length <= 1) {
            draftRow.querySelectorAll('input').forEach((input) => {
              input.value = '';
            });
            return;
          }

          draftRow.remove();
        });

        document.querySelectorAll("[data-tier-toggle]").forEach((button) => {
          button.addEventListener("click", function () {
            const card = this.closest("[data-tier-plan]");
            const isCollapsed = card.classList.toggle("is-collapsed");
            this.textContent = isCollapsed ? "Expand" : "Minimize";
            this.setAttribute("aria-expanded", String(!isCollapsed));
          });
        });

        document.querySelectorAll("[data-feature-toggle]").forEach((button) => {
          button.addEventListener("click", function () {
            const card = this.closest("[data-feature-pricing]");
            const isCollapsed = card.classList.toggle("is-collapsed");
            this.textContent = isCollapsed ? "Expand" : "Minimize";
            this.setAttribute("aria-expanded", String(!isCollapsed));
          });
        });

        document.querySelectorAll("[data-manage-toggle]").forEach((button) => {
          button.addEventListener("click", function () {
            const card = this.closest("[data-manage-plan]");
            const isCollapsed = card.classList.toggle("is-collapsed");
            this.textContent = isCollapsed ? "Expand" : "Minimize";
            this.setAttribute("aria-expanded", String(!isCollapsed));
          });
        });

        document.querySelectorAll("[data-manage-section-toggle]").forEach((button) => {
          button.addEventListener("click", function () {
            const card = this.closest("[data-manage-section]");
            const isCollapsed = card.classList.toggle("is-collapsed");
            this.textContent = isCollapsed ? "Expand" : "Minimize";
            this.setAttribute("aria-expanded", String(!isCollapsed));
          });
        });

        document.querySelectorAll("[data-student-tiers-toggle]").forEach((button) => {
          button.addEventListener("click", function () {
            const card = this.closest("[data-student-tiers-section]");
            const isCollapsed = card.classList.toggle("is-collapsed");
            this.textContent = isCollapsed ? "Expand" : "Minimize";
            this.setAttribute("aria-expanded", String(!isCollapsed));
          });
        });

        document.querySelectorAll("[data-settings-toggle]").forEach((button) => {
          button.addEventListener("click", function () {
            const card = this.closest("[data-settings-card]");
            const isCollapsed = card.classList.toggle("is-collapsed");
            this.textContent = isCollapsed ? "Expand" : "Minimize";
            this.setAttribute("aria-expanded", String(!isCollapsed));
          });
        });

        // Recalculate All Plan Totals
        document.getElementById("recalculate-totals-btn").addEventListener("click", function () {
          confirmAction(
            "Are you sure you want to recalculate all plan total costs? This will update the totals based on current feature prices.",
            () => {
              fetch("/admin/recalculateAllPlanTotals", {
                method: "POST",
                headers: { "Content-Type": "application/json" },
              })
                .then(() => location.reload())
                .catch((error) => {
                  console.error("Error:", error);
                  alert("Failed to recalculate plan totals. Please try again.");
                });
            }
          );
        });

        // Remove Feature from a Plan
        document.querySelectorAll(".remove-feature").forEach((element) => {
          element.addEventListener("click", function () {
            const planId = this.dataset.planid;
            const featureId = this.dataset.featureid;

            confirmAction(
              "Are you sure you want to remove this feature from the plan? Logs are kept as history for this page.",
              () => {
                fetch("/admin/removeFeatureFromPlan", {
                  method: "POST",
                  headers: { "Content-Type": "application/json" },
                  body: JSON.stringify({ planId, featureId }),
                })
                  .then((response) => response.json())
                  .then((data) => {
                    if (data.success) {
                      this.closest("li").remove(); // Remove from UI
                      updateTotalCost(planId, -parseFloat(data.featurePrice));
                    } else {
                      alert("Failed to remove feature.");
                    }
                  })
                  .catch((error) => console.error("Error:", error));
              }
            );
          });
        });

        // Remove Feature from Database (Feature List)
        document
          .querySelectorAll(".remove-feature-from-list")
          .forEach((element) => {
            element.addEventListener("click", function () {
              const featureId = this.dataset.featureid;

              confirmAction(
                "Are you sure you want to delete this feature permanently? Logs are kept as history for this page.",
                () => {
                  fetch("/admin/deleteFeature", {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify({ featureId }),
                  })
                    .then((response) => response.json())
                    .then((data) => {
                      if (data.success) {
                        this.closest("li").remove(); // Remove from UI
                      } else {
                        alert("Failed to delete feature.");
                      }
                    })
                    .catch((error) => console.error("Error:", error));
                }
              );
            });
          });

        // Add Feature to Plan
        document.querySelectorAll(".add-feature").forEach((element) => {
          element.addEventListener("click", function () {
            const planId = this.dataset.planid;
            const featureSelect = document.querySelector(
              `.feature-select[data-planid='${planId}']`
            );
            const featureId = featureSelect.value;

            confirmAction(
              "Are you sure you want to add this feature to the plan? Logs are kept as history for this page.",
              () => {
                fetch("/admin/addFeatureToPlan", {
                  method: "POST",
                  headers: { "Content-Type": "application/json" },
                  body: JSON.stringify({ planId, featureId }),
                })
                  .then((response) => response.json())
                  .then((data) => {
                    if (data.success) {
                      location.reload(); // Reload to reflect change
                    } else {
                      alert("Failed to add feature.");
                    }
                  })
                  .catch((error) => console.error("Error:", error));
              }
            );
          });
        });

        // Delete a Plan
        document.querySelectorAll(".delete-btn").forEach((element) => {
          element.addEventListener("click", function () {
            const planId = this.dataset.planid;

            confirmAction(
              "Are you sure you want to delete this plan permanently? Logs are kept as history for this page.",
              () => {
                fetch("/admin/deletePlan", {
                  method: "POST",
                  headers: { "Content-Type": "application/json" },
                  body: JSON.stringify({ planId }),
                })
                  .then((response) => response.json())
                  .then((data) => {
                    if (data.success) {
                      location.reload();
                    } else {
                      alert("Failed to delete plan.");
                    }
                  })
                  .catch((error) => console.error("Error:", error));
              }
            );
          });
        });

        // Toggle Plan Status (Activate/Deactivate)
        document.querySelectorAll(".toggle-status").forEach((element) => {
          element.addEventListener("change", function () {
            const planId = this.dataset.planid;
            const action = this.checked ? "activate" : "deactivate";

            confirmAction(
              `Are you sure you want to ${action} this plan? Logs are kept as history for this page.`,
              () => {
                fetch("/admin/togglePlanStatus", {
                  method: "POST",
                  headers: { "Content-Type": "application/json" },
                  body: JSON.stringify({ planId }),
                })
                  .then(() => location.reload())
                  .catch((error) => console.error("Error:", error));
              }
            );
          });
        });

        // Update Plan Description
        document.querySelectorAll(".update-btn").forEach((element) => {
          element.addEventListener("click", function () {
            const planId = this.dataset.planid;
            const description = document.querySelector(
              `.plan-description[data-planid='${planId}']`
            ).value;

            confirmAction(
              "Are you sure you want to update this plan's description? Logs are kept as history for this page.",
              () => {
                fetch("/admin/updatePlanDescription", {
                  method: "POST",
                  headers: { "Content-Type": "application/json" },
                  body: JSON.stringify({ planId, description }),
                })
                  .then(() => location.reload())
                  .catch((error) => console.error("Error:", error));
              }
            );
          });
        });

        // Update Total Cost dynamically
        function updateTotalCost(planId, priceChange) {
          const totalCostElement = document.querySelector(
            `#total-cost-${planId}`
          );
          if (totalCostElement) {
            let currentTotal = parseFloat(totalCostElement.innerText);
            totalCostElement.innerText = (currentTotal + priceChange).toFixed(
              2
            );
          }
        }
      });

      // Billing Period Discount Save Handlers
      document.querySelectorAll('.bp-save-btn').forEach(function(btn) {
        btn.addEventListener('click', function() {
          const key = this.dataset.key;
          const row = document.querySelector('tr[data-period-key="' + key + '"]');
          if (!row) return;
          const discount = row.querySelector('.bp-discount').value;
          const active = row.querySelector('.bp-active').checked;
          const statusMsg = document.querySelector('.bp-status-msg');

          fetch('/admin/updateBillingPeriod', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ period_key: key, discount_percentage: discount, is_active: String(active) })
          })
            .then(function(r) { return r.json(); })
            .then(function(data) {
              if (data.success) {
                statusMsg.textContent = key.replace(/_/g, ' ') + ' updated: ' + data.discount + '% discount, ' + (data.is_active ? 'active' : 'inactive');
                statusMsg.style.color = '#059669';
              } else {
                statusMsg.textContent = 'Failed: ' + (data.message || 'Unknown error');
                statusMsg.style.color = '#dc2626';
              }
              statusMsg.style.display = 'block';
              setTimeout(function() { statusMsg.style.display = 'none'; }, 4000);
            })
            .catch(function() {
              statusMsg.textContent = 'Network error. Please try again.';
              statusMsg.style.color = '#dc2626';
              statusMsg.style.display = 'block';
            });
        });
      });
    </script>
  </body>
</html>
