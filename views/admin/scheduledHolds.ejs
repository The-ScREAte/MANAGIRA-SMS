<%# Admin › Subscription Cancellation (adminController.scheduledHoldsPage): schools whose subscription
    ends on a set day, and schools on hold because it ended. Only Managira cancels a subscription
    (Organizations › a school's ⋯ menu; utils/subscriptionCancel.js); undo it here or there. %>
<%
  const _date = (d) => d ? new Date(d).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric', timeZone: 'UTC' }) : '';
  const _who = (org) => [org.first_name, org.last_name].filter(Boolean).join(' ') || org.email || '';
%>
<link rel="stylesheet" href="<%= assetUrl('/css/adminHubs.css') %>" />

<div class="ah" data-ap-page="subscription-cancellation">
  <%- include('../partials/flash') %>

  <nav class="ah-crumbs" aria-label="Breadcrumb">
    <a href="/admin">Admin</a><i class="fa-solid fa-chevron-right" aria-hidden="true" style="font-size:.6rem"></i><span>Subscription Cancellation</span>
  </nav>

  <header class="ah-head">
    <div>
      <h1 class="ah-head__title">Subscription Cancellation</h1>
      <p class="ah-head__sub">Schools can't cancel from their own Settings: they ask Managira support. To cancel a school's subscription, open <a href="/admin/hubs">Organizations</a> and choose <strong>Cancel subscription</strong> in its ⋯ menu. The school keeps its access until the end of the period it paid for.</p>
    </div>
  </header>

  <section class="ah-card" aria-label="Ending soon">
    <div class="ah-card__bar"><h2 class="ah-card__title">Ending on a set day</h2></div>
    <% if (pending.length) { %>
      <div class="ah-scroll">
        <table class="ah-table">
          <thead><tr><th>School</th><th>Access ends</th><th class="ah-num"></th></tr></thead>
          <tbody>
            <% pending.forEach((org) => { %>
              <tr>
                <td><strong><%= org.organization_name %></strong><span class="ah-sub"><%= _who(org) %></span></td>
                <td><%= _date(org.scheduled_hold_date) %></td>
                <td class="ah-actions-cell">
                  <form action="/admin/organizations/<%= org.organization_id %>/undo-cancellation" method="POST" data-ah-ajax data-ah-ask-ok="Undo cancellation" data-ah-ask="Undo the cancellation for <%= org.organization_name %>? Its subscription continues and saved cards are charged again as usual.">
                    <input type="hidden" name="back" value="holds" />
                    <button type="submit" class="ah-btn ah-btn--soft ah-btn--sm"><i class="fa-solid fa-rotate-left" aria-hidden="true"></i> Undo</button>
                  </form>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } else { %>
      <div class="ah-empty"><i class="fa-solid fa-calendar-check" aria-hidden="true"></i>No subscription is set to end.</div>
    <% } %>
  </section>

  <section class="ah-card" aria-label="Ended">
    <div class="ah-card__bar"><h2 class="ah-card__title">Ended (on hold)</h2></div>
    <% if (ended.length) { %>
      <div class="ah-scroll">
        <table class="ah-table">
          <thead><tr><th>School</th><th>On hold since</th><th class="ah-num"></th></tr></thead>
          <tbody>
            <% ended.forEach((org) => { %>
              <tr>
                <td><strong><%= org.organization_name %></strong><span class="ah-sub"><%= _who(org) %></span></td>
                <td><%= _date(org.on_hold_at) || '—' %></td>
                <td class="ah-actions-cell">
                  <form action="/admin/organizations/<%= org.organization_id %>/undo-cancellation" method="POST" data-ah-ajax data-ah-ask-ok="Undo cancellation" data-ah-ask="Bring <%= org.organization_name %> back? Everyone can sign in again and saved cards are charged again as usual.">
                    <input type="hidden" name="back" value="holds" />
                    <button type="submit" class="ah-btn ah-btn--soft ah-btn--sm"><i class="fa-solid fa-rotate-left" aria-hidden="true"></i> Undo</button>
                  </form>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } else { %>
      <div class="ah-empty"><i class="fa-solid fa-school" aria-hidden="true"></i>No school is on hold after a cancellation.</div>
    <% } %>
  </section>

  <%- include('partials/hubAdminDialogs') %>
</div>
