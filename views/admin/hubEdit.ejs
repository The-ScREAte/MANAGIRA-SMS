<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Edit Hub - Admin</title>
  <link rel="stylesheet" href="/css/admin.css">
  <style>
    :root {
      --primary: #01535b;
      --primary-hover: #014a51;
      --text-primary: #111827;
      --text-secondary: #6b7280;
      --border: #e5e7eb;
      --bg: #f9fafb;
    }

    .edit-container {
      max-width: 680px;
      margin: 32px auto;
      padding: 28px;
      background: white;
      border-radius: 10px;
      border: 1px solid var(--border);
    }

    h1 { font-size: 1.5rem; color: var(--text-primary); margin-bottom: 4px; }
    .subtitle { color: var(--text-secondary); margin-bottom: 24px; font-size: 0.9rem; }

    .form-section { margin-bottom: 28px; }

    .form-section h2 {
      font-size: 1.05rem;
      color: var(--text-primary);
      margin-bottom: 14px;
      padding-bottom: 8px;
      border-bottom: 1px solid var(--border);
    }

    .form-group { margin-bottom: 16px; }

    .form-label {
      display: block;
      font-weight: 600;
      color: var(--text-primary);
      margin-bottom: 6px;
      font-size: 0.85rem;
    }

    .form-label.required::after { content: " *"; color: #dc2626; }

    .form-input, .form-select, .form-textarea {
      width: 100%;
      padding: 10px 14px;
      border: 1px solid var(--border);
      border-radius: 8px;
      font-size: 0.95rem;
      font-family: inherit;
      transition: border-color 0.2s;
    }

    .form-input:focus, .form-select:focus, .form-textarea:focus {
      outline: none;
      border-color: var(--primary);
      box-shadow: 0 0 0 3px rgba(1,83,91,0.06);
    }

    .form-input:disabled {
      background: var(--bg);
      color: var(--text-secondary);
      cursor: not-allowed;
    }

    .form-hint { font-size: 0.8rem; color: var(--text-secondary); margin-top: 4px; }

    .checkbox-group { display: flex; align-items: center; gap: 8px; }

    .checkbox-group input[type="checkbox"] { width: 18px; height: 18px; cursor: pointer; }

    .form-actions {
      display: flex;
      gap: 12px;
      justify-content: flex-end;
      margin-top: 24px;
      padding-top: 20px;
      border-top: 1px solid var(--border);
    }

    .btn {
      padding: 10px 24px;
      border: none;
      border-radius: 8px;
      font-size: 0.9rem;
      font-weight: 600;
      cursor: pointer;
      transition: background 0.15s;
      text-decoration: none;
      display: inline-block;
      font-family: inherit;
    }

    .btn-primary { background: var(--primary); color: white; }
    .btn-primary:hover { background: var(--primary-hover); }
    .btn-secondary { background: #f3f4f6; color: var(--text-primary); }
    .btn-secondary:hover { background: #e5e7eb; }

    .info-box {
      background: var(--bg);
      border: 1px solid var(--border);
      padding: 12px 16px;
      border-radius: 8px;
      margin-bottom: 20px;
      color: var(--text-secondary);
      font-size: 0.85rem;
    }

    .info-box strong { color: var(--text-primary); }
  </style>
</head>
<body>
  <%- include('../partials/flash') %>

  <div class="edit-container">
    <h1>Edit Hub</h1>
    <p class="subtitle">Update hub information and settings</p>

    <div class="info-box">
      <strong>Hub ID:</strong> <%= hub.hub_id %> &middot;
      <strong>Created:</strong> <%= new Date(hub.created_at).toLocaleDateString() %>
    </div>

    <form action="/admin/hubs/<%= hub.hub_id %>/edit" method="POST">
      <div class="form-section">
        <h2>Hub Information</h2>
        <div class="form-group">
          <label class="form-label required" for="hubName">Hub Name</label>
          <input type="text" name="hubName" id="hubName" class="form-input" value="<%= hub.hub_name %>" required>
        </div>
        <div class="form-group">
          <label class="form-label required" for="hubNickname">Hub Nickname</label>
          <input type="text" name="hubNickname" id="hubNickname" class="form-input" value="<%= hub.hub_nickname %>" pattern="[a-z0-9]+" minlength="3" maxlength="20" required>
          <p class="form-hint">URL: <strong><%= hub.hub_nickname %>.managira.com</strong></p>
        </div>
        <div class="form-group">
          <label class="form-label">Hub Email</label>
          <input type="email" class="form-input" value="<%= hub.hub_email %>" disabled>
          <p class="form-hint">Email cannot be changed</p>
        </div>
      </div>

      <div class="form-section">
        <h2>Contact Person</h2>
        <div class="form-group">
          <label class="form-label required" for="firstName">First Name</label>
          <input type="text" name="firstName" id="firstName" class="form-input" value="<%= hub.first_name %>" required>
        </div>
        <div class="form-group">
          <label class="form-label required" for="lastName">Last Name</label>
          <input type="text" name="lastName" id="lastName" class="form-input" value="<%= hub.last_name %>" required>
        </div>
        <div class="form-group">
          <label class="form-label" for="hubPhone">Phone</label>
          <input type="text" name="hubPhone" id="hubPhone" class="form-input" value="<%= hub.hub_phone || '' %>">
        </div>
        <div class="form-group">
          <label class="form-label" for="hubAddress">Address</label>
          <input type="text" name="hubAddress" id="hubAddress" class="form-input" value="<%= hub.hub_address || '' %>">
        </div>
      </div>

      <div class="form-section">
        <h2>Configuration</h2>
        <div class="form-group">
          <label class="form-label" for="planId">Subscription Plan</label>
          <select name="planId" id="planId" class="form-select">
            <option value="">No plan</option>
            <% plans.forEach(plan => { %>
              <option value="<%= plan.id %>" <%= hub.plan_id === plan.id ? 'selected' : '' %>>
                <%= plan.plan_name %> - $<%= plan.total_cost || 0 %>/mo
              </option>
            <% }); %>
          </select>
        </div>
        <div class="form-group">
          <label class="form-label required" for="maxOrganizations">Max Organizations</label>
          <input type="number" name="maxOrganizations" id="maxOrganizations" class="form-input" value="<%= hub.max_organizations %>" min="1" required>
        </div>
        <div class="form-group">
          <label class="form-label" for="contractStartDate">Hub Contract Start Date</label>
          <input type="date" name="contractStartDate" id="contractStartDate" class="form-input" value="<%= hub.contract_start_date ? new Date(hub.contract_start_date).toISOString().split('T')[0] : '' %>">
        </div>
        <div class="form-group">
          <label class="form-label" for="contractEndDate">Hub Contract End Date</label>
          <input type="date" name="contractEndDate" id="contractEndDate" class="form-input" value="<%= hub.contract_end_date ? new Date(hub.contract_end_date).toISOString().split('T')[0] : '' %>">
          <p class="form-hint">Member organizations stay active under this hub until the contract end date.</p>
        </div>
        <div class="form-group">
          <label class="form-label" for="hubFooterText">Footer Text</label>
          <textarea name="hubFooterText" id="hubFooterText" class="form-textarea" rows="3"><%= hub.hub_footer_text || '' %></textarea>
        </div>
        <div class="form-group">
          <div class="checkbox-group">
            <input type="checkbox" name="hubBrandingEnabled" id="hubBrandingEnabled" <%= hub.hub_branding_enabled ? 'checked' : '' %>>
            <label class="form-label" for="hubBrandingEnabled" style="margin:0;">Enable hub branding on member organizations</label>
          </div>
        </div>
      </div>

      <div class="form-actions">
        <a href="/admin/hubs" class="btn btn-secondary">Cancel</a>
        <button type="submit" class="btn btn-primary">Update Hub</button>
      </div>
    </form>
  </div>
</body>
</html>