<%
  const _hubs = Array.isArray(hubs) ? hubs : [];
  const _active = _hubs.filter((h) => !h.on_hold).length;
  const _hold = _hubs.filter((h) => h.on_hold).length;
  const _schools = _hubs.reduce((sum, h) => sum + (Number(h.org_count) || 0), 0);
  const _date = (d) => d ? new Date(d).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) : '';
  const _logo = (h) => h.logo_path && String(h.logo_path).trim() && !/\/(images\/)?hub-logos$/.test(h.logo_path) ? h.logo_path : '';
%>
<link rel="stylesheet" href="<%= assetUrl('/css/adminHubs.css') %>" />

<div class="ah">
  <%- include('../partials/flash') %>

  <nav class="ah-crumbs" aria-label="Breadcrumb">
    <a href="/admin">Admin</a><i class="fa-solid fa-chevron-right" aria-hidden="true" style="font-size:.6rem"></i><span>Hubs</span>
  </nav>

  <header class="ah-head">
    <div>
      <h1 class="ah-head__title">Hubs</h1>
      <p class="ah-head__sub">Groups of schools run together. Open a hub to see it exactly as its owner does.</p>
    </div>
    <div class="ah-head__actions">
      <a href="/admin" class="ah-btn"><i class="fa-solid fa-arrow-left" aria-hidden="true"></i> Admin</a>
      <a href="/admin/hubs/create" class="ah-btn ah-btn--primary"><i class="fa-solid fa-plus" aria-hidden="true"></i> New hub</a>
    </div>
  </header>

  <div class="ah-kpis">
    <div class="ah-kpi ah-kpi--teal"><span class="ah-kpi__icon"><i class="fa-solid fa-network-wired" aria-hidden="true"></i></span><div><div class="ah-kpi__label">Hubs</div><div class="ah-kpi__value"><%= _hubs.length %></div></div></div>
    <div class="ah-kpi ah-kpi--green"><span class="ah-kpi__icon"><i class="fa-solid fa-circle-check" aria-hidden="true"></i></span><div><div class="ah-kpi__label">Active</div><div class="ah-kpi__value"><%= _active %></div></div></div>
    <div class="ah-kpi ah-kpi--amber"><span class="ah-kpi__icon"><i class="fa-solid fa-pause" aria-hidden="true"></i></span><div><div class="ah-kpi__label">On hold</div><div class="ah-kpi__value"><%= _hold %></div></div></div>
    <div class="ah-kpi ah-kpi--blue"><span class="ah-kpi__icon"><i class="fa-solid fa-school" aria-hidden="true"></i></span><div><div class="ah-kpi__label">Schools in hubs</div><div class="ah-kpi__value"><%= _schools %></div></div></div>
  </div>

  <section class="ah-card" aria-label="All hubs">
    <div class="ah-card__bar">
      <h2 class="ah-card__title">All hubs</h2>
      <% if (_hubs.length > 1) { %>
        <label class="ah-search"><i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i><input type="search" placeholder="Search hubs…" aria-label="Search hubs" data-ah-filter /></label>
      <% } %>
    </div>

    <% if (_hubs.length) { %>
      <div class="ah-scroll">
        <table class="ah-table">
          <thead>
            <tr>
              <th>Hub</th>
              <th>Owner</th>
              <th>Plan</th>
              <th>Schools</th>
              <th>Status</th>
              <th class="ah-num">Actions</th>
            </tr>
          </thead>
          <tbody>
            <% _hubs.forEach((hub) => {
                 const max = Number(hub.max_organizations) || 0;
                 const count = Number(hub.org_count) || 0;
                 const pct = max ? Math.min(100, Math.round((count / max) * 100)) : 0;
                 const owner = [hub.first_name, hub.last_name].filter(Boolean).join(' ');
                 const logo = _logo(hub); %>
              <tr data-ah-row="<%= [hub.hub_name, hub.hub_nickname, owner, hub.hub_email].join(' ').toLowerCase() %>">
                <td>
                  <div class="ah-name">
                    <span class="ah-avatar"><% if (logo) { %><img src="<%= logo %>" alt="" onerror="this.remove()" /><% } else { %><%= (hub.hub_name || 'H').charAt(0).toUpperCase() %><% } %></span>
                    <div style="min-width:0">
                      <% if (hub.on_hold) { %>
                        <span class="ah-name__link"><%= hub.hub_name %></span>
                      <% } else { %>
                        <a class="ah-name__link" href="/admin/hub/<%= hub.hub_id %>" data-ah-open data-name="<%= hub.hub_name %>" data-kind="hub"><%= hub.hub_name %></a>
                      <% } %>
                      <span class="ah-sub"><%= hub.hub_nickname %>.managira.com</span>
                    </div>
                  </div>
                </td>
                <td>
                  <%= owner || '—' %>
                  <span class="ah-sub"><%= hub.hub_email %></span>
                </td>
                <td>
                  <%= hub.plan_name || 'No plan' %>
                  <span class="ah-sub"><%= hub.contract_end_date ? 'Ends ' + _date(hub.contract_end_date) : 'No end date' %></span>
                </td>
                <td>
                  <div class="ah-cap">
                    <a class="ah-cap__text" href="/admin/hubs/<%= hub.hub_id %>/organizations"><%= count %> of <%= max || '∞' %></a>
                    <% if (max) { %><div class="ah-cap__bar" aria-hidden="true"><span style="width:<%= pct %>%"></span></div><% } %>
                  </div>
                </td>
                <td>
                  <% if (hub.on_hold) { %><span class="ah-status ah-status--hold">On hold</span><% } else { %><span class="ah-status">Active</span><% } %>
                  <% if (!hub.has_password) { %><span class="ah-sub">Password not set</span><% } %>
                </td>
                <td class="ah-actions-cell">
                  <div class="ah-row-actions">
                    <% if (!hub.on_hold) { %>
                      <a class="ah-btn ah-btn--primary ah-btn--sm" href="/admin/hub/<%= hub.hub_id %>" data-ah-open data-name="<%= hub.hub_name %>" data-kind="hub"><i class="fa-solid fa-arrow-right-to-bracket" aria-hidden="true"></i> Open hub</a>
                    <% } %>
                    <a class="ah-btn ah-btn--sm" href="/admin/hubs/<%= hub.hub_id %>/organizations"><i class="fa-solid fa-school" aria-hidden="true"></i> Schools</a>
                    <a class="ah-btn ah-btn--sm" href="/admin/hubs/<%= hub.hub_id %>/edit"><i class="fa-solid fa-pen" aria-hidden="true"></i> Edit</a>
                    <button type="button" class="ah-btn ah-btn--sm" data-ah-password data-id="<%= hub.hub_id %>" data-name="<%= hub.hub_name %>" data-email="<%= hub.hub_email %>"><i class="fa-solid fa-key" aria-hidden="true"></i> Password</button>
                    <details class="ah-menu">
                      <summary class="ah-btn ah-btn--sm ah-btn--icon" aria-label="More actions for <%= hub.hub_name %>"><i class="fa-solid fa-ellipsis" aria-hidden="true"></i></summary>
                      <div class="ah-menu__list">
                        <% if (hub.on_hold) { %>
                          <form action="/admin/hubs/resume" method="POST">
                            <input type="hidden" name="hubId" value="<%= hub.hub_id %>">
                            <button type="submit" class="ah-menu__item"><i class="fa-solid fa-play" aria-hidden="true"></i> Resume hub</button>
                          </form>
                        <% } else { %>
                          <form action="/admin/hubs/hold" method="POST" data-ah-confirm="Put <%= hub.hub_name %> on hold? The owner won't be able to sign in until you resume it.">
                            <input type="hidden" name="hubId" value="<%= hub.hub_id %>">
                            <button type="submit" class="ah-menu__item"><i class="fa-solid fa-pause" aria-hidden="true"></i> Put on hold</button>
                          </form>
                        <% } %>
                        <div class="ah-menu__sep"></div>
                        <form action="/admin/hubs/delete" method="POST" data-ah-confirm="Delete <%= hub.hub_name %>? All of its schools will be put on hold and the owner will be emailed.">
                          <input type="hidden" name="hubId" value="<%= hub.hub_id %>">
                          <button type="submit" class="ah-menu__item ah-menu__item--danger"><i class="fa-solid fa-trash" aria-hidden="true"></i> Delete hub</button>
                        </form>
                      </div>
                    </details>
                  </div>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
      <div class="ah-empty" data-ah-noresults hidden><i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i>No hubs match your search.</div>
    <% } else { %>
      <div class="ah-empty">
        <i class="fa-solid fa-network-wired" aria-hidden="true"></i>
        <h3>No hubs yet</h3>
        <p>Create a hub to group schools under one owner.</p>
        <a href="/admin/hubs/create" class="ah-btn ah-btn--primary"><i class="fa-solid fa-plus" aria-hidden="true"></i> New hub</a>
      </div>
    <% } %>
  </section>

  <%- include('partials/hubAdminDialogs') %>
</div>
