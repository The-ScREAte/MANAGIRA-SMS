<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Manage Hubs - Admin</title>
  <link rel="stylesheet" href="/css/admin.css">
  <style>
    :root {
      --primary: #01535b;
      --primary-hover: #014a51;
      --text-primary: #111827;
      --text-secondary: #6b7280;
      --border: #e5e7eb;
      --bg: #f9fafb;
    }

    .hub-container {
      max-width: 1200px;
      margin: 32px auto;
      padding: 24px;
      background: white;
      border-radius: 10px;
      border: 1px solid var(--border);
    }

    .hub-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 24px;
    }

    .hub-header h1 { font-size: 1.5rem; color: var(--text-primary); margin: 0; }

    .btn-create {
      padding: 10px 20px;
      background: var(--primary);
      color: white;
      text-decoration: none;
      border-radius: 8px;
      font-weight: 600;
      font-size: 0.9rem;
      transition: background 0.15s;
    }

    .btn-create:hover { background: var(--primary-hover); }

    .table-wrapper { overflow-x: auto; }

    .hubs-table { width: 100%; border-collapse: collapse; }

    .hubs-table th, .hubs-table td {
      padding: 12px 16px;
      text-align: left;
      border-bottom: 1px solid var(--border);
      font-size: 0.9rem;
    }

    .hubs-table th {
      background: var(--bg);
      font-weight: 600;
      color: #475569;
      font-size: 0.78rem;
      text-transform: uppercase;
      letter-spacing: 0.3px;
    }

    .hubs-table tr:hover td { background: var(--bg); }

    .badge {
      display: inline-block;
      padding: 3px 10px;
      border-radius: 12px;
      font-size: 0.78rem;
      font-weight: 600;
    }

    .badge-active { background: #ecfdf5; color: #065f46; }
    .badge-hold { background: #fef3c7; color: #92400e; }
    .badge-deleted { background: #fef2f2; color: #991b1b; }

    .actions { display: flex; gap: 6px; flex-wrap: wrap; }

    .btn-action {
      padding: 5px 10px;
      border: none;
      border-radius: 6px;
      font-size: 0.8rem;
      font-weight: 600;
      cursor: pointer;
      transition: all 0.15s;
      text-decoration: none;
      display: inline-block;
      font-family: inherit;
    }

    .btn-edit { background: #eff6ff; color: #1e40af; }
    .btn-edit:hover { background: #dbeafe; }
    .btn-hold { background: #fef3c7; color: #92400e; }
    .btn-hold:hover { background: #fde68a; }
    .btn-delete { background: #fef2f2; color: #991b1b; }
    .btn-delete:hover { background: #fecaca; }
    .btn-view { background: #f0fdf4; color: #166534; }
    .btn-view:hover { background: #dcfce7; }

    .no-hubs { text-align: center; padding: 40px; color: var(--text-secondary); }

    .back-link {
      display: block;
      margin-top: 24px;
      text-align: center;
    }

    .back-link a {
      color: var(--primary);
      text-decoration: none;
      font-weight: 600;
      font-size: 0.9rem;
    }

    .back-link a:hover { text-decoration: underline; }

    @media (max-width: 768px) {
      .hub-header { flex-direction: column; gap: 12px; align-items: flex-start; }
      .table-wrapper { overflow-x: scroll; -webkit-overflow-scrolling: touch; }
      .hubs-table { min-width: 900px; }
      .actions { flex-direction: column; }
    }
  </style>
</head>
<body>
  <%- include('../partials/flash') %>

  <div class="hub-container">
    <div class="hub-header">
      <h1>Manage Hubs</h1>
      <a href="/admin/hubs/create" class="btn-create">+ Create New Hub</a>
    </div>

    <% if (hubs.length > 0) { %>
      <div class="table-wrapper">
        <table class="hubs-table">
          <thead>
            <tr>
              <th>Hub Name</th>
              <th>Contact</th>
              <th>Email</th>
              <th>Plan</th>
              <th>Organizations</th>
              <th>Status</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody>
            <% hubs.forEach(hub => { %>
              <tr>
                <td>
                  <strong><%= hub.hub_name %></strong><br>
                  <small style="color: var(--text-secondary);"><%= hub.hub_nickname %>.managira.com</small>
                </td>
                <td><%= hub.first_name %> <%= hub.last_name %></td>
                <td><%= hub.hub_email %></td>
                <td><%= hub.plan_name || 'No plan' %></td>
                <td><span class="badge badge-active"><%= hub.org_count %> / <%= hub.max_organizations %></span></td>
                <td>
                  <% if (hub.deleted) { %>
                    <span class="badge badge-deleted">Deleted</span>
                  <% } else if (hub.on_hold) { %>
                    <span class="badge badge-hold">On Hold</span>
                  <% } else { %>
                    <span class="badge badge-active">Active</span>
                  <% } %>
                </td>
                <td>
                  <div class="actions">
                    <a href="/admin/hubs/<%= hub.hub_id %>/edit" class="btn-action btn-edit">Edit</a>
                    <a href="/admin/hubs/<%= hub.hub_id %>/organizations" class="btn-action btn-view">Orgs</a>
                    <% if (!hub.on_hold && !hub.deleted) { %>
                      <form action="/admin/hubs/hold" method="POST" style="display:inline;" onsubmit="return confirm('Put this hub on hold?')">
                        <input type="hidden" name="hubId" value="<%= hub.hub_id %>">
                        <button type="submit" class="btn-action btn-hold">Hold</button>
                      </form>
                    <% } %>
                    <% if (hub.on_hold && !hub.deleted) { %>
                      <form action="/admin/hubs/resume" method="POST" style="display:inline;">
                        <input type="hidden" name="hubId" value="<%= hub.hub_id %>">
                        <button type="submit" class="btn-action btn-edit">Resume</button>
                      </form>
                    <% } %>
                    <% if (!hub.deleted) { %>
                      <form action="/admin/hubs/delete" method="POST" style="display:inline;" onsubmit="return confirm('Delete this hub?')">
                        <input type="hidden" name="hubId" value="<%= hub.hub_id %>">
                        <button type="submit" class="btn-action btn-delete">Delete</button>
                      </form>
                    <% } %>
                  </div>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    <% } else { %>
      <div class="no-hubs">
        <p>No hubs created yet. Click "Create New Hub" to get started.</p>
      </div>
    <% } %>

    <div class="back-link">
      <a href="/admin">&larr; Back to Admin Dashboard</a>
    </div>
  </div>
</body>
</html>