<div data-ahd-title="Grant API calls" data-ahd-sub="<%= request.organization_name %>">
  <form action="/admin/api-requests/<%= request.request_id %>/grant" method="POST" class="ahd-form">
    <section class="ahd-section">
      <p class="ahb-hint" style="margin:0 0 12px">Asked: <strong><%= Number(request.requested_per_minute).toLocaleString('en-US') %>/min</strong>, <strong><%= Number(request.requested_per_day).toLocaleString('en-US') %>/day</strong> (now <%= Number(request.current_per_minute).toLocaleString('en-US') %>/<%= Number(request.current_per_day).toLocaleString('en-US') %>). “<%= request.reason %>”</p>
      <div class="ahb-grid">
        <label class="ahb-field"><span class="ahb-label">Per minute</span><input type="text" inputmode="numeric" name="perMinute" class="ahb-input" value="<%= request.requested_per_minute %>" required /></label>
        <label class="ahb-field"><span class="ahb-label">Per day</span><input type="text" inputmode="numeric" name="perDay" class="ahb-input" value="<%= request.requested_per_day %>" required /></label>
      </div>
      <div class="ahb-grid">
        <label class="ahb-field">
          <span class="ahb-label">Monthly price</span>
          <span class="ahb-money"><span>$</span><input type="text" inputmode="decimal" name="monthlyPrice" class="ahb-input" value="<%= Number(request.current_price) > 0 ? Number(request.current_price).toFixed(2) : '' %>" placeholder="0.00" required /></span>
        </label>
        <label class="ahb-field"><span class="ahb-label">Note</span><input type="text" name="note" class="ahb-input" maxlength="1000" placeholder="Optional note to the school" /></label>
      </div>
    </section>
    <div class="ahd__foot">
      <button type="button" class="ah-btn" data-ahd-close>Cancel</button>
      <button type="submit" class="ah-btn ah-btn--primary">Grant</button>
    </div>
  </form>
</div>
