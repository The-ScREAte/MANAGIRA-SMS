<div data-ahd-title="Password" data-ahd-sub="For <%= hub.hub_name %> (<%= hub.hub_email %>). Pick one.">
  <div class="ahd-form">
    <form action="/admin/hubs/<%= hub.hub_id %>/send-reset" method="POST" class="ah-option">
      <p class="ah-option__title"><i class="fa-regular fa-envelope" aria-hidden="true"></i> Email them a reset link</p>
      <p class="ah-option__text">We send a secure link to <strong><%= hub.hub_email %></strong>. They choose their own password. The link works for 24 hours.</p>
      <button type="submit" class="ah-btn ah-btn--primary ah-btn--sm"><i class="fa-solid fa-paper-plane" aria-hidden="true"></i> Send reset link</button>
    </form>
    <form action="/admin/hubs/<%= hub.hub_id %>/set-password" method="POST" class="ah-option">
      <p class="ah-option__title"><i class="fa-solid fa-key" aria-hidden="true"></i> Set a new password now</p>
      <p class="ah-option__text">It works straight away at <%= loginUrl %>. Share it with them privately.</p>
      <div class="ah-pw">
        <input type="text" name="newPassword" minlength="8" required autocomplete="off" spellcheck="false" aria-label="New password" placeholder="At least 8 letters and numbers" data-ah-pw-input />
        <button type="button" class="ah-btn ah-btn--sm" data-ah-pw-generate title="Make a strong password"><i class="fa-solid fa-wand-magic-sparkles" aria-hidden="true"></i> Generate</button>
        <button type="button" class="ah-btn ah-btn--sm ah-btn--icon" data-ah-pw-copy title="Copy" aria-label="Copy password"><i class="fa-regular fa-copy" aria-hidden="true"></i></button>
      </div>
      <div style="margin-top:12px"><button type="submit" class="ah-btn ah-btn--primary ah-btn--sm"><i class="fa-solid fa-check" aria-hidden="true"></i> Save password</button></div>
    </form>
  </div>
</div>
