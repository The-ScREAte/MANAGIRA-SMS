<!DOCTYPE html>
<html lang="en" data-appearance="gray">
  <head>
    <link rel="stylesheet" href="/css/globalScale.css">
    <meta charset="UTF-8" />
    <meta name="viewport" content="<%= locals.viewportContent || 'width=device-width, initial-scale=1.0, maximum-scale=1.0' %>" />
    <title>Confirm password — Managira</title>
    <link rel="icon" href="/favicon.ico" type="image/x-icon" sizes="any" />
    <style>
      :root {
        --font-family: "Inter", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
        --primary: #01535b;
        --primary-hover: #014a51;
        --primary-light: rgba(1, 83, 91, 0.08);
        --text-primary: #1e293b;
        --text-secondary: #64748b;
        --border: #e2e8f0;
        --bg-page: #f8fafc;
        --bg-card: #ffffff;
      }
      * { box-sizing: border-box; margin: 0; padding: 0; }
      body {
        font-family: var(--font-family);
        background: var(--bg-page);
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 40px 20px;
        color: var(--text-primary);
      }
      .confirm-card {
        width: 100%;
        max-width: 420px;
        background: var(--bg-card);
        border: 1px solid var(--border);
        border-radius: 14px;
        box-shadow: 0 4px 24px rgba(0, 0, 0, 0.08), 0 1px 3px rgba(0, 0, 0, 0.04);
        padding: 28px 26px;
      }
      .confirm-logo {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        margin-bottom: 24px;
      }
      .confirm-logo img { width: 34px; height: 34px; border-radius: 8px; }
      .confirm-logo span { font-size: 1.15rem; font-weight: 800; color: var(--primary); }
      .confirm-header { text-align: center; margin-bottom: 20px; }
      .confirm-header h1 { font-size: 1.5rem; font-weight: 700; margin-bottom: 6px; }
      .confirm-header p { color: var(--text-secondary); font-size: 0.9rem; }
      .confirm-note {
        background: #ecfeff;
        border: 1px solid #a5f3fc;
        color: #155e75;
        border-radius: 10px;
        padding: 10px 14px;
        font-size: 0.85rem;
        margin-bottom: 18px;
      }
      .form-group { margin-bottom: 16px; }
      .form-label {
        display: block;
        font-weight: 600;
        font-size: 0.9rem;
        margin-bottom: 8px;
      }
      .form-input {
        width: 100%;
        padding: 14px 16px;
        border: 2px solid var(--border);
        border-radius: 10px;
        font-size: 1rem;
        font-family: inherit;
        background: var(--bg-card);
      }
      .form-input:focus {
        outline: none;
        border-color: var(--primary);
        box-shadow: 0 0 0 3px var(--primary-light);
      }
      .btn-primary {
        width: 100%;
        padding: 14px 24px;
        background: linear-gradient(135deg, var(--primary) 0%, #0a6d77 100%);
        color: #fff;
        border: none;
        border-radius: 10px;
        font-size: 1rem;
        font-weight: 600;
        cursor: pointer;
        margin-top: 4px;
        box-shadow: 0 2px 8px rgba(1, 83, 91, 0.25);
      }
      .btn-primary:hover { transform: translateY(-2px); box-shadow: 0 6px 20px rgba(1, 83, 91, 0.35); }
    </style>
    <%# The soft light look used across the app (public/js/appearance.js). %>
  <link rel="stylesheet" href="<%= assetUrl('/css/appearance.css') %>">
  <script src="<%= assetUrl('/js/appearance.js') %>" defer></script>
</head>
  <body>
    <div class="confirm-card">
      <div class="confirm-logo">
        <img src="/images/managira.png" alt="Managira" />
        <span>Managira Admin</span>
      </div>
      <div class="confirm-header">
        <h1>Confirm password</h1>
        <p>You're about to view another school's dashboard.</p>
      </div>
      <div class="confirm-note">🔒 Re-enter your password to continue — required once per school, per login.</div>
      <%- include('../partials/flash') %>
      <form action="/admin/confirm-password" method="POST">
        <div class="form-group">
          <label class="form-label" for="password">Your password</label>
          <input type="password" id="password" name="password" class="form-input" placeholder="Enter your password" required autocomplete="current-password" autofocus />
        </div>
        <input type="hidden" name="redirectUrl" value="<%= redirectUrl %>" />
        <button type="submit" class="btn-primary">Confirm</button>
      </form>
    </div>
  </body>
</html>
