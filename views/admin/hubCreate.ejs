<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Create Hub - Admin</title>
  <link rel="stylesheet" href="/css/admin.css">
  <style>
    :root {
      --primary: #01535b;
      --primary-hover: #014a51;
      --text-primary: #111827;
      --text-secondary: #6b7280;
      --border: #e5e7eb;
      --bg: #f9fafb;
    }

    .create-container {
      max-width: 680px;
      margin: 32px auto;
      padding: 28px;
      background: white;
      border-radius: 10px;
      border: 1px solid var(--border);
    }

    h1 { font-size: 1.5rem; color: var(--text-primary); margin-bottom: 4px; }
    .subtitle { color: var(--text-secondary); margin-bottom: 24px; font-size: 0.9rem; }

    .form-section { margin-bottom: 28px; }

    .form-section h2 {
      font-size: 1.05rem;
      color: var(--text-primary);
      margin-bottom: 14px;
      padding-bottom: 8px;
      border-bottom: 1px solid var(--border);
    }

    .form-group { margin-bottom: 16px; }

    .form-label {
      display: block;
      font-weight: 600;
      color: var(--text-primary);
      margin-bottom: 6px;
      font-size: 0.85rem;
    }

    .form-label.required::after { content: " *"; color: #dc2626; }

    .form-input, .form-select, .form-textarea {
      width: 100%;
      padding: 10px 14px;
      border: 1px solid var(--border);
      border-radius: 8px;
      font-size: 0.95rem;
      font-family: inherit;
      transition: border-color 0.2s;
    }

    .form-input:focus, .form-select:focus, .form-textarea:focus {
      outline: none;
      border-color: var(--primary);
      box-shadow: 0 0 0 3px rgba(1,83,91,0.06);
    }

    .form-hint { font-size: 0.8rem; color: var(--text-secondary); margin-top: 4px; }

    .form-actions {
      display: flex;
      gap: 12px;
      justify-content: flex-end;
      margin-top: 24px;
      padding-top: 20px;
      border-top: 1px solid var(--border);
    }

    .btn {
      padding: 10px 24px;
      border: none;
      border-radius: 8px;
      font-size: 0.9rem;
      font-weight: 600;
      cursor: pointer;
      transition: background 0.15s;
      text-decoration: none;
      display: inline-block;
      font-family: inherit;
    }

    .btn-primary { background: var(--primary); color: white; }
    .btn-primary:hover { background: var(--primary-hover); }
    .btn-secondary { background: #f3f4f6; color: var(--text-primary); }
    .btn-secondary:hover { background: #e5e7eb; }

    .info-box {
      background: var(--bg);
      border: 1px solid var(--border);
      padding: 12px 16px;
      border-radius: 8px;
      margin-bottom: 20px;
      color: var(--text-secondary);
      font-size: 0.85rem;
    }

    .info-box strong { color: var(--text-primary); }
  </style>
</head>
<body>
  <%- include('../partials/flash') %>

  <div class="create-container">
    <h1>Create New Hub</h1>
    <p class="subtitle">Set up a new Managira Hub to manage multiple organizations</p>

    <div class="info-box">
      <strong>Note:</strong> After creation, a setup email will be sent to the hub contact.
    </div>

    <form action="/admin/hubs/create" method="POST">
      <div class="form-section">
        <h2>Hub Information</h2>
        <div class="form-group">
          <label class="form-label required" for="hubName">Hub Name</label>
          <input type="text" name="hubName" id="hubName" class="form-input" placeholder="e.g., Ghana Education Hub" required>
        </div>
        <div class="form-group">
          <label class="form-label required" for="hubNickname">Hub Nickname</label>
          <input type="text" name="hubNickname" id="hubNickname" class="form-input" placeholder="e.g., ghanaedu" pattern="[a-z0-9]+" minlength="3" maxlength="20" required>
          <p class="form-hint">Lowercase letters and numbers only. Subdomain: <strong>nickname.managira.com</strong></p>
        </div>
        <div class="form-group">
          <label class="form-label required" for="hubEmail">Hub Email</label>
          <input type="email" name="hubEmail" id="hubEmail" class="form-input" placeholder="hub@example.com" required>
        </div>
      </div>

      <div class="form-section">
        <h2>Contact Person</h2>
        <div class="form-group">
          <label class="form-label required" for="firstName">First Name</label>
          <input type="text" name="firstName" id="firstName" class="form-input" required>
        </div>
        <div class="form-group">
          <label class="form-label required" for="lastName">Last Name</label>
          <input type="text" name="lastName" id="lastName" class="form-input" required>
        </div>
        <div class="form-group">
          <label class="form-label" for="hubPhone">Phone</label>
          <input type="text" name="hubPhone" id="hubPhone" class="form-input" placeholder="+233 123 456 789">
        </div>
        <div class="form-group">
          <label class="form-label" for="hubAddress">Address</label>
          <input type="text" name="hubAddress" id="hubAddress" class="form-input" placeholder="123 Main Street, City">
        </div>
      </div>

      <div class="form-section">
        <h2>Configuration</h2>
        <div class="form-group">
          <label class="form-label" for="planId">Subscription Plan</label>
          <select name="planId" id="planId" class="form-select">
            <option value="">No plan (assign later)</option>
            <% plans.forEach(plan => { %>
              <option value="<%= plan.id %>"><%= plan.plan_name %> - $<%= plan.total_cost || 0 %>/mo</option>
            <% }); %>
          </select>
        </div>
        <div class="form-group">
          <label class="form-label required" for="maxOrganizations">Max Organizations</label>
          <input type="number" name="maxOrganizations" id="maxOrganizations" class="form-input" value="5" min="1" required>
        </div>
        <div class="form-group">
          <label class="form-label" for="contractStartDate">Hub Contract Start Date</label>
          <input type="date" name="contractStartDate" id="contractStartDate" class="form-input">
        </div>
        <div class="form-group">
          <label class="form-label" for="contractEndDate">Hub Contract End Date</label>
          <input type="date" name="contractEndDate" id="contractEndDate" class="form-input">
          <p class="form-hint">Member organizations remain active under this hub contract until the end date.</p>
        </div>
        <div class="form-group">
          <label class="form-label" for="hubFooterText">Footer Text</label>
          <textarea name="hubFooterText" id="hubFooterText" class="form-textarea" rows="3" placeholder="Optional branding text for member organization footers"></textarea>
        </div>
      </div>

      <div class="form-actions">
        <a href="/admin/hubs" class="btn btn-secondary">Cancel</a>
        <button type="submit" class="btn btn-primary">Create Hub</button>
      </div>
    </form>
  </div>
</body>
</html>