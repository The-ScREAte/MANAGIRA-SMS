<style>
  .profile-page {
    max-width: 720px;
    margin: 32px auto;
    padding: 0 16px;
  }
  .profile-card {
    background: #fff;
    border: 1px solid #e5e7eb;
    border-radius: 14px;
    box-shadow: 0 6px 22px rgba(15, 23, 42, 0.06);
    overflow: hidden;
  }
  .profile-card__header {
    padding: 22px 26px;
    border-bottom: 1px solid #e5e7eb;
    display: flex;
    align-items: center;
    gap: 16px;
  }
  .profile-avatar-lg {
    width: 72px;
    height: 72px;
    border-radius: 50%;
    background: linear-gradient(135deg, #01535b, #047a85);
    color: #fff;
    font-weight: 700;
    font-size: 1.5rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 4px 14px rgba(1, 83, 91, 0.3);
    overflow: hidden;
    flex-shrink: 0;
  }
  .profile-avatar-lg img { width: 100%; height: 100%; object-fit: cover; }
  .profile-card__title { margin: 0; font-size: 1.3rem; color: #0f172a; }
  .profile-card__role { margin: 2px 0 0; font-size: 0.88rem; color: #64748b; }
  .profile-card__body { padding: 22px 26px; }

  .flash-stack { margin: 0 0 14px; padding: 0; list-style: none; }
  .flash-stack li {
    padding: 10px 14px;
    border-radius: 8px;
    margin-bottom: 8px;
    font-size: 0.9rem;
  }
  .flash-stack .flash-success { background: #dcfce7; color: #166534; }
  .flash-stack .flash-error   { background: #fee2e2; color: #991b1b; }

  .profile-form {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 14px;
  }
  .profile-form label {
    display: flex;
    flex-direction: column;
    gap: 4px;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: #64748b;
  }
  .profile-form input,
  .profile-form textarea {
    border: 1px solid #d1d5db;
    border-radius: 8px;
    padding: 10px 12px;
    font-size: 0.95rem;
    color: #0f172a;
    font-family: inherit;
  }
  .profile-form textarea { min-height: 110px; resize: vertical; line-height: 1.45; }
  .profile-form input[type="file"] { padding: 8px; background: #f9fafb; }
  .profile-form input:disabled { background: #f3f4f6; color: #6b7280; }
  .profile-form .full { grid-column: 1 / -1; }
  .profile-form .actions {
    grid-column: 1 / -1;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 10px;
    margin-top: 6px;
  }
  .btn-save {
    background: #01535b;
    color: #fff;
    border: 0;
    border-radius: 8px;
    padding: 10px 20px;
    font-weight: 700;
    font-size: 0.95rem;
    cursor: pointer;
  }
  .btn-save:hover { background: #014a51; }
  .btn-back {
    color: #475569;
    text-decoration: none;
    font-size: 0.9rem;
    font-weight: 600;
  }
  .btn-back:hover { color: #0f172a; }
  @media (max-width: 600px) {
    .profile-form { grid-template-columns: 1fr; }
  }

  /* Notifications */
  .notif-card { margin-top: 18px; }
  .notif-card .profile-card__header h2 { margin: 0; font-size: 1.1rem; color: #0f172a; }
  .notif-list { display: flex; flex-direction: column; gap: 10px; margin: 0 0 16px; padding: 0; list-style: none; }
  .notif-item {
    display: flex; align-items: flex-start; gap: 12px;
    padding: 12px 14px; border: 1px solid #e5e7eb; border-radius: 10px;
    background: #f9fafb; transition: background .15s, border-color .15s;
  }
  .notif-item:hover { border-color: #01535b; background: #f0fdfa; }
  .notif-item input[type="checkbox"] {
    margin-top: 4px;
    width: 18px; height: 18px;
    accent-color: #01535b; flex-shrink: 0; cursor: pointer;
  }
  .notif-text { flex: 1; }
  .notif-label { font-weight: 600; color: #0f172a; font-size: 0.93rem; display: block; }
  .notif-desc { font-size: 0.83rem; color: #64748b; margin-top: 2px; line-height: 1.4; }
  .notif-empty {
    padding: 14px; border: 1px dashed #d1d5db; border-radius: 10px;
    color: #64748b; font-size: 0.9rem; text-align: center; background: #fafafa;
  }
</style>

<%
  const _initial = (profile && profile.first_name) ? profile.first_name.charAt(0).toUpperCase() : '?';
  const _avatarUrl = profile && profile.profile_image_url ? profile.profile_image_url : '';
  const _bio = profile && profile.org_role_description ? profile.org_role_description : '';
%>

<div class="profile-page">
  <div class="profile-card">
    <div class="profile-card__header">
      <div class="profile-avatar-lg">
        <% if (_avatarUrl) { %>
          <img src="<%= _avatarUrl %>" alt="<%= profile.first_name %> <%= profile.last_name %>">
        <% } else { %><%= _initial %><% } %>
      </div>
      <div>
        <h1 class="profile-card__title"><%= profile.first_name %> <%= profile.last_name %></h1>
        <p class="profile-card__role"><%= profile.email %></p>
      </div>
    </div>

    <div class="profile-card__body">
      <% if (messages && (messages.success || messages.error)) { %>
        <ul class="flash-stack">
          <% if (messages.success) { (Array.isArray(messages.success) ? messages.success : [messages.success]).forEach(function(m){ %>
            <li class="flash-success"><%= m %></li>
          <% }); } %>
          <% if (messages.error) { (Array.isArray(messages.error) ? messages.error : [messages.error]).forEach(function(m){ %>
            <li class="flash-error"><%= m %></li>
          <% }); } %>
        </ul>
      <% } %>

      <form action="/admin/profile" method="POST" class="profile-form" autocomplete="off" enctype="multipart/form-data" onsubmit="if (window.combinePhoneCountryCombos) window.combinePhoneCountryCombos(this);">
        <label>
          First name
          <input type="text" name="firstName" value="<%= profile.first_name || '' %>" required maxlength="255" />
        </label>
        <label>
          Last name
          <input type="text" name="lastName" value="<%= profile.last_name || '' %>" required maxlength="255" />
        </label>
        <label class="full">
          Phone number
          <div class="phone-combo" data-default-iso2="US">
            <select class="phone-dial-select"></select>
            <input type="tel" class="phone-local-input" name="phoneNumber" value="<%= profile.phone_number || '' %>" maxlength="50" />
          </div>
        </label>
        <label class="full">
          Email (read-only)
          <input type="email" value="<%= profile.email || '' %>" disabled />
        </label>
        <label class="full">
          Profile picture
          <input type="file" name="profileImage" accept="image/*" />
        </label>
        <label class="full">
          Bio (shown on the team org chart)
          <textarea name="bio" maxlength="600" placeholder="A short description about yourself, your role, and what you do…"><%= _bio %></textarea>
        </label>
        <div class="actions">
          <a href="/admin" class="btn-back">← Back to dashboard</a>
          <button type="submit" class="btn-save">💾 Save changes</button>
        </div>
      </form>
    </div>
  </div>

  <%
    const _prefs = (typeof notificationPrefs !== 'undefined' && Array.isArray(notificationPrefs)) ? notificationPrefs : [];
    const _saved = (typeof savedPrefs !== 'undefined' && savedPrefs) ? savedPrefs : {};
    const _isPlatform = (typeof isPlatformAdmin !== 'undefined') ? !!isPlatformAdmin : true;
  %>
  <div class="profile-card notif-card">
    <div class="profile-card__header">
      <div>
        <h2>📬 Email notifications</h2>
        <p class="profile-card__role" style="margin-top:4px;">Choose which non-essential emails you want to receive. Security, billing, and other transactional emails are always sent.</p>
      </div>
    </div>
    <div class="profile-card__body">
      <% if (_isPlatform || _prefs.length === 0) { %>
        <div class="notif-empty">
          No optional email preferences are available for platform admin accounts. All emails sent to platform staff are operational and required.
        </div>
      <% } else { %>
        <form action="/admin/profile/notifications" method="POST" autocomplete="off">
          <ul class="notif-list">
            <% _prefs.forEach(function(p) {
                 const checked = (p.key in _saved) ? !!_saved[p.key] : true; %>
              <li class="notif-item">
                <input type="checkbox" name="preferences" id="pref-<%= p.key %>" value="<%= p.key %>" <%= checked ? 'checked' : '' %> />
                <label class="notif-text" for="pref-<%= p.key %>">
                  <span class="notif-label"><%= p.label %></span>
                  <% if (p.description) { %><span class="notif-desc"><%= p.description %></span><% } %>
                </label>
              </li>
            <% }); %>
          </ul>
          <div style="display:flex;justify-content:flex-end;">
            <button type="submit" class="btn-save">💾 Save preferences</button>
          </div>
        </form>
      <% } %>
    </div>
  </div>
  <% if (locals.appearanceOwner) { %>
  <div class="profile-card notif-card">
    <div class="profile-card__header">
      <div>
        <h2>Appearance</h2>
        <p class="profile-card__role" style="margin-top:4px;">How Managira looks for you on every page.</p>
      </div>
    </div>
    <div class="profile-card__body"><%- include('../partials/appearancePicker') %></div>
  </div>
  <% } %>
</div>

<script src="<%= assetUrl('/js/dialCodes.js') %>"></script>
