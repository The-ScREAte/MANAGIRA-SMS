<style>
    .admin-edit-container {
        max-width: 600px;
        margin: 40px auto;
        padding: 30px;
        background: #fff;
        border-radius: 12px;
        box-shadow: 0 2px 12px rgba(0,0,0,0.08);
    }
    
    .admin-edit-container h1 {
        text-align: center;
        margin-bottom: 24px;
        color: #1e293b;
    }
    
    .form-group {
        margin-bottom: 18px;
    }
    
    .form-group label {
        display: block;
        font-weight: 600;
        margin-bottom: 6px;
        color: #374151;
    }
    
    .form-group input,
    .form-group select {
        width: 100%;
        padding: 10px 14px;
        border: 1px solid #d1d5db;
        border-radius: 8px;
        font-size: 15px;
    }
    
    .form-actions {
        display: flex;
        gap: 12px;
        margin-top: 24px;
    }
    
    .delete-form {
        margin-top: 16px;
    }

    .resend-form {
        margin-top: 12px;
    }
    .resend-form .btn-secondary {
        width: 100%;
        background: #0f766e;
        color: #fff;
        border: 0;
        padding: 12px 16px;
        border-radius: 8px;
        font-weight: 700;
        font-size: 15px;
        cursor: pointer;
    }
    .resend-form .btn-secondary:hover { background: #0d5e57; }
    .resend-note {
        margin: 8px 2px 0;
        font-size: 0.82rem;
        color: #64748b;
        line-height: 1.4;
    }
</style>

<main>
    <div class="admin-edit-container">
        <h1>Edit Admin User</h1>
        <%- include('../partials/flash') %>

        <!-- Form for Updating the Admin User -->
        <form action="/admin/editAdminUser/<%= admin.user_id %>" method="POST">
            <div class="form-group">
                <label for="firstName">First Name:</label>
                <input type="text" id="firstName" name="firstName" value="<%= admin.first_name %>" required>
            </div>
            <div class="form-group">
                <label for="lastName">Last Name:</label>
                <input type="text" id="lastName" name="lastName" value="<%= admin.last_name %>" required>
            </div>
            <div class="form-group">
                <label for="email">Email:</label>
                <input type="email" id="email" name="email" value="<%= admin.email %>" required>
            </div>
            <div class="form-group">
                <label for="accountType">Role:</label>
                <select id="accountType" name="accountType" required>
                    <option value="Admin" <%= admin.account_type === 'Admin' ? 'selected' : '' %>>Super Admin</option>
                    <option value="Mini Admin" <%= admin.account_type === 'Mini Admin' ? 'selected' : '' %>>Admin</option>
                    <option value="Internal Worker" <%= admin.account_type === 'Internal Worker' ? 'selected' : '' %>>Internal Worker</option>
                </select>
            </div>
            <div class="form-actions">
                <button type="submit" class="btn btn-primary">Update</button>
            </div>
        </form>

        <!-- Form for Deleting the Admin User -->
        <form action="/admin/deleteAdminUser/<%= admin.user_id %>" method="POST" class="delete-form">
            <button type="submit" class="btn btn-danger btn-block">Delete</button>
        </form>

        <!-- Resend password setup email -->
        <form action="/admin/resendAdminInvite/<%= admin.user_id %>" method="POST" class="resend-form" onsubmit="return confirm('Send a new password setup email to this admin? The previous link will be invalidated.');">
            <button type="submit" class="btn btn-secondary btn-block">📧 Resend password setup email</button>
            <p class="resend-note">Use this if their original invite link expired or never arrived. A new 24-hour link will be generated and emailed.</p>
        </form>
    </div>
</main>
