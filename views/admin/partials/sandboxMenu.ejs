<%#
  A school's data migration sandbox in a Super Admin ⋯ menu (Organizations, and a hub's
  schools): on for a school moving its data in; open it while it runs; off once it's live (or
  cancel it on the migration's own page). Expects: org, status (its open migration's, or null).
%>
<% if (status) { %>
  <a class="ah-menu__item" href="/admin/migrations/<%= org.organization_id %>" data-no-spa><i class="fa-solid fa-right-left" aria-hidden="true"></i> Open its migration</a>
  <% if (status === 'live') { %>
    <form action="/admin/migrations/<%= org.organization_id %>/stop" method="POST" onsubmit="return confirm('Turn the sandbox off for <%= String(org.organization_name || 'this school').replace(/[^A-Za-z0-9 .,()&-]/g, '') %>? Its migration is live; the sandbox button goes from its header.')">
      <button type="submit" class="ah-menu__item"><i class="fa-solid fa-toggle-off" aria-hidden="true"></i> Turn sandbox off</button>
    </form>
  <% } %>
<% } else { %>
  <form action="/admin/migrations/<%= org.organization_id %>/start" method="POST" onsubmit="return confirm('Turn the data migration sandbox on for <%= String(org.organization_name || 'this school').replace(/[^A-Za-z0-9 .,()&-]/g, '') %>? Its managers see a Sandbox button, and its live account takes no new data until the move is finished.')">
    <button type="submit" class="ah-menu__item"><i class="fa-solid fa-toggle-on" aria-hidden="true"></i> Turn sandbox on</button>
  </form>
<% } %>
