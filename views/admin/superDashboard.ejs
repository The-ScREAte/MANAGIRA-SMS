<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Super Admin Dashboard</title>
  <link rel="stylesheet" href="/css/admin.css" />
  <style>
    :root {
      --font-family: "<%= (session && session.fontStyle ? String(session.fontStyle).trim() : 'Inter') %>", sans-serif;
      --primary: #01535b;
      --text-primary: #111827;
      --text-secondary: #6b7280;
      --border: #e5e7eb;
      --bg: #f9fafb;
    }

    body {
      margin: 0;
      font-family: var(--font-family);
      background: var(--bg);
      color: var(--text-primary);
    }

    .dashboard-wrapper {
      max-width: 1400px;
      margin: 32px auto;
      padding: 0 16px;
    }

    .dashboard-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 12px;
      margin-bottom: 20px;
      flex-wrap: wrap;
    }

    .dashboard-header h1 {
      margin: 0;
      font-size: 1.7rem;
      font-weight: 700;
    }

    .header-actions {
      display: flex;
      align-items: center;
      gap: 10px;
      flex-wrap: wrap;
    }

    .btn-secondary {
      border: 1px solid var(--border);
      background: #fff;
      color: var(--text-primary);
      border-radius: 8px;
      padding: 10px 14px;
      font-size: 0.9rem;
      font-weight: 600;
      text-decoration: none;
      display: inline-flex;
      align-items: center;
      justify-content: center;
    }

    .btn-secondary.is-accent {
      background: #ecfeff;
      color: #155e75;
      border-color: #a5f3fc;
    }

    .btn-secondary.is-accent:hover {
      background: #cffafe;
    }

    .section-card {
      background: #fff;
      border: 1px solid var(--border);
      border-radius: 12px;
      overflow: hidden;
      margin-bottom: 18px;
    }

    .section-header {
      padding: 14px 18px;
      border-bottom: 1px solid var(--border);
      background: #fafafa;
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 10px;
      flex-wrap: wrap;
    }

    .section-header h2 {
      margin: 0;
      font-size: 1rem;
      font-weight: 700;
      color: var(--text-primary);
    }

    .table-wrapper {
      overflow-x: auto;
    }

    .clean-table {
      width: 100%;
      border-collapse: collapse;
      min-width: 900px;
    }

    .clean-table th,
    .clean-table td {
      padding: 12px 14px;
      border-bottom: 1px solid var(--border);
      text-align: left;
      vertical-align: middle;
      font-size: 0.88rem;
    }

    .clean-table th {
      font-size: 0.75rem;
      text-transform: uppercase;
      color: var(--text-secondary);
      letter-spacing: 0.5px;
      font-weight: 700;
    }

    .clean-table tbody tr:hover {
      background: #fcfcfc;
    }

    .expand-button {
      border: 1px solid #d1d5db;
      background: #fff;
      color: #374151;
      width: 26px;
      height: 26px;
      border-radius: 6px;
      font-size: 0.85rem;
      line-height: 1;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      padding: 0;
    }

    .expand-button:hover {
      background: #f3f4f6;
    }

    .details-row {
      display: none;
      background: #fcfcfd;
    }

    .details-panel {
      padding: 14px;
    }

    .details-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      gap: 8px 14px;
      margin-bottom: 12px;
      font-size: 0.85rem;
      color: var(--text-secondary);
    }

    .details-grid strong {
      color: var(--text-primary);
      margin-right: 6px;
    }

    .details-actions {
      display: flex;
      gap: 8px;
      flex-wrap: wrap;
    }

    .details-actions form {
      margin: 0;
    }

    .btn-action {
      border: none;
      border-radius: 6px;
      padding: 7px 10px;
      font-size: 0.8rem;
      font-weight: 700;
      cursor: pointer;
    }

    .btn-restore {
      background: #ecfdf5;
      color: #065f46;
    }

    .btn-delete {
      background: #fef2f2;
      color: #991b1b;
    }

    .bulk-toolbar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      padding: 8px 12px;
      margin: 0 0 10px;
      background: #fef2f2;
      border: 1px solid #fecaca;
      border-radius: 8px;
    }
    .bulk-toolbar.is-hidden { display: none; }
    .bulk-toolbar .bulk-count { font-size: 0.85rem; color: #991b1b; font-weight: 600; }
    .bulk-toolbar .btn-bulk-delete {
      background: #dc2626;
      color: #ffffff;
      border: none;
      padding: 6px 14px;
      border-radius: 6px;
      font-size: 0.85rem;
      font-weight: 600;
      cursor: pointer;
    }
    .bulk-toolbar .btn-bulk-delete:hover { background: #b91c1c; }
    .bulk-toolbar .btn-bulk-delete[disabled] { opacity: 0.6; cursor: not-allowed; }
    .row-checkbox, .select-all-checkbox { width: 16px; height: 16px; cursor: pointer; }

    .muted {
      color: var(--text-secondary);
      font-size: 0.85rem;
    }

    .linked-orgs-box {
      border: 1px solid var(--border);
      border-radius: 8px;
      background: #fff;
      padding: 10px;
      margin-bottom: 10px;
    }

    .linked-orgs-box h4 {
      margin: 0 0 8px;
      font-size: 0.85rem;
      color: var(--text-primary);
    }

    .linked-orgs-list {
      margin: 0;
      padding-left: 18px;
      color: var(--text-secondary);
      font-size: 0.84rem;
    }

    .linked-orgs-list li {
      margin: 3px 0;
    }

    .hub-detach-note {
      margin: 8px 0 0;
      font-size: 0.82rem;
      color: #92400e;
      background: #fffbeb;
      border: 1px solid #fde68a;
      border-radius: 6px;
      padding: 8px 10px;
    }

    .empty-state {
      padding: 20px;
      text-align: center;
      color: var(--text-secondary);
    }

    .users-modal[hidden] {
      display: none;
    }

    .users-modal {
      position: fixed;
      inset: 0;
      z-index: 1200;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 1.5vh 3vw;
    }

    .users-modal-backdrop {
      position: absolute;
      inset: 0;
      background: rgba(15, 23, 42, 0.48);
      backdrop-filter: blur(3px);
    }

    .users-modal-panel {
      position: relative;
      width: min(1400px, 94vw);
      height: 96vh;
      max-height: 97vh;
      overflow: hidden;
      border-radius: 18px;
      background: #ffffff;
      border: 1px solid rgba(229, 231, 235, 0.9);
      box-shadow: 0 30px 80px rgba(15, 23, 42, 0.25);
      display: flex;
      flex-direction: column;
    }

    .users-modal-header {
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      gap: 16px;
      padding: 20px 22px 16px;
      border-bottom: 1px solid var(--border);
      background: linear-gradient(135deg, #f8fafc, #ecfeff);
    }

    .users-modal-header h2 {
      margin: 0 0 6px;
      font-size: 1.15rem;
      font-weight: 800;
    }

    .users-modal-close {
      border: 1px solid var(--border);
      background: #fff;
      color: #374151;
      width: 38px;
      height: 38px;
      border-radius: 999px;
      cursor: pointer;
      font-size: 1.2rem;
      line-height: 1;
    }

    .users-modal-tabs {
      display: flex;
      gap: 8px;
      padding: 14px 22px 0;
      background: #fff;
    }

    .users-modal-tab {
      border: 1px solid #d1d5db;
      background: #f3f4f6;
      color: var(--text-primary);
      border-radius: 10px 10px 0 0;
      padding: 9px 16px;
      font: inherit;
      cursor: pointer;
    }

    .users-modal-tab.is-active {
      background: #fff;
      border-bottom-color: #fff;
      font-weight: 600;
    }

    .users-modal-toolbar {
      padding: 16px 22px;
      border-bottom: 1px solid var(--border);
      background: #fff;
      display: grid;
      gap: 14px;
    }

    .users-permissions-panel {
      width: min(720px, 94vw);
      height: auto;
      max-height: 90vh;
    }

    .permissions-body {
      display: flex;
      flex-direction: column;
      gap: 20px;
    }

    .permissions-section {
      display: flex;
      flex-direction: column;
      gap: 10px;
    }

    .permissions-section-hint {
      margin: 0;
      font-size: 0.8rem;
      color: var(--text-secondary);
    }

    .permissions-checkbox-row {
      display: flex;
      align-items: center;
      gap: 8px;
      font-weight: 500;
      font-size: 0.9rem;
      cursor: pointer;
    }

    .permissions-checkbox-row input[type="checkbox"] {
      width: 17px;
      height: 17px;
      accent-color: var(--primary);
      cursor: pointer;
    }

    .permissions-picker {
      padding: 12px;
      background: #f9fafb;
      border: 1px solid var(--border);
      border-radius: 12px;
      margin-left: 25px;
    }

    .permissions-picker input[type="search"] {
      width: 100%;
      border: 1px solid #d1d5db;
      border-radius: 10px;
      padding: 10px 12px;
      font: inherit;
      background: #fff;
    }

    .permissions-picker-results {
      border: 1px solid #e5e7eb;
      border-radius: 10px;
      margin-top: 8px;
      max-height: 170px;
      overflow-y: auto;
      background: #fff;
    }

    .permissions-picker-results:empty {
      display: none;
      border: none;
      margin-top: 0;
    }

    .permissions-picker-result {
      padding: 8px 10px;
      cursor: pointer;
      font-size: 0.86rem;
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .permissions-picker-result input[type="checkbox"] {
      width: 15px;
      height: 15px;
      accent-color: var(--primary);
      cursor: pointer;
      flex-shrink: 0;
    }

    .permissions-picker-result:not(:last-child) {
      border-bottom: 1px solid #f1f5f9;
    }

    .permissions-picker-result:hover {
      background: #f3f4f6;
    }

    .permissions-picker-result .result-tag {
      font-size: 0.72rem;
      color: var(--text-secondary);
      background: #eef2ff;
      border-radius: 999px;
      padding: 2px 8px;
      white-space: nowrap;
    }

    .permissions-selected-summary {
      margin-top: 10px;
      font-size: 0.82rem;
      color: var(--text-secondary);
    }

    .permissions-selected-summary:empty {
      display: none;
    }

    .permissions-selected-summary strong {
      color: var(--text-primary);
    }

    .permissions-footer {
      display: flex;
      justify-content: flex-end;
      padding-top: 6px;
      border-top: 1px solid var(--border);
    }

    .permissions-full-admin-banner {
      margin: 0 22px 16px;
      padding: 14px 16px;
      background: #ecfdf5;
      border: 1px solid #a7f3d0;
      border-radius: 12px;
      color: #065f46;
      font-size: 0.87rem;
      line-height: 1.5;
    }

    #permissions-editable-body.is-locked {
      opacity: 0.45;
      pointer-events: none;
      filter: grayscale(0.3);
    }

    .users-filter-grid {
      display: grid;
      grid-template-columns: minmax(240px, 1.8fr) repeat(3, minmax(150px, 1fr));
      gap: 10px;
    }

    .users-filter-grid input,
    .users-filter-grid select {
      width: 100%;
      border: 1px solid #d1d5db;
      border-radius: 10px;
      padding: 11px 12px;
      font: inherit;
      color: var(--text-primary);
      background: #fff;
    }

    .users-summary-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
      gap: 10px;
    }

    .users-summary-card {
      border: 1px solid #e5e7eb;
      border-radius: 12px;
      background: #f8fafc;
      padding: 12px 14px;
    }

    .users-summary-card strong {
      display: block;
      font-size: 1.15rem;
      color: #0f172a;
      margin-bottom: 4px;
    }

    .users-summary-card span {
      font-size: 0.78rem;
      text-transform: uppercase;
      letter-spacing: 0.04em;
      color: var(--text-secondary);
      font-weight: 700;
    }

    .users-feedback {
      margin: 16px 22px 0;
      border-radius: 10px;
      padding: 12px 14px;
      font-size: 0.9rem;
      border: 1px solid transparent;
    }

    .users-feedback.is-success {
      background: #ecfdf5;
      color: #166534;
      border-color: #a7f3d0;
    }

    .users-feedback.is-error {
      background: #fef2f2;
      color: #991b1b;
      border-color: #fecaca;
    }

    .users-modal-body {
      padding: 0 22px 22px;
      overflow: auto;
      flex: 1 1 auto;
    }

    .users-table {
      min-width: 980px;
    }

    .user-name-cell {
      display: grid;
      gap: 4px;
    }

    .user-name-cell strong {
      font-size: 0.92rem;
    }

    .user-meta {
      font-size: 0.79rem;
      color: var(--text-secondary);
    }

    .status-pill {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      border-radius: 999px;
      padding: 5px 10px;
      font-size: 0.73rem;
      font-weight: 800;
      letter-spacing: 0.04em;
      text-transform: uppercase;
    }

    .status-pill.is-active {
      background: #ecfdf5;
      color: #166534;
    }

    .status-pill.is-hold {
      background: #fff7ed;
      color: #c2410c;
    }

    .school-tags {
      display: flex;
      flex-wrap: wrap;
      gap: 6px;
    }

    .school-tag {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 6px 10px;
      border-radius: 999px;
      background: #f3f4f6;
      color: #374151;
      font-size: 0.76rem;
      font-weight: 700;
    }

    .school-tag.is-deleted {
      background: #fef2f2;
      color: #991b1b;
    }

    .table-actions {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
    }

    .btn-inline {
      border: none;
      border-radius: 8px;
      padding: 8px 10px;
      font-size: 0.78rem;
      font-weight: 800;
      cursor: pointer;
    }

    .btn-inline.is-hold {
      background: #fff7ed;
      color: #c2410c;
    }

    .btn-inline.is-resume {
      background: #ecfdf5;
      color: #166534;
    }

    .btn-inline.is-delete {
      background: #fef2f2;
      color: #991b1b;
    }

    .users-loading {
      padding: 18px 0;
    }

    @media (max-width: 768px) {
      .dashboard-header h1 {
        font-size: 1.4rem;
      }

      .dashboard-header {
        align-items: center;
      }

      .clean-table {
        min-width: 760px;
      }

      .users-modal {
        padding: 10px;
      }

      .users-modal-panel {
        width: 100%;
        height: calc(100vh - 20px);
        max-height: calc(100vh - 20px);
      }

      .users-filter-grid {
        grid-template-columns: 1fr;
      }

      .header-actions {
        width: 100%;
        flex-wrap: nowrap;
        gap: 8px;
      }

      .header-actions .btn-secondary {
        flex: 1 1 0;
        min-width: 0;
        white-space: nowrap;
        padding-left: 10px;
        padding-right: 10px;
      }
    }
  </style>
</head>
<body>
  <div class="dashboard-wrapper">
    <div class="dashboard-header">
      <h1>Super Admin Dashboard</h1>
      <div class="header-actions">
        <button type="button" class="btn-secondary is-accent" id="open-users-modal">All Users</button>
        <a href="/admin/superSettings" class="btn-secondary">⚙️ Settings</a>
      </div>
    </div>

    <%- include('../partials/flash') %>

    <div id="users-modal" class="users-modal" hidden>
      <div class="users-modal-backdrop" data-close-users-modal></div>
      <div class="users-modal-panel" role="dialog" aria-modal="true" aria-labelledby="users-modal-title">
        <div class="users-modal-header">
          <div>
            <h2 id="users-modal-title">All Users</h2>
            <div class="muted">Browse every user account, see the school they belong to, and manage hold, resume, or delete actions without leaving this page.</div>
          </div>
          <button type="button" class="users-modal-close" data-close-users-modal aria-label="Close user manager">×</button>
        </div>

        <div class="users-modal-tabs" role="tablist">
          <button type="button" class="users-modal-tab is-active" data-users-tab="managira_workers" role="tab" aria-selected="true">Managira Workers</button>
          <button type="button" class="users-modal-tab" data-users-tab="school_users" role="tab" aria-selected="false">School Users</button>
        </div>

        <div class="users-modal-toolbar">
          <form id="users-filter-form" class="users-filter-grid">
            <input type="search" name="q" id="users-filter-search" placeholder="Search by name, email, or school" autocomplete="off" />
            <select name="status" id="users-filter-status">
              <option value="all">All statuses</option>
              <option value="active">Active only</option>
              <option value="on_hold">On hold only</option>
            </select>
            <select name="role" id="users-filter-role">
              <option value="all">All roles</option>
            </select>
            <select name="organizationId" id="users-filter-organization">
              <option value="all">All schools</option>
              <option value="none">No school assigned</option>
            </select>
          </form>
          <div id="users-summary" class="users-summary-grid"></div>
        </div>

        <div id="users-feedback" class="users-feedback" hidden></div>

        <div class="users-modal-body">
          <div id="users-loading" class="empty-state users-loading" hidden>Loading users...</div>
          <div id="users-empty" class="empty-state" hidden>No users match the current filters.</div>
          <div class="table-wrapper">
            <table class="clean-table users-table">
              <thead>
                <tr>
                  <th>User</th>
                  <th>Email</th>
                  <th>Phone</th>
                  <th>Role</th>
                  <th>Schools</th>
                  <th>Status</th>
                  <th>Actions</th>
                </tr>
              </thead>
              <tbody id="users-table-body"></tbody>
            </table>
          </div>
        </div>
      </div>
    </div>

    <div id="user-permissions-modal" class="users-modal" hidden>
      <div class="users-modal-backdrop" data-close-permissions-modal></div>
      <div class="users-modal-panel users-permissions-panel" role="dialog" aria-modal="true" aria-labelledby="user-permissions-title">
        <div class="users-modal-header">
          <div>
            <h2 id="user-permissions-title">Manage Access</h2>
            <div class="muted" id="user-permissions-subtitle">Grant this Managira Worker extra visibility without making them a full Admin.</div>
          </div>
          <button type="button" class="users-modal-close" data-close-permissions-modal aria-label="Close access manager">×</button>
        </div>

        <div id="user-permissions-feedback" class="users-feedback" hidden></div>

        <div id="permissions-full-admin-banner" class="permissions-full-admin-banner" hidden>
          ✓ <strong>Full access is already active</strong> — Admins automatically see every contact, every school, and the Team Org Chart. There's nothing to grant or revoke here.
        </div>

        <div class="users-modal-body permissions-body" id="permissions-editable-body">

          <section class="permissions-section">
            <label class="permissions-checkbox-row">
              <input type="checkbox" id="permissions-org-chart-checkbox">
              Can view Team Org Chart (hamburger menu)
            </label>
          </section>

          <section class="permissions-section">
            <label class="permissions-checkbox-row">
              <input type="checkbox" id="permissions-mode-all-checkbox">
              All contacts
            </label>
            <label class="permissions-checkbox-row">
              <input type="checkbox" id="permissions-mode-selected-checkbox">
              Selected workers' contacts
            </label>

            <div class="permissions-picker" id="permissions-workers-picker" hidden>
              <input type="search" id="permissions-worker-search" placeholder="Search by name or email" autocomplete="off">
              <div id="permissions-worker-results" class="permissions-picker-results"></div>
              <div id="permissions-worker-selected" class="permissions-selected-summary"></div>
            </div>
          </section>

          <section class="permissions-section">
            <label class="permissions-checkbox-row">
              <input type="checkbox" id="permissions-schools-checkbox">
              Schools
            </label>

            <div class="permissions-picker" id="permissions-schools-picker" hidden>
              <input type="search" id="permissions-org-search" placeholder="Search school name" autocomplete="off">
              <div id="permissions-org-results" class="permissions-picker-results"></div>
              <div id="permissions-org-selected" class="permissions-selected-summary"></div>
            </div>
          </section>

          <section class="permissions-section">
            <p class="permissions-section-hint">Inside a granted school's dashboard:</p>
            <label class="permissions-checkbox-row">
              <input type="checkbox" id="permissions-billing-checkbox">
              Billing and Plan
            </label>
            <label class="permissions-checkbox-row">
              <input type="checkbox" id="permissions-security-checkbox">
              Security
            </label>
            <label class="permissions-checkbox-row">
              <input type="checkbox" id="permissions-paygira-checkbox">
              PayGira
            </label>
          </section>

          <div class="permissions-footer">
            <button type="button" class="btn-inline is-resume" id="permissions-save-btn">Save Access</button>
          </div>
        </div>
      </div>
    </div>

    <div class="section-card">
      <div class="section-header">
        <h2>🗑️ Deleted Applications</h2>
        <span class="muted"><%= deletedAccounts ? deletedAccounts.length : 0 %> records</span>
      </div>
      <% if (deletedAccounts && deletedAccounts.length > 0) { %>
      <form id="bulk-orgs-form" action="/admin/permanentlyDelete/bulk" method="post" onsubmit="return confirmBulkSubmit(this, 'application')" style="margin:0;"></form>
      <div class="bulk-toolbar is-hidden" data-bulk-toolbar="orgs">
        <span class="bulk-count" data-bulk-count="orgs">0 selected</span>
        <button type="submit" form="bulk-orgs-form" class="btn-bulk-delete" data-bulk-button="orgs" disabled>✕ Delete Selected Permanently</button>
      </div>
      <div class="table-wrapper">
        <table class="clean-table" data-bulk-table="orgs">
          <thead>
            <tr>
              <th><input type="checkbox" class="select-all-checkbox" data-select-all="orgs" aria-label="Select all applications"></th>
              <th></th>
              <th>Organization</th>
              <th>Contact</th>
              <th>Email</th>
              <th>Phone</th>
            </tr>
          </thead>
          <tbody>
            <% deletedAccounts.forEach(function(account) { %>
            <tr>
              <td><input type="checkbox" class="row-checkbox" form="bulk-orgs-form" name="orgIds" value="<%= account.organization_id %>" data-bulk-row="orgs" aria-label="Select application"></td>
              <td>
                <button type="button" class="expand-button" onclick="toggleDetails('org-<%= account.organization_id %>')">▾</button>
              </td>
              <td><strong><%= account.organization_name %></strong></td>
              <td><%= account.first_name %> <%= account.last_name %></td>
              <td><%= account.email %></td>
              <td><%= account.organization_phone %></td>
            </tr>
            <tr id="details-org-<%= account.organization_id %>" class="details-row">
              <td colspan="6">
                <div class="details-panel">
                  <div class="details-grid">
                    <div><strong>Address:</strong> <%= account.organization_address || 'N/A' %><% if (account.organization_country || account.organization_province) { %>, <%= [account.organization_province, account.organization_country].filter(Boolean).join(', ') %><% } %></div>
                  </div>
                  <div class="details-actions">
                    <form action="/admin/restore" method="post" onsubmit="return confirmAction('restore this organization?')">
                      <input type="hidden" name="orgId" value="<%= account.organization_id %>" />
                      <button type="submit" class="btn-action btn-restore">✓ Restore</button>
                    </form>
                    <form action="/admin/permanentlyDelete" method="post" onsubmit="return confirmAction('permanently delete this organization? This cannot be undone.')">
                      <input type="hidden" name="orgId" value="<%= account.organization_id %>" />
                      <button type="submit" class="btn-action btn-delete">✕ Delete Permanently</button>
                    </form>
                  </div>
                </div>
              </td>
            </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
      <% } else { %>
      <div class="empty-state">No deleted applications available.</div>
      <% } %>
    </div>

    <div class="section-card">
      <div class="section-header">
        <h2>🏢 Deleted Hubs</h2>
        <span class="muted"><%= deletedHubs ? deletedHubs.length : 0 %> records</span>
      </div>
      <% if (deletedHubs && deletedHubs.length > 0) { %>
      <form id="bulk-hubs-form" action="/admin/hubs/permanently-delete/bulk" method="post" onsubmit="return confirmBulkSubmit(this, 'hub')" style="margin:0;"></form>
      <div class="bulk-toolbar is-hidden" data-bulk-toolbar="hubs">
        <span class="bulk-count" data-bulk-count="hubs">0 selected</span>
        <button type="submit" form="bulk-hubs-form" class="btn-bulk-delete" data-bulk-button="hubs" disabled>✕ Delete Selected Permanently</button>
      </div>
      <div class="table-wrapper">
        <table class="clean-table" data-bulk-table="hubs">
          <thead>
            <tr>
              <th><input type="checkbox" class="select-all-checkbox" data-select-all="hubs" aria-label="Select all hubs"></th>
              <th></th>
              <th>Hub Name</th>
              <th>Nickname</th>
              <th>Admin</th>
              <th>Email</th>
              <th>Linked Orgs</th>
              <th>Status</th>
            </tr>
          </thead>
          <tbody>
            <% deletedHubs.forEach(function(hub) { %>
            <tr>
              <td><input type="checkbox" class="row-checkbox" form="bulk-hubs-form" name="hubIds" value="<%= hub.hub_id %>" data-bulk-row="hubs" aria-label="Select hub"></td>
              <td>
                <button type="button" class="expand-button" onclick="toggleDetails('hub-<%= hub.hub_id %>')">▾</button>
              </td>
              <td><strong><%= hub.hub_name %></strong></td>
              <td><%= hub.hub_nickname || 'N/A' %></td>
              <td><%= hub.first_name %> <%= hub.last_name %></td>
              <td><%= hub.hub_email %></td>
              <td><%= hub.linked_organizations_count || 0 %></td>
              <td><%= hub.on_hold ? 'On Hold' : 'Active' %></td>
            </tr>
            <tr id="details-hub-<%= hub.hub_id %>" class="details-row">
              <td colspan="8">
                <div class="details-panel">
                  <div class="details-grid">
                    <div><strong>Phone:</strong> <%= hub.hub_phone || 'N/A' %></div>
                    <div><strong>Address:</strong> <%= hub.hub_address || 'N/A' %></div>
                    <div><strong>Updated:</strong> <%= hub.updated_at ? new Date(hub.updated_at).toLocaleString() : 'N/A' %></div>
                  </div>

                  <div class="linked-orgs-box">
                    <h4>Organizations currently tied to this hub (<%= hub.linked_organizations_count || 0 %>)</h4>
                    <% if (hub.linked_organizations && hub.linked_organizations.length > 0) { %>
                      <ul class="linked-orgs-list">
                        <% hub.linked_organizations.forEach(function(org) { %>
                          <li>
                            <strong><%= org.organization_name %></strong>
                            <% if (org.email) { %> — <%= org.email %><% } %>
                            <% if (org.on_hold) { %> (On Hold)<% } %>
                          </li>
                        <% }); %>
                      </ul>
                    <% } else { %>
                      <div class="muted">No active organizations are currently tied to this hub.</div>
                    <% } %>
                    <p class="hub-detach-note">
                      If this hub is permanently deleted, these linked organizations will be detached and become separate standalone schools.
                    </p>
                  </div>

                  <div class="details-actions">
                    <form action="/admin/hubs/restore" method="post" onsubmit="return confirmAction('restore this hub?')">
                      <input type="hidden" name="hubId" value="<%= hub.hub_id %>" />
                      <button type="submit" class="btn-action btn-restore">✓ Restore Hub</button>
                    </form>
                    <form action="/admin/hubs/permanently-delete" method="post" onsubmit="return confirmAction('permanently delete this hub? This cannot be undone.')">
                      <input type="hidden" name="hubId" value="<%= hub.hub_id %>" />
                      <button type="submit" class="btn-action btn-delete">✕ Delete Permanently</button>
                    </form>
                  </div>
                </div>
              </td>
            </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
      <% } else { %>
      <div class="empty-state">No deleted hubs available.</div>
      <% } %>
    </div>

    <div class="section-card">
      <div class="section-header">
        <h2>📨 Deleted Tickets</h2>
        <span class="muted"><%= deletedTickets ? deletedTickets.length : 0 %> records</span>
      </div>
      <% if (deletedTickets && deletedTickets.length > 0) { %>
      <form id="bulk-tickets-form" action="/admin/permanentDeleteMessage/bulk" method="post" onsubmit="return confirmBulkSubmit(this, 'ticket')" style="margin:0;"></form>
      <div class="bulk-toolbar is-hidden" data-bulk-toolbar="tickets">
        <span class="bulk-count" data-bulk-count="tickets">0 selected</span>
        <button type="submit" form="bulk-tickets-form" class="btn-bulk-delete" data-bulk-button="tickets" disabled>✕ Delete Selected Permanently</button>
      </div>
      <div class="table-wrapper">
        <table class="clean-table" data-bulk-table="tickets">
          <thead>
            <tr>
              <th><input type="checkbox" class="select-all-checkbox" data-select-all="tickets" aria-label="Select all tickets"></th>
              <th></th>
              <th>Ticket</th>
              <th>Name</th>
              <th>Organization</th>
              <th>Email</th>
              <th>Last Updated</th>
            </tr>
          </thead>
          <tbody>
            <% deletedTickets.forEach(function(ticket) { %>
            <tr>
              <td><input type="checkbox" class="row-checkbox" form="bulk-tickets-form" name="threadIds" value="<%= ticket.thread_id %>" data-bulk-row="tickets" aria-label="Select ticket"></td>
              <td>
                <button type="button" class="expand-button" onclick="toggleDetails('ticket-<%= ticket.thread_id %>')">▾</button>
              </td>
              <td>#<%= ticket.thread_id %></td>
              <td><%= ticket.name %></td>
              <td><%= ticket.organization || 'N/A' %></td>
              <td><%= ticket.email %></td>
              <td><%= ticket.last_updated ? new Date(ticket.last_updated).toLocaleString() : 'N/A' %></td>
            </tr>
            <tr id="details-ticket-<%= ticket.thread_id %>" class="details-row">
              <td colspan="7">
                <div class="details-panel">
                  <div class="details-grid">
                    <div><strong>Phone:</strong> <%= ticket.phone || 'N/A' %></div>
                  </div>
                  <div class="details-grid" style="grid-template-columns: 1fr;">
                    <div>
                      <strong>Messages:</strong>
