    <div class="section-card">
      <div class="section-header">
        <h2>📇 Deleted Referrals</h2>
        <span class="muted"><%= deletedContacts ? deletedContacts.length : 0 %> records</span>
      </div>
      <% if (deletedContacts && deletedContacts.length > 0) { %>
      <div class="table-wrapper">
        <table class="clean-table">
          <thead>
            <tr>
              <th></th>
              <th>Contact</th>
              <th>Organization</th>
              <th>Created by</th>
              <th>Assigned to</th>
              <th>Deleted</th>
            </tr>
          </thead>
          <tbody>
            <% deletedContacts.forEach(function(c) {
              var creatorName = [c.creator_first_name, c.creator_last_name].filter(Boolean).join(' ').trim() || '—';
              var assigneeName = [c.assignee_first_name, c.assignee_last_name].filter(Boolean).join(' ').trim() || 'Unassigned';
            %>
            <tr>
              <td>
                <button type="button" class="expand-button" onclick="toggleDetails('contact-<%= c.id %>')">▾</button>
              </td>
              <td><strong><%= c.contact_name %></strong></td>
              <td><%= c.organization_name || '—' %></td>
              <td><%= creatorName %></td>
              <td><%= assigneeName %></td>
              <td><%= c.deleted_at ? new Date(c.deleted_at).toLocaleString() : '—' %></td>
            </tr>
            <tr id="details-contact-<%= c.id %>" class="details-row">
              <td colspan="6">
                <div class="details-panel">
                  <div class="details-grid">
                    <div><strong>Created:</strong> <%= c.created_at ? new Date(c.created_at).toLocaleString() : '—' %></div>
                    <div><strong>Appointment:</strong> <%= c.appointment_set ? (c.appointment_at ? new Date(c.appointment_at).toLocaleString() : 'Yes') : 'No' %></div>
                    <div><strong>Followed up:</strong> <%= c.followed_up ? (c.followed_up_at ? new Date(c.followed_up_at).toLocaleString() : 'Yes') : 'No' %></div>
                    <div><strong>Joined:</strong> <%= c.joined ? (c.joined_at ? new Date(c.joined_at).toLocaleString() : 'Yes') : 'No' %></div>
                  </div>
                  <% if (c.notes) { %>
                  <div class="details-grid" style="grid-template-columns: 1fr;">
                    <div>
                      <strong>Notes:</strong>
                      <pre style="white-space: pre-wrap; margin: 6px 0 0 0;"><%= c.notes %></pre>
                    </div>
                  </div>
                  <% } %>
                  <div class="details-actions">
                    <form action="/admin/contacts/restore" method="post" onsubmit="return confirmAction('restore this referral?')">
                      <input type="hidden" name="contactId" value="<%= c.id %>" />
                      <button type="submit" class="btn-action btn-restore">✓ Restore</button>
                    </form>
                    <form action="/admin/contacts/permanent-delete" method="post" onsubmit="return confirmAction('permanently delete this referral? This cannot be undone.')">
                      <input type="hidden" name="contactId" value="<%= c.id %>" />
                      <button type="submit" class="btn-action btn-delete">✕ Delete Permanently</button>
                    </form>
                  </div>
                </div>
              </td>
            </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
      <% } else { %>
      <div class="empty-state">No deleted referrals available.</div>
      <% } %>
    </div>
  </div>

  <script>
    function toggleDetails(id) {
      const details = document.getElementById(`details-${id}`);
      if (!details) return;
      details.style.display = details.style.display === 'table-row' ? 'none' : 'table-row';
    }

    function confirmAction(message) {
      return confirm(`Are you sure you want to ${message}`);
    }

    // Bulk select-all + delete handling
    function updateBulkUI(key) {
      const rows = document.querySelectorAll(`[data-bulk-row="${key}"]`);
      const selected = Array.from(rows).filter(r => r.checked);
      const toolbar = document.querySelector(`[data-bulk-toolbar="${key}"]`);
      const countEl = document.querySelector(`[data-bulk-count="${key}"]`);
      const btn = document.querySelector(`[data-bulk-button="${key}"]`);
      const selectAll = document.querySelector(`[data-select-all="${key}"]`);
      if (countEl) countEl.textContent = `${selected.length} selected`;
      if (btn) btn.disabled = selected.length === 0;
      if (toolbar) toolbar.classList.toggle('is-hidden', selected.length === 0);
      if (selectAll) {
        selectAll.checked = rows.length > 0 && selected.length === rows.length;
        selectAll.indeterminate = selected.length > 0 && selected.length < rows.length;
      }
    }
    document.querySelectorAll('[data-select-all]').forEach(cb => {
      cb.addEventListener('change', function() {
        const key = this.getAttribute('data-select-all');
        document.querySelectorAll(`[data-bulk-row="${key}"]`).forEach(r => { r.checked = this.checked; });
        updateBulkUI(key);
      });
    });
    document.querySelectorAll('[data-bulk-row]').forEach(cb => {
      cb.addEventListener('change', function() {
        updateBulkUI(this.getAttribute('data-bulk-row'));
      });
    });
    function confirmBulkSubmit(form, label) {
      const key = form.id.replace(/^bulk-/, '').replace(/-form$/, '');
      const count = document.querySelectorAll(`[data-bulk-row="${key}"]:checked`).length;
      if (count === 0) return false;
      return confirm(`Permanently delete ${count} ${label}${count === 1 ? '' : 's'}? This cannot be undone.`);
    }

    const usersModal = document.getElementById('users-modal');
    const openUsersModalButton = document.getElementById('open-users-modal');
    const usersFilterForm = document.getElementById('users-filter-form');
    const usersTableBody = document.getElementById('users-table-body');
    const usersSummary = document.getElementById('users-summary');
    const usersFeedback = document.getElementById('users-feedback');
    const usersLoading = document.getElementById('users-loading');
    const usersEmpty = document.getElementById('users-empty');
    const roleFilter = document.getElementById('users-filter-role');
    const organizationFilter = document.getElementById('users-filter-organization');
    const usersState = {
      loadedOnce: false,
      loading: false,
      searchTimer: null,
      tab: 'managira_workers',
    };
    const usersTabButtons = document.querySelectorAll('[data-users-tab]');

    function escapeHtml(value) {
      return String(value == null ? '' : value)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#39;');
    }

    function toggleUsersModal(show) {
      if (!usersModal) return;
      usersModal.hidden = !show;
      document.body.style.overflow = show ? 'hidden' : '';
      if (show && !usersState.loadedOnce) {
        loadUsers();
      }
    }

    function showUsersFeedback(message, type) {
      if (!usersFeedback) return;
      if (!message) {
        usersFeedback.hidden = true;
        usersFeedback.textContent = '';
        usersFeedback.className = 'users-feedback';
        return;
      }

      usersFeedback.hidden = false;
      usersFeedback.textContent = message;
      usersFeedback.className = `users-feedback ${type === 'error' ? 'is-error' : 'is-success'}`;
    }

    function setUsersLoading(isLoading) {
      usersState.loading = isLoading;
      usersLoading.hidden = !isLoading;
    }

    function buildUsersQuery() {
      const params = new URLSearchParams();
      const formData = new FormData(usersFilterForm);
      for (const [key, value] of formData.entries()) {
        if (value && value !== 'all') {
          params.set(key, value);
        }
      }
      params.set('tab', usersState.tab);
      return params.toString();
    }

    function renderSummary(summary) {
      if (!usersSummary) return;
      const cards = [
        { label: 'Total users', value: summary.total || 0 },
        { label: 'Active', value: summary.active || 0 },
        { label: 'On hold', value: summary.onHold || 0 },
        { label: 'School-linked', value: summary.schoolLinked || 0 },
        { label: 'Platform', value: summary.platform || 0 },
      ];

      usersSummary.innerHTML = cards.map((card) => `
        <div class="users-summary-card">
          <strong>${escapeHtml(card.value)}</strong>
          <span>${escapeHtml(card.label)}</span>
        </div>
      `).join('');
    }

    function renderFilterOptions(filters) {
      const currentRole = roleFilter.value || 'all';
      const currentOrganization = organizationFilter.value || 'all';

      roleFilter.innerHTML = '<option value="all">All roles</option>' +
        (filters.roles || []).map((role) => `
          <option value="${escapeHtml(role)}">${escapeHtml(role)}</option>
        `).join('');

      organizationFilter.innerHTML = '<option value="all">All schools</option><option value="none">No school assigned</option>' +
        (filters.organizations || []).map((org) => `
          <option value="${escapeHtml(org.organizationId)}">${escapeHtml(org.organizationName)}${org.deleted ? ' (Deleted)' : ''}${org.onHold ? ' (On Hold)' : ''}</option>
        `).join('');

      roleFilter.value = currentRole;
      if (!Array.from(roleFilter.options).some((option) => option.value === currentRole)) {
        roleFilter.value = 'all';
      }

      organizationFilter.value = currentOrganization;
      if (!Array.from(organizationFilter.options).some((option) => option.value === currentOrganization)) {
        organizationFilter.value = 'all';
      }
    }

    function renderUsers(users) {
      const rows = (users || []).map((user) => {
        const schoolMarkup = user.schools && user.schools.length
          ? `<div class="school-tags">${user.schools.map((school) => `
              <span class="school-tag ${school.deleted ? 'is-deleted' : ''}">
                ${escapeHtml(school.name)}${school.onHold ? ' • On Hold' : ''}${school.deleted ? ' • Deleted' : ''}
              </span>
            `).join('')}</div>`
          : '<span class="muted">No school assigned</span>';

        return `
          <tr>
            <td>
              <div class="user-name-cell">
                <strong>${escapeHtml(user.fullName)}</strong>
                <span class="user-meta">User ID: ${escapeHtml(user.userId)}</span>
              </div>
            </td>
            <td>${escapeHtml(user.email)}</td>
            <td>${user.phoneNumber ? escapeHtml(user.phoneNumber) : '<span class="muted">N/A</span>'}</td>
            <td>${escapeHtml(user.accountType || 'N/A')}</td>
            <td>${schoolMarkup}</td>
            <td>
              <span class="status-pill ${user.onHold ? 'is-hold' : 'is-active'}">
                ${user.onHold ? 'On Hold' : 'Active'}
              </span>
            </td>
            <td>
              <div class="table-actions">
                ${user.isManagiraWorker ? `
                <button type="button" class="btn-inline" data-user-action="permissions" data-user-id="${escapeHtml(user.userId)}" data-user-name="${escapeHtml(user.fullName)}" data-account-type="${escapeHtml(user.accountType || '')}">
                  Manage Access
                </button>` : ''}
                <button type="button" class="btn-inline ${user.onHold ? 'is-resume' : 'is-hold'}" data-user-action="status" data-user-id="${escapeHtml(user.userId)}" data-status="${user.onHold ? 'resume' : 'hold'}">
                  ${user.onHold ? 'Resume' : 'Put On Hold'}
                </button>
                <button type="button" class="btn-inline is-delete" data-user-action="delete" data-user-id="${escapeHtml(user.userId)}">
                  Delete
                </button>
              </div>
            </td>
          </tr>
        `;
      }).join('');

      usersTableBody.innerHTML = rows;
      usersEmpty.hidden = users.length > 0;
    }

    async function loadUsers() {
      if (!usersFilterForm || usersState.loading) return;

      setUsersLoading(true);
      showUsersFeedback('');

      try {
        const query = buildUsersQuery();
        const response = await fetch(`/admin/superDashboard/users/ajax${query ? `?${query}` : ''}`, {
          headers: { 'Accept': 'application/json' },
          credentials: 'same-origin',
        });
        const payload = await response.json();

        if (!response.ok || !payload.success) {
          throw new Error(payload.message || 'Failed to load users.');
        }

        usersState.loadedOnce = true;
        renderSummary(payload.summary || {});
        renderFilterOptions(payload.filters || { roles: [], organizations: [] });
        renderUsers(payload.users || []);
      } catch (error) {
        usersTableBody.innerHTML = '';
        usersEmpty.hidden = false;
        showUsersFeedback(error.message || 'Failed to load users.', 'error');
      } finally {
        setUsersLoading(false);
      }
    }

    async function handleUserAction(action, userId, statusValue) {
      if (!userId) return;

      let endpoint = `/admin/superDashboard/users/${encodeURIComponent(userId)}/delete`;
      let body = {};
      let confirmMessage = 'delete this user? This may fail if the user still owns protected records.';

      if (action === 'status') {
        endpoint = `/admin/superDashboard/users/${encodeURIComponent(userId)}/status`;
        body = { status: statusValue };
        confirmMessage = `${statusValue === 'hold' ? 'put this user on hold' : 'resume this user'}?`;
      }

      if (!confirmAction(confirmMessage)) {
        return;
      }

      showUsersFeedback('');

      try {
        const response = await fetch(endpoint, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'Accept': 'application/json',
          },
          credentials: 'same-origin',
          body: JSON.stringify(body),
        });
        const payload = await response.json();

        if (!response.ok || !payload.success) {
          throw new Error(payload.message || 'Action failed.');
        }

        showUsersFeedback(payload.message || 'Action completed successfully.', 'success');
        await loadUsers();
      } catch (error) {
        showUsersFeedback(error.message || 'Action failed.', 'error');
      }
    }

    if (openUsersModalButton) {
      openUsersModalButton.addEventListener('click', () => toggleUsersModal(true));
    }

    document.querySelectorAll('[data-close-users-modal]').forEach((element) => {
      element.addEventListener('click', () => toggleUsersModal(false));
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && usersModal && !usersModal.hidden) {
        toggleUsersModal(false);
      }
    });

    if (usersFilterForm) {
      usersFilterForm.addEventListener('submit', (event) => {
        event.preventDefault();
        loadUsers();
      });

      usersFilterForm.addEventListener('change', (event) => {
        if (event.target.matches('select')) {
          loadUsers();
        }
      });
    }

    const usersSearchInput = document.getElementById('users-filter-search');
    if (usersSearchInput) {
      usersSearchInput.addEventListener('input', () => {
        clearTimeout(usersState.searchTimer);
        usersState.searchTimer = setTimeout(() => loadUsers(), 250);
      });
    }

    if (usersTableBody) {
      usersTableBody.addEventListener('click', (event) => {
        const button = event.target.closest('[data-user-action]');
        if (!button) return;

        const action = button.getAttribute('data-user-action');
        const userId = button.getAttribute('data-user-id');
        const statusValue = button.getAttribute('data-status');

        if (action === 'permissions') {
          openPermissionsModal(userId, button.getAttribute('data-user-name'), button.getAttribute('data-account-type'));
          return;
        }

        handleUserAction(action, userId, statusValue);
      });
    }

    usersTabButtons.forEach((button) => {
      button.addEventListener('click', () => {
        if (usersState.tab === button.getAttribute('data-users-tab')) return;
        usersTabButtons.forEach((btn) => {
          btn.classList.toggle('is-active', btn === button);
          btn.setAttribute('aria-selected', btn === button ? 'true' : 'false');
        });
        usersState.tab = button.getAttribute('data-users-tab');
        loadUsers();
      });
    });

    // --- Manage Access (per-user permission grants) ---
    const permissionsModal = document.getElementById('user-permissions-modal');
    const permissionsFeedback = document.getElementById('user-permissions-feedback');
    const permissionsSubtitle = document.getElementById('user-permissions-subtitle');
    const permissionsOrgChartCheckbox = document.getElementById('permissions-org-chart-checkbox');
    const permissionsBillingCheckbox = document.getElementById('permissions-billing-checkbox');
    const permissionsSecurityCheckbox = document.getElementById('permissions-security-checkbox');
    const permissionsPaygiraCheckbox = document.getElementById('permissions-paygira-checkbox');
    const permissionsModeAllCheckbox = document.getElementById('permissions-mode-all-checkbox');
    const permissionsModeSelectedCheckbox = document.getElementById('permissions-mode-selected-checkbox');
    const permissionsWorkersPicker = document.getElementById('permissions-workers-picker');
    const permissionsWorkerSearch = document.getElementById('permissions-worker-search');
    const permissionsWorkerResults = document.getElementById('permissions-worker-results');
    const permissionsWorkerSelected = document.getElementById('permissions-worker-selected');
    const permissionsSchoolsCheckbox = document.getElementById('permissions-schools-checkbox');
    const permissionsSchoolsPicker = document.getElementById('permissions-schools-picker');
    const permissionsOrgSearch = document.getElementById('permissions-org-search');
    const permissionsOrgResults = document.getElementById('permissions-org-results');
    const permissionsOrgSelected = document.getElementById('permissions-org-selected');
    const permissionsSaveBtn = document.getElementById('permissions-save-btn');
    const permissionsFullAdminBanner = document.getElementById('permissions-full-admin-banner');
    const permissionsEditableBody = document.getElementById('permissions-editable-body');
    // selectedWorkers / selectedOrgs are mutated in place (never reassigned) so
    // that closures created once at page-load keep pointing at live state.
    const permissionsState = {
      userId: null,
      selectedWorkers: new Map(),
      selectedOrgs: new Map(),
      workerSearchTimer: null,
      orgSearchTimer: null,
      isFullAdmin: false,
    };

    function setFullAdminLockedView(isFullAdmin) {
      permissionsState.isFullAdmin = isFullAdmin;
      permissionsFullAdminBanner.hidden = !isFullAdmin;
      permissionsEditableBody.classList.toggle('is-locked', isFullAdmin);
      permissionsSaveBtn.hidden = isFullAdmin;
    }

    function showPermissionsFeedback(message, type) {
      if (!permissionsFeedback) return;
      if (!message) {
        permissionsFeedback.hidden = true;
        permissionsFeedback.textContent = '';
        permissionsFeedback.className = 'users-feedback';
        return;
      }
      permissionsFeedback.hidden = false;
      permissionsFeedback.textContent = message;
      permissionsFeedback.className = `users-feedback ${type === 'error' ? 'is-error' : 'is-success'}`;
    }

    function currentContactAccessMode() {
      if (permissionsModeAllCheckbox.checked) return 'all';
      if (permissionsModeSelectedCheckbox.checked) return 'selected';
      return 'own';
    }

    function applyContactAccessMode(mode) {
      permissionsModeAllCheckbox.checked = mode === 'all';
      permissionsModeSelectedCheckbox.checked = mode === 'selected';
      permissionsWorkersPicker.hidden = mode !== 'selected';
    }

    function renderWorkerSelected() {
      const names = Array.from(permissionsState.selectedWorkers.values()).map((w) => w.name);
      permissionsWorkerSelected.innerHTML = names.length
        ? `<strong>Selected (${names.length}):</strong> ${names.map(escapeHtml).join(', ')}`
        : '';
    }

    function renderOrgSelected() {
      const names = Array.from(permissionsState.selectedOrgs.values()).map((o) => o.name);
      permissionsOrgSelected.innerHTML = names.length
        ? `<strong>Selected (${names.length}):</strong> ${names.map(escapeHtml).join(', ')}`
        : '';
    }

    function togglePermissionsModal(show) {
      if (!permissionsModal) return;
      permissionsModal.hidden = !show;
      document.body.style.overflow = show ? 'hidden' : '';
    }

    async function openPermissionsModal(userId, userName, accountType) {
      if (!userId) return;
      permissionsState.userId = userId;
      permissionsState.selectedWorkers.clear();
      permissionsState.selectedOrgs.clear();
      permissionsWorkerSearch.value = '';
      permissionsOrgSearch.value = '';
      permissionsWorkerResults.innerHTML = '';
      permissionsOrgResults.innerHTML = '';
      applyContactAccessMode('own');
      permissionsSchoolsCheckbox.checked = false;
      permissionsSchoolsPicker.hidden = true;
      permissionsBillingCheckbox.checked = false;
      permissionsSecurityCheckbox.checked = false;
      permissionsPaygiraCheckbox.checked = false;
      renderWorkerSelected();
      renderOrgSelected();
      showPermissionsFeedback('');
      setFullAdminLockedView(accountType === 'Admin' || accountType === 'Mini Admin');
      permissionsSubtitle.textContent = userName
        ? `Access for ${userName}.`
        : 'Access for this worker.';

      togglePermissionsModal(true);

      try {
        const response = await fetch(`/admin/superDashboard/users/${encodeURIComponent(userId)}/permissions`, {
          headers: { 'Accept': 'application/json' },
          credentials: 'same-origin',
        });
        const payload = await response.json();
        if (!response.ok || !payload.success) {
          throw new Error(payload.message || 'Failed to load access settings.');
        }
        setFullAdminLockedView(!!payload.isFullAdmin);
        permissionsOrgChartCheckbox.checked = !!payload.canViewOrgChart;
        permissionsBillingCheckbox.checked = !!payload.canViewBilling;
        permissionsSecurityCheckbox.checked = !!payload.canViewSecurity;
        permissionsPaygiraCheckbox.checked = !!payload.canViewPaygira;
        applyContactAccessMode(payload.contactAccessMode || 'own');
        (payload.extraWorkers || []).forEach((worker) => {
          permissionsState.selectedWorkers.set(String(worker.id), worker);
        });
        (payload.extraOrganizations || []).forEach((org) => {
          permissionsState.selectedOrgs.set(String(org.id), org);
        });
        renderWorkerSelected();
        renderOrgSelected();
        permissionsSchoolsCheckbox.checked = permissionsState.selectedOrgs.size > 0;
        permissionsSchoolsPicker.hidden = !permissionsSchoolsCheckbox.checked;
      } catch (error) {
        showPermissionsFeedback(error.message || 'Failed to load access settings.', 'error');
      }
    }

    permissionsModeAllCheckbox.addEventListener('change', () => {
      if (permissionsModeAllCheckbox.checked) permissionsModeSelectedCheckbox.checked = false;
      applyContactAccessMode(currentContactAccessMode());
    });
    permissionsModeSelectedCheckbox.addEventListener('change', () => {
      if (permissionsModeSelectedCheckbox.checked) permissionsModeAllCheckbox.checked = false;
      applyContactAccessMode(currentContactAccessMode());
    });
    permissionsSchoolsCheckbox.addEventListener('change', () => {
      permissionsSchoolsPicker.hidden = !permissionsSchoolsCheckbox.checked;
      if (!permissionsSchoolsCheckbox.checked) {
        permissionsState.selectedOrgs.clear();
        renderOrgSelected();
      }
    });

    function wirePicker({ searchInput, resultsEl, timerKey, resultKey, selectedMap, renderSelected, buildQuery }) {
      if (!searchInput) return;

      function renderResults(items) {
        resultsEl.innerHTML = items.map((item) => {
          const checked = selectedMap.has(String(item.id));
          return `
            <label class="permissions-picker-result">
              <input type="checkbox" data-item-id="${escapeHtml(item.id)}" data-item-name="${escapeHtml(item.name)}" data-item-type="${escapeHtml(item.accountType || '')}" ${checked ? 'checked' : ''}>
              <span>${escapeHtml(item.name)}</span>
              ${item.accountType ? `<span class="result-tag">${escapeHtml(item.accountType)}</span>` : ''}
            </label>
          `;
        }).join('') || '<div class="permissions-picker-result muted">No matches</div>';
      }

      searchInput.addEventListener('input', () => {
        clearTimeout(permissionsState[timerKey]);
        const query = searchInput.value.trim();
        if (!query) {
          resultsEl.innerHTML = '';
          return;
        }
        permissionsState[timerKey] = setTimeout(async () => {
          try {
            const response = await fetch(buildQuery(query), {
              headers: { 'Accept': 'application/json' },
              credentials: 'same-origin',
            });
            const payload = await response.json();
            renderResults((payload && payload[resultKey]) || []);
          } catch (_) {
            resultsEl.innerHTML = '';
          }
        }, 250);
      });

      resultsEl.addEventListener('change', (event) => {
        const checkbox = event.target.closest('[data-item-id]');
        if (!checkbox) return;
        const id = checkbox.getAttribute('data-item-id');
        if (checkbox.checked) {
          selectedMap.set(id, {
            id,
            name: checkbox.getAttribute('data-item-name'),
            accountType: checkbox.getAttribute('data-item-type') || undefined,
          });
        } else {
          selectedMap.delete(id);
        }
        renderSelected();
      });
    }

    wirePicker({
      searchInput: permissionsWorkerSearch,
      resultsEl: permissionsWorkerResults,
      timerKey: 'workerSearchTimer',
      resultKey: 'workers',
      selectedMap: permissionsState.selectedWorkers,
      renderSelected: renderWorkerSelected,
      buildQuery: (query) => `/admin/superDashboard/workers/search?q=${encodeURIComponent(query)}&excludeUserId=${encodeURIComponent(permissionsState.userId || '')}`,
    });

    wirePicker({
      searchInput: permissionsOrgSearch,
      resultsEl: permissionsOrgResults,
      timerKey: 'orgSearchTimer',
      resultKey: 'organizations',
      selectedMap: permissionsState.selectedOrgs,
      renderSelected: renderOrgSelected,
      buildQuery: (query) => `/admin/superDashboard/organizations/search?q=${encodeURIComponent(query)}`,
    });

    if (permissionsSaveBtn) {
      permissionsSaveBtn.addEventListener('click', async () => {
        if (!permissionsState.userId || permissionsState.isFullAdmin) return;
        showPermissionsFeedback('');
        try {
          const response = await fetch(`/admin/superDashboard/users/${encodeURIComponent(permissionsState.userId)}/permissions`, {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
              'Accept': 'application/json',
            },
            credentials: 'same-origin',
            body: JSON.stringify({
              canViewOrgChart: permissionsOrgChartCheckbox.checked,
              canViewBilling: permissionsBillingCheckbox.checked,
              canViewSecurity: permissionsSecurityCheckbox.checked,
              canViewPaygira: permissionsPaygiraCheckbox.checked,
              contactAccessMode: currentContactAccessMode(),
              extraWorkerIds: Array.from(permissionsState.selectedWorkers.keys()).map((id) => Number(id)),
              extraOrganizationIds: permissionsSchoolsCheckbox.checked
                ? Array.from(permissionsState.selectedOrgs.keys()).map((id) => Number(id))
                : [],
            }),
          });
          const payload = await response.json();
          if (!response.ok || !payload.success) {
            throw new Error(payload.message || 'Failed to save access settings.');
          }
          showPermissionsFeedback('Saved.', 'success');
        } catch (error) {
          showPermissionsFeedback(error.message || 'Failed to save access settings.', 'error');
        }
      });
    }

    document.querySelectorAll('[data-close-permissions-modal]').forEach((element) => {
      element.addEventListener('click', () => togglePermissionsModal(false));
    });
  </script>
</body>
</html>