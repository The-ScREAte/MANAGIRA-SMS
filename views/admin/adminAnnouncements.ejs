<link rel="stylesheet" href="/css/admin.css" />

<style>
  :root {
    --automation-ink: #102542;
    --automation-muted: #5b6b82;
    --automation-accent: #0f766e;
    --automation-accent-soft: #ccfbf1;
    --automation-warm: #f59e0b;
    --automation-danger: #dc2626;
    --automation-surface: #ffffff;
    --automation-surface-soft: #f6f9fc;
    --automation-border: rgba(16, 37, 66, 0.12);
    --automation-shadow: 0 22px 50px rgba(15, 23, 42, 0.08);
  }

  .announcements-shell {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 24px;
    max-width: 1220px;
    margin: 0 auto;
  }

  .page-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 16px 24px;
    padding: 22px 24px;
    background: var(--automation-surface);
    border: 1px solid var(--automation-border);
    border-radius: 24px;
    box-shadow: var(--automation-shadow);
  }

  .eyebrow {
    display: inline-flex;
    align-items: center;
    padding: 4px 10px;
    border-radius: 999px;
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    font-weight: 700;
    background: rgba(15, 118, 110, 0.08);
    color: var(--automation-accent);
  }

  .page-head__title {
    margin: 10px 0 0;
    font-size: 1.5rem;
    line-height: 1.25;
    text-align: left;
    color: var(--automation-ink);
  }

  .workspace-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.25fr);
    gap: 24px;
    align-items: start;
  }

  .glass-panel {
    background: var(--automation-surface);
    border-radius: 24px;
    padding: 24px;
    border: 1px solid var(--automation-border);
    box-shadow: var(--automation-shadow);
  }

  .panel-header {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    align-items: flex-start;
    margin-bottom: 20px;
  }

  .panel-title {
    margin: 0;
    color: var(--automation-ink);
    font-size: 1.35rem;
  }

  .panel-subtitle {
    margin: 8px 0 0;
    color: var(--automation-muted);
    line-height: 1.6;
    font-size: 0.95rem;
  }

  .panel-actions {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
  }

  .announcement-form,
  .campaign-form-grid {
    display: grid;
    gap: 14px;
  }

  .field-label {
    display: block;
    margin-bottom: 8px;
    color: var(--automation-ink);
    font-weight: 700;
    font-size: 0.92rem;
  }

  .field-help {
    margin-top: 6px;
    color: var(--automation-muted);
    font-size: 0.82rem;
    line-height: 1.5;
  }

  .automation-input,
  .automation-textarea,
  .automation-select {
    width: 100%;
    border-radius: 16px;
    border: 1px solid rgba(16, 37, 66, 0.14);
    background: #fff;
    padding: 14px 15px;
    font: inherit;
    color: var(--automation-ink);
    transition: border-color 0.2s ease, box-shadow 0.2s ease, transform 0.2s ease;
    box-sizing: border-box;
  }

  .automation-input:focus,
  .automation-textarea:focus,
  .automation-select:focus {
    outline: none;
    border-color: rgba(15, 118, 110, 0.62);
    box-shadow: 0 0 0 4px rgba(20, 184, 166, 0.14);
    transform: translateY(-1px);
  }

  .automation-textarea {
    min-height: 120px;
    resize: vertical;
  }

  .form-row {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 14px;
  }

  .form-row-3 {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 14px;
  }

  .notice {
    display: none;
    margin-bottom: 16px;
    padding: 14px 16px;
    border-radius: 16px;
    font-weight: 600;
  }

  .notice.is-visible {
    display: block;
  }

  .notice-success {
    background: #ecfdf5;
    color: #166534;
    border: 1px solid #bbf7d0;
  }

  .notice-error {
    background: #fef2f2;
    color: #b91c1c;
    border: 1px solid #fecaca;
  }

  .notice-warning {
    background: #fffbeb;
    color: #92400e;
    border: 1px solid #fde68a;
  }

  .announcement-stack,
  .campaign-grid {
    display: grid;
    gap: 16px;
  }

  .announcement-card,
  .campaign-card {
    border-radius: 22px;
    border: 1px solid rgba(16, 37, 66, 0.1);
    background: linear-gradient(180deg, #ffffff 0%, #fbfdff 100%);
    padding: 20px;
  }

  .collapsible-card-toggle {
    width: 100%;
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 16px;
    padding: 0;
    border: none;
    background: transparent;
    color: var(--automation-ink);
    cursor: pointer;
    text-align: left;
    font: inherit;
  }

  .collapsible-card-toggle-main {
    flex: 1;
    min-width: 0;
  }

  .collapsible-card-toggle-main h3,
  .collapsible-card-toggle-main h4 {
    margin: 0;
    word-break: break-word;
  }

  .collapsible-card-summary {
    margin: 8px 0 0;
    color: var(--automation-muted);
    font-size: 0.86rem;
    line-height: 1.5;
  }

  .collapsible-card-right {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-shrink: 0;
  }

  .collapsible-card-indicator {
    min-width: 86px;
    text-align: center;
    padding: 8px 10px;
    border-radius: 999px;
    background: #eff6ff;
    color: #1d4ed8;
    font-size: 0.8rem;
    font-weight: 700;
  }

  .collapsible-card-body {
    display: none;
    margin-top: 16px;
  }

  .collapsible-card-body.is-open {
    display: block;
  }

  .campaign-card {
    position: relative;
    overflow: hidden;
    padding: 16px;
  }

  .campaign-card::before {
    content: "";
    position: absolute;
    inset: 0 auto auto 0;
    width: 100%;
    height: 4px;
    background: linear-gradient(90deg, #0f766e 0%, #14b8a6 55%, #f59e0b 100%);
  }

  .card-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 12px;
  }

  .card-header h3,
  .card-header h4 {
    margin: 0;
    color: var(--automation-ink);
  }

  .card-copy {
    margin: 0;
    white-space: pre-line;
    color: var(--automation-muted);
    line-height: 1.55;
    font-size: 0.92rem;
    word-break: break-word;
  }

  .card-meta,
  .campaign-tags,
  .recipient-chips,
  .selected-users,
  .search-results,
  .campaign-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .card-meta {
    margin-top: 14px;
  }

  .meta-pill,
  .tag-pill,
  .selected-user-chip,
  .search-result {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 12px;
    border-radius: 999px;
    background: var(--automation-surface-soft);
    color: var(--automation-ink);
    font-size: 0.8rem;
    border: 1px solid rgba(16, 37, 66, 0.08);
    max-width: 100%;
    word-break: break-word;
  }

  .campaign-card h3 {
    font-size: 1rem;
    line-height: 1.35;
  }

  .campaign-card .collapsible-card-indicator {
    min-width: 72px;
    padding: 7px 10px;
    font-size: 0.75rem;
  }

  .tag-pill.active {
    background: var(--automation-accent-soft);
    color: #115e59;
    border-color: rgba(15, 118, 110, 0.24);
  }

  .tag-pill.inactive {
    background: #fff7ed;
    color: #9a3412;
    border-color: rgba(245, 158, 11, 0.24);
  }

  .selected-user-chip button {
    border: none;
    background: transparent;
    color: inherit;
    cursor: pointer;
    padding: 0;
    font-size: 1rem;
    line-height: 1;
  }

  .campaign-actions {
    margin-top: 18px;
  }

  .search-shell {
    position: relative;
  }

  .search-results {
    position: absolute;
    left: 0;
    right: 0;
    top: calc(100% + 8px);
    z-index: 8;
    display: none;
    flex-direction: column;
    padding: 8px;
    border-radius: 18px;
    background: #fff;
    border: 1px solid rgba(16, 37, 66, 0.12);
    box-shadow: 0 18px 40px rgba(15, 23, 42, 0.14);
    max-height: 240px;
    overflow-y: auto;
  }

  .search-results.is-visible {
    display: flex;
  }

  .search-result {
    width: 100%;
    justify-content: space-between;
    cursor: pointer;
    border-radius: 14px;
    background: transparent;
  }

  .search-result:hover {
    background: #f0fdfa;
  }

  .search-result strong,
  .search-result span {
    display: block;
  }

  .search-result span {
    color: var(--automation-muted);
    font-size: 0.8rem;
  }

  .recipient-toggle {
    width: 100%;
    margin-top: 14px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    padding: 12px 14px;
    border-radius: 16px;
    border: 1px solid rgba(16, 37, 66, 0.1);
    background: #f8fbff;
    color: var(--automation-ink);
    cursor: pointer;
    text-align: left;
    font: inherit;
  }

  .recipient-toggle strong {
    display: block;
    font-size: 0.92rem;
  }

  .recipient-toggle span {
    color: var(--automation-muted);
    font-size: 0.82rem;
  }

  .recipient-toggle-indicator {
    flex-shrink: 0;
    font-size: 0.84rem;
    color: var(--automation-accent);
    font-weight: 700;
  }

  .recipient-panel {
    display: none;
    margin-top: 12px;
    padding: 14px;
    border-radius: 18px;
    background: #fbfdff;
    border: 1px solid rgba(16, 37, 66, 0.08);
  }

  .recipient-panel.is-open {
    display: block;
  }

  .recipient-list {
    display: grid;
    gap: 10px;
  }

  .recipient-line {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 12px;
    padding: 10px 12px;
    border-radius: 14px;
    background: #fff;
    border: 1px solid rgba(16, 37, 66, 0.08);
  }

  .recipient-line strong,
  .recipient-line span {
    display: block;
  }

  .recipient-line span {
    color: var(--automation-muted);
    font-size: 0.84rem;
    word-break: break-word;
  }

  .recipient-kind {
    flex-shrink: 0;
    padding: 6px 10px;
    border-radius: 999px;
    font-size: 0.75rem;
    font-weight: 700;
    background: #ecfeff;
    color: #155e75;
  }

  .empty-state {
    border-radius: 22px;
    padding: 28px 20px;
    text-align: center;
    color: var(--automation-muted);
    background: linear-gradient(180deg, #f8fbff 0%, #f8fafc 100%);
    border: 1px dashed rgba(16, 37, 66, 0.16);
  }

  /* Slide-in-from-right drawer, matching the shared ManagiraDrawer pattern
     (public/css/adminDrawer.css) used by every other composer. This modal
     is JS-heavy (live recipient search) so it stays inline rather than
     moving into an iframe - only the position/animation changed, the
     open/close JS (toggling [hidden]) is untouched. */
  .modal-shell[hidden] {
    display: none;
  }

  .modal-shell {
    position: fixed;
    inset: 0;
    z-index: 10000;
    display: flex;
    align-items: stretch;
    justify-content: flex-end;
    padding: 0;
    background: rgba(15, 23, 42, 0.54);
    backdrop-filter: blur(8px);
    animation: adminModalFadeIn 0.2s ease;
  }
  @keyframes adminModalFadeIn { from { opacity: 0; } to { opacity: 1; } }

  .modal-backdrop {
    position: absolute;
    inset: 0;
  }

  .modal-panel {
    position: relative;
    width: 100%;
    max-width: 860px;
    height: 100%;
    max-height: 100%;
    overflow-y: auto;
    border-radius: 0;
    background: linear-gradient(180deg, #ffffff 0%, #f7fbff 100%);
    border: none;
    border-left: 1px solid rgba(16, 37, 66, 0.12);
    box-shadow: -8px 0 40px rgba(15, 23, 42, 0.24);
    padding: 24px;
    animation: adminModalSlideInRight 0.28s cubic-bezier(0.22, 1, 0.36, 1);
  }
  @keyframes adminModalSlideInRight {
    from { transform: translateX(100%); opacity: 0; }
    to   { transform: translateX(0);    opacity: 1; }
  }
  @media (max-width: 500px) {
    .modal-panel { max-width: 100%; }
  }

  .modal-header {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 20px;
  }

  .modal-title {
    margin: 0;
    color: var(--automation-ink);
    font-size: 1.45rem;
  }

  .modal-subtitle {
    margin: 8px 0 0;
    color: var(--automation-muted);
    max-width: 620px;
    line-height: 1.6;
  }

  .close-modal-btn {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    border: 1px solid rgba(16, 37, 66, 0.12);
    background: #fff;
    font-size: 1.35rem;
    cursor: pointer;
  }

  .toggle-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    padding: 16px 18px;
    border-radius: 18px;
    background: rgba(15, 118, 110, 0.06);
    border: 1px solid rgba(15, 118, 110, 0.14);
  }

  .toggle-row strong {
    display: block;
    color: var(--automation-ink);
  }

  .toggle-row span {
    display: block;
    margin-top: 4px;
    color: var(--automation-muted);
    font-size: 0.88rem;
  }

  .toggle-switch {
    position: relative;
    width: 60px;
    height: 34px;
  }

  .toggle-switch input {
    opacity: 0;
    width: 0;
    height: 0;
  }

  .toggle-slider {
    position: absolute;
    inset: 0;
    border-radius: 999px;
    background: rgba(148, 163, 184, 0.9);
    transition: background 0.2s ease;
  }

  .toggle-slider::before {
    content: "";
    position: absolute;
    width: 26px;
    height: 26px;
    left: 4px;
    top: 4px;
    border-radius: 50%;
    background: #fff;
    transition: transform 0.2s ease;
  }

  .toggle-switch input:checked + .toggle-slider {
    background: linear-gradient(90deg, #0f766e 0%, #14b8a6 100%);
  }

  .toggle-switch input:checked + .toggle-slider::before {
    transform: translateX(26px);
  }

  .modal-actions {
    display: flex;
    justify-content: flex-end;
    gap: 12px;
    margin-top: 8px;
    flex-wrap: wrap;
  }

  .section-divider {
    height: 1px;
    border: none;
    background: linear-gradient(90deg, rgba(15, 118, 110, 0), rgba(15, 118, 110, 0.4), rgba(15, 118, 110, 0));
    margin: 20px 0;
  }

  .admin-btn.automation-primary {
    background: linear-gradient(135deg, #0f766e 0%, #14b8a6 100%);
    border: none;
    color: #fff;
    box-shadow: 0 2px 8px rgba(15, 118, 110, 0.22);
  }

  .admin-btn.automation-secondary {
    background: #fff;
    color: var(--automation-ink);
    border: 1px solid rgba(16, 37, 66, 0.14);
  }

  .admin-btn.automation-danger {
    background: #fff1f2;
    color: var(--automation-danger);
    border: 1px solid rgba(220, 38, 38, 0.18);
  }

  .admin-btn.automation-warm {
    background: #fff7ed;
    color: #b45309;
    border: 1px solid rgba(245, 158, 11, 0.2);
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    border: 0;
  }

  @media (max-width: 1040px) {
    .workspace-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 720px) {
    .page-head,
    .glass-panel,
    .modal-panel {
      padding: 20px;
      border-radius: 22px;
    }

    .form-row,
    .form-row-3,
    .panel-header,
    .card-header,
    .toggle-row,
    .modal-header {
      grid-template-columns: 1fr;
      flex-direction: column;
      align-items: stretch;
    }

    .panel-actions,
    .campaign-actions,
    .modal-actions {
      display: grid;
      grid-template-columns: 1fr;
    }

    .panel-actions .admin-btn,
    .campaign-actions .admin-btn,
    .modal-actions .admin-btn {
      width: 100%;
    }

    .collapsible-card-right {
      width: 100%;
      justify-content: flex-start;
      flex-wrap: wrap;
    }

    .card-meta {
      display: grid;
      grid-template-columns: 1fr;
    }

    .campaign-card {
      padding: 14px;
    }

    .modal-shell {
      padding: 12px;
    }
  }

  /* The site stylesheet gives every button full width, white text and top margins;
     reset that here so this page's buttons size to their text and line up. */
  .announcements-shell .admin-btn,
  .modal-shell .admin-btn { width: auto; margin: 0; padding: 0.625rem 1.25rem; font-size: 0.875rem; }
  .modal-shell .close-modal-btn { display: inline-flex; align-items: center; justify-content: center; flex-shrink: 0; margin: 0; padding: 0; color: var(--automation-ink); line-height: 1; }
  .la-order button { margin: 0; padding: 0; }
  .hero-actions { display: flex; flex-wrap: wrap; gap: 10px; }
  .hero-actions .admin-btn { text-decoration: none; display: inline-flex; align-items: center; gap: 8px; }
  .workspace-grid.single { grid-template-columns: minmax(0, 1fr); }
  .bc-list { display: grid; gap: 12px; }
  .bc-card { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 16px; padding: 16px 18px; border: 1px solid var(--automation-border); border-radius: 18px; background: var(--automation-surface-soft); }
  .bc-title-row { display: flex; flex-wrap: wrap; align-items: center; gap: 10px; }
  .bc-title-row h3 { margin: 0; font-size: 1.02rem; color: var(--automation-ink); }
  .bc-excerpt { margin: 6px 0 8px; color: var(--automation-muted); font-size: 0.9rem; line-height: 1.5; }
  .bc-meta { display: flex; flex-wrap: wrap; gap: 6px 14px; font-size: 0.8rem; color: var(--automation-muted); }
  .bc-school-tag { padding: 1px 8px; border-radius: 999px; background: #eef2ff; color: #3730a3; font-weight: 700; }
  .bc-side { display: grid; gap: 10px; align-content: start; justify-items: end; }
  .bc-stats { display: flex; gap: 12px; font-size: 0.82rem; color: var(--automation-muted); }
  .bc-stats b { color: var(--automation-ink); }
  .bc-actions { display: flex; flex-wrap: wrap; gap: 6px; justify-content: flex-end; }
  .bc-status { display: inline-flex; padding: 3px 10px; border-radius: 999px; font-size: 0.74rem; font-weight: 800; background: #f1f5f9; color: #475569; }
  .bc-status.live, .bc-status.active { background: #dcfce7; color: #166534; }
  .bc-status.scheduled { background: #e0f2fe; color: #075985; }
  .bc-status.paused, .bc-status.draft { background: #f1f5f9; color: #475569; }
  .bc-status.ended, .bc-status.closed { background: #fee2e2; color: #991b1b; }
  .fr-table-wrap { overflow-x: auto; }
  .fr-table { width: 100%; border-collapse: collapse; font-size: 0.9rem; }
  .fr-table th { text-align: left; padding: 10px 12px; font-size: 0.74rem; text-transform: uppercase; letter-spacing: 0.05em; color: var(--automation-muted); border-bottom: 1px solid var(--automation-border); white-space: nowrap; }
  .fr-table td { padding: 12px; border-bottom: 1px solid rgba(16, 37, 66, 0.06); vertical-align: top; color: var(--automation-ink); }
  .fr-table td small { display: block; margin-top: 3px; color: var(--automation-muted); font-size: 0.78rem; }
  .fr-table td a { color: var(--automation-ink); text-decoration: none; }
  .fr-table tbody tr { cursor: pointer; }
  .fr-table tbody tr:hover { background: var(--automation-surface-soft); }
  @media (max-width: 760px) { .bc-card { grid-template-columns: 1fr; } .bc-side { justify-items: start; } .bc-actions { justify-content: flex-start; } }
  /* Login page ads */
  .la-list { display: grid; gap: 14px; }
  .la-card { display: grid; grid-template-columns: auto minmax(0, 1fr) auto; gap: 20px; align-items: center; padding: 14px; border-radius: 18px; border: 1px solid var(--automation-border); background: #fff; }
  .la-card.is-paused { background: #f8fafc; }
  .la-card.is-paused .ad-stage { opacity: 0.55; }
  .la-thumb { width: 168px; height: 188px; padding: 10px; box-sizing: border-box; display: flex; align-items: center; justify-content: center; border-radius: 14px; background: #f1f5f9; }
  .la-thumb .ad-stage { --stage-h: 168px; border-radius: 8px; box-shadow: 0 1px 3px rgba(15, 23, 42, 0.14); }
  .la-thumb .ad-btn { font-size: calc(var(--btn-scale) * 3.2cqw); box-shadow: none; }
  .la-info h3 { margin: 0 0 8px; font-size: 1.02rem; color: var(--automation-ink); display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
  .la-meta { display: flex; flex-wrap: wrap; gap: 6px 14px; color: var(--automation-muted); font-size: 0.84rem; }
  .la-meta a { color: inherit; overflow-wrap: anywhere; }
  .la-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; justify-content: flex-end; }
  .la-places { display: flex; flex-wrap: wrap; gap: 6px; margin: 0 0 8px; }
  .la-place { display: inline-flex; align-items: center; gap: 6px; padding: 3px 10px; border-radius: 999px; background: #f0fdfa; border: 1px solid rgba(15, 118, 110, 0.18); color: #115e59; font-size: 0.78rem; font-weight: 600; }
  .la-place i { font-size: 0.72rem; opacity: 0.8; }
  .la-place--warn { background: #fff7ed; border-color: rgba(217, 119, 6, 0.25); color: #b45309; }
  .la-stats { display: flex; flex-wrap: wrap; gap: 4px 14px; margin-top: 8px; font-size: 0.8rem; color: var(--automation-muted); }
  .la-stats b { color: var(--automation-ink); }
  .la-order { display: inline-flex; gap: 4px; margin-right: 4px; }
  .la-order button { width: 34px; height: 34px; border-radius: 10px; border: 1px solid rgba(16, 37, 66, 0.14); background: #fff; cursor: pointer; color: var(--automation-ink); font-size: 0.95rem; }
  .la-order button:hover:not(:disabled) { background: #f1f5f9; }
  .la-order button:disabled { opacity: 0.35; cursor: default; }

  .la-editor { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr); gap: 24px; align-items: start; }
  .la-preview { position: sticky; top: 0; display: flex; flex-direction: column; gap: 10px; }
  .la-preview-frame { min-height: 320px; display: flex; align-items: center; justify-content: center; padding: 16px; border-radius: 20px; background: repeating-conic-gradient(#f1f5f9 0% 25%, #fff 0% 50%) 50% / 20px 20px; border: 1px solid var(--automation-border); }
  .la-preview-frame .ad-stage { --stage-h: 520px; }
  .la-preview-empty { color: var(--automation-muted); text-align: center; font-size: 0.92rem; line-height: 1.6; }
  .la-preview .ad-btn { cursor: grab; touch-action: none; user-select: none; }
  .la-preview .ad-btn.is-dragging { cursor: grabbing; outline: 2px dashed rgba(255, 255, 255, 0.9); outline-offset: 3px; }
  .la-guide { position: absolute; top: 0; bottom: 0; left: 50%; width: 0; border-left: 2px dashed rgba(255, 255, 255, 0.85); z-index: 1; display: none; pointer-events: none; }
  .la-guide.is-visible { display: block; }
  .la-hint { color: var(--automation-muted); font-size: 0.84rem; text-align: center; margin: 0; }
  .la-fields { display: grid; gap: 14px; }
  .la-drop { display: flex; flex-direction: column; align-items: center; gap: 6px; padding: 18px; border-radius: 16px; border: 2px dashed rgba(15, 118, 110, 0.35); background: rgba(15, 118, 110, 0.04); text-align: center; cursor: pointer; color: var(--automation-ink); }
  .la-drop.is-over { background: rgba(15, 118, 110, 0.1); }
  .la-drop small { color: var(--automation-muted); }
  .la-drop input { display: none; }
  .la-row { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
  .la-color { display: flex; align-items: center; gap: 10px; padding: 8px 12px; border-radius: 16px; border: 1px solid rgba(16, 37, 66, 0.14); background: #fff; }
  .la-color input[type="color"] { width: 34px; height: 34px; border: none; padding: 0; background: none; cursor: pointer; }
  .la-sizes { display: inline-flex; border: 1px solid rgba(16, 37, 66, 0.14); border-radius: 12px; overflow: hidden; }
  .la-sizes label { position: relative; }
  .la-sizes input { position: absolute; opacity: 0; }
  .la-sizes span { display: block; padding: 9px 16px; cursor: pointer; font-weight: 700; font-size: 0.85rem; color: var(--automation-muted); }
  .la-sizes input:checked + span { background: var(--automation-ink, #0f172a); color: #fff; }
  .la-sizes input:focus-visible + span { outline: 2px solid #14b8a6; outline-offset: -2px; }
  .la-button-fields[hidden], .la-app-fields[hidden], #la-max-views-field[hidden] { display: none; }
  .la-section { margin: 0; padding: 0; border: none; display: grid; gap: 10px; min-width: 0; }
  .la-section legend { padding: 0; margin-bottom: 8px; }
  .la-place-option { display: flex; align-items: flex-start; gap: 12px; padding: 12px 14px; border-radius: 14px; border: 1px solid var(--automation-border); background: #fff; cursor: pointer; }
  .la-place-option:has(input:checked) { border-color: rgba(15, 118, 110, 0.45); background: rgba(15, 118, 110, 0.05); }
  .la-place-option input { width: 18px; height: 18px; margin: 2px 0 0; accent-color: #0f766e; flex-shrink: 0; }
  .la-place-option strong { display: block; color: var(--automation-ink); font-size: 0.92rem; }
  .la-place-option small { display: block; margin-top: 2px; color: var(--automation-muted); font-size: 0.8rem; line-height: 1.45; }
  .la-app-fields { display: grid; gap: 14px; padding: 14px; border-radius: 14px; background: #f8fafc; border: 1px dashed rgba(16, 37, 66, 0.14); }
  .la-chips { display: flex; flex-wrap: wrap; gap: 6px; }
  .la-chip { position: relative; cursor: pointer; }
  .la-chip input { position: absolute; opacity: 0; pointer-events: none; }
  .la-chip span { display: inline-block; padding: 6px 12px; border-radius: 999px; border: 1px solid rgba(16, 37, 66, 0.16); background: #fff; font-size: 0.82rem; font-weight: 600; color: var(--automation-muted); }
  .la-chip input:checked + span { background: #0f766e; border-color: #0f766e; color: #fff; }
  .la-chip input:focus-visible + span { outline: 2px solid #14b8a6; outline-offset: 2px; }
  .la-error { color: var(--automation-danger, #dc2626); font-weight: 600; font-size: 0.88rem; min-height: 1.2em; margin: 0; }
  .la-fields .modal-actions { position: sticky; bottom: 0; margin: 0 -4px; padding: 12px 4px 4px; background: linear-gradient(180deg, rgba(247, 251, 255, 0) 0%, #f7fbff 30%); }
  @media (max-width: 820px) {
    .la-editor { grid-template-columns: minmax(0, 1fr); }
    .la-preview { position: static; }
    .la-preview-frame .ad-stage { --stage-h: 420px; }
    .la-card { grid-template-columns: auto minmax(0, 1fr); gap: 14px; }
    .la-thumb { width: 124px; height: 140px; padding: 8px; }
    .la-thumb .ad-stage { --stage-h: 124px; }
    .la-actions { grid-column: 1 / -1; justify-content: flex-start; }
  }
</style>
<link rel="stylesheet" href="<%= assetUrl('/css/loginAds.css') %>" />

<%
  const campaignList = Array.isArray(campaigns) ? campaigns : [];
  const totalRecipients = campaignList.reduce((sum, campaign) => {
    const manualCount = Array.isArray(campaign.manualEmails) ? campaign.manualEmails.length : 0;
    const userCount = Array.isArray(campaign.targetUserIds) ? campaign.targetUserIds.length : 0;
    return sum + manualCount + userCount;
  }, 0);
  const broadcastList = Array.isArray(typeof broadcasts !== 'undefined' ? broadcasts : null) ? broadcasts : [];
  const feedbackList = Array.isArray(typeof feedbackRequests !== 'undefined' ? feedbackRequests : null) ? feedbackRequests : [];
  const loginAdList = Array.isArray(typeof loginAds !== 'undefined' ? loginAds : null) ? loginAds : [];
%>

<div class="announcements-shell">
  <section class="page-head">
    <div>
      <span class="eyebrow">Admin Broadcast Center</span>
      <h1 class="page-head__title">Announcements, feedback and scheduled emails</h1>
    </div>
    <div class="hero-actions">
      <button type="button" class="admin-btn automation-primary" id="open-admin-announcement-drawer"><i class="fa-solid fa-bullhorn" aria-hidden="true"></i> New Announcement</button>
      <button type="button" class="admin-btn automation-secondary open-request-feedback-drawer"><i class="fa-solid fa-star" aria-hidden="true"></i> Request Feedback</button>
      <button type="button" class="admin-btn automation-secondary" data-la-new><i class="fa-solid fa-rectangle-ad" aria-hidden="true"></i> New Ad</button>
    </div>
  </section>

  <%- include('../partials/flash') %>

  <section class="glass-panel" id="announcementList">
    <div class="panel-header">
      <div>
        <h2 class="panel-title">Announcements</h2>
        <p class="panel-subtitle">Pop-ups, banners and dashboard notices. Each shows where and how often you chose.</p>
      </div>
    </div>
    <% if (!broadcastList.length) { %>
      <div class="empty-state">No announcements yet. Create one with "New Announcement".</div>
    <% } else { %>
      <div class="bc-list">
        <% broadcastList.forEach((b) => { %>
          <article class="bc-card" data-id="<%= b.id %>">
            <div class="bc-main">
              <div class="bc-title-row">
                <h3><%= b.title %></h3>
                <span class="bc-status <%= b.status.toLowerCase() %>"><%= b.status %></span>
              </div>
              <p class="bc-excerpt"><%= b.excerpt %><%= b.excerpt.length >= 160 ? '...' : '' %></p>
              <div class="bc-meta">
                <span><%= b.audience %></span>
                <span><%= b.format %> &middot; <%= b.frequency %></span>
                <span><%= new Date(b.startsAt).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) %><%= b.endsAt ? ' - ' + new Date(b.endsAt).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) : '' %></span>
                <% if (b.createdBySchool) { %><span class="bc-school-tag">Created by the school</span><% } %>
              </div>
            </div>
            <div class="bc-side">
              <div class="bc-stats"><span><b><%= b.stats.seen %></b> seen</span><span><b><%= b.stats.dismissed %></b> closed</span><% if (b.stats.acknowledged) { %><span><b><%= b.stats.acknowledged %></b> clicked</span><% } %></div>
              <div class="bc-actions">
                <button type="button" class="admin-btn automation-secondary" data-bc-edit="<%= b.id %>">Edit</button>
                <button type="button" class="admin-btn <%= b.isActive ? 'automation-warm' : 'automation-primary' %>" data-bc-active="<%= b.isActive ? 'false' : 'true' %>" data-id="<%= b.id %>"><%= b.isActive ? 'Pause' : 'Resume' %></button>
                <button type="button" class="admin-btn automation-danger" data-bc-delete="<%= b.id %>">Delete</button>
              </div>
            </div>
          </article>
        <% }) %>
      </div>
    <% } %>
  </section>

  <section class="glass-panel" id="loginAdsPanel">
    <div class="panel-header">
      <div>
        <h2 class="panel-title">Ads</h2>
        <p class="panel-subtitle">Beside the sign-in form and as a small card inside the app. Live ads rotate in this order; in the app an ad waits until pop-ups and feedback requests are closed.</p>
      </div>
      <button type="button" class="admin-btn automation-primary" data-la-new><i class="fa-solid fa-plus" aria-hidden="true"></i> New Ad</button>
    </div>
    <% if (!loginAdList.length) { %>
      <div class="empty-state">No ads yet. Add one with "New Ad".</div>
    <% } else { %>
      <%
        const AD_POSITIONS = { 'bottom-right': 'Bottom right', 'bottom-left': 'Bottom left', center: 'Center' };
        const AD_FREQUENCIES = { once: 'Once', until_dismissed: 'Until closed', once_per_session: 'Once per sign-in', every_login: 'Every page', daily: 'Once a day', n_times: 'times' };
        const AD_ROLES = { manager: 'Managers', supervisor: 'Supervisors', teacher: 'Teachers', driver: 'Drivers', parent: 'Parents', student: 'Students', super_admin: 'Managira team' };
        const fmtDate = (d) => new Date(d).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
        const nowTs = Date.now();
      %>
      <div class="la-list">
        <% loginAdList.forEach((ad, i) => {
             const ar = (ad.media_width && ad.media_height) ? (ad.media_width / ad.media_height).toFixed(4) : '0.75';
             const typeLabel = { image: 'Image', pdf: 'PDF', video: 'Video' }[ad.media_type] || 'File';
             const status = !ad.is_active ? 'Paused'
               : (ad.starts_at && new Date(ad.starts_at).getTime() > nowTs) ? 'Scheduled'
               : (ad.ends_at && new Date(ad.ends_at).getTime() <= nowTs) ? 'Ended' : 'Live';
             const roles = (ad.app_roles || []).map((r) => AD_ROLES[r] || r);
             const freq = ad.app_frequency === 'n_times' ? `${ad.app_max_views || 3} times` : (AD_FREQUENCIES[ad.app_frequency] || 'Once per sign-in');
        %>
          <article class="la-card<%= status === 'Live' ? '' : ' is-paused' %>" data-la-id="<%= ad.id %>">
            <div class="la-thumb">
              <div class="ad-stage" style="--ar: <%= ar %>;">
                <% if (ad.media_type === 'video') { %>
                  <video src="<%= ad.file_url %>" muted playsinline preload="metadata"></video>
                <% } else if (ad.media_type === 'pdf') { %>
                  <canvas data-pdf-src="<%= ad.file_url %>"></canvas>
                <% } else { %>
                  <img src="<%= ad.file_url %>" alt="" loading="lazy" />
                <% } %>
                <% if (ad.link_url && ad.show_as_button) { %>
                  <span class="ad-btn ad-btn--<%= ad.button_size %>" style="left: <%= ad.button_x %>%; top: <%= ad.button_y %>%; background: <%= ad.button_color %>; color: <%= ad.button_text_color %>;"><%= ad.link_label || 'Learn more' %></span>
                <% } %>
              </div>
            </div>
            <div class="la-info">
              <h3><%= ad.title || ('Ad #' + ad.id) %> <span class="bc-status <%= status.toLowerCase() %>"><%= status %></span></h3>
              <div class="la-places">
                <% if (ad.show_on_login) { %><span class="la-place"><i class="fa-solid fa-right-to-bracket" aria-hidden="true"></i> Sign-in pages</span><% } %>
                <% if (ad.show_in_app) { %><span class="la-place"><i class="fa-solid fa-window-maximize" aria-hidden="true"></i> In app &middot; <%= AD_POSITIONS[ad.app_position] || 'Bottom right' %> &middot; <%= freq %> &middot; <%= roles.length ? roles.join(', ') : 'Everyone' %></span><% } %>
                <% if (!ad.show_on_login && !ad.show_in_app) { %><span class="la-place la-place--warn">Not shown anywhere yet</span><% } %>
              </div>
              <div class="la-meta">
                <span><%= typeLabel %></span>
                <% if (ad.link_url) { %>
                  <span><%= ad.show_as_button ? 'Button' : 'Whole ad' %> &rarr; <a href="<%= ad.link_url %>" target="_blank" rel="noopener"><%= ad.link_url %></a></span>
                <% } else { %>
                  <span>No link</span>
                <% } %>
                <% if (ad.starts_at || ad.ends_at) { %>
                  <span><%= ad.starts_at ? fmtDate(ad.starts_at) : 'Now' %> &ndash; <%= ad.ends_at ? fmtDate(ad.ends_at) : 'No end' %></span>
                <% } %>
              </div>
              <div class="la-stats">
                <% if (ad.show_on_login || ad.login_clicks) { %><span><b><%= ad.login_clicks || 0 %></b> sign-in clicks</span><% } %>
                <% if (ad.show_in_app || ad.app_seen) { %><span><b><%= ad.app_seen || 0 %></b> seen in app</span><span><b><%= ad.app_clicked || 0 %></b> clicked</span><span><b><%= ad.app_closed || 0 %></b> closed</span><% } %>
              </div>
            </div>
            <div class="la-actions">
              <span class="la-order">
                <button type="button" data-la-move="-1" aria-label="Move up"<%= i === 0 ? ' disabled' : '' %>>&uarr;</button>
                <button type="button" data-la-move="1" aria-label="Move down"<%= i === loginAdList.length - 1 ? ' disabled' : '' %>>&darr;</button>
              </span>
              <button type="button" class="admin-btn automation-secondary" data-la-edit>Edit</button>
              <button type="button" class="admin-btn <%= ad.is_active ? 'automation-warm' : 'automation-primary' %>" data-la-toggle="<%= ad.is_active ? 'false' : 'true' %>"><%= ad.is_active ? 'Pause' : 'Go live' %></button>
              <button type="button" class="admin-btn automation-danger" data-la-delete>Delete</button>
            </div>
          </article>
        <% }) %>
      </div>
    <% } %>
  </section>

  <section class="glass-panel" id="feedbackRequestList">
    <div class="panel-header">
      <div>
        <h2 class="panel-title">Feedback requests</h2>
        <p class="panel-subtitle">Star ratings and comments from the people you choose. Open one to see results and export them.</p>
      </div>
      <button type="button" class="admin-btn automation-primary open-request-feedback-drawer"><i class="fa-solid fa-star" aria-hidden="true"></i> Request Feedback</button>
    </div>
    <% if (!feedbackList.length) { %>
      <div class="empty-state">No feedback requests yet.</div>
    <% } else { %>
      <div class="fr-table-wrap">
        <table class="fr-table">
          <thead><tr><th>Feedback request</th><th>Recipients</th><th>Responses</th><th>Average</th><th>Status</th></tr></thead>
          <tbody>
            <% feedbackList.forEach((f) => { %>
              <tr data-href="/admin/feedback-requests/<%= f.id %>" tabindex="0">
                <td><a href="/admin/feedback-requests/<%= f.id %>"><strong><%= f.title %></strong></a><small><%= f.audience %> &middot; <%= f.frequency %><%= f.anonymous ? ' &middot; Anonymous' : '' %></small></td>
                <td><%= f.recipients %></td>
                <td><%= f.responses %><% if (f.totalResponses !== f.responses) { %><small><%= f.totalResponses %> in total</small><% } %></td>
                <td><%= f.averageRating !== null ? f.averageRating.toFixed(1) + ' ★' : '-' %></td>
                <td><span class="bc-status <%= f.state %>"><%= f.stateLabel %></span></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } %>
  </section>

  <div class="workspace-grid single">
    <section class="glass-panel">
      <div class="panel-header">
        <div>
          <h2 class="panel-title">Scheduled emails</h2>
          <p class="panel-subtitle">Recurring or one-time emails to the people you choose.</p>
        </div>
        <div class="panel-actions">
          <button type="button" id="open-campaign-modal" class="admin-btn automation-primary">Add automated email</button>
        </div>
      </div>

      <div id="campaign-notice" class="notice" role="status" aria-live="polite"></div>

      <div id="campaign-grid" class="campaign-grid"></div>
    </section>
  </div>

</div>

<section id="campaign-modal" class="modal-shell" hidden>
  <div class="modal-backdrop" data-close-modal></div>
  <div class="modal-panel" role="dialog" aria-modal="true" aria-labelledby="campaign-modal-title">
    <div class="modal-header">
      <div>
        <h2 id="campaign-modal-title" class="modal-title">Add automated email</h2>
        <p class="modal-subtitle">Create a scheduled email without leaving this page. You can target users from the platform, add manual email addresses, and enable or disable the schedule any time.</p>
      </div>
      <button type="button" class="close-modal-btn" data-close-modal aria-label="Close scheduled email form">&times;</button>
    </div>

    <form id="campaign-form" class="campaign-form-grid">
      <input type="hidden" id="campaign-id" />

      <div class="toggle-row">
        <div>
          <strong>Automation status</strong>
          <span>Keep the campaign ready but inactive until you want it to start sending.</span>
        </div>
        <label class="toggle-switch" for="campaign-active">
          <input id="campaign-active" type="checkbox" checked />
          <span class="toggle-slider"></span>
          <span class="visually-hidden">Active status</span>
        </label>
      </div>

      <div>
        <label class="field-label" for="campaign-subject">Email subject</label>
        <input id="campaign-subject" class="automation-input" type="text" placeholder="Monthly account health update" required />
      </div>

      <div>
        <label class="field-label" for="campaign-content">Main content</label>
        <textarea id="campaign-content" class="automation-textarea" placeholder="Write the email body here. Pasted links such as https://example.com are sent as clickable links." required></textarea>
        <p class="field-help">Line breaks are preserved and pasted URLs become clickable links in the email.</p>
      </div>

      <div class="form-row">
        <div>
          <label class="field-label" for="campaign-frequency">Schedule</label>
          <select id="campaign-frequency" class="automation-select">
            <option value="once">One time</option>
            <option value="every_1_minute">Every 1 minute</option>
            <option value="every_5_minutes">Every 5 minutes</option>
            <option value="every_10_minutes">Every 10 minutes</option>
            <option value="daily">Daily</option>
            <option value="every_2_days">Every 2 days</option>
            <option value="weekly">Weekly</option>
            <option value="monthly">Monthly</option>
          </select>
        </div>
        <div>
          <label class="field-label" for="campaign-send-time">Send time</label>
          <input id="campaign-send-time" class="automation-input" type="time" value="09:00" required />
        </div>
      </div>

      <div class="form-row-3">
        <div>
          <label class="field-label" for="campaign-start-date">Start date</label>
          <input id="campaign-start-date" class="automation-input" type="date" required />
        </div>
        <div>
          <label class="field-label" for="campaign-end-date">End date</label>
          <input id="campaign-end-date" class="automation-input" type="date" />
        </div>
        <div id="campaign-weekday-field" hidden>
          <label class="field-label" for="campaign-day-of-week">Day of week</label>
          <select id="campaign-day-of-week" class="automation-select">
            <option value="0">Sunday</option>
            <option value="1">Monday</option>
            <option value="2">Tuesday</option>
            <option value="3">Wednesday</option>
            <option value="4">Thursday</option>
            <option value="5">Friday</option>
            <option value="6">Saturday</option>
          </select>
        </div>
      </div>

      <div id="campaign-monthday-field" hidden>
        <label class="field-label" for="campaign-day-of-month">Day of month</label>
        <input id="campaign-day-of-month" class="automation-input" type="number" min="1" max="31" placeholder="15" />
      </div>

      <div>
        <label class="field-label" for="campaign-user-search">Choose existing users</label>
        <div class="search-shell">
          <input id="campaign-user-search" class="automation-input" type="search" placeholder="Search by name, email, or role" autocomplete="off" />
          <div id="campaign-search-results" class="search-results" role="listbox"></div>
        </div>
        <div id="selected-users" class="selected-users" style="margin-top: 12px;"></div>
      </div>

      <div>
        <label class="field-label" for="campaign-manual-emails">Manual email addresses</label>
        <textarea id="campaign-manual-emails" class="automation-textarea" placeholder="person@example.com&#10;another@example.com"></textarea>
        <p class="field-help">Separate addresses with a comma, semicolon, or a new line.</p>
      </div>

      <div class="modal-actions">
        <button type="button" class="admin-btn automation-secondary" data-close-modal>Cancel</button>
        <button type="submit" id="save-campaign-btn" class="admin-btn automation-primary">Save automated email</button>
      </div>
    </form>
  </div>
</section>

<section id="la-modal" class="modal-shell" hidden>
  <div class="modal-backdrop" data-la-close></div>
  <div class="modal-panel" role="dialog" aria-modal="true" aria-labelledby="la-modal-title" style="max-width: 1040px;">
    <div class="modal-header">
      <div>
        <h2 id="la-modal-title" class="modal-title">New ad</h2>
        <p class="modal-subtitle">Upload an image, PDF or video, add a link and drag the button where it should sit. Then choose where and how often it shows.</p>
      </div>
      <button type="button" class="close-modal-btn" data-la-close aria-label="Close ad editor">&times;</button>
    </div>

    <form id="la-form" class="la-editor" novalidate>
      <div class="la-preview">
        <div class="la-preview-frame" id="la-preview-frame">
          <p class="la-preview-empty">Your ad preview appears here.<br />Choose a file to start.</p>
        </div>
        <p class="la-hint" id="la-hint" hidden>Drag the button to move it. Arrow keys nudge it (hold Shift for bigger steps).</p>
      </div>

      <div class="la-fields">
        <label class="la-drop" id="la-drop">
          <input type="file" id="la-file" accept="image/jpeg,image/png,image/gif,image/webp,application/pdf,video/mp4,video/webm" />
          <strong id="la-drop-title">Choose or drop a file</strong>
          <small>JPG, PNG, GIF, WebP, PDF (first page), MP4 or WebM &middot; up to 50 MB</small>
          <small id="la-file-name"></small>
        </label>

        <div>
          <label class="field-label" for="la-title">Name</label>
          <input class="automation-input" id="la-title" maxlength="200" placeholder="e.g. Back to school 2026" />
          <div class="field-help">Used as the image description for screen readers.</div>
        </div>

        <div>
          <label class="field-label" for="la-link">Link</label>
          <input class="automation-input" id="la-link" maxlength="2000" placeholder="https://example.com or /legal/request-demo" />
        </div>

        <div class="toggle-row">
          <div>
            <strong>Show the link as a button</strong>
            <span>Off: the whole ad is clickable instead.</span>
          </div>
          <label class="toggle-switch" for="la-as-button">
            <input id="la-as-button" type="checkbox" checked />
            <span class="toggle-slider"></span>
            <span class="visually-hidden">Show the link as a button</span>
          </label>
        </div>

        <div class="la-button-fields" id="la-button-fields">
          <div style="display: grid; gap: 14px;">
            <div>
              <label class="field-label" for="la-label">Button text</label>
              <input class="automation-input" id="la-label" maxlength="80" placeholder="Register Now" />
            </div>
            <div class="la-row">
              <div>
                <span class="field-label">Button color</span>
                <label class="la-color"><input type="color" id="la-color" value="#e4572e" /> <span id="la-color-value">#e4572e</span></label>
              </div>
              <div>
                <span class="field-label">Text color</span>
                <label class="la-color"><input type="color" id="la-text-color" value="#ffffff" /> <span id="la-text-color-value">#ffffff</span></label>
              </div>
            </div>
            <div>
              <span class="field-label">Button size</span>
              <div class="la-sizes" role="radiogroup" aria-label="Button size">
                <label><input type="radio" name="la-size" value="sm" /><span>Small</span></label>
                <label><input type="radio" name="la-size" value="md" checked /><span>Medium</span></label>
                <label><input type="radio" name="la-size" value="lg" /><span>Large</span></label>
              </div>
            </div>
          </div>
        </div>

        <fieldset class="la-section">
          <legend class="field-label">Where it shows</legend>
          <label class="la-place-option">
            <input type="checkbox" id="la-on-login" checked />
            <span><strong>Sign-in pages</strong><small>Beside the form on the login, parent, student, hub and reset-password pages.</small></span>
          </label>
          <label class="la-place-option">
            <input type="checkbox" id="la-in-app" />
            <span><strong>Inside the app</strong><small>A small card after people sign in. It waits until pop-ups and feedback requests are closed.</small></span>
          </label>

          <div class="la-app-fields" id="la-app-fields" hidden>
            <div>
              <span class="field-label">Position</span>
              <div class="la-sizes" role="radiogroup" aria-label="Position in the app">
                <label><input type="radio" name="la-position" value="bottom-right" checked /><span>Bottom right</span></label>
                <label><input type="radio" name="la-position" value="bottom-left" /><span>Bottom left</span></label>
                <label><input type="radio" name="la-position" value="center" /><span>Center</span></label>
              </div>
            </div>
            <div class="la-row">
              <div>
                <label class="field-label" for="la-frequency">How often</label>
                <select class="automation-select" id="la-frequency">
                  <option value="once_per_session">Once per sign-in</option>
                  <option value="once">Once</option>
                  <option value="daily">Once a day</option>
                  <option value="n_times">A set number of times</option>
                  <option value="until_dismissed">Until they close it</option>
                  <option value="every_login">On every page</option>
                </select>
              </div>
              <div id="la-max-views-field" hidden>
                <label class="field-label" for="la-max-views">Number of times</label>
                <input class="automation-input" type="number" id="la-max-views" min="1" max="1000" value="3" />
              </div>
            </div>
            <div>
              <span class="field-label">Who sees it</span>
              <div class="la-chips">
                <% [['manager','Managers'],['supervisor','Supervisors'],['teacher','Teachers'],['driver','Drivers'],['parent','Parents'],['student','Students'],['super_admin','Managira team']].forEach(([value, label]) => { %>
                  <label class="la-chip"><input type="checkbox" class="la-role" value="<%= value %>" /><span><%= label %></span></label>
                <% }) %>
              </div>
              <div class="field-help">Leave all unticked to show it to everyone who signs in.</div>
            </div>
          </div>
        </fieldset>

        <div class="la-row">
          <div>
            <label class="field-label" for="la-starts">Starts (optional)</label>
            <input class="automation-input" type="datetime-local" id="la-starts" />
          </div>
          <div>
            <label class="field-label" for="la-ends">Ends (optional)</label>
            <input class="automation-input" type="datetime-local" id="la-ends" />
          </div>
        </div>

        <div class="toggle-row">
          <div>
            <strong>Live</strong>
            <span>Turn off to keep the ad saved but hidden everywhere.</span>
          </div>
          <label class="toggle-switch" for="la-active">
            <input id="la-active" type="checkbox" checked />
            <span class="toggle-slider"></span>
            <span class="visually-hidden">Live</span>
          </label>
        </div>

        <p class="la-error" id="la-error" role="alert"></p>

        <div class="modal-actions">
          <button type="button" class="admin-btn automation-secondary" data-la-close>Cancel</button>
          <button type="submit" class="admin-btn automation-primary" id="la-save">Save ad</button>
        </div>
      </div>
    </form>
  </div>
</section>

<%- include('../partials/adminDrawer') %>
<script>
  (() => {
    const adminAnnouncementDrawer = ManagiraDrawer.create({
      id: 'adminAnnouncement',
      icon: '📢',
      title: 'Announcement',
      subtitle: 'Pop-up or banner for the people you choose',
      listPagePath: '/admin/announcements',
      width: 640,
    });
    document.getElementById('open-admin-announcement-drawer').addEventListener('click', function () {
      adminAnnouncementDrawer.open('/admin/announcements/compose?embed=workspace');
    });
    const feedbackRequestDrawer = ManagiraDrawer.create({
      id: 'feedbackRequest',
      icon: '⭐',
      title: 'Request Feedback',
      subtitle: 'Ask people to rate their experience',
      listPagePath: '/admin/announcements',
      width: 640,
    });
    document.querySelectorAll('.open-request-feedback-drawer').forEach(function (button) {
      button.addEventListener('click', function () {
        feedbackRequestDrawer.open('/admin/feedback-requests/new?embed=workspace');
      });
    });
    document.querySelectorAll('[data-bc-edit]').forEach(function (button) {
      button.addEventListener('click', function () {
        adminAnnouncementDrawer.open('/admin/announcements/compose?embed=workspace&id=' + button.getAttribute('data-bc-edit'));
      });
    });
    document.querySelectorAll('[data-bc-active]').forEach(function (button) {
      button.addEventListener('click', async function () {
        button.disabled = true;
        const res = await fetch('/admin/broadcasts/' + button.dataset.id + '/active', { method: 'POST', credentials: 'same-origin', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ active: button.dataset.bcActive === 'true' }) });
        if (res.ok) window.location.reload(); else { button.disabled = false; alert('Could not update the announcement.'); }
      });
    });
    document.querySelectorAll('[data-bc-delete]').forEach(function (button) {
      button.addEventListener('click', async function () {
        if (!confirm('Delete this announcement? People will stop seeing it.')) return;
        button.disabled = true;
        const res = await fetch('/admin/broadcasts/' + button.getAttribute('data-bc-delete') + '/delete', { method: 'POST', credentials: 'same-origin' });
        if (res.ok) window.location.reload(); else { button.disabled = false; alert('Could not delete the announcement.'); }
      });
    });
    document.querySelectorAll('.fr-table tr[data-href]').forEach(function (row) {
      row.addEventListener('click', function (event) { if (!event.target.closest('a')) window.location.href = row.dataset.href; });
      row.addEventListener('keydown', function (event) { if (event.key === 'Enter') window.location.href = row.dataset.href; });
    });
  })();
</script>
<script>
  (() => {
    const campaignsEndpoint = '/admin/announcements/email-campaigns';
    const recipientsEndpoint = '/admin/announcements/email-recipients';
    let campaigns = <%- JSON.stringify(campaignList).replace(/</g, '\\u003c') %>;
    let selectedUsers = new Map();
    let searchResultCache = new Map();
    let expandedCampaigns = new Set();
    let searchTimer = null;

    const modal = document.getElementById('campaign-modal');
    const openModalButton = document.getElementById('open-campaign-modal');
    const closeModalButtons = Array.from(document.querySelectorAll('[data-close-modal]'));
    const campaignGrid = document.getElementById('campaign-grid');
    const notice = document.getElementById('campaign-notice');
    const campaignForm = document.getElementById('campaign-form');
    const campaignIdInput = document.getElementById('campaign-id');
    const subjectInput = document.getElementById('campaign-subject');
    const contentInput = document.getElementById('campaign-content');
    const frequencyInput = document.getElementById('campaign-frequency');
    const sendTimeInput = document.getElementById('campaign-send-time');
    const startDateInput = document.getElementById('campaign-start-date');
    const endDateInput = document.getElementById('campaign-end-date');
    const weekdayField = document.getElementById('campaign-weekday-field');
    const weekdayInput = document.getElementById('campaign-day-of-week');
    const monthdayField = document.getElementById('campaign-monthday-field');
    const monthdayInput = document.getElementById('campaign-day-of-month');
    const activeInput = document.getElementById('campaign-active');
    const manualEmailsInput = document.getElementById('campaign-manual-emails');
    const userSearchInput = document.getElementById('campaign-user-search');
    const searchResults = document.getElementById('campaign-search-results');
    const selectedUsersContainer = document.getElementById('selected-users');
    const saveButton = document.getElementById('save-campaign-btn');
    const modalTitle = document.getElementById('campaign-modal-title');
    let expandedCards = new Set();

    function escapeHtml(value) {
      return String(value || '')
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#39;');
    }

    function formatDate(value) {
      if (!value) return 'Not set';
      const date = new Date(value);
      if (Number.isNaN(date.getTime())) return String(value);
      return date.toLocaleDateString(undefined, {
        year: 'numeric',
        month: 'short',
        day: 'numeric',
      });
    }

    function formatDateTime(value) {
      if (!value) return 'Pending';
      const date = new Date(value);
      if (Number.isNaN(date.getTime())) return String(value);
      return date.toLocaleString(undefined, {
        year: 'numeric',
        month: 'short',
        day: 'numeric',
        hour: 'numeric',
        minute: '2-digit',
      });
    }

    function getToday() {
      const today = new Date();
      const month = String(today.getMonth() + 1).padStart(2, '0');
      const day = String(today.getDate()).padStart(2, '0');
      return `${today.getFullYear()}-${month}-${day}`;
    }

    function showNotice(message, type) {
      notice.textContent = message;
      if (type === 'error') {
        notice.className = 'notice is-visible notice-error';
        return;
      }
      if (type === 'warning') {
        notice.className = 'notice is-visible notice-warning';
        return;
      }
      notice.className = 'notice is-visible notice-success';
    }

    function clearNotice() {
      notice.className = 'notice';
      notice.textContent = '';
    }

    function normalizeFrequencyLabel(value) {
      const frequency = String(value || '').toLowerCase();
      if (frequency === 'every_3_minutes') {
        return 'every_5_minutes';
      }
      return frequency;
    }

    function sanitizeLegacyCopy(value) {
      return String(value || '')
        .replace(/every[-\s]?3[-\s]?minutes/gi, 'every 5 minutes')
        .replace(/every[-\s]?3[-\s]?mins/gi, 'every 5 mins');
    }

    function scheduleDescription(campaign) {
      const frequency = normalizeFrequencyLabel(campaign.frequency);
      const time = campaign.sendTime || '09:00';
      if (frequency === 'every_1_minute') {
        return 'Every 1 minute';
      }
      if (frequency === 'every_5_minutes') {
        return 'Every 5 minutes';
      }
      if (frequency === 'every_10_minutes') {
        return 'Every 10 minutes';
      }
      if (frequency === 'daily') {
        return `Daily at ${time}`;
      }
      if (frequency === 'every_2_days') {
        return `Every 2 days at ${time}`;
      }
      if (frequency === 'weekly') {
        const day = ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'][Number(campaign.dayOfWeek) || 0];
        return `Weekly on ${day} at ${time}`;
      }
      if (frequency === 'monthly') {
        return `Monthly on day ${campaign.dayOfMonth || 1} at ${time}`;
      }
      return `One time on ${formatDate(campaign.startDate)} at ${time}`;
    }

    function renderCampaigns() {
      if (!Array.isArray(campaigns) || campaigns.length === 0) {
        campaignGrid.innerHTML = '<div class="empty-state">No automated emails yet. Click "Add automated email" to create the first one.</div>';
        return;
      }

      campaignGrid.innerHTML = campaigns.map((campaign) => {
        const targetUsers = Array.isArray(campaign.targetUsers) ? campaign.targetUsers : [];
        const manualEmails = Array.isArray(campaign.manualEmails) ? campaign.manualEmails : [];
        const recipientSummary = [];
        if (targetUsers.length > 0) {
          recipientSummary.push(`${targetUsers.length} platform user${targetUsers.length === 1 ? '' : 's'}`);
        }
        if (manualEmails.length > 0) {
          recipientSummary.push(`${manualEmails.length} manual email${manualEmails.length === 1 ? '' : 's'}`);
        }
        const recipients = [
          ...targetUsers.map((user) => ({
            label: user.name || user.email,
            secondary: user.email,
            kind: 'Platform user',
          })),
          ...manualEmails.map((email) => ({
            label: email,
            secondary: 'Manual email',
            kind: 'Manual',
          })),
        ];
        const recipientCount = recipients.length;
        const isExpanded = expandedCampaigns.has(Number(campaign.id));
        const isRecoveredScheduleNote = String(campaign.lastError || '') === 'Recovered schedule after missing next run timestamp.';
        const statusNoticeClass = isRecoveredScheduleNote ? 'notice-warning' : 'notice-error';
        const recipientLines = recipients.map((recipient) => `
          <div class="recipient-line">
            <div>
              <strong>${escapeHtml(recipient.label)}</strong>
              <span>${escapeHtml(recipient.secondary)}</span>
            </div>
            <span class="recipient-kind">${escapeHtml(recipient.kind)}</span>
          </div>
        `).join('');

        return `
          <article class="campaign-card" data-campaign-id="${campaign.id}">
            <button type="button" class="collapsible-card-toggle" data-action="toggle-card" data-card-id="campaign-${campaign.id}" aria-expanded="${expandedCards.has(`campaign-${campaign.id}`) ? 'true' : 'false'}">
              <span class="collapsible-card-toggle-main">
                <h3>${escapeHtml(sanitizeLegacyCopy(campaign.subject))}</h3>
                <p class="collapsible-card-summary">${escapeHtml(scheduleDescription(campaign))}</p>
              </span>
              <span class="collapsible-card-right">
                <span class="tag-pill ${campaign.isActive ? 'active' : 'inactive'}">${campaign.isActive ? 'Active' : 'Inactive'}</span>
                <span class="collapsible-card-indicator">${expandedCards.has(`campaign-${campaign.id}`) ? 'Hide' : 'Expand'}</span>
              </span>
            </button>
            <div class="collapsible-card-body ${expandedCards.has(`campaign-${campaign.id}`) ? 'is-open' : ''}" data-card-body="campaign-${campaign.id}">
              <p class="card-copy">${escapeHtml(sanitizeLegacyCopy(campaign.content))}</p>
              <div class="card-meta">
                <span class="meta-pill">Recipients: ${escapeHtml(recipientSummary.join(' + ') || 'None')}</span>
                <span class="meta-pill">Starts: ${escapeHtml(formatDate(campaign.startDate))}</span>
                <span class="meta-pill">Next send: ${escapeHtml(campaign.nextRunAt ? formatDateTime(campaign.nextRunAt) : (campaign.isActive && String(campaign.frequency || '').toLowerCase() !== 'once' ? 'Calculating next run...' : 'Not scheduled'))}</span>
                <span class="meta-pill">Last sent: ${escapeHtml(campaign.lastSentAt ? formatDateTime(campaign.lastSentAt) : 'Not yet sent')}</span>
              </div>
              ${(campaign.lastError ? `<div class="notice is-visible ${statusNoticeClass}" style="margin-top: 14px;">${escapeHtml(campaign.lastError)}</div>` : '')}
              ${recipientCount > 0 ? `
                <button
                  type="button"
                  class="recipient-toggle"
                  data-action="toggle-recipients"
                  data-id="${campaign.id}"
                  aria-expanded="${isExpanded ? 'true' : 'false'}"
                >
                  <span>
                    <strong>${isExpanded ? 'Hide recipients' : 'Show recipients'}</strong>
                    <span>${escapeHtml(recipientSummary.join(' + ') || `${recipientCount} recipients`)}</span>
                  </span>
                  <span class="recipient-toggle-indicator">${isExpanded ? 'Hide' : `Expand ${recipientCount}`}</span>
                </button>
                <div class="recipient-panel ${isExpanded ? 'is-open' : ''}">
                  <div class="recipient-list">
                    ${recipientLines}
                  </div>
                </div>
              ` : ''}
              <div class="campaign-actions">
                <button type="button" class="admin-btn automation-secondary" data-action="edit" data-id="${campaign.id}">Edit</button>
                <button type="button" class="admin-btn ${campaign.isActive ? 'automation-warm' : 'automation-primary'}" data-action="toggle" data-id="${campaign.id}">${campaign.isActive ? 'Make inactive' : 'Activate'}</button>
                <button type="button" class="admin-btn automation-danger" data-action="delete" data-id="${campaign.id}">Delete</button>
              </div>
            </div>
          </article>
        `;
      }).join('');
    }

    function updateScheduleFieldVisibility() {
      const frequency = frequencyInput.value;
      weekdayField.hidden = frequency !== 'weekly';
      monthdayField.hidden = frequency !== 'monthly';
    }

    function resetForm() {
      campaignForm.reset();
      selectedUsers = new Map();
      campaignIdInput.value = '';
      modalTitle.textContent = 'Add automated email';
      activeInput.checked = true;
      frequencyInput.value = 'every_5_minutes';
      sendTimeInput.value = '09:00';
      startDateInput.value = getToday();
      endDateInput.value = '';
      weekdayInput.value = '1';
      monthdayInput.value = '';
      renderSelectedUsers();
      renderSearchResults([]);
      updateScheduleFieldVisibility();
    }

    function openModal(campaign) {
      resetForm();
      if (campaign) {
        const normalizedFrequency = normalizeFrequencyLabel(campaign.frequency || 'once') || 'once';
        modalTitle.textContent = 'Edit automated email';
        campaignIdInput.value = campaign.id;
        subjectInput.value = sanitizeLegacyCopy(campaign.subject || '');
        contentInput.value = sanitizeLegacyCopy(campaign.content || '');
        frequencyInput.value = normalizedFrequency;
        sendTimeInput.value = campaign.sendTime || '09:00';
        startDateInput.value = campaign.startDate ? String(campaign.startDate).slice(0, 10) : getToday();
        endDateInput.value = campaign.endDate ? String(campaign.endDate).slice(0, 10) : '';
        weekdayInput.value = campaign.dayOfWeek ?? '1';
        monthdayInput.value = campaign.dayOfMonth || '';
        activeInput.checked = Boolean(campaign.isActive);
        manualEmailsInput.value = Array.isArray(campaign.manualEmails) ? campaign.manualEmails.join('\n') : '';
        selectedUsers = new Map((campaign.targetUsers || []).map((user) => [Number(user.userId), user]));
        renderSelectedUsers();
        updateScheduleFieldVisibility();
      }

      modal.hidden = false;
      document.body.style.overflow = 'hidden';
      window.setTimeout(() => subjectInput.focus(), 30);
    }

    function closeModal() {
      modal.hidden = true;
      document.body.style.overflow = '';
      renderSearchResults([]);
    }

    function renderSelectedUsers() {
      if (selectedUsers.size === 0) {
        selectedUsersContainer.innerHTML = '<span class="field-help">No platform users selected yet.</span>';
        return;
      }

      selectedUsersContainer.innerHTML = Array.from(selectedUsers.values()).map((user) => `
        <span class="selected-user-chip">
          <span>${escapeHtml(user.name || user.email)} (${escapeHtml(user.email)})</span>
          <button type="button" data-remove-user="${user.userId}" aria-label="Remove ${escapeHtml(user.name || user.email)}">&times;</button>
        </span>
      `).join('');
    }

    function renderSearchResults(users) {
      if (!Array.isArray(users) || users.length === 0) {
        searchResultCache = new Map();
        searchResults.classList.remove('is-visible');
        searchResults.innerHTML = '';
        return;
      }

      searchResultCache = new Map(users.map((user) => [Number(user.userId), user]));
      searchResults.innerHTML = users.map((user) => `
        <button type="button" class="search-result" data-user-id="${user.userId}">
          <span>
            <strong>${escapeHtml(user.name || user.email)}</strong>
            <span>${escapeHtml(user.email)}</span>
          </span>
          <span>${escapeHtml(user.accountType || 'User')}</span>
        </button>
      `).join('');
      searchResults.classList.add('is-visible');
    }

    async function searchUsers(query) {
      const response = await fetch(`${recipientsEndpoint}?q=${encodeURIComponent(query || '')}`, {
        headers: {
          'X-Requested-With': 'XMLHttpRequest',
          'Accept': 'application/json'
        }
      });
      const payload = await response.json();
      if (!response.ok || !payload.success) {
        throw new Error(payload.message || 'Failed to search users.');
      }
      renderSearchResults((payload.users || []).filter((user) => !selectedUsers.has(Number(user.userId))));
    }

    function collectPayload() {
      const selectedFrequency = frequencyInput.value || 'every_5_minutes';
      const normalizedFrequency = selectedFrequency === 'every_3_minutes' ? 'every_5_minutes' : selectedFrequency;
      return {
        subject: subjectInput.value.trim(),
        content: contentInput.value.trim(),
        frequency: normalizedFrequency,
        sendTime: sendTimeInput.value,
        startDate: startDateInput.value,
        endDate: endDateInput.value,
        dayOfWeek: weekdayInput.value,
        dayOfMonth: monthdayInput.value,
        isActive: activeInput.checked,
        manualEmails: manualEmailsInput.value,
        targetUserIds: Array.from(selectedUsers.keys()),
      };
    }

    async function fetchJson(url, options) {
      const response = await fetch(url, {
        ...options,
        headers: {
          'Content-Type': 'application/json',
          'Accept': 'application/json',
          'X-Requested-With': 'XMLHttpRequest',
          ...(options && options.headers ? options.headers : {}),
        },
      });

      const payload = await response.json();
      if (!response.ok || !payload.success) {
        throw new Error(payload.message || 'Request failed.');
      }
      return payload;
    }

    async function refreshCampaigns(silent = true) {
      try {
        const result = await fetchJson(campaignsEndpoint, { method: 'GET' });
        campaigns = result.campaigns || [];
        renderCampaigns();
      } catch (error) {
        if (!silent) {
          showNotice(error.message || 'Unable to refresh scheduled emails.', 'error');
        }
      }
    }

    async function saveCampaign(event) {
      event.preventDefault();
      clearNotice();
      saveButton.disabled = true;
      saveButton.textContent = 'Saving...';

      try {
        const campaignId = campaignIdInput.value;
        const payload = collectPayload();
        const method = campaignId ? 'PUT' : 'POST';
        const url = campaignId ? `${campaignsEndpoint}/${campaignId}` : campaignsEndpoint;
        const result = await fetchJson(url, {
          method,
          body: JSON.stringify(payload),
        });

        campaigns = result.campaigns || [];
        renderCampaigns();
        showNotice(result.message || 'Scheduled email saved.', 'success');
        closeModal();
      } catch (error) {
        showNotice(error.message || 'Unable to save the scheduled email.', 'error');
      } finally {
        saveButton.disabled = false;
        saveButton.textContent = 'Save automated email';
      }
    }

    async function onCampaignAction(event) {
      const button = event.target.closest('button[data-action]');
      if (!button) return;

      const action = button.getAttribute('data-action');
      if (action === 'toggle-card') {
        const cardId = button.getAttribute('data-card-id');
        if (!cardId) return;
        if (expandedCards.has(cardId)) {
          expandedCards.delete(cardId);
        } else {
          expandedCards.add(cardId);
        }
        renderCampaigns();
        return;
      }

      const campaignId = Number(button.getAttribute('data-id'));
      const campaign = campaigns.find((item) => Number(item.id) === campaignId);
      if (!campaign) return;

      if (action === 'edit') {
        openModal(campaign);
        return;
      }

      if (action === 'toggle-recipients') {
        if (expandedCampaigns.has(campaignId)) {
          expandedCampaigns.delete(campaignId);
        } else {
          expandedCampaigns.add(campaignId);
        }
        renderCampaigns();
        return;
      }

      if (action === 'toggle') {
        try {
          const result = await fetchJson(`${campaignsEndpoint}/${campaignId}/toggle`, { method: 'POST' });
          campaigns = result.campaigns || [];
          renderCampaigns();
          showNotice(result.message || 'Scheduled email updated.', 'success');
        } catch (error) {
          showNotice(error.message || 'Unable to update the scheduled email.', 'error');
        }
        return;
      }

      if (action === 'delete') {
        if (!window.confirm('Delete this automated email?')) return;
        try {
          const result = await fetchJson(`${campaignsEndpoint}/${campaignId}`, { method: 'DELETE' });
          campaigns = result.campaigns || [];
          renderCampaigns();
          showNotice(result.message || 'Scheduled email deleted.', 'success');
        } catch (error) {
          showNotice(error.message || 'Unable to delete the scheduled email.', 'error');
        }
      }
    }

    openModalButton.addEventListener('click', () => openModal(null));
    closeModalButtons.forEach((button) => button.addEventListener('click', closeModal));
    campaignForm.addEventListener('submit', saveCampaign);
    campaignGrid.addEventListener('click', onCampaignAction);
    frequencyInput.addEventListener('change', updateScheduleFieldVisibility);

    selectedUsersContainer.addEventListener('click', (event) => {
      const removeButton = event.target.closest('button[data-remove-user]');
      if (!removeButton) return;
      const userId = Number(removeButton.getAttribute('data-remove-user'));
      selectedUsers.delete(userId);
      renderSelectedUsers();
    });

    userSearchInput.addEventListener('input', () => {
      const query = userSearchInput.value.trim();
      window.clearTimeout(searchTimer);

      if (!query) {
        renderSearchResults([]);
        return;
      }

      searchTimer = window.setTimeout(async () => {
        try {
          await searchUsers(query);
        } catch (error) {
          showNotice(error.message || 'Unable to search users.', 'error');
        }
      }, 220);
    });

    userSearchInput.addEventListener('focus', async () => {
      if (userSearchInput.value.trim()) {
        return;
      }

      try {
        await searchUsers('');
      } catch (error) {
        showNotice(error.message || 'Unable to search users.', 'error');
      }
    });

    searchResults.addEventListener('click', (event) => {
      const resultButton = event.target.closest('button[data-user-id]');
      if (!resultButton) return;

      const userId = Number(resultButton.getAttribute('data-user-id'));
      const payload = searchResultCache.get(userId);
      if (!payload) {
        showNotice('Unable to add that user right now.', 'error');
        return;
      }

      selectedUsers.set(Number(payload.userId), payload);
      renderSelectedUsers();
      renderSearchResults([]);
      userSearchInput.value = '';
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && !modal.hidden) {
        closeModal();
      }
    });

    document.addEventListener('click', (event) => {
      const toggleButton = event.target.closest('button[data-action="toggle-card"][data-card-id]');
      if (!toggleButton || toggleButton.closest('#campaign-grid')) {
        return;
      }

      const cardId = toggleButton.getAttribute('data-card-id');
      const body = document.querySelector(`[data-card-body="${cardId}"]`);
      const indicator = toggleButton.querySelector('.collapsible-card-indicator');
      const expanded = toggleButton.getAttribute('aria-expanded') === 'true';
      toggleButton.setAttribute('aria-expanded', expanded ? 'false' : 'true');
      if (indicator) {
        indicator.textContent = expanded ? 'Expand' : 'Hide';
      }
      if (body) {
        body.classList.toggle('is-open', !expanded);
      }
    });

    document.addEventListener('visibilitychange', () => {
      if (!document.hidden) {
        refreshCampaigns(true);
      }
    });

    window.setInterval(() => {
      if (!document.hidden) {
        refreshCampaigns(true);
      }
    }, 30000);

    renderCampaigns();
    resetForm();
  })();
</script>

<script type="application/json" id="la-data"><%- JSON.stringify(loginAdList.map((ad) => ({ id: ad.id, title: ad.title, media_type: ad.media_type, file_url: ad.file_url, media_width: ad.media_width, media_height: ad.media_height, link_url: ad.link_url, link_label: ad.link_label, show_as_button: ad.show_as_button, button_x: ad.button_x, button_y: ad.button_y, button_color: ad.button_color, button_text_color: ad.button_text_color, button_size: ad.button_size, is_active: ad.is_active, show_on_login: ad.show_on_login, show_in_app: ad.show_in_app, app_position: ad.app_position, app_frequency: ad.app_frequency, app_max_views: ad.app_max_views, app_roles: ad.app_roles, starts_at: ad.starts_at, ends_at: ad.ends_at }))).replace(/</g, '\\u003c') %></script>
<script src="<%= assetUrl('/js/loginAds.js') %>"></script>
<script>
  (() => {
    const ads = JSON.parse(document.getElementById('la-data').textContent || '[]');
    const byId = new Map(ads.map((ad) => [String(ad.id), ad]));
    const modal = document.getElementById('la-modal');
    const form = document.getElementById('la-form');
    const frame = document.getElementById('la-preview-frame');
    const hint = document.getElementById('la-hint');
    const fileInput = document.getElementById('la-file');
    const drop = document.getElementById('la-drop');
    const errorEl = document.getElementById('la-error');
    const saveBtn = document.getElementById('la-save');
    const f = {
      title: document.getElementById('la-title'),
      link: document.getElementById('la-link'),
      asButton: document.getElementById('la-as-button'),
      label: document.getElementById('la-label'),
      color: document.getElementById('la-color'),
      textColor: document.getElementById('la-text-color'),
      active: document.getElementById('la-active'),
      buttonFields: document.getElementById('la-button-fields'),
      onLogin: document.getElementById('la-on-login'),
      inApp: document.getElementById('la-in-app'),
      appFields: document.getElementById('la-app-fields'),
      frequency: document.getElementById('la-frequency'),
      maxViews: document.getElementById('la-max-views'),
      maxViewsField: document.getElementById('la-max-views-field'),
      starts: document.getElementById('la-starts'),
      ends: document.getElementById('la-ends'),
    };
    const roleChecks = Array.from(form.querySelectorAll('.la-role'));

    function syncPlacement() {
      f.appFields.hidden = !f.inApp.checked;
      f.maxViewsField.hidden = f.frequency.value !== 'n_times';
    }
    // datetime-local wants local "YYYY-MM-DDTHH:mm".
    function toLocalInput(value) {
      if (!value) return '';
      const d = new Date(value);
      if (Number.isNaN(d.getTime())) return '';
      const pad = (n) => String(n).padStart(2, '0');
      return d.getFullYear() + '-' + pad(d.getMonth() + 1) + '-' + pad(d.getDate()) + 'T' + pad(d.getHours()) + ':' + pad(d.getMinutes());
    }
    function toIso(value) {
      if (!value) return '';
      const d = new Date(value);
      return Number.isNaN(d.getTime()) ? '' : d.toISOString();
    }
    const ACCEPTED = ['image/jpeg', 'image/png', 'image/gif', 'image/webp', 'application/pdf', 'video/mp4', 'video/webm'];
    const MAX_BYTES = 50 * 1024 * 1024;

    // Editor state
    let editingId = null;
    let pendingFile = null;
    let objectUrl = null;
    let media = null; // { type, url, width, height }
    let pos = { x: 50, y: 85 };
    let stage = null;
    let btn = null;
    let guide = null;

    // Thumbnails: render PDF first pages.
    document.querySelectorAll('#loginAdsPanel canvas[data-pdf-src]').forEach((canvas) => {
      window.LoginAds.renderPdf(canvas, canvas.dataset.pdfSrc).catch(() => {});
    });

    function size() { return (form.querySelector('input[name="la-size"]:checked') || {}).value || 'md'; }
    function setSize(value) { const r = form.querySelector('input[name="la-size"][value="' + (value || 'md') + '"]'); if (r) r.checked = true; }
    function mediaTypeOf(mime) { return mime === 'application/pdf' ? 'pdf' : mime.startsWith('video/') ? 'video' : 'image'; }

    function buildStage() {
      frame.innerHTML = '';
      stage = btn = guide = null;
      hint.hidden = true;
      if (!media) {
        frame.innerHTML = '<p class="la-preview-empty">Your ad preview appears here.<br />Choose a file to start.</p>';
        return;
      }
      stage = document.createElement('div');
      stage.className = 'ad-stage';
      setAspect();
      let el;
      if (media.type === 'video') {
        el = document.createElement('video');
        Object.assign(el, { src: media.url, muted: true, loop: true, autoplay: true, playsInline: true });
        el.addEventListener('loadedmetadata', () => setDims(el.videoWidth, el.videoHeight));
      } else if (media.type === 'pdf') {
        el = document.createElement('canvas');
        window.LoginAds.renderPdf(el, media.url)
          .then((d) => setDims(d.width, d.height))
          .catch(() => { errorEl.textContent = 'Could not read that PDF.'; });
      } else {
        el = document.createElement('img');
        el.alt = '';
        el.addEventListener('load', () => setDims(el.naturalWidth, el.naturalHeight));
        el.src = media.url;
      }
      stage.appendChild(el);
      guide = document.createElement('div');
      guide.className = 'la-guide';
      stage.appendChild(guide);
      btn = document.createElement('span');
      btn.tabIndex = 0;
      btn.setAttribute('role', 'slider');
      btn.setAttribute('aria-label', 'Button position');
      stage.appendChild(btn);
      frame.appendChild(stage);
      bindDrag();
      renderButton();
    }

    function setDims(w, h) {
      if (!media || !w || !h) return;
      media.width = w;
      media.height = h;
      setAspect();
    }
    function setAspect() {
      if (stage) stage.style.setProperty('--ar', media.width && media.height ? (media.width / media.height).toFixed(4) : '0.75');
    }

    function renderButton() {
      f.buttonFields.hidden = !f.asButton.checked;
      document.getElementById('la-color-value').textContent = f.color.value;
      document.getElementById('la-text-color-value').textContent = f.textColor.value;
      if (!btn) return;
      const show = f.asButton.checked;
      btn.hidden = !show;
      hint.hidden = !show;
      btn.className = 'ad-btn ad-btn--' + size();
      btn.textContent = f.label.value.trim() || 'Learn more';
      btn.style.background = f.color.value;
      btn.style.color = f.textColor.value;
      btn.style.left = pos.x + '%';
      btn.style.top = pos.y + '%';
      btn.setAttribute('aria-valuetext', Math.round(pos.x) + '% across, ' + Math.round(pos.y) + '% down');
    }

    // Keep the whole button inside the media.
    function clampPos(x, y) {
      const s = stage.getBoundingClientRect();
      const b = btn.getBoundingClientRect();
      const hx = s.width ? (b.width / 2 / s.width) * 100 : 0;
      const hy = s.height ? (b.height / 2 / s.height) * 100 : 0;
      return {
        x: Math.min(100 - hx, Math.max(hx, x)),
        y: Math.min(100 - hy, Math.max(hy, y)),
      };
    }

    function bindDrag() {
      let drag = null;
      btn.addEventListener('pointerdown', (e) => {
        e.preventDefault();
        const b = btn.getBoundingClientRect();
        drag = { dx: e.clientX - (b.left + b.width / 2), dy: e.clientY - (b.top + b.height / 2) };
        btn.setPointerCapture(e.pointerId);
        btn.classList.add('is-dragging');
      });
      btn.addEventListener('pointermove', (e) => {
        if (!drag) return;
        const s = stage.getBoundingClientRect();
        let x = ((e.clientX - drag.dx - s.left) / s.width) * 100;
        const y = ((e.clientY - drag.dy - s.top) / s.height) * 100;
        const snap = Math.abs(x - 50) < 1.5;
        if (snap) x = 50;
        guide.classList.toggle('is-visible', snap);
        pos = clampPos(x, y);
        renderButton();
      });
      const end = () => {
        if (!drag) return;
        drag = null;
        btn.classList.remove('is-dragging');
        guide.classList.remove('is-visible');
        pos = { x: Math.round(pos.x * 100) / 100, y: Math.round(pos.y * 100) / 100 };
      };
      btn.addEventListener('pointerup', end);
      btn.addEventListener('pointercancel', end);
      btn.addEventListener('keydown', (e) => {
        const step = e.shiftKey ? 5 : 1;
        const moves = { ArrowLeft: [-step, 0], ArrowRight: [step, 0], ArrowUp: [0, -step], ArrowDown: [0, step] };
        if (!moves[e.key]) return;
        e.preventDefault();
        pos = clampPos(pos.x + moves[e.key][0], pos.y + moves[e.key][1]);
        renderButton();
      });
    }

    function useFile(file) {
      errorEl.textContent = '';
      if (!file) return;
      if (!ACCEPTED.includes(file.type)) { errorEl.textContent = 'Use a JPG, PNG, GIF, WebP, PDF, MP4 or WebM file.'; return; }
      if (file.size > MAX_BYTES) { errorEl.textContent = 'That file is larger than 50 MB.'; return; }
      if (objectUrl) URL.revokeObjectURL(objectUrl);
      objectUrl = URL.createObjectURL(file);
      pendingFile = file;
      media = { type: mediaTypeOf(file.type), url: objectUrl, width: null, height: null };
      document.getElementById('la-file-name').textContent = file.name;
      if (!f.title.value.trim()) f.title.value = file.name.replace(/\.[^.]+$/, '').replace(/[-_]+/g, ' ').slice(0, 200);
      buildStage();
    }

    function open(ad) {
      editingId = ad ? ad.id : null;
      pendingFile = null;
      if (objectUrl) { URL.revokeObjectURL(objectUrl); objectUrl = null; }
      fileInput.value = '';
      errorEl.textContent = '';
      document.getElementById('la-file-name').textContent = '';
      document.getElementById('la-modal-title').textContent = ad ? 'Edit ad' : 'New ad';
      document.getElementById('la-drop-title').textContent = ad ? 'Replace file (optional)' : 'Choose or drop a file';
      f.title.value = ad ? (ad.title || '') : '';
      f.link.value = ad ? (ad.link_url || '') : '';
      f.asButton.checked = ad ? ad.show_as_button !== false : true;
      f.label.value = ad ? (ad.link_label || '') : 'Learn more';
      f.color.value = ad ? ad.button_color : '#e4572e';
      f.textColor.value = ad ? ad.button_text_color : '#ffffff';
      f.active.checked = ad ? ad.is_active !== false : true;
      f.onLogin.checked = ad ? ad.show_on_login !== false : true;
      f.inApp.checked = ad ? Boolean(ad.show_in_app) : false;
      const positionRadio = form.querySelector('input[name="la-position"][value="' + ((ad && ad.app_position) || 'bottom-right') + '"]');
      if (positionRadio) positionRadio.checked = true;
      f.frequency.value = (ad && ad.app_frequency) || 'once_per_session';
      f.maxViews.value = (ad && ad.app_max_views) || 3;
      const roles = (ad && ad.app_roles) || [];
      roleChecks.forEach((c) => { c.checked = roles.includes(c.value); });
      f.starts.value = toLocalInput(ad && ad.starts_at);
      f.ends.value = toLocalInput(ad && ad.ends_at);
      syncPlacement();
      setSize(ad ? ad.button_size : 'md');
      pos = ad ? { x: Number(ad.button_x), y: Number(ad.button_y) } : { x: 50, y: 85 };
      media = ad ? { type: ad.media_type, url: ad.file_url, width: ad.media_width, height: ad.media_height } : null;
      modal.hidden = false;
      document.body.style.overflow = 'hidden';
      buildStage();
    }

    function close() {
      modal.hidden = true;
      document.body.style.overflow = '';
      frame.innerHTML = '';
      if (objectUrl) { URL.revokeObjectURL(objectUrl); objectUrl = null; }
    }

    function post(url, body) {
      return fetch(url, { method: 'POST', credentials: 'same-origin', body }).then((r) => r.json().catch(() => ({})).then((data) => {
        if (!r.ok || data.success === false) throw new Error(data.message || 'Something went wrong.');
        return data;
      }));
    }

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      errorEl.textContent = '';
      if (!editingId && !pendingFile) { errorEl.textContent = 'Choose an image, PDF or video first.'; return; }
      if (f.asButton.checked && f.link.value.trim() && !f.label.value.trim()) { errorEl.textContent = 'Add the button text.'; f.label.focus(); return; }
      if (!f.onLogin.checked && !f.inApp.checked) { errorEl.textContent = 'Choose where the ad shows: sign-in pages, inside the app, or both.'; return; }
      if (f.starts.value && f.ends.value && new Date(f.ends.value) <= new Date(f.starts.value)) { errorEl.textContent = 'The end date must be after the start date.'; f.ends.focus(); return; }

      const data = new FormData();
      if (pendingFile) data.append('file', pendingFile);
      data.append('title', f.title.value.trim());
      data.append('link_url', f.link.value.trim());
      data.append('link_label', f.label.value.trim());
      data.append('show_as_button', f.asButton.checked ? 'true' : 'false');
      data.append('button_x', String(pos.x));
      data.append('button_y', String(pos.y));
      data.append('button_color', f.color.value);
      data.append('button_text_color', f.textColor.value);
      data.append('button_size', size());
      data.append('is_active', f.active.checked ? 'true' : 'false');
      data.append('show_on_login', f.onLogin.checked ? 'true' : 'false');
      data.append('show_in_app', f.inApp.checked ? 'true' : 'false');
      data.append('app_position', (form.querySelector('input[name="la-position"]:checked') || {}).value || 'bottom-right');
      data.append('app_frequency', f.frequency.value);
      data.append('app_max_views', f.frequency.value === 'n_times' ? String(f.maxViews.value || 3) : '');
      data.append('app_roles', roleChecks.filter((c) => c.checked).map((c) => c.value).join(','));
      data.append('starts_at', toIso(f.starts.value));
      data.append('ends_at', toIso(f.ends.value));
      if (media && media.width && media.height) {
        data.append('media_width', String(media.width));
        data.append('media_height', String(media.height));
      }

      // XHR for upload progress on larger videos/PDFs.
      const xhr = new XMLHttpRequest();
      xhr.open('POST', editingId ? '/admin/announcements/ads/' + editingId : '/admin/announcements/ads');
      xhr.upload.onprogress = (ev) => {
        if (pendingFile && ev.lengthComputable) saveBtn.textContent = 'Uploading ' + Math.round((ev.loaded / ev.total) * 100) + '%';
      };
      xhr.onload = () => {
        let res = {};
        try { res = JSON.parse(xhr.responseText); } catch (_) {}
        if (xhr.status >= 200 && xhr.status < 300 && res.success) {
          history.replaceState(null, '', window.location.pathname + window.location.search + '#loginAdsPanel');
          window.location.reload();
          return;
        }
        errorEl.textContent = res.message || 'Could not save the ad.';
        saveBtn.disabled = false;
        saveBtn.textContent = 'Save ad';
      };
      xhr.onerror = () => { errorEl.textContent = 'Network error. Please try again.'; saveBtn.disabled = false; saveBtn.textContent = 'Save ad'; };
      saveBtn.disabled = true;
      saveBtn.textContent = 'Saving…';
      xhr.send(data);
    });

    fileInput.addEventListener('change', () => useFile(fileInput.files[0]));
    ['dragenter', 'dragover'].forEach((t) => drop.addEventListener(t, (e) => { e.preventDefault(); drop.classList.add('is-over'); }));
    ['dragleave', 'drop'].forEach((t) => drop.addEventListener(t, (e) => { e.preventDefault(); drop.classList.remove('is-over'); }));
    drop.addEventListener('drop', (e) => useFile(e.dataTransfer.files[0]));
    [f.label, f.color, f.textColor].forEach((el) => el.addEventListener('input', renderButton));
    f.asButton.addEventListener('change', renderButton);
    f.inApp.addEventListener('change', syncPlacement);
    f.frequency.addEventListener('change', syncPlacement);
    form.querySelectorAll('input[name="la-size"]').forEach((r) => r.addEventListener('change', () => {
      renderButton();
      if (btn && !btn.hidden) { pos = clampPos(pos.x, pos.y); renderButton(); }
    }));
    modal.querySelectorAll('[data-la-close]').forEach((el) => el.addEventListener('click', close));
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && !modal.hidden) close(); });
    document.querySelectorAll('[data-la-new]').forEach((b) => b.addEventListener('click', () => open(null)));

    // List actions
    document.querySelectorAll('#loginAdsPanel [data-la-id]').forEach((card) => {
      const id = card.getAttribute('data-la-id');
      card.querySelector('[data-la-edit]').addEventListener('click', () => open(byId.get(id)));
      card.querySelector('[data-la-toggle]').addEventListener('click', (e) => {
        const b = e.currentTarget;
        const body = new FormData();
        body.append('is_active', b.getAttribute('data-la-toggle'));
        b.disabled = true;
        post('/admin/announcements/ads/' + id, body).then(() => window.location.reload())
          .catch((err) => { b.disabled = false; alert(err.message); });
      });
      card.querySelector('[data-la-delete]').addEventListener('click', (e) => {
        const b = e.currentTarget;
        if (!confirm('Delete this ad? It will be removed from the login page.')) return;
        b.disabled = true;
        post('/admin/announcements/ads/' + id + '/delete').then(() => window.location.reload())
          .catch((err) => { b.disabled = false; alert(err.message); });
      });
      card.querySelectorAll('[data-la-move]').forEach((b) => b.addEventListener('click', () => {
        const ids = ads.map((ad) => ad.id);
        const from = ids.indexOf(Number(id));
        const to = from + Number(b.getAttribute('data-la-move'));
        if (from < 0 || to < 0 || to >= ids.length) return;
        [ids[from], ids[to]] = [ids[to], ids[from]];
        fetch('/admin/announcements/ads/reorder', {
          method: 'POST', credentials: 'same-origin',
          headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ ids }),
        }).then((r) => { if (r.ok) window.location.reload(); else alert('Could not save the order.'); });
      }));
    });

    if (window.location.hash === '#loginAdsPanel') {
      const panel = document.getElementById('loginAdsPanel');
      if (panel) panel.scrollIntoView({ block: 'start' });
    }
  })();
</script>
