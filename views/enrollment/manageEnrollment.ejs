<%
  const _list = Array.isArray(enrollments) ? enrollments : [];
  const _years = Array.from(new Set(_list.map((e) => e.school_year)));
  const _panelData = _list.map((e) => ({
    id: e.enrollment_id,
    year: e.school_year,
    term: e.term,
    current: !!(e.is_current_year && e.is_current_term),
    classes: e.classes.map((c) => ({ name: c.class_name, students: c.enrolled_students.map((s) => [s.first_name, s.last_name].filter(Boolean).join(' ')) })),
  }));
%>
<link rel="stylesheet" href="/css/globalScale.css">
<link rel="stylesheet" href="/css/manage.css" />
<link rel="stylesheet" href="/css/peoplePanel.css" />
<script src="/js/manage.js" defer></script>

<div class="ws-root ws-enroll me">
  <header class="ws-head">
    <div class="ws-head__text">
      <h1 class="ws-head__title">Enrollment</h1>
      <p class="ws-head__sub">Who is enrolled in each term. Click a term to see or edit it.</p>
    </div>
    <div class="ws-head__actions">
      <button type="button" class="ws-btn ws-btn--primary" id="meAdd"><i class="fa-solid fa-plus" aria-hidden="true"></i> Enroll students</button>
    </div>
  </header>

  <% if (noEnrollmentForCurrentSemester) { %>
    <div class="ws-alert"><i class="fa-solid fa-circle-info" aria-hidden="true"></i><span>Nobody is enrolled in the current term yet. Use <strong style="display:inline">Enroll students</strong> to start.</span></div>
  <% } %>
  <%- include('../partials/flash') %>

  <% if (_list.length) { %>
    <div class="me-tools">
      <label class="me-search"><i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i><input type="search" id="meSearch" placeholder="Find a term, class or student" aria-label="Find a term, class or student" /></label>
      <% if (_years.length > 1) { %>
        <select id="meYear" aria-label="School year">
          <option value="">All school years</option>
          <% _years.forEach((y) => { %><option value="<%= y %>"><%= y %></option><% }) %>
        </select>
      <% } %>
    </div>

    <div class="me-list" id="meList">
      <% _list.forEach((e) => {
           const students = e.classes.reduce((n, c) => n + c.enrolled_students.length, 0);
           const current = e.is_current_year && e.is_current_term;
           const search = [e.term, e.school_year].concat(e.classes.map((c) => c.class_name), e.classes.flatMap((c) => c.enrolled_students.map((s) => s.first_name + ' ' + s.last_name))).join(' ').toLowerCase(); %>
        <button type="button" class="me-row<%= current ? ' is-current' : '' %>" data-id="<%= e.enrollment_id %>" data-year="<%= e.school_year %>" data-search="<%= search %>">
          <span class="me-row__icon"><i class="fa-solid fa-<%= current ? 'calendar-check' : 'calendar' %>" aria-hidden="true"></i></span>
          <span class="me-row__main">
            <strong><%= e.term %> <% if (current) { %><em class="me-badge">Current</em><% } %></strong>
            <small><%= e.school_year %></small>
          </span>
          <span class="me-stat"><b><%= e.classes.length %></b> class<%= e.classes.length === 1 ? '' : 'es' %></span>
          <span class="me-stat"><b><%= students %></b> student<%= students === 1 ? '' : 's' %></span>
          <i class="fa-solid fa-chevron-right me-row__go" aria-hidden="true"></i>
        </button>
      <% }) %>
    </div>
    <p class="ux-empty" id="meNone" hidden>Nothing matches your search.</p>
  <% } else { %>
    <div class="me-empty">
      <i class="fa-solid fa-user-graduate" aria-hidden="true"></i>
      <h2>No enrollments yet</h2>
      <p>Enroll your classes and students for a term to get started.</p>
      <button type="button" class="ws-btn ws-btn--primary" data-add><i class="fa-solid fa-plus" aria-hidden="true"></i> Enroll students</button>
    </div>
  <% } %>
</div>

<div class="ux-panel-backdrop" id="uxBackdrop" hidden></div>
<aside class="ux-panel" id="uxPanel" role="dialog" aria-modal="true" aria-labelledby="uxPanelTitle" aria-hidden="true">
  <div class="ux-panel__bar">
    <button type="button" class="ux-link ux-back" id="uxBack" hidden><i class="fa-solid fa-arrow-left" aria-hidden="true"></i> Back</button>
    <strong id="uxPanelTitle">Enrollment</strong>
    <button type="button" class="ux-close" id="uxClose" aria-label="Close"><svg width="18" height="18" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M15 5L5 15M5 5l10 10" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg></button>
  </div>
  <div class="ux-panel__body" id="uxPanelBody"></div>
  <div class="ux-panel__edit" id="uxPanelEdit" hidden>
    <div class="ux-panel__loading" id="uxEditLoading"><i class="fa-solid fa-spinner fa-spin" aria-hidden="true"></i> Loading…</div>
    <iframe id="uxEditFrame" title="Edit enrollment"></iframe>
  </div>
</aside>
<script type="application/json" id="meData"><%- JSON.stringify(_panelData).replace(/</g, '\\u003c') %></script>

<style>
  .me-tools { display: flex; gap: 10px; margin: 0 0 14px; }
  .me-search { position: relative; flex: 1 1 auto; margin: 0; }
  .me-search i { position: absolute; left: 12px; top: 50%; transform: translateY(-50%); color: var(--ws-muted, #64748b); font-size: .85rem; }
  .me-search input, .me-tools select { width: 100%; margin: 0; padding: 10px 12px 10px 34px; border: 1px solid var(--ws-line, #e2e8f0); border-radius: 10px; background: transparent; color: inherit; font: inherit; font-size: .92rem; }
  .me-tools select { width: auto; padding-left: 12px; }
  .me-list { display: flex; flex-direction: column; border: 1px solid var(--ws-line, #e2e8f0); border-radius: 14px; overflow: hidden; background: var(--ws-surface, #fff); }
  .me .me-row { display: flex; align-items: center; gap: 14px; width: 100%; margin: 0; padding: 14px 16px; border: 0; border-top: 1px solid var(--ws-line, #e2e8f0); border-radius: 0; background: none; box-shadow: none; color: inherit; font: inherit; text-align: left; cursor: pointer; }
  .me .me-row:first-child { border-top: 0; }
  .me .me-row:hover, .me .me-row.is-selected { background: color-mix(in srgb, var(--org-primary-color, #01535b) 6%, transparent); }
  .me .me-row:focus-visible { outline: 2px solid var(--org-primary-color, #01535b); outline-offset: -2px; }
  .me-row[hidden] { display: none !important; }
  .me-row__icon { display: inline-flex; align-items: center; justify-content: center; flex: 0 0 auto; width: 38px; height: 38px; border-radius: 10px; background: color-mix(in srgb, currentColor 6%, transparent); color: var(--ws-muted, #64748b); }
  .me-row.is-current .me-row__icon { background: color-mix(in srgb, var(--org-primary-color, #01535b) 13%, transparent); color: var(--org-primary-color, #01535b); }
  .me-row__main { display: flex; flex-direction: column; gap: 2px; flex: 1 1 auto; min-width: 0; }
  .me-row__main strong { display: flex; align-items: center; gap: 8px; font-size: .98rem; }
  .me-row__main small { color: var(--ws-muted, #64748b); font-size: .84rem; }
  .me-badge { padding: 1px 8px; border-radius: 999px; background: color-mix(in srgb, #16a34a 14%, transparent); color: #15803d; font-size: .7rem; font-style: normal; font-weight: 700; }
  .me-stat { flex: 0 0 auto; min-width: 92px; color: var(--ws-muted, #64748b); font-size: .86rem; white-space: nowrap; }
  .me-stat b { color: var(--ws-ink, #0f172a); font-size: .98rem; }
  .me-row__go { color: var(--ws-muted, #94a3b8); font-size: .8rem; }
  .me-empty { padding: 48px 20px; border: 1px dashed var(--ws-line, #e2e8f0); border-radius: 14px; text-align: center; }
  .me-empty > i { font-size: 1.8rem; color: var(--org-primary-color, #01535b); }
  .me-empty h2 { margin: 12px 0 4px; font-size: 1.1rem; }
  .me-empty p { margin: 0 0 16px; color: var(--ws-muted, #64748b); }
  /* Panel content */
  .me-p-head { margin-bottom: 16px; }
  .me-p-head h2 { display: flex; align-items: center; gap: 8px; margin: 0; font-size: 1.2rem; }
  .me-p-head p { margin: 4px 0 0; color: var(--ws-muted, #64748b); }
  .me-p-stats { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin-bottom: 16px; }
  .me-p-stat { padding: 12px; border-radius: 12px; background: color-mix(in srgb, var(--org-primary-color, #01535b) 7%, transparent); }
  .me-p-stat b { display: block; font-size: 1.4rem; color: var(--org-primary-color, #01535b); }
  .me-p-stat span { color: var(--ws-muted, #64748b); font-size: .84rem; }
  .me-p-class { border-top: 1px solid var(--ws-line, #e2e8f0); }
  .me-p-class summary { display: flex; align-items: center; gap: 10px; padding: 11px 2px; cursor: pointer; list-style: none; font-weight: 600; }
  .me-p-class summary::-webkit-details-marker { display: none; }
  .me-p-class summary i { width: 12px; color: var(--ws-muted, #94a3b8); font-size: .72rem; transition: transform .15s ease; }
  .me-p-class[open] summary i { transform: rotate(90deg); }
  .me-p-class summary span { flex: 1; }
  .me-p-class summary small { padding: 1px 8px; border-radius: 999px; background: color-mix(in srgb, currentColor 8%, transparent); font-size: .76rem; }
  .me-p-class ol { margin: 0 0 12px; padding: 0 0 0 40px; columns: 2; column-gap: 16px; font-size: .88rem; line-height: 1.7; }
  .me-p-none { margin: 0 0 12px 24px; color: var(--ws-muted, #64748b); font-size: .88rem; }
  .ux-panel.is-editing { width: min(760px, 100vw); }
  @media (max-width: 640px) {
    .me .me-row { gap: 10px; padding: 12px; }
    .me-stat { min-width: 0; }
    .me-stat:nth-of-type(1) { display: none; }
    .me-p-class ol { columns: 1; }
  }
</style>

<script>
(function () {
  var data = JSON.parse(document.getElementById('meData').textContent || '[]');
  var EMBED = '?embed=workspace'; // the panel always shows the form without the site frame
  var panel = document.getElementById('uxPanel');
  var body = document.getElementById('uxPanelBody');
  var frame = document.getElementById('uxEditFrame');
  var loading = document.getElementById('uxEditLoading');
  var current = null, saved = false;
  var esc = function (v) { return String(v == null ? '' : v).replace(/[&<>"']/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]; }); };

  // Filters
  var search = document.getElementById('meSearch');
  var year = document.getElementById('meYear');
  function filter() {
    var q = search ? search.value.trim().toLowerCase() : '';
    var y = year ? year.value : '';
    var shown = 0;
    document.querySelectorAll('.me-row').forEach(function (row) {
      var hit = (!q || row.dataset.search.indexOf(q) !== -1) && (!y || row.dataset.year === y);
      row.hidden = !hit;
      if (hit) shown++;
    });
    var none = document.getElementById('meNone');
    if (none) none.hidden = shown > 0;
  }
  if (search) search.addEventListener('input', filter);
  if (year) year.addEventListener('change', filter);

  function setMode(editing, title) {
    panel.classList.toggle('is-editing', editing);
    body.hidden = editing;
    document.getElementById('uxPanelEdit').hidden = !editing;
    document.getElementById('uxBack').hidden = !editing || !current;
    document.getElementById('uxPanelTitle').textContent = title;
  }

  function render(e) {
    var students = e.classes.reduce(function (n, c) { return n + c.students.length; }, 0);
    body.innerHTML =
      '<div class="me-p-head"><h2>' + esc(e.term) + (e.current ? ' <em class="me-badge">Current</em>' : '') + '</h2><p>' + esc(e.year) + '</p></div>' +
      '<div class="me-p-stats"><div class="me-p-stat"><b>' + e.classes.length + '</b><span>class' + (e.classes.length === 1 ? '' : 'es') + '</span></div>' +
      '<div class="me-p-stat"><b>' + students + '</b><span>student' + (students === 1 ? '' : 's') + '</span></div></div>' +
      (e.classes.length ? e.classes.map(function (c) {
        return '<details class="me-p-class"><summary><i class="fa-solid fa-chevron-right" aria-hidden="true"></i><span>' + esc(c.name) + '</span><small>' + c.students.length + '</small></summary>' +
          (c.students.length ? '<ol>' + c.students.map(function (s) { return '<li>' + esc(s) + '</li>'; }).join('') + '</ol>' : '<p class="me-p-none">No students yet.</p>') + '</details>';
      }).join('') : '<p class="ux-muted">No classes in this term yet.</p>') +
      '<div class="ux-actions" style="margin-top:14px"><button type="button" class="ws-btn ws-btn--primary" id="meEdit"><i class="fa-solid fa-pen" aria-hidden="true"></i> Edit</button></div>';
    document.getElementById('meEdit').addEventListener('click', function () { edit('/enrollment/modifyEnrollment/' + e.id + EMBED, 'Edit ' + e.term); });
  }

  function edit(url, title) {
    setMode(true, title);
    frame.style.visibility = 'hidden';
    loading.style.display = 'flex';
    frame.onload = function () {
      var path = null;
      try { path = frame.contentWindow.location.pathname; } catch (err) { /* ignore */ }
      if (path && path !== 'blank' && path.indexOf('/enrollment/') !== 0) { location.reload(); return; }
      if (path === '/enrollment/manageEnrollment') { location.reload(); return; }
      loading.style.display = 'none';
      frame.style.visibility = 'visible';
    };
    frame.src = url;
  }

  function open(id, opts) {
    current = id ? data.find(function (e) { return String(e.id) === String(id); }) : null;
    document.getElementById('uxBackdrop').hidden = false;
    panel.classList.add('is-open');
    panel.setAttribute('aria-hidden', 'false');
    document.querySelectorAll('.me-row').forEach(function (r) { r.classList.toggle('is-selected', !!current && r.dataset.id === String(current.id)); });
    if (current && !(opts && opts.add)) { setMode(false, 'Enrollment'); render(current); }
    else edit('/enrollment/enroll' + EMBED, 'Enroll students');
  }

  function close() {
    panel.classList.remove('is-open', 'is-editing');
    panel.setAttribute('aria-hidden', 'true');
    document.getElementById('uxBackdrop').hidden = true;
    frame.removeAttribute('src');
    document.querySelectorAll('.me-row.is-selected').forEach(function (r) { r.classList.remove('is-selected'); });
    if (saved) location.reload();
  }

  document.querySelectorAll('.me-row').forEach(function (row) { row.addEventListener('click', function () { open(row.dataset.id); }); });
  document.querySelectorAll('#meAdd, [data-add]').forEach(function (b) { b.addEventListener('click', function () { open(null, { add: true }); }); });
  document.getElementById('uxClose').addEventListener('click', close);
  document.getElementById('uxBackdrop').addEventListener('click', close);
  document.getElementById('uxBack').addEventListener('click', function () { frame.removeAttribute('src'); setMode(false, 'Enrollment'); if (current) render(current); });
  document.addEventListener('keydown', function (e) { if (e.key === 'Escape' && panel.classList.contains('is-open')) close(); });
  window.addEventListener('message', function (event) {
    if (event.origin !== location.origin || !event.data) return;
    if (event.data.managiraDrawerSaved) saved = true;
    if (event.data.managiraDrawerClose) close();
  });

  // ?focus=<id> opens that enrollment; ?add=1 opens the add form.
  var params = new URLSearchParams(location.search);
  if (params.get('focus')) open(params.get('focus'));
  else if (params.get('add')) open(null, { add: true });
})();
</script>
