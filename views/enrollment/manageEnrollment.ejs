<!DOCTYPE html>
<html lang="en">
  <head>
    <link rel="stylesheet" href="/css/globalScale.css">
    <meta charset="UTF-8" />
    <meta name="viewport" content="<%= locals.viewportContent || 'width=device-width, initial-scale=1.0, maximum-scale=1.0' %>" />
    <title>Manage Enrollments</title>
    <style>
      :root {
        --font-family: "<%= (session && session.fontStyle ? String(session.fontStyle).trim() : 'Inter') %>", sans-serif;
      }

      .manage-enrollment-page {
        font-family: var(--font-family);
        background: #f7f9fb;
      }


      .modify-btn {
        background: var(--org-primary-color, #0f5a66);
        color: #ffffff;
        font-weight: 600;
        border: none;
        border-radius: 8px;
        padding: 8px 18px;
        font-size: 0.95rem;
        cursor: pointer;
        box-shadow: 0 2px 10px rgba(15, 90, 102, 0.16);
        transition: transform 0.15s ease, box-shadow 0.15s ease;
      }
      .modify-btn:hover {
        transform: translateY(-1px);
        box-shadow: 0 6px 14px rgba(15, 90, 102, 0.2);
      }
      .collapsible-btn {
        width: 100%;
        background: var(--org-primary-color, #0f5a66);
        color: #fff;
        border: none;
        outline: none;
        padding: 10px 16px;
        font-size: 0.98rem;
        text-align: left;
        display: flex;
        align-items: center;
        justify-content: space-between;
        cursor: pointer;
        border-radius: 10px;
        margin-bottom: 8px;
        transition: background 0.2s, transform 0.15s ease;
      }
      .collapsible-btn .arrow {
        font-size: 20px;
        margin-left: 12px;
        transition: transform 0.2s;
      }
      .collapsible-btn:hover,
      .collapsible-btn:focus {
        background: var(--org-primary-hover-fill, var(--org-primary-hover, #0d4f59));
        color: #fff;
        box-shadow: 0 4px 10px rgba(15, 90, 102, 0.2);
        transform: translateY(-1px);
      }
      .collapsible-content {
        background: #f9f9f9;
        border-radius: 6px;
        margin-top: 6px;
        padding: 8px 12px;
        width: 100%;
      }
      .main-content {
        max-width: none;
        width: 100%;
        margin: 0 0 32px;
        padding: 0 24px;
        box-sizing: border-box;
        display: flex;
        flex-direction: column;
        gap: 16px;
      }
      body {
        font-family: var(--font-family);
      }

      .action-bar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        flex-wrap: nowrap;
        width: 100%;
        padding: 10px 24px 0;
        box-sizing: border-box;
      }

      .action-bar h1 {
        margin: 0;
        font-size: 1.08rem;
        font-weight: 700;
        color: #111827;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        min-width: 0;
      }

      .action-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        min-height: 30px;
        padding: 5px 8px;
        background: #fff;
        color: var(--org-primary-color, #0f5a66);
        border: 2px solid var(--org-primary-color, #0f5a66);
        border-radius: 8px;
        font-size: 0.72rem;
        font-weight: 700;
        text-decoration: none;
        cursor: pointer;
        white-space: nowrap;
        flex: 0 0 auto;
        width: auto;
      }

      .action-btn:hover {
        background: #fff;
        color: var(--org-primary-color, #0f5a66);
      }

      @media (max-width: 480px) {
        .action-bar { gap: 8px; }
        .action-bar h1 { font-size: 1rem; }
      }

      /* ---- Add Enrollment drawer (AJAX, same slide-in-from-right pattern
         used by the Assessment Question Sets "Set Questions" panel) ---- */
      .en-modal-overlay {
        position: fixed;
        inset: 0;
        background: rgba(10, 20, 30, 0.55);
        backdrop-filter: blur(3px);
        display: none;
        z-index: 10000;
        animation: enFadeIn 0.2s ease;
      }
      .en-modal-overlay.is-open {
        display: flex;
        align-items: stretch;
        justify-content: flex-end;
      }
      .en-modal {
        position: relative;
        width: 100%;
        max-width: 1060px;
        height: 100%;
        min-height: 100%;
        max-height: 100%;
        background: linear-gradient(180deg, #f8fbff 0%, #eef4fa 100%);
        display: flex;
        flex-direction: column;
        box-shadow: -8px 0 40px rgba(0, 0, 0, 0.18);
        animation: enSlideInRight 0.28s cubic-bezier(0.22, 1, 0.36, 1);
        overflow: hidden;
      }
      @keyframes enSlideInRight {
        from { transform: translateX(100%); opacity: 0; }
        to   { transform: translateX(0);    opacity: 1; }
      }
      @keyframes enFadeIn {
        from { opacity: 0; }
        to   { opacity: 1; }
      }
      .en-modal-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: calc(13px + env(safe-area-inset-top, 0px)) 18px 12px;
        background: #fff;
        border-bottom: 1px solid #e2e8f0;
        flex-shrink: 0;
        gap: 12px;
      }
      .en-modal-header-left { display: flex; align-items: center; gap: 10px; }
      .en-modal-header-icon {
        width: 34px;
        height: 34px;
        background: linear-gradient(135deg, var(--org-primary-color, #0f5a66) 0%, #1a8fa0 100%);
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 15px;
        flex-shrink: 0;
      }
      .en-modal-header h2 { margin: 0; font-size: 0.95rem; font-weight: 700; color: #0f2d32; }
      .en-modal-header p { margin: 0; font-size: 0.72rem; color: #64748b; }
      .en-modal-close {
        width: 32px;
        height: 32px;
        border-radius: 8px;
        border: 1px solid #e2e8f0;
        background: #fff;
        color: #64748b;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: all 0.15s;
        flex-shrink: 0;
      }
      .en-modal-close:hover { background: #fef2f2; border-color: #fca5a5; color: #dc2626; }
      .en-modal-body { flex: 1; position: relative; overflow: hidden; }
      .en-modal-iframe { width: 100%; height: 100%; border: none; display: block; }
      .en-modal-loading {
        position: absolute;
        inset: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        color: #475569;
        font-size: 0.85rem;
      }
      .en-modal-spinner {
        width: 16px;
        height: 16px;
        border: 2px solid rgba(15, 90, 102, 0.25);
        border-top-color: #0f5a66;
        border-radius: 50%;
        animation: enSpin 0.7s linear infinite;
        flex-shrink: 0;
      }
      @keyframes enSpin { to { transform: rotate(360deg); } }
      @media (max-width: 500px) {
        .en-modal-overlay { padding: 0; }
        .en-modal { border-radius: 0; }
      }
    </style>
    <style>
      table {
        width: 100%;
        margin-top: 20px;
        border-collapse: collapse;
        background: #fff;
        border-radius: 12px 12px 0 0;
        box-shadow: 0 6px 18px rgba(15, 45, 50, 0.12);
        min-width: 900px;
        border: 1px solid #e1e8ee;
      }
      th,
      td {
        padding: 14px 10px;
        text-align: left;
        font-size: 1rem;
        border: 1px solid #d3e2e5;
        background: #fff;
      }
      th {
        background: var(--org-primary-color, #0f5a66);
        color: #fff;
        font-weight: 700;
        border-bottom: 2px solid var(--org-primary-hover, #0d4f59);
        text-align: center;
        letter-spacing: 0.3px;
      }
      tr:nth-child(even) td {
        background: #f2f7fa;
      }
      tr:hover td {
        background: #eef5f7;
      }
      .center {
        text-align: center;
      }
      .action-links {
        text-align: center;
        margin-bottom: 20px;
      }
      .link-button {
        text-decoration: none;
        background-color: var(--org-primary-color, #0f5a66);
        color: #fff;
        padding: 6px 12px;
        border-radius: 8px;
        transition: background-color 0.3s ease, transform 0.15s ease;
        font-weight: 600;
      }
      .link-button:hover {
        background-color: var(--org-primary-hover-fill, var(--org-primary-hover, #0d4f59));
        transform: translateY(-1px);
      }
      .green-dot {
        display: inline-block;
        width: 10px;
        height: 10px;
        background-color: rgb(0, 201, 0);
        border-radius: 50%;
        margin-right: 5px;
      }
      .notice-message {
        background-color: #f5cece;
        color: #333;
        padding: 10px;
        border-left: 5px solid #000000;
        margin-bottom: 20px;
      }
      .class-container {
        margin-top: 10px;
        cursor: pointer;
        user-select: none;
      }
      .class-arrow {
        font-size: 16px;
        margin-right: 5px;
      }
      .student-list {
        list-style-type: none;
        padding-left: 20px;
        display: none; /* Hidden by default */
      }
      .student-checkbox {
        display: flex;
        align-items: center;
      }
      .student-checkbox label {
        margin-left: 5px;
      }

      /* Table wrapper for horizontal scrolling on small screens */
      .table-wrapper {
        width: 100%;
        overflow-x: auto;
        -webkit-overflow-scrolling: touch;
      }

      /* Mobile responsive styles */
      @media (max-width: 768px) {
        .main-content {
          padding: 0 16px;
        }

        h1.center {
          font-size: 1.5rem;
          margin: 16px 0;
        }

        .link-to-next-back {
          margin: 12px 0;
        }

        .link-button {
          display: inline-block;
          padding: 10px 16px;
          font-size: 0.95rem;
        }

        .notice-message {
          font-size: 0.9rem;
          padding: 12px;
          margin-bottom: 16px;
        }

        table {
          min-width: 700px;
          font-size: 0.9rem;
        }

        th, td {
          padding: 10px 8px;
          font-size: 0.9rem;
        }

        .collapsible-btn {
          padding: 8px 12px;
          font-size: 0.9rem;
        }

        .collapsible-btn .arrow {
          font-size: 16px;
        }

        .modify-btn {
          padding: 6px 16px;
          font-size: 0.9rem;
          white-space: nowrap;
        }

        .class-container {
          font-size: 0.9rem;
        }

        .student-checkbox label {
          font-size: 0.9rem;
        }
      }

      @media (max-width: 480px) {
        .main-content {
          padding: 0 12px;
        }

        h1.center {
          font-size: 1.3rem;
          margin: 12px 0;
        }

        .link-button {
          padding: 8px 14px;
          font-size: 0.85rem;
        }

        .notice-message {
          font-size: 0.85rem;
          padding: 10px;
        }

        table {
          min-width: 650px;
          font-size: 0.85rem;
        }

        th, td {
          padding: 8px 6px;
          font-size: 0.85rem;
        }

        .collapsible-btn {
          padding: 6px 10px;
          font-size: 0.85rem;
        }

        .modify-btn {
          padding: 5px 12px;
          font-size: 0.85rem;
        }

        .class-container {
          font-size: 0.85rem;
        }

        .student-checkbox label {
          font-size: 0.85rem;
        }
      }

      @media (max-width: 360px) {
        h1.center {
          font-size: 1.2rem;
        }

        .link-button {
          padding: 8px 12px;
          font-size: 0.8rem;
        }

        table {
          min-width: 600px;
          font-size: 0.8rem;
        }

        th, td {
          padding: 6px 4px;
          font-size: 0.8rem;
        }

        .collapsible-btn {
          padding: 6px 8px;
          font-size: 0.8rem;
        }

        .modify-btn {
          padding: 4px 10px;
          font-size: 0.8rem;
        }
      }
    </style>
  </head>
  <body class="manage-enrollment-page">
    <link rel="stylesheet" href="/css/manage.css" />
    <script src="/js/manage.js" defer></script>
    <div class="ws-root ws-enroll">
    <header class="ws-head">
      <div class="ws-head__text">
        <h1 class="ws-head__title">Enrollment</h1>
        <p class="ws-head__sub">The classes and students enrolled in each term.</p>
      </div>
      <div class="ws-head__actions">
        <button type="button" class="ws-btn ws-btn--primary" onclick="openAddEnrollmentModal()"><i class="fa-solid fa-plus" aria-hidden="true"></i> Add enrollment</button>
      </div>
    </header>

    <% if (noEnrollmentForCurrentSemester) { %>
    <div class="ws-alert"><i class="fa-solid fa-circle-info" aria-hidden="true"></i><span>No classes or students are enrolled in the current term yet. <a href="/enrollment/enroll">Enroll classes</a> for this term, or <a href="/common/manageRecords">check the school year and term</a> if this isn't the right one.</span></div>
    <% } %> <%- include('../partials/flash') %>

  <div class="main-content">
    <div class="table-wrapper ws-cards-wrap">
  <table class="ws-cards">
      <thead>
        <tr>
          <th>School Year</th>
          <th>Term</th>
          <th>Classes with Enrolled Students</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody>
        <% enrollments.forEach(enrollment => { %>
        <tr>
          <td>
            <% if (enrollment.is_current_year) { %>
            <span class="green-dot"></span>
            <% } %> <%= enrollment.school_year %>
          </td>
          <td>
            <% if (enrollment.is_current_term) { %>
            <span class="green-dot"></span>
            <% } %> <%= enrollment.term %>
          </td>
          <td class="ws-card-wide">
            <button type="button" class="collapsible-btn" onclick="toggleClassListCollapse('class-list-<%= enrollment.enrollment_id %>')">
              <%= enrollment.classes.length %> class<%= enrollment.classes.length === 1 ? '' : 'es' %>
              <span class="arrow" id="arrow-class-list-<%= enrollment.enrollment_id %>">&#9654;</span>
            </button>
            <div class="collapsible-content" id="class-list-<%= enrollment.enrollment_id %>" style="display:none;">
              <% enrollment.classes.forEach((cls, index) => { %>
                <div class="class-container" id="classContainer_<%= enrollment.enrollment_id %>_<%= index %>">
                  <span class="class-arrow" id="arrow_<%= enrollment.enrollment_id %>_<%= index %>">↓</span>
                  <strong><%= cls.class_name %></strong>
                </div>
                <ul id="studentList_<%= enrollment.enrollment_id %>_<%= index %>" class="student-list">
                  <% cls.enrolled_students.forEach(student => { %>
                    <li class="student-checkbox">
                      <input type="checkbox" checked disabled />
                      <label><%= student.first_name %> <%= student.last_name %></label>
                    </li>
                  <% }); %>
                </ul>
              <% }); %>
            </div>
          </td>
          <td class="ws-card-actions">
            <button
              type="button"
              class="ws-btn ws-btn--sm"
              onclick="openModifyEnrollmentModal(<%= enrollment.enrollment_id %>)"
            ><i class="fa-solid fa-pen" aria-hidden="true"></i> Modify</button>
          </td>
        </tr>
        <% }); %>
        <% if (!enrollments.length) { %>
        <tr><td colspan="4" class="ws-empty">No enrollments yet. Use <strong style="display:inline">Add enrollment</strong> to enroll classes for a term.</td></tr>
        <% } %>
      </tbody>
  </table>
    </div>
  </div>
  </div>

  <div class="en-modal-overlay" id="enModalOverlay" aria-hidden="true">
    <div class="en-modal">
      <div class="en-modal-header">
        <div class="en-modal-header-left">
          <div class="en-modal-header-icon" id="enModalIcon">📋</div>
          <div>
            <h2 id="enModalTitle">Add Enrollment</h2>
            <p id="enModalSubtitle">Enroll classes and students for a term</p>
          </div>
        </div>
        <button type="button" class="en-modal-close" id="enModalClose" title="Close">
          <svg width="18" height="18" viewBox="0 0 20 20" fill="none">
            <path d="M15 5L5 15M5 5l10 10" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
          </svg>
        </button>
      </div>
      <div class="en-modal-body">
        <div class="en-modal-loading" id="enModalLoading">
          <span class="en-modal-spinner" aria-hidden="true"></span>
          Loading…
        </div>
        <iframe class="en-modal-iframe" id="enModalIframe" title="Add Enrollment" style="display:none;"></iframe>
      </div>
    </div>
  </div>

    <script>
      function toggleClassListCollapse(id) {
        var content = document.getElementById(id);
        var arrow = document.getElementById('arrow-' + id);
        if (content.style.display === 'none') {
          content.style.display = 'block';
          arrow.innerHTML = '&#9660;';
        } else {
          content.style.display = 'none';
          arrow.innerHTML = '&#9654;';
        }
      }
      document.addEventListener("DOMContentLoaded", function () {
        document
          .querySelectorAll(".class-container")
          .forEach(function (classContainer) {
            classContainer.addEventListener("click", function () {
              const [_, enrollmentId, index] = this.id.split("_");
              const studentList = document.getElementById(
                `studentList_${enrollmentId}_${index}`
              );
              const arrow = document.getElementById(
                `arrow_${enrollmentId}_${index}`
              );

              if (studentList.style.display === "none") {
                studentList.style.display = "block";
                arrow.textContent = "↑";
              } else {
                studentList.style.display = "none";
                arrow.textContent = "↓";
              }
            });
          });
      });

      /* ---- Add / Modify Enrollment drawer (AJAX, no page navigation) ----
         One shared right-side drawer, its iframe src swapped depending on
         whether "Add Enrollment" or a row's "Modify" button opened it. */
      let enModalDirty = false;

      function openEnrollmentDrawer(url, opts) {
        const overlay = document.getElementById('enModalOverlay');
        const iframe = document.getElementById('enModalIframe');
        const loading = document.getElementById('enModalLoading');
        const titleEl = document.getElementById('enModalTitle');
        const subtitleEl = document.getElementById('enModalSubtitle');
        const iconEl = document.getElementById('enModalIcon');
        if (!overlay || !iframe) return;

        if (titleEl) titleEl.textContent = opts.title;
        if (subtitleEl) subtitleEl.textContent = opts.subtitle;
        if (iconEl) iconEl.textContent = opts.icon;
        iframe.title = opts.title;

        iframe.style.display = 'none';
        if (loading) loading.style.display = 'flex';
        iframe.onload = function () {
          if (loading) loading.style.display = 'none';
          iframe.style.display = 'block';
        };
        iframe.src = url;

        overlay.classList.add('is-open');
        overlay.setAttribute('aria-hidden', 'false');
        document.body.style.overflow = 'hidden';
      }

      function openAddEnrollmentModal() {
        openEnrollmentDrawer('/enrollment/enroll?embed=workspace', {
          title: 'Add Enrollment',
          subtitle: 'Enroll classes and students for a term',
          icon: '📋'
        });
      }

      function openModifyEnrollmentModal(enrollmentId) {
        openEnrollmentDrawer('/enrollment/modifyEnrollment/' + enrollmentId + '?embed=workspace', {
          title: 'Modify Enrollment',
          subtitle: 'Update the term, classes, or students for this enrollment',
          icon: '✏️'
        });
      }

      function closeAddEnrollmentModal() {
        const overlay = document.getElementById('enModalOverlay');
        const iframe = document.getElementById('enModalIframe');
        if (!overlay) return;
        overlay.classList.remove('is-open');
        overlay.setAttribute('aria-hidden', 'true');
        document.body.style.overflow = '';
        if (iframe) iframe.src = 'about:blank';

        // The embedded page stays on itself (reloading in place) after a
        // successful save instead of redirecting back here, so there's no
        // navigation signal to detect completion — it posts a message to
        // us instead. Only refresh the list if that actually happened; a
        // plain cancel/close shouldn't reload anything.
        if (enModalDirty) {
          enModalDirty = false;
          window.location.reload();
        }
      }

      window.addEventListener('message', function (event) {
        if (event.origin !== window.location.origin) return;
        if (!event.data) return;
        if (event.data.managiraDrawerSaved) {
          enModalDirty = true;
        }
        // Deleting an enrollment leaves nothing behind for the drawer's
        // iframe to keep showing, so it asks us to close it immediately
        // instead of waiting for the user to close it manually.
        if (event.data.managiraDrawerClose) {
          closeAddEnrollmentModal();
        }
      });

      document.getElementById('enModalClose').addEventListener('click', closeAddEnrollmentModal);
      document.getElementById('enModalOverlay').addEventListener('click', function (event) {
        if (event.target === this) closeAddEnrollmentModal();
      });
      document.addEventListener('keydown', function (event) {
        if (event.key !== 'Escape') return;
        const overlay = document.getElementById('enModalOverlay');
        if (overlay && overlay.classList.contains('is-open')) closeAddEnrollmentModal();
      });
    </script>
  </body>
</html>
