<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Enrollment Page</title>
    <style>
      :root {
        --font-family: "<%= (session && session.fontStyle ? String(session.fontStyle).trim() : 'Inter') %>", sans-serif;
        --border: #e5e7eb;
        --bg: #f9fafb;
      }

      body {
        font-family: var(--font-family);
        margin: 0;
        background: var(--bg);
      }

      .enrollment-wrapper {
        max-width: 900px;
        margin: 0 auto;
        padding: 0 20px 60px;
      }

      .enrollment-card {
        background: #fff;
        box-shadow: 0 8px 22px rgba(15, 45, 50, 0.12);
        border: 1px solid #e5e7eb;
        border-radius: 14px;
        padding: 24px 22px;
        margin: 0 auto 28px auto;
        max-width: 100%;
        display: flex;
        flex-direction: column;
        align-items: stretch;
        gap: 12px;
      }

      .form-group {
        margin-bottom: 14px;
        text-align: left;
        width: 100%;
      }

      .form-group label {
        font-weight: 600;
        font-size: 14px;
        color: #111827;
        display: block;
        margin-bottom: 6px;
      }

      .form-group select,
      .form-group input[type="text"],
      .form-group input[type="number"] {
        width: 100%;
        padding: 10px 14px;
        border: 1px solid #d7dde5;
        border-radius: 10px;
        font-size: 14px;
        font-family: var(--font-family);
        box-sizing: border-box;
        transition: border-color 0.15s ease, box-shadow 0.15s ease;
      }

      .form-group select:focus,
      .form-group input[type="text"]:focus,
      .form-group input[type="number"]:focus {
        outline: none;
        border-color: var(--org-primary-color, #0f5a66);
        box-shadow: 0 0 0 3px rgba(15, 90, 102, 0.12);
      }

      h3, h4 {
        text-align: center;
        color: #111827;
      }

      .collapsible {
        width: 100%;
        margin: 0 auto 14px auto;
        text-align: center;
      }
      .collapsible-btn {
        background: var(--org-primary-color, #0f5a66);
        color: #fff;
        border: none;
        border-radius: 10px;
        padding: 10px 16px;
        cursor: pointer;
        margin-bottom: 10px;
        transition: background 0.18s ease, transform 0.15s ease;
        display: flex;
        align-items: center;
        justify-content: space-between;
        width: 100%;
        font-size: 14px;
        font-weight: 600;
        box-shadow: 0 4px 12px rgba(15, 90, 102, 0.16);
      }
      .collapsible-btn:hover {
        background: var(--org-primary-hover-fill, var(--org-primary-hover, #0d4f59));
        transform: translateY(-1px);
      }
      .arrow {
        display: inline-block;
        margin-left: 8px;
        transition: transform 0.3s;
      }
      .arrow.expanded {
        transform: rotate(90deg);
      }
      .collapsible-content {
        display: none;
        margin-top: 10px;
      }
      .collapsible-content.active {
        display: flex;
        flex-direction: column;
        justify-content: start;
      }

      .checkbox-container,
      .select-all-container {
        display: flex;
        flex-direction: row;
        align-items: center;
        justify-content: flex-start;
        text-align: left;
        gap: 10px;
        margin-bottom: 10px;
        width: 100%;
      }

      .checkbox-container input[type="checkbox"],
      .select-all-container input[type="checkbox"] {
        width: 18px;
        height: 18px;
        accent-color: var(--org-primary-color, #0f5a66);
      }

      .student-list {
        display: none;
        padding-left: 15px;
        border-left: 2px solid var(--border);
        margin-left: 10px;
      }

      .student-list.visible {
        display: block;
      }

      .form-actions {
        margin-top: 18px;
        display: flex;
        justify-content: flex-start;
        gap: 12px;
        position: sticky;
        bottom: 0;
        background: #fff;
        padding: 14px 0 calc(14px + env(safe-area-inset-bottom, 0px));
        border-top: 1px solid var(--border);
      }

      .form-actions button[type="button"] {
        width: auto;
        min-width: 0;
        padding: 10px 22px;
        display: inline-block;
        font-size: 15px;
        font-weight: 600;
        border-radius: 10px;
        box-shadow: 0 4px 12px rgba(15, 90, 102, 0.14);
      }

      #enrollSubmitBtn.is-saving {
        color: transparent !important;
        pointer-events: none;
        position: relative;
      }

      #enrollSubmitBtn.is-saving::after {
        content: '';
        position: absolute;
        left: 50%;
        top: 50%;
        width: 16px;
        height: 16px;
        margin: -8px 0 0 -8px;
        border: 2px solid rgba(255, 255, 255, 0.4);
        border-top-color: #fff;
        border-radius: 50%;
        animation: enrollBtnSpin 0.7s linear infinite;
      }

      @keyframes enrollBtnSpin {
        to { transform: rotate(360deg); }
      }

      .search-result-container {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin: 5px 0;
        padding: 6px 0;
        border-bottom: 1px solid var(--border);
        font-size: 14px;
      }

      .search-result-container button {
        background-color: var(--org-primary-color, #0f5a66);
        color: #fff;
        border: none;
        border-radius: 6px;
        font-size: 12px;
        padding: 4px 10px;
        cursor: pointer;
        transition: background-color 0.2s ease;
        width: auto;
      }

      .search-result-container button:hover {
        background-color: var(--org-primary-hover-fill, var(--org-primary-hover, #0d4f59));
      }

      @media screen and (max-width: 768px) {
        .enrollment-wrapper {
          padding: 0 16px 40px;
        }
        .enrollment-card {
          padding: 20px 16px;
        }
        .form-actions {
          flex-direction: column;
        }
      }
    </style>
  </head>
  <body>
    <%- include('../partials/flash') %>

    <div class="enrollment-wrapper">
      <h3>Select Classes and Students</h3>

      <form id="enrollmentForm" class="enrollment-card">
        <!-- School Year -->
        <div class="form-group">
          <label for="schoolYear">Select School Year:</label>
          <select id="schoolYear" name="schoolYearId" required>
            <option value="">Select a school year</option>
            <% schoolYears.forEach(schoolYear => { %>
            <option
              value="<%= schoolYear.school_year_id %>"
              data-terms="<%= JSON.stringify(schoolYear.terms) %>"
            >
              <%= schoolYear.year_label %>
            </option>
            <% }); %>
          </select>
        </div>

        <!-- Term -->
        <div class="form-group">
          <label for="term">Select Term:</label>
          <select id="term" name="termId" required>
            <option value="">Select a term</option>
          </select>
        </div>

        <!-- Classes and Students -->
        <h3>Select Classes and Students</h3>
        <div class="collapsible">
          <button type="button" class="collapsible-btn" onclick="toggleCollapsible()">
            <span>Show/Hide Classes</span>
            <span id="arrowIcon" class="arrow">&#9654;</span>
          </button>
          <div id="collapsibleContent" class="collapsible-content">
            <div class="select-all-container">
              <input
                type="checkbox"
                id="selectAllClasses"
                onclick="selectAllClassesAndStudents()"
              />
              <label for="selectAllClasses">Select All Classes and Students</label>
            </div>
            <% classes.forEach(cls => { %>
            <div class="checkbox-container">
              <input
                type="checkbox"
                id="class_<%= cls.class_id %>"
                name="selectedClasses[]"
                value="<%= cls.class_id %>"
                onchange="toggleStudents('<%= cls.class_id %>')"
              />
              <label for="class_<%= cls.class_id %>"><%= cls.class_name %></label>
            </div>

            <div id="students_<%= cls.class_id %>" class="student-list">
              <div class="select-all-container">
                <input
                  type="checkbox"
                  id="selectAllStudents_<%= cls.class_id %>"
                  onclick="selectAllStudents('<%= cls.class_id %>')"
                />
                <label for="selectAllStudents_<%= cls.class_id %>">
                  Select All Students in <%= cls.class_name %>
                </label>
              </div>

              <!-- Existing enrolled students -->
              <div id="studentsContainer_<%= cls.class_id %>">
                <% cls.enrolledStudents.forEach(student => { %>
                <div class="checkbox-container">
                  <input
                    type="checkbox"
                    id="student_<%= student.student_id %>"
                    name="selectedStudents[<%= cls.class_id %>][]"
                    value="<%= student.student_id %>"
                  />
                  <label for="student_<%= student.student_id %>">
                    <%= student.first_name %> <%= student.last_name %>
                  </label>
                </div>
                <% }); %>
              </div>

              <!-- Divider for searched students -->
              <hr id="divider_<%= cls.class_id %>" style="display: none" />

              <!-- Container for newly added students from search -->
              <div id="searchedStudentsContainer_<%= cls.class_id %>"></div>

              <!-- Search bar for additional students -->
              <div class="form-group">
                <label for="searchInput_<%= cls.class_id %>"
                  >Search and Add Students:</label
                >
                <input
                  type="text"
                  id="searchInput_<%= cls.class_id %>"
                  placeholder="Type name to search"
                  oninput="searchStudents('<%= cls.class_id %>')"
                />
              </div>
              <div
                id="searchResults_<%= cls.class_id %>"
                class="search-results"
              ></div>
            </div>
            <% }); %>
          </div>
        </div>

        <div class="form-actions">
          <button type="button" id="enrollSubmitBtn" onclick="enrollStudents()">Enroll</button>
        </div>
      </form>
    </div>

    <script>
      function toggleCollapsible() {
        var content = document.getElementById('collapsibleContent');
        var arrow = document.getElementById('arrowIcon');
        content.classList.toggle('active');
        arrow.classList.toggle('expanded', content.classList.contains('active'));
      }
      document
        .getElementById("schoolYear")
        .addEventListener("change", function () {
          const selectedOption = this.options[this.selectedIndex];
          const terms = JSON.parse(selectedOption.getAttribute("data-terms"));
          const termSelect = document.getElementById("term");
          termSelect.innerHTML = '<option value="">Select a term</option>';
          if (terms && terms.length > 0) {
            terms.forEach((term) => {
              termSelect.innerHTML += `<option value="${term.term_id}">${term.term_name}</option>`;
            });
          }
        });

      function toggleStudents(classId) {
        const classCheckbox = document.getElementById(`class_${classId}`);
        const studentList = document.getElementById(`students_${classId}`);
        if (classCheckbox.checked) {
          studentList.classList.add("visible");
        } else {
          studentList.classList.remove("visible");
          const studentCheckboxes = studentList.querySelectorAll(
            'input[type="checkbox"]'
          );
          studentCheckboxes.forEach((cb) => (cb.checked = false));
        }
      }

      function selectAllClassesAndStudents() {
        const selectAllCheckbox = document.getElementById("selectAllClasses");
        const classCheckboxes = document.querySelectorAll(
          'input[name="selectedClasses[]"]'
        );
        const studentCheckboxes = document.querySelectorAll(
          'input[name^="selectedStudents"]'
        );
        classCheckboxes.forEach((cb) => {
          cb.checked = selectAllCheckbox.checked;
          toggleStudents(cb.value);
        });
        studentCheckboxes.forEach(
          (cb) => (cb.checked = selectAllCheckbox.checked)
        );
      }

      function selectAllStudents(classId) {
        const selectAllStudentsCheckbox = document.getElementById(
          `selectAllStudents_${classId}`
        );
        const studentCheckboxes =
          document.querySelectorAll(`#studentsContainer_${classId} input[type="checkbox"],
          #searchedStudentsContainer_${classId} input[type="checkbox"]`);
        studentCheckboxes.forEach((cb) => {
          cb.checked = selectAllStudentsCheckbox.checked;
        });
      }

      function escapeHtml(str) {
        return String(str)
          .replace(/&/g, "&amp;")
          .replace(/</g, "&lt;")
          .replace(/>/g, "&gt;")
          .replace(/"/g, "&quot;")
          .replace(/'/g, "&#039;");
      }

      async function searchStudents(classId) {
        const query = document
          .getElementById(`searchInput_${classId}`)
          .value.trim();
        const resultsContainer = document.getElementById(
          `searchResults_${classId}`
        );
        if (query.length < 2) {
          resultsContainer.innerHTML = "";
          return;
        }
        const response = await fetch(
          `/enrollment/searchUsers?query=${encodeURIComponent(query)}`
        );
        const data = await response.json();
        resultsContainer.innerHTML = "";
        (data.results || [])
          .filter((user) => user.type === "student")
          .forEach((student) => {
            const studentDisplayName = escapeHtml(student.display_name || [student.first_name, student.last_name].filter(Boolean).join(' ').trim());
            const studentElement = document.createElement("div");
            studentElement.classList.add("search-result-container");
            studentElement.innerHTML = `
            <span>${studentDisplayName} (Will be added to ${escapeHtml(student.class_name)})</span>
            <button type="button" onclick="addStudentToClass('${classId}', ${
              student.id
            }, '${studentDisplayName} (${escapeHtml(student.class_name)})')">
              ➕ Add
            </button>`;
            resultsContainer.appendChild(studentElement);
          });
      }

      function addStudentToClass(classId, studentId, studentName) {
        // Remove student from all other class containers
        document
          .querySelectorAll('.student-list input[type="checkbox"]')
          .forEach((cb) => {
            if (cb.value === studentId.toString()) {
              const container = cb.closest(".checkbox-container");
              if (container) container.remove();
            }
          });

        // Add student to the new class's container
        const container = document.getElementById(
          `searchedStudentsContainer_${classId}`
        );
        const divider = document.getElementById(`divider_${classId}`);
        divider.style.display = "block";
        const studentElement = document.createElement("div");
        studentElement.classList.add("checkbox-container");
        studentElement.innerHTML = `
                <input type="checkbox" id="student_${studentId}_added_${classId}" name="selectedStudents[${classId}][]" value="${studentId}" checked>
                <label for="student_${studentId}_added_${classId}">${studentName} (added)</label>`;
        container.appendChild(studentElement);

        // Clear search
        document.getElementById(`searchInput_${classId}`).value = "";
        document.getElementById(`searchResults_${classId}`).innerHTML = "";
      }

      function notifyParentDrawerSaved() {
        if (window.parent && window.parent !== window) {
          try {
            window.parent.postMessage({ managiraDrawerSaved: true }, window.location.origin);
          } catch (err) { /* ignore */ }
        }
      }

      async function enrollStudents() {
        const formElement = document.getElementById("enrollmentForm");
        const formData = new FormData(formElement);

        const selectedClasses = formData.getAll("selectedClasses[]");
        const selectedStudents = {};
        formData.forEach((value, key) => {
          if (key.startsWith("selectedStudents[")) {
            const classId = key.match(/selectedStudents\[(\d+)\]/)[1];
            if (!selectedStudents[classId]) selectedStudents[classId] = [];
            selectedStudents[classId].push(value);
          }
        });

        const termId = formData.get("termId");
        const schoolYearId = formData.get("schoolYearId");

        if (!termId || !schoolYearId || selectedClasses.length === 0) {
          alert("Please select a school year, term, and at least one class.");
          return;
        }

        const submitBtn = document.getElementById("enrollSubmitBtn");
        if (submitBtn) {
          submitBtn.disabled = true;
          submitBtn.classList.add('is-saving');
        }

        try {
          const rsp = await fetch("/enrollment/enroll", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({
              selectedClasses,
              selectedStudents,
              termId,
              schoolYearId,
            }),
          });

          const json = await rsp.json();
          if (json.conflicts && json.conflicts.length > 0) {
            let msg = "Some students are already in other classes:\n\n";
            json.conflicts.forEach((c) => {
              msg += `- ${c.studentName}: in "${c.currentClass}", moving to "${c.newClass}"\n`;
            });
            msg += "\nDo you want to move them to the new class?";
            if (confirm(msg)) {
              const confirmRsp = await fetch(
                `/enrollment/enroll?confirmMove=true`,
                {
                  method: "POST",
                  headers: { "Content-Type": "application/json" },
                  body: JSON.stringify({
                    selectedClasses,
                    selectedStudents,
                    termId,
                    schoolYearId,
                  }),
                }
              );
              const confirmJson = await confirmRsp.json();
              alert(confirmJson.message);
              if (confirmRsp.ok) {
                notifyParentDrawerSaved();
                location.reload();
                return;
              }
            } else {
              alert("No changes were made.");
            }
          } else {
            alert(json.message);
            if (rsp.ok) {
              notifyParentDrawerSaved();
              location.reload();
              return;
            }
          }
        } finally {
          if (submitBtn) {
            submitBtn.disabled = false;
            submitBtn.classList.remove('is-saving');
          }
        }
      }
    </script>
  </body>
</html>
