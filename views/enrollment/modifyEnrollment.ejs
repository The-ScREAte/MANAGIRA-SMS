<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Modify Enrollment</title>
    <style>
      :root {
        --font-family: "<%= (session && session.fontStyle ? String(session.fontStyle).trim() : 'Inter') %>", sans-serif;
      }


    body {
      font-family: var(--font-family);
    }
    .card {
      background: #fff;
      box-shadow: 0 2px 8px rgba(0,0,0,0.08);
      border-radius: 12px;
      padding: 32px 24px;
      margin: 0 auto 32px auto;
      max-width: 500px;
      display: flex;
      flex-direction: column;
      align-items: center;
    }
    .collapsible {
      width: 80%;
      margin: 0 auto 20px auto;
      text-align: center;
    }
    .collapsible-btn {
      background: #01535b;
      color: #fff;
      border: none;
      border-radius: 5px;
      padding: 8px 18px;
      cursor: pointer;
      margin-bottom: 10px;
      transition: background 0.3s;
      display: flex;
      align-items: center;
      justify-content: space-between;
      width: 100%;
      font-size: 1rem;
    }
    .arrow {
      display: inline-block;
      margin-left: 8px;
      transition: transform 0.3s;
    }
    .arrow.expanded {
      transform: rotate(90deg);
    }
    #schoolYear,
    #term {
      width: 90%;
      max-width: 350px;
      margin-left: auto;
      margin-right: auto;
      display: block;
    }
    .select-all-container,
    .checkbox-container {
      display: flex;
      flex-direction: row;
      align-items: center;
      justify-content: flex-start;
      text-align: left;
      gap: 10px;
      margin-bottom: 10px;
      width: 100%;
    }
    .form-actions button[type="button"] {
      width: auto;
      min-width: 0;
      padding: 10px 28px;
      display: inline-block;
    }
        body {
            font-family: var(--font-family);
            margin: 0;
        }
        
        main {
            text-align: center;
            margin: 0 auto;
            width: 90%;
            max-width: 1000px;
            padding: 20px;
        }
        
        h3, h4 {
            text-align: center;
        }
        
        .form-group {
            margin-bottom: 15px;
            text-align: left;
            min-width: 80%;
        }
        
        label {
            font-weight: bold;
        }
        
        select,
        input[type="text"],
        input[type="number"] {
            width: 100%;
            padding: 8px;
            margin-top: 5px;
            border: 1px solid #ccc;
            border-radius: 4px;
        }
        
        .center-link {
            display: flex;
            justify-content: center;
            margin-bottom: 20px;
        }
        
        .center-link button {
            margin: 0 10px;
            padding: 10px 20px;
            border: none;
            background-color: var(--org-primary-color);
            color: white;
            cursor: pointer;
            border-radius: 5px;
            transition: background-color 0.3s ease;
        }
        
        .center-link button:hover {
            background-color: var(--org-primary-hover);
        }

        .collapsible-content{
          display: none;
        }
        .collapsible-content.active{
          display: block;
        }
        .checkbox-container,
        .select-all-container {
            display: flex;
            align-items: center;
            gap: 10px;
            margin-bottom: 10px;
        }
        
        .student-list {
            display: none;
            padding-left: 15px;
            border-left: 2px solid #ccc;
            margin-left: 10px;
        }
        
        .student-list.visible {
            display: block;
        }
        
        .form-actions {
            margin-top: 20px;
            display: flex;
            flex-wrap: wrap;
            gap: 15px;
            justify-content: center;
        }
        
        .submit-button {
            padding: 10px 20px;
            background-color: var(--org-primary-color);
            color: white;
            border: none;
            cursor: pointer;
            border-radius: 5px;
        }
        
        .submit-button:hover {
            background-color: #013c44;
        }
        
        .delete-button {
            background-color: #dc3545;
            color: white;
        }
        
        .delete-button:hover {
            background-color: #b21f2d;
        }
        
        .alert-success,
        .alert-danger {
            padding: 10px;
            margin-bottom: 15px;
            border-radius: 5px;
            text-align: center;
        }
        
        .alert-success {
            background-color: #d4edda;
            color: #155724;
        }
        
        .alert-danger {
            background-color: #f8d7da;
            color: #721c24;
        }
        
        @media screen and (max-width: 768px) {
            .checkbox-container,
            .select-all-container {
                flex-direction: column;
                align-items: flex-start;
            }
        
            .form-actions {
                flex-direction: column;
                align-items: center;
            }
        
            .center-link {
                flex-direction: column;
            }
        
            .center-link button {
                margin-bottom: 10px;
            }
        }
            .checkbox-container {
              display: flex;
              align-items: center;
              gap: 8px;
              margin: 8px 0;
            }
            .class-block { margin-bottom: 20px; }
            .student-list { margin-left: 20px; display: none; }
            .student-list.visible { display: block; }
            .student-list-inherited { margin-bottom: 10px; }
            .search-add input { width: 60%; padding: 6px; }
            .search-result { display: flex; justify-content: space-between; align-items: center; gap: 10px; }
            .search-result button { width: 60px; padding: 4px 8px; background: #01535b; color: #fff; border: none; border-radius: 4px; cursor: pointer; }
            .search-result button:hover { background: #013c44; }
            hr { margin: 12px 0; }
          </style>
          </head>
          <body>
          <main>
            <%- include('../partials/flash') %>
          
            <div class="center-link">
              <button onclick="location.href='/enrollment/manageEnrollment'">Manage Enrollments</button>
            </div>
            <hr style="margin: 18px auto; width: 60%; border: 0; border-top: 1.5px solid #eee;" />
            <h1 style="text-align:center;">Modify Enrollments</h1>
          
            <form id="modifyEnrollmentForm" class="card">
              <input type="hidden" id="enrollmentId" value="<%= enrollmentId %>">
          
              <!-- Year / Term -->
              <div class="form-group">
                <label>School Year:</label>
                <select id="schoolYear" name="schoolYearId" required>
                  <% schoolYears.forEach(sy => { %>
                    <option value="<%= sy.school_year_id %>" data-terms='<%= JSON.stringify(sy.terms) %>' <%= sy.selected ? "selected" : "" %>><%= sy.year_label %></option>
                  <% }) %>
                </select>
              </div>
          
              <div class="form-group">
                <label>Term:</label>
                <select id="term" name="termId" required>
                  <% currentTerms.forEach(t => { %>
                    <option value="<%= t.term_id %>" <%= t.selected ? "selected" : "" %>><%= t.term_name %></option>
                  <% }) %>
                </select>
              </div>
          
              <!-- Classes and Students -->
              <h4>Classes & Students</h4>
              <div class="collapsible">
                <button type="button" class="collapsible-btn" onclick="toggleCollapsible()">
                  <span>Show/Hide Classes</span>
                  <span id="arrowIcon" class="arrow">&#9654;</span>
                </button>
                <div id="collapsibleContent" class="collapsible-content">
                  <div class="select-all-container">
                    <input type="checkbox" id="selectAllClasses" onclick="toggleAllClasses()">
                    <label for="selectAllClasses">Select All Classes & Students</label>
                  </div>
                  <% classes.forEach(cls => { %>
                    <div class="class-block">
                      <div class="checkbox-container">
                        <input type="checkbox" id="class_<%= cls.class_id %>" name="selectedClasses[]" value="<%= cls.class_id %>" <%= cls.selected ? 'checked' : '' %> onchange="toggleStudents('<%= cls.class_id %>')">
                        <label for="class_<%= cls.class_id %>"><%= cls.class_name %></label>
                      </div>
                      <div id="students_<%= cls.class_id %>" class="student-list">
                        <!-- Already enrolled -->
                        <div class="student-list-inherited">
                            <% cls.students.forEach(s => { %>
                              <div class="checkbox-container">
                                <input type="checkbox"
                                       id="student_<%= s.student_id %>"
                                       name="selectedStudents[<%= cls.class_id %>][]"
                                       value="<%= s.student_id %>"
                                       checked>
                                <label for="student_<%= s.student_id %>"><%= s.first_name %> <%= s.last_name %></label>
                              </div>
                            <% }) %>
                          </div>
                        <!-- Divider -->
                        <hr/>
                        <!-- Search and add new -->
                        <div class="search-add">
                          <input type="text" placeholder="Search students..." oninput="searchStudents('<%= cls.class_id %>', this.value)">
                          <div class="search-results" id="searchResults_<%= cls.class_id %>"></div>
                        </div>
                      </div>
                    </div>
                  <% }) %>
                </div>
              </div>
          
              <!-- Actions -->
              <div class="form-actions">
                <button type="button" class="submit-button" onclick="modifyEnrollment()">Save</button>
                <button type="button" class="delete-button" onclick="confirmDelete()">Delete</button>
              </div>
            </form>
          </main>
          
          <script>
            function toggleCollapsible() {
              var content = document.getElementById('collapsibleContent');
              var arrow = document.getElementById('arrowIcon');
              content.classList.toggle('active');
              arrow.classList.toggle('expanded', content.classList.contains('active'));
            }
            // Dynamic dropdown of terms
            document.getElementById('schoolYear').addEventListener('change', e => {
              const terms = JSON.parse(e.target.selectedOptions[0].dataset.terms)
              const termSelect = document.getElementById('term')
              termSelect.innerHTML = terms.map(t => `<option value="${t.term_id}">${t.term_name}</option>`).join('')
            })
          
            function toggleStudents(cid) {
              const cl = document.getElementById(`class_${cid}`)
              const sl = document.getElementById(`students_${cid}`)
              if (cl.checked) sl.classList.add('visible')
              else {
                sl.classList.remove('visible')
                sl.querySelectorAll('input[type=checkbox]').forEach(cb => cb.checked = false)
              }
            }
          
            function toggleAllClasses() {
              const checked = document.getElementById('selectAllClasses').checked
              document.querySelectorAll('input[name="selectedClasses[]"]').forEach(c => {
                c.checked = checked
                toggleStudents(c.value)
              })
              document.querySelectorAll('.student-list input[name^="selectedStudents"]').forEach(c => c.checked = checked)
            }
            
            function escapeHtml(str) {
        return String(str)
          .replace(/&/g, "&amp;")
          .replace(/</g, "&lt;")
          .replace(/>/g, "&gt;")
          .replace(/"/g, "&quot;")
          .replace(/'/g, "&#039;");
      }
            async function searchStudents(cid, query) {
                const resEl = document.getElementById(`searchResults_${cid}`)
                if (!query.trim()) {
                  resEl.innerHTML = ''
                  return
                }
                const resp = await fetch(`/enrollment/searchUsers?query=${encodeURIComponent(query)}`)
                const data = await resp.json()
                resEl.innerHTML = data.users
                  .filter(u => u.type === 'student')
                  .map(s => `
                    <div class="checkbox-container search-result">
                      <span>${escapeHtml(s.first_name)} ${escapeHtml(s.last_name)} (${escapeHtml(s.class_name)})</span>
                      <button type="button" onclick="addStudent('${cid}', ${s.student_id}, '${escapeHtml(s.first_name)} ${escapeHtml(s.last_name)}')">Add</button>
                    </div>
                  `).join('')
              }
            
              function addStudent(cid, sid, name) {
                // Remove the student from any other class lists
                document.querySelectorAll('.student-list input[type="checkbox"]').forEach(cb => {
                  if (cb.value === sid.toString()) {
                    const parentContainer = cb.closest('.checkbox-container');
                    if (parentContainer) parentContainer.remove();
                  }
                });
              
                // Create the new student element for the new class
                const container = document.getElementById(`students_${cid}`);
                const html = `
                  <div class="checkbox-container">
                    <input type="checkbox" id="student_${sid}_added_${cid}" name="selectedStudents[${cid}][]" value="${sid}" checked>
                    <label for="student_${sid}_added_${cid}">${name} (added)</label>
                  </div>`;
                container.querySelector('.search-add').insertAdjacentHTML('beforebegin', html);
              
                // Clear search input and results
                document.querySelector(`#searchResults_${cid}`).innerHTML = '';
                document.querySelector(`#students_${cid} input[placeholder="Search students..."]`).value = '';
              }
                 
                    
              async function modifyEnrollment() {
                const formElement = document.getElementById('modifyEnrollmentForm');
                const formData = new FormData(formElement);
                const body = {
                  termId: formData.get('termId'),
                  schoolYearId: formData.get('schoolYearId'),
                  selectedClasses: formData.getAll('selectedClasses[]'),
                  selectedStudents: {}
                };
                for (let [k, v] of formData.entries())
                  if (k.startsWith('selectedStudents[')) {
                    let cid = k.match(/selectedStudents\[(\d+)\]/)[1];
                    body.selectedStudents[cid] = body.selectedStudents[cid] || [];
                    body.selectedStudents[cid].push(v);
                  }
              
                const eid = document.getElementById('enrollmentId').value;
                const rsp = await fetch(`/enrollment/modifyEnrollment/${eid}`, {
                  method: 'POST',
                  headers: { 'Content-Type': 'application/json' },
                  body: JSON.stringify(body)
                });
                const json = await rsp.json();
              
                if (json.conflicts && json.conflicts.length > 0) {
                  let msg = 'Some students are already enrolled in other classes:\n\n';
                  json.conflicts.forEach(c => {
                    msg += `- ${c.studentName}: in "${c.currentClass}", moving to "${c.newClass}"\n`;
                  });
                  msg += '\nDo you want to move them to the new class?';
                  if (confirm(msg)) {
                    const confirmRsp = await fetch(`/enrollment/modifyEnrollment/${eid}?confirmMove=true`, {
                      method: 'POST',
                      headers: { 'Content-Type': 'application/json' },
                      body: JSON.stringify(body)
                    });
                    const confirmJson = await confirmRsp.json();
                    alert(confirmJson.message);
                    if (confirmRsp.ok) location.href = '/enrollment/manageEnrollment';
                  } else {
                    alert('No changes were made.');
                  }
                } else {
                  alert(json.message);
                  if (rsp.ok) location.href = '/enrollment/manageEnrollment';
                }
              }
                        
            function confirmDelete() {
              if (!confirm('Delete this enrollment?')) return
              const eid = document.getElementById('enrollmentId').value
              fetch(`/enrollment/deleteEnrollment/${eid}`, { method: 'POST' })
                .then(r => {
                  if (r.ok) alert('Deleted'), location.href = '/enrollment/manageEnrollment'
                  else alert('Delete failed')
                })
            }
          </script>
          </body>
          </html>
