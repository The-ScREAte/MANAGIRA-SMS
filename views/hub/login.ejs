<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Hub Login - Managira</title>
  <link rel="icon" href="/favicon.ico" type="image/x-icon" sizes="any" />
  <link rel="apple-touch-icon" sizes="180x180" href="/images/favicon_io/apple-touch-icon.png" />
  <link rel="shortcut icon" href="/favicon.ico" />
  <script src="/js/authNavigator.js" defer></script>
  <style>
    :root {
      --font-family: "Inter", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
      --primary: #01535b;
      --primary-hover: #014a51;
        --primary-hover-fill: color-mix(in srgb, var(--primary) 88%, white);
      --primary-light: rgba(1, 83, 91, 0.08);
      --text-primary: #1e293b;
      --text-secondary: #64748b;
      --border: #e2e8f0;
      --bg-page: #f8fafc;
      --bg-card: #ffffff;
      --error: #dc2626;
      --success: #059669;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      font-family: var(--font-family);
      background: var(--bg-page);
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      padding: 0;
      margin: 0;
    }

    .page-wrapper {
      flex: 1;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 12px 20px;
      width: 100%;
    }

    .login-container {
      width: 100%;
      max-width: 420px;
      margin-top: 0;
    }

    .login-card {
      background: var(--bg-card);
      border-radius: 14px;
      box-shadow: 0 4px 24px rgba(0, 0, 0, 0.08), 0 1px 3px rgba(0, 0, 0, 0.04);
      padding: 22px 26px;
      border: 1px solid var(--border);
    }

    .login-header {
      text-align: center;
      margin-bottom: 20px;
    }

    .login-header h1 {
      font-size: 1.5rem;
      font-weight: 700;
      color: var(--text-primary);
      margin-bottom: 6px;
    }

    .login-header p {
      color: var(--text-secondary);
      font-size: 0.9rem;
    }

    .password-input-wrapper {
      position: relative;
      width: 100%;
    }

    .password-input-wrapper .form-input {
      width: 100%;
      padding-right: 38px;
    }

    .password-input-wrapper .form-input:focus {
      box-shadow: none;
    }

    .password-toggle-btn {
      position: absolute;
      right: 12px;
      top: 50%;
      transform: translateY(-50%);
      background: transparent;
      border: none;
      color: var(--text-secondary);
      cursor: pointer;
      padding: 4px;
      transition: color 0.2s ease;
      font-size: 0.95rem;
      display: flex;
      align-items: center;
      justify-content: center;
      z-index: 1;
      pointer-events: auto;
      width: 24px;
      height: 24px;
      flex-shrink: 0;
    }

    .password-toggle-btn:hover {
      color: var(--primary);
      transform: translateY(-50%);
    }

    .password-toggle-btn:active {
      transform: translateY(-50%);
    }

    .password-toggle-btn:focus {
      outline: none;
      transform: translateY(-50%);
    }

    .password-toggle-btn i {
      font-size: 0.9rem;
      transition: none;
    }

    .form-group {
      width: 100%;
      margin-bottom: 16px;
    }

    #hubLoginForm input[type="email"].form-input {
      width: 100%;
      max-width: 100%;
    }

    .form-label {
      display: block;
      font-weight: 600;
      color: var(--text-primary);
      margin-bottom: 8px;
      font-size: 0.9rem;
    }

    .form-input {
      display: block;
      width: 100%;
      min-width: 0;
      max-width: 100%;
      box-sizing: border-box;
      padding: 5px 16px;
      height: 36px;
      line-height: 1.2;
      -webkit-appearance: none;
      appearance: none;
      border: 2px solid var(--border);
      border-radius: 10px;
      font-size: 1rem;
      font-family: inherit;
      transition: all 0.2s ease;
      background: var(--bg-card);
      color: var(--text-primary);
    }

    .form-input:focus {
      outline: none;
      border-color: var(--primary);
      box-shadow: 0 0 0 3px var(--primary-light);
    }

    .form-input::placeholder {
      color: var(--text-secondary);
      opacity: 0.7;
    }

    .btn-primary {
      width: 100%;
      padding: 14px 24px;
      background: linear-gradient(135deg, var(--primary) 0%, #0a6d77 100%);
      color: white;
      border: none;
      border-radius: 10px;
      font-size: 1rem;
      font-weight: 600;
      cursor: pointer;
      transition: all 0.2s ease;
      box-shadow: 0 2px 8px rgba(1, 83, 91, 0.25);
      margin-top: 8px;
    }

    .btn-primary:hover {
      transform: translateY(-2px);
      box-shadow: 0 6px 20px rgba(1, 83, 91, 0.35);
    }

    .btn-primary:active {
      transform: translateY(0);
    }

    .login-links {
      text-align: center;
      margin-top: 16px;
      padding-top: 16px;
      border-top: 1px solid var(--border);
    }

    .login-links p {
      font-size: 0.9rem;
      color: var(--text-secondary);
      margin-bottom: 0;
    }

    .login-links a {
      color: var(--primary);
      text-decoration: none;
      font-weight: 600;
      transition: color 0.2s ease;
    }

    .login-links a:hover {
      color: var(--primary-hover);
      text-decoration: underline;
    }

    @media (max-width: 768px) {
      .page-wrapper {
        padding: 30px 16px 10px;
      }
      .login-container {
        margin-top: 0;
        padding-top: 0;
        padding: 0;
      }
      .login-card {
        padding: 22px 22px;
      }
      .login-header h1 {
        font-size: 1.5rem;
      }
    }

    @media (max-width: 480px) {
      .page-wrapper {
        padding: 22px 12px 8px;
      }
      .login-container {
        margin-top: 0;
        padding-top: 0;
      }
      .login-card {
        padding: 20px 18px;
        border-radius: 12px;
      }
      .login-header h1 {
        font-size: 1.1rem;
      }
      .login-header p {
        font-size: 0.8rem;
      }
      .form-label {
        font-size: 0.8rem;
      }
      .form-input {
        padding: 3px 10px;
        font-size: 14px;
        height: 32px;
      }
      .btn-primary {
        padding: 8px 16px;
        font-size: 0.9rem;
      }
      .login-links p {
        font-size: 0.85rem;
      }
    }
  </style>
</head>
<body>
  <div class="page-wrapper">
    <div class="login-container">
      <div class="login-card">
        <div class="login-header">
          <h1>Hub sign in</h1>
          <p>Access your Managira hub dashboard.</p>
        </div>

        <%- include('../partials/flash') %>

        <form id="hubLoginForm" action="/hub/login" method="POST">
          <div class="form-group">
            <label class="form-label" for="email">Email Address</label>
            <input 
              type="email" 
              name="email" 
              id="email" 
              class="form-input" 
              placeholder="hub@example.com" 
              required 
              autofocus
            >
          </div>

          <div class="form-group">
            <label class="form-label" for="password">Password</label>
            <div class="password-input-wrapper">
              <input 
                type="password" 
                name="password" 
                id="password" 
                class="form-input" 
                placeholder="Enter your password" 
                required
                autocomplete="current-password"
              >
              <button type="button" class="password-toggle-btn" onclick="togglePasswordVisibility('password', this)" onmousedown="event.preventDefault()" aria-label="Show password">
                <i class="fa-solid fa-eye fa-fw" aria-hidden="true"></i>
              </button>
            </div>
          </div>

          <button type="submit" class="btn-primary">Sign In</button>
        </form>

        <div class="login-links">
          <p>Need a hub account? <a href="/legal/help">Contact support</a></p>
          <p><a href="/account/login">← Back to organization login</a></p>
        </div>
      </div>
    </div>
  </div>

  <script>
    function togglePasswordVisibility(inputId, button) {
      const input = document.getElementById(inputId);
      const icon = button.querySelector('i');
      const isPassword = input.type === 'password';

      input.type = isPassword ? 'text' : 'password';
      icon.classList.remove('fa-eye', 'fa-eye-slash');
      icon.classList.add(isPassword ? 'fa-eye-slash' : 'fa-eye');
      button.setAttribute('aria-label', isPassword ? 'Hide password' : 'Show password');
    }
  </script>
</body>
</html>