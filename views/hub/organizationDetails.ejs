<%
  const _org = organization || {};
  const _t = (typeof totals !== 'undefined' && totals) || {};
  const _num = (n) => Number(n || 0).toLocaleString('en-US');
  const _date = (d) => d ? new Date(d).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) : '—';
  const _hubNick = (hub && hub.hub_nickname) || '';
  const _tab = ['report', 'students', 'staff', 'classes'].includes(activeTab) && (activeTab === 'report' || (typeof hubCan !== 'function' || hubCan('people.view'))) ? activeTab : 'report';
  const _contact = [_org.first_name, _org.last_name].filter(Boolean).join(' ');
  const _can = (p) => (typeof hubCan === 'function' ? hubCan(p) : true);
  const _people = _can('people.view');
%>
<link rel="stylesheet" href="<%= assetUrl('/css/hub.css') %>" />

<div class="hub-shell">
  <%- include('partials/sidebar', { hubCurrent: 'schools' }) %>

  <div class="hub-main">
    <%- include('../partials/flash') %>

    <nav class="hub-crumbs" aria-label="Breadcrumb">
      <a href="/hub/dashboard#schools">Schools</a><i class="fa-solid fa-chevron-right" aria-hidden="true" style="font-size:.6rem"></i><span><%= _org.organization_name %></span>
    </nav>

    <header class="hub-hero">
      <div>
        <p class="hub-hero__eyebrow">School</p>
        <h1 class="hub-hero__title"><%= _org.organization_name %></h1>
        <div class="hub-hero__meta">
          <span><span class="hub-status<%= _org.on_hold ? ' hub-status--hold' : '' %>" style="background:rgba(255,255,255,.92)"><%= _org.on_hold ? 'On hold' : 'Active' %></span></span>
          <% if (_org.nickname) { %><span><i class="fa-solid fa-globe" aria-hidden="true"></i> <%= _org.nickname %>.<%= _hubNick %>.managira.com</span><% } %>
          <% if (_org.email) { %><span><i class="fa-regular fa-envelope" aria-hidden="true"></i> <%= _org.email %></span><% } %>
          <% if (_contact) { %><span><i class="fa-regular fa-user" aria-hidden="true"></i> <%= _contact %></span><% } %>
          <% if (_org.hub_contact_name) { %><span><i class="fa-solid fa-headset" aria-hidden="true"></i> Hub contact: <%= _org.hub_contact_name %></span><% } %>
          <% if (_org.joined_hub_at) { %><span><i class="fa-regular fa-calendar" aria-hidden="true"></i> Joined <%= _date(_org.joined_hub_at) %></span><% } %>
        </div>
      </div>
      <div class="hub-actions">
        <% if (_can('schools.access') && !_org.on_hold) { %><a class="hub-btn hub-btn--white" href="/hub/organizations/<%= _org.organization_id %>/open" data-open-school data-name="<%= _org.organization_name %>" data-no-spa><i class="fa-solid fa-arrow-right-to-bracket" aria-hidden="true"></i> Open school</a><% } %>
        <% if (_can('schools.edit')) { %><a class="hub-btn hub-btn--light" href="/hub/organizations/edit/<%= _org.organization_id %>" data-drawer><i class="fa-solid fa-pen" aria-hidden="true"></i> Edit details</a><% } %>
        <% if (_can('schools.hold') || _can('schools.remove')) { %>
        <details class="hub-menu">
          <summary class="hub-btn hub-btn--light" aria-label="More actions"><i class="fa-solid fa-ellipsis" aria-hidden="true"></i></summary>
          <div class="hub-menu__list">
            <% if (_can('schools.hold')) { %><button type="button" class="hub-menu__item" data-org-action="<%= _org.on_hold ? 'resume' : 'hold' %>" data-org-id="<%= _org.organization_id %>" data-org-name="<%= _org.organization_name %>"><i class="fa-solid <%= _org.on_hold ? 'fa-play' : 'fa-pause' %>" aria-hidden="true"></i> <%= _org.on_hold ? 'Resume school' : 'Put on hold' %></button><% } %>
            <% if (_can('schools.remove')) { %>
            <div class="hub-menu__sep"></div>
            <button type="button" class="hub-menu__item hub-menu__item--danger" data-org-action="remove" data-org-id="<%= _org.organization_id %>" data-org-name="<%= _org.organization_name %>"><i class="fa-solid fa-link-slash" aria-hidden="true"></i> Remove from hub</button>
            <button type="button" class="hub-menu__item hub-menu__item--danger" data-org-action="delete" data-org-id="<%= _org.organization_id %>" data-org-name="<%= _org.organization_name %>"><i class="fa-solid fa-trash" aria-hidden="true"></i> Delete permanently</button>
            <% } %>
          </div>
        </details>
        <% } %>
      </div>
    </header>

    <div class="hub-kpis">
      <button type="button" class="hub-kpi hub-kpi--blue" <%= _people ? 'data-jump-tab=students' : 'disabled' %>>
        <span class="hub-kpi__top"><span class="hub-kpi__icon"><i class="fa-solid fa-user-graduate" aria-hidden="true"></i></span><span class="hub-kpi__label">Active students</span></span>
        <span class="hub-kpi__value"><%= _num(_t.students) %></span>
        <span class="hub-kpi__note">Graduated &amp; archived not counted</span>
      </button>
      <button type="button" class="hub-kpi hub-kpi--amber" <%= _people ? 'data-jump-tab=staff' : 'disabled' %>>
        <span class="hub-kpi__top"><span class="hub-kpi__icon"><i class="fa-solid fa-user-tie" aria-hidden="true"></i></span><span class="hub-kpi__label">Staff</span></span>
        <span class="hub-kpi__value"><%= _num(_t.staff) %></span>
        <span class="hub-kpi__note">Managers, supervisors, teachers, drivers</span>
      </button>
      <button type="button" class="hub-kpi hub-kpi--violet" <%= _people ? 'data-jump-tab=classes' : 'disabled' %>>
        <span class="hub-kpi__top"><span class="hub-kpi__icon"><i class="fa-solid fa-chalkboard" aria-hidden="true"></i></span><span class="hub-kpi__label">Classes</span></span>
        <span class="hub-kpi__value"><%= _num(_t.classes) %></span>
        <span class="hub-kpi__note">All classes in the school</span>
      </button>
      <button type="button" class="hub-kpi hub-kpi--teal" <%= _people ? 'data-jump-tab=classes' : 'disabled' %>>
        <span class="hub-kpi__top"><span class="hub-kpi__icon"><i class="fa-solid fa-book" aria-hidden="true"></i></span><span class="hub-kpi__label">Subjects</span></span>
        <span class="hub-kpi__value"><%= _num(_t.subjects) %></span>
        <span class="hub-kpi__note">Counted once, even if many classes take it</span>
      </button>
    </div>

    <div class="hub-tabs" role="tablist" data-hub-tabs data-org-id="<%= _org.organization_id %>" data-initial="<%= _tab %>">
      <button type="button" class="hub-tab" role="tab" data-tab="report"><i class="fa-solid fa-chart-pie" aria-hidden="true"></i> Report</button>
      <% if (_people) { %>
      <button type="button" class="hub-tab" role="tab" data-tab="students"><i class="fa-solid fa-user-graduate" aria-hidden="true"></i> Students</button>
      <button type="button" class="hub-tab" role="tab" data-tab="staff"><i class="fa-solid fa-user-tie" aria-hidden="true"></i> Staff</button>
      <button type="button" class="hub-tab" role="tab" data-tab="classes"><i class="fa-solid fa-chalkboard" aria-hidden="true"></i> Classes &amp; subjects</button>
      <% } %>
    </div>

    <!-- Report: the same figures the school sees on its Organization Stats page -->
    <div class="hub-report" data-pane="report">
      <%- include('../stats/organizationStats', {
        isEmbedded: false,
        isPdf: false,
        organizationName: _org.organization_name,
        statsHeading: 'School report',
        statsBasePath: `/hub/organizations/${_org.organization_id}`,
        statsExportPath: `/hub/organizations/${_org.organization_id}/report/export`,
        statsExtraParams: { tab: 'report' },
        statsAllowPdf: _can('reports.export'),
        statsPdfPath: `/hub/organizations/${_org.organization_id}/report/pdf`,
        statsAllowCsv: _can('reports.export'),
        statsAllowPrint: true,
        statsAllowCompare: false,
        allowedFeatures: [],
      }) %>
    </div>

    <!-- Students / staff / classes -->
    <% if (_people) { %>
    <div class="hub-split" data-pane="people" data-hub-browser data-org-id="<%= _org.organization_id %>" hidden>
      <div class="hub-card">
        <div class="hub-card__head"><h2 class="hub-card__title" data-list-title>Loading…</h2></div>
        <label class="hub-search"><i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i><input type="search" data-search placeholder="Search…" aria-label="Search the list" /></label>
        <div class="hub-list" data-list></div>
      </div>
      <div class="hub-card hub-detail" data-detail aria-live="polite"></div>
    </div>
    <% } %>
  </div>
</div>

<script src="<%= assetUrl('/js/hub.js') %>"></script>
<script>
  (function () {
    document.querySelectorAll('[data-jump-tab]').forEach(function (b) {
      b.addEventListener('click', function () {
        var tab = document.querySelector('[data-hub-tabs] [data-tab="' + b.dataset.jumpTab + '"]');
        if (tab) { tab.click(); tab.scrollIntoView({ behavior: 'smooth', block: 'start' }); }
      });
    });
  })();
</script>
