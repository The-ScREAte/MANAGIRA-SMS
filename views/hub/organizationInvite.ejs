<style>
    :root {
      --primary: #01535b;
      --primary-hover: #014a51;
        --primary-hover-fill: color-mix(in srgb, var(--primary) 88%, white);
      --text-primary: #111827;
      --text-secondary: #6b7280;
      --border: #e5e7eb;
      --bg: #f9fafb;
      --success: #10b981;
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      font-family: "Inter", -apple-system, sans-serif;
      background: var(--bg);
      min-height: 100vh;
      padding: 50px;
    }

    .page-wrapper {
      max-width: 900px;
      margin: 0 auto;
    }

    .page-header {
      margin-bottom: 32px;
    }

    .back-link {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      color: var(--text-secondary);
      text-decoration: none;
      margin-bottom: 16px;
      font-size: 0.9rem;
      font-weight: 500;
      transition: color 0.2s;
    }

    .back-link:hover {
      color: var(--primary);
    }

    .page-title {
      font-size: 2rem;
      color: var(--text-primary);
      margin: 0 0 8px 0;
      font-weight: 700;
    }

    .page-subtitle {
      color: var(--text-secondary);
      font-size: 1rem;
      margin: 0;
    }

    .content-grid {
      display: grid;
      grid-template-columns: 1fr;
      gap: 24px;
    }

    .info-card {
      background: white;
      color: var(--text-primary);
      padding: 24px;
      border-radius: 12px;
      border: 2px solid var(--primary);
      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.06);
    }

    .info-card h3 {
      font-size: 1rem;
      margin: 0 0 12px 0;
      font-weight: 600;
      color: var(--text-secondary);
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }

    .org-limit {
      display: flex;
      align-items: center;
      gap: 16px;
    }

    .org-limit-numbers {
      font-size: 2.5rem;
      font-weight: 700;
      line-height: 1;
      color: var(--primary);
    }

    .org-limit-text {
      font-size: 0.85rem;
      color: var(--text-secondary);
    }

    .form-container {
      background: white;
      border-radius: 12px;
      border: 1px solid var(--border);
      padding: 32px;
      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
    }

    .form-header {
      margin-bottom: 28px;
      padding-bottom: 20px;
      border-bottom: 2px solid var(--bg);
    }

    .form-header h2 {
      font-size: 1.5rem;
      color: var(--text-primary);
      margin: 0 0 8px 0;
      font-weight: 700;
    }

    .form-header p {
      color: var(--text-secondary);
      margin: 0;
      font-size: 0.9rem;
    }

    .form-section {
      margin-bottom: 28px;
    }

    .form-section h3 {
      font-size: 1.1rem;
      margin-bottom: 20px;
      color: var(--text-primary);
      font-weight: 600;
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .section-icon {
      width: 28px;
      height: 28px;
      background: var(--bg);
      border-radius: 6px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1rem;
    }

    .form-group {
      margin-bottom: 20px;
    }

    .form-group label {
      display: block;
      font-weight: 600;
      color: var(--text-primary);
      margin-bottom: 8px;
      font-size: 0.9rem;
    }

    .form-group label .required { color: #dc2626; }

    .form-group input,
    .form-group textarea {
      width: 100%;
      padding: 12px 16px;
      border: 2px solid var(--border);
      border-radius: 8px;
      font-size: 0.95rem;
      font-family: inherit;
      transition: all 0.2s;
    }

    .form-group input:focus,
    .form-group textarea:focus {
      outline: none;
      border-color: var(--primary);
      box-shadow: 0 0 0 4px rgba(1, 83, 91, 0.08);
    }

    .form-group textarea {
      resize: vertical;
      min-height: 120px;
    }

    .form-group small {
      display: block;
      margin-top: 6px;
      color: var(--text-secondary);
      font-size: 0.85rem;
    }

    .button-group {
      display: flex;
      gap: 12px;
      margin-top: 32px;
      padding-top: 24px;
      border-top: 1px solid var(--border);
    }

    .btn {
      padding: 12px 24px;
      border: none;
      border-radius: 8px;
      font-weight: 600;
      font-size: 0.95rem;
      cursor: pointer;
      transition: all 0.2s;
      text-decoration: none;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      text-align: center;
      font-family: inherit;
    }

    .btn-primary {
      background: var(--primary);
      color: white;
      flex: 1;
    }

    .btn-primary:hover {
      background: var(--primary-hover-fill, var(--primary-hover));
    }

    .btn-secondary {
      background: white;
      color: #dc2626;
      border: 2px solid #dc2626;
    }

    .btn-secondary:hover {
      background: #dc2626;
      color: white;
    }

    @media (max-width: 768px) {
      body {
        padding: 24px 16px;
      }

      .page-title {
        font-size: 1.5rem;
      }

      .form-container {
        padding: 24px;
      }

      .button-group {
        flex-direction: column;
      }

      .btn {
        width: 100%;
      }
    }
  </style>

  <div class="page-wrapper">
    <div class="page-header">
      <a href="/hub/dashboard" class="back-link">
        <span>←</span> Back to Dashboard
      </a>
      <h1 class="page-title">📨 Invite Organization</h1>
      <p class="page-subtitle">Send an invitation to add an organization to <%= hub.hub_name %></p>
    </div>

    <div class="content-grid">
      <div class="info-card">
        <h3>Organization Capacity</h3>
        <div class="org-limit">
          <div>
            <div class="org-limit-numbers"><%= currentOrgCount %> / <%= hub.max_organizations %></div>
            <div class="org-limit-text">Current / Maximum Organizations</div>
          </div>
        </div>
      </div>

      <!-- Invitation Type Selection -->
      <div id="typeSelection" class="form-container">
        <div class="form-header">
          <h2>Choose Invitation Type</h2>
          <p>Select whether you're inviting a new organization or one already on Managira</p>
        </div>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-top: 24px;">
          <div onclick="showNewOrgForm()" style="background: white; border: 3px solid #01535b; color: #01535b; padding: 32px; border-radius: 12px; cursor: pointer; transition: all 0.2s; box-shadow: 0 2px 8px rgba(0, 0, 0, 0.06);" onmouseover="this.style.background='#01535b'; this.style.color='white'" onmouseout="this.style.background='white'; this.style.color='#01535b'">
            <div style="font-size: 3rem; text-align: center; margin-bottom: 16px;">✨</div>
            <h3 style="text-align: center; margin: 0 0 12px 0; font-size: 1.3rem;">New Organization</h3>
            <p style="text-align: center; margin: 0; font-size: 0.9rem;">Not on Managira yet</p>
            <p style="text-align: center; margin: 16px 0 0 0; font-size: 0.85rem; opacity: 0.8;">They'll create a new account and join your hub</p>
          </div>

          <div onclick="showExistingOrgForm()" style="background: white; border: 3px solid #ff6b00; color: #ff6b00; padding: 32px; border-radius: 12px; cursor: pointer; transition: all 0.2s; box-shadow: 0 2px 8px rgba(0, 0, 0, 0.06);" onmouseover="this.style.background='#ff6b00'; this.style.color='white'" onmouseout="this.style.background='white'; this.style.color='#ff6b00'">
            <div style="font-size: 3rem; text-align: center; margin-bottom: 16px;">🏢</div>
            <h3 style="text-align: center; margin: 0 0 12px 0; font-size: 1.3rem;">Existing Organization</h3>
            <p style="text-align: center; margin: 0; font-size: 0.9rem;">Already have a Managira account</p>
            <p style="text-align: center; margin: 16px 0 0 0; font-size: 0.85rem; opacity: 0.8;">Search and invite an organization already using Managira</p>
          </div>
        </div>

        <div style="text-align: center; margin-top: 24px; padding-top: 24px; border-top: 1px solid var(--border);">
          <a href="/hub/dashboard" class="btn btn-secondary">Cancel</a>
        </div>
      </div>

      <!-- New Organization Form (Hidden Initially) -->
      <div id="newOrgForm" class="form-container" style="display: none;">
        <div class="form-header">
          <button type="button" onclick="showTypeSelection()" class="back-link" style="border: none; background: none; padding: 0; cursor: pointer;">
            <span>←</span> Back to Selection
          </button>
          <h2 style="margin-top: 12px;">✨ Invite New Organization</h2>
          <p>They will create a new Managira account and join your hub</p>
        </div>

        <form action="/hub/organizations/invite" method="POST">
          <div class="form-section">
            <h3><span class="section-icon">🏫</span> Organization Details</h3>
            <div class="form-group">
              <label for="organization_name">Organization Name <span class="required">*</span></label>
              <input type="text" id="organization_name" name="organization_name" placeholder="Enter organization name" required>
            </div>
          </div>

          <div class="form-section">
            <h3><span class="section-icon">👤</span> Contact Person</h3>
            <div class="form-group">
              <label for="contact_person_name">Full Name <span class="required">*</span></label>
              <input type="text" id="contact_person_name" name="contact_person_name" placeholder="First and last name" required>
            </div>
            <div class="form-group">
              <label for="contact_person_email">Email Address <span class="required">*</span></label>
              <input type="email" id="contact_person_email" name="contact_person_email" placeholder="email@organization.com" required>
              <small>The invitation will be sent to this email address</small>
            </div>
            <div class="form-group">
              <label for="contact_person_phone">Phone Number</label>
              <input type="tel" id="contact_person_phone" name="contact_person_phone" placeholder="+1 (555) 123-4567">
            </div>
          </div>

          <div class="form-section">
            <h3><span class="section-icon">✉️</span> Message (Optional)</h3>
            <div class="form-group">
              <label for="message">Personal Message</label>
              <textarea id="message" name="message" placeholder="Add a personal note to include in the invitation email..."></textarea>
              <small>This message will be included in the invitation email</small>
            </div>
          </div>

          <div class="button-group">
            <button type="submit" class="btn btn-primary">
              <span>📧</span> Send Invitation
            </button>
            <button type="button" onclick="showTypeSelection()" class="btn btn-secondary">Cancel</button>
          </div>
        </form>
      </div>

      <!-- Existing Organization Form (Hidden Initially) -->
      <div id="existingOrgForm" class="form-container" style="display: none;">
        <div class="form-header">
          <button type="button" onclick="showTypeSelection()" class="back-link" style="border: none; background: none; padding: 0; cursor: pointer;">
            <span>←</span> Back to Selection
          </button>
          <h2 style="margin-top: 12px;">🏢 Invite Existing Organization</h2>
          <p>Search for an organization already on Managira and send them an invitation</p>
        </div>

        <div class="form-section">
          <h3><span class="section-icon">🔍</span> Search Organization</h3>
          <div class="form-group">
            <label for="searchOrg">Organization Name</label>
            <input type="text" id="searchOrg" placeholder="Type to search..." oninput="searchOrganizations(this.value)">
            <small>Search by organization name or email</small>
          </div>

          <div id="searchResults" style="margin-top: 16px; display: none;">
            <div style="background: var(--bg); padding: 16px; border-radius: 8px; border: 1px solid var(--border);">
              <h4 style="margin: 0 0 12px 0; font-size: 0.95rem; color: var(--text-secondary);">Search Results:</h4>
              <div id="resultsList"></div>
            </div>
          </div>

          <div id="noResults" style="display: none; text-align: center; padding: 32px; color: var(--text-secondary);">
            <div style="font-size: 3rem; margin-bottom: 16px; opacity: 0.5;">🔍</div>
            <p style="margin: 0;">No organizations found. Try a different search term.</p>
          </div>

          <div id="searchInstructions" style="text-align: center; padding: 32px; color: var(--text-secondary);">
            <div style="font-size: 3rem; margin-bottom: 16px; opacity: 0.5;">🔍</div>
            <p style="margin: 0;">Start typing to search for organizations</p>
          </div>
        </div>

        <div style="text-align: center; margin-top: 24px; padding-top: 24px; border-top: 1px solid var(--border);">
          <button type="button" onclick="showTypeSelection()" class="btn btn-secondary">Cancel</button>
        </div>
      </div>
    </div>
  </div>

  <script>
    function showTypeSelection() {
      document.getElementById('typeSelection').style.display = 'block';
      document.getElementById('newOrgForm').style.display = 'none';
      document.getElementById('existingOrgForm').style.display = 'none';
    }

    function showNewOrgForm() {
      document.getElementById('typeSelection').style.display = 'none';
      document.getElementById('newOrgForm').style.display = 'block';
      document.getElementById('existingOrgForm').style.display = 'none';
    }

    function showExistingOrgForm() {
      document.getElementById('typeSelection').style.display = 'none';
      document.getElementById('newOrgForm').style.display = 'none';
      document.getElementById('existingOrgForm').style.display = 'block';
    }

    let searchTimeout;
    function searchOrganizations(query) {
      clearTimeout(searchTimeout);
      
      const searchResults = document.getElementById('searchResults');
      const noResults = document.getElementById('noResults');
      const searchInstructions = document.getElementById('searchInstructions');
      const resultsList = document.getElementById('resultsList');

      if (query.length < 2) {
        searchResults.style.display = 'none';
        noResults.style.display = 'none';
        searchInstructions.style.display = 'block';
        return;
      }

      searchInstructions.style.display = 'none';

      searchTimeout = setTimeout(async () => {
        try {
          const response = await fetch(`/hub/organizations/search?q=${encodeURIComponent(query)}`);
          const data = await response.json();

          if (data.organizations && data.organizations.length > 0) {
            resultsList.innerHTML = data.organizations.map(org => `
              <div style="background: white; padding: 16px; border-radius: 8px; margin-bottom: 12px; border: 2px solid var(--border); transition: all 0.2s; cursor: pointer;" onmouseover="this.style.borderColor='var(--primary)'" onmouseout="this.style.borderColor='var(--border)'" onclick="selectOrganization(${org.organization_id}, '${org.organization_name.replace(/'/g, "\\'")}', '${org.email.replace(/'/g, "\\'")}')">
                <div style="display: flex; justify-content: space-between; align-items: start;">
                  <div style="flex: 1;">
                    <h4 style="margin: 0 0 8px 0; color: var(--text-primary); font-size: 1.05rem;">${org.organization_name}</h4>
                    <p style="margin: 0; color: var(--text-secondary); font-size: 0.85rem;">
                      📧 ${org.email}
                    </p>
                    <p style="margin: 4px 0 0 0; color: var(--text-secondary); font-size: 0.85rem;">
                      🌐 ${org.nickname}.managira.com
                    </p>
                    ${org.is_hub_member ? '<p style="margin: 8px 0 0 0; display: inline-block; padding: 4px 12px; background: #fff3cd; color: #856404; border-radius: 4px; font-size: 0.75rem; font-weight: 600;">⚠️ Already in a hub</p>' : ''}
                  </div>
                  <button type="button" style="padding: 8px 16px; background: var(--primary); color: white; border: none; border-radius: 6px; cursor: pointer; font-weight: 600; font-size: 0.85rem;" ${org.is_hub_member ? 'disabled style="opacity: 0.5; cursor: not-allowed;"' : ''}>
                    Select
                  </button>
                </div>
              </div>
            `).join('');
            searchResults.style.display = 'block';
            noResults.style.display = 'none';
          } else {
            searchResults.style.display = 'none';
            noResults.style.display = 'block';
          }
        } catch (error) {
          console.error('Search error:', error);
          resultsList.innerHTML = '<p style="color: #dc2626; text-align: center;">Error searching. Please try again.</p>';
          searchResults.style.display = 'block';
        }
      }, 300);
    }

    function selectOrganization(orgId, orgName, orgEmail) {
      if (confirm(`Send invitation to ${orgName}?\n\nThey will receive an email invitation to join your hub.`)) {
        // Create and submit form
        const form = document.createElement('form');
        form.method = 'POST';
        form.action = '/hub/organizations/invite-existing';

        const orgIdInput = document.createElement('input');
        orgIdInput.type = 'hidden';
        orgIdInput.name = 'organizationId';
        orgIdInput.value = orgId;
        form.appendChild(orgIdInput);

        document.body.appendChild(form);
        form.submit();
      }
    }
  </script>