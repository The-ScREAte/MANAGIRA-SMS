<link rel="stylesheet" href="/css/style.css">
<style>
  body {
    background: #f5f7fa;
    font-family: "Segoe UI", Tahoma, Geneva, Verdana, sans-serif;
    padding: 120px 20px 60px 20px;
  }

  .edit-container {
    max-width: 800px;
    margin: 0 auto;
    background: white;
    border-radius: 12px;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
    overflow: hidden;
  }

  .edit-header {
    background: white;
    color: #01535b;
    padding: 30px;
    text-align: center;
    border-bottom: 3px solid #01535b;
  }

  .edit-header h1 {
    font-size: 28px;
    margin-bottom: 8px;
  }

  .edit-header p {
    color: #6b7280;
    font-size: 15px;
  }

  .edit-content {
    padding: 40px;
  }

  .form-group {
    margin-bottom: 24px;
  }

  .form-group label {
    display: block;
    margin-bottom: 8px;
    color: #333;
    font-weight: 600;
    font-size: 14px;
  }

  .form-group input,
  .form-group textarea {
    width: 100%;
    padding: 12px;
    border: 2px solid #e5e7eb;
    border-radius: 8px;
    font-size: 15px;
    transition: border-color 0.2s;
  }

  .form-group input:focus,
  .form-group textarea:focus {
    outline: none;
    border-color: #01535b;
  }

  .form-group small {
    display: block;
    margin-top: 6px;
    color: #6b7280;
    font-size: 13px;
  }

  .form-group .readonly {
    background: #f3f4f6;
    color: #6b7280;
    cursor: not-allowed;
  }

  .button-group {
    display: flex;
    gap: 12px;
    margin-top: 32px;
  }

  .btn {
    padding: 12px 24px;
    border: none;
    border-radius: 8px;
    font-size: 15px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s;
    text-decoration: none;
    display: inline-block;
    text-align: center;
  }

  .btn-primary {
    background: #01535b;
    color: white;
    flex: 1;
  }

  .btn-primary:hover {
    background: #014a51;
  }

  .btn-secondary {
    background: white;
    color: #dc2626;
    border: 2px solid #dc2626;
  }

  .btn-secondary:hover {
    background: #dc2626;
    color: white;
  }

  .info-box {
    background: #e0f2fe;
    padding: 16px;
    border-radius: 8px;
    border-left: 4px solid #0284c7;
    margin-bottom: 24px;
  }

  .info-box h3 {
    color: #0369a1;
    margin-bottom: 8px;
    font-size: 16px;
  }

  .info-box p {
    color: #075985;
    font-size: 14px;
    line-height: 1.6;
  }

  @media (max-width: 768px) {
    body {
      padding: 100px 15px 40px 15px;
    }

    .edit-content {
      padding: 24px;
    }

    .button-group {
      flex-direction: column;
    }
  }
</style>

<div class="edit-container">
  <div class="edit-header">
    <h1>✏️ Edit Organization</h1>
    <p>Update organization details</p>
  </div>

  <div class="edit-content">
    <%- include('../partials/flash') %>

    <div class="info-box">
      <h3>ℹ️ Important</h3>
      <p>Some fields like subdomain and email cannot be changed. Contact support if you need to modify these.</p>
    </div>

    <form action="/hub/organizations/edit/<%= organization.organization_id %>" method="POST">
      <div class="form-group">
        <label for="organization_name">
          Organization Name <span style="color: #dc3545;">*</span>
        </label>
        <input
          type="text"
          id="organization_name"
          name="organization_name"
          value="<%= organization.organization_name %>"
          required
        />
      </div>

      <div class="form-group">
        <label for="subdomain">
          Subdomain (Read-only)
        </label>
        <input
          type="text"
          id="subdomain"
          value="<%= organization.nickname %>.<%= hub.hub_nickname %>.managira.com"
          class="readonly"
          readonly
        />
        <small>Contact support to change the subdomain</small>
      </div>

      <div class="form-group">
        <label for="email">
          Email (Read-only)
        </label>
        <input
          type="email"
          id="email"
          value="<%= organization.email %>"
          class="readonly"
          readonly
        />
        <small>Primary contact email cannot be changed</small>
      </div>

      <div class="form-group">
        <label for="organization_address">
          Address <span style="color: #dc3545;">*</span>
        </label>
        <textarea
          id="organization_address"
          name="organization_address"
          rows="3"
          required
        ><%= organization.organization_address %></textarea>
      </div>

      <div class="form-group">
        <label for="organization_country">
          Country
        </label>
        <input
          type="text"
          id="organization_country"
          name="organization_country"
          class="form-control"
          value="<%= organization.organization_country || '' %>"
          placeholder="e.g. United States"
        />
      </div>

      <div class="form-group">
        <label for="organization_province">
          Province / Region / State
        </label>
        <input
          type="text"
          id="organization_province"
          name="organization_province"
          class="form-control"
          value="<%= organization.organization_province || '' %>"
          placeholder="e.g. Ontario"
        />
      </div>

      <div class="form-group">
        <label for="organization_phone">
          Phone Number <span style="color: #dc3545;">*</span>
        </label>
        <input
          type="tel"
          id="organization_phone"
          name="organization_phone"
          value="<%= organization.organization_phone %>"
          required
        />
      </div>

      <div class="button-group">
        <button type="submit" class="btn btn-primary">💾 Save Changes</button>
        <a href="/hub/dashboard" class="btn btn-secondary">Cancel</a>
      </div>
    </form>
  </div>
</div>
