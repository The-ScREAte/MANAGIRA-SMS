<%
  const _state = typeof state !== 'undefined' ? state : 'error';
  const _hub = (typeof hub !== 'undefined' && hub) || {};
  const _details = (typeof details !== 'undefined' && Array.isArray(details)) ? details : [];
  const _card = (typeof card !== 'undefined' && card) || null;
  const _fmt = (v) => (v ? new Date(v).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric', timeZone: 'UTC' }) : '');
  const _first = typeof firstCharge !== 'undefined' ? firstCharge : null;
  const _hasCard = typeof hasCard !== 'undefined' && hasCard;
  const _go = `/hub/billing/setup/${token}/go`;
%>
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="noindex" />
  <title><%= _hub.hub_name ? `Payment for ${_hub.hub_name}` : 'Hub payment' %> · Managira</title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
  <style>
    :root { --brand: #01535b; --brand-dark: #013f45; --ink: #0f172a; --text: #334155; --muted: #64748b; --line: #e2e8f0; --bg: #f4f7f8; }
    * { box-sizing: border-box; }
    body { margin: 0; min-height: 100vh; background: var(--bg); color: var(--text); font: 15px/1.5 Inter, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif; display: flex; align-items: flex-start; justify-content: center; padding: 48px 16px; }
    .card { width: 100%; max-width: 520px; background: #fff; border: 1px solid var(--line); border-radius: 18px; padding: 30px 28px; box-shadow: 0 18px 48px rgba(15, 23, 42, .08); }
    .brand { display: flex; align-items: center; gap: 10px; color: var(--brand); font-weight: 800; letter-spacing: -.01em; margin-bottom: 22px; }
    .brand span { width: 34px; height: 34px; border-radius: 10px; background: var(--brand); color: #fff; display: grid; place-items: center; }
    .icon { width: 52px; height: 52px; border-radius: 14px; display: grid; place-items: center; font-size: 1.35rem; margin-bottom: 14px; background: #e6f2f2; color: var(--brand); }
    .icon--ok { background: #dcfce7; color: #15803d; }
    .icon--warn { background: #fef3c7; color: #b45309; }
    .icon--bad { background: #ffe4e6; color: #be123c; }
    h1 { margin: 0 0 6px; color: var(--ink); font-size: 1.4rem; letter-spacing: -.01em; }
    p { margin: 0 0 14px; }
    .muted { color: var(--muted); font-size: .9rem; }
    ul { list-style: none; margin: 18px 0; padding: 14px 16px; border: 1px solid var(--line); border-radius: 12px; background: #f8fafc; }
    li { padding: 4px 0; font-size: .92rem; }
    .btn { display: flex; align-items: center; justify-content: center; gap: 8px; width: 100%; height: 48px; border-radius: 11px; background: var(--brand); color: #fff; font-weight: 700; text-decoration: none; font-size: 1rem; }
    .btn:hover { background: var(--brand-dark); }
    .btn--light { background: #fff; color: var(--ink); border: 1px solid var(--line); margin-top: 10px; }
    .btn--light:hover { background: #f1f5f9; }
    .secure { display: flex; align-items: center; justify-content: center; gap: 8px; margin-top: 14px; color: var(--muted); font-size: .82rem; }
  </style>
</head>
<body>
  <main class="card">
    <div class="brand"><span><i class="fa-solid fa-graduation-cap" aria-hidden="true"></i></span> Managira</div>

    <% if (_state === 'ready' || _state === 'cancelled') { %>
      <div class="icon<%= _state === 'cancelled' ? ' icon--warn' : '' %>"><i class="fa-solid fa-credit-card" aria-hidden="true"></i></div>
      <h1><%= _hasCard ? 'Change the card' : 'Add your card' %></h1>
      <p><% if (_state === 'cancelled') { %>No card was saved. You can try again below.<% } else { %>For <strong><%= _hub.hub_name %></strong>’s Managira hub. The card is saved by Stripe and charged only on the dates in your agreement.<% } %></p>
      <% if (_details.length) { %>
        <ul><% _details.forEach((d) => { %><li><%= d %></li><% }) %></ul>
      <% } %>
      <a class="btn" href="<%= _go %>"><i class="fa-solid fa-lock" aria-hidden="true"></i> Continue to secure card page</a>
      <a class="btn btn--light" href="/hub/login">Sign in to your hub instead</a>
      <div class="secure"><i class="fa-brands fa-stripe" aria-hidden="true" style="font-size:1.6rem"></i> Card details go straight to Stripe. Managira never sees them.</div>
    <% } else if (_state === 'done') { %>
      <div class="icon icon--ok"><i class="fa-solid fa-check" aria-hidden="true"></i></div>
      <h1>Card saved</h1>
      <p><%= _card && _card.card_last4 && _card.card_last4 !== '0000' ? `The card ending ${_card.card_last4} will pay ${_hub.hub_name}’s bills.` : `Your payment method will pay ${_hub.hub_name}’s bills.` %></p>
      <p class="muted"><%= _first ? `Nothing is charged before ${_fmt(_first)}.` : 'Your first bill is being charged now; you will get a receipt by email.' %> You can see your plan, charges and bills on the Billing page of your hub.</p>
      <a class="btn" href="/hub/login">Sign in to your hub</a>
    <% } else if (_state === 'closed') { %>
      <div class="icon icon--warn"><i class="fa-solid fa-circle-info" aria-hidden="true"></i></div>
      <h1>Nothing to set up</h1>
      <p>Billing for <%= _hub.hub_name || 'this hub' %> isn’t open right now. Please contact Managira if you expected to add a card.</p>
      <a class="btn btn--light" href="/hub/login">Sign in to your hub</a>
    <% } else if (_state === 'invalid') { %>
      <div class="icon icon--bad"><i class="fa-solid fa-link-slash" aria-hidden="true"></i></div>
      <h1>This link doesn’t work</h1>
      <p>It may have been replaced by a newer link. Sign in to your hub and add the card from Billing, or ask Managira for a new link.</p>
      <a class="btn btn--light" href="/hub/login">Sign in to your hub</a>
    <% } else { %>
      <div class="icon icon--bad"><i class="fa-solid fa-triangle-exclamation" aria-hidden="true"></i></div>
      <h1>Something went wrong</h1>
      <p><%= (typeof message !== 'undefined' && message) || 'We couldn’t finish this. Please try again in a moment.' %></p>
      <a class="btn" href="/hub/billing/setup/<%= token %>">Try again</a>
      <a class="btn btn--light" href="/hub/login">Sign in to your hub</a>
    <% } %>
  </main>
</body>
</html>
