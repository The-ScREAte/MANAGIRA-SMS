<%
  const _orgs = Array.isArray(typeof organizations !== 'undefined' ? organizations : null) ? organizations : [];
  const _invites = Array.isArray(typeof pendingInvitations !== 'undefined' ? pendingInvitations : null) ? pendingInvitations : [];
  const _requests = Array.isArray(typeof detachmentRequests !== 'undefined' ? detachmentRequests : null) ? detachmentRequests : [];
  const _activity = Array.isArray(typeof recentActivity !== 'undefined' ? recentActivity : null) ? recentActivity : [];
  const _hub = hub || {};
  const _date = (d) => d ? new Date(d).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) : '—';
  const _num = (n) => Number(n || 0).toLocaleString('en-US');
  const _hasLogo = _hub.logo_path && _hub.logo_path.trim() && !/\/(images\/)?hub-logos$/.test(_hub.logo_path);
  const _onHold = _orgs.filter((o) => o.on_hold).length;
  const _capacity = _hub.max_organizations ? `${orgCount} of ${_hub.max_organizations}` : String(orgCount);
%>
<link rel="stylesheet" href="<%= assetUrl('/css/hubDashboard.css') %>" />

<div class="hub-shell" data-hub>
  <aside class="hub-side" aria-label="Hub">
    <div class="hub-brand">
      <span class="hub-brand__logo"><% if (_hasLogo) { %><img src="<%= _hub.logo_path %>" alt="" /><% } else { %><%= (_hub.hub_name || 'H').charAt(0).toUpperCase() %><% } %></span>
      <span>
        <span class="hub-brand__name"><%= _hub.hub_name || 'Your hub' %></span>
        <% if (_hub.hub_nickname) { %><span class="hub-brand__url"><%= _hub.hub_nickname %>.managira.com</span><% } %>
      </span>
    </div>
    <nav>
      <a class="hub-link" href="#overview" data-view-link="overview"><i class="fa-solid fa-gauge" aria-hidden="true"></i> Overview</a>
      <div class="hub-side__label">Reports</div>
      <a class="hub-link" href="#school-comparison" data-view-link="school-comparison"><i class="fa-solid fa-table-list" aria-hidden="true"></i> School comparison</a>
      <a class="hub-link" href="#attendance" data-view-link="attendance"><i class="fa-solid fa-calendar-check" aria-hidden="true"></i> Attendance</a>
      <a class="hub-link" href="#performance" data-view-link="performance"><i class="fa-solid fa-chart-line" aria-hidden="true"></i> Academic performance</a>
      <a class="hub-link" href="#enrollment" data-view-link="enrollment"><i class="fa-solid fa-users" aria-hidden="true"></i> Enrollment &amp; staffing</a>
      <div class="hub-side__label">Manage</div>
      <a class="hub-link" href="#schools" data-view-link="schools"><i class="fa-solid fa-school" aria-hidden="true"></i> Schools <span class="hub-count"><%= orgCount %></span></a>
      <a class="hub-link" href="#invitations" data-view-link="invitations"><i class="fa-solid fa-envelope-open-text" aria-hidden="true"></i> Invitations<% if (_invites.length) { %> <span class="hub-count"><%= _invites.length %></span><% } %></a>
      <a class="hub-link" href="#requests" data-view-link="requests"><i class="fa-solid fa-link-slash" aria-hidden="true"></i> Detachment requests<% if (_requests.length) { %> <span class="hub-count hub-count--warn"><%= _requests.length %></span><% } %></a>
      <a class="hub-link" href="/hub/settings"><i class="fa-solid fa-gear" aria-hidden="true"></i> Settings</a>
    </nav>
  </aside>

  <div class="hub-main">
    <%- include('../partials/flash') %>

    <!-- Overview -->
    <section class="hub-view" data-view="overview" aria-label="Overview">
      <header class="hub-head">
        <div>
          <h1 class="hub-title"><%= _hub.first_name ? `Welcome back, ${_hub.first_name}` : (_hub.hub_name || 'Hub overview') %></h1>
          <p class="hub-sub">Everything across your <%= orgCount === 1 ? 'school' : orgCount + ' schools' %> in one place.</p>
        </div>
        <div class="hub-actions">
          <a class="hub-btn hub-btn--primary" href="/hub/organizations/invite"><i class="fa-solid fa-plus" aria-hidden="true"></i> Invite a school</a>
        </div>
      </header>

      <div class="hub-kpis">
        <a class="hub-kpi" href="#schools"><i class="fa-solid fa-school hub-kpi__icon" aria-hidden="true"></i><span class="hub-kpi__value"><%= _num(orgCount) %></span><span class="hub-kpi__label">Schools</span><span class="hub-kpi__note"><%= _capacity %> places used<%= _onHold ? ` · ${_onHold} on hold` : '' %></span></a>
        <a class="hub-kpi" href="#enrollment"><i class="fa-solid fa-user-graduate hub-kpi__icon" aria-hidden="true"></i><span class="hub-kpi__value"><%= _num(totalStudents) %></span><span class="hub-kpi__label">Active students</span><span class="hub-kpi__note">Graduated &amp; archived not included</span></a>
        <a class="hub-kpi" href="#enrollment"><i class="fa-solid fa-chalkboard-user hub-kpi__icon" aria-hidden="true"></i><span class="hub-kpi__value"><%= _num(totalTeachers) %></span><span class="hub-kpi__label">Staff</span></a>
        <a class="hub-kpi" href="#enrollment"><i class="fa-solid fa-door-open hub-kpi__icon" aria-hidden="true"></i><span class="hub-kpi__value"><%= _num(totalClasses) %></span><span class="hub-kpi__label">Classes</span></a>
      </div>

      <% if (_requests.length || _invites.length) { %>
        <div class="hub-card">
          <h2 class="hub-card__title">Needs your attention</h2>
          <div class="hub-alerts">
            <% if (_requests.length) { %><a class="hub-alert" href="#requests"><i class="fa-solid fa-triangle-exclamation" aria-hidden="true"></i><span><strong><%= _requests.length %></strong> detachment request<%= _requests.length === 1 ? '' : 's' %> waiting for your decision</span><i class="fa-solid fa-chevron-right" aria-hidden="true"></i></a><% } %>
            <% if (_invites.length) { %><a class="hub-alert hub-alert--info" href="#invitations"><i class="fa-solid fa-envelope" aria-hidden="true"></i><span><strong><%= _invites.length %></strong> invitation<%= _invites.length === 1 ? '' : 's' %> not accepted yet</span><i class="fa-solid fa-chevron-right" aria-hidden="true"></i></a><% } %>
          </div>
        </div>
      <% } %>

      <div class="hub-card">
        <h2 class="hub-card__title">Report highlights <small data-report-stamp></small></h2>
        <div class="hub-kpis" data-highlights><div class="hub-loading">Loading reports…</div></div>
      </div>

      <div class="hub-card">
        <h2 class="hub-card__title">Recent activity</h2>
        <% if (!_activity.length) { %>
          <div class="hub-empty"><i class="fa-regular fa-clock" aria-hidden="true"></i>No activity yet.</div>
        <% } else { %>
          <ul class="hub-activity">
            <% _activity.forEach((a) => { %>
              <li><span class="hub-activity__dot" aria-hidden="true"></span><span><%= a.description || a.action_type %></span><span class="hub-activity__when"><%= _date(a.created_at) %></span></li>
            <% }) %>
          </ul>
        <% } %>
      </div>
    </section>

    <!-- Reports (filled from /hub/overview-stats by public/js/hubDashboard.js) -->
    <% [
         ['school-comparison', 'School comparison', 'Size and load of every school in your hub, side by side.'],
         ['attendance', 'Attendance', 'Share of attendance records marked present, by school.'],
         ['performance', 'Academic performance', 'Average assessment scores and pass rates, by school.'],
         ['enrollment', 'Enrollment & staffing', 'Active students, staff and classes across your schools.'],
       ].forEach(([key, title, sub]) => { %>
      <section class="hub-view" data-view="<%= key %>" aria-label="<%= title %>">
        <header class="hub-head">
          <div>
            <h1 class="hub-title"><%= title %></h1>
            <p class="hub-sub"><%= sub %></p>
          </div>
          <div class="hub-actions">
            <button type="button" class="hub-btn hub-btn--ghost" data-report-refresh><i class="fa-solid fa-rotate" aria-hidden="true"></i> Refresh</button>
            <button type="button" class="hub-btn hub-btn--ghost" onclick="window.print()"><i class="fa-solid fa-print" aria-hidden="true"></i> Print</button>
          </div>
        </header>
        <div data-report="<%= key %>"><div class="hub-card hub-loading">Loading report…</div></div>
      </section>
    <% }) %>

    <!-- Schools -->
    <section class="hub-view" data-view="schools" aria-label="Schools">
      <header class="hub-head">
        <div>
          <h1 class="hub-title">Schools</h1>
          <p class="hub-sub"><%= _capacity %> places used. Open a school to see its students, staff and classes.</p>
        </div>
        <div class="hub-actions">
          <a class="hub-btn hub-btn--primary" href="/hub/organizations/invite"><i class="fa-solid fa-plus" aria-hidden="true"></i> Invite a school</a>
        </div>
      </header>
      <div class="hub-card">
        <% if (!_orgs.length) { %>
          <div class="hub-empty"><i class="fa-solid fa-school" aria-hidden="true"></i>No schools in your hub yet.<br /><br /><a class="hub-btn hub-btn--primary" href="/hub/organizations/invite">Invite your first school</a></div>
        <% } else { %>
          <div class="hub-table-wrap">
            <table class="hub-table">
              <thead>
                <tr><th>School</th><th>Contact</th><th class="num">Students</th><th class="num">Staff</th><th class="num">Classes</th><th>Status</th><th>Joined</th><th></th></tr>
              </thead>
              <tbody>
                <% _orgs.forEach((org) => { %>
                  <tr class="<%= org.on_hold ? 'is-held' : '' %>">
                    <td>
                      <a class="hub-school" href="/hub/organizations/<%= org.organization_id %>?tab=students"><%= org.organization_name %></a>
                      <% if (org.nickname) { %><span class="hub-small"><%= org.nickname %>.<%= _hub.hub_nickname %>.managira.com</span><% } %>
                    </td>
                    <td><%= [org.first_name, org.last_name].filter(Boolean).join(' ') || '—' %><span class="hub-small"><%= org.organization_email || '' %></span></td>
                    <td class="num"><%= _num(org.student_count) %></td>
                    <td class="num"><%= _num(org.teacher_count) %></td>
                    <td class="num"><%= _num(org.class_count) %></td>
                    <td><span class="hub-status<%= org.on_hold ? ' hub-status--hold' : '' %>"><%= org.on_hold ? 'On hold' : 'Active' %></span></td>
                    <td><%= _date(org.joined_hub_at) %></td>
                    <td>
                      <div class="hub-row-actions">
                        <a class="hub-btn hub-btn--ghost hub-btn--sm" href="/hub/organizations/<%= org.organization_id %>?tab=students">View</a>
                        <details class="hub-menu">
                          <summary class="hub-btn hub-btn--ghost hub-btn--sm" aria-label="More actions for <%= org.organization_name %>"><i class="fa-solid fa-ellipsis" aria-hidden="true"></i></summary>
                          <div class="hub-menu__list">
                            <a class="hub-menu__item" href="/hub/organizations/edit/<%= org.organization_id %>"><i class="fa-solid fa-pen" aria-hidden="true"></i> Edit details</a>
                            <button type="button" class="hub-menu__item" data-org-action="<%= org.on_hold ? 'resume' : 'hold' %>" data-org-id="<%= org.organization_id %>" data-org-name="<%= org.organization_name %>"><i class="fa-solid <%= org.on_hold ? 'fa-play' : 'fa-pause' %>" aria-hidden="true"></i> <%= org.on_hold ? 'Resume' : 'Put on hold' %></button>
                            <div class="hub-menu__sep"></div>
                            <button type="button" class="hub-menu__item hub-menu__item--danger" data-org-action="remove" data-org-id="<%= org.organization_id %>" data-org-name="<%= org.organization_name %>"><i class="fa-solid fa-link-slash" aria-hidden="true"></i> Remove from hub</button>
                            <button type="button" class="hub-menu__item hub-menu__item--danger" data-org-action="delete" data-org-id="<%= org.organization_id %>" data-org-name="<%= org.organization_name %>"><i class="fa-solid fa-trash" aria-hidden="true"></i> Delete permanently</button>
                          </div>
                        </details>
                      </div>
                    </td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        <% } %>
      </div>
    </section>

    <!-- Invitations -->
    <section class="hub-view" data-view="invitations" aria-label="Invitations">
      <header class="hub-head">
        <div>
          <h1 class="hub-title">Invitations</h1>
          <p class="hub-sub">Schools you have invited that haven't joined yet.</p>
        </div>
        <div class="hub-actions"><a class="hub-btn hub-btn--primary" href="/hub/organizations/invite"><i class="fa-solid fa-plus" aria-hidden="true"></i> Invite a school</a></div>
      </header>
      <% if (!_invites.length) { %>
        <div class="hub-card hub-empty"><i class="fa-solid fa-envelope-open" aria-hidden="true"></i>No pending invitations.</div>
      <% } else { %>
        <div class="hub-items">
          <% _invites.forEach((inv) => { %>
            <div class="hub-item">
              <div>
                <h3 class="hub-item__title"><%= inv.organization_name %> <span class="hub-tag <%= inv.existing_org_id ? 'hub-tag--blue' : 'hub-tag--violet' %>"><%= inv.existing_org_id ? 'Existing school' : 'New school' %></span></h3>
                <p class="hub-item__meta"><%= inv.contact_person_name %> · <%= inv.contact_person_email %><br />Sent <%= _date(inv.created_at) %> · Expires <%= _date(inv.expires_at) %></p>
              </div>
              <div class="hub-actions">
                <form action="/hub/organizations/resend-invite" method="POST">
                  <input type="hidden" name="invitationId" value="<%= inv.invitation_id %>" />
                  <button type="submit" class="hub-btn hub-btn--ghost hub-btn--sm"><i class="fa-solid fa-paper-plane" aria-hidden="true"></i> Resend</button>
                </form>
                <form action="/hub/organizations/cancel-invitation" method="POST" data-confirm="Cancel the invitation to <%= inv.organization_name %>?">
                  <input type="hidden" name="invitationId" value="<%= inv.invitation_id %>" />
                  <button type="submit" class="hub-btn hub-btn--danger hub-btn--sm">Cancel</button>
                </form>
              </div>
            </div>
          <% }) %>
        </div>
      <% } %>
    </section>

    <!-- Detachment requests -->
    <section class="hub-view" data-view="requests" aria-label="Detachment requests">
      <header class="hub-head">
        <div>
          <h1 class="hub-title">Detachment requests</h1>
          <p class="hub-sub">Schools asking to leave your hub. Approving makes them independent with their own subscription.</p>
        </div>
      </header>
      <% if (!_requests.length) { %>
        <div class="hub-card hub-empty"><i class="fa-solid fa-circle-check" aria-hidden="true"></i>No requests waiting.</div>
      <% } else { %>
        <div class="hub-items">
          <% _requests.forEach((r) => { %>
            <div class="hub-item hub-item--warn">
              <div style="flex: 1; min-width: 260px;">
                <h3 class="hub-item__title"><%= r.organization_name %></h3>
                <p class="hub-item__meta">Requested by <%= r.requested_by %> · <%= _date(r.requested_at) %></p>
                <% if (r.reason) { %><p class="hub-item__quote"><%= r.reason %></p><% } %>
              </div>
              <div class="hub-actions">
                <form action="/hub/detachment-requests/approve" method="POST" data-confirm="Approve the request from <%= r.organization_name %>? They will become independent and need their own subscription. This can't be undone.">
                  <input type="hidden" name="requestId" value="<%= r.request_id %>" />
                  <button type="submit" class="hub-btn hub-btn--success hub-btn--sm"><i class="fa-solid fa-check" aria-hidden="true"></i> Approve</button>
                </form>
                <button type="button" class="hub-btn hub-btn--danger hub-btn--sm" data-reject-id="<%= r.request_id %>" data-reject-name="<%= r.organization_name %>"><i class="fa-solid fa-xmark" aria-hidden="true"></i> Reject</button>
              </div>
            </div>
          <% }) %>
        </div>
      <% } %>
    </section>
  </div>

  <dialog class="hub-dialog" data-reject-dialog>
    <form action="/hub/detachment-requests/reject" method="POST">
      <div class="hub-dialog__body">
        <h2>Reject detachment request</h2>
        <p>You are rejecting the request from <strong data-reject-name-label></strong>. Your note is sent to the school.</p>
        <input type="hidden" name="requestId" data-reject-id-input />
        <label class="hub-small" for="hubRejectNotes" style="margin-bottom: 6px;">Reason (optional)</label>
        <textarea id="hubRejectNotes" name="notes" placeholder="Let the school know why"></textarea>
      </div>
      <div class="hub-dialog__actions">
        <button type="button" class="hub-btn hub-btn--ghost" data-reject-cancel>Cancel</button>
        <button type="submit" class="hub-btn hub-btn--danger" style="background:#b91c1c;color:#fff;border-color:#b91c1c;">Reject request</button>
      </div>
    </form>
  </dialog>
</div>

<script src="<%= assetUrl('/js/hubDashboard.js') %>"></script>
