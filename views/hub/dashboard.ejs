<link rel="stylesheet" href="/css/style.css">
<style>
  :root {
    --primary: #01535b;
    --primary-hover: #014a51;
        --primary-hover-fill: color-mix(in srgb, var(--primary) 88%, white);
    --text-primary: #111827;
    --text-secondary: #6b7280;
    --border: #e5e7eb;
    --bg: #f9fafb;
  }

  body { background: var(--bg); font-family: "Inter", -apple-system, sans-serif; }

  .hub-container { max-width: 1200px; margin: 0 auto; padding: 120px 60px 60px 60px; }

  .hub-header {
    background: var(--primary);
    color: white;
    padding: 28px 32px;
    border-radius: 12px;
    margin-bottom: 24px;
  }

  .hub-header h1 { font-size: 1.5rem; margin-bottom: 4px; font-weight: 700; }
  .hub-header p { opacity: 0.85; font-size: 0.9rem; }

  .hub-nav { display: flex; gap: 8px; margin-bottom: 24px; flex-wrap: wrap; }

  .hub-nav a {
    padding: 8px 18px;
    background: white;
    border: 1px solid var(--border);
    border-radius: 8px;
    text-decoration: none;
    color: var(--text-primary);
    font-weight: 600;
    font-size: 0.9rem;
    transition: all 0.15s;
  }

  .hub-nav a:hover, .hub-nav a.active {
    background: var(--primary);
    color: white;
    border-color: var(--primary);
  }

  .section-card {
    background: white;
    border-radius: 10px;
    border: 1px solid var(--border);
    margin-bottom: 20px;
    overflow: hidden;
  }

  .section-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 16px 20px;
    border-bottom: 1px solid var(--border);
  }

  .section-header h2 { font-size: 1.1rem; color: var(--text-primary); margin: 0; }

  .table-container { overflow-x: auto; }

  table { width: 100%; border-collapse: collapse; }

  th, td { padding: 12px 20px; text-align: left; font-size: 0.9rem; }

  th {
    background: var(--bg);
    font-weight: 600;
    color: #475569;
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.3px;
  }

  td { border-top: 1px solid var(--border); color: var(--text-primary); }
  tr:hover td { background: var(--bg); }

  .badge {
    display: inline-block;
    padding: 2px 10px;
    border-radius: 12px;
    font-size: 0.78rem;
    font-weight: 600;
    background: #ecfdf5;
    color: #065f46;
  }

  .badge-link {
    text-decoration: none;
    display: inline-block;
  }

  .org-name-link {
    color: var(--text-primary);
    text-decoration: none;
  }

  .org-name-link:hover {
    color: var(--primary);
    text-decoration: underline;
  }

  .badge-link .badge {
    transition: all 0.2s ease;
  }

  .badge-link:hover .badge {
    transform: translateY(-1px);
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.12);
  }

  .btn {
    display: inline-block;
    padding: 10px 20px;
    border-radius: 8px;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.2s;
    border: none;
    cursor: pointer;
    font-size: 0.9rem;
    font-family: inherit;
  }

  .btn-primary { background: var(--primary); color: white; }
  .btn-primary:hover { background: var(--primary-hover-fill, var(--primary-hover)); }

  .btn-sm { padding: 6px 14px; font-size: 0.85rem; }
  .btn-danger { background: #dc2626; color: white; }
  .btn-danger:hover { background: #b91c1c; }
  .btn-secondary { background: #6b7280; color: white; }
  .btn-secondary:hover { background: #4b5563; }
  .btn-warning { background: #f59e0b; color: white; }
  .btn-warning:hover { background: #d97706; }
  .btn-success { background: #10b981; color: white; }
  .btn-success:hover { background: #059669; }

  .action-select {
    padding: 6px 12px;
    border: 2px solid var(--border);
    border-radius: 6px;
    font-size: 0.85rem;
    font-weight: 600;
    background: white;
    color: var(--text-primary);
    cursor: pointer;
    transition: all 0.15s;
  }

  .action-select:hover {
    border-color: var(--primary);
  }

  .action-select:focus {
    outline: none;
    border-color: var(--primary);
    box-shadow: 0 0 0 3px rgba(1, 83, 91, 0.1);
  }
  .action-buttons { display: flex; gap: 6px; }

  .no-data { padding: 48px 20px; text-align: center; color: #94a3b8; }

  .invitation-item {
    padding: 16px 20px;
    border-bottom: 1px solid var(--border);
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
  }

  .invitation-item:last-child { border-bottom: none; }

  .invitation-info h4 { margin: 0 0 4px 0; color: var(--text-primary); font-size: 0.95rem; }
  .invitation-info p { margin: 2px 0; color: var(--text-secondary); font-size: 0.82rem; }

  .invitation-status {
    display: inline-block;
    padding: 2px 10px;
    border-radius: 12px;
    font-size: 0.75rem;
    font-weight: 600;
    background: #fef3c7;
    color: #92400e;
  }

  .overview-metrics {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(190px, 1fr));
    gap: 12px;
    padding: 16px 20px;
    border-bottom: 1px solid var(--border);
  }

  .overview-metric-card {
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 12px;
    background: var(--bg);
  }

  .overview-metric-title {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.4px;
    color: var(--text-secondary);
    margin-bottom: 6px;
    font-weight: 600;
  }

  .overview-metric-value {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--primary);
  }

  .overview-metric-sub {
    font-size: 0.78rem;
    color: var(--text-secondary);
    margin-top: 3px;
  }

  .overview-section-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
    padding: 0 20px 20px 20px;
  }

  .overview-box {
    border: 1px solid var(--border);
    border-radius: 8px;
    overflow: hidden;
  }

  .overview-box h3 {
    margin: 0;
    padding: 12px;
    font-size: 0.9rem;
    border-bottom: 1px solid var(--border);
    background: var(--bg);
    color: var(--text-primary);
  }

  .rank-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .rank-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 8px;
    padding: 10px 12px;
    border-top: 1px solid var(--border);
  }

  .rank-item:first-child { border-top: none; }

  .rank-item-name {
    font-size: 0.85rem;
    color: var(--text-primary);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .rank-item-value {
    font-size: 0.82rem;
    color: var(--text-secondary);
    font-weight: 600;
  }

  .overview-loading,
  .overview-error {
    padding: 18px 20px;
    border-top: 1px solid var(--border);
    color: var(--text-secondary);
    font-size: 0.9rem;
  }

  .overview-error {
    color: #b91c1c;
  }

  .overview-meta-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
    padding: 0 20px 20px 20px;
  }

  .overview-meta-item {
    border: 1px solid var(--border);
    border-radius: 8px;
    background: var(--bg);
    padding: 12px;
  }

  .overview-meta-item h4 {
    margin: 0 0 8px 0;
    font-size: 0.85rem;
    color: var(--text-primary);
  }

  .overview-meta-item p {
    margin: 0;
    font-size: 0.82rem;
    color: var(--text-secondary);
  }

  @media (max-width: 768px) {
    .table-container { overflow-x: scroll; }
    table { min-width: 700px; }
    .action-buttons { flex-direction: column; }
    .section-header { flex-direction: column; gap: 10px; align-items: flex-start; }
    .invitation-item { flex-direction: column; align-items: flex-start; }
    .overview-section-grid { grid-template-columns: 1fr; }
    .overview-meta-grid { grid-template-columns: 1fr; }
  }

  @media (max-width: 480px) {
    .hub-container { padding: 16px 12px; }
  }
</style>

<div class="hub-container">
    <%- include('../partials/flash') %>

    <div class="section-card" id="hubOverviewCard">
      <div class="section-header">
        <h2>Hub Overview</h2>
        <div class="action-buttons">
          <button type="button" class="btn btn-secondary btn-sm" id="loadHubOverviewBtn" onclick="toggleHubOverview()">Load Overview</button>
          <button type="button" class="btn btn-primary btn-sm" id="refreshHubOverviewBtn" onclick="loadHubOverview(true)" style="display: none;">Refresh</button>
        </div>
      </div>
      <div id="hubOverviewContent" style="display: none;"></div>
    </div>

    <% if (pendingInvitations && pendingInvitations.length > 0) { %>
    <div class="section-card">
      <div class="section-header">
        <h2>Pending Invitations (<%= pendingInvitations.length %>)</h2>
      </div>
      <% pendingInvitations.forEach(invitation => { %>
        <div class="invitation-item">
          <div class="invitation-info">
            <h4><%= invitation.organization_name %>
              <% if (invitation.existing_org_id) { %>
                <span style="display: inline-block; margin-left: 8px; padding: 4px 10px; background: #e3f2fd; color: #1976d2; border-radius: 4px; font-size: 0.75rem; font-weight: 600;">🏢 Existing Org</span>
              <% } else { %>
                <span style="display: inline-block; margin-left: 8px; padding: 4px 10px; background: #f3e5f5; color: #7b1fa2; border-radius: 4px; font-size: 0.75rem; font-weight: 600;">✨ New Org</span>
              <% } %>
            </h4>
            <p><%= invitation.contact_person_name %> &middot; <%= invitation.contact_person_email %></p>
            <p>Sent: <%= new Date(invitation.created_at).toLocaleDateString() %> &middot; Expires: <%= new Date(invitation.expires_at).toLocaleDateString() %></p>
            <span class="invitation-status">Pending</span>
          </div>
          <div class="action-buttons">
            <form action="/hub/organizations/resend-invite" method="POST" style="display:inline;">
              <input type="hidden" name="invitationId" value="<%= invitation.invitation_id %>">
              <button type="submit" class="btn btn-secondary btn-sm">Resend</button>
            </form>
            <form action="/hub/organizations/cancel-invitation" method="POST" style="display:inline;">
              <input type="hidden" name="invitationId" value="<%= invitation.invitation_id %>">
              <button type="submit" class="btn btn-danger btn-sm" onclick="return confirm('Cancel this invitation?')">Cancel</button>
            </form>
          </div>
        </div>
      <% }); %>
    </div>
    <% } %>

    <% if (detachmentRequests && detachmentRequests.length > 0) { %>
    <div class="section-card">
      <div class="section-header">
        <h2>⚠️ Detachment Requests (<%= detachmentRequests.length %>)</h2>
      </div>
      <% detachmentRequests.forEach(request => { %>
        <div class="invitation-item" style="background: #fff3cd; border-left: 4px solid #ffc107;">
          <div class="invitation-info">
            <h4><%= request.organization_name %></h4>
            <p><strong>Requested by:</strong> <%= request.requested_by %></p>
            <p><strong>Date:</strong> <%= new Date(request.requested_at).toLocaleDateString() %> at <%= new Date(request.requested_at).toLocaleTimeString() %></p>
            <p><strong>Reason:</strong></p>
            <p style="padding: 10px; background: white; border-radius: 4px; margin-top: 8px;"><%= request.reason %></p>
          </div>
          <div class="action-buttons">
            <form action="/hub/detachment-requests/approve" method="POST" style="display:inline;" onsubmit="return confirm('⚠️ Are you sure you want to approve this detachment?\n\n<%= request.organization_name %> will become independent and will need their own subscription. This action cannot be undone.');">
              <input type="hidden" name="requestId" value="<%= request.request_id %>">
              <button type="submit" class="btn btn-success" style="background: #28a745;">✓ Approve</button>
            </form>
            <button type="button" class="btn btn-danger" onclick="showRejectModal(<%= request.request_id %>, '<%= request.organization_name %>')">✗ Reject</button>
          </div>
        </div>
      <% }); %>
    </div>
    <% } %>

    <div class="section-card">
      <div class="section-header">
        <h2>Organizations (<%= orgCount %> / <%= hub.max_organizations %>)</h2>
        <a href="/hub/organizations/invite" class="btn btn-primary">+ Invite Organization</a>
      </div>
      <div class="table-container">
        <% if (organizations.length > 0) { %>
          <table>
            <thead>
              <tr>
                <th>Organization</th>
                <th>Contact</th>
                <th>Email</th>
                <th>Students</th>
                <th>Staff</th>
                <th>Classes</th>
                <th>Status</th>
                <th>Joined</th>
                <th>Actions</th>
              </tr>
            </thead>
            <tbody>
              <% organizations.forEach(org => { %>
                <tr style="<%= org.on_hold ? 'opacity: 0.6;' : '' %>">
                  <td>
                    <a class="org-name-link" href="/hub/organizations/<%= org.organization_id %>?tab=students" title="View <%= org.organization_name %> details">
                      <strong><%= org.organization_name %></strong>
                    </a><br>
                    <small style="color: var(--text-secondary);"><%= org.nickname %>.<%= hub.hub_nickname %>.managira.com</small>
                  </td>
                  <td><%= org.first_name %> <%= org.last_name %></td>
                  <td><%= org.organization_email %></td>
                  <td><span class="badge"><%= org.student_count %></span></td>
                  <td><span class="badge"><%= org.teacher_count %></span></td>
                  <td><span class="badge"><%= org.class_count %></span></td>
                  <td>
                    <% if (org.on_hold) { %>
                      <span class="badge" style="background: #fee; color: #c00;">On Hold</span>
                    <% } else { %>
                      <span class="badge" style="background: #efe; color: #0a0;">Active</span>
                    <% } %>
                  </td>
                  <td><%= org.joined_hub_at ? new Date(org.joined_hub_at).toLocaleDateString() : 'N/A' %></td>
                  <td>
                    <select class="action-select" onchange="handleOrgAction(this, '<%= org.organization_id %>', '<%= org.organization_name %>', <%= org.on_hold %>)">
                      <option value="">⚙️ Select Action...</option>
                      <option value="edit">✏️ Edit Details</option>
                      <option value="<%= org.on_hold ? 'resume' : 'hold' %>"><%= org.on_hold ? '▶️ Resume' : '⏸️ Put on Hold' %></option>
                      <option value="remove">🔗 Remove from Hub</option>
                      <option value="delete">🗑️ Delete Permanently</option>
                    </select>
                  </td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        <% } else { %>
          <div class="no-data">
            <p>No organizations yet.</p>
            <p style="margin-top: 8px;">
              <a href="/hub/organizations/invite" class="btn btn-primary">Invite Your First Organization</a>
            </p>
          </div>
        <% } %>
      </div>
    </div>
  </div>

<script>
  let hubOverviewLoaded = false;
  let hubOverviewOpen = false;

  function escapeHtml(value) {
    return String(value)
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#39;');
  }

  function formatNumber(value) {
    return Number(value || 0).toLocaleString();
  }

  function formatOneDecimal(value) {
    return Number(value || 0).toLocaleString(undefined, {
      minimumFractionDigits: 0,
      maximumFractionDigits: 1
    });
  }

  function buildTopList(items, key) {
    if (!items || items.length === 0) {
      return '<div class="no-data" style="padding: 20px;">No organization data available.</div>';
    }

    const rows = items.map((org) => `
      <li class="rank-item">
        <span class="rank-item-name" title="${escapeHtml(org.organizationName)}">${escapeHtml(org.organizationName)}</span>
        <span class="rank-item-value">${formatNumber(org[key])}</span>
      </li>
    `).join('');

    return `<ul class="rank-list">${rows}</ul>`;
  }

  function renderHubOverview(data) {
    const container = document.getElementById('hubOverviewContent');
    const refreshBtn = document.getElementById('refreshHubOverviewBtn');
    const highlights = data.highlights || {};
    const totals = data.totals || {};
    const enrollmentStaffing = data.enrollmentStaffing || {};
    const attendanceByOrganization = data.attendanceByOrganization || [];
    const topPerformingOrganizations = data.topPerformingOrganizations || [];
    const organizationLoadComparison = data.organizationLoadComparison || [];

    const buildOrganizationList = (items, valueKey, suffix = '') => {
      if (!items.length) {
        return '<div class="no-data" style="padding: 20px;">No data available yet.</div>';
      }

      return `<ul class="rank-list">${items.map((item) => `
        <li class="rank-item">
          <span class="rank-item-name" title="${escapeHtml(item.organizationName)}">${escapeHtml(item.organizationName)}</span>
          <span class="rank-item-value">${formatOneDecimal(item[valueKey])}${suffix}</span>
        </li>
      `).join('')}</ul>`;
    };

    const buildSchoolLoadList = (items) => {
      if (!items.length) {
        return '<div class="no-data" style="padding: 20px;">No data available yet.</div>';
      }

      return `<ul class="rank-list">${items.map((item) => `
        <li class="rank-item">
          <span class="rank-item-name" title="${escapeHtml(item.organizationName)}">
            ${escapeHtml(item.organizationName)}
            <small style="color:#94a3b8;">(${formatNumber(item.studentCount)} students • ${formatNumber(item.staffCount)} staff • ${formatNumber(item.classCount)} classes)</small>
          </span>
          <span class="rank-item-value">${formatOneDecimal(item.studentsPerClass)} / class</span>
        </li>
      `).join('')}</ul>`;
    };

    container.innerHTML = `
      <div class="overview-metrics">
        <div class="overview-metric-card">
          <div class="overview-metric-title">Attendance by Schools</div>
          <div class="overview-metric-value">${formatOneDecimal(highlights.attendanceRate)}%</div>
          <div class="overview-metric-sub">${formatNumber(totals.presentDays)} present out of ${formatNumber(totals.totalAttendanceRecords)} records</div>
        </div>
        <div class="overview-metric-card">
          <div class="overview-metric-title">Assessment Performance</div>
          <div class="overview-metric-value">${formatOneDecimal(highlights.averageAssessmentScore)}%</div>
          <div class="overview-metric-sub">${formatOneDecimal(highlights.passRate)}% pass rate from ${formatNumber(totals.totalAssessmentResults)} results</div>
        </div>
        <div class="overview-metric-card">
          <div class="overview-metric-title">Students per Class (Hub Avg)</div>
          <div class="overview-metric-value">${formatOneDecimal(highlights.studentsPerClass)}</div>
          <div class="overview-metric-sub">Average class load across all schools</div>
        </div>
        <div class="overview-metric-card">
          <div class="overview-metric-title">Enrollment & Staffing</div>
          <div class="overview-metric-value">${formatOneDecimal(highlights.studentsPerStaff)}</div>
          <div class="overview-metric-sub">Students per staff member</div>
        </div>
      </div>

      <div class="overview-meta-grid">
        <div class="overview-meta-item">
          <h4>School Structure Snapshot</h4>
          <p>${formatNumber(enrollmentStaffing.organizationCount)} schools • ${formatNumber(enrollmentStaffing.activeOrganizations)} active • ${formatNumber(enrollmentStaffing.onHoldOrganizations)} on hold</p>
        </div>
        <div class="overview-meta-item">
          <h4>Enrollment & Staffing</h4>
          <p>${formatNumber(enrollmentStaffing.totalStudents)} students • ${formatNumber(enrollmentStaffing.totalStaff)} staff • ${formatNumber(enrollmentStaffing.totalClasses)} classes</p>
        </div>
      </div>

      <div class="overview-section-grid">
        <div class="overview-box">
          <h3>🏆 Top Performing Schools</h3>
          ${buildOrganizationList(topPerformingOrganizations, 'averageScore', '%')}
        </div>
        <div class="overview-box">
          <h3>📊 Attendance by Schools</h3>
          ${buildOrganizationList(attendanceByOrganization, 'presentRate', '%')}
        </div>
      </div>

      <div class="overview-section-grid">
        <div class="overview-box">
          <h3>🏫 School Load Comparison</h3>
          ${buildSchoolLoadList(organizationLoadComparison)}
        </div>
      </div>
    `;

    refreshBtn.style.display = 'inline-block';
  }

  async function loadHubOverview(forceRefresh = false) {
    const content = document.getElementById('hubOverviewContent');
    const button = document.getElementById('loadHubOverviewBtn');

    if (!forceRefresh && hubOverviewLoaded) {
      content.style.display = 'block';
      hubOverviewOpen = true;
      button.textContent = 'Hide Overview';
      return;
    }

    content.style.display = 'block';
    content.innerHTML = '<div class="overview-loading">Loading comparative hub statistics...</div>';
    button.disabled = true;

    try {
      const response = await fetch('/hub/overview-stats', {
        headers: { 'Accept': 'application/json' }
      });

      if (!response.ok) {
        throw new Error('Failed to fetch overview statistics');
      }

      const data = await response.json();
      renderHubOverview(data);
      hubOverviewLoaded = true;
      hubOverviewOpen = true;
      button.textContent = 'Hide Overview';
    } catch (error) {
      content.innerHTML = '<div class="overview-error">Unable to load Hub Overview right now. Please try again.</div>';
    } finally {
      button.disabled = false;
    }
  }

  function toggleHubOverview() {
    const content = document.getElementById('hubOverviewContent');
    const button = document.getElementById('loadHubOverviewBtn');

    if (!hubOverviewOpen) {
      loadHubOverview(false);
      return;
    }

    content.style.display = 'none';
    hubOverviewOpen = false;
    button.textContent = 'Load Overview';
  }

  function handleOrgAction(selectElement, orgId, orgName, isOnHold) {
    const action = selectElement.value;
    
    if (!action) {
      return;
    }

    // Reset select to default after selection
    selectElement.value = '';

    switch(action) {
      case 'edit':
        window.location.href = `/hub/organizations/edit/${orgId}`;
        break;

      case 'hold':
        if (confirm(`Put "${orgName}" on hold? They won't be able to access their account until resumed.`)) {
          submitForm('/hub/organizations/toggle-hold', { organizationId: orgId });
        }
        break;

      case 'resume':
        if (confirm(`Resume "${orgName}"? They will regain full access to their account.`)) {
          submitForm('/hub/organizations/toggle-hold', { organizationId: orgId });
        }
        break;

      case 'remove':
        if (confirm(`Remove "${orgName}" from your hub?\n\n⚠️ They will become an independent organization and need to set up their own subscription.\n\nTheir data will remain intact.`)) {
          submitForm('/hub/organizations/remove', { organizationId: orgId });
        }
        break;

      case 'delete':
        if (confirm(`⚠️ PERMANENTLY DELETE "${orgName}"?\n\n🚨 THIS CANNOT BE UNDONE!\n\nAll their data including students, staff, and classes will be permanently deleted.\n\nType "DELETE" in the next prompt to confirm.`)) {
          const confirmation = prompt('Type "DELETE" to confirm permanent deletion:');
          if (confirmation === 'DELETE') {
            submitForm('/hub/organizations/delete', { organizationId: orgId });
          } else {
            alert('Deletion cancelled. The organization was not deleted.');
          }
        }
        break;
    }
  }

  function submitForm(action, data) {
    const form = document.createElement('form');
    form.method = 'POST';
    form.action = action;

    for (const key in data) {
      const input = document.createElement('input');
      input.type = 'hidden';
      input.name = key;
      input.value = data[key];
      form.appendChild(input);
    }

    document.body.appendChild(form);
    form.submit();
  }

  // Reject detachment request modal
  function showRejectModal(requestId, orgName) {
    const modal = document.getElementById('rejectModal');
    document.getElementById('rejectOrgName').textContent = orgName;
    document.getElementById('rejectRequestId').value = requestId;
    document.getElementById('rejectNotes').value = '';
    modal.style.display = 'block';
  }

  function closeRejectModal() {
    document.getElementById('rejectModal').style.display = 'none';
  }

  // Close modal when clicking outside
  window.onclick = function(event) {
    const modal = document.getElementById('rejectModal');
    if (event.target === modal) {
      closeRejectModal();
    }
  };
</script>

<!-- Reject Modal -->
<div id="rejectModal" style="display: none; position: fixed; z-index: 1000; left: 0; top: 0; width: 100%; height: 100%; overflow: auto; background-color: rgba(0,0,0,0.4);">
  <div style="background-color: #fefefe; margin: 10% auto; padding: 0; border-radius: 8px; box-shadow: 0 4px 20px rgba(0,0,0,0.2); width: 90%; max-width: 500px;">
    <div style="background: linear-gradient(135deg, #dc3545 0%, #c82333 100%); color: white; padding: 20px; border-radius: 8px 8px 0 0;">
      <h2 style="margin: 0; font-size: 20px;">✗ Reject Detachment Request</h2>
    </div>
    <form action="/hub/detachment-requests/reject" method="POST">
      <div style="padding: 30px;">
        <p>You are rejecting the detachment request from <strong id="rejectOrgName"></strong>.</p>
        <input type="hidden" name="requestId" id="rejectRequestId">
        <div style="margin-bottom: 20px;">
          <label style="display: block; margin-bottom: 8px; font-weight: 600;">Reason for Rejection (Optional):</label>
          <textarea 
            name="notes" 
            id="rejectNotes" 
            rows="4" 
            style="width: 100%; padding: 10px; border: 1px solid #ddd; border-radius: 4px; font-family: inherit; resize: vertical;"
            placeholder="Provide feedback to the organization about why their request was rejected..."
          ></textarea>
          <small style="color: #666; display: block; margin-top: 4px;">This message will be sent to the organization.</small>
        </div>
        <div style="display: flex; gap: 10px; justify-content: flex-end;">
          <button type="button" onclick="closeRejectModal()" style="padding: 10px 20px; border: 1px solid #ddd; background: white; border-radius: 4px; cursor: pointer; font-weight: 500;">Cancel</button>
          <button type="submit" style="padding: 10px 20px; border: none; background: #dc3545; color: white; border-radius: 4px; cursor: pointer; font-weight: 500;">Reject Request</button>
        </div>
      </div>
    </form>
  </div>
</div>
