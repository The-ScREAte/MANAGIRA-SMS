<%
  const _orgs = Array.isArray(typeof organizations !== 'undefined' ? organizations : null) ? organizations : [];
  const _invites = Array.isArray(typeof pendingInvitations !== 'undefined' ? pendingInvitations : null) ? pendingInvitations : [];
  const _requests = Array.isArray(typeof detachmentRequests !== 'undefined' ? detachmentRequests : null) ? detachmentRequests : [];
  const _activity = Array.isArray(typeof recentActivity !== 'undefined' ? recentActivity : null) ? recentActivity : [];
  const _hub = hub || {};
  const _date = (d) => d ? new Date(d).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) : '—';
  const _num = (n) => Number(n || 0).toLocaleString('en-US');
  const _onHold = _orgs.filter((o) => o.on_hold).length;
  const _max = Number(_hub.max_organizations) || 0;
  const _capacity = _max ? `${orgCount} of ${_max}` : String(orgCount);
  const _capPct = _max ? Math.min(100, Math.round((orgCount / _max) * 100)) : null;
  const _activityIcon = (type) => ({ INVITE: 'fa-paper-plane', LOGIN: 'fa-right-to-bracket', LOGOUT: 'fa-right-from-bracket', REMOVE: 'fa-link-slash', HOLD: 'fa-pause', RESUME: 'fa-play', DELETE: 'fa-trash', JOIN: 'fa-handshake' }[String(type || '').toUpperCase()] || 'fa-circle');
  const _greet = (() => { const h = new Date().getHours(); return h < 12 ? 'Good morning' : h < 18 ? 'Good afternoon' : 'Good evening'; })();
  const _can = (p) => (typeof hubCan === 'function' ? hubCan(p) : true);
  const _href = (perm, href) => (_can(perm) ? `href="${href}"` : '');
  const _firstName = (session && session.firstName) || _hub.first_name || '';
%>
<link rel="stylesheet" href="<%= assetUrl('/css/hub.css') %>" />

<div class="hub-shell">
  <%- include('partials/sidebar', { hubCurrent: 'overview' }) %>

  <div class="hub-main" data-refreshable data-hub-dashboard data-can-reports="<%= _can('reports.view') ? '1' : '' %>">
    <%- include('../partials/flash') %>

    <!-- Overview -->
    <section class="hub-view" data-view="overview" aria-label="Overview">
      <header class="hub-hero">
        <div>
          <h1 class="hub-hero__title"><%= _greet %><%= _firstName ? `, ${_firstName}` : '' %></h1>
          <p class="hub-hero__sub"><%= _hub.hub_name || 'Your hub' %> · <%= orgCount === 1 ? '1 school' : `${orgCount} schools` %></p>
        </div>
        <% if (_can('invitations.manage')) { %><div class="hub-actions"><a class="hub-btn hub-btn--primary" href="/hub/organizations/invite" data-drawer><i class="fa-solid fa-plus" aria-hidden="true"></i> Invite a school</a></div><% } %>
      </header>

      <div class="hub-card hub-stats">
        <a class="hub-stat" <%- _href('schools.view', '#schools') %>><span class="hub-stat__label">Schools</span><span class="hub-stat__value"><%= _num(orgCount) %></span><span class="hub-stat__note"><%= _max ? `${_max - orgCount > 0 ? _max - orgCount : 0} places left` : (_onHold ? `${_onHold} on hold` : 'In your hub') %></span></a>
        <div class="hub-stat"><span class="hub-stat__label">Students</span><span class="hub-stat__value"><%= _num(totalStudents) %></span><span class="hub-stat__note">Active</span></div>
        <div class="hub-stat"><span class="hub-stat__label">Staff</span><span class="hub-stat__value"><%= _num(totalTeachers) %></span><span class="hub-stat__note">All schools</span></div>
        <div class="hub-stat"><span class="hub-stat__label">Classes</span><span class="hub-stat__value"><%= _num(totalClasses) %></span><span class="hub-stat__note">All schools</span></div>
      </div>

      <div class="hub-grid">
        <div class="hub-card">
          <div class="hub-card__head"><h2 class="hub-card__title">Needs your attention</h2></div>
          <div class="hub-alerts">
            <% if (_requests.length && _can('requests.manage')) { %><a class="hub-alert" href="#requests"><i class="fa-solid fa-triangle-exclamation" aria-hidden="true"></i><span><strong><%= _requests.length %></strong> school<%= _requests.length === 1 ? ' wants' : 's want' %> to leave your hub</span><i class="fa-solid fa-chevron-right" aria-hidden="true"></i></a><% } %>
            <% if (_invites.length && _can('invitations.manage')) { %><a class="hub-alert hub-alert--info" href="#invitations"><i class="fa-solid fa-envelope" aria-hidden="true"></i><span><strong><%= _invites.length %></strong> invitation<%= _invites.length === 1 ? '' : 's' %> not accepted yet</span><i class="fa-solid fa-chevron-right" aria-hidden="true"></i></a><% } %>
            <% if (_onHold && _can('schools.view')) { %><a class="hub-alert hub-alert--info" href="#schools"><i class="fa-solid fa-pause" aria-hidden="true"></i><span><strong><%= _onHold %></strong> school<%= _onHold === 1 ? ' is' : 's are' %> on hold</span><i class="fa-solid fa-chevron-right" aria-hidden="true"></i></a><% } %>
            <div data-attention-extra style="display:contents"></div>
            <div class="hub-alert hub-alert--ok" data-attention-clear<%= (_requests.length && _can('requests.manage')) || (_invites.length && _can('invitations.manage')) || (_onHold && _can('schools.view')) ? ' hidden' : '' %>><i class="fa-solid fa-circle-check" aria-hidden="true"></i><span>All clear. Nothing needs your attention.</span></div>
          </div>
        </div>
        <% if (_can('schools.view')) { %>
        <div class="hub-card">
          <div class="hub-card__head"><h2 class="hub-card__title">Recent activity</h2></div>
          <% if (!_activity.length) { %>
            <div class="hub-empty"><i class="fa-regular fa-clock" aria-hidden="true"></i>No activity yet.</div>
          <% } else { %>
            <ul class="hub-activity">
              <% _activity.slice(0, 5).forEach((a) => { %>
                <li><span class="hub-activity__icon"><i class="fa-solid <%= _activityIcon(a.action_type) %>" aria-hidden="true"></i></span><span class="hub-activity__text"><%= a.description || a.action_type %></span><span class="hub-activity__when"><%= _date(a.created_at) %></span></li>
              <% }) %>
            </ul>
          <% } %>
        </div>
        <% } %>
      </div>
    </section>

    <!-- Reports: saved reports, and a step-by-step builder (public/js/hubReports.js) -->
    <% if (_can('reports.view')) { %>
    <section class="hub-view" data-view="reports" aria-label="Reports">
      <div class="hub-rp" data-reports data-can-create="<%= _can('reports.create') ? '1' : '' %>" data-can-export="<%= _can('reports.export') ? '1' : '' %>" data-hub-name="<%= _hub.hub_name || 'Hub' %>">
        <header class="hub-hero">
          <div>
            <h1 class="hub-hero__title">Reports</h1>
            <p class="hub-hero__sub">Reports saved by your hub. <%= _can('reports.create') ? 'Build a new one in three steps.' : '' %></p>
          </div>
          <% if (_can('reports.create')) { %><div class="hub-actions"><button type="button" class="hub-btn hub-btn--primary" data-rp-new><i class="fa-solid fa-plus" aria-hidden="true"></i> New report</button></div><% } %>
        </header>

        <!-- Saved reports -->
        <div class="hub-card hub-rp__saved" data-rp-list><div class="hub-loading">Loading saved reports…</div></div>

        <!-- Builder -->
        <% if (_can('reports.create')) { %>
        <div class="hub-rp__builder" data-rp-builder hidden>
          <div class="hub-rp__bar">
            <button type="button" class="hub-btn hub-btn--ghost hub-btn--sm" data-rp-back><i class="fa-solid fa-arrow-left" aria-hidden="true"></i> Saved reports</button>
          </div>
          <div class="hub-card hub-step is-open" data-step="type">
            <button type="button" class="hub-step__head" data-step-toggle aria-expanded="true">
              <span class="hub-step__num">1</span><span class="hub-step__title">Report</span><span class="hub-step__sum" data-step-sum></span><i class="fa-solid fa-chevron-down hub-step__chev" aria-hidden="true"></i>
            </button>
            <div class="hub-step__body">
              <div class="hub-rb__types" data-rb-types role="radiogroup" aria-label="Report"></div>
              <div class="hub-step__foot"><button type="button" class="hub-btn hub-btn--primary hub-btn--sm" data-step-next>Continue</button></div>
            </div>
          </div>
          <div class="hub-card hub-step" data-step="columns">
            <button type="button" class="hub-step__head" data-step-toggle aria-expanded="false">
              <span class="hub-step__num">2</span><span class="hub-step__title">Columns</span><span class="hub-step__sum" data-step-sum></span><i class="fa-solid fa-chevron-down hub-step__chev" aria-hidden="true"></i>
            </button>
            <div class="hub-step__body">
              <div class="hub-rb__checks" data-rb-columns></div>
              <div class="hub-step__foot"><button type="button" class="hub-btn hub-btn--primary hub-btn--sm" data-step-next>Continue</button></div>
            </div>
          </div>
          <div class="hub-card hub-step" data-step="schools">
            <button type="button" class="hub-step__head" data-step-toggle aria-expanded="false">
              <span class="hub-step__num">3</span><span class="hub-step__title">Schools and term</span><span class="hub-step__sum" data-step-sum></span><i class="fa-solid fa-chevron-down hub-step__chev" aria-hidden="true"></i>
            </button>
            <div class="hub-step__body">
              <div data-rb-schools><div class="hub-loading">Loading schools…</div></div>
              <label class="hub-rb__check hub-rb__skip"><input type="checkbox" data-rb-skip checked /> <span>Leave out schools with no data for the term</span></label>
            </div>
          </div>
          <div class="hub-rb__run">
            <button type="button" class="hub-btn hub-btn--primary" data-rb-run><i class="fa-solid fa-table" aria-hidden="true"></i> Generate report</button>
          </div>
        </div>
        <% } %>

        <div data-rp-result></div>
      </div>
    </section>
    <% } %>

    <!-- Schools -->
    <% if (_can('schools.view')) { %>
    <section class="hub-view" data-view="schools" aria-label="Schools">
      <header class="hub-hero">
        <div>
          <h1 class="hub-hero__title">Schools</h1>
          <p class="hub-hero__sub"><%= _capacity %> places used</p>
        </div>
        <% if (_can('invitations.manage')) { %><div class="hub-actions"><a class="hub-btn hub-btn--primary" href="/hub/organizations/invite" data-drawer><i class="fa-solid fa-plus" aria-hidden="true"></i> Invite a school</a></div><% } %>
      </header>
      <div class="hub-card">
        <% if (!_orgs.length) { %>
          <div class="hub-empty"><i class="fa-solid fa-school" aria-hidden="true"></i><strong>No schools in your hub yet</strong><% if (_can('invitations.manage')) { %>Invite a school to get started.<a class="hub-btn hub-btn--primary" href="/hub/organizations/invite" data-drawer>Invite a school</a><% } %></div>
        <% } else { %>
          <div class="hub-table-wrap">
            <table class="hub-table">
              <thead>
                <tr><th>School</th><th>Contact</th><th class="num">Students</th><th class="num">Staff</th><th class="num">Classes</th><th>Status</th><th>Joined</th><th></th></tr>
              </thead>
              <tbody>
                <% _orgs.forEach((org) => { %>
                  <tr class="<%= org.on_hold ? 'is-held' : '' %>">
                    <td>
                      <a class="hub-school" href="/hub/organizations/<%= org.organization_id %>"><%= org.organization_name %></a>
                      <% if (org.nickname) { %><span class="hub-small"><%= org.nickname %>.<%= _hub.hub_nickname %>.managira.com</span><% } %>
                    </td>
                    <td><%= [org.first_name, org.last_name].filter(Boolean).join(' ') || '—' %><span class="hub-small"><%= org.organization_email || '' %></span></td>
                    <td class="num"><%= _num(org.student_count) %></td>
                    <td class="num"><%= _num(org.teacher_count) %></td>
                    <td class="num"><%= _num(org.class_count) %></td>
                    <td><span class="hub-status<%= org.on_hold ? ' hub-status--hold' : '' %>"><%= org.on_hold ? 'On hold' : 'Active' %></span></td>
                    <td><%= _date(org.joined_hub_at) %></td>
                    <td>
                      <div class="hub-row-actions">
                        <a class="hub-btn hub-btn--sm" href="/hub/organizations/<%= org.organization_id %>">View</a>
                        <% if (_can('schools.access') && !org.on_hold) { %><a class="hub-btn hub-btn--sm hub-btn--soft" href="/hub/organizations/<%= org.organization_id %>/open" data-open-school data-name="<%= org.organization_name %>" data-no-spa><i class="fa-solid fa-arrow-right-to-bracket" aria-hidden="true"></i> Open school</a><% } %>
                        <% if (_can('schools.edit') || _can('schools.hold') || _can('schools.remove')) { %>
                        <details class="hub-menu">
                          <summary class="hub-btn hub-btn--ghost hub-btn--sm" aria-label="More actions for <%= org.organization_name %>"><i class="fa-solid fa-ellipsis" aria-hidden="true"></i></summary>
                          <div class="hub-menu__list">
                            <% if (_can('schools.edit')) { %><a class="hub-menu__item" href="/hub/organizations/edit/<%= org.organization_id %>" data-drawer><i class="fa-solid fa-pen" aria-hidden="true"></i> Edit details</a><% } %>
                            <% if (_can('schools.hold')) { %><button type="button" class="hub-menu__item" data-org-action="<%= org.on_hold ? 'resume' : 'hold' %>" data-org-id="<%= org.organization_id %>" data-org-name="<%= org.organization_name %>"><i class="fa-solid <%= org.on_hold ? 'fa-play' : 'fa-pause' %>" aria-hidden="true"></i> <%= org.on_hold ? 'Resume' : 'Put on hold' %></button><% } %>
                            <% if (_can('schools.remove')) { %>
                            <div class="hub-menu__sep"></div>
                            <button type="button" class="hub-menu__item hub-menu__item--danger" data-org-action="remove" data-org-id="<%= org.organization_id %>" data-org-name="<%= org.organization_name %>"><i class="fa-solid fa-link-slash" aria-hidden="true"></i> Remove from hub</button>
                            <button type="button" class="hub-menu__item hub-menu__item--danger" data-org-action="delete" data-org-id="<%= org.organization_id %>" data-org-name="<%= org.organization_name %>"><i class="fa-solid fa-trash" aria-hidden="true"></i> Delete permanently</button>
                            <% } %>
                          </div>
                        </details>
                        <% } %>
                      </div>
                    </td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        <% } %>
      </div>
    </section>
    <% } %>

    <!-- Invitations -->
    <% if (_can('invitations.manage')) { %>
    <section class="hub-view" data-view="invitations" aria-label="Invitations">
      <header class="hub-hero">
        <div>
          <h1 class="hub-hero__title">Invitations</h1>
          <p class="hub-hero__sub">Schools you've invited that haven't joined yet.</p>
        </div>
        <div class="hub-actions"><a class="hub-btn hub-btn--primary" href="/hub/organizations/invite" data-drawer><i class="fa-solid fa-plus" aria-hidden="true"></i> Invite a school</a></div>
      </header>
      <% if (!_invites.length) { %>
        <div class="hub-card hub-empty"><i class="fa-solid fa-envelope-open" aria-hidden="true"></i>No pending invitations.</div>
      <% } else { %>
        <div class="hub-items">
          <% _invites.forEach((inv) => { %>
            <div class="hub-item">
              <div>
                <h3 class="hub-item__title"><%= inv.organization_name %> <span class="hub-tag <%= inv.existing_org_id ? 'hub-tag--blue' : 'hub-tag--violet' %>"><%= inv.existing_org_id ? 'Existing school' : 'New school' %></span></h3>
                <p class="hub-item__meta"><%= inv.contact_person_name %> · <%= inv.contact_person_email %><br />Sent <%= _date(inv.created_at) %> · Expires <%= _date(inv.expires_at) %></p>
              </div>
              <div class="hub-actions">
                <form action="/hub/organizations/resend-invite" method="POST" data-ajax>
                  <input type="hidden" name="invitationId" value="<%= inv.invitation_id %>" />
                  <button type="submit" class="hub-btn hub-btn--sm"><i class="fa-solid fa-paper-plane" aria-hidden="true"></i> Resend</button>
                </form>
                <form action="/hub/organizations/cancel-invitation" method="POST" data-ajax data-confirm="Cancel the invitation to <%= inv.organization_name %>?">
                  <input type="hidden" name="invitationId" value="<%= inv.invitation_id %>" />
                  <button type="submit" class="hub-btn hub-btn--danger hub-btn--sm">Cancel invitation</button>
                </form>
              </div>
            </div>
          <% }) %>
        </div>
      <% } %>
    </section>
    <% } %>

    <!-- Leave (detachment) requests -->
    <% if (_can('requests.manage')) { %>
    <section class="hub-view" data-view="requests" aria-label="Leave requests">
      <header class="hub-hero">
        <div>
          <h1 class="hub-hero__title">Leave requests</h1>
          <p class="hub-hero__sub">Schools asking to leave your hub. Approving makes them independent with their own subscription.</p>
        </div>
      </header>
      <% if (!_requests.length) { %>
        <div class="hub-card hub-empty"><i class="fa-solid fa-circle-check" aria-hidden="true"></i>No requests waiting.</div>
      <% } else { %>
        <div class="hub-items">
          <% _requests.forEach((r) => { %>
            <div class="hub-item hub-item--warn">
              <div style="flex: 1; min-width: 260px;">
                <h3 class="hub-item__title"><%= r.organization_name %></h3>
                <p class="hub-item__meta">Requested by <%= r.requested_by %> · <%= _date(r.requested_at) %></p>
                <% if (r.reason) { %><p class="hub-item__quote"><%= r.reason %></p><% } %>
              </div>
              <div class="hub-actions">
                <form action="/hub/detachment-requests/approve" method="POST" data-ajax data-confirm="Approve the request from <%= r.organization_name %>? They will become independent and need their own subscription. This can't be undone.">
                  <input type="hidden" name="requestId" value="<%= r.request_id %>" />
                  <button type="submit" class="hub-btn hub-btn--success hub-btn--sm"><i class="fa-solid fa-check" aria-hidden="true"></i> Approve</button>
                </form>
                <button type="button" class="hub-btn hub-btn--danger hub-btn--sm" data-reject-id="<%= r.request_id %>" data-reject-name="<%= r.organization_name %>"><i class="fa-solid fa-xmark" aria-hidden="true"></i> Reject</button>
              </div>
            </div>
          <% }) %>
        </div>
      <% } %>
    </section>
    <% } %>
  </div>

  <dialog class="hub-dialog" data-reject-dialog>
    <form action="/hub/detachment-requests/reject" method="POST" data-ajax>
      <div class="hub-dialog__body">
        <h2>Reject leave request</h2>
        <p>You're rejecting the request from <strong data-reject-name-label></strong>. Your note is sent to the school.</p>
        <input type="hidden" name="requestId" data-reject-id-input />
        <label class="hub-label" for="hubRejectNotes">Reason (optional)</label>
        <textarea id="hubRejectNotes" name="notes" placeholder="Let the school know why"></textarea>
      </div>
      <div class="hub-dialog__actions">
        <button type="button" class="hub-btn" data-reject-cancel>Cancel</button>
        <button type="submit" class="hub-btn hub-btn--danger-solid">Reject request</button>
      </div>
    </form>
  </dialog>
</div>

<script src="<%= assetUrl('/js/hub.js') %>"></script>
<% if (_can('reports.view')) { %><script src="<%= assetUrl('/js/hubReports.js') %>"></script><% } %>
