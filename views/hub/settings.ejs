<%- include('../partials/flash') %>

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Hub Settings - Managira</title>
  <link rel="stylesheet" href="/css/style.css">
  <style>
    :root {
      --primary: #01535b;
      --primary-hover: #014a51;
      --text-primary: #111827;
      --text-secondary: #6b7280;
      --border: #e5e7eb;
      --bg: #f9fafb;
    }

    body { background: var(--bg); font-family: "Inter", -apple-system, sans-serif; }

    .hub-container { max-width: 1200px; margin: 0 auto; padding: 24px 20px; }

    .hub-header {
      background: var(--primary);
      color: white;
      padding: 28px 32px;
      border-radius: 12px;
      margin-bottom: 24px;
    }

    .hub-header h1 { font-size: 1.5rem; margin-bottom: 4px; font-weight: 700; }
    .hub-header p { opacity: 0.85; font-size: 0.9rem; }

    .hub-nav { display: flex; gap: 8px; margin-bottom: 24px; flex-wrap: wrap; }

    .hub-nav a {
      padding: 8px 18px;
      background: white;
      border: 1px solid var(--border);
      border-radius: 8px;
      text-decoration: none;
      color: var(--text-primary);
      font-weight: 600;
      font-size: 0.9rem;
      transition: all 0.15s;
    }

    .hub-nav a:hover, .hub-nav a.active {
      background: var(--primary);
      color: white;
      border-color: var(--primary);
    }

    .settings-card {
      background: white;
      border-radius: 10px;
      padding: 24px;
      margin-bottom: 20px;
      border: 1px solid var(--border);
    }

    .settings-card h2 {
      font-size: 1.15rem;
      margin-bottom: 16px;
      color: var(--text-primary);
      padding-bottom: 12px;
      border-bottom: 1px solid var(--border);
    }

    .form-group { margin-bottom: 16px; }

    .form-label {
      display: block;
      font-weight: 600;
      color: var(--text-primary);
      margin-bottom: 6px;
      font-size: 0.85rem;
    }

    .form-input {
      width: 100%;
      padding: 10px 14px;
      border: 1px solid var(--border);
      border-radius: 8px;
      font-size: 0.95rem;
      font-family: inherit;
    }

    .form-input:focus {
      outline: none;
      border-color: var(--primary);
      box-shadow: 0 0 0 3px rgba(1, 83, 91, 0.06);
    }

    .btn-primary {
      padding: 10px 20px;
      background: var(--primary);
      color: white;
      border: none;
      border-radius: 8px;
      font-size: 0.9rem;
      font-weight: 600;
      cursor: pointer;
      transition: background 0.15s;
      font-family: inherit;
    }

    .btn-primary:hover { background: var(--primary-hover); }

    .info-box {
      background: var(--bg);
      border: 1px solid var(--border);
      padding: 14px 16px;
      border-radius: 8px;
      margin-bottom: 16px;
      color: var(--text-primary);
      font-size: 0.9rem;
      line-height: 1.8;
    }

    .info-box strong { color: var(--primary); }
  </style>
</head>
<body>
  <div class="hub-container">
    <div class="hub-header">
      <h1>Hub Settings</h1>
      <p>Manage your hub profile and preferences</p>
    </div>

    <div class="hub-nav">
      <a href="/hub/dashboard">Dashboard</a>
      <a href="/hub/settings" class="active">Settings</a>
      <a href="/hub/logout">Logout</a>
    </div>

    <div class="settings-card">
      <h2>Hub Information</h2>
      <div class="info-box">
        <strong>Hub Name:</strong> <%= hub.hub_name %><br>
        <strong>Nickname:</strong> <%= hub.hub_nickname %><br>
        <strong>URL:</strong> https://<%= hub.hub_nickname %>.managira.com<br>
        <strong>Plan:</strong> <%= hub.plan_name || 'No plan assigned' %><br>
        <strong>Max Organizations:</strong> <%= hub.max_organizations %>
      </div>
    </div>

    <div class="settings-card">
      <h2>Profile Settings</h2>
      <form action="/hub/settings/profile" method="POST">
        <div class="form-group">
          <label class="form-label">First Name</label>
          <input type="text" name="firstName" class="form-input" value="<%= hub.first_name %>" required>
        </div>
        <div class="form-group">
          <label class="form-label">Last Name</label>
          <input type="text" name="lastName" class="form-input" value="<%= hub.last_name %>" required>
        </div>
        <div class="form-group">
          <label class="form-label">Phone</label>
          <input type="text" name="hubPhone" class="form-input" value="<%= hub.hub_phone || '' %>">
        </div>
        <div class="form-group">
          <label class="form-label">Address</label>
          <input type="text" name="hubAddress" class="form-input" value="<%= hub.hub_address || '' %>">
        </div>
        <button type="submit" class="btn-primary">Update Profile</button>
      </form>
    </div>

    <div class="settings-card">
      <h2>Change Password</h2>
      <form action="/hub/settings/password" method="POST">
        <div class="form-group">
          <label class="form-label">Current Password</label>
          <input type="password" name="currentPassword" class="form-input" required>
        </div>
        <div class="form-group">
          <label class="form-label">New Password</label>
          <input type="password" name="newPassword" class="form-input" required minlength="6">
        </div>
        <div class="form-group">
          <label class="form-label">Confirm New Password</label>
          <input type="password" name="confirmPassword" class="form-input" required minlength="6">
        </div>
        <button type="submit" class="btn-primary">Change Password</button>
      </form>
    </div>
  </div>
</body>
</html>