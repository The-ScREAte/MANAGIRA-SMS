
<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('partials/head', { title: (typeof title !== 'undefined' && title) ? title : 'Managira' }) %>
    <style>
        html, body {
            min-height: 100%;
            margin: 0;
            padding: 0;
        }

        body {
            display: flex;
            flex-direction: column;
            min-height: 100vh;
            min-height: 100dvh;
        }

        #app-scale-root {
            display: flex;
            flex-direction: column;
            flex: 1 0 auto;
            min-height: 100%;
        }

        main {
            flex: 1 0 auto;
            padding: 0;
            max-width: 100%;
            margin: 0 auto;
            width: 100%;
            box-sizing: border-box;
            zoom: 0.9;
        }

        .managira-footer {
            margin-top: auto;
            flex-shrink: 0;
            zoom: 0.9;
        }
    </style>
</head>
<body>
    <div id="app-scale-root">
        <!-- Loading overlay for smooth transitions -->
        <div class="page-loading-overlay">
            <div class="spinner"></div>
        </div>

        <% if (session.accountType === 'Admin' || session.accountType === 'Mini Admin') { %>
            <% if (typeof showOrgHeader !== 'undefined' && showOrgHeader) { %>
                <%- include('partials/header', { orgHeaderName: typeof orgHeaderName !== 'undefined' ? orgHeaderName : null, orgHeaderLogo: typeof orgHeaderLogo !== 'undefined' ? orgHeaderLogo : null }) %>
            <% } else { %>
                <%- include('partials/adminHeader') %>
            <% } %>
        <% } else { %>
            <%- include('partials/header') %>
        <% } %>


        <main>
            <%- body %>
        </main>
        <%- include('partials/footer') %>
    </div>

    <script>
        (function () {
            function updateBottomInset() {
                var vv = window.visualViewport;
                var inset = 0;

                if (vv) {
                    var viewportDelta = Math.round(window.innerHeight - vv.height);
                    var possibleBottomInset = Math.max(0, viewportDelta - Math.max(0, Math.round(vv.offsetTop || 0)));

                    if (possibleBottomInset >= 14) {
                        inset = Math.min(possibleBottomInset, 64);
                    }
                }

                document.documentElement.style.setProperty('--dynamic-bottom-inset', inset + 'px');
            }

            updateBottomInset();
            window.addEventListener('resize', updateBottomInset, { passive: true });
            window.addEventListener('orientationchange', updateBottomInset, { passive: true });

            if (window.visualViewport) {
                window.visualViewport.addEventListener('resize', updateBottomInset, { passive: true });
                window.visualViewport.addEventListener('scroll', updateBottomInset, { passive: true });
            }
        })();
    </script>
</body>
</html>
