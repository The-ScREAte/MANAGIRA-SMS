<%
  // Inside a workspace pane (iframe): never show the global chrome, even when
  // a page's controller passed its own hideGlobalHeader: false.
  if (locals.isEmbeddedFrame) {
    locals.hideGlobalHeader = true;
    locals.hideGlobalFooter = true;
    locals.hideGlobalChatbot = true;
  }
%>
<%
  // The signed-in person's own look: light (a soft gray, the default) or dark.
  // Platform admin pages, public pages (school website, legal, sign-in),
  // PDFs and prints always use the plain white design.
  const _appearancePath = typeof currentPath !== 'undefined' ? String(currentPath || '') : '';
  const _isPublicPath = _appearancePath === '/' || _appearancePath === ''
    || /^\/(legal|account\/([a-z-]*login|register|forgot|reset|set-?password|verify)|common\/(publicDashboard|publicRegister|setPassword)|hub\/(login|setup-password|billing\/setup))/i.test(_appearancePath);
  const _isOrgThemed = !!locals.appearanceOwner && !_appearancePath.startsWith('/admin') && !_isPublicPath;
  const _appearance = _isOrgThemed && !locals.isPrintRender ? (locals.appearance === 'dark' ? 'dark' : 'gray') : 'white';
%>
<!DOCTYPE html>
<html lang="en" data-appearance="<%= _appearance %>">
<head>
    <%- include('partials/head', { title: (typeof title !== 'undefined' && title) ? title : 'Managira' }) %>
    <style>
        html, body {
            min-height: 100%;
            margin: 0;
            padding: 0;
        }

        body {
            display: flex;
            flex-direction: column;
            min-height: 100vh;
            min-height: 100dvh;
        }

        #app-scale-root {
            display: flex;
            flex-direction: column;
            flex: 1 0 auto;
            min-height: 100%;
        }

        main {
            flex: 1 0 auto;
            padding: 0;
            max-width: 100%;
            margin: 0 auto;
            width: 100%;
            box-sizing: border-box;
        }

        .managira-footer {
            margin-top: auto;
            flex-shrink: 0;
        }
    </style>
    <% if (!(typeof disableMainZoom !== 'undefined' && disableMainZoom)) { %>
    <!-- Shared app-wide size reduction (see public/css/globalScale.css) -
         applied to the whole document (header included) instead of just
         main/footer so nothing on the page looks mismatched in scale.
         hideGlobalHeader alone does NOT skip this - most pages that hide
         their own header/footer are just embedded panel CONTENT (Reports,
         Activity Logs, Management Tools sub-pages, etc.) and should still
         be scaled like everything else. Only disableMainZoom skips it -
         reserved for the handful of hub shells that host an iframe AND
         poll its geometry/position (managementTools, reportsHub,
         admissionsHub, mailroom) - CSS zoom throws off that math. -->
    <link rel="stylesheet" href="/css/globalScale.css">
    <% } %>
    <link rel="stylesheet" href="<%= assetUrl('/css/appearance.css') %>">
    <% if (_appearance !== 'white') { %><script src="<%= assetUrl('/js/appearance.js') %>" defer></script><% } %>
</head>
<body class="<%= _isOrgThemed ? 'org-appearance' : '' %> <%= (typeof compactUi !== 'undefined' && compactUi) ? 'managira-compact' : '' %> <%= (typeof compactTables !== 'undefined' && compactTables) ? 'managira-compact-tables' : '' %> <%= (typeof currentPath !== 'undefined' && String(currentPath || '').startsWith('/admin')) ? 'admin-area' : '' %>">
    <div id="app-scale-root">
        <!-- Loading overlay for smooth transitions -->
        <div class="page-loading-overlay">
            <div class="spinner"></div>
        </div>

        <% if (!(typeof hideGlobalHeader !== 'undefined' && hideGlobalHeader)) { %>
            <%
              const _normAccountType = (session && session.accountType) ? String(session.accountType).trim().toLowerCase() : '';
              const _normUserRole    = (session && session.userRole)    ? String(session.userRole).trim().toLowerCase()    : '';
              const _currentPath     = (typeof currentPath !== 'undefined' && currentPath) ? String(currentPath) : '';
              const _isPlatformAdmin = _normAccountType === 'admin' || _normAccountType === 'mini admin' || _normAccountType === 'internal worker'
                || _normUserRole === 'admin' || _normUserRole === 'mini admin' || _normUserRole === 'internal worker';
              const _isFullAdmin = _normAccountType === 'admin' || _normUserRole === 'admin';
              const _isInternalWorker = _normAccountType === 'internal worker' || _normUserRole === 'internal worker';
                            const _forceAdminHeader = !!(typeof forceAdminHeader !== 'undefined' && forceAdminHeader);
                            const _isAdminOrgSwitch = !!(session && session.superAdminOrgSwitch && session.organizationId && _isPlatformAdmin);
                            const _isAdminAreaRoute = _currentPath.startsWith('/admin');
                                                        const _useOrgHeader = !_forceAdminHeader && ((_isAdminOrgSwitch && !_isAdminAreaRoute) || (!_isInternalWorker && typeof showOrgHeader !== 'undefined' && showOrgHeader));
              const _showBackToAdmin = _isAdminOrgSwitch
                                && !_isAdminAreaRoute
                && _currentPath !== '/account/login'
                && _currentPath !== '/'
                && !_currentPath.startsWith('/legal/')
                && !_currentPath.startsWith('/stats/');
            %>
            <% if (_isPlatformAdmin) { %>
                <% if (_useOrgHeader) { %>
                    <%- include('partials/header', {
                        orgHeaderName: typeof orgHeaderName !== 'undefined' ? orgHeaderName : null,
                        orgHeaderLogo: typeof orgHeaderLogo !== 'undefined' ? orgHeaderLogo : null,
                        orgHeaderNickname: typeof orgHeaderNickname !== 'undefined' ? orgHeaderNickname : null,
                        orgHeaderNicknameDisplay: typeof orgHeaderNicknameDisplay !== 'undefined' ? orgHeaderNicknameDisplay : null
                    }) %>
                <% } else { %>
                    <%- include('partials/adminHeader') %>
                <% } %>
            <% } else { %>
                <%- include('partials/header') %>
            <% } %>

            <% if (_showBackToAdmin) { %>
                <a href="/admin/exit-org" class="back-to-admin-chip" aria-label="Back to Admin" data-no-spa>
                    <span aria-hidden="true">&larr;</span>
                    <span>Back to Admin</span>
                </a>
            <% } %>
            <% if (session && session.hubOrgSwitch && !_currentPath.startsWith('/hub/')) { %>
                <a href="/hub/exit-org" class="back-to-admin-chip" aria-label="Back to hub" data-no-spa>
                    <span aria-hidden="true">&larr;</span>
                    <span>Back to hub</span>
                </a>
            <% } %>
            <% if (session && session.adminHubView && _currentPath.startsWith('/hub/')) { %>
                <a href="/admin/exit-hub" class="back-to-admin-chip" aria-label="Back to Admin" data-no-spa>
                    <span aria-hidden="true">&larr;</span>
                    <span>Back to Admin</span>
                </a>
            <% } %>
        <% } %>

        <% if (!(typeof hideGlobalHeader !== 'undefined' && hideGlobalHeader)) { %>
            <%- include('partials/announcementFeed') %>
            <% if (session && session.organizationId && !session.superAdminOrgSwitch && !(typeof noFeedbackPrompt !== 'undefined' && noFeedbackPrompt)) { %>
                <link rel="stylesheet" href="<%= assetUrl('/css/feedbackPrompt.css') %>">
                <script src="<%= assetUrl('/js/feedbackPrompt.js') %>" data-autoprompt="1" defer></script>
            <% } %>
        <% } %>

        <main>
            <%- body %>
        </main>

        <%# Compact UI styles — injected AFTER view body so these rules win against any view-level inline <style> blocks with matching specificity. %>
        <style>
            /* Admin area: style.css gives every <button> full width and a 20px top
               margin. Here buttons size to their text and line up side by side.
               Same specificity as that rule, so any button with its own class-based
               width or margin keeps it. */
            :where(body.admin-area) button {
                width: auto;
                margin-top: 0;
            }
            .back-to-admin-chip {
                position: fixed;
                top: 12px;
                left: 12px;
                z-index: 12050;
                display: inline-flex;
                align-items: center;
                gap: 6px;
                padding: 6px 12px;
                border-radius: 999px;
                background: rgba(0, 0, 0, 0.75);
                color: #ffffff;
                text-decoration: none;
                font-size: 12px;
                font-weight: 400;
                line-height: 1.2;
                letter-spacing: 0.01em;
                border: 1px solid rgba(255, 255, 255, 0.18);
                backdrop-filter: blur(8px);
                -webkit-backdrop-filter: blur(8px);
            }

            .back-to-admin-chip:hover {
                background: rgba(0, 0, 0, 0.84);
                color: #ffffff;
                cursor: pointer;
            }

            .back-to-admin-chip:focus-visible {
                outline: 2px solid rgba(255, 255, 255, 0.85);
                outline-offset: 2px;
            }

            @media (max-width: 768px) {
                .back-to-admin-chip {
                    top: 10px;
                    left: 10px;
                    padding: 5px 10px;
                    font-size: 12px;
                }

                /* Keep native date/select controls within viewport on phones. */
                body main input[type="date"],
                body main input[type="month"],
                body main input[type="time"],
                body main input[type="datetime-local"],
                body main select {
                    max-width: 100% !important;
                    min-width: 0 !important;
                    box-sizing: border-box;
                }
            }

            /* ---------- Managira Compact Headings ---------- */
            body.managira-compact main h1 { font-size: 1.25rem; line-height: 1.3; }
            body.managira-compact main h2 { font-size: 1.05rem; line-height: 1.3; }
            body.managira-compact main h3 { font-size: 0.95rem; line-height: 1.3; }
            body.managira-compact main h4 { font-size: 0.875rem; line-height: 1.3; }
            body.managira-compact main h5 { font-size: 0.8rem;   line-height: 1.3; }
            body.managira-compact main h6 { font-size: 0.75rem;  line-height: 1.3; }

            /* Shared "page title" patterns used across the app */
            body.managira-compact main .page-title,
            body.managira-compact main .page-header h1,
            body.managira-compact main .section-header h1,
            body.managira-compact main .dashboard-title,
            body.managira-compact main .card-title,
            body.managira-compact main .modal-title { font-size: 1.15rem; }

            /* Leave the global app header/footer/branding alone */
            body.managira-compact header h1,
            body.managira-compact header h2,
            body.managira-compact header h3,
            body.managira-compact .managira-footer h1,
            body.managira-compact .managira-footer h2,
            body.managira-compact .managira-footer h3 { font-size: revert; }

            /* ---------- Managira Compact Tables ---------- */
            body.managira-compact-tables main table {
                width: 100%;
                border-collapse: collapse;
                font-size: 0.78rem;
                color: #111827;
                background: #ffffff;
            }
            body.managira-compact-tables main table th {
                background: #f3f4f6;
                color: #4b5563;
                font-size: 0.68rem;
                font-weight: 700;
                text-transform: uppercase;
                letter-spacing: 0.04em;
                padding: 6px 10px;
                text-align: left;
                border-bottom: 1px solid #e5e7eb;
                white-space: nowrap;
            }
            body.managira-compact-tables main table td {
                padding: 5px 10px;
                border-top: 1px solid #eef1f3;
                font-size: 0.78rem;
                vertical-align: middle;
            }
            body.managira-compact-tables main table tbody tr:nth-child(even) td {
                background: #fbfcfc;
            }
            body.managira-compact-tables main table tbody tr:hover td {
                background: #f1f5f7;
            }
            body.managira-compact-tables main table td img {
                max-height: 26px;
            }
            body.managira-compact-tables main table td input,
            body.managira-compact-tables main table td select,
            body.managira-compact-tables main table td textarea {
                font-size: 0.75rem;
            }
            body.managira-compact-tables main table td .btn,
            body.managira-compact-tables main table td button {
                font-size: 0.72rem;
                padding: 3px 8px;
            }

            @media print {
                body.managira-compact main h1,
                body.managira-compact main h2,
                body.managira-compact main h3,
                body.managira-compact main h4,
                body.managira-compact main h5,
                body.managira-compact main h6 { font-size: revert; }
                body.managira-compact-tables main table,
                body.managira-compact-tables main table th,
                body.managira-compact-tables main table td { font-size: revert; padding: revert; background: revert; }
            }
        </style>
        <% if (!(typeof hideGlobalFooter !== 'undefined' && hideGlobalFooter)) { %>
            <%- include('partials/footer') %>
        <% } %>
    </div>

    <script>
        (function () {
            function updateBottomInset() {
                var vv = window.visualViewport;
                var inset = 0;

                if (vv) {
                    var viewportDelta = Math.round(window.innerHeight - vv.height);
                    var possibleBottomInset = Math.max(0, viewportDelta - Math.max(0, Math.round(vv.offsetTop || 0)));

                    if (possibleBottomInset >= 14) {
                        inset = Math.min(possibleBottomInset, 64);
                    }
                }

                document.documentElement.style.setProperty('--dynamic-bottom-inset', inset + 'px');
            }

            updateBottomInset();
            window.addEventListener('resize', updateBottomInset, { passive: true });
            window.addEventListener('orientationchange', updateBottomInset, { passive: true });

            if (window.visualViewport) {
                window.visualViewport.addEventListener('resize', updateBottomInset, { passive: true });
                window.visualViewport.addEventListener('scroll', updateBottomInset, { passive: true });
            }
        })();
    </script>
<% if (locals.appearanceOwner) { %>
<script>
  // Light / dark: the header switch and the settings picker save it for this person.
  (function () {
    if (window.__apSaveReady) return;
    window.__apSaveReady = true;
    function save(mode, status) {
      if (status) status.textContent = 'Saving…';
      fetch('/appearance', {
        method: 'POST',
        credentials: 'same-origin',
        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
        body: JSON.stringify({ appearanceMode: mode })
      }).then(function (r) { return r.json().then(function (b) { if (!r.ok || !b.success) throw new Error('failed'); }); })
        .then(function () { window.location.reload(); })
        .catch(function () { if (status) status.textContent = 'Could not save. Please try again.'; });
    }
    document.addEventListener('click', function (e) {
      var b = e.target.closest && e.target.closest('[data-ap-set]');
      if (!b || b.getAttribute('aria-pressed') === 'true') return;
      b.setAttribute('aria-checked', String(b.getAttribute('data-ap-set') === 'dark'));
      e.preventDefault();
      save(b.getAttribute('data-ap-set'));
    });
    document.addEventListener('change', function (e) {
      var box = e.target.closest && e.target.closest('[data-ap-picker]');
      if (!box || !e.target.value) return;
      save(e.target.value, box.parentElement && box.parentElement.querySelector('[data-ap-status]'));
    });
  })();
</script>
<% } %>
</body>
</html>
