<!DOCTYPE html>
<html lang="en">
<head>
  <link rel="stylesheet" href="/css/globalScale.css">
  <meta charset="UTF-8" />
  <meta name="viewport" content="<%= locals.viewportContent || 'width=device-width, initial-scale=1.0' %>" />
  <title>Promotion Scheduler</title>
  <style>
      :root {
        --font-family: "<%= (session && session.fontStyle ? String(session.fontStyle).trim() : 'Inter') %>", sans-serif;
      }

    body {
      font-family: var(--font-family);
      background-color: #f7f9fb;
      color: #0f2d32;
      margin: 0;
      overflow-x: hidden;
    }

    h2, h3 {
      text-align: center;
      color: #0f2d32;
      margin: 0 0 12px 0;
    }

    /* ── Hero header ── */
    .promo-hero {
      background: var(--org-primary-color, #0f5a66);
      background: linear-gradient(135deg, var(--org-primary-color, #0f5a66) 0%, color-mix(in srgb, var(--org-primary-color, #0f5a66) 68%, #000) 100%);
      color: #fff;
      padding: 40px 24px 30px;
      position: relative;
      overflow: hidden;
      width: 100%;
    }

    .promo-hero::after {
      content: '';
      position: absolute;
      top: -70px; right: -50px;
      width: 240px; height: 240px;
      background: rgba(255, 255, 255, 0.07);
      border-radius: 50%;
      pointer-events: none;
    }

    .promo-hero-inner {
      max-width: none;
      margin: 0;
      position: relative;
      z-index: 1;
    }

    .promo-back-btn {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      color: rgba(255, 255, 255, 0.9);
      text-decoration: none;
      font-size: 0.82rem;
      font-weight: 600;
      margin-bottom: 16px;
      padding: 6px 13px;
      border-radius: 999px;
      background: rgba(255, 255, 255, 0.14);
      border: 1px solid rgba(255, 255, 255, 0.3);
      transition: background 0.15s ease, color 0.15s ease;
    }

    .promo-back-btn:hover {
      background: rgba(255, 255, 255, 0.24);
      color: #fff;
      text-decoration: none;
    }

    .promo-hero h1 {
      margin: 0 0 6px;
      font-size: clamp(1.4rem, 3vw, 1.9rem);
      font-weight: 700;
      color: #fff;
      text-align: left;
    }

    .promo-hero p {
      margin: 0 0 14px;
      opacity: 0.9;
      font-size: 0.95rem;
      max-width: 640px;
    }

    .promo-meta {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
    }

    .promo-chip {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 6px 12px;
      border-radius: 999px;
      background: rgba(255, 255, 255, 0.16);
      border: 1px solid rgba(255, 255, 255, 0.28);
      font-size: 0.8rem;
      font-weight: 600;
    }

    .promotion-page {
      max-width: none;
      width: 100%;
      box-sizing: border-box;
      margin: 0;
      padding: 24px 24px 36px;
    }

    .card {
      background: #ffffff;
      border: 1px solid #e5e7eb;
      border-radius: 14px;
      box-shadow: 0 8px 22px rgba(15, 45, 50, 0.12);
      padding: 20px 18px;
      margin-bottom: 18px;
    }

    .alert-success,
    .alert-danger {
      padding: 12px;
      border-radius: 10px;
      margin-bottom: 15px;
      border: 1px solid transparent;
      text-align: center;
      font-weight: 600;
    }

    .alert-success {
      background-color: #d7f1e5;
      color: #0f5132;
      border-color: #a3e4c4;
    }

    .alert-danger {
      background-color: #fde2e1;
      color: #842029;
      border-color: #f5c2c7;
    }

    form {
      max-width: 100%;
      margin: 0 auto;
      background: #fff;
      padding: 0;
      border-radius: 0;
      box-shadow: none;
    }

    .form-card {
      padding: 18px;
      border-radius: 12px;
      border: 1px solid #e5e7eb;
      box-shadow: 0 6px 18px rgba(15, 45, 50, 0.1);
      background: #fff;
    }

    .form-group {
      margin-bottom: 14px;
    }

    label {
      display: block;
      margin-bottom: 6px;
      font-weight: 600;
      color: #0f2d32;
      font-size: 14px;
    }

    select, input[type="date"], input[type="time"] {
      width: 100%;
      padding: 10px 12px;
      border: 1px solid #d7dde5;
      border-radius: 10px;
      font-size: 14px;
      font-family: var(--font-family);
      transition: border-color 0.15s ease, box-shadow 0.15s ease;
      box-sizing: border-box;
    }

    select:focus, input[type="date"]:focus, input[type="time"]:focus {
      outline: none;
      border-color: var(--org-primary-color, #0f5a66);
      box-shadow: 0 0 0 3px rgba(15, 90, 102, 0.12);
    }

    .checkbox-label {
      display: block;
      margin-bottom: 8px;
      font-size: 14px;
    }

    button {
      background-color: var(--org-primary-color, #0f5a66);
      color: #fff;
      border: none;
      padding: 10px 14px;
      border-radius: 10px;
      cursor: pointer;
      transition: background-color 0.18s ease, transform 0.15s ease;
      font-weight: 600;
      box-shadow: 0 4px 12px rgba(15, 90, 102, 0.16);
    }

    button:hover {
      background-color: var(--org-primary-hover-fill, var(--org-primary-hover, #0d4f59));
      transform: translateY(-1px);
    }

    table {
      width: 100%;
      border-collapse: collapse;
      margin: 16px 0;
      background: #fff;
      border: 1px solid #e5e7eb;
      border-radius: 12px;
      overflow: hidden;
      box-shadow: 0 6px 18px rgba(15, 45, 50, 0.12);
    }

    th, td {
      border: 1px solid #e5e7eb;
      padding: 12px 10px;
      text-align: left;
      font-size: 14px;
    }

    th {
      background-color: var(--org-primary-color, #0f5a66);
      color: #fff;
      font-weight: 700;
      letter-spacing: 0.2px;
    }

    tr:nth-child(even) td {
      background: #f5f7f9;
    }

    .promotion-table-actions {
      text-align: center;
      display: flex;
      gap: 8px;
      justify-content: center;
      flex-wrap: wrap;
    }

    .btn-cancel {
      background-color: #dc3545;
      box-shadow: none;
    }

    .btn-cancel:hover {
      background-color: #b02a37;
      transform: translateY(-1px);
    }

    .btn-reverse {
      background-color: #f0ad4e;
      color: #0f2d32;
      box-shadow: none;
    }

    .btn-reverse:hover {
      background-color: #d08920;
      transform: translateY(-1px);
    }

    #instructions-container {
      max-width: 100%;
      margin: 0 auto 18px auto;
      background: #f0f6ff;
      padding: 18px;
      border-radius: 12px;
      box-shadow: 0 6px 18px rgba(15, 45, 50, 0.1);
      text-align: left;
      border: 1px solid #dbeafe;
    }

    #instructions-container p {
      margin-bottom: 14px;
      line-height: 1.55;
      color: #475569;
    }

    #instructions-container a {
      color: var(--org-primary-color, #0f5a66);
      font-weight: 600;
    }

    .collapsible-content {
      display: none;
      margin-top: 10px;
    }

    .collapsible-content.active {
      display: flex;
      flex-wrap: wrap;
      justify-content: flex-start;
      gap: 6px;
    }

    .promotion-class-list .checkbox-label {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      margin: 0;
      padding: 8px 12px;
      border: 1px solid #d7dde5;
      border-radius: 999px;
      background: #fff;
      box-shadow: 0 2px 6px rgba(15, 45, 50, 0.06);
      white-space: nowrap;
    }

    .promotion-class-list .checkbox-label input {
      margin: 0;
    }

    .collapsible-btn {
      background: var(--org-primary-color, #0f5a66);
      color: #fff;
      border: none;
      border-radius: 10px;
      padding: 10px 14px;
      cursor: pointer;
      margin-bottom: 10px;
      transition: background 0.18s ease, transform 0.15s ease;
      display: flex;
      align-items: center;
      justify-content: space-between;
      width: 100%;
      font-size: 14px;
      font-weight: 600;
      box-shadow: 0 4px 12px rgba(15, 90, 102, 0.16);
    }

    .collapsible-btn:hover {
      background: var(--org-primary-hover-fill, var(--org-primary-hover, #0d4f59));
      transform: translateY(-1px);
    }

    .arrow {
      display: inline-block;
      margin-left: 8px;
      transition: transform 0.3s;
    }

    .arrow.expanded {
      transform: rotate(90deg);
    }

    #toggleMoreButton {
      margin-top: 8px;
    }

    .intro-grid {
      display: grid;
      grid-template-columns: 1fr;
      gap: 10px;
    }

    .form-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(220px, 1fr));
      gap: 12px;
    }

    .form-group.full-width {
      grid-column: 1 / -1;
    }

    .mode-toggle {
      display: flex;
      gap: 10px;
      flex-wrap: wrap;
      margin-top: 6px;
    }

    .mode-option {
      border: 1px solid #d7dde5;
      border-radius: 999px;
      padding: 8px 12px;
      display: inline-flex;
      align-items: center;
      gap: 8px;
      cursor: pointer;
      font-weight: 600;
      background: #fff;
      transition: border-color 0.2s ease, background-color 0.2s ease;
    }

    .mode-option input {
      margin: 0;
    }

    .mode-option.active {
      border-color: var(--org-primary-color, #0f5a66);
      background: rgba(15, 90, 102, 0.09);
    }

    .classes-toolbar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      margin-bottom: 10px;
      flex-wrap: wrap;
    }

    .promotion-preview-box {
      border: 1px solid #dbe3ea;
      border-radius: 12px;
      background: #f8fbfc;
      padding: 12px;
      margin-top: 12px;
    }

    .promotion-class-section {
      margin-top: 14px;
      border: 1px solid #dbe3ea;
      border-radius: 12px;
      overflow: hidden;
      background: #fff;
    }

    .promotion-class-section-head {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 10px;
      flex-wrap: nowrap;
      padding: 12px 14px;
      background: rgba(15, 90, 102, 0.08);
      border-bottom: 1px solid #dbe3ea;
    }

    .promotion-class-section-title {
      flex: 1 1 auto;
      min-width: 0;
      font-size: 0.96rem;
      font-weight: 800;
      color: #0f5a66;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .promotion-class-section-meta {
      font-size: 0.8rem;
      color: #475569;
      font-weight: 600;
    }

    .promotion-class-section-message {
      padding: 12px 14px 14px;
      color: #475569;
      line-height: 1.5;
    }

    .promotion-class-section-message a {
      color: var(--org-primary-color, #0f5a66);
      font-weight: 700;
      text-decoration: underline;
    }

    .promotion-preview-meta {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 8px;
      margin-bottom: 10px;
      flex-wrap: wrap;
    }

    .promotion-preview-summary {
      margin: 0 0 10px;
      padding: 10px 12px;
      border-radius: 10px;
      background: rgba(15, 90, 102, 0.07);
      color: #0f2d32;
      font-size: 0.9rem;
      font-weight: 600;
      line-height: 1.45;
    }

    .selected-class-strip {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
      margin: 0 0 12px;
    }

    .selected-class-chip {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 6px 12px;
      border-radius: 999px;
      background: rgba(15, 90, 102, 0.1);
      color: #0f5a66;
      border: 1px solid rgba(15, 90, 102, 0.2);
      font-size: 13px;
      font-weight: 700;
    }

    .promotion-class-section-head-right {
      display: flex;
      align-items: center;
      gap: 6px;
      flex-wrap: nowrap;
      justify-content: flex-end;
      margin-left: auto;
    }

    .promotion-class-save-btn {
      min-width: 66px;
      padding: 6px 10px;
      font-size: 0.76rem;
      line-height: 1.1;
      border-radius: 8px;
      box-shadow: none;
    }
    .promotion-class-save-btn:disabled {
      opacity: 0.48;
      cursor: not-allowed;
      transform: none;
      box-shadow: none;
    }
    .btn-spinner {
      display: inline-block;
      width: 0.85em;
      height: 0.85em;
      border: 2px solid rgba(255, 255, 255, 0.55);
      border-top-color: #fff;
      border-radius: 50%;
      vertical-align: -0.15em;
      margin-right: 6px;
      animation: btn-spin 0.7s linear infinite;
    }
    @keyframes btn-spin {
      to { transform: rotate(360deg); }
    }
    button.is-busy {
      cursor: wait !important;
      opacity: 0.85;
    }
    .promotion-class-save-status {
      font-size: 0.78rem;
      color: #64748b;
      font-weight: 600;
      min-height: 1em;
    }

    .selected-class-chip-order {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      height: 18px;
      width: 18px;
      height: 18px;
      border-radius: 50%;
      background: #0f5a66;
      color: #fff;
      font-size: 11px;
      font-weight: 700;
    }

    .promotion-preview-table-wrap {
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
    }

    .preview-empty {
      text-align: center;
      color: #64748b;
      font-style: italic;
    }

    .preview-available-list {
      margin: 0;
      padding-left: 18px;
      color: #334155;
    }

    .preview-available-list li {
      margin: 0;
      padding: 0;
    }

    .promotion-preview-select {
      min-width: 190px;
    }

    .promotion-subject-picker {
      min-width: 220px;
    }

    .promotion-subject-toggle {
      width: 100%;
      text-align: left;
      background: #f8fafc;
      color: #0f2d32;
      border: 1px solid #d7dde5;
      box-shadow: none;
      border-radius: 8px;
      padding: 6px 10px;
      font-size: 0.78rem;
      font-weight: 600;
    }

    .promotion-subject-toggle:hover {
      background: #eef4f8;
      color: #0f2d32;
      transform: none;
    }

    .promotion-subject-menu {
      margin-top: 6px;
      border: 1px solid #d7dde5;
      border-radius: 8px;
      padding: 8px;
      background: #fff;
      max-height: 180px;
      overflow-y: auto;
      grid-template-columns: repeat(2, minmax(120px, 1fr));
      gap: 6px 10px;
      display: none;
    }

    .promotion-subject-menu.is-open {
      display: grid;
    }

    .promotion-subject-row {
      display: flex;
      align-items: center;
      gap: 6px;
      font-size: 0.78rem;
      color: #334155;
      margin: 0;
    }

    .promotion-subject-row input {
      margin: 0;
    }

    .muted-text {
      font-size: 12px;
      color: #64748b;
    }

    .history-card {
      border: 1px solid #e5e7eb;
      border-radius: 12px;
      background: #fff;
      box-shadow: 0 6px 18px rgba(15, 45, 50, 0.1);
      overflow: hidden;
      margin-top: 16px;
    }

    .history-card > summary {
      list-style: none;
      cursor: pointer;
      padding: 14px 16px;
      font-weight: 700;
      background: #f8fafc;
      border-bottom: 1px solid #e5e7eb;
    }

    .history-card > summary::-webkit-details-marker {
      display: none;
    }

    .history-card-content {
      padding: 10px 14px 14px;
    }

    .promotion-action-details {
      margin: 10px 0 0;
      border: 1px solid #dbe3ea;
      border-radius: 10px;
      background: #f8fbfc;
      overflow: hidden;
    }

    .promotion-action-details > summary {
      list-style: none;
      cursor: pointer;
      padding: 10px 12px;
      font-weight: 700;
      color: #0f2d32;
      background: rgba(15, 90, 102, 0.08);
    }

    .promotion-action-details > summary::-webkit-details-marker {
      display: none;
    }

    .promotion-action-details-body {
      padding: 12px;
    }

    .promotion-action-counts {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
      margin-bottom: 10px;
    }

    .promotion-action-count-chip {
      display: inline-flex;
      align-items: center;
      padding: 6px 10px;
      border-radius: 999px;
      background: #ffffff;
      border: 1px solid #d7dde5;
      color: #0f5a66;
      font-size: 12px;
      font-weight: 700;
    }

    .promotion-action-list {
      margin: 0;
      padding-left: 18px;
      color: #334155;
      line-height: 1.5;
    }

    .promotion-action-list li + li {
      margin-top: 6px;
    }

    .promotion-history-note {
      font-size: 12px;
      color: #64748b;
      margin-top: 8px;
      line-height: 1.45;
    }

    .submit-row {
      display: flex;
      justify-content: flex-end;
      margin-top: 10px;
    }

    #submitPromotionBtn {
      min-width: 180px;
    }

    @media (max-width: 768px) {
      .promo-hero { padding: 30px 16px 22px; }
      .promo-hero p { font-size: 0.86rem; margin-bottom: 12px; }
      .promotion-page {
        padding: 18px 14px 26px;
      }

      .promotion-class-section-head {
        flex-wrap: wrap;
        align-items: flex-start;
      }

      .promotion-class-section-title {
        white-space: normal;
      }

      .promotion-class-section-head-right {
        width: 100%;
        justify-content: flex-start;
      }

      .form-grid {
        grid-template-columns: 1fr;
      }

      table {
        font-size: 13px;
      }

      th, td {
        padding: 10px 8px;
      }

      .promotion-table-actions {
        flex-direction: column;
      }
    }

    @media (max-width: 480px) {
      .promo-hero { padding: 24px 14px 18px; }
      .promo-back-btn { font-size: 0.76rem; margin-bottom: 12px; padding: 5px 11px; }
      .promo-hero p { font-size: 0.8rem; }
      .promo-chip { font-size: 0.72rem; padding: 5px 10px; }
      .promotion-page { padding: 12px 10px 20px; }
      h2 { font-size: 1.2rem; margin-bottom: 8px; }
      h3 { font-size: 0.98rem; margin-bottom: 8px; }
      .card { padding: 14px 12px; border-radius: 10px; }
      .form-card { padding: 14px 12px; border-radius: 10px; }
      .form-card h3 { font-size: 1rem; }
      button { padding: 8px 12px; font-size: 0.88rem; }
      label { font-size: 0.88rem; }
      select, input[type="date"], input[type="time"] { font-size: 0.88rem; padding: 8px 10px; }
      .mode-option { padding: 6px 10px; font-size: 0.85rem; }
      table { font-size: 0.8rem; }
      th, td { padding: 8px 6px; }
      .history-card > summary { padding: 11px 13px; font-size: 0.9rem; }
      .history-card-content { padding: 8px 10px 12px; }
      #instructions-container { padding: 14px; }
      #instructions-container p { font-size: 0.88rem; }
      .promotion-subject-menu {
        grid-template-columns: 1fr;
      }
    }
  </style>
</head>
<body>
  <main>
  <link rel="stylesheet" href="/css/manage.css" />
  <div class="promotion-page ws-root ws-promo">
  <header class="ws-head">
    <div class="ws-head__text">
      <h1 class="ws-head__title">Promotion</h1>
      <p class="ws-head__sub">Move students to their next class for a new school year or term.<% if (currentSchoolYear || currentTerm) { %> Current: <%= currentSchoolYear?.label || '—' %> · <%= currentTerm?.term_name || '—' %>.<% } %></p>
    </div>
    <div class="ws-head__actions">
      <button type="button" class="ws-btn ws-btn--primary" id="wsPlanBtn" onclick="showForm()">Plan a promotion</button>
    </div>
  </header>
  <%- include('../partials/flash') %>

  <details class="ws-info" id="instructions-container">
    <summary>Before you start</summary>
    <div class="ws-info__body">
      <p>Promotions move students from one class to another. First save any promotion or repeat decisions on the report card.</p>
      <p>To do that, open <a href="/print/reportSettings" target="_blank">Report and promotion settings</a>, pick the school year and term, then update the report card or settings.</p>
    </div>
  </details>

<!-- Form container (hidden initially) -->
<div id="form-container" style="display: none;">
  <form method="POST" action="/promotion/schedule" class="form-card">
    <h3>Plan Promotion</h3>
    <div class="intro-grid muted-text">
      <span>Promotion can only run from the current school year to the current or future school years.</span>
    </div>

    <input type="hidden" name="applyMode" id="applyModeInput" value="scheduleLater">

    <div class="form-grid">
      <div class="form-group">
        <label for="fromSchoolYearId">Promoting From School Year</label>
        <select name="fromSchoolYearId" id="fromSchoolYearId" required>
          <option value="">Select</option>
          <% allYears.forEach(year => { %>
            <option value="<%= year.school_year_id %>"><%= year.label %></option>
          <% }) %>
        </select>
      </div>

      <div class="form-group">
        <label for="fromTermId">Promoting From Term</label>
        <select name="fromTermId" id="fromTermId" required>
          <option value="">Select</option>
          <% allTerms.forEach(term => { %>
            <option value="<%= term.term_id %>" data-year-id="<%= term.school_year_id %>"><%= term.term_name %></option>
          <% }) %>
        </select>
      </div>

      <div class="form-group">
        <label for="targetYearId">Target School Year</label>
        <select name="targetYearId" id="targetYearId" required>
          <option value="">Select</option>
          <% allYears.forEach(year => { %>
            <option value="<%= year.school_year_id %>"><%= year.label %></option>
          <% }) %>
        </select>
      </div>

      <div class="form-group">
        <label for="targetTermId">Target Term</label>
        <select name="targetTermId" id="targetTermId" required>
          <option value="">Select</option>
          <% allTerms.forEach(term => { %>
            <option value="<%= term.term_id %>" data-year-id="<%= term.school_year_id %>"><%= term.term_name %></option>
          <% }) %>
        </select>
      </div>

      <div class="form-group full-width">
        <label>When should this happen?</label>
        <div class="mode-toggle" id="modeToggle">
          <label class="mode-option active" data-mode="scheduleLater">
            <input type="radio" name="applyModeChoice" value="scheduleLater" checked>
            Schedule Promotion
          </label>
          <label class="mode-option" data-mode="applyNow">
            <input type="radio" name="applyModeChoice" value="applyNow">
            Apply Now
          </label>
        </div>
      </div>

      <div class="form-group full-width" id="scheduledDateGroup">
        <label for="scheduledDate">Scheduled Date</label>
        <input type="date" name="scheduledDate" id="scheduledDate" required>
      </div>

      <div class="form-group full-width">
        <label>Classes to Apply Promotion</label>
        <div class="classes-toolbar">
          <button type="button" class="collapsible-btn" onclick="togglePromotionClassCollapsible()" style="margin-bottom: 0; max-width: 320px;">
            <span>Show/Hide Class List</span>
            <span id="promotionClassArrow" class="arrow">&#9654;</span>
          </button>
          <label class="checkbox-label" style="margin: 0; font-weight: 600;">
            <input type="checkbox" id="selectAllClasses"> Select All Classes
          </label>
        </div>
        <div id="promotionClassCollapsibleContent" class="collapsible-content promotion-class-list">
          <% allClasses.forEach(cls => { %>
            <label class="checkbox-label">
              <input type="checkbox" name="classIds[]" value="<%= cls.class_id %>" class="promotion-class-checkbox"> <%= cls.class_name %>
            </label>
          <% }) %>
        </div>

        <div class="promotion-preview-box">
          <div id="selectedClassStrip" class="selected-class-strip"></div>
          <div class="promotion-preview-meta">
            <strong>Saved Student Decisions</strong>
            <span id="promotionPreviewCount" class="muted-text">Choose a term to load saved promotion decisions.</span>
          </div>
          <div id="promotionPreviewSummary" class="promotion-preview-summary">Select source and target school year and term to preview this promotion movement.</div>
          <div class="promotion-preview-table-wrap">
            <table id="promotionPreviewTable">
              <thead>
                <tr>
                  <th>Student ID</th>
                  <th>Student</th>
                  <th>Current Class</th>
                  <th>Decision</th>
                  <th>Assigned Destination</th>
                  <th>New Class Subjects</th>
                </tr>
              </thead>
              <tbody id="promotionPreviewBody">
                <tr>
                  <td colspan="6" class="preview-empty">Choose a term to load saved promotion decisions.</td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </div>

    <div class="submit-row">
      <button type="submit" id="submitPromotionBtn" data-busy-text="Submitting...">Schedule Promotion</button>
    </div>
  </form>
</div>


  <% if (schedules && schedules.length > 0) { %>
    <details class="history-card" open>
      <summary>Promotion History (<%= schedules.length %>)</summary>
      <div class="history-card-content">
        <div style="overflow-x:auto;-webkit-overflow-scrolling:touch;">
        <table>
          <thead>
            <tr>
              <th>Date</th>
              <th>School Year & Term</th>
              <th>Classes</th>
              <th>Status</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody>
            <% schedules.forEach((schedule, index) => { %>
              <tr class="promotion-schedule-row <%= index >= 5 ? 'extra-schedule' : '' %>" style="<%= index >= 5 ? 'display: none;' : '' %>">
                <td><%= new Date(schedule.scheduled_date).toLocaleDateString() %></td>
                <td>
                  <%= allYears.find(y => y.school_year_id == schedule.target_school_year_id)?.label || 'Unknown Year' %> -
                  <%= allTerms.find(t => t.term_id == schedule.target_term_id)?.term_name || 'Unknown Term' %>
                </td>
                <td><%= schedule.classes.length ? schedule.classes.join(', ') : 'None' %></td>
                <td>
                  <% const _tone = { completed: 'green', scheduled: 'brand', failed: 'red', applying: 'amber' }[schedule.status] || ''; %>
                  <span class="ws-pill<%= _tone ? ' ws-pill--' + _tone : '' %>"><%= String(schedule.status || '').charAt(0).toUpperCase() + String(schedule.status || '').slice(1) %></span>
                  <% if (schedule.status === 'failed' && schedule.last_error) { %>
                    <div class="promotion-history-note" style="margin-top:4px;color:#b3261e;">
                      <%= schedule.last_error %>
                      <% if (schedule.failed_at) { %>
                        (failed <%= new Date(schedule.failed_at).toLocaleString() %>)
                      <% } %>
                    </div>
                  <% } %>
                </td>
                <td class="promotion-table-actions">
                  <% if (schedule.status === 'scheduled') { %>
                    <form method="POST" action="/promotion/applyNow" style="display:inline;">
                      <input type="hidden" name="scheduleId" value="<%= schedule.id %>">
                      <button type="submit" data-busy-text="Applying..." onclick="return confirm('Apply this promotion now? Students will be moved to their new classes immediately.');">Apply Now</button>
                    </form>
                    <form method="POST" action="/promotion/cancel" style="display:inline;">
                      <input type="hidden" name="scheduleId" value="<%= schedule.id %>">
                      <button type="submit" class="btn-cancel" data-busy-text="Cancelling...">Cancel</button>
                    </form>
                  <% } %>
                  <% if (schedule.canReverseExact && (new Date() - new Date(schedule.scheduled_date)) <= 15*24*60*60*1000) { %>
                    <form method="POST" action="/promotion/reverse" style="display:inline;">
                      <input type="hidden" name="scheduleId" value="<%= schedule.id %>">
                      <button type="submit" class="btn-reverse" data-busy-text="Reversing..." onclick="return confirm('Reverse this promotion? This will undo the enrollments, classes, and subjects it created.');">Reverse</button>
                    </form>
                  <% } %>
                  <% if (schedule.status === 'reversed') { %>
                    <form method="POST" action="/promotion/deleteReversed" style="display:inline;">
                      <input type="hidden" name="scheduleId" value="<%= schedule.id %>">
                      <button type="submit" class="btn-cancel" data-busy-text="Deleting...">Delete</button>
                    </form>
                  <% } %>
                </td>
              </tr>
              <tr class="promotion-schedule-row <%= index >= 5 ? 'extra-schedule' : '' %>" style="<%= index >= 5 ? 'display: none;' : '' %>">
                <td colspan="5" style="background:#fbfdff;">
                  <details class="promotion-action-details">
                    <summary>What this promotion did</summary>
                    <div class="promotion-action-details-body">
                      <% if (schedule.auditTrail && schedule.auditTrail.available) { %>
                        <div class="promotion-action-counts">
                          <span class="promotion-action-count-chip">Enrollments created: <%= schedule.auditTrail.counts.enrollmentsCreated %></span>
                          <span class="promotion-action-count-chip">Classes attached: <%= schedule.auditTrail.counts.classesAttached %></span>
                          <span class="promotion-action-count-chip">Students enrolled: <%= schedule.auditTrail.counts.studentsEnrolled %></span>
                          <span class="promotion-action-count-chip">Subjects added: <%= schedule.auditTrail.counts.subjectsAdded %></span>
                        </div>
                        <ol class="promotion-action-list">
                          <% schedule.auditTrail.actions.forEach((action) => { %>
                            <li><%= action.details && action.details.message ? action.details.message : action.actionType %></li>
                          <% }) %>
                        </ol>
                        <% if (schedule.status === 'completed' && !schedule.canReverseExact) { %>
                          <div class="promotion-history-note">Exact reverse is unavailable for this record.</div>
                        <% } %>
                      <% } else { %>
                        <% if (schedule.status === 'failed') { %>
                          <div class="promotion-history-note">
                            <% if (schedule.last_error) { %>
                              This promotion failed: <strong><%= schedule.last_error %></strong><% if (schedule.failed_at) { %> (at <%= new Date(schedule.failed_at).toLocaleString() %>)<% } %>.
                            <% } else { %>
                              This promotion failed before detailed error capture was added to this system, so no error message was recorded for it. New failed promotions will show the exact reason here.
                            <% } %>
                          </div>
                        <% } else { %>
                          <div class="promotion-history-note">Detailed action audit is unavailable for this older promotion record. New promotions will record every action so Reverse can undo exactly what was done.</div>
                        <% } %>
                      <% } %>
                    </div>
                  </details>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
        </div><!-- /overflow-x scroll wrapper -->

        <% if (schedules.length > 5) { %>
          <div style="text-align: center; margin-top: 10px;">
            <button type="button" id="toggleMoreButton" onclick="toggleMoreSchedules()">Show More</button>
          </div>
        <% } %>
      </div>
    </details>
  <% } else { %>
    <p style="text-align:center; margin-top:20px;">No promotion history yet.</p>
  <% } %>
  <br>
  </div>
  
  <script>
  // Wrapped in an IIFE so top-level declarations never leak to the global
  // scope. This makes the page safe to re-run on every SPA navigation
  // (re-declaring a top-level `const` in global scope would throw and break
  // the whole page on the second visit). Handlers referenced by inline
  // onclick attributes are explicitly exposed on `window`.
  (function () {
    const currentSchoolYearId = <%= currentSchoolYear?.school_year_id || 0 %>;
    const currentTermId = <%= currentTerm?.term_id || 0 %>;
    let promotionClassSelectionOrder = [];

    function escapeHtml(value) {
      return String(value == null ? '' : value)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#39;');
    }

    function getSelectedPromotionClassIds() {
      return promotionClassSelectionOrder.filter(Number.isFinite);
    }

    function getClassNameById(classId) {
      const checkbox = document.querySelector(`.promotion-class-checkbox[value="${String(classId)}"]`);
      const label = checkbox && checkbox.closest('.checkbox-label');
      if (!label) return `Class ${classId}`;
      return label.textContent.replace(/\s+/g, ' ').trim();
    }

    function syncPromotionClassSelectionOrder() {
      const checkedIds = Array.from(document.querySelectorAll('.promotion-class-checkbox:checked'))
        .map((checkbox) => Number(checkbox.value))
        .filter(Number.isFinite);
      const stillChecked = promotionClassSelectionOrder.filter((id) => checkedIds.includes(id));
      const newlyChecked = checkedIds.filter((id) => !stillChecked.includes(id));
      promotionClassSelectionOrder = [...stillChecked, ...newlyChecked];
    }

    function renderSelectedClassStrip() {
      const strip = document.getElementById('selectedClassStrip');
      if (!strip) return;

      if (promotionClassSelectionOrder.length === 0) {
        strip.innerHTML = '<span class="muted-text">Select one or more classes above to load saved student decisions.</span>';
        return;
      }

      strip.innerHTML = promotionClassSelectionOrder.map((classId, index) => `
        <span class="selected-class-chip">
          <span class="selected-class-chip-order">${index + 1}</span>
          ${escapeHtml(getClassNameById(classId))}
        </span>
      `).join('');
    }

    function sortStudentsBySelectedClassOrder(students) {
      if (!Array.isArray(students) || promotionClassSelectionOrder.length === 0) {
        return Array.isArray(students) ? students : [];
      }

      const orderMap = new Map(promotionClassSelectionOrder.map((classId, index) => [Number(classId), index]));
      return [...students].sort((left, right) => {
        const leftOrder = orderMap.has(Number(left.currentClassId)) ? orderMap.get(Number(left.currentClassId)) : Number.MAX_SAFE_INTEGER;
        const rightOrder = orderMap.has(Number(right.currentClassId)) ? orderMap.get(Number(right.currentClassId)) : Number.MAX_SAFE_INTEGER;
        if (leftOrder !== rightOrder) return leftOrder - rightOrder;
        const leftName = String(left.studentName || '');
        const rightName = String(right.studentName || '');
        return leftName.localeCompare(rightName);
      });
    }

    function renderPromotionPreviewMessage(message) {
      const previewBody = document.getElementById('promotionPreviewBody');
      const previewCount = document.getElementById('promotionPreviewCount');
      if (previewBody) {
        previewBody.innerHTML = `<tr><td colspan="6" class="preview-empty">${escapeHtml(message)}</td></tr>`;
      }
      if (previewCount) {
        previewCount.textContent = message;
      }
      renderSelectedClassStrip();
    }

    function getSelectedOptionText(selectId, fallback) {
      const select = document.getElementById(selectId);
      if (!select) return fallback;
      const selectedOption = select.options[select.selectedIndex];
      const value = selectedOption && selectedOption.value ? selectedOption.textContent.trim() : '';
      return value || fallback;
    }

    function renderPromotionPreviewSummary() {
      const summary = document.getElementById('promotionPreviewSummary');
      if (!summary) return;

      const fromYear = getSelectedOptionText('fromSchoolYearId', 'source school year');
      const fromTerm = getSelectedOptionText('fromTermId', 'source term');
      const targetYear = getSelectedOptionText('targetYearId', 'target school year');
      const targetTerm = getSelectedOptionText('targetTermId', 'target term');

      summary.textContent = `Moving students from ${fromYear} / ${fromTerm} to ${targetYear} / ${targetTerm}.`;
    }

    function getClassSectionRoot(classId) {
      return document.querySelector(`.promotion-class-section[data-class-id="${String(classId)}"]`);
    }

    function updateClassDirtyState(classId) {
      const root = getClassSectionRoot(classId);
      if (!root) return;
      const selects = Array.from(root.querySelectorAll('.promotion-preview-select'));
      const hasClassChanges = selects.some((select) => String(select.value) !== String(select.dataset.originalValue || ''));
      const hasSubjectChanges = root.querySelectorAll('.promotion-subject-picker[data-subject-dirty="1"]').length > 0;
      const hasChanges = hasClassChanges || hasSubjectChanges;
      const saveBtn = root.querySelector('.promotion-class-save-btn');
      const status = root.querySelector('.promotion-class-save-status');
      if (saveBtn) {
        saveBtn.disabled = !hasChanges;
      }
      if (status && !hasChanges && status.dataset.state !== 'saved') {
        status.textContent = '';
        status.dataset.state = 'idle';
      }
    }

    async function savePromotionClassDecisions(classId) {
      const root = getClassSectionRoot(classId);
      const fromTermSelect = document.getElementById('fromTermId');
      if (!root || !fromTermSelect || !fromTermSelect.value) return;

      const selects = Array.from(root.querySelectorAll('.promotion-preview-select'));
      const changedSelects = selects.filter((select) => String(select.value) !== String(select.dataset.originalValue || ''));
      const subjectPickers = Array.from(root.querySelectorAll('.promotion-subject-picker'));
      const saveBtn = root.querySelector('.promotion-class-save-btn');
      const status = root.querySelector('.promotion-class-save-status');

      const changedSubjectPickers = subjectPickers.filter((picker) => picker.dataset.subjectDirty === '1');

      if (!changedSelects.length && !changedSubjectPickers.length) {
        if (saveBtn) saveBtn.disabled = true;
        return;
      }

      const overrides = changedSelects.reduce((accumulator, select) => {
        const studentId = Number(select.dataset.studentId);
        const classValue = Number(select.value);
        if (Number.isFinite(studentId) && Number.isFinite(classValue)) {
          accumulator[studentId] = classValue;
        }
        return accumulator;
      }, {});

      const subjectSelections = {};
      const touchedStudentIds = [];
      subjectPickers.forEach((picker) => {
        const studentId = Number(picker.dataset.studentId);
        const assignedClass = Number(picker.dataset.assignedClassId || 0);
        if (!Number.isFinite(studentId) || !Number.isFinite(assignedClass)) return;
        const classSubjectMap = JSON.parse(picker.dataset.classSubjects || '{}');
        const selectedByClass = JSON.parse(picker.dataset.selectedByClass || '{}');
        const selected = Array.isArray(selectedByClass[String(assignedClass)])
          ? selectedByClass[String(assignedClass)].map(Number).filter(Number.isFinite)
          : [];
        const allowed = Array.isArray(classSubjectMap[String(assignedClass)])
          ? classSubjectMap[String(assignedClass)].map((subject) => Number(subject.subjectId)).filter(Number.isFinite)
          : [];

        subjectSelections[studentId] = selected.filter((subjectId) => allowed.includes(subjectId));
        touchedStudentIds.push(studentId);
      });

      if (saveBtn) {
        saveBtn.dataset.originalHtml = saveBtn.innerHTML;
        saveBtn.disabled = true;
        saveBtn.classList.add('is-busy');
        saveBtn.innerHTML = '<span class="btn-spinner" aria-hidden="true"></span>Saving';
      }
      if (status) {
        status.textContent = 'Saving...';
        status.dataset.state = 'saving';
      }

      try {
        const response = await fetch('/promotion/preview/save', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'Accept': 'application/json',
          },
          body: JSON.stringify({
            termId: Number(fromTermSelect.value),
            overrides,
            subjectSelections,
            touchedStudentIds,
          }),
        });
        const result = await response.json();
        if (!response.ok || !result.success) {
          throw new Error(result.error || 'Failed to save changes.');
        }

        changedSelects.forEach((select) => {
          select.dataset.originalValue = String(select.value);
        });
        subjectPickers.forEach((picker) => {
          picker.dataset.subjectDirty = '0';
          picker.dataset.originalAssignedClassId = picker.dataset.assignedClassId || '';
          picker.dataset.originalSelectedByClass = picker.dataset.selectedByClass || '{}';
        });
        if (status) {
          status.textContent = 'Saved';
          status.dataset.state = 'saved';
        }
        if (saveBtn) {
          saveBtn.classList.remove('is-busy');
          saveBtn.innerHTML = saveBtn.dataset.originalHtml || 'Save';
        }
        updateClassDirtyState(classId);
      } catch (error) {
        if (status) {
          status.textContent = error.message || 'Failed to save changes.';
          status.dataset.state = 'error';
        }
        if (saveBtn) {
          saveBtn.classList.remove('is-busy');
          saveBtn.innerHTML = saveBtn.dataset.originalHtml || 'Save';
          saveBtn.disabled = false;
        }
        throw error;
      }
    }

    function renderPromotionPreviewRows(classGroups) {
      const previewBody = document.getElementById('promotionPreviewBody');
      const previewCount = document.getElementById('promotionPreviewCount');
      if (!previewBody) return;

      if (!Array.isArray(classGroups) || classGroups.length === 0) {
        renderPromotionPreviewMessage('No saved promotion decisions found for the selected term and classes.');
        return;
      }

      const selectedGroupOrder = sortStudentsBySelectedClassOrder(classGroups.map((group) => ({ currentClassId: group.classId, studentName: '', group })))
        .map((entry) => entry.group);

      const totalSavedStudents = selectedGroupOrder.reduce((sum, group) => sum + Number(group.savedStudents || 0), 0);

      previewBody.innerHTML = selectedGroupOrder.map((group) => {
        const headerRow = `
          <tr>
            <td colspan="6" style="padding: 0; border: none; background: transparent;">
              <div class="promotion-class-section" data-class-id="${Number(group.classId)}">
                <div class="promotion-class-section-head">
                  <div class="promotion-class-section-title">Results For Class: ${escapeHtml(group.className)}</div>
                  <div class="promotion-class-section-head-right">
                    <div class="promotion-class-section-meta">Saved ${Number(group.savedStudents || 0)} of ${Number(group.totalStudents || 0)} student${Number(group.totalStudents || 0) === 1 ? '' : 's'}</div>
                    <span class="promotion-class-save-status" data-state="idle"></span>
                    <button type="button" class="promotion-class-save-btn" data-class-id="${Number(group.classId)}" disabled>Save</button>
                  </div>
                </div>
                ${group.state !== 'saved' || Number(group.savedStudents || 0) < Number(group.totalStudents || 0) ? `
                  <div class="promotion-class-section-message">
                    ${escapeHtml(group.message || '')}
                    ${group.state === 'unsaved' || group.state === 'partial' ? ` <a href="${escapeHtml(group.reportUrl)}" target="_blank">Click here to edit and save the report for this class.</a>` : ''}
                  </div>
                ` : ''}
                ${Array.isArray(group.students) && group.students.length > 0 ? `
                  <div class="promotion-preview-table-wrap">
                    <table style="margin: 0; border: none; box-shadow: none; border-radius: 0;">
                      <thead>
                        <tr>
                          <th>Student ID</th>
                          <th>Student</th>
                          <th>Current Class</th>
                          <th>Decision</th>
                          <th>Assigned Destination</th>
                          <th>New Class Subjects</th>
                        </tr>
                      </thead>
                      <tbody>
                        ${group.students.map((student) => {
                          const options = Array.isArray(student.availableOptions) ? student.availableOptions : [];
                          const selectOptions = options.map((option) => `<option value="${Number(option.classId)}" ${Number(option.classId) === Number(student.assignedClassId) ? 'selected' : ''}>${escapeHtml(option.className)} (${escapeHtml(option.label)})</option>`).join('');
                          const classSubjectOptions = student.classSubjectOptions && typeof student.classSubjectOptions === 'object'
                            ? student.classSubjectOptions
                            : {};
                          const selectedSubjectIds = Array.isArray(student.selectedSubjectIds)
                            ? student.selectedSubjectIds.map((value) => Number(value)).filter(Number.isFinite)
                            : [];
                          const selectedByClass = {
                            [String(Number(student.assignedClassId))]: selectedSubjectIds,
                          };

                          return `
                            <tr>
                              <td>${escapeHtml(student.displayStudentIdText || '')}</td>
                              <td>${escapeHtml(student.studentName)}</td>
                              <td>${escapeHtml(student.currentClassName)}</td>
                              <td>${escapeHtml(student.promotionStatus)}</td>
                              <td>
                                <select class="promotion-preview-select" data-student-id="${Number(student.studentId)}" data-original-value="${Number(student.assignedClassId)}">
                                  ${selectOptions}
                                </select>
                              </td>
                              <td>
                                <div
                                  class="promotion-subject-picker"
                                  data-student-id="${Number(student.studentId)}"
                                  data-assigned-class-id="${Number(student.assignedClassId)}"
                                  data-original-assigned-class-id="${Number(student.assignedClassId)}"
                                  data-class-subjects='${escapeHtml(JSON.stringify(classSubjectOptions))}'
                                  data-selected-by-class='${escapeHtml(JSON.stringify(selectedByClass))}'
                                  data-original-selected-by-class='${escapeHtml(JSON.stringify(selectedByClass))}'
                                  data-subject-dirty="0"
                                >
                                  <button type="button" class="promotion-subject-toggle">Subjects</button>
                                  <div class="promotion-subject-menu"></div>
                                </div>
                              </td>
                            </tr>
                          `;
                        }).join('')}
                      </tbody>
                    </table>
                  </div>
                ` : ''}
              </div>
            </td>
          </tr>
        `;

        return headerRow;
      }).join('');

      if (previewCount) {
        previewCount.textContent = `${totalSavedStudents} saved student decision${totalSavedStudents === 1 ? '' : 's'} loaded across ${selectedGroupOrder.length} selected class${selectedGroupOrder.length === 1 ? '' : 'es'}.`;
      }

      renderPromotionPreviewSummary();
      renderSelectedClassStrip();
      hydratePromotionSubjectPickers();
    }

    function markSubjectPickerDirty(picker) {
      if (!picker) return;
      const originalClassId = String(picker.dataset.originalAssignedClassId || '');
      const currentClassId = String(picker.dataset.assignedClassId || '');
      const originalSelectedByClass = JSON.parse(picker.dataset.originalSelectedByClass || '{}');
      const selectedByClass = JSON.parse(picker.dataset.selectedByClass || '{}');
      const originalList = Array.isArray(originalSelectedByClass[currentClassId])
        ? originalSelectedByClass[currentClassId].map(Number).filter(Number.isFinite).sort((a, b) => a - b)
        : [];
      const currentList = Array.isArray(selectedByClass[currentClassId])
        ? selectedByClass[currentClassId].map(Number).filter(Number.isFinite).sort((a, b) => a - b)
        : [];
      const changedClass = originalClassId !== currentClassId;
      const changedSubjects = JSON.stringify(originalList) !== JSON.stringify(currentList);
      picker.dataset.subjectDirty = changedClass || changedSubjects ? '1' : '0';
    }

    function renderSubjectPickerMenu(picker) {
      const menu = picker.querySelector('.promotion-subject-menu');
      const toggle = picker.querySelector('.promotion-subject-toggle');
      if (!menu || !toggle) return;

      const classId = String(Number(picker.dataset.assignedClassId || 0));
      const studentId = Number(picker.dataset.studentId || 0);
      const classSubjects = JSON.parse(picker.dataset.classSubjects || '{}');
      const selectedByClass = JSON.parse(picker.dataset.selectedByClass || '{}');
      const subjects = Array.isArray(classSubjects[classId]) ? classSubjects[classId] : [];
      let selected = Array.isArray(selectedByClass[classId])
        ? selectedByClass[classId].map(Number).filter(Number.isFinite)
        : subjects.map((subject) => Number(subject.subjectId)).filter(Number.isFinite);

      selected = selected.filter((subjectId) => subjects.some((subject) => Number(subject.subjectId) === subjectId));
      selectedByClass[classId] = selected;
      picker.dataset.selectedByClass = JSON.stringify(selectedByClass);

      toggle.textContent = `Subjects (${selected.length}/${subjects.length})`;

      if (!subjects.length) {
        menu.innerHTML = '<div class="muted-text">No subjects are assigned to this class.</div>';
        markSubjectPickerDirty(picker);
        return;
      }

      menu.innerHTML = subjects.map((subject) => {
        const subjectId = Number(subject.subjectId);
        const checked = selected.includes(subjectId) ? 'checked' : '';
        return `
          <label class="promotion-subject-row">
            <input type="checkbox" class="promotion-subject-checkbox" data-subject-id="${subjectId}" value="${subjectId}" ${checked}>
            <span>${escapeHtml(subject.subjectName || `Subject ${subjectId}`)}</span>
          </label>
        `;
      }).join('');

      markSubjectPickerDirty(picker);
    }

    function hydratePromotionSubjectPickers() {
      document.querySelectorAll('.promotion-subject-picker').forEach((picker) => {
        renderSubjectPickerMenu(picker);
      });
    }

    async function loadPromotionPreview() {
      const fromTermSelect = document.getElementById('fromTermId');
      if (!fromTermSelect || !fromTermSelect.value) {
        renderPromotionPreviewSummary();
        renderPromotionPreviewMessage('Choose a term to load saved promotion decisions.');
        return;
      }

      const selectedClassIds = getSelectedPromotionClassIds();
      if (selectedClassIds.length === 0) {
        renderPromotionPreviewSummary();
        renderPromotionPreviewMessage('Select one or more classes above to show students saved for those classes.');
        return;
      }

      const searchParams = new URLSearchParams({ termId: fromTermSelect.value });
      searchParams.set('classIds', selectedClassIds.join(','));

      renderPromotionPreviewMessage('Loading saved promotion decisions...');

      try {
        const response = await fetch(`/promotion/preview?${searchParams.toString()}`, {
          headers: { 'Accept': 'application/json' }
        });
        const result = await response.json();
        if (!response.ok || !result.success) {
          throw new Error(result.error || 'Failed to load saved promotion decisions.');
        }
        renderPromotionPreviewRows(result.classes || []);
      } catch (error) {
        renderPromotionPreviewMessage(error.message || 'Failed to load saved promotion decisions.');
      }
    }

    function keepCurrentAndFutureYears() {
      ['fromSchoolYearId', 'targetYearId'].forEach(id => {
        const select = document.getElementById(id);
        if (!select) return;
        select.querySelectorAll('option').forEach(opt => {
          if (!opt.value) return;
          const yearId = Number(opt.value);
          // Use `hidden` instead of style.display — Chrome ignores
          // display:none on <option> elements.
          opt.hidden = yearId < Number(currentSchoolYearId);
        });
      });
    }

    function syncTermOptions(yearSelectId, termSelectId) {
      const yearSelect = document.getElementById(yearSelectId);
      const termSelect = document.getElementById(termSelectId);
      if (!yearSelect || !termSelect) return;
      const selectedYearId = yearSelect.value;

      termSelect.value = '';
      termSelect.querySelectorAll('option').forEach(opt => {
        if (!opt.value) return;
        opt.hidden = opt.dataset.yearId !== selectedYearId;
      });
    }

    function updateApplyModeUI() {
      const selectedMode = document.querySelector('input[name="applyModeChoice"]:checked')?.value || 'scheduleLater';
      const applyModeInput = document.getElementById('applyModeInput');
      const submitBtn = document.getElementById('submitPromotionBtn');
      const dateGroup = document.getElementById('scheduledDateGroup');
      const dateInput = document.getElementById('scheduledDate');
      if (!applyModeInput || !submitBtn || !dateGroup) return;

      applyModeInput.value = selectedMode;
      document.querySelectorAll('.mode-option').forEach(el => {
        el.classList.toggle('active', el.dataset.mode === selectedMode);
      });

      if (selectedMode === 'applyNow') {
        submitBtn.textContent = 'Apply Now';
        submitBtn.dataset.busyText = 'Applying...';
        dateGroup.style.display = 'none';
        if (dateInput) dateInput.required = false;
      } else {
        submitBtn.textContent = 'Schedule Promotion';
        submitBtn.dataset.busyText = 'Scheduling...';
        dateGroup.style.display = 'block';
        if (dateInput) dateInput.required = true;
      }
    }

    // ── Handlers used by inline onclick attributes (must be global) ──
    window.togglePromotionClassCollapsible = function () {
      const content = document.getElementById('promotionClassCollapsibleContent');
      const arrow = document.getElementById('promotionClassArrow');
      if (!content || !arrow) return;
      content.classList.toggle('active');
      arrow.classList.toggle('expanded', content.classList.contains('active'));
    };

    window.showForm = function () {
      const instructions = document.getElementById('instructions-container');
      const formContainer = document.getElementById('form-container');
      if (instructions) instructions.style.display = 'none';
      if (formContainer) formContainer.style.display = 'block';
      const planBtn = document.getElementById('wsPlanBtn');
      if (planBtn) planBtn.hidden = true;
    };

    window.toggleMoreSchedules = function () {
      const extraRows = document.querySelectorAll('.extra-schedule');
      const button = document.getElementById('toggleMoreButton');
      extraRows.forEach(row => row.style.display = (row.style.display === 'none' ? 'table-row' : 'none'));
      if (button) button.textContent = button.textContent === 'Show More' ? 'Show Less' : 'Show More';
    };

    // ── Initialization ──
    keepCurrentAndFutureYears();

    const fromSchoolYearSelect = document.getElementById('fromSchoolYearId');
    const fromTermSelect = document.getElementById('fromTermId');
    const targetYearSelect = document.getElementById('targetYearId');
    const allClassCheckboxes = document.querySelectorAll('.promotion-class-checkbox');
    const selectAllClasses = document.getElementById('selectAllClasses');
    const form = document.querySelector('#form-container form');
    const dateInput = document.getElementById('scheduledDate');
    const classCollapsibleContent = document.getElementById('promotionClassCollapsibleContent');
    const classArrow = document.getElementById('promotionClassArrow');

    if (currentSchoolYearId && fromSchoolYearSelect && targetYearSelect) {
      fromSchoolYearSelect.value = String(currentSchoolYearId);
      targetYearSelect.value = String(currentSchoolYearId);
    }

    if (currentTermId && fromTermSelect) {
      const currentTermOption = Array.from(fromTermSelect.options).find((option) => Number(option.value) === Number(currentTermId));
      if (currentTermOption) {
        fromTermSelect.value = String(currentTermId);
      }
    }

    syncTermOptions('fromSchoolYearId', 'fromTermId');
    syncTermOptions('targetYearId', 'targetTermId');

    if (currentTermId && fromTermSelect) {
      const currentTermOption = Array.from(fromTermSelect.options).find((option) => Number(option.value) === Number(currentTermId) && !option.hidden);
      if (currentTermOption) {
        fromTermSelect.value = String(currentTermId);
      }
    }

    if (classCollapsibleContent && classArrow) {
      classArrow.classList.toggle('expanded', classCollapsibleContent.classList.contains('active'));
    }

    if (fromSchoolYearSelect) {
      fromSchoolYearSelect.addEventListener('change', function () {
        syncTermOptions('fromSchoolYearId', 'fromTermId');
        loadPromotionPreview();
      });
    }

    if (fromTermSelect) {
      fromTermSelect.addEventListener('change', loadPromotionPreview);
    }

    if (targetYearSelect) {
      targetYearSelect.addEventListener('change', function () {
        syncTermOptions('targetYearId', 'targetTermId');
        renderPromotionPreviewSummary();
      });
    }

    const targetTermSelect = document.getElementById('targetTermId');
    if (targetTermSelect) {
      targetTermSelect.addEventListener('change', renderPromotionPreviewSummary);
    }

    document.addEventListener('change', function (event) {
      const select = event.target;
      if (!(select instanceof HTMLSelectElement) || !select.classList.contains('promotion-preview-select')) {
        return;
      }
      const root = select.closest('.promotion-class-section');
      if (!root) return;

      const row = select.closest('tr');
      const picker = row && row.querySelector('.promotion-subject-picker');
      if (picker) {
        picker.dataset.assignedClassId = String(Number(select.value));
        renderSubjectPickerMenu(picker);
      }

      const classId = Number(root.dataset.classId);
      if (!Number.isFinite(classId)) return;
      updateClassDirtyState(classId);
    });

    document.addEventListener('click', function (event) {
      const toggle = event.target.closest('.promotion-subject-toggle');
      if (!toggle) return;
      const picker = toggle.closest('.promotion-subject-picker');
      if (!picker) return;
      const menu = picker.querySelector('.promotion-subject-menu');
      if (!menu) return;
      menu.classList.toggle('is-open');
    });

    document.addEventListener('change', function (event) {
      const checkbox = event.target;
      if (!(checkbox instanceof HTMLInputElement) || !checkbox.classList.contains('promotion-subject-checkbox')) {
        return;
      }

      const picker = checkbox.closest('.promotion-subject-picker');
      if (!picker) return;

      const classId = String(Number(picker.dataset.assignedClassId || 0));
      const selectedByClass = JSON.parse(picker.dataset.selectedByClass || '{}');
      const selectedValues = Array.from(picker.querySelectorAll('.promotion-subject-checkbox:checked'))
        .map((item) => Number(item.value))
        .filter(Number.isFinite);
      selectedByClass[classId] = selectedValues;
      picker.dataset.selectedByClass = JSON.stringify(selectedByClass);

      renderSubjectPickerMenu(picker);

      const root = picker.closest('.promotion-class-section');
      const classIdNumber = root ? Number(root.dataset.classId) : NaN;
      if (Number.isFinite(classIdNumber)) {
        updateClassDirtyState(classIdNumber);
      }
    });

    document.addEventListener('click', function (event) {
      const button = event.target.closest('.promotion-class-save-btn');
      if (!button) return;
      const classId = Number(button.dataset.classId);
      if (!Number.isFinite(classId)) return;
      savePromotionClassDecisions(classId);
    });

    document.querySelectorAll('input[name="applyModeChoice"]').forEach(radio => {
      radio.addEventListener('change', updateApplyModeUI);
    });

    if (dateInput) {
      const todayIso = new Date().toISOString().split('T')[0];
      dateInput.min = todayIso;
      dateInput.value = todayIso;
    }

    updateApplyModeUI();

    if (selectAllClasses) {
      selectAllClasses.addEventListener('change', function () {
        allClassCheckboxes.forEach(cb => {
          cb.checked = this.checked;
        });
        promotionClassSelectionOrder = this.checked
          ? Array.from(allClassCheckboxes).map((checkbox) => Number(checkbox.value)).filter(Number.isFinite)
          : [];
        loadPromotionPreview();
      });
    }

    allClassCheckboxes.forEach(cb => {
      cb.addEventListener('change', function () {
        syncPromotionClassSelectionOrder();
        if (selectAllClasses) {
          selectAllClasses.checked = Array.from(allClassCheckboxes).every(c => c.checked);
        }
        loadPromotionPreview();
      });
    });

    syncPromotionClassSelectionOrder();
    renderSelectedClassStrip();
    renderPromotionPreviewSummary();
    loadPromotionPreview();

    // The per-student override/subject inputs used to be submitted as part of
    // this form directly, but a school with hundreds of students could produce
    // thousands of form fields in one submission - enough to exceed the
    // server's form field limit and crash the request. Those decisions are now
    // saved out-of-band via /promotion/preview/save (see savePromotionClassDecisions),
    // so this form only ever carries a handful of fields regardless of school
    // size. Any edits the user hasn't explicitly saved yet are flushed here
    // before the schedule/apply submission goes through.
    async function saveAllDirtyPromotionClassDecisions() {
      const classIds = Array.from(document.querySelectorAll('.promotion-class-section'))
        .map((section) => section.dataset.classId)
        .filter(Boolean);
      for (const classId of classIds) {
        await savePromotionClassDecisions(classId);
      }
    }

    if (form) {
      form.addEventListener('submit', function (e) {
        const checked = Array.from(allClassCheckboxes).some(cb => cb.checked);
        if (!checked) {
          e.preventDefault();
          alert('Please select at least one class to apply promotion.');
          return;
        }
        e.preventDefault();
        saveAllDirtyPromotionClassDecisions()
          .then(() => form.submit())
          .catch((error) => {
            alert(error && error.message ? error.message : 'Failed to save your changes before scheduling. Please try again.');
          });
      });
    }

    // Show a spinner and disable the submit button on every promotion form
    // (schedule, apply now, cancel, reverse, delete) so users get feedback
    // that their click registered instead of wondering if it worked.
    function setButtonBusy(button, busyLabel) {
      if (!button || button.classList.contains('is-busy')) return;
      button.dataset.originalHtml = button.innerHTML;
      button.classList.add('is-busy');
      button.disabled = true;
      button.innerHTML = '<span class="btn-spinner" aria-hidden="true"></span>' + busyLabel;
    }

    document.querySelectorAll('form').forEach((promotionForm) => {
      promotionForm.addEventListener('submit', function (e) {
        if (e.defaultPrevented) return;
        const submitButton = promotionForm.querySelector('button[type="submit"]');
        if (!submitButton) return;
        const busyLabel = submitButton.dataset.busyText || 'Working...';
        setButtonBusy(submitButton, busyLabel);
      });
    });
  })();
  </script>
  </main>
</body>
</html>
