<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Promotion Scheduler</title>
  <style>
      :root {
        --font-family: "Inter", sans-serif;
      }


    body {
      font-family: var(--font-family);
      background-color: #f7f7f7;
    }

    h2, h3 {
      text-align: center;
    }

    .alert-success {
      background-color: #d4edda;
      color: #155724;
      border: 1px solid #c3e6cb;
      padding: 10px;
      border-radius: 5px;
      margin-bottom: 15px;
    }

    .alert-danger {
      background-color: #f8d7da;
      color: #721c24;
      border: 1px solid #f5c6cb;
      padding: 10px;
      border-radius: 5px;
      margin-bottom: 15px;
    }

    form {
      max-width: 500px;
      margin: 20px auto;
      background: #fff;
      padding: 15px;
      border-radius: 5px;
      box-shadow: 0 0 5px rgba(0,0,0,0.1);
    }

    .form-group {
      margin-bottom: 15px;
    }

    label {
      display: block;
      margin-bottom: 5px;
      font-weight: bold;
    }

    select, input[type="date"], input[type="time"] {
      width: 100%;
      padding: 8px;
      border: 1px solid #ccc;
      border-radius: 4px;
    }

    .checkbox-label {
      display: block;
      margin-bottom: 5px;
    }

    button {
      background-color: var(--org-primary-color, #01535b);
      color: #fff;
      border: none;
      padding: 10px 15px;
      border-radius: 4px;
      cursor: pointer;
      transition: background-color 0.3s;
    }

    button:hover {
      background-color: var(--org-primary-hover, #013c44);
    }

    table {
      width: 100%;
      border-collapse: collapse;
      margin: 20px 0;
      background: #fff;
    }

    th, td {
      border: 1px solid #ddd;
      padding: 10px;
      text-align: left;
    }

    th {
      background-color: #eee;
    }

    .promotion-table-actions {
      text-align: center;
    }

    .btn-cancel {
      background-color: #dc3545;
    }

    .btn-cancel:hover {
      background-color: #b02a37;
    }

    .btn-reverse {
      background-color: #f0ad4e;
    }

    .btn-reverse:hover {
      background-color: #d08920;
    }

    #instructions-container {
      max-width: 600px;
      margin: 20px auto;
      background: #eaf4fc;
      padding: 15px;
      border-radius: 5px;
      box-shadow: 0 0 5px rgba(0,0,0,0.1);
      text-align: left;
    }

    #instructions-container p {
      margin-bottom: 15px;
      line-height: 1.5;
    }

    .collapsible-content {
      display: none;
      margin-top: 10px;
    }

    .collapsible-content.active {
      display: flex;
      flex-direction: column;
      justify-content: start;
    }

    .collapsible-btn {
      background: var(--org-primary-color, #01535b);
      color: #fff;
      border: none;
      border-radius: 5px;
      padding: 8px 18px;
      cursor: pointer;
      margin-bottom: 10px;
      transition: background 0.3s;
      display: flex;
      align-items: center;
      justify-content: space-between;
      width: 100%;
      font-size: 1rem;
    }

    .arrow {
      display: inline-block;
      margin-left: 8px;
      transition: transform 0.3s;
    }

    .arrow.expanded {
      transform: rotate(90deg);
    }
  </style>
</head>
<body>
  <h2>Promotion Scheduler</h2>
  <%- include('../partials/flash') %>

  <h3>Current School Year: <%= currentSchoolYear?.label %></h3>
  <h3>Current Term: <%= currentTerm?.term_name %></h3>

  <!-- Instructions container (shown initially) -->
  <div id="instructions-container">
    <h3>Instructions</h3>
    <p>
      This page schedules student promotions from one class to another. Before proceeding, ensure all promotion and repetition changes are saved in the report card.
    </p>
    <p>
      <strong>To save changes:</strong> Visit the <a href="/common/closeSchoolYear" target="_blank" style="color: var(--org-primary-color, #01535b); text-decoration: underline;">Promotion and Report Settings</a> page, select your school year and term, then update the report card or settings as needed.
    </p>
    
    <button onclick="showForm()">Continue</button>
  </div>

<!-- Form container (hidden initially) -->
<div id="form-container" style="display: none;">
  <form method="POST" action="/promotion/schedule">
    <h3>Schedule New Promotion</h3>

<!-- From School Year -->
<div class="form-group">
  <label for="fromSchoolYearId">Promoting From School Year</label>
  <select name="fromSchoolYearId" id="fromSchoolYearId" required>
    <option value="">Select</option>
    <% allYears.forEach(year => { %>
      <option value="<%= year.school_year_id %>"><%= year.label %></option>
    <% }) %>
  </select>
</div>

<!-- From Term -->
<div class="form-group">
  <label for="fromTermId">Promoting From Term</label>
  <select name="fromTermId" id="fromTermId" required>
    <option value="">Select</option>
    <% allTerms.forEach(term => { %>
      <option value="<%= term.term_id %>" data-year-id="<%= term.school_year_id %>"><%= term.term_name %></option>
    <% }) %>
  </select>
</div>

<!-- Target School Year -->
<div class="form-group">
  <label for="targetYearId">Target School Year</label>
  <select name="targetYearId" id="targetYearId" required>
    <option value="">Select</option>
    <% allYears.forEach(year => { %>
      <option value="<%= year.school_year_id %>"><%= year.label %></option>
    <% }) %>
  </select>
</div>

<!-- Target Term -->
<div class="form-group">
  <label for="targetTermId">Target Term</label>
  <select name="targetTermId" id="targetTermId" required>
    <option value="">Select</option>
    <% allTerms.forEach(term => { %>
      <option value="<%= term.term_id %>" data-year-id="<%= term.school_year_id %>"><%= term.term_name %></option>
    <% }) %>
  </select>
</div>
    <!-- Date -->
    <div class="form-group">
      <label for="scheduledDate">Scheduled Date</label>
      <input type="date" name="scheduledDate" required>
    </div>

<!-- Classes -->
<div class="form-group">
  <label>Classes to Apply Promotion:</label>
  <div class="collapsible" style="margin-bottom: 10px;">
    <button type="button" class="collapsible-btn" onclick="togglePromotionClassCollapsible()">
      <span>Show/Hide Class List</span>
      <span id="promotionClassArrow" class="arrow">&#9654;</span>
    </button>
    <div id="promotionClassCollapsibleContent" class="collapsible-content">
      <% allClasses.forEach(cls => { %>
        <label class="checkbox-label">
          <input type="checkbox" name="classIds[]" value="<%= cls.class_id %>"> <%= cls.class_name %>
        </label>
      <% }) %>
    </div>
  </div>
</div>

    <button type="submit">Schedule Promotion</button>
  </form>
</div>

  <hr>

  <% if (schedules && schedules.length > 0) { %>
    <h3>Scheduled Promotions</h3>
    <table>
      <thead>
        <tr>
          <th>Date</th>
          <th>School Year & Term</th>
          <th>Classes</th>
          <th>Status</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody>
        <% schedules.forEach((schedule, index) => { %>
          <tr class="promotion-schedule-row <%= index >= 5 ? 'extra-schedule' : '' %>" style="<%= index >= 5 ? 'display: none;' : '' %>">
            <td><%= new Date(schedule.scheduled_date).toLocaleDateString() %></td>
            <td>
              <%= allYears.find(y => y.school_year_id == schedule.target_school_year_id)?.label || 'Unknown Year' %> -
              <%= allTerms.find(t => t.term_id == schedule.target_term_id)?.term_name || 'Unknown Term' %>
            </td>
            <td><%= schedule.classes.length ? schedule.classes.join(', ') : 'None' %></td>
            <td><%= schedule.status %></td>
            <td class="promotion-table-actions">
              <% if (schedule.status === 'scheduled') { %>
                <form method="POST" action="/promotion/cancel" style="display:inline;">
                  <input type="hidden" name="scheduleId" value="<%= schedule.id %>">
                  <button type="submit" class="btn-cancel">Cancel</button>
                </form>
              <% } %>
              <% if (schedule.status === 'completed' && (new Date() - new Date(schedule.scheduled_date)) <= 15*24*60*60*1000) { %>
                <form method="POST" action="/promotion/reverse" style="display:inline;">
                  <input type="hidden" name="scheduleId" value="<%= schedule.id %>">
                  <button type="submit" class="btn-reverse">Reverse</button>
                </form>
              <% } %>
              <% if (schedule.status === 'reversed') { %>
                <form method="POST" action="/promotion/deleteReversed" style="display:inline;">
                  <input type="hidden" name="scheduleId" value="<%= schedule.id %>">
                  <button type="submit" class="btn-cancel">Delete</button>
                </form>
              <% } %>
            </td>
            
          </tr>
        <% }) %>
      </tbody>
    </table>
  
    <% if (schedules.length > 5) { %>
      <div style="text-align: center; margin-top: 10px;">
        <button type="button" id="toggleMoreButton" onclick="toggleMoreSchedules()">Show More</button>
      </div>
    <% } %>
  <% } else { %>
    <p style="text-align:center; margin-top:20px;">No scheduled promotions found.</p>
  <% } %>
  <br>
  
  <script>
  function togglePromotionClassCollapsible() {
    var content = document.getElementById('promotionClassCollapsibleContent');
    var arrow = document.getElementById('promotionClassArrow');
    content.classList.toggle('active');
    arrow.classList.toggle('expanded', content.classList.contains('active'));
  }
    function showForm() {
      document.getElementById('instructions-container').style.display = 'none';
      document.getElementById('form-container').style.display = 'block';
    }
  
    document.getElementById('fromSchoolYearId').addEventListener('change', function () {
      const selectedFromYearId = this.value;
  
      // 1️⃣ Hide selected 'from' year in 'target' year dropdown
      const targetYearSelect = document.getElementById('targetYearId');
      targetYearSelect.querySelectorAll('option').forEach(opt => {
        if (opt.value === selectedFromYearId && opt.value !== '') {
          opt.style.display = 'none';
        } else {
          opt.style.display = 'block';
        }
      });
      if (targetYearSelect.value === selectedFromYearId) {
        targetYearSelect.value = '';
      }
  
      // 2️⃣ Update 'from term' to only show terms of selected year
      const fromTermSelect = document.getElementById('fromTermId');
      fromTermSelect.value = '';
      fromTermSelect.querySelectorAll('option').forEach(opt => {
        if (opt.value === '') return;
        opt.style.display = (opt.dataset.yearId === selectedFromYearId) ? 'block' : 'none';
      });
  
      // 3️⃣ Update 'target term' to exclude terms of the selected 'from' year
      const targetTermSelect = document.getElementById('targetTermId');
      targetTermSelect.value = '';
      targetTermSelect.querySelectorAll('option').forEach(opt => {
        if (opt.value === '') return;
        opt.style.display = (opt.dataset.yearId === selectedFromYearId) ? 'none' : 'block';
      });
    });
  
    function toggleMoreSchedules() {
      const extraRows = document.querySelectorAll('.extra-schedule');
      const button = document.getElementById('toggleMoreButton');
      extraRows.forEach(row => row.style.display = (row.style.display === 'none' ? 'table-row' : 'none'));
      button.textContent = button.textContent === 'Show More' ? 'Show Less' : 'Show More';
    }
  </script>
</body>
</html>
