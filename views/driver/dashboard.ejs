<%- include('../partials/flash') %>
<link rel="stylesheet" href="<%= assetUrl('/css/driverNav.css') %>" />
<link rel="preconnect" href="https://tiles.openfreemap.org" crossorigin />
<%
  var navIntegration = (typeof integration !== 'undefined' && integration) ? integration : {};
  var navApps = [{ key: 'google', label: 'Google Maps' }, { key: 'apple', label: 'Apple Maps' }];
  if (navIntegration.wazeNavActivated || navIntegration.googleMapsNavActivated) navApps.push({ key: 'waze', label: 'Waze' });
  var routeList = assignedRoutes || [];
  var activeRouteId = activeTrip && activeTrip.route_id ? String(activeTrip.route_id) : '';
  function safeJson(v) { return JSON.stringify(v === undefined ? null : v).replace(/</g, '\\u003c'); }
%>

<div class="drv" id="drv-page">
  <header class="drv-top">
    <h1>Today’s trip</h1>
    <p><%= [session.firstName, driverBus ? 'Bus ' + driverBus.bus_number : 'No bus assigned yet', driverBus && driverBus.license_plate, driverBus && driverBus.capacity ? driverBus.capacity + ' seats' : ''].filter(Boolean).join(' · ') %></p>
  </header>

  <section class="drv-card drv-trip" aria-label="Trip">
    <% if (!driverBus) { %>
      <p class="drv-empty">Your school hasn’t assigned you a bus yet. It will show here once they do.</p>
    <% } else if (!routeList.length) { %>
      <p class="drv-empty">Your school hasn’t assigned you a route yet. It will show here once they do.</p>
    <% } else { %>
      <div class="drv-trip__main">
        <% if (routeList.length > 1) { %>
          <label class="drv-label" for="drv-route-select">Route</label>
          <select id="drv-route-select" class="drv-select">
            <% routeList.forEach(function (route, idx) { %>
              <option value="<%= route.route_id %>"<%= (activeRouteId ? String(route.route_id) === activeRouteId : idx === 0) ? ' selected' : '' %>><%= route.route_name %></option>
            <% }) %>
          </select>
        <% } else { %>
          <p class="drv-label">Route</p>
          <p class="drv-routename"><%= routeList[0].route_name %></p>
        <% } %>
        <dl class="drv-facts">
          <div><dt>Stops</dt><dd id="drv-fact-stops">–</dd></div>
          <div><dt>Students</dt><dd id="drv-fact-students">–</dd></div>
          <div><dt>Distance</dt><dd id="drv-fact-distance">–</dd></div>
          <div><dt>Time</dt><dd id="drv-fact-time">–</dd></div>
        </dl>
        <button type="button" class="drv-go" id="drv-start">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true"><path d="M8 5v14l11-7z"/></svg>
          <span>Go</span>
        </button>
        <button type="button" class="drv-endtrip" id="drv-end-page" hidden>End trip</button>
        <span class="drv-live" id="drv-live" hidden><i aria-hidden="true"></i>Live</span>
        <p class="drv-note" id="drv-note" role="alert" hidden></p>
      </div>
      <div class="drv-mini" id="drv-mini" role="img" aria-label="Small map of this route"></div>
    <% } %>
  </section>

  <div class="drv-lists">
    <% if (driverBus && routeList.length) { %>
    <section class="drv-card">
      <h2>Stops <span class="drv-count" id="drv-stops-count"></span></h2>
      <ol class="drv-list" id="drv-stops-list"></ol>
    </section>
    <% } %>
    <section class="drv-card">
      <h2>Students <span class="drv-count"><%= (students || []).length %></span></h2>
      <% if (!(students || []).length) { %>
        <p class="drv-empty">No students are assigned to your bus yet.</p>
      <% } else { %>
        <ul class="drv-list">
          <% students.forEach(function (student) { %>
            <li><div>
              <strong><%= [student.first_name, student.last_name].filter(Boolean).join(' ') %></strong>
              <span class="drv-sub"><%= student.class_name || 'No class' %><% if (student.stop_name) { %> · <%= student.stop_name %><% } %></span>
            </div></li>
          <% }) %>
        </ul>
      <% } %>
    </section>
  </div>
</div>

<script type="application/json" id="drv-config"><%- safeJson({
  bus: driverBus || null,
  students: (students || []).map(function (s) { return { id: s.student_id, name: [s.first_name, s.last_name].filter(Boolean).join(' '), stopId: s.stop_id || null }; }),
  lastLocation: lastLocation || null,
  school: { lat: schoolLatitude, lng: schoolLongitude },
  routes: routeList,
  activeTrip: activeTrip || null,
  unit: distanceUnit === 'mi' ? 'mi' : 'km',
  navApps: navApps,
}) %></script>
<script src="/js/driverLocation.js?v=<%= assetVersion %>"></script>
<script src="<%= assetUrl('/js/driverNav.js') %>"></script>
