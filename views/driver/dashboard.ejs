<%- include('../partials/flash') %>
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="" />
<%
  var navIntegration = (typeof integration !== 'undefined' && integration) ? integration : {};
  var navApps = [{ key: 'google', label: 'Google Maps' }, { key: 'apple', label: 'Apple Maps' }];
  if (navIntegration.wazeNavActivated || navIntegration.googleMapsNavActivated) navApps.push({ key: 'waze', label: 'Waze' });
  var routeList = assignedRoutes || [];
  var activeRouteId = activeTrip && activeTrip.route_id ? String(activeTrip.route_id) : '';
  function safeJson(v) { return JSON.stringify(v === undefined ? null : v).replace(/</g, '\\u003c'); }
%>
<style>
  .drv { --drv-accent: var(--org-primary-color, #01535b); --drv-line: #e3e8ef; --drv-text: #0f172a; --drv-muted: #5b6b7f; --drv-blue: #1a73e8;
    max-width: 1180px; margin: 0 auto; padding: 20px 20px 88px; color: var(--drv-text); text-align: left; }
  .drv *, .drv *::before, .drv *::after { box-sizing: border-box; }
  .drv-top { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-bottom: 16px; }
  .drv-top-text { min-width: 0; }
  .drv-top h1 { margin: 0; font-size: 1.2rem; font-weight: 700; line-height: 1.3; }
  .drv-busline { margin: 2px 0 0; color: var(--drv-muted); font-size: .9rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .drv-pill { flex: none; display: inline-flex; align-items: center; gap: 8px; padding: 6px 12px; border: 1px solid var(--drv-line); border-radius: 999px; background: #fff; font-size: .85rem; font-weight: 600; white-space: nowrap; }
  .drv-pill i { width: 8px; height: 8px; border-radius: 50%; background: #98a2b3; }
  .drv-pill[data-state="live"] i { background: #12a150; }
  .drv-pill[data-state="weak"] i { background: #c27803; }
  .drv-pill[data-state="off"] i { background: #d92d20; }

  .drv-layout { display: grid; grid-template-columns: minmax(0, 1fr) 340px; gap: 16px; align-items: start; }
  .drv-card { background: #fff; border: 1px solid var(--drv-line); border-radius: 16px; }
  .drv-mapcard { overflow: hidden; padding: 0; }
  .drv-mapwrap { position: relative; height: 600px; background: #e9eef3; }
  #drv-map { position: absolute; inset: 0; z-index: 0; }
  .drv-map-msg { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; margin: 0; padding: 24px; color: var(--drv-muted); text-align: center; }
  .drv-mapwrap .leaflet-control-attribution { font-size: 10px; background: rgba(255,255,255,.8); }
  .drv-mapwrap .leaflet-bar { border: 0; border-radius: 12px; overflow: hidden; box-shadow: 0 1px 2px rgba(15,23,42,.08), 0 6px 20px rgba(15,23,42,.14); }
  .drv-mapwrap .leaflet-bar a { width: 44px; height: 44px; line-height: 44px; font-size: 20px; color: #344054; }

  .drv-next { position: absolute; z-index: 600; top: 12px; left: 12px; right: 12px; max-width: 440px; display: flex; align-items: center; gap: 14px; padding: 12px 16px; background: #fff; border-radius: 14px; box-shadow: 0 1px 2px rgba(15,23,42,.08), 0 6px 20px rgba(15,23,42,.14); }
  .drv-next[hidden] { display: none; }
  .drv-next-text { flex: 1; min-width: 0; }
  .drv-next small { display: block; font-size: .78rem; font-weight: 600; color: var(--drv-muted); }
  .drv-next strong { display: block; font-size: 1rem; line-height: 1.3; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .drv-next-dist { flex: none; text-align: right; font-variant-numeric: tabular-nums; }
  .drv-next-dist strong { font-size: 1.15rem; }

  .drv .drv-recenter { position: absolute; z-index: 600; left: 50%; bottom: 16px; transform: translateX(-50%); display: inline-flex; align-items: center; gap: 8px; width: auto !important; margin: 0 !important; padding: 11px 18px !important; border: 0; border-radius: 999px; background: #fff; color: var(--drv-blue); font: 700 .92rem/1 system-ui, sans-serif; cursor: pointer; box-shadow: 0 1px 2px rgba(15,23,42,.08), 0 6px 20px rgba(15,23,42,.18); }
  .drv .drv-recenter[hidden] { display: none; }
  .drv-touch-hint { position: absolute; inset: 0; z-index: 650; display: flex; align-items: center; justify-content: center; padding: 24px; background: rgba(15,23,42,.45); color: #fff; font-weight: 600; text-align: center; opacity: 0; pointer-events: none; transition: opacity .2s ease; }
  .drv-touch-hint.is-on { opacity: 1; }

  .drv-side { display: grid; gap: 16px; }
  .drv-card { background: #fff; border: 1px solid var(--drv-line); border-radius: 16px; padding: 18px; }
  .drv-panel { position: sticky; top: 16px; }
  .drv-empty { margin: 0; color: var(--drv-muted); font-size: .95rem; }
  .drv-label { display: block; margin: 0 0 6px; font-size: .85rem; font-weight: 600; color: var(--drv-muted); }
  .drv-select { width: 100%; min-height: 48px; margin: 0 0 12px; padding: 0 12px; border: 1px solid #cfd8e3; border-radius: 12px; background: #fff; color: var(--drv-text); font-size: 16px; }
  .drv .drv-btn { display: inline-flex; align-items: center; justify-content: center; gap: 10px; width: 100% !important; min-height: 54px; margin: 0 !important; padding: 0 16px !important; border: 0; border-radius: 14px; font: 700 1.05rem/1 system-ui, sans-serif; cursor: pointer; transition: filter .15s ease; }
  .drv .drv-btn:disabled { opacity: .6; cursor: progress; }
  .drv .drv-btn:not(:disabled):active { filter: brightness(.92); }
  .drv .drv-btn--go { background: var(--drv-accent); color: #fff; }
  .drv .drv-btn--stop { min-height: 48px; background: #fdecea; color: #b42318; font-size: .98rem; }
  .drv .drv-btn:focus-visible, .drv .drv-app:focus-visible, .drv .drv-recenter:focus-visible { outline: 2px solid var(--drv-blue); outline-offset: 2px; }
  .drv-sub { margin: 10px 0 0; font-size: .82rem; color: var(--drv-muted); }
  .drv-apps-label { margin: 0 0 8px; font-size: .82rem; font-weight: 600; color: var(--drv-muted); }
  .drv-apps { display: grid; grid-template-columns: repeat(auto-fit, minmax(90px, 1fr)); gap: 8px; margin-bottom: 16px; }
  .drv .drv-app { width: 100% !important; min-height: 44px; margin: 0 !important; padding: 0 10px !important; border: 1px solid var(--drv-line); border-radius: 12px; background: #fff; color: var(--drv-text); font: 600 .9rem/1.1 system-ui, sans-serif; cursor: pointer; }
  .drv .drv-app:active { background: #f4f6f9; }
  .drv-route-name { margin: 0 0 2px; font-size: .85rem; font-weight: 600; color: var(--drv-muted); }
  .drv-eta { display: flex; align-items: baseline; flex-wrap: wrap; gap: 4px 10px; margin-bottom: 16px; }
  .drv-eta strong { font-size: 1.6rem; font-weight: 800; letter-spacing: -.01em; font-variant-numeric: tabular-nums; }
  .drv-eta span { font-size: .9rem; color: #475467; }
  .drv-hint { margin: 12px 0 0; font-size: .8rem; color: var(--drv-muted); }
  .drv-note { margin: 12px 0 0; padding: 10px 12px; border-radius: 10px; background: #fef3f2; color: #b42318; font-size: .88rem; }
  .drv-note[hidden] { display: none; }

  .drv-students > summary { display: flex; align-items: center; justify-content: space-between; list-style: none; cursor: pointer; font-weight: 700; }
  .drv-students > summary::-webkit-details-marker { display: none; }
  .drv-students > summary::after { content: ''; width: 8px; height: 8px; border-right: 2px solid var(--drv-muted); border-bottom: 2px solid var(--drv-muted); transform: rotate(45deg); transition: transform .15s; }
  .drv-students[open] > summary::after { transform: rotate(-135deg); }
  .drv-count { margin-left: 8px; padding: 2px 8px; border-radius: 999px; background: #f1f4f8; color: #344054; font-size: .8rem; }
  .drv-studentlist { list-style: none; margin: 12px 0 0; padding: 0; max-height: 360px; overflow-y: auto; }
  .drv-studentlist li { padding: 10px 0; border-top: 1px solid #eef1f5; }
  .drv-studentlist strong { display: block; font-size: .95rem; }
  .drv-studentlist span { font-size: .84rem; color: var(--drv-muted); }

  .drv-stop { display: flex; align-items: center; justify-content: center; width: 24px; height: 24px; border-radius: 50%; background: #fff; border: 2.5px solid var(--drv-accent); color: var(--drv-accent); font: 700 11px/1 system-ui, sans-serif; box-shadow: 0 2px 6px rgba(15,23,42,.25); }
  .drv-stop.is-done { width: 14px; height: 14px; border: 2px solid #fff; background: #b8c2cf; }
  .drv-school { display: flex; align-items: center; justify-content: center; width: 30px; height: 30px; border-radius: 50%; background: var(--drv-accent); color: #fff; border: 2.5px solid #fff; box-shadow: 0 2px 8px rgba(15,23,42,.3); }
  .drv-me { width: 22px; height: 22px; border-radius: 50%; background: var(--drv-blue); border: 4px solid #fff; box-shadow: 0 0 0 1px rgba(26,115,232,.3), 0 2px 6px rgba(15,23,42,.35); }
  .drv-me.is-stale { background: #98a2b3; }

  @media (max-width: 999px) {
    .drv { padding: 12px 12px 88px; }
    .drv-layout { grid-template-columns: 1fr; gap: 12px; }
    .drv-mapwrap { height: 340px; height: clamp(300px, 52svh, 520px); }
    .drv-panel { position: static; }
    .drv-students { margin-top: 12px; }
    .drv.is-driving .drv-students { display: none; }
    .drv-mapwrap .leaflet-control-zoom { display: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .drv .drv-btn, .drv-touch-hint { transition: none; }
  }
</style>

<div class="drv<%= activeTrip ? ' is-driving' : '' %>">
  <header class="drv-top">
    <div class="drv-top-text">
      <h1>Hi, <%= session.firstName || 'Driver' %></h1>
      <p class="drv-busline">
        <% if (driverBus) { %>Bus <%= driverBus.bus_number %><% if (driverBus.license_plate) { %>, <%= driverBus.license_plate %><% } %><% if (driverBus.capacity) { %>, <%= driverBus.capacity %> seats<% } %><% } else { %>No bus assigned yet<% } %>
      </p>
    </div>
    <span class="drv-pill" id="drv-pill" data-state="idle"><i aria-hidden="true"></i><span id="drv-pill-text">Not driving</span></span>
  </header>

  <div class="drv-layout">
    <section class="drv-card drv-mapcard" aria-label="Route map">
      <div class="drv-mapwrap">
        <div id="drv-map"></div>
        <div class="drv-next" id="drv-next" hidden>
          <div class="drv-next-text"><small id="drv-next-label">Next stop</small><strong id="drv-next-name"></strong></div>
          <div class="drv-next-dist"><strong id="drv-next-dist"></strong><small id="drv-next-eta"></small></div>
        </div>
        <button type="button" class="drv-recenter" id="drv-recenter" hidden>
          <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true"><path d="M12 2 4.5 20.3l.7.7L12 18l6.8 3 .7-.7z"/></svg>
          Re-center
        </button>
        <div class="drv-touch-hint" id="drv-touch-hint" aria-hidden="true">Use two fingers to move the map</div>
      </div>
    </section>

    <aside class="drv-side">
      <section class="drv-card drv-panel" aria-label="Trip">
        <% if (!driverBus) { %>
          <p class="drv-empty">Your school hasn’t assigned you a bus yet. It will show here once they do.</p>
        <% } else if (!routeList.length) { %>
          <p class="drv-empty">Your school hasn’t assigned you a route yet. It will show here once they do.</p>
        <% } else { %>
          <div id="drv-idle"<%= activeTrip ? ' hidden' : '' %>>
            <label class="drv-label" for="drv-route-select">Route</label>
            <select id="drv-route-select" class="drv-select">
              <% routeList.forEach(function (route, idx) { %>
                <option value="<%= route.route_id %>"<%= (activeRouteId ? String(route.route_id) === activeRouteId : idx === 0) ? ' selected' : '' %>><%= route.route_name %></option>
              <% }) %>
            </select>
            <button type="button" class="drv-btn drv-btn--go" id="drv-start">
              <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true"><path d="M8 5v14l11-7z"/></svg>
              <span>Go</span>
            </button>
          </div>
          <div id="drv-active"<%= activeTrip ? '' : ' hidden' %>>
            <p class="drv-apps-label">Navigate with</p>
            <div class="drv-apps" id="drv-apps">
              <% navApps.forEach(function (app) { %>
                <button type="button" class="drv-app" data-nav-app="<%= app.key %>"><%= app.label %></button>
              <% }) %>
            </div>
            <p class="drv-route-name" id="drv-active-route"></p>
            <div class="drv-eta"><strong id="drv-eta-value">–</strong><span id="drv-eta-label">Waiting for GPS…</span></div>
            <button type="button" class="drv-btn drv-btn--stop" id="drv-end">End trip</button>
            <p class="drv-hint">Keep this screen open while you drive so families can see the bus.</p>
          </div>
          <p class="drv-note" id="drv-note" role="alert" hidden></p>
        <% } %>
      </section>

      <details class="drv-card drv-students">
        <summary><span>Students<span class="drv-count"><%= (students || []).length %></span></span></summary>
        <% if (!(students || []).length) { %>
          <p class="drv-empty" style="margin-top:12px;">No students are assigned to your bus yet.</p>
        <% } else { %>
          <ul class="drv-studentlist">
            <% students.forEach(function (student) { %>
              <li>
                <strong><%= [student.first_name, student.last_name].filter(Boolean).join(' ') %></strong>
                <span><%= student.class_name || 'No class' %><% if (student.stop_name) { %>, stop: <%= student.stop_name %><% } else if (student.home_address) { %>, <%= student.home_address %><% } %></span>
              </li>
            <% }) %>
          </ul>
        <% } %>
      </details>
    </aside>
  </div>
</div>

<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
<script src="/js/managiraMaps.js?v=<%= assetVersion %>"></script>
<script src="/js/driverLocation.js?v=<%= assetVersion %>"></script>
<script>
(function () {
  'use strict';

  var driverBus = <%- safeJson(driverBus || null) %>;
  var students = <%- safeJson(students || []) %>;
  var lastLocation = <%- safeJson(lastLocation || null) %>;
  var schoolLat = Number(<%- safeJson(schoolLatitude) %>);
  var schoolLng = Number(<%- safeJson(schoolLongitude) %>);
  var routes = <%- safeJson(routeList) %>;
  var activeTrip = <%- safeJson(activeTrip || null) %>;
  var unit = <%- safeJson(distanceUnit === 'mi' ? 'mi' : 'km') %>;

  var BLUE = '#1a73e8';
  var ARRIVE_M = 60;          // within 60 m of a stop counts as served
  var PASS_M = 35;
  var OFF_ROUTE_M = 80;       // further than this from the line: plan again
  var REROUTE_GAP_MS = 15000;
  var ROUTE_REFRESH_MS = 60000;
  var DWELL_S = 30;
  var RAD = Math.PI / 180;

  var $ = function (id) { return document.getElementById(id); };
  var ui = {
    page: document.querySelector('.drv'), pill: $('drv-pill'), pillText: $('drv-pill-text'),
    routeSelect: $('drv-route-select'), idle: $('drv-idle'), active: $('drv-active'), activeRoute: $('drv-active-route'),
    start: $('drv-start'), end: $('drv-end'), note: $('drv-note'), apps: $('drv-apps'),
    next: $('drv-next'), nextLabel: $('drv-next-label'), nextName: $('drv-next-name'), nextDist: $('drv-next-dist'), nextEta: $('drv-next-eta'),
    etaValue: $('drv-eta-value'), etaLabel: $('drv-eta-label'), recenter: $('drv-recenter'),
    touchHint: $('drv-touch-hint')
  };

  var st = {
    map: null, L: null, bus: null, busKey: '', glide: 0, stopLayer: null, ahead: null,
    route: null, stops: [], dest: null, passed: -1,
    line: null, lineAt: 0, linePending: false, lineReq: 0,
    tripId: activeTrip && activeTrip.trip_id ? Number(activeTrip.trip_id) : null,
    pos: null, speed: null, heading: null, following: true, cameraBusy: false, cameraAt: 0,
    gps: 'idle', sync: 'idle', hintTimer: 0
  };

  /* ---------- helpers ---------- */
  function esc(v) { return String(v == null ? '' : v).replace(/[&<>"']/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]; }); }
  function smoothHeading(prev, next) {
    if (typeof next !== 'number' || !isFinite(next)) return prev;
    if (prev === null) return next;
    var delta = ((next - prev + 540) % 360) - 180;
    return (prev + delta * 0.35 + 360) % 360;
  }
  function point(lat, lng) { var a = Number(lat), b = Number(lng); return (isFinite(a) && isFinite(b) && !(a === 0 && b === 0) && Math.abs(a) <= 90 && Math.abs(b) <= 180) ? { lat: a, lng: b } : null; }
  function distM(a, b) {
    var dLat = (b.lat - a.lat) * RAD, dLng = (b.lng - a.lng) * RAD;
    var h = Math.sin(dLat / 2) * Math.sin(dLat / 2) + Math.cos(a.lat * RAD) * Math.cos(b.lat * RAD) * Math.sin(dLng / 2) * Math.sin(dLng / 2);
    return 6371000 * 2 * Math.atan2(Math.sqrt(h), Math.sqrt(1 - h));
  }
  function toLine(raw) { var out = []; (raw || []).forEach(function (p) { var q = Array.isArray(p) ? point(p[0], p[1]) : (p ? point(p.lat, p.lng) : null); if (q) out.push(q); }); return out; }
  function measure(line) { var cum = [0]; for (var i = 1; i < line.length; i++) cum.push(cum[i - 1] + distM(line[i - 1], line[i])); return cum; }
  function project(line, cum, p, fromIndex) {
    var best = null, kx = Math.cos(p.lat * RAD) * 111320, ky = 110540;
    for (var i = Math.max(1, fromIndex || 1); i < line.length; i++) {
      var a = line[i - 1], b = line[i];
      var ax = (a.lng - p.lng) * kx, ay = (a.lat - p.lat) * ky, dx = (b.lng - a.lng) * kx, dy = (b.lat - a.lat) * ky;
      var len2 = dx * dx + dy * dy, t = len2 ? Math.max(0, Math.min(1, -(ax * dx + ay * dy) / len2)) : 0;
      var cx = ax + t * dx, cy = ay + t * dy, d = Math.sqrt(cx * cx + cy * cy);
      if (!best || d < best.offset) best = { index: i, offset: d, along: cum[i - 1] + t * (cum[i] - cum[i - 1]), point: { lat: a.lat + t * (b.lat - a.lat), lng: a.lng + t * (b.lng - a.lng) } };
    }
    return best;
  }
  function fmtDistance(m) {
    if (!isFinite(m)) return '–';
    if (unit === 'mi') { var mi = m / 1609.344; return mi < 0.1 ? Math.max(10, Math.round(m * 3.28084 / 10) * 10) + ' ft' : mi.toFixed(1) + ' mi'; }
    return m < 1000 ? Math.max(10, Math.round(m / 10) * 10) + ' m' : (m / 1000).toFixed(1) + ' km';
  }
  function fmtMin(min) { if (!isFinite(min)) return '–'; var r = Math.max(1, Math.round(min)); return r < 60 ? r + ' min' : Math.floor(r / 60) + ' h ' + (r % 60) + ' min'; }
  function fmtClock(ms) { try { return new Date(ms).toLocaleTimeString([], { hour: 'numeric', minute: '2-digit' }); } catch (_) { return ''; } }
  function driving() { return Boolean(st.tripId); }
  function findRoute(id) { return routes.find(function (r) { return String(r.route_id) === String(id); }) || null; }
  function remaining() { return st.stops.filter(function (s) { return s.seq > st.passed; }); }
  function alongOf(seq) { if (!st.line) return null; var hit = st.line.stops.find(function (x) { return x.seq === seq; }); return hit ? hit.along : null; }
  function busAlong() { if (!st.line || !st.pos) return null; var p = project(st.line.pts, st.line.cum, st.pos); return p && p.offset <= OFF_ROUTE_M ? p : null; }

  function showNote(msg) { if (!ui.note) return; ui.note.textContent = msg; ui.note.hidden = false; }
  function hideNote() { if (ui.note) ui.note.hidden = true; }

  /* ---------- route ---------- */
  function setRoute(route) {
    st.route = route || null;
    st.passed = -1;
    st.line = null; st.lineAt = 0; st.linePending = false; st.lineReq++;
    st.stops = !route ? [] : (route.stops || []).map(function (s, i) {
      var p = point(s.latitude, s.longitude);
      if (!p) return null;
      p.name = s.stop_name || 'Stop';
      p.order = s.stop_order != null && s.stop_order !== '' ? Number(s.stop_order) : i;
      return p;
    }).filter(Boolean).sort(function (a, b) { return a.order - b.order; });
    st.stops.forEach(function (s, i) { s.seq = i; });

    st.dest = null;
    var school = point(schoolLat, schoolLng);
    if (route && route.use_school_destination && school) st.dest = { lat: school.lat, lng: school.lng, label: 'School' };
    else if (route && point(route.destination_latitude, route.destination_longitude)) {
      var d = point(route.destination_latitude, route.destination_longitude);
      st.dest = { lat: d.lat, lng: d.lng, label: route.destination_address || 'Final stop' };
    }
    if (ui.activeRoute) ui.activeRoute.textContent = route ? route.route_name : '';
    drawStops();
    renderAhead();
    requestLine(true);
    updateStats();
    if (!driving()) frameOverview();
  }

  function drawStops() {
    if (!st.map) return;
    var L = st.L;
    st.stopLayer.clearLayers();
    st.stops.forEach(function (s) {
      var done = s.seq <= st.passed, size = done ? 14 : 24;
      L.marker([s.lat, s.lng], {
        keyboard: false, zIndexOffset: done ? 0 : 200,
        icon: L.divIcon({ className: '', html: done ? '<div class="drv-stop is-done"></div>' : '<div class="drv-stop">' + (s.seq + 1) + '</div>', iconSize: [size, size], iconAnchor: [size / 2, size / 2] })
      }).bindTooltip(esc((s.seq + 1) + '. ' + s.name + (done ? ' (done)' : '')), { direction: 'top', offset: [0, -size / 2] }).addTo(st.stopLayer);
    });
    if (st.dest) {
      L.marker([st.dest.lat, st.dest.lng], {
        keyboard: false,
        icon: L.divIcon({ className: '', html: '<div class="drv-school"><svg viewBox="0 0 24 24" width="15" height="15" fill="currentColor" aria-hidden="true"><path d="M5 21V9l7-5 7 5v12h-5v-6h-4v6H5z"/></svg></div>', iconSize: [30, 30], iconAnchor: [15, 15] })
      }).bindTooltip(esc(st.dest.label), { direction: 'top', offset: [0, -14] }).addTo(st.stopLayer);
    }
  }

  // Road-following line: bus (when driving) -> remaining stops -> destination.
  function requestLine(force) {
    if (st.linePending) return;
    var now = Date.now();
    if (!force && now - st.lineAt < REROUTE_GAP_MS) return;
    var rest = remaining(), pts = [];
    if (st.pos && driving()) pts.push([Math.round(st.pos.lat * 1e4) / 1e4, Math.round(st.pos.lng * 1e4) / 1e4]);
    rest.forEach(function (s) { pts.push([s.lat, s.lng]); });
    if (st.dest) pts.push([st.dest.lat, st.dest.lng]);
    if (pts.length < 2 || !window.ManagiraMaps || typeof window.ManagiraMaps.roadPoints !== 'function') { st.line = null; renderAhead(); return; }
    var req = ++st.lineReq;
    st.linePending = true;
    st.lineAt = now;
    Promise.resolve(window.ManagiraMaps.roadPoints(pts)).catch(function () { return null; }).then(function (raw) {
      if (req !== st.lineReq) return;
      st.linePending = false;
      var line = toLine(raw);
      if (line.length < 2) { st.line = null; renderAhead(); updateStats(); return; }
      var cum = measure(line), from = 1;
      st.line = {
        pts: line, cum: cum, length: cum[cum.length - 1],
        stops: rest.map(function (s) { var p = project(line, cum, s, from); if (p) from = p.index; return { seq: s.seq, along: p && p.offset < 80 ? p.along : null }; })
      };
      renderAhead();
      updateStats();
    });
  }

  function renderAhead() {
    if (!st.map) return;
    var pts = null;
    if (st.line) {
      var p = driving() ? busAlong() : null;
      pts = p ? [[p.point.lat, p.point.lng]].concat(st.line.pts.slice(p.index).map(function (q) { return [q.lat, q.lng]; }))
              : st.line.pts.map(function (q) { return [q.lat, q.lng]; });
    }
    if (!pts) { if (st.ahead) { st.ahead.forEach(function (l) { l.remove(); }); st.ahead = null; } return; }
    if (!st.ahead) {
      st.ahead = [
        st.L.polyline(pts, { color: '#fff', weight: 10, opacity: 1, lineCap: 'round', lineJoin: 'round', interactive: false }).addTo(st.map),
        st.L.polyline(pts, { color: BLUE, weight: 6, opacity: 1, lineCap: 'round', lineJoin: 'round', interactive: false }).addTo(st.map)
      ];
    } else {
      st.ahead.forEach(function (l) { l.setLatLngs(pts); });
    }
  }

  /* ---------- live position ---------- */
  function busIcon(heading, stale) {
    if (window.ManagiraMaps && typeof window.ManagiraMaps.busIcon === 'function') {
      try { var icon = window.ManagiraMaps.busIcon({ heading: heading, label: driverBus ? driverBus.bus_number : 'Bus', stale: stale }); if (icon) return icon; } catch (_) { /* fall back */ }
    }
    return st.L.divIcon({ className: '', html: '<div class="drv-me' + (stale ? ' is-stale' : '') + '"></div>', iconSize: [22, 22], iconAnchor: [11, 11] });
  }

  function glideTo(lat, lng) {
    var marker = st.bus;
    if (!marker) return;
    if (st.glide) cancelAnimationFrame(st.glide);
    st.glide = 0;
    var from = marker.getLatLng();
    var distance = distM({ lat: from.lat, lng: from.lng }, { lat: lat, lng: lng });
    if (distance < 0.5) return;
    if (distance > 1500 || document.hidden) { marker.setLatLng([lat, lng]); return; }
    var startAt = null;
    var step = function (now) {
      if (st.bus !== marker) return;
      if (startAt === null) startAt = now;
      var progress = Math.min(1, (now - startAt) / 1000);
      marker.setLatLng([from.lat + (lat - from.lat) * progress, from.lng + (lng - from.lng) * progress]);
      if (progress < 1) st.glide = requestAnimationFrame(step);
      else st.glide = 0;
    };
    st.glide = requestAnimationFrame(step);
  }

  function placeBus(p, stale, animate) {
    if (!st.map || !p) return;
    var h = st.heading;
    var key = (h === null ? 'x' : Math.round(h / 15) * 15) + '|' + stale;
    if (!st.bus) {
      st.bus = st.L.marker([p.lat, p.lng], { icon: busIcon(h, stale), zIndexOffset: 1000, keyboard: false }).addTo(st.map);
      st.busKey = key;
      return;
    }
    if (animate) glideTo(p.lat, p.lng);
    else {
      if (st.glide) cancelAnimationFrame(st.glide);
      st.glide = 0;
      st.bus.setLatLng([p.lat, p.lng]);
    }
    if (key !== st.busKey) { st.bus.setIcon(busIcon(h, stale)); st.busKey = key; }
  }

  function checkProgress() {
    var before = st.passed, proj = busAlong();
    var rest = remaining();
    for (var i = 0; i < rest.length; i++) {
      var s = rest[i], near = distM(st.pos, s);
      var reached = near <= ARRIVE_M;
      if (!reached && proj && near < 400) { var a = alongOf(s.seq); reached = a !== null && proj.along > a + PASS_M; }
      if (!reached) break; // stops are served in order
      st.passed = s.seq;
    }
    if (st.passed !== before) { drawStops(); requestLine(true); }
  }

  function onFix(fix) {
    st.pos = fix;
    if (fix.speed !== null) st.speed = st.speed === null ? fix.speed : st.speed * 0.6 + fix.speed * 0.4;
    if (st.heading === null || (fix.speed !== null && fix.speed > 1.5)) st.heading = smoothHeading(st.heading, fix.heading);
    fix.heading = st.heading;
    placeBus(fix, false, true);
    if (!driving()) return;
    checkProgress();
    var p = busAlong();
    if (!st.line || !p) requestLine(false);
    else if (Date.now() - st.lineAt > ROUTE_REFRESH_MS) requestLine(false);
    renderAhead();
    updateStats();
    follow(false);
  }

  function updateStats() {
    var rest = remaining(), target = rest[0] || st.dest, isDest = !rest[0];
    if (!driving() || !st.pos || !target) {
      if (ui.next) ui.next.hidden = true;
      if (ui.etaValue && driving()) { ui.etaValue.textContent = '–'; ui.etaLabel.textContent = st.pos ? 'Route complete' : 'Waiting for GPS…'; }
      return;
    }
    var speed = Math.max(18 / 3.6, Math.min(60 / 3.6, st.speed === null ? 25 / 3.6 : st.speed));
    var proj = busAlong(), toNext = null, total = null;
    if (proj) {
      var a = isDest ? st.line.length : alongOf(target.seq);
      if (a !== null) toNext = Math.max(0, a - proj.along);
      total = Math.max(0, st.line.length - proj.along);
    }
    if (toNext === null) toNext = distM(st.pos, target) * 1.3;
    if (total === null) {
      total = 0;
      var prev = st.pos;
      rest.concat(st.dest ? [st.dest] : []).forEach(function (q) { total += distM(prev, q) * 1.3; prev = q; });
    }
    ui.next.hidden = false;
    ui.nextLabel.textContent = isDest ? 'Final stop' : 'Next stop';
    ui.nextName.textContent = isDest ? st.dest.label : target.name;
    ui.nextDist.textContent = fmtDistance(toNext);
    ui.nextEta.textContent = fmtMin(toNext / speed / 60);
    var totalMin = total / speed / 60 + rest.length * DWELL_S / 60;
    ui.etaValue.textContent = fmtMin(totalMin);
    ui.etaLabel.textContent = 'to ' + (st.dest ? st.dest.label.toLowerCase() === 'school' ? 'school' : st.dest.label : 'the last stop') + ', ' + fmtDistance(total) + ', about ' + fmtClock(Date.now() + totalMin * 60000);
  }

  /* ---------- camera ---------- */
  function follow(force) {
    if (!st.map || !driving() || !st.pos || (!st.following && !force)) return;
    var now = Date.now();
    if (!force && now - st.cameraAt < 900) return;
    var zoom = force || !st.cameraAt ? 16.5 : st.map.getZoom();
    var center = st.L.latLng(st.pos.lat, st.pos.lng);
    if (st.heading !== null && st.speed !== null && st.speed > 4) {
      var size = st.map.getSize(), radians = st.heading * RAD, offset = size.y * 0.22;
      center = st.map.unproject(st.map.project(center, zoom).add(st.L.point(Math.sin(radians) * offset, -Math.cos(radians) * offset)), zoom);
    }
    st.cameraAt = now;
    st.cameraBusy = true;
    if (force) st.map.setView(center, zoom, { animate: true });
    else st.map.panTo(center, { animate: true, duration: 1, easeLinearity: 1, noMoveStart: true });
  }

  function setFollowing(on) {
    st.following = on;
    if (ui.recenter) ui.recenter.hidden = on || !driving();
  }

  function frameOverview() {
    if (!st.map) return;
    var pts = st.stops.map(function (s) { return [s.lat, s.lng]; });
    if (st.dest) pts.push([st.dest.lat, st.dest.lng]);
    if (st.bus) { var b = st.bus.getLatLng(); pts.push([b.lat, b.lng]); }
    st.cameraBusy = true;
    if (pts.length > 1) st.map.fitBounds(pts, { padding: [40, 40], maxZoom: 16, animate: false });
    else if (pts.length === 1) st.map.setView(pts[0], 15, { animate: false });
    st.cameraBusy = false;
  }

  /* ---------- status ---------- */
  function renderStatus() {
    var state = 'idle', text = 'Not driving';
    if (!driverBus) text = 'No bus assigned';
    else if (driving()) {
      if (st.gps === 'denied' || st.gps === 'unsupported') { state = 'off'; text = 'Location off'; }
      else if (st.gps === 'starting' || st.gps === 'idle') { state = 'weak'; text = 'Finding GPS…'; }
      else if (st.gps === 'weak') { state = 'weak'; text = 'Weak GPS'; }
      else if (st.sync === 'failing') { state = 'weak'; text = 'Reconnecting…'; }
      else { state = 'live'; text = 'Sharing live'; }
    }
    ui.pill.setAttribute('data-state', state);
    ui.pillText.textContent = text;
    if (driving() && st.gps === 'denied') showNote('Location is blocked. Allow location for this site in your phone’s settings so families can see the bus.');
    else if (driving() && st.gps === 'unsupported') showNote('This browser can’t share location. Open the driver screen over a secure (https) connection.');
  }

  function gpsHandlers() {
    return {
      tripId: st.tripId,
      onFix: onFix,
      onStatus: function (s) { st.gps = s.gps; st.sync = s.sync; renderStatus(); }
    };
  }

  function setDriving(on) {
    ui.page.classList.toggle('is-driving', on);
    if (ui.idle) ui.idle.hidden = on;
    if (ui.active) ui.active.hidden = !on;
    if (!on && ui.next) ui.next.hidden = true;
    setFollowing(true);
    renderStatus();
    setTimeout(function () {
      if (!st.map) return;
      st.map.invalidateSize({ pan: false });
      if (on) follow(true); else frameOverview();
    }, 260);
  }

  function post(url, data) {
    return fetch(url, {
      method: 'POST',
      credentials: 'same-origin',
      headers: { 'Content-Type': 'application/x-www-form-urlencoded;charset=UTF-8', 'Accept': 'application/json', 'X-Requested-With': 'XMLHttpRequest' },
      body: new URLSearchParams(data).toString()
    }).then(function (res) {
      return res.json().catch(function () { return null; }).then(function (json) {
        if (!res.ok || !json || !json.success) throw new Error((json && json.message) || 'Something went wrong. Try again.');
        return json;
      });
    });
  }

  /* ---------- map ---------- */
  function initMap() {
    var mapEl = $('drv-map');
    if (!window.L) { mapEl.innerHTML = '<p class="drv-map-msg">The map could not load. Check your connection and refresh.</p>'; return; }
    var L = st.L = window.L;
    var TOUCH = window.matchMedia && window.matchMedia('(pointer: coarse)').matches;
    var map = st.map = L.map(mapEl, {
      zoomControl: false, zoomSnap: 0.25, zoomDelta: 0.5,
      dragging: !TOUCH, touchZoom: true, scrollWheelZoom: false, boxZoom: false, inertia: true
    });
    if (window.ManagiraMaps && typeof window.ManagiraMaps.addTiles === 'function') window.ManagiraMaps.addTiles(map);
    else L.tileLayer('https://{s}.basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}{r}.png', { subdomains: 'abcd', maxZoom: 20, attribution: '&copy; OpenStreetMap contributors &copy; CARTO' }).addTo(map);
    map.attributionControl.setPrefix(false);
    if (!TOUCH) L.control.zoom({ position: 'bottomright' }).addTo(map);
    st.stopLayer = L.layerGroup().addTo(map);

    var studentLayer = L.layerGroup().addTo(map);
    students.forEach(function (s) {
      var p = point(s.stop_latitude || s.home_latitude, s.stop_longitude || s.home_longitude);
      if (!p) return;
      L.circleMarker([p.lat, p.lng], { radius: 4, weight: 1.5, color: '#fff', fillColor: '#98a2b3', fillOpacity: 1 })
        .bindTooltip(esc([s.first_name, s.last_name].filter(Boolean).join(' ')), { direction: 'top' })
        .addTo(studentLayer);
    });

    var center = (lastLocation && point(lastLocation.latitude, lastLocation.longitude)) || point(schoolLat, schoolLng);
    map.setView(center ? [center.lat, center.lng] : [20, 0], center ? 14 : 2);
    if (lastLocation && point(lastLocation.latitude, lastLocation.longitude)) placeBus(point(lastLocation.latitude, lastLocation.longitude), true);

    map.on('movestart', function () { if (!st.cameraBusy && driving()) setFollowing(false); });
    map.on('dragstart', function () { if (driving()) setFollowing(false); });
    map.on('moveend', function () { st.cameraBusy = false; });
    if (window.ResizeObserver) {
      var lastWidth = mapEl.offsetWidth;
      new ResizeObserver(function () {
        if (mapEl.offsetWidth !== lastWidth) {
          lastWidth = mapEl.offsetWidth;
          map.invalidateSize({ pan: false });
        }
      }).observe(mapEl);
    }

    if (TOUCH && ui.touchHint) {
      var hideHint = function () {
        ui.touchHint.classList.remove('is-on');
        ui.touchHint.setAttribute('aria-hidden', 'true');
      };
      mapEl.addEventListener('touchmove', function (event) {
        if (event.touches.length !== 1) { hideHint(); return; }
        ui.touchHint.classList.add('is-on');
        ui.touchHint.setAttribute('aria-hidden', 'false');
        window.clearTimeout(st.hintTimer);
        st.hintTimer = window.setTimeout(hideHint, 1200);
      }, { passive: true });
    }
  }

  /* ---------- events ---------- */
  if (ui.routeSelect) ui.routeSelect.addEventListener('change', function () { hideNote(); setRoute(findRoute(ui.routeSelect.value)); });

  if (ui.recenter) ui.recenter.addEventListener('click', function () { setFollowing(true); follow(true); });

  if (ui.start) ui.start.addEventListener('click', function () {
    var routeId = ui.routeSelect ? ui.routeSelect.value : '';
    if (!routeId || !driverBus) { showNote('Choose your route first.'); return; }
    hideNote();
    if (!window.DriverLocation) { showNote('Location sharing could not load. Refresh the page and try again.'); return; }
    window.DriverLocation.start(gpsHandlers()); // inside the tap, so the phone asks for permission
    var label = ui.start.querySelector('span');
    ui.start.disabled = true;
    label.textContent = 'Starting…';
    post('/transportation/driver/trips/start', { routeId: routeId, busId: String(driverBus.bus_id) }).then(function (result) {
      if (!result.trip) throw new Error('The trip could not start. Try again.');
      st.tripId = Number(result.trip.trip_id);
      window.DriverLocation.setTrip(st.tripId);
      setRoute(findRoute(routeId));
      setDriving(true);
      if (st.pos) onFix(st.pos);
    }).catch(function (err) {
      if (!st.tripId) window.DriverLocation.stop();
      showNote(err.message);
    }).then(function () {
      ui.start.disabled = false;
      label.textContent = 'Go';
    });
  });

  if (ui.end) ui.end.addEventListener('click', function () {
    if (!st.tripId || !window.confirm('End this trip? Families will stop seeing the bus.')) return;
    ui.end.disabled = true;
    post('/transportation/driver/trips/end', { tripId: String(st.tripId) }).then(function () {
      st.tripId = null;
      if (window.DriverLocation) { window.DriverLocation.setTrip(null); window.DriverLocation.stop(); }
      if (st.pos) placeBus(st.pos, true);
      st.pos = null;
      st.speed = null;
      hideNote();
      setRoute(findRoute(ui.routeSelect ? ui.routeSelect.value : ''));
      setDriving(false);
    }).catch(function (err) { showNote(err.message); }).then(function () { ui.end.disabled = false; });
  });

  function openNavApp(app) {
    var pts = remaining().map(function (s) { return [s.lat, s.lng]; });
    if (st.dest) pts.push([st.dest.lat, st.dest.lng]);
    if (!pts.length) { showNote('There are no stops left to navigate to.'); return; }
    var dest = pts[pts.length - 1], via = pts.slice(0, -1), url;
    if (app === 'waze') url = 'https://waze.com/ul?ll=' + dest[0] + ',' + dest[1] + '&navigate=yes';
    else if (app === 'apple') url = 'https://maps.apple.com/?saddr=Current%20Location&daddr=' + pts.map(function (p) { return p[0] + ',' + p[1]; }).join('+to:') + '&dirflg=d';
    else {
      url = 'https://www.google.com/maps/dir/?api=1&travelmode=driving&dir_action=navigate&destination=' + dest[0] + ',' + dest[1];
      if (via.length) url += '&waypoints=' + encodeURIComponent(via.slice(0, 9).map(function (p) { return p[0] + ',' + p[1]; }).join('|'));
    }
    var win = window.open(url, '_blank', 'noopener');
    if (!win) window.location.href = url;
  }

  if (ui.apps) {
    ui.apps.addEventListener('click', function (event) {
      var button = event.target.closest('[data-nav-app]');
      if (button) openNavApp(button.getAttribute('data-nav-app'));
    });
  }

  /* ---------- boot ---------- */
  initMap();
  setRoute(activeTrip ? findRoute(activeTrip.route_id) : (ui.routeSelect ? findRoute(ui.routeSelect.value) : routes[0] || null));
  setDriving(driving());
  if (driving() && window.DriverLocation) window.DriverLocation.start(gpsHandlers());
})();
</script>
