<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="robots" content="noindex">
  <meta name="color-scheme" content="light dark">
  <title><%= state === "unsubscribed" ? "You're unsubscribed" : state === "resubscribed" ? "You're subscribed again" : state === "invalid" ? "Link not valid" : "Email preferences" %> · Managira</title>
  <style>
    :root { --page: #f3f4f6; --card: #ffffff; --border: #e5e7eb; --heading: #0f172a; --body: #334155; --muted: #64748b; --brand: #0f766e; --brand-hover: #115e59; }
    @media (prefers-color-scheme: dark) {
      :root { --page: #0b1120; --card: #111827; --border: #1f2937; --heading: #f1f5f9; --body: #cbd5e1; --muted: #94a3b8; --brand: #14b8a6; --brand-hover: #2dd4bf; }
    }
    * { box-sizing: border-box; }
    body { margin: 0; min-height: 100vh; background: var(--page); color: var(--body); font: 15px/1.6 -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif; display: flex; align-items: flex-start; justify-content: center; padding: 56px 16px; }
    main { width: 100%; max-width: 480px; }
    .brand { display: flex; align-items: center; gap: 10px; margin: 0 4px 16px; color: var(--heading); font-weight: 700; font-size: 17px; text-decoration: none; }
    .brand img { width: 28px; height: 28px; }
    .card { background: var(--card); border: 1px solid var(--border); border-radius: 14px; padding: 32px; }
    h1 { margin: 0 0 12px; color: var(--heading); font-size: 22px; line-height: 1.3; letter-spacing: -0.01em; }
    p { margin: 0 0 16px; }
    .muted { color: var(--muted); font-size: 14px; }
    form { margin: 0; }
    .button { display: inline-block; border: 0; border-radius: 8px; background: var(--brand); color: #fff; font: 600 15px/1.2 inherit; font-family: inherit; padding: 12px 22px; cursor: pointer; text-decoration: none; }
    .button:hover { background: var(--brand-hover); }
    .button:focus-visible, .link:focus-visible { outline: 3px solid rgba(20, 184, 166, 0.45); outline-offset: 2px; }
    .link { background: none; border: 0; padding: 0; color: var(--brand); font: inherit; text-decoration: underline; cursor: pointer; }
    .footer { margin: 16px 4px 0; color: var(--muted); font-size: 13px; }
    .footer a { color: var(--muted); }
    @media (max-width: 520px) { body { padding: 32px 12px; } .card { padding: 24px 20px; } }
  </style>
<% if (!locals.isPrintRender) { %><script src="<%= assetUrl('/js/appAlert.js') %>"></script><% } %>
</head>
<body>
  <main>
    <a class="brand" href="/"><img src="/images/managira-logo-sm.png" alt="">Managira</a>
    <div class="card">
      <% if (state === "confirm") { %>
        <h1>Unsubscribe from <%= what %>?</h1>
        <p>We'll stop sending <%= what %> to <strong><%= address %></strong>. You'll still get the emails you need, like password resets and receipts.</p>
        <form method="post" action="/email/unsubscribe">
          <input type="hidden" name="t" value="<%= token %>">
          <button class="button" type="submit">Unsubscribe</button>
        </form>
      <% } else if (state === "unsubscribed") { %>
        <h1>You're unsubscribed</h1>
        <p>We won't send <%= what %> to <strong><%= address %></strong> any more.</p>
        <form method="post" action="/email/unsubscribe">
          <input type="hidden" name="t" value="<%= token %>">
          <input type="hidden" name="action" value="resubscribe">
          <p class="muted">Changed your mind? <button class="link" type="submit">Turn them back on</button></p>
        </form>
      <% } else if (state === "resubscribed") { %>
        <h1>You're subscribed again</h1>
        <p>We'll send <%= what %> to <strong><%= address %></strong> again.</p>
      <% } else if (state === "error") { %>
        <h1>Something went wrong</h1>
        <p>We couldn't save your choice. Please try again in a moment.</p>
        <form method="post" action="/email/unsubscribe">
          <input type="hidden" name="t" value="<%= token %>">
          <button class="button" type="submit">Try again</button>
        </form>
      <% } else { %>
        <h1>This link isn't valid</h1>
        <p>It may be incomplete or out of date. Sign in to choose which emails you get.</p>
        <a class="button" href="/email/settings">Sign in</a>
      <% } %>
    </div>
    <% if (state !== "invalid") { %>
      <p class="footer"><a href="/email/settings">Manage all your email settings</a></p>
    <% } %>
  </main>
</body>
</html>
