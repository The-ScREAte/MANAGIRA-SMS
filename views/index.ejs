}

.hero-image {
  width: min(90vw, 360px);
  height: auto;
  border-radius: 10px;
  position: static;
  z-index: 1;
  transform-origin: center center;
  transform: translateZ(0);
  will-change: transform;
  animation: hero-spin 2.5s ease-in-out infinite;
}

@keyframes hero-spin {
  0% { transform: rotate(-3deg); }
  50% { transform: rotate(3deg); }
  100% { transform: rotate(-3deg); }
}

@media (max-width: 600px) {
  .hero {
    position: relative;
    padding: 20px 16px 28px;
    min-height: 340px;
    gap: 16px;
  }
  .hero-image {
    position: absolute;
    top: 50%;
    left: 50%;
    transform-origin: center center;
    transform: translate(-50%, -50%) translateZ(0);
    width: 80vw;
    max-width: 320px;
    height: 260px;
    object-fit: contain;
    z-index: 1;
    opacity: 0.7;
    border-radius: 10px;
    background: transparent;
    animation: hero-spin-mobile 2.5s ease-in-out infinite;
    will-change: transform;
  }
