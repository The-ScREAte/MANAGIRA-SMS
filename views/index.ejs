/* ========== Features + Video ========== */
.features-video-section {
  display: flex;
  flex-direction: column;
  gap: 36px;
  padding: 60px 20px;
  max-width: 1200px;
  margin: 0 auto;
  align-items: flex-start;
}

.features {
  width: 100%;
  text-align: center;
}

.features h2 {
  font-size: 1.8rem;
  color: var(--text);
  margin-bottom: 28px;
  font-weight: 700;
  line-height: 1.3;
}

.feature-cards-marquee {
  display: grid;
  gap: 16px;
  width: 100%;
}

.feature-row {
  position: relative;
  overflow: hidden;
  padding: 0;
  touch-action: pan-y;
  cursor: grab;
}

.feature-row.is-dragging {
  cursor: grabbing;
}

.feature-track {
  display: flex;
  align-items: stretch;
  gap: 16px;
  width: 100%;
  will-change: transform;
  transform: translateX(0);
  transition: transform 420ms cubic-bezier(0.25, 0.8, 0.25, 1);
}

#index-feature-slider .feature-edge {
  position: absolute;
  top: 0;
  bottom: 0;
  width: 12%;
  z-index: 3;
  border: 0;
  background: transparent;
  cursor: pointer;
  opacity: 0.46;
  transition: opacity 0.2s ease;
}

#index-feature-slider .feature-edge--left {
  left: 0;
}

#index-feature-slider .feature-edge--right {
  right: 0;
}

#index-feature-slider .feature-edge::after {
  content: '';
  position: absolute;
  inset: 0;
  opacity: 0.34;
  transition: opacity 0.2s ease;
}

#index-feature-slider .feature-edge--left::after {
  background: linear-gradient(
    90deg,
    rgba(46, 255, 251, 0.5) 0%,
    rgba(46, 255, 251, 0.24) 28%,
    rgba(46, 255, 251, 0.08) 58%,
    rgba(46, 255, 251, 0) 100%
  );
}

#index-feature-slider .feature-edge--right::after {
  background: linear-gradient(
    270deg,
    rgba(46, 255, 251, 0.5) 0%,
    rgba(46, 255, 251, 0.24) 28%,
    rgba(46, 255, 251, 0.08) 58%,
    rgba(46, 255, 251, 0) 100%
  );
}

#index-feature-slider .feature-edge:hover::after {
  opacity: 0.58;
}

#index-feature-slider .feature-edge:hover {
  opacity: 1;
}

#index-feature-slider .feature-row.edge-hint-active .feature-edge {
  animation: edge-hint-blink 0.34s ease-in-out 0s 6 alternate;
}

@keyframes edge-hint-blink {
  from { opacity: 0.2; }
  to { opacity: 1; }
}

