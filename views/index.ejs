    <script>
      (() => {
        const rows = Array.from(document.querySelectorAll('.feature-row'));
        if (!rows.length) return;

        const STEP_WAIT_MS = 4000;
        const MOVE_MS = 420;
        const EASING = 'cubic-bezier(0.25, 0.8, 0.25, 1)';

        const rowStates = rows.map((row, index) => {
          const track = row.querySelector('.feature-track');
          const edgeLeft = row.querySelector('.feature-edge--left');
          const edgeRight = row.querySelector('.feature-edge--right');
          return {
            row,
            track,
            edgeLeft,
            edgeRight,
            baseDirection: 1,
            isAnimating: false,
            timer: null,
            paused: false,
            pointerId: null,
            dragStartX: 0,
            dragDeltaX: 0,
            dragActive: false
          };
        });

        const getStepSize = (rowState) => {
          const firstCard = rowState.track?.querySelector('.feature-card');
          if (!firstCard) return 0;
          const gap = parseFloat(getComputedStyle(rowState.track).gap || '16') || 16;
          return firstCard.getBoundingClientRect().width + gap;
        };

        const settleStep = (rowState, direction) => {
          if (direction === 1) {
            const first = rowState.track.firstElementChild;
            if (first) rowState.track.appendChild(first);
          } else {
            const last = rowState.track.lastElementChild;
            if (last) rowState.track.insertBefore(last, rowState.track.firstElementChild);
          }
          rowState.track.style.transform = 'translateX(0)';
          void rowState.track.offsetWidth;
          rowState.track.style.transition = '';
          rowState.isAnimating = false;
        };

        const moveRowByOne = (rowState, direction) => {
          if (!rowState?.track || rowState.isAnimating) return Promise.resolve(false);

          const stepSize = getStepSize(rowState);
          if (!stepSize) return Promise.resolve(false);

          rowState.isAnimating = true;
          rowState.track.style.transition = `transform ${MOVE_MS}ms ${EASING}`;
          rowState.track.style.transform = `translateX(${direction === 1 ? -stepSize : stepSize}px)`;

          return new Promise((resolve) => {
            const handleTransitionEnd = () => {
              rowState.track.removeEventListener('transitionend', handleTransitionEnd);
              rowState.track.style.transition = 'none';
              settleStep(rowState, direction);
              resolve(true);
            };

            rowState.track.addEventListener('transitionend', handleTransitionEnd, { once: true });
          });
        };

        const clearRowTimer = (rowState) => {
          if (rowState.timer) {
            clearTimeout(rowState.timer);
            rowState.timer = null;
          }
        };

        const scheduleRow = (rowState, delay = STEP_WAIT_MS) => {
          clearRowTimer(rowState);
          if (rowState.paused) return;

          rowState.timer = setTimeout(async () => {
            if (rowState.paused) return;
            const moved = await moveRowByOne(rowState, rowState.baseDirection);
            if (!rowState.paused) {
              scheduleRow(rowState, moved ? STEP_WAIT_MS : 300);
            }
          }, delay);
        };

        const pauseRow = (rowState) => {
          rowState.paused = true;
          clearRowTimer(rowState);
        };

        const resumeRow = (rowState) => {
          rowState.paused = false;
          scheduleRow(rowState, STEP_WAIT_MS);
        };

        const completeDrag = (rowState) => {
          const stepSize = getStepSize(rowState);
          const threshold = Math.min(110, stepSize * 0.2);
          const delta = rowState.dragDeltaX;

          rowState.row.classList.remove('is-dragging');
          rowState.dragActive = false;
          rowState.pointerId = null;

          if (Math.abs(delta) < threshold) {
            rowState.track.style.transition = `transform 220ms ${EASING}`;
            rowState.track.style.transform = 'translateX(0)';
            rowState.track.addEventListener('transitionend', () => {
              rowState.track.style.transition = '';
            }, { once: true });
            resumeRow(rowState);
            return;
          }

          const direction = delta < 0 ? 1 : -1;
          rowState.track.style.transition = `transform ${MOVE_MS}ms ${EASING}`;
          rowState.track.style.transform = `translateX(${direction === 1 ? -stepSize : stepSize}px)`;
          rowState.isAnimating = true;

          rowState.track.addEventListener('transitionend', () => {
            rowState.track.style.transition = 'none';
            settleStep(rowState, direction);
            resumeRow(rowState);
          }, { once: true });
        };

        rowStates.forEach((rowState) => {
          rowState.row.addEventListener('mouseenter', () => pauseRow(rowState));
          rowState.row.addEventListener('mouseleave', () => resumeRow(rowState));

          rowState.edgeLeft?.addEventListener('click', () => {
            pauseRow(rowState);
            moveRowByOne(rowState, -1).then(() => resumeRow(rowState));
          });

          rowState.edgeRight?.addEventListener('click', () => {
            pauseRow(rowState);
            moveRowByOne(rowState, 1).then(() => resumeRow(rowState));
          });

          rowState.row.addEventListener('pointerdown', (event) => {
            if (event.target.closest('.feature-edge') || rowState.isAnimating) return;
            rowState.dragActive = true;
            rowState.pointerId = event.pointerId;
            rowState.dragStartX = event.clientX;
            rowState.dragDeltaX = 0;
            rowState.row.classList.add('is-dragging');
            rowState.row.setPointerCapture(event.pointerId);
            rowState.track.style.transition = 'none';
            pauseRow(rowState);
          });

          rowState.row.addEventListener('pointermove', (event) => {
            if (!rowState.dragActive || rowState.pointerId !== event.pointerId) return;
            rowState.dragDeltaX = event.clientX - rowState.dragStartX;
            rowState.track.style.transform = `translateX(${rowState.dragDeltaX}px)`;
          });

          const releasePointer = (event) => {
            if (!rowState.dragActive || rowState.pointerId !== event.pointerId) return;
            completeDrag(rowState);
          };

          rowState.row.addEventListener('pointerup', releasePointer);
          rowState.row.addEventListener('pointercancel', releasePointer);
        });

        document.addEventListener('visibilitychange', () => {
          if (document.hidden) {
            rowStates.forEach((rowState) => pauseRow(rowState));
          } else {
            rowStates.forEach((rowState) => resumeRow(rowState));
          }
        });

        rowStates.forEach((rowState, index) => {
          const startupDelay = index === 1 ? 1000 : 0;
          setTimeout(() => {
            moveRowByOne(rowState, rowState.baseDirection).then(() => {
              resumeRow(rowState);
            });
          }, startupDelay);
        });

        const flashEdgeHints = () => {
          rowStates.forEach((rowState) => rowState.row.classList.add('edge-hint-active'));
          setTimeout(() => {
            rowStates.forEach((rowState) => rowState.row.classList.remove('edge-hint-active'));
          }, 2100);
        };

        const featureArea = document.querySelector('.feature-cards-marquee');
        if ('IntersectionObserver' in window && featureArea) {
          const observer = new IntersectionObserver((entries) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return;
              flashEdgeHints();
              observer.disconnect();
            });
          }, { threshold: 0.35 });
          observer.observe(featureArea);
        } else {
          flashEdgeHints();
        }
      })();
    </script>
