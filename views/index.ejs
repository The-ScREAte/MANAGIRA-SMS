* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

:root {
  --bg: #000;
  --card: #22252a;
  --text: #fff;
  --muted: #b0b3b8;
  --accent: #2efffb;
  --handwriting: "Caveat", "Comic Sans MS", "Segoe Script", cursive;
  --font-family: "Inter", sans-serif;
}

body {
  font-family: var(--font-family);
  background: var(--bg);
  color: var(--text);
  line-height: 1.6;
  overflow-x: hidden;
}

a {
  text-decoration: none;
  color: inherit;
}

/* ========== Hero ========== */
.hero {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 24px;
  padding: 32px 20px;
  text-align: center;
  position: relative;
  overflow: hidden;
  isolation: isolate;
  background: #000;
}

/* Cinematic layered background: deep teal radial glow + diagonal light stripes +
   slow conic sheen. Pointer-events disabled, z-index below content. */
.hero::before,
.hero::after {
  content: "";
  position: absolute;
  inset: -20%;
  pointer-events: none;
  z-index: 0;
}
.hero::before {
  background:
    radial-gradient(60% 50% at 20% 30%, rgba(46, 255, 251, 0.18) 0%, transparent 60%),
    radial-gradient(55% 45% at 80% 70%, rgba(1, 83, 91, 0.55) 0%, transparent 65%),
    radial-gradient(80% 70% at 50% 120%, rgba(46, 255, 251, 0.10) 0%, transparent 70%),
    #000;
  animation: hero-glow-drift 18s ease-in-out infinite alternate;
  filter: blur(2px);
}
.hero::after {
  background:
    repeating-linear-gradient(
      115deg,
      rgba(255, 255, 255, 0.045) 0px,
      rgba(255, 255, 255, 0.045) 1px,
      transparent 1px,
      transparent 14px
    ),
    repeating-linear-gradient(
      115deg,
      rgba(46, 255, 251, 0.07) 0px,
      rgba(46, 255, 251, 0.07) 2px,
      transparent 2px,
      transparent 48px
    );
  mix-blend-mode: screen;
  animation: hero-stripes-slide 14s linear infinite;
  opacity: 0.9;
}

/* A slow sweeping sheen layer */
.hero-sheen {
  position: absolute;
  inset: 0;
  pointer-events: none;
  z-index: 0;
  background: conic-gradient(
    from 0deg at 50% 50%,
    transparent 0deg,
    rgba(46, 255, 251, 0.10) 40deg,
    transparent 100deg,
    transparent 220deg,
    rgba(1, 83, 91, 0.22) 260deg,
    transparent 320deg,
    transparent 360deg
  );
  animation: hero-sheen-rotate 30s linear infinite;
  mix-blend-mode: screen;
  opacity: 0.7;
}

@keyframes hero-stripes-slide {
  0%   { transform: translate3d(0, 0, 0); }
  100% { transform: translate3d(-96px, -48px, 0); }
}
@keyframes hero-glow-drift {
  0%   { transform: translate3d(0, 0, 0) scale(1); }
  50%  { transform: translate3d(2%, -1.5%, 0) scale(1.04); }
  100% { transform: translate3d(-1.5%, 2%, 0) scale(1.02); }
}
@keyframes hero-sheen-rotate {
  to { transform: rotate(1turn); }
}

@media (prefers-reduced-motion: reduce) {
  .hero::before,
  .hero::after,
  .hero-sheen { animation: none; }
}

.hero-text,
.hero-image {
  position: relative;
  z-index: 2;
}

.hero-text {
  max-width: 600px;
  margin-top: 18px;
}

.hero h1 {
  font-size: 2rem;
  font-weight: 700;
  margin-bottom: 10px;
}

.hero p {
  font-size: 1rem;
  margin-bottom: 16px;
}

.button-group {
  display: flex;
  gap: 12px;
  /* flex-wrap: wrap; */
  justify-content: center;
}

.button-group button,
.button-group a {
  padding: 8px 18px;
  border-radius: 7px;
  font-weight: 600;
  font-size: 0.92rem;
  cursor: pointer;
  transition: 0.3s;
  text-decoration: none;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 38px;
  box-sizing: border-box;
  line-height: 1.5;
  flex: 1;
  min-width: 0;
}

.primary-button {
  background: #fff;
  color: #000;
  border: 0;
}

.primary-button:hover {
  background: #ffffffcc;
}

.secondary-button {
  background: transparent;
  color: #fff;
  border: 2px solid #fff;
}

.secondary-button:hover {
  background: #fff;
  color: var(--accent);
}

.hero-image {
  width: min(90vw, 360px);
  height: auto;
  border-radius: 10px;
  position: static;
  z-index: 1;
  transform-origin: center center;
  transform: translateZ(0);
  will-change: transform;
  animation: hero-spin 2.5s ease-in-out infinite;
}

@keyframes hero-spin {
  0% { transform: rotate(-3deg); }
  50% { transform: rotate(3deg); }
  100% { transform: rotate(-3deg); }
}

@media (max-width: 600px) {
  .hero {
    position: relative;
    padding: 20px 16px 28px;
    min-height: 340px;
    gap: 16px;
  }
  .hero-image {
    position: absolute;
    top: 50%;
    left: 50%;
    transform-origin: center center;
    transform: translate(-50%, -50%) translateZ(0);
    width: 80vw;
    max-width: 320px;
    height: 260px;
    object-fit: contain;
    z-index: 1;
    opacity: 0.7;
    border-radius: 10px;
    background: transparent;
    animation: hero-spin-mobile 2.5s ease-in-out infinite;
    will-change: transform;
  }
  .hero-text {
    position: relative;
    z-index: 2;
    margin-top: 32px;
  }

  @keyframes hero-spin-mobile {
    0% { transform: translate(-50%, -50%) rotate(-3deg); }
    50% { transform: translate(-50%, -50%) rotate(3deg); }
    100% { transform: translate(-50%, -50%) rotate(-3deg); }
  }
}

/* ========== Section Label ========== */
.section-label {
  font-size: 0.85rem;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 2px;
  color: var(--accent);
  margin-bottom: 10px;
}

/* ========== Features + Video ========== */
.features-video-section {
  display: flex;
  flex-direction: column;
  gap: 36px;
  padding: 60px 20px;
  max-width: 1200px;
  margin: 0 auto;
  align-items: flex-start;
}

.features {
  width: 100%;
  text-align: center;
}

.features h2 {
  font-size: 1.8rem;
  color: var(--text);
  margin-bottom: 28px;
  font-weight: 700;
  line-height: 1.3;
}

.feature-cards {
  display: grid;
  gap: 16px;
  width: 100%;
  grid-template-columns: repeat(2, 1fr);
  align-items: stretch;
}

.feature-card {
  background: var(--card);
  padding: 24px 20px;
  border-radius: 12px;
  border: 1px solid rgba(255,255,255,0.06);
  text-align: left;
  display: flex;
  flex-direction: column;
  gap: 10px;
  transition: border-color 0.3s, transform 0.2s;
}

.feature-card:hover {
  border-color: var(--accent);
  transform: translateY(-2px);
}

.feature-icon {
  width: 48px;
  height: 48px;
  border-radius: 10px;
  background: rgba(46, 255, 251, 0.08);
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--accent);
  flex-shrink: 0;
}

.feature-card h3 {
  font-size: 1.05rem;
  color: var(--text);
  font-weight: 600;
  margin: 0;
}

.feature-card p {
  font-size: 0.92rem;
  color: var(--muted);
  line-height: 1.6;
  margin: 0;
}

.video-section {
  display: flex;
  flex-direction: column;
  gap: 0;
  align-self: center;
  margin-top: 40px;
}

.video-section video {
  width: 100%;
  height: auto;
  display: block;
  border-radius: 12px 12px 0 0;
}

.video-note {
  width: 100%;
  background: #000;
  padding: 50px 30px;
  text-align: center;
  font-family: var(--handwriting);
  font-size: 3.2rem;
  color: var(--accent);
  border-radius: 0 0 12px 12px;
  line-height: 1.4;
  font-weight: 600;
}

.video-note .line-left {
  display: block;
  transform: translateX(-30px);
}

.video-note .line-right {
  display: block;
  transform: translateX(30px);
}

/* ========== How It Works ========== */
.how-it-works-section {
  padding: 60px 20px;
  text-align: center;
  max-width: 1000px;
  margin: 0 auto;
}

.how-it-works-section h2 {
  font-size: 1.8rem;
  color: var(--text);
  margin-bottom: 40px;
  font-weight: 700;
}

.steps-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 24px;
}

.step-card {
  text-align: center;
  padding: 28px 20px;
  position: relative;
}

.step-number {
  font-size: 2.4rem;
  font-weight: 800;
  color: var(--accent);
  opacity: 0.3;
  margin-bottom: 12px;
  line-height: 1;
}

.step-card h3 {
  font-size: 1.1rem;
  color: var(--text);
  font-weight: 600;
  margin-bottom: 8px;
}

.step-card p {
  font-size: 0.92rem;
  color: var(--muted);
  line-height: 1.6;
}

/* ========== Automation ========== */
.automation-section {
  padding: 60px 20px;
  max-width: 1100px;
  margin: 0 auto;
}

.automation-section h2 {
  font-size: 1.8rem;
  color: var(--text);
  margin-bottom: 16px;
  font-weight: 700;
  line-height: 1.3;
}

.automation-content {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 36px;
}

.automation-text {
  max-width: 720px;
  display: flex;
  flex-direction: column;
  gap: 14px;
}

.automation-text p {
  font-size: 1rem;
  color: var(--muted);
  line-height: 1.7;
}

.automation-cta {
  display: inline-block;
  color: var(--accent);
  font-weight: 600;
  font-size: 0.95rem;
  margin-top: 6px;
  transition: opacity 0.2s;
}

.automation-cta:hover {
  opacity: 0.8;
}

.automation-image {
  width: min(100%, 480px);
  height: auto;
  object-fit: contain;
}

/* ========== Stats ========== */
.stats-section {
  padding: 48px 20px;
  background: var(--card);
  border-top: 1px solid rgba(255,255,255,0.06);
  border-bottom: 1px solid rgba(255,255,255,0.06);
}

.stats-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 24px;
  max-width: 900px;
  margin: 0 auto;
  text-align: center;
}

.stat-item {
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.stat-number {
  font-size: 2rem;
  font-weight: 800;
  color: var(--accent);
  line-height: 1.2;
}

.stat-label {
  font-size: 0.85rem;
  color: var(--muted);
  font-weight: 500;
}

/* ========== Benefits ========== */
.benefits-section {
  padding: 60px 20px;
  text-align: center;
  max-width: 1100px;
  margin: 0 auto;
}

.benefits-section h2 {
  font-size: 1.8rem;
  color: var(--text);
  margin-bottom: 36px;
  font-weight: 700;
}

.benefit-cards {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20px;
}

.benefit-card {
  background: var(--card);
  padding: 28px 24px;
  border-radius: 12px;
  border: 1px solid rgba(255,255,255,0.06);
  text-align: left;
  display: flex;
  flex-direction: column;
  gap: 12px;
  transition: border-color 0.3s;
}

.benefit-card:hover {
  border-color: var(--accent);
}

.benefit-icon {
  width: 44px;
  height: 44px;
  border-radius: 10px;
  background: rgba(46, 255, 251, 0.08);
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--accent);
  flex-shrink: 0;
}

.benefit-card h3 {
  font-size: 1.05rem;
  color: var(--text);
  font-weight: 600;
  margin: 0;
}

.benefit-card p {
  font-size: 0.92rem;
  color: var(--muted);
  line-height: 1.6;
  margin: 0;
}

/* ========== CTA Section ========== */
.cta-section {
  padding: 60px 20px;
  text-align: center;
  max-width: 600px;
  margin: 0 auto;
}

.cta-section h2 {
  font-size: 1.8rem;
  color: var(--text);
  font-weight: 700;
  margin-bottom: 12px;
}

.cta-section p {
  font-size: 1rem;
  color: var(--muted);
  margin-bottom: 28px;
  line-height: 1.6;
}

.cta-buttons {
  display: flex;
  gap: 14px;
  justify-content: center;
  flex-wrap: wrap;
}

.cta-primary {
  padding: 12px 32px;
  border-radius: 8px;
  font-weight: 600;
  font-size: 0.95rem;
  background: var(--accent);
  color: #000;
  transition: opacity 0.2s;
}

.cta-primary:hover {
  opacity: 0.85;
}

.cta-secondary {
  padding: 12px 32px;
  border-radius: 8px;
  font-weight: 600;
  font-size: 0.95rem;
  border: 2px solid rgba(255,255,255,0.2);
  color: var(--text);
  transition: border-color 0.2s;
}

.cta-secondary:hover {
  border-color: var(--accent);
}

/* ========== Footer ========== */
.footer {
  color: var(--text);
  padding: 20px;
  text-align: center;
}

.footer p {
  font-size: 0.92rem;
  color: var(--muted);
}

/* ========== Security & Logo Section ========== */
.security-section {
  padding: 50px 20px;
  text-align: center;
}

.security-section h2 {
  font-size: 2rem;
  color: var(--accent);
  margin-bottom: 20px;
}

.security-section p {
  font-size: 1rem;
  color: var(--muted);
}

.logo-section {
  background: #fff;
  padding: 5px;
  overflow: hidden;
  white-space: nowrap;
  width: 100%;
}

@media (max-width: 1024px) {
  .logo-container img {
    height: 40px;
    margin: 0 10px;
  }
}

@media (max-width: 600px) {
  .logo-container img {
    height: 30px;
    margin: 0 6px;
  }
}

.logo-container {
  display: flex;
  align-items: center;
  gap: 0;
  width: max-content;
  animation: scroll 36s linear infinite;
}

.logo-container span {
  margin-left: 6px;
  vertical-align: middle;
}

.logo-container img {
  height: 50px;
  margin: 0 15px;
}

@keyframes scroll {
  from { transform: translateX(0); }
  to { transform: translateX(-50%); }
}

/* ========== Responsive ========== */

/* ≥480px */
@media (min-width: 480px) {
  .hero h1 {
    font-size: 2.2rem;
  }
}

/* Small screens — stack grids */
@media (max-width: 600px) {
  .feature-cards {
    grid-template-columns: 1fr;
  }
  .benefit-cards {
    grid-template-columns: 1fr;
  }
  .steps-grid {
    grid-template-columns: 1fr;
    gap: 16px;
  }
  .stats-grid {
    grid-template-columns: repeat(2, 1fr);
    gap: 20px;
  }
  .stat-number {
    font-size: 1.6rem;
  }
  .features h2,
  .how-it-works-section h2,
  .automation-section h2,
  .benefits-section h2,
  .cta-section h2 {
    font-size: 1.4rem;
  }
  .automation-image {
    width: min(80vw, 300px);
  }
  .video-note {
    display: none;
  }
  .footer {
    padding: 12px 16px;
  }
  .logo-section {
    padding: 3px;
  }
  .logo-container img {
    height: 35px;
    margin: 0 10px;
  }
  .logo-container span {
    font-size: 0.9rem;
  }
}

/* ≥768px (tablet) */
@media (min-width: 768px) {
  .hero {
    flex-direction: row;
    justify-content: space-between;
    padding: 15px 50px;
    text-align: left;
  }

  .hero-text {
    text-align: left;
  }

  .button-group {
    justify-content: flex-start;
  }

  .benefit-cards {
    grid-template-columns: repeat(2, 1fr);
  }

  .features h2,
  .how-it-works-section h2,
  .automation-section h2,
  .benefits-section h2 {
    font-size: 2rem;
  }
}

/* ≥1024px (desktop) */
@media (min-width: 1024px) {
  .features-video-section {
    flex-direction: row;
    align-items: flex-start;
    gap: 36px;
    padding: 80px 40px;
  }

  .features {
    width: 60%;
    text-align: left;
  }

  .video-section {
    width: 40%;
    min-height: auto;
    align-self: flex-start;
  }

  .automation-content {
    flex-direction: row;
    align-items: center;
    text-align: left;
  }

  .automation-text {
    max-width: 580px;
    margin-right: 32px;
  }

  .automation-image {
    flex: 1 1 320px;
    max-width: 480px;
    width: 100%;
  }

  .benefit-cards {
    grid-template-columns: repeat(4, 1fr);
  }

  .button-group {
    justify-content: flex-start;
  }
}

/* ≥1280px */
@media (min-width: 1280px) {
  .features h2,
  .automation-section h2 {
    font-size: 2.2rem;
  }
}
