/* Small screens — stack grids */
@media (max-width: 600px) {
  .feature-row {
    padding: 0;
  }

  .feature-track {
    width: 100%;
  }

  .feature-card {
    flex: 0 0 calc((100% - 16px) / 2);
  }

  #index-feature-slider .feature-edge {
    width: 15%;
  }
  .benefit-cards {
    grid-template-columns: 1fr;
