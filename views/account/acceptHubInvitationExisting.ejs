<style>
  :root {
    --primary: #01535b;
    --primary-hover: #014a51;
        --primary-hover-fill: color-mix(in srgb, var(--primary) 88%, white);
    --text-primary: #111827;
    --text-secondary: #6b7280;
    --border: #e5e7eb;
    --bg: #f9fafb;
    --success: #10b981;
    --warning: #f59e0b;
  }

  * { box-sizing: border-box; margin: 0; padding: 0; }

  body {
    font-family: "Inter", -apple-system, sans-serif;
    background: var(--bg);
  }

  .container {
    max-width: 700px;
    margin: 0 auto;
    padding: 80px 20px 40px 20px;
  }

  .header-card {
    background: white;
    padding: 40px 32px;
    border-radius: 12px;
    text-align: center;
    border: 1px solid var(--border);
    border-bottom: 3px solid var(--primary);
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.06);
    margin-bottom: 24px;
  }

  .header-card h1 {
    font-size: 1.75rem;
    margin: 0 0 12px 0;
    font-weight: 700;
    color: var(--text-primary);
    display: block;
    width: 100%;
  }

  .header-card p {
    margin: 0;
    font-size: 1rem;
    color: var(--text-secondary);
    display: block;
    width: 100%;
  }

  .content-card {
    background: white;
    padding: 40px 32px;
    border-radius: 12px;
    border: 1px solid var(--border);
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.06);
  }

  .info-section {
    background: #e3f2fd;
    padding: 20px;
    border-radius: 8px;
    border-left: 4px solid #2196F3;
    margin-bottom: 24px;
  }

  .info-section h3 {
    margin: 0 0 12px 0;
    color: var(--text-primary);
    font-size: 1.1rem;
    font-weight: 600;
  }

  .info-section p {
    margin: 8px 0;
    color: var(--text-secondary);
    font-size: 0.95rem;
  }

  .info-section strong {
    color: var(--text-primary);
  }

  .warning-box {
    background: #fff3cd;
    padding: 20px;
    border-radius: 8px;
    border-left: 4px solid var(--warning);
    margin: 24px 0;
  }

  .warning-box h4 {
    margin: 0 0 12px 0;
    color: #856404;
    font-size: 1rem;
    font-weight: 600;
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .warning-box ul {
    margin: 12px 0 0 0;
    padding-left: 20px;
    color: #856404;
  }

  .warning-box li {
    margin: 6px 0;
    font-size: 0.9rem;
  }

  .benefits-box {
    background: #d4edda;
    padding: 20px;
    border-radius: 8px;
    border-left: 4px solid var(--success);
    margin: 24px 0;
  }

  .benefits-box h4 {
    margin: 0 0 12px 0;
    color: #155724;
    font-size: 1rem;
    font-weight: 600;
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .benefits-box ul {
    margin: 12px 0 0 0;
    padding-left: 20px;
    color: #155724;
  }

  .benefits-box li {
    margin: 6px 0;
    font-size: 0.9rem;
  }

  .checkbox-group {
    background: var(--bg);
    padding: 20px;
    border-radius: 8px;
    border: 2px solid var(--border);
    margin: 24px 0;
  }

  .checkbox-group label {
    display: flex;
    align-items: start;
    gap: 12px;
    cursor: pointer;
    font-size: 0.95rem;
    color: var(--text-primary);
  }

  .checkbox-group input[type="checkbox"] {
    width: 20px;
    height: 20px;
    cursor: pointer;
    margin-top: 2px;
  }

  .button-group {
    display: flex;
    gap: 12px;
    margin-top: 32px;
    padding-top: 24px;
    border-top: 1px solid var(--border);
  }

  .btn {
    padding: 12px 24px !important;
    border: none !important;
    border-radius: 8px !important;
    font-weight: 600 !important;
    font-size: 0.95rem !important;
    cursor: pointer !important;
    transition: all 0.2s !important;
    text-decoration: none !important;
    display: inline-flex !important;
    align-items: center !important;
    justify-content: center !important;
    gap: 8px !important;
    text-align: center !important;
    font-family: inherit !important;
    width: 50% !important;
  }

  .btn-primary {
    background: var(--primary) !important;
    color: white !important;
    border-color: var(--primary) !important;
  }

  .btn-primary:hover:not(:disabled) {
    background: var(--primary-hover-fill, var(--primary-hover)) !important;
    border-color: var(--primary-hover-fill, var(--primary-hover)) !important;
  }

  .btn-primary:disabled {
    opacity: 0.5 !important;
    cursor: not-allowed !important;
  }

  .btn-secondary {
    background: white !important;
    color: #dc2626 !important;
    border: 2px solid #dc2626 !important;
  }

  .btn-secondary:hover {
    background: #dc2626 !important;
    color: white !important;
    border-color: #dc2626 !important;
  }

  .flash-messages {
    margin-bottom: 20px;
  }

  .alert {
    padding: 14px 18px;
    border-radius: 8px;
    margin-bottom: 12px;
    font-weight: 500;
  }

  .alert-error {
    background: #fee;
    color: #c33;
    border-left: 4px solid #c33;
  }

  @media (max-width: 768px) {
    .container {
      padding: 100px 16px 40px 16px;
    }

    .header-card {
      padding: 24px;
    }

    .header-card h1 {
      font-size: 1.5rem;
    }

    .content-card {
      padding: 24px;
    }

    .button-group {
      gap: 8px;
    }
    
    .btn {
      padding: 10px 16px !important;
      font-size: 0.85rem !important;
    }
  }
</style>

<div class="container">
  <% if (typeof req !== 'undefined' && req.flash) { %>
    <% const messages = { success: req.flash('success'), error: req.flash('error'), warning: req.flash('warning') }; %>
    <% if (messages.success && messages.success.length > 0) { %>
      <% messages.success.forEach(msg => { %>
        <div class="alert" style="background: #d4edda; color: #155724; border-left: 4px solid #28a745; padding: 14px 18px; border-radius: 8px; margin-bottom: 12px; font-weight: 500;"><%= msg %></div>
      <% }); %>
    <% } %>
    <% if (messages.error && messages.error.length > 0) { %>
      <% messages.error.forEach(msg => { %>
        <div class="alert" style="background: #f8d7da; color: #721c24; border-left: 4px solid #dc3545; padding: 14px 18px; border-radius: 8px; margin-bottom: 12px; font-weight: 500;"><%= msg %></div>
      <% }); %>
    <% } %>
  <% } %>



  <div class="content-card">
      <div class="header-card">
    <h1>🤝 Hub Invitation</h1>
    <p>You've been invited to join a hub!</p>
  </div>
    <div class="info-section">
      <h3>Invitation Details</h3>
      <p><strong>Hub Name:</strong> <%= invitation.hub_name %></p>
      <p><strong>Your Organization:</strong> <%= invitation.organization_name %></p>
      <p><strong>Invited By:</strong> <%= invitation.hub_email %></p>
      <p><strong>Expires:</strong> <%= new Date(invitation.expires_at).toLocaleDateString() %></p>
    </div>

    <div class="warning-box">
      <h4>⚠️ Important Changes</h4>
      <p>Accepting this invitation will make the following changes to your organization:</p>
      <ul>
        <li><strong>Subdomain Change:</strong> Your subdomain will change to <code style="background: white; padding: 2px 6px; border-radius: 4px; font-family: monospace;"><%= invitation.organization_name.toLowerCase().replace(/\s+/g, '') %>.<%= invitation.hub_nickname %>.managira.com</code></li>
        <li><strong>Subscription Management:</strong> Your subscription will be managed by <%= invitation.hub_name %></li>
        <li><strong>Hub Membership:</strong> You'll be part of the <%= invitation.hub_name %> hub network</li>
        <li><strong>Centralized Management:</strong> The hub can manage certain aspects of your organization</li>
      </ul>
    </div>

    <div class="benefits-box">
      <h4>✓ What Stays the Same</h4>
      <ul>
        <li><strong>Your Data:</strong> All your students, staff, classes, and records remain intact</li>
        <li><strong>Your Login:</strong> Use your existing credentials - no changes required</li>
        <li><strong>Operational Control:</strong> You maintain full control over day-to-day operations</li>
        <li><strong>Your Team:</strong> All users and permissions remain unchanged</li>
      </ul>
    </div>

    <form action="/account/accept-hub-invitation-existing/<%= token %>" method="POST" id="acceptForm">
      <div class="checkbox-group">
        <label>
          <input type="checkbox" name="confirm" value="yes" id="confirmCheckbox" required onchange="toggleSubmitButton()">
          <span>I understand the changes above and want to join <strong><%= invitation.hub_name %></strong> hub</span>
        </label>
      </div>

      <div class="button-group">
        <button type="submit" class="btn btn-primary" id="submitBtn" disabled>
          <span>✓</span> Accept & Join Hub
        </button>
        <a href="/account/login" class="btn btn-secondary">Decline</a>
      </div>
    </form>

    <div style="margin-top: 24px; padding-top: 24px; border-top: 1px solid var(--border);">
      <p style="font-size: 0.85rem; color: var(--text-secondary); text-align: center; margin: 0;">
        Have questions? Contact <%= invitation.hub_name %> at <%= invitation.hub_email %>
      </p>
    </div>
  </div>
</div>

<script>
  function toggleSubmitButton() {
    const checkbox = document.getElementById('confirmCheckbox');
    const submitBtn = document.getElementById('submitBtn');
    submitBtn.disabled = !checkbox.checked;
  }

  document.getElementById('acceptForm').addEventListener('submit', function(e) {
    const checkbox = document.getElementById('confirmCheckbox');
    if (!checkbox.checked) {
      e.preventDefault();
      alert('Please confirm that you understand the changes before proceeding.');
    }
  });
</script>
