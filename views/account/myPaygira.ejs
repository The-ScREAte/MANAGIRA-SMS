<script id="mpBillsData" type="application/json"><%-
  JSON.stringify((bills || []).map(b => ({
    bill_id: b.bill_id,
    title: b.title,
    bill_type: b.bill_type,
    recurrence: b.recurrence,
    due_date: b.due_date,
    recurrence_end_date: b.recurrence_end_date,
    term_end_date: b.term_end_date,
    exclude_non_school_days: !!b.exclude_non_school_days,
    scheduled_occurrence_dates: b.scheduled_occurrence_dates || [],
    signed_off_dates: b.signed_off_dates || [],
    description: b.description,
    accepts_card: b.accepts_card,
    accepts_cash: b.accepts_cash,
    accepts_transfer: b.accepts_transfer,
    total_amount: b.total_amount,
    total_paid: b.total_paid,
    total_outstanding: b.total_outstanding,
    students: (_byBill[b.bill_id] || []).map(a => ({
      assignment_id: a.assignment_id,
      first_name: a.first_name,
      last_name: a.last_name,
      image_url: a.image_url,
      class_name: a.class_name,
      amount: a.amount,
      scheduled_billed_total: a.scheduled_billed_total,
      amount_paid: a.amount_paid,
      late_fee_applied: a.late_fee_applied,
      status: a.status
    }))
  })))
%></script>

