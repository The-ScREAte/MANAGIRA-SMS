<script>
  (function(){
    var financeCurrencyCode = <%- JSON.stringify(currencyCode) %>;
    var financeCurrencyLocale = <%- JSON.stringify(currencyLocale) %>;
    var scopedClassId = <%- JSON.stringify(typeof viewClassId !== 'undefined' ? viewClassId : null) %>;
    var DATA = [];
    try { DATA = JSON.parse(document.getElementById('mpBillsData').textContent || '[]'); } catch (e) { DATA = []; }

    var byId = {};
    var state = {
      currentBillId: null,
      classId: scopedClassId,
      selectedOccLabel: '',
      selectedOccDate: '',
      occFilter: 'all',
      bulkMode: false,
      bulkSelection: {},
      occurrenceCache: {},
      occurrenceLoading: {},
      toastTimer: null,
    };

    function money(value) {
      try {
        return new Intl.NumberFormat(financeCurrencyLocale, {
          style: 'currency',
          currency: financeCurrencyCode,
          minimumFractionDigits: 2,
          maximumFractionDigits: 2,
        }).format(Number(value || 0));
      } catch (_) {
        return financeCurrencyCode + ' ' + Number(value || 0).toFixed(2);
      }
    }

    function escapeHtml(value) {
      var map = {
        '&': '&amp;',
        '<': '&lt;',
        '>': '&gt;',
        '"': '&quot;',
        "'": '&#39;'
      };
      return String(value == null ? '' : value).replace(/[&<>"']/g, function(char) {
        return map[char] || char;
      });
    }

    function pickImage(imageUrl) {
      return imageUrl && imageUrl !== 'profilePlaceholder.png'
        ? imageUrl
        : '/images/profilePlaceholder.png';
    }

    function assignmentBilledTotal(assignment) {
      var scheduled = Number(assignment && assignment.scheduled_billed_total);
      return Number.isFinite(scheduled) ? scheduled : Number(assignment && assignment.amount || 0);
    }

    function bal(assignment) {
      return Math.max(assignmentBilledTotal(assignment) + Number(assignment.late_fee_applied || 0) - Number(assignment.amount_paid || 0), 0);
    }

    function advanceOccurrenceDate(dateValue, recurrence) {
      var next = new Date(dateValue.getTime());
      switch (String(recurrence || '').toLowerCase()) {
        case 'daily': next.setDate(next.getDate() + 1); return next;
        case 'weekly': next.setDate(next.getDate() + 7); return next;
        case 'monthly': next.setMonth(next.getMonth() + 1); return next;
        case 'term': next.setMonth(next.getMonth() + 3); return next;
        case 'year': next.setFullYear(next.getFullYear() + 1); return next;
        default: return null;
      }
    }

    function occurrenceCacheKey(billId, dateIso) {
      return [String(billId || ''), String(dateIso || ''), String(state.classId || 'all')].join(':');
    }

    function getOccurrenceSnapshotForBill(bill) {
      if (!bill || bill.bill_type !== 'recurring' || !state.selectedOccDate) return null;
      return state.occurrenceCache[occurrenceCacheKey(bill.bill_id, state.selectedOccDate)] || null;
    }

    function hasOccurrenceSnapshotForBill(bill) {
      var snapshot = getOccurrenceSnapshotForBill(bill);
      return !!(snapshot && !snapshot.error);
    }

    function ensureOccurrenceSnapshot(bill) {
      if (!bill || bill.bill_type !== 'recurring' || !state.selectedOccDate) return;
      var cacheKey = occurrenceCacheKey(bill.bill_id, state.selectedOccDate);
      if (state.occurrenceCache[cacheKey] || state.occurrenceLoading[cacheKey]) return;
      state.occurrenceLoading[cacheKey] = true;
      var url = '/account/settings/my-paygira/occurrence-summary?bill_id=' + encodeURIComponent(bill.bill_id) + '&date=' + encodeURIComponent(state.selectedOccDate);
      if (state.classId) url += '&classId=' + encodeURIComponent(state.classId);
      fetch(url, {
        headers: {
          'Accept': 'application/json',
          'X-Requested-With': 'XMLHttpRequest'
        }
      })
        .then(function(response) {
          if (!response.ok) throw new Error('Could not load date balances.');
          return response.json();
        })
        .then(function(payload) {
          var indexed = {};
          (payload.items || []).forEach(function(item) {
            indexed[String(item.assignment_id)] = item;
          });
          payload.byAssignmentId = indexed;
          state.occurrenceCache[cacheKey] = payload;
          if (Number(state.currentBillId) === Number(bill.bill_id) && state.selectedOccDate === payload.date) {
            renderDrawer(state.currentBillId, { preserveState: true });
          }
        })
        .catch(function(error) {
          state.occurrenceCache[cacheKey] = {
            date: state.selectedOccDate,
            students: 0,
            total_expected: 0,
            paid_today: 0,
            outstanding: 0,
            paid_count: 0,
            unpaid_count: 0,
            items: [],
            byAssignmentId: {},
            error: error.message || 'Could not load date balances.'
          };
          showToast('error', error.message || 'Could not load date balances.');
          if (Number(state.currentBillId) === Number(bill.bill_id)) {
            renderDrawer(state.currentBillId, { preserveState: true });
          }
        })
        .finally(function() {
          delete state.occurrenceLoading[cacheKey];
        });
    }

    function getStudentOccurrenceItem(bill, student) {
      var snapshot = getOccurrenceSnapshotForBill(bill);
      return snapshot && snapshot.byAssignmentId ? snapshot.byAssignmentId[String(student.assignment_id)] || null : null;
    }

    function studentCollectBalance(bill, student) {
      if (bill && bill.bill_type === 'recurring' && state.selectedOccDate) {
        var occurrenceItem = getStudentOccurrenceItem(bill, student);
        return occurrenceItem ? Math.max(Number(occurrenceItem.outstanding || 0), 0) : 0;
      }
      return bal(student);
    }

    function studentDisplayBilled(bill, student) {
      var occurrenceItem = getStudentOccurrenceItem(bill, student);
      if (bill && bill.bill_type === 'recurring' && state.selectedOccDate && occurrenceItem) {
        return Number(occurrenceItem.due_amount || 0);
      }
      return assignmentBilledTotal(student);
    }

    function studentDisplayPaid(bill, student) {
      var occurrenceItem = getStudentOccurrenceItem(bill, student);
      if (bill && bill.bill_type === 'recurring' && state.selectedOccDate && occurrenceItem) {
        return Number(occurrenceItem.paid_on_date || 0);
      }
      return Number(student.amount_paid || 0);
    }

    function studentDisplayStatus(bill, student) {
      var occurrenceItem = getStudentOccurrenceItem(bill, student);
      if (bill && bill.bill_type === 'recurring' && state.selectedOccDate && occurrenceItem) {
        return occurrenceItem.status || student.status;
      }
      return student.status;
    }

    function invalidateOccurrenceCache(billId, occurrenceDate) {
      Object.keys(state.occurrenceCache).forEach(function(cacheKey) {
        var parts = cacheKey.split(':');
        if (String(parts[0]) !== String(billId)) return;
        if (occurrenceDate && String(parts[1]) !== String(occurrenceDate)) return;
        delete state.occurrenceCache[cacheKey];
      });
    }

    function statusClass(status) {
      return ({ paid: 'paid', partial: 'partial', overdue: 'overdue', pending: 'pending' })[status || 'pending'];
    }

    function recurStepDays(recurrence) {
      return ({ daily: 1, weekly: 7, monthly: 30, term: 90, year: 365 })[String(recurrence || '').toLowerCase()] || 0;
    }

    function fmt(dateValue) {
      try { return dateValue ? new Date(dateValue).toLocaleDateString() : '—'; } catch (_) { return '—'; }
    }

    function isoDate(dateValue) {
      return dateValue.getFullYear() + '-' + String(dateValue.getMonth() + 1).padStart(2, '0') + '-' + String(dateValue.getDate()).padStart(2, '0');
    }

