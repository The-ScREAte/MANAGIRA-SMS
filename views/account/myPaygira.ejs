    function getSignoffState(bill) {
      if (!bill) return { enabled: false, hint: '', outstanding: 0 };
      if (bill.bill_type === 'recurring') {
        if (!state.selectedOccDate) {
          return { enabled: false, hint: 'Select a date above before signing off.', outstanding: null };
        }
        if ((bill.signed_off_dates || []).indexOf(state.selectedOccDate) !== -1) {
          return { enabled: false, hint: 'This date has already been signed off.', outstanding: 0 };
        }
        var snapshot = getOccurrenceSnapshotForBill(bill);
        if (!snapshot || snapshot.error) {
          return { enabled: false, hint: 'Date balances are still loading.', outstanding: null };
        }
        var recurringOutstanding = Number(snapshot.outstanding || 0);
        return {
          enabled: recurringOutstanding <= 0,
          hint: recurringOutstanding <= 0
            ? 'Move this fully collected date into finance history.'
            : 'Collect every student due on this date before signing off.',
          outstanding: recurringOutstanding,
        };
      }

      var oneTimeOutstanding = Number(bill.total_outstanding || 0);
      return {
        enabled: oneTimeOutstanding <= 0,
        hint: oneTimeOutstanding <= 0
          ? 'Move this fully collected bill into finance history.'
          : 'Collect the remaining balance before signing off.',
        outstanding: oneTimeOutstanding,
      };
    }

    function smartOccLabel(diff, recurrence) {
      var normalized = String(recurrence || '').toLowerCase();
      if (diff === 0) return 'Today — end of day';
      if (diff === -1) return normalized === 'daily' ? 'Yesterday — end of day' : 'Yesterday';
      if (diff === 1) return normalized === 'daily' ? 'Tomorrow — end of day' : 'Tomorrow';
      if (diff < 0) {
        var absoluteDays = Math.abs(diff);
        if (normalized === 'daily') return absoluteDays + ' days ago';
        if (normalized === 'weekly') {
          var weeksAgo = Math.round(absoluteDays / 7);
          return weeksAgo === 1 ? 'Last week' : weeksAgo + ' weeks ago';
        }
        if (normalized === 'monthly') {
          var monthsAgo = Math.round(absoluteDays / 30);
          return monthsAgo === 1 ? 'Last month' : monthsAgo + ' months ago';
        }
        return absoluteDays + ' days ago';
      }
      if (normalized === 'daily') return 'In ' + diff + ' days';
      if (normalized === 'weekly') {
        var weeksAhead = Math.round(diff / 7);
        return weeksAhead === 1 ? 'Next week' : 'In ' + weeksAhead + ' weeks';
      }
      if (normalized === 'monthly') {
        var monthsAhead = Math.round(diff / 30);
        return monthsAhead === 1 ? 'Next month' : 'In ' + monthsAhead + ' months';
      }
      return 'In ' + diff + ' days';
    }

    function buildOccurrences(bill) {
      var step = recurStepDays(bill.recurrence);
      if (!step || bill.bill_type !== 'recurring') return [];
      var signedOffDates = Array.isArray(bill.signed_off_dates) ? bill.signed_off_dates.reduce(function(map, value) {
        map[String(value)] = true;
        return map;
      }, {}) : {};
      var exactDateList = Array.isArray(bill.scheduled_occurrence_dates) && bill.scheduled_occurrence_dates.length
        ? bill.scheduled_occurrence_dates.slice()
        : null;
      var anchor = bill.due_date ? new Date(bill.due_date) : new Date();
      if (Number.isNaN(anchor.getTime())) anchor = new Date();
      anchor.setHours(0, 0, 0, 0);
      var today = new Date();
      today.setHours(0, 0, 0, 0);

      if (exactDateList) {
        return exactDateList.reduce(function(rows, dateKey) {
          if (!dateKey || signedOffDates[String(dateKey)]) return rows;
          var occurrenceDate = new Date(dateKey + 'T00:00:00');
          if (Number.isNaN(occurrenceDate.getTime())) return rows;
          var diff = Math.round((occurrenceDate - today) / 86400000);
          rows.push({
            date: occurrenceDate,
            kind: diff < 0 ? 'past' : (diff === 0 ? 'due' : 'future'),
            label: fmt(occurrenceDate),
            smart: smartOccLabel(diff, bill.recurrence),
          });
          return rows;
        }, []);
      }

      var scheduleEndIso = bill.recurrence_end_date || bill.term_end_date || '';
      if (scheduleEndIso) {
        var scheduleEnd = new Date(scheduleEndIso + 'T00:00:00');
        if (!Number.isNaN(scheduleEnd.getTime()) && scheduleEnd >= anchor) {
          var exactRows = [];
          var cursor = new Date(anchor.getTime());
          for (var guard = 0; guard < 5000 && cursor <= scheduleEnd; guard += 1) {
            var exactDateKey = isoDate(cursor);
            if (signedOffDates[exactDateKey]) {
              var nextSigned = advanceOccurrenceDate(cursor, bill.recurrence);
              if (!nextSigned || nextSigned.getTime() === cursor.getTime()) break;
              cursor = nextSigned;
              continue;
            }
            var exactDiff = Math.round((cursor - today) / 86400000);
            exactRows.push({
              date: new Date(cursor.getTime()),
              kind: exactDiff < 0 ? 'past' : (exactDiff === 0 ? 'due' : 'future'),
              label: fmt(cursor),
              smart: smartOccLabel(exactDiff, bill.recurrence),
            });
            var nextExact = advanceOccurrenceDate(cursor, bill.recurrence);
            if (!nextExact || nextExact.getTime() === cursor.getTime()) break;
            cursor = nextExact;
          }
          if (exactRows.length) return exactRows;
        }
      }
      var back = bill.recurrence === 'monthly' ? 4 : (bill.recurrence === 'weekly' ? 8 : 14);
      var forward = bill.recurrence === 'monthly' ? 6 : (bill.recurrence === 'weekly' ? 12 : 14);
      var rows = [];
      for (var index = -back; index <= forward; index += 1) {
        var occurrenceDate = new Date(anchor);
        occurrenceDate.setDate(anchor.getDate() + index * step);
        if (signedOffDates[isoDate(occurrenceDate)]) continue;
        var diff = Math.round((occurrenceDate - today) / 86400000);
        rows.push({
          date: occurrenceDate,
          kind: diff < 0 ? 'past' : (diff === 0 ? 'due' : 'future'),
          label: fmt(occurrenceDate),
          smart: smartOccLabel(diff, bill.recurrence),
        });
      }
      return rows;
    }

