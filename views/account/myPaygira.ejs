<%
  function bal(a){ return Math.max(Number(a.amount||0) + Number(a.late_fee_applied||0) - Number(a.amount_paid||0), 0); }
  function statusClass(s){ return ({paid:'paid',partial:'partial',overdue:'overdue',pending:'pending'})[s||'pending']; }
  function recurStepDays(r){ return ({daily:1,weekly:7,monthly:30,term:90,year:365})[String(r||'').toLowerCase()] || 0; }
  function fmtDate(d){ try{ return d ? new Date(d).toLocaleDateString() : '—'; }catch(e){ return '—'; } }
  const currencyCode = (financeCurrency && financeCurrency.code) ? financeCurrency.code : 'USD';
  const currencyLocale = (financeCurrency && financeCurrency.locale) ? financeCurrency.locale : 'en-US';
  const moneyFmt = typeof formatMoney === 'function'
    ? formatMoney
    : function(v){ return Number(v||0).toLocaleString(undefined,{minimumFractionDigits:2,maximumFractionDigits:2}); };
  // group assignments by bill
  const _byBill = {};
  (assignments || []).forEach(a => {
    if (!_byBill[a.bill_id]) _byBill[a.bill_id] = [];
    _byBill[a.bill_id].push(a);
  });
%>
<style>
  :root{
    --fin-bg:#080d1a; --fin-surface:#0e1426; --fin-surface-2:#131b33;
    --fin-border:rgba(255,255,255,.08); --fin-text:#e9eef8; --fin-muted:#8a93a8;
    --fin-teal:#00D4AA; --fin-gold:#F5C842; --fin-red:#FF4D6D; --fin-purple:#7B61FF;
    --fin-org:var(--org-primary-color, #01535b); --fin-org-hover:var(--org-primary-hover, #014a51);
  }
  .mp-wrap{ background:var(--fin-bg); color:var(--fin-text); min-height:<%= isEmbedded ? '100vh' : 'calc(100vh - 80px)' %>; font-family:'Space Grotesk','DM Sans',system-ui,sans-serif; padding:<%= isEmbedded ? '10px 12px 14px' : 'clamp(18px, 3vw, 32px) clamp(12px, 2.5vw, 20px) 64px' %>; }
  .mp-container{ max-width:<%= isEmbedded ? 'none' : '1280px' %>; width:100%; margin:0 auto; }
  .mp-head{ display:flex; justify-content:space-between; align-items:center; gap:12px; flex-wrap:wrap; margin-bottom:<%= isEmbedded ? '14px' : '22px' %>; }
  .mp-head h1{ margin:0; font-size:<%= isEmbedded ? '1.35rem' : '1.9rem' %>; font-weight:800; letter-spacing:-.02em; }
  .mp-head h1 .accent{ color:var(--fin-teal); font-style:italic; }
  .mp-head p{ margin:2px 0 0; color:var(--fin-muted); font-size:<%= isEmbedded ? '.78rem' : '.9rem' %>; }
  .paygira-secure-badge{ display:inline-flex; align-items:center; gap:6px; padding:6px 12px; border-radius:999px;
    background:linear-gradient(135deg, rgba(0,212,170,.18), rgba(0,212,170,.08)); border:1px solid rgba(0,212,170,.45);
    color:var(--fin-teal); font-size:.66rem; font-weight:700; letter-spacing:.08em; text-transform:uppercase; }

  .mp-stats{ display:grid; grid-template-columns:repeat(auto-fit, minmax(160px,1fr)); gap:10px; margin-bottom:18px; }
  .mp-stat{ background:linear-gradient(180deg, var(--fin-surface), var(--fin-surface-2)); border:1px solid var(--fin-border); border-radius:14px; padding:12px 14px; }
  .mp-stat .label{ font-size:.66rem; color:var(--fin-muted); text-transform:uppercase; letter-spacing:.08em; font-weight:700; }
  .mp-stat .value{ font-size:1.15rem; font-weight:800; margin-top:4px; font-family:'JetBrains Mono',monospace; }
  .mp-stat.teal .value{ color:var(--fin-teal); }
  .mp-stat.gold .value{ color:var(--fin-gold); }
  .mp-stat.red .value{ color:var(--fin-red); }

  .mp-section-title{ font-size:.76rem; font-weight:700; letter-spacing:.06em; text-transform:uppercase; color:var(--fin-muted); margin:18px 0 10px; display:flex; align-items:center; gap:10px; }
  .mp-section-title .ln{ flex:1; height:1px; background:var(--fin-border); }

  /* Bill cards grid */
  .mp-bill-grid{ display:grid; grid-template-columns:repeat(auto-fill, minmax(280px,1fr)); gap:12px; }
  .mp-bill-card{ background:linear-gradient(180deg, var(--fin-surface), var(--fin-surface-2));
    border:1px solid var(--fin-border); border-radius:14px; padding:14px; cursor:pointer;
    transition:all .15s; display:flex; flex-direction:column; gap:8px; position:relative; }
  .mp-bill-card:hover{ transform:translateY(-2px); border-color:rgba(0,212,170,.45); box-shadow:0 8px 22px rgba(0,212,170,.10); }
  .mp-bill-card .bc-title{ font-weight:700; font-size:.98rem; line-height:1.2; padding-right:60px; }
  .mp-bill-card .bc-meta{ color:var(--fin-muted); font-size:.72rem; display:flex; flex-wrap:wrap; gap:6px 10px; }
  .mp-bill-card .bc-amts{ display:grid; grid-template-columns:repeat(3,1fr); gap:8px; margin-top:6px; padding-top:8px; border-top:1px dashed var(--fin-border); }
  .mp-bill-card .bc-amts > div{ font-size:.66rem; color:var(--fin-muted); text-transform:uppercase; letter-spacing:.05em; }
  .mp-bill-card .bc-amts strong{ display:block; font-family:'JetBrains Mono',monospace; font-size:.85rem; font-weight:700; color:var(--fin-text); margin-top:2px; }
  .mp-bill-card .bc-amts .out strong{ color:var(--fin-gold); }
  .mp-bill-card .bc-amts .col strong{ color:var(--fin-teal); }
  .mp-bill-card .bc-tag{ position:absolute; top:12px; right:12px; font-size:.58rem; padding:3px 8px; border-radius:999px; text-transform:uppercase; letter-spacing:.06em; font-weight:700;
    background:rgba(123,97,255,.15); color:var(--fin-purple); border:1px solid rgba(123,97,255,.3); }
  .mp-bill-card.recurring .bc-tag{ background:rgba(245,200,66,.15); color:var(--fin-gold); border:1px solid rgba(245,200,66,.3); }

  .mp-empty{ text-align:center; padding:36px 18px; color:var(--fin-muted); border:1px dashed var(--fin-border); border-radius:14px; }

  .mp-flash{ padding:10px 14px; border-radius:10px; margin-bottom:12px; font-weight:600; font-size:.85rem; }
  .mp-flash.success{ background:rgba(0,212,170,.12); color:var(--fin-teal); border:1px solid rgba(0,212,170,.3); }
  .mp-flash.error{ background:rgba(255,77,109,.12); color:var(--fin-red); border:1px solid rgba(255,77,109,.3); }

  /* Drawer */
  .mp-drawer-bg{ display:none; position:fixed; inset:0; background:rgba(0,0,0,.72); z-index:1200; }
  .mp-drawer-bg.open{ display:block; }
  .mp-drawer{ position:fixed; top:0; right:0; height:100vh; width:min(720px,100vw); background:var(--fin-surface);
    border-left:1px solid var(--fin-border); z-index:1201; transform:translateX(100%); transition:transform .25s; display:flex; flex-direction:column; color:var(--fin-text); }
  .mp-drawer.open{ transform:translateX(0); }
  .mp-drawer-head{ padding:16px 18px; border-bottom:1px solid var(--fin-border); display:flex; justify-content:space-between; align-items:center; gap:12px; background:var(--fin-surface-2); flex-shrink:0; }
  .mp-drawer-head-info{ min-width:0; flex:1; }
  .mp-drawer-head h2{ margin:0; font-size:1.05rem; font-weight:800; color:var(--fin-text); line-height:1.2; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
  .mp-drawer-head .sub{ font-size:.72rem; color:var(--fin-muted); margin-top:4px; display:flex; flex-wrap:wrap; gap:5px; }
  .mp-drawer-head .sub-chip{ display:inline-flex; align-items:center; gap:4px; padding:2px 8px; border-radius:999px; font-size:.62rem; font-weight:700; letter-spacing:.04em; text-transform:uppercase; background:rgba(255,255,255,.06); border:1px solid var(--fin-border); color:var(--fin-muted); }
  .mp-drawer-head .sub-chip.recur{ background:rgba(245,200,66,.12); border-color:rgba(245,200,66,.3); color:var(--fin-gold); }
  .mp-drawer-head .sub-chip.students{ background:rgba(0,212,170,.1); border-color:rgba(0,212,170,.25); color:var(--fin-teal); }
  .mp-drawer-body{ flex:1; overflow-y:auto; padding:0; color:var(--fin-text); }
  .mp-close-btn{ width:30px; height:30px; border-radius:50%; background:rgba(255,255,255,.05); border:1px solid var(--fin-border); color:var(--fin-muted); cursor:pointer; display:inline-flex; align-items:center; justify-content:center; font-size:1rem; line-height:1; flex-shrink:0; transition:all .15s; }
  .mp-close-btn:hover{ background:rgba(255,77,109,.18); border-color:var(--fin-red); color:var(--fin-red); }

  /* Sticky occurrence header */
  .mp-occ-sticky{ position:sticky; top:0; z-index:10; background:var(--fin-surface); border-bottom:1px solid var(--fin-border); padding:10px 18px 8px; display:flex; align-items:center; justify-content:space-between; gap:10px; }
  .mp-occ-toggle{ display:inline-flex; background:var(--fin-bg); border:1px solid var(--fin-border); border-radius:999px; padding:3px; gap:2px; }
  .mp-occ-toggle button{ background:transparent; border:none; color:var(--fin-muted); padding:4px 12px; border-radius:999px; cursor:pointer; font-size:.7rem; font-weight:700; transition:all .15s; }
  .mp-occ-toggle button.active{ background:var(--fin-teal); color:#062018; }
  .mp-occ-count{ font-size:.66rem; color:var(--fin-muted); font-weight:600; white-space:nowrap; }

  .mp-drawer-inner{ padding:14px 18px; }
  .mp-occ-list{ display:grid; gap:5px; margin-bottom:14px; }
  .mp-occ-row{ display:flex; align-items:center; gap:10px; padding:8px 12px; background:var(--fin-bg); border:1px solid var(--fin-border); border-radius:10px; font-size:.8rem; color:var(--fin-text); cursor:pointer; transition:all .15s; user-select:none; }
  .mp-occ-row:hover{ border-color:rgba(0,212,170,.35); background:rgba(0,212,170,.04); }
  .mp-occ-row.selected{ border-color:var(--fin-teal); background:rgba(0,212,170,.08); box-shadow:0 0 0 1px rgba(0,212,170,.2); }
  .mp-occ-row.past{ border-color:rgba(255,77,109,.18); }
  .mp-occ-row.past:hover{ border-color:rgba(255,77,109,.45); }
  .mp-occ-row.past.selected{ border-color:var(--fin-red); background:rgba(255,77,109,.08); box-shadow:0 0 0 1px rgba(255,77,109,.2); }
  .mp-radio-dot{ width:16px; height:16px; border-radius:50%; border:2px solid var(--fin-border); flex-shrink:0; display:flex; align-items:center; justify-content:center; transition:all .15s; }
  .mp-occ-row.selected .mp-radio-dot{ border-color:var(--fin-teal); background:var(--fin-teal); }
  .mp-occ-row.past.selected .mp-radio-dot{ border-color:var(--fin-red); background:var(--fin-red); }
  .mp-radio-dot::after{ content:''; width:6px; height:6px; border-radius:50%; background:#062018; opacity:0; transition:opacity .1s; }
  .mp-occ-row.selected .mp-radio-dot::after{ opacity:1; }
  .mp-occ-row .dot{ width:7px; height:7px; border-radius:50%; background:var(--fin-muted); flex-shrink:0; }
  .mp-occ-row.past .dot{ background:var(--fin-red); }
  .mp-occ-row.due .dot{ background:var(--fin-gold); }
  .mp-occ-row.future .dot{ background:var(--fin-purple); }
  .mp-occ-row .occ-info{ flex:1; min-width:0; }
  .mp-occ-row .when{ font-weight:600; color:var(--fin-text); font-size:.82rem; }
  .mp-occ-row .lbl{ font-size:.65rem; color:var(--fin-muted); margin-top:1px; }

  /* Calendar inline in sticky bar */
  .mp-occ-sticky-right{ display:flex; align-items:center; gap:6px; flex-shrink:0; }
  .mp-occ-sticky-right label{ font-size:.7rem; color:var(--fin-muted); white-space:nowrap; }
  .mp-occ-sticky-right input[type=date]{ background:var(--fin-bg); border:1px solid var(--fin-border); border-radius:8px; color:var(--fin-text); padding:5px 9px; font-size:.74rem; font-family:inherit; cursor:pointer; }
  .mp-occ-sticky-right input[type=date]:focus{ outline:none; border-color:var(--fin-teal); }

  /* Occurrence popup — absolute to .mp-drawer, not inside overflow:auto container */
  .mp-occ-popup{ position:absolute; left:0; right:0; z-index:50; background:var(--fin-surface-2); border-bottom:1px solid var(--fin-border); box-shadow:0 10px 36px rgba(0,0,0,.65); max-height:300px; overflow-y:auto; display:none; overscroll-behavior:contain; padding:8px; }
  .mp-occ-popup.open{ display:block; }

  /* Day summary */
  .mp-day-summary{ display:grid; grid-template-columns:repeat(4,1fr); gap:8px; margin-bottom:14px; padding:12px 14px; background:linear-gradient(135deg,rgba(0,212,170,.09),rgba(0,212,170,.03)); border:1px solid rgba(0,212,170,.22); border-radius:12px; }
  .mp-day-summary .ds-item .ds-lbl{ font-size:.58rem; color:var(--fin-muted); text-transform:uppercase; letter-spacing:.06em; font-weight:700; }
  .mp-day-summary .ds-item .ds-val{ font-size:.9rem; font-weight:800; font-family:'JetBrains Mono',monospace; margin-top:2px; }
  .mp-day-summary .ds-item.teal .ds-val{ color:var(--fin-teal); }
  .mp-day-summary .ds-item.gold .ds-val{ color:var(--fin-gold); }
  .mp-day-summary .ds-item.red .ds-val{ color:var(--fin-red); }

  /* Collect gating */
  .mp-collect-notice{ font-size:.72rem; color:var(--fin-gold); background:rgba(245,200,66,.08); border:1px solid rgba(245,200,66,.2); border-radius:8px; padding:7px 12px; margin-bottom:12px; display:flex; align-items:center; gap:6px; }
  .mp-collect-notice svg{ flex-shrink:0; }

  .mp-student-list{ display:grid; gap:8px; }
  .mp-student-toolbar{ display:flex; align-items:center; justify-content:space-between; gap:10px; flex-wrap:wrap; margin-bottom:12px; }
  .mp-student-toolbar-actions{ display:flex; align-items:center; gap:8px; flex-wrap:nowrap; max-width:100%; overflow-x:auto; padding-bottom:2px; }
  .mp-signoff-hint{ font-size:.68rem; color:var(--fin-muted); font-weight:700; }
  .mp-bulk-toggle.is-active{ background:rgba(0,212,170,.12); border:1px solid rgba(0,212,170,.28); color:var(--fin-teal); }
  .mp-bulk-summary{ display:flex; align-items:center; justify-content:flex-end; gap:8px; flex-wrap:wrap; font-size:.72rem; color:var(--fin-muted); font-weight:700; margin-left:auto; }
  .mp-bulk-warning{ color:var(--fin-gold); }
  .mp-student-row{ display:flex; flex-direction:column; gap:6px; padding:10px 12px; background:var(--fin-bg); border:1px solid var(--fin-border); border-radius:12px; color:var(--fin-text); }
  .mp-student-row.bulk-enabled{ border-color:rgba(0,212,170,.18); }
  .mp-student-row.bulk-selected{ border-color:rgba(0,212,170,.4); background:rgba(0,212,170,.06); box-shadow:0 0 0 1px rgba(0,212,170,.15); }
  .mp-stu-top{ display:flex; align-items:center; gap:10px; }
  .mp-stu-top .who{ display:flex; align-items:center; gap:10px; flex:1; min-width:0; }
  .mp-student-row .who img{ width:32px; height:32px; border-radius:50%; object-fit:cover; border:1px solid var(--fin-border); flex-shrink:0; }
  .mp-student-row .who .nm{ font-weight:700; font-size:.9rem; color:var(--fin-text); white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
  .mp-student-row .who .cls{ font-size:.7rem; color:var(--fin-muted); }
  .mp-student-row .amts{ display:flex; flex-wrap:wrap; gap:4px 12px; font-family:'JetBrains Mono',monospace; font-size:.76rem; padding-left:42px; }
  .mp-student-row .amts > div{ color:var(--fin-text); }
  .mp-student-row .amts .out{ color:var(--fin-gold); font-weight:700; }
  .mp-student-row .amts .pd{ color:var(--fin-teal); }
  .mp-stu-top .acts{ display:flex; gap:6px; align-items:center; flex-shrink:0; }
  .mp-bulk-pick{ display:inline-flex; align-items:center; gap:7px; padding:4px 8px; border-radius:999px; border:1px solid var(--fin-border); color:var(--fin-muted); font-size:.64rem; font-weight:700; letter-spacing:.04em; text-transform:uppercase; cursor:pointer; }
  .mp-bulk-pick input{ width:15px; height:15px; accent-color:var(--fin-teal); cursor:pointer; }

  .mp-status{ display:inline-block; padding:2px 8px; border-radius:999px; font-size:.6rem; font-weight:700; letter-spacing:.05em; text-transform:uppercase; }
  .mp-status.paid{ background:rgba(0,212,170,.15); color:var(--fin-teal); border:1px solid rgba(0,212,170,.3); }
  .mp-status.partial{ background:rgba(245,200,66,.15); color:var(--fin-gold); border:1px solid rgba(245,200,66,.3); }
  .mp-status.overdue{ background:rgba(255,77,109,.15); color:var(--fin-red); border:1px solid rgba(255,77,109,.3); }
  .mp-status.pending{ background:rgba(138,147,168,.18); color:#c5cbd9; border:1px solid rgba(138,147,168,.35); }

  .mp-btn{ display:inline-flex; align-items:center; gap:6px; padding:6px 11px; border-radius:8px; font-size:.74rem; font-weight:700; cursor:pointer; border:1px solid transparent; text-decoration:none; background:var(--fin-org); color:#fff; }
  .mp-btn.primary{ background:var(--fin-org); color:#fff; }
  .mp-btn.primary:hover{ transform:translateY(-1px); background:var(--fin-org-hover); }
  .mp-btn.ghost{ background:var(--fin-org); color:#fff; border:1px solid transparent; }
  .mp-btn.ghost:hover{ background:var(--fin-org-hover); }
  .mp-btn.danger{ background:var(--fin-red); color:#fff; border-color:transparent; }
  .mp-btn.danger::before{ content:'🗑'; font-size:.82em; }
  .mp-btn.danger:hover{ background:#e11d48; }
  .mp-btn.tiny{ padding:4px 8px; font-size:.66rem; }
  .mp-btn:disabled{ opacity:.45; cursor:not-allowed; transform:none; }

  /* Collect modal */
  .mp-modal-bg{ display:none; position:fixed; inset:0; background:rgba(0,0,0,.78); z-index:1400; align-items:center; justify-content:center; padding:12px; overflow-y:auto; }
  .mp-modal-bg.open{ display:flex; }
  .mp-modal{ background:var(--fin-surface); border:1px solid var(--fin-border); border-radius:14px; padding:18px; max-width:480px; width:100%; max-height:calc(100vh - 24px); overflow-y:auto; color:var(--fin-text); }
  .mp-modal.mp-modal-wide{ max-width:760px; }
  .mp-modal h3{ margin:0 0 12px; font-size:1rem; display:flex; align-items:center; justify-content:space-between; gap:8px; color:var(--fin-text); }
  .mp-form-grid{ display:grid; grid-template-columns:repeat(2,1fr); gap:8px 10px; }
  .mp-form-grid .span2{ grid-column:1 / -1; }
  .mp-field label{ display:block; font-size:.62rem; color:var(--fin-muted); margin-bottom:3px; font-weight:700; letter-spacing:.05em; text-transform:uppercase; }
  .mp-field input, .mp-field select, .mp-field textarea{
    width:100%; padding:8px 11px; border-radius:8px; background:var(--fin-bg);
    border:1px solid var(--fin-border); color:var(--fin-text); font-family:inherit; font-size:.85rem;
  }
  .mp-field textarea{ resize:vertical; min-height:50px; }
  .mp-field input:focus, .mp-field select:focus, .mp-field textarea:focus{ outline:none; border-color:var(--fin-teal); }
  .mp-modal-actions{ display:flex; gap:8px; justify-content:flex-end; margin-top:12px; position:sticky; bottom:0; padding-top:10px; background:linear-gradient(to top, var(--fin-surface) 60%, transparent); }
  .mp-bulk-context{ display:flex; gap:8px; flex-wrap:wrap; margin-bottom:12px; }
  .mp-bulk-context-chip{ display:inline-flex; align-items:center; gap:6px; padding:5px 10px; border-radius:999px; border:1px solid var(--fin-border); background:rgba(255,255,255,.05); color:var(--fin-muted); font-size:.68rem; font-weight:700; }
  .mp-bulk-total{ display:flex; align-items:center; justify-content:space-between; gap:10px; padding:10px 12px; border-radius:10px; background:rgba(0,212,170,.08); border:1px solid rgba(0,212,170,.22); margin:12px 0; }
  .mp-bulk-total span{ color:var(--fin-muted); font-size:.72rem; font-weight:700; }
  .mp-bulk-total strong{ color:var(--fin-teal); font-size:.95rem; font-family:'JetBrains Mono',monospace; }
  .mp-bulk-list{ display:grid; gap:8px; max-height:360px; overflow-y:auto; padding-right:2px; }
  .mp-bulk-row{ display:grid; grid-template-columns:minmax(0,1.5fr) minmax(110px,140px) minmax(90px,110px); gap:10px; align-items:center; padding:10px 12px; border:1px solid var(--fin-border); border-radius:12px; background:var(--fin-bg); }
  .mp-bulk-row.disabled{ opacity:.55; }
  .mp-bulk-student{ display:flex; align-items:center; gap:10px; min-width:0; }
  .mp-bulk-student input{ width:16px; height:16px; accent-color:var(--fin-teal); cursor:pointer; }
  .mp-bulk-student img{ width:34px; height:34px; border-radius:50%; object-fit:cover; border:1px solid var(--fin-border); flex-shrink:0; }
  .mp-bulk-student-copy{ min-width:0; }
  .mp-bulk-student-name{ font-size:.88rem; font-weight:700; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
  .mp-bulk-student-meta{ font-size:.68rem; color:var(--fin-muted); margin-top:2px; }
  .mp-bulk-amount input{ text-align:right; font-family:'JetBrains Mono',monospace; }
  .mp-bulk-balance{ text-align:right; color:var(--fin-gold); font-size:.78rem; font-weight:700; font-family:'JetBrains Mono',monospace; }
  .mp-signoff-summary{ padding:12px 14px; border-radius:12px; border:1px solid rgba(0,212,170,.2); background:rgba(0,212,170,.08); color:var(--fin-text); font-size:.8rem; line-height:1.45; }
  .mp-signoff-summary strong{ color:var(--fin-teal); }
  .mp-toast-stack{ position:fixed; top:18px; right:18px; z-index:1600; display:grid; gap:8px; pointer-events:none; }
  .mp-toast{ min-width:280px; max-width:min(420px, calc(100vw - 32px)); padding:12px 14px; border-radius:12px; border:1px solid var(--fin-border); background:var(--fin-surface-2); color:var(--fin-text); box-shadow:0 16px 40px rgba(0,0,0,.35); opacity:0; transform:translateY(-8px); transition:opacity .18s ease, transform .18s ease; font-size:.82rem; font-weight:700; }
  .mp-toast.show{ opacity:1; transform:translateY(0); }
  .mp-toast.success{ border-color:rgba(0,212,170,.3); color:var(--fin-teal); }
  .mp-toast.error{ border-color:rgba(255,77,109,.3); color:var(--fin-red); }

  @media (max-width:960px){
    .mp-head{ align-items:flex-start; }
    .mp-head h1{ font-size:1.45rem; }
    .mp-head p{ max-width:44ch; }
    .mp-stats{ grid-template-columns:repeat(2, minmax(0, 1fr)); }
    .mp-bill-grid{ grid-template-columns:repeat(auto-fit, minmax(240px,1fr)); }
    .mp-bill-card .bc-amts{ grid-template-columns:repeat(3,minmax(0,1fr)); font-size:.72rem; }
    .mp-stu-top .acts{ flex-wrap:wrap; }
    .mp-modal-actions{ flex-wrap:wrap; }
  }

  @media (max-width:640px){
    .mp-wrap{ padding:8px; }
    .mp-head{ gap:10px; }
    .mp-head h1{ font-size:1.1rem; }
    .mp-head p{ font-size:.82rem; }
    .paygira-secure-badge{ font-size:.6rem; padding:6px 10px; }
    .mp-stats{ grid-template-columns:1fr; }
    .mp-bill-grid{ grid-template-columns:1fr; }
    .mp-bill-card{ padding:12px; }
    .mp-bill-card .bc-title{ padding-right:0; }
    .mp-bill-card .bc-tag{ position:static; align-self:flex-start; margin-bottom:2px; }
    .mp-bill-card .bc-amts{ grid-template-columns:repeat(3,minmax(0,1fr)); font-size:.65rem; }
    .mp-form-grid{ grid-template-columns:1fr; }
    .mp-student-row .amts{ flex-direction:column; gap:4px; align-items:flex-start; }
    .mp-stu-top .acts{ flex-wrap:wrap; }
    .mp-day-summary{ grid-template-columns:repeat(2,1fr); }
    .mp-occ-sticky{ flex-wrap:wrap; gap:6px; }
    .mp-drawer{ width:100vw; }
    .mp-drawer-head{ padding:12px; }
    .mp-drawer-body{ padding:12px; }
    .mp-occ-row .mp-status{ display:none; }
    .mp-student-toolbar{ align-items:stretch; }
    .mp-bulk-summary{ justify-content:flex-start; }
    .mp-bulk-row{ grid-template-columns:1fr; }
    .mp-bulk-balance{ text-align:left; }
    .mp-toast-stack{ top:12px; right:12px; left:12px; }
    .mp-toast{ min-width:0; max-width:none; }
  }

  @media (max-width:420px){
    .mp-wrap{ padding:8px 6px 20px; }
    .mp-stat{ padding:11px 12px; }
    .mp-stat .value{ font-size:1rem; }
    .mp-drawer-head{ flex-wrap:nowrap; }
    .mp-close-btn{ width:30px !important; flex-shrink:0; }
    .mp-occ-row .mp-status{ display:none; }
  }
</style>

<div class="mp-wrap">
  <div class="mp-container">

    <div class="mp-head">
      <div>
        <h1>Pay<span class="accent">Gira</span> — My Collections</h1>
      </div>
      <span class="paygira-secure-badge">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor"><path d="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4z"/></svg>
        Secure
      </span>
    </div>

    <% if (messages && messages.success && messages.success.length) { %>
      <div class="mp-flash success"><%= messages.success[0] %></div>
    <% } %>
    <% if (messages && messages.error && messages.error.length) { %>
      <div class="mp-flash error"><%= messages.error[0] %></div>
    <% } %>

    <div class="mp-stats">
      <div class="mp-stat"><div class="label">Bills</div><div class="value" id="mpStatBills"><%= stats.bills %></div></div>
      <div class="mp-stat"><div class="label">Students</div><div class="value" id="mpStatStudents"><%= stats.students %></div></div>
      <div class="mp-stat teal"><div class="label">Collected</div><div class="value" id="mpStatCollected"><%= moneyFmt(stats.collected) %></div></div>
      <div class="mp-stat gold"><div class="label">Outstanding</div><div class="value" id="mpStatOutstanding"><%= moneyFmt(stats.outstanding) %></div></div>
    </div>

    <% if (!bills.length) { %>
      <div class="mp-empty">
        <div style="font-size:2rem;margin-bottom:6px;">📋</div>
        <div>No bills are assigned to you yet. An admin can make you a collector when creating a bill.</div>
      </div>
    <% } else { %>
      <div class="mp-section-title"><span>Assigned Bills</span><span class="ln"></span><span><%= bills.length %></span></div>
      <div class="mp-bill-grid">
        <% bills.forEach(b => {
             const kids = _byBill[b.bill_id] || [];
             const isRecurring = String(b.bill_type) === 'recurring';
        %>
          <div class="mp-bill-card <%= isRecurring ? 'recurring' : '' %>"
               data-bill-id="<%= b.bill_id %>"
               onclick="mpOpenBill(<%= b.bill_id %>)">
            <span class="bc-tag"><%= isRecurring ? (b.recurrence || 'recurring') : (b.bill_type || 'one-time') %></span>
            <div class="bc-title"><%= b.title %></div>
            <div class="bc-meta">
              <span>📅 Due <%= fmtDate(b.due_date) %></span>
              <span>👥 <%= b.assigned_count %> student<%= Number(b.assigned_count) === 1 ? '' : 's' %></span>
            </div>
            <div class="bc-amts">
              <div>Billed<strong class="bc-billed"><%= moneyFmt(b.total_amount) %></strong></div>
              <div class="col">Collected<strong class="bc-collected"><%= moneyFmt(b.total_paid) %></strong></div>
              <div class="out">Outstanding<strong class="bc-outstanding"><%= moneyFmt(b.total_outstanding) %></strong></div>
            </div>
          </div>
        <% }); %>
      </div>
    <% } %>
  </div>
</div>

<!-- Bill detail drawer -->
