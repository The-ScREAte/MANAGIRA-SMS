      var popup = document.getElementById('mpOccPopup');
      if (popup) {
        popup.innerHTML = occRowsHtml ? '<div class="mp-occ-list" id="mpOccList">' + occRowsHtml + '</div>' : '';
        popup.classList.remove('open');
      }

      syncOccurrenceFilterButtons();
      filterOccurrenceRows(state.occFilter);
      syncOccurrenceSelectionDom();

      if (popup) {
        popup.onclick = function(event) {
          var row = event.target.closest('.mp-occ-row');
          if (!row) return;
          state.selectedOccDate = row.getAttribute('data-date') || '';
          state.selectedOccLabel = row.getAttribute('data-label') || '';
          closeOccPopup();
          renderDrawer(state.currentBillId, { preserveState: true });
        };
      }

      var calendar = document.getElementById('mpOccCalendar');
      if (calendar) {
        calendar.onchange = function() {
          var value = calendar.value;
          if (!value) return;
          var occList = document.getElementById('mpOccList');
          var match = occList ? occList.querySelector('.mp-occ-row[data-date="' + value + '"]') : null;
          state.selectedOccDate = value;
          state.selectedOccLabel = match
            ? (match.getAttribute('data-label') || fmt(value))
            : new Date(value + 'T00:00:00').toLocaleDateString();
          closeOccPopup();
          renderDrawer(state.currentBillId, { preserveState: true });
        };
      }

      var toggle = document.getElementById('mpOccToggle');
      if (toggle) {
        toggle.onclick = function(event) {
          var button = event.target.closest('button[data-filter]');
          if (!button) return;
          var nextFilter = button.getAttribute('data-filter');
          var popupNode = document.getElementById('mpOccPopup');
          var wasOpen = popupNode && popupNode.classList.contains('open');
          var isSameFilter = state.occFilter === nextFilter;
          state.occFilter = nextFilter;
          syncOccurrenceFilterButtons();
          filterOccurrenceRows(nextFilter);
          if (popupNode && isSameFilter && wasOpen) {
            closeOccPopup();
            return;
          }
          openOccPopup();
        };
      }

      var bulkToggle = body.querySelector('#mpBulkToggle');
      if (bulkToggle) {
        bulkToggle.onclick = function() {
          state.bulkMode = !state.bulkMode;
          if (!state.bulkMode) state.bulkSelection = {};
          renderDrawer(state.currentBillId, { preserveState: true });
        };
      }

      var bulkSelectAll = body.querySelector('#mpBulkSelectAll');
      if (bulkSelectAll) {
        bulkSelectAll.onclick = function() {
          (bill.students || []).forEach(function(student) {
            if (studentCollectBalance(bill, student) > 0) state.bulkSelection[String(student.assignment_id)] = true;
          });
          renderDrawer(state.currentBillId, { preserveState: true });
        };
      }

      var bulkClear = body.querySelector('#mpBulkClear');
      if (bulkClear) {
        bulkClear.onclick = function() {
          state.bulkSelection = {};
          renderDrawer(state.currentBillId, { preserveState: true });
        };
      }

      var bulkReview = body.querySelector('#mpBulkReview');
      if (bulkReview) {
        bulkReview.onclick = function() {
          openBulkReview();
        };
      }

      var signoffButton = body.querySelector('#mpSignOffBtn');
      if (signoffButton) {
        signoffButton.onclick = function() {
          mpOpenSignoff();
        };
      }

      Array.prototype.forEach.call(body.querySelectorAll('.mp-bulk-check'), function(input) {
        input.onchange = function() {
          var assignmentId = String(input.getAttribute('data-assignment-id') || '');
          if (!assignmentId) return;
          if (input.checked) state.bulkSelection[assignmentId] = true;
          else delete state.bulkSelection[assignmentId];
          renderDrawer(state.currentBillId, { preserveState: true });
        };
      });

      body.onclick = function(event) {
        if (!event.target.closest('.mp-occ-sticky') && !event.target.closest('#mpOccPopup')) closeOccPopup();
      };

      refreshCollectButtons();
      body.scrollTop = preservedScrollTop;
    }

    function mergePaymentIntoData(payment) {
      var bill = byId[payment.bill_id];
      if (!bill) return;
      var student = (bill.students || []).find(function(entry) {
        return Number(entry.assignment_id) === Number(payment.assignment_id);
      });
      if (!student) return;
      student.first_name = payment.first_name != null ? payment.first_name : student.first_name;
      student.last_name = payment.last_name != null ? payment.last_name : student.last_name;
      student.image_url = payment.image_url != null ? payment.image_url : student.image_url;
      student.class_name = payment.class_name != null ? payment.class_name : student.class_name;
      student.amount = payment.amount != null ? Number(payment.amount) : Number(student.amount || 0);
      student.amount_paid = payment.amount_paid != null ? Number(payment.amount_paid) : Number(student.amount_paid || 0);
      student.late_fee_applied = payment.late_fee_applied != null ? Number(payment.late_fee_applied) : Number(student.late_fee_applied || 0);
      student.status = payment.status || student.status;
      syncBillTotals(bill);
    }

    function applyPayments(payments) {
      var touchedBillIds = {};
      (payments || []).forEach(function(payment) {
        mergePaymentIntoData(payment);
        if (payment && payment.bill_id) invalidateOccurrenceCache(payment.bill_id, payment.occurrence_date || '');
        touchedBillIds[String(payment.bill_id)] = true;
      });
      Object.keys(touchedBillIds).forEach(function(billId) {
        refreshBillCard(byId[billId]);
      });
      refreshDashboardStats();
      if (state.currentBillId != null) renderDrawer(state.currentBillId, { preserveState: true });
    }

    function removeBillFromState(billId) {
      DATA = DATA.filter(function(entry) {
        return Number(entry.bill_id) !== Number(billId);
      });
      delete byId[billId];
      var card = document.querySelector('.mp-bill-card[data-bill-id="' + billId + '"]');
      if (card && card.parentNode) card.parentNode.removeChild(card);
      if (Number(state.currentBillId) === Number(billId)) {
        mpCloseBill();
        state.currentBillId = null;
      }
      refreshDashboardStats();
    }

    function applySignoff(signoff) {
      if (!signoff) return;
      var bill = byId[signoff.bill_id];
      if (!bill) return;
      if (signoff.occurrence_date) {
        var signedOffDates = Array.isArray(bill.signed_off_dates) ? bill.signed_off_dates.slice() : [];
        if (signedOffDates.indexOf(signoff.occurrence_date) === -1) signedOffDates.push(signoff.occurrence_date);
        signedOffDates.sort();
        bill.signed_off_dates = signedOffDates;
        invalidateOccurrenceCache(signoff.bill_id, signoff.occurrence_date);
        if (state.selectedOccDate === signoff.occurrence_date) {
          state.selectedOccDate = '';
          state.selectedOccLabel = '';
          state.bulkMode = false;
          state.bulkSelection = {};
        }
        if (!buildOccurrences(bill).length && Number(bill.total_outstanding || 0) <= 0) {
          removeBillFromState(signoff.bill_id);
          return;
        }
        if (Number(state.currentBillId) === Number(signoff.bill_id)) {
          renderDrawer(state.currentBillId, { preserveState: true });
        }
        refreshDashboardStats();
        return;
      }
      removeBillFromState(signoff.bill_id);
    }

    function buildBulkReviewRow(student) {
      var bill = currentBill();
      var balance = studentCollectBalance(bill, student);
      var fullName = [student.first_name, student.last_name].filter(Boolean).join(' ').trim() || 'Student';
      return '' +
        '<div class="mp-bulk-row" data-assignment-id="' + student.assignment_id + '">' +
          '<label class="mp-bulk-student">' +
            '<input type="checkbox" class="mp-bulk-item-check" checked>' +
            '<img src="' + escapeHtml(pickImage(student.image_url)) + '" alt="">' +
            '<div class="mp-bulk-student-copy">' +
              '<div class="mp-bulk-student-name">' + escapeHtml(fullName) + '</div>' +
              '<div class="mp-bulk-student-meta">' + escapeHtml(student.class_name || '—') + ' · Balance ' + escapeHtml(money(balance)) + '</div>' +
            '</div>' +
          '</label>' +
          '<div class="mp-field mp-bulk-amount"><label>Amount</label><input type="number" class="mp-bulk-item-amount" min="0.01" step="0.01" max="' + balance.toFixed(2) + '" value="' + balance.toFixed(2) + '"></div>' +
          '<div class="mp-bulk-balance">Max ' + escapeHtml(money(balance)) + '</div>' +
        '</div>';
    }

    function refreshBulkModalTotals() {
      var total = 0;
      var count = 0;
      Array.prototype.forEach.call(document.querySelectorAll('#mpBulkList .mp-bulk-row'), function(row) {
        var checkbox = row.querySelector('.mp-bulk-item-check');
        var amountInput = row.querySelector('.mp-bulk-item-amount');
        if (!checkbox || !amountInput) return;
        amountInput.disabled = !checkbox.checked;
        row.classList.toggle('disabled', !checkbox.checked);
        var amount = Number(amountInput.value || 0);
        if (checkbox.checked && amount > 0) {
          count += 1;
          total += amount;
        }
      });
      var countNode = document.getElementById('mpBulkCountValue');
      var totalNode = document.getElementById('mpBulkTotalValue');
      var totalDisplay = document.getElementById('mpBulkTotalDisplay');
      if (countNode) countNode.textContent = String(count);
      if (totalNode) totalNode.textContent = money(total);
      if (totalDisplay) totalDisplay.value = money(total);
    }

    function resetBulkModal() {
      var form = document.getElementById('mpBulkForm');
      if (form) form.reset();
      document.getElementById('mpBulkList').innerHTML = '';
      document.getElementById('mpBulkContext').innerHTML = '';
      document.getElementById('mpBulkCountValue').textContent = '0';
      document.getElementById('mpBulkTotalValue').textContent = money(0);
      document.getElementById('mpBulkTotalDisplay').value = money(0);
      document.getElementById('mpBulkOccDisplay').value = '';
      document.getElementById('mpBulkOccurrenceDate').value = '';
    }

    function openBulkReview() {
      var bill = currentBill();
      if (!bill) return;
      var selectedStudents = getSelectedBulkStudents();
      if (!selectedStudents.length) {
        showToast('error', 'Select at least one student first.');
        return;
      }
      if (bill.bill_type === 'recurring' && !state.selectedOccDate) {
        showToast('error', 'Select a date above before recording a bulk payment.');
        return;
      }
      if (bill.bill_type === 'recurring' && state.selectedOccDate && !hasOccurrenceSnapshotForBill(bill)) {
        showToast('error', 'Date balances are still loading. Try again in a moment.');
        ensureOccurrenceSnapshot(bill);
        return;
      }

      resetBulkModal();
      document.getElementById('mpBulkList').innerHTML = selectedStudents.map(buildBulkReviewRow).join('');
      document.getElementById('mpBulkContext').innerHTML = '' +
        '<span class="mp-bulk-context-chip">' + escapeHtml(bill.title || 'Bill') + '</span>' +
        '<span class="mp-bulk-context-chip">👥 ' + selectedStudents.length + ' student(s)</span>' +
        '<span class="mp-bulk-context-chip">📅 ' + escapeHtml(state.selectedOccLabel || (state.selectedOccDate ? new Date(state.selectedOccDate + 'T00:00:00').toLocaleDateString() : 'One-time bill')) + '</span>';

      document.getElementById('mpBulkOccDisplay').value = state.selectedOccLabel || (state.selectedOccDate ? new Date(state.selectedOccDate + 'T00:00:00').toLocaleDateString() : 'One-time bill');
      document.getElementById('mpBulkOccurrenceDate').value = state.selectedOccDate || '';
      document.getElementById('mpBulkNotes').value = state.selectedOccLabel ? ('Occurrence: ' + state.selectedOccLabel) : '';
      if (state.selectedOccDate) document.getElementById('mpBulkReference').value = 'BATCH-' + state.selectedOccDate;

      Array.prototype.forEach.call(document.querySelectorAll('#mpBulkList .mp-bulk-item-check, #mpBulkList .mp-bulk-item-amount'), function(node) {
        node.onchange = refreshBulkModalTotals;
        node.oninput = refreshBulkModalTotals;
      });

      refreshBulkModalTotals();
      document.getElementById('mpBulkModal').classList.add('open');
    }

    window.mpOpenBill = function(id) {
      renderDrawer(id, { preserveState: false });
      document.getElementById('mpDrawerBg').classList.add('open');
      document.getElementById('mpDrawer').classList.add('open');
      document.getElementById('mpDrawer').setAttribute('aria-hidden', 'false');
    };

    window.mpCloseBill = function(event) {
      if (event && event.target && event.target.id !== 'mpDrawerBg') return;
      document.getElementById('mpDrawerBg').classList.remove('open');
      document.getElementById('mpDrawer').classList.remove('open');
      document.getElementById('mpDrawer').setAttribute('aria-hidden', 'true');
      closeOccPopup();
    };

    window.mpOpenCollect = function(id, bill, student, balance, occLabel, occDateIso) {
      var form = document.getElementById('mpCollectForm');
      if (form) form.reset();
      document.getElementById('mpAssignmentId').value = id;
      document.getElementById('mpBillName').value = bill;
      document.getElementById('mpStudentName').value = student;
      document.getElementById('mpAmount').value = balance.toFixed(2);
      document.getElementById('mpAmount').max = balance.toFixed(2);
      document.getElementById('mpOccDisplay').value = occLabel || '';
      document.getElementById('mpOccurrenceDate').value = occDateIso || '';
      document.getElementById('mpNotes').value = occLabel ? ('Occurrence: ' + occLabel) : '';
      document.getElementById('mpReference').value = occLabel ? ('OCC-' + occLabel.replace(/[^0-9A-Za-z]+/g, '-')) : '';
      document.getElementById('mpCollectModal').classList.add('open');
    };

    window.mpCloseCollect = function() {
      document.getElementById('mpCollectModal').classList.remove('open');
    };

    window.mpCloseBulkCollect = function() {
      document.getElementById('mpBulkModal').classList.remove('open');
    };

    window.mpOpenSignoff = function() {
      var bill = currentBill();
      if (!bill) return;
      var signoffState = getSignoffState(bill);
      if (!signoffState.enabled) {
        showToast('error', signoffState.hint || 'This bill is not ready to sign off yet.');
        if (bill.bill_type === 'recurring' && state.selectedOccDate && !hasOccurrenceSnapshotForBill(bill)) {
          ensureOccurrenceSnapshot(bill);
        }
        return;
      }
      var form = document.getElementById('mpSignoffForm');
      if (form) form.reset();
      document.getElementById('mpSignoffBillId').value = bill.bill_id;
      document.getElementById('mpSignoffOccurrenceDate').value = bill.bill_type === 'recurring' ? (state.selectedOccDate || '') : '';
      document.getElementById('mpSignoffBillName').value = bill.title || 'Bill';
      document.getElementById('mpSignoffScope').value = bill.bill_type === 'recurring'
        ? (state.selectedOccLabel || (state.selectedOccDate ? new Date(state.selectedOccDate + 'T00:00:00').toLocaleDateString() : 'Recurring date'))
        : 'Entire bill';
      document.getElementById('mpSignoffSummary').innerHTML = bill.bill_type === 'recurring'
        ? 'This date is fully settled. Signing off will remove <strong>' + escapeHtml(document.getElementById('mpSignoffScope').value) + '</strong> from your drawer and save it in finance history.'
        : 'This bill is fully settled. Signing off will remove <strong>' + escapeHtml(bill.title || 'this bill') + '</strong> from your screen and save it in finance history.';
      document.getElementById('mpSignoffModal').classList.add('open');
    };

    window.mpCloseSignoff = function() {
      document.getElementById('mpSignoffModal').classList.remove('open');
    };

    var collectForm = document.getElementById('mpCollectForm');
    if (collectForm) {
      collectForm.addEventListener('submit', function(event) {
        event.preventDefault();
        var submitButton = document.getElementById('mpCollectSubmit');
        var idleLabel = submitButton ? submitButton.textContent : '';
        if (submitButton) {
          submitButton.disabled = true;
          submitButton.textContent = 'Saving…';
        }
        var requestBody = new URLSearchParams(new FormData(collectForm));
        fetch(collectForm.action, {
          method: 'POST',
          body: requestBody,
          headers: {
            'Accept': 'application/json',
            'X-Requested-With': 'XMLHttpRequest'
          }
        })
          .then(parseResponse)
          .then(function(payload) {
            applyPayments([payload.payment]);
            mpCloseCollect();
            showToast('success', payload.message);
          })
          .catch(function(error) {
            showToast('error', error.message);
          })
          .finally(function() {
            if (submitButton) {
              submitButton.disabled = false;
              submitButton.textContent = idleLabel;
            }
          });
      });
    }

    var bulkForm = document.getElementById('mpBulkForm');
    if (bulkForm) {
      bulkForm.addEventListener('submit', function(event) {
        event.preventDefault();
        var rows = Array.prototype.slice.call(document.querySelectorAll('#mpBulkList .mp-bulk-row'));
        var items = rows.reduce(function(accumulator, row) {
          var checkbox = row.querySelector('.mp-bulk-item-check');
          var amountInput = row.querySelector('.mp-bulk-item-amount');
          if (!checkbox || !amountInput || !checkbox.checked) return accumulator;
          var amount = Number(amountInput.value || 0);
          if (!(amount > 0)) return accumulator;
          accumulator.push({
            assignment_id: Number(row.getAttribute('data-assignment-id') || 0),
            amount: amount,
            occurrence_date: document.getElementById('mpBulkOccurrenceDate').value || ''
          });
          return accumulator;
        }, []);

        if (!items.length) {
          showToast('error', 'Select at least one student with a valid amount.');
          return;
        }

        var submitButton = document.getElementById('mpBulkSubmit');
        var idleLabel = submitButton ? submitButton.textContent : '';
        if (submitButton) {
          submitButton.disabled = true;
          submitButton.textContent = 'Saving…';
        }

        fetch(bulkForm.action, {
          method: 'POST',
          headers: {
            'Accept': 'application/json',
            'Content-Type': 'application/json',
            'X-Requested-With': 'XMLHttpRequest'
          },
          body: JSON.stringify({
            method: document.getElementById('mpBulkMethod').value,
            reference: document.getElementById('mpBulkReference').value,
            notes: document.getElementById('mpBulkNotes').value,
            occurrence_date: document.getElementById('mpBulkOccurrenceDate').value,
            items: items
          })
        })
          .then(parseResponse)
          .then(function(payload) {
            state.bulkSelection = {};
            applyPayments(payload.payments || []);
            resetBulkModal();
            mpCloseBulkCollect();
            showToast('success', payload.message);
          })
          .catch(function(error) {
            showToast('error', error.message);
          })
          .finally(function() {
            if (submitButton) {
              submitButton.disabled = false;
              submitButton.textContent = idleLabel;
            }
          });
      });
    }

    var signoffForm = document.getElementById('mpSignoffForm');
    if (signoffForm) {
      signoffForm.addEventListener('submit', function(event) {
        event.preventDefault();
        var submitButton = document.getElementById('mpSignoffSubmit');
        var idleLabel = submitButton ? submitButton.textContent : '';
        if (submitButton) {
          submitButton.disabled = true;
          submitButton.textContent = 'Signing…';
        }
        var requestBody = new URLSearchParams(new FormData(signoffForm));
        fetch(signoffForm.action, {
          method: 'POST',
          body: requestBody,
          headers: {
            'Accept': 'application/json',
            'X-Requested-With': 'XMLHttpRequest'
          }
        })
          .then(parseResponse)
          .then(function(payload) {
            applySignoff(payload.signoff);
            mpCloseSignoff();
            showToast('success', payload.message);
          })
          .catch(function(error) {
            showToast('error', error.message);
          })
          .finally(function() {
            if (submitButton) {
              submitButton.disabled = false;
              submitButton.textContent = idleLabel;
            }
          });
      });
    }

    DATA.forEach(function(bill) {
      syncBillTotals(bill);
      byId[bill.bill_id] = bill;
    });
    refreshDashboardStats();
  })();
</script>

