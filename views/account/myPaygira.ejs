<%
  function bal(a){ return Math.max(Number(a.amount||0) + Number(a.late_fee_applied||0) - Number(a.amount_paid||0), 0); }
  function statusClass(s){ return ({paid:'paid',partial:'partial',overdue:'overdue',pending:'pending'})[s||'pending']; }
  function recurStepDays(r){ return ({daily:1,weekly:7,monthly:30,term:90,year:365})[String(r||'').toLowerCase()] || 0; }
  function fmtDate(d){ try{ return d ? new Date(d).toLocaleDateString() : '—'; }catch(e){ return '—'; } }
  const currencyCode = (financeCurrency && financeCurrency.code) ? financeCurrency.code : 'USD';
  const currencyLocale = (financeCurrency && financeCurrency.locale) ? financeCurrency.locale : 'en-US';
  const moneyFmt = typeof formatMoney === 'function'
    ? formatMoney
    : function(v){ return Number(v||0).toLocaleString(undefined,{minimumFractionDigits:2,maximumFractionDigits:2}); };
  // group assignments by bill
  const _byBill = {};
  (assignments || []).forEach(a => {
    if (!_byBill[a.bill_id]) _byBill[a.bill_id] = [];
    _byBill[a.bill_id].push(a);
  });
%>
<style>
  :root{
    --fin-bg:#080d1a; --fin-surface:#0e1426; --fin-surface-2:#131b33;
    --fin-border:rgba(255,255,255,.08); --fin-text:#e9eef8; --fin-muted:#8a93a8;
    --fin-teal:#00D4AA; --fin-gold:#F5C842; --fin-red:#FF4D6D; --fin-purple:#7B61FF;
  }
  .mp-wrap{ background:var(--fin-bg); color:var(--fin-text); min-height:<%= isEmbedded ? '100vh' : 'calc(100vh - 80px)' %>; font-family:'Space Grotesk','DM Sans',system-ui,sans-serif; padding:<%= isEmbedded ? '10px 12px 14px' : 'clamp(18px, 3vw, 32px) clamp(12px, 2.5vw, 20px) 64px' %>; }
  .mp-container{ max-width:<%= isEmbedded ? 'none' : '1280px' %>; width:100%; margin:0 auto; }
  .mp-head{ display:flex; justify-content:space-between; align-items:center; gap:12px; flex-wrap:wrap; margin-bottom:<%= isEmbedded ? '14px' : '22px' %>; }
  .mp-head h1{ margin:0; font-size:<%= isEmbedded ? '1.35rem' : '1.9rem' %>; font-weight:800; letter-spacing:-.02em; }
  .mp-head h1 .accent{ color:var(--fin-teal); font-style:italic; }
  .mp-head p{ margin:2px 0 0; color:var(--fin-muted); font-size:<%= isEmbedded ? '.78rem' : '.9rem' %>; }
  .paygira-secure-badge{ display:inline-flex; align-items:center; gap:6px; padding:6px 12px; border-radius:999px;
    background:linear-gradient(135deg, rgba(0,212,170,.18), rgba(0,212,170,.08)); border:1px solid rgba(0,212,170,.45);
    color:var(--fin-teal); font-size:.66rem; font-weight:700; letter-spacing:.08em; text-transform:uppercase; }

  .mp-stats{ display:grid; grid-template-columns:repeat(auto-fit, minmax(160px,1fr)); gap:10px; margin-bottom:18px; }
  .mp-stat{ background:linear-gradient(180deg, var(--fin-surface), var(--fin-surface-2)); border:1px solid var(--fin-border); border-radius:14px; padding:12px 14px; }
  .mp-stat .label{ font-size:.66rem; color:var(--fin-muted); text-transform:uppercase; letter-spacing:.08em; font-weight:700; }
  .mp-stat .value{ font-size:1.15rem; font-weight:800; margin-top:4px; font-family:'JetBrains Mono',monospace; }
  .mp-stat.teal .value{ color:var(--fin-teal); }
  .mp-stat.gold .value{ color:var(--fin-gold); }
  .mp-stat.red .value{ color:var(--fin-red); }

  .mp-section-title{ font-size:.76rem; font-weight:700; letter-spacing:.06em; text-transform:uppercase; color:var(--fin-muted); margin:18px 0 10px; display:flex; align-items:center; gap:10px; }
  .mp-section-title .ln{ flex:1; height:1px; background:var(--fin-border); }

  /* Bill cards grid */
  .mp-bill-grid{ display:grid; grid-template-columns:repeat(auto-fill, minmax(280px,1fr)); gap:12px; }
  .mp-bill-card{ background:linear-gradient(180deg, var(--fin-surface), var(--fin-surface-2));
    border:1px solid var(--fin-border); border-radius:14px; padding:14px; cursor:pointer;
    transition:all .15s; display:flex; flex-direction:column; gap:8px; position:relative; }
  .mp-bill-card:hover{ transform:translateY(-2px); border-color:rgba(0,212,170,.45); box-shadow:0 8px 22px rgba(0,212,170,.10); }
  .mp-bill-card .bc-title{ font-weight:700; font-size:.98rem; line-height:1.2; padding-right:60px; }
  .mp-bill-card .bc-meta{ color:var(--fin-muted); font-size:.72rem; display:flex; flex-wrap:wrap; gap:6px 10px; }
  .mp-bill-card .bc-amts{ display:grid; grid-template-columns:repeat(3,1fr); gap:8px; margin-top:6px; padding-top:8px; border-top:1px dashed var(--fin-border); }
  .mp-bill-card .bc-amts > div{ font-size:.66rem; color:var(--fin-muted); text-transform:uppercase; letter-spacing:.05em; }
  .mp-bill-card .bc-amts strong{ display:block; font-family:'JetBrains Mono',monospace; font-size:.85rem; font-weight:700; color:var(--fin-text); margin-top:2px; }
  .mp-bill-card .bc-amts .out strong{ color:var(--fin-gold); }
  .mp-bill-card .bc-amts .col strong{ color:var(--fin-teal); }
  .mp-bill-card .bc-tag{ position:absolute; top:12px; right:12px; font-size:.58rem; padding:3px 8px; border-radius:999px; text-transform:uppercase; letter-spacing:.06em; font-weight:700;
    background:rgba(123,97,255,.15); color:var(--fin-purple); border:1px solid rgba(123,97,255,.3); }
  .mp-bill-card.recurring .bc-tag{ background:rgba(245,200,66,.15); color:var(--fin-gold); border:1px solid rgba(245,200,66,.3); }
  .mp-bill-card .bc-open{ font-size:.7rem; color:var(--fin-teal); font-weight:700; margin-top:2px; }

  .mp-empty{ text-align:center; padding:36px 18px; color:var(--fin-muted); border:1px dashed var(--fin-border); border-radius:14px; }

  .mp-flash{ padding:10px 14px; border-radius:10px; margin-bottom:12px; font-weight:600; font-size:.85rem; }
  .mp-flash.success{ background:rgba(0,212,170,.12); color:var(--fin-teal); border:1px solid rgba(0,212,170,.3); }
  .mp-flash.error{ background:rgba(255,77,109,.12); color:var(--fin-red); border:1px solid rgba(255,77,109,.3); }

  /* Drawer */
  .mp-drawer-bg{ display:none; position:fixed; inset:0; background:rgba(0,0,0,.72); z-index:1200; }
  .mp-drawer-bg.open{ display:block; }
  .mp-drawer{ position:fixed; top:0; right:0; height:100vh; width:min(720px,100vw); background:var(--fin-surface);
    border-left:1px solid var(--fin-border); z-index:1201; transform:translateX(100%); transition:transform .25s; display:flex; flex-direction:column; color:var(--fin-text); }
  .mp-drawer.open{ transform:translateX(0); }
  .mp-drawer-head{ padding:16px 18px; border-bottom:1px solid var(--fin-border); display:flex; justify-content:space-between; align-items:center; gap:12px; background:var(--fin-surface-2); flex-shrink:0; }
  .mp-drawer-head-info{ min-width:0; flex:1; }
  .mp-drawer-head h2{ margin:0; font-size:1.05rem; font-weight:800; color:var(--fin-text); line-height:1.2; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
  .mp-drawer-head .sub{ font-size:.72rem; color:var(--fin-muted); margin-top:4px; display:flex; flex-wrap:wrap; gap:5px; }
  .mp-drawer-head .sub-chip{ display:inline-flex; align-items:center; gap:4px; padding:2px 8px; border-radius:999px; font-size:.62rem; font-weight:700; letter-spacing:.04em; text-transform:uppercase; background:rgba(255,255,255,.06); border:1px solid var(--fin-border); color:var(--fin-muted); }
  .mp-drawer-head .sub-chip.recur{ background:rgba(245,200,66,.12); border-color:rgba(245,200,66,.3); color:var(--fin-gold); }
  .mp-drawer-head .sub-chip.students{ background:rgba(0,212,170,.1); border-color:rgba(0,212,170,.25); color:var(--fin-teal); }
  .mp-drawer-body{ flex:1; overflow-y:auto; padding:0; color:var(--fin-text); }
  .mp-close-btn{ width:30px; height:30px; border-radius:50%; background:rgba(255,255,255,.05); border:1px solid var(--fin-border); color:var(--fin-muted); cursor:pointer; display:inline-flex; align-items:center; justify-content:center; font-size:1rem; line-height:1; flex-shrink:0; transition:all .15s; }
  .mp-close-btn:hover{ background:rgba(255,77,109,.18); border-color:var(--fin-red); color:var(--fin-red); }

  /* Sticky occurrence header */
  .mp-occ-sticky{ position:sticky; top:0; z-index:10; background:var(--fin-surface); border-bottom:1px solid var(--fin-border); padding:10px 18px 8px; display:flex; align-items:center; justify-content:space-between; gap:10px; }
  .mp-occ-toggle{ display:inline-flex; background:var(--fin-bg); border:1px solid var(--fin-border); border-radius:999px; padding:3px; gap:2px; }
  .mp-occ-toggle button{ background:transparent; border:none; color:var(--fin-muted); padding:4px 12px; border-radius:999px; cursor:pointer; font-size:.7rem; font-weight:700; transition:all .15s; }
  .mp-occ-toggle button.active{ background:var(--fin-teal); color:#062018; }
  .mp-occ-count{ font-size:.66rem; color:var(--fin-muted); font-weight:600; white-space:nowrap; }

  .mp-drawer-inner{ padding:14px 18px; }
  .mp-occ-list{ display:grid; gap:5px; margin-bottom:14px; }
  .mp-occ-row{ display:flex; align-items:center; gap:10px; padding:8px 12px; background:var(--fin-bg); border:1px solid var(--fin-border); border-radius:10px; font-size:.8rem; color:var(--fin-text); cursor:pointer; transition:all .15s; user-select:none; }
  .mp-occ-row:hover{ border-color:rgba(0,212,170,.35); background:rgba(0,212,170,.04); }
  .mp-occ-row.selected{ border-color:var(--fin-teal); background:rgba(0,212,170,.08); box-shadow:0 0 0 1px rgba(0,212,170,.2); }
  .mp-occ-row.past{ border-color:rgba(255,77,109,.18); }
  .mp-occ-row.past:hover{ border-color:rgba(255,77,109,.45); }
  .mp-occ-row.past.selected{ border-color:var(--fin-red); background:rgba(255,77,109,.08); box-shadow:0 0 0 1px rgba(255,77,109,.2); }
  .mp-radio-dot{ width:16px; height:16px; border-radius:50%; border:2px solid var(--fin-border); flex-shrink:0; display:flex; align-items:center; justify-content:center; transition:all .15s; }
  .mp-occ-row.selected .mp-radio-dot{ border-color:var(--fin-teal); background:var(--fin-teal); }
  .mp-occ-row.past.selected .mp-radio-dot{ border-color:var(--fin-red); background:var(--fin-red); }
  .mp-radio-dot::after{ content:''; width:6px; height:6px; border-radius:50%; background:#062018; opacity:0; transition:opacity .1s; }
  .mp-occ-row.selected .mp-radio-dot::after{ opacity:1; }
  .mp-occ-row .dot{ width:7px; height:7px; border-radius:50%; background:var(--fin-muted); flex-shrink:0; }
  .mp-occ-row.past .dot{ background:var(--fin-red); }
  .mp-occ-row.due .dot{ background:var(--fin-gold); }
  .mp-occ-row.future .dot{ background:var(--fin-purple); }
  .mp-occ-row .occ-info{ flex:1; min-width:0; }
  .mp-occ-row .when{ font-weight:600; color:var(--fin-text); font-size:.82rem; }
  .mp-occ-row .lbl{ font-size:.65rem; color:var(--fin-muted); margin-top:1px; }

  /* Calendar inline in sticky bar */
  .mp-occ-sticky-right{ display:flex; align-items:center; gap:6px; flex-shrink:0; }
  .mp-occ-sticky-right label{ font-size:.7rem; color:var(--fin-muted); white-space:nowrap; }
  .mp-occ-sticky-right input[type=date]{ background:var(--fin-bg); border:1px solid var(--fin-border); border-radius:8px; color:var(--fin-text); padding:5px 9px; font-size:.74rem; font-family:inherit; cursor:pointer; }
  .mp-occ-sticky-right input[type=date]:focus{ outline:none; border-color:var(--fin-teal); }

  /* Occurrence popup — absolute to .mp-drawer, not inside overflow:auto container */
  .mp-occ-popup{ position:absolute; left:0; right:0; z-index:50; background:var(--fin-surface-2); border-bottom:1px solid var(--fin-border); box-shadow:0 10px 36px rgba(0,0,0,.65); max-height:300px; overflow-y:auto; display:none; overscroll-behavior:contain; padding:8px; }
  .mp-occ-popup.open{ display:block; }

  /* Day summary */
  .mp-day-summary{ display:grid; grid-template-columns:repeat(4,1fr); gap:8px; margin-bottom:14px; padding:12px 14px; background:linear-gradient(135deg,rgba(0,212,170,.09),rgba(0,212,170,.03)); border:1px solid rgba(0,212,170,.22); border-radius:12px; }
  .mp-day-summary .ds-item .ds-lbl{ font-size:.58rem; color:var(--fin-muted); text-transform:uppercase; letter-spacing:.06em; font-weight:700; }
  .mp-day-summary .ds-item .ds-val{ font-size:.9rem; font-weight:800; font-family:'JetBrains Mono',monospace; margin-top:2px; }
  .mp-day-summary .ds-item.teal .ds-val{ color:var(--fin-teal); }
  .mp-day-summary .ds-item.gold .ds-val{ color:var(--fin-gold); }
  .mp-day-summary .ds-item.red .ds-val{ color:var(--fin-red); }

  /* Collect gating */
  .mp-collect-notice{ font-size:.72rem; color:var(--fin-gold); background:rgba(245,200,66,.08); border:1px solid rgba(245,200,66,.2); border-radius:8px; padding:7px 12px; margin-bottom:12px; display:flex; align-items:center; gap:6px; }
  .mp-collect-notice svg{ flex-shrink:0; }

  .mp-student-list{ display:grid; gap:8px; }
  .mp-student-row{ display:flex; flex-direction:column; gap:6px; padding:10px 12px; background:var(--fin-bg); border:1px solid var(--fin-border); border-radius:12px; color:var(--fin-text); }
  .mp-stu-top{ display:flex; align-items:center; gap:10px; }
  .mp-stu-top .who{ display:flex; align-items:center; gap:10px; flex:1; min-width:0; }
  .mp-student-row .who img{ width:32px; height:32px; border-radius:50%; object-fit:cover; border:1px solid var(--fin-border); flex-shrink:0; }
  .mp-student-row .who .nm{ font-weight:700; font-size:.9rem; color:var(--fin-text); white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
  .mp-student-row .who .cls{ font-size:.7rem; color:var(--fin-muted); }
  .mp-student-row .amts{ display:flex; flex-wrap:wrap; gap:4px 12px; font-family:'JetBrains Mono',monospace; font-size:.76rem; padding-left:42px; }
  .mp-student-row .amts > div{ color:var(--fin-text); }
  .mp-student-row .amts .out{ color:var(--fin-gold); font-weight:700; }
  .mp-student-row .amts .pd{ color:var(--fin-teal); }
  .mp-stu-top .acts{ display:flex; gap:6px; align-items:center; flex-shrink:0; }

  .mp-status{ display:inline-block; padding:2px 8px; border-radius:999px; font-size:.6rem; font-weight:700; letter-spacing:.05em; text-transform:uppercase; }
  .mp-status.paid{ background:rgba(0,212,170,.15); color:var(--fin-teal); border:1px solid rgba(0,212,170,.3); }
  .mp-status.partial{ background:rgba(245,200,66,.15); color:var(--fin-gold); border:1px solid rgba(245,200,66,.3); }
  .mp-status.overdue{ background:rgba(255,77,109,.15); color:var(--fin-red); border:1px solid rgba(255,77,109,.3); }
  .mp-status.pending{ background:rgba(138,147,168,.18); color:#c5cbd9; border:1px solid rgba(138,147,168,.35); }

  .mp-btn{ display:inline-flex; align-items:center; gap:6px; padding:6px 11px; border-radius:8px; font-size:.74rem; font-weight:700; cursor:pointer; border:none; text-decoration:none; }
  .mp-btn.primary{ background:linear-gradient(135deg, var(--fin-teal), #00b693); color:#062018; }
  .mp-btn.primary:hover{ transform:translateY(-1px); }
  .mp-btn.ghost{ background:rgba(255,255,255,.04); color:var(--fin-text); border:1px solid var(--fin-border); }
  .mp-btn.ghost:hover{ background:rgba(255,255,255,.08); }
  .mp-btn.tiny{ padding:4px 8px; font-size:.66rem; }

  /* Collect modal */
  .mp-modal-bg{ display:none; position:fixed; inset:0; background:rgba(0,0,0,.78); z-index:1400; align-items:center; justify-content:center; padding:12px; overflow-y:auto; }
  .mp-modal-bg.open{ display:flex; }
  .mp-modal{ background:var(--fin-surface); border:1px solid var(--fin-border); border-radius:14px; padding:18px; max-width:480px; width:100%; max-height:calc(100vh - 24px); overflow-y:auto; color:var(--fin-text); }
  .mp-modal h3{ margin:0 0 12px; font-size:1rem; display:flex; align-items:center; justify-content:space-between; gap:8px; color:var(--fin-text); }
  .mp-form-grid{ display:grid; grid-template-columns:repeat(2,1fr); gap:8px 10px; }
  .mp-form-grid .span2{ grid-column:1 / -1; }
  .mp-field label{ display:block; font-size:.62rem; color:var(--fin-muted); margin-bottom:3px; font-weight:700; letter-spacing:.05em; text-transform:uppercase; }
  .mp-field input, .mp-field select, .mp-field textarea{
    width:100%; padding:8px 11px; border-radius:8px; background:var(--fin-bg);
    border:1px solid var(--fin-border); color:var(--fin-text); font-family:inherit; font-size:.85rem;
  }
  .mp-field textarea{ resize:vertical; min-height:50px; }
  .mp-field input:focus, .mp-field select:focus, .mp-field textarea:focus{ outline:none; border-color:var(--fin-teal); }
  .mp-modal-actions{ display:flex; gap:8px; justify-content:flex-end; margin-top:12px; position:sticky; bottom:0; padding-top:10px; background:linear-gradient(to top, var(--fin-surface) 60%, transparent); }

  @media (max-width:960px){
    .mp-head{ align-items:flex-start; }
    .mp-head h1{ font-size:1.45rem; }
    .mp-head p{ max-width:44ch; }
    .mp-stats{ grid-template-columns:repeat(2, minmax(0, 1fr)); }
    .mp-bill-grid{ grid-template-columns:repeat(auto-fit, minmax(240px,1fr)); }
    .mp-bill-card .bc-amts{ grid-template-columns:repeat(3,minmax(0,1fr)); font-size:.72rem; }
    .mp-stu-top .acts{ flex-wrap:wrap; }
    .mp-modal-actions{ flex-wrap:wrap; }
  }

  @media (max-width:640px){
    .mp-wrap{ padding:8px; }
    .mp-head{ gap:10px; }
    .mp-head h1{ font-size:1.1rem; }
    .mp-head p{ font-size:.82rem; }
    .paygira-secure-badge{ font-size:.6rem; padding:6px 10px; }
    .mp-stats{ grid-template-columns:1fr; }
    .mp-bill-grid{ grid-template-columns:1fr; }
    .mp-bill-card{ padding:12px; }
    .mp-bill-card .bc-title{ padding-right:0; }
    .mp-bill-card .bc-tag{ position:static; align-self:flex-start; margin-bottom:2px; }
    .mp-bill-card .bc-amts{ grid-template-columns:repeat(3,minmax(0,1fr)); font-size:.65rem; }
    .mp-form-grid{ grid-template-columns:1fr; }
    .mp-student-row .amts{ flex-direction:column; gap:4px; align-items:flex-start; }
    .mp-stu-top .acts{ flex-wrap:wrap; }
    .mp-day-summary{ grid-template-columns:repeat(2,1fr); }
    .mp-occ-sticky{ flex-wrap:wrap; gap:6px; }
    .mp-drawer{ width:100vw; }
    .mp-drawer-head{ padding:12px; }
    .mp-drawer-body{ padding:12px; }
    .mp-occ-row .mp-status{ display:none; }
  }

  @media (max-width:420px){
    .mp-wrap{ padding:8px 6px 20px; }
    .mp-stat{ padding:11px 12px; }
    .mp-stat .value{ font-size:1rem; }
    .mp-drawer-head{ flex-wrap:nowrap; }
    .mp-close-btn{ width:30px !important; flex-shrink:0; }
    .mp-occ-row .mp-status{ display:none; }
  }
</style>

<div class="mp-wrap">
  <div class="mp-container">

    <div class="mp-head">
      <div>
        <h1>Pay<span class="accent">Gira</span> — My Collections</h1>
      </div>
      <span class="paygira-secure-badge">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor"><path d="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4z"/></svg>
        Secure
      </span>
    </div>

    <% if (messages && messages.success && messages.success.length) { %>
      <div class="mp-flash success"><%= messages.success[0] %></div>
    <% } %>
    <% if (messages && messages.error && messages.error.length) { %>
      <div class="mp-flash error"><%= messages.error[0] %></div>
    <% } %>

    <div class="mp-stats">
      <div class="mp-stat"><div class="label">Bills</div><div class="value"><%= stats.bills %></div></div>
      <div class="mp-stat"><div class="label">Students</div><div class="value"><%= stats.students %></div></div>
      <div class="mp-stat teal"><div class="label">Collected</div><div class="value"><%= moneyFmt(stats.collected) %></div></div>
      <div class="mp-stat gold"><div class="label">Outstanding</div><div class="value"><%= moneyFmt(stats.outstanding) %></div></div>
    </div>

    <% if (!bills.length) { %>
      <div class="mp-empty">
        <div style="font-size:2rem;margin-bottom:6px;">📋</div>
        <div>No bills are assigned to you yet. An admin can make you a collector when creating a bill.</div>
      </div>
    <% } else { %>
      <div class="mp-section-title"><span>Assigned Bills</span><span class="ln"></span><span><%= bills.length %></span></div>
      <div class="mp-bill-grid">
        <% bills.forEach(b => {
             const kids = _byBill[b.bill_id] || [];
             const isRecurring = String(b.bill_type) === 'recurring';
        %>
          <div class="mp-bill-card <%= isRecurring ? 'recurring' : '' %>"
               data-bill-id="<%= b.bill_id %>"
               onclick="mpOpenBill(<%= b.bill_id %>)">
            <span class="bc-tag"><%= isRecurring ? (b.recurrence || 'recurring') : (b.bill_type || 'one-time') %></span>
            <div class="bc-title"><%= b.title %></div>
            <div class="bc-meta">
              <span>📅 Due <%= fmtDate(b.due_date) %></span>
              <span>👥 <%= b.assigned_count %> student<%= Number(b.assigned_count) === 1 ? '' : 's' %></span>
            </div>
            <div class="bc-amts">
              <div>Billed<strong><%= moneyFmt(b.total_amount) %></strong></div>
              <div class="col">Collected<strong><%= moneyFmt(b.total_paid) %></strong></div>
              <div class="out">Outstanding<strong><%= moneyFmt(b.total_outstanding) %></strong></div>
            </div>
            <div class="bc-open">Tap to open →</div>
          </div>
        <% }); %>
      </div>
    <% } %>
  </div>
</div>

<!-- Bill detail drawer -->
<div class="mp-drawer-bg" id="mpDrawerBg" onclick="mpCloseBill(event)"></div>
<aside class="mp-drawer" id="mpDrawer" aria-hidden="true">
  <div class="mp-drawer-head">
    <div class="mp-drawer-head-info">
      <h2 id="mpDrawerTitle">Bill</h2>
      <div class="sub" id="mpDrawerSub"></div>
    </div>
    <button class="mp-close-btn" type="button" onclick="mpCloseBill()" aria-label="Close">✕</button>
  </div>
  <div class="mp-occ-popup" id="mpOccPopup"></div>
  <div class="mp-drawer-body" id="mpDrawerBody"><!-- filled by JS --></div>
</aside>

<!-- JSON payload (parsed by JS) -->
<script id="mpBillsData" type="application/json"><%-
  JSON.stringify((bills || []).map(b => ({
    bill_id: b.bill_id,
    title: b.title,
    bill_type: b.bill_type,
    recurrence: b.recurrence,
    due_date: b.due_date,
    description: b.description,
    accepts_card: b.accepts_card,
    accepts_cash: b.accepts_cash,
    accepts_transfer: b.accepts_transfer,
    total_amount: b.total_amount,
    total_paid: b.total_paid,
    total_outstanding: b.total_outstanding,
    students: (_byBill[b.bill_id] || []).map(a => ({
      assignment_id: a.assignment_id,
      first_name: a.first_name,
      last_name: a.last_name,
      image_url: a.image_url,
      class_name: a.class_name,
      amount: a.amount,
      amount_paid: a.amount_paid,
      late_fee_applied: a.late_fee_applied,
      status: a.status
    }))
  })))
%></script>

<!-- Collect modal -->
<div class="mp-modal-bg" id="mpCollectModal" onclick="if(event.target===this) mpCloseCollect()">
  <div class="mp-modal">
    <h3>
      Record Collection
      <span class="paygira-secure-badge" style="padding:3px 9px;font-size:.58rem;">
        <svg width="9" height="9" viewBox="0 0 24 24" fill="currentColor"><path d="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4z"/></svg>
        Secure
      </span>
    </h3>
    <form action="/account/settings/my-paygira/collect<%= isEmbedded ? '?embed=workspace' : '' %>" method="POST">
      <input type="hidden" name="embedMode" value="<%= isEmbedded ? 'workspace' : '' %>">
      <input type="hidden" name="assignment_id" id="mpAssignmentId">
      <div class="mp-form-grid">
        <div class="mp-field span2"><label>Bill</label><input type="text" id="mpBillName" disabled style="color:var(--fin-text);background:rgba(255,255,255,.04);"></div>
        <div class="mp-field span2"><label>Student</label><input type="text" id="mpStudentName" disabled style="color:var(--fin-text);background:rgba(255,255,255,.04);"></div>
        <div class="mp-field"><label>Amount (<%= currencyCode %>) *</label><input type="number" step="0.01" min="0.01" name="amount" id="mpAmount" required></div>
        <div class="mp-field"><label>Method</label>
          <select name="method" id="mpMethod">
            <option value="cash">💵 Cash</option>
            <% if (typeof allowedMethods !== 'undefined' && allowedMethods.stripeOn) { %>
              <option value="card">💳 Card</option>
            <% } %>
            <% if (typeof allowedMethods !== 'undefined' && allowedMethods.bankOn) { %>
              <option value="bank_transfer">🏦 Bank<% if (allowedMethods.bank && allowedMethods.bank.name) { %> — <%= allowedMethods.bank.name %><% } %></option>
            <% } %>
            <% if (typeof allowedMethods !== 'undefined' && allowedMethods.momoOn) { %>
              <option value="mobile_money">📱 Mobile money</option>
            <% } %>
            <option value="other">Other</option>
          </select>
        </div>
        <div class="mp-field"><label>Reference</label><input type="text" name="reference" id="mpReference" placeholder="Receipt #, txn ref"></div>
        <div class="mp-field"><label>Occurrence (optional)</label><input type="text" id="mpOccDisplay" disabled placeholder="—" style="color:var(--fin-text);background:rgba(255,255,255,.04);"></div>
        <div class="mp-field" style="display:none;"><input type="hidden" name="occurrence_date" id="mpOccurrenceDate"></div>
        <div class="mp-field span2"><label>Notes</label><textarea name="notes" id="mpNotes" rows="1"></textarea></div>
      </div>
      <div class="mp-modal-actions">
        <button type="button" class="mp-btn ghost" onclick="mpCloseCollect()">Cancel</button>
        <button type="submit" class="mp-btn primary">🔒 Record Payment</button>
      </div>
    </form>
  </div>
</div>

<script>
  (function(){
    var financeCurrencyCode = <%- JSON.stringify(currencyCode) %>;
    var financeCurrencyLocale = <%- JSON.stringify(currencyLocale) %>;
    var DATA = [];
    try { DATA = JSON.parse(document.getElementById('mpBillsData').textContent || '[]'); } catch(e){ DATA = []; }
    var byId = {};
    DATA.forEach(function(b){ byId[b.bill_id] = b; });

    function money(v){
      try {
        return new Intl.NumberFormat(financeCurrencyLocale, {
          style:'currency',
          currency: financeCurrencyCode,
          minimumFractionDigits:2,
          maximumFractionDigits:2
        }).format(Number(v||0));
      } catch (_) {
        return financeCurrencyCode + ' ' + Number(v||0).toFixed(2);
      }
    }
    function bal(a){ return Math.max(Number(a.amount||0) + Number(a.late_fee_applied||0) - Number(a.amount_paid||0), 0); }
    function statusClass(s){ return ({paid:'paid',partial:'partial',overdue:'overdue',pending:'pending'})[s||'pending']; }
    function recurStepDays(r){ return ({daily:1,weekly:7,monthly:30,term:90,year:365})[String(r||'').toLowerCase()] || 0; }
    function fmt(d){ try{ return d ? new Date(d).toLocaleDateString() : '—'; }catch(e){ return '—'; } }
    function isoDate(d){ return d.getFullYear()+'-'+String(d.getMonth()+1).padStart(2,'0')+'-'+String(d.getDate()).padStart(2,'0'); }

    // Smart human-readable label for an occurrence
    function smartOccLabel(diff, recurrence, date){
      var r = String(recurrence||'').toLowerCase();
      if (diff === 0) return 'Today — end of day';
      if (diff === -1) return r === 'daily' ? 'Yesterday — end of day' : 'Yesterday';
      if (diff === 1) return r === 'daily' ? 'Tomorrow — end of day' : 'Tomorrow';
      if (diff < 0){
        var abs = Math.abs(diff);
        if (r === 'daily') return abs + ' days ago';
        if (r === 'weekly'){ var wk = Math.round(abs/7); return wk === 1 ? 'Last week' : wk + ' weeks ago'; }
        if (r === 'monthly'){ var mo = Math.round(abs/30); return mo === 1 ? 'Last month' : mo + ' months ago'; }
        return abs + ' days ago';
      } else {
        if (r === 'daily') return 'In ' + diff + ' days';
        if (r === 'weekly'){ var wk = Math.round(diff/7); return wk === 1 ? 'Next week' : 'In ' + wk + ' weeks'; }
        if (r === 'monthly'){ var mo = Math.round(diff/30); return mo === 1 ? 'Next month' : 'In ' + mo + ' months'; }
        return 'In ' + diff + ' days';
      }
    }

    function buildOccurrences(bill){
      var step = recurStepDays(bill.recurrence);
      if (!step || bill.bill_type !== 'recurring') return [];
      var anchor = bill.due_date ? new Date(bill.due_date) : new Date();
      if (isNaN(anchor.getTime())) anchor = new Date();
      anchor.setHours(0,0,0,0);
      var today = new Date(); today.setHours(0,0,0,0);
      // range: 14 past occurrences + 14 future (capped sensibly per recurrence)
      var back = bill.recurrence === 'monthly' ? 4 : (bill.recurrence === 'weekly' ? 8 : 14);
      var fwd  = bill.recurrence === 'monthly' ? 6 : (bill.recurrence === 'weekly' ? 12 : 14);
      var rows = [];
      for (var i = -back; i <= fwd; i++){
        var d = new Date(anchor); d.setDate(anchor.getDate() + i * step);
        var diff = Math.round((d - today) / 86400000);
        var kind = diff < 0 ? 'past' : (diff === 0 ? 'due' : 'future');
        rows.push({ date:d, kind:kind, label:fmt(d), smart: smartOccLabel(diff, bill.recurrence, d) });
      }
      return rows;
    }

    function renderDaySummaryAjax(bill, dateIso){
      var summaryEl = document.getElementById('mpDaySummary');
      if (!summaryEl) return;
      summaryEl.style.display = '';
      summaryEl.innerHTML = '<div class="mp-day-summary" style="opacity:.4"><div class="ds-item"><div class="ds-lbl">Loading…</div></div></div>';
      fetch('/account/settings/my-paygira/occurrence-summary?bill_id=' + bill.bill_id + '&date=' + encodeURIComponent(dateIso))
        .then(function(r){ return r.json(); })
        .then(function(d){
          if (!summaryEl) return;
          var fmtVal = function(n){ return money(n).replace(/\B(?=(\d{3})+(?!\d))/g,','); };
          summaryEl.innerHTML =
            '<div class="mp-day-summary">' +
              '<div class="ds-item"><div class="ds-lbl">Due today</div><div class="ds-val">' + d.students + '</div></div>' +
              '<div class="ds-item teal"><div class="ds-lbl">Paid today</div><div class="ds-val">' + money(d.paid_today) + '</div></div>' +
              '<div class="ds-item red"><div class="ds-lbl">Still owed</div><div class="ds-val">' + money(d.outstanding) + '</div></div>' +
              '<div class="ds-item gold"><div class="ds-lbl">Expected</div><div class="ds-val">' + money(d.total_expected) + '</div></div>' +
            '</div>';
        })
        .catch(function(){ summaryEl.style.display = 'none'; });
    }

    // Refresh collect buttons whenever selection changes
    function refreshCollectButtons(){
      var body = document.getElementById('mpDrawerBody');
      if (!body) return;
      var bill = window.__mpCurrentBill;
      var isRecurring = bill && bill.bill_type === 'recurring';
      var selected = window.__mpSelectedOcc;
      var selectedDateIso = window.__mpSelectedOccDate || '';
      var notice = body.querySelector('.mp-collect-notice');
      if (notice) notice.style.display = (isRecurring && !selected) ? '' : 'none';
      // Day summary (AJAX)
      var summaryEl = body.querySelector('#mpDaySummary');
      if (summaryEl) {
        if (selected && bill && isRecurring && selectedDateIso) renderDaySummaryAjax(bill, selectedDateIso);
        else summaryEl.style.display = 'none';
      }
      body.querySelectorAll('.mp-collect-btn-wrap').forEach(function(wrap){
        var btn = wrap.querySelector('button.mp-btn.primary');
        if (!btn) return;
        if (isRecurring && !selected){
          btn.disabled = true;
          btn.style.opacity = '0.45';
          btn.style.cursor = 'not-allowed';
          btn.title = 'Select a date first';
        } else {
          btn.disabled = false;
          btn.style.opacity = '';
          btn.style.cursor = '';
          btn.title = '';
          var aid   = wrap.getAttribute('data-aid');
          var bname = wrap.getAttribute('data-bname');
          var sname = wrap.getAttribute('data-sname');
          var bal_  = wrap.getAttribute('data-bal');
          var capturedDateIso = selectedDateIso;
          btn.onclick = function(){ mpOpenCollect(Number(aid), bname, sname, Number(bal_), window.__mpSelectedOcc || '', capturedDateIso); };
        }
      });
    }

    function studentRowHTML(bill, s){
      var b = bal(s);
      var img = (s.image_url && s.image_url !== 'profilePlaceholder.png') ? s.image_url : '/images/profilePlaceholder.png';
      var canCollect = b > 0;
      var nameSafe = (s.first_name + ' ' + s.last_name).replace(/"/g,'&quot;');
      var billSafe = String(bill.title || '').replace(/"/g,'&quot;');
      var collectBtn = canCollect
        ? '<div class="mp-collect-btn-wrap" data-aid="' + s.assignment_id + '" data-bname="' + billSafe + '" data-sname="' + nameSafe + '" data-bal="' + b.toFixed(2) + '">' +
            '<button class="mp-btn primary tiny" type="button">💵 Collect</button>' +
          '</div>'
        : '';
      var invoiceBtn = Number(s.amount_paid) > 0
        ? '<a class="mp-btn ghost tiny" href="/account/settings/my-paygira/invoice/' + s.assignment_id + '" target="_blank" title="Invoice">🧾</a>'
        : '';
      return '<div class="mp-student-row">' +
        '<div class="mp-stu-top">' +
          '<div class="who">' +
            '<img src="' + img + '" alt="">' +
            '<div><div class="nm">' + s.first_name + ' ' + s.last_name + '</div>' +
            '<div class="cls">' + (s.class_name || '—') + '</div></div>' +
          '</div>' +
          '<div class="acts">' +
            '<span class="mp-status ' + statusClass(s.status) + '">' + s.status + '</span>' +
            collectBtn + invoiceBtn +
          '</div>' +
        '</div>' +
        '<div class="amts">' +
          '<div>Billed ' + money(s.amount) + '</div>' +
          '<div class="pd">Paid ' + money(s.amount_paid) + '</div>' +
          '<div class="out">Bal ' + money(b) + '</div>' +
        '</div>' +
      '</div>';
    }

    function renderDrawer(billId){
      var bill = byId[billId];
      if (!bill) return;
      window.__mpCurrentBill = bill;
      window.__mpSelectedOcc = '';
      window.__mpSelectedOccDate = '';
      var isRecurring = bill.bill_type === 'recurring';

      // Header chips
      document.getElementById('mpDrawerTitle').textContent = bill.title;
      var subEl = document.getElementById('mpDrawerSub');
      var chips = '';
      if (isRecurring) chips += '<span class="sub-chip recur">🔁 ' + (bill.recurrence || 'recurring') + '</span>';
      else             chips += '<span class="sub-chip">one-time</span>';
      chips += '<span class="sub-chip">📅 Due ' + fmt(bill.due_date) + '</span>';
      chips += '<span class="sub-chip students">👥 ' + (bill.students||[]).length + ' student(s)</span>';
      subEl.innerHTML = chips;

      var html = '';
      var occRowsHtml = ''; // built below, injected into #mpOccPopup (outside overflow container)

      // Sticky occurrence section for recurring bills
      if (isRecurring) {
        var occs = buildOccurrences(bill);
        if (occs.length) {
          var allCount = occs.length;
          var pastCount = occs.filter(function(o){ return o.kind==='past'||o.kind==='due'; }).length;
          var futureCount = occs.filter(function(o){ return o.kind==='future'; }).length;
          // Build rows HTML for popup (popup lives outside drawer-body to avoid overflow clip)
          occRowsHtml = occs.map(function(o){
            var dateStr = isoDate(o.date);
            var statusLbl = o.kind==='past' ? '<span class="mp-status overdue">past</span>' : (o.kind==='due' ? '<span class="mp-status partial">due today</span>' : '');
            return '<div class="mp-occ-row ' + o.kind + '" data-kind="' + o.kind + '" data-date="' + dateStr + '" data-label="' + o.label + '">' +
              '<div class="mp-radio-dot"></div>' +
              '<span class="dot"></span>' +
              '<div class="occ-info"><div class="when">' + o.label + '</div><div class="lbl">' + o.smart + '</div></div>' +
              statusLbl +
            '</div>';
          }).join('');

          html += '<div class="mp-occ-sticky">' +
                    '<div class="mp-occ-toggle" id="mpOccToggle">' +
                      '<button type="button" data-filter="past">Past (' + pastCount + ')</button>' +
                      '<button type="button" data-filter="all">All (' + allCount + ')</button>' +
                      '<button type="button" data-filter="future">Future (' + futureCount + ')</button>' +
                    '</div>' +
                    '<div class="mp-occ-sticky-right">' +
                      '<label for="mpOccCalendar">📅</label>' +
                      '<input type="date" id="mpOccCalendar" title="Pick any date">' +
                    '</div>' +
                  '</div>';
        }
      }

      // Date-gating notice + day summary (only for recurring)
      var noticeDisplay = isRecurring ? '' : 'display:none';
      html += '<div class="mp-drawer-inner">';
      html += '<div id="mpDaySummary" style="display:none;"></div>';
      html += '<div class="mp-collect-notice" style="' + noticeDisplay + '">' +
                '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><circle cx="12" cy="16" r=".5" fill="currentColor"/></svg>' +
                'Select a date above before collecting' +
              '</div>';
      html += '<div class="mp-section-title"><span>Students</span><span class="ln"></span><span>' + (bill.students||[]).length + '</span></div>';
      html += '<div class="mp-student-list">' +
        (bill.students || []).map(function(s){ return studentRowHTML(bill, s); }).join('') +
      '</div>';
      html += '</div>'; // end mp-drawer-inner

      var body = document.getElementById('mpDrawerBody');
      body.innerHTML = html;

      // Inject rows into popup (outside drawer body — avoids overflow:auto clipping)
      var occPopup = document.getElementById('mpOccPopup');
      if (occPopup){
        occPopup.innerHTML = occRowsHtml
          ? '<div class="mp-occ-list" id="mpOccList">' + occRowsHtml + '</div>'
          : '';
        occPopup.classList.remove('open');
      }

      // Wire collect buttons after render
      refreshCollectButtons();

      // --- Occurrence popup helpers ---
      function closeOccPopup(){
        var pp = document.getElementById('mpOccPopup');
        var tg = document.getElementById('mpOccToggle');
        if (pp) pp.classList.remove('open');
        if (tg) tg.querySelectorAll('button').forEach(function(b){ b.classList.remove('active'); });
      }
      function selectOcc(row){
        var occList = document.getElementById('mpOccList');
        if (occList) occList.querySelectorAll('.mp-occ-row').forEach(function(r){ r.classList.remove('selected'); });
        row.classList.add('selected');
        window.__mpSelectedOcc     = row.getAttribute('data-label');
        window.__mpSelectedOccDate = row.getAttribute('data-date');   // YYYY-MM-DD
        var cal = document.getElementById('mpOccCalendar');
        if (cal) cal.value = row.getAttribute('data-date');
        closeOccPopup();
        refreshCollectButtons();
      }

      // Row clicks delegated on popup element
      if (occPopup){
        occPopup.addEventListener('click', function(e){
          var row = e.target.closest('.mp-occ-row'); if (row) selectOcc(row);
        });
      }

      // Calendar in sticky bar — pick a date, sets selection, no popup needed
      var cal = document.getElementById('mpOccCalendar');
      if (cal){
        cal.addEventListener('change', function(){
          var val = cal.value; if (!val) return;
          var occList = document.getElementById('mpOccList');
          var match = occList ? occList.querySelector('.mp-occ-row[data-date="' + val + '"]') : null;
          if (match){
            match.style.display = '';
            if (occList) occList.querySelectorAll('.mp-occ-row').forEach(function(r){ r.classList.remove('selected'); });
            match.classList.add('selected');
            window.__mpSelectedOcc     = match.getAttribute('data-label');
            window.__mpSelectedOccDate = val;   // YYYY-MM-DD from calendar
          } else {
            if (occList) occList.querySelectorAll('.mp-occ-row').forEach(function(r){ r.classList.remove('selected'); });
            window.__mpSelectedOcc     = new Date(val + 'T00:00:00').toLocaleDateString();
            window.__mpSelectedOccDate = val;
          }
          refreshCollectButtons();
        });
      }

      // Filter toggle: click opens popup below sticky bar; click same tab again closes it
      var toggle = document.getElementById('mpOccToggle');
      if (toggle){
        toggle.addEventListener('click', function(e){
          var btn = e.target.closest('button[data-filter]'); if (!btn) return;
          var f = btn.getAttribute('data-filter');
          var wasActive = btn.classList.contains('active');
          toggle.querySelectorAll('button').forEach(function(b){ b.classList.remove('active'); });
          var pp = document.getElementById('mpOccPopup');
          if (wasActive){ if (pp) pp.classList.remove('open'); return; }
          btn.classList.add('active');
          // Filter rows
          var occList = document.getElementById('mpOccList');
          if (occList) occList.querySelectorAll('.mp-occ-row').forEach(function(r){
            var k = r.getAttribute('data-kind');
            r.style.display = (f==='all'||f===k||(f==='past'&&(k==='past'||k==='due'))) ? '' : 'none';
          });
          // Position popup right below the sticky bar then open
          if (pp){
            var dh = document.querySelector('.mp-drawer-head');
            var st = body.querySelector('.mp-occ-sticky');
            if (dh && st) pp.style.top = (dh.offsetHeight + st.offsetHeight) + 'px';
            pp.classList.add('open');
          }
        });
      }

      // Click anywhere in drawer body (outside sticky bar) closes popup
      body.addEventListener('click', function(e){
        if (!e.target.closest('.mp-occ-sticky')) closeOccPopup();
      });
    }

    window.mpOpenBill = function(id){
      renderDrawer(id);
      document.getElementById('mpDrawerBg').classList.add('open');
      document.getElementById('mpDrawer').classList.add('open');
      document.getElementById('mpDrawer').setAttribute('aria-hidden','false');
    };
    window.mpCloseBill = function(e){
      if (e && e.target && e.target.id !== 'mpDrawerBg') return;
      document.getElementById('mpDrawerBg').classList.remove('open');
      document.getElementById('mpDrawer').classList.remove('open');
      document.getElementById('mpDrawer').setAttribute('aria-hidden','true');
      window.__mpSelectedOcc = '';
      var pp = document.getElementById('mpOccPopup');
      if (pp) pp.classList.remove('open');
    };
    // Allow the close button (which has no target check) to always close
    document.addEventListener('DOMContentLoaded', function(){
      var closeBtn = document.querySelector('.mp-close-btn');
      if (closeBtn) closeBtn.onclick = function(){
        document.getElementById('mpDrawerBg').classList.remove('open');
        document.getElementById('mpDrawer').classList.remove('open');
        document.getElementById('mpDrawer').setAttribute('aria-hidden','true');
        window.__mpSelectedOcc = '';
        var pp = document.getElementById('mpOccPopup');
        if (pp) pp.classList.remove('open');
      };
    });

    window.mpOpenCollect = function(id, bill, student, balance, occLabel, occDateIso){
      document.getElementById('mpAssignmentId').value = id;
      document.getElementById('mpBillName').value = bill;
      document.getElementById('mpStudentName').value = student;
      document.getElementById('mpAmount').value = balance;
      document.getElementById('mpAmount').max = balance;
      document.getElementById('mpOccDisplay').value = occLabel || '';
      var occDateField = document.getElementById('mpOccurrenceDate');
      if (occDateField) occDateField.value = occDateIso || '';
      var notes = document.getElementById('mpNotes');
      notes.value = occLabel ? ('Occurrence: ' + occLabel) : '';
      var ref = document.getElementById('mpReference');
      if (occLabel && !ref.value) ref.value = 'OCC-' + occLabel.replace(/[^0-9A-Za-z]+/g,'-');
      document.getElementById('mpCollectModal').classList.add('open');
    };
    window.mpCloseCollect = function(){
      document.getElementById('mpCollectModal').classList.remove('open');
    };
  })();
</script>

