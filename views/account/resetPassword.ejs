<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
<style>
        /* Styling for form elements and security features */

        .form-group {
            margin-bottom: 15px;
        }
        .form-group label {
            display: block;
            font-weight: bold;
            margin-bottom: 5px;
        }
        .form-group input {
            width: 100%;
            padding: 10px;
            border: 1px solid #ddd;
            border-radius: 4px;
        }
        .btn-primary {
            background-color: #01535b;
            color: #fff;
            padding: 10px 15px;
            border: none;
            border-radius: 4px;
            cursor: pointer;
            width: 100%;
        }
        .btn-primary:hover {
            background-color: #01535b;
        }
        .password-strength {
            font-size: 0.9rem;
            margin-top: 5px;
            font-weight: bold;
            transition: color 0.5s ease, transform 0.3s ease;
        }
        .password-strength.weak {
            color: red;
        }
        .password-strength.medium {
            color: orange;
        }
        .password-strength.strong {
            color: green;
        }
        .password-note {
            font-size: 0.8rem;
            color: #666;
            margin-top: 5px;
        }
        .password-note ul {
            margin: 5px 0 0 20px;
            padding: 0;
        }
        .password-note ul li {
            font-size: 0.8rem;
            line-height: 1.2rem;
            color: #333;
        }
</style>   
 <script src="/js/script.js" defer></script>
</head>
<body>
    <div class="container">
        <form action="/account/reset-password" method="POST" onsubmit="return validatePasswords();">
            <h1>Reset Your Password</h1>

            <%- include('../partials/flash') %>

            <% if (typeof email !== 'undefined' && typeof token !== 'undefined') { %>
                <p>You are resetting the password for this email: <strong><%= email %></strong>.</p>
                <input type="hidden" name="token" value="<%= token %>" />

                <div class="form-group">
                    <label for="password">New Password:</label>
                    <input type="password" name="password" id="password" placeholder="e.g., Example@123" required oninput="checkPasswordStrength(this.value)">
                    <p id="password-strength" class="password-strength"></p>
                    <p class="password-note">
                        Password must be at least 6 characters long and include:
                        <ul>
                            <li>At least one uppercase letter (A-Z)</li>
                            <li>At least one lowercase letter (a-z)</li>
                            <li>At least one number (0-9)</li>
                            <li>At least one special character (!@#$%^&*)</li>
                        </ul>
                    </p>
                </div>
                <div class="form-group">
                    <label for="confirmPassword">Confirm Password:</label>
                    <input type="password" name="confirmPassword" id="confirmPassword" placeholder="Re-enter your password" required>
                </div>
                <div>
                    <input type="checkbox" id="show-password"> Show Password
                </div>

                <button type="submit" class="btn btn-primary">Reset Password</button>
            <% } else { %>
                <p>The reset link is invalid or expired. Please request a new reset link.</p>
                <a href="/account/forget-password" class="btn btn-secondary">Request New Link</a>
            <% } %>
        </form>
    </div>
    <script>
        function validatePasswords() {
            const password = document.getElementById('password').value;
            const confirmPassword = document.getElementById('confirmPassword').value;

            if (password.length < 6) {
                alert('Password must be at least 6 characters long.');
                return false;
            }

            if (password !== confirmPassword) {
                alert('Passwords do not match. Please try again.');
                return false;
            }

            return true;
        }
    </script>
</body>
</html>
