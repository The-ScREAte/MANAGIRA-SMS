<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="<%= locals.viewportContent || 'width=device-width, initial-scale=1.0, maximum-scale=1.0' %>">
  <title><%= title %></title>
  <script src="/js/script.js" defer></script>
  <style>
    .password-input-wrapper {
      position: relative;
    }

    .password-input-wrapper .form-input {
      width: 100%;
      padding-right: 38px;
    }

    .password-input-wrapper .form-input:focus {
      box-shadow: none;
    }

    .password-toggle-btn {
      position: absolute;
      right: 16px;
      top: 50%;
      transform: translateY(-50%);
      background: transparent;
      border: none;
      color: #64748b;
      cursor: pointer;
      padding: 4px;
      transition: color 0.2s ease;
      font-size: 0.95rem;
      display: flex;
      align-items: center;
      justify-content: center;
      z-index: 1;
      pointer-events: auto;
      width: 24px;
      height: 24px;
      flex-shrink: 0;
    }

    .password-toggle-btn:hover {
      color: #01535b;
      transform: translateY(-50%);
    }

    .password-toggle-btn:active {
      transform: translateY(-50%);
    }

    .password-toggle-btn:focus {
      outline: none;
      transform: translateY(-50%);
    }

    .password-toggle-btn i {
      font-size: 0.9rem;
      transition: none;
    }

    :root {
      --font-family: "Inter", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
      --primary: #01535b;
      --primary-hover: #014a51;
        --primary-hover-fill: color-mix(in srgb, var(--primary) 88%, white);
      --primary-light: rgba(1, 83, 91, 0.08);
      --text-primary: #1e293b;
      --text-secondary: #64748b;
      --border: #e2e8f0;
      --bg-page: #f8fafc;
      --bg-card: #ffffff;
      --error: #dc2626;
      --success: #059669;
      --warning: #d97706;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      font-family: var(--font-family);
      background: var(--bg-page);
    }

    .reset-page {
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: flex-start;
      padding: 40px 20px 32px;
    }

    .reset-container {
      width: 100%;
      max-width: 440px;
      margin: 0 auto;
    }

    .reset-card {
      background: var(--bg-card);
      border-radius: 14px;
      box-shadow: 0 4px 24px rgba(0, 0, 0, 0.08), 0 1px 3px rgba(0, 0, 0, 0.04);
      padding: 28px 26px;
      border: 1px solid var(--border);
    }

    .reset-header {
      text-align: center;
      margin-bottom: 20px;
    }

    .reset-header .icon {
      width: 52px;
      height: 52px;
      background: var(--primary-light);
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      margin: 0 auto 12px;
    }

    .reset-header .icon svg {
      width: 24px;
      height: 24px;
      color: var(--primary);
    }

    .reset-header h1 {
      font-size: 1.5rem;
      font-weight: 700;
      color: var(--text-primary);
      margin-bottom: 6px;
    }

    .reset-header p {
      color: var(--text-secondary);
      font-size: 0.9rem;
      line-height: 1.5;
    }

    .reset-header p strong {
      color: var(--primary);
    }

    .form-group {
      margin-bottom: 16px;
    }

    .form-label {
      display: block;
      font-weight: 600;
      color: var(--text-primary);
      margin-bottom: 8px;
      font-size: 0.9rem;
    }

    .form-input {
      display: block;
      width: 100%;
      min-width: 0;
      max-width: 100%;
      box-sizing: border-box;
      padding: 5px 16px;
      height: 36px;
      line-height: 1.2;
      -webkit-appearance: none;
      appearance: none;
      border: 2px solid var(--border);
      border-radius: 10px;
      font-size: 1rem;
      font-family: inherit;
      transition: all 0.2s ease;
      background: var(--bg-card);
      color: var(--text-primary);
    }

    .form-input:focus {
      outline: none;
      border-color: var(--primary);
      box-shadow: 0 0 0 3px var(--primary-light);
    }

    .form-input::placeholder {
      color: var(--text-secondary);
      opacity: 0.7;
    }

    .password-strength {
      font-size: 0.85rem;
      margin-top: 8px;
      font-weight: 600;
      transition: color 0.3s ease;
    }

    .password-strength.weak { color: var(--error); }
    .password-strength.medium { color: var(--warning); }
    .password-strength.strong { color: var(--success); }

    .password-requirements {
      background: #f8fafc;
      border-radius: 8px;
      padding: 10px 14px;
      margin-top: 10px;
      border: 1px solid var(--border);
    }

    .password-requirements p {
      font-size: 0.8rem;
      color: var(--text-secondary);
      margin-bottom: 6px;
    }

    .password-requirements ul {
      margin: 0;
      padding-left: 20px;
    }

    .password-requirements li {
      font-size: 0.8rem;
      color: var(--text-secondary);
      line-height: 1.6;
    }

    .password-toggle {
      display: flex;
      align-items: center;
      gap: 8px;
      margin-top: 12px;
      font-size: 0.85rem;
      color: var(--text-secondary);
      cursor: pointer;
    }

    .password-toggle input[type="checkbox"] {
      width: 16px;
      height: 16px;
      cursor: pointer;
      accent-color: var(--primary);
    }

    .btn-primary {
      width: 100%;
      padding: 14px 24px;
      background: linear-gradient(135deg, var(--primary) 0%, #0a6d77 100%);
      color: white;
      border: none;
      border-radius: 10px;
      font-size: 1rem;
      font-weight: 600;
      cursor: pointer;
      transition: all 0.2s ease;
      box-shadow: 0 2px 8px rgba(1, 83, 91, 0.25);
      margin-top: 8px;
    }

    .btn-primary:hover {
      transform: translateY(-2px);
      box-shadow: 0 6px 20px rgba(1, 83, 91, 0.35);
    }

    .btn-secondary {
      display: inline-block;
      width: 100%;
      padding: 14px 24px;
      background: var(--bg-card);
      color: var(--text-primary);
      border: 2px solid var(--border);
      border-radius: 10px;
      font-size: 1rem;
      font-weight: 600;
      text-decoration: none;
      text-align: center;
      transition: all 0.2s ease;
      margin-top: 16px;
    }

    .btn-secondary:hover {
      background: #f8fafc;
      border-color: var(--primary);
      color: var(--primary);
    }

    .error-state {
      text-align: center;
    }

    .error-state .icon {
      background: #fee2e2;
    }

    .error-state .icon svg {
      color: var(--error);
    }

    @media (max-width: 480px) {
      .reset-card {
        padding: 24px 20px;
      }

      .reset-header h1 {
        font-size: 1.1rem;
      }

      .reset-header p {
        font-size: 0.8rem;
      }

      .form-label {
        font-size: 0.8rem;
      }

      .form-input {
        padding: 3px 10px;
        font-size: 14px;
        height: 32px;
      }

      .btn-primary {
        padding: 8px 16px;
        font-size: 0.85rem;
      }

      .btn-secondary {
        padding: 10px 18px;
        font-size: 0.85rem;
      }
    }
  </style>
</head>
<body>
  <div class="reset-page">
    <div class="reset-container">
    <div class="reset-card">
      <%- include('../partials/flash') %>

      <% if (typeof email !== 'undefined' && typeof token !== 'undefined') { %>
        <div class="reset-header">
          <div class="icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M15 7a2 2 0 0 1 2 2m4 0a6 6 0 0 1-7.743 5.743L11 17H9v2H7v2H4a1 1 0 0 1-1-1v-2.586a1 1 0 0 1 .293-.707l5.964-5.964A6 6 0 1 1 21 9z"></path>
            </svg>
          </div>
          <h1>Reset password</h1>
          <p>Choose a new password for <strong><%= email %></strong>.</p>
        </div>

        <form action="/account/reset-password" method="POST" onsubmit="return validatePasswords();">
          <input type="hidden" name="token" value="<%= token %>" />

          <div class="form-group">
            <label class="form-label" for="password">New Password</label>
            <div class="password-input-wrapper">
              <input 
                type="password" 
                name="password" 
                id="password" 
                class="form-input" 
                placeholder="Create a strong password" 
                required 
                oninput="checkPasswordStrength(this.value)"
              />
              <button type="button" class="password-toggle-btn" onclick="toggleMultiplePasswords(['password', 'confirmPassword'], this)" aria-label="Show passwords">
                <i class="fa-solid fa-eye fa-fw" aria-hidden="true"></i>
              </button>
            </div>
            <p id="password-strength" class="password-strength"></p>
            
            <div class="password-requirements">
              <p>At least 6 characters, with an uppercase letter, a number, and a special character.</p>
            </div>
          </div>

          <div class="form-group">
            <label class="form-label" for="confirmPassword">Confirm Password</label>
            <div class="password-input-wrapper">
              <input 
                type="password" 
                name="confirmPassword" 
                id="confirmPassword" 
                class="form-input" 
                placeholder="Re-enter your password" 
                required 
              />
            </div>
          </div>

          <button type="submit" class="btn-primary">Reset Password</button>
        </form>
      <% } else { %>
        <div class="reset-header error-state">
          <div class="icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="12" cy="12" r="10"></circle>
              <line x1="12" y1="8" x2="12" y2="12"></line>
              <line x1="12" y1="16" x2="12.01" y2="16"></line>
            </svg>
          </div>
          <h1>Link expired</h1>
          <p>This reset link is invalid or has expired. Please request a new one.</p>
        </div>
        <a href="/account/forget-password" class="btn-secondary">Request New Link</a>
      <% } %>
    </div>
  </div>

  <script>
    function toggleMultiplePasswords(inputIds, button) {
      const icon = button.querySelector('i');
      const firstInput = document.getElementById(inputIds[0]);
      const isVisible = firstInput.type === 'text';
      
      inputIds.forEach(id => {
        const input = document.getElementById(id);
        if (input) input.type = isVisible ? 'password' : 'text';
      });
      
      icon.classList.remove('fa-eye', 'fa-eye-slash');
      icon.classList.add(isVisible ? 'fa-eye' : 'fa-eye-slash');
      button.setAttribute('aria-label', isVisible ? 'Show passwords' : 'Hide passwords');
    }

    function validatePasswords() {
      const password = document.getElementById('password').value;
      const confirmPassword = document.getElementById('confirmPassword').value;

      if (password.length < 6) {
        alert('Password must be at least 6 characters long.');
        return false;
      }

      if (password !== confirmPassword) {
        alert('Passwords do not match. Please try again.');
        return false;
      }

      return true;
    }
  </script>
</body>
</html>
