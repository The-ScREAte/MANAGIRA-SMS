  // ===== Reports filter =====
  function finRunReportFilter() {
    var tbody = document.querySelector('#reportBillsTable tbody');
    if (!tbody) return;
    var q   = (document.getElementById('rptStudent')||{}).value || '';
    var cls = (document.getElementById('rptClass')  ||{}).value || '';
    var yr  = (document.getElementById('rptYear')   ||{}).value || '';
    var tm  = (document.getElementById('rptTerm')   ||{}).value || '';
    var st  = (document.getElementById('rptStatus') ||{}).value || '';
    q = q.trim().toLowerCase();
    var rows = tbody.querySelectorAll('tr');
    var shown = 0;
    rows.forEach(function(r) {
      var text   = (r.getAttribute('data-text') || '').toLowerCase();
      var status = r.getAttribute('data-status') || '';
      var year   = r.getAttribute('data-year') || '';
      var term   = r.getAttribute('data-term') || '';
      var ok = true;
      if (q   && text.indexOf(q) === -1) ok = false;
      if (yr  && year !== yr)           ok = false;
      if (tm  && term !== tm)           ok = false;
      if (st  && status !== st)         ok = false;
      // class filter not stored on bill rows (bills span many classes) — skip
      r.style.display = ok ? '' : 'none';
      if (ok) shown++;
    });
    var empty = document.getElementById('reportEmpty');
    if (empty) empty.style.display = shown === 0 ? '' : 'none';
  }
  function finResetReportFilter() {
    ['rptStudent','rptClass','rptYear','rptTerm','rptStatus'].forEach(function(id) {
      var el = document.getElementById(id);
      if (el) el.value = '';
    });
    finRunReportFilter();
  }

  function finRunSignoffFilter() {
    var table = document.getElementById('signoffHistoryTable');
    if (!table) return;
    var query = ((document.getElementById('signoffSearch') || {}).value || '').trim().toLowerCase();
    var rows = table.querySelectorAll('tbody tr');
    var shown = 0;
    rows.forEach(function(row) {
      var text = (row.getAttribute('data-text') || '').toLowerCase();
      var ok = !query || text.indexOf(query) !== -1;
      row.style.display = ok ? '' : 'none';
      if (ok) shown += 1;
    });
    var empty = document.getElementById('signoffHistoryEmpty');
    if (empty) empty.style.display = shown === 0 ? '' : 'none';
  }

  // ===== Fee recovery =====
  var arrearsFilterForm = document.getElementById('arrearsFilterForm');
  var arrearsPresetForm = document.getElementById('arrearsPresetForm');
  var arrearsRecipients = <%- JSON.stringify((arrearsData && arrearsData.recipientReview && arrearsData.recipientReview.recipients) || []) %>;
  var arrearsManualRecipients = {};
  function updateArrearsMultiselectSummary(box) {
    if (!box) return;
    var summary = box.querySelector('[data-arrears-summary]');
    var meta = box.querySelector('[data-arrears-meta]');
    var checked = Array.prototype.slice.call(box.querySelectorAll('input[type="checkbox"]:checked'));
    var labels = checked.map(function(input) {
      var copy = input.closest('.arrears-multiselect-option');
      var strong = copy ? copy.querySelector('strong') : null;
      return strong ? strong.textContent.trim() : String(input.value || '').trim();
    }).filter(Boolean);
    if (summary) {
      if (!labels.length) summary.textContent = box.getAttribute('data-empty-label') || 'All items';
      else if (labels.length === 1) summary.textContent = labels[0];
      else summary.textContent = labels.length + ' selected';
    }
    if (meta) {
      meta.textContent = labels.length ? (labels.length + ' chosen') : (box.getAttribute('data-empty-meta') || 'Ready');
    }
    box.querySelectorAll('.arrears-multiselect-option').forEach(function(option) {
