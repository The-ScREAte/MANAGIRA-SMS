        + '<div class="fin-field"><label style="font-size:.72rem;">Relationship</label><input type="text" value="' + (merged.guardian_relationship || 'Guardian').replace(/"/g, '&quot;') + '" oninput="updateArrearsRecipientField(\'' + item.student_id + '\',\'relationship\',this.value)"></div>'
        + '</div>'
        + '<div class="fin-row" style="grid-template-columns:1fr 1fr;gap:8px;">'
        + '<div class="fin-field"><label style="font-size:.72rem;">Email</label><input type="email" value="' + (merged.guardian_email || '').replace(/"/g, '&quot;') + '" oninput="updateArrearsRecipientField(\'' + item.student_id + '\',\'email\',this.value)"></div>'
        + '<div class="fin-field"><label style="font-size:.72rem;">Phone</label><input type="text" value="' + (merged.guardian_phone || '').replace(/"/g, '&quot;') + '" oninput="updateArrearsRecipientField(\'' + item.student_id + '\',\'phone\',this.value)"></div>'
