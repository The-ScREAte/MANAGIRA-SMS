  // ===== Fee recovery =====
  var arrearsFilterForm = document.getElementById('arrearsFilterForm');
  var arrearsPresetForm = document.getElementById('arrearsPresetForm');
  var arrearsRecipients = <%- JSON.stringify((arrearsData && arrearsData.recipientReview && arrearsData.recipientReview.recipients) || []) %>;
  var arrearsManualRecipients = {};
  function updateArrearsMultiselectSummary(box) {
    if (!box) return;
    var summary = box.querySelector('[data-arrears-summary]');
    var meta = box.querySelector('[data-arrears-meta]');
    var checked = Array.prototype.slice.call(box.querySelectorAll('input[type="checkbox"]:checked'));
    var labels = checked.map(function(input) {
      var copy = input.closest('.arrears-multiselect-option');
      var strong = copy ? copy.querySelector('strong') : null;
      return strong ? strong.textContent.trim() : String(input.value || '').trim();
    }).filter(Boolean);
    if (summary) {
      if (!labels.length) summary.textContent = box.getAttribute('data-empty-label') || 'All items';
      else if (labels.length === 1) summary.textContent = labels[0];
      else summary.textContent = labels.length + ' selected';
    }
    if (meta) {
      meta.textContent = labels.length ? (labels.length + ' chosen') : (box.getAttribute('data-empty-meta') || 'Ready');
    }
    box.querySelectorAll('.arrears-multiselect-option').forEach(function(option) {
      var input = option.querySelector('input[type="checkbox"]');
      option.classList.toggle('checked', !!(input && input.checked));
    });
  }
  function closeArrearsMultiselects(exceptBox) {
    document.querySelectorAll('[data-arrears-multiselect]').forEach(function(box) {
      if (box !== exceptBox) box.classList.remove('open');
    });
  }
  function syncArrearsManualRecipients() {
    var input = document.getElementById('arrearsManualGuardiansJson');
    if (input) input.value = JSON.stringify(arrearsManualRecipients);
  }
  function getArrearsRecipient(studentId) {
    var id = String(studentId);
    return arrearsRecipients.find(function(item) { return String(item.student_id) === id; }) || null;
  }
  function getMergedArrearsRecipient(studentId) {
    var base = getArrearsRecipient(studentId) || { student_id: studentId };
    var manual = arrearsManualRecipients[String(studentId)] || {};
    return {
      student_id: base.student_id,
      student_name: base.student_name || 'Student',
      class_name: base.class_name || '',
      outstanding: base.outstanding || 0,
      guardian_name: manual.guardian_name != null ? manual.guardian_name : (base.guardian_name || ''),
      guardian_email: manual.email != null ? manual.email : (base.guardian_email || ''),
      guardian_phone: manual.phone != null ? manual.phone : (base.guardian_phone || ''),
      guardian_relationship: manual.relationship != null ? manual.relationship : (base.guardian_relationship || 'Guardian'),
    };
  }
  function getSelectedArrearsIds() {
    return Array.prototype.slice.call(document.querySelectorAll('.arrears-select:checked')).map(function(cb) { return cb.value; });
  }
  function syncArrearsSelection() {
    var ids = getSelectedArrearsIds();
    var count = document.getElementById('arrearsSelectedCount');
    if (count) count.textContent = ids.length + ' selected';
    var reportField = document.getElementById('arrearsReportSelectedIds');
    if (reportField) reportField.value = ids.join(',');
    var emailField = document.getElementById('arrearsEmailSelectedIds');
    if (emailField) emailField.value = ids.join(',');
    var selectAll = document.getElementById('arrearsSelectAll');
    var all = document.querySelectorAll('.arrears-select');
    if (selectAll && all.length) selectAll.checked = ids.length === all.length;
  }
  window.toggleAllArrears = function (source) {
    document.querySelectorAll('.arrears-select').forEach(function(cb) { cb.checked = !!source.checked; });
    syncArrearsSelection();
  };
  window.clearArrearsSelection = function () {
    document.querySelectorAll('.arrears-select').forEach(function(cb) { cb.checked = false; });
    var selectAll = document.getElementById('arrearsSelectAll');
    if (selectAll) selectAll.checked = false;
    syncArrearsSelection();
  };
  window.toggleArrearsDetails = function (studentId) {
    var row = document.getElementById('arrears-detail-' + studentId);
    if (!row) return;
    row.style.display = row.style.display === 'none' ? '' : 'none';
  };
  function injectArrearsFilterPayload(form) {
    if (!form || !arrearsFilterForm) return;
    var host = form.querySelector('.arrears-filter-payload');
    if (!host) return;
    host.innerHTML = '';
    var fd = new FormData(arrearsFilterForm);
    fd.forEach(function(value, key) {
      var input = document.createElement('input');
      input.type = 'hidden';
      input.name = key;
      input.value = value;
      host.appendChild(input);
    });
  }
  function setModalOpen(id, open) {
    var modal = document.getElementById(id);
    if (modal) modal.classList[open ? 'add' : 'remove']('open');
    /* Lock body scroll while any arrears modal is open to prevent
       the "ghost scroll / stuck UI" feeling on small screens. */
    var anyOpen = !!document.querySelector('#arrearsReportModal.open, #arrearsEmailModal.open, #arrearsNoteModal.open');
    document.body.style.overflow = anyOpen ? 'hidden' : '';
  }
  /* Click outside arrears modal panel closes it */
  ['arrearsReportModal','arrearsEmailModal','arrearsNoteModal'].forEach(function(id) {
    var m = document.getElementById(id);
    if (!m) return;
    m.addEventListener('click', function(e) { if (e.target === m) setModalOpen(id, false); });
  });
  document.addEventListener('keydown', function (e) {
    if (e.key !== 'Escape') return;
    ['arrearsReportModal','arrearsEmailModal','arrearsNoteModal'].forEach(function(id) {
      var m = document.getElementById(id);
      if (m && m.classList.contains('open')) setModalOpen(id, false);
    });
  });
  window.openArrearsReportModal = function () {
    injectArrearsFilterPayload(document.getElementById('arrearsReportForm'));
    syncArrearsSelection();
    setModalOpen('arrearsReportModal', true);
  };
  window.closeArrearsReportModal = function () { setModalOpen('arrearsReportModal', false); };
  window.toggleArrearsRecipientEditor = function (studentId) {
    var editor = document.getElementById('arrears-recipient-editor-' + studentId);
    if (!editor) return;
    editor.style.display = editor.style.display === 'none' ? '' : 'none';
  };
  window.updateArrearsRecipientField = function (studentId, field, value) {
    var id = String(studentId);
    var manual = arrearsManualRecipients[id] || {};
    manual[field] = value;
    arrearsManualRecipients[id] = manual;
    syncArrearsManualRecipients();
  };
  function renderArrearsRecipients(selectedIds) {
    var host = document.getElementById('arrearsRecipientList');
    var count = document.getElementById('arrearsRecipientCount');
    if (!host) return;
    var ids = Array.isArray(selectedIds) ? selectedIds : getSelectedArrearsIds();
    var wanted = ids.length ? arrearsRecipients.filter(function(item) { return ids.indexOf(String(item.student_id)) !== -1; }) : arrearsRecipients;
    count.textContent = wanted.length + ' recipient(s)';
    if (!wanted.length) {
      host.innerHTML = '<div class="empty-state" style="padding:26px 10px;"><div class="ico">✉️</div><h3>No recipients selected</h3><p>Select one or more students from the arrears table first.</p></div>';
      return;
    }
    host.innerHTML = wanted.map(function(item) {
      var merged = getMergedArrearsRecipient(item.student_id);
      var status = merged.guardian_email ? 'ready' : (merged.guardian_name ? 'missing_email' : 'missing_guardian');
      return '<div class="arrears-recipient-item">'
        + '<div style="flex:1;min-width:0;"><strong>' + (merged.student_name || 'Student') + '</strong><span>' + (merged.guardian_name || 'No guardian') + ' · ' + (merged.guardian_email || merged.guardian_phone || 'No contact') + '</span><span>' + (merged.class_name || 'No class') + ' · ' + fmt(merged.outstanding || 0) + '</span>'
        + '<div id="arrears-recipient-editor-' + item.student_id + '" style="display:none;margin-top:10px;">'
        + '<div class="fin-row" style="grid-template-columns:1fr 1fr;gap:8px;">'
        + '<div class="fin-field"><label style="font-size:.72rem;">Guardian Name</label><input type="text" value="' + (merged.guardian_name || '').replace(/"/g, '&quot;') + '" oninput="updateArrearsRecipientField(\'' + item.student_id + '\',\'guardian_name\',this.value)"></div>'
        + '<div class="fin-field"><label style="font-size:.72rem;">Relationship</label><input type="text" value="' + (merged.guardian_relationship || 'Guardian').replace(/"/g, '&quot;') + '" oninput="updateArrearsRecipientField(\'' + item.student_id + '\',\'relationship\',this.value)"></div>'
        + '</div>'
        + '<div class="fin-row" style="grid-template-columns:1fr 1fr;gap:8px;">'
        + '<div class="fin-field"><label style="font-size:.72rem;">Email</label><input type="email" value="' + (merged.guardian_email || '').replace(/"/g, '&quot;') + '" oninput="updateArrearsRecipientField(\'' + item.student_id + '\',\'email\',this.value)"></div>'
        + '<div class="fin-field"><label style="font-size:.72rem;">Phone</label><input type="text" value="' + (merged.guardian_phone || '').replace(/"/g, '&quot;') + '" oninput="updateArrearsRecipientField(\'' + item.student_id + '\',\'phone\',this.value)"></div>'
        + '</div></div></div>'
        + '<div style="display:flex;align-items:flex-start;gap:8px;flex-shrink:0;">'
        + '<button type="button" class="fin-btn sm" onclick="toggleArrearsRecipientEditor(\'' + item.student_id + '\')">✎</button>'
        + '<span class="flag ' + status + '">' + (status === 'ready' ? 'Ready' : (status === 'missing_email' ? 'Missing Email' : 'Missing Guardian')) + '</span>'
        + '</div>'
        + '</div>';
    }).join('');
  }
  window.openArrearsEmailDrawer = function (studentId, openEditor) {
    if (studentId) {
      clearArrearsSelection();
      var checkbox = document.querySelector('.arrears-select[value="' + studentId + '"]');
      if (checkbox) checkbox.checked = true;
      syncArrearsSelection();
    } else {
      syncArrearsSelection();
    }
    injectArrearsFilterPayload(document.getElementById('arrearsEmailForm'));
    renderArrearsRecipients(studentId ? [String(studentId)] : getSelectedArrearsIds());
    setModalOpen('arrearsEmailModal', true);
    if (studentId && openEditor) {
      var editor = document.getElementById('arrears-recipient-editor-' + studentId);
      if (editor) editor.style.display = '';
    }
  };
  window.openArrearsEmailAll = function () {
    injectArrearsFilterPayload(document.getElementById('arrearsEmailForm'));
    var emailField = document.getElementById('arrearsEmailSelectedIds');
    if (emailField) emailField.value = '';
    renderArrearsRecipients([]);
    setModalOpen('arrearsEmailModal', true);
  };
  window.closeArrearsEmailDrawer = function () { setModalOpen('arrearsEmailModal', false); };
  window.openArrearsNoteModal = function (studentId, studentName) {
    var idField = document.getElementById('arrearsNoteStudentId');
    var nameField = document.getElementById('arrearsNoteStudentName');
    if (idField) idField.value = studentId;
    if (nameField) nameField.value = studentName || '';
    setModalOpen('arrearsNoteModal', true);
  };
  window.closeArrearsNoteModal = function () { setModalOpen('arrearsNoteModal', false); };
  document.querySelectorAll('.arrears-select').forEach(function(cb) {
    cb.addEventListener('change', syncArrearsSelection);
  });
  syncArrearsSelection();
  syncArrearsManualRecipients();

  /* Collapsible arrears panels — default closed on every screen */
  document.querySelectorAll('[data-arrears-collapse]').forEach(function(panel) {
    var toggle = panel.querySelector('[data-arrears-collapse-toggle]');
    if (!toggle) return;
    toggle.addEventListener('click', function () {
      var willOpen = !panel.classList.contains('open');
      panel.classList.toggle('open', willOpen);
      toggle.setAttribute('aria-expanded', willOpen ? 'true' : 'false');
      var badge = toggle.querySelector('.badge');
      if (badge) badge.textContent = willOpen ? 'Open' : 'Tap to open';
    });
  });

  var overviewYearSelect = document.getElementById('finOverviewYear');
  var overviewTermSelect = document.getElementById('finOverviewTerm');
  if (overviewYearSelect && overviewTermSelect) {
    window.syncSingleTermSelect(overviewYearSelect, overviewTermSelect, { keepBlankWhenYearChanges: false });
    overviewYearSelect.addEventListener('change', function () {
      window.syncSingleTermSelect(overviewYearSelect, overviewTermSelect, { keepBlankWhenYearChanges: true });
      overviewYearSelect.form && overviewYearSelect.form.submit();
    });
    overviewTermSelect.addEventListener('change', function () {
      overviewTermSelect.form && overviewTermSelect.form.submit();
    });
  }

  var billListYearFilter = document.getElementById('billListYearFilter');
  var billListTermFilter = document.getElementById('billListTermFilter');
  if (billListYearFilter && billListTermFilter) {
    window.syncSingleTermSelect(billListYearFilter, billListTermFilter, { keepBlankWhenYearChanges: false });
    billListYearFilter.addEventListener('change', function () {
      window.syncSingleTermSelect(billListYearFilter, billListTermFilter, { keepBlankWhenYearChanges: true });
    });
  }

  var studentBillingYearFilter = document.getElementById('studentBillingYearFilter');
  var studentBillingTermFilter = document.getElementById('studentBillingTermFilter');
  if (studentBillingYearFilter && studentBillingTermFilter) {
    window.syncSingleTermSelect(studentBillingYearFilter, studentBillingTermFilter, { keepBlankWhenYearChanges: false });
    studentBillingYearFilter.addEventListener('change', function () {
      window.syncSingleTermSelect(studentBillingYearFilter, studentBillingTermFilter, { keepBlankWhenYearChanges: true });
    });
  }

  var billCreateYearSelect = document.getElementById('billCreateYearSelect');
  var billCreateTermSelect = document.getElementById('billCreateTermSelect');
  var billTypeSelect = document.getElementById('billTypeSel');
  var billCreateRecurrenceSelect = document.getElementById('billCreateRecurrence');
  var billCreateExcludeCheckbox = document.getElementById('billCreateExcludeNonSchoolDays');
  var billCreateStartDate = document.getElementById('billCreateStartDate');
  var billCreateEndDate = document.getElementById('billCreateEndDate');
  if (billTypeSelect) {
    window.syncBillScheduleControls(billTypeSelect, billCreateRecurrenceSelect, billCreateExcludeCheckbox);
    billTypeSelect.addEventListener('change', function () {
      window.syncBillScheduleControls(billTypeSelect, billCreateRecurrenceSelect, billCreateExcludeCheckbox);
    });
  }
  if (billCreateYearSelect && billCreateTermSelect) {
    window.syncSingleTermSelect(billCreateYearSelect, billCreateTermSelect, { keepBlankWhenYearChanges: false });
    window.syncBillTargetClasses();
    window.syncBillTargetStudents();
    window.autofillBillScheduleDates(billCreateTermSelect, billCreateStartDate, billCreateEndDate);
    syncCreateBillDateLimits();
    billCreateYearSelect.addEventListener('change', function () {
      window.syncSingleTermSelect(billCreateYearSelect, billCreateTermSelect, { keepBlankWhenYearChanges: true });
      window.syncBillTargetClasses();
      window.syncBillTargetStudents();
      window.autofillBillScheduleDates(billCreateTermSelect, billCreateStartDate, billCreateEndDate);
      syncCreateBillDateLimits();
    });
    billCreateTermSelect.addEventListener('change', function () {
      window.syncBillTargetClasses();
      window.syncBillTargetStudents();
      window.autofillBillScheduleDates(billCreateTermSelect, billCreateStartDate, billCreateEndDate);
      syncCreateBillDateLimits();
    });
  }
  if (billCreateStartDate) billCreateStartDate.addEventListener('change', syncCreateBillDateLimits);
  if (billCreateEndDate) billCreateEndDate.addEventListener('change', syncCreateBillDateLimits);
  if (createBillDraft) applyCreateBillDraft(createBillDraft);
  syncCreateBillPaymentMethodMaster();
  syncCreateBillDateLimits();
  if (shouldOpenCreateBillForm) {
    var createBillAccordion = document.getElementById('acc-create-bill');
    if (createBillAccordion && !createBillAccordion.classList.contains('open')) {
      finToggleAcc('acc-create-bill');
    }
  }

  var editBillYearSelect = document.getElementById('ebl-school_year_id');
  var editBillTermSelect = document.getElementById('ebl-term_id');
  var editBillAudienceSelect = document.getElementById('ebl-applies_to');
  var editBillTypeSelect = document.getElementById('ebl-bill_type');
  var editBillRecurrenceSelect = document.getElementById('ebl-recurrence');
  var editBillExcludeCheckbox = document.getElementById('ebl-exclude_non_school_days');
  var editBillStartDate = document.getElementById('ebl-due_date');
  var editBillEndDate = document.getElementById('ebl-recurrence_end_date');
  if (editBillTypeSelect) {
    window.syncBillScheduleControls(editBillTypeSelect, editBillRecurrenceSelect, editBillExcludeCheckbox);
    editBillTypeSelect.addEventListener('change', function () {
      window.syncBillScheduleControls(editBillTypeSelect, editBillRecurrenceSelect, editBillExcludeCheckbox);
    });
  }
  if (editBillYearSelect && editBillTermSelect) {
    window.syncSingleTermSelect(editBillYearSelect, editBillTermSelect, { keepBlankWhenYearChanges: false });
    if (typeof syncEditBillTargets === 'function') syncEditBillTargets();
    editBillYearSelect.addEventListener('change', function () {
      window.syncSingleTermSelect(editBillYearSelect, editBillTermSelect, { keepBlankWhenYearChanges: true });
      if (typeof syncEditBillTargets === 'function') syncEditBillTargets();
      window.autofillBillScheduleDates(editBillTermSelect, editBillStartDate, editBillEndDate);
    });
    editBillTermSelect.addEventListener('change', function () {
      if (typeof syncEditBillTargets === 'function') syncEditBillTargets();
      window.autofillBillScheduleDates(editBillTermSelect, editBillStartDate, editBillEndDate);
    });
  }
  if (editBillAudienceSelect && typeof syncEditBillTargets === 'function') {
    editBillAudienceSelect.addEventListener('change', syncEditBillTargets);
  }
  ['ebl-target_class_ids', 'ebl-target_student_ids'].forEach(function(id) {
    var select = document.getElementById(id);
    if (select && typeof syncEditBillTargets === 'function') {
      select.addEventListener('change', syncEditBillTargets);
    }
  });
  [['ebl-target_class_search', 'ebl-target_class_ids'], ['ebl-target_student_search', 'ebl-target_student_ids']].forEach(function(pair) {
    var input = document.getElementById(pair[0]);
    if (!input) return;
    input.addEventListener('input', function () {
      if (typeof filterEditBillTargetOptions === 'function') filterEditBillTargetOptions(pair[1], input.value || '');
    });
  });
  [['ebl-target_class_select_all', 'ebl-target_class_ids', true], ['ebl-target_class_clear', 'ebl-target_class_ids', false], ['ebl-target_student_select_all', 'ebl-target_student_ids', true], ['ebl-target_student_clear', 'ebl-target_student_ids', false]].forEach(function(config) {
    var button = document.getElementById(config[0]);
    if (!button) return;
    button.addEventListener('click', function () {
      if (typeof setAllEditBillTargets === 'function') setAllEditBillTargets(config[1], config[2]);
    });
  });
  ['ebl-target_class_ids', 'ebl-target_student_ids'].forEach(function(id) {
    if (typeof enableEditBillToggleMultiSelect === 'function') enableEditBillToggleMultiSelect(id);
  });
  if (typeof enableEditBillToggleMultiSelect === 'function') enableEditBillToggleMultiSelect('ebl-assignee');
  var editBillAssigneeSelect = document.getElementById('ebl-assignee');
  if (editBillAssigneeSelect && typeof syncEditBillCollectorSummary === 'function') {
    editBillAssigneeSelect.addEventListener('change', syncEditBillCollectorSummary);
    syncEditBillCollectorSummary();
  }
  var editBillPayAll = document.getElementById('ebl-payAll');
  if (editBillPayAll) {
    editBillPayAll.addEventListener('change', function () {
      if (typeof toggleAllEditBillPaymentMethods === 'function') toggleAllEditBillPaymentMethods(editBillPayAll.checked);
    });
  }
  document.querySelectorAll('.ebl-pay-method').forEach(function(input) {
    input.addEventListener('change', function () {
      if (typeof syncEditBillPaymentMethodMaster === 'function') syncEditBillPaymentMethodMaster();
    });
  });
  if (typeof syncEditBillPaymentMethodMaster === 'function') syncEditBillPaymentMethodMaster();

  document.querySelectorAll('[data-arrears-multiselect]').forEach(function(box) {
    box.setAttribute('data-empty-label', box.querySelector('[data-arrears-summary]') ? box.querySelector('[data-arrears-summary]').textContent : 'All items');
    box.setAttribute('data-empty-meta', box.querySelector('[data-arrears-meta]') ? box.querySelector('[data-arrears-meta]').textContent : 'No filters applied');
    var trigger = box.querySelector('[data-arrears-trigger]');
    if (trigger) {
      trigger.addEventListener('click', function () {
        var willOpen = !box.classList.contains('open');
        closeArrearsMultiselects(box);
        box.classList.toggle('open', willOpen);
      });
    }
    var selectAll = box.querySelector('[data-arrears-select-all]');
    if (selectAll) {
      selectAll.addEventListener('click', function () {
        box.querySelectorAll('input[type="checkbox"]').forEach(function(input) {
          var option = input.closest('.arrears-multiselect-option');
          if (input.disabled || (option && option.hidden)) return;
          input.checked = true;
        });
        if (box.querySelector('input[name="schoolYearIds"]')) window.syncArrearsYearTerms();
        else if (box.querySelector('input[name="termIds"]')) window.syncArrearsClasses();
        updateArrearsMultiselectSummary(box);
      });
    }
    var clear = box.querySelector('[data-arrears-clear]');
    if (clear) {
      clear.addEventListener('click', function () {
        box.querySelectorAll('input[type="checkbox"]').forEach(function(input) { input.checked = false; });
        if (box.querySelector('input[name="schoolYearIds"]')) window.syncArrearsYearTerms();
        else if (box.querySelector('input[name="termIds"]')) window.syncArrearsClasses();
        updateArrearsMultiselectSummary(box);
      });
    }
    box.querySelectorAll('input[type="checkbox"]').forEach(function(input) {
      input.addEventListener('change', function () {
        if (input.name === 'schoolYearIds') window.syncArrearsYearTerms();
        if (input.name === 'termIds') window.syncArrearsClasses();
        updateArrearsMultiselectSummary(box);
      });
    });
    updateArrearsMultiselectSummary(box);
  });
  window.syncArrearsYearTerms();

  document.addEventListener('click', function (event) {
    var holder = event.target.closest('[data-arrears-multiselect]');
    if (!holder) closeArrearsMultiselects();
  });

  document.addEventListener('keydown', function (event) {
    if (event.key === 'Escape') closeArrearsMultiselects();
  });

  if (arrearsPresetForm) {
    arrearsPresetForm.addEventListener('submit', function () { injectArrearsFilterPayload(arrearsPresetForm); });
  }
  document.querySelectorAll('[data-arrears-preset]').forEach(function(btn) {
    btn.addEventListener('click', function () {
      if (!arrearsFilterForm) return;
      var filters = {};
      try { filters = JSON.parse(btn.getAttribute('data-arrears-preset') || '{}'); } catch (_) { filters = {}; }
      ['schoolYearIds','termIds','classIds','billIds'].forEach(function(name) {
        var selected = filters[name] || [];
        arrearsFilterForm.querySelectorAll('input[name="' + name + '"]').forEach(function(input) {
          input.checked = selected.indexOf(String(input.value)) !== -1;
        });
      });
      window.syncArrearsYearTerms();
      arrearsFilterForm.querySelectorAll('input[name="statuses"]').forEach(function(input) {
        input.checked = (filters.statuses || []).indexOf(input.value) !== -1;
      });
      ['dueFrom','dueTo','minOutstanding','search','paymentMethodFilter','emailStatusFilter'].forEach(function(name) {
        var el = arrearsFilterForm.querySelector('[name="' + name + '"]');
        if (el) el.value = filters[name] || (name === 'minOutstanding' ? '' : '');
      });
      document.querySelectorAll('[data-arrears-multiselect]').forEach(function(box) { updateArrearsMultiselectSummary(box); });
      arrearsFilterForm.submit();
    });
  });

  function finSetPrimaryChargeCard(authorizationCode) {
    return fetch('/account/cards/set-primary', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ authorizationCode: authorizationCode })
    });
  }

  function finSetFallbackOrder(authorizationCode, fallbackOrder) {
    return fetch('/account/cards/set-fallback-order', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ authorizationCode: authorizationCode, fallbackOrder: fallbackOrder })
    });
  }

  document.querySelectorAll('[data-fin-set-primary]').forEach(function(button) {
    button.addEventListener('click', async function () {
      try {
        var res = await finSetPrimaryChargeCard(button.getAttribute('data-fin-set-primary'));
        var data = await res.json();
        if (data && data.success) window.location.reload();
        else alert((data && data.message) || 'Failed to update primary card.');
      } catch (error) {
        alert('Unable to update the primary card right now.');
      }
    });
  });

  document.querySelectorAll('[data-fin-fallback-order]').forEach(function(input) {
    var submitFallback = async function () {
      try {
        var res = await finSetFallbackOrder(input.getAttribute('data-fin-fallback-order'), input.value.trim());
        var data = await res.json();
        if (data && data.success) window.location.reload();
        else alert((data && data.message) || 'Failed to update fallback order.');
      } catch (error) {
        alert('Unable to update fallback order right now.');
      }
    };
    input.addEventListener('change', submitFallback);
    input.addEventListener('blur', submitFallback);
  });

</script>

<!-- Edit Bill Modal -->
<div class="fin-modal" id="editBillModal">
  <div class="fin-modal-content" style="max-width:720px;">
    <div class="fin-modal-head">
      <h3>✏️ Edit Bill</h3>
      <button class="fin-modal-close" id="editBillClose">&times;</button>
    </div>
    <form class="fin-form" method="POST" id="editBillForm" action="#">
      <input type="hidden" id="ebl-id" name="_bill_id">
      <input type="hidden" id="ebl-status_action" name="status_action" value="">

      <div class="fin-row">
        <div class="fin-field"><label>Bill Title *</label><input id="ebl-title" name="title" required></div>
        <div class="fin-field"><label>Amount (<%= currentCurrency %>) *</label><input id="ebl-amount" name="amount" type="number" step="0.01" min="0" required></div>
      </div>

      <div class="fin-field"><label>Description</label><textarea id="ebl-description" name="description"></textarea></div>

      <div class="fin-row">
        <div class="fin-field">
          <label>Bill Type *</label>
          <select id="ebl-bill_type" name="bill_type">
            <option value="one_time">One-Time Payment</option>
            <option value="recurring">Recurring</option>
            <option value="installment">Installment Plan</option>
          </select>
        </div>
        <div class="fin-field">
          <label>Recurrence (if recurring)</label>
          <select id="ebl-recurrence" name="recurrence">
            <option value="">—</option>
            <option value="daily">Daily</option>
            <option value="weekly">Weekly</option>
            <option value="monthly">Monthly</option>
            <option value="term">Per Term</option>
            <option value="year">Per Year</option>
          </select>
        </div>
      </div>

      <div class="fin-row">
        <div class="fin-field"><label>Start / First Date</label><input id="ebl-due_date" name="due_date" type="date"></div>
        <div class="fin-field"><label>End Date</label><input id="ebl-recurrence_end_date" name="recurrence_end_date" type="date"></div>
      </div>

      <div class="fin-field">
        <label>Schedule Rules</label>
        <div class="fin-checks">
          <label class="fin-check"><input type="checkbox" id="ebl-exclude_non_school_days" name="exclude_non_school_days"> Do not include weekends and holidays</label>
        </div>
        <small style="color:var(--fin-muted);font-size:.74rem;">Uses the attendance calendar settings for the bill term when the schedule is recurring. If you extend the end date, the bill dates are recalculated after excluded days are removed.</small>
      </div>

      <div class="fin-row">
        <div class="fin-field">
          <label>Status</label>
          <select id="ebl-status" name="status">
            <option value="active">Active</option>
            <option value="draft">Draft</option>
            <option value="scheduled">Scheduled</option>
            <option value="cancelled">Cancelled</option>
          </select>
        </div>
      </div>

      <div class="fin-row">
        <div class="fin-field"><label>Late Fee Amount</label><input id="ebl-late_fee" name="late_fee_amount" type="number" step="0.01" min="0"></div>
        <div class="fin-field"><label>Late Fee After (days)</label><input id="ebl-late_days" name="late_fee_after_days" type="number" min="0"></div>
      </div>

      <div class="fin-row">
        <div class="fin-field">
          <label>School Year *</label>
          <select id="ebl-school_year_id" name="school_year_id" required>
            <option value="">— Select school year —</option>
            <% (refs.years || []).forEach(y => { %><option value="<%= y.school_year_id %>"><%= y.name %><%= y.current ? ' (current)' : '' %></option><% }) %>
          </select>
        </div>
        <div class="fin-field">
          <label>Term *</label>
          <select id="ebl-term_id" name="term_id" data-year-required-label="Select year first" required>
            <option value="">— Select term —</option>
            <% (refs.terms || []).forEach(t => { %><option value="<%= t.term_id %>" data-school-year-id="<%= t.school_year_id || '' %>" data-current="<%= t.current ? 'true' : 'false' %>" data-start-date="<%= t.start_date ? new Date(t.start_date).toISOString().slice(0,10) : '' %>" data-end-date="<%= t.end_date ? new Date(t.end_date).toISOString().slice(0,10) : '' %>"><%= t.name %><%= t.current ? ' (current)' : '' %></option><% }) %>
          </select>
        </div>
      </div>

      <div class="fin-field">
        <label>Applicable To</label>
        <select id="ebl-applies_to" name="applies_to">
          <option value="school">Entire School</option>
          <option value="classes">Specific Classes</option>
          <option value="students">Individual Students</option>
        </select>
        <small id="ebl-applies_to_summary" style="display:block;color:var(--fin-muted);font-size:.74rem;margin-top:6px;"></small>
      </div>

      <div class="fin-field" id="ebl-target-classes-wrap" style="display:none;">
        <label>Classes</label>
        <div style="display:flex;gap:10px;align-items:end;flex-wrap:wrap;margin-bottom:8px;">
          <div class="fin-field" style="flex:1;min-width:180px;margin:0;">
            <input type="text" id="ebl-target_class_search" placeholder="Filter classes...">
          </div>
          <button type="button" class="fin-btn ghost" id="ebl-target_class_select_all">Select visible</button>
          <button type="button" class="fin-btn ghost" id="ebl-target_class_clear">Clear</button>
        </div>
        <input type="hidden" name="target_class_ids" value="">
        <select id="ebl-target_class_ids" name="target_class_ids" class="fin-multi-select" multiple size="6">
          <% (refs.classes || []).forEach(function(c) { %>
            <option value="<%= c.class_id %>" data-school-year-ids="<%= (c.school_year_ids || []).join(',') %>" data-term-ids="<%= (c.term_ids || []).join(',') %>"><%= c.class_name %></option>
          <% }) %>
        </select>
        <small style="color:var(--fin-muted);font-size:.72rem;">Click classes to add or remove them.</small>
      </div>

      <div class="fin-field" id="ebl-target-students-wrap" style="display:none;">
        <label>Students</label>
        <div style="display:flex;gap:10px;align-items:end;flex-wrap:wrap;margin-bottom:8px;">
          <div class="fin-field" style="flex:1;min-width:180px;margin:0;">
            <input type="text" id="ebl-target_student_search" placeholder="Filter students...">
          </div>
          <button type="button" class="fin-btn ghost" id="ebl-target_student_select_all">Select visible</button>
          <button type="button" class="fin-btn ghost" id="ebl-target_student_clear">Clear</button>
        </div>
        <input type="hidden" name="target_student_ids" value="">
        <select id="ebl-target_student_ids" name="target_student_ids" class="fin-multi-select" multiple size="8">
          <% (refs.students || []).forEach(function(s) { %>
            <option value="<%= s.student_id %>" data-school-year-ids="<%= (s.school_year_ids || []).join(',') %>" data-term-ids="<%= (s.term_ids || []).join(',') %>"><%= s.first_name %> <%= s.last_name %><%= s.class_name ? (' · ' + s.class_name) : '' %></option>
          <% }) %>
        </select>
        <small style="color:var(--fin-muted);font-size:.72rem;">Click students to add or remove them.</small>
      </div>

      <div class="fin-field">
        <label>Collectors / Overseers</label>
        <select id="ebl-assignee" name="assignee_ids[]" class="fin-multi-select" multiple size="5" style="min-height:120px;">
          <% (refs.employees || []).forEach(function(e) { %>
            <option value="<%= e.user_id %>"><%= formatCollectorOptionLabel(e) %></option>
          <% }) %>
        </select>
        <small id="ebl-assignee_summary" style="display:block;color:var(--fin-muted);font-size:.72rem;margin-top:6px;">Leave empty if nobody should be assigned.</small>
      </div>

      <div class="fin-row">
        <div class="fin-field">
          <label>Collection Destination</label>
          <select id="ebl-payment_destination" name="payment_destination">
            <% if (collectionDestinationOptionsSafe.length) { %>
              <% collectionDestinationOptionsSafe.forEach(function(option) { %>
                <option value="<%= option.value %>" <%= String(defaultCollectionDestinationSafe || '') === String(option.value) ? 'selected' : '' %>><%= option.label %></option>
              <% }) %>
            <% } else { %>
              <option value="">No payout account configured</option>
            <% } %>
          </select>
          <small style="color:var(--fin-muted);font-size:.72rem;">Uses the primary payout account from Account Settings.</small>
        </div>

        <div class="fin-field">
          <label>Payment Methods Accepted</label>
          <div class="fin-checks">
            <label class="fin-check fin-check-all"><input type="checkbox" id="ebl-payAll"> <strong>All methods</strong></label>
            <label class="fin-check"><input type="checkbox" class="ebl-pay-method" id="ebl-accepts_card" name="accepts_card"> Card / Stripe</label>
            <label class="fin-check"><input type="checkbox" class="ebl-pay-method" id="ebl-accepts_cash" name="accepts_cash"> Cash</label>
            <label class="fin-check"><input type="checkbox" class="ebl-pay-method" id="ebl-accepts_transfer" name="accepts_transfer"> Bank / Mobile Money</label>
          </div>
        </div>
      </div>

      <div class="fin-field">
        <label>Notify Parents</label>
        <div class="fin-checks">
          <label class="fin-check"><input type="checkbox" id="ebl-notify_email" name="notify_email"> Email</label>
        </div>
      </div>

      <div style="display:flex;gap:10px;margin-top:6px;flex-wrap:wrap;">
        <button type="button" class="fin-btn primary" onclick="submitEditBillForm()">Save Changes</button>
        <button type="button" class="fin-btn" onclick="submitEditBillForm('draft')">Save as Draft</button>
        <button type="button" class="fin-btn" id="editBillClose2" onclick="document.getElementById('editBillModal').classList.remove('open')">Cancel</button>
      </div>
    </form>
  </div>
</div>

<!-- Student Detail Drawer -->
<div id="studentDrawer" style="position:fixed;inset:0;z-index:9998;display:none;align-items:stretch;">
  <div style="flex:1;background:rgba(5,8,18,.7);backdrop-filter:blur(6px);" id="studentDrawerOverlay"></div>
  <div id="studentDrawerPanel" style="width:min(720px,100%);background:var(--fin-card);border-left:1px solid var(--fin-border);overflow-y:auto;padding:28px;box-shadow:-30px 0 60px -20px #000;">
    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:20px;">
      <div style="font-family:'Space Grotesk',sans-serif;font-size:1.1rem;font-weight:700;color:var(--fin-teal);">Student Billing Detail</div>
      <button id="studentDrawerClose" style="background:transparent;border:0;color:var(--fin-muted);font-size:1.6rem;cursor:pointer;line-height:1;">&times;</button>
    </div>
    <div id="studentDrawerBody"></div>
  </div>
</div> 

<script>
  (function() {
    function splitPatchIds(value) {
      return String(value || '')
        .split(',')
        .map(function(item) { return String(item || '').trim(); })
        .filter(Boolean);
    }

    function matchesPatchIds(value, wantedIds) {
      var available = splitPatchIds(value);
      var wanted = Array.isArray(wantedIds)
        ? wantedIds.map(function(item) { return String(item || '').trim(); }).filter(Boolean)
        : [];
      if (!wanted.length) return true;
      return wanted.some(function(id) {
        return available.indexOf(id) !== -1;
      });
    }

    function setPatchMultiSelectValues(selectId, values) {
      var select = document.getElementById(selectId);
      if (!select) return;
      var wanted = Array.isArray(values)
        ? values.map(function(value) { return String(value || '').trim(); }).filter(Boolean)
        : [];
      Array.prototype.forEach.call(select.options, function(option) {
        option.selected = wanted.indexOf(String(option.value || '')) !== -1;
      });
    }

    function syncEditBillPaymentMethodMasterPatch() {
      var master = document.getElementById('ebl-payAll');
      var inputs = Array.prototype.slice.call(document.querySelectorAll('.ebl-pay-method')).filter(function(input) {
        return !input.disabled;
      });
      if (!master) return;
      if (!inputs.length) {
        master.checked = false;
        master.indeterminate = false;
        return;
      }
      var checkedCount = inputs.filter(function(input) { return input.checked; }).length;
      master.checked = checkedCount === inputs.length;
      master.indeterminate = checkedCount > 0 && checkedCount < inputs.length;
    }

    function syncAudiencePicker() {
      var appliesTo = String((document.getElementById('ebl-applies_to') || {}).value || 'school');
      var selectedYear = String((document.getElementById('ebl-school_year_id') || {}).value || '');
      var selectedTerm = String((document.getElementById('ebl-term_id') || {}).value || '');
      var classWrap = document.getElementById('ebl-target-classes-wrap');
      var studentWrap = document.getElementById('ebl-target-students-wrap');
      var classSelect = document.getElementById('ebl-target_class_ids');
      var studentSelect = document.getElementById('ebl-target_student_ids');
      var classSearch = document.getElementById('ebl-target_class_search');
      var studentSearch = document.getElementById('ebl-target_student_search');
      var summary = document.getElementById('ebl-applies_to_summary');

      if (classWrap) classWrap.style.display = appliesTo === 'classes' ? '' : 'none';
      if (studentWrap) studentWrap.style.display = appliesTo === 'students' ? '' : 'none';

      [classSelect, studentSelect].forEach(function(select) {
        if (!select) return;
        Array.prototype.forEach.call(select.options, function(option) {
          var matches = true;
          if (selectedTerm) matches = matchesPatchIds(option.getAttribute('data-term-ids'), [selectedTerm]);
          else if (selectedYear) matches = matchesPatchIds(option.getAttribute('data-school-year-ids'), [selectedYear]);
          option.disabled = !matches;
          option.setAttribute('data-academic-match', matches ? 'true' : 'false');
          if (!matches) option.selected = false;
        });
      });

      window.filterEditBillTargetOptions('ebl-target_class_ids', classSearch ? classSearch.value : '');
      window.filterEditBillTargetOptions('ebl-target_student_ids', studentSearch ? studentSearch.value : '');

      if (!summary) return;
      if (appliesTo === 'classes') {
        var classCount = classSelect ? Array.prototype.filter.call(classSelect.options, function(option) {
          return option.selected && !option.disabled;
        }).length : 0;
        summary.textContent = classCount
          ? ('Currently set to ' + classCount + ' class' + (classCount === 1 ? '' : 'es') + ' in this academic context.')
          : 'Choose one or more classes for this bill.';
        return;
      }
      if (appliesTo === 'students') {
        var studentCount = studentSelect ? Array.prototype.filter.call(studentSelect.options, function(option) {
          return option.selected && !option.disabled;
        }).length : 0;
        summary.textContent = studentCount
          ? ('Currently set to ' + studentCount + ' individual student' + (studentCount === 1 ? '' : 's') + ' in this academic context.')
          : 'Choose one or more students for this bill.';
        return;
      }
      summary.textContent = 'This bill will apply to the entire school for the selected year and term.';
    }

    window.filterEditBillTargetOptions = function(selectId, query) {
      var select = document.getElementById(selectId);
      if (!select) return;
      var normalizedQuery = String(query || '').trim().toLowerCase();
      Array.prototype.forEach.call(select.options, function(option) {
        var academicMatch = option.getAttribute('data-academic-match') !== 'false';
        var matchesQuery = !normalizedQuery || String(option.textContent || '').toLowerCase().indexOf(normalizedQuery) !== -1;
        option.hidden = !academicMatch || !matchesQuery;
      });
    };

    window.setAllEditBillTargets = function(selectId, shouldSelect) {
      var select = document.getElementById(selectId);
      if (!select) return;
      Array.prototype.forEach.call(select.options, function(option) {
        if (option.disabled || option.hidden) return;
        option.selected = !!shouldSelect;
      });
      syncAudiencePicker();
    };

    window.syncEditBillTargets = syncAudiencePicker;

    function enablePatchToggleMultiSelect(selectId, onChange) {
      var select = document.getElementById(selectId);
      if (!select || select.dataset.patchToggleMultiReady === 'true') return;
      select.dataset.patchToggleMultiReady = 'true';
      select.addEventListener('mousedown', function(event) {
        var option = event.target;
        if (!option || option.tagName !== 'OPTION' || option.disabled) return;
        event.preventDefault();
        var scrollTop = select.scrollTop;
        option.selected = !option.selected;
        if (typeof onChange === 'function') onChange();
        window.requestAnimationFrame(function() {
          select.focus();
          select.scrollTop = scrollTop;
        });
      });
    }

    function closeEditBillModal() {
      var modal = document.getElementById('editBillModal');
      if (modal) modal.classList.remove('open');
    }

    function syncCreateAudiencePicker() {
      var select = document.getElementById('appliesTo');
      var classPicker = document.getElementById('classPicker');
      var studentPicker = document.getElementById('studentPicker');
      if (!select) return;
      var appliesTo = String(select.value || 'school');
      if (classPicker) classPicker.style.display = appliesTo === 'classes' ? '' : 'none';
      if (studentPicker) studentPicker.style.display = appliesTo === 'students' ? '' : 'none';
      if (typeof window.syncBillTargetClasses === 'function') window.syncBillTargetClasses();
      if (typeof window.syncBillTargetStudents === 'function') window.syncBillTargetStudents();
    }

    function bindEditBillListeners() {
      var editBillYearSelect = document.getElementById('ebl-school_year_id');
      var editBillTermSelect = document.getElementById('ebl-term_id');
      var editBillAudienceSelect = document.getElementById('ebl-applies_to');
      var editBillPayAll = document.getElementById('ebl-payAll');

      if (editBillAudienceSelect && editBillAudienceSelect.dataset.patchAudienceReady !== 'true') {
        editBillAudienceSelect.dataset.patchAudienceReady = 'true';
        editBillAudienceSelect.addEventListener('change', syncAudiencePicker);
      }

      if (editBillYearSelect && editBillYearSelect.dataset.patchAcademicReady !== 'true') {
        editBillYearSelect.dataset.patchAcademicReady = 'true';
        editBillYearSelect.addEventListener('change', function() {
          syncAudiencePicker();
        });
      }

      if (editBillTermSelect && editBillTermSelect.dataset.patchAcademicReady !== 'true') {
        editBillTermSelect.dataset.patchAcademicReady = 'true';
        editBillTermSelect.addEventListener('change', function() {
          syncAudiencePicker();
        });
      }

      ['ebl-target_class_ids', 'ebl-target_student_ids'].forEach(function(selectId) {
        var select = document.getElementById(selectId);
        if (!select || select.dataset.patchChangeReady === 'true') return;
        select.dataset.patchChangeReady = 'true';
        select.addEventListener('change', syncAudiencePicker);
      });

      [['ebl-target_class_search', 'ebl-target_class_ids'], ['ebl-target_student_search', 'ebl-target_student_ids']].forEach(function(pair) {
        var input = document.getElementById(pair[0]);
        if (!input || input.dataset.patchFilterReady === 'true') return;
        input.dataset.patchFilterReady = 'true';
        input.addEventListener('input', function() {
          window.filterEditBillTargetOptions(pair[1], input.value || '');
        });
      });

      [['ebl-target_class_select_all', 'ebl-target_class_ids', true], ['ebl-target_class_clear', 'ebl-target_class_ids', false], ['ebl-target_student_select_all', 'ebl-target_student_ids', true], ['ebl-target_student_clear', 'ebl-target_student_ids', false]].forEach(function(config) {
        var button = document.getElementById(config[0]);
        if (!button || button.dataset.patchActionReady === 'true') return;
        button.dataset.patchActionReady = 'true';
        button.addEventListener('click', function() {
          window.setAllEditBillTargets(config[1], config[2]);
        });
      });

      enablePatchToggleMultiSelect('ebl-target_class_ids', syncAudiencePicker);
      enablePatchToggleMultiSelect('ebl-target_student_ids', syncAudiencePicker);

      if (editBillPayAll && editBillPayAll.dataset.patchPayAllReady !== 'true') {
        editBillPayAll.dataset.patchPayAllReady = 'true';
        editBillPayAll.addEventListener('change', function() {
          document.querySelectorAll('.ebl-pay-method').forEach(function(input) {
            if (input.disabled) return;
            input.checked = !!editBillPayAll.checked;
          });
          syncEditBillPaymentMethodMasterPatch();
        });
      }

      document.querySelectorAll('.ebl-pay-method').forEach(function(input) {
        if (input.dataset.patchPayMethodReady === 'true') return;
        input.dataset.patchPayMethodReady = 'true';
        input.addEventListener('change', syncEditBillPaymentMethodMasterPatch);
      });

      ['editBillClose', 'editBillClose2'].forEach(function(id) {
        var button = document.getElementById(id);
        if (!button || button.dataset.patchCloseReady === 'true') return;
        button.dataset.patchCloseReady = 'true';
        button.addEventListener('click', function(event) {
          event.preventDefault();
          closeEditBillModal();
        });
      });

      var modal = document.getElementById('editBillModal');
      if (modal && modal.dataset.patchOverlayReady !== 'true') {
        modal.dataset.patchOverlayReady = 'true';
        modal.addEventListener('click', function(event) {
          if (event.target === modal) closeEditBillModal();
        });
      }

      syncEditBillPaymentMethodMasterPatch();
      syncAudiencePicker();
    }

    function bindCreateAudienceListeners() {
      var createAudienceSelect = document.getElementById('appliesTo');
      var createYearSelect = document.getElementById('billCreateYearSelect');
      var createTermSelect = document.getElementById('billCreateTermSelect');
      if (createAudienceSelect && createAudienceSelect.dataset.patchAudienceReady !== 'true') {
        createAudienceSelect.dataset.patchAudienceReady = 'true';
        createAudienceSelect.addEventListener('change', syncCreateAudiencePicker);
      }
      if (createYearSelect && createYearSelect.dataset.patchAcademicReady !== 'true') {
        createYearSelect.dataset.patchAcademicReady = 'true';
        createYearSelect.addEventListener('change', syncCreateAudiencePicker);
      }
      if (createTermSelect && createTermSelect.dataset.patchAcademicReady !== 'true') {
        createTermSelect.dataset.patchAcademicReady = 'true';
        createTermSelect.addEventListener('change', syncCreateAudiencePicker);
      }

      ['classChips', 'studentChips'].forEach(function(gridId) {
        var grid = document.getElementById(gridId);
        if (!grid || grid.dataset.patchSelectionReady === 'true') return;
        grid.dataset.patchSelectionReady = 'true';
        grid.addEventListener('change', syncCreateAudiencePicker);
      });

      syncCreateAudiencePicker();
    }

    if (typeof window.openEditBill === 'function' && window.openEditBill.__patchWrapped !== true) {
      var originalOpenEditBill = window.openEditBill;
      var wrappedOpenEditBill = function(bill) {
        originalOpenEditBill.call(this, bill);
        syncAudiencePicker();
        syncEditBillPaymentMethodMasterPatch();
      };
      wrappedOpenEditBill.__patchWrapped = true;
      window.openEditBill = wrappedOpenEditBill;
    }

    bindEditBillListeners();
    bindCreateAudienceListeners();

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', function() {
        bindEditBillListeners();
        bindCreateAudienceListeners();
      }, { once: true });
    }

    window.setPatchMultiSelectValues = setPatchMultiSelectValues;
  })();
</script>
