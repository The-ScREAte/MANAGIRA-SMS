    window.openStudentDrawer = function (studentId) {
      var drawer = document.getElementById('studentDrawer');
      var body   = document.getElementById('studentDrawerBody');
      if (!drawer || !body) return;
      body.innerHTML = '<div style="text-align:center;padding:60px 20px;color:var(--fin-muted);">Loading…</div>';
      drawer.classList.add('open');
      fetch('/account/settings/finance/students/' + studentId + '/detail.json')
        .then(r => r.ok ? r.json() : Promise.reject(r))
        .then(data => { body.innerHTML = buildDrawerHtml(data); })
        .catch(() => { body.innerHTML = '<div style="color:var(--fin-red);padding:20px;">Could not load student detail.</div>'; });
    };

    function fmt(n) {
      try {
        return new Intl.NumberFormat(financeCurrencyLocale, {
          style: 'currency',
          currency: financeCurrencyCode,
          minimumFractionDigits: 2,
          maximumFractionDigits: 2
        }).format(Number(n || 0));
      } catch (_) {
        return financeCurrencyCode + ' ' + Number(n || 0).toFixed(2);
      }
    }

    function buildDrawerHtml(d) {
      var s = d.student;
      var bills = d.bills || [];
      var payments = d.payments || [];
      var credit = d.credit || 0;
      var totalBilled  = bills.reduce((a,b) => a + Number(b.amount||0), 0);
      var totalPaid    = bills.reduce((a,b) => a + Number(b.amount_paid||0), 0);
      var outstanding  = bills.reduce((a,b) => a + Math.max(Number(b.amount||0) + Number(b.late_fee_applied||0) - Number(b.amount_paid||0), 0), 0);
      var initials     = ((s.first_name||'?')[0] + (s.last_name||'')[0]).toUpperCase();
      var avatarHtml = '<img src="' + (s.image_url || profilePlaceholderSrc) + '" style="width:100%;height:100%;object-fit:cover;border-radius:50%;" onerror="this.onerror=null;this.src=\'' + profilePlaceholderSrc + '\';">';

      var billRows = bills.map(function(b) {
        var bal = Math.max(Number(b.amount||0) + Number(b.late_fee_applied||0) - Number(b.amount_paid||0), 0);
        var due = b.due_date ? new Date(b.due_date).toLocaleDateString() : '—';
        return '<tr><td>' + (b.title||'') + '</td><td class="fin-date-muted">' + due + '</td>'
          + '<td class="num fin-money-neutral">' + fmt(b.amount) + '</td>'
          + '<td class="num fin-money-positive">' + fmt(b.amount_paid) + '</td>'
          + '<td class="num ' + (bal>0?'fin-money-negative':'fin-money-neutral') + '">' + fmt(bal) + '</td>'
          + '<td><span class="badge ' + b.status + '">' + b.status + '</span></td></tr>';
      }).join('') || '<tr><td colspan="6" style="text-align:center;color:var(--fin-muted);padding:20px;">No bills assigned.</td></tr>';

      var payRows = payments.map(function(p) {
        return '<tr><td class="fin-date-muted">' + new Date(p.received_at).toLocaleString() + '</td>'
          + '<td>' + (p.bill_title||'—') + '</td>'
          + '<td><span class="fin-method-pill ' + String(p.method||'').toLowerCase() + '">' + (p.method||'') + '</span></td>'
          + '<td class="num fin-money-positive">' + fmt(p.amount) + '</td>'
          + '<td style="color:var(--fin-muted);font-size:.78rem;">' + (p.reference||'') + '</td></tr>';
      }).join('') || '<tr><td colspan="5" style="text-align:center;color:var(--fin-muted);padding:20px;">No payments recorded.</td></tr>';

      return '<div style="display:flex;align-items:center;gap:14px;margin-bottom:22px;">'
        + '<div class="avatar" style="width:54px;height:54px;font-size:1.1rem;">' + avatarHtml + '</div>'
        + '<div><div style="font-family:\'Space Grotesk\',sans-serif;font-size:1.3rem;font-weight:700;">' + s.first_name + ' ' + s.last_name + '</div>'
        + '<div style="color:var(--fin-muted);font-size:.88rem;">' + (s.class_name||'No class') + '</div></div></div>'
        + '<div class="fin-stats" style="margin-bottom:20px;">'
        + '<div class="stat"><div class="label">Total Billed</div><div class="value fin-mono">' + fmt(totalBilled) + '</div></div>'
        + '<div class="stat green"><div class="label">Total Paid</div><div class="value fin-mono">' + fmt(totalPaid) + '</div></div>'
        + '<div class="stat red"><div class="label">Outstanding</div><div class="value fin-mono">' + fmt(outstanding) + '</div></div>'
        + '<div class="stat gold"><div class="label">Credits</div><div class="value fin-mono">' + fmt(credit) + '</div></div>'
        + '</div>'
        + '<div style="font-family:\'Space Grotesk\',sans-serif;font-weight:700;font-size:1rem;margin-bottom:10px;">Bills</div>'
        + '<div class="fin-table-wrap" style="margin-bottom:22px;"><table class="fin-table"><thead><tr><th>Bill</th><th>Due</th><th class="num">Amount</th><th class="num">Paid</th><th class="num">Balance</th><th>Status</th></tr></thead><tbody>' + billRows + '</tbody></table></div>'
        + '<div style="font-family:\'Space Grotesk\',sans-serif;font-weight:700;font-size:1rem;margin-bottom:10px;">Payment History</div>'
        + '<div class="fin-table-wrap"><table class="fin-table"><thead><tr><th>Date</th><th>Bill</th><th>Method</th><th class="num">Amount</th><th>Ref</th></tr></thead><tbody>' + payRows + '</tbody></table></div>';
    }

    var drawerClose = document.getElementById('studentDrawerClose');
    if (drawerClose) drawerClose.addEventListener('click', function () {
      document.getElementById('studentDrawer').classList.remove('open');
    });
    var drawer = document.getElementById('studentDrawer');
    if (drawer) drawer.addEventListener('click', function (e) {
      if (e.target === drawer) drawer.classList.remove('open');
    });
  })();

