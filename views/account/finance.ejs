  }

  /* Filter action row button alignment */
  .arrears-filter-actions .fin-btn {
    min-height: 46px;
    padding: 0 18px;
    font-size: .86rem;
  }

  /* Section header action buttons compact */
  .section-head .fin-btn,
  .arrears-toolbar .fin-btn:not(.sm) {
    min-height: 34px;
    height: 34px;
    padding: 0 12px;
    font-size: .78rem;
  }

  /* ============================================================
     PayGira - Button alignment fix
     ============================================================ */

  /* Core fix: all inputs and selects get a fixed height */
  .fin-field input:not([type=checkbox]):not([type=radio]),
  .fin-field select {
    height: 42px;
    min-height: 42px;
    max-height: 42px;
    box-sizing: border-box;
    padding: 0 13px;
  }
  .fin-field select {
    padding-right: 32px;
  }

  /* All action buttons next to dropdowns match that height */
  .fin-btn {
    height: 42px;
    min-height: 42px;
    max-height: 42px;
    box-sizing: border-box;
    padding: 0 16px;
    width: auto !important;
    flex-shrink: 0;
    align-self: flex-end;
  }

  /* .sm and .tiny keep their own proportional heights */
  .fin-btn.sm {
    height: 34px;
    min-height: 34px;
    max-height: 34px;
    padding: 0 12px;
  }
  .fin-btn.tiny {
    height: 30px;
    min-height: 30px;
    max-height: 30px;
    padding: 0 9px;
  }

  /* Fix 1: Overview Analytics filter row */
  .fin-report-filters {
    align-items: flex-end;
    padding: 12px 14px;
  }
  .fin-report-filters .fin-field {
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
  }
  .fin-report-filters .fin-btn {
    height: 42px;
    min-height: 42px;
    align-self: flex-end;
    flex-shrink: 0;
    width: auto !important;
  }
  .fin-report-filters .fin-field select {
    height: 42px;
    min-height: 42px;
  }

  /* Fix 2: Overview year/term filter row icon buttons */
  .fin-report-filters a.fin-btn.fin-filter-icon,
  .fin-report-filters .fin-filter-icon.fin-btn {
    height: 42px;
    min-height: 42px;
    width: 42px !important;
    padding: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    align-self: flex-end;
    flex-shrink: 0;
  }

  /* Fix 4 bottom: Org-Wide Bills filter row reset button */
  .fin-report-filters.fin-student-filter-grid {
    align-items: flex-end;
  }
  .fin-report-filters.fin-student-filter-grid .fin-field.fin-filter-action {
    align-items: flex-end;
    justify-content: flex-end;
    height: 42px;
  }
  .fin-report-filters.fin-student-filter-grid .fin-btn {
    height: 42px;
    min-height: 42px;
    width: auto !important;
    padding: 0 16px;
  }
  .fin-report-filters.fin-student-filter-grid .fin-field select,
  .fin-report-filters.fin-student-filter-grid .fin-field input {
    height: 42px;
    min-height: 42px;
  }

  /* Icon action buttons in table rows - keep neutral and small */
  .fin-icon-btn {
    width: 32px !important;
    height: 32px !important;
    min-height: 32px;
    max-height: 32px;
    border-radius: 4px;
    background: rgba(15,23,42,.05);
    border: 1px solid rgba(15,23,42,.09);
    color: #6b7280 !important;
    box-shadow: none;
  }
  .fin-icon-btn:hover {
    transform: none;
    box-shadow: none;}
  .fin-icon-btn.danger {
    background: rgba(220,38,38,.1);
    border-color: rgba(220,38,38,.28) !important;
    color: #dc2626 !important;
  }
  
  .fin-icon-btn svg { width: 14px; height: 14px; }
  .fin-btn.danger::before { content:''; display:none; }

  /* End alignment fix */
</style>

<script>
