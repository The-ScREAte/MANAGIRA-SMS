            if (tr.id && tr.id.indexOf('arrears-detail-') === 0) {
              if (items.length) items[items.length - 1].extras.push(tr);
            } else {
              items.push({ main: tr, extras: [] });
            }
          });
          return items;
        }
      });
    }
  })();

