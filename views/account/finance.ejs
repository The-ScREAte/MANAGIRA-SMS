  /* ── Subscription card ────────────────────────────────────────── */
  .sub-card { padding:18px; background:linear-gradient(135deg,rgba(255,255,255,0.9),var(--fin-card-2)); border:1px solid var(--fin-border); border-radius:14px; transition:border-color .2s,box-shadow .2s; }
  .sub-card:hover { box-shadow:0 8px 24px -12px rgba(15,23,42,0.14);}

  /* ── Responsive column helpers ────────────────────────────────── */
  /* fin-col-lg: hidden ≤960px  |  fin-col-md: hidden ≤600px */

  /* ── Tablet ≤960px ────────────────────────────────────────────── */
  @media (max-width:960px) {
    .fin-shell   { padding:16px 14px 80px; position:relative; }
    .fin-grid    { grid-template-columns:1fr; gap:14px; }
    /* Nav floats over content — anchored BELOW the mobile header */
    .fin-side    {
      position:absolute; top:58px; left:0; right:0; max-height:none;
      z-index:200;
      border-radius:0 0 18px 18px;
      min-width:0; overflow:hidden;
