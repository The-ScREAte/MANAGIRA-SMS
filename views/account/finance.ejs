            payments: '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 12h4l3 8 4-16 3 8h4"/></svg>',
            payouts: '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3v12M7 10l5 5 5-5M5 21h14"/></svg>',
            settings: '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.7 1.7 0 00.3 1.8l.1.1a2 2 0 11-2.8 2.8l-.1-.1a1.7 1.7 0 00-1.8-.3 1.7 1.7 0 00-1 1.5V21a2 2 0 11-4 0v-.1a1.7 1.7 0 00-1.1-1.5 1.7 1.7 0 00-1.8.3l-.1.1a2 2 0 11-2.8-2.8l.1-.1a1.7 1.7 0 00.3-1.8 1.7 1.7 0 00-1.5-1H3a2 2 0 110-4h.1a1.7 1.7 0 001.5-1.1 1.7 1.7 0 00-.3-1.8l-.1-.1a2 2 0 112.8-2.8l.1.1a1.7 1.7 0 001.8.3H9a1.7 1.7 0 001-1.5V3a2 2 0 114 0v.1a1.7 1.7 0 001 1.5 1.7 1.7 0 001.8-.3l.1-.1a2 2 0 112.8 2.8l-.1.1a1.7 1.7 0 00-.3 1.8V9a1.7 1.7 0 001.5 1H21a2 2 0 110 4h-.1a1.7 1.7 0 00-1.5 1z"/></svg>',
          };
          const _finPlace = paygiraAccess.placeOf(sec) || 'overview';
        %>
        <% paygiraAccess.menu.forEach((place) => { %>
          <a href="<%= place.url %>" class="<%= place.id === _finPlace ? 'active' : '' %>"><span class="ico"><%- _finIcons[place.id] || '' %></span><span><%= place.label %></span></a>
        <% }) %>
      </nav>
    </aside>

    <div class="fin-main">
      <div class="fin-page-head" style="display:flex;justify-content:space-between;align-items:center;gap:16px;position:relative;flex-wrap:wrap;">
        <%
          // The title is the place's name; a place with two pages shows them as tabs under it.
          const _finHere = paygiraAccess.menu.find((place) => place.id === (paygiraAccess.placeOf(sec) || 'overview')) || { label: 'PayGira', tabs: [] };
        %>
        <div class="fin-page-head-main-title">
          <h1><%= _finHere.label %></h1>
          <% if (_finHere.tabs.length > 1) { %>
            <nav class="fin-tabs" aria-label="<%= _finHere.label %>">
              <% _finHere.tabs.forEach((tab) => { %><a href="<%= tab.url %>" class="fin-tab<%= tab.id === sec ? ' is-on' : '' %>"<%- tab.id === sec ? ' aria-current="page"' : '' %>><%= tab.label %></a><% }) %>
            </nav>
          <% } %>
        </div>
        <div class="fin-head-tools">
        <% if (sec === 'overview') { %>
          <details class="fin-filter-fold" data-fin-filter>
            <summary title="Choose the period"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 5h18l-7 8v5l-4 2v-7z"/></svg><span>Filter</span><span class="fin-filter-summary"><%= finPeriodLabel(ovYearSel, ovTermSel, ovAllYears) %></span></summary>
            <form method="GET" action="/account/settings/finance" class="fin-filter-pop" aria-label="Filter the overview">
              <input type="hidden" name="section" value="overview">
              <p class="fin-filter-title">Period</p>
              <div class="fin-field">
                <label for="finOverviewYear">Year</label>
                <select name="year" id="finOverviewYear">
                  <option value="all" <%= ovAllYears ? 'selected' : '' %>>All years</option>
                  <% _finYears.forEach((y) => { %><option value="<%= y.school_year_id %>" <%= String(ovYearSel) === String(y.school_year_id) ? 'selected' : '' %>><%= y.name %><%= y.current ? ' (current)' : '' %></option><% }) %>
                </select>
              </div>
              <div class="fin-field">
                <label for="finOverviewTerm">Term</label>
                <select name="term" id="finOverviewTerm" data-year-required-label="Select a year first">
                  <option value="">All terms</option>
                  <% _finTerms.forEach((tm) => { %><option value="<%= tm.term_id %>" data-school-year-id="<%= tm.school_year_id || '' %>" data-current="<%= tm.current ? 'true' : 'false' %>" <%= String(ovTermSel) === String(tm.term_id) ? 'selected' : '' %>><%= tm.name %><%= tm.current ? ' (current)' : '' %></option><% }) %>
                </select>
              </div>
              <% if (_finQuery.year || _finQuery.term) { %><a class="fin-filter-current" href="/account/settings/finance?section=overview">Back to the current term</a><% } %>
              <noscript><button type="submit" class="fin-btn sm">Show</button></noscript>
            </form>
          </details>
        <% } %>
        <span class="paygira-secure-badge" title="PayGira Secure — bank-grade encryption">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4z" fill="currentColor"/>
            <path d="M9 12l2 2 4-4" stroke="#f6f7f9" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
          <span class="paygira-secure-text">Secure</span>
        </span>
        <%# This page's own action: a small button that opens its form from the right. %>
        <% if (sec === 'bills') { %><button type="button" class="fin-btn sm fin-head-action" onclick="finToggleAcc('acc-create-bill')">+ New bill</button><% } %>
        <% if (sec === 'payments' && paygiraAccess.canRecordPayments) { %><button type="button" class="fin-btn sm fin-head-action" onclick="finToggleAcc('acc-record-payment')">+ Record a payment</button><% } %>
        <% if (sec === 'payouts') { %><button type="button" class="fin-btn sm fin-head-action" onclick="finToggleAcc('acc-create-payout')">+ New payout</button><% } %>
        </div>
      </div>

      <% if (messages && messages.success && messages.success.length) { %>
        <div class="fin-flash success"><%= messages.success[0] %></div>
      <% } %>
      <% if (messages && messages.error && messages.error.length) { %>
        <div class="fin-flash error"><%= messages.error[0] %></div>
      <% } %>

      <% if (sec === 'overview') { %>
        <div id="finOverviewSectionMount" data-src="/account/settings/finance/_overview-section" aria-busy="true">
          <div class="fin-card" style="margin-bottom:20px;">
            <div class="activity-empty">Loading overview...</div>
          </div>
        </div>
        <noscript>
          <%- include('financeOverviewSection', { refs: refs, selectedYear: (overview && overview.filters && overview.filters.school_year_id) || '', selectedTerm: (overview && overview.filters && overview.filters.term_id) || '' }) %>
          <%- include('financeOverviewDetailSection', { overview: overview, bills: bills, refs: refs, formatMoney: formatMoney, financeCurrency: financeCurrency }) %>
        </noscript>
      <% } %>

      <% if (sec === 'bills') { %>
        <% const billPage = (billPagination && billPagination.page) || 1; %>
        <% const billPageSize = (billPagination && billPagination.pageSize) || bills.length || 20; %>
        <div class="fin-card fin-accordion fin-sheet" id="acc-create-bill" role="dialog" aria-modal="true" aria-labelledby="acc-create-bill-title" aria-hidden="true">
          <div class="fin-sheet__head">
            <div>
              <h2 class="fin-sheet__title" id="acc-create-bill-title">New bill</h2>
              <p class="fin-sheet__hint">Charge every student, some classes or chosen students. Each parent gets an invoice.</p>
            </div>
            <button type="button" class="fin-sheet__close" aria-label="Close" onclick="finToggleAcc('acc-create-bill')">&times;</button>
          </div>
          <div class="fin-acc-body">
          <%
            // [id, name, class id, class name, school years, terms, photo]
            const _finStudentRows = (refs.students || []).map((s) => [
              s.student_id,
              s.display_name || (typeof formatDisplayName === 'function' ? formatDisplayName(s) : [s.first_name, s.last_name].filter(Boolean).join(' ').trim()),
              s.class_id || 0,
              s.class_name || '',
              (s.school_year_ids || []).join(','),
              (s.term_ids || []).join(','),
              (s.image_url && String(s.image_url).trim() && String(s.image_url).trim() !== 'profilePlaceholder.png') ? resolveAvatar(s.image_url) : '',
            ]);
          %>
          <script>
            // Students for the "Chosen students" pickers (this form and the edit window), drawn on first use.
            (function () {
              var rows = <%- JSON.stringify(_finStudentRows) %>;
              var placeholder = <%- JSON.stringify(profilePlaceholder) %>;
              var chipsDone = false, optionsDone = false;
              window.finBuildStudentChips = function () {
                var grid = document.getElementById('studentChips');
                if (chipsDone || !grid || !rows.length) return;
                chipsDone = true;
                var parts = document.createDocumentFragment();
                rows.forEach(function (row) {
                  var chip = document.createElement('label');
                  chip.className = 'fin-chip student';
                  chip.setAttribute('data-student-id', row[0]);
                  chip.setAttribute('data-class-id', row[2] || '');
                  chip.setAttribute('data-school-year-ids', row[4]);
                  chip.setAttribute('data-term-ids', row[5]);
                  chip.setAttribute('data-search', (row[1] + ' ' + row[3]).toLowerCase());
                  var box = document.createElement('input');
                  box.type = 'checkbox'; box.name = 'target_student_ids'; box.value = row[0];
                  box.addEventListener('change', function () { finChipChanged(box, 'studentCount'); });
                  var avatar = document.createElement('span'); avatar.className = 'fin-chip-avatar';
                  var img = document.createElement('img');
                  img.loading = 'lazy'; img.decoding = 'async'; img.alt = row[1]; img.src = row[6] || placeholder;
                  img.onerror = function () { img.onerror = null; img.src = placeholder; };
                  avatar.appendChild(img);
                  var text = document.createElement('span'); text.className = 'fin-chip-text';
                  var name = document.createElement('strong'); name.textContent = row[1];
                  var klass = document.createElement('small'); klass.textContent = row[3] || '—';
                  text.appendChild(name); text.appendChild(klass);
                  chip.appendChild(box); chip.appendChild(avatar); chip.appendChild(text);
                  parts.appendChild(chip);
                });
                grid.appendChild(parts);
                if (typeof window.syncBillTargetStudents === 'function') window.syncBillTargetStudents();
              };
              window.finBuildStudentOptions = function () {
                var select = document.getElementById('ebl-target_student_ids');
                if (optionsDone || !select) return;
                optionsDone = true;
                var parts = document.createDocumentFragment();
                rows.forEach(function (row) {
                  var option = document.createElement('option');
                  option.value = row[0];
                  option.setAttribute('data-school-year-ids', row[4]);
                  option.setAttribute('data-term-ids', row[5]);
                  option.textContent = row[1] + (row[3] ? ' · ' + row[3] : '');
                  parts.appendChild(option);
                });
                select.appendChild(parts);
              };
            })();
          </script>
          <% if (openCreateBillForm && messages && messages.error && messages.error.length) { %>
            <div class="fin-flash error"><%= messages.error[0] %></div>
          <% } %>
          <form class="fin-form" method="POST" action="/account/settings/finance/bills">
            <%# What it is, how much, who pays and when: enough for most bills. %>
            <div class="fin-row">
              <div class="fin-field">
                <label>What is it for? *</label>
                <input name="title" required placeholder="e.g. Tuition, fall semester">
              </div>
              <div class="fin-field">
                <label>Amount for each student (<%= currentCurrency %>) *</label>
                <input name="amount" type="number" step="0.01" min="0" required placeholder="500.00">
                <% if (currentCurrency !== 'USD' && fmtUsdEquivalent(500)) { %>
                  <small style="color:var(--fin-muted);font-size:.72rem;">≈ USD shown for reference.</small>
                <% } %>
              </div>
            </div>
            <div class="fin-row">
              <div class="fin-field">
                <label>Who pays? *</label>
                <select name="applies_to" id="appliesTo">
                  <option value="school">Every student</option>
                  <option value="classes">Some classes</option>
                  <option value="students">Chosen students</option>
                </select>
              </div>
              <div class="fin-field">
                <label>Due date *</label>
                <input name="due_date" id="billCreateStartDate" type="date" required>
                <small style="color:var(--fin-muted);font-size:.72rem;">For a repeating bill, the first date.</small>
              </div>
            </div>

            <!-- Classes — clickable multi-select chips -->
            <div class="fin-field" id="classPicker" style="display:none;">
              <label>
                Classes <span style="color:var(--fin-muted);font-weight:500;font-size:.78rem;">(click to select — pick as many as you need)</span>
              </label>
              <div class="fin-picker-actions">
                <button type="button" class="fin-btn sm" onclick="finSelectAllChips('classChips', true, true)">Select visible</button>
                <button type="button" class="fin-btn sm" onclick="finSelectAllChips('classChips', false)">Clear</button>
                <span class="fin-picker-count" id="classCount">0 selected</span>
              </div>
              <div class="fin-chip-grid" id="classChips">
                <% refs.classes.forEach(c => { %>
                  <label class="fin-chip" data-class-id="<%= c.class_id %>" data-school-year-ids="<%= (c.school_year_ids || []).join(',') %>" data-term-ids="<%= (c.term_ids || []).join(',') %>">
                    <input type="checkbox" name="target_class_ids" value="<%= c.class_id %>" onchange="finChipChanged(this,'classCount')">
                    <span class="fin-chip-text"><%= c.class_name %></span>
                  </label>
                <% }) %>
                <% if (!refs.classes.length) { %>
                  <div style="color:var(--fin-muted);font-size:.85rem;padding:14px;">No classes available. Create classes first.</div>
                <% } %>
              </div>
            </div>

            <!-- Students: built in the browser when "Chosen students" is picked (finBuildStudentChips) -->
            <div class="fin-field" id="studentPicker" style="display:none;">
              <label>
                Students <span style="color:var(--fin-muted);font-weight:500;font-size:.78rem;">(search by name or class, then click to add)</span>
              </label>
              <div class="fin-search-wrap">
                <input type="text" id="studentSearchBox" class="fin-search-input"
                       placeholder="Search by student name or class…"
                       oninput="finFilterStudents(this.value)">
              </div>
              <div class="fin-picker-actions">
                <button type="button" class="fin-btn sm" onclick="finSelectAllChips('studentChips', true, true)">Select all visible</button>
                <button type="button" class="fin-btn sm" onclick="finSelectAllChips('studentChips', false)">Clear</button>
                <span class="fin-picker-count" id="studentCount">0 selected</span>
              </div>
              <div class="fin-chip-grid scroll" id="studentChips">
                <% if (!refs.students.length) { %>
                  <div style="color:var(--fin-muted);font-size:.85rem;padding:14px;">No students enrolled yet.</div>
                <% } %>
              </div>
            </div>

            <details class="fin-more" id="billMoreOptions">
              <summary><span class="fin-more__title">More options</span><span class="fin-more__hint">Repeating, late fee, who collects it and how parents pay</span></summary>
              <div class="fin-more__body">
                <div class="fin-field">
                  <label>Note for parents</label>
                  <textarea name="description" placeholder="Optional. Shown on the invoice."></textarea>
                </div>
                <div class="fin-row">
                  <div class="fin-field">
                    <label>How often</label>
                    <select name="bill_type" id="billTypeSel">
                      <option value="one_time">Once</option>
                      <option value="recurring">Repeating</option>
                      <option value="installment">In installments</option>
                    </select>
                  </div>
                  <div class="fin-field">
                    <label>Repeats (for a repeating bill)</label>
                    <select name="recurrence" id="billCreateRecurrence">
                      <option value="">—</option>
                      <option value="daily">Every day</option>
                      <option value="weekly">Every week</option>
                      <option value="monthly">Every month</option>
                      <option value="term">Every term</option>
                      <option value="year">Every year</option>
                    </select>
                  </div>
                </div>
                <div class="fin-row">
                  <div class="fin-field">
                    <label>Last date (for a repeating bill)</label>
                    <input name="recurrence_end_date" id="billCreateEndDate" type="date">
                    <small style="color:var(--fin-muted);font-size:.72rem;">Left empty, it stops when the term ends.</small>
                  </div>
                  <div class="fin-field">
                    <label>School days only</label>
                    <div class="fin-checks">
                      <label class="fin-check"><input type="checkbox" name="exclude_non_school_days" id="billCreateExcludeNonSchoolDays"> Skip weekends and holidays</label>
                    </div>
                  </div>
                </div>
                <div class="fin-row">
                  <div class="fin-field">
                    <label>Late fee</label>
                    <input name="late_fee_amount" type="number" step="0.01" min="0" placeholder="0.00">
                  </div>
                  <div class="fin-field">
                    <label>Added after (days late)</label>
                    <input name="late_fee_after_days" type="number" min="0" value="7">
                  </div>
                </div>
                <div class="fin-row">
                  <div class="fin-field">
                    <label>School year *</label>
                    <select name="school_year_id" id="billCreateYearSelect" required>
                      <option value="">— Select school year —</option>
                  <% (refs.years || []).forEach(y => { %><option value="<%= y.school_year_id %>" <%= y.current ? 'selected' : '' %>><%= y.name %><%= y.current ? ' (current)' : '' %></option><% }) %>
                    </select>
                    <% if (!refs.years || !refs.years.length) { %>
                      <small style="color:var(--fin-warn);font-size:.72rem;">No school years yet. Add one in Management, School years &amp; terms.</small>
                    <% } %>
                  </div>
                  <div class="fin-field">
                    <label>Term *</label>
                    <select name="term_id" id="billCreateTermSelect" data-year-required-label="Select year first" required>
                      <option value="">— Select term —</option>
                  <% (refs.terms || []).forEach(t => { %><option value="<%= t.term_id %>" data-school-year-id="<%= t.school_year_id || '' %>" data-current="<%= t.current ? 'true' : 'false' %>" data-start-date="<%= t.start_date ? new Date(t.start_date).toISOString().slice(0,10) : '' %>" data-end-date="<%= t.end_date ? new Date(t.end_date).toISOString().slice(0,10) : '' %>" <%= t.current ? 'selected' : '' %>><%= t.name %><%= t.current ? ' (current)' : '' %></option><% }) %>
                    </select>
                    <small style="color:var(--fin-muted);font-size:.74rem;">Only students enrolled in this year and term are billed.</small>
                  </div>
                </div>
                <div class="fin-field">
                  <label>Staff who collect it <span style="color:var(--fin-muted);font-weight:400;font-size:.75em;">(hold Ctrl / ⌘ to pick more than one)</span></label>
                  <select name="assignee_ids[]" class="fin-multi-select" multiple size="4" style="min-height:90px;">
                <% (refs.employees || []).forEach(function(e) { %>
                  <option value="<%= e.user_id %>"><%= formatCollectorOptionLabel(e) %></option>
                <% }) %>
                  </select>
                  <small style="color:var(--fin-muted);font-size:.72rem;">They collect it from the class page (My PayGira). Leave empty when the office collects.</small>
                </div>
                <div class="fin-field">
                  <label>Where the money goes</label>
              <% const selectedCreateDestination = collectionDestinationOptionsSafe.some(function(option) { return String(option.value) === String((createBillDraftState && createBillDraftState.payment_destination) || ''); })
                ? String((createBillDraftState && createBillDraftState.payment_destination) || '')
                : String(defaultCollectionDestinationSafe || ''); %>
              <select name="payment_destination">
                <% if (collectionDestinationOptionsSafe.length) { %>
                  <% collectionDestinationOptionsSafe.forEach(function(option) { %>
                    <option value="<%= option.value %>" <%= selectedCreateDestination === String(option.value) ? 'selected' : '' %>><%= option.label %></option>
                  <% }) %>
                <% } else { %>
                  <option value="cash">Cash (collect manually)</option>
                <% } %>
              </select>
                  <small style="color:var(--fin-muted);font-size:.74rem;">Only payout accounts that are switched on are listed. Choose Cash to collect by hand.</small>
                </div>
                <div class="fin-field">
                  <label>How parents can pay</label>
              <% const createIsStripe = paymentProviderSafe === 'stripe';
                 const createIsPaystack = paymentProviderSafe === 'paystack';
                 const createCardOn = createIsPaystack ? true : !!(allowedMethods && allowedMethods.stripeOn);
                 const createTransferOn = createIsStripe ? false : !!(allowedMethods && (allowedMethods.bankOn || allowedMethods.momoOn) || createIsPaystack);
                 const createCardLabel = createIsPaystack ? 'Card (Paystack)' : 'Card (Stripe)';
                 const createTransferLabel = createIsPaystack ? 'Mobile money / Bank' : 'Bank / Mobile money'; %>
              <div class="fin-checks">
                <label class="fin-check fin-check-all"><input type="checkbox" id="payAll" onchange="finTogglePayAll(this)" checked> <strong>All methods</strong></label>
                <% if (createCardOn) { %>
                <label class="fin-check"><input type="checkbox" class="pay-method" name="accepts_card" checked> <%= createCardLabel %></label>
                <% } %>
                <label class="fin-check"><input type="checkbox" class="pay-method" name="accepts_cash" checked> Cash</label>
                <% if (createTransferOn) { %>
                <label class="fin-check"><input type="checkbox" class="pay-method" name="accepts_transfer" checked> <%= createTransferLabel %></label>
                <% } %>
              </div>
              <% if (!createCardOn && !createTransferOn) { %>
                <small style="color:var(--fin-muted);font-size:.72rem;">Activate Stripe, bank, or mobile money under Payment Settings to offer online methods.</small>
              <% } %>
                </div>
                <div class="fin-field">
                  <label>Tell parents</label>
                  <div class="fin-checks">
                    <label class="fin-check"><input type="checkbox" name="notify_email" checked> Email each parent their invoice</label>
                  </div>
                </div>
              </div>
            </details>
            <div class="fin-form-actions">
              <button type="submit" name="status" value="active" class="fin-btn sm primary">Create and send</button>
              <button type="submit" name="status" value="draft" class="fin-btn sm quiet">Save as draft</button>
            </div>
            <script>
              // "More options" opens itself when something inside it still needs an answer (no
              // current term to bill for, or a repeating bill being filled in), so nothing that
              // stops the bill is ever hidden.
              (function () {
                var more = document.getElementById('billMoreOptions');
                var form = more && more.closest('form');
                if (!form) return;
                form.addEventListener('invalid', function (event) { if (more.contains(event.target)) more.open = true; }, true);
                var check = function () {
                  var year = document.getElementById('billCreateYearSelect');
                  var term = document.getElementById('billCreateTermSelect');
                  var type = document.getElementById('billTypeSel');
                  if ((year && !year.value) || (term && !term.value) || (type && type.value !== 'one_time')) more.open = true;
                };
                window.addEventListener('load', check);
                form.addEventListener('change', function (event) { if (event.target && event.target.id === 'billTypeSel') check(); });
              })();
            </script>
          </form>
          </div>
        </div>

        <div class="fin-card">
          <div class="section-head">
            <h2>Bills sent this term</h2>
            <div class="fin-head-tools">
              <span class="fin-section-count"><%= bills.length %> bill<%= bills.length === 1 ? '' : 's' %></span>
              <details class="fin-filter-fold" data-fin-filter>
                <summary title="Choose the billing period"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 5h18l-7 8v5l-4 2v-7z"/></svg><span>Filter</span><span class="fin-filter-summary"><%= finPeriodLabel(billYearFilter, billTermFilter) %></span></summary>
                <form method="GET" action="/account/settings/finance" class="fin-filter-pop" aria-label="Filter bills">
                  <input type="hidden" name="section" value="bills">
                  <p class="fin-filter-title">Billing period</p>
                  <div class="fin-field">
                    <label for="billListYearFilter">School year</label>
                    <select name="billYear" id="billListYearFilter">
                      <% _finYears.forEach(y => { %><option value="<%= y.school_year_id %>" <%= String(billYearFilter) === String(y.school_year_id) ? 'selected' : '' %>><%= y.name %><%= y.current ? ' (current)' : '' %></option><% }) %>
                    </select>
                  </div>
                  <div class="fin-field">
                    <label for="billListTermFilter">Term</label>
                    <select name="billTerm" id="billListTermFilter" data-year-required-label="Select a year first">
                      <option value="">All terms</option>
                      <% _finTerms.forEach(t => { %><option value="<%= t.term_id %>" data-school-year-id="<%= t.school_year_id || '' %>" <%= String(billTermFilter) === String(t.term_id) ? 'selected' : '' %>><%= t.name %><%= t.current ? ' (current)' : '' %></option><% }) %>
                    </select>
                  </div>
                  <% if (_finQuery.billYear || _finQuery.billTerm) { %><a class="fin-filter-current" href="/account/settings/finance?section=bills">Back to the current term</a><% } %>
                  <noscript><button type="submit" class="fin-btn sm">Show</button></noscript>
                </form>
              </details>
            </div>
          </div>
          <% if (!bills.length) { %>
            <div class="empty-state"><h3>No bills yet</h3><p>Open <b>New bill</b> above to send the first one.</p></div>
          <% } else { %>
            <div class="fin-table-wrap">
              <table class="fin-table fin-bills-table">
                <thead><tr>
                  <th>Bill <button type="button" class="fin-sort-btn" data-fin-sort-index="0" data-fin-default="true" aria-label="Sort bills Z to A"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 12 12" aria-hidden="true" focusable="false"><path fill="currentColor" d="M10 5H2a.5.5 0 0 1-.46-.31.47.47 0 0 1 .11-.54L5.29.5A1 1 0 0 1 6.7.5l3.65 3.65a.49.49 0 0 1 .11.54A.51.51 0 0 1 10 5z"></path><path fill="currentColor" d="M2 7a.5.5 0 0 0-.46.31.47.47 0 0 0 .11.54L5.3 11.5a1 1 0 0 0 1.41 0l3.65-3.65a.49.49 0 0 0 .11-.54A.53.53 0 0 0 10 7z"></path></svg></button></th>
                  <th class="num fin-col-md">Students</th>
                  <th class="fin-col-md">Due</th>
                  <th class="num">Billed</th>
                  <th class="num fin-col-lg">Paid</th>
                  <th>Status</th>
                  <th></th>
                </tr></thead>
                <tbody>
                  <% bills.forEach(b => { const _bpayload = {id:b.bill_id,title:b.title,description:b.description||"",amount:b.amount,due_date:b.due_date?new Date(b.due_date).toISOString().slice(0,10):"",recurrence_end_date:b.recurrence_end_date?new Date(b.recurrence_end_date).toISOString().slice(0,10):"",bill_type:b.bill_type||'one_time',recurrence:b.recurrence||"",late_fee_amount:b.late_fee_amount||0,late_fee_after_days:b.late_fee_after_days||7,exclude_non_school_days:!!b.exclude_non_school_days,assignee_id:b.assignee_id||"",assignee_ids:b.assignee_ids||[],applies_to:b.applies_to||'school',school_year_id:b.school_year_id||"",term_id:b.term_id||"",target_class_ids:b.target_class_ids||[],target_student_ids:b.target_student_ids||[],payment_destination:b.payment_destination||'stripe',accepts_card:!!b.accepts_card,accepts_cash:!!b.accepts_cash,accepts_transfer:!!b.accepts_transfer,notify_email:!!b.notify_email,status:b.status||'active'}; %>
                    <%
                      // What sets this bill apart, said in a few words under its name.
                      const _repeats = { daily: 'every day', weekly: 'every week', monthly: 'every month', term: 'every term', year: 'every year' }[b.recurrence] || '';
                      const _billNotes = [];
                      if (b.bill_type === 'recurring') _billNotes.push('Repeats' + (_repeats ? ' ' + _repeats : ''));
                      if (b.bill_type === 'installment') _billNotes.push('In installments');
                      if (b.assignee_first_name) _billNotes.push('Collected by ' + (typeof formatDisplayName === 'function' ? formatDisplayName({ first_name: b.assignee_first_name, last_name: b.assignee_last_name }) : [b.assignee_first_name, b.assignee_last_name].filter(Boolean).join(' ').trim()));
                      const _billStatusWords = { active: 'Sent', draft: 'Draft', cancelled: 'Cancelled', paid: 'Paid' };
                    %>
                    <tr class="fin-click-row" onclick='openEditBill(<%- JSON.stringify(_bpayload) %>)' title="Open this bill">
                      <td>
                        <div class="fin-bill-copy">
                          <strong class="fin-bill-title"><%= b.title %></strong>
                          <% if (b.description) { %><div class="fin-bill-meta"><%= b.description %></div><% } %>
                          <% if (_billNotes.length) { %><div class="fin-bill-meta"><%= _billNotes.join(' · ') %></div><% } %>
                        </div>
                      </td>
                      <td class="num fin-col-md fin-money-neutral"><%= b.assigned_count %></td>
                      <td class="fin-col-md fin-date-muted"><%= b.due_date ? (typeof formatDisplayDate === 'function' ? formatDisplayDate(b.due_date) : new Date(b.due_date).toLocaleDateString()) : '—' %></td>
                      <td class="num fin-money-neutral"><%= fmt(b.total_amount) %></td>
                      <td class="num fin-col-lg fin-money-positive"><%= fmt(b.total_paid) %></td>
                      <td><span class="badge <%= b.status %>"><%= _billStatusWords[b.status] || b.status %></span></td>
                      <td class="fin-actions-cell">
                        <% if (b.status === 'active') { %>
                        <form method="POST" action="/account/settings/finance/bills/<%= b.bill_id %>/reminder" style="display:inline;" onclick="event.stopPropagation();" onsubmit="return confirm('Email every parent who still owes this bill, with what they owe and a link to pay?');">
                          <button class="fin-btn sm quiet" title="Email every parent who still owes this bill a link to pay">Request payment</button>
                        </form>
                        <% } %>
                        <button type="button" class="fin-btn fin-icon-btn" title="Edit bill" aria-label="Edit bill" onclick='event.stopPropagation(); openEditBill(<%- JSON.stringify(_bpayload) %>)'>
                          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 20h9"></path><path d="M16.5 3.5a2.1 2.1 0 1 1 3 3L7 19l-4 1 1-4 12.5-12.5z"></path></svg>
                        </button>
                        <% if (paygiraAccess.canDeleteBills) { %>
                        <form method="POST" action="/account/settings/finance/bills/<%= b.bill_id %>/delete" onsubmit="return confirm('Delete this bill for every student it was sent to?');" style="display:inline;" onclick="event.stopPropagation();">
                          <button class="fin-btn fin-icon-btn danger" title="Delete bill" aria-label="Delete bill">
                            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 6h18"></path><path d="M8 6V4h8v2"></path><path d="M19 6l-1 14H6L5 6"></path><path d="M10 11v6"></path><path d="M14 11v6"></path></svg>
                          </button>
                        </form>
                        <% } %>
                      </td>
                    </tr>
                  <% }) %>
                </tbody>
              </table>
            </div>
            
          <% } %>
        </div>
      <% } %>

      <% if (sec === 'students') { %>
        <%
          // The ledger: who was billed, what they paid and what they still owe. Sent as compact
          // rows and drawn in the browser (a page of ready-made rows for every student was 4 MB).
          // [id, name, shown id, class id, class name, billed, paid, credit, owed, photo]
          const _ledgerRows = (studentBilling || []).map((st) => {
            const owedGross = Number(st.outstanding || 0);
            const credit = Number(st.student_credit || 0);
            return [
              st.student_id,
              st.display_name || (typeof formatDisplayName === 'function' ? formatDisplayName(st) : [st.first_name, st.last_name].filter(Boolean).join(' ').trim()),
              st.display_student_id_text || ('#' + st.student_id),
              st.class_id || 0,
              st.class_name || '',
              Number(st.total_billed || 0),
              Number(st.total_paid || 0),
              credit,
              Number(st.net_outstanding || Math.max(owedGross - credit, 0)),
              (st.image_url && String(st.image_url).trim() && String(st.image_url).trim() !== 'profilePlaceholder.png') ? resolveAvatar(st.image_url) : '',
            ];
          });
          const _ledgerSum = (index) => _ledgerRows.reduce((sum, row) => sum + row[index], 0);
          const _ledgerOwing = _ledgerRows.filter((row) => row[8] > 0).length;
          const _ledgerBilled = _ledgerRows.filter((row) => row[5] > 0).length;
          const _ledgerCredit = _ledgerRows.filter((row) => row[7] > 0).length;
          const _ledgerClasses = [...new Map(_ledgerRows.filter((row) => row[3]).map((row) => [row[3], row[4]])).entries()].sort((x, y) => String(x[1]).localeCompare(String(y[1]), undefined, { numeric: true }));
        %>
        <div class="fin-card">
          <div class="section-head">
            <h2>What each student owes</h2>
            <div class="fin-head-tools">
              <details class="fin-filter-fold" data-fin-filter>
                <summary title="Choose the billing period"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 5h18l-7 8v5l-4 2v-7z"/></svg><span>Filter</span><span class="fin-filter-summary"><%= finPeriodLabel(studentYearFilter, studentTermFilter) %></span></summary>
                <form method="GET" action="/account/settings/finance" class="fin-filter-pop" aria-label="Filter students' bills">
                  <input type="hidden" name="section" value="students">
                  <p class="fin-filter-title">Billing period</p>
                  <div class="fin-field">
                    <label for="studentBillingYearFilter">School year</label>
                    <select name="studentYear" id="studentBillingYearFilter">
                      <% _finYears.forEach(y => { %><option value="<%= y.school_year_id %>" <%= String(studentYearFilter) === String(y.school_year_id) ? 'selected' : '' %>><%= y.name %><%= y.current ? ' (current)' : '' %></option><% }) %>
                    </select>
                  </div>
                  <div class="fin-field">
                    <label for="studentBillingTermFilter">Term</label>
                    <select name="studentTerm" id="studentBillingTermFilter" data-year-required-label="Select a year first">
                      <option value="">All terms</option>
                      <% _finTerms.forEach(t => { %><option value="<%= t.term_id %>" data-school-year-id="<%= t.school_year_id || '' %>" <%= String(studentTermFilter) === String(t.term_id) ? 'selected' : '' %>><%= t.name %><%= t.current ? ' (current)' : '' %></option><% }) %>
                    </select>
                  </div>
                  <% if (_finQuery.studentYear || _finQuery.studentTerm) { %><a class="fin-filter-current" href="/account/settings/finance?section=students">Back to the current term</a><% } %>
                  <p class="fin-filter-note">Totals cover this period. Credit balances always show, because the school still owes them.</p>
                  <noscript><button type="submit" class="fin-btn sm">Show</button></noscript>
                </form>
              </details>
            </div>
          </div>
          <% if (!_ledgerRows.length) { %>
            <div class="empty-state"><h3>No students yet</h3></div>
          <% } else { %>
            <div class="fin-stats fin-student-summary-grid" style="margin-bottom:16px;">
              <div class="stat">
                <div class="label">Billed</div>
                <div class="value"><%= fmt(_ledgerSum(5)) %></div>
                <div class="sub"><%= _ledgerBilled %> student<%= _ledgerBilled === 1 ? '' : 's' %> billed</div>
              </div>
              <div class="stat green">
                <div class="label">Paid</div>
                <div class="value"><%= fmt(_ledgerSum(6)) %></div>
                <div class="sub">Received so far</div>
              </div>
              <div class="stat red">
                <div class="label">Still owed</div>
                <div class="value"><%= fmt(_ledgerSum(8)) %></div>
                <div class="sub"><%= _ledgerOwing ? (_ledgerOwing + ' student' + (_ledgerOwing === 1 ? ' owes' : 's owe')) : 'Nobody owes anything' %></div>
              </div>
              <% if (_ledgerCredit) { %>
              <div class="stat gold">
                <div class="label">Credit held</div>
                <div class="value"><%= fmt(_ledgerSum(7)) %></div>
                <div class="sub">Paid ahead by <%= _ledgerCredit %> student<%= _ledgerCredit === 1 ? '' : 's' %></div>
              </div>
              <% } %>
            </div>
            <div class="fin-report-filters fin-ledger-filters" style="margin-bottom:16px;">
              <div class="fin-field">
                <label for="ledgerSearch">Find a student</label>
                <input type="search" id="ledgerSearch" placeholder="Name or student ID" autocomplete="off">
              </div>
              <div class="fin-field">
                <label for="ledgerClass">Class</label>
                <select id="ledgerClass">
                  <option value="">All classes</option>
                  <% _ledgerClasses.forEach(([classId, className]) => { %><option value="<%= classId %>"><%= className %></option><% }) %>
                </select>
              </div>
              <div class="fin-field">
                <label for="ledgerShow">Show</label>
                <select id="ledgerShow">
                  <option value="owes"<%= _ledgerOwing ? ' selected' : '' %>>Students who owe (<%= _ledgerOwing %>)</option>
                  <option value="billed"<%= !_ledgerOwing && _ledgerBilled ? ' selected' : '' %>>Everyone billed (<%= _ledgerBilled %>)</option>
                  <option value="paid">Paid in full</option>
                  <% if (_ledgerCredit) { %><option value="credit">With credit (<%= _ledgerCredit %>)</option><% } %>
                  <option value="all"<%= !_ledgerOwing && !_ledgerBilled ? ' selected' : '' %>>All students (<%= _ledgerRows.length %>)</option>
                </select>
              </div>
            </div>
            <div class="fin-table-wrap fin-scroll" id="finStudentsWrap">
              <table class="fin-table fin-student-table no-global-sort">
                <thead><tr>
                  <th><button type="button" class="fin-ledger-sort" data-ledger-sort="name">Student</button></th>
                  <th class="fin-col-md">Class</th>
                  <th class="num fin-col-lg">Billed</th>
                  <th class="num fin-col-lg">Paid</th>
                  <th class="num"><button type="button" class="fin-ledger-sort" data-ledger-sort="owed">Balance</button></th>
                  <th></th>
                </tr></thead>
                <tbody id="ledgerBody"></tbody>
              </table>
              <p class="fin-ledger-empty" id="ledgerEmpty" hidden>Nobody matches. Change the filters above.</p>
            </div>
            <div class="fin-pagebar" id="finStudentsPagebar">
              <div class="fin-pagebar-left">
                <span class="fin-pagebar-label" id="ledgerCount"></span>
              </div>
              <div class="fin-pagebar-right">
                <button type="button" class="fin-page-btn" id="ledgerPrev">Prev</button>
                <span class="fin-page-info" id="ledgerInfo">1/1</span>
                <button type="button" class="fin-page-btn" id="ledgerNext">Next</button>
              </div>
            </div>
            <p class="fin-ledger-hint">Select a student to see their bills and payments, print an invoice or record a payment.</p>
            <script>
              // Draws the ledger from the rows above: 25 at a time, the biggest balances first.
              (function () {
                var rows = <%- JSON.stringify(_ledgerRows) %>;
                var placeholder = <%- JSON.stringify(profilePlaceholder) %>;
                var currency = <%- JSON.stringify((financeCurrency && financeCurrency.code) || 'USD') %>;
                var money;
                try { var nf = new Intl.NumberFormat('en-US', { style: 'currency', currency: currency }); money = function (v) { return nf.format(v); }; }
                catch (_e) { money = function (v) { return currency + ' ' + Number(v).toFixed(2); }; }
                var PAGE = 25, page = 1, sort = { by: 'owed', down: true };
                var body = document.getElementById('ledgerBody');
                var search = document.getElementById('ledgerSearch'), klass = document.getElementById('ledgerClass'), show = document.getElementById('ledgerShow');
                var statusOf = function (row) {
                  if (row[5] <= 0 && row[7] <= 0) return ['draft', 'No bills'];
                  if (row[8] <= 0) return ['paid', row[7] > 0 ? 'In credit' : 'Paid'];
                  return row[6] > 0 || row[7] > 0 ? ['partial', 'Part paid'] : ['pending', 'Owes'];
                };
                var matching = function () {
                  var q = search.value.trim().toLowerCase(), c = klass.value, mode = show.value;
                  var list = rows.filter(function (row) {
                    if (q && (row[1] + ' ' + row[2] + ' ' + row[4]).toLowerCase().indexOf(q) === -1) return false;
                    if (c && String(row[3]) !== c) return false;
                    // Searching for someone by name finds them whatever they owe.
                    if (q) return true;
                    if (mode === 'owes') return row[8] > 0;
                    if (mode === 'billed') return row[5] > 0;
                    if (mode === 'paid') return row[5] > 0 && row[8] <= 0;
                    if (mode === 'credit') return row[7] > 0;
                    return true;
                  });
                  list.sort(function (x, y) {
                    var d = sort.by === 'owed' ? x[8] - y[8] : String(x[1]).localeCompare(String(y[1]), undefined, { sensitivity: 'base' });
                    if (d === 0) d = String(x[1]).localeCompare(String(y[1]), undefined, { sensitivity: 'base' });
                    return sort.down ? -d : d;
                  });
                  return list;
                };
                var cell = function (className, text) { var td = document.createElement('td'); if (className) td.className = className; if (text != null) td.textContent = text; return td; };
                var draw = function () {
                  var list = matching();
                  var pages = Math.max(1, Math.ceil(list.length / PAGE));
                  page = Math.min(Math.max(page, 1), pages);
                  body.textContent = '';
                  list.slice((page - 1) * PAGE, page * PAGE).forEach(function (row) {
                    var tr = document.createElement('tr');
                    tr.className = 'fin-click-row';
                    tr.title = 'See bills and payments';
                    tr.addEventListener('click', function () { if (window.openStudentDrawer) window.openStudentDrawer(row[0]); });
                    var who = cell('');
                    var main = document.createElement('div'); main.className = 'fin-student-main';
                    var avatar = document.createElement('div'); avatar.className = 'fin-student-avatar';
                    var img = document.createElement('img'); img.loading = 'lazy'; img.decoding = 'async'; img.alt = ''; img.src = row[9] || placeholder;
                    img.onerror = function () { img.onerror = null; img.src = placeholder; };
                    avatar.appendChild(img);
                    var copy = document.createElement('div'); copy.className = 'fin-student-copy';
                    var name = document.createElement('strong'); name.className = 'fin-student-name'; name.textContent = row[1];
                    var meta = document.createElement('div'); meta.className = 'fin-student-meta'; meta.textContent = 'ID ' + row[2];
                    copy.appendChild(name); copy.appendChild(meta); main.appendChild(avatar); main.appendChild(copy); who.appendChild(main);
                    tr.appendChild(who);
                    var klassCell = cell('fin-col-md'); var chip = document.createElement('span'); chip.className = 'fin-class-chip'; chip.textContent = row[4] || 'No class'; klassCell.appendChild(chip); tr.appendChild(klassCell);
                    tr.appendChild(cell('num fin-col-lg fin-money-neutral', money(row[5])));
                    tr.appendChild(cell('num fin-col-lg fin-money-positive', money(row[6])));
                    var owed = cell('num ' + (row[8] > 0 ? 'fin-money-negative' : 'fin-money-neutral'), money(row[8]));
                    if (row[7] > 0) { var credit = document.createElement('div'); credit.className = 'fin-ledger-credit'; credit.textContent = money(row[7]) + ' credit'; owed.appendChild(credit); }
                    tr.appendChild(owed);
                    var status = statusOf(row); var badgeCell = cell(''); var badge = document.createElement('span'); badge.className = 'badge ' + status[0]; badge.textContent = status[1]; badgeCell.appendChild(badge); tr.appendChild(badgeCell);
                    body.appendChild(tr);
                  });
                  document.getElementById('ledgerEmpty').hidden = list.length > 0;
                  document.getElementById('ledgerCount').textContent = list.length + (list.length === 1 ? ' student' : ' students');
                  document.getElementById('ledgerInfo').textContent = page + '/' + pages;
                  document.getElementById('ledgerPrev').disabled = page <= 1;
                  document.getElementById('ledgerNext').disabled = page >= pages;
                  document.querySelectorAll('[data-ledger-sort]').forEach(function (button) {
                    var on = button.getAttribute('data-ledger-sort') === sort.by;
                    button.setAttribute('data-on', on ? (sort.down ? 'down' : 'up') : '');
                  });
                };
                var again = function () { page = 1; draw(); };
                search.addEventListener('input', again); klass.addEventListener('change', again); show.addEventListener('change', again);
                document.getElementById('ledgerPrev').addEventListener('click', function () { page -= 1; draw(); });
                document.getElementById('ledgerNext').addEventListener('click', function () { page += 1; draw(); });
                document.querySelectorAll('[data-ledger-sort]').forEach(function (button) {
                  button.addEventListener('click', function () {
                    var by = button.getAttribute('data-ledger-sort');
                    sort = { by: by, down: sort.by === by ? !sort.down : by === 'owed' };
                    again();
                  });
                });
                draw();
              })();
            </script>
          <% } %>
        </div>
      <% } %>

      <% if (sec === 'subscriptions') { %>
        <div class="fin-card">
          <div class="section-head"><h2>Bills that repeat</h2></div>
          <% const recurring = bills.filter(b => b.bill_type === 'recurring'); %>
          <% const _everyWords = { daily: 'every day', weekly: 'every week', monthly: 'every month', term: 'every term', year: 'every year' }; %>
          <% const _repeatStatus = { active: 'Running', draft: 'Draft', cancelled: 'Stopped', paid: 'Paid' }; %>
          <% if (!recurring.length) { %>
            <div class="empty-state"><h3>No repeating bills yet</h3><p>In <a href="/account/settings/finance?section=bills" style="color:var(--fin-teal);">All bills</a>, open <b>New bill</b>, then <b>More options</b>, and set <b>How often</b> to Repeating.</p></div>
          <% } else { %>
            <div style="display:grid; gap:14px;">
              <% recurring.forEach(b => { %>
                <div style="padding:18px; background:var(--fin-card-2); border:1px solid var(--fin-border); border-radius:14px;">
                  <div style="display:flex; justify-content:space-between; align-items:flex-start; gap:12px; flex-wrap:wrap;">
                    <div>
                      <div style="font-family:inherit; font-size:1.05rem; font-weight:700;"><%= b.title %></div>
                      <div style="color:var(--fin-muted); font-size:.85rem; margin-top:4px;"><span class="fin-mono"><%= fmt(b.amount) %></span> <%= _everyWords[b.recurrence] || 'each time' %> · <%= b.assigned_count %> student<%= Number(b.assigned_count) === 1 ? '' : 's' %> · paid so far <%= fmt(b.total_paid) %> of <%= fmt(b.total_amount) %></div>
                    </div>
                    <span class="badge <%= b.status %>"><%= _repeatStatus[b.status] || b.status %></span>
                  </div>
                </div>
              <% }) %>
            </div>
            <p class="fin-ledger-hint">To change or stop one, open it from <a href="/account/settings/finance?section=bills" style="color:var(--fin-teal);">All bills</a>.</p>
          <% } %>
        </div>
      <% } %>

      <% if (sec === 'payments') { %>
        <% if (paygiraAccess.canRecordPayments) { %>
        <div class="fin-card fin-accordion fin-sheet" id="acc-record-payment" role="dialog" aria-modal="true" aria-labelledby="acc-record-payment-title" aria-hidden="true">
          <div class="fin-sheet__head">
            <div>
              <h2 class="fin-sheet__title" id="acc-record-payment-title">Record a payment</h2>
              <p class="fin-sheet__hint">Cash, a check, a bank transfer or anything else paid outside PayGira.</p>
            </div>
            <button type="button" class="fin-sheet__close" aria-label="Close" onclick="finToggleAcc('acc-record-payment')">&times;</button>
          </div>
          <div class="fin-acc-body">
          <%
            const allAssignments = [];
          %>
          <form class="fin-form" method="POST" action="/account/settings/finance/payments">
            <div class="fin-field">
              <label>Who paid, and for what? *</label>
              <select name="assignment_id" required id="assignSel">
                <option value="">Choose the bill and student</option>
                <% bills.forEach(b => { %>
                  <% /* Render assignment per bill in subquery - simple: list bill+balance */ %>
                <% }) %>
              </select>
              <div style="font-size:.75rem; color:var(--fin-muted); margin-top:6px;">Loading assignments...</div>
            </div>
            <div class="fin-row">
              <div class="fin-field">
                <label>Amount received (<%= currentCurrency %>) *</label>
                <input name="amount" type="number" step="0.01" min="0" required>
              </div>
              <div class="fin-field">
                <label>How it was paid *</label>
                <select name="method">
                  <option value="cash">Cash</option>
                  <option value="cheque">Check</option>
                  <option value="bank_transfer">Bank transfer</option>
                  <option value="other">Other</option>
                </select>
              </div>
            </div>
            <div class="fin-row">
              <div class="fin-field">
                <label>Reference</label>
                <input name="reference" placeholder="Optional. A check or transfer number">
              </div>
              <div class="fin-field">
                <label>Note</label>
                <input name="notes" placeholder="Optional">
              </div>
            </div>
            <div class="fin-form-actions">
              <button type="submit" class="fin-btn sm primary">Record payment</button>
              <button type="button" class="fin-btn sm quiet" onclick="finToggleAcc('acc-record-payment')">Cancel</button>
            </div>
          </form>
          <div style="margin-top:12px; padding:12px 14px; background:color-mix(in srgb, var(--org-primary-color, #01535b) 5%, transparent); border:1px dashed var(--fin-border); border-radius:10px; font-size:.82rem; color:var(--fin-muted);">
            Payments parents make online are recorded here by themselves. Turn online payments on in <a href="?section=settings" style="color:var(--fin-teal);">Settings</a>.
          </div>
          </div>
        </div>

        <% } %>

        <% if (paygiraAccess.canSeePayments || paygiraAccess.canCorrectPayments) { %>
        <div class="fin-card">
          <%
            const _pay = (typeof payments !== 'undefined' && payments) || { rows: [], page: 1, hasMore: false, total: 0, amount: 0, q: '' };
            const _payLink = (page) => '/account/settings/finance?section=payments&payPage=' + page + (_pay.q ? '&payQ=' + encodeURIComponent(_pay.q) : '');
            const _payMethods = { cash: 'Cash', cheque: 'Check', bank_transfer: 'Bank transfer', transfer: 'Bank transfer', card: 'Card', stripe: 'Card', momo: 'Mobile money', mobile_money: 'Mobile money', credit: 'Credit', other: 'Other' };
          %>
          <div class="section-head">
            <h2>Payments received</h2>
            <div class="fin-head-tools">
              <span class="fin-section-count"><%= _pay.total %> payment<%= _pay.total === 1 ? '' : 's' %> · <%= fmt(_pay.amount) %></span>
            </div>
          </div>
          <form method="GET" action="/account/settings/finance" class="fin-pay-find">
            <input type="hidden" name="section" value="payments">
            <input type="search" name="payQ" value="<%= _pay.q %>" placeholder="Find by student, bill or reference" aria-label="Find a payment">
            <button class="fin-btn sm quiet">Find</button>
            <% if (_pay.q) { %><a class="fin-btn sm quiet" href="/account/settings/finance?section=payments">Show all</a><% } %>
          </form>
          <% if (!_pay.rows.length) { %>
            <div class="empty-state"><h3><%= _pay.q ? 'No payment matches' : 'No payments yet' %></h3><% if (!_pay.q) { %><p>Payments show here as parents pay online or you record them above.</p><% } %></div>
          <% } else { %>
            <div class="fin-table-wrap" id="finPaymentsWrap">
              <table class="fin-table no-global-sort">
                <thead><tr><th>Date</th><th>Student</th><th class="fin-col-md">Bill</th><th class="fin-col-md">Paid by</th><th class="num">Amount</th><th></th></tr></thead>
                <tbody>
                  <% _pay.rows.forEach(r => { %>
                    <tr>
                      <td class="fin-date-muted"><%= typeof formatDisplayDate === 'function' ? formatDisplayDate(r.received_at) : new Date(r.received_at).toLocaleDateString() %></td>
                      <td><strong><%= [r.first_name, r.last_name].filter(Boolean).join(' ') || '—' %></strong><% if (r.reference) { %><div class="fin-bill-meta">Ref <%= r.reference %></div><% } %></td>
                      <td class="fin-col-md"><%= r.bill_title || '—' %></td>
                      <td class="fin-col-md"><%= _payMethods[String(r.method || '').toLowerCase()] || r.method || '—' %><%= r.is_refund ? ' (refund)' : '' %></td>
                      <td class="num" style="color:var(--fin-success);font-weight:600;"><%= fmt(r.amount) %></td>
                      <td>
                        <div class="fin-actions-cell">
                          <a class="fin-btn sm quiet" href="/account/settings/my-paygira/receipt/<%= r.payment_id %>" target="_blank" rel="noopener">Receipt</a>
                          <% if (paygiraAccess.canCorrectPayments) { %><form method="POST" action="/account/settings/finance/payments/<%= r.payment_id %>/delete" style="margin:0;" onsubmit="return confirm('Remove this payment? The student\'s balance goes back up, and the change is kept in the activity log.');">
                            <button class="fin-btn fin-icon-btn danger" title="Remove this payment (recorded by mistake)" aria-label="Remove this payment">
                              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 6h18"></path><path d="M8 6V4h8v2"></path><path d="M19 6l-1 14H6L5 6"></path><path d="M10 11v6"></path><path d="M14 11v6"></path></svg>
                            </button>
                          </form><% } %>
                        </div>
                      </td>
                    </tr>
                  <% }) %>
                </tbody>
              </table>
            </div>
            <% if (_pay.page > 1 || _pay.hasMore) { %>
            <div class="fin-pagebar">
              <div class="fin-pagebar-left"><span class="fin-pagebar-label">Page <%= _pay.page %> of <%= Math.max(1, Math.ceil(_pay.total / _pay.pageSize)) %></span></div>
              <div class="fin-pagebar-right">
                <% if (_pay.page > 1) { %><a class="fin-page-btn" href="<%= _payLink(_pay.page - 1) %>">Prev</a><% } %>
                <% if (_pay.hasMore) { %><a class="fin-page-btn" href="<%= _payLink(_pay.page + 1) %>">Next</a><% } %>
              </div>
            </div>
            <% } %>
          <% } %>
        </div>

        <div class="fin-card" style="margin-top:20px;">
          <% const signoffPage = (signoffHistoryPagination && signoffHistoryPagination.page) || 1; %>
          <% const signoffPageSize = (signoffHistoryPagination && signoffHistoryPagination.pageSize) || (signoffHistory || []).length || 20; %>
          <div class="section-head"><h2>Collections signed off</h2><span class="fin-section-count"><%= (signoffHistory || []).length %> record<%= (signoffHistory || []).length === 1 ? '' : 's' %><% if (signoffHistoryPagination && signoffHistoryPagination.hasMore) { %> · page <%= signoffPage %><% } %></span></div>
          <% if (!(signoffHistory || []).length) { %>
            <p class="fin-ledger-hint" style="margin:0 2px 4px;">Nothing signed off yet. When a member of staff who collects a bill hands in everything, their sign-off shows here.</p>
          <% } else { %>
            <div class="fin-report-filters" style="margin-bottom:16px;">
              <div class="fin-field">
                <label>Search</label>
                <input type="text" id="signoffSearch" oninput="finRunSignoffFilter()" placeholder="Bill, class, signer, date...">
              </div>
            </div>
            <div class="fin-table-wrap">
              <table class="fin-table" id="signoffHistoryTable">
                <thead><tr><th>Signed At</th><th>Bill <button type="button" class="fin-sort-btn" data-fin-sort-index="1" data-fin-default="true" aria-label="Sort bills Z to A"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 12 12" aria-hidden="true" focusable="false"><path fill="currentColor" d="M10 5H2a.5.5 0 0 1-.46-.31.47.47 0 0 1 .11-.54L5.29.5A1 1 0 0 1 6.7.5l3.65 3.65a.49.49 0 0 1 .11.54A.51.51 0 0 1 10 5z"></path><path fill="currentColor" d="M2 7a.5.5 0 0 0-.46.31.47.47 0 0 0 .11.54L5.3 11.5a1 1 0 0 0 1.41 0l3.65-3.65a.49.49 0 0 0 .11-.54A.53.53 0 0 0 10 7z"></path></svg></button></th><th>Scope</th><th>Class <button type="button" class="fin-sort-btn" data-fin-sort-index="3" aria-label="Sort classes Z to A"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 12 12" aria-hidden="true" focusable="false"><path fill="currentColor" d="M10 5H2a.5.5 0 0 1-.46-.31.47.47 0 0 1 .11-.54L5.29.5A1 1 0 0 1 6.7.5l3.65 3.65a.49.49 0 0 1 .11.54A.51.51 0 0 1 10 5z"></path><path fill="currentColor" d="M2 7a.5.5 0 0 0-.46.31.47.47 0 0 0 .11.54L5.3 11.5a1 1 0 0 0 1.41 0l3.65-3.65a.49.49 0 0 0 .11-.54A.53.53 0 0 0 10 7z"></path></svg></button></th><th>Signed By <button type="button" class="fin-sort-btn" data-fin-sort-index="4" aria-label="Sort signers Z to A"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 12 12" aria-hidden="true" focusable="false"><path fill="currentColor" d="M10 5H2a.5.5 0 0 1-.46-.31.47.47 0 0 1 .11-.54L5.29.5A1 1 0 0 1 6.7.5l3.65 3.65a.49.49 0 0 1 .11.54A.51.51 0 0 1 10 5z"></path><path fill="currentColor" d="M2 7a.5.5 0 0 0-.46.31.47.47 0 0 0 .11.54L5.3 11.5a1 1 0 0 0 1.41 0l3.65-3.65a.49.49 0 0 0 .11-.54A.53.53 0 0 0 10 7z"></path></svg></button></th><th class="num">Students</th><th class="num">Collected</th><th>Actions</th></tr></thead>
                <tbody>
                  <% (signoffHistory || []).forEach(function(row) { const scopeLabel = row.occurrence_date ? (typeof formatDisplayDate === 'function' ? formatDisplayDate(row.occurrence_date) : new Date(row.occurrence_date).toLocaleDateString()) : 'Whole bill'; const classLabel = Number(row.class_id || 0) > 0 ? (row.class_name || 'Class scope') : 'All assigned students'; const signerLabel = (row.signed_by_name || (typeof formatDisplayName === 'function' ? formatDisplayName({ first_name: row.signer_first_name, last_name: row.signer_last_name }) : (((row.signer_first_name || '') + ' ' + (row.signer_last_name || '')).trim())) || 'Staff') + (row.signer_role ? (' · ' + row.signer_role) : ''); const searchText = [row.bill_title, scopeLabel, classLabel, signerLabel, row.occurrence_date || '', row.signer_role || ''].join(' ').toLowerCase(); %>
                    <tr data-text="<%= searchText %>">
                      <td><%= row.signed_at ? (typeof formatDisplayDate === 'function' ? formatDisplayDate(row.signed_at) : new Date(row.signed_at).toLocaleString()) : '—' %></td>
                      <td>
                        <strong><%= row.bill_title || 'Bill' %></strong>
                        <% if (Number(row.reopened_count || 0) > 0) { %>
                          <div style="margin-top:6px; display:flex; align-items:center; gap:8px; flex-wrap:wrap;">
                            <span class="badge" style="background:rgba(180,83,9,.18); color:#b45309; border-color:rgba(180,83,9,.36);">
                              Reopened for correction × <%= Number(row.reopened_count || 0) %>
                            </span>
                            <% if (row.last_reopened_at) { %>
                              <small style="color:var(--fin-muted);">Last reopen: <%= new Date(row.last_reopened_at).toLocaleString() %></small>
                            <% } %>
                          </div>
                        <% } %>
                      </td>
                      <td><%= scopeLabel %></td>
                      <td><%= classLabel %></td>
                      <td><%= signerLabel %></td>
                      <td class="num"><%= row.student_count || 0 %></td>
                      <td class="num fin-money-positive"><%= fmt(row.total_collected || 0) %></td>
                      <td>
                        <div class="fin-actions-cell" style="justify-content:flex-start;">
                          <a class="fin-btn sm" style="min-width:108px; text-decoration:none;" href="/account/settings/finance/signoffs/<%= row.signoff_id %>/report" target="_blank" rel="noopener">View Report</a>
                          <% if (paygiraAccess.canCorrectPayments) { %><form method="POST" action="/account/settings/finance/signoffs/<%= row.signoff_id %>/unsign" style="margin:0;" onsubmit="return confirm('Reopen this sign-off for correction? Audit logs will be saved, the history lock will be removed, and the collection will return to class PayGira so it can be signed off again after corrections.');">
                            <button type="submit" class="fin-btn danger sm" style="min-width:120px;">Reopen Sign-Off</button>
                          </form><% } %>
                        </div>
                      </td>
                    </tr>
                  <% }) %>
                </tbody>
              </table>
              <div id="signoffHistoryEmpty" style="display:none;text-align:center;color:var(--fin-muted);padding:24px;">No sign-offs match your search.</div>
            </div>
            
          <% } %>
        </div>
      <% } %>
      <% } %>

      <% if (sec === 'templates') { %>
        <div class="fin-card fin-accordion" id="acc-create-template" style="margin-bottom:20px;">
          <button type="button" class="fin-acc-head" onclick="finToggleAcc('acc-create-template', this)" aria-expanded="false">
            <span><strong>Create Fee Template</strong></span>
            <span class="fin-acc-hint">Reusable fee setup for repeated bill creation</span>
            <span class="fin-acc-chev">▾</span>
          </button>
          <div class="fin-acc-body">
          <form class="fin-form" method="POST" action="/account/settings/finance/templates">
            <div class="fin-row">
              <div class="fin-field"><label>Name *</label><input name="name" required placeholder="e.g. Tuition Fee (Monthly)"></div>
              <div class="fin-field"><label>Amount (<%= currentCurrency %>) *</label><input name="amount" type="number" step="0.01" min="0" required></div>
            </div>
            <div class="fin-field"><label>Description</label><textarea name="description"></textarea></div>
            <div class="fin-row">
              <div class="fin-field">
                <label>Bill Type</label>
                <select name="bill_type">
                  <option value="one_time">One-Time</option>
                  <option value="recurring">Recurring</option>
                  <option value="installment">Installment</option>
                </select>
              </div>
              <div class="fin-field">
                <label>Recurrence</label>
                <select name="recurrence">
                  <option value="">-</option>
                  <option>monthly</option><option>term</option><option>year</option><option>weekly</option>
                </select>
              </div>
            </div>
            <button type="submit" class="fin-btn primary">+ Create Template</button>
          </form>
          </div>
        </div>

        <div class="fin-card">
          <div class="section-head"><h2>Template Library</h2></div>
          <% if (!templates.length) { %>
            <div class="empty-state"><h3>No templates yet</h3></div>
          <% } else { %>
            <div class="fin-table-wrap">
              <table class="fin-table">
                <thead><tr><th>Name <button type="button" class="fin-sort-btn" data-fin-sort-index="0" data-fin-default="true" aria-label="Sort names Z to A"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 12 12" aria-hidden="true" focusable="false"><path fill="currentColor" d="M10 5H2a.5.5 0 0 1-.46-.31.47.47 0 0 1 .11-.54L5.29.5A1 1 0 0 1 6.7.5l3.65 3.65a.49.49 0 0 1 .11.54A.51.51 0 0 1 10 5z"></path><path fill="currentColor" d="M2 7a.5.5 0 0 0-.46.31.47.47 0 0 0 .11.54L5.3 11.5a1 1 0 0 0 1.41 0l3.65-3.65a.49.49 0 0 0 .11-.54A.53.53 0 0 0 10 7z"></path></svg></button></th><th>Type</th><th class="num">Amount</th><th></th></tr></thead>
                <tbody>
                  <% templates.forEach(t => { %>
                    <tr>
                      <td><strong><%= t.name %></strong><% if (t.description) { %><div style="color:var(--fin-muted); font-size:.78rem;"><%= t.description %></div><% } %></td>
                      <td><span style="color:var(--fin-muted); text-transform:capitalize;"><%= (t.bill_type||'').replace('_',' ') %><%= t.recurrence ? ' · '+t.recurrence : '' %></span></td>
                      <td class="num"><%= fmt(t.amount) %></td>
                      <td>
                        <form method="POST" action="/account/settings/finance/templates/<%= t.template_id %>/delete" onsubmit="return confirm('Delete template?')" style="display:inline;">
                          <button class="fin-btn danger" style="padding:6px 10px; font-size:.78rem;">Delete</button>
                        </form>
                      </td>
                    </tr>
                  <% }) %>
                </tbody>
              </table>
            </div>
          <% } %>
        </div>
      <% } %>

      <% if (sec === 'payouts') { %>
        <div class="fin-card fin-accordion fin-sheet" id="acc-create-payout" role="dialog" aria-modal="true" aria-labelledby="acc-create-payout-title" aria-hidden="true">
          <div class="fin-sheet__head">
            <div>
              <h2 class="fin-sheet__title" id="acc-create-payout-title">New payout</h2>
              <p class="fin-sheet__hint">Pay a member of staff or a supplier, once or on a schedule.</p>
            </div>
            <button type="button" class="fin-sheet__close" aria-label="Close" onclick="finToggleAcc('acc-create-payout')">&times;</button>
          </div>
          <div class="fin-acc-body">
            <form class="fin-form" id="finPayoutForm">
              <input type="hidden" id="finPayoutFormId" value="">
              <div class="fin-field">
                <label>Name *</label>
                <input id="finPayoutName" required placeholder="e.g. Teacher Salary — John Doe">
              </div>

              <div class="fin-field">
                <label>Recipient *</label>
                <div class="fin-payout-tabs">
                  <button type="button" class="fin-payout-tab active" id="finRecipientTabExisting" data-mode="existing">Existing Managira user</button>
                  <button type="button" class="fin-payout-tab" id="finRecipientTabNew" data-mode="new">New person</button>
                </div>
                <div id="finRecipientExistingPanel">
                  <input type="text" id="finRecipientSearch" placeholder="Search by name or email…" autocomplete="off">
                  <div id="finRecipientResults" class="fin-payout-search-results" style="display:none;"></div>
                  <div id="finRecipientSelected" class="fin-type-chip" style="display:none; margin-top:8px;"></div>
                </div>
                <div id="finRecipientNewPanel" style="display:none;">
                  <div class="fin-row">
                    <div class="fin-field"><label>Full name</label><input type="text" id="finRecipientNameNew" placeholder="e.g. John Doe"></div>
                    <div class="fin-field"><label>Email address</label><input type="email" id="finRecipientEmailNew" placeholder="john@example.com"></div>
                  </div>
                </div>
              </div>

              <div class="fin-row">
                <div class="fin-field">
                  <label>Amount *</label>
                  <input id="finPayoutAmount" type="number" min="0.01" step="0.01" required placeholder="500.00">
                </div>
                <div class="fin-field">
                  <label>Currency</label>
                  <select id="finPayoutCurrency">
                    <option value="<%= currentCurrency %>"><%= currentCurrency %></option>
                    <% ['USD','GHS','NGN','GBP','EUR'].filter(c => c !== currentCurrency).forEach(c => { %><option value="<%= c %>"><%= c %></option><% }) %>
                  </select>
                </div>
              </div>

              <div class="fin-row">
                <div class="fin-field">
                  <label>Charge this card *</label>
                  <select id="finPayoutCard" required></select>
                  <small id="finPayoutNoCardHint" style="display:none; color:var(--fin-muted);font-size:.72rem;">No saved card yet — add one under <a href="/account/settings?section=billing" style="color:var(--fin-teal);">Account Settings → Billing &amp; Plan</a>.</small>
                </div>
                <div class="fin-field">
                  <label>Frequency</label>
                  <select id="finPayoutFrequency">
                    <option value="once">One time</option>
                    <option value="weekly">Weekly</option>
                    <option value="biweekly">Every 2 weeks</option>
                    <option value="monthly">Monthly</option>
                  </select>
                </div>
              </div>

              <div class="fin-row">
                <div class="fin-field">
                  <label id="finPayoutStartDateLabel">Pay on *</label>
                  <input id="finPayoutStartDate" type="date" required>
                </div>
                <div class="fin-field" id="finPayoutEndDateField" style="display:none;">
                  <label>Ends on (optional)</label>
                  <input id="finPayoutEndDate" type="date">
                </div>
              </div>

              <p class="error-text" id="finPayoutError" style="color:var(--fin-red); font-size:.82rem;"></p>
              <div class="fin-form-actions">
                <button type="submit" class="fin-btn sm primary" id="finPayoutSubmit">Save payout</button>
                <button type="button" class="fin-btn sm quiet" onclick="finToggleAcc('acc-create-payout')">Cancel</button>
              </div>
            </form>
          </div>
        </div>

        <div class="fin-card">
          <div class="section-head">
            <h2>Scheduled Payouts</h2>
            <span class="fin-section-count" id="finPayoutsCount">0 payouts</span>
          </div>
          <div class="empty-state" id="finPayoutsEmpty"><h3>No payouts yet</h3><p style="color:var(--fin-muted);">Create one above to pay a teacher, staff member, or vendor on a schedule.</p></div>
          <div class="fin-table-wrap" id="finPayoutsTableWrap" style="display:none;">
            <table class="fin-table">
              <thead><tr>
                <th>Name</th><th>Recipient</th><th class="num">Amount</th><th>Frequency</th>
                <th>Card</th><th>Next</th><th>Status</th><th></th>
              </tr></thead>
              <tbody id="finPayoutsBody"></tbody>
            </table>
          </div>
        </div>

        <div class="fin-card" id="finPayoutHistoryCard" style="display:none;">
          <div class="section-head">
            <h2 id="finPayoutHistoryTitle">Payment History</h2>
            <button type="button" class="fin-btn ghost sm" onclick="document.getElementById('finPayoutHistoryCard').style.display='none';">Close</button>
          </div>
          <div class="fin-table-wrap">
            <table class="fin-table">
              <thead><tr><th>Date</th><th class="num">Amount</th><th>Provider</th><th>Status</th><th>Notes</th></tr></thead>
              <tbody id="finPayoutHistoryBody"></tbody>
            </table>
          </div>
        </div>

        <style>
          .fin-payout-tabs { display:flex; gap:0; border-bottom:2px solid var(--fin-border); margin:6px 0 10px; }
          .fin-payout-tab {
            background:none; border:none; border-bottom:2px solid transparent; margin-bottom:-2px;
            padding:7px 14px; font-size:.82rem; font-weight:600; color:var(--fin-muted); cursor:pointer;
          }
          .fin-payout-tab.active { color:var(--fin-teal); border-bottom-color:var(--fin-teal); }
          .fin-payout-search-results {
            border:1px solid var(--fin-border); border-radius:8px; margin-top:6px; max-height:180px; overflow:auto;
            background:var(--fin-card);
          }
          .fin-payout-search-results .fin-payout-result { padding:8px 10px; cursor:pointer; border-bottom:1px solid var(--fin-border); font-size:.85rem; }
          
          .fin-payout-search-results .fin-payout-result:last-child { border-bottom:0; }
        </style>

        <script>
          (function initFinPayouts() {
            var listEmpty = document.getElementById('finPayoutsEmpty');
            var listWrap = document.getElementById('finPayoutsTableWrap');
            var listBody = document.getElementById('finPayoutsBody');
            var countEl = document.getElementById('finPayoutsCount');
            var form = document.getElementById('finPayoutForm');
            var formIdInput = document.getElementById('finPayoutFormId');
            var errorEl = document.getElementById('finPayoutError');
            var cardSelect = document.getElementById('finPayoutCard');
            var noCardHint = document.getElementById('finPayoutNoCardHint');
            var frequencySelect = document.getElementById('finPayoutFrequency');
            var startDateInput = document.getElementById('finPayoutStartDate');
            var startDateLabel = document.getElementById('finPayoutStartDateLabel');
            var endDateField = document.getElementById('finPayoutEndDateField');
            var endDateInput = document.getElementById('finPayoutEndDate');
            var searchInput = document.getElementById('finRecipientSearch');
            var searchResults = document.getElementById('finRecipientResults');
            var selectedChip = document.getElementById('finRecipientSelected');
            var tabExisting = document.getElementById('finRecipientTabExisting');
            var tabNew = document.getElementById('finRecipientTabNew');
            var panelExisting = document.getElementById('finRecipientExistingPanel');
            var panelNew = document.getElementById('finRecipientNewPanel');
            var nameNewInput = document.getElementById('finRecipientNameNew');
            var emailNewInput = document.getElementById('finRecipientEmailNew');

            var selectedRecipientUserId = '';
            var recipientMode = 'existing';

            function esc(v) {
              return String(v == null ? '' : v).replace(/[&<>"']/g, function (c) {
                return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c];
              });
            }
            function freqLabel(f) { return { once: 'One time', weekly: 'Weekly', biweekly: 'Every 2 weeks', monthly: 'Monthly' }[f] || f; }
            function fmtDate(v) { if (!v) return '—'; try { return new Date(v).toLocaleDateString(); } catch (e) { return '—'; } }

            function switchRecipientTab(mode) {
              recipientMode = mode;
              tabExisting.classList.toggle('active', mode === 'existing');
              tabNew.classList.toggle('active', mode === 'new');
              panelExisting.style.display = mode === 'existing' ? '' : 'none';
              panelNew.style.display = mode === 'new' ? '' : 'none';
              // Only enforce required on whichever recipient path is active,
              // so switching tabs never blocks submission on hidden fields.
              nameNewInput.required = mode === 'new';
              emailNewInput.required = mode === 'new';
              if (mode === 'existing') { nameNewInput.value = ''; emailNewInput.value = ''; }
            }
            tabExisting.addEventListener('click', function () { switchRecipientTab('existing'); });
            tabNew.addEventListener('click', function () { switchRecipientTab('new'); });

            function toggleFrequencyFields() {
              var isOnce = frequencySelect.value === 'once';
              startDateLabel.textContent = isOnce ? 'Pay on *' : 'Starting *';
              endDateField.style.display = isOnce ? 'none' : '';
              if (isOnce) endDateInput.value = '';
            }
            frequencySelect.addEventListener('change', toggleFrequencyFields);

            var searchDebounce = null;
            searchInput.addEventListener('input', function () {
              clearTimeout(searchDebounce);
              var q = searchInput.value.trim();
              if (!q) { searchResults.style.display = 'none'; return; }
              searchDebounce = setTimeout(function () {
                fetch('/account/settings/payouts/recipients/search?q=' + encodeURIComponent(q))
                  .then(function (r) { return r.json(); })
                  .then(function (data) {
                    var users = data.users || [];
                    searchResults.style.display = 'block';
                    searchResults.innerHTML = users.length
                      ? users.map(function (u) {
                          return '<div class="fin-payout-result" data-user-id="' + u.userId + '" data-name="' + esc(u.name) + '" data-email="' + esc(u.email) + '">' +
                            esc(u.name) + ' <span style="color:var(--fin-muted);">' + esc(u.email) + ' · ' + esc(u.accountType || '') + '</span></div>';
                        }).join('')
                      : '<div style="padding:8px 10px;color:var(--fin-muted);">No matching users found.</div>';
                  })
                  .catch(function () { searchResults.style.display = 'none'; });
              }, 250);
            });
            searchResults.addEventListener('click', function (evt) {
              var row = evt.target.closest('.fin-payout-result');
              if (!row) return;
              selectedRecipientUserId = row.dataset.userId;
              selectedChip.style.display = 'inline-flex';
              selectedChip.textContent = row.dataset.name + ' (' + row.dataset.email + ')';
              searchResults.style.display = 'none';
              searchInput.value = '';
            });

            function resetForm() {
              form.reset();
              formIdInput.value = '';
              errorEl.textContent = '';
              selectedRecipientUserId = '';
              selectedChip.style.display = 'none';
              searchInput.value = '';
              searchResults.style.display = 'none';
              switchRecipientTab('existing');
              frequencySelect.value = 'once';
              toggleFrequencyFields();
              startDateInput.value = new Date().toISOString().slice(0, 10);
            }

            function renderCardOptions(cards) {
              if (!cards.length) {
                cardSelect.innerHTML = '';
                cardSelect.disabled = true;
                noCardHint.style.display = 'block';
                return;
              }
              cardSelect.disabled = false;
              noCardHint.style.display = 'none';
              cardSelect.innerHTML = cards.map(function (c) {
                return '<option value="' + c.id + '">' + esc(c.card_type || c.provider) + ' •••• ' + esc(c.last4 || '') + (c.display_name ? ' — ' + esc(c.display_name) : '') + '</option>';
              }).join('');
            }

            function statusBadge(status) {
              var map = { active: 'active', paused: 'pending', cancelled: 'overdue', completed: 'paid' };
              return '<span class="badge ' + (map[status] || 'active') + '">' + esc(status) + '</span>';
            }

            function renderPayouts(payouts) {
              countEl.textContent = payouts.length + ' payout' + (payouts.length === 1 ? '' : 's');
              if (!payouts.length) {
                listEmpty.style.display = '';
                listWrap.style.display = 'none';
                return;
              }
              listEmpty.style.display = 'none';
              listWrap.style.display = '';
              listBody.innerHTML = payouts.map(function (p) {
                var actions = '<div class="fin-actions-cell" style="justify-content:flex-start;">' +
                  '<button type="button" class="fin-btn sm finPayoutPayNow" data-id="' + p.payout_id + '"' + (p.status === 'cancelled' ? ' disabled' : '') + '>Pay Now</button>' +
                  (p.status === 'active' ? '<button type="button" class="fin-btn ghost sm finPayoutPause" data-id="' + p.payout_id + '">Pause</button>' : '') +
                  (p.status === 'paused' ? '<button type="button" class="fin-btn ghost sm finPayoutResume" data-id="' + p.payout_id + '">Resume</button>' : '') +
                  '<button type="button" class="fin-btn ghost sm finPayoutHistory" data-id="' + p.payout_id + '" data-name="' + esc(p.name) + '">History</button>' +
                  '<button type="button" class="fin-btn danger sm finPayoutDelete" data-id="' + p.payout_id + '">Delete</button>' +
                  '</div>';
                return '<tr>' +
                  '<td><strong>' + esc(p.name) + '</strong>' + (p.last_error ? '<div style="color:var(--fin-red);font-size:.72rem;margin-top:3px;">' + esc(p.last_error) + '</div>' : '') + '</td>' +
                  '<td>' + esc(p.recipient_name) + '<div style="color:var(--fin-muted);font-size:.72rem;">' + esc(p.recipient_email) + '</div></td>' +
                  '<td class="num fin-money-neutral">' + esc(p.currency) + ' ' + Number(p.amount).toFixed(2) + '</td>' +
                  '<td>' + freqLabel(p.frequency) + '</td>' +
                  '<td>' + esc(p.card_brand || p.card_provider || '—') + ' •••• ' + esc(p.card_last4 || '') + '</td>' +
                  '<td class="fin-date-muted">' + (p.next_run_at ? fmtDate(p.next_run_at) : '—') + '</td>' +
                  '<td>' + statusBadge(p.status) + '</td>' +
                  '<td>' + actions + '</td>' +
                  '</tr>';
              }).join('');
            }

            function loadPayouts() {
              fetch('/account/settings/payouts.json')
                .then(function (r) { return r.json(); })
                .then(function (data) {
                  if (!data.success) throw new Error(data.message || 'Failed to load payouts.');
                  renderCardOptions(data.cards || []);
                  renderPayouts(data.payouts || []);
                })
                .catch(function (err) {
                  listEmpty.style.display = '';
                  listEmpty.querySelector('h3').textContent = err.message || 'Unable to load payouts.';
                });
            }

            form.addEventListener('submit', function (evt) {
              evt.preventDefault();
              errorEl.textContent = '';
              if (recipientMode === 'existing' && !selectedRecipientUserId) {
                errorEl.textContent = "Search for and select an existing user, or switch to 'New person'.";
                return;
              }
              if (!cardSelect.value) {
                errorEl.textContent = 'Add a saved card before creating a payout.';
                return;
              }
              var payload = {
                name: document.getElementById('finPayoutName').value,
                amount: document.getElementById('finPayoutAmount').value,
                currency: document.getElementById('finPayoutCurrency').value,
                card_id: cardSelect.value,
                frequency: frequencySelect.value,
                start_date: startDateInput.value,
                end_date: endDateInput.value || undefined,
              };
              if (recipientMode === 'existing') {
                payload.recipient_user_id = selectedRecipientUserId;
              } else {
                payload.recipient_name = nameNewInput.value;
                payload.recipient_email = emailNewInput.value;
              }

              var payoutId = formIdInput.value;
              var submitBtn = document.getElementById('finPayoutSubmit');
              submitBtn.disabled = true;
              submitBtn.textContent = 'Saving…';
              fetch(payoutId ? '/account/settings/payouts/' + payoutId : '/account/settings/payouts', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload),
              })
                .then(function (r) { return r.json().then(function (data) { return { ok: r.ok, data: data }; }); })
                .then(function (res) {
                  if (!res.ok || !res.data.success) throw new Error(res.data.message || 'Unable to save payout.');
                  resetForm();
                  document.getElementById('acc-create-payout').classList.remove('open');
                  loadPayouts();
                })
                .catch(function (err) { errorEl.textContent = err.message; })
                .finally(function () {
                  submitBtn.disabled = false;
                  submitBtn.textContent = 'Save Payout';
                });
            });

            listBody.addEventListener('click', function (evt) {
              var btn = evt.target.closest('button[data-id]');
              if (!btn) return;
              var payoutId = btn.dataset.id;

              if (btn.classList.contains('finPayoutPayNow')) {
                if (!confirm('Charge the saved card for this payout right now?')) return;
                btn.disabled = true;
                btn.textContent = 'Processing…';
                fetch('/account/settings/payouts/' + payoutId + '/pay-now', { method: 'POST' })
                  .then(function (r) { return r.json().then(function (data) { return { ok: r.ok, data: data }; }); })
                  .then(function (res) {
                    if (!res.ok || !res.data.success) throw new Error(res.data.message || 'Charge failed.');
                    loadPayouts();
                  })
                  .catch(function (err) { alert(err.message); btn.disabled = false; btn.textContent = 'Pay Now'; });
                return;
              }

              if (btn.classList.contains('finPayoutPause') || btn.classList.contains('finPayoutResume')) {
                var status = btn.classList.contains('finPayoutPause') ? 'paused' : 'active';
                fetch('/account/settings/payouts/' + payoutId, {
                  method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ status: status }),
                })
                  .then(function (r) { return r.json().then(function (data) { return { ok: r.ok, data: data }; }); })
                  .then(function (res) { if (!res.ok || !res.data.success) throw new Error(res.data.message); loadPayouts(); })
                  .catch(function (err) { alert(err.message); });
                return;
              }

              if (btn.classList.contains('finPayoutDelete')) {
                if (!confirm('Delete this payout? This cannot be undone.')) return;
                fetch('/account/settings/payouts/' + payoutId + '/delete', { method: 'POST' })
                  .then(function (r) { return r.json().then(function (data) { return { ok: r.ok, data: data }; }); })
                  .then(function (res) { if (!res.ok || !res.data.success) throw new Error(res.data.message); loadPayouts(); })
                  .catch(function (err) { alert(err.message); });
                return;
              }

              if (btn.classList.contains('finPayoutHistory')) {
                fetch('/account/settings/payouts/' + payoutId + '/transactions')
                  .then(function (r) { return r.json(); })
                  .then(function (data) {
                    var rows = data.transactions || [];
                    document.getElementById('finPayoutHistoryTitle').textContent = 'Payment History — ' + btn.dataset.name;
                    document.getElementById('finPayoutHistoryBody').innerHTML = rows.length
                      ? rows.map(function (t) {
                          return '<tr><td>' + fmtDate(t.created_at) + '</td><td class="num">' + esc(t.currency) + ' ' + Number(t.amount).toFixed(2) + '</td><td>' + esc(t.provider) + '</td><td>' + (t.status === 'succeeded' ? '<span class="badge paid">Succeeded</span>' : '<span class="badge overdue">Failed</span>') + '</td><td style="color:var(--fin-red);">' + esc(t.failure_reason || '') + '</td></tr>';
                        }).join('')
                      : '<tr><td colspan="5" style="color:var(--fin-muted);">No payments recorded yet.</td></tr>';
                    document.getElementById('finPayoutHistoryCard').style.display = '';
                    document.getElementById('finPayoutHistoryCard').scrollIntoView({ behavior: 'smooth', block: 'nearest' });
                  })
                  .catch(function () { alert('Unable to load payment history.'); });
                return;
              }
            });

            resetForm();
            loadPayouts();
          })();
        </script>
      <% } %>

      <% if (sec === 'settings') { %>
        <div class="fin-card">
          <div class="section-head">
            <h2>How PayGira works for your school</h2>
          </div>
          <p class="fin-settings-line">
            Bills are in <strong><%= currentCurrency %></strong><% if (financeCountry) { %> (<%= financeCountry %>)<% } %>. The currency follows your school's country, set in
            <a href="/account/settings?section=customize" target="_top">Settings, Customize School</a>.
            <% if (financeCurrency && financeCurrency.code !== 'USD' && financeCurrency.usdToCurrencyRate) { %>For reference, 1 USD is about <%= Number(financeCurrency.usdToCurrencyRate).toFixed(4) %> <%= financeCurrency.code %>.<% } %>
          </p>
          <p class="fin-settings-line">
            Where the money goes: your school's payout accounts are in
            <a href="/account/settings?section=billing" target="_top">Settings, Billing &amp; Plan</a>. A bill can only be paid online once one is switched on.
          </p>
          <form class="fin-form" method="POST" action="/account/settings/finance/psp/general" style="margin-top:14px;">
            <div class="fin-field">
              <label for="finInvoiceNote">Note at the bottom of every invoice</label>
              <textarea name="invoice_footer" id="finInvoiceNote" rows="2" maxlength="300" placeholder="e.g. Thank you for trusting us with your child's education."><%= (pspSettings && pspSettings.invoice_footer) || '' %></textarea>
              <small style="color:var(--fin-muted);font-size:.72rem;">Optional. Parents see it on each invoice.</small>
            </div>
            <button class="fin-btn sm primary">Save</button>
          </form>
        </div>
      <% } %>

      <% if (sec === 'arrears') { %>
        <%
          const arrears = arrearsData || { filters: { schoolYearIds: [], termIds: [], classIds: [], billIds: [], statuses: ['overdue','partial','defaulted','never_paid'], dueFrom: '', dueTo: '', minOutstanding: 0, paymentMethodFilter: 'all', emailStatusFilter: 'all', search: '' }, summary: {}, students: [], recipientReview: { recipients: [], missingGuardian: 0, missingEmail: 0 } };
          const arrearsFilters = arrears.filters || {};
          const recipientReview = arrears.recipientReview || { recipients: [], missingGuardian: 0, missingEmail: 0 };
          // How an unpaid bill is described, in everyday words.
          const _owedWords = { overdue: 'Overdue', partial: 'Part paid', defaulted: '30+ days late', never_paid: 'Nothing paid' };
        %>
        <div class="arrears-shell">
          <div class="fin-stats">
            <div class="stat red"><div class="label">Overdue in total</div><div class="value"><%= fmt(arrears.summary.totalOutstanding || 0) %></div><div class="sub"><%= arrears.summary.count || 0 %> student<%= Number(arrears.summary.count || 0) === 1 ? '' : 's' %></div></div>
            <div class="stat gold"><div class="label">Paid towards them</div><div class="value"><%= fmt(arrears.summary.partialPayments || 0) %></div><div class="sub">Part payments so far</div></div>
            <div class="stat"><div class="label">Nothing paid yet</div><div class="value"><%= fmt(arrears.summary.neverPaidOutstanding || 0) %></div><div class="sub"><%= arrears.summary.overdueThirtyPlus || 0 %> student(s) 30 or more days late</div></div>
            <div class="stat green"><div class="label">Parents with an email</div><div class="value"><%= arrears.summary.hasEmail || 0 %></div><div class="sub"><%= arrears.summary.noEmail || 0 %> without email, <%= arrears.summary.withSavedCard || 0 %> with saved card</div></div>
          </div>

          <div class="arrears-top">
            <div class="fin-card arrears-filter-card">
              <div class="section-head">
                <h2>Narrow the list</h2>
              </div>
              <div class="arrears-collapse" data-arrears-collapse>
                <button type="button" class="arrears-collapse-toggle" data-arrears-collapse-toggle aria-expanded="false">
                  <span class="label">Filters</span>
                  <span class="chev">▾</span>
                </button>
                <div class="arrears-collapse-body">
              <form method="GET" action="/account/settings/finance/arrears" id="arrearsFilterForm" class="fin-form" style="gap:14px;">
                <div class="arrears-filter-grid">
                  <div class="fin-field">
                    <label>School Year</label>
                    <div class="arrears-multiselect" data-arrears-multiselect>
                      <button type="button" class="arrears-multiselect-trigger" data-arrears-trigger>
                        <span class="arrears-multiselect-label" data-arrears-summary>School year</span>
                        <span class="arrears-multiselect-meta" data-arrears-meta>Pick</span>
                      </button>
                      <div class="arrears-multiselect-menu">
                        <div class="arrears-multiselect-head">
                          <strong>School Year</strong>
                          <div class="arrears-multiselect-actions">
                            <button type="button" class="arrears-multiselect-link" data-arrears-select-all>Select all</button>
                            <button type="button" class="arrears-multiselect-link" data-arrears-clear>Clear</button>
                          </div>
                        </div>
                        <div class="arrears-multiselect-list">
                          <% (refs.years || []).forEach(y => { %>
                            <label class="arrears-multiselect-option <%= (arrearsFilters.schoolYearIds || []).includes(String(y.school_year_id)) ? 'checked' : '' %>">
                              <input type="checkbox" name="schoolYearIds" value="<%= y.school_year_id %>" <%= (arrearsFilters.schoolYearIds || []).includes(String(y.school_year_id)) ? 'checked' : '' %>>
                              <span class="arrears-multiselect-option-copy">
                                <strong><%= y.name %><%= y.current ? ' (current)' : '' %></strong>
                              </span>
                            </label>
                          <% }) %>
                        </div>
                      </div>
                    </div>
                  </div>
                  <div class="fin-field">
                    <label>Term</label>
                    <div class="arrears-multiselect" data-arrears-multiselect>
                      <button type="button" class="arrears-multiselect-trigger" data-arrears-trigger>
                        <span class="arrears-multiselect-label" data-arrears-summary>Select year first</span>
                        <span class="arrears-multiselect-meta" data-arrears-meta>Year first</span>
                      </button>
                      <div class="arrears-multiselect-menu">
                        <div class="arrears-multiselect-head">
                          <strong>Term</strong>
                          <div class="arrears-multiselect-actions">
                            <button type="button" class="arrears-multiselect-link" data-arrears-select-all>Select all</button>
                            <button type="button" class="arrears-multiselect-link" data-arrears-clear>Clear</button>
                          </div>
                        </div>
                        <div class="arrears-multiselect-list">
                          <% (refs.terms || []).forEach(term => { %>
                            <label class="arrears-multiselect-option <%= (arrearsFilters.termIds || []).includes(String(term.term_id)) ? 'checked' : '' %>" data-school-year-id="<%= term.school_year_id || '' %>">
                              <input type="checkbox" name="termIds" value="<%= term.term_id %>" data-school-year-id="<%= term.school_year_id || '' %>" <%= (arrearsFilters.termIds || []).includes(String(term.term_id)) ? 'checked' : '' %>>
                              <span class="arrears-multiselect-option-copy">
                                <strong><%= term.name %><%= term.current ? ' (current)' : '' %></strong>
                              </span>
                            </label>
                          <% }) %>
                        </div>
                      </div>
                    </div>
                  </div>
                  <div class="fin-field">
                    <label>Class</label>
                    <div class="arrears-multiselect" data-arrears-multiselect>
                      <button type="button" class="arrears-multiselect-trigger" data-arrears-trigger>
                        <span class="arrears-multiselect-label" data-arrears-summary>Class</span>
                        <span class="arrears-multiselect-meta" data-arrears-meta>Optional</span>
                      </button>
                      <div class="arrears-multiselect-menu">
                        <div class="arrears-multiselect-head">
                          <strong>Class</strong>
                          <div class="arrears-multiselect-actions">
                            <button type="button" class="arrears-multiselect-link" data-arrears-select-all>Select all</button>
                            <button type="button" class="arrears-multiselect-link" data-arrears-clear>Clear</button>
                          </div>
                        </div>
                        <div class="arrears-multiselect-list">
                          <% (refs.classes || []).forEach(c => { %>
                            <label class="arrears-multiselect-option <%= (arrearsFilters.classIds || []).includes(String(c.class_id)) ? 'checked' : '' %>" data-school-year-ids="<%= (c.school_year_ids || []).join(',') %>" data-term-ids="<%= (c.term_ids || []).join(',') %>">
                              <input type="checkbox" name="classIds" value="<%= c.class_id %>" data-school-year-ids="<%= (c.school_year_ids || []).join(',') %>" data-term-ids="<%= (c.term_ids || []).join(',') %>" <%= (arrearsFilters.classIds || []).includes(String(c.class_id)) ? 'checked' : '' %>>
                              <span class="arrears-multiselect-option-copy">
                                <strong><%= c.class_name %></strong>
                              </span>
                            </label>
                          <% }) %>
                        </div>
                      </div>
                    </div>
                  </div>
                  <div class="fin-field">
                    <label>Bill</label>
                    <div class="arrears-multiselect" data-arrears-multiselect>
                      <button type="button" class="arrears-multiselect-trigger" data-arrears-trigger>
                        <span class="arrears-multiselect-label" data-arrears-summary>Bill</span>
                        <span class="arrears-multiselect-meta" data-arrears-meta>Optional</span>
                      </button>
                      <div class="arrears-multiselect-menu">
                        <div class="arrears-multiselect-head">
                          <strong>Bill</strong>
                          <div class="arrears-multiselect-actions">
                            <button type="button" class="arrears-multiselect-link" data-arrears-select-all>Select all</button>
                            <button type="button" class="arrears-multiselect-link" data-arrears-clear>Clear</button>
                          </div>
                        </div>
                        <div class="arrears-multiselect-list">
                          <% (bills || []).forEach(bill => { %>
                            <label class="arrears-multiselect-option <%= (arrearsFilters.billIds || []).includes(String(bill.bill_id)) ? 'checked' : '' %>">
                              <input type="checkbox" name="billIds" value="<%= bill.bill_id %>" <%= (arrearsFilters.billIds || []).includes(String(bill.bill_id)) ? 'checked' : '' %>>
                              <span class="arrears-multiselect-option-copy">
                                <strong><%= bill.title %></strong>
                                <span><%= bill.bill_type ? String(bill.bill_type).replace(/_/g, ' ') : 'Fee item' %></span>
                              </span>
                            </label>
                          <% }) %>
                        </div>
                      </div>
                    </div>
                  </div>
                </div>

                <div class="arrears-checkbox-row">
                  <% ['overdue','partial','defaulted','never_paid'].forEach(status => { %>
                    <label class="arrears-checkbox">
                      <input type="checkbox" name="statuses" value="<%= status %>" <%= (arrearsFilters.statuses || []).includes(status) ? 'checked' : '' %>>
                      <span><%= status === 'never_paid' ? 'Never Paid' : (status.charAt(0).toUpperCase() + status.slice(1)) %></span>
                    </label>
                  <% }) %>
                </div>

                <div class="arrears-filter-grid">
                  <div class="fin-field"><label>Due Date From</label><input type="date" name="dueFrom" value="<%= arrearsFilters.dueFrom || '' %>"></div>
                  <div class="fin-field"><label>Due Date To</label><input type="date" name="dueTo" value="<%= arrearsFilters.dueTo || '' %>"></div>
                  <div class="fin-field"><label>Owes at least</label><input type="number" min="0" step="0.01" name="minOutstanding" value="<%= arrearsFilters.minOutstanding || '' %>" placeholder="0.00"></div>
                  <div class="fin-field"><label>Search</label><input type="search" name="search" value="<%= arrearsFilters.search || '' %>" placeholder="Student, parent or bill"></div>
                </div>

                <div class="arrears-filter-grid">
                  <div class="fin-field">
                    <label>Saved card</label>
                    <select name="paymentMethodFilter">
                      <option value="all" <%= (arrearsFilters.paymentMethodFilter || 'all') === 'all' ? 'selected' : '' %>>All</option>
                      <option value="saved_card" <%= arrearsFilters.paymentMethodFilter === 'saved_card' ? 'selected' : '' %>>Saved card on file</option>
                      <option value="no_saved_card" <%= arrearsFilters.paymentMethodFilter === 'no_saved_card' ? 'selected' : '' %>>No saved card</option>
                    </select>
                  </div>
                  <div class="fin-field">
                    <label>Parent's email</label>
                    <select name="emailStatusFilter">
                      <option value="all" <%= (arrearsFilters.emailStatusFilter || 'all') === 'all' ? 'selected' : '' %>>All</option>
                      <option value="has_email" <%= arrearsFilters.emailStatusFilter === 'has_email' ? 'selected' : '' %>>Has email</option>
                      <option value="no_email" <%= arrearsFilters.emailStatusFilter === 'no_email' ? 'selected' : '' %>>No email</option>
                    </select>
                  </div>
                  <div class="fin-field arrears-filter-actions" style="grid-column:span 2;justify-content:flex-end;">
                    <button type="submit" class="fin-btn sm primary">Apply</button>
                    <a href="/account/settings/finance/arrears" class="fin-btn sm quiet">Reset</a>
                  </div>
                </div>
              </form>
                </div>
              </div>
            </div>

            <div class="fin-card arrears-filter-card">
              <div class="section-head">
                <h2>Saved filters</h2>
                <span class="fin-section-count"><%= (arrearsPresets || []).length %> saved</span>
              </div>
              <div class="arrears-collapse" data-arrears-collapse>
                <button type="button" class="arrears-collapse-toggle" data-arrears-collapse-toggle aria-expanded="false">
                  <span class="label">Save these filters, and who can be emailed</span>
                  <span class="chev">▾</span>
                </button>
                <div class="arrears-collapse-body">
              <form method="POST" action="/account/settings/finance/arrears/presets" class="fin-form" id="arrearsPresetForm">
                <div class="fin-field">
                  <label>Name these filters</label>
                  <input type="text" name="preset_name" placeholder="e.g. Fall tuition, 30 days late" required>
                </div>
                <input type="hidden" name="schoolYearIds" value="">
                <button type="submit" class="fin-btn sm primary">Save these filters</button>
              </form>
              <% if ((arrearsPresets || []).length) { %>
                <div class="arrears-pill-list">
                  <% arrearsPresets.forEach(preset => { %>
                    <button type="button" class="arrears-pill" data-arrears-preset='<%- JSON.stringify(preset.filters || {}) %>'><%= preset.name %></button>
                  <% }) %>
                </div>
              <% } else { %>
                <p class="arrears-note">Save a set of filters you use often, to open it again with one click.</p>
              <% } %>
              <div class="fin-card" style="padding:16px;background:rgba(15,23,42,.02);">
                <div class="section-head" style="margin-bottom:10px;">
                  <h2>Who can be emailed</h2>
                  <span class="fin-section-count"><%= recipientReview.recipients.length %> families</span>
                </div>
                <div class="arrears-detail-summary" style="grid-template-columns:repeat(3,minmax(0,1fr));">
                  <div class="arrears-detail-stat"><div class="label">Ready</div><div class="value"><%= recipientReview.recipients.filter(r => r.status === 'ready').length %></div></div>
                  <div class="arrears-detail-stat"><div class="label">No parent on file</div><div class="value"><%= recipientReview.missingGuardian %></div></div>
                  <div class="arrears-detail-stat"><div class="label">No email on file</div><div class="value"><%= recipientReview.missingEmail %></div></div>
                </div>
              </div>
                </div>
              </div>
            </div>
          </div>

          <div class="fin-card">
            <div class="arrears-toolbar" style="margin-bottom:16px;">
              <div class="arrears-toolbar-left">
                <div class="section-head" style="margin:0;">
                  <h2>Students with overdue balances</h2>
                  <span class="fin-section-count"><%= arrears.students.length %> student<%= arrears.students.length === 1 ? '' : 's' %></span>
                </div>
              </div>
              <div class="arrears-toolbar-right">
                <button type="button" class="fin-btn sm quiet" onclick="openArrearsReportModal()">Save a report</button>
                <button type="button" class="fin-btn sm" onclick="openArrearsEmailAll()">Email all parents</button>
              </div>
            </div>

            <% if (arrears.students.length) { %>
              <div class="fin-table-wrap fin-scroll" id="finArrearsWrap">
                <table class="fin-table arrears-report-table" id="arrearsTable">
                  <thead>
                    <tr>
                      <th style="width:44px;"><input type="checkbox" id="arrearsSelectAll" onclick="toggleAllArrears(this)"></th>
                      <th>Student <button type="button" class="fin-sort-btn" data-fin-sort-index="1" data-fin-default="true" aria-label="Sort students Z to A"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 12 12" aria-hidden="true" focusable="false"><path fill="currentColor" d="M10 5H2a.5.5 0 0 1-.46-.31.47.47 0 0 1 .11-.54L5.29.5A1 1 0 0 1 6.7.5l3.65 3.65a.49.49 0 0 1 .11.54A.51.51 0 0 1 10 5z"></path><path fill="currentColor" d="M2 7a.5.5 0 0 0-.46.31.47.47 0 0 0 .11.54L5.3 11.5a1 1 0 0 0 1.41 0l3.65-3.65a.49.49 0 0 0 .11-.54A.53.53 0 0 0 10 7z"></path></svg></button></th>
                      <th>Parent <button type="button" class="fin-sort-btn" data-fin-sort-index="2" aria-label="Sort parents Z to A"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 12 12" aria-hidden="true" focusable="false"><path fill="currentColor" d="M10 5H2a.5.5 0 0 1-.46-.31.47.47 0 0 1 .11-.54L5.29.5A1 1 0 0 1 6.7.5l3.65 3.65a.49.49 0 0 1 .11.54A.51.51 0 0 1 10 5z"></path><path fill="currentColor" d="M2 7a.5.5 0 0 0-.46.31.47.47 0 0 0 .11.54L5.3 11.5a1 1 0 0 0 1.41 0l3.65-3.65a.49.49 0 0 0 .11-.54A.53.53 0 0 0 10 7z"></path></svg></button></th>
                      <th>Owes</th>
                      <th>Days late</th>
                      <th>Status</th>
                      <th></th>
                    </tr>
                  </thead>
                  <tbody>
                    <% arrears.students.forEach(student => { %>
                      <tr>
                        <td><input type="checkbox" class="arrears-select" value="<%= student.student_id %>" data-student="<%- JSON.stringify({ id: student.student_id, name: student.student_name }) %>"></td>
                        <td>
                          <div class="arrears-student-cell">
                            <div class="arrears-avatar">
                              <img src="<%= resolveAvatar(student.image_url) %>" alt="<%= student.student_name %>" style="width:100%;height:100%;object-fit:cover;" onerror="this.onerror=null;this.src='<%= profilePlaceholder %>';">
                            </div>
                            <div class="arrears-meta">
                              <strong><%= student.student_name %></strong>
                              <span><%= student.class_name || 'No class' %> · <%= student.bills.length %> bill<%= student.bills.length === 1 ? '' : 's' %></span>
                            </div>
                          </div>
                        </td>
                        <td>
                          <div class="arrears-contact">
                            <strong><%= student.guardian_name || 'No parent on file' %></strong>
                            <span><%= student.guardian_email || student.guardian_phone || 'No email or phone yet' %></span>
                          </div>
                        </td>
                        <td>
                          <strong><%= student.outstanding_display %></strong>
                          <div class="arrears-note">Billed <%= student.total_billed_display %> · Paid <%= student.total_paid_display %><% if (Number(student.student_credit || 0) > 0) { %> · Credit <%= student.credit_display %><% } %></div>
                        </td>
                        <td><%= student.max_days_overdue || 0 %></td>
                        <td><span class="arrears-status <%= student.primary_status %>"><%= _owedWords[student.primary_status] || student.primary_status %></span><% if (student.has_saved_card) { %><div class="arrears-note">Card on file</div><% } %></td>
                        <td>
                          <div class="arrears-toolbar-right">
                            <button type="button" class="fin-btn sm quiet" onclick="toggleArrearsDetails('<%= student.student_id %>')">Bills</button>
                            <button type="button" class="fin-btn sm quiet" onclick="openArrearsEmailDrawer('<%= student.student_id %>', true)">Email</button>
                            <button type="button" class="fin-btn sm quiet" onclick="openArrearsNoteModal('<%= student.student_id %>', <%- JSON.stringify(student.student_name) %>)">Note</button>
                          </div>
                        </td>
                      </tr>
                      <tr id="arrears-detail-<%= student.student_id %>" style="display:none;">
                        <td colspan="7">
                          <div class="arrears-detail-card">
                            <div class="arrears-detail-summary">
                              <div class="arrears-detail-stat"><div class="label">Owes</div><div class="value"><%= student.outstanding_display %></div></div>
                              <div class="arrears-detail-stat"><div class="label">Paid</div><div class="value"><%= student.total_paid_display %></div></div>
                              <div class="arrears-detail-stat"><div class="label">Credit</div><div class="value"><%= student.credit_display %></div></div>
                              <div class="arrears-detail-stat"><div class="label">Latest</div><div class="value"><%= student.max_days_overdue %> day<%= Number(student.max_days_overdue) === 1 ? '' : 's' %> late</div></div>
                            </div>
                            <div class="fin-table-wrap">
                              <table class="fin-table">
                                <thead>
                                  <tr>
                                    <th>Bill</th>
                                    <th>Term</th>
                                    <th>Due</th>
                                    <th>Billed</th>
                                    <th>Paid</th>
                                    <th>Owes</th>
                                    <th>Status</th>
                                  </tr>
                                </thead>
                                <tbody>
                                  <% student.bills.forEach(bill => { %>
                                    <tr>
                                      <td><strong><%= bill.bill_title %></strong></td>
                                      <td><%= bill.year_label %> · <%= bill.term_name %></td>
                                      <td><%= bill.due_date ? (typeof formatDisplayDate === 'function' ? formatDisplayDate(bill.due_date) : new Date(bill.due_date).toLocaleDateString()) : '—' %></td>
                                      <td><%= bill.total_billed_display %></td>
                                      <td><%= bill.paid_display %></td>
                                      <td><%= bill.outstanding_display %></td>
                                      <td><span class="arrears-status <%= bill.status %>"><%= _owedWords[bill.status] || bill.status %></span></td>
                                    </tr>
                                  <% }) %>
                                </tbody>
                              </table>
                            </div>
                          </div>
                        </td>
                      </tr>
                    <% }) %>
                  </tbody>
                </table>
              </div>
              <div class="fin-pagebar" id="finArrearsPagebar" hidden>
                <div class="fin-pagebar-left">
                  <span class="fin-pagebar-label">Show per page</span>
                  <select class="fin-pagebar-select" data-fin-pagesize>
                    <option value="20">20</option><option value="50">50</option><option value="70">70</option><option value="100">100</option><option value="200">200</option>
                  </select>
                </div>
                <div class="fin-pagebar-right">
                  <button type="button" class="fin-page-btn" data-fin-prev>Prev</button>
                  <span class="fin-page-info" data-fin-info>1/1</span>
                  <button type="button" class="fin-page-btn" data-fin-next>Next</button>
                </div>
              </div>
            <% } else { %>
              <div class="empty-state">
                
                <h3>Nothing overdue</h3>
                <p>No student has an overdue balance with these filters.</p>
              </div>
            <% } %>

            <div class="fin-actions arrears-sticky-bar" id="arrearsBulkBar">
              <div class="arrears-toolbar-left"><strong id="arrearsSelectedCount">0 selected</strong><span class="arrears-note">Tick students to email their parents or save a report of them.</span></div>
              <div class="arrears-toolbar-right">
                <button type="button" class="fin-btn sm primary" onclick="openArrearsEmailDrawer()">Email their parents</button>
                <button type="button" class="fin-btn sm quiet" onclick="openArrearsReportModal()">Save a report</button>
                <button type="button" class="fin-btn sm quiet" onclick="clearArrearsSelection()">Clear</button>
              </div>
            </div>
          </div>

          <div class="fin-card">
            <div class="section-head">
              <h2>Saved reports</h2>
              <span class="fin-section-count"><%= (arrearsReports || []).length %> saved</span>
            </div>
            <% if ((arrearsReports || []).length) { %>
              <div class="fin-table-wrap">
                <table class="fin-table arrears-report-table">
                  <thead>
                    <tr><th>Report</th><th>Saved</th><th>Students</th><th>Owed</th><th>File</th><th></th></tr>
                  </thead>
                  <tbody>
                    <% arrearsReports.forEach(report => { %>
                      <tr>
                        <td><strong><%= report.title %></strong><div class="arrears-note">By <%= report.generated_by_name || 'a member of staff' %></div></td>
                        <td><%= new Date(report.created_at).toLocaleString() %></td>
                        <td><%= report.record_count %></td>
                        <td><%= fmt(report.total_outstanding || 0) %></td>
                        <td><%= String(report.format || 'pdf').toUpperCase() %></td>
                        <td>
                          <div class="arrears-toolbar-right" style="justify-content:flex-end;">
                            <a href="/account/settings/finance/arrears/reports/<%= report.report_id %>/view" target="_blank" rel="noopener" class="fin-btn sm">View</a>
                            <a href="/account/settings/finance/arrears/reports/<%= report.report_id %>/download?format=<%= (report.format || 'pdf').toLowerCase() === 'csv' ? 'csv' : 'pdf' %>" class="fin-btn sm">Download</a>
                            <form method="POST" action="/account/settings/finance/arrears/reports/<%= report.report_id %>/delete" onsubmit="return confirm('Delete this saved report?');">
                              <button type="submit" class="fin-btn sm danger">Delete</button>
                            </form>
                          </div>
                        </td>
                      </tr>
                    <% }) %>
                  </tbody>
                </table>
              </div>
            <% } else { %>
              <div class="empty-state" style="padding:34px 20px;">
                
                <h3>No saved reports yet</h3>
                <p>Use <b>Save a report</b> above to keep a PDF or spreadsheet of who owes what today.</p>
              </div>
            <% } %>
          </div>
        </div>

        <div class="fin-modal" id="arrearsReportModal">
          <div class="fin-modal-content" style="max-width:720px;">
            <div class="fin-modal-head"><h3>Save a report of overdue balances</h3><button class="fin-modal-close" type="button" onclick="closeArrearsReportModal()">&times;</button></div>
            <form method="POST" action="/account/settings/finance/arrears/reports" class="fin-form" id="arrearsReportForm">
              <div class="fin-row">
                <div class="fin-field"><label>Report name</label><input type="text" name="report_title" value="Overdue balances" required></div>
                <div class="fin-field"><label>Period</label><input type="text" name="report_period" placeholder="e.g. Term 2 2026"></div>
              </div>
              <div class="fin-row">
                <div class="fin-field"><label>Format</label><select name="report_format"><option value="pdf">PDF</option><option value="csv">CSV</option></select></div>
                <div class="fin-field"><label>Include</label><select name="include_sections" multiple size="4"><option value="summary" selected>Summary</option><option value="rows" selected>Student rows</option><option value="bill_breakdown" selected>Bill breakdown</option><option value="email_readiness">Email readiness</option></select></div>
              </div>
              <div class="fin-field"><label>Notes</label><textarea name="report_notes" rows="3" placeholder="Anything to remember about this list."></textarea></div>
              <div class="arrears-checkbox-row">
                <label class="arrears-checkbox"><input type="checkbox" name="save_to_library" checked> Keep it under Saved reports</label>
                <label class="arrears-checkbox"><input type="checkbox" name="download_immediately"> Download it now</label>
              </div>
              <input type="hidden" name="selected_student_ids" id="arrearsReportSelectedIds">
              <div class="arrears-filter-payload"></div>
              <button type="submit" class="fin-btn sm primary">Save report</button>
            </form>
          </div>
        </div>

        <div class="fin-modal" id="arrearsEmailModal">
          <div class="fin-modal-content" style="max-width:820px;">
            <div class="fin-modal-head"><h3>Email parents</h3><button class="fin-modal-close" type="button" onclick="closeArrearsEmailDrawer()">&times;</button></div>
            <form method="POST" action="/account/settings/finance/arrears/email" class="fin-form" id="arrearsEmailForm">
              <div class="fin-row">
                <div class="fin-field"><label>Subject</label><input type="text" name="subject" value="Outstanding Balance Notice — {Student Name}" required></div>
                <div class="fin-field"><label>Variables</label><div class="arrears-note">{Guardian Name}, {Student Name}, {Outstanding Amount}, {Bill Name}, {Due Date}, {Days Overdue}, {School Name}, {Class}, {Term Name}</div></div>
              </div>
              <div class="fin-field"><label>Message</label><textarea name="body" rows="7">Dear {Guardian Name},

{Student Name} currently has an outstanding balance of {Outstanding Amount}.

Please review the account and arrange payment as soon as possible.

Regards,
{School Name} Finance Office</textarea></div>
              <div class="arrears-checkbox-row">
                <label class="arrears-checkbox"><input type="checkbox" name="include_payment_link" checked> Include payment link</label>
              </div>
              <div class="fin-card" style="padding:16px;background:rgba(15,23,42,.02);">
                <div class="section-head" style="margin-bottom:10px;"><h2>Who gets it</h2><span class="fin-section-count" id="arrearsRecipientCount">0 recipients</span></div>
                <div class="arrears-recipient-list" id="arrearsRecipientList"></div>
                <p class="arrears-note">Use the pencil editor here to add or override the recipient name, email, phone, or relationship for this send only. It does not save to the student profile.</p>
              </div>
              <input type="hidden" name="selected_student_ids" id="arrearsEmailSelectedIds">
              <input type="hidden" name="manual_guardians_json" id="arrearsManualGuardiansJson" value="{}">
              <div class="arrears-filter-payload"></div>
              <button type="submit" class="fin-btn sm primary">Send emails</button>
            </form>
          </div>
        </div>

        <div class="fin-modal" id="arrearsNoteModal">
          <div class="fin-modal-content" style="max-width:560px;">
            <div class="fin-modal-head"><h3>Add Recovery Note</h3><button class="fin-modal-close" type="button" onclick="closeArrearsNoteModal()">&times;</button></div>
            <form method="POST" action="/account/settings/finance/arrears/notes" class="fin-form">
              <input type="hidden" name="student_id" id="arrearsNoteStudentId">
              <div class="fin-field"><label>Student</label><input type="text" id="arrearsNoteStudentName" readonly></div>
              <div class="fin-field"><label>Note</label><textarea name="note" rows="5" placeholder="Call notes, repayment promise, escalation, follow-up owner." required></textarea></div>
              <button type="submit" class="fin-btn sm primary">Save note</button>
            </form>
          </div>
        </div>

      <% } %>

    </div>
  </div>
</div>

<script>
  (function () {
    /* ── Mobile hamburger nav toggle ───────────────────────── */
    var _finHamburger = document.getElementById('finHamburger');
    var _finSide = document.querySelector('.fin-side');
    var _finMobileHeader = document.querySelector('.fin-mobile-header');
    function _finCloseNav() {
      if (!_finSide) return;
      _finSide.classList.add('fin-nav-closed');
      if (_finHamburger) _finHamburger.setAttribute('aria-expanded', 'false');
    }
    function _finOpenNav() {
      if (!_finSide) return;
      _finSide.classList.remove('fin-nav-closed');
      if (_finHamburger) _finHamburger.setAttribute('aria-expanded', 'true');
    }
    if (_finHamburger && _finSide) {
      _finHamburger.addEventListener('click', function (e) {
        e.stopPropagation();
        if (_finSide.classList.contains('fin-nav-closed')) { _finOpenNav(); } else { _finCloseNav(); }
      });
      _finSide.querySelectorAll('a').forEach(function (link) {
        link.addEventListener('click', function () { _finCloseNav(); });
      });
      /* Click outside both the header and nav closes the drawer */
      document.addEventListener('click', function (e) {
        if (_finSide.classList.contains('fin-nav-closed')) return;
        if (_finSide.contains(e.target) || (_finMobileHeader && _finMobileHeader.contains(e.target))) return;
        _finCloseNav();
      });
    }

    /* ── Collapsible filter forms on mobile ────────────────── */
    /* NOTE: script is at bottom of body — DOM is already built, run immediately */
    (function () {
      document.querySelectorAll('.fin-report-filters').forEach(function (form) {
        /* Skip if already wrapped */
        if (form.parentNode.classList.contains('fin-filters-shell')) return;
        var wrapper = document.createElement('div');
        wrapper.className = 'fin-filters-shell';
        form.parentNode.insertBefore(wrapper, form);
        var btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'fin-filters-toggle';
        btn.innerHTML = '<span>Filters</span><span class="fin-filters-chev">▾</span>';
        btn.setAttribute('aria-expanded', 'false');
        wrapper.appendChild(btn);
        wrapper.appendChild(form);
        btn.addEventListener('click', function () {
          var open = wrapper.classList.toggle('open');
          btn.setAttribute('aria-expanded', open ? 'true' : 'false');
        });
      });
    })();
    (function () {
      function syncButtonState(button, direction, labelBase) {
        if (!button) return;
        button.setAttribute('data-sort-direction', direction);
        button.setAttribute('aria-label', direction === 'asc' ? ('Sort ' + labelBase + ' Z to A') : ('Sort ' + labelBase + ' A to Z'));
      }

      function extractCellText(row, index) {
        var cells = row.children || [];
        var cell = cells[index];
        return cell ? String(cell.textContent || '').trim().toLowerCase() : '';
      }

      function sortFinanceTable(button, direction) {
        var table = button.closest('table');
        if (!table) return;
        var tbody = table.querySelector('tbody');
        if (!tbody) return;
        var index = parseInt(button.getAttribute('data-fin-sort-index'), 10);
        if (!Number.isInteger(index)) return;
        // The table's own rows only (a breakdown row holds a table of its own), and each
        // breakdown row stays under the row it belongs to. Sorting every <tr> pulled the
        // breakdowns' rows out into the main table.
        var groups = [];
        Array.prototype.forEach.call(tbody.children, function (row) {
          if (row.tagName !== 'TR') return;
          if (row.id && row.id.indexOf('arrears-detail-') === 0 && groups.length) groups[groups.length - 1].push(row);
          else groups.push([row]);
        });
        groups
          .sort(function(a, b) {
            var valueA = extractCellText(a[0], index);
            var valueB = extractCellText(b[0], index);
            return direction === 'desc'
              ? valueB.localeCompare(valueA, undefined, { sensitivity: 'base', numeric: true })
              : valueA.localeCompare(valueB, undefined, { sensitivity: 'base', numeric: true });
          })
          .forEach(function(group) { group.forEach(function (row) { tbody.appendChild(row); }); });
      }

      Array.from(document.querySelectorAll('.fin-sort-btn')).forEach(function(button) {
        var labelBase = String((button.parentElement && button.parentElement.childNodes[0] && button.parentElement.childNodes[0].textContent) || 'items').trim().toLowerCase() || 'items';
        syncButtonState(button, button.getAttribute('data-sort-direction') === 'desc' ? 'desc' : 'asc', labelBase);
        if (button.getAttribute('data-fin-default') === 'true') {
          sortFinanceTable(button, 'asc');
        }
        button.addEventListener('click', function(event) {
          event.preventDefault();
          var nextDirection = button.getAttribute('data-sort-direction') === 'asc' ? 'desc' : 'asc';
          syncButtonState(button, nextDirection, labelBase);
          sortFinanceTable(button, nextDirection);
        });
      });
    })();
    var financeCurrencyCode = <%- JSON.stringify(currentCurrency) %>;
    var financeCurrencyLocale = <%- JSON.stringify((financeCurrency && financeCurrency.locale) || 'en-US') %>;
    var profilePlaceholderSrc = <%- JSON.stringify(profilePlaceholder) %>;
    var createBillDraft = <%- JSON.stringify(createBillDraftState || null) %>;
    window.createBillDraft = createBillDraft;
    var defaultCollectionDestination = <%- JSON.stringify(defaultCollectionDestinationSafe || '') %>;
    var collectionDestinationValues = <%- JSON.stringify(collectionDestinationOptionsSafe.map(function(option) { return option.value; })) %>;
    var shouldOpenCreateBillForm = <%= openCreateBillForm ? 'true' : 'false' %>;
    window.shouldOpenCreateBillForm = shouldOpenCreateBillForm;
    function getLocalTodayIso() {
      var today = new Date();
      return [
        today.getFullYear(),
        String(today.getMonth() + 1).padStart(2, '0'),
        String(today.getDate()).padStart(2, '0')
      ].join('-');
    }
    // Expose globally so SPA re-executed scripts and cross-scope handlers can always reach it.
    window.getLocalTodayIso = getLocalTodayIso;
    function splitDataIds(value) {
      return String(value || '')
        .split(',')
        .map(function (item) { return item.trim(); })
        .filter(Boolean);
    }
    function matchesDataIds(value, wantedIds) {
      if (!wantedIds || !wantedIds.length) return true;
      var available = splitDataIds(value);
      if (!available.length) return false;
      return wantedIds.some(function (wanted) { return available.indexOf(String(wanted || '')) !== -1; });
    }
    window.syncSingleTermSelect = function(yearSelect, termSelect, options) {
      if (!yearSelect || !termSelect) return;
      var yearValue = String(yearSelect.value || '');
      var preferredTermId = options && options.preferredTermId != null ? String(options.preferredTermId || '') : '';
      var matchedSelected = false;
      var firstMatching = '';
      var currentMatching = '';
      var emptyOption = termSelect.querySelector('option:not([data-school-year-id])');
      if (emptyOption && !termSelect.dataset.emptyOptionLabel) {
        termSelect.dataset.emptyOptionLabel = emptyOption.textContent;
      }
      Array.prototype.slice.call(termSelect.querySelectorAll('option[data-school-year-id]')).forEach(function (option) {
        var matches = !!yearValue && String(option.getAttribute('data-school-year-id') || '') === yearValue;
        option.hidden = !matches;
        option.disabled = !matches;
        if (matches) {
          if (!firstMatching) firstMatching = option.value;
          if (option.getAttribute('data-current') === 'true' && !currentMatching) currentMatching = option.value;
          if (String(termSelect.value || '') === String(option.value || '')) matchedSelected = true;
        }
      });
      if (emptyOption) {
        emptyOption.textContent = yearValue
          ? (termSelect.dataset.emptyOptionLabel || emptyOption.textContent)
          : (termSelect.getAttribute('data-year-required-label') || 'Select year first');
      }
      if (preferredTermId) {
        var preferredOption = termSelect.querySelector('option[value="' + preferredTermId.replace(/"/g, '\\"') + '"]');
        if (preferredOption && !preferredOption.disabled) {
          termSelect.value = preferredTermId;
          termSelect.disabled = !yearValue || !firstMatching;
          return;
        }
      }
      if (!matchedSelected) {
        if (options && options.keepBlankWhenYearChanges) termSelect.value = '';
        else termSelect.value = currentMatching || firstMatching || '';
      }
      termSelect.disabled = !yearValue || !firstMatching;
    };
    window.autofillBillScheduleDates = function(termSelect, startInput, endInput, options) {
      if (!termSelect) return;
      var selected = termSelect.options[termSelect.selectedIndex];
      if (!selected || selected.disabled) return;
      var force = !!(options && options.force);
      var startDate = String(selected.getAttribute('data-start-date') || '');
      var endDate = String(selected.getAttribute('data-end-date') || '');
      if (startInput && startDate && (force || !String(startInput.value || '').trim())) startInput.value = startDate;
      if (endInput && endDate && (force || !String(endInput.value || '').trim())) endInput.value = endDate;
    };
    window.syncBillScheduleControls = function(typeSelect, recurrenceSelect, excludeCheckbox) {
      var recurring = !!typeSelect && String(typeSelect.value || '') === 'recurring';
      if (recurrenceSelect) recurrenceSelect.disabled = !recurring;
      if (excludeCheckbox) excludeCheckbox.disabled = !recurring;
      return recurring;
    };
    window.syncArrearsYearTerms = function() {
      if (!arrearsFilterForm) return;
      var selectedYears = Array.prototype.slice.call(arrearsFilterForm.querySelectorAll('input[name="schoolYearIds"]:checked')).map(function (input) { return String(input.value || ''); });
      var termInputs = arrearsFilterForm.querySelectorAll('input[name="termIds"]');
      var visibleTerms = 0;
      termInputs.forEach(function (input) {
        var option = input.closest('.arrears-multiselect-option');
        if (!option) return;
        var belongsTo = String(input.getAttribute('data-school-year-id') || '');
        var matches = selectedYears.length > 0 && selectedYears.indexOf(belongsTo) !== -1;
        option.hidden = !matches;
        if (!matches) input.checked = false;
        if (matches) visibleTerms += 1;
      });
      var termInput = arrearsFilterForm.querySelector('input[name="termIds"]');
      var termBox = termInput ? termInput.closest('[data-arrears-multiselect]') : null;
      var termTrigger = termBox ? termBox.querySelector('[data-arrears-trigger]') : null;
      if (termTrigger) termTrigger.disabled = !selectedYears.length || !visibleTerms;
      if (termBox) {
        termBox.setAttribute('data-empty-label', selectedYears.length ? 'Term' : 'Select year first');
        termBox.setAttribute('data-empty-meta', selectedYears.length ? (visibleTerms ? 'Pick' : 'No terms') : 'Year first');
        updateArrearsMultiselectSummary(termBox);
      }
      window.syncArrearsClasses();
    };
    window.syncArrearsClasses = function() {
      if (!arrearsFilterForm) return;
      var selectedYears = Array.prototype.slice.call(arrearsFilterForm.querySelectorAll('input[name="schoolYearIds"]:checked')).map(function (input) { return String(input.value || ''); });
      var selectedTerms = Array.prototype.slice.call(arrearsFilterForm.querySelectorAll('input[name="termIds"]:checked')).map(function (input) { return String(input.value || ''); });
      var classInputs = arrearsFilterForm.querySelectorAll('input[name="classIds"]');
      var visibleClasses = 0;
      classInputs.forEach(function (input) {
        var option = input.closest('.arrears-multiselect-option');
        if (!option) return;
        var matches = true;
        if (selectedTerms.length) matches = matchesDataIds(input.getAttribute('data-term-ids'), selectedTerms);
        else if (selectedYears.length) matches = matchesDataIds(input.getAttribute('data-school-year-ids'), selectedYears);
        option.hidden = !matches;
        if (!matches) input.checked = false;
        if (matches) visibleClasses += 1;
      });
      var classInput = arrearsFilterForm.querySelector('input[name="classIds"]');
      var classBox = classInput ? classInput.closest('[data-arrears-multiselect]') : null;
      var classTrigger = classBox ? classBox.querySelector('[data-arrears-trigger]') : null;
      if (classTrigger) classTrigger.disabled = selectedYears.length > 0 && visibleClasses === 0;
      if (classBox) {
        classBox.setAttribute('data-empty-label', 'Class');
        classBox.setAttribute('data-empty-meta', selectedTerms.length ? 'By term' : (selectedYears.length ? 'By year' : 'Optional'));
        updateArrearsMultiselectSummary(classBox);
      }
    };
    window.syncBillTargetClasses = function() {
      var grid = document.getElementById('classChips');
      if (!grid) return;
      var selectedYear = String((document.getElementById('billCreateYearSelect') || {}).value || '');
      var selectedTerm = String((document.getElementById('billCreateTermSelect') || {}).value || '');
      grid.querySelectorAll('.fin-chip').forEach(function (chip) {
        var matches = true;
        if (selectedTerm) matches = matchesDataIds(chip.getAttribute('data-term-ids'), [selectedTerm]);
        else if (selectedYear) matches = matchesDataIds(chip.getAttribute('data-school-year-ids'), [selectedYear]);
        chip.classList.toggle('hidden', !matches);
        if (!matches) {
          var checkbox = chip.querySelector('input[type="checkbox"]');
          if (checkbox) checkbox.checked = false;
          chip.classList.remove('checked');
        }
      });
      finRecountChips('classCount');
    };
    window.syncBillTargetStudents = function() {
      var grid = document.getElementById('studentChips');
      if (!grid) return;
      var selectedYear = String((document.getElementById('billCreateYearSelect') || {}).value || '');
      var selectedTerm = String((document.getElementById('billCreateTermSelect') || {}).value || '');
      var query = String((document.getElementById('studentSearchBox') || {}).value || '').trim().toLowerCase();
      grid.querySelectorAll('.fin-chip.student').forEach(function (chip) {
        var matchesAcademic = true;
        if (selectedTerm) matchesAcademic = matchesDataIds(chip.getAttribute('data-term-ids'), [selectedTerm]);
        else if (selectedYear) matchesAcademic = matchesDataIds(chip.getAttribute('data-school-year-ids'), [selectedYear]);
        var hay = chip.getAttribute('data-search') || '';
        var matchesQuery = !query || hay.indexOf(query) !== -1;
        var checkbox = chip.querySelector('input[type="checkbox"]');
        // A student already chosen stays chosen, and in view, while searching for the next one.
        var visible = matchesAcademic && (matchesQuery || (checkbox && checkbox.checked));
        chip.classList.toggle('hidden', !visible);
        if (!matchesAcademic) {
          if (checkbox) checkbox.checked = false;
          chip.classList.remove('checked');
        }
      });
      finRecountChips('studentCount');
    };
    // === Toggle class/student pickers ===
    var sel = document.getElementById('appliesTo');
    var cp  = document.getElementById('classPicker');
    var sp  = document.getElementById('studentPicker');
    function refreshPicker() {
      if (!sel) return;
      var v = sel.value;
      if (cp) cp.style.display = v === 'classes'  ? '' : 'none';
      if (sp) sp.style.display = v === 'students' ? '' : 'none';
      if (v === 'students' && window.finBuildStudentChips) window.finBuildStudentChips();
    }
    if (sel) { sel.addEventListener('change', refreshPicker); refreshPicker(); }

    // === Lazy-load assignment options for payment form ===
    var assignSel = document.getElementById('assignSel');
    if (assignSel) {
      fetch('/account/settings/finance/_assignments.json')
        .then(r => r.ok ? r.json() : [])
        .then(rows => {
          var hint = assignSel.nextElementSibling;
          if (!rows || !rows.length) {
            if (hint) hint.textContent = 'No outstanding assignments — create a bill first.';
            return;
          }
          rows.forEach(a => {
            var o = document.createElement('option');
            o.value = a.assignment_id;
            o.textContent = a.label;
            assignSel.appendChild(o);
          });
          if (hint) hint.remove();
        }).catch(() => {});
    }

    // === Edit Bill Modal ===
    function formatBillAudienceSummary(bill) {
      var audience = String((bill && bill.applies_to) || 'school');
      if (audience === 'students') {
        var studentCount = Array.isArray(bill.target_student_ids) ? bill.target_student_ids.length : 0;
        return studentCount ? (studentCount + ' student' + (studentCount === 1 ? '' : 's') + ' selected.') : 'Select one or more students.';
      }
      if (audience === 'classes') {
        var classCount = Array.isArray(bill.target_class_ids) ? bill.target_class_ids.length : 0;
        return classCount ? (classCount + ' class' + (classCount === 1 ? '' : 'es') + ' selected.') : 'Select one or more classes.';
      }
      return 'Entire school in the selected year and term.';
    }

    function syncEditBillCollectorSummary() {
      var group = document.getElementById('ebl-assignee');
      var summary = document.getElementById('ebl-assignee_summary');
      if (!group || !summary) return;
      var selectedCount = group.querySelectorAll('.ebl-assignee-check:checked').length;
      summary.textContent = selectedCount
        ? (selectedCount + ' collector' + (selectedCount === 1 ? '' : 's') + ' selected.')
        : 'Leave empty if unassigned.';
    }

    function setEditBillAssignees(values) {
      var group = document.getElementById('ebl-assignee');
      if (!group) return;
      var wanted = Array.isArray(values) ? values.map(function(value) { return String(value); }) : [];
      Array.prototype.forEach.call(group.querySelectorAll('.ebl-assignee-check'), function(input) {
        input.checked = wanted.indexOf(String(input.value || '')) !== -1;
      });
    }

    function setMultiSelectValues(selectId, values) {
      var select = document.getElementById(selectId);
      if (!select) return;
      var wanted = Array.isArray(values) ? values.map(function(value) { return String(value); }) : [];
      Array.prototype.forEach.call(select.options, function(option) {
        option.selected = wanted.indexOf(String(option.value || '')) !== -1;
      });
    }

    function syncEditBillTargets() {
      var appliesTo = String((document.getElementById('ebl-applies_to') || {}).value || 'school');
      var selectedYear = String((document.getElementById('ebl-school_year_id') || {}).value || '');
      var selectedTerm = String((document.getElementById('ebl-term_id') || {}).value || '');
      var classWrap = document.getElementById('ebl-target-classes-wrap');
      var studentWrap = document.getElementById('ebl-target-students-wrap');
      var classSelect = document.getElementById('ebl-target_class_ids');
      var studentSelect = document.getElementById('ebl-target_student_ids');
      var appliesSummary = document.getElementById('ebl-applies_to_summary');

      if (classWrap) classWrap.style.display = appliesTo === 'classes' ? '' : 'none';
      if (studentWrap) studentWrap.style.display = appliesTo === 'students' ? '' : 'none';

      [classSelect, studentSelect].forEach(function(select) {
        if (!select) return;
        Array.prototype.forEach.call(select.options, function(option) {
          var matches = true;
          if (selectedTerm) matches = matchesDataIds(option.getAttribute('data-term-ids'), [selectedTerm]);
          else if (selectedYear) matches = matchesDataIds(option.getAttribute('data-school-year-ids'), [selectedYear]);
          option.setAttribute('data-academic-match', matches ? 'true' : 'false');
          option.disabled = !matches;
          if (!matches) option.selected = false;
        });
      });

      filterEditBillTargetOptions('ebl-target_class_ids', (document.getElementById('ebl-target_class_search') || {}).value || '');
      filterEditBillTargetOptions('ebl-target_student_ids', (document.getElementById('ebl-target_student_search') || {}).value || '');

      if (appliesSummary) {
        var classCount = classSelect ? Array.prototype.filter.call(classSelect.options, function(option) {
          return option.selected && !option.disabled;
        }).length : 0;
        var studentCount = studentSelect ? Array.prototype.filter.call(studentSelect.options, function(option) {
          return option.selected && !option.disabled;
        }).length : 0;
        if (appliesTo === 'classes') {
          appliesSummary.textContent = classCount
            ? ('Currently set to ' + classCount + ' class' + (classCount === 1 ? '' : 'es') + ' in this academic context.')
            : 'Choose one or more classes for this bill.';
        } else if (appliesTo === 'students') {
          appliesSummary.textContent = studentCount
            ? ('Currently set to ' + studentCount + ' individual student' + (studentCount === 1 ? '' : 's') + ' in this academic context.')
            : 'Choose one or more students for this bill.';
        } else {
          appliesSummary.textContent = 'This bill will apply to the entire school for the selected year and term.';
        }
      }
    }

    function filterEditBillTargetOptions(selectId, query) {
      var select = document.getElementById(selectId);
      if (!select) return;
      var normalizedQuery = String(query || '').trim().toLowerCase();
      Array.prototype.forEach.call(select.options, function(option) {
        var academicMatch = option.getAttribute('data-academic-match') !== 'false';
        var matchesQuery = !normalizedQuery || String(option.textContent || '').toLowerCase().indexOf(normalizedQuery) !== -1;
        option.hidden = !academicMatch || !matchesQuery;
      });
    }

    function setAllEditBillTargets(selectId, shouldSelect) {
      var select = document.getElementById(selectId);
      if (!select) return;
      Array.prototype.forEach.call(select.options, function(option) {
        if (option.disabled || option.hidden) return;
        option.selected = !!shouldSelect;
      });
      syncEditBillTargets();
    }

    function enableEditBillToggleMultiSelect(selectId) {
      var select = document.getElementById(selectId);
      if (!select || select.dataset.toggleMultiReady === 'true') return;
      select.dataset.toggleMultiReady = 'true';
      select.addEventListener('mousedown', function (event) {
        var option = event.target;
        if (!option || option.tagName !== 'OPTION' || option.disabled) return;
        event.preventDefault();
        var scrollTop = select.scrollTop;
        option.selected = !option.selected;
        if (selectId === 'ebl-target_class_ids' || selectId === 'ebl-target_student_ids') syncEditBillTargets();
        if (selectId === 'ebl-assignee') syncEditBillCollectorSummary();
        window.requestAnimationFrame(function () {
          select.focus();
          select.scrollTop = scrollTop;
        });
      });
    }

    function syncEditBillPaymentMethodMaster() {
      var master = document.getElementById('ebl-payAll');
      var methodInputs = Array.prototype.slice.call(document.querySelectorAll('.ebl-pay-method')).filter(function(input) {
        return !input.disabled;
      });
      if (!master) return;
      if (!methodInputs.length) {
        master.checked = false;
        master.indeterminate = false;
        return;
      }
      var checkedCount = methodInputs.filter(function(input) { return input.checked; }).length;
      master.checked = checkedCount === methodInputs.length;
      master.indeterminate = checkedCount > 0 && checkedCount < methodInputs.length;
    }

    function toggleAllEditBillPaymentMethods(checked) {
      document.querySelectorAll('.ebl-pay-method').forEach(function(input) {
        if (input.disabled) return;
        input.checked = !!checked;
      });
      syncEditBillPaymentMethodMaster();
    }

    window.openEditBill = function (bill) {
      var m = document.getElementById('editBillModal');
      if (!m) return;
      var setVal = function (id, v) { var el = document.getElementById(id); if (el) el.value = (v == null ? '' : v); };
      var setChk = function (id, v) { var el = document.getElementById(id); if (el) el.checked = !!v; };
      setVal('ebl-id', bill.id);
      setVal('ebl-title', bill.title);
      setVal('ebl-description', bill.description || '');
      setVal('ebl-amount', bill.amount);
      setVal('ebl-due_date', bill.due_date || '');
      setVal('ebl-recurrence_end_date', bill.recurrence_end_date || '');
      setVal('ebl-late_fee', bill.late_fee_amount || 0);
      setVal('ebl-late_days', bill.late_fee_after_days || 7);
      setEditBillAssignees((Array.isArray(bill.assignee_ids) && bill.assignee_ids.length) ? bill.assignee_ids : (bill.assignee_id ? [bill.assignee_id] : []));
      setVal('ebl-bill_type', bill.bill_type || 'one_time');
      setVal('ebl-recurrence', bill.recurrence || '');
      setChk('ebl-exclude_non_school_days', bill.exclude_non_school_days);
      setVal('ebl-applies_to', bill.applies_to || 'school');
      setVal('ebl-target_class_search', '');
      setVal('ebl-target_student_search', '');
      setVal('ebl-school_year_id', bill.school_year_id || '');
      window.syncSingleTermSelect(document.getElementById('ebl-school_year_id'), document.getElementById('ebl-term_id'), { preferredTermId: bill.term_id || '', keepBlankWhenYearChanges: false });
      setMultiSelectValues('ebl-target_class_ids', bill.target_class_ids || []);
      if (window.finBuildStudentOptions) window.finBuildStudentOptions();
      setMultiSelectValues('ebl-target_student_ids', bill.target_student_ids || []);
      syncEditBillTargets();
      window.syncBillScheduleControls(document.getElementById('ebl-bill_type'), document.getElementById('ebl-recurrence'), document.getElementById('ebl-exclude_non_school_days'));
      var editDestinationSelect = document.getElementById('ebl-payment_destination');
      if (editDestinationSelect) {
        var requestedDestination = String(bill.payment_destination || '');
        editDestinationSelect.value = collectionDestinationValues.indexOf(requestedDestination) !== -1
          ? requestedDestination
          : defaultCollectionDestination;
      }
      setVal('ebl-status', bill.status || 'active');
      setChk('ebl-accepts_card', bill.accepts_card);
      setChk('ebl-accepts_cash', bill.accepts_cash);
      setChk('ebl-accepts_transfer', bill.accepts_transfer);
      setChk('ebl-notify_email', bill.notify_email);
      setVal('ebl-status_action', '');
      syncEditBillPaymentMethodMaster();
      syncEditBillCollectorSummary();
      document.getElementById('editBillForm').action   = '/account/settings/finance/bills/' + bill.id + '/edit';
      m.classList.add('open');
    };
    window.submitEditBillForm = function (mode) {
      var form = document.getElementById('editBillForm');
      var statusField = document.getElementById('ebl-status');
      var statusActionField = document.getElementById('ebl-status_action');
      if (!form) return;
      if (statusActionField) statusActionField.value = '';
      if (mode === 'active') {
        if (statusField) statusField.value = 'active';
        if (statusActionField) statusActionField.value = 'active';
      } else if (mode === 'draft') {
        if (statusField) statusField.value = 'draft';
        if (statusActionField) statusActionField.value = 'draft';
      }
      if (typeof form.requestSubmit === 'function') form.requestSubmit();
      else form.submit();
    };
    var editCloseBtn = document.getElementById('editBillClose');
    if (editCloseBtn) editCloseBtn.addEventListener('click', function () {
      document.getElementById('editBillModal').classList.remove('open');
    });
    var editModal = document.getElementById('editBillModal');
    if (editModal) editModal.addEventListener('click', function (e) {
      if (e.target === editModal) editModal.classList.remove('open');
    });

    // === Student Detail Drawer ===
    window.openStudentDrawer = function (studentId) {
      var drawer = document.getElementById('studentDrawer');
      var body   = document.getElementById('studentDrawerBody');
      if (!drawer || !body) return;
      body.innerHTML = '<div style="text-align:center;padding:60px 20px;color:var(--fin-muted);">Loading…</div>';
      drawer.classList.add('open');
      fetch('/account/settings/finance/students/' + studentId + '/detail.json')
        .then(r => r.ok ? r.json() : Promise.reject(r))
        .then(data => { body.innerHTML = buildDrawerHtml(data); })
        .catch(() => { body.innerHTML = '<div style="color:var(--fin-red);padding:20px;">Could not load this student\'s ledger. Please try again.</div>'; });
    };

    function fmt(n) {
      try {
        return new Intl.NumberFormat(financeCurrencyLocale, {
          style: 'currency',
          currency: financeCurrencyCode,
          minimumFractionDigits: 2,
          maximumFractionDigits: 2
        }).format(Number(n || 0));
      } catch (_) {
        return financeCurrencyCode + ' ' + Number(n || 0).toFixed(2);
      }
    }

    // Everything a person typed (names, bill titles, references) goes in escaped.
    function ledgerText(value) {
      return String(value == null ? '' : value).replace(/[&<>"']/g, function (ch) {
        return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[ch];
      });
    }
    var ledgerStatusWords = { paid: 'Paid', partial: 'Part paid', pending: 'Owes', overdue: 'Overdue', draft: 'Draft', cancelled: 'Cancelled' };
    var ledgerMethodWords = { cash: 'Cash', cheque: 'Check', bank_transfer: 'Bank transfer', transfer: 'Bank transfer', card: 'Card', stripe: 'Card', momo: 'Mobile money', mobile_money: 'Mobile money', credit: 'Credit', other: 'Other' };

    function buildDrawerHtml(d) {
      var s = d.student;
      var bills = d.bills || [];
      var payments = d.payments || [];
      var credit = Number(d.credit || 0);
      var totalBilled  = bills.reduce((a,b) => a + Number(b.amount||0), 0);
      var totalPaid    = bills.reduce((a,b) => a + Number(b.amount_paid||0), 0);
      var outstanding  = bills.reduce((a,b) => a + Number(b.balance != null ? b.balance : Math.max(Number(b.amount||0) + Number(b.late_fee_applied||0) - Number(b.amount_paid||0), 0)), 0);
      var netDue       = Math.max(outstanding - credit, 0);
      var avatarSrc = (s.image_url && String(s.image_url).trim() && String(s.image_url).trim() !== 'profilePlaceholder.png') ? s.image_url : profilePlaceholderSrc;
      var avatarHtml = '<img src="' + ledgerText(avatarSrc) + '" alt="" style="width:100%;height:100%;object-fit:cover;border-radius:50%;" onerror="this.onerror=null;this.src=\'' + profilePlaceholderSrc + '\';">';

      var billRows = bills.map(function(b) {
        var bal = Number(b.balance != null ? b.balance : Math.max(Number(b.amount||0) + Number(b.late_fee_applied||0) - Number(b.amount_paid||0), 0));
        var status = String(b.status || '').toLowerCase();
        return '<tr><td>' + ledgerText(b.title) + '</td><td class="fin-date-muted">' + ledgerText(b.due_display || '—') + '</td>'
          + '<td class="num fin-money-neutral">' + fmt(b.amount) + '</td>'
          + '<td class="num fin-money-positive">' + fmt(b.amount_paid) + '</td>'
          + '<td class="num ' + (bal>0?'fin-money-negative':'fin-money-neutral') + '">' + fmt(bal) + '</td>'
          + '<td><span class="badge ' + ledgerText(status) + '">' + ledgerText(ledgerStatusWords[status] || status) + '</span></td>'
          + '<td><div class="fin-actions-cell">'
          + (bal > 0 ? '<button type="button" class="fin-btn sm" data-ledger-request="' + encodeURIComponent(b.assignment_id) + '" title="Email this student\'s parents what is owed and a link to pay">Request payment</button>' : '')
          + '<a class="fin-btn sm quiet" target="_blank" rel="noopener" href="/account/settings/my-paygira/invoice/' + encodeURIComponent(b.assignment_id) + '">Invoice</a>'
          + '</div></td></tr>';
      }).join('') || '<tr><td colspan="7" style="text-align:center;color:var(--fin-muted);padding:20px;">No bills for this student.</td></tr>';

      var payRows = payments.map(function(p) {
        var method = String(p.method || '').toLowerCase();
        return '<tr><td class="fin-date-muted">' + ledgerText(p.received_display || '—') + '</td>'
          + '<td>' + ledgerText(p.bill_title || '—') + (p.reference ? '<div class="fin-bill-meta">Ref ' + ledgerText(p.reference) + '</div>' : '') + '</td>'
          + '<td>' + ledgerText(ledgerMethodWords[method] || p.method || '') + '</td>'
          + '<td class="num fin-money-positive">' + fmt(p.amount) + '</td>'
          + '<td><a class="fin-btn sm quiet" target="_blank" rel="noopener" href="/account/settings/my-paygira/receipt/' + encodeURIComponent(p.payment_id) + '">Receipt</a></td></tr>';
      }).join('') || '<tr><td colspan="5" style="text-align:center;color:var(--fin-muted);padding:20px;">No payments yet.</td></tr>';

      return '<div style="display:flex;align-items:center;gap:14px;margin-bottom:22px;">'
        + '<div class="avatar" style="width:54px;height:54px;font-size:1.1rem;">' + avatarHtml + '</div>'
        + '<div><div style="font-family:inherit;font-size:1.3rem;font-weight:700;">' + ledgerText([s.first_name, s.last_name].filter(Boolean).join(' ')) + '</div>'
        + '<div style="color:var(--fin-muted);font-size:.88rem;">' + ledgerText(s.class_name || 'No class') + '</div></div></div>'
        + '<div class="fin-stats" style="margin-bottom:20px;">'
        + '<div class="stat"><div class="label">Billed</div><div class="value fin-mono">' + fmt(totalBilled) + '</div></div>'
        + '<div class="stat green"><div class="label">Paid</div><div class="value fin-mono">' + fmt(totalPaid) + '</div></div>'
        + '<div class="stat red"><div class="label">Still owed</div><div class="value fin-mono">' + fmt(netDue) + '</div></div>'
        + (credit > 0 ? '<div class="stat gold"><div class="label">Credit held</div><div class="value fin-mono">' + fmt(credit) + '</div></div>' : '')
        + '</div>'
        + (netDue > 0 && d.payUrl
            ? '<div class="fin-ledger-ask"><span>Parents pay in their parent portal. Ask from a bill below, or send them the link yourself.</span>'
              + '<button type="button" class="fin-btn sm quiet" data-ledger-copy="' + ledgerText(d.payUrl) + '">Copy pay link</button></div>'
            : '')
        + '<p class="fin-ledger-said" id="ledgerSaid" role="status" hidden></p>'
        + '<div style="font-family:inherit;font-weight:700;font-size:1rem;margin-bottom:10px;">Bills</div>'
        + '<div class="fin-table-wrap" style="margin-bottom:22px;"><table class="fin-table no-global-sort"><thead><tr><th>Bill</th><th>Due</th><th class="num">Billed</th><th class="num">Paid</th><th class="num">Balance</th><th>Status</th><th></th></tr></thead><tbody>' + billRows + '</tbody></table></div>'
        + '<div style="font-family:inherit;font-weight:700;font-size:1rem;margin-bottom:10px;">Payments</div>'
        + '<div class="fin-table-wrap"><table class="fin-table no-global-sort"><thead><tr><th>Date</th><th>Bill</th><th>Paid by</th><th class="num">Amount</th><th></th></tr></thead><tbody>' + payRows + '</tbody></table></div>';
    }

    // Asking for payment, and copying the link, from a student's ledger.
    (function () {
      var say = function (text, ok) {
        var line = document.getElementById('ledgerSaid');
        if (!line) return;
        line.textContent = text;
        line.className = 'fin-ledger-said ' + (ok ? 'is-ok' : 'is-bad');
        line.hidden = false;
      };
      document.addEventListener('click', function (event) {
        if (!event.target.closest || !event.target.closest('#studentDrawerBody')) return;
        var copy = event.target.closest('[data-ledger-copy]');
        if (copy) {
          var link = copy.getAttribute('data-ledger-copy');
          var done = function () { say('Link copied. Paste it into a text or message to the parent.', true); };
          if (navigator.clipboard && navigator.clipboard.writeText) navigator.clipboard.writeText(link).then(done, function () { window.prompt('Copy this link:', link); });
          else window.prompt('Copy this link:', link);
          return;
        }
        var ask = event.target.closest('[data-ledger-request]');
        if (!ask) return;
        ask.disabled = true;
        fetch('/account/settings/finance/assignments/' + ask.getAttribute('data-ledger-request') + '/request', {
          method: 'POST', credentials: 'same-origin', headers: { Accept: 'application/json' },
        }).then(function (r) { return r.json(); }).then(function (data) {
          say((data && data.message) || 'Could not send the payment request.', Boolean(data && data.success));
          if (data && data.success) ask.textContent = 'Sent';
          else ask.disabled = false;
        }).catch(function () { say('Could not send the payment request. Please try again.', false); ask.disabled = false; });
      });
    })();

    var drawerClose = document.getElementById('studentDrawerClose');
    if (drawerClose) drawerClose.addEventListener('click', function () {
      document.getElementById('studentDrawer').classList.remove('open');
    });
    var drawer = document.getElementById('studentDrawer');
    if (drawer) drawer.addEventListener('click', function (e) {
      if (e.target === drawer) drawer.classList.remove('open');
    });
  })();

  // ===== Accordion toggle =====
  function finToggleAcc(id, trigger) {
    var el = document.getElementById(id);
    if (!el) return;
    var isOpen = el.classList.toggle('open');
    var head = trigger || el.querySelector('.fin-acc-head');
    if (head) head.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
  }

  // ===== Panels from the right =====
  // A panel is open when it carries "open" (finToggleAcc, or a script closing it after a save).
  // Whatever changes that, the backdrop, the page behind and the keyboard follow from here.
  (function () {
    var sheets = Array.prototype.slice.call(document.querySelectorAll('.fin-sheet'));
    if (!sheets.length) return;
    var backdrop = document.createElement('div');
    backdrop.className = 'fin-sheet-backdrop';
    sheets[0].parentNode.insertBefore(backdrop, sheets[0]);
    var opened = function () { return sheets.filter(function (sheet) { return sheet.classList.contains('open'); }); };
    var closeAll = function () { opened().forEach(function (sheet) { sheet.classList.remove('open'); }); };
    var wasOpen = false;
    var sync = function () {
      var open = opened();
      backdrop.classList.toggle('show', open.length > 0);
      document.documentElement.classList.toggle('fin-sheet-open', open.length > 0);
      sheets.forEach(function (sheet) { sheet.setAttribute('aria-hidden', sheet.classList.contains('open') ? 'false' : 'true'); });
      if (open.length && !wasOpen) {
        // Start typing straight away.
        var first = open[0].querySelector('.fin-acc-body input:not([type="hidden"]):not([disabled]), .fin-acc-body select, .fin-acc-body textarea');
        if (first) setTimeout(function () { try { first.focus({ preventScroll: true }); } catch (_e) { first.focus(); } }, 230);
      }
      wasOpen = open.length > 0;
    };
    sheets.forEach(function (sheet) { new MutationObserver(sync).observe(sheet, { attributes: true, attributeFilter: ['class'] }); });
    backdrop.addEventListener('click', closeAll);
    document.addEventListener('keydown', function (event) { if (event.key === 'Escape' && opened().length) closeAll(); });
    sync();
  })();

