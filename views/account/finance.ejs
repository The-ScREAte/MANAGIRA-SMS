       the "ghost scroll / stuck UI" feeling on small screens. */
    var anyOpen = !!document.querySelector('#arrearsReportModal.open, #arrearsEmailModal.open, #arrearsNoteModal.open');
    document.body.style.overflow = anyOpen ? 'hidden' : '';
