        <div class="fin-field"><label>Amount (<%= currentCurrency %>) *</label><input id="ebl-amount" name="amount" type="number" step="0.01" min="0" required></div>
      </div>

      <div class="fin-field"><label>Description</label><textarea id="ebl-description" name="description"></textarea></div>

      <div class="fin-row">
        <div class="fin-field">
          <label>Bill Type *</label>
          <select id="ebl-bill_type" name="bill_type">
            <option value="one_time">One-Time Payment</option>
            <option value="recurring">Recurring</option>
            <option value="installment">Installment Plan</option>
          </select>
        </div>
        <div class="fin-field">
          <label>Recurrence (if recurring)</label>
          <select id="ebl-recurrence" name="recurrence">
            <option value="">—</option>
            <option value="daily">Daily</option>
            <option value="weekly">Weekly</option>
            <option value="monthly">Monthly</option>
            <option value="term">Per Term</option>
            <option value="year">Per Year</option>
          </select>
        </div>
      </div>

      <div class="fin-row">
        <div class="fin-field"><label>Start / First Date</label><input id="ebl-due_date" name="due_date" type="date"></div>
        <div class="fin-field"><label>End Date</label><input id="ebl-recurrence_end_date" name="recurrence_end_date" type="date"></div>
      </div>

      <div class="fin-field">
        <label>Schedule Rules</label>
        <div class="fin-checks">
          <label class="fin-check"><input type="checkbox" id="ebl-exclude_non_school_days" name="exclude_non_school_days"> Do not include weekends and holidays</label>
        </div>
        <small style="color:var(--fin-muted);font-size:.74rem;">Skips weekends &amp; holidays from the term calendar.</small>
      </div>

      <div class="fin-row">
        <div class="fin-field">
          <label>Status</label>
          <select id="ebl-status" name="status">
            <option value="active">Active</option>
            <option value="draft">Draft</option>
            <option value="scheduled">Scheduled</option>
            <option value="cancelled">Cancelled</option>
          </select>
        </div>
      </div>

      <div class="fin-row">
        <div class="fin-field"><label>Late Fee Amount</label><input id="ebl-late_fee" name="late_fee_amount" type="number" step="0.01" min="0"></div>
        <div class="fin-field"><label>Late Fee After (days)</label><input id="ebl-late_days" name="late_fee_after_days" type="number" min="0"></div>
      </div>

      <div class="fin-row">
        <div class="fin-field">
          <label>School Year *</label>
          <select id="ebl-school_year_id" name="school_year_id" required>
            <option value="">— Select school year —</option>
            <% (refs.years || []).forEach(y => { %><option value="<%= y.school_year_id %>"><%= y.name %><%= y.current ? ' (current)' : '' %></option><% }) %>
          </select>
        </div>
        <div class="fin-field">
          <label>Term *</label>
          <select id="ebl-term_id" name="term_id" data-year-required-label="Select year first" required>
            <option value="">— Select term —</option>
            <% (refs.terms || []).forEach(t => { %><option value="<%= t.term_id %>" data-school-year-id="<%= t.school_year_id || '' %>" data-current="<%= t.current ? 'true' : 'false' %>" data-start-date="<%= t.start_date ? new Date(t.start_date).toISOString().slice(0,10) : '' %>" data-end-date="<%= t.end_date ? new Date(t.end_date).toISOString().slice(0,10) : '' %>"><%= t.name %><%= t.current ? ' (current)' : '' %></option><% }) %>
          </select>
        </div>
      </div>

      <div class="fin-field">
        <label>Applicable To</label>
        <select id="ebl-applies_to" name="applies_to">
          <option value="school">Entire School</option>
          <option value="classes">Specific Classes</option>
          <option value="students">Individual Students</option>
        </select>
        <small id="ebl-applies_to_summary" style="display:block;color:var(--fin-muted);font-size:.74rem;margin-top:6px;"></small>
      </div>

      <div class="fin-field" id="ebl-target-classes-wrap" style="display:none;">
        <label>Classes</label>
        <div style="display:flex;gap:10px;align-items:end;flex-wrap:wrap;margin-bottom:8px;">
          <div class="fin-field" style="flex:1;min-width:180px;margin:0;">
            <input type="text" id="ebl-target_class_search" placeholder="Filter classes...">
          </div>
          <button type="button" class="fin-btn ghost" id="ebl-target_class_select_all">Select visible</button>
          <button type="button" class="fin-btn ghost" id="ebl-target_class_clear">Clear</button>
        </div>
        <input type="hidden" name="target_class_ids" value="">
        <select id="ebl-target_class_ids" name="target_class_ids" class="fin-multi-select" multiple size="6">
          <% (refs.classes || []).forEach(function(c) { %>
            <option value="<%= c.class_id %>" data-school-year-ids="<%= (c.school_year_ids || []).join(',') %>" data-term-ids="<%= (c.term_ids || []).join(',') %>"><%= c.class_name %></option>
          <% }) %>
        </select>
        <small style="color:var(--fin-muted);font-size:.72rem;">Click classes to add or remove them.</small>
      </div>

      <div class="fin-field" id="ebl-target-students-wrap" style="display:none;">
        <label>Students</label>
        <div style="display:flex;gap:10px;align-items:end;flex-wrap:wrap;margin-bottom:8px;">
          <div class="fin-field" style="flex:1;min-width:180px;margin:0;">
            <input type="text" id="ebl-target_student_search" placeholder="Filter students...">
          </div>
          <button type="button" class="fin-btn ghost" id="ebl-target_student_select_all">Select visible</button>
          <button type="button" class="fin-btn ghost" id="ebl-target_student_clear">Clear</button>
        </div>
        <input type="hidden" name="target_student_ids" value="">
        <%# Its options are drawn when the window opens (finBuildStudentOptions). %>
        <select id="ebl-target_student_ids" name="target_student_ids" class="fin-multi-select" multiple size="8">
        </select>
        <small style="color:var(--fin-muted);font-size:.72rem;">Click students to add or remove them.</small>
      </div>

      <div class="fin-field">
        <label>Collectors / Overseers</label>
        <div id="ebl-assignee" class="fin-check-list">
          <% (refs.employees || []).forEach(function(e) { %>
            <label class="fin-check"><input type="checkbox" class="ebl-assignee-check" name="assignee_ids[]" value="<%= e.user_id %>"> <%= formatCollectorOptionLabel(e) %></label>
          <% }) %>
        </div>
        <small id="ebl-assignee_summary" style="display:block;color:var(--fin-muted);font-size:.72rem;margin-top:6px;">Leave empty if nobody should be assigned.</small>
      </div>

      <div class="fin-row">
        <div class="fin-field">
          <label>Collection Destination</label>
          <select id="ebl-payment_destination" name="payment_destination">
            <% if (collectionDestinationOptionsSafe.length) { %>
              <% collectionDestinationOptionsSafe.forEach(function(option) { %>
                <option value="<%= option.value %>" <%= String(defaultCollectionDestinationSafe || '') === String(option.value) ? 'selected' : '' %>><%= option.label %></option>
              <% }) %>
            <% } else { %>
              <option value="cash">Cash (collect manually)</option>
            <% } %>
          </select>
          <small style="color:var(--fin-muted);font-size:.72rem;">Optional — only activated payout accounts are listed.</small>
        </div>

        <div class="fin-field">
          <label>Payment Methods Accepted</label>
          <% const editIsStripe = paymentProviderSafe === 'stripe';
             const editIsPaystack = paymentProviderSafe === 'paystack';
             const editCardOn = editIsPaystack ? true : !!(allowedMethods && allowedMethods.stripeOn);
             const editTransferOn = editIsStripe ? false : !!(allowedMethods && (allowedMethods.bankOn || allowedMethods.momoOn) || editIsPaystack);
             const editCardLabel = editIsPaystack ? 'Card (Paystack)' : 'Card / Stripe';
             const editTransferLabel = editIsPaystack ? 'Mobile Money / Bank' : 'Bank / Mobile Money'; %>
          <div class="fin-checks">
            <label class="fin-check fin-check-all"><input type="checkbox" id="ebl-payAll"> <strong>All methods</strong></label>
            <% if (editCardOn) { %>
            <label class="fin-check"><input type="checkbox" class="ebl-pay-method" id="ebl-accepts_card" name="accepts_card"> <%= editCardLabel %></label>
            <% } %>
            <label class="fin-check"><input type="checkbox" class="ebl-pay-method" id="ebl-accepts_cash" name="accepts_cash"> Cash</label>
            <% if (editTransferOn) { %>
            <label class="fin-check"><input type="checkbox" class="ebl-pay-method" id="ebl-accepts_transfer" name="accepts_transfer"> <%= editTransferLabel %></label>
            <% } %>
          </div>
        </div>
      </div>

      <div class="fin-field">
        <label>Notify Parents</label>
        <div class="fin-checks">
          <label class="fin-check"><input type="checkbox" id="ebl-notify_email" name="notify_email"> Email</label>
        </div>
      </div>

      <div style="display:flex;gap:10px;margin-top:6px;flex-wrap:wrap;">
        <button type="button" class="fin-btn primary" onclick="submitEditBillForm()">Save Changes</button>
        <button type="button" class="fin-btn" onclick="submitEditBillForm('draft')">Save as Draft</button>
        <button type="button" class="fin-btn" id="editBillClose2" onclick="document.getElementById('editBillModal').classList.remove('open')">Cancel</button>
      </div>
    </form>
  </div>
</div>

<!-- Student Detail Drawer -->
<%# Closed and open are set in the stylesheet (#studentDrawer / #studentDrawer.open): an inline display:none here kept it shut for good. %>
<div id="studentDrawer" style="position:fixed;inset:0;z-index:9998;align-items:stretch;">
  <div style="flex:1;background:rgba(255,255,255,0.7);backdrop-filter:blur(6px);" id="studentDrawerOverlay"></div>
  <div id="studentDrawerPanel" style="width:min(720px,100%);background:var(--fin-card);border-left:1px solid var(--fin-border);overflow-y:auto;padding:28px;box-shadow:-30px 0 60px -20px #000;">
    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:20px;">
      <div style="font-family:inherit;font-size:1.1rem;font-weight:700;color:var(--fin-teal);white-space:nowrap;">Student's ledger</div>
      <button type="button" id="studentDrawerClose" aria-label="Close" style="flex:0 0 auto;width:auto;min-width:0;margin:0;padding:0 6px;background:transparent;border:0;box-shadow:none;color:var(--fin-muted);font-size:1.6rem;cursor:pointer;line-height:1;">&times;</button>
    </div>
    <div id="studentDrawerBody"></div>
  </div>
</div> 

<script>
  (function() {
    function splitPatchIds(value) {
      return String(value || '')
        .split(',')
        .map(function(item) { return String(item || '').trim(); })
        .filter(Boolean);
    }

    function matchesPatchIds(value, wantedIds) {
      var available = splitPatchIds(value);
      var wanted = Array.isArray(wantedIds)
        ? wantedIds.map(function(item) { return String(item || '').trim(); }).filter(Boolean)
        : [];
      if (!wanted.length) return true;
      return wanted.some(function(id) {
        return available.indexOf(id) !== -1;
      });
    }

    function setPatchMultiSelectValues(selectId, values) {
      var select = document.getElementById(selectId);
      if (!select) return;
      var wanted = Array.isArray(values)
        ? values.map(function(value) { return String(value || '').trim(); }).filter(Boolean)
        : [];
      Array.prototype.forEach.call(select.options, function(option) {
        option.selected = wanted.indexOf(String(option.value || '')) !== -1;
      });
    }

    function syncEditBillPaymentMethodMasterPatch() {
      var master = document.getElementById('ebl-payAll');
      var inputs = Array.prototype.slice.call(document.querySelectorAll('.ebl-pay-method')).filter(function(input) {
        return !input.disabled;
      });
      if (!master) return;
      if (!inputs.length) {
        master.checked = false;
        master.indeterminate = false;
        return;
      }
      var checkedCount = inputs.filter(function(input) { return input.checked; }).length;
      master.checked = checkedCount === inputs.length;
      master.indeterminate = checkedCount > 0 && checkedCount < inputs.length;
    }

    function syncAudiencePicker() {
      var appliesTo = String((document.getElementById('ebl-applies_to') || {}).value || 'school');
      var selectedYear = String((document.getElementById('ebl-school_year_id') || {}).value || '');
      var selectedTerm = String((document.getElementById('ebl-term_id') || {}).value || '');
      var classWrap = document.getElementById('ebl-target-classes-wrap');
      var studentWrap = document.getElementById('ebl-target-students-wrap');
      var classSelect = document.getElementById('ebl-target_class_ids');
      var studentSelect = document.getElementById('ebl-target_student_ids');
      var classSearch = document.getElementById('ebl-target_class_search');
      var studentSearch = document.getElementById('ebl-target_student_search');
      var summary = document.getElementById('ebl-applies_to_summary');

      if (classWrap) classWrap.style.display = appliesTo === 'classes' ? '' : 'none';
      if (studentWrap) studentWrap.style.display = appliesTo === 'students' ? '' : 'none';

      [classSelect, studentSelect].forEach(function(select) {
        if (!select) return;
        Array.prototype.forEach.call(select.options, function(option) {
          var matches = true;
          if (selectedTerm) matches = matchesPatchIds(option.getAttribute('data-term-ids'), [selectedTerm]);
          else if (selectedYear) matches = matchesPatchIds(option.getAttribute('data-school-year-ids'), [selectedYear]);
          option.disabled = !matches;
          option.setAttribute('data-academic-match', matches ? 'true' : 'false');
          if (!matches) option.selected = false;
        });
      });

      window.filterEditBillTargetOptions('ebl-target_class_ids', classSearch ? classSearch.value : '');
      window.filterEditBillTargetOptions('ebl-target_student_ids', studentSearch ? studentSearch.value : '');

      if (!summary) return;
      if (appliesTo === 'classes') {
        var classCount = classSelect ? Array.prototype.filter.call(classSelect.options, function(option) {
          return option.selected && !option.disabled;
        }).length : 0;
        summary.textContent = classCount
          ? ('Currently set to ' + classCount + ' class' + (classCount === 1 ? '' : 'es') + ' in this academic context.')
          : 'Choose one or more classes for this bill.';
        return;
      }
      if (appliesTo === 'students') {
        var studentCount = studentSelect ? Array.prototype.filter.call(studentSelect.options, function(option) {
          return option.selected && !option.disabled;
        }).length : 0;
        summary.textContent = studentCount
          ? ('Currently set to ' + studentCount + ' individual student' + (studentCount === 1 ? '' : 's') + ' in this academic context.')
          : 'Choose one or more students for this bill.';
        return;
      }
      summary.textContent = 'This bill will apply to the entire school for the selected year and term.';
    }

    window.filterEditBillTargetOptions = function(selectId, query) {
      var select = document.getElementById(selectId);
      if (!select) return;
      var normalizedQuery = String(query || '').trim().toLowerCase();
      Array.prototype.forEach.call(select.options, function(option) {
        var academicMatch = option.getAttribute('data-academic-match') !== 'false';
        var matchesQuery = !normalizedQuery || String(option.textContent || '').toLowerCase().indexOf(normalizedQuery) !== -1;
        option.hidden = !academicMatch || !matchesQuery;
      });
    };

    window.setAllEditBillTargets = function(selectId, shouldSelect) {
      var select = document.getElementById(selectId);
      if (!select) return;
      Array.prototype.forEach.call(select.options, function(option) {
        if (option.disabled || option.hidden) return;
        option.selected = !!shouldSelect;
      });
      syncAudiencePicker();
    };

    window.syncEditBillTargets = syncAudiencePicker;

    function enablePatchToggleMultiSelect(selectId, onChange) {
      var select = document.getElementById(selectId);
      if (!select || select.dataset.patchToggleMultiReady === 'true') return;
      select.dataset.patchToggleMultiReady = 'true';
      select.addEventListener('mousedown', function(event) {
        var option = event.target;
        if (!option || option.tagName !== 'OPTION' || option.disabled) return;
        event.preventDefault();
        var scrollTop = select.scrollTop;
        option.selected = !option.selected;
        if (typeof onChange === 'function') onChange();
        window.requestAnimationFrame(function() {
          select.focus();
          select.scrollTop = scrollTop;
        });
      });
    }

    function closeEditBillModal() {
      var modal = document.getElementById('editBillModal');
      if (modal) modal.classList.remove('open');
    }

    function syncCreateAudiencePicker() {
      var select = document.getElementById('appliesTo');
      var classPicker = document.getElementById('classPicker');
      var studentPicker = document.getElementById('studentPicker');
      if (!select) return;
      var appliesTo = String(select.value || 'school');
      if (classPicker) classPicker.style.display = appliesTo === 'classes' ? '' : 'none';
      if (studentPicker) studentPicker.style.display = appliesTo === 'students' ? '' : 'none';
      if (typeof window.syncBillTargetClasses === 'function') window.syncBillTargetClasses();
      if (typeof window.syncBillTargetStudents === 'function') window.syncBillTargetStudents();
    }

    function bindEditBillListeners() {
      var editBillYearSelect = document.getElementById('ebl-school_year_id');
      var editBillTermSelect = document.getElementById('ebl-term_id');
      var editBillAudienceSelect = document.getElementById('ebl-applies_to');
      var editBillPayAll = document.getElementById('ebl-payAll');

      if (editBillAudienceSelect && editBillAudienceSelect.dataset.patchAudienceReady !== 'true') {
        editBillAudienceSelect.dataset.patchAudienceReady = 'true';
        editBillAudienceSelect.addEventListener('change', syncAudiencePicker);
      }

      if (editBillYearSelect && editBillYearSelect.dataset.patchAcademicReady !== 'true') {
        editBillYearSelect.dataset.patchAcademicReady = 'true';
        editBillYearSelect.addEventListener('change', function() {
          syncAudiencePicker();
        });
      }

      if (editBillTermSelect && editBillTermSelect.dataset.patchAcademicReady !== 'true') {
        editBillTermSelect.dataset.patchAcademicReady = 'true';
        editBillTermSelect.addEventListener('change', function() {
          syncAudiencePicker();
        });
      }

      ['ebl-target_class_ids', 'ebl-target_student_ids'].forEach(function(selectId) {
        var select = document.getElementById(selectId);
        if (!select || select.dataset.patchChangeReady === 'true') return;
        select.dataset.patchChangeReady = 'true';
        select.addEventListener('change', syncAudiencePicker);
      });

      [['ebl-target_class_search', 'ebl-target_class_ids'], ['ebl-target_student_search', 'ebl-target_student_ids']].forEach(function(pair) {
        var input = document.getElementById(pair[0]);
        if (!input || input.dataset.patchFilterReady === 'true') return;
        input.dataset.patchFilterReady = 'true';
        input.addEventListener('input', function() {
          window.filterEditBillTargetOptions(pair[1], input.value || '');
        });
      });

      [['ebl-target_class_select_all', 'ebl-target_class_ids', true], ['ebl-target_class_clear', 'ebl-target_class_ids', false], ['ebl-target_student_select_all', 'ebl-target_student_ids', true], ['ebl-target_student_clear', 'ebl-target_student_ids', false]].forEach(function(config) {
        var button = document.getElementById(config[0]);
        if (!button || button.dataset.patchActionReady === 'true') return;
        button.dataset.patchActionReady = 'true';
        button.addEventListener('click', function() {
          window.setAllEditBillTargets(config[1], config[2]);
        });
      });

      enablePatchToggleMultiSelect('ebl-target_class_ids', syncAudiencePicker);
      enablePatchToggleMultiSelect('ebl-target_student_ids', syncAudiencePicker);

      if (editBillPayAll && editBillPayAll.dataset.patchPayAllReady !== 'true') {
        editBillPayAll.dataset.patchPayAllReady = 'true';
        editBillPayAll.addEventListener('change', function() {
          document.querySelectorAll('.ebl-pay-method').forEach(function(input) {
            if (input.disabled) return;
            input.checked = !!editBillPayAll.checked;
          });
          syncEditBillPaymentMethodMasterPatch();
        });
      }

      document.querySelectorAll('.ebl-pay-method').forEach(function(input) {
        if (input.dataset.patchPayMethodReady === 'true') return;
        input.dataset.patchPayMethodReady = 'true';
        input.addEventListener('change', syncEditBillPaymentMethodMasterPatch);
      });

      ['editBillClose', 'editBillClose2'].forEach(function(id) {
        var button = document.getElementById(id);
        if (!button || button.dataset.patchCloseReady === 'true') return;
        button.dataset.patchCloseReady = 'true';
        button.addEventListener('click', function(event) {
          event.preventDefault();
          closeEditBillModal();
        });
      });

      var modal = document.getElementById('editBillModal');
      if (modal && modal.dataset.patchOverlayReady !== 'true') {
        modal.dataset.patchOverlayReady = 'true';
        modal.addEventListener('click', function(event) {
          if (event.target === modal) closeEditBillModal();
        });
      }

      syncEditBillPaymentMethodMasterPatch();
      syncAudiencePicker();
    }

    function bindCreateAudienceListeners() {
      var createAudienceSelect = document.getElementById('appliesTo');
      var createYearSelect = document.getElementById('billCreateYearSelect');
      var createTermSelect = document.getElementById('billCreateTermSelect');
      if (createAudienceSelect && createAudienceSelect.dataset.patchAudienceReady !== 'true') {
        createAudienceSelect.dataset.patchAudienceReady = 'true';
        createAudienceSelect.addEventListener('change', syncCreateAudiencePicker);
      }
      if (createYearSelect && createYearSelect.dataset.patchAcademicReady !== 'true') {
        createYearSelect.dataset.patchAcademicReady = 'true';
        createYearSelect.addEventListener('change', syncCreateAudiencePicker);
      }
      if (createTermSelect && createTermSelect.dataset.patchAcademicReady !== 'true') {
        createTermSelect.dataset.patchAcademicReady = 'true';
        createTermSelect.addEventListener('change', syncCreateAudiencePicker);
      }

      ['classChips', 'studentChips'].forEach(function(gridId) {
        var grid = document.getElementById(gridId);
        if (!grid || grid.dataset.patchSelectionReady === 'true') return;
        grid.dataset.patchSelectionReady = 'true';
        grid.addEventListener('change', syncCreateAudiencePicker);
      });

      syncCreateAudiencePicker();
    }

    if (typeof window.openEditBill === 'function' && window.openEditBill.__patchWrapped !== true) {
      var originalOpenEditBill = window.openEditBill;
      var wrappedOpenEditBill = function(bill) {
        originalOpenEditBill.call(this, bill);
        syncAudiencePicker();
        syncEditBillPaymentMethodMasterPatch();
      };
      wrappedOpenEditBill.__patchWrapped = true;
      window.openEditBill = wrappedOpenEditBill;
    }

    bindEditBillListeners();
    bindCreateAudienceListeners();

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', function() {
        bindEditBillListeners();
        bindCreateAudienceListeners();
      }, { once: true });
    }

    window.setPatchMultiSelectValues = setPatchMultiSelectValues;
  })();
</script>

<script>
/* PayGira overview fragment loading — render shell fast, then hydrate overview cards/tables.
   Uses stale-while-revalidate caching: show last cached fragment instantly, then refresh in background. */
(function(){
  var mount = document.getElementById('finOverviewSectionMount');
  if (!mount || typeof fetch !== 'function') return;

  var CACHE_PREFIX = 'finOverviewCache:';

  function cacheKey(url) {
    return CACHE_PREFIX + url;
  }
  function readCache(url) {
    try {
      var raw = sessionStorage.getItem(cacheKey(url));
      if (!raw) return null;
      var parsed = JSON.parse(raw);
      if (!parsed || typeof parsed.html !== 'string') return null;
      return parsed; // { html, ts }
    } catch (e) { return null; }
  }
  function writeCache(url, html) {
    try {
      sessionStorage.setItem(cacheKey(url), JSON.stringify({ html: html, ts: Date.now() }));
    } catch (e) { /* storage full or unavailable — ignore */ }
  }

  function buildOverviewUrl() {
    var base = mount.getAttribute('data-src') || '/account/settings/finance/_overview-section';
    var params = new URLSearchParams(window.location.search || '');
    params.set('section', 'overview');
    return base + '?' + params.toString();
  }

  function bindOverviewUi() {
    if (typeof window.bindOverviewFilters === 'function') window.bindOverviewFilters();
  }

  function buildDetailUrl(detailMount) {
    var base = detailMount.getAttribute('data-src') || '/account/settings/finance/_overview-detail-section';
    var params = new URLSearchParams(window.location.search || '');
    params.set('section', 'overview');
    return base + '?' + params.toString();
  }

  function renderDetail(detailMount, html) {
    if (detailMount.innerHTML !== html) detailMount.innerHTML = html;
    detailMount.setAttribute('aria-busy', 'false');
    if (typeof window.finRunReportFilter === 'function') window.finRunReportFilter();
  }

  function loadOverviewDetails() {
    var detailMount = document.getElementById('finOverviewDetailMount');
    if (!detailMount) return;
    var url = buildDetailUrl(detailMount);

    var cached = readCache(url);
    var hadCache = false;
    if (cached) {
      hadCache = true;
      renderDetail(detailMount, cached.html); // instant paint from cache
    } else {
      detailMount.setAttribute('aria-busy', 'true');
    }

    fetch(url, {
      credentials: 'same-origin',
      headers: { 'Accept': 'text/html', 'X-Silent-Reload': '1' },
      cache: 'default'
    })
      .then(function (response) {
        if (!response.ok) throw new Error('overview_detail_fragment_failed');
        return response.text();
      })
      .then(function (html) {
        writeCache(url, html);
        renderDetail(detailMount, html); // background refresh
      })
      .catch(function () {
        if (hadCache) return; // keep showing cached content on failure
        detailMount.setAttribute('aria-busy', 'false');
        detailMount.innerHTML = '<div class="fin-card"><div class="activity-empty">Unable to load overview details right now. Please refresh.</div></div>';
      });
  }

  function renderOverview(html) {
    if (mount.innerHTML !== html) mount.innerHTML = html;
    mount.setAttribute('aria-busy', 'false');
    bindOverviewUi();
    loadOverviewDetails();
  }

  function loadOverview() {
    var url = buildOverviewUrl();

    var cached = readCache(url);
    var hadCache = false;
    if (cached) {
      hadCache = true;
      renderOverview(cached.html); // instant paint from cache, no spinner
    } else {
      mount.setAttribute('aria-busy', 'true');
    }

    fetch(url, {
      credentials: 'same-origin',
      headers: { 'Accept': 'text/html', 'X-Silent-Reload': '1' },
      cache: 'default'
    })
      .then(function (response) {
        if (!response.ok) throw new Error('overview_fragment_failed');
        return response.text();
      })
      .then(function (html) {
        writeCache(url, html);
        renderOverview(html); // background refresh with fresh data
      })
      .catch(function () {
        if (hadCache) return; // keep showing cached content on failure
        mount.setAttribute('aria-busy', 'false');
        mount.innerHTML = '<div class="fin-card"><div class="activity-empty">Unable to load overview right now. Please refresh.</div></div>';
      });
  }

  loadOverview();
})();
</script>

<script>
/* PayGira live stats — background poll every 15s, updates DOM without full reload */
(function(){
  function buildStatsUrl() {
    var params = new URLSearchParams(window.location.search || '');
    var next = new URLSearchParams();
    if (params.get('year')) next.set('year', params.get('year'));
    if (params.get('term')) next.set('term', params.get('term'));
    var qs = next.toString();
    return '/account/settings/finance/_stats.json' + (qs ? ('?' + qs) : '');
  }
  var fmt = function(n){
    try { return new Intl.NumberFormat(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 }).format(Number(n||0)); }
    catch(e){ return String(n||0); }
  };
  var busy = false;
  function poll(){
    if (busy || document.hidden) return;
    var box = document.getElementById('finStatsLive');
    if (!box) return;
    busy = true;
    fetch(buildStatsUrl(), { credentials: 'same-origin', headers: { 'Accept': 'application/json' } })
      .then(function(r){ return r.ok ? r.json() : null; })
      .then(function(d){
        if (!d) return;
        var map = {
          billed: d.billedTotal, collected: d.collectedTotal,
          outstanding: d.outstandingTotal, overpayments: d.overpaymentsTotal
        };
        Object.keys(map).forEach(function(k){
          var el = box.querySelector('[data-stat="'+k+'"]');
          // Keep the currency the page was drawn with ("$", "GH₵ "): only the figure changes.
          var before = el ? (String(el.textContent || '').match(/^[^0-9-]*/) || [''])[0] : '';
          if (el && map[k] != null) el.textContent = before + fmt(map[k]);
        });
        var oc = box.querySelector('[data-stat="overdueCount"]');
        if (oc && d.overdueCount != null) oc.textContent = d.overdueCount;
      })
      .catch(function(){})
      .finally(function(){ busy = false; });
  }
  setTimeout(poll, 2000);
  setInterval(poll, 15000);
  document.addEventListener('visibilitychange', function(){ if (!document.hidden) poll(); });
})();
</script>

<script>
/* PayGira silent live-sync — polls a tiny version endpoint; when it changes
   (because somebody POSTed and cache was invalidated) we soft-reload the
   current SPA route in the background so the user always sees fresh data
   without ever hitting hard refresh. */
(function(){
  var KEY = '__paygira_v';
  var lastV = null;
  var busy = false;
  var INTERVAL = 8000;

  function softReload(){
    var path = window.location.pathname + window.location.search;
    // In a PayGira hub panel the app's page router would load the whole hub.
    if (window.top === window && window.spaRouter && typeof window.spaRouter.navigate === 'function') {
      try { window.spaRouter.navigate(path); return; } catch(_) {}
    }
    // Fallback: fetch and swap the finance shell only
    fetch(path, { credentials:'same-origin', headers:{ 'X-Silent-Reload':'1' } })
      .then(function(r){ return r.ok ? r.text() : null; })
      .then(function(html){
        if (!html) return;
        var doc = new DOMParser().parseFromString(html, 'text/html');
        var fresh = doc.querySelector('.fin-shell');
        var current = document.querySelector('.fin-shell');
        if (fresh && current) current.replaceWith(fresh);
      }).catch(function(){});
  }

  function poll(){
    if (busy || document.hidden) return;
    busy = true;
    fetch('/account/settings/finance/_version.json', { credentials:'same-origin', cache:'no-store' })
      .then(function(r){ return r.ok ? r.json() : null; })
      .then(function(d){
        if (!d || typeof d.v !== 'number') return;
        if (lastV === null) { lastV = d.v; return; }
        if (d.v > lastV) {
          lastV = d.v;
          softReload();
        }
      })
      .catch(function(){})
      .finally(function(){ busy = false; });
  }

  setTimeout(poll, 1500);
  var timer = setInterval(poll, INTERVAL);
  document.addEventListener('visibilitychange', function(){ if (!document.hidden) poll(); });
  if (Array.isArray(window.__spaCleanup)) window.__spaCleanup.push(function(){ clearInterval(timer); });
})();
</script>

<script>
/* PayGira section warming — after the current page settles, warm the other
   finance sections in the background so tab switches reuse both browser and
   server cache instead of waiting for a cold load. */
(function(){
  // Inside the PayGira hub each section is its own panel, warmed by the hub.
  if (window.top !== window) return;
  var navLinks = Array.prototype.slice.call(document.querySelectorAll('.fin-side a[href*="/account/settings/finance"]'));
  if (!navLinks.length || typeof fetch !== 'function') return;

  var currentPath = window.location.pathname + window.location.search;
  var warmed = new Set();
  var queue = navLinks
    .map(function(link){ return link.getAttribute('href'); })
    .filter(function(href){ return href && href !== currentPath; });

  function warmPath(path) {
    if (!path || warmed.has(path) || document.hidden) return Promise.resolve();
    warmed.add(path);
    return fetch(path, {
      credentials: 'same-origin',
      headers: { 'X-Silent-Reload': '1', 'Accept': 'text/html' },
      cache: 'default'
    }).catch(function(){
      warmed.delete(path);
    });
  }

  function warmAll() {
    return queue.reduce(function(chain, path){
      return chain.then(function(){ return warmPath(path); });
    }, Promise.resolve());
  }

  function scheduleWarm() {
    if ('requestIdleCallback' in window) {
      window.requestIdleCallback(function(){ warmAll(); }, { timeout: 6000 });
      return;
    }
    setTimeout(warmAll, 2500);
  }

  navLinks.forEach(function(link){
    link.addEventListener('mouseenter', function(){ warmPath(link.getAttribute('href')); }, { passive: true });
    link.addEventListener('focus', function(){ warmPath(link.getAttribute('href')); }, { passive: true });
  });

  scheduleWarm();
  var timer = setInterval(function(){
    warmed.clear();
    scheduleWarm();
  }, 45000);

  document.addEventListener('visibilitychange', function(){
    if (!document.hidden) {
      warmed.clear();
      scheduleWarm();
    }
  });

  if (Array.isArray(window.__spaCleanup)) window.__spaCleanup.push(function(){ clearInterval(timer); });
})();
</script>
