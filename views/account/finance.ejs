  function normalizeCreateDraftArray(value) {
    if (Array.isArray(value)) {
      return value.map(function(item) { return String(item || '').trim(); }).filter(Boolean);
    }
    return splitDataIds(value);
  }

  function syncCreateBillPaymentMethodMaster() {
    var master = document.getElementById('payAll');
    var enabledMethods = Array.prototype.slice.call(document.querySelectorAll('input.pay-method')).filter(function(input) {
      return !input.disabled;
    });
    if (!master) return;
    if (!enabledMethods.length) {
      master.checked = false;
      master.indeterminate = false;
      return;
    }
    var checkedCount = enabledMethods.filter(function(input) { return input.checked; }).length;
    master.checked = checkedCount === enabledMethods.length;
    master.indeterminate = checkedCount > 0 && checkedCount < enabledMethods.length;
  }

  function syncCreateBillDateLimits() {
    var todayIso = getLocalTodayIso();
    if (billCreateStartDate) {
      billCreateStartDate.min = todayIso;
      if (!String(billCreateStartDate.value || '').trim() || billCreateStartDate.value < todayIso) {
        billCreateStartDate.value = todayIso;
      }
    }
    if (billCreateEndDate) {
      var minEndDate = (billCreateStartDate && String(billCreateStartDate.value || '').trim())
        ? billCreateStartDate.value
        : todayIso;
      billCreateEndDate.min = minEndDate;
      if (String(billCreateEndDate.value || '').trim() && billCreateEndDate.value < minEndDate) {
        billCreateEndDate.value = minEndDate;
      }
    }
  }

  function applyCreateBillDraft(draft) {
    if (!draft || typeof draft !== 'object') return;
    var createForm = document.querySelector('form[action="/account/settings/finance/bills"]');
    if (!createForm) return;
    var setFieldValue = function(selector, value) {
      var field = createForm.querySelector(selector);
      if (field) field.value = value == null ? '' : String(value);
    };

    setFieldValue('[name="title"]', draft.title || '');
    setFieldValue('[name="amount"]', draft.amount || '');
    setFieldValue('[name="description"]', draft.description || '');
    setFieldValue('[name="late_fee_amount"]', draft.late_fee_amount || '');
    setFieldValue('[name="late_fee_after_days"]', draft.late_fee_after_days || '7');

    if (billTypeSelect) billTypeSelect.value = String(draft.bill_type || 'one_time');
    if (billCreateRecurrenceSelect) billCreateRecurrenceSelect.value = String(draft.recurrence || '');
    if (billCreateExcludeCheckbox) billCreateExcludeCheckbox.checked = !!draft.exclude_non_school_days;
    if (billCreateYearSelect) billCreateYearSelect.value = String(draft.school_year_id || '');
    if (billCreateTermSelect) {
      window.syncSingleTermSelect(billCreateYearSelect, billCreateTermSelect, {
        preferredTermId: String(draft.term_id || ''),
        keepBlankWhenYearChanges: false,
      });
      billCreateTermSelect.value = String(draft.term_id || billCreateTermSelect.value || '');
    }
    if (billCreateStartDate) billCreateStartDate.value = String(draft.due_date || '');
    if (billCreateEndDate) billCreateEndDate.value = String(draft.recurrence_end_date || '');
    if (sel) {
      sel.value = String(draft.applies_to || 'school');
      refreshPicker();
    }
    if (typeof window.syncBillScheduleControls === 'function') {
      window.syncBillScheduleControls(billTypeSelect, billCreateRecurrenceSelect, billCreateExcludeCheckbox);
    }
    if (typeof window.syncBillTargetClasses === 'function') window.syncBillTargetClasses();
    if (typeof window.syncBillTargetStudents === 'function') window.syncBillTargetStudents();

    var classIds = normalizeCreateDraftArray(draft.target_class_ids);
    createForm.querySelectorAll('input[name="target_class_ids"]').forEach(function(input) {
      var checked = classIds.indexOf(String(input.value || '')) !== -1;
      input.checked = checked;
      var chip = input.closest('.fin-chip');
      if (chip) chip.classList.toggle('checked', checked);
    });

    var studentIds = normalizeCreateDraftArray(draft.target_student_ids);
    createForm.querySelectorAll('input[name="target_student_ids"]').forEach(function(input) {
      var checked = studentIds.indexOf(String(input.value || '')) !== -1;
      input.checked = checked;
      var chip = input.closest('.fin-chip');
      if (chip) chip.classList.toggle('checked', checked);
    });

    var assigneeIds = normalizeCreateDraftArray(draft.assignee_ids);
    var assigneeSelect = createForm.querySelector('select[name="assignee_ids[]"]');
    if (assigneeSelect) {
      Array.prototype.forEach.call(assigneeSelect.options, function(option) {
        option.selected = assigneeIds.indexOf(String(option.value || '')) !== -1;
      });
    }

    setFieldValue('[name="payment_destination"]', draft.payment_destination || 'stripe');

    var acceptsCard = createForm.querySelector('input[name="accepts_card"]');
    var acceptsCash = createForm.querySelector('input[name="accepts_cash"]');
    var acceptsTransfer = createForm.querySelector('input[name="accepts_transfer"]');
    var notifyEmail = createForm.querySelector('input[name="notify_email"]');
    if (acceptsCard && !acceptsCard.disabled) acceptsCard.checked = !!draft.accepts_card;
    if (acceptsCash) acceptsCash.checked = !!draft.accepts_cash;
    if (acceptsTransfer && !acceptsTransfer.disabled) acceptsTransfer.checked = !!draft.accepts_transfer;
    if (notifyEmail) notifyEmail.checked = !!draft.notify_email;

    finRecountChips('classCount');
    finRecountChips('studentCount');
    syncCreateBillPaymentMethodMaster();
    syncCreateBillDateLimits();
  }

