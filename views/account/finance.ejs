        box.querySelectorAll('input[type="checkbox"]').forEach(function(input) {
          var option = input.closest('.arrears-multiselect-option');
          if (input.disabled || (option && option.hidden)) return;
          input.checked = true;
        });
        if (box.querySelector('input[name="schoolYearIds"]')) window.syncArrearsYearTerms();
        else if (box.querySelector('input[name="termIds"]')) window.syncArrearsClasses();
        updateArrearsMultiselectSummary(box);
      });
    }
    var clear = box.querySelector('[data-arrears-clear]');
    if (clear) {
      clear.addEventListener('click', function () {
        box.querySelectorAll('input[type="checkbox"]').forEach(function(input) { input.checked = false; });
        if (box.querySelector('input[name="schoolYearIds"]')) window.syncArrearsYearTerms();
        else if (box.querySelector('input[name="termIds"]')) window.syncArrearsClasses();
        updateArrearsMultiselectSummary(box);
      });
    }
    box.querySelectorAll('input[type="checkbox"]').forEach(function(input) {
      input.addEventListener('change', function () {
        if (input.name === 'schoolYearIds') window.syncArrearsYearTerms();
        if (input.name === 'termIds') window.syncArrearsClasses();
        updateArrearsMultiselectSummary(box);
      });
    });
    updateArrearsMultiselectSummary(box);
  });
  window.syncArrearsYearTerms();

  document.addEventListener('click', function (event) {
    var holder = event.target.closest('[data-arrears-multiselect]');
    if (!holder) closeArrearsMultiselects();
  });

  document.addEventListener('keydown', function (event) {
    if (event.key === 'Escape') closeArrearsMultiselects();
  });

  if (arrearsPresetForm) {
    arrearsPresetForm.addEventListener('submit', function () { injectArrearsFilterPayload(arrearsPresetForm); });
  }
  document.querySelectorAll('[data-arrears-preset]').forEach(function(btn) {
    btn.addEventListener('click', function () {
      if (!arrearsFilterForm) return;
      var filters = {};
      try { filters = JSON.parse(btn.getAttribute('data-arrears-preset') || '{}'); } catch (_) { filters = {}; }
      ['schoolYearIds','termIds','classIds','billIds'].forEach(function(name) {
        var selected = filters[name] || [];
        arrearsFilterForm.querySelectorAll('input[name="' + name + '"]').forEach(function(input) {
          input.checked = selected.indexOf(String(input.value)) !== -1;
        });
      });
      window.syncArrearsYearTerms();
      arrearsFilterForm.querySelectorAll('input[name="statuses"]').forEach(function(input) {
        input.checked = (filters.statuses || []).indexOf(input.value) !== -1;
      });
      ['dueFrom','dueTo','minOutstanding','search','paymentMethodFilter','emailStatusFilter'].forEach(function(name) {
        var el = arrearsFilterForm.querySelector('[name="' + name + '"]');
        if (el) el.value = filters[name] || (name === 'minOutstanding' ? '' : '');
      });
      document.querySelectorAll('[data-arrears-multiselect]').forEach(function(box) { updateArrearsMultiselectSummary(box); });
      arrearsFilterForm.submit();
    });
  });

  function finSetPrimaryChargeCard(authorizationCode) {
    return fetch('/account/cards/set-primary', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ authorizationCode: authorizationCode })
    });
  }

  function finSetFallbackOrder(authorizationCode, fallbackOrder) {
    return fetch('/account/cards/set-fallback-order', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ authorizationCode: authorizationCode, fallbackOrder: fallbackOrder })
    });
  }

  document.querySelectorAll('[data-fin-set-primary]').forEach(function(button) {
    button.addEventListener('click', async function () {
      try {
        var res = await finSetPrimaryChargeCard(button.getAttribute('data-fin-set-primary'));
        var data = await res.json();
        if (data && data.success) window.location.reload();
        else alert((data && data.message) || 'Failed to update primary card.');
      } catch (error) {
        alert('Unable to update the primary card right now.');
      }
    });
  });

  document.querySelectorAll('[data-fin-fallback-order]').forEach(function(input) {
    var submitFallback = async function () {
      try {
        var res = await finSetFallbackOrder(input.getAttribute('data-fin-fallback-order'), input.value.trim());
        var data = await res.json();
        if (data && data.success) window.location.reload();
        else alert((data && data.message) || 'Failed to update fallback order.');
      } catch (error) {
        alert('Unable to update fallback order right now.');
      }
    };
    input.addEventListener('change', submitFallback);
    input.addEventListener('blur', submitFallback);
  });
</script>

<!-- Edit Bill Modal -->
<div class="fin-modal" id="editBillModal">
  <div class="fin-modal-content" style="max-width:720px;">
    <div class="fin-modal-head">
      <h3>✏️ Edit Bill</h3>
      <button class="fin-modal-close" id="editBillClose">&times;</button>
    </div>
    <form class="fin-form" method="POST" id="editBillForm" action="#">
      <input type="hidden" id="ebl-id" name="_bill_id">

      <div class="fin-row">
        <div class="fin-field"><label>Bill Title *</label><input id="ebl-title" name="title" required></div>
        <div class="fin-field"><label>Amount (<%= currentCurrency %>) *</label><input id="ebl-amount" name="amount" type="number" step="0.01" min="0" required></div>
      </div>

      <div class="fin-field"><label>Description</label><textarea id="ebl-description" name="description"></textarea></div>

      <div class="fin-row">
        <div class="fin-field">
          <label>Bill Type *</label>
          <select id="ebl-bill_type" name="bill_type">
            <option value="one_time">One-Time Payment</option>
            <option value="recurring">Recurring</option>
            <option value="installment">Installment Plan</option>
          </select>
        </div>
        <div class="fin-field">
          <label>Recurrence (if recurring)</label>
          <select id="ebl-recurrence" name="recurrence">
            <option value="">—</option>
            <option value="daily">Daily</option>
            <option value="weekly">Weekly</option>
            <option value="monthly">Monthly</option>
            <option value="term">Per Term</option>
            <option value="year">Per Year</option>
          </select>
        </div>
      </div>

      <div class="fin-row">
        <div class="fin-field"><label>Due Date</label><input id="ebl-due_date" name="due_date" type="date"></div>
        <div class="fin-field">
          <label>Status</label>
          <select id="ebl-status" name="status">
            <option value="active">Active</option>
            <option value="draft">Draft</option>
            <option value="scheduled">Scheduled</option>
            <option value="cancelled">Cancelled</option>
          </select>
        </div>
      </div>

      <div class="fin-row">
        <div class="fin-field"><label>Late Fee Amount</label><input id="ebl-late_fee" name="late_fee_amount" type="number" step="0.01" min="0"></div>
        <div class="fin-field"><label>Late Fee After (days)</label><input id="ebl-late_days" name="late_fee_after_days" type="number" min="0"></div>
      </div>

      <div class="fin-row">
        <div class="fin-field">
          <label>School Year</label>
          <select id="ebl-school_year_id" name="school_year_id">
            <option value="">— Any —</option>
            <% (refs.years || []).forEach(y => { %><option value="<%= y.school_year_id %>"><%= y.name %><%= y.current ? ' (current)' : '' %></option><% }) %>
          </select>
        </div>
        <div class="fin-field">
          <label>Term</label>
          <select id="ebl-term_id" name="term_id" data-year-required-label="Select year first">
            <option value="">— Any —</option>
            <% (refs.terms || []).forEach(t => { %><option value="<%= t.term_id %>" data-school-year-id="<%= t.school_year_id || '' %>" data-current="<%= t.current ? 'true' : 'false' %>"><%= t.name %><%= t.current ? ' (current)' : '' %></option><% }) %>
          </select>
        </div>
      </div>

      <div class="fin-field">
        <label>Applicable To</label>
        <select id="ebl-applies_to" name="applies_to" disabled>
          <option value="school">Entire School</option>
          <option value="classes">Specific Classes</option>
          <option value="students">Individual Students</option>
        </select>
        <small style="color:var(--fin-muted);font-size:.74rem;">Audience cannot be changed after creation — delete and recreate to reassign.</small>
      </div>

      <div class="fin-field">
        <label>Assignee — Collector / Overseer</label>
        <select id="ebl-assignee" name="assignee_id">
          <option value="">— Unassigned —</option>
          <% (refs.employees || []).forEach(function(e) { %>
            <option value="<%= e.user_id %>"><%= e.first_name %> <%= e.last_name %> (<%= e.account_type %>)</option>
          <% }) %>
        </select>
      </div>

      <div class="fin-field">
        <label>Collection Destination</label>
        <select id="ebl-payment_destination" name="payment_destination">
          <option value="stripe">💳 Stripe — online card / wallet</option>
          <option value="cash">💵 Cash — handed to collector</option>
          <option value="bank">🏦 School Bank Transfer</option>
          <option value="momo">📱 Mobile Money</option>
        </select>
      </div>

      <div class="fin-field">
        <label>Payment Methods Accepted</label>
        <div class="fin-checks">
          <label class="fin-check"><input type="checkbox" id="ebl-accepts_card" name="accepts_card"> 💳 Card / Stripe</label>
          <label class="fin-check"><input type="checkbox" id="ebl-accepts_cash" name="accepts_cash"> 💵 Cash</label>
          <label class="fin-check"><input type="checkbox" id="ebl-accepts_transfer" name="accepts_transfer"> 🏦 Bank / Mobile Money</label>
        </div>
      </div>

      <div class="fin-field">
        <label>Notify Parents</label>
        <div class="fin-checks">
          <label class="fin-check"><input type="checkbox" id="ebl-notify_email" name="notify_email"> Email</label>
          <label class="fin-check"><input type="checkbox" id="ebl-notify_sms" name="notify_sms"> SMS</label>
        </div>
      </div>

      <div style="display:flex;gap:10px;margin-top:6px;flex-wrap:wrap;">
        <button type="submit" class="fin-btn primary">Save Changes</button>
        <button type="button" class="fin-btn" id="editBillClose2" onclick="document.getElementById('editBillModal').classList.remove('open')">Cancel</button>
      </div>
    </form>
  </div>
</div>

<!-- Student Detail Drawer -->
<div id="studentDrawer" style="position:fixed;inset:0;z-index:9998;display:none;align-items:stretch;">
  <div style="flex:1;background:rgba(5,8,18,.7);backdrop-filter:blur(6px);" id="studentDrawerOverlay"></div>
  <div id="studentDrawerPanel" style="width:min(720px,100%);background:var(--fin-card);border-left:1px solid var(--fin-border);overflow-y:auto;padding:28px;box-shadow:-30px 0 60px -20px #000;">
    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:20px;">
      <div style="font-family:'Space Grotesk',sans-serif;font-size:1.1rem;font-weight:700;color:var(--fin-teal);">Student Billing Detail</div>
      <button id="studentDrawerClose" style="background:transparent;border:0;color:var(--fin-muted);font-size:1.6rem;cursor:pointer;line-height:1;">&times;</button>
    </div>
    <div id="studentDrawerBody"></div>
  </div>
</div>
