      transform:translateY(0); opacity:1;
    }
    .fin-side.fin-nav-closed {
      transform:translateY(-20px);
      opacity:0;
      pointer-events:none;
    }
    /* Backdrop removed — close handled via click-outside */
    .fin-side-brand { display:none; }
    .fin-side-title { display:none; }
    
    .fin-nav a.active { background:var(--fin-teal-soft); box-shadow:0 0 0 1px color-mix(in srgb, var(--org-primary-color, #01535b) 22%, transparent); border-left:0; }
    .fin-stats   { grid-template-columns:repeat(2,1fr); }
    .fin-two     { grid-template-columns:1fr; }
    .fin-row     { grid-template-columns:1fr; }
    .fin-row-3   { grid-template-columns:1fr 1fr; }
    .fin-page-head h1 { font-size:1.65rem; }
    .fin-page-subtitle { display:none; }
    .fin-card    { padding:18px; }
    .fin-actions { padding:10px; }
    .fin-col-lg  { display:none !important; }
    .fin-modal-content { padding:20px; }
    /* Secure badge — icon-only, inline in mobile header */
    .paygira-secure-badge {
      position:static; padding:7px; border-radius:50%;
      box-shadow:0 2px 10px color-mix(in srgb, var(--org-primary-color, #01535b) 35%, transparent);
      margin-left:auto;
    }
    .paygira-secure-badge .paygira-secure-text { display:none; }
    .paygira-secure-badge svg { width:16px; height:16px; }
    /* Badge in page-head is hidden — only the mobile-header badge shows */
    html:not(.fin-in-hub) .fin-page-head .paygira-secure-badge { display:none; }
    .fin-page-head .paygira-secure-badge { width:30px; padding:0; justify-content:center; box-shadow:none; margin-left:0; }
    .section-head .fin-head-tools { margin-left:0; width:100%; justify-content:space-between; }
    .section-head .fin-filter-pop { right:auto; left:0; }
    .fin-page-head { position:static; margin-bottom:0; }
  }

  /* ── Mobile ≤600px ────────────────────────────────────────────── */
  @media (max-width:600px) {
    .fin-shell   { padding:10px 8px 72px; }
    .fin-stats   { grid-template-columns:1fr 1fr; gap:10px; }
    .stat        { padding:12px; }
    .stat .label { font-size:.62rem; margin-bottom:8px; }
    .stat .value { font-size:1.08rem; }
    .stat .sub   { font-size:.7rem; }
    .fin-row-3   { grid-template-columns:1fr; }
    .fin-page-head h1 { font-size:1.18rem; }
    .fin-report-filters .fin-field label { display:none; }
    .fin-report-filters .fin-field select { margin-top:0; }
    .fin-actions { flex-direction:row; flex-wrap:wrap; overflow:visible; padding:8px 10px; scrollbar-width:none; }
    .fin-actions::-webkit-scrollbar { display:none; }
    .fin-actions .fin-btn { flex-shrink:0; min-height:34px; font-size:.74rem; padding:0 10px; }
    .fin-selection-tools,
    .fin-picker-actions,
    .arrears-filter-actions { flex-wrap:wrap; overflow:visible; }
    .fin-col-md  { display:none !important; }
    .fin-modal   { padding:0; align-items:flex-end; }
    .fin-modal-content { max-height:96vh; border-radius:18px 18px 0 0; padding:16px 12px; animation:none; }
    #studentDrawerPanel { width:100% !important; }
    .section-head { flex-direction:column; align-items:flex-start; }
    .fin-card    { padding:12px; border-radius:14px; }
    .fin-table th { padding:9px 8px; font-size:.56rem; letter-spacing:.1em; }
    .fin-table td { padding:9px 8px; font-size:.78rem; }
    .fin-pagebar { padding:8px 10px; }
    .fin-page-btn { height:30px; min-width:40px; padding:0 10px; font-size:.76rem; }
    .fin-pagebar-label, .fin-page-info { font-size:.74rem; }
  }

  /* ── Very small ≤380px ────────────────────────────────────────── */
  @media (max-width:380px) {
    .fin-stats { grid-template-columns:1fr; }
    .fin-nav a { padding:7px 10px; font-size:.78rem; }
  }

  /* Mobile-only PayGira title shown above the nav */
  .fin-mobile-header { display:none; }
  .fin-hamburger { display:none; }
  @media (max-width:960px) {
    .fin-mobile-header {
      display:flex; align-items:center;
      justify-content:space-between;
      padding:4px 2px 0;
      position:relative; z-index:201; /* must be above backdrop(199) and nav(200) so × is always clickable */
    }
    .fin-mobile-header h2 {
      margin:0; font-size:1.28rem; font-weight:700;
      font-family:inherit;
      color:#fff;
      flex:1; text-align:center;
    }
    .fin-mobile-header h2 .accent { color:var(--fin-teal); }
    /* Hide the duplicate h1 in fin-page-head on mobile; a place's tabs stay. */
    .fin-page-head-main-title h1 { display:none; }
    .fin-tabs { margin-top:0; }
    /* Hamburger button */
    .fin-hamburger {
      display:flex; flex-direction:column; justify-content:center; align-items:center; gap:5px;
      background:rgba(15,23,42,.07); border:1px solid rgba(15,23,42,.12);
      border-radius:9px; padding:8px 10px; cursor:pointer;
      flex-shrink:0; flex-grow:0;
      width:38px; height:38px; box-sizing:border-box;
    }
    .fin-hamburger span {
      display:block; width:18px; height:2px;
      background:#fff; border-radius:2px;
      transition:transform .25s, opacity .2s;
    }
    .fin-hamburger[aria-expanded="false"] span:nth-child(1) { transform:none; }
    .fin-hamburger[aria-expanded="false"] span:nth-child(2) { opacity:1; }
    .fin-hamburger[aria-expanded="false"] span:nth-child(3) { transform:none; }
    .fin-hamburger[aria-expanded="true"] span:nth-child(1) { transform:translateY(7px) rotate(45deg); }
    .fin-hamburger[aria-expanded="true"] span:nth-child(2) { opacity:0; }
    .fin-hamburger[aria-expanded="true"] span:nth-child(3) { transform:translateY(-7px) rotate(-45deg); }
    /* Nav drawer — open by default, floats over content */
    /* (position/transition handled in the ≤960px block above) */
    /* Vertical nav on mobile — icon + text, styled links */
    .fin-nav     { flex-direction:column !important; overflow-x:visible !important; gap:6px !important; padding:4px 0 0 !important; width:100% !important; }
    .fin-nav a   {
      flex-shrink:0;
      display:flex; align-items:center; gap:12px;
      padding:11px 16px; border-radius:12px; border-left:0;
      background:rgba(15,23,42,.04);
      color:rgba(15,23,42,.75);
      font-size:.9rem; font-weight:500;
      transition:background .15s, color .15s;
    }
    .fin-nav a .ico {
      display:inline-flex !important;
      align-items:center; justify-content:center;
      width:30px; height:30px; border-radius:8px; flex-shrink:0;
      background:rgba(15,23,42,.06);
      font-size:1rem;
    }
    
    
    .fin-nav a.active {
      background:linear-gradient(90deg,color-mix(in srgb, var(--org-primary-color, #01535b) 18%, transparent),color-mix(in srgb, var(--org-primary-color, #01535b) 6%, transparent));
      color:#fff;
      border-left:3px solid var(--fin-teal);
      border-radius:0 12px 12px 0;
      box-shadow:none;
    }
    .fin-nav a.active .ico {
      background:color-mix(in srgb, var(--org-primary-color, #01535b) 22%, transparent);
      filter:drop-shadow(0 0 5px color-mix(in srgb, var(--org-primary-color, #01535b) 40%, transparent));
    }
  }
  @media (max-width:420px) {
    .fin-mobile-header h2 { font-size:1.12rem; }
    .fin-hamburger { width:34px; height:34px; padding:7px 8px; }
    .fin-nav a { font-size:.82rem; padding:10px 12px; }
    .fin-nav a .ico { width:26px; height:26px; font-size:.9rem; }
  }
  @media (max-width:700px) {
    .fin-stats.fin-student-summary-grid,
    .fin-report-filters.fin-student-filter-grid {
      grid-template-columns:1fr;
    }
  }
  .fin-analytics-grid {
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:20px;
    margin-top:20px;
    align-items:start;
  }

  @media (max-width:600px) {
    .fin-analytics-grid { grid-template-columns:1fr; }
  }

  /* ============================================================
     PayGira — Targeted visual fixes based on screenshot audit
     ============================================================ */

  /* Icon action buttons: neutral for edit/reminder, red for delete */
  .fin-icon-btn {
    width: 32px;
    height: 32px;
    border-radius: 4px;
    background: rgba(15,23,42,.06);
    border: 1px solid rgba(15,23,42,.1);
    color: #6b7280 !important;
    box-shadow: none;
    transition: background .15s, border-color .15s;
  }
  .fin-icon-btn:hover {
    transform: none;
    box-shadow: none;}
  .fin-icon-btn.danger {
    background: rgba(220,38,38,.12);
    border: 1px solid rgba(220,38,38,.3);
    color: #dc2626 !important;
  }
  
  .fin-icon-btn svg {
    width: 14px;
    height: 14px;
  }
  .fin-btn.danger::before { content: ''; display: none; }

  /* Arrears row action buttons: compact inline */
  .arrears-toolbar-right .fin-btn.sm,
  .arrears-toolbar-right .fin-btn {
    min-height: 30px;
    padding: 0 10px;
    font-size: .75rem;
    border-radius: 4px;
    white-space: nowrap;
    flex-shrink: 0;
    width: auto !important;
  }
  .arrears-toolbar-right {
    flex-wrap: nowrap;
    gap: 6px;
  }




  /* Subscription rows visual structure */
  [style*="border-radius:14px"][style*="background:var(--fin-card-2)"] {
    border-left: 3px solid color-mix(in srgb, var(--org-primary-color, #01535b) 40%, transparent) !important;
    padding: 14px 16px !important;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
  }

  /* Lift table row surfaces for readability.
     A global `th, td { border: 1px solid #ddd }` reset (and, on pages with
     compact tables, an extra `border-top`) otherwise leaks a light default
     grid line onto every cell — invisible against most of this dark theme,
     but visible as a stray box around the last column next to the icon
     buttons. Zero out every side but the intentional row-separator. */
  .fin-table td {
    background: rgba(255,255,255,0.95) !important;
    border: 0 !important;
    border-bottom: 1px solid rgba(255,255,255,0.8) !important;
  }
  
  .fin-table th {
    background: rgba(255,255,255,0.98) !important;
    border: 0 !important;
    border-bottom: 1px solid rgba(255,255,255,0.8) !important;
  }

  /* Smooth stat border transition */
  .stat {
    transition: border-color .2s ease;
  }

  /* Arrears section action buttons compact inline */
  .arrears-toolbar .arrears-toolbar-right > .fin-btn {
    min-height: 34px;
    padding: 0 14px;
    font-size: .8rem;
    flex-shrink: 0;
    width: auto !important;
