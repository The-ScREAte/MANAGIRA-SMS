<%
  const paygiraAccess = workspaceAccess().paygira;
  const rawSec = (typeof section !== 'undefined' && section) ? section : 'overview';
  const sec = (rawSec === 'reports' || rawSec === 'templates') ? 'overview' : rawSec;
  const currentCurrency = (typeof financeCurrency !== 'undefined' && financeCurrency && financeCurrency.code) ? financeCurrency.code : 'USD';
  const profilePlaceholder = '/images/profilePlaceholder.png';
  const resolveAvatar = (u) => publicImageUrl(u && String(u).trim() && String(u).trim() !== 'profilePlaceholder.png' ? u : profilePlaceholder);
  const fmt = (n) => typeof formatMoney === 'function'
    ? formatMoney(n)
    : (currentCurrency + ' ' + Number(n||0).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }));
  const fmtUsdEquivalent = (n) => typeof formatUsdEquivalent === 'function' ? formatUsdEquivalent(n) : null;
  const t = overview.totals || {};
  const billedTotal = Number(t.total_billed || 0);
  const collectedTotal = Number(t.total_collected || 0);
  const outstandingTotal = Number(t.outstanding || 0);
  const overpaymentsTotal = Number(overview.overpayments || 0);
  const billYearFilter = (typeof billListFilters !== 'undefined' && billListFilters && billListFilters.school_year_id) || '';
  const billTermFilter = (typeof billListFilters !== 'undefined' && billListFilters && billListFilters.term_id) || '';
  const studentYearFilter = (typeof studentBillingFilters !== 'undefined' && studentBillingFilters && studentBillingFilters.school_year_id) || '';
  const studentTermFilter = (typeof studentBillingFilters !== 'undefined' && studentBillingFilters && studentBillingFilters.term_id) || '';
  // Period filters: what each one shows, in words, and the Overview's choice.
  const _finQuery = (typeof req !== 'undefined' && req && req.query) || {};
  const _finYears = (refs && refs.years) || [];
  const _finTerms = (refs && refs.terms) || [];
  const _finCurYear = _finYears.find((y) => y.current) || null;
  const _finCurTerm = _finTerms.find((tm) => tm.current) || null;
  const finPeriodLabel = (yearId, termId, allYears) => {
    if (allYears) return 'All years';
    const y = _finYears.find((x) => String(x.school_year_id) === String(yearId));
    const tm = termId ? _finTerms.find((x) => String(x.term_id) === String(termId)) : null;
    return [tm ? tm.name : (y ? 'All terms' : ''), y ? y.name : ''].filter(Boolean).join(' · ') || 'Current term';
  };
  const ovAllYears = _finQuery.year === 'all';
  const ovYearSel = ovAllYears ? 'all' : (_finQuery.year || (_finCurYear ? _finCurYear.school_year_id : ''));
  const ovTermSel = ovAllYears ? '' : (_finQuery.term || (!_finQuery.year && _finCurTerm ? _finCurTerm.term_id : ''));
  const createBillDraftState = (typeof createBillDraft !== 'undefined' && createBillDraft) ? createBillDraft : null;
  const collectionDestinationOptionsSafe = (typeof collectionDestinationOptions !== 'undefined' && Array.isArray(collectionDestinationOptions)) ? collectionDestinationOptions : [];
  const defaultCollectionDestinationSafe = (typeof defaultCollectionDestination !== 'undefined' && defaultCollectionDestination) ? defaultCollectionDestination : '';
  const paymentProviderSafe = (typeof paymentProvider !== 'undefined' && paymentProvider) ? String(paymentProvider).toLowerCase() : '';
  const openCreateBillForm = sec === 'bills' && (Boolean(createBillDraftState) || (typeof messages !== 'undefined' && messages && messages.error && messages.error.length));
  const formatCollectorOptionLabel = (employee) => {
    const fullName = [employee && employee.first_name, employee && employee.last_name].filter(Boolean).join(' ').trim() || 'Unnamed staff';
    const role = (employee && employee.account_type) ? employee.account_type : 'Staff';
    const assignedClasses = String((employee && employee.assigned_classes_label) || '').trim();
    return assignedClasses
      ? `${fullName} · ${role} · Classes: ${assignedClasses}`
      : `${fullName} · ${role} · No assigned class`;
  };
%>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
