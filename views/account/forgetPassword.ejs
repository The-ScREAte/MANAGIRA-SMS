<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Forgot Password - Managira</title>
  <link rel="icon" href="/favicon.ico" type="image/x-icon" sizes="any" />
  <link rel="apple-touch-icon" sizes="180x180" href="/images/favicon_io/apple-touch-icon.png" />
  <link rel="shortcut icon" href="/favicon.ico" />
  <style>
    :root {
      --font-family: "Inter", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
      --primary: #01535b;
      --primary-hover: #014a51;
        --primary-hover-fill: color-mix(in srgb, var(--primary) 88%, white);
      --primary-light: rgba(1, 83, 91, 0.08);
      --text-primary: #1e293b;
      --text-secondary: #64748b;
      --border: #e2e8f0;
      --bg-page: #f8fafc;
      --bg-card: #ffffff;
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      font-family: var(--font-family);
      background: var(--bg-page);
    }

    .forgot-page {
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: flex-start;
      padding: 40px 20px 32px;
    }

    .forgot-container {
      width: 100%;
      max-width: 420px;
      margin: 0 auto;
    }

    .forgot-card {
      background: var(--bg-card);
      border-radius: 14px;
      box-shadow: 0 4px 24px rgba(0, 0, 0, 0.08), 0 1px 3px rgba(0, 0, 0, 0.04);
      padding: 28px 26px;
      border: 1px solid var(--border);
    }

    .forgot-header { text-align: center; margin-bottom: 20px; }
    .forgot-header .icon {
      width: 52px; height: 52px;
      background: var(--primary-light);
      border-radius: 50%;
      display: flex; align-items: center; justify-content: center;
      margin: 0 auto 12px;
    }
    .forgot-header .icon svg { width: 24px; height: 24px; color: var(--primary); }
    .forgot-header h1 { font-size: 1.5rem; font-weight: 700; color: var(--text-primary); margin-bottom: 6px; }
    .forgot-header p { color: var(--text-secondary); font-size: 0.9rem; line-height: 1.5; }

    form {
      display: block;
      width: 100%;
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    .form-group { margin-bottom: 16px; width: 100%; box-sizing: border-box; }
    .form-label {
      display: block; font-weight: 600; color: var(--text-primary);
      margin-bottom: 8px; font-size: 0.9rem;
    }
    .form-input {
      display: block;
      width: 100%;
      min-width: 0;
      max-width: 100%;
      box-sizing: border-box;
      padding: 5px 16px;
      height: 36px;
      line-height: 1.2;
      -webkit-appearance: none;
      appearance: none;
      border: 2px solid var(--border); border-radius: 10px;
      font-size: 1rem; font-family: inherit;
      transition: all 0.2s ease; background: var(--bg-card); color: var(--text-primary);
    }
    .form-input:focus {
      outline: none; border-color: var(--primary);
      box-shadow: 0 0 0 3px var(--primary-light);
    }
    .form-input::placeholder { color: var(--text-secondary); opacity: 0.7; }

    .btn-primary {
      width: 100%; padding: 14px 24px; box-sizing: border-box;
      background: linear-gradient(135deg, var(--primary) 0%, #0a6d77 100%);
      color: white; border: none; border-radius: 10px;
      font-size: 1rem; font-weight: 600; cursor: pointer;
      transition: all 0.2s ease;
      box-shadow: 0 2px 8px rgba(1, 83, 91, 0.25);
    }
    .btn-primary:hover { transform: translateY(-2px); box-shadow: 0 6px 20px rgba(1, 83, 91, 0.35); }

    .back-link {
      display: flex; align-items: center; justify-content: center; gap: 8px;
      margin-top: 16px; color: var(--text-secondary);
      text-decoration: none; font-size: 0.88rem;
    }
    .back-link:hover { color: var(--primary); }
    .back-link svg { width: 16px; height: 16px; }

    @media (max-width: 480px) {
      .forgot-page { padding: 32px 12px 24px; }
      .forgot-card { padding: 24px 20px; border-radius: 12px; }
      .forgot-header h1 { font-size: 1.1rem; }
      .forgot-header p { font-size: 0.8rem; }
      .form-label { font-size: 0.8rem; }
      .form-input { padding: 3px 10px; font-size: 14px; height: 32px; }
      .btn-primary { padding: 8px 16px; font-size: 0.85rem; }
    }
  </style>
</head>
<body>
  <div class="forgot-page<%= (typeof loginAds !== 'undefined' && loginAds && loginAds.length) ? ' auth-split' : '' %>">
    <div class="forgot-container">
      <div class="forgot-card">
        <div class="forgot-header">
          <div class="icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
              <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
            </svg>
          </div>
          <h1>Forgot password?</h1>
          <p>Enter your email to reset your password.</p>
        </div>

        <%- include('../partials/flash') %>

        <form action="/account/forget-password" method="post">
          <div class="form-group">
            <label class="form-label" for="email">Email Address</label>
            <input type="email" id="email" name="email" class="form-input" placeholder="you@example.com" required autocomplete="email" />
          </div>
          <button type="submit" class="btn-primary">Send Reset Link</button>
        </form>

        <a href="/account/login" class="back-link">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <line x1="19" y1="12" x2="5" y2="12"></line>
            <polyline points="12 19 5 12 12 5"></polyline>
          </svg>
          Back to sign in
        </a>
      </div>
    </div>
    <%- include('../partials/loginAdsPanel') %>
  </div>
</body>
</html>
