<h1>Forget Password</h1>
<%- include('../partials/flash') %>

<form action="/account/forget-password" method="post">
  <div>
    <label for="email">Email:</label>
    <input type="email" id="email" name="email" required />
  </div>
  <button type="submit">Request Password Reset</button>
</form>
<style>
  @media (max-width: 480px) {
    form {
      width: 95%;
      padding: 20px;
    }

    h1 {
      font-size: 1.8rem;
    }

    .form-group input {
      font-size: 0.95rem;
      padding: 8px;
    }

    button {
      font-size: 1rem;
      padding: 10px;
    }

    p {
      font-size: 0.9rem;
    }
  }
</style>
