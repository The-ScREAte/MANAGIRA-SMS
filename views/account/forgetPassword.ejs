<style>
    :root {
      --font-family: "Inter", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
      --primary: #01535b;
      --primary-hover: #014a51;
      --primary-light: rgba(1, 83, 91, 0.08);
      --text-primary: #1e293b;
      --text-secondary: #64748b;
      --border: #e2e8f0;
      --bg-page: #f8fafc;
      --bg-card: #ffffff;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    .forgot-password-page {
      font-family: var(--font-family);
      background: var(--bg-page);
      padding: 32px 0 64px;
    }

    .forgot-container {
      width: 100%;
      max-width: 420px;
      margin: 0 auto;
      padding: 0 16px;
    }

    .forgot-card {
      background: var(--bg-card);
      border-radius: 16px;
      box-shadow: 0 4px 24px rgba(0, 0, 0, 0.08), 0 1px 3px rgba(0, 0, 0, 0.04);
      padding: 32px 26px;
      border: 1px solid var(--border);
    }

    .forgot-header {
      text-align: center;
      margin-bottom: 24px;
    }

    .forgot-header .icon {
      width: 56px;
      height: 56px;
      background: var(--primary-light);
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      margin: 0 auto 16px;
    }

    .forgot-header .icon svg {
      width: 28px;
      height: 28px;
      color: var(--primary);
    }

    .forgot-header h1 {
      font-size: 1.34rem;
      font-weight: 700;
      color: var(--text-primary);
      margin-bottom: 6px;
    }

    .forgot-header p {
      color: var(--text-secondary);
      font-size: 0.88rem;
      line-height: 1.5;
    }

    .form-group {
      margin-bottom: 20px;
    }

    .form-label {
      display: block;
      font-weight: 600;
      color: var(--text-primary);
      margin-bottom: 8px;
      font-size: 0.84rem;
    }

    .form-input {
      width: 100%;
      padding: 13px 15px;
      border: 2px solid var(--border);
      border-radius: 10px;
      font-size: 0.95rem;
      font-family: inherit;
      transition: all 0.2s ease;
      background: var(--bg-card);
      color: var(--text-primary);
    }

    .form-input:focus {
      outline: none;
      border-color: var(--primary);
      box-shadow: 0 0 0 3px var(--primary-light);
    }

    .form-input::placeholder {
      color: var(--text-secondary);
      opacity: 0.7;
    }

    .btn-primary {
      width: 100%;
      padding: 13px 20px;
      background: linear-gradient(135deg, var(--primary) 0%, #0a6d77 100%);
      color: white;
      border: none;
      border-radius: 10px;
      font-size: 0.94rem;
      font-weight: 600;
      cursor: pointer;
      transition: all 0.2s ease;
      box-shadow: 0 2px 8px rgba(1, 83, 91, 0.25);
    }

    .btn-primary:hover {
      transform: translateY(-2px);
      box-shadow: 0 6px 20px rgba(1, 83, 91, 0.35);
    }

    .btn-primary:active {
      transform: translateY(0);
    }

    .back-link {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      margin-top: 20px;
      color: var(--text-secondary);
      text-decoration: none;
      font-size: 0.84rem;
      transition: color 0.2s ease;
    }

    .back-link:hover {
      color: var(--primary);
    }

    .back-link svg {
      width: 16px;
      height: 16px;
    }

    @media (max-width: 768px) {
      .forgot-password-page {
        padding: 22px 0 52px;
      }
      .forgot-container {
        padding: 0 16px;
      }
      .forgot-card {
        padding: 28px 22px;
      }
    }

    @media (max-width: 480px) {
      .forgot-password-page {
        padding: 18px 0 44px;
      }
      .forgot-container {
        padding: 0 12px;
      }
      .forgot-card {
        padding: 24px 18px;
      }

      .forgot-header h1 {
        font-size: 1.2rem;
      }

      .forgot-header p {
        font-size: 0.8rem;
      }

      .form-input {
        padding: 12px 14px;
      }

      .btn-primary {
        padding: 12px 18px;
      }
    }
  </style>
<div class="forgot-password-page">
  <div class="forgot-container">
    <div class="forgot-card">
      <div class="forgot-header">
        <div class="icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
            <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
          </svg>
        </div>
        <h1>Forgot Password?</h1>
        <p>No worries! Enter your email address and we'll send you a link to reset your password.</p>
      </div>

      <%- include('../partials/flash') %>

      <form action="/account/forget-password" method="post">
        <div class="form-group">
          <label class="form-label" for="email">Email Address</label>
          <input 
            type="email" 
            id="email" 
            name="email" 
            class="form-input" 
            placeholder="you@example.com" 
            required 
            autocomplete="email"
          />
        </div>

        <button type="submit" class="btn-primary">Send Reset Link</button>
      </form>

      <a href="/account/login" class="back-link">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <line x1="19" y1="12" x2="5" y2="12"></line>
          <polyline points="12 19 5 12 12 5"></polyline>
        </svg>
        Back to Login
      </a>
    </div>
  </div>
</div>
