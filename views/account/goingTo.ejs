<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="noindex" />
  <title><%= title %></title>
  <noscript><meta http-equiv="refresh" content="0;url=<%= target %>" /></noscript>
  <style>
    html, body { height: 100%; margin: 0; }
    body { display: flex; align-items: center; justify-content: center; padding: 16px; box-sizing: border-box; background: linear-gradient(180deg, #eaf0f6 0%, #f3f1ec 100%); font: 600 15px/1.35 -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif; color: #374151; }
    .card { display: flex; flex-direction: column; align-items: center; min-width: 176px; padding: 26px 28px 18px; border-radius: 18px; background: #fff; box-shadow: 0 20px 50px rgba(15, 23, 42, 0.12); text-align: center; }
    .card p { margin: 12px 0 0; }
    img { display: block; animation: hop 0.5s cubic-bezier(0.33, 0, 0.67, 1) infinite alternate; transform-origin: 50% 100%; }
    .shadow { display: block; width: 34px; height: 6px; margin-top: 2px; border-radius: 50%; background: rgba(15, 23, 42, 0.16); animation: shadow 0.5s cubic-bezier(0.33, 0, 0.67, 1) infinite alternate; }
    @keyframes hop { 0% { transform: translateY(0) scale(1.07, 0.93); } 18% { transform: translateY(-3px) scale(1, 1); } 100% { transform: translateY(-18px) scale(0.98, 1.02); } }
    @keyframes shadow { 100% { transform: scale(0.55); opacity: 0.5; } }
    @media (prefers-reduced-motion: reduce) { img, .shadow { animation-duration: 1.6s; } }
  </style>
</head>
<body>
  <div class="card" role="status">
    <img src="/images/managira-logo-sm.png" width="52" height="52" alt="" />
    <span class="shadow" aria-hidden="true"></span>
    <p>Taking you to the <%= portal %></p>
  </div>
  <script>location.replace(<%- JSON.stringify(target).replace(/</g, '\\u003c') %>);</script>
</body>
</html>
