<%# Two-step sign-in with an authenticator app (controllers/authenticatorController.js, utils/signInMfa.js). %>
<style>
  .au { max-width: 760px; margin: 0 auto; padding: 22px 20px 60px; color: #101828; font-size: 14px; line-height: 1.55; }
  .au * { box-sizing: border-box; }
  .au h1 { margin: 0; font-size: 22px; font-weight: 750; text-align: left; }
  .au h2 { margin: 0 0 8px; font-size: 16px; font-weight: 750; text-align: left; }
  .au-hint { margin: 4px 0 0; color: #667085; font-size: 13.5px; }
  .au-card { margin-top: 16px; padding: 18px 20px; border: 1px solid #e4e7ec; border-radius: 14px; background: #fff; }
  .au-pill { display: inline-flex; align-items: center; gap: 6px; height: 26px; padding: 0 11px; border-radius: 999px; font-size: 12.5px; font-weight: 700; }
  .au-pill--on { background: #ecfdf3; color: #067647; }
  .au-pill--off { background: #f2f4f7; color: #344054; }
  .au-note { margin-top: 14px; padding: 12px 14px; border-radius: 12px; background: #fffaeb; color: #93370d; }
  .au-steps { margin: 6px 0 0; padding-left: 20px; }
  .au-steps li { margin: 4px 0; }
  .au-qr { display: flex; gap: 18px; align-items: center; flex-wrap: wrap; margin: 12px 0; }
  .au-qr img { width: 180px; height: 180px; border: 1px solid #e4e7ec; border-radius: 12px; background: #fff; }
  .au-secret { font: 600 14px/1.4 "SFMono-Regular", Menlo, Consolas, monospace; letter-spacing: .06em; word-break: break-all; }
  .au-row { display: flex; gap: 8px; flex-wrap: wrap; align-items: center; margin-top: 10px; }
  .au-input { height: 42px; padding: 0 12px; border: 1px solid #d0d5dd; border-radius: 10px; font-size: 15px; min-width: 0; }
  .au-input--code { width: 150px; letter-spacing: .3em; text-align: center; font: 700 18px/1 "SFMono-Regular", Menlo, Consolas, monospace; }
  .au-btn { height: 42px; padding: 0 16px; border: 0; border-radius: 10px; background: var(--org-primary-color, #01535b); color: #fff; font-weight: 700; cursor: pointer; }
  .au-btn[disabled] { opacity: .6; cursor: default; }
  .au-btn--quiet { background: #fff; color: #344054; border: 1px solid #d0d5dd; }
  .au-msg { margin: 8px 0 0; font-size: 13.5px; }
  .au-msg.is-bad { color: #b42318; }
  .au-codes { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 6px 14px; margin: 10px 0; padding: 12px 14px; border-radius: 12px; background: #f9fafb; font: 600 14px/1.6 "SFMono-Regular", Menlo, Consolas, monospace; }
  @media (max-width: 560px) { .au { padding: 14px 16px 48px; } .au-codes { grid-template-columns: 1fr; } }
  @media print { .au-noprint { display: none !important; } }
</style>
<div class="au">
  <%- include('../partials/flash') %>
  <h1>Two-step sign-in</h1>
  <p class="au-hint">With an authenticator app, signing in with your password also asks for a code from your phone, so a stolen password alone can't open your account.</p>

  <% if (justRequired) { %>
    <div class="au-note" role="alert">Your school asks you to use an authenticator app to sign in. Set it up below to continue to Managira.</div>
  <% } %>
  <% if (sso) { %>
    <div class="au-note">You signed in through your school's single sign-on, which checks you with its own two-step sign-in. The app below is used when you sign in with a Managira password.</div>
  <% } %>

  <div class="au-card" id="auStatus">
    <h2>Authenticator app <% if (on) { %><span class="au-pill au-pill--on">On</span><% } else { %><span class="au-pill au-pill--off">Off</span><% } %></h2>
    <% if (on) { %>
      <p style="margin:0">When you sign in with your password, Managira asks for the 6-digit code your app shows. If you lose your phone, use one of your recovery codes, or ask a manager to reset it.</p>
      <% if (required) { %>
        <p class="au-hint">Your school requires it, so it stays on.</p>
      <% } else { %>
        <div class="au-row au-noprint">
          <input class="au-input" type="password" id="auOffPassword" placeholder="Your password" autocomplete="current-password" aria-label="Your password" />
          <button class="au-btn au-btn--quiet" type="button" id="auOff">Turn off</button>
        </div>
        <p class="au-msg" id="auOffMsg" role="status"></p>
      <% } %>
    <% } else { %>
      <p style="margin:0">You'll need an authenticator app on your phone, such as Google Authenticator, Microsoft Authenticator or Authy.</p>
      <div class="au-row au-noprint"><button class="au-btn" type="button" id="auStart">Set up</button></div>
      <p class="au-msg" id="auStartMsg" role="status"></p>
    <% } %>
  </div>

  <div class="au-card" id="auSetup" hidden>
    <h2>Scan this code</h2>
    <ol class="au-steps">
      <li>Open your authenticator app and add an account (the + button).</li>
      <li>Scan the QR code, or type the key below.</li>
      <li>Enter the 6-digit code the app shows.</li>
    </ol>
    <div class="au-qr"><img id="auQr" alt="QR code for your authenticator app" /><div><div class="au-hint">Key, if you can't scan</div><div class="au-secret" id="auSecret"></div></div></div>
    <div class="au-row">
      <input class="au-input au-input--code" id="auCode" inputmode="numeric" autocomplete="one-time-code" maxlength="7" placeholder="123456" aria-label="Code from your app" />
      <button class="au-btn" type="button" id="auConfirm">Turn on</button>
    </div>
    <p class="au-msg" id="auConfirmMsg" role="status"></p>
  </div>

  <div class="au-card" id="auDone" hidden>
    <h2>It's on. Save your recovery codes</h2>
    <p style="margin:0">If you lose your phone, each of these codes signs you in once. Keep them somewhere safe, like a password manager or a printed copy. They won't be shown again.</p>
    <div class="au-codes" id="auCodes"></div>
    <div class="au-row au-noprint">
      <button class="au-btn au-btn--quiet" type="button" onclick="window.print()">Print</button>
      <a class="au-btn" id="auContinue" href="/common/orgDashboard" style="display:inline-flex;align-items:center;text-decoration:none">Continue</a>
    </div>
  </div>
</div>
<script>
  (function () {
    function post(url, body) {
      return fetch(url, { method: 'POST', credentials: 'same-origin', headers: { 'Content-Type': 'application/json', Accept: 'application/json' }, body: JSON.stringify(body || {}) })
        .then(function (res) { return res.json().catch(function () { return {}; }).then(function (json) { if (!res.ok || !json.success) throw new Error(json.message || "That didn't work. Try again."); return json; }); });
    }
    function say(el, text, bad) { if (!el) return; el.textContent = text || ''; el.className = 'au-msg' + (bad ? ' is-bad' : ''); }
    var start = document.getElementById('auStart');
    if (start) start.addEventListener('click', function () {
      start.disabled = true;
      post('/account/authenticator/start').then(function (json) {
        document.getElementById('auQr').src = json.qr;
        document.getElementById('auSecret').textContent = json.secret;
        document.getElementById('auSetup').hidden = false;
        document.getElementById('auCode').focus();
      }).catch(function (error) { start.disabled = false; say(document.getElementById('auStartMsg'), error.message, true); });
    });
    var confirmBtn = document.getElementById('auConfirm');
    if (confirmBtn) confirmBtn.addEventListener('click', function () {
      var code = document.getElementById('auCode').value.replace(/\s+/g, '');
      if (!/^\d{6}$/.test(code)) { say(document.getElementById('auConfirmMsg'), 'Enter the 6-digit code from your app.', true); return; }
      confirmBtn.disabled = true;
      post('/account/authenticator/confirm', { code: code }).then(function (json) {
        var list = document.getElementById('auCodes');
        list.textContent = '';
        (json.recovery || []).forEach(function (c) { var d = document.createElement('div'); d.textContent = c; list.appendChild(d); });
        document.getElementById('auSetup').hidden = true;
        document.getElementById('auStatus').hidden = true;
        document.getElementById('auDone').hidden = false;
      }).catch(function (error) { confirmBtn.disabled = false; say(document.getElementById('auConfirmMsg'), error.message, true); });
    });
    var off = document.getElementById('auOff');
    if (off) off.addEventListener('click', function () {
      var password = document.getElementById('auOffPassword').value;
      if (!password) { say(document.getElementById('auOffMsg'), 'Enter your password to turn it off.', true); return; }
      off.disabled = true;
      post('/account/authenticator/off', { password: password }).then(function () { window.location.reload(); })
        .catch(function (error) { off.disabled = false; say(document.getElementById('auOffMsg'), error.message, true); });
    });
  })();
</script>
