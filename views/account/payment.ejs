<style>
      :root {
        --primary: #01535b;
        --primary-hover: #014147;
        --primary-hover-fill: color-mix(in srgb, var(--primary) 88%, white);
        --text-primary: #0f172a;
        --text-secondary: #475569;
        --border: #dbe3ea;
        --surface: #ffffff;
        --surface-soft: #f8fafc;
      }

      body {
        margin: 0;
        background: linear-gradient(180deg, #f3f6f8 0%, #eef2f6 100%);
      }

      .payment-container {
        max-width: 760px;
        margin: 28px auto 40px;
        padding: 18px;
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 16px;
        box-shadow: 0 18px 44px rgba(15, 23, 42, 0.09);
      }

      .payment-header {
        text-align: center;
        margin: 2px 0 20px;
      }

      .payment-header h1 {
        margin: 0 0 6px;
        font-size: 2rem;
        line-height: 1.2;
        color: var(--text-primary);
      }

      .payment-header p {
        margin: 0;
        color: var(--text-secondary);
        font-size: 0.96rem;
      }

      .card-block {
        background: var(--surface-soft);
        border: 1px solid var(--border);
        border-radius: 12px;
        padding: 14px;
        margin-bottom: 14px;
      }

      .payment-side-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 14px;
      }

      .payment-single-column {
        display: block;
      }

      .side-card-title {
        margin: 0 0 10px;
        color: var(--text-primary);
        font-size: 1rem;
        font-weight: 700;
      }

      .stripe-card-shell {
        margin-top: 14px;
        padding: 18px;
        border: 1px solid #d7e2ea;
        border-radius: 16px;
        background: linear-gradient(180deg, #ffffff 0%, #f7fafc 100%);
        box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.9);
      }

      .express-shell {
        display: none;
        margin-top: 14px;
        padding: 14px;
        border: 1px solid #dbe7ee;
        border-radius: 14px;
        background: linear-gradient(180deg, #ffffff 0%, #f4f9fb 100%);
      }

      .express-shell.is-visible {
        display: block;
      }

      .express-shell-header {
        display: flex;
        flex-direction: column;
        gap: 4px;
        margin-bottom: 10px;
      }

      .express-shell-title {
        margin: 0;
        color: var(--text-primary);
        font-size: 0.96rem;
        font-weight: 700;
      }

      .express-shell-copy {
        margin: 0;
        color: var(--text-secondary);
        font-size: 0.82rem;
        line-height: 1.45;
      }

      .wallet-divider {
        margin: 0 0 12px;
        font-size: 0.82rem;
        color: #64748b;
        text-align: center;
        font-weight: 600;
        letter-spacing: 0.02em;
      }

      .payment-method-block {
        position: relative;
        overflow: hidden;
      }

      .payment-method-block::before {
        content: "";
        position: absolute;
        inset: 0 0 auto 0;
        height: 4px;
        background: linear-gradient(90deg, #0f766e 0%, #1693a5 100%);
      }

      .payment-method-head {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 12px;
        margin-bottom: 10px;
      }

      .payment-method-copy {
        min-width: 0;
      }

      .payment-method-note {
        font-size: 0.95rem;
        color: #334155;
        margin: 6px 0 0;
        text-align: left;
        line-height: 1.5;
      }

      .payment-method-badge {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        white-space: nowrap;
        padding: 7px 12px;
        border-radius: 999px;
        border: 1px solid #cfe3e7;
        background: #ecf8f8;
        color: #0f5e66;
        font-size: 0.76rem;
        font-weight: 800;
        letter-spacing: 0.04em;
        text-transform: uppercase;
      }

      .card-entry-shell {
        margin-top: 0;
        padding: 14px;
        border: 1px solid #dbe3ea;
        border-radius: 14px;
        background: #ffffff;
      }

      .card-entry-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
        margin-bottom: 12px;
      }

      .card-entry-title {
        margin: 0;
        color: var(--text-primary);
        font-size: 0.95rem;
        font-weight: 700;
      }

      .card-entry-subtitle {
        margin: 4px 0 0;
        color: #64748b;
        font-size: 0.82rem;
      }

      .card-entry-badge {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 6px 10px;
        border-radius: 999px;
        background: #f8fafc;
        border: 1px solid #dbe3ea;
        color: #475569;
        font-size: 0.76rem;
        font-weight: 700;
      }

      #stripe-card-element {
        padding: 14px 12px;
        border: 1px solid #dbe3ea;
        border-radius: 12px;
        background: #ffffff;
        min-height: 22px;
      }

      .stripe-card-error {
        display: none;
        margin-top: 12px;
        color: #b91c1c;
        font-size: 0.92rem;
      }

      .gateway-choice-group {
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
        margin: 12px 0 14px;
      }

      .gateway-choice-btn {
        border: 1px solid var(--border);
        background: #fff;
        color: var(--text-primary);
        border-radius: 999px;
        padding: 10px 14px;
        font-size: 0.95rem;
        font-weight: 700;
        cursor: pointer;
      }

      .gateway-choice-btn.is-active {
        background: var(--primary);
        color: #fff;
        border-color: var(--primary);
      }

      .gateway-smart-note {
        margin: 8px 0 0;
        color: var(--text-secondary);
        font-size: 0.92rem;
      }

      .stripe-help-note {
        margin-top: 14px;
        padding: 12px 14px;
        border-radius: 14px;
        border: 1px solid #dbe7ee;
        background: #ffffff;
        color: var(--text-secondary);
        font-size: 0.86rem;
        line-height: 1.55;
      }

      .stripe-help-note strong {
        color: var(--text-primary);
      }

      .stripe-help-note-title {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        margin-bottom: 6px;
        color: var(--text-primary);
        font-size: 0.84rem;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 0.04em;
      }

      .stripe-help-note-lines {
        display: grid;
        gap: 2px;
      }

      .gateway-flow-note {
        margin-top: 12px;
        padding: 12px 14px;
        border-radius: 12px;
        border: 1px solid var(--border);
        background: #ffffff;
        color: var(--text-secondary);
        font-size: 0.92rem;
        line-height: 1.6;
      }

      .gateway-flow-note strong {
        color: var(--text-primary);
      }

      h2 {
        margin: 0 0 12px;
        font-size: 1.55rem;
        color: var(--text-primary);
        text-align: center;
      }

      .section-title {
        margin: 0 0 10px;
        color: var(--text-primary);
        font-size: 1.1rem;
        font-weight: 700;
      }

      .summary-list {
        display: grid;
        gap: 8px;
      }

      .summary-highlight {
        text-align: center;
        color: #0f5132;
        font-weight: 700;
      }

      .summary-row {
        margin: 0;
        font-size: 1.03rem;
        color: #243242;
        line-height: 1.5;
      }

      .summary-subtext {
        margin: 0;
        font-size: 0.88rem;
        color: #0f5132;
        text-align: center;
        font-weight: 700;
      }

      .price-old-inline {
        color: #8a96a6;
        text-decoration: line-through;
        margin-right: 8px;
      }

      .price-free-inline {
        color: #0d8d5d;
        font-weight: 700;
      }

      .btn-primary {
        display: block;
        width: 100%;
        padding: 13px 14px;
        font-size: 1.05rem;
        font-weight: 700;
        color: #fff;
        background: linear-gradient(135deg, var(--primary), #0b6a74);
        border: none;
        border-radius: 10px;
        cursor: pointer;
        text-align: center;
        margin-top: 12px;
        transition: all 0.2s ease;
      }

      .btn-primary:hover {
        background: var(--primary-hover-fill, var(--primary-hover));
        transform: translateY(-1px);
      }

      .btn-primary:disabled {
        background: #94a3b8;
        cursor: not-allowed;
        transform: none;
      }

      @keyframes fadeIn {
        from {
          opacity: 0;
          transform: translateY(-10px);
        }
        to {
          opacity: 1;
          transform: translateY(0);
        }
      }

      #promo-section {
        margin: 10px 0 0;
        padding: 10px;
        border: 1px solid var(--border);
        border-radius: 10px;
        background-color: #ffffff;
      }

      .promo-inline {
        display: grid;
        grid-template-columns: minmax(0, 1fr) auto;
        gap: 10px;
        align-items: center;
      }

      .promo-inline .btn-primary {
        width: auto;
        min-width: 120px;
        margin-top: 0;
        padding-inline: 20px;
      }

      .promo-inline #promoCode {
        margin-bottom: 0;
      }

      #promo-section[hidden] {
        display: none;
      }

      .promo-toggle-btn {
        width: 100%;
        display: flex;
        align-items: center;
        justify-content: space-between;
        border: 1px dashed var(--border);
        background: #ffffff;
        border-radius: 10px;
        padding: 11px 12px;
        color: var(--text-primary);
        font-size: 0.95rem;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.2s ease;
      }

      .promo-toggle-btn:hover {
        border-color: var(--primary);
      }

      .promo-toggle-icon {
        font-size: 0.9rem;
        color: #64748b;
        transition: transform 0.2s ease;
      }

      .promo-toggle-btn[aria-expanded="true"] .promo-toggle-icon {
        transform: rotate(180deg);
      }

      #promoCode {
        width: 100%;
        padding: 12px;
        border: 1px solid var(--border);
        border-radius: 8px;
        margin-bottom: 10px;
        box-sizing: border-box;
        font-size: 1rem;
      }

      #promoCode:focus {
        outline: none;
        border-color: var(--primary);
        box-shadow: 0 0 0 3px rgba(1, 83, 91, 0.12);
      }

      #payment-message {
        margin-top: 12px;
        font-size: 14px;
        font-weight: bold;
        color: red;
        background: linear-gradient(180deg, #ffffff 0%, #f9fbfd 100%);
        display: none;
      }

      .payment-options {
        margin-top: 20px;
      }

      .payment-options a {
        display: block;
        color: #01535b;
        text-decoration: none;
        font-size: 14px;
      }

      .payment-options a:hover {
        text-decoration: underline;
      }

      .redirect-overlay {
        position: fixed;
        inset: 0;
        background: rgba(255, 255, 255, 0.92);
        backdrop-filter: blur(2px);
        display: none;
        align-items: center;
        justify-content: center;
        z-index: 10000;
      }

      .redirect-overlay.active {
        display: flex;
      }

      .redirect-overlay-content {
        text-align: center;
        padding: 24px;
        max-width: 360px;
      }

      .redirect-overlay-spinner {
        width: 46px;
        height: 46px;
        border: 4px solid #dbe3ea;
        border-top-color: var(--primary);
        border-radius: 50%;
        margin: 0 auto 14px;
        animation: spin 0.8s linear infinite;
      }

      .redirect-overlay-title {
        margin: 0;
        font-size: 1.1rem;
        font-weight: 700;
        color: var(--text-primary);
      }

      .redirect-overlay-subtitle {
        margin: 8px 0 0;
        font-size: 0.94rem;
        color: var(--text-secondary);
      }

      .redirect-overlay-status {
        margin: 12px 0 0;
        min-height: 1.3em;
        font-size: 0.92rem;
        color: #0f5132;
        font-weight: 700;
      }

      .redirect-overlay-status-secondary {
        margin: 8px 0 0;
        min-height: 1.2em;
        font-size: 0.88rem;
        color: #475569;
        font-weight: 600;
      }

      .flash-message {
        padding: 15px;
        margin-bottom: 20px;
        border-radius: 4px;
      }

      .flash-error {
        background-color: #f8d7da;
        color: #721c24;
        border: 1px solid #f5c6cb;
      }

      .trial-date-label {
        display: block;
        font-size: 0.92rem;
        color: #1e293b;
        margin-bottom: 6px;
        font-weight: 700;
      }

      .trial-date-hint {
        margin: 0 0 10px;
        color: #475569;
        font-size: 0.86rem;
      }

      .trial-date-toggle-btn {
        width: 100%;
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        border: 1px dashed var(--border);
        background: #ffffff;
        border-radius: 10px;
        padding: 11px 12px;
        color: var(--text-primary);
        font-size: 0.95rem;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.2s ease;
      }

      .trial-date-toggle-btn:hover {
        border-color: var(--primary);
      }

      .trial-date-toggle-left {
        display: inline-flex;
        flex-direction: row;
        align-items: flex-start;
        gap: 8px;
        min-width: 0;
        flex: 1 1 auto;
      }

      .trial-date-toggle-label {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        flex-wrap: nowrap;
        min-width: 0;
        white-space: nowrap;
      }

      .trial-date-current {
        font-size: 0.83rem;
        color: #0f5132;
        font-weight: 700;
        line-height: 1.35;
        white-space: nowrap;
      }

      .trial-date-toggle-btn[aria-expanded="true"] .promo-toggle-icon {
        transform: rotate(180deg);
      }

      #trial-date-section {
        margin-top: 10px;
      }

      #trial-date-section[hidden] {
        display: none;
      }

      .trial-date-input {
        width: 100%;
        padding: 11px 12px;
        border: 1px solid var(--border);
        border-radius: 8px;
        font-size: 1rem;
        background: #fff;
        box-sizing: border-box;
      }

      .trial-date-input:focus {
        outline: none;
        border-color: var(--primary);
        box-shadow: 0 0 0 3px rgba(1, 83, 91, 0.12);
      }

      @media (max-width: 640px) {
        .payment-container {
          margin: 14px auto 24px;
          padding: 12px;
          border-radius: 12px;
        }

        .payment-header h1 {
          font-size: 1.55rem;
        }

        h2 {
          font-size: 1.32rem;
        }

        .summary-row {
          font-size: 0.96rem;
        }

        .payment-method-head,
        .card-entry-head {
          flex-direction: column;
          align-items: flex-start;
        }

        .trial-date-toggle-btn {
          gap: 10px;
        }

        .promo-inline {
          grid-template-columns: minmax(0, 1fr) 120px;
        }

        .btn-primary {
          font-size: 0.98rem;
        }

        .redirect-overlay-content {
          max-width: 90vw;
          padding: 18px;
        }
      }

      @media (max-width: 420px) {
        .stripe-card-shell,
        .express-shell,
        .card-entry-shell {
          padding: 12px;
          border-radius: 12px;
        }

        .promo-inline {
          grid-template-columns: minmax(0, 1fr) auto;
          gap: 8px;
        }

        .promo-inline .btn-primary {
          width: auto;
          min-width: 92px;
          padding-inline: 16px;
          font-size: 0.94rem;
          white-space: nowrap;
        }

        .promo-inline #promoCode {
          min-width: 0;
          font-size: 0.95rem;
          padding: 11px 10px;
        }

        .trial-date-toggle-btn {
          padding: 10px 11px;
        }

        .trial-date-current {
          font-size: 0.8rem;
        }

        .redirect-overlay-spinner {
          width: 40px;
          height: 40px;
        }

        .redirect-overlay-title {
          font-size: 1rem;
        }

        .redirect-overlay-subtitle {
          font-size: 0.88rem;
        }
      }
  </style>
<%- include('../partials/flash') %>
<script src="https://js.stripe.com/v3/"></script>
<div class="payment-container">
  <% const resolvedStripeConfigError = typeof stripeConfigError !== 'undefined' ? stripeConfigError : ''; %>
  <% const rawPlanName = (registrationDetails && registrationDetails.plan) ? decodeURIComponent(registrationDetails.plan) : ""; %>
  <% const planNameDisplay = rawPlanName ? rawPlanName.charAt(0).toUpperCase() + rawPlanName.slice(1) : "Selected plan"; %>
  <form id="payment-form" action="/account/payment" method="POST">
    <input type="hidden" name="paymentReference" id="paymentReference" />
    <input type="hidden" name="paymentIntentId" id="paymentIntentId" />
    <input type="hidden" name="promoCode" id="hiddenPromoCode" />
    <input type="hidden" name="selectedGateway" id="selectedGateway" value="" />

    <% if (registrationDetails && registrationDetails.plan) { %>
      <div class="payment-header">
        <h1>Complete Your Payment</h1>
      </div>

      <div class="card-block">
        <h2>Payment Summary</h2>
        <% if (isTrialCheckout && freeTrialLengthLabel) { %>
          <p class="summary-row summary-highlight"><strong>Free Trial:</strong> <%= freeTrialLengthLabel %></p>
        <% } %>
        <% if (trialEndDisplay) { %>
          <p class="summary-row summary-highlight"><strong>Trial Ends:</strong> <%= trialEndDisplay %></p>
        <% } %>
        <div class="summary-list">
          <p class="summary-row"><strong>Organization:</strong> <%= registrationDetails.orgName || 'N/A' %></p>
          <p class="summary-row"><strong>Email:</strong> <%= registrationDetails.email || 'N/A' %></p>
          <p class="summary-row"><strong>Plan:</strong> <%= planNameDisplay %></p>
          <% if (!isTrialCheckout) { %>
            <p class="summary-row" id="subtotal-row"><strong>Plan Subtotal:</strong> <span id="subtotal-currency"><%= stripeChargeCurrency || 'USD' %></span> <span id="subtotal-amount"><%= stripePaymentDetails ? Number(stripePaymentDetails.subtotalAmount || 0).toFixed(2) : (paymentDetails.amount / 100).toFixed(2) %></span></p>
            <p class="summary-row" id="platform-fee-row" style="display:<%= stripePaymentDetails && Number(stripePaymentDetails.platformFeeAmount || 0) > 0 ? '' : 'none' %>;"><strong id="platform-fee-label">Platform Fee (<%= Number(stripePaymentDetails?.platformFeePercentage || 0).toFixed(2).replace(/\.00$/, '') %>%)</strong>: <span id="platform-fee-currency"><%= stripeChargeCurrency || 'USD' %></span> <span id="platform-fee-amount"><%= stripePaymentDetails ? Number(stripePaymentDetails.platformFeeAmount || 0).toFixed(2) : '0.00' %></span></p>
            <p class="summary-row" id="amount-due-row"><strong>Total Due:</strong> <span id="amount-due-currency"><%= stripeChargeCurrency || 'USD' %></span> <span id="amount-due"><%= stripePaymentDetails ? (stripePaymentDetails.amount / 100).toFixed(2) : (paymentDetails.amount / 100).toFixed(2) %></span></p>
          <% } %>
          <% if (isTrialCheckout && freeTrialLengthLabel) { %>
            <p class="summary-row"><strong>Renewal Price:</strong> <span class="price-old-inline"><%= postTrialPriceDisplay || ("USD 0.00") %></span><span class="price-free-inline">FREE for <%= freeTrialLengthLabel %></span></p>
          <% } else { %>
            <p class="summary-row"><strong>Renewal Price:</strong> <%= postTrialPriceDisplay || ("USD 0.00") %></p>
          <% } %>
        </div>
      </div>

      <div class="<%= isTrialCheckout ? 'payment-side-grid' : 'payment-single-column' %>">
      <div class="card-block">
        <h3 class="side-card-title">Promo Code</h3>
        <button type="button" id="promo-toggle" class="promo-toggle-btn" aria-expanded="false" aria-controls="promo-section">
          <span>Have a promo code?</span>
          <span class="promo-toggle-icon">▾</span>
        </button>
        <div id="promo-section" hidden>
          <div class="promo-inline">
            <input type="text" id="promoCode" name="promoCode" placeholder="Enter promo code" />
            <button type="button" id="applyPromoCode" class="btn-primary">Apply</button>
          </div>
          <p id="promo-message" style="color: green; display: none">Promo code applied successfully!</p>
          <p id="promo-error" style="color: red; display: none"></p>
        </div>
      </div>

      <% if (isTrialCheckout) { %>
        <div class="card-block">
          <h3 class="side-card-title">Trial Start Date</h3>
          <button type="button" id="trial-date-toggle" class="trial-date-toggle-btn" aria-expanded="false" aria-controls="trial-date-section">
            <span class="trial-date-toggle-left">
              <span id="trial-date-current" class="trial-date-toggle-label"></span>
            </span>
            <span class="promo-toggle-icon">▾</span>
          </button>
          <div id="trial-date-section" hidden>
            <label for="trialStartDate" class="trial-date-label">When does your semester start?</label>
            <input
              type="date"
              id="trialStartDate"
              name="trialStartDate"
              class="trial-date-input"
              min="<%= trialStartDateMin %>"
              max="<%= trialStartDateMax %>"
              value="<%= trialStartDateValue %>"
              required
            />
          </div>
        </div>
      <% } %>
      </div>

      <div class="card-block payment-method-block">
        <div class="payment-method-head">
          <div class="payment-method-copy">
            <h3 class="section-title">Payment Method</h3>
            <p class="payment-method-note">Pay securely with Stripe using your card, or a supported wallet when it is available on your device and browser.</p>
          </div>
          <span class="payment-method-badge">Stripe Secure</span>
        </div>

        <div class="stripe-card-shell" id="stripe-card-shell">
          <% if (resolvedStripeConfigError) { %>
          <div class="stripe-help-note" style="display: block; border-color: rgba(220, 38, 38, 0.25); background: rgba(254, 242, 242, 0.9); color: #991b1b;">
            <div class="stripe-help-note-title">Stripe configuration error</div>
            <div class="stripe-help-note-lines">
              <div><%= resolvedStripeConfigError %></div>
              <div>Update the Stripe mode or keys in admin settings or environment variables, then refresh this page.</div>
            </div>
          </div>
          <% } %>
          <div class="card-entry-shell">
            <div class="card-entry-head">
              <div>
                <p class="card-entry-title">Card details</p>
                <p class="card-entry-subtitle">Your card will be encrypted and saved for future billing on this plan.</p>
              </div>
              <span class="card-entry-badge">Visa / MasterCard</span>
            </div>
            <div id="stripe-card-element"></div>
            <div class="express-shell" id="express-shell">
              <div class="express-shell-header">
                <p class="express-shell-title">Express Checkout</p>
                <p class="express-shell-copy">Show Apple Pay or Google Pay when your browser, device, and Stripe domain setup support them.</p>
              </div>
              <div class="wallet-divider">Or use a supported wallet</div>
              <div id="express-checkout-element"></div>
            </div>
          </div>
          <p id="stripe-card-error" class="stripe-card-error"></p>
          <% if (stripeMode === 'test') { %>
          <div class="stripe-help-note" id="stripe-help-note">
            <div class="stripe-help-note-title">Test mode</div>
            <div class="stripe-help-note-lines">
              <div>Use <strong>4242 4242 4242 4242</strong> for a successful test payment.</div>
              <div>Use any future expiry date, any 3-digit CVC, and any ZIP or postal code.</div>
              <div>Apple Pay and Google Pay only appear on supported devices, browsers, and verified domains.</div>
            </div>
          </div>
          <% } %>
        </div>

        <div class="gateway-flow-note" id="gateway-flow-note" aria-live="polite"></div>

        <% if (isTrialCheckout) { %>
          <button type="button" id="pay-button" class="btn-primary">Begin Free Trial</button>
        <% } else { %>
          <button type="button" id="pay-button" class="btn-primary">Continue to Payment</button>
        <% } %>
      </div>

      <div id="payment-message"></div>

    <% } else { %>
      <p style="text-align: center; color: red">No registration details found. Please go back and register again.</p>
    <% } %>
  </form>
</div>
<div id="redirect-overlay" class="redirect-overlay" aria-hidden="true" role="status" aria-live="polite">
  <div class="redirect-overlay-content">
    <div class="redirect-overlay-spinner" aria-hidden="true"></div>
    <p class="redirect-overlay-title">Setting up your school...</p>
    <p class="redirect-overlay-subtitle">Don&apos;t leave this page.</p>
    <p id="redirect-overlay-status" class="redirect-overlay-status" aria-live="polite"></p>
    <p id="redirect-overlay-status-secondary" class="redirect-overlay-status-secondary" aria-live="polite"></p>
  </div>
</div>
<script>
      document.addEventListener("DOMContentLoaded", function () {
        const baseStripeAmount = parseInt('<%= stripePaymentDetails ? stripePaymentDetails.amount : paymentDetails.amount %>', 10);
  const baseStripeSubtotalAmount = parseInt('<%= stripePaymentDetails ? Math.round(Number(stripePaymentDetails.subtotalAmount || 0) * 100) : paymentDetails.amount %>', 10);
  const platformFeePercentage = Number(<%- JSON.stringify(stripePaymentDetails ? Number(stripePaymentDetails.platformFeePercentage || 0) : 0) %>);
        let finalStripeAmount = baseStripeAmount;
        let appliedPromoCode = '';
  let appliedPromoDiscount = 0;
        let isSubmittingAfterPayment = false;
        const stripeConfigError = <%- JSON.stringify(resolvedStripeConfigError || '') %>;
        const stripePublishableKey = <%- JSON.stringify(stripePublishableKey || '') %>;
        const stripeMode = <%- JSON.stringify(stripeMode || 'test') %>;
        const stripeChargeCurrency = <%- JSON.stringify(stripeChargeCurrency || 'USD') %>;
        const isTrialCheckout = <%- JSON.stringify(Boolean(isTrialCheckout)) %>;
        const redirectOverlay = document.getElementById("redirect-overlay");
        const redirectStatusText = document.getElementById("redirect-overlay-status");
        const redirectSecondaryStatusText = document.getElementById("redirect-overlay-status-secondary");
        const stripeCardError = document.getElementById("stripe-card-error");
        const stripeCardShell = document.getElementById("stripe-card-shell");
        const stripeHelpNote = document.getElementById("stripe-help-note");
        const expressShell = document.getElementById("express-shell");
        const gatewayFlowNote = document.getElementById("gateway-flow-note");
        const subtotalCurrencyEl = document.getElementById('subtotal-currency');
        const subtotalAmountEl = document.getElementById('subtotal-amount');
        const platformFeeRowEl = document.getElementById('platform-fee-row');
        const platformFeeLabelEl = document.getElementById('platform-fee-label');
        const platformFeeCurrencyEl = document.getElementById('platform-fee-currency');
        const platformFeeAmountEl = document.getElementById('platform-fee-amount');
        const selectedGatewayInput = document.getElementById("selectedGateway");
        const payButtonEl = document.getElementById("pay-button");
        let stripe = null;
        let stripeCardElement = null;
        let expressCheckoutElement = null;
        let stripeElements = null;
        let isStripeCardComplete = false;
        let isPayButtonBusy = false;
        const currentGateway = 'stripe';
        if (selectedGatewayInput) {
          selectedGatewayInput.value = 'stripe';
        }

        function setPaymentMessage(text, color) {
          const paymentMessage = document.getElementById("payment-message");
          if (!paymentMessage) return;
          paymentMessage.textContent = text || '';
          paymentMessage.style.color = color || 'red';
          paymentMessage.style.display = text ? 'block' : 'none';
        }

        function formatMoney(amountMinor, currencyCode) {
          return `${currencyCode} ${(Math.max(0, Number(amountMinor) || 0) / 100).toFixed(2)}`;
        }

        function formatPercent(value) {
          const numeric = Number(value) || 0;
          return Number.isInteger(numeric) ? String(numeric) : numeric.toFixed(2).replace(/\.00$/, '');
        }

        function computeDiscountedSubtotalAmount() {
          if (isTrialCheckout) return 0;
          return Math.max(0, Math.round(baseStripeSubtotalAmount * (1 - ((Number(appliedPromoDiscount) || 0) / 100))));
        }

        function computePlatformFeeAmount(amountMinor) {
          if (isTrialCheckout || !(platformFeePercentage > 0)) return 0;
          return Math.max(0, Math.round(amountMinor * (platformFeePercentage / 100)));
        }

        function getCurrentGatewayAmountText() {
          return formatMoney(finalStripeAmount, stripeChargeCurrency);
        }

        function updatePayButtonLabel() {
          if (!payButtonEl) return;
          if (isPayButtonBusy) {
            payButtonEl.textContent = 'Processing...';
            return;
          }
          if (isTrialCheckout) {
            payButtonEl.textContent = 'Begin Free Trial';
            return;
          }
          payButtonEl.textContent = `Pay ${getCurrentGatewayAmountText()} with Stripe`;
        }

        function updatePayButtonState() {
          if (!payButtonEl) return;
          payButtonEl.disabled = Boolean(stripeConfigError) || isPayButtonBusy || !stripe || !stripeCardElement || !isStripeCardComplete;
          updatePayButtonLabel();
        }

        function requireCompletedStripeCardDetails() {
          if (isStripeCardComplete) return true;
          if (stripeCardError) {
            stripeCardError.textContent = 'Enter complete card details before continuing.';
            stripeCardError.style.display = 'block';
          }
          setPaymentMessage('Complete your Stripe card details before continuing.', 'red');
          if (stripeCardElement && typeof stripeCardElement.focus === 'function') {
            stripeCardElement.focus();
          }
          return false;
        }

        function updateAmountDueRow() {
          const subtotalMinor = computeDiscountedSubtotalAmount();
          const platformFeeMinor = computePlatformFeeAmount(subtotalMinor);
          const currencyEl = document.getElementById('amount-due-currency');
          const amountEl = document.getElementById('amount-due');
          finalStripeAmount = subtotalMinor + platformFeeMinor;
          if (subtotalCurrencyEl && subtotalAmountEl) {
            subtotalCurrencyEl.textContent = stripeChargeCurrency;
            subtotalAmountEl.textContent = (Math.max(0, subtotalMinor) / 100).toFixed(2);
          }
          if (platformFeeLabelEl) {
            platformFeeLabelEl.textContent = `Platform Fee (${formatPercent(platformFeePercentage)}%)`;
          }
          if (platformFeeCurrencyEl && platformFeeAmountEl) {
            platformFeeCurrencyEl.textContent = stripeChargeCurrency;
            platformFeeAmountEl.textContent = (Math.max(0, platformFeeMinor) / 100).toFixed(2);
          }
          if (platformFeeRowEl) {
            platformFeeRowEl.style.display = !isTrialCheckout && platformFeeMinor > 0 ? '' : 'none';
          }
          if (!currencyEl || !amountEl) return;
          currencyEl.textContent = stripeChargeCurrency;
          amountEl.textContent = (Math.max(0, finalStripeAmount) / 100).toFixed(2);
        }

        function updateGatewayFlowNote() {
          if (!gatewayFlowNote) return;
          gatewayFlowNote.innerHTML = stripeConfigError
            ? `<span style="color:#991b1b;">${stripeConfigError}</span>`
            : '';
          gatewayFlowNote.style.display = gatewayFlowNote.innerHTML ? 'block' : 'none';
          if (stripeHelpNote) {
            stripeHelpNote.style.display = stripeMode === 'test' ? 'block' : 'none';
          }
        }

        function updateExpressCheckoutAmount() {
          if (!stripeElements || isTrialCheckout) return;
          stripeElements.update({
            amount: Math.max(0, finalStripeAmount)
          });
        }

        updateAmountDueRow();

        if (stripePublishableKey && window.Stripe) {
          stripe = window.Stripe(stripePublishableKey);
          stripeElements = !isTrialCheckout
            ? stripe.elements({
                mode: 'payment',
                amount: Math.max(0, finalStripeAmount),
                currency: String(stripeChargeCurrency || 'USD').toLowerCase(),
                paymentMethodTypes: ['card'],
              })
            : stripe.elements();

          if (!isTrialCheckout && expressShell) {
            expressCheckoutElement = stripeElements.create('expressCheckout', {
              emailRequired: true,
              paymentMethods: {
                applePay: 'always',
                googlePay: 'always',
              },
              layout: {
                maxColumns: 2,
                maxRows: 2,
                overflowMenu: 'auto'
              },
              buttonHeight: 44,
            });

            expressCheckoutElement.on('ready', function(event) {
              if (event && event.availablePaymentMethods) {
                expressShell.classList.add('is-visible');
              }
            });

            expressCheckoutElement.on('confirm', async function(event) {
              try {
                setPaymentMessage('', 'red');

                const submitResult = await stripeElements.submit();
                if (submitResult.error) {
                  throw submitResult.error;
                }

                const intentResponse = await fetch('/account/payment/stripe-intent', {
                  method: 'POST',
                  headers: {
                    'Content-Type': 'application/json'
                  },
                  body: JSON.stringify({
                    promoCode: appliedPromoCode,
                    trialStartDate: trialStartDateInput ? trialStartDateInput.value : '',
                    selectedGateway: 'stripe'
                  })
                });

                const intentData = await intentResponse.json();
                if (!intentResponse.ok || !intentData.success) {
                  throw new Error(intentData.message || 'Unable to initialize Stripe payment.');
                }

                const confirmation = await stripe.confirmPayment({
                  elements: stripeElements,
                  clientSecret: intentData.clientSecret,
                  redirect: 'if_required'
                });

                if (confirmation.error) {
                  throw confirmation.error;
                }

                const completedIntent = confirmation.paymentIntent;
                if (!completedIntent || completedIntent.status !== 'succeeded') {
                  throw new Error('Stripe payment was not completed.');
                }

                document.getElementById('paymentIntentId').value = completedIntent.id;
                document.getElementById('hiddenPromoCode').value = appliedPromoCode;

                showRedirectOverlay();
                startRedirectProgressMessages();
                document.getElementById('payment-form').action = '/account/payment/confirm';
                setTimeout(function() {
                  document.getElementById('payment-form').submit();
                }, 800);
              } catch (expressError) {
                console.error('Express checkout error:', expressError);
                setPaymentMessage(expressError.message || 'Unable to complete express checkout.', 'red');
              }
            });

            expressCheckoutElement.mount('#express-checkout-element');
          }

          stripeCardElement = stripeElements.create('card', {
            hidePostalCode: true,
            style: {
              base: {
                color: '#0f172a',
                fontSize: '16px',
                '::placeholder': {
                  color: '#94a3b8'
                }
              }
            }
          });

          stripeCardElement.mount('#stripe-card-element');
          stripeCardElement.on('change', function(event) {
            isStripeCardComplete = Boolean(event.complete);
            if (stripeCardError) {
              stripeCardError.textContent = event.error ? event.error.message : '';
              stripeCardError.style.display = event.error ? 'block' : 'none';
            }
            if (event.complete && !event.error) {
              setPaymentMessage('', 'red');
            }
            updatePayButtonState();
          });
          updatePayButtonState();
        } else {
          if (stripeCardError) {
            stripeCardError.textContent = 'Stripe is not configured. Please contact support.';
            stripeCardError.style.display = 'block';
          }
          updatePayButtonState();
        }

        if (stripeConfigError) {
          setPaymentMessage(stripeConfigError, 'red');
        }
        const redirectProgressMessages = [
          "Just a few seconds left, hang tight...",
          "Now almost there...",
          "Setup almost complete..."
        ];
        const redirectSecondaryMessages = [
          "Running final checks...",
          "Applying finishing touches...",
          "Preparing your dashboard..."
        ];
        let redirectProgressTimeouts = [];

      function setRedirectStatusText(message) {
        if (!redirectStatusText) return;
        redirectStatusText.textContent = message || "";
      }

      function setRedirectSecondaryStatusText(message) {
        if (!redirectSecondaryStatusText) return;
        redirectSecondaryStatusText.textContent = message || "";
      }

      function clearRedirectProgressMessages() {
        redirectProgressTimeouts.forEach(function(timeoutId) {
          clearTimeout(timeoutId);
        });
        redirectProgressTimeouts = [];
      }

      function startRedirectProgressMessages() {
        clearRedirectProgressMessages();
        setRedirectStatusText("");
        setRedirectSecondaryStatusText("");

        const baseDelay = 1800;
        const stepDelay = 2200;
        const secondaryStartDelay = baseDelay + ((redirectProgressMessages.length - 1) * stepDelay) + 1700;
        const secondaryStepDelay = 1700;

        redirectProgressMessages.forEach(function(message, index) {
          const timeoutId = setTimeout(function() {
            setRedirectStatusText(message);
          }, baseDelay + (index * stepDelay));
          redirectProgressTimeouts.push(timeoutId);
        });

        redirectSecondaryMessages.forEach(function(message, index) {
          const timeoutId = setTimeout(function() {
            setRedirectSecondaryStatusText(message);
          }, secondaryStartDelay + (index * secondaryStepDelay));
          redirectProgressTimeouts.push(timeoutId);
        });
      }

      function showRedirectOverlay() {
        if (!redirectOverlay) return;
        redirectOverlay.classList.add("active");
        redirectOverlay.setAttribute("aria-hidden", "false");
      }

      function hideRedirectOverlay() {
        if (!redirectOverlay) return;
        redirectOverlay.classList.remove("active");
        redirectOverlay.setAttribute("aria-hidden", "true");
        clearRedirectProgressMessages();
        setRedirectStatusText("");
        setRedirectSecondaryStatusText("");
      }

      function confirmPayment() {
        return confirm(
          "You are about to proceed with the payment for the selected plan. Do you consent to proceed?"
        );
      }

      const promoToggleBtn = document.getElementById("promo-toggle");
      const promoSectionEl = document.getElementById("promo-section");
      function setPromoExpanded(expanded) {
        if (!promoToggleBtn || !promoSectionEl) return;
        promoToggleBtn.setAttribute("aria-expanded", expanded ? "true" : "false");
        promoSectionEl.hidden = !expanded;
      }

      if (promoToggleBtn && promoSectionEl) {
        setPromoExpanded(false);
        promoToggleBtn.addEventListener("click", function() {
          const isExpanded = promoToggleBtn.getAttribute("aria-expanded") === "true";
          setPromoExpanded(!isExpanded);
        });
      }

      const trialDateToggleBtn = document.getElementById("trial-date-toggle");
      const trialDateSectionEl = document.getElementById("trial-date-section");
      const trialStartDateInput = document.getElementById("trialStartDate");
      const trialDateCurrentEl = document.getElementById("trial-date-current");

      function formatTrialDateLabel(dateValue) {
        if (!dateValue) return "";
        const parts = dateValue.split("-");
        if (parts.length !== 3) return dateValue;
        const year = parts[0].slice(-2);
        const month = parts[1].padStart(2, "0");
        const day = parts[2].padStart(2, "0");
        return `${month}/${day}/${year}`;
      }

      function updateTrialDateCurrentLabel() {
        if (!trialDateCurrentEl || !trialStartDateInput) return;
        const prettyDate = formatTrialDateLabel(trialStartDateInput.value);
        trialDateCurrentEl.textContent = prettyDate ? `Change : (Now: ${prettyDate})` : "Change";
      }

      function setTrialDateExpanded(expanded) {
        if (!trialDateToggleBtn || !trialDateSectionEl) return;
        trialDateToggleBtn.setAttribute("aria-expanded", expanded ? "true" : "false");
        trialDateSectionEl.hidden = !expanded;
      }

      if (trialDateToggleBtn && trialDateSectionEl) {
        setTrialDateExpanded(false);
        updateTrialDateCurrentLabel();
        trialDateToggleBtn.addEventListener("click", function() {
          const isExpanded = trialDateToggleBtn.getAttribute("aria-expanded") === "true";
          setTrialDateExpanded(!isExpanded);
        });
        if (trialStartDateInput) {
          trialStartDateInput.addEventListener("change", updateTrialDateCurrentLabel);
          trialStartDateInput.addEventListener("input", updateTrialDateCurrentLabel);
        }
      }

      // Promo code functionality
      const applyBtn = document.getElementById("applyPromoCode");
      if (applyBtn) {
        applyBtn.addEventListener("click", async function() {
        const promoCode = document.getElementById("promoCode").value.trim();
        const promoMessage = document.getElementById("promo-message");
        const promoError = document.getElementById("promo-error");

        if (!promoCode) {
          setPromoExpanded(true);
          promoError.textContent = "Please enter a promo code.";
          promoError.style.display = "block";
          promoMessage.style.display = "none";
          return;
        }

        try {
          const response = await fetch(
            "/account/validate-promo?code=" + encodeURIComponent(promoCode)
          );
          const data = await response.json();

          if (data.success) {
            setPromoExpanded(true);
            promoMessage.style.display = "block";
            promoMessage.textContent = "✅ Promo applied! " + data.discount + "% discount.";
            promoError.style.display = "none";

            appliedPromoCode = promoCode;
            appliedPromoDiscount = Number(data.discount || 0);
            updateExpressCheckoutAmount();
            updatePayButtonLabel();
            updateGatewayFlowNote();
            updateAmountDueRow();
          } else {
            setPromoExpanded(true);
            promoMessage.style.display = "none";
            promoError.textContent = data.message || "Invalid promo code";
            promoError.style.display = "block";
          }
        } catch (error) {
          console.error("❌ Error applying promo code:", error);
          setPromoExpanded(true);
          promoError.textContent = "Error validating promo code.";
          promoError.style.display = "block";
          promoMessage.style.display = "none";
        }
        });
      }

      // Stripe payment functionality
      if (payButtonEl) {
        payButtonEl.addEventListener("click", async function() {
        setPaymentMessage('', 'red');
        if (trialStartDateInput) {
          const selectedDate = trialStartDateInput.value;
          const minDate = trialStartDateInput.min;
          const maxDate = trialStartDateInput.max;
          if (!selectedDate || selectedDate < minDate || selectedDate > maxDate) {
            setPaymentMessage("Please select a valid trial start date (today to 3 months ahead).", "red");
            trialStartDateInput.focus();
            return;
          }
        }

        if (!requireCompletedStripeCardDetails()) {
          return;
        }

        if (!confirmPayment()) {
          return;
        }

        // Show loading state
        isPayButtonBusy = true;
        updatePayButtonState();

        try {
          if (!stripe || !stripeCardElement) {
            throw new Error('Stripe is not available right now.');
          }

          const intentResponse = await fetch('/account/payment/stripe-intent', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json'
            },
            body: JSON.stringify({
              promoCode: appliedPromoCode,
              trialStartDate: trialStartDateInput ? trialStartDateInput.value : '',
              selectedGateway: 'stripe'
            })
          });

          const intentData = await intentResponse.json();
          if (!intentResponse.ok || !intentData.success) {
            throw new Error(intentData.message || 'Unable to initialize Stripe payment.');
          }

          const isSetupIntent = intentData.intentType === 'setup';
          const confirmation = isSetupIntent
            ? await stripe.confirmCardSetup(intentData.clientSecret, {
                payment_method: {
                  card: stripeCardElement,
                  billing_details: {
                    email: '<%= registrationDetails.email %>',
                    name: '<%= registrationDetails.firstName %> <%= registrationDetails.lastName %>'
                  }
                }
              })
            : await stripe.confirmCardPayment(intentData.clientSecret, {
                payment_method: {
                  card: stripeCardElement,
                  billing_details: {
                    email: '<%= registrationDetails.email %>',
                    name: '<%= registrationDetails.firstName %> <%= registrationDetails.lastName %>'
                  }
                }
              });

          if (confirmation.error) {
            throw new Error(confirmation.error.message || 'Unable to confirm Stripe payment.');
          }

          const completedIntent = isSetupIntent ? confirmation.setupIntent : confirmation.paymentIntent;
          if (!completedIntent || completedIntent.status !== 'succeeded') {
            throw new Error(isSetupIntent ? 'Stripe card setup was not completed.' : 'Stripe payment was not completed.');
          }

          isSubmittingAfterPayment = true;
          document.getElementById('paymentIntentId').value = completedIntent.id;
          document.getElementById('hiddenPromoCode').value = appliedPromoCode;

          setPaymentMessage(
            isSetupIntent
              ? "Card saved successfully! Setting up your school. Don't leave this page."
              : "Payment successful! Setting up your school. Don't leave this page.",
            "green"
          );

          showRedirectOverlay();
          startRedirectProgressMessages();
          document.getElementById('payment-form').action = '/account/payment/confirm';

          setTimeout(function() {
            document.getElementById("payment-form").submit();
          }, 1600);
        } catch (error) {
          console.error("Payment gateway error:", error);
          isPayButtonBusy = false;
          updatePayButtonState();
          isSubmittingAfterPayment = false;
          hideRedirectOverlay();

          setPaymentMessage(error.message || "Error loading payment gateway. Please refresh and try again.", "red");
        }
        });
      }

      updatePayButtonState();
      updateGatewayFlowNote();
      updateAmountDueRow();
    });
  </script>

