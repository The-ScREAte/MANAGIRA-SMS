<style>
      :root {
        --primary: #01535b;
        --primary-hover: #014147;
        --text-primary: #0f172a;
        --text-secondary: #475569;
        --border: #dbe3ea;
        --surface: #ffffff;
        --surface-soft: #f8fafc;
      }

      body {
        margin: 0;
        background: linear-gradient(180deg, #f3f6f8 0%, #eef2f6 100%);
      }

      .payment-container {
        max-width: 760px;
        margin: 28px auto 40px;
        padding: 18px;
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 16px;
        box-shadow: 0 18px 44px rgba(15, 23, 42, 0.09);
      }

      .payment-header {
        text-align: center;
        margin: 2px 0 20px;
      }

      .payment-header h1 {
        margin: 0 0 6px;
        font-size: 2rem;
        line-height: 1.2;
        color: var(--text-primary);
      }

      .payment-header p {
        margin: 0;
        color: var(--text-secondary);
        font-size: 0.96rem;
      }

      .card-block {
        background: var(--surface-soft);
        border: 1px solid var(--border);
        border-radius: 12px;
        padding: 14px;
        margin-bottom: 14px;
      }

      h2 {
        margin: 0 0 12px;
        font-size: 1.55rem;
        color: var(--text-primary);
        text-align: center;
      }

      .section-title {
        margin: 0 0 10px;
        color: var(--text-primary);
        font-size: 1.1rem;
        font-weight: 700;
      }

      .summary-list {
        display: grid;
        gap: 8px;
      }

      .summary-highlight {
        text-align: center;
        color: #0f5132;
        font-weight: 700;
      }

      .summary-row {
        margin: 0;
        font-size: 1.03rem;
        color: #243242;
        line-height: 1.5;
      }

      .summary-subtext {
        margin: 0;
        font-size: 0.88rem;
        color: #0f5132;
        text-align: center;
        font-weight: 700;
      }

      .btn-primary {
        display: block;
        width: 100%;
        padding: 13px 14px;
        font-size: 1.05rem;
        font-weight: 700;
        color: #fff;
        background: linear-gradient(135deg, var(--primary), #0b6a74);
        border: none;
        border-radius: 10px;
        cursor: pointer;
        text-align: center;
        margin-top: 12px;
        transition: all 0.2s ease;
      }

      .btn-primary:hover {
        background: linear-gradient(135deg, var(--primary-hover), #0a5a63);
        transform: translateY(-1px);
      }

      .btn-primary:disabled {
        background: #94a3b8;
        cursor: not-allowed;
        transform: none;
      }

      @keyframes fadeIn {
        from {
          opacity: 0;
          transform: translateY(-10px);
        }
        to {
          opacity: 1;
          transform: translateY(0);
        }
      }

      #promo-section {
        margin: 10px 0 0;
        padding: 10px;
        border: 1px solid var(--border);
        border-radius: 10px;
        background-color: #ffffff;
      }

      #promo-section[hidden] {
        display: none;
      }

      .promo-toggle-btn {
        width: 100%;
        display: flex;
        align-items: center;
        justify-content: space-between;
        border: 1px dashed var(--border);
        background: #ffffff;
        border-radius: 10px;
        padding: 11px 12px;
        color: var(--text-primary);
        font-size: 0.95rem;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.2s ease;
      }

      .promo-toggle-btn:hover {
        border-color: var(--primary);
      }

      .promo-toggle-icon {
        font-size: 0.9rem;
        color: #64748b;
        transition: transform 0.2s ease;
      }

      .promo-toggle-btn[aria-expanded="true"] .promo-toggle-icon {
        transform: rotate(180deg);
      }

      #promoCode {
        width: 100%;
        padding: 12px;
        border: 1px solid var(--border);
        border-radius: 8px;
        margin-bottom: 10px;
        box-sizing: border-box;
        font-size: 1rem;
      }

      #promoCode:focus {
        outline: none;
        border-color: var(--primary);
        box-shadow: 0 0 0 3px rgba(1, 83, 91, 0.12);
      }

      #payment-message {
        margin-top: 12px;
        font-size: 14px;
        font-weight: bold;
        color: red;
        text-align: center;
        display: none;
      }

      .payment-options {
        margin-top: 20px;
      }

      .payment-options a {
        display: block;
        color: #01535b;
        text-decoration: none;
        font-size: 14px;
      }

      .payment-options a:hover {
        text-decoration: underline;
      }

      .flash-message {
        padding: 15px;
        margin-bottom: 20px;
        border-radius: 4px;
      }

      .flash-error {
        background-color: #f8d7da;
        color: #721c24;
        border: 1px solid #f5c6cb;
      }

      .payment-method-note {
        font-size: 0.95rem;
        color: #334155;
        margin: 6px 0 10px;
        text-align: left;
      }

      @media (max-width: 640px) {
        .payment-container {
          margin: 14px auto 24px;
          padding: 12px;
          border-radius: 12px;
        }

        .payment-header h1 {
          font-size: 1.55rem;
        }

        h2 {
          font-size: 1.32rem;
        }

        .summary-row {
          font-size: 0.96rem;
        }

        .btn-primary {
          font-size: 0.98rem;
        }
      }
  </style>
<%- include('../partials/flash') %>
<script src="https://js.paystack.co/v1/inline.js"></script>
<div class="payment-container">
  <% const rawPlanName = (registrationDetails && registrationDetails.plan) ? decodeURIComponent(registrationDetails.plan) : ""; %>
  <% const planNameDisplay = rawPlanName ? rawPlanName.charAt(0).toUpperCase() + rawPlanName.slice(1) : "Selected plan"; %>
  <form id="payment-form" action="/account/payment" method="POST">
    <input type="hidden" name="paymentReference" id="paymentReference" />
    <input type="hidden" name="promoCode" id="hiddenPromoCode" />

    <% if (registrationDetails && registrationDetails.plan) { %>
      <div class="payment-header">
        <h1>Complete Your Payment</h1>
      </div>

      <div class="card-block">
        <h2>Payment Summary</h2>
        <% if (isTrialCheckout && freeTrialLengthLabel) { %>
          <p class="summary-row summary-highlight"><strong>Free Trial:</strong> <%= freeTrialLengthLabel %></p>
        <% } %>
        <% if (trialEndDisplay) { %>
          <p class="summary-row summary-highlight"><strong>Trial Ends:</strong> <%= trialEndDisplay %></p>
        <% } %>
        <div class="summary-list">
          <p class="summary-row"><strong>Organization:</strong> <%= registrationDetails.orgName || 'N/A' %></p>
          <p class="summary-row"><strong>Email:</strong> <%= registrationDetails.email || 'N/A' %></p>
          <p class="summary-row"><strong>Plan:</strong> <%= planNameDisplay %></p>
          <% if (!isTrialCheckout) { %>
            <p class="summary-row"><strong>Amount Due:</strong> GHS <span id="amount-due"><%= (paymentDetails.amount / 100).toFixed(2) %></span></p>
          <% } %>
          <p class="summary-row"><strong>Plan Price:</strong> <%= usdPriceDisplay || 'USD 0.00' %></p>
          <% if (currencyProfile && currencyProfile.userCurrency && currencyProfile.userCurrency !== 'USD') { %>
            <p class="summary-row"><strong>Local Estimate (<%= currencyProfile.userCurrency %>):</strong> <%= localizedPriceDisplay || 'N/A' %></p>
          <% } %>
          <p class="summary-row"><strong>Renewal Price:</strong> <%= postTrialPriceDisplay || ("USD 0.00") %></p>
          <% if (isTrialCheckout) { %>
            <p class="summary-row"><strong>Verification Charge:</strong>
              <span class="amount-display"><%= verificationChargeUsdDisplay || 'USD 0.00' %><% if (verificationChargeLocalDisplay) { %> / <%= verificationChargeLocalDisplay %><% } %></span>
              <span id="amount-due" style="display:none;"><%= (paymentDetails.amount / 100).toFixed(2) %></span>
            </p>
          <% } %>
          <p class="summary-subtext">Only <%= verificationChargeUsdDisplay || 'USD 0.00' %> will be charged today to verify your card.<br>Your bank may process this charge in your local currency.</p>
        </div>
      </div>

      <div class="card-block">
        <button type="button" id="promo-toggle" class="promo-toggle-btn" aria-expanded="false" aria-controls="promo-section">
          <span>Have a promo code?</span>
          <span class="promo-toggle-icon">▾</span>
        </button>
        <div id="promo-section" hidden>
          <input type="text" id="promoCode" name="promoCode" placeholder="Enter Promo Code" />
          <button type="button" id="applyPromoCode" class="btn-primary">Apply</button>
          <p id="promo-message" style="color: green; display: none">Promo code applied successfully!</p>
          <p id="promo-error" style="color: red; display: none"></p>
        </div>
      </div>

      <div class="card-block">
        <h3 class="section-title">Payment Method</h3>
        <p class="payment-method-note">Secure payment via Paystack (Visa &amp; MasterCard).</p>

        <% if (isTrialCheckout) { %>
          <button type="button" id="pay-button" class="btn-primary">Begin Free Trial</button>
        <% } else { %>
          <button type="button" id="pay-button" class="btn-primary">Pay <%= paystackChargeCurrency || 'GHS' %> <span id="final-amount"><%= (paymentDetails.amount / 100).toFixed(2) %></span></button>
        <% } %>
      </div>

      <div id="payment-message"></div>

    <% } else { %>
      <p style="text-align: center; color: red">No registration details found. Please go back and register again.</p>
    <% } %>
  </form>
</div>
<script>
      document.addEventListener("DOMContentLoaded", function () {
        const basePaymentAmount = parseInt('<%= paymentDetails.amount %>', 10);
        let finalPaymentAmount = basePaymentAmount;
        let appliedPromoCode = '';
        const gatewayCurrency = '<%= paystackChargeCurrency || "GHS" %>';
        const defaultPayButtonHtml = '<% if (isTrialCheckout) { %>Begin Free Trial<% } else { %>Pay <%= paystackChargeCurrency || "GHS" %> <span id="final-amount"><%= (paymentDetails.amount / 100).toFixed(2) %></span><% } %>';

      function confirmPayment() {
        return confirm(
          "You are about to proceed with the payment for the selected plan. Do you consent to proceed?"
        );
      }

      const promoToggleBtn = document.getElementById("promo-toggle");
      const promoSectionEl = document.getElementById("promo-section");
      function setPromoExpanded(expanded) {
        if (!promoToggleBtn || !promoSectionEl) return;
        promoToggleBtn.setAttribute("aria-expanded", expanded ? "true" : "false");
        promoSectionEl.hidden = !expanded;
      }

      if (promoToggleBtn && promoSectionEl) {
        setPromoExpanded(false);
        promoToggleBtn.addEventListener("click", function() {
          const isExpanded = promoToggleBtn.getAttribute("aria-expanded") === "true";
          setPromoExpanded(!isExpanded);
        });
      }

      // Promo code functionality
      const applyBtn = document.getElementById("applyPromoCode");
      if (applyBtn) {
        applyBtn.addEventListener("click", async function() {
        const promoCode = document.getElementById("promoCode").value.trim();
        const promoMessage = document.getElementById("promo-message");
        const promoError = document.getElementById("promo-error");
        const finalAmountElement = document.getElementById("final-amount");

        if (!promoCode) {
          setPromoExpanded(true);
          promoError.textContent = "Please enter a promo code.";
          promoError.style.display = "block";
          promoMessage.style.display = "none";
          return;
        }

        try {
          const response = await fetch(
            "/account/validate-promo?code=" + encodeURIComponent(promoCode)
          );
          const data = await response.json();

          if (data.success) {
            setPromoExpanded(true);
            promoMessage.style.display = "block";
            promoMessage.textContent = "✅ Promo applied! " + data.discount + "% discount.";
            promoError.style.display = "none";

            appliedPromoCode = promoCode;

            const originalAmount = basePaymentAmount / 100;
            const discountAmount = (originalAmount * (data.discount / 100)).toFixed(2);
            const finalAmount = (originalAmount - discountAmount).toFixed(2);

            finalAmountElement.textContent = finalAmount;
            finalPaymentAmount = Math.round(finalAmount * 100);
          } else {
            setPromoExpanded(true);
            promoMessage.style.display = "none";
            promoError.textContent = data.message || "Invalid promo code";
            promoError.style.display = "block";
          }
        } catch (error) {
          console.error("❌ Error applying promo code:", error);
          setPromoExpanded(true);
          promoError.textContent = "Error validating promo code.";
          promoError.style.display = "block";
          promoMessage.style.display = "none";
        }
        });
      }

      // Paystack payment functionality
      const payButtonEl = document.getElementById("pay-button");
      if (payButtonEl) {
        payButtonEl.addEventListener("click", function() {
        if (!confirmPayment()) {
          return;
        }

        // Show loading state
        const payButton = this;
        payButton.disabled = true;
        payButton.textContent = "Processing...";

        try {
          const handler = PaystackPop.setup({
            key: '<%= publishableKey %>',
            email: '<%= registrationDetails.email %>',
            amount: finalPaymentAmount,
            currency: gatewayCurrency,
            ref: '<%= paymentReference %>',
            channels: ['card'], // Only allow card payments
            metadata: {
              custom_fields: [
                {
                  display_name: "Organization Name",
                  variable_name: "organization_name",
                  value: '<%= registrationDetails.orgName %>'
                },
                {
                  display_name: "Plan",
                  variable_name: "plan",
                  value: '<%= registrationDetails.plan %>'
                }
              ]
            },
            callback: function(response) {
              // Payment was successful
              document.getElementById("paymentReference").value = response.reference;
              document.getElementById("hiddenPromoCode").value = appliedPromoCode;
              
              const paymentMessage = document.getElementById("payment-message");
              if (paymentMessage) {
                paymentMessage.textContent = "Payment successful! Redirecting...";
                paymentMessage.style.color = "green";
                paymentMessage.style.display = "block";
              }
              
              document.getElementById("payment-form").submit();
            },
            onClose: function() {
              // Payment was cancelled
              payButton.disabled = false;
              payButton.innerHTML = defaultPayButtonHtml;
              
              const paymentMessage = document.getElementById("payment-message");
              if (paymentMessage) {
                paymentMessage.textContent = "Payment was cancelled. Please try again.";
                paymentMessage.style.color = "red";
                paymentMessage.style.display = "block";
              }
            }
          });

          handler.openIframe();
        } catch (error) {
          console.error("Error opening Paystack:", error);
          payButton.disabled = false;
          payButton.innerHTML = defaultPayButtonHtml;
          
          const paymentMessage = document.getElementById("payment-message");
          if (paymentMessage) {
            paymentMessage.textContent = "Error loading payment gateway. Please refresh and try again.";
            paymentMessage.style.color = "red";
            paymentMessage.style.display = "block";
          }
        }
        });
      }
    });
  </script>

