<%- include('../partials/flash') %>

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Register Your Organization</title>
  <script src="/js/script.js" defer></script>
  <style>
    .password-input-wrapper {
      position: relative;
    }

    .password-input-wrapper .form-input {
      padding-right: 45px;
    }

    .password-toggle-btn {
      position: absolute;
      right: 16px;
      top: 50%;
      transform: translateY(-50%);
      background: transparent;
      border: none;
      color: #64748b;
      cursor: pointer;
      padding: 4px;
      transition: color 0.2s ease;
      font-size: 0.95rem;
      display: flex;
      align-items: center;
      justify-content: center;
      z-index: 1;
      pointer-events: auto;
      width: 24px;
      height: 24px;
      flex-shrink: 0;
    }

    .password-toggle-btn:hover {
      color: #01535b;
      transform: translateY(-50%);
    }

    .password-toggle-btn:active {
      transform: translateY(-50%);
    }

    .password-toggle-btn:focus {
      outline: none;
      transform: translateY(-50%);
    }

    .password-toggle-btn i {
      font-size: 0.9rem;
      transition: none;
    }

    :root {
      --font-family: "Inter", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
      --primary: #01535b;
      --primary-hover: #014a51;
      --primary-light: rgba(1, 83, 91, 0.08);
      --text-primary: #1e293b;
      --text-secondary: #64748b;
      --border: #e2e8f0;
      --bg-page: #f8fafc;
      --bg-card: #ffffff;
      --error: #dc2626;
      --success: #059669;
      --warning: #d97706;
      --info-bg: #e7f3fe;
      --info-border: #bee5eb;
      --info-text: #0c5460;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      font-family: var(--font-family);
      background: var(--bg-page);
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      padding: 0;
      margin: 0;
    }

    .page-wrapper {
      flex: 1;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 60px 20px;
      width: 100%;
    }

    .register-container {
      max-width: 600px;
      margin: 0 auto;
      padding-top: 40px;
    }

    .register-card {
      background: var(--bg-card);
      border-radius: 16px;
      box-shadow: 0 4px 24px rgba(0, 0, 0, 0.08), 0 1px 3px rgba(0, 0, 0, 0.04);
      padding: 40px 36px;
      border: 1px solid var(--border);
    }

    .register-header {
      text-align: center;
      margin-bottom: 32px;
    }

    .register-header h1 {
      font-size: 1.75rem;
      font-weight: 700;
      color: var(--text-primary);
      margin-bottom: 8px;
    }

    .register-header p {
      color: var(--text-secondary);
      font-size: 0.95rem;
    }

    .notice {
      background: var(--info-bg);
      color: var(--info-text);
      border: 1px solid var(--info-border);
      border-radius: 10px;
      padding: 16px;
      margin-bottom: 28px;
      font-size: 0.9rem;
      line-height: 1.6;
    }

    .section-title {
      font-size: 1.1rem;
      font-weight: 700;
      color: var(--text-primary);
      margin: 28px 0 20px 0;
      padding-bottom: 10px;
      border-bottom: 2px solid var(--border);
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .section-title svg {
      width: 20px;
      height: 20px;
      color: var(--primary);
    }

    .form-group {
      margin-bottom: 20px;
    }

    .form-label {
      display: block;
      font-weight: 600;
      color: var(--text-primary);
      margin-bottom: 8px;
      font-size: 0.9rem;
    }

    .form-hint {
      font-size: 0.8rem;
      color: var(--text-secondary);
      margin-top: 4px;
    }

    .form-input {
      width: 100%;
      padding: 14px 16px;
      border: 2px solid var(--border);
      border-radius: 10px;
      font-size: 1rem;
      font-family: inherit;
      transition: all 0.2s ease;
      background: var(--bg-card);
      color: var(--text-primary);
    }

    .form-input:focus {
      outline: none;
      border-color: var(--primary);
      box-shadow: 0 0 0 3px var(--primary-light);
    }

    .form-input::placeholder {
      color: var(--text-secondary);
      opacity: 0.7;
    }

    .form-row {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 16px;
    }

    @media (max-width: 520px) {
      .form-row {
        grid-template-columns: 1fr;
      }
    }

    .password-strength {
      font-size: 0.85rem;
      margin-top: 8px;
      font-weight: 600;
    }

    .password-strength.weak { color: var(--error); }
    .password-strength.medium { color: var(--warning); }
    .password-strength.strong { color: var(--success); }

    .password-requirements {
      background: #f8fafc;
      border-radius: 8px;
      padding: 12px 16px;
      margin-top: 12px;
      border: 1px solid var(--border);
    }

    .password-requirements p {
      font-size: 0.8rem;
      color: var(--text-secondary);
      margin-bottom: 6px;
    }

    .password-requirements ul {
      margin: 0;
      padding-left: 20px;
    }

    .password-requirements li {
      font-size: 0.8rem;
      color: var(--text-secondary);
      line-height: 1.6;
    }

    .password-toggle {
      display: flex;
      align-items: center;
      gap: 8px;
      margin-top: 12px;
      font-size: 0.85rem;
      color: var(--text-secondary);
      cursor: pointer;
    }

    .password-toggle input[type="checkbox"] {
      width: 16px;
      height: 16px;
      cursor: pointer;
      accent-color: var(--primary);
    }

    .terms-group {
      display: flex;
      align-items: flex-start;
      gap: 10px;
      padding: 16px;
      background: #f8fafc;
      border-radius: 10px;
      border: 1px solid var(--border);
      margin-top: 24px;
    }

    .terms-group input[type="checkbox"] {
      width: 18px;
      height: 18px;
      margin-top: 2px;
      cursor: pointer;
      accent-color: var(--primary);
      flex-shrink: 0;
    }

    .terms-group label {
      font-size: 0.9rem;
      color: var(--text-secondary);
      line-height: 1.5;
    }

    .terms-group a {
      color: var(--primary);
      font-weight: 600;
      text-decoration: none;
    }

    .terms-group a:hover {
      text-decoration: underline;
    }

    .btn-primary {
      width: 100%;
      padding: 16px 24px;
      background: linear-gradient(135deg, var(--primary) 0%, #0a6d77 100%);
      color: white;
      border: none;
      border-radius: 10px;
      font-size: 1.05rem;
      font-weight: 600;
      cursor: pointer;
      transition: all 0.2s ease;
      box-shadow: 0 2px 8px rgba(1, 83, 91, 0.25);
      margin-top: 28px;
    }

    .btn-primary:hover {
      transform: translateY(-2px);
      box-shadow: 0 6px 20px rgba(1, 83, 91, 0.35);
    }

    .login-link {
      text-align: center;
      margin-top: 24px;
      font-size: 0.9rem;
      color: var(--text-secondary);
    }

    .login-link a {
      color: var(--primary);
      font-weight: 600;
      text-decoration: none;
    }

    .login-link a:hover {
      text-decoration: underline;
    }

    @media (max-width: 768px) {
      .page-wrapper {
        padding: 40px 16px;
      }
      .register-container {
        padding-top: 60px;
      }
      .register-card {
        padding: 32px 24px;
      }
      .register-header h1 {
        font-size: 1.5rem;
      }
      .section-title {
        font-size: 1rem;
      }
    }

    @media (max-width: 480px) {
      .page-wrapper {
        padding: 24px 12px;
      }
      .register-container {
        padding-top: 80px;
      }
      .register-card {
        padding: 24px 18px;
        border-radius: 12px;
      }
      .register-header h1 {
        font-size: 1.3rem;
      }
      .register-header p {
        font-size: 0.85rem;
      }
      .section-title {
        font-size: 0.95rem;
        margin: 20px 0 14px 0;
      }
      .form-label {
        font-size: 0.85rem;
      }
      .form-input {
        padding: 12px 14px;
        font-size: 16px;
      }
      .notice {
        font-size: 0.82rem;
        padding: 12px;
      }
      .btn-primary {
        padding: 14px 20px;
        font-size: 0.95rem;
      }
      .terms-group {
        padding: 12px;
      }
      .terms-group label {
        font-size: 0.85rem;
      }
    }
  </style>
</head>
<body>
  <div class="page-wrapper">
    <div class="register-container">
    <div class="register-card">
      <div class="register-header">
        <h1>Register Your Organization</h1>
        <p>Create your account to get started with Managira</p>
      </div>

      <form action="/account/register" method="post" enctype="multipart/form-data" onsubmit="return confirmRegistration()">
        <input type="hidden" name="preferredPlanId" value="<%= preferredPlanId || '' %>">
        <input type="hidden" name="trialRequested" value="<%= trialRequested ? '1' : '' %>">
        <input type="hidden" name="preferredPlanName" value="<%= preferredPlanName || '' %>">
        
        <% const hasPreselectedPlan = !!(preferredPlanId && preferredPlanName); %>
        <% if (hasPreselectedPlan && trialRequested) { %>
          <div class="notice">
            ✨ You're requesting a <strong>free trial</strong> of our premium experience. Register your organization below to activate your trial.
          </div>
        <% } else if (hasPreselectedPlan) { %>
          <div class="notice">
            📋 You've chosen the <strong><%= preferredPlanName %></strong> plan. Register your organization below to continue to payment.
          </div>
        <% } else if (trialRequested) { %>
          <div class="notice">
            ✨ You're requesting a <strong>premium free trial</strong>. Register below to verify your card and activate the trial.
          </div>
        <% } %>

        <h2 class="section-title">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
            <circle cx="12" cy="7" r="4"></circle>
          </svg>
          Personal Details
        </h2>

        <div class="form-row">
          <div class="form-group">
            <label class="form-label" for="firstName">First Name</label>
            <input type="text" name="firstName" id="firstName" class="form-input" placeholder="John" required value="<%= formData?.firstName || '' %>">
          </div>
          <div class="form-group">
            <label class="form-label" for="lastName">Last Name</label>
            <input type="text" name="lastName" id="lastName" class="form-input" placeholder="Doe" required value="<%= formData?.lastName || '' %>">
          </div>
        </div>

        <h2 class="section-title">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
            <polyline points="9 22 9 12 15 12 15 22"></polyline>
          </svg>
          Organization Information
        </h2>

        <div class="form-group">
          <label class="form-label" for="orgName">Organization Name</label>
          <input type="text" name="orgName" id="orgName" class="form-input" placeholder="My School Name" required value="<%= formData?.orgName || '' %>">
        </div>

        <div class="form-group">
          <label class="form-label" for="orgNickName">Organization Nickname</label>
          <input type="text" name="orgNickName" id="orgNickName" class="form-input" placeholder="myschool" minlength="3" maxlength="15" pattern="[a-z]+" title="3-15 lowercase letters only" required value="<%= formData?.orgNickName || '' %>">
          <p class="form-hint">This determines your URL. Use 3-15 lowercase letters only (e.g., ttc, myschool)</p>
        </div>

        <div class="form-group">
          <label class="form-label" for="orgAddress">Organization Address</label>
          <input type="text" name="orgAddress" id="orgAddress" class="form-input" placeholder="123 Main Street, City" required value="<%= formData?.orgAddress || '' %>">
        </div>

        <div class="form-group">
          <label class="form-label" for="orgPhone">Organization Phone</label>
          <input type="text" name="orgPhone" id="orgPhone" class="form-input" placeholder="+1 234 567 8900" required value="<%= formData?.orgPhone || '' %>">
        </div>

        <div class="notice" style="margin-top: 20px;">
          <strong>📄 Proof of Existence:</strong> Upload any valid document (certificate, registration document, or website screenshot) to verify your organization.
        </div>

        <div class="form-row">
          <div class="form-group">
            <label class="form-label" for="proof1">Proof of Existence *</label>
            <input type="file" name="proof1" id="proof1" class="form-input" accept=".pdf,.doc,.docx,.jpg,.jpeg,.png" required>
          </div>
          <div class="form-group">
            <label class="form-label" for="proof2">Additional Proof (Optional)</label>
            <input type="file" name="proof2" id="proof2" class="form-input" accept=".pdf,.doc,.docx,.jpg,.jpeg,.png">
          </div>
        </div>

        <h2 class="section-title">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
            <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
          </svg>
          Sign-In Credentials
        </h2>

        <div class="form-group">
          <label class="form-label" for="email">Email</label>
          <input type="email" name="email" id="email" class="form-input" placeholder="you@example.com" required value="<%= formData?.email || '' %>">
        </div>

        <div class="form-group">
          <label class="form-label" for="confirmEmail">Confirm Email</label>
          <input type="email" name="confirmEmail" id="confirmEmail" class="form-input" placeholder="Confirm your email" required value="<%= formData?.confirmEmail || '' %>">
        </div>

        <div class="form-group">
          <label class="form-label" for="password">Password</label>
          <div class="password-input-wrapper">
            <input type="password" name="password" id="password" class="form-input" placeholder="Create a strong password" required oninput="checkPasswordStrength(this.value)" value="<%= formData?.password || '' %>">
            <button type="button" class="password-toggle-btn" onclick="toggleMultiplePasswords(['password', 'confirmPassword'], this)" aria-label="Show passwords">
              <i class="fa-solid fa-eye fa-fw" aria-hidden="true"></i>
            </button>
          </div>
          <p id="password-strength" class="password-strength"></p>
          <div class="password-requirements">
            <p>Password must include:</p>
            <ul>
              <li>At least 6 characters</li>
              <li>One uppercase letter (A-Z)</li>
              <li>One lowercase letter (a-z)</li>
              <li>One number (0-9)</li>
              <li>One special character (!@#$%^&*)</li>
            </ul>
          </div>
        </div>

        <div class="form-group">
          <label class="form-label" for="confirmPassword">Confirm Password</label>
          <div class="password-input-wrapper">
            <input type="password" name="confirmPassword" id="confirmPassword" class="form-input" placeholder="Re-enter your password" required value="<%= formData?.confirmPassword || '' %>">
          </div>
        </div>

        <div class="terms-group">
          <input type="checkbox" id="termsCheckbox" name="termsCheckbox" required>
          <label for="termsCheckbox">
            I agree to the <a href="/legal/terms-of-service" target="_blank">Terms of Service</a> and <a href="/legal/privacy-policy" target="_blank">Privacy Policy</a>
          </label>
        </div>

        <button type="submit" class="btn-primary">Proceed to Payment</button>
      </form>

      <p class="login-link">
        Already have an account? <a href="/account/login">Sign in</a>
      </p>
    </div>
  </div>

  <script>
    document.addEventListener("DOMContentLoaded", function () {
      const formEl = document.querySelector("form");
      const passwordInput = document.getElementById("password");
      const confirmPasswordInput = document.getElementById("confirmPassword");
      const emailInput = document.getElementById("email");
      const confirmEmailInput = document.getElementById("confirmEmail");
      const strengthText = document.getElementById("password-strength");
      const showPwToggle = document.getElementById("show-password");

      function toggleMultiplePasswords(inputIds, button) {
      const icon = button.querySelector('i');
      const firstInput = document.getElementById(inputIds[0]);
      const isVisible = firstInput.type === 'text';
      
      inputIds.forEach(id => {
        const input = document.getElementById(id);
        if (input) input.type = isVisible ? 'password' : 'text';
      });
      
      icon.classList.remove('fa-eye', 'fa-eye-slash');
      icon.classList.add(isVisible ? 'fa-eye' : 'fa-eye-slash');
      button.setAttribute('aria-label', isVisible ? 'Show passwords' : 'Hide passwords');
    }

    function checkPasswordStrength(password) {
        const weak = /.{6,}/;
        const medium = /^(?=.*[A-Za-z])(?=.*\d).{6,}$/;
        const strong = /^(?=.*[a-z])(?=.*[A-Z])(?=.*\d)(?=.*[!@#$%^&*]).{6,}$/;
        if (!strengthText) return;
        if (strong.test(password)) {
          strengthText.textContent = 'Strong Password 💪';
          strengthText.className = 'password-strength strong';
        } else if (medium.test(password)) {
          strengthText.textContent = 'Medium Strength ⚠️';
          strengthText.className = 'password-strength medium';
        } else if (weak.test(password)) {
          strengthText.textContent = 'Weak Password ❌';
          strengthText.className = 'password-strength weak';
        } else {
          strengthText.textContent = '';
          strengthText.className = 'password-strength';
        }
      }

      if (passwordInput) {
        passwordInput.addEventListener("input", function () {
          checkPasswordStrength(this.value);
        });
      }

      if (formEl) {
        formEl.addEventListener("submit", function (event) {
          if (passwordInput && confirmPasswordInput) {
            if (passwordInput.value.length < 6) {
              alert('⚠️ Password must be at least 6 characters long.');
              event.preventDefault();
            } else if (passwordInput.value !== confirmPasswordInput.value) {
              alert('⚠️ Passwords do not match.');
              event.preventDefault();
            }
          }
          if (emailInput && confirmEmailInput && emailInput.value.trim() !== confirmEmailInput.value.trim()) {
            alert('⚠️ Email addresses do not match.');
            event.preventDefault();
          }
        });
      }

      if (showPwToggle && passwordInput && confirmPasswordInput) {
        showPwToggle.addEventListener("change", function () {
          const type = this.checked ? "text" : "password";
          passwordInput.type = type;
          confirmPasswordInput.type = type;
        });
      }
    });
  </script>
  </div>
</body>
</html>
