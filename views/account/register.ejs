<%
  const planSelectedFlashKey = 'plan selected. please complete registration';
  const normalizeFlashText = (value) => String(value || '')
    .trim()
    .toLowerCase()
    .replace(/\s+/g, ' ')
    .replace(/[.!?]+$/g, '');

  const filterPlanSelected = (list) =>
    Array.isArray(list)
      ? list.filter((message) => normalizeFlashText(message) !== planSelectedFlashKey)
      : [];

  const registerFlashMessages = {
    error: filterPlanSelected(messages?.error),
    info: filterPlanSelected(messages?.info),
    success: filterPlanSelected(messages?.success),
  };
%>
<%- include('../partials/flash', { messages: registerFlashMessages }) %>

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title>Register Your Organization</title>
  <link rel="icon" href="/favicon.ico" type="image/x-icon" sizes="any" />
  <link rel="apple-touch-icon" sizes="180x180" href="/images/favicon_io/apple-touch-icon.png" />
  <link rel="shortcut icon" href="/favicon.ico" />
  <script src="/js/script.js" defer></script>
  <style>
    .password-input-wrapper {
      position: relative;
    }

    .password-input-wrapper .form-input {
      padding-right: 45px;
    }

    .password-toggle-btn {
      position: absolute;
      right: 28px;
      top: 34%;
      transform: translateY(-50%);
      background: #f8fafc;
      border: 1px solid #e2e8f0;
      color: #475569;
      cursor: pointer;
      padding: 0;
      transition: all 0.2s ease;
      font-size: 0.95rem;
      display: flex;
      align-items: center;
      justify-content: center;
      z-index: 1;
      pointer-events: auto;
      width: 24px;
      height: 16px;
      border-radius: 999px;
      flex-shrink: 0;
    }

    .password-toggle-btn:hover {
      transform: translateY(-50%);}

    .password-toggle-btn:active {
      transform: translateY(-50%);
    }

    .password-toggle-btn:focus {
      outline: none;
      transform: translateY(-50%);
      box-shadow: 0 0 0 3px rgba(1, 83, 91, 0.12);
    }

    .password-toggle-btn .eye-icon {
      width: 12px;
      height: 12px;
      stroke: currentColor;
      stroke-width: 2;
      fill: none;
      stroke-linecap: round;
      stroke-linejoin: round;
    }

    :root {
      --font-family: "Inter", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
      --primary: #01535b;
      --primary-hover: #014a51;
        --primary-hover-fill: color-mix(in srgb, var(--primary) 88%, white);
      --primary-light: rgba(1, 83, 91, 0.08);
      --text-primary: #1e293b;
      --text-secondary: #64748b;
      --border: #e2e8f0;
      --bg-page: #f8fafc;
      --bg-card: #ffffff;
      --error: #dc2626;
      --success: #059669;
      --warning: #d97706;
      --info-bg: #e7f3fe;
      --info-border: #bee5eb;
      --info-text: #0c5460;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      font-family: var(--font-family);
      background: var(--bg-page);
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      padding: 0;
      margin: 0;
      -webkit-text-size-adjust: 100%;
    }

    .page-wrapper {
      flex: 1;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 20px 20px;
      width: 100%;
    }

    .register-container {
      max-width: 600px;
      margin: 0 auto;
      padding-top: 0;
    }

    .register-card {
      background: var(--bg-card);
      border-radius: 16px;
      box-shadow: 0 4px 24px rgba(0, 0, 0, 0.08), 0 1px 3px rgba(0, 0, 0, 0.04);
      padding: 40px 36px;
      border: 1px solid var(--border);
    }

    .register-header {
      text-align: center;
      margin-bottom: 32px;
    }

    .register-header h1 {
      font-size: 1.75rem;
      font-weight: 700;
      color: var(--text-primary);
      margin-bottom: 8px;
    }

    .register-header p {
      color: var(--text-secondary);
      font-size: 0.95rem;
    }

    .notice {
      background: var(--info-bg);
      color: var(--info-text);
      border: 1px solid var(--info-border);
      border-radius: 10px;
      padding: 16px;
      margin-bottom: 28px;
      font-size: 0.9rem;
      line-height: 1.6;
    }

    .section-title {
      font-size: 1.1rem;
      font-weight: 700;
      color: var(--text-primary);
      margin: 28px 0 20px 0;
      padding-bottom: 10px;
      border-bottom: 2px solid var(--border);
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .section-title svg {
      width: 20px;
      height: 20px;
      color: var(--primary);
    }

    .form-label {
      display: block;
      font-weight: 600;
      color: var(--text-primary);
      margin-bottom: 8px;
      font-size: 0.9rem;
    }

    .form-hint {
      font-size: 0.8rem;
      color: var(--text-secondary);
      margin-top: 4px;
    }

    .form-input {
      width: 100%;
      padding: 14px 16px;
      border: 2px solid var(--border);
      border-radius: 10px;
      font-size: 1rem;
      font-family: inherit;
      transition: all 0.2s ease;
      background: var(--bg-card);
      color: var(--text-primary);
    }

    .form-input:focus {
      outline: none;
      border-color: var(--primary);
      box-shadow: 0 0 0 3px var(--primary-light);
    }

    .form-input::placeholder {
      color: var(--text-secondary);
      opacity: 0.7;
      font-size: 0.9em;
    }

    .form-row {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 16px;
    }

    @media (max-width: 520px) {
      .form-row {
        grid-template-columns: 1fr;
      }

      .password-requirements ul {
        grid-template-columns: 1fr;
      }
    }

    .password-strength {
      font-size: 0.85rem;
      margin-top: 8px;
      font-weight: 600;
    }

    .password-strength.weak { color: var(--error); }
    .password-strength.medium { color: var(--warning); }
    .password-strength.strong { color: var(--success); }

    .password-requirements {
      background: #f8fafc;
      border-radius: 8px;
      padding: 8px 10px;
      margin-top: 6px;
      border: 1px solid var(--border);
    }

    .password-requirements p {
      font-size: 0.76rem;
      color: var(--text-secondary);
      margin-bottom: 4px;
      font-weight: 600;
    }

    .password-requirements ul {
      margin: 0;
      padding: 0;
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 0;
    }

    .password-requirements li {
      font-size: 0.74rem;
      color: var(--text-secondary);
      line-height: 1.25;
    }

    .password-toggle {
      display: flex;
      align-items: center;
      gap: 8px;
      margin-top: 12px;
      font-size: 0.85rem;
      color: var(--text-secondary);
      cursor: pointer;
    }

    .password-toggle input[type="checkbox"] {
      width: 16px;
      height: 16px;
      cursor: pointer;
      accent-color: var(--primary);
    }

    .terms-group {
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 16px;
      background: #f8fafc;
      border-radius: 10px;
      border: 1px solid var(--border);
      margin-top: 24px;
    }

    .terms-group input[type="checkbox"] {
      width: 18px;
      height: 18px;
      margin-top: 0;
      cursor: pointer;
      accent-color: var(--primary);
      flex-shrink: 0;
    }

    .terms-group label {
      display: inline;
      margin: 0;
      font-size: 0.9rem;
      color: var(--text-secondary);
      line-height: 1.5;
    }

    .terms-group a {
      color: var(--primary);
      font-weight: 600;
      text-decoration: none;
    }

    .terms-group a:hover {
      text-decoration: underline;
    }

    .btn-primary {
      width: 100%;
      padding: 16px 24px;
      background: linear-gradient(135deg, var(--primary) 0%, #0a6d77 100%);
      color: white;
      border: none;
      border-radius: 10px;
      font-size: 1.05rem;
      font-weight: 600;
      cursor: pointer;
      transition: all 0.2s ease;
      box-shadow: 0 2px 8px rgba(1, 83, 91, 0.25);
      margin-top: 28px;
    }

    .btn-primary:disabled,
    .btn-primary.is-disabled {
      opacity: 0.55;
      cursor: not-allowed;
      transform: none;
      box-shadow: none;
      filter: grayscale(0.1);
    }

    .btn-primary:hover {
      transform: translateY(-2px);
      box-shadow: 0 6px 20px rgba(1, 83, 91, 0.35);
    }

    .btn-primary:disabled:hover,
    .btn-primary.is-disabled:hover {
      transform: none;
      box-shadow: none;
    }

    .login-link {
      text-align: center;
      margin-top: 24px;
      font-size: 0.9rem;
      color: var(--text-secondary);
    }

    .login-link a {
      color: var(--primary);
      font-weight: 600;
      text-decoration: none;
    }

    .login-link a:hover {
      text-decoration: underline;
    }

    @media (max-width: 768px) {
      .page-wrapper {
        padding: 50px 16px 12px;
      }
      .register-container {
        padding-top: 0;
      }
      .register-card {
        padding: 32px 24px;
      }
      .register-header h1 {
        font-size: 1.5rem;
      }
      .section-title {
        font-size: 1rem;
      }
    }

    @media (max-width: 480px) {
      .page-wrapper {
        padding: 40px 12px 8px;
      }
      .register-container {
        padding-top: 0;
      }
      .register-card {
        padding: 24px 18px;
        border-radius: 12px;
      }
      .register-header h1 {
        font-size: 1.1rem;
      }
      .register-header p {
        font-size: 0.8rem;
      }
      .section-title {
        font-size: 0.75rem;
        margin: 20px 0 14px 0;
      }
      .form-label {
        font-size: 0.8rem;
      }
      .form-input {
        padding: 3px 10px;
        font-size: 14px;
        height: 32px;
      }
      .notice {
        font-size: 0.82rem;
        padding: 12px;
      }
      .btn-primary {
        padding: 8px 16px;
        font-size: 0.95rem;
      }
      .terms-group {
        padding: 12px;
      }
      .terms-group label {
        font-size: 0.85rem;
      }
    }

    /* --- spacing tighten + modern arrangement --- */
    .register-card { padding: 28px 30px; }
    .register-header { margin-bottom: 16px; }
    .section-title { margin: 16px 0 12px 0; padding-bottom: 6px; }
    .register-form .form-group { margin-bottom: 0 !important; }
    .form-row { gap: 14px; }
    .form-input { padding: 12px 14px; }
    .notice { margin-bottom: 14px; padding: 10px 12px; font-size: 0.82rem; line-height: 1.45; }
    .btn-primary { margin-top: 16px; }
    .password-requirements { padding: 10px 14px; margin-top: 6px; }
    .password-strength { margin-top: 5px; }
    select.form-input { height: 40px; font-size: 0.82rem; padding: 7px 30px 7px 10px; }

    /* --- keep desktop layout on small screens --- */
    .form-row { grid-template-columns: 1fr 1fr; }
    .form-input { height: auto; font-size: 0.94rem; padding: 11px 13px; }
    .password-requirements ul { grid-template-columns: 1fr 1fr; }
    .register-header h1 { font-size: 1.48rem; }
    .section-title { font-size: 1rem; }
    .form-label { font-size: 0.84rem; }

    @media (max-width: 480px) {
      .register-header h1 { font-size: 1.12rem; }
      .section-title { font-size: 0.9rem; }
      .form-label { font-size: 0.78rem; }
      .form-input { font-size: 0.9rem; }
      .notice { font-size: 0.8rem; }
      .password-requirements p { font-size: 0.72rem; }
      .password-requirements li { font-size: 0.7rem; }
      .terms-group label { font-size: 0.8rem; }
      .btn-primary { font-size: 0.9rem; }
      .login-link { font-size: 0.82rem; }
    }

    /* --- mobile fit fixes (append last, wins over the rest) --- */
    @media (max-width: 600px) {
      .page-wrapper { padding: 14px 8px; }
      .register-card { padding: 18px 14px; }
      .form-row { gap: 10px; }
      .name-fields-row { gap: 5px; }
      .name-fields-row + .section-title { margin-top: 8px; }
      .name-fields-row .form-input { padding-left: 8px; padding-right: 8px; }
      .form-label { font-size: 0.72rem; margin-bottom: 4px; }
      .register-form input,
      .register-form select,
      .register-form textarea { font-size: 16px !important; }
      .form-input { font-size: 16px; padding: 8px 9px; }
      .form-input::placeholder { font-size: 0.82em; }
      select.form-input { height: 40px; font-size: 16px; padding: 6px 24px 6px 8px; }
      .form-input:focus {
        box-shadow: 0 0 0 2px rgba(1, 83, 91, 0.14);
      }
      .register-header h1 { font-size: 1.04rem; }
      .section-title { font-size: 0.84rem; }
      .notice { font-size: 0.72rem; padding: 8px 9px; }
      .subdomain-preview { font-size: 6px; }
      .password-requirements p { font-size: 0.66rem; }
      .password-requirements li { font-size: 0.64rem; }
      .register-form input[type="file"].form-input { font-size: 16px; padding: 5px 6px; }
      .register-form input[type="file"].form-input::file-selector-button { font-size: 16px; padding: 3px 5px; margin-right: 5px; }
      .register-form input[type="file"].form-input::-webkit-file-upload-button { font-size: 16px; padding: 3px 5px; margin-right: 5px; }
      .terms-group { padding: 8px 9px; gap: 8px; }
      .terms-group label { font-size: 0.7rem; line-height: 1.35; }
      .terms-group input[type="checkbox"] { width: 16px; height: 16px; }
      .btn-primary { font-size: 0.86rem; padding: 11px 16px; }
      .login-link { font-size: 0.76rem; }
      .verification-notice { font-size: 0.66rem !important; padding: 6px 8px !important; }

      .password-toggle-btn { right: 28px; top: 34%; width: 24px; height: 16px; }
      .password-toggle-btn .eye-icon { width: 12px; height: 12px; }
      .password-input-wrapper .form-input { padding-right: 45px; }
    }

    /* very narrow phones: stay side by side, just shrink to fit */
    @media (max-width: 400px) {
      .register-card { padding: 16px 10px; }
      .form-row { gap: 8px; }
      .name-fields-row { gap: 3px; }
      .name-fields-row + .section-title { margin-top: 6px; }
      .name-fields-row .form-input { padding-left: 7px; padding-right: 7px; }
      .register-form input,
      .register-form select,
      .register-form textarea { font-size: 16px !important; }
      .form-input { font-size: 16px; padding: 7px 7px; }
      .form-label { font-size: 0.68rem; }
      .form-input::placeholder { font-size: 0.76em; }
      .subdomain-preview { font-size: 5px; }
      select.form-input { height: 36px; font-size: 16px; padding: 5px 22px 5px 6px; }
      .notice { font-size: 0.68rem; }
      .section-title { font-size: 0.8rem; }
      .register-form input[type="file"].form-input { font-size: 16px; padding: 4px 5px; }
      .register-form input[type="file"].form-input::file-selector-button { font-size: 16px; padding: 2px 4px; margin-right: 4px; }
      .register-form input[type="file"].form-input::-webkit-file-upload-button { font-size: 16px; padding: 2px 4px; margin-right: 4px; }
      .terms-group { padding: 7px 8px; }
      .terms-group label { font-size: 0.66rem; }
      .verification-notice { font-size: 0.62rem !important; padding: 5px 7px !important; }
    }
  </style>

  <%# A clean, professional layer over the form's original styles (same fields, same behavior). %>
