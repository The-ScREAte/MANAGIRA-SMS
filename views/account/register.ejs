      .register-header h1 { font-size: 1.35rem !important; }
      .register-card .form-row { grid-template-columns: minmax(0, 1fr) !important; gap: 0 !important; }
      .register-card .form-label { font-size: .85rem !important; }
      .register-card .form-input { font-size: 16px !important; }
      .register-card .subdomain-preview { font-size: .8rem !important; }
      .register-card .password-requirements p { font-size: .8rem !important; }
      .register-card .password-requirements li { font-size: .76rem !important; }
      .register-card .terms-group label { font-size: .86rem !important; }
    }
  </style>
</head>
<body>
  <div class="page-wrapper">
    <div class="register-container">
    <div class="register-card">
      <div class="register-header">
        <h1>Create your school's account</h1>
        <p class="register-sub">It takes about five minutes. You'll add classes, students and staff after this.</p>
      </div>

      <form class="register-form" action="/account/register" method="post" enctype="multipart/form-data" onsubmit="if (window.combinePhoneCountryCombos) window.combinePhoneCountryCombos(this);">
        <input type="hidden" name="preferredPlanId" value="<%= preferredPlanId || '' %>">
        <input type="hidden" name="trialRequested" value="<%= trialRequested ? '1' : '' %>">
        <input type="hidden" name="preferredPlanName" value="<%= preferredPlanName || '' %>">
        
        <% const hasPreselectedPlan = !!(preferredPlanId && preferredPlanName); %>
        <% if (hasPreselectedPlan && trialRequested) { %>
          <div class="notice">
            You're starting a <strong>free trial</strong>. Create your school's account below to begin.
          </div>
        <% } else if (hasPreselectedPlan) { %>
          <div class="notice">
            <span><strong><%= preferredPlanName %></strong> plan</span><a class="notice-link" href="/account/service-plan">Change plan</a>
          </div>
        <% } else if (trialRequested) { %>
          <div class="notice">
            You're starting a <strong>free trial</strong>. Create your account, then verify your card to begin.
          </div>
        <% } %>

        <h2 class="section-title">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
            <circle cx="12" cy="7" r="4"></circle>
          </svg>
          <span class="section-num">1</span> About you
        </h2>

        <div class="form-row name-fields-row">
          <div class="form-group">
            <label class="form-label" for="firstName">First name</label>
            <input type="text" name="firstName" maxlength="100" id="firstName" class="form-input" placeholder="Jane" autocomplete="given-name" required value="<%= formData?.firstName || '' %>">
          </div>
          <div class="form-group">
            <label class="form-label" for="lastName">Last name</label>
            <input type="text" name="lastName" maxlength="100" id="lastName" class="form-input" placeholder="Smith" autocomplete="family-name" required value="<%= formData?.lastName || '' %>">
          </div>
        </div>

        <h2 class="section-title">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
            <polyline points="9 22 9 12 15 12 15 22"></polyline>
          </svg>
          <span class="section-num">2</span> Your school
        </h2>

        <div class="form-row">
          <div class="form-group">
            <label class="form-label" for="orgName">School name</label>
            <input type="text" name="orgName" maxlength="200" id="orgName" class="form-input" placeholder="Riverside Academy" autocomplete="organization" required value="<%= formData?.orgName || '' %>">
          </div>

          <div class="form-group">
            <label class="form-label" for="orgNickName">Short name</label>
            <input type="text" name="orgNickName" id="orgNickName" class="form-input" placeholder="Riverside" minlength="3" maxlength="60" required value="<%= formData?.orgNickName || '' %>" autocomplete="off">
            <div id="subdomain-preview" class="subdomain-preview" aria-live="polite">
              Your web address: <strong><span id="subdomain-slug">your-school</span>.managira.com</strong>
            </div>
          </div>
        </div>

        <style>
          .subdomain-preview {
            position: relative;
            top: -16px;
            margin-top: 0;
            margin-bottom: 0;
            padding: 1px 4px 0 4px;
            background: #f0f9ff;
            border: 1px solid #bae6fd;
            border-radius: 8px;
            font-size: 11px;
            color: #075985;
            word-break: break-all;
            line-height: 1.2;
          }
          @media (max-width: 600px) {
            #subdomain-preview {
              font-size: 9px;
            }
          }
          @media (max-width: 400px) {
            #subdomain-preview {
              font-size: 8px;
            }
          }
          .subdomain-preview strong { color: #0c4a6e; }
          .subdomain-preview.is-invalid {
            background: #fef2f2;
            border-color: #fecaca;
            color: #991b1b;
          }
          .subdomain-preview.is-invalid strong { color: #7f1d1d; }
        </style>

        <script>
          (function () {
            // Mirror utils/orgNicknameSlug.js#slugifyNickname exactly.
            function slugifyNickname(input) {
              var value = String(input == null ? '' : input).trim();
              if (!value) return '';
              try {
                value = value.normalize('NFKD').replace(/[\u0300-\u036f]/g, '');
              } catch (_) {}
              value = value.toLowerCase();
              value = value.replace(/[^a-z0-9]+/g, '-');
              value = value.replace(/-+/g, '-');
              value = value.replace(/^-+|-+$/g, '');
              if (value.length > 30) {
                value = value.slice(0, 30).replace(/-+$/g, '');
              }
              return value;
            }

            var input = document.getElementById('orgNickName');
            var preview = document.getElementById('subdomain-preview');
            var slugEl = document.getElementById('subdomain-slug');
            if (!input || !preview || !slugEl) return;

            function update() {
              var slug = slugifyNickname(input.value);
              if (!slug || slug.length < 3) {
                slugEl.textContent = 'your-school';
                preview.classList.add('is-invalid');
              } else {
                slugEl.textContent = slug;
                preview.classList.remove('is-invalid');
              }
            }

            input.addEventListener('input', update);
            update();
          })();
        </script>

        <div class="form-group">
          <label class="form-label" for="orgAddress">School address</label>
          <input type="text" name="orgAddress" maxlength="250" id="orgAddress" class="form-input" placeholder="100 River Road, Springfield" autocomplete="street-address" required value="<%= formData?.orgAddress || '' %>">
        </div>

        <div class="form-row">
          <div class="form-group">
            <label class="form-label" for="orgCountry">Country</label>
            <% const selectedRegisterCountry = (formData?.orgCountry ? String(formData.orgCountry).toUpperCase() : ((typeof registerDefaultCountry !== 'undefined' && registerDefaultCountry) ? registerDefaultCountry : 'US')); %>
            <select name="orgCountry" id="orgCountry" class="form-input" required>
              <option value="">Select country</option>
              <% ((typeof registerCountryOptions !== 'undefined' && Array.isArray(registerCountryOptions)) ? registerCountryOptions : []).forEach((country) => { %>
                <option value="<%= country.code %>" <%= country.code === selectedRegisterCountry ? 'selected' : '' %>>
                  <%= country.name %> (<%= country.code %>)
                </option>
              <% }) %>
            </select>
          </div>
          <div class="form-group">
            <label class="form-label" for="orgProvince">State or region</label>
            <input type="text" name="orgProvince" maxlength="100" id="orgProvince" class="form-input" placeholder="Illinois" required value="<%= formData?.orgProvince || '' %>">
          </div>
        </div>

        <div class="form-group">
          <label class="form-label" for="orgPhone">School phone</label>
          <div class="phone-combo" data-default-iso2="US">
            <select class="phone-dial-select"></select>
            <input type="tel" name="orgPhone" id="orgPhone" class="phone-local-input" required autocomplete="tel" value="<%= formData?.orgPhone || '' %>">
          </div>
        </div>

        <% const registerProofDraft = (typeof proofDraft !== 'undefined' && proofDraft) ? proofDraft : {}; %>
        <% const hasCachedProof1 = !!(formData?.hasProof1 || registerProofDraft?.proof1Url); %>
        <% const hasCachedProof2 = !!(formData?.hasProof2 || registerProofDraft?.proof2Url); %>
        <% if (hasCachedProof2) { %>
          <div class="notice" style="margin-top: -8px; margin-bottom: 16px;">
            Your earlier document is still saved. Choose a new file only to replace it.
          </div>
        <% } %>

        <h2 class="section-title">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><path d="M14 2v6h6"></path></svg>
          <span class="section-num">3</span> Verify your school
        </h2>
        <p class="section-hint">Upload a document that shows your school is registered, such as a state registration, an accreditation letter or a certificate (PDF, Word or image).</p>
        <div class="form-row">
          <div class="form-group">
            <label class="form-label" for="proof1">Proof of registration</label>
            <input type="file" name="proof1" id="proof1" class="form-input" accept=".pdf,.doc,.docx,.jpg,.jpeg,.png" <%= hasCachedProof1 ? '' : 'required' %>>
          </div>
          <div class="form-group">
            <label class="form-label" for="proof2">Another document <span class="form-optional">(optional)</span></label>
            <input type="file" name="proof2" id="proof2" class="form-input" accept=".pdf,.doc,.docx,.jpg,.jpeg,.png">
            <% if (hasCachedProof2) { %>
              <p class="form-hint">A temporary cached file already exists for this field.</p>
            <% } %>
          </div>
        </div>


        <h2 class="section-title">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
            <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
          </svg>
          <span class="section-num">4</span> Your sign-in
        </h2>

        <div class="form-row">
          <div class="form-group" style="margin-bottom: 10px;">
            <label class="form-label" for="email">Work email</label>
            <input type="email" name="email" maxlength="254" id="email" class="form-input" placeholder="you@yourschool.org" autocomplete="email" required value="<%= formData?.email || '' %>">
          </div>
          <div class="form-group" style="margin-bottom: 10px;">
            <label class="form-label" for="confirmEmail">Confirm email</label>
            <input type="email" name="confirmEmail" maxlength="254" id="confirmEmail" class="form-input" placeholder="Re-enter email" required value="<%= formData?.confirmEmail || '' %>">
          </div>
        </div>

        <div class="form-row">
          <div class="form-group" style="margin-bottom: 10px;">
            <label class="form-label" for="password">Password</label>
            <div class="password-input-wrapper">
              <input type="password" name="password" id="password" class="form-input" placeholder="Create a password" required oninput="checkPasswordStrength(this.value)" value="<%= formData?.password || '' %>">
              <button type="button" class="password-toggle-btn" onclick="toggleMultiplePasswords(['password', 'confirmPassword'], this)" aria-label="Show passwords">
                <svg class="eye-icon" viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M2.5 12s3.5-6 9.5-6 9.5 6 9.5 6-3.5 6-9.5 6-9.5-6-9.5-6Z M12 15.5a3.5 3.5 0 1 0 0-7 3.5 3.5 0 0 0 0 7Z"></path>
                </svg>
              </button>
            </div>
            <p id="password-strength" class="password-strength"></p>
          </div>
          <div class="form-group" style="margin-bottom: 10px;">
            <label class="form-label" for="confirmPassword">Confirm password</label>
            <div class="password-input-wrapper">
              <input type="password" name="confirmPassword" id="confirmPassword" class="form-input" placeholder="Re-enter password" required value="<%= formData?.confirmPassword || '' %>">
            </div>
          </div>
        </div>

        <div class="password-requirements" style="margin-top: 0; margin-bottom: 10px;">
          <p>Your password needs:</p>
          <ul>
            <li data-rule="length">6 or more characters</li>
            <li data-rule="upper">An uppercase letter</li>
            <li data-rule="lower">A lowercase letter</li>
            <li data-rule="number">A number</li>
            <li data-rule="symbol">A symbol (!@#$%^&amp;*)</li>
          </ul>
        </div>

        <div class="terms-group">
          <input type="checkbox" id="termsCheckbox" name="termsCheckbox" required>
          <label for="termsCheckbox">
            I agree to the <a href="/legal/terms-of-service" target="_blank">Terms of Service</a> and <a href="/legal/privacy-policy" target="_blank">Privacy Policy</a>
          </label>
        </div>

        <button type="submit" class="btn-primary" id="registerSubmitBtn">Continue to payment</button>
      </form>

      <p class="login-link">
        Already have an account? <a href="/account/login">Sign in</a>
      </p>
    </div>
  </div>

  <script src="<%= assetUrl('/js/dialCodes.js') %>"></script>
  <script>
    const REGISTER_DRAFT_KEY = 'managira:register:draft:v1';
    const REGISTER_DRAFT_TTL_MS = 2 * 60 * 60 * 1000;
    const EYE_OPEN_PATH = "M2.5 12s3.5-6 9.5-6 9.5 6 9.5 6-3.5 6-9.5 6-9.5-6-9.5-6Z M12 15.5a3.5 3.5 0 1 0 0-7 3.5 3.5 0 0 0 0 7Z";
    const EYE_CLOSED_PATH = "M3 3l18 18 M10.6 10.7a3.5 3.5 0 0 0 4.7 4.7 M9.8 5.4A10.5 10.5 0 0 1 12 5c6 0 9.5 7 9.5 7a17.4 17.4 0 0 1-3.8 4.7 M6.1 6.1A17.5 17.5 0 0 0 2.5 12s3.5 7 9.5 7a10.6 10.6 0 0 0 5-1.2";

    const registerDraftFields = [
      'firstName',
      'lastName',
      'email',
      'confirmEmail',
      'orgName',
      'orgNickName',
      'orgAddress',
      'orgCountry',
      'orgProvince',
      'orgPhone',
      'termsCheckbox'
    ];

    function clearRegisterDraft() {
      try {
        localStorage.removeItem(REGISTER_DRAFT_KEY);
      } catch (_) {
      }
    }

    function getRegisterDraft() {
      try {
        const raw = localStorage.getItem(REGISTER_DRAFT_KEY);
        if (!raw) return {};

        const draft = JSON.parse(raw);
        const updatedAt = Number(draft && draft.updatedAt);

        if (!updatedAt || Date.now() - updatedAt > REGISTER_DRAFT_TTL_MS) {
          clearRegisterDraft();
          return {};
        }

        return draft;
      } catch (_) {
        clearRegisterDraft();
        return {};
      }
    }

    function saveRegisterDraft() {
      const payload = {};

      registerDraftFields.forEach((id) => {
        const el = document.getElementById(id);
        if (!el) return;

        if (el.type === 'checkbox') {
          payload[id] = !!el.checked;
          return;
        }

        payload[id] = el.value || '';
      });

      payload.updatedAt = Date.now();

      try {
        localStorage.setItem(REGISTER_DRAFT_KEY, JSON.stringify(payload));
      } catch (_) {
      }
    }

    function restoreRegisterDraft() {
      const draft = getRegisterDraft();
      if (!draft || Object.keys(draft).length === 0) return;

      registerDraftFields.forEach((id) => {
        const el = document.getElementById(id);
        if (!el || typeof draft[id] === 'undefined') return;

        if (el.type === 'checkbox') {
          el.checked = !!draft[id];
          return;
        }

        if (!el.value || String(el.value).trim() === '') {
          el.value = String(draft[id] || '');
        }
      });
    }

    function updatePasswordToggleIcon(button, isVisible) {
      if (!button) return;
      const path = button.querySelector('.eye-icon path');
      if (path) {
        path.setAttribute('d', isVisible ? EYE_CLOSED_PATH : EYE_OPEN_PATH);
      }

      const icon = button.querySelector('i');
      if (icon) {
        icon.classList.remove('fa-eye', 'fa-eye-slash');
        icon.classList.add(isVisible ? 'fa-eye-slash' : 'fa-eye');
      }

      button.setAttribute('aria-label', isVisible ? 'Hide passwords' : 'Show passwords');
    }

    function toggleMultiplePasswords(inputIds, button) {
      const firstInput = document.getElementById(inputIds[0]);
      if (!firstInput) return;

      const isVisible = firstInput.type === 'text';

      inputIds.forEach((id) => {
        const input = document.getElementById(id);
        if (input) input.type = isVisible ? 'password' : 'text';
      });
    }

    function checkPasswordStrength(password) {
      const strengthText = document.getElementById("password-strength");
      // Each requirement ticks itself off as it's met.
      const rules = { length: /.{6,}/, upper: /[A-Z]/, lower: /[a-z]/, number: /\d/, symbol: /[!@#$%^&*]/ };
      document.querySelectorAll('.password-requirements [data-rule]').forEach(function (li) {
        li.classList.toggle('is-met', rules[li.getAttribute('data-rule')].test(password || ''));
      });
      const weak = /.{6,}/;
      const medium = /^(?=.*[A-Za-z])(?=.*\d).{6,}$/;
      const strong = /^(?=.*[a-z])(?=.*[A-Z])(?=.*\d)(?=.*[!@#$%^&*]).{6,}$/;
      if (!strengthText) return;
      if (strong.test(password)) {
        strengthText.textContent = 'Strong password';
        strengthText.className = 'password-strength strong';
      } else if (medium.test(password)) {
        strengthText.textContent = 'Medium strength';
        strengthText.className = 'password-strength medium';
      } else if (weak.test(password)) {
        strengthText.textContent = 'Weak password';
        strengthText.className = 'password-strength weak';
      } else {
        strengthText.textContent = '';
        strengthText.className = 'password-strength';
      }
    }

    document.addEventListener("DOMContentLoaded", function () {
      const formEl = document.querySelector("form");
      const passwordInput = document.getElementById("password");
      const confirmPasswordInput = document.getElementById("confirmPassword");
      const emailInput = document.getElementById("email");
      const confirmEmailInput = document.getElementById("confirmEmail");
      const termsCheckbox = document.getElementById("termsCheckbox");
      const registerSubmitBtn = document.getElementById("registerSubmitBtn");

      restoreRegisterDraft();

      function syncSubmitState() {
        if (!termsCheckbox || !registerSubmitBtn) return;
        const enabled = !!termsCheckbox.checked;
        registerSubmitBtn.disabled = !enabled;
        registerSubmitBtn.classList.toggle('is-disabled', !enabled);
      }

      registerDraftFields.forEach((id) => {
        const el = document.getElementById(id);
        if (!el) return;

        const eventName = el.type === 'checkbox' ? 'change' : 'input';
        el.addEventListener(eventName, saveRegisterDraft);
      });

      if (termsCheckbox) {
        termsCheckbox.addEventListener('change', syncSubmitState);
      }

      syncSubmitState();

      window.addEventListener('beforeunload', saveRegisterDraft);

      if (passwordInput) {
        passwordInput.addEventListener("input", function () {
          checkPasswordStrength(this.value);
        });

        if (passwordInput.value) {
          checkPasswordStrength(passwordInput.value);
        }
      }

      if (formEl) {
        formEl.addEventListener("submit", function (event) {
          if (passwordInput && confirmPasswordInput) {
            if (passwordInput.value.length < 6) {
              alert('⚠️ Password must be at least 6 characters long.');
              event.preventDefault();
            } else if (passwordInput.value !== confirmPasswordInput.value) {
              alert('⚠️ Passwords do not match.');
              event.preventDefault();
            }
          }
          if (emailInput && confirmEmailInput && emailInput.value.trim() !== confirmEmailInput.value.trim()) {
            alert('⚠️ Email addresses do not match.');
            event.preventDefault();
          }
        });
      }

      const toggleButton = document.querySelector('.password-toggle-btn');
      if (toggleButton) {
        updatePasswordToggleIcon(toggleButton, false);
      }
    });
  </script>
  </div>
</body>
</html>
