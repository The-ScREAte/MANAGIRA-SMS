<% if (messages && messages.error && messages.error.length > 0) { %>
<div class="flash-message flash-error">
  <% messages.error.forEach(function(message) { %>
  <p><%= message %></p>
  <% }); %>
</div>
<% } %>

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="<%= locals.viewportContent || 'width=device-width, initial-scale=1.0, maximum-scale=1.0' %>" />
    <title>Complete Payment</title>
    <script src="https://js.paystack.co/v1/inline.js"></script>
    <style>
      :root {
        --font-family: "<%= (session && session.fontStyle ? String(session.fontStyle).trim() : 'Inter') %>", sans-serif;
      }

      body {
        font-family: var(--font-family);
        margin: 0;
        background-color: #f5f5f5;
      }

      .container {
        max-width: 600px;
        margin: 50px auto;
        padding: 20px;
        background-color: #fff;
        border-radius: 8px;
        box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
      }

      h1,
      h2 {
        text-align: center;
        color: #333;
      }

      h2 {
        margin-bottom: 15px;
        font-size: 18px;
      }

      p {
        font-size: 14px;
        line-height: 1.6;
        color: #555;
      }

      .btn-primary {
        display: block;
        width: 100%;
        padding: 12px;
        font-size: 16px;
        color: #fff;
        background-color: #01535b;
        border: none;
        border-radius: 4px;
        cursor: pointer;
        text-align: center;
        margin-top: 15px;
      }

      .btn-primary:hover {
        background-color: #014147;
      }

      .btn-primary:disabled {
        background-color: #ccc;
        cursor: not-allowed;
      }

      .selected-plan-message {
        text-align: center;
        font-size: 16px;
        color: green;
        font-weight: bold;
        animation: fadeIn 1s ease-in-out;
        margin-bottom: 20px;
      }

      @keyframes fadeIn {
        from {
          opacity: 0;
          transform: translateY(-10px);
        }
        to {
          opacity: 1;
          transform: translateY(0);
        }
      }

      #promo-section {
        margin: 15px 0;
        padding: 10px;
        border: 1px solid #ddd;
        border-radius: 4px;
        background-color: #fafafa;
      }

      #promoCode {
        width: 100%;
        padding: 10px;
        border: 1px solid #ddd;
        border-radius: 4px;
        margin-bottom: 10px;
        box-sizing: border-box;
      }

      #payment-message {
        margin-top: 20px;
        font-size: 14px;
        font-weight: bold;
        color: red;
        text-align: center;
        display: none;
      }

      .payment-options {
        margin-top: 20px;
      }

      .payment-options a {
        display: block;
        color: #01535b;
        text-decoration: none;
        font-size: 14px;
      }

      .payment-options a:hover {
        text-decoration: underline;
      }

      .flash-message {
        padding: 15px;
        margin-bottom: 20px;
        border-radius: 4px;
      }

      .flash-error {
        background-color: #f8d7da;
        color: #721c24;
        border: 1px solid #f5c6cb;
      }
    </style>
  </head>
  <body>
    <div class="container">
      <!-- Hidden form for payment processing -->
      <form id="payment-form" action="/account/payment" method="POST" style="display: none;">
        <input type="hidden" name="paymentReference" id="paymentReference" />
        <input type="hidden" name="promoCode" id="hiddenPromoCode" />
      </form>

      <% if (registrationDetails && registrationDetails.plan) { %>
      <h1>Complete Your Payment</h1>

      <!-- Plan Selection Message -->
      <div class="selected-plan-message">
        You selected the
        <strong><%= decodeURIComponent(registrationDetails.plan).charAt(0).toUpperCase() + decodeURIComponent(registrationDetails.plan).slice(1) %></strong>
        plan.
      </div>

      <!-- Payment Summary -->
      <h2>Payment Summary</h2>
      <p>
        <strong>Organization Name:</strong> <%= registrationDetails.orgName || 'N/A' %>
      </p>
      <p><strong>Email:</strong> <%= registrationDetails.email || 'N/A' %></p>
      <% if (isTrialActive) { %>
        <p style="color: #007bff; font-weight: bold;">You are currently on a free trial. You will only be charged ₵1 to verify your payment method.</p>
        <p><strong>Trial Ends:</strong> <%= trialActiveUntil ? new Date(trialActiveUntil).toLocaleDateString() : '' %></p>
        <p><strong>Amount Due:</strong> ₵<span id="amount-due">1.00</span></p>
      <% } else { %>
        <p><strong>Amount Due:</strong> ₵<span id="amount-due"><%= (paymentDetails.amount / 100).toFixed(2) %></span></p>
      <% } %>
      <p>
        <strong>Billing Interval:</strong> <%= billingInterval ? billingInterval.charAt(0).toUpperCase() + billingInterval.slice(1) : 'Monthly' %>
      </p>
      <% if (freeTrialDays && parseInt(freeTrialDays) > 0) { %>
      <p>
        <strong>Free Trial:</strong> <%= freeTrialDays %> day<%= parseInt(freeTrialDays) > 1 ? 's' : '' %>
      </p>
      <% } %>

      <!-- Promo Code Section -->
      <h2>Have a Promo Code?</h2>
      <div id="promo-section">
        <input
          type="text"
          id="promoCode"
          name="promoCode"
          placeholder="Enter Promo Code"
        />
        <button type="button" id="applyPromoCode" class="btn-primary">
          Apply
        </button>
        <p id="promo-message" style="color: green; display: none">
          Promo code applied successfully!
        </p>
        <p id="promo-error" style="color: red; display: none"></p>
      </div>

      <h2>Payment Method</h2>
      <p>Secure payment powered by Paystack</p>
      <p>Accepted: Visa, MasterCard, Bank Transfer, Mobile Money</p>

      <button type="button" id="pay-button" class="btn-primary">
        Pay ₵<span id="final-amount"><%= (paymentDetails.amount / 100).toFixed(2) %></span>
      </button>

      <div id="payment-message"></div>

      <% } else { %>
      <p style="text-align: center; color: red">
        No registration details found. Please go back and register again.
      </p>
      <% } %>
    </div>

    <script>
      let finalPaymentAmount = parseInt('<%= paymentDetails.amount %>');
      let appliedPromoCode = '';

      function confirmPayment() {
        return confirm(
          "You are about to proceed with the payment for the selected plan. Do you consent to proceed?"
        );
      }

      // Promo code functionality
      document.getElementById("applyPromoCode").addEventListener("click", async function() {
        const promoCode = document.getElementById("promoCode").value.trim();
        const promoMessage = document.getElementById("promo-message");
        const promoError = document.getElementById("promo-error");
        const amountDueElement = document.getElementById("amount-due");
        const finalAmountElement = document.getElementById("final-amount");

        if (!promoCode) {
          promoError.textContent = "Please enter a promo code.";
          promoError.style.display = "block";
          promoMessage.style.display = "none";
          return;
        }

        try {
          const response = await fetch(
            "/account/validate-promo?code=" + encodeURIComponent(promoCode)
          );
          const data = await response.json();

          if (data.success) {
            promoMessage.style.display = "block";
            promoMessage.textContent = "✅ Promo applied! " + data.discount + "% discount.";
            promoError.style.display = "none";

            appliedPromoCode = promoCode;

            const originalAmount = parseFloat(amountDueElement.textContent);
            const discountAmount = (originalAmount * (data.discount / 100)).toFixed(2);
            const finalAmount = (originalAmount - discountAmount).toFixed(2);

            finalAmountElement.textContent = finalAmount;
            finalPaymentAmount = Math.round(finalAmount * 100);
          } else {
            promoMessage.style.display = "none";
            promoError.textContent = data.message || "Invalid promo code";
            promoError.style.display = "block";
          }
        } catch (error) {
          console.error("❌ Error applying promo code:", error);
          promoError.textContent = "Error validating promo code.";
          promoError.style.display = "block";
          promoMessage.style.display = "none";
        }
      });

      // Paystack payment functionality
      document.getElementById("pay-button").addEventListener("click", function() {
        if (!confirmPayment()) {
          return;
        }

        // Show loading state
        const payButton = this;
        payButton.disabled = true;
        payButton.textContent = "Processing...";

        try {
          const handler = PaystackPop.setup({
            key: '<%= publishableKey %>',
            email: '<%= registrationDetails.email %>',
            amount: finalPaymentAmount,
            currency: 'USD',
            ref: '<%= paymentReference %>',
            metadata: {
              custom_fields: [
                {
                  display_name: "Organization Name",
                  variable_name: "organization_name",
                  value: '<%= registrationDetails.orgName %>'
                },
                {
                  display_name: "Plan",
                  variable_name: "plan",
                  value: '<%= registrationDetails.plan %>'
                }
              ]
            },
            callback: function(response) {
              // Payment was successful
              document.getElementById("paymentReference").value = response.reference;
              document.getElementById("hiddenPromoCode").value = appliedPromoCode;
              
              const paymentMessage = document.getElementById("payment-message");
              if (paymentMessage) {
                paymentMessage.textContent = "Payment successful! Redirecting...";
                paymentMessage.style.color = "green";
                paymentMessage.style.display = "block";
              }
              
              document.getElementById("payment-form").submit();
            },
            onClose: function() {
              // Payment was cancelled
              payButton.disabled = false;
              payButton.innerHTML = 'Pay ₵<span id="final-amount"><%= (paymentDetails.amount / 100).toFixed(2) %></span>';
              
              const paymentMessage = document.getElementById("payment-message");
              if (paymentMessage) {
                paymentMessage.textContent = "Payment was cancelled. Please try again.";
                paymentMessage.style.color = "red";
                paymentMessage.style.display = "block";
              }
            }
          });

          handler.openIframe();
        } catch (error) {
          console.error("Error opening Paystack:", error);
          payButton.disabled = false;
          payButton.innerHTML = 'Pay ₵<span id="final-amount"><%= (paymentDetails.amount / 100).toFixed(2) %></span>';
          
          const paymentMessage = document.getElementById("payment-message");
          if (paymentMessage) {
            paymentMessage.textContent = "Error loading payment gateway. Please refresh and try again.";
            paymentMessage.style.color = "red";
            paymentMessage.style.display = "block";
          }
        }
      });
    </script>
  </body>
</html>
