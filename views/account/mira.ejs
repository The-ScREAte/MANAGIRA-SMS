<style>
  .mira-settings-page {
    width: 100%; margin: 0; padding: 28px 28px 90px; box-sizing: border-box;
    background: transparent;
  }

  /* Every tint below is mixed live from --org-primary-color (set per
     organization in partials/head.ejs) via color-mix(), so it always
     follows whatever theme color the org actually has - never a fixed
     brand color of its own. */
  .mira-hero {
    display: flex; align-items: center; gap: 20px;
    padding: 22px 26px;
    border-radius: 14px;
    margin-bottom: 24px;
    color: color-mix(in srgb, var(--org-primary-color, #01535b) 88%, black);
    background: #fff;
    border: 1px solid #e2e8f0;
  }

  .mira-hero-logo-ring {
    flex-shrink: 0;
    width: 68px; height: 68px;
    display: flex; align-items: center; justify-content: center;
  }
  .mira-hero-logo-ring img {
    width: 68px; height: 68px; object-fit: contain;
  }

  .mira-hero-text { min-width: 0; }
  .mira-hero-text h1 {
    margin: 0 0 4px; font-size: 1.7rem; font-weight: 700; letter-spacing: -0.01em;
    display: flex; align-items: center; gap: 10px;
    color: color-mix(in srgb, var(--org-primary-color, #01535b) 90%, black);
  }
  .mira-hero-text .mira-hero-sparkle { font-size: 1.1rem; }
  .mira-hero-subtitle { margin: 0; color: color-mix(in srgb, var(--org-primary-color, #01535b) 60%, #374151); font-size: 0.95rem; }

  .mira-hero-meta {
    display: flex; flex-direction: column; align-items: flex-end; gap: 7px;
    margin-left: auto; text-align: right;
  }
  .mira-hero-meta-line {
    display: flex; align-items: center; justify-content: flex-end; gap: 8px; flex-wrap: wrap;
  }
  .mira-info-toggle {
    display: inline-flex !important; align-items: center; justify-content: center;
    width: auto !important; min-width: 0; padding: 5px 11px !important;
    border: 1px solid #cbd5e1 !important; border-radius: 8px !important;
    background: #fff !important; color: #334155 !important;
    font: inherit; font-size: 0.78rem; font-weight: 600; line-height: 1.2;
    cursor: pointer;
  }
  
  .mira-info-toggle:disabled { cursor: wait; opacity: 0.65; }
  .mira-info-overlay {
    position: fixed; inset: 0; z-index: 2200; background: rgba(15, 23, 42, 0.38);
    opacity: 0; visibility: hidden; transition: opacity 0.2s ease, visibility 0.2s ease;
  }
  .mira-info-overlay.show { opacity: 1; visibility: visible; }
  .mira-info-drawer {
    position: absolute; inset: 0 0 0 auto; display: flex; flex-direction: column;
    width: min(560px, 100%); height: 100%; background: #fff;
    border-left: 1px solid #e2e8f0; box-shadow: -16px 0 40px rgba(15, 23, 42, 0.12);
    transform: translateX(100%); transition: transform 0.24s ease;
  }
  .mira-info-overlay.show .mira-info-drawer { transform: translateX(0); }
  .mira-info-drawer-head {
    flex: none; min-height: 60px; display: flex; align-items: center; justify-content: space-between;
    gap: 16px; padding: 12px 22px; border-bottom: 1px solid #e2e8f0;
  }
  .mira-info-drawer-head h2 { margin: 0; color: #0f172a; font-size: 1rem; font-weight: 650; }
  .mira-info-close {
    display: inline-flex !important; align-items: center; justify-content: center;
    width: 34px !important; min-width: 34px; height: 34px; padding: 0 !important;
    border: 1px solid #e2e8f0 !important; border-radius: 8px !important;
    background: #fff !important; color: #475569 !important; font-size: 1.3rem; line-height: 1; cursor: pointer;
  }
  
  .mira-info-drawer-body { flex: 1; min-height: 0; overflow-y: auto; padding: 22px; }
  .mira-info-drawer .mira-card { margin: 0; padding: 0; border: 0; border-radius: 0; box-shadow: none; }
  .mira-info-loading, .mira-info-error { margin: 0; color: #64748b; font-size: 0.9rem; }
  .mira-info-error { color: #b91c1c; }
  .mira-info-retry {
    display: inline-flex !important; width: auto !important; margin-top: 12px; padding: 7px 12px !important;
    border: 1px solid #cbd5e1 !important; border-radius: 8px !important;
    background: #fff !important; color: #334155 !important; font: inherit; font-size: 0.82rem; cursor: pointer;
  }
  .mira-status-pill {
    display: inline-flex; align-items: center; gap: 6px; padding: 4px 12px;
    border-radius: 999px; font-size: 0.74rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.04em;
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    color: color-mix(in srgb, var(--org-primary-color, #01535b) 85%, black);
  }
  .mira-status-pill .dot { width: 6px; height: 6px; border-radius: 50%; background: #9ca3af; }
  .mira-status-pill.is-active .dot { background: #22c55e; }
  .mira-status-pill.is-inactive .dot { background: #f59e0b; }
  .mira-trial-meta { color: #64748b; font-size: 0.78rem; font-weight: 600; }
  .mira-seat-count {
    color: #475569; font-size: 0.8rem; font-weight: 600; white-space: nowrap;
  }

  .mira-flash { padding: 10px 14px; border-radius: 10px; margin-bottom: 18px; font-size: 0.92rem; }
  .mira-flash-success { background: #dcfce7; color: #166534; }
  .mira-flash-error { background: #fef2f2; color: #b91c1c; }

  .mira-inactive-notice {
    background: #fef3c7; color: #92400e; border-radius: 12px; padding: 14px 16px;
    margin-bottom: 20px; font-size: 0.92rem; display: flex; align-items: center; justify-content: space-between; gap: 12px; flex-wrap: wrap;
  }
  .mira-inactive-notice a { color: inherit; font-weight: 700; text-decoration: underline; }

  .mira-card {
    background: #fff; border: 1px solid color-mix(in srgb, var(--org-primary-color, #01535b) 14%, #e5e7eb);
    border-radius: 16px; padding: 24px; margin-bottom: 20px; width: 100%; box-sizing: border-box;
    box-shadow: 0 1px 2px rgba(15,23,42,0.04);
  }
  .mira-card-head { display: flex; align-items: center; gap: 10px; margin-bottom: 14px; }
  .mira-card-icon {
    width: 34px; height: 34px; border-radius: 10px; flex-shrink: 0;
    display: flex; align-items: center; justify-content: center;
    background: color-mix(in srgb, var(--org-primary-color, #01535b) 12%, white); color: var(--org-primary-color, #01535b);
  }
  .mira-card-icon svg { width: 18px; height: 18px; }
  .mira-card h2 { margin: 0; font-size: 1.02rem; color: #111827; }
  .mira-card p { margin: 0 0 10px; color: #4b5563; line-height: 1.6; font-size: 0.92rem; }

  .mira-point-list { list-style: none; margin: 10px 0 0; padding: 0; display: grid; gap: 10px; }
  .mira-point-list li {
    display: flex; align-items: flex-start; gap: 10px; color: #374151; line-height: 1.55; font-size: 0.9rem;
  }
  .mira-point-icon {
    flex-shrink: 0; width: 20px; height: 20px; border-radius: 50%; margin-top: 1px;
    background: color-mix(in srgb, var(--org-primary-color, #01535b) 12%, white); color: var(--org-primary-color, #01535b);
    display: flex; align-items: center; justify-content: center; font-size: 0.7rem; font-weight: 700;
  }

  .mira-access-table { width: 100%; border-collapse: collapse; }
  .mira-access-table th, .mira-access-table td { text-align: left; padding: 11px 10px; border-bottom: 1px solid #f1f5f9; font-size: 0.9rem; }
  .mira-access-table thead tr { background: color-mix(in srgb, var(--org-primary-color, #01535b) 6%, white); }
  .mira-access-table th { color: var(--org-primary-color, #475569); font-weight: 700; font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.04em; }
  .mira-access-table th:first-child { border-top-left-radius: 10px; border-bottom-left-radius: 10px; }
  .mira-access-table th:last-child { border-top-right-radius: 10px; border-bottom-right-radius: 10px; }
  
  .mira-access-table tr:last-child td { border-bottom: none; }
  .mira-owner-tag {
    color: var(--org-primary-color, #01535b); font-size: 0.72rem; font-weight: 700;
    background: color-mix(in srgb, var(--org-primary-color, #01535b) 12%, white); border-radius: 999px; padding: 2px 8px; margin-left: 6px;
  }
  .mira-access-table input[type="checkbox"][disabled] { accent-color: var(--org-primary-color, #01535b); cursor: default; width: 16px; height: 16px; }

  .mira-save-btn {
    background: linear-gradient(135deg, var(--org-primary-color, #01535b), var(--org-primary-hover, #014a51));
    color: #fff; border: none; padding: 10px 22px; border-radius: 10px; font-weight: 600; cursor: pointer;
    box-shadow: 0 4px 12px -2px color-mix(in srgb, var(--org-primary-color, #01535b) 25%, transparent);
  }
  
  .mira-empty-state { color: #6b7280; font-size: 0.9rem; padding: 12px 0; }

  .mira-edit-btn {
    background: color-mix(in srgb, var(--org-primary-color, #01535b) 10%, white); border: 1px solid transparent; border-radius: 999px; padding: 5px 14px;
    font-size: 0.8rem; font-weight: 600; color: var(--org-primary-color, #01535b); cursor: pointer;
    transition: background 0.15s ease;
  }
  .mira-edit-btn:hover { background: color-mix(in srgb, var(--org-primary-color, #01535b) 20%, white); }
  .mira-edit-btn:disabled { opacity: 0.5; cursor: default; }

  .mira-modal-overlay {
    display: none; position: fixed; inset: 0; background: rgba(15,23,42,0.55);
    z-index: 2000; align-items: center; justify-content: center; padding: 20px;
    backdrop-filter: blur(2px);
  }
  .mira-modal-overlay.show { display: flex; }
  .mira-modal-card {
    background: #fff; border-radius: 20px; max-width: 540px; width: 100%;
    max-height: 85vh; overflow-y: auto; padding: 28px; position: relative;
    box-shadow: 0 24px 60px -12px rgba(0,0,0,0.3);
  }
  .mira-modal-close {
    position: absolute; top: 16px; right: 18px; background: #f3f4f6; border: none;
    width: 28px; height: 28px; border-radius: 50%;
    font-size: 1.1rem; cursor: pointer; color: #6b7280; line-height: 1;
  }
  .mira-modal-head { display: flex; align-items: center; gap: 12px; margin-bottom: 4px; }
  .mira-modal-avatar {
    width: 38px; height: 38px; border-radius: 50%; flex-shrink: 0;
    background: linear-gradient(135deg, var(--org-primary-color, #01535b), var(--org-primary-hover, #014a51));
    color: #fff; display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 0.95rem;
  }
  .mira-modal-card h3 { margin: 0; font-size: 1.08rem; }
  .mira-modal-subtitle { color: #6b7280; font-size: 0.85rem; margin: 2px 0 20px 50px; }

  .mira-toggle-row {
    display: flex; align-items: center; justify-content: space-between;
    background: color-mix(in srgb, var(--org-primary-color, #01535b) 6%, white); border-radius: 12px; padding: 14px 16px; margin-bottom: 20px;
  }
  .mira-toggle-row .label { font-weight: 600; font-size: 0.9rem; color: #111827; }
  .mira-toggle-row .sub { color: #6b7280; font-size: 0.78rem; margin-top: 2px; }
  .mira-switch { position: relative; display: inline-block; width: 42px; height: 24px; flex-shrink: 0; }
  .mira-switch input { opacity: 0; width: 0; height: 0; }
  .mira-switch-slider {
    position: absolute; cursor: pointer; inset: 0; background: #d1d5db;
    border-radius: 999px; transition: background 0.18s ease;
  }
  .mira-switch-slider::before {
    content: ""; position: absolute; height: 18px; width: 18px; left: 3px; top: 3px;
    background: #fff; border-radius: 50%; transition: transform 0.18s ease;
  }
  .mira-switch input:checked + .mira-switch-slider { background: var(--org-primary-color, #01535b); }
  .mira-switch input:checked + .mira-switch-slider::before { transform: translateX(18px); }
  .mira-switch input:disabled + .mira-switch-slider { opacity: 0.6; cursor: default; }

  .mira-permissions-label { font-weight: 600; font-size: 0.86rem; margin: 0 0 3px; color: #111827; }
  .mira-permissions-sub { color: #6b7280; font-size: 0.78rem; margin: 0 0 14px; }
  .mira-permission-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }
  .mira-permission-item {
    display: flex; align-items: flex-start; gap: 8px; font-size: 0.84rem; color: #374151;
    border: 1px solid #e5e7eb; border-radius: 10px; padding: 8px 10px; cursor: pointer;
    transition: border-color 0.15s ease, background 0.15s ease;
  }
  .mira-permission-item:has(input:checked) {
    border-color: var(--org-primary-color, #01535b); background: color-mix(in srgb, var(--org-primary-color, #01535b) 10%, white);
  }
  .mira-permission-item input { margin-top: 2px; accent-color: var(--org-primary-color, #01535b); }

  .mira-modal-actions { display: flex; justify-content: flex-end; gap: 10px; margin-top: 22px; }
  .mira-modal-cancel {
    background: none; border: 1px solid #d1d5db; border-radius: 10px; padding: 9px 18px;
    font-weight: 600; cursor: pointer; color: #374151;
  }
  .mira-modal-status { font-size: 0.82rem; margin-top: 12px; min-height: 1.1em; }
  .mira-modal-status.error { color: #b91c1c; }
  .mira-modal-status.success { color: #166534; }

  @media (max-width: 640px) {
    .mira-settings-page { padding: 18px 14px 48px; }
    .mira-hero { padding: 18px; gap: 12px; flex-wrap: wrap; }
    .mira-hero-logo-ring, .mira-hero-logo-ring img { width: 52px; height: 52px; }
    .mira-hero-text { flex: 1 1 calc(100% - 68px); }
    .mira-hero-text h1 { font-size: 1.4rem; }
    .mira-hero-subtitle { font-size: 0.85rem; }
    .mira-hero-meta { flex: 1 0 100%; align-items: flex-start; text-align: left; }
    .mira-hero-meta-line { justify-content: flex-start; }
  }
</style>

<div class="mira-settings-page">
  <div class="mira-hero">
    <div class="mira-hero-logo-ring">
      <img src="/images/icons/miralogo-256.png" alt="" aria-hidden="true" />
    </div>
    <div class="mira-hero-text">
      <h1><span class="mira-hero-sparkle">&#10024;</span> Mira</h1>
      <p class="mira-hero-subtitle">Your school's AI assistant, the Educational Intelligence for easy management.</p>
    </div>
    <div class="mira-hero-meta">
      <div class="mira-hero-meta-line">
        <% if (miraIntegration.activated) { %>
          <span class="mira-status-pill is-active"><span class="dot"></span> Active</span>
        <% } else { %>
          <span class="mira-status-pill is-inactive"><span class="dot"></span> Inactive</span>
        <% } %>
        <button type="button" class="mira-info-toggle" id="mira-info-toggle" aria-expanded="false" aria-controls="mira-info-content">Info</button>
      </div>
      <% if (miraIntegration.trialActive) { %>
        <span class="mira-trial-meta">Free trial · <%= miraIntegration.trialDaysRemaining %> day<%= miraIntegration.trialDaysRemaining === 1 ? '' : 's' %> left</span>
      <% } else if (miraIntegration.trialEnded) { %>
        <span class="mira-trial-meta">Free trial ended</span>
      <% } %>
      <% if (miraIntegration.activated) { %>
        <span class="mira-seat-count"><%= seatCount %> seat<%= seatCount === 1 ? '' : 's' %> <%= miraIntegration.trialEnded ? 'billable' : 'active' %></span>
      <% } %>
    </div>
  </div>
  <div class="mira-info-overlay" id="mira-info-overlay">
    <aside class="mira-info-drawer" id="mira-info-drawer" role="dialog" aria-modal="true" aria-labelledby="mira-info-drawer-title" tabindex="-1">
      <header class="mira-info-drawer-head">
        <h2 id="mira-info-drawer-title">Mira information</h2>
        <button type="button" class="mira-info-close" id="mira-info-close" aria-label="Close Mira information">&times;</button>
      </header>
      <div class="mira-info-drawer-body" id="mira-info-content" aria-live="polite"></div>
    </aside>
  </div>

  <% if (flash && flash.success && flash.success.length) { %>
    <div class="mira-flash mira-flash-success"><%= flash.success[0] %></div>
  <% } %>
  <% if (flash && flash.error && flash.error.length) { %>
    <div class="mira-flash mira-flash-error"><%= flash.error[0] %></div>
  <% } %>

  <% if (!miraIntegration.activated) { %>
    <div class="mira-inactive-notice">
      <span>Mira isn't activated for your school yet.</span>
      <a href="/account/settings?section=integrations">Activate it under Integrations &rarr;</a>
    </div>
  <% } %>

  <div class="mira-card">
    <div class="mira-card-head">
      <span class="mira-card-icon">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="7" r="4"/><path d="M2 21c0-3.866 3.134-7 7-7s7 3.134 7 7"/><circle cx="17" cy="7" r="3"/><path d="M22 19c0-2.5-1.8-4.5-5-5"/></svg>
      </span>
      <h2>Who can open Mira</h2>
    </div>
    <p>Checked means active. Use Edit next to a person to change what they can do, including turning access on or off.</p>

    <table class="mira-access-table">
      <thead>
        <tr>
          <th style="width:40px;"></th>
          <th>Name</th>
          <th>Role</th>
          <th>Email</th>
          <th style="width:70px;"></th>
        </tr>
      </thead>
      <tbody id="mira-access-tbody">
        <% if (!employees || employees.length === 0) { %>
          <tr><td colspan="5" class="mira-empty-state">No employees found for this school yet.</td></tr>
        <% } else { %>
          <% employees.forEach(function(employee) { %>
            <tr data-user-row="<%= employee.userId %>">
              <td>
                <input
                  type="checkbox"
                  disabled
                  data-user-checkbox="<%= employee.userId %>"
                  <%= employee.canUseMira ? 'checked' : '' %>
                  title="<%= employee.canUseMira ? 'Can open Mira' : 'Cannot open Mira' %>"
                />
              </td>
              <td>
                <%= [employee.firstName, employee.lastName].filter(Boolean).join(' ') || 'Unnamed' %>
                <% if (employee.isOwner) { %><span class="mira-owner-tag">Owner</span><% } %>
              </td>
              <td><%= employee.accountType || '' %></td>
              <td><%= employee.email || '' %></td>
              <td>
                <button
                  type="button"
                  class="mira-edit-btn"
                  data-mira-edit-user="<%= employee.userId %>"
                  data-mira-edit-name="<%= [employee.firstName, employee.lastName].filter(Boolean).join(' ') || 'Unnamed' %>"
                >Edit</button>
              </td>
            </tr>
          <% }); %>
        <% } %>
      </tbody>
    </table>
  </div>
</div>

<div class="mira-modal-overlay" id="mira-edit-modal">
  <div class="mira-modal-card">
    <button type="button" class="mira-modal-close" id="mira-edit-modal-close" aria-label="Close">&times;</button>
    <div class="mira-modal-head">
      <span class="mira-modal-avatar" id="mira-edit-modal-avatar">?</span>
      <h3 id="mira-edit-modal-title">Mira access</h3>
    </div>
    <p class="mira-modal-subtitle" id="mira-edit-modal-subtitle">What this person can do through Mira.</p>

    <div class="mira-toggle-row">
      <div>
        <div class="label">Can open Mira</div>
        <div class="sub">Turn off to hide Mira from their menu entirely.</div>
      </div>
      <label class="mira-switch">
        <input type="checkbox" id="mira-edit-can-use" />
        <span class="mira-switch-slider"></span>
      </label>
    </div>

    <p class="mira-permissions-label">What Mira can do on their behalf</p>
    <p class="mira-permissions-sub">
      These are the same real permissions used everywhere else in the app - Mira only ever does what
      the checked-off ones already allow (manage classes, manage students, manage reports, and so on).
    </p>
    <div class="mira-permission-grid" id="mira-edit-permission-grid">
      <!-- populated by JS -->
    </div>

    <div class="mira-modal-status" id="mira-edit-modal-status"></div>

    <div class="mira-modal-actions">
      <button type="button" class="mira-modal-cancel" id="mira-edit-modal-cancel">Cancel</button>
      <button type="button" class="mira-save-btn" id="mira-edit-modal-save">Save</button>
    </div>
  </div>
</div>

<script>
(function () {
  const infoButton = document.getElementById('mira-info-toggle');
  const infoOverlay = document.getElementById('mira-info-overlay');
  const infoDrawer = document.getElementById('mira-info-drawer');
  const infoCloseButton = document.getElementById('mira-info-close');
  const infoContent = document.getElementById('mira-info-content');
  let infoLoaded = false;
  let infoLoading = false;
  let previousBodyOverflow = '';

  function closeInfoDrawer() {
    infoOverlay.classList.remove('show');
    infoButton.setAttribute('aria-expanded', 'false');
    document.body.style.overflow = previousBodyOverflow;
    infoButton.focus();
  }

  async function loadMiraInfo() {
    if (infoLoaded || infoLoading) return;
    infoLoading = true;
    infoContent.innerHTML = '<p class="mira-info-loading">Loading Mira information…</p>';

    try {
      const response = await fetch('/account/mira/info', {
        headers: { 'Accept': 'text/html', 'X-Requested-With': 'XMLHttpRequest' },
      });
      const html = await response.text();
      if (!response.ok || !html.includes('id="mira-info-title"')) {
        throw new Error('Unable to load Mira information. Please try again.');
      }

      infoContent.innerHTML = html;
      infoLoaded = true;
    } catch (error) {
      const message = document.createElement('p');
      message.className = 'mira-info-error';
      message.textContent = error.message || 'Unable to load Mira information. Please try again.';
      const retryButton = document.createElement('button');
      retryButton.type = 'button';
      retryButton.className = 'mira-info-retry';
      retryButton.textContent = 'Try again';
      retryButton.addEventListener('click', loadMiraInfo);
      infoContent.replaceChildren(message, retryButton);
    } finally {
      infoLoading = false;
    }
  }

  if (infoButton && infoOverlay && infoDrawer && infoCloseButton && infoContent) {
    infoButton.addEventListener('click', function () {
      if (infoOverlay.classList.contains('show')) {
        closeInfoDrawer();
        return;
      }

      previousBodyOverflow = document.body.style.overflow;
      infoOverlay.classList.add('show');
      infoButton.setAttribute('aria-expanded', 'true');
      document.body.style.overflow = 'hidden';
      infoCloseButton.focus();
      loadMiraInfo();
    });

    infoCloseButton.addEventListener('click', closeInfoDrawer);
    infoOverlay.addEventListener('click', function (event) {
      if (event.target === infoOverlay) closeInfoDrawer();
    });
    document.addEventListener('keydown', function (event) {
      if (event.key === 'Escape' && infoOverlay.classList.contains('show')) closeInfoDrawer();
    });
  }

  const modal = document.getElementById('mira-edit-modal');
  const modalAvatar = document.getElementById('mira-edit-modal-avatar');
  const modalTitle = document.getElementById('mira-edit-modal-title');
  const modalSubtitle = document.getElementById('mira-edit-modal-subtitle');
  const canUseInput = document.getElementById('mira-edit-can-use');
  const permissionGrid = document.getElementById('mira-edit-permission-grid');
  const statusEl = document.getElementById('mira-edit-modal-status');
  const saveBtn = document.getElementById('mira-edit-modal-save');
  const cancelBtn = document.getElementById('mira-edit-modal-cancel');
  const closeBtn = document.getElementById('mira-edit-modal-close');
  let currentUserId = null;

  function openModal() { modal.classList.add('show'); }
  function closeModal() { modal.classList.remove('show'); currentUserId = null; }

  function setStatus(message, kind) {
    statusEl.textContent = message || '';
    statusEl.className = 'mira-modal-status' + (kind ? ' ' + kind : '');
  }

  async function loadUser(userId, name) {
    currentUserId = userId;
    modalAvatar.textContent = (name || '?').trim().charAt(0).toUpperCase() || '?';
    modalTitle.textContent = 'Mira access';
    modalSubtitle.textContent = name ? ('What ' + name + ' can do through Mira.') : 'What this person can do through Mira.';
    permissionGrid.innerHTML = '<div class="mira-empty-state">Loading…</div>';
    canUseInput.checked = false;
    canUseInput.disabled = false;
    saveBtn.style.display = '';
    setStatus('');
    openModal();

    try {
      const response = await fetch('/account/mira/user/' + encodeURIComponent(userId), {
        headers: { 'Accept': 'application/json', 'X-Requested-With': 'XMLHttpRequest' },
      });
      const data = await response.json();
      if (!response.ok) throw new Error(data.error || 'Unable to load this employee.');

      canUseInput.checked = !!data.canUseMira;
      if (data.isOwner) {
        setStatus('The owner is billed for Mira like anyone else - grant or revoke access the same way.', '');
      }

      const selected = new Set(data.permissions || []);
      permissionGrid.innerHTML = (data.permissionOptions || []).map(function (option) {
        const checked = selected.has(option.key) ? 'checked' : '';
        const id = 'mira-perm-' + option.key;
        return '<label class="mira-permission-item" for="' + id + '">' +
          '<input type="checkbox" id="' + id + '" value="' + option.key + '" ' + checked + ' />' +
          '<span>' + option.label + '</span>' +
          '</label>';
      }).join('');
    } catch (error) {
      permissionGrid.innerHTML = '';
      setStatus(error.message || 'Unable to load this employee.', 'error');
    }
  }

  document.querySelectorAll('[data-mira-edit-user]').forEach(function (btn) {
    btn.addEventListener('click', function () {
      loadUser(
        btn.getAttribute('data-mira-edit-user'),
        btn.getAttribute('data-mira-edit-name')
      );
    });
  });

  if (closeBtn) closeBtn.addEventListener('click', closeModal);
  if (cancelBtn) cancelBtn.addEventListener('click', closeModal);
  if (modal) {
    modal.addEventListener('click', function (event) {
      if (event.target === modal) closeModal();
    });
  }

  if (saveBtn) {
    saveBtn.addEventListener('click', async function () {
      if (!currentUserId) return;
      const permissions = Array.from(permissionGrid.querySelectorAll('input[type="checkbox"]:checked')).map(function (el) {
        return el.value;
      });

      saveBtn.disabled = true;
      const previousLabel = saveBtn.textContent;
      saveBtn.textContent = 'Saving…';
      setStatus('');

      try {
        const response = await fetch('/account/mira/user/' + encodeURIComponent(currentUserId), {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'Accept': 'application/json',
            'X-Requested-With': 'XMLHttpRequest',
          },
          body: JSON.stringify({
            canUseMira: canUseInput.checked ? '1' : '0',
            permissions: permissions,
          }),
        });
        const data = await response.json();
        if (!response.ok || !data.success) throw new Error(data.error || 'Unable to save.');

        const rowCheckbox = document.querySelector('[data-user-checkbox="' + currentUserId + '"]');
        if (rowCheckbox) rowCheckbox.checked = !!data.canUseMira;

        setStatus('Saved.', 'success');
        setTimeout(closeModal, 500);
      } catch (error) {
        setStatus(error.message || 'Unable to save right now.', 'error');
      } finally {
        saveBtn.disabled = false;
        saveBtn.textContent = previousLabel;
      }
    });
  }
})();
</script>
