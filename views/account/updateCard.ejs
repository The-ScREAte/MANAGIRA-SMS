<!DOCTYPE html>
<html lang="en">
  <head>
    <link rel="stylesheet" href="/css/globalScale.css">
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Update Payment Method</title>
    <% const paystackUiEnabled = (typeof paystackEnabled !== 'undefined') ? Boolean(paystackEnabled) : false; %>
    <% if (paystackUiEnabled) { %>
    <script src="https://js.paystack.co/v1/inline.js"></script>
    <% } %>
    <style>
      :root {
        --font-family: "<%= (session && session.fontStyle ? String(session.fontStyle).trim() : 'Inter') %>", sans-serif;
      }


      /* General Page Styling */
      body {
        background-color: #f8f9fa;
        margin: 0;
        text-align: center;
      }

      .main-content {
        padding: 0 16px;
        max-width: 1200px;
        margin: 0 auto;
        box-sizing: border-box;
      }

      h1 {
        color: #333;
        margin-top: 20px;
        font-weight: 700;
      }


      /* Saved Cards Section */
      #saved-cards {
        list-style-type: none;
        padding: 0;
        max-width: 700px;
        margin: 20px auto;
        display: flex;
        flex-direction: column;
        gap: 15px;
      }

      #saved-cards li {
        background: white;
        padding: 22px 18px;
        border-radius: 10px;
        box-shadow: 0px 4px 8px rgba(0, 0, 0, 0.1);
        display: flex;
        justify-content: space-between;
        align-items: center;
        border-left: 5px solid #01535b;
        font-size: 16px;
        font-weight: 500;
        flex-wrap: wrap;
        word-break: break-word;
      }

      #saved-cards li.primary {
        border-left: 5px solid #28a745;
      }

      .card-copy {
        display: flex;
        flex-direction: column;
        gap: 6px;
        align-items: flex-start;
        text-align: left;
      }

      .card-meta-row {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        align-items: center;
      }

      .card-badge {
        display: inline-flex;
        align-items: center;
        padding: 4px 8px;
        border-radius: 999px;
        font-size: 0.78rem;
        font-weight: 700;
        background: #e7f6ef;
        color: #1f7a3d;
      }

      .card-badge.secondary {
        background: #eef4ff;
        color: #2347a5;
      }

      .card-actions-row {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        align-items: center;
        justify-content: flex-end;
      }

      .fallback-order-box {
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: 0.88rem;
        color: #31424a;
      }

      .fallback-order-input {
        width: 78px;
        padding: 7px 9px;
        border: 1px solid #cdd6da;
        border-radius: 6px;
        font-size: 0.92rem;
      }

      .set-primary,
      .remove-card {
        max-width: 90px;
        min-width: 80px;
        background-color: #01535b;
        color: white;
        border: none;
        padding: 6px 10px;
        border-radius: 4px;
        cursor: pointer;
        font-weight: 600;
        font-size: 0.9rem;
        transition: 0.3s ease-in-out;
      }

      .set-primary:hover {
        background-color: #01535b;
      }

      .remove-card {
        background-color: #dc3545;
      }

      .remove-card:hover {
        background-color: #a71d2a;
      }


      /* Form Styling */
      #add-card-form {
        max-width: 600px;
        background: white;
        padding: 28px 20px;
        border-radius: 10px;
        box-shadow: 0px 4px 6px rgba(0, 0, 0, 0.1);
        margin: 24px auto;
        display: flex;
        flex-direction: column;
        align-items: center;
        width: 100%;
      }
      /* Responsive Design */
      @media (max-width: 900px) {
        .main-content {
          padding: 0 12px;
        }
        #saved-cards {
          max-width: 98vw;
        }
        #add-card-form {
          max-width: 98vw;
        }
      }

      @media (max-width: 600px) {
        .main-content {
          padding: 0 8px;
        }
        #saved-cards li {
          flex-direction: column;
          align-items: flex-start;
          font-size: 15px;
          padding: 12px 8px;
        }
        .card-actions-row {
          width: 100%;
          justify-content: stretch;
        }
        .fallback-order-box {
          width: 100%;
          justify-content: space-between;
        }
        .set-primary, .remove-card {
          width: 100%;
          margin-top: 8px;
          max-width: none;
        }
        #add-card-form {
          padding: 10px;
        }
      }

      @media (max-width: 400px) {
        .main-content {
          padding: 0 4px;
        }
        #saved-cards li {
          font-size: 13px;
          padding: 8px 4px;
        }
        #add-card-form {
          padding: 4px;
        }
      }

      #card-element {
        width: 100%;
        padding: 10px;
        border-radius: 5px;
        border: 1px solid #ccc;
        margin-bottom: 10px;
      }

      .btn-primary {
        background-color: #28a745;
        color: white;
        border: none;
        padding: 8px 16px;
        font-size: 0.95rem;
        font-weight: bold;
        border-radius: 4px;
        cursor: pointer;
        transition: 0.3s ease-in-out;
        width: auto;
        max-width: 150px;
        min-width: 90px;
      }

      .btn-primary:hover {
        background-color: #218838;
      }

      /* Error Message */
      #card-errors {
        color: red;
        font-size: 14px;
        margin-top: 10px;
      }
      .notice {
        background-color: #e7f3fe;
        color: #0c5460;
        border: 1px solid #bee5eb;
        border-radius: 5px;
        padding: 15px;
        margin-bottom: 20px;
      }
      .notice h2 {
        font-size: 18px;
        margin: 0 0 10px;
        font-weight: bold;
      }
      /* 🌍 Paystack Accounts List */
.paystack-account-list {
  list-style-type: none;
  padding: 0;
  max-width: 800px;
  margin: 20px auto;
}

/* 🧾 Individual Account Entry */
.paystack-account {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background-color: #ffffff;
  border-left: 5px solid #01535b;
  border-radius: 8px;
  padding: 15px 20px;
  margin-bottom: 15px;
  box-shadow: 0 4px 6px rgba(0, 0, 0, 0.08);
  font-size: 16px;
  font-weight: 500;
  transition: transform 0.2s ease;
}

.paystack-account:hover {
  transform: translateY(-2px);
}

/* ✅ Primary Indicator */
.paystack-account span {
  font-weight: bold;
  color: #28a745;
  margin-left: 10px;
}

/* 🛠 Edit Button */
.edit-ps-account {
  background-color: #007bff;
  color: white;
  border: none;
  padding: 8px 14px;
  border-radius: 5px;
  cursor: pointer;
  font-weight: 600;
  transition: background-color 0.3s ease;
}

.edit-ps-account:hover {
  background-color: #0056b3;
}

      /* Card Modal Styles */
      .card-modal-overlay {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(0, 0, 0, 0.7);
        display: flex;
        justify-content: center;
        align-items: center;
        z-index: 1000;
      }

      .card-modal {
        background: white;
        border-radius: 12px;
        width: 90%;
        max-width: 450px;
        box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);
        animation: modalSlideIn 0.3s ease-out;
      }

      @keyframes modalSlideIn {
        from {
          opacity: 0;
          transform: translateY(-50px) scale(0.9);
        }
        to {
          opacity: 1;
          transform: translateY(0) scale(1);
        }
      }

      .card-modal-header {
        padding: 24px 24px 0;
        display: flex;
        justify-content: space-between;
        align-items: center;
        border-bottom: 1px solid #e5e7eb;
        margin-bottom: 24px;
      }

      .card-modal-header h3 {
        margin: 0;
        color: #1f2937;
        font-size: 20px;
        font-weight: 600;
      }

      .close-modal {
        background: none;
        border: none;
        font-size: 24px;
        color: #6b7280;
        cursor: pointer;
        padding: 4px;
        line-height: 1;
        transition: color 0.2s;
      }

      .close-modal:hover {
        color: #ef4444;
      }

      .card-modal-body {
        padding: 0 24px 24px;
      }

      .card-modal .form-group {
        margin-bottom: 16px;
      }

      .card-modal .form-group label {
        display: block;
        margin-bottom: 6px;
        font-weight: 500;
        color: #374151;
        font-size: 14px;
      }

      .card-modal .form-group input,
      .card-modal .form-group select {
        width: 100%;
        padding: 12px 16px;
        border: 2px solid #e5e7eb;
        border-radius: 8px;
        font-size: 16px;
        transition: border-color 0.2s, box-shadow 0.2s;
        box-sizing: border-box;
      }

      .card-modal .form-group input:focus,
      .card-modal .form-group select:focus {
        outline: none;
        border-color: #3b82f6;
        box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.1);
      }

      .card-modal .form-row {
        display: grid;
        grid-template-columns: 1fr 1fr 1fr;
        gap: 12px;
      }

      .card-modal .btn {
        padding: 12px 24px;
        border: none;
        border-radius: 8px;
        font-size: 16px;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.2s;
        text-align: center;
        width: 100%;
        margin-top: 12px;
      }

      .card-modal .btn-primary {
        background: linear-gradient(135deg, #3b82f6, #1d4ed8);
        color: white;
      }

      .card-modal .btn-primary:hover:not(:disabled) {
        background: linear-gradient(135deg, #2563eb, #1e40af);
        transform: translateY(-1px);
        box-shadow: 0 4px 12px rgba(59, 130, 246, 0.4);
      }

      .card-modal .btn-primary:disabled {
        background: #9ca3af;
        cursor: not-allowed;
        transform: none;
        box-shadow: none;
      }

      .card-step {
        display: none;
      }

      .card-step.active {
        display: block;
      }

      .status-text {
        margin: 0 0 12px;
        font-size: 14px;
        color: #374151;
      }

      .status-text.error {
        color: #b91c1c;
      }

      .status-text.success {
        color: #047857;
      }

      .channel-options {
        display: flex;
        flex-direction: column;
        gap: 10px;
        margin: 8px 0 12px;
      }

      .channel-option {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 10px 12px;
        border: 1px solid #e5e7eb;
        border-radius: 8px;
        cursor: pointer;
      }

      .channel-option input {
        margin: 0;
      }

      .channel-label {
        font-weight: 600;
      }

      .channel-value {
        color: #6b7280;
        font-size: 13px;
      }

    </style>
    <style>
      body {
        font-family: var(--font-family);
      }
    </style>
  </head>
  <body>
    <%- include('../partials/flash') %>

    <div class="main-content">
      <h1><%= isHubMember ? 'Self Enrollment Payment Methods' : 'Manage Payment Methods' %></h1>

      <% if (isHubMember) { %>
      <div class="notice" style="max-width: 700px; margin: 20px auto; text-align: left;">
        <h2>Hub Billing Active</h2>
        <p>
          Your organization is under hub coverage
          <% if (hubName) { %> (<strong><%= hubName %></strong>) <% } %>
          and is not charged directly for platform subscription.
          <% if (hubContractEndDate) { %>
            Coverage ends on <strong><%= new Date(hubContractEndDate).toLocaleDateString() %></strong>.
          <% } else { %>
            Contract end date is not set yet.
          <% } %>
        </p>
      </div>
      <% } %>

      <% if (!isHubMember) { %>
      <!-- Display current payment methods -->
      <% if (paymentMethods.length > 0) { %>
      <h2>Saved <%= paymentProvider === 'stripe' ? 'Stripe' : 'Paystack' %> Cards</h2>
    <ul id="saved-cards">
      <% paymentMethods.forEach((card, index) => { %>
      <li class="<%= (card.isPrimary || index === 0) ? 'primary' : '' %>">
        <div class="card-copy">
          <strong><%= card.brand %></strong>
          <span>ending in <%= card.last4 %> (Exp: <%= card.expMonth %>/<%= card.expYear %>)</span>
          <div class="card-meta-row">
            <% if (card.isPrimary || index === 0) { %>
              <span class="card-badge">Primary</span>
            <% } %>
            <% if (card.fallbackOrder !== null && card.fallbackOrder !== undefined && !(card.isPrimary || index === 0)) { %>
              <span class="card-badge secondary">Fallback #<%= card.fallbackOrder %></span>
            <% } %>
          </div>
        </div>
        <div class="card-actions-row">
          <label class="fallback-order-box">
            <span>Fallback order</span>
            <input
              class="fallback-order-input"
              type="number"
              min="0"
              max="999"
              data-id="<%= card.id %>"
              value="<%= card.fallbackOrder ?? '' %>"
            />
          </label>
          <% if (!(card.isPrimary || index === 0)) { %>
          <button class="set-primary" data-id="<%= card.id %>">
            Set as Primary
          </button>
          <% } %>
          <% if (paymentMethods.length > 1 && !(card.isPrimary || index === 0)) { %>
          <button class="remove-card" data-id="<%= card.id %>">Remove</button>
          <% } %>
        </div>
      </li>
      <% }) %>
    </ul>
    <% } else { %>
    <p>No payment method saved.</p>
    <% } %>

    <% if (paymentProvider === 'paystack') { %>
      <h2>Add a New Card</h2>
      <div id="add-card-section">
        <p>To add a new card, you need to make a test payment which will save your card details securely.</p>
        <button type="button" id="add-card-button" class="btn-primary">Add New Card (As Backup)</button>
      </div>
    <% } else { %>
      <h2>Card Updates</h2>
      <div id="add-card-section">
        <p>Your saved Stripe cards are shown above. Primary card selection and removal are supported on this page.</p>
      </div>
    <% } %>

    <% if (billingHistory && billingHistory.length > 0) { %>
      <h2>Billing History</h2>
      <ul id="saved-cards">
        <% billingHistory.forEach((item) => { %>
          <li>
            <div>
              <strong><%= (item.payment_provider || 'unknown').toUpperCase() %></strong>
              on <%= item.created_at ? new Date(item.created_at).toLocaleDateString() : 'N/A' %>
              <br />
              Status: <%= item.status || 'unknown' %>
              <% if (item.is_trial) { %> | Trial <% } %>
              <% if (item.billing_period_key) { %> | <%= item.billing_period_key %> <% } %>
              <br />
              Amount: <%= typeof item.amount_paid === 'number' ? item.amount_paid.toFixed(2) : item.amount_paid %>
              <% if (item.next_payment_end_date) { %>
                | Next billing date: <%= new Date(item.next_payment_end_date).toLocaleDateString() %>
              <% } %>
            </div>
          </li>
        <% }) %>
      </ul>
    <% } %>

    <% if (paymentProvider === 'stripe' && stripeInvoices && stripeInvoices.length > 0) { %>
      <h2>Stripe Invoices</h2>
      <ul id="saved-cards">
        <% stripeInvoices.forEach((invoice) => { %>
          <li>
            <div>
              <strong><%= invoice.number || invoice.id %></strong>
              <% if (invoice.createdAt) { %>
                on <%= new Date(invoice.createdAt).toLocaleDateString() %>
              <% } %>
              <br />
              Status: <%= invoice.status || 'unknown' %> | Paid: <%= invoice.currency %> <%= Number(invoice.amountPaid || 0).toFixed(2) %>
              <% if (Number(invoice.amountDue || 0) > 0) { %>
                | Due: <%= invoice.currency %> <%= Number(invoice.amountDue || 0).toFixed(2) %>
              <% } %>
            </div>
            <div>
              <% if (invoice.hostedInvoiceUrl) { %>
                <a class="set-primary" href="<%= invoice.hostedInvoiceUrl %>" target="_blank" rel="noopener noreferrer" style="text-decoration:none; display:inline-block; text-align:center;">Open</a>
              <% } %>
              <% if (invoice.invoicePdf) { %>
                <a class="set-primary" href="<%= invoice.invoicePdf %>" target="_blank" rel="noopener noreferrer" style="text-decoration:none; display:inline-block; text-align:center; margin-left:8px;">PDF</a>
              <% } %>
            </div>
          </li>
        <% }) %>
      </ul>
    <% } %>
    <% } %>

<hr>
    <div class="notice">
      <h2>Notice:</h2>
      <p>
        <% if (paystackUiEnabled) { %>
          Below, you can set up MoMo or bank options for users to pay their self enrollment fee. They can choose any payment method you set up.
        <% } else { %>
          Below, you can set up a card, bank account, or Apple Pay (via Stripe) for users to pay their self enrollment fee. They can choose any payment method you set up.
        <% } %>
      </p>
    </div>


  
    <h2 id="paystack-form-title">Self Enrollment Payment Methods</h2>
    <form id="paystack-form" class="form-box">
      <input type="hidden" name="id" id="ps-id" />
      <label>Payment Type
        <select name="account_type" id="ps-type" required onchange="togglePaystackFields()">
          <option value="">-- Choose Option --</option>
          <option value="bank">Bank Account</option>
          <% if (paystackUiEnabled) { %>
            <option value="mobile_money">Mobile Money (MoMo)</option>
          <% } %>
        </select>
      </label>
      
      <!-- Common Fields -->
      <label>Business/School Name <input type="text" name="business_name" id="ps-business-name" required /></label>
      
      <!-- Bank Specific Fields -->
      <div id="bank-fields" style="display: none;">
        <label>Account Number <input type="text" name="account_number" id="ps-account-number" placeholder="Use: 0000000000 for GTBank test" /></label>
        <label>Bank Code 
          <select name="bank_code" id="ps-bank-code" onchange="updateBankName()">
            <option value="">-- Select Bank --</option>
            <option value="057">Zenith Bank</option>
            <option value="058">Guaranty Trust Bank (GTBank)</option>
            <option value="033">United Bank for Africa (UBA)</option>
            <option value="214">First City Monument Bank (FCMB)</option>
            <option value="011">First Bank of Nigeria</option>
            <option value="050">Ecobank Nigeria</option>
            <option value="070">Fidelity Bank</option>
            <option value="007">Access Bank</option>
            <option value="221">Stanbic IBTC Bank</option>
            <option value="068">Standard Chartered Bank</option>
            <option value="232">Sterling Bank</option>
            <option value="035">Wema Bank</option>
            <option value="032">Union Bank of Nigeria</option>
            <option value="076">Polaris Bank</option>
            <option value="082">Keystone Bank</option>
            <option value="030">Heritage Bank</option>
            <option value="215">Unity Bank</option>
            <option value="101">Providus Bank</option>
            <option value="301">Jaiz Bank</option>
          </select>
        </label>
        <!-- Hidden field for bank name -->
        <input type="hidden" name="bank_name" id="ps-bank-name" />
      </div>

      <!-- Mobile Money Specific Fields -->
      <div id="momo-fields" style="display: none;">
        <label>Mobile Money Number 
          <input type="text" name="momo_number" id="ps-momo-number" placeholder="e.g., 0244123456" />
        </label>
        <label>Mobile Money Provider
          <select name="momo_provider" id="ps-momo-provider">
            <option value="">-- Select Provider --</option>
            <option value="MTN">MTN Mobile Money</option>
            <option value="VDF">Vodafone Cash</option>
            <option value="ATL">AirtelTigo Money</option>
          </select>
        </label>
        <label>Account Holder Name 
          <input type="text" name="account_holder_name" id="ps-account-holder" placeholder="Name registered on the MoMo account" />
        </label>
      </div>
      
      <button type="submit" class="btn btn-primary">Save</button>
      <button type="button" id="delete-ps-account" class="btn btn-danger" style="display: none;">Delete</button>
    </form>

    <h2>Connected Self Enrollment Payment Methods</h2>
    <ul id="ps-accounts-list" class="paystack-account-list">
      <% paystackSubaccounts.forEach(account => { %>
        <li class="paystack-account" data-id="<%= account.id %>">
          <div>
            <strong><%= account.account_type.toUpperCase() %></strong> - 
            <%= account.business_name %>
            <% if (account.account_type === 'bank') { %>
              - Account: <%= account.account_number %> - Bank: <%= account.bank_name || account.bank_code %>
            <% } else if (account.account_type === 'mobile_money') { %>
              - <%= account.momo_provider || 'MoMo' %>: <%= account.momo_number %> 
              <% if (account.account_holder_name) { %>
                (<%= account.account_holder_name %>)
              <% } %>
            <% } %>
            <% if (account.is_primary) { %>
              <span style="color: green;">(Primary)</span>
            <% } else { %>
              <button class="btn set-ps-primary" data-id="<%= account.id %>" data-type="<%= account.account_type %>">
                Set as Primary
              </button>
            <% } %>
          </div>
          <button class="btn edit-ps-account" data-id="<%= account.id %>">Edit</button>
        </li>
      <% }) %>
    </ul>
    
      
    <script>
      document.addEventListener("DOMContentLoaded", () => {
        document.querySelectorAll(".set-fw-primary").forEach((btn) => {
          btn.addEventListener("click", async () => {
            const id = btn.dataset.id;
            const type = btn.dataset.type;
    
            try {
              const res = await fetch("/account/paystack/set-primary", {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({ id, account_type: type }),
              });
    
              const data = await res.json();
              if (data.success) location.reload();
              else alert("❌ Failed to update primary account.");
            } catch (err) {
              console.error("❌ Network error:", err);
              alert("❌ Failed to connect. Try again.");
            }
          });
        });
      });

      function togglePaystackFields() {
        const type = document.getElementById("ps-type").value;
        const bankFields = document.getElementById("bank-fields");
        const momoFields = document.getElementById("momo-fields");
        
        // Hide all fields first
        bankFields.style.display = "none";
        momoFields.style.display = "none";
        
        // Clear required attributes
        document.querySelectorAll("#bank-fields input, #bank-fields select").forEach(field => {
          field.removeAttribute("required");
        });
        document.querySelectorAll("#momo-fields input, #momo-fields select").forEach(field => {
          field.removeAttribute("required");
        });
        
        // Show and set required fields based on type
        if (type === "bank") {
          bankFields.style.display = "block";
          document.getElementById("ps-account-number").setAttribute("required", "required");
          document.getElementById("ps-bank-code").setAttribute("required", "required");
        } else if (type === "mobile_money") {
          momoFields.style.display = "block";
          document.getElementById("ps-momo-number").setAttribute("required", "required");
          document.getElementById("ps-momo-provider").setAttribute("required", "required");
          document.getElementById("ps-account-holder").setAttribute("required", "required");
        }
      }

      function updateBankName() {
        const bankSelect = document.getElementById("ps-bank-code");
        const bankNameField = document.getElementById("ps-bank-name");
        const selectedOption = bankSelect.options[bankSelect.selectedIndex];
        
        if (selectedOption.value) {
          bankNameField.value = selectedOption.text;
          // ...removed log for clean background operation...
        } else {
          bankNameField.value = "";
        }
      }

      // Also update bank name when form is submitted (as a backup)
      function ensureBankName() {
        const bankCode = document.getElementById("ps-bank-code").value;
        const bankName = document.getElementById("ps-bank-name").value;
        
        if (bankCode && !bankName) {
          updateBankName();
        }
      }
  
      document.addEventListener("DOMContentLoaded", () => {
        // Edit functionality
        document.querySelectorAll(".edit-ps-account").forEach(btn => {
          btn.onclick = async () => {
            const id = btn.dataset.id;
            const res = await fetch(`/account/paystack/${id}`);
            if (!res.ok) {
              const text = await res.text();
              console.error("❌ Error loading Paystack account:", text);
              return alert("Failed to load account.");
            }
            const data = await res.json();
            if (data.success) {
              document.getElementById("paystack-form-title").textContent = "Edit Paystack Subaccount";
              document.getElementById("ps-id").value = data.account.id;
              document.getElementById("ps-type").value = data.account.account_type;
              document.getElementById("ps-business-name").value = data.account.business_name;
              
              // Populate fields based on account type
              if (data.account.account_type === "bank") {
                document.getElementById("ps-account-number").value = data.account.account_number || "";
                document.getElementById("ps-bank-code").value = data.account.bank_code || "";
                document.getElementById("ps-bank-name").value = data.account.bank_name || "";
              } else if (data.account.account_type === "mobile_money") {
                document.getElementById("ps-momo-number").value = data.account.momo_number || "";
                document.getElementById("ps-momo-provider").value = data.account.momo_provider || "";
                document.getElementById("ps-account-holder").value = data.account.account_holder_name || "";
              }
              
              togglePaystackFields();
              document.getElementById("delete-ps-account").style.display = "inline-block";
            }
          };
        });
          
        // Submit functionality
        document.getElementById("paystack-form").addEventListener("submit", async (e) => {
          e.preventDefault();
          
          // Ensure bank name is set before submission
          ensureBankName();
        
          const formData = new FormData(e.target);
          const json = Object.fromEntries(formData);
          
          // Debug: Log the form data being sent
          // ...removed log for clean background operation...
        
          const isEditing = json.id && json.id !== "";
        
          const url = isEditing ? "/account/paystack" : "/account/add-paystack-subaccount";
          const method = isEditing ? "PUT" : "POST";
        
          try {
            const res = await fetch(url, {
              method,
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify(json),
            });
        
            const data = await res.json();
            // ...removed log for clean background operation...
            if (data.success) location.reload();
            else alert("❌ Failed to save account: " + data.message);
          } catch (err) {
            console.error("❌ Network error:", err);
            alert("❌ Failed to connect. Try again.");
          }
        });
        
        // Set primary functionality
        document.querySelectorAll(".set-ps-primary").forEach(btn => {
          btn.onclick = async () => {
            const id = btn.dataset.id;
            const type = btn.dataset.type;
            
            try {
              const res = await fetch("/account/paystack/set-primary", {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({ id, account_type: type }),
              });
    
              const data = await res.json();
              if (data.success) location.reload();
              else alert("❌ Failed to update primary account.");
            } catch (err) {
              console.error("❌ Network error:", err);
              alert("❌ Failed to connect. Try again.");
            }
          };
        });
        
        // Delete functionality
        document.getElementById("delete-ps-account").onclick = async () => {
          const id = document.getElementById("ps-id").value;
          if (!id) return;
          if (!confirm("Are you sure you want to delete this subaccount?")) return;
          const res = await fetch(`/account/paystack/${id}`, { method: "DELETE" });
          const data = await res.json();
          if (data.success) location.reload();
          else alert("❌ Failed to delete account.");
        };
      });
    </script>
    <% if (!isHubMember) { %>
    <script>
      // ✅ Paystack card management
      const orgEmail = <%- JSON.stringify(orgEmail || "") %>;
      const orgPhone = <%- JSON.stringify(orgPhone || "") %>;

      document.addEventListener("DOMContentLoaded", () => {
        // Add new card functionality without payment
        document.getElementById("add-card-button").addEventListener("click", function() {
          // Create a custom form for card tokenization
          showCardForm();
        });

        function showCardForm() {
          const modal = document.createElement('div');
          modal.className = 'card-modal-overlay';
          modal.innerHTML = `
            <div class="card-modal">
              <div class="card-modal-header">
                <h3>Add New Card</h3>
                <button type="button" class="close-modal">&times;</button>
              </div>
              <div class="card-modal-body">
                <p class="status-text" id="card-status" role="status" aria-live="polite"></p>

                <div class="card-step active" data-step="card">
                  <form id="card-form">
                    <div class="form-group">
                      <label for="card-number">Card Number</label>
                      <input type="text" id="card-number" maxlength="19" placeholder="1234 5678 9012 3456" required>
                    </div>
                    <div class="form-row">
                      <div class="form-group">
                        <label for="expiry-month">Expiry Month</label>
                        <select id="expiry-month" required>
                          <option value="">MM</option>
                          ${Array.from({length: 12}, (_, i) => `<option value="${String(i+1).padStart(2, '0')}">${String(i+1).padStart(2, '0')}</option>`).join('')}
                        </select>
                      </div>
                      <div class="form-group">
                        <label for="expiry-year">Expiry Year</label>
                        <select id="expiry-year" required>
                          <option value="">YYYY</option>
                          ${Array.from({length: 15}, (_, i) => {
                            const year = new Date().getFullYear() + i;
                            return `<option value="${year}">${year}</option>`;
                          }).join('')}
                        </select>
                      </div>
                      <div class="form-group">
                        <label for="cvv">CVV</label>
                        <input type="text" id="cvv" maxlength="4" placeholder="123" required>
                      </div>
                    </div>
                    <button type="submit" class="btn btn-primary" id="tokenize-btn">Continue</button>
                  </form>
                </div>

                <div class="card-step" data-step="channel">
                  <div class="channel-options">
                    <label class="channel-option channel-email">
                      <input type="radio" name="otp-channel" value="email" checked>
                      <span class="channel-label">Email</span>
                      <span class="channel-value" id="channel-email-value"></span>
                    </label>
                    <label class="channel-option channel-phone">
                      <input type="radio" name="otp-channel" value="phone">
                      <span class="channel-label">Phone</span>
                      <span class="channel-value" id="channel-phone-value"></span>
                    </label>
                  </div>
                  <button type="button" class="btn btn-primary" id="channel-continue">Continue</button>
                </div>

                <div class="card-step" data-step="pin">
                  <form id="pin-form">
                    <div class="form-group">
                      <label for="card-pin">Card PIN</label>
                      <input type="password" id="card-pin" maxlength="4" placeholder="1234" required>
                    </div>
                    <button type="submit" class="btn btn-primary" id="pin-submit">Submit PIN</button>
                  </form>
                </div>

                <div class="card-step" data-step="otp">
                  <form id="otp-form">
                    <div class="form-group">
                      <label for="card-otp">OTP Code</label>
                      <input type="text" id="card-otp" maxlength="8" placeholder="123456" required>
                    </div>
                    <button type="submit" class="btn btn-primary" id="otp-submit">Verify OTP</button>
                  </form>
                </div>
              </div>
            </div>
          `;

          document.body.appendChild(modal);

          const statusText = modal.querySelector('#card-status');
          const steps = modal.querySelectorAll('.card-step');
          const channelEmailValue = modal.querySelector('#channel-email-value');
          const channelPhoneValue = modal.querySelector('#channel-phone-value');
          const phoneOption = modal.querySelector('.channel-phone');

          let currentReference = null;
          let otpChannelSelected = false;
          let channelMode = 'choice';

          channelEmailValue.textContent = orgEmail || 'Email on file';
          if (orgPhone) {
            channelPhoneValue.textContent = orgPhone;
          } else if (phoneOption) {
            phoneOption.style.display = 'none';
          }

          function setStatus(message, tone) {
            if (!statusText) return;
            statusText.textContent = message || '';
            statusText.classList.remove('error', 'success');
            if (tone === 'error') statusText.classList.add('error');
            if (tone === 'success') statusText.classList.add('success');
          }

          function setStep(stepName) {
            steps.forEach((step) => {
              step.classList.toggle('active', step.dataset.step === stepName);
            });
          }

          function showChannelStep(mode) {
            channelMode = mode || 'choice';
            const emailOption = modal.querySelector('.channel-email');
            if (channelMode === 'phone') {
              if (!orgPhone) {
                setStatus('Phone number is not available for this account.', 'error');
                return;
              }
              if (emailOption) emailOption.style.display = 'none';
              if (phoneOption) {
                phoneOption.style.display = 'flex';
                phoneOption.querySelector('input').checked = true;
              }
            } else {
              if (emailOption) emailOption.style.display = 'flex';
              if (phoneOption) {
                phoneOption.style.display = orgPhone ? 'flex' : 'none';
                if (!orgPhone) {
                  const emailInput = modal.querySelector('input[name="otp-channel"][value="email"]');
                  if (emailInput) emailInput.checked = true;
                }
              }
            }
            setStep('channel');
          }

          function handleChargeResult(result) {
            if (result.success) {
              setStatus('Card added successfully.', 'success');
              setTimeout(() => {
                document.body.removeChild(modal);
                location.reload();
              }, 600);
              return;
            }

            if (!result.nextStep) {
              setStatus(result.message || 'Failed to add card.', 'error');
              return;
            }

            currentReference = result.reference || currentReference;
            setStatus(result.message || 'Additional verification required.');

            if (result.nextStep === 'pin') {
              setStep('pin');
              return;
            }

            if (result.nextStep === 'phone') {
              otpChannelSelected = true;
              showChannelStep('phone');
              return;
            }

            if (result.nextStep === 'otp') {
              if (otpChannelSelected || !orgPhone) {
                setStep('otp');
              } else {
                showChannelStep('choice');
              }
              return;
            }

            if (result.nextStep === 'birthday') {
              setStatus('This card needs birthday verification. Please try another card.', 'error');
              return;
            }
          }

          modal.querySelector('.close-modal').addEventListener('click', () => {
            document.body.removeChild(modal);
          });

          modal.addEventListener('click', (e) => {
            if (e.target === modal) {
              document.body.removeChild(modal);
            }
          });

          const cardNumberInput = modal.querySelector('#card-number');
          cardNumberInput.addEventListener('input', (e) => {
            let value = e.target.value.replace(/\s/g, '');
            let formattedValue = value.replace(/(.{4})/g, '$1 ').trim();
            if (formattedValue.length > 19) formattedValue = formattedValue.substring(0, 19);
            e.target.value = formattedValue;
          });

          modal.querySelector('#card-form').addEventListener('submit', async (e) => {
            e.preventDefault();

            const cardNumber = cardNumberInput.value.replace(/\s/g, '');
            const expiryMonth = modal.querySelector('#expiry-month').value;
            const expiryYear = modal.querySelector('#expiry-year').value;
            const cvv = modal.querySelector('#cvv').value;

            if (!cardNumber || !expiryMonth || !expiryYear || !cvv) {
              setStatus('Please fill in all card details.', 'error');
              return;
            }

            const tokenizeBtn = modal.querySelector('#tokenize-btn');
            tokenizeBtn.disabled = true;
            tokenizeBtn.textContent = 'Processing...';

            try {
              const response = await fetch('/account/api/tokenize-card', {
                method: 'POST',
                headers: {
                  'Content-Type': 'application/json',
                },
                body: JSON.stringify({
                  cardNumber,
                  expiryMonth,
                  expiryYear,
                  cvv
                })
              });

              const result = await response.json();
              tokenizeBtn.disabled = false;
              tokenizeBtn.textContent = 'Continue';
              handleChargeResult(result);
            } catch (error) {
              console.error('Error adding card:', error);
              tokenizeBtn.disabled = false;
              tokenizeBtn.textContent = 'Continue';
              setStatus('Error adding card. Please try again.', 'error');
            }
          });

          modal.querySelector('#channel-continue').addEventListener('click', async () => {
            if (!currentReference) {
              setStatus('Missing transaction reference. Please try again.', 'error');
              return;
            }

            const selected = modal.querySelector('input[name="otp-channel"]:checked')?.value;
            const continueBtn = modal.querySelector('#channel-continue');

            if (channelMode === 'phone' || selected === 'phone') {
              if (!orgPhone) {
                setStatus('Phone number is not available for this account.', 'error');
                return;
              }
              otpChannelSelected = true;
              continueBtn.disabled = true;
              continueBtn.textContent = 'Sending...';
              try {
                const response = await fetch('/account/api/tokenize-card/phone', {
                  method: 'POST',
                  headers: {
                    'Content-Type': 'application/json',
                  },
                  body: JSON.stringify({
                    reference: currentReference,
                    phone: orgPhone
                  })
                });
                const result = await response.json();
                continueBtn.disabled = false;
                continueBtn.textContent = 'Continue';
                handleChargeResult(result);
              } catch (error) {
                console.error('Error submitting phone:', error);
                continueBtn.disabled = false;
                continueBtn.textContent = 'Continue';
                setStatus('Error sending phone number. Please try again.', 'error');
              }
            } else {
              otpChannelSelected = true;
              setStatus(`OTP sent to ${orgEmail}. Enter the code below.`);
              setStep('otp');
            }
          });

          modal.querySelector('#pin-form').addEventListener('submit', async (e) => {
            e.preventDefault();
            const pin = modal.querySelector('#card-pin').value.trim();

            if (!currentReference || !pin) {
              setStatus('Enter a valid PIN.', 'error');
              return;
            }

            const pinSubmit = modal.querySelector('#pin-submit');
            pinSubmit.disabled = true;
            pinSubmit.textContent = 'Submitting...';

            try {
              const response = await fetch('/account/api/tokenize-card/pin', {
                method: 'POST',
                headers: {
                  'Content-Type': 'application/json',
                },
                body: JSON.stringify({
                  reference: currentReference,
                  pin
                })
              });
              const result = await response.json();
              pinSubmit.disabled = false;
              pinSubmit.textContent = 'Submit PIN';
              handleChargeResult(result);
            } catch (error) {
              console.error('Error submitting PIN:', error);
              pinSubmit.disabled = false;
              pinSubmit.textContent = 'Submit PIN';
              setStatus('Error submitting PIN. Please try again.', 'error');
            }
          });

          modal.querySelector('#otp-form').addEventListener('submit', async (e) => {
            e.preventDefault();
            const otp = modal.querySelector('#card-otp').value.trim();

            if (!currentReference || !otp) {
              setStatus('Enter the OTP code.', 'error');
              return;
            }

            const otpSubmit = modal.querySelector('#otp-submit');
            otpSubmit.disabled = true;
            otpSubmit.textContent = 'Verifying...';

            try {
              const response = await fetch('/account/api/tokenize-card/otp', {
                method: 'POST',
                headers: {
                  'Content-Type': 'application/json',
                },
                body: JSON.stringify({
                  reference: currentReference,
                  otp
                })
              });
              const result = await response.json();
              otpSubmit.disabled = false;
              otpSubmit.textContent = 'Verify OTP';
              handleChargeResult(result);
            } catch (error) {
              console.error('Error submitting OTP:', error);
              otpSubmit.disabled = false;
              otpSubmit.textContent = 'Verify OTP';
              setStatus('Error submitting OTP. Please try again.', 'error');
            }
          });
        }

        // Attach button event listeners
        attachButtonListeners();
      });

      // ✅ Function to attach event listeners to buttons
      function attachButtonListeners() {
        document.querySelectorAll(".set-primary").forEach((button) => {
          button.removeEventListener("click", handleSetPrimary);
          button.addEventListener("click", handleSetPrimary);
        });

        document.querySelectorAll(".fallback-order-input").forEach((input) => {
          input.removeEventListener("change", handleFallbackOrderChange);
          input.addEventListener("change", handleFallbackOrderChange);
          input.removeEventListener("blur", handleFallbackOrderChange);
          input.addEventListener("blur", handleFallbackOrderChange);
        });

        document.querySelectorAll(".remove-card").forEach((button) => {
          button.removeEventListener("click", handleRemoveCard);
          button.addEventListener("click", handleRemoveCard);
        });
      }

      // ✅ Function to set a card as the primary payment method
      async function handleSetPrimary(event) {
        const authorizationCode = event.target.getAttribute("data-id");

        try {
          const response = await fetch("/account/cards/set-primary", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ authorizationCode }),
          });

          const data = await response.json();
          if (data.success) {
            window.location.reload();
            return;
          }

          alert(data.message || "Unable to update the primary card.");
        } catch (error) {
          console.error("❌ [FRONTEND] Network error:", error);
          alert("An error occurred while setting the primary card. Please try again.");
        }
      }

      async function handleFallbackOrderChange(event) {
        const input = event.target;
        const authorizationCode = input.getAttribute("data-id");
        const fallbackOrder = input.value.trim();

        try {
          const response = await fetch("/account/cards/set-fallback-order", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ authorizationCode, fallbackOrder }),
          });

          const data = await response.json();
          if (data.success) {
            window.location.reload();
            return;
          }

          alert(data.message || "Unable to update the fallback order.");
        } catch (error) {
          console.error("❌ [FRONTEND] Fallback-order update failed:", error);
          alert("An error occurred while updating fallback order. Please try again.");
        }
      }

      // ✅ Function to remove a card
      async function handleRemoveCard(event) {
        const savedCardCount = document.querySelectorAll("#saved-cards li").length;
        if (savedCardCount <= 1) {
          alert("You must keep at least one saved card on file.");
          return;
        }

        const authorizationCode = event.target.getAttribute("data-id");

        if (!confirm("Are you sure you want to remove this card?")) {
          return;
        }

        try {
          const response = await fetch("/account/remove-card", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ authorizationCode }),
          });

          const data = await response.json();

          if (data.success) {
            // Refresh the page to show updated cards
            window.location.reload();
          } else {
            console.error("❌ Error removing card:", data.message);
            alert("Error removing card: " + data.message);
          }
        } catch (error) {
          console.error("❌ Network error:", error);
          alert("An error occurred. Please try again.");
        }
      }
    </script>
    <% } %>
    </div> <!-- End main-content -->
  </body>
