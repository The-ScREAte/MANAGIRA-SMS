<h1>Parent Portal Login</h1>
<%- include('../partials/flash') %>
<br>
<div style="max-width: 420px; margin: 0 auto 12px auto; padding: 12px 14px; border: 1px solid #e2e8f0; border-radius: 10px; background: #f8fafc;">
  <div style="color: #475569; font-size: 13px; line-height: 1.4;">
    Login with your email or phone number. If you don’t have a password yet, please contact the school to send you a password setup email.
  </div>

</div>

<form id="guardianLoginForm" action="/account/guardian-login" method="post">
  <div class="form-group">
    <label for="identifier">Email or Phone Number:</label>
    <input type="text" id="identifier" name="identifier" placeholder="Email or phone number" required />
  </div>

  <div class="form-group">
    <label for="password">Password:</label>
    <input type="password" id="password" name="password" required />
    <div><input type="checkbox" id="show-password" /> Show Password</div>
  </div>

  <button type="submit">Login</button>
</form>

<style>
  #guardianLoginForm {
    width: 420px;
    margin: 0 auto;
    padding: 20px;
    box-shadow: 0 2px 5px rgba(128, 19, 19, 0.1);
    border-radius: 10px;
  }

  #guardianLoginForm a {
    text-decoration: none;
    color: rgb(54, 104, 86);
    transition: color 0.3s ease, text-decoration 0.2s ease;
  }

  #guardianLoginForm a:hover {
    text-decoration: underline;
    color: rgb(26, 237, 194);
  }

  @media (max-width: 480px) {
    #guardianLoginForm {
      width: 95%;
      padding: 20px;
    }

    h1 {
      font-size: 1.6rem;
    }

    .form-group input {
      font-size: 0.95rem;
      padding: 8px;
    }

    button {
      font-size: 1rem;
      padding: 10px;
    }
  }
</style>

<script>
  // Toggle show password
  document.addEventListener('DOMContentLoaded', function () {
    const checkbox = document.getElementById('show-password');
    const pwd = document.getElementById('password');
    if (checkbox && pwd) {
      checkbox.addEventListener('change', function () {
        pwd.type = checkbox.checked ? 'text' : 'password';
      });
    }
  });
</script>
