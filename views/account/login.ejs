<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="<%= locals.viewportContent || 'width=device-width, initial-scale=1.0' %>">
  <title>Login - Managira</title>
  <link rel="icon" href="/favicon.ico" type="image/x-icon" sizes="any" />
  <link rel="apple-touch-icon" sizes="180x180" href="/images/favicon_io/apple-touch-icon.png" />
  <link rel="shortcut icon" href="/favicon.ico" />
  <style>
    :root {
      --font-family: "Inter", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
      --primary: #01535b;
      --primary-hover: #014a51;
        --primary-hover-fill: color-mix(in srgb, var(--primary) 88%, white);
      --primary-light: rgba(1, 83, 91, 0.08);
      --text-primary: #1e293b;
      --text-secondary: #64748b;
      --border: #e2e8f0;
      --bg-page: #f8fafc;
      --bg-card: #ffffff;
      --error: #dc2626;
      --success: #059669;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      font-family: var(--font-family);
      background: var(--bg-page);
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      padding: 0;
      margin: 0;
    }

    .page-wrapper {
      flex: 1;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 12px 20px;
      width: 100%;
    }

    .login-container {
      width: 100%;
      max-width: 420px;
      margin-top: 0;
    }

    .login-card {
      background: var(--bg-card);
      border-radius: 14px;
      box-shadow: 0 4px 24px rgba(0, 0, 0, 0.08), 0 1px 3px rgba(0, 0, 0, 0.04);
      padding: 22px 26px;
      border: 1px solid var(--border);
    }

    .login-header {
      text-align: center;
      margin-bottom: 20px;
    }

    .login-header h1 {
      font-size: 1.5rem;
      font-weight: 700;
      color: var(--text-primary);
      margin-bottom: 6px;
    }

    .login-header p {
      color: var(--text-secondary);
      font-size: 0.85rem;
    }

    .form-group {
      width: 100%;
      margin-bottom: 16px;
    }

    #loginForm input[type="email"].form-input {
      width: 100%;
      max-width: 100%;
    }

    .form-label {
      display: block;
      font-weight: 600;
      color: var(--text-primary);
      margin-bottom: 8px;
      font-size: 0.9rem;
    }

    .form-input {
      display: block;
      width: 100%;
      min-width: 0;
      max-width: 100%;
      box-sizing: border-box;
      padding: 5px 16px;
      height: 36px;
      line-height: 1.2;
      -webkit-appearance: none;
      appearance: none;
      border: 2px solid var(--border);
      border-radius: 10px;
      font-size: 1rem;
      font-family: inherit;
      transition: all 0.2s ease;
      background: var(--bg-card);
      color: var(--text-primary);
    }

    .form-input:focus {
      outline: none;
      border-color: var(--primary);
      box-shadow: 0 0 0 3px var(--primary-light);
    }

    .form-input::placeholder {
      color: var(--text-secondary);
      opacity: 0.7;
    }

    .password-input-wrapper {
      position: relative;
      width: 100%;
    }

    .password-input-wrapper .form-input {
      width: 100%;
      padding-right: 38px;
    }

    .password-input-wrapper .form-input:focus {
      box-shadow: none;
    }

    .password-toggle-btn {
      position: absolute;
      right: 12px;
      top: 50%;
      transform: translateY(-50%);
      background: transparent;
      border: none;
      color: var(--text-secondary);
      cursor: pointer;
      padding: 4px;
      transition: color 0.2s ease;
      font-size: 0.95rem;
      display: flex;
      align-items: center;
      justify-content: center;
      z-index: 1;
      pointer-events: auto;
      width: 24px;
      height: 24px;
      flex-shrink: 0;
    }

    .password-toggle-btn:hover {
      color: var(--primary);
      transform: translateY(-50%);
    }

    .password-toggle-btn:active {
      transform: translateY(-50%);
    }

    .password-toggle-btn:focus {
      outline: none;
      transform: translateY(-50%);
    }

    .password-toggle-btn i {
      font-size: 0.9rem;
      transition: none;
    }

    .btn-primary {
      width: 100%;
      padding: 11px 18px;
      background: linear-gradient(135deg, var(--primary) 0%, #0a6d77 100%);
      color: white;
      border: none;
      border-radius: 10px;
      font-size: 0.9rem;
      font-weight: 600;
      cursor: pointer;
      transition: all 0.2s ease;
      box-shadow: 0 2px 8px rgba(1, 83, 91, 0.25);
      margin-top: 8px;
    }

    .btn-primary:hover {
      transform: translateY(-2px);
      box-shadow: 0 6px 20px rgba(1, 83, 91, 0.35);
    }

    .btn-primary:active {
      transform: translateY(0);
    }

    .login-links {
      text-align: center;
      margin-top: 16px;
      padding-top: 16px;
      border-top: 1px solid var(--border);
    }

    .login-links p {
      font-size: 0.9rem;
      color: var(--text-secondary);
      margin-bottom: 8px;
    }

    .login-links a {
      color: var(--primary);
      text-decoration: none;
      font-weight: 600;
      transition: color 0.2s ease;
    }

    .login-links a:hover {
      color: var(--primary-hover);
      text-decoration: underline;
    }

    .divider {
      display: flex;
      align-items: center;
      margin: 16px 0;
      color: var(--text-secondary);
      font-size: 0.8rem;
    }

    .divider::before,
    .divider::after {
      content: '';
      flex: 1;
      height: 1px;
      background: var(--border);
    }

    .divider span {
      padding: 0 16px;
    }

    .guardian-login-section {
      text-align: center;
      margin-bottom: 16px;
    }

    .guardian-login-section p {
      font-weight: 600;
      color: var(--text-primary);
      margin-bottom: 12px;
      font-size: 0.9rem;
    }

    .button-row {
      display: flex;
      gap: 12px;
      justify-content: center;
      flex-wrap: wrap;
    }

    .button-row.portal-buttons {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 12px;
      align-items: stretch;
    }

    .btn-guardian {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      padding: 12px 20px;
      background: linear-gradient(135deg, #0f5a66 0%, #6fd3c4 100%);
      color: white;
      text-decoration: none;
      border-radius: 10px;
      font-weight: 600;
      font-size: 0.85rem;
      transition: all 0.2s ease;
      box-shadow: 0 2px 8px rgba(15, 90, 102, 0.2);
      flex: 1;
      min-width: 0;
    }

    .btn-guardian:hover {
      transform: translateY(-2px);
      box-shadow: 0 6px 16px rgba(15, 90, 102, 0.3);
    }

    .btn-guardian.student-login-btn {
      grid-column: 1 / -1;
      justify-self: center;
      width: min(260px, calc(100% - 24px));
      flex: 0 0 auto;
    }

    @media (max-width: 768px) {
      .page-wrapper {
        padding: 30px 16px 10px;
      }
      .login-container {
        margin-top: 0;
        padding-top: 0;
        padding: 0;
      }
      .login-card {
        padding: 22px 22px;
      }
      .login-header h1 {
        font-size: 1.5rem;
      }
      .login-header p {
        font-size: 0.88rem;
      }
    }

    @media (max-width: 480px) {
      .page-wrapper {
        padding: 22px 12px 8px;
      }
      .login-container {
        margin-top: 0;
        padding-top: 0;
      }
      .login-card {
        padding: 20px 18px;
        border-radius: 12px;
      }
      .login-header h1 {
        font-size: 1.1rem;
      }
      .login-header p {
        font-size: 0.8rem;
      }
      .form-label {
        font-size: 0.8rem;
      }
      .form-input {
        padding: 3px 10px;
        font-size: 14px;
        height: 32px;
      }
      .btn-primary {
        padding: 7px 14px;
        font-size: 0.78rem;
      }
      .button-row.portal-buttons {
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 8px;
      }
      .btn-guardian {
        width: auto;
        padding: 8px 10px;
        font-size: 0.74rem;
        gap: 6px;
        border-radius: 8px;
      }
      .btn-guardian svg {
        width: 14px;
        height: 14px;
      }
      .btn-guardian.student-login-btn {
        width: min(210px, 100%);
      }
      .login-links p {
        font-size: 0.85rem;
      }
      .divider {
        font-size: 0.8rem;
      }
    }
  </style>
</head>
<body>
  <div class="page-wrapper<%= (typeof loginAds !== 'undefined' && loginAds && loginAds.length) ? ' auth-split' : '' %>">
    <div class="login-container">
      <div class="login-card">
        <div class="login-header">
          <h1>Sign in</h1>
        </div>

      <%- include('../partials/flash') %>

      <form id="loginForm" action="/account/login" method="post">
        <div class="form-group">
          <label class="form-label" for="email">Email Address</label>
          <input 
            type="email" 
            id="email" 
            name="email" 
            class="form-input" 
            placeholder="you@example.com" 
            required 
            autocomplete="email"
          />
        </div>

        <div class="form-group">
          <label class="form-label" for="password">Password</label>
          <div class="password-input-wrapper">
            <input 
              type="password" 
              id="password" 
              name="password" 
              class="form-input" 
              placeholder="Enter your password" 
              required 
              autocomplete="current-password"
            />
            <button type="button" class="password-toggle-btn" onclick="togglePasswordVisibility('password', this)" onmousedown="event.preventDefault()" aria-label="Show password">
              <i class="fa-solid fa-eye fa-fw" aria-hidden="true"></i>
            </button>
          </div>
        </div>

        <button type="submit" class="btn-primary">Sign In</button>
      </form>

      <div class="login-links">
        <p>New to Managira? <a href="/account/service-plan">Create an account</a></p>
        <p><a href="/account/forget-password">Forgot password?</a></p>
      </div>

      <div class="divider"><span>or</span></div>

      <div class="guardian-login-section">
        <p>Other portals</p>
        <div class="button-row portal-buttons">
          <a href="/account/guardian-login" class="btn-guardian">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
              <circle cx="9" cy="7" r="4"></circle>
              <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
              <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
            </svg>
            Parent Login
          </a>
          <a href="/hub/login" class="btn-guardian" style="background: linear-gradient(135deg, #01535b 0%, #6fd3c4 100%);">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <rect x="3" y="3" width="7" height="7"></rect>
              <rect x="14" y="3" width="7" height="7"></rect>
              <rect x="14" y="14" width="7" height="7"></rect>
              <rect x="3" y="14" width="7" height="7"></rect>
            </svg>
            Hub Login
          </a>
          <a href="/account/student-login" class="btn-guardian student-login-btn" style="background: linear-gradient(135deg, #0d9488 0%, #2dd4bf 100%);">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M12 14l9-5-9-5-9 5 9 5z"></path>
              <path d="M12 14l6.16-3.422A12.083 12.083 0 0118 14.576c0 2.205-2.686 3.99-6 3.99s-6-1.785-6-3.99c0-1.313.584-2.478 1.84-3.418L12 14z"></path>
            </svg>
            Student Login
          </a>
        </div>
      </div>
      </div>
    </div>
    <%- include('../partials/loginAdsPanel') %>
  </div>

  <script>
    const REGISTER_DRAFT_KEY = 'managira:register:draft:v1';

    function clearCompletedRegistrationDraft() {
      const params = new URLSearchParams(window.location.search);
      if (params.get('clearRegisterDraft') !== '1') return;

      try {
        localStorage.removeItem(REGISTER_DRAFT_KEY);
      } catch (_) {
      }

      params.delete('clearRegisterDraft');
      const query = params.toString();
      const nextUrl = query
        ? `${window.location.pathname}?${query}${window.location.hash || ''}`
        : `${window.location.pathname}${window.location.hash || ''}`;

      window.history.replaceState({}, document.title, nextUrl);
    }

    function togglePasswordVisibility(inputId, button) {
      const input = document.getElementById(inputId);
      const icon = button.querySelector('i');
      const isPassword = input.type === 'password';

      input.type = isPassword ? 'text' : 'password';
      icon.classList.remove('fa-eye', 'fa-eye-slash');
      icon.classList.add(isPassword ? 'fa-eye-slash' : 'fa-eye');
      button.setAttribute('aria-label', isPassword ? 'Hide password' : 'Show password');
    }

    clearCompletedRegistrationDraft();
  </script>
</body>
</html>
