<style>
    :root {
      --font-family: "Inter", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
      --primary: #01535b;
      --primary-hover: #014a51;
      --primary-light: rgba(1, 83, 91, 0.08);
      --text-primary: #1e293b;
      --text-secondary: #64748b;
      --border: #e2e8f0;
      --bg-page: #f8fafc;
      --bg-card: #ffffff;
      --error: #dc2626;
      --success: #059669;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    .auth-page {
      font-family: var(--font-family);
      background: var(--bg-page);
      padding: 32px 0 60px;
    }

    .page-wrapper {
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 18px 20px;
      width: 100%;
    }

    .login-container {
      width: 100%;
      max-width: 420px;
      margin-top: 0;
    }

    .login-card {
      background: var(--bg-card);
      border-radius: 16px;
      box-shadow: 0 4px 24px rgba(0, 0, 0, 0.08), 0 1px 3px rgba(0, 0, 0, 0.04);
      padding: 28px 24px;
      border: 1px solid var(--border);
    }

    .login-header {
      text-align: center;
      margin-bottom: 28px;
    }

    .login-header h1 {
      font-size: 1.55rem;
      font-weight: 700;
      color: var(--text-primary);
      margin-bottom: 8px;
    }

    .login-header p {
      color: var(--text-secondary);
      font-size: 0.9rem;
    }

    .form-group {
      margin-bottom: 16px;
    }

    .form-label {
      display: block;
      font-weight: 600;
      color: var(--text-primary);
      margin-bottom: 8px;
      font-size: 0.84rem;
    }

    .form-input {
      width: 100%;
      padding: 13px 15px;
      border: 2px solid var(--border);
      border-radius: 10px;
      font-size: 0.95rem;
      font-family: inherit;
      transition: all 0.2s ease;
      background: var(--bg-card);
      color: var(--text-primary);
    }

    .form-input:focus {
      outline: none;
      border-color: var(--primary);
      box-shadow: 0 0 0 3px var(--primary-light);
    }

    .form-input::placeholder {
      color: var(--text-secondary);
      opacity: 0.7;
    }

    .password-input-wrapper {
      position: relative;
      display: flex;
      align-items: center;
    }

    .password-input-wrapper .form-input {
      padding-right: 46px;
    }

    .password-toggle-btn {
      position: absolute;
      right: 10px;
      top: 50%;
      transform: translateY(-50%);
      background: #ffffff;
      border: 1px solid #d8e1ea;
      color: var(--text-secondary);
      cursor: pointer;
      padding: 0;
      transition: color 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease, background-color 0.2s ease;
      font-size: 0.95rem;
      display: flex;
      align-items: center;
      justify-content: center;
      z-index: 1;
      pointer-events: auto;
      width: 26px;
      height: 26px;
      border-radius: 999px;
      flex-shrink: 0;
      box-shadow: none;
    }

    .password-toggle-btn:hover {
      color: var(--primary);
      border-color: #bfd0db;
      background: #f8fbfc;
      transform: translateY(-50%);
    }

    .password-toggle-btn:active {
      transform: translateY(-50%);
    }

    .password-toggle-btn:focus {
      outline: none;
      transform: translateY(-50%);
      box-shadow: 0 0 0 3px rgba(1, 83, 91, 0.12);
    }

    .password-toggle-btn i {
      font-size: 0.8rem;
      transition: none;
    }

    .btn-primary {
      width: 100%;
      padding: 13px 22px;
      background: linear-gradient(135deg, var(--primary) 0%, #0a6d77 100%);
      color: white;
      border: none;
      border-radius: 10px;
      font-size: 0.95rem;
      font-weight: 600;
      cursor: pointer;
      transition: all 0.2s ease;
      box-shadow: 0 2px 8px rgba(1, 83, 91, 0.25);
      margin-top: 8px;
    }

    .btn-primary:hover {
      transform: translateY(-2px);
      box-shadow: 0 6px 20px rgba(1, 83, 91, 0.35);
    }

    .btn-primary:active {
      transform: translateY(0);
    }

    .login-links {
      text-align: center;
      margin-top: 20px;
      padding-top: 20px;
      border-top: 1px solid var(--border);
    }

    .login-links p {
      font-size: 0.85rem;
      color: var(--text-secondary);
      margin-bottom: 8px;
    }

    .login-links a {
      color: var(--primary);
      text-decoration: none;
      font-weight: 600;
      transition: color 0.2s ease;
    }

    .login-links a:hover {
      color: var(--primary-hover);
      text-decoration: underline;
    }

    .divider {
      display: flex;
      align-items: center;
      margin: 20px 0;
      color: var(--text-secondary);
      font-size: 0.8rem;
    }

    .divider::before,
    .divider::after {
      content: '';
      flex: 1;
      height: 1px;
      background: var(--border);
    }

    .divider span {
      padding: 0 16px;
    }

    .guardian-login-section {
      text-align: center;
      margin-bottom: 16px;
    }

    .guardian-login-section p {
      font-weight: 600;
      color: var(--text-primary);
      margin-bottom: 12px;
      font-size: 0.84rem;
    }

    .button-row {
      display: flex;
      gap: 12px;
      justify-content: center;
      flex-wrap: wrap;
    }

    .btn-guardian {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      padding: 11px 18px;
      background: linear-gradient(135deg, #0f5a66 0%, #6fd3c4 100%);
      color: white;
      text-decoration: none;
      border-radius: 10px;
      font-weight: 600;
      font-size: 0.8rem;
      transition: all 0.2s ease;
      box-shadow: 0 2px 8px rgba(15, 90, 102, 0.2);
      flex: 1;
      min-width: 0;
    }

    .btn-guardian:hover {
      transform: translateY(-2px);
      box-shadow: 0 6px 16px rgba(15, 90, 102, 0.3);
    }

    @media (max-width: 768px) {
      .auth-page {
        padding: 24px 0 52px;
      }
      .page-wrapper {
        padding: 40px 16px 12px;
      }
      .login-container {
        margin-top: 0;
        padding-top: 0;
        padding: 0;
      }
      .login-card {
        padding: 24px 20px;
      }
      .login-header h1 {
        font-size: 1.38rem;
      }
      .login-header p {
        font-size: 0.84rem;
      }
    }

    @media (max-width: 480px) {
      .auth-page {
        padding: 18px 0 44px;
      }
      .page-wrapper {
        padding: 28px 12px 8px;
      }
      .login-container {
        margin-top: 0;
        padding-top: 0;
      }
      .login-card {
        padding: 22px 16px;
        border-radius: 12px;
      }
      .login-header h1 {
        font-size: 1.24rem;
      }
      .login-header p {
        font-size: 0.8rem;
      }
      .form-label {
        font-size: 0.8rem;
      }
      .form-input {
        padding: 12px 14px;
        font-size: 16px; /* prevents iOS zoom */
      }
      .btn-primary {
        padding: 12px 18px;
        font-size: 0.9rem;
      }
      .button-row {
        flex-direction: column;
      }
      .btn-guardian {
        width: 100%;
      }
      .login-links p {
        font-size: 0.8rem;
      }
      .divider {
        font-size: 0.8rem;
      }
    }
  </style>
<div class="auth-page">
  <div class="page-wrapper">
    <div class="login-container">
      <div class="login-card">
        <div class="login-header">
          <h1>Welcome Back</h1>
          <p>Sign in to your organization account</p>
        </div>

      <%- include('../partials/flash') %>

      <form id="loginForm" action="/account/login" method="post">
        <div class="form-group">
          <label class="form-label" for="email">Email Address</label>
          <input 
            type="email" 
            id="email" 
            name="email" 
            class="form-input" 
            placeholder="you@example.com" 
            required 
            autocomplete="email"
          />
        </div>

        <div class="form-group">
          <label class="form-label" for="password">Password</label>
          <div class="password-input-wrapper">
            <input 
              type="password" 
              id="password" 
              name="password" 
              class="form-input" 
              placeholder="Enter your password" 
              required 
              autocomplete="current-password"
            />
            <button type="button" class="password-toggle-btn" onclick="togglePasswordVisibility('password', this)" aria-label="Show password">
              <i class="fa-solid fa-eye fa-fw" aria-hidden="true"></i>
            </button>
          </div>
        </div>

        <button type="submit" class="btn-primary">Sign In</button>
      </form>

      <div class="login-links">
        <p>Don't have an account? <a href="/account/service-plan">Register Now (Single School)</a></p>
        <p><a href="/account/forget-password">Forgot Password?</a></p>
      </div>

      <div class="divider"><span>or</span></div>

      <div class="guardian-login-section">
        <p>Quick Access</p>
        <div class="button-row">
          <a href="/account/guardian-login" class="btn-guardian">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
              <circle cx="9" cy="7" r="4"></circle>
              <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
              <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
            </svg>
            Parent Login
          </a>
          <a href="/hub/login" class="btn-guardian" style="background: linear-gradient(135deg, #01535b 0%, #6fd3c4 100%);">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <rect x="3" y="3" width="7" height="7"></rect>
              <rect x="14" y="3" width="7" height="7"></rect>
              <rect x="14" y="14" width="7" height="7"></rect>
              <rect x="3" y="14" width="7" height="7"></rect>
            </svg>
            Hub Login
          </a>
        </div>
      </div>
      </div>
    </div>
  </div>
  </div>

  <script>
    const REGISTER_DRAFT_KEY = 'managira:register:draft:v1';

    function clearCompletedRegistrationDraft() {
      const params = new URLSearchParams(window.location.search);
      if (params.get('clearRegisterDraft') !== '1') return;

      try {
        localStorage.removeItem(REGISTER_DRAFT_KEY);
      } catch (_) {
      }

      params.delete('clearRegisterDraft');
      const query = params.toString();
      const nextUrl = query
        ? `${window.location.pathname}?${query}${window.location.hash || ''}`
        : `${window.location.pathname}${window.location.hash || ''}`;

      window.history.replaceState({}, document.title, nextUrl);
    }

    function togglePasswordVisibility(inputId, button) {
      const input = document.getElementById(inputId);
      const icon = button.querySelector('i');
      const isVisible = input.type === 'text';
      
      input.type = isVisible ? 'password' : 'text';
      icon.classList.remove('fa-eye', 'fa-eye-slash');
      icon.classList.add(isVisible ? 'fa-eye' : 'fa-eye-slash');
      button.setAttribute('aria-label', isVisible ? 'Show password' : 'Hide password');
    }

    clearCompletedRegistrationDraft();
  </script>
