<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1">
  <title><%= locals.schoolName ? `Log in to ${schoolName}` : 'Log in - Managira' %></title>
  <meta name="description" content="Log in to Managira: staff, parents, students and hubs all sign in here." />
  <link rel="icon" href="/favicon.ico" type="image/x-icon" sizes="any" />
  <link rel="apple-touch-icon" sizes="180x180" href="/images/favicon_io/apple-touch-icon.png" />
  <link rel="preload" as="image" href="/images/managira-logo-sm.png" />
  <style>
    /* One page with nothing else to load: the login is the first thing everyone waits for. */
    :root {
      --brand: #01535b;
      --brand-dark: #013f45;
      --text: #111827;
      --muted: #4b5563;
      --soft: #6b7280;
      --line: #d1d5db;
      --card: #ffffff;
      --focus: rgba(1, 83, 91, 0.22);
      --error-bg: #fef2f2;
      --error-text: #b42318;
      --ok-bg: #ecfdf3;
      --ok-text: #067647;
    }
    * { box-sizing: border-box; }
    html, body { margin: 0; min-height: 100%; }
    body {
      min-height: 100vh;
      min-height: 100dvh;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 24px 16px;
      background: linear-gradient(180deg, #eaf0f6 0%, #f3f1ec 100%);
      color: var(--text);
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
      -webkit-font-smoothing: antialiased;
    }
    .page-wrapper { display: flex; justify-content: center; width: 100%; }
    .login-card {
      width: 100%;
      max-width: 460px;
      padding: 44px 40px 28px;
      border: 1px solid #e5e7eb;
      border-radius: 24px;
      background: var(--card);
      box-shadow: 0 1px 2px rgba(16, 24, 40, 0.04), 0 12px 32px rgba(16, 24, 40, 0.07);
    }
    .login-school { display: block; width: 56px; height: 56px; margin: 0 auto 14px; border-radius: 12px; object-fit: contain; }
    h1 { margin: 0 0 30px; font-size: 1.75rem; font-weight: 700; letter-spacing: -0.02em; line-height: 1.2; text-align: center; }
    .field { margin-bottom: 18px; }
    .field-top { display: flex; align-items: baseline; justify-content: space-between; gap: 12px; margin-bottom: 7px; }
    label { font-size: 0.875rem; font-weight: 600; color: var(--muted); }
    .field-top a { font-size: 0.875rem; font-weight: 500; color: var(--brand); text-decoration: none; }
    .field-top a:hover { text-decoration: underline; }
    input[type="email"], input[type="password"], input[type="text"] {
      display: block;
      width: 100%;
      height: 50px;
      padding: 0 16px;
      border: 1px solid var(--line);
      border-radius: 10px;
      background: #fff;
      color: var(--text);
      font: inherit;
      font-size: 1rem;
      transition: border-color 0.15s ease, box-shadow 0.15s ease;
    }
    input::placeholder { color: #9ca3af; }
    input:focus { outline: none; border-color: var(--brand); box-shadow: 0 0 0 4px var(--focus); }
    .password-box { position: relative; }
    .password-box input { padding-right: 52px; }
    .show-password {
      position: absolute; top: 50%; right: 6px; transform: translateY(-50%);
      display: grid; place-items: center; width: 40px; height: 40px;
      border: 0; border-radius: 8px; background: none; color: var(--soft); cursor: pointer;
    }
    .show-password:hover { color: var(--text); background: #f3f4f6; }
    .show-password svg { width: 20px; height: 20px; }
    .show-password .when-shown { display: none; }
    .show-password[aria-pressed="true"] .when-shown { display: block; }
    .show-password[aria-pressed="true"] .when-hidden { display: none; }
    .btn-primary {
      display: block; width: 100%; height: 52px; margin-top: 26px;
      border: 0; border-radius: 10px; background: var(--brand); color: #fff;
      font: inherit; font-size: 1.05rem; font-weight: 700; cursor: pointer;
      transition: background 0.15s ease, transform 0.05s ease;
    }
    .btn-primary:hover { background: var(--brand-dark); }
    .btn-primary:active { transform: translateY(1px); }
    .btn-primary:focus-visible, .keep input:focus-visible + span, .help-dot:focus-visible { outline: 3px solid var(--focus); outline-offset: 2px; }
    .keep { position: relative; display: flex; align-items: center; gap: 8px; margin-top: 18px; }
    .keep label { display: inline-flex; align-items: center; gap: 8px; font-size: 0.875rem; font-weight: 400; color: var(--muted); cursor: pointer; }
    .keep input { width: 16px; height: 16px; margin: 0; accent-color: var(--brand); cursor: pointer; }
    .help-dot {
      display: inline-grid; place-items: center; width: 17px; height: 17px; padding: 0;
      border: 0; border-radius: 50%; background: #9ca3af; color: #fff;
      font: 700 0.7rem/1 inherit; cursor: help;
    }
    .help-tip {
      position: absolute; left: 0; right: 0; top: calc(100% + 8px); z-index: 5;
      display: none; gap: 10px; padding: 12px 14px;
      border-radius: 12px; background: #1f2937; color: #fff;
      font-size: 0.85rem; line-height: 1.45; box-shadow: 0 12px 30px rgba(0, 0, 0, 0.18);
    }
    .help-tip svg { flex: none; width: 16px; height: 16px; margin-top: 2px; }
    @media (hover: hover) { .keep:has(.help-dot:hover) .help-tip { display: flex; } }
    .keep:has(.help-dot:focus-visible) .help-tip, .help-tip.is-open { display: flex; }
    .keep.is-dismissed .help-tip { display: none !important; }
    .field-top button { padding: 0; border: 0; background: none; color: var(--brand); font: inherit; font-size: 0.875rem; font-weight: 500; cursor: pointer; }
    .field-top button:hover { text-decoration: underline; }
    input[readonly] { background: #f9fafb; color: var(--muted); }
    .password-step[hidden], .sso-step[hidden], .or-line[hidden], .btn-primary[hidden], .keep[hidden] { display: none; }
    .password-step, .sso-step { animation: reveal 0.18s ease-out; }
    @keyframes reveal { from { opacity: 0; transform: translateY(-4px); } }
    /* The school's own sign-in: what it is, then its button. */
    .sso-says { display: flex; align-items: center; gap: 12px; padding: 12px 14px; border: 1px solid #cfe3e5; border-radius: 12px; background: #f2f8f8; }
    .sso-says svg { flex: none; width: 22px; height: 22px; color: var(--brand); }
    .sso-says p { margin: 0; color: var(--muted); font-size: 0.92rem; line-height: 1.4; }
    .sso-says strong { color: var(--text); font-weight: 650; }
    .sso-says small { display: block; color: var(--soft); font-size: 0.8rem; }
    .sso-step .btn-primary { margin-top: 14px; }
    .or-line { display: flex; align-items: center; gap: 12px; margin: 22px 0 16px; color: var(--soft); font-size: 0.85rem; }
    .or-line::before, .or-line::after { content: ""; flex: 1; height: 1px; background: #e5e7eb; }
    .btn-primary.is-quiet { margin-top: 18px; border: 1px solid var(--line); background: #fff; color: var(--brand); }
    .btn-primary.is-quiet:hover { background: #f3f7f7; }
    .btn-primary[disabled] { opacity: 0.75; cursor: wait; }
    .field-error { margin: 8px 0 0; font-size: 0.875rem; color: var(--error-text); }
    .field-error[hidden] { display: none; }
    .lead { margin: -14px 0 24px; color: var(--muted); font-size: 0.95rem; line-height: 1.5; text-align: center; }
    .lead strong { color: var(--text); font-weight: 600; }
    .note-ok { margin: -10px 0 18px; padding: 10px 12px; border-radius: 10px; background: var(--ok-bg); color: var(--ok-text); font-size: 0.9rem; text-align: center; }
    .code-input { text-align: center; font: 700 1.5rem/1 "SFMono-Regular", Menlo, Consolas, monospace !important; letter-spacing: 0.4em; text-transform: uppercase; }
    .code-input::placeholder { letter-spacing: 0.4em; color: #cbd5e1; }
    .field-help { margin: 8px 0 0; font-size: 0.85rem; color: var(--soft); }
    #codeForm .btn-primary { margin-top: 18px; }
    .code-actions { display: flex; justify-content: space-between; align-items: center; gap: 12px; margin-top: 18px; font-size: 0.9rem; }
    .code-actions form { margin: 0; }
    .code-actions a, .link-button { padding: 0; border: 0; background: none; color: var(--brand); font: inherit; font-weight: 500; text-decoration: none; cursor: pointer; }
    .code-actions a:hover, .link-button:hover { text-decoration: underline; }
    .after { margin-top: 26px; display: flex; flex-direction: column; align-items: center; gap: 10px; font-size: 0.925rem; color: var(--muted); text-align: center; }
    .after a { color: var(--brand); font-weight: 500; text-decoration: none; }
    .after a:hover { text-decoration: underline; }
    .brand { display: flex; align-items: center; justify-content: center; gap: 8px; width: fit-content; margin: 30px auto 0; color: #6b7280; font-size: 0.95rem; font-weight: 700; letter-spacing: 0.06em; text-decoration: none; text-transform: uppercase; }
    .brand img { width: 26px; height: 26px; }
    .brand:hover { color: #374151; }
    .flash-wrapper { margin: -14px 0 20px; }
    .flash-message { display: flex; justify-content: space-between; gap: 12px; padding: 12px 14px; border-radius: 10px; font-size: 0.925rem; line-height: 1.4; }
    .flash-message + .flash-message { margin-top: 8px; }
    .flash-message.error { background: var(--error-bg); color: var(--error-text); }
    .flash-message.success, .flash-message.info { background: var(--ok-bg); color: var(--ok-text); }
    .flash-close { cursor: pointer; opacity: 0.6; }
    .auth-split .login-card { justify-self: center; }
    @media (max-width: 520px) {
      body { align-items: flex-start; padding-top: 24px; }
      .login-card { padding: 32px 22px 22px; border-radius: 20px; }
      h1 { font-size: 1.5rem; margin-bottom: 24px; }
    }
  </style>
</head>
<body>
  <div class="page-wrapper<%= (typeof loginAds !== 'undefined' && loginAds && loginAds.length) ? ' auth-split' : '' %>">
    <main class="login-card">
      <% if (locals.schoolLogo) { %><img class="login-school" src="<%= schoolLogo %>" alt="" /><% } %>
      <% const _codeStep = locals.step === 'code'; %>
      <h1><%= _codeStep ? 'Check your email' : (locals.schoolName ? `Log in to ${schoolName}` : 'Log in to your account') %></h1>

      <%- include('../partials/flash') %>

      <% if (_codeStep) { %>
      <p class="lead">We sent a 6-character code to <strong><%= locals.codeTo %></strong>. Enter it below to finish logging in. It expires in 10 minutes.</p>
      <% if (locals.codeNote) { %><p class="note-ok" role="status"><%= codeNote %></p><% } %>
      <form id="codeForm" action="/account/login/verify-code" method="post" novalidate data-loader-text="Signing you in">
        <div class="field">
          <div class="field-top"><label for="code">Verification code</label></div>
          <input type="text" id="code" name="code" class="code-input" inputmode="text" autocomplete="one-time-code" autocapitalize="characters" spellcheck="false" maxlength="8" placeholder="ABC123" required autofocus aria-describedby="codeHelp" />
          <% if (locals.codeError) { %><p class="field-error" role="alert"><%= codeError %></p><% } %>
          <p class="field-help" id="codeHelp">Can't find it? Check your spam or junk folder.</p>
        </div>
        <button type="submit" class="btn-primary" data-submit>Verify</button>
      </form>
      <div class="code-actions">
        <form action="/account/login/resend-code" method="post" data-loader-text="Sending a new code"><button type="submit" class="link-button">Send a new code</button></form>
        <a href="/account/login">Use a different account</a>
      </div>
      <% } else { %>
      <%
        const _step = ['password', 'sso'].includes(locals.step) ? step : 'email';
        const _sso = _step === 'sso' && locals.sso ? sso : null;
        const _password = _step === 'password' || Boolean(_sso && locals.passwordToo);
      %>
      <form id="loginForm" action="<%= _step === 'email' ? '/account/login/continue' : '/account/login' %>" method="post" novalidate data-step="<%= _step %>">
        <% if (locals.next) { %><input type="hidden" name="next" value="<%= next %>" /><% } %>
        <div class="field">
          <div class="field-top"><label for="email">Email address</label><button type="button" data-change-email<%= _step === 'email' ? ' hidden' : '' %>>Change</button></div>
          <input type="email" id="email" name="email" value="<%= locals.email || '' %>" placeholder="Enter email" required autocomplete="username" autocapitalize="none" spellcheck="false"<%= _step === 'email' ? ' autofocus' : ' readonly' %> />
          <p class="field-error" data-email-error hidden></p>
        </div>
        <div class="field sso-step" data-sso-step<%= _sso ? '' : ' hidden' %>>
          <div class="sso-says">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="m9 12 2 2 4-4"/></svg>
            <p>Your school signs in with <strong data-sso-name><%= _sso ? _sso.name : '' %></strong><small data-sso-kind>Single sign-on<%= _sso && _sso.protocol ? ` · ${_sso.protocol}` : '' %></small></p>
          </div>
          <button type="submit" form="ssoForm" class="btn-primary" data-sso-go<%= _sso ? ' autofocus' : '' %>>Continue with <span data-sso-name><%= _sso ? _sso.name : '' %></span></button>
          <div class="or-line" data-or<%= _sso && _password ? '' : ' hidden' %>>or use your password</div>
        </div>
        <div class="field password-step" id="passwordStep"<%= _password ? '' : ' hidden' %>>
          <div class="field-top"><label for="password">Password</label><a href="/account/forget-password">Forgot password?</a></div>
          <div class="password-box">
            <input type="password" id="password" name="password" placeholder="Enter password" autocomplete="current-password"<%= _password ? ' required' : '' %><%= _step === 'password' ? ' autofocus' : '' %> />
            <button type="button" class="show-password" aria-label="Show password" aria-pressed="false" data-show-password>
              <svg class="when-hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12z"/><circle cx="12" cy="12" r="3"/></svg>
              <svg class="when-shown" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M17.94 17.94A10.07 10.07 0 0 1 12 19c-6.5 0-10-7-10-7a18.5 18.5 0 0 1 5.06-5.94"/><path d="M9.9 4.24A9.1 9.1 0 0 1 12 4c6.5 0 10 7 10 7a18.6 18.6 0 0 1-2.16 3.19"/><path d="M14.12 14.12a3 3 0 1 1-4.24-4.24"/><path d="m2 2 20 20"/></svg>
            </button>
          </div>
        </div>

        <button type="submit" class="btn-primary<%= _sso ? ' is-quiet' : '' %>" data-submit<%= _sso && !_password ? ' hidden' : '' %>><%= _step === 'email' ? 'Continue' : 'Log in' %></button>

        <div class="keep"<%= _sso && !_password ? ' hidden' : '' %>>
          <label><input type="checkbox" name="remember" value="on" id="remember" /><span>Keep me logged in</span></label>
          <button type="button" class="help-dot" aria-label="About keeping you logged in" aria-describedby="keepHelp" aria-expanded="false" data-help>?</button>
          <div class="help-tip" id="keepHelp" role="tooltip">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M9.1 9a3 3 0 0 1 5.8 1c0 2-3 3-3 3"/><path d="M12 17h.01"/></svg>
            <span>You'll stay signed in even if you close all browser windows, for as long as your school allows (30 days unless it chose otherwise), unless you log out or clear your browser's cookies. Don't use it on a public or shared computer.</span>
          </div>
        </div>
      </form>
      <%# The school's sign-in is its own form, so its button works without scripts too. %>
      <form id="ssoForm" method="post" action="<%= _sso ? _sso.start : '/account/login' %>" data-loader-text="Taking you to your school's sign-in">
        <input type="hidden" name="email" value="<%= locals.email || '' %>" data-sso-email />
        <% if (locals.next) { %><input type="hidden" name="next" value="<%= next %>" /><% } %>
      </form>
      <% } %>

      <div class="after">
        <span>New to Managira? <a href="/account/service-plan">Create an account</a></span>
        <a href="/legal/help">Need help?</a>
      </div>
      <a class="brand" href="/"><img src="/images/managira-logo-sm.png" alt="" /><span>Managira</span></a>
    </main>
    <%- include('../partials/loginAdsPanel') %>
  </div>

  <script>
    (function () {
      // A finished sign-up leaves its saved form behind: clear it.
      var params = new URLSearchParams(location.search);
      if (params.get('clearRegisterDraft') === '1') {
        try { localStorage.removeItem('managira:register:draft:v1'); } catch (_) {}
        params.delete('clearRegisterDraft');
        var rest = params.toString();
        history.replaceState({}, document.title, location.pathname + (rest ? '?' + rest : '') + location.hash);
      }
      var codeInput = document.getElementById('code');
      if (codeInput) {
        // A code pasted with a space or a dash still works; the box shows it as one word.
        codeInput.addEventListener('input', function () { var v = codeInput.value.toUpperCase().replace(/[^A-Z0-9]/g, '').slice(0, 6); if (v !== codeInput.value) codeInput.value = v; });
        document.getElementById('codeForm').addEventListener('submit', function (event) { if (codeInput.value.length !== 6) { event.preventDefault(); codeInput.setCustomValidity('Enter the 6-character code.'); codeInput.reportValidity(); codeInput.setCustomValidity(''); } });
        document.querySelectorAll('.flash-close').forEach(function (x) { x.addEventListener('click', function () { x.parentElement.remove(); }); });
        return;
      }
      var toggle = document.querySelector('[data-show-password]');
      var password = document.getElementById('password');
      toggle.addEventListener('mousedown', function (event) { event.preventDefault(); });
      toggle.addEventListener('click', function () {
        var showing = password.type === 'password';
        password.type = showing ? 'text' : 'password';
        toggle.setAttribute('aria-pressed', String(showing));
        toggle.setAttribute('aria-label', showing ? 'Hide password' : 'Show password');
      });
      // The question mark explains the box. A tap opens it on a phone; a second tap or a tap
      // anywhere else closes it.
      var help = document.querySelector('[data-help]');
      var tip = document.getElementById('keepHelp');
      help.addEventListener('click', function (event) {
        event.stopPropagation();
        help.closest('.keep').classList.remove('is-dismissed');
        var open = !tip.classList.contains('is-open');
        tip.classList.toggle('is-open', open);
        help.setAttribute('aria-expanded', String(open));
      });
      document.addEventListener('click', function () { tip.classList.remove('is-open'); help.setAttribute('aria-expanded', 'false'); });
      // Escape closes it even while the pointer is still on the question mark.
      var keep = help.closest('.keep');
      document.addEventListener('keydown', function (event) {
        if (event.key !== 'Escape') return;
        tip.classList.remove('is-open');
        help.setAttribute('aria-expanded', 'false');
        keep.classList.add('is-dismissed');
      });
      help.addEventListener('mouseleave', function () { keep.classList.remove('is-dismissed'); });
      help.addEventListener('focus', function () { keep.classList.remove('is-dismissed'); });
      // One page, in steps. First the email; the server then says how this person signs in:
      // a password, their school's own sign-in (named, with its button), or either one when the
      // school allows both. Without scripts the same happens with full page loads.
      var form = document.getElementById('loginForm');
      var email = document.getElementById('email');
      var step = document.getElementById('passwordStep');
      var submit = form.querySelector('[data-submit]');
      var change = form.querySelector('[data-change-email]');
      var keepBox = form.querySelector('.keep');
      var ssoStep = form.querySelector('[data-sso-step]');
      var ssoGo = form.querySelector('[data-sso-go]');
      var orLine = form.querySelector('[data-or]');
      var ssoForm = document.getElementById('ssoForm');
      var emailError = form.querySelector('[data-email-error]');
      var KEY = 'managira:login-email';
      function remember() { try { sessionStorage.setItem(KEY, email.value.trim()); } catch (_) {} }
      // name: 'email', 'password' or 'sso'. sso: { name, protocol, start }; passwordToo: a password works as well.
      function show(name, sso, passwordToo) {
        var usesSso = name === 'sso' && sso;
        var usesPassword = name === 'password' || Boolean(usesSso && passwordToo);
        form.setAttribute('data-step', usesSso ? 'sso' : name);
        form.action = name === 'email' ? '/account/login/continue' : '/account/login';
        email.readOnly = name !== 'email';
        change.hidden = name === 'email';
        ssoStep.hidden = !usesSso;
        if (usesSso) {
          form.querySelectorAll('[data-sso-name]').forEach(function (el) { el.textContent = sso.name; });
          form.querySelector('[data-sso-kind]').textContent = 'Single sign-on' + (sso.protocol ? ' · ' + sso.protocol : '');
          ssoForm.action = sso.start;
          ssoForm.querySelector('[data-sso-email]').value = email.value.trim();
        }
        orLine.hidden = !(usesSso && usesPassword);
        step.hidden = !usesPassword;
        password.required = usesPassword;
        if (!usesPassword) password.value = '';
        submit.hidden = Boolean(usesSso && !usesPassword);
        submit.classList.toggle('is-quiet', Boolean(usesSso));
        submit.textContent = name === 'email' ? 'Continue' : 'Log in';
        keepBox.hidden = Boolean(usesSso && !usesPassword);
        if (name === 'email') { email.focus(); email.select(); }
        else if (usesSso) ssoGo.focus();
        else password.focus();
      }
      change.addEventListener('click', function () { show('email'); });
      ssoForm.addEventListener('submit', remember);
      function ask() {
        submit.disabled = true;
        var body = new URLSearchParams({ email: email.value.trim() });
        var nextField = form.querySelector('input[name="next"]');
        if (nextField) body.set('next', nextField.value);
        fetch('/account/login/continue', { method: 'POST', credentials: 'same-origin', headers: { 'Content-Type': 'application/x-www-form-urlencoded', Accept: 'application/json' }, body: body })
          .then(function (answer) { return answer.json(); })
          .then(function (data) {
            submit.disabled = false;
            if (data.step === 'sso' && data.sso) { show('sso', data.sso, data.password); return; }
            if (data.step === 'password') { show('password'); return; }
            emailError.textContent = data.message || 'Enter a valid email address.';
            emailError.hidden = false;
            email.focus();
          })
          .catch(function () { submit.disabled = false; form.submit(); });
      }
      form.addEventListener('submit', function (event) {
        emailError.hidden = true;
        var current = form.getAttribute('data-step');
        // Enter on the school's sign-in step goes to the school's sign-in, unless the person is typing a password.
        if (current === 'sso' && (step.hidden || (event.submitter !== submit && document.activeElement !== password))) {
          event.preventDefault();
          if (ssoForm.requestSubmit) ssoForm.requestSubmit(); else { remember(); ssoForm.submit(); }
          return;
        }
        if (current === 'password' || current === 'sso') {
          if (!password.value) { event.preventDefault(); password.reportValidity(); return; }
          remember();
          return; // a normal sign-in; the loading screen shows
        }
        event.preventDefault();
        if (!email.checkValidity() || !email.value.trim()) { email.reportValidity(); return; }
        ask();
      });
      // Back after a wrong password or a sign-in that didn't work: the same email, and the same
      // choice of how to sign in.
      var hasError = document.querySelector('.flash-message.error');
      var remembered = '';
      try { remembered = sessionStorage.getItem(KEY) || ''; } catch (_) {}
      if (form.getAttribute('data-step') === 'email' && hasError && remembered) {
        email.value = remembered;
        ask();
      }
      document.querySelectorAll('.flash-close').forEach(function (x) { x.addEventListener('click', function () { x.parentElement.remove(); }); });
    })();
  </script>
<%- include('../partials/authLoader') %>
</body>
</html>
