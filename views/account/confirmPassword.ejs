<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Confirm Password</title>
  </head>
  <body>
    <div style="max-width: 400px; margin: 40px auto; padding: 16px;">
      <h1>Confirm Password</h1>
      <%- include('../partials/flash') %>
      <form action="/account/confirm-password" method="POST">
        <div style="margin-bottom: 12px;">
          <label for="password">Enter Password:</label>
          <input type="password" id="password" name="password" required style="width: 100%; box-sizing: border-box; margin-top: 4px;" />
        </div>
        <input type="hidden" name="redirectUrl" value="<%= redirectUrl %>" />
        <button type="submit">Confirm</button>
      </form>
    </div>
  </body>
</html>
