<%- include('../partials/flash') %>

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Select a Service Plan</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <style>
      :root {
        --font-family: "<%= (session && session.fontStyle ? String(session.fontStyle).trim() : 'Inter') %>", sans-serif;
        --brand: var(--org-primary-color, #01535b);
        --brand-hover: var(--org-primary-hover, #01444a);
        --border-color: #dfe5ec;
        --text-main: #1f2937;
        --text-muted: #5f6b7a;
        --surface: #ffffff;
        --page-bg: #f4f7fb;
      }

      * {
        box-sizing: border-box;
      }

      body {
        font-family: var(--font-family);
        margin: 0;
        background: var(--page-bg);
        color: var(--text-main);
      }

      .pricing-shell {
        max-width: 1140px;
        margin: 0 auto;
        padding: 24px 16px 48px;
      }

      .pricing-header {
        background: var(--surface);
        border: 1px solid var(--border-color);
        border-radius: 14px;
        padding: 24px;
        text-align: center;
        margin-bottom: 18px;
      }

      .pricing-header h1 {
        margin: 0;
        font-size: 2rem;
        line-height: 1.2;
        color: var(--text-main);
      }

      .pricing-header p {
        margin: 10px 0 0;
        font-size: 15px;
        color: var(--text-muted);
      }

      .trial-banner {
        margin-bottom: 14px;
        padding: 12px 14px;
        border-radius: 10px;
        border: 1px solid #8fcab4;
        background: #e7faf1;
        color: #0f5132;
        font-size: 14px;
        line-height: 1.45;
      }

      .plan-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
        gap: 16px;
      }

      .plan-card {
        cursor: pointer;
        background: var(--surface);
        border: 1px solid var(--border-color);
        border-radius: 14px;
        overflow: hidden;
        position: relative;
        display: flex;
        flex-direction: column;
        min-height: 100%;
        transition: border-color 0.2s ease, box-shadow 0.2s ease;
      }

      .plan-card.selected {
        border-color: var(--brand);
        box-shadow: 0 0 0 3px rgba(1, 83, 91, 0.28), 0 10px 24px rgba(1, 83, 91, 0.12);
        background: #f2fbfa;
      }

      .plan-card.selected::after {
        content: "Selected";
        position: absolute;
        top: 10px;
        right: 10px;
        background: #ffffff;
        color: var(--brand);
        border: 1px solid rgba(1, 83, 91, 0.25);
        border-radius: 999px;
        padding: 4px 10px;
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 0.02em;
      }

      .plan-card.selected .plan-name {
        background: var(--brand-hover);
      }

      .plan-name {
        background: var(--brand);
        color: #fff;
        padding: 14px 16px;
        font-weight: 700;
        font-size: 16px;
        text-align: center;
      }

      .plan-content {
        padding: 16px;
        display: flex;
        flex-direction: column;
        gap: 14px;
        flex: 1;
      }

      .plan-description {
        margin: 0;
        font-size: 14px;
        line-height: 1.5;
        color: var(--text-muted);
      }

      .feature-list {
        list-style: none;
        margin: 0;
        padding: 0;
        border-top: 1px solid var(--border-color);
        padding-top: 12px;
        display: flex;
        flex-direction: column;
        gap: 8px;
      }

      .feature-list li {
        font-size: 14px;
        color: var(--text-main);
        line-height: 1.4;
      }

      .plan-price {
        border-top: 1px solid var(--border-color);
        padding: 14px 16px;
        background: #f8fafc;
      }

      .plan-price strong {
        display: block;
        margin: 0;
        font-size: 1.15rem;
        color: var(--text-main);
      }

      .price-caption {
        margin-top: 4px;
        font-size: 13px;
        color: var(--text-muted);
      }

      .price-local {
        margin-top: 6px;
        font-size: 12px;
        color: var(--text-muted);
        font-weight: 500;
      }

      .plan-trial-tag {
        margin-top: 8px;
        font-size: 13px;
        color: #0d8d5d;
        font-weight: 600;
      }

      .form-actions {
        margin-top: 16px;
        display: grid;
        gap: 10px;
      }

      .btn,
      .btn-secondary {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 100%;
        min-height: 44px;
        border-radius: 10px;
        border: 1px solid transparent;
        font-size: 15px;
        font-weight: 600;
        cursor: pointer;
        transition: background-color 0.2s ease, color 0.2s ease, border-color 0.2s ease;
      }

      .btn {
        background: var(--brand);
        color: #fff;
      }

      .btn:hover {
        background: var(--brand-hover);
      }

      .btn-secondary {
        background: #fff;
        border-color: var(--brand);
        color: var(--brand);
      }

      .btn-secondary:hover {
        background: #edf7f6;
      }

      .btn-secondary:disabled {
        opacity: 0.6;
        cursor: not-allowed;
      }

      .trial-note {
        margin: 0;
        text-align: center;
        color: #b65b00;
        font-size: 14px;
      }

      @media (max-width: 768px) {
        .pricing-shell {
          padding: 16px 16px 36px;
        }

        .pricing-header {
          padding: 18px;
        }

        .pricing-header h1 {
          font-size: 1.7rem;
        }

        .plan-grid {
          grid-template-columns: 1fr;
        }
      }

      @media (max-width: 480px) {
        .pricing-shell {
          padding: 14px 14px 30px;
        }
      }
    </style>
  </head>

  <body>
    <main class="pricing-shell">
      <section class="pricing-header">
        <h1>Select a Service Plan</h1>
        <p>Choose the package that best fits your school and continue to registration.</p>
      </section>

      <form action="/account/service-plan" method="POST" id="servicePlanForm">
        <% if (typeof trialRequested !== 'undefined' && trialRequested && premiumPlanName) { %>
          <div class="trial-banner">
            You're starting the <strong><%= premiumPlanName %></strong> free trial. We'll verify your card on the next step, and you can change plans before billing begins.
          </div>
        <% } %>

        <section class="plan-grid">
        <% plans.forEach(plan => { if (plan.is_active) { %>
        <article
          class="plan-card"
          data-plan="<%= plan.plan_name %>"
          data-plan-id="<%= plan.plan_id %>"
        >
          <div class="plan-name"><%= plan.plan_name %></div>
          <div class="plan-content">
            <p class="plan-description"><%= plan.description %></p>
            <ul class="feature-list">
              <% plan.features.forEach(feature => { %>
                <li><%= feature.feature_name %></li>
              <% }) %>
            </ul>
          </div>
          <div class="plan-price">
            <strong><%= plan.priceUsdDisplay || ('$' + plan.total_price.toFixed(2)) %></strong>
            <div class="price-caption">per month</div>
            <% if (currencyProfile && currencyProfile.userCurrency && currencyProfile.userCurrency !== 'USD') { %>
              <div class="price-local">
                ≈ <%= plan.localizedPriceDisplay %> / month
              </div>
            <% } %>
            <% if (typeof trialRequested !== 'undefined' && trialRequested && premiumPlanId && String(plan.plan_id) === String(premiumPlanId)) { %>
              <div class="plan-trial-tag">
                Pay after free trial
              </div>
            <% } %>
          </div>
        </article>
        <% }}); %>
        </section>
    
        <input type="hidden" name="plan" id="selectedPlan" />
        <input type="hidden" name="plan_id" id="selectedPlanId" />
        <input type="hidden" name="trialRequested" id="trialRequestedField" value="<%= trialRequested ? '1' : '' %>" />

        <div class="form-actions">
          <button type="submit" class="btn" id="proceedPlanButton">Proceed to Registration</button>
          <% if (typeof freeTrialEnabled !== 'undefined' && freeTrialEnabled && premiumPlanId) { %>
            <button type="button" class="btn-secondary" id="startTrialButton" <%= (!trialEligible ? "disabled" : "") %>>
              Start Premium Free Trial
              <% if (freeTrialLengthLabel) { %>
                (<%= freeTrialLengthLabel %>)
              <% } %>
            </button>
            <% if (!trialEligible) { %>
              <p class="trial-note">This email has already redeemed the free trial.</p>
            <% } %>
          <% } %>
        </div>
      </form>
    </main>
    <script>
      document.addEventListener("DOMContentLoaded", function () {
        const plans = document.querySelectorAll(".plan-card");
        const selectedPlanInput = document.getElementById("selectedPlan");
        const selectedPlanIdInput = document.getElementById("selectedPlanId");
        const form = document.getElementById("servicePlanForm");
        const trialRequestedField = document.getElementById("trialRequestedField");
        const proceedPlanButton = document.getElementById("proceedPlanButton");
        const startTrialButton = document.getElementById("startTrialButton");
        const premiumPlanId = "<%= premiumPlanId || '' %>";
        const premiumPlanName = <%- JSON.stringify(premiumPlanName || "") %>;

        let selectedPlan = null;
        let selectedPlanId = null;
        const defaultPlanId = "<%= preferredPlanId || '' %>";

        if (defaultPlanId) {
          const defaultPlanEl = document.querySelector(
            `.plan-card[data-plan-id="${defaultPlanId}"]`
          );
          if (defaultPlanEl) {
            defaultPlanEl.classList.add("selected");
            selectedPlan = defaultPlanEl.getAttribute("data-plan");
            selectedPlanId = defaultPlanId;
            selectedPlanInput.value = selectedPlan;
            selectedPlanIdInput.value = selectedPlanId;
          }
        }

        plans.forEach((plan) => {
          plan.addEventListener("click", function () {
            plans.forEach((p) => p.classList.remove("selected"));
            this.classList.add("selected");

            selectedPlan = this.getAttribute("data-plan");
            selectedPlanId = this.getAttribute("data-plan-id");

            if (selectedPlan && selectedPlanId) {
              selectedPlanInput.value = selectedPlan;
              selectedPlanIdInput.value = selectedPlanId;
            }
          });
        });

        form.addEventListener("submit", function (event) {
          if (
            !selectedPlanInput.value ||
            selectedPlanInput.value.trim() === "" ||
            !selectedPlanIdInput.value ||
            selectedPlanIdInput.value.trim() === ""
          ) {
            event.preventDefault();
            alert("⚠️ Please select a service plan before proceeding.");
          }
        });

        if (proceedPlanButton) {
          proceedPlanButton.addEventListener("click", function () {
            if (trialRequestedField) {
              trialRequestedField.value = "";
            }
          });
        }

        if (startTrialButton && !startTrialButton.disabled) {
          startTrialButton.addEventListener("click", function () {
            if (!premiumPlanId || !premiumPlanName) {
              alert("Premium plan is unavailable. Please select a plan to continue.");
              return;
            }
            const premiumPlanEl = document.querySelector(
              `.plan-card[data-plan-id="${premiumPlanId}"]`
            );
            if (premiumPlanEl) {
              plans.forEach((p) => p.classList.remove("selected"));
              premiumPlanEl.classList.add("selected");
            }
            selectedPlanInput.value = premiumPlanName;
            selectedPlanIdInput.value = premiumPlanId;
            if (trialRequestedField) {
              trialRequestedField.value = "1";
            }
            form.submit();
          });
        }
      });
    </script>
  </body>
</html>
