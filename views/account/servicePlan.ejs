<%- include('../partials/flash') %>

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Select a Service Plan</title>
    <style>
      :root {
        --font-family: "<%= (session && session.fontStyle ? String(session.fontStyle).trim() : 'Inter') %>", sans-serif;
      }

      body {
        font-family: var(--font-family);
        margin: 0;
        background-color: #f5f5f5;
      }
 
      form {
        max-width: 1000px;
        margin: 50px auto;
        background-color: #fff;
        border-radius: 8px;
        border: 1px solid #ddd;
        padding-bottom: 20px;
      }

      h1 {
        text-align: center;
        margin: 20px 0;
        color: #333;
      }

      p {
        padding: 10px;
      }

      .plan-table {
        display: flex;
        border-top: 1px solid #ddd;
      }

      .plan {
        flex: 1;
        cursor: pointer;
        text-align: center;
        transition: background-color 0.3s ease, border 0.3s ease,
          font-weight 0.3s ease;
        border-right: 1px solid #ddd;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        padding: 15px;
      }

      .plan:last-child {
        border-right: none;
      }

      .plan-header {
        background-color: #01535b;
        color: white;
        padding: 15px;
        font-size: 16px;
        font-weight: bold;
      }

      .plan-body {
        padding: 20px;
        background-color: #fff;
        border-bottom: 1px solid #ddd;
        flex-grow: 1;
      }

      .plan-body p {
        margin: 0 0 15px 0;
        font-size: 14px;
        color: #333;
      }

      .plan-body ul {
        list-style: none;
        padding: 0;
        margin: 0;
        text-align: left;
        border-top: 1px solid #ddd;
        padding-top: 15px;
      }

      .plan-body ul li {
        margin-bottom: 8px;
        font-size: 14px;
        color: #333;
      }

      .plan-price {
        padding: 15px 20px;
        font-size: 14px;
        color: #333;
        border-top: 1px solid #ddd;
        background-color: #f9f9f9;
      }

      .plan-price strong {
        display: block;
        margin: 5px 0;
      }

      .trial-banner {
        max-width: 85%;
        margin: 20px auto 0;
        padding: 12px 16px;
        background-color: #eaf6f2;
        border: 1px solid #92d1bb;
        border-radius: 6px;
        color: #0f5132;
        font-size: 14px;
        line-height: 1.5;
      }

      /* Selected plan styling */
      .plan.selected {
        border: 3px solid #01535b !important;
        background-color: #eaf4ff;
        font-weight: bold;
      }

      .btn {
        display: block;
        width: 100%;
        padding: 15px;
        background-color: #01535b;
        color: white;
        border: none;
        font-size: 16px;
        cursor: pointer;
        text-align: center;
      }

      .btn:hover {
        background-color: #01535b;
      }

      .btn-secondary {
        display: block;
        width: 100%;
        padding: 15px;
        background-color: #fff;
        color: #01535b;
        border: 2px solid #01535b;
        font-size: 16px;
        cursor: pointer;
        text-align: center;
        margin-top: 10px;
      }

      .btn-secondary:hover {
        background-color: #e6f5f3;
      }

      /* Responsive Styles */
      @media (max-width: 768px) {
        form {
          max-width: 100%;
          margin: 20px auto;
          padding: 15px;
          box-shadow: none;
        }

        h1 {
          font-size: 1.8rem;
          margin: 15px 0;
        }

        .plan-table {
          flex-direction: column;
          border-top: none;
          gap: 15px;
        }

        .plan {
          border-right: none;
          border: 1px solid #ddd;
          padding: 10px;
        }

        .plan-header {
          font-size: 1.2rem;
          padding: 10px;
        }

        .plan-body {
          padding: 10px;
        }

        .plan-body p {
          font-size: 0.95rem;
        }

        .plan-body ul {
          padding-top: 10px;
        }

        .plan-body ul li {
          font-size: 0.9rem;
        }

        .plan-price {
          font-size: 1rem;
          padding: 10px;
        }

        .btn {
          padding: 12px;
          font-size: 1rem;
        }
      }

      @media (max-width: 480px) {
        h1 {
          font-size: 1.6rem;
        }

        .plan-body p,
        .plan-body ul li,
        .plan-price strong {
          font-size: 0.85rem;
        }

        .btn {
          font-size: 0.9rem;
          padding: 10px;
        }
      }
    </style>
  </head>

  <body>
    <form action="/account/service-plan" method="POST" id="servicePlanForm">
      <% if (typeof trialRequested !== 'undefined' && trialRequested && premiumPlanName) { %>
      <div class="trial-banner" style="border-color:#0d8d5d;background-color:#e7faf1;">
        You're starting the <strong><%= premiumPlanName %></strong> free trial. We'll verify your card with a refundable GHS 1.00 charge on the next step, and you can change plans before billing begins.
      </div>
      <% } %>
      <h1>Select a Service Plan</h1>
      <div class="plan-table">
        <% plans.forEach(plan => { if (plan.is_active) { %>
        <div
          class="plan"
          data-plan="<%= plan.plan_name %>"
          data-plan-id="<%= plan.plan_id %>"
        >
          <div class="plan-header"><%= plan.plan_name %></div>
          <div class="plan-body">
            <p><%= plan.description %></p>
            <ul>
              <% plan.features.forEach(feature => { %>
              <li>- <%= feature.feature_name %></li>
              <hr />
              <% }) %>
            </ul>
          </div>
          <div class="plan-price">
            <strong><%= plan.priceUsdDisplay || ('$' + plan.total_price.toFixed(2)) %></strong>
            <% if (currencyProfile && currencyProfile.userCurrency && currencyProfile.userCurrency !== 'USD') { %>
              <div style="margin-top: 6px; font-size: 12px; color: #666; font-weight: 500;">
                ≈ <%= plan.localizedPriceDisplay %>
              </div>
            <% } %>
            <% if (typeof trialRequested !== 'undefined' && trialRequested && premiumPlanId && String(plan.plan_id) === String(premiumPlanId)) { %>
              <div style="margin-top: 8px; font-size: 13px; color: #0d8d5d; font-weight: 500;">
                Pay after free trial
              </div>
            <% } %>
          </div>
        </div>
        <% }}); %>
      </div>
    
      <input type="hidden" name="plan" id="selectedPlan" />
      <input type="hidden" name="plan_id" id="selectedPlanId" />
      <input type="hidden" name="trialRequested" id="trialRequestedField" value="<%= trialRequested ? '1' : '' %>" />
      <button type="submit" class="btn" id="proceedPlanButton">Proceed to Registration</button>
      <% if (typeof freeTrialEnabled !== 'undefined' && freeTrialEnabled && premiumPlanId) { %>
      <button type="button" class="btn-secondary" id="startTrialButton" <%= (!trialEligible ? "disabled" : "") %>>
        Start Premium Free Trial
        <% if (freeTrialLengthLabel) { %>
          (<%= freeTrialLengthLabel %>)
        <% } %>
      </button>
      <% if (!trialEligible) { %>
        <p style="text-align:center;color:#b65b00;margin-top:6px;font-size:14px;">This email has already redeemed the free trial.</p>
      <% } %>
      <% } %>
    </form>
    <script>
      document.addEventListener("DOMContentLoaded", function () {
        const plans = document.querySelectorAll(".plan");
        const selectedPlanInput = document.getElementById("selectedPlan");
        const selectedPlanIdInput = document.getElementById("selectedPlanId");
        const form = document.getElementById("servicePlanForm");
        const trialRequestedField = document.getElementById("trialRequestedField");
        const proceedPlanButton = document.getElementById("proceedPlanButton");
        const startTrialButton = document.getElementById("startTrialButton");
        const premiumPlanId = "<%= premiumPlanId || '' %>";
        const premiumPlanName = <%- JSON.stringify(premiumPlanName || "") %>;

        let selectedPlan = null;
        let selectedPlanId = null;
        const defaultPlanId = "<%= preferredPlanId || '' %>";

        if (defaultPlanId) {
          const defaultPlanEl = document.querySelector(
            `.plan[data-plan-id="${defaultPlanId}"]`
          );
          if (defaultPlanEl) {
            defaultPlanEl.classList.add("selected");
            selectedPlan = defaultPlanEl.getAttribute("data-plan");
            selectedPlanId = defaultPlanId;
            selectedPlanInput.value = selectedPlan;
            selectedPlanIdInput.value = selectedPlanId;
          }
        }

        plans.forEach((plan) => {
          plan.addEventListener("click", function () {
            plans.forEach((p) => p.classList.remove("selected"));
            this.classList.add("selected");

            selectedPlan = this.getAttribute("data-plan");
            selectedPlanId = this.getAttribute("data-plan-id");

            if (selectedPlan && selectedPlanId) {
              selectedPlanInput.value = selectedPlan;
              selectedPlanIdInput.value = selectedPlanId;
            }
          });
        });

        form.addEventListener("submit", function (event) {
          if (
            !selectedPlanInput.value ||
            selectedPlanInput.value.trim() === "" ||
            !selectedPlanIdInput.value ||
            selectedPlanIdInput.value.trim() === ""
          ) {
            event.preventDefault();
            alert("⚠️ Please select a service plan before proceeding.");
          }
        });

        if (proceedPlanButton) {
          proceedPlanButton.addEventListener("click", function () {
            if (trialRequestedField) {
              trialRequestedField.value = "";
            }
          });
        }

        if (startTrialButton && !startTrialButton.disabled) {
          startTrialButton.addEventListener("click", function () {
            if (!premiumPlanId || !premiumPlanName) {
              alert("Premium plan is unavailable. Please select a plan to continue.");
              return;
            }
            const premiumPlanEl = document.querySelector(
              `.plan[data-plan-id="${premiumPlanId}"]`
            );
            if (premiumPlanEl) {
              plans.forEach((p) => p.classList.remove("selected"));
              premiumPlanEl.classList.add("selected");
            }
            selectedPlanInput.value = premiumPlanName;
            selectedPlanIdInput.value = premiumPlanId;
            if (trialRequestedField) {
              trialRequestedField.value = "1";
            }
            form.submit();
          });
        }
      });
    </script>
  </body>
</html>
