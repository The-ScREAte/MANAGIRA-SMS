<%- include('../partials/flash') %>

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Select a Service Plan</title>
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href="https://managira.com/account/service-plan" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <style>
      :root {
        --font-family: "<%= (session && session.fontStyle ? String(session.fontStyle).trim() : 'Inter') %>", sans-serif;
        --brand: var(--org-primary-color, #01535b);
        --brand-hover: var(--org-primary-hover, #01444a);
        --border-color: #dfe5ec;
        --text-main: #1f2937;
        --text-muted: #5f6b7a;
        --surface: #ffffff;
        --page-bg: #f4f7fb;
      }

      * {
        box-sizing: border-box;
      }

      body {
        font-family: var(--font-family);
        margin: 0;
        background: var(--page-bg);
        color: var(--text-main);
      }

      .pricing-shell {
        max-width: 1140px;
        margin: 0 auto;
        padding: 24px 16px 48px;
      }

      .pricing-header {
        background: var(--surface);
        border: 1px solid var(--border-color);
        border-radius: 14px;
        padding: 24px;
        text-align: center;
        margin-bottom: 18px;
      }

      .pricing-header h1 {
        margin: 0;
        font-size: 2rem;
        line-height: 1.2;
        color: var(--text-main);
      }

      .pricing-header p {
        margin: 10px 0 0;
        font-size: 15px;
        color: var(--text-muted);
      }

      .trial-banner {
        margin-bottom: 14px;
        padding: 12px 14px;
        border-radius: 10px;
        border: 1px solid #8fcab4;
        background: #e7faf1;
        color: #0f5132;
        font-size: 14px;
        line-height: 1.45;
      }

      .plan-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
        gap: 16px;
      }

      .plan-card {
        cursor: pointer;
        background: var(--surface);
        border: 1px solid var(--border-color);
        border-radius: 14px;
        overflow: hidden;
        position: relative;
        display: flex;
        flex-direction: column;
        min-height: 100%;
        transition: border-color 0.2s ease, box-shadow 0.2s ease;
      }

      .plan-card.selected {
        border-color: var(--brand);
        box-shadow: 0 0 0 3px rgba(1, 83, 91, 0.28), 0 10px 24px rgba(1, 83, 91, 0.12);
        background: #f2fbfa;
      }

      .plan-card.selected::after {
        content: "✓";
        position: absolute;
        top: 10px;
        right: 10px;
        background: var(--brand);
        color: #fff;
        border: none;
        border-radius: 50%;
        width: 24px;
        height: 24px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 14px;
        font-weight: 700;
        line-height: 1;
      }

      .plan-card.selected .plan-name {
        background: var(--brand-hover);
      }

      .plan-name {
        background: var(--brand);
        color: #fff;
        padding: 14px 16px;
        font-weight: 700;
        font-size: 16px;
        text-align: center;
      }

      .plan-content {
        padding: 16px;
        display: flex;
        flex-direction: column;
        gap: 14px;
        flex: 1;
      }

      .plan-description {
        margin: 0;
        font-size: 14px;
        line-height: 1.5;
        color: var(--text-muted);
      }

      .feature-list {
        list-style: none;
        margin: 0;
        padding: 0;
        border-top: 1px solid var(--border-color);
        padding-top: 12px;
        display: flex;
        flex-direction: column;
        gap: 8px;
      }

      .feature-list li {
        font-size: 14px;
        color: var(--text-main);
        line-height: 1.4;
      }

      .plan-price {
        border-top: 1px solid var(--border-color);
        padding: 14px 16px;
        background: #f8fafc;
      }

      .plan-price strong {
        display: block;
        margin: 0;
        font-size: 1.15rem;
        color: var(--text-main);
      }

      .price-caption {
        margin-top: 4px;
        font-size: 13px;
        color: var(--text-muted);
      }

      .free-students-badge {
        display: inline-flex;
        margin-top: 7px;
        padding: 3px 8px;
        border-radius: 999px;
        border: 1px solid #c9e6d7;
        background: #eef9f3;
        color: #1f6f46;
        font-size: 11px;
        font-weight: 700;
      }

      .price-breakdown {
        margin-top: 6px;
        font-size: 12px;
        color: #4b5563;
        line-height: 1.45;
      }

      .price-local {
        margin-top: 6px;
        font-size: 12px;
        color: var(--text-muted);
        font-weight: 500;
      }

      .price-after-trial {
        margin-top: 3px;
        font-size: 12px;
        color: #5f6b7a;
        font-style: italic;
      }

      /* ── Collapsible inherited features in higher plans ── */
      .core-toggle {
        display: flex;
        align-items: center;
        gap: 6px;
        margin: 0;
        padding: 10px 10px;
        border: none;
        border-radius: 8px;
        background: #f0f5f5;
        cursor: pointer;
        font-family: var(--font-family);
        font-size: 12.5px;
        font-weight: 600;
        color: var(--brand);
        transition: background 0.18s, color 0.15s;
        width: 100%;
      }

      .core-toggle:hover {
        background: #e2eded;
        color: var(--brand-hover);
      }

      .core-toggle .toggle-arrow {
        display: inline-block;
        font-size: 9px;
        transition: transform 0.2s ease;
      }

      .core-toggle.open .toggle-arrow {
        transform: rotate(90deg);
      }

      .core-features-collapse {
        max-height: 0;
        overflow: hidden;
        transition: max-height 0.3s ease;
      }

      .core-features-collapse.open {
        max-height: 500px;
      }

      .core-features-collapse .feature-list {
        border-top: none;
        padding-top: 6px;
      }

      .core-features-collapse .feature-list li {
        font-size: 13px;
        color: var(--text-muted);
      }

      /* ── Footer billing note ── */
      .billing-footer-note {
        margin: 10px 0 0;
        text-align: center;
        font-size: 12px;
        color: var(--text-muted);
        line-height: 1.4;
      }

      /* ── Billing Period Cards (secondary) ── */
      .period-section {
        margin-top: 18px;
        padding: 14px;
        border: 1px solid var(--border-color);
        border-radius: 12px;
        background: #fff;
      }

      .school-size-notice {
        margin-top: 12px;
        padding: 12px 14px;
        border: 1.5px solid #6fb98f;
        border-radius: 12px;
        background: linear-gradient(180deg, #ecfdf3 0%, #dcfce7 100%);
        color: #14532d;
        font-size: 13.5px;
        font-weight: 600;
        line-height: 1.5;
        text-align: center;
        box-shadow: 0 3px 10px rgba(16, 185, 129, 0.16);
      }

      .school-size-notice strong {
        color: #065f46;
        font-weight: 800;
      }

      .period-section h3 {
        margin: 0 0 8px;
        font-size: 14px;
        font-weight: 600;
        color: var(--text-muted);
        text-align: center;
        letter-spacing: 0.01em;
        text-transform: uppercase;
      }

      .period-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
        gap: 10px;
        max-width: none;
        margin: 0;
      }

      .period-card {
        position: relative;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 10px 8px;
        border: 1.5px solid var(--border-color);
        border-radius: 10px;
        background: var(--surface);
        cursor: pointer;
        transition: all 0.22s ease;
        text-align: center;
        min-height: 68px;
        font-family: var(--font-family);
      }

      .period-card:hover {
        border-color: #94b8bb;
        background: #f7fbfb;
      }

      .period-card.active {
        border-color: var(--brand);
        background: #f4fafa;
        box-shadow: 0 0 0 2px rgba(1, 83, 91, 0.12);
      }

      .period-card-label {
        font-size: 14px;
        font-weight: 600;
        color: var(--text-main);
        margin-bottom: 2px;
      }

      .period-card-price {
        font-size: 12px;
        color: var(--text-muted);
        line-height: 1.4;
        min-height: 18px;
      }

      .period-card-price .period-price-strike {
        text-decoration: line-through;
        color: #b0b7c3;
        font-size: 11px;
      }

      .period-card-badge {
        display: inline-block;
        margin-top: 2px;
        padding: 1px 7px;
        border-radius: 99px;
        font-size: 10px;
        font-weight: 700;
        background: rgba(13, 141, 93, 0.1);
        color: #0d8d5d;
      }

      .period-card.active .period-card-badge {
        background: var(--brand);
        color: #fff;
      }

      .form-actions {
        margin-top: 18px;
        padding: 14px;
        border: 1px solid var(--border-color);
        border-radius: 12px;
        background: #fff;
        display: grid;
        gap: 8px;
      }

      .btn,
      .btn-secondary {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 100%;
        min-height: 44px;
        border-radius: 10px;
        border: 1px solid transparent;
        font-size: 15px;
        font-weight: 600;
        cursor: pointer;
        transition: background-color 0.2s ease, color 0.2s ease, border-color 0.2s ease;
      }

      .btn {
        background: var(--brand);
        color: #fff;
      }

      .btn:disabled {
        opacity: 0.5;
        cursor: not-allowed;
      }

      .btn:hover:not(:disabled) {
        background: var(--brand-hover);
      }

      .btn-secondary {
        background: #fff;
        border-color: var(--brand);
        color: var(--brand);
      }

      .btn-secondary:hover {
        background: #edf7f6;
      }

      .btn-secondary:disabled {
        opacity: 0.6;
        cursor: not-allowed;
      }

      .trial-note {
        margin: 0;
        text-align: center;
        color: #b65b00;
        font-size: 14px;
      }

      @media (max-width: 768px) {
        .pricing-shell {
          padding: 12px 12px 20px;
        }

        #servicePlanForm {
          padding: 0 2px;
        }

        .form-actions {
          padding: 0 2px 8px;
          margin-top: 10px;
          gap: 6px;
        }

        .pricing-header {
          padding: 12px;
          margin-bottom: 10px;
        }

        .pricing-header h1 {
          font-size: 1.48rem;
        }

        .pricing-header p {
          font-size: 12.5px;
        }

        .trial-banner {
          font-size: 12px;
        }

        .plan-grid {
          grid-template-columns: 1fr;
          gap: 8px;
          justify-items: center;
        }

        .plan-card {
          margin: 0;
          width: min(100%, 405px);
        }

        .plan-content {
          padding: 10px;
          gap: 0;
        }

        .feature-list {
          padding-top: 8px;
          gap: 0;
        }

        .plan-price {
          padding: 10px;
        }

        .period-grid {
          grid-template-columns: repeat(2, 1fr);
          gap: 6px;
        }

        .period-card {
          min-height: 55px;
        }

        .period-section,
        .tier-section {
          margin-top: 10px;
          padding: 10px;
        }

        .tier-grid {
          gap: 6px;
        }

        .plan-name {
          font-size: 13.5px;
        }

        .plan-description,
        .feature-list li {
          font-size: 12px;
        }

        .plan-price strong {
          font-size: 1.02rem;
        }

        .price-caption,
        .price-local,
        .price-after-trial,
        .price-breakdown,
        .period-section h3,
        .period-card-price,
        .trial-note,
        .btn,
        .btn-secondary {
          font-size: 11.5px;
        }

        .free-students-badge,
        .period-card-badge,
        .billing-footer-note,
        .core-toggle,
        .core-features-collapse .feature-list li {
          font-size: 10.5px;
        }

        .school-size-notice {
          font-size: 12px;
          margin-top: 6px;
          padding: 8px 9px;
        }
      }

      @media (max-width: 480px) {
        .pricing-shell {
          padding: 8px 8px 14px;
        }

        #servicePlanForm {
          padding: 0 1px;
        }

        .form-actions {
          padding: 0 1px 6px;
          margin-top: 8px;
          gap: 0;
        }

        .plan-card {
          margin: 0;
          border-radius: 10px;
          width: min(100%, 332px);
        }

        .pricing-header {
          padding: 10px;
          margin-bottom: 8px;
          border-radius: 10px;
        }

        .plan-grid,
        .period-grid,
        .tier-grid {
          gap: 6px;
        }

        .plan-content,
        .plan-price,
        .period-section,
        .tier-section {
          padding: 8px;
        }

        .plan-content {
          gap: 6px;
        }

        .feature-list {
          padding-top: 6px;
          gap: 0;
        }

        .period-card {
          padding: 6px 5px;
          min-height: 50px;
        }

        .period-card-label {
          font-size: 12px;
        }

        .pricing-header h1 {
          font-size: 1.22rem;
        }

        .pricing-header p {
          font-size: 11.5px;
        }

        .plan-name {
          font-size: 12.3px;
        }

        .plan-description,
        .feature-list li {
          font-size: 11px;
          line-height: 1.35;
        }

        .plan-price strong {
          font-size: 0.95rem;
        }

        .price-caption,
        .price-local,
        .price-after-trial,
        .price-breakdown,
        .period-section h3,
        .period-card-price,
        .trial-note,
        .btn,
        .btn-secondary,
        .trial-banner {
          font-size: 10.5px;
        }

        .free-students-badge,
        .period-card-badge,
        .billing-footer-note,
        .core-toggle,
        .core-features-collapse .feature-list li {
          font-size: 10px;
        }

        .school-size-notice {
          font-size: 11px;
          line-height: 1.4;
          margin-top: 4px;
          padding: 6px 7px;
        }
      }

      /* ── Student Tier Picker ── */
      .tier-section {
        margin-top: 18px;
        padding: 14px;
        border: 1px solid var(--border-color);
        border-radius: 12px;
        background: #fff;
      }
      .tier-section h3 {
        margin: 0 0 8px;
        font-size: 14px;
        font-weight: 600;
        color: var(--text-muted);
        text-align: center;
        letter-spacing: 0.01em;
        text-transform: uppercase;
      }
      .tier-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
        gap: 10px;
        max-width: none;
        margin: 0;
      }
      .tier-card {
        position: relative;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 10px 8px;
        border: 1.5px solid var(--border-color);
        border-radius: 10px;
        background: var(--surface);
        cursor: pointer;
        transition: all 0.22s ease;
        text-align: center;
        min-height: 68px;
        font-family: var(--font-family);
      }
      .tier-card:hover {
        border-color: #94b8bb;
        background: #f7fbfb;
      }
      .tier-card.active {
        border-color: var(--brand);
        background: #f4fafa;
        box-shadow: 0 0 0 2px rgba(1, 83, 91, 0.12);
      }
      .tier-card-label {
        font-size: 13px;
        font-weight: 600;
        color: var(--text-main);
        margin-bottom: 2px;
      }
      .tier-card-price {
        font-size: 12px;
        color: var(--text-muted);
        line-height: 1.4;
      }
      .tier-card-range {
        font-size: 13px;
        color: var(--text-main);
        font-weight: 600;
        margin-top: 1px;
      }
    </style>
  </head>

  <body>
    <main class="pricing-shell">
      <section class="pricing-header">
        <h1>Select a Service Plan</h1>
        <% if (freeTrialEnabled && freeTrialLengthLabel) { %>
          <p>Enjoy <strong><%= freeTrialLengthLabel %></strong> free on any plan. Choose a plan and billing cycle below.</p>
        <% } else { %>
          <p>Choose the package that best fits your school and continue to registration.</p>
        <% } %>
      </section>

      <form action="/account/service-plan" method="POST" id="servicePlanForm">
        <% if (typeof trialRequested !== 'undefined' && trialRequested && premiumPlanName) { %>
          <div class="trial-banner">
            You're starting the <strong><%= premiumPlanName %></strong> free trial. We'll verify your card on the next step, and you can change plans before billing begins.
          </div>
        <% } %>

        <%
          /* ── Deduplicate features: find common vs unique ── */
          var activePlans = plans.filter(function(p) { return p.is_active; });
          var featuresByPlan = activePlans.map(function(p) {
            return p.features.map(function(f) { return f.feature_name; });
          });
          var commonFeatures = [];
          if (featuresByPlan.length > 0) {
            commonFeatures = featuresByPlan[0].filter(function(fname) {
              return featuresByPlan.every(function(list) { return list.indexOf(fname) !== -1; });
            });
          }
          var uniqueFeaturesByPlan = {};
          activePlans.forEach(function(p) {
            uniqueFeaturesByPlan[p.plan_id] = p.features
              .map(function(f) { return f.feature_name; })
              .filter(function(fname) { return commonFeatures.indexOf(fname) === -1; });
          });
          /* Build cumulative inherited features for each plan tier */
          var inheritedByPlan = {};
          for (var pi = 0; pi < activePlans.length; pi++) {
            if (pi === 0) {
              inheritedByPlan[activePlans[pi].plan_id] = [];
            } else {
              /* inherit ALL features from the previous plan */
              var prevPlan = activePlans[pi - 1];
              var prevAllFeatures = prevPlan.features.map(function(f) { return f.feature_name; });
              inheritedByPlan[activePlans[pi].plan_id] = { label: prevPlan.plan_name, features: prevAllFeatures };
            }
          }
          var planIndex = 0;
        %>

        <section class="plan-grid">
        <% plans.forEach(plan => { if (plan.is_active) { %>
        <% const dynamicMeta = (typeof dynamicPriceMetaByPlan !== 'undefined' && dynamicPriceMetaByPlan) ? dynamicPriceMetaByPlan[plan.plan_id] : null; %>
        <article
          class="plan-card"
          data-plan="<%= plan.plan_name %>"
          data-plan-id="<%= plan.plan_id %>"
          data-base-usd="<%= typeof plan.defaultDisplayUsd !== 'undefined' ? plan.defaultDisplayUsd : plan.total_price %>"
          data-base-local="<%= typeof plan.defaultDisplayLocal !== 'undefined' ? Number(plan.defaultDisplayLocal).toFixed(2) : ((currencyProfile && currencyProfile.usdToUserRate) ? (plan.total_price * currencyProfile.usdToUserRate).toFixed(2) : plan.total_price) %>"
          data-local-currency="<%= (currencyProfile && currencyProfile.userCurrency) ? currencyProfile.userCurrency : 'USD' %>"
          data-price-base-component="<%= dynamicMeta ? Number(dynamicMeta.basePriceUsd || 0) : '' %>"
          data-price-free-threshold="<%= dynamicMeta ? Number(dynamicMeta.freeStudentThreshold || 0) : '' %>"
          data-price-per-student="<%= dynamicMeta ? Number(dynamicMeta.perStudentRateUsd || 0) : '' %>"
          data-price-months-per-term="<%= dynamicMeta ? Number(dynamicMeta.monthsPerTerm || 1) : '' %>"
        >
          <div class="plan-name"><%= plan.plan_name %></div>
          <div class="plan-content">
            <p class="plan-description"><%= plan.description %></p>
            <% var uniqueF = uniqueFeaturesByPlan[plan.plan_id] || []; %>
            <% var inherited = inheritedByPlan[plan.plan_id]; %>
            <% if (planIndex === 0) { %>
              <%/* Basic plan: show ALL its features */%>
              <ul class="feature-list">
                <% plan.features.forEach(function(f) { %>
                  <li><%= f.feature_name %></li>
                <% }); %>
              </ul>
            <% } else { %>
              <%/* Higher plans: collapsible inherited FIRST, then unique features */%>
              <% if (inherited && inherited.features && inherited.features.length > 0) { %>
                <button type="button" class="core-toggle" onclick="this.classList.toggle('open');this.nextElementSibling.classList.toggle('open')">
                  <span class="toggle-arrow">▶</span> Includes all <%= inherited.label %> features
                </button>
                <div class="core-features-collapse">
                  <ul class="feature-list">
                    <% inherited.features.forEach(function(fname) { %>
                      <li><%= fname %></li>
                    <% }); %>
                  </ul>
                </div>
              <% } %>
              <% if (uniqueF.length > 0) { %>
                <ul class="feature-list">
                  <% uniqueF.forEach(function(fname) { %>
                    <li><%= fname %></li>
                  <% }); %>
                </ul>
              <% } %>
            <% } %>
            <% planIndex++; %>
          </div>
          <div class="plan-price">
            <strong><%= plan.defaultLocalizedPriceDisplay || plan.localizedPriceDisplay || plan.defaultPriceUsdDisplay || plan.priceUsdDisplay || ('$' + plan.total_price.toFixed(2)) %></strong>
            <div class="price-caption">per month</div>
            <% if (freeTrialEnabled && freeTrialLengthLabel) { %>
              <div class="price-after-trial">after trial ends</div>
            <% } %>
            <% if (dynamicMeta) { %>
              <div class="free-students-badge">First <%= Number(dynamicMeta.freeStudentThreshold || 0) %> students are free</div>
            <% } %>
            <div class="price-local"></div>
          </div>
        </article>
        <% }}); %>
        </section>

        <input type="hidden" name="approx_student_count" id="approxStudentCount" value="" />

        <div class="school-size-notice" id="schoolSizeNotice" style="display:none;">
          Extra charges of <strong id="schoolSizeRate">0</strong> per student per term/semester will incur once school size exceeds <strong id="schoolSizeThreshold">0</strong> students. First <strong id="schoolSizeFree">0</strong> students are free.
        </div>

        <!-- Billing Period Cards -->
        <% if (typeof billingPeriods !== 'undefined' && billingPeriods.length > 1) { %>
        <div class="period-section">
          <h3>Choose Your Billing Cycle</h3>
          <div class="period-grid" role="radiogroup" aria-label="Billing period">
            <% billingPeriods.forEach(function(bp, idx) { %>
              <div
                class="period-card"
                data-key="<%= bp.period_key %>"
                data-months="<%= bp.months %>"
                data-discount="<%= bp.discount_percentage %>"
                role="radio"
                tabindex="0"
                aria-checked="<%= idx === 0 ? 'true' : 'false' %>"
              >
                <div class="period-card-label"><%= bp.label %></div>
                <div class="period-card-price" data-period-price></div>
                <% if (bp.discount_percentage > 0) { %>
                  <span class="period-card-badge">Save <%= bp.discount_percentage %>%</span>
                <% } %>
              </div>
            <% }) %>
          </div>
        </div>
        <% } %>
        <input type="hidden" name="billing_period" id="billingPeriodInput" value="" />

        <input type="hidden" name="plan" id="selectedPlan" />
        <input type="hidden" name="plan_id" id="selectedPlanId" />
        <input type="hidden" name="trialRequested" id="trialRequestedField" value="<%= trialRequested ? '1' : '' %>" />

        <% if (freeTrialEnabled && freeTrialLengthLabel) { %>
          <p class="billing-footer-note">
            Free for <%= freeTrialLengthLabel %>, then billed based on your selected plan and cycle.
          </p>
        <% } %>

        <div class="form-actions">
          <button type="submit" class="btn" id="proceedPlanButton" disabled>Proceed to Registration</button>
          <% if (typeof freeTrialEnabled !== 'undefined' && freeTrialEnabled && premiumPlanId) { %>
            <button type="button" class="btn-secondary" id="startTrialButton" <%= (!trialEligible ? "disabled" : "") %>>
              Start Premium Free Trial
              <% if (freeTrialLengthLabel) { %>
                (<%= freeTrialLengthLabel %>)
              <% } %>
            </button>
            <% if (!trialEligible) { %>
              <p class="trial-note">This email has already redeemed the free trial.</p>
            <% } %>
          <% } %>
        </div>
      </form>
    </main>
    <script>
      (function initServicePlanPage() {
        const plans = document.querySelectorAll(".plan-card");
        const selectedPlanInput = document.getElementById("selectedPlan");
        const selectedPlanIdInput = document.getElementById("selectedPlanId");
        const form = document.getElementById("servicePlanForm");
        const trialRequestedField = document.getElementById("trialRequestedField");
        const proceedPlanButton = document.getElementById("proceedPlanButton");
        const startTrialButton = document.getElementById("startTrialButton");
        const premiumPlanId = "<%= premiumPlanId || '' %>";
        const premiumPlanName = <%- JSON.stringify(premiumPlanName || "") %>;
        const periodBtns = document.querySelectorAll('.period-card');
        const periodInput = document.getElementById('billingPeriodInput');
        const periodHint = document.getElementById("billingPeriodHint");
        const schoolSizeNotice = document.getElementById('schoolSizeNotice');
        const schoolSizeRate = document.getElementById('schoolSizeRate');
        const schoolSizeThreshold = document.getElementById('schoolSizeThreshold');
        const schoolSizeFree = document.getElementById('schoolSizeFree');
        const isTrial = <%= freeTrialEnabled ? 'true' : 'false' %>;
        const trialLabel = <%- JSON.stringify(freeTrialLengthLabel || '') %>;
        let billingCycleSelected = false;
        const hasBillingCards = periodBtns.length > 0;

        // Currency localization — display all prices in the visitor's local currency
        // (detected from their location). Ghana visitors see GHS, others see their own.
        var USER_CURRENCY = '<%= (currencyProfile && currencyProfile.userCurrency) ? currencyProfile.userCurrency : "USD" %>';
        var USD_TO_USER = Number('<%= (currencyProfile && currencyProfile.usdToUserRate) ? currencyProfile.usdToUserRate : 1 %>') || 1;
        var USER_LOCALE = '<%= (currencyProfile && currencyProfile.locale) ? currencyProfile.locale : "en-US" %>';
        var _moneyFmt = null;
        try {
          _moneyFmt = new Intl.NumberFormat(USER_LOCALE, { style: 'currency', currency: USER_CURRENCY, minimumFractionDigits: 2, maximumFractionDigits: 2 });
        } catch (e) { _moneyFmt = null; }
        function fmtLocal(usdAmount) {
          var v = (Number(usdAmount) || 0) * USD_TO_USER;
          if (_moneyFmt) { try { return _moneyFmt.format(v); } catch (e) {} }
          return USER_CURRENCY + ' ' + v.toFixed(2);
        }

        (function syncClientGeoHint() {
          var currentCountry = '<%= (currencyProfile && currencyProfile.countryCode) ? currencyProfile.countryCode : "" %>';
          var detectionSource = '<%= (currencyProfile && currencyProfile.detectionSource) ? currencyProfile.detectionSource : "" %>';
          var hostname = String(window.location && window.location.hostname || '').toLowerCase();
          var isLocalhost = hostname === 'localhost' || hostname === '127.0.0.1' || hostname === '::1';
          var nowMs = Date.now();
          var lastSyncAt = Number(window.sessionStorage ? window.sessionStorage.getItem('servicePlanGeoHintSyncAt') : 0) || 0;

          if (!isLocalhost) return;
          if (lastSyncAt && (nowMs - lastSyncAt) < (10 * 60 * 1000)) return;

          // Only run this sync when detection is weak/derived from language/fallback.
          if (detectionSource && detectionSource !== 'accept-language-fallback' && detectionSource !== 'fallback') {
            return;
          }

          function validCountry(code) {
            return /^[A-Z]{2}$/.test(String(code || '').trim().toUpperCase());
          }

          function normalizeCountry(code) {
            return String(code || '').trim().toUpperCase();
          }

          function fetchWithTimeout(url, timeoutMs) {
            return new Promise(function(resolve) {
              var done = false;
              var timer = setTimeout(function() {
                if (done) return;
                done = true;
                resolve(null);
              }, timeoutMs);

              fetch(url, { cache: 'no-store' })
                .then(function(resp) {
                  if (done) return;
                  if (!resp || !resp.ok) {
                    done = true;
                    clearTimeout(timer);
                    resolve(null);
                    return;
                  }
                  return resp.json();
                })
                .then(function(payload) {
                  if (done) return;
                  done = true;
                  clearTimeout(timer);
                  resolve(payload || null);
                })
                .catch(function() {
                  if (done) return;
                  done = true;
                  clearTimeout(timer);
                  resolve(null);
                });
            });
          }

          function geolocatePosition(timeoutMs) {
            return new Promise(function(resolve) {
              if (!navigator.geolocation) {
                resolve(null);
                return;
              }
              navigator.geolocation.getCurrentPosition(
                function(pos) { resolve(pos); },
                function() { resolve(null); },
                { enableHighAccuracy: false, timeout: timeoutMs, maximumAge: 10 * 60 * 1000 }
              );
            });
          }

          function countryFromPosition(pos) {
            if (!pos || !pos.coords) return Promise.resolve(null);
            var lat = Number(pos.coords.latitude);
            var lon = Number(pos.coords.longitude);
            if (!Number.isFinite(lat) || !Number.isFinite(lon)) return Promise.resolve(null);
            var url = 'https://api.bigdatacloud.net/data/reverse-geocode-client?latitude=' +
              encodeURIComponent(lat) + '&longitude=' + encodeURIComponent(lon) + '&localityLanguage=en';
            return fetchWithTimeout(url, 3500).then(function(payload) {
              var code = normalizeCountry(payload && payload.countryCode);
              return validCountry(code) ? code : null;
            });
          }

          function countryFromIpProviders() {
            return fetchWithTimeout('https://ipapi.co/json/', 3000)
              .then(function(payload) {
                var code = normalizeCountry(payload && payload.country_code);
                if (validCountry(code)) return code;
                return fetchWithTimeout('https://ipwho.is/', 3000).then(function(payload2) {
                  var code2 = normalizeCountry(payload2 && payload2.country_code);
                  return validCountry(code2) ? code2 : null;
                });
              });
          }

          function saveGeoHint(countryCode) {
            return fetch('/account/geo-hint', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ countryCode: countryCode }),
            }).then(function(res) { return res && res.ok; }).catch(function() { return false; });
          }

          Promise.resolve()
            .then(function() { return geolocatePosition(3500); })
            .then(function(pos) { return countryFromPosition(pos); })
            .then(function(codeFromGeo) {
              if (validCountry(codeFromGeo)) return codeFromGeo;
              return countryFromIpProviders();
            })
            .then(function(hintedCountry) {
              hintedCountry = normalizeCountry(hintedCountry);
              if (!validCountry(hintedCountry)) return null;
              if (hintedCountry === currentCountry) {
                if (window.sessionStorage) window.sessionStorage.setItem('servicePlanGeoHintSyncAt', String(Date.now()));
                return null;
              }
              return saveGeoHint(hintedCountry).then(function(ok) {
                if (!ok) return null;
                return hintedCountry;
              });
            })
            .then(function(savedCountry) {
              if (window.sessionStorage) window.sessionStorage.setItem('servicePlanGeoHintSyncAt', String(Date.now()));
              if (!savedCountry) return;
              window.location.reload();
            })
            .catch(function() {
              if (window.sessionStorage) window.sessionStorage.setItem('servicePlanGeoHintSyncAt', String(Date.now()));
            });
        })();

        const approxInput = document.getElementById('approxStudentCount');

        if (!form || !selectedPlanInput || !selectedPlanIdInput) {
          return;
        }

        // Billing period card logic
        function selectPeriod(card) {
          periodBtns.forEach(function(c) {
            c.classList.remove('active');
            c.setAttribute('aria-checked', 'false');
          });
          card.classList.add('active');
          card.setAttribute('aria-checked', 'true');
          if (periodInput) periodInput.value = card.getAttribute('data-key');
          billingCycleSelected = true;
          updateSubmitState();
          updatePriceDisplay(card);
          updateAllPeriodPrices();
        }

        function updateSubmitState() {
          if (!proceedPlanButton) return;
          var planOk = !!(selectedPlanInput.value && selectedPlanInput.value.trim());
          var cycleOk = !hasBillingCards || billingCycleSelected;
          proceedPlanButton.disabled = !(planOk && cycleOk);
        }

        function updateSchoolSizeNotice() {
          if (!schoolSizeNotice || !schoolSizeRate || !schoolSizeThreshold || !schoolSizeFree) return;
          var selectedCard = document.querySelector('.plan-card.selected');
          if (!selectedCard) {
            schoolSizeNotice.style.display = 'none';
            return;
          }

          var threshold = parseInt(selectedCard.getAttribute('data-price-free-threshold'), 10);
          var perStudentTermUsd = parseFloat(selectedCard.getAttribute('data-price-per-student')) || 0;

          if (!Number.isInteger(threshold) || threshold < 0 || perStudentTermUsd <= 0) {
            schoolSizeNotice.style.display = 'none';
            return;
          }

          schoolSizeRate.textContent = fmtLocal(perStudentTermUsd);
          schoolSizeThreshold.textContent = String(threshold);
          schoolSizeFree.textContent = String(threshold);
          schoolSizeNotice.style.display = '';
        }

        function getSelectedPlanBase() {
          var selectedCard = document.querySelector('.plan-card.selected');
          if (selectedCard) return parseFloat(selectedCard.getAttribute('data-base-usd')) || 0;
          // fallback: first plan's price
          var first = document.querySelector('.plan-card');
          if (first) return parseFloat(first.getAttribute('data-base-usd')) || 0;
          return 0;
        }

        // Update the price shown inside each period card
        function updateAllPeriodPrices() {
          var baseUsd = getSelectedPlanBase();

          periodBtns.forEach(function(card) {
            var months = parseInt(card.getAttribute('data-months')) || 1;
            var discount = parseInt(card.getAttribute('data-discount')) || 0;
            var priceEl = card.querySelector('[data-period-price]');
            if (!priceEl) return;

            if (baseUsd <= 0) {
              priceEl.innerHTML = '';
              return;
            }

            var raw = baseUsd * months;
            var final_ = discount > 0 ? raw * (1 - discount / 100) : raw;
            var perMo = final_ / months;

            if (isTrial) {
              // Trial: just show what it will cost after trial
              if (months === 1) {
                priceEl.innerHTML = fmtLocal(baseUsd) + '/mo';
              } else if (discount > 0) {
                priceEl.innerHTML = '<span class="period-price-strike">' + fmtLocal(raw) + '</span> ' + fmtLocal(final_);
              } else {
                priceEl.innerHTML = fmtLocal(final_) + ' total';
              }
            } else {
              // Normal: show full price breakdown
              if (months === 1) {
                priceEl.innerHTML = fmtLocal(baseUsd) + '/mo';
              } else if (discount > 0) {
                priceEl.innerHTML = '<span class="period-price-strike">' + fmtLocal(raw) + '</span> ' + fmtLocal(final_)
                  + '<span style="display:block;font-size:11px;color:#5f6b7a;margin-top:1px;">~' + fmtLocal(perMo) + '/mo</span>';
              } else {
                priceEl.innerHTML = fmtLocal(final_) + ' (~' + fmtLocal(perMo) + '/mo)';
              }
            }
          });

          updateDynamicBreakdown();
        }

        function updatePriceDisplay(activeCard) {
          var months = parseInt(activeCard.getAttribute('data-months')) || 1;
          var discount = parseInt(activeCard.getAttribute('data-discount')) || 0;
          var suffix = months === 1 ? '' : months === 6 ? '6 months' : months === 12 ? '1 year' : months === 24 ? '2 years' : months + ' months';

          // Update plan card prices
          if (!isTrial) {
            plans.forEach(function(card) {
              var priceDiv = card.querySelector('.plan-price');
              if (!priceDiv) return;
              var priceStrong = priceDiv.querySelector('strong');
              var captionDiv = priceDiv.querySelector('.price-caption');
              var localDiv = priceDiv.querySelector('.price-local');
              if (!priceStrong) return;

              var baseUsd = parseFloat(card.getAttribute('data-base-usd')) || 0;
              var baseLocal = parseFloat(card.getAttribute('data-base-local')) || 0;
              var localCurrency = card.getAttribute('data-local-currency') || '';

              if (months === 1) {
                priceStrong.textContent = fmtLocal(baseUsd);
                if (captionDiv) captionDiv.textContent = 'per month';
                if (localDiv) localDiv.textContent = '';
              } else {
                var originalTotal = baseUsd * months;
                var discountedTotal = discount > 0 ? originalTotal * (1 - discount / 100) : originalTotal;
                var perMonth = discountedTotal / months;
                var localTotal = baseLocal * months;
                if (discount > 0) localTotal = localTotal * (1 - discount / 100);

                if (discount > 0) {
                  priceStrong.innerHTML = '<span style="text-decoration:line-through;color:#9ca3af;font-size:0.82em;">' + fmtLocal(originalTotal) + '</span> ' + fmtLocal(discountedTotal);
                } else {
                  priceStrong.textContent = fmtLocal(discountedTotal);
                }
                if (captionDiv) captionDiv.textContent = 'for ' + suffix + ' (~' + fmtLocal(perMonth) + '/mo)';
                if (localDiv) localDiv.textContent = '';
              }
            });
          }

          updateDynamicBreakdown();
        }

        function toUsdLabel(value) {
          return '$' + (Number(value) || 0).toFixed(2);
        }

        function updateDynamicBreakdown() {
          plans.forEach(function(card) {
            var threshold = parseInt(card.getAttribute('data-price-free-threshold'), 10);
            var badgeEl = card.querySelector('.free-students-badge');
            if (badgeEl && Number.isInteger(threshold)) {
              badgeEl.textContent = 'First ' + threshold + ' students are free';
            }
          });
        }

        periodBtns.forEach(function(card) {
          card.addEventListener('click', function() { selectPeriod(this); });
          card.addEventListener('keydown', function(e) {
            if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); selectPeriod(this); }
          });
        });

        // Initialize — no period pre-selected
        updateAllPeriodPrices();
        updateDynamicBreakdown();
        updateSchoolSizeNotice();
        // Remove initial active state so user must click
        periodBtns.forEach(function(c) { c.classList.remove('active'); c.setAttribute('aria-checked', 'false'); });

        const syncSelectionFields = (planEl) => {
          if (!planEl) return false;

          const planName = planEl.getAttribute("data-plan");
          const planId = planEl.getAttribute("data-plan-id");

          if (!planName || !planId) return false;

          selectedPlanInput.value = planName;
          selectedPlanIdInput.value = planId;
          return true;
        };

        const applySelection = (planEl) => {
          if (!planEl) return;
          plans.forEach((p) => p.classList.remove("selected"));
          planEl.classList.add("selected");
          // Store original base price before tier overrides it
          if (!planEl.getAttribute('data-original-base-usd')) {
            planEl.setAttribute('data-original-base-usd', planEl.getAttribute('data-base-usd'));
            planEl.setAttribute('data-original-base-local', planEl.getAttribute('data-base-local'));
          } else {
            // Reset to original when switching plans
            planEl.setAttribute('data-base-usd', planEl.getAttribute('data-original-base-usd'));
            planEl.setAttribute('data-base-local', planEl.getAttribute('data-original-base-local'));
          }
          syncSelectionFields(planEl);
          updateSchoolSizeNotice();
          updateSubmitState();
        };

        let selectedPlan = null;
        let selectedPlanId = null;
        const defaultPlanId = "<%= preferredPlanId || '' %>";

        if (defaultPlanId) {
          const defaultPlanEl = document.querySelector(
            `.plan-card[data-plan-id="${defaultPlanId}"]`
          );
          if (defaultPlanEl) {
            applySelection(defaultPlanEl);
            selectedPlan = defaultPlanEl.getAttribute("data-plan");
            selectedPlanId = defaultPlanId;
          }
        }

        plans.forEach((plan) => {
          plan.addEventListener("click", function () {
            applySelection(this);
            selectedPlan = this.getAttribute("data-plan");
            selectedPlanId = this.getAttribute("data-plan-id");
            updateAllPeriodPrices();
          });
        });

        form.addEventListener("submit", function (event) {
          if (!selectedPlanInput.value || !selectedPlanIdInput.value) {
            const selectedCard = document.querySelector(".plan-card.selected");
            if (selectedCard) {
              syncSelectionFields(selectedCard);
            }
          }

          if (
            !selectedPlanInput.value ||
            selectedPlanInput.value.trim() === "" ||
            !selectedPlanIdInput.value ||
            selectedPlanIdInput.value.trim() === ""
          ) {
            event.preventDefault();
            alert("⚠️ Please select a service plan before proceeding.");            return;
          }

          if (hasBillingCards && (!periodInput.value || periodInput.value.trim() === '')) {
            event.preventDefault();
            alert("\u26a0\ufe0f Please select a billing cycle before proceeding.");
            return;
          }

          if (approxInput) {
            approxInput.value = '';
          }
        });

        if (proceedPlanButton) {
          proceedPlanButton.addEventListener("click", function () {
            if (trialRequestedField) {
              trialRequestedField.value = "";
            }
          });
        }

        if (startTrialButton && !startTrialButton.disabled) {
          startTrialButton.addEventListener("click", function () {
            if (!premiumPlanId || !premiumPlanName) {
              alert("Premium plan is unavailable. Please select a plan to continue.");
              return;
            }
            const premiumPlanEl = document.querySelector(
              `.plan-card[data-plan-id="${premiumPlanId}"]`
            );
            if (premiumPlanEl) {
              applySelection(premiumPlanEl);
            }
            if (!selectedPlanInput.value || !selectedPlanIdInput.value) {
              selectedPlanInput.value = premiumPlanName;
              selectedPlanIdInput.value = premiumPlanId;
            }
            if (trialRequestedField) {
              trialRequestedField.value = "1";
            }
            form.submit();
          });
        }
      })();
    </script>
  </body>
</html>
