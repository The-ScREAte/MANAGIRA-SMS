</div>

    <div id="imageLightbox" class="image-lightbox" aria-hidden="true" role="dialog" aria-label="Image preview">
      <button type="button" id="imageLightboxClose" class="image-lightbox-close" aria-label="Close image preview">&times;</button>
      <img id="imageLightboxImg" alt="Expanded preview" />
    </div>

    <script>
        document.addEventListener("DOMContentLoaded", function () {
        const toggleButton = document.getElementById("toggle-upload-content-form");
        const uploadContentForm = document.getElementById("uploadContentForm");
        const closeButton = document.getElementById("closeUploadForm");

        function hideForm() {
            uploadContentForm.style.display = "none";
          toggleButton.innerHTML = "<i class='fa-regular fa-square-plus'></i>Upload Image";
        }

        function showForm() {
            uploadContentForm.style.display = "block";
            toggleButton.innerHTML = "<i class='fa-solid fa-ban'></i>Cancel Upload";
        }

        toggleButton.addEventListener("click", function () {
            if (uploadContentForm.style.display === "none" || uploadContentForm.style.display === "") {
                showForm();
            } else {
                hideForm();
            }
        });

        closeButton.addEventListener("click", function () {
            hideForm();
        });
        });

        document.addEventListener("DOMContentLoaded", function () {
        const toggleButton = document.getElementById("toggle-upload-text-form");
        const uploadTextForm = document.getElementById("uploadTextForm");
        const closeButton = document.getElementById("closeUploadTextForm");

        function hideTextForm() {
            uploadTextForm.style.display = "none";
          toggleButton.innerHTML = "<i class='fa-regular fa-square-plus'></i>Add Article";
        }

        function showTextForm() {
            uploadTextForm.style.display = "block";
            toggleButton.innerHTML = "<i class='fa-solid fa-ban'></i>Cancel Upload";
        }

        toggleButton.addEventListener("click", function () {
            if (uploadTextForm.style.display === "none" || uploadTextForm.style.display === "") {
                showTextForm();
            } else {
                hideTextForm();
            }
        });

        closeButton.addEventListener("click", function () {
            hideTextForm();
        });
        });


        document.addEventListener('DOMContentLoaded', function() {
        const contentTypeSelect = document.getElementById('contentType');
        const fileUploadContainer = document.getElementById('fileUploadContainer');
        const addMoreFilesBtn = document.getElementById('addMoreFilesBtn');

        contentTypeSelect.addEventListener('change', function () {
            fileUploadContainer.innerHTML = '';
            const isSlideShow = contentTypeSelect.value === 'slideshow';
            const isSiteImage = contentTypeSelect.value === 'siteImage';

            // Show "Add More Images" button for both slideshow and site image
            addMoreFilesBtn.style.display = (isSlideShow || isSiteImage) ? 'inline-block' : 'none';

            // Add initial fields
            addFileUploadField();
            if (isSlideShow) addFileUploadField(); // Add second field for slideshows by default
        });

        addMoreFilesBtn.addEventListener('click', addFileUploadField);

        function addFileUploadField() {
            const fieldHTML = `
                <div class="file-upload-field">
                    <label>Choose File:</label>
                    <input type="file" name="slideshowImages" accept="image/*,video/*" required>
                    <button type="button" class="removeFileBtn" onclick="removeFileField(this)">Remove</button>
                    <label>Caption:</label>
                    <input type="text" name="fileTexts" placeholder="Enter caption for this file" required>
                </div>`;
            fileUploadContainer.insertAdjacentHTML('beforeend', fieldHTML);
        }

        window.removeFileField = function (button) {
            const fileFields = document.querySelectorAll('.file-upload-field');
            // Prevent removing the last field - always keep at least one
            if (fileFields.length > 1) {
                button.closest('.file-upload-field').remove();
            } else {
                alert('You must have at least one file upload field.');
            }
        };
        
        const contentUploadForm = document.getElementById('contentUploadForm');
        if (contentUploadForm) {
          contentUploadForm.addEventListener('submit', function(e) {
            if (contentTypeSelect.value === 'slideshow') {
              const fileInputs = fileUploadContainer.querySelectorAll('input[type="file"]');
              if (fileInputs.length < 2) {
                e.preventDefault();
                alert('Please upload at least two images or videos for the slideshow.');
              }
            }
          });
        }
        });

        function toggleForm() {
            const forms = document.getElementById('createForms');
            const button = document.getElementById('toggle-create-event-announcement');
            if (forms.style.display === 'none' || forms.style.display === '') {
                forms.style.display = 'block'; // Show the forms
                button.innerText = 'Cancel Creation';
            } else {
                forms.style.display = 'none'; // Hide the forms
                button.innerText = 'Create New Event & Announcement';
            }
        }

        document.addEventListener("DOMContentLoaded", function () {
            // Toggle Create Event Form
            const toggleEventFormButton = document.getElementById("toggle-create-event-form");
            const createEventForm = document.getElementById("createEventForm");
            const closeEventButton = document.getElementById("closeCreateEventForm");

            function hideEventForm() {
                createEventForm.style.display = "none";
                toggleEventFormButton.innerHTML = "<i class='fa-regular fa-square-plus'></i>Create";
            }

            function showEventForm() {
                createEventForm.style.display = "block";
                toggleEventFormButton.innerHTML = "<i class='fa-solid fa-ban'></i>Cancel";
            }

            toggleEventFormButton.addEventListener("click", function () {
                if (createEventForm.style.display === "none" || createEventForm.style.display === "") {
                    showEventForm();
                } else {
                    hideEventForm();
                }
            });

            closeEventButton.addEventListener("click", function () {
                hideEventForm();
            });

            // Toggle Create Announcement Form
            const toggleAnnouncementFormButton = document.getElementById("toggle-create-announcement-form");
            const createAnnouncementForm = document.getElementById("createAnnouncementForm");
            const closeAnnouncementButton = document.getElementById("closeCreateAnnouncementForm");

            function hideAnnouncementForm() {
                createAnnouncementForm.style.display = "none";
                toggleAnnouncementFormButton.innerHTML = "<i class='fa-regular fa-square-plus'></i>Create";
            }

            function showAnnouncementForm() {
                createAnnouncementForm.style.display = "block";
                toggleAnnouncementFormButton.innerHTML = "<i class='fa-solid fa-ban'></i>Cancel";
            }

            toggleAnnouncementFormButton.addEventListener("click", function () {
                if (createAnnouncementForm.style.display === "none" || createAnnouncementForm.style.display === "") {
                    showAnnouncementForm();
                } else {
                    hideAnnouncementForm();
                }
            });

            closeAnnouncementButton.addEventListener("click", function () {
                hideAnnouncementForm();
            });
        });


        // Dynamic Theme Preview - Update button colors when theme is selected
        document.addEventListener('DOMContentLoaded', function() {
            const themeRadios = document.querySelectorAll('.theme-radio');
            const themeColorMap = {
                'classic': { primary: '#01535b', hover: '#014a51' },
                'modern': { primary: '#2563eb', hover: '#1d4ed8' },
                'green': { primary: '#2d5f4f', hover: '#245043' },
                'minimal': { primary: '#7c3aed', hover: '#6d28d9' },
                'indigo': { primary: '#4338ca', hover: '#312e81' },
                'rose': { primary: '#8b2635', hover: '#7a212e' },
                'amber': { primary: '#d97706', hover: '#b45309' },
              'yellow': { primary: '#eab308', hover: '#ca8a04' },
                'slate': { primary: '#334155', hover: '#1e293b' }
            };

            themeRadios.forEach(radio => {
                radio.addEventListener('change', function() {
                    const selectedTheme = this.value;
                    const colors = themeColorMap[selectedTheme];
                    
                    if (colors) {
                      // Update core page variables
                      document.documentElement.style.setProperty('--primary', colors.primary);
                      document.documentElement.style.setProperty('--primary-hover', colors.hover);
                      document.documentElement.style.setProperty('--primary-light', `${colors.primary}1a`);

                        // Update CSS variables for immediate preview
                        document.documentElement.style.setProperty('--org-primary-color', colors.primary);
                        document.documentElement.style.setProperty('--org-primary-hover', colors.hover);
                        
                        // Also update button-related variables that reference org colors
                        document.documentElement.style.setProperty('--btn-primary-bg', colors.primary);
                        document.documentElement.style.setProperty('--btn-primary-bg-hover', colors.hover);
                        document.documentElement.style.setProperty('--btn-secondary-bg-hover', colors.primary);
                        document.documentElement.style.setProperty('--btn-secondary-border', colors.primary);
                        document.documentElement.style.setProperty('--btn-secondary-text', colors.primary);
                        document.documentElement.style.setProperty('--link-color', colors.primary);
                        document.documentElement.style.setProperty('--link-hover-color', colors.hover);
                        document.documentElement.style.setProperty('--accent-bg', colors.primary);
                        
                        console.log('Theme changed to:', selectedTheme, 'Colors:', colors);
                    }
                });
            });
        });


        const simpleQuillToolbar = [
          ['bold', 'italic', 'underline'],
          [{ 'list': 'ordered' }, { 'list': 'bullet' }],
          ['link', 'clean']
        ];

        const articleEditors = [];

        function syncEditorValue(editor, textarea) {
          if (!editor || !textarea) return { html: '', plain: '' };
          const html = editor.root.innerHTML;
          const plain = editor.getText().trim();
          textarea.value = html;
          return { html, plain };
        }

        function syncArticleEditorsForForm(form) {
          const formEditors = articleEditors.filter((item) => item.form === form);
          if (formEditors.length === 0) return { hasEditor: false, valid: true };

          let isValid = true;
          formEditors.forEach(({ editor, textarea }) => {
            const { plain } = syncEditorValue(editor, textarea);
            if (!plain) {
              isValid = false;
            }
          });

          return { hasEditor: true, valid: isValid };
        }

        // Initialize rich Text Editor (Add Article)
        const createArticleForm = document.querySelector('form[action="/account/addTextSection"]');
        const paragraphTextarea = document.getElementById('paragraph');
        const addArticleEditor = document.getElementById('rich-text-editor');

        if (addArticleEditor && paragraphTextarea && createArticleForm) {
          const quill = new Quill(addArticleEditor, {
            theme: 'snow',
            placeholder: 'Write article here...',
            modules: {
              toolbar: simpleQuillToolbar
            }
          });

          articleEditors.push({ form: createArticleForm, editor: quill, textarea: paragraphTextarea });

          quill.on('text-change', function() {
            syncEditorValue(quill, paragraphTextarea);
          });
        }

        // Initialize Quill for each article update form only
        document.querySelectorAll('form[action="/account/updateText"].text-content-form').forEach(form => {
          const editorDiv = form.querySelector('.rich-text-editor');
          const textarea = form.querySelector('textarea[name="paragraph"]');
          if (!editorDiv || !textarea) return;

          const quillEditor = new Quill(editorDiv, {
            theme: 'snow',
            placeholder: 'Write article here...',
            modules: {
              toolbar: simpleQuillToolbar
            }
          });

          quillEditor.root.innerHTML = textarea.value;
          articleEditors.push({ form, editor: quillEditor, textarea });

          quillEditor.on('text-change', function() {
            syncEditorValue(quillEditor, textarea);
          });
        });

        // Collapsible content/theme sections (mobile defaults collapsed)
        document.addEventListener('DOMContentLoaded', function () {
            const containers = document.querySelectorAll('.manage-public-container .content-container, .manage-public-container .theme-panel');

            containers.forEach((container) => {
              const toggleBtn = container.querySelector('.section-collapse-toggle');
              if (!toggleBtn) return;
              const collapsedClass = container.classList.contains('theme-panel') ? 'is-collapsed' : 'is-collapsed';

              const setCollapsed = (collapsed) => {
                container.classList.toggle(collapsedClass, collapsed);
                toggleBtn.textContent = collapsed ? 'Expand' : 'Collapse';
                toggleBtn.setAttribute('aria-expanded', collapsed ? 'false' : 'true');
              };

              setCollapsed(true);

              toggleBtn.addEventListener('click', function () {
                const collapsed = container.classList.contains('is-collapsed');
                setCollapsed(!collapsed);
              });
            });
        });

          // Async interactions for this page only (no full-page reload)
          document.addEventListener('DOMContentLoaded', function () {
            const pageRoot = document.querySelector('.manage-public-page');
            if (!pageRoot) return;

            const lightbox = document.getElementById('imageLightbox');
            const lightboxImg = document.getElementById('imageLightboxImg');
            const lightboxClose = document.getElementById('imageLightboxClose');

            function openLightbox(source) {
              if (!lightbox || !lightboxImg || !source) return;
              lightboxImg.src = source;
              lightbox.classList.add('show');
              lightbox.setAttribute('aria-hidden', 'false');
              document.body.style.overflow = 'hidden';
            }

            function closeLightbox() {
              if (!lightbox || !lightboxImg) return;
              lightbox.classList.remove('show');
              lightbox.setAttribute('aria-hidden', 'true');
              lightboxImg.removeAttribute('src');
              document.body.style.overflow = '';
            }

            pageRoot.querySelectorAll('.image-content-form img').forEach((previewImage) => {
              previewImage.classList.add('image-preview-trigger');
              previewImage.setAttribute('role', 'button');
              previewImage.setAttribute('tabindex', '0');
              previewImage.setAttribute('aria-label', 'Tap to preview full image');
            });

            pageRoot.addEventListener('click', function (event) {
              const tappedImage = event.target.closest('.image-content-form img');
              if (!tappedImage) return;
              openLightbox(tappedImage.currentSrc || tappedImage.src);
            });

            pageRoot.addEventListener('keydown', function (event) {
              const focusedImage = event.target.closest('.image-content-form img.image-preview-trigger');
              if (!focusedImage) return;
              if (event.key !== 'Enter' && event.key !== ' ') return;
              event.preventDefault();
              openLightbox(focusedImage.currentSrc || focusedImage.src);
            });

            if (lightboxClose) {
              lightboxClose.addEventListener('click', closeLightbox);
            }

            if (lightbox) {
              lightbox.addEventListener('click', function (event) {
                if (event.target === lightbox) {
                  closeLightbox();
                }
              });
            }

            document.addEventListener('keydown', function (event) {
              if (event.key === 'Escape') {
                closeLightbox();
              }
            });

            const statusEl = document.createElement('div');
            statusEl.className = 'inline-status';
            document.body.appendChild(statusEl);

            function closeActionMenus(exceptMenu) {
              pageRoot.querySelectorAll('.action-menu').forEach((menu) => {
                if (exceptMenu && menu === exceptMenu) return;
                const toggle = menu.querySelector('.action-menu-toggle');
                const dropdown = menu.querySelector('.action-menu-dropdown');
                if (toggle) toggle.setAttribute('aria-expanded', 'false');
                if (dropdown) dropdown.hidden = true;
              });
            }

            pageRoot.addEventListener('click', function (event) {
              const toggle = event.target.closest('.action-menu-toggle');
              if (toggle) {
                event.preventDefault();
                event.stopPropagation();
                const menu = toggle.closest('.action-menu');
                const dropdown = menu ? menu.querySelector('.action-menu-dropdown') : null;
                if (!menu || !dropdown) return;
                const isOpen = !dropdown.hidden;
                closeActionMenus(menu);
                dropdown.hidden = isOpen;
                toggle.setAttribute('aria-expanded', isOpen ? 'false' : 'true');
                return;
              }

              if (!event.target.closest('.action-menu')) {
                closeActionMenus();
              }
            });

            document.addEventListener('keydown', function (event) {
              if (event.key === 'Escape') {
                closeActionMenus();
              }
            });

            function showStatus(message, type) {
              statusEl.textContent = message;
              statusEl.className = `inline-status ${type} show`;
              setTimeout(() => {
                statusEl.classList.remove('show');
              }, 1800);
            }

            function setElementLoading(element, loading) {
              if (!element) return;
              if (loading) {
                if (!element.dataset.originalHtml) {
                  element.dataset.originalHtml = element.innerHTML;
                }
                if (!element.dataset.originalWidth) {
                  const width = element.getBoundingClientRect().width;
                  element.dataset.originalWidth = String(Math.ceil(width));
                  element.style.minWidth = `${Math.ceil(width)}px`;
                }
                element.classList.add('inline-action-loading');
                if ('disabled' in element) element.disabled = true;
              } else {
                element.classList.remove('inline-action-loading');
                if ('disabled' in element) element.disabled = false;
                if (element.dataset.originalHtml) {
                  element.innerHTML = element.dataset.originalHtml;
                }
                element.style.removeProperty('min-width');
              }
            }

            async function sendFormAsync(form, submitter) {
              const method = (form.getAttribute('method') || 'POST').toUpperCase();
              const formData = new FormData(form);
              const response = await fetch(form.action, {
                method,
                body: formData,
                credentials: 'same-origin',
                headers: {
                  'X-Requested-With': 'XMLHttpRequest'
                }
              });

              if (!response.ok) {
                throw new Error(`Request failed (${response.status})`);
              }

              if (submitter && submitter.classList.contains('delete-link')) {
                const card = submitter.closest('.image-content-form, .text-content-form');
                if (card) card.remove();
              }

              return response;
            }

            pageRoot.addEventListener('submit', async function (event) {
              const form = event.target;
              if (!(form instanceof HTMLFormElement)) return;

              event.preventDefault();

              if (form.matches('form[action="/account/addTextSection"], form[action="/account/updateText"]')) {
                const { hasEditor, valid } = syncArticleEditorsForForm(form);
                if (hasEditor && !valid) {
                  showStatus('Article content cannot be empty.', 'error');
                  return;
                }
              }

              const submitter = event.submitter || form.querySelector('button[type="submit"], input[type="submit"]');
              setElementLoading(submitter, true);

              try {
                await sendFormAsync(form, submitter);
                showStatus('Saved successfully', 'success');
                // Reload the page after a short delay so the user sees the updated content
                setTimeout(() => { window.location.reload(); }, 1200);
              } catch (error) {
                showStatus('Action failed. Try again.', 'error');
              } finally {
                setElementLoading(submitter, false);
              }
            }, true);

            pageRoot.addEventListener('click', async function (event) {
              const link = event.target.closest('a.delete-link');
              if (!link) return;

              event.preventDefault();

              setElementLoading(link, true);
              try {
                const response = await fetch(link.href, {
                  method: 'GET',
                  credentials: 'same-origin',
                  headers: {
                    'X-Requested-With': 'XMLHttpRequest'
                  }
                });

                if (!response.ok) {
                  throw new Error(`Delete failed (${response.status})`);
                }

                const card = link.closest('.image-content-form, .text-content-form');
                if (card) card.remove();
                showStatus('Deleted successfully', 'success');
              } catch (error) {
                showStatus('Delete failed. Try again.', 'error');
                setElementLoading(link, false);
                return;
              }

              setElementLoading(link, false);
            });
          });
    </script>


</body>
</html>
