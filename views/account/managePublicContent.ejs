            </div>
        </div>
        
        <!-- About Us Section -->
        <div class="content-container">
            <div class="images-header" style="justify-content: center;">
            <h2>📖 About Our School</h2>
            <button type="button" class="section-collapse-toggle" aria-expanded="true">Collapse</button>
            </div>
            <form id="aboutUsForm" action="/account/update-about-us" method="POST" style="max-width: 700px; margin: 0 auto;">
                <input type="hidden" name="organization_id" value="<%= orgDetails.organization_id %>">

                <!-- About Us Field -->
                <div style="margin-bottom: 20px;">
              <label for="aboutUs" style="display: block; margin-bottom: 8px; font-weight: bold;">About Our School:</label>
                    <textarea id="aboutUs" name="aboutUs" rows="5" required style="width: 100%; padding: 10px; border: 1px solid #ccc; border-radius: 5px; font-size: 14px; resize: vertical;"><%= orgDetails.aboutus ? orgDetails.aboutus : '' %></textarea>
