            <!-- Announcements List -->
            <div class="announcements-container">
                <% if (announcements.length === 0) { %>
                    <div class="empty-state" style="grid-column: 1 / -1;">
                        <p>No announcements have been posted yet. Click "Create Announcement" to get started!</p>
