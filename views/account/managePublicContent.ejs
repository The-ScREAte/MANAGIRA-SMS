<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Manage Public Content</title>
<style>
  <%
    const themeColor = (typeof session !== 'undefined' && session && session.themeColor) ? session.themeColor : 'teal';
    const themeColors = {
      teal: { primary: '#01535b', hover: '#014a51' },
      blue: { primary: '#2563eb', hover: '#1d4ed8' },
      green: { primary: '#2d5f4f', hover: '#245043' },
      purple: { primary: '#7c3aed', hover: '#6d28d9' },
      indigo: { primary: '#4338ca', hover: '#312e81' },
      rose: { primary: '#8b2635', hover: '#7a212e' },
      amber: { primary: '#d97706', hover: '#b45309' },
      yellow: { primary: '#eab308', hover: '#ca8a04' },
      slate: { primary: '#334155', hover: '#1e293b' },
      classic: { primary: '#01535b', hover: '#014a51' },
      bold: { primary: '#0b1020', hover: '#ffb703' },
      modern: { primary: '#2563eb', hover: '#1d4ed8' },
      minimal: { primary: '#7c3aed', hover: '#6d28d9' },
      gold: { primary: '#d4a017', hover: '#b8860b' },
      red: { primary: '#e11d48', hover: '#be123c' },
      brown: { primary: '#7c4a03', hover: '#5c3802' }
    };
    const currentTheme = themeColors[themeColor] || themeColors.teal;
  %>
  :root {
    --font-family: "<%= (session && session.fontStyle ? String(session.fontStyle).trim() : 'Inter') %>", -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    --primary: <%= currentTheme.primary %>;
    --primary-hover: <%= currentTheme.hover %>;
    --primary-light: <%= currentTheme.primary %>1a;
    --org-primary-color: <%= currentTheme.primary %>;
    --org-primary-hover: <%= currentTheme.hover %>;
    --border: #e2e8f0;
    --bg-page: #f8fafc;
    --bg-card: #ffffff;
    --text-primary: #1e293b;
    --text-secondary: #64748b;
  }

  * {
    box-sizing: border-box;
  }

  body {
    font-family: var(--font-family);
    margin: 0;
    padding: 0;
  }

  .manage-public-page {
    background: var(--bg-page);
    min-height: 100vh;
    padding: 24px 0 60px;
  }

  .mpc-page-header {
    background: var(--primary);
    color: white;
    padding: 56px 20px 40px;
    margin-bottom: 32px;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.1);
    position: relative;
    overflow: hidden;
  }

  .mpc-page-header::before {
    content: '';
    position: absolute;
    top: 0;
    right: 0;
    width: 300px;
    height: 300px;
    background: radial-gradient(circle, rgba(255,255,255,0.1) 0%, transparent 70%);
    border-radius: 50%;
    transform: translate(30%, -30%);
  }

  .page-header-content {
    max-width: 1200px;
    margin: 0 auto;
    position: relative;
    z-index: 1;
    text-align: center;
  }

  .mpc-page-header h1 {
    margin: 0;
    font-size: 2rem;
    font-weight: 700;
  }

  .mpc-page-header p {
    margin: 8px 0 0;
    opacity: 0.95;
    font-size: 1rem;
  }

  .manage-public-container {
    max-width: 1400px;
    width: 100%;
    margin: 0 auto;
    padding: 0 20px 40px;
    display: flex;
    flex-direction: column;
    gap: 32px;
  }

  .section-title {
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--text-primary);
    margin: 0 0 16px;
    padding-bottom: 12px;
    border-bottom: 2px solid var(--border);
  }

  .section-subtitle {
    color: var(--text-secondary);
    font-size: 0.95rem;
    font-weight: 500;
    text-align: center;
    margin: 0 0 20px;
  }

  .content-container {
    margin-bottom: 0;
    padding: 32px;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 16px;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.06);
  }

  /* Center "no content" messages */
  .images-content-container > p,
  .text-content-container > p {
    text-align: center;
    color: #666;
    font-style: italic;
    padding: 20px;
  }

  .images-header, .texts-header {
    display: flex;
    width: 100%;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 24px;
    padding-bottom: 16px;
    border-bottom: 2px solid var(--border);
  }

  .images-header h2, .texts-header h2 {
    margin: 0;
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--text-primary);
  }

  .top-panels-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
    align-items: start;
  }

  .section-collapse-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--border);
    background: #f8fafc;
    color: #334155;
    border-radius: 999px;
    padding: 6px 11px;
    font-size: 0.76rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s ease;
    line-height: 1.2;
    min-width: 82px;
    width: auto;
    flex: 0 0 auto;
    margin-left: auto;
  }

  .section-collapse-toggle:hover {
    border-color: var(--primary);
    color: var(--primary);
    background: #ffffff;
  }

  .theme-panel-header .section-collapse-toggle {
    margin-top: 10px;
  }

  .content-container.is-collapsed > :not(.images-header):not(.texts-header) {
    display: none !important;
  }

  .theme-panel.is-collapsed > :not(.theme-panel-header) {
    display: none !important;
  }

  .images-content-container {
    width: 100%;
  }

  .standalone-images {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px;
    padding: 10px 4px 10px 0;
    align-items: start;
  }

  @media (max-width: 1280px) {
    .standalone-images {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 768px) {
    .standalone-images {
      grid-template-columns: 1fr;
    }
  }

  .image-content-form {
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    align-items: center;
    width: 100%;
    min-height: 460px;
    border: 1px solid var(--border);
    border-radius: 16px;
    padding: 20px;
    background: var(--bg-card);
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.06);
    box-sizing: border-box;
    transition: all 0.3s ease;
  }

  .image-content-form:hover {
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.1);
    transform: translateY(-2px);
  }

  .image-content-form img {
    width: 100%; /* Full width of the container */
    height: 150px; /* Fixed height */
    object-fit: cover; /* Ensures the image is cropped to fit the container */
    border-radius: 5px;
    margin-bottom: 15px;
  }

  .image-content-form label, .text-content-form label {
    display: block;
    width: 100%;
    margin: 12px 0 6px;
    font-weight: 600;
    color: var(--text-primary);
    font-size: 0.875rem;
  }

  .image-content-form input[type="text"],
  .image-content-form select,
  .text-content-form input[type="text"],
  .text-content-form select,
  .text-content-form textarea {
    width: 100%;
    padding: 10px 12px;
    margin-bottom: 12px;
    border: 2px solid var(--border);
    border-radius: 8px;
    font-size: 0.95rem;
    font-family: inherit;
    transition: border-color 0.2s;
  }

  .image-content-form input[type="text"]:focus,
  .image-content-form select:focus,
  .text-content-form input[type="text"]:focus,
  .text-content-form select:focus,
  .text-content-form textarea:focus {
    outline: none;
    border-color: var(--primary);
    box-shadow: 0 0 0 3px var(--primary-light);
  }

  .btn, .image-content-form button, .text-content-form button {
    padding: 12px 24px;
    background: var(--primary);
    color: white;
    border: none;
    border-radius: 10px;
    cursor: pointer;
    transition: all 0.2s ease;
    font-weight: 600;
    font-size: 0.95rem;
    box-shadow: 0 4px 12px var(--primary-light);
  }

  .btn:hover, .image-content-form button:hover, .text-content-form button:hover {
    background: var(--primary-hover);
    transform: translateY(-2px);
    box-shadow: 0 6px 20px var(--primary-light);
  }

  .btn-primary {
    background: var(--primary) !important;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    text-decoration: none;
    padding: 12px 24px;
    border-radius: 10px;
    font-weight: 600;
    color: white !important;
    transition: all 0.2s ease;
    box-shadow: 0 4px 12px var(--primary-light);
  }

  .btn-primary:hover {
    background: var(--primary-hover) !important;
    transform: translateY(-2px);
    box-shadow: 0 6px 20px var(--primary-light);
  }

  .delete-link {
    margin-top: 12px;
    color: #ef4444;
    text-decoration: none;
    font-size: 0.95rem;
    font-weight: 600;
    padding: 10px 16px;
    border-radius: 8px;
    width: 100%;
    transition: all 0.2s ease;
    text-align: center;
    display: block;
    border: 2px solid #fee2e2;
  }

  .delete-link:hover {
    text-decoration: none;
    background: #ef4444;
    border-color: #ef4444;
    color: white;
    transform: translateY(-1px);
    box-shadow: 0 4px 12px rgba(239, 68, 68, 0.3);
  }

  .slideshow-images {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px;
    padding: 10px 4px 10px 0;
    max-height: none;
    align-items: start;
  }

  @media (max-width: 1280px) {
    .slideshow-images {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 768px) {
    .slideshow-images {
      grid-template-columns: 1fr;
    }
  }



  .text-content-container {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px;
    padding: 10px 4px 10px 0;
    max-height: none;
    align-items: start;
  }

  @media (max-width: 1280px) {
    .text-content-container {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 768px) {
    .text-content-container {
      grid-template-columns: 1fr;
    }
  }

  /* Events and Announcements use the same grid */
  .events-container,
  .announcements-container {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px;
    padding: 10px 4px 10px 0;
    align-items: start;
  }

  @media (max-width: 1280px) {
    .events-container,
    .announcements-container {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 768px) {
    .events-container,
    .announcements-container {
      grid-template-columns: 1fr;
    }
  }

  /* Layout Selector Styles */
  .layout-option {
    border: 2px solid var(--border);
    border-radius: 12px;
    padding: 14px;
    background: var(--bg-card);
    cursor: pointer;
    transition: all 0.3s ease;
    display: block;
    position: relative;
  }

  .layout-option:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.08);
    border-color: var(--primary);
  }

  .layout-option.selected {
    border-color: var(--primary);
    background: var(--primary-light);
    box-shadow: 0 8px 24px var(--primary-light);
  }

  .layout-option:has(input:checked) {
    border-color: var(--primary);
    background: var(--primary-light);
    box-shadow: 0 8px 24px var(--primary-light);
  }

  .layout-option input[type="radio"] {
    cursor: pointer;
  }

  .layout-option-row {
    display: flex;
    gap: 10px;
    align-items: flex-start;
  }

  .layout-option-meta {
    flex: 1;
    min-width: 0;
  }

  .layout-title {
    font-weight: 700;
    font-size: 1.05rem;
    color: var(--text-primary);
    margin-bottom: 4px;
  }

  .layout-subtitle {
    color: var(--text-secondary);
    font-size: 0.8rem;
    line-height: 1.4;
    margin-bottom: 6px;
  }

  .layout-preview {
    width: 100%;
    max-width: 160px;
    border: 1px solid #d9e1ec;
    border-radius: 10px;
    background: #f8fafc;
    padding: 6px;
    display: grid;
    gap: 4px;
  }

  .layout-block {
    border-radius: 6px;
    min-height: 10px;
    background: linear-gradient(135deg, #dbe8ff 0%, #c8dbff 100%);
    border: 1px solid #c4d5f4;
  }

  .layout-block.hero { min-height: 18px; }
  .layout-block.gallery,
  .layout-block.articles,
  .layout-block.events,
  .layout-block.announcements,
  .layout-block.about { min-height: 10px; }

  .layout-block.accent {
    background: linear-gradient(135deg, #d2f0e8 0%, #b9e4d8 100%);
    border-color: #afd7ca;
  }

  .layout-block.soft {
    background: linear-gradient(135deg, #e5ecf8 0%, #dbe4f4 100%);
    border-color: #cfd8eb;
  }

  .layout-preview.wf2 {
    grid-template-columns: 1.3fr 1fr;
    grid-template-areas:
      "hero hero"
      "gallery events"
      "articles articles"
      "about about";
  }

  .layout-preview.wf2 .hero { grid-area: hero; }
  .layout-preview.wf2 .gallery { grid-area: gallery; }
  .layout-preview.wf2 .events { grid-area: events; }
  .layout-preview.wf2 .articles { grid-area: articles; }
  .layout-preview.wf2 .about { grid-area: about; }

  .layout-preview.wf3 {
    grid-template-columns: 1.35fr 1fr;
    grid-template-areas:
      "hero hero"
      "gallery gallery"
      "articles announcements"
      "about about";
  }

  .layout-preview.wf3 .hero { grid-area: hero; }
  .layout-preview.wf3 .gallery { grid-area: gallery; }
  .layout-preview.wf3 .articles { grid-area: articles; }
  .layout-preview.wf3 .announcements { grid-area: announcements; }
  .layout-preview.wf3 .about { grid-area: about; }

  .layout-preview.wf4 .hero { width: 100%; }
  .layout-preview.wf4 .gallery { width: 92%; }
  .layout-preview.wf4 .events { width: 82%; }
  .layout-preview.wf4 .announcements { width: 72%; margin-left: auto; }
  .layout-preview.wf4 .about { width: 100%; }

  @media (max-width: 1100px) {
    .layout-preview {
      max-width: 100%;
    }
  }

  /* Layout Grid Container */
  .layout-options-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 14px;
  }

  @media (max-width: 1024px) {
    .layout-options-grid {
      grid-template-columns: 1fr;
    }
  }



  .text-content-form {
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    width: 100%;
    min-height: 280px;
    border: 1px solid var(--border);
    border-radius: 16px;
    padding: 24px;
    margin: 0;
    background: var(--bg-card);
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.06);
    box-sizing: border-box;
    transition: all 0.3s ease;
  }

  .text-content-form:hover {
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.1);
    transform: translateY(-2px);
  }

  /* ============================
     NEW: THEME PICKER (COMPACT + CLEAR)
     ============================ */
  .theme-panel {
    max-width: 1200px;
    margin: 0;
    padding: 32px;
    border: 1px solid var(--border);
    border-radius: 16px;
    background: var(--bg-card);
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.06);
  }

  .theme-panel-header {
    margin-bottom: 24px;
    padding-bottom: 16px;
    border-bottom: 2px solid var(--border);
  }

  .theme-panel-header h2 {
    margin: 0 0 8px;
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--text-primary);
  }

  .theme-panel-header p {
    margin: 0;
    color: var(--text-secondary);
    font-size: 0.95rem;
  }

  .theme-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 10px;
    align-items: start;
  }

  @media (max-width: 900px) {
    .theme-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 560px) {
    .theme-grid {
      grid-template-columns: 1fr;
    }
  }

  .theme-card {
    border: 2px solid var(--border);
    border-radius: 12px;
    padding: 14px;
    background: var(--bg-card);
    cursor: pointer;
    transition: all 0.2s ease;
    display: flex;
    gap: 10px;
    align-items: flex-start;
    min-height: 0;
  }

  .theme-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.08);
    border-color: var(--primary);
  }

  .theme-card:has(input:checked) {
    border-color: var(--primary);
    background: var(--primary-light);
    box-shadow: 0 8px 24px var(--primary-light);
  }

  .theme-radio {
    margin-top: 3px;
  }

  .theme-meta {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
  }

  .theme-title {
    font-weight: 800;
    font-size: 0.94rem;
    margin: 0 0 2px 0;
    color: #222;
    line-height: 1.25;
  }

  .theme-desc {
    margin: 0;
    color: #666;
    font-size: 0.8rem;
    line-height: 1.22;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .swatches {
    display: flex;
    gap: 6px;
    margin-top: 4px;
    margin-bottom: 3px;
    align-items: center;
    flex-wrap: wrap;
  }

  .swatch {
    width: 14px;
    height: 14px;
    border-radius: 999px;
    border: 1px solid rgba(0, 0, 0, 0.12);
  }

  .theme-foot {
    display: flex;
    justify-content: center;
    margin-top: 12px;
  }

  .theme-save-btn {
    padding: 14px 32px;
    border: 0;
    border-radius: 10px;
    background: var(--primary);
    color: #fff;
    font-weight: 700;
    font-size: 1rem;
    cursor: pointer;
    transition: all 0.2s ease;
    box-shadow: 0 4px 12px var(--primary-light);
  }

  .theme-save-btn:hover {
    background: var(--primary-hover);
    transform: translateY(-2px);
    box-shadow: 0 6px 20px var(--primary-light);
  }

  .inline-action-loading {
    position: relative;
    color: transparent !important;
    pointer-events: none;
  }

  .inline-action-loading::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    width: 16px;
    height: 16px;
    margin: -8px 0 0 -8px;
    border: 2px solid rgba(255, 255, 255, 0.45);
    border-top-color: #ffffff;
    border-radius: 50%;
    animation: inlineSpin .7s linear infinite;
  }

  .inline-action-loading.delete-link::after {
    border: 2px solid rgba(239, 68, 68, 0.25);
    border-top-color: #ef4444;
  }

  @keyframes inlineSpin {
    to { transform: rotate(360deg); }
  }

  .inline-status {
    position: fixed;
    right: 20px;
    top: 18px;
    z-index: 9999;
    padding: 10px 14px;
    border-radius: 10px;
    color: #fff;
    font-size: 0.88rem;
    font-weight: 600;
    box-shadow: 0 10px 24px rgba(15, 23, 42, 0.2);
    opacity: 0;
    transform: translateY(-10px);
    transition: all .2s ease;
    pointer-events: none;
  }

  .inline-status.show {
    opacity: 1;
    transform: translateY(0);
  }

  .inline-status.success { background: #16a34a; }
  .inline-status.error { background: #dc2626; }

  /* Optional: keep your section headings from looking too huge */
  .manage-public-container h2 {
    margin: 0;
  }

  @media screen and (max-width: 768px) {
    .manage-public-page {
      padding: 10px 0 30px;
    }

    .top-panels-grid {
      grid-template-columns: 1fr;
      gap: 10px;
    }

    .layout-options-grid,
    .theme-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .theme-panel {
      padding: 12px;
      border-radius: 12px;
    }

    .theme-panel-header {
      margin-bottom: 12px;
      padding-bottom: 10px;
    }

    .theme-panel-header h2 {
      font-size: 1rem;
      margin-bottom: 4px;
    }

    .theme-panel-header p {
      font-size: 0.8rem;
    }

    .mpc-page-header {
      padding: 42px 14px 22px;
      margin-bottom: 16px;
    }

    .mpc-page-header h1 {
      font-size: 1.35rem;
    }

    .mpc-page-header p {
      font-size: 0.9rem;
    }

    .manage-public-header {
      flex-direction: column;
      padding: 10px;
      text-align: center;
    }

    .manage-public-header h1 {
      font-size: 1.3rem;
    }

    .manage-public-header .link-to-next-back {
      position: static;
      justify-content: center;
      margin-top: 10px;
    }

    .images-header,
    .texts-header {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: 8px;
      margin-bottom: 14px;
      padding-bottom: 10px;
    }

    .images-header h2,
    .texts-header h2 {
      font-size: 1.2rem;
    }

    .image-content-form,
    .text-content-form {
      width: 100%;
      min-height: 0;
      padding: 14px;
      border-radius: 12px;
    }

    .content-container {
      padding: 14px;
      border-radius: 12px;
    }

    .manage-public-container {
      padding: 0 8px 24px;
      gap: 14px;
    }

    .standalone-images,
    .slideshow-images,
    .text-content-container,
    .events-container,
    .announcements-container {
      gap: 12px;
      padding: 0;
    }

    .image-content-form img {
      height: 120px;
      margin-bottom: 10px;
    }

    .btn, .image-content-form button, .text-content-form button {
      padding: 10px 14px;
      font-size: 0.88rem;
    }

    .btn-primary,
    .section-collapse-toggle {
      padding: 8px 10px;
      font-size: 0.8rem;
    }
  }

  @media screen and (max-width: 480px) {
    .top-panels-grid {
      grid-template-columns: 1fr;
      gap: 8px;
    }

    .layout-options-grid,
    .theme-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .mpc-page-header {
      padding: 34px 12px 18px;
    }

    .mpc-page-header h1 {
      font-size: 1.2rem;
    }

    .content-container {
      padding: 12px;
    }

    .images-header h2,
    .texts-header h2 {
      font-size: 1rem;
    }

    .section-collapse-toggle {
      padding: 7px 9px;
      font-size: 0.76rem;
    }
  }

  @media screen and (max-width: 1024px) {
    .manage-public-page {
      padding-top: 28px !important;
    }

    .mpc-page-header {
      margin-top: 16px;
      padding-top: 76px !important;
    }
  }

  @media screen and (max-width: 480px) {
    .mpc-page-header {
      margin-top: 14px;
      padding-top: 62px !important;
    }
  }

  /* Tablet breakpoint */
  @media (max-width: 1200px) and (min-width: 769px) {
    .standalone-images,
    .slideshow-images,
    .text-content-container,
    .events-container,
    .announcements-container {
      gap: 20px;
    }
  }

  .text-content-container,
  .slideshow-images,
  .standalone-images {
    gap: 10px;
    padding: 5px;
  }

  .text-content-form .rich-text-editor {
    height: 150px;
  }

  .public-dashboard-link a {
    word-break: break-word;
  }

  #aboutUsForm textarea,
  #aboutUsForm input[type="text"] {
    width: 100%;
  }

  form button,
  form .delete-link {
    width: 100%;
  }

  .section-collapse-toggle {
    width: auto !important;
  }

  .text-content-form label,
  .image-content-form label {
    font-size: 0.9rem;
  }

  .image-content-form img {
    height: auto;
    max-height: 200px;
  }

  .notice {
    background-color: #e7f3fe;
    color: #0c5460;
    border: 1px solid #bee5eb;
    border-radius: 5px;
    padding: 15px;
    margin-bottom: 20px;
  }

  .notice h2 {
    font-size: 18px;
    margin: 0 0 10px;
    font-weight: bold;
  }

  /* Upload form file field styling */
  .file-upload-field {
    border: 1px solid #ddd;
    border-radius: 8px;
    padding: 15px;
    margin-bottom: 15px;
    background-color: #fff;
  }

  .file-upload-field label {
    display: block;
    margin-bottom: 5px;
    font-weight: bold;
    color: #333;
  }

  .file-upload-field input[type="file"],
  .file-upload-field input[type="text"] {
    width: 100%;
    padding: 8px;
    margin-bottom: 10px;
    border: 1px solid #ccc;
    border-radius: 4px;
    font-size: 14px;
  }

  .file-upload-field .removeFileBtn {
    background-color: #dc3545;
    color: white;
    border: none;
    padding: 5px 10px;
    border-radius: 4px;
    cursor: pointer;
    font-size: 12px;
    float: right;
  }

  .file-upload-field .removeFileBtn:hover {
    background-color: #c82333;
  }
</style>
</head>
<body class="manage-public-page">
