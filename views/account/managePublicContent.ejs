  body .mpc-page-header h1 { color: #0f172a; font-size: 1.14rem; font-weight: 800; }
  body .mpc-page-header p { color: #64748b; opacity: 1; }
  body .mpc-page-header h1 .mpc-h-icon { color: var(--org-primary-color, var(--primary)); opacity: 1; }
  .mpc-header-actions { display: flex; flex-wrap: wrap; justify-content: flex-end; gap: 8px; }
  body .mpc-page-header .mpc-view-site { color: #0f172a; background: #fff; border: 1px solid #d9dee4; border-radius: 10px; text-decoration: none; }
  body .mpc-page-header .mpc-view-site:hover { border-color: #b8c0ca; }
  body .mpc-page-header .mpc-view-site--main { color: #fff; background: var(--org-primary-color, var(--primary)); border-color: transparent; }
  body .mpc-page-header .mpc-view-site--main:hover { filter: brightness(1.05); border-color: transparent; }

  /* Every panel: the same calm card. */
  .manage-public-container > .content-container,
  .manage-public-container > .theme-panel,
  .manage-public-container > .mwo { border: 1px solid #e6e8ec; border-radius: 16px; box-shadow: none; background: #fff; }
  .manage-public-container > .content-container,
  .manage-public-container > .theme-panel { padding: 16px 18px; }
  /* Headings: an icon tile, the title, actions at the end. */
  .images-header, .texts-header, .theme-panel-header { align-items: center; gap: 10px; margin-bottom: 14px; padding-bottom: 12px; border-bottom: 1px solid #eef0f3; }
  .images-header h2, .texts-header h2, .theme-panel-header h2 { margin: 0; font-size: 1rem; font-weight: 800; color: #0f172a; letter-spacing: -.005em; }
  .manage-public-container .mpc-h-icon { display: inline-grid; place-items: center; width: 30px; height: 30px; border-radius: 9px; font-size: .86rem; color: var(--org-primary-color, var(--primary)); background: color-mix(in srgb, var(--org-primary-color, #01535b) 10%, #fff); }
  /* Collapse: a small chevron button (its text stays for screen readers). */
  .manage-public-container .section-collapse-toggle { position: relative; width: 32px; min-width: 32px; height: 32px; padding: 0; border: 1px solid #e3e7ec; border-radius: 9px; background: #fff; color: transparent; font-size: 0; overflow: hidden; cursor: pointer; flex: none; }
  .manage-public-container .section-collapse-toggle::before { content: ""; position: absolute; left: 50%; top: 50%; width: 8px; height: 8px; border-right: 2px solid #475569; border-bottom: 2px solid #475569; transform: translate(-50%, -70%) rotate(45deg); transition: transform .2s ease; }
  .manage-public-container .section-collapse-toggle[aria-expanded="false"]::before { transform: translate(-50%, -30%) rotate(-135deg); }
  .manage-public-container .section-collapse-toggle:hover { border-color: #c7ced6; }
  .manage-public-container .header-actions { display: flex; align-items: center; gap: 8px; }
  /* Notes under headings: one short line. */
  .manage-public-container .mpc-mode-note, .manage-public-container .section-subtitle, .manage-public-container .mpc-media-note { margin: 0 0 12px; font-size: .84rem; color: #64748b; }
  /* Buttons: compact, at the end of the panel. */
  .manage-public-container .theme-save-btn,
  .manage-public-container .form-actions .btn,
  .manage-public-container .form-actions .btn-primary { width: auto !important; min-height: 40px; padding: 9px 20px; border-radius: 10px; font-size: .9rem; font-weight: 700; }
  .manage-public-container .form-actions, .mpc-save-row { display: flex; justify-content: flex-end; margin-top: 14px; }
  .manage-public-container .theme-panel form > div[style*="justify-content:center"] { justify-content: flex-end !important; }

  /* Design: three groups as tabs, then the designs. */
  .mpc-tabs { display: inline-flex; flex-wrap: wrap; gap: 4px; margin: 0 0 14px; padding: 4px; border-radius: 12px; background: #f1f3f6; }
  .mpc-tab { display: inline-flex; align-items: center; gap: 8px; width: auto; margin: 0; padding: 8px 14px; border: 0; border-radius: 9px; background: transparent; color: #475569; font: inherit; font-size: .88rem; font-weight: 700; cursor: pointer; }
  .mpc-tab i { font-size: .9rem; }
  .mpc-tab em { font-style: normal; font-size: .72rem; font-weight: 800; padding: 1px 7px; border-radius: 999px; background: #e2e6eb; color: #475569; }
  .mpc-tab.is-active { background: #fff; color: #0f172a; box-shadow: 0 1px 3px rgba(15, 23, 42, .1); }
  .mpc-tab.is-active i { color: var(--org-primary-color, var(--primary)); }
  .mpc-tab.is-active em { background: color-mix(in srgb, var(--org-primary-color, #01535b) 14%, #fff); color: var(--org-primary-color, var(--primary)); }
  .mpc-tab:focus-visible { outline: 2px solid var(--org-primary-color, #01535b); outline-offset: 1px; }
  .mpc-group__note { margin: -4px 0 12px; font-size: .84rem; color: #64748b; }
  .mpc-group__hint { display: flex; flex-wrap: wrap; align-items: center; gap: 6px; margin: 12px 0 0; font-size: .84rem; color: #475569; }
  .mpc-link { width: auto; margin: 0; padding: 0; border: 0; background: none; color: var(--org-primary-color, var(--primary)); font: inherit; font-weight: 700; cursor: pointer; text-decoration: underline; text-underline-offset: 2px; }
  .manage-public-container .mpc-layouts { grid-template-columns: repeat(auto-fill, minmax(190px, 1fr)); gap: 10px; }
  .manage-public-container .mpc-layout { padding: 10px; border-radius: 14px; gap: 7px; }
  .manage-public-container .mpc-layout .layout-title { font-size: .95rem; }
  .manage-public-container .mpc-layout .layout-subtitle { font-size: .8rem; line-height: 1.4; color: #64748b; }
  .manage-public-container .mpc-layout__thumb { height: 104px; }

  /* Emblem designs' thumbnails: the chosen emblem, soft, in the school color. */
  .mpc-layout__thumb--crest, .mpc-layout__thumb--mascot, .mpc-layout__thumb--orbit { perspective: 260px; }
  .mpc-layout__thumb--crest i:nth-child(1) { left: 0; right: 0; top: 0; height: 30px; border-radius: 0; background: #374151; }
  .mpc-layout__thumb--crest i:nth-child(2) { left: 34%; right: 34%; top: 36px; height: 60px; border-radius: 0; background: var(--org-primary-color, #0f5a66); opacity: .14; -webkit-mask: var(--em) center / contain no-repeat; mask: var(--em) center / contain no-repeat; }
  .mpc-layout__thumb--crest i:nth-child(3) { left: 28%; right: 28%; top: 56px; height: 9px; background: #1f2937; }
  .mpc-layout__thumb--crest i:nth-child(4) { left: 38%; right: 38%; top: 70px; height: 5px; }
  .mpc-layout__thumb--crest i:nth-child(5) { left: 40%; width: 9%; top: 81px; height: 8px; border-radius: 999px; background: var(--org-primary-color, #0f5a66); }
  .mpc-layout__thumb--crest i:nth-child(6) { left: 51%; width: 9%; top: 81px; height: 8px; border-radius: 999px; background: #fff; border: 1px solid #d1d5db; }
  .mpc-layout__thumb--mascot i:nth-child(1) { left: 0; top: 0; bottom: 0; width: 46%; border-radius: 0; }
  .mpc-layout__thumb--mascot i:nth-child(2) { left: 18%; top: 34px; width: 34%; height: 80px; border-radius: 0; background: #fff; opacity: .22; transform: rotate(-10deg); -webkit-mask: var(--em) center / contain no-repeat; mask: var(--em) center / contain no-repeat; }
  .mpc-layout__thumb--mascot i:nth-child(3) { left: 7%; width: 30%; top: 26px; height: 10px; background: #fff; }
  .mpc-layout__thumb--mascot i:nth-child(4) { left: 7%; width: 20%; top: 42px; height: 5px; background: rgba(255, 255, 255, .7); }
  .mpc-layout__thumb--mascot i:nth-child(5) { left: 50%; right: 5%; top: 8px; height: 56px; border-radius: 6px; background: #4b5563; }
  .mpc-layout__thumb--mascot i:nth-child(6) { left: 50%; right: 5%; top: 72px; height: 22px; border-radius: 6px; background: #e5e7eb; }
  .mpc-layout__thumb--orbit { background: radial-gradient(110px 80px at 12% 0%, color-mix(in srgb, var(--org-primary-color, #0f5a66) 55%, transparent), transparent 70%), #0a0d14; border-color: #1f2430; }
  .mpc-layout__thumb--orbit i:nth-child(1) { right: 4%; top: 6px; width: 54%; height: 92px; border-radius: 0; background: #fff; opacity: .14; transform: rotateY(-35deg); transition: transform .8s cubic-bezier(.16, .84, .24, 1); -webkit-mask: var(--em) center / contain no-repeat; mask: var(--em) center / contain no-repeat; }
  .mpc-layout__thumb--orbit i:nth-child(2) { left: 8%; width: 36%; top: 26px; height: 11px; background: #fff; }
  .mpc-layout__thumb--orbit i:nth-child(3) { left: 8%; width: 24%; top: 43px; height: 4px; background: rgba(255, 255, 255, .35); }
  .mpc-layout__thumb--orbit i:nth-child(4) { left: 8%; width: 16%; top: 16px; height: 5px; border-radius: 999px; background: var(--org-primary-color, #0f5a66); }
  .mpc-layout__thumb--orbit i:nth-child(5) { left: 8%; right: 8%; top: 70px; height: 26px; border-radius: 7px; background: rgba(255, 255, 255, .08); border: 1px solid rgba(255, 255, 255, .14); }
  .mpc-layout__thumb--orbit i:nth-child(6) { display: none; }
  .mpc-layout:hover .mpc-layout__thumb--orbit i:nth-child(1) { transform: rotateY(35deg); }

  /* The emblem chooser. */
  .mpc-emblem { margin-top: 16px; padding: 16px; border: 1px solid #e6e8ec; border-radius: 14px; background: #fafbfc; }
  .mpc-emblem__top { display: flex; align-items: center; justify-content: space-between; gap: 16px; margin-bottom: 12px; }
  .mpc-emblem__intro h3 { margin: 0; font-size: .98rem; font-weight: 800; color: #0f172a; text-align: left; }
  .mpc-emblem__intro p { margin: 2px 0 0; font-size: .84rem; color: #64748b; }
  .mpc-emblem__preview { position: relative; flex: none; width: 168px; height: 92px; border-radius: 12px; overflow: hidden; background: color-mix(in srgb, var(--org-primary-color, #0f5a66) 7%, #fff); border: 1px solid color-mix(in srgb, var(--org-primary-color, #0f5a66) 18%, #fff); }
  .mpc-emblem__pattern { position: absolute; inset: 0; opacity: .14; background-color: var(--org-primary-color, #0f5a66); -webkit-mask: var(--pat) 0 0 / 46px 46px repeat; mask: var(--pat) 0 0 / 46px 46px repeat; }
  .mpc-emblem__pattern[style*="--img"] { background: var(--img) 0 0 / 34px auto space; -webkit-mask: none; mask: none; opacity: .14; }
  .mpc-emblem__preview.is-single .mpc-emblem__pattern { display: none; }
  .mpc-emblem__big { position: absolute; right: 10px; top: 50%; translate: 0 -50%; width: 70px; height: 70px; color: var(--org-primary-color, #0f5a66); opacity: .55; }
  .mpc-emblem__preview.is-single .mpc-emblem__big { right: 50%; translate: 50% -50%; opacity: .3; width: 80px; height: 80px; }
  .mpc-emblem__big svg, .mpc-emblem__big img { width: 100%; height: 100%; object-fit: contain; display: block; }
  .mpc-seg { display: inline-flex; flex-wrap: wrap; gap: 4px; margin: 0 0 12px; padding: 4px; border-radius: 11px; background: #eef1f4; }
  .mpc-seg__opt { position: relative; margin: 0; cursor: pointer; }
  .mpc-seg__opt input { position: absolute; opacity: 0; pointer-events: none; }
  .mpc-seg__opt span { display: inline-flex; align-items: center; gap: 7px; padding: 7px 12px; border-radius: 8px; font-size: .84rem; font-weight: 700; color: #475569; }
  .mpc-seg__opt input:checked + span { background: #fff; color: #0f172a; box-shadow: 0 1px 3px rgba(15, 23, 42, .1); }
  .mpc-seg__opt input:checked + span i { color: var(--org-primary-color, var(--primary)); }
  .mpc-seg__opt input:focus-visible + span { outline: 2px solid var(--org-primary-color, #01535b); outline-offset: 1px; }
  .mpc-seg__opt input:disabled + span { opacity: .45; cursor: not-allowed; }
  .mpc-seg--small { margin: 14px 0 0; }
  .mpc-emblem__sub { margin: 4px 0 8px; font-size: .74rem; font-weight: 800; letter-spacing: .08em; text-transform: uppercase; color: #64748b; }
  .mpc-emblem__grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(76px, 1fr)); gap: 8px; margin-bottom: 10px; }
  .mpc-emblem__icon { position: relative; display: grid; justify-items: center; gap: 4px; margin: 0; padding: 10px 6px 8px; border: 1px solid #e3e7ec; border-radius: 12px; background: #fff; cursor: pointer; transition: border-color .15s, box-shadow .15s; }
  .mpc-emblem__icon input { position: absolute; opacity: 0; pointer-events: none; }
  .mpc-emblem__svg { width: 36px; height: 36px; color: #334155; }
  .mpc-emblem__svg svg { width: 100%; height: 100%; display: block; }
  .mpc-emblem__name { font-size: .72rem; font-weight: 600; color: #475569; text-align: center; line-height: 1.2; }
  .mpc-emblem__icon:hover { border-color: #c7ced6; }
  .mpc-emblem__icon:has(input:checked) { border-color: var(--org-primary-color, #01535b); box-shadow: 0 0 0 2px color-mix(in srgb, var(--org-primary-color, #01535b) 22%, transparent); }
  .mpc-emblem__icon:has(input:checked) .mpc-emblem__svg { color: var(--org-primary-color, var(--primary)); }
  .mpc-emblem__icon:has(input:focus-visible) { outline: 2px solid var(--org-primary-color, #01535b); outline-offset: 2px; }
  .mpc-emblem__pane[hidden] { display: none !important; }
  .mpc-emblem__pane--row { display: flex; flex-wrap: wrap; align-items: center; gap: 10px; font-size: .86rem; color: #475569; }
  .mpc-emblem__thumb { width: 56px; height: 56px; object-fit: contain; border-radius: 10px; border: 1px solid #e3e7ec; background: #fff; padding: 4px; }
  .mpc-emblem__tip { font-size: .8rem; color: #64748b; }
  .mpc-emblem__status { margin: 10px 0 0; min-height: 1em; font-size: .84rem; font-weight: 600; color: #166534; }
  .mpc-emblem__status.is-error { color: #b91c1c; }
  .mpc-btn-ghost { display: inline-flex; align-items: center; gap: 7px; width: auto; margin: 0; padding: 8px 14px; border: 1px solid #d9dee4; border-radius: 10px; background: #fff; color: #0f172a; font: inherit; font-size: .86rem; font-weight: 700; text-decoration: none; cursor: pointer; white-space: nowrap; }
  .mpc-btn-ghost:hover { border-color: #b8c0ca; text-decoration: none; }
  .mpc-btn-ghost--brand { color: var(--org-primary-color, var(--primary)); border-color: color-mix(in srgb, var(--org-primary-color, #01535b) 40%, #fff); }

  /* Online admission: one status line (set in Admission Settings). */
  .manage-public-container > .mpc-admission { padding: 14px 18px; }
  .mpc-admission__row { display: flex; flex-wrap: wrap; align-items: center; gap: 12px 14px; }
  .mpc-admission__icon { flex: none; display: grid; place-items: center; width: 38px; height: 38px; border-radius: 11px; color: var(--org-primary-color, var(--primary)); background: color-mix(in srgb, var(--org-primary-color, #01535b) 10%, #fff); }
  .mpc-admission__text { flex: 1 1 260px; min-width: 0; display: grid; gap: 2px; }
  .mpc-admission__text strong { display: flex; align-items: center; gap: 8px; font-size: .95rem; color: #0f172a; }
  .mpc-admission__text > span { font-size: .84rem; color: #64748b; }
  .mpc-admission__actions { display: flex; flex-wrap: wrap; gap: 8px; }
  .mpc-pill { padding: 2px 9px; border-radius: 999px; font-size: .72rem; font-weight: 800; }
  .mpc-pill.is-on { background: #dcfce7; color: #166534; }
  .mpc-pill.is-off { background: #f1f5f9; color: #475569; }

  /* Photos: a tight grid of small cards, each photo shown whole. */
  .manage-public-container .slideshow-images,
  .manage-public-container .standalone-images { display: grid !important; grid-template-columns: repeat(auto-fill, minmax(168px, 1fr)) !important; gap: 10px !important; }
  .manage-public-container .slideshow-images .image-content-form,
  .manage-public-container .standalone-images .image-content-form { padding: 8px !important; border: 1px solid #e6e8ec !important; border-radius: 12px !important; background: #fff !important; box-shadow: none !important; gap: 6px; }
  .manage-public-container .slideshow-images .image-content-form img,
  .manage-public-container .standalone-images .image-content-form img,
  .manage-public-container .slideshow-images .image-content-form video,
  .manage-public-container .standalone-images .image-content-form video { width: 100% !important; height: auto !important; aspect-ratio: 4 / 3; object-fit: contain !important; border-radius: 8px !important; background: #eef1f4; }
  .manage-public-container .slideshow-images .image-content-form label,
  .manage-public-container .standalone-images .image-content-form label { margin: 4px 0 2px !important; font-size: .72rem !important; font-weight: 700; color: #64748b; }
  .manage-public-container .slideshow-images .image-content-form input[type="text"],
  .manage-public-container .slideshow-images .image-content-form select,
  .manage-public-container .standalone-images .image-content-form input[type="text"],
  .manage-public-container .standalone-images .image-content-form select { height: 34px !important; min-height: 34px !important; padding: 5px 9px !important; font-size: .82rem !important; border-radius: 8px !important; }
  .manage-public-container .slideshow-images .image-content-form button,
  .manage-public-container .standalone-images .image-content-form button { width: 100% !important; min-height: 34px !important; margin-top: 6px !important; padding: 6px 10px !important; font-size: .82rem !important; border-radius: 8px !important; background: #fff !important; color: var(--org-primary-color, var(--primary)) !important; border: 1px solid color-mix(in srgb, var(--org-primary-color, #01535b) 40%, #fff) !important; }
  .manage-public-container .slideshow-images .image-content-form button:hover,
  .manage-public-container .standalone-images .image-content-form button:hover { background: color-mix(in srgb, var(--org-primary-color, #01535b) 8%, #fff) !important; }

  /* News: two columns of compact cards. */
  .manage-public-container #mpcArticles .texts-content-container,
  .manage-public-container #mpcArticles .text-cards { gap: 12px; }
  .manage-public-container .text-content-form { padding: 12px !important; border: 1px solid #e6e8ec !important; border-radius: 12px !important; box-shadow: none !important; }
  .manage-public-container .text-content-form .ql-container { max-height: 220px; overflow: auto; }
  .manage-public-container .text-content-form button { width: auto !important; min-height: 36px; padding: 7px 16px !important; font-size: .84rem !important; }

  /* About & contact details: a full-width form with light add and remove buttons. */
  .manage-public-container #mpcAbout form { max-width: 820px; margin: 0; padding: 0; box-shadow: none; border: 0; background: transparent; }
  .manage-public-container #mpcAbout .form-group { margin-bottom: 14px; }
  .manage-public-container #mpcAbout label { display: block; margin-bottom: 6px; font-size: .82rem; font-weight: 700; color: #334155; }
  .manage-public-container .dynamic-item-row { display: flex; align-items: center; gap: 8px; margin-bottom: 6px; }
  .manage-public-container .dynamic-item-row .form-field { flex: 1; min-width: 0; margin: 0; }
  .manage-public-container .dynamic-remove-btn { flex: none; width: auto !important; min-width: 0 !important; min-height: 36px; margin: 0 !important; padding: 6px 12px !important; border-radius: 9px !important; border: 1px solid #f0caca !important; background: #fff !important; color: #b91c1c !important; font-size: .8rem !important; font-weight: 700; box-shadow: none !important; }
  .manage-public-container .mpc-add-btn { width: auto !important; min-height: 34px; margin: 4px 0 0 !important; padding: 6px 12px !important; border-radius: 9px !important; border: 1px dashed color-mix(in srgb, var(--org-primary-color, #01535b) 45%, #fff) !important; background: #fff !important; color: var(--org-primary-color, var(--primary)) !important; font-size: .82rem !important; font-weight: 700; box-shadow: none !important; }
  /* News cards: Save and Delete on one row. */
  .manage-public-container .text-content-form .form-action-row { display: flex; align-items: center; justify-content: space-between; gap: 10px; margin-top: 10px; }
  .manage-public-container .text-content-form .form-action-row > button[type="submit"] { width: auto !important; flex: none; }
  .manage-public-container .text-content-form .delete-link { font-size: .82rem; font-weight: 700; color: #b91c1c; }
  .manage-public-container .header-actions .btn-primary { display: inline-flex; align-items: center; gap: 7px; width: auto; min-height: 34px; padding: 6px 12px; border-radius: 9px; font-size: .84rem; font-weight: 700; }

  @media (max-width: 768px) {
    body .mpc-page-header .page-header-content { grid-template-columns: minmax(0, 1fr); }
    .mpc-header-actions { justify-content: flex-start; }
    .manage-public-container > .content-container,
    .manage-public-container > .theme-panel { padding: 14px; }
    .mpc-emblem__top { flex-direction: column; align-items: stretch; }
    .mpc-emblem__preview { width: 100%; height: 84px; }
    .mpc-tabs, .mpc-seg { display: flex; width: 100%; }
    .mpc-tab, .mpc-seg__opt { flex: 1 1 auto; justify-content: center; }
    .mpc-seg__opt span { width: 100%; justify-content: center; }
    .manage-public-container .slideshow-images,
    .manage-public-container .standalone-images { grid-template-columns: repeat(2, minmax(0, 1fr)) !important; }
  }
  @media (max-width: 560px) {
    .manage-public-container .mpc-layouts { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 8px; }
    .manage-public-container .mpc-layout { padding: 8px; }
    .manage-public-container .mpc-layout__thumb { height: 76px; }
    .manage-public-container .mpc-layout .layout-subtitle { display: none; }
    .manage-public-container .mpc-layout__row { flex-wrap: wrap; row-gap: 4px; }
    .manage-public-container .mpc-layout .layout-title { font-size: .9rem; }
  }

</style>
</head>
<body class="manage-public-page">
    <div class="mpc-page-header">
      <div class="page-header-content">
        <div>
          <h1><i class="fa-solid fa-globe mpc-h-icon" aria-hidden="true"></i> School website</h1>
          <p><%= orgDetails.external_website_url ? 'Families are sent to your own website.' : 'What families see when they visit your school online.' %></p>
        </div>
        <div class="mpc-header-actions">
          <% if (!orgDetails.external_website_url && typeof publicSiteUrl !== 'undefined' && publicSiteUrl) { %>
            <a class="mpc-view-site mpc-view-site--main" href="<%= publicSiteUrl %>" target="_blank" rel="noopener">View website <span aria-hidden="true">↗</span></a>
          <% } %>
          <button type="button" class="mpc-view-site" id="openWebsiteSettings"><%= orgDetails.external_website_url ? 'Website address' : 'Use my own website' %></button>
        </div>
      </div>
    </div>
    
    <%- include('../partials/flash') %>

    <dialog class="mpc-website-dialog" id="websiteSettingsDialog" aria-labelledby="websiteSettingsTitle">
