    font-size: 0.8rem;
    line-height: 1.4;
    margin-bottom: 6px;
  }

  .layout-preview {
    width: 100%;
    max-width: 160px;
    border: 1px solid #d9e1ec;
    border-radius: 10px;
    background: #f8fafc;
    padding: 6px;
    display: grid;
    gap: 4px;
  }

  .layout-block {
    border-radius: 6px;
    min-height: 10px;
    background: linear-gradient(135deg, #dbe8ff 0%, #c8dbff 100%);
    border: 1px solid #c4d5f4;
