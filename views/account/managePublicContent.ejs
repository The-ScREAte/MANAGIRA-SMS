<!DOCTYPE html>
<html lang="en">
<head>
  <link rel="stylesheet" href="/css/globalScale.css">
    <meta charset="UTF-8">
    <meta name="viewport" content="<%= locals.viewportContent || 'width=device-width, initial-scale=1.0, maximum-scale=1.0' %>">
    <title>Manage Public Content</title>
    <link href="https://cdn.jsdelivr.net/npm/quill@1.3.7/dist/quill.snow.css" rel="stylesheet" />
    <script src="https://cdn.jsdelivr.net/npm/quill@1.3.7/dist/quill.min.js"></script>
<style>
  <%
    const themeColor = (typeof session !== 'undefined' && session && session.themeColor) ? session.themeColor : 'teal';
    const themeColors = themePalette;
    const currentTheme = themeColors[themeColor] || themeColors.teal;
  %>
  :root {
    --font-family: "<%= (session && session.fontStyle ? String(session.fontStyle).trim() : 'Inter') %>", -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    --primary: <%= currentTheme.primary %>;
    --primary-hover: <%= currentTheme.hover %>;
        --primary-hover-fill: color-mix(in srgb, var(--primary) 88%, white);
    --primary-light: <%= currentTheme.primary %>1a;
    --org-primary-color: <%= currentTheme.primary %>;
    --org-primary-hover: <%= currentTheme.hover %>;
        --org-primary-hover-fill: color-mix(in srgb, var(--org-primary-color) 88%, white);
    --border: #e2e8f0;
    --bg-page: #f8fafc;
    --bg-card: #ffffff;
    --text-primary: #1e293b;
    --text-secondary: #64748b;
  }

  * {
    box-sizing: border-box;
  }

  body {
    font-family: var(--font-family);
    margin: 0;
    padding: 0;
  }

  .manage-public-page {
    background: var(--bg-page);
    min-height: 100vh;
    width: 100%;
    min-width: 0;
    overflow-x: hidden;
    padding: 20px clamp(12px, 2vw, 24px) 40px;
  }

  .mpc-page-header {
    background: var(--primary);
    color: white;
    padding: 38px 20px 24px;
    margin-bottom: 24px;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.1);
    position: relative;
    overflow: hidden;
  }

  .mpc-page-header::before {
    content: '';
    position: absolute;
    top: 0;
    right: 0;
    width: 300px;
    height: 300px;
    background: radial-gradient(circle, rgba(255,255,255,0.1) 0%, transparent 70%);
    border-radius: 50%;
    transform: translate(30%, -30%);
  }

  .page-header-content {
    max-width: none;
    margin: 0;
    position: relative;
    z-index: 1;
    text-align: center;
  }

  .mpc-header-nav {
    display: flex;
    justify-content: flex-start;
    align-items: center;
    margin-bottom: 20px;
    flex-wrap: wrap;
    gap: 10px;
  }

  .mpc-back-btn {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 8px 16px;
    border-radius: 999px;
    font-size: 0.85rem;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .mpc-back-btn {
    background: rgba(255, 255, 255, 0.15);
    color: white;
    border: 1px solid rgba(255, 255, 255, 0.35);
    backdrop-filter: blur(4px);
  }

  .mpc-back-btn:hover {
    text-decoration: none;}

  .mpc-page-header h1 {
    margin: 0;
    font-size: 1.6rem;
    font-weight: 700;
  }

  .mpc-page-header p {
    margin: 6px 0 0;
    opacity: 0.95;
    font-size: 0.92rem;
  }

  .manage-public-container {
    max-width: 1400px;
    width: 100%;
    min-width: 0;
    box-sizing: border-box;
    margin: 0 auto;
    padding: 0 clamp(12px, 2vw, 24px) 40px;
    display: flex;
    flex-direction: column;
    gap: 32px;
  }

  .section-title {
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--text-primary);
    margin: 0 0 16px;
    padding-bottom: 12px;
    border-bottom: 2px solid var(--border);
  }

  .section-subtitle {
    color: var(--text-secondary);
    font-size: 0.95rem;
    font-weight: 500;
    text-align: center;
    margin: 0 0 20px;
  }

  .content-container {
    margin-bottom: 0;
    padding: 32px;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 16px;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.06);
  }

  /* Center "no content" messages */
  .images-content-container > p,
  .text-content-container > p {
    text-align: center;
    color: #666;
    font-style: italic;
    padding: 20px;
  }

  .images-header, .texts-header {
    display: flex;
    width: 100%;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 24px;
    padding-bottom: 16px;
    border-bottom: 2px solid var(--border);
  }

  .images-header h2, .texts-header h2 {
    margin: 0;
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--text-primary);
  }

  .top-panels-grid {
    display: block;
  }

  .top-panels-grid > * {
    margin-bottom: 24px;
  }

  .top-panels-grid > *:last-child {
    margin-bottom: 0;
  }

  .section-collapse-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--border);
    background: #f8fafc;
    color: #334155;
    border-radius: 999px;
    padding: 6px 11px;
    font-size: 0.76rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s ease;
    line-height: 1.2;
    min-width: 82px;
    width: auto;
    flex: 0 0 auto;
    margin-left: auto;
  }

  

  .theme-panel-header .section-collapse-toggle {
    margin-top: 0;
    margin-left: auto;
  }

  .content-container.is-collapsed > :not(.images-header):not(.texts-header) {
    display: none !important;
  }

  .theme-panel.is-collapsed > :not(.theme-panel-header) {
    display: none !important;
  }

  .images-content-container {
    width: 100%;
  }

  .standalone-images {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
    padding: 10px 0;
    align-items: stretch;
  }

  .image-content-form {
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    align-items: center;
    width: 100%;
    min-height: 0;
    max-width: 920px;
    margin: 0 auto;
    border: 1px solid var(--border);
    border-radius: 16px;
    padding: 20px;
    background: var(--bg-card);
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.06);
    box-sizing: border-box;
    transition: all 0.3s ease;
    overflow: visible;
  }

  .image-content-form:hover {
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.1);
    transform: translateY(-2px);
  }

  .image-content-form img {
    width: 100%; /* Full width of the container */
    height: 150px; /* Fixed height */
    object-fit: cover; /* Ensures the image is cropped to fit the container */
    border-radius: 5px;
    margin-bottom: 15px;
  }

  .image-content-form img.image-preview-trigger {
    cursor: zoom-in;
  }

  .image-content-form label, .text-content-form label {
    display: block;
    width: 100%;
    margin: 12px 0 6px;
    font-weight: 600;
    color: var(--text-primary);
    font-size: 0.875rem;
  }

  .image-content-form input[type="text"],
  .image-content-form select,
  .text-content-form input[type="text"],
  .text-content-form select,
  .text-content-form textarea {
    width: 100%;
    padding: 10px 12px;
    margin-bottom: 12px;
    border: 2px solid var(--border);
    border-radius: 8px;
    font-size: 0.95rem;
    font-family: inherit;
    transition: border-color 0.2s;
  }

  .image-content-form input[type="text"]:focus,
  .image-content-form select:focus,
  .text-content-form input[type="text"]:focus,
  .text-content-form select:focus,
  .text-content-form textarea:focus {
    outline: none;
    border-color: var(--primary);
    box-shadow: 0 0 0 3px var(--primary-light);
  }

  .btn, .image-content-form button, .text-content-form button {
    padding: 10px 16px;
    background: var(--primary);
    color: white;
    border: none;
    border-radius: 10px;
    cursor: pointer;
    transition: all 0.2s ease;
    font-weight: 600;
    font-size: 0.9rem;
    box-shadow: 0 4px 12px var(--primary-light);
  }

  .btn:hover, .image-content-form button:hover, .text-content-form button:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 20px var(--primary-light);}

  .btn-primary {
    background: var(--primary) !important;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    text-decoration: none;
    padding: 10px 16px;
    border-radius: 10px;
    font-weight: 600;
    color: white !important;
    transition: all 0.2s ease;
    box-shadow: 0 4px 12px var(--primary-light);
  }

  #toggle-upload-content-form,
  #toggle-upload-text-form {
    padding: 9px 14px;
    font-size: 0.85rem;
    border-radius: 9px;
    gap: 6px;
  }

  .btn-primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 20px var(--primary-light);}

  .delete-link {
    margin-top: 12px;
    color: #ef4444;
    text-decoration: none;
    font-size: 0.95rem;
    font-weight: 600;
    padding: 12px 18px;
    border-radius: 8px;
    width: 100%;
    transition: all 0.2s ease;
    text-align: center;
    display: block;
    border: 2px solid #fee2e2;
  }

  .delete-link:hover {
    text-decoration: none;
    transform: translateY(-1px);
    box-shadow: 0 4px 12px rgba(239, 68, 68, 0.3);}

  .form-action-row {
    width: 100%;
    display: flex;
    align-items: center;
    gap: 10px;
    margin-top: 8px;
    position: relative;
    z-index: 2;
  }

  .form-action-row > button[type="submit"] {
    flex: 1;
    width: auto !important;
    margin: 0;
  }

  .action-menu {
    position: relative;
    flex: 0 0 auto;
    z-index: 3;
  }

  .action-menu-toggle {
    width: 38px !important;
    min-width: 38px;
    height: 38px;
    border-radius: 10px;
    border: 1px solid var(--border);
    background: #f8fafc;
    color: #475569;
    font-size: 1.1rem;
    font-weight: 700;
    line-height: 1;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.2s ease;
    box-shadow: none;
    padding: 0;
  }

  .action-menu-toggle[aria-expanded="true"] {
    border-color: var(--primary);
    color: var(--primary);
    background: #ffffff;
  }

  .action-menu-dropdown {
    position: absolute;
    bottom: calc(100% + 8px);
    right: 0;
    z-index: 9999;
    background: #ffffff;
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 8px;
    box-shadow: 0 10px 24px rgba(15, 23, 42, 0.15);
    min-width: 136px;
  }

  .action-menu-dropdown[hidden] {
    display: none;
  }

  .action-menu-dropdown .delete-link {
    margin: 0;
    width: 100%;
    min-width: 0;
    padding: 9px 12px;
    font-size: 0.85rem;
    border-radius: 8px;
    border-width: 1px;
    box-shadow: none;
  }

  .delete-link.delete-inline {
    flex: 0 0 auto;
    margin: 0;
    width: auto;
    min-width: 0;
    padding: 0 16px;
    height: 38px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 0.85rem;
    font-weight: 600;
    border-radius: 10px;
    border: 1px solid #fecaca;
    background: #fef2f2;
    color: #dc2626;
    text-decoration: none;
    cursor: pointer;
    transition: all 0.2s ease;
    box-shadow: none;
  }

  

  .delete-link.delete-inline[hidden] {
    display: none;
  }

  .slideshow-images {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
    padding: 10px 0;
    max-height: none;
    align-items: stretch;
  }



  .text-content-container {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
    padding: 10px 0;
    max-height: none;
    align-items: stretch;
  }

  /* Events and Announcements use the same grid */
  .events-container,
  .announcements-container {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
    padding: 10px 0;
    align-items: stretch;
  }

  .events-container .text-content-form,
  .announcements-container .text-content-form,
  .text-content-container .text-content-form {
    max-width: none;
    margin: 0;
    width: 100%;
  }

  .slideshow-images .image-content-form,
  .standalone-images .image-content-form {
    max-width: none;
    margin: 0;
    width: 100%;
  }

  /* Website layouts: every design with a drawn thumbnail (the 3D ones move on hover) */
  .mpc-layouts { display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 12px; }
  .mpc-layouts + .mpc-layouts__group { margin-top: 22px; }
  .mpc-layouts__group { display: flex; flex-wrap: wrap; align-items: baseline; gap: 4px 10px; margin: 0 0 10px; font-size: 0.92rem; }
  .mpc-layouts__group strong { color: var(--text-primary, #111827); }
  .mpc-layouts__group span { color: var(--text-secondary, #6b7280); font-size: 0.82rem; }
  .mpc-layout__badge { padding: 2px 8px; border-radius: 999px; font-size: 0.68rem; font-weight: 800; letter-spacing: .02em; color: var(--org-primary-color, var(--primary)); background: color-mix(in srgb, var(--org-primary-color, #0f5a66) 12%, transparent); white-space: nowrap; }
  .mpc-layout { display: grid; gap: 8px; align-content: start; }
  .mpc-layout__row { display: flex; align-items: center; gap: 8px; }
  .mpc-layout__row .layout-title { margin: 0; }
  .mpc-layout__current { margin-left: auto; padding: 2px 8px; border-radius: 999px; font-size: 0.7rem; font-weight: 700; background: var(--org-primary-color, var(--primary)); color: #fff; }
  .mpc-layout__preview { justify-self: start; font-size: 0.82rem; font-weight: 700; color: var(--org-primary-color, var(--primary)); text-decoration: none; }
  .mpc-layout__preview:hover { text-decoration: underline; }
  .mpc-layout__thumb { position: relative; display: block; height: 108px; border-radius: 10px; overflow: hidden; background: #ffffff; border: 1px solid #e5e7eb; }
  .mpc-layout__thumb i { position: absolute; display: block; border-radius: 3px; background: #e5e7eb; }
  .mpc-layout__thumb i:nth-child(1) { background: var(--org-primary-color, #0f5a66); }
  /* Classic: full banner, centered title, three columns */
  .mpc-layout__thumb--classic i:nth-child(1) { left: 0; right: 0; top: 0; height: 46px; border-radius: 0; opacity: .85; }
  .mpc-layout__thumb--classic i:nth-child(2) { left: 30%; right: 30%; top: 18px; height: 8px; background: #fff; }
  .mpc-layout__thumb--classic i:nth-child(3) { left: 40%; right: 40%; top: 56px; height: 5px; }
  .mpc-layout__thumb--classic i:nth-child(4) { left: 8%; width: 26%; top: 70px; height: 28px; }
  .mpc-layout__thumb--classic i:nth-child(5) { left: 37%; width: 26%; top: 70px; height: 28px; }
  .mpc-layout__thumb--classic i:nth-child(6) { left: 66%; width: 26%; top: 70px; height: 28px; }
  /* Modern: split welcome, photo on the right, cards below */
  .mpc-layout__thumb--horizon { background: #f4f6f8; }
  .mpc-layout__thumb--horizon i:nth-child(1) { right: 8%; width: 44%; top: 10px; height: 46px; border-radius: 8px; }
  .mpc-layout__thumb--horizon i:nth-child(2) { left: 8%; width: 34%; top: 16px; height: 9px; background: #1f2937; }
  .mpc-layout__thumb--horizon i:nth-child(3) { left: 8%; width: 24%; top: 32px; height: 5px; }
  .mpc-layout__thumb--horizon i:nth-child(4) { left: 8%; width: 16%; top: 44px; height: 8px; border-radius: 999px; background: var(--org-primary-color, #0f5a66); opacity: .7; }
  .mpc-layout__thumb--horizon i:nth-child(5) { left: 8%; right: 8%; top: 66px; height: 34px; background: #fff; border-radius: 6px; }
  .mpc-layout__thumb--horizon i:nth-child(6) { left: 12%; width: 30%; top: 74px; height: 5px; }
  /* Magazine: masthead, lead photo, side column */
  .mpc-layout__thumb--editorial i:nth-child(1) { left: 8%; right: 8%; top: 8px; height: 2px; border-radius: 0; background: #111827; }
  .mpc-layout__thumb--editorial i:nth-child(2) { left: 22%; right: 22%; top: 16px; height: 11px; background: #111827; }
  .mpc-layout__thumb--editorial i:nth-child(3) { left: 8%; right: 8%; top: 33px; height: 2px; border-radius: 0; background: #111827; }
  .mpc-layout__thumb--editorial i:nth-child(4) { left: 8%; width: 56%; top: 42px; height: 34px; background: var(--org-primary-color, #0f5a66); opacity: .55; }
  .mpc-layout__thumb--editorial i:nth-child(5) { right: 8%; width: 26%; top: 42px; height: 58px; background: #f3f4f6; border: 1px solid #e5e7eb; }
  .mpc-layout__thumb--editorial i:nth-child(6) { left: 8%; width: 56%; top: 82px; height: 18px; }
  /* Story: full photo opening, big title bottom-left, numbered chapter */
  .mpc-layout__thumb--story i:nth-child(1) { left: 0; right: 0; top: 0; height: 70px; border-radius: 0; background: #1f2937; }
  .mpc-layout__thumb--story i:nth-child(2) { left: 8%; width: 46%; top: 44px; height: 12px; background: #fff; }
  .mpc-layout__thumb--story i:nth-child(3) { left: 8%; width: 12%; top: 78px; height: 18px; background: var(--org-primary-color, #0f5a66); }
  .mpc-layout__thumb--story i:nth-child(4) { left: 24%; width: 44%; top: 80px; height: 7px; background: #1f2937; }
  .mpc-layout__thumb--story i:nth-child(5) { left: 24%; width: 60%; top: 92px; height: 4px; }
  .mpc-layout__thumb--story i:nth-child(6) { right: 8%; width: 10%; top: 60px; height: 3px; background: #fff; }
  /* Campus: side menu with content beside it */
  .mpc-layout__thumb--campus i:nth-child(1) { left: 0; top: 0; bottom: 0; width: 28%; border-radius: 0; background: #14181f; }
  .mpc-layout__thumb--campus i:nth-child(2) { left: 6%; width: 14%; top: 12px; height: 12px; background: #fff; }
  .mpc-layout__thumb--campus i:nth-child(3) { left: 6%; width: 16%; top: 34px; height: 4px; background: rgba(255,255,255,.4); box-shadow: 0 9px 0 rgba(255,255,255,.4), 0 18px 0 rgba(255,255,255,.4), 0 27px 0 rgba(255,255,255,.4); }
  .mpc-layout__thumb--campus i:nth-child(4) { left: 34%; width: 40%; top: 12px; height: 9px; background: #1f2937; }
  .mpc-layout__thumb--campus i:nth-child(5) { left: 34%; right: 6%; top: 28px; height: 38px; background: var(--org-primary-color, #0f5a66); opacity: .55; }
  .mpc-layout__thumb--campus i:nth-child(6) { left: 34%; right: 6%; top: 74px; height: 24px; }

  /* Spotlight: brand panel left, photo right, rows */
  .mpc-layout__thumb--spotlight i:nth-child(1) { left: 0; top: 0; width: 42%; height: 58px; border-radius: 0; }
  .mpc-layout__thumb--spotlight i:nth-child(2) { left: 42%; right: 0; top: 0; height: 58px; border-radius: 0; background: #374151; }
  .mpc-layout__thumb--spotlight i:nth-child(3) { left: 7%; width: 26%; top: 22px; height: 8px; background: #fff; }
  .mpc-layout__thumb--spotlight i:nth-child(4) { left: 8%; width: 36%; top: 68px; height: 32px; border-radius: 5px; }
  .mpc-layout__thumb--spotlight i:nth-child(5) { left: 50%; width: 40%; top: 72px; height: 6px; background: #1f2937; }
  .mpc-layout__thumb--spotlight i:nth-child(6) { left: 50%; width: 32%; top: 84px; height: 4px; }
  /* Minimal: big title, photo strip, left headings */
  .mpc-layout__thumb--minimal i:nth-child(1) { left: 8%; width: 50%; top: 12px; height: 10px; background: #1f2937; }
  .mpc-layout__thumb--minimal i:nth-child(2) { left: 8%; right: 8%; top: 30px; height: 28px; background: var(--org-primary-color, #0f5a66); opacity: .45; }
  .mpc-layout__thumb--minimal i:nth-child(3) { left: 8%; width: 18%; top: 68px; height: 5px; background: #1f2937; }
  .mpc-layout__thumb--minimal i:nth-child(4) { left: 34%; right: 8%; top: 68px; height: 4px; box-shadow: 0 8px 0 #e5e7eb, 0 16px 0 #e5e7eb; }
  .mpc-layout__thumb--minimal i:nth-child(5) { left: 8%; right: 8%; top: 64px; height: 1px; background: #d1d5db; }
  .mpc-layout__thumb--minimal i:nth-child(6) { display: none; }
  /* Mosaic: tiles */
  .mpc-layout__thumb--mosaic { background: #f3f4f6; }
  .mpc-layout__thumb--mosaic i:nth-child(1) { left: 66%; right: 6%; top: 8px; height: 54px; border-radius: 6px; }
  .mpc-layout__thumb--mosaic i:nth-child(2) { left: 6%; width: 57%; top: 8px; height: 54px; border-radius: 6px; background: #374151; }
  .mpc-layout__thumb--mosaic i:nth-child(3) { left: 6%; width: 42%; top: 68px; height: 32px; border-radius: 6px; background: #fff; }
  .mpc-layout__thumb--mosaic i:nth-child(4) { left: 52%; width: 42%; top: 68px; height: 32px; border-radius: 6px; background: #fff; }
  .mpc-layout__thumb--mosaic i:nth-child(5) { left: 10%; width: 20%; top: 76px; height: 5px; }
  .mpc-layout__thumb--mosaic i:nth-child(6) { left: 56%; width: 20%; top: 76px; height: 5px; }
  /* Academy: full photo opening with a bar on top, three next-step tiles, dark stats band */
  .mpc-layout__thumb--academy i:nth-child(1) { left: 0; right: 0; top: 0; height: 8px; border-radius: 0; background: var(--org-primary-color, #0f5a66); }
  .mpc-layout__thumb--academy i:nth-child(2) { left: 0; right: 0; top: 8px; height: 56px; border-radius: 0; background: #1f2937; }
  .mpc-layout__thumb--academy i:nth-child(3) { left: 8%; width: 44%; top: 38px; height: 10px; background: #fff; }
  .mpc-layout__thumb--academy i:nth-child(4) { left: 8%; width: 26%; top: 70px; height: 14px; background: #fff; border: 1px solid #e5e7eb; box-shadow: 36px 0 0 #fff, 72px 0 0 #fff; }
  .mpc-layout__thumb--academy i:nth-child(5) { left: 8%; width: 12%; top: 52px; height: 7px; background: var(--org-primary-color, #0f5a66); }
  .mpc-layout__thumb--academy i:nth-child(6) { left: 0; right: 0; top: 90px; height: 16px; border-radius: 0; background: #374151; }
  /* The 3D designs: drawn in perspective; each moves the way its page does when the card is hovered. */
  .mpc-layout__thumb--glide, .mpc-layout__thumb--prism, .mpc-layout__thumb--panorama { perspective: 260px; }
  .mpc-layout__thumb--glide i, .mpc-layout__thumb--prism i, .mpc-layout__thumb--panorama i { transition: transform .6s cubic-bezier(.16, .84, .24, 1), left .6s cubic-bezier(.16, .84, .24, 1), right .6s cubic-bezier(.16, .84, .24, 1), top .6s cubic-bezier(.16, .84, .24, 1), height .6s cubic-bezier(.16, .84, .24, 1); }
  /* Glide: centered title, a photo screen that straightens */
  .mpc-layout__thumb--glide { background: radial-gradient(160px 60px at 50% 0%, color-mix(in srgb, var(--org-primary-color, #0f5a66) 14%, #fff), #fff 70%); }
  .mpc-layout__thumb--glide i:nth-child(1) { left: 42%; width: 16%; top: 9px; height: 5px; border-radius: 999px; opacity: .6; }
  .mpc-layout__thumb--glide i:nth-child(2) { left: 26%; right: 26%; top: 19px; height: 9px; background: #1f2937; }
  .mpc-layout__thumb--glide i:nth-child(3) { left: 36%; right: 36%; top: 32px; height: 4px; }
  .mpc-layout__thumb--glide i:nth-child(4) { left: 12%; right: 12%; top: 44px; height: 58px; border-radius: 7px; background: #374151; transform-origin: 50% 0; transform: rotateX(30deg) scale(.9); box-shadow: 0 14px 18px -12px rgba(15, 23, 42, .5); }
  .mpc-layout__thumb--glide i:nth-child(5) { left: 30%; right: 30%; top: 50px; height: 46px; border-radius: 3px; background: var(--org-primary-color, #0f5a66); opacity: .55; transform-origin: 50% -6px; transform: rotateX(30deg) scale(.9); }
  .mpc-layout__thumb--glide i:nth-child(6) { display: none; }
  .mpc-layout:hover .mpc-layout__thumb--glide i:nth-child(4), .mpc-layout:hover .mpc-layout__thumb--glide i:nth-child(5) { transform: none; }
  /* Prism: dark glass, a glowing title and a 3D stack of photos */
  .mpc-layout__thumb--prism { background: radial-gradient(120px 90px at 12% 0%, color-mix(in srgb, var(--org-primary-color, #0f5a66) 60%, transparent), transparent 70%), radial-gradient(120px 90px at 100% 100%, color-mix(in srgb, var(--org-primary-color, #0f5a66) 35%, transparent), transparent 70%), #0a0d14; border-color: #1f2430; }
  .mpc-layout__thumb--prism i:nth-child(1) { left: 8%; width: 18%; top: 16px; height: 5px; border-radius: 999px; }
  .mpc-layout__thumb--prism i:nth-child(2) { left: 8%; width: 34%; top: 27px; height: 11px; background: #fff; }
  .mpc-layout__thumb--prism i:nth-child(3) { left: 8%; width: 26%; top: 44px; height: 4px; background: rgba(255, 255, 255, .35); }
  .mpc-layout__thumb--prism i:nth-child(4) { right: 9%; width: 34%; top: 14px; height: 48px; border-radius: 6px; background: #4b5563; opacity: .75; transform: rotateY(-26deg) translateX(-4px) translateZ(-24px); }
  .mpc-layout__thumb--prism i:nth-child(5) { right: 15%; width: 34%; top: 20px; height: 48px; border-radius: 6px; background: linear-gradient(135deg, color-mix(in srgb, var(--org-primary-color, #0f5a66) 80%, #fff), #374151); transform: rotateY(-26deg); box-shadow: 0 12px 20px -8px rgba(0, 0, 0, .7); }
  .mpc-layout__thumb--prism i:nth-child(6) { left: 8%; right: 8%; top: 78px; height: 22px; border-radius: 7px; background: rgba(255, 255, 255, .08); border: 1px solid rgba(255, 255, 255, .14); }
  .mpc-layout:hover .mpc-layout__thumb--prism i:nth-child(4) { transform: rotateY(-12deg) translateX(14px) translateZ(-24px); }
  .mpc-layout:hover .mpc-layout__thumb--prism i:nth-child(5) { transform: rotateY(-12deg) translateX(-12px) translateZ(14px); }
  /* Panorama: a huge title, a photo that opens out, numbered chapters */
  .mpc-layout__thumb--panorama { background: #07090d; border-color: #1f2430; }
  .mpc-layout__thumb--panorama i:nth-child(1) { left: 8%; width: 16%; top: 9px; height: 4px; }
  .mpc-layout__thumb--panorama i:nth-child(2) { left: 8%; width: 58%; top: 17px; height: 15px; background: #fff; }
  .mpc-layout__thumb--panorama i:nth-child(3) { left: 16%; right: 16%; top: 42px; height: 44px; border-radius: 7px; background: linear-gradient(160deg, #6b7280, #374151); transform-origin: 50% 100%; transform: rotateX(22deg); }
  .mpc-layout__thumb--panorama i:nth-child(4) { left: 8%; width: 9%; top: 92px; height: 10px; background: transparent; border: 1.5px solid var(--org-primary-color, #0f5a66); border-radius: 2px; }
  .mpc-layout__thumb--panorama i:nth-child(5) { left: 21%; width: 40%; top: 94px; height: 6px; background: #fff; }
  .mpc-layout__thumb--panorama i:nth-child(6) { right: 4%; width: 3px; top: 34px; height: 40px; border-radius: 3px; background: rgba(255, 255, 255, .28); }
  .mpc-layout:hover .mpc-layout__thumb--panorama i:nth-child(3) { left: 0; right: 0; top: 0; height: 88px; border-radius: 0; transform: none; }
  @media (prefers-reduced-motion: reduce) { .mpc-layout__thumb i { transition: none !important; } }

  /* Website mode */
  .mpc-mode-note { margin: 0 0 12px; color: var(--text-secondary); font-size: 0.85rem; }
  .mpc-mode-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; }
  @media (max-width: 520px) { .mpc-mode-grid { grid-template-columns: 1fr; } }
  .mpc-mode-preview { margin-top: 10px; padding: 8px; border-radius: 10px; display: grid; gap: 5px; border: 1px solid rgba(15, 23, 42, 0.08); }
  .mpc-mode-preview span { display: block; height: 8px; border-radius: 4px; }
  .mpc-mode-preview span:first-child { width: 60%; background: var(--org-primary-color, var(--primary)); }
  /* Preview colors are inline with data-ap-skip, so each shows its real look
     whatever mode the person editing is using. */
  .mpc-mode-preview span:last-child { width: 80%; }

  /* Layout Selector Styles */
  .layout-option {
