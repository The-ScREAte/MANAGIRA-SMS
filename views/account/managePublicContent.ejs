                      <button type="submit" class="btn btn-primary">Upload Content</button>
                    </div>
                  </form>
                </div>
            <div class="images-content-container">
                <% if (images.length === 0) { %>
                    <div class="empty-state-box"><p>No images have been uploaded to the school website yet.</p></div>
                <% } else { %>
                    <h3 class="section-subtitle">Slideshow Images</h3>
                    <div class="slideshow-images">
                        <% let currentSlideShowId = null; %>
                        <% images
                            .filter(image => image.allocation === 'slideshow')
                            .forEach((image) => { %>
                                <form action="/account/updateImage" method="POST" class="image-content-form">
                                    <img src="<%= image.image_url.startsWith('http') ? image.image_url : '/' + image.image_url %>" alt="Slide Image">
