              <div class="layout-preview wf4" aria-hidden="true">
                <span class="layout-block hero"></span>
                <span class="layout-block gallery accent"></span>
                <span class="layout-block events"></span>
                <span class="layout-block announcements accent"></span>
                <span class="layout-block about soft"></span>
              </div>
            </div>
          </div>
