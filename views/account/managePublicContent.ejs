  <!-- Website design: three groups (Standard, 3D, Emblem), and the emblem for the emblem designs -->
  <div class="theme-panel" id="mpcLayout">
    <div class="theme-panel-header">
      <h2><i class="fa-solid fa-table-cells-large mpc-h-icon" aria-hidden="true"></i> Website design</h2>
      <button type="button" class="section-collapse-toggle" aria-expanded="true">Collapse</button>
    </div>
    <%
      const _layouts = (typeof websiteLayouts !== 'undefined' && websiteLayouts) || [];
      const _currentLayout = publicDashboardLayout || 'wireframe1';
      const _groups = ((typeof websiteLayoutGroups !== 'undefined' && websiteLayoutGroups) || [{ key: 'standard', name: 'Standard', note: '' }])
        .map((g) => ({ ...g, items: _layouts.filter((l) => (l.group || 'standard') === g.key) }))
        .filter((g) => g.items.length);
      const _currentGroup = ((_layouts.find((l) => l.value === _currentLayout) || {}).group) || 'standard';
      const _groupIcons = { standard: 'fa-table-columns', '3d': 'fa-cube', emblem: 'fa-shield' };
      const _emblems = (typeof websiteEmblems !== 'undefined' && websiteEmblems) || [];
      const _emblem = (typeof websiteSettings !== 'undefined' && websiteSettings && websiteSettings.emblem) || { kind: 'icon', icon: 'shield', imageUrl: '', placement: 'pattern' };
      const _hasEmblemDesigns = _layouts.some((l) => l.emblem);
      const _emblemMask = (_emblems.find((e) => e.key === _emblem.icon) || _emblems[0] || {}).mask || '';
    %>
    <p class="mpc-mode-note">Every design shows the same content. Photos are always shown whole.</p>
    <form action="/account/updatePublicDashboardLayout" method="POST" id="mpcDesignForm">
      <% if (_groups.length > 1) { %>
        <div class="mpc-tabs" role="tablist" aria-label="Design groups">
          <% _groups.forEach((g) => { %>
            <button type="button" class="mpc-tab<%= g.key === _currentGroup ? ' is-active' : '' %>" role="tab" id="mpcTab-<%= g.key %>" aria-controls="mpcGroup-<%= g.key %>" aria-selected="<%= g.key === _currentGroup %>" data-mpc-tab="<%= g.key %>">
              <i class="fa-solid <%= _groupIcons[g.key] || 'fa-table-columns' %>" aria-hidden="true"></i><span><%= g.name %></span><em><%= g.items.length %></em>
            </button>
          <% }) %>
        </div>
      <% } %>
      <% _groups.forEach((g) => { %>
        <div class="mpc-group" role="<%= _groups.length > 1 ? 'tabpanel' : 'group' %>" id="mpcGroup-<%= g.key %>" aria-labelledby="mpcTab-<%= g.key %>"<%= _groups.length > 1 && g.key !== _currentGroup ? ' hidden' : '' %>>
          <% if (g.note && _groups.length > 1) { %><p class="mpc-group__note"><%= g.note %></p><% } %>
          <div class="mpc-layouts">
            <% g.items.forEach((l) => { %>
              <label class="layout-option mpc-layout <%= _currentLayout === l.value ? 'selected' : '' %>">
                <span class="mpc-layout__thumb mpc-layout__thumb--<%= l.key %>" data-ap-skip aria-hidden="true"<% if (l.emblem && _emblemMask) { %> style="--em: url(&quot;<%= _emblemMask %>&quot;)"<% } %>><i></i><i></i><i></i><i></i><i></i><i></i></span>
                <span class="mpc-layout__row">
                  <input type="radio" name="publicDashboardLayout" value="<%= l.value %>" <%= _currentLayout === l.value ? 'checked' : '' %> />
                  <span class="layout-title"><%= l.name %></span>
                  <% if (l.style && l.group !== 'standard') { %><span class="mpc-layout__badge"><%= l.style %></span><% } %>
                  <% if (_currentLayout === l.value) { %><span class="mpc-layout__current">Current</span><% } %>
                </span>
                <span class="layout-subtitle"><%= l.description %></span>
                <a class="mpc-layout__preview" href="/common/publicDashboard?organizationId=<%= orgDetails.organization_id %>&previewLayout=<%= l.value %>" target="_blank" rel="noopener">Preview <span aria-hidden="true">↗</span></a>
              </label>
            <% }) %>
          </div>
          <% if (g.key === 'emblem' || (g.key === '3d' && g.items.some((l) => l.emblem))) { %>
            <% if (g.key === '3d') { %><p class="mpc-group__hint"><i class="fa-solid fa-shield" aria-hidden="true"></i> Orbit uses your emblem. <button type="button" class="mpc-link" data-mpc-tab="emblem">Choose it in Emblem</button></p><% } %>
          <% } %>
          <% if (g.key === 'emblem' && _hasEmblemDesigns) { %>
            <%- include('../partials/manageWebsiteEmblem', { emblems: _emblems, emblem: _emblem, logoUrl: orgDetails.logo ? publicImageUrl(orgDetails.logo, { public: true }) : '' }) %>
          <% } %>
        </div>
      <% }) %>
      <div class="mpc-save-row"><button type="submit" class="theme-save-btn">Save design</button></div>
    </form>
    <script>
      // Design groups: one tab at a time; "Choose it in Emblem" opens the Emblem tab.
      (function () {
        var panel = document.getElementById('mpcLayout');
        if (!panel) return;
        function show(key) {
          panel.querySelectorAll('.mpc-tab').forEach(function (tab) {
            var on = tab.getAttribute('data-mpc-tab') === key;
            tab.classList.toggle('is-active', on);
            tab.setAttribute('aria-selected', on ? 'true' : 'false');
          });
          panel.querySelectorAll('.mpc-group').forEach(function (group) { group.hidden = group.id !== 'mpcGroup-' + key; });
        }
        panel.addEventListener('click', function (event) {
          var trigger = event.target.closest('[data-mpc-tab]');
          if (!trigger) return;
          show(trigger.getAttribute('data-mpc-tab'));
          if (!trigger.classList.contains('mpc-tab')) {
            var emblem = document.getElementById('mpcEmblem');
            if (emblem) emblem.scrollIntoView({ behavior: 'smooth', block: 'start' });
          }
        });
        // Arrow keys move between the tabs.
        panel.addEventListener('keydown', function (event) {
          var tab = event.target.closest('.mpc-tab');
          if (!tab || (event.key !== 'ArrowRight' && event.key !== 'ArrowLeft')) return;
          var tabs = Array.prototype.slice.call(panel.querySelectorAll('.mpc-tab'));
          var next = tabs[(tabs.indexOf(tab) + (event.key === 'ArrowRight' ? 1 : tabs.length - 1)) % tabs.length];
          next.focus(); next.click();
        });
      })();
    </script>
  </div>

