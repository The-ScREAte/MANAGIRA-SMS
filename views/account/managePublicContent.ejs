<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Manage Public Content</title>
<style>
  :root {
    --font-family: "Inter", sans-serif;
  }

  body {
    font-family: var(--font-family);
  }

  .manage-public-page {
    background: #f7f9fb;
  }

  .manage-public-header {
    display: flex;
    align-items: center;
    width: 100%;
    justify-content: center;
    position: relative;
  }

  .manage-public-header h1 {
    margin: 0;
  }

  .manage-public-header .link-to-next-back {
    display: flex;
    align-items: center;
    justify-content: flex-start;
    margin: 0;
    position: absolute;
    left: 0;
  }

  .manage-public-container {
    max-width: 1200px;
    width: 100%;
    margin: 0 auto 48px;
    padding: 0 16px 24px;
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .manage-public-container h3 {
    color: #535252;
    font-weight: lighter;
    text-align: center; /* Center subsection headings */
    margin: 8px 0 12px;
  }

  .content-container {
    margin-bottom: 0;
    padding: 18px;
    background: #ffffff;
    border: 1px solid #e5e9ec;
    border-radius: 12px;
    box-shadow: 0 6px 18px rgba(0, 0, 0, 0.06);
  }

  /* Center "no content" messages */
  .images-content-container > p,
  .text-content-container > p {
    text-align: center;
    color: #666;
    font-style: italic;
    padding: 20px;
  }

  .images-header {
    display: flex;
    width: 100%;
    align-items: center;
    justify-content: space-between;
  }

  .images-content-container {
    width: 100%;
  }

  .standalone-images {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 20px;
    padding: 10px 4px 10px 0;
    max-height: 520px;
    overflow-y: auto;
    overflow-x: hidden;
  }

  /* When items overflow, align them to start for better scrolling */
  .standalone-images:has(.image-content-form:nth-child(4)) {
    justify-content: flex-start;
  }

  .standalone-images::-webkit-scrollbar {
    height: 10px; /* Adjust the height of the scrollbar */
  }

  .standalone-images::-webkit-scrollbar-thumb {
    background-color: #888; /* Color of the scrollbar thumb */
    border-radius: 3px; /* Rounded corners for the thumb */
  }

  .standalone-images::-webkit-scrollbar-track {
    background-color: #f1f1f1; /* Color of the scrollbar track */
  }

  .image-content-form {
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    align-items: center;
    width: 100%;
    min-width: 280px;
    max-width: 320px;
    height: 440px;
    border: 1px solid #e1e6ea;
    border-radius: 12px;
    padding: 16px;
    background-color: #ffffff;
    box-shadow: 0 6px 18px rgba(0, 0, 0, 0.06);
    box-sizing: border-box;
  }

  .image-content-form img {
    width: 100%; /* Full width of the container */
    height: 150px; /* Fixed height */
    object-fit: cover; /* Ensures the image is cropped to fit the container */
    border-radius: 5px;
    margin-bottom: 15px;
  }

  .image-content-form label {
    display: block;
    width: 100%;
    margin: 0;
    font-weight: bold;
    text-align: left; /* Align labels to the left */
  }

  .image-content-form input[type="text"],
  .image-content-form select {
    width: 100%; /* Full width of the form */
    /* padding: 8px; */
    margin-bottom: 8px;
    border: 1px solid #ccc;
    border-radius: 4px;
    font-size: 14px;
  }

  .image-content-form button {
    padding: 10px 15px;
    background-color: #01535b;
    color: white;
    border: none;
    border-radius: 5px;
    cursor: pointer;
    transition: background-color 0.3s ease;
    width: 100%;
  }

  .image-content-form button:hover {
    background-color: #01535b;
  }

  .delete-link {
    margin-top: 10px;
    color: red;
    text-decoration: none;
    font-size: 14px;
    padding: 10px;
    border-radius: 5px;
    width: 100%;
    transition: all 0.3s ease;
    text-align: center;
  }

  .delete-link:hover {
    text-decoration: none;
    background-color: #c70e0e93;
    color: white;
  }

  .slideshow-images {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 20px;
    padding: 10px 4px 10px 0;
    max-height: 520px;
    overflow-y: auto;
    overflow-x: hidden;
    align-items: start;
  }

  /* When items overflow, align them to start for better scrolling */
  .slideshow-images:has(.image-content-form:nth-child(4)) {
    justify-content: flex-start;
  }

  .slideshow-images::-webkit-scrollbar {
    height: 10px; /* Adjust the height of the scrollbar */
  }

  .slideshow-images::-webkit-scrollbar-thumb {
    background-color: #888; /* Color of the scrollbar thumb */
    border-radius: 3px; /* Rounded corners for the thumb */
  }

  .slideshow-images::-webkit-scrollbar-track {
    background-color: #f1f1f1; /* Color of the scrollbar track */
  }

  .text-content-container {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(360px, 1fr));
    gap: 20px;
    padding: 10px 4px 10px 0;
    max-height: 500px;
    overflow-y: auto;
    overflow-x: hidden;
    align-items: start;
  }

  /* When items overflow, align them to start for better scrolling */
  .text-content-container:has(.text-content-form:nth-child(3)) {
    justify-content: flex-start;
  }

  .text-content-container::-webkit-scrollbar {
    height: 10px; /* Adjust the height of the scrollbar */
  }

  .text-content-container::-webkit-scrollbar-thumb {
    background-color: #888; /* Color of the scrollbar thumb */
    border-radius: 3px; /* Rounded corners for the thumb */
  }

  .text-content-container::-webkit-scrollbar-track {
    background-color: #f1f1f1; /* Color of the scrollbar track */
  }

  .text-content-form {
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    width: 100%;
    min-width: 340px;
    max-width: 520px;
    min-height: 240px;
    border: 1px solid #e1e6ea;
    border-radius: 12px;
    padding: 18px;
    margin: 0;
    background: #ffffff;
    box-shadow: 0 6px 18px rgba(0, 0, 0, 0.06);
    box-sizing: border-box;
  }

  .texts-header {
    display: flex;
    width: 100%;
    align-items: center;
    justify-content: space-between;
  }

  /* ============================
     NEW: THEME PICKER (COMPACT + CLEAR)
     ============================ */
  .theme-panel {
    max-width: 1100px;
    margin: 0 auto 22px auto;
    padding: 14px 14px;
    border: 1px solid #e7e7e7;
    border-radius: 14px;
    background: #fff;
    box-shadow: 0 8px 18px rgba(0, 0, 0, 0.05);
  }

  .theme-panel-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 10px;
  }

  .theme-panel-header h2 {
    margin: 0;
    font-size: 1.15rem;
  }

  .theme-panel-header p {
    margin: 4px 0 0 0;
    color: #666;
    font-size: 0.92rem;
  }

  .theme-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 10px;
  }

  @media (max-width: 900px) {
    .theme-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 560px) {
    .theme-grid {
      grid-template-columns: 1fr;
    }
  }

  .theme-card {
    border: 1px solid #e3e3e3;
    border-radius: 12px;
    padding: 10px 12px;
    background: #fff;
    cursor: pointer;
    transition: transform 0.12s ease, box-shadow 0.12s ease,
      border-color 0.12s ease;
    display: flex;
    gap: 10px;
    align-items: flex-start;
  }

  .theme-card:hover {
    transform: translateY(-1px);
    box-shadow: 0 10px 18px rgba(0, 0, 0, 0.06);
  }

  /* highlight selected card */
  .theme-card:has(input:checked) {
    border-color: #01535b;
    box-shadow: 0 12px 20px rgba(1, 83, 91, 0.16);
  }

  .theme-radio {
    margin-top: 3px;
  }

  .theme-meta {
    flex: 1;
    min-width: 0;
  }

  .theme-title {
    font-weight: 800;
    font-size: 0.98rem;
    margin: 0 0 4px 0;
    color: #222;
  }

  .theme-desc {
    margin: 0;
    color: #666;
    font-size: 0.88rem;
    line-height: 1.35;
  }

  .swatches {
    display: flex;
    gap: 6px;
    margin-top: 8px;
    align-items: center;
    flex-wrap: wrap;
  }

  .swatch {
    width: 14px;
    height: 14px;
    border-radius: 999px;
    border: 1px solid rgba(0, 0, 0, 0.12);
  }

  .theme-foot {
    display: flex;
    justify-content: center;
    margin-top: 12px;
  }

  .theme-save-btn {
    padding: 10px 18px;
    border: 0;
    border-radius: 10px;
    background: var(--org-primary-color, #01535b);
    color: #fff;
    font-weight: 700;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .theme-save-btn:hover {
    background: var(--org-primary-hover, #014a51);
    transform: translateY(-1px);
  }

  /* Optional: keep your section headings from looking too huge */
  .manage-public-container h2 {
    margin: 0;
  }

  @media screen and (max-width: 768px) {
    .manage-public-header {
      flex-direction: column;
      padding: 10px;
      text-align: center;
    }

    .manage-public-header h1 {
      font-size: 1.3rem;
    }

    .manage-public-header .link-to-next-back {
      position: static;
      justify-content: center;
      margin-top: 10px;
    }

    .images-header,
    .texts-header {
      flex-direction: column;
      align-items: flex-start;
      gap: 10px;
    }

    .images-header h2,
    .texts-header h2 {
      font-size: 1.2rem;
    }

    .image-content-form,
    .text-content-form {
      width: 100%;
      max-width: 100%;
    }

    .text-content-container,
    .slideshow-images,
    .standalone-images {
      gap: 10px;
      padding: 5px;
    }

    .text-content-form .rich-text-editor {
      height: 150px;
    }

    .public-dashboard-link a {
      word-break: break-word;
    }

    #aboutUsForm textarea,
    #aboutUsForm input[type="text"] {
      width: 100%;
    }

    form button,
    form .delete-link {
      width: 100%;
    }

    .text-content-form label,
    .image-content-form label {
      font-size: 0.9rem;
    }

    .image-content-form img {
      height: auto;
      max-height: 200px;
    }
  }

  .notice {
    background-color: #e7f3fe;
    color: #0c5460;
    border: 1px solid #bee5eb;
    border-radius: 5px;
    padding: 15px;
    margin-bottom: 20px;
  }

  .notice h2 {
    font-size: 18px;
    margin: 0 0 10px;
    font-weight: bold;
  }

  /* Upload form file field styling */
  .file-upload-field {
    border: 1px solid #ddd;
    border-radius: 8px;
    padding: 15px;
    margin-bottom: 15px;
    background-color: #fff;
  }

  .file-upload-field label {
    display: block;
    margin-bottom: 5px;
    font-weight: bold;
    color: #333;
  }

  .file-upload-field input[type="file"],
  .file-upload-field input[type="text"] {
    width: 100%;
    padding: 8px;
    margin-bottom: 10px;
    border: 1px solid #ccc;
    border-radius: 4px;
    font-size: 14px;
  }

  .file-upload-field .removeFileBtn {
    background-color: #dc3545;
    color: white;
    border: none;
    padding: 5px 10px;
    border-radius: 4px;
    cursor: pointer;
    font-size: 12px;
    float: right;
  }

  .file-upload-field .removeFileBtn:hover {
    background-color: #c82333;
  }
</style>
</head>
<body class="manage-public-page">
    <br>
            <h1>Manage Public Dashboard Content</h1>

    <div class="manage-public-header">
        <div class="link-to-next-back">
            <a href="/common/publicDashboard?organizationId=<%= organizationId %>" class="btn btn-primary"><i class="fa-solid fa-chevron-left"></i>Back</a>
        </div>
    </div>
    
    <%- include('../partials/flash') %>


<div class="manage-public-container" style="max-width: 1100px;">
  <div class="theme-panel">
    <div class="theme-panel-header">
      <div>
        <h2>Website Style</h2>
        <p>Pick a theme. Each option shows the main colors used on the public website.</p>
      </div>
    </div>

<form action="/account/updatePublicDashboardTheme" method="POST">
  <div class="theme-grid">

    <!-- Classic Teal -->
    <label class="theme-card">
      <input class="theme-radio" type="radio" name="publicDashboardTheme" value="classic"
        <%= publicDashboardTheme === 'classic' ? 'checked' : '' %> />
      <div class="theme-meta">
        <div class="theme-title">Classic Teal</div>
        <div class="swatches">
          <span class="swatch" style="background:#01535b;"></span>
          <span class="swatch" style="background:#eaf2ff;"></span>
        </div>
        <div class="theme-desc">Great for most schools.</div>
      </div>
    </label>

        <!-- Bold Sunrise -->
    <label class="theme-card">
      <input class="theme-radio" type="radio" name="publicDashboardTheme" value="bold"
        <%= publicDashboardTheme === 'bold' ? 'checked' : '' %> />
      <div class="theme-meta">
        <div class="theme-title">Bold DarkSunrise</div>
        <div class="swatches">
          <span class="swatch" style="background:#ffb703;"></span>
          <span class="swatch" style="background:#0b1020;"></span>
        </div>
        <div class="theme-desc">Black with Deep Gold Theme.</div>
      </div>
    </label>

    <!-- Modern Blue -->
    <label class="theme-card">
      <input class="theme-radio" type="radio" name="publicDashboardTheme" value="modern"
        <%= publicDashboardTheme === 'modern' ? 'checked' : '' %> />
      <div class="theme-meta">
        <div class="theme-title">Modern Blue</div>
        <div class="swatches">
          <span class="swatch" style="background:#2563eb;"></span>
          <span class="swatch" style="background:#f7f9fb;"></span>
        </div>
        <div class="theme-desc">Light blue theme.</div>
      </div>
    </label>

    <!-- Minimal Purple -->
    <label class="theme-card">
      <input class="theme-radio" type="radio" name="publicDashboardTheme" value="minimal"
        <%= publicDashboardTheme === 'minimal' ? 'checked' : '' %> />
      <div class="theme-meta">
        <div class="theme-title">Minimal Purple</div>
        <div class="swatches">
          <span class="swatch" style="background:#7c3aed;"></span>
          <span class="swatch" style="background:#f7f1ff;"></span>
        </div>
        <div class="theme-desc">PUrple Theme.</div>
      </div>
    </label>



    <!-- Gold Accent -->
    <label class="theme-card">
      <input class="theme-radio" type="radio" name="publicDashboardTheme" value="gold"
        <%= publicDashboardTheme === 'gold' ? 'checked' : '' %> />
      <div class="theme-meta">
        <div class="theme-title">Gold Accent</div>
        <div class="swatches">
          <span class="swatch" style="background:#ffd700;"></span>
          <span class="swatch" style="background:#fffbe6;"></span>
        </div>
        <div class="theme-desc">Gold Theme.</div>
      </div>
    </label>

    <!-- Red Energy -->
    <label class="theme-card">
      <input class="theme-radio" type="radio" name="publicDashboardTheme" value="red"
        <%= publicDashboardTheme === 'red' ? 'checked' : '' %> />
      <div class="theme-meta">
        <div class="theme-title">Red Energy</div>
        <div class="swatches">
          <span class="swatch" style="background:#e11d48;"></span>
          <span class="swatch" style="background:#fff1f2;"></span>
        </div>
        <div class="theme-desc">Light red theme.</div>
      </div>
    </label>

    <!-- Brown Earth -->
    <label class="theme-card">
      <input class="theme-radio" type="radio" name="publicDashboardTheme" value="brown"
        <%= publicDashboardTheme === 'brown' ? 'checked' : '' %> />
      <div class="theme-meta">
        <div class="theme-title">Brown Earth</div>
        <div class="swatches">
          <span class="swatch" style="background:#7c4a03;"></span>
          <span class="swatch" style="background:#f5ede3;"></span>
        </div>
        <div class="theme-desc">Brown Theme.</div>
      </div>
    </label>

  </div>

  <div class="theme-foot">
    <button class="theme-save-btn" type="submit">Save Website Style</button>
  </div>
</form>

</div>


    <div class="manage-public-container">
        <div class="content-container">
            <div class="images-header">
                <h2>Images</h2>
                <div class="link-to-next-back">
                    <a id="toggle-upload-content-form" class="btn btn-primary"><i class="fa-regular fa-square-plus"></i>Upload Image Content</a>
                </div>
            </div>
            
                <div id="uploadContentForm" style="display: none; max-width: 600px; margin: 20px auto; padding: 30px; border: 1px solid #ddd; border-radius: 10px; background-color: #f9f9f9; box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1); position: relative;">
                    <button type="button" id="closeUploadForm" style="position: absolute; top: 15px; right: 15px; background: none; border: none; font-size: 24px; color: #666; cursor: pointer; padding: 0; width: 30px; height: 30px; display: flex; align-items: center; justify-content: center; border-radius: 50%; transition: all 0.3s ease;" onmouseover="this.style.backgroundColor='#e9ecef'; this.style.color='#333';" onmouseout="this.style.backgroundColor='transparent'; this.style.color='#666';">&times;</button>
                    <form action="/account/uploadSlideshowImages" method="POST" enctype="multipart/form-data">
                        <h2 style="text-align: center; margin-bottom: 25px; color: #333;">Upload Image Content</h2>
                        <div style="margin-bottom: 20px;">
                            <label for="contentType" style="display: block; margin-bottom: 8px; font-weight: bold;">Content Type:</label>
                            <select id="contentType" name="contentType" required style="width: 100%; padding: 10px; border: 1px solid #ccc; border-radius: 5px; font-size: 14px;">
                                <option value="">Select Content Type</option>
                                <option value="slideshow">Slide Show</option>
                                <option value="siteImage">Site Image</option>
                            </select>
                        </div>
                        <div id="fileUploadContainer" style="margin-bottom: 20px;">
                            <!-- File upload fields will be added dynamically here -->
                        </div>
                        <div style="text-align: center; margin-top: 25px;">
                            <button type="button" id="addMoreFilesBtn" style="display:none; margin-right: 10px; padding: 10px 20px; background-color: #6c757d; color: white; border: none; border-radius: 5px; cursor: pointer;">Add More Images</button>
                            <button type="submit" style="padding: 10px 30px; background-color: var(--org-primary-color, #01535b); color: white; border: none; border-radius: 5px; cursor: pointer; font-size: 16px;">Upload Content</button>
                        </div>
                    </form>
                </div>
            <div class="images-content-container">
                <% if (images.length === 0) { %>
                    <p> No images have been uploaded to the public dashboard yet</p>
                <% } else { %>
                    <h3>Content Images</h3>
                    <div class="standalone-images">
                        <% images.filter(image => image.allocation !== 'slideshow').forEach((image) => { %>
                          <form action="/account/updateImage" method="POST" class="image-content-form">
                            <img src="<%= image.image_url.startsWith('http') ? image.image_url : '/' + image.image_url %>" alt="Image">
                            <input type="hidden" name="imageId" value="<%= image.image_id %>">
                      
                            <label for="caption">Caption:</label>
                            <input type="text" required name="caption" value="<%= image.caption %>">
                      
                            <label for="allocation">Allocation:</label>
                            <select name="allocation">
                              <option value="hero" <%= image.allocation === 'hero' ? 'selected' : '' %>>Hero Image</option>
                              <option value="slideshow" <%= image.allocation === 'slideshow' ? 'selected' : '' %>>Slideshow Image</option>
                            </select>
                      
                            <button type="submit">Update</button>
                            <a href="/account/deleteImage/<%= image.image_id %>" class="delete-link">Delete</a>
                          </form>
                        <% }); %>
                      </div>
    
                    <%# Slideshow Images %>
                    <h3>SlideShow Images</h3>
                    <div class="slideshow-images">
                        <% let currentSlideShowId = null; %>
                        <% images
                            .filter(image => image.allocation === 'slideshow')
                            .forEach((image) => { %>
                                <form action="/account/updateImage" method="POST" class="image-content-form">
                                    <img src="<%= image.image_url.startsWith('http') ? image.image_url : '/' + image.image_url %>" alt="Slide Image">
                                    <input type="hidden" name="imageId" value="<%= image.image_id %>">
                                    <label for="caption">Caption:</label>
                                    <input type="text" name="caption" value="<%= image.caption %>">
                                    <label for="allocation">Allocation:</label>
                                    <select name="allocation">
                                        <option value="hero" <%= image.allocation === 'hero' ? 'selected' : '' %>>Hero Image</option>
                                        <option value="slideshow" <%= image.allocation === 'slideshow' ? 'selected' : '' %>>Slideshow Image</option>
                                    </select>
                                    <button type="submit">Update</button>
                                    <a href="/account/deleteImage/<%= image.image_id %>" class="delete-link">Delete</a>
                                </form>
                        <% }); %>
                    </div>
                <% } %>
            </div>
        </div>
    <hr>
        <div class="content-container">
            <div class="texts-header">
                <h2>Texts</h2>
                <div class="link-to-next-back">
                    <a id="toggle-upload-text-form" class="btn btn-primary"><i class="fa-regular fa-square-plus"></i>Upload Text</a>
                </div>
            </div>

            <div id="uploadTextForm" style="display: none; max-width: 600px; margin: 20px auto; padding: 30px; border: 1px solid #ddd; border-radius: 10px; background-color: #f9f9f9; box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1); position: relative;">
                <button type="button" id="closeUploadTextForm" style="position: absolute; top: 15px; right: 15px; background: none; border: none; font-size: 24px; color: #666; cursor: pointer; padding: 0; width: 30px; height: 30px; display: flex; align-items: center; justify-content: center; border-radius: 50%; transition: all 0.3s ease;" onmouseover="this.style.backgroundColor='#e9ecef'; this.style.color='#333';" onmouseout="this.style.backgroundColor='transparent'; this.style.color='#666';">&times;</button>
                <form action="/account/addTextSection" method="POST">
                    <h2 style="text-align: center; margin-bottom: 25px; color: #333;">Add Text Section</h2>
                    <div style="margin-bottom: 20px;">
                        <label for="heading" style="display: block; margin-bottom: 8px; font-weight: bold;">Heading:</label>
                        <input type="text" required id="heading" name="heading" style="width: 100%; padding: 10px; border: 1px solid #ccc; border-radius: 5px; font-size: 14px;">
                    </div>
                    <div style="margin-bottom: 20px;">
                        <label for="paragraph" style="display: block; margin-bottom: 8px; font-weight: bold;">Text:</label>
                        <div id="rich-text-editor" style="height: 200px; border: 1px solid #ccc; border-radius: 5px;"></div>
                        <textarea id="paragraph" name="paragraph" style="display: none;" required></textarea>
                    </div>
                    <div style="text-align: center; margin-top: 25px;">
                        <button type="submit" style="padding: 10px 30px; background-color: var(--org-primary-color, #01535b); color: white; border: none; border-radius: 5px; cursor: pointer; font-size: 16px;">Add Text Section</button>
                    </div>
                </form>
            </div>
    
            <div class="text-content-container">
                <% if (texts.length === 0) { %>
                    <p>No texts available now.</p>
                <% } else { %>
                    <% texts.forEach(text => { %>
                            <form action="/account/updateText" method="POST" class="text-content-form">
                                <input type="hidden" name="textId" value="<%= text.text_id %>">
                                <label for="heading">Heading:</label>
                                <input type="text" name="heading" value="<%= text.heading %>">
                                <label for="paragraph">Paragraph:</label>
                                <div class="rich-text-editor" style="height: 200px; border: 1px solid #ccc;"></div>
                                <textarea name="paragraph" style="display: none;" required><%= text.paragraph %></textarea>
                                <button type="submit">Update</button>
                                <a href="/account/deleteText/<%= text.text_id %>" class="delete-link">Delete</a>
                            </form>
                    <% }) %>
                <% } %>
            </div>
        </div>
<hr>
        <!-- Events Section -->
        <div class="content-container">
            <div class="images-header">
                <h2>Events</h2>
                <div class="link-to-next-back">
                    <a id="toggle-create-event-form" class="btn btn-primary"><i class="fa-regular fa-square-plus"></i>Create Event</a>
                </div>
            </div>

            <!-- Toggle Create Event Form -->
            <div id="createEventForm" style="display: none; max-width: 600px; margin: 20px auto; padding: 30px; border: 1px solid #ddd; border-radius: 10px; background-color: #f9f9f9; box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1); position: relative;">
                <button type="button" id="closeCreateEventForm" style="position: absolute; top: 15px; right: 15px; background: none; border: none; font-size: 24px; color: #666; cursor: pointer; padding: 0; width: 30px; height: 30px; display: flex; align-items: center; justify-content: center; border-radius: 50%; transition: all 0.3s ease;" onmouseover="this.style.backgroundColor='#e9ecef'; this.style.color='#333';" onmouseout="this.style.backgroundColor='transparent'; this.style.color='#666';">&times;</button>
                <form action="/common/createEventAnnouncement" method="POST">
                    <h2 style="text-align: center; margin-bottom: 25px; color: #333;">Create Event</h2>
                    <input type="hidden" name="type" value="event">
                    <div style="margin-bottom: 20px;">
                        <label for="eventName" style="display: block; margin-bottom: 8px; font-weight: bold;">Event Name:</label>
                        <input type="text" id="eventName" name="eventName" placeholder="Event Name" required style="width: 100%; padding: 10px; border: 1px solid #ccc; border-radius: 5px; font-size: 14px;">
                    </div>
                    <div style="margin-bottom: 20px;">
                        <label for="eventDate" style="display: block; margin-bottom: 8px; font-weight: bold;">Event Date:</label>
                        <input type="date" id="eventDate" name="eventDate" required style="width: 100%; padding: 10px; border: 1px solid #ccc; border-radius: 5px; font-size: 14px;">
                    </div>
                    <div style="margin-bottom: 20px;">
                        <label for="eventDetails" style="display: block; margin-bottom: 8px; font-weight: bold;">Event Details:</label>
                        <textarea id="eventDetails" name="eventDetails" placeholder="Event Details" rows="4" required style="width: 100%; padding: 10px; border: 1px solid #ccc; border-radius: 5px; font-size: 14px; resize: vertical;"></textarea>
                    </div>
                    <div style="margin-bottom: 20px;">
                        <label for="visibility" style="display: block; margin-bottom: 8px; font-weight: bold;">Visibility:</label>
                        <select name="visibility" id="visibility" style="width: 100%; padding: 10px; border: 1px solid #ccc; border-radius: 5px; font-size: 14px;">
                            <option value="org">Org Dashboard</option>
                            <option value="public">Public</option>
                            <option value="both" selected>Both</option>
                        </select>
                    </div>
                    <div style="text-align: center; margin-top: 25px;">
                        <button type="submit" style="padding: 10px 30px; background-color: var(--org-primary-color, #01535b); color: white; border: none; border-radius: 5px; cursor: pointer; font-size: 16px;">Create Event</button>
                    </div>
                </form>
            </div>

            <!-- Events List -->
            <div class="text-content-container">
                <% if (events.length === 0) { %>
                    <p>No events have been posted.</p>
                <% } else { %>
                    <% events.forEach(function(event) { %>
                        <form action="/common/updateEvent" method="POST" class="text-content-form">
                            <input type="hidden" name="id" value="<%= event.id %>">
                            <label for="name">Name:</label>
                            <input type="text" name="name" value="<%= event.name %>" required>
                            <label for="eventDate">Date:</label>
                            <input type="date" name="eventDate" value="<%= event.event_date %>" required>
                            <label for="details">Details:</label>
                            <textarea name="details" rows="4" required><%= event.details %></textarea>
                            <label for="visibility">Visibility:</label>
                            <select name="visibility">
                                <option value="org" <%= event.visibility === 'org' ? 'selected' : '' %>>Org</option>
                                <option value="public" <%= event.visibility === 'public' ? 'selected' : '' %>>Public</option>
                                <option value="both" <%= event.visibility === 'both' ? 'selected' : '' %>>Both</option>
                            </select>
                            <button type="submit">Update</button>
                            <a href="/common/deleteEvent/<%= event.id %>" class="delete-link">Delete</a>
                        </form>
                    <% }); %>
                <% } %>
            </div>
        </div>
<hr>
        <!-- Announcements Section -->
        <div class="content-container">
            <div class="images-header">
                <h2>Announcements</h2>
                <div class="link-to-next-back">
                    <a id="toggle-create-announcement-form" class="btn btn-primary"><i class="fa-regular fa-square-plus"></i>Create Announcement</a>
                </div>
            </div>

            <!-- Toggle Create Announcement Form -->
            <div id="createAnnouncementForm" style="display: none; max-width: 600px; margin: 20px auto; padding: 30px; border: 1px solid #ddd; border-radius: 10px; background-color: #f9f9f9; box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1); position: relative;">
                <button type="button" id="closeCreateAnnouncementForm" style="position: absolute; top: 15px; right: 15px; background: none; border: none; font-size: 24px; color: #666; cursor: pointer; padding: 0; width: 30px; height: 30px; display: flex; align-items: center; justify-content: center; border-radius: 50%; transition: all 0.3s ease;" onmouseover="this.style.backgroundColor='#e9ecef'; this.style.color='#333';" onmouseout="this.style.backgroundColor='transparent'; this.style.color='#666';">&times;</button>
                <form action="/common/createEventAnnouncement" method="POST">
                    <h2 style="text-align: center; margin-bottom: 25px; color: #333;">Create Announcement</h2>
                    <input type="hidden" name="type" value="announcement">
                    <div style="margin-bottom: 20px;">
                        <label for="announcementMessage" style="display: block; margin-bottom: 8px; font-weight: bold;">Announcement Message:</label>
                        <textarea id="announcementMessage" name="announcementMessage" placeholder="Announcement Details" rows="4" required style="width: 100%; padding: 10px; border: 1px solid #ccc; border-radius: 5px; font-size: 14px; resize: vertical;"></textarea>
                    </div>
                    <div style="margin-bottom: 20px;">
                        <label for="visibility" style="display: block; margin-bottom: 8px; font-weight: bold;">Visibility:</label>
                        <select name="visibility" id="visibility" style="width: 100%; padding: 10px; border: 1px solid #ccc; border-radius: 5px; font-size: 14px;">
                            <option value="org">Org Dashboard</option>
                            <option value="public">Public</option>
                            <option value="both" selected>Both</option>
                        </select>
                    </div>
                    <div style="text-align: center; margin-top: 25px;">
                        <button type="submit" style="padding: 10px 30px; background-color: var(--org-primary-color, #01535b); color: white; border: none; border-radius: 5px; cursor: pointer; font-size: 16px;">Post Announcement</button>
                    </div>
                </form>
            </div>

            <!-- Announcements List -->
            <div class="text-content-container">
                <% if (announcements.length === 0) { %>
                    <p>No announcements have been posted.</p>
                <% } else { %>
                    <% announcements.forEach(function(announcement) { %>
                        <form action="/common/updateAnnouncement" method="POST" class="text-content-form">
                            <input type="hidden" name="id" value="<%= announcement.announcement_id %>">
                            <label for="message">Message:</label>
                            <textarea name="message" rows="4" required><%= announcement.message %></textarea>
                            <label for="visibility">Visibility:</label>
                            <select name="visibility">
                                <option value="org" <%= announcement.visibility === 'org' ? 'selected' : '' %>>Org</option>
                                <option value="public" <%= announcement.visibility === 'public' ? 'selected' : '' %>>Public</option>
                                <option value="both" <%= announcement.visibility === 'both' ? 'selected' : '' %>>Both</option>
                            </select>
                            <button type="submit">Update</button>
                            <a href="/common/deleteAnnouncement/<%= announcement.announcement_id %>" class="delete-link">Delete</a>
                        </form>
                    <% }); %>
                <% } %>
            </div>
        </div>
        <hr>
        <div style="max-width: 600px; margin: 20px auto; padding: 30px; border: 1px solid #ddd; border-radius: 10px; background-color: #f9f9f9; box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);">
            <h2 style="text-align: center; margin-bottom: 25px; color: #333;">About Us Section</h2>
            <form id="aboutUsForm" action="/account/update-about-us" method="POST">
                <input type="hidden" name="organization_id" value="<%= orgDetails.organization_id %>">

                <!-- About Us Field -->
                <div style="margin-bottom: 20px;">
                    <label for="aboutUs" style="display: block; margin-bottom: 8px; font-weight: bold;">About Us:</label>
                    <textarea id="aboutUs" name="aboutUs" rows="5" required style="width: 100%; padding: 10px; border: 1px solid #ccc; border-radius: 5px; font-size: 14px; resize: vertical;"><%= orgDetails.aboutus ? orgDetails.aboutus : '' %></textarea>
                </div>

                <!-- Motto Field -->
                <div style="margin-bottom: 20px;">
                    <label for="motto" style="display: block; margin-bottom: 8px; font-weight: bold;">Motto:</label>
                    <p style="font-size: 14px; color: #666; margin-bottom: 8px;">Should usually be short and concise*</p>
                    <input type="text" id="motto" name="motto" value="<%= orgDetails.motto ? orgDetails.motto : '' %>" required style="width: 100%; padding: 10px; border: 1px solid #ccc; border-radius: 5px; font-size: 14px;">
                </div>

                <!-- Submit Button -->
                <div style="text-align: center; margin-top: 25px;">
                    <button type="submit" id="aboutUsBtn" style="padding: 10px 30px; background-color: var(--org-primary-color, #01535b); color: white; border: none; border-radius: 5px; cursor: pointer; font-size: 16px;">
                        <%= orgDetails.aboutus && orgDetails.motto ? 'Update About Us' : 'Add About Us' %>
                    </button>
                </div>
            </form>
        </div>
<hr>
        <div style="max-width: 600px; margin: 20px auto; padding: 30px; border: 1px solid #ddd; border-radius: 10px; background-color: #f9f9f9; box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);">
            <h2 style="text-align: center; margin-bottom: 25px; color: #333;">Public Registration Settings</h2>
            <form action="/account/updatePublicRegistration" method="POST">
                <div style="margin-bottom: 20px;">
                    <label style="display: flex; align-items: center; font-weight: bold; cursor: pointer;">
                        <input type="checkbox" name="enabled" <%= orgDetails.public_registration_enabled ? 'checked' : '' %> style="margin-right: 10px;" />
                        Enable Public Registration
                    </label>
                </div>
                
                <div style="margin-bottom: 20px;">
                    <label style="display: block; margin-bottom: 8px; font-weight: bold;">Start Date:</label>
                    <input type="date" name="startDate" value="<%= orgDetails.registration_start_date?.toISOString().split('T')[0] || '' %>" style="width: 100%; padding: 10px; border: 1px solid #ccc; border-radius: 5px; font-size: 14px;" />
                </div>
                
                <div style="margin-bottom: 20px;">
                    <label style="display: block; margin-bottom: 8px; font-weight: bold;">End Date:</label>
                    <input type="date" name="endDate" value="<%= orgDetails.registration_end_date?.toISOString().split('T')[0] || '' %>" style="width: 100%; padding: 10px; border: 1px solid #ccc; border-radius: 5px; font-size: 14px;" />
                </div>
                
                <div style="margin-bottom: 20px;">
                    <label style="display: block; margin-bottom: 8px; font-weight: bold;">Registration Currency:</label>
                    <select name="currency" style="width: 100%; padding: 10px; border: 1px solid #ccc; border-radius: 5px; font-size: 14px;">
                        <option value="GHS" <%= orgDetails.public_registration_currency === 'GHS' ? 'selected' : '' %>>GHS</option>
                        <option value="EUR" <%= orgDetails.public_registration_currency === 'EUR' ? 'selected' : '' %>>EUR</option>
                        <option value="NGN" <%= orgDetails.public_registration_currency === 'NGN' ? 'selected' : '' %>>NGN</option>
                        <option value="KES" <%= orgDetails.public_registration_currency === 'KES' ? 'selected' : '' %>>KES</option>
                        <option value="ZAR" <%= orgDetails.public_registration_currency === 'ZAR' ? 'selected' : '' %>>ZAR</option>
                        <option value="GBP" <%= orgDetails.public_registration_currency === 'GBP' ? 'selected' : '' %>>GBP</option>
                        <option value="UGX" <%= orgDetails.public_registration_currency === 'UGX' ? 'selected' : '' %>>UGX</option>
                        <option value="TZS" <%= orgDetails.public_registration_currency === 'TZS' ? 'selected' : '' %>>TZS</option>
                        <option value="RWF" <%= orgDetails.public_registration_currency === 'RWF' ? 'selected' : '' %>>RWF</option>
                        <option value="XAF" <%= orgDetails.public_registration_currency === 'XAF' ? 'selected' : '' %>>XAF</option>
                        <option value="XOF" <%= orgDetails.public_registration_currency === 'XOF' ? 'selected' : '' %>>XOF</option>
                    </select>
                </div>
                
                <div style="margin-bottom: 20px;">
                    <label style="display: block; margin-bottom: 8px; font-weight: bold;">Registration Price:</label> 
                    <input type="number" step="0.01" name="price" value="<%= orgDetails.public_registration_price || '' %>" style="width: 100%; padding: 10px; border: 1px solid #ccc; border-radius: 5px; font-size: 14px;" />
                </div>
                
                <div style="text-align: center; margin-top: 25px; margin-bottom: 20px;">
                    <button type="submit" style="padding: 10px 30px; background-color: var(--org-primary-color, #01535b); color: white; border: none; border-radius: 5px; cursor: pointer; font-size: 16px;">Update Registration Settings</button>
                </div>
                
                <div class="notice">
                    <p>
                        REMEMBER TO SET PAYMENT METHODS & OPTIONS OTHERWISE USERS CAN'T MAKE PAYMENT AND FOR THAT REASON PUBLIC REGISTRATION WON'T GO THROUGH.
                        <a
                            href="/account/confirm-password?redirect=/account/update-card"
                            class="btn-primary"
                            style="margin-left: 10px;"
                        >
                            Update Payment Method
                        </a>
                    </p>
                </div>
            </form>
        </div>
        

    </div>

    <script>
        document.addEventListener("DOMContentLoaded", function () {
        const toggleButton = document.getElementById("toggle-upload-content-form");
        const uploadContentForm = document.getElementById("uploadContentForm");
        const closeButton = document.getElementById("closeUploadForm");

        function hideForm() {
            uploadContentForm.style.display = "none";
            toggleButton.innerHTML = "<i class='fa-regular fa-square-plus'></i>Upload Image Content";
        }

        function showForm() {
            uploadContentForm.style.display = "block";
            toggleButton.innerHTML = "<i class='fa-solid fa-ban'></i>Cancel Upload";
        }

        toggleButton.addEventListener("click", function () {
            if (uploadContentForm.style.display === "none" || uploadContentForm.style.display === "") {
                showForm();
            } else {
                hideForm();
            }
        });

        closeButton.addEventListener("click", function () {
            hideForm();
        });
        });

        document.addEventListener("DOMContentLoaded", function () {
        const toggleButton = document.getElementById("toggle-upload-text-form");
        const uploadTextForm = document.getElementById("uploadTextForm");
        const closeButton = document.getElementById("closeUploadTextForm");

        function hideTextForm() {
            uploadTextForm.style.display = "none";
            toggleButton.innerHTML = "<i class='fa-regular fa-square-plus'></i>Upload Text";
        }

        function showTextForm() {
            uploadTextForm.style.display = "block";
            toggleButton.innerHTML = "<i class='fa-solid fa-ban'></i>Cancel Upload";
        }

        toggleButton.addEventListener("click", function () {
            if (uploadTextForm.style.display === "none" || uploadTextForm.style.display === "") {
                showTextForm();
            } else {
                hideTextForm();
            }
        });

        closeButton.addEventListener("click", function () {
            hideTextForm();
        });
        });


        document.addEventListener('DOMContentLoaded', function() {
        const contentTypeSelect = document.getElementById('contentType');
        const fileUploadContainer = document.getElementById('fileUploadContainer');
        const addMoreFilesBtn = document.getElementById('addMoreFilesBtn');

        contentTypeSelect.addEventListener('change', function () {
            fileUploadContainer.innerHTML = '';
            const isSlideShow = contentTypeSelect.value === 'slideshow';
            const isSiteImage = contentTypeSelect.value === 'siteImage';

            // Show "Add More Images" button for both slideshow and site image
            addMoreFilesBtn.style.display = (isSlideShow || isSiteImage) ? 'inline-block' : 'none';

            // Add initial fields
            addFileUploadField();
            if (isSlideShow) addFileUploadField(); // Add second field for slideshows by default
        });

        addMoreFilesBtn.addEventListener('click', addFileUploadField);

        function addFileUploadField() {
            const fieldHTML = `
                <div class="file-upload-field">
                    <label>Choose File:</label>
                    <input type="file" name="slideshowImages" accept="image/*,video/*" required>
                    <button type="button" class="removeFileBtn" onclick="removeFileField(this)">Remove</button>
                    <label>Caption:</label>
                    <input type="text" name="fileTexts" placeholder="Enter caption for this file" required>
                </div>`;
            fileUploadContainer.insertAdjacentHTML('beforeend', fieldHTML);
        }

        window.removeFileField = function (button) {
            const fileFields = document.querySelectorAll('.file-upload-field');
            // Prevent removing the last field - always keep at least one

            <div class="content-container" style="margin-bottom: 28px;">
                <div class="images-header" style="justify-content: center;">
                    <h2 style="margin: 0;">Website Layout</h2>
                </div>
                <p style="text-align:center; color:#666; margin: 8px 0 18px;">
                    Choose the arrangement of sections on your Public Dashboard. Colors stay the same.
                </p>

                <form action="/account/updatePublicDashboardLayout" method="POST" style="max-width: 1100px; margin: 0 auto;">
                    <div style="display:grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 16px;">
                        <!-- Wireframe 1 -->
                        <label style="border: 2px solid <%= (publicDashboardLayout || 'wireframe1') === 'wireframe1' ? '#01535b' : '#ddd' %>; border-radius: 12px; padding: 16px; background: #fff; cursor: pointer; transition: all 0.2s;">
                            <div style="display:flex; gap: 10px; align-items:flex-start;">
                                <input type="radio" name="publicDashboardLayout" value="wireframe1" <%= (publicDashboardLayout || 'wireframe1') === 'wireframe1' ? 'checked' : '' %> style="margin-top: 4px;" />
                                <div>
                                    <div style="font-weight: 700; color:#01535b; margin-bottom: 6px;">Wireframe 1 – Traditional</div>
                                    <div style="color:#666; font-size: 0.88rem; line-height: 1.4; margin-bottom: 8px;">
                                        <strong>Linear / Single Flow</strong><br/>
                                        Hero → Gallery → Articles → Events → Announcements → About Us
                                    </div>
                                    <div style="color:#888; font-size: 0.82rem; line-height: 1.3;">
                                        ✓ Familiar & safe<br/>
                                        ✓ Easy for first-time users<br/>
                                        → Best for: Small schools, static content, MVP
                                    </div>
                                </div>
                            </div>
                        </label>

                        <!-- Wireframe 2 -->
                        <label style="border: 2px solid <%= publicDashboardLayout === 'wireframe2' ? '#01535b' : '#ddd' %>; border-radius: 12px; padding: 16px; background: #fff; cursor: pointer; transition: all 0.2s;">
                            <div style="display:flex; gap: 10px; align-items:flex-start;">
                                <input type="radio" name="publicDashboardLayout" value="wireframe2" <%= publicDashboardLayout === 'wireframe2' ? 'checked' : '' %> style="margin-top: 4px;" />
                                <div>
                                    <div style="font-weight: 700; color:#01535b; margin-bottom: 6px;">Wireframe 2 – Split Dashboard</div>
                                    <div style="color:#666; font-size: 0.88rem; line-height: 1.4; margin-bottom: 8px;">
                                        <strong>Gallery + Events Priority</strong><br/>
                                        Hero → Gallery (left) + Events (right) → Articles → Announcements → About Us
                                    </div>
                                    <div style="color:#888; font-size: 0.82rem; line-height: 1.3;">
                                        ✓ Events visible without scrolling<br/>
                                        ✓ Balanced portal feel<br/>
                                        → Best for: Active schools, event-driven
                                    </div>
                                </div>
                            </div>
                        </label>

                        <!-- Wireframe 3 -->
                        <label style="border: 2px solid <%= publicDashboardLayout === 'wireframe3' ? '#01535b' : '#ddd' %>; border-radius: 12px; padding: 16px; background: #fff; cursor: pointer; transition: all 0.2s;">
                            <div style="display:flex; gap: 10px; align-items:flex-start;">
                                <input type="radio" name="publicDashboardLayout" value="wireframe3" <%= publicDashboardLayout === 'wireframe3' ? 'checked' : '' %> style="margin-top: 4px;" />
                                <div>
                                    <div style="font-weight: 700; color:#01535b; margin-bottom: 6px;">Wireframe 3 – Content-First</div>
                                    <div style="color:#666; font-size: 0.88rem; line-height: 1.4; margin-bottom: 8px;">
                                        <strong>Announcement-Aware</strong><br/>
                                        Hero → Gallery → Articles (center) + Announcements (right) → Events → About Us
                                    </div>
                                    <div style="color:#888; font-size: 0.82rem; line-height: 1.3;">
                                        ✓ Announcements never missed<br/>
                                        ✓ Academic credibility focus<br/>
                                        → Best for: PTA communication, notice-driven
                                    </div>
                                </div>
                            </div>
                        </label>

                        <!-- Wireframe 4 -->
                        <label style="border: 2px solid <%= publicDashboardLayout === 'wireframe4' ? '#01535b' : '#ddd' %>; border-radius: 12px; padding: 16px; background: #fff; cursor: pointer; transition: all 0.2s;">
                            <div style="display:flex; gap: 10px; align-items:flex-start;">
                                <input type="radio" name="publicDashboardLayout" value="wireframe4" <%= publicDashboardLayout === 'wireframe4' ? 'checked' : '' %> style="margin-top: 4px;" />
                                <div>
                                    <div style="font-weight: 700; color:#01535b; margin-bottom: 6px;">Wireframe 4 – Narrative Flow</div>
                                    <div style="color:#666; font-size: 0.88rem; line-height: 1.4; margin-bottom: 8px;">
                                        <strong>Timeline & Storytelling</strong><br/>
                                        Hero → Gallery → Events (timeline) → Announcements (highlights) → About Us (expanded)
                                    </div>
                                    <div style="color:#888; font-size: 0.82rem; line-height: 1.3;">
                                        ✓ Strong storytelling<br/>
                                        ✓ Builds trust & connection<br/>
                                        → Best for: NGOs, donor-facing, public orgs
                                    </div>
                                </div>
                            </div>
                        </label>
                    </div>

                    <div style="display:flex; justify-content:center; margin-top: 20px;">
                        <button type="submit" style="padding: 12px 24px; border-radius: 8px; border: 0; background: var(--org-primary-color, #01535b); color:#fff; font-weight: 700; cursor:pointer; font-size: 1rem;">Save Website Layout</button>
                    </div>
                </form>
            </div>
            if (fileFields.length > 1) {
                button.closest('.file-upload-field').remove();
            } else {
                alert('You must have at least one file upload field.');
            }
        };
        
        document.getElementById('contentUploadForm').addEventListener('submit', function(e) {
            if (contentTypeSelect.value === 'slideshow') {
                const fileInputs = document.querySelectorAll('input[type="file"]');
                if (fileInputs.length < 2) {
                    e.preventDefault();
                    alert('Please upload at least two images or videos for the slideshow.');
                }
            }
        });
        });

        function toggleForm() {
            const forms = document.getElementById('createForms');
            const button = document.getElementById('toggle-create-event-announcement');
            if (forms.style.display === 'none' || forms.style.display === '') {
                forms.style.display = 'block'; // Show the forms
                button.innerText = 'Cancel Creation';
            } else {
                forms.style.display = 'none'; // Hide the forms
                button.innerText = 'Create New Event & Announcement';
            }
        }

        document.addEventListener("DOMContentLoaded", function () {
            // Toggle Create Event Form
            const toggleEventFormButton = document.getElementById("toggle-create-event-form");
            const createEventForm = document.getElementById("createEventForm");
            const closeEventButton = document.getElementById("closeCreateEventForm");

            function hideEventForm() {
                createEventForm.style.display = "none";
                toggleEventFormButton.innerHTML = "<i class='fa-regular fa-square-plus'></i>Create Event";
            }

            function showEventForm() {
                createEventForm.style.display = "block";
                toggleEventFormButton.innerHTML = "<i class='fa-solid fa-ban'></i>Cancel Event Creation";
            }

            toggleEventFormButton.addEventListener("click", function () {
                if (createEventForm.style.display === "none" || createEventForm.style.display === "") {
                    showEventForm();
                } else {
                    hideEventForm();
                }
            });

            closeEventButton.addEventListener("click", function () {
                hideEventForm();
            });

            // Toggle Create Announcement Form
            const toggleAnnouncementFormButton = document.getElementById("toggle-create-announcement-form");
            const createAnnouncementForm = document.getElementById("createAnnouncementForm");
            const closeAnnouncementButton = document.getElementById("closeCreateAnnouncementForm");

            function hideAnnouncementForm() {
                createAnnouncementForm.style.display = "none";
                toggleAnnouncementFormButton.innerHTML = "<i class='fa-regular fa-square-plus'></i>Create Announcement";
            }

            function showAnnouncementForm() {
                createAnnouncementForm.style.display = "block";
                toggleAnnouncementFormButton.innerHTML = "<i class='fa-solid fa-ban'></i>Cancel Announcement Creation";
            }

            toggleAnnouncementFormButton.addEventListener("click", function () {
                if (createAnnouncementForm.style.display === "none" || createAnnouncementForm.style.display === "") {
                    showAnnouncementForm();
                } else {
                    hideAnnouncementForm();
                }
            });

            closeAnnouncementButton.addEventListener("click", function () {
                hideAnnouncementForm();
            });
        });


        // Initialize rich Text Editor
        const quill = new Quill('#rich-text-editor', {
        theme: 'snow',
        modules: {
            toolbar: [
                [{ 'header': [1, 2, 3, false] }], // Header sizes
                ['bold', 'italic', 'underline', 'strike'], // Text styling
                [{ 'color': [] }, { 'background': [] }], // Text and background color
                [{ 'list': 'ordered' }, { 'list': 'bullet' }], // Lists
                [{ 'align': [] }], // Text alignment
                ['link'], // Link upload
                ['clean'] // Remove formatting
            ]
        }
        });

        // Synchronize the content of the rich text editor with the hidden textarea
        const paragraphTextarea = document.getElementById('paragraph');
        quill.on('text-change', function() {
            paragraphTextarea.value = quill.root.innerHTML; // Set Quill's content as the value of the textarea
        });

        // Initialize Quill for each "Update Text" form
        document.querySelectorAll('.text-content-form').forEach(form => {
            const editorDiv = form.querySelector('.rich-text-editor');
            const textarea = form.querySelector('textarea');

            const quillEditor = new Quill(editorDiv, {
                theme: 'snow'
            });

            // Set the initial content of the editor from the textarea
            quillEditor.root.innerHTML = textarea.value;

            // Synchronize the editor's content with the textarea
            quillEditor.on('text-change', function() {
                textarea.value = quillEditor.root.innerHTML;
            });
        });
    </script>


</body>
</html>
