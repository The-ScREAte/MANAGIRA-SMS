        </div>

        <!-- Self Enrollment Settings -->
        <div class="content-container">
            <div class="images-header">
              <h2>⚙️ Self Enrollment Settings</h2>
              <div class="header-actions">
                <button type="button" class="section-collapse-toggle" aria-expanded="true">Collapse</button>
              </div>
            </div>
            <form action="/account/updatePublicRegistration" method="POST" style="max-width: 700px; margin: 0 auto;">
                <div class="form-group">
                  <label class="checkbox-label">
                    <input type="checkbox" name="enabled" <%= orgDetails.public_registration_enabled ? 'checked' : '' %> />
                    Enable Self Enrollment
                  </label>
