        function setPrimaryCardRequest(authorizationCode) {
          return fetch("/account/cards/set-primary", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ authorizationCode }),
          });
        }

        function attachPaymentCardHandlers() {
          document.querySelectorAll(".set-primary-card").forEach((button) => {
            button.addEventListener("click", async () => {
              requestPassword(null, async () => {
                const authorizationCode = button.dataset.id;
                try {
                  const res = await setPrimaryCardRequest(authorizationCode);
                  const data = await res.json();
                  if (data.success) {
                    window.location.reload();
                  } else {
                    alert(data.message || "Failed to update primary card.");
                  }
                } catch (error) {
                  alert("Unable to update the primary card. Try again.");
                }
              });
            });
          });

          document.querySelectorAll(".edit-fallback-card-name").forEach((button) => {
            button.addEventListener("click", () => {
              requestPassword(null, async () => {
                const authorizationCode = button.dataset.id;
                const currentName = button.dataset.currentName || "";
                const nextName = window.prompt(
                  "Set the payout name parents should see for this card. Leave blank to use the school default.",
                  currentName
                );

                if (nextName === null) {
