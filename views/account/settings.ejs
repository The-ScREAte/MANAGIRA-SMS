        function showStripeCardForm() {
          const modal = document.createElement("div");
          modal.className = "card-modal-overlay";
          modal.innerHTML = `
            <div class="card-modal">
              <div class="card-modal-header">
                <h3>Add New Card</h3>
                <button type="button" class="close-modal">&times;</button>
              </div>
              <div class="card-modal-body">
                <p class="status-text" id="stripe-card-status" role="status" aria-live="polite"></p>
                <p class="card-helper-copy">This saves a card to your organization's Stripe customer for future billing. No charge is made while adding the card.</p>
                <form id="stripe-card-form">
                  <div class="form-group">
                    <label for="stripe-card-element">Card Details</label>
                    <div id="stripe-card-element" class="stripe-card-element"></div>
                  </div>
                  <button type="submit" class="btn btn-primary" id="stripe-card-submit">Save Card</button>
                </form>
              </div>
            </div>
          `;

          document.body.appendChild(modal);

          const statusText = modal.querySelector("#stripe-card-status");
          const submitBtn = modal.querySelector("#stripe-card-submit");
          let stripeCard = null;

          function setStatus(message, tone) {
            statusText.textContent = message || "";
            statusText.classList.remove("error", "success");
            if (tone === "error") statusText.classList.add("error");
            if (tone === "success") statusText.classList.add("success");
          }

          function closeStripeModal() {
            if (stripeCard) {
              stripeCard.unmount();
              stripeCard.destroy();
              stripeCard = null;
            }
            if (modal.parentNode) {
              document.body.removeChild(modal);
            }
          }

          if (!stripePublishableKey || typeof Stripe !== "function") {
            setStatus("Stripe is not available right now. Check your Stripe public key and try again.", "error");
            submitBtn.disabled = true;
          } else {
            const stripe = Stripe(stripePublishableKey);
            const stripeElements = stripe.elements();
            stripeCard = stripeElements.create("card", {
              hidePostalCode: true,
            });
            stripeCard.mount(modal.querySelector("#stripe-card-element"));
            stripeCard.on("change", (event) => {
              if (event.error) {
                setStatus(event.error.message, "error");
              } else if (!event.empty) {
                setStatus("");
              }
            });

            modal.querySelector("#stripe-card-form").addEventListener("submit", async (e) => {
              e.preventDefault();

              submitBtn.disabled = true;
              submitBtn.textContent = "Saving...";
              setStatus("Preparing secure card setup...");

              try {
                const intentResponse = await fetch("/account/cards/stripe/setup-intent", {
                  method: "POST",
                  headers: { "Content-Type": "application/json" },
                });
                const intentData = await intentResponse.json();

                if (!intentResponse.ok || !intentData.success || !intentData.clientSecret) {
                  throw new Error(intentData.message || "Unable to initialize Stripe card setup.");
                }

                const confirmation = await stripe.confirmCardSetup(intentData.clientSecret, {
                  payment_method: {
                    card: stripeCard,
                    billing_details: {
                      email: orgEmail || undefined,
                      name: orgName || undefined,
                      phone: orgPhone || undefined,
                    },
                  },
                });

                if (confirmation.error) {
                  throw new Error(confirmation.error.message || "Unable to save this card.");
                }

                const setupIntent = confirmation.setupIntent;
                if (!setupIntent || setupIntent.status !== "succeeded") {
                  throw new Error("Stripe card setup was not completed.");
                }

                const finalizeResponse = await fetch("/account/cards/stripe/complete", {
                  method: "POST",
                  headers: { "Content-Type": "application/json" },
                  body: JSON.stringify({
                    setupIntentId: setupIntent.id,
                  }),
                });
                const finalizeData = await finalizeResponse.json();

                if (!finalizeResponse.ok || !finalizeData.success) {
                  throw new Error(finalizeData.message || "Unable to save the card to billing.");
                }

                setStatus("Card saved successfully.", "success");
                setTimeout(() => {
                  closeStripeModal();
                  window.location.reload();
                }, 700);
              } catch (error) {
                setStatus(error.message || "Error adding card. Please try again.", "error");
                submitBtn.disabled = false;
                submitBtn.textContent = "Save Card";
              }
            });
          }

          modal.querySelector(".close-modal").addEventListener("click", closeStripeModal);
          modal.addEventListener("click", (e) => {
            if (e.target === modal) {
              closeStripeModal();
            }
          });
        }

        let saBanksLoaded = false;
        function loadSaBanks() {
          if (saBanksLoaded) return;
          saBanksLoaded = true;
          const select = document.getElementById("sa-bank-select");
          const nameInput = document.getElementById("sa-bank-name-input");
          const errEl = document.getElementById("sa-bank-load-error");
          fetch("/account/paystack-banks?country=ghana")
            .then((r) => r.json())
            .then((data) => {
              const banks = data.banks || [];
              if (!banks.length) throw new Error("Empty");
              if (select) {
                select.innerHTML = '<option value="">Select bank\u2026</option>';
                banks.forEach((b) => {
                  const opt = document.createElement("option");
                  opt.value = b.name;
                  opt.dataset.code = b.code;
                  opt.textContent = b.name;
                  select.appendChild(opt);
                });
                select.style.display = "";
                if (nameInput) nameInput.style.display = "none";
                select.addEventListener("change", function () {
                  const sel = select.options[select.selectedIndex];
                  const codeEl = document.getElementById("sa-bank-code");
                  if (codeEl) codeEl.value = sel ? (sel.dataset.code || "") : "";
                });
              }
            })
            .catch(() => {
              if (errEl) errEl.style.display = "";
              if (nameInput) nameInput.style.display = "";
              if (select) select.style.display = "none";
            });
        }

        function toggleSchoolAccountFields() {
          if (!schoolAccountType || !schoolAccountBankFields) {
            return;
          }
          const type = schoolAccountType.value;
          const isBank = type === "bank";
          const isMomo = type === "mobile_money";
          const isStripeCard = type === "stripe_card";

          schoolAccountBankFields.style.display = isBank ? "grid" : "none";
          if (schoolAccountMomoFields) {
            schoolAccountMomoFields.style.display = isMomo ? "grid" : "none";
          }
          if (schoolAccountStripeCardFields) {
            schoolAccountStripeCardFields.style.display = isStripeCard ? "block" : "none";
          }

          if (isBank) loadSaBanks();

          // Mount/destroy Stripe card element based on visibility
          if (isStripeCard && stripePublishableKey) {
            if (!saStripeElements) {
              const saStripe = Stripe(stripePublishableKey);
              const saElements = saStripe.elements();
              const saCard = saElements.create("card", { style: { base: { fontSize: "14px" } } });
              const mountTarget = document.getElementById("sa-stripe-card-element");
              if (mountTarget) saCard.mount(mountTarget);
              saStripeElements = { stripe: saStripe, elements: saElements, card: saCard };
            }
          } else {
            if (saStripeElements) {
              saStripeElements.card.unmount();
              saStripeElements = null;
            }
          }

          if (schoolAccountNumber) {
            if (isBank) {
              schoolAccountNumber.setAttribute("required", "required");
            } else {
              schoolAccountNumber.removeAttribute("required");
            }
          }
          if (schoolAccountMomoNumber) {
            if (isMomo) {
              schoolAccountMomoNumber.setAttribute("required", "required");
            } else {
              schoolAccountMomoNumber.removeAttribute("required");
            }
          }
          if (schoolAccountHolder) {
            if (isBank) {
              schoolAccountHolder.setAttribute("required", "required");
            } else {
              schoolAccountHolder.removeAttribute("required");
            }
          }
          if (schoolAccountMomoHolder) {
            if (isMomo) {
              schoolAccountMomoHolder.setAttribute("required", "required");
            } else {
              schoolAccountMomoHolder.removeAttribute("required");
            }
          }
          if (schoolAccountBankNameInput) {
            if (isBank) {
              schoolAccountBankNameInput.setAttribute("required", "required");
            } else {
              schoolAccountBankNameInput.removeAttribute("required");
            }
          }
        }

        function resetSchoolAccountForm() {
          if (schoolAccountForm) {
            schoolAccountForm.reset();
          }
          if (schoolAccountId) {
            schoolAccountId.value = "";
          }
          if (schoolAccountDelete) {
            schoolAccountDelete.style.display = "none";
          }
          const heading = document.getElementById("payout-form-heading");
          if (heading) heading.textContent = "Add Payout Account";
          // Pre-fill business name with org name as default
          const businessNameInput = document.getElementById("sa-business-name");
          if (businessNameInput && !businessNameInput.value) {
            businessNameInput.value = "<%= (org && org.organization_name) ? org.organization_name : '' %>";
          }
          toggleSchoolAccountFields();
        }

        if (schoolAccountType) {
          schoolAccountType.addEventListener("change", toggleSchoolAccountFields);
          toggleSchoolAccountFields();
        }

        if (schoolAccountReset) {
          schoolAccountReset.addEventListener("click", hidePayoutForm);
        }

        document.querySelectorAll(".edit-school-account").forEach((button) => {
          button.addEventListener("click", async () => {
            requestPassword(null, async () => {
              const id = button.dataset.id;
              // Open the payment modal on the payout tab
              openModal(paymentModal);
              switchPmTab("payout");
              showPayoutForm();
              try {
                const res = await fetch(`/account/paystack/${id}`);
                const data = await res.json();
                if (!data.success) {
                  alert("Failed to load account details.");
                  return;
                }

                const account = data.account;
                if (schoolAccountId) schoolAccountId.value = account.id;
                if (schoolAccountType) schoolAccountType.value = account.account_type;
                if (schoolAccountBusinessName) schoolAccountBusinessName.value = account.business_name || "";

                if (account.account_type === "bank") {
                  if (schoolAccountNumber) schoolAccountNumber.value = account.account_number || "";
                  if (schoolAccountHolder) schoolAccountHolder.value = account.account_holder_name || "";
                  if (schoolAccountBankNameInput) schoolAccountBankNameInput.value = account.bank_name || "";
                  // routing_number, country, currency not stored — leave as defaults
                } else if (account.account_type === "mobile_money") {
                  if (schoolAccountMomoNumber) schoolAccountMomoNumber.value = account.momo_number || "";
                  if (schoolAccountMomoProvider) schoolAccountMomoProvider.value = account.momo_provider || "";
                  if (schoolAccountMomoHolder) schoolAccountMomoHolder.value = account.account_holder_name || "";
                }
                // stripe_card accounts: card details come from Stripe; no local fields to fill

                toggleSchoolAccountFields();
                if (schoolAccountDelete) {
                  schoolAccountDelete.style.display = "inline-flex";
                }
                const heading = document.getElementById("payout-form-heading");
                if (heading) heading.textContent = "Edit Payout Account";
              } catch (error) {
                alert("Unable to load account. Try again.");
              }
            });
          });
        });

        document.querySelectorAll(".set-school-primary").forEach((button) => {
          button.addEventListener("click", async () => {
            requestPassword(null, async () => {
              const id = button.dataset.id;
              const type = button.dataset.type;
              try {
                const res = await fetch("/account/paystack/set-primary", {
                  method: "POST",
                  headers: { "Content-Type": "application/json" },
                  body: JSON.stringify({ id, account_type: type }),
                });
                const data = await res.json();
                if (data.success) {
                  window.location.reload();
                } else {
                  alert(data.message || "Failed to update primary account.");
                }
              } catch (error) {
                alert("Unable to update primary account. Try again.");
              }
            });
          });
        });

        if (schoolAccountDelete) {
          schoolAccountDelete.addEventListener("click", async () => {
            requestPassword(null, async () => {
              const id = schoolAccountId ? schoolAccountId.value : "";
              if (!id) return;
              if (!confirm("Delete this account?")) return;
              try {
                const res = await fetch(`/account/paystack/${id}`, { method: "DELETE" });
                const data = await res.json();
                if (data.success) {
                  window.location.reload();
                } else {
                  alert(data.message || "Failed to delete account.");
                }
              } catch (error) {
                alert("Unable to delete account. Try again.");
              }
            });
          });
        }

        function saSetStatus(msg, ok) {
          const el = document.getElementById("sa-status");
          if (!el) return;
          el.textContent = msg;
          el.style.color = ok ? "#15803d" : "#dc2626";
        }
        function saSetBusy(busy) {
          const btn = document.getElementById("sa-submit-btn");
          if (btn) { btn.disabled = busy; btn.textContent = busy ? "Saving…" : "Save Account"; }
        }

                if (schoolAccountForm) {
          schoolAccountForm.addEventListener("submit", async (event) => {
            event.preventDefault();
            saSetStatus("", true);
            saSetBusy(true);
            (async () => {
              const formData = new FormData(schoolAccountForm);
              const payload = Object.fromEntries(formData.entries());
              const isEditing = payload.id && payload.id !== "";

              // JS validation (form has novalidate — we validate here instead)
              if (!payload.account_type) { saSetStatus("Please select an account type.", false); saSetBusy(false); return; }
              if (!payload.business_name || !payload.business_name.trim()) { saSetStatus("Business name is required.", false); saSetBusy(false); return; }
              if (payload.account_type === "bank" && !payload.account_number) { saSetStatus("Account number is required.", false); saSetBusy(false); return; }
              if (payload.account_type === "mobile_money" && !payload.momo_number) { saSetStatus("Mobile money number is required.", false); saSetBusy(false); return; }

              // ─── Bank account via Paystack (direct) ────────────────────────
              if (payload.account_type === "bank") {
                const select = document.getElementById("sa-bank-select");
                const nameInput = document.getElementById("sa-bank-name-input");
                const codeEl = document.getElementById("sa-bank-code");
                if (select && select.style.display !== "none") {
                  const sel = select.options[select.selectedIndex];
                  payload.bank_name = sel ? sel.value : "";
                  payload.bank_code = codeEl ? codeEl.value : (sel ? (sel.dataset.code || "") : "");
                } else if (nameInput) {
                  payload.bank_name = nameInput.value;
                  payload.bank_code = codeEl ? codeEl.value : payload.bank_name;
                }
                const url = isEditing ? "/account/paystack" : "/account/add-paystack-subaccount";
                const method = isEditing ? "PUT" : "POST";
                try {
                  const res = await fetch(url, { method, headers: { "Content-Type": "application/json" }, body: JSON.stringify(payload) });
                  const data = await res.json();
                  if (data.success) { saSetStatus("✓ Account saved.", true); saSetBusy(false); setTimeout(() => window.location.reload(), 800); }
                  else { saSetStatus(data.message || "Failed to save bank account.", false); saSetBusy(false); }
                } catch (err) {
                  saSetStatus(err.message || "Unable to save bank account. Try again.", false); saSetBusy(false);
                }
                return;
              }

              if (payload.account_type === "mobile_money") {
                const momoProvider = document.getElementById("sa-momo-provider");
                const momoNumber = document.getElementById("sa-momo-number");
                const momoHolder = document.getElementById("sa-momo-holder");
                payload.momo_provider = momoProvider ? momoProvider.value : "";
                payload.momo_number = momoNumber ? momoNumber.value : "";
                payload.account_holder_name = momoHolder ? momoHolder.value : payload.account_holder_name;
                const url = isEditing ? "/account/paystack" : "/account/add-paystack-subaccount";
                const method = isEditing ? "PUT" : "POST";
                try {
                  const res = await fetch(url, { method, headers: { "Content-Type": "application/json" }, body: JSON.stringify(payload) });
                  const data = await res.json();
                  if (data.success) { saSetStatus("✓ Account saved.", true); saSetBusy(false); setTimeout(() => window.location.reload(), 800); }
                  else { saSetStatus(data.message || "Failed to save mobile money account.", false); saSetBusy(false); }
                } catch (err) {
                  saSetStatus(err.message || "Unable to save mobile money account. Try again.", false); saSetBusy(false);
                }
                return;
              }

              // ─── Stripe Card flow ───────────────────────────────────────────
              if (payload.account_type === "stripe_card") {
                if (!stripePublishableKey || !saStripeElements) {
                  alert("Stripe is not available. Please select Stripe Card type again.");
                  return;
                }
                const { stripe, card } = saStripeElements;
                const errEl = document.getElementById("sa-stripe-card-errors");

                try {
                  // Step 1: get SetupIntent client secret
                  const intentRes = await fetch("/account/cards/stripe/setup-intent", {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                  });
                  const intentData = await intentRes.json();
                  if (!intentRes.ok || !intentData.success) {
                    throw new Error(intentData.message || "Unable to start card setup.");
                  }

                  // Step 2: confirm card with Stripe.js (no charge)
                  const { setupIntent, error: stripeErr } = await stripe.confirmCardSetup(
                    intentData.clientSecret,
                    { payment_method: { card } }
                  );
                  if (stripeErr) throw new Error(stripeErr.message);
                  if (setupIntent.status !== "succeeded") throw new Error("Card setup did not complete.");

                  // Step 3: save to paystack_subaccounts as stripe_card
                  const saveRes = await fetch("/account/paystack/stripe-card", {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify({
                      setupIntentId: setupIntent.id,
                      business_name: payload.business_name,
                    }),
                  });
                  const saveData = await saveRes.json();
                  if (!saveRes.ok || !saveData.success) throw new Error(saveData.message || "Failed to save card.");

                  saSetStatus("✓ Card saved.", true); saSetBusy(false); setTimeout(() => window.location.reload(), 800);
                } catch (err) {
                  saSetBusy(false);
                  if (errEl) errEl.textContent = err.message || "Error saving Stripe card.";
                  else alert(err.message || "Error saving Stripe card.");
                }
                return;
              }
            })();
          });
        }

        if (planOptions.length && selectedPlanInput) {
          const currentPlanId = selectedPlanInput.value;
          let selectedPlanName = "";
          const billingPeriodInput = document.getElementById("selectedBillingPeriod");
          const periodCards = Array.from(document.querySelectorAll(".modal-period-card"));
          const updatePlanBtn = document.getElementById("updatePlanBtn");
          const planPricingSummary = document.getElementById("planPricingSummary");
          const currentBillingKey = <%- JSON.stringify((typeof billingInfo !== 'undefined' && billingInfo && billingInfo.billing_period_key) ? billingInfo.billing_period_key : '') %>;
          let planChanged = false;
          let billingCycleChanged = false;

          function formatUsd(value) {
            const numeric = Number(value || 0);
            return "$" + numeric.toFixed(2);
          }

          const currentSelectedOption = planOptions.find(
            (option) => String(option.dataset.planId || "") === String(selectedPlanInput.value || "")
          );
          if (currentSelectedOption) {
            selectedPlanName = currentSelectedOption.dataset.planName || "this plan";
          }

          function getSelectedPlanBaseUsd() {
            const selected = planOptions.find((o) => o.classList.contains("selected"));
            if (selected) return parseFloat(selected.dataset.baseUsd) || 0;
            // Fall back to current plan
            const current = planOptions.find((o) => o.classList.contains("disabled"));
            if (current) return parseFloat(current.dataset.baseUsd) || 0;
            return 0;
          }

          function updateModalPeriodPrices() {
            const baseUsd = getSelectedPlanBaseUsd();
            periodCards.forEach(function(card) {
              const months = parseInt(card.dataset.months) || 1;
              const discount = parseInt(card.dataset.discount) || 0;
              const priceEl = card.querySelector("[data-period-price]");
              if (!priceEl) return;
              if (baseUsd <= 0) { priceEl.innerHTML = ""; return; }

              const raw = baseUsd * months;
              const final_ = discount > 0 ? raw * (1 - discount / 100) : raw;
              const perMo = final_ / months;

              if (months === 1) {
                priceEl.innerHTML = "$" + baseUsd.toFixed(2) + "/mo";
              } else if (discount > 0) {
                priceEl.innerHTML = '<span class="period-price-strike">$' + raw.toFixed(2) + "</span> $" + final_.toFixed(2)
                  + '<span style="display:block;font-size:11px;color:#5f6b7a;margin-top:1px;">~$' + perMo.toFixed(2) + "/mo</span>";
              } else {
                priceEl.innerHTML = "$" + final_.toFixed(2) + " (~$" + perMo.toFixed(2) + "/mo)";
              }
            });
            updatePlanPricingSummary();
          }

          function updatePlanFooterPrices() {
            planOptions.forEach(function(option) {
              const base = parseFloat(option.dataset.baseUsd) || 0;
              const footer = option.querySelector(".plan-option-footer");
              if (!footer) return;
              const localizedMonthly = option.dataset.localizedMonthly || "";
              footer.innerHTML = formatUsd(base) + "/mo" + (localizedMonthly && localizedMonthly !== formatUsd(base) ? '<span class="plan-option-footer-sub">≈ ' + localizedMonthly + '/mo</span>' : '');
            });
          }

          function updatePlanPricingSummary() {
            if (!planPricingSummary) return;
            const selected = planOptions.find((o) => o.classList.contains("selected")) || planOptions.find((o) => o.classList.contains("disabled"));
            if (!selected) {
              planPricingSummary.innerHTML = "";
              return;
            }

            const activeCard = periodCards.find((c) => c.classList.contains("active"));
            const months = activeCard ? (parseInt(activeCard.dataset.months) || 1) : 1;
            const discount = activeCard ? (parseInt(activeCard.dataset.discount) || 0) : 0;
            const cycleName = activeCard
              ? ((activeCard.querySelector('.modal-period-card-label')?.textContent || '').trim() || 'Monthly')
              : 'Monthly';
            const monthlyUsd = parseFloat(selected.dataset.baseUsd) || 0;
            const cycleTotal = discount > 0 ? (monthlyUsd * months) * (1 - discount / 100) : (monthlyUsd * months);
            const perMonth = months > 0 ? cycleTotal / months : monthlyUsd;
            const pricingMode = selected.dataset.pricingMode || 'flat';
            const regionName = selected.dataset.regionName || 'Default Region';
            const studentCount = parseInt(selected.dataset.studentCount || '0', 10) || 0;
            const threshold = parseInt(selected.dataset.threshold || '0', 10);
            const extraStudents = parseInt(selected.dataset.extraStudents || '0', 10) || 0;
            const summaryStateClass = pricingMode === 'dynamic'
              ? (extraStudents > 0 ? 'is-warn' : 'is-ok')
              : 'is-flat';

            const freeThreshold = threshold > 0 ? threshold : 50;
            const regionLine = `Region: ${regionName} • First ${freeThreshold} students are free.`;
            const additionalLine = pricingMode === 'dynamic'
              ? (extraStudents > 0
                  ? `Additional charges are currently active because your student count is above ${freeThreshold}.`
                  : `Additional charges are not active because your student count is within the free ${freeThreshold}.`)
              : 'Additional charges follow flat pricing for your region.';
            const monthlyLine = `Monthly price at your current student count: ${formatUsd(monthlyUsd)}/mo.`;

            planPricingSummary.classList.remove('is-ok', 'is-warn', 'is-flat');
            planPricingSummary.classList.add(summaryStateClass);

            planPricingSummary.innerHTML =
              '<div class="plan-modal-summary-title">' + (selected.dataset.planName || 'Selected plan') + ' pricing at your current size</div>'
              + '<div class="plan-modal-summary-points">'
              + '<div class="plan-modal-summary-point"><strong>' + regionLine + '</strong></div>'
              + '<div class="plan-modal-summary-point">' + additionalLine + '</div>'
              + '<div class="plan-modal-summary-point">' + monthlyLine + '</div>'
              + '</div>'
              + '<div class="plan-modal-summary-sub">Billing cycle name: ' + cycleName + ' • Discount: ' + discount + '% • Selected cycle total: ' + formatUsd(cycleTotal) + ' (~' + formatUsd(perMonth) + '/mo)</div>';
          }

          function updateSubmitState() {
            if (!updatePlanBtn) return;
            updatePlanBtn.disabled = !(planChanged || billingCycleChanged);
          }

          function selectPeriodCard(card) {
            periodCards.forEach(function(c) {
              c.classList.remove("active");
              c.setAttribute("aria-checked", "false");
            });
            card.classList.add("active");
            card.setAttribute("aria-checked", "true");
            if (billingPeriodInput) billingPeriodInput.value = card.dataset.key;
            billingCycleChanged = card.dataset.key !== currentBillingKey;
            updatePlanFooterPrices();
            updateModalPeriodPrices();
            updateSubmitState();
          }

          // Plan card click
          planOptions.forEach((option) => {
            option.addEventListener("click", () => {
              const planId = option.dataset.planId;
              if (planId === currentPlanId) {
                // Re-selecting current plan (deselect any other)
                planOptions.forEach((plan) => plan.classList.remove("selected"));
                selectedPlanInput.value = currentPlanId;
                planChanged = false;
                updateModalPeriodPrices();
                updatePlanFooterPrices();
                updateSubmitState();
                return;
              }

              planOptions.forEach((plan) => plan.classList.remove("selected"));
              option.classList.add("selected");
              selectedPlanInput.value = planId;
              selectedPlanName = option.dataset.planName || "this plan";
              planChanged = true;
              updateModalPeriodPrices();
              updatePlanFooterPrices();
              updateSubmitState();
            });
          });

          // Billing period card click
          periodCards.forEach(function(card) {
            card.addEventListener("click", function() { selectPeriodCard(this); });
            card.addEventListener("keydown", function(e) {
              if (e.key === "Enter" || e.key === " ") { e.preventDefault(); selectPeriodCard(this); }
            });
          });

          // Initial price calculation
          updateModalPeriodPrices();
          updatePlanFooterPrices();
          updatePlanPricingSummary();

          if (planForm) {
            planForm.addEventListener("submit", (event) => {
              event.preventDefault();
              if (!planChanged && !billingCycleChanged) {
                alert("Please select a different plan or billing cycle before proceeding.");
                return;
              }

              // Build confirmation message
              let confirmMsg = "";
              if (planChanged) {
                confirmMsg += 'You are about to change your plan to "' + selectedPlanName + '".';
              }
              if (billingCycleChanged) {
                const activeCard = periodCards.find((c) => c.classList.contains("active"));
                const newLabel = activeCard ? activeCard.querySelector(".modal-period-card-label").textContent : "selected cycle";
                confirmMsg += (confirmMsg ? " " : "") + "Your billing cycle will change to " + newLabel + ".";
              }
              confirmMsg += " Continue?";

              closeModal(planModal);

              requestPassword(null, () => {
                if (confirm(confirmMsg)) {
                  planForm.submit();
                }
              });
            });
          }
        }

        const securityEmailForm = document.getElementById("security-email-form");
        const securityPasswordForm = document.getElementById("security-password-form");

        if (securityEmailForm) {
          securityEmailForm.addEventListener("submit", (event) => {
            event.preventDefault();
            requestPassword(null, () => securityEmailForm.submit());
          });
        }

        if (securityPasswordForm) {
          securityPasswordForm.addEventListener("submit", (event) => {
            event.preventDefault();
            requestPassword(null, () => securityPasswordForm.submit());
          });
        }

        const themeRefreshKey = "theme-hard-refresh-applied";
        const urlParams = new URLSearchParams(window.location.search);

        if (urlParams.get("themeApplied") === "1") {
          const alreadyRefreshed = sessionStorage.getItem(themeRefreshKey) === "1";

          if (!alreadyRefreshed) {
            sessionStorage.setItem(themeRefreshKey, "1");
            const forcedUrl = new URL(window.location.href);
            forcedUrl.searchParams.set("_themeRefreshTs", String(Date.now()));
            window.location.replace(forcedUrl.toString());
            return;
          }

          sessionStorage.removeItem(themeRefreshKey);
          const cleanUrl = new URL(window.location.href);
          cleanUrl.searchParams.delete("themeApplied");
          cleanUrl.searchParams.delete("_themeRefreshTs");
          window.history.replaceState({}, "", cleanUrl.toString());
        }

        const finalParams = new URLSearchParams(window.location.search);
        const initialSection = finalParams.get("section") || "<%= _defaultSettingsSectionId %>";
        showSection(initialSection, { scroll: false });
      });
    })();
    </script>
  </body>
</html>
