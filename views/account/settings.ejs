        let metaSdkPromise = null;
        function loadMetaSdk() {
          if (window.FB) {
            return Promise.resolve(window.FB);
          }
          if (metaSdkPromise) {
            return metaSdkPromise;
          }

          metaSdkPromise = new Promise((resolve, reject) => {
            const appId = String(whatsappFrontendConfig.appId || "").trim();
            if (!appId) {
              reject(new Error("META_APP_ID is not configured on the server."));
              return;
            }

            const sdkId = "meta-jssdk";
            const existingScript = document.getElementById(sdkId);
            const completeInit = () => {
              if (!window.FB) {
                reject(new Error("Meta SDK failed to load."));
                return;
              }
              try {
                window.FB.init({
                  appId,
                  autoLogAppEvents: true,
                  xfbml: false,
                  version: String(whatsappFrontendConfig.graphApiVersion || "v21.0"),
                });
              } catch (err) {
                reject(new Error(err?.message || "Unable to initialize Meta SDK."));
                return;
              }
              resolve(window.FB);
            };

            if (existingScript) {
              if (window.FB) {
                completeInit();
              } else {
                existingScript.addEventListener("load", completeInit, { once: true });
                existingScript.addEventListener("error", () => reject(new Error("Unable to load Meta SDK script.")), { once: true });
              }
              return;
            }

            const script = document.createElement("script");
            script.id = sdkId;
            script.async = true;
            script.defer = true;
            script.src = "https://connect.facebook.net/en_US/sdk.js";
            script.onload = completeInit;
            script.onerror = () => reject(new Error("Unable to load Meta SDK script."));
            document.head.appendChild(script);
          });

          return metaSdkPromise;
        }

        async function openWhatsappEmbeddedSignupPopup() {
          const configId = String(whatsappFrontendConfig.embeddedSignupConfigId || "").trim();
          if (!configId) {
            throw new Error("WHATSAPP_EMBEDDED_SIGNUP_CONFIG_ID is not configured on the server.");
          }

          const FB = await loadMetaSdk();

          return new Promise((resolve, reject) => {
            let signupPayload = {};
            const capturedMetaPayloads = [];

            const extractWhatsappSignupFields = (source, depth = 0) => {
              if (!source || typeof source !== "object" || depth > 6) return {};

              const out = {};
              const directWabaId = String(
                source.waba_id || source.wabaId || source.whatsapp_business_account_id || ""
              ).trim();
              const directPhoneId = String(
                source.phone_number_id || source.phoneNumberId || source.whatsapp_phone_number_id || ""
              ).trim();
              const directDisplayPhone = String(
                source.display_phone_number || source.displayPhoneNumber || ""
              ).trim();
              const directBusinessName = String(
                source.business_name || source.businessName || source.business_display_name || ""
              ).trim();
              const directTimezone = String(source.timezone || "").trim();

              if (directWabaId) out.wabaId = directWabaId;
              if (directPhoneId) out.phoneNumberId = directPhoneId;
              if (directDisplayPhone) out.displayPhoneNumber = directDisplayPhone;
              if (directBusinessName) out.businessName = directBusinessName;
              if (directTimezone) out.timezone = directTimezone;

              Object.keys(source).forEach((key) => {
                const value = source[key];
                if (!value) return;
                if (typeof value === "string") {
                  const trimmed = value.trim();
                  if (trimmed.startsWith("{") || trimmed.startsWith("[")) {
                    try {
                      const parsedValue = JSON.parse(trimmed);
                      const nestedFromString = extractWhatsappSignupFields(parsedValue, depth + 1);
                      if (nestedFromString.wabaId && !out.wabaId) out.wabaId = nestedFromString.wabaId;
                      if (nestedFromString.phoneNumberId && !out.phoneNumberId) out.phoneNumberId = nestedFromString.phoneNumberId;
                      if (nestedFromString.displayPhoneNumber && !out.displayPhoneNumber) out.displayPhoneNumber = nestedFromString.displayPhoneNumber;
                      if (nestedFromString.businessName && !out.businessName) out.businessName = nestedFromString.businessName;
                      if (nestedFromString.timezone && !out.timezone) out.timezone = nestedFromString.timezone;
                    } catch (_) {}
                  }
                  return;
                }
                if (typeof value !== "object") return;
                const nested = extractWhatsappSignupFields(value, depth + 1);
                if (nested.wabaId && !out.wabaId) out.wabaId = nested.wabaId;
                if (nested.phoneNumberId && !out.phoneNumberId) out.phoneNumberId = nested.phoneNumberId;
                if (nested.displayPhoneNumber && !out.displayPhoneNumber) out.displayPhoneNumber = nested.displayPhoneNumber;
                if (nested.businessName && !out.businessName) out.businessName = nested.businessName;
                if (nested.timezone && !out.timezone) out.timezone = nested.timezone;
              });

              return out;
            };

            const mergeSignupFields = (source) => {
              const parsed = extractWhatsappSignupFields(source);
              if (parsed.wabaId) signupPayload.wabaId = parsed.wabaId;
              if (parsed.phoneNumberId) signupPayload.phoneNumberId = parsed.phoneNumberId;
              if (parsed.displayPhoneNumber) signupPayload.displayPhoneNumber = parsed.displayPhoneNumber;
              if (parsed.businessName) signupPayload.businessName = parsed.businessName;
              if (parsed.timezone) signupPayload.timezone = parsed.timezone;
            };

            const consumeMessage = (event) => {
              if (!event || !event.data) return;
              let data = event.data;
              if (typeof data === "string") {
                try {
                  data = JSON.parse(data);
                } catch (_) {
                  return;
                }
              }
              if (!data || typeof data !== "object") return;

              const raw = data.data && typeof data.data === "object" ? data.data : data;
              const eventName = String(data.type || data.event || raw.event || "").toLowerCase();
              const looksLikeWhatsapp =
                eventName.includes("whatsapp") ||
                eventName.includes("embedded") ||
                raw.waba_id ||
                raw.phone_number_id ||
                raw.display_phone_number;

              if (!looksLikeWhatsapp) return;

              if (capturedMetaPayloads.length < 24) {
                capturedMetaPayloads.push(data);
              }

              mergeSignupFields(raw);
              mergeSignupFields(data);
            };

            window.addEventListener("message", consumeMessage);

            FB.login((response) => {
              if (!response || !response.authResponse) {
                window.removeEventListener("message", consumeMessage);
                reject(new Error("Meta signup was cancelled or did not complete."));
                return;
              }

              const code = String(response.authResponse.code || "").trim();
              if (!code) {
                window.removeEventListener("message", consumeMessage);
                reject(new Error("Meta did not return an authorization code."));
                return;
              }

              mergeSignupFields(response.extraData && typeof response.extraData === "object" ? response.extraData : {});
              mergeSignupFields(response.authResponse && typeof response.authResponse === "object" ? response.authResponse : {});

              // Meta postMessage payload can arrive just after the login callback on mobile Safari.
              setTimeout(() => {
                window.removeEventListener("message", consumeMessage);
                resolve({
                  code,
                  wabaId: String(signupPayload.wabaId || "").trim(),
                  phoneNumberId: String(signupPayload.phoneNumberId || "").trim(),
                  displayPhoneNumber: String(signupPayload.displayPhoneNumber || "").trim(),
                  businessName: String(signupPayload.businessName || "").trim(),
                  timezone: String(signupPayload.timezone || Intl.DateTimeFormat().resolvedOptions().timeZone || "").trim(),
                  signupPayload: {
                    merged: signupPayload,
                    messages: capturedMetaPayloads,
                    extraData: response.extraData && typeof response.extraData === "object" ? response.extraData : null,
                    authResponse: response.authResponse && typeof response.authResponse === "object" ? response.authResponse : null,
                  },
                });
              }, 2500);
            }, {
              config_id: configId,
              response_type: "code",
              override_default_response_type: true,
              extras: {
                feature: "whatsapp_embedded_signup",
              },
            });
          });
        }

        async function connectWhatsappIntegration() {
          if (!whatsappConnectLink && !whatsappConnectCta) return;
          if (!hasWhatsappMetaConfig) {
            const msg = "WhatsApp connect is not configured on this server yet. Missing META_APP_ID, META_APP_SECRET, or WHATSAPP_EMBEDDED_SIGNUP_CONFIG_ID.";
            setWhatsappInlineError(msg);
            window.alert(msg);
            return;
          }

          if (redirectWhatsappConnectToCanonicalHost()) {
            setWhatsappInlineError("Switching to your canonical domain to continue WhatsApp connection...");
            return;
          }

          setWhatsappInlineError("");
          if (whatsappConnectLink) {
            whatsappConnectLink.setAttribute("aria-disabled", "true");
            whatsappConnectLink.style.pointerEvents = "none";
            whatsappConnectLink.textContent = "Connecting...";
          }
          let previousCtaLabel = "Connect WhatsApp";
          if (whatsappConnectCta) {
            whatsappConnectCta.setAttribute("aria-disabled", "true");
            whatsappConnectCta.style.pointerEvents = "none";
            previousCtaLabel = whatsappConnectCta.textContent || previousCtaLabel;
            whatsappConnectCta.textContent = "Connecting...";
          }

          try {
            const signupResult = await openWhatsappEmbeddedSignupPopup();
            const response = await fetch("/account/whatsapp/connect", {
              method: "POST",
              headers: {
                "Content-Type": "application/json",
                "Accept": "application/json",
                "X-Requested-With": "XMLHttpRequest",
              },
              body: JSON.stringify(signupResult),
            });

            const result = await response.json().catch(() => ({}));
            if (!response.ok || !result.success) {
              throw new Error(result.message || "Unable to finish WhatsApp setup.");
            }

            const integration = result.integration || {};
            setWhatsappUiState(Boolean(integration.activated), Boolean(integration.connected));
            setWhatsappInlineError("");
            const redirectUrl = "/account/settings?section=integrations&whatsappConnected=1";
            window.location.assign(redirectUrl);
            return;
          } catch (error) {
            const message = error?.message || "Unable to connect WhatsApp right now.";
            setWhatsappInlineError(message);
            window.alert(message);
          } finally {
            if (whatsappConnectLink) {
              whatsappConnectLink.removeAttribute("aria-disabled");
              whatsappConnectLink.style.pointerEvents = "";
            }
            if (whatsappConnectCta) {
              whatsappConnectCta.removeAttribute("aria-disabled");
              whatsappConnectCta.style.pointerEvents = "";
            }
            const connectedNow = Boolean(whatsappStatusPill && whatsappStatusPill.dataset.connected === "1");
            const nextLabel = connectedNow ? "Reconnect WhatsApp" : (previousCtaLabel || "Connect WhatsApp");
            if (whatsappConnectLink) whatsappConnectLink.textContent = nextLabel;
            if (whatsappConnectCta) whatsappConnectCta.textContent = nextLabel;
          }
        }

