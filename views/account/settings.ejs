          </div>


            <%
              const smsi = (typeof smsIntegration !== 'undefined' && smsIntegration) ? smsIntegration : { activeProvider: '', providers: {} };
              const smsProviders = smsi.providers || {};
              const smsCardDefs = [
                {
                  key: 'twilio',
                  label: 'Twilio SMS',
                  logo: '/images/twilio.png',
                  description: "Text parents and staff from your school's own Twilio number. Your Twilio account pays for each message.",
                },
                {
                  key: 'arkesel',
                  label: 'Arkesel SMS',
                  logo: '/images/arkesel.png',
                  description: "Text parents and staff in Ghana from your school's own Arkesel account. Your Arkesel wallet pays for each message.",
                },
                {
                  key: 'africastalking',
                  label: "Africa's Talking SMS",
                  logo: '/images/africantalking.png',
                  description: "Text parents and staff across Africa from your school's own Africa's Talking account. Your account pays for each message.",
                },
              ];
            %>
            <% smsCardDefs.forEach((def) => { %>
            <% const ps = smsProviders[def.key] || { activated: false, configured: false, lastError: '' }; %>
            <% const psActivated = !!ps.activated; %>
            <% const psConfigured = !!ps.configured; %>
            <% const psIsActive = smsi.activeProvider === def.key; %>
            <div class="card sms-provider-card" data-sms-provider="<%= def.key %>">
              <h4>
                <span class="student-portal-title">
                  <span class="sms-provider-logo-chip">
                    <img src="<%= def.logo %>" alt="<%= def.label %> logo" />
                  </span>
                  <span><%= def.label %></span>
                </span>
                <span
                  class="pill sms-status-pill"
                  data-activated="<%= psActivated ? '1' : '0' %>"
                  style="background:<%= psIsActive ? '#dcfce7' : '#fef3c7' %>;color:<%= psIsActive ? '#166534' : '#92400e' %>">
                  <%= psIsActive ? 'Active' : (psConfigured ? 'Configured (Inactive)' : (psActivated ? 'Setup Required' : 'Inactive')) %>
                </span>
                <%- integrationCoverageBadge(def.key) %>
              </h4>
              <small class="google-integration-description">
                <%= def.description %>
                <% if (ps.lastError) { %><br><span style="color:#b91c1c;">Last error: <%= ps.lastError %></span><% } %>
                <%- integrationActivityLine(def.label) %>
              </small>

              <div class="google-integration-toolbar">
                <div class="google-integration-actions">
                  <a href="#" class="integration-readmore-link" data-integration="<%= def.key %>">Read more</a>
                  <details class="google-actions-menu" style="display:inline-flex !important;align-items:center !important;">
                    <summary class="google-actions-toggle" aria-label="<%= def.label %> actions"><i class="fa-solid fa-ellipsis-vertical" aria-hidden="true"></i></summary>
                    <div class="google-actions-menu-list">
                      <% if (def.key === 'twilio' && !twilioAvailableForCountry && !psActivated) { %>
                      <span class="google-action-item" aria-disabled="true" style="color:#b91c1c;cursor:not-allowed;">Unavailable in Africa</span>
                      <% } else { %>
                      <a class="google-action-item sms-open-activate" href="#" data-provider="<%= def.key %>" style="display:<%= psActivated ? 'none' : 'block' %>">Activate</a>
                      <% } %>
                      <a class="google-action-item sms-open-deactivate" href="#" data-provider="<%= def.key %>" style="display:<%= psActivated ? 'block' : 'none' %>">Deactivate</a>
                    </div>
                  </details>
                </div>
              </div>

              <% if (psActivated) { %>

              <div style="display:flex;gap:10px;flex-wrap:wrap;margin-top:14px;">
                <% if (psConfigured) { %>
                <button type="button" class="btn-link sms-check-button" data-provider="<%= def.key %>" style="font-size:12.5px;padding:6px 10px;">
                  Test connection
                </button>
                <button type="button" class="btn-link sms-compose-toggle" data-provider="<%= def.key %>" style="font-size:12.5px;padding:6px 10px;">
                  Send a test text
                </button>
                <% } %>
                <button type="button" class="btn-link sms-config-toggle" data-provider="<%= def.key %>" style="font-size:12.5px;padding:6px 10px;">
                  <%= psConfigured ? 'Edit Credentials' : 'Configure Credentials' %>
                </button>
              </div>

              <small class="sms-check-result" data-provider="<%= def.key %>" hidden style="display:block;margin-top:8px;font-weight:600;"></small>
              <div class="sms-panel-row" style="display:grid;grid-template-columns:repeat(auto-fit, minmax(260px, 1fr));gap:12px;margin-top:10px;">
                <% if (psConfigured) { %>
                <div class="sms-compose-panel" data-provider="<%= def.key %>" style="display:none;padding:12px;border:1px solid #e2e8f0;border-radius:12px;background:#fff;">
                  <div style="display:grid;gap:8px;">
                    <div>
                      <label class="form-label" for="sms-<%= def.key %>-send-recipient" style="margin-bottom:3px;">Recipient<span class="form-required-mark">*</span></label>
                      <input id="sms-<%= def.key %>-send-recipient" class="form-input sms-test-recipient" data-provider="<%= def.key %>" type="tel" placeholder="<%= def.key === 'twilio' ? '+15551234567' : '+233551234567' %>" />
                    </div>
                    <div>
                      <label class="form-label" for="sms-<%= def.key %>-send-message" style="margin-bottom:3px;">Message<span class="form-required-mark">*</span></label>
                      <textarea id="sms-<%= def.key %>-send-message" class="form-input sms-test-message" data-provider="<%= def.key %>" rows="3" maxlength="480" placeholder="Type your message...">Test text from your school on Managira.</textarea>
                    </div>
                    <div style="display:flex;gap:8px;flex-wrap:wrap;align-items:center;">
                      <button class="btn-primary btn-link sms-test-button" type="button" data-provider="<%= def.key %>">Send</button>
                      <small class="sms-settings-status" data-provider="<%= def.key %>" style="color:#64748b;">
                        <%= psIsActive ? 'Active — new sends from Managira use this provider.' : 'Saved, but another provider is active.' %>
                      </small>
                    </div>
                    <small style="color:#94a3b8;"><span class="form-required-mark">*</span> Required</small>
                  </div>
                </div>
                <% } %>

                <div class="sms-config-panel" data-provider="<%= def.key %>" style="display:<%= psConfigured ? 'none' : 'block' %>;padding:12px;border:1px solid #e2e8f0;border-radius:12px;background:#fff;">
                <form
                  class="sms-settings-form"
                  data-provider="<%= def.key %>"
                  autocomplete="off"
                >
                  <div style="display:grid;gap:8px;">
                    <ol class="sms-steps">
                      <% if (def.key === 'twilio') { %>
                        <li>Sign in at <a href="https://console.twilio.com" target="_blank" rel="noopener">console.twilio.com</a>.</li>
                        <li>Copy the <strong>Account SID</strong> and <strong>Auth Token</strong> from the Account Info box.</li>
                        <li>Buy a number that can send SMS (Phone Numbers › Buy a number).</li>
                        <li>Paste them below and press <strong>Save and test</strong>.</li>
                      <% } else if (def.key === 'arkesel') { %>
                        <li>Sign in at <a href="https://sms.arkesel.com" target="_blank" rel="noopener">sms.arkesel.com</a>.</li>
                        <li>Go to <strong>API</strong> in the left menu, choose <strong>Generate new key</strong> and copy it.</li>
                        <li>Paste it below and press <strong>Save and test</strong>.</li>
                      <% } else { %>
                        <li>Sign in at <a href="https://account.africastalking.com" target="_blank" rel="noopener">account.africastalking.com</a> and open your live app (not sandbox).</li>
                        <li>Go to Settings › API Key and generate a key. Your <strong>username</strong> is the app's username.</li>
                        <li>Paste both below and press <strong>Save and test</strong>.</li>
                      <% } %>
                    </ol>
                    <% if (def.key === 'twilio') { %>
                    <div>
                      <label class="form-label" for="sms-twilio-account-sid">Account SID<span class="form-required-mark">*</span></label>
                      <input id="sms-twilio-account-sid" class="form-input" type="text" placeholder="AC followed by 32 letters and numbers" value="<%= ps.accountSid || '' %>" autocomplete="off" spellcheck="false" />
                    </div>
                    <% } %>
                    <% if (def.key === 'africastalking') { %>
                    <div>
                      <label class="form-label" for="sms-africastalking-username">Username<span class="form-required-mark">*</span></label>
                      <input id="sms-africastalking-username" class="form-input" type="text" placeholder="Your live Team username (not \"sandbox\")" value="<%= ps.username || '' %>" />
                    </div>
                    <% } %>

                    <div>
                      <label class="form-label" for="sms-<%= def.key %>-api-key"><%= def.key === 'twilio' ? 'Auth Token' : 'API Key' %><span class="form-required-mark">*</span></label>
                      <% const savedSecretTail = def.key === 'twilio' ? ps.maskedAuthToken : ps.maskedApiKey; %>
                      <% const savedSecretLast4 = savedSecretTail ? savedSecretTail.replace(/^••••/, '') : ''; %>
                      <% const savedSecretDisplay = '•'.repeat(15) + savedSecretLast4; %>
                      <div class="sms-secret-input-wrap" style="position:relative;display:block;">
                        <% if (savedSecretTail) { %>
                        <input
                          class="form-input sms-secret-display"
                          data-provider="<%= def.key %>"
                          type="text"
                          readonly
                          value="<%= savedSecretDisplay %>"
                          style="width:100%;box-sizing:border-box;padding-right:78px;letter-spacing:1px;color:#475569;background:#f8fafc;"
                        />
                        <% } %>
                        <input
                          id="sms-<%= def.key %>-api-key"
                          class="form-input sms-secret-edit-input"
                          data-provider="<%= def.key %>"
                          type="password"
                          autocomplete="new-password"
                          style="width:100%;box-sizing:border-box;<%= savedSecretTail ? 'display:none;padding-right:78px;' : '' %>"
                          placeholder="<%= def.key === 'twilio' ? 'Paste your Twilio auth token' : 'Paste your API key' %>"
                        />
                        <% if (savedSecretTail) { %>
                        <button
                          type="button"
                          class="btn-link sms-secret-change-btn"
                          data-provider="<%= def.key %>"
                          data-mode="change"
                          style="position:absolute;top:6px;right:6px;padding:5px 10px;font-size:11.5px;background:#fff;border:1px solid #e2e8f0;border-radius:6px;line-height:1;cursor:pointer;"
                        >Change</button>
                        <% } %>
                      </div>
                      <small style="display:block;margin-top:4px;color:#94a3b8;">Stored encrypted. Never shown again in full.</small>
                    </div>

                    <% if (def.key === 'twilio') { %>
                    <div>
                      <label class="form-label" for="sms-twilio-from-number">Twilio phone number<span class="form-required-mark">*</span></label>
                      <input id="sms-twilio-from-number" class="form-input" type="tel" placeholder="+15551234567" value="<%= ps.fromNumber || '' %>" />
                      <small style="display:block;margin-top:4px;color:#94a3b8;">The number you bought in Twilio, with the country code.</small>
                    </div>
                    <% } else { %>
                    <div>
                      <label class="form-label" for="sms-<%= def.key %>-sender-id">Sender ID (optional)</label>
                      <input id="sms-<%= def.key %>-sender-id" class="form-input" type="text" maxlength="11" placeholder="e.g. YourSchool — leave blank to use a shared shortcode" value="<%= ps.senderId || '' %>" />
                      <% if (def.key === 'arkesel') { %>
                      <small style="display:block;margin-top:4px;color:#94a3b8;">
                        Works immediately without one. In Ghana, AirtelTigo may filter unregistered senders — MTN and Telecel are more lenient. For reliable branded delivery on all networks, request a Sender ID in your Arkesel dashboard (Letter of Authorization, ≤72hr approval).
                      </small>
                      <% } %>
                    </div>
                    <% } %>

                    <div style="display:flex;gap:10px;flex-wrap:wrap;align-items:center;">
                      <button class="btn-primary btn-link sms-save-settings-button" type="button" data-provider="<%= def.key %>">Save and test</button>
                      <small class="sms-settings-status" data-provider="<%= def.key %>-config" style="color:#64748b;">
                        <%= psConfigured ? '' : 'We check the details with ' + (def.key === 'twilio' ? 'Twilio' : def.key === 'arkesel' ? 'Arkesel' : "Africa's Talking") + ' before saving. No message is sent.' %>
                      </small>
                    </div>
                    <small style="color:#94a3b8;"><span class="form-required-mark">*</span> Required</small>
                  </div>
                </form>
                </div>
              </div>
              <% } else { %>
              <small style="display:block;margin-top:16px;color:#64748b;">Activate <%= def.label %> to reveal its API credential fields.</small>
              <% } %>
            </div>
            <% }); %>

            <div class="card">
              <h4>
                <span class="google-classroom-title">
                  <svg class="google-classroom-logo" viewBox="8 8 48 48" aria-hidden="true" focusable="false">
                    <rect x="8" y="8" width="48" height="48" rx="12" fill="#25D366"></rect>
                    <path fill="#ffffff" d="M47.7 33.1c0 8.5-6.9 15.4-15.4 15.4-2.7 0-5.2-.7-7.4-1.9l-8.1 2.1 2.2-7.9c-1.4-2.3-2.2-5-2.2-7.9 0-8.5 6.9-15.4 15.4-15.4s15.5 6.9 15.5 15.6zm-15.4-12.9c-7.1 0-12.9 5.8-12.9 12.9 0 2.8.9 5.4 2.5 7.4l.4.5-1.3 4.8 4.9-1.3.5.3c1.9 1.2 4.1 1.8 6.4 1.8 7.1 0 12.9-5.8 12.9-12.9S39.4 20.2 32.3 20.2zm7.1 16.5c-.4-.2-2.3-1.1-2.7-1.2-.4-.1-.6-.2-.9.2-.3.4-1 1.2-1.2 1.4-.2.2-.5.3-.9.1-.4-.2-1.8-.7-3.5-2.2-1.3-1.2-2.2-2.6-2.5-3-.3-.4 0-.6.2-.8.2-.2.4-.5.6-.7.2-.2.3-.4.4-.7.1-.2.1-.5 0-.7-.1-.2-.9-2.2-1.3-3-.3-.8-.6-.7-.9-.7h-.7c-.2 0-.7.1-1 .5-.3.4-1.4 1.4-1.4 3.4s1.5 3.9 1.7 4.2c.2.3 3 4.6 7.2 6.4 1 .4 1.8.7 2.4.9 1 .3 1.9.3 2.6.2.8-.1 2.3-.9 2.6-1.8.3-.9.3-1.7.2-1.8-.1-.2-.4-.3-.8-.5z"></path>
                  </svg>
                  <span>WhatsApp Business</span>
                </span>
                <span class="pill" id="whatsapp-status-pill" data-activated="<%= wiActivated ? '1' : '0' %>" data-connected="<%= wiConnected ? '1' : '0' %>" style="background:<%= wiReady ? '#dcfce7' : '#fef3c7' %>;color:<%= wiReady ? '#166534' : '#92400e' %>">
                  <%= wiReady ? 'Active & Connected' : (wiActivated ? 'Connection Required' : 'Inactive') %>
                </span>
                <%- integrationCoverageBadge('whatsapp') %>
              </h4>
              <small class="google-integration-description">
                Message parents on WhatsApp from your school's own WhatsApp Business number. Connect it with Meta, then finish the checklist below.
                <% if (wi.displayPhoneNumber) { %><br>Connected number: <strong><%= wi.displayPhoneNumber %></strong><% } %>
                <% if (wi.businessName) { %><br>Business: <strong><%= wi.businessName %></strong><% } %>
                <% if (wi.lastError) { %>
                <br><span id="whatsapp-last-error" style="color:#b91c1c;"><%= wi.lastError %></span>
                <% } else { %>
                <span id="whatsapp-last-error" style="display:none;color:#b91c1c;"></span>
                <% } %>
                <%- integrationActivityLine('WhatsApp') %>
              </small>

              <div class="google-integration-toolbar">
                <div class="google-integration-actions">
                  <a href="#" class="integration-readmore-link" data-integration="whatsapp">Read more</a>
                  <details class="google-actions-menu" style="display:inline-flex !important;align-items:center !important;">
                    <summary class="google-actions-toggle" aria-label="WhatsApp actions"><i class="fa-solid fa-ellipsis-vertical" aria-hidden="true"></i></summary>
                    <div class="google-actions-menu-list">
                      <a class="google-action-item" href="#" id="open-whatsapp-activate-modal" style="display:<%= wiActivated ? 'none' : 'block' %>">Activate</a>
                      <a class="google-action-item" href="#" id="open-whatsapp-deactivate-modal" style="display:<%= wiActivated ? 'block' : 'none' %>">Deactivate</a>

                      <% if (wiActivated) { %>
                      <button class="google-action-item" type="button" id="whatsapp-connect-link" style="<%= hasWhatsappMetaConfig ? '' : 'opacity:0.6;pointer-events:none;cursor:not-allowed;' %>"><%= wiConfigured ? 'Reconnect WhatsApp' : 'Connect WhatsApp' %></button>
                      <% } %>

                      <% if (wiConfigured) { %>
                      <button class="google-action-item is-danger" type="button" id="whatsapp-disconnect-link">Disconnect</button>
                      <% } %>
                    </div>
                  </details>
                </div>
              </div>

              <form id="whatsapp-activation-form" action="/account/whatsapp/activate" method="POST" style="display:none;">
                <input type="hidden" name="activate" id="whatsapp-activation-value" value="0" />
                <input type="hidden" name="integrationPassword" id="whatsapp-activation-password" />
              </form>

              <form id="whatsapp-disconnect-form" action="/account/whatsapp/disconnect" method="POST" style="display:none;"></form>

              <% if (wiActivated && wiConnected) { %>
              <div id="whatsapp-setup-checklist-card" style="margin-top:16px;padding:16px;border:1px solid #e2e8f0;border-radius:14px;background:#fff;">
                <strong style="font-size:13.5px;">Setup checklist</strong>
                <div id="whatsapp-checklist-items" style="margin-top:10px;border:1px solid #e2e8f0;border-radius:10px;overflow:hidden;">
                  <small style="display:block;padding:10px 12px;color:#64748b;font-size:11.5px;">Loading status...</small>
                </div>
                <small id="whatsapp-checklist-meta-error" style="display:none;color:#b91c1c;margin-top:8px;"></small>
                <small id="whatsapp-checklist-updated" style="display:block;color:#94a3b8;margin-top:8px;"></small>
              </div>
              <% } %>

              <% if (wiReady) { %>
              <div id="whatsapp-test-message-card" style="display:none;margin-top:16px;padding:16px;border:1px solid #e2e8f0;border-radius:14px;background:#fff;">
                <div style="display:grid;gap:10px;">
                  <label class="form-label" for="whatsapp-test-recipient-input" style="margin-bottom:0;">Test recipient number</label>
                  <input
                    id="whatsapp-test-recipient-input"
                    class="form-input"
                    type="tel"
                    inputmode="numeric"
                    placeholder="e.g. 233551234567"
                    autocomplete="off"
                  />

                  <label class="form-label" for="whatsapp-test-message-input" style="margin-bottom:0;">Test message</label>
                  <textarea
                    id="whatsapp-test-message-input"
                    class="form-input"
                    rows="3"
                    maxlength="500"
                    placeholder="Type a short WhatsApp test message"
                  >Managira test message from Integrations settings.</textarea>

                  <div style="display:flex;gap:10px;flex-wrap:wrap;align-items:center;">
                    <button class="btn-link" id="whatsapp-default-test-button" type="button" style="<%= hasWhatsappMetaConfig ? '' : 'opacity:0.6;pointer-events:none;cursor:not-allowed;' %>">Send Test Message</button>
                    <small id="whatsapp-test-message-status" style="color:#64748b;">Enter recipient + message, then click Send Test Message.</small>
                  </div>
                </div>
              </div>
              <% } else { %>
              <small style="display:block;margin-top:16px;color:#64748b;">Activate and connect WhatsApp to unlock the test-message tool.</small>
              <% } %>

              <% if (!hasWhatsappMetaConfig) { %>
              <small style="display:block;margin-top:10px;color:#b45309;">Meta app credentials are missing on this server. Set <strong>META_APP_ID</strong>, <strong>META_APP_SECRET</strong>, and <strong>WHATSAPP_EMBEDDED_SIGNUP_CONFIG_ID</strong> for Embedded Signup connect.</small>
              <% } %>
            </div>
        </section>
        <% } %>

        <% if (_canSecuritySettings && !_isOnHoldRestricted) { %>
        <section id="security" class="settings-section">
          <h1>Security</h1>
          <p class="lead">Manage your account security and password.</p>

          <div class="card security-card">
            <h4>Email</h4>
            <small>Update your account email address</small>
            <form id="security-email-form" action="/account/settings/security/email" method="POST">
              <input type="hidden" name="redirectTo" value="/account/settings" />
              <div class="content-row">
                <div class="field-group">
                  <label class="form-label" for="settings-email">Email</label>
                  <input
                    type="email"
                    id="settings-email"
                    name="email"
                    value="<%= user?.email || '' %>"
                    placeholder="you@example.com"
                    class="form-input"
                  />
                </div>
                <div class="form-actions">
                  <button class="btn-link" type="submit">Update Email</button>
                </div>
              </div>
            </form>
          </div>

          <div class="card security-card">
            <h4>Change Password</h4>
            <small>Update your password to keep your account secure</small>
            <form id="security-password-form" action="/account/settings/security/password" method="POST">
              <input type="hidden" name="redirectTo" value="/account/settings" />
              <div class="content-row">
                <div class="field-group">
                  <label class="form-label" for="settings-new-password">New Password</label>
                  <div class="input-with-icon">
                    <button class="input-icon-btn" type="button" data-toggle="settings-new-password" aria-label="Show password">
                      <i class="fa-solid fa-eye fa-fw" aria-hidden="true"></i>
                    </button>
                    <input
                      type="password"
                      id="settings-new-password"
                      name="password"
                      placeholder="New password"
                      autocomplete="new-password"
                      class="form-input"
                      required
                    />
                  </div>
                </div>
                <div class="field-group">
                  <label class="form-label" for="settings-confirm-password">Confirm New Password</label>
                  <div class="input-with-icon">
                    <button class="input-icon-btn" type="button" data-toggle="settings-confirm-password" aria-label="Show password">
                      <i class="fa-solid fa-eye fa-fw" aria-hidden="true"></i>
                    </button>
                    <input
                      type="password"
                      id="settings-confirm-password"
                      name="confirmPassword"
                      placeholder="Confirm new password"
                      autocomplete="new-password"
                      class="form-input"
                      required
                    />
                  </div>
                </div>
                <div class="form-actions">
                  <button class="btn-primary btn-link" type="submit">Update Password</button>
                </div>
              </div>
            </form>
          </div>

          <!--
          <div class="card">
            <h4>Two-Factor Authentication</h4>
            <small>Add an extra layer of security to your account.</small>
            <div class="content-row">
              <div class="text-muted-sm">Status: Off</div>
              <button class="btn-link" type="button">Enable 2FA</button>
            </div>
          </div>

          <div class="card">
            <h4>Active Sessions</h4>
            <small>Manage and revoke active sessions on your account.</small>
            <div class="content-row">
              <div class="text-muted-sm">View and revoke sessions.</div>
              <button class="btn-link" type="button">View Sessions</button>
            </div>
          </div>
          -->
        </section>
        <% } %>

        <%
          const _hasUserNotificationPrefs = typeof notificationPrefs !== 'undefined' && Array.isArray(notificationPrefs) && notificationPrefs.length;
          const _hasOrgNotificationPrefs = typeof orgNotificationPrefs !== 'undefined' && Array.isArray(orgNotificationPrefs) && orgNotificationPrefs.length;
        %>
        <% if ((_hasUserNotificationPrefs || _hasOrgNotificationPrefs) && !_isOnHoldRestricted) {
             const _saved = (typeof savedNotificationPrefs !== 'undefined' && savedNotificationPrefs) ? savedNotificationPrefs : {};
             const _orgSaved = (typeof savedOrgNotificationPrefs !== 'undefined' && savedOrgNotificationPrefs) ? savedOrgNotificationPrefs : {}; %>
        <section id="notifications" class="settings-section">
          <h1>Email Notifications</h1>
          <p class="lead">Choose which non-essential emails you want to receive. Security, billing, and other transactional emails are always sent.</p>

          <% if (_hasOrgNotificationPrefs) { %>
          <div class="card">
            <h4>Organization Notifications</h4>
            <small>These apply to the whole school, not just your account.</small>
            <form action="/account/settings/notifications/organization" method="POST" autocomplete="off">
              <ul class="notif-list" style="display:flex;flex-direction:column;gap:10px;margin:14px 0 16px;padding:0;list-style:none;">
                <% orgNotificationPrefs.forEach(function(p) {
                     const checked = (p.key in _orgSaved) ? !!_orgSaved[p.key] : true; %>
                  <li style="display:flex;align-items:flex-start;gap:12px;padding:12px 14px;border:1px solid #e5e7eb;border-radius:10px;background:#f9fafb;">
                    <input type="checkbox" name="orgPreferences" id="org-pref-<%= p.key %>" value="<%= p.key %>" <%= checked ? 'checked' : '' %> style="margin-top:4px;width:18px;height:18px;accent-color:#01535b;flex-shrink:0;cursor:pointer;" />
                    <label for="org-pref-<%= p.key %>" style="flex:1;cursor:pointer;">
                      <span style="font-weight:600;color:#0f172a;font-size:0.93rem;display:block;"><%= p.label %></span>
                      <% if (p.description) { %><span style="font-size:0.83rem;color:#64748b;margin-top:2px;line-height:1.4;display:block;"><%= p.description %></span><% } %>
                    </label>
                  </li>
                <% }); %>
              </ul>
              <div class="content-row" style="justify-content:flex-end;">
                <button type="submit" class="btn-primary btn-link">Save organization preferences</button>
              </div>
            </form>
          </div>
          <% } %>

          <% if (_hasUserNotificationPrefs) { %>
          <div class="card">
            <h4>Your preferences</h4>
            <small>These options are based on your role. Unchecked items will not be emailed to you.</small>
            <form action="/account/settings/notifications" method="POST" autocomplete="off">
              <ul class="notif-list" style="display:flex;flex-direction:column;gap:10px;margin:14px 0 16px;padding:0;list-style:none;">
                <% notificationPrefs.forEach(function(p) {
                     const checked = (p.key in _saved) ? !!_saved[p.key] : true; %>
                  <li style="display:flex;align-items:flex-start;gap:12px;padding:12px 14px;border:1px solid #e5e7eb;border-radius:10px;background:#f9fafb;">
                    <input type="checkbox" name="preferences" id="acc-pref-<%= p.key %>" value="<%= p.key %>" <%= checked ? 'checked' : '' %> style="margin-top:4px;width:18px;height:18px;accent-color:#01535b;flex-shrink:0;cursor:pointer;" />
                    <label for="acc-pref-<%= p.key %>" style="flex:1;cursor:pointer;">
                      <span style="font-weight:600;color:#0f172a;font-size:0.93rem;display:block;"><%= p.label %></span>
                      <% if (p.description) { %><span style="font-size:0.83rem;color:#64748b;margin-top:2px;line-height:1.4;display:block;"><%= p.description %></span><% } %>
                    </label>
                  </li>
                <% }); %>
              </ul>
              <div class="content-row" style="justify-content:flex-end;">
                <button type="submit" class="btn-primary btn-link">Save preferences</button>
              </div>
            </form>
          </div>
          <% } %>
        </section>
        <% } %>

        <% if (!_isOnHoldRestricted) { %>
        <section id="feedback" class="settings-section">
          <h1>Feedback</h1>
          <p class="lead">Send a quick review, bug report, feature request, or general feedback.</p>

          <div class="card">
            <form id="settings-feedback-form" class="feedback-settings-form" action="/common/feedback" method="POST" novalidate>
              <div id="settings-feedback-status" class="feedback-status" hidden></div>

              <div class="feedback-grid">
                <div class="field-group">
                  <label class="form-label" for="settings-feedback-type">Feedback type</label>
                  <select id="settings-feedback-type" name="feedbackType" class="form-select" required>
                    <option value="">Select feedback type</option>
                    <% feedbackTypeOptions.forEach(function(option) { %>
                      <option value="<%= option.value %>"><%= option.label %></option>
                    <% }) %>
                  </select>
                </div>

                <div class="field-group">
                  <label class="form-label" for="settings-feedback-area">Area</label>
                  <select id="settings-feedback-area" name="area" class="form-select" required>
                    <option value="">Select area</option>
                    <% feedbackAreaOptions.forEach(function(option) { %>
                      <option value="<%= option.value %>"><%= option.label %></option>
                    <% }) %>
                  </select>
                </div>

                <div class="field-group feedback-priority" id="settings-feedback-priority-field" hidden>
                  <label class="form-label" for="settings-feedback-priority">Priority</label>
                  <select id="settings-feedback-priority" name="priority" class="form-select">
                    <option value="">Select priority</option>
                    <% feedbackPriorityOptions.forEach(function(option) { %>
                      <option value="<%= option.value %>"><%= option.label %></option>
                    <% }) %>
                  </select>
                </div>

                <div class="field-group feedback-field--full">
                  <label class="form-label" for="settings-feedback-subject">Subject</label>
                  <input
                    type="text"
                    id="settings-feedback-subject"
                    name="subject"
                    class="form-input"
                    maxlength="120"
                    placeholder="Summarize the issue or idea"
                    required
                  />
                </div>

                <div class="field-group feedback-field--full feedback-rating" id="settings-feedback-rating-field" hidden>
                  <label class="form-label">Rating</label>
                  <div class="feedback-stars-row" role="radiogroup" aria-label="Feedback rating">
                    <% for (let rating = 1; rating <= 5; rating += 1) { %>
                      <span class="feedback-star">
                        <input id="settings-feedback-rating-<%= rating %>" type="radio" name="rating" value="<%= rating %>" />
                        <label for="settings-feedback-rating-<%= rating %>" title="<%= rating %> out of 5">&#9733;</label>
                      </span>
                    <% } %>
                  </div>
                  <div class="feedback-helper">
                    <span>Only required for reviews.</span>
                    <span id="settings-feedback-rating-label">1 to 5 stars</span>
                  </div>
                </div>

                <div class="field-group feedback-field--full">
                  <label class="form-label" for="settings-feedback-message">Message</label>
                  <textarea
                    id="settings-feedback-message"
                    name="message"
                    class="form-textarea"
                    maxlength="2000"
                    placeholder="Explain what happened, what you expected, or what would make this better."
                    required
                  ></textarea>
                  <div class="feedback-helper">
                    <span>Be specific so we can act on it quickly.</span>
                    <span class="feedback-counter" id="settings-feedback-counter">0/2000</span>
                  </div>
                </div>
              </div>

              <div class="feedback-actions-row">
                <button type="submit" class="btn-primary btn-link" id="settings-feedback-submit">Submit Feedback</button>
              </div>
            </form>
          </div>
        </section>
        <% } %>
      </div>
    </main>
