            <span>Billing &amp; Plan</span>
          </button></li>
          <% if (['admin','mini admin','super admin'].includes(String(user && user.account_type || '').trim().toLowerCase())) { %>
          <li><a class="nav-link" href="/account/settings/finance">
            <span class="nav-link-icon"><svg fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 6v12M8.5 9.5c0-1.381 1.567-2.5 3.5-2.5s3.5 1.119 3.5 2.5-1.567 2.5-3.5 2.5S8.5 13.381 8.5 14.5 10.067 17 12 17s3.5-1.119 3.5-2.5"/></svg></span>
            <span>Finance</span>
          </a></li>
          <% } %>
          <li><button class="nav-link" data-target="security">
            <span class="nav-link-icon"><svg fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path d="M12 2l8 4v6c0 5-3.5 9-8 10-4.5-1-8-5-8-10V6l8-4z"/></svg></span>
            <span>Security</span>
          </button></li>
          <% if (typeof notificationPrefs !== 'undefined' && Array.isArray(notificationPrefs) && notificationPrefs.length) { %>
          <li><button class="nav-link" data-target="notifications">
            <span class="nav-link-icon"><svg fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path d="M15 17h5l-1.4-1.4A2 2 0 0 1 18 14.2V11a6 6 0 0 0-4-5.7V5a2 2 0 1 0-4 0v.3A6 6 0 0 0 6 11v3.2c0 .5-.2 1-.6 1.4L4 17h5"/><path d="M9 17a3 3 0 0 0 6 0"/></svg></span>
            <span>Notifications</span>
          </button></li>
          <% } %>
        </ul>
      </aside>

      <main class="settings-main">
        <section id="customize" class="settings-section">
          <h1>Customize School</h1>
          <p class="lead">
            Manage your school website branding and settings.
          </p>

          <% 
            const rawLogo = (org && (org.logo || org.logo_path)) ? (org.logo || org.logo_path) : "";
            const isLogoUrl = rawLogo && /^https?:\/\//i.test(rawLogo);
            const resolvedLogoUrl = rawLogo
              ? (isLogoUrl ? rawLogo : `https://${process.env.S3_BUCKET_NAME}.s3.${process.env.AWS_REGION}.amazonaws.com/${rawLogo}`)
              : "";
            const logoUrl = resolvedLogoUrl
              ? encodeURI(resolvedLogoUrl)
              : "";
          %>

          <div class="card">
            <h4>Organization Logo</h4>
            <small>Upload your organization logo. Recommended size: 200x200px.</small>
            <form action="/account/personalization/logo" method="POST" enctype="multipart/form-data">
              <input type="hidden" name="redirectTo" value="/account/settings" />
              <div class="content-row">
                <div class="avatar avatar-logo">
                  <% if (logoUrl) { %>
                    <img src="<%= logoUrl %>" alt="Org logo" />
                  <% } else { %>
                    <%= (org && org.organization_name ? org.organization_name[0] : 'G') %>
                  <% } %>
                </div>
                <input type="file" id="logo" name="logo" accept="image/*" />
                <button class="btn-primary btn-link" id="logo-submit" type="submit" disabled>Upload Logo</button>
              </div>
            </form>
          </div>

          <div class="card">
            <h4>Organization Name</h4>
            <small>This is your organization's visible name within the application.</small>
            <form action="/account/personalization/name" method="POST">
              <input type="hidden" name="redirectTo" value="/account/settings" />
              <div class="content-row">
                <input
                  type="text"
                  name="orgName"
                  value="<%= org?.organization_name || '' %>"
                  required
                  class="form-input"
                />
                <button class="btn-primary btn-link" type="submit">Save Organization Name</button>
              </div>
            </form>
          </div>

          <div class="card">
            <h4>Select Font Type</h4>
            <small>Choose the font that best represents your brand.</small>
            <form action="/account/personalization/font" method="POST">
              <input type="hidden" name="redirectTo" value="/account/settings" />
              <div class="content-row">
                <select
                  id="font-select"
                  name="font"
                  class="form-select"
                >
                  <% const fontStyle = org?.font_style || 'Inter'; %>
                  <option value="Inter" <%= fontStyle === 'Inter' ? 'selected' : '' %>>Inter</option>
                  <option value="Roboto" <%= fontStyle === 'Roboto' ? 'selected' : '' %>>Roboto</option>
                  <option value="Open Sans" <%= fontStyle === 'Open Sans' ? 'selected' : '' %>>Open Sans</option>
                  <option value="Lato" <%= fontStyle === 'Lato' ? 'selected' : '' %>>Lato</option>
                  <option value="Montserrat" <%= fontStyle === 'Montserrat' ? 'selected' : '' %>>Montserrat</option>
                  <option value="Poppins" <%= fontStyle === 'Poppins' ? 'selected' : '' %>>Poppins</option>
                  <option value="Nunito" <%= fontStyle === 'Nunito' ? 'selected' : '' %>>Nunito</option>
                  <option value="Raleway" <%= fontStyle === 'Raleway' ? 'selected' : '' %>>Raleway</option>
                  <option value="Work Sans" <%= fontStyle === 'Work Sans' ? 'selected' : '' %>>Work Sans</option>
                  <option value="Source Sans Pro" <%= fontStyle === 'Source Sans Pro' ? 'selected' : '' %>>Source Sans Pro</option>
                  <option value="Ubuntu" <%= fontStyle === 'Ubuntu' ? 'selected' : '' %>>Ubuntu</option>
                  <option value="Noto Sans" <%= fontStyle === 'Noto Sans' ? 'selected' : '' %>>Noto Sans</option>
                  <option value="PT Serif" <%= fontStyle === 'PT Serif' ? 'selected' : '' %>>PT Serif</option>
                  <option value="Merriweather" <%= fontStyle === 'Merriweather' ? 'selected' : '' %>>Merriweather</option>
                  <option value="Playfair Display" <%= fontStyle === 'Playfair Display' ? 'selected' : '' %>>Playfair Display</option>
                </select>
                <div class="font-preview" id="font-preview">
                <div style="font-size: 20px; font-weight: 600; margin-bottom: 8px;">Welcome to Greenwood Academy</div>
                <div style="font-size: 16px; margin-bottom: 6px;">Student Dashboard • Grade 10A • Mathematics</div>
                <div style="font-size: 14px; color: #6b7280; line-height: 1.5;">This is how your school will look like with this font. Student names, grades, announcements, and all content will appear in this style. ABCDEFGHIJKLMNOPQRSTUVWXYZ 0123456789</div>
              </div>
                <button class="btn-link" type="submit">Change Font</button>
              </div>
              
            </form>
          </div>

          <div class="card">
            <h4>School Theme</h4>
            <small>Pick theme for your school.</small>
            <form action="/account/updatePublicDashboardTheme" method="POST">
              <input type="hidden" name="redirectTo" value="/account/settings?section=customize" />
              <% const selectedWebsiteTheme = (publicDashboardTheme && String(publicDashboardTheme).trim()) ? String(publicDashboardTheme).trim() : 'classic'; %>
              <div style="display:grid; grid-template-columns:repeat(auto-fit,minmax(220px,1fr)); gap:10px; margin-top:12px;">
                <label style="display:flex; gap:10px; align-items:flex-start; border:1px solid #e5e7eb; border-radius:10px; padding:12px; cursor:pointer;">
                  <input type="radio" name="publicDashboardTheme" value="classic" <%= selectedWebsiteTheme === 'classic' ? 'checked' : '' %> />
                  <span style="display:flex; flex-direction:column; gap:4px;">
                    <strong style="font-size:0.95rem;">Ocean Teal</strong>
                    <span style="display:flex; gap:6px;">
                      <span style="width:14px; height:14px; border-radius:999px; border:1px solid rgba(0,0,0,0.12); background:#01535b;"></span>
                      <span style="width:14px; height:14px; border-radius:999px; border:1px solid rgba(0,0,0,0.12); background:#014a51;"></span>
                    </span>
                    <span class="text-muted-sm">Trusted academic teal.</span>
                  </span>
                </label>
                <label style="display:flex; gap:10px; align-items:flex-start; border:1px solid #e5e7eb; border-radius:10px; padding:12px; cursor:pointer;">
                  <input type="radio" name="publicDashboardTheme" value="modern" <%= selectedWebsiteTheme === 'modern' ? 'checked' : '' %> />
                  <span style="display:flex; flex-direction:column; gap:4px;">
                    <strong style="font-size:0.95rem;">Royal Blue</strong>
                    <span style="display:flex; gap:6px;">
                      <span style="width:14px; height:14px; border-radius:999px; border:1px solid rgba(0,0,0,0.12); background:#2563eb;"></span>
                      <span style="width:14px; height:14px; border-radius:999px; border:1px solid rgba(0,0,0,0.12); background:#1d4ed8;"></span>
                    </span>
                    <span class="text-muted-sm">Crisp modern blue.</span>
                  </span>
                </label>
                <label style="display:flex; gap:10px; align-items:flex-start; border:1px solid #e5e7eb; border-radius:10px; padding:12px; cursor:pointer;">
                  <input type="radio" name="publicDashboardTheme" value="green" <%= selectedWebsiteTheme === 'green' ? 'checked' : '' %> />
                  <span style="display:flex; flex-direction:column; gap:4px;">
                    <strong style="font-size:0.95rem;">Evergreen</strong>
                    <span style="display:flex; gap:6px;">
                      <span style="width:14px; height:14px; border-radius:999px; border:1px solid rgba(0,0,0,0.12); background:#2d5f4f;"></span>
                      <span style="width:14px; height:14px; border-radius:999px; border:1px solid rgba(0,0,0,0.12); background:#245043;"></span>
                    </span>
                    <span class="text-muted-sm">Calm natural green.</span>
                  </span>
                </label>
                <label style="display:flex; gap:10px; align-items:flex-start; border:1px solid #e5e7eb; border-radius:10px; padding:12px; cursor:pointer;">
                  <input type="radio" name="publicDashboardTheme" value="minimal" <%= selectedWebsiteTheme === 'minimal' ? 'checked' : '' %> />
                  <span style="display:flex; flex-direction:column; gap:4px;">
                    <strong style="font-size:0.95rem;">Amethyst Purple</strong>
                    <span style="display:flex; gap:6px;">
                      <span style="width:14px; height:14px; border-radius:999px; border:1px solid rgba(0,0,0,0.12); background:#7c3aed;"></span>
                      <span style="width:14px; height:14px; border-radius:999px; border:1px solid rgba(0,0,0,0.12); background:#6d28d9;"></span>
                    </span>
                    <span class="text-muted-sm">Refined premium purple.</span>
                  </span>
                </label>
                <label style="display:flex; gap:10px; align-items:flex-start; border:1px solid #e5e7eb; border-radius:10px; padding:12px; cursor:pointer;">
                  <input type="radio" name="publicDashboardTheme" value="indigo" <%= selectedWebsiteTheme === 'indigo' ? 'checked' : '' %> />
                  <span style="display:flex; flex-direction:column; gap:4px;">
                    <strong style="font-size:0.95rem;">Deep Indigo</strong>
                    <span style="display:flex; gap:6px;">
                      <span style="width:14px; height:14px; border-radius:999px; border:1px solid rgba(0,0,0,0.12); background:#4338ca;"></span>
                      <span style="width:14px; height:14px; border-radius:999px; border:1px solid rgba(0,0,0,0.12); background:#312e81;"></span>
                    </span>
                    <span class="text-muted-sm">Bold confident indigo.</span>
                  </span>
                </label>
                <label style="display:flex; gap:10px; align-items:flex-start; border:1px solid #e5e7eb; border-radius:10px; padding:12px; cursor:pointer;">
                  <input type="radio" name="publicDashboardTheme" value="rose" <%= selectedWebsiteTheme === 'rose' ? 'checked' : '' %> />
                  <span style="display:flex; flex-direction:column; gap:4px;">
                    <strong style="font-size:0.95rem;">Crimson Rose</strong>
                    <span style="display:flex; gap:6px;">
                      <span style="width:14px; height:14px; border-radius:999px; border:1px solid rgba(0,0,0,0.12); background:#8b2635;"></span>
                      <span style="width:14px; height:14px; border-radius:999px; border:1px solid rgba(0,0,0,0.12); background:#7a212e;"></span>
                    </span>
                    <span class="text-muted-sm">Elegant institutional red.</span>
                  </span>
                </label>
                <label style="display:flex; gap:10px; align-items:flex-start; border:1px solid #e5e7eb; border-radius:10px; padding:12px; cursor:pointer;">
                  <input type="radio" name="publicDashboardTheme" value="amber" <%= selectedWebsiteTheme === 'amber' ? 'checked' : '' %> />
                  <span style="display:flex; flex-direction:column; gap:4px;">
                    <strong style="font-size:0.95rem;">Amber Gold</strong>
                    <span style="display:flex; gap:6px;">
                      <span style="width:14px; height:14px; border-radius:999px; border:1px solid rgba(0,0,0,0.12); background:#d97706;"></span>
                      <span style="width:14px; height:14px; border-radius:999px; border:1px solid rgba(0,0,0,0.12); background:#b45309;"></span>
                    </span>
                    <span class="text-muted-sm">Warm premium amber.</span>
                  </span>
                </label>
                <label style="display:flex; gap:10px; align-items:flex-start; border:1px solid #e5e7eb; border-radius:10px; padding:12px; cursor:pointer;">
                  <input type="radio" name="publicDashboardTheme" value="yellow" <%= selectedWebsiteTheme === 'yellow' ? 'checked' : '' %> />
                  <span style="display:flex; flex-direction:column; gap:4px;">
                    <strong style="font-size:0.95rem;">Solar Yellow</strong>
                    <span style="display:flex; gap:6px;">
                      <span style="width:14px; height:14px; border-radius:999px; border:1px solid rgba(0,0,0,0.12); background:#eab308;"></span>
                      <span style="width:14px; height:14px; border-radius:999px; border:1px solid rgba(0,0,0,0.12); background:#ca8a04;"></span>
                    </span>
                    <span class="text-muted-sm">Bright energetic yellow.</span>
                  </span>
                </label>
                <label style="display:flex; gap:10px; align-items:flex-start; border:1px solid #e5e7eb; border-radius:10px; padding:12px; cursor:pointer;">
                  <input type="radio" name="publicDashboardTheme" value="slate" <%= selectedWebsiteTheme === 'slate' ? 'checked' : '' %> />
                  <span style="display:flex; flex-direction:column; gap:4px;">
                    <strong style="font-size:0.95rem;">Slate Graphite</strong>
                    <span style="display:flex; gap:6px;">
                      <span style="width:14px; height:14px; border-radius:999px; border:1px solid rgba(0,0,0,0.12); background:#334155;"></span>
                      <span style="width:14px; height:14px; border-radius:999px; border:1px solid rgba(0,0,0,0.12); background:#1e293b;"></span>
                    </span>
                    <span class="text-muted-sm">Professional balanced slate.</span>
                  </span>
                </label>
              </div>
              <div class="form-actions" style="margin-top:12px;">
                <button class="btn-primary btn-link" type="submit">Save School Theme</button>
              </div>
            </form>
          </div>

          <div class="card">
            <h4>Organization Nickname</h4>
            <small>This will change the subdomain name of your website.</small>
            <p class="text-muted-sm">
              This should be all lowercase. Keep it as simple as possible so your followers can easily remember it, like your school initials. For example: "mys", which will later be "mys.managira.com".
              Example: tgss.managira.com.
            </p>
            <form action="/account/personalization/nickname" method="POST">
              <input type="hidden" name="redirectTo" value="/account/settings" />
              <div class="content-row">
                <input
                  type="text"
                  name="orgNickName"
                  value="<%= org?.nickname || '' %>"
                  pattern="^[a-z]{3,15}$"
                  title="Only lowercase letters (3-15 characters)."
                  required
                  class="form-input"
                />
                <button class="btn-link" type="submit">Change Organization Nickname</button>
              </div>
            </form>
          </div>

          <div class="card">
            <h4>School Calender Rule</h4>
            <small>
              Configure organization-wide attendance rules, then add date overrides below.
            </small>
            <form action="/account/settings/calendar/profile" method="POST">
              <input type="hidden" name="redirectTo" value="/account/settings?section=customize" />
              <div class="content-row" style="align-items:flex-start;">
                <div class="field-group">
                  <label class="form-label" for="calendar-country">Country Public Holidays</label>
                  <select id="calendar-country" name="countryCode" class="form-select" required>
                    <% const selectedCountryCode = (attendanceCalendarProfile && attendanceCalendarProfile.country_code) ? attendanceCalendarProfile.country_code : 'GH'; %>
                    <% (holidayCountries || []).forEach((country) => { %>
                      <option value="<%= country.code %>" <%= country.code === selectedCountryCode ? 'selected' : '' %>>
                        <%= country.name %> (<%= country.code %>)
                      </option>
                    <% }) %>
                  </select>
                </div>

                <div class="field-group" style="min-width:260px;">
                  <label class="form-label">Weekend Days (excluded by default)</label>
                  <% const selectedWeekendDays = (attendanceCalendarProfile && Array.isArray(attendanceCalendarProfile.weekend_days) && attendanceCalendarProfile.weekend_days.length > 0)
                    ? attendanceCalendarProfile.weekend_days.map((d) => Number(d))
                    : [0, 6]; %>
                  <div style="display:grid; grid-template-columns:repeat(2, minmax(0, 1fr)); gap:8px;">
                    <% (weekdayOptions || []).forEach((dayOption) => { %>
                      <label style="display:flex; align-items:center; gap:8px; font-size:0.9rem;">
                        <input
                          type="checkbox"
                          name="weekendDays"
                          value="<%= dayOption.value %>"
                          <%= selectedWeekendDays.includes(Number(dayOption.value)) ? 'checked' : '' %>
                        />
                        <span><%= dayOption.label %></span>
                      </label>
                    <% }) %>
                  </div>
                </div>

                <div class="field-group" style="min-width:260px;">
                  <label class="form-label" for="include-public-holidays">Public Holiday Rule</label>
                  <label style="display:flex; align-items:center; gap:8px; font-size:0.92rem;">
                    <input
                      type="checkbox"
                      id="include-public-holidays"
                      name="includePublicHolidays"
                      value="true"
                      <%= (attendanceCalendarProfile && attendanceCalendarProfile.include_public_holidays) || !attendanceCalendarProfile ? 'checked' : '' %>
                    />
                    <span>Exclude country public holidays from attendance</span>
                  </label>
                </div>

                <div class="form-actions">
                  <button class="btn-primary btn-link" type="submit">Save Calendar Rules</button>
                </div>
              </div>
            </form>

            <hr style="margin: 16px 0; border: none; border-top: 1px solid #e5e7eb;" />

            <small>Add specific days to force attendance counting on/off across the organization.</small>
            <form action="/account/settings/calendar/day" method="POST">
              <div class="content-row" style="align-items:flex-end;">
                <div class="field-group">
                  <label class="form-label" for="calendarDate">Date</label>
                  <input
                    type="date"
                    id="calendarDate"
                    name="calendarDate"
                    class="form-input"
                    required
                  />
                </div>
                <div class="field-group">
                  <label class="form-label" for="calendarLabel">Reason / Label</label>
                  <input
                    type="text"
                    id="calendarLabel"
                    name="label"
                    class="form-input"
                    placeholder="Holiday, exam day, special class..."
                  />
                </div>
                <div class="field-group">
                  <label class="form-label" for="countsForAttendance">Attendance Count Rule</label>
                  <select id="countsForAttendance" name="countsForAttendance" class="form-select">
                    <option value="false">Do not count attendance</option>
                    <option value="true">Count attendance</option>
                  </select>
                </div>
                <div class="form-actions">
                  <button class="btn-primary btn-link" type="submit">Save Day Rule</button>
                </div>
              </div>
            </form>

            <% if (attendanceCalendarDays && attendanceCalendarDays.length > 0) { %>
              <div style="overflow:auto; margin-top:12px; max-height:340px; border:1px solid #e5e7eb; border-radius:10px;">
                <table style="width:100%; border-collapse:collapse; min-width:620px;">
                  <thead>
                    <tr>
                      <th style="text-align:left; border-bottom:1px solid #e5e7eb; padding:8px;">Date</th>
                      <th style="text-align:left; border-bottom:1px solid #e5e7eb; padding:8px;">Type</th>
                      <th style="text-align:left; border-bottom:1px solid #e5e7eb; padding:8px;">Reason</th>
                      <th style="text-align:left; border-bottom:1px solid #e5e7eb; padding:8px;">Counts?</th>
                      <th style="text-align:left; border-bottom:1px solid #e5e7eb; padding:8px;">Action</th>
                    </tr>
                  </thead>
                  <tbody>
                    <% attendanceCalendarDays.forEach((day) => { %>
                      <tr>
                        <td style="padding:8px; border-bottom:1px solid #f1f5f9;"><%= new Date(day.calendar_date).toLocaleDateString() %></td>
                        <td style="padding:8px; border-bottom:1px solid #f1f5f9;"><%= day.source === 'manual' ? 'Manual' : 'Public Holiday' %></td>
                        <td style="padding:8px; border-bottom:1px solid #f1f5f9;"><%= day.label || '-' %></td>
                        <td style="padding:8px; border-bottom:1px solid #f1f5f9;"><%= day.counts_for_attendance ? 'Yes' : 'No' %></td>
                        <td style="padding:8px; border-bottom:1px solid #f1f5f9;">
                          <% if (day.source === 'manual') { %>
                            <form action="/account/settings/calendar/day/delete" method="POST" style="display:inline;">
                              <input type="hidden" name="calendarDayId" value="<%= day.calendar_day_id %>" />
                              <button class="btn-danger btn-link" type="submit" style="padding:6px 10px;">Delete</button>
                            </form>
                          <% } else { %>
                            <span class="text-muted-sm">Auto</span>
                          <% } %>
                        </td>
                      </tr>
                    <% }) %>
                  </tbody>
                </table>
              </div>
            <% } else { %>
              <p class="text-muted-sm" style="margin-top:12px;">No day overrides yet.</p>
            <% } %>
          </div>
        </section>

        <section id="profile" class="settings-section">
          <h1>Profile</h1>
          <p class="lead">View and manage your profile information.</p>

          <!-- Profile Image Upload Section -->
          <div class="card profile-card">
            <h4>Profile Picture</h4>
            <small>Upload or update your profile image</small>
            <form action="/account/settings/profile-image" method="POST" enctype="multipart/form-data">
              <input type="hidden" name="redirectTo" value="/account/settings" />
              <div class="content-row profile-row">
                <div class="employee-info">
                  <div class="avatar">
                    <% if (user?.image_url && user.image_url !== 'profilePlaceholder.png') { %>
                      <img src="<%= user.image_url %>" alt="Profile" style="width: 100%; height: 100%; border-radius: 50%; object-fit: cover;">
                    <% } else { %>
                      <%= (user?.first_name ? user.first_name[0] : 'P') %>
                    <% } %>
                  </div>
                  <div>
                      <p><%= user?.first_name || '' %><%= user?.last_name ? ` ${user.last_name}` : '' %></p>
                      <p class="text-muted-sm">Current profile picture</p>
                  </div>
                </div>
                <div class="profile-fields">
                  <div class="field-group">
                    <label class="form-label" for="profile-image">Choose New Image</label>
                    <input
                      type="file"
                      id="profile-image"
                      name="profileImage"
                      accept="image/*"
                      class="form-input"
                    />
                    <p class="text-muted-sm" style="margin-top: 8px;">Upload a new image to replace your current profile picture</p>
                  </div>
                  <div class="form-actions">
                    <button class="btn-primary btn-link" type="submit">Upload Profile Picture</button>
                  </div>
                  <% if (user?.image_url && user.image_url !== 'profilePlaceholder.png') { %>
                    <div class="form-actions" style="margin-top: 8px;">
                      <button
                        class="btn-danger btn-link"
                        type="submit"
                        formaction="/account/settings/profile-image/delete"
                        formmethod="POST"
                        onclick="return confirm('Delete profile picture? This will remove it from storage and database.');"
                      >
                        Delete Profile Picture
                      </button>
                    </div>
                  <% } %>
                </div>
              </div>
            </form>
          </div>

          <div class="card profile-card">
            <h4>Employee Information</h4>
            <form action="/account/settings/profile" method="POST">
              <input type="hidden" name="redirectTo" value="/account/settings" />
              <div class="content-row profile-row">
                <div class="employee-info">
                  <div class="avatar">
                    <% if (user?.image_url && user.image_url !== 'profilePlaceholder.png') { %>
                      <img src="<%= user.image_url %>" alt="Profile" style="width: 100%; height: 100%; border-radius: 50%; object-fit: cover;">
                    <% } else { %>
                      <%= (user?.first_name ? user.first_name[0] : 'P') %>
                    <% } %>
                  </div>
                  <div>
                      <p><%= user?.first_name || '' %><%= user?.last_name ? ` ${user.last_name}` : '' %></p>
                      <p class="text-muted-sm"><%= user?.account_type || '' %></p>
                  </div>
                </div>
                <div class="profile-fields">
                  <div class="field-group">
                    <label class="form-label" for="profile-first-name">First Name</label>
                    <input
                      type="text"
                      id="profile-first-name"
                      name="firstName"
                      value="<%= user?.first_name || '' %>"
                      placeholder="First name"
                      required
                      class="form-input"
                    />
                  </div>
                  <div class="field-group">
                    <label class="form-label" for="profile-last-name">Last Name</label>
                    <input
                      type="text"
                      id="profile-last-name"
                      name="lastName"
                      value="<%= user?.last_name || '' %>"
                      placeholder="Last name"
                      required
                      class="form-input"
                    />
                  </div>
                  <div class="form-actions">
                    <button class="btn-primary btn-link" type="submit">Update Name</button>
                  </div>
                </div>
              </div>
            </form>
          </div>
        </section>

        <section id="billing" class="settings-section">
          <h1>Billing &amp; Plan</h1>
          <p class="lead">Manage your billing and transaction account settings.</p>

          <% if (isHubMember) { %>
          <div class="card security-card" style="border-left: 4px solid #01535b;">
            <h4>Hub-Managed Billing</h4>
            <small>Your subscription billing is managed by your hub.</small>
          </div>
          <% } %>

          <% if (!isHubMember) { %>
          <div class="card security-card">
            <h4>Payment Method</h4>
            <small>Update your payment method for subscription billing.</small>
            <div class="content-row">
              <div class="text-muted-sm">
                <% if (defaultPaymentMethod) { %>
                  <%= defaultPaymentMethod.brand || 'Card' %> **** <%= defaultPaymentMethod.last4 %>
                  (Exp: <%= defaultPaymentMethod.expMonth %>/<%= defaultPaymentMethod.expYear %>)
                <% } else { %>
                  No card on file
                <% } %>
              </div>
              <button class="btn-primary btn-link btn-inline" id="open-payment-modal" type="button">Update Payment Method</button>
            </div>
          </div>
          <% } %>

          <div class="card security-card">
            <h4>Self Enrollment Transaction Account</h4>
            <small>Manage where self enrollment payments are received.</small>
            <div class="content-row">
              <div class="text-muted-sm">
                <% const primarySubaccount = (paystackSubaccounts || []).find((acc) => acc.is_primary); %>
                <% if (primarySubaccount) { %>
                  <%= primarySubaccount.account_type === 'mobile_money' ? 'Mobile Money' : 'Bank' %>
                  - <%= primarySubaccount.business_name %>
                  <% if (primarySubaccount.account_type === 'bank') { %>
                    - <%= primarySubaccount.bank_name || primarySubaccount.bank_code || 'Bank' %>
                  <% } else { %>
                    - <%= primarySubaccount.momo_provider || 'MoMo' %>
                  <% } %>
                <% } else { %>
                  No payout account selected
                <% } %>
              </div>
              <button class="btn-link btn-inline" id="open-school-account-modal" type="button">Update Self Enrollment Transaction Account</button>
            </div>
          </div>

          <% if (!isHubMember) { %>
          <div class="card">
            <h4>Current Plan</h4>
            <small>Your subscription plan and billing details.</small>
            <div class="content-row">
              <div>
                <strong><%= planName || 'Not set' %></strong>
                <% if (pendingPlan) { %>
                  <div style="margin-top:6px;padding:8px 12px;border-radius:8px;background:#e8f4fd;border:1px solid #90caf9;">
                    <span style="font-weight:600;color:#1565c0;font-size:13px;">Pending Downgrade</span>
                    <div style="margin-top:2px;font-size:12px;color:#5f6b7a;">
                      Switching to <strong><%= pendingPlan.plan_name %></strong>
                      on <strong><%= new Date(pendingPlan.effective_date).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) %></strong>
                    </div>
                    <div style="margin-top:2px;font-size:11px;color:#6b7280;">
                      You keep your current plan features until then.
                    </div>
                  </div>
                <% } %>
                <% if (typeof billingInfo !== 'undefined' && billingInfo) { %>
                  <div style="margin-top:6px;font-size:13px;color:#5f6b7a;line-height:1.6;">
                    <span style="display:inline-block;padding:2px 8px;border-radius:6px;background:#e7faf1;color:#0f5132;font-size:12px;font-weight:600;">
                      <%= billingInfo.period_label || 'Monthly' %>
                    </span>
                    <% if (billingInfo.discount_percentage > 0) { %>
                      <span style="margin-left:4px;font-size:11px;color:#0d8d5d;font-weight:600;">
                        (<%= billingInfo.discount_percentage %>% off)
                      </span>
                    <% } %>
                    <% if (billingInfo.is_trial && billingInfo.trial_ends_at && new Date(billingInfo.trial_ends_at) > new Date()) { %>
                      <div style="margin-top:6px;padding:8px 12px;border-radius:8px;background:#fff8e1;border:1px solid #ffe082;">
                        <span style="font-weight:600;color:#e65100;">Free Trial Active</span>
                        <div style="margin-top:2px;font-size:12px;color:#5f6b7a;">
                          <% var trialEnd = new Date(billingInfo.trial_ends_at); %>
                          <% var daysLeft = Math.ceil((trialEnd - new Date()) / (1000*60*60*24)); %>
                          Ends <strong><%= trialEnd.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) %></strong>
                          (<%= daysLeft %> day<%= daysLeft !== 1 ? 's' : '' %> remaining)
                        </div>
                        <div style="margin-top:2px;font-size:12px;color:#5f6b7a;">
                          First payment will be charged after trial ends.
                        </div>
                      </div>
                    <% } else { %>
                      <% if (!billingInfo.is_trial || parseFloat(billingInfo.amount_paid || 0) > 1) { %>
                        <div style="margin-top:4px;">
                          Last payment: <strong>$<%= parseFloat(billingInfo.amount_paid || 0).toFixed(2) %></strong>
                          on <%= new Date(billingInfo.created_at).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) %>
                        </div>
                      <% } %>
                      <% if (billingInfo.next_payment_end_date) { %>
                        <div>
                          Next renewal: <strong><%= new Date(billingInfo.next_payment_end_date).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) %></strong>
                          <% if (pendingPlan) { %>
                            <span style="font-size:11px;color:#1565c0;">(will switch to <%= pendingPlan.plan_name %>)</span>
                          <% } %>
                        </div>
                      <% } %>
                    <% } %>
                  </div>
                <% } %>
              </div>
              <button class="btn-link" id="open-plan-modal" type="button">Change Plan</button>
            </div>
          </div>

          <div class="card">
            <h4>Cancel Subscription</h4>
            <small>End your subscription at the end of the current billing cycle.</small>
            <div class="content-row">
              <button class="btn-danger btn-link" id="open-cancel-modal" type="button">Cancel Subscription</button>
            </div>
          </div>

          <% if (paymentProvider === 'stripe') { %>
          <div class="card">
            <h4>Invoices</h4>
            <small>Latest Stripe invoices and payment receipts for this subscription.</small>
            <% if (stripeInvoices && stripeInvoices.length) { %>
            <ul class="billing-invoice-list">
              <% stripeInvoices.forEach((invoice) => { %>
              <li class="billing-invoice-item">
                <div class="billing-invoice-meta">
                  <div class="billing-invoice-title"><%= invoice.number || invoice.id %></div>
                  <div class="billing-invoice-copy">
                    <span class="billing-pill"><%= (invoice.status || 'unknown').replace(/_/g, ' ') %></span>
                    <% if (invoice.createdAt) { %>
                    <span>Issued <%= new Date(invoice.createdAt).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) %></span>
                    <% } %>
                  </div>
                  <div class="billing-invoice-copy">
                    Paid: <strong><%= invoice.currency %> <%= Number(invoice.amountPaid || 0).toFixed(2) %></strong>
                    <% if (Number(invoice.amountDue || 0) > 0) { %>
                    | Due: <strong><%= invoice.currency %> <%= Number(invoice.amountDue || 0).toFixed(2) %></strong>
                    <% } %>
                  </div>
                </div>
                <div class="billing-invoice-actions">
                  <% if (invoice.hostedInvoiceUrl) { %>
                  <a class="btn-link btn-inline" href="<%= invoice.hostedInvoiceUrl %>" target="_blank" rel="noopener noreferrer">Open</a>
                  <% } %>
                  <% if (invoice.invoicePdf) { %>
                  <a class="btn-link btn-inline" href="<%= invoice.invoicePdf %>" target="_blank" rel="noopener noreferrer">PDF</a>
                  <% } %>
                </div>
              </li>
              <% }) %>
            </ul>
            <% } else { %>
            <p class="billing-empty">No Stripe invoices found yet. New subscription invoices will appear here automatically.</p>
            <% } %>
          </div>
          <% } %>
          <% } %>
        </section>

        <section id="security" class="settings-section">
          <h1>Security</h1>
          <p class="lead">Manage your account security and password.</p>

          <div class="card security-card">
            <h4>Email</h4>
            <small>Update your account email address</small>
            <form id="security-email-form" action="/account/settings/security/email" method="POST">
              <input type="hidden" name="redirectTo" value="/account/settings" />
              <div class="content-row">
                <div class="field-group">
                  <label class="form-label" for="settings-email">Email</label>
                  <input
                    type="email"
                    id="settings-email"
                    name="email"
                    value="<%= user?.email || '' %>"
                    placeholder="you@example.com"
                    class="form-input"
                  />
                </div>
                <div class="form-actions">
                  <button class="btn-link" type="submit">Update Email</button>
                </div>
              </div>
            </form>
          </div>

          <div class="card security-card">
            <h4>Change Password</h4>
            <small>Update your password to keep your account secure</small>
            <form id="security-password-form" action="/account/settings/security/password" method="POST">
              <input type="hidden" name="redirectTo" value="/account/settings" />
              <div class="content-row">
                <div class="field-group">
                  <label class="form-label" for="settings-new-password">New Password</label>
                  <div class="input-with-icon">
                    <button class="input-icon-btn" type="button" data-toggle="settings-new-password" aria-label="Show password">
                      <i class="fa-solid fa-eye fa-fw" aria-hidden="true"></i>
                    </button>
                    <input
                      type="password"
                      id="settings-new-password"
                      name="password"
                      placeholder="New password"
                      autocomplete="new-password"
                      class="form-input"
                      required
                    />
                  </div>
                </div>
                <div class="field-group">
                  <label class="form-label" for="settings-confirm-password">Confirm New Password</label>
                  <div class="input-with-icon">
                    <button class="input-icon-btn" type="button" data-toggle="settings-confirm-password" aria-label="Show password">
                      <i class="fa-solid fa-eye fa-fw" aria-hidden="true"></i>
                    </button>
                    <input
                      type="password"
                      id="settings-confirm-password"
                      name="confirmPassword"
                      placeholder="Confirm new password"
                      autocomplete="new-password"
                      class="form-input"
                      required
                    />
                  </div>
                </div>
                <div class="form-actions">
                  <button class="btn-primary btn-link" type="submit">Update Password</button>
                </div>
              </div>
            </form>
          </div>

          <!--
          <div class="card">
            <h4>Two-Factor Authentication</h4>
            <small>Add an extra layer of security to your account.</small>
            <div class="content-row">
              <div class="text-muted-sm">Status: Off</div>
              <button class="btn-link" type="button">Enable 2FA</button>
            </div>
          </div>

          <div class="card">
            <h4>Active Sessions</h4>
            <small>Manage and revoke active sessions on your account.</small>
            <div class="content-row">
              <div class="text-muted-sm">View and revoke sessions.</div>
              <button class="btn-link" type="button">View Sessions</button>
            </div>
          </div>
          -->
        </section>

        <% if (typeof notificationPrefs !== 'undefined' && Array.isArray(notificationPrefs) && notificationPrefs.length) {
             const _saved = (typeof savedNotificationPrefs !== 'undefined' && savedNotificationPrefs) ? savedNotificationPrefs : {}; %>
        <section id="notifications" class="settings-section">
          <h1>Email Notifications</h1>
          <p class="lead">Choose which non-essential emails you want to receive. Security, billing, and other transactional emails are always sent.</p>

          <div class="card">
            <h4>Your preferences</h4>
            <small>These options are based on your role. Unchecked items will not be emailed to you.</small>
            <form action="/account/settings/notifications" method="POST" autocomplete="off">
              <ul class="notif-list" style="display:flex;flex-direction:column;gap:10px;margin:14px 0 16px;padding:0;list-style:none;">
                <% notificationPrefs.forEach(function(p) {
                     const checked = (p.key in _saved) ? !!_saved[p.key] : true; %>
                  <li style="display:flex;align-items:flex-start;gap:12px;padding:12px 14px;border:1px solid #e5e7eb;border-radius:10px;background:#f9fafb;">
                    <input type="checkbox" name="preferences" id="acc-pref-<%= p.key %>" value="<%= p.key %>" <%= checked ? 'checked' : '' %> style="margin-top:4px;width:18px;height:18px;accent-color:#01535b;flex-shrink:0;cursor:pointer;" />
                    <label for="acc-pref-<%= p.key %>" style="flex:1;cursor:pointer;">
                      <span style="font-weight:600;color:#0f172a;font-size:0.93rem;display:block;"><%= p.label %></span>
                      <% if (p.description) { %><span style="font-size:0.83rem;color:#64748b;margin-top:2px;line-height:1.4;display:block;"><%= p.description %></span><% } %>
                    </label>
                  </li>
                <% }); %>
              </ul>
              <div class="content-row" style="justify-content:flex-end;">
                <button type="submit" class="btn-primary btn-link">Save preferences</button>
              </div>
            </form>
          </div>
        </section>
        <% } %>
      </main>
    </div>
    <div class="modal-overlay" id="cancel-modal">
      <div class="modal-card cancel-modal">
        <button class="modal-close" type="button" id="cancel-modal-close">x</button>
        <h2>Cancel Your Subscription</h2>
        <p>We are sorry to see you go. Please read the information below before proceeding.</p>
        <p>
          Once you confirm this cancellation, your organization subscription will be placed on hold.
          Your data will be preserved and you can return at any time by contacting support.
          After the current billing cycle ends, all users associated with your organization will be unable to log in.
        </p>
        <p>
          If you have questions or feedback, please <a href="mailto:info@managira.com">email us at info@managira.com</a>.
          We want you to know you are always welcome back.
        </p>
        <p><strong>Please confirm the following details to proceed:</strong></p>
        <form action="/account/cancel-subscription" method="POST">
          <div class="content-row">
            <div class="field-group">
              <label class="form-label" for="cancel-org-name">Organization Name</label>
              <input
                type="text"
                id="cancel-org-name"
                name="orgName"
                placeholder="Enter your organization name"
                required
                class="form-input"
              />
            </div>
            <div class="field-group">
              <label class="form-label" for="cancel-password">Password</label>
              <input
                type="password"
                id="cancel-password"
                name="password"
                placeholder="Enter your password"
                required
                class="form-input"
              />
            </div>
            <p class="warning-text">
              By confirming, all users in your organization will be unable to log in after the current billing period ends.
            </p>
            <div class="form-actions">
              <button type="submit" class="btn-danger btn-link">Confirm Cancellation</button>
            </div>
          </div>
        </form>
      </div>
    </div>
    <div class="modal-overlay" id="billing-password-modal">
      <div class="modal-card password-modal">
        <button class="modal-close" type="button" id="billing-password-close">x</button>
        <h2>Confirm Password</h2>
        <p>Please confirm your password to continue.</p>
        <div class="content-row">
          <div class="field-group">
            <label class="form-label" for="billing-password-input">Password</label>
            <input
              type="password"
              id="billing-password-input"
              placeholder="Enter your password"
              class="form-input"
            />
          </div>
          <p class="error-text" id="billing-password-error"></p>
          <div class="form-actions">
            <button class="btn-primary btn-link" id="billing-password-submit" type="button">Continue</button>
          </div>
        </div>
      </div>
    </div>
    <div class="modal-overlay" id="payment-method-modal">
      <div class="modal-card wide">
        <button class="modal-close" type="button" id="payment-method-close">x</button>
        <h2>Subscription Payment Method</h2>
        <p class="modal-helper">Choose which saved card should be used for subscription billing.</p>
        <% const activeCardId = defaultPaymentMethod ? defaultPaymentMethod.id : null; %>
        <% if (paymentMethods && paymentMethods.length) { %>
          <ul class="card-list">
            <% paymentMethods.forEach((card) => { %>
              <li class="card-item <%= card.id === activeCardId ? 'active' : '' %>">
                <div class="card-meta">
                  <strong><%= card.brand || 'Card' %></strong>
                  <span class="text-muted-sm">**** <%= card.last4 %> - Exp <%= card.expMonth %>/<%= card.expYear %></span>
                </div>
                <div class="card-actions">
                  <% if (card.id === activeCardId) { %>
                    <span class="pill">Active</span>
                  <% } else { %>
                    <button class="btn-link set-primary-card" type="button" data-id="<%= card.id %>">Set Active</button>
                  <% } %>
                  <% if (paymentMethods.length > 1) { %>
                    <button class="btn-link remove-card" type="button" data-id="<%= card.id %>">Remove</button>
                  <% } %>
                </div>
              </li>
            <% }) %>
          </ul>
        <% } else { %>
          <p class="list-empty">No saved cards yet.</p>
        <% } %>
        <div class="content-row">
          <button class="btn-primary btn-link" id="add-card-from-settings" type="button">Add New Card</button>
        </div>
      </div>
    </div>
    <div class="modal-overlay" id="school-account-modal">
      <div class="modal-card wide school-account-modal">
        <button class="modal-close" type="button" id="school-account-close">x</button>
        <h2>Self Enrollment Transaction Account</h2>
        <p class="modal-helper">Select the account that should receive payments from parents.</p>
        <% if (paystackSubaccounts && paystackSubaccounts.length) { %>
          <ul class="card-list" id="school-account-list">
            <% paystackSubaccounts.forEach((account) => { %>
              <li class="card-item <%= account.is_primary ? 'active' : '' %>">
                <div class="card-meta">
                  <strong><%= account.account_type === 'stripe_card' ? 'Stripe Card' : account.account_type === 'mobile_money' ? 'Mobile Money' : 'Bank' %></strong>
                  <span class="text-muted-sm"><%= account.business_name %></span>
                  <span class="text-muted-sm">
                    <% if (account.account_type === 'bank') { %>
                      <%= account.bank_name || account.bank_code || 'Bank' %>
                    <% } else if (account.account_type === 'stripe_card') { %>
                      **** <%= account.account_number %> &mdash; Stripe
                    <% } else { %>
                      <%= account.momo_provider || 'MoMo' %> - <%= account.momo_number %>
                    <% } %>
                  </span>
                </div>
                <div class="card-actions">
                  <% if (account.is_primary) { %>
                    <span class="pill">Active</span>
                  <% } else { %>
                    <button class="btn-link set-school-primary" type="button" data-id="<%= account.id %>" data-type="<%= account.account_type %>">Set Active</button>
                  <% } %>
                  <button class="btn-link edit-school-account" type="button" data-id="<%= account.id %>">Edit</button>
                </div>
              </li>
            <% }) %>
          </ul>
        <% } else { %>
          <p class="list-empty">No payout accounts added yet.</p>
        <% } %>

        <form id="school-account-form">
          <input type="hidden" id="sa-id" name="id" />
          <div class="content-row">
            <div class="field-group">
              <label class="form-label" for="sa-type">Payment Type</label>
              <select id="sa-type" name="account_type" class="form-select" required>
                <option value="">-- Choose Option --</option>
                <option value="bank">Bank Account</option>
                <option value="stripe_card">Stripe Card</option>
              </select>
            </div>
            <div class="field-group">
              <label class="form-label" for="sa-business-name">Business/School Name</label>
              <input id="sa-business-name" name="business_name" class="form-input" type="text" required />
            </div>

            <div id="sa-bank-fields" class="form-split">
              <div class="field-group">
                <label class="form-label" for="sa-account-holder">Account Holder Name</label>
                <input id="sa-account-holder" name="account_holder_name" class="form-input" type="text" />
              </div>
              <div class="field-group">
                <label class="form-label" for="sa-bank-name-input">Bank Name</label>
                <input id="sa-bank-name-input" name="bank_name" class="form-input" type="text" />
              </div>
              <div class="field-group">
                <label class="form-label" for="sa-account-number">Account Number</label>
                <input id="sa-account-number" name="account_number" class="form-input" type="text" />
              </div>
              <div class="field-group">
                <label class="form-label" for="sa-routing-number">Routing / Sort Code</label>
                <input id="sa-routing-number" name="routing_number" class="form-input" type="text" placeholder="Optional for some countries" />
              </div>
              <div class="field-group">
                <label class="form-label" for="sa-bank-country">Country</label>
                <select id="sa-bank-country" name="bank_country" class="form-select">
                  <option value="US">United States</option>
                  <option value="GB">United Kingdom</option>
                  <option value="CA">Canada</option>
                  <option value="AU">Australia</option>
                  <option value="DE">Germany</option>
                  <option value="FR">France</option>
                  <option value="GH">Ghana</option>
                  <option value="NG">Nigeria</option>
                  <option value="KE">Kenya</option>
                  <option value="ZA">South Africa</option>
                </select>
              </div>
              <div class="field-group">
                <label class="form-label" for="sa-bank-currency">Currency Code</label>
                <input id="sa-bank-currency" name="bank_currency" class="form-input" type="text" placeholder="e.g. usd, gbp, ghs" />
              </div>
              <div id="sa-bank-errors" class="form-error" role="alert" style="color:#c0392b;font-size:0.85em;margin-top:4px;"></div>
            </div>

            <div id="sa-stripe-card-fields" style="display:none;">
              <div class="field-group">
                <label class="form-label">Card Details</label>
                <div id="sa-stripe-card-element" style="padding:10px 12px;border:1px solid #ccc;border-radius:4px;background:#fff;"></div>
                <div id="sa-stripe-card-errors" class="form-error" role="alert" style="color:#c0392b;font-size:0.85em;margin-top:4px;"></div>
              </div>
            </div>

            <div class="card-actions">
              <button class="btn-primary btn-link" id="sa-save" type="submit">Save Account</button>
              <button class="btn-link" id="sa-reset" type="button">Add New Account</button>
              <button class="btn-danger btn-link" id="sa-delete" type="button">Delete Account</button>
            </div>
          </div>
        </form>
      </div>
    </div>
    <div class="modal-overlay" id="plan-modal">
      <div class="modal-card wide plan-modal">
        <button class="modal-close" type="button" id="plan-modal-close">x</button>
        <h2>Update Subscription Plan</h2>
        <% if (currentPlan) { %>
          <p class="modal-helper"><strong>Current Plan:</strong> <%= currentPlan.plan_name %></p>
        <% } %>
        <% if (pendingPlan) { %>
          <p class="modal-helper">
            Upcoming plan change to <strong><%= pendingPlan.plan_name %></strong>
            on <strong><%= new Date(pendingPlan.effective_date).toLocaleDateString() %></strong>.
          </p>
        <% } %>
        <form action="/account/update-plan" method="POST" id="updatePlanForm">
          <input
            type="hidden"
            name="newPlanId"
            id="selectedPlanId"
            value="<%= currentPlan ? currentPlan.plan_id : '' %>"
          />
          <input type="hidden" name="newBillingPeriod" id="selectedBillingPeriod" value="" />
          <input type="hidden" name="redirectTo" value="/account/settings?section=billing" />
          <div class="plan-grid">
            <% if (plans && plans.length) { %>
              <% plans.forEach((plan) => { %>
                <div
                  class="plan-option <%= currentPlan && plan.plan_id === currentPlan.plan_id ? 'disabled' : '' %>"
                  data-plan-id="<%= plan.plan_id %>"
                  data-plan-name="<%= plan.plan_name %>"
                  data-base-usd="<%= plan.total_price %>"
                >
                  <div class="plan-option-header"><%= plan.plan_name %></div>
                  <div class="plan-option-body">
                    <p><%= plan.description %></p>
                    <ul class="plan-features">
                      <% if (Array.isArray(plan.features)) { %>
                        <% plan.features.forEach((feature) => { %>
                          <li>- <%= feature.feature_name %></li>
                        <% }) %>
                      <% } else { %>
                        <li>No features available</li>
                      <% } %>
                    </ul>
                  </div>
                  <div class="plan-option-footer" data-base-price="$<%= plan.total_price %>">$<%= plan.total_price %></div>
                </div>
              <% }) %>
            <% } else { %>
              <p class="list-empty">No active plans are available right now.</p>
            <% } %>
          </div>

          <% if (typeof billingPeriods !== 'undefined' && billingPeriods.length > 1) { %>
          <div class="modal-period-section">
            <h3>Choose Your Billing Cycle</h3>
            <div class="modal-period-grid" role="radiogroup" aria-label="Billing period">
              <% var currentBillingKey = (typeof billingInfo !== 'undefined' && billingInfo && billingInfo.billing_period_key) ? billingInfo.billing_period_key : ''; %>
              <% billingPeriods.forEach(function(bp) { %>
                <div
                  class="modal-period-card <%= bp.period_key === currentBillingKey ? 'active current-period' : '' %>"
                  data-key="<%= bp.period_key %>"
                  data-months="<%= bp.months %>"
                  data-discount="<%= bp.discount_percentage %>"
                  role="radio"
                  tabindex="0"
                  aria-checked="<%= bp.period_key === currentBillingKey ? 'true' : 'false' %>"
                >
                  <div class="modal-period-card-label"><%= bp.label %></div>
                  <div class="modal-period-card-price" data-period-price></div>
                  <% if (bp.discount_percentage > 0) { %>
                    <span class="modal-period-card-badge">Save <%= bp.discount_percentage %>%</span>
                  <% } %>
                  <% if (bp.period_key === currentBillingKey) { %>
                    <span class="modal-period-current-tag">Current</span>
                  <% } %>
                </div>
              <% }) %>
            </div>
          </div>
          <% } %>

          <div class="content-row">
            <button type="submit" class="btn-primary btn-link" id="updatePlanBtn" disabled>Update Plan</button>
          </div>
        </form>
      </div>
    </div>
    <div class="settings-nav-overlay"></div>
    <% const resolvedStripePublishableKey = typeof stripePublishableKey !== 'undefined' ? stripePublishableKey : ''; %>
    <% if (resolvedStripePublishableKey) { %>
    <script src="https://js.stripe.com/v3/"></script>
    <% } %>
    <script>
      const orgEmail = <%- JSON.stringify(org?.email || "") %>;
      const orgPhone = <%- JSON.stringify(org?.organization_phone || "") %>;
      const orgName = <%- JSON.stringify(org?.organization_name || "") %>;
      const paymentProvider = <%- JSON.stringify(paymentProvider || "paystack") %>;
      const stripePublishableKey = <%- JSON.stringify(resolvedStripePublishableKey) %>;
      let passwordVerified = <%= passwordVerified ? "true" : "false" %>;

      document.addEventListener("DOMContentLoaded", () => {
        const navLinks = Array.from(document.querySelectorAll(".nav-link"));
        const sections = Array.from(document.querySelectorAll(".settings-section"));
        const navHeader = document.querySelector(".settings-nav-header");
        const navPanel = document.querySelector(".settings-nav");
        const navOverlay = document.querySelector(".settings-nav-overlay");
        const logoInput = document.getElementById("logo");
        const logoSubmit = document.getElementById("logo-submit");
        const fontSelect = document.getElementById("font-select");
        const fontPreview = document.getElementById("font-preview");
        const fontPreviewName = document.getElementById("font-preview-name");
        const cancelModal = document.getElementById("cancel-modal");
        const cancelModalOpen = document.getElementById("open-cancel-modal");
        const cancelModalClose = document.getElementById("cancel-modal-close");
        const newPasswordInput = document.getElementById("settings-new-password");
        const confirmPasswordInput = document.getElementById("settings-confirm-password");
        const paymentModal = document.getElementById("payment-method-modal");
        const paymentModalOpen = document.getElementById("open-payment-modal");
        const paymentModalClose = document.getElementById("payment-method-close");
        const schoolModal = document.getElementById("school-account-modal");
        const schoolModalOpen = document.getElementById("open-school-account-modal");
        const schoolModalClose = document.getElementById("school-account-close");
        const passwordModal = document.getElementById("billing-password-modal");
        const passwordModalClose = document.getElementById("billing-password-close");
        const passwordModalSubmit = document.getElementById("billing-password-submit");
        const passwordModalInput = document.getElementById("billing-password-input");
        const passwordModalError = document.getElementById("billing-password-error");
        const planModal = document.getElementById("plan-modal");
        const planModalOpen = document.getElementById("open-plan-modal");
        const planModalClose = document.getElementById("plan-modal-close");
        const planForm = document.getElementById("updatePlanForm");
        const planOptions = Array.from(document.querySelectorAll(".plan-option"));
        const selectedPlanInput = document.getElementById("selectedPlanId");
        const addCardFromSettings = document.getElementById("add-card-from-settings");
        const schoolAccountForm = document.getElementById("school-account-form");
        const schoolAccountReset = document.getElementById("sa-reset");
        const schoolAccountDelete = document.getElementById("sa-delete");
        const schoolAccountType = document.getElementById("sa-type");
        const schoolAccountBankFields = document.getElementById("sa-bank-fields");
        const schoolAccountStripeCardFields = document.getElementById("sa-stripe-card-fields");
        let saStripeElements = null; // holds { stripe, elements, cardElement }
        const schoolAccountId = document.getElementById("sa-id");
        const schoolAccountBusinessName = document.getElementById("sa-business-name");
        const schoolAccountNumber = document.getElementById("sa-account-number");
        const schoolAccountHolder = document.getElementById("sa-account-holder");
        const schoolAccountBankNameInput = document.getElementById("sa-bank-name-input");
        const schoolAccountRoutingNumber = document.getElementById("sa-routing-number");
        const schoolAccountBankCountry = document.getElementById("sa-bank-country");
        const schoolAccountBankCurrency = document.getElementById("sa-bank-currency");
        const calendarSchoolYearSelect = document.getElementById("calendar-school-year-select");
        const calendarTermSelect = document.getElementById("calendar-term-select");

        function initSettingsCardCollapsibles() {
          const cards = document.querySelectorAll(".settings-section .card");
          cards.forEach((card) => {
            if (card.dataset.collapseReady === "1") return;

            const title = card.querySelector(":scope > h4");
            if (!title) return;

            const head = document.createElement("div");
            head.className = "card-collapse-head";

            card.insertBefore(head, title);
            head.appendChild(title);

            const toggle = document.createElement("button");
            toggle.type = "button";
            toggle.className = "settings-collapse-toggle";

            const setCollapsed = (collapsed) => {
              card.classList.toggle("is-collapsed", collapsed);
              toggle.textContent = collapsed ? "Expand" : "Collapse";
              toggle.setAttribute("aria-expanded", collapsed ? "false" : "true");
            };

            setCollapsed(true);
            toggle.addEventListener("click", () => {
              const collapsed = card.classList.contains("is-collapsed");
              setCollapsed(!collapsed);
            });

            head.appendChild(toggle);
            card.classList.add("card-collapsible");
            card.dataset.collapseReady = "1";
          });
        }

        initSettingsCardCollapsibles();

        function getSettingsScrollOffset() {
          const header = document.getElementById("top-header");
          const headerHeight = header ? header.getBoundingClientRect().height : 64;
          return headerHeight + 20;
        }

        function scrollSectionIntoView(targetId) {
          const targetSection = document.getElementById(targetId);
          if (!targetSection) return;

          const absoluteTop = window.scrollY + targetSection.getBoundingClientRect().top;
          const top = Math.max(0, absoluteTop - getSettingsScrollOffset());
          window.scrollTo({ top, behavior: "smooth" });
        }

        function showSection(targetId, options = {}) {
          const shouldScroll = options.scroll !== false;

          sections.forEach((sec) => {
            sec.style.display = sec.id === targetId ? "block" : "none";
          });
          navLinks.forEach((btn) => {
            btn.classList.toggle("active", btn.dataset.target === targetId);
          });

          if (shouldScroll) {
            requestAnimationFrame(() => scrollSectionIntoView(targetId));
          }
        }

        function setNavOpen(isOpen) {
          if (!navPanel) return;
          navPanel.classList.toggle("open", isOpen);
        }

        function openNav() {
          setNavOpen(!navPanel.classList.contains("open"));
        }

        function closeNav() {
          setNavOpen(false);
        }

        function openModal(modal) {
          if (modal) {
            modal.classList.add("show");
          }
        }

        function closeModal(modal) {
          if (modal) {
            modal.classList.remove("show");
          }
        }

        let pendingModal = null;
        let pendingAction = null;

        function requestPassword(nextModal, nextAction) {
          pendingModal = nextModal;
          pendingAction = nextAction || null;

          // If the session is already verified for this page, continue immediately.
          if (passwordVerified === true) {
            if (pendingAction) {
              pendingAction();
              pendingAction = null;
              pendingModal = null;
            } else if (pendingModal) {
              openModal(pendingModal);
            }
            return;
          }

          // Ensure password modal is never hidden behind another open modal.
          [planModal, paymentModal, schoolModal, cancelModal].forEach((modal) => {
            if (modal && modal !== passwordModal) {
              closeModal(modal);
            }
          });

          if (passwordModalInput) {
            passwordModalInput.value = "";
          }
          if (passwordModalError) {
            passwordModalError.textContent = "";
          }

          if (passwordModal) {
            openModal(passwordModal);
          } else if (pendingAction) {
            // Fallback: if password modal is missing for any reason, do not block actions.
            pendingAction();
            pendingAction = null;
            pendingModal = null;
          }
        }

        navLinks.forEach((btn) => {
          btn.addEventListener("click", () => {
            showSection(btn.dataset.target);
            closeNav();
          });
        });

        if (navHeader) {
          navHeader.addEventListener("click", openNav);
        }

        document.addEventListener("click", (event) => {
          if (window.innerWidth > 960 || !navPanel || !navPanel.classList.contains("open")) {
            return;
          }

          if (navPanel.contains(event.target)) {
            return;
          }

          closeNav();
        });

        window.addEventListener("resize", () => {
          if (window.innerWidth > 960) {
            closeNav();
          }
        });

        if (paymentModalOpen) {
          paymentModalOpen.addEventListener("click", () => requestPassword(paymentModal));
        }

        if (schoolModalOpen) {
          schoolModalOpen.addEventListener("click", () => requestPassword(schoolModal));
        }

        if (paymentModalClose) {
          paymentModalClose.addEventListener("click", () => closeModal(paymentModal));
        }

        if (schoolModalClose) {
          schoolModalClose.addEventListener("click", () => closeModal(schoolModal));
        }

        if (passwordModalClose) {
          passwordModalClose.addEventListener("click", () => closeModal(passwordModal));
        }

        if (planModalOpen) {
          planModalOpen.addEventListener("click", () => requestPassword(planModal));
        }

        if (planModalClose) {
          planModalClose.addEventListener("click", () => closeModal(planModal));
        }

        if (paymentModal) {
          paymentModal.addEventListener("click", (event) => {
            if (event.target === paymentModal) {
              closeModal(paymentModal);
            }
          });
        }

        if (schoolModal) {
          schoolModal.addEventListener("click", (event) => {
            if (event.target === schoolModal) {
              closeModal(schoolModal);
            }
          });
        }

        if (planModal) {
          planModal.addEventListener("click", (event) => {
            if (event.target === planModal) {
              closeModal(planModal);
            }
          });
        }

        if (passwordModal) {
          passwordModal.addEventListener("click", (event) => {
            if (event.target === passwordModal) {
              closeModal(passwordModal);
            }
          });
        }

        if (passwordModalSubmit && passwordModalInput) {
          passwordModalSubmit.addEventListener("click", async () => {
            const passwordValue = passwordModalInput.value.trim();
            if (!passwordValue) {
              if (passwordModalError) {
                passwordModalError.textContent = "Password is required.";
              }
              return;
            }

            passwordModalSubmit.disabled = true;
            passwordModalSubmit.textContent = "Checking...";

            try {
              const response = await fetch("/account/confirm-password/json", {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({ password: passwordValue }),
              });

              const result = await response.json();
              if (result.success) {
                passwordVerified = true;
                closeModal(passwordModal);
                if (pendingAction) {
                  pendingAction();
                  pendingAction = null;
                  pendingModal = null;
                } else {
                  openModal(pendingModal);
                }
              } else if (passwordModalError) {
                passwordModalError.textContent = result.message || "Incorrect password.";
              }
            } catch (error) {
              if (passwordModalError) {
                passwordModalError.textContent = "Unable to verify password. Try again.";
              }
            } finally {
              passwordModalSubmit.disabled = false;
              passwordModalSubmit.textContent = "Continue";
            }
          });
        }

        if (logoInput && logoSubmit) {
          logoSubmit.disabled = !logoInput.files.length;
          logoSubmit.classList.toggle("ready", logoInput.files.length > 0);
          logoInput.addEventListener("change", () => {
            logoSubmit.disabled = !logoInput.files.length;
            logoSubmit.classList.toggle("ready", logoInput.files.length > 0);
          });
        }

        if (fontSelect && fontPreview) {
          // Google Fonts that need to be loaded
          const googleFonts = ['Inter', 'Roboto', 'Open Sans', 'Lato', 'Montserrat', 'Poppins', 'Nunito', 'Raleway', 'Work Sans', 'Source Sans Pro', 'Ubuntu', 'Noto Sans', 'PT Serif', 'Merriweather', 'Playfair Display'];
          const loadedFonts = new Set();

          function loadGoogleFont(fontName) {
            if (loadedFonts.has(fontName) || !googleFonts.includes(fontName)) {
              return;
            }
            const normalizedFont = fontName.replace(/\s+/g, '+');
            const link = document.createElement('link');
            link.rel = 'stylesheet';
            link.href = `https://fonts.googleapis.com/css2?family=${normalizedFont}:wght@300;400;500;600;700&display=swap`;
            document.head.appendChild(link);
            loadedFonts.add(fontName);
          }

          const updateFontPreview = () => {
            const value = fontSelect.value;
            loadGoogleFont(value);
            
            // Determine fallback
            const serifFonts = ['PT Serif', 'Merriweather', 'Playfair Display'];
            const fallback = serifFonts.includes(value) ? 'serif' : 'sans-serif';
            
            // Only update the preview box, not the entire app
            fontPreview.style.fontFamily = `"${value}", ${fallback}`;
          };

          updateFontPreview();
          fontSelect.addEventListener("change", updateFontPreview);
        }

        function syncCalendarTermOptions() {
          if (!calendarSchoolYearSelect || !calendarTermSelect) return;

          const selectedYearId = String(calendarSchoolYearSelect.value || "");
          let firstVisibleOption = null;
          let selectedOptionStillVisible = false;

          Array.from(calendarTermSelect.options).forEach((option) => {
            const optionYearId = String(option.dataset.yearId || "");
            const shouldShow = !selectedYearId || optionYearId === selectedYearId;
            option.hidden = !shouldShow;
            option.disabled = !shouldShow;
            if (shouldShow && !firstVisibleOption) {
              firstVisibleOption = option;
            }
            if (shouldShow && option.selected) {
              selectedOptionStillVisible = true;
            }
          });

          if (!selectedOptionStillVisible && firstVisibleOption) {
            firstVisibleOption.selected = true;
          }
        }

        if (calendarSchoolYearSelect && calendarTermSelect) {
          syncCalendarTermOptions();

          calendarSchoolYearSelect.addEventListener("change", () => {
            syncCalendarTermOptions();
          });

          calendarTermSelect.addEventListener("change", () => {
            const selectedOption = calendarTermSelect.options[calendarTermSelect.selectedIndex];
            const targetUrl = selectedOption ? selectedOption.dataset.targetUrl : "";
            if (targetUrl) {
              window.location.href = targetUrl;
            }
          });
        }

        function updateEyeIcon(button, isVisible) {
          const icon = button.querySelector("i");
          if (!icon) return;
          icon.classList.remove("fa-eye", "fa-eye-slash");
          icon.classList.add("fa-solid", "fa-fw", isVisible ? "fa-eye-slash" : "fa-eye");
          button.setAttribute("aria-label", isVisible ? "Hide password" : "Show password");
        }

        document.querySelectorAll(".input-icon-btn[data-toggle]").forEach((button) => {
          const inputId = button.getAttribute("data-toggle");
          const input = document.getElementById(inputId);
          if (!input) return;

          button.addEventListener("click", () => {
            const isVisible = input.type === "text";
            input.type = isVisible ? "password" : "text";
            updateEyeIcon(button, !isVisible);
          });
        });

        function closeCancelModal() {
          if (cancelModal) {
            cancelModal.classList.remove("show");
          }
        }

        if (cancelModalOpen && cancelModal) {
          cancelModalOpen.addEventListener("click", () => {
            requestPassword(cancelModal);
          });
        }

        if (cancelModalClose) {
          cancelModalClose.addEventListener("click", closeCancelModal);
        }

        if (cancelModal) {
          cancelModal.addEventListener("click", (event) => {
            if (event.target === cancelModal) {
              closeCancelModal();
            }
          });
        }

        function setPrimaryCardRequest(authorizationCode) {
          return fetch("/account/cards/set-primary", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ authorizationCode }),
          });
        }

        function attachPaymentCardHandlers() {
          document.querySelectorAll(".set-primary-card").forEach((button) => {
            button.addEventListener("click", async () => {
              requestPassword(null, async () => {
                const authorizationCode = button.dataset.id;
                try {
                  const res = await setPrimaryCardRequest(authorizationCode);
                  const data = await res.json();
                  if (data.success) {
                    window.location.reload();
                  } else {
                    alert(data.message || "Failed to update primary card.");
                  }
                } catch (error) {
                  alert("Unable to update the primary card. Try again.");
                }
              });
            });
          });

          document.querySelectorAll(".remove-card").forEach((button) => {
            button.addEventListener("click", async () => {
              requestPassword(null, async () => {
                const savedCardCount = document.querySelectorAll("#payment-method-modal .card-item").length;
                if (savedCardCount <= 1) {
                  alert("You must keep at least one saved card on file.");
                  return;
                }

                const authorizationCode = button.dataset.id;
                if (!confirm("Remove this card?")) {
                  return;
                }
                try {
                  const res = await fetch("/account/remove-card", {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify({ authorizationCode }),
                  });
                  const data = await res.json();
                  if (data.success) {
                    window.location.reload();
                  } else {
                    alert(data.message || "Failed to remove card.");
                  }
                } catch (error) {
                  alert("Unable to remove the card. Try again.");
                }
              });
            });
          });
        }

        attachPaymentCardHandlers();

        if (addCardFromSettings) {
          addCardFromSettings.addEventListener("click", () => {
            closeModal(paymentModal);
            requestPassword(null, () => showStripeCardForm());
          });
        }

        function showStripeCardForm() {
          const modal = document.createElement("div");
          modal.className = "card-modal-overlay";
          modal.innerHTML = `
            <div class="card-modal">
              <div class="card-modal-header">
                <h3>Add New Card</h3>
                <button type="button" class="close-modal">&times;</button>
              </div>
              <div class="card-modal-body">
                <p class="status-text" id="stripe-card-status" role="status" aria-live="polite"></p>
                <p class="card-helper-copy">This saves a card to your organization's Stripe customer for future billing. No charge is made while adding the card.</p>
                <form id="stripe-card-form">
                  <div class="form-group">
                    <label for="stripe-card-element">Card Details</label>
                    <div id="stripe-card-element" class="stripe-card-element"></div>
                  </div>
                  <button type="submit" class="btn btn-primary" id="stripe-card-submit">Save Card</button>
                </form>
              </div>
            </div>
          `;

          document.body.appendChild(modal);

          const statusText = modal.querySelector("#stripe-card-status");
          const submitBtn = modal.querySelector("#stripe-card-submit");
          let stripeCard = null;

          function setStatus(message, tone) {
            statusText.textContent = message || "";
            statusText.classList.remove("error", "success");
            if (tone === "error") statusText.classList.add("error");
            if (tone === "success") statusText.classList.add("success");
          }

          function closeStripeModal() {
            if (stripeCard) {
              stripeCard.unmount();
              stripeCard.destroy();
              stripeCard = null;
            }
            if (modal.parentNode) {
              document.body.removeChild(modal);
            }
          }

          if (!stripePublishableKey || typeof Stripe !== "function") {
            setStatus("Stripe is not available right now. Check your Stripe public key and try again.", "error");
            submitBtn.disabled = true;
          } else {
            const stripe = Stripe(stripePublishableKey);
            const stripeElements = stripe.elements();
            stripeCard = stripeElements.create("card", {
              hidePostalCode: true,
            });
            stripeCard.mount(modal.querySelector("#stripe-card-element"));
            stripeCard.on("change", (event) => {
              if (event.error) {
                setStatus(event.error.message, "error");
              } else if (!event.empty) {
                setStatus("");
              }
            });

            modal.querySelector("#stripe-card-form").addEventListener("submit", async (e) => {
              e.preventDefault();

              submitBtn.disabled = true;
              submitBtn.textContent = "Saving...";
              setStatus("Preparing secure card setup...");

              try {
                const intentResponse = await fetch("/account/cards/stripe/setup-intent", {
                  method: "POST",
                  headers: { "Content-Type": "application/json" },
                });
                const intentData = await intentResponse.json();

                if (!intentResponse.ok || !intentData.success || !intentData.clientSecret) {
                  throw new Error(intentData.message || "Unable to initialize Stripe card setup.");
                }

                const confirmation = await stripe.confirmCardSetup(intentData.clientSecret, {
                  payment_method: {
                    card: stripeCard,
                    billing_details: {
                      email: orgEmail || undefined,
                      name: orgName || undefined,
                      phone: orgPhone || undefined,
                    },
                  },
                });

                if (confirmation.error) {
                  throw new Error(confirmation.error.message || "Unable to save this card.");
                }

                const setupIntent = confirmation.setupIntent;
                if (!setupIntent || setupIntent.status !== "succeeded") {
                  throw new Error("Stripe card setup was not completed.");
                }

                const finalizeResponse = await fetch("/account/cards/stripe/complete", {
                  method: "POST",
                  headers: { "Content-Type": "application/json" },
                  body: JSON.stringify({
                    setupIntentId: setupIntent.id,
                  }),
                });
                const finalizeData = await finalizeResponse.json();

                if (!finalizeResponse.ok || !finalizeData.success) {
                  throw new Error(finalizeData.message || "Unable to save the card to billing.");
                }

                setStatus("Card saved successfully.", "success");
                setTimeout(() => {
                  closeStripeModal();
                  window.location.reload();
                }, 700);
              } catch (error) {
                setStatus(error.message || "Error adding card. Please try again.", "error");
                submitBtn.disabled = false;
                submitBtn.textContent = "Save Card";
              }
            });
          }

          modal.querySelector(".close-modal").addEventListener("click", closeStripeModal);
          modal.addEventListener("click", (e) => {
            if (e.target === modal) {
              closeStripeModal();
            }
          });
        }

        function toggleSchoolAccountFields() {
          if (!schoolAccountType || !schoolAccountBankFields) {
            return;
          }
          const type = schoolAccountType.value;
          const isBank = type === "bank";
          const isStripeCard = type === "stripe_card";

          schoolAccountBankFields.style.display = isBank ? "grid" : "none";
          if (schoolAccountStripeCardFields) {
            schoolAccountStripeCardFields.style.display = isStripeCard ? "block" : "none";
          }

          // Mount/destroy Stripe card element based on visibility
          if (isStripeCard && stripePublishableKey) {
            if (!saStripeElements) {
              const saStripe = Stripe(stripePublishableKey);
              const saElements = saStripe.elements();
              const saCard = saElements.create("card", { style: { base: { fontSize: "14px" } } });
              const mountTarget = document.getElementById("sa-stripe-card-element");
              if (mountTarget) saCard.mount(mountTarget);
              saStripeElements = { stripe: saStripe, elements: saElements, card: saCard };
            }
          } else {
            if (saStripeElements) {
              saStripeElements.card.unmount();
              saStripeElements = null;
            }
          }

          if (schoolAccountNumber) {
            if (isBank) {
              schoolAccountNumber.setAttribute("required", "required");
            } else {
              schoolAccountNumber.removeAttribute("required");
            }
          }
          if (schoolAccountHolder) {
            if (isBank) {
              schoolAccountHolder.setAttribute("required", "required");
            } else {
              schoolAccountHolder.removeAttribute("required");
            }
          }
          if (schoolAccountBankNameInput) {
            if (isBank) {
              schoolAccountBankNameInput.setAttribute("required", "required");
            } else {
              schoolAccountBankNameInput.removeAttribute("required");
            }
          }
        }

        function resetSchoolAccountForm() {
          if (schoolAccountForm) {
            schoolAccountForm.reset();
          }
          if (schoolAccountId) {
            schoolAccountId.value = "";
          }
          if (schoolAccountDelete) {
            schoolAccountDelete.style.display = "none";
          }
          toggleSchoolAccountFields();
        }

        if (schoolAccountType) {
          schoolAccountType.addEventListener("change", toggleSchoolAccountFields);
          toggleSchoolAccountFields();
        }

        if (schoolAccountReset) {
          schoolAccountReset.addEventListener("click", resetSchoolAccountForm);
        }

        document.querySelectorAll(".edit-school-account").forEach((button) => {
          button.addEventListener("click", async () => {
            requestPassword(null, async () => {
              const id = button.dataset.id;
              try {
                const res = await fetch(`/account/paystack/${id}`);
                const data = await res.json();
                if (!data.success) {
                  alert("Failed to load account details.");
                  return;
                }

                const account = data.account;
                if (schoolAccountId) schoolAccountId.value = account.id;
                if (schoolAccountType) schoolAccountType.value = account.account_type;
                if (schoolAccountBusinessName) schoolAccountBusinessName.value = account.business_name || "";

                if (account.account_type === "bank") {
                  if (schoolAccountNumber) schoolAccountNumber.value = account.account_number || "";
                  if (schoolAccountHolder) schoolAccountHolder.value = account.account_holder_name || "";
                  if (schoolAccountBankNameInput) schoolAccountBankNameInput.value = account.bank_name || "";
                  // routing_number, country, currency not stored — leave as defaults
                }
                // stripe_card accounts: card details come from Stripe; no local fields to fill

                toggleSchoolAccountFields();
                if (schoolAccountDelete) {
                  schoolAccountDelete.style.display = "inline-flex";
                }
              } catch (error) {
                alert("Unable to load account. Try again.");
              }
            });
          });
        });

        document.querySelectorAll(".set-school-primary").forEach((button) => {
          button.addEventListener("click", async () => {
            requestPassword(null, async () => {
              const id = button.dataset.id;
              const type = button.dataset.type;
              try {
                const res = await fetch("/account/paystack/set-primary", {
                  method: "POST",
                  headers: { "Content-Type": "application/json" },
                  body: JSON.stringify({ id, account_type: type }),
                });
                const data = await res.json();
                if (data.success) {
                  window.location.reload();
                } else {
                  alert(data.message || "Failed to update primary account.");
                }
              } catch (error) {
                alert("Unable to update primary account. Try again.");
              }
            });
          });
        });

        if (schoolAccountDelete) {
          schoolAccountDelete.addEventListener("click", async () => {
            requestPassword(null, async () => {
              const id = schoolAccountId ? schoolAccountId.value : "";
              if (!id) return;
              if (!confirm("Delete this account?")) return;
              try {
                const res = await fetch(`/account/paystack/${id}`, { method: "DELETE" });
                const data = await res.json();
                if (data.success) {
                  window.location.reload();
                } else {
                  alert(data.message || "Failed to delete account.");
                }
              } catch (error) {
                alert("Unable to delete account. Try again.");
              }
            });
          });
        }

        if (schoolAccountForm) {
          schoolAccountForm.addEventListener("submit", async (event) => {
            event.preventDefault();
            requestPassword(null, async () => {
              const formData = new FormData(schoolAccountForm);
              const payload = Object.fromEntries(formData.entries());
              const isEditing = payload.id && payload.id !== "";

              // ─── Bank account via Stripe ────────────────────────────────────
              if (payload.account_type === "bank") {
                if (!stripePublishableKey) {
                  alert("Stripe is not available. Cannot process bank account.");
                  return;
                }
                const bankErrEl = document.getElementById("sa-bank-errors");
                const saStripeForBank = (saStripeElements && saStripeElements.stripe) || Stripe(stripePublishableKey);

                try {
                  const bankTokenResult = await saStripeForBank.createToken("bank_account", {
                    country: payload.bank_country || "US",
                    currency: (payload.bank_currency || "usd").toLowerCase().trim(),
                    routing_number: payload.routing_number || undefined,
                    account_number: payload.account_number,
                    account_holder_name: payload.account_holder_name || payload.business_name,
                    account_holder_type: "company",
                  });
                  if (bankTokenResult.error) throw new Error(bankTokenResult.error.message);

                  const saveRes = await fetch("/account/paystack/stripe-bank-account", {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify({
                      bankToken: bankTokenResult.token.id,
                      business_name: payload.business_name,
                      bank_name: payload.bank_name,
                      bank_country: payload.bank_country || "US",
                    }),
                  });
                  const saveData = await saveRes.json();
                  if (!saveRes.ok || !saveData.success) throw new Error(saveData.message || "Failed to save bank account.");

                  window.location.reload();
                } catch (err) {
                  if (bankErrEl) bankErrEl.textContent = err.message || "Error saving bank account.";
                  else alert(err.message || "Error saving bank account.");
                }
                return;
              }

              // ─── Stripe Card flow ───────────────────────────────────────────
              if (payload.account_type === "stripe_card") {
                if (!stripePublishableKey || !saStripeElements) {
                  alert("Stripe is not available. Please select Stripe Card type again.");
                  return;
                }
                const { stripe, card } = saStripeElements;
                const errEl = document.getElementById("sa-stripe-card-errors");

                try {
                  // Step 1: get SetupIntent client secret
                  const intentRes = await fetch("/account/cards/stripe/setup-intent", {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                  });
                  const intentData = await intentRes.json();
                  if (!intentRes.ok || !intentData.success) {
                    throw new Error(intentData.message || "Unable to start card setup.");
                  }

                  // Step 2: confirm card with Stripe.js (no charge)
                  const { setupIntent, error: stripeErr } = await stripe.confirmCardSetup(
                    intentData.clientSecret,
                    { payment_method: { card } }
                  );
                  if (stripeErr) throw new Error(stripeErr.message);
                  if (setupIntent.status !== "succeeded") throw new Error("Card setup did not complete.");

                  // Step 3: save to paystack_subaccounts as stripe_card
                  const saveRes = await fetch("/account/paystack/stripe-card", {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify({
                      setupIntentId: setupIntent.id,
                      business_name: payload.business_name,
                    }),
                  });
                  const saveData = await saveRes.json();
                  if (!saveRes.ok || !saveData.success) throw new Error(saveData.message || "Failed to save card.");

                  window.location.reload();
                } catch (err) {
                  if (errEl) errEl.textContent = err.message || "Error saving Stripe card.";
                  else alert(err.message || "Error saving Stripe card.");
                }
                return;
              }

              // ─── Bank account (regular Paystack) flow ──────────────────────
              const url = isEditing ? "/account/paystack" : "/account/add-paystack-subaccount";
              const method = isEditing ? "PUT" : "POST";

              try {
                const res = await fetch(url, {
                  method,
                  headers: { "Content-Type": "application/json" },
                  body: JSON.stringify(payload),
                });
                const data = await res.json();
                if (data.success) {
                  window.location.reload();
                } else {
                  alert(data.message || "Failed to save account.");
                }
              } catch (error) {
                alert("Unable to save account. Try again.");
              }
            });
          });
        }

        if (planOptions.length && selectedPlanInput) {
          const currentPlanId = selectedPlanInput.value;
          let selectedPlanName = "";
          const billingPeriodInput = document.getElementById("selectedBillingPeriod");
          const periodCards = Array.from(document.querySelectorAll(".modal-period-card"));
          const updatePlanBtn = document.getElementById("updatePlanBtn");
          const currentBillingKey = <%- JSON.stringify((typeof billingInfo !== 'undefined' && billingInfo && billingInfo.billing_period_key) ? billingInfo.billing_period_key : '') %>;
          let planChanged = false;
          let billingCycleChanged = false;

          const currentSelectedOption = planOptions.find(
            (option) => String(option.dataset.planId || "") === String(selectedPlanInput.value || "")
          );
          if (currentSelectedOption) {
            selectedPlanName = currentSelectedOption.dataset.planName || "this plan";
          }

          function getSelectedPlanBaseUsd() {
            const selected = planOptions.find((o) => o.classList.contains("selected"));
            if (selected) return parseFloat(selected.dataset.baseUsd) || 0;
            // Fall back to current plan
            const current = planOptions.find((o) => o.classList.contains("disabled"));
            if (current) return parseFloat(current.dataset.baseUsd) || 0;
            return 0;
          }

          function updateModalPeriodPrices() {
            const baseUsd = getSelectedPlanBaseUsd();
            periodCards.forEach(function(card) {
              const months = parseInt(card.dataset.months) || 1;
              const discount = parseInt(card.dataset.discount) || 0;
              const priceEl = card.querySelector("[data-period-price]");
              if (!priceEl) return;
              if (baseUsd <= 0) { priceEl.innerHTML = ""; return; }

              const raw = baseUsd * months;
              const final_ = discount > 0 ? raw * (1 - discount / 100) : raw;
              const perMo = final_ / months;

              if (months === 1) {
                priceEl.innerHTML = "$" + baseUsd.toFixed(2) + "/mo";
              } else if (discount > 0) {
                priceEl.innerHTML = '<span class="period-price-strike">$' + raw.toFixed(2) + "</span> $" + final_.toFixed(2)
                  + '<span style="display:block;font-size:11px;color:#5f6b7a;margin-top:1px;">~$' + perMo.toFixed(2) + "/mo</span>";
              } else {
                priceEl.innerHTML = "$" + final_.toFixed(2) + " (~$" + perMo.toFixed(2) + "/mo)";
              }
            });
          }

          function updatePlanFooterPrices() {
            let activePeriodCard = periodCards.find((c) => c.classList.contains("active"));
            const months = activePeriodCard ? (parseInt(activePeriodCard.dataset.months) || 1) : 1;
            const discount = activePeriodCard ? (parseInt(activePeriodCard.dataset.discount) || 0) : 0;

            planOptions.forEach(function(option) {
              const base = parseFloat(option.dataset.baseUsd) || 0;
              const footer = option.querySelector(".plan-option-footer");
              if (!footer) return;
              if (months === 1 && discount === 0) {
                footer.textContent = "$" + base.toFixed(2);
              } else {
                const raw = base * months;
                const final_ = discount > 0 ? raw * (1 - discount / 100) : raw;
                footer.textContent = "$" + final_.toFixed(2);
              }
            });
          }

          function updateSubmitState() {
            if (!updatePlanBtn) return;
            updatePlanBtn.disabled = !(planChanged || billingCycleChanged);
          }

          function selectPeriodCard(card) {
            periodCards.forEach(function(c) {
              c.classList.remove("active");
              c.setAttribute("aria-checked", "false");
            });
            card.classList.add("active");
            card.setAttribute("aria-checked", "true");
            if (billingPeriodInput) billingPeriodInput.value = card.dataset.key;
            billingCycleChanged = card.dataset.key !== currentBillingKey;
            updatePlanFooterPrices();
            updateModalPeriodPrices();
            updateSubmitState();
          }

          // Plan card click
          planOptions.forEach((option) => {
            option.addEventListener("click", () => {
              const planId = option.dataset.planId;
              if (planId === currentPlanId) {
                // Re-selecting current plan (deselect any other)
                planOptions.forEach((plan) => plan.classList.remove("selected"));
                selectedPlanInput.value = currentPlanId;
                planChanged = false;
                updateModalPeriodPrices();
                updatePlanFooterPrices();
                updateSubmitState();
                return;
              }

              planOptions.forEach((plan) => plan.classList.remove("selected"));
              option.classList.add("selected");
              selectedPlanInput.value = planId;
              selectedPlanName = option.dataset.planName || "this plan";
              planChanged = true;
              updateModalPeriodPrices();
              updatePlanFooterPrices();
              updateSubmitState();
            });
          });

          // Billing period card click
          periodCards.forEach(function(card) {
            card.addEventListener("click", function() { selectPeriodCard(this); });
            card.addEventListener("keydown", function(e) {
              if (e.key === "Enter" || e.key === " ") { e.preventDefault(); selectPeriodCard(this); }
            });
          });

          // Initial price calculation
          updateModalPeriodPrices();
          updatePlanFooterPrices();

          if (planForm) {
            planForm.addEventListener("submit", (event) => {
              event.preventDefault();
              if (!planChanged && !billingCycleChanged) {
                alert("Please select a different plan or billing cycle before proceeding.");
                return;
              }

              // Build confirmation message
              let confirmMsg = "";
              if (planChanged) {
                confirmMsg += 'You are about to change your plan to "' + selectedPlanName + '".';
              }
              if (billingCycleChanged) {
                const activeCard = periodCards.find((c) => c.classList.contains("active"));
                const newLabel = activeCard ? activeCard.querySelector(".modal-period-card-label").textContent : "selected cycle";
                confirmMsg += (confirmMsg ? " " : "") + "Your billing cycle will change to " + newLabel + ".";
              }
              confirmMsg += " Continue?";

              closeModal(planModal);

              requestPassword(null, () => {
                if (confirm(confirmMsg)) {
                  planForm.submit();
                }
              });
            });
          }
        }

        const securityEmailForm = document.getElementById("security-email-form");
        const securityPasswordForm = document.getElementById("security-password-form");

        if (securityEmailForm) {
          securityEmailForm.addEventListener("submit", (event) => {
            event.preventDefault();
            requestPassword(null, () => securityEmailForm.submit());
          });
        }

        if (securityPasswordForm) {
          securityPasswordForm.addEventListener("submit", (event) => {
            event.preventDefault();
            requestPassword(null, () => securityPasswordForm.submit());
          });
        }

        const themeRefreshKey = "theme-hard-refresh-applied";
        const urlParams = new URLSearchParams(window.location.search);

        if (urlParams.get("themeApplied") === "1") {
          const alreadyRefreshed = sessionStorage.getItem(themeRefreshKey) === "1";

          if (!alreadyRefreshed) {
            sessionStorage.setItem(themeRefreshKey, "1");
            const forcedUrl = new URL(window.location.href);
            forcedUrl.searchParams.set("_themeRefreshTs", String(Date.now()));
            window.location.replace(forcedUrl.toString());
            return;
          }

          sessionStorage.removeItem(themeRefreshKey);
          const cleanUrl = new URL(window.location.href);
          cleanUrl.searchParams.delete("themeApplied");
          cleanUrl.searchParams.delete("_themeRefreshTs");
          window.history.replaceState({}, "", cleanUrl.toString());
        }

        const finalParams = new URLSearchParams(window.location.search);
        const initialSection = finalParams.get("section") || "customize";
        showSection(initialSection, { scroll: false });
      });
    </script>
  </body>
</html>
