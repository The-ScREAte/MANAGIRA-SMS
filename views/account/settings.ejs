        // Simple password-gated activate/deactivate toggle used by any
        // integration card that's just an on/off switch (no OAuth connect
        // step) — Google Maps and Maps (Apple) both
        // follow this exact shape, so one generic wiring function replaces
        // what would otherwise be two more full copies of the block above.
        function wireSimpleIntegrationToggle(opts) {
          const modal = document.getElementById(opts.prefix + "-activation-modal");
          const activateOpen = document.getElementById("open-" + opts.prefix + "-activate-modal");
          const deactivateOpen = document.getElementById("open-" + opts.prefix + "-deactivate-modal");
          const close = document.getElementById(opts.prefix + "-activation-close");
          const submit = document.getElementById(opts.prefix + "-activation-submit");
          const input = document.getElementById(opts.prefix + "-activation-input");
          const error = document.getElementById(opts.prefix + "-activation-error");
          const copy = document.getElementById(opts.prefix + "-activation-copy");
          const value = document.getElementById(opts.prefix + "-activation-value");
          const statusPill = document.getElementById(opts.prefix + "-status-pill");
          if (!modal) return;

          function openPasswordModal(mode) {
            const isActivate = mode === "activate";
            if (copy) {
              copy.textContent = isActivate
                ? "Please confirm your password to activate " + opts.label + "."
                : "Please confirm your password to deactivate " + opts.label + ".";
            }
            if (value) value.value = isActivate ? "1" : "0";
            if (input) input.value = "";
            if (error) error.textContent = "";
            openModal(modal);
          }

          function setUiState(isActive) {
            if (statusPill) {
              statusPill.textContent = isActive ? "Active" : "Inactive";
              statusPill.style.background = isActive ? "#dcfce7" : "#fef3c7";
              statusPill.style.color = isActive ? "#166534" : "#92400e";
              statusPill.dataset.activated = isActive ? "1" : "0";
            }
            if (activateOpen) activateOpen.style.display = isActive ? "none" : "block";
            if (deactivateOpen) deactivateOpen.style.display = isActive ? "block" : "none";
          }

          if (activateOpen) activateOpen.addEventListener("click", (event) => { event.preventDefault(); openPasswordModal("activate"); });
          if (deactivateOpen) deactivateOpen.addEventListener("click", (event) => { event.preventDefault(); openPasswordModal("deactivate"); });
          if (close) close.addEventListener("click", () => closeModal(modal));
          modal.addEventListener("click", (event) => { if (event.target === modal) closeModal(modal); });
          if (statusPill) setUiState(statusPill.dataset.activated === "1");

          if (submit && input && value) {
            submit.addEventListener("click", async () => {
              const password = input.value.trim();
              if (!password) {
                if (error) error.textContent = "Password is required.";
                return;
              }

              const activateValue = String(value.value || "0").trim();
              if (error) error.textContent = "";
              submit.disabled = true;
              const previousLabel = submit.textContent;
              submit.textContent = "Processing...";

              try {
                const response = await fetch(opts.endpoint, {
                  method: "POST",
                  headers: {
                    "Content-Type": "application/x-www-form-urlencoded;charset=UTF-8",
                    "Accept": "application/json",
                    "X-Requested-With": "XMLHttpRequest",
                  },
                  body: new URLSearchParams({ activate: activateValue, integrationPassword: password }),
                });

                const result = await response.json();
                if (!response.ok || !result || !result.success) {
                  if (error) error.textContent = (result && result.message) || ("Unable to update " + opts.label + ".");
                  return;
                }

                setUiState(Boolean(result.activated));
                closeModal(modal);
              } catch (err) {
                if (error) error.textContent = "Unable to update " + opts.label + " right now.";
              } finally {
                submit.disabled = false;
                submit.textContent = previousLabel || "Continue";
              }
            });
          }
        }

