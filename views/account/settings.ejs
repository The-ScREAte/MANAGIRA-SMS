        function redirectWhatsappConnectToCanonicalHost() {
          const configuredBaseUrl = String(whatsappCanonicalBaseUrl || "").trim();
          if (!configuredBaseUrl || !/^https?:\/\//i.test(configuredBaseUrl)) {
            return false;
          }

          let targetUrl;
          try {
            targetUrl = new URL(configuredBaseUrl);
          } catch (_) {
            return false;
          }

          if (window.location.origin === targetUrl.origin) {
            return false;
          }

          const nextUrl = new URL(window.location.href);
          nextUrl.protocol = targetUrl.protocol;
          nextUrl.host = targetUrl.host;
          nextUrl.searchParams.set("waConnect", "1");
          try {
            window.sessionStorage.setItem("wa_connect_autostart", "1");
          } catch (_) {}
          window.location.assign(nextUrl.toString());
          return true;
        }

