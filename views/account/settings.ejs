              <% const invoiceTitle = invoice.displayName || 'Managira Invoice (SCREATE LLC)'; %>
              <% const invoiceReference = invoice.displayReference || invoice.number || ('INV-' + invoice.id); %>
              <li class="billing-invoice-item">
