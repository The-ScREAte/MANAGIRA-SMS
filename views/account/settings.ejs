        const integrationInfoBackdrop = document.getElementById("integration-info-backdrop");
        const integrationInfoPanel = document.getElementById("integration-info-panel");
        const integrationInfoTitle = document.getElementById("integration-info-title");
        const integrationInfoBody = document.getElementById("integration-info-body");
        const integrationInfoClose = document.getElementById("integration-info-close");

        function openIntegrationInfo(key) {
          const info = INTEGRATION_INFO[key];
          if (!info || !integrationInfoPanel || !integrationInfoBackdrop) return;

          integrationInfoTitle.textContent = info.title;
          integrationInfoBody.innerHTML = `
            ${info.docsUrl ? `<a href="${info.docsUrl}" target="_blank" rel="noopener" class="integration-info-docs-link">📄 Read the full setup guide &rarr;</a>` : ""}
            <div>
              <h4>What it does</h4>
              <p>${info.whatItDoes}</p>
            </div>
            <div>
              <h4>Good for</h4>
              <p>${info.goodFor}</p>
            </div>
            <div>
              <h4>Who it's good for</h4>
              <ul>${info.goodForWho.map((item) => `<li>${item}</li>`).join("")}</ul>
            </div>
          `;

          integrationInfoBackdrop.classList.add("show");
          integrationInfoPanel.classList.add("show");
          integrationInfoPanel.setAttribute("aria-hidden", "false");
        }

        function closeIntegrationInfo() {
          if (!integrationInfoPanel || !integrationInfoBackdrop) return;
          integrationInfoBackdrop.classList.remove("show");
          integrationInfoPanel.classList.remove("show");
          integrationInfoPanel.setAttribute("aria-hidden", "true");
        }

        document.querySelectorAll(".integration-readmore-link").forEach((link) => {
          link.addEventListener("click", (event) => {
            event.preventDefault();
            openIntegrationInfo(link.dataset.integration);
          });
        });

        if (integrationInfoClose) integrationInfoClose.addEventListener("click", closeIntegrationInfo);
        if (integrationInfoBackdrop) integrationInfoBackdrop.addEventListener("click", closeIntegrationInfo);
        document.addEventListener("keydown", (event) => {
          if (event.key === "Escape") closeIntegrationInfo();
        });

        // Close any open integration ⋮ action menu when clicking anywhere else on the page.
        document.addEventListener("click", (event) => {
          document.querySelectorAll("#integrations details.google-actions-menu[open]").forEach((menu) => {
            if (!menu.contains(event.target)) menu.open = false;
          });
        });

        const smsModal = document.getElementById("sms-activation-modal");
        const smsModalCopy = document.getElementById("sms-activation-copy");
        const smsModalClose = document.getElementById("sms-activation-close");
        const smsModalInput = document.getElementById("sms-activation-input");
        const smsModalError = document.getElementById("sms-activation-error");
        const smsModalSubmit = document.getElementById("sms-activation-submit");

        const providerLabels = {
          arkesel: "Arkesel SMS",
          africastalking: "Africa's Talking SMS",
          twilio: "Twilio SMS",
        };

        let pendingSmsProvider = null;
        let pendingSmsActivate = true;

        function openSmsPasswordModal(provider, activate) {
          if (!smsModal) return;
          pendingSmsProvider = provider;
          pendingSmsActivate = activate;
          const label = providerLabels[provider] || "this SMS provider";
          if (smsModalCopy) {
            smsModalCopy.textContent = `Please confirm your password to ${activate ? "activate" : "deactivate"} ${label}.`;
          }
          if (smsModalInput) smsModalInput.value = "";
          if (smsModalError) smsModalError.textContent = "";
          openModal(smsModal);
          if (smsModalInput) smsModalInput.focus();
        }

        document.querySelectorAll(".sms-open-activate").forEach((el) => {
          el.addEventListener("click", (event) => {
            event.preventDefault();
            openSmsPasswordModal(el.dataset.provider, true);
          });
        });
        document.querySelectorAll(".sms-open-deactivate").forEach((el) => {
          el.addEventListener("click", (event) => {
            event.preventDefault();
            openSmsPasswordModal(el.dataset.provider, false);
          });
        });

        if (smsModalClose && smsModal) {
          smsModalClose.addEventListener("click", () => closeModal(smsModal));
        }
        if (smsModal) {
          smsModal.addEventListener("click", (event) => {
            if (event.target === smsModal) closeModal(smsModal);
          });
        }

        function setSmsCardActivationState(provider, activated) {
          const card = document.querySelector(`.sms-provider-card[data-sms-provider="${provider}"]`);
          if (!card) return;
          window.location.reload();
        }

        if (smsModalSubmit) {
          smsModalSubmit.addEventListener("click", async () => {
            const password = smsModalInput ? smsModalInput.value.trim() : "";
            if (!password) {
              if (smsModalError) smsModalError.textContent = "Password is required.";
              return;
            }
            if (!pendingSmsProvider) return;

            const previousLabel = smsModalSubmit.textContent;
            smsModalSubmit.disabled = true;
            smsModalSubmit.textContent = "Processing...";
            if (smsModalError) smsModalError.textContent = "";

            try {
              const response = await fetch("/account/sms/activate", {
                method: "POST",
                headers: {
                  "Content-Type": "application/x-www-form-urlencoded;charset=UTF-8",
                  "Accept": "application/json",
                  "X-Requested-With": "XMLHttpRequest",
                },
                body: new URLSearchParams({
                  provider: pendingSmsProvider,
                  activate: pendingSmsActivate ? "1" : "0",
                  integrationPassword: password,
                }),
              });

              const result = await response.json().catch(() => ({}));
              if (!response.ok || !result || !result.success) {
                if (smsModalError) smsModalError.textContent = (result && result.message) || "Unable to update this SMS integration.";
                return;
              }

              closeModal(smsModal);
              setSmsCardActivationState(pendingSmsProvider, pendingSmsActivate);
            } catch (error) {
              if (smsModalError) smsModalError.textContent = "Unable to update this SMS integration right now.";
            } finally {
              smsModalSubmit.disabled = false;
              smsModalSubmit.textContent = previousLabel || "Continue";
            }
          });
        }

        function setSmsStatus(provider, message, isError) {
          const el = document.querySelector(`.sms-settings-status[data-provider="${provider}"]`);
          if (!el) return;
          el.textContent = message;
          el.style.color = isError ? "#b91c1c" : "#64748b";
        }

        document.querySelectorAll(".sms-save-settings-button").forEach((button) => {
          button.addEventListener("click", async () => {
            const provider = button.dataset.provider;
            const form = document.querySelector(`form.sms-settings-form[data-provider="${provider}"]`);
            if (!form) return;

            const payload = { provider };
            const apiKeyInput = document.getElementById(`sms-${provider}-api-key`);
            if (apiKeyInput) payload.apiKey = apiKeyInput.value.trim();

            if (provider === "arkesel") {
              const senderInput = document.getElementById("sms-arkesel-sender-id");
              payload.senderId = senderInput ? senderInput.value.trim() : "";
            } else if (provider === "africastalking") {
              const usernameInput = document.getElementById("sms-africastalking-username");
              const senderInput = document.getElementById("sms-africastalking-sender-id");
              payload.username = usernameInput ? usernameInput.value.trim() : "";
              payload.senderId = senderInput ? senderInput.value.trim() : "";
              payload.apiKey = apiKeyInput ? apiKeyInput.value.trim() : "";
            } else if (provider === "twilio") {
              const accountSidInput = document.getElementById("sms-twilio-account-sid");
              const fromNumberInput = document.getElementById("sms-twilio-from-number");
              payload.accountSid = accountSidInput ? accountSidInput.value.trim() : "";
              payload.fromNumber = fromNumberInput ? fromNumberInput.value.trim() : "";
              payload.authToken = apiKeyInput ? apiKeyInput.value.trim() : "";
            }

            const statusKey = `${provider}-config`;
            const previousLabel = button.textContent;
            button.disabled = true;
            button.textContent = "Saving...";
            setSmsStatus(statusKey, "Saving settings...", false);

            try {
              const response = await fetch("/account/sms/settings", {
                method: "POST",
                headers: {
                  "Content-Type": "application/x-www-form-urlencoded;charset=UTF-8",
                  "Accept": "application/json",
                  "X-Requested-With": "XMLHttpRequest",
                },
                body: new URLSearchParams(payload),
              });

              const result = await response.json().catch(() => ({}));
              if (!response.ok || !result || !result.success) {
                setSmsStatus(statusKey, (result && result.message) || "Unable to save SMS settings.", true);
                return;
              }

              setSmsStatus(statusKey, result.message || "Saved.", false);
              setTimeout(() => window.location.reload(), 1600);
            } catch (error) {
              setSmsStatus(statusKey, "Unable to save SMS settings right now.", true);
            } finally {
              button.disabled = false;
              button.textContent = previousLabel || "Save Settings";
            }
          });
        });

        // Test connection: asks the provider if the saved details still work (no message sent).
        document.querySelectorAll(".sms-check-button").forEach((button) => {
          button.addEventListener("click", async () => {
            const provider = button.dataset.provider;
            const previousLabel = button.textContent;
            button.disabled = true;
            button.textContent = "Checking…";
            const statusEl = document.querySelector(`.sms-check-result[data-provider="${provider}"]`);
            try {
              const response = await fetch("/account/sms/check", {
                method: "POST",
                headers: { "Content-Type": "application/x-www-form-urlencoded;charset=UTF-8", "Accept": "application/json", "X-Requested-With": "XMLHttpRequest" },
                body: new URLSearchParams({ provider }),
              });
              const result = await response.json().catch(() => ({}));
              if (statusEl) {
                statusEl.textContent = (result.success ? "✓ " : "✕ ") + (result.message || (result.success ? "Connected." : "Couldn't connect."));
                statusEl.style.color = result.success ? "#15803d" : "#b91c1c";
                statusEl.hidden = false;
              }
            } catch (error) {
              if (statusEl) { statusEl.textContent = "✕ Couldn't check right now. Try again."; statusEl.style.color = "#b91c1c"; statusEl.hidden = false; }
            } finally {
              button.disabled = false;
              button.textContent = previousLabel.trim() || "Test connection";
            }
          });
        });

        document.querySelectorAll(".sms-test-button").forEach((button) => {
          button.addEventListener("click", async () => {
            const provider = button.dataset.provider;
            const recipientInput = document.querySelector(`.sms-test-recipient[data-provider="${provider}"]`);
            const messageInput = document.querySelector(`.sms-test-message[data-provider="${provider}"]`);
            const recipient = recipientInput ? recipientInput.value.trim() : "";
            const message = messageInput ? messageInput.value.trim() : "";

            if (!recipient) {
              setSmsStatus(provider, "Enter a recipient phone number first (e.g. +233551234567).", true);
              return;
            }
            if (!message) {
              setSmsStatus(provider, "Type a message first.", true);
              return;
            }

            const previousLabel = button.textContent;
            button.disabled = true;
            button.textContent = "Sending...";
            setSmsStatus(provider, "Sending...", false);

            try {
              const response = await fetch("/account/sms/test-message", {
                method: "POST",
                headers: {
                  "Content-Type": "application/x-www-form-urlencoded;charset=UTF-8",
                  "Accept": "application/json",
                  "X-Requested-With": "XMLHttpRequest",
                },
                body: new URLSearchParams({ provider, recipient, message }),
              });

              const result = await response.json().catch(() => ({}));
              if (!response.ok || !result || !result.success) {
                setSmsStatus(provider, (result && result.message) || "Send failed.", true);
                return;
              }

              setSmsStatus(provider, "Sent successfully.", false);
            } catch (error) {
              setSmsStatus(provider, "Unable to send right now.", true);
            } finally {
              button.disabled = false;
              button.textContent = previousLabel || "Send";
            }
          });
        });

        document.querySelectorAll(".sms-config-toggle").forEach((button) => {
          button.dataset.defaultLabel = button.textContent;
          button.addEventListener("click", () => {
            const provider = button.dataset.provider;
            const panel = document.querySelector(`.sms-config-panel[data-provider="${provider}"]`);
            if (!panel) return;
            const isHidden = panel.style.display === "none";
            panel.style.display = isHidden ? "block" : "none";
            button.textContent = isHidden ? "Hide Credentials" : button.dataset.defaultLabel;
          });
        });

        document.querySelectorAll(".sms-compose-toggle").forEach((button) => {
          button.dataset.defaultLabel = button.textContent;
          button.addEventListener("click", () => {
            const provider = button.dataset.provider;
            const panel = document.querySelector(`.sms-compose-panel[data-provider="${provider}"]`);
            if (!panel) return;
            const isHidden = panel.style.display === "none";
            panel.style.display = isHidden ? "block" : "none";
            button.textContent = isHidden ? "Hide" : button.dataset.defaultLabel;
            if (isHidden) {
              const recipientInput = panel.querySelector(".sms-test-recipient");
              if (recipientInput) recipientInput.focus();
            }
          });
        });

        document.querySelectorAll(".sms-secret-change-btn").forEach((button) => {
          button.addEventListener("click", () => {
            const provider = button.dataset.provider;
            const displayInput = document.querySelector(`.sms-secret-display[data-provider="${provider}"]`);
            const editInput = document.querySelector(`.sms-secret-edit-input[data-provider="${provider}"]`);
            if (!displayInput || !editInput) return;

            const isChangeMode = button.dataset.mode === "change";
            if (isChangeMode) {
              // Switch to edit mode: hide the dotted display, show the real
              // (empty) input for a new key, button becomes a cancel (✕).
              displayInput.style.display = "none";
              editInput.style.display = "";
              editInput.value = "";
              editInput.focus();
              button.textContent = "✕";
              button.dataset.mode = "cancel";
            } else {
              // Cancel: discard whatever was typed, go back to the locked
              // dotted display, button becomes "Change" again.
              editInput.style.display = "none";
              editInput.value = "";
              displayInput.style.display = "";
              button.textContent = "Change";
              button.dataset.mode = "change";
            }
          });
        });
      })();
    </script>
  </body>
</html>
