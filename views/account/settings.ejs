        function setFeedbackStatus(message, type) {
          if (!settingsFeedbackStatus) return;
          if (!message) {
            settingsFeedbackStatus.hidden = true;
            settingsFeedbackStatus.textContent = "";
            settingsFeedbackStatus.classList.remove("is-error", "is-success");
            return;
          }

          settingsFeedbackStatus.hidden = false;
          settingsFeedbackStatus.textContent = message;
          settingsFeedbackStatus.classList.toggle("is-error", type === "error");
          settingsFeedbackStatus.classList.toggle("is-success", type === "success");
        }

        function updateFeedbackMessageCounter() {
          if (!settingsFeedbackMessage || !settingsFeedbackCounter) return;
          const length = settingsFeedbackMessage.value.length;
          settingsFeedbackCounter.textContent = `${length}/2000`;
          settingsFeedbackCounter.classList.toggle("is-limit", length >= 1900);
        }

        function updateFeedbackRatingLabel() {
          if (!settingsFeedbackRatingLabel) return;
          const selected = settingsFeedbackRatings.find((input) => input.checked);
          settingsFeedbackRatingLabel.textContent = selected ? `${selected.value} out of 5 stars` : "1 to 5 stars";
        }

        function updateFeedbackConditionalFields() {
          if (!settingsFeedbackType) return;

          const selectedType = settingsFeedbackType.value || "";
          const showRating = selectedType === "review";
          const showPriority = selectedType === "feature_request" || selectedType === "bug_report";

          if (settingsFeedbackRatingField) settingsFeedbackRatingField.hidden = !showRating;
          if (settingsFeedbackPriorityField) settingsFeedbackPriorityField.hidden = !showPriority;

          if (settingsFeedbackPriority) {
            settingsFeedbackPriority.required = showPriority;
            if (!showPriority) settingsFeedbackPriority.value = "";
          }

          settingsFeedbackRatings.forEach((input) => {
            input.required = showRating;
            if (!showRating) input.checked = false;
          });

          updateFeedbackRatingLabel();
        }

        async function submitSettingsFeedback(event) {
          event.preventDefault();
          if (!settingsFeedbackForm) return;

          setFeedbackStatus("", "");
          updateFeedbackConditionalFields();

          if (!settingsFeedbackForm.checkValidity()) {
            settingsFeedbackForm.reportValidity();
            return;
          }

          const defaultLabel = settingsFeedbackSubmit ? settingsFeedbackSubmit.textContent : "Submit Feedback";
          if (settingsFeedbackSubmit) {
            settingsFeedbackSubmit.disabled = true;
            settingsFeedbackSubmit.textContent = "Submitting...";
          }

          try {
            const response = await fetch(settingsFeedbackForm.action, {
              method: "POST",
              headers: {
                "Content-Type": "application/json",
                "Accept": "application/json",
              },
              body: JSON.stringify(Object.fromEntries(new FormData(settingsFeedbackForm).entries())),
            });

            const result = await response.json().catch(() => ({}));
            if (!response.ok || !result.success) {
              throw new Error(result.error || "We could not submit your feedback right now.");
            }

            settingsFeedbackForm.reset();
            updateFeedbackConditionalFields();
            updateFeedbackMessageCounter();
            setFeedbackStatus(
              result.feedbackId
                ? `Feedback #${result.feedbackId} sent successfully.`
                : "Feedback sent successfully.",
              "success"
            );
          } catch (error) {
            setFeedbackStatus(error.message || "We could not submit your feedback right now.", "error");
          } finally {
            if (settingsFeedbackSubmit) {
              settingsFeedbackSubmit.disabled = false;
              settingsFeedbackSubmit.textContent = defaultLabel;
            }
          }
        }

        function getSettingsScrollOffset() {
          const header = document.getElementById("top-header");
          const headerHeight = header ? header.getBoundingClientRect().height : 64;
          return headerHeight + 20;
        }

        function scrollSectionIntoView(targetId) {
          const targetSection = document.getElementById(targetId);
          if (!targetSection) return;

          const absoluteTop = window.scrollY + targetSection.getBoundingClientRect().top;
          const top = Math.max(0, absoluteTop - getSettingsScrollOffset());
          window.scrollTo({ top, behavior: "smooth" });
        }

        function showSection(targetId, options = {}) {
          const availableSectionIds = sections.map((sec) => sec.id);
          const resolvedTargetId = availableSectionIds.includes(targetId)
            ? targetId
            : (availableSectionIds[0] || null);

          if (!resolvedTargetId) {
            return;
          }

          const shouldScroll = options.scroll !== false;

          sections.forEach((sec) => {
            sec.style.display = sec.id === resolvedTargetId ? "block" : "none";
          });
          navLinks.forEach((btn) => {
            btn.classList.toggle("active", btn.dataset.target === resolvedTargetId);
          });

          if (shouldScroll) {
            requestAnimationFrame(() => scrollSectionIntoView(resolvedTargetId));
          }
        }

