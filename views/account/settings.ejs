            <p id="payout-pref-feedback" style="margin:10px 0 0;font-size:.75rem;color:var(--muted,#64748b);min-height:1em;"></p>
          </div>

          <script>
            (function(){
              const toggles = document.querySelectorAll('.payout-pref-toggle');
              const fb = document.getElementById('payout-pref-feedback');
              const status = document.getElementById('payout-pref-status');
              let saving = false;
              function currentPref(){
                const selected = Array.from(toggles).find(t => t.checked);
                return selected ? String(selected.dataset.provider || '').trim().toLowerCase() : '';
              }
              let lastPref = currentPref();
              function restorePref(){
                toggles.forEach(t => { t.checked = (String(t.dataset.provider || '').toLowerCase() === lastPref); });
              }
              async function save(){
                if (saving) return;
                const pref = currentPref();
                const labelMap = { stripe: 'Stripe Connect', paystack: 'Paystack' };
                const ok = window.confirm('Route all parent payments through ' + (labelMap[pref] || pref || 'this provider') + '? This applies to Paygira and Public Registration.');
                if (!ok) { restorePref(); return; }
                saving = true;
                fb.textContent = 'Saving…';
                fb.style.color = '#64748b';
                try {
                  const res = await fetch('/account/settings/payout-preference', {
                    method:'POST',
                    headers:{'Content-Type':'application/x-www-form-urlencoded'},
                    body: 'preference=' + encodeURIComponent(currentPref()),
                  });
                  const data = await res.json();
                  if (!data.success) throw new Error(data.message || 'Save failed');
                  lastPref = pref;
                  const p = data.payout || {};
                  fb.textContent = '\u2713 Saved · used by Paygira and Public Registration.';
                  fb.style.color = '#15803d';
                  if (status) {
                    if (p.ready) {
                      status.textContent = 'Ready \u00b7 ' + String(p.provider || '').toUpperCase();
                      status.style.background = '#dcfce7'; status.style.color = '#15803d';
                    } else {
                      status.textContent = 'Not configured';
                      status.style.background = '#fef3c7'; status.style.color = '#92400e';
                    }
                  }
                } catch(e){
                  fb.textContent = 'Could not save: ' + e.message;
                  fb.style.color = '#dc2626';
                } finally { saving = false; }
              }
              toggles.forEach(t => t.addEventListener('change', save));
              const cfgBtn = document.getElementById('paystack-configure-btn');
              if (cfgBtn) cfgBtn.addEventListener('click', function(e){
                e.preventDefault();
                const wrap = document.getElementById('payout-form-wrap');
                const addRow = document.getElementById('payout-add-row');
                if (wrap) { wrap.style.display = 'block'; }
                if (addRow) { addRow.style.display = 'none'; }
                const sel = document.getElementById('sa-type');
                if (sel && !sel.value) sel.focus();
                if (wrap) wrap.scrollIntoView({behavior:'smooth', block:'center'});
              });
            })();
          </script>

