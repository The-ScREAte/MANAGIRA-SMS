          <p class="lead">Activate and connect third-party services used across your academic workspace.</p>

          <% const gi = (typeof googleIntegration !== 'undefined' && googleIntegration) ? googleIntegration : {}; %>
          <% const giActivated = !!gi.activated; %>
          <% const giConfigured = !!gi.configured; %>
          <% const giConnected = !!gi.connected; %>
          <% const giReady = !!gi.shouldShowFeatures; %>
          <% const wi = (typeof whatsappIntegration !== 'undefined' && whatsappIntegration) ? whatsappIntegration : {}; %>
          <% const wiActivated = !!wi.activated; %>
          <% const wiConfigured = !!wi.configured; %>
          <% const wiConnected = !!wi.connected; %>
          <% const wiReady = !!wi.shouldShowFeatures; %>
          <% const wf = (typeof whatsappFrontendConfig !== 'undefined' && whatsappFrontendConfig) ? whatsappFrontendConfig : {}; %>
          <% const hasWhatsappMetaConfig = !!(wf.appId && wf.embeddedSignupConfigId); %>
          <% const spi = (typeof studentPortalIntegration !== 'undefined' && studentPortalIntegration) ? studentPortalIntegration : {}; %>
          <% const spiActivated = !!spi.activated; %>
          <% const mi = (typeof miraIntegration !== 'undefined' && miraIntegration) ? miraIntegration : {}; %>
          <% const miActivated = !!mi.activated; %>
          <% const ti = (typeof transportationIntegration !== 'undefined' && transportationIntegration) ? transportationIntegration : {}; %>
          <% const tiActivated = !!ti.activated; %>
          <% const integrationActivityMap = (typeof integrationActivity !== 'undefined' && integrationActivity) ? integrationActivity : {}; %>
          <%
            function escapeIntegrationActivityText(value) {
              return String(value == null ? '' : value)
                .replace(/&/g, '&amp;')
                .replace(/</g, '&lt;')
                .replace(/>/g, '&gt;')
                .replace(/"/g, '&quot;');
            }
            function integrationActivityLine(recordLabel) {
              const entry = integrationActivityMap[recordLabel];
              if (!entry) return '';
              const when = entry.createdAt ? new Date(entry.createdAt).toLocaleString(undefined, { dateStyle: 'medium', timeStyle: 'short' }) : '';
              const who = escapeIntegrationActivityText(entry.userName || 'Unknown');
              const role = entry.userRole ? ` (${escapeIntegrationActivityText(entry.userRole)})` : '';
              const action = escapeIntegrationActivityText((entry.actionType || '').toLowerCase());
              return `<br><span class="text-muted-sm">Last change: <strong>${action}</strong> by <strong>${who}</strong>${role}${when ? ' on ' + escapeIntegrationActivityText(when) : ''}</span>`;
            }

            // Per-integration network/country coverage, by ISO country code.
            const orgCountryCode = (org && org.organization_country ? String(org.organization_country).trim().toUpperCase() : '');
            const integrationCoverage = {
              arkesel: ['GH', 'NG', 'TZ', 'ZA'],
              africastalking: ['KE', 'UG', 'TZ', 'RW', 'MW', 'ZM', 'NG', 'CI', 'ET', 'GH', 'ZA'],
              twilio: twilioAvailableForCountry ? [orgCountryCode] : [],
              'student-portal': null,
              transportation: null,
              'google-maps': null,
              'apple-maps': null,
              'google-classroom': null,
              whatsapp: null,
              mira: null,
            };
            const orgCountryOption = (settingsCountryOptionsWithCurrency || settingsCountryOptions || []).find(
              (country) => String(country.code || '').toUpperCase() === orgCountryCode
            ) || null;
            const orgCountryName = orgCountryOption ? orgCountryOption.name : '';
            function integrationCoverageBadge(integrationKey) {
              const coverage = integrationCoverage[integrationKey];
              if (!orgCountryCode) return '';
              const isAvailable = !coverage || coverage.includes(orgCountryCode);
              const bg = isAvailable ? '#dcfce7' : '#fef2f2';
              const fg = isAvailable ? '#166534' : '#b91c1c';
              const label = isAvailable ? 'Available' : 'Not available';
              const title = orgCountryName ? `${orgCountryName} (${orgCountryCode})` : orgCountryCode;
              return `<span class="pill sms-coverage-badge" title="${escapeIntegrationActivityText(title)}" style="background:${bg};color:${fg};">${orgCountryCode}: ${label}</span>`;
            }
          %>

