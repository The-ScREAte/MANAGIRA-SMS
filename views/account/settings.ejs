        // navHeader's own click-to-open-mobile-nav handler above.
        if (navCollapseToggle && navPanel && settingsLayoutRoot && navCollapseToggle.dataset.spaMenuBound !== "1") {
          navCollapseToggle.dataset.spaMenuBound = "1";
          const NAV_COLLAPSE_STORAGE_KEY = "managira-settings-nav-collapsed";

          const setNavCollapsed = (isCollapsed) => {
            navPanel.classList.toggle("is-collapsed", isCollapsed);
            settingsLayoutRoot.classList.toggle("is-nav-collapsed", isCollapsed);
            navCollapseToggle.setAttribute("aria-expanded", isCollapsed ? "false" : "true");
            navCollapseToggle.setAttribute("title", isCollapsed ? "Expand sidebar" : "Collapse sidebar");
          };

          let storedCollapsed = false;
          try {
            storedCollapsed = localStorage.getItem(NAV_COLLAPSE_STORAGE_KEY) === "1";
          } catch (_) {}
          setNavCollapsed(storedCollapsed);

          navCollapseToggle.addEventListener("click", (event) => {
            event.stopPropagation();
            const isCollapsed = !navPanel.classList.contains("is-collapsed");
            setNavCollapsed(isCollapsed);
            try {
              localStorage.setItem(NAV_COLLAPSE_STORAGE_KEY, isCollapsed ? "1" : "0");
            } catch (_) {}
          });
        }

        if (!window.__settingsOutsideCloseBound) {
          window.__settingsOutsideCloseBound = true;
