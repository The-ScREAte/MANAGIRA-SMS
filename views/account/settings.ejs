    <div class="modal-overlay" id="payment-method-modal">
      <div class="modal-card wide">
        <button class="modal-close" type="button" id="payment-method-close">x</button>
        <h2>Payment Methods</h2>

        <!-- Tab bar -->
        <div class="pm-tab-bar" role="tablist">
          <button class="pm-tab active" id="pm-tab-subscription" data-pm-tab="subscription" role="tab" aria-selected="true" aria-controls="pm-subscription-panel">Subscription Cards</button>
          <button class="pm-tab" id="pm-tab-payout" data-pm-tab="payout" role="tab" aria-selected="false" aria-controls="pm-payout-panel">Payout Accounts</button>
        </div>

        <!-- ── Subscription Cards panel ─────────────────────────── -->
        <div class="pm-panel active" id="pm-subscription-panel" role="tabpanel" aria-labelledby="pm-tab-subscription">
          <p class="modal-helper">Choose which saved card should be used for subscription billing.</p>
          <% const activeCardId = defaultPaymentMethod ? defaultPaymentMethod.id : null; %>
          <% if (paymentMethods && paymentMethods.length) { %>
            <ul class="card-list">
              <% paymentMethods.forEach((card) => { %>
                <li class="card-item <%= card.id === activeCardId ? 'active' : '' %>">
                  <div class="card-meta">
                    <strong><%= card.brand || 'Card' %></strong>
                    <span class="text-muted-sm">**** <%= card.last4 %> - Exp <%= card.expMonth %>/<%= card.expYear %></span>
                  </div>
                  <div class="card-actions">
                    <% if (card.id === activeCardId) { %>
                      <span class="pill">Active</span>
                    <% } else { %>
                      <button class="btn-link set-primary-card" type="button" data-id="<%= card.id %>">Set Active</button>
                    <% } %>
                    <% if (paymentMethods.length > 1) { %>
                      <button class="btn-link remove-card" type="button" data-id="<%= card.id %>">Remove</button>
                    <% } %>
                  </div>
                </li>
              <% }) %>
            </ul>
          <% } else { %>
            <p class="list-empty">No saved cards yet.</p>
          <% } %>
          <div class="content-row">
            <button class="btn-primary btn-link" id="add-card-from-settings" type="button">Add New Card</button>
          </div>
        </div>

        <!-- ── Payout Accounts panel ────────────────────────────── -->
        <div class="pm-panel" id="pm-payout-panel" role="tabpanel" aria-labelledby="pm-tab-payout">
          <p class="modal-helper">Bank accounts and cards where parents send payments to your school.</p>

          <%# ── Unified Payout Provider Selector ──────────────────────── %>
          <% const _pc = typeof payoutContext !== 'undefined' ? payoutContext : null; %>
          <% const _pcs = (typeof paystackCountries !== 'undefined' && Array.isArray(paystackCountries)) ? paystackCountries : []; %>
          <% const _prefRaw = _pc && _pc.preference ? String(_pc.preference).toLowerCase() : ''; %>
          <% const _pref = (_prefRaw === 'stripe' || _prefRaw === 'paystack') ? _prefRaw : ''; %>
          <% const _stripeReady = _pc && _pc.stripe && _pc.stripe.available; %>
          <% const _paystackReady = _pc && _pc.paystack && _pc.paystack.available; %>
          <% const _country = _pc && _pc.country ? _pc.country : ''; %>
          <% const _paystackCountrySupported = _pc && _pc.paystack && _pc.paystack.countrySupported; %>
          <% const _connectId = typeof stripeConnectAccountId !== 'undefined' ? stripeConnectAccountId : null; %>

          <div id="payout-pref-card" style="border:1px solid var(--border);border-radius:12px;padding:16px;margin-bottom:16px;background:#fff;">
            <div style="display:flex;align-items:center;justify-content:space-between;gap:10px;flex-wrap:wrap;margin-bottom:12px;">
              <div>
                <div style="font-weight:700;font-size:.95rem;color:#0f172a;">Where should parent payments go?</div>
                <div style="font-size:.78rem;color:var(--muted,#64748b);margin-top:2px;">Used by Paygira <strong>and</strong> Public Registration. One setting, everywhere.</div>
              </div>
              <span id="payout-pref-status" style="font-size:.75rem;padding:3px 9px;border-radius:999px;<%= (_stripeReady || _paystackReady) ? 'background:#dcfce7;color:#15803d;' : 'background:#fef3c7;color:#92400e;' %>">
                <% if (_pref) { %>
                  Active &middot; <%= _pref.toUpperCase() %>
                <% } else if (_stripeReady || _paystackReady) { %>
                  Ready
                <% } else { %>Not configured<% } %>
              </span>
            </div>

            <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(230px,1fr));gap:10px;">

              <%# ── Stripe Connect card ── %>
              <label style="display:flex;gap:10px;align-items:flex-start;padding:14px;border:1px solid <%= (_pref==='stripe') ? '#7dd3fc' : 'var(--border)' %>;border-radius:10px;cursor:<%= _stripeReady ? 'pointer' : 'not-allowed' %>;background:<%= (_pref==='stripe') ? '#f0f9ff' : '#fff' %>;<%= !_stripeReady ? 'opacity:.6;' : '' %>">
                <input type="radio" name="payout_pref_provider" class="payout-pref-toggle" data-provider="stripe" <%= (_pref==='stripe') ? 'checked' : '' %> <%= !_stripeReady ? 'disabled' : '' %> style="margin-top:3px;flex-shrink:0;cursor:<%= _stripeReady ? 'pointer' : 'not-allowed' %>">
                <div style="flex:1;min-width:0;">
                  <div style="font-weight:700;font-size:.88rem;">Stripe Connect</div>
                  <div style="font-size:.75rem;color:var(--muted,#64748b);margin-top:2px;">Cards, Apple Pay, Google Pay &middot; 40+ countries</div>
                  <div style="font-size:.72rem;margin-top:5px;<%= _stripeReady ? 'color:#15803d;' : 'color:#92400e;' %>">
                    <%= _stripeReady ? 'Connected' : 'Not connected' %>
                  </div>
                  <% if (_connectId) { %>
                  <div style="font-size:.68rem;color:#475569;margin-top:2px;font-family:'JetBrains Mono',Consolas,monospace;word-break:break-all;"><%= _connectId %></div>
                  <% } %>
                  <a href="/account/stripe-connect/onboard" style="display:inline-flex;align-items:center;gap:5px;margin-top:9px;font-size:.78rem;font-weight:600;color:#635bff;text-decoration:none;padding:6px 11px;border:1px solid #c7d2fe;border-radius:7px;background:#f5f3ff;white-space:nowrap;">
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
                    <%= _stripeReady ? 'Manage on Stripe' : 'Connect with Stripe' %>
                  </a>
                </div>
              </label>

              <%# ── Paystack card ── %>
              <label style="display:flex;gap:10px;align-items:flex-start;padding:14px;border:1px solid <%= (_pref==='paystack') ? '#86efac' : 'var(--border)' %>;border-radius:10px;cursor:<%= _paystackReady ? 'pointer' : 'not-allowed' %>;background:<%= (_pref==='paystack') ? '#f0fdf4' : '#fff' %>;<%= !_paystackReady ? 'opacity:.6;' : '' %>">
                <input type="radio" name="payout_pref_provider" class="payout-pref-toggle" data-provider="paystack" <%= (_pref==='paystack') ? 'checked' : '' %> <%= !_paystackReady ? 'disabled' : '' %> style="margin-top:3px;flex-shrink:0;cursor:<%= _paystackReady ? 'pointer' : 'not-allowed' %>">
                <div style="flex:1;min-width:0;">
                  <div style="font-weight:700;font-size:.88rem;">Paystack</div>
                  <div style="font-size:.75rem;color:var(--muted,#64748b);margin-top:2px;">Bank &middot; Mobile Money &middot; Cards</div>
                  <% if (_pcs.length) { %>
