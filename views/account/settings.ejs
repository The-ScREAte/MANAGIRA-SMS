        // One "Save changes" per group: the group's forms keep working as before,
        // but only the ones that changed are sent, together, then the page reloads.
        function initSaveGroups() {
          document.querySelectorAll("[data-save-group]").forEach((group) => {
            if (group.dataset.saveReady === "1") return;
            group.dataset.saveReady = "1";
            const forms = Array.from(group.querySelectorAll("form")).filter((f) => !f.hasAttribute("data-own-submit"));
            forms.forEach((f) => f.querySelectorAll('button[type="submit"], input[type="submit"]').forEach((b) => {
              if (!b.hasAttribute("data-own-submit") && !b.classList.contains("btn-danger")) b.classList.add("settings-own-save");
            }));
            const bar = document.createElement("div");
            bar.className = "settings-save-bar";
            bar.innerHTML = '<span class="settings-save-bar__note" aria-live="polite"></span><button type="button" class="btn-primary btn-link settings-save-bar__btn">Save changes</button>';
            group.appendChild(bar);
            const note = bar.querySelector("span");
            const btn = bar.querySelector("button");
            const mark = (e) => {
              if (e.target.closest("[data-own-submit]")) return;
              const f = e.target.closest("form");
              if (f && forms.includes(f)) { f.dataset.dirty = "1"; note.textContent = "Unsaved changes"; bar.classList.add("is-dirty"); }
            };
            group.addEventListener("input", mark);
            group.addEventListener("change", mark);
            group.addEventListener("click", (e) => { if (e.target.closest("button, label, [role=radio], [data-theme], [data-color], .theme-option, .color-option")) mark(e); });
            btn.addEventListener("click", async () => {
              const dirty = forms.filter((f) => f.dataset.dirty === "1");
              if (!dirty.length) { note.textContent = "Nothing has changed."; return; }
              for (const f of dirty) if (!f.reportValidity()) return;
              btn.disabled = true;
              note.textContent = "Saving…";
              try {
                for (const f of dirty) {
                  const multipart = String(f.enctype || "").includes("multipart");
                  const files = Array.from(f.querySelectorAll('input[type="file"]'));
                  if (multipart && files.length && files.every((i) => !i.files.length) && !f.querySelector('input:not([type="file"]):not([type="hidden"]), select, textarea')) continue;
                  const data = new FormData(f);
                  const res = await fetch(f.action, {
                    method: "POST",
                    credentials: "same-origin",
                    body: multipart ? data : new URLSearchParams(data),
                    headers: multipart ? {} : { "Content-Type": "application/x-www-form-urlencoded" },
                  });
                  if (!res.ok) throw new Error("save failed");
                }
                const section = group.closest(".settings-section");
                window.location.href = "/account/settings?section=" + encodeURIComponent(section ? section.id : "customize");
              } catch (_e) {
                btn.disabled = false;
                note.textContent = "Some changes could not be saved. Please try again.";
              }
            });
          });
          // Show the chosen photo straight away.
          const pick = document.getElementById("profile-image");
          const face = document.querySelector("[data-me-avatar]");
          if (pick && face && !pick.dataset.previewReady) {
            pick.dataset.previewReady = "1";
            pick.addEventListener("change", () => {
              const file = pick.files && pick.files[0];
              if (!file) return;
              const url = URL.createObjectURL(file);
              face.innerHTML = "";
              const img = document.createElement("img");
              img.src = url;
              img.alt = "New photo";
              face.appendChild(img);
            });
          }
        }
