        function escapeHtml(value) {
          const div = document.createElement("div");
          div.textContent = String(value == null ? "" : value);
          return div.innerHTML;
        }

        function renderWhatsappChecklistItem(item, isLast) {
          const badgeBg = item.done === true ? "#dcfce7" : item.done === false ? "#fef3c7" : "#e2e8f0";
          const badgeFg = item.done === true ? "#166534" : item.done === false ? "#92400e" : "#64748b";
          const badgeGlyph = item.done === true ? "✓" : item.done === false ? "!" : "?";
          const badgeHtml = '<span style="flex:0 0 auto;width:18px;height:18px;border-radius:999px;background:' + badgeBg + ';color:' + badgeFg + ';display:inline-flex;align-items:center;justify-content:center;font-size:11px;font-weight:700;">' + badgeGlyph + '</span>';
          const wrap = document.createElement("div");
          wrap.style.cssText = "padding:8px 12px;" + (isLast ? "" : "border-bottom:1px solid #f1f5f9;");

          let linkHtml = "";
          if (item.done !== true && item.linkTarget) {
            const btnStyle = "display:inline-flex;flex:0 0 auto;padding:2px 9px;font-size:11px;border-radius:999px;";
            if (item.linkDisabled) {
              linkHtml = '<button type="button" class="btn-link" disabled style="' + btnStyle + 'opacity:0.5;cursor:not-allowed;">' + escapeHtml(item.linkLabel || "Go") + '</button>';
            } else if (item.linkType === "external") {
              linkHtml = '<a class="btn-link" href="' + escapeHtml(item.linkTarget) + '" target="_blank" rel="noopener" style="' + btnStyle + '">' + escapeHtml(item.linkLabel || "Open") + '</a>';
            } else if (item.linkType === "internal") {
              linkHtml = '<button type="button" class="btn-link whatsapp-checklist-jump" data-target-id="' + escapeHtml(item.linkTarget) + '" style="' + btnStyle + '">' + escapeHtml(item.linkLabel || "Go") + '</button>';
            }
          }

          wrap.innerHTML =
            '<div style="display:flex;align-items:center;gap:7px;">' +
              badgeHtml +
              '<strong style="font-size:12.5px;">' + escapeHtml(item.label) + '</strong>' +
              (item.required === false ? '<span class="text-muted-sm" style="font-size:11px;">(optional)</span>' : '') +
            '</div>' +
            (item.done !== true ? '<div style="display:flex;align-items:center;gap:8px;flex-wrap:wrap;margin-top:3px;margin-left:25px;"><small style="color:#64748b;font-size:11.5px;">' + escapeHtml(item.instructions) + '</small>' + linkHtml + '</div>' : '');

          if (item.done !== true && !item.linkDisabled && item.linkType === "internal") {
            const jumpBtn = wrap.querySelector(".whatsapp-checklist-jump");
            if (jumpBtn) {
              jumpBtn.addEventListener("click", () => {
                const target = document.getElementById(item.linkTarget);
                if (!target) return;
                const parentMenu = target.closest("details.google-actions-menu");
                if (parentMenu && !parentMenu.open) parentMenu.open = true;
                target.scrollIntoView({ behavior: "smooth", block: "center" });
                const originalOutline = target.style.outline;
                target.style.outline = "2px solid #25D366";
                target.style.outlineOffset = "2px";
                setTimeout(() => { target.style.outline = originalOutline; }, 1800);
              });
            }
          }

          return wrap;
        }

        function applyWhatsappTestButtonGating(items) {
          const priorItems = (items || []).filter((i) => i.key !== "live_send_confirmed");
          const ready = priorItems.length > 0 && priorItems.every((i) => i.done === true);
          const blocked = !ready;

          window.whatsappChecklistBlockingReason = blocked
            ? "Locked until the checklist steps above are approved."
            : null;

          if (whatsappTestMessageCard) {
            whatsappTestMessageCard.style.display = ready ? "" : "none";
          }

          if (whatsappDefaultTestButton) {
            whatsappDefaultTestButton.style.opacity = blocked ? "0.6" : "";
            whatsappDefaultTestButton.style.pointerEvents = blocked ? "none" : "";
            whatsappDefaultTestButton.style.cursor = blocked ? "not-allowed" : "";
          }

          if (whatsappTestMessageStatus && blocked) {
            whatsappTestMessageStatus.textContent = "Locked until the checklist steps above are approved.";
            whatsappTestMessageStatus.style.color = "#b45309";
          }
        }

        async function loadWhatsappChecklist() {
          if (!whatsappChecklistItems) return;
          whatsappChecklistItems.innerHTML = '<small style="color:#64748b;">Checking with Meta...</small>';
          if (whatsappChecklistMetaError) whatsappChecklistMetaError.style.display = "none";

          try {
            const response = await fetch("/account/whatsapp/setup-status", {
              method: "GET",
              headers: { "Accept": "application/json" },
            });
            const result = await response.json().catch(() => ({}));
            if (!response.ok || !result.success) {
              throw new Error(result.message || "Unable to check WhatsApp setup status.");
            }

            whatsappChecklistItems.innerHTML = "";
            const checklistItemList = result.items || [];
            checklistItemList.forEach((item, index) => {
              whatsappChecklistItems.appendChild(renderWhatsappChecklistItem(item, index === checklistItemList.length - 1));
            });
            applyWhatsappTestButtonGating(checklistItemList);

            if (!result.metaReachable && result.items && result.items.length > 2) {
              if (whatsappChecklistMetaError) {
                whatsappChecklistMetaError.textContent = "Could not reach Meta to verify live status: " + (result.metaError || "Unknown error") + ". Showing what's known locally.";
                whatsappChecklistMetaError.style.display = "block";
              }
            }

            if (whatsappChecklistUpdated) {
              const when = result.checkedAt ? new Date(result.checkedAt).toLocaleString() : "";
              whatsappChecklistUpdated.textContent = when ? ("Last checked: " + when) : "";
            }
          } catch (error) {
            whatsappChecklistItems.innerHTML = "";
            if (whatsappChecklistMetaError) {
              whatsappChecklistMetaError.textContent = error?.message || "Unable to check WhatsApp setup status.";
              whatsappChecklistMetaError.style.display = "block";
            }
          }
        }

        if (whatsappChecklistItems) {
          loadWhatsappChecklist();
        }

        if (whatsappDefaultTestButton) {
          whatsappDefaultTestButton.addEventListener("click", async () => {
            const isActivated = Boolean(whatsappStatusPill && whatsappStatusPill.dataset.activated === "1");
            const isConnected = Boolean(whatsappStatusPill && whatsappStatusPill.dataset.connected === "1");

            if (!isActivated) {
              setWhatsappTestMessageStatus("Activate WhatsApp first, then click Test Message again.", "error");
              return;
            }

            if (!isConnected) {
              setWhatsappTestMessageStatus("Connect WhatsApp once before sending this test message.", "error");
              return;
            }

            if (window.whatsappChecklistBlockingReason) {
              setWhatsappTestMessageStatus(window.whatsappChecklistBlockingReason, "error");
              return;
            }

            const recipient = String(whatsappTestRecipientInput?.value || whatsappServerTestConfig.defaultRecipient || "")
              .replace(/\D+/g, "")
              .trim();
            const textMessage = String(whatsappTestMessageInput?.value || "").trim();

            if (!recipient) {
              setWhatsappTestMessageStatus("Enter a recipient number in international format digits only.", "error");
              if (whatsappTestRecipientInput) whatsappTestRecipientInput.focus();
              return;
            }

            if (!textMessage) {
              setWhatsappTestMessageStatus("Enter a test message before sending.", "error");
              if (whatsappTestMessageInput) whatsappTestMessageInput.focus();
              return;
            }

            setWhatsappTestMessageStatus("Sending test WhatsApp message...", "info");
            whatsappDefaultTestButton.disabled = true;
            const previousLabel = whatsappDefaultTestButton.textContent;
            whatsappDefaultTestButton.textContent = "Sending...";

            try {
              const response = await fetch("/account/whatsapp/test-message", {
                method: "POST",
                headers: {
                  "Content-Type": "application/json",
                  "Accept": "application/json",
                  "X-Requested-With": "XMLHttpRequest",
                },
                body: JSON.stringify({
                  recipient,
                  textMessage,
                }),
              });

              const result = await response.json().catch(() => ({}));
              if (!response.ok || !result.success) {
                throw new Error(result.message || "Unable to send the WhatsApp test message.");
              }

              const messageId = String(result.messageId || "").trim();
              setWhatsappTestMessageStatus(
                messageId
                  ? `Sent successfully (message ID: ${messageId}).`
                  : "Sent successfully.",
                "success"
              );
            } catch (error) {
              setWhatsappTestMessageStatus(error?.message || "Unable to send the WhatsApp test message.", "error");
            } finally {
              whatsappDefaultTestButton.disabled = false;
              whatsappDefaultTestButton.textContent = previousLabel || "Send Test Message";
            }
          });
        }

