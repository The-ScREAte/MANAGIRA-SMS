<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="noindex" />
  <title><%= title %></title>
  <link rel="icon" href="/favicon.ico" />
  <style>
    * { box-sizing: border-box; }
    body { min-height: 100vh; min-height: 100dvh; margin: 0; display: flex; align-items: center; justify-content: center; padding: 16px; background: #f5f7fa; color: #0f172a; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif; }
    main { width: 100%; max-width: 400px; padding: 28px 24px; border: 1px solid #dfe4ea; border-radius: 16px; background: #fff; text-align: center; }
    h1 { margin: 0 0 6px; font-size: 20px; font-weight: 700; }
    p { margin: 0 0 18px; color: #64748b; font-size: 14px; line-height: 1.45; }
    button { display: block; width: 100%; height: 46px; border: 0; border-radius: 10px; background: #01535b; color: #fff; font-size: 15px; font-weight: 600; cursor: pointer; }
    a { display: block; margin-top: 16px; color: #01535b; font-size: 14px; font-weight: 600; text-decoration: none; }
  </style>
</head>
<body>
  <main>
    <h1>Sign in to <%= schoolName %></h1>
    <p>Continue only if you meant to sign in to this school.</p>
    <form method="post" action="<%= action %>">
      <% if (next) { %><input type="hidden" name="next" value="<%= next %>" /><% } %>
      <button type="submit">Continue</button>
    </form>
    <a href="/account/login">Not this school</a>
  </main>
<%- include('../partials/authLoader', { loaderText: "Taking you to your school's sign-in" }) %>
</body>
</html>
