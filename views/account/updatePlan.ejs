<%- include('../partials/flash') %>

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Update Subscription Plan</title>
    <style>
      :root {
        --font-family: "<%= (session && session.fontStyle ? String(session.fontStyle).trim() : 'Inter') %>", sans-serif;
      }

      body {
        font-family: var(--font-family);
      }
    </style>
    <style>
      body {
        margin: 0;
        background-color: #f5f5f5;
      }

      form {
        max-width: 900px;
        margin: 50px auto;
        background-color: #fff;
        border-radius: 8px;
        border: 1px solid #ddd;
        padding-bottom: 20px;
      }

      h1 {
        text-align: center;
        margin: 20px 0;
        color: #333;
      }

      .plan-table {
        display: flex;
        border-top: 1px solid #ddd;
      }

      .plan {
        flex: 1;
        cursor: pointer;
        text-align: center;
        transition: background-color 0.3s ease, border 0.3s ease,
          font-weight 0.3s ease;
        border-right: 1px solid #ddd;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        padding: 15px;
      }

      .plan:last-child {
        border-right: none;
      }

      .plan-header {
        background-color: #01535b;
        color: white;
        padding: 15px;
        font-size: 16px;
        font-weight: bold;
      }

      .plan-body {
        padding: 20px;
        background-color: #fff;
        border-bottom: 1px solid #ddd;
        flex-grow: 1;
      }

      .plan-body p {
        margin: 0 0 15px 0;
        font-size: 14px;
        color: #333;
      }

      .plan-body ul {
        list-style: none;
        padding: 0;
        margin: 0;
        text-align: left;
        border-top: 1px solid #ddd;
        padding-top: 15px;
      }

      .plan-body ul li {
        margin-bottom: 8px;
        font-size: 14px;
        color: #333;
      }

      .plan-price {
        padding: 15px 20px;
        font-size: 14px;
        color: #333;
        border-top: 1px solid #ddd;
        background-color: #f9f9f9;
      }

      .plan-price strong {
        display: block;
        margin: 5px 0;
      }

      /* Selected plan styling */
      .plan.selected {
        border: 3px solid #01535b !important;
        background-color: #eaf4ff;
        font-weight: bold;
      }

      .btn {
        display: block;
        width: 100%;
        padding: 15px;
        background-color: #01535b;
        color: white;
        border: none;
        font-size: 16px;
        cursor: pointer;
        text-align: center;
      }

      .btn:hover {
        background-color: #01535b;
      }

      .plan.disabled {
        opacity: 0.5;
        cursor: not-allowed;
        border: 2px solid #ccc;
        background-color: #f8f8f8;
      }

      .current-plan-label {
        color: red;
        font-weight: bold;
        text-align: center;
        margin-top: 10px;
      }
      /* Small Screen Styles */
      @media (max-width: 768px) {
        body {
          margin: 0;
        }

        /* Ensure form is centered and fits small screens */
        form {
          max-width: 90%;
          margin: 30px auto;
          padding: 15px;
          border-radius: 6px;
        }

        h1 {
          font-size: 1.8rem;
          text-align: center;
          margin: 15px 0;
        }

        p {
          font-size: 1rem;
          text-align: center;
        }

        /* Stack plans vertically for better mobile experience */
        .plan-table {
          flex-direction: column;
          border: none;
          gap: 15px;
        }

        .plan {
          border-right: none;
          border: 1px solid #ddd;
          padding: 10px;
          font-size: 14px;
        }

        .plan-header {
          font-size: 1.2rem;
          padding: 12px;
        }

        .plan-body {
          padding: 10px;
        }

        .plan-body p {
          font-size: 1rem;
        }

        .plan-body ul {
          padding: 10px;
          font-size: 1rem;
        }

        .plan-price {
          font-size: 1rem;
          padding: 10px;
        }

        .current-plan-label {
          font-size: 0.95rem;
          padding: 8px;
        }

        /* Make button more touch-friendly */
        .btn {
          width: 100%;
          padding: 12px;
          font-size: 1rem;
          border-radius: 5px;
        }

        .btn:hover {
          background-color: #01535b;
        }
      }
    </style>
  </head>

  <body>
    <form action="/account/update-plan" method="POST" id="updatePlanForm">
      <h1>Update Your Subscription Plan</h1>


      <p style="text-align: center; font-size: 16px">
        <strong>Current Plan:</strong> <%= currentPlan.plan_name %>
      </p>

      <% if (pendingPlan) { %>
        <div style="text-align: center; margin-bottom: 20px; color: #01535b; font-size: 15px;">
          <strong>Upcoming Plan Change:</strong><br>
          Your plan will change to <b><%= pendingPlan.plan_name %></b> on <b><%= new Date(pendingPlan.effective_date).toLocaleDateString() %></b>.
        </div>
      <% } %>

      <div class="plan-table">
        <% plans.forEach(plan => { %>
        <div
          class="plan <%= plan.plan_id === currentPlan.plan_id ? 'disabled' : '' %>"
          data-plan-id="<%= plan.plan_id %>"
        >
          <div class="plan-header"><%= plan.plan_name %></div>
          <div class="plan-body">
            <p><%= plan.description %></p>
            <ul>
              <% if (Array.isArray(plan.features)) { %> <%
              plan.features.forEach(feature => { %>
              <li>- <%= feature.feature_name %></li>
              <% }) %> <% } else { %>
              <li>No features available</li>
              <% } %>
            </ul>
          </div>
          <div class="plan-price">
            <strong><%= plan.priceUsdDisplay || ('$' + plan.total_price) %></strong>
            <% if (currencyProfile && currencyProfile.userCurrency && currencyProfile.userCurrency !== 'USD') { %>
              <div style="margin-top: 6px; font-size: 12px; color: #666; font-weight: 500;">
                ≈ <%= plan.localizedPriceDisplay %>
              </div>
            <% } %>
          </div>
          <% if (plan.plan_id === currentPlan.plan_id) { %>
          <div class="current-plan-label">✔️ This is your current plan</div>
          <% } %>
        </div>
        <% }); %>
      </div>

      <p style="text-align:center;font-size:12px;color:#666;margin:10px 0 8px 0;">
        Plan prices are based in USD and local estimates are shown with live exchange rates.
      </p>

      <!-- Hidden input to store selected plan -->
      <input
        type="hidden"
        name="newPlanId"
        id="selectedPlanId"
        value="<%= currentPlan.plan_id %>"
      />

      <button type="submit" class="btn">Upgrade Plan</button>
    </form>

    <script>
      document.addEventListener("DOMContentLoaded", function () {
        const plans = document.querySelectorAll(".plan");
        const selectedPlanInput = document.getElementById("selectedPlanId");
        const form = document.getElementById("updatePlanForm");
        const currentPlanId = "<%= currentPlan.plan_id %>";
        let selectedPlanName = "";

        plans.forEach((plan) => {
          plan.addEventListener("click", function () {
            const selectedPlanId = this.getAttribute("data-plan-id");

            if (selectedPlanId === currentPlanId) {
              alert(
                "⚠️ You are already on this plan. Please select a different one to upgrade."
              );
              return;
            }

            // Remove "selected" class from all plans
            plans.forEach((p) => p.classList.remove("selected"));

            // Add "selected" class to clicked plan
            this.classList.add("selected");

            // Store selected plan ID and Name
            selectedPlanInput.value = selectedPlanId;
            selectedPlanName = this.querySelector(".plan-header").innerText;
          });
        });

        form.addEventListener("submit", function (event) {
          event.preventDefault(); // Prevent form submission

          const newPlanId = selectedPlanInput.value;

          if (!newPlanId || newPlanId === currentPlanId) {
            alert(
              "⚠️ Please select a different subscription plan before proceeding."
            );
            return;
          }

          // Show confirmation alert
          if (
            confirm(
              `🔔 You are about to change your plan to "${selectedPlanName}".\n\nThis will update your subscription, and you will start paying the new plan's amount.\n\nDo you want to continue?`
            )
          ) {
            form.submit(); // Proceed with form submission
          }
        });
      });
    </script>
  </body>
</html>
