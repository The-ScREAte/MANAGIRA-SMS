<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="noindex" />
  <title><%= title %></title>
  <style>
    :root { color-scheme: light dark; --bg: #f5f7fa; --card: #fff; --text: #0f172a; --muted: #64748b; --line: #e5e9ef; --ok: #12883f; --no: #b42318; }
    @media (prefers-color-scheme: dark) { :root { --bg: #0f172a; --card: #1e293b; --text: #f1f5f9; --muted: #94a3b8; --line: #334155; } }
    * { box-sizing: border-box; }
    body { min-height: 100vh; margin: 0; display: flex; align-items: center; justify-content: center; padding: 16px; background: var(--bg); color: var(--text); font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif; }
    main { width: 100%; max-width: 420px; padding: 24px; border: 1px solid var(--line); border-radius: 16px; background: var(--card); }
    h1 { margin: 0 0 8px; font-size: 18px; color: <%= ok ? 'var(--ok)' : 'var(--no)' %>; }
    p { margin: 0 0 10px; font-size: 14px; line-height: 1.5; overflow-wrap: anywhere; }
    small { color: var(--muted); font-size: 13px; }
  </style>
</head>
<body>
  <main>
    <% if (ok) { %>
      <h1>The test worked</h1>
      <p>Your provider said this is <strong><%= email %></strong>, and that's an account at your school. Nobody was signed in by this test.</p>
      <small>Close this tab and go back to Settings to turn single sign-on on.</small>
    <% } else if (problem) { %>
      <h1>The test didn't work</h1>
      <p><%= problem %></p>
      <small>Close this tab, fix it in Settings, and test again.</small>
    <% } else if (hasEmail) { %>
      <h1>Almost: no account for that email</h1>
      <p>Your provider said this is <strong><%= email %></strong>, but nobody at your school has that email. Test with an account that's already in Managira.</p>
      <small>Close this tab and test again.</small>
    <% } else { %>
      <h1>No email address was sent</h1>
      <p>Your provider signed in, but didn't send an email address. Have it send the email address, or name the attribute it uses in Settings under Advanced.</p>
      <small>Close this tab and test again.</small>
    <% } %>
  </main>
  <script>try { if (window.opener) window.opener.postMessage({ ssoTest: true }, window.location.origin); } catch (_) {}</script>
</body>
</html>
