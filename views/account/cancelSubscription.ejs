<!DOCTYPE html>
<html lang="en">
  <head>
    <link rel="stylesheet" href="/css/globalScale.css">
    <meta charset="UTF-8" />
    <meta name="viewport" content="<%= locals.viewportContent || 'width=device-width, initial-scale=1.0, maximum-scale=1.0' %>" />
    <title>Cancel Subscription</title>
    <style>
      :root {
        --font-family: "<%= (session && session.fontStyle ? String(session.fontStyle).trim() : 'Inter') %>", sans-serif;
      }

      body {
        font-family: var(--font-family);
      }

      body {
        background-color: #f4f6f9;
        margin: 0;
      }

      .container {
        max-width: 600px;
        margin: 50px auto;
        padding: 20px;
        background-color: #ffffff;
        border-radius: 8px;
        box-shadow: 0px 4px 8px rgba(0, 0, 0, 0.1);
      }

      h1 {
        text-align: center;
        color: #333;
      }

      p {
        color: #666;
        line-height: 1.6;
      }

      .form-group {
        margin-bottom: 15px;
      }

      .form-group label {
        display: block;
        margin-bottom: 5px;
        font-weight: bold;
        color: #333;
      }

      .form-group input {
        width: 100%;
        padding: 10px;
        border: 1px solid #ccc;
        border-radius: 4px;
        font-size: 16px;
      }

      .btn-primary {
        width: 100%;
        padding: 10px;
        background-color: #d9534f;
        color: #ffffff;
        border: none;
        border-radius: 4px;
        font-size: 18px;
        cursor: pointer;
      }

      .btn-primary:hover {
        background-color: #c9302c;
      }
    </style>
  </head>
  <body>
    <%- include('../partials/flash') %>

    <div class="container">
      <form
        id="cancelForm"
        action="/account/cancel-subscription"
        method="POST"
        onsubmit="return confirmCancellation()"
      >
        <h1>Cancel Your Subscription</h1>

        <p>
          We’re sorry to see you go! Before proceeding, please take a moment to
          carefully read the following information:
        </p>
        <p>
          Once you confirm this cancellation, your organization’s subscription
          will be placed on hold. Your organization’s data will be preserved,
          and you can return at any time by contacting our support team.
          However, starting from the end of your current billing cycle, all
          users associated with your organization will be unable to log in.
        </p>
        <p>
          If you have any questions or if there’s anything we can do to improve
          your experience, please don’t hesitate to
          <a href="mailto:info@managira.com">email us at info@managira.com</a>. We’ll be saddened to see you leave,
          but we want you to know you are always welcome back.
        </p>

        <p><strong>Please confirm the following details to proceed:</strong></p>

        <div class="form-group">
          <label for="orgName">Organization Name:</label>
          <input
            type="text"
            id="orgName"
            name="orgName"
            placeholder="Enter your organization name"
            required
          />
        </div>

        <div class="form-group">
          <label for="password">Password:</label>
          <input
            type="password"
            id="password"
            name="password"
            placeholder="Enter your password"
            required
          />
        </div>

        <p style="color: #d9534f; font-weight: bold">
          By clicking "Confirm Cancellation," you acknowledge that all users in
          your organization will be unable to log in after the end of the
          current billing cycle.
        </p>

        <button type="submit" class="btn-primary">Confirm Cancellation</button>
      </form>
    </div>

    <script>
      function confirmCancellation() {
        return confirm(
          "Are you sure you want to cancel the subscription? This action will prevent all users of this organization from logging in after the current billing period ends."
        );
      }
    </script>
  </body>
</html>
