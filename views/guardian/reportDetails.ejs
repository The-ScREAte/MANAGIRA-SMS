<style>
  .report-details-container { max-width: 800px; margin: 0 auto; padding: 16px; }
  .back-link { display: inline-flex; align-items: center; color: var(--primary, #27ae60); text-decoration: none; margin-bottom: 14px; font-weight: 500; font-size: 0.85rem; }
  .back-link:hover { text-decoration: underline; }

  .report-header { background: #fff; border: 1px solid #e2e8f0; border-radius: 8px; padding: 16px 18px; margin-bottom: 14px; }
  .report-title { font-size: 1.15rem; color: #1e293b; margin: 0 0 10px; }
  .report-meta-row { display: flex; flex-wrap: wrap; gap: 14px; margin-bottom: 10px; font-size: 0.82rem; color: #64748b; }
  .meta-item { display: flex; align-items: center; gap: 4px; }
  .meta-label { font-weight: 600; color: #334155; }
  .status-badge { padding: 3px 10px; border-radius: 12px; font-size: 0.7rem; font-weight: 600; text-transform: uppercase; display: inline-block; }
  .status-open { background: #fef3c7; color: #d97706; }
  .status-in_progress { background: #dbeafe; color: #2563eb; }
  .status-resolved { background: #d1fae5; color: #059669; }
  .status-closed { background: #f3f4f6; color: #6b7280; }
  .priority-badge { padding: 2px 8px; border-radius: 8px; font-size: 0.7rem; font-weight: 600; text-transform: uppercase; }
  .priority-urgent { background: #fadbd8; color: #e74c3c; }
  .priority-high { background: #fef3c7; color: #d97706; }
  .priority-normal { background: #dbeafe; color: #2563eb; }
  .priority-low { background: #f3f4f6; color: #95a5a6; }
  .original-msg-item { margin-bottom: 14px; padding-bottom: 14px; border-bottom: 1px solid #f1f5f9; }
  .original-msg-item .reply-message { font-size: 0.88rem; }

  .staff-notified-list { display: flex; flex-wrap: wrap; gap: 6px; padding-top: 8px; }
  .staff-tag { display: inline-flex; align-items: center; gap: 5px; background: #f1f5f9; color: #334155; padding: 4px 11px; border-radius: 20px; font-size: 0.79rem; font-weight: 500; }
  .staff-tag .staff-role { color: #94a3b8; font-size: 0.74rem; }
  .staff-tag .main-badge { background: #d1fae5; color: #059669; border-radius: 8px; padding: 1px 6px; font-size: 0.68rem; font-weight: 700; margin-left: 2px; }

  .meta-staff-details { }
  .meta-staff-details[open] { flex-basis: 100%; order: 999; }
  .meta-staff-summary { display: flex; align-items: center; gap: 4px; cursor: pointer; list-style: none; font-size: 0.82rem; color: #64748b; padding: 0; }
  .meta-staff-summary::-webkit-details-marker { display: none; }
  .meta-staff-chevron { color: #94a3b8; font-size: 1rem; line-height: 1; transition: transform .18s; }
  .meta-staff-details[open] > .meta-staff-summary > .meta-staff-chevron { transform: rotate(90deg); }

  .conversation-section { background: #fff; border: 1px solid #e2e8f0; border-radius: 8px; padding: 16px 18px; margin-bottom: 14px; }
  .conversation-section h3 { font-size: 0.95rem; color: #1e293b; margin: 0 0 14px; }
  .reply-item { margin-bottom: 14px; padding-bottom: 14px; border-bottom: 1px solid #f1f5f9; }
  .reply-item:last-child { border-bottom: none; margin-bottom: 0; padding-bottom: 0; }
  .reply-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 6px; }
  .reply-sender { font-weight: 600; font-size: 0.85rem; color: #1e293b; }
  .sender-type-guardian { color: #059669; }
  .sender-type-staff { color: #2563eb; }
  .reply-date { font-size: 0.75rem; color: #94a3b8; }
  .reply-message { color: #475569; line-height: 1.6; margin: 0; font-size: 0.85rem; }
  .no-replies { text-align: center; color: #94a3b8; padding: 20px; font-size: 0.85rem; }

  .reply-form { background: #fff; border: 1px solid #e2e8f0; border-radius: 8px; padding: 16px 18px; }
  .reply-form h3 { font-size: 0.95rem; color: #1e293b; margin: 0 0 10px; }
  .reply-form textarea { width: 100%; min-height: 80px; padding: 10px; border: 1px solid #d1d5db; border-radius: 6px; font-size: 0.85rem; font-family: inherit; resize: vertical; box-sizing: border-box; }
  .reply-form textarea:focus { outline: none; border-color: var(--primary, #27ae60); }
  .reply-form button { background: var(--primary, #27ae60); color: #fff; padding: 8px 20px; border: none; border-radius: 6px; font-weight: 600; font-size: 0.85rem; cursor: pointer; margin-top: 10px; }
  .reply-form button:hover { background: var(--primary-hover, #229954); }

  @media (max-width: 640px) {
    .report-details-container { padding: 10px; }
    .report-header { padding: 13px 14px; }
    .report-title { font-size: 1rem; }
    .report-meta-row { flex-direction: column; gap: 6px; font-size: 0.8rem; }
    .meta-item { font-size: 0.8rem; }
    .status-badge, .priority-badge { font-size: 0.68rem; }
    .meta-staff-summary { font-size: 0.8rem; }
    .staff-tag { font-size: 0.76rem; padding: 3px 9px; }
    .conversation-section { padding: 13px 14px; }
    .conversation-section h3 { font-size: 0.88rem; }
    .reply-sender { font-size: 0.82rem; }
    .reply-date { font-size: 0.72rem; }
    .reply-message { font-size: 0.82rem; }
    .reply-header { flex-direction: column; align-items: flex-start; gap: 2px; }
    .reply-form { padding: 13px 14px; }
    .reply-form textarea { font-size: 0.82rem; min-height: 72px; }
    .reply-form button { width: 100%; padding: 10px; font-size: 0.88rem; }
  }
</style>

<div class="report-details-container">
  <a href="/guardian/reports" class="back-link">← Back to Reports</a>

  <%
    var allStaff = [];
    var seenNames = {};
    if (classTeachers && classTeachers.length > 0) {
      classTeachers.forEach(function(t) {
        var key = (t.name || '').toLowerCase().trim();
        if (!seenNames[key]) { seenNames[key] = true; allStaff.push({ name: t.name, role: t.role, main: t.main }); }
      });
    }
    if (recipients && recipients.length > 0) {
      recipients.forEach(function(r) {
        var key = (r.display_name || '').toLowerCase().trim();
        if (!seenNames[key]) { seenNames[key] = true; allStaff.push({ name: r.display_name, role: r.display_role, main: false }); }
      });
    }
  %>

  <div class="report-header">
    <h1 class="report-title"><%= report.subject %></h1>

    <div class="report-meta-row">
      <div class="meta-item">
        <span class="meta-label">Student:</span>
        <span><%= report.student_name %></span>
      </div>
      <div class="meta-item">
        <span class="meta-label">Date:</span>
        <span><%= new Date(report.created_at).toLocaleString() %></span>
      </div>
      <% if (report.filed_by_name) { %>
      <div class="meta-item">
        <span class="meta-label">Filed by:</span>
        <span><%= report.filed_by_name %></span>
      </div>
      <% } %>
      <div class="meta-item">
        <span class="meta-label">Status:</span>
        <span class="status-badge status-<%= report.status %>">
          <%= report.status.replace('_', ' ') %>
        </span>
      </div>
      <div class="meta-item">
        <span class="meta-label">Priority:</span>
        <span class="priority-badge priority-<%= report.priority %>">
          <%= report.priority %>
        </span>
      </div>
      <% if (allStaff.length > 0) { %>
      <details class="meta-staff-details">
        <summary class="meta-staff-summary">
          <span class="meta-label">Staff Notified:</span>
          <span><%= allStaff.length %> <%= allStaff.length === 1 ? 'person' : 'people' %></span>
          <span class="meta-staff-chevron">›</span>
        </summary>
        <div class="staff-notified-list">
          <% allStaff.forEach(function(s) { %>
            <span class="staff-tag">
              <%= s.name %>
              <span class="staff-role"><%= s.role %></span>
              <% if (s.main) { %><span class="main-badge">Main</span><% } %>
            </span>
          <% }); %>
        </div>
      </details>
      <% } %>
    </div>

  </div>

  <div class="conversation-section">
    <h3>Conversation</h3>

    <div class="reply-item original-msg-item">
      <div class="reply-header">
        <span class="reply-sender sender-type-guardian"><%= report.filed_by_name || 'You' %> (You)</span>
        <span class="reply-date"><%= new Date(report.created_at).toLocaleString() %></span>
      </div>
      <p class="reply-message"><%= report.message %></p>
    </div>

    <% if (replies && replies.length > 0) { %>
      <% replies.forEach(reply => { %>
        <div class="reply-item">
          <div class="reply-header">
            <span class="reply-sender sender-type-<%= reply.sender_type %>">
              <%= reply.display_name %>
              <% if (reply.sender_type === 'guardian') { %>(You)<% } %>
            </span>
            <span class="reply-date">
              <%= new Date(reply.created_at).toLocaleString() %>
            </span>
          </div>
          <p class="reply-message"><%= reply.message %></p>
        </div>
      <% }); %>
    <% } %>
  </div>
  
  <form action="/guardian/reports/<%= report.report_id %>/reply" method="POST" class="reply-form">
    <textarea 
      name="message" 
      placeholder="Write your message..."
      required
    ></textarea>
    <button type="submit">Send Reply</button>
  </form>

  <form action="/guardian/reports/<%= report.report_id %>/delete" method="POST" style="margin-top:10px;text-align:right;" onsubmit="return confirm('Delete this report and all its replies? This cannot be undone.')">
    <button type="submit" style="background:none;border:none;color:#94a3b8;font-size:0.8rem;cursor:pointer;padding:4px 0;" onmouseover="this.style.color='#e74c3c'" onmouseout="this.style.color='#94a3b8'">Delete this report</button>
  </form>
</div>
