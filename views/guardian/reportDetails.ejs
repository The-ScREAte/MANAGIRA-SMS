<style>
  .rd-page-shell {
    max-width: 760px;
    margin: 0 auto;
    padding: 14px;
  }

  .rd-back-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--primary, #01535b);
    text-decoration: none;
    margin-bottom: 10px;
    font-weight: 650;
    font-size: 0.82rem;
    border: 1px solid #dbe3ec;
    border-radius: 999px;
    padding: 5px 10px;
    background: #fff;
  }

  .rd-back-link:hover {
    background: #f8fafc;
  }

  .rd-modal-body {
    background: #fff;
    border: 1px solid #e2e8f0;
    border-radius: 14px;
    box-shadow: 0 10px 26px rgba(15, 23, 42, 0.06);
    padding: 14px 14px 16px;
  }

  .rd-title {
    font-size: 1.16rem;
    font-weight: 700;
    color: #0f172a;
    margin: 0 0 8px;
    line-height: 1.26;
    letter-spacing: -0.01em;
  }

  .rd-keyline {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    flex-wrap: wrap;
    margin-bottom: 8px;
  }

  .rd-keyline-student {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.88rem;
    color: #334155;
  }

  .rd-keyline-student .rd-meta-label {
    color: #64748b;
    font-weight: 700;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .rd-keyline-date {
    font-size: 0.74rem;
    color: #94a3b8;
  }

  .rd-meta-inline {
    font-size: 0.84rem;
    color: #64748b;
    display: flex;
    align-items: center;
    gap: 6px;
    flex-wrap: wrap;
    margin-bottom: 8px;
  }

  .rd-cc-hover {
    position: relative;
    display: inline-flex;
    align-items: center;
    cursor: default;
  }

  .rd-cc-tooltip {
    position: absolute;
    top: calc(100% + 6px);
    left: 0;
    min-width: 220px;
    max-width: min(320px, 80vw);
    padding: 8px;
    border: 1px solid #dbe3ec;
    border-radius: 10px;
    background: #fff;
    box-shadow: 0 10px 24px rgba(15, 23, 42, 0.12);
    display: none;
    z-index: 20;
  }

  .rd-cc-hover:hover .rd-cc-tooltip,
  .rd-cc-hover:focus-within .rd-cc-tooltip {
    display: block;
  }

  .rd-cc-tooltip-title {
    font-size: 0.72rem;
    color: #64748b;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    margin-bottom: 6px;
    font-weight: 700;
  }

  .rd-cc-tooltip-list {
    display: grid;
    gap: 6px;
  }

  .rd-cc-tooltip-item {
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    color: #334155;
    padding: 6px 8px;
    border-radius: 9px;
    font-size: 0.79rem;
  }

  .rd-cc-tooltip-item .role {
    color: #64748b;
  }

  .rd-cc-tooltip-state {
    font-size: 0.8rem;
    color: #64748b;
  }

  .rd-meta-sep {
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: #cbd5e1;
  }

  .rd-badge-row {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 8px;
    flex-wrap: wrap;
  }

  .rd-badge {
    display: inline-block;
    padding: 4px 10px;
    border-radius: 999px;
    font-size: 0.69rem;
    font-weight: 700;
    text-transform: capitalize;
    letter-spacing: 0.07em;
  }

  .rd-priority-urgent { background: #fef2f2; color: #dc2626; }
  .rd-priority-high { background: #fff7ed; color: #c2410c; }
  .rd-priority-normal { background: #eff6ff; color: #2563eb; }
  .rd-priority-low { background: #f9fafb; color: #6b7280; }


  .rd-section {
    margin-bottom: 10px;
  }

  .rd-section-title {
    font-size: 0.76rem;
    font-weight: 700;
    color: #64748b;
    margin: 0 0 8px;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .rd-section-title::after {
    content: '';
    flex: 1;
    height: 1px;
    background: #e2e8f0;
  }

  .rd-recipients {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 6px;
  }

  .rd-tag {
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    color: #334155;
    padding: 6px 8px;
    border-radius: 9px;
    font-size: 0.79rem;
    font-weight: 500;
  }

  .rd-thread-scroll {
    max-height: 56vh;
    overflow-y: auto;
    overflow-x: visible;
    position: relative;
    padding-right: 2px;
  }

  .rd-thread-scroll.rd-severity-urgent .rd-reply {
    background: #fef2f2;
    border-color: #fecaca;
  }

  .rd-thread-scroll.rd-severity-high .rd-reply {
    background: #fff7ed;
    border-color: #fed7aa;
  }

  .rd-thread-scroll.rd-severity-medium .rd-reply,
  .rd-thread-scroll.rd-severity-normal .rd-reply {
    background: #eff6ff;
    border-color: #bfdbfe;
  }

  .rd-thread-scroll.rd-severity-low .rd-reply {
    background: #f8fafc;
    border-color: #e2e8f0;
  }

  .rd-reply {
    padding: 10px 44px 10px 11px;
    border-radius: 9px;
    margin-bottom: 8px;
    border: 1px solid #edf2f7;
    border-left: 3px solid #cbd5e1;
    background: #fcfdff;
    position: relative;
    max-width: 88%;
  }

  .rd-reply.is-mine {
    margin-left: auto;
  }

  .rd-reply.is-theirs {
    margin-right: auto;
  }

  .rd-reply:last-child { margin-bottom: 0; }

  .rd-reply.is-guardian { border-left-color: #86efac; }
  .rd-reply.is-staff { border-left-color: #93c5fd; }

  .rd-reply-header {
    display: flex;
    align-items: center;
    margin-bottom: 4px;
  }

  .rd-reply-sender {
    font-weight: 600;
    font-size: 13px;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: #1e293b;
  }

  .rd-reply-sender .sender-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    flex-shrink: 0;
  }

  .rd-reply-sender .sender-dot.guardian { background: #10b981; }
  .rd-reply-sender .sender-dot.staff { background: #3b82f6; }

  .rd-reply-sender .sender-label {
    font-size: 11px;
    font-weight: 500;
    color: #64748b;
  }

  .rd-reply-date {
    display: block;
    font-size: 11px;
    color: #94a3b8;
    white-space: nowrap;
    margin-top: 6px;
    text-align: left;
  }

  .rd-reply-msg {
    font-size: 13px;
    color: #475569;
    line-height: 1.6;
    margin: 0;
    white-space: pre-wrap;
    word-wrap: break-word;
  }

  .rd-msg-menu-wrap {
    position: absolute;
    top: 10px;
    right: 10px;
    z-index: 70;
  }

  .rd-msg-menu-btn {
    border: 1px solid #e2e8f0;
    background: #fff;
    color: #64748b;
    width: 24px;
    height: 24px;
    border-radius: 8px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    font-size: 0.95rem;
    line-height: 1;
  }

  .rd-msg-menu-btn:hover {
    color: #1f2937;
    background: #f8fafc;
  }

  .rd-msg-menu-dropdown {
    display: none;
    position: absolute;
    top: 28px;
    right: 0;
    min-width: 130px;
    background: #fff;
    border: 1px solid #e2e8f0;
    border-radius: 10px;
    overflow: visible;
    box-shadow: 0 10px 28px rgba(15, 23, 42, 0.14);
    padding: 8px 10px;
    z-index: 80;
  }

  .rd-msg-menu-wrap.open .rd-msg-menu-dropdown {
    display: block;
  }

  .rd-msg-menu-text {
    color: #dc2626;
    font-size: 0.8rem;
    font-weight: 600;
    cursor: pointer;
    text-decoration: none;
  }

  .rd-msg-menu-text:hover {
    text-decoration: underline;
  }

  .rd-reply-form {
    margin-top: 10px;
    padding-top: 10px;
    border-top: 1px solid #e2e8f0;
  }

  .rd-reply-form label {
    display: block;
    font-size: 13px;
    font-weight: 600;
    color: #111827;
    margin-bottom: 6px;
  }

  .rd-reply-form textarea {
    width: 100%;
    min-height: 42px;
    max-height: 220px;
    padding: 10px 12px;
    border: 1px solid #d1d5db;
    border-radius: 999px;
    font-size: 16px;
    font-family: inherit;
    resize: none;
    overflow: hidden;
    line-height: 1.35;
    box-sizing: border-box;
    transition: border-color 0.15s, box-shadow 0.15s;
    color: #111827;
    margin: 0;
  }

  .rd-reply-form textarea:focus {
    outline: none;
    border-color: var(--primary, #01535b);
    box-shadow: 0 0 0 3px rgba(1, 83, 91, 0.1);
  }

  .rd-reply-form .rd-form-actions {
    display: flex;
    align-items: center;
    justify-content: flex-start;
    margin-top: 8px;
  }

  .rd-reply-composer {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .rd-reply-composer textarea {
    flex: 1;
  }

  .rd-reply-send-btn {
    background: var(--primary, #01535b);
    color: #fff;
    width: 42px;
    height: 42px;
    min-width: 42px;
    padding: 0;
    border: 0;
    border-radius: 999px;
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;
    transition: background 0.15s, transform 0.1s;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin: 0;
  }

  .rd-reply-send-btn svg {
    width: 16px;
    height: 16px;
    transform: translateX(1px);
  }

  .rd-reply-send-btn:hover {
    background: var(--primary-hover-fill, var(--primary-hover));
    transform: translateY(-1px);
  }

  .rd-reply-send-btn:active { transform: translateY(0); }

  .rd-reply-send-btn:disabled {
    opacity: 0.5;
    cursor: not-allowed;
    transform: none;
  }

  @media (max-width: 640px) {
    .rd-page-shell { padding: 10px; }
    .rd-modal-body { padding: 16px; }
    .rd-recipients { grid-template-columns: 1fr; }
    .rd-thread-scroll { max-height: none; }
    .rd-keyline { align-items: flex-start; }
    .rd-keyline-date { width: 100%; }
    .rd-meta-inline { align-items: flex-start; gap: 4px; }
    .rd-meta-sep { display: none; }
    .rd-reply-header { flex-direction: column; align-items: flex-start; gap: 2px; }
    .rd-reply-form .rd-form-actions { justify-content: flex-start; }
  }
</style>

<%
  var prCls = 'rd-priority-' + (report.priority || 'normal');
  var threadCount = 1 + ((replies && replies.length) ? replies.length : 0);
  var priorityKey = String(report.priority || 'normal').toLowerCase();
  if (priorityKey === 'meduim') priorityKey = 'medium';
  if (priorityKey === 'normal') priorityKey = 'medium';
  var threadSeverityCls = 'rd-severity-' + priorityKey;
%>

<div class="rd-page-shell">
  <a href="/guardian/reports" class="rd-back-link">← Back to Reports</a>

  <div class="rd-modal-body">
    <h2 class="rd-title"><%= report.subject %></h2>

    <div class="rd-keyline">
      <div class="rd-keyline-student">
        <span class="rd-meta-label">Student</span>
        <strong><%= report.student_name %></strong>
      </div>
      <div class="rd-keyline-date"><%= new Date(report.created_at).toLocaleDateString() %></div>
    </div>

    <div class="rd-meta-inline">
      <span>Parent: <%= report.filed_by_name || 'You' %></span>
      <span class="rd-meta-sep"></span>
      <span class="rd-cc-hover" tabindex="0" onmouseenter="loadGuardianCcHover()" onfocus="loadGuardianCcHover()">CC: <%= Number(report.cc_count || 0) %> staff
        <span class="rd-cc-tooltip"><span class="rd-cc-tooltip-title">CC Staff</span><span class="rd-cc-tooltip-list" id="rdCcTooltipList"><span class="rd-cc-tooltip-state">Hover to load...</span></span></span>
      </span>
    </div>

    <div class="rd-badge-row">
      <span class="rd-badge <%= prCls %>"><%= report.priority || 'normal' %></span>
    </div>

    <div class="rd-section">
      <div class="rd-section-title">Conversation (<%= threadCount %>)</div>
      <div class="rd-thread-scroll <%= threadSeverityCls %>" id="rdThreadList">
        <div class="rd-reply is-guardian is-mine">
          <div class="rd-msg-menu-wrap" id="msgMenu-report-root">
            <button type="button" class="rd-msg-menu-btn" onclick="toggleMsgMenu('report-root')" aria-label="Message actions">⋯</button>
            <div class="rd-msg-menu-dropdown">
              <form id="deleteReportForm" action="/guardian/reports/<%= report.report_id %>/delete" method="POST" onsubmit="return confirm('Delete this report and all its replies? This cannot be undone.')">
                <a href="#" class="rd-msg-menu-text" onclick="return submitInlineForm('deleteReportForm')">Delete report</a>
              </form>
            </div>
          </div>
          <div class="rd-reply-header">
            <span class="rd-reply-sender">
              <span class="sender-dot guardian"></span>
              <span class="sender-name"><%= report.filed_by_name || 'You' %></span>
              <span class="sender-label">Parent</span>
            </span>
          </div>
          <p class="rd-reply-msg"><%= report.message %></p>
          <span class="rd-reply-date"><%= new Date(report.created_at).toLocaleString('en-US', {month:'short',day:'numeric',hour:'numeric',minute:'2-digit'}) %></span>
        </div>

        <% if (replies && replies.length > 0) { %>
          <% replies.forEach(function(reply) { %>
            <% var isGuardian = reply.sender_type === 'guardian'; %>
            <div class="rd-reply <%= isGuardian ? 'is-guardian is-mine' : 'is-staff is-theirs' %>">
              <% if (isGuardian) { %>
                <div class="rd-msg-menu-wrap" id="msgMenu-<%= reply.reply_id %>">
                  <button type="button" class="rd-msg-menu-btn" onclick="toggleMsgMenu('<%= reply.reply_id %>')" aria-label="Message actions">⋯</button>
                  <div class="rd-msg-menu-dropdown">
                    <form id="deleteReplyForm-<%= reply.reply_id %>" action="/guardian/reports/<%= report.report_id %>/replies/<%= reply.reply_id %>/delete" method="POST" onsubmit="return confirm('Delete this message?')">
                      <a href="#" class="rd-msg-menu-text" onclick="return submitInlineForm('deleteReplyForm-<%= reply.reply_id %>')">Delete message</a>
                    </form>
                  </div>
                </div>
              <% } %>

              <div class="rd-reply-header">
                <span class="rd-reply-sender">
                  <span class="sender-dot <%= isGuardian ? 'guardian' : 'staff' %>"></span>
                  <span class="sender-name"><%= reply.display_name %></span>
                  <span class="sender-label"><%= isGuardian ? 'Parent' : 'Staff' %></span>
                </span>
              </div>
              <p class="rd-reply-msg"><%= reply.message %></p>
              <span class="rd-reply-date"><%= new Date(reply.created_at).toLocaleString('en-US', {month:'short',day:'numeric',hour:'numeric',minute:'2-digit'}) %></span>
            </div>
          <% }); %>
        <% } %>
      </div>
    </div>

    <form action="/guardian/reports/<%= report.report_id %>/reply" method="POST" class="rd-reply-form" id="rdReplyForm">
      <div class="rd-reply-composer">
        <textarea id="staffReplyMsg" name="message" rows="1" placeholder="Type a message..." oninput="autoResizeStaffReplyInput(this)" onkeydown="handleStaffReplyKeydown(event, <%= report.report_id %>)" style="height: 42px;" required></textarea>
        <button id="staffReplyBtn" type="button" class="rd-reply-send-btn" onclick="submitStaffReply(<%= report.report_id %>)" aria-label="Send reply" title="Send">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 2L11 13"></path><path d="M22 2L15 22L11 13L2 9L22 2Z"></path></svg>
        </button>
      </div>
    </form>
  </div>
</div>

<script>
  (function () {
    var ccState = {
      loaded: false,
      loading: false,
    };

    function escHtml(value) {
      var div = document.createElement('div');
      div.textContent = value == null ? '' : String(value);
      return div.innerHTML;
    }

    function renderGuardianCcTooltipState(text) {
      var list = document.getElementById('rdCcTooltipList');
      if (!list) return;
      list.innerHTML = '<div class="rd-cc-tooltip-state">' + escHtml(text) + '</div>';
    }

    function renderGuardianCcTooltip(recipients) {
      var list = document.getElementById('rdCcTooltipList');
      if (!list) return;
      if (!recipients.length) {
        renderGuardianCcTooltipState('No staff were CC\'d on this report.');
        return;
      }
      var html = '';
      recipients.forEach(function (item) {
        html += '<div class="rd-cc-tooltip-item">'
          + escHtml(item.display_name || 'Staff')
          + ' <span class="role">· ' + escHtml(item.display_role || 'Staff') + '</span>'
          + '</div>';
      });
      list.innerHTML = html;
    }

    window.loadGuardianCcHover = function () {
      if (ccState.loaded || ccState.loading) return;
      ccState.loading = true;
      renderGuardianCcTooltipState('Loading staff...');

      fetch('/guardian/reports/<%= report.report_id %>/cc')
        .then(function (r) { return r.json(); })
        .then(function (d) {
          if (!d.success) {
            renderGuardianCcTooltipState('Unable to load CC staff.');
            return;
          }

          var recipients = Array.isArray(d.recipients) ? d.recipients : [];
          renderGuardianCcTooltip(recipients);
          ccState.loaded = true;
        })
        .catch(function () {
          renderGuardianCcTooltipState('Unable to load CC staff.');
        })
        .finally(function () {
          ccState.loading = false;
        });
    };

    window.toggleMsgMenu = function (id) {
      var wrap = document.getElementById('msgMenu-' + id);
      if (!wrap) return;
      var isOpen = wrap.classList.contains('open');
      document.querySelectorAll('.rd-msg-menu-wrap.open').forEach(function (el) { el.classList.remove('open'); });
      if (!isOpen) wrap.classList.add('open');
    };

    window.submitInlineForm = function (formId) {
      var form = document.getElementById(formId);
      if (!form) return false;
      if (typeof form.requestSubmit === 'function') {
        form.requestSubmit();
      } else {
        form.submit();
      }
      return false;
    };

    var onDocClick = function (e) {
      if (!e.target.closest('.rd-msg-menu-wrap')) {
        document.querySelectorAll('.rd-msg-menu-wrap.open').forEach(function (el) { el.classList.remove('open'); });
      }
    };

    document.addEventListener('click', onDocClick);

    var replyForm = document.getElementById('rdReplyForm');
    var replyMsg = document.getElementById('staffReplyMsg') || document.getElementById('guardianReplyMsg');
    var replySubmitBtn = document.getElementById('staffReplyBtn') || document.getElementById('rdReplySubmitBtn');
    var threadList = document.getElementById('rdThreadList');

    function autoGrowReplyInput(textarea) {
      var input = textarea || replyMsg;
      if (!input) return;
      input.style.height = 'auto';
      var nextHeight = Math.min(input.scrollHeight, 220);
      input.style.height = nextHeight + 'px';
    }

    window.autoResizeStaffReplyInput = function (textarea) {
      autoGrowReplyInput(textarea);
    };

    window.submitStaffReply = function (_reportId) {
      if (!replyForm) return;
      if (typeof replyForm.requestSubmit === 'function') replyForm.requestSubmit();
      else replyForm.submit();
    };

    window.handleStaffReplyKeydown = function (event, reportId) {
      if (!event) return;
      if (event.key === 'Enter' && !event.shiftKey) {
        event.preventDefault();
        window.submitStaffReply(reportId);
      }
    };

    function onReplyMsgInput() {
      autoGrowReplyInput(replyMsg);
    }

    function formatLocalReplyTime(value) {
      var date = value ? new Date(value) : new Date();
      return date.toLocaleString('en-US', {
        month: 'short',
        day: 'numeric',
        hour: 'numeric',
        minute: '2-digit'
      });
    }

    function appendGuardianReply(reply) {
      if (!threadList || !reply) return;
      var wrapper = document.createElement('div');
      wrapper.className = 'rd-reply is-guardian is-mine';
      wrapper.innerHTML = ''
        + '<div class="rd-reply-header">'
        +   '<span class="rd-reply-sender">'
        +     '<span class="sender-dot guardian"></span>'
        +     '<span class="sender-name"></span>'
        +     '<span class="sender-label">Parent</span>'
        +   '</span>'
        + '</div>'
        + '<p class="rd-reply-msg"></p>'
        + '<span class="rd-reply-date"></span>';

      var senderNode = wrapper.querySelector('.sender-name');
      var msgNode = wrapper.querySelector('.rd-reply-msg');
      var dateNode = wrapper.querySelector('.rd-reply-date');

      senderNode.textContent = reply.sender_name || 'You';
      msgNode.textContent = reply.message || '';
      dateNode.textContent = reply.created_at_display || formatLocalReplyTime(reply.created_at);

      threadList.appendChild(wrapper);
      threadList.scrollTop = threadList.scrollHeight;
    }

    async function submitReplyAsync(e) {
      e.preventDefault();
      if (!replyForm || !replyMsg || !replySubmitBtn) return;

      var trimmed = (replyMsg.value || '').trim();
      if (!trimmed) {
        replyMsg.focus();
        return;
      }

      replySubmitBtn.disabled = true;

      try {
        var response = await fetch(replyForm.action, {
          method: 'POST',
          credentials: 'same-origin',
          headers: {
            'Content-Type': 'application/x-www-form-urlencoded; charset=UTF-8',
            'Accept': 'application/json'
          },
          body: new URLSearchParams({ message: trimmed }).toString()
        });

        var payload = await response.json().catch(function () { return {}; });
        if (!response.ok || !payload.success) {
          throw new Error(payload.error || 'Failed to send reply');
        }

        appendGuardianReply(payload.reply || { message: trimmed, sender_name: 'You' });
        replyMsg.value = '';
        autoGrowReplyInput(replyMsg);
        replyMsg.focus();
      } catch (_error) {
        alert('Could not send reply. Please try again.');
      } finally {
        replySubmitBtn.disabled = false;
      }
    }

    if (replyMsg) {
      autoGrowReplyInput(replyMsg);
      replyMsg.addEventListener('input', onReplyMsgInput);
    }

    if (replyForm) {
      replyForm.addEventListener('submit', submitReplyAsync);
    }

    if (!Array.isArray(window.__spaCleanup)) {
      window.__spaCleanup = [];
    }
    window.__spaCleanup.push(function () {
      document.removeEventListener('click', onDocClick);
      if (replyMsg) {
        replyMsg.removeEventListener('input', onReplyMsgInput);
      }
      if (replyForm) {
        replyForm.removeEventListener('submit', submitReplyAsync);
      }
    });
  })();
</script>
