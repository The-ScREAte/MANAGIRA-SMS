<%- include('../layout', { body: `
<style>
  .report-details-container {
    max-width: 900px;
    margin: 0 auto;
    padding: 20px;
  }
  
  .back-link {
    display: inline-flex;
    align-items: center;
    color: #27ae60;
    text-decoration: none;
    margin-bottom: 20px;
    font-weight: 500;
  }
  
  .back-link:hover {
    text-decoration: underline;
  }
  
  .report-header {
    background: white;
    border: 1px solid #e0e0e0;
    border-radius: 8px;
    padding: 25px;
    margin-bottom: 20px;
  }
  
  .report-title {
    font-size: 24px;
    color: #2c3e50;
    margin: 0 0 15px 0;
  }
  
  .report-meta-row {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 15px;
    margin-bottom: 15px;
  }
  
  .meta-item {
    display: flex;
    align-items: center;
    font-size: 14px;
    color: #555;
  }
  
  .meta-label {
    font-weight: 600;
    margin-right: 8px;
  }
  
  .status-badge {
    padding: 6px 14px;
    border-radius: 12px;
    font-size: 13px;
    font-weight: 600;
    text-transform: uppercase;
    display: inline-block;
  }
  
  .status-open {
    background: #fef5e7;
    color: #f39c12;
  }
  
  .status-in_progress {
    background: #ebf5fb;
    color: #3498db;
  }
  
  .status-resolved {
    background: #eafaf1;
    color: #27ae60;
  }
  
  .status-closed {
    background: #f4f6f7;
    color: #7f8c8d;
  }
  
  .priority-badge {
    padding: 4px 10px;
    border-radius: 8px;
    font-size: 12px;
    font-weight: 600;
    text-transform: uppercase;
  }
  
  .priority-urgent {
    background: #fadbd8;
    color: #e74c3c;
  }
  
  .priority-high {
    background: #fef5e7;
    color: #f39c12;
  }
  
  .priority-normal {
    background: #ebf5fb;
    color: #3498db;
  }
  
  .priority-low {
    background: #f4f6f7;
    color: #95a5a6;
  }
  
  .original-message {
    background: #f8f9fa;
    padding: 20px;
    border-radius: 6px;
    margin-top: 15px;
  }
  
  .original-message p {
    margin: 0;
    line-height: 1.6;
    color: #2c3e50;
  }
  
  .cc-recipients {
    background: white;
    border: 1px solid #e0e0e0;
    border-radius: 8px;
    padding: 20px;
    margin-bottom: 20px;
  }
  
  .cc-recipients h3 {
    font-size: 16px;
    color: #2c3e50;
    margin: 0 0 15px 0;
  }
  
  .recipient-list {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  
  .recipient-tag {
    background: #ebf5fb;
    color: #3498db;
    padding: 6px 12px;
    border-radius: 16px;
    font-size: 13px;
  }
  
  .conversation-section {
    background: white;
    border: 1px solid #e0e0e0;
    border-radius: 8px;
    padding: 25px;
    margin-bottom: 20px;
  }
  
  .conversation-section h3 {
    font-size: 18px;
    color: #2c3e50;
    margin: 0 0 20px 0;
  }
  
  .reply-item {
    margin-bottom: 20px;
    padding-bottom: 20px;
    border-bottom: 1px solid #f0f0f0;
  }
  
  .reply-item:last-child {
    border-bottom: none;
    margin-bottom: 0;
    padding-bottom: 0;
  }
  
  .reply-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 10px;
  }
  
  .reply-sender {
    font-weight: 600;
    color: #2c3e50;
  }
  
  .sender-type-guardian {
    color: #27ae60;
  }
  
  .sender-type-staff {
    color: #3498db;
  }
  
  .reply-date {
    font-size: 13px;
    color: #7f8c8d;
  }
  
  .reply-message {
    color: #555;
    line-height: 1.6;
    margin: 0;
  }
  
  .no-replies {
    text-align: center;
    color: #7f8c8d;
    padding: 30px;
    font-style: italic;
  }
  
  .reply-form {
    background: white;
    border: 1px solid #e0e0e0;
    border-radius: 8px;
    padding: 25px;
  }
  
  .reply-form h3 {
    font-size: 18px;
    color: #2c3e50;
    margin: 0 0 15px 0;
  }
  
  .reply-form textarea {
    width: 100%;
    min-height: 100px;
    padding: 12px;
    border: 1px solid #ddd;
    border-radius: 6px;
    font-size: 14px;
    font-family: inherit;
    resize: vertical;
  }
  
  .reply-form textarea:focus {
    outline: none;
    border-color: #27ae60;
  }
  
  .reply-form button {
    background: #27ae60;
    color: white;
    padding: 12px 24px;
    border: none;
    border-radius: 6px;
    font-weight: 500;
    cursor: pointer;
    margin-top: 15px;
  }
  
  .reply-form button:hover {
    background: #229954;
  }
  
  @media (max-width: 768px) {
    .report-meta-row {
      grid-template-columns: 1fr;
      gap: 10px;
    }
    
    .reply-header {
      flex-direction: column;
      align-items: flex-start;
      gap: 5px;
    }
  }
</style>

<div class="report-details-container">
  <a href="/guardian/reports" class="back-link">← Back to Reports</a>
  
  <div class="report-header">
    <h1 class="report-title"><%= report.subject %></h1>
    
    <div class="report-meta-row">
      <div class="meta-item">
        <span class="meta-label">Student:</span>
        <span>📚 <%= report.student_name %></span>
      </div>
      <div class="meta-item">
        <span class="meta-label">Date:</span>
        <span>📅 <%= new Date(report.created_at).toLocaleString() %></span>
      </div>
      <div class="meta-item">
        <span class="meta-label">Status:</span>
        <span class="status-badge status-<%= report.status %>">
          <%= report.status.replace('_', ' ') %>
        </span>
      </div>
      <div class="meta-item">
        <span class="meta-label">Priority:</span>
        <span class="priority-badge priority-<%= report.priority %>">
          <%= report.priority %>
        </span>
      </div>
    </div>
    
    <div class="original-message">
      <p><%= report.message %></p>
    </div>
  </div>
  
  <% if (recipients && recipients.length > 0) { %>
    <div class="cc-recipients">
      <h3>📧 Copied Staff Members</h3>
      <div class="recipient-list">
        <% recipients.forEach(recipient => { %>
          <span class="recipient-tag">
            <%= recipient.user_name %> (<%= recipient.user_role %>)
          </span>
        <% }); %>
      </div>
    </div>
  <% } %>
  
  <div class="conversation-section">
    <h3>💬 Conversation</h3>
    
    <% if (replies && replies.length > 0) { %>
      <% replies.forEach(reply => { %>
        <div class="reply-item">
          <div class="reply-header">
            <span class="reply-sender sender-type-<%= reply.sender_type %>">
              <%= reply.sender_name %>
              <% if (reply.sender_type === 'guardian') { %>(You)<% } %>
            </span>
            <span class="reply-date">
              <%= new Date(reply.created_at).toLocaleString() %>
            </span>
          </div>
          <p class="reply-message"><%= reply.message %></p>
        </div>
      <% }); %>
    <% } else { %>
      <div class="no-replies">
        No replies yet. Be the first to respond!
      </div>
    <% } %>
  </div>
  
  <form action="/guardian/reports/<%= report.report_id %>/reply" method="POST" class="reply-form">
    <h3>✍️ Add a Reply</h3>
    <textarea 
      name="message" 
      placeholder="Type your message here..."
      required
    ></textarea>
    <button type="submit">Send Reply</button>
  </form>
</div>
` }); %>
