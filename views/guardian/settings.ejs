<style>
  .settings-page {
    max-width: 1160px;
    margin: 0 auto;
    padding: 24px 20px 34px;
  }

  .settings-intro {
    margin-bottom: 22px;
    padding: 18px 20px;
    border-radius: 16px;
    border: 1px solid #dbe7f5;
    background:
      radial-gradient(circle at 8% 20%, rgba(111, 211, 196, 0.2), transparent 38%),
      linear-gradient(135deg, #f8fbff 0%, #f2f8ff 100%);
  }

  .settings-kicker {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 12px;
    border-radius: 999px;
    background: #ecfeff;
    border: 1px solid #bae6fd;
    color: #0f766e;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin-bottom: 12px;
  }

  .settings-page-title {
    margin: 0 0 6px;
    font-size: clamp(1.6rem, 2.5vw, 2.15rem);
    font-weight: 800;
    color: #0f172a;
    letter-spacing: -0.02em;
  }

  .settings-page-subtitle {
    margin: 0;
    max-width: 760px;
    color: #64748b;
    font-size: 0.98rem;
    line-height: 1.6;
    overflow-wrap: anywhere;
  }

  .settings-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 24px;
    align-items: start;
  }

  .settings-column {
    display: grid;
    gap: 24px;
    align-self: start;
  }

  .settings-card {
    background: #fff;
    border: 1px solid #e2e8f0;
    border-radius: 18px;
    box-shadow: 0 10px 35px rgba(15, 23, 42, 0.08);
    overflow: hidden;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .settings-card:hover {
    border-color: #cbdceb;
    box-shadow: 0 16px 40px rgba(15, 23, 42, 0.12);
  }

  .settings-card-header {
    padding: 24px 24px 0;
  }

  .profile-settings-shell > .accordion-summary {
    background: #fff;
    padding: 22px 24px;
  }

  .profile-settings-shell > .accordion-summary:hover {
    background: #f8fafc;
  }

  .profile-settings-shell[open] > .accordion-summary {
    border-bottom: 1px solid #e2e8f0;
  }

  .profile-settings-shell > .accordion-summary .accordion-badge {
    width: 48px;
    height: 48px;
    border-radius: 14px;
    font-size: 1.15rem;
  }

  .profile-settings-shell > .accordion-summary .accordion-title {
    font-size: 1.18rem;
  }

  .profile-settings-shell > .accordion-body {
    padding: 0;
    background: #fff;
  }

  .settings-card-title {
    margin: 0 0 6px;
    font-size: 1.2rem;
    font-weight: 800;
    color: #0f172a;
  }

  .settings-card-description {
    margin: 0;
    color: #64748b;
    font-size: 0.92rem;
    line-height: 1.55;
  }

  .settings-form {
    padding: 20px 24px 24px;
    display: grid;
    gap: 16px;
  }

  .settings-accordion {
    border: 1px solid #e2e8f0;
    border-radius: 16px;
    background: #f8fafc;
    overflow: hidden;
  }

  .settings-card > .settings-accordion,
  .settings-card.settings-accordion {
    border: 0;
    border-radius: inherit;
    background: transparent;
  }

  .settings-accordion summary {
    list-style: none;
  }

  .settings-accordion summary::-webkit-details-marker {
    display: none;
  }

  .accordion-summary {
    display: flex;
    align-items: center;
    gap: 14px;
    width: 100%;
    padding: 18px 20px;
    background: #f8fafc;
    cursor: pointer;
    user-select: none;
    transition: background 0.2s ease, border-color 0.2s ease;
  }

  .accordion-summary:hover {
    background: #f1f5f9;
  }

  .settings-accordion[open] > .accordion-summary {
    background: #fff;
    border-bottom: 1px solid #e2e8f0;
  }

  .accordion-badge {
    width: 42px;
    height: 42px;
    border-radius: 12px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, rgba(1, 83, 91, 0.14), rgba(111, 211, 196, 0.18));
    color: #0f766e;
    font-size: 1.05rem;
    flex-shrink: 0;
  }

  .accordion-copy {
    flex: 1;
    min-width: 0;
  }

  .accordion-title {
    display: block;
    color: #0f172a;
    font-size: 1rem;
    font-weight: 800;
    line-height: 1.25;
  }

  .accordion-subtitle {
    display: block;
    color: #64748b;
    font-size: 0.86rem;
    line-height: 1.45;
    margin-top: 3px;
    overflow-wrap: anywhere;
  }

  .accordion-chevron {
    display: none;
  }

  .accordion-body {
    padding: 20px;
    background: #fff;
  }

  .form-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 20px;
  }

  .form-field {
    margin: 0;
  }

  .form-field--full {
    grid-column: 1 / -1;
  }

  .form-label {
    display: block;
    font-weight: 700;
    color: #475569;
    margin-bottom: 8px;
    font-size: 14px;
  }

  .form-input {
    width: 100%;
    padding: 12px 16px;
    border: 2px solid #e2e8f0;
    border-radius: 10px;
    font-size: 16px;
    font-family: inherit;
    background: #fff;
    transition: border-color 0.2s ease, box-shadow 0.2s ease, transform 0.2s ease;
  }

  .form-input:focus {
    outline: none;
    border-color: #6fd3c4;
    box-shadow: 0 0 0 3px rgba(111, 211, 196, 0.12);
  }

  .media-panel {
    display: grid;
    gap: 14px;
  }

  .image-preview-container {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 16px;
    background: #fff;
    border: 1px solid #e2e8f0;
    border-radius: 14px;
  }

  .image-preview {
    width: 82px;
    height: 82px;
    border-radius: 50%;
    object-fit: cover;
    border: 3px solid #e2e8f0;
    flex-shrink: 0;
  }

  .image-upload-info p {
    margin: 0;
    color: #64748b;
    font-size: 14px;
    line-height: 1.5;
  }

  .image-upload-info p:first-child {
    font-weight: 700;
    color: #334155;
  }

  .helper-text {
    margin: 0;
    color: #64748b;
    font-size: 0.84rem;
    line-height: 1.5;
    overflow-wrap: anywhere;
  }

  .form-actions {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 172px));
    gap: 10px;
    margin-top: 6px;
    padding-top: 20px;
    border-top: 2px solid #e2e8f0;
    justify-content: flex-start;
    align-items: center;
  }

  .form-actions > .btn-primary,
  .form-actions > .btn-secondary {
    width: 100%;
    margin: 0;
  }

  .btn-primary {
    padding: 8px 12px;
    background: var(--primary);
    color: #fff;
    border: none;
    border-radius: 10px;
    font-weight: 700;
    font-size: 0.9rem;
    line-height: 1.2;
    cursor: pointer;
    transition: transform 0.2s ease, box-shadow 0.2s ease, background 0.2s ease;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.15);
    min-height: 34px;
    min-width: 132px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .btn-primary.is-loading,
  .wallet-action-btn.is-loading,
  .paygira-submit.is-loading {
    cursor: wait;
    opacity: 0.92;
    pointer-events: none;
  }

  .btn-primary.is-loading .btn-inline-spinner,
  .wallet-action-btn.is-loading .btn-inline-spinner,
  .paygira-submit.is-loading .btn-inline-spinner {
    display: inline-block;
  }

  .btn-inline-spinner {
    width: 13px;
    height: 13px;
    border-radius: 999px;
    border: 2px solid currentColor;
    border-right-color: transparent;
    display: none;
    animation: guardianBtnSpin .38s linear infinite;
    margin-right: 7px;
    vertical-align: -2px;
  }

  @keyframes guardianBtnSpin {
    to { transform: rotate(360deg); }
  }

  .btn-primary:hover {
    background: var(--primary-hover-fill, var(--primary-hover));
    transform: translateY(-1px);
    box-shadow: 0 8px 18px rgba(15, 23, 42, 0.18);
  }

  .btn-secondary {
    padding: 8px 12px;
    background: #fff;
    color: #475569;
    border: 2px solid #e2e8f0;
    border-radius: 10px;
    font-weight: 700;
    font-size: 0.9rem;
    text-decoration: none;
    cursor: pointer;
    transition: background 0.2s ease, border-color 0.2s ease;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 34px;
    min-width: 132px;
    line-height: 1.2;
  }

  .btn-secondary:hover {
    background: #f8fafc;
    border-color: #cbd5e1;
  }

  .notification-list {
    display: grid;
    gap: 10px;
    margin: 0 0 18px;
    padding: 0;
    list-style: none;
  }

  .notification-item {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    padding: 13px 14px;
    border: 1px solid #e5e7eb;
    border-radius: 12px;
    background: #f8fafc;
  }

  .notification-item input[type="checkbox"] {
    width: 18px;
    height: 18px;
    margin-top: 3px;
    accent-color: #01535b;
    flex-shrink: 0;
    cursor: pointer;
  }

  .notification-label {
    flex: 1;
    cursor: pointer;
  }

  .notification-label strong {
    display: block;
    font-size: 0.94rem;
    color: #0f172a;
    margin-bottom: 2px;
  }

  .notification-label span {
    display: block;
    font-size: 0.83rem;
    line-height: 1.45;
    color: #64748b;
    overflow-wrap: anywhere;
  }

  .paygira-secure-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 7px 13px;
    border-radius: 999px;
    background: linear-gradient(135deg, rgba(0,212,170,0.18), rgba(0,212,170,0.08));
    border: 1px solid rgba(0,212,170,0.45);
    color: #00d4aa;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .paygira-secure-text {
    display: inline;
  }

  .paygira-topbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 12px;
    margin-bottom: 8px;
  }

  .paygira-intro {
    margin: 0 0 18px;
    color: #64748b;
    font-size: 0.92rem;
    line-height: 1.6;
    overflow-wrap: anywhere;
  }

  .paygira-cards-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 14px;
    margin-bottom: 22px;
  }

  .wallet-card {
    position: relative;
    min-height: 148px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 14px;
    padding: 18px;
    border-radius: 16px;
    background: #ffffff;
    border: 1px solid #dbe6f4;
    color: #0f172a;
  }

  .wallet-card-meta,
  .wallet-card-footer,
  .wallet-card-actions {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    flex-wrap: wrap;
  }

  .wallet-card-actions {
    justify-content: flex-start;
  }

  .wallet-card-brand {
    font-size: 0.72rem;
    color: #64748b;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-weight: 700;
  }

  .wallet-card-default {
    background: rgba(0,212,170,0.12);
    color: #0f766e;
    border: 1px solid rgba(15,118,110,0.28);
    padding: 2px 8px;
    border-radius: 999px;
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .wallet-card-number {
    font-family: "JetBrains Mono", monospace;
    font-size: 1.05rem;
    letter-spacing: 0.15em;
    font-weight: 600;
  }

  .wallet-card-footer {
    font-size: 0.78rem;
    color: #64748b;
  }

  .wallet-action-btn {
    appearance: none;
    border-radius: 8px;
    padding: 5px 9px;
    font-size: 0.7rem;
    font-weight: 700;
    cursor: pointer;
    border: 1px solid #cbd5e1;
    background: #f8fafc;
    color: #334155;
    min-height: 30px;
    min-width: 98px;
  }

  .wallet-action-btn--danger {
    background: rgba(255,77,109,0.12);
    color: #ff4d6d;
    border-color: rgba(255,77,109,0.3);
  }

  .paygira-empty-state {
    text-align: center;
    padding: 24px;
    color: #64748b;
    background: #f8fafc;
    border: 1px dashed #cbd5e1;
    border-radius: 12px;
    margin-bottom: 22px;
  }

  .paygira-form {
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: 16px;
    padding: 18px;
  }

  .paygira-form-title {
    margin: 0 0 14px;
    font-size: 1rem;
    color: #0f172a;
    font-weight: 700;
  }

  .paygira-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
    margin-bottom: 12px;
  }

  .paygira-label {
    display: block;
    font-size: 0.7rem;
    color: #475569;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    margin-bottom: 6px;
  }

  .paygira-input,
  .paygira-select {
    width: 100%;
    padding: 11px 14px;
    border-radius: 10px;
    background: #ffffff;
    border: 1px solid #cbd5e1;
    color: #0f172a;
    font-size: 16px;
    font-family: inherit;
  }

  .paygira-input--mono {
    font-family: "JetBrains Mono", monospace;
    letter-spacing: 0.08em;
  }

  .paygira-checkbox {
    display: flex;
    align-items: center;
    gap: 8px;
    color: #334155;
    font-size: 0.85rem;
    margin-bottom: 14px;
    cursor: pointer;
  }

  .paygira-checkbox input {
    width: 16px;
    height: 16px;
    accent-color: #00d4aa;
  }

  .paygira-actions {
    display: flex;
    justify-content: flex-start;
    align-items: center;
    flex-wrap: wrap;
    gap: 12px;
  }

  .paygira-note {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-size: 0.72rem;
    color: #64748b;
    line-height: 1.5;
  }

  .paygira-submit {
    background: linear-gradient(135deg, #00d4aa, #00b693);
    color: #062018;
    border: none;
    padding: 8px 12px;
    border-radius: 10px;
    font-weight: 800;
    cursor: pointer;
    letter-spacing: 0.04em;
    font-size: 0.8rem;
    min-height: 34px;
    min-width: 132px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .paygira-link-wrap {
    margin-top: 18px;
    text-align: left;
  }

  .paygira-link {
    color: #00d4aa;
    text-decoration: none;
    font-weight: 700;
    font-size: 0.92rem;
  }

  @media (max-width: 768px) {
    .settings-page {
      padding: 16px;
    }

    .settings-intro {
      padding: 14px;
      border-radius: 14px;
    }

    .settings-grid {
      grid-template-columns: 1fr;
    }

    .settings-card-header,
    .settings-form {
      padding-left: 18px;
      padding-right: 18px;
    }

    .profile-settings-shell > .accordion-summary {
      padding: 18px;
    }

    .accordion-summary,
    .accordion-body {
      padding: 16px;
    }

    .form-grid,
    .paygira-grid {
      grid-template-columns: 1fr;
    }

    .paygira-cards-grid {
      grid-template-columns: 1fr;
    }

    .form-actions {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .paygira-actions {
      align-items: flex-start;
    }

    .paygira-actions .paygira-submit {
      width: auto;
      min-width: 132px;
    }

    .image-preview-container {
      flex-direction: column;
      text-align: center;
    }

    .wallet-card-number {
      font-size: 0.94rem;
      letter-spacing: 0.11em;
    }
  }

  @media (max-width: 520px) {
    .settings-page {
      padding: 12px;
    }

    .settings-card {
      border-radius: 14px;
    }

    .accordion-summary {
      gap: 10px;
      align-items: flex-start;
    }

    .accordion-badge {
      width: 38px;
      height: 38px;
      border-radius: 10px;
      font-size: 0.95rem;
    }

    .settings-page-subtitle,
    .accordion-subtitle,
    .settings-card-description,
    .paygira-intro {
      font-size: 0.9rem;
    }

    .paygira-secure-badge {
      gap: 0;
      padding: 7px 10px;
    }

    .paygira-secure-text {
      display: none;
    }

    .form-actions {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .paygira-actions .paygira-submit {
      width: auto;
    }
  }
</style>

<% const _cards = (typeof cards !== 'undefined' && Array.isArray(cards)) ? cards : []; %>
<% const _myChildren = (typeof children !== 'undefined' && Array.isArray(children)) ? children : []; %>

<div class="settings-page">
  <div class="settings-intro">
    <div class="settings-kicker">Guardian Account</div>
    <h1 class="settings-page-title">Settings &amp; Billing</h1>
    <p class="settings-page-subtitle">Manage your profile, update student images, control notification preferences, and handle PayGira billing from one responsive dashboard.</p>
  </div>

  <div class="settings-grid">
    <div class="settings-column">
      <details class="settings-card settings-accordion profile-settings-shell">
        <summary class="accordion-summary">
          <span class="accordion-badge">⚙️</span>
          <span class="accordion-copy">
            <span class="accordion-title">Profile Settings</span>
            <span class="accordion-subtitle">Open this section to manage your photo, student images, and all personal details.</span>
          </span>
          <span class="accordion-chevron" aria-hidden="true">⌄</span>
        </summary>

        <div class="accordion-body">
        <form action="/guardian/settings" method="POST" enctype="multipart/form-data" class="settings-form" onsubmit="if (window.combinePhoneCountryCombos) window.combinePhoneCountryCombos(this);">
          <details class="settings-accordion">
            <summary class="accordion-summary">
              <span class="accordion-badge">👤</span>
              <span class="accordion-copy">
                <span class="accordion-title">Your Profile Image</span>
                <span class="accordion-subtitle">Upload and preview your current guardian picture.</span>
              </span>
              <span class="accordion-chevron" aria-hidden="true">⌄</span>
            </summary>
            <div class="accordion-body">
              <div class="media-panel">
                <div class="form-field">
                  <label class="form-label">Upload Your Profile Picture</label>
                  <input type="file" name="guardianImage" class="form-input" accept="image/*" />
                </div>

                <div class="image-preview-container">
                  <img
                    src="<%= guardian.image_url && guardian.image_url !== 'profilePlaceholder.png' ? guardian.image_url : '/images/profilePlaceholder.png' %>"
                    alt="Guardian Profile"
                    class="image-preview"
                  />
                  <div class="image-upload-info">
                    <p>Current profile picture</p>
                    <p>Upload a new image to replace this one.</p>
                  </div>
                </div>
              </div>
            </div>
          </details>

          <% if (students && students.length > 0) { %>
          <details class="settings-accordion" id="studentImagesAccordion">
            <summary class="accordion-summary">
              <span class="accordion-badge">🧒</span>
              <span class="accordion-copy">
                <span class="accordion-title">Student Images</span>
                <span class="accordion-subtitle">Choose a student and replace their current profile image.</span>
              </span>
              <span class="accordion-chevron" aria-hidden="true">⌄</span>
            </summary>
            <div class="accordion-body">
              <div class="media-panel">
                <div class="form-field">
                  <label class="form-label">Select Student</label>
                  <select name="studentId" id="studentSelect" class="form-input" onchange="updateStudentPreview()">
                    <option value="">-- Select a student to update their image --</option>
                    <% students.forEach(student => { %>
                      <option
                        value="<%= student.student_id %>"
                        data-image="<%= student.image_url && student.image_url !== 'profilePlaceholder.png' ? student.image_url : '/images/profilePlaceholder.png' %>">
                        <%= student.display_name || (typeof formatDisplayName === 'function' ? formatDisplayName(student) : [student.first_name, student.last_name].filter(Boolean).join(' ').trim()) %>
                      </option>
                    <% }) %>
                  </select>
                </div>

                <div class="form-field" id="studentImageUpload" style="display:none;">
                  <label class="form-label">Upload Student Image</label>
                  <input type="file" name="studentImage" class="form-input" accept="image/*" />

                  <div class="image-preview-container">
                    <img src="/images/profilePlaceholder.png" alt="Student" id="studentImagePreview" class="image-preview" />
                    <div class="image-upload-info">
                      <p id="studentImageInfo">Select a student to see their current image</p>
                      <p>Upload a new image to replace it.</p>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </details>
          <% } %>

          <details class="settings-accordion">
            <summary class="accordion-summary">
              <span class="accordion-badge">🪪</span>
              <span class="accordion-copy">
                <span class="accordion-title">Personal Information</span>
                <span class="accordion-subtitle">Update your names, contact information, and location details in one place.</span>
              </span>
              <span class="accordion-chevron" aria-hidden="true">⌄</span>
            </summary>
            <div class="accordion-body">
              <div class="form-grid">
                <div class="form-field">
                  <label class="form-label">First Name *</label>
                  <input type="text" name="firstName" class="form-input" value="<%= guardian.first_name %>" required />
                </div>

                <div class="form-field">
                  <label class="form-label">Last Name</label>
                  <input type="text" name="lastName" class="form-input" value="<%= guardian.last_name || '' %>" />
                </div>

                <div class="form-field">
                  <label class="form-label">Email Address *</label>
                  <input type="email" name="email" class="form-input" value="<%= guardian.email || guardian.login_email || '' %>" required />
                </div>

                <div class="form-field">
                  <label class="form-label">Phone Number *</label>
                  <div class="phone-combo" data-default-iso2="GH">
                    <select class="phone-dial-select"></select>
                    <input type="text" class="phone-local-input" name="phone" value="<%= guardian.phone || guardian.login_phone || '' %>" required />
                  </div>
                </div>

                <div class="form-field form-field--full">
                  <label class="form-label">Address</label>
                  <input type="text" name="address" class="form-input" value="<%= guardian.address || '' %>" />
                </div>

                <div class="form-field form-field--full">
                  <label class="form-label">Hometown</label>
                  <input type="text" name="hometown" class="form-input" value="<%= guardian.hometown || '' %>" />
                </div>
              </div>
            </div>
          </details>

          <div class="form-actions">
            <button type="submit" class="btn-primary">💾 Save Changes</button>
            <a href="/guardian/dashboard" class="btn-secondary">Cancel</a>
          </div>
        </form>
        </div>
      </details>
    </div>

    <div class="settings-column">
      <% if (typeof notificationPrefs !== 'undefined' && Array.isArray(notificationPrefs) && notificationPrefs.length) {
           const _saved = (typeof savedNotificationPrefs !== 'undefined' && savedNotificationPrefs) ? savedNotificationPrefs : {}; %>
      <details class="settings-card settings-accordion">
        <summary class="accordion-summary">
          <span class="accordion-badge">📬</span>
          <span class="accordion-copy">
            <span class="accordion-title">Email Notifications</span>
            <span class="accordion-subtitle">Choose which alerts you want to receive about your child(ren).</span>
          </span>
          <span class="accordion-chevron" aria-hidden="true">⌄</span>
        </summary>
        <div class="accordion-body">
          <p class="helper-text" style="margin-bottom:16px;">Only parent notifications currently sent by the system are listed here. Account-security and admission decision emails are always sent.</p>

          <form action="/guardian/settings/notifications" method="POST" autocomplete="off">
            <ul class="notification-list">
              <% notificationPrefs.forEach(function(p) {
                   const checked = (p.key in _saved) ? !!_saved[p.key] : true; %>
                <li class="notification-item">
                  <input type="checkbox" name="preferences" id="g-pref-<%= p.key %>" value="<%= p.key %>" <%= checked ? 'checked' : '' %> />
                  <label for="g-pref-<%= p.key %>" class="notification-label">
                    <strong><%= p.label %></strong>
                    <% if (p.description) { %><span><%= p.description %></span><% } %>
                  </label>
                </li>
              <% }); %>
            </ul>

            <div class="form-actions">
              <button type="submit" class="btn-primary">💾 Save Preferences</button>
            </div>
          </form>
        </div>
      </details>
      <% } %>

      <details id="cards" class="settings-card settings-accordion">
        <summary class="accordion-summary">
          <span class="accordion-badge">💳</span>
          <span class="accordion-copy">
            <span class="accordion-title">PayGira Cards &amp; Billing</span>
            <span class="accordion-subtitle">Manage saved cards and billing tools in one secure place.</span>
          </span>
          <span class="accordion-chevron" aria-hidden="true">⌄</span>
        </summary>
        <div class="accordion-body">
          <div class="paygira-topbar">
            <h2 style="margin:0;font-size:1.25rem;font-weight:800;letter-spacing:-0.01em;">💳 Pay<span style="color:#00d4aa;font-style:italic;">Gira</span> — Cards &amp; Billing</h2>
            <span class="paygira-secure-badge">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4z"/></svg>
              <span class="paygira-secure-text">Secure</span>
            </span>
          </div>

          <p class="paygira-intro">Save a card for faster payment. Only the last 4 digits are stored and shown.</p>

          <% if (_cards.length) { %>
            <div class="paygira-cards-grid">
              <% _cards.forEach(function(c) { %>
                <div class="wallet-card">
                  <div class="wallet-card-meta">
                    <span class="wallet-card-brand"><%= c.brand || 'Card' %></span>
                    <% if (c.is_default) { %>
                      <span class="wallet-card-default">Default</span>
                    <% } %>
                  </div>

                  <div class="wallet-card-number">•••• •••• •••• <%= c.last4 %></div>

                  <div class="wallet-card-footer">
                    <span><%= c.holder_name || '—' %></span>
                    <span><%= c.exp_month ? String(c.exp_month).padStart(2,'0') : '--' %>/<%= c.exp_year ? String(c.exp_year).slice(-2) : '--' %></span>
                  </div>

                  <div class="wallet-card-actions">
                    <% if (!c.is_default) { %>
                      <form action="/guardian/cards/<%= c.card_id %>/default" method="POST">
                        <button type="submit" class="wallet-action-btn">Make Default</button>
                      </form>
                    <% } %>

                    <form action="/guardian/cards/<%= c.card_id %>/delete" method="POST" onsubmit="return confirm('Remove this card?');">
                      <button type="submit" class="wallet-action-btn wallet-action-btn--danger">Remove</button>
                    </form>
                  </div>
                </div>
              <% }); %>
            </div>
          <% } else { %>
            <div class="paygira-empty-state">No cards saved yet. Add your first card below to make one-tap payments on PayGira.</div>
          <% } %>

          <form action="/guardian/cards" method="POST" autocomplete="off" class="paygira-form">
            <h3 class="paygira-form-title">➕ Add a new card</h3>

            <div class="paygira-grid">
              <div>
                <label class="paygira-label">Card number</label>
                <input type="text" name="card_number" inputmode="numeric" pattern="[0-9 ]{12,23}" placeholder="1234 5678 9012 3456" required class="paygira-input paygira-input--mono" />
              </div>

              <div>
                <label class="paygira-label">Cardholder name</label>
                <input type="text" name="holder_name" placeholder="e.g. JANE DOE" class="paygira-input" style="text-transform:uppercase;" />
              </div>

              <div>
                <label class="paygira-label">Exp Month</label>
                <input type="number" name="exp_month" min="1" max="12" placeholder="MM" required class="paygira-input" />
              </div>

              <div>
                <label class="paygira-label">Exp Year</label>
                <input type="number" name="exp_year" min="2024" max="2099" placeholder="YYYY" required class="paygira-input" />
              </div>

              <div>
                <label class="paygira-label">Attach to child (optional)</label>
                <select name="child_student_id" class="paygira-select">
                  <option value="">— Any of my children —</option>
                  <% _myChildren.forEach(function(ch){ %>
                    <option value="<%= ch.student_id %>"><%= ch.display_name || (typeof formatDisplayName === 'function' ? formatDisplayName(ch) : [ch.first_name, ch.last_name].filter(Boolean).join(' ').trim()) %></option>
                  <% }); %>
                </select>
              </div>
            </div>

            <label class="paygira-checkbox">
              <input type="checkbox" name="set_default" value="1">
              Make this my default payment card
            </label>

            <div class="paygira-actions">
              <span class="paygira-note">
                <svg width="11" height="11" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4z"/></svg>
                We store only the last 4 digits — your full PAN is never saved.
              </span>

              <button type="submit" class="paygira-submit">🔒 Save Card Securely</button>
            </div>
          </form>

          <% if (Array.isArray(allowedFeatures) && allowedFeatures.includes('PayGira')) { %>
          <div class="paygira-link-wrap">
            <a href="/guardian/paygira" class="paygira-link">Go to PayGira to pay a bill →</a>
          </div>
          <% } %>
        </div>
      </details>
    </div>
  </div>
</div>

<script src="/js/dialCodes.js"></script>
<script>
function updateStudentPreview() {
  const select = document.getElementById('studentSelect');
  const uploadSection = document.getElementById('studentImageUpload');
  const preview = document.getElementById('studentImagePreview');
  const info = document.getElementById('studentImageInfo');
  const accordion = document.getElementById('studentImagesAccordion');

  if (!select || !uploadSection || !preview || !info) return;

  if (select.value) {
    const selectedOption = select.options[select.selectedIndex];
    const imageUrl = selectedOption.dataset.image;

    preview.src = imageUrl;
    info.textContent = `Current image for ${selectedOption.text}`;
    uploadSection.style.display = 'block';
    if (accordion) accordion.open = true;
  } else {
    uploadSection.style.display = 'none';
    preview.src = '/images/profilePlaceholder.png';
    info.textContent = 'Select a student to see their current image';
  }
}

document.addEventListener('DOMContentLoaded', () => {
  if (window.location.hash === '#cards') {
    const cardsSection = document.getElementById('cards');
    if (cardsSection) {
      cardsSection.open = true;
      cardsSection.scrollIntoView({ block: 'start' });
    }
  }

  const toLoadingState = (button) => {
    if (!button || button.dataset.loadingActive === '1') return;

    const isInputSubmit = button.tagName === 'INPUT';
    button.dataset.loadingActive = '1';
    button.disabled = true;
    button.classList.add('is-loading');

    if (isInputSubmit) {
      if (!button.dataset.originalValue) button.dataset.originalValue = button.value;
      button.value = 'Processing...';
      return;
    }

    if (!button.dataset.originalHtml) button.dataset.originalHtml = button.innerHTML;
    const currentText = (button.textContent || '').trim() || 'Processing';
    button.innerHTML = '<span class="btn-inline-spinner" aria-hidden="true"></span><span>' + currentText + '</span>';
  };

  document.querySelectorAll('.settings-page form').forEach((form) => {
    form.addEventListener('submit', (event) => {
      requestAnimationFrame(() => {
        if (event.defaultPrevented) return;

        const submitter = event.submitter || form.querySelector('button[type="submit"], input[type="submit"]');
        if (submitter) toLoadingState(submitter);

        form.querySelectorAll('button[type="submit"], input[type="submit"]').forEach((control) => {
          if (control !== submitter) {
            control.disabled = true;
          }
        });
      });
    });
  });
});
</script>
