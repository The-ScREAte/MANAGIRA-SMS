<style>
  .settings-container {
    max-width: 800px;
    margin: 0 auto;
    padding: 24px;
  }

  .settings-form-card {
    background: white;
    border-radius: 12px;
    padding: 28px;
    box-shadow: 0 2px 8px rgba(0,0,0,0.08);
    border: 1px solid #e2e8f0;
  }

  .form-section {
    margin-bottom: 28px;
  }

  .form-section-title {
    font-size: 18px;
    font-weight: 700;
    color: #1e293b;
    margin: 0 0 16px 0;
    padding-bottom: 12px;
    border-bottom: 2px solid #e2e8f0;
  }

  .form-row {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 20px;
    margin-bottom: 20px;
  }

  .form-field {
    margin-bottom: 0;
  }

  .form-label {
    display: block;
    font-weight: 600;
    color: #475569;
    margin-bottom: 8px;
    font-size: 14px;
  }

  .form-input {
    width: 100%;
    padding: 12px 16px;
    border: 2px solid #e2e8f0;
    border-radius: 8px;
    font-size: 15px;
    transition: all 0.3s ease;
  }

  .form-input:focus {
    outline: none;
    border-color: #6fd3c4;
    box-shadow: 0 0 0 3px rgba(111, 211, 196, 0.1);
  }

  .form-actions {
    display: flex;
    gap: 12px;
    margin-top: 28px;
    padding-top: 20px;
    border-top: 2px solid #e2e8f0;
  }

  .btn-primary {
    padding: 14px 28px;
    background: var(--primary);
    color: white;
    border: none;
    border-radius: 8px;
    font-weight: 600;
    font-size: 15px;
    cursor: pointer;
    transition: all 0.3s ease;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.15);
  }

  .btn-primary:hover {
    background: var(--primary-hover-fill, var(--primary-hover));
    transform: translateY(-2px);
    box-shadow: 0 6px 16px rgba(0, 0, 0, 0.2);
  }

  .btn-secondary {
    padding: 14px 28px;
    background: white;
    color: #475569;
    border: 2px solid #e2e8f0;
    border-radius: 8px;
    font-weight: 600;
    font-size: 15px;
    text-decoration: none;
    cursor: pointer;
    transition: all 0.3s ease;
    display: inline-block;
  }

    .btn-secondary:hover {
      background: #f8fafc;
      border-color: #cbd5e1;
    }

    /* Image upload sections */
    .student-image-section {
      background: #f8fafc;
      border: 1px solid #e2e8f0;
      border-radius: 12px;
      padding: 20px;
      margin-bottom: 24px;
    }

    .student-image-section h2 {
      margin: 0 0 16px 0;
      font-size: 17px;
      font-weight: 700;
      color: #1e293b;
    }

    .image-preview-container {
      display: flex;
      align-items: center;
      gap: 16px;
      margin-top: 12px;
      padding: 16px;
      background: #fff;
      border: 1px solid #e2e8f0;
      border-radius: 10px;
    }

    .image-preview {
      width: 80px;
      height: 80px;
      border-radius: 50%;
      object-fit: cover;
      border: 3px solid #e2e8f0;
    }

    .image-upload-info p {
      margin: 0;
      color: #64748b;
      font-size: 14px;
    }

    .image-upload-info p:first-child {
      font-weight: 600;
      color: #334155;
    }

    @media (max-width: 768px) {
      .settings-container {
        padding: 16px;
      }

      .settings-form-card {
        padding: 20px;
      }

      .form-row {
        grid-template-columns: 1fr;
        gap: 16px;
      }

      .form-actions {
        flex-direction: column;
      }

      .btn-primary, .btn-secondary {
        width: 100%;
        text-align: center;
      }

      .image-preview-container {
        flex-direction: column;
        text-align: center;
      }
    }
</style>

<div class="settings-container">
  <div class="settings-form-card">
    <form action="/guardian/settings" method="POST" enctype="multipart/form-data">
      
      <!-- Guardian Profile Image Section -->
      <div class="student-image-section">
        <h2>👤 Your Profile Image</h2>
        <div class="form-field">
          <label class="form-label">Upload Your Profile Picture</label>
          <input 
            type="file" 
            name="guardianImage" 
            class="form-input" 
            accept="image/*"
          />
          <div class="image-preview-container">
            <img 
              src="<%= guardian.image_url && guardian.image_url !== 'profilePlaceholder.png' ? guardian.image_url : '/images/profilePlaceholder.png' %>" 
              alt="Guardian Profile"
              class="image-preview"
            />
            <div class="image-upload-info">
              <p>Current profile picture</p>
              <p style="font-size: 12px;">Upload a new image to replace this one</p>
            </div>
          </div>
        </div>
      </div>

      <!-- Student Image Upload Section -->
      <% if (students && students.length > 0) { %>
      <div class="student-image-section">
        <h2>👨‍👩‍👧‍👦 Update Student Images</h2>
        <div class="form-field" style="margin-bottom: 16px;">
          <label class="form-label">Select Student</label>
          <select name="studentId" id="studentSelect" class="form-input" onchange="updateStudentPreview()">
            <option value="">-- Select a student to update their image --</option>
            <% students.forEach(student => { %>
              <option 
                value="<%= student.student_id %>" 
                data-image="<%= student.image_url && student.image_url !== 'profilePlaceholder.png' ? student.image_url : '/images/profilePlaceholder.png' %>">
                <%= student.first_name %> <%= student.last_name %>
              </option>
            <% }) %>
          </select>
        </div>

        <div class="form-field" id="studentImageUpload" style="display: none;">
          <label class="form-label">Upload Student Image</label>
          <input 
            type="file" 
            name="studentImage" 
            class="form-input" 
            accept="image/*"
          />
          <div class="image-preview-container">
            <img 
              src="/images/profilePlaceholder.png" 
              alt="Student"
              id="studentImagePreview"
              class="image-preview"
            />
            <div class="image-upload-info">
              <p id="studentImageInfo">Select a student to see their current image</p>
              <p style="font-size: 12px;">Upload a new image to replace it</p>
            </div>
          </div>
        </div>
      </div>
      <% } %>

      <div class="form-section">
        <h2 class="form-section-title">Personal Information</h2>
        
        <div class="form-row">
          <div class="form-field">
            <label class="form-label">First Name *</label>
            <input 
              type="text" 
              name="firstName" 
              class="form-input" 
              value="<%= guardian.first_name %>" 
              required
            />
          </div>

          <div class="form-field">
            <label class="form-label">Last Name</label>
            <input 
              type="text" 
              name="lastName" 
              class="form-input" 
              value="<%= guardian.last_name || '' %>"
            />
          </div>
        </div>
      </div>

      <div class="form-section">
        <h2 class="form-section-title">Contact Information</h2>
        
        <div class="form-row">
          <div class="form-field">
            <label class="form-label">Email Address *</label>
            <input 
              type="email" 
              name="email" 
              class="form-input" 
              value="<%= guardian.email || guardian.login_email || '' %>" 
              required
            />
          </div>

          <div class="form-field">
            <label class="form-label">Phone Number *</label>
            <input 
              type="text" 
              name="phone" 
              class="form-input" 
              value="<%= guardian.phone || guardian.login_phone || '' %>" 
              required
            />
          </div>
        </div>
      </div>

      <div class="form-section">
        <h2 class="form-section-title">Location</h2>
        
        <div class="form-field" style="margin-bottom: 20px;">
          <label class="form-label">Address</label>
          <input 
            type="text" 
            name="address" 
            class="form-input" 
            value="<%= guardian.address || '' %>"
          />
        </div>

        <div class="form-field">
          <label class="form-label">Hometown</label>
          <input 
            type="text" 
            name="hometown" 
            class="form-input" 
            value="<%= guardian.hometown || '' %>"
          />
        </div>
      </div>

      <div class="form-actions">
        <button type="submit" class="btn-primary">💾 Save Changes</button>
        <a href="/guardian/dashboard" class="btn-secondary">Cancel</a>
      </div>
    </form>
  </div>

  <% if (typeof notificationPrefs !== 'undefined' && Array.isArray(notificationPrefs) && notificationPrefs.length) {
       const _saved = (typeof savedNotificationPrefs !== 'undefined' && savedNotificationPrefs) ? savedNotificationPrefs : {}; %>
  <div class="settings-section" style="margin-top:24px;background:#fff;border:1px solid #e5e7eb;border-radius:14px;padding:24px;box-shadow:0 6px 22px rgba(15,23,42,0.06);">
    <h2 style="margin:0 0 6px;font-size:1.2rem;color:#0f172a;">📬 Email Notifications</h2>
    <p style="margin:0 0 16px;color:#64748b;font-size:0.92rem;">Choose which emails you want to receive about your child(ren). Account-security and admission decision emails are always sent.</p>

    <form action="/guardian/settings/notifications" method="POST" autocomplete="off">
      <ul style="display:flex;flex-direction:column;gap:10px;margin:0 0 16px;padding:0;list-style:none;">
        <% notificationPrefs.forEach(function(p) {
             const checked = (p.key in _saved) ? !!_saved[p.key] : true; %>
          <li style="display:flex;align-items:flex-start;gap:12px;padding:12px 14px;border:1px solid #e5e7eb;border-radius:10px;background:#f9fafb;">
            <input type="checkbox" name="preferences" id="g-pref-<%= p.key %>" value="<%= p.key %>" <%= checked ? 'checked' : '' %> style="margin-top:4px;width:18px;height:18px;accent-color:#01535b;flex-shrink:0;cursor:pointer;" />
            <label for="g-pref-<%= p.key %>" style="flex:1;cursor:pointer;">
              <span style="font-weight:600;color:#0f172a;font-size:0.93rem;display:block;"><%= p.label %></span>
              <% if (p.description) { %><span style="font-size:0.83rem;color:#64748b;margin-top:2px;line-height:1.4;display:block;"><%= p.description %></span><% } %>
            </label>
          </li>
        <% }); %>
      </ul>
      <div class="form-actions">
        <button type="submit" class="btn-primary">💾 Save Preferences</button>
      </div>
    </form>
  </div>
  <% } %>

  <!-- ====================== PayGira Cards & Billing ====================== -->
  <div id="cards" class="settings-section" style="margin-top:24px;background:linear-gradient(180deg,#0e1426,#131b33);color:#e9eef8;border:1px solid rgba(255,255,255,0.08);border-radius:16px;padding:24px;box-shadow:0 8px 30px rgba(0,0,0,0.18);">
    <div style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:12px;margin-bottom:8px;">
      <h2 style="margin:0;font-size:1.25rem;font-weight:800;letter-spacing:-0.01em;">
        💳 Pay<span style="color:#00D4AA;font-style:italic;">Gira</span> — Cards &amp; Billing
      </h2>
      <span class="paygira-secure-badge" style="display:inline-flex;align-items:center;gap:6px;padding:7px 13px;border-radius:999px;background:linear-gradient(135deg,rgba(0,212,170,0.18),rgba(0,212,170,0.08));border:1px solid rgba(0,212,170,0.45);color:#00D4AA;font-size:.7rem;font-weight:700;letter-spacing:.08em;text-transform:uppercase;">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4z"/></svg>
        Secure
      </span>
    </div>
    <p style="margin:0 0 18px;color:#8a93a8;font-size:0.9rem;">
      Save payment cards to your wallet to pay your child's bills in one tap. Only the last 4 digits are stored — your full card number stays private.
    </p>

    <% const _cards = (typeof cards !== 'undefined' && Array.isArray(cards)) ? cards : []; %>
    <% const _myChildren = (typeof children !== 'undefined' && Array.isArray(children)) ? children : []; %>

    <!-- Saved cards list -->
    <% if (_cards.length) { %>
      <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:14px;margin-bottom:22px;">
        <% _cards.forEach(function(c) { %>
          <div style="position:relative;background:linear-gradient(135deg,#1a2348,#0e1426);border:1px solid rgba(255,255,255,0.1);border-radius:14px;padding:18px;color:#e9eef8;min-height:140px;display:flex;flex-direction:column;justify-content:space-between;">
            <div style="display:flex;justify-content:space-between;align-items:flex-start;">
              <span style="font-size:.7rem;color:#8a93a8;text-transform:uppercase;letter-spacing:.08em;font-weight:700;"><%= c.brand || 'Card' %></span>
              <% if (c.is_default) { %>
                <span style="background:rgba(0,212,170,0.18);color:#00D4AA;border:1px solid rgba(0,212,170,0.4);padding:2px 8px;border-radius:999px;font-size:.62rem;font-weight:700;letter-spacing:.06em;text-transform:uppercase;">Default</span>
              <% } %>
            </div>
            <div style="font-family:'JetBrains Mono',monospace;font-size:1.05rem;letter-spacing:.15em;font-weight:600;">
              •••• •••• •••• <%= c.last4 %>
            </div>
            <div style="display:flex;justify-content:space-between;align-items:center;font-size:.78rem;color:#8a93a8;">
              <span><%= c.holder_name || '—' %></span>
              <span><%= c.exp_month ? String(c.exp_month).padStart(2,'0') : '--' %>/<%= c.exp_year ? String(c.exp_year).slice(-2) : '--' %></span>
            </div>
            <div style="display:flex;gap:8px;margin-top:10px;">
              <% if (!c.is_default) { %>
                <form action="/guardian/cards/<%= c.card_id %>/default" method="POST" style="display:inline;">
                  <button type="submit" style="background:rgba(255,255,255,0.06);color:#e9eef8;border:1px solid rgba(255,255,255,0.1);padding:5px 10px;border-radius:8px;font-size:.72rem;font-weight:600;cursor:pointer;">Make Default</button>
                </form>
              <% } %>
              <form action="/guardian/cards/<%= c.card_id %>/delete" method="POST" style="display:inline;" onsubmit="return confirm('Remove this card?');">
                <button type="submit" style="background:rgba(255,77,109,0.12);color:#FF4D6D;border:1px solid rgba(255,77,109,0.3);padding:5px 10px;border-radius:8px;font-size:.72rem;font-weight:600;cursor:pointer;">Remove</button>
              </form>
            </div>
          </div>
        <% }); %>
      </div>
    <% } else { %>
      <div style="text-align:center;padding:24px;color:#8a93a8;background:rgba(255,255,255,0.03);border:1px dashed rgba(255,255,255,0.08);border-radius:12px;margin-bottom:22px;">
        No cards saved yet. Add your first card below to make one-tap payments on PayGira.
      </div>
    <% } %>

    <!-- Add card form -->
    <form action="/guardian/cards" method="POST" autocomplete="off" style="background:rgba(255,255,255,0.03);border:1px solid rgba(255,255,255,0.06);border-radius:14px;padding:18px;">
      <h3 style="margin:0 0 14px;font-size:1rem;color:#e9eef8;font-weight:700;">➕ Add a new card</h3>
      <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:12px;margin-bottom:12px;">
        <div>
          <label style="display:block;font-size:.7rem;color:#8a93a8;font-weight:700;letter-spacing:.06em;text-transform:uppercase;margin-bottom:5px;">Card number</label>
          <input type="text" name="card_number" inputmode="numeric" pattern="[0-9 ]{12,23}" placeholder="1234 5678 9012 3456" required
                 style="width:100%;padding:11px 14px;border-radius:10px;background:#080d1a;border:1px solid rgba(255,255,255,0.1);color:#e9eef8;font-family:'JetBrains Mono',monospace;letter-spacing:.08em;">
        </div>
        <div>
          <label style="display:block;font-size:.7rem;color:#8a93a8;font-weight:700;letter-spacing:.06em;text-transform:uppercase;margin-bottom:5px;">Cardholder name</label>
          <input type="text" name="holder_name" placeholder="e.g. JANE DOE"
                 style="width:100%;padding:11px 14px;border-radius:10px;background:#080d1a;border:1px solid rgba(255,255,255,0.1);color:#e9eef8;text-transform:uppercase;">
        </div>
        <div>
          <label style="display:block;font-size:.7rem;color:#8a93a8;font-weight:700;letter-spacing:.06em;text-transform:uppercase;margin-bottom:5px;">Exp Month</label>
          <input type="number" name="exp_month" min="1" max="12" placeholder="MM" required
                 style="width:100%;padding:11px 14px;border-radius:10px;background:#080d1a;border:1px solid rgba(255,255,255,0.1);color:#e9eef8;">
        </div>
        <div>
          <label style="display:block;font-size:.7rem;color:#8a93a8;font-weight:700;letter-spacing:.06em;text-transform:uppercase;margin-bottom:5px;">Exp Year</label>
          <input type="number" name="exp_year" min="2024" max="2099" placeholder="YYYY" required
                 style="width:100%;padding:11px 14px;border-radius:10px;background:#080d1a;border:1px solid rgba(255,255,255,0.1);color:#e9eef8;">
        </div>
        <div>
          <label style="display:block;font-size:.7rem;color:#8a93a8;font-weight:700;letter-spacing:.06em;text-transform:uppercase;margin-bottom:5px;">Attach to child (optional)</label>
          <select name="child_student_id" style="width:100%;padding:11px 14px;border-radius:10px;background:#080d1a;border:1px solid rgba(255,255,255,0.1);color:#e9eef8;">
            <option value="">— Any of my children —</option>
            <% _myChildren.forEach(function(ch){ %>
              <option value="<%= ch.student_id %>"><%= ch.first_name %> <%= ch.last_name %></option>
            <% }); %>
          </select>
        </div>
      </div>
      <label style="display:flex;align-items:center;gap:8px;color:#e9eef8;font-size:.85rem;margin-bottom:14px;cursor:pointer;">
        <input type="checkbox" name="set_default" value="1" style="width:16px;height:16px;accent-color:#00D4AA;">
        Make this my default payment card
      </label>
      <div style="display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:10px;">
        <span style="font-size:.72rem;color:#8a93a8;display:inline-flex;align-items:center;gap:5px;">
          <svg width="11" height="11" viewBox="0 0 24 24" fill="currentColor"><path d="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4z"/></svg>
          We store only the last 4 digits — your full PAN is never saved.
        </span>
        <button type="submit" style="background:linear-gradient(135deg,#00D4AA,#00b693);color:#062018;border:none;padding:10px 18px;border-radius:10px;font-weight:800;cursor:pointer;letter-spacing:.04em;font-size:.85rem;">
          🔒 Save Card Securely
        </button>
      </div>
    </form>

    <div style="margin-top:18px;text-align:center;">
      <a href="/guardian/paygira" style="color:#00D4AA;text-decoration:none;font-weight:600;font-size:.9rem;">
        Go to PayGira to pay a bill →
      </a>
    </div>
  </div>
  <!-- ==================== /PayGira Cards & Billing ==================== -->
</div>

<script>
function updateStudentPreview() {
  const select = document.getElementById('studentSelect');
  const uploadSection = document.getElementById('studentImageUpload');
  const preview = document.getElementById('studentImagePreview');
  const info = document.getElementById('studentImageInfo');
  
  if (select.value) {
    const selectedOption = select.options[select.selectedIndex];
    const imageUrl = selectedOption.dataset.image;
    
    preview.src = imageUrl;
    info.textContent = `Current image for ${selectedOption.text}`;
    uploadSection.style.display = 'block';
  } else {
    uploadSection.style.display = 'none';
    preview.src = '/images/profilePlaceholder.png';
    info.textContent = 'Select a student to see their current image';
  }
}
</script>
