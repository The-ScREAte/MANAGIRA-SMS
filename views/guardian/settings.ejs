<style>
  .settings-container {
    max-width: 800px;
    margin: 0 auto;
    padding: 24px;
  }

  .settings-header {
    background: linear-gradient(135deg, #0f5a66 0%, #6fd3c4 100%);
    color: white;
    padding: 28px;
    border-radius: 12px;
    margin-bottom: 28px;
    box-shadow: 0 4px 12px rgba(15, 90, 102, 0.15);
  }

  .settings-header h1 {
    margin: 0 0 8px 0;
    font-size: 26px;
    font-weight: 700;
  }

  .settings-header p {
    margin: 0;
    opacity: 0.95;
    font-size: 14px;
  }

  .settings-form-card {
    background: white;
    border-radius: 12px;
    padding: 28px;
    box-shadow: 0 2px 8px rgba(0,0,0,0.08);
    border: 1px solid #e2e8f0;
  }

  .form-section {
    margin-bottom: 28px;
  }

  .form-section-title {
    font-size: 18px;
    font-weight: 700;
    color: #1e293b;
    margin: 0 0 16px 0;
    padding-bottom: 12px;
    border-bottom: 2px solid #e2e8f0;
  }

  .form-row {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 20px;
    margin-bottom: 20px;
  }

  .form-field {
    margin-bottom: 0;
  }

  .form-label {
    display: block;
    font-weight: 600;
    color: #475569;
    margin-bottom: 8px;
    font-size: 14px;
  }

  .form-input {
    width: 100%;
    padding: 12px 16px;
    border: 2px solid #e2e8f0;
    border-radius: 8px;
    font-size: 15px;
    transition: all 0.3s ease;
  }

  .form-input:focus {
    outline: none;
    border-color: #6fd3c4;
    box-shadow: 0 0 0 3px rgba(111, 211, 196, 0.1);
  }

  .form-actions {
    display: flex;
    gap: 12px;
    margin-top: 28px;
    padding-top: 20px;
    border-top: 2px solid #e2e8f0;
  }

  .btn-primary {
    padding: 14px 28px;
    background: linear-gradient(135deg, #0f5a66 0%, #6fd3c4 100%);
    color: white;
    border: none;
    border-radius: 8px;
    font-weight: 600;
    font-size: 15px;
    cursor: pointer;
    transition: all 0.3s ease;
    box-shadow: 0 2px 4px rgba(15, 90, 102, 0.2);
  }

  .btn-primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 12px rgba(15, 90, 102, 0.3);
  }

  .btn-secondary {
    padding: 14px 28px;
    background: white;
    color: #475569;
    border: 2px solid #e2e8f0;
    border-radius: 8px;
    font-weight: 600;
    font-size: 15px;
    text-decoration: none;
    cursor: pointer;
    transition: all 0.3s ease;
    display: inline-block;
  }

  .btn-secondary:hover {
    background: #f8fafc;
    border-color: #cbd5e1;
  }

  @media (max-width: 768px) {
    .settings-container {
      padding: 16px;
    }

    .settings-header {
      padding: 20px;
    }

    .settings-header h1 {
      font-size: 22px;
    }

    .settings-form-card {
      padding: 20px;
    }

    .form-row {
      grid-template-columns: 1fr;
      gap: 16px;
    }

    .form-actions {
      flex-direction: column;
    }

    .btn-primary, .btn-secondary {
      width: 100%;
      text-align: center;
    }
  }
</style>

<div class="settings-container">
  <div class="settings-header">
    <h1>⚙️ Account Settings</h1>
    <p>Update your profile information and contact details</p>
  </div>

  <div class="settings-form-card">
    <form action="/guardian/settings" method="POST">
      <div class="form-section">
        <h2 class="form-section-title">Personal Information</h2>
        
        <div class="form-row">
          <div class="form-field">
            <label class="form-label">First Name *</label>
            <input 
              type="text" 
              name="firstName" 
              class="form-input" 
              value="<%= guardian.first_name %>" 
              required
            />
          </div>

          <div class="form-field">
            <label class="form-label">Last Name</label>
            <input 
              type="text" 
              name="lastName" 
              class="form-input" 
              value="<%= guardian.last_name || '' %>"
            />
          </div>
        </div>
      </div>

      <div class="form-section">
        <h2 class="form-section-title">Contact Information</h2>
        
        <div class="form-row">
          <div class="form-field">
            <label class="form-label">Email Address *</label>
            <input 
              type="email" 
              name="email" 
              class="form-input" 
              value="<%= guardian.email || guardian.login_email || '' %>" 
              required
            />
          </div>

          <div class="form-field">
            <label class="form-label">Phone Number *</label>
            <input 
              type="text" 
              name="phone" 
              class="form-input" 
              value="<%= guardian.phone || guardian.login_phone || '' %>" 
              required
            />
          </div>
        </div>
      </div>

      <div class="form-section">
        <h2 class="form-section-title">Location</h2>
        
        <div class="form-field" style="margin-bottom: 20px;">
          <label class="form-label">Address</label>
          <input 
            type="text" 
            name="address" 
            class="form-input" 
            value="<%= guardian.address || '' %>"
          />
        </div>

        <div class="form-field">
          <label class="form-label">Hometown</label>
          <input 
            type="text" 
            name="hometown" 
            class="form-input" 
            value="<%= guardian.hometown || '' %>"
          />
        </div>
      </div>

      <div class="form-actions">
        <button type="submit" class="btn-primary">💾 Save Changes</button>
        <a href="/guardian/dashboard" class="btn-secondary">Cancel</a>
      </div>
    </form>
  </div>
</div>
