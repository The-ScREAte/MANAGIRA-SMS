<div class="student-management-system">
  <h1><%= student.first_name %> <%= student.last_name %> — Progress</h1>

  <div style="display:flex; gap:12px; align-items:center; margin-bottom:18px;">
    <% var img = '/images/profilePlaceholder.png'; %>
    <% if (student.image_url && student.image_url !== 'profilePlaceholder.png') { %>
      <% if (student.image_url.indexOf('http') === 0 || student.image_url.indexOf('/') === 0) { %>
        <% img = student.image_url; %>
      <% } else { %>
        <% img = '/' + student.image_url; %>
      <% } %>
    <% } %>
    <img src="<%= img %>" style="width:70px;height:70px;border-radius:50%;object-fit:cover;" />
    <div>
      <div style="font-weight:700;"><%= student.class_name || 'No class' %></div>
      <div style="color:#64748b;">Graduation Group: <%= (student.grad_year_group_name || 'N/A') %></div>
    </div>
  </div>

  <form method="GET" action="/guardian/student" style="margin-bottom:18px;">
    <input type="hidden" name="studentId" value="<%= student.student_id %>" />
    <label class="form-label">Select Term</label>
    <select class="form-input form-select" name="termId" onchange="this.form.submit()">
      <% terms.forEach(t => { %>
        <option value="<%= t.term_id %>" <%= String(t.term_id)===String(selectedTermId) ? 'selected' : '' %>>
          <%= t.term_name %>
        </option>
      <% }) %>
    </select>
  </form>

  <div class="student-form-card" style="max-width:none;">
    <h3 style="margin-top:0;">Teachers</h3>
    <% if (mainTeacher) { %>
      <p><strong>Main Teacher:</strong> <%= mainTeacher.first_name %> <%= mainTeacher.last_name %> (<%= mainTeacher.email || 'no email' %>)</p>
    <% } %>
  </div>

  <div class="student-form-card" style="max-width:none; margin-top:16px;">
    <h3 style="margin-top:0;">Subject Scores</h3>

    <% if (!subjects.length) { %>
      <p>No subjects found.</p>
    <% } %>

    <div style="overflow:auto;">
      <table style="width:100%; border-collapse:collapse;">
        <thead>
          <tr>
            <th style="text-align:left; padding:10px; border-bottom:1px solid #e2e8f0;">Subject</th>
            <th style="text-align:right; padding:10px; border-bottom:1px solid #e2e8f0;">Score</th>
            <th style="text-align:right; padding:10px; border-bottom:1px solid #e2e8f0;">Out Of</th>
            <th style="text-align:right; padding:10px; border-bottom:1px solid #e2e8f0;">% / Grade</th>
            <th style="text-align:right; padding:10px; border-bottom:1px solid #e2e8f0;">Position</th>
          </tr>
        </thead>
        <tbody>
          <% subjects.forEach(s => { %>
            <tr>
              <td style="padding:10px; border-bottom:1px solid #f1f5f9;"><%= s.subject_name %></td>
              <td style="padding:10px; border-bottom:1px solid #f1f5f9; text-align:right;"><%= s.totalScore.toFixed(1) %></td>
              <td style="padding:10px; border-bottom:1px solid #f1f5f9; text-align:right;"><%= s.totalMaxScore.toFixed(1) %></td>
              <td style="padding:10px; border-bottom:1px solid #f1f5f9; text-align:right;">
                <%= (s.totalPercentage !== null ? s.totalPercentage.toFixed(1) + '%' : '-') %>
                <%= (s.grade ? ' / ' + s.grade : '') %>
              </td>
              <td style="padding:10px; border-bottom:1px solid #f1f5f9; text-align:right;"><%= s.position %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>

  <div style="margin-top:16px;">
    <a class="secondary-button" href="/guardian/dashboard">Back to Children</a>
  </div>
</div>
