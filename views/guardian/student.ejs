<style>
  .progress-container {
    max-width: 1000px;
    margin: 0 auto;
    padding: 20px;
  }

  .progress-header {
    background: var(--guardian-gradient, linear-gradient(135deg, #0f5a66 0%, #6fd3c4 100%));
    color: white;
    padding: 24px;
    border-radius: 12px;
    margin-bottom: 24px;
    box-shadow: 0 4px 12px rgba(15, 90, 102, 0.15);
  }

  .progress-header h1 {
    margin: 0 0 16px;
    font-size: 1.5rem;
    font-weight: 700;
  }

  .student-info-row {
    display: flex;
    gap: 16px;
    align-items: center;
  }

  .student-avatar {
    width: 80px;
    height: 80px;
    border-radius: 50%;
    object-fit: cover;
    border: 3px solid white;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.15);
  }

  .student-meta {
    flex: 1;
  }

  .student-meta .class-name {
    font-weight: 700;
    font-size: 1.1rem;
    margin-bottom: 4px;
  }

  .student-meta .grad-group {
    opacity: 0.9;
    font-size: 0.9rem;
  }

  .student-meta .student-id-text {
    margin-top: 6px;
    font-size: 0.9rem;
    font-weight: 600;
    opacity: 0.96;
  }

  .content-card {
    background: white;
    border: 1px solid var(--guardian-border, #e2e8f0);
    border-radius: 12px;
    padding: 24px;
    margin-bottom: 20px;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);
  }

  .content-card h3 {
    margin: 0 0 16px;
    color: var(--guardian-text-primary, #1e293b);
    font-size: 1.1rem;
    font-weight: 600;
    padding-bottom: 12px;
    border-bottom: 2px solid var(--guardian-primary, #0f5a66);
  }

  .term-selector {
    margin-bottom: 24px;
  }

  .term-selector select {
    width: 100%;
    max-width: 300px;
    padding: 12px 16px;
    border: 2px solid var(--guardian-border, #e2e8f0);
    border-radius: 8px;
    font-size: 0.9rem;
    font-family: inherit;
    background: white;
    cursor: pointer;
    transition: all 0.2s;
  }

  .term-selector select:focus {
    outline: none;
    border-color: var(--guardian-primary-light, #6fd3c4);
    box-shadow: 0 0 0 3px rgba(111, 211, 196, 0.1);
  }

  .scores-table {
    width: 100%;
    border-collapse: collapse;
    overflow: hidden;
    border-radius: 8px;
  }

  .scores-table th,
  .scores-table td {
    padding: 14px 16px;
    text-align: left;
    border-bottom: 1px solid var(--guardian-border, #e2e8f0);
  }

  .scores-table th {
    background: var(--guardian-bg-secondary, #f8fafc);
    font-weight: 600;
    color: var(--guardian-text-secondary, #64748b);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .scores-table td {
    color: var(--guardian-text-primary, #1e293b);
    font-size: 0.9rem;
  }

  .schedule-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 14px;
  }

  .schedule-day-card {
    border: 1px solid var(--guardian-border, #e2e8f0);
    border-radius: 12px;
    overflow: hidden;
    background: var(--guardian-bg-secondary, #f8fafc);
  }

  .schedule-day-card h4 {
    margin: 0;
    padding: 12px 14px;
    background: rgba(15, 90, 102, 0.08);
    color: var(--guardian-text-primary, #1e293b);
    border-bottom: 1px solid var(--guardian-border, #e2e8f0);
    font-size: 0.95rem;
  }

  .schedule-day-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .schedule-day-list li {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    padding: 12px 14px;
    border-bottom: 1px solid var(--guardian-border, #e2e8f0);
  }

  .schedule-day-list li:last-child {
    border-bottom: none;
  }

  .schedule-time {
    font-weight: 700;
    color: var(--guardian-text-primary, #1e293b);
    white-space: nowrap;
  }

  .schedule-subject {
    color: var(--guardian-text-secondary, #64748b);
    text-align: right;
  }

  .schedule-empty {
    color: var(--guardian-text-secondary, #64748b);
    margin: 0;
  }

  .scores-table tbody tr:hover {
    background: var(--guardian-bg-secondary, #f8fafc);
  }

  .scores-table td:not(:first-child) {
    text-align: right;
  }

  .scores-table th:not(:first-child) {
    text-align: right;
  }

  .back-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 12px 24px;
    background: white;
    color: var(--guardian-text-secondary, #64748b);
    border: 2px solid var(--guardian-border, #e2e8f0);
    border-radius: 10px;
    text-decoration: none;
    font-weight: 600;
    font-size: 0.9rem;
    transition: all 0.2s;
  }

  .back-btn:hover {
    background: var(--guardian-bg-secondary, #f8fafc);
    border-color: var(--guardian-border-hover, #cbd5e1);
  }

  @media (max-width: 768px) {
    .progress-container {
      padding: 16px;
    }

    .progress-header {
      padding: 20px;
    }

    .progress-header h1 {
      font-size: 1.25rem;
    }

    .student-info-row {
      flex-direction: column;
      text-align: center;
    }

    .content-card {
      padding: 16px;
    }

    .scores-table {
      display: block;
      overflow-x: auto;
    }

    .scores-table th,
    .scores-table td {
      padding: 10px 12px;
      font-size: 0.85rem;
    }

    .schedule-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 480px) {
    .progress-container {
      padding: 12px;
    }

    .student-avatar {
      width: 60px;
      height: 60px;
    }
  }
</style>

<div class="progress-container">
  <div class="progress-header">
    <h1><%= student.first_name %> <%= student.last_name %> — Progress</h1>
    <div class="student-info-row">
      <% var img = '/images/profilePlaceholder.png'; %>
      <% if (student.image_url && student.image_url !== 'profilePlaceholder.png') { %>
        <% if (student.image_url.indexOf('http') === 0 || student.image_url.indexOf('/') === 0) { %>
          <% img = student.image_url; %>
        <% } else { %>
          <% img = '/' + student.image_url; %>
        <% } %>
      <% } %>
      <img src="<%= img %>" alt="<%= student.first_name %>" class="student-avatar" />
      <div class="student-meta">
        <div class="class-name"><%= student.class_name || 'No class assigned' %></div>
        <div class="grad-group">Graduation Group: <%= (student.grad_year_group_name || 'N/A') %></div>
        <div class="student-id-text">Student ID: <%= student.display_student_id || student.student_id %></div>
      </div>
    </div>
  </div>

  <div class="content-card term-selector">
    <form method="GET" action="/guardian/student">
      <input type="hidden" name="studentId" value="<%= student.student_id %>" />
      <label style="display: block; font-weight: 600; color: #64748b; margin-bottom: 8px; font-size: 0.875rem;">Select Term</label>
      <select name="termId" onchange="this.form.submit()">
        <% terms.forEach(t => { %>
          <option value="<%= t.term_id %>" <%= String(t.term_id)===String(selectedTermId) ? 'selected' : '' %>>
            <%= t.term_name %>
          </option>
        <% }) %>
      </select>
    </form>
  </div>

  <div class="content-card">
    <h3>👨‍🏫 Teachers</h3>
    <% if (mainTeacher) { %>
      <p style="margin: 0; color: #475569;"><strong>Main Teacher:</strong> <%= mainTeacher.first_name %> <%= mainTeacher.last_name %> (<%= mainTeacher.email || 'no email' %>)</p>
    <% } else { %>
      <p style="margin: 0; color: #94a3b8;">No main teacher assigned.</p>
    <% } %>
  </div>

  <div class="content-card">
    <h3>📊 Subject Scores</h3>

    <% if (!subjects.length) { %>
      <p style="color: #94a3b8; text-align: center; padding: 20px;">No subjects found for this term.</p>
    <% } else { %>
      <div style="overflow: auto;">
        <table class="scores-table">
          <thead>
            <tr>
              <th>Subject</th>
              <th>Score</th>
              <th>Out Of</th>
              <th>% / Grade</th>
              <th>Position</th>
            </tr>
          </thead>
          <tbody>
            <% subjects.forEach(s => { %>
              <tr>
                <td><%= s.subject_name %></td>
                <td><%= s.totalScore.toFixed(1) %></td>
                <td><%= s.totalMaxScore.toFixed(1) %></td>
                <td>
                  <%= (s.totalPercentage !== null ? s.totalPercentage.toFixed(1) + '%' : '-') %>
                  <%= (s.grade ? ' / ' + s.grade : '') %>
                </td>
                <td><%= s.position %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } %>
  </div>

  <div class="content-card">
    <h3>🗓️ Class Schedule</h3>
    <% if (classSchedule && classSchedule.groupedByDay.some(day => day.items.length)) { %>
      <p style="margin: 0 0 16px; color: #64748b;"><%= classSchedule.schoolYearLabel %> · <%= classSchedule.termName %></p>
      <div class="schedule-grid">
        <% classSchedule.groupedByDay.forEach(day => { %>
          <% if (day.items.length) { %>
          <section class="schedule-day-card">
            <h4><%= day.dayLabel %></h4>
            <ul class="schedule-day-list">
              <% day.items.forEach(item => { %>
              <li>
                <span class="schedule-time"><%= item.startTime %> - <%= item.endTime %></span>
                <span class="schedule-subject"><%= item.subjectName || 'Subject pending' %></span>
              </li>
              <% }) %>
            </ul>
          </section>
          <% } %>
        <% }) %>
      </div>
    <% } else { %>
      <p class="schedule-empty">The timetable for this term has not been added yet.</p>
    <% } %>
  </div>

  <a class="back-btn" href="/guardian/dashboard">← Back to Dashboard</a>
</div>
