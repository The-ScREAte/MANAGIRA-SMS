<%
  const _q = 'studentId=' + child.id;
  const _due = (d) => d ? new Date(d).toLocaleString('en-US', { month: 'short', day: 'numeric', hour: 'numeric', minute: '2-digit' }) : '';
  const _day = (d) => new Date(d + 'T12:00:00Z');
  const _clock = (t) => t ? new Date('2000-01-01T' + t + ':00Z').toLocaleTimeString('en-US', { hour: 'numeric', minute: '2-digit', timeZone: 'UTC' }) : '';
  const _when = (row) => row.endDate ? 'Until ' + _day(row.endDate).toLocaleDateString('en-US', { month: 'short', day: 'numeric', timeZone: 'UTC' }) : (row.startTime ? _clock(row.startTime) + (row.endTime ? ' – ' + _clock(row.endTime) : '') : 'All day');
  const _activity = (row) => { %>
    <article class="ph-row">
      <span class="ph-date"><small><%= _day(row.date).toLocaleDateString('en-US', { month: 'short', timeZone: 'UTC' }) %></small><strong><%= _day(row.date).getUTCDate() %></strong></span>
      <div class="ph-row__text">
        <strong><%= row.title %></strong>
        <small><%= [_when(row), row.location].filter(Boolean).join(' · ') %></small>
        <% if (row.details) { %><p><%= row.details %></p><% } %>
      </div>
    </article>
  <% };
%>
<link rel="stylesheet" href="<%= assetUrl('/css/parentHub.css') %>" />
<div class="ph">
  <%- include('../partials/flash') %>
  <a class="ph-back" href="/guardian/child?<%= _q %>"><%= child.name %></a>
  <h1 class="ph-title"><%= title %></h1>

  <% if (mode === 'schedule') { %>
    <% if (days.length) { %>
      <div class="ph-week">
        <% days.forEach((day) => { %>
          <section class="ph-card">
            <h2><%= day.dayLabel %></h2>
            <ul class="ph-periods">
              <% day.items.forEach((item) => { %>
                <li>
                  <span class="ph-periods__time"><%= item.startTime %><% if (item.endTime) { %> – <%= item.endTime %><% } %></span>
                  <span class="ph-periods__what"><strong><%= item.subjectName || item.customLabel || 'Class' %></strong></span>
                </li>
              <% }) %>
            </ul>
          </section>
        <% }) %>
      </div>
    <% } else { %>
      <p class="ph-empty">No schedule yet.</p>
    <% } %>
  <% } %>

  <% if (mode === 'activities') { %>
    <% if (coming.length) { %><div class="ph-list"><% coming.forEach(_activity); %></div><% } else { %><p class="ph-empty">No activities coming up.</p><% } %>
    <% if (past.length) { %>
      <details class="ph-past"><summary>Past (<%= past.length %>)</summary><div class="ph-list"><% past.forEach(_activity); %></div></details>
    <% } %>
  <% } %>

  <% if (mode === 'work') { %>
    <% if (work.length) { %>
      <div class="ph-list">
        <% work.forEach((row) => { %>
          <a class="ph-row ph-row--link" href="/guardian/child/work/<%= row.setId %>?<%= _q %>">
            <div class="ph-row__text">
              <strong><%= row.title %></strong>
              <small><%= [row.subject, row.questions + (row.questions === 1 ? ' question' : ' questions')].filter(Boolean).join(' · ') %></small>
              <% if (row.due) { %><small class="ph-due">Closes <%= _due(row.due) %></small><% } %>
            </div>
            <span class="ph-chev" aria-hidden="true">›</span>
          </a>
        <% }) %>
      </div>
    <% } else { %>
      <p class="ph-empty">Nothing open right now.</p>
    <% } %>
  <% } %>

  <% if (mode === 'documents') { %>
    <% if (files.length) { %>
      <div class="ph-list">
        <% files.forEach((file) => { %>
          <a class="ph-row ph-row--link" href="/guardian/child/file/<%= file.id %>?<%= _q %>" target="_blank" rel="noopener" data-no-spa>
            <span class="ph-file"><%- navIcon('docs') %></span>
            <div class="ph-row__text">
              <strong><%= file.name %></strong>
              <small><%= [file.subject, file.title].filter(Boolean).join(' · ') %></small>
            </div>
          </a>
        <% }) %>
      </div>
    <% } else { %>
      <p class="ph-empty">No documents yet.</p>
    <% } %>
  <% } %>
</div>
