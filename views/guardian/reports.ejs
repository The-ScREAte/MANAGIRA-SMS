<style>
  .reports-container {
    max-width: 1080px;
    margin: 0 auto;
    padding: 18px 16px 28px;
  }

  .reports-hero {
    border-radius: 20px;
    padding: 20px;
    margin-bottom: 16px;
    color: #fff;
    background:
      radial-gradient(circle at 15% 25%, rgba(255,255,255,0.18), transparent 36%),
      linear-gradient(135deg, var(--primary, #0f5a66) 0%, var(--primary, #0f5a66) 100%);
    box-shadow: 0 14px 36px rgba(15, 23, 42, 0.22);
  }

  .reports-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 14px;
    flex-wrap: wrap;
    gap: 10px;
  }

  .reports-header h1 {
    font-size: clamp(1.35rem, 2.8vw, 1.9rem);
    color: #fff;
    margin: 0;
    font-weight: 750;
    letter-spacing: -0.02em;
  }

  .reports-subtitle {
    margin: 5px 0 0;
    font-size: 0.9rem;
    color: rgba(255,255,255,0.88);
  }

  .btn-new-report {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: #fff;
    color: var(--primary, #0f5a66);
    padding: 10px 16px;
    border-radius: 12px;
    border: 1px solid rgba(255,255,255,0.4);
    font-weight: 700;
    font-size: 0.85rem;
    cursor: pointer;
    transition: transform 0.16s, box-shadow 0.16s;
  }

  .btn-new-report:hover {
    transform: translateY(-1px);
    box-shadow: 0 8px 22px rgba(2, 6, 23, 0.22);
  }

  .reports-summary {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 10px;
  }

  .mobile-collapse {
    margin: 0;
  }

  .mobile-collapse summary {
    list-style: none;
    cursor: pointer;
  }

  .mobile-collapse summary::-webkit-details-marker {
    display: none;
  }

  .mobile-collapse-summary {
    display: none;
  }

  .summary-pill {
    background: rgba(255,255,255,0.14);
    border: 1px solid rgba(255,255,255,0.28);
    border-radius: 12px;
    padding: 9px 10px;
  }

  .summary-pill strong {
    display: block;
    font-size: 1.25rem;
    line-height: 1;
    letter-spacing: -0.02em;
  }

  .summary-pill span {
    display: block;
    margin-top: 3px;
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    opacity: 0.86;
    font-weight: 700;
  }

  .reports-toolbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    margin-bottom: 14px;
    flex-wrap: wrap;
  }

  .toolbar-search {
    flex: 1;
    min-width: 220px;
    max-width: 430px;
    position: relative;
  }

  .toolbar-search input {
    width: 100%;
    border: 1px solid #d2dce7;
    border-radius: 12px;
    padding: 10px 12px;
    font-size: 0.87rem;
    color: #1e293b;
    background: #fff;
  }

  .toolbar-search input:focus {
    outline: none;
    border-color: var(--primary, #0f5a66);
    box-shadow: 0 0 0 4px rgba(15, 90, 102, 0.12);
  }

  .toolbar-status {
    border: 1px solid #d2dce7;
    border-radius: 12px;
    padding: 10px 12px;
    min-width: 160px;
    font-size: 0.86rem;
    color: #1e293b;
    background: #fff;
  }

  .reports-list {
    display: grid;
    gap: 11px;
  }

  .report-card {
    background: #fff;
    border: 1px solid #d8e1ea;
    border-radius: 14px;
    padding: 16px;
    text-decoration: none;
    display: flex;
    justify-content: space-between;
    align-items: center;
    color: inherit;
    transition: border-color 0.2s, box-shadow 0.2s, transform 0.2s;
    gap: 12px;
  }

  .report-card:hover {
    border-color: #9db7cc;
    box-shadow: 0 10px 28px rgba(15, 23, 42, 0.10);
    transform: translateY(-1px);
  }

  .report-left { flex: 1; min-width: 0; }

  .report-subject {
    font-size: 1rem;
    font-weight: 700;
    color: #0f172a;
    margin: 0 0 5px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .report-meta { display: flex; gap: 12px; font-size: 0.79rem; color: #64748b; flex-wrap: wrap; }
  .report-right { display: flex; align-items: center; gap: 9px; flex-shrink: 0; flex-wrap: wrap; justify-content: flex-end; }

  .status-badge {
    padding: 4px 10px;
    border-radius: 999px;
    font-size: 0.69rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    white-space: nowrap;
  }

  .status-open { background: #fef3c7; color: #d97706; }
  .status-in_progress { background: #dbeafe; color: #2563eb; }
  .status-resolved { background: #d1fae5; color: #059669; }
  .status-closed { background: #f3f4f6; color: #6b7280; }
  .reply-count { font-size: 0.76rem; color: #64748b; white-space: nowrap; font-weight: 600; }
  .unread-badge { background: #0f5a66; color: #fff; border-radius: 999px; padding: 4px 10px; font-size: 0.69rem; font-weight: 700; white-space: nowrap; text-transform: uppercase; letter-spacing: 0.06em; }

  .report-row { position: relative; }
  .report-row .report-card { margin-bottom: 0; padding-right: 38px; }

  .report-menu-wrap { position: absolute; top: 10px; right: 10px; z-index: 10; }
  .report-menu-btn {
    background: none; border: none; cursor: pointer;
    width: 28px; height: 28px; border-radius: 6px;
    display: flex; align-items: center; justify-content: center;
    color: #94a3b8; font-size: 1.1rem; letter-spacing: 1px; line-height: 1;
    transition: background 0.15s, color 0.15s;
  }
  .report-menu-btn:hover { background: #f1f5f9; color: #475569; }
  .report-menu-dropdown {
    display: none; position: absolute; top: 32px; right: 0;
    background: #fff; border: 1px solid #e2e8f0; border-radius: 8px;
    box-shadow: 0 4px 16px rgba(0,0,0,0.10); min-width: 130px; overflow: hidden;
    z-index: 20;
  }
  .report-menu-wrap.open .report-menu-dropdown { display: block; }
  .report-menu-dropdown button {
    width: 100%; background: none; border: none; text-align: left;
    padding: 10px 14px; font-size: 0.82rem; cursor: pointer;
    color: #e74c3c; display: flex; align-items: center; gap: 8px;
  }
  .report-menu-dropdown button:hover { background: #fff5f5; }
  .delete-report-form { margin: 0; }

  .empty-state { text-align: center; padding: 48px 20px; border: 2px dashed #cbd5e1; border-radius: 14px; background: #fff; }
  .empty-state-icon { font-size: 40px; margin-bottom: 10px; display: block; }
  .empty-state h3 { color: #64748b; font-size: 1rem; margin: 0 0 6px; }
  .empty-state p { color: #94a3b8; font-size: 0.85rem; margin: 0 0 14px; }

  .reports-count-note {
    font-size: 0.8rem;
    color: #64748b;
    margin-left: auto;
    font-weight: 600;
  }

  /* Modal */
  .modal-overlay { display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.45); z-index: 13000; justify-content: center; align-items: flex-start; padding: calc(env(safe-area-inset-top, 0px) + 96px) 16px 20px; overflow-y: auto; }
  .modal-overlay.active { display: flex; }
  .modal-box { background: #fff; border-radius: 10px; width: 100%; max-width: 560px; max-height: calc(100dvh - (env(safe-area-inset-top, 0px) + 124px)); overflow-y: auto; padding: 24px; box-shadow: 0 10px 40px rgba(0,0,0,0.2); position: relative; }
  .modal-box h2 { font-size: 1.15rem; margin: 0 0 18px; color: #1e293b; }
  .modal-close { position: absolute; top: 14px; right: 16px; background: none; border: none; font-size: 1.3rem; cursor: pointer; color: #94a3b8; line-height: 1; }
  .modal-close:hover { color: #1e293b; }
  .fg { margin-bottom: 14px; }
  .fg label { display: block; font-weight: 600; font-size: 0.82rem; color: #334155; margin-bottom: 4px; }
  .fg label .req { color: #e74c3c; }
  .fg select, .fg input, .fg textarea { width: 100%; padding: 8px 10px; border: 1px solid #d1d5db; border-radius: 6px; font-size: 0.85rem; font-family: inherit; box-sizing: border-box; }
  .fg textarea { min-height: 80px; resize: vertical; }
  .fg select:focus, .fg input:focus, .fg textarea:focus { outline: none; border-color: var(--primary, #27ae60); }
  .cc-box { background: #f8fafc; padding: 12px; border-radius: 6px; margin-bottom: 14px; }
  .cc-box h4 { font-size: 0.85rem; margin: 0 0 4px; color: #334155; }
  .cc-box p { font-size: 0.75rem; color: #94a3b8; margin: 0 0 8px; }
  .staff-list { max-height: 180px; overflow-y: auto; border: 1px solid #e2e8f0; border-radius: 6px; padding: 6px; background: #fff; }
  .staff-item { display: flex; align-items: center; padding: 5px 6px; gap: 8px; font-size: 0.82rem; }
  .staff-item input[type="checkbox"] { width: auto; margin: 0; }
  .staff-role { color: #94a3b8; font-size: 0.75rem; }
  .staff-badge { font-size: 0.68rem; padding: 1px 6px; border-radius: 8px; margin-left: 4px; font-weight: 600; background: #d1fae5; color: #059669; }
  .staff-loading { text-align: center; padding: 14px; color: #94a3b8; font-size: 0.82rem; }
  .modal-actions { display: flex; gap: 10px; justify-content: flex-end; margin-top: 16px; }
  .btn-submit { background: var(--primary, #27ae60); color: #fff; padding: 8px 20px; border: none; border-radius: 6px; font-weight: 600; font-size: 0.85rem; cursor: pointer; }
  .btn-submit:hover { background: var(--primary-hover, #229954); }
  .btn-cancel { background: #e2e8f0; color: #475569; padding: 8px 20px; border: none; border-radius: 6px; font-weight: 500; font-size: 0.85rem; cursor: pointer; }
  .btn-cancel:hover { background: #cbd5e1; }

  @media (max-width: 920px) {
    .reports-summary {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (min-width: 641px) {
    .mobile-collapse > :not(summary) {
      display: block !important;
    }

    .mobile-collapse-summary {
      display: none !important;
    }
  }

  @media (max-width: 640px) {
    .reports-container { padding: 12px 10px 22px; }
    .reports-hero { padding: 16px; border-radius: 14px; }
    .reports-header { flex-direction: column; align-items: stretch; }
    .btn-new-report { justify-content: center; }
    .mobile-collapse {
      margin-top: 10px;
      border: 1px solid rgba(255,255,255,0.32);
      border-radius: 12px;
      background: rgba(255,255,255,0.08);
      overflow: hidden;
    }
    .mobile-collapse-summary {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 8px;
      width: 100%;
      padding: 11px 12px;
      font-size: 0.8rem;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      font-weight: 700;
      color: #fff;
    }
    .mobile-collapse-summary::after {
      content: '+';
      font-size: 1rem;
      line-height: 1;
    }
    .mobile-collapse[open] .mobile-collapse-summary::after {
      content: '-';
    }
    .mobile-collapse-content {
      padding: 0 10px 10px;
    }
    .reports-summary {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .reports-toolbar {
      flex-direction: column;
      align-items: stretch;
      margin: 0;
      background: #fff;
      border: 1px solid #d8e1ea;
      border-radius: 12px;
      padding: 10px;
    }
    .toolbar-search { max-width: none; }
    .reports-count-note { margin-left: 0; }
    .report-card { flex-direction: column; align-items: flex-start; }
    .report-right { width: 100%; justify-content: space-between; }
    .modal-overlay { padding: calc(env(safe-area-inset-top, 0px) + 92px) 10px 14px; }
    .modal-box { padding: 18px; }
    .fg select,
    .fg input,
    .fg textarea {
      font-size: 16px;
    }
  }
</style>

<%
  const reportRows = Array.isArray(reports) ? reports : [];
  const statusTotals = reportRows.reduce(function(acc, row) {
    const key = String(row.status || 'open');
    acc.total += 1;
    if (key === 'open') acc.open += 1;
    if (key === 'in_progress') acc.inProgress += 1;
    if (key === 'resolved') acc.resolved += 1;
    if (key === 'closed') acc.closed += 1;
    acc.unread += Number(row.unread_count || 0);
    return acc;
  }, { total: 0, open: 0, inProgress: 0, resolved: 0, closed: 0, unread: 0 });
%>

<div class="reports-container">
  <div class="reports-hero">
    <div class="reports-header">
      <div>
        <h1>Guardian Reports</h1>
        <p class="reports-subtitle">Track conversations with school staff and submit new concerns quickly.</p>
      </div>
      <button class="btn-new-report" onclick="openModal()">+ New Report</button>
    </div>

    <details class="mobile-collapse">
      <summary class="mobile-collapse-summary">Quick Overview</summary>
      <div class="mobile-collapse-content">
        <div class="reports-summary">
          <div class="summary-pill"><strong><%= statusTotals.total %></strong><span>Total</span></div>
          <div class="summary-pill"><strong><%= statusTotals.open %></strong><span>Open</span></div>
          <div class="summary-pill"><strong><%= statusTotals.inProgress %></strong><span>In Progress</span></div>
          <div class="summary-pill"><strong><%= statusTotals.resolved %></strong><span>Resolved</span></div>
          <div class="summary-pill"><strong><%= statusTotals.unread %></strong><span>Unread</span></div>
        </div>
      </div>
    </details>
  </div>

  <details class="mobile-collapse">
    <summary class="mobile-collapse-summary" style="color:#0f172a; background:#fff; border-bottom:1px solid #e2e8f0;">Search & Filter</summary>
    <div class="mobile-collapse-content" style="padding: 10px 0 0;">
      <div class="reports-toolbar">
        <div class="toolbar-search">
          <input id="reportSearchInput" type="text" placeholder="Search by subject or student name" />
        </div>
        <select id="reportStatusFilter" class="toolbar-status">
          <option value="all">All statuses</option>
          <option value="open">Open</option>
          <option value="in_progress">In Progress</option>
          <option value="resolved">Resolved</option>
          <option value="closed">Closed</option>
        </select>
        <span class="reports-count-note" id="reportsVisibleCount">Showing <%= reportRows.length %> of <%= reportRows.length %></span>
      </div>
    </div>
  </details>

  <% if (reportRows.length > 0) { %>
    <div class="reports-list" id="reportsList">
    <% reportRows.forEach(function(report) { %>
      <div class="report-row" data-report-row data-status="<%= report.status %>" data-search="<%= String((report.subject || '') + ' ' + (report.student_name || '')).toLowerCase() %>">
        <a href="/guardian/reports/<%= report.report_id %>" class="report-card">
          <div class="report-left">
            <h3 class="report-subject"><%= report.subject %></h3>
            <div class="report-meta">
              <span><%= report.student_name %></span>
              <span><%= (typeof formatDisplayDate === 'function' ? formatDisplayDate(report.created_at) : new Date(report.created_at).toLocaleDateString()) %></span>
            </div>
          </div>
          <div class="report-right">
            <span class="status-badge status-<%= report.status %>"><%= report.status.replace('_', ' ') %></span>
            <% if (Number(report.unread_count) > 0) { %>
              <span class="unread-badge"><%= report.unread_count %> unread</span>
            <% } %>
            <span class="reply-count"><%= report.reply_count %> <%= report.reply_count === '1' ? 'reply' : 'replies' %></span>
          </div>
        </a>
        <div class="report-menu-wrap" id="menu-<%= report.report_id %>">
          <button type="button" class="report-menu-btn" onclick="toggleReportMenu('<%= report.report_id %>')" title="Options">&#8942;</button>
          <div class="report-menu-dropdown">
            <form action="/guardian/reports/<%= report.report_id %>/delete" method="POST" class="delete-report-form" onsubmit="return confirm('Delete this report and all replies? This cannot be undone.')">
              <button type="submit">&#128465; Delete</button>
            </form>
          </div>
        </div>
      </div>
    <% }); %>
    </div>
    <div class="empty-state" id="reportsNoMatch" style="display:none; margin-top: 10px;">
      <span class="empty-state-icon">🔎</span>
      <h3>No matching reports.</h3>
      <p>Try a different search word or status.</p>
    </div>
  <% } else { %>
    <div class="empty-state">
      <span class="empty-state-icon">📋</span>
      <h3>No reports yet.</h3>
      <p>Submit a report to communicate with school staff.</p>
    </div>
  <% } %>
</div>

<!-- New Report Modal -->
<div class="modal-overlay" id="reportModal">
  <div class="modal-box">
    <button class="modal-close" onclick="closeModal()">&times;</button>
    <h2>Submit a Report</h2>
    <form action="/guardian/reports/create" method="POST">
      <div class="fg">
        <label>Student <span class="req">*</span></label>
        <select name="student_id" id="modalStudentId" required>
          <option value="">-- Choose student --</option>
          <% students.forEach(function(s) { %>
            <option value="<%= s.student_id %>"><%= (s.display_name || (typeof formatDisplayName === 'function' ? formatDisplayName(s) : [s.first_name, s.last_name].filter(Boolean).join(' ').trim())) %><% if (s.class_name) { %> (<%= s.class_name %>)<% } %></option>
          <% }); %>
        </select>
      </div>
      <div class="fg">
        <label>Subject <span class="req">*</span></label>
        <input type="text" name="subject" placeholder="e.g. Attendance Issue" required maxlength="255">
      </div>
      <div class="fg">
        <label>Priority <span class="req">*</span></label>
        <select name="priority" required>
          <option value="normal" selected>Normal</option>
          <option value="high">High</option>
          <option value="urgent">Urgent</option>
          <option value="low">Low</option>
        </select>
      </div>
      <div class="fg">
        <label>Message <span class="req">*</span></label>
        <textarea name="message" placeholder="Describe your concern..." required></textarea>
      </div>
      <div class="cc-box">
        <h4>CC Staff Members</h4>
        <p>Select a student above to see available staff</p>
        <div class="staff-list" id="modalStaffList">
          <div class="staff-loading">Select a student first</div>
        </div>
      </div>
      <div class="modal-actions">
        <button type="button" class="btn-cancel" onclick="closeModal()">Cancel</button>
        <button type="submit" class="btn-submit">Submit Report</button>
      </div>
    </form>
  </div>
</div>

<script>
  function openModal() { document.getElementById('reportModal').classList.add('active'); }
  function closeModal() { document.getElementById('reportModal').classList.remove('active'); }
  document.getElementById('reportModal').addEventListener('click', function(e) { if (e.target === this) closeModal(); });

  function toggleReportMenu(id) {
    var wrap = document.getElementById('menu-' + id);
    var isOpen = wrap.classList.contains('open');
    // close all
    document.querySelectorAll('.report-menu-wrap.open').forEach(function(el) { el.classList.remove('open'); });
    if (!isOpen) wrap.classList.add('open');
  }
  // close menus on outside click
  document.addEventListener('click', function(e) {
    if (!e.target.closest('.report-menu-wrap')) {
      document.querySelectorAll('.report-menu-wrap.open').forEach(function(el) { el.classList.remove('open'); });
    }
  });

  document.getElementById('modalStudentId').addEventListener('change', function() {
    var sid = this.value, list = document.getElementById('modalStaffList');
    if (!sid) { list.innerHTML = '<div class="staff-loading">Select a student first</div>'; return; }
    list.innerHTML = '<div class="staff-loading">Loading...</div>';
    fetch('/guardian/reports/student-staff?studentId=' + encodeURIComponent(sid))
      .then(function(r) { return r.json(); })
      .then(function(d) {
        if (!d.success || !d.staff || !d.staff.length) { list.innerHTML = '<div class="staff-loading">No staff available for this student.</div>'; return; }
        var h = '';
        d.staff.forEach(function(p) {
          var badge = p.is_class_teacher ? '<span class="staff-badge">Class Teacher</span>' : '';
          h += '<div class="staff-item"><input type="checkbox" name="cc_recipients" value="' + p.user_id + '" id="ms_' + p.user_id + '"' + (p.is_class_teacher ? ' checked' : '') + '><label for="ms_' + p.user_id + '">' + p.first_name + ' ' + p.last_name + ' <span class="staff-role">(' + p.role + ')</span>' + badge + '</label></div>';
        });
        list.innerHTML = h;
      })
      .catch(function() { list.innerHTML = '<div class="staff-loading" style="color:#e74c3c;">Failed to load staff</div>'; });
  });

  (function setupReportFilters() {
    var searchInput = document.getElementById('reportSearchInput');
    var statusFilter = document.getElementById('reportStatusFilter');
    var rows = Array.prototype.slice.call(document.querySelectorAll('[data-report-row]'));
    var noMatch = document.getElementById('reportsNoMatch');
    var counter = document.getElementById('reportsVisibleCount');
    if (!searchInput || !statusFilter || !counter || !rows.length) return;

    function applyFilters() {
      var text = String(searchInput.value || '').trim().toLowerCase();
      var status = statusFilter.value;
      var visible = 0;

      rows.forEach(function(row) {
        var rowSearch = row.getAttribute('data-search') || '';
        var rowStatus = row.getAttribute('data-status') || '';
        var matchText = !text || rowSearch.indexOf(text) !== -1;
        var matchStatus = status === 'all' || rowStatus === status;
        var show = matchText && matchStatus;
        row.style.display = show ? '' : 'none';
        if (show) visible += 1;
      });

      counter.textContent = 'Showing ' + visible + ' of ' + rows.length;
      if (noMatch) noMatch.style.display = visible === 0 ? '' : 'none';
    }

    searchInput.addEventListener('input', applyFilters);
    statusFilter.addEventListener('change', applyFilters);
    applyFilters();
  })();
</script>
