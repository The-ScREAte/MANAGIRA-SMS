<%- include('../layout', { body: `
<style>
  .reports-container {
    max-width: 900px;
    margin: 0 auto;
    padding: 20px;
  }
  
  .reports-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 25px;
    flex-wrap: wrap;
    gap: 15px;
  }
  
  .reports-header h1 {
    font-size: 1.75rem;
    color: var(--guardian-text-primary, #1e293b);
    margin: 0;
    font-weight: 700;
  }
  
  .btn-new-report {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: linear-gradient(135deg, var(--org-primary-color, #0f5a66) 0%, var(--org-primary-hover, #6fd3c4) 100%);
    color: white;
    padding: 12px 24px;
    border-radius: 10px;
    text-decoration: none;
    font-weight: 600;
    font-size: 0.9rem;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.15);
    transition: all 0.2s ease;
  }
  
  .btn-new-report:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 16px rgba(15, 90, 102, 0.3);
  }
  
  .report-card {
    background: var(--guardian-bg-primary, white);
    border: 1px solid var(--guardian-border, #e2e8f0);
    border-radius: 12px;
    padding: 20px;
    margin-bottom: 16px;
    transition: all 0.2s ease;
    text-decoration: none;
    display: block;
    color: inherit;
  }
  
  .report-card:hover {
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.1);
    border-color: var(--guardian-primary, #0f5a66);
    transform: translateY(-2px);
  }
  
  .report-header-info {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 12px;
  }
  
  .report-subject {
    font-size: 1.1rem;
    font-weight: 600;
    color: var(--guardian-text-primary, #1e293b);
    margin: 0 0 6px 0;
  }
  
  .report-meta {
    display: flex;
    gap: 16px;
    font-size: 0.85rem;
    color: var(--guardian-text-secondary, #64748b);
    margin-bottom: 10px;
    flex-wrap: wrap;
  }
  
  .report-message-preview {
    color: var(--guardian-text-secondary, #64748b);
    font-size: 0.9rem;
    line-height: 1.6;
    margin: 12px 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  
  .report-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: 16px;
    padding-top: 16px;
    border-top: 1px solid var(--guardian-border, #e2e8f0);
  }
  
  .status-badge {
    padding: 6px 14px;
    border-radius: 20px;
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  
  .status-open {
    background: #fef3c7;
    color: #d97706;
  }
  
  .status-in_progress {
    background: #dbeafe;
    color: #2563eb;
  }
  
  .status-resolved {
    background: #d1fae5;
    color: #059669;
  }
  
  .status-closed {
    background: #f3f4f6;
    color: #6b7280;
  }
  
  .reply-count {
    font-size: 0.85rem;
    color: var(--guardian-text-muted, #94a3b8);
    display: flex;
    align-items: center;
    gap: 4px;
  }
  
  .empty-state {
    text-align: center;
    padding: 60px 24px;
    background: linear-gradient(to bottom, var(--guardian-bg-secondary, #f8fafc), var(--guardian-bg-primary, white));
    border-radius: 16px;
    border: 2px dashed var(--guardian-border-hover, #cbd5e1);
  }
  
  .empty-state-icon {
    font-size: 56px;
    margin-bottom: 16px;
    display: block;
  }
  
  .empty-state h3 {
    color: var(--guardian-text-secondary, #64748b);
    font-size: 1.125rem;
    margin: 0 0 8px;
    font-weight: 600;
  }
  
  .empty-state p {
    color: var(--guardian-text-muted, #94a3b8);
    font-size: 0.9rem;
    margin: 0 0 20px;
    line-height: 1.5;
  }
  
  @media (max-width: 768px) {
    .reports-container {
      padding: 16px;
    }
    
    .reports-header {
      flex-direction: column;
      align-items: stretch;
    }
    
    .reports-header h1 {
      font-size: 1.5rem;
    }
    
    .btn-new-report {
      text-align: center;
      justify-content: center;
    }
    
    .report-meta {
      flex-direction: column;
      gap: 6px;
    }
    
    .report-footer {
      flex-direction: column;
      gap: 12px;
      align-items: flex-start;
    }
  }
  
  @media (max-width: 480px) {
    .reports-container {
      padding: 12px;
    }
    
    .report-card {
      padding: 16px;
    }
    
    .report-subject {
      font-size: 1rem;
    }
  }
</style>

<div class="reports-container">
  <div class="reports-header">
    <h1>📋 My Reports</h1>
    <a href="/guardian/reports/new" class="btn-new-report">➕ Submit New Report</a>
  </div>
  
  <% if (reports && reports.length > 0) { %>
    <% reports.forEach(report => { %>
      <a href="/guardian/reports/<%= report.report_id %>" class="report-card">
        <div class="report-header-info">
          <div>
            <h3 class="report-subject"><%= report.subject %></h3>
            <div class="report-meta">
              <span>📚 <%= report.student_name %></span>
              <span>📅 <%= new Date(report.created_at).toLocaleDateString() %></span>
            </div>
          </div>
        </div>
        
        <div class="report-message-preview">
          <%= report.message %>
        </div>
        
        <div class="report-footer">
          <span class="status-badge status-<%= report.status %>">
            <%= report.status.replace('_', ' ') %>
          </span>
          <span class="reply-count">
            💬 <%= report.reply_count %> <%= report.reply_count === '1' ? 'reply' : 'replies' %>
          </span>
        </div>
      </a>
    <% }); %>
  <% } else { %>
    <div class="empty-state">
      <span class="empty-state-icon">📋</span>
      <h3>No reports yet</h3>
      <p>Submit your first report to communicate with the school staff about your child's progress</p>
      <a href="/guardian/reports/new" class="btn-new-report">➕ Submit Report</a>
    </div>
  <% } %>
</div>
` }); %>
