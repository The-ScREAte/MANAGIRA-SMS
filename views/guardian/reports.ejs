<%- include('../layout', { body: `
<style>
  .reports-container {
    max-width: 900px;
    margin: 0 auto;
    padding: 20px;
  }
  
  .reports-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 25px;
  }
  
  .reports-header h1 {
    font-size: 28px;
    color: #2c3e50;
    margin: 0;
  }
  
  .btn-new-report {
    background: #27ae60;
    color: white;
    padding: 12px 24px;
    border-radius: 6px;
    text-decoration: none;
    font-weight: 500;
    transition: background 0.2s;
  }
  
  .btn-new-report:hover {
    background: #229954;
  }
  
  .report-card {
    background: white;
    border: 1px solid #e0e0e0;
    border-radius: 8px;
    padding: 20px;
    margin-bottom: 15px;
    transition: box-shadow 0.2s;
    text-decoration: none;
    display: block;
    color: inherit;
  }
  
  .report-card:hover {
    box-shadow: 0 2px 8px rgba(0,0,0,0.1);
  }
  
  .report-header-info {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 12px;
  }
  
  .report-subject {
    font-size: 18px;
    font-weight: 600;
    color: #2c3e50;
    margin: 0 0 5px 0;
  }
  
  .report-meta {
    display: flex;
    gap: 15px;
    font-size: 14px;
    color: #7f8c8d;
    margin-bottom: 10px;
  }
  
  .report-message-preview {
    color: #555;
    font-size: 14px;
    line-height: 1.5;
    margin: 10px 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  
  .report-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: 12px;
    padding-top: 12px;
    border-top: 1px solid #f0f0f0;
  }
  
  .status-badge {
    padding: 4px 12px;
    border-radius: 12px;
    font-size: 12px;
    font-weight: 600;
    text-transform: uppercase;
  }
  
  .status-open {
    background: #fef5e7;
    color: #f39c12;
  }
  
  .status-in_progress {
    background: #ebf5fb;
    color: #3498db;
  }
  
  .status-resolved {
    background: #eafaf1;
    color: #27ae60;
  }
  
  .status-closed {
    background: #f4f6f7;
    color: #7f8c8d;
  }
  
  .reply-count {
    font-size: 13px;
    color: #7f8c8d;
  }
  
  .empty-state {
    text-align: center;
    padding: 60px 20px;
    color: #7f8c8d;
  }
  
  .empty-state i {
    font-size: 48px;
    margin-bottom: 15px;
    display: block;
  }
  
  @media (max-width: 768px) {
    .reports-header {
      flex-direction: column;
      gap: 15px;
      align-items: stretch;
    }
    
    .btn-new-report {
      text-align: center;
    }
  }
</style>

<div class="reports-container">
  <div class="reports-header">
    <h1>My Reports</h1>
    <a href="/guardian/reports/new" class="btn-new-report">+ Submit New Report</a>
  </div>
  
  <% if (reports && reports.length > 0) { %>
    <% reports.forEach(report => { %>
      <a href="/guardian/reports/<%= report.report_id %>" class="report-card">
        <div class="report-header-info">
          <div>
            <h3 class="report-subject"><%= report.subject %></h3>
            <div class="report-meta">
              <span>📚 <%= report.student_name %></span>
              <span>📅 <%= new Date(report.created_at).toLocaleDateString() %></span>
            </div>
          </div>
        </div>
        
        <div class="report-message-preview">
          <%= report.message %>
        </div>
        
        <div class="report-footer">
          <span class="status-badge status-<%= report.status %>">
            <%= report.status.replace('_', ' ') %>
          </span>
          <span class="reply-count">
            <%= report.reply_count %> <%= report.reply_count === '1' ? 'reply' : 'replies' %>
          </span>
        </div>
      </a>
    <% }); %>
  <% } else { %>
    <div class="empty-state">
      <i>📋</i>
      <h3>No reports yet</h3>
      <p>Submit your first report to communicate with the school staff</p>
      <a href="/guardian/reports/new" class="btn-new-report" style="display: inline-block; margin-top: 15px;">Submit Report</a>
    </div>
  <% } %>
</div>
` }); %>
