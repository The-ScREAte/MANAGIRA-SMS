    width:16px;
    height:16px;
    accent-color:var(--pg-teal);
    cursor:pointer;
    margin-top:0;
  }
  .pg-occ-card-copy {
    display:flex;
    align-items:center;
    gap:10px;
    min-width:0;
    flex-wrap:nowrap;
  }
  .pg-occ-date {
    font-weight:700;
    font-size:.88rem;
    white-space:nowrap;
  }
  .pg-occ-meta {
    color:var(--pg-muted);
    font-size:.72rem;
    margin-top:0;
    white-space:nowrap;
  }
  .pg-occ-tag {
    color:var(--pg-gold);
    font-size:.68rem;
    font-weight:700;
    text-transform:uppercase;
    letter-spacing:.05em;
  }
