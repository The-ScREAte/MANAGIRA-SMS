<%
  const currencyCode = (financeCurrency && financeCurrency.code) ? financeCurrency.code : 'USD';
  const money = typeof formatMoney === 'function'
    ? formatMoney
    : function(v){ return Number(v||0).toLocaleString(undefined,{minimumFractionDigits:2,maximumFractionDigits:2}); };
  function billedTotal(a){ return Math.max(Number(a.scheduled_billed_total ?? a.amount ?? 0), 0); }
  function balance(a){ return Math.max(billedTotal(a) + Number(a.late_fee_applied||0) - Number(a.amount_paid||0), 0); }
  function statusClass(s){ return ({paid:'paid',partial:'partial',overdue:'overdue',pending:'pending'})[s||'pending']; }
%>

<style>
  :root {
    --pg-bg:        #0f1728;
    --pg-surface:   #162238;
    --pg-surface-2: #1b2942;
    --pg-border:    rgba(255,255,255,.12);
    --pg-text:      #f1f5ff;
    --pg-muted:     #b6c2d9;
    --pg-teal:      #00D4AA;
    --pg-gold:      #F5C842;
    --pg-red:       #FF4D6D;
    --pg-org:       var(--org-primary-color, #01535b);
    --pg-org-hover: var(--org-primary-hover, #014a51);
  }

  .pg-wrap {
    background:var(--pg-bg);
    color:var(--pg-text);
    min-height:calc(100vh - 80px);
    font-family:'Space Grotesk','DM Sans',system-ui,sans-serif;
    padding:clamp(30px, 5vw, 48px) clamp(12px, 2.5vw, 20px) 64px;
  }
  .pg-container { max-width:1200px; margin:0 auto; }

  .pg-head {
    display:flex; justify-content:space-between; align-items:flex-start;
    gap:16px; flex-wrap:wrap; margin-bottom:22px;
  }
  .pg-head h1 {
    margin:0; font-size:2.1rem; font-weight:800; letter-spacing:-.02em;
    font-family:'Space Grotesk',sans-serif;
  }
  .pg-head h1 .accent { color:var(--pg-teal); font-style:italic; }
  .pg-head p { margin:8px 0 0; color:var(--pg-muted); font-size:.92rem; max-width:56ch; line-height:1.55; }

  .paygira-secure-badge {
    display:inline-flex; align-items:center; gap:6px;
    padding:8px 14px; border-radius:999px;
    background:rgba(0,212,170,.08);
    border:1px solid rgba(0,212,170,.26);
    color:var(--pg-teal);
    font-size:.72rem; font-weight:700; letter-spacing:.08em;
    text-transform:uppercase;
    font-family:'Space Grotesk',sans-serif;
    white-space:nowrap;
  }

  .pg-stats { display:grid; grid-template-columns:repeat(auto-fit, minmax(210px, 1fr)); gap:12px; margin-bottom:24px; }
  .pg-stat {
    background:var(--pg-surface);
    border:1px solid var(--pg-border); border-radius:14px; padding:16px 18px;
  }
  .pg-stat .label { font-size:.72rem; color:var(--pg-muted); text-transform:uppercase; letter-spacing:.08em; font-weight:600; }
  .pg-stat .value { font-size:1.55rem; font-weight:800; margin-top:6px; font-family:'JetBrains Mono',monospace; }
  .pg-stat .sub   { font-size:.75rem; color:var(--pg-muted); margin-top:4px; }
  .pg-stat.teal .value { color:var(--pg-teal); }
  .pg-stat.gold .value { color:var(--pg-gold); }
  .pg-stat.red  .value { color:var(--pg-red); }

  .pg-section-title {
    font-size:.92rem; font-weight:700; letter-spacing:.04em;
    text-transform:uppercase; color:var(--pg-muted);
    margin:32px 0 14px;
  }

  .pg-child-card {
    background:var(--pg-surface);
    border:1px solid var(--pg-border);
    border-radius:16px;
    overflow:hidden;
    margin-bottom:18px;
  }
  .pg-child-head {
    display:flex; align-items:center; gap:14px;
    padding:18px 22px; border-bottom:1px solid var(--pg-border);
    background:rgba(255,255,255,.02);
  }
  .pg-child-avatar {
    width:48px; height:48px; border-radius:50%; object-fit:cover;
    border:1px solid rgba(0,212,170,.32);
    background:var(--pg-surface-2);
  }
  .pg-child-name { font-weight:700; font-size:1.05rem; }
  .pg-child-meta { color:var(--pg-muted); font-size:.8rem; }

  .pg-child-copy { min-width:0; }

  .pg-bill-row {
    display:grid; grid-template-columns: minmax(0, 1.6fr) minmax(88px, .8fr) minmax(88px, .8fr) minmax(116px, 1fr) auto;
    gap:12px; align-items:center;
    padding:16px 22px; border-bottom:1px solid var(--pg-border);
    cursor:pointer; transition:background .15s;
  }
  .pg-bill-row:hover { background:rgba(255,255,255,.03); }
  .pg-bill-row:last-child { border-bottom:none; }
  .pg-bill-title { font-weight:600; }
  .pg-bill-sub {
    color:var(--pg-muted);
    font-size:.77rem;
    margin-top:3px;
    line-height:1.45;
    display:-webkit-box;
    -webkit-line-clamp:2;
    -webkit-box-orient:vertical;
    overflow:hidden;
  }
  .pg-amount { font-family:'JetBrains Mono',monospace; font-weight:600; }
  .pg-balance { font-family:'JetBrains Mono',monospace; font-weight:700; color:var(--pg-gold); }
  .pg-bill-col { min-width:0; }
  .pg-bill-actions {
    display:flex;
    align-items:center;
    justify-content:flex-end;
    gap:8px;
    flex-wrap:nowrap;
  }
  /* Keep the Pay + Invoice buttons the same height so they sit on one line. */
  .pg-bill-actions .pg-btn { min-height:36px; }
  .pg-bill-actions .pg-btn.sm { min-height:36px; padding:0 14px; font-size:.78rem; }

  .pg-status {
    display:inline-block; padding:3px 10px; border-radius:999px;
    font-size:.66rem; font-weight:700; letter-spacing:.06em; text-transform:uppercase;
  }
  .pg-status.paid    { background:rgba(0,212,170,.15);  color:var(--pg-teal);   border:1px solid rgba(0,212,170,.3); }
  .pg-status.partial { background:rgba(245,200,66,.15); color:var(--pg-gold);   border:1px solid rgba(245,200,66,.3); }
  .pg-status.overdue { background:rgba(255,77,109,.15); color:var(--pg-red);    border:1px solid rgba(255,77,109,.3); }
  .pg-status.pending { background:rgba(138,147,168,.15);color:var(--pg-muted);  border:1px solid rgba(138,147,168,.3); }

  .pg-btn {
    display:inline-flex; align-items:center; justify-content:center; gap:6px;
    min-height:38px; padding:0 12px; border-radius:4px;
    font-size:.82rem; font-weight:600; cursor:pointer;
    border:1px solid transparent; transition:all .15s;
    text-decoration:none;
    background:var(--pg-org);
    color:#fff;
    white-space:nowrap;
  }
  .pg-btn.primary { background:var(--pg-org); color:#fff; }
  .pg-btn.primary:hover { transform:none; box-shadow:none; background:var(--pg-org-hover); }
  .pg-btn.ghost { background:var(--pg-org); color:#fff; border:1px solid transparent; }
  .pg-btn.ghost:hover { background:var(--pg-org-hover); }
  .pg-btn.sm { min-height:32px; padding:0 10px; font-size:.74rem; }
  .pg-btn.danger { background:var(--pg-red); color:#fff; border-color:transparent; }
  .pg-btn.danger::before { content:'🗑'; font-size:.82em; }
  .pg-btn:disabled { opacity:.4; cursor:not-allowed; }

  .pg-flash { padding:12px 18px; border-radius:12px; margin-bottom:18px; font-weight:600; font-size:.9rem; }
  .pg-flash.success { background:rgba(0,212,170,.12); color:var(--pg-teal); border:1px solid rgba(0,212,170,.3); }
  .pg-flash.error   { background:rgba(255,77,109,.12); color:var(--pg-red);  border:1px solid rgba(255,77,109,.3); }

  .pg-empty { text-align:center; padding:48px 20px; color:var(--pg-muted); }
  .pg-modal-bg {
    display:none; position:fixed; inset:0; background:rgba(0,0,0,.78);
    z-index:1000; align-items:flex-start; justify-content:center;
    padding:clamp(72px,11vh,90px) 12px 32px; overflow-y:auto;
  }
  .pg-modal-bg.open { display:flex; }
  .pg-modal {
    background:var(--pg-surface); border:1px solid var(--pg-border); border-radius:16px;
    padding:22px; max-width:520px; width:100%; color:var(--pg-text); box-shadow:0 20px 48px rgba(0,0,0,.32);
  }
  .pg-modal h3 { margin:0 0 18px; font-size:1.2rem; }
  .pg-form-grid { display:grid; grid-template-columns:repeat(2,1fr); gap:10px 12px; }
  .pg-form-grid .span2 { grid-column:1 / -1; }
  .pg-field { margin-bottom:0; }
  .pg-field label { display:block; font-size:.78rem; color:var(--pg-muted); margin-bottom:6px; font-weight:600; letter-spacing:.04em; text-transform:uppercase; }
  .pg-field input, .pg-field select {
    width:100%; padding:10px 12px; border-radius:9px;
    background:var(--pg-bg); border:1px solid var(--pg-border); color:var(--pg-text);
    font-family:inherit; font-size:1rem;
  }
  .pg-field input, .pg-field select { min-height:38px; border-radius:4px; font-size:.9rem; }
  .pg-field input:disabled { background:rgba(255,255,255,.04); color:var(--pg-text); }
  .pg-field input:focus, .pg-field select:focus { outline:none; border-color:var(--pg-teal); }
  .pg-modal-actions { display:flex; gap:8px; justify-content:flex-end; flex-wrap:nowrap; margin-top:18px; overflow-x:auto; }
  .pg-recurring-panel {
    border:1px solid rgba(0,212,170,.22);
    background:rgba(0,212,170,.06);
    border-radius:16px;
    padding:16px;
  }
  .pg-recurring-toolbar {
    display:grid;
    grid-template-columns:minmax(0, 1fr) auto;
    align-items:center;
    gap:12px;
    margin-bottom:12px;
  }
  .pg-recurring-summary {
    color:var(--pg-text);
    font-size:.82rem;
    font-weight:700;
    min-height:44px;
    padding:10px 14px;
    border-radius:14px;
    border:1px solid rgba(255,255,255,.08);
    background:rgba(8,13,26,.48);
    display:flex;
    align-items:center;
  }
  .pg-recurring-actions {
    display:flex;
    gap:8px;
    align-items:center;
    flex-wrap:nowrap;
  }
  .pg-recurring-list {
    display:grid;
    gap:10px;
    max-height:320px;
    overflow-y:auto;
    padding-right:2px;
  }
  .pg-occ-card {
    display:grid;
    grid-template-columns:16px minmax(0, 1fr) auto;
    align-items:center;
    gap:12px;
    padding:11px 13px;
