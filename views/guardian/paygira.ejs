<%
  const currencyCode = (financeCurrency && financeCurrency.code) ? financeCurrency.code : 'USD';
  const money = typeof formatMoney === 'function'
    ? formatMoney
    : function(v){ return Number(v||0).toLocaleString(undefined,{minimumFractionDigits:2,maximumFractionDigits:2}); };
  function billedTotal(a){ return Math.max(Number(a.scheduled_billed_total ?? a.amount ?? 0), 0); }
  function balance(a){ return Math.max(billedTotal(a) + Number(a.late_fee_applied||0) - Number(a.amount_paid||0), 0); }
  function statusClass(s){ return ({paid:'paid',partial:'partial',overdue:'overdue',pending:'pending'})[s||'pending']; }
%>

<style>
  :root {
    --pg-bg:        #080d1a;
    --pg-surface:   #0e1426;
    --pg-surface-2: #131b33;
    --pg-border:    rgba(255,255,255,.08);
    --pg-text:      #e9eef8;
    --pg-muted:     #8a93a8;
    --pg-teal:      #00D4AA;
    --pg-gold:      #F5C842;
    --pg-red:       #FF4D6D;
    --pg-purple:    #7B61FF;
  }

  .pg-wrap {
    background:var(--pg-bg);
    color:var(--pg-text);
    min-height:calc(100vh - 80px);
    font-family:'Space Grotesk','DM Sans',system-ui,sans-serif;
    padding:clamp(18px, 3vw, 32px) clamp(12px, 2.5vw, 20px) 64px;
  }
  .pg-container { max-width:1200px; margin:0 auto; }

  .pg-head {
    display:flex; justify-content:space-between; align-items:flex-start;
    gap:16px; flex-wrap:wrap; margin-bottom:28px;
  }
  .pg-head h1 {
    margin:0; font-size:2.1rem; font-weight:800; letter-spacing:-.02em;
    font-family:'Space Grotesk',sans-serif;
  }
  .pg-head h1 .accent { color:var(--pg-teal); font-style:italic; }
  .pg-head p { margin:6px 0 0; color:var(--pg-muted); font-size:.92rem; }

  .paygira-secure-badge {
    display:inline-flex; align-items:center; gap:6px;
    padding:8px 14px; border-radius:999px;
    background:linear-gradient(135deg, rgba(0,212,170,.18), rgba(0,212,170,.08));
    border:1px solid rgba(0,212,170,.45);
    color:var(--pg-teal);
    font-size:.72rem; font-weight:700; letter-spacing:.08em;
    text-transform:uppercase;
    font-family:'Space Grotesk',sans-serif;
    box-shadow:0 4px 18px rgba(0,212,170,.18);
    white-space:nowrap;
  }

  .pg-stats { display:grid; grid-template-columns:repeat(auto-fit, minmax(220px, 1fr)); gap:14px; margin-bottom:28px; }
  .pg-stat {
    background:linear-gradient(180deg, var(--pg-surface), var(--pg-surface-2));
    border:1px solid var(--pg-border); border-radius:16px; padding:18px 20px;
  }
  .pg-stat .label { font-size:.72rem; color:var(--pg-muted); text-transform:uppercase; letter-spacing:.08em; font-weight:600; }
  .pg-stat .value { font-size:1.7rem; font-weight:800; margin-top:6px; font-family:'JetBrains Mono',monospace; }
  .pg-stat .sub   { font-size:.75rem; color:var(--pg-muted); margin-top:4px; }
  .pg-stat.teal .value { color:var(--pg-teal); }
  .pg-stat.gold .value { color:var(--pg-gold); }
  .pg-stat.red  .value { color:var(--pg-red); }

  .pg-section-title {
    font-size:.92rem; font-weight:700; letter-spacing:.04em;
    text-transform:uppercase; color:var(--pg-muted);
    margin:32px 0 14px;
  }

  .pg-child-card {
    background:linear-gradient(180deg, var(--pg-surface), var(--pg-surface-2));
    border:1px solid var(--pg-border);
    border-radius:18px;
    overflow:hidden;
    margin-bottom:22px;
  }
  .pg-child-head {
    display:flex; align-items:center; gap:14px;
    padding:18px 22px; border-bottom:1px solid var(--pg-border);
    background:rgba(123,97,255,.05);
  }
  .pg-child-avatar {
    width:48px; height:48px; border-radius:50%; object-fit:cover;
    border:2px solid var(--pg-teal);
    background:var(--pg-surface-2);
  }
  .pg-child-name { font-weight:700; font-size:1.05rem; }
  .pg-child-meta { color:var(--pg-muted); font-size:.8rem; }

  .pg-child-copy { min-width:0; }

  .pg-bill-row {
    display:grid; grid-template-columns: 1.5fr 1fr 1fr 1fr auto;
    gap:14px; align-items:center;
    padding:14px 22px; border-bottom:1px solid var(--pg-border);
    cursor:pointer; transition:background .15s;
  }
  .pg-bill-row:hover { background:rgba(0,212,170,.04); }
  .pg-bill-row:last-child { border-bottom:none; }
  .pg-bill-title { font-weight:600; }
  .pg-bill-sub { color:var(--pg-muted); font-size:.78rem; margin-top:2px; }
  .pg-amount { font-family:'JetBrains Mono',monospace; font-weight:600; }
  .pg-balance { font-family:'JetBrains Mono',monospace; font-weight:700; color:var(--pg-gold); }
  .pg-bill-col { min-width:0; }
  .pg-bill-actions {
    display:flex;
    align-items:center;
    justify-content:flex-end;
    gap:6px;
    flex-wrap:wrap;
  }

  .pg-status {
    display:inline-block; padding:3px 10px; border-radius:999px;
    font-size:.66rem; font-weight:700; letter-spacing:.06em; text-transform:uppercase;
  }
  .pg-status.paid    { background:rgba(0,212,170,.15);  color:var(--pg-teal);   border:1px solid rgba(0,212,170,.3); }
  .pg-status.partial { background:rgba(245,200,66,.15); color:var(--pg-gold);   border:1px solid rgba(245,200,66,.3); }
  .pg-status.overdue { background:rgba(255,77,109,.15); color:var(--pg-red);    border:1px solid rgba(255,77,109,.3); }
  .pg-status.pending { background:rgba(138,147,168,.15);color:var(--pg-muted);  border:1px solid rgba(138,147,168,.3); }

  .pg-btn {
    display:inline-flex; align-items:center; gap:6px;
    padding:8px 14px; border-radius:10px;
    font-size:.78rem; font-weight:700; cursor:pointer;
    border:none; transition:all .15s;
    text-decoration:none;
  }
  .pg-btn.primary { background:linear-gradient(135deg, var(--pg-teal), #00b693); color:#062018; }
  .pg-btn.primary:hover { transform:translateY(-1px); box-shadow:0 6px 16px rgba(0,212,170,.3); }
  .pg-btn.ghost { background:transparent; color:var(--pg-text); border:1px solid var(--pg-border); }
  .pg-btn.ghost:hover { background:rgba(255,255,255,.05); }
  .pg-btn:disabled { opacity:.4; cursor:not-allowed; }

  .pg-flash { padding:12px 18px; border-radius:12px; margin-bottom:18px; font-weight:600; font-size:.9rem; }
  .pg-flash.success { background:rgba(0,212,170,.12); color:var(--pg-teal); border:1px solid rgba(0,212,170,.3); }
  .pg-flash.error   { background:rgba(255,77,109,.12); color:var(--pg-red);  border:1px solid rgba(255,77,109,.3); }

  .pg-empty { text-align:center; padding:48px 20px; color:var(--pg-muted); }
  .pg-empty .icon { font-size:3rem; margin-bottom:10px; }

  /* Modal */
  .pg-modal-bg {
    display:none; position:fixed; inset:0; background:rgba(0,0,0,.78);
    z-index:1000; align-items:center; justify-content:center; padding:12px; overflow-y:auto;
  }
  .pg-modal-bg.open { display:flex; }
  .pg-modal {
    background:var(--pg-surface); border:1px solid var(--pg-border); border-radius:16px;
    padding:20px; max-width:520px; width:100%; color:var(--pg-text);
    max-height:calc(100vh - 24px); overflow-y:auto;
  }
  .pg-modal h3 { margin:0 0 18px; font-size:1.2rem; }
  .pg-form-grid { display:grid; grid-template-columns:repeat(2,1fr); gap:10px 12px; }
  .pg-form-grid .span2 { grid-column:1 / -1; }
  .pg-field { margin-bottom:0; }
  .pg-field label { display:block; font-size:.78rem; color:var(--pg-muted); margin-bottom:6px; font-weight:600; letter-spacing:.04em; text-transform:uppercase; }
  .pg-field input, .pg-field select {
    width:100%; padding:9px 12px; border-radius:9px;
    background:var(--pg-bg); border:1px solid var(--pg-border); color:var(--pg-text);
    font-family:inherit; font-size:.88rem;
  }
  .pg-field input:disabled { background:rgba(255,255,255,.04); color:var(--pg-text); }
  .pg-field input:focus, .pg-field select:focus { outline:none; border-color:var(--pg-teal); }
  .pg-modal-actions { display:flex; gap:10px; justify-content:flex-end; margin-top:18px; }
  .pg-recurring-panel {
    border:1px solid rgba(0,212,170,.22);
    background:linear-gradient(180deg, rgba(0,212,170,.09), rgba(14,20,38,.92));
    border-radius:16px;
    padding:16px;
    box-shadow:inset 0 1px 0 rgba(255,255,255,.03);
  }
  .pg-recurring-caption {
    color:var(--pg-muted);
    font-size:.76rem;
    margin:-2px 0 12px;
  }
  .pg-recurring-toolbar {
    display:flex;
    align-items:stretch;
    justify-content:space-between;
    gap:12px;
    flex-wrap:wrap;
    margin-bottom:12px;
  }
  .pg-recurring-summary {
    color:var(--pg-text);
    font-size:.82rem;
    font-weight:700;
    padding:12px 14px;
    border-radius:14px;
    border:1px solid rgba(255,255,255,.08);
    background:rgba(8,13,26,.48);
    min-width:min(280px, 100%);
  }
  .pg-recurring-actions {
    display:flex;
    gap:8px;
    flex-wrap:wrap;
    align-items:center;
  }
  .pg-recurring-list {
    display:grid;
    gap:10px;
    max-height:320px;
    overflow-y:auto;
    padding-right:2px;
  }
  .pg-occ-card {
    display:flex;
    align-items:flex-start;
    gap:12px;
    padding:12px 13px;
    border:1px solid var(--pg-border);
    border-radius:14px;
    background:rgba(8,13,26,.72);
    cursor:pointer;
    transition:border-color .16s ease, transform .16s ease, background .16s ease;
  }
  .pg-occ-card:hover {
    border-color:rgba(0,212,170,.28);
    background:rgba(14,20,38,.92);
    transform:translateY(-1px);
  }
  .pg-occ-card input {
    width:16px;
    height:16px;
    accent-color:var(--pg-teal);
    cursor:pointer;
    margin-top:3px;
  }
  .pg-occ-card-copy {
    min-width:0;
    flex:1;
  }
  .pg-occ-date {
    font-weight:700;
    font-size:.88rem;
  }
  .pg-occ-meta {
    color:var(--pg-muted);
    font-size:.72rem;
    margin-top:2px;
  }
  .pg-occ-tag {
    color:var(--pg-gold);
    font-size:.68rem;
    font-weight:700;
    text-transform:uppercase;
    letter-spacing:.05em;
  }
  .pg-occ-tag.paid {
    color:#15803d;
  }
  .pg-occ-status {
    display:flex;
    align-items:center;
    gap:8px;
    flex-shrink:0;
  }
  .pg-occ-checkmark {
    width:22px;
    height:22px;
    border-radius:50%;
    display:inline-flex;
    align-items:center;
    justify-content:center;
    border:1px solid rgba(21,128,61,.35);
    background:rgba(21,128,61,.16);
    color:#15803d;
    font-size:.82rem;
    font-weight:800;
  }
  .pg-occ-tag.partial {
    color:#b45309;
  }
  .pg-occ-tag.owing {
    color:#b91c1c;
  }
  .pg-occ-card.disabled {
    opacity:.62;
    cursor:not-allowed;
  }
  .pg-occ-card.disabled input {
    cursor:not-allowed;
  }
  .pg-occ-amount {
    color:#d9f8f0;
    font-size:.72rem;
    margin-top:4px;
    font-weight:600;
  }
  .pg-pay-hint {
    display:block;
    color:var(--pg-muted);
    font-size:.72rem;
    margin-top:8px;
  }
  .pg-credit-box {
    border:1px solid rgba(0,212,170,.24);
    background:linear-gradient(180deg, rgba(0,212,170,.10), rgba(14,20,38,.88));
    border-radius:14px;
    padding:14px;
  }
  .pg-credit-value {
    font-family:'JetBrains Mono',monospace;
    font-size:1rem;
    font-weight:800;
    color:var(--pg-teal);
    margin-bottom:8px;
  }
  .pg-credit-toggle {
    display:flex;
    align-items:flex-start;
    gap:10px;
    color:var(--pg-text);
    font-size:.8rem;
    line-height:1.4;
  }
  .pg-credit-toggle input {
    margin-top:2px;
    accent-color:var(--pg-teal);
  }
  .pg-credit-note {
    color:var(--pg-muted);
    font-size:.72rem;
    margin-top:8px;
  }
  .pg-pay-mode-note {
    color:var(--pg-muted);
    font-size:.74rem;
    line-height:1.55;
  }
  .pg-method-chip-list {
    display:flex;
    flex-wrap:wrap;
    gap:8px;
    margin-top:10px;
  }
  .pg-method-chip {
    display:inline-flex;
    align-items:center;
    gap:6px;
    padding:6px 10px;
    border-radius:999px;
    border:1px solid rgba(0,212,170,.18);
    background:rgba(0,212,170,.08);
    color:#dffbf5;
    font-size:.7rem;
    font-weight:700;
    letter-spacing:.04em;
    text-transform:uppercase;
  }
  .pg-payment-shell {
    border:1px solid rgba(255,255,255,.08);
    background:rgba(8,13,26,.6);
    border-radius:16px;
    padding:14px;
  }
  .pg-payment-shell[hidden] {
    display:none !important;
  }
  .pg-stripe-shell {
    display:grid;
    gap:12px;
  }
  .pg-stripe-box {
    border:1px solid rgba(123,97,255,.2);
    background:linear-gradient(180deg, rgba(123,97,255,.08), rgba(8,13,26,.75));
    border-radius:14px;
    padding:14px;
  }
  .pg-stripe-box-title {
    font-weight:700;
    font-size:.86rem;
    margin-bottom:6px;
  }
  .pg-stripe-box-subtitle {
    color:var(--pg-muted);
    font-size:.74rem;
    line-height:1.5;
    margin-bottom:10px;
  }
  .pg-express-shell {
    display:none;
    border:1px dashed rgba(0,212,170,.2);
    border-radius:12px;
    padding:12px;
    background:rgba(0,212,170,.05);
  }
  .pg-express-shell.is-visible {
    display:block;
  }
  .pg-stripe-error {
    display:none;
    color:#ff9fb0;
    font-size:.76rem;
    line-height:1.45;
  }
  .pg-stripe-error.show {
    display:block;
  }
  .pg-stripe-test-note {
    color:var(--pg-muted);
    font-size:.72rem;
    line-height:1.5;
    border-top:1px solid rgba(255,255,255,.08);
    margin-top:12px;
    padding-top:12px;
  }
  .pg-offline-title {
    font-weight:700;
    font-size:.84rem;
    margin-bottom:6px;
  }
  .pg-offline-details {
    color:var(--pg-text);
    font-size:.8rem;
    line-height:1.55;
  }
  .pg-offline-details strong {
    color:#ffffff;
  }
  .pg-offline-details div + div {
    margin-top:4px;
  }

  .pg-history {
    background:var(--pg-surface); border:1px solid var(--pg-border); border-radius:14px;
    overflow:hidden;
  }
  .pg-history-row {
    display:grid; grid-template-columns: 1fr 1fr 1fr 1fr;
    gap:14px; padding:12px 18px;
    border-bottom:1px solid var(--pg-border); font-size:.85rem;
  }
  .pg-history-row.head { background:rgba(255,255,255,.03); color:var(--pg-muted); font-size:.72rem; text-transform:uppercase; letter-spacing:.06em; font-weight:700; }
  .pg-history-row:last-child { border-bottom:none; }

  @media (max-width:1080px) {
    .pg-stats { grid-template-columns:repeat(2, minmax(0, 1fr)); }
    .pg-bill-row {
      grid-template-columns: minmax(0, 1.5fr) repeat(3, minmax(92px, 1fr));
      align-items:start;
    }
    .pg-bill-actions {
      grid-column:1 / -1;
      justify-content:flex-start;
      padding-top:4px;
    }
  }

  @media (max-width:760px) {
    .pg-wrap { padding:14px 10px 40px; }
    .pg-head { align-items:flex-start; margin-bottom:20px; }
    .pg-head h1 { font-size:1.4rem; }
    .pg-head p { font-size:.84rem; max-width:40ch; }
    .paygira-secure-badge { font-size:.64rem; padding:7px 11px; }
    .pg-stats { grid-template-columns:1fr; }
    .pg-stat { padding:16px; }
    .pg-stat .value { font-size:1.35rem; }
    .pg-child-head {
      padding:14px;
      align-items:flex-start;
      flex-wrap:wrap;
    }
    .pg-bill-row {
      grid-template-columns:1fr;
      gap:10px;
      padding:14px;
    }
    .pg-bill-col {
      display:grid;
      grid-template-columns:minmax(78px, auto) 1fr;
      gap:10px;
      align-items:baseline;
    }
    .pg-bill-col::before {
      content:attr(data-label);
      color:var(--pg-muted);
      font-size:.68rem;
      letter-spacing:.05em;
      text-transform:uppercase;
      font-weight:700;
    }
    .pg-bill-col .pg-bill-sub {
      display:none;
    }
    .pg-bill-actions {
      grid-column:auto;
      padding-top:2px;
    }
    .pg-btn { justify-content:center; }
    .pg-history {
      padding:10px;
      display:grid;
      gap:10px;
      background:transparent;
      border:none;
    }
    .pg-history-row.head { display:none; }
    .pg-history-row {
      grid-template-columns:1fr 1fr;
      gap:10px 12px;
      font-size:.78rem;
      padding:12px;
      border:1px solid var(--pg-border);
      border-radius:14px;
      background:var(--pg-surface);
    }
    .pg-history-row > div::before {
      content:attr(data-label);
      display:block;
      margin-bottom:4px;
      color:var(--pg-muted);
      font-size:.66rem;
      letter-spacing:.06em;
      text-transform:uppercase;
      font-weight:700;
    }
    .pg-form-grid { grid-template-columns:1fr; }
    .pg-modal { padding:16px; }
    .pg-modal h3 {
      font-size:1rem;
      flex-wrap:wrap;
    }
    .pg-modal-actions {
      flex-direction:column-reverse;
      align-items:stretch;
    }
    .pg-modal-actions .pg-btn {
      width:100%;
      justify-content:center;
    }
    .pg-recurring-toolbar {
      align-items:stretch;
    }
  }

  @media (max-width:520px) {
    .pg-child-avatar {
      width:42px;
      height:42px;
    }
    .pg-child-name { font-size:.98rem; }
    .pg-child-meta { font-size:.76rem; }
    .pg-history-row { grid-template-columns:1fr; }
    .pg-bill-col {
      grid-template-columns:1fr;
      gap:3px;
    }
    .pg-bill-actions {
      flex-direction:column;
      align-items:stretch;
    }
    .pg-bill-actions .pg-btn {
      width:100%;
      margin-left:0 !important;
      justify-content:center;
    }
  }
</style>

<% if (allowedMethods && allowedMethods.stripeOn && pspSettings && pspSettings.stripe_publishable_key) { %>
  <script src="https://js.stripe.com/v3/"></script>
<% } %>

<div class="pg-wrap">
  <div class="pg-container">

    <div class="pg-head">
      <div>
        <h1>Pay<span class="accent">Gira</span></h1>
        <p>Welcome <%= guardian.first_name || 'Parent' %> — pay your child's school bills securely from one place.</p>
      </div>
      <span class="paygira-secure-badge" title="Bank-grade encrypted payments">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4z" fill="currentColor"/>
          <path d="M9 12l2 2 4-4" stroke="#080d1a" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        Secure
      </span>
    </div>

    <% if (messages && messages.success && messages.success.length) { %>
      <div class="pg-flash success"><%= messages.success[0] %></div>
    <% } %>
    <% if (messages && messages.error && messages.error.length) { %>
      <div class="pg-flash error"><%= messages.error[0] %></div>
    <% } %>

    <div class="pg-stats">
      <div class="pg-stat"><div class="label">Total Billed</div><div class="value"><%= money(totals.billed) %></div><div class="sub">Across all your children</div></div>
      <div class="pg-stat teal"><div class="label">Total Paid</div><div class="value"><%= money(totals.paid) %></div><div class="sub">Thank you</div></div>
      <div class="pg-stat gold"><div class="label">Outstanding</div><div class="value"><%= money(totals.outstanding) %></div><div class="sub">Pay now to stay current</div></div>
      <div class="pg-stat teal"><div class="label">Available Balance</div><div class="value"><%= money(totals.credit || 0) %></div><div class="sub"><%= Number(totals.credit || 0) > 0 ? (money(totals.net_outstanding || 0) + ' still due after balance') : 'No available balance yet' %></div></div>
      <div class="pg-stat"><div class="label">Saved Cards</div><div class="value"><%= cards.length %></div><div class="sub"><a href="/guardian/settings#cards" style="color:var(--pg-teal);text-decoration:none;">Manage in Settings →</a></div></div>
    </div>

    <% if (!children.length) { %>
      <div class="pg-child-card">
        <div class="pg-empty">
          <div class="icon">👨‍👩‍👧</div>
          <p>No linked students found. Contact your school to link your children.</p>
        </div>
      </div>
    <% } else { %>
      <% children.forEach(child => {
           const kidAssignments = assignments.filter(a => a.student_id === child.student_id);
      %>
        <div class="pg-child-card">
          <div class="pg-child-head">
            <img class="pg-child-avatar"
                 src="<%= child.image_url && child.image_url !== 'profilePlaceholder.png' ? child.image_url : '/images/profilePlaceholder.png' %>"
                 alt="<%= child.first_name %>">
            <div class="pg-child-copy">
              <div class="pg-child-name"><%= child.first_name %> <%= child.last_name %></div>
              <div class="pg-child-meta"><%= child.class_name || 'Unassigned class' %> · <%= kidAssignments.length %> open bill<%= kidAssignments.length !== 1 ? 's' : '' %><% if (Number(child.student_credit || 0) > 0) { %> · Available balance <%= money(child.student_credit) %><% } %></div>
            </div>
          </div>

          <% if (!kidAssignments.length) { %>
            <div class="pg-empty" style="padding:28px;">
              <div style="font-size:1.4rem;">✅</div>
              <div>No outstanding bills for this child.<% if (Number(child.student_credit || 0) > 0) { %> Available balance: <%= money(child.student_credit) %>.<% } %></div>
            </div>
          <% } else { kidAssignments.forEach(a => {
            const bal = balance(a);
            const recurring = String(a.bill_type || '') === 'recurring';
            const canPay = bal > 0;
          %>
            <div class="pg-bill-row"
                 <% if (canPay) { %>onclick="openPgPay('<%= a.assignment_id %>')"<% } %>>
              <div>
                <div class="pg-bill-title"><%= a.bill_title %></div>
                <div class="pg-bill-sub">
                  Due <%= a.due_date ? new Date(a.due_date).toLocaleDateString() : '—' %>
                  <% if (recurring && a.recurrence) { %> · Recurs <%= a.recurrence %><% } %>
                  <% if (recurring && a.recurrence_end_date) { %> · Through <%= new Date(a.recurrence_end_date).toLocaleDateString() %><% } %>
                  <% if (a.bill_description) { %> · <%= a.bill_description %><% } %>
                </div>
              </div>
              <div class="pg-bill-col" data-label="Billed">
                <div class="pg-bill-sub">Billed</div>
                <div class="pg-amount"><%= money(billedTotal(a)) %></div>
              </div>
              <div class="pg-bill-col" data-label="Paid">
                <div class="pg-bill-sub">Paid</div>
                <div class="pg-amount" style="color:var(--pg-teal);"><%= money(a.amount_paid) %></div>
              </div>
              <div class="pg-bill-col" data-label="Balance">
                <div class="pg-bill-sub"><%= recurring ? 'Remaining' : 'Balance' %></div>
                <div>
                  <div class="pg-balance"><%= money(bal) %></div>
                  <% if (recurring && a.recurrence) { %><div class="pg-bill-sub">Pay exact dates inside the panel</div><% } %>
                  <% if (Number(a.student_credit || 0) > 0) { %><div class="pg-bill-sub">Available balance <%= money(a.student_credit) %> can be applied here</div><% } %>
                  <span class="pg-status <%= statusClass(a.status) %>" style="margin-top:4px;"><%= a.status %></span>
                </div>
              </div>
              <div class="pg-bill-actions" onclick="event.stopPropagation()">
                <% if (canPay) { %>
                  <button type="button" class="pg-btn primary"
                          onclick="openPgPay('<%= a.assignment_id %>')">
                    <%= recurring ? '📅 Pay Dates' : '💳 Pay Now' %>
                  </button>
                <% } else { %>
                  <span class="pg-status paid">Paid</span>
                <% } %>
                <a href="/guardian/paygira/invoice/<%= a.assignment_id %>" target="_blank" class="pg-btn ghost" style="margin-left:6px;padding:7px 10px;font-size:.72rem;" title="View invoice">🧾</a>
              </div>
            </div>
          <% }); } %>
        </div>
      <% }); %>
    <% } %>

    <div class="pg-section-title">Recent Payments · Latest 15</div>
    <div class="pg-history">
      <div class="pg-history-row head">
        <div>Date</div><div>Student</div><div>Bill</div><div>Amount</div>
      </div>
      <% if (!payments.length) { %>
        <div class="pg-history-row"><div style="grid-column:1/-1;text-align:center;color:var(--pg-muted);padding:18px;">No payments yet.</div></div>
      <% } else { payments.forEach(p => { %>
        <div class="pg-history-row">
          <div data-label="Date"><%= new Date(p.received_at).toLocaleDateString() %></div>
          <div data-label="Student"><%= p.first_name %> <%= p.last_name %></div>
          <div data-label="Bill"><%= p.bill_title %> · <span style="color:var(--pg-muted);"><%= p.method %></span></div>
          <div data-label="Amount" class="pg-amount" style="color:var(--pg-teal);display:flex;align-items:center;justify-content:space-between;gap:6px;">
            <%= money(p.amount) %>
            <% if (p.payment_id) { %><a href="/guardian/paygira/receipt/<%= p.payment_id %>" target="_blank" title="Receipt" style="color:var(--pg-muted);text-decoration:none;">🧾</a><% } %>
          </div>
        </div>
      <% }); } %>
    </div>

  </div>
</div>

<script id="pgAssignmentsData" type="application/json"><%- JSON.stringify(assignments.map(a => ({
  assignment_id: a.assignment_id,
  bill_title: a.bill_title,
  student_name: `${a.first_name || ''} ${a.last_name || ''}`.trim(),
  balance: balance(a),
  amount: Number(a.amount || 0),
  scheduled_billed_total: Number(a.scheduled_billed_total || 0),
  amount_paid: Number(a.amount_paid || 0),
  bill_type: a.bill_type,
  recurrence: a.recurrence,
  due_date: a.due_date,
  recurrence_end_date: a.recurrence_end_date,
  term_end_date: a.term_end_date,
  scheduled_occurrence_dates: a.scheduled_occurrence_dates || [],
  occurrence_payments: a.occurrence_payments || {},
  student_credit: Number(a.student_credit || 0),
  accepts_card: !!a.accepts_card,
  accepts_cash: !!a.accepts_cash,
  accepts_transfer: !!a.accepts_transfer,
  payment_destination: a.payment_destination || 'stripe',
}))) %></script>

<div class="pg-modal-bg" id="pgPayModal">
  <div class="pg-modal">
    <h3 style="display:flex;align-items:center;justify-content:space-between;gap:8px;">
      Pay Bill
      <span class="paygira-secure-badge" style="padding:4px 10px;font-size:.62rem;">
        <svg width="10" height="10" viewBox="0 0 24 24" fill="currentColor"><path d="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4z"/></svg>
        Secure
      </span>
    </h3>
    <form action="/guardian/paygira/pay" method="POST" id="pgPayForm">
      <input type="hidden" name="assignment_id" id="pgPayAssignment">
      <input type="hidden" name="occurrence_date" id="pgOccurrenceDate">
      <input type="hidden" name="occurrence_dates" id="pgOccurrenceDates">
      <div class="pg-form-grid">
        <div class="pg-field span2">
          <label>Bill</label>
          <input type="text" id="pgPayBillName" disabled>
        </div>
        <div class="pg-field span2">
          <label>Student</label>
          <input type="text" id="pgPayStudent" disabled>
        </div>
        <div class="pg-field span2" id="pgCreditField" hidden>
          <label>Available Balance</label>
          <div class="pg-credit-box">
            <div class="pg-credit-value" id="pgCreditAmount"><%= money(0) %></div>
            <label class="pg-credit-toggle"><input type="checkbox" name="apply_credit" id="pgApplyCredit"> Apply available balance before charging this payment</label>
            <div class="pg-credit-note" id="pgCreditHint">Any available balance for this child can be used first before charging a new payment.</div>
          </div>
        </div>
        <div class="pg-field">
          <label>Amount (<%= currencyCode %>)</label>
          <input type="number" step="0.01" min="0.01" name="amount" id="pgPayAmount" required>
        </div>
        <div class="pg-field">
          <label>Method</label>
          <select name="method" id="pgMethod"></select>
        </div>
        <div class="pg-field span2">
          <small id="pgMethodHint" style="display:block;color:var(--pg-muted,#8a93a8);font-size:.72rem;">Only the payment methods this bill and your school support will appear here.</small>
        </div>
        <div class="pg-field span2 pg-recurring-panel" id="pgRecurringPanel" hidden>
          <label>Recurring Dates</label>
          <div class="pg-recurring-caption">Choose the exact dates you want to settle. The total below only includes what is still owed for those dates.</div>
          <div class="pg-recurring-toolbar">
            <div class="pg-recurring-summary" id="pgRecurringSummary">Choose one or more owing dates. Total updates automatically.</div>
            <div class="pg-recurring-actions">
              <button type="button" class="pg-btn ghost" id="pgSelectAllDates" style="padding:7px 10px;font-size:.72rem;">Select all</button>
              <button type="button" class="pg-btn ghost" id="pgClearDates" style="padding:7px 10px;font-size:.72rem;">Clear</button>
            </div>
          </div>
          <div class="pg-recurring-list" id="pgRecurringList"></div>
          <small class="pg-pay-hint" id="pgRecurringHint">Select one or more dates to pay only the remaining amount for those dates.</small>
        </div>
        <div class="pg-field span2">
          <div class="pg-payment-shell pg-stripe-shell" id="pgStripeShell" hidden>
            <div>
              <div class="pg-stripe-box-title">Secure Online Checkout</div>
              <div class="pg-pay-mode-note" id="pgStripeIntro">Pay online with the Stripe options your school enabled for PayGira.</div>
              <div class="pg-method-chip-list" id="pgStripeMethodChips"></div>
            </div>
            <div class="pg-stripe-box">
              <div class="pg-express-shell" id="pgExpressShell">
                <div class="pg-stripe-box-title">Express Checkout</div>
                <div class="pg-stripe-box-subtitle">Apple Pay and Google Pay appear here when your browser, device, and Stripe domain setup support them.</div>
                <div id="pgExpressCheckoutElement"></div>
              </div>
              <div class="pg-stripe-box-title" style="margin-top:4px;">Payment Details</div>
              <div class="pg-stripe-box-subtitle">Choose from the Stripe payment options your school enabled. Redirect-based methods return here automatically when complete.</div>
              <div id="pgStripePaymentElement"></div>
              <p class="pg-stripe-error" id="pgStripeError"></p>
              <div class="pg-stripe-test-note" id="pgStripeTestNote" <%= (pspSettings && pspSettings.stripe_mode === 'test') ? '' : 'hidden' %>>
                Test mode: use 4242 4242 4242 4242 with any future expiry date, any 3-digit CVC, and any ZIP or postal code.
              </div>
            </div>
          </div>
          <div class="pg-payment-shell" id="pgOfflineShell" hidden>
            <div class="pg-offline-title" id="pgOfflineTitle">Payment instructions</div>
            <div class="pg-offline-details" id="pgOfflineDetails"></div>
          </div>
        </div>
      </div>
      <div class="pg-modal-actions">
        <button type="button" class="pg-btn ghost" onclick="closePgPay()">Cancel</button>
        <button type="submit" class="pg-btn primary" id="pgSubmitBtn">Continue</button>
      </div>
    </form>
  </div>
</div>

<script>
  (function() {
    var payAssignments = {};
    try {
      JSON.parse(document.getElementById('pgAssignmentsData').textContent || '[]').forEach(function(item) {
        payAssignments[String(item.assignment_id)] = item;
      });
    } catch (_) {}

    var allowedMethods = <%- JSON.stringify(allowedMethods || {}) %>;
    var stripeCatalog = <%- JSON.stringify(stripeCatalog || []) %>;
    var stripeCheckoutConfig = <%- JSON.stringify(stripeCheckoutConfig || {}) %>;
    var stripePublishableKey = <%- JSON.stringify((pspSettings && pspSettings.stripe_publishable_key) || '') %>;
    var stripeMode = <%- JSON.stringify((pspSettings && pspSettings.stripe_mode) || 'test') %>;
    var stripeEnabled = Boolean(allowedMethods && allowedMethods.stripeOn && stripePublishableKey && window.Stripe);
    var stripe = stripeEnabled ? window.Stripe(stripePublishableKey) : null;
    var stripeCurrency = String((allowedMethods && allowedMethods.currency) || <%- JSON.stringify(currencyCode) %> || 'USD').toLowerCase();
    var stripeElements = null;
    var stripePaymentElement = null;
    var expressCheckoutElement = null;
    var stripeMountedAmount = null;
    var stripeBusy = false;
    var bypassStripeSubmit = false;
    var activeRecord = null;

    var payModal = document.getElementById('pgPayModal');
    var payForm = document.getElementById('pgPayForm');
    var amountInput = document.getElementById('pgPayAmount');
    var amountLabel = amountInput.closest('.pg-field').querySelector('label');
    var recurringPanel = document.getElementById('pgRecurringPanel');
    var recurringList = document.getElementById('pgRecurringList');
    var recurringSummary = document.getElementById('pgRecurringSummary');
    var recurringHint = document.getElementById('pgRecurringHint');
    var occurrenceDateInput = document.getElementById('pgOccurrenceDate');
    var occurrenceDatesInput = document.getElementById('pgOccurrenceDates');
    var submitButton = document.getElementById('pgSubmitBtn');
    var creditField = document.getElementById('pgCreditField');
    var creditAmount = document.getElementById('pgCreditAmount');
    var creditHint = document.getElementById('pgCreditHint');
    var applyCreditCheckbox = document.getElementById('pgApplyCredit');
    var methodSelect = document.getElementById('pgMethod');
    var methodHint = document.getElementById('pgMethodHint');
    var stripeShell = document.getElementById('pgStripeShell');
    var stripeMethodChips = document.getElementById('pgStripeMethodChips');
    var stripeIntro = document.getElementById('pgStripeIntro');
    var expressShell = document.getElementById('pgExpressShell');
    var stripePaymentElementHost = document.getElementById('pgStripePaymentElement');
    var expressCheckoutHost = document.getElementById('pgExpressCheckoutElement');
    var stripeError = document.getElementById('pgStripeError');
    var offlineShell = document.getElementById('pgOfflineShell');
    var offlineTitle = document.getElementById('pgOfflineTitle');
    var offlineDetails = document.getElementById('pgOfflineDetails');

    function escapeHtml(value) {
      return String(value == null ? '' : value)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#39;');
    }

    function formatMoney(value) {
      try {
        return new Intl.NumberFormat(undefined, {
          style: 'currency',
          currency: <%- JSON.stringify(currencyCode) %>,
          minimumFractionDigits: 2,
          maximumFractionDigits: 2
        }).format(Number(value || 0));
      } catch (_) {
        return <%- JSON.stringify(currencyCode) %> + ' ' + Number(value || 0).toFixed(2);
      }
    }

    function recurStepDays(recurrence) {
      return ({ daily: 1, weekly: 7, monthly: 30, term: 90, year: 365 })[String(recurrence || '').toLowerCase()] || 0;
    }

    function advanceOccurrenceDate(dateValue, recurrence) {
      var next = new Date(dateValue.getTime());
      switch (String(recurrence || '').toLowerCase()) {
        case 'daily': next.setDate(next.getDate() + 1); return next;
        case 'weekly': next.setDate(next.getDate() + 7); return next;
        case 'monthly': next.setMonth(next.getMonth() + 1); return next;
        case 'term': next.setMonth(next.getMonth() + 3); return next;
        case 'year': next.setFullYear(next.getFullYear() + 1); return next;
        default: return null;
      }
    }

    function fmtDate(dateValue) {
      try { return dateValue ? new Date(dateValue).toLocaleDateString() : '—'; } catch (_) { return '—'; }
    }

    function isoDate(dateValue) {
      return dateValue.getFullYear() + '-' + String(dateValue.getMonth() + 1).padStart(2, '0') + '-' + String(dateValue.getDate()).padStart(2, '0');
    }

    function smartLabel(diff, recurrence) {
      var normalized = String(recurrence || '').toLowerCase();
      if (diff === 0) return 'Today';
      if (diff === 1) return normalized === 'daily' ? 'Tomorrow' : 'Next';
      if (diff === -1) return normalized === 'daily' ? 'Yesterday' : 'Previous';
      if (diff < 0) return Math.abs(diff) + ' day(s) ago';
      return 'In ' + diff + ' day(s)';
    }

    function buildOccurrences(record) {
      var step = recurStepDays(record.recurrence);
      if (!step) return [];
      var anchor = record.due_date ? new Date(record.due_date) : new Date();
      if (Number.isNaN(anchor.getTime())) anchor = new Date();
      anchor.setHours(0, 0, 0, 0);
      var today = new Date();
      today.setHours(0, 0, 0, 0);
      var paymentMap = record.occurrence_payments || {};
      var occurrences = [];
      var exactDateList = Array.isArray(record.scheduled_occurrence_dates) && record.scheduled_occurrence_dates.length
        ? record.scheduled_occurrence_dates.slice()
        : null;
      if (exactDateList) {
        return exactDateList.reduce(function(rows, value) {
          var occurrenceDate = new Date(value + 'T00:00:00');
          if (Number.isNaN(occurrenceDate.getTime())) return rows;
          var diff = Math.round((occurrenceDate - today) / 86400000);
          var paidAmount = Number(paymentMap[value] || 0);
          var outstandingAmount = Math.max(Number(record.amount || 0) - paidAmount, 0);
          var status = outstandingAmount <= 0 ? 'Paid' : (paidAmount > 0 ? 'Partial' : 'Owing');
          rows.push({
            value: value,
            label: fmtDate(occurrenceDate),
            meta: smartLabel(diff, record.recurrence),
            windowTag: diff < 0 ? 'Past' : (diff === 0 ? 'Due' : 'Upcoming'),
            status: status,
            statusClass: status.toLowerCase(),
            paidAmount: paidAmount,
            outstandingAmount: outstandingAmount,
            amountLabel: outstandingAmount <= 0
              ? 'Fully paid'
              : (paidAmount > 0
                  ? 'Owing ' + formatMoney(outstandingAmount) + ' after ' + formatMoney(paidAmount) + ' paid'
                  : 'Owing ' + formatMoney(outstandingAmount))
          });
          return rows;
        }, []);
      }
      var scheduleEndIso = record.recurrence_end_date || record.term_end_date || '';
      if (scheduleEndIso) {
        var scheduleEnd = new Date(scheduleEndIso + 'T00:00:00');
        if (!Number.isNaN(scheduleEnd.getTime()) && scheduleEnd >= anchor) {
          var cursor = new Date(anchor.getTime());
          for (var guard = 0; guard < 5000 && cursor <= scheduleEnd; guard += 1) {
            var exactDiff = Math.round((cursor - today) / 86400000);
            var exactValue = isoDate(cursor);
            var exactPaidAmount = Number(paymentMap[exactValue] || 0);
            var exactOutstandingAmount = Math.max(Number(record.amount || 0) - exactPaidAmount, 0);
            var exactStatus = exactOutstandingAmount <= 0 ? 'Paid' : (exactPaidAmount > 0 ? 'Partial' : 'Owing');
            occurrences.push({
              value: exactValue,
              label: fmtDate(cursor),
              meta: smartLabel(exactDiff, record.recurrence),
              windowTag: exactDiff < 0 ? 'Past' : (exactDiff === 0 ? 'Due' : 'Upcoming'),
              status: exactStatus,
              statusClass: exactStatus.toLowerCase(),
              paidAmount: exactPaidAmount,
              outstandingAmount: exactOutstandingAmount,
              amountLabel: exactOutstandingAmount <= 0
                ? 'Fully paid'
                : (exactPaidAmount > 0
                    ? 'Owing ' + formatMoney(exactOutstandingAmount) + ' after ' + formatMoney(exactPaidAmount) + ' paid'
                    : 'Owing ' + formatMoney(exactOutstandingAmount))
            });
            var nextExact = advanceOccurrenceDate(cursor, record.recurrence);
            if (!nextExact || nextExact.getTime() === cursor.getTime()) break;
            cursor = nextExact;
          }
          if (occurrences.length) return occurrences;
        }
      }
      var back = record.recurrence === 'monthly' ? 4 : 8;
      var forward = record.recurrence === 'monthly' ? 8 : 16;
      for (var index = -back; index <= forward; index += 1) {
        var occurrenceDate = new Date(anchor);
        occurrenceDate.setDate(anchor.getDate() + (index * step));
        var diff = Math.round((occurrenceDate - today) / 86400000);
        var value = isoDate(occurrenceDate);
        var paidAmount = Number(paymentMap[value] || 0);
        var outstandingAmount = Math.max(Number(record.amount || 0) - paidAmount, 0);
        var status = outstandingAmount <= 0 ? 'Paid' : (paidAmount > 0 ? 'Partial' : 'Owing');
        occurrences.push({
          value: value,
          label: fmtDate(occurrenceDate),
          meta: smartLabel(diff, record.recurrence),
          windowTag: diff < 0 ? 'Past' : (diff === 0 ? 'Due' : 'Upcoming'),
          status: status,
          statusClass: status.toLowerCase(),
          paidAmount: paidAmount,
          outstandingAmount: outstandingAmount,
          amountLabel: outstandingAmount <= 0
            ? 'Fully paid'
            : (paidAmount > 0
                ? 'Owing ' + formatMoney(outstandingAmount) + ' after ' + formatMoney(paidAmount) + ' paid'
                : 'Owing ' + formatMoney(outstandingAmount))
        });
      }
      return occurrences;
    }

    function getAvailableCredit(record) {
      return Math.max(Number((record && record.student_credit) || 0), 0);
    }

    function getRecurringSelectedDue() {
      return Array.prototype.slice.call(recurringList.querySelectorAll('.pg-occ-check:checked')).reduce(function(sum, input) {
        return sum + Number(input.getAttribute('data-outstanding') || 0);
      }, 0);
    }

    function getCurrentDue(record) {
      if (!record) return 0;
      if (String(record.bill_type || '') === 'recurring') return getRecurringSelectedDue();
      return Math.max(Number(record.balance || 0), 0);
    }

    function currentChargeMinor() {
      return Math.round(Math.max(Number(amountInput.value || 0), 0) * 100);
    }

    function isStripeFlowSelected() {
      return String(methodSelect.value || '') === 'stripe';
    }

    function setStripeError(message) {
      if (!stripeError) return;
      stripeError.textContent = message || '';
      stripeError.classList.toggle('show', Boolean(message));
    }

    function destroyStripeElements() {
      stripeMountedAmount = null;
      if (stripePaymentElement && typeof stripePaymentElement.destroy === 'function') {
        stripePaymentElement.destroy();
      }
      if (expressCheckoutElement && typeof expressCheckoutElement.destroy === 'function') {
        expressCheckoutElement.destroy();
      }
      stripePaymentElement = null;
      expressCheckoutElement = null;
      stripeElements = null;
      if (expressShell) expressShell.classList.remove('is-visible');
      if (stripePaymentElementHost) stripePaymentElementHost.innerHTML = '';
      if (expressCheckoutHost) expressCheckoutHost.innerHTML = '';
      setStripeError('');
    }

    function renderStripeMethodChips() {
      var selectedIds = Array.isArray(stripeCheckoutConfig.selectedIds) ? stripeCheckoutConfig.selectedIds : [];
      stripeMethodChips.innerHTML = selectedIds.map(function(methodId) {
        var match = stripeCatalog.find(function(entry) { return entry.id === methodId; });
        var label = match ? match.label : methodId.replace(/_/g, ' ');
        return '<span class="pg-method-chip">' + escapeHtml(label) + '</span>';
      }).join('');
      if (!stripeMethodChips.innerHTML) {
        stripeMethodChips.innerHTML = '<span class="pg-method-chip">Card</span>';
      }
    }

    function ensureStripeElements() {
      if (!stripeEnabled || !isStripeFlowSelected()) return;
      var amountMinor = currentChargeMinor();
      if (!(amountMinor > 0)) {
        destroyStripeElements();
        setStripeError('No card or wallet charge is needed. Submit this payment to apply available balance only.');
        return;
      }
      if (stripeElements && stripeMountedAmount === amountMinor) return;
      destroyStripeElements();

      stripeElements = stripe.elements({
        mode: 'payment',
        amount: amountMinor,
        currency: stripeCurrency,
      });
      stripeMountedAmount = amountMinor;
      stripePaymentElement = stripeElements.create('payment', {
        layout: { type: 'tabs' },
        paymentMethodOrder: Array.isArray(stripeCheckoutConfig.paymentMethodOrder) && stripeCheckoutConfig.paymentMethodOrder.length
          ? stripeCheckoutConfig.paymentMethodOrder
          : ['card'],
      });
      stripePaymentElement.mount('#pgStripePaymentElement');
      stripePaymentElement.on('change', function(event) {
        setStripeError(event && event.error ? event.error.message : '');
      });

      expressCheckoutElement = stripeElements.create('expressCheckout', {
        paymentMethods: {
          applePay: stripeCheckoutConfig.expressWallets && stripeCheckoutConfig.expressWallets.applePay ? stripeCheckoutConfig.expressWallets.applePay : 'auto',
          googlePay: stripeCheckoutConfig.expressWallets && stripeCheckoutConfig.expressWallets.googlePay ? stripeCheckoutConfig.expressWallets.googlePay : 'auto',
        },
        layout: { maxColumns: 2, maxRows: 2, overflowMenu: 'auto' },
        buttonHeight: 44,
      });
      expressCheckoutElement.on('ready', function(event) {
        if (event && event.availablePaymentMethods) {
          expressShell.classList.add('is-visible');
        }
      });
      expressCheckoutElement.on('confirm', function(event) {
        if (event && typeof event.preventDefault === 'function') event.preventDefault();
        void handleStripeConfirmation();
      });
      expressCheckoutElement.mount('#pgExpressCheckoutElement');
    }

    function getMethodOptions(record) {
      var options = [];
      if (stripeEnabled && record && record.accepts_card) {
        options.push({
          value: 'stripe',
          label: 'Secure online checkout',
          hint: 'Stripe handles card, wallet, and any Stripe methods your school enabled for PayGira.'
        });
      }
      if (allowedMethods && allowedMethods.bankOn && record && record.accepts_transfer) {
        options.push({
          value: 'bank_transfer',
          label: 'Bank transfer',
          hint: 'Use your school bank details below, then submit this transfer in PayGira.'
        });
      }
      if (allowedMethods && allowedMethods.momoOn) {
        options.push({
          value: 'mobile_money',
          label: 'Mobile money',
          hint: 'Use the school mobile money details below, then submit this transfer in PayGira.'
        });
      }
      options.push({
        value: 'other',
        label: 'Other approved method',
        hint: 'Use this when the school has given you another approved payment path for this bill.'
      });
      return options;
    }

    function renderOfflineDetails(methodValue) {
      if (methodValue === 'bank_transfer') {
        offlineTitle.textContent = 'Bank transfer details';
        offlineDetails.innerHTML = [
          allowedMethods && allowedMethods.bank && allowedMethods.bank.name ? '<div><strong>Bank:</strong> ' + escapeHtml(allowedMethods.bank.name) + '</div>' : '',
          allowedMethods && allowedMethods.bank && allowedMethods.bank.holder ? '<div><strong>Account name:</strong> ' + escapeHtml(allowedMethods.bank.holder) + '</div>' : '',
          allowedMethods && allowedMethods.bank && allowedMethods.bank.account ? '<div><strong>Account number:</strong> ' + escapeHtml(allowedMethods.bank.account) + '</div>' : '',
          allowedMethods && allowedMethods.bank && allowedMethods.bank.branch ? '<div><strong>Branch:</strong> ' + escapeHtml(allowedMethods.bank.branch) + '</div>' : '',
          '<div>Complete the transfer, then submit this payment so the bill reflects what you just paid.</div>'
        ].filter(Boolean).join('');
      } else if (methodValue === 'mobile_money') {
        offlineTitle.textContent = 'Mobile money details';
        offlineDetails.innerHTML = [
          allowedMethods && allowedMethods.momoProvider ? '<div><strong>Provider:</strong> ' + escapeHtml(String(allowedMethods.momoProvider).toUpperCase()) + '</div>' : '',
          allowedMethods && allowedMethods.momoName ? '<div><strong>Name:</strong> ' + escapeHtml(allowedMethods.momoName) + '</div>' : '',
          allowedMethods && allowedMethods.momoNumber ? '<div><strong>Number:</strong> ' + escapeHtml(allowedMethods.momoNumber) + '</div>' : '',
          '<div>Send the money to the school account above, then submit this payment in PayGira.</div>'
        ].filter(Boolean).join('');
      } else {
        offlineTitle.textContent = 'Other payment instructions';
        offlineDetails.innerHTML = '<div>Use the approved payment path your school shared with you, then submit the amount here so the bill updates in PayGira.</div>';
      }
    }

    function updateSubmitButton() {
      if (stripeBusy) {
        submitButton.textContent = 'Processing...';
        submitButton.disabled = true;
        return;
      }
      submitButton.disabled = false;
      if (isStripeFlowSelected()) {
        submitButton.textContent = currentChargeMinor() > 0 ? 'Pay Securely' : 'Apply Balance Only';
        return;
      }
      if (String(methodSelect.value || '') === 'bank_transfer') {
        submitButton.textContent = 'Submit Bank Transfer';
        return;
      }
      if (String(methodSelect.value || '') === 'mobile_money') {
        submitButton.textContent = 'Submit Mobile Money Payment';
        return;
      }
      submitButton.textContent = 'Submit Payment';
    }

    function syncPaymentMode() {
      var selectedMethod = String(methodSelect.value || '');
      var isStripe = selectedMethod === 'stripe';
      stripeShell.hidden = !isStripe;
      offlineShell.hidden = isStripe;

      if (isStripe) {
        methodHint.textContent = 'Stripe will show the online payment methods your school enabled. Apple Pay and Google Pay only appear on supported devices and verified domains.';
        if (stripeIntro) {
          stripeIntro.textContent = 'Pay online with Stripe using the methods your school enabled for PayGira.';
        }
        renderStripeMethodChips();
        ensureStripeElements();
      } else {
        methodHint.textContent = getMethodOptions(activeRecord).filter(function(option) {
          return option.value === selectedMethod;
        }).map(function(option) {
          return option.hint;
        })[0] || 'Only the payment methods this bill and your school support will appear here.';
        renderOfflineDetails(selectedMethod);
        destroyStripeElements();
      }
      updateSubmitButton();
    }

    function syncCreditPanel(options) {
      var record = activeRecord;
      var availableCredit = getAvailableCredit(record);
      var dueAmount = getCurrentDue(record);
      var usingCredit = !!(applyCreditCheckbox && applyCreditCheckbox.checked && availableCredit > 0);
      var creditToApply = usingCredit ? Math.min(availableCredit, dueAmount) : 0;
      var chargeNow = Math.max(dueAmount - creditToApply, 0);

      if (creditField) creditField.hidden = !(availableCredit > 0);
      if (creditAmount) creditAmount.textContent = formatMoney(availableCredit);
      if (applyCreditCheckbox) {
        applyCreditCheckbox.disabled = !(availableCredit > 0);
        if (!(availableCredit > 0)) applyCreditCheckbox.checked = false;
      }
      if (creditHint) {
        if (!(availableCredit > 0)) {
          creditHint.textContent = 'No available balance is stored for this child yet.';
        } else if (!usingCredit) {
          creditHint.textContent = 'Check this box to use up to ' + formatMoney(Math.min(availableCredit, dueAmount)) + ' before charging a new payment.';
        } else if (chargeNow > 0) {
          creditHint.textContent = formatMoney(creditToApply) + ' will be used first. ' + formatMoney(chargeNow) + ' will still be charged now.';
        } else {
          creditHint.textContent = 'This payment can be fully covered from the available balance.';
        }
      }

      if (String((record && record.bill_type) || '') === 'recurring') {
        amountInput.value = chargeNow > 0 ? chargeNow.toFixed(2) : '0.00';
        amountLabel.textContent = usingCredit ? 'Charge Now (<%= currencyCode %>)' : 'Total (<%= currencyCode %>)';
      } else if (options && options.setAmount) {
        amountInput.value = chargeNow > 0 ? chargeNow.toFixed(2) : '0.00';
        amountLabel.textContent = usingCredit ? 'Charge Now (<%= currencyCode %>)' : 'Amount (<%= currencyCode %>)';
      } else {
        amountLabel.textContent = usingCredit ? 'Charge Now (<%= currencyCode %>)' : 'Amount (<%= currencyCode %>)';
      }
      amountInput.min = '0';
      if (!(record && String(record.bill_type || '') === 'recurring')) {
        amountInput.max = Number(record && record.balance || 0) > 0 ? Number(record.balance || 0).toFixed(2) : '';
      }
      if (isStripeFlowSelected()) ensureStripeElements();
      updateSubmitButton();
    }

    function updateRecurringSelection() {
      if (!activeRecord) return;
      var selectedInputs = Array.prototype.slice.call(recurringList.querySelectorAll('.pg-occ-check:checked'));
      var selectedDates = selectedInputs.map(function(input) {
        return input.value;
      });
      occurrenceDatesInput.value = JSON.stringify(selectedDates);
      occurrenceDateInput.value = selectedDates.length === 1 ? selectedDates[0] : '';
      if (!selectedDates.length) {
        amountInput.value = '';
        recurringSummary.textContent = 'Choose one or more owing dates. Total updates automatically.';
        recurringHint.textContent = 'Fully paid dates are disabled. Select any owing dates to pay their remaining balances.';
        syncCreditPanel({ setAmount: false });
        submitButton.disabled = true;
        updateSubmitButton();
        return;
      }

      var totalAmount = selectedInputs.reduce(function(sum, input) {
        return sum + Number(input.getAttribute('data-outstanding') || 0);
      }, 0);
      syncCreditPanel({ setAmount: true });
      var creditUsed = applyCreditCheckbox && applyCreditCheckbox.checked
        ? Math.min(getAvailableCredit(activeRecord), totalAmount)
        : 0;
      var chargeNow = Math.max(totalAmount - creditUsed, 0);
      recurringSummary.textContent = selectedDates.length + ' date(s) selected · ' + formatMoney(totalAmount)
        + (creditUsed > 0 ? (' · ' + formatMoney(creditUsed) + ' from balance · ' + formatMoney(chargeNow) + ' to charge') : '');
      recurringHint.textContent = selectedDates.length === 1
        ? 'You are paying the remaining balance for ' + fmtDate(selectedDates[0]) + '.'
        : 'You are paying the remaining balances for ' + selectedDates.length + ' recurring dates together.';
      submitButton.disabled = !(totalAmount > 0);
      if (isStripeFlowSelected()) ensureStripeElements();
      updateSubmitButton();
    }

    function renderRecurringPanel(record) {
      recurringPanel.hidden = false;
      amountLabel.textContent = 'Total (<%= currencyCode %>)';
      amountInput.readOnly = true;
      amountInput.max = '';
      var occurrences = buildOccurrences(record);
      var firstUpcomingIndex = occurrences.findIndex(function(item) {
        return item.outstandingAmount > 0 && (item.windowTag === 'Due' || item.windowTag === 'Upcoming');
      });
      if (firstUpcomingIndex < 0) {
        firstUpcomingIndex = occurrences.findIndex(function(item) {
          return item.outstandingAmount > 0;
        });
      }
      recurringList.innerHTML = occurrences.map(function(item, index) {
        var isDisabled = !(item.outstandingAmount > 0);
        return '' +
          '<label class="pg-occ-card' + (isDisabled ? ' disabled' : '') + '">' +
            '<input type="checkbox" class="pg-occ-check" value="' + item.value + '" data-outstanding="' + item.outstandingAmount.toFixed(2) + '"' + (index === firstUpcomingIndex ? ' checked' : '') + (isDisabled ? ' disabled' : '') + '>' +
            '<div class="pg-occ-card-copy">' +
              '<div class="pg-occ-date">' + item.label + '</div>' +
              '<div class="pg-occ-meta">' + item.meta + ' · ' + item.windowTag + '</div>' +
              '<div class="pg-occ-amount">' + item.amountLabel + '</div>' +
            '</div>' +
            '<div class="pg-occ-status">' +
              (item.statusClass === 'paid' ? '<span class="pg-occ-checkmark" aria-hidden="true">✓</span>' : '') +
              '<span class="pg-occ-tag ' + item.statusClass + '">' + item.status + '</span>' +
            '</div>' +
          '</label>';
      }).join('');
      Array.prototype.forEach.call(recurringList.querySelectorAll('.pg-occ-check'), function(input) {
        input.addEventListener('change', updateRecurringSelection);
      });
      document.getElementById('pgSelectAllDates').onclick = function() {
        Array.prototype.forEach.call(recurringList.querySelectorAll('.pg-occ-check'), function(input) {
          if (!input.disabled) input.checked = true;
        });
        updateRecurringSelection();
      };
      document.getElementById('pgClearDates').onclick = function() {
        Array.prototype.forEach.call(recurringList.querySelectorAll('.pg-occ-check'), function(input) {
          input.checked = false;
        });
        updateRecurringSelection();
      };
      updateRecurringSelection();
    }

    function hideRecurringPanel() {
      recurringPanel.hidden = true;
      recurringList.innerHTML = '';
      occurrenceDateInput.value = '';
      occurrenceDatesInput.value = '';
      amountLabel.textContent = 'Amount (<%= currencyCode %>)';
      amountInput.readOnly = false;
      amountInput.min = '0';
      submitButton.disabled = false;
    }

    function renderMethodOptions(record) {
      var options = getMethodOptions(record);
      var previousValue = String(methodSelect.value || '');
      methodSelect.innerHTML = options.map(function(option) {
        return '<option value="' + escapeHtml(option.value) + '">' + escapeHtml(option.label) + '</option>';
      }).join('');
      if (previousValue && options.some(function(option) { return option.value === previousValue; })) {
        methodSelect.value = previousValue;
      } else if (options.length) {
        methodSelect.value = options[0].value;
      }
      syncPaymentMode();
    }

    async function createStripeIntent() {
      var response = await fetch('/guardian/paygira/stripe-intent', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          assignment_id: document.getElementById('pgPayAssignment').value,
          amount: amountInput.value,
          occurrence_date: occurrenceDateInput.value,
          occurrence_dates: occurrenceDatesInput.value,
          apply_credit: applyCreditCheckbox && applyCreditCheckbox.checked,
        })
      });
      var data = await response.json();
      if (!response.ok || !data.success) {
        throw new Error(data.message || 'Unable to initialize Stripe payment.');
      }
      return data;
    }

    async function handleStripeConfirmation() {
      if (!stripeEnabled || !stripe || !isStripeFlowSelected()) return;
      if (!(currentChargeMinor() > 0)) {
        bypassStripeSubmit = true;
        payForm.submit();
        return;
      }

      stripeBusy = true;
      updateSubmitButton();
      try {
        ensureStripeElements();
        if (!stripeElements) throw new Error('Stripe checkout is not available right now.');
        setStripeError('');
        var submitResult = await stripeElements.submit();
        if (submitResult && submitResult.error) throw submitResult.error;

        var intentData = await createStripeIntent();
        var confirmation = await stripe.confirmPayment({
          elements: stripeElements,
          clientSecret: intentData.clientSecret,
          confirmParams: {
            return_url: intentData.returnUrl,
          },
          redirect: 'if_required'
        });

        if (confirmation.error) {
          throw confirmation.error;
        }

        if (confirmation.paymentIntent && (confirmation.paymentIntent.status === 'succeeded' || confirmation.paymentIntent.status === 'processing')) {
          window.location.href = intentData.returnUrl + '?payment_intent=' + encodeURIComponent(confirmation.paymentIntent.id);
          return;
        }
      } catch (error) {
        setStripeError(error && error.message ? error.message : 'Unable to complete Stripe payment.');
      }
      stripeBusy = false;
      updateSubmitButton();
    }

    window.openPgPay = function(assignmentId) {
      var record = payAssignments[String(assignmentId)];
      if (!record) return;
      activeRecord = record;
      destroyStripeElements();
      payForm.reset();
      stripeBusy = false;
      document.getElementById('pgPayAssignment').value = record.assignment_id;
      document.getElementById('pgPayBillName').value = record.bill_title;
      document.getElementById('pgPayStudent').value = record.student_name;
      renderMethodOptions(record);
      if (String(record.bill_type || '') === 'recurring') {
        renderRecurringPanel(record);
      } else {
        hideRecurringPanel();
        amountInput.value = Number(record.balance || 0).toFixed(2);
        amountInput.max = Number(record.balance || 0).toFixed(2);
      }
      syncCreditPanel({ setAmount: false });
      payModal.classList.add('open');
    };

    window.closePgPay = function() {
      activeRecord = null;
      stripeBusy = false;
      hideRecurringPanel();
      destroyStripeElements();
      payModal.classList.remove('open');
    };

    payModal.addEventListener('click', function(e) {
      if (e.target === payModal) closePgPay();
    });

    methodSelect.addEventListener('change', syncPaymentMode);
    if (applyCreditCheckbox) {
      applyCreditCheckbox.addEventListener('change', function() {
        if (activeRecord && String(activeRecord.bill_type || '') === 'recurring') updateRecurringSelection();
        else syncCreditPanel({ setAmount: true });
      });
    }
    amountInput.addEventListener('input', function() {
      if (activeRecord && String(activeRecord.bill_type || '') !== 'recurring') {
        syncCreditPanel({ setAmount: false });
      }
    });
    payForm.addEventListener('submit', function(event) {
      if (bypassStripeSubmit) {
        bypassStripeSubmit = false;
        return;
      }
      if (!isStripeFlowSelected()) {
        return;
      }
      event.preventDefault();
      void handleStripeConfirmation();
    });
  })();
</script>
