    color:#15803d;
  }
  .pg-occ-status {
    display:flex;
    align-items:center;
    gap:8px;
    flex-shrink:0;
    margin-left:auto;
    white-space:nowrap;
  }
  .pg-occ-checkmark {
    width:22px;
    height:22px;
    border-radius:50%;
    display:inline-flex;
    align-items:center;
    justify-content:center;
    border:1px solid rgba(21,128,61,.35);
    background:rgba(21,128,61,.16);
    color:#15803d;
    font-size:.82rem;
    font-weight:800;
  }
  .pg-occ-tag.partial {
    color:#b45309;
  }
  .pg-occ-tag.owing {
    color:#b91c1c;
  }
  .pg-occ-card.disabled {
    opacity:.62;
    cursor:not-allowed;
  }
  .pg-occ-card.disabled input {
    cursor:not-allowed;
  }
  .pg-occ-amount {
    color:#d9f8f0;
    font-size:.72rem;
    margin-top:0;
    font-weight:600;
    white-space:nowrap;
  }
  .pg-pay-hint {
    display:block;
    color:var(--pg-muted);
    font-size:.72rem;
    margin-top:8px;
  }
  .pg-credit-box {
    border:1px solid rgba(0,212,170,.24);
    background:rgba(0,212,170,.06);
    border-radius:14px;
    padding:14px;
  }
  .pg-credit-value {
    font-family:'JetBrains Mono',monospace;
    font-size:1rem;
    font-weight:800;
    color:var(--pg-teal);
    margin-bottom:8px;
  }
  .pg-credit-toggle {
    display:flex;
    align-items:flex-start;
    gap:10px;
    color:var(--pg-text);
    font-size:.8rem;
    line-height:1.4;
  }
  .pg-credit-actions {
    display:flex;
    gap:8px;
    align-items:center;
    flex-wrap:nowrap;
    margin-top:10px;
    overflow-x:auto;
  }
    .pg-modal-actions .pg-btn {
      flex:0 0 auto;
      min-height:38px;
      justify-content:center;
    }
  .pg-credit-toggle input {
    margin-top:2px;
    accent-color:var(--pg-teal);
  }
  .pg-credit-note {
    color:var(--pg-muted);
    font-size:.72rem;
    margin-top:8px;
  }
  .pgv2-section-label {
    display:block;
    color:var(--pg-muted);
    font-size:.72rem;
    font-weight:700;
    letter-spacing:.08em;
    margin-bottom:10px;
    text-transform:uppercase;
  }
  .pgv2-balance-card {
    border:1px solid rgba(0,212,170,.24);
    background:linear-gradient(180deg, rgba(0,212,170,.08), rgba(0,212,170,.03));
    border-radius:16px;
    padding:16px;
  }
  .pgv2-balance-top {
    display:flex;
    align-items:flex-start;
    justify-content:space-between;
    gap:14px;
    flex-wrap:wrap;
  }
  .pgv2-balance-heading {
    color:var(--pg-muted);
    font-size:.72rem;
    font-weight:700;
    letter-spacing:.08em;
    text-transform:uppercase;
  }
  .pgv2-balance-figure {
    margin-top:6px;
    color:var(--pg-teal);
    font-family:'JetBrains Mono',monospace;
    font-size:1.4rem;
    font-weight:800;
  }
  .pgv2-apply-btn {
    display:inline-flex;
    align-items:center;
    justify-content:center;
    min-height:38px;
    padding:0 12px;
    border-radius:4px;
    border:1px solid transparent;
    background:var(--pg-org);
    color:#fff;
    font-size:.82rem;
    font-weight:600;
    cursor:pointer;
    transition:transform .15s ease, box-shadow .15s ease, background .15s ease, color .15s ease;
    white-space:nowrap;
  }
  .pgv2-apply-btn:hover:not(:disabled) {
    transform:none;
    box-shadow:none;
    background:var(--pg-org-hover);
  }
  .pgv2-apply-btn:disabled {
    opacity:.45;
    cursor:not-allowed;
  }
  .pgv2-apply-btn.is-applied {
    border-color:transparent;
    background:var(--pg-org);
    color:#fff;
  }
  .pgv2-balance-hint {
    color:var(--pg-muted);
    font-size:.78rem;
    line-height:1.5;
  }
  .pgv2-balance-hint.is-covered {
    color:var(--pg-teal);
    font-weight:700;
  }
  .pgv2-amount-wrap {
    display:grid;
    grid-template-columns:minmax(0, 1fr) minmax(220px, .95fr);
    gap:12px;
    align-items:stretch;
  }
  .pgv2-breakdown {
    border:1px solid rgba(255,255,255,.08);
    background:rgba(255,255,255,.03);
    border-radius:14px;
    padding:14px;
    display:grid;
    gap:10px;
  }
  .pgv2-brow {
    display:flex;
    align-items:center;
    justify-content:space-between;
    gap:10px;
    color:var(--pg-text);
    font-size:.82rem;
  }
  .pgv2-brow.is-credit {
    color:var(--pg-teal);
  }
  .pgv2-brow.is-charge {
    color:var(--pg-gold);
  }
  .pgv2-mono {
    font-family:'JetBrains Mono',monospace;
    font-weight:700;
  }
  .pgv2-method-cards {
    display:grid;
    grid-template-columns:repeat(auto-fit, minmax(210px, 1fr));
    gap:10px;
  }
  .pgv2-method-card {
    width:100%;
    display:flex;
    align-items:flex-start;
    gap:12px;
    padding:14px;
    border-radius:16px;
    border:1px solid rgba(255,255,255,.08);
    background:rgba(255,255,255,.03);
    color:var(--pg-text);
    text-align:left;
    cursor:pointer;
    transition:border-color .15s ease, transform .15s ease, background .15s ease, box-shadow .15s ease;
  }
  .pgv2-method-card:hover {
    transform:translateY(-1px);
    border-color:rgba(0,212,170,.22);
    background:rgba(255,255,255,.05);
  }
  .pgv2-method-card.is-selected {
    border-color:rgba(0,212,170,.38);
    background:rgba(0,212,170,.11);
    box-shadow:0 12px 24px rgba(0,0,0,.18);
  }
  .pgv2-method-ico {
    width:42px;
    height:42px;
    flex-shrink:0;
    border-radius:12px;
    display:inline-flex;
    align-items:center;
    justify-content:center;
    background:rgba(255,255,255,.06);
    font-size:1.1rem;
  }
  .pgv2-method-copy {
    display:grid;
    gap:4px;
    min-width:0;
  }
  .pgv2-method-name {
    font-size:.9rem;
    font-weight:700;
  }
  .pgv2-method-subdesc {
    color:var(--pg-muted);
    font-size:.75rem;
    line-height:1.45;
  }
  .pg-pay-mode-note {
    color:var(--pg-muted);
    font-size:.74rem;
    line-height:1.55;
  }
  .pg-method-chip-list {
    display:flex;
    flex-wrap:wrap;
    gap:8px;
    margin-top:10px;
  }
  .pg-method-chip {
    display:inline-flex;
    align-items:center;
    gap:6px;
    padding:6px 10px;
    border-radius:999px;
    border:1px solid rgba(0,212,170,.18);
    background:rgba(0,212,170,.08);
    color:#dffbf5;
    font-size:.7rem;
    font-weight:700;
    letter-spacing:.04em;
    text-transform:uppercase;
  }
  .pg-payment-shell {
    border:1px solid rgba(255,255,255,.08);
    background:rgba(255,255,255,.02);
    border-radius:16px;
    padding:14px;
  }
  .pg-payment-shell[hidden] {
    display:none !important;
  }
  .pg-stripe-shell {
    display:grid;
    gap:12px;
  }
  .pg-stripe-box {
    border:1px solid rgba(255,255,255,.08);
    background:rgba(8,13,26,.56);
    border-radius:14px;
    padding:14px;
  }
  .pg-stripe-box-title {
    font-weight:700;
    font-size:.84rem;
    margin-bottom:6px;
    color:var(--pg-muted);
    text-transform:uppercase;
    letter-spacing:.05em;
    font-size:.72rem;
