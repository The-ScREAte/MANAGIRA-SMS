<%
  const _q = 'studentId=' + child.id;
  const _tiles = [{ href: '/guardian/academic-details?' + _q + (child.termId ? '&termId=' + child.termId : ''), icon: 'academic', name: 'Academic info' }];
  _tiles.push({ href: '/guardian/child/schedule?' + _q, icon: 'schedule', name: 'Schedule' });
  if (locals.showTeachers) _tiles.push({ href: '/guardian/child/teachers?' + _q, icon: 'teachers', name: 'Teachers' });
  if (locals.showLunch) _tiles.push({ href: '/guardian/child/lunch?' + _q, icon: 'lunch', name: 'Lunch' });
  if (locals.showAlerts) _tiles.push({ href: '/guardian/child/alerts?' + _q, icon: 'notifications', name: 'Alerts' });
  if (showActivities) {
    _tiles.push({ href: '/guardian/calendar?' + _q, icon: 'calendar', name: 'Calendar' });
    _tiles.push({ href: '/guardian/child/activities?' + _q, icon: 'activities', name: 'Activities', count: 'activities' });
  }
  if (showSchoolwork) {
    _tiles.push({ href: '/guardian/child/homework?' + _q, icon: 'homework', name: 'Homework', count: 'homework' });
    _tiles.push({ href: '/guardian/child/testing-room?' + _q, icon: 'testingRoom', name: 'Testing Room', count: 'testing' });
    _tiles.push({ href: '/guardian/child/documents?' + _q, icon: 'docs', name: 'Documents & results', count: 'documents' });
  } else if (locals.showSchoolDocs) {
    _tiles.push({ href: '/guardian/child/documents?' + _q, icon: 'docs', name: 'Documents', count: 'documents' });
  }
  if (locals.customFormsReady && customFormsReady()) {
    _tiles.push({ href: '/guardian/child/forms?' + _q, icon: 'forms', name: 'Forms', count: 'forms' });
    // Forms the school gave a tile of their own.
    (locals.formTiles || []).forEach((form) => _tiles.push({ href: '/guardian/child/forms?' + _q + '&form=' + form.id, formIcon: form.icon, name: form.name, count: 'form-' + form.id, form: form.id }));
  }
  if (locals.showPortfolio !== false) {
    _tiles.push({ href: '/guardian/child/portfolio?' + _q, icon: 'portfolio', name: 'Portfolio' });
  }
%>
<link rel="stylesheet" href="<%= assetUrl('/css/portalsPhone.css') %>" />
<link rel="stylesheet" href="<%= assetUrl('/css/portalsPhone2.css') %>" />
<link rel="stylesheet" href="<%= assetUrl('/css/appTiles.css') %>" />
<link rel="stylesheet" href="<%= assetUrl('/css/parentHub.css') %>" />
<% if (locals.childSchool) { %><style>.ph-school{display:inline-flex;align-items:center;gap:6px;margin:6px 0 0!important;padding:3px 10px 3px 4px;border:1px solid #e5e9ef;border-radius:999px;background:#fff;color:#334155!important;font-size:12.5px;font-weight:600}.ph-school img{width:20px;height:20px;border-radius:50%;object-fit:contain;background:#fff}</style><% } %>
<div class="ph ph--tiles" data-hub-counts="<%= child.id %>">
  <%- include('../partials/flash') %>
  <a class="ph-back" href="/guardian/dashboard">My children</a>
  <header class="ph-child">
    <img class="ph-child__img" src="<%= publicImageUrl(child.imageUrl && child.imageUrl !== 'profilePlaceholder.png' ? child.imageUrl : '/images/profilePlaceholder.png', { width: 256 }) %>" alt="" />
    <div><h1><%= child.name %></h1><p><%= child.className || 'No class assigned' %></p>
      <% if (locals.childSchool && childSchool.name) { %><p class="ph-school"><% if (childSchool.logo) { %><img src="<%= publicImageUrl(childSchool.logo, { width: 48 }) %>" alt="" /><% } %><span><%= childSchool.name %></span></p><% } %>
    </div>
  </header>
  <% if (locals.gpaInfo && gpaInfo.cumulative) { %>
  <div class="ph-stats"><%- include('../partials/gpaStat', { cls: 'sx-stat', label: 'Cumulative GPA', value: gpaInfo.cumulative.unweighted, detail: gpaInfo.terms ? 'Over ' + gpaInfo.terms + (gpaInfo.terms === 1 ? ' finished term' : ' finished terms') : '4.0 scale' }) %></div>
  <% } %>
  <div class="app-tiles">
    <% _tiles.forEach((tile) => { %>
      <a class="app-tile" href="<%= tile.href %>"<% if (tile.form) { %> data-form-tile="<%= tile.form %>"<% } %>>
        <span class="app-tile__icon"><%- tile.formIcon ? formIcon(tile.formIcon) : navIcon(tile.icon, 24) %></span>
        <span class="app-tile__name"><%= tile.name %></span>
        <% if (tile.count) { %><span class="app-tile__badge" data-count="<%= tile.count %>" hidden></span><% } %>
      </a>
    <% }) %>
    <% if (showTransport) { %>
      <button type="button" class="app-tile" data-transport-tile data-bus-tracker-name="<%= child.firstName %>" data-bus-stop-using>
        <span class="app-tile__icon"><%- navIcon('transportation', 24) %></span>
        <span class="app-tile__name">Transportation</span>
      </button>
    <% } %>
    <a class="app-tile" href="<%= locals.messagesHref || '/guardian/reports' %>">
      <span class="app-tile__icon"><%- navIcon('messages', 24) %></span>
      <span class="app-tile__name">Messages</span>
    </a>
  </div>
</div>
<% if (showTransport) { %><script src="/js/busTracker.js?v=<%= assetVersion %>" defer></script><% } %>
<script src="<%= assetUrl('/js/parentHub.js') %>" defer></script>
