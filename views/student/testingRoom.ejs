<style>
  .str-shell { max-width: 980px; margin: 0 auto; padding: 18px 16px 30px; }
  .str-page-title { margin: 0 0 12px; font-size: 1.25rem; color: #0f172a; }
  .str-card { background: #fff; border: 1px solid #e2e8f0; border-radius: 14px; padding: 14px; box-shadow: 0 4px 14px rgba(15,23,42,0.06); margin-bottom: 10px; }
  .str-list { display: grid; gap: 10px; }
  .str-item { border: 1px solid #e2e8f0; border-radius: 12px; padding: 12px 12px; display: flex; align-items: center; justify-content: space-between; gap: 10px; flex-wrap: wrap; }
  .str-item h3 { margin: 0 0 3px; font-size: .92rem; color: #0f172a; line-height: 1.35; }
  .str-item p { margin: 0; color: #64748b; font-size: .78rem; line-height: 1.4; }
  .str-start {
    text-decoration: none;
    border: none;
    background: var(--org-primary-color, #0f5a66);
    color: #fff;
    padding: 7px 10px;
    border-radius: 10px;
    font-weight: 700;
    font-size: .74rem;
  }
  .str-empty { color: #64748b; margin: 0; }
  .str-badge {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    border: 1px solid #d1fae5;
    color: #065f46;
    background: #ecfdf5;
    border-radius: 999px;
    padding: 4px 8px;
    font-size: .66rem;
    font-weight: 800;
    letter-spacing: .02em;
    text-transform: uppercase;
  }
  .str-badge-locked {
    border: 1px solid #fcd5ce;
    color: #9a3412;
    background: #fff7ed;
  }
  .str-mode-badge {
    display: inline-flex;
    align-items: center;
    border: 1px solid #dbe5ef;
    border-radius: 999px;
    background: #f8fafc;
    color: #334155;
    padding: 3px 7px;
    font-size: .62rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: .02em;
    margin-right: 5px;
  }
  .str-lock {
    width: 12px;
    height: 12px;
    color: #065f46;
    display: inline-flex;
  }

  @media (max-width: 768px) {
    .str-shell { padding: 12px 10px 18px; }
    .str-page-title { font-size: .82rem; margin-bottom: 8px; }
    .str-card { padding: 10px; border-radius: 11px; margin-bottom: 8px; }
    .str-card h2 { font-size: .78rem !important; margin-bottom: 8px !important; }
    .str-list { gap: 8px; }
    .str-item { align-items: flex-start; padding: 9px 9px; border-radius: 10px; gap: 8px; }
    .str-item h3 { font-size: .72rem; margin-bottom: 2px; }
    .str-item p { font-size: .64rem; line-height: 1.34; }
    .str-start { width: 100%; text-align: center; font-size: .64rem; padding: 7px 8px; border-radius: 8px; }
    .str-badge { font-size: .58rem; padding: 3px 7px; gap: 4px; }
    .str-lock { width: 11px; height: 11px; }
    .str-empty { font-size: .66rem; }
  }

  @media (max-width: 460px) {
    .str-shell { padding: 10px 8px 16px; }
    .str-page-title { font-size: .74rem; }
    .str-card { padding: 8px; border-radius: 10px; }
    .str-card h2 { font-size: .7rem !important; }
    .str-item { padding: 8px; gap: 7px; }
    .str-item h3 { font-size: .66rem; }
    .str-item p { font-size: .58rem; }
    .str-start { font-size: .58rem; padding: 6px 7px; }
    .str-badge { font-size: .52rem; padding: 2px 6px; }
    .str-empty { font-size: .6rem; }
  }
</style>

<div class="str-shell">
  <h1 class="str-page-title">Testing Room</h1>

  <%- include('../partials/flash') %>

  <div class="str-card">
    <h2 style="margin:0 0 10px;color:#0f172a;">Open Assessments and Exams</h2>
    <% if (!openAssessments.length) { %>
      <p class="str-empty">No assessments are currently open for you in this term.</p>
    <% } else { %>
      <div class="str-list">
        <% openAssessments.forEach(item => { %>
        <div class="str-item">
          <div>
            <h3><%= item.title %></h3>
            <p>
              <span class="str-mode-badge"><%= item.open_book ? 'Open Book' : 'Secure' %></span>
              <% if (item.time_limit_minutes && Number(item.time_limit_minutes) > 0) { %>
                <span class="str-mode-badge">Duration: <%= Number(item.time_limit_minutes) %> min</span>
              <% } %>
              <% if (item.edit_window_end) { %>
                <% const deadlineDate = new Date(item.edit_window_end); %>
                <% if (!Number.isNaN(deadlineDate.getTime())) { %>
                  <span class="str-mode-badge">Deadline: <%= deadlineDate.toLocaleString() %></span>
                <% } %>
              <% } %>
              <% if (item.is_locked) { %>
                <span class="str-mode-badge">Locked</span>
              <% } %>
              <strong><%= item.subject_name %></strong> · <%= item.category || 'Assessment' %> · <%= item.question_count || 0 %> questions · Max <%= item.max_score %>
            </p>
          </div>
          <% if (item.is_locked) { %>
            <span class="str-badge str-badge-locked" title="This assessment is currently locked">
              <span class="str-lock" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="12" height="12">
                  <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                  <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                </svg>
              </span>
              Locked
            </span>
          <% } else { %>
            <a class="str-start" href="/student/testing-room/<%= item.assessment_id %>">Take Now</a>
          <% } %>
        </div>
        <% }) %>
      </div>
    <% } %>
  </div>

  <div class="str-card">
    <h2 style="margin:0 0 10px;color:#0f172a;">Completed Assessments</h2>
    <% if (!completedAssessments || !completedAssessments.length) { %>
      <p class="str-empty">No completed assessments yet.</p>
    <% } else { %>
      <div class="str-list">
        <% completedAssessments.forEach(item => { %>
        <div class="str-item">
          <div>
            <h3><%= item.title %></h3>
            <p>
              <span class="str-mode-badge"><%= item.open_book ? 'Open Book' : 'Secure' %></span>
              <% if (item.time_limit_minutes && Number(item.time_limit_minutes) > 0) { %>
                <span class="str-mode-badge"><%= Number(item.time_limit_minutes) %> min</span>
              <% } %>
              <strong><%= item.subject_name %></strong> · <%= item.category || 'Assessment' %>
              · Score <%= Number(item.score || 0).toFixed(2) %> / <%= Number(item.attempt_max_score || item.max_score || 0).toFixed(2) %>
            </p>
          </div>
          <span class="str-badge" title="Submitted tests are locked">
            <span class="str-lock" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="12" height="12">
                <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
              </svg>
            </span>
            Completed
          </span>
        </div>
        <% }) %>
      </div>
    <% } %>
  </div>
</div>
