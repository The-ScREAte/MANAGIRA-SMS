<%# Taking a test in the assessments flow (public/js/examRoom.js): a short start card, then
    the questions with a bar for time, saving and Submit. An open-book test shows its
    resources on the left and the questions on the right. A secure (closed-book) test locks
    when the student leaves the page, until a teacher unlocks it. %>
<link rel="stylesheet" href="<%= assetUrl('/css/examRoom.css') %>">
<%
  const _questions = Array.isArray(questions) ? questions : [];
  const _resources = Array.isArray(locals.resources) ? resources : [];
  // Open-book tests show their resources; so does any test whose teacher chose
  // "Students see these with the test" (feature learning_resources).
  const _split = (Boolean(assessment.open_book) || Boolean(locals.resourcesShown)) && _resources.length > 0;
  const _notes = String(locals.teacherNotes || '').trim();
  const _minutes = Number(assessment.time_limit_minutes || 0);
  const _points = Number((_questions.reduce((sum, q) => sum + Number(q.marks || 0), 0) || Number(assessment.max_score || 0)).toFixed(2));
  const _attempt = Math.min(Number(submittedAttemptCount || 0) + 1, Number(maxAttempts || 1));
  const _back = '/student/testing-room';
  const _started = Boolean(attemptStartedAt);
  const _type = (q) => String(q.question_type || '').toLowerCase();
%>
<div class="ex<%= _split ? ' ex--split' : '' %>" id="ex" data-ap-skip data-no-spa data-state="<%= _started ? 'exam' : 'intro' %>">
  <div class="ex-bar">
    <div class="ex-bar__title">
      <span class="ex-bar__subject"><%= assessment.subject_name %></span>
      <strong><%= assessment.title %></strong>
    </div>
    <div class="ex-bar__right">
      <span class="ex-save" id="ex-save" aria-live="polite"></span>
      <span class="ex-timer" id="ex-timer" role="timer" aria-label="Time left" hidden></span>
      <button type="button" class="ex-btn ex-btn--primary ex-only-exam" id="ex-submit-top">Submit</button>
      <a class="ex-btn ex-btn--ghost" id="ex-exit" href="<%= _back %>">Exit</a>
    </div>
  </div>

  <div class="ex-alert" id="ex-alert" role="alert" hidden></div>
  <div class="ex-flash"><%- include('../partials/flash') %></div>

  <section class="ex-intro" aria-labelledby="ex-intro-title">
    <div class="ex-card">
      <p class="ex-eyebrow"><%= assessment.subject_name %><% if (assessment.category) { %> · <%= assessment.category %><% } %></p>
      <h1 id="ex-intro-title"><%= assessment.title %></h1>
      <% if (questionSet && questionSet.set_description) { %><p class="ex-desc"><%= questionSet.set_description %></p><% } %>
      <dl class="ex-facts">
        <div><dt>Questions</dt><dd><%= _questions.length %></dd></div>
        <div><dt>Points</dt><dd><%= _points %></dd></div>
        <div><dt>Time</dt><dd><%= _minutes > 0 ? _minutes + ' min' : 'Untimed' %></dd></div>
        <div><dt>Attempt</dt><dd><%= _attempt %> of <%= Number(maxAttempts || 1) %></dd></div>
      </dl>
      <p class="ex-rule<%= assessment.open_book ? ' ex-rule--open' : '' %>">
        <% if (assessment.open_book) { %>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 4h7a3 3 0 0 1 3 3v13a2 2 0 0 0-2-2H2z"/><path d="M22 4h-7a3 3 0 0 0-3 3v13a2 2 0 0 1 2-2h8z"/></svg>
          <span>Open book.<%= _split ? ' Your resources open beside the questions.' : '' %> Answers save as you go.</span>
        <% } else { %>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
          <span>Closed book. Stay on this page until you submit. Leaving it locks the test.</span>
        <% } %>
      </p>
      <% if (_split && !assessment.open_book) { %><p class="ex-closes">Your teacher’s resources open beside the questions.</p><% } %>
      <% if (_notes) { %><div class="ex-notes"><strong>From your teacher</strong><p><%= _notes %></p></div><% } %>
      <% if (assessment.edit_window_end) { %><p class="ex-closes">Closes <%= new Date(assessment.edit_window_end).toLocaleString('en-US', { month: 'short', day: 'numeric', hour: 'numeric', minute: '2-digit' }) %></p><% } %>
      <div class="ex-card__actions">
        <a class="ex-btn ex-btn--ghost" href="<%= _back %>">Cancel</a>
        <button type="button" class="ex-btn ex-btn--primary" id="ex-start">Start test</button>
      </div>
    </div>
  </section>

  <div class="ex-body">
    <% if (_split) { %>
      <div class="ex-switch" role="tablist" aria-label="Show">
        <button type="button" role="tab" class="is-on" aria-selected="true" data-ex-pane="questions">Questions</button>
        <button type="button" role="tab" aria-selected="false" data-ex-pane="resources">Resources (<%= _resources.length %>)</button>
      </div>
      <aside class="ex-res" id="ex-res" aria-label="Resources">
        <div class="ex-res__head">
          <% if (_resources.length > 1) { %>
            <label class="ex-sr" for="ex-res-pick">Resource</label>
            <select class="ex-res__pick" id="ex-res-pick">
              <% _resources.forEach((file, i) => { %><option value="<%= i %>"><%= file.name %></option><% }) %>
            </select>
          <% } else { %>
            <span class="ex-res__name"><%= _resources[0].name %></span>
          <% } %>
          <a class="ex-res__open" id="ex-res-open" href="#" target="_blank" rel="noopener noreferrer">Open in new tab</a>
        </div>
        <div class="ex-res__view" id="ex-res-view"></div>
      </aside>
    <% } %>

    <div class="ex-main" id="ex-main">
      <div class="ex-main__inner">
        <nav class="ex-nav" aria-label="Questions">
          <% _questions.forEach((question, index) => { %>
            <a href="#ex-q-<%= index + 1 %>" class="ex-nav__item" data-ex-nav="<%= index %>" aria-label="Question <%= index + 1 %>"><%= index + 1 %></a>
          <% }) %>
        </nav>

        <form id="ex-form" method="POST" action="/student/testing-room/<%= assessment.assessment_id %>/submit" autocomplete="off">
          <input type="hidden" name="attemptId" value="<%= attemptId %>" />
          <% _questions.forEach((question, index) => { %>
            <% const fieldName = `responses[${question.question_id}]`; %>
            <% const saved = responsesByQuestionId[String(question.question_id)]; %>
            <% const type = _type(question); %>
            <% const pts = Number(question.marks || 0); %>
            <section class="ex-q" id="ex-q-<%= index + 1 %>" data-ex-q="<%= index %>">
              <div class="ex-q__head">
                <span class="ex-q__num">Question <%= index + 1 %></span>
                <span class="ex-q__pts"><%= pts %> pt<%= pts === 1 ? '' : 's' %></span>
              </div>
              <div class="ex-q__text"><%- question.question_html || '' %></div>
              <% if (question.help) { %>
                <details class="ex-help">
                  <summary>Help for this question</summary>
                  <% if (question.help.text) { %><p><%= question.help.text %></p><% } %>
                  <% if (question.help.link) { %><a href="<%= question.help.link.url %>" target="_blank" rel="noopener noreferrer"><%= question.help.link.label || question.help.link.url %></a><% } %>
                  <% (question.help.files || []).forEach((file) => { %><a href="<%= file.url %>" target="_blank" rel="noopener noreferrer"><%= file.name %></a><% }) %>
                </details>
              <% } %>

              <% if (question.media && question.media.image && question.media.image.url) { %>
                <figure class="ex-pic">
                  <div class="ex-pic__canvas">
                    <img src="<%= question.media.image.url %>" alt="<%= question.media.image.alt || ('Picture for question ' + (index + 1)) %>" loading="lazy" draggable="false" />
                    <% if (type === 'image_label') { (question.media.labels || []).forEach(function (label, spot) { %>
                      <span class="ex-spot" style="left:<%= Number(label.x) * 100 %>%;top:<%= Number(label.y) * 100 %>%"><%= spot + 1 %></span>
                    <% }) } %>
                  </div>
                </figure>
              <% } %>

              <% if (type === 'single_choice' || type === 'true_false' || type === 'multiple_choice') { %>
                <% const many = type === 'multiple_choice'; %>
                <% const picked = many ? (Array.isArray(saved) ? saved.map(String) : (saved ? String(saved).split(',').map((v) => v.trim()).filter(Boolean) : [])) : [String(saved || '')]; %>
                <% if (many) { %><p class="ex-hint">Select all that apply.</p><% } %>
                <div class="ex-opts" role="<%= many ? 'group' : 'radiogroup' %>" aria-label="Question <%= index + 1 %> answers">
                  <% (Array.isArray(question.options_json) ? question.options_json : []).forEach((option, o) => { %>
                    <label class="ex-opt">
                      <input type="<%= many ? 'checkbox' : 'radio' %>" name="<%= fieldName %>" value="<%= option %>" <%= picked.includes(String(option)) ? 'checked' : '' %> />
                      <span class="ex-opt__key" aria-hidden="true"><%= type === 'true_false' ? '' : String.fromCharCode(65 + o) %></span>
                      <span class="ex-opt__text"><%= option %></span>
                    </label>
                  <% }) %>
                </div>
              <% } else if (type === 'image_label') { %>
                <p class="ex-hint">Type what each number on the picture shows.</p>
                <div class="ex-labels">
                  <% (question.media && question.media.labels || []).forEach(function (label, spot) { %>
                    <% const given = Array.isArray(saved) ? saved[spot] : (spot === 0 ? saved : ''); %>
                    <label class="ex-label">
                      <span class="ex-spot ex-spot--static" aria-hidden="true"><%= spot + 1 %></span>
                      <input class="ex-input" type="text" name="<%= fieldName %>" value="<%= given || '' %>" maxlength="200" aria-label="Answer for number <%= spot + 1 %>" />
                    </label>
                  <% }) %>
                </div>
              <% } else if (type === 'essay') { %>
                <textarea class="ex-input ex-textarea" name="<%= fieldName %>" rows="6" placeholder="Write your answer" aria-label="Question <%= index + 1 %> answer"><%= saved || '' %></textarea>
              <% } else { %>
                <input class="ex-input" type="text" name="<%= fieldName %>" value="<%= saved || '' %>" placeholder="Your answer" aria-label="Question <%= index + 1 %> answer" />
              <% } %>
            </section>
          <% }) %>

          <div class="ex-end">
            <span class="ex-progress" id="ex-progress"><strong>0</strong> of <%= _questions.length %> answered</span>
            <button type="button" class="ex-btn ex-btn--primary ex-btn--lg" id="ex-submit">Submit test</button>
          </div>
        </form>
      </div>
    </div>
  </div>

  <div class="ex-modal" id="ex-modal" role="dialog" aria-modal="true" aria-labelledby="ex-modal-title" hidden>
    <div class="ex-modal__card">
      <h2 id="ex-modal-title"></h2>
      <p id="ex-modal-text"></p>
      <div class="ex-modal__actions">
        <button type="button" class="ex-btn ex-btn--ghost" id="ex-modal-cancel"></button>
        <button type="button" class="ex-btn ex-btn--primary" id="ex-modal-ok"></button>
      </div>
    </div>
  </div>
</div>

<script type="application/json" id="ex-config"><%- JSON.stringify({
  assessmentId: Number(assessment.assessment_id),
  attemptId: Number(attemptId),
  secure: !assessment.open_book,
  timeLimitMinutes: _minutes,
  startedAt: attemptStartedAt ? new Date(attemptStartedAt).toISOString() : '',
  finalAttempt: Number(maxAttempts || 1) - Number(submittedAttemptCount || 0) <= 1,
  backUrl: _back,
  resources: _resources.map((file) => ({ name: file.name, kind: file.kind, url: '/student/testing-room/' + assessment.assessment_id + '/resource/' + file.id })),
}).replace(/</g, '\\u003c') %></script>
<script src="<%= assetUrl('/js/examRoom.js') %>" defer></script>
