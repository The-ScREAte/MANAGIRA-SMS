<style>
  :root {
    --sp-org-base: var(--org-primary-color, #01535b);
    --sp-org-strong: color-mix(in srgb, var(--sp-org-base) 72%, black);
    --sp-org-soft: color-mix(in srgb, var(--sp-org-base) 48%, black);
    --sp-org-muted: color-mix(in srgb, var(--sp-org-base) 38%, white);
    --sp-surface: color-mix(in srgb, var(--sp-org-base) 4%, white);
    --sp-surface-muted: color-mix(in srgb, var(--sp-org-base) 8%, white);
    --sp-surface-strong: color-mix(in srgb, var(--sp-org-base) 13%, white);
    --sp-border: color-mix(in srgb, var(--sp-org-base) 18%, white);
    --sp-border-strong: color-mix(in srgb, var(--sp-org-base) 30%, white);
    --sp-shadow-soft: color-mix(in srgb, var(--sp-org-base) 14%, transparent);
    --sp-shadow-strong: color-mix(in srgb, var(--sp-org-base) 26%, transparent);
    --sp-overlay: color-mix(in srgb, var(--sp-org-base) 12%, transparent);
  }

  .sp-shell {
    max-width: 1240px;
    margin: 0 auto;
    padding: 16px;
  }

  .sp-header {
    border: 1px solid var(--sp-border);
    border-radius: 14px;
    background: #fff;
    box-shadow: 0 4px 14px var(--sp-shadow-soft);
    margin-bottom: 12px;
    overflow: hidden;
  }

  .sp-header-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
    padding: 12px 16px;
    border-bottom: 1px solid var(--sp-border);
    background: var(--sp-surface-muted);
  }

  .sp-header-titleblock {
    display: flex;
    flex-direction: column;
    gap: 3px;
    align-items: flex-start;
    text-align: left;
  }

  .sp-title-tag {
    font-size: .68rem;
    letter-spacing: .09em;
    text-transform: uppercase;
    color: var(--sp-org-soft);
    font-weight: 800;
    margin: 0;
  }

  .sp-title {
    font-size: 1.62rem;
    color: #0f172a;
    font-weight: 700;
    margin: 0;
    line-height: 1.1;
    text-align: left;
  }

  .sp-header-meta {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-shrink: 0;
  }

  .sp-header-brief {
    border: 1px solid var(--sp-border);
    border-radius: 999px;
    background: var(--sp-surface-muted);
    color: var(--sp-org-strong);
    padding: 5px 12px;
    font-size: .72rem;
    font-weight: 700;
    white-space: nowrap;
  }

  .sp-header-brief .k {
    color: var(--sp-org-muted);
    margin-right: 5px;
    text-transform: uppercase;
    letter-spacing: .06em;
    font-size: .6rem;
  }

  .sp-term-popup-btn {
    border: 1px solid var(--sp-border-strong);
    border-radius: 999px;
    background: var(--sp-surface-strong);
    color: var(--sp-org-base);
    font-size: .72rem;
    font-weight: 800;
    padding: 5px 14px;
    cursor: pointer;
    white-space: nowrap;
    min-height: 32px;
  }

  .sp-term-popup-btn:hover {
    background: var(--sp-surface-strong);
  }

  .sp-body { background: #fff; }
  .sp-panel { padding: 14px; }
  .sp-panel[hidden] { display: none; }

  .sp-summary {
    display: grid;
    grid-template-columns: 90px minmax(0,1fr) 220px;
    gap: 14px;
    align-items: center;
    margin-bottom: 14px;
  }

  .sp-avatar {
    width: 84px;
    height: 84px;
    border-radius: 50%;
    object-fit: cover;
    border: 3px solid #fff;
    box-shadow: 0 6px 18px var(--sp-shadow-strong);
    display: block;
  }

  .sp-name {
    font-size: 1.18rem;
    color: #0f172a;
    margin: 0;
    font-weight: 700;
  }

  .sp-sub {
    margin: 4px 0 0;
    color: var(--sp-org-soft);
    font-size: .86rem;
  }

  .sp-term-countdown {
    background: var(--sp-surface-muted);
    border: 1px solid var(--sp-border);
    border-radius: 10px;
    padding: 10px 14px;
    text-align: center;
    font-size: .84rem;
    color: var(--sp-org-strong);
  }

  .sp-term-countdown .line { margin-top: 4px; }
  .sp-term-countdown .meta { color: var(--sp-org-soft); font-size: .78rem; }

  .sp-tiles {
    display: grid;
    grid-template-columns: repeat(4, minmax(0,1fr));
    gap: 10px;
    margin-bottom: 12px;
  }

  .sp-tile {
    border: 1px solid var(--sp-border);
    border-radius: 10px;
    background: var(--sp-surface-muted);
    padding: 10px 12px;
  }

  .sp-tile .l {
    font-size: .64rem;
    text-transform: uppercase;
    letter-spacing: .06em;
    color: var(--sp-org-soft);
    font-weight: 800;
  }

  .sp-tile .v {
    margin-top: 5px;
    font-size: 1.1rem;
    color: #0f172a;
    font-weight: 800;
  }

  .sp-tile-note {
    margin-top: 4px;
    color: var(--sp-org-soft);
    font-size: .7rem;
    font-weight: 600;
  }

  .sp-action-tiles {
    display: grid;
    grid-template-columns: repeat(4, minmax(0,1fr));
    gap: 10px;
  }

  .sp-tiles.sp-tiles-no-testing {
    grid-template-columns: repeat(3, minmax(0,1fr));
  }

  .sp-action-tiles.sp-action-tiles-no-testing {
    grid-template-columns: repeat(3, minmax(0,1fr));
  }

  .sp-action-tile {
    border: 1px solid var(--sp-border);
    border-radius: 10px;
    background: var(--sp-surface-muted);
    padding: 10px 12px;
    cursor: pointer;
    text-align: left;
    text-decoration: none;
    display: block;
  }

  .sp-action-tile:hover {
    border-color: var(--sp-border-strong);
    background: var(--sp-surface-strong);
  }

  .sp-transport-map {
    width: 100%;
    height: 260px;
    border: 1px solid var(--sp-border);
    border-radius: 12px;
    overflow: hidden;
    background: #eef5fb;
    margin-top: 12px;
  }

  .sp-action-tile.sp-testing {
    border-color: var(--sp-border-strong);
    background: var(--sp-surface-strong);
  }

  .sp-action-title {
    margin: 0;
    font-size: .86rem;
    color: #0f172a;
    font-weight: 800;
  }

  .sp-action-copy {
    margin: 3px 0 0;
    color: var(--sp-org-soft);
    font-size: .76rem;
  }

  .sp-action-tile.sp-testing .sp-action-title,
  .sp-action-tile.sp-testing .sp-action-copy {
    color: var(--sp-org-base);
  }

  .sp-table-wrap {
    overflow-x: auto;
    border: 1px solid var(--sp-border);
    border-radius: 10px;
  }

  .sp-table {
    width: 100%;
    border-collapse: collapse;
    font-size: .84rem;
  }

  .sp-table th, .sp-table td {
    border-bottom: 1px solid var(--sp-border);
    padding: 9px 12px;
    text-align: left;
  }

  .sp-table tr:last-child td { border-bottom: none; }

  .sp-table th {
    background: var(--sp-surface-muted);
    color: var(--sp-org-soft);
    font-size: .68rem;
    text-transform: uppercase;
    letter-spacing: .05em;
    font-weight: 700;
  }

  .sp-day-cell { font-weight: 700; color: #0f172a; white-space: nowrap; }

  .sp-period-time {
    display: block;
    font-size: .7rem;
    color: var(--sp-org-muted);
    margin-top: 2px;
  }

  .sp-mini-pill {
    display: inline-flex;
    align-items: center;
    border-radius: 999px;
    border: 1px solid var(--sp-border);
    background: var(--sp-surface-muted);
    color: var(--sp-org-strong);
    padding: 2px 8px;
    font-size: .68rem;
    font-weight: 700;
  }

  .sp-muted { color: var(--sp-org-soft); margin: 0; }
  .sp-section-title { margin: 0 0 10px; color: #0f172a; font-size: 1rem; font-weight: 700; }

  .schedule-shell {
    display: grid;
    gap: 10px;
    position: relative;
  }

  .schedule-shell.with-watermark::after {
    content: '';
    position: absolute;
    inset: 0;
    background-image: var(--schedule-watermark-image);
    background-repeat: no-repeat;
    background-position: center;
    background-size: min(360px, 70%);
    opacity: 0.08;
    pointer-events: none;
    z-index: 2;
  }

  .schedule-shell > * {
    position: relative;
    z-index: 1;
  }

  .schedule-summary-details {
    margin-bottom: 8px;
  }

  .schedule-summary-toggle {
    display: none;
  }

  .schedule-summary-toggle::-webkit-details-marker {
    display: none;
  }

  .schedule-summary-toggle::marker {
    content: "";
  }

  .schedule-summary-toggle-button {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    border: 1px solid var(--sp-border);
    border-radius: 14px;
    background: #fff;
    padding: 12px 14px;
    color: #0f172a;
    font: inherit;
    font-weight: 700;
    cursor: pointer;
  }

  .schedule-summary-toggle-label {
    font-size: 14px;
  }

  .schedule-summary-toggle-icon {
    color: var(--sp-org-soft);
    font-size: 20px;
    line-height: 1;
    transition: transform 0.2s ease;
  }

  .schedule-summary-details[open] .schedule-summary-toggle-icon {
    transform: rotate(90deg);
  }

  .schedule-summary-content {
    margin-top: 10px;
  }

  .schedule-summary-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 8px;
  }

  .schedule-summary-card {
    border: 1px solid var(--sp-border);
    border-radius: 10px;
    background: #ffffff;
    padding: 8px 10px;
  }

  .schedule-summary-card span {
    display: block;
    font-size: 10px;
    color: var(--sp-org-soft);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    font-weight: 700;
  }

  .schedule-summary-card strong {
    display: block;
    margin-top: 2px;
    color: #0f172a;
    font-size: 13px;
    font-weight: 700;
  }

  .schedule-readonly-banner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    padding: 6px 10px;
    border: 1px solid var(--sp-surface-strong);
    background: var(--sp-surface);
    border-radius: 8px;
    color: var(--sp-org-strong);
    font-size: 12px;
    font-weight: 600;
  }

  .schedule-table-wrap {
    --schedule-day-column-width: 92px;
    --schedule-slot-column-width: 96px;
    --schedule-cell-min-height: 44px;
    overflow: auto;
    border: 1px solid var(--sp-border);
    border-radius: 14px;
    background: #fff;
  }

  .schedule-table {
    width: 100%;
    border-collapse: collapse;
    min-width: calc(var(--schedule-day-column-width) + (var(--schedule-slot-column-width) * 5));
    table-layout: fixed;
  }

  .schedule-table th,
  .schedule-table td {
    padding: 0;
    border: 1px solid var(--sp-border-strong);
    text-align: center;
    vertical-align: middle;
  }

  .schedule-table th {
    background: var(--sp-surface-muted);
    color: var(--sp-org-soft);
    font-size: 10.5px;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .schedule-table .schedule-day-cell {
    width: var(--schedule-day-column-width);
    min-width: var(--schedule-day-column-width);
    padding: 8px 6px;
    background: var(--sp-surface-muted);
    font-weight: 700;
    color: #0f172a;
    font-size: 12px;
    position: sticky;
    left: 0;
    z-index: 2;
  }

  .schedule-day-label-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 6px;
  }

  .schedule-day-label-text {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-size: 12px;
  }

  .schedule-slot-header {
    min-width: var(--schedule-slot-column-width);
    background: linear-gradient(180deg, #fff 0%, var(--sp-surface-muted) 100%);
  }

  .schedule-slot-header-inner {
    padding: 6px 6px 7px;
    display: grid;
    gap: 3px;
  }

  .schedule-slot-period {
    font-size: 10px;
    color: var(--sp-org-soft);
    font-weight: 800;
    letter-spacing: 0.06em;
  }

  .schedule-slot-time-display {
    font-size: 10px;
    color: #0f172a;
    font-weight: 700;
    line-height: 1.2;
  }

  .schedule-readonly-cell {
    min-width: var(--schedule-slot-column-width);
    min-height: var(--schedule-cell-min-height);
    padding: 5px 6px;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    font-weight: 600;
    color: #0f172a;
    font-size: 11.5px;
    line-height: 1.2;
  }

  .schedule-readonly-cell.is-custom-entry {
    color: var(--sp-org-base);
    font-weight: 700;
  }

  .schedule-readonly-cell.is-empty {
    color: var(--sp-org-muted);
  }

  .sp-term-meta-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0,1fr));
    gap: 10px;
  }

  .sp-term-meta-card {
    border: 1px solid var(--sp-border);
    border-radius: 10px;
    background: var(--sp-surface-muted);
    padding: 10px 12px;
  }

  .sp-term-meta-card .k {
    margin: 0;
    color: var(--sp-org-soft);
    font-size: .64rem;
    letter-spacing: .06em;
    text-transform: uppercase;
    font-weight: 800;
  }

  .sp-term-meta-card .v {
    margin: 4px 0 0;
    color: #0f172a;
    font-size: .9rem;
    font-weight: 800;
  }

  .sp-modal {
    position: fixed;
    inset: 0;
    background: var(--sp-overlay);
    z-index: 9999;
    display: none;
    align-items: center;
    justify-content: center;
    padding: 14px;
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
  }

  .sp-modal.is-open { display: flex; }

  .sp-modal-card {
    width: min(96vw, 960px);
    max-height: 90vh;
    overflow-y: auto;
    background: color-mix(in srgb, white 84%, var(--sp-surface) 16%);
    border: 1px solid var(--sp-border);
    border-radius: 14px;
    box-shadow: 0 24px 52px var(--sp-shadow-strong);
    padding: 16px;
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
  }

  .sp-modal-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    margin-bottom: 12px;
    padding-bottom: 10px;
    border-bottom: 1px solid var(--sp-border);
  }

  .sp-modal-title { margin: 0; color: #0f172a; font-size: 1rem; font-weight: 700; }

  .sp-modal-close {
    border: 1px solid var(--sp-border);
    background: var(--sp-surface-muted);
    color: var(--sp-org-strong);
    border-radius: 8px;
    width: 32px;
    height: 32px;
    cursor: pointer;
    font-size: 1rem;
    line-height: 1;
  }

  .sp-teacher-subjects { display: inline-flex; flex-wrap: wrap; gap: 4px; }

  .global-table-sort-btn {
    border: 1px solid var(--sp-border);
    background: #ffffff;
    color: var(--sp-org-soft);
    border-radius: 6px;
    width: 20px;
    height: 20px;
    margin-left: 6px;
    vertical-align: middle;
    cursor: pointer;
    padding: 0;
    line-height: 1;
  }

  .global-table-sort-btn svg {
    width: 12px;
    height: 12px;
  }

  .sp-table.sp-grades-table {
    font-size: .76rem;
  }

  .sp-table.sp-grades-table th,
  .sp-table.sp-grades-table td {
    padding: 6px 8px;
  }

  .sp-table.sp-grades-table th {
    font-size: .62rem;
    line-height: 1.25;
  }

  @media (max-width: 980px) {
    .sp-tiles, .sp-action-tiles {
      grid-template-columns: repeat(2, minmax(0,1fr));
    }
    .sp-summary {
      grid-template-columns: 1fr;
      justify-items: center;
      text-align: center;
    }
    .sp-term-countdown { width: 100%; }
    .sp-term-meta-grid { grid-template-columns: 1fr; }
  }

  @media (max-width: 640px) {
    .sp-header-top {
      display: grid;
      grid-template-columns: 1fr auto;
      align-items: end;
      padding: 8px 10px;
      gap: 6px;
    }

    .sp-header-meta {
      flex-direction: column;
      align-items: flex-end;
      gap: 4px;
    }

    .sp-header-brief,
    .sp-term-popup-btn {
      font-size: .56rem;
      padding: 3px 8px;
      min-height: 24px;
    }

    .sp-header { border-radius: 12px; margin-bottom: 10px; }
    .sp-body { padding: 0; }
    .sp-summary {
      gap: 10px;
      margin-bottom: 10px;
    }
    .sp-avatar {
      width: 68px;
      height: 68px;
      border-width: 2px;
    }
    .sp-title { font-size: .72rem; }
    .sp-title-tag { font-size: .56rem; }
    .sp-name { font-size: .72rem; }
    .sp-sub { font-size: .72rem; margin-top: 3px; }
    .sp-term-countdown { font-size: .68rem; padding: 7px 8px; border-radius: 8px; }
    .sp-term-countdown .line { margin-top: 3px; }
    .sp-term-countdown .meta { font-size: .62rem; }
    .sp-panel { padding: 8px; }
    .sp-section-title { font-size: .76rem; margin-bottom: 6px; }
    .sp-tiles,
    .sp-action-tiles {
      gap: 8px;
      margin-bottom: 10px;
    }
    .sp-tile,
    .sp-action-tile {
      padding: 8px 9px;
      border-radius: 8px;
    }
    .sp-tile .l { font-size: .54rem; }
    .sp-tile .v { font-size: .9rem; margin-top: 4px; }
    .sp-action-title { font-size: .62rem; }
    .sp-action-copy { font-size: .54rem; margin-top: 1px; }
    .sp-mini-pill {
      font-size: .58rem;
      padding: 2px 6px;
      border-radius: 999px;
    }
    .sp-teacher-subjects { gap: 3px; }
    .sp-table-wrap { border-radius: 8px; }
    .sp-table { font-size: .66rem; }
    .sp-table th, .sp-table td { padding: 5px 6px; }
    .sp-table th { font-size: .56rem; }
    .sp-period-time { font-size: .56rem; }
    .sp-table.sp-grades-table { font-size: .58rem; }
    .sp-table.sp-grades-table th, .sp-table.sp-grades-table td { padding: 4px; }
    .sp-table.sp-grades-table th { font-size: .48rem; line-height: 1.1; }
    .sp-term-meta-grid { gap: 8px; }
    .sp-term-meta-card { padding: 8px 9px; border-radius: 8px; }
    .sp-term-meta-card .k { font-size: .54rem; }
    .sp-term-meta-card .v { font-size: .76rem; margin-top: 3px; }
    .sp-modal { padding: 10px; }
    .sp-modal-card { padding: 9px; border-radius: 10px; max-height: 88vh; }
    .sp-modal-head { margin-bottom: 8px; padding-bottom: 8px; }
    .sp-modal-title { font-size: .8rem; }
    .sp-modal-close { width: 26px; height: 26px; font-size: .82rem; border-radius: 7px; }

    .schedule-summary-grid {
      grid-template-columns: 1fr 1fr;
    }

    .schedule-summary-toggle {
      display: block;
    }

    .schedule-summary-details:not([open]) .schedule-summary-content {
      display: none;
    }

    .schedule-table-wrap {
      --schedule-day-column-width: 90px;
      --schedule-slot-column-width: 96px;
      --schedule-cell-min-height: 52px;
    }

    .schedule-readonly-banner {
      flex-direction: column;
      align-items: flex-start;
    }
  }

  @media (max-width: 420px) {
    .sp-tiles, .sp-action-tiles {
      grid-template-columns: repeat(2, minmax(0,1fr));
    }
    .sp-shell { padding: 10px; }
    .sp-header-top { padding: 7px 8px; }
    .sp-avatar { width: 58px; height: 58px; }
    .sp-title { font-size: .62rem; }
    .sp-title-tag { font-size: .5rem; }
    .sp-name { font-size: .64rem; }
    .sp-sub { font-size: .66rem; }
    .sp-header-brief,
    .sp-term-popup-btn {
      font-size: .5rem;
      padding: 2px 7px;
      min-height: 22px;
    }
    .sp-term-countdown { font-size: .62rem; padding: 6px 7px; }
    .sp-term-countdown .meta { font-size: .56rem; }
    .sp-section-title { font-size: .7rem; }
    .sp-tile,
    .sp-action-tile { padding: 6px 7px; }
    .sp-tile .l { font-size: .48rem; }
    .sp-tile .v { font-size: .8rem; }
    .sp-action-title { font-size: .56rem; }
    .sp-action-copy { font-size: .5rem; }
    .sp-mini-pill { font-size: .52rem; padding: 1px 5px; }
    .sp-table { font-size: .6rem; }
    .sp-table th, .sp-table td { padding: 4px 5px; }
    .sp-table th { font-size: .5rem; }
    .sp-table.sp-grades-table { font-size: .52rem; }
    .sp-table.sp-grades-table th, .sp-table.sp-grades-table td { padding: 3px; }
    .sp-table.sp-grades-table th { font-size: .44rem; }
    .sp-term-meta-card { padding: 7px 8px; }
    .sp-term-meta-card .k { font-size: .5rem; }
    .sp-term-meta-card .v { font-size: .7rem; }
    .sp-modal { padding: 8px; }
    .sp-modal-title { font-size: .74rem; }
    .sp-modal-card { padding: 7px; border-radius: 9px; }
    .sp-modal-close { width: 24px; height: 24px; font-size: .76rem; }
  }
</style>

<div class="sp-shell">
  <%- include('../partials/flash') %>

  <section class="sp-header">
    <div class="sp-header-top">
      <div class="sp-header-titleblock">
        <p class="sp-title-tag">Student Workspace</p>
        <h1 class="sp-title">
          <%= enrolledClassName || student.class_name || 'Student Portal' %>
        </h1>
      </div>

      <div class="sp-header-meta">
        <span class="sp-header-brief">
          <span class="k">Current</span>
          <%= selectedTerm ? selectedTerm.term_name : 'Term not set' %>
        </span>
        <button type="button" class="sp-term-popup-btn" id="sp-term-popup-btn">
          Term Info
        </button>
      </div>
    </div>

    <div class="sp-body">
      <section class="sp-panel" id="panel-overview">
        <div class="sp-summary">
          <img
            class="sp-avatar"
            src="<%= student.image_url && student.image_url !== 'profilePlaceholder.png' ? student.image_url : '/images/profilePlaceholder.png' %>"
            alt="Student photo"
          />

          <div>
            <h2 class="sp-name">
              <%= typeof formatDisplayName === 'function' ? formatDisplayName(student) : [student.first_name, student.last_name].filter(Boolean).join(' ').trim() %>
            </h2>
            <p class="sp-sub">Class: <strong><%= enrolledClassName || student.class_name || 'Not assigned' %></strong></p>
            <p class="sp-sub">Email: <strong><%= student.email || 'Not available' %></strong></p>
          </div>

          <div class="sp-term-countdown">
            <% const today = new Date(); %>
            <% if (selectedTerm) { %>
              <% const termStart = new Date(selectedTerm.start_date); %>
              <% const termEnd   = new Date(selectedTerm.end_date); %>
              <% const daysUntilStart = Math.ceil((termStart - today) / 86400000); %>
              <% const daysUntilEnd   = Math.ceil((termEnd   - today) / 86400000); %>

              <div class="line">
                <% if (daysUntilStart > 0) { %>
                  <strong><%= selectedTerm.term_name %> starts in <%= daysUntilStart %> day<%= daysUntilStart === 1 ? '' : 's' %>.</strong>
                <% } else if (daysUntilEnd >= 0) { %>
                  <strong>Days until <%= selectedTerm.term_name %> ends: <%= daysUntilEnd %>.</strong>
                <% } else { %>
                  <strong><%= selectedTerm.term_name %> has ended.</strong>
                  <span class="meta"><%= Math.abs(daysUntilEnd) %> day<%= Math.abs(daysUntilEnd) === 1 ? '' : 's' %> ago.</span>
                <% } %>
              </div>

              <div class="line meta">
                <%= today.toLocaleDateString(undefined, { weekday: 'long' }) %>
              </div>
            <% } else { %>
              <div class="line">No active term set.</div>
            <% } %>
          </div>
        </div>

        <div class="sp-tiles <%= testingRoomEnabled ? '' : 'sp-tiles-no-testing' %>">
          <article class="sp-tile">
            <div class="l">Attendance Rate</div>
            <div class="v"><%= attendanceSummary.attendanceRate %>%</div>
            <div class="sp-tile-note"><%= attendanceSummary.present %>/<%= attendanceSummary.totalDays %> term days</div>
          </article>
          <article class="sp-tile">
            <div class="l">Present</div>
            <div class="v"><%= attendanceSummary.present %></div>
          </article>
          <article class="sp-tile">
            <div class="l">Absent</div>
            <div class="v"><%= attendanceSummary.absent %></div>
          </article>
          <% if (testingRoomEnabled) { %>
          <article class="sp-tile">
            <div class="l">Open Testing Room</div>
            <div class="v"><%= openAssessmentsCount %></div>
          </article>
          <% } %>
        </div>

        <div class="sp-action-tiles <%= testingRoomEnabled ? '' : 'sp-action-tiles-no-testing' %>">
          <button class="sp-action-tile" type="button" data-panel="teachers">
            <h4 class="sp-action-title">Subject Teachers</h4>
            <p class="sp-action-copy">Open your teacher list for current term.</p>
          </button>
          <button class="sp-action-tile" type="button" data-panel="schedule">
            <h4 class="sp-action-title">Class Schedule</h4>
            <p class="sp-action-copy">Open your class timetable workspace.</p>
          </button>
          <button class="sp-action-tile" type="button" data-panel="grades">
            <h4 class="sp-action-title">Grades</h4>
            <p class="sp-action-copy">Open current-term subject grades.</p>
          </button>
          <button class="sp-action-tile" type="button" data-panel="transport">
            <h4 class="sp-action-title">Transportation</h4>
            <p class="sp-action-copy"><%= transportationSnapshot && transportationSnapshot.bus && transportationSnapshot.bus.busNumber ? transportationSnapshot.bus.busNumber : 'Not assigned' %><%= transportationSnapshot && transportationSnapshot.route && transportationSnapshot.route.routeName ? ' • ' + transportationSnapshot.route.routeName : '' %></p>
          </button>
          <% if (testingRoomEnabled) { %>
          <a class="sp-action-tile sp-testing" href="/student/testing-room">
            <h4 class="sp-action-title">Testing Room</h4>
            <p class="sp-action-copy">Open assessments and exam room.</p>
          </a>
          <% } %>
        </div>
      </section>

      <section class="sp-panel" id="panel-transport" hidden>
        <h3 class="sp-section-title">Transportation</h3>
        <% if (transportationSnapshot) { %>
        <div class="sp-table-wrap">
          <table class="sp-table">
            <tbody>
              <tr><th>Bus</th><td><%= transportationSnapshot.bus && transportationSnapshot.bus.busNumber ? transportationSnapshot.bus.busNumber : '-' %></td></tr>
              <tr><th>Route</th><td><%= transportationSnapshot.route && transportationSnapshot.route.routeName ? transportationSnapshot.route.routeName : '-' %></td></tr>
              <tr><th>Stop</th><td><%= transportationSnapshot.stop && transportationSnapshot.stop.stopName ? transportationSnapshot.stop.stopName : '-' %></td></tr>
              <tr><th>Stop Address</th><td><%= transportationSnapshot.stop && transportationSnapshot.stop.stopAddress ? transportationSnapshot.stop.stopAddress : '-' %></td></tr>
              <tr><th>Pickup</th><td><%= transportationSnapshot.pickupTime || '-' %></td></tr>
              <tr><th>Dropoff</th><td><%= transportationSnapshot.dropoffTime || '-' %></td></tr>
              <tr><th>Live Update</th><td><%= transportationSnapshot.live && transportationSnapshot.live.recordedAt ? new Date(transportationSnapshot.live.recordedAt).toLocaleString() : 'No live update yet' %></td></tr>
            </tbody>
          </table>
        </div>
        <div
          class="sp-transport-map"
          data-transport-map
          data-student-id="<%= student.student_id %>"
          data-transport-snapshot='<%- JSON.stringify(transportationSnapshot || null) %>'
        ></div>
        <% } else { %>
        <p class="sp-muted">No transportation assignment has been set for your account yet.</p>
        <% } %>
      </section>

      <section class="sp-panel" id="panel-teachers" hidden>
        <h3 class="sp-section-title">Teachers (Current Term)</h3>
        <div class="sp-table-wrap">
          <table class="sp-table">
            <thead>
              <tr><th>Teacher</th><th>Subjects Taught</th></tr>
            </thead>
            <tbody>
              <% if (!subjectTeachers.length) { %>
                <tr><td colspan="2" class="sp-muted">No teachers found for your class this term.</td></tr>
              <% } %>
              <% subjectTeachers.forEach(row => { %>
                <tr>
                  <td>
                    <%= row.first_name || row.last_name
                      ? (typeof formatDisplayName === 'function' ? formatDisplayName(row) : [row.first_name, row.last_name].filter(Boolean).join(' ').trim())
                      : 'Not assigned' %>
                  </td>
                  <td>
                    <div class="sp-teacher-subjects">
                      <% (Array.isArray(row.subject_names) ? row.subject_names : []).forEach(s => { %>
                        <span class="sp-mini-pill"><%= s %></span>
                      <% }) %>
                    </div>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </section>

      <section class="sp-panel" id="panel-schedule" hidden>
        <h3 class="sp-section-title">Class Schedule</h3>
        <% if (classSchedule && classSchedule.entries && classSchedule.entries.length) { %>
          <% 
            var scheduleUpdatedAt = classSchedule.updatedAt ? new Date(classSchedule.updatedAt) : null;
            var scheduleUpdatedLabel = (scheduleUpdatedAt && !Number.isNaN(scheduleUpdatedAt.getTime()))
              ? scheduleUpdatedAt.toLocaleString()
              : '-';

            var slotMap = {};
            var slotOrder = [];
            (classSchedule.entries || []).forEach(function(entry) {
              var slotKey = entry.startTime;
              if (!slotMap[slotKey]) {
                slotMap[slotKey] = { startTime: entry.startTime, endTime: entry.endTime };
                slotOrder.push(slotKey);
              }
            });
            slotOrder.sort();
            var slots = slotOrder.map(function(key) { return slotMap[key]; });
            var activeDays = classSchedule.groupedByDay.filter(function(day) { return day.items.length > 0; });
          %>
          <div class="schedule-shell<%= scheduleWatermarkUrl ? ' with-watermark' : '' %>"<% if (scheduleWatermarkUrl) { %> style="--schedule-watermark-image: url('<%= scheduleWatermarkUrl %>');"<% } %>>
            <details class="schedule-summary-details" open>
              <summary class="schedule-summary-toggle">
                <span class="schedule-summary-toggle-button">
                  <span class="schedule-summary-toggle-label">Schedule details</span>
                  <span class="schedule-summary-toggle-icon" aria-hidden="true">›</span>
                </span>
              </summary>
              <div class="schedule-summary-content">
                <div class="schedule-summary-grid">
                  <div class="schedule-summary-card"><span>School Year</span><strong><%= classSchedule.schoolYearLabel || (selectedTerm ? selectedTerm.year_label : '-') %></strong></div>
                  <div class="schedule-summary-card"><span>Term</span><strong><%= classSchedule.termName || (selectedTerm ? selectedTerm.term_name : '-') %></strong></div>
                  <div class="schedule-summary-card"><span>Columns</span><strong><%= slots.length %></strong></div>
                  <div class="schedule-summary-card"><span>Updated</span><strong><%= scheduleUpdatedLabel %></strong></div>
                </div>
              </div>
            </details>

            <div class="schedule-table-wrap">
              <table class="schedule-table">
                <thead>
                  <tr>
                    <th class="schedule-day-cell">Day</th>
                    <% slots.forEach(function(slot, index) { %>
                      <th class="schedule-slot-header">
                        <div class="schedule-slot-header-inner">
                          <div class="schedule-slot-period">Period <%= index + 1 %></div>
                          <div class="schedule-slot-time-display"><%= slot.startTime %><br><%= slot.endTime %></div>
                        </div>
                      </th>
                    <% }); %>
                  </tr>
                </thead>
                <tbody>
                  <% activeDays.forEach(function(day) { %>
                    <tr>
                      <th class="schedule-day-cell">
                        <div class="schedule-day-label-row">
                          <span class="schedule-day-label-text"><%= day.dayLabel %></span>
                        </div>
                      </th>
                      <% slots.forEach(function(slot) {
                        var entry = null;
                        for (var i = 0; i < day.items.length; i++) {
                          if (day.items[i].startTime === slot.startTime) { entry = day.items[i]; break; }
                        }
                        var cellLabel = entry ? (entry.customLabel || entry.subjectName || 'Empty') : 'Empty';
                        var isCustom = !!(entry && entry.customLabel);
                        var isEmpty = !entry || !cellLabel || cellLabel === 'Empty';
                      %>
                        <td>
                          <div class="schedule-readonly-cell<% if (isCustom) { %> is-custom-entry<% } %><% if (isEmpty) { %> is-empty<% } %>"><%= cellLabel %></div>
                        </td>
                      <% }); %>
                    </tr>
                  <% }); %>
                </tbody>
              </table>
            </div>
          </div>
        <% } else { %>
          <p class="sp-muted">No timetable added for your class this term.</p>
        <% } %>
      </section>

      <section class="sp-panel" id="panel-grades" hidden>
        <h3 class="sp-section-title">Subject Grades (Current Term)</h3>
        <% if (assessmentGrades.length) { %>
          <div class="sp-table-wrap">
            <table class="sp-table sp-grades-table">
              <thead>
                <tr>
                  <th>Subject</th>
                  <% (gradeAssessmentHeaders || []).forEach((assessment, index) => { %>
                    <th>
                      <%= assessment.title %>
                    </th>
                  <% }) %>
                </tr>
              </thead>
              <tbody>
                <% assessmentGrades.forEach(item => { %>
                  <tr>
                    <td><%= item.subject_name %></td>
                    <% (gradeAssessmentHeaders || []).forEach((assessment) => { %>
                      <% const scoreValue = item.assessment_scores ? item.assessment_scores[assessment.assessment_key] : null; %>
                      <td>
                        <%= scoreValue !== null && scoreValue !== undefined ? Number(scoreValue).toFixed(2) : '-' %>
                      </td>
                    <% }) %>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        <% } else { %>
          <p class="sp-muted" style="margin-bottom:8px;">No assessments taken yet. Showing your subjects.</p>
          <div class="sp-table-wrap">
            <table class="sp-table">
              <thead><tr><th>Subject</th></tr></thead>
              <tbody>
                <% if (!subjects.length) { %>
                  <tr><td class="sp-muted">No subjects found.</td></tr>
                <% } %>
                <% subjects.forEach(s => { %>
                  <tr><td><%= s.subject_name %></td></tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        <% } %>
      </section>

      <section class="sp-panel" id="panel-term-info" hidden>
        <h3 class="sp-section-title">Academic Term Details</h3>
        <div class="sp-term-meta-grid">
          <article class="sp-term-meta-card">
            <p class="k">School Year</p>
            <p class="v"><%= selectedTerm ? selectedTerm.year_label : '-' %></p>
          </article>
          <article class="sp-term-meta-card">
            <p class="k">Term</p>
            <p class="v"><%= selectedTerm ? selectedTerm.term_name : '-' %></p>
          </article>
          <article class="sp-term-meta-card">
            <p class="k">Start Date</p>
            <p class="v"><%= selectedTerm && selectedTerm.start_date ? new Date(selectedTerm.start_date).toISOString().slice(0,10) : '-' %></p>
          </article>
          <article class="sp-term-meta-card">
            <p class="k">End Date</p>
            <p class="v"><%= selectedTerm && selectedTerm.end_date ? new Date(selectedTerm.end_date).toISOString().slice(0,10) : '-' %></p>
          </article>
        </div>
      </section>
    </div>
  </section>
</div>

<div class="sp-modal" id="sp-modal" role="dialog" aria-modal="true">
  <div class="sp-modal-card">
    <div class="sp-modal-head">
      <h3 class="sp-modal-title" id="sp-modal-title">Details</h3>
      <button class="sp-modal-close" id="sp-modal-close" type="button" aria-label="Close">&times;</button>
    </div>
    <div id="sp-modal-body"></div>
  </div>
</div>

<script src="/js/managiraMaps.js"></script>
<script>
(function () {
  var tiles      = document.querySelectorAll('.sp-action-tile[data-panel]');
  var modal      = document.getElementById('sp-modal');
  var modalBody  = document.getElementById('sp-modal-body');
  var modalTitle = document.getElementById('sp-modal-title');
  var closeBtn   = document.getElementById('sp-modal-close');
  var termBtn    = document.getElementById('sp-term-popup-btn');

  function openModal(panelKey, label) {
    var panel = document.getElementById('panel-' + panelKey);
    if (!panel || !modal) return;
    modalBody.innerHTML = panel.innerHTML;
    var h = modalBody.querySelector('.sp-section-title');
    if (h) h.remove();
    modalTitle.textContent = label || 'Details';
    modal.classList.add('is-open');
    document.body.style.overflow = 'hidden';
    hydrateTransportMaps(modalBody);
  }

  function ensureLeafletAssets() {
    if (!document.getElementById('leaflet-css-student-dashboard')) {
      var link = document.createElement('link');
      link.id = 'leaflet-css-student-dashboard';
      link.rel = 'stylesheet';
      link.href = 'https://unpkg.com/leaflet@1.9.4/dist/leaflet.css';
      document.head.appendChild(link);
    }
    if (window.L) return Promise.resolve(window.L);
    if (window.__studentDashboardLeafletPromise) return window.__studentDashboardLeafletPromise;
    window.__studentDashboardLeafletPromise = new Promise(function(resolve, reject) {
      var script = document.createElement('script');
      script.src = 'https://unpkg.com/leaflet@1.9.4/dist/leaflet.js';
      script.onload = function() { resolve(window.L); };
      script.onerror = reject;
      document.body.appendChild(script);
    });
    return window.__studentDashboardLeafletPromise;
  }

  function renderTransportMap(el, snapshot) {
    if (!el || !snapshot) return;
    ensureLeafletAssets().then(function(L) {
      if (el.__leafletMap) {
        el.__leafletMap.remove();
        el.__leafletMap = null;
      }
      var map = L.map(el, { scrollWheelZoom: false, zoomControl: true }).setView([40.767304, -111.939857], 12);
      el.__leafletMap = map;
      window.ManagiraMaps.addTiles(map);
      map.attributionControl.setPrefix(false);
      var points = [];
      function normalizeCoord(value, axis) {
        if (value === null || value === undefined) return null;
        var raw = String(value).trim();
        if (!raw) return null;
        var parsed = Number(raw);
        if (!Number.isFinite(parsed)) return null;
        if (axis === 'lat' && (parsed < -90 || parsed > 90)) return null;
        if (axis === 'lng' && (parsed < -180 || parsed > 180)) return null;
        return parsed;
      }
      function addMarker(lat, lng, label, icon) {
        var latNum = normalizeCoord(lat, 'lat');
        var lngNum = normalizeCoord(lng, 'lng');
        if (latNum === null || lngNum === null) return null;
        points.push([latNum, lngNum]);
        var opts = icon ? { icon: icon } : {};
        return L.marker([latNum, lngNum], opts).addTo(map).bindPopup(label || 'Location');
      }
      // Road-following geometry from the server; [] = no route (nothing drawn).
      function fetchRoadGeometry(latlngs) {
        if (!Array.isArray(latlngs) || latlngs.length < 2 || !window.ManagiraMaps) return Promise.resolve([]);
        return window.ManagiraMaps.roadPoints(latlngs).then(function(points) { return points || []; });
      }
      var school = snapshot.school || null;
      var stop = snapshot.stop || null;
      var live = snapshot.live || null;
      var routeStops = snapshot.route && Array.isArray(snapshot.route.stops)
        ? snapshot.route.stops.filter(function(entry) {
            return normalizeCoord(entry && entry.latitude, 'lat') !== null && normalizeCoord(entry && entry.longitude, 'lng') !== null;
          })
        : [];
      addMarker(school && school.latitude, school && school.longitude, school && school.address ? 'School: ' + school.address : 'School', window.ManagiraMaps.schoolIcon());
      addMarker(stop && stop.latitude, stop && stop.longitude, stop && stop.stopName ? 'Your stop: ' + stop.stopName : 'Your stop', window.ManagiraMaps.stopIcon('', { highlight: true }));
      el.__busMarker = addMarker(live && live.latitude, live && live.longitude, 'Bus ' + ((live && (live.busNumber || live.bus_number)) || '') + (live && (live.recordedAt || live.recorded_at) ? ' - updated ' + window.ManagiraMaps.ago((live.recordedAt || live.recorded_at)) : ''), window.ManagiraMaps.busIcon({ heading: live && (live.headingDeg != null ? live.headingDeg : live.heading_deg), label: (live && (live.busNumber || live.bus_number)) || 'Bus' }));
      if (el.__busMarker) el.__busMarker.setZIndexOffset(1000);
      var routeLatLngs = [];
      var schoolLat = school ? normalizeCoord(school.latitude, 'lat') : null;
      var schoolLng = school ? normalizeCoord(school.longitude, 'lng') : null;
      if (schoolLat !== null && schoolLng !== null) {
        routeLatLngs.push([schoolLat, schoolLng]);
      }
      routeStops.forEach(function(entry) {
        routeLatLngs.push([normalizeCoord(entry.latitude, 'lat'), normalizeCoord(entry.longitude, 'lng')]);
      });
      if (schoolLat !== null && schoolLng !== null && routeStops.length) {
        routeLatLngs.push([schoolLat, schoolLng]);
      }
      el.__stopLatLng = (stop && normalizeCoord(stop.latitude, 'lat') !== null && normalizeCoord(stop.longitude, 'lng') !== null)
        ? [normalizeCoord(stop.latitude, 'lat'), normalizeCoord(stop.longitude, 'lng')]
        : null;
      el.__fetchRoadGeometry = fetchRoadGeometry;
      var stopLat = stop ? normalizeCoord(stop.latitude, 'lat') : null;
      var stopLng = stop ? normalizeCoord(stop.longitude, 'lng') : null;
      var liveLat = live ? normalizeCoord(live.latitude, 'lat') : null;
      var liveLng = live ? normalizeCoord(live.longitude, 'lng') : null;
      if (stopLat !== null && stopLng !== null && liveLat !== null && liveLng !== null) {
        fetchRoadGeometry([[liveLat, liveLng], [stopLat, stopLng]]).then(function (roadPoints) {
          if (roadPoints.length < 2) return;
          el.__stopToBusLine = L.polyline(roadPoints, {
            color: '#d97706', weight: 3, opacity: 0.8, dashArray: '6,6',
          }).addTo(map);
        });
      }
      fetchRoadGeometry(routeLatLngs).then(function(roadLatLngs) {
        if (roadLatLngs.length >= 2) window.ManagiraMaps.drawRoute(map, roadLatLngs, { color: '#1a73e8', weight: 5 });
        var boundsSource = roadLatLngs.length ? roadLatLngs.concat(points) : (routeLatLngs.length ? routeLatLngs.concat(points) : points.slice());
        setTimeout(function() {
          map.invalidateSize();
          if (boundsSource.length) {
            map.fitBounds(L.latLngBounds(boundsSource).pad(0.2));
          }
        }, 80);
      });
    }).catch(function() {
      el.innerHTML = '<div style="padding:18px;color:#64748b;font-size:12px;">Map could not load right now.</div>';
    });
  }

  var activeTransportPollTimer = null;

  function stopTransportLivePolling() {
    if (activeTransportPollTimer) {
      window.clearInterval(activeTransportPollTimer);
      activeTransportPollTimer = null;
    }
  }

  function startTransportLivePolling(el) {
    stopTransportLivePolling();
    var studentId = el.getAttribute('data-student-id');
    if (!studentId) return;
    activeTransportPollTimer = window.setInterval(function () {
      fetch('/transportation/live/student/' + encodeURIComponent(studentId), {
        headers: { 'Accept': 'application/json', 'X-Requested-With': 'XMLHttpRequest' }
      }).then(function (r) { return r.json(); }).then(function (payload) {
        var live = payload && payload.success && payload.data ? payload.data.live : null;
        if (!live || !el.__leafletMap || !window.L) return;
        var lat = Number(live.latitude);
        var lng = Number(live.longitude);
        if (!Number.isFinite(lat) || !Number.isFinite(lng)) return;
        var busIcon = window.ManagiraMaps.busIcon({ heading: (live.headingDeg != null ? live.headingDeg : live.heading_deg), label: (live.busNumber || live.bus_number) || 'Bus', stale: (live.recordedAt || live.recorded_at) && (Date.now() - new Date((live.recordedAt || live.recorded_at)).getTime()) > 2 * 60 * 1000 });
        var busPopup = 'Bus ' + ((live.busNumber || live.bus_number) || '') + ' - updated ' + window.ManagiraMaps.ago((live.recordedAt || live.recorded_at) || Date.now());
        if (!el.__busMarker) {
          el.__busMarker = window.L.marker([lat, lng], { icon: busIcon, zIndexOffset: 1000 }).addTo(el.__leafletMap).bindPopup(busPopup);
        } else {
          el.__busMarker.setLatLng([lat, lng]);
          el.__busMarker.setIcon(busIcon);
          el.__busMarker.setPopupContent(busPopup);
        }
        // Keep the bus<->stop connector on the roads as the bus moves.
        if (el.__stopLatLng && typeof el.__fetchRoadGeometry === 'function') {
          el.__fetchRoadGeometry([[lat, lng], el.__stopLatLng]).then(function (roadPoints) {
            if (roadPoints.length < 2) return;
            if (el.__stopToBusLine) {
              el.__stopToBusLine.setLatLngs(roadPoints);
            } else {
              el.__stopToBusLine = window.L.polyline(roadPoints, {
                color: '#d97706', weight: 3, opacity: 0.8, dashArray: '6,6',
              }).addTo(el.__leafletMap);
            }
          });
        }
      }).catch(function () {});
    }, 12000);
  }

  function hydrateTransportMaps(root) {
    Array.prototype.forEach.call((root || document).querySelectorAll('[data-transport-map]'), function(el) {
      var raw = el.getAttribute('data-transport-snapshot') || 'null';
      var snapshot = null;
      try { snapshot = JSON.parse(raw); } catch (_) { snapshot = null; }
      if (snapshot) {
        renderTransportMap(el, snapshot);
        startTransportLivePolling(el);
      }
    });
  }

  function valueForSort(cellText) {
    var cleaned = String(cellText || '').trim();
    if (!cleaned || cleaned === '-') return Number.NEGATIVE_INFINITY;
    var numeric = parseFloat(cleaned.replace(/[^0-9.\-]/g, ''));
    if (Number.isFinite(numeric)) return numeric;
    return cleaned.toLowerCase();
  }

  function sortTableByColumn(table, columnIndex, direction) {
    if (!table) return;
    var tbody = table.querySelector('tbody');
    if (!tbody) return;
    var rows = Array.prototype.slice.call(tbody.querySelectorAll('tr'));
    rows.sort(function (a, b) {
      var aText = ((a.children[columnIndex] || {}).textContent || '').trim();
      var bText = ((b.children[columnIndex] || {}).textContent || '').trim();
      var aVal = valueForSort(aText);
      var bVal = valueForSort(bText);
      if (typeof aVal === 'number' && typeof bVal === 'number') {
        return direction === 'asc' ? aVal - bVal : bVal - aVal;
      }
      return direction === 'asc'
        ? String(aVal).localeCompare(String(bVal), undefined, { sensitivity: 'base' })
        : String(bVal).localeCompare(String(aVal), undefined, { sensitivity: 'base' });
    });
    rows.forEach(function (row) { tbody.appendChild(row); });
  }

  if (modalBody) {
    modalBody.addEventListener('click', function (event) {
      var button = event.target.closest('.global-table-sort-btn');
      if (!button) return;
      var table = button.closest('table');
      if (!table) return;
      var index = Number(button.getAttribute('data-sort-index') || 0);
      var currentDirection = button.getAttribute('data-sort-direction') === 'desc' ? 'desc' : 'asc';
      var nextDirection = currentDirection === 'asc' ? 'desc' : 'asc';
      button.setAttribute('data-sort-direction', nextDirection);
      sortTableByColumn(table, index, nextDirection);
    });
  }

  function closeModal() {
    if (!modal) return;
    modal.classList.remove('is-open');
    document.body.style.overflow = '';
    stopTransportLivePolling();
  }

  tiles.forEach(function (tile) {
    tile.addEventListener('click', function () {
      var panelKey = tile.getAttribute('data-panel');
      var label = (tile.querySelector('.sp-action-title') || {}).textContent || 'Details';
      openModal(panelKey, label.trim());
    });
  });

  if (termBtn) {
    termBtn.addEventListener('click', function () {
      openModal('term-info', 'Academic Term Details');
    });
  }


  hydrateTransportMaps(document);
  if (closeBtn) closeBtn.addEventListener('click', closeModal);
  if (modal) {
    modal.addEventListener('click', function (e) {
      if (e.target === modal) closeModal();
    });
  }

  document.addEventListener('keydown', function (e) {
    if (e.key === 'Escape') closeModal();
  });
})();
</script>
