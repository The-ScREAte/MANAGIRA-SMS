<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>PayGira Receipt — #<%= payment.payment_id %></title>
<style>
  * { box-sizing:border-box; }
  body { font-family:'Space Grotesk','DM Sans',Arial,sans-serif; margin:0; background:#f5f6fa; color:#1a1f2e; }
  .doc { max-width:560px; margin:24px auto; background:#fff; border-radius:14px; box-shadow:0 10px 30px rgba(0,0,0,.06); padding:30px 34px; }
  .head { text-align:center; padding-bottom:18px; border-bottom:2px dashed #00D4AA; }
  .head .org h1 { margin:0 0 4px; font-size:1.15rem; font-weight:800; }
  .head .org .meta { font-size:.74rem; color:#5a6378; line-height:1.4; }
  .head .label { margin-top:14px; font-size:.7rem; color:#5a6378; text-transform:uppercase; letter-spacing:.12em; font-weight:700; }
  .head .amount { font-size:2.1rem; font-weight:800; color:#00845f; margin-top:4px; font-family:'JetBrains Mono',Consolas,monospace; }
  .head .num { font-family:'JetBrains Mono',Consolas,monospace; font-size:.78rem; color:#5a6378; margin-top:4px; }
  .grid { display:grid; grid-template-columns:1fr 1fr; gap:10px 14px; margin:20px 0; font-size:.85rem; }
  .grid .k { color:#5a6378; font-size:.7rem; text-transform:uppercase; letter-spacing:.06em; font-weight:700; }
  .grid .v { font-weight:600; margin-top:2px; }
  .row { display:flex; justify-content:space-between; padding:8px 0; border-bottom:1px dashed #e6e9f0; font-size:.88rem; }
  .row:last-child { border-bottom:none; }
  .row .v { font-family:'JetBrains Mono',Consolas,monospace; }
  .badge { display:inline-flex; align-items:center; gap:5px; background:rgba(0,212,170,.12); color:#00845f; padding:4px 10px; border-radius:999px; font-size:.66rem; font-weight:700; letter-spacing:.06em; text-transform:uppercase; }
  .actions { display:flex; gap:10px; justify-content:center; margin-top:22px; }
  .btn { padding:9px 16px; border-radius:8px; font-size:.82rem; font-weight:700; cursor:pointer; text-decoration:none; border:none; }
  .btn.primary { background:#00D4AA; color:#062018; }
  .btn.ghost { background:transparent; color:#1a1f2e; border:1px solid #d4d9e3; }
  .foot { margin-top:20px; padding-top:12px; border-top:1px solid #e6e9f0; font-size:.72rem; color:#5a6378; text-align:center; }
  @media print {
    body { background:#fff; }
    .doc { box-shadow:none; margin:0; padding:14px; }
    .actions { display:none; }
  }
</style>
</head>
<body>
<%
  const _mLabels = {
    stripe: 'Card / Wallet', card: 'Card / Wallet', paystack: 'Card / Mobile Money',
    bank_transfer: 'Bank Transfer', mobile_money: 'Mobile Money',
    cash: 'Cash', credit: 'Balance Credit', other: 'Other'
  };
  const _mProviders = { stripe: 'Stripe', card: 'Stripe', paystack: 'Paystack' };
  function fmtPayMethod(m) {
    const key = String(m || '').toLowerCase();
    return { label: _mLabels[key] || m || '—', provider: _mProviders[key] || null };
  }
%>
<%
  const moneyFmt = typeof formatMoney === 'function'
    ? formatMoney
    : function(v){ return Number(v||0).toFixed(2); };
  const usdEq = typeof formatUsdEquivalent === 'function' ? formatUsdEquivalent : function(){ return null; };
%>
<div class="doc">
  <%
    const platformFeePercentage = Number(payment.platform_fee_percentage || 0);
    const platformFeeAmount = Number(payment.platform_fee_amount || 0);
    const taxAmount = Number(payment.tax_amount || 0);
    const totalChargedAmount = Number(payment.amount || 0) + platformFeeAmount + taxAmount;
  %>
  <div class="head">
    <div class="org">
      <h1><%= payment.organization_name || 'School' %></h1>
      <div class="meta"><%= payment.org_address || '' %> · <%= payment.org_phone || '' %></div>
      <span class="badge" style="margin-top:8px;">🔒 PayGira Secure</span>
    </div>
    <div class="label">PayGira Receipt</div>
    <div class="amount"><%= moneyFmt(totalChargedAmount) %></div>
    <% if (usdEq(totalChargedAmount)) { %>
      <div style="margin-top:4px;font-size:.76rem;color:#5a6378;">Approx. <%= usdEq(totalChargedAmount) %></div>
    <% } %>
    <div class="num">#RCP-<%= String(payment.payment_id).padStart(6,'0') %></div>
  </div>

  <div class="grid">
    <div><div class="k">Student</div><div class="v"><%= payment.first_name %> <%= payment.last_name %></div></div>
    <div><div class="k">Class</div><div class="v"><%= payment.class_name || '—' %></div></div>
    <div><div class="k">Bill</div><div class="v"><%= payment.bill_title || '—' %></div></div>
    <% const _pm = fmtPayMethod(payment.method); const _pmBg = _pm.provider === 'Paystack' ? 'rgba(80,140,233,.12)' : 'rgba(99,91,255,.1)'; const _pmColor = _pm.provider === 'Paystack' ? '#1d4ed8' : '#4338ca'; %>
    <div><div class="k">Method</div><div class="v"><%= _pm.label %><% if (_pm.provider) { %> <span style="padding:2px 7px;border-radius:6px;font-size:.62rem;font-weight:700;vertical-align:middle;background:<%= _pmBg %>;color:<%= _pmColor %>"><%= _pm.provider %></span><% } %></div></div>
    <div><div class="k">Date</div><div class="v"><%= new Date(payment.received_at).toLocaleString() %></div></div>
    <div><div class="k">Reference</div><div class="v" style="font-family:'JetBrains Mono',Consolas,monospace;font-size:.78rem;"><%= payment.reference || '—' %></div></div>
  </div>

  <% if (payment.assignment_amount != null) {
       var total = Number(payment.assignment_amount || 0) + Number(payment.assignment_late_fee || 0);
       var paid  = Number(payment.assignment_paid || 0);
       var bal   = Math.max(total - paid, 0);
  %>
    <div class="row"><div>Applied to bill</div><div class="v"><%= moneyFmt(payment.amount) %></div></div>
    <% if (platformFeeAmount > 0) { %>
      <div class="row"><div>Platform fee<%= platformFeePercentage > 0 ? ` (${Number(platformFeePercentage).toFixed(2).replace(/\.00$/, '')}%)` : '' %></div><div class="v"><%= moneyFmt(platformFeeAmount) %></div></div>
    <% } %>
    <% if (taxAmount > 0) { %>
      <div class="row"><div>Taxes</div><div class="v"><%= moneyFmt(taxAmount) %></div></div>
    <% } %>
    <% if (platformFeeAmount > 0 || taxAmount > 0) { %>
      <div class="row" style="font-weight:800;"><div>Total charged</div><div class="v"><%= moneyFmt(totalChargedAmount) %></div></div>
    <% } %>
    <div class="row"><div>Total billed</div><div class="v"><%= moneyFmt(total) %></div></div>
    <div class="row"><div>Paid to date</div><div class="v" style="color:#00845f;"><%= moneyFmt(paid) %></div></div>
    <div class="row" style="font-weight:800;"><div>Outstanding</div><div class="v"><%= moneyFmt(bal) %></div></div>
  <% } %>

  <% if (payment.notes) { %>
    <p style="margin:14px 0 0;color:#5a6378;font-size:.82rem;"><strong style="color:#1a1f2e;">Notes:</strong> <%= payment.notes %></p>
  <% } %>

  <p style="margin:14px 0 0;color:#5a6378;font-size:.78rem;">Received by <strong style="color:#1a1f2e;"><%= payment.organization_name || 'School' %></strong></p>

  <div class="actions">
    <button class="btn ghost" onclick="window.print()">🖨️ Print</button>
    <button class="btn primary" onclick="window.close()">Done</button>
  </div>

  <div class="foot">Thank you. Keep this receipt for your records · <%= new Date().toLocaleString() %></div>
</div>
</body>
</html>
