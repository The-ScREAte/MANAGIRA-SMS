{
  "watch": ["views", "public", "routes", "controllers", "jobs", "utils", "config", "middleware", "models", "validation", "server.js"],
  "ext": "js,ejs,css",
  "ignore": ["node_modules/*", "uploads/*"],
  "quiet": false,
  "exec": "node --no-deprecation server.js",
  "events": {
    "start": "echo '[Nodemon] watching files and starting server'",
    "restart": "echo '[Nodemon] restarted due to changes'",
    "crash": "echo '[Nodemon] app crashed; waiting for file changes'"
  }
}
