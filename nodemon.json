{
  "watch": [
    "routes",
    "controllers",
    "jobs",
    "utils",
    "config",
    "middleware",
    "models",
    "validation",
    "server.js"
  ],
  "ext": "js,json",
  "ignore": [
    "node_modules/*",
    "uploads/*",
    "public/*",
    "views/*",
    "docs/*",
    "scripts/*",
    "tests/*",
    "mira/*",
    "*.md"
  ],
  "delay": 2000,
  "quiet": true,
  "exec": "node --no-deprecation --use-system-ca server.js",
  "events": {
    "crash": "echo '[Nodemon] app crashed; waiting for file changes'"
  }
}
